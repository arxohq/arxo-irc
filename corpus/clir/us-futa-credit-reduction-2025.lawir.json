{"artifactHash":"sha256:a0da62dec1e8a2fbbdacb0e7d233762a6ee37d56da01ccfec33cefbed42be5c0","features":["core-executable","law.decision/0.1"],"imports":[],"metadata":{"localSources":{"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_PDF_BYTES":"sources/2026-00342.pdf","urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT_TXT":"sources/futa-2025-base/en.txt"}},"nodes":[{"contentHash":"sha256:fb835131d2d307ad729896a1c1202c22aa8417eda4e4323e62c404be73999dda","id":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342","jurisdiction":{"id":"urn:us:dol:futa_credit_reduction_2025:clir#US","kind":"const_ref"},"kind":"source_work","labels":[{"language":"en","status":"official","text":"Notice of the Federal Unemployment Tax Act (FUTA) Credit Reductions Applicable for 2025"}],"number":"FR Doc. 2026-00342","package":"urn:us:dol:futa_credit_reduction_2025:clir","sourceKind":"urn:us:dol:futa_credit_reduction_2025:clir#guidance"},{"contentHash":"sha256:21b63eb3d7f33cb5869a1f51104f0069ad47b2c1e34ca2ef3e713600d2c42903","id":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_PDF","kind":"source_edition","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342 (GPO GovInfo PDF, January 12, 2026)"}],"language":"en","lifecycle":[],"materializationStatus":"PINNED_OFFICIAL_BYTES","officiality":"official","package":"urn:us:dol:futa_credit_reduction_2025:clir","work":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342"},{"contentHash":"sha256:c74d10e0a549ba6efedb0ab3e550d377b14c42a6155ca62f193657bc82278760","documentHash":"sha256:21abf2fea7bb4e6070ea46f298a1e570383e928258f8dbef578270311ad086ee","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_PDF","id":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_PDF_BYTES","kind":"publication","mediaType":"application/pdf","package":"urn:us:dol:futa_credit_reduction_2025:clir","uri":"https://www.govinfo.gov/content/pkg/FR-2026-01-12/pdf/2026-00342.pdf"},{"contentHash":"sha256:249b0af01fef241412be90f136bbd1d531cea38c83d79906ebda5d3fd1722f4f","id":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","kind":"source_edition","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342 FUTA notice: text extracted from the GPO PDF"}],"language":"en","lifecycle":[],"materializationStatus":"PINNED_UNOFFICIAL_COPY","officiality":"official","package":"urn:us:dol:futa_credit_reduction_2025:clir","work":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342"},{"contentHash":"sha256:976d45e730ff5c14183eb6e749abe12c4247b5bcbbaf2d5039ff1be245e6effc","documentHash":"sha256:404049801b028895b3c29ccc876fe907861c2fa07b56a7d6af894a849d6ccec4","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","id":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT_TXT","kind":"publication","mediaType":"text/plain; charset=utf-8","package":"urn:us:dol:futa_credit_reduction_2025:clir","uri":"https://www.govinfo.gov/content/pkg/FR-2026-01-12/pdf/2026-00342.pdf"},{"contentHash":"sha256:3f6985580df812eab8f5d45aa970b535579f56516677141e343d10d3a173a080","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","fragmentKind":"notice","id":"urn:us:dol:futa_credit_reduction_2025:clir#FUTA_2025_BASIS","kind":"fragment","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342: statutory basis (c)(2)(A)/(d)(3), (c)(2)(C) add-on and waiver"}],"locator":"fr/2026-00342/notice/legal-basis","package":"urn:us:dol:futa_credit_reduction_2025:clir","texts":[{"contentHash":"sha256:370519c7e93b32987fb23d21477c40235e6673d023ab14dea1966968f9019584","language":"en","status":"official","text":"SUMMARY: Sections 3302(c)(2)(A) and\n\n3302(d)(3) of FUTA provide that\nemployers in a state that has\noutstanding advances under Title XII of\nthe Social Security Act on January first\nof two or more consecutive years are\n\nPO 00000\n\nFrm 00068\n\nFmt 4703\n\nSfmt 9990\n\nsubject to a reduction in credits\notherwise available against the FUTA\ntax for the calendar year in which the\nmost recent such January first occurs, if\nadvances remain on November 10 of\nthat year. Further, Section 3302(c)(2)(C)\nof FUTA provides for an additional\ncredit reduction for a year if a state has\noutstanding advances on five or more\nconsecutive January firsts and has a\nbalance on November 10 for such years.\nSection 3302(c)(2)(C) provides for\nwaiver of this additional credit\nreduction and substitution of the credit\nreduction provided in Section\n3302(c)(2)(B) if a state meets certain\nconditions."}],"visibility":"public"},{"contentHash":"sha256:17fabcb84599850c71b3f10d3b172706c4aaa0151d48c83fb9aab2d8c8c0def4","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","fragmentKind":"table","id":"urn:us:dol:futa_credit_reduction_2025:clir#FUTA_2025_RATE_CA","kind":"fragment","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342: California FUTA credit reduction, 1.2 percent for 2025"}],"locator":"fr/2026-00342/notice/rate/california","package":"urn:us:dol:futa_credit_reduction_2025:clir","texts":[{"contentHash":"sha256:a6801d90ddb89cdc6c4cc798f071be12775c77be6b71145d304a1e305a7b4a40","language":"en","status":"official","text":"Employers in California are subject to\na FUTA credit reduction of 1.2 percent\nfor 2025."}],"visibility":"public"},{"contentHash":"sha256:ad6f7b37828b551536cfaea18a2c63901a11d9eb8f222fda0f304fcf02fb7394","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","fragmentKind":"table","id":"urn:us:dol:futa_credit_reduction_2025:clir#FUTA_2025_RATE_USVI","kind":"fragment","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342: U.S. Virgin Islands FUTA credit reduction, 4.5 percent for 2025"}],"locator":"fr/2026-00342/notice/rate/virgin-islands","package":"urn:us:dol:futa_credit_reduction_2025:clir","texts":[{"contentHash":"sha256:4a0466833a03d8c225587927d7be0ddcdc4ca92894772bfc1ec220933cabb89f","language":"en","status":"official","text":"Employers in the U.S. Virgin\nIslands are subject to a FUTA credit\nreduction of 4.5 percent for 2025."}],"visibility":"public"},{"contentHash":"sha256:0dbddd48fa623433c342133ae4d8e16e51440ea9332af723253809fa2e79d8da","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","fragmentKind":"notice","id":"urn:us:dol:futa_credit_reduction_2025:clir#FUTA_2025_STATES","kind":"fragment","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342: four advance States; Connecticut and New York repaid, not subject"}],"locator":"fr/2026-00342/notice/states","package":"urn:us:dol:futa_credit_reduction_2025:clir","texts":[{"contentHash":"sha256:784598344d02152030c6e602c5a0c6b11ff955d95920219cec0a705c612ac968","language":"en","status":"official","text":"As of January 1, 2025, California,\nConnecticut, New York, and the U.S.\nVirgin Islands had outstanding advances\nfor two or more consecutive years and\nemployers in these states were\npotentially subject to a FUTA credit\nreduction for 2025. Connecticut and\nNew York each repaid their outstanding\nadvances before November 10, 2025."}],"visibility":"public"},{"contentHash":"sha256:9c31ccb287cc0c70d395088e30c93e06b052f96d1ea923a17fd15466cacfddec","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","fragmentKind":"notice","id":"urn:us:dol:futa_credit_reduction_2025:clir#FUTA_2025_TITLE","kind":"fragment","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342: caption, agency and action"}],"locator":"fr/2026-00342/notice/title","package":"urn:us:dol:futa_credit_reduction_2025:clir","texts":[{"contentHash":"sha256:957fb6de8b08ef4532e8f1617726e6f3615e4fd4938ea72a02801903209e809d","language":"en","status":"official","text":"DEPARTMENT OF LABOR\nEmployment and Training\nAdministration\nNotice of the Federal Unemployment\nTax Act (FUTA) Credit Reductions\nApplicable for 2025\nAGENCY: Employment and Training\n\nAdministration, Department of Labor.\nACTION: Notice."}],"visibility":"public"},{"contentHash":"sha256:3dcd05160e51db06aff2a5ae195e84793173c1bca4ec8752afd6f644dbebba58","edition":"urn:us:dol:futa_credit_reduction_2025:clir#FR2026_00342_TEXT","fragmentKind":"notice","id":"urn:us:dol:futa_credit_reduction_2025:clir#FUTA_2025_WAIVER","kind":"fragment","labels":[{"language":"en","status":"official","text":"FR Doc. 2026-00342: basic reduction States; (c)(2)(C) waiver applied and granted, no add-on"}],"locator":"fr/2026-00342/notice/waiver","package":"urn:us:dol:futa_credit_reduction_2025:clir","texts":[{"contentHash":"sha256:cbd4a70aadef622da2b668b61335701ec2ab63596ab11fcc24d170e62e2d029d","language":"en","status":"official","text":"California has had outstanding\nadvances on January first for five\nconsecutive years, and the U.S. Virgin\nIslands has had outstanding advances\non January first for sixteen consecutive\nyears. As such, employers in California\nand the U.S. Virgin Islands are subject\nto the basic credit reduction under\nSection 3302(c)(2)(A), FUTA, and were\npotentially liable for an additional\nreduction under Section 3302(c)(2)(C),\nFUTA. Both California and the U.S.\nVirgin Islands applied for a waiver of\nthis additional credit reduction and\nETA determined that each state legally\nsatisfied the conditions for this waiver\nper Section 3302(f)(2)(B), FUTA.\nTherefore, there will be no additional\nadd-on credit reduction in California or\nthe U.S. Virgin Islands."}],"visibility":"public"},{"contentHash":"sha256:6ecf60fb64b7980dc0a436d357143d0161c222fa81e5c776128e09462982b6ae","id":"urn:us:dol:futa_credit_reduction_2025:clir#futa_credit_reduction_rate","kind":"symbol_decl","labels":[{"language":"en","status":"unofficial","text":"FUTA credit reduction rate for the 2025 tax year emitted by the pinned table for the given state"}],"name":"futa_credit_reduction_rate","package":"urn:us:dol:futa_credit_reduction_2025:clir","parameters":[{"id":"urn:us:dol:futa_credit_reduction_2025:clir#futa_cred