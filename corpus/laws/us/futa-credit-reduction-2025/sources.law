    kind guidance;
    jurisdiction US;
    number "FR Doc. 2026-00342";
    label en official "Notice of the Federal Unemployment Tax Act (FUTA) Credit Reductions Applicable for 2025";
}

edition FR2026_00342_PDF of FR2026_00342 {
    label en official "FR Doc. 2026-00342 (GPO GovInfo PDF, January 12, 2026)";
    language en;
    officiality official;
    materialization_status PINNED_OFFICIAL_BYTES;
}

publication FR2026_00342_PDF_BYTES of FR2026_00342_PDF {
    media_type "application/pdf";
    uri "https://www.govinfo.gov/content/pkg/FR-2026-01-12/pdf/2026-00342.pdf";
    content_hash "sha256:21abf2fea7bb4e6070ea46f298a1e570383e928258f8dbef578270311ad086ee";
    local_path "sources/2026-00342.pdf";
}

edition FR2026_00342_TEXT of FR2026_00342 {
    label en official "FR Doc. 2026-00342 FUTA notice: text extracted from the GPO PDF";
    language en;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
}

publication FR2026_00342_TEXT_TXT of FR2026_00342_TEXT {
    media_type "text/plain; charset=utf-8";
