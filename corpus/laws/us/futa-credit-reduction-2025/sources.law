}

// 2025, FUTA_2025_TITLE — notice record.
pub fragment FUTA_2025_TITLE in FR2026_00342_TEXT {
    kind notice;
    locator "fr/2026-00342/notice/title";
    text en official """DEPARTMENT OF LABOR
Employment and Training
Administration
Notice of the Federal Unemployment
Tax Act (FUTA) Credit Reductions
Applicable for 2025
AGENCY: Employment and Training

Administration, Department of Labor.
ACTION: Notice.""";
    content_hash "sha256:957fb6de8b08ef4532e8f1617726e6f3615e4fd4938ea72a02801903209e809d";
    label en official "FR Doc. 2026-00342: caption, agency and action";
}

// 2025, FUTA_2025_BASIS — notice record.
pub fragment FUTA_2025_BASIS in FR2026_00342_TEXT {
    kind notice;
    locator "fr/2026-00342/notice/legal-basis";
    text en official """SUMMARY: Sections 3302(c)(2)(A) and

3302(d)(3) of FUTA provide that
employers in a state that has
outstanding advances under Title XII of
the Social Security Act on January first
of two or more consecutive years are

PO 00000

Frm 00068

Fmt 4703

Sfmt 9990

subject to a reduction in credits
otherwise available against the FUTA
tax for the calendar year in which the
most recent such January first occurs, if
advances remain on November 10 of
that year. Further, Section 3302(c)(2)(C)
of FUTA provides for an additional
credit reduction for a year if a state has
outstanding advances on five or more
consecutive January firsts and has a
balance on November 10 for such years.
Section 3302(c)(2)(C) provides for
waiver of this additional credit
reduction and substitution of the credit
reduction provided in Section
3302(c)(2)(B) if a state meets certain
conditions.""";
    content_hash "sha256:370519c7e93b32987fb23d21477c40235e6673d023ab14dea1966968f9019584";
    label en official "FR Doc. 2026-00342: statutory basis (c)(2)(A)/(d)(3), (c)(2)(C) add-on and waiver";
}

// 2025, FUTA_2025_STATES — notice record.
pub fragment FUTA_2025_STATES in FR2026_00342_TEXT {
    kind notice;
    locator "fr/2026-00342/notice/states";
    text en official """As of January 1, 2025, California,
Connecticut, New York, and the U.S.
Virgin Islands had outstanding advances
for two or more consecutive years and
employers in these states were
potentially subject to a FUTA credit
reduction for 2025. Connecticut and
New York each repaid their outstanding
advances before November 10, 2025.""";
    content_hash "sha256:784598344d02152030c6e602c5a0c6b11ff955d95920219cec0a705c612ac968";
    label en official "FR Doc. 2026-00342: four advance States; Connecticut and New York repaid, not subject";
}

// 2025, FUTA_2025_WAIVER — notice record.
pub fragment FUTA_2025_WAIVER in FR2026_00342_TEXT {
    kind notice;
    locator "fr/2026-00342/notice/waiver";
    text en official """California has had outstanding
advances on January first for five
consecutive years, and the U.S. Virgin
Islands has had outstanding advances
on January first for sixteen consecutive
years. As such, employers in California
and the U.S. Virgin Islands are subject
to the basic credit reduction under
Section 3302(c)(2)(A), FUTA, and were
potentially liable for an additional
reduction under Section 3302(c)(2)(C),
FUTA. Both California and the U.S.
Virgin Islands applied for a waiver of
this additional credit reduction and
ETA determined that each state legally
satisfied the conditions for this waiver
per Section 3302(f)(2)(B), FUTA.
Therefore, there will be no additional
add-on credit reduction in California or
the U.S. Virgin Islands.""";
    content_hash "sha256:cbd4a70aadef622da2b668b61335701ec2ab63596ab11fcc24d170e62e2d029d";
    label en official "FR Doc. 2026-00342: basic reduction States; (c)(2)(C) waiver applied and granted, no add-on";
}

// 2025, FUTA_2025_RATE_CA — 2 anchored rates.
pub fragment FUTA_2025_RATE_CA in FR2026_00342_TEXT {
    kind table;
    locator "fr/2026-00342/notice/rate/california";
    text en official """Employers in California are subject to
a FUTA credit reduction of 1.2 percent
for 2025.""";
    content_hash "sha256:a6801d90ddb89cdc6c4cc798f071be12775c77be6b71145d304a1e305a7b4a40";
    label en official "FR Doc. 2026-00342: California FUTA credit reduction, 1.2 percent for 2025";
}

// 2025, FUTA_2025_RATE_USVI — 2 anchored rates.
pub fragment FUTA_2025_RATE_USVI in FR2026_00342_TEXT {
    kind table;
    locator "fr/2026-00342/notice/rate/virgin-islands";
    text en official """Employers in the U.S. Virgin
Islands are subject to a FUTA credit
reduction of 4.5 percent for 2025.""";
    content_hash "sha256:4a0466833a03d8c225587927d7be0ddcdc4ca92894772bfc1ec220933cabb89f";
    label en official "FR Doc. 2026-00342: U.S. Virgin Islands FUTA credit reduction, 4.5 percent for 2025";
}
