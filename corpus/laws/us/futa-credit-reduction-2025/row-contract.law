// Публичная сигнатура существующей закреплённой выдачи таблицы сокращения
// кредита FUTA на 2025 год. Объявление не задаёт ставку: ставку по штату
// выбирает таблица `sources/tables/futa-credit-reduction-2025.lawtable.json`.
pub relation futa_credit_reduction_rate(state: Text, rate: Decimal) kind institutional {
    label en unofficial "FUTA credit reduction rate for the 2025 tax year emitted by the pinned table for the given state";
}
