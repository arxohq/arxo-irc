// Публичная сигнатура существующей закреплённой выдачи квартальной таблицы
// ставок процентов по §6621. Объявление не задаёт ставку и не выбирает
// квартал: строку выбирает таблица `sources/tables/quarterly-2026.lawtable.json`.
pub relation quarterly_rate(quarter: Text, tier: Text, rate: Decimal) kind institutional {
    label en unofficial "interest rate under section 6621 for the given quarter and tier (base, under, ...) emitted by the pinned quarterly table";
}
