// 2026-Q3, base tier — 1 anchored rate; text is the contiguous rate paragraph, shared by the six 2026-Q3 fragments.
pub fragment Q6621_2026Q3_BASE in RR2026_10_TEXT {
    kind table;
    locator "rev-rul/2026-10/quarter/2026-q3/base";
    text en official """The federal short-term rate determined
in accordance with section 1274(d) during
April 2026 is the rate published in Revenue Ruling 2026-9, 2026-19 IRB 897, to
take effect beginning May 1, 2026. The
federal short-term rate, rounded to the
nearest full percent, based on daily compounding determined during the month
of April 2026 is 4 percent. Accordingly,
an overpayment rate of 7 percent (6 percent in the case of a corporation) and an
underpayment rate of 7 percent are established for the calendar quarter beginning
July 1, 2026. The overpayment rate for
the portion of a corporate overpayment
exceeding $10,000 for the calendar quarter beginning July 1, 2026, is 4.5 percent.
The underpayment rate for large corporate
underpayments for the calendar quarter
beginning July 1, 2026, is 9 percent.""";
    content_hash "sha256:411441f47ae05030ea023595c044b521c729a63077b75a7dde55d2271c51dff7";
    label en official "Rev. Rul. 2026-10 (2026-Q3): federal short-term rate";
}

