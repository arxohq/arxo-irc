// Table 3 (August 2026): Rates Under Section 382 — adjusted federal long-term rate 3.72% + long-term tax-exempt rate 3.77%; text is the contiguous slice from the TABLE 3 header line to the tax-exempt value line, shared by both Table 3 rows.
pub fragment AFR_2026_13_T3 in RR2026_13_TEXT {
    kind table;
    locator "rev-rul/2026-13/table/3";
    text en official """                             REV. RUL. 2026-13 TABLE 3

                       Rates Under Section 382 for August 2026

      Adjusted federal long-term rate for the current month               3.72%

      Long-term tax-exempt rate for ownership changes during the
      current month (the highest of the adjusted federal long-term
      rates for the current month and the prior two months.)              3.77%""";
    content_hash "sha256:7cd0ea06a06806ec0ead45c8bfb9856e24ef7c928f71db93a310f65056d6b95c";
    label en official "Table 3 (August 2026): Rates Under Section 382";
}

