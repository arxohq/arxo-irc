    kind table;
    locator "rev-rul/2026-13/table/1/short-term/annual";
    text en official """                            Short-term

AFR         4.10%       4.06%           4.04%       4.03%
110% AFR    4.52%       4.47%           4.45%       4.43%
120% AFR    4.93%       4.87%           4.84%       4.82%
130% AFR    5.35%       5.28%           5.25%       5.22%""";
