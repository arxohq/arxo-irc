// Public signature of the existing pinned Table 3 emission. The declaration
// supplies no rate and does not select a month; table input selects its issue.
pub relation section382_table3_rate(rate_kind: Text, rate: Decimal) kind institutional {
    label en unofficial "section 382 rate emitted by the selected pinned IRS Table 3 (adjusted or tax_exempt)";
}

// Публичная сигнатура существующей закреплённой выдачи Таблицы 1 (AFR):
// объявление не задаёт ставку и не выбирает выпуск — выпуск выбирает ввод таблицы.
pub relation afr_table_rate(horizon: Text, tier: Text, compounding: Text, rate: Decimal) kind institutional {
    label en unofficial "applicable Federal rate emitted by the selected pinned Table 1 of a Rev. Rul. AFR issue (horizon short/mid/long, percentage tier, compounding column)";
}
