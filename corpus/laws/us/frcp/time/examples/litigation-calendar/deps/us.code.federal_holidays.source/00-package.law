// Формализация 5 U.S.C. §6103 (Holidays) — законные публичные праздники США
// и подстановка выходного дня для служащих с рабочей неделей пн–пт.
//
// ЗАЧЕМ ЭТОТ АКТ ЗДЕСЬ. Он не самоценен: он существует ради ОДНОГО срока
// чужого акта. Руководство Fannie Mae требует проверить занятость «within 10
// business days prior to the note date» (B3-3.1-04), а терм
// `add_business_days` §86 без закреплённого календарного снапшота §85 не
// считает вовсе. Состав нерабочих дней устанавливает не руководство, а закон,
// поэтому календарь 2026 года ВЫВОДИТСЯ исполнением этого акта
// (`corpus/gen_kz_clir.py`, `us_federal_calendar_2026`) — ровно тем же
// приёмом, что казахстанский официальный календарь выводится из закона о
// праздниках. Фикстурой календарь не объявляется: тогда «10 рабочих дней»
// опирались бы на данные, за которые не отвечает ни один источник.
//
// ЧТО ЗДЕСЬ ДОСЛОВНОЕ. Текст §6103 во фрагментах взят из закреплённой
// публикации GPO (`sources/usc-5-6103/en.txt`, govinfo.gov) и сверяется с ней
// БАЙТОВО при каждой сборке (§194, LDC-E5202). Правила дословными не
// являются — это истолкование текста.
//
// ГРАНИЦА ЯЗЫКА, НАЗВАННАЯ ПРЯМО: ДЕНЬ НЕДЕЛИ НЕ ВЫЧИСЛЯЕТСЯ. §6103(a)
// называет часть праздников правилом («the third Monday in January»), а не
// датой. Поверхность вычислимого v1 замкнута (six термов, §58/§86) и дня
// недели не даёт: ни `weekday`, ни «n-й понедельник месяца» в ней нет.
// Поэтому ДАТЫ 2026 года объявлены нормативными фактами применения §6103(a)
// к этому году, а не выведены. Это истолкование, и отвечает за него
// формализатор: `holiday_designated_on` ниже сверяется с текстом статьи
// глазами, а не машиной. Считать их в питоновском генераторе было бы ХУЖЕ —
// это семантика вне CLIR (инвариант 5 репозитория).
//
// ЧЕГО В §6103 НЕТ И ЧЕГО ЗДЕСЬ ПОЭТОМУ НЕТ: ПОДСТАНОВКИ ЗА ВОСКРЕСЕНЬЕ.
// Подпункт (b)(1) говорит только о субботе: «Instead of a holiday that occurs
// on a Saturday, the Friday immediately before is a legal public holiday for
// employees whose basic workweek is Monday through Friday». Привычное правило
// «праздник в воскресенье переносится на понедельник» установлено не этим
// параграфом, а Executive Order 11582, который в корпус не входит. Дописать
// его сюда значило бы выдумать норму под настоящим номером.
//
// Цена границы ИЗМЕРЕНА, а не оценена: в 2026 году ни один праздник §6103(a)
// на воскресенье не приходится (1 января — четверг, 19 января, 16 февраля,
// 25 мая, 7 сентября и 12 октября — понедельники, 19 июня и 25 декабря —
// пятницы, 4 июля — суббота, 11 ноября — среда, 26 ноября — четверг).
// Календарь 2026 года от этой границы не меняется ни на день; для другого
// года пакет обязан либо получить E.O. 11582, либо честно отказаться.
//
// ПОДПУНКТЫ (b)(2), (b)(3), (c) и (d) в охват не входят и объявлены границей
// в `sources/usc-5-6103/articles.json`: (b)(2)/(b)(3) адресованы служащим с
// рабочей неделей НЕ пн–пт (для календаря пн–пт они беспредметны), (c) —
// день инаугурации в округе Колумбия (2026 год не является «fourth year
// after 1965»: 2025 — да, 2026 — нет), (d) — право агентства предписать
// иной день служащим на compressed schedule, то есть акт агентства, а не
// этого закона.

language "law.core" version "0.2";
package us.code.federal_holidays version "0.1.1";
namespace "urn:us:code:clir:federal-holidays";

pub entity Holiday {
    label en official "legal public holiday";
}

// --- §6103(a): перечень законных публичных праздников ----------------------
//
// Перечень ЗАКРЫТ самим текстом («The following are legal public holidays»),
// и это тот случай, когда закрытие мира правдиво. Оно, однако, НЕ выражено
// closure §70: closure отвечает на вопрос «а нет ли ещё», а календарю нужен
// список дат, и лишнего вывода из закрытия он бы не получил. Полнота
// перечня held учётом §33.1 и сверкой фрагмента с байтами.

relation legal_public_holiday(h: Holiday) kind institutional {
    label en official "legal public holiday named by 5 U.S.C. §6103(a)";
    key(h);
}

// Дата, НА КОТОРУЮ §6103(a) назначает праздник в 2026 году. Нормативный
// факт применения статьи к году — см. границу «день недели не вычисляется».
relation holiday_designated_on(h: Holiday, day: Date) kind institutional {
    label en official "date on which 5 U.S.C. §6103(a) designates the holiday";
    key(h);
}

// --- §6103(b)(1): подстановка за субботу -----------------------------------
//
// «Приходится на субботу» и «пятница непосредственно перед» — КАЛЕНДАРНЫЕ
// факты, а не правовые выводы: день недели поверхностью не вычисляется, а
// шага «минус один день» у языка нет вовсе (`add_business_days` берёт только
// положительный литерал с единицей). Оба объявлены empirical и приходят
// фактами применения; правовое содержание — в правилах ниже.
relation falls_on_saturday(h: Holiday) kind empirical {
    label en official "the designated date falls on a Saturday";
    key(h);
}

relation friday_immediately_before(h: Holiday, day: Date) kind empirical {
    label en official "the Friday immediately before the designated date";
    key(h);
}

// Итог: день, который ЯВЛЯЕТСЯ законным публичным праздником для служащего с
// рабочей неделей пн–пт. Из него и строится календарный снапшот §85.
pub relation observed_holiday_on(h: Holiday, day: Date) kind institutional {
    label en official "legal public holiday for an employee whose basic workweek is Monday through Friday";
    key(h);
}
