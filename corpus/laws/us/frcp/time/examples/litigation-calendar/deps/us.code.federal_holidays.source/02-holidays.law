language "law.core" version "0.2";
package us.code.federal_holidays version "0.1.1";
namespace "urn:us:code:clir:federal-holidays";

use self::{
    Holiday,
    USC_5_6103_A,
    USC_5_6103_B1,
    falls_on_saturday,
    friday_immediately_before,
    holiday_designated_on,
    legal_public_holiday,
    observed_holiday_on,
};

// --- §6103(a): одиннадцать праздников и их даты в 2026 году ----------------
//
// Порядок объявлений — порядок перечня в самом тексте. Каждая пара
// (праздник, дата) — нормативный факт §71 применения §6103(a) к 2026 году;
// основание в тексте см. в комментарии рядом. Даты, названные в законе
// числом (1 января, 19 июня, 4 июля, 11 ноября, 25 декабря), взяты дословно;
// даты, названные правилом («третий понедельник января»), вычислены вручную
// и подлежат сверке глазами — граница «день недели не вычисляется»
// (00-package.law).

@source(USC_5_6103_A)
assert legal_public_holiday(NewYearsDay);
@source(USC_5_6103_A)
assert holiday_designated_on(NewYearsDay, @2026-01-01);

@source(USC_5_6103_A)
assert legal_public_holiday(BirthdayOfMartinLutherKingJr);
// «the third Monday in January»: понедельники января 2026 — 5, 12, 19, 26.
@source(USC_5_6103_A)
assert holiday_designated_on(BirthdayOfMartinLutherKingJr, @2026-01-19);

@source(USC_5_6103_A)
assert legal_public_holiday(WashingtonsBirthday);
// «the third Monday in February»: 2, 9, 16, 23.
@source(USC_5_6103_A)
assert holiday_designated_on(WashingtonsBirthday, @2026-02-16);

@source(USC_5_6103_A)
assert legal_public_holiday(MemorialDay);
// «the last Monday in May»: 4, 11, 18, 25.
@source(USC_5_6103_A)
assert holiday_designated_on(MemorialDay, @2026-05-25);

@source(USC_5_6103_A)
assert legal_public_holiday(JuneteenthNationalIndependenceDay);
@source(USC_5_6103_A)
assert holiday_designated_on(JuneteenthNationalIndependenceDay, @2026-06-19);

@source(USC_5_6103_A)
assert legal_public_holiday(IndependenceDay);
@source(USC_5_6103_A)
assert holiday_designated_on(IndependenceDay, @2026-07-04);

@source(USC_5_6103_A)
assert legal_public_holiday(LaborDay);
// «the first Monday in September»: 7.
@source(USC_5_6103_A)
assert holiday_designated_on(LaborDay, @2026-09-07);

@source(USC_5_6103_A)
assert legal_public_holiday(ColumbusDay);
// «the second Monday in October»: 5, 12.
@source(USC_5_6103_A)
assert holiday_designated_on(ColumbusDay, @2026-10-12);

@source(USC_5_6103_A)
assert legal_public_holiday(VeteransDay);
@source(USC_5_6103_A)
assert holiday_designated_on(VeteransDay, @2026-11-11);

@source(USC_5_6103_A)
assert legal_public_holiday(ThanksgivingDay);
// «the fourth Thursday in November»: 5, 12, 19, 26.
@source(USC_5_6103_A)
assert holiday_designated_on(ThanksgivingDay, @2026-11-26);

@source(USC_5_6103_A)
assert legal_public_holiday(ChristmasDay);
@source(USC_5_6103_A)
assert holiday_designated_on(ChristmasDay, @2026-12-25);

// --- Календарные факты 2026 года -------------------------------------------
//
// Единственный праздник §6103(a), приходящийся в 2026 году на субботу, —
// День независимости (4 июля 2026, суббота). На воскресенье не приходится ни
// один: подстановка воскресенья этим параграфом и не установлена (см.
// границу в 00-package.law).
//
// ПОЧЕМУ ЭТОТ АКТ ОТВЕЧАЕТ НА ПУСТОМ ДЕЛЕ — И ЭТО РЕШЕНИЕ, А НЕ СЛУЧАЙНОСТЬ.
// Ровно эти два утверждения дают пакету самодостаточность: без них подстановка
// §6103(b)(1) не выводится ничем, и `us_federal_calendar_2026` не смог бы
// вывести календарь ИСПОЛНЕНИЕМ акта — только объявить его фикстурой, за
// которую не отвечает ни один источник. Плата за самодостаточность названа
// прямо: акт несёт внутри себя два факта о календаре 2026 года, и «просто так»
// он отвечает только за этот год.
//
// origin у них — `source_asserted`, как у всех прочих: акт утверждает их сам,
// а не получает делом. Соблазнительный `assumed_for_simulation` здесь НЕ
// годится, и это проверено кодом, а не вкусом: §73 принимает такой origin
// только в `mode=simulation`, обе реализации это стерегут
// (`lawref/evaluator/facts.py`, `law-eval/src/facts.rs`), и под ярлыком
// «допущение» подстановка перестала бы выводиться в обычном режиме — 4 июля
// снова стало бы праздником, а календарь сдвинулся бы на день. Ярлык,
// меняющий ответ, честнее не делает.
//
// Якорь стоит на §6103(b)(1) по тому же основанию, по которому даты выше
// заякорены на §6103(a): пункт не устанавливает, что 4 июля 2026 — суббота,
// но именно он делает субботность юридически значимой, и без него факта в
// пакете не было бы. Безъякорное утверждение читается как «так говорит
// источник» при том, что источник молчит, — а по всему корпусу таких 0.6 %,
// и молчаливо пополнять их нечем.

@source(USC_5_6103_B1)
assert falls_on_saturday(IndependenceDay);
@source(USC_5_6103_B1)
assert friday_immediately_before(IndependenceDay, @2026-07-03);

// --- Правила -----------------------------------------------------------------
//
// Общая норма §6103(a): назначенный день и есть праздник.

@source(USC_5_6103_A)
rule DesignatedDayIsHoliday(h: Holiday, day: Date) defeasible {
    when legal_public_holiday(h) and holiday_designated_on(h, day);
    then observed_holiday_on(h, day);
    label en official "5 U.S.C. §6103(a). The designated day is the legal public holiday";
}

// §6103(b)(1): «Instead of a holiday that occurs on a Saturday…» — это
// ИЗЪЯТИЕ, а не второй праздник. Поэтому подстановка записана ДВУМЯ нормами:
// одна отнимает назначенный день, вторая назначает пятницу. Пробой было
// проверено, что одной положительной нормы недостаточно: `key(h)` двух
// разных дат конфликтом не считает, и приоритет положительной нормы над
// положительной оставлял ОБА дня истинными — акт утверждал бы, что праздник
// и 3, и 4 июля. Отрицательная голова + приоритет §116 даёт 4 июля
// FALSE_ONLY, 3 июля TRUE_ONLY (тот же приём, что ст. 28 п. 7 в ОСМС).

@source(USC_5_6103_B1)
rule SaturdayHolidayDisplaced(h: Holiday, day: Date) defeasible {
    when falls_on_saturday(h) and holiday_designated_on(h, day);
    then not observed_holiday_on(h, day);
    label en official "5 U.S.C. §6103(b)(1). A holiday that occurs on a Saturday is not itself the legal public holiday for a Monday-through-Friday workweek";
}

@source(USC_5_6103_B1)
rule FridayBeforeSaturdayHoliday(h: Holiday, day: Date) defeasible {
    when falls_on_saturday(h) and friday_immediately_before(h, day);
    then observed_holiday_on(h, day);
    label en official "5 U.S.C. §6103(b)(1). Instead of a holiday that occurs on a Saturday, the Friday immediately before is the legal public holiday";
}

@source(USC_5_6103_B1)
priority SubstitutionDisplacesDesignatedDay {
    prefer SaturdayHolidayDisplaced over DesignatedDayIsHoliday;
    reason lex_specialis;
    label en official "5 U.S.C. §6103(b)(1) is an exception to §6103(a): the substitution displaces the designated day";
}

// --- Константы §54 (E-0032 п. 3): порождено verify/ci/tools/migrate_const_decls.py
// (errata E-0032: индивид называется объявлением §54, значение — entity_ref §36).
// Метки выведены из имени, статус unofficial — уточняются автором. ---

