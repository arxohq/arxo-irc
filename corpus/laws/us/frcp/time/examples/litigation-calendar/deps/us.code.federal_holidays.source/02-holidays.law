    label en unofficial "Birthday Of Martin Luther King Jr";
};
const ChristmasDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#ChristmasDay") {
    label en unofficial "Christmas Day";
};
const ColumbusDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#ColumbusDay") {
    label en unofficial "Columbus Day";
};
const IndependenceDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#IndependenceDay") {
    label en unofficial "Independence Day";
};
const JuneteenthNationalIndependenceDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#JuneteenthNationalIndependenceDay") {
    label en unofficial "Juneteenth National Independence Day";
};
const LaborDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#LaborDay") {
    label en unofficial "Labor Day";
};
const MemorialDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#MemorialDay") {
    label en unofficial "Memorial Day";
};
const NewYearsDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#NewYearsDay") {
    label en unofficial "New Years Day";
};
const ThanksgivingDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#ThanksgivingDay") {
    label en unofficial "Thanksgiving Day";
};
const VeteransDay: Holiday = entity_ref("urn:us:code:clir:federal-holidays#VeteransDay") {
    label en unofficial "Veterans Day";
};
const WashingtonsBirthday: Holiday = entity_ref("urn:us:code:clir:federal-holidays#WashingtonsBirthday") {
    label en unofficial "Washingtons Birthday";
};
