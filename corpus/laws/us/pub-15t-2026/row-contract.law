// Публичные сигнатуры существующих закреплённых выдач таблиц Pub. 15-T (2026).
// Объявления не задают значений и не выбирают строку: значения и выбор строки
// принадлежат таблицам `sources/tables/*.lawtable.json` (§24: потребитель
// ссылается только на `pub`-символы владельца).
pub relation annual_pct_bracket(schedule: Text, status: Text, wage: Decimal, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en unofficial "bracket row of the annual percentage method table (Pub. 15-T 2026, section 1) selected by schedule, filing status and wage";
}

pub relation manual_pct_2020_bracket(period: Text, schedule: Text, status: Text, wage: Decimal, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en unofficial "bracket row of the manual percentage method table for Forms W-4 from 2020 (Pub. 15-T 2026, section 4) selected by payroll period, schedule, status and wage";
}

pub relation manual_pct_2019_bracket(period: Text, marital: Text, wage: Decimal, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en unofficial "bracket row of the manual percentage method table for Forms W-4 from 2019 and earlier (Pub. 15-T 2026, section 5) selected by payroll period, marital status and wage";
}

pub relation other_method_tolerance(required_tax: Decimal, cap_base: Decimal, cap_rate: Decimal, cap_over: Decimal) kind institutional {
    label en unofficial "tolerance cap of the alternative withholding methods (Pub. 15-T 2026, section 6) selected by the required tax";
}
