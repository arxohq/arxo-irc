// S corporations -- WIRE-10 group C, owner `returns` (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed;
// no legal review).
//
// Section 1363(d)(2)(B): each installment of the LIFO recapture tax increase is paid on or before the due date (determined without regard
// to extensions) of the return for the last C year and for each of the three succeeding taxable years. The due date was a case-asserted
// placeholder (`return_due_date_without_extensions`, "the returns owner's date"). The owner `us.irc.returns` (module 05, section 6072)
// publishes the statutory due date of the income tax return (`statutory_due_date`, before any section 6081 extension). The placeholder is
// derived from it; the case-fact channel stays valid.
//
// JUDGMENT CALL: the owner date is stated before the section 7503 weekend/holiday rollover, which the placeholder text does not mention;
// the date used here is the statutory date of section 6072 without extensions, not a rolled-over date.

language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

import us.irc.returns version "0.1.1";

use self::{
    Corporation,
    TaxableYear,
    return_due_date_without_extensions,
};

rule W10CReturnDueDateWithoutExtensionsFromReturns strict {
    label en official "section 1363(d)(2)(B): the due date, determined without regard to extensions, of the corporation's income tax return for the taxable year is the statutory due date of section 6072 that the returns package concludes";
    for c: Corporation;
    for y: TaxableYear;
    for due: Date;
    when us.irc.returns::statutory_due_date(c, y, us.irc.core::IncomeCh1, due);
    then return_due_date_without_extensions(c, y, due);
}
