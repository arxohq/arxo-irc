// Section 1378 — Taxable year of S corporation.
//
// SCOPE: (a) the taxable year of an S corporation must be a permitted year;
// (b)(1) a calendar year is always permitted; (b)(2) any other period for
// which a business purpose is established to the Secretary's satisfaction
// (DECISION-0194 evaluative channel, authority Secretary), with the
// closing-sentence negative constraint that deferral of income to
// shareholders alone is not a business purpose — modelled exactly as
// accounting's section 441(i) personal-service-corporation rule (see
// corpus/laws/us/irc/accounting/01-period.law), the closest precedent in
// this corpus for the identical "calendar year unless business purpose"
// shape.

use self::{
    Corporation,
    IRC_S1378_A,
    IRC_S1378_B,
    TaxableYear,
    s_corporation,
};

pub relation is_calendar_year(y: TaxableYear) kind empirical {
    label en official "y is a year ending December 31 (section 1378(b)(1)); case-asserted practice fact, same simplification as accounting's section 441 module (no date-decomposition primitive)";
}
external judgment relation business_purpose_established_for_1378(c: Corporation, y: TaxableYear) {
    authority Secretary;
    label en official "the corporation establishes, to the satisfaction of the Secretary, a business purpose for having y as its accounting period (section 1378(b)(2)); deferral of income to shareholders alone is not a business purpose (section 1378(b), last sentence)";
}
pub relation permitted_year(c: Corporation, y: TaxableYear) kind institutional {
    label en official "y is a permitted year for the S corporation (section 1378(a)-(b))";
}
@source(IRC_S1378_B, quote = "is a year ending December 31, or")
rule PermittedYearCalendar defeasible {
    label en official "a calendar year is always permitted (section 1378(b)(1))";
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    when is_calendar_year(y);
    then permitted_year(c, y);
}
pub relation is_calendar_year_for(c: Corporation, y: TaxableYear) kind institutional {
    label en official "y is a calendar year and c's taxable year for section 1378 purposes";
}
rule IsCalendarYearFor defeasible {
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    when is_calendar_year(y);
    then is_calendar_year_for(c, y);
}
@source(IRC_S1378_B, quote = "is any other accounting period for which the corporation establishes a business purpose to the satisfaction of the Secretary")
rule PermittedYearBusinessPurpose defeasible {
    label en official "a non-calendar year is permitted only on an established business purpose (section 1378(b)(2))";
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    unless is_calendar_year_for(c, y);
    when business_purpose_established_for_1378(c, y);
    then permitted_year(c, y);
}
@source(IRC_S1378_A, quote = "the taxable year of an S corporation shall be a permitted year")
rule S1378TaxableYearMustBePermitted defeasible {
    label en official "the taxable year of an S corporation is required to be a permitted year (section 1378(a))";
    for c: Corporation; for y: TaxableYear;
    when permitted_year(c, y);
    then required_taxable_year_is_permitted_1378(c, y);
}
pub relation required_taxable_year_is_permitted_1378(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the S corporation's taxable year y satisfies the section 1378(a) requirement";
}
// The last sentence of (b) ("any deferral of income to shareholders shall
// not be treated as a business purpose") is, as in accounting's section
// 441(i) module, a negative constraint on the judgment channel's own
// content that this DSL cannot express as a rule over an `external
// judgment relation` — recorded as INTERPRETATION: the requesting party
// must exclude deferral-only justifications before submitting the request;
// no engine-level guard is implemented.
