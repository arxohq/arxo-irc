// Section 1361 — S corporation defined; small business corporation.
//
// SCOPE: (a) S corporation / C corporation definitions; (b)(1) the small
// business corporation test in full (domestic, not ineligible, <=100
// counted shareholders, no non-individual shareholder outside the permitted
// list, no nonresident alien shareholder, one class of stock); (b)(2)
// ineligible corporation; (b)(3) QSSS as a power; (c)(1) family aggregation
// (representative asserted, see 01-ontology.law); (c)(2) permitted trusts;
// (c)(4)-(5) one-class-of-stock safe harbors; (c)(6) exempt-organization
// shareholders; (d) QSST election as a power; (e) ESBT election as a power;
// (f)-(g) restricted bank director stock / bad-debt method change — recorded
// as EXTERNAL_DEPENDENCY / narrow classification only (see coverage notes).
//
// SIMPLIFICATION: `permitted_shareholder` is evaluated only over persons
// asserted as shareholders of SOME corporation on SOME date (bound through
// `shareholder_of`), not over every conceivable `Individual`/`Estate`/
// `Trust` instance in a case — the type alone is not read as a finite
// establishing source (§190); this matches how the predicate is actually
// consumed by `HasDisqualifiedShareholderNotPermitted` below.

// --- (a): S corporation / C corporation ---------------------------------

use self::{
    Corporation,
    Estate,
    IRC_S1361_A,
    IRC_S1361_B,
    IRC_S1361_C,
    IRC_S1361_D,
    IRC_S1361_E,
    Individual,
    Person,
    StockDifferenceKind,
    TaxableYear,
    Trust,
    counted_shareholder_unit,
    esbt_terms_met,
    permitted_trust_shareholder_1361c2,
    qsst_terms_met,
    shareholder_of,
    stock_instrument_difference,
};

pub relation s_corporation(c: Corporation, y: TaxableYear) kind institutional {
    label en official "S corporation: a small business corporation for which an election under section 1362(a) is in effect for the taxable year (section 1361(a)(1))";
}
pub relation c_corporation(c: Corporation, y: TaxableYear) kind institutional {
    label en official "C corporation: a corporation which is not an S corporation for the taxable year (section 1361(a)(2))";
}
@source(IRC_S1361_A, quote = "a corporation which is not an S corporation for such year")
rule CCorporationIsNotSCorporation defeasible {
    label en official "a corporation which is not an S corporation for the taxable year is a C corporation (section 1361(a)(2))";
    for c: Corporation; for y: TaxableYear;
    when us.irc.definitions::corporation(c);
    when us.irc.core::year_of(c, y);
    unless s_corporation(c, y);
    then c_corporation(c, y);
}
// s_corporation(c, y) itself is concluded in 03-election.law by the election
// power's effect together with the small_business_corporation status
// required to remain one; see that module's header for the termination
// cross-reference.

// --- (b)(2): ineligible corporation --------------------------------------
// Each branch names a classification this package does not own: §585 bad-
// debt reserve method (accounting), subchapter L insurance company and DISC
// status (corporations). Recorded as typed pending dependencies
// (s-corporations.deps.json) and taken as case-asserted classifications
// here, per AGENT-BRIEF's "cross-references... typed dependency contract".
pub relation financial_institution_585_reserve_method(c: Corporation) kind empirical {
    label en official "c is a financial institution which uses the reserve method of accounting for bad debts described in section 585 (section 1361(b)(2)(A)); case-asserted pending an accounting-package contract";
}
pub relation insurance_company_subchapter_l(c: Corporation) kind empirical {
    label en official "c is an insurance company subject to tax under subchapter L (section 1361(b)(2)(B)); case-asserted pending a corporations-package contract";
}
pub relation disc_or_former_disc(c: Corporation) kind institutional {
    label en official "c is a DISC or former DISC (section 1361(b)(2)(C)); the former-DISC limb is derived in 15-wire9-two-percent-shareholder-and-s-period.law from `us.irc.international::former_disc_992a3`, a DISC (not former) is asserted by the case";
}
pub relation ineligible_corporation(c: Corporation) kind institutional {
    label en official "c is an ineligible corporation under section 1361(b)(2)";
}
@source(IRC_S1361_B, quote = "a financial institution which uses the reserve method of accounting for bad debts described in section 585")
rule IneligibleFinancialInstitution strict {
    label en official "a section 585 reserve-method financial institution is an ineligible corporation (section 1361(b)(2)(A))";
    for c: Corporation;
    when financial_institution_585_reserve_method(c);
    then ineligible_corporation(c);
}
@source(IRC_S1361_B, quote = "an insurance company subject to tax under subchapter L")
rule IneligibleInsuranceCompany strict {
    label en official "a subchapter L insurance company is an ineligible corporation (section 1361(b)(2)(B))";
    for c: Corporation;
    when insurance_company_subchapter_l(c);
    then ineligible_corporation(c);
}
@source(IRC_S1361_B, quote = "a DISC or former DISC")
rule IneligibleDisc strict {
    label en official "a DISC or former DISC is an ineligible corporation (section 1361(b)(2)(C))";
    for c: Corporation;
    when disc_or_former_disc(c);
    then ineligible_corporation(c);
}

// --- (c)(2): permitted trust shareholders; (c)(6): exempt organizations ---
// The trust taxonomy of (c)(2)(A)(i)-(vi) (grantor trusts, testamentary
// continuation trusts, voting trusts, ESBTs, IRA-in-a-bank-holding-company
// trusts) is a `trusts-estates` classification this package does not own;
// taken as a case-asserted membership test, pending contract.
// permitted_trust_shareholder_1361c2 is derived in 12-trusts-family-and-bank-stock.law (stage 3).
pub relation exempt_organization_shareholder_1361c6(p: Person) kind empirical {
    label en official "p is an organization described in section 401(a) or 501(c)(3) and exempt from taxation under section 501(a) (section 1361(c)(6)); case-asserted pending an exempt-organizations-package contract";
}
pub relation permitted_shareholder(sh: Person, on: Date) kind institutional {
    label en official "sh is a kind of person permitted to be an S-corporation shareholder under section 1361(b)(1)(B) on date on: an individual, an estate, a section 1361(c)(2) trust, or a section 1361(c)(6) organization";
}
@source(IRC_S1361_B, quote = "other than an estate, a trust described in subsection (c)(2), or an organization described in subsection (c)(6)")
rule PermittedShareholderIndividual strict {
    label en official "an individual shareholder is a permitted shareholder (section 1361(b)(1)(B) a contrario)";
    for sh: Individual; for c: Corporation; for on: Date;
    when shareholder_of(sh, c, on);
    then permitted_shareholder(sh, on);
}
rule PermittedShareholderEstate strict {
    label en official "an estate shareholder is a permitted shareholder (section 1361(b)(1)(B))";
    for sh: Estate; for c: Corporation; for on: Date;
    when shareholder_of(sh, c, on);
    then permitted_shareholder(sh, on);
}
@source(IRC_S1361_C, quote = "the following trusts may be shareholders")
rule PermittedShareholderTrust strict {
    label en official "a section 1361(c)(2) trust shareholder is a permitted shareholder (section 1361(b)(1)(B), (c)(2))";
    for sh: Trust; for on: Date;
    when permitted_trust_shareholder_1361c2(sh, on);
    then permitted_shareholder(sh, on);
}
@source(IRC_S1361_C, quote = "may be a shareholder in an S corporation")
rule PermittedShareholderExemptOrganization strict {
    label en official "a section 401(a)/501(c)(3) organization exempt under section 501(a) is a permitted shareholder (section 1361(b)(1)(B), (c)(6))";
    for sh: Person; for c: Corporation; for on: Date;
    when shareholder_of(sh, c, on);
    when exempt_organization_shareholder_1361c6(sh);
    then permitted_shareholder(sh, on);
}

// --- (b)(1): the small business corporation test -------------------------

pub relation shareholder_count_exceeds_100(c: Corporation, on: Date) kind institutional {
    label en official "c has more than 100 counted shareholders on date on (section 1361(b)(1)(A))";
}
@source(IRC_S1361_B, quote = "have more than 100 shareholders")
rule ShareholderCountExceeds100 strict {
    label en official "more than 100 counted shareholder units on date on";
    for c: Corporation; for on: Date;
    when shareholder_of_any(c, on);
    when count(collect u: Person where counted_shareholder_unit(u, c, on)) > 100;
    then shareholder_count_exceeds_100(c, on);
}
// Binds (c, on) to an actually-asserted corporation/date pair without
// re-quantifying over the whole `Corporation`/`Date` domains.
pub relation shareholder_of_any(c: Corporation, on: Date) kind institutional {
    label en official "some person is asserted as a shareholder of c on date on";
}
rule ShareholderOfAny strict {
    for sh: Person; for c: Corporation; for on: Date;
    when shareholder_of(sh, c, on);
    then shareholder_of_any(c, on);
}

pub relation has_disqualified_shareholder(c: Corporation, on: Date) kind institutional {
    label en official "c has a shareholder who is neither an individual, an estate, a permitted trust, nor a permitted organization (section 1361(b)(1)(B))";
}
@source(IRC_S1361_B, quote = "who is not an individual")
rule HasDisqualifiedShareholderNotPermitted strict {
    label en official "a shareholder who is not a permitted kind of person disqualifies the corporation (section 1361(b)(1)(B))";
    for sh: Person; for c: Corporation; for on: Date;
    when shareholder_of(sh, c, on);
    when not_known(permitted_shareholder(sh, on));
    then has_disqualified_shareholder(c, on);
}

pub relation has_nonresident_alien_shareholder(c: Corporation, on: Date) kind institutional {
    label en official "c has a nonresident alien as a shareholder (section 1361(b)(1)(C))";
}
// Bridges a Date to the calendar-year Integer that section 7701(b) residency
// tests are stated per; case-asserted rather than derived from a calendar
// decomposition primitive (TECH-GAPS.md G46).
pub relation calendar_year_of_date(on: Date, y: Integer) kind empirical {
    label en official "on falls within calendar year y; case-asserted (no date-decomposition primitive), TECH-GAPS.md G46";
}
@source(IRC_S1361_B, quote = "have a nonresident alien as a shareholder")
rule HasNonresidentAlienShareholder strict {
    label en official "a nonresident alien shareholder disqualifies the corporation (section 1361(b)(1)(C))";
    for sh: Individual; for c: Corporation; for on: Date; for y: Integer;
    when shareholder_of(sh, c, on);
    when calendar_year_of_date(on, y);
    when us.irc.definitions::nonresident_alien_for_year(sh, y);
    then has_nonresident_alien_shareholder(c, on);
}

pub relation has_more_than_one_class_of_stock(c: Corporation, on: Date) kind institutional {
    label en official "c has more than one class of stock (section 1361(b)(1)(D)), after the voting-rights (c)(4) and straight-debt (c)(5) safe harbors";
}
@source(IRC_S1361_B, quote = "have more than 1 class of stock")
rule HasMoreThanOneClassOfStock strict {
    label en official "an economic-rights difference among outstanding stock instruments is a second class of stock (section 1361(b)(1)(D)); the (c)(4) voting-rights-only and (c)(5) straight-debt differences are excluded by construction (see StockDifferenceKind)";
    for c: Corporation; for on: Date;
    when stock_instrument_difference(c, on, EconomicRightsDifference);
    then has_more_than_one_class_of_stock(c, on);
}
// (c)(4) voting-rights-only and (c)(5) straight-debt differences never fire
// this rule because they are asserted under the OTHER two `StockDifferenceKind`
// values, not `EconomicRightsDifference`. The straight-debt DEFINITION
// itself (section 1361(c)(5)(B): interest-contingency, non-convertibility,
// permitted-creditor tests) is not re-derived — the case asserts the KIND
// directly (INTERPRETATION: classifying an instrument as
// `StraightDebtInstrument` is a judgment the case makes in this stage).

pub relation domestic_corporation(c: Corporation) kind institutional {
    label en official "c is a domestic corporation (section 1361(b)(1), section 7701(a)(4) via us.irc.definitions)";
}
rule DomesticCorporationFromDefinitions strict {
    for c: Corporation;
    when us.irc.definitions::domestic(c);
    then domestic_corporation(c);
}

pub relation small_business_corporation(c: Corporation, on: Date) kind institutional {
    label en official "c is a small business corporation for purposes of Subchapter S (section 1361(b)(1))";
}
@source(IRC_S1361_B, quote = "the term \"small business corporation\" means a domestic corporation which is not an ineligible corporation and which does not")
rule SmallBusinessCorporation strict {
    label en official "domestic, not ineligible, <=100 shareholders, no disqualified shareholder, no nonresident alien shareholder, one class of stock (section 1361(b)(1))";
    for c: Corporation; for on: Date;
    when domestic_corporation(c);
    when shareholder_of_any(c, on);
    when not_known(ineligible_corporation(c));
    when not_known(shareholder_count_exceeds_100(c, on));
    when not_known(has_disqualified_shareholder(c, on));
    when not_known(has_nonresident_alien_shareholder(c, on));
    when not_known(has_more_than_one_class_of_stock(c, on));
    then small_business_corporation(c, on);
}

// --- (b)(3): qualified subchapter S subsidiary (QSSS) as a power ---------

pub relation qsss_wholly_owned(parent: Corporation, sub: Corporation, on: Date) kind empirical {
    label en official "100 percent of the stock of sub is held by the S corporation parent (section 1361(b)(3)(B)(i))";
}
pub relation elects_qsss(parent: Corporation, sub: Corporation, on: Date) kind empirical {
    label en official "the S corporation parent elects to treat sub as a qualified subchapter S subsidiary (section 1361(b)(3)(B)(ii))";
}
pub relation qsss_eligible(parent: Corporation, sub: Corporation, on: Date) kind institutional {
    label en official "sub is a domestic corporation, not an ineligible corporation, wholly owned by the S corporation parent (section 1361(b)(3)(B))";
}
rule QsssEligible strict {
    for parent: Corporation; for sub: Corporation; for on: Date;
    when domestic_corporation(sub);
    when qsss_wholly_owned(parent, sub, on);
    when not_known(ineligible_corporation(sub));
    then qsss_eligible(parent, sub, on);
}
pub relation qualified_subchapter_s_subsidiary(parent: Corporation, sub: Corporation, on: Date) kind institutional {
    label en official "sub is a qualified subchapter S subsidiary of parent: not treated as a separate corporation, its items treated as the S corporation's own (section 1361(b)(3)(A))";
}
@source(IRC_S1361_B, quote = "the S corporation elects to treat such corporation as a qualified subchapter S subsidiary")
rule QsssElectionGrantsQsssStatus strict {
    label en official "an S corporation may elect to treat an eligible wholly owned subsidiary as a QSSS (section 1361(b)(3)(B)(ii))";
    for parent: Corporation; for sub: Corporation; for on: Date;
    when elects_qsss(parent, sub, on);
    then power QsssElectionPower {
        holder parent;
        over sub;
        exercise elects_qsss(parent, sub, on);
        valid_when qsss_eligible(parent, sub, on);
        effect create(qualified_subchapter_s_subsidiary(parent, sub, on));
        window [@1997-01-01, infinity);
    };
}

// --- (d): QSST election as a power (beneficiary's own election) ----------

pub entity QualifiedSubchapterSTrust : Trust { label en unofficial "a trust meeting section 1361(d)(3)'s single-current-income-beneficiary terms"; }
// qsst_terms_met is derived in 12-trusts-family-and-bank-stock.law (stage 3).
pub relation elects_qsst(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation, on: Date) kind empirical {
    label en official "the beneficiary of t elects under section 1361(d)(2) to have subsection (d) apply with respect to stock of c held by t";
}
pub relation qsst_election_in_effect(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation) kind institutional {
    label en official "a section 1361(d)(2) QSST election is in effect: t is treated as a section 1361(c)(2)(A)(i) trust and the beneficiary is treated as the owner of the S-corporation-stock portion (section 1361(d)(1))";
}
@source(IRC_S1361_D, quote = "may elect to have this subsection apply")
rule QsstElectionGrantsQsstStatus strict {
    label en official "a QSST beneficiary may elect QSST treatment separately for each corporation whose stock the trust holds (section 1361(d)(2)(A)-(B)(i))";
    for beneficiary: Person; for t: QualifiedSubchapterSTrust; for c: Corporation; for on: Date;
    when elects_qsst(beneficiary, t, c, on);
    then power QsstElectionPower {
        holder beneficiary;
        over t;
        exercise elects_qsst(beneficiary, t, c, on);
        valid_when qsst_terms_met(t);
        effect create(qsst_election_in_effect(beneficiary, t, c));
        window [@1958-01-01, infinity);
    };
}
// Feeds PermittedShareholderTrust through permitted_trust_shareholder_1361c2:
// a trust with a QSST election in effect for the corporation is, by
// (d)(1)(A), treated as a (c)(2)(A)(i) trust. Not wired automatically here
// (the case asserts permitted_trust_shareholder_1361c2 directly); recorded
// as a modeling simplification, not a TECH_GAP, since both facts are
// available to a case builder.

// --- (e): electing small business trust (ESBT) election as a power -------

pub entity ElectingSmallBusinessTrust : Trust { label en unofficial "a trust meeting section 1361(e)(1)'s beneficiary and no-purchase terms, with an election under (e)(3) applying to it"; }
// esbt_terms_met is derived in 12-trusts-family-and-bank-stock.law (stage 3).
pub relation trustee_of(p: Person, t: ElectingSmallBusinessTrust) kind empirical {
    label en official "p is the trustee of t";
}
pub relation trustee_elects_esbt(p: Person, t: ElectingSmallBusinessTrust, on: Date) kind empirical {
    label en official "the trustee elects ESBT treatment under section 1361(e)(3)";
}
pub relation electing_small_business_trust(t: ElectingSmallBusinessTrust) kind institutional {
    label en official "t is an electing small business trust with a section 1361(e)(3) election in effect";
}
@source(IRC_S1361_E, quote = "An election under this subsection shall be made by the trustee")
rule EsbtElectionGrantsEsbtStatus strict {
    label en official "the trustee may elect ESBT treatment (section 1361(e)(3))";
    for p: Person; for t: ElectingSmallBusinessTrust; for on: Date;
    when trustee_of(p, t);
    when trustee_elects_esbt(p, t, on);
    then power EsbtElectionPower {
        holder p;
        over t;
        exercise trustee_elects_esbt(p, t, on);
        valid_when esbt_terms_met(t);
        effect create(electing_small_business_trust(t));
        window [@1997-01-01, infinity);
    };
}
