// Stage 3 (26.09.2026) — the details of section 1361 that stage 1 took as
// case-asserted wholesale: the permitted trusts of (c)(2) and who is treated
// as their shareholder, the terms of a QSST (d)(3) and of an ESBT (e)(1)-(2),
// the QSST election's grace period, revocation and termination ((d)(2)(C)-(D),
// (d)(4), (e)(3)), restricted bank director stock (f) with section 1368(f),
// the family definition of (c)(1)(B)-(C), the QSSS terminations of
// (b)(3)(C)-(D) and the bank's section 481 election of (g).
//
// A relation this stage turns from case-asserted to derived keeps its name
// and signature (`qsst_terms_met`, `esbt_terms_met`,
// `permitted_trust_shareholder_1361c2`): the components it now reads are
// asserted instead. Every rule here is strict and reads empirical facts, or
// derived facts of strict rules with `not_known(...)` for absent exceptions
// (the chain of 02-eligibility.law is strict throughout).

// --- (d)(3): the terms of a qualified subchapter S trust -----------------

use self::{
    Corporation,
    ElectingSmallBusinessTrust,
    Estate,
    IRC_S1361_B,
    IRC_S1361_C,
    IRC_S1361_D,
    IRC_S1361_E,
    IRC_S1361_F,
    IRC_S1361_G,
    IRC_S1368_F,
    Individual,
    Person,
    QualifiedSubchapterSTrust,
    TaxableYear,
    Trust,
    at_least_five_taxable_years_after,
    elects_qsst,
    next_taxable_year,
    qsst_election_in_effect,
    shareholder_of,
    shares_outstanding,
    trustee_elects_esbt,
    trustee_of,
};

pub relation qsst_only_one_income_beneficiary_during_life(t: QualifiedSubchapterSTrust) kind empirical {
    label en official "the terms of t require that, during the life of the current income beneficiary, there shall be only 1 income beneficiary (section 1361(d)(3)(A)(i))";
}
pub relation qsst_corpus_only_to_current_income_beneficiary(t: QualifiedSubchapterSTrust) kind empirical {
    label en official "the terms of t require that any corpus distributed during the life of the current income beneficiary may be distributed only to that beneficiary (section 1361(d)(3)(A)(ii))";
}
pub relation qsst_income_interest_ends_on_earlier_of_death_or_termination(t: QualifiedSubchapterSTrust) kind empirical {
    label en official "the terms of t require that the income interest of the current income beneficiary terminate on the earlier of the beneficiary's death or the termination of the trust (section 1361(d)(3)(A)(iii))";
}
pub relation qsst_distributes_all_assets_to_beneficiary_on_lifetime_termination(t: QualifiedSubchapterSTrust) kind empirical {
    label en official "the terms of t require that, upon termination of the trust during the life of the current income beneficiary, the trust distribute all of its assets to that beneficiary (section 1361(d)(3)(A)(iv))";
}
pub relation qsst_income_distributed_currently_to(t: QualifiedSubchapterSTrust, beneficiary: Person) kind empirical {
    label en official "all of the income (within the meaning of section 643(b)) of t is distributed, or required to be distributed, currently to beneficiary (section 1361(d)(3)(B))";
}
pub relation qsst_beneficiary_is_us_individual(t: QualifiedSubchapterSTrust, beneficiary: Individual) kind institutional {
    label en official "the sole current income distributee is an individual who is a citizen or resident of the United States (section 1361(d)(3)(B))";
}
rule QsstBeneficiaryCitizen strict {
    for t: QualifiedSubchapterSTrust; for b: Individual;
    when qsst_income_distributed_currently_to(t, b);
    when us.irc.definitions::citizen_of_united_states(b);
    then qsst_beneficiary_is_us_individual(t, b);
}
rule QsstBeneficiaryResident strict {
    for t: QualifiedSubchapterSTrust; for b: Individual;
    when qsst_income_distributed_currently_to(t, b);
    when us.irc.definitions::resident_of_united_states(b);
    then qsst_beneficiary_is_us_individual(t, b);
}
pub relation qsst_terms_met(t: QualifiedSubchapterSTrust) kind institutional {
    label en official "t is a qualified subchapter S trust: the four terms of (d)(3)(A) and current distribution of all income to one U.S. citizen or resident individual under (d)(3)(B); the components are asserted, the trust-instrument reading is not derived";
}
@source(IRC_S1361_D, coverage = partial, quote = "the term \"qualified subchapter S trust\" means a trust")
rule QsstTermsMet strict {
    label en official "a trust meeting all of (d)(3)(A)(i)-(iv) and (B) is a qualified subchapter S trust (section 1361(d)(3))";
    for t: QualifiedSubchapterSTrust; for b: Individual;
    when qsst_only_one_income_beneficiary_during_life(t);
    when qsst_corpus_only_to_current_income_beneficiary(t);
    when qsst_income_interest_ends_on_earlier_of_death_or_termination(t);
    when qsst_distributes_all_assets_to_beneficiary_on_lifetime_termination(t);
    when qsst_beneficiary_is_us_individual(t, b);
    then qsst_terms_met(t);
}

// --- (d)(2)(D): grace period of the election ------------------------------

pub relation qsst_election_earliest_effective_date(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation, on: Date, earliest: Date) kind institutional {
    label en official "the earliest date a QSST election made on date on can be effective: up to 15 days and 2 months before the date of the election (section 1361(d)(2)(D))";
}
@source(IRC_S1361_D, coverage = partial, quote = "An election under this paragraph shall be effective up to 15 days and 2 months before the date of the election.")
rule S1361D2DGracePeriod strict {
    for b: Person; for t: QualifiedSubchapterSTrust; for c: Corporation; for on: Date;
    for calendar_before_1: Date;
    for calendar_before_2: Date;
    when elects_qsst(b, t, c, on)
        and us.irc.core::civil_calendar_boundary_before(on, 2, us.irc.core::CalendarMonth, calendar_before_1)
        and us.irc.core::civil_calendar_boundary_before(calendar_before_1, 15, us.irc.core::CalendarDay, calendar_before_2);
    then qsst_election_earliest_effective_date(b, t, c, on, calendar_before_2);
}
pub relation qsst_election_effective_from(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation, on: Date, effective_from: Date) kind empirical {
    label en official "the date from which the beneficiary asks that the election be effective";
}
pub relation qsst_election_effective_date_within_grace(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation, on: Date, effective_from: Date) kind institutional {
    label en official "the requested effective date is not earlier than the grace-period limit and not later than the election date (section 1361(d)(2)(D))";
}
rule QsstEffectiveDateWithinGrace strict {
    for b: Person; for t: QualifiedSubchapterSTrust; for c: Corporation; for on: Date; for from: Date; for earliest: Date;
    when qsst_election_effective_from(b, t, c, on, from);
    when qsst_election_earliest_effective_date(b, t, c, on, earliest);
    when from >= earliest;
    when from <= on;
    then qsst_election_effective_date_within_grace(b, t, c, on, from);
}

// --- (d)(2)(C): irrevocable without the Secretary's consent --------------

external judgment relation secretary_consents_to_qsst_revocation(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation) {
    authority Secretary;
    label en official "the Secretary consents to the revocation of the QSST election (section 1361(d)(2)(C))";
}
pub relation revokes_qsst_election(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation, on: Date) kind empirical {
    label en official "the beneficiary purports to revoke the QSST election";
}
pub relation qsst_election_revoked(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation, on: Date) kind institutional {
    label en official "a validly exercised revocation of the QSST election, made with the Secretary's consent";
}
@source(IRC_S1361_D, coverage = partial, quote = "An election under this paragraph, once made, may be revoked only with the consent of the Secretary.")
rule S1361D2CRevocationPower strict {
    label en official "a QSST election may be revoked only with the Secretary's consent (section 1361(d)(2)(C))";
    for b: Person; for t: QualifiedSubchapterSTrust; for c: Corporation; for on: Date;
    when revokes_qsst_election(b, t, c, on);
    then power QsstRevocationPower {
        holder b;
        over t;
        exercise revokes_qsst_election(b, t, c, on);
        valid_when secretary_consents_to_qsst_revocation(b, t, c);
        effect create(qsst_election_revoked(b, t, c, on));
        window [@1982-01-01, infinity);
    };
}

// --- (d)(4): a trust ceasing to be qualified -----------------------------

pub relation qsst_ceases_to_meet_3a_on(t: QualifiedSubchapterSTrust, d: Date) kind empirical {
    label en official "t ceases on d to meet a requirement of (d)(3)(A)";
}
pub relation qsst_ceases_to_meet_3b_in_year(t: QualifiedSubchapterSTrust, y: TaxableYear) kind empirical {
    label en official "y is the first taxable year for which t fails a requirement of (d)(3)(B) while continuing to meet (d)(3)(A)";
}
pub relation qsst_subsection_not_applicable_from(t: QualifiedSubchapterSTrust, d: Date) kind institutional {
    label en official "subsection (d) does not apply to t from date d on (section 1361(d)(4))";
}
@source(IRC_S1361_D, coverage = partial, quote = "the provisions of this subsection shall not apply to such trust as of the date it ceases to meet such requirement")
rule S1361D4ACeasesRequirement strict {
    for t: QualifiedSubchapterSTrust; for d: Date;
    when qsst_ceases_to_meet_3a_on(t, d);
    then qsst_subsection_not_applicable_from(t, d);
}
@source(IRC_S1361_D, coverage = partial, quote = "as of the first day of the first taxable year beginning after the first taxable year for which it failed to meet the requirements of paragraph (3)(B)")
rule S1361D4BCeasesIncomeRequirement strict {
    for t: QualifiedSubchapterSTrust; for y: TaxableYear; for ny: TaxableYear; for d: Date;
    when qsst_ceases_to_meet_3b_in_year(t, y);
    when next_taxable_year(y, ny);
    when us.irc.core::begins(ny, d);
    then qsst_subsection_not_applicable_from(t, d);
}

// --- (e)(1): the terms of an electing small business trust ---------------

pub enum EsbtBeneficiaryClass {
    IndividualBeneficiary;
    EstateBeneficiary;
    Section170c2To5Organization;
    Section170c1OrganizationContingentInterest;
    label en unofficial "the beneficiary classes of section 1361(e)(1)(A)(i)(I)-(IV)";
}
pub relation esbt_beneficiary(t: ElectingSmallBusinessTrust, p: Person) kind empirical {
    label en official "p is a beneficiary of t";
}
pub relation esbt_beneficiary_class(t: ElectingSmallBusinessTrust, p: Person, k: EsbtBeneficiaryClass) kind empirical {
    label en official "p, a beneficiary of t, belongs to the given class of section 1361(e)(1)(A)(i)";
}
pub relation esbt_potential_current_beneficiary_flag(t: ElectingSmallBusinessTrust, p: Person) kind empirical {
    label en official "p is a potential current beneficiary of t for the purposes of section 1361(e)(1)(A)(i)(IV); the (e)(2) definition is separate below";
}
pub relation esbt_beneficiary_permitted(t: ElectingSmallBusinessTrust, p: Person) kind institutional {
    label en official "p is a beneficiary of a permitted class: an individual, an estate, a section 170(c)(2)-(5) organization, or a section 170(c)(1) organization holding a contingent interest that is not a potential current beneficiary (section 1361(e)(1)(A)(i))";
}
rule EsbtBeneficiaryIndividual strict {
    for t: ElectingSmallBusinessTrust; for p: Person;
    when esbt_beneficiary_class(t, p, IndividualBeneficiary);
    then esbt_beneficiary_permitted(t, p);
}
rule EsbtBeneficiaryEstate strict {
    for t: ElectingSmallBusinessTrust; for p: Person;
    when esbt_beneficiary_class(t, p, EstateBeneficiary);
    then esbt_beneficiary_permitted(t, p);
}
rule EsbtBeneficiaryOrganization strict {
    for t: ElectingSmallBusinessTrust; for p: Person;
    when esbt_beneficiary_class(t, p, Section170c2To5Organization);
    then esbt_beneficiary_permitted(t, p);
}
rule EsbtBeneficiaryContingentOrganization strict {
    for t: ElectingSmallBusinessTrust; for p: Person;
    when esbt_beneficiary_class(t, p, Section170c1OrganizationContingentInterest);
    when not_known(esbt_potential_current_beneficiary_flag(t, p));
    then esbt_beneficiary_permitted(t, p);
}
pub relation esbt_has_impermissible_beneficiary(t: ElectingSmallBusinessTrust) kind institutional {
    label en official "t has a beneficiary of no permitted class (section 1361(e)(1)(A)(i))";
}
rule EsbtImpermissibleBeneficiary strict {
    for t: ElectingSmallBusinessTrust; for p: Person;
    when esbt_beneficiary(t, p);
    when not_known(esbt_beneficiary_permitted(t, p));
    then esbt_has_impermissible_beneficiary(t);
}
pub relation esbt_interest_acquired_by_purchase(t: ElectingSmallBusinessTrust) kind empirical {
    label en official "an interest in t was acquired by purchase: an acquisition for which the basis of the property acquired is determined under section 1012 (section 1361(e)(1)(A)(ii), (C))";
}
pub relation esbt_is_qsst_with_2_election(t: ElectingSmallBusinessTrust) kind empirical {
    label en official "t is a qualified subchapter S trust as defined in (d)(3) and an election under (d)(2) applies to a corporation the stock of which t holds (section 1361(e)(1)(B)(i))";
}
pub relation esbt_tax_exempt_trust(t: ElectingSmallBusinessTrust) kind empirical {
    label en official "t is exempt from tax under subtitle A (section 1361(e)(1)(B)(ii))";
}
pub relation esbt_charitable_remainder_trust(t: ElectingSmallBusinessTrust) kind empirical {
    label en official "t is a charitable remainder annuity trust or charitable remainder unitrust as defined in section 664(d) (section 1361(e)(1)(B)(iii))";
}
pub relation esbt_excluded_trust(t: ElectingSmallBusinessTrust) kind institutional {
    label en official "t is one of the three trusts section 1361(e)(1)(B) excludes";
}
rule EsbtExcludedQsst strict {
    for t: ElectingSmallBusinessTrust;
    when esbt_is_qsst_with_2_election(t);
    then esbt_excluded_trust(t);
}
rule EsbtExcludedTaxExempt strict {
    for t: ElectingSmallBusinessTrust;
    when esbt_tax_exempt_trust(t);
    then esbt_excluded_trust(t);
}
rule EsbtExcludedCrt strict {
    for t: ElectingSmallBusinessTrust;
    when esbt_charitable_remainder_trust(t);
    then esbt_excluded_trust(t);
}
pub relation esbt_terms_met(t: ElectingSmallBusinessTrust) kind institutional {
    label en official "t meets section 1361(e)(1)(A)(i)-(ii) and is not excluded by (B): only permitted beneficiaries, no interest acquired by purchase, not a QSST with a (d)(2) election, not tax-exempt, not a charitable remainder trust; the election of (A)(iii) is the power below";
}
@source(IRC_S1361_E, coverage = partial, quote = "such trust does not have as a beneficiary any person other than")
rule EsbtTermsMet strict {
    label en official "an ESBT has only permitted beneficiaries, no purchased interest, and is not an excluded trust (section 1361(e)(1)(A)(i)-(ii), (B))";
    for t: ElectingSmallBusinessTrust; for p: Person;
    when esbt_beneficiary(t, p);
    when not_known(esbt_has_impermissible_beneficiary(t));
    when not_known(esbt_interest_acquired_by_purchase(t));
    when not_known(esbt_excluded_trust(t));
    then esbt_terms_met(t);
}

// --- (e)(2): potential current beneficiary --------------------------------

pub relation may_receive_distribution_during(p: Person, t: ElectingSmallBusinessTrust, from: Date, to: Date) kind empirical {
    label en official "p is at some time during the period entitled to, or at the discretion of any person may receive, a distribution from the principal or income of t, disregarding a power of appointment unexercised at the end of the period (section 1361(e)(2))";
}
pub relation trust_disposed_all_stock_on(t: ElectingSmallBusinessTrust, c: Corporation, d: Date) kind empirical {
    label en official "t disposes of all of the stock it holds in c on date d (section 1361(e)(2), second sentence)";
}
pub relation first_met_pcb_requirements_on(p: Person, t: ElectingSmallBusinessTrust, d: Date) kind empirical {
    label en official "p first met the requirements of the first sentence of section 1361(e)(2) on d";
}
pub relation pcb_excluded_by_disposition(p: Person, t: ElectingSmallBusinessTrust, c: Corporation) kind institutional {
    label en official "if t disposes of all its stock in c, the term does not include a person who first met the requirements during the 1-year period ending on the date of the disposition (section 1361(e)(2))";
}
@source(IRC_S1361_E, coverage = partial, quote = "does not include any person who first met the requirements of the preceding sentence during the 1-year period ending on the date of such disposition")
rule S1361E2Lookback strict {
    for p: Person; for t: ElectingSmallBusinessTrust; for c: Corporation; for disposed: Date; for first: Date;
    for calendar_before_1: Date;
    when trust_disposed_all_stock_on(t, c, disposed);
    when first_met_pcb_requirements_on(p, t, first);
    when first > calendar_before_1;
    when first <= disposed
        and us.irc.core::civil_calendar_boundary_before(disposed, 1, us.irc.core::CalendarYear, calendar_before_1);
    then pcb_excluded_by_disposition(p, t, c);
}
pub relation potential_current_beneficiary_of(p: Person, t: ElectingSmallBusinessTrust, c: Corporation, from: Date, to: Date) kind institutional {
    label en official "p is a potential current beneficiary of t with respect to c for the period (section 1361(e)(2))";
}
@source(IRC_S1361_E, coverage = partial, quote = "any person who at any time during such period is entitled to, or at the discretion of any person may receive, a distribution from the principal or income of the trust")
rule S1361E2PotentialCurrentBeneficiary strict {
    for p: Person; for t: ElectingSmallBusinessTrust; for c: Corporation; for from: Date; for to: Date;
    when may_receive_distribution_during(p, t, from, to);
    when shareholder_of(t, c, from);
    when not_known(pcb_excluded_by_disposition(p, t, c));
    then potential_current_beneficiary_of(p, t, c, from, to);
}

// --- (e)(3): the ESBT election continues; revocation needs consent -------

external judgment relation secretary_consents_to_esbt_revocation(p: Person, t: ElectingSmallBusinessTrust) {
    authority Secretary;
    label en official "the Secretary consents to the revocation of the ESBT election (section 1361(e)(3))";
}
pub relation revokes_esbt_election(p: Person, t: ElectingSmallBusinessTrust, on: Date) kind empirical {
    label en official "the trustee purports to revoke the ESBT election";
}
pub relation esbt_election_revoked(t: ElectingSmallBusinessTrust, on: Date) kind institutional {
    label en official "a validly exercised revocation of the ESBT election, with the Secretary's consent";
}
@source(IRC_S1361_E, coverage = partial, quote = "unless revoked with the consent of the Secretary")
rule S1361E3RevocationPower strict {
    label en official "the ESBT election applies to all subsequent years unless revoked with the Secretary's consent (section 1361(e)(3))";
    for p: Person; for t: ElectingSmallBusinessTrust; for on: Date;
    when trustee_of(p, t);
    when revokes_esbt_election(p, t, on);
    then power EsbtRevocationPower {
        holder p;
        over t;
        exercise revokes_esbt_election(p, t, on);
        valid_when secretary_consents_to_esbt_revocation(p, t);
        effect create(esbt_election_revoked(t, on));
        window [@1997-01-01, infinity);
    };
}

// --- (c)(2): permitted trusts and who is treated as the shareholder -------

pub relation wholly_owned_grantor_trust(t: Trust, owner: Person) kind empirical {
    label en official "all of t is treated, under subpart E of part I of subchapter J, as owned by owner (section 1361(c)(2)(A)(i)); the subpart E ownership is asserted";
}
pub relation deemed_owner_died_on(t: Trust, owner: Person, d: Date) kind empirical {
    label en official "t was a trust described in (c)(2)(A)(i) immediately before the death of the deemed owner, who died on d, and continues in existence after the death (section 1361(c)(2)(A)(ii))";
}
pub relation stock_transferred_to_trust_by_will_on(t: Trust, testator: Person, d: Date) kind empirical {
    label en official "stock was transferred to t pursuant to the terms of a will of testator on d (section 1361(c)(2)(A)(iii))";
}
pub relation trust_created_primarily_to_vote_stock(t: Trust) kind empirical {
    label en official "t was created primarily to exercise the voting power of stock transferred to it (section 1361(c)(2)(A)(iv))";
}
pub relation bank_ira_trust_for(t: Trust, beneficiary: Individual) kind empirical {
    label en official "t is an individual retirement account under section 408(a), including a Roth IRA under section 408A, created for beneficiary (section 1361(c)(2)(A)(vi)); the bank-stock and enactment-date limits of (vi) apply to the shares, not to this status";
}
pub relation bank_or_depository_holding_company(c: Corporation) kind empirical {
    label en official "c is a bank as defined in section 581 or a depository institution holding company as defined in section 3(w)(1) of the Federal Deposit Insurance Act; case-asserted";
}
pub relation foreign_trust_flag(t: Trust) kind empirical {
    label en official "t is a foreign trust (section 1361(c)(2)(A), closing sentence)";
}
pub enum TrustShareholderCategory {
    GrantorTrust;
    PostDeathGrantorTrust;
    TestamentaryTrust;
    VotingTrust;
    ElectingSmallBusinessTrustCategory;
    BankIraTrust;
    label en unofficial "the six trusts section 1361(c)(2)(A)(i)-(vi) permits as shareholders";
}
pub relation trust_shareholder_category_on(t: Trust, cat: TrustShareholderCategory, on: Date) kind institutional {
    label en official "t is a trust described in the given clause of section 1361(c)(2)(A) on date on, while it holds stock of some corporation";
}
@source(IRC_S1361_C, coverage = partial, quote = "A trust all of which is treated (under subpart E of part I of subchapter J of this chapter) as owned by an individual who is a citizen or resident of the United States.")
rule TrustCategoryGrantorCitizen strict {
    for t: Trust; for c: Corporation; for on: Date; for owner: Person;
    when shareholder_of(t, c, on);
    when wholly_owned_grantor_trust(t, owner);
    when us.irc.definitions::citizen_of_united_states(owner);
    then trust_shareholder_category_on(t, GrantorTrust, on);
}
rule TrustCategoryGrantorResident strict {
    for t: Trust; for c: Corporation; for on: Date; for owner: Person;
    when shareholder_of(t, c, on);
    when wholly_owned_grantor_trust(t, owner);
    when us.irc.definitions::resident_of_united_states(owner);
    then trust_shareholder_category_on(t, GrantorTrust, on);
}
@source(IRC_S1361_C, coverage = partial, quote = "but only for the 2-year period beginning on the day of the deemed owner's death")
rule TrustCategoryPostDeath strict {
    for t: Trust; for c: Corporation; for on: Date; for owner: Person; for died: Date;
    when shareholder_of(t, c, on);
    when deemed_owner_died_on(t, owner, died);
    when on >= died;
    when on < add_calendar_period(died, 2 calendar_year);
    then trust_shareholder_category_on(t, PostDeathGrantorTrust, on);
}
@source(IRC_S1361_C, coverage = partial, quote = "but only for the 2-year period beginning on the day on which such stock is transferred to it")
rule TrustCategoryTestamentary strict {
    for t: Trust; for c: Corporation; for on: Date; for testator: Person; for moved: Date;
    when shareholder_of(t, c, on);
    when stock_transferred_to_trust_by_will_on(t, testator, moved);
    when on >= moved;
    when on < add_calendar_period(moved, 2 calendar_year);
    then trust_shareholder_category_on(t, TestamentaryTrust, on);
}
@source(IRC_S1361_C, coverage = partial, quote = "A trust created primarily to exercise the voting power of stock transferred to it.")
rule TrustCategoryVoting strict {
    for t: Trust; for c: Corporation; for on: Date;
    when shareholder_of(t, c, on);
    when trust_created_primarily_to_vote_stock(t);
    then trust_shareholder_category_on(t, VotingTrust, on);
}
@source(IRC_S1361_C, coverage = partial, quote = "An electing small business trust.")
rule TrustCategoryEsbt strict {
    label en official "a trust meeting the (e)(1) terms whose trustee has made the (e)(3) election is an ESBT permitted as a shareholder (section 1361(c)(2)(A)(v)); read from the election fact and the terms, not from the power's effect, so the shareholder chain stays free of power effects";
    for t: ElectingSmallBusinessTrust; for c: Corporation; for on: Date; for p: Person; for elected: Date;
    when shareholder_of(t, c, on);
    when trustee_of(p, t);
    when trustee_elects_esbt(p, t, elected);
    when elected <= on;
    when esbt_terms_met(t);
    then trust_shareholder_category_on(t, ElectingSmallBusinessTrustCategory, on);
}
@source(IRC_S1361_C, coverage = partial, quote = "a trust which constitutes an individual retirement account under section 408(a), including one designated as a Roth IRA under section 408A")
rule TrustCategoryBankIra strict {
    for t: Trust; for c: Corporation; for on: Date; for b: Individual;
    when shareholder_of(t, c, on);
    when bank_or_depository_holding_company(c);
    when bank_ira_trust_for(t, b);
    then trust_shareholder_category_on(t, BankIraTrust, on);
}
pub relation permitted_trust_shareholder_1361c2(t: Trust, on: Date) kind institutional {
    label en official "t is a trust described in section 1361(c)(2)(A) (permitted S-corporation shareholder trust) on date on and is not a foreign trust";
}
@source(IRC_S1361_C, coverage = partial, quote = "This subparagraph shall not apply to any foreign trust.")
rule PermittedTrustShareholder strict {
    for t: Trust; for cat: TrustShareholderCategory; for on: Date;
    when trust_shareholder_category_on(t, cat, on);
    when not_known(foreign_trust_flag(t));
    then permitted_trust_shareholder_1361c2(t, on);
}

// (c)(2)(B): who is treated as the shareholder.
pub relation grantor_trust_deemed_owner(t: Trust, owner: Person) kind institutional {
    label en official "the deemed owner of a (c)(2)(A)(i) trust";
}
pub relation treated_as_shareholder_of_trust(p: Person, t: Trust, on: Date) kind institutional {
    label en official "p is treated as the shareholder in place of, or as well as, the trust for section 1361(b)(1) on date on (section 1361(c)(2)(B))";
}
@source(IRC_S1361_C, coverage = partial, quote = "the deemed owner shall be treated as the shareholder")
rule S1361C2BiDeemedOwner strict {
    for t: Trust; for on: Date; for owner: Person;
    when trust_shareholder_category_on(t, GrantorTrust, on);
    when wholly_owned_grantor_trust(t, owner);
    then treated_as_shareholder_of_trust(owner, t, on);
}
@source(IRC_S1361_C, coverage = partial, quote = "the estate of the deemed owner shall be treated as the shareholder")
rule S1361C2BiiEstateOfDeemedOwner strict {
    for t: Trust; for on: Date; for owner: Person; for estate: Estate; for died: Date;
    when trust_shareholder_category_on(t, PostDeathGrantorTrust, on);
    when deemed_owner_died_on(t, owner, died);
    when estate_of(estate, owner);
    then treated_as_shareholder_of_trust(estate, t, on);
}
pub relation estate_of(estate: Estate, decedent: Person) kind empirical {
    label en official "estate is the estate of the decedent";
}
@source(IRC_S1361_C, coverage = partial, quote = "the estate of the testator shall be treated as the shareholder")
rule S1361C2BiiiEstateOfTestator strict {
    for t: Trust; for on: Date; for testator: Person; for estate: Estate; for moved: Date;
    when trust_shareholder_category_on(t, TestamentaryTrust, on);
    when stock_transferred_to_trust_by_will_on(t, testator, moved);
    when estate_of(estate, testator);
    then treated_as_shareholder_of_trust(estate, t, on);
}
pub relation trust_beneficiary(p: Person, t: Trust) kind empirical {
    label en official "p is a beneficiary of t";
}
@source(IRC_S1361_C, coverage = partial, quote = "each beneficiary of the trust shall be treated as a shareholder")
rule S1361C2BivEachBeneficiary strict {
    for t: Trust; for on: Date; for p: Person;
    when trust_shareholder_category_on(t, VotingTrust, on);
    when trust_beneficiary(p, t);
    then treated_as_shareholder_of_trust(p, t, on);
}
@source(IRC_S1361_C, coverage = partial, quote = "each potential current beneficiary of such trust shall be treated as a shareholder")
rule S1361C2BvEachPotentialCurrentBeneficiary strict {
    for t: ElectingSmallBusinessTrust; for c: Corporation; for on: Date; for p: Person; for from: Date; for to: Date;
    when trust_shareholder_category_on(t, ElectingSmallBusinessTrustCategory, on);
    when potential_current_beneficiary_of(p, t, c, from, to);
    when on >= from;
    when on <= to;
    then treated_as_shareholder_of_trust(p, t, on);
}
pub relation esbt_has_no_potential_current_beneficiary_during(t: ElectingSmallBusinessTrust, from: Date, to: Date) kind empirical {
    label en official "for the period there is no potential current beneficiary of t (section 1361(c)(2)(B)(v))";
}
@source(IRC_S1361_C, coverage = partial, quote = "if for any period there is no potential current beneficiary of such trust, such trust shall be treated as the shareholder during such period")
rule S1361C2BvNoPcbTrustIsShareholder strict {
    for t: ElectingSmallBusinessTrust; for on: Date; for from: Date; for to: Date;
    when trust_shareholder_category_on(t, ElectingSmallBusinessTrustCategory, on);
    when esbt_has_no_potential_current_beneficiary_during(t, from, to);
    when on >= from;
    when on <= to;
    then treated_as_shareholder_of_trust(t, t, on);
}
pub relation bank_ira_individual(t: Trust, individual: Individual) kind institutional {
    label en official "the individual for whose benefit the bank-IRA trust was created";
}
@source(IRC_S1361_C, coverage = partial, quote = "the individual for whose benefit the trust was created shall be treated as the shareholder")
rule S1361C2BviBeneficiaryIndividual strict {
    for t: Trust; for on: Date; for b: Individual;
    when trust_shareholder_category_on(t, BankIraTrust, on);
    when bank_ira_trust_for(t, b);
    then treated_as_shareholder_of_trust(b, t, on);
}
// (c)(3): the estate of an individual in a title 11 case is an estate.
pub relation estate_in_title_11_case(estate: Estate, individual: Individual) kind empirical {
    label en official "estate is the estate of an individual in a case under title 11 of the United States Code (section 1361(c)(3))";
}
pub relation estate_for_1361b1B(estate: Estate) kind institutional {
    label en official "estate is an estate within the meaning of section 1361(b)(1)(B), including the estate of an individual in a title 11 case (section 1361(c)(3))";
}
@source(IRC_S1361_C, coverage = partial, quote = "the term \"estate\" includes the estate of an individual in a case under title 11 of the United States Code")
rule S1361C3BankruptcyEstate strict {
    for e: Estate; for i: Individual;
    when estate_in_title_11_case(e, i);
    then estate_for_1361b1B(e);
}

// --- (f), section 1368(f): restricted bank director stock ----------------

pub relation stock_required_to_be_held_by_director(sh: Person, c: Corporation, on: Date) kind empirical {
    label en official "the stock is required to be held by an individual under applicable Federal or State law in order to permit that individual to serve as a director (section 1361(f)(2)(A))";
}
pub relation stock_subject_to_sell_back_at_acquisition_price(sh: Person, c: Corporation, on: Date) kind empirical {
    label en official "the stock is subject to an agreement with the bank or company (or a corporation controlling it within section 368(c)) under which the holder must sell it back at the price the individual paid on ceasing to be a director (section 1361(f)(2)(B))";
}
pub relation restricted_bank_director_stock_of(sh: Person, c: Corporation, on: Date) kind institutional {
    label en official "sh holds restricted bank director stock in c on date on: stock in a bank or depository institution holding company that meets (f)(2)(A) and (B)";
}
@source(IRC_S1361_F, coverage = partial, quote = "the term \"restricted bank director stock\" means stock in a bank (as defined in section 581) or a depository institution holding company")
rule S1361F2RestrictedBankDirectorStock strict {
    for sh: Person; for c: Corporation; for on: Date;
    when bank_or_depository_holding_company(c);
    when stock_required_to_be_held_by_director(sh, c, on);
    when stock_subject_to_sell_back_at_acquisition_price(sh, c, on);
    then restricted_bank_director_stock_of(sh, c, on);
}
pub relation restricted_bank_director_shares(sh: Person, c: Corporation, on: Date, n: Decimal) kind empirical {
    label en official "the number of shares of restricted bank director stock of c that sh holds on date on";
}
pub relation outstanding_shares_for_subchapter_s(c: Corporation, on: Date, n: Decimal) kind institutional {
    label en official "the shares of c outstanding for Subchapter S: restricted bank director stock is not taken into account as outstanding stock (section 1361(f)(1)); it is still outstanding for section 1368(f)";
}
pub relation restricted_bank_director_stock_present(c: Corporation, on: Date, total: Decimal) kind institutional {
    label en official "restricted bank director stock is outstanding in c on date on; total is the shares outstanding (helper, so that the default below can be defeated)";
}
rule RestrictedStockPresent strict {
    for c: Corporation; for on: Date; for total: Decimal; for sh: Person; for n: Decimal;
    when shares_outstanding(c, on, total);
    when restricted_bank_director_shares(sh, c, on, n);
    then restricted_bank_director_stock_present(c, on, total);
}
@source(IRC_S1361_F, coverage = partial, quote = "Restricted bank director stock shall not be taken into account as outstanding stock of the S corporation in applying this subchapter")
rule S1361F1ExcludeFromOutstanding defeasible {
    for c: Corporation; for on: Date; for total: Decimal;
    when shares_outstanding(c, on, total);
    when restricted_bank_director_stock_present(c, on, total);
    then outstanding_shares_for_subchapter_s(c, on, total - sum all n: Decimal for sh: Person where restricted_bank_director_shares(sh, c, on, n));
}
rule S1361F1NoRestrictedStock defeasible {
    for c: Corporation; for on: Date; for total: Decimal;
    when shares_outstanding(c, on, total);
    unless restricted_bank_director_stock_present(c, on, total);
    then outstanding_shares_for_subchapter_s(c, on, total);
}
pub relation distribution_to_director_on_restricted_stock(sh: Person, c: Corporation, on: Date, amount: Money) kind empirical {
    label en official "a director receives a distribution from the S corporation with respect to restricted bank director stock, not in part or full payment in exchange for stock (section 1368(f))";
}
pub relation director_distribution_includible_in_gross_income(sh: Person, c: Corporation, on: Date, amount: Money) kind institutional {
    label en official "the distribution is includible in the gross income of the director (section 1368(f)(1))";
}
@source(IRC_S1368_F, coverage = partial, quote = "shall be includible in gross income of the director")
rule S1368F1IncludibleByDirector strict {
    for sh: Person; for c: Corporation; for on: Date; for amount: Money;
    when distribution_to_director_on_restricted_stock(sh, c, on, amount);
    when restricted_bank_director_stock_of(sh, c, on);
    then director_distribution_includible_in_gross_income(sh, c, on, amount);
}
pub relation director_inclusion_year_ends_on(sh: Person, on: Date, d: Date) kind empirical {
    label en official "the taxable year of the director in which the distribution is included in gross income ends on d";
}
pub relation corporation_deduction_for_director_distribution(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount is deductible by the corporation for the taxable year in which or with which ends the director's taxable year of inclusion (section 1368(f)(2))";
}
@source(IRC_S1368_F, coverage = partial, quote = "shall be deductible by the corporation for the taxable year of such corporation in which or with which ends the taxable year in which such amount is included in the gross income of the director")
rule S1368F2DeductibleByCorporation strict {
    for sh: Person; for c: Corporation; for on: Date; for amount: Money; for d: Date; for y: TaxableYear; for b: Date; for en: Date;
    when director_distribution_includible_in_gross_income(sh, c, on, amount);
    when director_inclusion_year_ends_on(sh, on, d);
    when us.irc.core::year_of(c, y);
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, en);
    when d >= b;
    when d <= en;
    then corporation_deduction_for_director_distribution(c, y, amount);
}

// --- (b)(3)(C)-(D): terminations of QSSS status ----------------------------

pub relation qsss_status_ceases_on(parent: Corporation, sub: Corporation, d: Date) kind empirical {
    label en official "the subsidiary ceases on d to meet the requirements of section 1361(b)(3)(B)";
}
pub relation deemed_new_corporation_acquiring_assets(sub: Corporation, d: Date) kind institutional {
    label en official "the former QSSS is treated as a new corporation acquiring all of its assets, and assuming all of its liabilities, immediately before the cessation from the S corporation in exchange for its stock (section 1361(b)(3)(C)(i))";
}
@source(IRC_S1361_B, coverage = partial, quote = "such corporation shall be treated as a new corporation acquiring all of its assets (and assuming all of its liabilities) immediately before such cessation from the S corporation in exchange for its stock")
rule S1361B3CiDeemedNewCorporation strict {
    for parent: Corporation; for sub: Corporation; for d: Date;
    when qsss_status_ceases_on(parent, sub, d);
    then deemed_new_corporation_acquiring_assets(sub, d);
}
pub relation qsss_stock_sold_percentage(parent: Corporation, sub: Corporation, d: Date, pct: Decimal) kind empirical {
    label en official "the S corporation sold pct (a fraction of 1) of the stock of the QSSS on d, and the failure of (B) is by reason of that sale";
}
pub relation deemed_sale_of_undivided_asset_interest(sub: Corporation, d: Date, fraction: Decimal) kind institutional {
    label en official "the sale of stock is treated as a sale of an undivided interest in the assets of the corporation, based on the percentage of stock sold (section 1361(b)(3)(C)(ii)(I))";
}
@source(IRC_S1361_B, coverage = partial, quote = "the sale were a sale of an undivided interest in the assets of such corporation (based on the percentage of the corporation's stock sold)")
rule S1361B3CiiIUndividedInterest strict {
    for parent: Corporation; for sub: Corporation; for d: Date; for pct: Decimal;
    when qsss_status_ceases_on(parent, sub, d);
    when qsss_stock_sold_percentage(parent, sub, d, pct);
    then deemed_sale_of_undivided_asset_interest(sub, d, pct);
}
pub relation deemed_section_351_acquisition_by_sub(sub: Corporation, d: Date) kind institutional {
    label en official "the sale is followed by an acquisition by the corporation of all of its assets, and the assumption of all of its liabilities, in a transaction to which section 351 applies (section 1361(b)(3)(C)(ii)(II))";
}
@source(IRC_S1361_B, coverage = partial, quote = "the sale were followed by an acquisition by such corporation of all of its assets (and the assumption by such corporation of all of its liabilities) in a transaction to which section 351 applies")
rule S1361B3CiiIIFollowedBy351 strict {
    for parent: Corporation; for sub: Corporation; for d: Date; for pct: Decimal;
    when qsss_status_ceases_on(parent, sub, d);
    when qsss_stock_sold_percentage(parent, sub, d, pct);
    then deemed_section_351_acquisition_by_sub(sub, d);
}
pub relation secretary_consents_to_qsss_reelection(sub: Corporation, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to an election before the 5th taxable year";
}
pub relation eligible_for_qsss_or_s_election_after_qsss_termination(sub: Corporation, y: TaxableYear) kind institutional {
    label en official "after QSSS status terminates, the corporation (and any successor) may make an election under (B)(ii) or section 1362(a) only in its 5th taxable year beginning after the first year of effective termination, or earlier with the Secretary's consent (section 1361(b)(3)(D))";
}
pub relation qsss_termination_effective_year(sub: Corporation, ty: TaxableYear) kind empirical {
    label en official "ty is the 1st taxable year for which the termination of QSSS status was effective";
}
@source(IRC_S1361_B, coverage = partial, quote = "before its 5th taxable year which begins after the 1st taxable year for which such termination was effective, unless the Secretary consents to such election")
rule S1361B3DFiveYearBar strict {
    for sub: Corporation; for ty: TaxableYear; for y: TaxableYear;
    when qsss_termination_effective_year(sub, ty);
    when at_least_five_taxable_years_after(ty, y);
    then eligible_for_qsss_or_s_election_after_qsss_termination(sub, y);
}
rule S1361B3DSecretaryConsent strict {
    for sub: Corporation; for y: TaxableYear;
    when secretary_consents_to_qsss_reelection(sub, y);
    then eligible_for_qsss_or_s_election_after_qsss_termination(sub, y);
}

// --- (g): the bank's section 481 adjustment election --------------------

pub relation bank_changes_from_reserve_method_at_first_s_year(bank: Corporation) kind empirical {
    label en official "the bank changes from the reserve method of accounting for bad debts of section 585 or 593 for its first taxable year for which an election under section 1362(a) is in effect (section 1361(g))";
}
pub relation elects_481_adjustment_in_preceding_year(bank: Corporation, on: Date) kind empirical {
    label en official "the bank elects to take the section 481 adjustments into account for the taxable year immediately preceding its first S year";
}
pub relation section_481_adjustments_taken_in_preceding_year(bank: Corporation, on: Date) kind institutional {
    label en official "the section 481 adjustments by reason of the change are taken into account for the taxable year immediately preceding the first S year (section 1361(g))";
}
pub relation bank_reserve_method_change_condition(bank: Corporation) kind institutional {
    label en official "the bank changes from the reserve method at the start of its first S year";
}
rule BankReserveMethodChangeCondition strict {
    for bank: Corporation;
    when bank_changes_from_reserve_method_at_first_s_year(bank);
    then bank_reserve_method_change_condition(bank);
}
@source(IRC_S1361_G, coverage = partial, quote = "the bank may elect to take into account any adjustments under section 481 by reason of such change for the taxable year immediately preceding such first taxable year")
rule S1361GElectionPower strict {
    label en official "a bank that changes from the reserve method on becoming an S corporation may elect to take the section 481 adjustments in the preceding year (section 1361(g))";
    for bank: Corporation; for on: Date;
    when elects_481_adjustment_in_preceding_year(bank, on);
    then power S1361GBankElectionPower {
        holder bank;
        over bank;
        exercise elects_481_adjustment_in_preceding_year(bank, on);
        valid_when bank_reserve_method_change_condition(bank);
        effect create(section_481_adjustments_taken_in_preceding_year(bank, on));
        window [@1996-01-01, infinity);
    };
}

// --- (c)(1)(B)-(C): members of a family ------------------------------------

pub relation child_of(child: Individual, parent: Individual) kind empirical {
    label en official "child is a child of parent by blood";
}
pub relation legally_adopted_child_of(child: Individual, parent: Individual) kind empirical {
    label en official "child is a legally adopted child of parent";
}
pub relation placed_for_adoption_with(child: Individual, parent: Individual) kind empirical {
    label en official "child is lawfully placed with parent for legal adoption by parent";
}
pub relation eligible_foster_child_of(child: Individual, parent: Individual) kind empirical {
    label en official "child is an eligible foster child of parent within the meaning of section 152(f)(1)(C)";
}
pub relation treated_as_child_by_blood(child: Individual, parent: Individual) kind institutional {
    label en official "child is treated as a child of parent by blood (section 1361(c)(1)(C))";
}
rule ChildByBlood strict {
    for c: Individual; for p: Individual;
    when child_of(c, p);
    then treated_as_child_by_blood(c, p);
}
@source(IRC_S1361_C, coverage = partial, quote = "Any legally adopted child of an individual")
rule ChildAdopted strict {
    for c: Individual; for p: Individual;
    when legally_adopted_child_of(c, p);
    then treated_as_child_by_blood(c, p);
}
@source(IRC_S1361_C, coverage = partial, quote = "any child who is lawfully placed with an individual for legal adoption by the individual")
rule ChildPlaced strict {
    for c: Individual; for p: Individual;
    when placed_for_adoption_with(c, p);
    then treated_as_child_by_blood(c, p);
}
@source(IRC_S1361_C, coverage = partial, quote = "any eligible foster child of an individual (within the meaning of section 152(f)(1)(C))")
rule ChildFoster strict {
    for c: Individual; for p: Individual;
    when eligible_foster_child_of(c, p);
    then treated_as_child_by_blood(c, p);
}
pub relation lineal_descendant_of(d: Individual, ancestor: Individual) kind empirical {
    label en official "d is a lineal descendant of ancestor, counting the section 1361(c)(1)(C) children as children by blood; asserted as a closed relation (the generations are not derived by recursion, TECH-GAPS G46)";
}
pub relation spouse_or_former_spouse_of(p: Individual, q: Individual) kind empirical {
    label en official "p is or was married to q";
}
pub relation generations_removed_from_youngest_shareholder(a: Individual, c: Corporation, n: Integer) kind empirical {
    label en official "on the applicable date, the number of generations by which a is removed from the youngest generation of shareholders who would, but for (B)(ii), be members of the family; a spouse or former spouse counts as the generation of the individual he or she is or was married to";
}
pub relation common_ancestor_of_family(a: Individual, c: Corporation) kind institutional {
    label en official "a may be a common ancestor: not more than 6 generations removed from the youngest generation on the applicable date (section 1361(c)(1)(B)(ii))";
}
@source(IRC_S1361_C, coverage = partial, quote = "An individual shall not be considered to be a common ancestor if, on the applicable date, the individual is more than 6 generations removed from the youngest generation of shareholders")
rule S1361C1BiiCommonAncestor strict {
    for a: Individual; for c: Corporation; for n: Integer;
    when generations_removed_from_youngest_shareholder(a, c, n);
    when n <= 6;
    then common_ancestor_of_family(a, c);
}
pub relation member_of_family(p: Individual, ancestor: Individual, c: Corporation) kind institutional {
    label en official "p is a member of the family of the common ancestor: the ancestor, a lineal descendant, or a spouse or former spouse of either (section 1361(c)(1)(B)(i))";
}
@source(IRC_S1361_C, coverage = partial, quote = "means a common ancestor, any lineal descendant of such common ancestor, and any spouse or former spouse of such common ancestor or any such lineal descendant")
rule S1361C1BiFamilyAncestor strict {
    for a: Individual; for c: Corporation;
    when common_ancestor_of_family(a, c);
    then member_of_family(a, a, c);
}
rule S1361C1BiFamilyDescendant strict {
    for a: Individual; for c: Corporation; for d: Individual;
    when common_ancestor_of_family(a, c);
    when lineal_descendant_of(d, a);
    then member_of_family(d, a, c);
}
rule S1361C1BiFamilySpouseOfAncestor strict {
    for a: Individual; for c: Corporation; for s: Individual;
    when common_ancestor_of_family(a, c);
    when spouse_or_former_spouse_of(s, a);
    then member_of_family(s, a, c);
}
rule S1361C1BiFamilySpouseOfDescendant strict {
    for a: Individual; for c: Corporation; for d: Individual; for s: Individual;
    when common_ancestor_of_family(a, c);
    when lineal_descendant_of(d, a);
    when spouse_or_former_spouse_of(s, d);
    then member_of_family(s, a, c);
}
// (iii): applicable date is the latest of three dates.
pub relation election_made_on_date(c: Corporation, d: Date) kind empirical {
    label en official "the election under section 1362(a) is made on d (section 1361(c)(1)(B)(iii)(I))";
}
pub relation earliest_date_family_member_holds_stock(c: Corporation, d: Date) kind empirical {
    label en official "the earliest date that an individual described in (B)(i) holds stock in the S corporation (section 1361(c)(1)(B)(iii)(II))";
}
pub relation family_applicable_date(c: Corporation, d: Date) kind institutional {
    label en official "the applicable date: the latest of the election date, the earliest date a family member holds stock, and October 22, 2004 (section 1361(c)(1)(B)(iii))";
}
rule ApplicableDateElection strict {
    for c: Corporation; for e: Date; for h: Date;
    when election_made_on_date(c, e);
    when earliest_date_family_member_holds_stock(c, h);
    when e >= h;
    when e >= @2004-10-22;
    then family_applicable_date(c, e);
}
rule ApplicableDateHolding strict {
    for c: Corporation; for e: Date; for h: Date;
    when election_made_on_date(c, e);
    when earliest_date_family_member_holds_stock(c, h);
    when h >= e;
    when h >= @2004-10-22;
    then family_applicable_date(c, h);
}
rule ApplicableDateFloor strict {
    for c: Corporation; for e: Date; for h: Date;
    when election_made_on_date(c, e);
    when earliest_date_family_member_holds_stock(c, h);
    when @2004-10-22 >= e;
    when @2004-10-22 >= h;
    then family_applicable_date(c, @2004-10-22);
}

// --- (d)(2)(B)(ii): successive income beneficiaries --------------------------

pub relation successor_income_beneficiary(next_beneficiary: Person, previous: Person, t: QualifiedSubchapterSTrust) kind empirical {
    label en official "next_beneficiary succeeds previous as the current income beneficiary of t";
}
pub relation refuses_qsst_election(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation) kind empirical {
    label en official "the successive beneficiary affirmatively refuses to consent to the QSST election (section 1361(d)(2)(B)(ii))";
}
pub relation qsst_election_treated_as_made_by_successor(beneficiary: Person, t: QualifiedSubchapterSTrust, c: Corporation) kind institutional {
    label en official "an election is treated as made by each successive beneficiary unless the beneficiary affirmatively refuses to consent (section 1361(d)(2)(B)(ii))";
}
@source(IRC_S1361_D, coverage = partial, quote = "an election under this paragraph shall be treated as made by each successive beneficiary unless such beneficiary affirmatively refuses to consent to such election")
rule S1361D2BiiSuccessorElection defeasible {
    for prev: Person; for next: Person; for t: QualifiedSubchapterSTrust; for c: Corporation;
    when qsst_election_in_effect(prev, t, c);
    when successor_income_beneficiary(next, prev, t);
    unless refuses_qsst_election(next, t, c);
    then qsst_election_treated_as_made_by_successor(next, t, c);
}

// (d)(3), closing sentence: a substantially separate and independent share of
// a trust within the meaning of section 663(c) is a separate trust.
pub relation substantially_separate_and_independent_share(share: Trust, t: Trust) kind empirical {
    label en official "share is a substantially separate and independent share of t within the meaning of section 663(c)";
}
pub relation treated_as_separate_trust_for_qsst_rules(share: Trust) kind institutional {
    label en official "for purposes of subsection (d) and subsection (c) a substantially separate and independent share of a trust is treated as a separate trust (section 1361(d)(3), closing sentence)";
}
@source(IRC_S1361_D, coverage = partial, quote = "A substantially separate and independent share of a trust within the meaning of section 663(c) shall be treated as a separate trust for purposes of this subsection and subsection (c).")
rule S1361D3SeparateShare strict {
    for share: Trust; for t: Trust;
    when substantially_separate_and_independent_share(share, t);
    then treated_as_separate_trust_for_qsst_rules(share);
}
