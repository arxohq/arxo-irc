// Stage 3 (26.09.2026) — the S termination year of section 1362(e) and the
// post-termination transition period of section 1377(b), with the cash
// distribution rules of section 1371(e)-(f) that read it.
//
// SCOPE: 1362(e)(1) S short year / C short year; (e)(2) pro rata daily
// assignment of items; (e)(3) closing-of-books election as a power with the
// two-sided shareholder consent; (e)(4) the S termination year; (e)(5) tax
// for the C short year on an annualized basis; (e)(6)(A)-(D) special rules.
// 1377(b)(1)-(3) the three post-termination transition periods; 1371(e)(1)-(2)
// cash distributions during it; 1371(f) distributions after it.
//
// The date a termination takes effect is read from what 03-election.law
// already concludes for a revocation (`revocation_effective_date`), plus an
// asserted date of cessation for the automatic termination of (d)(2). A
// termination effective on the FIRST day of a year is not a termination of
// that year for (e)(4) ("other than on the 1st day thereof"): the year is then
// a whole S year or a whole C year and none of the rules below applies.
//
// Day counts use `days_between` (spec 84.4); a year of `n` days runs
// from `begins` to `ends` inclusive, so n = days_between(begin, end) + 1.
// The corpus convention for a Money result the statute gives no rounding
// for is cents HALF_UP (AGENT-BRIEF, JUDGMENT CALL).

// --- (e)(4): S termination year -------------------------------------------

use self::{
    Corporation,
    IRC_S1362_E,
    IRC_S1371_E,
    IRC_S1371_F,
    IRC_S1377_B,
    Person,
    SCorpElection,
    TaxableYear,
    aaa_balance,
    corporation_separately_stated_items_net,
    distribution_amount,
    nonseparately_computed_income_or_loss,
    revocation_effective_date,
    separately_stated_items_itemized,
    shareholder_of,
    shareholder_of_any,
};

pub relation small_business_cessation_date(c: Corporation, e: SCorpElection, d: Date) kind empirical {
    label en official "d is the first day on which the corporation ceases to be a small business corporation, so the election terminates on and after d (section 1362(d)(2)(B)); case-asserted (a day-by-day scan of the year is not re-derived, TECH-GAPS G46)";
}
pub relation s_termination_effective_date(c: Corporation, e: SCorpElection, d: Date) kind institutional {
    label en official "d is the first day for which the termination of the section 1362(a) election is effective (section 1362(d)(1)(C)-(D) revocation date, or the date of cessation under (d)(2))";
}
rule S1362TerminationDateFromRevocation defeasible {
    for c: Corporation; for e: SCorpElection; for on: Date; for d: Date;
    when revocation_effective_date(c, e, on, d);
    then s_termination_effective_date(c, e, d);
}
rule S1362TerminationDateFromCessation defeasible {
    for c: Corporation; for e: SCorpElection; for d: Date;
    when small_business_cessation_date(c, e, d);
    then s_termination_effective_date(c, e, d);
}

pub relation s_termination_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "y is a taxable year of c, determined without regard to subsection (e), in which a termination of the section 1362(a) election takes effect other than on its first day (section 1362(e)(4))";
}
@source(IRC_S1362_E, coverage = partial, quote = "any taxable year of a corporation (determined without regard to this subsection) in which a termination of an election made under subsection (a) takes effect (other than on the 1st day thereof)")
rule S1362E4STerminationYear defeasible {
    label en official "a year in which a termination takes effect after its first day is an S termination year (section 1362(e)(4))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for d: Date; for b: Date; for en: Date;
    when s_termination_effective_date(c, e, d);
    when us.irc.core::year_of(c, y);
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, en);
    when d > b;
    when d <= en;
    then s_termination_year(c, e, y);
}

// --- (e)(1): the two short years -----------------------------------------

pub enum SShortYearKind {
    SShortYear;
    CShortYear;
    label en unofficial "which of the two short taxable years of an S termination year";
}
pub relation termination_short_year(c: Corporation, e: SCorpElection, y: TaxableYear, kind: SShortYearKind, from: Date, to: Date) kind institutional {
    label en official "the short taxable year of an S termination year y, with its first and last day: the S short year ends before the first day for which the termination is effective, the C short year begins on that day (section 1362(e)(1)(A)-(B))";
}
@source(IRC_S1362_E, coverage = partial, quote = "The portion of such year ending before the 1st day for which the termination is effective shall be treated as a short taxable year for which the corporation is an S corporation.")
rule S1362E1ASShortYear defeasible {
    label en official "the portion of the termination year before the first day of effect is a short year for which the corporation is an S corporation (section 1362(e)(1)(A))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for d: Date; for b: Date;
    for calendar_before_1: Date;
    when s_termination_year(c, e, y);
    when s_termination_effective_date(c, e, d);
    when us.irc.core::begins(y, b)
        and us.irc.core::civil_calendar_boundary_before(d, 1, us.irc.core::CalendarDay, calendar_before_1);
    then termination_short_year(c, e, y, SShortYear, b, calendar_before_1);
}
@source(IRC_S1362_E, coverage = partial, quote = "The portion of such year beginning on such 1st day shall be treated as a short taxable year for which the corporation is a C corporation.")
rule S1362E1BCShortYear defeasible {
    label en official "the portion of the termination year beginning on the first day of effect is a short year for which the corporation is a C corporation (section 1362(e)(1)(B))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for d: Date; for en: Date;
    when s_termination_year(c, e, y);
    when s_termination_effective_date(c, e, d);
    when us.irc.core::ends(y, en);
    then termination_short_year(c, e, y, CShortYear, d, en);
}
pub relation s_short_year_is_s_corporation_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "for the S short year of y the corporation is an S corporation (section 1362(e)(1)(A))";
}
rule S1362E1ASShortYearStatus defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for from: Date; for to: Date;
    when termination_short_year(c, e, y, SShortYear, from, to);
    then s_short_year_is_s_corporation_year(c, e, y);
}
pub relation c_short_year_is_c_corporation_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "for the C short year of y the corporation is a C corporation (section 1362(e)(1)(B))";
}
rule S1362E1BCShortYearStatus defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for from: Date; for to: Date;
    when termination_short_year(c, e, y, CShortYear, from, to);
    then c_short_year_is_c_corporation_year(c, e, y);
}

// Day counts of the termination year and of each short year.
pub relation termination_year_days(c: Corporation, e: SCorpElection, y: TaxableYear, days: Integer) kind institutional {
    label en official "the number of days in the S termination year (both endpoints counted)";
}
rule TerminationYearDays defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for b: Date; for en: Date;
    when s_termination_year(c, e, y);
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, en);
    then termination_year_days(c, e, y, days_between(b, en) + 1);
}
pub relation termination_short_year_days(c: Corporation, e: SCorpElection, y: TaxableYear, kind: SShortYearKind, days: Integer) kind institutional {
    label en official "the number of days in a short year of the S termination year (both endpoints counted)";
}
rule TerminationShortYearDays defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for k: SShortYearKind; for from: Date; for to: Date;
    when termination_short_year(c, e, y, k, from, to);
    then termination_short_year_days(c, e, y, k, days_between(from, to) + 1);
}

// --- (e)(3): election out of the pro rata allocation ----------------------

pub relation shareholder_during_s_short_year(sh: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en official "sh is a shareholder of c at any time during the S short year of y (section 1362(e)(3)(B)); case-asserted (a roster over a period is not derived from dated holdings)";
}
pub relation shareholder_consents_to_closing_of_books(sh: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en official "sh consents to the section 1362(e)(3) election for y";
}
pub relation closing_of_books_consent_complete(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "every person who is a shareholder at any time during the S short year and every person who is a shareholder on the first day of the C short year consents to the election (section 1362(e)(3)(B))";
}
@source(IRC_S1362_E, coverage = partial, quote = "all persons who are shareholders in the corporation at any time during the S short year and all persons who are shareholders in the corporation on the first day of the C short year consent to such election")
rule S1362E3BConsentComplete defeasible {
    label en official "the election is valid only if all S-short-year shareholders and all first-day-of-C-short-year shareholders consent (section 1362(e)(3)(B))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for cFrom: Date; for cTo: Date;
    when termination_short_year(c, e, y, CShortYear, cFrom, cTo);
    when shareholder_of_any(c, cFrom);
    when count(collect sh: Person where shareholder_during_s_short_year(sh, c, y)) ==
         count(collect sh: Person where shareholder_during_s_short_year(sh, c, y) and shareholder_consents_to_closing_of_books(sh, c, y));
    when count(collect u: Person where shareholder_of(u, c, cFrom)) ==
         count(collect u: Person where shareholder_of(u, c, cFrom) and shareholder_consents_to_closing_of_books(u, c, y));
    then closing_of_books_consent_complete(c, e, y);
}
pub relation elects_closing_of_books(c: Corporation, e: SCorpElection, y: TaxableYear, on: Date) kind empirical {
    label en official "the corporation elects that the pro rata allocation of section 1362(e)(2) not apply to y (section 1362(e)(3)(A))";
}
pub relation closing_of_books_election_in_effect(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "a validly exercised section 1362(e)(3) election: items are assigned to each short year under normal tax accounting rules";
}
@source(IRC_S1362_E, coverage = partial, quote = "A corporation may elect to have paragraph (2) not apply.")
rule S1362E3ClosingOfBooksElectionPower defeasible {
    label en official "an S termination year corporation may elect that the pro rata allocation not apply, valid only with the section 1362(e)(3)(B) consents (section 1362(e)(3))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for on: Date;
    when s_termination_year(c, e, y);
    when elects_closing_of_books(c, e, y, on);
    then power S1362ClosingOfBooksPower {
        holder c;
        over e;
        exercise elects_closing_of_books(c, e, y, on);
        valid_when closing_of_books_consent_complete(c, e, y);
        effect create(closing_of_books_election_in_effect(c, e, y));
        window [@1982-01-01, infinity);
    };
}

// --- (e)(6)(C)-(D): the two disapplications of pro rata allocation -------

pub relation stock_sold_or_exchanged_fraction_in_year(c: Corporation, y: TaxableYear, fraction: Decimal) kind empirical {
    label en official "the fraction of the corporation's stock sold or exchanged during y (section 1362(e)(6)(D)); case-asserted (a count of dispositions of shares over the year is not derived)";
}
pub relation fifty_percent_stock_change_in_year(c: Corporation, y: TaxableYear) kind institutional {
    label en official "a sale or exchange of 50 percent or more of the stock of the corporation occurred during y (section 1362(e)(6)(D))";
}
@source(IRC_S1362_E, coverage = partial, quote = "Paragraph (2) shall not apply to an S termination year if there is a sale or exchange of 50 percent or more of the stock in such corporation during such year.")
rule S1362E6DFiftyPercentChange defeasible {
    label en official "a sale or exchange of 50 percent or more of the stock during the year (section 1362(e)(6)(D))";
    for c: Corporation; for y: TaxableYear; for f: Decimal;
    when stock_sold_or_exchanged_fraction_in_year(c, y, f);
    when f >= 0.50;
    then fifty_percent_stock_change_in_year(c, y);
}
pub relation pro_rata_allocation_disapplied(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the pro rata allocation of paragraph (2) does not apply to y: a closing-of-books election is in effect, or 50 percent or more of the stock changed hands (section 1362(e)(3), (e)(6)(D))";
}
rule ProRataDisapplied3 defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear;
    when closing_of_books_election_in_effect(c, e, y);
    then pro_rata_allocation_disapplied(c, e, y);
}
rule ProRataDisapplied6D defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear;
    when s_termination_year(c, e, y);
    when fifty_percent_stock_change_in_year(c, y);
    then pro_rata_allocation_disapplied(c, e, y);
}
pub relation pro_rata_allocation_applies(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the pro rata daily assignment of section 1362(e)(2) applies to the S termination year y";
}
@source(IRC_S1362_E, coverage = partial, quote = "the determination of which items are to be taken into account for each of the short taxable years referred to in paragraph (1) shall be made")
rule S1362E2ProRataApplies defeasible {
    label en official "in an S termination year the items are assigned pro rata by day unless paragraph (3) or (6)(C)-(D) displaces it (section 1362(e)(2))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear;
    when s_termination_year(c, e, y);
    unless pro_rata_allocation_disapplied(c, e, y);
    then pro_rata_allocation_applies(c, e, y);
}

// (e)(6)(C): items resulting from section 338 are outside the pro rata
// assignment. The base of the assignment is the year's nonseparately
// computed income less the asserted section 338 item amount.
pub relation section_338_item_amount(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of nonseparately computed income or loss resulting from the application of section 338 in y (section 1362(e)(6)(C)); case-asserted";
}
pub relation section_338_carve_out_active(c: Corporation, y: TaxableYear, base: Money) kind institutional {
    label en official "a section 338 item amount is asserted for y (section 1362(e)(6)(C)); helper so the default base can be defeated by it";
}
rule Section338CarveOutActive defeasible {
    for c: Corporation; for y: TaxableYear; for n: Money; for a: Money;
    when nonseparately_computed_income_or_loss(c, y, n);
    when section_338_item_amount(c, y, a);
    then section_338_carve_out_active(c, y, n);
}
pub relation pro_rata_base_nonseparate(c: Corporation, y: TaxableYear, base: Money) kind institutional {
    label en official "the nonseparately computed income or loss of y that the pro rata assignment distributes, without items resulting from section 338 (section 1362(e)(2)(A)(ii), (e)(6)(C))";
}
@source(IRC_S1362_E, coverage = partial, quote = "Paragraph (2) shall not apply with respect to any item resulting from the application of section 338.")
rule ProRataBaseWithout338 defeasible {
    for c: Corporation; for y: TaxableYear; for n: Money; for a: Money;
    when nonseparately_computed_income_or_loss(c, y, n);
    when section_338_item_amount(c, y, a);
    then pro_rata_base_nonseparate(c, y, n - a);
}
rule ProRataBaseDefault defeasible {
    for c: Corporation; for y: TaxableYear; for n: Money;
    when nonseparately_computed_income_or_loss(c, y, n);
    unless section_338_carve_out_active(c, y, n);
    then pro_rata_base_nonseparate(c, y, n);
}

// --- (e)(2): the assignment itself ----------------------------------------

pub relation short_year_nonseparate_item(c: Corporation, e: SCorpElection, y: TaxableYear, kind: SShortYearKind, amount: Money) kind institutional {
    label en official "the nonseparately computed income or loss assigned to a short year of the S termination year: an equal portion of the year's amount to each day, summed over the days of the short year (section 1362(e)(2)(B))";
}
@source(IRC_S1362_E, coverage = partial, quote = "an equal portion of each amount determined under subparagraph (A) to each day of the S termination year")
rule S1362E2BAssignNonseparate defeasible {
    label en official "equal daily portion of the base, times the days of the short year; one rounding, on the whole share (JUDGMENT CALL: cents HALF_UP, the statute names none)";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for k: SShortYearKind; for base: Money; for yd: Integer; for sd: Integer;
    when pro_rata_allocation_applies(c, e, y);
    when pro_rata_base_nonseparate(c, y, base);
    when termination_year_days(c, e, y, yd);
    when termination_short_year_days(c, e, y, k, sd);
    then short_year_nonseparate_item(c, e, y, k, div_round(base * sd, yd * 1.0, 2, "HALF_UP"));
}
pub relation short_year_separately_stated_items(c: Corporation, e: SCorpElection, y: TaxableYear, kind: SShortYearKind, amount: Money) kind institutional {
    label en official "the net of the section 1366(a)(1)(A) separately stated items assigned to a short year of the S termination year, by the same equal daily portions (section 1362(e)(2)(A)(i), (B))";
}
rule S1362E2BAssignSeparatelyStated defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for k: SShortYearKind; for net: Money; for yd: Integer; for sd: Integer;
    when pro_rata_allocation_applies(c, e, y);
    when corporation_separately_stated_items_net(c, y, net);
    when not_known(separately_stated_items_itemized(c, y));
    when termination_year_days(c, e, y, yd);
    when termination_short_year_days(c, e, y, k, sd);
    then short_year_separately_stated_items(c, e, y, k, div_round(net * sd, yd * 1.0, 2, "HALF_UP"));
}

// --- (e)(5): tax for the C short year on an annualized basis -------------

pub relation c_short_year_taxable_income(c: Corporation, e: SCorpElection, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income for the C short year of y (section 1362(e)(5)(A)); case-asserted, the items having been assigned under (e)(2) or (e)(3)";
}
pub relation c_short_year_annualized_income(c: Corporation, e: SCorpElection, y: TaxableYear, amount: Money) kind institutional {
    label en official "the C-short-year taxable income placed on an annual basis: multiplied by the days in the S termination year and divided by the days in the short year (section 1362(e)(5)(A))";
}
@source(IRC_S1362_E, coverage = partial, quote = "by multiplying the taxable income for such short year by the number of days in the S termination year and by dividing the result by the number of days in the short year")
rule S1362E5AAnnualizedIncome defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for ti: Money; for yd: Integer; for sd: Integer;
    when c_short_year_taxable_income(c, e, y, ti);
    when termination_year_days(c, e, y, yd);
    when termination_short_year_days(c, e, y, CShortYear, sd);
    when sd > 0;
    then c_short_year_annualized_income(c, e, y, div_round(ti * yd, sd * 1.0, 2, "HALF_UP"));
}
pub relation c_short_year_annual_basis_tax(c: Corporation, e: SCorpElection, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax computed on the annual basis: the highest (single) section 11(b) rate applied to the annualized income; for taxable years beginning after December 31, 2017 section 11(b) is one flat rate, before that year the rate relation is silent";
}
rule S1362E5ATaxOnAnnualBasis defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for annual: Money; for rate: Decimal;
    when c_short_year_annualized_income(c, e, y, annual);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then c_short_year_annual_basis_tax(c, e, y, round(annual * rate, 2, "HALF_UP"));
}
pub relation c_short_year_tax(c: Corporation, e: SCorpElection, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax for the C short year: the same part of the tax computed on the annual basis as the days in the short year are of the days in the S termination year (section 1362(e)(5)(A), second sentence)";
}
@source(IRC_S1362_E, coverage = partial, quote = "The tax shall be the same part of the tax computed on the annual basis as the number of days in such short year is of the number of days in the S termination year.")
rule S1362E5ATaxForCShortYear defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for annualTax: Money; for yd: Integer; for sd: Integer;
    when c_short_year_annual_basis_tax(c, e, y, annualTax);
    when termination_year_days(c, e, y, yd);
    when termination_short_year_days(c, e, y, CShortYear, sd);
    then c_short_year_tax(c, e, y, div_round(annualTax * sd, yd * 1.0, 2, "HALF_UP"));
}

// --- (e)(6)(A)-(B): carryover count and due date --------------------------

pub relation short_year_not_counted_for_carryover_years(c: Corporation, e: SCorpElection, y: TaxableYear, from: Date, to: Date) kind institutional {
    label en official "the S short year is not taken into account in determining the number of taxable years to which an item may be carried back or forward by the corporation (section 1362(e)(6)(A))";
}
@source(IRC_S1362_E, coverage = partial, quote = "shall not be taken into account for purposes of determining the number of taxable years to which any item may be carried back or carried forward by the corporation")
rule S1362E6AShortYearNotCounted defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for from: Date; for to: Date;
    when termination_short_year(c, e, y, SShortYear, from, to);
    then short_year_not_counted_for_carryover_years(c, e, y, from, to);
}
pub relation c_short_year_return_due_date(c: Corporation, e: SCorpElection, y: TaxableYear, due: Date) kind empirical {
    label en official "the due date, including extensions, for filing the return for the C short year of y; case-asserted (the due-date computation is the returns owner's norm)";
}
pub relation s_short_year_return_due_date(c: Corporation, e: SCorpElection, y: TaxableYear, due: Date) kind institutional {
    label en official "the due date for the return of the S short year is the same as the due date for the return of the C short year, including extensions (section 1362(e)(6)(B))";
}
@source(IRC_S1362_E, coverage = partial, quote = "The due date for filing the return for the short taxable year described in subparagraph (A) of paragraph (1) shall be the same as the due date for filing the return for the short taxable year described in subparagraph (B) of paragraph (1)")
rule S1362E6BSameDueDate defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for due: Date;
    when s_termination_year(c, e, y);
    when c_short_year_return_due_date(c, e, y, due);
    then s_short_year_return_due_date(c, e, y, due);
}

// --- 1377(b): post-termination transition period -------------------------

pub enum PttpKind {
    AfterLastSYear;
    AuditDetermination;
    TerminationDetermination;
    label en unofficial "the three post-termination transition periods of section 1377(b)(1)(A), (B), (C)";
}
pub relation last_s_year_return_due_date(c: Corporation, e: SCorpElection, due: Date) kind empirical {
    label en official "the due date for filing the return for the corporation's last taxable year as an S corporation, including extensions (section 1377(b)(1)(A)(ii)); case-asserted";
}
pub relation determination_adjusting_s_period_item(c: Corporation, e: SCorpElection, on: Date) kind empirical {
    label en official "on is the date of a determination pursuant to an audit that follows the termination and adjusts a subchapter S item arising during the S period (section 1377(b)(1)(B))";
}
pub relation determination_of_prior_termination(c: Corporation, e: SCorpElection, on: Date) kind empirical {
    label en official "on is the date of a determination that the election under section 1362(a) had terminated for a previous taxable year (section 1377(b)(1)(C))";
}
pub relation post_termination_transition_period(c: Corporation, e: SCorpElection, kind: PttpKind, from: Date, to: Date) kind institutional {
    label en official "a post-termination transition period, first and last day (section 1377(b)(1))";
}
pub relation pttp_a_one_year_end(c: Corporation, e: SCorpElection, d: Date) kind institutional {
    label en official "the day one year after the last day of the corporation's last taxable year as an S corporation (section 1377(b)(1)(A)(i)); that last day is the day before the first day the termination is effective";
}
rule Pttp1AOneYearEnd defeasible {
    for c: Corporation; for e: SCorpElection; for d: Date;
    for calendar_before_1: Date;
    when s_termination_effective_date(c, e, d)
        and us.irc.core::civil_calendar_boundary_before(d, 1, us.irc.core::CalendarDay, calendar_before_1);
    then pttp_a_one_year_end(c, e, add_calendar_period(calendar_before_1, 1 calendar_year));
}
@source(IRC_S1377_B, coverage = partial, quote = "the day which is 1 year after such last day, or")
rule Pttp1ALaterIsOneYear defeasible {
    label en official "the period of (b)(1)(A) begins the day after the last S day and ends on the later of the day one year after it or the return due date; here the one-year day is the later (section 1377(b)(1)(A)(i))";
    for c: Corporation; for e: SCorpElection; for d: Date; for oneYear: Date; for due: Date;
    when s_termination_effective_date(c, e, d);
    when pttp_a_one_year_end(c, e, oneYear);
    when last_s_year_return_due_date(c, e, due);
    when oneYear >= due;
    then post_termination_transition_period(c, e, AfterLastSYear, d, oneYear);
}
@source(IRC_S1377_B, coverage = partial, quote = "the due date for filing the return for such last year as an S corporation (including extensions)")
rule Pttp1ALaterIsDueDate defeasible {
    label en official "the period of (b)(1)(A) ends on the return due date when that is later than the one-year day (section 1377(b)(1)(A)(ii))";
    for c: Corporation; for e: SCorpElection; for d: Date; for oneYear: Date; for due: Date;
    when s_termination_effective_date(c, e, d);
    when pttp_a_one_year_end(c, e, oneYear);
    when last_s_year_return_due_date(c, e, due);
    when due > oneYear;
    then post_termination_transition_period(c, e, AfterLastSYear, d, due);
}
@source(IRC_S1377_B, coverage = partial, quote = "the 120-day period beginning on the date of any determination pursuant to an audit of the taxpayer")
rule Pttp1BAuditDetermination defeasible {
    label en official "the 120-day period beginning on the date of an audit determination that adjusts a subchapter S item arising in the S period (section 1377(b)(1)(B))";
    for c: Corporation; for e: SCorpElection; for on: Date;
    when determination_adjusting_s_period_item(c, e, on);
    then post_termination_transition_period(c, e, AuditDetermination, on, add_calendar_period(on, 119 calendar_day));
}
@source(IRC_S1377_B, coverage = partial, quote = "the 120-day period beginning on the date of a determination that the corporation's election under section 1362(a) had terminated for a previous taxable year")
rule Pttp1CTerminationDetermination defeasible {
    label en official "the 120-day period beginning on the date of a determination that the election had terminated for a previous year (section 1377(b)(1)(C))";
    for c: Corporation; for e: SCorpElection; for on: Date;
    when determination_of_prior_termination(c, e, on);
    then post_termination_transition_period(c, e, TerminationDetermination, on, add_calendar_period(on, 119 calendar_day));
}

// (b)(3)(A): the audit period is not a period for section 1366(d)(3).
pub relation pttp_counts_for_loss_allowance_1366d3(c: Corporation, e: SCorpElection, kind: PttpKind, from: Date, to: Date) kind institutional {
    label en official "a post-termination transition period in which a loss or deduction disallowed for the last S year is treated as incurred by the shareholder (section 1366(d)(3)); the audit period of (b)(1)(B) is excluded (section 1377(b)(3)(A))";
}
@source(IRC_S1377_B, coverage = partial, quote = "Paragraph (1)(B) shall not apply for purposes of section 1366(d)(3).")
rule Pttp3AExcludesAuditPeriodFromLossAllowanceA defeasible {
    for c: Corporation; for e: SCorpElection; for from: Date; for to: Date;
    when post_termination_transition_period(c, e, AfterLastSYear, from, to);
    then pttp_counts_for_loss_allowance_1366d3(c, e, AfterLastSYear, from, to);
}
rule Pttp3AExcludesAuditPeriodFromLossAllowanceC defeasible {
    for c: Corporation; for e: SCorpElection; for from: Date; for to: Date;
    when post_termination_transition_period(c, e, TerminationDetermination, from, to);
    then pttp_counts_for_loss_allowance_1366d3(c, e, TerminationDetermination, from, to);
}
// (b)(3)(B): an audit-period distribution is a 1371(e) distribution only to
// the extent of the increase in AAA from the audit adjustments.
pub relation audit_pttp_aaa_increase(c: Corporation, e: SCorpElection, amount: Money) kind empirical {
    label en official "the aggregate increase in the accumulated adjustments account by reason of the audit adjustments of section 1377(b)(1)(B); case-asserted";
}
pub relation audit_pttp_distribution_eligible_for_1371e(c: Corporation, e: SCorpElection, dist: Money, eligible: Money) kind institutional {
    label en official "the part of a distribution during the audit period that is a section 1371(e) distribution: not more than the increase in AAA from the audit adjustments (section 1377(b)(3)(B))";
}
@source(IRC_S1377_B, coverage = partial, quote = "only to the extent that the amount of such distribution does not exceed the aggregate increase (if any) in the accumulated adjustments account")
rule Pttp3BDistributionCapped defeasible {
    for c: Corporation; for e: SCorpElection; for dist: Money; for incr: Money;
    when audit_pttp_aaa_increase(c, e, incr);
    when audit_pttp_distribution_amount(c, e, dist);
    then audit_pttp_distribution_eligible_for_1371e(c, e, dist, min(dist, incr));
}
pub relation audit_pttp_distribution_amount(c: Corporation, e: SCorpElection, amount: Money) kind empirical {
    label en official "the total of money distributions made during the audit post-termination transition period; case-asserted";
}

// --- 1371(e): cash distributions during the (A) period -------------------

pub relation pttp_election_to_distribute_earnings_first(c: Corporation, e: SCorpElection, on: Date) kind empirical {
    label en official "the S corporation elects that section 1371(e)(1) not apply to all distributions made during the post-termination transition period of section 1377(b)(1)(A) (section 1371(e)(2))";
}
pub relation shareholder_consents_to_pttp_election(sh: Person, c: Corporation, e: SCorpElection) kind empirical {
    label en official "sh, a shareholder to whom a distribution is made during the period, consents to the section 1371(e)(2) election";
}
pub relation pttp_distributee(sh: Person, c: Corporation, e: SCorpElection) kind empirical {
    label en official "sh is a shareholder to whom the corporation makes a distribution during the section 1377(b)(1)(A) period";
}
pub relation pttp_election_consent_complete(c: Corporation, e: SCorpElection) kind institutional {
    label en official "all shareholders to whom distributions are made during the period consent to the election (section 1371(e)(2))";
}
@source(IRC_S1371_E, coverage = partial, quote = "Such election shall not be effective unless all shareholders of the S corporation to whom distributions are made by the S corporation during such post-termination transition period consent to such election.")
rule S1371E2ConsentComplete defeasible {
    for c: Corporation; for e: SCorpElection; for anyone: Person;
    when pttp_distributee(anyone, c, e);
    when count(collect sh: Person where pttp_distributee(sh, c, e)) ==
         count(collect sh: Person where pttp_distributee(sh, c, e) and shareholder_consents_to_pttp_election(sh, c, e));
    then pttp_election_consent_complete(c, e);
}
pub relation pttp_earnings_first_election_in_effect(c: Corporation, e: SCorpElection) kind institutional {
    label en official "a validly exercised section 1371(e)(2) election";
}
@source(IRC_S1371_E, coverage = partial, quote = "An S corporation may elect to have paragraph (1) not apply to all distributions made during a post-termination transition period")
rule S1371E2ElectionPower defeasible {
    label en official "the corporation may elect out of the basis-first rule for the (b)(1)(A) period, effective only on the consent of all distributees (section 1371(e)(2))";
    for c: Corporation; for e: SCorpElection; for on: Date;
    when pttp_election_to_distribute_earnings_first(c, e, on);
    then power S1371ElectionOutPower {
        holder c;
        over e;
        exercise pttp_election_to_distribute_earnings_first(c, e, on);
        valid_when pttp_election_consent_complete(c, e);
        effect create(pttp_earnings_first_election_in_effect(c, e));
        window [@1982-01-01, infinity);
    };
}
pub relation pttp_earnings_first_applies(sh: Person, c: Corporation, on: Date, amount: Money) kind institutional {
    label en official "the section 1371(e)(2) election displaces (e)(1) for this distribution";
}
rule PttpEarningsFirstApplies defeasible {
    for sh: Person; for c: Corporation; for e: SCorpElection; for on: Date; for amount: Money;
    when distribution_amount(sh, c, on, amount);
    when pttp_earnings_first_election_in_effect(c, e);
    then pttp_earnings_first_applies(sh, c, on, amount);
}
pub relation pttp_distribution_within_1371e(sh: Person, c: Corporation, on: Date, amount: Money) kind institutional {
    label en official "a money distribution made during the (b)(1)(A) period to which section 1371(e)(1) applies (no (e)(2) election)";
}
rule S1371E1DistributionInPeriod defeasible {
    label en official "a money distribution during the (b)(1)(A) period is a section 1371(e)(1) distribution unless the (e)(2) election applies";
    for sh: Person; for c: Corporation; for e: SCorpElection; for on: Date; for amount: Money; for from: Date; for to: Date;
    when distribution_amount(sh, c, on, amount);
    when post_termination_transition_period(c, e, AfterLastSYear, from, to);
    when on >= from;
    when on <= to;
    unless pttp_earnings_first_applies(sh, c, on, amount);
    then pttp_distribution_within_1371e(sh, c, on, amount);
}
pub relation pttp_cash_distribution_basis_reduction(sh: Person, c: Corporation, on: Date, amount: Money) kind institutional {
    label en official "the part of a money distribution made during the (b)(1)(A) period that is applied against and reduces the adjusted basis of the stock: the distribution, to the extent it does not exceed the accumulated adjustments account (section 1371(e)(1))";
}
@source(IRC_S1371_E, coverage = partial, quote = "shall be applied against and reduce the adjusted basis of the stock, to the extent that the amount of the distribution does not exceed the accumulated adjustments account")
rule S1371E1CashDistributionAppliedAgainstBasis defeasible {
    label en official "a money distribution during the (b)(1)(A) period reduces stock basis up to the AAA (section 1371(e)(1)); the excess is not covered by this rule";
    for sh: Person; for c: Corporation; for on: Date; for amount: Money; for y: TaxableYear; for aaa: Money;
    when pttp_distribution_within_1371e(sh, c, on, amount);
    when us.irc.core::year_of(c, y);
    when aaa_balance(c, y, aaa);
    then pttp_cash_distribution_basis_reduction(sh, c, on, min(amount, aaa));
}

// --- 1371(f): distributions after the period by an ETSC ------------------

pub relation eligible_terminated_s_corporation(c: Corporation) kind empirical {
    label en official "c is an eligible terminated S corporation as defined in section 481(d); case-asserted (the section 481(d) definition is the accounting owner's)";
}
pub relation accumulated_e_and_p_amount(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the corporation's accumulated earnings and profits; case-asserted";
}
pub relation post_pttp_distribution(sh: Person, c: Corporation, e: SCorpElection, on: Date, amount: Money) kind empirical {
    label en official "a distribution of money by the corporation after the post-termination transition period of section 1377(b)(1)(A)";
}
pub relation etsc_distribution_allocated_to_aaa(sh: Person, c: Corporation, on: Date, amount: Money) kind institutional {
    label en official "the part of a post-period distribution by an eligible terminated S corporation to which the AAA is allocated: the AAA and the accumulated E&P share the distribution in the ratio of the two accounts (section 1371(f)); JUDGMENT CALL on the reading of the ratio, see the coverage note";
}
pub relation etsc_distribution_charged_to_e_and_p(sh: Person, c: Corporation, on: Date, amount: Money) kind institutional {
    label en official "the part of a post-period distribution by an eligible terminated S corporation chargeable to accumulated E&P (section 1371(f))";
}
@source(IRC_S1371_F, coverage = partial, quote = "the accumulated adjustments account shall be allocated to such distribution, and the distribution shall be chargeable to accumulated earnings and profits, in the same ratio as the amount of such accumulated adjustments account bears to the amount of such accumulated earnings and profits")
rule S1371FAllocationToAaa defeasible {
    label en official "AAA share of the distribution = D x AAA / (AAA + AE&P) (section 1371(f))";
    for sh: Person; for c: Corporation; for e: SCorpElection; for on: Date; for amount: Money; for y: TaxableYear; for aaa: Money; for ep: Money;
    when eligible_terminated_s_corporation(c);
    when post_pttp_distribution(sh, c, e, on, amount);
    when us.irc.core::year_of(c, y);
    when aaa_balance(c, y, aaa);
    when accumulated_e_and_p_amount(c, y, ep);
    when aaa + ep > 0.00 USD;
    then etsc_distribution_allocated_to_aaa(sh, c, on, div_round(amount * (aaa / 1.00 USD), (aaa + ep) / 1.00 USD, 2, "HALF_UP"));
}
rule S1371FChargeToEAndP defeasible {
    for sh: Person; for c: Corporation; for e: SCorpElection; for on: Date; for amount: Money; for y: TaxableYear; for aaa: Money; for ep: Money;
    when eligible_terminated_s_corporation(c);
    when post_pttp_distribution(sh, c, e, on, amount);
    when us.irc.core::year_of(c, y);
    when aaa_balance(c, y, aaa);
    when accumulated_e_and_p_amount(c, y, ep);
    when aaa + ep > 0.00 USD;
    then etsc_distribution_charged_to_e_and_p(sh, c, on, div_round(amount * (ep / 1.00 USD), (aaa + ep) / 1.00 USD, 2, "HALF_UP"));
}
