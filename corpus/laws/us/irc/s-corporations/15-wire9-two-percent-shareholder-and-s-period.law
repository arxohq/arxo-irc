// Subchapter S -- WIRE-9 (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// (1) Section 1372(b), "2-percent shareholder": derived from the day-by-day roster (`shares_held` / `shares_outstanding`),
//     the voting-power facts below, and the section 318 attribution of `us.irc.corporations` (TECH-GAPS G7002 closed).
// (2) Section 1368(e)(2), "S period": the most recent continuous period during which the corporation has been an S corporation,
//     never including a taxable year beginning before January 1, 1983 (TECH-GAPS G7001 closed).
//
// JUDGMENT CALLS
//  - The 2-percent comparison is `n * 50 > total` (no rounding): "more than 2 percent" is strict, exactly 2 percent does not qualify.
//  - The section 318 branch reads `us.irc.corporations::total_constructive_ownership_share` (undated: sums every attribution kind);
//    the year is tied to it by the case fact `stock_ownership_facts_relate_to_a_day_of`, so the attribution branch is not a
//    day-by-day scan. The stock branch and the voting-power branch are day-by-day.
//  - S period: a taxable year belongs to the S period of an election when the election is effective for a year beginning no later
//    than that year, the corporation is an S corporation for that year, the election has not been terminated by then and the
//    year begins on or after 1983-01-01. "Most recent" compares the beginning dates of the effective years of the elections that
//    have such years. An S election that continues through a re-election without a gap is not separately modelled.

language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

use self::{
    Corporation,
    IRC_S1368_E,
    IRC_S1372_B,
    Person,
    SCorpElection,
    TaxableYear,
    disc_or_former_disc,
    s_corporation,
    s_election_effective_year,
    s_election_terminated_as_of,
    shares_held,
    shares_outstanding,
    two_percent_shareholder,
};

// --- section 1372(b): 2-percent shareholder ---------------------------------------------------------------------------------

pub relation voting_power_held(sh: Person, c: Corporation, on: Date, n: Decimal) kind empirical {
    label en official "the total combined voting power possessed by the stock sh holds in c on date on (section 1372(b)); case-asserted";
}
pub relation total_voting_power(c: Corporation, on: Date, total: Decimal) kind empirical {
    label en official "the total combined voting power of all stock of c on date on (section 1372(b)); case-asserted";
}
pub relation stock_ownership_facts_relate_to_a_day_of(sh: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en official "the ownership facts of sh in c that section 318 attribution reads (`us.irc.core::ownership_interest`) describe ownership on at least one day during y; case-asserted";
}

@source(IRC_S1372_B, quote = "owns (or is considered as owning within the meaning of section 318) on any day during the taxable year of the S corporation more than 2 percent of the outstanding stock of such corporation")
rule S1372BMoreThanTwoPercentOfOutstandingStockOnADay strict {
    label en official "sh owns more than 2 percent of the outstanding stock of c on some day during y (section 1372(b), owned stock)";
    for sh: Person; for c: Corporation; for y: TaxableYear; for d: Date; for b: Date; for e: Date; for total: Decimal; for n: Decimal;
    when shares_outstanding(c, d, total);
    when shares_held(sh, c, d, n);
    when total > 0.00;
    when n * 50.00 > total;
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, e);
    when d >= b;
    when d <= e;
    then two_percent_shareholder(sh, c, y);
}
@source(IRC_S1372_B, quote = "or stock possessing more than 2 percent of the total combined voting power of all stock of such corporation")
rule S1372BMoreThanTwoPercentOfVotingPowerOnADay strict {
    label en official "sh holds stock possessing more than 2 percent of the total combined voting power of c on some day during y (section 1372(b), voting power)";
    for sh: Person; for c: Corporation; for y: TaxableYear; for d: Date; for b: Date; for e: Date; for total: Decimal; for n: Decimal;
    when total_voting_power(c, d, total);
    when voting_power_held(sh, c, d, n);
    when total > 0.00;
    when n * 50.00 > total;
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, e);
    when d >= b;
    when d <= e;
    then two_percent_shareholder(sh, c, y);
}
@source(IRC_S1372_B, quote = "owns (or is considered as owning within the meaning of section 318)")
rule S1372BConsideredAsOwningMoreThanTwoPercentUnderSection318 strict {
    label en official "sh is considered as owning, under section 318(a), more than 2 percent of c (actual and attributed shares summed by the corporations package) during y (section 1372(b))";
    for sh: Person; for c: Corporation; for y: TaxableYear; for share: Decimal;
    when us.irc.corporations::total_constructive_ownership_share(sh, c, share);
    when share > 0.02;
    when stock_ownership_facts_relate_to_a_day_of(sh, c, y);
    then two_percent_shareholder(sh, c, y);
}

// --- section 1368(e)(2): S period -------------------------------------------------------------------------------------------

pub relation election_terminated_by_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the election e of c has been terminated under section 1362(d) in a taxable year that begins no later than y";
}
rule S1368E2ElectionTerminatedByYear defeasible {
    label en official "helper: termination in year yt carries to every year beginning on or after the beginning of yt";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for yt: TaxableYear; for dt: Date; for dy: Date;
    when s_election_terminated_as_of(c, e, yt);
    when us.irc.core::begins(yt, dt);
    when us.irc.core::begins(y, dy);
    when dt <= dy;
    then election_terminated_by_year(c, e, y);
}
pub relation s_period_year_of_election(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "y is a taxable year of the continuous period during which c has been an S corporation under election e, with no year beginning before 1983-01-01 (section 1368(e)(2))";
}
@source(IRC_S1368_E, quote = "Such period shall not include any taxable year beginning before January 1, 1983.")
rule S1368E2SPeriodYearOfElection defeasible {
    label en official "a year of the S period: the election is effective for a year beginning no later than y, c is an S corporation for y, the election is not terminated by y, and y begins on or after January 1, 1983";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for y0: TaxableYear; for d0: Date; for dy: Date;
    when s_election_effective_year(c, e, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, dy);
    when dy >= d0;
    when dy >= @1983-01-01;
    when s_corporation(c, y);
    unless election_terminated_by_year(c, e, y);
    then s_period_year_of_election(c, e, y);
}
pub relation s_period_superseded_by_later_election(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "y is a year of the S period of election e, but another election of c became effective for a year beginning later than the election e became effective and has years of an S period";
}
rule S1368E2SPeriodSuperseded defeasible {
    label en official "helper: a later election with S-period years makes the earlier election's period not the most recent";
    for c: Corporation; for e: SCorpElection; for e2: SCorpElection; for y0: TaxableYear; for d0: Date; for y2: TaxableYear; for d2: Date; for ya: TaxableYear; for yb: TaxableYear;
    when s_period_year_of_election(c, e, ya);
    when s_period_year_of_election(c, e2, yb);
    when s_election_effective_year(c, e, y0);
    when us.irc.core::begins(y0, d0);
    when s_election_effective_year(c, e2, y2);
    when us.irc.core::begins(y2, d2);
    when d2 > d0;
    then s_period_superseded_by_later_election(c, e, ya);
}
pub relation taxable_year_in_s_period_1368e2(c: Corporation, y: TaxableYear) kind institutional {
    label en official "y lies in the S period of c: the most recent continuous period during which c has been an S corporation, excluding any taxable year beginning before January 1, 1983 (section 1368(e)(2))";
}
@source(IRC_S1368_E, quote = "The term \"S period\" means the most recent continuous period during which the corporation has been an S corporation.")
rule S1368E2SPeriodIsTheMostRecentContinuousPeriod defeasible {
    label en official "the S period consists of the years of the most recent election's continuous period (section 1368(e)(2))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear;
    when us.irc.core::year_of(c, y);
    when s_period_year_of_election(c, e, y);
    unless s_period_superseded_by_later_election(c, e, y);
    then taxable_year_in_s_period_1368e2(c, y);
}

// --- section 1361(b)(2)(C): a DISC or former DISC (owner: international, section 992(a)(3)) ----------------------------------------
//
// New direct import `us.irc.international` (acyclic: international does not import this package). Only the FORMER-DISC limb is derived: a
// corporation that is a former DISC for some taxable year stays a former DISC afterwards, so the year of the owner's relation is not needed by the
// timeless placeholder. A corporation that IS a DISC (section 992(a)(1)) is still asserted by the case.

rule W9FormerDiscFromInternational strict {
    label en official "section 1361(b)(2)(C): a corporation that section 992(a)(3) makes a former DISC (owner package `international`) is a DISC or former DISC";
    for c: Corporation;
    for y: TaxableYear;
    when us.irc.international::former_disc_992a3(c, y);
    then disc_or_former_disc(c);
}
