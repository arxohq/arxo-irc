// Shared ontology for Subchapter S: the shareholder roster, stock classes,
// the S election itself, and the corporate-level taxes §1374/§1375 attach
// to. Every later module of this package reads these shapes.

// --- Shareholder roster (case-asserted; see package.law header note) ------

use self::{
    Corporation,
    IRC_S1361_C,
    Person,
    TaxableYear,
    family_member_shareholder_derived,
};

pub relation shareholder_of(sh: Person, c: Corporation, on: Date) kind empirical {
    label en official "sh holds stock in corporation c on date on";
}

pub relation shares_held(sh: Person, c: Corporation, on: Date, n: Decimal) kind empirical {
    label en official "the number of shares of stock sh holds in c on date on";
}

pub relation shares_outstanding(c: Corporation, on: Date, n: Decimal) kind empirical {
    label en official "the total number of shares of stock of c outstanding on date on";
}

// §1361(c)(1): a husband and wife and all members of a family (as defined in
// (c)(1)(B)) are treated as ONE shareholder for the §1361(b)(1)(A) count.
// The family GROUPING and its representative are case-asserted: this
// package does not derive the (c)(1)(B) generation-count/common-ancestor
// test from a genealogy (no such input exists in this title's own facts) —
// TECH-GAPS.md row G30.
pub relation family_group_representative(u: Person, sh: Person, c: Corporation, on: Date) kind empirical {
    label en official "for the §1361(c)(1) one-shareholder rule, u is the counted representative of sh's family group (husband-and-wife or members-of-a-family, §1361(c)(1)(A)-(B)) in corporation c on date on";
}

// The unit actually counted toward the §1361(b)(1)(A) 100-shareholder limit:
// a shareholder who is not part of an asserted family group counts as
// itself; a shareholder who IS part of a group counts as the group's single
// representative (never both, and never twice for two members of the same
// group — the case asserts the same representative for every member).
@source(IRC_S1361_C, quote = "there shall be treated as one shareholder")
rule CountedShareholderUnitSelf(sh: Person, c: Corporation, on: Date) strict {
    label en official "a shareholder not asserted as part of a family group counts as itself (§1361(b)(1)(A), (c)(1) a contrario)";
    when shareholder_of(sh, c, on);
    when not_known(family_group_representative(sh, sh, c, on));
    when not_known(family_member_shareholder_derived(sh, c, on));
    then counted_shareholder_unit(sh, c, on);
}
@source(IRC_S1361_C, quote = "there shall be treated as one shareholder")
rule CountedShareholderUnitFamilyRepresentative(u: Person, sh: Person, c: Corporation, on: Date) strict {
    label en official "a husband and wife or members of a family are counted as one shareholder through their asserted representative (§1361(c)(1))";
    when family_group_representative(u, sh, c, on);
    then counted_shareholder_unit(u, c, on);
}
pub relation counted_shareholder_unit(u: Person, c: Corporation, on: Date) kind institutional {
    label en official "u is a unit counted toward the §1361(b)(1)(A) 100-shareholder limit on date on";
}

// --- Stock classes ----------------------------------------------------

pub enum StockDifferenceKind {
    VotingRightsOnly;
    StraightDebtInstrument;
    EconomicRightsDifference;
    label en unofficial "the kind of difference an instrument or class of stock presents, for the §1361(b)(1)(D)/(c)(4)-(5) one-class-of-stock test";
}
pub relation stock_instrument_difference(c: Corporation, on: Date, kind: StockDifferenceKind) kind empirical {
    label en official "a difference among c's outstanding stock/debt instruments is asserted, classified by kind, for the one-class-of-stock test as of date on";
}

// --- S election ---------------------------------------------------------

pub entity SCorpElection : Election { label en unofficial "an election under section 1362(a) to be an S corporation"; }

pub relation shareholder_consents_to_election(sh: Person, c: Corporation, e: SCorpElection, on: Date) kind empirical {
    label en official "sh, a shareholder on the day the election is made, consents to the election under section 1362(a)(2)";
}
pub relation shareholder_consents_to_revocation(sh: Person, c: Corporation, on: Date) kind empirical {
    label en official "sh consents to a revocation of the S election under section 1362(d)(1)(B)";
}

// --- Corporate-level taxes (§§1374/1375) — shared shape read by 09-taxes.law ---

pub enum SCorpTaxKind {
    BuiltInGainsTax1374;
    ExcessNetPassiveIncomeTax1375;
    label en unofficial "which corporate-level tax of Subchapter S the amount is";
}
pub relation s_corp_tax(c: Corporation, y: TaxableYear, kind: SCorpTaxKind, amount: Money) kind institutional {
    label en official "the corporate-level tax an S corporation owes under section 1374 or 1375 for taxable year y";
}
