            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": stock_instrument_difference(entity_ref("urn:test:s1361:t5#c"), @2024-06-01, VotingRightsOnly) { origin case_input; }
    }
    evaluate truth(has_more_than_one_class_of_stock(entity_ref("urn:test:s1361:t5#c"), @2024-06-01));
