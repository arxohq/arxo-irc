test "S1361-06-QSSS-ELECTION-VALID" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::domestic(entity_ref("urn:test:s1361:t6#sub")) { origin case_input; }
        assert "f1": qsss_wholly_owned(entity_ref("urn:test:s1361:t6#parent"), entity_ref("urn:test:s1361:t6#sub"), @2024-06-01) { origin case_input; }
        assert "f2": elects_qsss(entity_ref("urn:test:s1361:t6#parent"), entity_ref("urn:test:s1361:t6#sub"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(qualified_subchapter_s_subsidiary(entity_ref("urn:test:s1361:t6#parent"), entity_ref("urn:test:s1361:t6#sub"), @2024-06-01));
    expect truth_status == TRUE_ONLY;
}
