// Section 1361 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

test "S1361-01-DOMESTIC-CORP-100-SHAREHOLDERS-QUALIFIES" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::domestic(entity_ref("urn:test:s1361:t1#c")) { origin case_input; }
    }
    // 100 counted shareholders (not more than 100) is at the statutory line, not over it.
    evaluate truth(shareholder_count_exceeds_100(entity_ref("urn:test:s1361:t1#c"), @2024-06-01));
    expect truth_status == FALSE_ONLY;
}

test "S1361-02-101-SHAREHOLDERS-EXCEEDS-LIMIT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // 101 distinct counted-shareholder-unit facts would be asserted here
        // in a full case; the scenario states the derived boundary fact
        // directly per PLAN §10.1's "threshold above" branch.
        assert "f0": shareholder_of_any(entity_ref("urn:test:s1361:t2#c"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(shareholder_count_exceeds_100(entity_ref("urn:test:s1361:t2#c"), @2024-06-01));
    expect truth_status == NEITHER;
}

test "S1361-03-NONRESIDENT-ALIEN-SHAREHOLDER-DISQUALIFIES" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": shareholder_of(entity_ref("urn:test:s1361:t3#sh"), entity_ref("urn:test:s1361:t3#c"), @2024-06-01) { origin case_input; }
        assert "f1": calendar_year_of_date(@2024-06-01, 2024) { origin case_input; }
        assert "f2": us.irc.definitions::nonresident_alien_for_year(entity_ref("urn:test:s1361:t3#sh"), 2024) { origin case_input; }
    }
    evaluate truth(has_nonresident_alien_shareholder(entity_ref("urn:test:s1361:t3#c"), @2024-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S1361-04-SECOND-CLASS-OF-STOCK-DISQUALIFIES" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": stock_instrument_difference(entity_ref("urn:test:s1361:t4#c"), @2024-06-01, EconomicRightsDifference) { origin case_input; }
    }
    evaluate truth(has_more_than_one_class_of_stock(entity_ref("urn:test:s1361:t4#c"), @2024-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S1361-05-VOTING-RIGHTS-DIFFERENCE-SAFE-HARBOR-ONE-CLASS" {
    given {
        context {
            legal_time @2024-06-01;
