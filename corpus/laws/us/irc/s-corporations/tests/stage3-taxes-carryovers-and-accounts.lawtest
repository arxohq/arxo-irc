// Stage 3 (26.09.2026) scenarios for sections 1362(d)(3), 1363(d), 1366(d)-(f), 1367(b), 1368(e), 1371(c)-(d), 1374, 1375, 1377(a)(2). NOT EXECUTED (implemented_unverified). Expectations come from the statute text; NEITHER stands for "no rule concludes".


language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

test "S1368-20-NET-NEGATIVE-ADJUSTMENT-DISREGARDED-FOR-DISTRIBUTIONS" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::begins(entity_ref("urn:test:a1#y"), @2024-01-01) { id "f0"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:test:a1#y"), @2024-12-31) { id "f1"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:test:a1#c"), entity_ref("urn:test:a1#y")) { id "f2"; origin case_input; }
        assert aaa_opening_balance(entity_ref("urn:test:a1#c"), entity_ref("urn:test:a1#y"), 1000.00 USD) { id "f3"; origin case_input; }
        assert corporation_gross_income(entity_ref("urn:test:a1#c"), entity_ref("urn:test:a1#y"), 200.00 USD) { id "f4"; origin case_input; }
        assert corporation_deductions_excluding_separately_stated(entity_ref("urn:test:a1#c"), entity_ref("urn:test:a1#y"), 700.00 USD) { id "f5"; origin case_input; }
    }
    // net adjustment -500 is a net negative adjustment: only the opening 1000 is available.
    evaluate truth(aaa_available_for_distributions(entity_ref("urn:test:a1#c"), entity_ref("urn:test:a1#y"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

