test "S1374-01-BUILT-IN-GAIN-WITHIN-RECOGNITION-PERIOD-TAXED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": recognized_built_in_gain_for_year(entity_ref("urn:test:s1374:t1#c"), entity_ref("urn:test:s1374:t1#y"), 8000.00) { origin case_input; }
        assert "f1": taxable_income_if_only_built_in_items(entity_ref("urn:test:s1374:t1#c"), entity_ref("urn:test:s1374:t1#y"), 8000.00) { origin case_input; }
        assert "f2": corporation_taxable_income_1375b1B(entity_ref("urn:test:s1374:t1#c"), entity_ref("urn:test:s1374:t1#y"), 50000.00) { origin case_input; }
        assert "f3": net_unrealized_built_in_gain(entity_ref("urn:test:s1374:t1#c"), 100000.00) { origin case_input; }
        assert "f4": prior_years_net_recognized_built_in_gain(entity_ref("urn:test:s1374:t1#c"), entity_ref("urn:test:s1374:t1#y"), 0.00) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:s1374:t1#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(s_corp_tax(entity_ref("urn:test:s1374:t1#c"), entity_ref("urn:test:s1374:t1#y"), BuiltInGainsTax1374, 1680.00));
    expect truth_status == TRUE_ONLY;
}

test "S1374-02-ALL-YEARS-S-CORPORATION-BLOCKS-TAX" {
    given {
        context {
