// Sections 1366, 1367, 1368, 1374, 1375 scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

test "S1366-01-LOSS-WITHIN-BASIS-ALLOWED-IN-FULL" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": corporation_separately_stated_items_net(entity_ref("urn:test:s1366:t1#c"), entity_ref("urn:test:s1366:t1#y"), -5000.00) { origin case_input; }
        assert "f1": corporation_gross_income(entity_ref("urn:test:s1366:t1#c"), entity_ref("urn:test:s1366:t1#y"), 0.00) { origin case_input; }
        assert "f2": corporation_deductions_excluding_separately_stated(entity_ref("urn:test:s1366:t1#c"), entity_ref("urn:test:s1366:t1#y"), 0.00) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s1366:t1#y"), @2024-01-01) { origin case_input; }
        assert "f4": shares_held(entity_ref("urn:test:s1366:t1#sh"), entity_ref("urn:test:s1366:t1#c"), @2024-01-01, 100.00) { origin case_input; }
        assert "f5": shares_outstanding(entity_ref("urn:test:s1366:t1#c"), @2024-01-01, 100.00) { origin case_input; }
        assert "f6": shareholder_stock_basis(entity_ref("urn:test:s1366:t1#sh"), entity_ref("urn:test:s1366:t1#c"), entity_ref("urn:test:s1366:t1#y"), 10000.00) { origin case_input; }
        assert "f7": shareholder_debt_basis(entity_ref("urn:test:s1366:t1#sh"), entity_ref("urn:test:s1366:t1#c"), entity_ref("urn:test:s1366:t1#y"), 0.00) { origin case_input; }
    }
    evaluate truth(shareholder_loss_allowed(entity_ref("urn:test:s1366:t1#sh"), entity_ref("urn:test:s1366:t1#c"), entity_ref("urn:test:s1366:t1#y"), 5000.00));
    expect truth_status == TRUE_ONLY;
}

test "S1366-02-LOSS-ABOVE-BASIS-CARRIES-OVER-NEXT-YEAR" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": corporation_separately_stated_items_net(entity_ref("urn:test:s1366:t2#c"), entity_ref("urn:test:s1366:t2#y1"), -9000.00) { origin case_input; }
        assert "f1": corporation_gross_income(entity_ref("urn:test:s1366:t2#c"), entity_ref("urn:test:s1366:t2#y1"), 0.00) { origin case_input; }
        assert "f2": corporation_deductions_excluding_separately_stated(entity_ref("urn:test:s1366:t2#c"), entity_ref("urn:test:s1366:t2#y1"), 0.00) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s1366:t2#y1"), @2024-01-01) { origin case_input; }
        assert "f4": shares_held(entity_ref("urn:test:s1366:t2#sh"), entity_ref("urn:test:s1366:t2#c"), @2024-01-01, 100.00) { origin case_input; }
        assert "f5": shares_outstanding(entity_ref("urn:test:s1366:t2#c"), @2024-01-01, 100.00) { origin case_input; }
        assert "f6": shareholder_stock_basis(entity_ref("urn:test:s1366:t2#sh"), entity_ref("urn:test:s1366:t2#c"), entity_ref("urn:test:s1366:t2#y1"), 4000.00) { origin case_input; }
        assert "f7": shareholder_debt_basis(entity_ref("urn:test:s1366:t2#sh"), entity_ref("urn:test:s1366:t2#c"), entity_ref("urn:test:s1366:t2#y1"), 0.00) { origin case_input; }
        assert "f8": next_taxable_year(entity_ref("urn:test:s1366:t2#y1"), entity_ref("urn:test:s1366:t2#y2")) { origin case_input; }
    }
    evaluate truth(shareholder_loss_carryover(entity_ref("urn:test:s1366:t2#sh"), entity_ref("urn:test:s1366:t2#c"), entity_ref("urn:test:s1366:t2#y1"), entity_ref("urn:test:s1366:t2#y2"), 5000.00));
    expect truth_status == TRUE_ONLY;
}

