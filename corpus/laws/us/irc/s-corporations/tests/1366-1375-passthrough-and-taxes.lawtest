        }
        assert "f0": recognized_built_in_gain_for_year(entity_ref("urn:test:s1374:t2#c"), entity_ref("urn:test:s1374:t2#y"), 8000.00) { origin case_input; }
        assert "f1": taxable_income_if_only_built_in_items(entity_ref("urn:test:s1374:t2#c"), entity_ref("urn:test:s1374:t2#y"), 8000.00) { origin case_input; }
