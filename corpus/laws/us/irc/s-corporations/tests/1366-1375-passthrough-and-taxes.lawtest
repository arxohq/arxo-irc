    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution_amount(entity_ref("urn:test:s1368:t1#sh"), entity_ref("urn:test:s1368:t1#c"), @2024-06-01, 3000.00) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s1368:t1#c"), entity_ref("urn:test:s1368:t1#y")) { origin case_input; }
        assert "f2": shareholder_stock_basis(entity_ref("urn:test:s1368:t1#sh"), entity_ref("urn:test:s1368:t1#c"), entity_ref("urn:test:s1368:t1#y"), 10000.00) { origin case_input; }
