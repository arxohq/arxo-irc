test "S1375-01-PASSIVE-INCOME-26-PERCENT-WITH-AEP-TAXED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": corporation_has_accumulated_e_and_p(entity_ref("urn:test:s1375:t1#c"), entity_ref("urn:test:s1375:t1#y")) { origin case_input; }
        assert "f1": passive_investment_income_total(entity_ref("urn:test:s1375:t1#c"), entity_ref("urn:test:s1375:t1#y"), 26000.00) { origin case_input; }
        assert "f2": gross_receipts_total(entity_ref("urn:test:s1375:t1#c"), entity_ref("urn:test:s1375:t1#y"), 100000.00) { origin case_input; }
        assert "f3": deductions_directly_connected_with_passive_income(entity_ref("urn:test:s1375:t1#c"), entity_ref("urn:test:s1375:t1#y"), 0.00) { origin case_input; }
        assert "f4": corporation_taxable_income_63a_modified(entity_ref("urn:test:s1375:t1#c"), entity_ref("urn:test:s1375:t1#y"), 90000.00) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:s1375:t1#y"), @2024-01-01) { origin case_input; }
    }
    // 26% > 25% of gross receipts: passive income exceeds the 25% ceiling by 1,000.
    evaluate truth(passive_income_excess_over_25_percent(entity_ref("urn:test:s1375:t1#c"), entity_ref("urn:test:s1375:t1#y"), 1000.00));
    expect truth_status == TRUE_ONLY;
}

test "S1375-02-PASSIVE-INCOME-25-PERCENT-EXACTLY-NOT-EXCEEDED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": passive_investment_income_total(entity_ref("urn:test:s1375:t2#c"), entity_ref("urn:test:s1375:t2#y"), 25000.00) { origin case_input; }
        assert "f1": gross_receipts_total(entity_ref("urn:test:s1375:t2#c"), entity_ref("urn:test:s1375:t2#y"), 100000.00) { origin case_input; }
    }
    evaluate truth(passive_income_excess_over_25_percent(entity_ref("urn:test:s1375:t2#c"), entity_ref("urn:test:s1375:t2#y"), 0.00));
    expect truth_status == FALSE_ONLY;
}
