test "S1362-20-PRO-RATA-NONSEPARATE-S-SHORT-YEAR-182-OF-366" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::begins(entity_ref("urn:test:t7#y"), @2024-01-01) { id "f0"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:test:t7#y"), @2024-12-31) { id "f1"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:test:t7#c"), entity_ref("urn:test:t7#y")) { id "f2"; origin case_input; }
        assert small_business_cessation_date(entity_ref("urn:test:t7#c"), entity_ref("urn:test:t7#e"), @2024-07-01) { id "f3"; origin case_input; }
        assert corporation_gross_income(entity_ref("urn:test:t7#c"), entity_ref("urn:test:t7#y"), 400000.00 USD) { id "f4"; origin case_input; }
        assert corporation_deductions_excluding_separately_stated(entity_ref("urn:test:t7#c"), entity_ref("urn:test:t7#y"), 34000.00 USD) { id "f5"; origin case_input; }
    }
    // nonseparately computed income 366000.00 USD; 366000 x 182 / 366 = 182000.00.
    evaluate truth(short_year_nonseparate_item(entity_ref("urn:test:t7#c"), entity_ref("urn:test:t7#e"), entity_ref("urn:test:t7#y"), SShortYear, 182000.00 USD));
    expect truth_status == TRUE_ONLY;
}

