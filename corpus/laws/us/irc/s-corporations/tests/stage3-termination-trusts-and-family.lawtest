test "S1368-11-CORPORATION-DEDUCTION-IN-YEAR-WITH-WHICH-DIRECTOR-YEAR-ENDS" {
    given {
        context { decision_time @2025-01-15T09:00:00-05:00; knowledge_time @2025-01-15T09:00:00-05:00; legal_time @2025-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert bank_or_depository_holding_company(entity_ref("urn:test:b5#c")) { id "f0"; origin case_input; }
        assert stock_required_to_be_held_by_director(entity_ref("urn:test:b5#d"), entity_ref("urn:test:b5#c"), @2024-06-01) { id "f1"; origin case_input; }
        assert stock_subject_to_sell_back_at_acquisition_price(entity_ref("urn:test:b5#d"), entity_ref("urn:test:b5#c"), @2024-06-01) { id "f2"; origin case_input; }
        assert distribution_to_director_on_restricted_stock(entity_ref("urn:test:b5#d"), entity_ref("urn:test:b5#c"), @2024-06-01, 500.00 USD) { id "f3"; origin case_input; }
        assert director_inclusion_year_ends_on(entity_ref("urn:test:b5#d"), @2024-06-01, @2024-12-31) { id "f4"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:test:b5#c"), entity_ref("urn:test:b5#y")) { id "f5"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:test:b5#y"), @2024-07-01) { id "f6"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:test:b5#y"), @2025-06-30) { id "f7"; origin case_input; }
    }
    // fiscal S corporation year 2024-07-01..2025-06-30 contains the day the director year ends.
    evaluate truth(corporation_deduction_for_director_distribution(entity_ref("urn:test:b5#c"), entity_ref("urn:test:b5#y"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

