// Stage 3 (26.09.2026) scenarios for sections 1361-1371 and 1377: S termination year, post-termination transition period, trusts, family, bank stock. NOT EXECUTED (implemented_unverified). Expectations come from the statute text; NEITHER stands for "no rule concludes" (an absent fact is not a negation).


language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

test "S1362-10-MID-YEAR-CESSATION-IS-S-TERMINATION-YEAR" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::begins(entity_ref("urn:test:t1#y"), @2024-01-01) { id "f0"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:test:t1#y"), @2024-12-31) { id "f1"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:test:t1#c"), entity_ref("urn:test:t1#y")) { id "f2"; origin case_input; }
        assert small_business_cessation_date(entity_ref("urn:test:t1#c"), entity_ref("urn:test:t1#e"), @2024-07-01) { id "f3"; origin case_input; }
    }
    evaluate truth(s_termination_year(entity_ref("urn:test:t1#c"), entity_ref("urn:test:t1#e"), entity_ref("urn:test:t1#y")));
    expect truth_status == TRUE_ONLY;
}

