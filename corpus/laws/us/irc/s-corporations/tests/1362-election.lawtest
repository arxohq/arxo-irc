// Section 1362 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

test "S1362-01-ELECTION-ON-DEADLINE-MARCH-15-EFFECTIVE-SAME-YEAR" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s1362:t1#y"), @2024-01-01) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:s1362:t1#y"), @2024-12-31) { origin case_input; }
        assert "f2": s_election_made_validly(entity_ref("urn:test:s1362:t1#c"), entity_ref("urn:test:s1362:t1#e"), @2024-03-15) { origin case_input; }
    }
    // The 15th day of the 3rd month of a year beginning January 1 is March 15.
    evaluate truth(s1362b_deadline(entity_ref("urn:test:s1362:t1#y"), @2024-03-15));
    expect truth_status == TRUE_ONLY;
}

test "S1362-02-ELECTION-MARCH-16-AFTER-DEADLINE-NOT-TIMELY-FOR-SAME-YEAR" {
    given {
        context {
            legal_time @2024-03-16;
            decision_time @2024-03-16T09:00:00-05:00;
            knowledge_time @2024-03-16T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s1362:t2#y"), @2024-01-01) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:s1362:t2#y"), @2024-12-31) { origin case_input; }
        assert "f2": s_election_made_validly(entity_ref("urn:test:s1362:t2#c"), entity_ref("urn:test:s1362:t2#e"), @2024-03-16) { origin case_input; }
    }
    evaluate truth(s_election_made_timely_in_year(entity_ref("urn:test:s1362:t2#c"), entity_ref("urn:test:s1362:t2#e"), entity_ref("urn:test:s1362:t2#y")));
    expect truth_status == FALSE_ONLY;
}

test "S1362-03-REVOCATION-51-PERCENT-CONSENT-VALID" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": shares_outstanding(entity_ref("urn:test:s1362:t3#c"), @2024-06-01, 100.00) { origin case_input; }
        assert "f1": shareholder_consents_to_revocation(entity_ref("urn:test:s1362:t3#sh1"), entity_ref("urn:test:s1362:t3#c"), @2024-06-01) { origin case_input; }
        assert "f2": shares_held(entity_ref("urn:test:s1362:t3#sh1"), entity_ref("urn:test:s1362:t3#c"), @2024-06-01, 51.00) { origin case_input; }
    }
    evaluate truth(revocation_majority_consent(entity_ref("urn:test:s1362:t3#c"), @2024-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S1362-04-REVOCATION-50-PERCENT-CONSENT-INSUFFICIENT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": shares_outstanding(entity_ref("urn:test:s1362:t4#c"), @2024-06-01, 100.00) { origin case_input; }
        assert "f1": shareholder_consents_to_revocation(entity_ref("urn:test:s1362:t4#sh1"), entity_ref("urn:test:s1362:t4#c"), @2024-06-01) { origin case_input; }
        assert "f2": shares_held(entity_ref("urn:test:s1362:t4#sh1"), entity_ref("urn:test:s1362:t4#c"), @2024-06-01, 50.00) { origin case_input; }
    }
    // "More than one-half" requires strictly more than 50 percent.
    evaluate truth(revocation_majority_consent(entity_ref("urn:test:s1362:t4#c"), @2024-06-01));
    expect truth_status == FALSE_ONLY;
}

test "S1362-05-INVALID-ELECTION-NOT-SMALL-BUSINESS-CORPORATION" {
    given {
        context {
            legal_time @2024-03-01;
            decision_time @2024-03-01T09:00:00-05:00;
            knowledge_time @2024-03-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_s_status(entity_ref("urn:test:s1362:t5#c"), entity_ref("urn:test:s1362:t5#e"), @2024-03-01) { origin case_input; }
        assert "f1": shareholder_of_any(entity_ref("urn:test:s1362:t5#c"), @2024-03-01) { origin case_input; }
        assert "f2": shareholder_count_exceeds_100(entity_ref("urn:test:s1362:t5#c"), @2024-03-01) { origin case_input; }
    }
    // Not a small business corporation on the election date -> POWER_INVALID_EXERCISE, no s_election_made_validly effect.
    evaluate truth(s_election_made_validly(entity_ref("urn:test:s1362:t5#c"), entity_ref("urn:test:s1362:t5#e"), @2024-03-01));
    expect truth_status == FALSE_ONLY;
}
