// S corporations WIRE-10 (group C): section 1363(d)(2)(B) due date from returns section 6072.
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

test "W10C-SCO-01-STATUTORY-DUE-DATE-FROM-RETURNS-IS-THE-LIFO-INSTALLMENT-DUE-DATE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.returns::statutory_due_date(entity_ref("urn:test:w10c:s1#c"), entity_ref("urn:test:w10c:s1#y"), us.irc.core::IncomeCh1, @2025-04-15) { origin case_input; }
    }
    evaluate truth(return_due_date_without_extensions(entity_ref("urn:test:w10c:s1#c"), entity_ref("urn:test:w10c:s1#y"), @2025-04-15));
    expect truth_status == TRUE_ONLY;
}

test "W10C-SCO-02-A-DUE-DATE-OF-ANOTHER-TAX-KIND-IS-NOT-USED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.returns::statutory_due_date(entity_ref("urn:test:w10c:s2#c"), entity_ref("urn:test:w10c:s2#y"), us.irc.core::SelfEmploymentCh2, @2025-04-15) { origin case_input; }
    }
    evaluate truth(return_due_date_without_extensions(entity_ref("urn:test:w10c:s2#c"), entity_ref("urn:test:w10c:s2#y"), @2025-04-15));
    expect truth_status == FALSE_ONLY;
}

test "W10C-SCO-03-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": return_due_date_without_extensions(entity_ref("urn:test:w10c:s3#c"), entity_ref("urn:test:w10c:s3#y"), @2025-03-17) { origin case_input; }
    }
    evaluate truth(return_due_date_without_extensions(entity_ref("urn:test:w10c:s3#c"), entity_ref("urn:test:w10c:s3#y"), @2025-03-17));
    expect truth_status == TRUE_ONLY;
}
