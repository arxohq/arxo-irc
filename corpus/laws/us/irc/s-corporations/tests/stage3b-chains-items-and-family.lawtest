test "S1362E2A-ITEMS-01-EACH-ITEM-ASSIGNED-BY-DAILY-PORTIONS-TO-THE-S-SHORT-YEAR" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::begins(entity_ref("urn:test:w1#y"), @2024-01-01) { id "f0"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:test:w1#y"), @2024-12-31) { id "f1"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:test:w1#c"), entity_ref("urn:test:w1#y")) { id "f2"; origin case_input; }
        assert small_business_cessation_date(entity_ref("urn:test:w1#c"), entity_ref("urn:test:w1#e"), @2024-07-01) { id "f3"; origin case_input; }
        assert separately_stated_item(entity_ref("urn:test:w1#i0"), entity_ref("urn:test:w1#c"), entity_ref("urn:test:w1#y"), IncomeItem, 3660.00 USD) { id "f4"; origin case_input; }
        assert separately_stated_item(entity_ref("urn:test:w1#i1"), entity_ref("urn:test:w1#c"), entity_ref("urn:test:w1#y"), LossItem, 732.00 USD) { id "f5"; origin case_input; }
    }
    // 3660 x 182 / 366 = 1820.00.
    evaluate truth(short_year_item_assigned(entity_ref("urn:test:w1#c"), entity_ref("urn:test:w1#e"), entity_ref("urn:test:w1#y"), SShortYear, entity_ref("urn:test:w1#i0"), 1820.00 USD));
    expect truth_status == TRUE_ONLY;
}

