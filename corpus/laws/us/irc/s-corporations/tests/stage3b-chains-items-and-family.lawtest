test "S1368E1CII-01-NET-NEGATIVE-ADJUSTMENT-FROM-ITEMS-IS-DISREGARDED" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::begins(entity_ref("urn:test:m1#y"), @2024-01-01) { id "f0"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:test:m1#y"), @2024-12-31) { id "f1"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:test:m1#c"), entity_ref("urn:test:m1#y")) { id "f2"; origin case_input; }
        assert aaa_opening_balance(entity_ref("urn:test:m1#c"), entity_ref("urn:test:m1#y"), 1000.00 USD) { id "f3"; origin case_input; }
        assert corporation_gross_income(entity_ref("urn:test:m1#c"), entity_ref("urn:test:m1#y"), 200.00 USD) { id "f4"; origin case_input; }
        assert corporation_deductions_excluding_separately_stated(entity_ref("urn:test:m1#c"), entity_ref("urn:test:m1#y"), 100.00 USD) { id "f5"; origin case_input; }
        assert aaa_adjustment_item(entity_ref("urn:test:m1#i0"), entity_ref("urn:test:m1#c"), entity_ref("urn:test:m1#y"), Reduction, 900.00 USD) { id "f6"; origin case_input; }
    }
    // net = 0 - 900 + (200 - 100) = -800: disregarded, only the opening 1000.
    evaluate truth(aaa_available_for_distributions(entity_ref("urn:test:m1#c"), entity_ref("urn:test:m1#y"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

