language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

test "W9-1372B-01-THREE-PERCENT-OF-STOCK-ON-A-DAY-IS-TWO-PERCENT-SHAREHOLDER" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w9s:t1#y"), @2024-01-01) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:w9s:t1#y"), @2024-12-31) { origin case_input; }
        assert "f2": shares_outstanding(entity_ref("urn:test:w9s:t1#c"), @2024-06-01, 100.00) { origin case_input; }
        assert "f3": shares_held(entity_ref("urn:test:w9s:t1#sh"), entity_ref("urn:test:w9s:t1#c"), @2024-06-01, 3.00) { origin case_input; }
    }
    evaluate truth(two_percent_shareholder(entity_ref("urn:test:w9s:t1#sh"), entity_ref("urn:test:w9s:t1#c"), entity_ref("urn:test:w9s:t1#y")));
    expect truth_status == TRUE_ONLY;
}

