// Stage 3b (26.09.2026, DECISION-0379) — four residuals of stage 3, implemented_unverified, NOT executed, no legal review.
//  (1) 1374(d)(6): the chain of substituted-basis assets, unrolled to four hops (TECH-GAPS G5800 closed; G6304 bounded).
//  (2) 1368(e)(1)(C)(ii): the net negative adjustment from ITEMIZED increases and reductions of the AAA (G5801).
//  (3) 1366(a)(1)(A): separately stated items one by one, with credits kept apart (G5802).
//  (4) 1361(c)(1)(B): the derived family feeds the counted shareholder unit (G5803).
//
// JUDGMENT CALLS
//  - A predicate cannot depend on itself (LDC-E4102): the substituted-basis chain is unrolled with the base facts
//    (`asset_basis_determined_by_reference_to` links, `asset_held_at_start_of_first_s_year`) for 2, 3 and 4 hops; a fifth
//    hop is not derived.
//  - AAA items: an increase or a reduction is one asserted item (`aaa_adjustment_item`); the nonseparately computed income or
//    loss counts as one more item (its sign decides its direction). Distributions are not reductions here (the text excludes
//    them). When any item is asserted the itemized computation replaces the stage 3 approximation.
//  - Separately stated items: income items add, loss and deduction items subtract, credit items are kept apart (a credit is
//    not netted into the income bucket); each shareholder's share is the item times the ownership fraction (character is kept
//    per item, section 1366(b)).
//  - Family unit: the common ancestor stands for the family as the counted shareholder unit (the text says the family is treated
//    as one shareholder without naming a representative). A member of two families counts once per common ancestor.

use self::{
    Asset,
    Corporation,
    IRC_S1361_C,
    IRC_S1362_E,
    IRC_S1366_A,
    IRC_S1368_E,
    IRC_S1374_D,
    Individual,
    Person,
    SCorpElection,
    SShortYearKind,
    TaxableYear,
    aaa_available_for_distributions,
    aaa_balance,
    aaa_opening_balance,
    asset_basis_determined_by_reference_to,
    asset_held_at_start_of_first_s_year,
    corporation_deductions_excluding_separately_stated,
    corporation_gross_income,
    counted_shareholder_unit,
    member_of_family,
    pro_rata_allocation_applies,
    pro_rata_share_separately_stated,
    reference_asset_for_built_in_tests,
    shareholder_of,
    shareholder_ownership_fraction,
    short_year_separately_stated_items,
    termination_short_year_days,
    termination_year_days,
    treated_as_held_at_start_of_first_s_year,
};

// ---------------------------------------------------------------------------
// (1) 1374(d)(6): substituted-basis chain, hops 2 to 4
// ---------------------------------------------------------------------------
@source(IRC_S1374_D, coverage = partial, quote = "such asset shall be treated as held by the S corporation as of the beginning of such 1st taxable year")
rule S1374D6ATreatedAsHeldTwoHops strict {
    for c: Corporation; for a: Asset; for o1: Asset; for o2: Asset;
    when asset_basis_determined_by_reference_to(a, o1);
    when asset_basis_determined_by_reference_to(o1, o2);
    when asset_held_at_start_of_first_s_year(c, o2);
    then treated_as_held_at_start_of_first_s_year(c, a);
}
rule S1374D6ATreatedAsHeldThreeHops strict {
    for c: Corporation; for a: Asset; for o1: Asset; for o2: Asset; for o3: Asset;
    when asset_basis_determined_by_reference_to(a, o1);
    when asset_basis_determined_by_reference_to(o1, o2);
    when asset_basis_determined_by_reference_to(o2, o3);
    when asset_held_at_start_of_first_s_year(c, o3);
    then treated_as_held_at_start_of_first_s_year(c, a);
}
rule S1374D6ATreatedAsHeldFourHops strict {
    for c: Corporation; for a: Asset; for o1: Asset; for o2: Asset; for o3: Asset; for o4: Asset;
    when asset_basis_determined_by_reference_to(a, o1);
    when asset_basis_determined_by_reference_to(o1, o2);
    when asset_basis_determined_by_reference_to(o2, o3);
    when asset_basis_determined_by_reference_to(o3, o4);
    when asset_held_at_start_of_first_s_year(c, o4);
    then treated_as_held_at_start_of_first_s_year(c, a);
}
@source(IRC_S1374_D, coverage = partial, quote = "any determination under paragraph (3)(B) or (4)(B) with respect to such asset shall be made by reference to the fair market value and adjusted basis of such other asset as of the beginning of such 1st taxable year")
rule S1374D6BReferenceAssetTwoHops strict {
    for c: Corporation; for a: Asset; for o1: Asset; for o2: Asset;
    when asset_basis_determined_by_reference_to(a, o1);
    when asset_basis_determined_by_reference_to(o1, o2);
    when asset_held_at_start_of_first_s_year(c, o2);
    then reference_asset_for_built_in_tests(c, a, o2);
}
rule S1374D6BReferenceAssetThreeHops strict {
    for c: Corporation; for a: Asset; for o1: Asset; for o2: Asset; for o3: Asset;
    when asset_basis_determined_by_reference_to(a, o1);
    when asset_basis_determined_by_reference_to(o1, o2);
    when asset_basis_determined_by_reference_to(o2, o3);
    when asset_held_at_start_of_first_s_year(c, o3);
    then reference_asset_for_built_in_tests(c, a, o3);
}
rule S1374D6BReferenceAssetFourHops strict {
    for c: Corporation; for a: Asset; for o1: Asset; for o2: Asset; for o3: Asset; for o4: Asset;
    when asset_basis_determined_by_reference_to(a, o1);
    when asset_basis_determined_by_reference_to(o1, o2);
    when asset_basis_determined_by_reference_to(o2, o3);
    when asset_basis_determined_by_reference_to(o3, o4);
    when asset_held_at_start_of_first_s_year(c, o4);
    then reference_asset_for_built_in_tests(c, a, o4);
}

// ---------------------------------------------------------------------------
// (2) 1368(e)(1)(C)(ii): the net negative adjustment, itemized
// ---------------------------------------------------------------------------
pub entity AaaItem { label en unofficial "one adjustment of the accumulated adjustments account for a taxable year"; }
pub enum AaaDirection { Increase; Reduction; label en unofficial "an increase or a reduction (other than for distributions) of the account"; }
pub relation aaa_adjustment_item(i: AaaItem, c: Corporation, y: TaxableYear, d: AaaDirection, amount: Money) kind empirical {
    label en official "an adjustment of the accumulated adjustments account for the year: a separately stated income item (increase), a separately stated loss or deduction, a nondeductible noncapital expense, or Federal taxes attributable to C years (reductions); the amount is positive";
}
relation aaa_items_stated(c: Corporation, y: TaxableYear) kind institutional { label en unofficial "helper: an itemized AAA adjustment is asserted for the year"; }
rule S1368E1CItemsStated strict { for i: AaaItem; for c: Corporation; for y: TaxableYear; for d: AaaDirection; for a: Money; when aaa_adjustment_item(i, c, y, d, a); then aaa_items_stated(c, y); }
relation aaa_increase_item_present(c: Corporation, y: TaxableYear) kind institutional { label en unofficial "helper: an increase item is asserted"; }
rule S1368E1CIncreasePresent strict { for i: AaaItem; for c: Corporation; for y: TaxableYear; for a: Money; when aaa_adjustment_item(i, c, y, Increase, a); then aaa_increase_item_present(c, y); }
relation aaa_reduction_item_present(c: Corporation, y: TaxableYear) kind institutional { label en unofficial "helper: a reduction item is asserted"; }
rule S1368E1CReductionPresent strict { for i: AaaItem; for c: Corporation; for y: TaxableYear; for a: Money; when aaa_adjustment_item(i, c, y, Reduction, a); then aaa_reduction_item_present(c, y); }
relation aaa_item_increases_total(c: Corporation, y: TaxableYear, total: Money) kind institutional { label en official "the sum of the increase items of the year"; }
rule S1368E1CIncreasesSum strict {
    for c: Corporation; for y: TaxableYear; for i: AaaItem; for a: Money;
    when aaa_adjustment_item(i, c, y, Increase, a);
    then aaa_item_increases_total(c, y, sum all x: Money for j: AaaItem where aaa_adjustment_item(j, c, y, Increase, x));
}
rule S1368E1CIncreasesNone strict { for c: Corporation; for y: TaxableYear; for i: AaaItem; for d: AaaDirection; for a: Money; when aaa_adjustment_item(i, c, y, d, a) and not_known(aaa_increase_item_present(c, y)); then aaa_item_increases_total(c, y, 0.00 USD); }
relation aaa_item_reductions_total(c: Corporation, y: TaxableYear, total: Money) kind institutional { label en official "the sum of the reduction items of the year"; }
rule S1368E1CReductionsSum strict {
    for c: Corporation; for y: TaxableYear; for i: AaaItem; for a: Money;
    when aaa_adjustment_item(i, c, y, Reduction, a);
    then aaa_item_reductions_total(c, y, sum all x: Money for j: AaaItem where aaa_adjustment_item(j, c, y, Reduction, x));
}
rule S1368E1CReductionsNone strict { for c: Corporation; for y: TaxableYear; for i: AaaItem; for d: AaaDirection; for a: Money; when aaa_adjustment_item(i, c, y, d, a) and not_known(aaa_reduction_item_present(c, y)); then aaa_item_reductions_total(c, y, 0.00 USD); }
pub relation aaa_net_adjustment_itemized(c: Corporation, y: TaxableYear, net: Money) kind institutional { label en official "increases (the items and the nonseparately computed income or loss) less reductions for the year"; }
rule S1368E1CNetAdjustmentItemized strict {
    for c: Corporation; for y: TaxableYear; for inc: Money; for red: Money; for gi: Money; for ded: Money;
    when aaa_items_stated(c, y) and aaa_item_increases_total(c, y, inc) and aaa_item_reductions_total(c, y, red) and corporation_gross_income(c, y, gi) and corporation_deductions_excluding_separately_stated(c, y, ded);
    then aaa_net_adjustment_itemized(c, y, inc - red + (gi - ded));
}
pub relation aaa_net_negative_adjustment(c: Corporation, y: TaxableYear, amount: Money) kind institutional { label en official "the excess of the reductions in the account for the taxable year (other than for distributions) over the increases"; }
@source(IRC_S1368_E, coverage = partial, quote = "the reductions in the account for the taxable year (other than for distributions), over")
rule S1368E1CNetNegativeAdjustmentItemized strict {
    for c: Corporation; for y: TaxableYear; for net: Money;
    when aaa_net_adjustment_itemized(c, y, net) and net < 0.00 USD;
    then aaa_net_negative_adjustment(c, y, 0.00 USD - net);
}
relation aaa_available_itemized(c: Corporation, y: TaxableYear, amount: Money) kind institutional { label en official "the AAA for the year's distributions from itemized adjustments: a net positive adjustment counts, a net negative one is disregarded"; }
rule S1368E1CAvailablePositiveItemized strict {
    for c: Corporation; for y: TaxableYear; for opening: Money; for net: Money;
    when aaa_opening_balance(c, y, opening) and aaa_net_adjustment_itemized(c, y, net) and net >= 0.00 USD;
    then aaa_available_itemized(c, y, opening + net);
}
rule S1368E1CAvailableNegativeItemized strict {
    for c: Corporation; for y: TaxableYear; for opening: Money; for net: Money;
    when aaa_opening_balance(c, y, opening) and aaa_net_adjustment_itemized(c, y, net) and net < 0.00 USD;
    then aaa_available_itemized(c, y, opening);
}
rule S1368E1CItemizedAvailableIsTheAccount defeasible {
    for c: Corporation; for y: TaxableYear; for a: Money;
    when aaa_available_itemized(c, y, a);
    then aaa_available_for_distributions(c, y, a);
}
rule S1368E1CItemizedBalance strict {
    for c: Corporation; for y: TaxableYear; for opening: Money; for net: Money;
    when aaa_opening_balance(c, y, opening) and aaa_net_adjustment_itemized(c, y, net);
    then aaa_balance(c, y, opening + net);
}

// ---------------------------------------------------------------------------
// (3) 1366(a)(1)(A): separately stated items, one by one
// ---------------------------------------------------------------------------
pub entity SeparatelyStatedItem { label en unofficial "one item of income, loss, deduction, or credit the separate treatment of which could affect the liability for tax of any shareholder"; }
pub enum SeparatelyStatedNature { IncomeItem; LossItem; DeductionItem; CreditItem; label en unofficial "the nature of a separately stated item (section 1366(a)(1)(A))"; }
pub relation separately_stated_item(i: SeparatelyStatedItem, c: Corporation, y: TaxableYear, n: SeparatelyStatedNature, amount: Money) kind empirical {
    label en official "an item of income, loss, deduction, or credit the separate treatment of which could affect the liability for tax of any shareholder; the amount is positive";
}
relation separately_stated_items_itemized(c: Corporation, y: TaxableYear) kind institutional { label en unofficial "helper: separately stated items are asserted one by one for the year"; }
rule S1366A1AItemized strict { for i: SeparatelyStatedItem; for c: Corporation; for y: TaxableYear; for n: SeparatelyStatedNature; for a: Money; when separately_stated_item(i, c, y, n, a); then separately_stated_items_itemized(c, y); }
relation separately_stated_income_present(c: Corporation, y: TaxableYear) kind institutional { label en unofficial "helper: an income item is asserted"; }
rule S1366A1AIncomePresent strict { for i: SeparatelyStatedItem; for c: Corporation; for y: TaxableYear; for a: Money; when separately_stated_item(i, c, y, IncomeItem, a); then separately_stated_income_present(c, y); }
relation separately_stated_income_total(c: Corporation, y: TaxableYear, total: Money) kind institutional { label en official "the sum of the separately stated income items"; }
rule S1366A1AIncomeSum strict {
    for c: Corporation; for y: TaxableYear; for i: SeparatelyStatedItem; for a: Money;
    when separately_stated_item(i, c, y, IncomeItem, a);
    then separately_stated_income_total(c, y, sum all x: Money for j: SeparatelyStatedItem where separately_stated_item(j, c, y, IncomeItem, x));
}
rule S1366A1AIncomeNone strict { for c: Corporation; for y: TaxableYear; for i: SeparatelyStatedItem; for n: SeparatelyStatedNature; for a: Money; when separately_stated_item(i, c, y, n, a) and not_known(separately_stated_income_present(c, y)); then separately_stated_income_total(c, y, 0.00 USD); }
relation separately_stated_loss_present(c: Corporation, y: TaxableYear) kind institutional { label en unofficial "helper: a loss or deduction item is asserted"; }
rule S1366A1ALossPresent strict { for i: SeparatelyStatedItem; for c: Corporation; for y: TaxableYear; for a: Money; when separately_stated_item(i, c, y, LossItem, a); then separately_stated_loss_present(c, y); }
rule S1366A1ADeductionPresent strict { for i: SeparatelyStatedItem; for c: Corporation; for y: TaxableYear; for a: Money; when separately_stated_item(i, c, y, DeductionItem, a); then separately_stated_loss_present(c, y); }
relation separately_stated_loss_total(c: Corporation, y: TaxableYear, total: Money) kind institutional { label en official "the sum of the separately stated loss and deduction items"; }
rule S1366A1ALossSum strict {
    for c: Corporation; for y: TaxableYear; for i: SeparatelyStatedItem; for a: Money;
    when separately_stated_item(i, c, y, LossItem, a);
    then separately_stated_loss_total(c, y, sum all x: Money for j: SeparatelyStatedItem where separately_stated_item(j, c, y, LossItem, x) or separately_stated_item(j, c, y, DeductionItem, x));
}
rule S1366A1ADeductionSum strict {
    for c: Corporation; for y: TaxableYear; for i: SeparatelyStatedItem; for a: Money;
    when separately_stated_item(i, c, y, DeductionItem, a);
    then separately_stated_loss_total(c, y, sum all x: Money for j: SeparatelyStatedItem where separately_stated_item(j, c, y, LossItem, x) or separately_stated_item(j, c, y, DeductionItem, x));
}
rule S1366A1ALossNone strict { for c: Corporation; for y: TaxableYear; for i: SeparatelyStatedItem; for n: SeparatelyStatedNature; for a: Money; when separately_stated_item(i, c, y, n, a) and not_known(separately_stated_loss_present(c, y)); then separately_stated_loss_total(c, y, 0.00 USD); }
pub relation separately_stated_items_net_itemized(c: Corporation, y: TaxableYear, net: Money) kind institutional { label en official "the net of the separately stated income, loss and deduction items (credits are kept apart)"; }
rule S1366A1ANetItemized strict {
    for c: Corporation; for y: TaxableYear; for inc: Money; for loss: Money;
    when separately_stated_items_itemized(c, y) and separately_stated_income_total(c, y, inc) and separately_stated_loss_total(c, y, loss);
    then separately_stated_items_net_itemized(c, y, inc - loss);
}
@source(IRC_S1366_A, quote = "there shall be taken into account the shareholder's pro rata share")
rule S1366A1AShareOfItemizedItems strict {
    for sh: Person; for c: Corporation; for y: TaxableYear; for net: Money; for fraction: Decimal;
    when separately_stated_items_net_itemized(c, y, net) and shareholder_ownership_fraction(sh, c, y, fraction);
    then pro_rata_share_separately_stated(sh, c, y, net * fraction);
}
pub relation pro_rata_share_of_item(sh: Person, i: SeparatelyStatedItem, amount: Money) kind institutional { label en official "the shareholder's pro rata share of one separately stated item (each item keeps its own character, section 1366(b))"; }
rule S1366A1AShareOfOneItem strict {
    for sh: Person; for i: SeparatelyStatedItem; for c: Corporation; for y: TaxableYear; for n: SeparatelyStatedNature; for a: Money; for fraction: Decimal;
    when separately_stated_item(i, c, y, n, a) and shareholder_ownership_fraction(sh, c, y, fraction);
    then pro_rata_share_of_item(sh, i, a * fraction);
}
pub relation separately_stated_credits_total(c: Corporation, y: TaxableYear, total: Money) kind institutional { label en official "the sum of the separately stated credit items"; }
rule S1366A1ACreditsSum strict {
    for c: Corporation; for y: TaxableYear; for i: SeparatelyStatedItem; for a: Money;
    when separately_stated_item(i, c, y, CreditItem, a);
    then separately_stated_credits_total(c, y, sum all x: Money for j: SeparatelyStatedItem where separately_stated_item(j, c, y, CreditItem, x));
}
pub relation pro_rata_share_of_credits(sh: Person, c: Corporation, y: TaxableYear, amount: Money) kind institutional { label en official "the shareholder's pro rata share of the separately stated credit items (kept apart from the income bucket)"; }
rule S1366A1AShareOfCredits strict {
    for sh: Person; for c: Corporation; for y: TaxableYear; for total: Money; for fraction: Decimal;
    when separately_stated_credits_total(c, y, total) and shareholder_ownership_fraction(sh, c, y, fraction);
    then pro_rata_share_of_credits(sh, c, y, total * fraction);
}

// ---------------------------------------------------------------------------
// (4) 1361(c)(1)(B): the derived family is one counted shareholder unit
// ---------------------------------------------------------------------------
relation family_member_shareholder_derived(sh: Person, c: Corporation, on: Date) kind institutional { label en unofficial "helper: the shareholder is a member of a derived family of a common ancestor"; }
rule S1361C1BShareholderIsDerivedFamilyMember strict {
    for ind: Individual; for a: Individual; for c: Corporation; for on: Date;
    when shareholder_of(ind, c, on) and member_of_family(ind, a, c);
    then family_member_shareholder_derived(ind, c, on);
}
@source(IRC_S1361_C, quote = "there shall be treated as one shareholder")
rule S1361C1BDerivedFamilyIsOneCountedUnit strict {
    for ind: Individual; for a: Individual; for c: Corporation; for on: Date;
    when shareholder_of(ind, c, on) and member_of_family(ind, a, c);
    then counted_shareholder_unit(a, c, on);
}

// 1362(e)(2)(A)(i), (B): the itemized items are assigned to a short year by equal daily portions, item by item.
pub relation short_year_item_assigned(c: Corporation, e: SCorpElection, y: TaxableYear, k: SShortYearKind, i: SeparatelyStatedItem, amount: Money) kind institutional {
    label en official "the amount of one separately stated item assigned to a short year of the S termination year: an equal portion to each day, summed over the days of the short year";
}
@source(IRC_S1362_E, coverage = partial, quote = "the amount of each of the items of income, loss, deduction, or credit described in section 1366(a)(1)(A)")
rule S1362E2BAssignEachSeparatelyStatedItem defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for k: SShortYearKind; for i: SeparatelyStatedItem; for n: SeparatelyStatedNature; for a: Money; for yd: Integer; for sd: Integer;
    when pro_rata_allocation_applies(c, e, y) and separately_stated_item(i, c, y, n, a) and termination_year_days(c, e, y, yd) and termination_short_year_days(c, e, y, k, sd);
    then short_year_item_assigned(c, e, y, k, i, div_round(a * sd, yd * 1.0, 2, "HALF_UP"));
}
rule S1362E2BAssignItemizedNet defeasible {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for k: SShortYearKind; for net: Money; for yd: Integer; for sd: Integer;
    when pro_rata_allocation_applies(c, e, y) and separately_stated_items_net_itemized(c, y, net) and termination_year_days(c, e, y, yd) and termination_short_year_days(c, e, y, k, sd);
    then short_year_separately_stated_items(c, e, y, k, div_round(net * sd, yd * 1.0, 2, "HALF_UP"));
}
