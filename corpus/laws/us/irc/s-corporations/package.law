// 26 U.S.C. Subchapter S of Chapter 1 — S Corporations: package skeleton. The text is pinned whole
// (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package s-corporations` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
//
// STAGE IRC-08 (this change): the whole Subchapter S spine — sections 1361,
// 1362, 1363, 1366, 1367, 1368, 1371, 1372, 1373, 1374, 1375, 1377, 1378
// (1379 is transitional-only, 1982 enactment; no executable module, see the
// coverage row note). See docs/foundations/us-irc/TASKS.json IRC-08 and
// DECISION-0379.
//
// MODULE MAP
//   package.law           — this file: header, imports, type aliases
//   01-ontology.law        — shared shapes: shareholder roster, stock,
//                            elections, taxes (§§1361-1379 all read these)
//   02-eligibility.law      — §1361: S corporation / small business
//                            corporation, ineligible corporation, permitted
//                            shareholders, one class of stock, QSSS, QSST,
//                            ESBT
//   03-election.law         — §1362: election power, timing, termination
//                            (revocation, cessation, 3-year passive-income
//                            rule), S termination year, inadvertent-
//                            termination relief, 5-year bar
//   04-effect.law           — §1363: no corporate-level tax except
//                            §§1374/1375, computation modifications,
//                            corporate-level elections, LIFO recapture
//   05-pass-through.law     — §1366 pass-thru and loss limitation, §1377(a)
//                            per-share-per-day pro rata share
//   06-basis.law            — §1367 stock/debt basis adjustments
//   07-distributions.law    — §1368 distributions (AAA / AE&P / basis tiers)
//   08-coordination.law     — §1371 coordination with subchapter C, §1372
//                            fringe-benefit partnership rule, §1373 foreign
//                            income partnership rule
//   09-taxes.law            — §1374 built-in gains tax, §1375 excess net
//                            passive income tax
//   10-year.law             — §1378 taxable year (permitted year)
//
// SHARED SIMPLIFICATION (recorded once for the whole package): the
// shareholder roster (who holds stock in a corporation, how many shares, on
// which day, family grouping for the §1361(c)(1) one-shareholder rule,
// consent to an election or revocation) is CASE-ASSERTED empirical practice,
// not derived from a corporate-law formation record this title does not
// itself define. Deriving stock ownership from an underlying instrument is
// outside Title 26; every owner package in this corpus that reads
// `us.irc.core::ownership_interest` does the same (see CONTRACT.md).

language "law.core" version "0.2";
package us.irc.s_corporations version "0.1.1";
namespace "urn:us:irc:s_corporations:clir";

import us.irc.core version "0.1.1";
import us.irc.definitions version "0.1.1";
import us.irc.corporations version "0.1.1";
import us.irc.international version "0.1.1";

// One alias per package (LDC-E1201), declared once here for all modules.
type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type Estate = us.irc.core::Estate;
type Trust = us.irc.core::Trust;
type TaxableYear = us.irc.core::TaxableYear;
type Election = us.irc.core::Election;
type OwnershipInterest = us.irc.core::OwnershipInterest;
type Carryover = us.irc.core::Carryover;
type Asset = us.irc.core::Asset;

const Secretary: us.irc.core::Organ = us.irc.core::Secretary;
