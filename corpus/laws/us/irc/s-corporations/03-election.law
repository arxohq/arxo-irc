// Section 1362 — Election; revocation; termination.
//
// SCOPE: (a) the election power with all-shareholder consent; (b) timing
// ((b)(1)-(2) same-year/next-year branch, (b)(3) late-election-for-next-year,
// (b)(5) inadvertent-late-election relief as a power); (c) years for which
// effective; (d) termination — revocation (>50% of shares, effective-date
// branches (d)(1)(C)-(D)), automatic cessation (d)(2), the 3-consecutive-
// year passive-income rule (d)(3); (e) S termination year pro rata vs
// closing-of-books election; (f) inadvertent termination relief power;
// (g) the 5-year re-election bar.
//
// s_corporation(c, y) (declared in 02-eligibility.law) is concluded here:
// an election is EFFECTIVE for a taxable year when it was validly made and
// timed for that year AND has not been terminated as of that year, AND the
// corporation still is a small business corporation for that year (the
// (d)(2) automatic-cessation condition folds directly into the same head,
// since a cessation IS the absence of small_business_corporation).

// --- (a): the election power ----------------------------------------------

use self::{
    Corporation,
    IRC_S1362_A,
    IRC_S1362_B,
    IRC_S1362_C,
    IRC_S1362_D,
    IRC_S1362_F,
    IRC_S1362_G,
    Person,
    SCorpElection,
    Secretary,
    TaxableYear,
    counted_shareholder_unit,
    s_corporation,
    shareholder_consents_to_election,
    shareholder_consents_to_revocation,
    shareholder_of_any,
    shares_held,
    shares_outstanding,
    small_business_corporation,
};

pub relation elects_s_status(c: Corporation, e: SCorpElection, on: Date) kind empirical {
    label en official "the corporation elects, in accordance with section 1362, to be an S corporation (section 1362(a)(1))";
}
pub relation s_election_valid_consent(c: Corporation, e: SCorpElection, on: Date) kind institutional {
    label en official "all persons who are shareholders on the day the election is made consent to the election (section 1362(a)(2))";
}
@source(IRC_S1362_A, quote = "shall be valid only if all persons who are shareholders in such corporation on the day on which such election is made consent to such election")
rule S1362AAllShareholdersConsented strict {
    label en official "the election is validly consented to only if every counted shareholder unit on the election date consented (section 1362(a)(2))";
    for c: Corporation; for e: SCorpElection; for on: Date;
    when elects_s_status(c, e, on);
    when shareholder_of_any(c, on);
    when count(collect u: Person where counted_shareholder_unit(u, c, on)) ==
         count(collect u: Person where counted_shareholder_unit(u, c, on) and shareholder_consents_to_election(u, c, e, on));
    then s_election_valid_consent(c, e, on);
}
pub relation s_election_valid_when_made(c: Corporation, e: SCorpElection, on: Date) kind institutional {
    label en official "the election meets section 1362(a): the corporation is a small business corporation and all shareholders consented, on the date made";
}
rule S1362AElectionValidWhenMade strict {
    for c: Corporation; for e: SCorpElection; for on: Date;
    when small_business_corporation(c, on);
    when s_election_valid_consent(c, e, on);
    then s_election_valid_when_made(c, e, on);
}
@source(IRC_S1362_A, quote = "a small business corporation may elect, in accordance with the provisions of this section, to be an S corporation")
rule S1362AElectionPower strict {
    label en official "a small business corporation may elect to be an S corporation with all shareholders' consent (section 1362(a))";
    for c: Corporation; for e: SCorpElection; for on: Date;
    when elects_s_status(c, e, on);
    then power S1362ElectionPower {
        holder c;
        over e;
        exercise elects_s_status(c, e, on);
        valid_when s_election_valid_when_made(c, e, on);
        effect create(s_election_made_validly(c, e, on));
        window [@1958-01-01, infinity);
    };
}
pub relation s_election_made_validly(c: Corporation, e: SCorpElection, on: Date) kind institutional {
    label en official "a validly exercised section 1362(a) election";
}

// --- (b): timing ------------------------------------------------------

// The 15th day of the 3rd month of a taxable year beginning on d0: the first
// day of the 3rd month is 2 months after d0 (d0 itself being the 1st day of
// the 1st month), and its 15th day is 14 days after that first day.
pub relation s1362b_deadline(y: TaxableYear, d: Date) kind institutional {
    label en official "the 15th day of the 3rd month of taxable year y (section 1362(b)(1)(B))";
}
rule S1362BDeadlineComputation strict {
    for y: TaxableYear; for d0: Date;
    when us.irc.core::begins(y, d0);
    then s1362b_deadline(y, add_calendar_period(add_calendar_period(d0, 2 calendar_month), 14 calendar_day));
}

@source(IRC_S1362_B, quote = "at any time during the preceding taxable year, or")
pub relation s_election_made_in_preceding_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the election was made at any time during the taxable year preceding y (section 1362(b)(1)(A))";
}
@source(IRC_S1362_B, quote = "at any time during the taxable year and on or before the 15th day of the 3d month of the taxable year")
pub relation s_election_made_timely_in_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the election was made during taxable year y, on or before the section 1362(b) deadline (section 1362(b)(1)(B))";
}
rule S1362BElectionMadeTimelyInYear strict {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for on: Date; for deadline: Date; for begin: Date; for end: Date;
    when s_election_made_validly(c, e, on);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, end);
    when on >= begin;
    when on <= end;
    when s1362b_deadline(y, deadline);
    when on <= deadline;
    then s_election_made_timely_in_year(c, e, y);
}

@source(IRC_S1362_B, quote = "1 or more days in such taxable year before the day on which the election was made the corporation did not meet the requirements of subsection (b) of section 1361")
pub relation s1362b2_disqualified_before_election(c: Corporation, e: SCorpElection, y: TaxableYear) kind empirical {
    label en official "on one or more days in y before the election was made, c did not meet section 1361(b) or a shareholder who held stock before the election did not consent (section 1362(b)(2)(B)); case-asserted (a day-by-day scan of the whole pre-election period is not re-derived here — TECH-GAPS.md G46)";
}
pub relation s_election_effective_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the taxable year for which the election under section 1362(a) is treated as made";
}
@source(IRC_S1362_B, quote = "then such election shall be treated as made for the following taxable year")
rule S1362B2TreatedAsNextYear defeasible {
    label en official "a timely election is nonetheless treated as made for the FOLLOWING year if the corporation was disqualified or a pre-election shareholder did not consent (section 1362(b)(2))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for nextY: TaxableYear;
    when s_election_made_timely_in_year(c, e, y);
    when s1362b2_disqualified_before_election(c, e, y);
    when next_taxable_year(y, nextY);
    then s_election_effective_year(c, e, nextY);
}
@source(IRC_S1362_B, quote = "at any time during the preceding taxable year, or")
rule S1362B1ElectionEffectiveSameYear defeasible {
    label en official "an election made in the preceding year, or timely in the year and not caught by (b)(2), is effective for that year (section 1362(b)(1))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear;
    when s_election_made_timely_in_year(c, e, y);
    unless s1362b2_disqualified_before_election(c, e, y);
    then s_election_effective_year(c, e, y);
}
rule S1362B1ElectionEffectiveFromPrecedingYear strict {
    for c: Corporation; for e: SCorpElection; for y: TaxableYear;
    when s_election_made_in_preceding_year(c, e, y);
    then s_election_effective_year(c, e, y);
}
// `next_taxable_year` is the successor-year lookup this package needs for
// (b)(2)/(b)(3)/(d)(1)(C)(ii); no `us.irc.core` primitive computes "the
// taxable year after y" from `y` alone (same gap class as accounting's
// TECH-GAPS.md G10 "successor year"). This package takes the successor as a
// case-asserted fact rather than inventing a derivation.
pub relation next_taxable_year(y: TaxableYear, next: TaxableYear) kind empirical {
    label en unofficial "next is the taxable year immediately following y; case-asserted (TECH-GAPS.md G46, same class as G10)";
}

@source(IRC_S1362_B, quote = "such election is made after the 15th day of the 3d month of the taxable year and on or before the 15th day of the 3rd month of the following taxable year")
pub relation s_election_made_late_for_next_year(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the election was made after y's deadline but on or before the following year's deadline (section 1362(b)(3))";
}
rule S1362B3LateElectionTreatedAsNextYear strict {
    label en official "a late election within the following year's own deadline is treated as made for the following year (section 1362(b)(3))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for on: Date; for deadline: Date; for nextY: TaxableYear; for nextDeadline: Date;
    when s_election_made_validly(c, e, on);
    when s1362b_deadline(y, deadline);
    when on > deadline;
    when next_taxable_year(y, nextY);
    when s1362b_deadline(nextY, nextDeadline);
    when on <= nextDeadline;
    then s_election_effective_year(c, e, nextY);
}

// (b)(5): inadvertent late-election relief, as the Secretary's power.
external judgment relation reasonable_cause_for_late_election(c: Corporation, e: SCorpElection, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary determines that there was reasonable cause for the failure to timely make the election (section 1362(b)(5))";
}
pub relation secretary_grants_late_election_relief(c: Corporation, e: SCorpElection, y: TaxableYear, on: Date) kind empirical {
    label en official "the Secretary treats the election as timely made for y under section 1362(b)(5)";
}
@source(IRC_S1362_B, quote = "the Secretary may treat such an election as timely made for such taxable year")
rule S1362B5GrantsLateElectionRelief strict {
    label en official "the Secretary may treat an untimely election as timely made for y upon reasonable cause (section 1362(b)(5)); paragraph (3) does not then apply";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for on: Date;
    when secretary_grants_late_election_relief(c, e, y, on);
    then power S1362B5LateElectionReliefPower {
        holder Secretary;
        over e;
        exercise secretary_grants_late_election_relief(c, e, y, on);
        valid_when reasonable_cause_for_late_election(c, e, y);
        effect create(s_election_effective_year(c, e, y));
        window [@1958-01-01, infinity);
    };
}

// --- (c): years for which effective ---------------------------------------

pub relation s_election_terminated_as_of(c: Corporation, e: SCorpElection, y: TaxableYear) kind institutional {
    label en official "the election has been terminated under section 1362(d), effective as of taxable year y (or a date within it)";
}
@source(IRC_S1362_C, quote = "shall be effective for the taxable year of the corporation for which it is made and for all succeeding taxable years of the corporation, until such election is terminated under subsection (d)")
rule S1362CElectionInEffectAndSCorporationStatus defeasible {
    label en official "the election is effective for the year for which made and all succeeding years, until terminated under (d); s_corporation(c,y) is the norm's own conclusion (section 1362(c), section 1361(a)(1))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for d0: Date;
    when s_election_effective_year(c, e, y);
    when us.irc.core::begins(y, d0);
    when small_business_corporation(c, d0);
    unless s_election_terminated_as_of(c, e, y);
    then s_corporation(c, y);
}
// The status is tested on the first day of y (`begins(y, d0)`) as this
// rule's own evaluation point, matching (d)(2)'s "ceases to be a small
// business corporation" test being continuous rather than filing-date-only;
// a change of status mid-year is carried by `s_election_terminated_as_of`
// (see the (d)(2) rule below), not by re-testing at the year's end here.

// --- (d)(1): termination by revocation -------------------------------

pub relation revocation_consent_fraction(c: Corporation, on: Date, fraction: Decimal) kind institutional {
    label en official "the fraction of outstanding shares whose holders consented to a revocation on date on (section 1362(d)(1)(B))";
}
rule RevocationConsentFraction strict {
    for c: Corporation; for on: Date; for total: Decimal;
    when shares_outstanding(c, on, total);
    when total > 0.00;
    then revocation_consent_fraction(c, on, div_round(
        sum all n: Decimal for sh: Person where shareholder_consents_to_revocation(sh, c, on) and shares_held(sh, c, on, n),
        total, 6, "HALF_UP"));
}
pub relation revocation_majority_consent(c: Corporation, on: Date) kind institutional {
    label en official "shareholders holding more than one-half of the shares consented to the revocation on date on (section 1362(d)(1)(B))";
}
@source(IRC_S1362_D, quote = "shareholders holding more than one-half of the shares of stock of the corporation on the day on which the revocation is made consent to the revocation")
rule RevocationMajorityConsent strict {
    for c: Corporation; for on: Date; for fraction: Decimal;
    when revocation_consent_fraction(c, on, fraction);
    when fraction > 0.50;
    then revocation_majority_consent(c, on);
}

pub relation revokes_s_election(c: Corporation, e: SCorpElection, on: Date) kind empirical {
    label en official "the corporation revokes its section 1362(a) election (section 1362(d)(1)(A))";
}
pub relation revocation_specifies_future_date(c: Corporation, e: SCorpElection, on: Date, specified: Date) kind empirical {
    label en official "the revocation specifies a date for revocation on or after the day the revocation is made (section 1362(d)(1)(D))";
}
pub relation revocation_effective_date(c: Corporation, e: SCorpElection, on: Date, effDate: Date) kind institutional {
    label en official "the date a revocation becomes effective under section 1362(d)(1)(C)-(D)";
}
@source(IRC_S1362_D, quote = "the revocation shall be effective on and after the date so specified")
rule RevocationEffectiveDateSpecified strict {
    label en official "a specified future effective date controls (section 1362(d)(1)(D))";
    for c: Corporation; for e: SCorpElection; for on: Date; for specified: Date;
    when revocation_specifies_future_date(c, e, on, specified);
    then revocation_effective_date(c, e, on, specified);
}
pub relation revocation_effective_date_overridden(c: Corporation, e: SCorpElection, on: Date, defaultDate: Date) kind institutional {
    label en official "a section 1362(d)(1)(D) specified future date exists, overriding the (d)(1)(C) default of defaultDate";
}
rule RevocationEffectiveDateOverridesFirstDayOfYear strict {
    for c: Corporation; for e: SCorpElection; for on: Date; for specified: Date; for y: TaxableYear; for begin: Date; for end: Date;
    when revocation_specifies_future_date(c, e, on, specified);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, end);
    when on >= begin;
    when on <= end;
    then revocation_effective_date_overridden(c, e, on, begin);
}
@source(IRC_S1362_D, quote = "a revocation made during the taxable year and on or before the 15th day of the 3d month thereof shall be effective on the 1st day of such taxable year")
rule RevocationEffectiveFirstDayOfYear defeasible {
    label en official "a revocation made on or before the section 1362(b) deadline of its own taxable year is effective on the 1st day of that year, absent a specified future date (section 1362(d)(1)(C)(i))";
    for c: Corporation; for e: SCorpElection; for on: Date; for y: TaxableYear; for begin: Date; for end: Date; for deadline: Date;
    when revokes_s_election(c, e, on);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, end);
    when on >= begin;
    when on <= end;
    when s1362b_deadline(y, deadline);
    when on <= deadline;
    unless revocation_effective_date_overridden(c, e, on, begin);
    then revocation_effective_date(c, e, on, begin);
}
rule RevocationEffectiveDateOverridesFirstDayOfNextYear strict {
    for c: Corporation; for e: SCorpElection; for on: Date; for specified: Date; for y: TaxableYear; for deadline: Date; for nextY: TaxableYear; for nextBegin: Date;
    when revocation_specifies_future_date(c, e, on, specified);
    when s1362b_deadline(y, deadline);
    when on > deadline;
    when next_taxable_year(y, nextY);
    when us.irc.core::begins(nextY, nextBegin);
    then revocation_effective_date_overridden(c, e, on, nextBegin);
}
@source(IRC_S1362_D, quote = "a revocation made during the taxable year but after such 15th day shall be effective on the 1st day of the following taxable year")
rule RevocationEffectiveFirstDayOfNextYear defeasible {
    label en official "a revocation made after the deadline is effective on the 1st day of the FOLLOWING year, absent a specified future date (section 1362(d)(1)(C)(ii))";
    for c: Corporation; for e: SCorpElection; for on: Date; for y: TaxableYear; for begin: Date; for end: Date; for deadline: Date; for nextY: TaxableYear; for nextBegin: Date;
    when revokes_s_election(c, e, on);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, end);
    when on >= begin;
    when on <= end;
    when s1362b_deadline(y, deadline);
    when on > deadline;
    when next_taxable_year(y, nextY);
    when us.irc.core::begins(nextY, nextBegin);
    unless revocation_effective_date_overridden(c, e, on, nextBegin);
    then revocation_effective_date(c, e, on, nextBegin);
}
@source(IRC_S1362_D, quote = "An election under subsection (a) may be terminated by revocation")
rule S1362DRevocationPower strict {
    label en official "an S election may be terminated by revocation with majority-of-shares consent (section 1362(d)(1)(A)-(B))";
    for c: Corporation; for e: SCorpElection; for on: Date;
    when revokes_s_election(c, e, on);
    then power S1362RevocationPower {
        holder c;
        over e;
        exercise revokes_s_election(c, e, on);
        valid_when revocation_majority_consent(c, on);
        effect create(s_election_revoked_effective(c, e, on));
        window [@1958-01-01, infinity);
    };
}
pub relation s_election_revoked_effective(c: Corporation, e: SCorpElection, on: Date) kind institutional {
    label en official "a validly exercised revocation, keyed to the date it was made (its EFFECTIVE date is looked up separately via revocation_effective_date)";
}
rule RevocationTerminatesElection defeasible {
    for c: Corporation; for e: SCorpElection; for on: Date; for effDate: Date; for y: TaxableYear;
    when s_election_revoked_effective(c, e, on);
    when revocation_effective_date(c, e, on, effDate);
    when us.irc.core::year_of(c, y);
    when us.irc.core::begins(y, effDate);
    then s_election_terminated_as_of(c, e, y);
}

// --- (d)(2): automatic termination on ceasing to be a small business corporation ---

@source(IRC_S1362_D, quote = "such corporation ceases to be a small business corporation")
rule S1362D2AutomaticCessationTermination defeasible {
    label en official "the election terminates automatically, effective on and after the date of cessation, when the corporation ceases to be a small business corporation (section 1362(d)(2))";
    for c: Corporation; for e: SCorpElection; for y: TaxableYear; for d0: Date;
    when s_election_effective_year(c, e, y);
    when us.irc.core::begins(y, d0);
    when not_known(small_business_corporation(c, d0));
    then s_election_terminated_as_of(c, e, y);
}
// The rule above tests at the START of y; a cessation occurring MID-YEAR
// (the statute's actual "at any time on or after the 1st day...ceases")
// requires re-testing status on every later date in y, which this stage
// does not enumerate day by day (TECH-GAPS.md G46, same class as G1/G10)
// — recorded as TECH_GAP: only a cessation known as of the year's first day
// is captured; a mid-year cessation is under-detected by this rule alone.

// --- (d)(3): the 3-consecutive-year passive-income/accumulated-E&P rule ---
// The accumulated-E&P and >25%-passive-investment-income tests read
// `corporations`' own earnings-and-profits and passive-investment-income
// shapes (the latter also defined for section 1375, see 09-taxes.law). Each
// year's TWO conditions are taken as case-asserted per-year facts; the
// 3-CONSECUTIVE-year chain itself is asserted directly (a rule that reads
// "3 consecutive years" from year-by-year facts would need the same
// object/period-keyed recursion TECH-GAPS.md flags as G24/G25 for a
// carryover chain — not attempted here).
pub relation accumulated_e_and_p_at_close(c: Corporation, y: TaxableYear) kind empirical {
    label en official "c has accumulated earnings and profits at the close of taxable year y (section 1362(d)(3)(A)(i)(I)); case-asserted, pending a corporations-package contract for the E&P amount itself";
}
pub relation passive_investment_income_exceeds_25_percent(c: Corporation, y: TaxableYear) kind empirical {
    label en official "more than 25 percent of c's gross receipts for y are passive investment income, computed per section 1362(d)(3)(B)-(C) (section 1362(d)(3)(A)(i)(II)); case-asserted";
}
pub relation three_consecutive_years_condition_met(c: Corporation, e: SCorpElection, thirdYear: TaxableYear) kind empirical {
    label en official "thirdYear is the third of 3 consecutive taxable years, each an S-corporation year, in each of which c had accumulated E&P at the close and passive investment income over 25 percent of gross receipts (section 1362(d)(3)(A)(i), (iii)); case-asserted as a package (the 3-year chain is not derived from single-year facts — TECH-GAPS.md G46)";
}
@source(IRC_S1362_D, quote = "Any termination under this paragraph shall be effective on and after the first day of the first taxable year beginning after the third consecutive taxable year")
rule S1362D3PassiveIncomeTermination strict {
    label en official "3 consecutive years of accumulated E&P and >25% passive investment income terminate the election, effective the first day of the NEXT taxable year (section 1362(d)(3)(A)(i)-(ii))";
    for c: Corporation; for e: SCorpElection; for thirdYear: TaxableYear; for nextY: TaxableYear;
    when three_consecutive_years_condition_met(c, e, thirdYear);
    when accumulated_e_and_p_at_close(c, thirdYear);
    when passive_investment_income_exceeds_25_percent(c, thirdYear);
    when next_taxable_year(thirdYear, nextY);
    then s_election_terminated_as_of(c, e, nextY);
}

// --- (f): inadvertent termination relief, as the Secretary's power -------

external judgment relation circumstances_were_inadvertent(c: Corporation, e: SCorpElection) {
    authority Secretary;
    label en official "the Secretary determines that the circumstances resulting in the ineffectiveness or termination were inadvertent (section 1362(f)(2))";
}
pub relation steps_taken_to_restore_qualification(c: Corporation, e: SCorpElection) kind empirical {
    label en official "steps were taken, within a reasonable time after discovery, so that the corporation is again a small business corporation (or QSSS) or to acquire the required shareholder consents (section 1362(f)(3))";
}
pub relation shareholders_agree_to_adjustments(c: Corporation, e: SCorpElection) kind empirical {
    label en official "the corporation and every shareholder during the specified period agree to make adjustments the Secretary may require (section 1362(f)(4))";
}
pub relation inadvertent_termination_relief_conditions(c: Corporation, e: SCorpElection) kind institutional {
    label en official "steps were taken to restore qualification and the required shareholders agreed to adjustments (section 1362(f)(3)-(4))";
}
rule InadvertentTerminationReliefConditions strict {
    for c: Corporation; for e: SCorpElection;
    when steps_taken_to_restore_qualification(c, e);
    when shareholders_agree_to_adjustments(c, e);
    then inadvertent_termination_relief_conditions(c, e);
}
pub relation secretary_grants_inadvertent_termination_relief(c: Corporation, e: SCorpElection, on: Date) kind empirical {
    label en official "the Secretary treats the corporation as an S corporation (or QSSS) during the period the Secretary specifies, notwithstanding the ineffectiveness or termination (section 1362(f))";
}
@source(IRC_S1362_F, quote = "such corporation shall be treated as an S corporation or a qualified subchapter S subsidiary, as the case may be, during the period specified by the Secretary")
rule S1362FInadvertentTerminationReliefPower strict {
    label en official "the Secretary may relieve an inadvertent ineffectiveness or termination, treating the corporation as an S corporation during the specified period (section 1362(f))";
    for c: Corporation; for e: SCorpElection; for on: Date; for y: TaxableYear;
    when secretary_grants_inadvertent_termination_relief(c, e, on);
    when us.irc.core::year_of(c, y);
    then power S1362InadvertentReliefPower {
        holder Secretary;
        over e;
        exercise secretary_grants_inadvertent_termination_relief(c, e, on);
        valid_when inadvertent_termination_relief_conditions(c, e);
        effect create(s_corporation(c, y));
        window [@1958-01-01, infinity);
    };
}

// --- (g): the 5-year re-election bar --------------------------------------

pub relation eligible_to_reelect_s_status(c: Corporation, y: TaxableYear) kind institutional {
    label en official "c (or a successor) may make a new section 1362(a) election for y, notwithstanding a prior termination (section 1362(g))";
}
pub relation secretary_consents_to_early_reelection(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to an earlier re-election under section 1362(g)";
}
@source(IRC_S1362_G, quote = "shall not be eligible to make an election under subsection (a) for any taxable year before its 5th taxable year which begins after the 1st taxable year for which such termination is effective")
rule S1362GFiveYearBarDefault defeasible {
    label en official "after a section 1362(d) termination, a new election is barred until the 5th taxable year beginning after the 1st year the termination was effective, absent Secretary consent (section 1362(g))";
    for c: Corporation; for e: SCorpElection; for terminatedY: TaxableYear; for y: TaxableYear;
    when s_election_terminated_as_of(c, e, terminatedY);
    when at_least_five_taxable_years_after(terminatedY, y);
    unless secretary_consents_to_early_reelection(c, y);
    then eligible_to_reelect_s_status(c, y);
}
// The "5th taxable year which begins after" the terminated year is a
// year-count relation over the `TaxableYear` sequence; case-asserted rather
// than derived by chaining `next_taxable_year` five times (TECH-GAPS.md
// G30 — the same successor-year gap noted above, extended to a fixed count).
pub relation at_least_five_taxable_years_after(terminatedY: TaxableYear, y: TaxableYear) kind empirical {
    label en unofficial "y is the 5th taxable year beginning after terminatedY, or later; case-asserted, TECH-GAPS.md G46";
}
