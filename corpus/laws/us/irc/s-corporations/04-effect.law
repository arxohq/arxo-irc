// Section 1363 — Effect of election on corporation.
//
// SCOPE: (a) no corporate-level tax except §§1374/1375 (an institutional
// effect / immunity-shaped rule); (b) taxable income computed as for an
// individual, with the four listed modifications (classification only —
// the modifications themselves are `gross-income`/`deductions`/
// `corporations` norms, not re-implemented here); (c) corporate- vs.
// shareholder-level elections (classification); (d) LIFO recapture —
// EXTERNAL_DEPENDENCY on `accounting` (§§471/472/585 inventory method) and
// on `corporations` (installment/affiliated-group tests), recorded as a
// pending dependency, not computed.

use self::{
    Corporation,
    IRC_S1363_A,
    IRC_S1363_C,
    TaxableYear,
    s_corporation,
};

pub relation no_corporate_level_tax_except_1374_1375(c: Corporation, y: TaxableYear) kind institutional {
    label en official "an S corporation is not subject to the taxes imposed by chapter 1, except as otherwise provided in Subchapter S (i.e. sections 1374/1375) (section 1363(a))";
}
@source(IRC_S1363_A, quote = "an S corporation shall not be subject to the taxes imposed by this chapter")
rule S1363ANoCorporateLevelTax defeasible {
    label en official "an S corporation is exempt from chapter 1 tax except as Subchapter S itself otherwise provides (section 1363(a))";
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    then no_corporate_level_tax_except_1374_1375(c, y);
}
// The "except as otherwise provided" carve-out is sections 1374/1375
// themselves (09-taxes.law), which are affirmative taxes this relation does
// NOT negate — they are separate heads (`s_corp_tax`), not exceptions to
// this one. Recorded here as an INTERPRETATION note: `unless` is not used
// because 1374/1375 liability and the (a) general immunity are not framed
// as competing on the SAME head in this package's model (a corporation can
// simultaneously "not be subject to chapter 1 tax generally" and "owe the
// section 1374/1375 special tax", per the statute's own "except" clause).

// --- (b): computation modifications (classification only) ---------------

pub relation taxable_income_computed_as_individual(c: Corporation, y: TaxableYear) kind institutional {
    label en official "an S corporation's taxable income is computed in the same manner as an individual's, subject to the four modifications of section 1363(b) (section 1363(b))";
}
rule S1363BComputedAsIndividual defeasible {
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    then taxable_income_computed_as_individual(c, y);
}
// (b)(1)-(4) (separately-stated items per section 1366(a)(1)(A); no section
// 703(a)(2) partnership-style deductions; section 248 organizational
// expenditures apply; section 291 corporate preference-item cutback for a
// former C corporation) are each a cross-reference to another owner's
// computation rule (gross-income/deductions/corporations); this package
// does not re-implement section 248/291 here — classification only,
// EXTERNAL_DEPENDENCY (see s-corporations.deps.json).

// --- (c): elections at corporate vs. shareholder level -------------------

pub enum ShareholderLevelElectionProvision {
    Section617MiningExploration;
    Section901ForeignTaxCredit;
    label en unofficial "the two provisions section 1363(c)(2) carves out as shareholder-level elections";
}
pub relation election_made_by_each_shareholder(c: Corporation, y: TaxableYear, provision: ShareholderLevelElectionProvision) kind institutional {
    label en official "an election under section 617 or section 901 with respect to the S corporation is made by EACH SHAREHOLDER separately (section 1363(c)(2))";
}
@source(IRC_S1363_C, quote = "elections under the following provisions shall be made by each shareholder separately")
rule S1363C2ShareholderLevelElectionSection617 defeasible {
    label en official "section 617 elections are made by each shareholder separately, not by the corporation (section 1363(c)(2)(A))";
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    then election_made_by_each_shareholder(c, y, Section617MiningExploration);
}
@source(IRC_S1363_C, quote = "elections under the following provisions shall be made by each shareholder separately")
rule S1363C2ShareholderLevelElectionSection901 defeasible {
    label en official "section 901 elections are made by each shareholder separately, not by the corporation (section 1363(c)(2)(B))";
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    then election_made_by_each_shareholder(c, y, Section901ForeignTaxCredit);
}
// (c)(1) ("except as provided in paragraph (2), any election...shall be
// made by the corporation") is the default a contrario of the rule above;
// not given its own head since it is fully stated by the absence of a
// (c)(2) carve-out for a given provision — recorded as NON_NORMATIVE
// default framing in the coverage row, not a separate executable rule.
