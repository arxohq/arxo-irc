// Sections 1371-1373 — coordination with subchapter C; fringe-benefit and
// foreign-income partnership treatment.
//
// SCOPE: 1371(a) subchapter C applies except as inconsistent (non-normative
// framing); (b)(1)-(3) no C-year carryover into/at the S-corporation level
// (classification, EXTERNAL_DEPENDENCY on the specific carryover regime);
// (c)(1)-(3) no E&P adjustment except as listed (classification); (d)(1)-(3)
// investment-credit-recapture coordination (EXTERNAL_DEPENDENCY, sections
// 49/50); (e)(1)-(2) post-termination-transition-period cash distributions
// reduce basis, with an election out, as a power; (f) eligible-terminated-S-
// corporation post-PTTP allocation ratio. 1372: 2-percent-shareholder
// fringe-benefit partnership treatment. 1373: foreign-income partnership
// treatment and overall-foreign-loss recapture trigger.

// --- 1371(b): no C-year carryover -----------------------------------------

use self::{
    Carryover,
    Corporation,
    IRC_S1371_B,
    IRC_S1372_A,
    IRC_S1373_A,
    Person,
    TaxableYear,
    e_and_p_adjustment_exception,
    s_corporation,
    shareholder_of,
};

pub relation carryover_arose_as_c_corporation(k: Carryover, c: Corporation) kind empirical {
    label en official "the carryover arose for a taxable year for which the corporation was a C corporation; case-asserted, pending a corporations-package contract for how a C-year carryover itself is computed";
}
pub relation carryover_barred_at_s_corporation_level(k: Carryover, c: Corporation, y: TaxableYear) kind institutional {
    label en official "a C-year carryover may not be carried to, from, or arise at, an S-corporation-year (section 1371(b)(1)-(2))";
}
@source(IRC_S1371_B, quote = "No carryforward, and no carryback, arising for a taxable year for which a corporation is a C corporation may be carried to a taxable year for which such corporation is an S corporation")
rule NoCYearCarryoverIntoSYear defeasible {
    for k: Carryover; for c: Corporation; for y: TaxableYear;
    when carryover_arose_as_c_corporation(k, c);
    when s_corporation(c, y);
    then carryover_barred_at_s_corporation_level(k, c, y);
}
// (b)(2) ("no carryforward...shall arise at the corporate level for a
// taxable year for which a corporation is an S corporation") and (b)(3)
// (an S-corporation year still COUNTS toward the number of years a carryover
// may run) are classification cross-references onto whichever package
// computes the specific carryover (property-transactions' NOL/capital-loss
// shapes, credits' general-business-credit shape); not separately
// re-implemented here — EXTERNAL_DEPENDENCY (s-corporations.deps.json).

// --- 1371(c): no E&P adjustment except as listed --------------------------

pub relation e_and_p_adjustment_barred(c: Corporation, y: TaxableYear) kind institutional {
    label en official "no adjustment is made to the S corporation's earnings and profits for y, except a subchapter-C-transaction adjustment (c)(2) or the LIFO-recapture E&P adjustment of section 1363(d) (section 1371(c)(1))";
}
rule EAndPAdjustmentBarred defeasible {
    label en official "the general rule: no E&P adjustment for an S-corporation year, subject to the (c)(2)/(c)(3)/(d)(3) exceptions (section 1371(c)(1))";
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    unless e_and_p_adjustment_exception(c, y);
    then e_and_p_adjustment_barred(c, y);
}
pub relation subchapter_c_transaction_e_and_p_adjustment_applies(c: Corporation, y: TaxableYear) kind empirical {
    label en official "a subchapter C transaction involving the S corporation requires a proper E&P adjustment for y (section 1371(c)(2)); case-asserted, pending a corporations-package contract";
}
// (c)(3) (the section 1368(c)(2) dividend-portion carve-out from the (c)(1)
// bar) joins (c)(2) in `e_and_p_adjustment_exception`
// (13-taxes-carryovers-and-accounts.law), which the rule above reads.

// --- 1372: fringe benefits — partnership treatment for 2% shareholders ---

pub relation two_percent_shareholder(sh: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en official "sh owns (or is considered as owning under section 318) more than 2 percent of the outstanding stock, or of stock possessing more than 2 percent of total combined voting power, on any day during y (section 1372(b)); derived in 15-wire9-two-percent-shareholder-and-s-period.law from the roster, voting power and section 318 attribution; may still be asserted as a case fact";
}
pub relation treated_as_partnership_for_fringe_benefits(c: Corporation, y: TaxableYear) kind institutional {
    label en official "for fringe-benefit provisions of this subtitle, the S corporation is treated as a partnership (section 1372(a)(1))";
}
pub relation treated_as_partner_for_fringe_benefits(sh: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en official "for fringe-benefit provisions of this subtitle, a 2-percent shareholder is treated as a partner of that partnership (section 1372(a)(2))";
}
@source(IRC_S1372_A, quote = "the S corporation shall be treated as a partnership")
rule S1372ACorporationTreatedAsPartnership defeasible {
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    then treated_as_partnership_for_fringe_benefits(c, y);
}
@source(IRC_S1372_A, quote = "any 2-percent shareholder of the S corporation shall be treated as a partner of such partnership")
rule S1372A2PercentShareholderTreatedAsPartner strict {
    for sh: Person; for c: Corporation; for y: TaxableYear;
    when two_percent_shareholder(sh, c, y);
    then treated_as_partner_for_fringe_benefits(sh, c, y);
}

// --- 1373: foreign income — partnership treatment; overall-foreign-loss ---

pub relation treated_as_partnership_for_foreign_income(c: Corporation, y: TaxableYear) kind institutional {
    label en official "for the source-of-income rules of subchapter N parts I(A), I(F) and V, the S corporation is treated as a partnership (section 1373(a)(1))";
}
pub relation treated_as_partner_for_foreign_income(sh: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en official "for the same purposes, the shareholders are treated as partners of that partnership (section 1373(a)(2))";
}
@source(IRC_S1373_A, quote = "an S corporation shall be treated as a partnership")
rule S1373ACorporationTreatedAsPartnershipForForeignIncome defeasible {
    for c: Corporation; for y: TaxableYear;
    when s_corporation(c, y);
    then treated_as_partnership_for_foreign_income(c, y);
}
rule S1373AShareholdersTreatedAsPartnersForForeignIncome defeasible {
    for sh: Person; for c: Corporation; for y: TaxableYear; for d0: Date;
    when us.irc.core::begins(y, d0);
    when shareholder_of(sh, c, d0);
    when s_corporation(c, y);
    then treated_as_partner_for_foreign_income(sh, c, y);
}
pub relation election_or_termination_treated_as_disposition_of_business(c: Corporation, on: Date) kind institutional {
    label en official "the making or termination of an S election is treated as a disposition of the business, for section 904(f) overall-foreign-loss recapture (section 1373(b)); EXTERNAL_DEPENDENCY on a corporations/foreign-tax-credit-owning package for the section 904(f) recapture computation itself";
}
