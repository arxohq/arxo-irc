// Section 25A — American Opportunity Tax Credit (AOTC) and Lifetime
// Learning Credit (LLC). Stage 1 (IRC-06 stage 1).

use self::{
    IRC_S25A_A,
    IRC_S25A_B,
    IRC_S25A_C,
    IRC_S25A_D,
    IRC_S25A_I,
    Individual,
    Person,
    TaxableYear,
};

pub relation eligible_student(student: Person, period: Person) kind institutional {
    label en official "an eligible student for an academic period (section 25A(b)(3))";
}
relation meets_484a1_hea(student: Person) kind empirical {
    label en official "meets the requirements of section 484(a)(1) of the Higher Education Act of 1965, as in effect on the date of enactment (section 25A(b)(3)(A))";
}
relation half_time_workload(student: Person, period: Person) kind empirical {
    label en official "carrying at least one-half the normal full-time workload for the course of study (section 25A(b)(3)(B))";
}
@source(IRC_S25A_B, quote = "is carrying at least ½ the normal full-time work load for the course of study the student is pursuing")
rule EligibleStudentTest(student: Person, period: Person) strict {
    label en official "a student meeting the HEA enrollment-status requirement and carrying at least half the normal full-time workload is an eligible student for the period (this test is independent of which taxpayer claims the credit or which taxable year is at issue)";
    when meets_484a1_hea(student);
    when half_time_workload(student, period);
    then eligible_student(student, period);
}

pub relation eligible_educational_institution(institution: Person) kind institutional {
    label en official "an eligible educational institution (section 25A(f)(2)) — dependency contract on the Higher Education Act Title IV participation test; asserted as a case fact";
}

pub enum QualifiedExpenseKind { AotcTuitionFeesCourseMaterials; LlcTuitionFees; }
// One row per (taxpayer, student, kind) for the taxable year: the case
// asserts the YEAR'S total already reduced by section 25A(g)(2) excludable
// aid and confined to qualifying courses/institutions/academic periods
// (section 25A(f)(1)(B)/(C), (g)(2)) — those are case-classification
// conditions on what counts as an item here (INTERPRETATION), matching the
// idiom `s61-gross-income.law` uses for its own item-aggregation predicate.
pub relation qualified_tuition_and_related_expenses(taxpayer: Individual, student: Person, kind: QualifiedExpenseKind, amount: Money) kind empirical {
    label en official "tuition and fees (LLC) or tuition, fees, and course materials (AOTC, section 25A(f)(1)(D)) required for enrollment or attendance, already net of section 25A(g)(2) excludable aid";
}

// --- §25A(b): American Opportunity Tax Credit ------------------------------------

pub relation aotc_election_in_effect(student: Person, taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "an election is in effect for the American Opportunity Tax Credit with respect to this student for this taxable year (section 25A(b)(1))";
}
relation aotc_prior_election_years_count(student: Person, y: TaxableYear, n: Integer) kind institutional {
    label en official "the number of prior taxable years for which an AOTC election (by this taxpayer or any other individual) has been in effect for this student (section 25A(b)(2)(A))";
}
relation completed_first_4_years_postsecondary(student: Person, y: TaxableYear) kind empirical {
    label en official "has completed, before the beginning of the taxable year, the first 4 years of postsecondary education at an eligible educational institution (section 25A(b)(2)(C))";
}
relation controlled_substance_felony_conviction(student: Person, y: TaxableYear) kind empirical {
    label en official "has been convicted of a Federal or State felony for possession or distribution of a controlled substance before the end of the taxable year (section 25A(b)(2)(D))";
}
relation in_disallowance_period_25a(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxable year falls in the section 25A(b)(4) fraud (10-year) or reckless-disregard (2-year) AOTC disallowance period";
}

pub relation aotc_eligible_for_student(student: Person, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "the American Opportunity Tax Credit may be allowed with respect to this student for this taxable year (sections 25A(b)(1)-(2), (4))";
}
@source(IRC_S25A_B, quote = "In the case of any eligible student for whom an election is in effect under this section for any taxable year")
rule AotcEligibleForStudent(student: Person, taxpayer: Individual, y: TaxableYear, period: Person, priorYears: Integer) strict {
    label en official "an eligible student with an election in effect, at most 4 prior election years, who has not completed 4 years of postsecondary education, has no disqualifying felony conviction, and is outside the disallowance period, may receive the AOTC";
    when eligible_student(student, period);
    when aotc_election_in_effect(student, taxpayer, y);
    when aotc_prior_election_years_count(student, y, priorYears);
    when priorYears < 4;
    when not completed_first_4_years_postsecondary(student, y);
    when not controlled_substance_felony_conviction(student, y);
    when not in_disallowance_period_25a(taxpayer, y);
    then aotc_eligible_for_student(student, taxpayer, y);
}

pub relation american_opportunity_tax_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the American Opportunity Tax Credit before the section 25A(d) phase-out (section 25A(a)(1), (b)(1))";
}
@source(IRC_S25A_B, quote = "100 percent of so much of the qualified tuition and related expenses paid by the taxpayer during the taxable year (for education furnished to the eligible student during any academic period beginning in such taxable year) as does not exceed $2,000, plus")
rule AmericanOpportunityTaxCreditPerStudent(taxpayer: Individual, student: Person, y: TaxableYear, expenses: Money) strict {
    label en official "for each eligible AOTC student, 100 percent of the first $2,000 of qualified expenses plus 25 percent of the next $2,000 (up to $4,000 total)";
    when aotc_eligible_for_student(student, taxpayer, y);
    when qualified_tuition_and_related_expenses(taxpayer, student, AotcTuitionFeesCourseMaterials, expenses);
    then american_opportunity_tax_credit_per_student(taxpayer, student, y,
        min(expenses, 2000.00 USD) + 0.25 * max(0 USD, min(expenses, 4000.00 USD) - 2000.00 USD));
}
relation american_opportunity_tax_credit_per_student(taxpayer: Individual, student: Person, y: TaxableYear, amount: Money) kind institutional;
@source(IRC_S25A_A, quote = "the American Opportunity Tax Credit, plus")
rule AmericanOpportunityTaxCreditTotal(taxpayer: Individual, y: TaxableYear) strict {
    label en official "the AOTC is the sum of the per-student amounts";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then american_opportunity_tax_credit(taxpayer, y,
        sum all amount: Money for student: Person where american_opportunity_tax_credit_per_student(taxpayer, student, y, amount));
}

// --- §25A(c): Lifetime Learning Credit --------------------------------------------

pub relation lifetime_learning_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the Lifetime Learning Credit before the section 25A(d) phase-out (section 25A(a)(2), (c)(1))";
}
relation llc_countable_expense_item(taxpayer: Individual, student: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "an LLC-kind qualified-expense item for a student NOT receiving the AOTC for the year (section 25A(c)(2)(A) exclusion)";
}
@source(IRC_S25A_C, quote = "The qualified tuition and related expenses with respect to an individual who is an eligible student for whom a [1] American Opportunity Tax Credit under subsection (a)(1) is allowed for the taxable year shall not be taken into account under this subsection")
rule LlcCountableExpenseItem(taxpayer: Individual, student: Person, y: TaxableYear, amount: Money) strict {
    label en official "an LLC expense item counts only for a student not receiving the AOTC for the year";
    when qualified_tuition_and_related_expenses(taxpayer, student, LlcTuitionFees, amount);
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    when not_known(aotc_eligible_for_student(student, taxpayer, y));
    then llc_countable_expense_item(taxpayer, student, y, amount);
}
@source(IRC_S25A_C, quote = "20 percent of so much of the qualified tuition and related expenses paid by the taxpayer during the taxable year (for education furnished during any academic period beginning in such taxable year) as does not exceed $10,000")
rule LifetimeLearningCredit(taxpayer: Individual, y: TaxableYear) strict {
    label en official "20 percent of qualified tuition and related expenses up to $10,000 across all countable students";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then lifetime_learning_credit(taxpayer, y,
        round(0.20 * min(10000.00 USD,
            sum all amount: Money for student: Person where llc_countable_expense_item(taxpayer, student, y, amount)), 2, "HALF_UP"));
}

// --- §25A(d): phase-out -------------------------------------------------------------

pub relation education_credit_modified_agi(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "modified adjusted gross income for section 25A: AGI increased by section 911/931/933 exclusions (section 25A(d)(2))";
}
@source(IRC_S25A_D, quote = "the adjusted gross income of the taxpayer for the taxable year increased by any amount excluded from gross income under section 911, 931, or 933")
rule EducationCreditModifiedAgi(taxpayer: Individual, y: TaxableYear, agi: Money) strict {
    label en official "absent an asserted exclusion, education-credit modified AGI equals AGI (see 24-child-tax-credit.law's identical treatment of the analogous section 911/931/933 addback)";
    when us.irc.gross_income::adjusted_gross_income(taxpayer, y, agi);
    when not_known(has_section_911_931_933_exclusion_25a(taxpayer, y));
    then education_credit_modified_agi(taxpayer, y, agi);
}
relation section_911_931_933_exclusion_25a(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "amount excluded under section 911, 931, or 933 — dependency contract, producer: international (pending)";
}
relation has_section_911_931_933_exclusion_25a(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "existence flag for section_911_931_933_exclusion_25a, used only for the not_known branch above (see 24-child-tax-credit.law's identical idiom)";
}
rule HasSection911931933Exclusion25a(taxpayer: Individual, y: TaxableYear, excl: Money) strict {
    label en official "the existence flag is derived whenever an exclusion amount is asserted";
    when section_911_931_933_exclusion_25a(taxpayer, y, excl);
    then has_section_911_931_933_exclusion_25a(taxpayer, y);
}

pub relation education_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total education credit allowed under section 25A for the taxable year, after the section 25A(d) phase-out (before the section 25A(i) 40 percent refundable-AOTC split)";
}
relation education_credit_agi_floor(s: us.irc.income_individual::FilingStatus, amount: Money) kind institutional {
    label en official "the section 25A(d)(1)(A)(ii) MAGI floor above which the phase-out begins, by filing status";
}
relation education_credit_agi_band(s: us.irc.income_individual::FilingStatus, amount: Money) kind institutional {
    label en official "the section 25A(d)(1)(B) MAGI band over which the phase-out is spread, by filing status";
}
@source(IRC_S25A_D, quote = "$80,000 ($160,000 in the case of a joint return)")
assert "25a-agi-floor-joint": education_credit_agi_floor(us.irc.income_individual::Joint, 160000.00 USD);
assert "25a-agi-floor-unmarried": education_credit_agi_floor(us.irc.income_individual::Unmarried, 80000.00 USD);
assert "25a-agi-floor-mfs": education_credit_agi_floor(us.irc.income_individual::MarriedSeparate, 80000.00 USD);
assert "25a-agi-floor-hoh": education_credit_agi_floor(us.irc.income_individual::HeadOfHousehold, 80000.00 USD);
assert "25a-agi-floor-estate": education_credit_agi_floor(us.irc.income_individual::EstateOrTrust, 80000.00 USD);
@source(IRC_S25A_D, quote = "$10,000 ($20,000 in the case of a joint return)")
assert "25a-agi-band-joint": education_credit_agi_band(us.irc.income_individual::Joint, 20000.00 USD);
assert "25a-agi-band-unmarried": education_credit_agi_band(us.irc.income_individual::Unmarried, 10000.00 USD);
assert "25a-agi-band-mfs": education_credit_agi_band(us.irc.income_individual::MarriedSeparate, 10000.00 USD);
assert "25a-agi-band-hoh": education_credit_agi_band(us.irc.income_individual::HeadOfHousehold, 10000.00 USD);
assert "25a-agi-band-estate": education_credit_agi_band(us.irc.income_individual::EstateOrTrust, 10000.00 USD);
// (g)(6)'s bar on a married-filing-separately taxpayer (this section applies
// only on a joint return for a married taxpayer) is not separately re-gated
// here: MarriedSeparate's floor/band values are asserted for completeness of
// the relation's domain, but a case package should not assert MFS facts
// feeding this credit — recorded as INTERPRETATION, not a computed bar.

@source(IRC_S25A_D, quote = "The American Opportunity Tax Credit and the Lifetime Learning Credit shall each (determined without regard to this paragraph) be reduced (but not below zero) by the amount which bears the same ratio to each such credit (as so determined) as—")
rule EducationCreditWithPhaseout(taxpayer: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, aotc: Money, llc: Money, magi: Money, floor: Money, band: Money) strict {
    label en official "each of the AOTC and LLC is reduced proportionally over the MAGI band starting at the MAGI floor; the total credit is their sum";
    when us.irc.income_individual::filing_status(taxpayer, y, s);
    when american_opportunity_tax_credit(taxpayer, y, aotc);
    when lifetime_learning_credit(taxpayer, y, llc);
    when education_credit_modified_agi(taxpayer, y, magi);
    when education_credit_agi_floor(s, floor);
    when education_credit_agi_band(s, band);
    then education_credit(taxpayer, y,
        round((aotc + llc) * (1.0 - min(1.0, max(0 USD, magi - floor) / band)), 2, "HALF_UP"));
}

// --- §25A(i): 40 percent of AOTC is refundable ------------------------------------

pub relation refundable_american_opportunity_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "40 percent of the AOTC portion of the education credit (after phase-out), treated as allowable under subpart C, unless the taxpayer is a child to whom section 1(g) (kiddie tax) applies (section 25A(i))";
}
relation section_1g_kiddie_tax_applies(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 1(g) applies to this taxpayer for this taxable year — read from income_individual's kiddie-tax.law";
}
@source(IRC_S25A_I, quote = "Forty percent of so much of the credit allowed under subsection (a) as is attributable to the American Opportunity Tax Credit (determined after application of subsection (d) and without regard to this paragraph [2] and section 26(a)) shall be treated as a credit allowable under subpart C")
rule RefundableAotcPortion(taxpayer: Individual, y: TaxableYear, aotc: Money, magi: Money, s: us.irc.income_individual::FilingStatus, floor: Money, band: Money) strict {
    label en official "40 percent of the phased-out AOTC is refundable, unless the taxpayer is a kiddie-tax child";
    when not_known(section_1g_kiddie_tax_applies(taxpayer, y));
    when american_opportunity_tax_credit(taxpayer, y, aotc);
    when education_credit_modified_agi(taxpayer, y, magi);
    when us.irc.income_individual::filing_status(taxpayer, y, s);
    when education_credit_agi_floor(s, floor);
    when education_credit_agi_band(s, band);
    then refundable_american_opportunity_credit(taxpayer, y,
        round(0.40 * aotc * (1.0 - min(1.0, max(0 USD, magi - floor) / band)), 2, "HALF_UP"));
}

// §25A(e): election not to have the section apply — a `liberty` (the
// taxpayer's own choice not to claim an otherwise-available benefit, no
// change of legal relations to a third party) rather than a `power`.
pub relation section_25a_election_out(taxpayer: Individual, student: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects not to have section 25A apply to this individual's expenses for the taxable year (section 25A(e))";
}

// §25A(g)(1)/(3)/(6)/(7)/(8): identification (name/TIN/EIN), the
// dependent-shift rule (expenses of a dependent claimed by another taxpayer
// are treated as paid by that taxpayer), the married-filing-jointly
// requirement, the nonresident-alien bar (absent a section 6013(g)/(h)
// election), and the section 6050S information-return requirement are case-
// level gating facts on the `qualified_tuition_and_related_expenses`/
// `eligible_student` assertions above, recorded as INTERPRETATION per the
// same idiom used throughout this package for identification/marital-status
// narrowing conditions, rather than re-threaded through every arithmetic
// rule.
