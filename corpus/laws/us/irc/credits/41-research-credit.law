// Section 41 — Credit for increasing research activities ("research
// credit"). Stage 2 (IRC-06 stage 2, DECISION-0379). Priority list item:
// §41(a)-(c),(h).
//
// Judgment calls:
// * §41(b) (qualified research expenses: in-house wages/supplies/computer
//   rental time plus 65/75/100-percent contract research expenses) is
//   modelled as a per-item classification relation reaching a case-supplied
//   TOTAL (`qualified_research_expenses`), not as a wage-by-wage/supply-by-
//   supply ledger — the underlying "qualified research" four-part test of
//   (d) is DECISION-0194 EVALUATIVE (business-component/technological/
//   process-of-experimentation/permitted-purpose), not re-derived here;
//   TECH_GAP on wiring (b)'s own sub-definitions.
// * §41(c)(3)'s fixed-base-percentage computation (the pre-1989 lookback,
//   the 7-tier start-up-company ramp of (c)(3)(B), the 16-percent ceiling)
//   is NOT re-derived from historical gross-receipts/QRE history — the
//   fixed-base percentage is a case-asserted fact
//   (`fixed_base_percentage_41c3`), already capped/rounded per the statute's
//   own text, since deriving the ramp end to end would need a decade of
//   historical per-year case facts this package's scenario harness does not
//   model this pass. TECH_GAP, noted (mirrors this package's own §21(b)(3)
//   "asserted certification" pattern for institutional facts a regulator or
//   the taxpayer's own history determines).
// * §41(c)(4) (election of the alternative simplified credit, "ASC") is
//   modelled as a case-asserted ELECTION FACT (not a `power`, since revoking
//   it needs the Secretary's consent under (c)(4)(C) and this pass does not
//   model that consent channel) with the two ASC sub-rates (14 percent
//   general, 6 percent no-prior-QRE) as independent rules.
// * §41(h) (payroll tax credit portion for qualified small businesses) is
//   modelled as a `power` (the election changes which portion of the
//   credit is treated as a payroll tax credit under section 3111(f) rather
//   than an income tax credit) with the (h)(2) three-way "least of" amount
//   and the (h)(3)(A) gross-receipts/5-year qualified-small-business test;
//   (h)(4)(B)(ii)'s 5-election lifetime cap and (h)(5) aggregation rules are
//   TECH_GAP, not modelled.
// * §41(e) (basic research payments to qualified organizations) and §41(f)
//   (energy research consortium payments; the (a)(3) 20-percent-of-
//   consortium-payments component) are case-asserted totals directly, not
//   separately derived from underlying payment classifications — TECH_GAP.

// --- §41(b): qualified research expenses (aggregate, case-asserted) ---------------

use self::{
    IRC_S41_A,
    IRC_S41_C,
    IRC_S41_H,
    Person,
    TaxableYear,
    average_qualified_research_expenses_for_asc_41,
    fixed_base_percentage_for_credit_41c3,
    qualified_research_expenses_for_credit_41,
};

pub relation qualified_research_expenses(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "qualified research expenses for the taxable year (section 41(b)(1)): in-house research expenses plus contract research expenses, already net of the section 41(b)(2)(D)(iii) work-opportunity-credit-wage exclusion — case-asserted aggregate, TECH_GAP on deriving it item by item";
}
pub relation basic_research_payments_41e1a(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "basic research payments determined under section 41(e)(1)(A) — case-asserted, TECH_GAP on (e)'s own qualified-organization/base-period machinery";
}
pub relation energy_research_consortium_payments(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid or incurred to an energy research consortium for energy research (section 41(a)(3)) — case-asserted";
}

// --- §41(c): base amount -----------------------------------------------------------

pub relation fixed_base_percentage_41c3(taxpayer: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the fixed-base percentage (section 41(c)(3)), already capped at 16 percent and rounded to the nearest 1/100th of 1 percent per the statute's own terms — case-asserted, TECH_GAP on deriving the historical lookback/start-up ramp end to end";
}
pub relation average_annual_gross_receipts_4yr(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "average annual gross receipts of the taxpayer for the 4 taxable years preceding the credit year (section 41(c)(1)(B)) — a DIFFERENT window from accounting's own 3-year section 448(c) average and international's own 3-year section 59A average; a separate relation per this package's own convention of not merging superficially similar but textually independent averaging windows";
}

pub relation base_amount_41c(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the base amount (section 41(c)(1)-(2)): the fixed-base percentage times the 4-year average annual gross receipts, but not less than 50 percent of the taxable year's qualified research expenses";
}
@source(IRC_S41_C, quote = "In no event shall the base amount be less than 50 percent of the qualified research expenses for the credit year.")
rule BaseAmount41c defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for pct: Decimal;
    for receipts: Money;
    for qre: Money;
    when fixed_base_percentage_for_credit_41c3(taxpayer, y, pct);
    when average_annual_gross_receipts_4yr(taxpayer, y, receipts);
    when qualified_research_expenses(taxpayer, y, qre);
    then base_amount_41c(taxpayer, y, max(round(pct * receipts, 2, "HALF_UP"), round(0.50 * qre, 2, "HALF_UP")));
}

// --- §41(c)(4): election of the alternative simplified credit ---------------------

pub relation section_41_asc_elected(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has elected the alternative simplified credit under section 41(c)(4) for the taxable year (and, per (c)(4)(C), all succeeding taxable years unless revoked with the Secretary's consent — the revocation channel is TECH_GAP, not modelled)";
}
pub relation average_qualified_research_expenses_3yr(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "average qualified research expenses for the 3 taxable years preceding the credit year (section 41(c)(4)(A))";
}
pub relation no_qualified_research_expenses_in_any_of_3_preceding_years(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has no qualified research expenses in any one of the 3 taxable years preceding the credit year (section 41(c)(4)(B)(i))";
}

pub relation research_credit_component_1_41a1(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 41(a)(1) component: 20 percent of qualified research expenses over the base amount (regular method), OR the section 41(c)(4) alternative simplified credit in lieu of it, per the taxpayer's own election";
}
@source(IRC_S41_A, quote = "20 percent of the excess (if any) of—\n(A) the qualified research expenses for the taxable year, over\n(B) the base amount")
rule ResearchCreditComponentRegular defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for qre: Money;
    for base: Money;
    when not section_41_asc_elected(taxpayer, y);
    when qualified_research_expenses_for_credit_41(taxpayer, y, qre);
    when base_amount_41c(taxpayer, y, base);
    then research_credit_component_1_41a1(taxpayer, y, round(0.20 * max(0 USD, qre - base), 2, "HALF_UP"));
}
@source(IRC_S41_C, quote = "the credit determined under subsection (a)(1) shall be equal to 14 percent of so much of the qualified research expenses for the taxable year as exceeds 50 percent of the average qualified research expenses for the 3 taxable years preceding the taxable year for which the credit is being determined")
rule ResearchCreditComponentAscGeneral defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for qre: Money;
    for avg3: Money;
    when section_41_asc_elected(taxpayer, y);
    when not no_qualified_research_expenses_in_any_of_3_preceding_years(taxpayer, y);
    when qualified_research_expenses_for_credit_41(taxpayer, y, qre);
    when average_qualified_research_expenses_for_asc_41(taxpayer, y, avg3);
    then research_credit_component_1_41a1(taxpayer, y, round(0.14 * max(0 USD, qre - round(0.50 * avg3, 2, "HALF_UP")), 2, "HALF_UP"));
}
@source(IRC_S41_C, quote = "The credit determined under this subparagraph shall be equal to 6 percent of the qualified research expenses for the taxable year.")
rule ResearchCreditComponentAscNoPriorQre defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for qre: Money;
    when section_41_asc_elected(taxpayer, y);
    when no_qualified_research_expenses_in_any_of_3_preceding_years(taxpayer, y);
    when qualified_research_expenses_for_credit_41(taxpayer, y, qre);
    then research_credit_component_1_41a1(taxpayer, y, round(0.06 * qre, 2, "HALF_UP"));
}

// --- §41(a): amount of credit -------------------------------------------------------

relation research_credit_component_2_or_zero(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional;
relation has_basic_research_payments(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasBasicResearchPayments defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when basic_research_payments_41e1a(taxpayer, y, amount);
    then has_basic_research_payments(taxpayer, y);
}
rule ResearchCreditComponent2Present defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when basic_research_payments_41e1a(taxpayer, y, amount);
    then research_credit_component_2_or_zero(taxpayer, y, round(0.20 * amount, 2, "HALF_UP"));
}
rule ResearchCreditComponent2Absent defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when research_credit_component_1_41a1(taxpayer, y, amount);
    when not_known(has_basic_research_payments(taxpayer, y));
    then research_credit_component_2_or_zero(taxpayer, y, 0 USD);
}

relation research_credit_component_3_or_zero(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional;
relation has_energy_research_consortium_payments(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasEnergyResearchConsortiumPayments defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when energy_research_consortium_payments(taxpayer, y, amount);
    then has_energy_research_consortium_payments(taxpayer, y);
}
rule ResearchCreditComponent3Present defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when energy_research_consortium_payments(taxpayer, y, amount);
    then research_credit_component_3_or_zero(taxpayer, y, round(0.20 * amount, 2, "HALF_UP"));
}
rule ResearchCreditComponent3Absent defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when research_credit_component_1_41a1(taxpayer, y, amount);
    when not_known(has_energy_research_consortium_payments(taxpayer, y));
    then research_credit_component_3_or_zero(taxpayer, y, 0 USD);
}

pub relation research_credit_before_41g(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the three section 41(a)(1)-(3) components before the section 41(g) limit for pass-thru interests (stage 3 split; the limit step is in s3-g-41g-pass-thru-limit.law)";
}
pub relation research_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 41 research credit for the taxable year: the sum of the three section 41(a)(1)-(3) components (before the section 41(h) payroll-tax-credit-portion election)";
}
@source(IRC_S41_A, quote = "the research credit determined under this section for the taxable year shall be an amount equal to the sum of")
rule ResearchCreditTotal defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for c1: Money;
    for c2: Money;
    for c3: Money;
    when research_credit_component_1_41a1(taxpayer, y, c1);
    when research_credit_component_2_or_zero(taxpayer, y, c2);
    when research_credit_component_3_or_zero(taxpayer, y, c3);
    then research_credit_before_41g(taxpayer, y, c1 + c2 + c3);
}

// --- §41(h): payroll tax credit portion for qualified small businesses -------------

pub relation qualified_small_business_41h(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "a qualified small business under section 41(h)(3): gross receipts under $5,000,000 for the taxable year and no gross receipts for any taxable year before the 5-taxable-year period ending with the taxable year, and not a section 501 exempt organization";
}
relation section_41h_election_filed(taxpayer: Person, y: TaxableYear, specified_amount: Money) kind empirical;
relation section_39_business_credit_carryforward_from_year(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 39 business credit carryforward carried FROM this taxable year, determined before the section 41(h) election (section 41(h)(2)(C)) — dependency contract on 39-carryback-carryforward.law's own carryforward ledger";
}
pub relation payroll_tax_credit_portion_41h(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 41(h)(2) payroll tax credit portion: the least of the elected amount, the section 41(a) credit before this election, or the section 39 carryforward from the year";
}
relation section_41h_election_effective(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "the section 41(h) election is validly in effect for the taxable year (the power's own effect; a single no-argument marker so the amount can be computed by an ordinary rule from the raw elected/credit/carryforward facts)";
}
@source(IRC_S41_H, quote = "At the election of a qualified small business for any taxable year, section 3111(f) shall apply to the payroll tax credit portion of the credit otherwise determined under subsection (a) for the taxable year and such portion shall not be treated (other than for purposes of section 280C) as a credit determined under subsection (a).")
rule Section41hElectionPower strict {
    for taxpayer: Person;
    for y: TaxableYear;
    for specified: Money;
    when section_41h_election_filed(taxpayer, y, specified);
    then power Section41hPayrollTaxElection {
        holder taxpayer;
        exercise section_41h_election_filed(taxpayer, y, specified);
        valid_when qualified_small_business_41h(taxpayer, y);
        effect section_41h_election_effective(taxpayer, y);
    };
}
@source(IRC_S41_H, quote = "the payroll tax credit portion of the credit determined under subsection (a) with respect to any qualified small business for any taxable year is the least of—\n(A) the amount specified in the election made under this subsection,\n(B) the credit determined under subsection (a) for the taxable year (determined before the application of this subsection), or\n(C) in the case of a qualified small business other than a partnership or S corporation, the amount of the business credit carryforward under section 39 carried from the taxable year (determined before the application of this subsection to the taxable year).")
rule PayrollTaxCreditPortion41h defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for specified: Money;
    for credit_before: Money;
    for carryforward: Money;
    when section_41h_election_effective(taxpayer, y);
    when section_41h_election_filed(taxpayer, y, specified);
    when research_credit(taxpayer, y, credit_before);
    when section_39_business_credit_carryforward_from_year(taxpayer, y, carryforward);
    then payroll_tax_credit_portion_41h(taxpayer, y, min(specified, min(credit_before, carryforward)));
}
