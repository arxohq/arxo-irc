// Section 25C — the definitions of (c) qualified energy efficiency improvements, (d) residential energy property expenditures and
// qualified energy property, (e) home energy audit, the (f) special rules, the (g) basis reduction and the (h) qualified product
// identification number requirement. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391).
// Companion of `25c-energy-efficient-home-improvement-credit.law`; its credit rules read category expenditure totals as case facts
// and are NOT rewired to require these relations.
//
// Judgment calls: the Energy Star, Consortium for Energy Efficiency and IECC tests are case facts about the item (the standard
// itself is not in the corpus); the IECC year test is modelled (the standard in effect at the beginning of the calendar year 2 years
// before the year of placement in service); "owned and used ... as principal residence (section 121)" is one case fact; the
// termination of the section (section 25C(i)) stays with the credit module.

use self::{
    Asset,
    CleanFuelKind30C,
    IRC_S25C_C,
    IRC_S25C_D,
    IRC_S25C_E,
    IRC_S25C_F,
    IRC_S25C_G,
    IRC_S25C_H,
    Individual,
    Person,
    TaxableYear,
};

pub enum EnvelopeKind25C { InsulationOrAirSealing, WindowOrSkylight, ExteriorDoor }
pub enum EnergyPropertyKind25C { HeatPumpWaterHeater, HeatPump, CentralAirConditioner, FuelWaterHeater, FuelFurnaceOrBoiler, BiomassStoveOrBoiler, OilFurnaceOrBoiler, Panelboard }
pub enum FuelKind25C { BiodieselOrRenewableDiesel, SecondGenerationBiofuel, TransportationFuel45Z, OtherFuel }

// --- (c): qualified energy efficiency improvements ----------------------------------------------------------------------------------------------------

pub relation envelope_component_kind_25c(component: Asset, kind: EnvelopeKind25C) kind empirical {
    label en official "the kind of the building envelope component: insulation material or system (including air sealing), exterior window (including skylight), or exterior door (section 25C(c)(3)) — case-asserted";
}
pub relation insulation_primarily_designed_to_reduce_heat_loss_or_gain_25c(component: Asset) kind empirical {
    label en official "the insulation material or system is specifically and primarily designed to reduce the heat loss or gain of a dwelling unit when installed in or on it (section 25C(c)(3)(A)) — case-asserted";
}
pub relation building_envelope_component_25c(component: Asset) kind institutional {
    label en official "section 25C(c)(3): a building envelope component is insulation or an air sealing system specifically and primarily designed to reduce heat loss or gain, an exterior window (including skylight), or an exterior door";
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "any insulation material or system, including air sealing material or system, which is specifically and primarily designed to reduce the heat loss or gain of a dwelling unit when installed in or on such dwelling unit")
rule BuildingEnvelopeInsulation25cRule(component: Asset) strict {
    when envelope_component_kind_25c(component, InsulationOrAirSealing);
    when insulation_primarily_designed_to_reduce_heat_loss_or_gain_25c(component);
    then building_envelope_component_25c(component);
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "exterior windows (including skylights)")
rule BuildingEnvelopeWindow25cRule(component: Asset) strict {
    when envelope_component_kind_25c(component, WindowOrSkylight);
    then building_envelope_component_25c(component);
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "exterior doors")
rule BuildingEnvelopeDoor25cRule(component: Asset) strict {
    when envelope_component_kind_25c(component, ExteriorDoor);
    then building_envelope_component_25c(component);
}
pub relation meets_energy_star_most_efficient_certification_25c(component: Asset) kind empirical {
    label en official "the exterior window or skylight meets Energy Star most efficient certification requirements (section 25C(c)(2)(A)) — case-asserted";
}
pub relation meets_applicable_energy_star_door_requirements_25c(component: Asset) kind empirical {
    label en official "the exterior door meets applicable Energy Star requirements (section 25C(c)(2)(B)) — case-asserted";
}
pub relation component_placed_in_service_year_25c(component: Asset, year: Decimal) kind empirical {
    label en official "the calendar year in which the component is placed in service — case-asserted";
}
pub relation iecc_standard_year_met_25c(component: Asset, year: Decimal) kind empirical {
    label en official "the component meets the prescriptive criteria established by the International Energy Conservation Code standard in effect as of the beginning of this calendar year (section 25C(c)(2)(C)) — case-asserted";
}
pub relation energy_efficient_building_envelope_component_25c(component: Asset) kind institutional {
    label en official "section 25C(c)(2): a building envelope component meeting Energy Star most efficient certification (window or skylight), applicable Energy Star requirements (door), or the prescriptive criteria of the IECC standard in effect at the beginning of the calendar year 2 years before the year of placement in service (other components)";
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "in the case of an exterior window or skylight, Energy Star most efficient certification requirements")
rule EnergyEfficientEnvelopeWindow25cRule(component: Asset) strict {
    when building_envelope_component_25c(component);
    when envelope_component_kind_25c(component, WindowOrSkylight);
    when meets_energy_star_most_efficient_certification_25c(component);
    then energy_efficient_building_envelope_component_25c(component);
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "in the case of an exterior door, applicable Energy Star requirements")
rule EnergyEfficientEnvelopeDoor25cRule(component: Asset) strict {
    when building_envelope_component_25c(component);
    when envelope_component_kind_25c(component, ExteriorDoor);
    when meets_applicable_energy_star_door_requirements_25c(component);
    then energy_efficient_building_envelope_component_25c(component);
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "in the case of any other component, the prescriptive criteria for such component established by the most recent International Energy Conservation Code standard in effect as of the beginning of the calendar year which is 2 years prior to the calendar year in which such component is placed in service")
rule EnergyEfficientEnvelopeOther25cRule(component: Asset, placed_year: Decimal, standard_year: Decimal) strict {
    when building_envelope_component_25c(component);
    when envelope_component_kind_25c(component, InsulationOrAirSealing);
    when component_placed_in_service_year_25c(component, placed_year);
    when iecc_standard_year_met_25c(component, standard_year);
    when standard_year == placed_year - 2.0;
    then energy_efficient_building_envelope_component_25c(component);
}
pub relation installed_in_us_dwelling_that_is_principal_residence_25c(taxpayer: Individual, component: Asset) kind empirical {
    label en official "the component is installed in or on a dwelling unit located in the United States and owned and used by the taxpayer as the taxpayer's principal residence within the meaning of section 121 (section 25C(c)(1)(A)) — case-asserted";
}
pub relation original_use_commences_with_taxpayer_25c(taxpayer: Individual, component: Asset) kind empirical {
    label en official "the original use of the component commences with the taxpayer (section 25C(c)(1)(B)) — case-asserted";
}
pub relation expected_years_in_use_25c(component: Asset, years: Decimal) kind empirical {
    label en official "the number of years the component can reasonably be expected to remain in use (section 25C(c)(1)(C)) — case-asserted";
}
pub relation qualified_energy_efficiency_improvement_25c(taxpayer: Individual, component: Asset) kind institutional {
    label en official "section 25C(c)(1): an energy efficient building envelope component installed in the taxpayer's US principal residence, with original use commencing with the taxpayer, reasonably expected to remain in use at least 5 years";
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "The term \"qualified energy efficiency improvements\" means any energy efficient building envelope component")
rule QualifiedEnergyEfficiencyImprovement25cRule(taxpayer: Individual, component: Asset, years: Decimal) strict {
    when energy_efficient_building_envelope_component_25c(component);
    when installed_in_us_dwelling_that_is_principal_residence_25c(taxpayer, component);
    when original_use_commences_with_taxpayer_25c(taxpayer, component);
    when expected_years_in_use_25c(component, years);
    when years >= 5.0;
    then qualified_energy_efficiency_improvement_25c(taxpayer, component);
}
pub relation manufactured_home_conforms_to_federal_standards_25c(unit: Asset) kind empirical {
    label en official "the manufactured home conforms to the Federal Manufactured Home Construction and Safety Standards (part 3280 of title 24, Code of Federal Regulations) (section 25C(c)(4)) — case-asserted";
}
pub relation dwelling_unit_kind_house_or_apartment_25c(unit: Asset) kind empirical {
    label en official "the unit is a house, apartment or other dwelling unit other than a manufactured home — case-asserted";
}
pub relation dwelling_unit_25c(unit: Asset) kind institutional {
    label en official "section 25C(c)(4): the term dwelling unit includes a manufactured home conforming to the federal construction and safety standards";
}
@source(IRC_S25C_C, relation = formalizes, coverage = exact, quote = "The term \"dwelling unit\" includes a manufactured home which conforms to Federal Manufactured Home Construction and Safety Standards")
rule DwellingUnitManufactured25cRule(unit: Asset) strict {
    when manufactured_home_conforms_to_federal_standards_25c(unit);
    then dwelling_unit_25c(unit);
}
rule DwellingUnitOrdinary25cRule(unit: Asset) strict {
    when dwelling_unit_kind_house_or_apartment_25c(unit);
    then dwelling_unit_25c(unit);
}

// --- (d): residential energy property expenditures and qualified energy property ---------------------------------------------------------------

pub relation energy_property_kind_25c(equip: Asset, kind: EnergyPropertyKind25C) kind empirical {
    label en official "the kind of the property: heat pump water heater, heat pump, central air conditioner, natural gas, propane or oil water heater or furnace or boiler, biomass stove or boiler, oil furnace or hot water boiler, or panelboard work (section 25C(d)(2)) — case-asserted";
}
pub relation meets_highest_cee_tier_25c(equip: Asset) kind empirical {
    label en official "the property meets or exceeds the highest efficiency tier (not including any advanced tier) established by the Consortium for Energy Efficiency in effect as of the beginning of the calendar year in which it is placed in service (section 25C(d)(2)(A)) — case-asserted";
}
pub relation item_placed_in_service_on_25c(equip: Asset, on: Date) kind empirical {
    label en official "the date the property is placed in service — case-asserted";
}
pub relation biomass_heats_us_residence_or_its_water_25c(equip: Asset) kind empirical {
    label en official "the biomass stove or boiler uses the burning of biomass fuel to heat a dwelling unit in the United States used as a residence by the taxpayer, or to heat water for it (section 25C(d)(2)(B)(i)) — case-asserted";
}
pub relation thermal_efficiency_higher_heating_value_25c(equip: Asset, efficiency: Decimal) kind empirical {
    label en official "the thermal efficiency rating of the biomass stove or boiler, as a fraction, measured by the higher heating value of the fuel (section 25C(d)(2)(B)(ii)) — case-asserted";
}
pub relation meets_2021_energy_star_criteria_25c(equip: Asset) kind empirical {
    label en official "the oil furnace or hot water boiler meets or exceeds 2021 Energy Star efficiency criteria (section 25C(d)(2)(C)(i)(I)) — case-asserted";
}
pub relation annual_fuel_utilization_efficiency_25c(equip: Asset, rate: Decimal) kind empirical {
    label en official "the annual fuel utilization efficiency rate of the oil furnace or hot water boiler (section 25C(d)(2)(C)(ii)(I)) — case-asserted";
}
pub relation rated_eligible_fuel_blend_share_25c(equip: Asset, share: Decimal) kind empirical {
    label en official "the share by volume of an eligible fuel in the fuel blends for which the manufacturer rates the oil furnace or boiler, as a fraction (section 25C(d)(2)(C)) — case-asserted";
}
pub relation fuel_kind_25c(fuel: Asset, kind: FuelKind25C) kind empirical {
    label en official "the kind of the fuel (section 25C(d)(3)) — case-asserted";
}
pub relation eligible_fuel_25c(fuel: Asset) kind institutional {
    label en official "section 25C(d)(3): biodiesel and renewable diesel (section 40A), second generation biofuel (section 40) and transportation fuel (section 45Z(d)(5))";
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "biodiesel and renewable diesel (within the meaning of section 40A)")
rule EligibleFuelBiodiesel25cRule(fuel: Asset) strict {
    when fuel_kind_25c(fuel, BiodieselOrRenewableDiesel);
    then eligible_fuel_25c(fuel);
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "second generation biofuel (within the meaning of section 40)")
rule EligibleFuelSecondGeneration25cRule(fuel: Asset) strict {
    when fuel_kind_25c(fuel, SecondGenerationBiofuel);
    then eligible_fuel_25c(fuel);
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "transportation fuel (as defined in section 45Z(d)(5))")
rule EligibleFuelTransportation25cRule(fuel: Asset) strict {
    when fuel_kind_25c(fuel, TransportationFuel45Z);
    then eligible_fuel_25c(fuel);
}
pub relation qualified_energy_property_a_to_c_25c(equip: Asset) kind institutional {
    label en official "section 25C(d)(2)(A)-(C): CEE-tier property (heat pump water heater, heat pump, central air conditioner, fuel water heater, furnace or boiler), a biomass stove or boiler of at least 75 percent thermal efficiency, or an oil furnace or boiler meeting the placed-in-service window tests";
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "Any of the following which meet or exceed the highest efficiency tier (not including any advanced tier) established by the Consortium for Energy Efficiency which is in effect as of the beginning of the calendar year in which the property is placed in service")
rule QualifiedEnergyPropertyCeeTier25cRule(equip: Asset, kind: EnergyPropertyKind25C) strict {
    when energy_property_kind_25c(equip, kind);
    when meets_highest_cee_tier_25c(equip);
    when kind != BiomassStoveOrBoiler;
    when kind != OilFurnaceOrBoiler;
    when kind != Panelboard;
    then qualified_energy_property_a_to_c_25c(equip);
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "has a thermal efficiency rating of at least 75 percent (measured by the higher heating value of the fuel)")
rule QualifiedEnergyPropertyBiomass25cRule(equip: Asset, efficiency: Decimal) strict {
    when energy_property_kind_25c(equip, BiomassStoveOrBoiler);
    when biomass_heats_us_residence_or_its_water_25c(equip);
    when thermal_efficiency_higher_heating_value_25c(equip, efficiency);
    when efficiency >= 0.75;
    then qualified_energy_property_a_to_c_25c(equip);
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "is placed in service after December 31, 2022, and before January 1, 2027, and")
rule QualifiedEnergyPropertyOil2023To2026Rule(equip: Asset, on: Date, blend: Decimal) strict {
    when energy_property_kind_25c(equip, OilFurnaceOrBoiler);
    when item_placed_in_service_on_25c(equip, on);
    when on > @2022-12-31;
    when on < @2027-01-01;
    when meets_2021_energy_star_criteria_25c(equip);
    when rated_eligible_fuel_blend_share_25c(equip, blend);
    when blend >= 0.20;
    then qualified_energy_property_a_to_c_25c(equip);
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "achieves an annual fuel utilization efficiency rate of not less than 90")
rule QualifiedEnergyPropertyOilAfter2026Rule(equip: Asset, on: Date, afue: Decimal, blend: Decimal) strict {
    when energy_property_kind_25c(equip, OilFurnaceOrBoiler);
    when item_placed_in_service_on_25c(equip, on);
    when on > @2026-12-31;
    when annual_fuel_utilization_efficiency_25c(equip, afue);
    when afue >= 90.0;
    when rated_eligible_fuel_blend_share_25c(equip, blend);
    when blend >= 0.50;
    then qualified_energy_property_a_to_c_25c(equip);
}
pub relation panelboard_consistent_with_national_electric_code_25c(equip: Asset) kind empirical {
    label en official "the panelboard work is installed in a manner consistent with the National Electric Code (section 25C(d)(2)(D)(i)) — case-asserted";
}
pub relation panelboard_load_capacity_amps_25c(equip: Asset, amps: Decimal) kind empirical {
    label en official "the load capacity of the panelboard, sub-panelboard, branch circuits or feeders in amps (section 25C(d)(2)(D)(ii)) — case-asserted";
}
pub relation panelboard_installed_with_improvement_25c(equip: Asset, taxpayer: Individual, other: Asset) kind empirical {
    label en official "the panelboard work is installed in conjunction with the other item: a qualified energy efficiency improvement or a qualified energy property of subparagraphs (A)-(C) for which a credit is allowed (section 25C(d)(2)(D)(iii)) — case-asserted";
}
pub relation credit_allowed_for_item_expenditure_25c(taxpayer: Individual, other: Asset) kind empirical {
    label en official "a credit is allowed under section 25C for the expenditure with respect to the other item — case-asserted";
}
pub relation panelboard_enables_use_of_other_25c(equip: Asset, other: Asset) kind empirical {
    label en official "the panelboard work enables the installation and use of the other item (section 25C(d)(2)(D)(iv)) — case-asserted";
}
pub relation qualified_energy_property_panelboard_25c(equip: Asset, taxpayer: Individual) kind institutional {
    label en official "section 25C(d)(2)(D): an improvement to or replacement of a panelboard, sub-panelboard, branch circuits or feeders consistent with the National Electric Code, of at least 200 amps, installed in conjunction with, and enabling the use of, qualified improvements or property with an allowed credit";
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "Any improvement to, or replacement of, a panelboard, sub-panelboard, branch circuits, or feeders which")
rule QualifiedEnergyPropertyPanelboardImprovement25cRule(equip: Asset, taxpayer: Individual, other: Asset, amps: Decimal) strict {
    when energy_property_kind_25c(equip, Panelboard);
    when panelboard_consistent_with_national_electric_code_25c(equip);
    when panelboard_load_capacity_amps_25c(equip, amps);
    when amps >= 200.0;
    when panelboard_installed_with_improvement_25c(equip, taxpayer, other);
    when qualified_energy_efficiency_improvement_25c(taxpayer, other);
    when panelboard_enables_use_of_other_25c(equip, other);
    then qualified_energy_property_panelboard_25c(equip, taxpayer);
}
rule QualifiedEnergyPropertyPanelboardProperty25cRule(equip: Asset, taxpayer: Individual, other: Asset, amps: Decimal) strict {
    when energy_property_kind_25c(equip, Panelboard);
    when panelboard_consistent_with_national_electric_code_25c(equip);
    when panelboard_load_capacity_amps_25c(equip, amps);
    when amps >= 200.0;
    when panelboard_installed_with_improvement_25c(equip, taxpayer, other);
    when qualified_energy_property_a_to_c_25c(other);
    when credit_allowed_for_item_expenditure_25c(taxpayer, other);
    when panelboard_enables_use_of_other_25c(equip, other);
    then qualified_energy_property_panelboard_25c(equip, taxpayer);
}
pub relation installed_on_us_dwelling_used_as_residence_25c(taxpayer: Individual, equip: Asset) kind empirical {
    label en official "the property is installed on or in connection with a dwelling unit located in the United States and used as a residence by the taxpayer (section 25C(d)(1)(A)) — case-asserted";
}
pub relation originally_placed_in_service_by_taxpayer_25c(taxpayer: Individual, equip: Asset) kind empirical {
    label en official "the property is originally placed in service by the taxpayer (section 25C(d)(1)(B)) — case-asserted";
}
pub relation property_cost_25c(taxpayer: Individual, equip: Asset, cost: Money) kind empirical {
    label en official "the expenditure made by the taxpayer for the property itself — case-asserted";
}
pub relation onsite_labor_cost_25c(taxpayer: Individual, equip: Asset, labor: Money) kind empirical {
    label en official "the labor costs properly allocable to the onsite preparation, assembly, or original installation of the property (section 25C(d)(1), last sentence) — case-asserted";
}
pub relation residential_energy_property_expenditure_25c(taxpayer: Individual, equip: Asset, amount: Money) kind institutional {
    label en official "section 25C(d)(1): the expenditure for qualified energy property installed on or in connection with the taxpayer's US residence and originally placed in service by the taxpayer, including labor costs allocable to onsite preparation, assembly or original installation";
}
@source(IRC_S25C_D, relation = formalizes, coverage = exact, quote = "Such term includes expenditures for labor costs properly allocable to the onsite preparation, assembly, or original installation of the property.")
rule ResidentialEnergyPropertyExpenditureWithLabor25cRule(taxpayer: Individual, equip: Asset, cost: Money, labor: Money) strict {
    when installed_on_us_dwelling_used_as_residence_25c(taxpayer, equip);
    when originally_placed_in_service_by_taxpayer_25c(taxpayer, equip);
    when qualified_energy_property_a_to_c_25c(equip);
    when property_cost_25c(taxpayer, equip, cost);
    when onsite_labor_cost_25c(taxpayer, equip, labor);
    then residential_energy_property_expenditure_25c(taxpayer, equip, cost + labor);
}
rule ResidentialEnergyPropertyExpenditureWithoutLabor25cRule(taxpayer: Individual, equip: Asset, cost: Money) strict {
    when installed_on_us_dwelling_used_as_residence_25c(taxpayer, equip);
    when originally_placed_in_service_by_taxpayer_25c(taxpayer, equip);
    when qualified_energy_property_a_to_c_25c(equip);
    when property_cost_25c(taxpayer, equip, cost);
    when not_known(labor_cost_asserted_25c(taxpayer, equip));
    then residential_energy_property_expenditure_25c(taxpayer, equip, cost);
}
relation labor_cost_asserted_25c(taxpayer: Individual, equip: Asset) kind institutional;
rule LaborCostAsserted25cRule(taxpayer: Individual, equip: Asset, labor: Money) strict {
    when onsite_labor_cost_25c(taxpayer, equip, labor);
    then labor_cost_asserted_25c(taxpayer, equip);
}

// --- (e): the home energy audit ----------------------------------------------------------------------------------------------------------------------------

pub relation audit_of_us_principal_residence_25c(audit: Asset, taxpayer: Individual) kind empirical {
    label en official "the inspection and written report concern a dwelling unit located in the United States and owned or used by the taxpayer as the taxpayer's principal residence within the meaning of section 121 (section 25C(e)) — case-asserted";
}
pub relation audit_identifies_improvements_with_savings_estimates_25c(audit: Asset) kind empirical {
    label en official "the report identifies the most significant and cost-effective energy efficiency improvements, including an estimate of the energy and cost savings for each (section 25C(e)(1)) — case-asserted";
}
external judgment relation home_energy_auditor_meets_secretary_requirements_25c(audit: Asset) {
    authority Secretary;
    label en official "the audit is conducted and prepared by a home energy auditor that meets the certification or other requirements specified by the Secretary in regulations or other guidance (section 25C(e)(2))";
}
pub relation home_energy_audit_25c(audit: Asset, taxpayer: Individual) kind institutional {
    label en official "section 25C(e): an inspection and written report on the taxpayer's US principal residence that identifies the most significant and cost-effective improvements with savings estimates and is prepared by a home energy auditor meeting the Secretary's requirements";
}
@source(IRC_S25C_E, relation = formalizes, coverage = exact, quote = "the term \"home energy audit\" means an inspection and written report with respect to a dwelling unit located in the United States and owned or used by the taxpayer as the taxpayer's principal residence")
rule HomeEnergyAudit25cRule(audit: Asset, taxpayer: Individual) defeasible {
    when audit_of_us_principal_residence_25c(audit, taxpayer);
    when audit_identifies_improvements_with_savings_estimates_25c(audit);
    when home_energy_auditor_meets_secretary_requirements_25c(audit);
    then home_energy_audit_25c(audit, taxpayer);
}

// --- (f)(2)-(3): several dwelling units and subsidized energy financing ----------------------------------------------------------------------------

pub relation expenditure_for_dwelling_unit_25c(taxpayer: Individual, equip: Asset, unit: Asset, amount: Money) kind empirical {
    label en official "the amount of the expenditure made with respect to the dwelling unit, where one expenditure is made with respect to two or more dwelling units (section 25C(f)(2)) — case-asserted";
}
pub relation qualifying_expenditure_for_unit_25c(taxpayer: Individual, equip: Asset, unit: Asset, amount: Money) kind institutional {
    label en official "section 25C(f)(2): an expenditure made with respect to two or more dwelling units does not fail to qualify for that reason, and the credit is computed separately on the amount made for each unit";
}
@source(IRC_S25C_F, relation = formalizes, coverage = exact, quote = "Any expenditure otherwise qualifying as an expenditure under this section shall not be treated as failing to so qualify merely because such expenditure was made with respect to two or more dwelling units.")
rule QualifyingExpenditureForUnit25cRule(taxpayer: Individual, equip: Asset, unit: Asset, amount: Money, whole: Money) strict {
    when residential_energy_property_expenditure_25c(taxpayer, equip, whole);
    when expenditure_for_dwelling_unit_25c(taxpayer, equip, unit, amount);
    when dwelling_unit_25c(unit);
    then qualifying_expenditure_for_unit_25c(taxpayer, equip, unit, amount);
}
pub relation expenditure_from_subsidized_energy_financing_25c(taxpayer: Individual, equip: Asset, amount: Money) kind empirical {
    label en official "the part of the expenditure made from subsidized energy financing (section 48(a)(4)(C)) (section 25C(f)(3)) — case-asserted";
}
pub relation expenditure_taken_into_account_25c(taxpayer: Individual, equip: Asset, amount: Money) kind institutional {
    label en official "section 25C(f)(3): expenditures made from subsidized energy financing are not taken into account";
}
@source(IRC_S25C_F, relation = formalizes, coverage = exact, quote = "there shall not be taken into account expenditures which are made from subsidized energy financing")
rule ExpenditureTakenIntoAccount25cRule(taxpayer: Individual, equip: Asset, amount: Money, financed: Money) strict {
    when residential_energy_property_expenditure_25c(taxpayer, equip, amount);
    when expenditure_from_subsidized_energy_financing_25c(taxpayer, equip, financed);
    then expenditure_taken_into_account_25c(taxpayer, equip, max(amount - financed, 0 USD));
}
rule ExpenditureTakenIntoAccountUnfinanced25cRule(taxpayer: Individual, equip: Asset, amount: Money) strict {
    when residential_energy_property_expenditure_25c(taxpayer, equip, amount);
    when not_known(financed_asserted_25c(taxpayer, equip));
    then expenditure_taken_into_account_25c(taxpayer, equip, amount);
}
relation financed_asserted_25c(taxpayer: Individual, equip: Asset) kind institutional;
rule FinancedAsserted25cRule(taxpayer: Individual, equip: Asset, financed: Money) strict {
    when expenditure_from_subsidized_energy_financing_25c(taxpayer, equip, financed);
    then financed_asserted_25c(taxpayer, equip);
}

// --- (g): the basis reduction ------------------------------------------------------------------------------------------------------------------------------

pub relation basis_increase_from_expenditure_25c(taxpayer: Individual, equip: Asset, amount: Money) kind empirical {
    label en official "the increase in the basis of the property that would, but for subsection (g), result from the expenditure — case-asserted";
}
pub relation credit_allowed_for_property_25c(taxpayer: Individual, equip: Asset, amount: Money) kind empirical {
    label en official "the credit allowed under section 25C for the expenditure with respect to the property — case-asserted";
}
pub relation basis_increase_after_credit_25c(taxpayer: Individual, equip: Asset, amount: Money) kind institutional {
    label en official "section 25C(g): the increase in the basis of the property is reduced by the amount of the credit allowed (not below zero)";
}
@source(IRC_S25C_G, relation = formalizes, coverage = exact, quote = "the increase in the basis of such property which would (but for this subsection) result from such expenditure shall be reduced by the amount of the credit so allowed")
rule BasisIncreaseAfterCredit25cRule(taxpayer: Individual, equip: Asset, increase: Money, credit: Money) strict {
    when basis_increase_from_expenditure_25c(taxpayer, equip, increase);
    when credit_allowed_for_property_25c(taxpayer, equip, credit);
    then basis_increase_after_credit_25c(taxpayer, equip, max(increase - credit, 0 USD));
}

// --- (h): the qualified product identification number -----------------------------------------------------------------------------------------------

pub relation manufacturer_agreement_with_secretary_25c(manufacturer: Person) kind empirical {
    label en official "the manufacturer enters into an agreement with the Secretary (section 25C(h)(3)) — case-asserted";
}
pub relation agreement_provides_unique_number_assignment_25c(manufacturer: Person) kind empirical {
    label en official "the agreement provides that the manufacturer will assign a product identification number to each item, unique to each item (section 25C(h)(3)(A)) — case-asserted";
}
pub relation agreement_provides_labeling_25c(manufacturer: Person) kind empirical {
    label en official "the agreement provides that the manufacturer will label each item with the number as the Secretary may provide (section 25C(h)(3)(B)) — case-asserted";
}
pub relation agreement_provides_periodic_reports_25c(manufacturer: Person) kind empirical {
    label en official "the agreement provides that the manufacturer will make periodic written reports to the Secretary of the numbers assigned (section 25C(h)(3)(C)) — case-asserted";
}
pub relation qualified_manufacturer_25c(manufacturer: Person) kind institutional {
    label en official "section 25C(h)(3): a manufacturer that enters into an agreement with the Secretary to assign unique product identification numbers, label the items, and make periodic written reports";
}
@source(IRC_S25C_H, relation = formalizes, coverage = exact, quote = "the term \"qualified manufacturer\" means any manufacturer of specified property which enters into an agreement with the Secretary")
rule QualifiedManufacturer25cRule(manufacturer: Person) strict {
    when manufacturer_agreement_with_secretary_25c(manufacturer);
    when agreement_provides_unique_number_assignment_25c(manufacturer);
    when agreement_provides_labeling_25c(manufacturer);
    when agreement_provides_periodic_reports_25c(manufacturer);
    then qualified_manufacturer_25c(manufacturer);
}
pub relation item_produced_by_25c(equip: Asset, manufacturer: Person) kind empirical {
    label en official "the item is produced by the manufacturer — case-asserted";
}
pub relation number_assigned_by_25c(equip: Asset, manufacturer: Person) kind empirical {
    label en official "the item's product identification number was assigned by the manufacturer pursuant to the methodology of its agreement (section 25C(h)(2)) — case-asserted";
}
pub relation qualified_product_identification_number_25c(equip: Asset) kind institutional {
    label en official "section 25C(h)(2): the product identification number assigned to the item by the qualified manufacturer pursuant to its methodology";
}
@source(IRC_S25C_H, relation = formalizes, coverage = exact, quote = "the product identification number assigned to such item by the qualified manufacturer pursuant to the methodology referred to in paragraph (3)")
rule QualifiedProductIdentificationNumber25cRule(equip: Asset, manufacturer: Person) strict {
    when number_assigned_by_25c(equip, manufacturer);
    when qualified_manufacturer_25c(manufacturer);
    then qualified_product_identification_number_25c(equip);
}
pub relation specified_property_25c(equip: Asset) kind institutional {
    label en official "section 25C(h)(4): any qualified energy property and any property described in subparagraph (B) or (C) of subsection (c)(3) (exterior windows and skylights, exterior doors)";
}
@source(IRC_S25C_H, relation = formalizes, coverage = exact, quote = "the term \"specified property\" means any qualified energy property")
rule SpecifiedPropertyEnergy25cRule(equip: Asset) strict {
    when qualified_energy_property_a_to_c_25c(equip);
    then specified_property_25c(equip);
}
rule SpecifiedPropertyEnvelopeWindow25cRule(equip: Asset) strict {
    when envelope_component_kind_25c(equip, WindowOrSkylight);
    then specified_property_25c(equip);
}
rule SpecifiedPropertyEnvelopeDoor25cRule(equip: Asset) strict {
    when envelope_component_kind_25c(equip, ExteriorDoor);
    then specified_property_25c(equip);
}
pub relation pin_included_on_return_25c(taxpayer: Individual, equip: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes the qualified product identification number of the item on the return of tax for the taxable year (section 25C(h)(1)(B)) — case-asserted";
}
pub relation specified_property_credit_permitted_25c(taxpayer: Individual, equip: Asset, y: TaxableYear) kind institutional {
    label en official "section 25C(h)(1): no credit for specified property placed in service after 2024-12-31 unless the item is produced by a qualified manufacturer and the taxpayer includes its qualified product identification number on the return";
}
@source(IRC_S25C_H, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under subsection (a) with respect to any item of specified property placed in service after December 31, 2024, unless")
pub relation credit_claimed_for_item_25c(taxpayer: Individual, equip: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer claims the credit under section 25C for the item of specified property in the taxable year — case-asserted";
}
rule SpecifiedPropertyPermittedBefore2025Rule(taxpayer: Individual, equip: Asset, y: TaxableYear, on: Date) strict {
    when credit_claimed_for_item_25c(taxpayer, equip, y);
    when specified_property_25c(equip);
    when item_placed_in_service_on_25c(equip, on);
    when on <= @2024-12-31;
    then specified_property_credit_permitted_25c(taxpayer, equip, y);
}
rule SpecifiedPropertyPermittedAfter2024Rule(taxpayer: Individual, equip: Asset, y: TaxableYear, on: Date, manufacturer: Person) strict {
    when credit_claimed_for_item_25c(taxpayer, equip, y);
    when specified_property_25c(equip);
    when item_placed_in_service_on_25c(equip, on);
    when on > @2024-12-31;
    when item_produced_by_25c(equip, manufacturer);
    when qualified_manufacturer_25c(manufacturer);
    when qualified_product_identification_number_25c(equip);
    when pin_included_on_return_25c(taxpayer, equip, y);
    then specified_property_credit_permitted_25c(taxpayer, equip, y);
}
