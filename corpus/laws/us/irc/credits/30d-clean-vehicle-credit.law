// Section 30D — Clean vehicle credit. Stage 2c (IRC-06 stage 2c,
// DECISION-0379). Priority list item: §30D ($3,750 + $3,750, MSRP caps,
// MAGI limits, (d) requirements as classification, FEOC exclusion, PL
// 119-21 termination).
//
// Judgment calls / scope:
// * PL 119-21 section 70502 ("TERMINATION OF CLEAN VEHICLE CREDIT")
//   accelerates the base text's own (h) December 31, 2032 termination to
//   "acquired after September 30, 2025" — but that fragment is NOT among
//   the ones `us.irc.temporal` has pinned (confirmed absent by grep; same
//   "14 of 104" extraction gap as sections 25C/25D/25E/30C, documented in
//   the 25C module's header). This package cannot add it. SOURCE_GAP
//   (TECH-GAPS G391): the (h) rule below reflects the base 2024-Edition
//   December 31, 2032 date, the best CURRENTLY PINNED law.
// * (e)(1)(B)/(e)(2)(B) (the critical-minerals/battery-components
//   applicable-percentage schedules) ARE modelled as genuine year-keyed
//   computations against a case-asserted VALUE PERCENTAGE — real
//   "requirements as classification" per the coordinator's framing, not a
//   blanket case fact. The pre-2024 transitional row (tied to "the date on
//   which the proposed guidance...is issued by the Secretary", an
//   unpinned administrative date) is NOT modelled — TECH-GAPS G391; only
//   the calendar-year-keyed rows (2024 onward) are executable.
// * (d)(1)(A)-(H) (original use, not for resale, qualified manufacturer,
//   Clean Air Act motor-vehicle classification, weight rating, battery
//   capacity/rechargeability, North American final assembly, the seller's
//   information report) is a SINGLE case-asserted bundled classification
//   (`new_clean_vehicle_base_requirements_met`) — TECH_GAP for the 8
//   separate sub-tests, TECH-GAPS G391 (same "one bundled classification"
//   convention this package uses elsewhere for deep multi-part
//   definitions, e.g. section 45R(e)'s employee exclusions).
// * (d)(7) (FEOC "excluded entities") IS modelled as its own gate, keyed to
//   its own two dates (critical minerals: placed in service after December
//   31, 2024; battery components: after December 31, 2023) — a genuine
//   temporal-boundary rule, not folded into the bundled (d)(1) fact.
// * (c) (business-vs-personal-credit characterization: depreciable-property
//   share routed to section 38(b) instead of subpart A) is NOT modelled —
//   TECH_GAP, this module produces a single undifferentiated per-vehicle
//   amount.
// * (f)(1)-(2) (basis reduction, no double benefit), (f)(4)-(5) (foreign-
//   use exclusion via section 50(b)(1), recapture), (f)(7)-(8) (Clean Air
//   Act/motor-vehicle-safety compliance, one credit per VIN) are NOT
//   modelled — case-asserted inputs are read as already reflecting these
//   constraints. (f)(6) (election out) and (f)(9) (VIN-on-return
//   requirement) and (f)(10)/(11) (MAGI and MSRP limitations) ARE modelled.
// * (g) (transfer of the credit to the dealer) is NOT modelled — TECH_GAP,
//   a distinct institutional-effect mechanism this pass did not reach.

use self::{
    Asset,
    IRC_S30D_A,
    IRC_S30D_B,
    IRC_S30D_D,
    IRC_S30D_E,
    IRC_S30D_F,
    IRC_S30D_H,
    Individual,
    TaxableYear,
};

pub relation placed_in_service_date_30d(taxpayer: Individual, vehicle: Asset, on: Date) kind empirical {
    label en official "the date the new clean vehicle was placed in service by the taxpayer — case-asserted";
}
pub relation new_clean_vehicle_base_requirements_met(taxpayer: Individual, vehicle: Asset) kind empirical {
    label en official "section 30D(d)(1)(A)-(H): original use commences with the taxpayer, acquired for use/lease not resale, made by a qualified manufacturer, Clean Air Act motor-vehicle classification, gross vehicle weight under 14,000 lbs, battery capacity >=7 kWh and externally rechargeable, North American final assembly, and the seller's information report — bundled case-asserted classification (TECH-GAPS G391)";
}

// --- §30D(d)(7): FEOC excluded entities -----------------------------------------

pub relation critical_minerals_extracted_by_feoc(vehicle: Asset) kind empirical {
    label en official "any applicable critical mineral in the vehicle's battery was extracted, processed, or recycled by a foreign entity of concern (section 30D(d)(7)(A)) — case-asserted";
}
pub relation battery_components_assembled_by_feoc(vehicle: Asset) kind empirical {
    label en official "any battery component was manufactured or assembled by a foreign entity of concern (section 30D(d)(7)(B)) — case-asserted";
}
pub relation new_clean_vehicle_30d(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "vehicle is a 'new clean vehicle' under section 30D(d): the bundled (d)(1) requirements are met and, for a vehicle placed in service on the applicable FEOC date, no (d)(7) excluded-entity taint";
}
@source(IRC_S30D_D, quote = "any vehicle placed in service after December 31, 2024, with respect to which any of the applicable critical minerals contained in the battery of such vehicle (as described in subsection (e)(1)(A)) were extracted, processed, or recycled by a foreign entity of concern")
rule NewCleanVehicleRule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when new_clean_vehicle_base_requirements_met(taxpayer, vehicle);
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when not_known(critical_minerals_extracted_by_feoc(vehicle));
    when not_known(battery_components_assembled_by_feoc(vehicle));
    then new_clean_vehicle_30d(taxpayer, vehicle);
}
pub relation excluded_entity_30d(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 30D(d)(7): the vehicle is excluded from being a new clean vehicle due to a FEOC taint on or after the applicable date for the relevant battery component";
}
@source(IRC_S30D_D, quote = "any vehicle placed in service after December 31, 2024, with respect to which any of the applicable critical minerals contained in the battery of such vehicle (as described in subsection (e)(1)(A)) were extracted, processed, or recycled by a foreign entity of concern")
rule ExcludedEntityCriticalMineralsRule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2024-12-31;
    when critical_minerals_extracted_by_feoc(vehicle);
    then excluded_entity_30d(taxpayer, vehicle);
}
@source(IRC_S30D_D, quote = "any vehicle placed in service after December 31, 2023, with respect to which any of the components contained in the battery of such vehicle (as described in subsection (e)(2)(A)) were manufactured or assembled by a foreign entity of concern (as so defined)")
rule ExcludedEntityBatteryComponentsRule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2023-12-31;
    when battery_components_assembled_by_feoc(vehicle);
    then excluded_entity_30d(taxpayer, vehicle);
}

// --- §30D(e): critical mineral and battery component requirements --------------

pub relation critical_minerals_value_percentage(vehicle: Asset, pct: Decimal) kind empirical {
    label en official "the percentage of the value of applicable critical minerals in the vehicle's battery sourced/recycled per section 30D(e)(1)(A) — case-asserted (as certified by the qualified manufacturer)";
}
pub relation critical_minerals_applicable_percentage(vehicle: Asset, pct: Decimal) kind institutional {
    label en official "section 30D(e)(1)(B): the applicable critical-minerals percentage by placed-in-service calendar year";
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service during calendar year 2024, 50 percent")
rule CriticalMineralsApplicablePercentage2024Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2023-12-31;
    when on < @2025-01-01;
    then critical_minerals_applicable_percentage(vehicle, 0.50);
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service during calendar year 2025, 60 percent")
rule CriticalMineralsApplicablePercentage2025Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2024-12-31;
    when on < @2026-01-01;
    then critical_minerals_applicable_percentage(vehicle, 0.60);
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service during calendar year 2026, 70 percent")
rule CriticalMineralsApplicablePercentage2026Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2025-12-31;
    when on < @2027-01-01;
    then critical_minerals_applicable_percentage(vehicle, 0.70);
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service after December 31, 2026, 80 percent")
rule CriticalMineralsApplicablePercentageAfter2026Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2026-12-31;
    then critical_minerals_applicable_percentage(vehicle, 0.80);
}
pub relation critical_minerals_requirement_satisfied_30d(vehicle: Asset) kind institutional {
    label en official "section 30D(e)(1)(A): the critical-minerals value percentage meets or exceeds the applicable percentage for the vehicle's placed-in-service year";
}
@source(IRC_S30D_E, quote = "is equal to or greater than the applicable percentage (as certified by the qualified manufacturer, in such form or manner as prescribed by the Secretary)")
rule CriticalMineralsRequirementSatisfiedRule(vehicle: Asset, value_pct: Decimal, applicable_pct: Decimal) strict {
    when critical_minerals_value_percentage(vehicle, value_pct);
    when critical_minerals_applicable_percentage(vehicle, applicable_pct);
    when value_pct >= applicable_pct;
    then critical_minerals_requirement_satisfied_30d(vehicle);
}

pub relation battery_components_value_percentage(vehicle: Asset, pct: Decimal) kind empirical {
    label en official "the percentage of the value of the vehicle battery's components manufactured or assembled in North America, per section 30D(e)(2)(A) — case-asserted";
}
pub relation battery_components_applicable_percentage(vehicle: Asset, pct: Decimal) kind institutional {
    label en official "section 30D(e)(2)(B): the applicable battery-components percentage by placed-in-service calendar year";
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service during calendar year 2024 or 2025, 60 percent")
rule BatteryComponentsApplicablePercentage2024_2025Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2023-12-31;
    when on < @2026-01-01;
    then battery_components_applicable_percentage(vehicle, 0.60);
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service during calendar year 2026, 70 percent")
rule BatteryComponentsApplicablePercentage2026Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2025-12-31;
    when on < @2027-01-01;
    then battery_components_applicable_percentage(vehicle, 0.70);
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service during calendar year 2027, 80 percent")
rule BatteryComponentsApplicablePercentage2027Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2026-12-31;
    when on < @2028-01-01;
    then battery_components_applicable_percentage(vehicle, 0.80);
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service during calendar year 2028, 90 percent")
rule BatteryComponentsApplicablePercentage2028Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2027-12-31;
    when on < @2029-01-01;
    then battery_components_applicable_percentage(vehicle, 0.90);
}
@source(IRC_S30D_E, quote = "in the case of a vehicle placed in service after December 31, 2028, 100 percent")
rule BatteryComponentsApplicablePercentageAfter2028Rule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2028-12-31;
    then battery_components_applicable_percentage(vehicle, 1.00);
}
pub relation battery_components_requirement_satisfied_30d(vehicle: Asset) kind institutional {
    label en official "section 30D(e)(2)(A): the battery-components value percentage meets or exceeds the applicable percentage for the vehicle's placed-in-service year";
}
@source(IRC_S30D_E, quote = "is equal to or greater than the applicable percentage (as certified by the qualified manufacturer, in such form or manner as prescribed by the Secretary)")
rule BatteryComponentsRequirementSatisfiedRule(vehicle: Asset, value_pct: Decimal, applicable_pct: Decimal) strict {
    when battery_components_value_percentage(vehicle, value_pct);
    when battery_components_applicable_percentage(vehicle, applicable_pct);
    when value_pct >= applicable_pct;
    then battery_components_requirement_satisfied_30d(vehicle);
}

// --- §30D(b): per-vehicle dollar limitation -------------------------------------

pub relation critical_minerals_amount_30d(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional;
rule CriticalMineralsAmountPresentRule(taxpayer: Individual, vehicle: Asset) defeasible {
    when new_clean_vehicle_30d(taxpayer, vehicle);
    when critical_minerals_requirement_satisfied_30d(vehicle);
    then critical_minerals_amount_30d(taxpayer, vehicle, 3750.00 USD);
}
rule CriticalMineralsAmountAbsentRule(taxpayer: Individual, vehicle: Asset) defeasible {
    when new_clean_vehicle_30d(taxpayer, vehicle);
    when not_known(critical_minerals_requirement_satisfied_30d(vehicle));
    then critical_minerals_amount_30d(taxpayer, vehicle, 0 USD);
}
pub relation battery_components_amount_30d(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional;
rule BatteryComponentsAmountPresentRule(taxpayer: Individual, vehicle: Asset) defeasible {
    when new_clean_vehicle_30d(taxpayer, vehicle);
    when battery_components_requirement_satisfied_30d(vehicle);
    then battery_components_amount_30d(taxpayer, vehicle, 3750.00 USD);
}
rule BatteryComponentsAmountAbsentRule(taxpayer: Individual, vehicle: Asset) defeasible {
    when new_clean_vehicle_30d(taxpayer, vehicle);
    when not_known(battery_components_requirement_satisfied_30d(vehicle));
    then battery_components_amount_30d(taxpayer, vehicle, 0 USD);
}
pub relation per_vehicle_dollar_limitation_30d(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30D(b)(1): the sum of the critical-minerals and battery-components amounts";
}
@source(IRC_S30D_B, quote = "The amount determined under this subsection with respect to any new clean vehicle is the sum of the amounts determined under paragraphs (2) and (3) with respect to such vehicle.")
rule PerVehicleDollarLimitationRule(taxpayer: Individual, vehicle: Asset, cm: Money, bc: Money) defeasible {
    when critical_minerals_amount_30d(taxpayer, vehicle, cm);
    when battery_components_amount_30d(taxpayer, vehicle, bc);
    then per_vehicle_dollar_limitation_30d(taxpayer, vehicle, cm + bc);
}

// --- §30D(f)(10): MAGI limitation ------------------------------------------------

pub relation modified_agi_30d(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "modified adjusted gross income for the taxable year: AGI increased by amounts excluded under sections 911, 931, or 933 (section 30D(f)(10)(C)) — case-asserted";
}
pub relation modified_agi_preceding_year_30d(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "modified adjusted gross income for the PRECEDING taxable year (section 30D(f)(10)(A)(i)(II)) — case-asserted";
}
relation threshold_amount_30d(status: us.irc.income_individual::FilingStatus, amount: Money) kind institutional;
@source(IRC_S30D_F, quote = "in the case of a joint return or a surviving spouse (as defined in section 2(a)), $300,000")
assert "30d-threshold-joint": threshold_amount_30d(us.irc.income_individual::Joint, 300000.00 USD);
@source(IRC_S30D_F, quote = "in the case of a head of household (as defined in section 2(b)), $225,000")
assert "30d-threshold-hoh": threshold_amount_30d(us.irc.income_individual::HeadOfHousehold, 225000.00 USD);
@source(IRC_S30D_F, quote = "in the case of a taxpayer not described in clause (i) or (ii), $150,000")
assert "30d-threshold-unmarried": threshold_amount_30d(us.irc.income_individual::Unmarried, 150000.00 USD);
assert "30d-threshold-mfs": threshold_amount_30d(us.irc.income_individual::MarriedSeparate, 150000.00 USD);
assert "30d-threshold-estate": threshold_amount_30d(us.irc.income_individual::EstateOrTrust, 150000.00 USD);

pub relation magi_below_threshold_30d(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 30D(f)(10): the lesser of current-year or preceding-year MAGI does not exceed the applicable threshold amount";
}
@source(IRC_S30D_F, quote = "No credit shall be allowed under subsection (a) for any taxable year if—\n(i) the lesser of—\n(I) the modified adjusted gross income of the taxpayer for such taxable year, or\n(II) the modified adjusted gross income of the taxpayer for the preceding taxable year, exceeds\n(ii) the threshold amount.")
rule MagiBelowThreshold30dRule(taxpayer: Individual, y: TaxableYear, current: Money, preceding: Money, status: us.irc.income_individual::FilingStatus, threshold: Money) strict {
    when modified_agi_30d(taxpayer, y, current);
    when modified_agi_preceding_year_30d(taxpayer, y, preceding);
    when us.irc.income_individual::filing_status(taxpayer, y, status);
    when threshold_amount_30d(status, threshold);
    when min(current, preceding) <= threshold;
    then magi_below_threshold_30d(taxpayer, y);
}

// --- §30D(f)(11): MSRP limitation ------------------------------------------------

pub enum VehicleClassification30d { Van, SportUtilityVehicle, PickupTruck, OtherVehicle }
pub relation manufacturer_suggested_retail_price_30d(vehicle: Asset, price: Money) kind empirical {
    label en official "the vehicle's manufacturer's suggested retail price (section 30D(f)(11)(A)) — case-asserted";
}
pub relation vehicle_classification_30d(vehicle: Asset, vclass: VehicleClassification30d) kind empirical {
    label en official "the vehicle's classification for the section 30D(f)(11)(B) MSRP limitation — case-asserted";
}
relation msrp_limitation_30d(vclass: VehicleClassification30d, amount: Money) kind institutional;
@source(IRC_S30D_F, quote = "In the case of a van, $80,000.")
assert "30d-msrp-van": msrp_limitation_30d(Van, 80000.00 USD);
@source(IRC_S30D_F, quote = "In the case of a sport utility vehicle, $80,000.")
assert "30d-msrp-suv": msrp_limitation_30d(SportUtilityVehicle, 80000.00 USD);
@source(IRC_S30D_F, quote = "In the case of a pickup truck, $80,000.")
assert "30d-msrp-pickup": msrp_limitation_30d(PickupTruck, 80000.00 USD);
@source(IRC_S30D_F, quote = "In the case of any other vehicle, $55,000.")
assert "30d-msrp-other": msrp_limitation_30d(OtherVehicle, 55000.00 USD);

pub relation msrp_below_limitation_30d(vehicle: Asset) kind institutional {
    label en official "section 30D(f)(11): the vehicle's MSRP does not exceed the applicable classification limitation";
}
@source(IRC_S30D_F, quote = "No credit shall be allowed under subsection (a) for a vehicle with a manufacturer's suggested retail price in excess of the applicable limitation.")
rule MsrpBelowLimitation30dRule(vehicle: Asset, price: Money, vclass: VehicleClassification30d, limit: Money) strict {
    when manufacturer_suggested_retail_price_30d(vehicle, price);
    when vehicle_classification_30d(vehicle, vclass);
    when msrp_limitation_30d(vclass, limit);
    when price <= limit;
    then msrp_below_limitation_30d(vehicle);
}

// --- §30D(f)(6)/(9): election out and VIN requirement ---------------------------

pub relation elects_out_of_30d(taxpayer: Individual, vehicle: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 30D(f)(6) election to not have this section apply to the vehicle";
}
pub relation section_30d_does_not_apply(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 30D(f)(6): this section does not apply to the vehicle (a valid election-out)";
}
@source(IRC_S30D_F, quote = "No credit shall be allowed under subsection (a) for any vehicle if the taxpayer elects to not have this section apply to such vehicle.")
rule ElectOutOf30dRule(taxpayer: Individual, vehicle: Asset) strict {
    when new_clean_vehicle_base_requirements_met(taxpayer, vehicle);
    then power Section30dF6ElectOut {
        holder taxpayer;
        over vehicle;
        exercise elects_out_of_30d(taxpayer, vehicle);
        valid_when new_clean_vehicle_base_requirements_met(taxpayer, vehicle);
        effect create(section_30d_does_not_apply(taxpayer, vehicle));
        window [@2023-01-01, infinity);
    };
}
pub relation vin_included_on_return_30d(taxpayer: Individual, vehicle: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes the vehicle identification number on the return of tax for the taxable year (section 30D(f)(9)) — case-asserted";
}

// --- §30D(h): termination --------------------------------------------------------

pub relation section_30d_terminated(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 30D(h): no credit for a vehicle placed in service after December 31, 2032 (base 2024-Edition date; PL 119-21 section 70502 accelerates this to vehicles acquired after September 30, 2025, but that fragment is not pinned in this corpus, SOURCE_GAP)";
}
@source(IRC_S30D_H, quote = "No credit shall be allowed under this section with respect to any vehicle placed in service after December 31, 2032.")
rule Section30dTerminationRule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when placed_in_service_date_30d(taxpayer, vehicle, on);
    when on > @2032-12-31;
    then section_30d_terminated(taxpayer, vehicle);
}
// STAGE 2d: PL 119-21 section 70502 (`us.irc.temporal::PL119_21_S70502`,
// enacted 2025-07-04) ends the credit for vehicles "acquired after September
// 30, 2025" (an acquisition test, not a placed-in-service test). The
// conforming amendments to section 30D(e) of PL 119-21 section 70502(b) are
// not modelled (G1790).
pub relation acquisition_date_30d(taxpayer: Individual, vehicle: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer acquires the new clean vehicle (section 30D(h), as amended by PL 119-21 section 70502) — case-asserted";
}
@source(us.irc.temporal::PL119_21_S70502, quote = "Section 30D(h) is amended by striking “placed in service after December 31, 2032” and inserting “acquired after September 30, 2025”.")
rule Section30dTerminationAmendedRule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    effective [@2025-07-04, infinity);
    when acquisition_date_30d(taxpayer, vehicle, on);
    when on > @2025-09-30;
    then section_30d_terminated(taxpayer, vehicle);
}

// --- §30D(a): allowance of credit -----------------------------------------------

pub relation clean_vehicle_credit_per_vehicle(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 30D(b) per-vehicle dollar limitation, allowed for a new clean vehicle placed in service during the taxable year, subject to the MAGI and MSRP limitations, the VIN requirement, and not elected out or terminated";
}
@source(IRC_S30D_A, quote = "There shall be allowed as a credit against the tax imposed by this chapter for the taxable year an amount equal to the sum of the credit amounts determined under subsection (b) with respect to each new clean vehicle placed in service by the taxpayer during the taxable year.")
rule CleanVehicleCreditPerVehicleRule(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    when new_clean_vehicle_30d(taxpayer, vehicle);
    when not_known(excluded_entity_30d(taxpayer, vehicle));
    when per_vehicle_dollar_limitation_30d(taxpayer, vehicle, amount);
    when magi_below_threshold_30d(taxpayer, y);
    when msrp_below_limitation_30d(vehicle);
    when vin_included_on_return_30d(taxpayer, vehicle, y);
    when not_known(section_30d_does_not_apply(taxpayer, vehicle));
    when not_known(section_30d_terminated(taxpayer, vehicle));
    then clean_vehicle_credit_per_vehicle(taxpayer, vehicle, y, amount);
}
pub relation clean_vehicle_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 30D clean vehicle credit for the taxable year: the sum across all new clean vehicles placed in service";
}
rule CleanVehicleCreditRule(taxpayer: Individual, y: TaxableYear) defeasible {
    when magi_below_threshold_30d(taxpayer, y);
    then clean_vehicle_credit(taxpayer, y,
        sum all amount: Money for vehicle: Asset where clean_vehicle_credit_per_vehicle(taxpayer, vehicle, y, amount));
}
