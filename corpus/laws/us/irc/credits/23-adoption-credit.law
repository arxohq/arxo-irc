// Section 23 — Adoption expenses credit. Stage 1 (IRC-06 stage 1).
//
// §23(c)/(g)/(h)/(i) (carryforward interaction with the section 26(a)
// limitation, basis-reduction coordination, the section 1(f)(3) COLA
// adjustment, and the joint-filer-as-one-taxpayer regulation) are read
// together with `26-limitation-on-credits.law`. The mortgage-credit-
// certificate program mechanics of §§143/146 that (b)(2)(B) and (d)(3)(C)
// cross-reference belong to a different owner (bond-financed housing) and
// are pending dependency contracts here.

use self::{
    IRC_S23_A,
    IRC_S23_B,
    IRC_S23_C,
    IRC_S23_D,
    Individual,
    Person,
    TaxableYear,
};

pub enum EligibleChildKind { UnderAge18; IncapableOfSelfCare; }

pub relation eligible_child(child: Person, y: TaxableYear) kind institutional {
    label en official "an eligible child (section 23(d)(2))";
}
relation under_age_18(child: Person, y: TaxableYear) kind empirical { label en official "has not attained age 18 (section 23(d)(2)(A))"; }
relation incapable_of_self_care_23(child: Person, y: TaxableYear) kind empirical { label en official "is physically or mentally incapable of caring for himself (section 23(d)(2)(B))"; }

@source(IRC_S23_D, quote = "has not attained age 18, or")
rule EligibleChildAge(child: Person, y: TaxableYear) strict {
    label en official "an individual under age 18 is an eligible child";
    when under_age_18(child, y);
    then eligible_child(child, y);
}
@source(IRC_S23_D, quote = "is physically or mentally incapable of caring for himself")
rule EligibleChildIncapable(child: Person, y: TaxableYear) strict {
    label en official "an individual incapable of self-care is an eligible child regardless of age";
    when incapable_of_self_care_23(child, y);
    then eligible_child(child, y);
}

// §23(d)(3): child with special needs — a State determination, which this
// package treats as an external-judgment fact under DECISION-0194 (a State
// agency's determination, not this taxpayer's own assertion).
pub relation child_with_special_needs(child: Person, y: TaxableYear) kind institutional {
    label en official "a child with special needs (section 23(d)(3))";
}
relation state_determination_cannot_return_home(child: Person, state: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "a State has determined the child cannot or should not be returned home (section 23(d)(3)(A))";
}
relation state_determination_specific_factor(child: Person, state: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the State has determined a specific factor or condition making adoption unlikely without assistance (section 23(d)(3)(B))";
}
relation child_us_citizen_or_resident_23(child: Person) kind empirical {
    label en official "a citizen or resident of the United States as defined in section 217(h)(3) (section 23(d)(3)(C)) — dependency contract, producer: definitions (pending)";
}
@source(IRC_S23_D, quote = "a State has determined that the child cannot or should not be returned to the home of his parents")
rule ChildWithSpecialNeeds(child: Person, state: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "a child is a child with special needs when a State has made both determinations of (A) and (B) and the child is a US citizen or resident";
    when state_determination_cannot_return_home(child, state, y);
    when state_determination_specific_factor(child, state, y);
    when child_us_citizen_or_resident_23(child);
    then child_with_special_needs(child, y);
}

// --- §23(a)/(b): qualified adoption expenses and the dollar limit ---------------

pub relation qualified_adoption_expenses(taxpayer: Individual, child: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "reasonable and necessary adoption fees, court costs, attorney fees, and other expenses meeting section 23(d)(1)(A)-(D)";
}
pub relation aggregate_qualified_adoption_expenses_all_years(taxpayer: Individual, child: Person, amount: Money) kind institutional {
    label en official "the aggregate qualified adoption expenses taken into account for all taxable years with respect to this adoption (section 23(b)(1) $10,000 cap)";
}
@source(IRC_S23_B, quote = "The aggregate amount of qualified adoption expenses which may be taken into account under subsection (a) for all taxable years with respect to the adoption of a child by the taxpayer shall not exceed $10,000")
rule AggregateExpensesCap(taxpayer: Individual, child: Person, y: TaxableYear, amount: Money) strict {
    label en official "qualified adoption expenses for a given taxable year are capped, in the aggregate across all years for this adoption, at $10,000";
    when qualified_adoption_expenses(taxpayer, child, y, amount);
    then aggregate_qualified_adoption_expenses_all_years(taxpayer, child, min(amount, 10000.00 USD));
}
// The special-needs deemed-$10,000 rule of §23(a)(3) (final-year adoption of
// a special-needs child is treated as $10,000 minus prior years' expenses)
// and the timing rule of §23(a)(2) (expense-year vs finalization-year
// matching) are TIMING/AMOUNT refinements of the same aggregate cap;
// modelled together as one further rule rather than duplicated per branch:
relation aggregate_qualified_adoption_expenses_prior_years(taxpayer: Individual, child: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate qualified adoption expenses actually paid or incurred with respect to this adoption during taxable years BEFORE this one (section 23(a)(3)) — a running total the taxpayer's own prior returns establish; asserted directly pending a general prior-years-aggregation primitive shared with other multi-year carryover computations in this package";
}
@source(IRC_S23_A, quote = "the taxpayer shall be treated as having paid during such year qualified adoption expenses with respect to such adoption in an amount equal to the excess (if any) of $10,000 over the aggregate qualified adoption expenses actually paid or incurred by the taxpayer with respect to such adoption during such taxable year and all prior taxable years")
rule SpecialNeedsDeemedExpenses(taxpayer: Individual, child: Person, y: TaxableYear, prior: Money) strict {
    label en official "in the year a special-needs adoption becomes final, the taxpayer is deemed to have paid qualified adoption expenses equal to $10,000 minus the aggregate actually paid or incurred in PRIOR years for this adoption (the \"during such taxable year\" clause of the same-year total is necessarily zero for this deemed-expense item itself, avoiding self-reference)";
    when child_with_special_needs(child, y);
    when adoption_becomes_final_in_year(taxpayer, child, y);
    when aggregate_qualified_adoption_expenses_prior_years(taxpayer, child, y, prior);
    then qualified_adoption_expenses(taxpayer, child, y, max(0 USD, 10000.00 USD - prior));
}
relation adoption_becomes_final_in_year(taxpayer: Individual, child: Person, y: TaxableYear) kind empirical {
    label en official "the adoption of this child becomes final during this taxable year";
}

// §23(b)(3): no credit for an expense deducted/credited elsewhere, or funded
// by a federal/state/local program — disqualification on the EXPENSE ITEM.
relation deduction_or_credit_allowed_elsewhere_23(taxpayer: Individual, child: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "a deduction or credit is allowed under another provision of this chapter for this expense (section 23(b)(3)(A)) — dependency contract, producer: deductions (pending)";
}
relation funded_by_government_program_23(taxpayer: Individual, child: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "funds for this expense are received under a Federal, State, or local program (section 23(b)(3)(B))";
}

// --- §23(b)(2): AGI phase-out ----------------------------------------------------

pub relation adoption_credit_before_phaseout(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit allowable under subsection (a), determined without regard to the phase-out and the section 26(a) carryforward limitation (section 23(b)(2)(A) parenthetical)";
}
@source(IRC_S23_A, quote = "there shall be allowed as a credit against the tax imposed by this chapter the amount of the qualified adoption expenses paid or incurred by the taxpayer")
rule CreditBeforePhaseout(taxpayer: Individual, y: TaxableYear) strict {
    label en official "before phase-out, the credit is the qualified adoption expenses (after the aggregate cap) for the year, summed over every adoption of the taxpayer";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then adoption_credit_before_phaseout(taxpayer, y,
        sum all amount: Money for child: Person where aggregate_qualified_adoption_expenses_all_years(taxpayer, child, amount));
}

pub relation adoption_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adoption expenses credit allowed for the taxable year, after the section 23(b)(2) AGI phase-out (section 23)";
}
@source(IRC_S23_B, quote = "the amount (if any) by which the taxpayer's adjusted gross income exceeds $150,000, bears to")
rule AdoptionCreditPhaseoutAboveThreshold(taxpayer: Individual, y: TaxableYear, before: Money, agi: Money) strict {
    label en official "above $150,000 AGI (determined without regard to sections 911, 931, 933), the credit is reduced proportionally, reaching zero at $190,000 ($150,000 + $40,000)";
    when adoption_credit_before_phaseout(taxpayer, y, before);
    when adoption_credit_agi_23b2b(taxpayer, y, agi);
    when agi > 150000.00 USD;
    then adoption_credit(taxpayer, y, max(0 USD, round(before * (1.0 - min(1.0, (agi - 150000.00 USD) / 40000.00 USD)), 2, "HALF_UP")));
}
rule AdoptionCreditNoPhaseoutAtOrBelowThreshold(taxpayer: Individual, y: TaxableYear, before: Money, agi: Money) strict {
    label en official "at or below $150,000 AGI, the credit is not reduced";
    when adoption_credit_before_phaseout(taxpayer, y, before);
    when adoption_credit_agi_23b2b(taxpayer, y, agi);
    when agi <= 150000.00 USD;
    then adoption_credit(taxpayer, y, before);
}
relation adoption_credit_agi_23b2b(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted gross income determined without regard to sections 911, 931, and 933 (section 23(b)(2)(B)) — dependency contract, producer: international/gross-income (pending); until then read directly from section 62 AGI as an approximation, recorded as INTERPRETATION";
}

// --- §23(c): carryforward --------------------------------------------------------

pub relation adoption_credit_carryforward(taxpayer: Individual, from_year: TaxableYear, to_year: TaxableYear, amount: Money) kind institutional {
    label en official "the section 23(c) 5-year carryforward of unused adoption credit";
}
@source(IRC_S23_C, quote = "such excess shall be carried to the succeeding taxable year and added to the credit allowable under subsection (a) for such taxable year")
rule AdoptionCreditCarryforwardArises(taxpayer: Individual, y: TaxableYear, credit: Money, cap: Money, ny: TaxableYear) strict {
    label en official "the excess of the allowable section 23 credit over the section 26(a) limitation (reduced by other subpart credits) carries forward";
    when adoption_credit(taxpayer, y, credit);
    when section_23_applicable_tax_limit(taxpayer, y, cap);
    when credit > cap;
    when next_taxable_year(y, ny);
    then adoption_credit_carryforward(taxpayer, y, ny, credit - cap);
}
relation section_23_applicable_tax_limit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 26(a) limitation reduced by the sum of the credits allowable under subpart A other than sections 23 and 25D (section 23(c)(1)) — dependency contract read from 26-limitation-on-credits.law and the other subpart A credit totals";
}
relation next_taxable_year(y: TaxableYear, ny: TaxableYear) kind institutional {
    label en official "the taxable year immediately succeeding this one — dependency contract, producer: us.irc.core/temporal (pending a general successor-year relation)";
}
// §23(c)(2): the 5-taxable-year carryforward horizon and FIFO ordering among
// vintages is a TECH_GAP pending a general carryover-aging primitive shared
// with other subpart A carryforwards (§§25(e), 25B do not carry over; §38
// general business credit does, out of stage-1 scope) — recorded, not
// invented per-package.

// --- §23(e): foreign adoptions -----------------------------------------------------

relation adoption_is_foreign_23(child: Person) kind empirical {
    label en official "the child is not a citizen or resident of the United States, as defined in section 217(h)(3) (section 23(e))";
}
// §23(e) narrows WHEN a foreign adoption's expenses may be taken into
// account (only once final, with pre-finalization expenses shifted to the
// finalization year) — a timing condition on `qualified_adoption_expenses`
// assertions for a foreign child, recorded as INTERPRETATION rather than a
// duplicate expense-recognition rule.

// --- §23(f)/(g): identification and basis coordination ---------------------------

relation section_23f2_identification_met(taxpayer: Individual, child: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes (if known) the name, age, and TIN of the eligible child, or Secretary-approved alternative information (section 23(f)(2))";
}
// §23(f)(1) (rules similar to §21(e)(2)-(4) — joint-return and marital-status
// conditions) mirrors 21-dependent-care-credit.law's joint-return idiom;
// recorded as INTERPRETATION (cross-reference to an already-modelled test
// pattern) rather than duplicated verbatim.
//
// §23(g) (basis reduction for property-improvement expenditures credited
// under this section) is a `property-transactions` (basis) dependency
// contract, out of this package's arithmetic — EXTERNAL_DEPENDENCY.
