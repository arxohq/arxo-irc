// Stage 4 (DECISION-0379 with deontics), credits, part N: the maximum available power test of section
// 30B(d)(3)(A)(iii), (C) and the phaseout period of section 30B(f)(2). Closes G6418.
//
// (d)(3)(C): the maximum available power is a RATIO of powers of the vehicle. For a passenger
// automobile or light truck of at most 8,500 pounds (paragraph (2)(A)) it is the maximum power available
// from the rechargeable energy storage system in a standard 10-second pulse test divided by that power
// and the SAE net power of the heat engine (read as the sum of the two: JUDGMENT CALL on "such maximum
// power and the SAE net power"); for the other vehicles (paragraph (2)(B)) it is that power divided by the
// vehicle's total traction power (the peak power of the storage system plus the heat engine peak power, or
// the storage system's peak power alone when it is the sole means of driving). The thresholds of
// (iii): 4 percent for a (2)(A) vehicle, 10 percent for a vehicle of more than 8,500 and at most 14,000
// pounds, 15 percent for a vehicle above 14,000 pounds. The comparison is made WITHOUT a division
// (power x 100 >= percent x denominator), exact; the ratio itself is an output rounded to 6 places HALF_UP.
// A vehicle of at most 8,500 pounds that is not a passenger automobile or light truck has no threshold in the
// text: no power test is derived for it (NEITHER), never a guess.
//
// (f)(2): the phaseout period begins with the second calendar quarter following the quarter that includes
// the first date on which the number of qualified vehicles of the manufacturer sold for use in the United
// States after 2005 is at least 60,000. The date is a case fact (a running count of sales is outside the
// bounded arithmetic); the quarter arithmetic is a table of rules for the years 2006-2045 (the language
// has no extraction of a calendar quarter from a date, TECH-GAPS G6402).
//
// The bundled empirical fact `hybrid_certified_and_meets_power_and_emission_tests_30b` and the empirical
// `phaseout_period_start_30b` stay assertable (the earlier channel); strict rules below derive them from
// the components.

use self::{
    Asset,
    IRC_S30B_D,
    IRC_S30B_F,
    Person,
    gross_vehicle_weight_rating_30b,
    hybrid_certified_and_meets_power_and_emission_tests_30b,
    phaseout_period_start_30b,
};

pub relation manufacturer_of_vehicle_30b(vehicle: Asset, manufacturer: Person) kind empirical {
    label en official "the manufacturer of the vehicle (section 30B(f)(2)) — case-asserted";
}
pub relation sixty_thousandth_vehicle_sold_on_30b(manufacturer: Person, on: Date) kind empirical {
    label en official "the first date on which the number of qualified vehicles manufactured by the manufacturer sold for use in the United States after December 31, 2005 is at least 60,000 (section 30B(f)(2)) — case-asserted";
}
pub relation ress_pulse_power_kw_30b(vehicle: Asset, kw: Decimal) kind empirical {
    label en official "the maximum power available from the rechargeable energy storage system during a standard 10 second pulse power or equivalent test, in kilowatts (section 30B(d)(3)(C))";
}
pub relation heat_engine_sae_net_power_kw_30b(vehicle: Asset, kw: Decimal) kind empirical {
    label en official "the SAE net power of the heat engine, in kilowatts (section 30B(d)(3)(C)(i))";
}
pub relation ress_peak_power_kw_30b(vehicle: Asset, kw: Decimal) kind empirical {
    label en official "the peak power from the rechargeable energy storage system, in kilowatts (section 30B(d)(3)(C)(ii))";
}
pub relation heat_engine_peak_power_kw_30b(vehicle: Asset, kw: Decimal) kind empirical {
    label en official "the heat engine peak power of the vehicle, in kilowatts (section 30B(d)(3)(C)(ii))";
}
pub relation ress_sole_means_of_driving_30b(vehicle: Asset) kind empirical {
    label en official "the storage system is the sole means by which the vehicle can be driven (section 30B(d)(3)(C)(ii))";
}
pub relation hybrid_emission_and_engine_certifications_met_30b(vehicle: Asset) kind empirical {
    label en official "the certificate of conformity and the California low emission vehicle or Bin 5 / Bin 8 Tier II standard of (d)(3)(A)(ii), and for a (2)(B) vehicle the heavy duty engine certificate of (d)(3)(A)(iv) — case-asserted";
}
pub relation paragraph_2a_vehicle_30b(vehicle: Asset) kind institutional {
    label en official "paragraph (2)(A) applies: a passenger automobile or light truck with a gross vehicle weight rating of not more than 8,500 pounds (section 30B(d)(2)(A))";
}
pub relation passenger_automobile_or_light_truck_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle is a passenger automobile or light truck (section 30B(d)(2)(A)) — case-asserted";
}
@source(IRC_S30B_D, quote = "In the case of a new qualified hybrid motor vehicle which is a passenger automobile or light truck and which has a gross vehicle weight rating of not more than 8,500 pounds, the amount determined under this paragraph is the sum of the amounts determined under clauses (i) and (ii).")
rule Paragraph2aVehicle30b(vehicle: Asset, pounds: Decimal) strict {
    label en official "passenger automobile or light truck, rating at most 8,500 pounds";
    when passenger_automobile_or_light_truck_30b(vehicle);
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds <= 8500.0;
    then paragraph_2a_vehicle_30b(vehicle);
}
pub relation maximum_available_power_ratio_30b(vehicle: Asset, ratio: Decimal) kind institutional {
    label en official "the maximum available power as a ratio, rounded to 6 places HALF_UP (section 30B(d)(3)(C))";
}
@source(IRC_S30B_D, quote = "In the case of a vehicle to which paragraph (2)(A) applies, the term \"maximum available power\" means the maximum power available from the rechargeable energy storage system, during a standard 10 second pulse power or equivalent test, divided by such maximum power and the SAE net power of the heat engine.")
rule MaximumAvailablePowerRatioLight30b(vehicle: Asset, ress: Decimal, engine: Decimal) defeasible {
    label en official "pulse power / (pulse power + SAE net power) for a (2)(A) vehicle (section 30B(d)(3)(C)(i))";
    when paragraph_2a_vehicle_30b(vehicle);
    when ress_pulse_power_kw_30b(vehicle, ress);
    when heat_engine_sae_net_power_kw_30b(vehicle, engine);
    when ress + engine > 0.0;
    then maximum_available_power_ratio_30b(vehicle, div_round(ress, ress + engine, 6, "HALF_UP"));
}
@source(IRC_S30B_D, quote = "In the case of a vehicle to which paragraph (2)(B) applies, the term \"maximum available power\" means the maximum power available from the rechargeable energy storage system, during a standard 10 second pulse power or equivalent test, divided by the vehicle's total traction power.")
rule MaximumAvailablePowerRatioOtherSoleStorage30b(vehicle: Asset, ress: Decimal, peak: Decimal) defeasible {
    label en official "pulse power / peak power of the storage system when it is the sole means of driving (section 30B(d)(3)(C)(ii))";
    when not_known(paragraph_2a_vehicle_30b(vehicle));
    when ress_sole_means_of_driving_30b(vehicle);
    when ress_pulse_power_kw_30b(vehicle, ress);
    when ress_peak_power_kw_30b(vehicle, peak);
    when peak > 0.0;
    then maximum_available_power_ratio_30b(vehicle, div_round(ress, peak, 6, "HALF_UP"));
}
rule MaximumAvailablePowerRatioOtherTraction30b(vehicle: Asset, ress: Decimal, peak: Decimal, engine: Decimal) defeasible {
    label en official "pulse power / (storage peak + heat engine peak) (section 30B(d)(3)(C)(ii))";
    when not_known(paragraph_2a_vehicle_30b(vehicle));
    when not_known(ress_sole_means_of_driving_30b(vehicle));
    when ress_pulse_power_kw_30b(vehicle, ress);
    when ress_peak_power_kw_30b(vehicle, peak);
    when heat_engine_peak_power_kw_30b(vehicle, engine);
    when peak + engine > 0.0;
    then maximum_available_power_ratio_30b(vehicle, div_round(ress, peak + engine, 6, "HALF_UP"));
}
pub relation hybrid_meets_maximum_available_power_30b(vehicle: Asset) kind institutional {
    label en official "the maximum available power is at least 4 percent (paragraph (2)(A) vehicle), 10 percent (more than 8,500 and at most 14,000 pounds) or 15 percent (more than 14,000 pounds) (section 30B(d)(3)(A)(iii))";
}
@source(IRC_S30B_D, quote = "(I) 4 percent in the case of a vehicle to which paragraph (2)(A) applies,")
rule HybridPowerTestLight30b(vehicle: Asset, ress: Decimal, engine: Decimal) strict {
    label en official "pulse power x 100 >= 4 x (pulse power + SAE net power) (section 30B(d)(3)(A)(iii)(I))";
    when paragraph_2a_vehicle_30b(vehicle);
    when ress_pulse_power_kw_30b(vehicle, ress);
    when heat_engine_sae_net_power_kw_30b(vehicle, engine);
    when ress * 100.0 >= 4.0 * (ress + engine);
    then hybrid_meets_maximum_available_power_30b(vehicle);
}
@source(IRC_S30B_D, quote = "(II) 10 percent in the case of a vehicle which has a gross vehicle weight rating of more than 8,500 pounds and not more than 14,000 pounds, and")
rule HybridPowerTestMedium30bSole(vehicle: Asset, pounds: Decimal, ress: Decimal, peak: Decimal) strict {
    label en official "pulse power x 100 >= 10 x storage peak power, storage the sole means of driving (section 30B(d)(3)(A)(iii)(II), (C)(ii))";
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 8500.0;
    when pounds <= 14000.0;
    when ress_sole_means_of_driving_30b(vehicle);
    when ress_pulse_power_kw_30b(vehicle, ress);
    when ress_peak_power_kw_30b(vehicle, peak);
    when ress * 100.0 >= 10.0 * peak;
    then hybrid_meets_maximum_available_power_30b(vehicle);
}
rule HybridPowerTestMedium30bTraction(vehicle: Asset, pounds: Decimal, ress: Decimal, peak: Decimal, engine: Decimal) strict {
    label en official "pulse power x 100 >= 10 x (storage peak + engine peak) (section 30B(d)(3)(A)(iii)(II), (C)(ii))";
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 8500.0;
    when pounds <= 14000.0;
    when not_known(ress_sole_means_of_driving_30b(vehicle));
    when ress_pulse_power_kw_30b(vehicle, ress);
    when ress_peak_power_kw_30b(vehicle, peak);
    when heat_engine_peak_power_kw_30b(vehicle, engine);
    when ress * 100.0 >= 10.0 * (peak + engine);
    then hybrid_meets_maximum_available_power_30b(vehicle);
}
@source(IRC_S30B_D, quote = "(III) 15 percent in the case of a vehicle in excess of 14,000 pounds,")
rule HybridPowerTestHeavy30bSole(vehicle: Asset, pounds: Decimal, ress: Decimal, peak: Decimal) strict {
    label en official "pulse power x 100 >= 15 x storage peak power, storage the sole means of driving (section 30B(d)(3)(A)(iii)(III), (C)(ii))";
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 14000.0;
    when ress_sole_means_of_driving_30b(vehicle);
    when ress_pulse_power_kw_30b(vehicle, ress);
    when ress_peak_power_kw_30b(vehicle, peak);
    when ress * 100.0 >= 15.0 * peak;
    then hybrid_meets_maximum_available_power_30b(vehicle);
}
rule HybridPowerTestHeavy30bTraction(vehicle: Asset, pounds: Decimal, ress: Decimal, peak: Decimal, engine: Decimal) strict {
    label en official "pulse power x 100 >= 15 x (storage peak + engine peak) (section 30B(d)(3)(A)(iii)(III), (C)(ii))";
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 14000.0;
    when not_known(ress_sole_means_of_driving_30b(vehicle));
    when ress_pulse_power_kw_30b(vehicle, ress);
    when ress_peak_power_kw_30b(vehicle, peak);
    when heat_engine_peak_power_kw_30b(vehicle, engine);
    when ress * 100.0 >= 15.0 * (peak + engine);
    then hybrid_meets_maximum_available_power_30b(vehicle);
}
@source(IRC_S30B_D, quote = "(iii) which has a maximum available power of at least—")
rule HybridBundleFromComponents30b(vehicle: Asset) strict {
    label en official "the emission and engine certifications together with the derived maximum available power test are the bundle (section 30B(d)(3)(A)(ii)-(iv)); alternative channel to the asserted bundle";
    when hybrid_emission_and_engine_certifications_met_30b(vehicle);
    when hybrid_meets_maximum_available_power_30b(vehicle);
    then hybrid_certified_and_meets_power_and_emission_tests_30b(vehicle);
}

// ===================== (f)(2): the phaseout period =====================

@source(IRC_S30B_F, quote = "For purposes of this subsection, the phaseout period is the period beginning with the second calendar quarter following the calendar quarter which includes the first date on which the number of qualified vehicles manufactured by the manufacturer of the vehicle referred to in paragraph (1) sold for use in the United States after December 31, 2005, is at least 60,000.")
rule PhaseoutStart2006Q130b(vehicle: Asset, manufacturer: Person, on: Date) strict {
    label en official "the date falls in Q1 2006: the period begins on 2006-07-01 (section 30B(f)(2))";
    when manufacturer_of_vehicle_30b(vehicle, manufacturer);
    when sixty_thousandth_vehicle_sold_on_30b(manufacturer, on);
    when on >= @2006-01-01;
    when on <= @2006-03-31;
    then phaseout_period_start_30b(vehicle, @2006-07-01);
}
@source(IRC_S30B_F, quote = "For purposes of this subsection, the phaseout period is the period beginning with the second calendar quarter following the calendar quarter which includes the first date on which the number of qualified vehicles manufactured by the manufacturer of the vehicle referred to in paragraph (1) sold for use in the United States after December 31, 2005, is at least 60,000.")
rule PhaseoutStart2006Q230b(vehicle: Asset, manufacturer: Person, on: Date) strict {
    label en official "the date falls in Q2 2006: the period begins on 2006-10-01 (section 30B(f)(2))";
    when manufacturer_of_vehicle_30b(vehicle, manufacturer);
    when sixty_thousandth_vehicle_sold_on_30b(manufacturer, on);
    when on >= @2006-04-01;
    when on <= @2006-06-30;
    then phaseout_period_start_30b(vehicle, @2006-10-01);
}
@source(IRC_S30B_F, quote = "For purposes of this subsection, the phaseout period is the period beginning with the second calendar quarter following the calendar quarter which includes the first date on which the number of qualified vehicles manufactured by the manufacturer of the vehicle referred to in paragraph (1) sold for use in the United States after December 31, 2005, is at least 60,000.")
