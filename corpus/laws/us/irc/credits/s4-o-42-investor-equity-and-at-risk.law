// Stage 4 (DECISION-0379 with deontics), credits, part O: section 42(h)(6)(G)(ii)-(iii) (the 5-percent cap
// of the cost-of-living adjustment of adjusted investor equity and the base calendar year), section 42(k)(1)
// (rules similar to section 49(a)(1), (a)(2), (b)(1) for the qualified basis), section 42(k)(2)(D) (the
// repayment date for a qualified nonprofit lender not described in 49(a)(1)(D)(iv)(II)) and section
// 42(k)(3) (the present value of financing at a below-market rate). Closes G6419.
//
// (G)(iii): the base calendar year is the calendar year in which the 1st taxable year of the credit period
// ends: derived by a table of rules for the calendar years 1987-2070 (no extraction of a calendar year
// from a date). (G)(ii): TECHNIQUE: BOUNDED UNROLLING of the years from the base year to the year of the
// equity (at most 30 steps, a distinct relation per level), the running factor being the product of the
// yearly C-CPI-U growth factors each CAPPED at 1.05 (each growth ratio and each product rounded to 12 places
// HALF_UP: JUDGMENT CALL); the base year before 2017 uses the CPI times the section 1(f)(3)(B) amount, as the
// clause says. The derived cost-of-living adjustment feeds the asserted-fact channel of module 42d (the
// relation `base_year_cost_of_living_adjustment_42`, now also derived by these rules).

use self::{
    Asset,
    IRC_S42_H,
    TaxableYear,
    base_calendar_year_42,
    base_year_cost_of_living_adjustment_42,
};

pub relation first_taxable_year_of_credit_period_42g(building: Asset, ty: TaxableYear) kind empirical {
    label en official "the 1st taxable year of the credit period of the building (section 42(h)(6)(G)(iii)) — case-asserted";
}
pub relation equity_calendar_year_42(building: Asset, year: Decimal) kind empirical {
    label en official "the calendar year for which the adjusted investor equity is determined (section 42(h)(6)(G)(i)) — case-asserted";
}
pub relation c_cpi_u_42(year: Decimal, index: Decimal) kind empirical {
    label en official "the C-CPI-U (section 1(f)(6)) for the calendar year — case-asserted, the published index";
}
pub relation cpi_42(year: Decimal, index: Decimal) kind empirical {
    label en official "the consumer price index for the calendar year, used for a base calendar year before 2017 (section 42(h)(6)(G)(ii), last sentence) — case-asserted";
}
pub relation section_1f3b_conversion_amount_42(amount: Decimal) kind empirical {
    label en official "the amount determined under section 1(f)(3)(B) that converts the CPI of a base year before 2017 to the C-CPI-U basis — case-asserted";
}
pub relation base_year_index_42(building: Asset, index: Decimal) kind institutional {
    label en official "the C-CPI-U of the base calendar year: as published from 2017; before 2017 the CPI of the year times the amount of section 1(f)(3)(B) (section 42(h)(6)(G)(ii))";
}
@source(IRC_S42_H, quote = "In the case of a base calendar year before 2017, the C-CPI-U for such year shall be determined by multiplying the CPI for such year by the amount determined under section 1(f)(3)(B).")
rule BaseYearIndexBefore2017(building: Asset, b: Decimal, cpi: Decimal, conv: Decimal) defeasible {
    label en official "CPI x the section 1(f)(3)(B) amount for a base year before 2017";
    when base_calendar_year_42(building, b);
    when b < 2017.0;
    when cpi_42(b, cpi);
    when section_1f3b_conversion_amount_42(conv);
    then base_year_index_42(building, round(cpi * conv, 6, "HALF_UP"));
}
rule BaseYearIndexFrom2017(building: Asset, b: Decimal, idx: Decimal) defeasible {
    label en official "the published C-CPI-U for a base year from 2017";
    when base_calendar_year_42(building, b);
    when b >= 2017.0;
    when c_cpi_u_42(b, idx);
    then base_year_index_42(building, idx);
}
relation cola_state_42_0(building: Asset, year: Decimal, factor: Decimal, prev_index: Decimal) kind institutional {
    label en official "level 0: the base year, factor 1";
}
rule ColaStart42(building: Asset, b: Decimal, idx: Decimal) defeasible {
    label en official "the walk starts at the base calendar year with factor 1";
    when base_calendar_year_42(building, b);
    when base_year_index_42(building, idx);
    then cola_state_42_0(building, b, 1.0, idx);
}
@source(IRC_S42_H, quote = "(iii) Base calendar year\nFor purposes of this subparagraph, the term \"base calendar year\" means the calendar year with or within which the 1st taxable year of the credit period ends.")
rule BaseCalendarYear198742(building: Asset, ty: TaxableYear, ends_on: Date) strict {
    label en official "the first taxable year of the credit period ends in 1987 (section 42(h)(6)(G)(iii))";
    when first_taxable_year_of_credit_period_42g(building, ty);
    when us.irc.core::ends(ty, ends_on);
    when ends_on >= @1987-01-01;
    when ends_on <= @1987-12-31;
    then base_calendar_year_42(building, 1987.0);
}
@source(IRC_S42_H, quote = "(iii) Base calendar year\nFor purposes of this subparagraph, the term \"base calendar year\" means the calendar year with or within which the 1st taxable year of the credit period ends.")
