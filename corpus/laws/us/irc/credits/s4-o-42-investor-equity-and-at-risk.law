relation cola_state_42_1(building: Asset, year: Decimal, factor: Decimal, prev_index: Decimal) kind institutional {
    label en official "level 1: 1 year(s) after the base year";
}
@source(IRC_S42_H, quote = "Under regulations prescribed by the Secretary, if the C-CPI-U for any calendar year (as defined in section 1(f)(6)) exceeds the C-CPI-U for the preceding calendar year by more than 5 percent, the C-CPI-U for the base calendar year shall be increased such that such excess shall never be taken into account under clause (i).")
rule ColaStep1Capped42(building: Asset, y: TaxableYear, cy: Decimal, f: Decimal, prev: Decimal, idx: Decimal, n: Decimal) defeasible {
    label en official "the year's growth over 5 percent is not taken into account: factor x 1.05";
    when cola_state_42_0(building, cy, f, prev);
    when equity_calendar_year_42(building, n);
    when cy < n;
    when c_cpi_u_42(cy + 1.0, idx);
    when idx > 1.05 * prev;
    then cola_state_42_1(building, cy + 1.0, round(f * 1.05, 12, "HALF_UP"), idx);
}
rule ColaStep1Uncapped42(building: Asset, cy: Decimal, f: Decimal, prev: Decimal, idx: Decimal, n: Decimal) defeasible {
    label en official "growth of at most 5 percent counts in full";
    when cola_state_42_0(building, cy, f, prev);
    when equity_calendar_year_42(building, n);
    when cy < n;
    when c_cpi_u_42(cy + 1.0, idx);
    when idx <= 1.05 * prev;
    then cola_state_42_1(building, cy + 1.0, round(f * div_round(idx, prev, 12, "HALF_UP"), 12, "HALF_UP"), idx);
}
rule ColaResult042(building: Asset, cy: Decimal, f: Decimal, prev: Decimal, n: Decimal) defeasible {
    label en official "the year of the equity is reached: the cost-of-living adjustment is factor - 1 (section 42(h)(6)(G)(i)-(ii))";
    when cola_state_42_0(building, cy, f, prev);
    when equity_calendar_year_42(building, n);
    when cy >= n;
    when cy <= n;
    then base_year_cost_of_living_adjustment_42(building, f - 1.0);
}
relation cola_state_42_2(building: Asset, year: Decimal, factor: Decimal, prev_index: Decimal) kind institutional {
    label en official "level 2: 2 year(s) after the base year";
}
