    label en official "the first taxable year of the credit period ends in 2058 (section 42(h)(6)(G)(iii))";
    when first_taxable_year_of_credit_period_42g(building, ty);
    when us.irc.core::ends(ty, ends_on);
    when ends_on >= @2058-01-01;
    when ends_on <= @2058-12-31;
    then base_calendar_year_42(building, 2058.0);
}
@source(IRC_S42_H, quote = "(iii) Base calendar year\nFor purposes of this subparagraph, the term \"base calendar year\" means the calendar year with or within which the 1st taxable year of the credit period ends.")
