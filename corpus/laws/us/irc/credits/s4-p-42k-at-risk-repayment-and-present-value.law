// Stage 4 (DECISION-0379 with deontics), credits, part P: section 42(k)(1) (rules similar to section
// 49(a)(1), (a)(2), (b)(1) for the qualified basis), 42(k)(2)(D), last sentence (the repayment date for a
// qualified nonprofit lender not described in 49(a)(1)(D)(iv)(II)) and 42(k)(3) (the present value of
// financing at a below-market rate). Closes G6419 (with part O).
//
// (k)(1). The relations of module 49 are READ by explicit reference where they are general (the financing
// items of a property, the convertible debt, the property acquired from an unrelated person, the 465
// activity, the net decrease and increase of nonqualified financing, the credit decrease of (b)(1)); the
// building is the property. What (k)(1) excepts is written here: "qualified commercial financing" WITHOUT
// the 80-percent test of 49(a)(1)(D)(ii)(II) and WITHOUT the related-person exclusion of the qualified
// person test (49(a)(1)(D)(iv)(I)). The qualified basis the credit reads is the asserted basis less the
// nonqualified nonrecourse financing (when the taxpayer and the activity are subject to section 465), plus
// the net decrease of that financing of the year (49(a)(2)), and less the present-value adjustment of
// (k)(3). The rule of module 42 now reads `qualified_basis_for_credit_42`.

use self::{
    Asset,
    IRC_S42_K,
    Person,
    TaxableYear,
    compliance_period_close_date_42,
    credit_decrease_from_financing_increase_49,
    financing_borrowed_from_qualified_nonprofit_42,
    financing_is_convertible_debt_49,
    financing_maturity_date_42,
    financing_refinancing_or_sale_date_42,
    financing_repaid_by_earliest_required_date_42,
    financing_repayment_date_42,
    low_income_housing_building_owned_by,
    net_decrease_of_nonqualified_financing_49,
    net_increase_of_nonqualified_financing_49,
    nonrecourse_financing_item_49,
    property_acquired_from_unrelated_person_49,
    qualified_basis,
    qualified_nonprofit_organization_42,
    semiannual_factor,
    semiannual_factor_request,
    taxpayer_and_activity_subject_to_465_49,
};

pub relation lender_qualified_person_ignoring_related_person_test_42k(item: Asset) kind empirical {
    label en official "the lender is a qualified person (actively and regularly engaged in the business of lending money, not the person from whom the taxpayer acquired the property, not a person receiving a fee) or a government, WITHOUT the related-person test of section 49(a)(1)(D)(iv)(I), which section 42(k)(1) excepts — case-asserted";
}
pub relation qualified_commercial_financing_42k(building: Asset, item: Asset) kind institutional {
    label en official "financing of a building acquired from an unrelated person, from a qualified person or a government, not convertible debt: qualified commercial financing under section 49(a)(1)(D) without the 80-percent test (D)(ii)(II) and the related-person test (D)(iv)(I) (section 42(k)(1))";
}
@source(IRC_S42_K, quote = "Except as otherwise provided in this subsection, rules similar to the rules of section 49(a)(1) (other than subparagraphs (D)(ii)(II) and (D)(iv)(I) thereof), section 49(a)(2), and section 49(b)(1) shall apply in determining the qualified basis of any building in the same manner as such sections apply in determining the credit base of property.")
rule QualifiedCommercialFinancing42k(building: Asset, item: Asset, amount: Money) strict {
    label en official "acquired from an unrelated person, qualified lender, not convertible (section 42(k)(1), by section 49(a)(1)(D)(ii), (iv))";
    when nonrecourse_financing_item_49(building, item, amount);
    when property_acquired_from_unrelated_person_49(building);
    when lender_qualified_person_ignoring_related_person_test_42k(item);
    when not_known(financing_is_convertible_debt_49(item));
    then qualified_commercial_financing_42k(building, item);
}
pub relation nonqualified_nonrecourse_financing_42k(building: Asset, amount: Money) kind institutional {
    label en official "the nonrecourse financing of the building that is not qualified commercial financing under section 42(k)(1)";
}
@source(IRC_S42_K, quote = "Except as otherwise provided in this subsection, rules similar to the rules of section 49(a)(1) (other than subparagraphs (D)(ii)(II) and (D)(iv)(I) thereof), section 49(a)(2), and section 49(b)(1) shall apply in determining the qualified basis of any building in the same manner as such sections apply in determining the credit base of property.")
rule NonqualifiedNonrecourseFinancing42k(building: Asset, item: Asset, amount: Money) defeasible {
    label en official "nonrecourse financing not qualified under (k)(1): the sum over the items";
    when nonrecourse_financing_item_49(building, item, amount);
    when not_known(qualified_commercial_financing_42k(building, item));
    then nonqualified_nonrecourse_financing_42k(building,
        sum(collect all a: Money, i: Asset where nonrecourse_financing_item_49(building, i, a) and not_known(qualified_commercial_financing_42k(building, i)), empty: 0 USD));
}
relation has_nonqualified_financing_42k(building: Asset) kind institutional {
    label en official "bridge: the building has nonqualified nonrecourse financing";
}
rule HasNonqualifiedFinancing42k(building: Asset, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when nonqualified_nonrecourse_financing_42k(building, amount);
    then has_nonqualified_financing_42k(building);
}
pub relation qualified_basis_after_at_risk_42k1(building: Asset, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified basis reduced by the nonqualified nonrecourse financing, when the taxpayer and the activity are subject to section 465 (rule similar to section 49(a)(1)(A))";
}
@source(IRC_S42_K, quote = "Except as otherwise provided in this subsection, rules similar to the rules of section 49(a)(1) (other than subparagraphs (D)(ii)(II) and (D)(iv)(I) thereof), section 49(a)(2), and section 49(b)(1) shall apply in determining the qualified basis of any building in the same manner as such sections apply in determining the credit base of property.")
rule QualifiedBasisReducedByNonqualifiedFinancing42k(building: Asset, taxpayer: Person, y: TaxableYear, basis: Money, nonqualified: Money) defeasible {
    label en official "basis - nonqualified financing (section 42(k)(1), by section 49(a)(1)(A))";
    when qualified_basis(building, y, basis);
    when low_income_housing_building_owned_by(building, taxpayer);
    when taxpayer_and_activity_subject_to_465_49(taxpayer, building);
    when nonqualified_nonrecourse_financing_42k(building, nonqualified);
    then qualified_basis_after_at_risk_42k1(building, taxpayer, y, max(0 USD, basis - nonqualified));
}
rule QualifiedBasisNoNonqualifiedFinancing42k(building: Asset, taxpayer: Person, y: TaxableYear, basis: Money) defeasible {
    label en official "subject to section 465 but no nonqualified financing: the basis stands";
    when qualified_basis(building, y, basis);
    when low_income_housing_building_owned_by(building, taxpayer);
    when taxpayer_and_activity_subject_to_465_49(taxpayer, building);
    when not_known(has_nonqualified_financing_42k(building));
    then qualified_basis_after_at_risk_42k1(building, taxpayer, y, basis);
}
rule QualifiedBasisNotSubjectToSection465For42k(building: Asset, taxpayer: Person, y: TaxableYear, basis: Money) defeasible {
    label en official "not subject to section 465: the basis stands";
    when qualified_basis(building, y, basis);
    when low_income_housing_building_owned_by(building, taxpayer);
    when not_known(taxpayer_and_activity_subject_to_465_49(taxpayer, building));
    then qualified_basis_after_at_risk_42k1(building, taxpayer, y, basis);
}
relation net_decrease_of_financing_present_42k1(taxpayer: Person, building: Asset, y: TaxableYear) kind institutional {
    label en official "bridge: a net decrease of nonqualified financing is asserted for the year";
}
rule NetDecreaseOfFinancingPresent42k1(taxpayer: Person, building: Asset, y: TaxableYear, decrease: Money) defeasible {
    label en official "bridge for the absence test";
    when net_decrease_of_nonqualified_financing_49(taxpayer, building, y, decrease);
    then net_decrease_of_financing_present_42k1(taxpayer, building, y);
}
pub relation qualified_basis_with_financing_decrease_42k1(building: Asset, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified basis increased by the net decrease of the nonqualified nonrecourse financing at the close of the year (rule similar to section 49(a)(2))";
}
@source(IRC_S42_K, quote = "Except as otherwise provided in this subsection, rules similar to the rules of section 49(a)(1) (other than subparagraphs (D)(ii)(II) and (D)(iv)(I) thereof), section 49(a)(2), and section 49(b)(1) shall apply in determining the qualified basis of any building in the same manner as such sections apply in determining the credit base of property.")
rule QualifiedBasisWithFinancingDecrease42k1(building: Asset, taxpayer: Person, y: TaxableYear, reduced: Money, decrease: Money) defeasible {
    label en official "reduced basis + the net decrease (section 42(k)(1), by section 49(a)(2))";
    when qualified_basis_after_at_risk_42k1(building, taxpayer, y, reduced);
    when net_decrease_of_nonqualified_financing_49(taxpayer, building, y, decrease);
    then qualified_basis_with_financing_decrease_42k1(building, taxpayer, y, reduced + decrease);
}
rule QualifiedBasisWithoutFinancingDecrease42k1(building: Asset, taxpayer: Person, y: TaxableYear, reduced: Money) defeasible {
    label en official "no net decrease: the reduced basis";
    when qualified_basis_after_at_risk_42k1(building, taxpayer, y, reduced);
    when not_known(net_decrease_of_financing_present_42k1(taxpayer, building, y));
    then qualified_basis_with_financing_decrease_42k1(building, taxpayer, y, reduced);
}
pub relation at_risk_recapture_tax_increase_42k1(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "a net increase of the nonqualified nonrecourse financing increases the tax by the aggregate decrease of the credits that reducing the qualified basis would have produced (rule similar to section 49(b)(1))";
}
@source(IRC_S42_K, quote = "Except as otherwise provided in this subsection, rules similar to the rules of section 49(a)(1) (other than subparagraphs (D)(ii)(II) and (D)(iv)(I) thereof), section 49(a)(2), and section 49(b)(1) shall apply in determining the qualified basis of any building in the same manner as such sections apply in determining the credit base of property.")
rule AtRiskRecaptureTaxIncrease42k1(taxpayer: Person, building: Asset, y: TaxableYear, decrease: Money) defeasible {
    label en official "recapture on a net increase of nonqualified financing (section 42(k)(1), by section 49(b)(1))";
    when low_income_housing_building_owned_by(building, taxpayer);
    when net_increase_of_nonqualified_financing_49(taxpayer, building, y);
    when credit_decrease_from_financing_increase_49(taxpayer, building, y, decrease);
    then at_risk_recapture_tax_increase_42k1(taxpayer, building, y, decrease);
}

// ===================== 42(k)(3): the present value of below-market financing =====================

pub relation financing_amount_42k3(financing: Asset, amount: Money) kind empirical {
    label en official "the amount of the financing described in paragraph (2)(A) (section 42(k)(3))";
}
pub relation financing_incurred_on_42k3(financing: Asset, on: Date) kind empirical {
    label en official "the date the financing is incurred (section 42(k)(3))";
}
pub relation financing_maturity_on_42k3(financing: Asset, on: Date) kind empirical {
    label en official "the date the amount of the financing is repayable, the end of the discounting (section 42(k)(3)); the amount is discounted as one payment at that date (JUDGMENT CALL)";
}
pub relation applicable_federal_rate_at_financing_42k3(financing: Asset, rate: Decimal) kind empirical {
    label en official "the applicable Federal rate as of the time the financing is incurred, an annual rate compounded semiannually (section 42(k)(3)); the published value is asserted (SOURCE_GAP of the value)";
}
pub relation financing_stated_interest_rate_42k3(financing: Asset, rate: Decimal) kind empirical {
    label en official "the stated rate of interest on the financing (section 42(k)(3))";
}
pub relation financing_interest_rate_covered_by_government_subsidy_42k3(financing: Asset, rate: Decimal) kind empirical {
    label en official "the part of the rate of interest that is covered by government subsidies, treated as not payable (section 42(k)(3), last sentence)";
}
pub relation financing_net_interest_rate_42k3(financing: Asset, rate: Decimal) kind institutional {
    label en official "the rate of interest on the financing with interest to the extent of government subsidies treated as not payable (section 42(k)(3), last sentence)";
}
@source(IRC_S42_K, quote = "For purposes of the preceding sentence, the rate of interest on any financing shall be determined by treating interest to the extent of government subsidies as not payable.")
rule FinancingNetInterestRateWithSubsidy42k3(financing: Asset, stated: Decimal, subsidized: Decimal) defeasible {
    label en official "stated rate - the subsidized part, not below zero";
    when financing_stated_interest_rate_42k3(financing, stated);
    when financing_interest_rate_covered_by_government_subsidy_42k3(financing, subsidized);
    then financing_net_interest_rate_42k3(financing, max(0.0, stated - subsidized));
}
relation financing_subsidy_present_42k3(financing: Asset) kind institutional {
    label en official "bridge: a subsidy share is asserted for the financing";
}
rule FinancingSubsidyPresent42k3(financing: Asset, subsidized: Decimal) defeasible {
    label en official "bridge for the absence test";
    when financing_interest_rate_covered_by_government_subsidy_42k3(financing, subsidized);
    then financing_subsidy_present_42k3(financing);
}
rule FinancingNetInterestRateWithoutSubsidy42k3(financing: Asset, stated: Decimal) defeasible {
    label en official "no subsidy: the stated rate";
    when financing_stated_interest_rate_42k3(financing, stated);
    when not_known(financing_subsidy_present_42k3(financing));
    then financing_net_interest_rate_42k3(financing, stated);
}
pub relation financing_below_market_42k3(financing: Asset) kind institutional {
    label en official "the rate of interest is less than the rate 1 percentage point below the applicable Federal rate at the time the financing is incurred (section 42(k)(3))";
}
@source(IRC_S42_K, quote = "If the rate of interest on any financing described in paragraph (2)(A) is less than the rate which is 1 percentage point below the applicable Federal rate as of the time such financing is incurred")
rule FinancingBelowMarket42k3(financing: Asset, net: Decimal, afr: Decimal) defeasible {
    label en official "net rate < AFR - 1 point";
    when financing_net_interest_rate_42k3(financing, net);
    when applicable_federal_rate_at_financing_42k3(financing, afr);
    when net < afr - 0.01;
    then financing_below_market_42k3(financing);
}
rule FinancingPresentValueAsksFactor42k3(financing: Asset, incurred: Date, maturity: Date, afr: Decimal) defeasible {
    label en official "ask for the discount factor of the financing";
    when financing_below_market_42k3(financing);
    when financing_incurred_on_42k3(financing, incurred);
    when financing_maturity_on_42k3(financing, maturity);
    when applicable_federal_rate_at_financing_42k3(financing, afr);
    then semiannual_factor_request(afr, incurred, maturity);
}
pub relation present_value_of_financing_42k3(financing: Asset, amount: Money) kind institutional {
    label en official "the present value of the amount of the financing, the discount rate being the applicable Federal rate: amount / semiannual factor, one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S42_K, quote = "then the qualified basis (to which such financing relates) of the qualified low-income building shall be the present value of the amount of such financing, using as the discount rate such applicable Federal rate.")
rule PresentValueOfFinancing42k3(financing: Asset, amount: Money, incurred: Date, maturity: Date, afr: Decimal, f: Decimal) defeasible {
    label en official "the qualified basis relating to a below-market financing is its present value at the AFR (section 42(k)(3))";
    when financing_below_market_42k3(financing);
    when financing_amount_42k3(financing, amount);
    when financing_incurred_on_42k3(financing, incurred);
    when financing_maturity_on_42k3(financing, maturity);
    when applicable_federal_rate_at_financing_42k3(financing, afr);
    when semiannual_factor(afr, incurred, maturity, f);
    then present_value_of_financing_42k3(financing, div_round(amount, f, 2, "HALF_UP"));
}
pub relation financing_of_building_42k3(building: Asset, financing: Asset) kind empirical {
    label en official "the financing relates to the qualified basis of the building (section 42(k)(3))";
}
pub relation qualified_basis_reduction_by_present_value_42k3(building: Asset, amount: Money) kind institutional {
    label en official "the qualified basis relating to below-market financings is replaced by its present value: the reduction is the sum of (amount - present value) over those financings (section 42(k)(3))";
}
rule QualifiedBasisReductionByPresentValue42k3(building: Asset, financing: Asset, pv: Money) defeasible {
    label en official "sum over the below-market financings of the building of amount - present value";
    when financing_of_building_42k3(building, financing);
    when present_value_of_financing_42k3(financing, pv);
    then qualified_basis_reduction_by_present_value_42k3(building,
        sum(collect all a: Money, f: Asset, v: Money where financing_of_building_42k3(building, f) and financing_amount_42k3(f, a) and present_value_of_financing_42k3(f, v), empty: 0 USD)
        - sum(collect all v2: Money, f2: Asset where financing_of_building_42k3(building, f2) and present_value_of_financing_42k3(f2, v2), empty: 0 USD));
}
relation present_value_adjustment_present_42k3(building: Asset) kind institutional {
    label en official "bridge: a present-value adjustment exists for the building";
}
rule PresentValueAdjustmentPresent42k3(building: Asset, r: Money) defeasible {
    label en official "bridge for the absence test";
    when qualified_basis_reduction_by_present_value_42k3(building, r);
    then present_value_adjustment_present_42k3(building);
}

// ===================== the qualified basis the credit reads =====================

pub relation qualified_basis_for_credit_42(building: Asset, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified basis of the building the section 42(a) credit is computed on: after the at-risk rules of (k)(1) (financing reduction and net decrease) and the present-value adjustment of (k)(3); the asserted basis when no such rule engages";
}
@source(IRC_S42_K, quote = "then the qualified basis (to which such financing relates) of the qualified low-income building shall be the present value of the amount of such financing, using as the discount rate such applicable Federal rate.")
rule QualifiedBasisForCreditWithPresentValue42(building: Asset, taxpayer: Person, y: TaxableYear, basis: Money, reduction: Money) defeasible {
    label en official "basis after the at-risk rules less the present-value reduction, not below zero";
    when qualified_basis_with_financing_decrease_42k1(building, taxpayer, y, basis);
    when qualified_basis_reduction_by_present_value_42k3(building, reduction);
    then qualified_basis_for_credit_42(building, taxpayer, y, max(0 USD, basis - reduction));
}
rule QualifiedBasisForCreditWithoutPresentValue42(building: Asset, taxpayer: Person, y: TaxableYear, basis: Money) defeasible {
    label en official "no present-value adjustment: the basis after the at-risk rules";
    when qualified_basis_with_financing_decrease_42k1(building, taxpayer, y, basis);
    when not_known(present_value_adjustment_present_42k3(building));
    then qualified_basis_for_credit_42(building, taxpayer, y, basis);
}

// ===================== 42(k)(2)(D): the repayment date of a nonprofit lender =====================

pub relation nonprofit_lender_is_person_from_whom_property_acquired_42k(financing: Asset) kind empirical {
    label en official "the qualified nonprofit organization is a person described in section 49(a)(1)(D)(iv)(II) (a person from which the taxpayer acquired the property, or a related person) with respect to the building";
}
pub relation building_ceases_to_be_qualified_low_income_building_on_42k(financing: Asset, on: Date) kind empirical {
    label en official "the date the building ceases to be a qualified low-income building (section 42(k)(2)(D), last sentence)";
}
pub relation nonprofit_lender_special_repayment_date_applies_42k2d(financing: Asset) kind institutional {
    label en official "the financing is borrowed from a qualified nonprofit organization that is not described in section 49(a)(1)(D)(iv)(II) with respect to the building: clause (ii) of (D) is applied with the special date";
}
@source(IRC_S42_K, quote = "In the case of a qualified nonprofit organization which is not described in section 49(a)(1)(D)(iv)(II) with respect to a building, clause (ii) of this subparagraph shall be applied as if the date described therein were the 90th day after the earlier of the date the building ceases to be a qualified low-income building or the date which is 15 years after the close of a compliance period with respect thereto.")
rule NonprofitLenderSpecialRepaymentDateApplies42k2d(financing: Asset, org: Person) strict {
    label en official "a qualified nonprofit lender that is not the seller (section 42(k)(2)(D), last sentence)";
    when financing_borrowed_from_qualified_nonprofit_42(financing, org);
    when qualified_nonprofit_organization_42(org);
    when not_known(nonprofit_lender_is_person_from_whom_property_acquired_42k(financing));
    then nonprofit_lender_special_repayment_date_applies_42k2d(financing);
}
@source(IRC_S42_K, quote = "In the case of a qualified nonprofit organization which is not described in section 49(a)(1)(D)(iv)(II) with respect to a building, clause (ii) of this subparagraph shall be applied as if the date described therein were the 90th day after the earlier of the date the building ceases to be a qualified low-income building or the date which is 15 years after the close of a compliance period with respect thereto.")
rule FinancingRepaidByEarliestRequiredDateSpecial42k2d(financing: Asset, repaid: Date, maturity: Date, close: Date, other: Date, ceases: Date) strict {
    label en official "repaid by the earliest of maturity, the 90th day after the earlier of the cessation and 15 years after the compliance period, and the refinancing or sale (section 42(k)(2)(D))";
    when nonprofit_lender_special_repayment_date_applies_42k2d(financing);
    when financing_repayment_date_42(financing, repaid);
    when financing_maturity_date_42(financing, maturity);
    when compliance_period_close_date_42(financing, close);
    when financing_refinancing_or_sale_date_42(financing, other);
    when building_ceases_to_be_qualified_low_income_building_on_42k(financing, ceases);
    when repaid <= maturity;
    when repaid <= add_calendar_period(ceases, 90 calendar_day);
    when repaid <= add_calendar_period(add_calendar_period(close, 180 calendar_month), 90 calendar_day);
    when repaid <= other;
    then financing_repaid_by_earliest_required_date_42(financing);
}
