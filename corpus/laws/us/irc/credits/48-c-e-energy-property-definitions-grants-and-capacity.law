// Section 48 — subsection (c) definitions of the energy property kinds (fuel cell, microturbine, combined heat and
// power, small wind, waste energy recovery, energy storage, biogas, microgrid controller), (d) section 1603 grants,
// (e) the environmental justice solar and wind capacity increase. Stage 2e (IRC-06, DECISION-0379, TECH_GAP
// reduction of the stage 2c rows "subsection 48(c), (d), (e) not reached"). Companion of `48-energy-credit.law`: the
// credit reads a case-asserted property type (`EnergyPropertyType48`); the definitions below derive whether a property
// meets the physical definition of its kind, the (c) credit caps and the (e) increase, but the credit module is NOT
// rewired to require them.
//
// Scope / judgment calls:
// * Capacity limits stated as "$1,500 for each 0.5 kilowatt of capacity" and "$200 for each kilowatt" are computed
//   as the exact multiple (capacity / 0.5 x $1,500, capacity x $200), cents HALF_UP.
// * Combined heat and power: "an equivalent combination of electrical and mechanical energy capacities" is read as
//   the sum of the fractions of the two capacity thresholds (electrical MW / 15 + mechanical hp / 20,000 exceeds 1;
//   MW / 50 + hp / 67,000 exceeds 1 for the exclusion): JUDGMENT CALL, the text gives no formula. The energy efficiency
//   percentage is total useful power over the lower heating value of the fuel, on a Btu basis, 10 decimals HALF_UP.
// * (d): the section 1603 grant rules; the section 50(c) basis reduction of (d)(3)(B) is a case fact (the reduction
//   the credit would have caused).
// * (e)(4)(A): the date of the enactment of the subsection is not pinned in the corpus: the 180-day deadline of the
//   Secretary is computed from the case fact `ej_program_enactment_date_48` (SOURCE_GAP note).
// * (b): "rules similar to the rules of subsections (c)(4) and (d) of former section 46" stays TECH_GAP (analogical
//   incorporation of a repealed provision; TECH-GAPS G1536).

use self::{
    Asset,
    EnergyPropertyType48,
    IRC_S48_C,
    IRC_S48_D,
    IRC_S48_E,
    Person,
    TaxableYear,
    ej_capacity_excess_including_expiry_48,
    ej_capacity_excess_present_48,
    energy_property_basis,
    energy_property_construction_begin_date,
};

pub relation qualified_property_construction_before_2025_48(prop: Asset) kind institutional {
    label en official "the construction of the property begins before January 1, 2025 (sections 48(c)(1)(E), (2)(D), (3)(A)(iv), (4)(C), (5)(D), (6)(D) (\"after December 31, 2024\" is the negation), (7)(C), (8)(C))";
}
rule QualifiedPropertyConstructionBefore2025Rule(prop: Asset, on: Date) strict {
    when energy_property_construction_begin_date(prop, on);
    when on < @2025-01-01;
    then qualified_property_construction_before_2025_48(prop);
}

// --- (c)(1): qualified fuel cell property ------------------------------------------------------------------------------------------------------------

pub relation fuel_cell_power_plant_48(prop: Asset) kind empirical {
    label en official "the property is a fuel cell power plant: an integrated system of a fuel cell stack assembly (or linear generator assembly) and associated balance of plant components which converts a fuel into electricity using electrochemical or electromechanical means (section 48(c)(1)(C)) — case-asserted";
}
pub relation has_linear_generator_assembly_48(prop: Asset) kind empirical {
    label en official "the fuel cell power plant has a linear generator assembly (section 48(c)(1)(A)(i)) — case-asserted";
}
pub relation linear_generator_assembly_contains_rotating_parts_48(prop: Asset) kind empirical {
    label en official "the assembly contains rotating parts, so it is not a linear generator assembly (section 48(c)(1)(D)) — case-asserted";
}
pub relation nameplate_capacity_kw_48(prop: Asset, kw: Decimal) kind empirical {
    label en official "the nameplate capacity of the property in kilowatts of electricity (sections 48(c)(1)-(2), (4), (8)) — case-asserted";
}
pub relation electricity_only_generation_efficiency_48(prop: Asset, efficiency: Decimal) kind empirical {
    label en official "the electricity-only generation efficiency of the plant as a fraction (sections 48(c)(1)(A)(ii), (2)(A)(ii)) — case-asserted";
}
pub relation qualified_fuel_cell_property_48(prop: Asset) kind institutional {
    label en official "section 48(c)(1)(A), (E): a fuel cell power plant of at least 0.5 kW (1 kW with a linear generator assembly) with electricity-only efficiency above 30 percent, construction begun before 2025";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"qualified fuel cell property\" means a fuel cell power plant which—")
rule QualifiedFuelCellPropertyPlainRule(prop: Asset, kw: Decimal, efficiency: Decimal) strict {
    when fuel_cell_power_plant_48(prop);
    when not_known(has_linear_generator_assembly_48(prop));
    when nameplate_capacity_kw_48(prop, kw);
    when kw >= 0.5;
    when electricity_only_generation_efficiency_48(prop, efficiency);
    when efficiency > 0.30;
    when qualified_property_construction_before_2025_48(prop);
    then qualified_fuel_cell_property_48(prop);
}
rule QualifiedFuelCellPropertyLinearRule(prop: Asset, kw: Decimal, efficiency: Decimal) strict {
    when fuel_cell_power_plant_48(prop);
    when has_linear_generator_assembly_48(prop);
    when not_known(linear_generator_assembly_contains_rotating_parts_48(prop));
    when nameplate_capacity_kw_48(prop, kw);
    when kw >= 1.0;
    when electricity_only_generation_efficiency_48(prop, efficiency);
    when efficiency > 0.30;
    when qualified_property_construction_before_2025_48(prop);
    then qualified_fuel_cell_property_48(prop);
}
pub relation fuel_cell_credit_before_cap_48(prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit otherwise determined under subsection (a) for the year for the fuel cell property, before the (c)(1)(B) cap — case-asserted";
}
pub relation fuel_cell_credit_after_cap_48(prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(c)(1)(B): the credit does not exceed $1,500 for each 0.5 kilowatt of capacity";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "In the case of qualified fuel cell property placed in service during the taxable year, the credit otherwise determined under subsection (a) for such year with respect to such property shall not exceed an amount equal to $1,500 for each 0.5 kilowatt of capacity of such property.")
rule FuelCellCreditAfterCapRule(prop: Asset, y: TaxableYear, credit: Money, kw: Decimal) strict {
    when qualified_fuel_cell_property_48(prop);
    when fuel_cell_credit_before_cap_48(prop, y, credit);
    when nameplate_capacity_kw_48(prop, kw);
    then fuel_cell_credit_after_cap_48(prop, y, min(credit, round(kw * 3000.00 USD, 2, "HALF_UP")));
}

// --- (c)(2): qualified microturbine property ------------------------------------------------------------------------------------------------------

pub relation stationary_microturbine_power_plant_48(prop: Asset) kind empirical {
    label en official "the property is a stationary microturbine power plant: an integrated system of a gas turbine engine, combustor, recuperator or regenerator, generator or alternator and associated balance of plant components converting a fuel into electricity and thermal energy, including the secondary components between the existing fuel delivery and power distribution infrastructure (section 48(c)(2)(C)) — case-asserted";
}
pub relation efficiency_at_iso_conditions_48(prop: Asset, efficiency: Decimal) kind empirical {
    label en official "the electricity-only generation efficiency at International Standard Organization conditions, as a fraction (section 48(c)(2)(A)(ii)) — case-asserted";
}
pub relation qualified_microturbine_property_48(prop: Asset) kind institutional {
    label en official "section 48(c)(2)(A), (D): a stationary microturbine power plant of less than 2,000 kW with efficiency of at least 26 percent at ISO conditions, construction begun before 2025";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"qualified microturbine property\" means a stationary microturbine power plant which—")
rule QualifiedMicroturbinePropertyRule(prop: Asset, kw: Decimal, efficiency: Decimal) strict {
    when stationary_microturbine_power_plant_48(prop);
    when nameplate_capacity_kw_48(prop, kw);
    when kw < 2000.0;
    when efficiency_at_iso_conditions_48(prop, efficiency);
    when efficiency >= 0.26;
    when qualified_property_construction_before_2025_48(prop);
    then qualified_microturbine_property_48(prop);
}
pub relation microturbine_credit_before_cap_48(prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit otherwise determined under subsection (a) for the year for the microturbine property, before the (c)(2)(B) cap — case-asserted";
}
pub relation microturbine_credit_after_cap_48(prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(c)(2)(B): the credit does not exceed $200 for each kilowatt of capacity";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "In the case of qualified microturbine property placed in service during the taxable year, the credit otherwise determined under subsection (a) for such year with respect to such property shall not exceed an amount equal to $200 for each kilowatt of capacity of such property.")
rule MicroturbineCreditAfterCapRule(prop: Asset, y: TaxableYear, credit: Money, kw: Decimal) strict {
    when qualified_microturbine_property_48(prop);
    when microturbine_credit_before_cap_48(prop, y, credit);
    when nameplate_capacity_kw_48(prop, kw);
    then microturbine_credit_after_cap_48(prop, y, min(credit, round(kw * 200.00 USD, 2, "HALF_UP")));
}

// --- (c)(3): combined heat and power system property ----------------------------------------------------------------------------------------

pub relation chp_uses_same_energy_source_for_electric_or_mechanical_and_thermal_48(prop: Asset) kind empirical {
    label en official "the system uses the same energy source for the simultaneous or sequential generation of electrical power, mechanical shaft power, or both, in combination with steam or other useful thermal energy (including heating and cooling) (section 48(c)(3)(A)(i)) — case-asserted";
}
pub relation chp_useful_thermal_share_48(prop: Asset, share: Decimal) kind empirical {
    label en official "the share (fraction) of total useful energy in the form of thermal energy not used to produce electrical or mechanical power, on a Btu basis (section 48(c)(3)(A)(ii)(I), (C)(ii)) — case-asserted";
}
pub relation chp_useful_power_share_48(prop: Asset, share: Decimal) kind empirical {
    label en official "the share (fraction) of total useful energy in the form of electrical or mechanical power, on a Btu basis (section 48(c)(3)(A)(ii)(II), (C)(ii)) — case-asserted";
}
pub relation chp_total_useful_power_btu_48(prop: Asset, btu: Decimal) kind empirical {
    label en official "the total useful electrical, thermal and mechanical power produced by the system at normal operating rates and expected to be consumed in its normal application, in Btu (section 48(c)(3)(C)(i)(I)) — case-asserted";
}
pub relation chp_fuel_lower_heating_value_btu_48(prop: Asset, btu: Decimal) kind empirical {
    label en official "the lower heating value of the fuel sources for the system, in Btu (section 48(c)(3)(C)(i)(II)) — case-asserted";
}
pub relation chp_energy_efficiency_percentage_48(prop: Asset, efficiency: Decimal) kind institutional {
    label en official "section 48(c)(3)(C)(i): the total useful power produced by the system over the lower heating value of the fuel sources (10 decimals HALF_UP judgment call)";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the energy efficiency percentage of a system is the fraction—")
rule ChpEnergyEfficiencyPercentageRule(prop: Asset, useful: Decimal, lhv: Decimal) strict {
    when chp_total_useful_power_btu_48(prop, useful);
    when chp_fuel_lower_heating_value_btu_48(prop, lhv);
    when lhv > 0.0;
    then chp_energy_efficiency_percentage_48(prop, div_round(useful, lhv, 10, "HALF_UP"));
}
pub relation chp_designed_for_90_percent_biomass_48(prop: Asset) kind empirical {
    label en official "the system is designed to use biomass (section 45(c)(2)-(3), without the last sentence of (3)(A)) for at least 90 percent of the energy source (section 48(c)(3)(D)) — case-asserted";
}
pub relation chp_property_transports_or_distributes_energy_48(prop: Asset) kind empirical {
    label en official "the property is used to transport the energy source to the facility or to distribute energy produced by the facility (section 48(c)(3)(C)(iii)) — case-asserted";
}
pub relation chp_electrical_capacity_mw_48(prop: Asset, mw: Decimal) kind empirical {
    label en official "the electrical capacity of the system in megawatts (section 48(c)(3)(B)) — case-asserted";
}
pub relation chp_mechanical_capacity_hp_48(prop: Asset, hp: Decimal) kind empirical {
    label en official "the mechanical energy capacity of the system in horsepower (section 48(c)(3)(B)) — case-asserted";
}
pub relation chp_capacity_fraction_of_50_mw_48(prop: Asset, fraction: Decimal) kind institutional {
    label en official "section 48(c)(3)(B)(iii): the capacity as a fraction of the exclusion threshold (50 megawatts, 67,000 horsepower, or an equivalent combination: the sum of the two fractions)";
}
rule ChpCapacityFractionOf50MwRule(prop: Asset, mw: Decimal, hp: Decimal) strict {
    when chp_electrical_capacity_mw_48(prop, mw);
    when chp_mechanical_capacity_hp_48(prop, hp);
    then chp_capacity_fraction_of_50_mw_48(prop, div_round(mw, 50.0, 10, "HALF_UP") + div_round(hp, 67000.0, 10, "HALF_UP"));
}
pub relation combined_heat_and_power_system_property_48(prop: Asset) kind institutional {
    label en official "section 48(c)(3): a system using one energy source for combined power and useful thermal energy with at least 20 percent of useful energy in each form, energy efficiency above 60 percent (or, for a 90 percent biomass system, the ratio rule), construction begun before 2025, not above 50 MW / 67,000 hp, excluding transport and distribution property";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"combined heat and power system property\" means property comprising a system—")
rule CombinedHeatAndPowerSystemPropertyRule(prop: Asset, thermal: Decimal, useful_power: Decimal, efficiency: Decimal, fraction: Decimal) strict {
    when chp_uses_same_energy_source_for_electric_or_mechanical_and_thermal_48(prop);
    when chp_useful_thermal_share_48(prop, thermal);
    when thermal >= 0.20;
    when chp_useful_power_share_48(prop, useful_power);
    when useful_power >= 0.20;
    when chp_energy_efficiency_percentage_48(prop, efficiency);
    when efficiency > 0.60;
    when qualified_property_construction_before_2025_48(prop);
    when chp_capacity_fraction_of_50_mw_48(prop, fraction);
    when fraction <= 1.0;
    when not_known(chp_property_transports_or_distributes_energy_48(prop));
    then combined_heat_and_power_system_property_48(prop);
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "(i) subparagraph (A)(iii) shall not apply, but")
rule CombinedHeatAndPowerSystemPropertyBiomassRule(prop: Asset, thermal: Decimal, useful_power: Decimal, fraction: Decimal) strict {
    when chp_uses_same_energy_source_for_electric_or_mechanical_and_thermal_48(prop);
    when chp_designed_for_90_percent_biomass_48(prop);
    when chp_useful_thermal_share_48(prop, thermal);
    when thermal >= 0.20;
    when chp_useful_power_share_48(prop, useful_power);
    when useful_power >= 0.20;
    when qualified_property_construction_before_2025_48(prop);
    when chp_capacity_fraction_of_50_mw_48(prop, fraction);
    when fraction <= 1.0;
    when not_known(chp_property_transports_or_distributes_energy_48(prop));
    then combined_heat_and_power_system_property_48(prop);
}
pub relation chp_credit_before_capacity_and_efficiency_limits_48(prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit under subsection (a)(1) for the CHP property before the (c)(3)(B) capacity proration and the (c)(3)(D) biomass efficiency proration — case-asserted";
}
pub relation chp_capacity_fraction_of_applicable_capacity_48(prop: Asset, fraction: Decimal) kind institutional {
    label en official "section 48(c)(3)(B)(ii): the capacity as a fraction of the applicable capacity (15 megawatts, 20,000 horsepower of mechanical capacity, or an equivalent combination: the sum of the two fractions)";
}
rule ChpCapacityFractionOfApplicableCapacityRule(prop: Asset, mw: Decimal, hp: Decimal) strict {
    when chp_electrical_capacity_mw_48(prop, mw);
    when chp_mechanical_capacity_hp_48(prop, hp);
    then chp_capacity_fraction_of_applicable_capacity_48(prop, div_round(mw, 15.0, 10, "HALF_UP") + div_round(hp, 20000.0, 10, "HALF_UP"));
}
pub relation chp_credit_after_capacity_limit_48(prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(c)(3)(B)(i): for capacity in excess of the applicable capacity, the credit is the credit times the ratio of the applicable capacity to the capacity";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "In the case of combined heat and power system property with an electrical capacity in excess of the applicable capacity placed in service during the taxable year, the credit under subsection (a)(1) (determined without regard to this paragraph) for such year shall be equal to the amount which bears the same ratio to such credit as the applicable capacity bears to the capacity of such property.")
rule ChpCreditAfterCapacityLimitExcessRule(prop: Asset, y: TaxableYear, credit: Money, fraction: Decimal) strict {
    when combined_heat_and_power_system_property_48(prop);
    when chp_credit_before_capacity_and_efficiency_limits_48(prop, y, credit);
    when chp_capacity_fraction_of_applicable_capacity_48(prop, fraction);
    when fraction > 1.0;
    // ratio applicable capacity / capacity = 1 / fraction
    then chp_credit_after_capacity_limit_48(prop, y, div_round(credit, fraction, 2, "HALF_UP"));
}
rule ChpCreditAfterCapacityLimitWithinRule(prop: Asset, y: TaxableYear, credit: Money, fraction: Decimal) strict {
    when combined_heat_and_power_system_property_48(prop);
    when chp_credit_before_capacity_and_efficiency_limits_48(prop, y, credit);
    when chp_capacity_fraction_of_applicable_capacity_48(prop, fraction);
    when fraction <= 1.0;
    then chp_credit_after_capacity_limit_48(prop, y, credit);
}
pub relation chp_credit_after_biomass_limit_48(prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(c)(3)(D)(ii): for a system designed to use at least 90 percent biomass the credit does not exceed the credit times the ratio of the energy efficiency percentage to 60 percent";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "(ii) the amount of credit determined under subsection (a) with respect to such system shall not exceed the amount which bears the same ratio to such amount of credit (determined without regard to this subparagraph) as the energy efficiency percentage of such system bears to 60 percent.")
rule ChpCreditAfterBiomassLimitRule(prop: Asset, y: TaxableYear, credit: Money, efficiency: Decimal) strict {
    when combined_heat_and_power_system_property_48(prop);
    when chp_designed_for_90_percent_biomass_48(prop);
    when chp_credit_after_capacity_limit_48(prop, y, credit);
    when chp_energy_efficiency_percentage_48(prop, efficiency);
    when efficiency < 0.60;
    then chp_credit_after_biomass_limit_48(prop, y, round(credit * div_round(efficiency, 0.60, 10, "HALF_UP"), 2, "HALF_UP"));
}

// --- (c)(4): qualified small wind energy property ------------------------------------------------------------------------------------------------

pub relation uses_wind_turbine_to_generate_electricity_48(prop: Asset) kind empirical {
    label en official "the property uses a wind turbine to generate electricity (section 48(c)(4)(A)) — case-asserted";
}
pub relation qualified_small_wind_energy_property_48(prop: Asset) kind institutional {
    label en official "section 48(c)(4): property using a wind turbine of at most 100 kW nameplate capacity to generate electricity, construction begun before 2025";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"qualifying small wind turbine\" means a wind turbine which has a nameplate capacity of not more than 100 kilowatts.")
rule QualifiedSmallWindEnergyPropertyRule(prop: Asset, kw: Decimal) strict {
    when uses_wind_turbine_to_generate_electricity_48(prop);
    when nameplate_capacity_kw_48(prop, kw);
    when kw <= 100.0;
    when qualified_property_construction_before_2025_48(prop);
    then qualified_small_wind_energy_property_48(prop);
}

// --- (c)(5): waste energy recovery property ------------------------------------------------------------------------------------------------------

pub relation generates_electricity_solely_from_waste_heat_48(prop: Asset) kind empirical {
    label en official "the property generates electricity solely from heat from buildings or equipment the primary purpose of which is not the generation of electricity (section 48(c)(5)(A)) — case-asserted";
}
pub relation waste_energy_recovery_capacity_mw_48(prop: Asset, mw: Decimal) kind empirical {
    label en official "the capacity of the property in megawatts (section 48(c)(5)(B)) — case-asserted";
}
pub relation part_of_chp_system_48(prop: Asset) kind empirical {
    label en official "the property is part of a system which is combined heat and power system property (section 48(c)(5)(C)) — case-asserted";
}
pub relation elects_not_to_treat_system_as_chp_48(taxpayer: Person, prop: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 48(c)(5)(C) election to not treat the system as combined heat and power system property";
}
pub relation system_not_treated_as_chp_48(taxpayer: Person, prop: Asset) kind institutional {
    label en official "section 48(c)(5)(C): the taxpayer elected to not treat the system as combined heat and power system property (a valid election)";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "Any waste energy recovery property (determined without regard to this subparagraph) which is part of a system which is a combined heat and power system property shall not be treated as waste energy recovery property for purposes of this section unless the taxpayer elects to not treat such system as a combined heat and power system property for purposes of this section.")
rule Section48C5CElectionRule(taxpayer: Person, prop: Asset) defeasible {
    when part_of_chp_system_48(prop);
    when energy_property_basis(taxpayer, prop, _, _, _);
    then power Section48C5CElection {
        holder taxpayer;
        over prop;
        exercise elects_not_to_treat_system_as_chp_48(taxpayer, prop);
        valid_when part_of_chp_system_48(prop);
        effect create(system_not_treated_as_chp_48(taxpayer, prop));
        window [@2022-08-16, infinity);
    };
}
pub relation waste_energy_recovery_property_48(prop: Asset) kind institutional {
    label en official "section 48(c)(5): property generating electricity solely from waste heat, at most 50 MW, construction begun before 2025, and (if part of a CHP system) only when the taxpayer elected not to treat the system as CHP (the raw exercise fact is read)";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"waste energy recovery property\" means property that generates electricity solely from heat from buildings or equipment if the primary purpose of such building or equipment is not the generation of electricity.")
rule WasteEnergyRecoveryPropertyStandaloneRule(prop: Asset, mw: Decimal) strict {
    when generates_electricity_solely_from_waste_heat_48(prop);
    when waste_energy_recovery_capacity_mw_48(prop, mw);
    when mw <= 50.0;
    when qualified_property_construction_before_2025_48(prop);
    when not_known(part_of_chp_system_48(prop));
    then waste_energy_recovery_property_48(prop);
}
rule WasteEnergyRecoveryPropertyElectedRule(prop: Asset, mw: Decimal, taxpayer: Person) strict {
    when generates_electricity_solely_from_waste_heat_48(prop);
    when waste_energy_recovery_capacity_mw_48(prop, mw);
    when mw <= 50.0;
    when qualified_property_construction_before_2025_48(prop);
    when part_of_chp_system_48(prop);
    when elects_not_to_treat_system_as_chp_48(taxpayer, prop);
    then waste_energy_recovery_property_48(prop);
}

// --- (c)(6): energy storage technology --------------------------------------------------------------------------------------------------------------

pub relation receives_stores_delivers_energy_for_conversion_to_electricity_48(prop: Asset) kind empirical {
    label en official "the property receives, stores and delivers energy for conversion to electricity (or, in the case of hydrogen, stores energy) (section 48(c)(6)(A)(i)) — case-asserted";
}
pub relation primarily_used_in_transportation_and_not_for_electricity_48(prop: Asset) kind empirical {
    label en official "the property is primarily used in the transportation of goods or individuals and not for the production of electricity (section 48(c)(6)(A)(i)) — case-asserted";
}
pub relation storage_nameplate_capacity_kwh_48(prop: Asset, kwh: Decimal) kind empirical {
    label en official "the nameplate capacity of the storage property in kilowatt hours (section 48(c)(6)) — case-asserted";
}
pub relation directly_connected_to_hvac_48(prop: Asset) kind empirical {
    label en official "the system is directly connected to a heating, ventilation or air conditioning system (section 48(c)(6)(C)(i)(I)) — case-asserted";
}
pub relation removes_or_adds_heat_to_storage_medium_48(prop: Asset) kind empirical {
    label en official "the system removes heat from, or adds heat to, a storage medium for subsequent use (section 48(c)(6)(C)(i)(II)) — case-asserted";
}
pub relation provides_energy_for_heating_or_cooling_of_building_interior_48(prop: Asset) kind empirical {
    label en official "the system provides energy for the heating or cooling of the interior of a residential or commercial building (section 48(c)(6)(C)(i)(III)) — case-asserted";
}
pub relation is_swimming_pool_or_chp_property_or_building_48(prop: Asset) kind empirical {
    label en official "the property is a swimming pool, combined heat and power system property, or a building or its structural components (section 48(c)(6)(C)(ii)) — case-asserted";
}
pub relation thermal_energy_storage_property_48(prop: Asset) kind institutional {
    label en official "section 48(c)(6)(C): a system directly connected to an HVAC system, adding heat to or removing heat from a storage medium for later use, and providing energy for heating or cooling a residential or commercial building; not a swimming pool, CHP property or a building";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "Subject to clause (ii), for purposes of this paragraph, the term \"thermal energy storage property\" means property comprising a system which—")
rule ThermalEnergyStoragePropertyRule(prop: Asset) strict {
    when directly_connected_to_hvac_48(prop);
    when removes_or_adds_heat_to_storage_medium_48(prop);
    when provides_energy_for_heating_or_cooling_of_building_interior_48(prop);
    when not_known(is_swimming_pool_or_chp_property_or_building_48(prop));
    then thermal_energy_storage_property_48(prop);
}
pub relation construction_or_modification_begin_date_48(prop: Asset, on: Date) kind empirical {
    label en official "the date construction of the storage property begins (or, for a (B) modification, the date the modification begins) (section 48(c)(6)(D)) — case-asserted";
}
pub relation energy_storage_technology_48(prop: Asset) kind institutional {
    label en official "section 48(c)(6)(A), (D): storage property of at least 5 kWh (not transportation property), or thermal energy storage property, whose construction (or modification) does not begin after 2024-12-31";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"energy storage technology\" shall not include any property the construction of which begins after December 31, 2024.")
rule EnergyStorageTechnologyElectricRule(prop: Asset, kwh: Decimal, on: Date) strict {
    when receives_stores_delivers_energy_for_conversion_to_electricity_48(prop);
    when not_known(primarily_used_in_transportation_and_not_for_electricity_48(prop));
    when storage_nameplate_capacity_kwh_48(prop, kwh);
    when kwh >= 5.0;
    when construction_or_modification_begin_date_48(prop, on);
    when on <= @2024-12-31;
    then energy_storage_technology_48(prop);
}
rule EnergyStorageTechnologyThermalRule(prop: Asset, on: Date) strict {
    when thermal_energy_storage_property_48(prop);
    when construction_or_modification_begin_date_48(prop, on);
    when on <= @2024-12-31;
    then energy_storage_technology_48(prop);
}
pub relation storage_property_capacity_before_modification_kwh_48(prop: Asset, kwh: Decimal) kind empirical {
    label en official "the nameplate capacity of the existing storage property before the modification (section 48(c)(6)(B)) — case-asserted";
}
pub relation storage_property_placed_in_service_before_enactment_48(prop: Asset) kind empirical {
    label en official "the property was placed in service before the date of enactment of section 48(c)(6) (section 48(c)(6)(B)(i)) — case-asserted";
}
pub relation modified_storage_property_treated_as_energy_storage_48(prop: Asset) kind institutional {
    label en official "section 48(c)(6)(B): existing property placed in service before the enactment with a capacity below 5 kWh modified to at least 5 kWh, or storage property modified to add at least 5 kWh, is treated as described in (A)(i), the basis of the existing property before the modification not being taken into account";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "(ii) is described in subparagraph (A)(i) and is modified in a manner that such property (after such modification) has an increase in nameplate capacity of not less than 5 kilowatt hours,")
rule ModifiedStoragePropertyIncreaseRule(prop: Asset, before: Decimal, after: Decimal) strict {
    when receives_stores_delivers_energy_for_conversion_to_electricity_48(prop);
    when storage_property_capacity_before_modification_kwh_48(prop, before);
    when storage_nameplate_capacity_kwh_48(prop, after);
    when before >= 5.0;
    when after - before >= 5.0;
    then modified_storage_property_treated_as_energy_storage_48(prop);
}
rule ModifiedStoragePropertySmallToLargeRule(prop: Asset, before: Decimal, after: Decimal) strict {
    when storage_property_placed_in_service_before_enactment_48(prop);
    when receives_stores_delivers_energy_for_conversion_to_electricity_48(prop);
    when storage_property_capacity_before_modification_kwh_48(prop, before);
    when storage_nameplate_capacity_kwh_48(prop, after);
    when before < 5.0;
    when after >= 5.0;
    then modified_storage_property_treated_as_energy_storage_48(prop);
}

// --- (c)(7): qualified biogas property -------------------------------------------------------------------------------------------------------------

pub relation converts_biomass_into_gas_48(prop: Asset) kind empirical {
    label en official "the system converts biomass (section 45K(c)(3) as in effect on the date of enactment of the paragraph) into a gas (section 48(c)(7)(A)(i)) — case-asserted";
}
pub relation gas_methane_share_by_volume_48(prop: Asset, share: Decimal) kind empirical {
    label en official "the methane share by volume, as a fraction, of the gas or of the gas after the system concentrates it (section 48(c)(7)(A)(i)(I)-(II)) — case-asserted";
}
pub relation gas_captured_for_sale_or_productive_use_48(prop: Asset) kind empirical {
    label en official "the system captures the gas for sale or productive use, and not for disposal via combustion (section 48(c)(7)(A)(ii)) — case-asserted";
}
pub relation biogas_property_is_gas_cleaning_or_conditioning_part_48(prop: Asset) kind empirical {
    label en official "the property is part of the system and cleans or conditions the gas (section 48(c)(7)(B)) — case-asserted";
}
pub relation biogas_system_construction_begin_date_48(prop: Asset, on: Date) kind empirical {
    label en official "the date construction of the biogas system begins (section 48(c)(7)(C)) — case-asserted";
}
relation qualified_biogas_system_48(prop: Asset) kind institutional;
pub relation qualified_biogas_property_48(prop: Asset) kind institutional {
    label en official "section 48(c)(7): a system converting biomass into a gas of at least 52 percent methane (or concentrating it to that) and capturing it for sale or productive use, including gas cleaning or conditioning property; construction not begun after 2024-12-31";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"qualified biogas property\" means property comprising a system which—")
rule QualifiedBiogasPropertySystemRule(prop: Asset, share: Decimal, on: Date) strict {
    when converts_biomass_into_gas_48(prop);
    when gas_methane_share_by_volume_48(prop, share);
    when share >= 0.52;
    when gas_captured_for_sale_or_productive_use_48(prop);
    when biogas_system_construction_begin_date_48(prop, on);
    when on <= @2024-12-31;
    then qualified_biogas_system_48(prop);
}
rule QualifiedBiogasPropertyOfSystemRule(prop: Asset) strict {
    when qualified_biogas_system_48(prop);
    then qualified_biogas_property_48(prop);
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"qualified biogas property\" includes any property which is part of such system which cleans or conditions such gas.")
rule QualifiedBiogasPropertyCleaningPartRule(prop: Asset, system: Asset, on: Date) strict {
    when biogas_property_is_gas_cleaning_or_conditioning_part_48(prop);
    when biogas_property_part_of_system_48(prop, system);
    when qualified_biogas_system_48(system);
    then qualified_biogas_property_48(prop);
}
pub relation biogas_property_part_of_system_48(prop: Asset, system: Asset) kind empirical {
    label en official "the property is part of the qualified biogas system — case-asserted";
}

// --- (c)(8): microgrid controllers ----------------------------------------------------------------------------------------------------------------------

pub relation microgrid_generating_capacity_kw_48(microgrid: Asset, kw: Decimal) kind empirical {
    label en official "the microgrid includes equipment capable of generating this many kilowatts of electricity (section 48(c)(8)(B)(i)) — case-asserted";
}
pub relation microgrid_operates_with_grid_as_single_controllable_entity_48(microgrid: Asset) kind empirical {
    label en official "the electrical system is capable of operating in connection with the electrical grid and as a single controllable entity with respect to the grid (section 48(c)(8)(B)(ii)(I)) — case-asserted";
}
pub relation microgrid_operates_independently_of_grid_48(microgrid: Asset) kind empirical {
    label en official "the electrical system is capable of operating independently (and disconnected) from the grid (section 48(c)(8)(B)(ii)(II)) — case-asserted";
}
pub relation microgrid_part_of_bulk_power_system_48(microgrid: Asset) kind empirical {
    label en official "the system is part of a bulk-power system (section 215 of the Federal Power Act) (section 48(c)(8)(B)(iii)) — case-asserted";
}
pub relation qualified_microgrid_48(microgrid: Asset) kind institutional {
    label en official "section 48(c)(8)(B): an electrical system with equipment generating at least 4 kW and at most 20 MW, capable of operating with the grid as a single controllable entity and independently, not part of a bulk-power system";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"qualified microgrid\" means an electrical system which—")
rule QualifiedMicrogridRule(microgrid: Asset, kw: Decimal) strict {
    when microgrid_generating_capacity_kw_48(microgrid, kw);
    when kw >= 4.0;
    when kw <= 20000.0;
    when microgrid_operates_with_grid_as_single_controllable_entity_48(microgrid);
    when microgrid_operates_independently_of_grid_48(microgrid);
    when not_known(microgrid_part_of_bulk_power_system_48(microgrid));
    then qualified_microgrid_48(microgrid);
}
pub relation equipment_part_of_microgrid_designed_and_used_to_control_48(equipment: Asset, microgrid: Asset) kind empirical {
    label en official "the equipment is part of the qualified microgrid and designed and used to monitor and control the energy resources and loads on it (section 48(c)(8)(A)) — case-asserted";
}
pub relation microgrid_controller_construction_begin_date_48(equipment: Asset, on: Date) kind empirical {
    label en official "the date construction of the microgrid controller begins (section 48(c)(8)(C)) — case-asserted";
}
pub relation microgrid_controller_48(equipment: Asset) kind institutional {
    label en official "section 48(c)(8): equipment that is part of a qualified microgrid and designed and used to monitor and control its energy resources and loads; construction not begun after 2024-12-31";
}
@source(IRC_S48_C, relation = formalizes, coverage = exact, quote = "The term \"microgrid controller\" means equipment which is—")
rule MicrogridControllerRule(equipment: Asset, microgrid: Asset, on: Date) strict {
    when equipment_part_of_microgrid_designed_and_used_to_control_48(equipment, microgrid);
    when qualified_microgrid_48(microgrid);
    when microgrid_controller_construction_begin_date_48(equipment, on);
    when on <= @2024-12-31;
    then microgrid_controller_48(equipment);
}

// --- (d): section 1603 grants ---------------------------------------------------------------------------------------------------------------------------

pub relation section_1603_grant_made_in_year_48(prop: Asset, y: TaxableYear) kind empirical {
    label en official "the Secretary makes a grant under section 1603 of the American Recovery and Reinvestment Tax Act of 2009 with respect to the property in the taxable year (section 48(d)) — case-asserted";
}
pub relation credit_barred_by_1603_grant_48(prop: Asset, y: TaxableYear) kind institutional {
    label en official "section 48(d)(1): no credit is determined under section 48 or 45 for the taxable year in which the grant is made or any subsequent taxable year";
}
@source(IRC_S48_D, relation = formalizes, coverage = exact, quote = "No credit shall be determined under this section or section 45 with respect to such property for the taxable year in which such grant is made or any subsequent taxable year.")
rule CreditBarredBy1603GrantRule(prop: Asset, y: TaxableYear, grant_year: TaxableYear, grant_begin: Date, begin: Date) strict {
    when section_1603_grant_made_in_year_48(prop, grant_year);
    when us.irc.core::begins(grant_year, grant_begin);
    when us.irc.core::begins(y, begin);
    when begin >= grant_begin;
    then credit_barred_by_1603_grant_48(prop, y);
}
pub relation credit_determined_for_earlier_year_allowed_under_38_48(prop: Asset, taxpayer: Person, amount: Money) kind empirical {
    label en official "the part of the credit determined under section 48 for taxable years ending before the grant that was allowed under section 38 (section 48(d)(2)(A)) — case-asserted";
}
pub relation credit_determined_for_earlier_year_not_allowed_48(prop: Asset, taxpayer: Person, amount: Money) kind empirical {
    label en official "the part of the credit determined under section 48 for taxable years ending before the grant that was not allowed under section 38 (carried forward) (section 48(d)(2)(B)) — case-asserted";
}
pub relation tax_increase_for_1603_grant_48(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(d)(2)(A): the tax for the year of the grant is increased by so much of the earlier credit as was allowed under section 38";
}
@source(IRC_S48_D, relation = formalizes, coverage = exact, quote = "(A) the tax imposed under subtitle A on the taxpayer for the taxable year in which such grant is made shall be increased by so much of such credit as was allowed under section 38,")
rule TaxIncreaseFor1603GrantRule(taxpayer: Person, prop: Asset, y: TaxableYear, allowed: Money) strict {
    when section_1603_grant_made_in_year_48(prop, y);
    when credit_determined_for_earlier_year_allowed_under_38_48(prop, taxpayer, allowed);
    then tax_increase_for_1603_grant_48(taxpayer, prop, y, allowed);
}
pub relation carryforward_recapture_for_1603_grant_48(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(d)(2)(B): the section 39 general business carryforwards are adjusted so as to recapture the part of the credit that was not allowed";
}
@source(IRC_S48_D, relation = formalizes, coverage = exact, quote = "(B) the general business carryforwards under section 39 shall be adjusted so as to recapture the portion of such credit which was not so allowed, and")
rule CarryforwardRecaptureFor1603GrantRule(taxpayer: Person, prop: Asset, y: TaxableYear, not_allowed: Money) strict {
    when section_1603_grant_made_in_year_48(prop, y);
    when credit_determined_for_earlier_year_not_allowed_48(prop, taxpayer, not_allowed);
    then carryforward_recapture_for_1603_grant_48(taxpayer, prop, y, not_allowed);
}
pub relation basis_reduction_by_earlier_credit_48(prop: Asset, amount: Money) kind empirical {
    label en official "the reduction in the basis of the property by reason of the earlier credit (section 48(d)(2)(C)) — case-asserted";
}
pub relation grant_basis_for_amount_determination_48(prop: Asset, basis: Money) kind institutional {
    label en official "section 48(d)(2)(C): the amount of the grant is determined without regard to any reduction in the basis of the property by reason of the earlier credit (the basis before the reduction)";
}
pub relation property_basis_after_reduction_48(prop: Asset, basis: Money) kind empirical {
    label en official "the basis of the property after the reduction by the earlier credit — case-asserted";
}
@source(IRC_S48_D, relation = formalizes, coverage = exact, quote = "(C) the amount of such grant shall be determined without regard to any reduction in the basis of such property by reason of such credit.")
rule GrantBasisForAmountDeterminationRule(prop: Asset, reduced: Money, reduction: Money) strict {
    when property_basis_after_reduction_48(prop, reduced);
    when basis_reduction_by_earlier_credit_48(prop, reduction);
    then grant_basis_for_amount_determination_48(prop, reduced + reduction);
}
pub relation grant_amount_48(prop: Asset, amount: Money) kind empirical {
    label en official "the amount of the section 1603 grant — case-asserted";
}
pub relation grant_excluded_from_income_48(prop: Asset) kind institutional {
    label en official "section 48(d)(3)(A): the grant is not includible in gross income or alternative minimum taxable income";
}
@source(IRC_S48_D, relation = formalizes, coverage = exact, quote = "(A) shall not be includible in the gross income or alternative minimum taxable income of the taxpayer, but")
rule GrantExcludedFromIncomeRule(prop: Asset, amount: Money) strict {
    when grant_amount_48(prop, amount);
    then grant_excluded_from_income_48(prop);
}
pub relation basis_reduction_under_50c_as_for_credit_48(prop: Asset, amount: Money) kind empirical {
    label en official "the reduction of basis under section 50(c) in the same manner as a credit allowed under subsection (a) (section 48(d)(3)(B)) — case-asserted";
}
pub relation basis_taking_grant_into_account_48(prop: Asset, basis: Money) kind institutional {
    label en official "section 48(d)(3)(B): the grant is taken into account in determining basis (added), reduced under section 50(c) in the same manner as a credit allowed under subsection (a)";
}
@source(IRC_S48_D, relation = formalizes, coverage = exact, quote = "(B) shall be taken into account in determining the basis of the property to which such grant relates, except that the basis of such property shall be reduced under section 50(c) in the same manner as a credit allowed under subsection (a).")
rule BasisTakingGrantIntoAccountRule(prop: Asset, basis: Money, grant: Money, reduction: Money) strict {
    when property_basis_after_reduction_48(prop, basis);
    when grant_amount_48(prop, grant);
    when basis_reduction_under_50c_as_for_credit_48(prop, reduction);
    then basis_taking_grant_into_account_48(prop, basis + grant - reduction);
}

// --- (e): the environmental justice solar and wind capacity increase -------------------------------------------------------------------------------

pub relation facility_generates_solely_from_wind_or_solar_property_48(facility: Asset) kind empirical {
    label en official "the facility generates electricity solely from property described in section 45(d)(1) or in clause (i) or (vi) of subsection (a)(3)(A) (section 48(e)(2)(A)(i)) — case-asserted";
}
pub relation facility_maximum_net_output_mw_ac_48(facility: Asset, mw: Decimal) kind empirical {
    label en official "the maximum net output of the facility in megawatts, as measured in alternating current (section 48(e)(2)(A)(ii)) — case-asserted";
}
pub relation facility_in_low_income_community_or_on_indian_land_48(facility: Asset) kind empirical {
    label en official "the facility is located in a low-income community (section 45D(e)) or on Indian land (section 2601(2) of the Energy Policy Act of 1992) (section 48(e)(2)(A)(iii)(I)) — case-asserted";
}
pub relation covered_housing_program_building_48(facility: Asset) kind empirical {
    label en official "the facility is installed on a residential rental building which participates in a covered housing program (section 41411(a) of the Violence Against Women Act of 1994), a Housing Act of 1949 title V program, a tribally designated housing entity program, or another program listed in section 48(e)(2)(B)(i) — case-asserted (the program list is bundled)";
}
pub relation financial_benefits_allocated_equitably_among_occupants_48(facility: Asset) kind empirical {
    label en official "the financial benefits of the electricity produced by the facility are allocated equitably among the occupants of the dwelling units of the building (section 48(e)(2)(B)(ii)) — case-asserted";
}
pub relation share_of_financial_benefits_to_low_income_households_48(facility: Asset, share: Decimal) kind empirical {
    label en official "the share (fraction) of the financial benefits of the electricity produced by the facility provided to households with income below 200 percent of the poverty line or below 80 percent of area median gross income (section 48(e)(2)(C)) — case-asserted; electricity acquired at a below-market rate counts as a financial benefit ((e)(2)(D))";
}
pub relation part_of_qualified_low_income_residential_building_project_48(facility: Asset) kind institutional {
    label en official "section 48(e)(2)(B): installed on a residential rental building in a covered housing program (or a listed program) with the financial benefits allocated equitably among the occupants";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "A facility shall be treated as part of a qualified low-income residential building project if—")
rule QualifiedLowIncomeResidentialBuildingProjectRule(facility: Asset) strict {
    when covered_housing_program_building_48(facility);
    when financial_benefits_allocated_equitably_among_occupants_48(facility);
    then part_of_qualified_low_income_residential_building_project_48(facility);
}
pub relation part_of_qualified_low_income_economic_benefit_project_48(facility: Asset) kind institutional {
    label en official "section 48(e)(2)(C): at least 50 percent of the financial benefits of the electricity are provided to households with income below 200 percent of the poverty line or below 80 percent of area median gross income";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "A facility shall be treated as part of a qualified low-income economic benefit project if at least 50 percent of the financial benefits of the electricity produced by such facility are provided to households with income of—")
rule QualifiedLowIncomeEconomicBenefitProjectRule(facility: Asset, share: Decimal) strict {
    when share_of_financial_benefits_to_low_income_households_48(facility, share);
    when share >= 0.50;
    then part_of_qualified_low_income_economic_benefit_project_48(facility);
}
pub relation qualified_solar_and_wind_facility_by_location_48(facility: Asset) kind institutional {
    label en official "section 48(e)(2)(A)(iii)(I): the facility is located in a low-income community or on Indian land";
}
rule QualifiedSolarWindFacilityByLocationRule(facility: Asset) strict {
    when facility_in_low_income_community_or_on_indian_land_48(facility);
    then qualified_solar_and_wind_facility_by_location_48(facility);
}
pub relation qualified_solar_and_wind_facility_48(facility: Asset) kind institutional {
    label en official "section 48(e)(2)(A): a facility generating electricity solely from wind or solar property with a maximum net output of less than 5 MW (AC) that is in a low-income community or on Indian land, or part of a qualified low-income residential building project or economic benefit project";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "The term \"qualified solar and wind facility\" means any facility—")
rule QualifiedSolarAndWindFacilityLocationRule(facility: Asset, mw: Decimal) strict {
    when facility_generates_solely_from_wind_or_solar_property_48(facility);
    when facility_maximum_net_output_mw_ac_48(facility, mw);
    when mw < 5.0;
    when qualified_solar_and_wind_facility_by_location_48(facility);
    then qualified_solar_and_wind_facility_48(facility);
}
rule QualifiedSolarAndWindFacilityResidentialRule(facility: Asset, mw: Decimal) strict {
    when facility_generates_solely_from_wind_or_solar_property_48(facility);
    when facility_maximum_net_output_mw_ac_48(facility, mw);
    when mw < 5.0;
    when part_of_qualified_low_income_residential_building_project_48(facility);
    then qualified_solar_and_wind_facility_48(facility);
}
rule QualifiedSolarAndWindFacilityEconomicBenefitRule(facility: Asset, mw: Decimal) strict {
    when facility_generates_solely_from_wind_or_solar_property_48(facility);
    when facility_maximum_net_output_mw_ac_48(facility, mw);
    when mw < 5.0;
    when part_of_qualified_low_income_economic_benefit_project_48(facility);
    then qualified_solar_and_wind_facility_48(facility);
}
pub relation ej_capacity_limitation_allocated_to_facility_mw_dc_48(facility: Asset, mw: Decimal) kind empirical {
    label en official "the amount of environmental justice solar and wind capacity limitation allocated by the Secretary to the facility, in megawatts of direct current capacity (section 48(e)(1)(B)(i)) — case-asserted";
}
pub relation facility_total_nameplate_capacity_mw_dc_48(facility: Asset, mw: Decimal) kind empirical {
    label en official "the total megawatt nameplate capacity of the facility, as measured in direct current (section 48(e)(1)(B)(ii)) — case-asserted";
}
pub relation eligible_property_energy_percentage_increase_48(facility: Asset, points: Decimal) kind institutional {
    label en official "section 48(e)(1)(A): the energy percentage is increased by 10 percentage points for a facility described in (2)(A)(iii)(I) and not in (II), and by 20 percentage points for one described in (2)(A)(iii)(II)";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "(i) in the case of a facility described in subclause (I) of paragraph (2)(A)(iii) and not described in subclause (II) of such paragraph, 10 percentage points, and")
rule EnergyPercentageIncrease10PointsRule(facility: Asset) strict {
    when qualified_solar_and_wind_facility_48(facility);
    when ej_capacity_limitation_allocated_to_facility_mw_dc_48(facility, _);
    when qualified_solar_and_wind_facility_by_location_48(facility);
    when not_known(part_of_qualified_low_income_residential_building_project_48(facility));
    when not_known(part_of_qualified_low_income_economic_benefit_project_48(facility));
    then eligible_property_energy_percentage_increase_48(facility, 10.0);
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "(ii) in the case of a facility described in subclause (II) of paragraph (2)(A)(iii), 20 percentage points, and")
rule EnergyPercentageIncrease20PointsResidentialRule(facility: Asset) strict {
    when qualified_solar_and_wind_facility_48(facility);
    when ej_capacity_limitation_allocated_to_facility_mw_dc_48(facility, _);
    when part_of_qualified_low_income_residential_building_project_48(facility);
    then eligible_property_energy_percentage_increase_48(facility, 20.0);
}
rule EnergyPercentageIncrease20PointsEconomicBenefitRule(facility: Asset) strict {
    when qualified_solar_and_wind_facility_48(facility);
    when ej_capacity_limitation_allocated_to_facility_mw_dc_48(facility, _);
    when part_of_qualified_low_income_economic_benefit_project_48(facility);
    then eligible_property_energy_percentage_increase_48(facility, 20.0);
}
pub relation increase_in_credit_before_capacity_ratio_48(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the increase in the credit determined under subsection (a) by reason of subsection (e) for the year, for all property which is part of the facility, before the (e)(1)(B) ratio — case-asserted";
}
pub relation increase_in_credit_after_capacity_ratio_48(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(e)(1)(B): the increase does not exceed the increase times the ratio of the allocated limitation to the total megawatt nameplate capacity of the facility (cents HALF_UP judgment call)";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "(B) the increase in the credit determined under subsection (a) by reason of this subsection for any taxable year with respect to all property which is part of such facility shall not exceed the amount which bears the same ratio to the amount of such increase (determined without regard to this subparagraph) as—")
rule IncreaseInCreditAfterCapacityRatioRule(facility: Asset, y: TaxableYear, increase: Money, limit: Decimal, total: Decimal) strict {
    when qualified_solar_and_wind_facility_48(facility);
    when increase_in_credit_before_capacity_ratio_48(facility, y, increase);
    when ej_capacity_limitation_allocated_to_facility_mw_dc_48(facility, limit);
    when facility_total_nameplate_capacity_mw_dc_48(facility, total);
    when total > 0.0;
    then increase_in_credit_after_capacity_ratio_48(facility, y, min(increase, div_round(increase * limit, total, 2, "HALF_UP")));
}
relation eligible_energy_property_base_48(prop: Asset) kind institutional;
pub relation eligible_energy_property_48(prop: Asset) kind institutional {
    label en official "section 48(e)(3): energy property that is part of a section 45(d)(1) wind facility for which the (a)(5) election was made, or is described in clause (i) or (vi) of subsection (a)(3)(A), including energy storage technology installed in connection with such property";
}
pub relation part_of_wind_facility_with_a5_election_48(prop: Asset) kind empirical {
    label en official "the energy property is part of a facility described in section 45(d)(1) for which an election was made under subsection (a)(5) — case-asserted";
}
pub relation solar_electric_or_small_wind_property_clause_i_or_vi_48(prop: Asset) kind empirical {
    label en official "the energy property is described in clause (i) or (vi) of subsection (a)(3)(A) (solar electric property; qualified small wind energy property) — case-asserted";
}
pub relation energy_storage_installed_in_connection_with_48(storage: Asset, prop: Asset) kind empirical {
    label en official "the energy storage technology (subsection (a)(3)(A)(ix)) is installed in connection with the energy property — case-asserted";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"eligible property\" means energy property which—")
rule EligibleEnergyPropertyWindElectionRule(prop: Asset) strict {
    when part_of_wind_facility_with_a5_election_48(prop);
    then eligible_energy_property_base_48(prop);
}
rule EligibleEnergyPropertySolarSmallWindRule(prop: Asset) strict {
    when solar_electric_or_small_wind_property_clause_i_or_vi_48(prop);
    then eligible_energy_property_base_48(prop);
}
rule EligibleEnergyPropertyBaseIsEligibleRule(prop: Asset) strict {
    when eligible_energy_property_base_48(prop);
    then eligible_energy_property_48(prop);
}
rule EligibleEnergyPropertyStorageRule(storage: Asset, prop: Asset) strict {
    when energy_storage_installed_in_connection_with_48(storage, prop);
    when eligible_energy_property_base_48(prop);
    then eligible_energy_property_48(storage);
}

pub relation ej_program_enactment_date_48(on: Date) kind empirical {
    label en official "the date of enactment of section 48(e) — not pinned in the corpus (SOURCE_GAP), case-asserted";
}
pub relation ej_allocation_program_established_48(on: Date) kind empirical {
    label en official "the Secretary established the program to allocate the environmental justice solar and wind capacity limitation on this date (section 48(e)(4)(A)) — case-asserted";
}
@source(IRC_S48_E, relation = formalizes, coverage = partial, quote = "Not later than 180 days after the date of enactment of this subsection, the Secretary shall establish a program to allocate amounts of environmental justice solar and wind capacity limitation to qualified solar and wind facilities.")
rule Section48E4ASecretaryProgramDutyRule(enacted: Date) strict {
    when ej_program_enactment_date_48(enacted);
    then duty Section48E4AProgramDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition ej_program_established_by_deadline_48(enacted);
            window [enacted, add_calendar_period(enacted, 180 calendar_day)];
        }
    };
}
pub relation ej_program_established_by_deadline_48(enacted: Date) kind institutional {
    label en official "the program of section 48(e)(4)(A) is established (a fact of the case)";
}
rule EjProgramEstablishedByDeadlineRule(enacted: Date, on: Date) strict {
    when ej_program_enactment_date_48(enacted);
    when ej_allocation_program_established_48(on);
    when on >= enacted;
    when on <= add_calendar_period(enacted, 180 calendar_day);
    then ej_program_established_by_deadline_48(enacted);
}
pub relation annual_capacity_limitation_gw_dc_48(year: Decimal, gw: Decimal) kind institutional {
    label en official "section 48(e)(4)(C): 1.8 gigawatts of direct current capacity for each of calendar years 2023 and 2024, and zero thereafter";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"annual capacity limitation\" means 1.8 gigawatts of direct current capacity for each of calendar years 2023 and 2024, and zero thereafter.")
rule AnnualCapacityLimitation2023Rule(year: Decimal) strict {
    when ej_year_48(year);
    when year >= 2023.0;
    when year <= 2024.0;
    then annual_capacity_limitation_gw_dc_48(year, 1.8);
}
rule AnnualCapacityLimitationThereafterRule(year: Decimal) strict {
    when ej_year_48(year);
    when year > 2024.0;
    then annual_capacity_limitation_gw_dc_48(year, 0.0);
}
pub relation ej_year_48(year: Decimal) kind empirical {
    label en official "a calendar year under consideration for the allocation of the environmental justice capacity limitation — case-asserted";
}
pub relation ej_capacity_allocated_in_year_gw_48(year: Decimal, gw: Decimal) kind empirical {
    label en official "the aggregate environmental justice solar and wind capacity limitation the Secretary allocated during the calendar year, in gigawatts — case-asserted";
}
pub relation ej_capacity_carried_from_prior_year_gw_48(year: Decimal, gw: Decimal) kind empirical {
    label en official "the excess carried to the calendar year from the preceding year, including expired allocations, capped as the last sentence of (e)(4)(D) provides — case-asserted";
}
pub relation ej_capacity_available_gw_48(year: Decimal, gw: Decimal) kind institutional {
    label en official "section 48(e)(4)(B), (D): the annual capacity limitation plus the excess carried from the preceding year (no carryover to a year after 2024 except as section 48E(h)(4)(D)(ii) provides)";
}
@source(IRC_S48_E, relation = formalizes, coverage = partial, quote = "If the annual capacity limitation for any calendar year exceeds the aggregate amount allocated for such year under this paragraph, such limitation for the succeeding calendar year shall be increased by the amount of such excess.")
rule EjCapacityAvailableRule(year: Decimal, limit: Decimal, carried: Decimal) defeasible {
    when annual_capacity_limitation_gw_dc_48(year, limit);
    when ej_capacity_excess_including_expiry_48(year, carried);
    when year <= 2024.0;
    then ej_capacity_available_gw_48(year, limit + carried);
}
rule EjCapacityAvailableNoCarryRule(year: Decimal, limit: Decimal) defeasible {
    when annual_capacity_limitation_gw_dc_48(year, limit);
    when year <= 2024.0;
    when not_known(ej_capacity_excess_present_48(year));
    then ej_capacity_available_gw_48(year, limit);
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "No amount may be carried under the preceding sentence to any calendar year after 2024 except as provided in section 48E(h)(4)(D)(ii).")
rule EjCapacityAvailableAfter2024Rule(year: Decimal, limit: Decimal) defeasible {
    when annual_capacity_limitation_gw_dc_48(year, limit);
    when year > 2024.0;
    then ej_capacity_available_gw_48(year, limit);
}
relation ej_capacity_carried_from_prior_year_asserted_48(year: Decimal) kind institutional;
rule EjCapacityCarriedAssertedRule(year: Decimal, gw: Decimal) strict {
    when ej_capacity_carried_from_prior_year_gw_48(year, gw);
    then ej_capacity_carried_from_prior_year_asserted_48(year);
}
pub relation secretary_allocates_above_annual_limitation_48(year: Decimal) kind institutional {
    label en official "section 48(e)(4)(B): the amount allocated during the calendar year exceeds the annual capacity limitation";
}
rule SecretaryAllocatesAboveAnnualLimitationRule(year: Decimal, allocated: Decimal, available: Decimal) defeasible {
    when ej_capacity_allocated_in_year_gw_48(year, allocated);
    when ej_capacity_available_gw_48(year, available);
    when allocated > available;
    then secretary_allocates_above_annual_limitation_48(year);
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "The amount of environmental justice solar and wind capacity limitation allocated by the Secretary under subparagraph (A) during any calendar year shall not exceed the annual capacity limitation with respect to such year.")
rule Section48E4BAllocationLimitRule(year: Decimal) defeasible {
    when secretary_allocates_above_annual_limitation_48(year);
    then prohibition Section48E4BAllocationLimit {
        bearer us.irc.core::Secretary;
        action secretary_allocates_above_annual_limitation_48(year);
        window [@2022-08-16, infinity);
    };
}
pub relation ej_allocation_date_48(facility: Asset, on: Date) kind empirical {
    label en official "the date of the allocation of the environmental justice capacity limitation to the facility (section 48(e)(4)(E)(i)) — case-asserted";
}
pub relation property_placed_in_service_date_48(prop: Asset, on: Date) kind empirical {
    label en official "the date the property is placed in service — case-asserted";
}
pub relation property_part_of_facility_48(prop: Asset, facility: Asset) kind empirical {
    label en official "the property is part of the facility — case-asserted";
}
pub relation ej_increase_applies_to_property_48(prop: Asset) kind institutional {
    label en official "section 48(e)(4)(E)(i): paragraph (1) does not apply to property placed in service after the date 4 years after the allocation to the facility";
}
@source(IRC_S48_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply with respect to any property which is placed in service after the date that is 4 years after the date of the allocation with respect to the facility of which such property is a part.")
rule EjIncreaseAppliesToPropertyRule(prop: Asset, facility: Asset, allocated: Date, placed: Date) strict {
    when property_part_of_facility_48(prop, facility);
    when ej_allocation_date_48(facility, allocated);
    when property_placed_in_service_date_48(prop, placed);
    when placed <= add_calendar_period(allocated, 48 calendar_month);
    then ej_increase_applies_to_property_48(prop);
}
