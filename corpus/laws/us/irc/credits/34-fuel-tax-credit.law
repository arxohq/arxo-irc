// Sections 27, 34 and 37 — credits by reference. Stage 2d (IRC-06,
// DECISION-0379).
//
// * Section 27 allows the foreign tax credit "to the extent provided in
//   section 901": owned by `us.irc.international`; here an external dependency
//   recorded in the coverage row and the package dependency contract
//   (`foreign_tax_credit_allowed`), no computation.
// * Section 34 allows a credit against the tax imposed by subtitle A for the
//   sum of the amounts payable to the taxpayer under sections 6420, 6421 and
//   6427; the amounts payable under 6421 or 6427 that are claimed and payable
//   under 6421(i) or 6427(k) are excluded (b). The payable amounts are
//   case-asserted (TECH-GAPS G1807).
// * Section 37 is a cross-reference to section 6401: no rule.

use self::{
    IRC_S34_A,
    IRC_S34_B,
    Person,
    TaxableYear,
};

pub relation amount_payable_under_6420_34(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount payable to the taxpayer under section 6420 (gasoline used on farms), determined without regard to section 6420(g) — case-asserted";
}
pub relation amount_payable_under_6421_34(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount payable to the taxpayer under section 6421 (gasoline used for certain nonhighway purposes), determined without regard to section 6421(i) — case-asserted";
}
pub relation amount_payable_under_6427_34(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount payable to the taxpayer under section 6427 (fuels not used for taxable purposes), determined without regard to section 6427(k) — case-asserted";
}
pub relation claim_timely_filed_and_payable_now_34(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "a claim for the section 6421 or 6427 amount is timely filed and, under section 6421(i) or 6427(k), is payable under that section (section 34(b)) — case-asserted";
}
pub relation foreign_tax_credit_allowed(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 27 dependency contract: the credit for foreign taxes to the extent provided in section 901 (owned by us.irc.international, resolved outside this package) — case-asserted here";
}

pub relation fuel_tax_credit_before_exclusion_34(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 34(a): the sum of the amounts payable under sections 6420, 6421 and 6427";
}
@source(IRC_S34_A, quote = "an amount equal to the sum of the amounts payable to the taxpayer")
rule FuelTaxCreditBeforeExclusion34Rule(taxpayer: Person, y: TaxableYear, a: Money, b: Money, c: Money) defeasible {
    when amount_payable_under_6420_34(taxpayer, y, a);
    when amount_payable_under_6421_34(taxpayer, y, b);
    when amount_payable_under_6427_34(taxpayer, y, c);
    then fuel_tax_credit_before_exclusion_34(taxpayer, y, a + b + c);
}
pub relation fuel_tax_credit_34(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 34 credit for certain uses of fuels: the sum, unless the section 6421 and 6427 amounts are claimed and payable now (section 34(b)), in which case only the section 6420 amount is credited";
}
rule FuelTaxCreditNotClaimed34Rule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when fuel_tax_credit_before_exclusion_34(taxpayer, y, amount);
    when not_known(claim_timely_filed_and_payable_now_34(taxpayer, y));
    then fuel_tax_credit_34(taxpayer, y, amount);
}
@source(IRC_S34_B, quote = "Credit shall not be allowed under subsection (a) for any amount payable under section 6421 or 6427, if a claim for such amount is timely filed and, under section 6421(i) or 6427(k), is payable under such section.")
rule FuelTaxCreditClaimed34Rule(taxpayer: Person, y: TaxableYear, a: Money) defeasible {
    when amount_payable_under_6420_34(taxpayer, y, a);
    when claim_timely_filed_and_payable_now_34(taxpayer, y);
    then fuel_tax_credit_34(taxpayer, y, a);
}
