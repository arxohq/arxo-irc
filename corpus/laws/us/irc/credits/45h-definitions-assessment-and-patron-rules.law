// Section 45H — the qualified costs of (c)(2), the applicable period of (c)(4), the low sulfur diesel fuel of (c)(5), the refinery test of (d),
// the certification application of (e)(2), the assessment period of (e)(4), and the patron rules of (f). Stage 2f (IRC-06, DECISION-0379,
// TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of `45h-low-sulfur-diesel-fuel-production-credit.law`; its credit
// rules read the qualified costs and the run figures as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the applicable EPA regulations and the compliance date are case facts; the expenditure kinds of (c)(2) are an enum fact of
// the cost; the assessment period rule is a computed date; amounts are cents HALF_UP; the cooperative rules repeat those of section 40(g)(6)
// for the section 45H credit.

use self::{
    Asset,
    IRC_S45H_C,
    IRC_S45H_D,
    IRC_S45H_E,
    IRC_S45H_F,
    Person,
    TaxableYear,
    credit_apportioned_to_patrons_45h,
    elects_to_apportion_credit_to_patrons_45h,
};

pub enum CostKind45H { NewProcessUnits, DismantlingAndReconstruction, AdjacentOrOffsiteEquipment, EngineeringAndPermitting, OtherCost }

// --- (c)(2), (c)(4), (c)(5): qualified costs, applicable period, diesel fuel ---------------------------------------------------------------------

pub relation cost_kind_45h(item: Asset, kind: CostKind45H) kind empirical {
    label en official "the kind of the cost paid or incurred for compliance with the applicable EPA regulations (section 45H(c)(2)) — case-asserted";
}
pub relation cost_paid_or_incurred_on_45h(item: Asset, on: Date) kind empirical {
    label en official "the date the cost is paid or incurred — case-asserted";
}
pub relation compliance_date_for_facility_45h(facility: Asset, on: Date) kind empirical {
    label en official "the date on which the taxpayer must comply with the applicable EPA regulations with respect to the facility (section 45H(c)(4)) — case-asserted";
}
pub relation cost_of_facility_45h(item: Asset, facility: Asset, amount: Money) kind empirical {
    label en official "the amount of the cost with respect to the facility — case-asserted";
}
pub relation applicable_period_end_45h(facility: Asset, on: Date) kind institutional {
    label en official "section 45H(c)(4): the applicable period begins on January 1, 2003, and ends on the earlier of the date 1 year after the compliance date and December 31, 2009";
}
@source(IRC_S45H_C, relation = formalizes, coverage = exact, quote = "the period beginning on January 1, 2003, and ending on the earlier of the date which is 1 year after the date on which the taxpayer must comply with the applicable EPA regulations with respect to such facility or December 31, 2009")
rule ApplicablePeriodEndCompliancePlusYearRule(facility: Asset, compliance: Date) strict {
    when compliance_date_for_facility_45h(facility, compliance);
    when add_calendar_period(compliance, 12 calendar_month) <= @2009-12-31;
    then applicable_period_end_45h(facility, add_calendar_period(compliance, 12 calendar_month));
}
rule ApplicablePeriodEnd2009Rule(facility: Asset, compliance: Date) strict {
    when compliance_date_for_facility_45h(facility, compliance);
    when add_calendar_period(compliance, 12 calendar_month) > @2009-12-31;
    then applicable_period_end_45h(facility, @2009-12-31);
}
pub relation qualified_cost_45h(item: Asset, facility: Asset, amount: Money) kind institutional {
    label en official "section 45H(c)(2): costs paid or incurred during the applicable period for compliance with the applicable EPA regulations for the facility, including new process operation units, dismantling and reconstruction of process units, associated adjacent or offsite equipment, and engineering and permitting";
}
@source(IRC_S45H_C, relation = formalizes, coverage = exact, quote = "those costs paid or incurred during the applicable period for compliance with the applicable EPA regulations with respect to such facility")
rule QualifiedCost45hRule(item: Asset, facility: Asset, amount: Money, on: Date, period_end: Date, kind: CostKind45H) strict {
    when cost_of_facility_45h(item, facility, amount);
    when cost_kind_45h(item, kind);
    when kind != OtherCost;
    when cost_paid_or_incurred_on_45h(item, on);
    when on >= @2003-01-01;
    when applicable_period_end_45h(facility, period_end);
    when on <= period_end;
    then qualified_cost_45h(item, facility, amount);
}
pub relation diesel_fuel_sulfur_ppm_45h(fuel: Asset, ppm: Decimal) kind empirical {
    label en official "the sulfur content of the diesel fuel in parts per million (section 45H(c)(5)) — case-asserted";
}
pub relation low_sulfur_diesel_fuel_45h(fuel: Asset) kind institutional {
    label en official "section 45H(c)(5): diesel fuel with a sulfur content of 15 parts per million or less";
}
@source(IRC_S45H_C, relation = formalizes, coverage = exact, quote = "The term \"low sulfur diesel fuel\" means diesel fuel with a sulfur content of 15 parts per million or less.")
rule LowSulfurDieselFuelRule(fuel: Asset, ppm: Decimal) strict {
    when diesel_fuel_sulfur_ppm_45h(fuel, ppm);
    when ppm <= 15.0;
    then low_sulfur_diesel_fuel_45h(fuel);
}

// --- (d): the refinery test ------------------------------------------------------------------------------------------------------------------------------------

pub relation refinery_of_refiner_or_related_person_on_april_1_2003_45h(refinery: Asset, refiner: Person) kind empirical {
    label en official "the refinery, on April 1, 2003, was a refinery of the refiner or a related person (within the meaning of section 613A(d)(3)) (section 45H(d)) — case-asserted";
}
pub relation refinery_daily_run_45h(refinery: Asset, barrels: Decimal) kind empirical {
    label en official "the average daily domestic refinery run or retained production of the refinery — case-asserted";
}
pub relation refinery_taken_into_account_45h(refinery: Asset, refiner: Person) kind institutional {
    label en official "section 45H(d): in the calculation of average daily domestic refinery run or retained production, only refineries which on April 1, 2003, were refineries of the refiner or a related person are taken into account";
}
@source(IRC_S45H_D, relation = formalizes, coverage = exact, quote = "only refineries which on April 1, 2003, were refineries of the refiner or a related person (within the meaning of section 613A(d)(3)), shall be taken into account")
rule RefineryTakenIntoAccountRule(refinery: Asset, refiner: Person) strict {
    when refinery_of_refiner_or_related_person_on_april_1_2003_45h(refinery, refiner);
    then refinery_taken_into_account_45h(refinery, refiner);
}
pub relation aggregate_daily_run_of_taken_into_account_refineries_45h(refiner: Person, barrels: Decimal) kind institutional {
    label en official "section 45H(d): the average daily run of the refiner, counting only the refineries taken into account";
}
rule AggregateDailyRunOfTakenIntoAccountRefineriesRule(refiner: Person, one_refinery: Asset, one_run: Decimal) strict {
    when refinery_taken_into_account_45h(one_refinery, refiner);
    when refinery_daily_run_45h(one_refinery, one_run);
    then aggregate_daily_run_of_taken_into_account_refineries_45h(refiner, sum(collect all b: Decimal, r: Asset where refinery_taken_into_account_45h(r, refiner) and refinery_daily_run_45h(r, b), empty: 0.0));
}

// --- (e)(2), (e)(4): the application and the assessment period ---------------------------------------------------------------------------------------------

pub relation application_includes_unit_capacities_and_operating_characteristics_45h(facility: Asset) kind empirical {
    label en official "the application for certification includes relevant information regarding unit capacities and operating characteristics sufficient for the Secretary, after consultation with the EPA Administrator, to determine that the qualified costs are necessary for compliance (section 45H(e)(2)) — case-asserted";
}
pub relation application_information_sufficient_45h(facility: Asset) kind institutional {
    label en official "section 45H(e)(2): an application for certification includes relevant information on unit capacities and operating characteristics sufficient to determine that the qualified costs are necessary for compliance with the applicable EPA regulations";
}
@source(IRC_S45H_E, relation = formalizes, coverage = exact, quote = "An application for certification shall include relevant information regarding unit capacities and operating characteristics")
rule ApplicationInformationSufficientRule(facility: Asset) strict {
    when application_includes_unit_capacities_and_operating_characteristics_45h(facility);
    then application_information_sufficient_45h(facility);
}
pub relation review_period_ends_on_45h(taxpayer: Person, on: Date) kind empirical {
    label en official "the date the review period described in paragraph (3) ends with respect to the taxpayer — case-asserted";
}
pub relation assessment_period_expiry_on_45h(taxpayer: Person, on: Date) kind empirical {
    label en official "the date on which the statutory period for the assessment of a deficiency attributable to the credit would otherwise expire — case-asserted";
}
pub relation effective_assessment_period_expiry_45h(taxpayer: Person, on: Date) kind institutional {
    label en official "section 45H(e)(4)(A): the statutory period for the assessment of any deficiency attributable to the credit does not expire before the end of the 3-year period ending on the date the review period ends (the later of the ordinary expiry and the review period end)";
}
@source(IRC_S45H_E, relation = formalizes, coverage = exact, quote = "the statutory period for the assessment of any deficiency attributable to such credit shall not expire before the end of the 3-year period ending on the date that the review period described in paragraph (3) ends with respect to the taxpayer")
rule EffectiveAssessmentPeriodExpiryOrdinaryRule(taxpayer: Person, review_end: Date, expiry: Date) strict {
    when review_period_ends_on_45h(taxpayer, review_end);
    when assessment_period_expiry_on_45h(taxpayer, expiry);
    when expiry >= review_end;
    then effective_assessment_period_expiry_45h(taxpayer, expiry);
}
rule EffectiveAssessmentPeriodExpiryExtendedRule(taxpayer: Person, review_end: Date, expiry: Date) strict {
    when review_period_ends_on_45h(taxpayer, review_end);
    when assessment_period_expiry_on_45h(taxpayer, expiry);
    when expiry < review_end;
    then effective_assessment_period_expiry_45h(taxpayer, review_end);
}
pub relation assessment_attempted_on_45h(taxpayer: Person, on: Date) kind empirical {
    label en official "the date a deficiency attributable to the credit is assessed — case-asserted";
}
pub relation deficiency_assessable_on_45h(taxpayer: Person, on: Date) kind institutional {
    label en official "section 45H(e)(4)(B): a deficiency attributable to the credit may be assessed before the expiration of the 3-year period notwithstanding any other law or rule that would otherwise prevent the assessment";
}
@source(IRC_S45H_E, relation = formalizes, coverage = exact, quote = "such deficiency may be assessed before the expiration of such 3-year period notwithstanding the provisions of any other law or rule of law which would otherwise prevent such assessment")
rule DeficiencyAssessableRule(taxpayer: Person, on: Date, review_end: Date) strict {
    when assessment_attempted_on_45h(taxpayer, on);
    when review_period_ends_on_45h(taxpayer, review_end);
    when on <= review_end;
    then deficiency_assessable_on_45h(taxpayer, on);
}

// --- (f): the patron rules ------------------------------------------------------------------------------------------------------------------------------------

pub relation election_made_on_timely_return_45h(organization: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely filed return for the taxable year (section 45H(f)(1)(B)) — case-asserted";
}
pub relation election_irrevocable_for_year_45h(organization: Person, y: TaxableYear) kind institutional {
    label en official "section 45H(f)(1)(B): an election, once made, is irrevocable for the taxable year";
}
@source(IRC_S45H_F, relation = formalizes, coverage = exact, quote = "Such election, once made, shall be irrevocable for such taxable year.")
rule ElectionIrrevocableForYearRule(organization: Person, y: TaxableYear) strict {
    when elects_to_apportion_credit_to_patrons_45h(organization, y);
    when election_made_on_timely_return_45h(organization, y);
    then election_irrevocable_for_year_45h(organization, y);
}
pub relation cooperative_credit_determined_45h(organization: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit of the cooperative determined under subsection (a) for the year — case-asserted";
}
pub relation cooperative_credit_apportioned_45h(organization: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the credit apportioned to patrons — case-asserted";
}
pub relation cooperative_credit_not_apportioned_45h(organization: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45H(f)(2)(A): the credit not apportioned to patrons is included in the amount determined for the taxable year of the organization";
}
@source(IRC_S45H_F, relation = formalizes, coverage = exact, quote = "The amount of the credit not apportioned to patrons pursuant to paragraph (1) shall be included in the amount determined under subsection (a) for the taxable year of the organization.")
rule CooperativeCreditNotApportionedRule(organization: Person, y: TaxableYear, total: Money, apportioned: Money) strict {
    when cooperative_credit_determined_45h(organization, y, total);
    when cooperative_credit_apportioned_45h(organization, y, apportioned);
    then cooperative_credit_not_apportioned_45h(organization, y, max(total - apportioned, 0 USD));
}
pub relation patron_credit_45h(organization: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45H(f)(2)(B): the apportioned credit is included in the credit of each patron for its first taxable year ending on or after the end of the payment period (or the notice date, if earlier)";
}
pub relation business_done_by_patron_45h(organization: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the quantity or value of business done with or for the patron during the taxable year — case-asserted";
}
pub relation total_business_done_45h(organization: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total business done with or for patrons during the taxable year — case-asserted";
}
rule PatronCreditRule(organization: Person, patron: Person, y: TaxableYear, apportioned: Money, done: Money, total: Money) strict {
    when credit_apportioned_to_patrons_45h(organization, y);
    when cooperative_credit_apportioned_45h(organization, y, apportioned);
    when business_done_by_patron_45h(organization, patron, y, done);
    when total_business_done_45h(organization, y, total);
    when total > 0 USD;
    then patron_credit_45h(organization, patron, y, div_round(apportioned * (done / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation decrease_of_apportioned_credit_45h(organization: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount by which a credit apportioned to the patron is decreased for any reason (section 45H(f)(3)) — case-asserted";
}
pub relation patron_tax_not_increased_by_decrease_45h(organization: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45H(f)(3)(A): the decrease of an apportioned credit does not increase the tax imposed on the patron";
}
@source(IRC_S45H_F, relation = formalizes, coverage = exact, quote = "such amount shall not increase the tax imposed on such patron")
rule PatronTaxNotIncreasedByDecreaseRule(organization: Person, patron: Person, y: TaxableYear, amount: Money) strict {
    when decrease_of_apportioned_credit_45h(organization, patron, y, amount);
    then patron_tax_not_increased_by_decrease_45h(organization, patron, y, amount);
}
pub relation organization_tax_increase_for_decrease_45h(organization: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45H(f)(3)(B): the tax imposed on the organization is increased by the amount of the decrease (a sum over patrons)";
}
@source(IRC_S45H_F, relation = formalizes, coverage = exact, quote = "the tax imposed by this chapter on such organization shall be increased by such amount")
rule OrganizationTaxIncreaseForDecreaseRule(organization: Person, one_patron: Person, y: TaxableYear, one_amount: Money) strict {
    when decrease_of_apportioned_credit_45h(organization, one_patron, y, one_amount);
    then organization_tax_increase_for_decrease_45h(organization, y,
        sum(collect all a: Money, p: Person where decrease_of_apportioned_credit_45h(organization, p, y, a), empty: 0 USD));
}
pub relation increase_excluded_from_tax_for_credits_and_minimum_tax_45h(organization: Person, y: TaxableYear) kind institutional {
    label en official "section 45H(f)(3), last sentence: the increase is not treated as tax imposed by this chapter for determining any credit or for section 55";
}
rule IncreaseExcludedFromTaxRule(organization: Person, y: TaxableYear, amount: Money) strict {
    when organization_tax_increase_for_decrease_45h(organization, y, amount);
    then increase_excluded_from_tax_for_credits_and_minimum_tax_45h(organization, y);
}
