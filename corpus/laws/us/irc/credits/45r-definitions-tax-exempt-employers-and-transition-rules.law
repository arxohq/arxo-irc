// Section 45R — the (e) definitions (employee, credit period, nonelective contribution, single employer), the (f) rules for a tax-exempt
// eligible small employer, and the (g) rules for taxable years beginning in 2010 through 2013. Stage 2f (IRC-06, DECISION-0379, TECH_GAP
// reduction of the stage 2c rows of TECH-GAPS G391). Companion of `45r-small-employer-health-insurance-credit.law`; its credit rules read the
// contribution totals, the credit period status and the tax-exempt status as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the exclusions of (e)(1)(A) read the asserted status of the individual (self-employed, 2-percent shareholder, 5-percent
// owner, family member); the payroll taxes of (f)(3) are the sum of the three asserted withholding and employer amounts; the credit period
// of (e)(2) and (g)(1) reads the asserted first year begin dates; the (g)(2) amounts are separate relations because the 2010-2013 credit
// is a different computation.

// --- (e)(1): employee ------------------------------------------------------------------------------------------------------------------------------------------

use self::{
    Asset,
    IRC_S45R_E,
    IRC_S45R_F,
    IRC_S45R_G,
    Person,
    TaxableYear,
    eligible_small_employer_45r,
    small_employer_health_insurance_credit,
    tax_exempt_eligible_small_employer,
    withholding_under_3401a_with_agreement_45r,
};

pub relation worker_of_employer_45r(person: Person, employer: Person) kind empirical {
    label en official "the individual works for the employer — case-asserted";
}
pub relation is_self_employed_under_401c1_45r(person: Person) kind empirical {
    label en official "the individual is an employee within the meaning of section 401(c)(1) (section 45R(e)(1)(A)(i)) — case-asserted";
}
pub relation is_two_percent_s_shareholder_45r(person: Person, employer: Person) kind empirical {
    label en official "the individual is a 2-percent shareholder (section 1372(b)) of an eligible small business which is an S corporation (section 45R(e)(1)(A)(ii)) — case-asserted";
}
pub relation is_five_percent_owner_45r(person: Person, employer: Person) kind empirical {
    label en official "the individual is a 5-percent owner (section 416(i)(1)(B)(i)) of an eligible small business (section 45R(e)(1)(A)(iii)) — case-asserted";
}
pub relation family_member_of_excluded_individual_45r(person: Person) kind empirical {
    label en official "the individual bears a relationship described in section 152(d)(2)(A)-(G) to, or is a dependent described in section 152(d)(2)(H) of, an individual described in clause (i), (ii) or (iii) (section 45R(e)(1)(A)(iv)) — case-asserted";
}
pub relation is_leased_employee_under_414n_45r(person: Person, employer: Person) kind empirical {
    label en official "the individual is a leased employee within the meaning of section 414(n) with respect to the employer (section 45R(e)(1)(B)) — case-asserted";
}
relation excluded_from_employee_45r(person: Person, employer: Person) kind institutional;
@source(IRC_S45R_E, relation = formalizes, coverage = exact, quote = "The term \"employee\" shall not include")
rule ExcludedFromEmployeeSelfEmployedRule(person: Person, employer: Person) strict {
    when worker_of_employer_45r(person, employer);
    when is_self_employed_under_401c1_45r(person);
    then excluded_from_employee_45r(person, employer);
}
rule ExcludedFromEmployeeTwoPercentRule(person: Person, employer: Person) strict {
    when worker_of_employer_45r(person, employer);
    when is_two_percent_s_shareholder_45r(person, employer);
    then excluded_from_employee_45r(person, employer);
}
rule ExcludedFromEmployeeFivePercentRule(person: Person, employer: Person) strict {
    when worker_of_employer_45r(person, employer);
    when is_five_percent_owner_45r(person, employer);
    then excluded_from_employee_45r(person, employer);
}
rule ExcludedFromEmployeeFamilyRule(person: Person, employer: Person) strict {
    when worker_of_employer_45r(person, employer);
    when family_member_of_excluded_individual_45r(person);
    then excluded_from_employee_45r(person, employer);
}
pub relation employee_45r(person: Person, employer: Person) kind institutional {
    label en official "section 45R(e)(1): a worker of the employer other than a self-employed individual, a 2-percent S corporation shareholder, a 5-percent owner or a family member of one; a leased employee is included";
}
rule Employee45rOrdinaryRule(person: Person, employer: Person) strict {
    when worker_of_employer_45r(person, employer);
    when not_known(excluded_from_employee_45r(person, employer));
    then employee_45r(person, employer);
}
@source(IRC_S45R_E, relation = formalizes, coverage = exact, quote = "The term \"employee\" shall include a leased employee within the meaning of section 414(n).")
rule Employee45rLeasedRule(person: Person, employer: Person) strict {
    when is_leased_employee_under_414n_45r(person, employer);
    then employee_45r(person, employer);
}

// --- (e)(2)-(5): credit period, nonelective contribution, wages, single employer --------------------------------------------------------------------

pub relation first_year_begin_offering_exchange_plans_45r(employer: Person, on: Date) kind empirical {
    label en official "the first day of the first taxable year in which the employer (or any predecessor) offers one or more qualified health plans to its employees through an Exchange (section 45R(e)(2)) — case-asserted";
}
pub relation taxable_year_begin_45r(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year — case-asserted";
}
pub relation credit_period_start_45r(employer: Person, on: Date) kind institutional {
    label en official "sections 45R(e)(2), (g)(1): the first day of the credit period: the first taxable year of offering Exchange plans, and for taxable years after 2013 no credit period is treated as beginning before 2014";
}
@source(IRC_S45R_G, relation = formalizes, coverage = exact, quote = "no credit period shall be treated as beginning with a taxable year beginning before 2014")
rule CreditPeriodStartRule(employer: Person, first: Date) strict {
    when first_year_begin_offering_exchange_plans_45r(employer, first);
    when first >= @2014-01-01;
    then credit_period_start_45r(employer, first);
}
rule CreditPeriodStartBefore2014Rule(employer: Person, first: Date) strict {
    when first_year_begin_offering_exchange_plans_45r(employer, first);
    when first < @2014-01-01;
    then credit_period_start_45r(employer, @2014-01-01);
}
pub relation within_derived_credit_period_45r(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45R(e)(2): the taxable year is in the 2-consecutive-taxable-year credit period beginning with the first year of offering; for taxable years beginning in 2010-2013 the credit is determined without regard to the credit period";
}
@source(IRC_S45R_E, relation = formalizes, coverage = exact, quote = "the 2-consecutive-taxable year period beginning with the 1st taxable year in which the employer (or any predecessor) offers 1 or more qualified health plans to its employees through an Exchange")
rule WithinDerivedCreditPeriodRule(employer: Person, y: TaxableYear, start: Date, begin: Date) strict {
    when credit_period_start_45r(employer, start);
    when taxable_year_begin_45r(y, begin);
    when begin >= start;
    when begin < add_calendar_period(start, 24 calendar_month);
    then within_derived_credit_period_45r(employer, y);
}
@source(IRC_S45R_G, relation = formalizes, coverage = exact, quote = "The credit shall be determined without regard to whether the taxable year is in a credit period")
rule WithinDerivedCreditPeriodTransitionRule(employer: Person, y: TaxableYear, begin: Date) strict {
    when taxable_year_begin_45r(y, begin);
    when begin >= @2010-01-01;
    when begin <= @2013-12-31;
    when eligible_small_employer_45r(employer, y);
    then within_derived_credit_period_45r(employer, y);
}
pub relation contribution_under_salary_reduction_arrangement_45r(contribution: Asset) kind empirical {
    label en official "the employer contribution is made pursuant to a salary reduction arrangement (section 45R(e)(3)) — case-asserted";
}
pub relation employer_contribution_45r(contribution: Asset) kind empirical {
    label en official "the item is an employer contribution — case-asserted";
}
pub relation nonelective_contribution_45r(contribution: Asset) kind institutional {
    label en official "section 45R(e)(3): an employer contribution other than an employer contribution pursuant to a salary reduction arrangement";
}
@source(IRC_S45R_E, relation = formalizes, coverage = exact, quote = "The term \"nonelective contribution\" means an employer contribution other than an employer contribution pursuant to a salary reduction arrangement.")
rule NonelectiveContributionRule(contribution: Asset) strict {
    when employer_contribution_45r(contribution);
    when not_known(contribution_under_salary_reduction_arrangement_45r(contribution));
    then nonelective_contribution_45r(contribution);
}
pub relation controlled_group_414_45r(group: Person, employer: Person) kind empirical {
    label en official "the employer is a member of a group treated as a single employer under subsection (b), (c), (m) or (o) of section 414 (section 45R(e)(5)(A)) — case-asserted";
}
pub relation treated_as_single_employer_45r(a: Person, b: Person) kind institutional {
    label en official "section 45R(e)(5)(A): all employers treated as a single employer under section 414(b), (c), (m) or (o) are one employer for this section";
}
@source(IRC_S45R_E, relation = formalizes, coverage = exact, quote = "All employers treated as a single employer under subsection (b), (c), (m), or (o) of section 414 shall be treated as a single employer for purposes of this section.")
rule TreatedAsSingleEmployerRule(a: Person, b: Person, group: Person) strict {
    when controlled_group_414_45r(group, a);
    when controlled_group_414_45r(group, b);
    then treated_as_single_employer_45r(a, b);
}

// --- (f): tax-exempt eligible small employer ---------------------------------------------------------------------------------------------------------------

pub relation organization_described_in_501c_and_exempt_under_501a_45r(employer: Person) kind empirical {
    label en official "the organization is described in section 501(c) and exempt from taxation under section 501(a) (section 45R(f)(2)) — case-asserted";
}
pub relation tax_exempt_eligible_small_employer_defined_45r(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45R(f)(2): an eligible small employer which is an organization described in section 501(c) and exempt from taxation under section 501(a)";
}
@source(IRC_S45R_F, relation = formalizes, coverage = exact, quote = "the term \"tax-exempt eligible small employer\" means an eligible small employer which is any organization described in section 501(c) which is exempt from taxation under section 501(a)")
rule TaxExemptEligibleSmallEmployerDefinedRule(employer: Person, y: TaxableYear) strict {
    when eligible_small_employer_45r(employer, y);
    when organization_described_in_501c_and_exempt_under_501a_45r(employer);
    then tax_exempt_eligible_small_employer_defined_45r(employer, y);
}
pub relation withholding_under_3401a_45r(employer: Person, calendar_year: Decimal, amount: Money) kind empirical {
    label en official "amounts required to be withheld from the employees under section 3401(a) (section 45R(f)(3)(A)(i)) — case-asserted";
}
pub relation withholding_under_3101b_45r(employer: Person, calendar_year: Decimal, amount: Money) kind empirical {
    label en official "amounts required to be withheld from the employees under section 3101(b) (section 45R(f)(3)(A)(ii)) — case-asserted";
}
pub relation employer_tax_under_3111b_45r(employer: Person, calendar_year: Decimal, amount: Money) kind empirical {
    label en official "the taxes imposed on the tax-exempt eligible small employer under section 3111(b) (section 45R(f)(3)(A)(iii)) — case-asserted";
}
pub relation payroll_taxes_45r(employer: Person, calendar_year: Decimal, amount: Money) kind institutional {
    label en official "section 45R(f)(3)(A): the amounts withheld under sections 3401(a) and 3101(b) plus the taxes imposed on the employer under section 3111(b)";
}
@source(IRC_S45R_F, relation = formalizes, coverage = exact, quote = "amounts of the taxes imposed on the tax-exempt eligible small employer under section 3111(b)")
rule PayrollTaxesRule(employer: Person, calendar_year: Decimal, a: Money, b: Money, c: Money) defeasible {
    when withholding_under_3401a_with_agreement_45r(employer, calendar_year, a);
    when withholding_under_3101b_45r(employer, calendar_year, b);
    when employer_tax_under_3111b_45r(employer, calendar_year, c);
    then payroll_taxes_45r(employer, calendar_year, a + b + c);
}
pub relation calendar_year_in_which_taxable_year_begins_45r(y: TaxableYear, calendar_year: Decimal) kind empirical {
    label en official "the calendar year in which the taxable year begins (section 45R(f)(1)(B)) — case-asserted";
}
pub relation credit_allowable_under_subpart_c_45r(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45R(f)(1): for a tax-exempt eligible small employer, the lesser of the credit determined and the payroll taxes of the calendar year in which the taxable year begins is treated as allowable under subpart C, not subpart A";
}
@source(IRC_S45R_F, relation = formalizes, coverage = exact, quote = "there shall be treated as a credit allowable under subpart C (and not allowable under this subpart) the lesser of")
rule CreditAllowableUnderSubpartCRule(employer: Person, y: TaxableYear, credit: Money, calendar_year: Decimal, payroll: Money) defeasible {
    when tax_exempt_eligible_small_employer_defined_45r(employer, y);
    when small_employer_health_insurance_credit(employer, y, credit);
    when calendar_year_in_which_taxable_year_begins_45r(y, calendar_year);
    when payroll_taxes_45r(employer, calendar_year, payroll);
    then credit_allowable_under_subpart_c_45r(employer, y, min(credit, payroll));
}

// --- (g): taxable years beginning in 2010 through 2013 -----------------------------------------------------------------------------------------------------

pub relation transition_nonelective_premium_contributions_45r(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the eligible small employer's nonelective contributions for premiums paid for health insurance coverage (within the meaning of section 9832(b)(1)) of employees (section 45R(g)(2)(B)) — case-asserted";
}
pub relation transition_average_premium_contributions_45r(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the contributions the employer would have made had each employee enrolled in coverage with the premium the Secretary of Health and Human Services determines is the average premium for the small group market in the State (section 45R(g)(2)(C)) — case-asserted";
}
pub relation transition_credit_before_phaseout_45r(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45R(g)(2): for taxable years beginning in 2010-2013 the (b) amount is 35 percent (25 percent for a tax-exempt eligible small employer) of the lesser of the premium contributions and the small group market average premium amount (cents HALF_UP)";
}
@source(IRC_S45R_G, relation = formalizes, coverage = exact, quote = "by substituting \"35 percent (25 percent in the case of a tax-exempt eligible small employer)\" for \"50 percent (35 percent in the case of a tax-exempt eligible small employer)\"")
rule TransitionCreditGeneralRule(employer: Person, y: TaxableYear, begin: Date, c1: Money, c2: Money) strict {
    when taxable_year_begin_45r(y, begin);
    when begin >= @2010-01-01;
    when begin <= @2013-12-31;
    when transition_nonelective_premium_contributions_45r(employer, y, c1);
    when transition_average_premium_contributions_45r(employer, y, c2);
    when not tax_exempt_eligible_small_employer(employer);
    then transition_credit_before_phaseout_45r(employer, y, round(0.35 * min(c1, c2), 2, "HALF_UP"));
}
rule TransitionCreditTaxExemptRule(employer: Person, y: TaxableYear, begin: Date, c1: Money, c2: Money) strict {
    when taxable_year_begin_45r(y, begin);
    when begin >= @2010-01-01;
    when begin <= @2013-12-31;
    when transition_nonelective_premium_contributions_45r(employer, y, c1);
    when transition_average_premium_contributions_45r(employer, y, c2);
    when tax_exempt_eligible_small_employer(employer);
    then transition_credit_before_phaseout_45r(employer, y, round(0.25 * min(c1, c2), 2, "HALF_UP"));
}
pub relation arrangement_meets_d4_other_than_exchange_offering_45r(employer: Person, y: TaxableYear) kind empirical {
    label en official "the arrangement meets the requirements of subsection (d)(4) other than the offering of insurance through an Exchange — case-asserted";
}
pub relation arrangement_offers_insurance_outside_exchange_45r(employer: Person, y: TaxableYear) kind empirical {
    label en official "the arrangement provides for the offering of insurance outside of an Exchange (section 45R(g)(3)) — case-asserted";
}
pub relation d4_requirement_met_for_transition_year_45r(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45R(g)(3): for taxable years beginning in 2010-2013 an arrangement does not fail the (d)(4) requirements solely because it offers insurance outside of an Exchange";
}
@source(IRC_S45R_G, relation = formalizes, coverage = exact, quote = "An arrangement shall not fail to meet the requirements of subsection (d)(4) solely because it provides for the offering of insurance outside of an Exchange.")
rule D4RequirementMetForTransitionYearRule(employer: Person, y: TaxableYear, begin: Date) strict {
    when taxable_year_begin_45r(y, begin);
    when begin >= @2010-01-01;
    when begin <= @2013-12-31;
    when arrangement_meets_d4_other_than_exchange_offering_45r(employer, y);
    when arrangement_offers_insurance_outside_exchange_45r(employer, y);
    then d4_requirement_met_for_transition_year_45r(employer, y);
}
