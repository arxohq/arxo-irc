// 26 U.S.C. Part IV of Subchapter A, Chapter 1 — Credits Against Tax: package skeleton. The text is pinned whole
// (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package credits` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
// Formalization modules are added stage by stage; see
// docs/foundations/us-irc/TASKS.json and DECISION-0379.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

import us.irc.core version "0.1.1";
import us.irc.income_individual version "0.1.1";
import us.irc.gross_income version "0.1.1";
import us.irc.corporations version "0.1.1";
import us.irc.inflation_adjustments version "0.1.1";
import us.irc.temporal version "0.1.1";
import us.irc.deferred_compensation version "0.1.1";
// WIRE-10 group A (26.09.2026): section 38(b)(20) reads the section 5011(a) lot credits of `us.irc.alcohol` (module 96-wire10-A-credits.law).
import us.irc.alcohol version "0.1.1";
// Section 32 (30.09.2026): section 32(c)(2)(A)(ii) reads net earnings from
// self-employment of `us.irc.other_income_taxes` (module 32-earned-income-credit.law).
import us.irc.other_income_taxes version "0.1.1";

// Type aliases declared ONCE for the whole package (LDC-E1201), following
// the `us.irc.gross_income`/`us.irc.income_individual` convention. Every
// module below (21-*.law, 22-*.law, …) uses these bare names.
type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type TaxableYear = us.irc.core::TaxableYear;
type Asset = us.irc.core::Asset;

// `us.irc.corporations` added stage 2b (§52): the section 1563(a) controlled
// group machinery it already publishes (module 08) is REUSED for section
// 52(a)'s own modified (>50%, not >=80%) controlled-group test rather than
// re-derived — see 52-controlled-groups-and-special-rules.law.

// `adjusted_gross_income`/`taxable_income`/`filing_status`/`FilingStatus`/
// `dependent_of`/`qualifying_child_of` etc. are NOT aliased: they are
// relations/enums of neighbour packages, always referenced fully qualified
// (`us.irc.gross_income::adjusted_gross_income`,
// `us.irc.income_individual::filing_status`, …) per the convention those
// packages' own modules use for each other.
