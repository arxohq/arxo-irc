// Section 42(h) — allocation timing (h)(1)(B)-(F), the allocation's reach (h)(2),
// the State ceiling machinery (h)(3)(B)-(G), tax-exempt-bond financed buildings
// (h)(4), the nonprofit set-aside definitions (h)(5)(B)-(E), the extended
// low-income housing commitment (h)(6)(B)-(K), the percentage limitation and
// the agency's specification (h)(7)(C)-(D), and the agency definitions (h)(8).
// Also the wiring of the section 42 limits into the credit read by section
// 38(b)(5) (`low_income_housing_credit`). Stage 2e (IRC-06, DECISION-0379,
// TECH_GAP reduction of TECH-GAPS G1822).
//
// Scope / judgment calls:
// * Calendar years of allocation are Decimal numbers, as in
//   `42b-housing-credit-period-ceiling-and-compliance.law`; the first day of a
//   calendar year is a case fact (`first_day_of_calendar_year_42`) so that
//   fiscal-year taxpayers are handled by date comparison, not by
//   `calendar_year_of` (which exists only for calendar taxable years).
// * (h)(3)(E)(i): the city's aggregate amount bears the ratio of the city
//   population to the State population; the total of the city populations is
//   taken once (one rounding) rather than as a sum of rounded city amounts.
// * (h)(3)(D)(iii): the Secretary's ratio allocation is exposed as a computed
//   amount from the aggregate unused carryover of all States and the population
//   of all qualified States (case facts); the actual Secretary allocation stays
//   the case fact of 42b.
// * "Within a reasonable period" ((h)(4)(A)(ii)) and "fair market value"
//   ((h)(6)(F)) are evaluative (DECISION-0194): case facts labelled as such.
// * (h)(6)(G)(ii): the C-CPI-U 5-percent cap under regulations is not modelled
//   (TECH-GAPS); the base-year cost-of-living adjustment is a case fact.
// * The section 42(h)(4)(A) exception is applied by proportion of the credit:
//   the credit attributable to bond-financed eligible basis is not limited by
//   the allocation; where 50 percent or more of the aggregate basis of the
//   building and land is bond-financed, the whole credit is not limited.

use self::{
    Asset,
    IRC_S42_H,
    Person,
    TaxableYear,
    agency_allocates_to_building_42,
    applicable_percentage_after_h_42,
    compliance_period_year_42,
    cost_of_living_factor_42,
    credit_allowed_by_commitment_42,
    credit_before_allocation_limit_42,
    credit_period_year_42,
    dollar_amount_multiplier_42,
    effective_housing_credit_dollar_amount_42,
    first_credit_year_begin_42,
    housing_credit_dollar_amount_allocated_42,
    low_income_housing_building_owned_by,
    qualified_basis_at_close_42,
    secretary_allocation_to_state_42,
    state_ceiling_returned_42,
    state_housing_credit_ceiling_42,
    state_population_42,
    unused_state_ceiling_prior_year_42,
};

pub relation first_day_of_calendar_year_42(year: Decimal, on: Date) kind empirical {
    label en official "the first day (January 1) of the calendar year — calendar helper fact for comparing taxable-year end dates with calendar years";
}
pub relation placed_in_service_calendar_year_42(building: Asset, year: Decimal) kind empirical {
    label en official "the calendar year in which the building is placed in service (section 42(h)(1)(B)) — case-asserted";
}

// --- (h)(1)(B)-(C): the time of the allocation ---------------------------------------------------------------------------------------------------

pub relation allocation_timing_met_42(building: Asset, agency: Person, year: Decimal) kind institutional {
    label en official "section 42(h)(1)(B)-(C), (E)-(F): the allocation made in the calendar year is taken into account under subparagraph (A) (made by the close of the placed-in-service year, a binding commitment by then, the 10 percent rule, or a project allocation)";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "an allocation shall be taken into account under subparagraph (A) only if it is made not later than the close of the calendar year in which the building is placed in service.")
rule AllocationTimingGeneralRule(building: Asset, agency: Person, year: Decimal, pis_year: Decimal) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, _);
    when placed_in_service_calendar_year_42(building, pis_year);
    when year <= pis_year;
    then allocation_timing_met_42(building, agency, year);
}
pub relation binding_commitment_by_close_of_placed_in_service_year_42(building: Asset, agency: Person) kind empirical {
    label en official "there is a binding commitment, not later than the close of the calendar year in which the building is placed in service, by the housing credit agency to allocate a specified housing credit dollar amount to the building beginning in a specified later taxable year (section 42(h)(1)(C)) — case-asserted";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "An allocation meets the requirements of this subparagraph if there is a binding commitment (not later than the close of the calendar year in which the building is placed in service) by the housing credit agency to allocate a specified housing credit dollar amount to such building beginning in a specified later taxable year.")
rule AllocationTimingBindingCommitmentRule(building: Asset, agency: Person, year: Decimal) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, _);
    when binding_commitment_by_close_of_placed_in_service_year_42(building, agency);
    then allocation_timing_met_42(building, agency, year);
}

// --- (h)(1)(D): an increase in qualified basis -------------------------------------------------------------------------------------------------------

pub relation first_applicable_taxable_year_end_calendar_year_42(building: Asset, agency: Person, year: Decimal) kind empirical {
    label en official "the calendar year in which ends the taxable year to which the allocation will 1st apply (section 42(h)(1)(D)(i)) — case-asserted";
}
pub relation qualified_basis_first_year_of_allocation_42(building: Asset, amount: Money) kind empirical {
    label en official "the qualified basis as of the close of the 1st taxable year to which the allocation will apply (section 42(h)(1)(D)(ii)(I)) — case-asserted";
}
pub relation qualified_basis_first_year_of_prior_allocation_42(building: Asset, amount: Money) kind empirical {
    label en official "the qualified basis as of the close of the 1st taxable year to which the most recent prior allocation applied (section 42(h)(1)(D)(ii)(II)) — case-asserted";
}
pub relation allocation_increase_limitation_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(h)(1)(D)(ii): the credit allowable (without regard to subsection (h)) for the excess of the qualified basis at the close of the first year of the allocation over that of the most recent prior allocation";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The limitation under this clause is the amount of credit allowable under this section (without regard to this subsection) for a taxable year with respect to an increase in the qualified basis of the building equal to the excess of—")
rule AllocationIncreaseLimitation42Rule(building: Asset, y: TaxableYear, pct: Decimal, current: Money, prior: Money) strict {
    when applicable_percentage_after_h_42(building, y, pct);
    when qualified_basis_first_year_of_allocation_42(building, current);
    when qualified_basis_first_year_of_prior_allocation_42(building, prior);
    when current > prior;
    then allocation_increase_limitation_42(building, y, round(pct * (current - prior), 2, "HALF_UP"));
}
pub relation allocation_counted_for_credit_42(building: Asset, agency: Person, year: Decimal, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of an allocation taken into account under section 42(h)(1)(A) for the year: an allocation under the (D) exception is taken into account only to the extent of the (D)(ii) limitation";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "An allocation meets the requirements of this subparagraph if such allocation is made not later than the close of the calendar year in which ends the taxable year to which it will 1st apply but only to the extent the amount of such allocation does not exceed the limitation under clause (ii).")
rule AllocationCountedIncreaseExceptionRule(building: Asset, agency: Person, year: Decimal, y: TaxableYear, allocated: Money, limit: Money, end_year: Decimal) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    when first_applicable_taxable_year_end_calendar_year_42(building, agency, end_year);
    when year <= end_year;
    when allocation_increase_limitation_42(building, y, limit);
    then allocation_counted_for_credit_42(building, agency, year, y, min(allocated, limit));
}
rule AllocationCountedTimingMetRule(building: Asset, agency: Person, year: Decimal, y: TaxableYear, allocated: Money) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    when allocation_timing_met_42(building, agency, year);
    when credit_period_year_42(building, y);
    then allocation_counted_for_credit_42(building, agency, year, y, allocated);
}
pub relation allocation_full_amount_reduces_agency_amount_42(building: Asset, agency: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(1)(D)(iii): the full amount of the allocation is taken into account under paragraph (2) (reduction of the agency's aggregate amount), notwithstanding clause (i)";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "Notwithstanding clause (i), the full amount of the allocation shall be taken into account under paragraph (2).")
rule AllocationFullAmountReducesAgencyRule(building: Asset, agency: Person, year: Decimal, allocated: Money) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    when first_applicable_taxable_year_end_calendar_year_42(building, agency, _);
    then allocation_full_amount_reduces_agency_amount_42(building, agency, year, allocated);
}

// --- (h)(1)(E): the 10 percent test -----------------------------------------------------------------------------------------------------------------

pub relation placed_in_service_year_after_allocation_42(building: Asset, agency: Person, year: Decimal, delta: Decimal) kind empirical {
    label en official "the number of calendar years between the allocation year and the calendar year the building is placed in service — case-asserted (section 42(h)(1)(E)(i) requires at most 2)";
}
pub relation taxpayer_basis_in_project_one_year_after_allocation_42(building: Asset, amount: Money) kind empirical {
    label en official "the taxpayer's basis in the project as of the date 1 year after the allocation was made (section 42(h)(1)(E)(ii)) — case-asserted";
}
pub relation reasonably_expected_basis_in_project_42(building: Asset, amount: Money) kind empirical {
    label en official "the taxpayer's reasonably expected basis in the project as of the close of the second calendar year following the allocation year (section 42(h)(1)(E)(ii)) — case-asserted expectation";
}
pub relation original_use_begins_with_taxpayer_42(building: Asset, taxpayer: Person) kind empirical {
    label en official "the original use of the building begins with the taxpayer (section 42(i)(4)) — case-asserted";
}
pub relation rehab_credit_allowable_for_e_ii_period_42(building: Asset) kind empirical {
    label en official "a credit is allowable under subsection (e) for rehabilitation expenditures paid or incurred with respect to the building for a taxable year ending during the second calendar year following the allocation or the prior taxable year (section 42(h)(1)(E)(ii), last sentence) — case-asserted";
}
pub relation qualified_building_h1e_42(building: Asset) kind institutional {
    label en official "section 42(h)(1)(E)(ii): a building that is part of a project in which the taxpayer's basis one year after the allocation exceeds 10 percent of the reasonably expected basis; an existing building only with a rehabilitation credit";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "the taxpayer's basis in such project (as of the date which is 1 year after the date that the allocation was made) is more than 10 percent of the taxpayer's reasonably expected basis in such project")
rule QualifiedBuildingH1eNewRule(building: Asset, taxpayer: Person, basis: Money, expected: Money) strict {
    when low_income_housing_building_owned_by(building, taxpayer);
    when original_use_begins_with_taxpayer_42(building, taxpayer);
    when taxpayer_basis_in_project_one_year_after_allocation_42(building, basis);
    when reasonably_expected_basis_in_project_42(building, expected);
    when basis > 0.10 * expected;
    then qualified_building_h1e_42(building);
}
rule QualifiedBuildingH1eExistingWithRehabRule(building: Asset, taxpayer: Person, basis: Money, expected: Money) strict {
    when low_income_housing_building_owned_by(building, taxpayer);
    when not_known(original_use_begins_with_taxpayer_42(building, taxpayer));
    when rehab_credit_allowable_for_e_ii_period_42(building);
    when taxpayer_basis_in_project_one_year_after_allocation_42(building, basis);
    when reasonably_expected_basis_in_project_42(building, expected);
    when basis > 0.10 * expected;
    then qualified_building_h1e_42(building);
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "An allocation meets the requirements of this subparagraph if such allocation is made with respect to a qualified building which is placed in service not later than the close of the second calendar year following the calendar year in which the allocation is made.")
rule AllocationTimingTenPercentRule(building: Asset, agency: Person, year: Decimal, delta: Decimal) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, _);
    when qualified_building_h1e_42(building);
    when placed_in_service_year_after_allocation_42(building, agency, year, delta);
    when delta <= 2.0;
    then allocation_timing_met_42(building, agency, year);
}

// --- (h)(1)(F): the project basis ------------------------------------------------------------------------------------------------------------------------

pub relation allocation_made_to_project_in_project_period_42(building: Asset, agency: Person, year: Decimal) kind empirical {
    label en official "the allocation is made to a project of more than 1 building for a calendar year during the project period (section 42(h)(1)(F)(i)(I)); the project period runs from the 1st calendar year an allocation may be made for the 1st building placed in service to the calendar year the last building is placed in service (clause (ii)) — case-asserted";
}
pub relation project_allocation_applies_only_to_later_buildings_42(building: Asset, agency: Person, year: Decimal) kind empirical {
    label en official "the allocation only applies to buildings placed in service during or after the calendar year for which it is made (section 42(h)(1)(F)(i)(II)) — case-asserted";
}
pub relation building_portion_specified_by_close_of_placed_in_service_year_42(building: Asset, agency: Person, year: Decimal) kind empirical {
    label en official "the portion of the allocation allocated to the building is specified not later than the close of the calendar year in which the building is placed in service (section 42(h)(1)(F)(i)(III)) — case-asserted";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "In the case of a project which includes (or will include) more than 1 building, an allocation meets the requirements of this subparagraph if—")
rule AllocationTimingProjectBasisRule(building: Asset, agency: Person, year: Decimal) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, _);
    when allocation_made_to_project_in_project_period_42(building, agency, year);
    when project_allocation_applies_only_to_later_buildings_42(building, agency, year);
    when building_portion_specified_by_close_of_placed_in_service_year_42(building, agency, year);
    then allocation_timing_met_42(building, agency, year);
}

// --- (h)(2): the reach of an allocation ------------------------------------------------------------------------------------------------------------------

pub relation allocation_applies_to_taxable_year_42(building: Asset, agency: Person, year: Decimal, y: TaxableYear) kind institutional {
    label en official "section 42(h)(2)(A): an allocation for a calendar year applies to the building for all taxable years in the compliance period ending during or after that calendar year";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "shall apply to such building for all taxable years in the compliance period ending during or after such calendar year, and")
rule AllocationAppliesToTaxableYearRule(building: Asset, agency: Person, year: Decimal, y: TaxableYear, first_day: Date, finish: Date) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, _);
    when compliance_period_year_42(building, y);
    when first_day_of_calendar_year_42(year, first_day);
    when us.irc.core::ends(y, finish);
    when finish >= first_day;
    then allocation_applies_to_taxable_year_42(building, agency, year, y);
}
pub relation agency_aggregate_amount_reduced_42(agency: Person, year: Decimal, building: Asset, amount: Money) kind institutional {
    label en official "section 42(h)(2)(B): an allocation reduces the aggregate housing credit dollar amount of the allocating agency only for the calendar year of the allocation";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "shall reduce the aggregate housing credit dollar amount of the allocating agency only for such calendar year.")
rule AgencyAggregateAmountReducedRule(building: Asset, agency: Person, year: Decimal, allocated: Money) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    then agency_aggregate_amount_reduced_42(agency, year, building, allocated);
}

// --- (h)(3)(B), (E), (F), (G): the ceiling allocated to agencies -------------------------------------------------------------------

pub relation housing_credit_agency_of_state_42(agency: Person, state: Person) kind empirical {
    label en official "the agency is a housing credit agency of the State (section 42(h)(3)(B), (h)(8)(A)) — case-asserted";
}
pub relation is_constitutional_home_rule_city_42(city: Person) kind empirical {
    label en official "the governmental unit is a constitutional home rule city as defined in section 146(d)(3)(C) (section 42(h)(3)(E)(iii)) — case-asserted (external classification of section 146)";
}
pub relation city_population_42(city: Person, state: Person, year: Decimal, population: Decimal) kind empirical {
    label en official "the population of the constitutional home rule city determined in accordance with section 146(j) (section 42(h)(3)(E)(i)(I), (G)) — case-asserted";
}
pub relation home_rule_cities_total_population_42(state: Person, year: Decimal, population: Decimal) kind empirical {
    label en official "the total population of all constitutional home rule cities in the State, section 146(j) — case-asserted (used for the single-rounding total of section 42(h)(3)(E)(ii))";
}
pub relation home_rule_city_aggregate_amount_42(city: Person, state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(E)(i): the aggregate housing credit dollar amount of a constitutional home rule city bears to the State ceiling the ratio of the city population to the State population";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The aggregate housing credit dollar amount for any constitutional home rule city for any calendar year shall be an amount which bears the same ratio to the State housing credit ceiling for such calendar year as—")
rule HomeRuleCityAggregateAmountRule(city: Person, state: Person, year: Decimal, ceiling: Money, city_pop: Decimal, state_pop: Decimal) defeasible {
    when is_constitutional_home_rule_city_42(city);
    when city_population_42(city, state, year, city_pop);
    when state_population_42(state, year, state_pop);
    when state_housing_credit_ceiling_42(state, year, ceiling);
    when state_pop > 0.0;
    // JUDGMENT CALL: cents, HALF_UP.
    then home_rule_city_aggregate_amount_42(city, state, year, div_round(ceiling * city_pop, state_pop, 2, "HALF_UP"));
}
pub relation state_ceiling_for_other_agencies_42(state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(E)(ii): for agencies other than constitutional home rule cities the State ceiling is reduced by the aggregate amounts of all constitutional home rule cities of the State";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "In the case of any State which contains 1 or more constitutional home rule cities, for purposes of applying this paragraph with respect to housing credit agencies in such State other than constitutional home rule cities, the State housing credit ceiling for any calendar year shall be reduced by the aggregate housing credit dollar amounts determined for such year for all constitutional home rule cities in such State.")
rule StateCeilingForOtherAgenciesWithCitiesRule(state: Person, year: Decimal, ceiling: Money, state_pop: Decimal, city_pop: Decimal) defeasible {
    when state_housing_credit_ceiling_42(state, year, ceiling);
    when state_population_42(state, year, state_pop);
    when home_rule_cities_total_population_42(state, year, city_pop);
    when state_pop > 0.0;
    then state_ceiling_for_other_agencies_42(state, year, ceiling - div_round(ceiling * city_pop, state_pop, 2, "HALF_UP"));
}
relation state_has_home_rule_cities_42(state: Person, year: Decimal) kind institutional;
rule StateHasHomeRuleCitiesRule(state: Person, year: Decimal, population: Decimal) strict {
    when home_rule_cities_total_population_42(state, year, population);
    then state_has_home_rule_cities_42(state, year);
}
rule StateCeilingForOtherAgenciesNoCitiesRule(state: Person, year: Decimal, ceiling: Money) defeasible {
    when state_housing_credit_ceiling_42(state, year, ceiling);
    when not_known(state_has_home_rule_cities_42(state, year));
    then state_ceiling_for_other_agencies_42(state, year, ceiling);
}
pub relation agency_aggregate_housing_credit_dollar_amount_42(agency: Person, state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(A)-(B): the aggregate housing credit dollar amount an agency may allocate for the calendar year is the portion of the State ceiling allocated to it; the ceiling goes to the State's housing credit agency, several agencies of a State being treated as a single agency";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraphs (D) and (E), the State housing credit ceiling for each calendar year shall be allocated to the housing credit agency of such State. If there is more than 1 housing credit agency of a State, all such agencies shall be treated as a single agency.")
rule AgencyAggregateAmountStateAgencyRule(agency: Person, state: Person, year: Decimal, amount: Money) defeasible {
    when housing_credit_agency_of_state_42(agency, state);
    when not_known(is_constitutional_home_rule_city_42(agency));
    when state_ceiling_for_other_agencies_42(state, year, amount);
    then agency_aggregate_housing_credit_dollar_amount_42(agency, state, year, amount);
}
rule AgencyAggregateAmountHomeRuleCityRule(agency: Person, state: Person, year: Decimal, amount: Money) defeasible {
    when is_constitutional_home_rule_city_42(agency);
    when home_rule_city_aggregate_amount_42(agency, state, year, amount);
    then agency_aggregate_housing_credit_dollar_amount_42(agency, state, year, amount);
}

// --- (h)(3)(C)-(D): unused ceiling, carryover, the Secretary's ratio allocation, qualified States ------------------------------------

pub relation aggregate_allocated_in_year_42(state: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the aggregate housing credit dollar amount allocated within the State for the calendar year — case-asserted";
}
pub relation state_ceiling_returned_projects_42(state: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the housing credit dollar amounts previously allocated within the State to projects that fail the 10 percent test after the close of the allocation year, do not become qualified low-income housing projects within the required period or the allocation terms, or whose allocation is cancelled by mutual consent (section 42(h)(3)(C), last paragraph, clause (iii)) — case-asserted total";
}
pub relation state_ceiling_returned_matches_projects_42(state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(C)(iii): the amount of State ceiling returned in the calendar year equals the allocations to the failing, non-qualifying or cancelled projects";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "the amount of State housing credit ceiling returned in the calendar year equals the housing credit dollar amount previously allocated within the State to any project which fails to meet the 10 percent test under paragraph (1)(E)(ii) on a date after the close of the calendar year in which the allocation was made")
rule StateCeilingReturnedMatchesProjectsRule(state: Person, year: Decimal, amount: Money) strict {
    when state_ceiling_returned_projects_42(state, year, amount);
    then state_ceiling_returned_matches_projects_42(state, year, amount);
}
pub relation unused_state_housing_credit_ceiling_42(state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(C), last paragraph: the excess (if any) of the sum of clauses (ii) through (iv) over the aggregate amount allocated for the year";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "the unused State housing credit ceiling for any calendar year is the excess (if any) of the sum of the amounts described in clauses (ii) through (iv) over the aggregate housing credit dollar amount allocated for such year")
rule UnusedStateCeilingRule(state: Person, year: Decimal, pop: Decimal, cola: Decimal, multiplier: Decimal, returned: Money, secretary: Money, allocated: Money) strict {
    when state_population_42(state, year, pop);
    when cost_of_living_factor_42(year, cola);
    when dollar_amount_multiplier_42(year, multiplier);
    when state_ceiling_returned_42(state, year, returned);
    when secretary_allocation_to_state_42(state, year, secretary);
    when aggregate_allocated_in_year_42(state, year, allocated);
    when max(round(div_round(round(1.75 * cola * 20.0, 0, "FLOOR"), 20.0, 10, "HALF_UP") * multiplier * pop, 2, "HALF_UP") * 1 USD,
             round(round(2000000.0 * cola / 5000.0, 0, "FLOOR") * 5000.0 * multiplier, 2, "HALF_UP") * 1 USD) + returned + secretary > allocated;
    then unused_state_housing_credit_ceiling_42(state, year,
        max(round(div_round(round(1.75 * cola * 20.0, 0, "FLOOR"), 20.0, 10, "HALF_UP") * multiplier * pop, 2, "HALF_UP") * 1 USD,
            round(round(2000000.0 * cola / 5000.0, 0, "FLOOR") * 5000.0 * multiplier, 2, "HALF_UP") * 1 USD) + returned + secretary - allocated);
}
pub relation unused_housing_credit_carryover_42(state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(D)(ii): the excess (if any) of the unused State ceiling for the preceding year over the aggregate amount allocated for the year; assigned to the Secretary (clause (i))";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The unused housing credit carryover of a State for any calendar year shall be assigned to the Secretary for allocation among qualified States for the succeeding calendar year.")
rule UnusedHousingCreditCarryoverRule(state: Person, year: Decimal, unused_prior: Money, allocated: Money) strict {
    when unused_state_ceiling_prior_year_42(state, year, unused_prior);
    when aggregate_allocated_in_year_42(state, year, allocated);
    when unused_prior > allocated;
    then unused_housing_credit_carryover_42(state, year, unused_prior - allocated);
}
pub relation state_allocated_entire_ceiling_prior_year_42(state: Person, year: Decimal) kind institutional {
    label en official "section 42(h)(3)(D)(iv)(I): the State allocated its entire State housing credit ceiling for the preceding calendar year";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "(I) which allocated its entire State housing credit ceiling for the preceding calendar year, and")
rule StateAllocatedEntireCeilingRule(state: Person, preceding: Decimal, ceiling: Money, allocated: Money) defeasible {
    when state_housing_credit_ceiling_42(state, preceding, ceiling);
    when aggregate_allocated_in_year_42(state, preceding, allocated);
    when allocated >= ceiling;
    then state_allocated_entire_ceiling_prior_year_42(state, preceding + 1.0);
}
pub relation request_for_secretary_allocation_made_on_42(state: Person, year: Decimal, month: Decimal, day: Decimal) kind empirical {
    label en official "the State requests an allocation under section 42(h)(3)(D)(iii) on this month and day of the calendar year — case-asserted";
}
pub relation request_made_by_may_first_42(state: Person, year: Decimal) kind institutional {
    label en official "section 42(h)(3)(D)(iv)(II): the request is made not later than May 1 of the calendar year";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "(II) for which a request is made (not later than May 1 of the calendar year) to receive an allocation under clause (iii).")
rule RequestMadeByMayFirstEarlierMonthRule(state: Person, year: Decimal, month: Decimal, day: Decimal) strict {
    when request_for_secretary_allocation_made_on_42(state, year, month, day);
    when month < 5.0;
    then request_made_by_may_first_42(state, year);
}
rule RequestMadeByMayFirstDayRule(state: Person, year: Decimal, month: Decimal, day: Decimal) strict {
    when request_for_secretary_allocation_made_on_42(state, year, month, day);
    when month == 5.0;
    when day <= 1.0;
    then request_made_by_may_first_42(state, year);
}
pub relation qualified_state_42(state: Person, year: Decimal) kind institutional {
    label en official "section 42(h)(3)(D)(iv): a State that allocated its entire ceiling for the preceding year and requested an allocation not later than May 1";
}
rule QualifiedState42Rule(state: Person, year: Decimal) defeasible {
    when state_allocated_entire_ceiling_prior_year_42(state, year);
    when request_made_by_may_first_42(state, year);
    then qualified_state_42(state, year);
}
pub relation aggregate_unused_carryovers_all_states_42(year: Decimal, amount: Money) kind empirical {
    label en official "the aggregate unused housing credit carryovers of all States for the preceding calendar year (section 42(h)(3)(D)(iii)) — case-asserted";
}
pub relation population_of_all_qualified_states_42(year: Decimal, population: Decimal) kind empirical {
    label en official "the population of all qualified States for the calendar year, section 146(j) (section 42(h)(3)(D)(iii)) — case-asserted";
}
pub relation secretary_ratio_allocation_amount_42(state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(D)(iii): the amount allocated to a qualified State bears to the aggregate unused carryovers of all States the ratio of the State's population to the population of all qualified States";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The amount allocated under this subparagraph to a qualified State for any calendar year shall be the amount determined by the Secretary to bear the same ratio to the aggregate unused housing credit carryovers of all States for the preceding calendar year as such State's population for the calendar year bears to the population of all qualified States for the calendar year.")
rule SecretaryRatioAllocationAmountRule(state: Person, year: Decimal, carryovers: Money, state_pop: Decimal, qualified_pop: Decimal) defeasible {
    when qualified_state_42(state, year);
    when aggregate_unused_carryovers_all_states_42(year, carryovers);
    when state_population_42(state, year, state_pop);
    when population_of_all_qualified_states_42(year, qualified_pop);
    when qualified_pop > 0.0;
    // JUDGMENT CALL: cents, HALF_UP (the Secretary determines the amount; this is the ratio it must bear).
    then secretary_ratio_allocation_amount_42(state, year, div_round(carryovers * state_pop, qualified_pop, 2, "HALF_UP"));
}

// --- (h)(4): buildings financed by tax-exempt bonds subject to the volume cap ----------------------------------------------------------

pub relation eligible_basis_of_building_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the eligible basis of the building for the taxable year (section 42(d)) — case-asserted";
}
pub relation bond_financed_eligible_basis_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the eligible basis financed by obligations the interest on which is exempt from tax under section 103 (section 42(h)(4)(A)) — case-asserted";
}
pub relation aggregate_basis_of_building_and_land_42(building: Asset, amount: Money) kind empirical {
    label en official "the aggregate basis of the building and the land on which it is located (section 42(h)(4)(B)) — case-asserted";
}
pub relation basis_of_building_and_land_financed_by_bonds_42(building: Asset, amount: Money) kind empirical {
    label en official "the part of the aggregate basis of the building and land financed by an obligation described in section 42(h)(4)(A) (section 42(h)(4)(B)) — case-asserted";
}
pub relation bond_taken_into_account_under_146_42(building: Asset) kind empirical {
    label en official "the obligation is taken into account under section 146 (section 42(h)(4)(A)(i)) — case-asserted";
}
pub relation bond_principal_applied_within_reasonable_period_to_redeem_42(building: Asset) kind empirical {
    label en official "principal payments on the financing are applied within a reasonable period to redeem obligations the proceeds of which were used for the financing (section 42(h)(4)(A)(ii)) — an evaluative time (DECISION-0194), case-asserted";
}
pub relation bond_financing_refunded_under_146_i_6_42(building: Asset) kind empirical {
    label en official "the financing is refunded as described in section 146(i)(6) (section 42(h)(4)(A)(ii)) — case-asserted";
}
pub relation issuer_determination_similar_to_m2_ab_made_42(building: Asset) kind empirical {
    label en official "the governmental unit which issued the bonds (or on behalf of which they were issued) makes a determination under rules similar to section 42(m)(2)(A) and (B) (section 42(m)(2)(D)) — case-asserted";
}
pub relation project_satisfies_allocation_plan_requirements_42(building: Asset) kind empirical {
    label en official "the project satisfies the requirements for allocation of a housing credit dollar amount under the qualified allocation plan applicable to the area (section 42(m)(1)(D)) — case-asserted (the plan content is evaluative)";
}
pub relation bond_financing_qualifies_for_h4_42(building: Asset) kind institutional {
    label en official "section 42(h)(4)(A): the obligation is taken into account under section 146 and its principal is applied to redeem, or the financing is refunded; with the section 42(m)(1)(D) and (m)(2)(D) conditions";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "(i) such obligation is taken into account under section 146, and")
rule BondFinancingQualifiesRedemptionRule(building: Asset) strict {
    when bond_taken_into_account_under_146_42(building);
    when bond_principal_applied_within_reasonable_period_to_redeem_42(building);
    when project_satisfies_allocation_plan_requirements_42(building);
    when issuer_determination_similar_to_m2_ab_made_42(building);
    then bond_financing_qualifies_for_h4_42(building);
}
rule BondFinancingQualifiesRefundedRule(building: Asset) strict {
    when bond_taken_into_account_under_146_42(building);
    when bond_financing_refunded_under_146_i_6_42(building);
    when project_satisfies_allocation_plan_requirements_42(building);
    when issuer_determination_similar_to_m2_ab_made_42(building);
    then bond_financing_qualifies_for_h4_42(building);
}
pub relation h1_limit_disapplied_entire_credit_42(building: Asset) kind institutional {
    label en official "section 42(h)(4)(B): 50 percent or more of the aggregate basis of the building and land is financed by qualifying obligations, so paragraph (1) does not apply to any portion of the credit";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "if 50 percent or more of the aggregate basis of any building and the land on which the building is located is financed by any obligation described in subparagraph (A), paragraph (1) shall not apply to any portion of the credit allowable under subsection (a) with respect to such building.")
rule H1LimitDisappliedEntireCreditRule(building: Asset, financed: Money, aggregate: Money) strict {
    when bond_financing_qualifies_for_h4_42(building);
    when basis_of_building_and_land_financed_by_bonds_42(building, financed);
    when aggregate_basis_of_building_and_land_42(building, aggregate);
    when financed >= 0.50 * aggregate;
    then h1_limit_disapplied_entire_credit_42(building);
}
pub relation bond_financed_credit_portion_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(h)(4)(A): the portion of the credit attributable to eligible basis financed by qualifying tax-exempt obligations, to which paragraph (1) does not apply";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "Paragraph (1) shall not apply to the portion of any credit allowable under subsection (a) which is attributable to eligible basis financed by any obligation the interest on which is exempt from tax under section 103 if—")
rule BondFinancedCreditPortionRule(building: Asset, y: TaxableYear, credit: Money, bonds: Money, eligible: Money) defeasible {
    when credit_before_allocation_limit_42(building, y, credit);
    when bond_financing_qualifies_for_h4_42(building);
    when bond_financed_eligible_basis_42(building, y, bonds);
    when eligible_basis_of_building_42(building, y, eligible);
    when eligible > 0 USD;
    // JUDGMENT CALL: the portion "attributable to" bond-financed basis is the pro-rata share, cents HALF_UP.
    then bond_financed_credit_portion_42(building, y, div_round(credit * (bonds / 1.00 USD), eligible / 1.00 USD, 2, "HALF_UP"));
}

// --- (h)(5)(B)-(E): the nonprofit set-aside ------------------------------------------------------------------------------------------------------------

pub relation nonprofit_described_in_501c3_or_c4_and_exempt_42(org: Person) kind empirical {
    label en official "the organization is described in section 501(c)(3) or (4) and is exempt from tax under section 501(a) (section 42(h)(5)(C)(i)) — case-asserted";
}
pub relation state_agency_determined_not_controlled_by_for_profit_42(org: Person) kind empirical {
    label en official "the State housing credit agency determines the organization is not affiliated with or controlled by a for-profit organization (section 42(h)(5)(C)(ii)) — case-asserted determination of the agency";
}
pub relation exempt_purposes_include_fostering_low_income_housing_42(org: Person) kind empirical {
    label en official "one of the organization's exempt purposes includes the fostering of low-income housing (section 42(h)(5)(C)(iii)) — case-asserted";
}
pub relation qualified_nonprofit_organization_42(org: Person) kind institutional {
    label en official "section 42(h)(5)(C): a qualified nonprofit organization";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"qualified nonprofit organization\" means any organization if—")
rule QualifiedNonprofitOrganization42Rule(org: Person) strict {
    when nonprofit_described_in_501c3_or_c4_and_exempt_42(org);
    when state_agency_determined_not_controlled_by_for_profit_42(org);
    when exempt_purposes_include_fostering_low_income_housing_42(org);
    then qualified_nonprofit_organization_42(org);
}
pub relation nonprofit_owns_interest_and_materially_participates_42(org: Person, project: Asset) kind empirical {
    label en official "the qualified nonprofit organization owns an interest in the project (directly or through a partnership) and materially participates (section 469(h)) in its development and operation throughout the compliance period (section 42(h)(5)(B)) — case-asserted";
}
pub relation corporation_stock_held_by_qualified_nonprofits_42(corp: Person, org: Person) kind empirical {
    label en official "the qualified nonprofit organization holds stock of the corporation; 100 percent of the stock is held by qualified nonprofit organizations at all times the corporation exists (section 42(h)(5)(D)(ii)) — case-asserted";
}
pub relation corporation_all_stock_held_by_nonprofits_at_all_times_42(corp: Person) kind empirical {
    label en official "100 percent of the stock of the corporation is held by 1 or more qualified nonprofit organizations at all times during its existence (section 42(h)(5)(D)(ii)) — case-asserted";
}
pub relation qualified_corporation_42(corp: Person) kind institutional {
    label en official "section 42(h)(5)(D)(ii): a corporation all of whose stock is held by qualified nonprofit organizations at all times";
}
rule QualifiedCorporation42Rule(corp: Person, org: Person) strict {
    when corporation_all_stock_held_by_nonprofits_at_all_times_42(corp);
    when corporation_stock_held_by_qualified_nonprofits_42(corp, org);
    when qualified_nonprofit_organization_42(org);
    then qualified_corporation_42(corp);
}
pub relation nonprofit_project_test_satisfied_42(org: Person, project: Asset) kind institutional {
    label en official "section 42(h)(5)(B), (D)(i): the ownership and material participation test is satisfied by the nonprofit itself or by a qualified corporation in which it holds stock";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), a qualified low-income housing project is described in this subparagraph if a qualified nonprofit organization is to own an interest in the project (directly or through a partnership) and materially participate (within the meaning of section 469(h)) in the development and operation of the project throughout the compliance period.")
rule NonprofitProjectTestDirectRule(org: Person, project: Asset) strict {
    when qualified_nonprofit_organization_42(org);
    when nonprofit_owns_interest_and_materially_participates_42(org, project);
    then nonprofit_project_test_satisfied_42(org, project);
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "a qualified nonprofit organization shall be treated as satisfying the ownership and material participation test of subparagraph (B) if any qualified corporation in which such organization holds stock satisfies such test.")
rule NonprofitProjectTestThroughCorporationRule(org: Person, project: Asset, corp: Person) strict {
    when qualified_nonprofit_organization_42(org);
    when corporation_stock_held_by_qualified_nonprofits_42(corp, org);
    when qualified_corporation_42(corp);
    when nonprofit_owns_interest_and_materially_participates_42(corp, project);
    then nonprofit_project_test_satisfied_42(org, project);
}
// (h)(5)(E): "Nothing in subparagraph (F) of paragraph (3) shall be construed to permit a State not to comply with
// subparagraph (A)": a rule of construction that keeps `Section42H5NonprofitSetAsideProhibition` in force whatever a
// State provides under section 146(e) rules; no separate rule is stated (coverage: NON_NORMATIVE).

// --- (h)(6)(B)-(K): the extended low-income housing commitment -------------------------------------------------------------------------

pub relation agreement_requires_applicable_fraction_and_bars_e_ii_actions_42(building: Asset) kind empirical {
    label en official "the agreement requires that the applicable fraction for each taxable year in the extended use period will not be less than the specified fraction and prohibits the actions in subparagraph (E)(ii)(I) and (II) (section 42(h)(6)(B)(i)) — case-asserted";
}
pub relation agreement_grants_state_court_enforcement_right_42(building: Asset) kind empirical {
    label en official "the agreement gives individuals who meet the income limitation (prospective, present or former occupants) the right to enforce the requirement and prohibitions in any State court (section 42(h)(6)(B)(ii)) — case-asserted";
}
pub relation agreement_prohibits_partial_disposition_42(building: Asset) kind empirical {
    label en official "the agreement prohibits disposition of any portion of the building unless all of it is disposed of to the same person (section 42(h)(6)(B)(iii)) — case-asserted";
}
pub relation agreement_prohibits_refusal_to_lease_to_section_8_holders_42(building: Asset) kind empirical {
    label en official "the agreement prohibits refusal to lease to a holder of a voucher or certificate of eligibility under section 8 of the United States Housing Act of 1937 because of that status (section 42(h)(6)(B)(iv)) — case-asserted";
}
pub relation agreement_binds_successors_42(building: Asset) kind empirical {
    label en official "the agreement is binding on all successors of the taxpayer (section 42(h)(6)(B)(v)) — case-asserted";
}
pub relation agreement_recorded_as_restrictive_covenant_42(building: Asset) kind empirical {
    label en official "the agreement is recorded pursuant to State law as a restrictive covenant with respect to the property (section 42(h)(6)(B)(vi)) — case-asserted";
}
pub relation extended_low_income_housing_commitment_terms_met_42(building: Asset) kind institutional {
    label en official "section 42(h)(6)(B): an agreement between the taxpayer and the housing credit agency with the six required terms";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"extended low-income housing commitment\" means any agreement between the taxpayer and the housing credit agency—")
rule ExtendedCommitmentTermsMetRule(building: Asset) strict {
    when agreement_requires_applicable_fraction_and_bars_e_ii_actions_42(building);
    when agreement_grants_state_court_enforcement_right_42(building);
    when agreement_prohibits_partial_disposition_42(building);
    when agreement_prohibits_refusal_to_lease_to_section_8_holders_42(building);
    when agreement_binds_successors_42(building);
    when agreement_recorded_as_restrictive_covenant_42(building);
    then extended_low_income_housing_commitment_terms_met_42(building);
}
pub relation commitment_agreement_in_effect_at_year_end_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "the agreement is in effect as of the end of the taxable year — case-asserted";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "No credit shall be allowed by reason of this section with respect to any building for the taxable year unless an extended low-income housing commitment is in effect as of the end of such taxable year.")
rule CreditAllowedByCommitmentTermsRule(building: Asset, y: TaxableYear) strict {
    when credit_period_year_42(building, y);
    when extended_low_income_housing_commitment_terms_met_42(building);
    when commitment_agreement_in_effect_at_year_end_42(building, y);
    then credit_allowed_by_commitment_42(building, y);
}
pub relation commitment_applicable_fraction_42(building: Asset, fraction: Decimal) kind empirical {
    label en official "the applicable fraction specified in the extended low-income housing commitment for the building (section 42(h)(6)(C), (H)) — case-asserted";
}
pub relation credit_supported_by_commitment_fraction_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(h)(6)(C): the credit necessary to support the applicable fraction specified in the commitment (the applicable percentage times the eligible basis times that fraction)";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "The housing credit dollar amount allocated to any building may not exceed the amount necessary to support the applicable fraction specified in the extended low-income housing commitment for such building")
rule CreditSupportedByCommitmentFractionRule(building: Asset, y: TaxableYear, pct: Decimal, eligible: Money, fraction: Decimal) strict {
    when applicable_percentage_after_h_42(building, y, pct);
    when eligible_basis_of_building_42(building, y, eligible);
    when commitment_applicable_fraction_42(building, fraction);
    then credit_supported_by_commitment_fraction_42(building, y, round(pct * fraction * eligible, 2, "HALF_UP"));
}
pub relation agency_allocates_above_commitment_support_42(agency: Person, building: Asset) kind institutional {
    label en official "section 42(h)(6)(C)(i): the housing credit dollar amount allocated exceeds the amount necessary to support the applicable fraction specified in the commitment";
}
rule AgencyAllocatesAboveCommitmentSupportRule(agency: Person, building: Asset, year: Decimal, allocated: Money, y: TaxableYear, needed: Money) strict {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    when credit_period_year_42(building, y);
    when credit_supported_by_commitment_fraction_42(building, y, needed);
    when allocated > needed;
    then agency_allocates_above_commitment_support_42(agency, building);
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "The housing credit dollar amount allocated to any building may not exceed the amount necessary to support the applicable fraction specified in the extended low-income housing commitment for such building")
rule Section42H6CAllocationCapRule(agency: Person, building: Asset) defeasible {
    when agency_allocates_above_commitment_support_42(agency, building);
    then prohibition Section42H6CAllocationCap {
        bearer agency;
        action agency_allocates_above_commitment_support_42(agency, building);
        window [@1986-10-22, infinity);
    };
}
pub relation credit_capped_by_commitment_when_h4_applies_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(h)(6)(C)(ii): if paragraph (4) applies, the credit allowed for a taxable year may not exceed the amount necessary to support the applicable fraction specified in the commitment";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "If paragraph (4) applies to any building the amount of credit allowed in any taxable year may not exceed the amount necessary to support the applicable fraction specified in the extended low-income housing commitment for such building.")
rule CreditCappedByCommitmentWhenH4AppliesRule(building: Asset, y: TaxableYear, credit: Money, needed: Money) defeasible {
    when bond_financing_qualifies_for_h4_42(building);
    when credit_before_allocation_limit_42(building, y, credit);
    when credit_supported_by_commitment_fraction_42(building, y, needed);
    then credit_capped_by_commitment_when_h4_applies_42(building, y, min(credit, needed));
}

pub relation first_day_building_part_of_qualified_project_in_compliance_period_42(building: Asset, on: Date) kind empirical {
    label en official "the 1st day in the compliance period on which the building is part of a qualified low-income housing project (section 42(h)(6)(D)(ii)(II)) — case-asserted";
}
pub relation extended_use_period_start_42(building: Asset, on: Date) kind institutional {
    label en official "section 42(h)(6)(D)(i): the extended use period begins on the 1st day in the compliance period on which the building is part of a qualified low-income housing project";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "(i) beginning on the 1st day in the compliance period on which such building is part of a qualified low-income housing project, and")
rule ExtendedUsePeriodStartRule(building: Asset, on: Date) strict {
    when first_day_building_part_of_qualified_project_in_compliance_period_42(building, on);
    then extended_use_period_start_42(building, on);
}

pub relation building_acquired_by_foreclosure_on_42(building: Asset, on: Date) kind empirical {
    label en official "the building is acquired by foreclosure (or instrument in lieu of foreclosure) on this date (section 42(h)(6)(E)(i)(I)) — case-asserted";
}
external judgment relation secretary_determines_foreclosure_arrangement_to_terminate_period_42(building: Asset) {
    authority Secretary;
    label en official "the Secretary determines that the acquisition by foreclosure is part of an arrangement with the taxpayer a purpose of which is to terminate the extended use period (section 42(h)(6)(E)(i)(I))";
}
pub relation extended_use_terminated_by_foreclosure_42(building: Asset, on: Date) kind institutional {
    label en official "section 42(h)(6)(E)(i)(I): the extended use period terminates on the date the building is acquired by foreclosure unless the Secretary determines the acquisition is part of an arrangement to terminate the period";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "on the date the building is acquired by foreclosure (or instrument in lieu of foreclosure) unless the Secretary determines that such acquisition is part of an arrangement with the taxpayer a purpose of which is to terminate such period, or")
rule ExtendedUseTerminatedByForeclosureRule(building: Asset, on: Date) defeasible {
    when building_acquired_by_foreclosure_on_42(building, on);
    then extended_use_terminated_by_foreclosure_42(building, on);
    unless secretary_determines_foreclosure_arrangement_to_terminate_period_42(building)
        and building_acquired_by_foreclosure_on_42(building, on);
}
pub relation qualified_contract_search_request_on_42(building: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer submits a written request to the housing credit agency to find a person to acquire the taxpayer's interest in the low-income portion of the building (section 42(h)(6)(I)) — case-asserted";
}
pub relation qualified_contract_search_period_42(building: Asset, start: Date, finish: Date) kind institutional {
    label en official "section 42(h)(6)(I): the 1-year period beginning on the date (after the 14th year of the compliance period) the taxpayer submits the written request";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The period referred to in this subparagraph is the 1-year period beginning on the date (after the 14th year of the compliance period) the taxpayer submits a written request to the housing credit agency to find a person to acquire the taxpayer's interest in the low-income portion of the building.")
rule QualifiedContractSearchPeriodRule(building: Asset, first: Date, on: Date) strict {
    when first_credit_year_begin_42(building, first);
    when qualified_contract_search_request_on_42(building, on);
    when on >= add_calendar_period(first, 168 calendar_month);
    then qualified_contract_search_period_42(building, on, add_calendar_period(on, 12 calendar_month));
}
pub relation qualified_contract_presented_by_agency_42(building: Asset) kind empirical {
    label en official "the housing credit agency presents a qualified contract for the acquisition of the low-income portion of the building by a person who will continue to operate it as a qualified low-income building, during the search period (section 42(h)(6)(E)(i)(II)) — case-asserted";
}
pub relation more_stringent_requirements_in_agreement_or_state_law_42(building: Asset) kind empirical {
    label en official "more stringent requirements are provided in the agreement or in State law (section 42(h)(6)(E)(i), last sentence) — case-asserted";
}
pub relation extended_use_terminated_no_qualified_contract_42(building: Asset, on: Date) kind institutional {
    label en official "section 42(h)(6)(E)(i)(II): the extended use period terminates on the last day of the search period if the agency is unable to present a qualified contract, unless more stringent requirements apply";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "on the last day of the period specified in subparagraph (I) if the housing credit agency is unable to present during such period a qualified contract for the acquisition of the low-income portion of the building by any person who will continue to operate such portion as a qualified low-income building.")
rule ExtendedUseTerminatedNoQualifiedContractRule(building: Asset, start: Date, finish: Date) defeasible {
    when qualified_contract_search_period_42(building, start, finish);
    then extended_use_terminated_no_qualified_contract_42(building, finish);
    unless qualified_contract_presented_by_agency_42(building)
        and qualified_contract_search_period_42(building, start, finish);
    unless more_stringent_requirements_in_agreement_or_state_law_42(building)
        and qualified_contract_search_period_42(building, start, finish);
}
pub relation extended_use_termination_date_42(building: Asset, on: Date) kind institutional {
    label en official "the date on which the extended use period terminates under section 42(h)(6)(E)(i) (foreclosure, or expiry of the qualified-contract search period)";
}
rule ExtendedUseTerminationDateForeclosureRule(building: Asset, on: Date) defeasible {
    when extended_use_terminated_by_foreclosure_42(building, on);
    then extended_use_termination_date_42(building, on);
}
rule ExtendedUseTerminationDateNoContractRule(building: Asset, on: Date) defeasible {
    when extended_use_terminated_no_qualified_contract_42(building, on);
    then extended_use_termination_date_42(building, on);
}
pub relation post_termination_protection_end_42(building: Asset, until: Date) kind institutional {
    label en official "section 42(h)(6)(E)(ii): the end of the 3-year period following termination of the extended use period";
}
rule PostTerminationProtectionEndRule(building: Asset, on: Date) defeasible {
    when extended_use_termination_date_42(building, on);
    then post_termination_protection_end_42(building, add_calendar_period(on, 36 calendar_month));
}
pub relation owner_evicts_or_raises_rent_of_low_income_unit_42(taxpayer: Person, unit: Asset) kind empirical {
    label en official "the owner evicts or terminates the tenancy (other than for good cause) of an existing tenant of a low-income unit, or increases its gross rent in a way not otherwise permitted by section 42 (section 42(h)(6)(E)(ii)(I)-(II)) — the action bound by the 3-year protection";
}
pub relation unit_in_building_42(unit: Asset, building: Asset) kind empirical {
    label en official "the unit is in the building — case-asserted";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The termination of an extended use period under clause (i) shall not be construed to permit before the close of the 3-year period following such termination—")
rule Section42H6EiiTenantProtectionRule(taxpayer: Person, unit: Asset, building: Asset, on: Date, until: Date) defeasible {
    when unit_in_building_42(unit, building);
    when extended_use_termination_date_42(building, on);
    when post_termination_protection_end_42(building, until);
    when owner_evicts_or_raises_rent_of_low_income_unit_42(taxpayer, unit);
    then prohibition Section42H6EiiTenantProtection {
        bearer taxpayer;
        action owner_evicts_or_raises_rent_of_low_income_unit_42(taxpayer, unit);
        window [on, until];
    };
}

// (h)(6)(F)-(H): the qualified contract price and adjusted investor equity.
pub relation outstanding_indebtedness_secured_by_building_42(building: Asset, amount: Money) kind empirical {
    label en official "the outstanding indebtedness secured by, or with respect to, the building (section 42(h)(6)(F)(i)(I)) — case-asserted";
}
pub relation cash_invested_in_project_42(building: Asset, amount: Money) kind empirical {
    label en official "the aggregate amount of cash taxpayers invested with respect to the project (section 42(h)(6)(G)(i)) — case-asserted";
}
pub relation cash_investment_obligated_at_credit_period_start_42(building: Asset, amount: Money) kind empirical {
    label en official "the amount there was an obligation to invest as of the beginning of the credit period (section 42(h)(6)(G)(i), last sentence) — case-asserted";
}
pub relation cash_investment_reflected_in_adjusted_basis_42(building: Asset, amount: Money) kind empirical {
    label en official "the part of the investment reflected in the adjusted basis of the project (section 42(h)(6)(G)(i), last sentence) — case-asserted";
}
pub relation base_year_cost_of_living_adjustment_42(building: Asset, pct: Decimal) kind empirical {
    label en official "the cost-of-living adjustment for the calendar year under section 1(f)(3) with the base calendar year substituted for 2016, as a fraction — case-asserted; the 5-percent C-CPI-U cap of clause (ii) is not modelled (TECH-GAPS)";
}
pub relation base_calendar_year_42(building: Asset, year: Decimal) kind empirical {
    label en official "the calendar year with or within which the 1st taxable year of the credit period ends (section 42(h)(6)(G)(iii)) — case-asserted";
}
pub relation adjusted_investor_equity_42(building: Asset, amount: Money) kind institutional {
    label en official "section 42(h)(6)(G)(i): the cash invested (only to the extent obligated at the start of the credit period and reflected in adjusted basis), increased by that amount times the cost-of-living adjustment";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "For purposes of subparagraph (E), the term \"adjusted investor equity\" means, with respect to any calendar year, the aggregate amount of cash taxpayers invested with respect to the project increased by the amount equal to—")
rule AdjustedInvestorEquity42Rule(building: Asset, invested: Money, obligated: Money, reflected: Money, pct: Decimal) defeasible {
    when cash_invested_in_project_42(building, invested);
    when cash_investment_obligated_at_credit_period_start_42(building, obligated);
    when cash_investment_reflected_in_adjusted_basis_42(building, reflected);
    when base_year_cost_of_living_adjustment_42(building, pct);
    then adjusted_investor_equity_42(building, round((1.0 + pct) * min(invested, min(obligated, reflected)), 2, "HALF_UP"));
}
pub relation other_capital_contributions_42(building: Asset, amount: Money) kind empirical {
    label en official "other capital contributions not reflected in the indebtedness or adjusted investor equity (section 42(h)(6)(F)(i)(III)) — case-asserted";
}
pub relation cash_distributions_from_project_42(building: Asset, amount: Money) kind empirical {
    label en official "cash distributions from (or available for distribution from) the project (section 42(h)(6)(F)(ii)) — case-asserted";
}
pub relation qualified_contract_minimum_low_income_price_42(building: Asset, amount: Money) kind institutional {
    label en official "section 42(h)(6)(F): the applicable fraction specified in the commitment of (indebtedness + adjusted investor equity + other capital contributions - cash distributions)";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "the low-income portion of the building for an amount not less than the applicable fraction (specified in the extended low-income housing commitment) of—")
rule QualifiedContractMinimumLowIncomePriceRule(building: Asset, debt: Money, equity: Money, other: Money, distributions: Money, fraction: Decimal) defeasible {
    when outstanding_indebtedness_secured_by_building_42(building, debt);
    when adjusted_investor_equity_42(building, equity);
    when other_capital_contributions_42(building, other);
    when cash_distributions_from_project_42(building, distributions);
    when commitment_applicable_fraction_42(building, fraction);
    then qualified_contract_minimum_low_income_price_42(building, round(fraction * (debt + equity + other - distributions), 2, "HALF_UP"));
}
pub relation contract_is_bona_fide_and_closes_within_reasonable_period_42(building: Asset) kind empirical {
    label en official "the contract is a bona fide contract to acquire the building within a reasonable period after it is entered into (section 42(h)(6)(F)) — evaluative (DECISION-0194), case-asserted";
}
pub relation nonlow_income_portion_price_is_fair_market_value_42(building: Asset) kind empirical {
    label en official "the contract price of the nonlow-income portion is its fair market value (section 42(h)(6)(F)) — evaluative (DECISION-0194), case-asserted";
}
pub relation contract_price_of_low_income_portion_42(building: Asset, amount: Money) kind empirical {
    label en official "the contract price for the low-income portion of the building — case-asserted";
}
pub relation qualified_contract_42(building: Asset) kind institutional {
    label en official "section 42(h)(6)(F): a bona fide contract to acquire the nonlow-income portion at fair market value and the low-income portion for not less than the minimum price";
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "For purposes of subparagraph (E), the term \"qualified contract\" means a bona fide contract to acquire (within a reasonable period after the contract is entered into) the nonlow-income portion of the building for fair market value")
rule QualifiedContract42Rule(building: Asset, price: Money, minimum: Money) defeasible {
    when contract_is_bona_fide_and_closes_within_reasonable_period_42(building);
    when nonlow_income_portion_price_is_fair_market_value_42(building);
    when contract_price_of_low_income_portion_42(building, price);
    when qualified_contract_minimum_low_income_price_42(building, minimum);
    when price >= minimum;
    then qualified_contract_42(building);
}
pub relation low_income_portion_fraction_42(building: Asset, fraction: Decimal) kind institutional {
    label en official "section 42(h)(6)(H): the low-income portion of the building is the applicable fraction specified in the commitment";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the low-income portion of a building is the portion of such building equal to the applicable fraction specified in the extended low-income housing commitment for the building.")
rule LowIncomePortionFraction42Rule(building: Asset, fraction: Decimal) strict {
    when commitment_applicable_fraction_42(building, fraction);
    then low_income_portion_fraction_42(building, fraction);
}

// (h)(6)(J): correction of a failure of the commitment.
pub relation commitment_not_in_effect_determination_on_42(building: Asset, on: Date) kind empirical {
    label en official "the date of a determination that an extended low-income housing agreement was not in effect as of the beginning of the year (section 42(h)(6)(J)) — case-asserted";
}
pub relation commitment_failure_corrected_on_42(building: Asset, on: Date) kind empirical {
    label en official "the date the failure of the commitment is corrected — case-asserted";
}
pub relation commitment_failure_disregarded_42(building: Asset) kind institutional {
    label en official "section 42(h)(6)(J): subparagraph (A) is applied without regard to the determination if the failure is corrected within 1 year from the date of the determination";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "such determination shall not apply to any period before such year and subparagraph (A) shall be applied without regard to such determination if the failure is corrected within 1 year from the date of the determination.")
rule CommitmentFailureDisregardedRule(building: Asset, determined: Date, corrected: Date) strict {
    when commitment_not_in_effect_determination_on_42(building, determined);
    when commitment_failure_corrected_on_42(building, corrected);
    when corrected <= add_calendar_period(determined, 12 calendar_month);
    then commitment_failure_disregarded_42(building);
}
rule CreditAllowedByCommitmentFailureCorrectedRule(building: Asset, y: TaxableYear) strict {
    when credit_period_year_42(building, y);
    when commitment_failure_disregarded_42(building);
    then credit_allowed_by_commitment_42(building, y);
}

// --- (h)(7)(C)-(D): the percentage limitation and the agency's specification --------------------------------------------------------------------

pub relation credit_at_full_rate_for_h7c_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit that would be determined if section 42 were applied without regard to subsection (f)(2)(A) and (f)(3)(B), and (f)(3)(A) without \"the percentage equal to 2/3 of\" (section 42(h)(7)(C)(iii)) — case-asserted recomputation";
}
relation h7c_full_rate_credit_asserted_42(building: Asset, y: TaxableYear) kind institutional;
rule H7cFullRateCreditAssertedRule(building: Asset, y: TaxableYear, amount: Money) strict {
    when credit_at_full_rate_for_h7c_42(building, y, amount);
    then h7c_full_rate_credit_asserted_42(building, y);
}
pub relation credit_after_h7c_percentage_limit_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(h)(7)(C): the credit does not exceed the percentage (allocated housing credit dollar amount over the full-rate credit) of the credit otherwise determined";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The amount of the credit determined under this section with respect to any building shall not exceed the clause (ii) percentage of the amount of the credit which would (but for this subparagraph) be determined under this section with respect to such building.")
rule CreditAfterH7cPercentageLimitRule(building: Asset, y: TaxableYear, credit: Money, agency: Person, year: Decimal, allocated: Money, full: Money) defeasible {
    when credit_before_allocation_limit_42(building, y, credit);
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    when credit_at_full_rate_for_h7c_42(building, y, full);
    when full > 0 USD;
    // JUDGMENT CALL: cents HALF_UP; a percentage above 100 percent does not raise the credit.
    then credit_after_h7c_percentage_limit_42(building, y, min(credit, div_round(credit * (allocated / 1.00 USD), full / 1.00 USD, 2, "HALF_UP")));
}
pub relation agency_specified_percentage_and_basis_42(building: Asset, percentage: Decimal, maximum_basis: Money) kind empirical {
    label en official "the applicable percentage and the maximum qualified basis specified by the agency in the allocation (section 42(h)(7)(D)) — case-asserted";
}
pub relation agency_specification_within_computed_amounts_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(h)(7)(D): the specified applicable percentage and maximum qualified basis do not exceed those determined under section 42 without regard to subsection (h)";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The applicable percentage and maximum qualified basis so specified shall not exceed the applicable percentage and qualified basis determined under this section without regard to this subsection.")
rule AgencySpecificationWithinComputedRule(building: Asset, y: TaxableYear, pct: Decimal, basis: Money, spec_pct: Decimal, spec_basis: Money) strict {
    when applicable_percentage_after_h_42(building, y, pct);
    when qualified_basis_at_close_42(building, y, basis);
    when agency_specified_percentage_and_basis_42(building, spec_pct, spec_basis);
    when spec_pct <= pct;
    when spec_basis <= basis;
    then agency_specification_within_computed_amounts_42(building, y);
}
pub relation agency_specifies_above_computed_amounts_42(agency: Person, building: Asset) kind institutional {
    label en official "section 42(h)(7)(D): the agency specifies an applicable percentage or maximum qualified basis above the amounts determined without regard to subsection (h)";
}
rule AgencySpecifiesAboveComputedRule(agency: Person, building: Asset, y: TaxableYear, pct: Decimal, spec_pct: Decimal, spec_basis: Money) strict {
    when applicable_percentage_after_h_42(building, y, pct);
    when agency_specified_percentage_and_basis_42(building, spec_pct, spec_basis);
    when agency_allocates_to_building_42(agency, building);
    when spec_pct > pct;
    then agency_specifies_above_computed_amounts_42(agency, building);
}
rule AgencySpecifiesAboveComputedBasisRule(agency: Person, building: Asset, y: TaxableYear, basis: Money, spec_pct: Decimal, spec_basis: Money) strict {
    when qualified_basis_at_close_42(building, y, basis);
    when agency_specified_percentage_and_basis_42(building, spec_pct, spec_basis);
    when agency_allocates_to_building_42(agency, building);
    when spec_basis > basis;
    then agency_specifies_above_computed_amounts_42(agency, building);
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "In allocating a housing credit dollar amount to any building, the housing credit agency shall specify the applicable percentage and the maximum qualified basis which may be taken into account under this section with respect to such building.")
rule Section42H7DSpecificationLimitRule(agency: Person, building: Asset) defeasible {
    when agency_specifies_above_computed_amounts_42(agency, building);
    then prohibition Section42H7DSpecificationLimit {
        bearer agency;
        action agency_specifies_above_computed_amounts_42(agency, building);
        window [@1986-10-22, infinity);
    };
}
pub relation agency_specified_percentage_and_basis_in_allocation_42(building: Asset, agency: Person) kind empirical {
    label en official "the agency specified the applicable percentage and the maximum qualified basis in allocating the amount to the building (section 42(h)(7)(D), first sentence) — case-asserted";
}
pub relation agency_allocated_without_specifying_42(agency: Person, building: Asset) kind institutional {
    label en official "section 42(h)(7)(D): the agency allocates to the building without specifying the applicable percentage and maximum qualified basis";
}
rule AgencyAllocatedWithoutSpecifyingRule(agency: Person, building: Asset) strict {
    when agency_allocates_to_building_42(agency, building);
    when not_known(agency_specified_percentage_and_basis_in_allocation_42(building, agency));
    then agency_allocated_without_specifying_42(agency, building);
}
rule Section42H7DSpecifyDutyRule(agency: Person, building: Asset) defeasible {
    when agency_allocated_without_specifying_42(agency, building);
    then prohibition Section42H7DAllocationWithoutSpecification {
        bearer agency;
        action agency_allocated_without_specifying_42(agency, building);
        window [@1986-10-22, infinity);
    };
}

// --- (h)(8): definitions ------------------------------------------------------------------------------------------------------------------------------------

pub relation agency_authorized_to_carry_out_subsection_h_42(agency: Person) kind empirical {
    label en official "the agency is authorized to carry out section 42(h) (section 42(h)(8)(A)) — case-asserted";
}
pub relation housing_credit_agency_42(agency: Person) kind institutional {
    label en official "section 42(h)(8)(A): any agency authorized to carry out subsection (h)";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The term \"housing credit agency\" means any agency authorized to carry out this subsection.")
rule HousingCreditAgency42Rule(agency: Person) strict {
    when agency_authorized_to_carry_out_subsection_h_42(agency);
    then housing_credit_agency_42(agency);
}
pub relation is_state_of_the_union_42(state: Person) kind empirical {
    label en official "the governmental unit is a State of the United States — case-asserted";
}
pub relation is_possession_of_the_united_states_42(state: Person) kind empirical {
    label en official "the governmental unit is a possession of the United States — case-asserted";
}
pub relation state_for_section_42_42(state: Person) kind institutional {
    label en official "section 42(h)(8)(B): the term State includes a possession of the United States";
}
@source(IRC_S42_H, relation = formalizes, coverage = exact, quote = "The term \"State\" includes a possession of the United States.")
rule StateForSection42StateRule(state: Person) strict {
    when is_state_of_the_union_42(state);
    then state_for_section_42_42(state);
}
rule StateForSection42PossessionRule(state: Person) strict {
    when is_possession_of_the_united_states_42(state);
    then state_for_section_42_42(state);
}

// --- Wiring: the section 42 limits into the credit read by section 38(b)(5) --------------------------------------------------------------------

pub relation credit_after_h_limits_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 42(h)(1), (4), (6)(A), (7)(C), (m)(1): the credit of the building for the year after the allocation limit (the counted allocation, with the qualified allocation plan zeroing), the bond-financed exception, the percentage limitation, and the commitment gate";
}
// (h)(1)(A) with the counted allocation: min(credit, counted allocation); the counted amount is zero when the
// qualified allocation plan conditions of (m)(1) fail (effective amount) — `effective_housing_credit_dollar_amount_42`.
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "The amount of the credit determined under this section for any taxable year with respect to any building shall not exceed the housing credit dollar amount allocated to such building under this subsection.")
rule CreditAfterHLimitsAllocationRule(building: Asset, y: TaxableYear, credit: Money, agency: Person, year: Decimal, eff_amt: Money, counted: Money, bonds: Money) defeasible {
    when credit_before_allocation_limit_42(building, y, credit);
    when credit_allowed_by_commitment_42(building, y);
    when allocation_applies_to_taxable_year_42(building, agency, year, y);
    when effective_housing_credit_dollar_amount_42(building, agency, year, eff_amt);
    when allocation_counted_for_credit_42(building, agency, year, y, counted);
    when not_known(bond_financing_qualifies_for_h4_42(building));
    then credit_after_h_limits_42(building, y, min(credit, min(eff_amt, counted)));
}
rule CreditAfterHLimitsBondPortionRule(building: Asset, y: TaxableYear, credit: Money, agency: Person, year: Decimal, eff_amt: Money, counted: Money, bond_portion: Money) defeasible {
    when credit_before_allocation_limit_42(building, y, credit);
    when credit_allowed_by_commitment_42(building, y);
    when allocation_applies_to_taxable_year_42(building, agency, year, y);
    when effective_housing_credit_dollar_amount_42(building, agency, year, eff_amt);
    when allocation_counted_for_credit_42(building, agency, year, y, counted);
    when bond_financed_credit_portion_42(building, y, bond_portion);
    when not_known(h1_limit_disapplied_entire_credit_42(building));
    then credit_after_h_limits_42(building, y, bond_portion + min(credit - bond_portion, min(eff_amt, counted)));
}
rule CreditAfterHLimitsWholeCreditBondRule(building: Asset, y: TaxableYear, credit: Money) defeasible {
    when credit_before_allocation_limit_42(building, y, credit);
    when credit_allowed_by_commitment_42(building, y);
    when h1_limit_disapplied_entire_credit_42(building);
    then credit_after_h_limits_42(building, y, credit);
}
pub relation credit_after_h_limits_and_percentage_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit after the (h)(1)/(h)(4) limits and, where the full-rate credit is asserted, the (h)(7)(C) percentage limitation";
}
rule CreditAfterHLimitsAndPercentageRule(building: Asset, y: TaxableYear, limited: Money, by_percentage: Money) defeasible {
    when credit_after_h_limits_42(building, y, limited);
    when credit_after_h7c_percentage_limit_42(building, y, by_percentage);
    then credit_after_h_limits_and_percentage_42(building, y, min(limited, by_percentage));
}
rule CreditAfterHLimitsNoPercentageRule(building: Asset, y: TaxableYear, limited: Money) defeasible {
    when credit_after_h_limits_42(building, y, limited);
    when not_known(h7c_full_rate_credit_asserted_42(building, y));
    then credit_after_h_limits_and_percentage_42(building, y, limited);
}
pub relation section_42_limits_path_applies_42(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer has at least one building whose credit for the year is computed through the section 42(h) limits";
}
rule Section42LimitsPathAppliesRule(taxpayer: Person, y: TaxableYear, building: Asset, amount: Money) defeasible {
    when low_income_housing_building_owned_by(building, taxpayer);
    when credit_after_h_limits_and_percentage_42(building, y, amount);
    then section_42_limits_path_applies_42(taxpayer, y);
}
pub relation low_income_housing_credit_after_h_limits_42(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 42 low-income housing credit for the taxable year after the section 42(h) limits: the sum across the taxpayer's buildings of the credit after the limits";
}
rule LowIncomeHousingCreditAfterHLimitsRule(taxpayer: Person, y: TaxableYear, building: Asset, amount: Money) defeasible {
    when low_income_housing_building_owned_by(building, taxpayer);
    when credit_after_h_limits_and_percentage_42(building, y, amount);
    then low_income_housing_credit_after_h_limits_42(taxpayer, y,
        sum all one: Money for b: Asset where low_income_housing_building_owned_by(b, taxpayer) and credit_after_h_limits_and_percentage_42(b, y, one));
}
