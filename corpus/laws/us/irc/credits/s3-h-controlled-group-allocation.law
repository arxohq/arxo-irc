// Stage 3 (TECH_GAP reduction): "rules similar to the rules of paragraph (1) [and (2)] of section
// 41(f)" in sections 45C(d)(3), 45G(e)(2) and 45O(g).
//   41(f)(1)(A): all members of the same controlled group of corporations are a single taxpayer
//     and the credit of each member is proportionate to its share of the aggregate expenses;
//   41(f)(1)(B): the same for trades or businesses under common control;
//   41(f)(2)(A): rules similar to section 52(d) for estates and trusts (45C and 45O only).
// (41(f)(2)(B), the allocation among partners, is left to regulations not pinned here.)
// SHAPE. The credit computed for the group as a single taxpayer, and each member's share of the
// aggregate expenses, are case facts; the member share of the credit is derived (one rounding to
// cents HALF_UP). The controlled group of corporations is section_52_controlled_group_member
// (52-controlled-groups-and-special-rules.law: section 41(f)(5) text is the same definition);
// common control is under_common_control_52b. The regulations that section 41(f)(1)(B) refers to
// are EXTERNAL_DEPENDENCY.
// STATUS: implemented_unverified (static check only).

use self::{
    ControlledGroup,
    Corporation,
    IRC_S45C_D,
    IRC_S45G_E,
    IRC_S45O_G,
    Person,
    TaxableYear,
    agricultural_chemicals_security_credit,
    orphan_drug_credit,
    section_52_controlled_group_member,
    section_52d_income_allocable_share,
    under_common_control_52b,
};

pub relation orphan_drug_credit_of_controlled_group_45c(group: ControlledGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the orphan drug credit determined for the controlled group or the group under common control treated as a single taxpayer (section 41(f)(1) applied by section 45C(d)(3)) — case-asserted";
}
pub relation member_share_of_aggregate_expenses_45c(group: ControlledGroup, member: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the member's share (a fraction) of the aggregate qualified clinical testing expenses taken into account by the group (section 41(f)(1)(A)(ii), (B)(ii) applied by section 45C(d)(3)) — case-asserted";
}
pub relation orphan_drug_credit_member_share_45c(group: ControlledGroup, member: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45C(d)(3): the proportionate share of the group's orphan drug credit allowable to the member";
}
@source(IRC_S45C_D, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraphs (1) and (2) of section 41(f) shall apply for purposes of this section.")
rule OrphanDrugCreditMemberShareCorporation45CRule(group: ControlledGroup, member: Corporation, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(1)(A) applied by section 45C(d)(3): a member of the controlled group of corporations is allowed its proportionate share";
    when section_52_controlled_group_member(group, member);
    when orphan_drug_credit_of_controlled_group_45c(group, y, total);
    when member_share_of_aggregate_expenses_45c(group, member, y, share);
    then orphan_drug_credit_member_share_45c(group, member, y, round(total * share, 2, "HALF_UP"));
}
@source(IRC_S45C_D, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraphs (1) and (2) of section 41(f) shall apply for purposes of this section.")
rule OrphanDrugCreditMemberShareCommonControl45CRule(group: ControlledGroup, member: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(1)(B) applied by section 45C(d)(3): a trade or business under common control is allowed its proportionate share";
    when under_common_control_52b(group, member, y);
    when orphan_drug_credit_of_controlled_group_45c(group, y, total);
    when member_share_of_aggregate_expenses_45c(group, member, y, share);
    then orphan_drug_credit_member_share_45c(group, member, y, round(total * share, 2, "HALF_UP"));
}
pub relation orphan_drug_credit_apportioned_45c(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the beneficiary's apportioned share of the orphan drug credit of the estate or trust, under rules similar to section 52(d) (section 41(f)(2)(A) applied by section 45C(d)(3))";
}
@source(IRC_S45C_D, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraphs (1) and (2) of section 41(f) shall apply for purposes of this section.")
rule OrphanDrugCreditApportioned45CRule(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(2)(A) applied by section 45C(d)(3): on the basis of the allocable income; one rounding to cents HALF_UP";
    when orphan_drug_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then orphan_drug_credit_apportioned_45c(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}
pub relation railroad_track_maintenance_credit_of_controlled_group_45g(group: ControlledGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the railroad track maintenance credit determined for the controlled group or the group under common control treated as a single taxpayer (section 41(f)(1) applied by section 45G(e)(2)) — case-asserted";
}
pub relation member_share_of_aggregate_expenses_45g(group: ControlledGroup, member: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the member's share (a fraction) of the aggregate qualified railroad track maintenance expenditures taken into account by the group (section 41(f)(1)(A)(ii), (B)(ii) applied by section 45G(e)(2)) — case-asserted";
}
pub relation railroad_track_maintenance_credit_member_share_45g(group: ControlledGroup, member: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45G(e)(2): the proportionate share of the group's railroad track maintenance credit allowable to the member";
}
@source(IRC_S45G_E, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraph (1) of section 41(f) shall apply for purposes of this section.")
rule RailroadTrackMaintenanceCreditMemberShareCorporation45GRule(group: ControlledGroup, member: Corporation, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(1)(A) applied by section 45G(e)(2): a member of the controlled group of corporations is allowed its proportionate share";
    when section_52_controlled_group_member(group, member);
    when railroad_track_maintenance_credit_of_controlled_group_45g(group, y, total);
    when member_share_of_aggregate_expenses_45g(group, member, y, share);
    then railroad_track_maintenance_credit_member_share_45g(group, member, y, round(total * share, 2, "HALF_UP"));
}
@source(IRC_S45G_E, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraph (1) of section 41(f) shall apply for purposes of this section.")
rule RailroadTrackMaintenanceCreditMemberShareCommonControl45GRule(group: ControlledGroup, member: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(1)(B) applied by section 45G(e)(2): a trade or business under common control is allowed its proportionate share";
    when under_common_control_52b(group, member, y);
    when railroad_track_maintenance_credit_of_controlled_group_45g(group, y, total);
    when member_share_of_aggregate_expenses_45g(group, member, y, share);
    then railroad_track_maintenance_credit_member_share_45g(group, member, y, round(total * share, 2, "HALF_UP"));
}
pub relation agricultural_chemicals_security_credit_of_controlled_group_45o(group: ControlledGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the agricultural chemicals security credit determined for the controlled group or the group under common control treated as a single taxpayer (section 41(f)(1) applied by section 45O(g)) — case-asserted";
}
pub relation member_share_of_aggregate_expenses_45o(group: ControlledGroup, member: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the member's share (a fraction) of the aggregate qualified agricultural chemicals security costs taken into account by the group (section 41(f)(1)(A)(ii), (B)(ii) applied by section 45O(g)) — case-asserted";
}
pub relation agricultural_chemicals_security_credit_member_share_45o(group: ControlledGroup, member: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45O(g): the proportionate share of the group's agricultural chemicals security credit allowable to the member";
}
@source(IRC_S45O_G, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraphs (1) and (2) of section 41(f) shall apply for purposes of this section.")
rule AgriculturalChemicalsSecurityCreditMemberShareCorporation45ORule(group: ControlledGroup, member: Corporation, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(1)(A) applied by section 45O(g): a member of the controlled group of corporations is allowed its proportionate share";
    when section_52_controlled_group_member(group, member);
    when agricultural_chemicals_security_credit_of_controlled_group_45o(group, y, total);
    when member_share_of_aggregate_expenses_45o(group, member, y, share);
    then agricultural_chemicals_security_credit_member_share_45o(group, member, y, round(total * share, 2, "HALF_UP"));
}
@source(IRC_S45O_G, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraphs (1) and (2) of section 41(f) shall apply for purposes of this section.")
rule AgriculturalChemicalsSecurityCreditMemberShareCommonControl45ORule(group: ControlledGroup, member: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(1)(B) applied by section 45O(g): a trade or business under common control is allowed its proportionate share";
    when under_common_control_52b(group, member, y);
    when agricultural_chemicals_security_credit_of_controlled_group_45o(group, y, total);
    when member_share_of_aggregate_expenses_45o(group, member, y, share);
    then agricultural_chemicals_security_credit_member_share_45o(group, member, y, round(total * share, 2, "HALF_UP"));
}
pub relation agricultural_chemicals_security_credit_apportioned_45o(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the beneficiary's apportioned share of the agricultural chemicals security credit of the estate or trust, under rules similar to section 52(d) (section 41(f)(2)(A) applied by section 45O(g))";
}
@source(IRC_S45O_G, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraphs (1) and (2) of section 41(f) shall apply for purposes of this section.")
rule AgriculturalChemicalsSecurityCreditApportioned45ORule(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 41(f)(2)(A) applied by section 45O(g): on the basis of the allocable income; one rounding to cents HALF_UP";
    when agricultural_chemicals_security_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then agricultural_chemicals_security_credit_apportioned_45o(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}
