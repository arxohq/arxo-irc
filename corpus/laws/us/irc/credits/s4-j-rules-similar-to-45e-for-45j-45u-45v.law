// Stage 4 (DECISION-0379 with deontics), credits, part J: rules similar to section 45(e)(1), (3),
// (4), (5), (13) for sections 45J(f), 45U(c)(2) and (3) only for 45V(d)(1). Closes G6412.
//
// The section 45 rules (module 45c-qualified-energy-resources) are READ by explicit reference:
// the ownership share of gross sales (`ownership_share_of_gross_sales_45`, the (e)(3) input), the
// related persons of (e)(4) (`persons_related_45`), the estate/trust share of section 52(d)
// (`section_52d_income_allocable_share`, the (e)(5) rule "similar to 52(d)"). What is keyed to
// section 45 production is written for the kilowatt hours of 45J and 45U and the kilograms of 45V.
//
// (e)(3), allocation among owners: an OUTPUT (owner x share of the facility's production); the
// credit rules of 45J and 45U are keyed to the facility, the 45V credit reads the merged
// kilograms (asserted per taxpayer, or allocated). (e)(1), (4), (13), the kilowatt hours count only
// for electricity produced in the United States or a possession and sold to an unrelated person:
// written as EXCLUSIONS on two case flags (JUDGMENT CALL: without the flags the earlier scenarios,
// which assert neither the place nor the buyer, keep computing; a flag asserted excludes the
// kilowatt hours). (e)(5): the credit apportioned between an estate or trust and its beneficiaries
// by income (output, as `credit_apportioned_by_similar_52d_rule` of part B).

// WIRING (final TECH_GAP pass, 26.09.2026, closes the G6604 remainder): the credit of a facility is split
// among its owners in proportion to the interests in gross sales (rule similar to (e)(3): an owner with
// a share reads share x the credit of the facility, computed after the limits of the facility, which is
// a JUDGMENT CALL: the capacity and price limits are facility-level; an owner without an asserted share
// reads the whole credit, the earlier single-owner behaviour), and the credit of an estate or trust is
// apportioned between it and its beneficiaries by the income allocable to each (rule similar to (e)(5):
// the estate keeps the credit less the rounded parts apportioned, a beneficiary receives the rounded
// part of the credit of each estate or trust). The section 38(b) components 45J and 45U read the credit
// AFTER the apportionment (`..._after_estate_apportionment_...`). Aggregates are over the case-asserted
// shares and over the credit relations positively; no negation is used inside a collect.

use self::{
    Asset,
    IRC_S45J_F,
    IRC_S45U_C,
    IRC_S45V_D,
    Person,
    TaxableYear,
    advanced_nuclear_power_facility_production_credit,
    electricity_kilowatt_hours_base_45u,
    hydrogen_kilograms_produced_45v,
    kilowatt_hours_sold_45j,
    nuclear_facility_owned_by_taxpayer_45u,
    ownership_share_of_gross_sales_45,
    section_52d_income_allocable_share,
    zero_emission_nuclear_power_production_credit,
    zero_emission_nuclear_power_production_credit_of_facility_45u,
};

pub relation has_gross_sales_share_45(facility: Asset, owner: Person) kind institutional {
    label en official "an ownership interest in the gross sales of the facility is asserted for the owner (section 45(e)(3)); bridge for the absence test";
}
rule HasGrossSalesShare45(facility: Asset, owner: Person, share: Decimal) defeasible {
    label en official "bridge for the absence test";
    when ownership_share_of_gross_sales_45(facility, owner, share);
    then has_gross_sales_share_45(facility, owner);
}

pub relation electricity_produced_outside_united_states_and_possessions_45x(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the electricity is produced outside the United States (section 638(1)) and its possessions (section 638(2)); negation of the requirement of section 45(e)(1), asserted only in the exceptional case";
}
pub relation electricity_sold_only_to_related_persons_45x(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the electricity is sold only to related persons (section 45(e)(4)) and is not treated as sold to an unrelated person (section 45(e)(13)); asserted only in the exceptional case";
}
pub relation kilowatt_hours_excluded_by_45e_rules_45x(facility: Asset, y: TaxableYear) kind institutional {
    label en official "the kilowatt hours are not taken into account: produced outside the United States and its possessions (rule similar to section 45(e)(1)), or sold only to related persons (rules similar to section 45(e)(4), (13))";
}
@source(IRC_S45J_F, quote = "Rules similar to the rules of paragraphs (1), (3), (4), and (5) of section 45(e) shall apply for purposes of this section.")
rule KilowattHoursExcludedOutsideUnitedStates45x(facility: Asset, y: TaxableYear) defeasible {
    label en official "production outside the United States and its possessions (section 45(e)(1))";
    when electricity_produced_outside_united_states_and_possessions_45x(facility, y);
    then kilowatt_hours_excluded_by_45e_rules_45x(facility, y);
}
rule KilowattHoursExcludedRelatedPersonsOnly45x(facility: Asset, y: TaxableYear) defeasible {
    label en official "sales only to related persons (section 45(e)(4), (13))";
    when electricity_sold_only_to_related_persons_45x(facility, y);
    then kilowatt_hours_excluded_by_45e_rules_45x(facility, y);
}

// ---- 45J(f) ----

pub relation kilowatt_hours_for_credit_45j(facility: Asset, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "the kilowatt hours produced and sold that the section 45J credit reads, after the rules similar to section 45(e)(1), (4), (13)";
}
@source(IRC_S45J_F, quote = "Rules similar to the rules of paragraphs (1), (3), (4), and (5) of section 45(e) shall apply for purposes of this section.")
rule KilowattHoursForCredit45j(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    label en official "the kilowatt hours sold, unless excluded (section 45J(f))";
    when kilowatt_hours_sold_45j(facility, y, kwh);
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then kilowatt_hours_for_credit_45j(facility, y, kwh);
}
rule KilowattHoursExcludedZero45j(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    label en official "excluded kilowatt hours count as zero";
    when kilowatt_hours_sold_45j(facility, y, kwh);
    when kilowatt_hours_excluded_by_45e_rules_45x(facility, y);
    then kilowatt_hours_for_credit_45j(facility, y, 0.0);
}
pub relation kilowatt_hours_produced_by_facility_45j(facility: Asset, y: TaxableYear, kwh: Decimal) kind empirical {
    label en official "the production of the facility for the taxable year, before the allocation among its owners (rule similar to section 45(e)(3)) — case-asserted";
}
pub relation kilowatt_hours_allocated_to_owner_45j(facility: Asset, owner: Person, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "the production allocated to an owner of a facility with more than one owner, in proportion to the owner's interest in the gross sales from the facility (rule similar to section 45(e)(3), share of section 45)";
}
@source(IRC_S45J_F, quote = "Rules similar to the rules of paragraphs (1), (3), (4), and (5) of section 45(e) shall apply for purposes of this section.")
rule KilowattHoursAllocatedToOwner45j(facility: Asset, owner: Person, y: TaxableYear, total: Decimal, share: Decimal) defeasible {
    label en official "production x share of gross sales (section 45J(f), by section 45(e)(3))";
    when kilowatt_hours_produced_by_facility_45j(facility, y, total);
    when ownership_share_of_gross_sales_45(facility, owner, share);
    then kilowatt_hours_allocated_to_owner_45j(facility, owner, y, total * share);
}

// ---- 45U(c)(2) ----

pub relation electricity_kilowatt_hours_for_credit_45u(facility: Asset, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "the kilowatt hours of electricity the section 45U credit reads, after the rules similar to section 45(e)(1), (4), (13)";
}
@source(IRC_S45U_C, quote = "Rules similar to the rules of paragraphs (1), (3), (4), (5), and (13) of section 45(e) shall apply for purposes of this section.")
rule ElectricityKilowattHoursForCredit45u(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    label en official "the electricity kilowatt hours, unless excluded (section 45U(c)(2))";
    when electricity_kilowatt_hours_base_45u(facility, y, kwh);
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then electricity_kilowatt_hours_for_credit_45u(facility, y, kwh);
}
rule ElectricityKilowattHoursExcludedZero45u(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    label en official "excluded kilowatt hours count as zero";
    when electricity_kilowatt_hours_base_45u(facility, y, kwh);
    when kilowatt_hours_excluded_by_45e_rules_45x(facility, y);
    then electricity_kilowatt_hours_for_credit_45u(facility, y, 0.0);
}
pub relation kilowatt_hours_produced_by_facility_45u(facility: Asset, y: TaxableYear, kwh: Decimal) kind empirical {
    label en official "the production of the facility for the taxable year, before the allocation among its owners (rule similar to section 45(e)(3)) — case-asserted";
}
pub relation kilowatt_hours_allocated_to_owner_45u(facility: Asset, owner: Person, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "the production allocated to an owner of a facility with more than one owner, in proportion to the owner's interest in the gross sales from the facility (rule similar to section 45(e)(3), share of section 45)";
}
@source(IRC_S45U_C, quote = "Rules similar to the rules of paragraphs (1), (3), (4), (5), and (13) of section 45(e) shall apply for purposes of this section.")
rule KilowattHoursAllocatedToOwner45u(facility: Asset, owner: Person, y: TaxableYear, total: Decimal, share: Decimal) defeasible {
    label en official "production x share of gross sales (section 45U(c)(2), by section 45(e)(3))";
    when kilowatt_hours_produced_by_facility_45u(facility, y, total);
    when ownership_share_of_gross_sales_45(facility, owner, share);
    then kilowatt_hours_allocated_to_owner_45u(facility, owner, y, total * share);
}

// ---- 45V(d)(1): only the rule similar to section 45(e)(3) ----

pub relation hydrogen_kilograms_produced_by_facility_45v(facility: Asset, y: TaxableYear, kilograms: Decimal) kind empirical {
    label en official "the clean hydrogen produced at the facility in the taxable year, before the allocation among its owners (rule similar to section 45(e)(3)) — case-asserted";
}
pub relation hydrogen_kilograms_allocated_to_owner_45v(facility: Asset, owner: Person, y: TaxableYear, kilograms: Decimal) kind institutional {
    label en official "the kilograms allocated to an owner of a facility with more than one owner, in proportion to the owner's interest in the gross sales from the facility (rule similar to section 45(e)(3), share of section 45)";
}
@source(IRC_S45V_D, quote = "Rules similar to the rules section 45(e)(3) shall apply for purposes of this section.")
rule HydrogenKilogramsAllocatedToOwner45v(facility: Asset, owner: Person, y: TaxableYear, total: Decimal, share: Decimal) defeasible {
    label en official "production x share of gross sales (section 45V(d)(1), by section 45(e)(3))";
    when hydrogen_kilograms_produced_by_facility_45v(facility, y, total);
    when ownership_share_of_gross_sales_45(facility, owner, share);
    then hydrogen_kilograms_allocated_to_owner_45v(facility, owner, y, total * share);
}
pub relation hydrogen_kilograms_for_credit_45v(taxpayer: Person, facility: Asset, y: TaxableYear, kilograms: Decimal) kind institutional {
    label en official "the kilograms the section 45V credit reads for a taxpayer: the asserted production of the taxpayer at the facility, or the taxpayer's allocated share";
}
rule HydrogenKilogramsForCreditAsserted45v(taxpayer: Person, facility: Asset, y: TaxableYear, kilograms: Decimal) defeasible {
    label en official "the asserted kilograms (the earlier channel)";
    when hydrogen_kilograms_produced_45v(taxpayer, facility, y, kilograms);
    then hydrogen_kilograms_for_credit_45v(taxpayer, facility, y, kilograms);
}
rule HydrogenKilogramsForCreditAllocated45v(taxpayer: Person, facility: Asset, y: TaxableYear, kilograms: Decimal) defeasible {
    label en official "the allocated share of the facility's production";
    when hydrogen_kilograms_allocated_to_owner_45v(facility, taxpayer, y, kilograms);
    then hydrogen_kilograms_for_credit_45v(taxpayer, facility, y, kilograms);
}

// ---- (5): estates and trusts, by the rule similar to section 52(d) ----

pub relation credit_apportioned_by_similar_52d_rule_45x(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit of an estate or trust under section 45J or 45U apportioned between it and the beneficiaries on the basis of the income allocable to each (rule similar to section 52(d), applied by section 45(e)(5)); cents HALF_UP";
}
@source(IRC_S45J_F, quote = "Rules similar to the rules of paragraphs (1), (3), (4), and (5) of section 45(e) shall apply for purposes of this section.")
rule ApportionmentSimilarToSection52d45j(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "the section 45J credit of the estate or trust apportioned by income (section 45J(f), by section 45(e)(5))";
    when advanced_nuclear_power_facility_production_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then credit_apportioned_by_similar_52d_rule_45x(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}
@source(IRC_S45U_C, quote = "Rules similar to the rules of paragraphs (1), (3), (4), (5), and (13) of section 45(e) shall apply for purposes of this section.")
rule ApportionmentSimilarToSection52d45u(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "the section 45U credit of the estate or trust apportioned by income (section 45U(c)(2), by section 45(e)(5))";
    when zero_emission_nuclear_power_production_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then credit_apportioned_by_similar_52d_rule_45x(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}

// ---- the wiring of (e)(3) and (e)(5) into the credit chains of 45J and 45U ----

pub relation credit_of_owner_of_facility_45u(facility: Asset, owner: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45U credit of an owner of the facility: the credit of the facility times the owner's interest in the gross sales where one is asserted (rule similar to section 45(e)(3)), else the whole credit; cents HALF_UP";
}
@source(IRC_S45U_C, quote = "Rules similar to the rules of paragraphs (1), (3), (4), (5), and (13) of section 45(e) shall apply for purposes of this section.")
rule CreditOfOwnerWithShare45u(facility: Asset, owner: Person, y: TaxableYear, amount: Money, share: Decimal) defeasible {
    label en official "share x the credit of the facility (section 45U(c)(2), by section 45(e)(3))";
    when nuclear_facility_owned_by_taxpayer_45u(facility, owner);
    when zero_emission_nuclear_power_production_credit_of_facility_45u(facility, y, amount);
    when ownership_share_of_gross_sales_45(facility, owner, share);
    then credit_of_owner_of_facility_45u(facility, owner, y, round(amount * share, 2, "HALF_UP"));
}
rule CreditOfOwnerWithoutShare45u(facility: Asset, owner: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "no interest asserted: the whole credit of the facility (the single-owner case)";
    when nuclear_facility_owned_by_taxpayer_45u(facility, owner);
    when zero_emission_nuclear_power_production_credit_of_facility_45u(facility, y, amount);
    when not_known(has_gross_sales_share_45(facility, owner));
    then credit_of_owner_of_facility_45u(facility, owner, y, amount);
}

pub relation has_advanced_nuclear_credit_45j(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer has a section 45J credit for the year; bridge for the absence test";
}
rule HasAdvancedNuclearCredit45j(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when advanced_nuclear_power_facility_production_credit(taxpayer, y, amount);
    then has_advanced_nuclear_credit_45j(taxpayer, y);
}
pub relation advanced_nuclear_credit_after_estate_apportionment_45j(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45J credit of the taxpayer after the apportionment between an estate or trust and its beneficiaries (rule similar to section 52(d), by section 45(e)(5)): the credit less the parts apportioned to beneficiaries plus the parts received from estates or trusts; cents HALF_UP";
}
@source(IRC_S45J_F, quote = "Rules similar to the rules of paragraphs (1), (3), (4), and (5) of section 45(e) shall apply for purposes of this section.")
rule AdvancedNuclearCreditAfterApportionmentOwn45j(taxpayer: Person, y: TaxableYear, total: Money) defeasible {
    label en official "own credit less the apportioned parts plus the received parts (section 45J(f), by section 45(e)(5))";
    when advanced_nuclear_power_facility_production_credit(taxpayer, y, total);
    then advanced_nuclear_credit_after_estate_apportionment_45j(taxpayer, y, total
        - sum(collect all x: Money, b: Person, s: Decimal where section_52d_income_allocable_share(taxpayer, b, y, s) and x == round(total * s, 2, "HALF_UP"), empty: 0.00 USD)
        + sum(collect all r: Money, e: Person, s2: Decimal, t: Money where section_52d_income_allocable_share(e, taxpayer, y, s2) and advanced_nuclear_power_facility_production_credit(e, y, t) and r == round(t * s2, 2, "HALF_UP"), empty: 0.00 USD));
}
@source(IRC_S45J_F, quote = "Rules similar to the rules of paragraphs (1), (3), (4), and (5) of section 45(e) shall apply for purposes of this section.")
rule AdvancedNuclearCreditAfterApportionmentReceivedOnly45j(taxpayer: Person, y: TaxableYear, e0: Person, s0: Decimal) defeasible {
    label en official "a beneficiary with no credit of its own receives the apportioned parts (section 45J(f), by section 45(e)(5))";
    when section_52d_income_allocable_share(e0, taxpayer, y, s0);
    when not_known(has_advanced_nuclear_credit_45j(taxpayer, y));
    then advanced_nuclear_credit_after_estate_apportionment_45j(taxpayer, y,
        sum(collect all r: Money, e: Person, s2: Decimal, t: Money where section_52d_income_allocable_share(e, taxpayer, y, s2) and advanced_nuclear_power_facility_production_credit(e, y, t) and r == round(t * s2, 2, "HALF_UP"), empty: 0.00 USD));
}

pub relation has_zero_emission_nuclear_credit_45u(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer has a section 45U credit for the year; bridge for the absence test";
}
rule HasZeroEmissionNuclearCredit45u(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when zero_emission_nuclear_power_production_credit(taxpayer, y, amount);
    then has_zero_emission_nuclear_credit_45u(taxpayer, y);
}
pub relation zero_emission_credit_after_estate_apportionment_45u(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45U credit of the taxpayer after the apportionment between an estate or trust and its beneficiaries (rule similar to section 52(d), by section 45(e)(5)); cents HALF_UP";
}
@source(IRC_S45U_C, quote = "Rules similar to the rules of paragraphs (1), (3), (4), (5), and (13) of section 45(e) shall apply for purposes of this section.")
rule ZeroEmissionCreditAfterApportionmentOwn45u(taxpayer: Person, y: TaxableYear, total: Money) defeasible {
    label en official "own credit less the apportioned parts plus the received parts (section 45U(c)(2), by section 45(e)(5))";
    when zero_emission_nuclear_power_production_credit(taxpayer, y, total);
    then zero_emission_credit_after_estate_apportionment_45u(taxpayer, y, total
        - sum(collect all x: Money, b: Person, s: Decimal where section_52d_income_allocable_share(taxpayer, b, y, s) and x == round(total * s, 2, "HALF_UP"), empty: 0.00 USD)
        + sum(collect all r: Money, e: Person, s2: Decimal, t: Money where section_52d_income_allocable_share(e, taxpayer, y, s2) and zero_emission_nuclear_power_production_credit(e, y, t) and r == round(t * s2, 2, "HALF_UP"), empty: 0.00 USD));
}
@source(IRC_S45U_C, quote = "Rules similar to the rules of paragraphs (1), (3), (4), (5), and (13) of section 45(e) shall apply for purposes of this section.")
rule ZeroEmissionCreditAfterApportionmentReceivedOnly45u(taxpayer: Person, y: TaxableYear, e0: Person, s0: Decimal) defeasible {
    label en official "a beneficiary with no credit of its own receives the apportioned parts (section 45U(c)(2), by section 45(e)(5))";
    when section_52d_income_allocable_share(e0, taxpayer, y, s0);
    when not_known(has_zero_emission_nuclear_credit_45u(taxpayer, y));
    then zero_emission_credit_after_estate_apportionment_45u(taxpayer, y,
        sum(collect all r: Money, e: Person, s2: Decimal, t: Money where section_52d_income_allocable_share(e, taxpayer, y, s2) and zero_emission_nuclear_power_production_credit(e, y, t) and r == round(t * s2, 2, "HALF_UP"), empty: 0.00 USD));
}
