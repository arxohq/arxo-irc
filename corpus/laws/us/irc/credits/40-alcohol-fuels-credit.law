// Section 40 — Alcohol used as fuel. Stage 2d (IRC-06, DECISION-0379).
//
// The alcohol mixture, alcohol and small ethanol producer credits ended with
// sales or uses after 2011-12-31 ((e)(1)); the second generation biofuel
// producer credit of (a)(4) ends with production before 2025-01-01
// ((b)(6)(J), (e)(3)).
//
// Scope / judgment calls:
// * (b)(1)-(3): the alcohol mixture credit and the alcohol credit are per
//   gallon of alcohol of proof at least 150: 60 cents (45 cents for proof from
//   150 to under 190); (h): for ethanol sold or used in calendar years 2001-2011
//   the blender amounts of the table replace 60 (and the low-proof amounts
//   replace 45): 53/39.26 (2001-2002), 52/38.52 (2003-2004), 51/37.78
//   (2005-2008), 45/33.33 (2009-2011) cents. The (h)(3) 51-cent adjustment is
//   not applied (TECH-GAPS G1789).
// * (b)(4): 10 cents per gallon of qualified ethanol fuel production of an
//   eligible small ethanol producer (capacity at most 60,000,000 gallons),
//   production at most 15,000,000 gallons. (b)(6): the second generation
//   biofuel producer credit of $1.01 (less the alcohol and small ethanol
//   credits in effect) for production after 2008-12-31 and before 2025-01-01;
//   registered producer; produced and used in the United States.
// * (d)(3): the tax on separation or non-fuel use; (f): the election not to
//   apply the section, revocable within 3 years of the return due date;
//   (g)(6): cooperative apportionment (a power).
// * The technical tests (qualified mixture, casual off-farm production, second
//   generation feedstocks and limits) are case facts.

use self::{
    Asset,
    IRC_S40_A,
    IRC_S40_B,
    IRC_S40_D,
    IRC_S40_E,
    IRC_S40_F,
    IRC_S40_G,
    IRC_S40_TABLE_1,
    Person,
    TaxableYear,
};

pub relation alcohol_batch_facts_40(batch: Asset, proof: Decimal) kind empirical {
    label en official "the batch of alcohol has this proof, determined without regard to added denaturants (sections 40(b)(3), (d)(1)(B)) — case-asserted";
}
pub relation alcohol_is_ethanol_40(batch: Asset) kind empirical {
    label en official "the alcohol is ethanol (for the section 40(h) blender amounts) — case-asserted";
}
pub relation alcohol_produced_from_petroleum_gas_or_coal_40(batch: Asset) kind empirical {
    label en official "the alcohol is produced from petroleum, natural gas, or coal (including peat) (section 40(d)(1)(A)(i)) — case-asserted";
}
pub relation alcohol_produced_and_used_outside_united_states_40(batch: Asset) kind empirical {
    label en official "the alcohol is produced outside the United States (or a possession) for use as a fuel outside it (section 40(d)(7)) — case-asserted";
}
pub relation batch_sale_or_use_date_40(batch: Asset, on: Date) kind empirical {
    label en official "the date of the sale or use of the alcohol (the calendar year of the (h) table and the (e)(1) end date) — case-asserted";
}
pub relation alcohol_gallons_in_qualified_mixture_40(taxpayer: Person, batch: Asset, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of alcohol used by the taxpayer in the production of a qualified mixture sold or used as a fuel in a trade or business, not casual off-farm production (section 40(b)(1)) — case-asserted";
}
pub relation alcohol_gallons_used_or_sold_at_retail_40(taxpayer: Person, batch: Asset, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of alcohol not in a mixture, used by the taxpayer as a fuel in a trade or business or sold at retail and placed in a vehicle fuel tank (section 40(b)(2)) — case-asserted";
}
pub relation qualified_ethanol_fuel_production_gallons_40(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of qualified ethanol fuel production of the taxpayer for the taxable year (section 40(b)(4)(B), without additional distillation of purchased alcohol) — case-asserted";
}
pub relation productive_capacity_gallons_40(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "the productive capacity for alcohol at all times during the taxable year (section 40(g)(1)) — case-asserted";
}
pub relation second_generation_biofuel_gallons_40(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of qualified second generation biofuel production during the taxable year (section 40(b)(6)(C)) — case-asserted";
}
pub relation second_generation_biofuel_is_alcohol_40(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the second generation biofuel is alcohol, so the (b)(6)(B)(i)-(ii) reductions apply — case-asserted";
}
pub relation second_generation_biofuel_is_ethanol_40(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the second generation biofuel is ethanol, so the (b)(4) small ethanol credit reduction also applies — case-asserted";
}
pub relation second_generation_production_date_40(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "a date on which the second generation biofuel is produced — case-asserted";
}
pub relation registered_second_generation_producer_40(taxpayer: Person) kind empirical {
    label en official "the taxpayer is registered with the Secretary as a producer of second generation biofuel under section 4101 (section 40(b)(6)(I)) — case-asserted";
}
pub relation second_generation_biofuel_meets_tests_40(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the liquid fuel is derived from qualified feedstocks, meets the EPA registration requirements, is not alcohol under proof 150, and meets the water/sediment, ash and acid number limits (section 40(b)(6)(E)-(F)); produced and used in the United States (section 40(d)(6)) — case-asserted";
}

// --- (b)(3), (h): the per-gallon rates ---------------------------------------------------------------------------------------------

pub relation alcohol_credit_rate_cents_40(batch: Asset, cents: Decimal) kind institutional {
    label en official "sections 40(b)(1)-(3), (h): 60 cents (45 cents for proof from 150 to under 190); for ethanol sold or used in 2001-2011 the blender amount of the table (low-proof column under proof 190)";
}
relation alcohol_qualifies_40(batch: Asset) kind institutional;
@source(IRC_S40_D, quote = "alcohol with a proof of less than 150")
rule AlcoholQualifies40Rule(batch: Asset, proof: Decimal) strict {
    when alcohol_batch_facts_40(batch, proof);
    when proof >= 150.0;
    when not_known(alcohol_produced_from_petroleum_gas_or_coal_40(batch));
    when not_known(alcohol_produced_and_used_outside_united_states_40(batch));
    then alcohol_qualifies_40(batch);
}
@source(IRC_S40_B, quote = "The alcohol mixture credit of any taxpayer for any taxable year is 60 cents for each gallon of alcohol used by the taxpayer in the production of a qualified mixture.")
rule AlcoholRateFullProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof >= 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when not_known(alcohol_is_ethanol_40(batch));
    then alcohol_credit_rate_cents_40(batch, 60.0);
}
@source(IRC_S40_B, quote = "In the case of any alcohol with a proof which is at least 150 but less than 190, paragraphs (1)(A) and (2)(A) shall be applied by substituting \"45 cents\" for \"60 cents\".")
rule AlcoholRateLowProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof < 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when not_known(alcohol_is_ethanol_40(batch));
    then alcohol_credit_rate_cents_40(batch, 45.0);
}
@source(IRC_S40_TABLE_1, quote = "2001 or 2002 / 53 cents / 39.26 cents")
rule EthanolRate20012002FullProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof >= 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2001-01-01;
    when on <= @2002-12-31;
    then alcohol_credit_rate_cents_40(batch, 53.0);
}
rule EthanolRate20012002LowProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof < 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2001-01-01;
    when on <= @2002-12-31;
    then alcohol_credit_rate_cents_40(batch, 39.26);
}
@source(IRC_S40_TABLE_1, quote = "2003 or 2004 / 52 cents / 38.52 cents")
rule EthanolRate20032004FullProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof >= 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2003-01-01;
    when on <= @2004-12-31;
    then alcohol_credit_rate_cents_40(batch, 52.0);
}
rule EthanolRate20032004LowProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof < 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2003-01-01;
    when on <= @2004-12-31;
    then alcohol_credit_rate_cents_40(batch, 38.52);
}
@source(IRC_S40_TABLE_1, quote = "2005, 2006, 2007, or 2008 / 51 cents / 37.78 cents")
rule EthanolRate20052008FullProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof >= 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2005-01-01;
    when on <= @2008-12-31;
    then alcohol_credit_rate_cents_40(batch, 51.0);
}
rule EthanolRate20052008LowProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof < 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2005-01-01;
    when on <= @2008-12-31;
    then alcohol_credit_rate_cents_40(batch, 37.78);
}
@source(IRC_S40_TABLE_1, quote = "2009 through 2011 / 45 cents / 33.33 cents")
rule EthanolRate20092011FullProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof >= 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2009-01-01;
    when on <= @2011-12-31;
    then alcohol_credit_rate_cents_40(batch, 45.0);
}
rule EthanolRate20092011LowProof40Rule(batch: Asset, proof: Decimal, on: Date) strict {
    when alcohol_qualifies_40(batch);
    when alcohol_is_ethanol_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof < 190.0;
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2009-01-01;
    when on <= @2011-12-31;
    then alcohol_credit_rate_cents_40(batch, 33.33);
}
pub relation section_40_alcohol_period_40(batch: Asset) kind institutional {
    label en official "section 40(e)(1)(A): the alcohol credits apply to sales and uses through 2011-12-31";
}
@source(IRC_S40_E, quote = "for any period after December 31, 2011")
rule AlcoholPeriod40Rule(batch: Asset, on: Date) strict {
    when batch_sale_or_use_date_40(batch, on);
    when on <= @2011-12-31;
    then section_40_alcohol_period_40(batch);
}

// --- (b)(1), (b)(2): the alcohol mixture and alcohol credits -------------------------------------------------------------------------

pub relation alcohol_mixture_credit_per_batch_40(taxpayer: Person, batch: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(b)(1): the per-gallon amount times the gallons of alcohol used in a qualified mixture";
}
@source(IRC_S40_B, quote = "for each gallon of alcohol used by the taxpayer in the production of a qualified mixture")
rule AlcoholMixtureCreditPerBatch40Rule(taxpayer: Person, batch: Asset, y: TaxableYear, gallons: Decimal, cents: Decimal) defeasible {
    when section_40_alcohol_period_40(batch);
    when alcohol_gallons_in_qualified_mixture_40(taxpayer, batch, y, gallons);
    when alcohol_credit_rate_cents_40(batch, cents);
    then alcohol_mixture_credit_per_batch_40(taxpayer, batch, y, round(div_round(cents, 100.0, 10, "HALF_UP") * gallons, 2, "HALF_UP") * 1 USD);
}
pub relation alcohol_credit_per_batch_40(taxpayer: Person, batch: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(b)(2): the per-gallon amount times the gallons of alcohol not in a mixture used as a fuel or sold at retail";
}
@source(IRC_S40_B, quote = "The alcohol credit of any taxpayer for any taxable year is 60 cents for each gallon of alcohol which is not in a mixture with gasoline or a special fuel")
rule AlcoholCreditPerBatch40Rule(taxpayer: Person, batch: Asset, y: TaxableYear, gallons: Decimal, cents: Decimal) defeasible {
    when section_40_alcohol_period_40(batch);
    when alcohol_gallons_used_or_sold_at_retail_40(taxpayer, batch, y, gallons);
    when alcohol_credit_rate_cents_40(batch, cents);
    then alcohol_credit_per_batch_40(taxpayer, batch, y, round(div_round(cents, 100.0, 10, "HALF_UP") * gallons, 2, "HALF_UP") * 1 USD);
}

// --- (b)(4), (g)(1): the small ethanol producer credit ------------------------------------------------------------------------------------

pub relation eligible_small_ethanol_producer_40(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 40(g)(1): a person whose productive capacity for alcohol at all times during the year is at most 60,000,000 gallons";
}
@source(IRC_S40_G, quote = "not in excess of 60,000,000 gallons")
rule EligibleSmallEthanolProducer40Rule(taxpayer: Person, y: TaxableYear, capacity: Decimal) strict {
    when productive_capacity_gallons_40(taxpayer, y, capacity);
    when capacity <= 60000000.0;
    then eligible_small_ethanol_producer_40(taxpayer, y);
}
pub relation small_ethanol_producer_credit_40(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(b)(4): 10 cents per gallon of qualified ethanol fuel production, at most 15,000,000 gallons";
}
@source(IRC_S40_B, quote = "shall not exceed 15,000,000 gallons")
rule SmallEthanolProducerCredit40Rule(taxpayer: Person, y: TaxableYear, gallons: Decimal) defeasible {
    when eligible_small_ethanol_producer_40(taxpayer, y);
    when qualified_ethanol_fuel_production_gallons_40(taxpayer, y, gallons);
    then small_ethanol_producer_credit_40(taxpayer, y, round(0.10 * min(gallons, 15000000.0), 2, "HALF_UP") * 1 USD);
}

// --- (b)(6): the second generation biofuel producer credit ---------------------------------------------------------------------------------

pub relation second_generation_applicable_amount_40(taxpayer: Person, y: TaxableYear, dollars: Decimal) kind institutional {
    label en official "section 40(b)(6)(B): $1.01, reduced for alcohol by the alcohol credit in effect and, for ethanol, by the small ethanol producer credit";
}
@source(IRC_S40_B, quote = "the applicable amount means $1.01, except that such amount shall, in the case of second generation biofuel which is alcohol, be reduced by the sum of")
rule SecondGenerationAmountNotAlcohol40Rule(taxpayer: Person, y: TaxableYear, gallons: Decimal) strict {
    when second_generation_biofuel_gallons_40(taxpayer, y, gallons);
    when not_known(second_generation_biofuel_is_alcohol_40(taxpayer, y));
    then second_generation_applicable_amount_40(taxpayer, y, 1.01);
}
rule SecondGenerationAmountAlcohol40Rule(taxpayer: Person, y: TaxableYear, gallons: Decimal) strict {
    when second_generation_biofuel_gallons_40(taxpayer, y, gallons);
    when second_generation_biofuel_is_alcohol_40(taxpayer, y);
    when not_known(second_generation_biofuel_is_ethanol_40(taxpayer, y));
    then second_generation_applicable_amount_40(taxpayer, y, 1.01 - 0.60);
}
rule SecondGenerationAmountEthanol40Rule(taxpayer: Person, y: TaxableYear, gallons: Decimal) strict {
    when second_generation_biofuel_gallons_40(taxpayer, y, gallons);
    when second_generation_biofuel_is_ethanol_40(taxpayer, y);
    then second_generation_applicable_amount_40(taxpayer, y, 1.01 - 0.60 - 0.10);
}
pub relation second_generation_biofuel_producer_credit_40(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(b)(6): the applicable amount per gallon of qualified second generation biofuel production produced after 2008-12-31 and before 2025-01-01 by a registered producer";
}
@source(IRC_S40_B, quote = "This paragraph shall apply with respect to qualified second generation biofuel production after December 31, 2008, and before January 1, 2025.")
rule SecondGenerationBiofuelProducerCredit40Rule(taxpayer: Person, y: TaxableYear, gallons: Decimal, dollars: Decimal, on: Date) defeasible {
    when registered_second_generation_producer_40(taxpayer);
    when second_generation_biofuel_meets_tests_40(taxpayer, y);
    when second_generation_production_date_40(taxpayer, y, on);
    when on > @2008-12-31;
    when on < @2025-01-01;
    when second_generation_biofuel_gallons_40(taxpayer, y, gallons);
    when second_generation_applicable_amount_40(taxpayer, y, dollars);
    then second_generation_biofuel_producer_credit_40(taxpayer, y, round(dollars * gallons, 2, "HALF_UP") * 1 USD);
}

// --- (f): election not to apply the section -----------------------------------------------------------------------------------------------------

pub relation elects_out_of_section_40_40(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's exercise of the section 40(f)(1) election to have the section not apply for the taxable year";
}
pub relation election_made_on_40(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the date the election (or its revocation) is made — case-asserted";
}
pub relation return_due_date_without_extensions_40(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the last date prescribed by law for filing the return for the taxable year, without regard to extensions — case-asserted";
}
pub relation election_out_timely_40(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 40(f)(2): the election may be made (or revoked) before the expiration of the 3-year period beginning on the last date for filing the return";
}
@source(IRC_S40_F, quote = "may be made (or revoked) at any time before the expiration of the 3-year period beginning on the last date prescribed by law for filing the return for such taxable year")
rule ElectionOutTimely40Rule(taxpayer: Person, y: TaxableYear, made: Date, due: Date) strict {
    when election_made_on_40(taxpayer, y, made);
    when return_due_date_without_extensions_40(taxpayer, y, due);
    when made < add_calendar_period(due, 36 calendar_month);
    then election_out_timely_40(taxpayer, y);
}
pub relation section_40_does_not_apply_40(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 40(f)(1): the section does not apply to the taxpayer for the taxable year (a valid election)";
}
@source(IRC_S40_F, quote = "A taxpayer may elect to have this section not apply for any taxable year.")
rule ElectOutOfSection40Rule(taxpayer: Person, y: TaxableYear) strict {
    when elects_out_of_section_40_40(taxpayer, y);
    then power Section40FElectOut {
        holder taxpayer;
        over taxpayer;
        exercise elects_out_of_section_40_40(taxpayer, y);
        valid_when election_out_timely_40(taxpayer, y);
        effect create(section_40_does_not_apply_40(taxpayer, y));
        window [@1990-11-05, infinity);
    };
}

// --- (a): the alcohol fuels credit ---------------------------------------------------------------------------------------------------------------------

pub relation alcohol_fuels_credit_before_election_40(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(a): the sum of the alcohol mixture, alcohol, small ethanol producer and second generation biofuel producer credits";
}
@source(IRC_S40_A, quote = "the alcohol fuels credit determined under this section for the taxable year is an amount equal to the sum of")
rule AlcoholFuelsCreditBeforeElection40Rule(taxpayer: Person, y: TaxableYear) defeasible {
    when alcohol_fuels_component_present_40(taxpayer, y);
    then alcohol_fuels_credit_before_election_40(taxpayer, y,
        sum(collect all a: Money, b: Asset where alcohol_mixture_credit_per_batch_40(taxpayer, b, y, a), empty: 0 USD)
        + sum(collect all a2: Money, b2: Asset where alcohol_credit_per_batch_40(taxpayer, b2, y, a2), empty: 0 USD)
        + sum(collect all a3: Money, t3: Person where small_ethanol_producer_credit_40(t3, y, a3) and t3 == taxpayer, empty: 0 USD)
        + sum(collect all a4: Money, t4: Person where second_generation_biofuel_producer_credit_40(t4, y, a4) and t4 == taxpayer, empty: 0 USD));
}
relation alcohol_fuels_component_present_40(taxpayer: Person, y: TaxableYear) kind institutional;
rule ComponentPresentMixture40Rule(taxpayer: Person, y: TaxableYear, b: Asset, a: Money) defeasible {
    when alcohol_mixture_credit_per_batch_40(taxpayer, b, y, a);
    then alcohol_fuels_component_present_40(taxpayer, y);
}
rule ComponentPresentAlcohol40Rule(taxpayer: Person, y: TaxableYear, b: Asset, a: Money) defeasible {
    when alcohol_credit_per_batch_40(taxpayer, b, y, a);
    then alcohol_fuels_component_present_40(taxpayer, y);
}
rule ComponentPresentSmallEthanol40Rule(taxpayer: Person, y: TaxableYear, a: Money) defeasible {
    when small_ethanol_producer_credit_40(taxpayer, y, a);
    then alcohol_fuels_component_present_40(taxpayer, y);
}
rule ComponentPresentSecondGeneration40Rule(taxpayer: Person, y: TaxableYear, a: Money) defeasible {
    when second_generation_biofuel_producer_credit_40(taxpayer, y, a);
    then alcohol_fuels_component_present_40(taxpayer, y);
}
pub relation alcohol_fuels_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 40 alcohol fuels credit for the taxable year (a section 38(b)(3) component), unless the taxpayer has validly elected out";
}
rule AlcoholFuelsCredit40Rule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when alcohol_fuels_credit_before_election_40(taxpayer, y, amount);
    when not_known(section_40_does_not_apply_40(taxpayer, y));
    then alcohol_fuels_credit(taxpayer, y, amount);
}

// --- (d)(3): the tax on separation and use other than as a fuel -----------------------------------------------------------------------------------

pub relation alcohol_separated_or_misused_40(person: Person, batch: Asset, gallons: Decimal) kind empirical {
    label en official "a person separates alcohol from a mixture, or uses the mixture (or alcohol sold at retail) other than as a fuel, for a batch on which a credit was determined (section 40(d)(3)(A)-(B)) — case-asserted, with the gallons of alcohol";
}
pub relation credit_determined_for_batch_40(batch: Asset) kind empirical {
    label en official "a credit was determined under this section for the alcohol in the batch (sections 40(d)(3)(A)(i), (B)(i)) — case-asserted";
}
pub relation misuse_tax_40(person: Person, batch: Asset, amount: Money) kind institutional {
    label en official "section 40(d)(3): a tax of 60 cents (45 cents for alcohol of proof under 190) per gallon of the alcohol";
}
@source(IRC_S40_D, quote = "then there is hereby imposed on such person a tax equal to 60 cents a gallon (45 cents in the case of alcohol with a proof less than 190) for each gallon of alcohol in such mixture")
rule MisuseTaxFullProof40Rule(person: Person, batch: Asset, gallons: Decimal, proof: Decimal) defeasible {
    when alcohol_separated_or_misused_40(person, batch, gallons);
    when credit_determined_for_batch_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof >= 190.0;
    then misuse_tax_40(person, batch, round(0.60 * gallons, 2, "HALF_UP") * 1 USD);
}
rule MisuseTaxLowProof40Rule(person: Person, batch: Asset, gallons: Decimal, proof: Decimal) defeasible {
    when alcohol_separated_or_misused_40(person, batch, gallons);
    when credit_determined_for_batch_40(batch);
    when alcohol_batch_facts_40(batch, proof);
    when proof < 190.0;
    then misuse_tax_40(person, batch, round(0.45 * gallons, 2, "HALF_UP") * 1 USD);
}
