// Section 26 — Limitation based on tax liability; definition of tax
// liability. Stage 1 (IRC-06 stage 1).
//
// §26(b)(2) lists TWENTY-FIVE Code sections (A-Z, less repealed (P)) whose
// tax is carved OUT of "regular tax liability" for this Part's limitation.
// Each carve-out is a computation belonging to the SECTION IT NAMES (e.g.
// section 55 additional tax owned by whichever package formalizes the
// alternative minimum tax), not to this package's arithmetic — modelled here
// as one generic dependency-contract relation the owner packages populate,
// rather than 25 separate near-duplicate relations. This is a documented
// judgment call (see report), consistent with the s62-agi.law/administration
// idiom of not re-deriving another owner's computation.

use self::{
    IRC_S26_A,
    IRC_S26_B,
    IRC_S26_C,
    Individual,
    TaxableYear,
};

pub relation regular_tax_liability(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "regular tax liability for purposes of this part (section 26(b))";
}
relation tax_imposed_by_chapter_1(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by chapter 1 for the taxable year (section 26(b)(1)) — read from income_individual's rate-schedule computation";
}
relation section_26b2_carveout_amount(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate of the taxes described in section 26(b)(2)(A)-(Z) (other than repealed (P)) included within the chapter 1 tax figure above and therefore excluded from regular tax liability — dependency contract; each owner package (AMT/BEAT/accumulated-earnings/personal-holding-company/S-corp built-in-gains/branch-profits/etc.) is a separate, not-yet-consolidated producer";
}
@source(IRC_S26_B, quote = "The term \"regular tax liability\" means the tax imposed by this chapter for the taxable year")
rule RegularTaxLiability(taxpayer: Individual, y: TaxableYear, chapter1: Money, carveouts: Money) strict {
    label en official "regular tax liability is the chapter 1 tax minus the section 26(b)(2) carve-outs";
    when tax_imposed_by_chapter_1(taxpayer, y, chapter1);
    when section_26b2_carveout_amount(taxpayer, y, carveouts);
    then regular_tax_liability(taxpayer, y, max(0 USD, chapter1 - carveouts));
}

pub relation tentative_minimum_tax_26c(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "tentative minimum tax (section 26(c)): the amount determined under section 55(b)(1) — read from income_individual's individual view of the alternative minimum tax (DECISIONS Д-13); a fact of the case remains a valid channel";
}
// Section 26(c): the tentative minimum tax is the amount determined under
// section 55(b)(1), which `us.irc.income_individual` computes. The bridge
// relation has a DISTINCT name and an `Individual` first argument, so this
// package no longer shadows the public `tentative_minimum_tax(Person, ...)`
// (LDC-W2101); nothing is recomputed here.
@source(IRC_S26_C, relation = formalizes, coverage = partial, quote = "the term \"tentative minimum tax\" means the amount determined under section 55(b)(1)")
rule TentativeMinimumTax26cFromSection55(taxpayer: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 26(c): the tentative minimum tax is the section 55(b)(1) amount, read from the alternative minimum tax owner";
    when us.irc.income_individual::tentative_minimum_tax_of_individual(taxpayer, y, amount);
    then tentative_minimum_tax_26c(taxpayer, y, amount);
}

relation foreign_tax_credit_27(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the foreign tax credit allowable under section 27 — dependency contract, producer: international (pending)";
}
relation section_55a_tax_26a(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by section 55(a) for the taxable year — read from income_individual's individual view of the alternative minimum tax (DECISIONS Д-13); a fact of the case remains a valid channel";
}
@source(IRC_S26_A, relation = formalizes, coverage = partial, quote = "the tax imposed by section 55(a) for the taxable year")
rule Section55aTax26aFromSection55(taxpayer: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 26(a)(2): the section 55(a) tax is read from the alternative minimum tax owner";
    when us.irc.income_individual::section_55a_tax_of_individual(taxpayer, y, amount);
    then section_55a_tax_26a(taxpayer, y, amount);
}

pub relation section_26a_limitation(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 26(a) limitation on the aggregate amount of nonrefundable personal credits allowed by subpart A";
}
@source(IRC_S26_A, quote = "the sum of—")
rule Section26aLimitation(taxpayer: Individual, y: TaxableYear, regular: Money, ftc: Money, amt: Money) strict {
    label en official "the limitation is regular tax liability minus the foreign tax credit, plus the section 55(a) tax";
    when regular_tax_liability(taxpayer, y, regular);
    when foreign_tax_credit_27(taxpayer, y, ftc);
    when section_55a_tax_26a(taxpayer, y, amt);
    then section_26a_limitation(taxpayer, y, max(0 USD, regular - ftc) + amt);
}

// --- Ordering and aggregation of subpart A nonrefundable credits ---------------
//
// §26(a) itself does not prescribe an ORDER among the subpart A credits; the
// carryforward provisions of §§23(c)(1)/25(e)(1)(C) read "the limitation ...
// reduced by the sum of the credits allowable under this subpart (other
// than this section and [named exclusions])" — i.e., every OTHER subpart A
// credit is treated as absorbing the limitation first, before the
// carryforward-eligible credit's own current-year amount is tested. This
// package therefore computes the ordering-sensitive "applicable tax limit"
// relations of §§23(c)(1)(C)/25(e)(1)(C) directly (see those modules) rather
// than adding a third generic ordering relation here; a single canonical
// non-refundable total (below) is exposed for consumers that do not need the
// ordering detail.

// `nonrefundable_credits_total` (the section 26(a)-LIMITED amount) and
// `nonrefundable_personal_credits_total` (the pre-limitation sum) are
// declared in credits-totals.law, which reads `section_26a_limitation`
// above.
