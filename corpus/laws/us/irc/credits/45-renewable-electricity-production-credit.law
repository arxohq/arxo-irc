// Section 45 — Electricity produced from certain renewable resources.
// Stage 2c (IRC-06 stage 2c, DECISION-0379). Priority list item: §45(a)-(b)
// (1.5 cents/kWh indexed -> SOURCE_GAP, 10-year period, prevailing wage/
// apprenticeship 5x, domestic content/energy community 10% bonuses, PL
// terminations).
//
// CORRECTION to the task's own framing: section 45(b) has TEN paragraphs
// ((1) phaseout, (2) inflation adjustment, (3) tax-exempt-bond reduction,
// (4) special credit rate/period, (5) wind phaseout, (6) the 5x increased-
// credit-amount multiplier, (7) prevailing wage, (8) apprenticeship, (9)
// domestic content bonus, (10) elective-payment phaseout) — there is NO
// separate "energy community" bonus paragraph in section 45 itself
// (confirmed by grepping this package's own pinned text for every "(N)
// <Heading>" caption in the (b) fragment). The energy-community bonus the
// task's own framing expects exists in sections 45Y/48/48E instead (a
// separate module, not this one) — not silently absorbed into this
// module's (b)(9), which is a plain 10-percent domestic-content bonus.
//
// Judgment calls / scope:
// * The "0.3 cents" base rate in (a)(1) is itself indexed by (b)(2)'s
//   inflation-adjustment-factor mechanism — the resulting CURRENT per-kWh
//   rate (commonly ~1.5-3 cents depending on year, after the (b)(6) 5x
//   multiplier) is published annually by IRS NOTICE, not by the Revenue
//   Procedures pinned in `us.irc.inflation_adjustments` (grepped, confirmed
//   absent — those Rev. Procs cover section 1(f)(3)-indexed DOLLAR
//   thresholds, not this credit's own separate per-kWh inflation-
//   adjustment-factor mechanism under (b)(2)). `indexed_rate_per_kwh_cents_45`
//   is therefore a case-asserted dependency contract — SOURCE_GAP,
//   TECH-GAPS G391 — rather than a fabricated "1.5 cents" literal.
// * The (a)(2)(A)(ii) 10-year period IS derived from a genuine date
//   computation (`add_calendar_period`), not a case-asserted flag, per the
//   coordinator's explicit instruction.
// * (b)(1) (phaseout by reference price) is modelled exactly as its own
//   ratio formula; the reference price itself (`reference_price_45`,
//   published by the Secretary under (c)(8)) is a case-asserted input.
// * (b)(2) (the inflation-adjustment mechanism ITSELF, including the
//   0.05-cent/0.1-cent rounding rules) is NOT derived — the ALREADY-
//   indexed rate is read directly as the case-asserted input, per the
//   point above.
// * (b)(3) (tax-exempt-bond reduction), (b)(4) (special credit rate/period
//   for open-loop biomass/geothermal/etc. facilities), (b)(5) (wind
//   phaseout, a historical, now-inoperative provision for pre-2013
//   facilities) are NOT modelled — TECH_GAP.
// * (b)(6)-(8) (the 5x multiplier and its prevailing-wage/apprenticeship
//   gates) ARE modelled: the wage-rate comparison and the apprenticeship-
//   labor-hour test are read as case-asserted SATISFACTION facts (the
//   underlying Department of Labor wage determination and the (8)(A)
//   apprentice-hour-ratio arithmetic are EXTERNAL_DEPENDENCY/TECH_GAP), but
//   the multiplier logic itself — 5x if EITHER wage+apprenticeship are
//   satisfied OR the facility qualifies for the (6)(B)(i)/(ii) small-
//   facility/pre-guidance exemptions — is executable.
// * (b)(9) (domestic content bonus, 10 percent) is modelled exactly as a
//   gated 10-percent increase; the certification and the 40%/20%-cost-
//   ratio test underneath it are case-asserted.
// * (b)(10) (elective payment under section 6417 phaseout) and (c)
//   (qualified facility/energy resource DEFINITIONS, including the section
//   6417/48(c)/etc. cross-references) are NOT modelled — TECH_GAP.
// * PL 119-21 terminations for various section 45(d) facility types are
//   NOT modelled in THIS module (they attach to the (d) facility-type
//   definitions this pass does not reach) — see the credits-family-wide
//   note in the 45y-48e module below for the PARALLEL provision
//   (`us.irc.temporal::PL119_21_S70512`) that DOES apply cleanly to section
//   45Y, the successor credit most post-2024 facilities actually use.

use self::{
    Asset,
    IRC_S45_A,
    IRC_S45_B,
    TaxableYear,
};

pub relation qualified_energy_resources_electricity_produced(facility: Asset, y: TaxableYear, kwh: Decimal) kind empirical {
    label en official "kilowatt hours of electricity produced by the taxpayer from qualified energy resources at a qualified facility (section 45(a)(2)(A)(i)) — case-asserted";
}
pub relation electricity_sold_to_unrelated_person_45(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the electricity was sold by the taxpayer to an unrelated person during the taxable year (section 45(a)(2)(B)) — case-asserted";
}
pub relation facility_placed_in_service_date_45(facility: Asset, on: Date) kind empirical {
    label en official "the date the qualified facility was originally placed in service, anchoring the section 45(a)(2)(A)(ii) 10-year credit period — case-asserted";
}
pub relation electricity_sale_date_45(facility: Asset, y: TaxableYear, on: Date) kind empirical {
    label en official "a representative date within the taxable year on which the electricity described was sold, for testing the section 45(a)(2)(A)(ii) 10-year period — case-asserted";
}
pub relation within_10_year_period_45(facility: Asset, y: TaxableYear) kind institutional {
    label en official "the sale occurred during the 10-year period beginning on the date the facility was originally placed in service (section 45(a)(2)(A)(ii))";
}
@source(IRC_S45_A, quote = "at a qualified facility during the 10-year period beginning on the date the facility was originally placed in service")
rule Within10YearPeriod45Rule(facility: Asset, y: TaxableYear, placed_on: Date, sold_on: Date) strict {
    when facility_placed_in_service_date_45(facility, placed_on);
    when electricity_sale_date_45(facility, y, sold_on);
    when sold_on < add_calendar_period(placed_on, 10 calendar_year);
    then within_10_year_period_45(facility, y);
}

pub relation indexed_rate_per_kwh_cents_45(y: TaxableYear, cents: Decimal) kind empirical {
    label en official "the section 45(a)(1)/(b)(2) inflation-adjusted per-kilowatt-hour rate (cents), before the section 45(b)(6) multiplier — EXTERNAL_DEPENDENCY/SOURCE_GAP: published annually by IRS Notice, not by a Revenue Procedure pinned in us.irc.inflation_adjustments";
}
pub relation reference_price_45(y: TaxableYear, cents: Decimal) kind empirical {
    label en official "the reference price for the calendar year (section 45(c)(8)), for the section 45(b)(1) phaseout — case-asserted";
}
pub relation phaseout_ratio_45(y: TaxableYear, ratio: Decimal) kind institutional {
    label en official "section 45(b)(1): the ratio by which the credit is reduced, when the reference price exceeds 8 cents";
}
relation has_phaseout_ratio_45(y: TaxableYear) kind institutional;
rule HasPhaseoutRatio45Rule(y: TaxableYear, ratio: Decimal) strict {
    when phaseout_ratio_45(y, ratio);
    then has_phaseout_ratio_45(y);
}
@source(IRC_S45_B, quote = "the amount by which the reference price for the calendar year in which the sale occurs exceeds 8 cents, bears to\n(B) 3 cents")
rule PhaseoutRatio45Rule(y: TaxableYear, price: Decimal) strict {
    when reference_price_45(y, price);
    when price > 8.0;
    then phaseout_ratio_45(y, div_round(price - 8.0, 3.0, 10, "HALF_UP"));
}

pub relation credit_before_45b3_reduction_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45(a) product after the section 45(b)(1) phaseout, before the section 45(b)(3) tax-exempt-bond reduction (stage 3 split; the reduction step is in s3-b-45b-cure-and-reduction-rules.law)";
}
pub relation credit_before_bonuses_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45(a) product (rate x kWh) reduced by the section 45(b)(1) phaseout ratio, before the section 45(b)(6)-(9) bonuses/multiplier";
}
@source(IRC_S45_A, quote = "0.3 cents, multiplied by\n(2) the kilowatt hours of electricity")
rule CreditBeforeBonusesWithPhaseoutRule(facility: Asset, y: TaxableYear, rate: Decimal, kwh: Decimal, ratio: Decimal) strict {
    when electricity_sold_to_unrelated_person_45(facility, y);
    when within_10_year_period_45(facility, y);
    when qualified_energy_resources_electricity_produced(facility, y, kwh);
    when indexed_rate_per_kwh_cents_45(y, rate);
    when phaseout_ratio_45(y, ratio);
    then credit_before_45b3_reduction_45(facility, y, round((rate / 100.0) * kwh * (1.0 - ratio), 2, "HALF_UP"));
}
@source(IRC_S45_A, quote = "0.3 cents, multiplied by\n(2) the kilowatt hours of electricity")
rule CreditBeforeBonusesNoPhaseoutRule(facility: Asset, y: TaxableYear, rate: Decimal, kwh: Decimal) strict {
    when electricity_sold_to_unrelated_person_45(facility, y);
    when within_10_year_period_45(facility, y);
    when qualified_energy_resources_electricity_produced(facility, y, kwh);
    when indexed_rate_per_kwh_cents_45(y, rate);
    when not_known(has_phaseout_ratio_45(y));
    then credit_before_45b3_reduction_45(facility, y, round((rate / 100.0) * kwh, 2, "HALF_UP"));
}

// --- §45(b)(6)-(8): the 5x increased-credit-amount multiplier -----------------

pub relation qualified_facility_under_1mw_45(facility: Asset) kind empirical {
    label en official "the facility has a maximum net output of less than 1 megawatt AC (section 45(b)(6)(B)(i)) — case-asserted";
}
pub relation qualified_facility_construction_before_guidance_45(facility: Asset) kind empirical {
    label en official "construction of the facility began before the 60-day-after-guidance date (section 45(b)(6)(B)(ii)) — case-asserted";
}
pub relation prevailing_wage_requirement_satisfied_45(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the section 45(b)(7)(A) prevailing-wage requirement is satisfied for the taxable year (including the correction-and-penalty cure of (b)(7)(B)) — case-asserted, EXTERNAL_DEPENDENCY on Department of Labor wage determinations";
}
pub relation apprenticeship_requirement_satisfied_45(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the section 45(b)(8) apprenticeship requirement is satisfied for the taxable year — case-asserted";
}
pub relation qualified_facility_meets_6b_requirements_45(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45(b)(6)(B): the facility meets one of the three qualifying conditions for the 5x multiplier";
}
rule QualifiedFacilityMeets6bSmallFacilityRule(facility: Asset, y: TaxableYear) defeasible {
    when credit_before_bonuses_45(facility, y, _);
    when qualified_facility_under_1mw_45(facility);
    then qualified_facility_meets_6b_requirements_45(facility, y);
}
rule QualifiedFacilityMeets6bPreGuidanceRule(facility: Asset, y: TaxableYear) defeasible {
    when credit_before_bonuses_45(facility, y, _);
    when qualified_facility_construction_before_guidance_45(facility);
    then qualified_facility_meets_6b_requirements_45(facility, y);
}
rule QualifiedFacilityMeets6bWageApprenticeshipRule(facility: Asset, y: TaxableYear) defeasible {
    when prevailing_wage_requirement_satisfied_45(facility, y);
    when apprenticeship_requirement_satisfied_45(facility, y);
    then qualified_facility_meets_6b_requirements_45(facility, y);
}
pub relation credit_after_6_multiplier_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45(b)(6)(A): the credit multiplied by 5 for a qualifying facility";
}
@source(IRC_S45_B, quote = "the amount of the credit determined under subsection (a) (determined after the application of paragraphs (1) through (5) and without regard to this paragraph) shall be equal to such amount multiplied by 5")
rule CreditAfter6Multiplier45Rule(facility: Asset, y: TaxableYear, before: Money) defeasible {
    when credit_before_bonuses_45(facility, y, before);
    when qualified_facility_meets_6b_requirements_45(facility, y);
    then credit_after_6_multiplier_45(facility, y, before * 5.0);
}
rule CreditAfter6MultiplierAbsentRule(facility: Asset, y: TaxableYear, before: Money) defeasible {
    when credit_before_bonuses_45(facility, y, before);
    when not_known(qualified_facility_meets_6b_requirements_45(facility, y));
    then credit_after_6_multiplier_45(facility, y, before);
}

// --- §45(b)(9): domestic content bonus (10 percent) -----------------------------

pub relation domestic_content_requirement_satisfied_45(facility: Asset) kind empirical {
    label en official "section 45(b)(9)(B): the taxpayer certifies the facility's steel/iron/manufactured-product domestic-content requirement — case-asserted, EXTERNAL_DEPENDENCY on the underlying 40%/20% cost-ratio test";
}
pub relation renewable_electricity_production_credit(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45 renewable electricity production credit for the taxable year, including the section 45(b)(9) 10-percent domestic content bonus where satisfied";
}
@source(IRC_S45_B, quote = "the amount of the credit determined under subsection (a) (determined after the application of paragraphs (1) through (8)) shall be increased by an amount equal to 10 percent of the amount so determined")
rule RenewableElectricityProductionCreditWithBonusRule(facility: Asset, y: TaxableYear, after_multiplier: Money) defeasible {
    when credit_after_6_multiplier_45(facility, y, after_multiplier);
    when domestic_content_requirement_satisfied_45(facility);
    then renewable_electricity_production_credit(facility, y, round(after_multiplier * 1.10, 2, "HALF_UP"));
}
rule RenewableElectricityProductionCreditNoBonusRule(facility: Asset, y: TaxableYear, after_multiplier: Money) defeasible {
    when credit_after_6_multiplier_45(facility, y, after_multiplier);
    when not_known(domestic_content_requirement_satisfied_45(facility));
    then renewable_electricity_production_credit(facility, y, after_multiplier);
}
