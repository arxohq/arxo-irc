// Section 25D — the (c) carryover, the (d) definitions of the residential clean energy property expenditures, the (e) special rules (labor
// and interconnection, roofs, storage media, joint occupancy of fuel cell property, tenant-stockholders, condominium associations, business
// use, the time of the expenditure) and the (f) basis rule. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of
// TECH-GAPS G391). Companion of `25d-residential-clean-energy-credit.law`; its credit rules read the expenditure amounts by item as case
// facts and are NOT rewired to require these relations.
//
// Judgment calls: the Energy Star, section 48(c)(1) and section 121 meanings are case facts about the item; amounts are cents HALF_UP;
// the carryover of (c) reads the existing credit relation and the asserted section 26(a) limitation.

use self::{
    Asset,
    IRC_S25D_C,
    IRC_S25D_D,
    IRC_S25D_E,
    IRC_S25D_F,
    Individual,
    Person,
    TaxableYear,
    VehicleKind30B,
    residential_clean_energy_credit,
};

pub enum PropertyKind25D { SolarWaterHeating, SolarElectric, FuelCell, SmallWind, GeothermalHeatPump, BatteryStorage }

// --- (d): the qualified expenditures ---------------------------------------------------------------------------------------------------------------------------

pub relation property_kind_25d(prop: Asset, kind: PropertyKind25D) kind empirical {
    label en official "the kind of the residential clean energy property (section 25D(d)) — case-asserted";
}
pub relation installed_in_us_dwelling_used_as_residence_25d(taxpayer: Individual, prop: Asset) kind empirical {
    label en official "the property is installed on or in connection with a dwelling unit located in the United States and used as a residence by the taxpayer (section 25D(d)) — case-asserted";
}
pub relation installed_in_us_dwelling_used_as_principal_residence_25d(taxpayer: Individual, prop: Asset) kind empirical {
    label en official "the property is installed on or in connection with a dwelling unit located in the United States and used as a principal residence (section 121) by the taxpayer (section 25D(d)(3)) — case-asserted";
}
pub relation energy_share_derived_from_sun_25d(prop: Asset, share: Decimal) kind empirical {
    label en official "the share, as a fraction, of the energy used by the property to heat water that is derived from the sun (section 25D(d)(1)) — case-asserted";
}
pub relation uses_solar_energy_to_generate_electricity_for_dwelling_25d(prop: Asset) kind empirical {
    label en official "the property uses solar energy to generate electricity for use in the dwelling unit (section 25D(d)(2)) — case-asserted";
}
pub relation fuel_cell_property_meets_48c1_25d(prop: Asset) kind empirical {
    label en official "the property is qualified fuel cell property as defined in section 48(c)(1), without regard to subparagraph (D) thereof (section 25D(d)(3)) — case-asserted";
}
pub relation uses_wind_turbine_to_generate_electricity_for_dwelling_25d(prop: Asset) kind empirical {
    label en official "the property uses a wind turbine to generate electricity for use in connection with the dwelling unit (section 25D(d)(4)) — case-asserted";
}
pub relation uses_ground_or_ground_water_as_thermal_source_or_sink_25d(prop: Asset) kind empirical {
    label en official "the equipment uses the ground or ground water as a thermal energy source to heat the dwelling unit or as a thermal energy sink to cool it (section 25D(d)(5)(B)(i)) — case-asserted";
}
pub relation meets_energy_star_in_effect_when_expenditure_made_25d(prop: Asset) kind empirical {
    label en official "the equipment meets the requirements of the Energy Star program in effect at the time the expenditure is made (section 25D(d)(5)(B)(ii)) — case-asserted";
}
pub relation battery_capacity_kilowatt_hours_25d(prop: Asset, kwh: Decimal) kind empirical {
    label en official "the capacity of the battery storage technology in kilowatt hours (section 25D(d)(6)(B)) — case-asserted";
}
pub relation expenditure_for_property_25d(taxpayer: Individual, prop: Asset, amount: Money) kind empirical {
    label en official "the amount of the expenditure made by the taxpayer for the property itself — case-asserted";
}
pub relation qualified_expenditure_25d(taxpayer: Individual, prop: Asset, kind: PropertyKind25D, amount: Money) kind institutional {
    label en official "section 25D(d): an expenditure for solar water heating property (at least half solar energy), solar electric property, qualified fuel cell property, small wind energy property, geothermal heat pump property meeting Energy Star, or battery storage technology of at least 3 kilowatt hours, for the taxpayer's US residence";
}
@source(IRC_S25D_D, relation = formalizes, coverage = exact, quote = "if at least half of the energy used by such property for such purpose is derived from the sun")
rule QualifiedSolarWaterHeatingExpenditure25dRule(taxpayer: Individual, prop: Asset, amount: Money, share: Decimal) strict {
    when property_kind_25d(prop, SolarWaterHeating);
    when installed_in_us_dwelling_used_as_residence_25d(taxpayer, prop);
    when energy_share_derived_from_sun_25d(prop, share);
    when share >= 0.50;
    when expenditure_for_property_25d(taxpayer, prop, amount);
    then qualified_expenditure_25d(taxpayer, prop, SolarWaterHeating, amount);
}
@source(IRC_S25D_D, relation = formalizes, coverage = exact, quote = "means an expenditure for property which uses solar energy to generate electricity for use in a dwelling unit located in the United States and used as a residence by the taxpayer")
rule QualifiedSolarElectricExpenditure25dRule(taxpayer: Individual, prop: Asset, amount: Money) strict {
    when property_kind_25d(prop, SolarElectric);
    when installed_in_us_dwelling_used_as_residence_25d(taxpayer, prop);
    when uses_solar_energy_to_generate_electricity_for_dwelling_25d(prop);
    when expenditure_for_property_25d(taxpayer, prop, amount);
    then qualified_expenditure_25d(taxpayer, prop, SolarElectric, amount);
}
@source(IRC_S25D_D, relation = formalizes, coverage = exact, quote = "means an expenditure for qualified fuel cell property (as defined in section 48(c)(1), without regard to subparagraph (D) thereof)")
rule QualifiedFuelCellExpenditure25dRule(taxpayer: Individual, prop: Asset, amount: Money) strict {
    when property_kind_25d(prop, FuelCell);
    when installed_in_us_dwelling_used_as_principal_residence_25d(taxpayer, prop);
    when fuel_cell_property_meets_48c1_25d(prop);
    when expenditure_for_property_25d(taxpayer, prop, amount);
    then qualified_expenditure_25d(taxpayer, prop, FuelCell, amount);
}
@source(IRC_S25D_D, relation = formalizes, coverage = exact, quote = "means an expenditure for property which uses a wind turbine to generate electricity for use in connection with a dwelling unit located in the United States and used as a residence by the taxpayer")
rule QualifiedSmallWindExpenditure25dRule(taxpayer: Individual, prop: Asset, amount: Money) strict {
    when property_kind_25d(prop, SmallWind);
    when installed_in_us_dwelling_used_as_residence_25d(taxpayer, prop);
    when uses_wind_turbine_to_generate_electricity_for_dwelling_25d(prop);
    when expenditure_for_property_25d(taxpayer, prop, amount);
    then qualified_expenditure_25d(taxpayer, prop, SmallWind, amount);
}
@source(IRC_S25D_D, relation = formalizes, coverage = exact, quote = "meets the requirements of the Energy Star program which are in effect at the time that the expenditure for such equipment is made")
rule QualifiedGeothermalExpenditure25dRule(taxpayer: Individual, prop: Asset, amount: Money) strict {
    when property_kind_25d(prop, GeothermalHeatPump);
    when installed_in_us_dwelling_used_as_residence_25d(taxpayer, prop);
    when uses_ground_or_ground_water_as_thermal_source_or_sink_25d(prop);
    when meets_energy_star_in_effect_when_expenditure_made_25d(prop);
    when expenditure_for_property_25d(taxpayer, prop, amount);
    then qualified_expenditure_25d(taxpayer, prop, GeothermalHeatPump, amount);
}
@source(IRC_S25D_D, relation = formalizes, coverage = exact, quote = "has a capacity of not less than 3 kilowatt hours")
rule QualifiedBatteryStorageExpenditure25dRule(taxpayer: Individual, prop: Asset, amount: Money, kwh: Decimal) strict {
    when property_kind_25d(prop, BatteryStorage);
    when installed_in_us_dwelling_used_as_residence_25d(taxpayer, prop);
    when battery_capacity_kilowatt_hours_25d(prop, kwh);
    when kwh >= 3.0;
    when expenditure_for_property_25d(taxpayer, prop, amount);
    then qualified_expenditure_25d(taxpayer, prop, BatteryStorage, amount);
}

// --- (e)(1)-(3): labor, roofs, storage media -------------------------------------------------------------------------------------------------------------------

pub relation onsite_labor_25d(taxpayer: Individual, prop: Asset, amount: Money) kind empirical {
    label en official "the labor costs properly allocable to the onsite preparation, assembly, or original installation of the property — case-asserted";
}
pub relation interconnection_piping_or_wiring_25d(taxpayer: Individual, prop: Asset, amount: Money) kind empirical {
    label en official "the expenditure for piping or wiring to interconnect the property to the dwelling unit — case-asserted";
}
pub relation allocable_to_pool_hot_tub_or_storage_medium_25d(taxpayer: Individual, prop: Asset, amount: Money) kind empirical {
    label en official "the part of the expenditure properly allocable to a swimming pool, hot tub, or any other energy storage medium with a function other than storage (section 25D(e)(3)) — case-asserted";
}
pub relation expenditure_with_labor_and_interconnection_25d(taxpayer: Individual, prop: Asset, amount: Money) kind institutional {
    label en official "section 25D(e)(1), (3): the expenditure includes labor costs and piping or wiring for interconnection, and excludes the part allocable to a swimming pool, hot tub or other energy storage medium with another function (not below zero)";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "Expenditures for labor costs properly allocable to the onsite preparation, assembly, or original installation of the property described in subsection (d) and for piping or wiring to interconnect such property to the dwelling unit shall be taken into account for purposes of this section.")
rule ExpenditureWithLaborAndInterconnection25dRule(taxpayer: Individual, prop: Asset, kind: PropertyKind25D, base: Money, labor: Money, wiring: Money, pool: Money) strict {
    when qualified_expenditure_25d(taxpayer, prop, kind, base);
    when onsite_labor_25d(taxpayer, prop, labor);
    when interconnection_piping_or_wiring_25d(taxpayer, prop, wiring);
    when allocable_to_pool_hot_tub_or_storage_medium_25d(taxpayer, prop, pool);
    then expenditure_with_labor_and_interconnection_25d(taxpayer, prop, max(base + labor + wiring - pool, 0 USD));
}
pub relation installed_as_roof_or_portion_25d(prop: Asset) kind empirical {
    label en official "the solar panel or other property is installed as a roof (or portion thereof) (section 25D(e)(2)) — case-asserted";
}
pub relation constitutes_structural_component_25d(prop: Asset) kind empirical {
    label en official "the property constitutes a structural component of the structure on which it is installed (section 25D(e)(2)) — case-asserted";
}
pub relation roof_property_not_disqualified_25d(prop: Asset) kind institutional {
    label en official "section 25D(e)(2): no expenditure for a solar panel or other property installed as a roof fails to be property of paragraph (1) or (2) of subsection (d) solely because it is a structural component of the structure";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "shall fail to be treated as property described in paragraph (1) or (2) of subsection (d) solely because it constitutes a structural component of the structure on which it is installed")
rule RoofPropertyNotDisqualified25dRule(prop: Asset) strict {
    when installed_as_roof_or_portion_25d(prop);
    when constitutes_structural_component_25d(prop);
    then roof_property_not_disqualified_25d(prop);
}

// --- (e)(4): joint occupancy of fuel cell property ------------------------------------------------------------------------------------------------------------

pub relation dwelling_jointly_occupied_by_two_or_more_25d(dwelling: Asset, calendar_year: Decimal) kind empirical {
    label en official "the dwelling unit is jointly occupied and used during the calendar year as a residence by two or more individuals (section 25D(e)(4)) — case-asserted";
}
pub relation fuel_cell_capacity_half_kw_units_25d(dwelling: Asset, calendar_year: Decimal, units: Decimal) kind empirical {
    label en official "the capacity of the qualified fuel cell property of the dwelling in units of a half kilowatt — case-asserted";
}
pub relation fuel_cell_joint_maximum_25d(dwelling: Asset, calendar_year: Decimal, amount: Money) kind institutional {
    label en official "section 25D(e)(4)(A): the maximum amount of expenditures taken into account by all the individuals for the dwelling in the calendar year is $1,667 per half kilowatt of capacity";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "shall be $1,667 in the case of each half kilowatt of capacity of qualified fuel cell property")
rule FuelCellJointMaximum25dRule(dwelling: Asset, calendar_year: Decimal, units: Decimal) strict {
    when dwelling_jointly_occupied_by_two_or_more_25d(dwelling, calendar_year);
    when fuel_cell_capacity_half_kw_units_25d(dwelling, calendar_year, units);
    then fuel_cell_joint_maximum_25d(dwelling, calendar_year, round(1667.00 * units, 2, "HALF_UP") * 1 USD);
}
pub relation individual_fuel_cell_expenditure_25d(individual: Individual, dwelling: Asset, calendar_year: Decimal, amount: Money) kind empirical {
    label en official "the amount of qualified fuel cell property expenditures made by the individual with respect to the dwelling during the calendar year — case-asserted";
}
pub relation total_fuel_cell_expenditure_of_dwelling_25d(dwelling: Asset, calendar_year: Decimal, amount: Money) kind empirical {
    label en official "the total expenditures made by all the individuals with respect to the dwelling during the calendar year — case-asserted";
}
pub relation allocated_fuel_cell_expenditure_25d(individual: Individual, dwelling: Asset, calendar_year: Decimal, amount: Money) kind institutional {
    label en official "section 25D(e)(4)(B): the expenditures allocated to an individual are the lesser of the individual's expenditures and the maximum times the fraction of the individual's expenditures over the total (cents HALF_UP)";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "The expenditures allocated to any individual for the taxable year in which such calendar year ends shall be an amount equal to the lesser of")
rule AllocatedFuelCellExpenditure25dRule(individual: Individual, dwelling: Asset, calendar_year: Decimal, own: Money, total: Money, maximum: Money) strict {
    when individual_fuel_cell_expenditure_25d(individual, dwelling, calendar_year, own);
    when total_fuel_cell_expenditure_of_dwelling_25d(dwelling, calendar_year, total);
    when total > 0 USD;
    when fuel_cell_joint_maximum_25d(dwelling, calendar_year, maximum);
    then allocated_fuel_cell_expenditure_25d(individual, dwelling, calendar_year,
        min(own, div_round(maximum * (own / 1.00 USD), total / 1.00 USD, 2, "HALF_UP")));
}

// --- (e)(5)-(6): cooperative housing and condominium associations ----------------------------------------------------------------------------------

pub relation tenant_stockholder_proportionate_share_25d(individual: Individual, coop: Person, share: Decimal) kind empirical {
    label en official "the tenant-stockholder's proportionate share, as a fraction, as defined in section 216(b)(3), in the cooperative housing corporation (section 25D(e)(5)) — case-asserted";
}
pub relation cooperative_expenditure_25d(coop: Person, amount: Money) kind empirical {
    label en official "the qualified expenditures of the cooperative housing corporation or condominium management association — case-asserted";
}
pub relation treated_as_made_by_tenant_stockholder_25d(individual: Individual, coop: Person, amount: Money) kind institutional {
    label en official "section 25D(e)(5): a tenant-stockholder is treated as having made the proportionate share of the expenditures of the cooperative housing corporation (cents HALF_UP)";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "such individual shall be treated as having made his tenant-stockholder's proportionate share (as defined in section 216(b)(3))")
rule TreatedAsMadeByTenantStockholder25dRule(individual: Individual, coop: Person, share: Decimal, amount: Money) strict {
    when tenant_stockholder_proportionate_share_25d(individual, coop, share);
    when cooperative_expenditure_25d(coop, amount);
    then treated_as_made_by_tenant_stockholder_25d(individual, coop, round(amount / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}
pub relation association_meets_528c1_other_than_e_25d(assoc: Person) kind empirical {
    label en official "the organization meets the requirements of paragraph (1) of section 528(c) (other than subparagraph (E)) — case-asserted";
}
pub relation condominium_project_substantially_all_units_residences_25d(assoc: Person) kind empirical {
    label en official "the condominium project has substantially all of its units used as residences (section 25D(e)(6)(B)) — case-asserted";
}
pub relation condominium_management_association_25d(assoc: Person) kind institutional {
    label en official "section 25D(e)(6)(B): an organization meeting the requirements of section 528(c)(1) (other than subparagraph (E)) with respect to a condominium project substantially all of the units of which are used as residences";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "the term \"condominium management association\" means an organization which meets the requirements of paragraph (1) of section 528(c) (other than subparagraph (E) thereof)")
rule CondominiumManagementAssociation25dRule(assoc: Person) strict {
    when association_meets_528c1_other_than_e_25d(assoc);
    when condominium_project_substantially_all_units_residences_25d(assoc);
    then condominium_management_association_25d(assoc);
}
pub relation condominium_member_proportionate_share_25d(individual: Individual, assoc: Person, share: Decimal) kind empirical {
    label en official "the individual's proportionate share, as a fraction, of the expenditures of the association with respect to a condominium the individual owns (section 25D(e)(6)(A)) — case-asserted";
}
pub relation treated_as_made_by_condominium_member_25d(individual: Individual, assoc: Person, amount: Money) kind institutional {
    label en official "section 25D(e)(6)(A): a member of a condominium management association is treated as having made the individual's proportionate share of the association's expenditures (cents HALF_UP)";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "such individual shall be treated as having made the individual's proportionate share of any expenditures of such association")
rule TreatedAsMadeByCondominiumMember25dRule(individual: Individual, assoc: Person, share: Decimal, amount: Money) strict {
    when condominium_management_association_25d(assoc);
    when condominium_member_proportionate_share_25d(individual, assoc, share);
    when cooperative_expenditure_25d(assoc, amount);
    then treated_as_made_by_condominium_member_25d(individual, assoc, round(amount / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}

// --- (e)(7)-(8): business use and the time of the expenditure --------------------------------------------------------------------------------------------

pub relation nonbusiness_use_share_25d(prop: Asset, share: Decimal) kind empirical {
    label en official "the share, as a fraction, of the use of the item that is for nonbusiness purposes (section 25D(e)(7)) — case-asserted";
}
pub relation expenditure_for_item_25d(taxpayer: Individual, prop: Asset, amount: Money) kind empirical {
    label en official "the expenditure for the item — case-asserted";
}
pub relation expenditure_after_business_use_allocation_25d(taxpayer: Individual, prop: Asset, amount: Money) kind institutional {
    label en official "section 25D(e)(7): if less than 80 percent of the use of an item is for nonbusiness purposes, only the portion of the expenditure allocable to nonbusiness use is taken into account (cents HALF_UP)";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "If less than 80 percent of the use of an item is for nonbusiness purposes, only that portion of the expenditures for such item which is properly allocable to use for nonbusiness purposes shall be taken into account.")
rule ExpenditureAfterBusinessUseBelow80Rule(taxpayer: Individual, prop: Asset, amount: Money, share: Decimal) strict {
    when expenditure_for_item_25d(taxpayer, prop, amount);
    when nonbusiness_use_share_25d(prop, share);
    when share < 0.80;
    then expenditure_after_business_use_allocation_25d(taxpayer, prop, round(amount / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}
rule ExpenditureAfterBusinessUseAtLeast80Rule(taxpayer: Individual, prop: Asset, amount: Money, share: Decimal) strict {
    when expenditure_for_item_25d(taxpayer, prop, amount);
    when nonbusiness_use_share_25d(prop, share);
    when share >= 0.80;
    then expenditure_after_business_use_allocation_25d(taxpayer, prop, amount);
}
pub relation original_installation_completed_on_25d(prop: Asset, on: Date) kind empirical {
    label en official "the date the original installation of the item is completed (section 25D(e)(8)(A)) — case-asserted";
}
pub relation expenditure_in_connection_with_construction_of_structure_25d(prop: Asset) kind empirical {
    label en official "the expenditure is in connection with the construction or reconstruction of a structure (section 25D(e)(8)(B)) — case-asserted";
}
pub relation original_use_of_structure_begins_on_25d(prop: Asset, on: Date) kind empirical {
    label en official "the date the original use of the constructed or reconstructed structure by the taxpayer begins (section 25D(e)(8)(B)) — case-asserted";
}
pub relation expenditure_treated_as_made_on_25d(prop: Asset, on: Date) kind institutional {
    label en official "section 25D(e)(8): an expenditure is treated as made when the original installation of the item is completed or, for construction or reconstruction of a structure, when the original use of the structure by the taxpayer begins";
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "an expenditure with respect to an item shall be treated as made when the original installation of the item is completed")
rule ExpenditureTreatedAsMadeOnInstallationRule(prop: Asset, on: Date) strict {
    when original_installation_completed_on_25d(prop, on);
    when not_known(expenditure_in_connection_with_construction_of_structure_25d(prop));
    then expenditure_treated_as_made_on_25d(prop, on);
}
@source(IRC_S25D_E, relation = formalizes, coverage = exact, quote = "such expenditure shall be treated as made when the original use of the constructed or reconstructed structure by the taxpayer begins")
rule ExpenditureTreatedAsMadeOnOriginalUseRule(prop: Asset, on: Date) strict {
    when expenditure_in_connection_with_construction_of_structure_25d(prop);
    when original_use_of_structure_begins_on_25d(prop, on);
    then expenditure_treated_as_made_on_25d(prop, on);
}

// --- (c), (f): the carryover and the basis ---------------------------------------------------------------------------------------------------------------------

pub relation limitation_under_26a_25d(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the limitation imposed by section 26(a) for the taxable year — case-asserted";
}
pub relation other_credits_under_subpart_25d(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of the credits allowable under subpart A of part IV (other than this section) — case-asserted";
}
pub relation credit_carried_to_succeeding_year_25d(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 25D(c): the credit in excess of the section 26(a) limitation reduced by the other credits of the subpart is carried to the succeeding taxable year";
}
@source(IRC_S25D_C, relation = formalizes, coverage = partial, quote = "such excess shall be carried to the succeeding taxable year and added to the credit allowable under subsection (a) for such succeeding taxable year")
rule CreditCarriedToSucceedingYear25dRule(taxpayer: Individual, y: TaxableYear, credit: Money, limit: Money, others: Money) defeasible {
    when residential_clean_energy_credit(taxpayer, y, credit);
    when limitation_under_26a_25d(taxpayer, y, limit);
    when other_credits_under_subpart_25d(taxpayer, y, others);
    when credit > limit - others;
    then credit_carried_to_succeeding_year_25d(taxpayer, y, credit - max(limit - others, 0 USD));
}
pub relation credit_carried_from_prior_year_25d(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit carried to the taxable year from the preceding year under subsection (c) — case-asserted";
}
pub relation credit_allowable_with_carryover_25d(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 25D(c): the credit carried from the preceding year is added to the credit allowable for the taxable year";
}
rule CreditAllowableWithCarryover25dRule(taxpayer: Individual, y: TaxableYear, credit: Money, carried: Money) defeasible {
    when residential_clean_energy_credit(taxpayer, y, credit);
    when credit_carried_from_prior_year_25d(taxpayer, y, carried);
    then credit_allowable_with_carryover_25d(taxpayer, y, credit + carried);
}
pub relation basis_increase_before_credit_25d(taxpayer: Individual, prop: Asset, amount: Money) kind empirical {
    label en official "the increase in the basis of the property that would, but for subsection (f), result from the expenditure — case-asserted";
}
pub relation credit_allowed_for_property_25d(taxpayer: Individual, prop: Asset, amount: Money) kind empirical {
    label en official "the credit allowed under section 25D for the expenditure with respect to the property — case-asserted";
}
pub relation basis_increase_after_credit_25d(taxpayer: Individual, prop: Asset, amount: Money) kind institutional {
    label en official "section 25D(f): the increase in the basis of the property is reduced by the credit allowed (not below zero)";
}
@source(IRC_S25D_F, relation = formalizes, coverage = exact, quote = "the increase in the basis of such property which would (but for this subsection) result from such expenditure shall be reduced by the amount of the credit so allowed")
rule BasisIncreaseAfterCredit25dRule(taxpayer: Individual, prop: Asset, increase: Money, credit: Money) strict {
    when basis_increase_before_credit_25d(taxpayer, prop, increase);
    when credit_allowed_for_property_25d(taxpayer, prop, credit);
    then basis_increase_after_credit_25d(taxpayer, prop, max(increase - credit, 0 USD));
}
