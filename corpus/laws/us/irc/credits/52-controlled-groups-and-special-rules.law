// Section 52 — Special rules. Stage 2b (IRC-06 stage 2b, DECISION-0379).
// Priority list item: §52 (controlled groups via §1563 as contracts, (b)
// trades under common control, (c) tax-exempt organizations, (d) estates/
// trusts).
//
// Judgment calls / scope:
// * §52(a): "controlled group of corporations" is section 1563(a)'s own
//   definition, EXCEPT "more than 50 percent" is substituted for "at least
//   80 percent" in section 1563(a)(1) (the parent-subsidiary test), and the
//   determination is made without regard to section 1563(a)(4)/(e)(3)(C).
//   `us.irc.corporations` module 08 already publishes section 1563(a)'s own
//   ownership facts (`parent_subsidiary_ownership_share`) and BOTH branches
//   of the test: the general 80% parent-subsidiary rule and the (already
//   ">50%", unchanged by section 52) brother-sister rule
//   (`brother_sister_controlled_group`). This module therefore (i) writes
//   its OWN parent-subsidiary rule at the >50% threshold, reusing
//   `us.irc.corporations`'s empirical ownership-share relation directly
//   (no new empirical fact type), and (ii) reuses
//   `us.irc.corporations::brother_sister_controlled_group` UNCHANGED for
//   the brother-sister branch (section 1563(a)(2) already reads "more than
//   50 percent" — section 52(a)(1)'s substitution instruction names only
//   "(a)(1)", so (a)(2) needs no local rewrite). The "without regard to
//   (a)(4)/(e)(3)(C)" instruction is not separately modelled as a NEGATIVE
//   guard: `us.irc.corporations` module 08 does not implement section
//   1563(a)(4) (certain excluded stock, a repealed-and-reserved paragraph
//   in the CURRENT text — see that package's own coverage row) or
//   (e)(3)(C) at all, so there is no rule whose result needs disregarding
//   yet — TECH-GAPS G390 records this as a latent gap that becomes live
//   only once those provisions are formalized.
// * §52(a)'s own proportionate-share sentence ("the credit ... shall be its
//   proportionate share of the wages giving rise to such credit") is
//   modelled as a computation over a case-asserted wage allocation, mirroring
//   the (b)(2) idiom below (the statute gives no formula for HOW the
//   proportionate share is set beyond "wages giving rise to such credit" —
//   read here as each member's own share of the group's total qualified
//   first-year wages under section 51).
// * §52(b) (common-control trades or businesses) has no statutory test of
//   its own — it delegates entirely to Treasury regulations ("under
//   regulations prescribed by the Secretary"), which are not pinned in this
//   corpus (26 CFR 1.52-1). The AGGREGATION FACT itself
//   (`under_common_control_52b`) is therefore an EXTERNAL_DEPENDENCY case
//   fact; once asserted, the (b)(2) proportionate-share computation IS
//   executable (same shape as (a)'s own proportionate-share rule).
// * §52(c)(1): a blocking condition on `us.irc.credits`'s own
//   `work_opportunity_credit` (module 51) — no WOTC credit to a tax-exempt
//   organization other than a section 521 cooperative. `exempt_from_income_
//   tax_under_chapter_1` and `cooperative_described_in_521` are new
//   dependency-contract facts (candidate producer: a not-yet-built
//   `us.irc.exempt-organizations` bridge into THIS package — that package
//   exists but is not a dependency of `credits`; TECH-GAPS G390).
// * §52(c)(2) is a pure crossreference ("For credit against payroll taxes
//   ... see section 3111(e)") — the operative credit belongs to section
//   3111(e), owned by `us.irc.employment` (payroll tax chapter), not
//   modelled here; classified `reference`/EXTERNAL_DEPENDENCY, no rule.
// * §52(d) (estate/trust apportionment): the (d)(1) apportionment fraction
//   ("on the basis of the income of the estate or trust allocable to each")
//   is a case-asserted allocation (the statute gives no further formula for
//   "allocable" income); (d)(2)'s consequence is modelled as a plain
//   pass-through PRE-limitation amount — the actual section 38(c)
//   limitation itself is module 38's own and is not re-applied here (the
//   module 38 total, `general_business_credit`, already reads its own
//   `current_year_business_credit` input; wiring this apportioned amount
//   INTO that input is a TECH_GAP, since the (a) sum's own component list
//   does not carry a distinct "apportioned-from-a-different-taxpayer" slot).
// * §52(e) (RIC/REIT/cooperative special rules): cross-references section 46
//   "as in effect on the day before the date of the enactment of the
//   Revenue Reconciliation Act of 1990" — i.e. FROZEN, since-repealed 1990
//   text, not part of this corpus's pinned CURRENT edition
//   (SOURCE-MANIFEST.json pins the 2024 edition only). SOURCE_GAP: the
//   operative rule content is not in any source this corpus pins.

// --- §52(a): controlled group of corporations (>50% test) -------------------

use self::{
    Corporation,
    IRC_S52_A,
    IRC_S52_B,
    IRC_S52_C,
    IRC_S52_D,
    Person,
    TaxableYear,
};

type ControlledGroup = us.irc.corporations::ControlledGroup;

pub relation section_52_controlled_group_parent_subsidiary(group: ControlledGroup, parent: Corporation, subsidiary: Corporation) kind institutional {
    label en official "parent and subsidiary are within a section 52(a) controlled group of corporations: section 1563(a)(1)'s parent-subsidiary test with 'more than 50 percent' substituted for 'at least 80 percent' (section 52(a)(1))";
}
@source(IRC_S52_A, quote = "\"more than 50 percent\" shall be substituted for \"at least 80 percent\" each place it appears in section 1563(a)(1)")
rule Section52aParentSubsidiaryVotingRule(group: ControlledGroup, parent: Corporation, subsidiary: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 52(a)(1): more than 50 percent of the total combined voting power held within the chain";
    when us.irc.corporations::parent_subsidiary_ownership_share(group, parent, subsidiary, voting, value);
    when voting > 0.50;
    then section_52_controlled_group_parent_subsidiary(group, parent, subsidiary);
}
@source(IRC_S52_A, quote = "\"more than 50 percent\" shall be substituted for \"at least 80 percent\" each place it appears in section 1563(a)(1)")
rule Section52aParentSubsidiaryValueRule(group: ControlledGroup, parent: Corporation, subsidiary: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 52(a)(1): the alternative more-than-50-percent-of-value branch";
    when us.irc.corporations::parent_subsidiary_ownership_share(group, parent, subsidiary, voting, value);
    when value > 0.50;
    then section_52_controlled_group_parent_subsidiary(group, parent, subsidiary);
}

pub relation section_52_controlled_group_member(group: ControlledGroup, corp: Corporation) kind institutional {
    label en official "corp is treated as a member of a section 52(a) controlled group of corporations — all its employees are treated as employed by a single employer for section 51 purposes";
}
@source(IRC_S52_A, quote = "all employees of all corporations which are members of the same controlled group of corporations shall be treated as employed by a single employer")
rule Section52aMemberViaParentSubsidiaryRule(group: ControlledGroup, parent: Corporation, subsidiary: Corporation) defeasible {
    when section_52_controlled_group_parent_subsidiary(group, parent, subsidiary);
    then section_52_controlled_group_member(group, parent);
    then section_52_controlled_group_member(group, subsidiary);
}
@source(IRC_S52_A, quote = "the term \"controlled group of corporations\" has the meaning given to such term by section 1563(a)")
rule Section52aMemberViaBrotherSisterRule(group: ControlledGroup, corp: Corporation) strict {
    label en official "the section 1563(a)(2) brother-sister test already reads 'more than 50 percent' — section 52(a)(1)'s substitution names only (a)(1), so this branch is reused unchanged from us.irc.corporations";
    when us.irc.corporations::brother_sister_controlled_group(group, corp);
    then section_52_controlled_group_member(group, corp);
}

pub relation section_52a_group_qualified_first_year_wages(group: ControlledGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 52(a) controlled group's total section 51(a) qualified first-year wages giving rise to the work opportunity credit, before proportionate allocation among members (case-asserted aggregate)";
}
pub relation section_52a_member_wage_share(group: ControlledGroup, member: Corporation, y: TaxableYear, share: Decimal) kind empirical {
    label en official "member's share (a fraction between 0 and 1) of the section 52(a) controlled group's total qualified first-year wages for the taxable year — case-asserted (the statute names no formula beyond 'proportionate share of the wages giving rise to such credit')";
}
pub relation section_52a_proportionate_share_of_credit(group: ControlledGroup, member: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 52(a) proportionate share of the group's aggregate section 51(a) credit allocated to this member";
}
@source(IRC_S52_A, quote = "the credit (if any) determined under section 51(a) with respect to each such member shall be its proportionate share of the wages giving rise to such credit")
rule Section52aProportionateShareRule(group: ControlledGroup, member: Corporation, y: TaxableYear, group_wages: Money, share: Decimal) defeasible {
    when section_52_controlled_group_member(group, member);
    when section_52a_group_qualified_first_year_wages(group, y, group_wages);
    when section_52a_member_wage_share(group, member, y, share);
    then section_52a_proportionate_share_of_credit(group, member, y, round(group_wages * share, 2, "HALF_UP"));
}

// --- §52(b): trades or businesses under common control -----------------------

pub relation under_common_control_52b(group: ControlledGroup, business: Person, y: TaxableYear) kind empirical {
    label en official "business (incorporated or not) is treated, under Treasury regulations prescribed under section 52(b), as under common control with the other members of the group — EXTERNAL_DEPENDENCY: 26 CFR 1.52-1 is not pinned in this corpus, so this fact is case-asserted rather than derived from an ownership test";
}
pub relation section_52b_group_qualified_first_year_wages(group: ControlledGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 52(b) common-control group's total section 51(a) qualified first-year wages giving rise to the work opportunity credit (case-asserted aggregate, same idiom as (a)'s own group total)";
}
pub relation section_52b_business_wage_share(group: ControlledGroup, business: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "business's share of the section 52(b) common-control group's total qualified first-year wages for the taxable year (case-asserted)";
}
pub relation section_52b_proportionate_share_of_credit(group: ControlledGroup, business: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 52(b)(2) proportionate share of the common-control group's aggregate section 51(a) credit allocated to this trade or business";
}
@source(IRC_S52_B, quote = "the credit (if any) determined under section 51(a) with respect to each trade or business shall be its proportionate share of the wages giving rise to such credit")
rule Section52bProportionateShareRule(group: ControlledGroup, business: Person, y: TaxableYear, group_wages: Money, share: Decimal) strict {
    when under_common_control_52b(group, business, y);
    when section_52b_group_qualified_first_year_wages(group, y, group_wages);
    when section_52b_business_wage_share(group, business, y, share);
    then section_52b_proportionate_share_of_credit(group, business, y, round(group_wages * share, 2, "HALF_UP"));
}

// --- §52(c): tax-exempt organizations -----------------------------------------

pub relation exempt_from_income_tax_under_chapter_1(org: Person) kind empirical {
    label en official "org is an organization exempt from income tax under this chapter (case-asserted; producer: a not-yet-wired dependency on us.irc.exempt-organizations)";
}
pub relation cooperative_described_in_521(org: Person) kind empirical {
    label en official "org is a cooperative described in section 521 (case-asserted; producer: a not-yet-wired dependency on us.irc.exempt-organizations)";
}
pub relation section_52c_work_opportunity_credit_denied(employer: Person) kind institutional {
    label en official "section 52(c)(1): no work opportunity credit is allowable to this employer for any taxable year, because it is a tax-exempt organization other than a section 521 cooperative — modelled as a status of the employer rather than per-year (a year-varying exemption status is a further refinement, TECH-GAPS G390)";
}
@source(IRC_S52_C, quote = "No credit shall be allowed under section 38 for any work opportunity credit determined under this subpart to any organization (other than a cooperative described in section 521) which is exempt from income tax under this chapter.")
rule Section52cDenialRule(employer: Person) strict {
    when exempt_from_income_tax_under_chapter_1(employer);
    when not cooperative_described_in_521(employer);
    then section_52c_work_opportunity_credit_denied(employer);
}
// §52(c)(2) is a pure cross-reference to section 3111(e) (payroll-tax credit
// for qualified tax-exempt organizations employing qualified veterans) — the
// operative credit belongs to chapter 21 (FICA), owned by `us.irc.employment`,
// not modelled in this package. EXTERNAL_DEPENDENCY, no rule here.

// --- §52(d): estates and trusts ------------------------------------------------

pub relation section_52d_income_allocable_share(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the fraction of the estate's or trust's income allocable to the beneficiary, used to apportion a section 38 subpart-D credit between the estate/trust and its beneficiaries (section 52(d)(1)) — case-asserted (the statute names no further formula for 'allocable' income)";
}
pub relation section_52d_credit_before_apportionment(estate_or_trust: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of credit determined under this subpart (Part IV) for the estate or trust for the taxable year, before the section 52(d)(1) apportionment (case-asserted; the estate/trust's own component credit computations are outside this module's scope)";
}
pub relation section_52d_apportioned_credit(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 52(d)(1) apportioned share of the estate's or trust's Part IV credit allowed, subject to section 38(c), as a credit to the beneficiary under section 38(a) (section 52(d)(2))";
}
@source(IRC_S52_D, quote = "the amount of the credit determined under this subpart for any taxable year shall be apportioned between the estate or trust and the beneficiaries on the basis of the income of the estate or trust allocable to each")
rule Section52dApportionmentRule(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) strict {
    label en official "the beneficiary's pre-limitation apportioned amount; the section 38(c) limitation itself (referenced by (d)(2)) is applied by module 38, not re-derived here (TECH_GAP: wiring this amount into general_business_credit's own input list)";
    when section_52d_credit_before_apportionment(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then section_52d_apportioned_credit(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}

// §52(e) (RIC/REIT/section 1381(a) cooperative special rules): SOURCE_GAP.
// The cross-referenced text — subsections (e) and (h) of section 46 "as in
// effect on the day before the date of the enactment of the Revenue
// Reconciliation Act of 1990" — is frozen, since-repealed historical text
// that is not part of the current Title 26 edition this corpus pins
// (SOURCE-MANIFEST.json). No rule is modelled; recorded here and in
// coverage/credits.json as SOURCE_GAP, not silently reclassified as
// NON_NORMATIVE (the provision IS still operative law for RICs/REITs/
// section 1381(a) cooperatives, its text is simply outside this corpus's
// pinned sources).

// --- §52(b)(1): regulation reader (IRC-G/G4, CFR wiring 27.09.2026) ---------
// 26 CFR 1.52-1 is pinned phase-0 (us.cfr.t26_1_52_1) — addressable,
// rule-less, not yet a dependency (registry/lock gap, cfr-wire STATUS).
// The case-selected relation below names the regulation content as applied;
// the rule derives the (b)(1) aggregation consequence in parallel with the
// existing case-asserted `under_common_control_52b` path, which is untouched.
// Coverage row 26/52/b/u2 stays EXTERNAL_DEPENDENCY (flip only after
// execution, owner gate step 6).

relation common_control_aggregation_follows_regulation_1_52_1_52b(group: ControlledGroup, business: Person, y: TaxableYear) kind empirical {
    label en official "the 26 CFR 1.52-1 common-control test, as applied to this business for the year, aggregates it with the group (case-selected: the regulation content enters as case facts)";
}
pub relation common_control_aggregation_applies_under_regulation_1_52_1_52b(group: ControlledGroup, business: Person, y: TaxableYear) kind institutional {
    label en official "section 52(b)(1): this trade or business is under common control with the group under the regulation, so all employees are treated as employed by a single employer";
}
@source(IRC_S52_B, relation = formalizes, coverage = partial, quote = "all employees of trades or business (whether or not incorporated) which are under common control shall be treated as employed by a single employer, and")
rule S52bCommonControlViaRegulation152_1 strict {
    label en official "section 52(b)(1): the regulation-aggregated business counts toward the single-employer treatment";
    for group: ControlledGroup;
    for business: Person;
    for y: TaxableYear;
    when common_control_aggregation_follows_regulation_1_52_1_52b(group, business, y);
    then common_control_aggregation_applies_under_regulation_1_52_1_52b(group, business, y);
}
