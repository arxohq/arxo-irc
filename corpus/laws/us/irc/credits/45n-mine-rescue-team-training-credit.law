// Section 45N — Mine rescue team training credit. Stage 2d (IRC-06,
// DECISION-0379).
//
// Scope / judgment calls:
// * Per qualified employee: the lesser of 20 percent of training-program
//   costs (including the employee's wages while attending) and $10,000.
// * (b) qualified employee: a full-time employee who is a miner eligible for
//   more than 6 months of the year to serve on a mine rescue team through the
//   initial 20-hour course (1) or through 40 hours of refresher training (2);
//   the months of eligibility are case facts.
// * (c) eligible employer: employs individuals as miners in underground mines
//   in the United States.
// * (d): "wages" is section 3306(b) without the dollar limit; the wage part of
//   the cost is read inside the case-asserted cost amount (external
//   dependency on `us.irc.employment`, TECH-GAPS G1520).
// * (e): the section does not apply to taxable years beginning after
//   December 31, 2021.

use self::{
    IRC_S45N_A,
    IRC_S45N_B,
    IRC_S45N_E,
    Individual,
    Person,
    TaxableYear,
};

pub relation employs_underground_miners_in_united_states_45n(taxpayer: Person) kind empirical {
    label en official "the taxpayer employs individuals as miners in underground mines in the United States (section 45N(c)) — case-asserted";
}
pub relation full_time_employee_45n(employee: Individual, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the individual is a full-time employee of the taxpayer during the taxable year (section 45N(b)) — case-asserted";
}
pub relation months_eligible_after_initial_course_45n(employee: Individual, y: TaxableYear, months: Decimal) kind empirical {
    label en official "months of the taxable year the miner is eligible to serve as a mine rescue team member as a result of completing the initial 20-hour MSHA course (section 45N(b)(1)) — case-asserted";
}
pub relation months_eligible_after_refresher_45n(employee: Individual, y: TaxableYear, months: Decimal) kind empirical {
    label en official "months of the taxable year the miner is eligible to serve as a mine rescue team member by virtue of at least 40 hours of refresher training (section 45N(b)(2)) — case-asserted";
}
pub relation training_program_costs_45n(taxpayer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount paid or incurred for the employee's training program costs, including the employee's wages while attending (section 45N(a)(1)) — case-asserted";
}

pub relation qualified_mine_rescue_team_employee_45n(employee: Individual, taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45N(b): a full-time employee who is a miner eligible for more than 6 months of the year to serve as a mine rescue team member";
}
@source(IRC_S45N_B, quote = "a miner eligible for more than 6 months of such taxable year to serve as a mine rescue team member as a result of completing, at a minimum, an initial 20-hour course of instruction")
rule QualifiedEmployeeInitialCourse45nRule(employee: Individual, taxpayer: Person, y: TaxableYear, months: Decimal) strict {
    when full_time_employee_45n(employee, taxpayer, y);
    when months_eligible_after_initial_course_45n(employee, y, months);
    when months > 6.0;
    then qualified_mine_rescue_team_employee_45n(employee, taxpayer, y);
}
@source(IRC_S45N_B, quote = "a miner eligible for more than 6 months of such taxable year to serve as a mine rescue team member by virtue of receiving at least 40 hours of refresher training")
rule QualifiedEmployeeRefresher45nRule(employee: Individual, taxpayer: Person, y: TaxableYear, months: Decimal) strict {
    when full_time_employee_45n(employee, taxpayer, y);
    when months_eligible_after_refresher_45n(employee, y, months);
    when months > 6.0;
    then qualified_mine_rescue_team_employee_45n(employee, taxpayer, y);
}

pub relation section_45n_in_force_for_year(y: TaxableYear) kind institutional {
    label en official "section 45N(e): the section applies only to taxable years beginning on or before December 31, 2021";
}
@source(IRC_S45N_E, quote = "This section shall not apply to taxable years beginning after December 31, 2021.")
rule Section45nInForceRule(y: TaxableYear, begin: Date) strict {
    when us.irc.core::begins(y, begin);
    when begin <= @2021-12-31;
    then section_45n_in_force_for_year(y);
}

pub relation mine_rescue_team_training_credit_per_employee(taxpayer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45N(a): the lesser of 20 percent of the employee's training program costs and $10,000";
}
@source(IRC_S45N_A, quote = "the mine rescue team training credit determined under this section with respect to each qualified mine rescue team employee of an eligible employer for any taxable year is an amount equal to the lesser of")
rule MineRescueTeamTrainingCreditPerEmployee45nRule(taxpayer: Person, employee: Individual, y: TaxableYear, cost: Money) defeasible {
    when employs_underground_miners_in_united_states_45n(taxpayer);
    when section_45n_in_force_for_year(y);
    when qualified_mine_rescue_team_employee_45n(employee, taxpayer, y);
    when training_program_costs_45n(taxpayer, employee, y, cost);
    then mine_rescue_team_training_credit_per_employee(taxpayer, employee, y, min(round(0.20 * cost, 2, "HALF_UP"), 10000.00 USD));
}
pub relation mine_rescue_team_training_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45N mine rescue team training credit for the taxable year (a section 38(b)(23) component)";
}
rule MineRescueTeamTrainingCredit45nRule(taxpayer: Person, y: TaxableYear, employee: Individual, amount: Money) defeasible {
    when mine_rescue_team_training_credit_per_employee(taxpayer, employee, y, amount);
    then mine_rescue_team_training_credit(taxpayer, y,
        sum(collect all a: Money, e: Individual where mine_rescue_team_training_credit_per_employee(taxpayer, e, y, a), empty: 0 USD));
}
