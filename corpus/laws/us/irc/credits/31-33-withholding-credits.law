// Section 31 — Tax withheld on wages; Section 33 — Tax withheld at source on
// nonresident aliens and foreign corporations. Stage 1 (IRC-06 stage 1).
//
// Both sections convert an amount already withheld under another chapter
// into a REFUNDABLE credit against this subtitle's tax. Neither section's
// owner package (`employment`, chapter 24 withholding; chapter 3 NRA/foreign
// withholding) exists yet (task instruction: pending). The withheld amount
// itself is a typed institutional dependency contract; this package owns
// only the "amount withheld becomes a credit for THIS taxable year" rule.

use self::{
    IRC_S31_A,
    IRC_S33,
    Person,
    TaxableYear,
};

pub relation amount_withheld_wages(taxpayer: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the amount withheld as tax under chapter 24 during a calendar year (section 31(a)(1)) — dependency contract, producer: employment (pending)";
}
pub relation last_taxable_year_beginning_in(taxpayer: Person, calendar_year: Integer, y: TaxableYear) kind institutional {
    label en official "the LAST taxable year of the taxpayer beginning in the given calendar year, for the section 31(a)(2) tie-break when more than one taxable year begins in the same calendar year — dependency contract, producer: core/temporal (pending)";
}

pub relation wage_withholding_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit for tax withheld on wages (section 31)";
}
@source(IRC_S31_A, quote = "The amount withheld as tax under chapter 24 shall be allowed to the recipient of the income as a credit against the tax imposed by this subtitle")
rule WageWithholdingCreditGeneral(taxpayer: Person, y: TaxableYear, calendar_year: Integer, amount: Money) strict {
    label en official "amounts withheld under chapter 24 during a calendar year are allowed as a credit for the (last) taxable year beginning in that calendar year";
    when amount_withheld_wages(taxpayer, calendar_year, amount);
    when last_taxable_year_beginning_in(taxpayer, calendar_year, y);
    then wage_withholding_credit(taxpayer, y, amount);
}
// §31(b) (section 6413(c) special-refund crediting by regulation, treated as
// a section 3402 withholding) and §31(c) (section 3406 backup withholding,
// credited for the year the income is received rather than the calendar-
// year-withheld rule of (a)(2)) are variant TIMING/SOURCE rules on the same
// "amount withheld becomes a credit" disposition; recorded as
// EXTERNAL_DEPENDENCY (same pending `employment` producer) rather than
// duplicated as separate top-level rules, given the identical structure.

pub relation nra_withholding_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit for tax withheld at source on nonresident aliens and foreign corporations (section 33)";
}
relation amount_withheld_chapter_3(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of tax withheld at source under subchapter A of chapter 3 (section 33) — dependency contract, producer: international (pending)";
}
@source(IRC_S33, quote = "There shall be allowed as a credit against the tax imposed by this subtitle the amount of tax withheld at source under subchapter A of chapter 3")
rule NraWithholdingCredit(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    label en official "chapter 3 withholding is allowed as a credit against this subtitle's tax for the taxable year";
    when amount_withheld_chapter_3(taxpayer, y, amount);
    then nra_withholding_credit(taxpayer, y, amount);
}
