// COPY of the arithmetic helper of us.irc.accounting module 49 (stage 4, DECISION-0379 with deontics),
// kept in this package so that section 42(k)(3) can discount without a dependency of credits on
// accounting (the two packages do not import each other; keep the two copies identical).
// Compound growth kernel and semiannual span counter. ARITHMETIC HELPER, not a norm: the language has `pow` only
// for Integer pow Integer (spec section 58), so a Decimal growth factor
// (1 + step)^n is built by BINARY EXPONENTIATION UNROLLED to a fixed depth.
//
// BOUND (stated): the exponent n is an Integer in 0..16383 (14 bits); a request
// with a larger n gets NO factor (the chain is not defined above 14 bits), so
// callers get NEITHER, never a wrong number. Every squaring and every product
// is rounded to 12 decimal places, HALF_UP (JUDGMENT CALL: the statute names
// no precision for a compounding factor; the rounding error is below 1e-12
// per step, far below a cent on any realistic amount).
//
// Consumers (`50` look-back interest, `51` section 457A interest, `52` section
// 453(l)(3) interest, `53` present values under sections 467 and 483) emit a
// `growth_request(step, n)` and read `growth_factor(step, n, factor)`.
//
// The second helper counts the WHOLE semiannual (six calendar month) periods
// between two dates, up to 40 (20 years), by unrolled comparison with
// `add_calendar_period`; a longer span is capped at 40 (stated bound).

pub relation growth_request(step: Decimal, n: Integer) kind institutional {
    label en official "a consumer asks for the growth factor (1 + step)^n: step is the per-period rate, n the number of periods (arithmetic helper of stage 4)";
}
pub relation growth_factor(step: Decimal, n: Integer, factor: Decimal) kind institutional {
    label en official "the growth factor (1 + step)^n by unrolled binary exponentiation, every product rounded to 12 places HALF_UP (JUDGMENT CALL); defined for n in 0..16383";
}

relation growth_square_0(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^1, the square chain of the binary exponentiation, level 0; built only when n is at least 1, so that no unused power is computed";
}
relation growth_accumulator_0(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 1 bit(s) of n";
}
relation growth_square_1(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^2, the square chain of the binary exponentiation, level 1; built only when n is at least 2, so that no unused power is computed";
}
relation growth_accumulator_1(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 2 bit(s) of n";
}
relation growth_square_2(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^4, the square chain of the binary exponentiation, level 2; built only when n is at least 4, so that no unused power is computed";
}
relation growth_accumulator_2(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 3 bit(s) of n";
}
relation growth_square_3(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^8, the square chain of the binary exponentiation, level 3; built only when n is at least 8, so that no unused power is computed";
}
relation growth_accumulator_3(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 4 bit(s) of n";
}
relation growth_square_4(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^16, the square chain of the binary exponentiation, level 4; built only when n is at least 16, so that no unused power is computed";
}
relation growth_accumulator_4(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 5 bit(s) of n";
}
relation growth_square_5(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^32, the square chain of the binary exponentiation, level 5; built only when n is at least 32, so that no unused power is computed";
}
relation growth_accumulator_5(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 6 bit(s) of n";
}
relation growth_square_6(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^64, the square chain of the binary exponentiation, level 6; built only when n is at least 64, so that no unused power is computed";
}
relation growth_accumulator_6(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 7 bit(s) of n";
}
relation growth_square_7(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^128, the square chain of the binary exponentiation, level 7; built only when n is at least 128, so that no unused power is computed";
}
relation growth_accumulator_7(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 8 bit(s) of n";
}
relation growth_square_8(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^256, the square chain of the binary exponentiation, level 8; built only when n is at least 256, so that no unused power is computed";
}
relation growth_accumulator_8(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 9 bit(s) of n";
}
relation growth_square_9(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^512, the square chain of the binary exponentiation, level 9; built only when n is at least 512, so that no unused power is computed";
}
relation growth_accumulator_9(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 10 bit(s) of n";
}
relation growth_square_10(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^1024, the square chain of the binary exponentiation, level 10; built only when n is at least 1024, so that no unused power is computed";
}
relation growth_accumulator_10(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 11 bit(s) of n";
}
relation growth_square_11(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^2048, the square chain of the binary exponentiation, level 11; built only when n is at least 2048, so that no unused power is computed";
}
relation growth_accumulator_11(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 12 bit(s) of n";
}
relation growth_square_12(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^4096, the square chain of the binary exponentiation, level 12; built only when n is at least 4096, so that no unused power is computed";
}
relation growth_accumulator_12(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 13 bit(s) of n";
}
relation growth_square_13(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "(1 + step)^8192, the square chain of the binary exponentiation, level 13; built only when n is at least 8192, so that no unused power is computed";
}
relation growth_accumulator_13(step: Decimal, n: Integer, value: Decimal) kind institutional {
    label en official "the product of the squares selected by the low 14 bit(s) of n";
}
rule GrowthSquareLevel0(step: Decimal, n: Integer) defeasible {
    label en official "level 0 of the square chain is 1 + step";
    when growth_request(step, n);
    then growth_square_0(step, n, 1.0 + step);
}
rule GrowthSquareLevel1(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 1 is the square of level 0, rounded to 12 places, when n is at least 2";
    when growth_square_0(step, n, v);
    when n >= 2;
    then growth_square_1(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel2(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 2 is the square of level 1, rounded to 12 places, when n is at least 4";
    when growth_square_1(step, n, v);
    when n >= 4;
    then growth_square_2(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel3(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 3 is the square of level 2, rounded to 12 places, when n is at least 8";
    when growth_square_2(step, n, v);
    when n >= 8;
    then growth_square_3(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel4(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 4 is the square of level 3, rounded to 12 places, when n is at least 16";
    when growth_square_3(step, n, v);
    when n >= 16;
    then growth_square_4(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel5(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 5 is the square of level 4, rounded to 12 places, when n is at least 32";
    when growth_square_4(step, n, v);
    when n >= 32;
    then growth_square_5(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel6(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 6 is the square of level 5, rounded to 12 places, when n is at least 64";
    when growth_square_5(step, n, v);
    when n >= 64;
    then growth_square_6(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel7(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 7 is the square of level 6, rounded to 12 places, when n is at least 128";
    when growth_square_6(step, n, v);
    when n >= 128;
    then growth_square_7(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel8(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 8 is the square of level 7, rounded to 12 places, when n is at least 256";
    when growth_square_7(step, n, v);
    when n >= 256;
    then growth_square_8(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel9(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 9 is the square of level 8, rounded to 12 places, when n is at least 512";
    when growth_square_8(step, n, v);
    when n >= 512;
    then growth_square_9(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel10(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 10 is the square of level 9, rounded to 12 places, when n is at least 1024";
    when growth_square_9(step, n, v);
    when n >= 1024;
    then growth_square_10(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel11(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 11 is the square of level 10, rounded to 12 places, when n is at least 2048";
    when growth_square_10(step, n, v);
    when n >= 2048;
    then growth_square_11(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel12(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 12 is the square of level 11, rounded to 12 places, when n is at least 4096";
    when growth_square_11(step, n, v);
    when n >= 4096;
    then growth_square_12(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthSquareLevel13(step: Decimal, n: Integer, v: Decimal) defeasible {
    label en official "level 13 is the square of level 12, rounded to 12 places, when n is at least 8192";
    when growth_square_12(step, n, v);
    when n >= 8192;
    then growth_square_13(step, n, round(v * v, 12, "HALF_UP"));
}
rule GrowthAccumulator0BitSet(step: Decimal, n: Integer, s: Decimal) defeasible {
    label en official "bit 0 of n is set: start with (1 + step)";
    when growth_request(step, n);
    when growth_square_0(step, n, s);
    when n >= 0;
    when n < 16384;
    when n mod 2 >= 1;
    then growth_accumulator_0(step, n, s);
}
rule GrowthAccumulator0BitClear(step: Decimal, n: Integer) defeasible {
    label en official "bit 0 of n is clear: start with 1";
    when growth_request(step, n);
    when n >= 0;
    when n < 16384;
    when n mod 2 < 1;
    then growth_accumulator_0(step, n, 1.0);
}
rule GrowthAccumulator1BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 1 of n is set: multiply by the level 1 square";
    when growth_accumulator_0(step, n, a);
    when growth_square_1(step, n, s);
    when n mod 4 >= 2;
    then growth_accumulator_1(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator1BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 1 of n is clear: keep the product";
    when growth_accumulator_0(step, n, a);
    when n mod 4 < 2;
    then growth_accumulator_1(step, n, a);
}
rule GrowthAccumulator2BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 2 of n is set: multiply by the level 2 square";
    when growth_accumulator_1(step, n, a);
    when growth_square_2(step, n, s);
    when n mod 8 >= 4;
    then growth_accumulator_2(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator2BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 2 of n is clear: keep the product";
    when growth_accumulator_1(step, n, a);
    when n mod 8 < 4;
    then growth_accumulator_2(step, n, a);
}
rule GrowthAccumulator3BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 3 of n is set: multiply by the level 3 square";
    when growth_accumulator_2(step, n, a);
    when growth_square_3(step, n, s);
    when n mod 16 >= 8;
    then growth_accumulator_3(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator3BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 3 of n is clear: keep the product";
    when growth_accumulator_2(step, n, a);
    when n mod 16 < 8;
    then growth_accumulator_3(step, n, a);
}
rule GrowthAccumulator4BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 4 of n is set: multiply by the level 4 square";
    when growth_accumulator_3(step, n, a);
    when growth_square_4(step, n, s);
    when n mod 32 >= 16;
    then growth_accumulator_4(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator4BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 4 of n is clear: keep the product";
    when growth_accumulator_3(step, n, a);
    when n mod 32 < 16;
    then growth_accumulator_4(step, n, a);
}
rule GrowthAccumulator5BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 5 of n is set: multiply by the level 5 square";
    when growth_accumulator_4(step, n, a);
    when growth_square_5(step, n, s);
    when n mod 64 >= 32;
    then growth_accumulator_5(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator5BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 5 of n is clear: keep the product";
    when growth_accumulator_4(step, n, a);
    when n mod 64 < 32;
    then growth_accumulator_5(step, n, a);
}
rule GrowthAccumulator6BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 6 of n is set: multiply by the level 6 square";
    when growth_accumulator_5(step, n, a);
    when growth_square_6(step, n, s);
    when n mod 128 >= 64;
    then growth_accumulator_6(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator6BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 6 of n is clear: keep the product";
    when growth_accumulator_5(step, n, a);
    when n mod 128 < 64;
    then growth_accumulator_6(step, n, a);
}
rule GrowthAccumulator7BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 7 of n is set: multiply by the level 7 square";
    when growth_accumulator_6(step, n, a);
    when growth_square_7(step, n, s);
    when n mod 256 >= 128;
    then growth_accumulator_7(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator7BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 7 of n is clear: keep the product";
    when growth_accumulator_6(step, n, a);
    when n mod 256 < 128;
    then growth_accumulator_7(step, n, a);
}
rule GrowthAccumulator8BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 8 of n is set: multiply by the level 8 square";
    when growth_accumulator_7(step, n, a);
    when growth_square_8(step, n, s);
    when n mod 512 >= 256;
    then growth_accumulator_8(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator8BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 8 of n is clear: keep the product";
    when growth_accumulator_7(step, n, a);
    when n mod 512 < 256;
    then growth_accumulator_8(step, n, a);
}
rule GrowthAccumulator9BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 9 of n is set: multiply by the level 9 square";
    when growth_accumulator_8(step, n, a);
    when growth_square_9(step, n, s);
    when n mod 1024 >= 512;
    then growth_accumulator_9(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator9BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 9 of n is clear: keep the product";
    when growth_accumulator_8(step, n, a);
    when n mod 1024 < 512;
    then growth_accumulator_9(step, n, a);
}
rule GrowthAccumulator10BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 10 of n is set: multiply by the level 10 square";
    when growth_accumulator_9(step, n, a);
    when growth_square_10(step, n, s);
    when n mod 2048 >= 1024;
    then growth_accumulator_10(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator10BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 10 of n is clear: keep the product";
    when growth_accumulator_9(step, n, a);
    when n mod 2048 < 1024;
    then growth_accumulator_10(step, n, a);
}
rule GrowthAccumulator11BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 11 of n is set: multiply by the level 11 square";
    when growth_accumulator_10(step, n, a);
    when growth_square_11(step, n, s);
    when n mod 4096 >= 2048;
    then growth_accumulator_11(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator11BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 11 of n is clear: keep the product";
    when growth_accumulator_10(step, n, a);
    when n mod 4096 < 2048;
    then growth_accumulator_11(step, n, a);
}
rule GrowthAccumulator12BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 12 of n is set: multiply by the level 12 square";
    when growth_accumulator_11(step, n, a);
    when growth_square_12(step, n, s);
    when n mod 8192 >= 4096;
    then growth_accumulator_12(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator12BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 12 of n is clear: keep the product";
    when growth_accumulator_11(step, n, a);
    when n mod 8192 < 4096;
    then growth_accumulator_12(step, n, a);
}
rule GrowthAccumulator13BitSet(step: Decimal, n: Integer, a: Decimal, s: Decimal) defeasible {
    label en official "bit 13 of n is set: multiply by the level 13 square";
    when growth_accumulator_12(step, n, a);
    when growth_square_13(step, n, s);
    when n mod 16384 >= 8192;
    then growth_accumulator_13(step, n, round(a * s, 12, "HALF_UP"));
}
rule GrowthAccumulator13BitClear(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "bit 13 of n is clear: keep the product";
    when growth_accumulator_12(step, n, a);
    when n mod 16384 < 8192;
    then growth_accumulator_13(step, n, a);
}
rule GrowthFactorFromTopAccumulator(step: Decimal, n: Integer, a: Decimal) defeasible {
    label en official "after the last bit the accumulator is the factor";
    when growth_accumulator_13(step, n, a);
    then growth_factor(step, n, a);
}

// ===================== semiannual spans =====================

pub relation semiannual_span_request(start_on: Date, end_on: Date) kind institutional {
    label en official "a consumer asks for the number of whole six-month periods from the first date to the second (arithmetic helper of stage 4)";
}
pub relation whole_semiannual_periods(start_on: Date, end_on: Date, n: Integer) kind institutional {
    label en official "the number of whole six-calendar-month periods from the first date up to the second (capped at 40; a part of a period is not counted)";
}
relation semiannual_periods_elapsed_1(start_on: Date, end_on: Date) kind institutional {
    label en official "at least 1 whole six-month period(s) have elapsed";
}
rule SemiannualPeriodsElapsed1(a: Date, b: Date) defeasible {
    label en official "6 calendar months after the first date is not later than the second";
    when semiannual_span_request(a, b);
    when add_calendar_period(a, 6 calendar_month) <= b;
    then semiannual_periods_elapsed_1(a, b);
}
relation semiannual_periods_elapsed_2(start_on: Date, end_on: Date) kind institutional {
    label en official "at least 2 whole six-month period(s) have elapsed";
}
rule SemiannualPeriodsElapsed2(a: Date, b: Date) defeasible {
    label en official "12 calendar months after the first date is not later than the second";
    when semiannual_span_request(a, b);
    when add_calendar_period(a, 12 calendar_month) <= b;
    then semiannual_periods_elapsed_2(a, b);
}
relation semiannual_periods_elapsed_3(start_on: Date, end_on: Date) kind institutional {
    label en official "at least 3 whole six-month period(s) have elapsed";
}
rule SemiannualPeriodsElapsed3(a: Date, b: Date) defeasible {
    label en official "18 calendar months after the first date is not later than the second";
    when semiannual_span_request(a, b);
    when add_calendar_period(a, 18 calendar_month) <= b;
    then semiannual_periods_elapsed_3(a, b);
}
relation semiannual_periods_elapsed_4(start_on: Date, end_on: Date) kind institutional {
    label en official "at least 4 whole six-month period(s) have elapsed";
}
rule SemiannualPeriodsElapsed4(a: Date, b: Date) defeasible {
    label en official "24 calendar months after the first date is not later than the second";
    when semiannual_span_request(a, b);
    when add_calendar_period(a, 24 calendar_month) <= b;
    then semiannual_periods_elapsed_4(a, b);
}
relation semiannual_periods_elapsed_5(start_on: Date, end_on: Date) kind institutional {
    label en official "at least 5 whole six-month period(s) have elapsed";
}
rule SemiannualPeriodsElapsed5(a: Date, b: Date) defeasible {
    label en official "30 calendar months after the first date is not later than the second";
    when semiannual_span_request(a, b);
    when add_calendar_period(a, 30 calendar_month) <= b;
    then semiannual_periods_elapsed_5(a, b);
}
relation semiannual_periods_elapsed_6(start_on: Date, end_on: Date) kind institutional {
    label en official "at least 6 whole six-month period(s) have elapsed";
}
rule SemiannualPeriodsElapsed6(a: Date, b: Date) defeasible {
    label en official "36 calendar months after the first date is not later than the second";
