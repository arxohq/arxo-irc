}


// ===================== semiannual compounding factor =====================

pub relation semiannual_factor_request(rate: Decimal, start_on: Date, end_on: Date) kind institutional {
    label en official "a consumer asks for the factor of an annual rate compounded semiannually from the first date to the second (arithmetic helper of stage 4)";
}
relation semiannual_step(rate: Decimal, step: Decimal) kind institutional {
    label en official "the per-period rate: half of the annual rate, rounded to 12 places HALF_UP (JUDGMENT CALL)";
}
pub relation semiannual_factor(rate: Decimal, start_on: Date, end_on: Date, factor: Decimal) kind institutional {
    label en official "the factor: (1 + rate/2)^n for the whole six-month periods, times simple interest for the incomplete last period (stub days over the days of its period), rounded to 12 places (JUDGMENT CALL: the statute names no rule for a stub period)";
}
rule SemiannualRequestsSpan(rate: Decimal, a: Date, b: Date) defeasible {
    label en official "a factor request needs the span";
    when semiannual_factor_request(rate, a, b);
    then semiannual_span_request(a, b);
}
rule SemiannualStepFromRate(rate: Decimal, a: Date, b: Date) defeasible {
    label en official "half of the annual rate";
    when semiannual_factor_request(rate, a, b);
    then semiannual_step(rate, div_round(rate, 2.0, 12, "HALF_UP"));
}
rule SemiannualRequestsGrowth(rate: Decimal, a: Date, b: Date, step: Decimal, n: Integer, sd: Integer, pd: Integer) defeasible {
    label en official "the growth request for the whole periods";
    when semiannual_factor_request(rate, a, b);
    when semiannual_step(rate, step);
    when semiannual_span_detail(a, b, n, sd, pd);
    then growth_request(step, n);
}
rule SemiannualFactorFromGrowthAndStub(rate: Decimal, a: Date, b: Date, step: Decimal, n: Integer, sd: Integer, pd: Integer, g: Decimal) defeasible {
    label en official "growth over the whole periods times simple interest over the stub";
    when semiannual_factor_request(rate, a, b);
    when semiannual_step(rate, step);
    when semiannual_span_detail(a, b, n, sd, pd);
    when growth_factor(step, n, g);
    then semiannual_factor(rate, a, b, round(g * (1.0 + div_round(step * sd, pd * 1.0, 12, "HALF_UP")), 12, "HALF_UP"));
}

