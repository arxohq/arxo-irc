pub relation semiannual_span_detail(start_on: Date, end_on: Date, n: Integer, stub_days: Integer, period_days: Integer) kind institutional {
    label en official "whole six-month periods n, the days of the incomplete last period (stub_days) and the days of the full period that contains it (period_days), from the first date up to the second; n is capped at 40 (stated bound)";
}
rule WholeSemiannualPeriodsFromDetail(a: Date, b: Date, n: Integer, sd: Integer, pd: Integer) defeasible {
    label en official "the count alone";
    when semiannual_span_detail(a, b, n, sd, pd);
    then whole_semiannual_periods(a, b, n);
}
rule SemiannualDetail0(a: Date, b: Date) defeasible {
    label en official "less than six months elapsed: zero periods, the whole span is the stub";
    when semiannual_span_request(a, b);
    when not_known(semiannual_periods_elapsed_1(a, b));
    then semiannual_span_detail(a, b, 0, days_between(a, b), days_between(a, add_calendar_period(a, 6 calendar_month)));
}
rule SemiannualDetail1(a: Date, b: Date) defeasible {
    label en official "exactly 1 whole six-month period(s)";
    when semiannual_periods_elapsed_1(a, b);
    when not_known(semiannual_periods_elapsed_2(a, b));
    then semiannual_span_detail(a, b, 1, days_between(add_calendar_period(a, 6 calendar_month), b), days_between(add_calendar_period(a, 6 calendar_month), add_calendar_period(a, 12 calendar_month)));
}
