// Section 44 — Expenditures to provide access to disabled individuals.
// Stage 2c (IRC-06 stage 2c, DECISION-0379), "as budget allows" item: §44
// (50 percent of eligible expenditures between $250 and $10,250; eligible
// small business <=$1,000,000 receipts / <=30 employees).
//
// Judgment calls / scope:
// * (b)(2)'s "such person elects the application of this section" is
//   modelled as a genuine POWER (a legal-relation change, not a mere
//   classification) — an eligible-small-business-sized person who has not
//   elected gets no credit even if the size test is met.
// * (c)(2)-(5) (the itemized list of what counts as an eligible access
//   expenditure, the reasonableness test, the new-construction exclusion,
//   and the related-person disqualification) are NOT decomposed — the
//   case-asserted `eligible_access_expenditure` amount is read as already
//   meeting all of (c)(1)-(5)'s tests (TECH_GAP, TECH-GAPS G391).
// * (d) (controlled-group/predecessor aggregation, mirroring section
//   52(a)/(b)) and (e) (no double benefit: no deduction/other-credit
//   overlap) are NOT modelled — TECH_GAP.

use self::{
    IRC_S44_A,
    IRC_S44_B,
    Person,
    TaxableYear,
};

pub relation gross_receipts_preceding_year_44(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's gross receipts for the taxable year preceding the credit year (section 44(b)(1)(A)) — case-asserted";
}
pub relation full_time_employees_preceding_year_44(taxpayer: Person, y: TaxableYear, count: Decimal) kind empirical {
    label en official "the number of full-time employees (at least 30 hours/week for 20+ calendar weeks) the taxpayer employed during the preceding taxable year (section 44(b)(1)(B)) — case-asserted";
}
pub relation eligible_small_business_size_test_44(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 44(b)(1): gross receipts for the preceding year did not exceed $1,000,000, or (if not) no more than 30 full-time employees were employed during the preceding year";
}
@source(IRC_S44_B, quote = "the gross receipts of such person for the preceding taxable year did not exceed $1,000,000")
rule EligibleSmallBusinessSizeTestGrossReceiptsRule(taxpayer: Person, y: TaxableYear, receipts: Money) strict {
    when gross_receipts_preceding_year_44(taxpayer, y, receipts);
    when receipts <= 1000000.00 USD;
    then eligible_small_business_size_test_44(taxpayer, y);
}
@source(IRC_S44_B, quote = "such person employed not more than 30 full-time employees during the preceding taxable year")
rule EligibleSmallBusinessSizeTestEmployeesRule(taxpayer: Person, y: TaxableYear, count: Decimal) strict {
    when full_time_employees_preceding_year_44(taxpayer, y, count);
    when count <= 30.0;
    then eligible_small_business_size_test_44(taxpayer, y);
}

pub relation elects_section_44(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's exercise of the section 44(b)(2) election to have this section apply for the taxable year";
}
pub relation eligible_small_business_44(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 44(b): an eligible small business — the size test is met and the section 44(b)(2) election has been validly made";
}
@source(IRC_S44_B, quote = "such person elects the application of this section for the taxable year")
rule Section44ElectionRule(taxpayer: Person, y: TaxableYear) defeasible {
    when eligible_small_business_size_test_44(taxpayer, y);
    then power Section44b2Election {
        holder taxpayer;
        over taxpayer;
        exercise elects_section_44(taxpayer, y);
        valid_when eligible_small_business_size_test_44(taxpayer, y);
        effect create(eligible_small_business_44(taxpayer, y));
        window [@1990-11-05, infinity);
    };
}

pub relation eligible_access_expenditure(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid or incurred to comply with the Americans with Disabilities Act (section 44(c)) — case-asserted, already meeting the (c)(2)-(5) tests";
}
pub relation disabled_access_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 44 disabled access credit: 50 percent of eligible access expenditures in excess of $250 but not exceeding $10,250";
}
@source(IRC_S44_A, quote = "the amount of the disabled access credit determined under this section for any taxable year shall be an amount equal to 50 percent of so much of the eligible access expenditures for the taxable year as exceed $250 but do not exceed $10,250")
rule DisabledAccessCreditRule(taxpayer: Person, y: TaxableYear, expenditure: Money) strict {
    when eligible_small_business_44(taxpayer, y);
    when eligible_access_expenditure(taxpayer, y, expenditure);
    then disabled_access_credit(taxpayer, y, round(0.50 * max(0 USD, min(expenditure, 10250.00 USD) - 250.00 USD), 2, "HALF_UP"));
}
