// Section 42 — rehabilitation expenditures (e) and the credit-period rules
// (f)(2)(B), (f)(3), (f)(4), (f)(5). Stage 2e (IRC-06, DECISION-0379, TECH_GAP
// reduction of TECH-GAPS G1822). Companion of `42-low-income-housing-credit.law`
// ((a)-(b), (g)) and `42b-housing-credit-period-ceiling-and-compliance.law`
// ((f)(1)-(3), (h)-(m) first pass).
//
// Scope / judgment calls:
// * (e): rehabilitation expenditures form a separate new building only when the
//   character test, the low-income-unit nexus, the 20-percent test (waived by
//   the election for a building acquired from a governmental unit) and the
//   per-unit dollar test ($6,000, indexed after 2009) are all met at the close
//   of the first credit-period year. "Whichever requires the greater amount" is
//   read as both subclauses (I) and (II) must be satisfied. The indexed amount
//   is $6,000 plus $6,000 times the cost-of-living adjustment percentage,
//   the increase rounded to the nearest $100 (HALF_UP; JUDGMENT CALL: the text
//   names no tie rule). The cost-of-living adjustment percentage itself
//   (section 1(f)(3) with 2008 as the base year) is a case fact.
// * The election of (e)(3)(B) is a power. Its effect is read by a strict
//   consumer through the positive fact only; the consumer that needs the
//   NEGATIVE reads the raw exercise fact (a defeasible/negative reader does not
//   see a power effect of the same round, DECISION-0021 §4.3).
// * (f)(4): the day-count proration of the credit between the parties; the
//   "proper adjustments in subsection (j)" of the last sentence are not
//   modelled (no rule is stated in the text).

// --- (e): rehabilitation expenditures treated as a separate new building -----------------------------------------------------------

use self::{
    Asset,
    IRC_S42_E,
    IRC_S42_F,
    Person,
    TaxableYear,
    compliance_period_year_42,
    credit_after_allocation_limit_42,
    first_credit_year_begin_42,
    first_year_applicable_fraction_42,
    following_taxable_year_of,
    low_income_housing_building_owned_by,
    monthly_applicable_fraction_42,
    qualified_basis_at_close_42,
};

pub relation rehab_amount_chargeable_to_capital_42(building: Asset, period_end: Date, amount: Money) kind empirical {
    label en official "the amounts chargeable to capital account and incurred for depreciable property (or additions or improvements to it) in connection with the rehabilitation of the building during the 24-month period ending on the date (section 42(e)(2)(A)) — case-asserted";
}
pub relation rehab_excluded_amount_42(building: Asset, period_end: Date, amount: Money) kind empirical {
    label en official "the part of the amounts that is the cost of acquiring the building (or an interest in it) or an amount not permitted to be taken into account under section 42(d)(3) or (4) (section 42(e)(2)(B)) — case-asserted";
}
pub relation rehab_property_of_depreciable_character_42(building: Asset, period_end: Date) kind empirical {
    label en official "the expenditures are for property of a character subject to the allowance for depreciation in connection with the rehabilitation of the building (section 42(e)(2)(A)) — case-asserted";
}
pub relation rehabilitation_expenditures_42(building: Asset, period_end: Date, amount: Money) kind institutional {
    label en official "section 42(e)(2): the rehabilitation expenditures for the 24-month period ending on the date: capitalized depreciable amounts less the cost of acquiring the building and the amounts excluded by section 42(d)(3) and (4)";
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "The term \"rehabilitation expenditures\" means amounts chargeable to capital account and incurred for property (or additions or improvements to property) of a character subject to the allowance for depreciation in connection with the rehabilitation of a building.")
rule RehabilitationExpenditures42Rule(building: Asset, period_end: Date, chargeable: Money, excluded: Money) strict {
    when rehab_amount_chargeable_to_capital_42(building, period_end, chargeable);
    when rehab_excluded_amount_42(building, period_end, excluded);
    when rehab_property_of_depreciable_character_42(building, period_end);
    then rehabilitation_expenditures_42(building, period_end, chargeable - excluded);
}

pub relation rehab_allocable_to_low_income_units_42(building: Asset, period_end: Date) kind empirical {
    label en official "the expenditures are allocable to 1 or more low-income units (section 42(e)(3)(A)(i)) — case-asserted";
}
pub relation rehab_substantially_benefits_low_income_units_42(building: Asset, period_end: Date) kind empirical {
    label en official "the expenditures substantially benefit low-income units (section 42(e)(3)(A)(i)) — case-asserted";
}
relation rehab_low_income_nexus_42(building: Asset, period_end: Date) kind institutional;
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "the expenditures are allocable to 1 or more low-income units or substantially benefit such units")
rule RehabLowIncomeNexusAllocable42Rule(building: Asset, period_end: Date) strict {
    when rehab_allocable_to_low_income_units_42(building, period_end);
    then rehab_low_income_nexus_42(building, period_end);
}
rule RehabLowIncomeNexusBenefit42Rule(building: Asset, period_end: Date) strict {
    when rehab_substantially_benefits_low_income_units_42(building, period_end);
    then rehab_low_income_nexus_42(building, period_end);
}

pub relation adjusted_basis_first_day_of_rehab_period_42(building: Asset, period_end: Date, amount: Money) kind empirical {
    label en official "the adjusted basis of the building as of the first day of the 24-month period, without regard to section 1016(a)(2) and (3) (section 42(e)(3)(A)(ii)(I)) — case-asserted";
}
pub relation low_income_unit_count_of_building_42(building: Asset, units: Decimal) kind empirical {
    label en official "the number of low-income units in the building (section 42(e)(3)(A)(ii)(II)) — case-asserted";
}
pub relation qualified_basis_attributable_to_rehab_42(building: Asset, period_end: Date, amount: Money) kind empirical {
    label en official "the qualified basis attributable to the rehabilitation expenditures (section 42(e)(3)(A)(ii)(II)) — case-asserted";
}
pub relation cost_of_living_adjustment_2008_base_42(building: Asset, period_end: Date, pct: Decimal) kind empirical {
    label en official "the cost-of-living adjustment under section 1(f)(3) for the calendar year the expenditures are treated as placed in service, with calendar year 2008 substituted for 2016, as a fraction (0.10 for 10 percent); 0 when there is no increase (section 42(e)(3)(D)(ii)) — case-asserted, not pinned";
}
pub relation rehab_dollar_amount_42(building: Asset, period_end: Date, amount: Money) kind institutional {
    label en official "section 42(e)(3)(A)(ii)(II), (D): the $6,000 amount, increased for calendar years after 2009 by that amount times the cost-of-living adjustment, the increase rounded to the nearest $100";
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "the qualified basis attributable to such amount, when divided by the number of low-income units in the building, is $6,000 or more.")
rule RehabDollarAmountThrough2009Rule(building: Asset, period_end: Date) strict {
    when rehab_amount_chargeable_to_capital_42(building, period_end, _);
    when period_end <= @2009-12-31;
    then rehab_dollar_amount_42(building, period_end, 6000.00 USD);
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "Any increase under the preceding sentence which is not a multiple of $100 shall be rounded to the nearest multiple of $100.")
rule RehabDollarAmountAfter2009Rule(building: Asset, period_end: Date, pct: Decimal) strict {
    when rehab_amount_chargeable_to_capital_42(building, period_end, _);
    when period_end > @2009-12-31;
    when cost_of_living_adjustment_2008_base_42(building, period_end, pct);
    // 6,000 x pct = 60 x pct hundreds of dollars; rounded to the nearest $100 (HALF_UP judgment call).
    then rehab_dollar_amount_42(building, period_end, 6000.00 USD + round(60.0 * pct, 0, "HALF_UP") * 100.00 USD);
}

pub relation rehab_twenty_percent_test_met_42(building: Asset, period_end: Date) kind institutional {
    label en official "section 42(e)(3)(A)(ii)(I): the rehabilitation expenditures are not less than 20 percent of the adjusted basis of the building at the start of the period";
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "The requirement of this subclause is met if such amount is not less than 20 percent of the adjusted basis of the building (determined as of the 1st day of such period and without regard to paragraphs (2) and (3) of section 1016(a)).")
rule RehabTwentyPercentTestMet42Rule(building: Asset, period_end: Date, expenditures: Money, basis: Money) strict {
    when rehabilitation_expenditures_42(building, period_end, expenditures);
    when adjusted_basis_first_day_of_rehab_period_42(building, period_end, basis);
    when expenditures >= 0.20 * basis;
    then rehab_twenty_percent_test_met_42(building, period_end);
}
pub relation rehab_per_unit_test_met_42(building: Asset, period_end: Date) kind institutional {
    label en official "section 42(e)(3)(A)(ii)(II): the qualified basis attributable to the expenditures, divided by the number of low-income units, is at least the dollar amount";
}
// qualified basis / units >= dollar amount  <=>  qualified basis >= units x dollar amount (no division needed).
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "The requirement of this subclause is met if the qualified basis attributable to such amount, when divided by the number of low-income units in the building, is $6,000 or more.")
rule RehabPerUnitTestMet42Rule(building: Asset, period_end: Date, basis: Money, units: Decimal, dollars: Money) strict {
    when qualified_basis_attributable_to_rehab_42(building, period_end, basis);
    when low_income_unit_count_of_building_42(building, units);
    when rehab_dollar_amount_42(building, period_end, dollars);
    when units > 0.0;
    when basis >= units * dollars;
    then rehab_per_unit_test_met_42(building, period_end);
}

pub relation building_acquired_from_governmental_unit_42(building: Asset) kind empirical {
    label en official "the building was acquired by the taxpayer from a governmental unit (section 42(e)(3)(B)) — case-asserted";
}
pub relation elects_governmental_unit_rehab_percentage_42(taxpayer: Person, building: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 42(e)(3)(B) election: subparagraph (A)(ii)(I) does not apply and the credit for the rehabilitation expenditures uses the section 42(b)(2)(B)(ii) percentage";
}
pub relation twenty_percent_test_waived_42(building: Asset) kind institutional {
    label en official "section 42(e)(3)(B): the 20-percent test of subparagraph (A)(ii)(I) does not apply to the building (a valid election)";
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "In the case of a building acquired by the taxpayer from a governmental unit, at the election of the taxpayer, subparagraph (A)(ii)(I) shall not apply")
rule Section42E3BElectionRule(taxpayer: Person, building: Asset) defeasible {
    when low_income_housing_building_owned_by(building, taxpayer);
    when building_acquired_from_governmental_unit_42(building);
    then power Section42E3BElection {
        holder taxpayer;
        over building;
        exercise elects_governmental_unit_rehab_percentage_42(taxpayer, building);
        valid_when building_acquired_from_governmental_unit_42(building);
        effect create(twenty_percent_test_waived_42(building));
        window [@1986-10-22, infinity);
    };
}
pub relation rehab_test_determined_at_first_year_close_42(building: Asset, period_end: Date) kind empirical {
    label en official "the section 42(e)(3)(A) determination is made as of the close of the 1st taxable year in the credit period with respect to the expenditures (section 42(e)(3)(C)) — case-asserted";
}

pub relation rehab_treated_as_separate_new_building_42(building: Asset, period_end: Date) kind institutional {
    label en official "section 42(e)(1), (3): the rehabilitation expenditures for the 24-month period ending on the date are treated as a separate new building";
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "Rehabilitation expenditures paid or incurred by the taxpayer with respect to any building shall be treated for purposes of this section as a separate new building.")
rule RehabSeparateNewBuildingRule(building: Asset, period_end: Date, taxpayer: Person) strict {
    when low_income_housing_building_owned_by(building, taxpayer);
    when rehab_low_income_nexus_42(building, period_end);
    when rehab_twenty_percent_test_met_42(building, period_end);
    when rehab_per_unit_test_met_42(building, period_end);
    when rehab_test_determined_at_first_year_close_42(building, period_end);
    when not_known(elects_governmental_unit_rehab_percentage_42(taxpayer, building));
    then rehab_treated_as_separate_new_building_42(building, period_end);
}
rule RehabSeparateNewBuildingWaivedRule(building: Asset, period_end: Date) strict {
    when rehab_low_income_nexus_42(building, period_end);
    when rehabilitation_expenditures_42(building, period_end, _);
    when rehab_per_unit_test_met_42(building, period_end);
    when rehab_test_determined_at_first_year_close_42(building, period_end);
    when twenty_percent_test_waived_42(building);
    then rehab_treated_as_separate_new_building_42(building, period_end);
}

// --- (e)(4): the rehabilitation building is placed in service at the close of the period; its applicable fraction --------------------

pub relation applicable_fraction_of_building_without_e1_42(building: Asset, fraction: Decimal) kind empirical {
    label en official "the applicable fraction under section 42(c)(1) for the building with respect to which the expenditures were incurred, without regard to paragraph (1) (section 42(e)(4)(B)) — case-asserted";
}
pub relation rehab_deemed_placed_in_service_on_42(building: Asset, period_end: Date, on: Date) kind institutional {
    label en official "section 42(e)(4)(A): the expenditures are treated as placed in service at the close of the 24-month period";
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "such expenditures shall be treated as placed in service at the close of the 24-month period referred to in paragraph (3)(A)")
rule RehabDeemedPlacedInService42Rule(building: Asset, period_end: Date) strict {
    when rehab_treated_as_separate_new_building_42(building, period_end);
    then rehab_deemed_placed_in_service_on_42(building, period_end, period_end);
}
pub relation rehab_applicable_fraction_42(building: Asset, period_end: Date, fraction: Decimal) kind institutional {
    label en official "section 42(e)(4)(B): the applicable fraction of the separate rehabilitation building is the applicable fraction of the underlying building";
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "the applicable fraction under subsection (c)(1) shall be the applicable fraction for the building (without regard to paragraph (1)) with respect to which the expenditures were incurred.")
rule RehabApplicableFraction42Rule(building: Asset, period_end: Date, fraction: Decimal) strict {
    when rehab_treated_as_separate_new_building_42(building, period_end);
    when applicable_fraction_of_building_without_e1_42(building, fraction);
    then rehab_applicable_fraction_42(building, period_end, fraction);
}

// --- (e)(5): one subsection only ---------------------------------------------------------------------------------------------------------------

pub relation rehab_taken_into_account_under_e_42(taxpayer: Person, building: Asset) kind empirical {
    label en official "the taxpayer takes the rehabilitation expenditures into account under subsection (e) — case-asserted";
}
pub relation rehab_taken_into_account_under_d2a_i_42(taxpayer: Person, building: Asset) kind empirical {
    label en official "the taxpayer takes the same rehabilitation expenditures into account under subsection (d)(2)(A)(i) — case-asserted";
}
pub relation rehab_counted_under_both_42(taxpayer: Person, building: Asset) kind institutional {
    label en official "section 42(e)(5): the rehabilitation expenditures are taken into account under both subsection (e) and subsection (d)(2)(A)(i)";
}
rule RehabCountedUnderBoth42Rule(taxpayer: Person, building: Asset) strict {
    when rehab_taken_into_account_under_e_42(taxpayer, building);
    when rehab_taken_into_account_under_d2a_i_42(taxpayer, building);
    then rehab_counted_under_both_42(taxpayer, building);
}
@source(IRC_S42_E, relation = formalizes, coverage = partial, quote = "Rehabilitation expenditures may, at the election of the taxpayer, be taken into account under this subsection or subsection (d)(2)(A)(i) but not under both such subsections.")
rule Section42E5SingleSubsectionRule(taxpayer: Person, building: Asset) defeasible {
    when rehab_counted_under_both_42(taxpayer, building);
    then prohibition Section42E5NoDoubleCounting {
        bearer taxpayer;
        action rehab_counted_under_both_42(taxpayer, building);
        window [@1986-10-22, infinity);
    };
}

// --- (f)(2)(B): the first-year reduction is allowed in the year after the credit period ---------------------------------------------------

pub relation first_year_credit_without_fraction_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit allowable for the 1st taxable year of the credit period without regard to section 42(f)(2)(A) — case-asserted";
}
pub relation first_year_credit_after_fraction_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(f)(2)(A): the first-year credit reduced to the first-year applicable fraction of the credit otherwise allowable";
}
@source(IRC_S42_F, relation = formalizes, coverage = partial, quote = "the numerator of which is the sum of the applicable fractions determined under subsection (c)(1) as of the close of each full month of such year during which such building")
rule FirstYearCreditAfterFraction42Rule(building: Asset, y: TaxableYear, full: Money, fraction: Decimal) strict {
    when first_year_credit_without_fraction_42(building, y, full);
    when first_year_applicable_fraction_42(building, y, fraction);
    then first_year_credit_after_fraction_42(building, y, round(fraction * full, 2, "HALF_UP"));
}
pub relation deferred_first_year_credit_reduction_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(f)(2)(B): the reduction of the first-year credit is allowable for the 1st taxable year following the credit period";
}
@source(IRC_S42_F, relation = formalizes, coverage = exact, quote = "Any reduction by reason of subparagraph (A) in the credit allowable (without regard to subparagraph (A)) for the 1st taxable year of the credit period shall be allowable under subsection (a) for the 1st taxable year following the credit period.")
rule DeferredFirstYearCreditReduction42Rule(building: Asset, y: TaxableYear, y1: TaxableYear, full: Money, reduced: Money, first: Date, begin: Date) strict {
    when first_credit_year_begin_42(building, first);
    when us.irc.core::begins(y1, first);
    when first_year_credit_without_fraction_42(building, y1, full);
    when first_year_credit_after_fraction_42(building, y1, reduced);
    when us.irc.core::begins(y, begin);
    when begin == add_calendar_period(first, 120 calendar_month);
    then deferred_first_year_credit_reduction_42(building, y, full - reduced);
}

// --- (f)(3): an increase in qualified basis -------------------------------------------------------------------------------------------------

pub relation qualified_basis_increase_42(building: Asset, y: TaxableYear, excess: Money) kind institutional {
    label en official "section 42(f)(3)(A): the excess of the qualified basis as of the close of a taxable year in the compliance period (after the 1st year of the credit period) over the qualified basis as of the close of the 1st year";
}
@source(IRC_S42_F, relation = formalizes, coverage = partial, quote = "(i) as of the close of any taxable year in the compliance period (after the 1st year of the credit period) the qualified basis of such building exceeds")
rule QualifiedBasisIncrease42Rule(building: Asset, y: TaxableYear, y1: TaxableYear, first: Date, begin: Date, now: Money, base: Money) strict {
    when first_credit_year_begin_42(building, first);
    when us.irc.core::begins(y1, first);
    when compliance_period_year_42(building, y);
    when us.irc.core::begins(y, begin);
    when begin > first;
    when qualified_basis_at_close_42(building, y, now);
    when qualified_basis_at_close_42(building, y1, base);
    when now > base;
    then qualified_basis_increase_42(building, y, now - base);
}
relation has_qualified_basis_increase_42(building: Asset, y: TaxableYear) kind institutional;
rule HasQualifiedBasisIncrease42Rule(building: Asset, y: TaxableYear, excess: Money) strict {
    when qualified_basis_increase_42(building, y, excess);
    then has_qualified_basis_increase_42(building, y);
}
relation increase_in_prior_year_42(building: Asset, y: TaxableYear) kind institutional;
rule IncreaseInPriorYear42Rule(building: Asset, y: TaxableYear, previous: TaxableYear) strict {
    when following_taxable_year_of(previous, y);
    when has_qualified_basis_increase_42(building, previous);
    then increase_in_prior_year_42(building, y);
}
pub relation first_year_of_qualified_basis_increase_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(f)(3)(B): the first taxable year of an increase in qualified basis";
}
rule FirstYearOfQualifiedBasisIncrease42Rule(building: Asset, y: TaxableYear) strict {
    when has_qualified_basis_increase_42(building, y);
    when not_known(increase_in_prior_year_42(building, y));
    then first_year_of_qualified_basis_increase_42(building, y);
}
pub relation first_increase_year_applicable_fraction_42(building: Asset, y: TaxableYear, fraction: Decimal) kind institutional {
    label en official "section 42(f)(3)(B): a rule similar to section 42(f)(2)(A) applies to the increase for the first year of the increase (the sum of the monthly applicable fractions divided by 12)";
}
@source(IRC_S42_F, relation = formalizes, coverage = exact, quote = "A rule similar to the rule of paragraph (2)(A) shall apply to any increase in qualified basis to which subparagraph (A) applies for the 1st year of such increase.")
rule FirstIncreaseYearApplicableFraction42Rule(building: Asset, y: TaxableYear) strict {
    when first_year_of_qualified_basis_increase_42(building, y);
    when monthly_applicable_fraction_42(building, y, _, _);
    then first_increase_year_applicable_fraction_42(building, y,
        div_round(sum(collect all f: Decimal, m: Decimal where monthly_applicable_fraction_42(building, y, m, f), empty: 0.0), 12.0, 10, "HALF_UP"));
}

// --- (f)(4): a disposition during the year: allocation of the credit by days held ---------------------------------------------------

pub relation days_building_held_in_year_42(building: Asset, party: Person, y: TaxableYear, days: Decimal) kind empirical {
    label en official "the number of days during the taxable year the building (or interest) was held by the party (section 42(f)(4)) — case-asserted";
}
pub relation days_in_taxable_year_42(y: TaxableYear, days: Decimal) kind empirical {
    label en official "the number of days in the taxable year — case-asserted";
}
pub relation credit_allocated_to_party_on_disposition_42(building: Asset, party: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(f)(4): the credit for the year in which the building (or an interest) is disposed of is allocated between the parties on the basis of the number of days each held it";
}
@source(IRC_S42_F, relation = formalizes, coverage = partial, quote = "such credit shall be allocated between the parties on the basis of the number of days during such year the building (or interest) was held by each")
rule CreditAllocatedOnDisposition42Rule(building: Asset, party: Person, y: TaxableYear, credit: Money, days: Decimal, year_days: Decimal) defeasible {
    when credit_after_allocation_limit_42(building, y, credit);
    when days_building_held_in_year_42(building, party, y, days);
    when days_in_taxable_year_42(y, year_days);
    when year_days > 0.0;
    // JUDGMENT CALL: the share is rounded to cents HALF_UP (the text names no rounding).
    then credit_allocated_to_party_on_disposition_42(building, party, y, div_round(credit * days, year_days, 2, "HALF_UP"));
}

// --- (f)(5): the credit period of an existing building ---------------------------------------------------------------------------------------

pub relation rehab_first_credit_year_begin_42(building: Asset, begin: Date) kind empirical {
    label en official "the first day of the 1st taxable year of the credit period for the rehabilitation expenditures with respect to the building — case-asserted";
}
pub relation existing_building_credit_period_begin_42(building: Asset, begin: Date) kind institutional {
    label en official "section 42(f)(5)(A): the credit period for an existing building does not begin before the 1st taxable year of the credit period for the rehabilitation expenditures";
}
@source(IRC_S42_F, relation = formalizes, coverage = exact, quote = "The credit period for an existing building shall not begin before the 1st taxable year of the credit period for rehabilitation expenditures with respect to the building.")
rule ExistingBuildingCreditPeriodLaterRehabRule(building: Asset, first: Date, rehab_first: Date) strict {
    when first_credit_year_begin_42(building, first);
    when rehab_first_credit_year_begin_42(building, rehab_first);
    when rehab_first > first;
    then existing_building_credit_period_begin_42(building, rehab_first);
}
rule ExistingBuildingCreditPeriodOwnBeginRule(building: Asset, first: Date, rehab_first: Date) strict {
    when first_credit_year_begin_42(building, first);
    when rehab_first_credit_year_begin_42(building, rehab_first);
    when rehab_first <= first;
    then existing_building_credit_period_begin_42(building, first);
}
pub relation waiver_granted_under_d6b_42(building: Asset) kind empirical {
    label en official "a waiver is granted under section 42(d)(6)(B) with respect to the acquisition of the building (section 42(f)(5)(B)(ii)(I)) — case-asserted";
}
pub relation rehab_credit_allowable_under_modified_test_42(building: Asset) kind empirical {
    label en official "a credit would be allowed for rehabilitation expenditures if subsection (e)(3)(A)(ii)(I) did not apply and the dollar amount in (e)(3)(A)(ii)(II) were two-thirds of that amount (section 42(f)(5)(B)(ii)(II)) — case-asserted";
}
pub relation modified_rehab_first_credit_year_begin_42(building: Asset, begin: Date) kind empirical {
    label en official "the first day of the taxable year that would be the 1st taxable year of the credit period for rehabilitation expenditures under the modifications of section 42(f)(5)(B)(ii)(II) — case-asserted";
}
pub relation building_described_in_f5b_ii_42(building: Asset) kind institutional {
    label en official "section 42(f)(5)(B)(ii): a waiver is granted under (d)(6)(B) and a credit would be allowed for rehabilitation expenditures under the modified test";
}
@source(IRC_S42_F, relation = formalizes, coverage = exact, quote = "A building is described in this clause if—")
rule BuildingDescribedInF5BiiRule(building: Asset) strict {
    when waiver_granted_under_d6b_42(building);
    when rehab_credit_allowable_under_modified_test_42(building);
    then building_described_in_f5b_ii_42(building);
}
pub relation credit_period_begin_for_f5b_building_42(building: Asset, begin: Date) kind institutional {
    label en official "section 42(f)(5)(B)(i)(II): the credit period of such a building does not begin before the taxable year that would be the 1st year of the credit period for rehabilitation expenditures under the modifications";
}
rule CreditPeriodBeginF5BLaterRule(building: Asset, first: Date, modified: Date) strict {
    when building_described_in_f5b_ii_42(building);
    when first_credit_year_begin_42(building, first);
    when modified_rehab_first_credit_year_begin_42(building, modified);
    when modified > first;
    then credit_period_begin_for_f5b_building_42(building, modified);
}
rule CreditPeriodBeginF5BOwnRule(building: Asset, first: Date, modified: Date) strict {
    when building_described_in_f5b_ii_42(building);
    when first_credit_year_begin_42(building, first);
    when modified_rehab_first_credit_year_begin_42(building, modified);
    when modified <= first;
    then credit_period_begin_for_f5b_building_42(building, first);
}
pub relation d2b_iv_not_applicable_42(building: Asset) kind institutional {
    label en official "section 42(f)(5)(B)(i)(I): for a building described in clause (ii), subsection (d)(2)(B)(iv) does not apply";
}
@source(IRC_S42_F, relation = formalizes, coverage = exact, quote = "subsection (d)(2)(B)(iv) shall not apply, and")
rule D2BivNotApplicableRule(building: Asset) strict {
    when building_described_in_f5b_ii_42(building);
    then d2b_iv_not_applicable_42(building);
}
