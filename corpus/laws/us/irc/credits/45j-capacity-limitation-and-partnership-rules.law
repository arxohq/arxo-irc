// Section 45J — the national megawatt capacity limitation (the 6,000 megawatt cap, the regulations duty, the reallocation of the unutilized
// limitation and its priority) and the partnership level rules of (e)(3). Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c
// rows of TECH-GAPS G391). Companion of `45j-advanced-nuclear-power-facility-production-credit.law`; its credit rules read the allocated
// capacity as a case fact and are NOT rewired to require these relations.
//
// Judgment calls: the enactment (or amendment) date for the (b)(4) regulations duty is a case fact (never a literal); the priority of the
// (b)(5)(A) reallocation is a tier relation (1: placed in service on or before 2020-12-31 with less than full nameplate allocation; 2:
// placed in service later, ordered by the placed-in-service date); the manner of allocation of (b)(3) stays with the Secretary
// (DECISION-0194); amounts of capacity are decimals of megawatts.

// --- (b)(2): the 6,000 megawatt cap ---------------------------------------------------------------------------------------------------------------------------

use self::{
    Asset,
    IRC_S45J_B,
    IRC_S45J_E,
    Person,
    TaxableYear,
    qualified_public_entity_45j,
};

pub relation aggregate_capacity_allocated_by_secretary_45j(megawatts: Decimal) kind empirical {
    label en official "the aggregate amount of national megawatt capacity limitation allocated by the Secretary under paragraph (3) — case-asserted";
}
pub relation aggregate_allocation_within_national_cap_45j(megawatts: Decimal) kind institutional {
    label en official "section 45J(b)(2): the aggregate national megawatt capacity limitation allocated by the Secretary does not exceed 6,000 megawatts";
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "The aggregate amount of national megawatt capacity limitation allocated by the Secretary under paragraph (3) shall not exceed 6,000 megawatts.")
rule AggregateAllocationWithinNationalCapRule(megawatts: Decimal) strict {
    when aggregate_capacity_allocated_by_secretary_45j(megawatts);
    when megawatts <= 6000.0;
    then aggregate_allocation_within_national_cap_45j(megawatts);
}
pub relation secretary_allocates_above_national_cap_45j(megawatts: Decimal) kind institutional {
    label en official "the aggregate allocation exceeds 6,000 megawatts";
}
rule SecretaryAllocatesAboveNationalCapRule(megawatts: Decimal) strict {
    when aggregate_capacity_allocated_by_secretary_45j(megawatts);
    when megawatts > 6000.0;
    then secretary_allocates_above_national_cap_45j(megawatts);
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "shall not exceed 6,000 megawatts")
rule Section45JB2AllocationLimitRule(megawatts: Decimal) defeasible {
    when secretary_allocates_above_national_cap_45j(megawatts);
    then prohibition Section45JB2AllocationLimit {
        bearer us.irc.core::Secretary;
        action secretary_allocates_above_national_cap_45j(megawatts);
        window [-infinity, infinity);
    };
}

// --- (b)(4): the regulations duty ------------------------------------------------------------------------------------------------------------------------------

pub relation enactment_or_amendment_date_45j(on: Date) kind empirical {
    label en official "the date of the enactment of, or of any amendment to, section 45J (the reference date of the (b)(4) time limit) — case-asserted from the pinned Public Law notes";
}
pub relation regulations_prescribed_45j(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary or appropriate to carry out subsection (b), including a certification process under which the Secretary, after consultation with the Secretary of Energy, approves and allocates the national megawatt capacity limitation";
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "Not later than 6 months after the date of the enactment of or any amendment to this section, the Secretary shall prescribe such regulations as may be necessary or appropriate to carry out the purposes of this subsection.")
rule Section45JB4RegulationsDutyRule(on: Date) strict {
    when enactment_or_amendment_date_45j(on);
    then duty Section45JB4RegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_45j(us.irc.core::Secretary);
            window [on, add_calendar_period(on, 6 calendar_month)];
        }
    };
}

// --- (b)(5): the unutilized national megawatt capacity limitation ----------------------------------------------------------------------------------------

pub relation aggregate_allocated_before_2021_45j(megawatts: Decimal) kind empirical {
    label en official "the aggregate amount of national megawatt capacity limitation allocated by the Secretary before January 1, 2021 — case-asserted";
}
pub relation allocated_before_2021_to_facilities_not_placed_in_service_before_2021_45j(megawatts: Decimal) kind empirical {
    label en official "the amount of the limitation allocated before 2021 to a facility which was not placed in service before that date — case-asserted";
}
pub relation unutilized_national_capacity_limitation_45j(megawatts: Decimal) kind institutional {
    label en official "section 45J(b)(5)(B): the excess (if any) of 6,000 megawatts over the aggregate limitation allocated before 2021, reduced by any amount allocated to a facility not placed in service before that date";
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "The term \"unutilized national megawatt capacity limitation\" means the excess (if any) of")
rule UnutilizedNationalCapacityLimitationRule(allocated: Decimal, not_placed: Decimal) strict {
    when aggregate_allocated_before_2021_45j(allocated);
    when allocated_before_2021_to_facilities_not_placed_in_service_before_2021_45j(not_placed);
    then unutilized_national_capacity_limitation_45j(max(6000.0 - (allocated - not_placed), 0.0));
}
pub relation facility_placed_in_service_on_45j_b5(facility: Asset, on: Date) kind empirical {
    label en official "the date the facility is placed in service — case-asserted";
}
pub relation facility_allocation_received_megawatts_45j(facility: Asset, megawatts: Decimal) kind empirical {
    label en official "the national megawatt capacity limitation the facility received — case-asserted";
}
pub relation facility_nameplate_megawatts_45j_b5(facility: Asset, megawatts: Decimal) kind empirical {
    label en official "the nameplate capacity of the facility, in megawatts — case-asserted";
}
pub relation reallocation_priority_tier_45j(facility: Asset, tier: Decimal) kind institutional {
    label en official "section 45J(b)(5)(A): unutilized limitation is allocated first (tier 1) to facilities placed in service on or before 2020-12-31 that did not receive an allocation equal to their full nameplate capacity, then (tier 2) to facilities placed in service after that date in the order they are placed in service";
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "first to facilities placed in service on or before such date to the extent that such facilities did not receive an allocation equal to their full nameplate capacity")
rule ReallocationPriorityTier1Rule(facility: Asset, placed: Date, received: Decimal, nameplate: Decimal) strict {
    when facility_placed_in_service_on_45j_b5(facility, placed);
    when placed <= @2020-12-31;
    when facility_allocation_received_megawatts_45j(facility, received);
    when facility_nameplate_megawatts_45j_b5(facility, nameplate);
    when received < nameplate;
    then reallocation_priority_tier_45j(facility, 1.0);
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "then to facilities placed in service after such date in the order in which such facilities are placed in service")
rule ReallocationPriorityTier2Rule(facility: Asset, placed: Date) strict {
    when facility_placed_in_service_on_45j_b5(facility, placed);
    when placed > @2020-12-31;
    then reallocation_priority_tier_45j(facility, 2.0);
}
pub relation reallocated_before_45j(first: Asset, second: Asset) kind institutional {
    label en official "section 45J(b)(5)(A): the first facility precedes the second in the reallocation order (a lower tier, or the same tier 2 and an earlier placed-in-service date)";
}
rule ReallocatedBeforeByTierRule(first: Asset, second: Asset, t1: Decimal, t2: Decimal) strict {
    when reallocation_priority_tier_45j(first, t1);
    when reallocation_priority_tier_45j(second, t2);
    when t1 < t2;
    then reallocated_before_45j(first, second);
}
rule ReallocatedBeforeByPlacedDateRule(first: Asset, second: Asset, d1: Date, d2: Date) strict {
    when reallocation_priority_tier_45j(first, 2.0);
    when reallocation_priority_tier_45j(second, 2.0);
    when facility_placed_in_service_on_45j_b5(first, d1);
    when facility_placed_in_service_on_45j_b5(second, d2);
    when d1 < d2;
    then reallocated_before_45j(first, second);
}
pub relation facility_receives_reallocation_45j(facility: Asset) kind empirical {
    label en official "the facility receives an allocation of unutilized national megawatt capacity limitation under paragraph (5) — case-asserted";
}
pub relation reallocation_treated_as_national_allocation_45j(facility: Asset) kind institutional {
    label en official "section 45J(b)(5)(C)(i): an allocation of unutilized limitation is treated for this section in the same manner as an allocation of national megawatt capacity limitation";
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "such allocation shall be treated for purposes of this section in the same manner as an allocation of national megawatt capacity limitation")
rule ReallocationTreatedAsNationalAllocationRule(facility: Asset) strict {
    when facility_receives_reallocation_45j(facility);
    then reallocation_treated_as_national_allocation_45j(facility);
}
pub relation subsection_d1b_disapplied_45j(facility: Asset) kind institutional {
    label en official "section 45J(b)(5)(C)(ii): subsection (d)(1)(B) does not apply to a facility which receives such an allocation";
}
@source(IRC_S45J_B, relation = formalizes, coverage = exact, quote = "subsection (d)(1)(B) shall not apply to any facility which receives such allocation")
rule SubsectionD1bDisapplied45jRule(facility: Asset) strict {
    when facility_receives_reallocation_45j(facility);
    then subsection_d1b_disapplied_45j(facility);
}

// --- (e)(3): partnership level credits -------------------------------------------------------------------------------------------------------------------------

pub relation credit_determined_at_partnership_level_45j(facility: Asset, partnership: Person) kind empirical {
    label en official "the credit under subsection (a) is determined at the partnership level — case-asserted";
}
pub relation partner_of_45j(partner: Person, partnership: Person) kind empirical {
    label en official "the person is a partner of the partnership — case-asserted";
}
pub relation entity_distributive_share_of_credit_45j(pub_entity: Person, partnership: Person, facility: Asset, amount: Money) kind empirical {
    label en official "the qualified public entity's distributive share of the credit — case-asserted";
}
pub relation public_entity_treated_as_taxpayer_for_distributive_share_45j(pub_entity: Person, facility: Asset, amount: Money) kind institutional {
    label en official "section 45J(e)(3)(A)(i): for a credit determined at the partnership level, the qualified public entity is treated as the taxpayer for its distributive share of the credit for paragraph (1)(A)";
}
@source(IRC_S45J_E, relation = formalizes, coverage = exact, quote = "a qualified public entity shall be treated as the taxpayer with respect to such entity's distributive share of such credit")
rule PublicEntityTreatedAsTaxpayerForDistributiveShareRule(pub_entity: Person, partnership: Person, facility: Asset, amount: Money) strict {
    when credit_determined_at_partnership_level_45j(facility, partnership);
    when qualified_public_entity_45j(pub_entity);
    when partner_of_45j(pub_entity, partnership);
    when entity_distributive_share_of_credit_45j(pub_entity, partnership, facility, amount);
    then public_entity_treated_as_taxpayer_for_distributive_share_45j(pub_entity, facility, amount);
}
pub relation eligible_project_partner_including_partners_45j(partner: Person, facility: Asset) kind institutional {
    label en official "section 45J(e)(3)(A)(ii): for a credit determined at the partnership level, the term eligible project partner includes any partner of the partnership";
}
@source(IRC_S45J_E, relation = formalizes, coverage = exact, quote = "the term \"eligible project partner\" shall include any partner of the partnership")
rule EligibleProjectPartnerIncludingPartnersRule(partner: Person, facility: Asset, partnership: Person) strict {
    when credit_determined_at_partnership_level_45j(facility, partnership);
    when partner_of_45j(partner, partnership);
    then eligible_project_partner_including_partners_45j(partner, facility);
}
pub relation entity_taxable_year_end_45j(pub_entity: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the last day of the qualified public entity's taxable year with respect to which the credit was determined — case-asserted";
}
pub relation partner_taxable_year_end_45j(partner: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the last day of the eligible project partner's taxable year — case-asserted";
}
pub relation credit_taken_into_account_in_partner_year_45j(partner: Person, pub_entity: Person, entity_year: TaxableYear, partner_year: TaxableYear) kind institutional {
    label en official "section 45J(e)(3)(B): a credit with respect to which an election is made is taken into account in the first taxable year of the eligible project partner ending with, or after, the qualified public entity's taxable year with respect to which the credit was determined";
}
@source(IRC_S45J_E, relation = formalizes, coverage = exact, quote = "such credit shall be taken into account in the first taxable year of the eligible project partner ending with, or after, the qualified public entity's taxable year with respect to which the credit was determined")
rule CreditTakenIntoAccountInPartnerYearRule(partner: Person, pub_entity: Person, entity_year: TaxableYear, partner_year: TaxableYear, entity_end: Date, partner_end: Date) strict {
    when entity_taxable_year_end_45j(pub_entity, entity_year, entity_end);
    when partner_taxable_year_end_45j(partner, partner_year, partner_end);
    when partner_end >= entity_end;
    when not_known(earlier_partner_year_ends_first_45j(partner, pub_entity, entity_year, partner_year));
    then credit_taken_into_account_in_partner_year_45j(partner, pub_entity, entity_year, partner_year);
}
pub relation other_partner_year_end_45j(partner: Person, on: Date) kind empirical {
    label en official "another taxable year of the partner ends on this date — case-asserted (used to identify the first year ending with or after the entity's year)";
}
relation earlier_partner_year_ends_first_45j(partner: Person, pub_entity: Person, entity_year: TaxableYear, partner_year: TaxableYear) kind institutional;
rule EarlierPartnerYearEndsFirstRule(partner: Person, pub_entity: Person, entity_year: TaxableYear, partner_year: TaxableYear, entity_end: Date, partner_end: Date, other: Date) strict {
    when entity_taxable_year_end_45j(pub_entity, entity_year, entity_end);
    when partner_taxable_year_end_45j(partner, partner_year, partner_end);
    when other_partner_year_end_45j(partner, other);
    when other >= entity_end;
    when other < partner_end;
    then earlier_partner_year_ends_first_45j(partner, pub_entity, entity_year, partner_year);
}
pub relation benefit_derived_by_partner_from_election_45j(partner: Person, facility: Asset) kind empirical {
    label en official "a benefit derived by the eligible project partner in connection with an election under subsection (e) — case-asserted";
}
pub relation benefit_not_private_business_use_45j(partner: Person, facility: Asset) kind institutional {
    label en official "section 45J(e)(3)(C): for section 141(b)(1), any benefit derived by an eligible project partner in connection with an election is not taken into account as private business use";
}
@source(IRC_S45J_E, relation = formalizes, coverage = exact, quote = "any benefit derived by an eligible project partner in connection with an election under this subsection shall not be taken into account as a private business use")
rule BenefitNotPrivateBusinessUseRule(partner: Person, facility: Asset) strict {
    when benefit_derived_by_partner_from_election_45j(partner, facility);
    then benefit_not_private_business_use_45j(partner, facility);
}
