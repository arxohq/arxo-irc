// Stage 4 (DECISION-0379 with deontics), credits, part I: section 45U definitions derived from
// records instead of asserted flat facts — the "zero-emission credit program" of (b)(2)(B)(ii),
// "electricity" of (b)(3), and the prevailing wage requirement of (d)(2)(A). Closes G6424.
//
// Each derived amount is an ALTERNATIVE channel to the asserted relation of module 45u, merged in a
// relation the credit reads (`..._for_credit_45u`); a case supplies either, never both. The rules of
// module 45u that read them became defeasible. JUDGMENT CALLS: the "reductions required under such
// program" are asserted per payment; the wage requirement is satisfied when at least one laborer or
// mechanic record exists and none is paid below its prevailing rate (the Secretary of Labor's
// determination of the rate is asserted per worker, EXTERNAL_DEPENDENCY).

use self::{
    Asset,
    Person,
    TaxableYear,
    kilowatt_hours_sold_45u,
    prevailing_wage_requirements_satisfied_45u,
    qualified_nuclear_power_facility_45u,
    zero_emission_credit_program_receipts_45u,
};

pub enum EnergySource45U {
    NuclearFuelConversion,
    OtherSource,
    label en official "the origin of the energy sold, for the definition of electricity in section 45U(b)(3)";
}
pub relation energy_sold_by_facility_45u(facility: Asset, y: TaxableYear, origin_kind: EnergySource45U, kwh: Decimal) kind empirical {
    label en official "kilowatt hours of electric energy sold in the taxable year, by the source of the energy — case-asserted";
}
pub relation electricity_kilowatt_hours_derived_45u(facility: Asset, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "electricity: the energy produced by the facility from the conversion of nuclear fuel into electric power (section 45U(b)(3)); the kilowatt hours sold of that source";
}
@origin_kind(IRC_S45U_B, quote = "For purposes of this section, the term \"electricity\" means the energy produced by a qualified nuclear power facility from the conversion of nuclear fuel into electric power.")
rule ElectricityFromNuclearFuelConversion45u(facility: Asset, y: TaxableYear, taxpayer: Person, kwh: Decimal) defeasible {
    label en official "only nuclear-fuel-conversion energy of a qualified nuclear power facility is electricity for section 45U (section 45U(b)(3))";
    when qualified_nuclear_power_facility_45u(facility, taxpayer);
    when energy_sold_by_facility_45u(facility, y, NuclearFuelConversion, kwh);
    then electricity_kilowatt_hours_derived_45u(facility, y, kwh);
}
pub relation electricity_kilowatt_hours_base_45u(facility: Asset, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "the kilowatt hours of electricity before the rules similar to section 45(e)(1), (4), (13): the asserted kilowatt hours sold or the derived ones";
}
rule ElectricityKwhAsserted45u(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    label en official "the asserted kilowatt hours (the earlier channel)";
    when kilowatt_hours_sold_45u(facility, y, kwh);
    then electricity_kilowatt_hours_base_45u(facility, y, kwh);
}
rule ElectricityKwhDerived45u(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    label en official "the derived kilowatt hours";
    when electricity_kilowatt_hours_derived_45u(facility, y, kwh);
    then electricity_kilowatt_hours_base_45u(facility, y, kwh);
}

// ---- (b)(2)(B)(ii): the zero-emission credit program ----

pub relation government_program_payment_45u(facility: Asset, y: TaxableYear, program: Integer, amount: Money) kind empirical {
    label en official "a payment with respect to the facility received in the taxable year under a Federal, State or local government program — case-asserted";
}
pub relation government_program_reduction_45u(facility: Asset, y: TaxableYear, program: Integer, amount: Money) kind empirical {
    label en official "a reduction required under the program that lowers the amount received in the taxable year (section 45U(b)(2)(B)(i)) — case-asserted";
}
pub relation program_pays_for_zero_emission_attributes_45u(program: Integer) kind empirical {
    label en official "the program pays, in whole or in part, for the zero-emission, zero-carbon, or air quality attributes of any portion of the electricity produced by the facility (section 45U(b)(2)(B)(ii))";
}
pub relation zero_emission_credit_program_45u(program: Integer) kind institutional {
    label en official "zero-emission credit program: a government program whose payments with respect to a qualified nuclear power facility are for the zero-emission, zero-carbon or air quality attributes of its electricity";
}
@origin_kind(IRC_S45U_B, quote = "For purposes of this subparagraph, the term \"zero-emission credit program\" means any payments with respect to a qualified nuclear power facility as a result of any Federal, State or local government program for, in whole or in part, the zero-emission, zero-carbon, or air quality attributes of any portion of the electricity produced by such facility.")
rule ZeroEmissionCreditProgramDefinition45u(program: Integer) defeasible {
    label en official "a program paying for those attributes (section 45U(b)(2)(B)(ii))";
    when program_pays_for_zero_emission_attributes_45u(program);
    then zero_emission_credit_program_45u(program);
}
pub relation program_payment_net_of_reductions_45u(facility: Asset, y: TaxableYear, program: Integer, amount: Money) kind institutional {
    label en official "the amount received in the taxable year from a zero-emission credit program, after the reductions required under the program (section 45U(b)(2)(B)(i))";
}
rule ProgramPaymentNetOfReductions45u(facility: Asset, y: TaxableYear, program: Integer, paid: Money, reduction: Money) defeasible {
    label en official "payment - required reductions, not below zero";
    when government_program_payment_45u(facility, y, program, paid);
    when zero_emission_credit_program_45u(program);
    when government_program_reduction_45u(facility, y, program, reduction);
    then program_payment_net_of_reductions_45u(facility, y, program, max(0 USD, paid - reduction));
}
relation program_reduction_present_45u(facility: Asset, y: TaxableYear, program: Integer) kind institutional {
    label en official "bridge: a reduction is asserted for the program payment";
}
rule ProgramReductionPresent45u(facility: Asset, y: TaxableYear, program: Integer, reduction: Money) defeasible {
    label en official "bridge for the absence test";
    when government_program_reduction_45u(facility, y, program, reduction);
    then program_reduction_present_45u(facility, y, program);
}
rule ProgramPaymentWithoutReductions45u(facility: Asset, y: TaxableYear, program: Integer, paid: Money) defeasible {
    label en official "no reduction: the whole payment";
    when government_program_payment_45u(facility, y, program, paid);
    when zero_emission_credit_program_45u(program);
    when not_known(program_reduction_present_45u(facility, y, program));
    then program_payment_net_of_reductions_45u(facility, y, program, paid);
}
pub relation zero_emission_program_receipts_derived_45u(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amounts received in the taxable year from zero-emission credit programs with respect to the facility, net of the required reductions";
}
rule ZeroEmissionProgramReceiptsDerived45u(facility: Asset, y: TaxableYear, program: Integer, amount: Money) defeasible {
    label en official "sum over the zero-emission credit programs";
    when program_payment_net_of_reductions_45u(facility, y, program, amount);
    then zero_emission_program_receipts_derived_45u(facility, y,
        sum(collect all a: Money, p: Integer where program_payment_net_of_reductions_45u(facility, y, p, a), empty: 0 USD));
}
pub relation zero_emission_program_receipts_for_credit_45u(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the program receipts the credit reads: the asserted amount or the derived one";
}
rule ZeroEmissionProgramReceiptsAsserted45u(facility: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the asserted amount (the earlier channel)";
    when zero_emission_credit_program_receipts_45u(facility, y, amount);
    then zero_emission_program_receipts_for_credit_45u(facility, y, amount);
}
rule ZeroEmissionProgramReceiptsFromRecords45u(facility: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the derived amount";
    when zero_emission_program_receipts_derived_45u(facility, y, amount);
    then zero_emission_program_receipts_for_credit_45u(facility, y, amount);
}

// ---- (d)(2)(A): the prevailing wage requirement ----

pub relation laborer_or_mechanic_wage_paid_45u(facility: Asset, y: TaxableYear, worker: Integer, rate_paid: Decimal) kind empirical {
    label en official "the hourly wage rate paid to a laborer or mechanic employed by the taxpayer or any contractor or subcontractor in the alteration or repair of the facility (section 45U(d)(2)(A)) — case-asserted";
}
pub relation prevailing_rate_for_worker_45u(worker: Integer, rate: Decimal) kind empirical {
    label en official "the prevailing rate for alteration or repair of a similar character in the locality, as most recently determined by the Secretary of Labor (Davis-Bacon): EXTERNAL_DEPENDENCY, asserted per worker";
}
pub relation laborer_paid_below_prevailing_rate_45u(facility: Asset, y: TaxableYear) kind institutional {
    label en official "some laborer or mechanic is paid less than the prevailing rate";
}
rule LaborerPaidBelowPrevailingRate45u(facility: Asset, y: TaxableYear, worker: Integer, paid: Decimal, rate: Decimal) defeasible {
    label en official "a wage below the prevailing rate";
    when laborer_or_mechanic_wage_paid_45u(facility, y, worker, paid);
    when prevailing_rate_for_worker_45u(worker, rate);
    when paid < rate;
    then laborer_paid_below_prevailing_rate_45u(facility, y);
}
@origin_kind(IRC_S45U_D, quote = "The requirements described in this subparagraph with respect to any qualified nuclear power facility are that the taxpayer shall ensure that any laborers and mechanics employed by the taxpayer or any contractor or subcontractor in the alteration or repair of such facility shall be paid wages at rates not less than the prevailing rates")
rule PrevailingWageRequirementFromWageRecords45u(facility: Asset, y: TaxableYear, worker: Integer, paid: Decimal, rate: Decimal) defeasible {
    label en official "at least one laborer or mechanic and none paid below the prevailing rate (section 45U(d)(2)(A)); alternative channel to the asserted fact";
    when laborer_or_mechanic_wage_paid_45u(facility, y, worker, paid);
    when prevailing_rate_for_worker_45u(worker, rate);
    when not_known(laborer_paid_below_prevailing_rate_45u(facility, y));
    then prevailing_wage_requirements_satisfied_45u(facility, y);
}
