// Aggregate nonrefundable/refundable credit totals across the stage-1
// sections of this package. This module is NOT itself an anchored
// disposition of any one section of the pinned text — it is the assembly
// point AGENT-BRIEF's requested `nonrefundable_credits_total`/
// `refundable_credits_total` interface, drawing on §26's limitation and the
// per-section credit relations of the other modules in this package.
//
// Ordering caveat (see 26-limitation-on-credits.law): the section 26(a)
// limitation, and each carryforward-eligible credit's OWN "applicable tax
// limit" (sections 23(c)(1)(C), 25(e)(1)(C)), depend on the SUM of the
// OTHER subpart A credits — a mutually referential ordering this package
// does not fully resolve this pass (recorded as TECH_GAP: the aggregate
// below is the sum of each credit's OWN rule output, not a fixed-point
// solution of the joint carryforward/limitation system).


// --- Zero-defaulting wrappers for the aggregate totals below (coordinator follow-up, 25.09.2026) ---

use self::{
    IRC_S26_A,
    Individual,
    Person,
    TaxableYear,
    adoption_credit,
    child_tax_credit,
    dependent_care_credit,
    earned_income_credit,
    education_credit,
    elderly_and_disabled_credit,
    mortgage_credit_certificate_credit,
    nra_withholding_credit,
    refundable_american_opportunity_credit,
    refundable_child_tax_credit,
    savers_credit,
    section_26a_limitation,
    wage_withholding_credit,
};

relation dependent_care_credit_or_zero(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "dependent_care_credit, defaulting to zero when this package's rules for it do not fire (used only for the credits-total aggregation)";
}
relation has_dependent_care_credit(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "existence flag for dependent_care_credit";
}
rule HasDependentCareCredit(taxpayer: Individual, y: TaxableYear, amount: Money) defeasible {
    when dependent_care_credit(taxpayer, y, amount);
    then has_dependent_care_credit(taxpayer, y);
}
rule DependentCareCreditOrZeroPresent(taxpayer: Individual, y: TaxableYear, amount: Money) defeasible {
    when dependent_care_credit(taxpayer, y, amount);
    then dependent_care_credit_or_zero(taxpayer, y, amount);
}
rule DependentCareCreditOrZeroAbsent(taxpayer: Individual, y: TaxableYear) defeasible {
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    when not_known(has_dependent_care_credit(taxpayer, y));
    then dependent_care_credit_or_zero(taxpayer, y, 0 USD);
}

