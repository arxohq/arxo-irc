pub relation nonrefundable_personal_credits_total(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the nonrefundable subpart A personal credits this package computes for the taxable year, before the section 26(a) aggregate limitation";
}
@source(IRC_S26_A, relation = formalizes, coverage = contextual, quote = "The aggregate amount of credits allowed by this subpart for the taxable year shall not exceed the sum of")
rule NonrefundablePersonalCreditsTotal(taxpayer: Individual, y: TaxableYear,
        dependentCare: Money, elderly: Money, adoption: Money, mcc: Money,
        education: Money, savers: Money, childTaxCredit: Money) defeasible {
    label en official "the sum of the section 21, 22, 23, 25, 25A (nonrefundable portion), 25B, and 24 (nonrefundable portion) credits; a credit this package's own rules do not derive for the taxpayer/year defaults to zero here (via the _or_zero wrappers above) rather than making the WHOLE total NEITHER";
    when dependent_care_credit_or_zero(taxpayer, y, dependentCare);
    when elderly_and_disabled_credit_or_zero(taxpayer, y, elderly);
    when adoption_credit_or_zero(taxpayer, y, adoption);
    when mortgage_credit_certificate_credit_or_zero(taxpayer, y, mcc);
    when education_credit_or_zero(taxpayer, y, education);
    when savers_credit_or_zero(taxpayer, y, savers);
    when child_tax_credit_or_zero(taxpayer, y, childTaxCredit);
    then nonrefundable_personal_credits_total(taxpayer, y,
        dependentCare + elderly + adoption + mcc + education + savers + childTaxCredit);
}

pub relation nonrefundable_credits_total(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the nonrefundable subpart A credits actually allowed for the taxable year, after the section 26(a) limitation (section 26(a))";
}
@source(IRC_S26_A, quote = "The aggregate amount of credits allowed by this subpart for the taxable year shall not exceed the sum of")
rule NonrefundableCreditsTotalLimited(taxpayer: Individual, y: TaxableYear, before: Money, cap: Money) defeasible {
    label en official "the allowed nonrefundable total is the lesser of the sum of the individual credits and the section 26(a) limitation";
    when nonrefundable_personal_credits_total(taxpayer, y, before);
    when section_26a_limitation(taxpayer, y, cap);
    then nonrefundable_credits_total(taxpayer, y, min(before, cap));
}

pub relation refundable_credits_total(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the refundable credits this package computes for the taxable year: the additional (refundable) child tax credit, 40 percent of the AOTC, the earned income credit, the wage-withholding and NRA-withholding credits, and (for 2021 only) the reallocated dependent-care and child-tax credits";
}
rule RefundableCreditsTotal(taxpayer: Individual, y: TaxableYear,
        actc: Money, refundableAotc: Money, eic: Money, wageWithholding: Money, nraWithholding: Money) defeasible {
    label en official "the refundable total is the sum of the ACTC, the refundable 40 percent of AOTC, the EIC, and the withholding credits of sections 31 and 33; a component this package's own rules do not derive defaults to zero (via the _or_zero wrappers above)";
    when refundable_child_tax_credit_or_zero(taxpayer, y, actc);
    when refundable_american_opportunity_credit_or_zero(taxpayer, y, refundableAotc);
    when earned_income_credit_or_zero(taxpayer, y, eic);
    when wage_withholding_credit_or_zero(taxpayer, y, wageWithholding);
    when nra_withholding_credit_or_zero(taxpayer, y, nraWithholding);
    then refundable_credits_total(taxpayer, y, actc + refundableAotc + eic + wageWithholding + nraWithholding);
}
// The 2021-only reallocations of section 21(g)(1) (dependent care) and
// section 24(i)(1) (child tax credit) move an ALREADY-COMPUTED nonrefundable
// amount into the refundable column rather than computing a new amount;
// wiring that reallocation into `refundable_credits_total`/
// `nonrefundable_personal_credits_total` for 2021 specifically is recorded
// as a follow-up (TECH_GAP on the AGGREGATION, not on the underlying
// `dependent_care_credit_refundable_2021`/`refundable_child_tax_credit`
// (ARPA branch) rules, which are already modelled in their own modules).
