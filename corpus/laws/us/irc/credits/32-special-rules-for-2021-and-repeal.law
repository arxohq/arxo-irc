// Section 32 — the (n) special rules for taxable years beginning in 2021: the applicable minimum age, specified student, qualified former foster
// youth and qualified homeless youth definitions, the removal of the upper age limit, and the increased credit percentage and amounts for
// individuals without qualifying children. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391).
// Companion of `32-earned-income-credit.law`; its 2021 no-children credit
// rules (`EligibleIndividualWithoutQualifyingChild2021`,
// `EarnedIncomeCredit2021NoChildren`) consult these relations.
// Subsection (g) is repealed.
//
// Judgment calls: the taxable years of (n) are identified by the asserted first day of the taxable year (2021-01-01 to 2021-12-31); the ages
// are asserted ages attained by the close of the year; the eligible student months are an asserted count; the certification of a qualified
// homeless youth is a case fact; the amounts of (n)(4) are constants of the special table.

// --- (n): the taxable years ---------------------------------------------------------------------------------------------------------------------------------

use self::{
    IRC_S32_N,
    Individual,
    TaxableYear,
};

pub relation taxable_year_begin_32n(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year — case-asserted";
}
pub relation year_in_2021_special_rules_32n(y: TaxableYear) kind institutional {
    label en official "section 32(n): a taxable year beginning after December 31, 2020, and before January 1, 2022";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "In the case of any taxable year beginning after December 31, 2020, and before January 1, 2022")
rule YearIn2021SpecialRulesRule(y: TaxableYear, begin: Date) strict {
    when taxable_year_begin_32n(y, begin);
    when begin > @2020-12-31;
    when begin < @2022-01-01;
    then year_in_2021_special_rules_32n(y);
}

// --- (n)(1)(C)-(E): specified student, qualified former foster youth, qualified homeless youth -------------------------------------------------------

pub relation eligible_student_calendar_months_32n(taxpayer: Individual, y: TaxableYear, months: Decimal) kind empirical {
    label en official "the number of calendar months during the taxable year in which the individual is an eligible student (as defined in section 25A(b)(3)) (section 32(n)(1)(C)) — case-asserted";
}
pub relation specified_student_32n(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 32(n)(1)(C): an individual who is an eligible student (section 25A(b)(3)) during at least 5 calendar months during the taxable year";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "an individual who is an eligible student (as defined in section 25A(b)(3)) during at least 5 calendar months during the taxable year")
rule SpecifiedStudentRule(taxpayer: Individual, y: TaxableYear, months: Decimal) strict {
    when eligible_student_calendar_months_32n(taxpayer, y, months);
    when months >= 5.0;
    then specified_student_32n(taxpayer, y);
}
pub relation in_foster_care_on_or_after_age_14_under_title_iv_plan_32n(taxpayer: Individual) kind empirical {
    label en official "on or after the date the individual attained age 14, the individual was in foster care under the supervision or administration of an entity administering (or eligible to administer) a plan under part B or E of title IV of the Social Security Act (section 32(n)(1)(D)(i)) — case-asserted";
}
pub relation consent_to_disclose_foster_status_to_secretary_32n(taxpayer: Individual) kind empirical {
    label en official "the individual provides consent for entities administering a title IV plan to disclose to the Secretary information related to the individual's status as a qualified former foster youth (section 32(n)(1)(D)(ii)) — case-asserted";
}
pub relation qualified_former_foster_youth_32n(taxpayer: Individual) kind institutional {
    label en official "section 32(n)(1)(D): an individual who, on or after age 14, was in foster care under a title IV plan and consents to disclosure of that status to the Secretary";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "the term \"qualified former foster youth\" means an individual who")
rule QualifiedFormerFosterYouthRule(taxpayer: Individual) strict {
    when in_foster_care_on_or_after_age_14_under_title_iv_plan_32n(taxpayer);
    when consent_to_disclose_foster_status_to_secretary_32n(taxpayer);
    then qualified_former_foster_youth_32n(taxpayer);
}
pub relation certifies_unaccompanied_homeless_youth_32n(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the individual certifies, in a manner provided by the Secretary, that the individual is an unaccompanied youth who is a homeless child or youth (section 32(n)(1)(E)) — case-asserted";
}
pub relation certifies_unaccompanied_at_risk_and_self_supporting_32n(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the individual certifies that the individual is unaccompanied, at risk of homelessness, and self-supporting (section 32(n)(1)(E)) — case-asserted";
}
pub relation qualified_homeless_youth_32n(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 32(n)(1)(E): an individual who certifies that the individual is an unaccompanied homeless youth, or is unaccompanied, at risk of homelessness, and self-supporting";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "an individual who certifies, in a manner as provided by the Secretary, that such individual is either an unaccompanied youth who is a homeless child or youth")
rule QualifiedHomelessYouthUnaccompaniedRule(taxpayer: Individual, y: TaxableYear) strict {
    when certifies_unaccompanied_homeless_youth_32n(taxpayer, y);
    then qualified_homeless_youth_32n(taxpayer, y);
}
rule QualifiedHomelessYouthAtRiskRule(taxpayer: Individual, y: TaxableYear) strict {
    when certifies_unaccompanied_at_risk_and_self_supporting_32n(taxpayer, y);
    then qualified_homeless_youth_32n(taxpayer, y);
}

// --- (n)(1)(A)-(B), (n)(2): the applicable minimum age and the age limit --------------------------------------------------------------------------------

relation foster_or_homeless_youth_32n(taxpayer: Individual, y: TaxableYear) kind institutional;
rule FosterOrHomelessYouthFosterRule(taxpayer: Individual, y: TaxableYear) strict {
    when year_in_2021_special_rules_32n(y);
    when qualified_former_foster_youth_32n(taxpayer);
    then foster_or_homeless_youth_32n(taxpayer, y);
}
rule FosterOrHomelessYouthHomelessRule(taxpayer: Individual, y: TaxableYear) strict {
    when year_in_2021_special_rules_32n(y);
    when qualified_homeless_youth_32n(taxpayer, y);
    then foster_or_homeless_youth_32n(taxpayer, y);
}
pub relation applicable_minimum_age_32n(taxpayer: Individual, y: TaxableYear, age: Decimal) kind institutional {
    label en official "section 32(n)(1)(B): age 19; for a specified student (other than a qualified former foster youth or a qualified homeless youth) age 24; for a qualified former foster youth or a qualified homeless youth age 18";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "in the case of a qualified former foster youth or a qualified homeless youth, age 18")
rule ApplicableMinimumAge18Rule(taxpayer: Individual, y: TaxableYear) strict {
    when foster_or_homeless_youth_32n(taxpayer, y);
    then applicable_minimum_age_32n(taxpayer, y, 18.0);
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "in the case of a specified student (other than a qualified former foster youth or a qualified homeless youth), age 24")
rule ApplicableMinimumAge24Rule(taxpayer: Individual, y: TaxableYear) strict {
    when year_in_2021_special_rules_32n(y);
    when specified_student_32n(taxpayer, y);
    when not_known(foster_or_homeless_youth_32n(taxpayer, y));
    then applicable_minimum_age_32n(taxpayer, y, 24.0);
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "except as otherwise provided in this subparagraph, age 19")
rule ApplicableMinimumAge19Rule(taxpayer: Individual, y: TaxableYear, age: Decimal) strict {
    when year_in_2021_special_rules_32n(y);
    when age_attained_by_close_of_year_32n(taxpayer, y, age);
    when not_known(specified_student_32n(taxpayer, y));
    when not_known(foster_or_homeless_youth_32n(taxpayer, y));
    then applicable_minimum_age_32n(taxpayer, y, 19.0);
}
pub relation age_attained_by_close_of_year_32n(taxpayer: Individual, y: TaxableYear, age: Decimal) kind empirical {
    label en official "the age the individual attains by the close of the taxable year — case-asserted";
}
pub relation meets_special_age_test_32n(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 32(n)(1)(A), (2): the individual has attained the applicable minimum age (in place of age 25), and there is no upper age limit (the phrase but not attained age 65 does not apply)";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "Subsection (c)(1)(A)(ii)(II) shall be applied without regard to the phrase \"but not attained age 65\".")
rule MeetsSpecialAgeTestRule(taxpayer: Individual, y: TaxableYear, minimum: Decimal, age: Decimal) strict {
    when applicable_minimum_age_32n(taxpayer, y, minimum);
    when age_attained_by_close_of_year_32n(taxpayer, y, age);
    when age >= minimum;
    then meets_special_age_test_32n(taxpayer, y);
}

// --- (n)(3)-(4): the credit percentage and the amounts --------------------------------------------------------------------------------------------------

pub relation special_credit_percentage_no_children_32n(y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 32(n)(3): the table of subsection (b)(1) is applied by substituting 15.3 for 7.65, so the credit percentage for an individual without qualifying children is 15.3 percent";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "The table contained in subsection (b)(1) shall be applied by substituting \"15.3\" for \"7.65\" each place it appears therein.")
rule SpecialCreditPercentageNoChildrenRule(y: TaxableYear) strict {
    when year_in_2021_special_rules_32n(y);
    then special_credit_percentage_no_children_32n(y, 0.153);
}
pub relation special_earned_income_amount_no_children_32n(y: TaxableYear, amount: Money) kind institutional {
    label en official "section 32(n)(4)(A)(i): the earned income amount of the table of subsection (b)(2)(A) is $9,820 in place of $4,220";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "by substituting \"$9,820\" for \"$4,220\"")
rule SpecialEarnedIncomeAmountNoChildrenRule(y: TaxableYear) strict {
    when year_in_2021_special_rules_32n(y);
    then special_earned_income_amount_no_children_32n(y, 9820.00 USD);
}
pub relation special_phaseout_amount_no_children_32n(y: TaxableYear, amount: Money) kind institutional {
    label en official "section 32(n)(4)(A)(ii): the phaseout amount of the table of subsection (b)(2)(A) is $11,610 in place of $5,280";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "by substituting \"$11,610\" for \"$5,280\"")
rule SpecialPhaseoutAmountNoChildrenRule(y: TaxableYear) strict {
    when year_in_2021_special_rules_32n(y);
    then special_phaseout_amount_no_children_32n(y, 11610.00 USD);
}
pub relation cost_of_living_adjustment_disapplied_32n(y: TaxableYear) kind institutional {
    label en official "section 32(n)(4)(B): subsection (j) (inflation adjustment) does not apply to any dollar amount specified in paragraph (4)";
}
@source(IRC_S32_N, relation = formalizes, coverage = exact, quote = "Subsection (j) shall not apply to any dollar amount specified in this paragraph.")
rule CostOfLivingAdjustmentDisapplied32nRule(y: TaxableYear) strict {
    when year_in_2021_special_rules_32n(y);
    then cost_of_living_adjustment_disapplied_32n(y);
}
