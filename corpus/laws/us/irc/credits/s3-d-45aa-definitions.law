// Stage 3 (TECH_GAP reduction): section 45AA(d) military spouse and (e) eligible defined
// contribution plan are derived from their component tests. The credit rules of
// 45aa-military-spouse-retirement-plan-credit.law read `military_spouse_45aa` and
// `eligible_plan_45aa`; the older case facts `military_spouse_of_employer_45aa` and
// `eligible_defined_contribution_plan_terms_met_45aa` remain as an alternative input (a case that
// asserts the whole definition as one fact). (c) eligible small employer stays a case fact:
// section 408(p)(2)(C)(i)(I) belongs to a package this one does not import (EXTERNAL_DEPENDENCY).
// (f) aggregation of employers under section 414(b), (c), (m), (o): not modelled (G6212).
// STATUS: implemented_unverified (static check only).

use self::{
    IRC_S45AA_D,
    IRC_S45AA_E,
    Individual,
    Person,
    TaxableYear,
    eligible_defined_contribution_plan_terms_met_45aa,
    military_spouse_of_employer_45aa,
};

pub relation married_to_active_duty_uniformed_member_45aa(employee: Individual, employer: Person) kind empirical {
    label en official "section 45AA(d)(1): the employee is married (within the meaning of section 7703 as of the first date of employment by the employer) to a member of the uniformed services (section 101(a)(5) of title 10) serving on active duty; the employer may rely on the employee's certification — case-asserted";
}
pub relation highly_compensated_employee_of_employer_45aa(employee: Individual, employer: Person) kind empirical {
    label en official "section 45AA(d)(2): the individual is a highly compensated employee of the employer within the meaning of section 414(q) — case-asserted, EXTERNAL_DEPENDENCY on section 414(q)";
}
pub relation military_spouse_45aa(employee: Individual, employer: Person) kind institutional {
    label en official "section 45AA(d): a military spouse with respect to the employer: married to a member of the uniformed services on active duty and not a highly compensated employee";
}
@source(IRC_S45AA_D, relation = formalizes, coverage = exact, quote = "The term \"military spouse\" means, with respect to any employer, any individual who is married")
rule MilitarySpouse45aaComponentsRule(employee: Individual, employer: Person) defeasible {
    label en official "section 45AA(d)(1), (2): married to a member on active duty and not a highly compensated employee";
    when married_to_active_duty_uniformed_member_45aa(employee, employer);
    when not_known(highly_compensated_employee_of_employer_45aa(employee, employer));
    then military_spouse_45aa(employee, employer);
}
rule MilitarySpouse45aaAssertedRule(employee: Individual, employer: Person) defeasible {
    label en official "section 45AA(d): the definition asserted as one fact";
    when military_spouse_of_employer_45aa(employee, employer);
    then military_spouse_45aa(employee, employer);
}

pub relation plan_admits_military_spouses_within_two_months_45aa(employer: Person, y: TaxableYear) kind empirical {
    label en official "section 45AA(e)(1): under the plan terms, military spouses employed by the employer are eligible to participate not later than 2 months after they begin employment — case-asserted";
}
pub relation plan_immediate_employer_contribution_eligibility_45aa(employer: Person, y: TaxableYear) kind empirical {
    label en official "section 45AA(e)(2)(A): military spouses eligible to participate are immediately eligible for an amount of employer contributions not less than a similarly situated participant who is not a military spouse would be eligible for after 2 years of service — case-asserted";
}
pub relation plan_immediate_vesting_of_employer_contributions_45aa(employer: Person, y: TaxableYear) kind empirical {
    label en official "section 45AA(e)(2)(B): military spouses eligible to participate immediately have a nonforfeitable right to the accrued benefit derived from employer contributions — case-asserted";
}
pub relation eligible_plan_45aa(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45AA(e): a defined contribution plan of the eligible small employer whose terms satisfy (1) and (2)(A)-(B)";
}
@source(IRC_S45AA_E, relation = formalizes, coverage = exact, quote = "(1) military spouses employed by such employer are eligible to participate in such plan not later than the date which is 2 months after the date on which such individual begins employment with such employer, and")
rule EligiblePlan45aaComponentsRule(employer: Person, y: TaxableYear) defeasible {
    label en official "section 45AA(e)(1), (2)(A), (2)(B): the three plan terms are all met";
    when plan_admits_military_spouses_within_two_months_45aa(employer, y);
    when plan_immediate_employer_contribution_eligibility_45aa(employer, y);
    when plan_immediate_vesting_of_employer_contributions_45aa(employer, y);
    then eligible_plan_45aa(employer, y);
}
rule EligiblePlan45aaAssertedRule(employer: Person, y: TaxableYear) defeasible {
    label en official "section 45AA(e): the plan terms asserted as one fact";
    when eligible_defined_contribution_plan_terms_met_45aa(employer, y);
    then eligible_plan_45aa(employer, y);
}
