// Section 45I — Credit for producing oil and gas from marginal wells. Stage 2d
// (IRC-06, DECISION-0379).
//
// Scope / judgment calls:
// * (b)(1): $3 per barrel of qualified crude oil production and 50 cents per
//   1,000 cubic feet of qualified natural gas production. (b)(2)(A): each amount
//   is reduced (not below zero) by the ratio of the excess of the reference
//   price of the preceding calendar year over $15 ($1.67 for gas) to $3 ($0.33
//   for gas); for taxable years beginning after 2005 those dollar amounts are
//   indexed by the inflation adjustment factor (case-asserted, not pinned,
//   TECH-GAPS G1543).
// * (c)(2): production of a well above 1,095 barrels of oil equivalent a year
//   is not qualified; the limit is reduced for the days the well is not capable
//   of production (and for a short year, days/365): limit = 1,095 x production
//   days / 365. The excess is removed pro rata from crude oil and gas: the text
//   does not say which product bears the excess (INTERPRETATION row, G1543).
// * (c)(3): qualified marginal well: marginal production under section
//   613A(c)(6), or at most 25 barrel-of-oil equivalents a day and water at
//   least 95 percent of effluent. The barrel-of-oil equivalent of gas (5.8
//   million Btu) is applied by the case.
// * (d): the credit goes to the holder of an operating interest, by revenue
//   interest ratio; a well eligible for the section 45K credit gets this credit
//   only if the taxpayer elects not to claim section 45K.

use self::{
    Asset,
    IRC_S45I_A,
    IRC_S45I_B,
    IRC_S45I_C,
    IRC_S45I_D,
    Person,
    TaxableYear,
};

pub relation marginal_production_under_613a_c6_45i(well: Asset, y: TaxableYear) kind empirical {
    label en official "the production from the well during the taxable year is treated as marginal production under section 613A(c)(6) (section 45I(c)(3)(A)(i)) — case-asserted";
}
pub relation well_average_daily_boe_45i(well: Asset, y: TaxableYear, boe: Decimal) kind empirical {
    label en official "the average daily production of the well in barrel-of-oil equivalents (section 45I(c)(3)(A)(ii)(I)) — case-asserted";
}
pub relation well_water_percent_of_effluent_45i(well: Asset, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the rate at which the well produces water, as a percentage of total well effluent (section 45I(c)(3)(A)(ii)(II)) — case-asserted";
}
pub relation well_production_45i(well: Asset, y: TaxableYear, barrels: Decimal, mcf: Decimal, gas_boe: Decimal) kind empirical {
    label en official "production of the well for the taxable year: barrels of domestic crude oil, thousands of cubic feet of domestic natural gas, and the barrel-of-oil equivalents of that gas (5.8 million Btu each) — case-asserted";
}
pub relation well_days_of_production_45i(well: Asset, y: TaxableYear, days: Decimal) kind empirical {
    label en official "the number of days in the taxable year the well is capable of production, at most the days in the year (section 45I(c)(2)(B)) — case-asserted";
}
pub relation holds_operating_interest_45i(taxpayer: Person, well: Asset) kind empirical {
    label en official "the taxpayer holds an operating interest in the well (section 45I(d)(2)) — case-asserted";
}
pub relation revenue_interest_ratio_45i(taxpayer: Person, well: Asset, y: TaxableYear, ratio: Decimal) kind empirical {
    label en official "the ratio of the taxpayer's revenue interest in the production to the aggregate revenue interests of all operating interest owners (section 45I(d)(1)); 1.0 for a sole owner — case-asserted";
}
pub relation reference_price_crude_preceding_year_45i(y: TaxableYear, price: Decimal) kind empirical {
    label en official "the reference price of the calendar year preceding the year in which the taxable year begins, for crude oil (section 45K(d)(2)(C)) — case-asserted, not pinned";
}
pub relation reference_price_gas_preceding_year_45i(y: TaxableYear, price: Decimal) kind empirical {
    label en official "the Secretary's estimate of the annual average wellhead price per 1,000 cubic feet for all domestic natural gas of the preceding calendar year (section 45I(b)(2)(C)(ii)) — case-asserted, not pinned";
}
pub relation inflation_adjustment_factor_45i(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor for the calendar year under section 43(b)(3)(B) with 2004 substituted for 1990 (section 45I(b)(2)(B)) — case-asserted, not pinned";
}
pub relation eligible_for_section_45k_credit_for_well_45i(taxpayer: Person, well: Asset, y: TaxableYear) kind empirical {
    label en official "the production of the well is eligible for the section 45K credit for the taxable year (section 45I(d)(3)) — case-asserted";
}
pub relation elects_not_to_claim_section_45k_for_well_45i(taxpayer: Person, well: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects not to claim the section 45K credit with respect to the well (section 45I(d)(3)) — case-asserted";
}

pub relation qualified_marginal_well_45i(well: Asset, y: TaxableYear) kind institutional {
    label en official "section 45I(c)(3): a domestic well with marginal production, or at most 25 barrel-of-oil equivalents a day and at least 95 percent water";
}
@source(IRC_S45I_C, quote = "the production from which during the taxable year is treated as marginal production under section 613A(c)(6)")
rule QualifiedMarginalWellByMarginalProduction45iRule(well: Asset, y: TaxableYear) strict {
    when marginal_production_under_613a_c6_45i(well, y);
    then qualified_marginal_well_45i(well, y);
}
@source(IRC_S45I_C, quote = "has average daily production of not more than 25 barrel-of-oil equivalents (as so defined)")
rule QualifiedMarginalWellByProductionAndWater45iRule(well: Asset, y: TaxableYear, boe: Decimal, water: Decimal) strict {
    when well_average_daily_boe_45i(well, y, boe);
    when boe <= 25.0;
    when well_water_percent_of_effluent_45i(well, y, water);
    when water >= 95.0;
    then qualified_marginal_well_45i(well, y);
}

// --- (c)(2): the production limit ------------------------------------------------------------------

pub relation qualified_production_fraction_45i(well: Asset, y: TaxableYear, fraction: Decimal) kind institutional {
    label en official "section 45I(c)(2): the fraction of the well's production within the 1,095 barrel-of-oil-equivalent limit (reduced for days without production and for a short year)";
}
@source(IRC_S45I_C, quote = "exceeds 1,095 barrels or barrel-of-oil equivalents")
rule QualifiedProductionFractionLimited45iRule(well: Asset, y: TaxableYear, barrels: Decimal, mcf: Decimal, gas_boe: Decimal, days: Decimal) strict {
    when well_production_45i(well, y, barrels, mcf, gas_boe);
    when well_days_of_production_45i(well, y, days);
    when barrels + gas_boe > div_round(1095.0 * days, 365.0, 10, "HALF_UP");
    then qualified_production_fraction_45i(well, y, div_round(div_round(1095.0 * days, 365.0, 10, "HALF_UP"), barrels + gas_boe, 10, "HALF_UP"));
}
rule QualifiedProductionFractionWithinLimit45iRule(well: Asset, y: TaxableYear, barrels: Decimal, mcf: Decimal, gas_boe: Decimal, days: Decimal) strict {
    when well_production_45i(well, y, barrels, mcf, gas_boe);
    when well_days_of_production_45i(well, y, days);
    when barrels + gas_boe <= div_round(1095.0 * days, 365.0, 10, "HALF_UP");
    then qualified_production_fraction_45i(well, y, 1.0);
}

// --- (b)(2): the credit amounts -----------------------------------------------------------------------

pub relation crude_oil_credit_amount_per_barrel_45i(y: TaxableYear, amount: Decimal) kind institutional {
    label en official "section 45I(b)(1)(A), (b)(2): $3 per barrel reduced by the excess of the reference price over the indexed $15, over the indexed $3";
}
relation crude_thresholds_45i(y: TaxableYear, floor_price: Decimal, span: Decimal) kind institutional;
rule CrudeThresholdsBefore2006Rule(y: TaxableYear, begin: Date, price: Decimal) strict {
    when reference_price_crude_preceding_year_45i(y, price);
    when us.irc.core::begins(y, begin);
    when begin <= @2005-12-31;
    then crude_thresholds_45i(y, 15.0, 3.0);
}
@source(IRC_S45I_B, quote = "In the case of any taxable year beginning in a calendar year after 2005, each of the dollar amounts contained in subparagraph (A) shall be increased to an amount equal to such dollar amount multiplied by the inflation adjustment factor")
rule CrudeThresholdsAfter2005Rule(y: TaxableYear, begin: Date, price: Decimal, factor: Decimal) strict {
    when reference_price_crude_preceding_year_45i(y, price);
    when us.irc.core::begins(y, begin);
    when begin > @2005-12-31;
    when inflation_adjustment_factor_45i(y, factor);
    then crude_thresholds_45i(y, 15.0 * factor, 3.0 * factor);
}
@source(IRC_S45I_B, quote = "$3 per barrel of qualified crude oil production")
rule CrudeOilCreditAmount45iRule(y: TaxableYear, price: Decimal, floor_price: Decimal, span: Decimal) strict {
    when reference_price_crude_preceding_year_45i(y, price);
    when crude_thresholds_45i(y, floor_price, span);
    then crude_oil_credit_amount_per_barrel_45i(y, 3.0 * (1.0 - min(1.0, max(0.0, div_round(price - floor_price, span, 10, "HALF_UP")))));
}
pub relation gas_credit_amount_per_mcf_45i(y: TaxableYear, amount: Decimal) kind institutional {
    label en official "section 45I(b)(1)(B), (b)(2): 50 cents per 1,000 cubic feet reduced by the excess of the reference price over the indexed $1.67, over the indexed $0.33";
}
relation gas_thresholds_45i(y: TaxableYear, floor_price: Decimal, span: Decimal) kind institutional;
rule GasThresholdsBefore2006Rule(y: TaxableYear, begin: Date, price: Decimal) strict {
    when reference_price_gas_preceding_year_45i(y, price);
    when us.irc.core::begins(y, begin);
    when begin <= @2005-12-31;
    then gas_thresholds_45i(y, 1.67, 0.33);
}
rule GasThresholdsAfter2005Rule(y: TaxableYear, begin: Date, price: Decimal, factor: Decimal) strict {
    when reference_price_gas_preceding_year_45i(y, price);
    when us.irc.core::begins(y, begin);
    when begin > @2005-12-31;
    when inflation_adjustment_factor_45i(y, factor);
    then gas_thresholds_45i(y, 1.67 * factor, 0.33 * factor);
}
@source(IRC_S45I_B, quote = "50 cents per 1,000 cubic feet of qualified natural gas production")
rule GasCreditAmount45iRule(y: TaxableYear, price: Decimal, floor_price: Decimal, span: Decimal) strict {
    when reference_price_gas_preceding_year_45i(y, price);
    when gas_thresholds_45i(y, floor_price, span);
    then gas_credit_amount_per_mcf_45i(y, 0.50 * (1.0 - min(1.0, max(0.0, div_round(price - floor_price, span, 10, "HALF_UP")))));
}

// --- (d)(3): coordination with section 45K ---------------------------------------------------------------

relation section_45i_allowed_for_well_45i(taxpayer: Person, well: Asset, y: TaxableYear) kind institutional;
@source(IRC_S45I_D, quote = "no credit shall be allowable under this section unless the taxpayer elects not to claim the credit under section 45K with respect to the well")
rule Section45iAllowedNo45k45iRule(taxpayer: Person, well: Asset, y: TaxableYear) strict {
    when holds_operating_interest_45i(taxpayer, well);
    when qualified_marginal_well_45i(well, y);
    when not_known(eligible_for_section_45k_credit_for_well_45i(taxpayer, well, y));
    then section_45i_allowed_for_well_45i(taxpayer, well, y);
}
rule Section45iAllowedElectedOut45iRule(taxpayer: Person, well: Asset, y: TaxableYear) strict {
    when holds_operating_interest_45i(taxpayer, well);
    when qualified_marginal_well_45i(well, y);
    when elects_not_to_claim_section_45k_for_well_45i(taxpayer, well, y);
    then section_45i_allowed_for_well_45i(taxpayer, well, y);
}

// --- (a): the credit ----------------------------------------------------------------------------------------

pub relation marginal_well_credit_per_well_45i(taxpayer: Person, well: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45I(a): the credit amounts times the qualified production attributable to the taxpayer, for one well";
}
@source(IRC_S45I_A, quote = "the qualified crude oil production and the qualified natural gas production which is attributable to the taxpayer")
rule MarginalWellCreditPerWell45iRule(taxpayer: Person, well: Asset, y: TaxableYear, barrels: Decimal, mcf: Decimal, gas_boe: Decimal, fraction: Decimal, ratio: Decimal, crude_amount: Decimal, gas_amount: Decimal) defeasible {
    when section_45i_allowed_for_well_45i(taxpayer, well, y);
    when well_production_45i(well, y, barrels, mcf, gas_boe);
    when qualified_production_fraction_45i(well, y, fraction);
    when revenue_interest_ratio_45i(taxpayer, well, y, ratio);
    when crude_oil_credit_amount_per_barrel_45i(y, crude_amount);
    when gas_credit_amount_per_mcf_45i(y, gas_amount);
    then marginal_well_credit_per_well_45i(taxpayer, well, y, round((crude_amount * barrels + gas_amount * mcf) * fraction * ratio, 2, "HALF_UP") * 1 USD);
}
pub relation marginal_oil_and_gas_well_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45I marginal oil and gas well production credit for the taxable year (a section 38(b)(19) component)";
}
rule MarginalOilAndGasWellProductionCredit45iRule(taxpayer: Person, y: TaxableYear, well: Asset, amount: Money) defeasible {
    when marginal_well_credit_per_well_45i(taxpayer, well, y, amount);
    then marginal_oil_and_gas_well_production_credit(taxpayer, y,
        sum(collect all a: Money, w: Asset where marginal_well_credit_per_well_45i(taxpayer, w, y, a), empty: 0 USD));
}
