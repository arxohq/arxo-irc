// Section 45Q — the qualified carbon oxide and direct air capture definitions, the baseline production of an applicable electric
// generating unit, the elections of (b)(3), (f)(3)(B), (f)(6) and (f)(9), the attribution of the credit, utilization, the additional
// equipment rules of (b)(1)(C) and (b)(2), and the wage and apprenticeship requirement structure of (h)(2)-(3). Stage 2f (IRC-06,
// DECISION-0379, TECH_GAP reduction of the stage 2d rows of TECH-GAPS G1777). Companion of `45q-carbon-oxide-sequestration-credit.law`;
// its credit rules are NOT rewired to require these relations (the credit module reads the folded case facts).
//
// Judgment calls: averages are decimals to 6 places HALF_UP; the (e)(2)(A)(i)(I) average is the total production over the asserted
// length of the period in years; the two lifecycle counts of (f)(5)(B)(i)(I)-(II) are summed (non-overlap is the taxpayer's
// demonstration); the date the Secretary published the guidance of (h)(2) is a case fact, never a literal.

use self::{
    Asset,
    FacilityKind45Q,
    IRC_S45Q_B,
    IRC_S45Q_C,
    IRC_S45Q_E,
    IRC_S45Q_F,
    IRC_S45Q_H,
    Person,
    TaxableYear,
    bba_2018_enacted_on_45q,
    capture_date_45q,
    equipment_at_facility_45q,
    equipment_placed_in_service_on_45q,
    facility_construction_begins_on_45q,
    facility_kind_45q,
    facility_tons_captured_45q,
    post_bba_equipment_45q,
    pre_bba_equipment_45q,
};

pub enum Species45Q { CarbonDioxide, OtherCarbonOxide }
pub enum Source45Q { IndustrialSource, DirectAir }
pub enum Process45Q { Photosynthesis, ChemicalConversionSecurelyStored, CommercialMarketUse }

// --- (b)(1)(C), (b)(2): additional carbon capture equipment ------------------------------------------------------------------------------------------

pub relation facility_placed_in_service_on_45q(facility: Asset, on: Date) kind empirical {
    label en official "the date the qualified facility is placed in service — case-asserted";
}
pub relation additional_equipment_treated_as_higher_dac_45q(equipment: Asset) kind institutional {
    label en official "section 45Q(b)(1)(C): additional carbon capture equipment installed at a direct air capture facility placed in service before 2023 and itself placed in service after 2022 gets the higher (b)(1)(B) amounts, applied to the equipment only";
}
@source(IRC_S45Q_B, relation = formalizes, coverage = exact, quote = "In the case of any qualified facility which is placed in service before January 1, 2023, if any additional carbon capture equipment is installed at such facility and such equipment is placed in service after December 31, 2022, the applicable dollar amount shall be an amount equal to the applicable dollar amount otherwise determined under this paragraph")
rule AdditionalEquipmentHigherDac45qRule(equipment: Asset, facility: Asset, facility_placed: Date, placed: Date) strict {
    when equipment_at_facility_45q(equipment, facility);
    when facility_kind_45q(facility, DirectAirCapture);
    when facility_placed_in_service_on_45q(facility, facility_placed);
    when facility_placed < @2023-01-01;
    when equipment_placed_in_service_on_45q(equipment, placed);
    when placed > @2022-12-31;
    then additional_equipment_treated_as_higher_dac_45q(equipment);
}
pub relation capacity_in_service_before_bba_tons_45q(facility: Asset, tons: Decimal) kind empirical {
    label en official "the total carbon dioxide capture capacity, in metric tons, of the carbon capture equipment in service at the facility on the day before the enactment of the Bipartisan Budget Act of 2018 (section 45Q(b)(2)(A)(ii)) — case-asserted";
}
pub relation additional_equipment_at_pre_bba_facility_45q(facility: Asset) kind empirical {
    label en official "the facility was placed in service before the enactment of the Bipartisan Budget Act of 2018 and additional carbon capture equipment is placed in service on or after that enactment (section 45Q(b)(2)) — case-asserted";
}
pub relation tons_at_old_dollar_amounts_45q(facility: Asset, y: TaxableYear, tons: Decimal) kind institutional {
    label en official "section 45Q(b)(2)(A): for paragraphs (1)(A) and (2)(A) of subsection (a), the lesser of the qualified carbon oxide captured in the year and the pre-enactment capture capacity";
}
@source(IRC_S45Q_B, relation = formalizes, coverage = exact, quote = "for purposes of paragraphs (1)(A) and (2)(A) of subsection (a), the lesser of")
rule TonsAtOldDollarAmounts45qRule(facility: Asset, y: TaxableYear, captured: Decimal, capacity: Decimal) strict {
    when additional_equipment_at_pre_bba_facility_45q(facility);
    when facility_tons_captured_45q(facility, y, captured);
    when capacity_in_service_before_bba_tons_45q(facility, capacity);
    then tons_at_old_dollar_amounts_45q(facility, y, min(captured, capacity));
}
pub relation tons_at_new_dollar_amounts_45q(facility: Asset, y: TaxableYear, tons: Decimal) kind institutional {
    label en official "section 45Q(b)(2)(B): for paragraphs (3)(A) and (4)(A) of subsection (a), the excess (not less than zero) of the qualified carbon oxide captured in the year over the pre-enactment capture capacity";
}
@source(IRC_S45Q_B, relation = formalizes, coverage = exact, quote = "for purposes of paragraphs (3)(A) and (4)(A) of such subsection, an amount (not less than zero) equal to the excess of")
rule TonsAtNewDollarAmounts45qRule(facility: Asset, y: TaxableYear, captured: Decimal, capacity: Decimal) strict {
    when additional_equipment_at_pre_bba_facility_45q(facility);
    when facility_tons_captured_45q(facility, y, captured);
    when capacity_in_service_before_bba_tons_45q(facility, capacity);
    then tons_at_new_dollar_amounts_45q(facility, y, max(captured - capacity, 0.0));
}

// --- (b)(3): the election for the older dollar amounts ------------------------------------------------------------------------------------------------

pub relation elects_older_dollar_amounts_45q(taxpayer: Person, equipment: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 45Q(b)(3) election to apply the (a)(1)-(2) dollar amounts in lieu of the (a)(3)-(4) amounts for post-enactment equipment";
}
pub relation older_dollar_amounts_apply_45q(taxpayer: Person, equipment: Asset) kind institutional {
    label en official "section 45Q(b)(3): the (a)(1)-(2) dollar amounts apply in lieu of the (a)(3)-(4) amounts for the qualified carbon oxide captured by the taxpayer with the equipment";
}
@source(IRC_S45Q_B, relation = formalizes, coverage = exact, quote = "a taxpayer may elect to have the dollar amounts applicable under paragraph (1) or (2) of subsection (a) apply in lieu of the dollar amounts applicable under paragraph (3) or (4) of such subsection")
rule Section45QB3ElectionRule(taxpayer: Person, equipment: Asset) defeasible {
    when elects_older_dollar_amounts_45q(taxpayer, equipment);
    when post_bba_equipment_45q(equipment);
    then power Section45QB3OlderAmountsElection {
        holder taxpayer;
        over taxpayer;
        exercise elects_older_dollar_amounts_45q(taxpayer, equipment);
        valid_when post_bba_equipment_45q(equipment);
        effect create(older_dollar_amounts_apply_45q(taxpayer, equipment));
        window [-infinity, infinity);
    };
}

// --- (c): qualified carbon oxide ---------------------------------------------------------------------------------------------------------------------------

pub relation carbon_oxide_species_45q(equipment: Asset, y: TaxableYear, species: Species45Q) kind empirical {
    label en official "whether the captured carbon oxide is carbon dioxide or another carbon oxide (section 45Q(c)(1)) — case-asserted";
}
pub relation capture_source_45q(equipment: Asset, y: TaxableYear, source_kind: Source45Q) kind empirical {
    label en official "whether the carbon oxide is captured from an industrial source or directly from the ambient air (section 45Q(c)(1)) — case-asserted";
}
pub relation would_otherwise_be_released_45q(equipment: Asset, y: TaxableYear) kind empirical {
    label en official "the carbon oxide would otherwise be released into the atmosphere as industrial emission of greenhouse gas or lead to such release (section 45Q(c)(1)(A)(ii), (B)(ii)) — case-asserted";
}
pub relation measured_at_source_and_verified_at_disposal_45q(equipment: Asset, y: TaxableYear) kind empirical {
    label en official "the carbon oxide is measured at the source of capture and verified at the point of disposal, injection, or utilization (section 45Q(c)(1)) — case-asserted";
}
pub relation qualified_carbon_oxide_defined_45q(equipment: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Q(c)(1): carbon dioxide from an industrial source by pre-enactment equipment, any carbon oxide from an industrial source by post-enactment equipment, or carbon dioxide from a direct air capture facility, each measured and verified, the industrial kinds otherwise released";
}
@source(IRC_S45Q_C, relation = formalizes, coverage = exact, quote = "is captured from an industrial source by carbon capture equipment which is originally placed in service before the date of the enactment of the Bipartisan Budget Act of 2018")
rule QualifiedCarbonOxidePreBba45qRule(equipment: Asset, y: TaxableYear) strict {
    when pre_bba_equipment_45q(equipment);
    when carbon_oxide_species_45q(equipment, y, CarbonDioxide);
    when capture_source_45q(equipment, y, IndustrialSource);
    when would_otherwise_be_released_45q(equipment, y);
    when measured_at_source_and_verified_at_disposal_45q(equipment, y);
    then qualified_carbon_oxide_defined_45q(equipment, y);
}
@source(IRC_S45Q_C, relation = formalizes, coverage = exact, quote = "is captured from an industrial source by carbon capture equipment which is originally placed in service on or after the date of the enactment of the Bipartisan Budget Act of 2018")
rule QualifiedCarbonOxidePostBba45qRule(equipment: Asset, y: TaxableYear) strict {
    when post_bba_equipment_45q(equipment);
    when capture_source_45q(equipment, y, IndustrialSource);
    when would_otherwise_be_released_45q(equipment, y);
    when measured_at_source_and_verified_at_disposal_45q(equipment, y);
    then qualified_carbon_oxide_defined_45q(equipment, y);
}
@source(IRC_S45Q_C, relation = formalizes, coverage = exact, quote = "is captured directly from the ambient air")
rule QualifiedCarbonOxideDirectAir45qRule(equipment: Asset, y: TaxableYear, facility: Asset) strict {
    when equipment_at_facility_45q(equipment, facility);
    when facility_kind_45q(facility, DirectAirCapture);
    when carbon_oxide_species_45q(equipment, y, CarbonDioxide);
    when capture_source_45q(equipment, y, DirectAir);
    when measured_at_source_and_verified_at_disposal_45q(equipment, y);
    then qualified_carbon_oxide_defined_45q(equipment, y);
}
pub relation recaptured_recycled_and_reinjected_45q(equipment: Asset, y: TaxableYear) kind empirical {
    label en official "the carbon oxide is recaptured, recycled, and re-injected as part of the enhanced oil and natural gas recovery process (section 45Q(c)(2)) — case-asserted";
}
pub relation qualified_carbon_oxide_counted_45q(equipment: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Q(c)(2): qualified carbon oxide includes the initial deposit used as a tertiary injectant and does not include carbon oxide recaptured, recycled and re-injected";
}
@source(IRC_S45Q_C, relation = formalizes, coverage = exact, quote = "The term \"qualified carbon oxide\" includes the initial deposit of captured carbon oxide used as a tertiary injectant. Such term does not include carbon oxide that is recaptured, recycled, and re-injected as part of the enhanced oil and natural gas recovery process.")
rule QualifiedCarbonOxideCounted45qRule(equipment: Asset, y: TaxableYear) strict {
    when qualified_carbon_oxide_defined_45q(equipment, y);
    when not_known(recaptured_recycled_and_reinjected_45q(equipment, y));
    then qualified_carbon_oxide_counted_45q(equipment, y);
}

// --- (e)(1)-(2): the applicable electric generating unit and its baseline ------------------------------------------------------------------------

pub relation principal_unit_planned_for_equipment_45q(unit: Asset, equipment: Asset) kind empirical {
    label en official "the electric generating unit is the principal unit for which the carbon capture equipment is originally planned and designed (section 45Q(e)(1)) — case-asserted";
}
pub relation applicable_electric_generating_unit_45q(unit: Asset, equipment: Asset) kind institutional {
    label en official "section 45Q(e)(1): the principal electric generating unit for which the carbon capture equipment is originally planned and designed";
}
@source(IRC_S45Q_E, relation = formalizes, coverage = exact, quote = "The term \"applicable electric generating unit\" means the principal electric generating unit for which the carbon capture equipment is originally planned and designed.")
rule ApplicableElectricGeneratingUnit45qRule(unit: Asset, equipment: Asset) strict {
    when principal_unit_planned_for_equipment_45q(unit, equipment);
    then applicable_electric_generating_unit_45q(unit, equipment);
}
pub relation unit_placed_in_service_on_45q(unit: Asset, on: Date) kind empirical {
    label en official "the date the electric generating unit was originally placed in service — case-asserted";
}
pub relation unit_not_yet_placed_in_service_45q(unit: Asset) kind empirical {
    label en official "as of the date construction of the carbon capture equipment begins the unit is not yet placed in service (section 45Q(e)(2)(A)(ii)(I)) — case-asserted";
}
pub relation equipment_construction_begins_on_45q(equipment: Asset, on: Date) kind empirical {
    label en official "the date construction of the carbon capture equipment begins — case-asserted";
}
pub relation production_since_placed_in_service_tons_45q(unit: Asset, tons: Decimal) kind empirical {
    label en official "the carbon oxide production, by mass, of the unit from its placed-in-service date to the date construction of the equipment began — case-asserted";
}
pub relation years_in_service_before_construction_45q(unit: Asset, years: Decimal) kind empirical {
    label en official "the length in years of the period from the unit's placed-in-service date to the date construction of the equipment began — case-asserted";
}
pub relation three_highest_annual_production_tons_45q(unit: Asset, first: Decimal, second: Decimal, third: Decimal) kind empirical {
    label en official "the annual carbon oxide production, by mass, of the 3 years with the highest production during the 12-year period preceding the date construction began — case-asserted";
}
pub relation designed_annual_production_at_60_percent_tons_45q(unit: Asset, tons: Decimal) kind empirical {
    label en official "the designed annual carbon oxide production, by mass, based on an assumed capacity factor of 60 percent (section 45Q(e)(2)(A)(ii)) — case-asserted";
}
pub relation baseline_carbon_oxide_production_45q(unit: Asset, equipment: Asset, tons: Decimal) kind institutional {
    label en official "section 45Q(e)(2)(A): the average annual production over the period since placed in service (unit 1 to 3 years old), the average of the 3 highest years of the preceding 12 (older unit), or the designed production at a 60 percent capacity factor (new or under a year old)";
}
@source(IRC_S45Q_E, relation = formalizes, coverage = exact, quote = "(I) in the case of an applicable electric generating unit which was originally placed in service more than 1 year prior to the date on which construction of the carbon capture equipment begins and on or after the date which is 3 years prior to the date on which construction of such equipment begins, the period beginning on the date such unit was placed in service and ending on the date on which construction of such equipment began")
rule BaselineProductionPeriodAverage45qRule(unit: Asset, equipment: Asset, placed: Date, start: Date, total: Decimal, years: Decimal) strict {
    when applicable_electric_generating_unit_45q(unit, equipment);
    when unit_placed_in_service_on_45q(unit, placed);
    when equipment_construction_begins_on_45q(equipment, start);
    when add_calendar_period(placed, 12 calendar_month) < start;
    when add_calendar_period(placed, 36 calendar_month) >= start;
    when production_since_placed_in_service_tons_45q(unit, total);
    when years_in_service_before_construction_45q(unit, years);
    when years > 0.0;
    then baseline_carbon_oxide_production_45q(unit, equipment, div_round(total, years, 6, "HALF_UP"));
}
@source(IRC_S45Q_E, relation = formalizes, coverage = exact, quote = "(II) in the case of an applicable electric generating unit which was originally placed in service more than 3 years prior to the date on which construction of the carbon capture equipment begins, the 3 years with the highest annual carbon oxide production during the 12-year period preceding the date on which construction of such equipment began.")
rule BaselineProductionThreeHighestYears45qRule(unit: Asset, equipment: Asset, placed: Date, start: Date, a: Decimal, b: Decimal, c: Decimal) strict {
    when applicable_electric_generating_unit_45q(unit, equipment);
    when unit_placed_in_service_on_45q(unit, placed);
    when equipment_construction_begins_on_45q(equipment, start);
    when add_calendar_period(placed, 36 calendar_month) < start;
    when three_highest_annual_production_tons_45q(unit, a, b, c);
    then baseline_carbon_oxide_production_45q(unit, equipment, div_round(a + b + c, 3.0, 6, "HALF_UP"));
}
@source(IRC_S45Q_E, relation = formalizes, coverage = exact, quote = "the designed annual carbon oxide production, by mass, as determined based on an assumed capacity factor of 60 percent.")
rule BaselineProductionDesignedNotYetInService45qRule(unit: Asset, equipment: Asset, tons: Decimal) strict {
    when applicable_electric_generating_unit_45q(unit, equipment);
    when unit_not_yet_placed_in_service_45q(unit);
    when designed_annual_production_at_60_percent_tons_45q(unit, tons);
    then baseline_carbon_oxide_production_45q(unit, equipment, tons);
}
rule BaselineProductionDesignedWithinYear45qRule(unit: Asset, equipment: Asset, placed: Date, start: Date, tons: Decimal) strict {
    when applicable_electric_generating_unit_45q(unit, equipment);
    when unit_placed_in_service_on_45q(unit, placed);
    when equipment_construction_begins_on_45q(equipment, start);
    when add_calendar_period(placed, 12 calendar_month) >= start;
    when designed_annual_production_at_60_percent_tons_45q(unit, tons);
    then baseline_carbon_oxide_production_45q(unit, equipment, tons);
}
pub relation actual_electric_output_mwh_45q(unit: Asset, y: TaxableYear, mwh: Decimal) kind empirical {
    label en official "the actual electric output of the unit for the period — case-asserted";
}
pub relation potential_electric_output_mwh_45q(unit: Asset, y: TaxableYear, mwh: Decimal) kind empirical {
    label en official "the potential electric output of the unit for the period — case-asserted";
}
pub relation capacity_factor_percent_45q(unit: Asset, y: TaxableYear, percent: Decimal) kind institutional {
    label en official "section 45Q(e)(2)(B): the ratio, expressed as a percentage, of the actual electric output to the potential electric output (6 decimals HALF_UP)";
}
@source(IRC_S45Q_E, relation = formalizes, coverage = exact, quote = "The term \"capacity factor\" means the ratio (expressed as a percentage) of the actual electric output from the applicable electric generating unit to the potential electric output from such unit.")
rule CapacityFactor45qRule(unit: Asset, y: TaxableYear, actual: Decimal, potential: Decimal) strict {
    when actual_electric_output_mwh_45q(unit, y, actual);
    when potential_electric_output_mwh_45q(unit, y, potential);
    when potential > 0.0;
    then capacity_factor_percent_45q(unit, y, div_round(actual * 100.0, potential, 6, "HALF_UP"));
}

// --- (e)(3): direct air capture facility ----------------------------------------------------------------------------------------------------------------

pub relation captures_carbon_dioxide_from_ambient_air_45q(facility: Asset) kind empirical {
    label en official "the facility uses carbon capture equipment to capture carbon dioxide directly from the ambient air (section 45Q(e)(3)(A)) — case-asserted";
}
pub relation captures_natural_spring_carbon_dioxide_45q(facility: Asset) kind empirical {
    label en official "the facility captures carbon dioxide deliberately released from naturally occurring subsurface springs (section 45Q(e)(3)(B)(i)) — case-asserted";
}
pub relation captures_carbon_dioxide_using_photosynthesis_45q(facility: Asset) kind empirical {
    label en official "the facility captures carbon dioxide using natural photosynthesis (section 45Q(e)(3)(B)(ii)) — case-asserted";
}
pub relation direct_air_capture_facility_defined_45q(facility: Asset) kind institutional {
    label en official "section 45Q(e)(3): a facility using carbon capture equipment to capture carbon dioxide directly from the ambient air, other than one capturing carbon dioxide released from natural springs or using natural photosynthesis";
}
@source(IRC_S45Q_E, relation = formalizes, coverage = exact, quote = "Subject to subparagraph (B), the term \"direct air capture facility\" means any facility which uses carbon capture equipment to capture carbon dioxide directly from the ambient air.")
rule DirectAirCaptureFacilityDefined45qRule(facility: Asset) strict {
    when captures_carbon_dioxide_from_ambient_air_45q(facility);
    when not_known(captures_natural_spring_carbon_dioxide_45q(facility));
    when not_known(captures_carbon_dioxide_using_photosynthesis_45q(facility));
    then direct_air_capture_facility_defined_45q(facility);
}

// --- (f)(3): attribution and the election to shift the credit -------------------------------------------------------------------------------

pub relation captures_and_ensures_disposal_45q(person: Person, equipment: Asset) kind empirical {
    label en official "the person captures and physically or contractually ensures the disposal, utilization, or use as a tertiary injectant of the qualified carbon oxide (section 45Q(f)(3)(A)(i)) — case-asserted";
}
pub relation owns_equipment_and_ensures_capture_and_disposal_45q(person: Person, equipment: Asset) kind empirical {
    label en official "the person owns the carbon capture equipment and physically or contractually ensures the capture and disposal, utilization, or use as a tertiary injectant (section 45Q(f)(3)(A)(ii)) — case-asserted";
}
pub relation credit_attributable_to_45q(person: Person, equipment: Asset) kind institutional {
    label en official "section 45Q(f)(3)(A): the credit is attributable to the person that captures and ensures disposal (pre-enactment equipment), or to the person that owns the equipment and ensures capture and disposal (post-enactment equipment)";
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "(i) in the case of qualified carbon oxide captured using carbon capture equipment which is originally placed in service at a qualified facility before the date of the enactment of the Bipartisan Budget Act of 2018, the person that captures and physically or contractually ensures the disposal, utilization, or use as a tertiary injectant of such qualified carbon oxide")
rule CreditAttributablePreBba45qRule(person: Person, equipment: Asset) strict {
    when pre_bba_equipment_45q(equipment);
    when captures_and_ensures_disposal_45q(person, equipment);
    then credit_attributable_to_45q(person, equipment);
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "(ii) in the case of qualified carbon oxide captured using carbon capture equipment which is originally placed in service at a qualified facility on or after the date of the enactment of the Bipartisan Budget Act of 2018, the person that owns the carbon capture equipment and physically or contractually ensures the capture and disposal, utilization, or use as a tertiary injectant of such qualified carbon oxide.")
rule CreditAttributablePostBba45qRule(person: Person, equipment: Asset) strict {
    when post_bba_equipment_45q(equipment);
    when owns_equipment_and_ensures_capture_and_disposal_45q(person, equipment);
    then credit_attributable_to_45q(person, equipment);
}
pub relation disposes_utilizes_or_injects_45q(person: Person, equipment: Asset) kind empirical {
    label en official "the person disposes of the qualified carbon oxide, utilizes it, or uses it as a tertiary injectant — case-asserted";
}
pub relation elects_credit_to_disposer_45q(person: Person, equipment: Asset, disposer: Person) kind empirical {
    label en official "the exercise of the section 45Q(f)(3)(B) election by the person to whom the credit is attributable to have the credit allowed to the disposer, utilizer or injector";
}
pub relation election_in_prescribed_time_and_manner_45q(person: Person, equipment: Asset) kind empirical {
    label en official "the election is made in such time and manner as the Secretary prescribes by regulations — case-asserted";
}
pub relation credit_shifted_to_disposer_45q(person: Person, equipment: Asset, disposer: Person) kind institutional {
    label en official "section 45Q(f)(3)(B): the credit is allowable to the person that disposes of, utilizes or injects the qualified carbon oxide, and not to the person described in subparagraph (A)";
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "shall be allowable to the person that disposes of the qualified carbon oxide, utilizes the qualified carbon oxide, or uses the qualified carbon oxide as a tertiary injectant")
rule Section45QF3BElectionRule(person: Person, equipment: Asset, disposer: Person) defeasible {
    when credit_attributable_to_45q(person, equipment);
    when disposes_utilizes_or_injects_45q(disposer, equipment);
    when election_in_prescribed_time_and_manner_45q(person, equipment);
    then power Section45QF3BShiftElection {
        holder person;
        over disposer;
        exercise elects_credit_to_disposer_45q(person, equipment, disposer);
        valid_when election_in_prescribed_time_and_manner_45q(person, equipment);
        effect create(credit_shifted_to_disposer_45q(person, equipment, disposer));
        window [-infinity, infinity);
    };
}
relation credit_shift_elected_45q(person: Person, equipment: Asset) kind institutional;
rule CreditShiftElected45qRule(person: Person, equipment: Asset, disposer: Person) strict {
    when elects_credit_to_disposer_45q(person, equipment, disposer);
    when election_in_prescribed_time_and_manner_45q(person, equipment);
    then credit_shift_elected_45q(person, equipment);
}
pub relation credit_allowable_to_45q(person: Person, equipment: Asset) kind institutional {
    label en official "section 45Q(f)(3): the credit is allowable to the attributable person unless the shift election is made, and then to the disposer, utilizer or injector";
}
rule CreditAllowableToAttributable45qRule(person: Person, equipment: Asset) strict {
    when credit_attributable_to_45q(person, equipment);
    when not_known(credit_shift_elected_45q(person, equipment));
    then credit_allowable_to_45q(person, equipment);
}
rule CreditAllowableToDisposer45qRule(person: Person, equipment: Asset, disposer: Person) strict {
    when elects_credit_to_disposer_45q(person, equipment, disposer);
    when election_in_prescribed_time_and_manner_45q(person, equipment);
    when disposes_utilizes_or_injects_45q(disposer, equipment);
    then credit_allowable_to_45q(disposer, equipment);
}

// --- (f)(5): utilization ---------------------------------------------------------------------------------------------------------------------------------------

pub relation utilization_process_45q(equipment: Asset, y: TaxableYear, process: Process45Q) kind empirical {
    label en official "the process by which the qualified carbon oxide is utilized (section 45Q(f)(5)(A)) — case-asserted";
}
pub relation used_as_tertiary_injectant_in_qualified_recovery_45q(equipment: Asset, y: TaxableYear) kind empirical {
    label en official "the carbon oxide is used as a tertiary injectant in a qualified enhanced oil or natural gas recovery project — case-asserted";
}
external judgment relation secretary_determines_commercial_market_use_45q(equipment: Asset, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary determines that a commercial market exists for the purpose of the use (section 45Q(f)(5)(A)(iii))";
}
pub relation utilization_of_qualified_carbon_oxide_45q(equipment: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Q(f)(5)(A): fixation through photosynthesis or chemosynthesis, chemical conversion to a material in which it is securely stored, or another use for which a commercial market exists (other than tertiary injectant in a qualified recovery project)";
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "(i) the fixation of such qualified carbon oxide through photosynthesis or chemosynthesis, such as through the growing of algae or bacteria")
rule UtilizationPhotosynthesis45qRule(equipment: Asset, y: TaxableYear) strict {
    when utilization_process_45q(equipment, y, Photosynthesis);
    then utilization_of_qualified_carbon_oxide_45q(equipment, y);
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "(ii) the chemical conversion of such qualified carbon oxide to a material or chemical compound in which such qualified carbon oxide is securely stored")
rule UtilizationChemicalConversion45qRule(equipment: Asset, y: TaxableYear) strict {
    when utilization_process_45q(equipment, y, ChemicalConversionSecurelyStored);
    then utilization_of_qualified_carbon_oxide_45q(equipment, y);
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "(iii) the use of such qualified carbon oxide for any other purpose for which a commercial market exists (with the exception of use as a tertiary injectant in a qualified enhanced oil or natural gas recovery project), as determined by the Secretary.")
rule UtilizationCommercialMarket45qRule(equipment: Asset, y: TaxableYear) defeasible {
    when utilization_process_45q(equipment, y, CommercialMarketUse);
    when secretary_determines_commercial_market_use_45q(equipment, y);
    when not_known(used_as_tertiary_injectant_in_qualified_recovery_45q(equipment, y));
    then utilization_of_qualified_carbon_oxide_45q(equipment, y);
}
pub relation lifecycle_isolated_tons_45q(equipment: Asset, y: TaxableYear, tons: Decimal) kind empirical {
    label en official "the metric tons the taxpayer demonstrates by lifecycle greenhouse gas analysis were captured and permanently isolated from the atmosphere (section 45Q(f)(5)(B)(i)(I)) — case-asserted";
}
pub relation lifecycle_displaced_tons_45q(equipment: Asset, y: TaxableYear, tons: Decimal) kind empirical {
    label en official "the metric tons the taxpayer demonstrates by lifecycle greenhouse gas analysis were displaced from being emitted into the atmosphere (section 45Q(f)(5)(B)(i)(II)) — case-asserted";
}
pub relation utilized_tons_by_lifecycle_analysis_45q(equipment: Asset, y: TaxableYear, tons: Decimal) kind institutional {
    label en official "section 45Q(f)(5)(B)(i): the amount utilized is the metric tons demonstrated by lifecycle analysis to be captured and permanently isolated or displaced from emission through a process of subparagraph (A) (the two counts summed; non-overlap is part of the demonstration)";
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "the metric tons of qualified carbon oxide which the taxpayer demonstrates, based upon an analysis of lifecycle greenhouse gas emissions")
rule UtilizedTonsByLifecycleAnalysis45qRule(equipment: Asset, y: TaxableYear, isolated: Decimal, displaced: Decimal) defeasible {
    when utilization_of_qualified_carbon_oxide_45q(equipment, y);
    when lifecycle_isolated_tons_45q(equipment, y, isolated);
    when lifecycle_displaced_tons_45q(equipment, y, displaced);
    then utilized_tons_by_lifecycle_analysis_45q(equipment, y, isolated + displaced);
}

// --- (f)(6): the election to deem a facility placed in service on the enactment date -----------------------------------------------------

pub relation prior_credit_claimed_before_bba_45q(facility: Asset) kind empirical {
    label en official "a taxpayer claimed a credit under section 45Q for the facility for a taxable year ending before the enactment of the Bipartisan Budget Act of 2018 (section 45Q(f)(6)(B)(ii)) — case-asserted";
}
pub relation applicable_facility_45q(facility: Asset) kind institutional {
    label en official "section 45Q(f)(6)(B): a qualified facility placed in service before the enactment of the Bipartisan Budget Act of 2018 for which no credit was claimed for a taxable year ending before that enactment";
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "the term \"applicable facility\" means a qualified facility")
rule ApplicableFacility45qRule(facility: Asset, placed: Date, bba: Date) strict {
    when facility_placed_in_service_on_45q(facility, placed);
    when bba_2018_enacted_on_45q(bba);
    when placed < bba;
    when not_known(prior_credit_claimed_before_bba_45q(facility));
    then applicable_facility_45q(facility);
}
pub relation elects_deemed_placed_in_service_on_bba_date_45q(person: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the exercise of the section 45Q(f)(6)(A) election by the person described in paragraph (3)(A)(ii) to have the facility and its equipment deemed placed in service on the enactment date of the Bipartisan Budget Act of 2018";
}
pub relation facility_deemed_placed_in_service_on_bba_date_45q(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Q(f)(6)(A): for a year in which an applicable facility captures at least 500,000 metric tons, the electing person's facility and equipment are deemed placed in service on the enactment date of the Bipartisan Budget Act of 2018";
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "in the case of an applicable facility, for any taxable year in which such facility captures not less than 500,000 metric tons of qualified carbon oxide during the taxable year, the person described in paragraph (3)(A)(ii) may elect to have such facility, and any carbon capture equipment placed in service at such facility, deemed as having been placed in service on the date of the enactment of the Bipartisan Budget Act of 2018.")
rule Section45QF6ElectionRule(person: Person, facility: Asset, y: TaxableYear, tons: Decimal) defeasible {
    when elects_deemed_placed_in_service_on_bba_date_45q(person, facility, y);
    when applicable_facility_45q(facility);
    when facility_tons_captured_45q(facility, y, tons);
    when tons >= 500000.0;
    then power Section45QF6DeemedPlacedElection {
        holder person;
        over facility;
        exercise elects_deemed_placed_in_service_on_bba_date_45q(person, facility, y);
        valid_when applicable_facility_45q(facility);
        effect create(facility_deemed_placed_in_service_on_bba_date_45q(facility, y));
        window [-infinity, infinity);
    };
}

// --- (f)(9): the election to restart the 12-year period after a disaster ----------------------------------------------------------------------

pub relation no_prior_credit_for_equipment_45q(equipment: Asset) kind empirical {
    label en official "no taxpayer claimed a credit under section 45Q with respect to the equipment for any prior taxable year (section 45Q(f)(9)(A)) — case-asserted";
}
pub relation facility_in_federally_declared_disaster_area_45q(facility: Asset) kind empirical {
    label en official "the facility is located in an area affected by a federally-declared disaster (section 165(i)(5)(A)) after the equipment is originally placed in service (section 45Q(f)(9)(B)) — case-asserted";
}
pub relation disaster_caused_cessation_of_operation_45q(facility: Asset) kind empirical {
    label en official "the disaster results in a cessation of the operation of the facility or the equipment after the equipment is originally placed in service (section 45Q(f)(9)(C)) — case-asserted";
}
pub relation first_credit_year_begin_45q(equipment: Asset, on: Date) kind empirical {
    label en official "the first day of the first taxable year in which a credit under section 45Q is claimed with respect to the equipment — case-asserted";
}
pub relation elects_twelve_year_period_restart_45q(person: Person, equipment: Asset) kind empirical {
    label en official "the exercise of the section 45Q(f)(9) election by the person described in paragraph (3)(A)(ii) to have the 12-year period begin on the first day of the first taxable year in which a credit is claimed";
}
pub relation twelve_year_period_restart_effective_45q(equipment: Asset) kind institutional {
    label en official "section 45Q(f)(9): the 12-year period of (a)(3)-(4) begins on the first day of the first taxable year in which a credit is claimed, for post-enactment equipment with no prior claim at a facility in a declared disaster area whose operation ceased";
}
@source(IRC_S45Q_F, relation = formalizes, coverage = exact, quote = "a person described in paragraph (3)(A)(ii) may elect, at such time and in such manner as the Secretary may prescribe, to have the 12–year period begin on the first day of the first taxable year in which a credit under this section is claimed with respect to carbon capture equipment which is originally placed in service at a qualified facility on or after the date of the enactment of the Bipartisan Budget Act of 2018")
rule Section45QF9ElectionRule(person: Person, equipment: Asset, facility: Asset) defeasible {
    when elects_twelve_year_period_restart_45q(person, equipment);
    when post_bba_equipment_45q(equipment);
    when equipment_at_facility_45q(equipment, facility);
    when no_prior_credit_for_equipment_45q(equipment);
    when facility_in_federally_declared_disaster_area_45q(facility);
    when disaster_caused_cessation_of_operation_45q(facility);
    then power Section45QF9RestartElection {
        holder person;
        over equipment;
        exercise elects_twelve_year_period_restart_45q(person, equipment);
        valid_when no_prior_credit_for_equipment_45q(equipment);
        effect create(twelve_year_period_restart_effective_45q(equipment));
        window [-infinity, infinity);
    };
}
relation restart_elected_and_conditions_met_45q(equipment: Asset) kind institutional;
rule RestartElectedAndConditionsMet45qRule(person: Person, equipment: Asset, facility: Asset) strict {
    when elects_twelve_year_period_restart_45q(person, equipment);
    when post_bba_equipment_45q(equipment);
    when equipment_at_facility_45q(equipment, facility);
    when no_prior_credit_for_equipment_45q(equipment);
    when facility_in_federally_declared_disaster_area_45q(facility);
    when disaster_caused_cessation_of_operation_45q(facility);
    then restart_elected_and_conditions_met_45q(equipment);
}
pub relation within_restarted_credit_period_45q(equipment: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Q(f)(9): the capture is within the 12-year period beginning on the first day of the first credit year";
}
rule WithinRestartedCreditPeriod45qRule(equipment: Asset, y: TaxableYear, first_day: Date, captured: Date) strict {
    when restart_elected_and_conditions_met_45q(equipment);
    when first_credit_year_begin_45q(equipment, first_day);
    when capture_date_45q(equipment, y, captured);
    when captured >= first_day;
    when captured < add_calendar_period(first_day, 144 calendar_month);
    then within_restarted_credit_period_45q(equipment, y);
}

// --- (h)(2)-(3): the wage and apprenticeship requirement structure ----------------------------------------------------------------------------

pub relation guidance_published_on_45q(on: Date) kind empirical {
    label en official "the date the Secretary publishes guidance with respect to the requirements of paragraphs (3)(A) and (4) of section 45Q(h) — case-asserted, not pinned";
}
pub relation wages_at_least_prevailing_for_construction_45q(equipment: Asset) kind empirical {
    label en official "laborers and mechanics employed by the taxpayer or any contractor in the construction of the facility or equipment are paid wages at not less than the prevailing rates (section 45Q(h)(3)(A)(i)) — case-asserted";
}
pub relation wages_at_least_prevailing_for_alteration_or_repair_45q(equipment: Asset) kind empirical {
    label en official "laborers and mechanics in the alteration or repair of the facility or equipment during the credit period are paid wages at not less than the prevailing rates (section 45Q(h)(3)(A)(ii)) — case-asserted";
}
pub relation prevailing_wage_requirement_met_45q(equipment: Asset) kind institutional {
    label en official "section 45Q(h)(3)(A): prevailing wages are paid for the construction and for the alteration or repair within the credit period";
}
@source(IRC_S45Q_H, relation = formalizes, coverage = exact, quote = "shall be paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality in which such facility and equipment are located as most recently determined by the Secretary of Labor")
rule PrevailingWageRequirementMet45qRule(equipment: Asset) strict {
    when wages_at_least_prevailing_for_construction_45q(equipment);
    when wages_at_least_prevailing_for_alteration_or_repair_45q(equipment);
    then prevailing_wage_requirement_met_45q(equipment);
}
pub relation apprenticeship_requirements_met_45q(equipment: Asset) kind empirical {
    label en official "the taxpayer satisfies the requirements of section 45Q(h)(4) with respect to the construction of the facility and equipment — case-asserted";
}
pub relation section_h2_requirements_met_45q(equipment: Asset) kind institutional {
    label en official "section 45Q(h)(2): the wage and apprenticeship requirements are satisfied for equipment (and its facility) whose construction begins 60 days after the guidance, or the grandfathered construction start of (C)";
}
@source(IRC_S45Q_H, relation = formalizes, coverage = exact, quote = "with respect to any qualified facility the construction of which begins on or after the date that is 60 days after the Secretary publishes guidance with respect to the requirements of paragraphs (3)(A) and (4), as well as any carbon capture equipment placed in service at such facility")
rule SectionH2AFacilityAfterGuidance45qRule(equipment: Asset, facility: Asset, g: Date, begins: Date) strict {
    when equipment_at_facility_45q(equipment, facility);
    when guidance_published_on_45q(g);
    when facility_construction_begins_on_45q(facility, begins);
    when begins >= add_calendar_period(g, 60 calendar_day);
    when prevailing_wage_requirement_met_45q(equipment);
    when apprenticeship_requirements_met_45q(equipment);
    then section_h2_requirements_met_45q(equipment);
}
@source(IRC_S45Q_H, relation = formalizes, coverage = exact, quote = "with respect to any carbon capture equipment the construction of which begins on or after the date that is 60 days after the Secretary publishes guidance with respect to the requirements of paragraphs (3)(A) and (4)")
rule SectionH2BEquipmentAfterGuidance45qRule(equipment: Asset, facility: Asset, g: Date, ebegins: Date, fbegins: Date) strict {
    when equipment_at_facility_45q(equipment, facility);
    when guidance_published_on_45q(g);
    when equipment_construction_begins_on_45q(equipment, ebegins);
    when facility_construction_begins_on_45q(facility, fbegins);
    when ebegins >= add_calendar_period(g, 60 calendar_day);
    when fbegins < add_calendar_period(g, 60 calendar_day);
    when prevailing_wage_requirement_met_45q(equipment);
    when apprenticeship_requirements_met_45q(equipment);
    then section_h2_requirements_met_45q(equipment);
}
@source(IRC_S45Q_H, relation = formalizes, coverage = exact, quote = "(C) the construction of carbon capture equipment begins prior to the date that is 60 days after the Secretary publishes guidance with respect to the requirements of paragraphs (3)(A) and (4), and such equipment is installed at a qualified facility the construction of which begins prior to such date.")
rule SectionH2CGrandfathered45qRule(equipment: Asset, facility: Asset, g: Date, ebegins: Date, fbegins: Date) strict {
    when equipment_at_facility_45q(equipment, facility);
    when guidance_published_on_45q(g);
    when equipment_construction_begins_on_45q(equipment, ebegins);
    when facility_construction_begins_on_45q(facility, fbegins);
    when ebegins < add_calendar_period(g, 60 calendar_day);
    when fbegins < add_calendar_period(g, 60 calendar_day);
    then section_h2_requirements_met_45q(equipment);
}
