// Section 32 — Earned income (the "earned income credit"/EIC). Stage 1
// (IRC-06 stage 1).
//
// The section 32(b) table's inline prose in fragment IRC_S32_B is replaced
// by "[table T1]"/"[table T2]" placeholders, but the GovInfo pipeline
// preserved the table CONTENT separately as two dedicated `table`-kind
// fragments, IRC_S32_TABLE_1 (credit percentage / phaseout percentage by
// qualifying-child count) and IRC_S32_TABLE_2 (earned income amount /
// phaseout amount by qualifying-child count) — anchored below. These are
// the STATUTORY BASE values as codified (not any particular year's
// inflation-adjusted figures): section 32(j) requires an annual
// cost-of-living increase to the two IRC_S32_TABLE_2 dollar amounts for
// every taxable year beginning after 2015. For years with a pinned Rev.
// Proc., the published figures are read as A3 parameters
// (`32-eic-*.lawparam.json`, anchored to the Rev. Proc. fragments in
// `us.irc.inflation_adjustments`): Rev. Proc. 2024-40 §2.06 for 2025 and
// Rev. Proc. 2025-32 §4.06 for 2026 — see the `*FromRevenueProcedure`
// rules below. Years without a pinned Rev. Proc. read the base only when
// no adjustment applies (there is no such year in force today) and
// otherwise require the unresolved COLA multiplier, a SOURCE_GAP
// (honest refusal, never a silently unadjusted base).
// The credit percentage and phaseout percentage of IRC_S32_TABLE_1 are NOT
// themselves inflation-adjusted and are used directly.

use self::{
    IRC_S32_A,
    IRC_S32_B,
    IRC_S32_C,
    IRC_S32_I,
    IRC_S32_TABLE_1,
    IRC_S32_TABLE_2,
    Individual,
    Person,
    TaxableYear,
    meets_special_age_test_32n,
    special_credit_percentage_no_children_32n,
    special_earned_income_amount_no_children_32n,
    special_phaseout_amount_no_children_32n,
    year_in_2021_special_rules_32n,
};

pub enum QualifyingChildCountBand { Zero; One; Two; ThreeOrMore; }
relation qualifying_child_count_band(taxpayer: Individual, y: TaxableYear, band: QualifyingChildCountBand) kind institutional {
    label en official "the section 32(b) number-of-qualifying-children band applicable to the taxpayer for the taxable year";
}
// Counting a supplied roster is not proof that the open-world roster is complete.
// Reviewed count-band inputs remain usable by amount-only scenarios without a roster.
pub relation qualifying_child_roster_complete_32(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the qualifying-child roster supplied for this taxpayer and year is complete for section 32";
}
rule QualifyingChildCountBandZero(taxpayer: Individual, y: TaxableYear) defeasible {
    label en official "no section 32(c)(3) qualifying children";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    when qualifying_child_roster_complete_32(taxpayer, y);
    when count(collect child: Person where earned_income_credit_qualifying_child(child, taxpayer, y)) == 0;
    then qualifying_child_count_band(taxpayer, y, Zero);
}
rule QualifyingChildCountBandOne(taxpayer: Individual, y: TaxableYear) defeasible {
    label en official "exactly one section 32(c)(3) qualifying child";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    when qualifying_child_roster_complete_32(taxpayer, y);
    when count(collect child: Person where earned_income_credit_qualifying_child(child, taxpayer, y)) == 1;
    then qualifying_child_count_band(taxpayer, y, One);
}
rule QualifyingChildCountBandTwo(taxpayer: Individual, y: TaxableYear) defeasible {
    label en official "exactly two section 32(c)(3) qualifying children";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    when qualifying_child_roster_complete_32(taxpayer, y);
    when count(collect child: Person where earned_income_credit_qualifying_child(child, taxpayer, y)) == 2;
    then qualifying_child_count_band(taxpayer, y, Two);
}
@source(IRC_S32_C, quote = "a qualifying child of the taxpayer (as defined in section 152(c), determined without regard to paragraph (1)(D) thereof and section 152(e))")
rule QualifyingChildCountBandThreeOrMore(taxpayer: Individual, y: TaxableYear) defeasible {
    label en official "three or more section 32(c)(3) qualifying children";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    when qualifying_child_roster_complete_32(taxpayer, y);
    when count(collect child: Person where earned_income_credit_qualifying_child(child, taxpayer, y)) >= 3;
    then qualifying_child_count_band(taxpayer, y, ThreeOrMore);
}

pub relation earned_income_credit_qualifying_child(child: Person, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "a qualifying child for purposes of the earned income credit (section 32(c)(3))";
}
relation married_and_no_151_deduction(child: Person, taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "married as of the close of the taxpayer's taxable year, without the taxpayer being entitled to a section 151 deduction (or entitled but for section 152(e)) (section 32(c)(3)(B), disqualifying)";
}
relation principal_place_of_abode_in_us_152c1b(child: Person, taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the section 152(c)(1)(B) principal-place-of-abode requirement, satisfied only if the abode is in the United States (section 32(c)(3)(C))";
}
@source(IRC_S32_C, quote = "The term \"qualifying child\" means a qualifying child of the taxpayer (as defined in section 152(c), determined without regard to paragraph (1)(D) thereof and section 152(e))")
rule EarnedIncomeCreditQualifyingChild(child: Person, taxpayer: Individual, y: TaxableYear) strict {
    label en official "a section 152(c) qualifying child (without the 152(c)(1)(D) support test and without the 152(e) divorced-parents rule), whose US-abode requirement is met, and who is not disqualified by the married-without-151-deduction rule, is a qualifying child for the EIC";
    when us.irc.gross_income::qualifying_child_of(child, taxpayer, y);
    when principal_place_of_abode_in_us_152c1b(child, taxpayer, y);
    when not married_and_no_151_deduction(child, taxpayer, y);
    then earned_income_credit_qualifying_child(child, taxpayer, y);
}
// §32(c)(4): a member of the Armed Forces stationed outside the US on
// extended active duty is treated as having a US abode for (c)(1)(A)(ii)(I)
// and (c)(3)(C) — narrows `principal_place_of_abode_in_us_152c1b`'s case
// assertion; INTERPRETATION, not a separate top-level disposition.

// --- §32(c)(1): eligible individual ----------------------------------------------

pub relation eic_eligible_individual(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "an eligible individual for the earned income credit (section 32(c)(1))";
}
relation has_qualifying_child_for_year(taxpayer: Individual, y: TaxableYear) kind institutional;
rule HasQualifyingChildForYear(taxpayer: Individual, y: TaxableYear, child: Person) strict {
    when earned_income_credit_qualifying_child(child, taxpayer, y);
    then has_qualifying_child_for_year(taxpayer, y);
}
relation principal_place_of_abode_in_us_more_than_half_year_32(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "principal place of abode in the United States for more than one-half of the taxable year (section 32(c)(1)(A)(ii)(I))";
}
relation attained_25_not_65(taxpayer: Individual, spouse: Individual, y: TaxableYear) kind empirical {
    label en official "the individual, or if married either the individual or spouse, has attained age 25 but not age 65 before the close of the taxable year (section 32(c)(1)(A)(ii)(II))";
}
relation claims_911_benefits(taxpayer: Individual, y: TaxableYear) kind empirical { label en official "claims the benefits of section 911 for the taxable year (section 32(c)(1)(C), disqualifying)"; }
relation nonresident_alien_without_6013gh_election(taxpayer: Individual, y: TaxableYear) kind empirical { label en official "a nonresident alien individual for any portion of the year, without a section 6013(g)/(h) resident election (section 32(c)(1)(D), disqualifying)"; }
relation qualifying_child_of_another_taxpayer_same_calendar_year(taxpayer: Individual, y: TaxableYear) kind institutional { label en official "is itself the qualifying child of another taxpayer for a taxable year beginning in the same calendar year (section 32(c)(1)(B), disqualifying)"; }
relation eic_identification_requirements_met(taxpayer: Individual, y: TaxableYear) kind empirical { label en official "the taxpayer (and spouse, if married) includes the taxpayer identification number(s) required by section 32(c)(1)(E)/(m)"; }

@source(IRC_S32_C, quote = "any individual who has a qualifying child for the taxable year")
rule EligibleIndividualWithQualifyingChild(taxpayer: Individual, y: TaxableYear) strict {
    label en official "an individual with a qualifying child for the year is eligible, subject to the 911/nonresident-alien/identification/another's-qualifying-child bars";
    when has_qualifying_child_for_year(taxpayer, y);
    when not claims_911_benefits(taxpayer, y);
    when not nonresident_alien_without_6013gh_election(taxpayer, y);
    when not_known(qualifying_child_of_another_taxpayer_same_calendar_year(taxpayer, y));
    when eic_identification_requirements_met(taxpayer, y);
    then eic_eligible_individual(taxpayer, y);
}
@source(IRC_S32_C, quote = "any other individual who does not have a qualifying child for the taxable year, if—")
rule EligibleIndividualWithoutQualifyingChild(taxpayer: Individual, spouse: Individual, y: TaxableYear) defeasible {
    label en official "without a qualifying child, an individual is eligible if the US-abode, age-25-to-64, and not-another's-dependent tests of (c)(1)(A)(ii) are met, subject to the same general bars";
    when not_known(has_qualifying_child_for_year(taxpayer, y));
    when principal_place_of_abode_in_us_more_than_half_year_32(taxpayer, y);
    when attained_25_not_65(taxpayer, spouse, y);
    when not_known(claimed_as_dependent_151_same_calendar_year(taxpayer, y));
    when not claims_911_benefits(taxpayer, y);
    when not nonresident_alien_without_6013gh_election(taxpayer, y);
    when eic_identification_requirements_met(taxpayer, y);
    then eic_eligible_individual(taxpayer, y);
}
relation claimed_as_dependent_151_same_calendar_year(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "a dependent for whom a section 151 deduction is allowable to another taxpayer for a taxable year beginning in the same calendar year (section 32(c)(1)(A)(ii)(III)) — read from us.irc.gross_income::is_dependent_of_anyone_base (WIRE-3; INTERPRETATION: base eligibility for the same taxable year y, not the final 152(b)-resolved status and not a calendar-year window)";
}
@source(IRC_S32_C, quote = "such individual is not a dependent for whom a deduction is allowable under section 151 to another taxpayer for any taxable year beginning in the same calendar year as such taxable year")
rule ClaimedAsDependent151SameCalendarYear(taxpayer: Individual, y: TaxableYear) strict {
    label en official "an individual who is a dependent of some taxpayer (base test) is one for whom a section 151 deduction is allowable to another taxpayer";
    when us.irc.gross_income::is_dependent_of_anyone_base(taxpayer, y);
    then claimed_as_dependent_151_same_calendar_year(taxpayer, y);
}

// §32(d): a married individual may claim the EIC only on a joint return,
// unless the section 7703(a)/(b) constructive-not-married exception of
// (d)(2)(B) applies — reuses `us.irc.income_individual::married_at_close_of_
// year`/`joint_return_filed` exactly as `21-dependent-care-credit.law`'s
// joint-return idiom; recorded as INTERPRETATION (same pattern, not
// duplicated verbatim a third time in this file).

// --- §32(c)(2): earned income ------------------------------------------------------

pub relation earned_income_32(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "earned income for purposes of section 32 (section 32(c)(2)) — also read by 24-child-tax-credit.law's refundable-credit formula, per that module's cross-reference";
}
relation wages_salaries_tips_compensation(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical { label en official "wages, salaries, tips, and other employee compensation includible in gross income (section 32(c)(2)(A)(i))"; }
// Net self-employment earnings are read from the owner,
// `us.irc.other_income_taxes::net_earnings_from_self_employment`
// (section 1402(a), computed there as gross minus the (a)(12) deduction
// with the limited-partner exclusion; `Individual` is a subtype of
// `Person`, see `us.irc.core::persons`). The former local twin
// `net_earnings_from_self_employment_1402a` is removed. Boundary: where
// the owner derives no amount (its upstream inputs unasserted), earned
// income does not derive either — no case-level substitute is asserted
// here.
@source(IRC_S32_C, quote = "wages, salaries, tips, and other employee compensation, but only if such amounts are includible in gross income for the taxable year, plus")
rule EarnedIncome32(taxpayer: Individual, y: TaxableYear, wages: Money, selfEmployment: Money) strict {
    label en official "earned income is employee compensation includible in gross income plus net self-employment earnings (as adjusted)";
    when wages_salaries_tips_compensation(taxpayer, y, wages);
    when us.irc.other_income_taxes::net_earnings_from_self_employment(taxpayer, y, selfEmployment);
    then earned_income_32(taxpayer, y, wages + selfEmployment);
}
// §32(c)(2)(B)(i)-(vi): community-property disregard, pension/annuity
// exclusion, section 871(a) exclusion, inmate-compensation exclusion,
// subsidized-work-activity exclusion, and the section 112 combat-pay
// election are qualifying conditions on what counts as an item of
// `wages_salaries_tips_compensation` above; INTERPRETATION, not separate
// dispositions.

// --- §32(a)/(b): the credit (STRUCTURE modelled; table values TECH_GAP) --------

pub relation eic_credit_percentage(band: QualifyingChildCountBand, pct: Decimal) kind institutional {
    label en official "the section 32(b)(1) credit percentage by qualifying-child band (IRC_S32_TABLE_1)";
}
pub relation eic_phaseout_percentage(band: QualifyingChildCountBand, pct: Decimal) kind institutional {
    label en official "the section 32(b)(1) phaseout percentage by qualifying-child band (IRC_S32_TABLE_1)";
}
@source(IRC_S32_TABLE_1, quote = "No qualifying children / 7.65 / 7.65")
assert eic_credit_percentage(Zero, 0.0765);
@source(IRC_S32_TABLE_1, quote = "1 qualifying child / 34 / 15.98")
assert eic_credit_percentage(One, 0.34);
@source(IRC_S32_TABLE_1, quote = "2 qualifying children / 40 / 21.06")
assert eic_credit_percentage(Two, 0.40);
@source(IRC_S32_TABLE_1, quote = "3 or more qualifying children / 45 / 21.06")
assert eic_credit_percentage(ThreeOrMore, 0.45);
@source(IRC_S32_TABLE_1, quote = "No qualifying children / 7.65 / 7.65")
assert eic_phaseout_percentage(Zero, 0.0765);
@source(IRC_S32_TABLE_1, quote = "1 qualifying child / 34 / 15.98")
assert eic_phaseout_percentage(One, 0.1598);
@source(IRC_S32_TABLE_1, quote = "2 qualifying children / 40 / 21.06")
assert eic_phaseout_percentage(Two, 0.2106);
@source(IRC_S32_TABLE_1, quote = "3 or more qualifying children / 45 / 21.06")
assert eic_phaseout_percentage(ThreeOrMore, 0.2106);

pub relation eic_earned_income_amount_statutory_base(band: QualifyingChildCountBand, amount: Money) kind institutional {
    label en official "the section 32(b)(2)(A) earned income amount by band, as codified (IRC_S32_TABLE_2), before the (j) cost-of-living increase";
}
pub relation eic_phaseout_amount_statutory_base(band: QualifyingChildCountBand, amount: Money) kind institutional {
    label en official "the section 32(b)(2)(A) phaseout amount by band, as codified (IRC_S32_TABLE_2), before the (b)(2)(B) joint-return add-on and the (j) cost-of-living increase";
}
@source(IRC_S32_TABLE_2, quote = "No qualifying children / $4,220 / $5,280")
assert eic_earned_income_amount_statutory_base(Zero, 4220.00 USD);
@source(IRC_S32_TABLE_2, quote = "1 qualifying child / $6,330 / $11,610")
assert eic_earned_income_amount_statutory_base(One, 6330.00 USD);
@source(IRC_S32_TABLE_2, quote = "2 or more qualifying children / $8,890 / $11,610")
assert eic_earned_income_amount_statutory_base(Two, 8890.00 USD);
assert eic_earned_income_amount_statutory_base(ThreeOrMore, 8890.00 USD);
@source(IRC_S32_TABLE_2, quote = "No qualifying children / $4,220 / $5,280")
assert eic_phaseout_amount_statutory_base(Zero, 5280.00 USD);
@source(IRC_S32_TABLE_2, quote = "1 qualifying child / $6,330 / $11,610")
assert eic_phaseout_amount_statutory_base(One, 11610.00 USD);
@source(IRC_S32_TABLE_2, quote = "2 or more qualifying children / $8,890 / $11,610")
assert eic_phaseout_amount_statutory_base(Two, 11610.00 USD);
assert eic_phaseout_amount_statutory_base(ThreeOrMore, 11610.00 USD);

pub relation eic_earned_income_amount(band: QualifyingChildCountBand, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 32(b)(2)(A) earned income amount for the taxable year, after the section 32(j) cost-of-living increase";
}
pub relation eic_phaseout_amount_base(band: QualifyingChildCountBand, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 32(b)(2)(A) phaseout amount for the taxable year, after the section 32(j) cost-of-living increase, before the (b)(2)(B) joint-return $5,000 add-on";
}
relation eic_cola_multiplier_32j(y: TaxableYear, multiplier: Decimal) kind institutional {
    label en official "the section 32(j) cost-of-living adjustment multiplier for the taxable year — SOURCE_GAP: section 32(j)(1) requires this increase for every taxable year beginning after 2015 (2021 for the (i)(1) amount), but no Rev. Proc. published multiplier for any year is pinned in this corpus; the statutory base values above are therefore never, by themselves, the correct current-law amount for a real post-2015 taxable year";
}
@source(IRC_S32_TABLE_2, relation = formalizes, coverage = contextual, quote = "$4,220")
rule EicEarnedIncomeAmountWithCola(band: QualifyingChildCountBand, y: TaxableYear, base: Money, mult: Decimal) strict {
    label en official "the earned income amount is the statutory base times the section 32(j) multiplier for the year (never resolves absent a pinned multiplier — see SOURCE_GAP above)";
    when eic_earned_income_amount_statutory_base(band, base);
    when eic_cola_multiplier_32j(y, mult);
    then eic_earned_income_amount(band, y, round(base * mult, 2, "HALF_UP"));
}
rule EicPhaseoutAmountBaseWithCola(band: QualifyingChildCountBand, y: TaxableYear, base: Money, mult: Decimal) strict {
    label en official "the phaseout amount (before the joint-return add-on) is the statutory base times the section 32(j) multiplier for the year";
    when eic_phaseout_amount_statutory_base(band, base);
    when eic_cola_multiplier_32j(y, mult);
    then eic_phaseout_amount_base(band, y, round(base * mult, 2, "HALF_UP"));
}

// --- §32(b)(2): published inflation-adjusted figures (A3 parameters) --------
//
// For years with a pinned Rev. Proc. (2025: Rev. Proc. 2024-40 §2.06;
// 2026: Rev. Proc. 2025-32 §4.06) the earned income amount and the
// phaseout thresholds are the published figures, read by named parameter
// (the same consumption shape as `section-199a-threshold-amount-joint`).
// The filing-status `when` grounds the taxable year, as there.

rule EicEarnedIncomeAmountZeroFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "the earned income amount for no qualifying children is the published inflation-adjusted figure for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then eic_earned_income_amount(Zero, y, round(EicEarnedIncomeAmountZero, 2, "HALF_UP"));
}
rule EicEarnedIncomeAmountOneFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "the earned income amount for 1 qualifying child is the published inflation-adjusted figure for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then eic_earned_income_amount(One, y, round(EicEarnedIncomeAmountOne, 2, "HALF_UP"));
}
rule EicEarnedIncomeAmountTwoFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "the earned income amount for 2 qualifying children is the published inflation-adjusted figure for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then eic_earned_income_amount(Two, y, round(EicEarnedIncomeAmountTwo, 2, "HALF_UP"));
}
rule EicEarnedIncomeAmountThreeOrMoreFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "the earned income amount for 3 or more qualifying children is the published inflation-adjusted figure for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then eic_earned_income_amount(ThreeOrMore, y, round(EicEarnedIncomeAmountThreeOrMore, 2, "HALF_UP"));
}

pub relation eic_phaseout_amount(band: QualifyingChildCountBand, taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 32(b)(2) phaseout amount, including the (B) joint-return $5,000 add-on";
}
// The joint-return threshold below is the PUBLISHED figure, which already
// includes the section 32(b)(2)(B) $5,000-as-adjusted increase: the Rev.
// Proc. never publishes the add-on separately, and each published column
// is independently rounded under (j)(2)(A), so joint-minus-other is not
// uniform across bands (2025: $7,120 for bands 1-3+, $7,110 for band 0;
// 2026: $7,270 / $7,280). No hard $5,000 is ever added here.
@source(IRC_S32_B, quote = "the phaseout amount determined under subparagraph (A) shall be increased by $5,000")
rule EicPhaseoutAmountJointZeroFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "on a joint return with no qualifying children, the phaseout amount is the published joint threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, us.irc.income_individual::Joint);
    then eic_phaseout_amount(Zero, taxpayer, y, round(EicPhaseoutAmountJointZero, 2, "HALF_UP"));
}
@source(IRC_S32_B, quote = "the phaseout amount determined under subparagraph (A) shall be increased by $5,000")
rule EicPhaseoutAmountJointOneFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "on a joint return with 1 qualifying child, the phaseout amount is the published joint threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, us.irc.income_individual::Joint);
    then eic_phaseout_amount(One, taxpayer, y, round(EicPhaseoutAmountJointOne, 2, "HALF_UP"));
}
@source(IRC_S32_B, quote = "the phaseout amount determined under subparagraph (A) shall be increased by $5,000")
rule EicPhaseoutAmountJointTwoFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "on a joint return with 2 qualifying children, the phaseout amount is the published joint threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, us.irc.income_individual::Joint);
    then eic_phaseout_amount(Two, taxpayer, y, round(EicPhaseoutAmountJointTwo, 2, "HALF_UP"));
}
@source(IRC_S32_B, quote = "the phaseout amount determined under subparagraph (A) shall be increased by $5,000")
rule EicPhaseoutAmountJointThreeOrMoreFromRevenueProcedure(taxpayer: Individual, y: TaxableYear) strict {
    label en official "on a joint return with 3 or more qualifying children, the phaseout amount is the published joint threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, us.irc.income_individual::Joint);
    then eic_phaseout_amount(ThreeOrMore, taxpayer, y, round(EicPhaseoutAmountJointThreeOrMore, 2, "HALF_UP"));
}
rule EicPhaseoutAmountNonJointZeroFromRevenueProcedure(taxpayer: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "off a joint return with no qualifying children, the phaseout amount is the published other-filers threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, s);
    when s != us.irc.income_individual::Joint;
    then eic_phaseout_amount(Zero, taxpayer, y, round(EicPhaseoutAmountOtherZero, 2, "HALF_UP"));
}
rule EicPhaseoutAmountNonJointOneFromRevenueProcedure(taxpayer: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "off a joint return with 1 qualifying child, the phaseout amount is the published other-filers threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, s);
    when s != us.irc.income_individual::Joint;
    then eic_phaseout_amount(One, taxpayer, y, round(EicPhaseoutAmountOtherOne, 2, "HALF_UP"));
}
rule EicPhaseoutAmountNonJointTwoFromRevenueProcedure(taxpayer: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "off a joint return with 2 qualifying children, the phaseout amount is the published other-filers threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, s);
    when s != us.irc.income_individual::Joint;
    then eic_phaseout_amount(Two, taxpayer, y, round(EicPhaseoutAmountOtherTwo, 2, "HALF_UP"));
}
rule EicPhaseoutAmountNonJointThreeOrMoreFromRevenueProcedure(taxpayer: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "off a joint return with 3 or more qualifying children, the phaseout amount is the published other-filers threshold for the year";
    when us.irc.income_individual::filing_status(taxpayer, y, s);
    when s != us.irc.income_individual::Joint;
    then eic_phaseout_amount(ThreeOrMore, taxpayer, y, round(EicPhaseoutAmountOtherThreeOrMore, 2, "HALF_UP"));
}

pub relation earned_income_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earned income credit (section 32(a))";
}
@source(IRC_S32_A, quote = "an amount equal to the credit percentage of so much of the taxpayer's earned income for the taxable year as does not exceed the earned income amount")
rule EarnedIncomeCreditGeneral(taxpayer: Individual, y: TaxableYear, band: QualifyingChildCountBand, creditPct: Decimal, phaseoutPct: Decimal, earned: Money, eia: Money, phaseoutAmt: Money, agi: Money) defeasible {
    label en official "the credit is the credit percentage of earned income up to the earned income amount, less the phaseout percentage of the excess of the greater of AGI or earned income over the phaseout amount, not below zero; disallowed if disqualified investment income under (i) exceeds the (i)(1) limit for the year or the taxable year is in the (k) disallowance period, and never for a short (<12-month) taxable year under (e)";
    when eic_eligible_individual(taxpayer, y);
    when qualifying_child_count_band(taxpayer, y, band);
    when eic_credit_percentage(band, creditPct);
    when eic_phaseout_percentage(band, phaseoutPct);
    when earned_income_32(taxpayer, y, earned);
    when eic_earned_income_amount(band, y, eia);
    when eic_phaseout_amount(band, taxpayer, y, phaseoutAmt);
    when us.irc.gross_income::adjusted_gross_income(taxpayer, y, agi);
    when disqualified_income_within_limit_32i(taxpayer, y);
    when not in_disallowance_period_32k(taxpayer, y);
    when not short_taxable_year_under_12_months_32(taxpayer, y);
    then earned_income_credit(taxpayer, y,
        max(0 USD, round(creditPct * min(earned, eia), 2, "HALF_UP")
            - round(phaseoutPct * max(0 USD, max(agi, earned) - phaseoutAmt), 2, "HALF_UP")));
}

// --- §32(n): the 2021 computation (companion module `32-special-rules-for-2021-and-repeal.law`) ---
//
// For a 2021 taxable year with no qualifying children, eligibility uses
// the (n)(1)-(2) special age test (no upper age limit) in place of the
// (c)(1)(A)(ii)(II) 25-to-64 test, and the credit uses the (n)(3)
// 15.3 percent percentage with the (n)(4) $9,820/$11,610 amounts, to
// which (j) does not apply ((n)(4)(B)). Scope: off a joint return only —
// a 2021 joint return would add the (b)(2)(B) increase to the $11,610
// figure, and no Rev. Proc. publishing that 2021 increase is pinned
// (honest refusal). 2021 bands with qualifying children likewise need
// unpinned 2021 published figures and do not derive here.
@source(IRC_S32_C, quote = "any other individual who does not have a qualifying child for the taxable year, if—")
rule EligibleIndividualWithoutQualifyingChild2021(taxpayer: Individual, spouse: Individual, y: TaxableYear) defeasible {
    label en official "for 2021 without a qualifying child, an individual is eligible under the (n) special age test (no upper age limit), subject to the same general bars";
    when year_in_2021_special_rules_32n(y);
    when not_known(has_qualifying_child_for_year(taxpayer, y));
    when principal_place_of_abode_in_us_more_than_half_year_32(taxpayer, y);
    when meets_special_age_test_32n(taxpayer, y);
    when not_known(claimed_as_dependent_151_same_calendar_year(taxpayer, y));
    when not claims_911_benefits(taxpayer, y);
    when not nonresident_alien_without_6013gh_election(taxpayer, y);
    when eic_identification_requirements_met(taxpayer, y);
    then eic_eligible_individual(taxpayer, y);
}
@source(IRC_S32_A, quote = "an amount equal to the credit percentage of so much of the taxpayer's earned income for the taxable year as does not exceed the earned income amount")
rule EarnedIncomeCredit2021NoChildren(taxpayer: Individual, y: TaxableYear, creditPct: Decimal, phaseoutPct: Decimal, earned: Money, eia: Money, phaseoutAmt: Money, agi: Money, s: us.irc.income_individual::FilingStatus) defeasible {
    label en official "for 2021 without qualifying children and off a joint return, the credit is 15.3 percent of earned income up to $9,820, less 7.65 percent of the excess of the greater of AGI or earned income over $11,610, not below zero, with the same (i)/(k)/(e) bars";
    when year_in_2021_special_rules_32n(y);
    when eic_eligible_individual(taxpayer, y);
    when qualifying_child_count_band(taxpayer, y, Zero);
    when special_credit_percentage_no_children_32n(y, creditPct);
    when eic_phaseout_percentage(Zero, phaseoutPct);
    when earned_income_32(taxpayer, y, earned);
    when special_earned_income_amount_no_children_32n(y, eia);
    when special_phaseout_amount_no_children_32n(y, phaseoutAmt);
    when us.irc.income_individual::filing_status(taxpayer, y, s);
    when s != us.irc.income_individual::Joint;
    when us.irc.gross_income::adjusted_gross_income(taxpayer, y, agi);
    when disqualified_income_within_limit_32i(taxpayer, y);
    when not in_disallowance_period_32k(taxpayer, y);
    when not short_taxable_year_under_12_months_32(taxpayer, y);
    then earned_income_credit(taxpayer, y,
        max(0 USD, round(creditPct * min(earned, eia), 2, "HALF_UP")
            - round(phaseoutPct * max(0 USD, max(agi, earned) - phaseoutAmt), 2, "HALF_UP")));
}
// --- §32(i): denial for excessive investment income -----------------------------
//
// Disqualified income is the section 32(i)(2) aggregate of five items.
// Item (D), capital gain net income, is read from the owner
// (`us.irc.property_transactions::capital_gain_net_income`, section 1222;
// `Individual` is a subtype of `Person`). The other four items have no
// producer in this corpus and are case facts: the (C) and (E) figures are
// the statutory excesses as computed by the case (gross rents/royalties
// not in the ordinary course of business minus the allocable deductions
// of (C)(ii); aggregate passive-activity income minus aggregate
// passive-activity losses, determined without regard to earned income or
// the preceding subparagraphs, of (E)). The (i)(1) limit is the A3
// parameter `DisqualifiedIncomeLimit32i` ($10,000 statutory, as adjusted:
// $11,950 for 2025, $12,200 for 2026).
relation disqualified_interest_dividends_32i2A(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest or dividends to the extent includible in gross income for the taxable year (section 32(i)(2)(A)) — case-asserted";
}
relation disqualified_tax_exempt_interest_32i2B(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest received or accrued during the taxable year which is exempt from tax imposed by this chapter (section 32(i)(2)(B)) — case-asserted";
}
relation disqualified_rent_royalty_excess_32i2C(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 32(i)(2)(C) excess (if any) of gross rents/royalties not derived in the ordinary course of a trade or business over the allocable deductions, as computed by the case — case-asserted";
}
relation disqualified_passive_excess_32i2E(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 32(i)(2)(E) excess (if any) of aggregate passive-activity income over aggregate passive-activity losses (passive activity per section 469), as computed by the case — case-asserted";
}
relation disqualified_income_exceeds_limit_32i(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "the section 32(i) disqualified-income aggregate exceeds the (i)(1) limit for the year";
}
@source(IRC_S32_I, quote = "if the aggregate amount of disqualified income of the taxpayer for the taxable year exceeds $10,000")
rule DisqualifiedIncomeExceedsLimit32i(taxpayer: Individual, y: TaxableYear, a: Money, b: Money, c: Money, d: Money, e: Money) defeasible {
    label en official "disqualified income — the (i)(2)(A)-(E) aggregate — exceeds the (i)(1) limit for the year, and no credit is allowed";
    when disqualified_interest_dividends_32i2A(taxpayer, y, a);
    when disqualified_tax_exempt_interest_32i2B(taxpayer, y, b);
    when disqualified_rent_royalty_excess_32i2C(taxpayer, y, c);
    when us.irc.property_transactions::capital_gain_net_income(taxpayer, y, d);
    when disqualified_passive_excess_32i2E(taxpayer, y, e);
    when (a + b + c + d + e) > DisqualifiedIncomeLimit32i;
    then disqualified_income_exceeds_limit_32i(taxpayer, y);
}
// Positive, complete investment-income evidence is required for an amount.
// Missing components cannot be mistaken for an aggregate below the limit.
pub relation disqualified_income_within_limit_32i(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the complete section 32(i)(2)(A)-(E) aggregate does not exceed the published limit";
}
@source(IRC_S32_I, quote = "if the aggregate amount of disqualified income of the taxpayer for the taxable year exceeds $10,000")
rule DisqualifiedIncomeWithinLimit32i(taxpayer: Individual, y: TaxableYear, a: Money, b: Money, c: Money, d: Money, e: Money) defeasible {
    label en official "the complete disqualified-income aggregate is within the published limit for the year";
    when disqualified_interest_dividends_32i2A(taxpayer, y, a);
    when disqualified_tax_exempt_interest_32i2B(taxpayer, y, b);
    when disqualified_rent_royalty_excess_32i2C(taxpayer, y, c);
    when us.irc.property_transactions::capital_gain_net_income(taxpayer, y, d);
    when disqualified_passive_excess_32i2E(taxpayer, y, e);
    when (a + b + c + d + e) <= DisqualifiedIncomeLimit32i;
    then disqualified_income_within_limit_32i(taxpayer, y);
}
relation in_disallowance_period_32k(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxable year falls in the section 32(k) fraud (10-year) or reckless-disregard (2-year) EIC disallowance period";
}
relation short_taxable_year_under_12_months_32(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "a taxable year covering a period of less than 12 months, not closed by the taxpayer's death (section 32(e))";
}

// §32(f): the Secretary's EIC tables (built FROM subsections (a)/(b) in
// $50 brackets) are an administrative computation aid, not a separate
// disposition — NON_NORMATIVE (the (a)/(b) formula above is the norm).
//
// §32(l): the anti-attribution rule for other federal benefit programs
// (housing, SNAP) is NON_NORMATIVE for this package (it constrains OTHER
// programs' resource/income tests, not this section's own credit
// computation).
//
// §32(n): the 2021-only ARPA modifications (lower minimum age by claimant
// category, 15.3 percent no-children credit percentage substituted for
// 7.65, and "$9,820"/"$11,610" substituted for the no-children row of
// IRC_S32_TABLE_2) are wired to the computation by
// `EligibleIndividualWithoutQualifyingChild2021` and
// `EarnedIncomeCredit2021NoChildren` above (off a joint return; the 2021
// joint (b)(2)(B) increase is unpinned, see there).
