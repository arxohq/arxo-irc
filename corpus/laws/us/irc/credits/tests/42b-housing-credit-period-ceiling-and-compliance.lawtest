        assert "f2": us.irc.core::begins(entity_ref("urn:test:42b:w3#y1"), @2020-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:42b:w3#y1"), @2020-12-31) { origin case_input; }
        assert "f4": elects_succeeding_year_credit_period_42(entity_ref("urn:test:42b:w3#b")) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:42b:w3#y2030"), @2030-01-01) { origin case_input; }
    }
    // (f)(1)(B): the election moves the first year to 2021: the tenth year begins 2030-01-01.
    evaluate truth(credit_period_year_42(entity_ref("urn:test:42b:w3#b"), entity_ref("urn:test:42b:w3#y2030")));
    expect truth_status == TRUE_ONLY;
}

