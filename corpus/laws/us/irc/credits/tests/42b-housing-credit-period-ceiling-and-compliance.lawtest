test "S42B-09-STATE-CEILING-2024-PER-CAPITA-ROUNDED-DOWN-TO-5-CENTS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": state_population_42(entity_ref("urn:test:42b:w9#s"), 2024.0, 5000000.0) { origin case_input; }
        assert "f1": cost_of_living_factor_42(2024.0, 1.5) { origin case_input; }
        assert "f2": unused_state_ceiling_prior_year_42(entity_ref("urn:test:42b:w9#s"), 2024.0, 500000.00 USD) { origin case_input; }
        assert "f3": state_ceiling_returned_42(entity_ref("urn:test:42b:w9#s"), 2024.0, 100000.00 USD) { origin case_input; }
        assert "f4": secretary_allocation_to_state_42(entity_ref("urn:test:42b:w9#s"), 2024.0, 0 USD) { origin case_input; }
    }
    // 1.75 x 1.5 = 2.625 rounds down to 2.60; x 5,000,000 = 13,000,000 (above the 3,000,000 minimum) + 500,000 + 100,000.
    evaluate truth(state_housing_credit_ceiling_42(entity_ref("urn:test:42b:w9#s"), 2024.0, 13600000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42B-10-STATE-CEILING-2019-INCREASED-BY-1-125" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": state_population_42(entity_ref("urn:test:42b:w10#s"), 2019.0, 1000000.0) { origin case_input; }
        assert "f1": cost_of_living_factor_42(2019.0, 1.4) { origin case_input; }
        assert "f2": unused_state_ceiling_prior_year_42(entity_ref("urn:test:42b:w10#s"), 2019.0, 0 USD) { origin case_input; }
        assert "f3": state_ceiling_returned_42(entity_ref("urn:test:42b:w10#s"), 2019.0, 0 USD) { origin case_input; }
        assert "f4": secretary_allocation_to_state_42(entity_ref("urn:test:42b:w10#s"), 2019.0, 0 USD) { origin case_input; }
    }
    // per capita 2.45 x 1.125 x 1,000,000 = 2,756,250 below the indexed minimum 2,800,000 x 1.125 = 3,150,000.
    evaluate truth(state_housing_credit_ceiling_42(entity_ref("urn:test:42b:w10#s"), 2019.0, 3150000.00 USD));
    expect truth_status == TRUE_ONLY;
}

