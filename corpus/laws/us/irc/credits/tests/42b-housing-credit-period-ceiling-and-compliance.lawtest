        assert "f6": monthly_applicable_fraction_42(entity_ref("urn:test:42b:w7#b"), entity_ref("urn:test:42b:w7#y1"), 3.0, 0.0) { origin case_input; }
        assert "f7": monthly_applicable_fraction_42(entity_ref("urn:test:42b:w7#b"), entity_ref("urn:test:42b:w7#y1"), 4.0, 0.0) { origin case_input; }
        assert "f8": monthly_applicable_fraction_42(entity_ref("urn:test:42b:w7#b"), entity_ref("urn:test:42b:w7#y1"), 5.0, 0.0) { origin case_input; }
