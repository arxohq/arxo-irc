// Section 42 residual scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S42B-01-TENTH-YEAR-STILL-IN-CREDIT-PERIOD" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": building_placed_in_service_on_42(entity_ref("urn:test:42b:w1#b"), @2020-06-15) { origin case_input; }
        assert "f1": qualified_low_income_building_at_first_year_close_42(entity_ref("urn:test:42b:w1#b")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:42b:w1#y1"), @2020-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:42b:w1#y1"), @2020-12-31) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:42b:w1#y10"), @2029-01-01) { origin case_input; }
    }
    // placed in service 2020-06-15: the first year begins 2020-01-01; 2029 is the tenth year.
    evaluate truth(credit_period_year_42(entity_ref("urn:test:42b:w1#b"), entity_ref("urn:test:42b:w1#y10")));
    expect truth_status == TRUE_ONLY;
}

