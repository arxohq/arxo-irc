// Section 45R scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45R-01-ELIGIBLE-SMALL-EMPLOYER-NO-PHASEOUT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_health_plan_employer_contribution(entity_ref("urn:test:s45r:w1#e"), entity_ref("urn:test:s45r:w1#y1"), 40000.00 USD) { origin case_input; }
        assert "f2": qualified_health_plan_average_premium_amount(entity_ref("urn:test:s45r:w1#e"), entity_ref("urn:test:s45r:w1#y1"), 60000.00 USD) { origin case_input; }
        assert "f3": full_time_equivalent_employees(entity_ref("urn:test:s45r:w1#e"), entity_ref("urn:test:s45r:w1#y1"), 8.0) { origin case_input; }
        assert "f4": average_annual_wages(entity_ref("urn:test:s45r:w1#e"), entity_ref("urn:test:s45r:w1#y1"), 30000.00 USD) { origin case_input; }
        assert "f5": section_45r_d4_arrangement_in_effect(entity_ref("urn:test:s45r:w1#e"), entity_ref("urn:test:s45r:w1#y1")) { origin case_input; }
        assert "f6": within_credit_period_45r(entity_ref("urn:test:s45r:w1#e"), entity_ref("urn:test:s45r:w1#y1")) { origin case_input; }
    }
    // before = 50% * min(40000,60000) = 20000; FTE=8 <=10 no reduction; wages 30000 <= 33300 (2025 dollar amount) no reduction.
    evaluate truth(small_employer_health_insurance_credit(entity_ref("urn:test:s45r:w1#e"), entity_ref("urn:test:s45r:w1#y1"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45R-02-TAX-EXEMPT-EMPLOYER-35-PERCENT-RATE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_health_plan_employer_contribution(entity_ref("urn:test:s45r:w2#e"), entity_ref("urn:test:s45r:w2#y1"), 40000.00 USD) { origin case_input; }
        assert "f2": qualified_health_plan_average_premium_amount(entity_ref("urn:test:s45r:w2#e"), entity_ref("urn:test:s45r:w2#y1"), 60000.00 USD) { origin case_input; }
        assert "f3": tax_exempt_eligible_small_employer(entity_ref("urn:test:s45r:w2#e")) { origin case_input; }
    }
    // 35% * min(40000,60000) = 14000.
    evaluate truth(health_insurance_credit_before_phaseout(entity_ref("urn:test:s45r:w2#e"), entity_ref("urn:test:s45r:w2#y1"), 14000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45R-03-FTE-PHASEOUT-REDUCTION" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": health_insurance_credit_before_phaseout(entity_ref("urn:test:s45r:w3#e"), entity_ref("urn:test:s45r:w3#y1"), 15000.00 USD) { origin case_input; }
        assert "f2": full_time_equivalent_employees(entity_ref("urn:test:s45r:w3#e"), entity_ref("urn:test:s45r:w3#y1"), 20.0) { origin case_input; }
    }
    // (20-10)/15 = 0.6666666667; 15000 * that = 10000.00 (rounded).
    evaluate truth(phaseout_reduction_fte(entity_ref("urn:test:s45r:w3#e"), entity_ref("urn:test:s45r:w3#y1"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45R-04-WAGE-PHASEOUT-REDUCTION-2025-DOLLAR-AMOUNT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": health_insurance_credit_before_phaseout(entity_ref("urn:test:s45r:w4#e"), entity_ref("urn:test:s45r:w4#y1"), 10000.00 USD) { origin case_input; }
        assert "f2": average_annual_wages(entity_ref("urn:test:s45r:w4#e"), entity_ref("urn:test:s45r:w4#y1"), 43300.00 USD) { origin case_input; }
    }
    // dollar amount for 2025 = 33300; excess = 10000; 10000/33300 = 0.3003003...; 10000*that ~ 3003.00
    evaluate truth(phaseout_reduction_wages(entity_ref("urn:test:s45r:w4#e"), entity_ref("urn:test:s45r:w4#y1"), 3003.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45R-05-EMPLOYER-ABOVE-25-FTE-NOT-ELIGIBLE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": full_time_equivalent_employees(entity_ref("urn:test:s45r:w5#e"), entity_ref("urn:test:s45r:w5#y1"), 30.0) { origin case_input; }
        assert "f2": average_annual_wages(entity_ref("urn:test:s45r:w5#e"), entity_ref("urn:test:s45r:w5#y1"), 20000.00 USD) { origin case_input; }
        assert "f3": section_45r_d4_arrangement_in_effect(entity_ref("urn:test:s45r:w5#e"), entity_ref("urn:test:s45r:w5#y1")) { origin case_input; }
    }
    // 30 FTE exceeds the 25-FTE ceiling — no rule concludes eligibility, NEITHER not a proven negative.
    evaluate truth(eligible_small_employer_45r(entity_ref("urn:test:s45r:w5#e"), entity_ref("urn:test:s45r:w5#y1")));
    expect truth_status == NEITHER;
}
