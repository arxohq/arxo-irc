test "S48D5-03-RECAPTURE-ON-AN-EARLY-DISPOSITION" {
    // Rule similar to section 50(a)(1): 60 percent of the 10000 payment.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": direct_pay_election_in_effect_48d(entity_ref("urn:test:cd:t3#t"), entity_ref("urn:test:cd:t3#y")) { origin case_input; }
        assert "f1": advanced_manufacturing_credit_of_property_48d(entity_ref("urn:test:cd:t3#t"), entity_ref("urn:test:cd:t3#p"), entity_ref("urn:test:cd:t3#y"), 10000 USD) { origin case_input; }
        assert "f2": investment_credit_property_disposed_before_recapture_period_ends(entity_ref("urn:test:cd:t3#p"), entity_ref("urn:test:cd:t3#t"), entity_ref("urn:test:cd:t3#y2"), 2.0) { origin case_input; }
        assert "f3": recapture_percentage_50(2.0, 0.60) { origin case_input; }
    }
    evaluate truth(recapture_of_deemed_payment_48d5(entity_ref("urn:test:cd:t3#t"), entity_ref("urn:test:cd:t3#p"), entity_ref("urn:test:cd:t3#y2"), 6000 USD));
    expect truth_status == TRUE_ONLY;
}

