// Stage 4 scenarios: 48D(d)(5) (s4-h), 45U records (s4-i), rules similar to 45(e) (s4-j), cure rules (s4-k), 45(e)(8)-(10)(C) (s4-r). NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";


test "S48D5-01-DEEMED-PAYMENT-OF-THE-PROPERTY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": direct_pay_election_in_effect_48d(entity_ref("urn:test:cd:t1#t"), entity_ref("urn:test:cd:t1#y")) { origin case_input; }
        assert "f1": advanced_manufacturing_credit_of_property_48d(entity_ref("urn:test:cd:t1#t"), entity_ref("urn:test:cd:t1#p"), entity_ref("urn:test:cd:t1#y"), 10000 USD) { origin case_input; }
    }
    evaluate truth(deemed_payment_amount_of_property_48d5(entity_ref("urn:test:cd:t1#t"), entity_ref("urn:test:cd:t1#p"), entity_ref("urn:test:cd:t1#y"), 10000 USD));
    expect truth_status == TRUE_ONLY;
}

