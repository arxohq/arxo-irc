test "S45ZF6B-01-PRE-2025-FACILITY-NEEDS-NO-CONSTRUCTION-WAGES" {
    // Section 45Z(f)(6)(B)(i): clause (i) of section 45(b)(7)(A) does not apply to a facility placed in service before 2025.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_facility_placed_in_service_on_45z_f6(entity_ref("urn:test:cu:t20#f"), @2024-06-01) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:cu:t20#y"), @2025-01-01) { origin case_input; }
        assert "f2": prevailing_wage_alteration_repair_satisfied_45z(entity_ref("urn:test:cu:t20#f"), entity_ref("urn:test:cu:t20#y")) { origin case_input; }
        assert "f3": apprenticeship_satisfied_45z(entity_ref("urn:test:cu:t20#f"), entity_ref("urn:test:cu:t20#y")) { origin case_input; }
    }
    evaluate truth(prevailing_wage_and_apprenticeship_satisfied_45z(entity_ref("urn:test:cu:t20#f"), entity_ref("urn:test:cu:t20#y")));
    expect truth_status == TRUE_ONLY;
}

