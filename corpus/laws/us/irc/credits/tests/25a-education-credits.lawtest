    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": qualified_tuition_and_related_expenses(entity_ref("urn:test:s25a:w6#p"), entity_ref("urn:test:s25a:w6#student"), LlcTuitionFees, 5000.00 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s25a:w6#p"), entity_ref("urn:test:s25a:w6#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        // No adjusted_gross_income asserted.
    }
    evaluate truth(education_credit(entity_ref("urn:test:s25a:w6#p"), entity_ref("urn:test:s25a:w6#y2023"), 1000.00 USD));
    expect truth_status == NEITHER;
}
