// Section 25A scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S25A-01-AOTC-EXPENSES-BETWEEN-2000-AND-4000" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": meets_484a1_hea(entity_ref("urn:test:s25a:w1#student")) { origin case_input; }
        assert "f1": half_time_workload(entity_ref("urn:test:s25a:w1#student"), entity_ref("urn:test:s25a:w1#period")) { origin case_input; }
        assert "f2": aotc_election_in_effect(entity_ref("urn:test:s25a:w1#student"), entity_ref("urn:test:s25a:w1#p"), entity_ref("urn:test:s25a:w1#y2023")) { origin case_input; }
        assert "f3": aotc_prior_election_years_count(entity_ref("urn:test:s25a:w1#student"), entity_ref("urn:test:s25a:w1#y2023"), 0) { origin case_input; }
        assert "f4": qualified_tuition_and_related_expenses(entity_ref("urn:test:s25a:w1#p"), entity_ref("urn:test:s25a:w1#student"), AotcTuitionFeesCourseMaterials, 3000.00 USD) { origin case_input; }
        assert "f5": us.irc.income_individual::filing_status(entity_ref("urn:test:s25a:w1#p"), entity_ref("urn:test:s25a:w1#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f6": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s25a:w1#p"), entity_ref("urn:test:s25a:w1#y2023"), 40000.00 USD) { origin case_input; }
    }
    // 100% of $2,000 + 25% of $1,000 = $2,250; AGI $40,000 < $80,000 floor.
    evaluate truth(education_credit(entity_ref("urn:test:s25a:w1#p"), entity_ref("urn:test:s25a:w1#y2023"), 2250.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S25A-02-LLC-EXPENSES-AT-10000-CAP" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": qualified_tuition_and_related_expenses(entity_ref("urn:test:s25a:w2#p"), entity_ref("urn:test:s25a:w2#student"), LlcTuitionFees, 12000.00 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s25a:w2#p"), entity_ref("urn:test:s25a:w2#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s25a:w2#p"), entity_ref("urn:test:s25a:w2#y2023"), 40000.00 USD) { origin case_input; }
    }
    // 20% of $10,000 (the $12,000 expense capped at $10,000) = $2,000.
    evaluate truth(education_credit(entity_ref("urn:test:s25a:w2#p"), entity_ref("urn:test:s25a:w2#y2023"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S25A-03-AOTC-MIDWAY-THROUGH-PHASEOUT-JOINT" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": meets_484a1_hea(entity_ref("urn:test:s25a:w3#student")) { origin case_input; }
        assert "f1": half_time_workload(entity_ref("urn:test:s25a:w3#student"), entity_ref("urn:test:s25a:w3#period")) { origin case_input; }
        assert "f2": aotc_election_in_effect(entity_ref("urn:test:s25a:w3#student"), entity_ref("urn:test:s25a:w3#p"), entity_ref("urn:test:s25a:w3#y2023")) { origin case_input; }
        assert "f3": aotc_prior_election_years_count(entity_ref("urn:test:s25a:w3#student"), entity_ref("urn:test:s25a:w3#y2023"), 0) { origin case_input; }
        assert "f4": qualified_tuition_and_related_expenses(entity_ref("urn:test:s25a:w3#p"), entity_ref("urn:test:s25a:w3#student"), AotcTuitionFeesCourseMaterials, 4000.00 USD) { origin case_input; }
        assert "f5": us.irc.income_individual::filing_status(entity_ref("urn:test:s25a:w3#p"), entity_ref("urn:test:s25a:w3#y2023"), us.irc.income_individual::Joint) { origin case_input; }
        // MAGI $170,000: halfway through the $160,000-$180,000 joint band.
        assert "f6": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s25a:w3#p"), entity_ref("urn:test:s25a:w3#y2023"), 170000.00 USD) { origin case_input; }
    }
    // Full AOTC $2,500, reduced by 50% -> $1,250.
    evaluate truth(education_credit(entity_ref("urn:test:s25a:w3#p"), entity_ref("urn:test:s25a:w3#y2023"), 1250.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S25A-04-REFUNDABLE-40-PERCENT-OF-AOTC" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": meets_484a1_hea(entity_ref("urn:test:s25a:w4#student")) { origin case_input; }
        assert "f1": half_time_workload(entity_ref("urn:test:s25a:w4#student"), entity_ref("urn:test:s25a:w4#period")) { origin case_input; }
        assert "f2": aotc_election_in_effect(entity_ref("urn:test:s25a:w4#student"), entity_ref("urn:test:s25a:w4#p"), entity_ref("urn:test:s25a:w4#y2023")) { origin case_input; }
        assert "f3": aotc_prior_election_years_count(entity_ref("urn:test:s25a:w4#student"), entity_ref("urn:test:s25a:w4#y2023"), 0) { origin case_input; }
        assert "f4": qualified_tuition_and_related_expenses(entity_ref("urn:test:s25a:w4#p"), entity_ref("urn:test:s25a:w4#student"), AotcTuitionFeesCourseMaterials, 4000.00 USD) { origin case_input; }
        assert "f5": us.irc.income_individual::filing_status(entity_ref("urn:test:s25a:w4#p"), entity_ref("urn:test:s25a:w4#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f6": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s25a:w4#p"), entity_ref("urn:test:s25a:w4#y2023"), 40000.00 USD) { origin case_input; }
    }
    // Full AOTC $2,500, 40 percent refundable = $1,000.
    evaluate truth(refundable_american_opportunity_credit(entity_ref("urn:test:s25a:w4#p"), entity_ref("urn:test:s25a:w4#y2023"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S25A-05-FOURTH-PRIOR-ELECTION-YEAR-BARS-AOTC" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": meets_484a1_hea(entity_ref("urn:test:s25a:w5#student")) { origin case_input; }
        assert "f1": half_time_workload(entity_ref("urn:test:s25a:w5#student"), entity_ref("urn:test:s25a:w5#period")) { origin case_input; }
        assert "f2": aotc_election_in_effect(entity_ref("urn:test:s25a:w5#student"), entity_ref("urn:test:s25a:w5#p"), entity_ref("urn:test:s25a:w5#y2023")) { origin case_input; }
        // 4 prior election years already used -> the AOTC test fails.
        assert "f3": aotc_prior_election_years_count(entity_ref("urn:test:s25a:w5#student"), entity_ref("urn:test:s25a:w5#y2023"), 4) { origin case_input; }
    }
    evaluate truth(aotc_eligible_for_student(entity_ref("urn:test:s25a:w5#student"), entity_ref("urn:test:s25a:w5#p"), entity_ref("urn:test:s25a:w5#y2023")));
    expect truth_status == NEITHER;
}

