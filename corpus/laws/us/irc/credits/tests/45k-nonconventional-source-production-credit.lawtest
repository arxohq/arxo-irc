// Section 45K scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45K-01-THREE-DOLLARS-TIMES-INFLATION-FACTOR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fuel_kind_45k(entity_ref("urn:test:45k:w1#pr"), OilFromShaleOrTarSands) { origin case_input; }
        assert "f1": boe_sold_to_unrelated_person_45k(entity_ref("urn:test:45k:w1#t"), entity_ref("urn:test:45k:w1#pr"), entity_ref("urn:test:45k:w1#y"), 100000.0) { origin case_input; }
        assert "f2": sale_date_45k(entity_ref("urn:test:45k:w1#pr"), entity_ref("urn:test:45k:w1#y"), @2000-06-01) { origin case_input; }
        assert "f3": well_drilled_on_45k(entity_ref("urn:test:45k:w1#pr"), @1985-01-01) { origin case_input; }
        assert "f4": production_within_united_states_45k(entity_ref("urn:test:45k:w1#pr")) { origin case_input; }
        assert "f5": reference_price_45k(entity_ref("urn:test:45k:w1#y"), 20.0) { origin case_input; }
        assert "f6": inflation_adjustment_factor_45k(entity_ref("urn:test:45k:w1#y"), 1.5) { origin case_input; }
    }
    //  x 1.5 = .50 x 100,000 BOE; reference price below the indexed .50.
    evaluate truth(nonconventional_source_credit_per_project_45k(entity_ref("urn:test:45k:w1#t"), entity_ref("urn:test:45k:w1#pr"), entity_ref("urn:test:45k:w1#y"), 450000.00 USD));
    expect truth_status == TRUE_ONLY;
}

