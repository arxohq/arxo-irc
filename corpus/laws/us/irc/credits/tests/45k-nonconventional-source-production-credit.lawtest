test "S45K-09-BIOMASS-FACILITY-WITH-BINDING-CONTRACT-SALES-THROUGH-2007" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fuel_kind_45k(entity_ref("urn:test:45k:w9#pr"), GasFromBiomass) { origin case_input; }
        assert "f1": facility_placed_in_service_on_45k(entity_ref("urn:test:45k:w9#pr"), @1996-06-01) { origin case_input; }
        assert "f2": binding_written_contract_before_1997_45k(entity_ref("urn:test:45k:w9#pr")) { origin case_input; }
        assert "f3": sale_date_45k(entity_ref("urn:test:45k:w9#pr"), entity_ref("urn:test:45k:w9#y"), @2006-06-01) { origin case_input; }
    }
    // (f)(1): placed in service before 1998-07-01 under a binding contract: sales before 2008-01-01.
    evaluate truth(eligible_sale_45k(entity_ref("urn:test:45k:w9#pr"), entity_ref("urn:test:45k:w9#y")));
    expect truth_status == TRUE_ONLY;
}

