test "S48A-08-DETERMINATION-NOT-ISSUED-IN-60-DAYS-VIOLATED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": certification_application_submitted_48a(entity_ref("urn:test:48a:w8#a"), entity_ref("urn:test:48a:w8#p"), @2010-01-01) { origin case_input; }
    }
    // Application on 2010-01-01; the reading date 2025-04-15 is far beyond day 60 and no determination is asserted.
    evaluate positions();
    expect position(Section48aD2CDeterminationDuty, VIOLATED);
}

