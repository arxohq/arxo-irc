// Section 48A scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S48A-01-IGCC-PROJECT-20-PERCENT-OF-QUALIFIED-INVESTMENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": advanced_coal_project_class_48a(entity_ref("urn:test:48a:w1#p"), IntegratedGasificationFirstRound) { origin case_input; }
        assert "f1": project_uses_advanced_coal_technology_48a(entity_ref("urn:test:48a:w1#p")) { origin case_input; }
        assert "f2": project_fuel_input_coal_percent_48a(entity_ref("urn:test:48a:w1#p"), 80.0) { origin case_input; }
        assert "f3": project_nameplate_capacity_mw_48a(entity_ref("urn:test:48a:w1#p"), 500.0) { origin case_input; }
        assert "f4": applicant_evidence_of_output_and_site_48a(entity_ref("urn:test:48a:w1#p")) { origin case_input; }
        assert "f5": project_located_in_united_states_48a(entity_ref("urn:test:48a:w1#p")) { origin case_input; }
        assert "f6": environmental_authorizations_received_48a(entity_ref("urn:test:48a:w1#p")) { origin case_input; }
        assert "f7": main_steam_turbine_contract_or_retrofit_48a(entity_ref("urn:test:48a:w1#p")) { origin case_input; }
        assert "f8": certification_program_total_48a(1000000000.00 USD) { origin case_input; }
        assert "f9": secretary_certifies_project_48a(entity_ref("urn:test:48a:w1#p"), entity_ref("urn:test:48a:w1#a"), @2010-01-01) { origin case_input; }
        assert "f10": qualified_investment_48a(entity_ref("urn:test:48a:w1#t"), entity_ref("urn:test:48a:w1#p"), entity_ref("urn:test:48a:w1#y"), 1000000.00 USD) { origin case_input; }
    }
    // 20% of 1,000,000 for a first-round integrated gasification project certified within the cap.
    evaluate truth(advanced_coal_project_credit_per_project_48a(entity_ref("urn:test:48a:w1#t"), entity_ref("urn:test:48a:w1#p"), entity_ref("urn:test:48a:w1#y"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

