        assert "f9": secretary_certifies_project_48a(entity_ref("urn:test:48a:w4#p"), entity_ref("urn:test:48a:w4#a"), @2010-01-01) { origin case_input; }
        assert "f10": qualified_investment_48a(entity_ref("urn:test:48a:w4#t"), entity_ref("urn:test:48a:w4#p"), entity_ref("urn:test:48a:w4#y"), 1000000.00 USD) { origin case_input; }
        assert "f11": project_sequestration_percent_48a(entity_ref("urn:test:48a:w4#p"), 64.0) { origin case_input; }
    }
    // 64% < 65%: the (e)(1)(G) requirement fails, no other rule derives the requirements.
