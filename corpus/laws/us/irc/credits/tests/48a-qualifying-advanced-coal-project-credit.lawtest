test "S48A-11-PROGRAM-NOT-ESTABLISHED-IN-180-DAYS-VIOLATED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": section_48a_enacted_on(@2005-08-08) { origin case_input; }
    }
    // Enactment 2005-08-08; 180 days ended 2006-02-04 and no program is asserted at the 2025 reading date.
    evaluate positions();
    expect position(Section48aD1ProgramDuty, VIOLATED);
}
