        assert "f5": project_located_in_united_states_48a(entity_ref("urn:test:48a:w4#p")) { origin case_input; }
        assert "f6": environmental_authorizations_received_48a(entity_ref("urn:test:48a:w4#p")) { origin case_input; }
        assert "f7": main_steam_turbine_contract_or_retrofit_48a(entity_ref("urn:test:48a:w4#p")) { origin case_input; }
