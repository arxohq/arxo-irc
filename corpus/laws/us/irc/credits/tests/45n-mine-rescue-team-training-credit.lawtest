// Section 45N scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45N-01-TWENTY-PERCENT-BELOW-CAP" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employs_underground_miners_in_united_states_45n(entity_ref("urn:test:45n:w1#t")) { origin case_input; }
        assert "f1": full_time_employee_45n(entity_ref("urn:test:45n:w1#m"), entity_ref("urn:test:45n:w1#t"), entity_ref("urn:test:45n:w1#y")) { origin case_input; }
        assert "f2": months_eligible_after_initial_course_45n(entity_ref("urn:test:45n:w1#m"), entity_ref("urn:test:45n:w1#y"), 8.0) { origin case_input; }
        assert "f3": training_program_costs_45n(entity_ref("urn:test:45n:w1#t"), entity_ref("urn:test:45n:w1#m"), entity_ref("urn:test:45n:w1#y"), 30000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45n:w1#y"), @2021-01-01) { origin case_input; }
    }
    // 20% of 30,000 = 6,000 < 10,000.
    evaluate truth(mine_rescue_team_training_credit(entity_ref("urn:test:45n:w1#t"), entity_ref("urn:test:45n:w1#y"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45N-02-CAP-10000-BINDS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employs_underground_miners_in_united_states_45n(entity_ref("urn:test:45n:w2#t")) { origin case_input; }
        assert "f1": full_time_employee_45n(entity_ref("urn:test:45n:w2#m"), entity_ref("urn:test:45n:w2#t"), entity_ref("urn:test:45n:w2#y")) { origin case_input; }
        assert "f2": months_eligible_after_initial_course_45n(entity_ref("urn:test:45n:w2#m"), entity_ref("urn:test:45n:w2#y"), 8.0) { origin case_input; }
        assert "f3": training_program_costs_45n(entity_ref("urn:test:45n:w2#t"), entity_ref("urn:test:45n:w2#m"), entity_ref("urn:test:45n:w2#y"), 80000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45n:w2#y"), @2021-01-01) { origin case_input; }
    }
    // 20% of 80,000 = 16,000, limited to 10,000.
    evaluate truth(mine_rescue_team_training_credit(entity_ref("urn:test:45n:w2#t"), entity_ref("urn:test:45n:w2#y"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45N-03-EXACTLY-SIX-MONTHS-NOT-QUALIFIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employs_underground_miners_in_united_states_45n(entity_ref("urn:test:45n:w3#t")) { origin case_input; }
        assert "f1": full_time_employee_45n(entity_ref("urn:test:45n:w3#m"), entity_ref("urn:test:45n:w3#t"), entity_ref("urn:test:45n:w3#y")) { origin case_input; }
        assert "f2": months_eligible_after_initial_course_45n(entity_ref("urn:test:45n:w3#m"), entity_ref("urn:test:45n:w3#y"), 6.0) { origin case_input; }
        assert "f3": training_program_costs_45n(entity_ref("urn:test:45n:w3#t"), entity_ref("urn:test:45n:w3#m"), entity_ref("urn:test:45n:w3#y"), 30000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45n:w3#y"), @2021-01-01) { origin case_input; }
    }
    // More than 6 months is required; exactly 6 is not more.
    evaluate truth(qualified_mine_rescue_team_employee_45n(entity_ref("urn:test:45n:w3#m"), entity_ref("urn:test:45n:w3#t"), entity_ref("urn:test:45n:w3#y")));
    expect truth_status == NEITHER;
}

test "S45N-04-YEAR-BEGINNING-AFTER-2021-NOT-APPLICABLE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employs_underground_miners_in_united_states_45n(entity_ref("urn:test:45n:w4#t")) { origin case_input; }
        assert "f1": full_time_employee_45n(entity_ref("urn:test:45n:w4#m"), entity_ref("urn:test:45n:w4#t"), entity_ref("urn:test:45n:w4#y")) { origin case_input; }
        assert "f2": months_eligible_after_initial_course_45n(entity_ref("urn:test:45n:w4#m"), entity_ref("urn:test:45n:w4#y"), 8.0) { origin case_input; }
        assert "f3": training_program_costs_45n(entity_ref("urn:test:45n:w4#t"), entity_ref("urn:test:45n:w4#m"), entity_ref("urn:test:45n:w4#y"), 30000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45n:w4#y"), @2022-01-01) { origin case_input; }
    }
    // (e): taxable years beginning after December 31, 2021 are outside the section.
    evaluate truth(section_45n_in_force_for_year(entity_ref("urn:test:45n:w4#y")));
    expect truth_status == NEITHER;
}

test "S45N-05-REFRESHER-ROUTE-QUALIFIES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employs_underground_miners_in_united_states_45n(entity_ref("urn:test:45n:w5#t")) { origin case_input; }
        assert "f1": full_time_employee_45n(entity_ref("urn:test:45n:w5#m"), entity_ref("urn:test:45n:w5#t"), entity_ref("urn:test:45n:w5#y")) { origin case_input; }
        assert "f2": months_eligible_after_refresher_45n(entity_ref("urn:test:45n:w5#m"), entity_ref("urn:test:45n:w5#y"), 7.0) { origin case_input; }
        assert "f3": training_program_costs_45n(entity_ref("urn:test:45n:w5#t"), entity_ref("urn:test:45n:w5#m"), entity_ref("urn:test:45n:w5#y"), 30000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45n:w5#y"), @2021-01-01) { origin case_input; }
    }
    // (b)(2): 40 hours refresher training, eligible for 7 months.
    evaluate truth(qualified_mine_rescue_team_employee_45n(entity_ref("urn:test:45n:w5#m"), entity_ref("urn:test:45n:w5#t"), entity_ref("urn:test:45n:w5#y")));
    expect truth_status == TRUE_ONLY;
}
