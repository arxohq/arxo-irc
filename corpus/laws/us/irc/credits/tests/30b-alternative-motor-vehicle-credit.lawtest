// Section 30B alternative motor vehicle credit scenarios (stage 2e). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S30B-01-2002-BASELINE-PASSENGER-CLASS-3000" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": vehicle_class_30b(entity_ref("urn:test:s30b:w1#v"), PassengerAutomobile) { origin case_input; }
        assert "f1": inertia_weight_class_lbs_30b(entity_ref("urn:test:s30b:w1#v"), 3000.0) { origin case_input; }
    }
    // (b)(2)(B)(i): passenger automobile, inertia weight class 3,000 lbs: 26.4 mpg.
    evaluate truth(baseline_city_economy_of_vehicle_30b(entity_ref("urn:test:s30b:w1#v"), 26.4));
    expect truth_status == TRUE_ONLY;
}

