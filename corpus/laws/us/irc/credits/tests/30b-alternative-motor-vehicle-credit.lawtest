        assert "f14": placed_in_service_by_30b(entity_ref("urn:test:s30b:w77#t"), entity_ref("urn:test:s30b:w77#v"), entity_ref("urn:test:s30b:w77#y")) { origin case_input; }
    }
    // (h)(4): the basis is reduced by the credit allowed.
    evaluate truth(basis_reduction_30b(entity_ref("urn:test:s30b:w77#t"), entity_ref("urn:test:s30b:w77#v"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S30B-78-DEDUCTION-OR-CREDIT-REDUCED-BY-THE-CREDIT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": vehicle_kind_30b(entity_ref("urn:test:s30b:w78#v"), FuelCell) { origin case_input; }
        assert "f1": vehicle_class_30b(entity_ref("urn:test:s30b:w78#v"), PassengerAutomobile) { origin case_input; }
        assert "f2": gross_vehicle_weight_rating_30b(entity_ref("urn:test:s30b:w78#v"), 4000.0) { origin case_input; }
        assert "f3": purchase_date_30b(entity_ref("urn:test:s30b:w78#v"), @2009-06-01) { origin case_input; }
        assert "f4": placed_in_service_date_30b(entity_ref("urn:test:s30b:w78#v"), @2009-06-15) { origin case_input; }
        assert "f5": original_use_commences_with_taxpayer_30b(entity_ref("urn:test:s30b:w78#t"), entity_ref("urn:test:s30b:w78#v")) { origin case_input; }
        assert "f6": acquired_for_use_or_lease_not_resale_30b(entity_ref("urn:test:s30b:w78#t"), entity_ref("urn:test:s30b:w78#v")) { origin case_input; }
        assert "f7": made_by_a_manufacturer_30b(entity_ref("urn:test:s30b:w78#v")) { origin case_input; }
        assert "f8": motor_vehicle_4_wheels_public_roads_30b(entity_ref("urn:test:s30b:w78#v")) { origin case_input; }
        assert "f9": complies_with_clean_air_act_and_motor_vehicle_safety_30b(entity_ref("urn:test:s30b:w78#v")) { origin case_input; }
        assert "f10": propelled_by_hydrogen_fuel_cells_30b(entity_ref("urn:test:s30b:w78#v")) { origin case_input; }
        assert "f11": certified_bin_5_tier_ii_30b(entity_ref("urn:test:s30b:w78#v")) { origin case_input; }
        assert "f12": city_fuel_economy_mpg_30b(entity_ref("urn:test:s30b:w78#v"), 35.0) { origin case_input; }
        assert "f13": inertia_weight_class_lbs_30b(entity_ref("urn:test:s30b:w78#v"), 3000.0) { origin case_input; }
        assert "f14": placed_in_service_by_30b(entity_ref("urn:test:s30b:w78#t"), entity_ref("urn:test:s30b:w78#v"), entity_ref("urn:test:s30b:w78#y")) { origin case_input; }
        assert "f15": deduction_or_credit_before_h5_30b(entity_ref("urn:test:s30b:w78#t"), entity_ref("urn:test:s30b:w78#v"), entity_ref("urn:test:s30b:w78#y"), 10000.00 USD) { origin case_input; }
    }
    // (h)(5)(B): a deduction of 10,000 for the vehicle is reduced by the 8,000 credit.
    evaluate truth(deduction_or_credit_after_h5_30b(entity_ref("urn:test:s30b:w78#t"), entity_ref("urn:test:s30b:w78#v"), entity_ref("urn:test:s30b:w78#y"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
}

