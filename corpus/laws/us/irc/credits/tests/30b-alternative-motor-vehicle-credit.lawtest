test "S30B-14-COMMON-REQUIREMENTS-MET" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": vehicle_kind_30b(entity_ref("urn:test:s30b:w14#v"), FuelCell) { origin case_input; }
        assert "f1": vehicle_class_30b(entity_ref("urn:test:s30b:w14#v"), PassengerAutomobile) { origin case_input; }
        assert "f2": gross_vehicle_weight_rating_30b(entity_ref("urn:test:s30b:w14#v"), 4000.0) { origin case_input; }
        assert "f3": purchase_date_30b(entity_ref("urn:test:s30b:w14#v"), @2009-06-01) { origin case_input; }
        assert "f4": placed_in_service_date_30b(entity_ref("urn:test:s30b:w14#v"), @2009-06-15) { origin case_input; }
        assert "f5": original_use_commences_with_taxpayer_30b(entity_ref("urn:test:s30b:w14#t"), entity_ref("urn:test:s30b:w14#v")) { origin case_input; }
        assert "f6": acquired_for_use_or_lease_not_resale_30b(entity_ref("urn:test:s30b:w14#t"), entity_ref("urn:test:s30b:w14#v")) { origin case_input; }
        assert "f7": made_by_a_manufacturer_30b(entity_ref("urn:test:s30b:w14#v")) { origin case_input; }
        assert "f8": motor_vehicle_4_wheels_public_roads_30b(entity_ref("urn:test:s30b:w14#v")) { origin case_input; }
        assert "f9": complies_with_clean_air_act_and_motor_vehicle_safety_30b(entity_ref("urn:test:s30b:w14#v")) { origin case_input; }
    }
    // (h)(1), (h)(10), (b)-(e): original use, acquired for use, manufacturer, motor vehicle, compliance, within the termination date.
    evaluate truth(common_requirements_met_30b(entity_ref("urn:test:s30b:w14#t"), entity_ref("urn:test:s30b:w14#v")));
    expect truth_status == TRUE_ONLY;
}

