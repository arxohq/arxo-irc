            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": basis_before_reduction_45f(entity_ref("urn:test:s45fd:w21#t"), entity_ref("urn:test:s45fd:w21#pr"), 10000.00 USD) { origin case_input; }
        assert "f1": credit_for_property_expenditure_45f(entity_ref("urn:test:s45fd:w21#t"), entity_ref("urn:test:s45fd:w21#pr"), 20000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_after_credit_45f(entity_ref("urn:test:s45fd:w21#t"), entity_ref("urn:test:s45fd:w21#pr"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45FD-22-BASIS-INCREASED-BY-RECAPTURE-AMOUNT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": basis_immediately_before_recapture_event_45f(entity_ref("urn:test:s45fd:w22#t"), entity_ref("urn:test:s45fd:w22#pr"), 70000.00 USD) { origin case_input; }
        assert "f1": recapture_amount_45f(entity_ref("urn:test:s45fd:w22#t"), entity_ref("urn:test:s45fd:w22#pr"), 6000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_increased_for_recapture_45f(entity_ref("urn:test:s45fd:w22#t"), entity_ref("urn:test:s45fd:w22#pr"), 76000.00 USD));
    expect truth_status == TRUE_ONLY;
}
