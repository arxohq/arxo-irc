// Section 45F definitions, recapture and basis rule scenarios (stage 2f).
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45FD-01-PROPERTY-EXPENDITURE-QUALIFIED" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": principal_use_child_care_assistance_45f(entity_ref("urn:test:s45fd:w1#f")) { origin case_input; }
        assert "f1": meets_local_law_and_licensing_45f(entity_ref("urn:test:s45fd:w1#f")) { origin case_input; }
        assert "f2": enrollment_open_to_employees_45f(entity_ref("urn:test:s45fd:w1#f"), entity_ref("urn:test:s45fd:w1#t"), entity_ref("urn:test:s45fd:w1#y")) { origin case_input; }
        assert "f3": property_expenditure_45f(entity_ref("urn:test:s45fd:w1#t"), entity_ref("urn:test:s45fd:w1#pr"), entity_ref("urn:test:s45fd:w1#y"), 90000.00 USD) { origin case_input; }
        assert "f4": property_to_be_used_in_taxpayer_facility_45f(entity_ref("urn:test:s45fd:w1#pr"), entity_ref("urn:test:s45fd:w1#f")) { origin case_input; }
        assert "f5": property_depreciable_45f(entity_ref("urn:test:s45fd:w1#pr")) { origin case_input; }
    }
    evaluate truth(property_expenditure_qualified_45f(entity_ref("urn:test:s45fd:w1#t"), entity_ref("urn:test:s45fd:w1#pr"), entity_ref("urn:test:s45fd:w1#y"), 90000.00 USD));
    expect truth_status == TRUE_ONLY;
}

