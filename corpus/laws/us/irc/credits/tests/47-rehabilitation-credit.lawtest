// Section 47 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S47-01-QUALIFIED-REHABILITATED-BUILDING-RATABLE-SHARE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": placed_in_service_before_rehabilitation(entity_ref("urn:test:s47:w1#b")) { origin case_input; }
        assert "f2": certified_historic_structure(entity_ref("urn:test:s47:w1#b")) { origin case_input; }
        assert "f3": depreciation_allowable(entity_ref("urn:test:s47:w1#b")) { origin case_input; }
        assert "f4": aggregate_rehabilitation_expenditures_24_month_period(entity_ref("urn:test:s47:w1#b"), 200000.00 USD) { origin case_input; }
        assert "f5": adjusted_basis_at_start_of_measurement_period(entity_ref("urn:test:s47:w1#b"), 100000.00 USD) { origin case_input; }
        assert "f6": qualified_rehabilitation_expenditure_candidate(entity_ref("urn:test:s47:w1#b"), 200000.00 USD) { origin case_input; }
        assert "f7": within_5_year_ratable_period(entity_ref("urn:test:s47:w1#b"), entity_ref("urn:test:s47:w1#p"), entity_ref("urn:test:s47:w1#y1")) { origin case_input; }
    }
    // 20% * 200000 = 40000, ratably over 5 years: 40000 / 5 = 8000.
    evaluate truth(rehabilitation_credit_ratable_share(entity_ref("urn:test:s47:w1#b"), entity_ref("urn:test:s47:w1#p"), entity_ref("urn:test:s47:w1#y1"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S47-02-NOT-SUBSTANTIALLY-REHABILITATED-BELOW-GREATER-OF-BASIS-OR-5000" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": aggregate_rehabilitation_expenditures_24_month_period(entity_ref("urn:test:s47:w2#b"), 30000.00 USD) { origin case_input; }
        assert "f2": adjusted_basis_at_start_of_measurement_period(entity_ref("urn:test:s47:w2#b"), 100000.00 USD) { origin case_input; }
    }
    // Expenditures ($30,000) do not exceed the greater of basis ($100,000) or $5,000.
    evaluate truth(substantially_rehabilitated(entity_ref("urn:test:s47:w2#b")));
    expect truth_status == NEITHER;
}
