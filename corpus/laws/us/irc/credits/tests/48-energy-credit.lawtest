        assert "f2": energy_property_construction_begin_date(entity_ref("urn:test:s48:w2#p"), @2025-03-01) { origin case_input; }
    }
    evaluate truth(base_energy_percentage_48(entity_ref("urn:test:s48:w2#p"), 0.02));
    expect truth_status == TRUE_ONLY;
}

