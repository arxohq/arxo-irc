test "S48-05-FIVE-TIMES-MULTIPLIER-WITH-DOMESTIC-CONTENT-AND-ENERGY-COMMUNITY-BONUS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": energy_property_basis(entity_ref("urn:test:s48:w5#t"), entity_ref("urn:test:s48:w5#p"), entity_ref("urn:test:s48:w5#y1"), QualifiedFuelCellProperty, 100000.00 USD) { origin case_input; }
        assert "f2": prevailing_wage_requirement_satisfied_48(entity_ref("urn:test:s48:w5#p"), entity_ref("urn:test:s48:w5#y1")) { origin case_input; }
        assert "f3": apprenticeship_requirement_satisfied_48(entity_ref("urn:test:s48:w5#p"), entity_ref("urn:test:s48:w5#y1")) { origin case_input; }
        assert "f4": domestic_content_requirement_satisfied_48(entity_ref("urn:test:s48:w5#p")) { origin case_input; }
        assert "f5": energy_community_project_48(entity_ref("urn:test:s48:w5#p")) { origin case_input; }
    }
    // base 6% * 5 = 30%; +10 points (domestic content, 9B met) +10 points (energy community, 9B met) = 50%.
    // 50% * 100,000 = 50,000.
    evaluate truth(energy_credit_amount_per_property(entity_ref("urn:test:s48:w5#t"), entity_ref("urn:test:s48:w5#p"), entity_ref("urn:test:s48:w5#y1"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S48-06-BASE-RATE-NO-BONUSES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": energy_property_basis(entity_ref("urn:test:s48:w6#t"), entity_ref("urn:test:s48:w6#p"), entity_ref("urn:test:s48:w6#y1"), QualifiedFuelCellProperty, 100000.00 USD) { origin case_input; }
    }
    // 6% * 100,000 = 6,000; no 9(B) requirements met, no bonuses.
    evaluate truth(energy_credit_amount_per_property(entity_ref("urn:test:s48:w6#t"), entity_ref("urn:test:s48:w6#p"), entity_ref("urn:test:s48:w6#y1"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}
