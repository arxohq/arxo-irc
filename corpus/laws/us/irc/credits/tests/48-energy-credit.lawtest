// Section 48 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S48-01-FUEL-CELL-ALWAYS-SIX-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": energy_property_basis(entity_ref("urn:test:s48:w1#t"), entity_ref("urn:test:s48:w1#p"), entity_ref("urn:test:s48:w1#y1"), QualifiedFuelCellProperty, 100000.00 USD) { origin case_input; }
    }
    evaluate truth(base_energy_percentage_48(entity_ref("urn:test:s48:w1#p"), 0.06));
    expect truth_status == TRUE_ONLY;
}

test "S48-02-SOLAR-ELECTRIC-DROPS-TO-2-PERCENT-AFTER-2024-CONSTRUCTION" {
    given {
        context {
