// Section 48D scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S48D-01-PLACED-IN-SERVICE-2025-25-PERCENT" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": facility_primary_purpose_semiconductor_manufacturing_48d(entity_ref("urn:test:48d:w1#f")) { origin case_input; }
        assert "f1": tangible_property_48d(entity_ref("urn:test:48d:w1#q")) { origin case_input; }
        assert "f2": depreciation_allowable_48d(entity_ref("urn:test:48d:w1#q")) { origin case_input; }
        assert "f3": constructed_or_originally_used_by_taxpayer_48d(entity_ref("urn:test:48d:w1#q"), entity_ref("urn:test:48d:w1#t")) { origin case_input; }
        assert "f4": integral_to_operation_of_facility_48d(entity_ref("urn:test:48d:w1#q"), entity_ref("urn:test:48d:w1#f")) { origin case_input; }
        assert "f5": qualified_property_basis_48d(entity_ref("urn:test:48d:w1#t"), entity_ref("urn:test:48d:w1#f"), entity_ref("urn:test:48d:w1#q"), entity_ref("urn:test:48d:w1#y"), 10000000.00 USD) { origin case_input; }
        assert "f6": property_placed_in_service_date_48d(entity_ref("urn:test:48d:w1#q"), @2025-06-01) { origin case_input; }
        assert "f7": property_construction_begin_date_48d(entity_ref("urn:test:48d:w1#q"), @2024-01-01) { origin case_input; }
    }
    // 25% of 10,000,000 for property placed in service before 2026.
    evaluate truth(advanced_manufacturing_credit_of_property_48d(entity_ref("urn:test:48d:w1#t"), entity_ref("urn:test:48d:w1#q"), entity_ref("urn:test:48d:w1#y"), 2500000.00 USD));
    expect truth_status == TRUE_ONLY;
}

