            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": excessive_payment_determination_48d(entity_ref("urn:test:48d:w11#t"), entity_ref("urn:test:48d:w11#y2"), 100000.00 USD, 60000.00 USD) { origin case_input; }
    }
    // excess 40,000 + 20% of it (8,000) = 48,000.
    evaluate truth(excessive_payment_tax_increase_48d(entity_ref("urn:test:48d:w11#t"), entity_ref("urn:test:48d:w11#y2"), 48000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S48D-12-EXCESSIVE-PAYMENT-REASONABLE-CAUSE-NO-20-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": excessive_payment_determination_48d(entity_ref("urn:test:48d:w12#t"), entity_ref("urn:test:48d:w12#y2"), 100000.00 USD, 60000.00 USD) { origin case_input; }
        assert "f1": reasonable_cause_for_excessive_payment_48d(entity_ref("urn:test:48d:w12#t"), entity_ref("urn:test:48d:w12#y2")) { origin case_input; }
    }
    // (F)(ii): with reasonable cause only the excessive payment itself is added.
    evaluate truth(excessive_payment_tax_increase_48d(entity_ref("urn:test:48d:w12#t"), entity_ref("urn:test:48d:w12#y2"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S48D-13-READ-BEFORE-AMENDMENT-2026-PROPERTY-STILL-25-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": facility_primary_purpose_semiconductor_manufacturing_48d(entity_ref("urn:test:48d:w13#f")) { origin case_input; }
        assert "f1": tangible_property_48d(entity_ref("urn:test:48d:w13#q")) { origin case_input; }
        assert "f2": depreciation_allowable_48d(entity_ref("urn:test:48d:w13#q")) { origin case_input; }
        assert "f3": constructed_or_originally_used_by_taxpayer_48d(entity_ref("urn:test:48d:w13#q"), entity_ref("urn:test:48d:w13#t")) { origin case_input; }
        assert "f4": integral_to_operation_of_facility_48d(entity_ref("urn:test:48d:w13#q"), entity_ref("urn:test:48d:w13#f")) { origin case_input; }
        assert "f5": qualified_property_basis_48d(entity_ref("urn:test:48d:w13#t"), entity_ref("urn:test:48d:w13#f"), entity_ref("urn:test:48d:w13#q"), entity_ref("urn:test:48d:w13#y"), 10000000.00 USD) { origin case_input; }
        assert "f6": property_placed_in_service_date_48d(entity_ref("urn:test:48d:w13#q"), @2026-03-01) { origin case_input; }
        assert "f7": property_construction_begin_date_48d(entity_ref("urn:test:48d:w13#q"), @2024-01-01) { origin case_input; }
    }
    // Read at legal time 2025-04-15, before PL 119-21 (2025-07-04): the 25 percent text applies to 2026 property too.
    evaluate truth(advanced_manufacturing_credit_of_property_48d(entity_ref("urn:test:48d:w13#t"), entity_ref("urn:test:48d:w13#q"), entity_ref("urn:test:48d:w13#y"), 2500000.00 USD));
    expect truth_status == TRUE_ONLY;
}
