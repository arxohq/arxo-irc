            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": equity_form_45d(entity_ref("urn:test:s45dd:w1#inv"), CorporateStock) { origin case_input; }
        assert "f1": entity_is_corporation_45d(entity_ref("urn:test:s45dd:w1#inv")) { origin case_input; }
    }
    evaluate truth(equity_investment_45d(entity_ref("urn:test:s45dd:w1#inv")));
