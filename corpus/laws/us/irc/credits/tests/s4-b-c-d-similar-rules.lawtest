        }
        assert "f0": married_at_close_of_year_35(entity_ref("urn:test:c35:t4#t"), entity_ref("urn:test:c35:t4#y")) { origin case_input; }
        assert "f1": files_separate_return_35(entity_ref("urn:test:c35:t4#t"), entity_ref("urn:test:c35:t4#y")) { origin case_input; }
        assert "f2": maintains_household_for_qualifying_family_member_more_than_half_year_35g6(entity_ref("urn:test:c35:t4#t"), entity_ref("urn:test:c35:t4#y")) { origin case_input; }
        assert "f3": spouse_not_member_of_household_last_six_months_35g6(entity_ref("urn:test:c35:t4#t"), entity_ref("urn:test:c35:t4#y")) { origin case_input; }
    }
    evaluate truth(not_considered_married_35g6(entity_ref("urn:test:c35:t4#t"), entity_ref("urn:test:c35:t4#y")));
    expect truth_status == NEITHER;
}

test "S25CF1-01-TENANT-STOCKHOLDER-SHARE-OF-25C-EXPENDITURES" {
    // Rule similar to section 25D(e)(5): 20 percent of 10000.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tenant_stockholder_proportionate_share_25d(entity_ref("urn:test:c25c:t1#i"), entity_ref("urn:test:c25c:t1#c"), 0.2) { origin case_input; }
        assert "f1": cooperative_expenditure_25c(entity_ref("urn:test:c25c:t1#c"), entity_ref("urn:test:c25c:t1#y"), WindowsAndSkylights25c, 10000 USD) { origin case_input; }
    }
    evaluate truth(expenditure_treated_as_made_by_tenant_stockholder_25c(entity_ref("urn:test:c25c:t1#i"), entity_ref("urn:test:c25c:t1#c"), entity_ref("urn:test:c25c:t1#y"), WindowsAndSkylights25c, 2000 USD));
    expect truth_status == TRUE_ONLY;
}

