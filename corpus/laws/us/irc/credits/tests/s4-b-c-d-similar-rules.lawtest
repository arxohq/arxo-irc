test "S43C3-01-COSTS-REDUCED-BY-NONQUALIFIED-FINANCING" {
    // Rule similar to section 49(a)(1).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_enhanced_oil_recovery_costs(entity_ref("urn:test:c43:t1#t"), entity_ref("urn:test:c43:t1#y"), 100000 USD) { origin case_input; }
        assert "f1": eor_project_of_costs_43(entity_ref("urn:test:c43:t1#t"), entity_ref("urn:test:c43:t1#y"), entity_ref("urn:test:c43:t1#p")) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:c43:t1#t"), entity_ref("urn:test:c43:t1#p")) { origin case_input; }
        assert "f3": nonqualified_nonrecourse_financing_49(entity_ref("urn:test:c43:t1#p"), 20000 USD) { origin case_input; }
    }
    evaluate truth(eor_costs_after_at_risk_reduction_43c3(entity_ref("urn:test:c43:t1#t"), entity_ref("urn:test:c43:t1#y"), 80000 USD));
    expect truth_status == TRUE_ONLY;
}

