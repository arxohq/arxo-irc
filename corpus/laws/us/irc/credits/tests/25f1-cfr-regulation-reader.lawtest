// Section 25(f)(1) regulation reader (IRC-G/G4, CFR wiring 27.09.2026).
// Вывод / нет факта источника: a procedurally compliant program that fails
// (d)(2) is treated as satisfied with a State-ceiling reduction (TRUE_ONLY);
// without the regulation-content facts nothing derives (NEITHER). No amounts
// are computed (program administration). Expectations from the statutory text.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S25-CFR-01-VOLUME-FAILURE-TREATED-SATISFIED" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f1": mcc_program_satisfies_secretary_volume_procedures_25f1(entity_ref("urn:test:s25cfr:1#prog"), entity_ref("urn:test:s25cfr:1#y")) { origin case_input; }
        assert "f2": mcc_program_fails_d2_aggregate_requirements_25f1(entity_ref("urn:test:s25cfr:1#prog"), entity_ref("urn:test:s25cfr:1#y")) { origin case_input; }
    }
    evaluate truth(mcc_program_requirements_treated_satisfied_with_ceiling_reduction_25f1(entity_ref("urn:test:s25cfr:1#prog"), entity_ref("urn:test:s25cfr:1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S25-CFR-02-PROCEDURALLY-NONCOMPLIANT-NEITHER" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f2": mcc_program_fails_d2_aggregate_requirements_25f1(entity_ref("urn:test:s25cfr:2#prog"), entity_ref("urn:test:s25cfr:2#y")) { origin case_input; }
    }
    // the (d)(2) failure alone, without the Secretary-procedure compliance, triggers nothing.
    evaluate truth(mcc_program_requirements_treated_satisfied_with_ceiling_reduction_25f1(entity_ref("urn:test:s25cfr:2#prog"), entity_ref("urn:test:s25cfr:2#y")));
    expect truth_status == NEITHER;
}
