// Section 41 regulation-reader scenarios (IRC-G/G4, CFR wiring 27.09.2026).
// Вывод / нет факта источника: with the regulation content as applied the
// subsection consequence derives (TRUE_ONLY); without it nothing derives
// (NEITHER). The (d)(1) four-part test is EVALUATIVE (DECISION-0194) and is
// NOT wired into any aggregate. Existing QRE/basic-research/consortium
// aggregate paths are untouched. Expectations from the statutory text.
// NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S41-CFR-01-B1-COMPONENTS-DERIVE" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f1": rd_qre_sum_components_as_applied_41b1(entity_ref("urn:test:s41cfr:1#p"), entity_ref("urn:test:s41cfr:1#y1")) { origin case_input; }
    }
    evaluate truth(rd_qre_sum_recognized_41b1(entity_ref("urn:test:s41cfr:1#p"), entity_ref("urn:test:s41cfr:1#y1")));
    expect truth_status == TRUE_ONLY;
    description "section 41(b)(1): the applied in-house and contract components sum to qualified research expenses";
}

test "S41-CFR-02-B1-WITHOUT-COMPONENTS-NEITHER" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
