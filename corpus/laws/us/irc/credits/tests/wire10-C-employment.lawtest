// Credits WIRE-10 (group C): section 45P differential wage payments from employment.
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "W10C-CRE-08-DIFFERENTIAL-PAYMENTS-OF-THE-YEAR-ARE-SUMMED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.employment::wage_payment(entity_ref("urn:test:w10c:d1#p1"), entity_ref("urn:test:w10c:d1#er"), entity_ref("urn:test:w10c:d1#ee"), entity_ref("urn:test:w10c:d1#y"), 1000.00 USD, @2025-03-31) { origin case_input; }
        assert "f1": us.irc.employment::differential_wage_payment(entity_ref("urn:test:w10c:d1#p1")) { origin case_input; }
        assert "f2": us.irc.employment::wage_payment(entity_ref("urn:test:w10c:d1#p2"), entity_ref("urn:test:w10c:d1#er"), entity_ref("urn:test:w10c:d1#ee"), entity_ref("urn:test:w10c:d1#y"), 500.00 USD, @2025-03-31) { origin case_input; }
        assert "f3": us.irc.employment::differential_wage_payment(entity_ref("urn:test:w10c:d1#p2")) { origin case_input; }
    }
    evaluate truth(differential_wage_payments_45p(entity_ref("urn:test:w10c:d1#er"), entity_ref("urn:test:w10c:d1#ee"), entity_ref("urn:test:w10c:d1#y"), 1500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10C-CRE-09-ORDINARY-WAGE-PAYMENT-IS-NOT-A-DIFFERENTIAL-PAYMENT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.employment::wage_payment(entity_ref("urn:test:w10c:d2#p1"), entity_ref("urn:test:w10c:d2#er"), entity_ref("urn:test:w10c:d2#ee"), entity_ref("urn:test:w10c:d2#y"), 1000.00 USD, @2025-03-31) { origin case_input; }
        assert "f1": us.irc.employment::differential_wage_payment(entity_ref("urn:test:w10c:d2#p1")) { origin case_input; }
        assert "f2": us.irc.employment::wage_payment(entity_ref("urn:test:w10c:d2#p2"), entity_ref("urn:test:w10c:d2#er"), entity_ref("urn:test:w10c:d2#ee"), entity_ref("urn:test:w10c:d2#y"), 9000.00 USD, @2025-03-31) { origin case_input; }
    }
    evaluate truth(differential_wage_payments_45p(entity_ref("urn:test:w10c:d2#er"), entity_ref("urn:test:w10c:d2#ee"), entity_ref("urn:test:w10c:d2#y"), 10000.00 USD));
    expect truth_status == FALSE_ONLY;
}

test "W10C-CRE-10-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": differential_wage_payments_45p(entity_ref("urn:test:w10c:d3#er"), entity_ref("urn:test:w10c:d3#ee"), entity_ref("urn:test:w10c:d3#y"), 800.00 USD) { origin case_input; }
    }
    evaluate truth(differential_wage_payments_45p(entity_ref("urn:test:w10c:d3#er"), entity_ref("urn:test:w10c:d3#ee"), entity_ref("urn:test:w10c:d3#y"), 800.00 USD));
    expect truth_status == TRUE_ONLY;
}
