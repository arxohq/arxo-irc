// Section 45P scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45P-01-TWENTY-PERCENT-OF-ELIGIBLE-PAYMENTS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": differential_wage_payments_45p(entity_ref("urn:test:45p:w1#t"), entity_ref("urn:test:45p:w1#e"), entity_ref("urn:test:45p:w1#y"), 15000.00 USD) { origin case_input; }
        assert "f1": days_employed_before_differential_period_45p(entity_ref("urn:test:45p:w1#t"), entity_ref("urn:test:45p:w1#e"), entity_ref("urn:test:45p:w1#y"), 120.0) { origin case_input; }
    }
    // 20% of 15,000 = 3,000.
    evaluate truth(differential_wage_payment_credit(entity_ref("urn:test:45p:w1#t"), entity_ref("urn:test:45p:w1#y"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45P-02-PER-EMPLOYEE-PAYMENTS-CAPPED-AT-20000" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": differential_wage_payments_45p(entity_ref("urn:test:45p:w2#t"), entity_ref("urn:test:45p:w2#e"), entity_ref("urn:test:45p:w2#y"), 35000.00 USD) { origin case_input; }
        assert "f1": days_employed_before_differential_period_45p(entity_ref("urn:test:45p:w2#t"), entity_ref("urn:test:45p:w2#e"), entity_ref("urn:test:45p:w2#y"), 120.0) { origin case_input; }
    }
    // Eligible payments are capped at 20,000; 20% = 4,000.
    evaluate truth(differential_wage_payment_credit(entity_ref("urn:test:45p:w2#t"), entity_ref("urn:test:45p:w2#y"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45P-03-NINETY-DAYS-NOT-QUALIFIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": differential_wage_payments_45p(entity_ref("urn:test:45p:w3#t"), entity_ref("urn:test:45p:w3#e"), entity_ref("urn:test:45p:w3#y"), 15000.00 USD) { origin case_input; }
        assert "f1": days_employed_before_differential_period_45p(entity_ref("urn:test:45p:w3#t"), entity_ref("urn:test:45p:w3#e"), entity_ref("urn:test:45p:w3#y"), 90.0) { origin case_input; }
    }
    // The 91-day employment period is not met with 90 days.
    evaluate truth(qualified_employee_45p(entity_ref("urn:test:45p:w3#t"), entity_ref("urn:test:45p:w3#e"), entity_ref("urn:test:45p:w3#y")));
    expect truth_status == NEITHER;
}

test "S45P-04-ORDER-YEAR-DISALLOWS-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": differential_wage_payments_45p(entity_ref("urn:test:45p:w4#t"), entity_ref("urn:test:45p:w4#e"), entity_ref("urn:test:45p:w4#y"), 15000.00 USD) { origin case_input; }
        assert "f1": days_employed_before_differential_period_45p(entity_ref("urn:test:45p:w4#t"), entity_ref("urn:test:45p:w4#e"), entity_ref("urn:test:45p:w4#y"), 120.0) { origin case_input; }
        assert "f2": final_order_under_38_usc_4323_45p(entity_ref("urn:test:45p:w4#t"), entity_ref("urn:test:45p:w4#y")) { origin case_input; }
    }
    // (d)(1): the year in which the taxpayer is under the final order.
    evaluate truth(section_45p_disallowed_for_year(entity_ref("urn:test:45p:w4#t"), entity_ref("urn:test:45p:w4#y")));
    expect truth_status == TRUE_ONLY;
}

test "S45P-05-SECOND-SUCCEEDING-YEAR-DISALLOWED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": final_order_under_38_usc_4323_45p(entity_ref("urn:test:45p:w5#t"), entity_ref("urn:test:45p:w5#y0")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:45p:w5#y0"), @2023-01-01) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:45p:w5#y2"), @2025-01-01) { origin case_input; }
    }
    // (d)(2): 2025 is the second year after the 2023 order year.
    evaluate truth(section_45p_disallowed_for_year(entity_ref("urn:test:45p:w5#t"), entity_ref("urn:test:45p:w5#y2")));
    expect truth_status == TRUE_ONLY;
}

test "S45P-06-THIRD-YEAR-AFTER-ORDER-NOT-DISALLOWED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": final_order_under_38_usc_4323_45p(entity_ref("urn:test:45p:w6#t"), entity_ref("urn:test:45p:w6#y0")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:45p:w6#y0"), @2023-01-01) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:45p:w6#y3"), @2026-01-01) { origin case_input; }
    }
    // 2026 is the third year after the order year: outside the 2 succeeding years.
    evaluate truth(section_45p_disallowed_for_year(entity_ref("urn:test:45p:w6#t"), entity_ref("urn:test:45p:w6#y3")));
    expect truth_status == NEITHER;
}
