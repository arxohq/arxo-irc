// Section 24 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

// --- TCJA window (2018-2025): 1 child, below threshold -------------------------
test "S24-01-TCJA-ONE-CHILD-BELOW-THRESHOLD" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w1#child"), entity_ref("urn:test:s24:w1#p"), entity_ref("urn:test:s24:w1#y2023")) { origin case_input; }
        assert "f1": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w1#child"), entity_ref("urn:test:s24:w1#p"), entity_ref("urn:test:s24:w1#y2023")) { origin case_input; }
        assert "f2": under_age_17(entity_ref("urn:test:s24:w1#child"), entity_ref("urn:test:s24:w1#y2023")) { origin case_input; }
        assert "f3": ssn_included_24h7(entity_ref("urn:test:s24:w1#p"), entity_ref("urn:test:s24:w1#child"), entity_ref("urn:test:s24:w1#y2023")) { origin case_input; }
        assert "f4": us.irc.income_individual::filing_status(entity_ref("urn:test:s24:w1#p"), entity_ref("urn:test:s24:w1#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f5": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s24:w1#p"), entity_ref("urn:test:s24:w1#y2023"), 50000.00 USD) { origin case_input; }
    }
    // $2,000, AGI $50,000 < $200,000 threshold: no phase-out, no ODC.
    evaluate truth(child_tax_credit(entity_ref("urn:test:s24:w1#p"), entity_ref("urn:test:s24:w1#y2023"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- TCJA window: 2 children + 1 other dependent (ODC), MFS threshold ---------
test "S24-02-TCJA-TWO-CHILDREN-PLUS-ODC-MFS" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w2#c1"), entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f1": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w2#c1"), entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f2": under_age_17(entity_ref("urn:test:s24:w2#c1"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f3": ssn_included_24h7(entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#c1"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f4": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w2#c2"), entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f5": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w2#c2"), entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f6": under_age_17(entity_ref("urn:test:s24:w2#c2"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f7": ssn_included_24h7(entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#c2"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f8": other_dependent_24h4(entity_ref("urn:test:s24:w2#parent"), entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023")) { origin case_input; }
        assert "f9": us.irc.income_individual::filing_status(entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023"), us.irc.income_individual::MarriedSeparate) { origin case_input; }
        assert "f10": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023"), 50000.00 USD) { origin case_input; }
    }
    // 2 * $2,000 + 1 * $500 = $4,500; AGI below $200,000 MFS threshold.
    evaluate truth(child_tax_credit(entity_ref("urn:test:s24:w2#p"), entity_ref("urn:test:s24:w2#y2023"), 4500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- TCJA window: 3 children, AGI just above joint threshold, phase-out -------
test "S24-03-TCJA-THREE-CHILDREN-ABOVE-JOINT-THRESHOLD" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w3#c1"), entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f1": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w3#c1"), entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f2": under_age_17(entity_ref("urn:test:s24:w3#c1"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f3": ssn_included_24h7(entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#c1"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f4": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w3#c2"), entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f5": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w3#c2"), entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f6": under_age_17(entity_ref("urn:test:s24:w3#c2"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f7": ssn_included_24h7(entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#c2"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f8": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w3#c3"), entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f9": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w3#c3"), entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f10": under_age_17(entity_ref("urn:test:s24:w3#c3"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f11": ssn_included_24h7(entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#c3"), entity_ref("urn:test:s24:w3#y2023")) { origin case_input; }
        assert "f12": us.irc.income_individual::filing_status(entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023"), us.irc.income_individual::Joint) { origin case_input; }
        // AGI $401,000: $1,000 over the $400,000 threshold -> 1 step of $50.
        assert "f13": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023"), 401000.00 USD) { origin case_input; }
    }
    // 3 * $2,000 = $6,000, minus $50 = $5,950.
    evaluate truth(child_tax_credit(entity_ref("urn:test:s24:w3#p"), entity_ref("urn:test:s24:w3#y2023"), 5950.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- SSN missing: child does not count toward the TCJA dollar amount ----------
test "S24-04-TCJA-SSN-MISSING-CHILD-NOT-COUNTABLE" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w4#child"), entity_ref("urn:test:s24:w4#p"), entity_ref("urn:test:s24:w4#y2023")) { origin case_input; }
        assert "f1": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w4#child"), entity_ref("urn:test:s24:w4#p"), entity_ref("urn:test:s24:w4#y2023")) { origin case_input; }
        assert "f2": under_age_17(entity_ref("urn:test:s24:w4#child"), entity_ref("urn:test:s24:w4#y2023")) { origin case_input; }
        // No ssn_included_24h7 fact asserted for this child.
        assert "f3": us.irc.income_individual::filing_status(entity_ref("urn:test:s24:w4#p"), entity_ref("urn:test:s24:w4#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f4": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s24:w4#p"), entity_ref("urn:test:s24:w4#y2023"), 50000.00 USD) { origin case_input; }
    }
    // The child is still a qualifying child (section 24(c)), but with no SSN
    // it is not `child_tax_credit_countable_for_amount` during the TCJA
    // window (section 24(h)(7)): the dollar amount is $0, not $2,000.
    evaluate truth(child_tax_credit(entity_ref("urn:test:s24:w4#p"), entity_ref("urn:test:s24:w4#y2023"), 0 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

