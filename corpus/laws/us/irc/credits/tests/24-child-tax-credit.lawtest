// --- ARPA 2021: qualifying child under 6, fully refundable --------------------
test "S24-06-ARPA-2021-CHILD-UNDER-6-FULLY-REFUNDABLE" {
    given {
        context {
            legal_time @2021-04-15; decision_time @2021-04-15T09:00:00-05:00;
            knowledge_time @2021-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w6#child"), entity_ref("urn:test:s24:w6#p"), entity_ref("urn:test:s24:w6#y2021")) { origin case_input; }
        assert "f1": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w6#child"), entity_ref("urn:test:s24:w6#p"), entity_ref("urn:test:s24:w6#y2021")) { origin case_input; }
        assert "f2": under_age_18_arpa(entity_ref("urn:test:s24:w6#child"), entity_ref("urn:test:s24:w6#y2021")) { origin case_input; }
        assert "f3": under_age_6_at_close_of_calendar_year(entity_ref("urn:test:s24:w6#child"), entity_ref("urn:test:s24:w6#y2021")) { origin case_input; }
        assert "f4": ssn_included_24h7(entity_ref("urn:test:s24:w6#p"), entity_ref("urn:test:s24:w6#child"), entity_ref("urn:test:s24:w6#y2021")) { origin case_input; }
        assert "f5": principal_place_of_abode_in_us_more_than_half_year_24i(entity_ref("urn:test:s24:w6#p"), entity_ref("urn:test:s24:w6#y2021")) { origin case_input; }
        assert "f6": us.irc.income_individual::filing_status(entity_ref("urn:test:s24:w6#p"), entity_ref("urn:test:s24:w6#y2021"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f7": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s24:w6#p"), entity_ref("urn:test:s24:w6#y2021"), 50000.00 USD) { origin case_input; }
    }
    evaluate truth(refundable_child_tax_credit(entity_ref("urn:test:s24:w6#p"), entity_ref("urn:test:s24:w6#y2021"), 3600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- Fraud disallowance period bars the credit --------------------------------
test "S24-07-FRAUD-DISALLOWANCE-PERIOD-BARS-CREDIT" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w7#child"), entity_ref("urn:test:s24:w7#p"), entity_ref("urn:test:s24:w7#y2023")) { origin case_input; }
        assert "f1": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w7#child"), entity_ref("urn:test:s24:w7#p"), entity_ref("urn:test:s24:w7#y2023")) { origin case_input; }
        assert "f2": under_age_17(entity_ref("urn:test:s24:w7#child"), entity_ref("urn:test:s24:w7#y2023")) { origin case_input; }
        assert "f3": ssn_included_24h7(entity_ref("urn:test:s24:w7#p"), entity_ref("urn:test:s24:w7#child"), entity_ref("urn:test:s24:w7#y2023")) { origin case_input; }
        assert "f4": us.irc.income_individual::filing_status(entity_ref("urn:test:s24:w7#p"), entity_ref("urn:test:s24:w7#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f5": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s24:w7#p"), entity_ref("urn:test:s24:w7#y2023"), 50000.00 USD) { origin case_input; }
        assert "f6": in_disallowance_period_24g(entity_ref("urn:test:s24:w7#p"), entity_ref("urn:test:s24:w7#y2023")) { origin case_input; }
    }
    evaluate truth(child_tax_credit(entity_ref("urn:test:s24:w7#p"), entity_ref("urn:test:s24:w7#y2023"), 2000.00 USD));
    expect truth_status == NEITHER;
}

// --- Unknown AGI -> UNDETERMINED -----------------------------------------------
test "S24-08-UNKNOWN-AGI-UNDETERMINED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::qualifying_child_of(entity_ref("urn:test:s24:w8#child"), entity_ref("urn:test:s24:w8#p"), entity_ref("urn:test:s24:w8#y2023")) { origin case_input; }
        assert "f1": section_151_deduction_allowed_for(entity_ref("urn:test:s24:w8#child"), entity_ref("urn:test:s24:w8#p"), entity_ref("urn:test:s24:w8#y2023")) { origin case_input; }
        assert "f2": under_age_17(entity_ref("urn:test:s24:w8#child"), entity_ref("urn:test:s24:w8#y2023")) { origin case_input; }
        assert "f3": ssn_included_24h7(entity_ref("urn:test:s24:w8#p"), entity_ref("urn:test:s24:w8#child"), entity_ref("urn:test:s24:w8#y2023")) { origin case_input; }
        // No adjusted_gross_income asserted.
    }
    evaluate truth(child_tax_credit(entity_ref("urn:test:s24:w8#p"), entity_ref("urn:test:s24:w8#y2023"), 2000.00 USD));
    expect truth_status == NEITHER;
}

