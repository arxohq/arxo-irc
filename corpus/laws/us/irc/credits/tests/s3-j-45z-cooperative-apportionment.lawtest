// Credits stage 3: section 45Z(f)(5) cooperative apportionment (rules similar to 45Y(g)(6)).
// NOT EXECUTED: status implemented_unverified. Expectations come from the pinned statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S3 45Zf5 apportionment by business done" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": apportionment_to_patrons_effective_45z(entity_ref("urn:test:s3 45zf5 apportionment by business done#k"), entity_ref("urn:test:s3 45zf5 apportionment by business done#y")) { origin case_input; }
        assert "f1": cooperative_credit_apportioned_45z(entity_ref("urn:test:s3 45zf5 apportionment by business done#k"), entity_ref("urn:test:s3 45zf5 apportionment by business done#y"), 10000.00 USD) { origin case_input; }
        assert "f2": business_done_by_patron_45y(entity_ref("urn:test:s3 45zf5 apportionment by business done#k"), entity_ref("urn:test:s3 45zf5 apportionment by business done#p"), entity_ref("urn:test:s3 45zf5 apportionment by business done#y"), 2500.00 USD) { origin case_input; }
        assert "f3": total_business_done_45y(entity_ref("urn:test:s3 45zf5 apportionment by business done#k"), entity_ref("urn:test:s3 45zf5 apportionment by business done#y"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(credit_apportioned_to_patron_45z(entity_ref("urn:test:s3 45zf5 apportionment by business done#k"), entity_ref("urn:test:s3 45zf5 apportionment by business done#p"), entity_ref("urn:test:s3 45zf5 apportionment by business done#y"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S3 45Zf5 apportionment needs the effective election" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": cooperative_credit_apportioned_45z(entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#k"), entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#y"), 10000.00 USD) { origin case_input; }
        assert "f1": business_done_by_patron_45y(entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#k"), entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#p"), entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#y"), 2500.00 USD) { origin case_input; }
        assert "f2": total_business_done_45y(entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#k"), entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#y"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(credit_apportioned_to_patron_45z(entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#k"), entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#p"), entity_ref("urn:test:s3 45zf5 apportionment needs the effective election#y"), 2500.00 USD));
    expect truth_status == NEITHER;
}

