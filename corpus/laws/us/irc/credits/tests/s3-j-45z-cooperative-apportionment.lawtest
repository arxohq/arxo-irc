test "S3 45Zf5 tax increase for excess reduction" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": cooperative_credit_determined_45z(entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#k"), entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#y"), 6000.00 USD) { origin case_input; }
        assert "f1": cooperative_credit_shown_on_return_45z(entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#k"), entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#y"), 10000.00 USD) { origin case_input; }
        assert "f2": cooperative_credit_not_apportioned_45z(entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#k"), entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#y"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(cooperative_tax_increase_for_excess_reduction_45z(entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#k"), entity_ref("urn:test:s3 45zf5 tax increase for excess reduction#y"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

