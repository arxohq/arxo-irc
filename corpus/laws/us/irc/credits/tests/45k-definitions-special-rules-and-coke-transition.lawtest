language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45KD-01-SUBSIDY-AMOUNT-DETERMINED-AT-YEAR-END" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_year_close_date_45k(entity_ref("urn:test:s45kd:w1#y"), @2025-12-31) { origin case_input; }
        assert "f1": subsidy_amount_at_date_45k(entity_ref("urn:test:s45kd:w1#pj"), @2025-12-31, 500000.00 USD) { origin case_input; }
        assert "f2": subsidy_amount_at_date_45k(entity_ref("urn:test:s45kd:w1#pj"), @2025-06-30, 100000.00 USD) { origin case_input; }
    }
    evaluate truth(subsidy_amount_as_of_year_end_45k(entity_ref("urn:test:s45kd:w1#pj"), entity_ref("urn:test:s45kd:w1#y"), 500000.00 USD));
    expect truth_status == TRUE_ONLY;
}

