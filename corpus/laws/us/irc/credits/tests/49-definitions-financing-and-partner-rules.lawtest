        assert "f3": corporation_uses_property_in_active_trade_or_business_49(entity_ref("urn:test:s49d:w22#co"), entity_ref("urn:test:s49d:w22#pr")) { origin case_input; }
        assert "f4": corporation_full_time_non_owner_employees_49(entity_ref("urn:test:s49d:w22#co"), entity_ref("urn:test:s49d:w22#y"), 3.0) { origin case_input; }
    }
    evaluate truth(shareholder_treated_as_liable_for_allocable_share_49(entity_ref("urn:test:s49d:w22#sh"), entity_ref("urn:test:s49d:w22#co"), entity_ref("urn:test:s49d:w22#pr"), entity_ref("urn:test:s49d:w22#y")));
    expect truth_status == NEITHER;
}

