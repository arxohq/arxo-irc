test "S49D-01-CREDIT-BASE-SUM-OF-COMPONENTS" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credit_base_component_49(entity_ref("urn:test:s49d:w1#t"), entity_ref("urn:test:s49d:w1#pr"), entity_ref("urn:test:s49d:w1#y"), RehabilitationExpenditures, 400000.00 USD) { origin case_input; }
        assert "f1": credit_base_component_49(entity_ref("urn:test:s49d:w1#t"), entity_ref("urn:test:s49d:w1#pr"), entity_ref("urn:test:s49d:w1#y"), EnergyProperty, 600000.00 USD) { origin case_input; }
    }
    evaluate truth(credit_base_defined_49(entity_ref("urn:test:s49d:w1#t"), entity_ref("urn:test:s49d:w1#pr"), entity_ref("urn:test:s49d:w1#y"), 1000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

