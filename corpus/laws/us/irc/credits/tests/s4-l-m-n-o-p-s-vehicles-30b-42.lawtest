test "S42K1-02-QUALIFIED-COMMERCIAL-FINANCING-WITHOUT-THE-80-PERCENT-TEST" {
    // 200000 is 20 percent of the basis here, but the point is that no 80 percent test is applied to a building (section 42(k)(1) excepts 49(a)(1)(D)(ii)(II)).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_basis(entity_ref("urn:test:c42:t7#b"), entity_ref("urn:test:c42:t7#y"), 1000000 USD) { origin case_input; }
        assert "f1": low_income_housing_building_owned_by(entity_ref("urn:test:c42:t7#b"), entity_ref("urn:test:c42:t7#t")) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:c42:t7#t"), entity_ref("urn:test:c42:t7#b")) { origin case_input; }
        assert "f3": nonrecourse_financing_item_49(entity_ref("urn:test:c42:t7#b"), entity_ref("urn:test:c42:t7#i"), 200000 USD) { origin case_input; }
        assert "f4": property_acquired_from_unrelated_person_49(entity_ref("urn:test:c42:t7#b")) { origin case_input; }
        assert "f5": lender_qualified_person_ignoring_related_person_test_42k(entity_ref("urn:test:c42:t7#i")) { origin case_input; }
    }
    evaluate truth(qualified_basis_after_at_risk_42k1(entity_ref("urn:test:c42:t7#b"), entity_ref("urn:test:c42:t7#t"), entity_ref("urn:test:c42:t7#y"), 1000000 USD));
    expect truth_status == TRUE_ONLY;
}

