        assert "f6": equity_calendar_year_42(entity_ref("urn:test:c42:t5#b"), 2018.0) { origin case_input; }
    }
    evaluate truth(base_year_cost_of_living_adjustment_42(entity_ref("urn:test:c42:t5#b"), 0.091331818182));
    expect truth_status == NEITHER;
}

