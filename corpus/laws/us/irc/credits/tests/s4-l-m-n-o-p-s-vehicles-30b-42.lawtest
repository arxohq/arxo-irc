        assert "f1": us.irc.core::ends(entity_ref("urn:test:c42:t3#y"), @2015-12-31) { origin case_input; }
        assert "f2": cpi_42(2015.0, 100.0) { origin case_input; }
        assert "f3": section_1f3b_conversion_amount_42(1.0) { origin case_input; }
        assert "f4": c_cpi_u_42(2016.0, 103.0) { origin case_input; }
        assert "f5": c_cpi_u_42(2017.0, 110.0) { origin case_input; }
        assert "f6": c_cpi_u_42(2018.0, 111.0) { origin case_input; }
        assert "f7": equity_calendar_year_42(entity_ref("urn:test:c42:t3#b"), 2018.0) { origin case_input; }
    }
    evaluate truth(base_year_cost_of_living_adjustment_42(entity_ref("urn:test:c42:t3#b"), 0.091331818182));
    expect truth_status == TRUE_ONLY;
}

