test "S42H6GII-02-GROWTH-OVER-5-PERCENT-NOT-TAKEN-INTO-ACCOUNT" {
    // 2016: 103/100 = 1.03; 2017: 110 exceeds 1.05 x 103, so the year counts 1.05; 2018: 111/110. Each product rounded to 12 places.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
