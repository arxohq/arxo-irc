test "S42K3-01-BELOW-MARKET-FINANCING-PRESENT-VALUE-AT-THE-AFR" {
    // Stated rate 2 percent is below AFR 5 percent minus 1 point: the basis relating to the financing is its present value (20 semiannual periods at 2.5 percent).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": financing_amount_42k3(entity_ref("urn:test:c42:t11#f"), 1000000 USD) { origin case_input; }
        assert "f1": financing_incurred_on_42k3(entity_ref("urn:test:c42:t11#f"), @2020-01-01) { origin case_input; }
        assert "f2": financing_maturity_on_42k3(entity_ref("urn:test:c42:t11#f"), @2030-01-01) { origin case_input; }
        assert "f3": applicable_federal_rate_at_financing_42k3(entity_ref("urn:test:c42:t11#f"), 0.05) { origin case_input; }
        assert "f4": financing_stated_interest_rate_42k3(entity_ref("urn:test:c42:t11#f"), 0.02) { origin case_input; }
    }
    evaluate truth(present_value_of_financing_42k3(entity_ref("urn:test:c42:t11#f"), 610270.94 USD));
    expect truth_status == TRUE_ONLY;
}

