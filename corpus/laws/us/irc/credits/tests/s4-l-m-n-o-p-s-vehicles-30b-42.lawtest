test "S42K2D-01-SPECIAL-DATE-FOR-A-NONPROFIT-LENDER-THAT-IS-NOT-THE-SELLER" {
    // Earlier of the cessation (2033-06-30) and 15 years after the compliance period, plus 90 days: 2033-09-28; repaid 2033-09-01.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
