// Stage 4 scenarios: 45Q/45V/48A/48B reductions (45b3), vehicles 45W/25E (s4-l, s4-m, s4-s), 30B (s4-n), section 42 (s4-o, s4-p). NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";


test "S45Qf8-01-COMPONENT-REDUCED-BY-THE-45B3-FRACTION-OF-THE-FACILITY" {
    // Section 45Q(f)(8), rule similar to section 45(b)(3).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": carbon_oxide_credit_component_before_45b3_45q(entity_ref("urn:test:cv:t1#t"), entity_ref("urn:test:cv:t1#q"), entity_ref("urn:test:cv:t1#y"), GeologicalStorage, 1000 USD) { origin case_input; }
        assert "f1": equipment_at_facility_45q(entity_ref("urn:test:cv:t1#q"), entity_ref("urn:test:cv:t1#f")) { origin case_input; }
        assert "f2": reduction_fraction_45b3(entity_ref("urn:test:cv:t1#f"), entity_ref("urn:test:cv:t1#y"), 0.1) { origin case_input; }
    }
    evaluate truth(carbon_oxide_credit_component_45q(entity_ref("urn:test:cv:t1#t"), entity_ref("urn:test:cv:t1#q"), entity_ref("urn:test:cv:t1#y"), GeologicalStorage, 900 USD));
    expect truth_status == TRUE_ONLY;
}

