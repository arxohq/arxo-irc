        assert "f1": qualified_nonprofit_organization_42(entity_ref("urn:test:c42:t15#o")) { origin case_input; }
        assert "f2": financing_repayment_date_42(entity_ref("urn:test:c42:t15#f"), @2033-09-01) { origin case_input; }
        assert "f3": financing_maturity_date_42(entity_ref("urn:test:c42:t15#f"), @2050-01-01) { origin case_input; }
        assert "f4": compliance_period_close_date_42(entity_ref("urn:test:c42:t15#f"), @2030-12-31) { origin case_input; }
        assert "f5": financing_refinancing_or_sale_date_42(entity_ref("urn:test:c42:t15#f"), @2050-01-01) { origin case_input; }
        assert "f6": building_ceases_to_be_qualified_low_income_building_on_42k(entity_ref("urn:test:c42:t15#f"), @2033-06-30) { origin case_input; }
    }
    evaluate truth(financing_repaid_by_earliest_required_date_42(entity_ref("urn:test:c42:t15#f")));
    expect truth_status == TRUE_ONLY;
}

