            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": security_expenditure_45o(entity_ref("urn:test:s45od:w24#t"), entity_ref("urn:test:s45od:w24#i1"), entity_ref("urn:test:s45od:w24#y"), PerimeterProtection, 10000.00 USD) { origin case_input; }
        assert "f1": amount_for_protecting_specified_chemicals_45o(entity_ref("urn:test:s45od:w24#i1"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_chemical_security_expenditure_45o(entity_ref("urn:test:s45od:w24#t"), entity_ref("urn:test:s45od:w24#i1"), entity_ref("urn:test:s45od:w24#y"), 10000.00 USD));
    expect truth_status == NEITHER;
}

test "S45OD-25-QUALIFIED-EXPENDITURES-SUM" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": business_activity_45o(entity_ref("urn:test:s45od:w25#t"), ManufacturingFormulatingDistributingOrAerialApplication) { origin case_input; }
        assert "f1": security_expenditure_45o(entity_ref("urn:test:s45od:w25#t"), entity_ref("urn:test:s45od:w25#i1"), entity_ref("urn:test:s45od:w25#y"), PerimeterProtection, 10000.00 USD) { origin case_input; }
        assert "f2": amount_for_protecting_specified_chemicals_45o(entity_ref("urn:test:s45od:w25#i1"), 10000.00 USD) { origin case_input; }
        assert "f3": security_expenditure_45o(entity_ref("urn:test:s45od:w25#t"), entity_ref("urn:test:s45od:w25#i2"), entity_ref("urn:test:s45od:w25#y"), SiteSecurityPlan, 5000.00 USD) { origin case_input; }
        assert "f4": amount_for_protecting_specified_chemicals_45o(entity_ref("urn:test:s45od:w25#i2"), 4000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_chemical_security_expenditures_computed_45o(entity_ref("urn:test:s45od:w25#t"), entity_ref("urn:test:s45od:w25#y"), 14000.00 USD));
    expect truth_status == TRUE_ONLY;
}
