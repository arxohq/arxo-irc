test "S45CB1-01-IN-HOUSE-AMOUNTS-PLUS-100-PERCENT-OF-CONTRACT-AMOUNTS" {
    // 1000 + 500 + 200 + 100 percent of 4000 (not 65 percent).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": clinical_testing_45c(entity_ref("urn:test:c45c:t1#r"), entity_ref("urn:test:c45c:t1#t")) { origin case_input; }
        assert "f1": clinical_testing_expense_item_45c(entity_ref("urn:test:c45c:t1#t"), entity_ref("urn:test:c45c:t1#y"), entity_ref("urn:test:c45c:t1#r"), Wages, 1000 USD) { origin case_input; }
        assert "f2": clinical_testing_expense_item_45c(entity_ref("urn:test:c45c:t1#t"), entity_ref("urn:test:c45c:t1#y"), entity_ref("urn:test:c45c:t1#r"), Supplies, 500 USD) { origin case_input; }
        assert "f3": clinical_testing_expense_item_45c(entity_ref("urn:test:c45c:t1#t"), entity_ref("urn:test:c45c:t1#y"), entity_ref("urn:test:c45c:t1#r"), ComputerUse, 200 USD) { origin case_input; }
        assert "f4": clinical_testing_expense_item_45c(entity_ref("urn:test:c45c:t1#t"), entity_ref("urn:test:c45c:t1#y"), entity_ref("urn:test:c45c:t1#r"), Contract, 4000 USD) { origin case_input; }
    }
    evaluate truth(clinical_testing_expense_computed_45c(entity_ref("urn:test:c45c:t1#t"), entity_ref("urn:test:c45c:t1#y"), entity_ref("urn:test:c45c:t1#r"), 5700 USD));
    expect truth_status == TRUE_ONLY;
}

