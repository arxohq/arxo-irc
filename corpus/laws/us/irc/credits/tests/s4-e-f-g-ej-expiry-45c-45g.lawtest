test "S45GB2-04-SECOND-ASSIGNMENT-IN-A-YEAR-IS-PROHIBITED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": track_assignment_made_45g(1, entity_ref("urn:test:cg:t4#a"), entity_ref("urn:test:cg:t4#e"), entity_ref("urn:test:cg:t4#ya"), 10.0) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:cg:t4#ya"), @2024-12-31) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:cg:t4#ye"), @2025-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:cg:t4#ye"), @2025-12-31) { origin case_input; }
        assert "f4": track_assignment_made_45g(2, entity_ref("urn:test:cg:t4#a"), entity_ref("urn:test:cg:t4#e2"), entity_ref("urn:test:cg:t4#ya"), 5.0) { origin case_input; }
    }
    evaluate positions();
    expect position(Section45gB2AOneAssignmentPerYear, VIOLATED);
}

test "S45GD-01-ONLY-TRACK-HELD-ON-JANUARY-1-2015-QUALIFIES" {
    // Track 2 was not held on 1 January 2015: its 1000 is excluded.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": track_maintenance_expenditure_45g(entity_ref("urn:test:cg:t5#t"), entity_ref("urn:test:cg:t5#y"), 1, 4000 USD) { origin case_input; }
        assert "f1": track_maintenance_expenditure_45g(entity_ref("urn:test:cg:t5#t"), entity_ref("urn:test:cg:t5#y"), 2, 1000 USD) { origin case_input; }
        assert "f2": track_owned_or_leased_on_january_1_2015_by_class_ii_or_iii_45g(1) { origin case_input; }
    }
    evaluate truth(qualified_track_maintenance_expenditures_derived_45g(entity_ref("urn:test:cg:t5#t"), entity_ref("urn:test:cg:t5#y"), 4000 USD));
    expect truth_status == TRUE_ONLY;
}

