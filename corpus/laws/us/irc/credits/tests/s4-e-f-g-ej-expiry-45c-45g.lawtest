// Stage 4 scenarios: EJ capacity expiry (s4-e), 45C (s4-f), 45G (s4-g), 48D (s4-h), 45U (s4-i). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";


test "S48EH4E-01-UNPLACED-ALLOCATION-EXPIRES-IN-THE-FOURTH-YEAR" {
    // Allocated 2025-06-01, not placed in service: expires in 2029; 100 MW = 0.1 GW.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": ej_year_48eh(2029.0) { origin case_input; }
        assert "f1": applicable_year_45y(2032.0) { origin case_input; }
        assert "f2": ej_capacity_limitation_allocated_mw_dc_48eh(entity_ref("urn:test:cej:t1#f"), 100.0) { origin case_input; }
        assert "f3": ej_allocation_date_48eh(entity_ref("urn:test:cej:t1#f"), @2025-06-01) { origin case_input; }
    }
    evaluate truth(ej_capacity_expired_in_year_gw_48eh(2029.0, 0.1));
    expect truth_status == TRUE_ONLY;
}

