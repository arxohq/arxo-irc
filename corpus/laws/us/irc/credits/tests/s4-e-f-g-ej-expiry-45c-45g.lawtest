test "S45GB2-01-ASSIGNMENT-EFFECTIVE-AT-THE-CLOSE-OF-THE-RAILROAD-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": track_assignment_made_45g(1, entity_ref("urn:test:cg:t1#a"), entity_ref("urn:test:cg:t1#e"), entity_ref("urn:test:cg:t1#ya"), 10.0) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:cg:t1#ya"), @2024-12-31) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:cg:t1#ye"), @2025-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:cg:t1#ye"), @2025-12-31) { origin case_input; }
    }
    evaluate truth(track_assignment_effective_on_45g(1, @2024-12-31));
    expect truth_status == TRUE_ONLY;
}

test "S45GB2-02-TAKEN-INTO-ACCOUNT-IN-THE-ASSIGNEE-YEAR-CONTAINING-THE-DATE" {
    // The assignee year 2024 contains 2024-12-31 (the assignee year 2025 does not).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": track_assignment_made_45g(1, entity_ref("urn:test:cg:t2#a"), entity_ref("urn:test:cg:t2#e"), entity_ref("urn:test:cg:t2#ya"), 10.0) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:cg:t2#ya"), @2024-12-31) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:cg:t2#ye"), @2025-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:cg:t2#ye"), @2025-12-31) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:cg:t2#ye0"), @2024-01-01) { origin case_input; }
        assert "f5": us.irc.core::ends(entity_ref("urn:test:cg:t2#ye0"), @2024-12-31) { origin case_input; }
    }
    evaluate truth(track_assignment_taken_into_account_year_45g(1, entity_ref("urn:test:cg:t2#e"), entity_ref("urn:test:cg:t2#ye0")));
    expect truth_status == TRUE_ONLY;
}

