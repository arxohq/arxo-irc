// Section 52 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S52-01-PARENT-SUBSIDIARY-OVER-50-PERCENT-VOTING-IS-CONTROLLED-GROUP" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": us.irc.corporations::parent_subsidiary_ownership_share(entity_ref("urn:test:s52:w1#g1"), entity_ref("urn:test:s52:w1#parent"), entity_ref("urn:test:s52:w1#sub"), 0.60, 0.60) { origin case_input; }
    }
    // 60% > 50% (section 52(a)(1)'s substituted threshold) — a controlled group even though far below section 1563(a)(1)'s own 80%.
    evaluate truth(section_52_controlled_group_member(entity_ref("urn:test:s52:w1#g1"), entity_ref("urn:test:s52:w1#sub")));
    expect truth_status == TRUE_ONLY;
}

test "S52-02-PARENT-SUBSIDIARY-AT-45-PERCENT-NOT-CONTROLLED-GROUP" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": us.irc.corporations::parent_subsidiary_ownership_share(entity_ref("urn:test:s52:w2#g1"), entity_ref("urn:test:s52:w2#parent"), entity_ref("urn:test:s52:w2#sub"), 0.45, 0.45) { origin case_input; }
    }
    // 45% is below the section 52(a)(1) more-than-50% threshold; no rule concludes membership — NEITHER, not a proven negative.
    evaluate truth(section_52_controlled_group_member(entity_ref("urn:test:s52:w2#g1"), entity_ref("urn:test:s52:w2#sub")));
    expect truth_status == NEITHER;
}

test "S52-03-PROPORTIONATE-SHARE-OF-GROUP-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": us.irc.corporations::parent_subsidiary_ownership_share(entity_ref("urn:test:s52:w3#g1"), entity_ref("urn:test:s52:w3#parent"), entity_ref("urn:test:s52:w3#sub"), 0.70, 0.70) { origin case_input; }
        assert "f2": section_52a_group_qualified_first_year_wages(entity_ref("urn:test:s52:w3#g1"), entity_ref("urn:test:s52:w3#y1"), 100000.00 USD) { origin case_input; }
        assert "f3": section_52a_member_wage_share(entity_ref("urn:test:s52:w3#g1"), entity_ref("urn:test:s52:w3#sub"), entity_ref("urn:test:s52:w3#y1"), 0.30) { origin case_input; }
    }
    // 100000 * 0.30 = 30000.
    evaluate truth(section_52a_proportionate_share_of_credit(entity_ref("urn:test:s52:w3#g1"), entity_ref("urn:test:s52:w3#sub"), entity_ref("urn:test:s52:w3#y1"), 30000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S52-04-TAX-EXEMPT-ORGANIZATION-WOTC-DENIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": exempt_from_income_tax_under_chapter_1(entity_ref("urn:test:s52:w4#org")) { origin case_input; }
    }
    evaluate truth(section_52c_work_opportunity_credit_denied(entity_ref("urn:test:s52:w4#org")));
    expect truth_status == TRUE_ONLY;
}

test "S52-05-SECTION-521-COOPERATIVE-EXCEPTION-NOT-DENIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": exempt_from_income_tax_under_chapter_1(entity_ref("urn:test:s52:w5#coop")) { origin case_input; }
        assert "f2": cooperative_described_in_521(entity_ref("urn:test:s52:w5#coop")) { origin case_input; }
    }
    // the section 521 cooperative exception blocks the denial rule's "not cooperative_described_in_521" guard.
    evaluate truth(section_52c_work_opportunity_credit_denied(entity_ref("urn:test:s52:w5#coop")));
    expect truth_status == NEITHER;
}

test "S52-06-ESTATE-APPORTIONS-CREDIT-TO-BENEFICIARY" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": section_52d_credit_before_apportionment(entity_ref("urn:test:s52:w6#estate"), entity_ref("urn:test:s52:w6#y1"), 10000.00 USD) { origin case_input; }
        assert "f2": section_52d_income_allocable_share(entity_ref("urn:test:s52:w6#estate"), entity_ref("urn:test:s52:w6#ben"), entity_ref("urn:test:s52:w6#y1"), 0.25) { origin case_input; }
    }
    // 10000 * 0.25 = 2500.
    evaluate truth(section_52d_apportioned_credit(entity_ref("urn:test:s52:w6#estate"), entity_ref("urn:test:s52:w6#ben"), entity_ref("urn:test:s52:w6#y1"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
}
