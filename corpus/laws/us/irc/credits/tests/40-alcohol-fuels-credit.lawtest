    expect truth_status == NEITHER;
}

test "S40-20-ALCOHOL-FUELS-CREDIT-SUMS-COMPONENTS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": alcohol_batch_facts_40(entity_ref("urn:test:40:w20#b"), 200.0) { origin case_input; }
        assert "f1": batch_sale_or_use_date_40(entity_ref("urn:test:40:w20#b"), @2000-06-01) { origin case_input; }
        assert "f2": alcohol_gallons_in_qualified_mixture_40(entity_ref("urn:test:40:w20#t"), entity_ref("urn:test:40:w20#b"), entity_ref("urn:test:40:w20#y"), 1000.0) { origin case_input; }
        assert "f3": productive_capacity_gallons_40(entity_ref("urn:test:40:w20#t"), entity_ref("urn:test:40:w20#y"), 50000000.0) { origin case_input; }
        assert "f4": qualified_ethanol_fuel_production_gallons_40(entity_ref("urn:test:40:w20#t"), entity_ref("urn:test:40:w20#y"), 20000000.0) { origin case_input; }
    }
    // (a): mixture credit 600 + small ethanol producer credit 1,500,000.
    evaluate truth(alcohol_fuels_credit(entity_ref("urn:test:40:w20#t"), entity_ref("urn:test:40:w20#y"), 1500600.00 USD));
    expect truth_status == TRUE_ONLY;
}

