// Section 40 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S40-01-MIXTURE-CREDIT-60-CENTS-FULL-PROOF" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": alcohol_batch_facts_40(entity_ref("urn:test:40:w1#b"), 200.0) { origin case_input; }
        assert "f1": batch_sale_or_use_date_40(entity_ref("urn:test:40:w1#b"), @2000-06-01) { origin case_input; }
        assert "f2": alcohol_gallons_in_qualified_mixture_40(entity_ref("urn:test:40:w1#t"), entity_ref("urn:test:40:w1#b"), entity_ref("urn:test:40:w1#y"), 1000.0) { origin case_input; }
    }
    // (b)(1): 60 cents x 1,000 gallons of alcohol of proof 190 or more.
    evaluate truth(alcohol_mixture_credit_per_batch_40(entity_ref("urn:test:40:w1#t"), entity_ref("urn:test:40:w1#b"), entity_ref("urn:test:40:w1#y"), 600.00 USD));
    expect truth_status == TRUE_ONLY;
}

