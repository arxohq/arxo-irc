// Section 30C scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S30C-01-DEPRECIABLE-6-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_refueling_property_30c(entity_ref("urn:test:30c:w1#it")) { origin case_input; }
        assert "f1": refueling_property_cost_30c(entity_ref("urn:test:30c:w1#t"), entity_ref("urn:test:30c:w1#it"), entity_ref("urn:test:30c:w1#y"), 200000.00 USD) { origin case_input; }
        assert "f2": refueling_property_placed_in_service_on_30c(entity_ref("urn:test:30c:w1#it"), @2025-02-01) { origin case_input; }
        assert "f3": refueling_property_census_tract_30c(entity_ref("urn:test:30c:w1#it"), entity_ref("urn:test:30c:w1#tr")) { origin case_input; }
        assert "f4": tract_poverty_rate_45d(entity_ref("urn:test:30c:w1#tr"), 25.0) { origin case_input; }
        assert "f5": refueling_property_depreciable_30c(entity_ref("urn:test:30c:w1#it")) { origin case_input; }
    }
    // 6% of 200,000 for depreciable property.
    evaluate truth(refueling_credit_per_item_30c(entity_ref("urn:test:30c:w1#t"), entity_ref("urn:test:30c:w1#it"), entity_ref("urn:test:30c:w1#y"), 12000.00 USD));
    expect truth_status == TRUE_ONLY;
}

