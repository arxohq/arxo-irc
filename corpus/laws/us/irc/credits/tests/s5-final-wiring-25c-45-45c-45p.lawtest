        assert "f1": coal_increase_facility_owner_45(entity_ref("urn:test:w45e:3#f"), entity_ref("urn:test:w45e:3#es")) { origin case_input; }
        assert "f2": section_52d_income_allocable_share(entity_ref("urn:test:w45e:3#es"), entity_ref("urn:test:w45e:3#b"), entity_ref("urn:test:w45e:3#y"), 0.25) { origin case_input; }
    }
    evaluate truth(coal_increase_credit_45(entity_ref("urn:test:w45e:3#es"), entity_ref("urn:test:w45e:3#y"), 7500.00 USD));
    expect truth_status == TRUE_ONLY;
}

