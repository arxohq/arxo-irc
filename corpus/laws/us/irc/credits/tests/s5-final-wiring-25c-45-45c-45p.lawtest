test "W45P-01-SECTION-45S-CREDIT-REDUCED-BY-THE-45P-CREDIT-OF-THE-EMPLOYEE" {
    // 45S credit 500 (12.5 percent of 4000) less the 45P credit 200 of the same employee = 300.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_employer_45s(entity_ref("urn:test:w45p:1#er"), entity_ref("urn:test:w45p:1#y")) { origin case_input; }
        assert "f1": qualifying_employee_45s(entity_ref("urn:test:w45p:1#ee"), entity_ref("urn:test:w45p:1#er"), entity_ref("urn:test:w45p:1#y")) { origin case_input; }
        assert "f2": rate_of_payment_45s(entity_ref("urn:test:w45p:1#er"), entity_ref("urn:test:w45p:1#ee"), entity_ref("urn:test:w45p:1#y"), 0.50) { origin case_input; }
        assert "f3": wages_paid_during_leave_45s(entity_ref("urn:test:w45p:1#er"), entity_ref("urn:test:w45p:1#ee"), entity_ref("urn:test:w45p:1#y"), 4000.00 USD) { origin case_input; }
        assert "f4": compensation_credit_reduction_45p(entity_ref("urn:test:w45p:1#er"), entity_ref("urn:test:w45p:1#ee"), entity_ref("urn:test:w45p:1#y"), 200 USD) { origin case_input; }
    }
    evaluate truth(paid_family_medical_leave_credit_per_employee(entity_ref("urn:test:w45p:1#er"), entity_ref("urn:test:w45p:1#ee"), entity_ref("urn:test:w45p:1#y"), 300.00 USD));
    expect truth_status == TRUE_ONLY;
}

