test "W45CC2-01-ASC-AVERAGE-FROM-THE-BASE-PERIOD-EXPENSES-OF-THE-3-PRECEDING-YEARS" {
    // (300 + 600 + 900)/3 = 600; the 2022 amount includes a 45C clinical expense counted in the base period.
    given {
        context {
            legal_time @2025-04-15;
