test "W45J-01-OWNER-CREDIT-BY-INTEREST-IN-GROSS-SALES" {
    // facility credit 18,000,000 (scenario S45J-01); owner a 60 percent = 10,800,000.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": nuclear_facility_owned_by_taxpayer_45j(entity_ref("urn:test:w45j:1#f"), entity_ref("urn:test:w45j:1#a")) { origin case_input; }
        assert "f1": nuclear_facility_owned_by_taxpayer_45j(entity_ref("urn:test:w45j:1#f"), entity_ref("urn:test:w45j:1#b")) { origin case_input; }
        assert "f2": nrc_reactor_design_approved_on_45j(entity_ref("urn:test:w45j:1#f"), @2000-01-01) { origin case_input; }
        assert "f3": facility_originally_placed_in_service_on_45j(entity_ref("urn:test:w45j:1#f"), @2015-01-01) { origin case_input; }
        assert "f4": section_45j_enacted_on(@2005-08-08) { origin case_input; }
        assert "f5": electricity_sale_date_45j(entity_ref("urn:test:w45j:1#f"), entity_ref("urn:test:w45j:1#y"), @2018-06-01) { origin case_input; }
        assert "f6": kilowatt_hours_sold_45j(entity_ref("urn:test:w45j:1#f"), entity_ref("urn:test:w45j:1#y"), 1000000000.0) { origin case_input; }
        assert "f7": allocated_megawatt_capacity_45j(entity_ref("urn:test:w45j:1#f"), 1000.0) { origin case_input; }
        assert "f8": nameplate_megawatt_capacity_45j(entity_ref("urn:test:w45j:1#f"), 1000.0) { origin case_input; }
        assert "f9": reference_price_cents_45j(entity_ref("urn:test:w45j:1#y"), 7.0) { origin case_input; }
        assert "f10": inflation_adjustment_factor_45j(entity_ref("urn:test:w45j:1#y"), 1.0) { origin case_input; }
        assert "f11": ownership_share_of_gross_sales_45(entity_ref("urn:test:w45j:1#f"), entity_ref("urn:test:w45j:1#a"), 0.6) { origin case_input; }
        assert "f12": ownership_share_of_gross_sales_45(entity_ref("urn:test:w45j:1#f"), entity_ref("urn:test:w45j:1#b"), 0.4) { origin case_input; }
    }
    evaluate truth(credit_holder_45j(entity_ref("urn:test:w45j:1#a"), entity_ref("urn:test:w45j:1#f"), entity_ref("urn:test:w45j:1#y"), 10800000.00 USD));
    expect truth_status == TRUE_ONLY;
}

