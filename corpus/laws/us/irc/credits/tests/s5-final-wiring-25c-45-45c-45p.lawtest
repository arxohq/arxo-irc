// Final TECH_GAP pass (26.09.2026) scenarios: section 25C(f)(1) wired into the 25C credit chain (G6600), the coal increases and
// the rules similar to section 45(e)(3), (5) wired into the section 45 component, 45J and 45U (G6601, G6604), section 45C(c)(2)
// wired into the section 41 fixed-base percentage and the ASC average (G6602), section 45P(c) wired into 45S and 45A (G6603).
// NOT EXECUTED (implemented_unverified). Intermediate derived relations are asserted as case inputs where a chain is long.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";


test "W25C-01-TENANT-STOCKHOLDER-SHARE-ENTERS-THE-WINDOWS-CREDIT" {
    // 500 asserted + 10 percent of 10000 = 1500; 30 percent = 450, below the 600 cap.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": windows_and_skylights_expenditure(entity_ref("urn:test:w25c:1#t"), entity_ref("urn:test:w25c:1#y"), 500 USD) { origin case_input; }
        assert "f1": tenant_stockholder_proportionate_share_25d(entity_ref("urn:test:w25c:1#t"), entity_ref("urn:test:w25c:1#c"), 0.1) { origin case_input; }
        assert "f2": cooperative_expenditure_25c(entity_ref("urn:test:w25c:1#c"), entity_ref("urn:test:w25c:1#y"), WindowsAndSkylights25c, 10000 USD) { origin case_input; }
    }
    evaluate truth(windows_credit(entity_ref("urn:test:w25c:1#t"), entity_ref("urn:test:w25c:1#y"), 450.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W25C-02-CONDOMINIUM-SHARE-AND-ITEM-ALLOCATION-ENTER-THE-DOORS-CREDIT" {
    // 0 asserted + 10 percent of 8000 = 800 + item 1000 x 0.7 = 700: 1500; 30 percent = 450, below the 500 cap.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": exterior_doors_expenditure_before_cap(entity_ref("urn:test:w25c:2#t"), entity_ref("urn:test:w25c:2#y"), 0 USD) { origin case_input; }
        assert "f1": association_meets_528c1_other_than_e_25d(entity_ref("urn:test:w25c:2#c")) { origin case_input; }
        assert "f2": condominium_project_substantially_all_units_residences_25d(entity_ref("urn:test:w25c:2#c")) { origin case_input; }
        assert "f3": condominium_member_proportionate_share_25d(entity_ref("urn:test:w25c:2#t"), entity_ref("urn:test:w25c:2#c"), 0.1) { origin case_input; }
        assert "f4": cooperative_expenditure_25c(entity_ref("urn:test:w25c:2#c"), entity_ref("urn:test:w25c:2#y"), ExteriorDoors25c, 8000 USD) { origin case_input; }
        assert "f5": expenditure_for_item_25c(entity_ref("urn:test:w25c:2#t"), entity_ref("urn:test:w25c:2#a"), entity_ref("urn:test:w25c:2#y"), ExteriorDoors25c, 1000 USD) { origin case_input; }
        assert "f6": nonbusiness_use_share_25d(entity_ref("urn:test:w25c:2#a"), 0.7) { origin case_input; }
    }
    evaluate truth(doors_credit(entity_ref("urn:test:w25c:2#t"), entity_ref("urn:test:w25c:2#y"), 450.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W25C-03-ITEM-AT-LEAST-80-PERCENT-NONBUSINESS-COUNTS-WHOLE-IN-INSULATION" {
    // 100 asserted + item 400 at 90 percent nonbusiness (whole) = 500; 30 percent = 150.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": building_envelope_insulation_expenditure(entity_ref("urn:test:w25c:3#t"), entity_ref("urn:test:w25c:3#y"), 100 USD) { origin case_input; }
        assert "f1": expenditure_for_item_25c(entity_ref("urn:test:w25c:3#t"), entity_ref("urn:test:w25c:3#a"), entity_ref("urn:test:w25c:3#y"), Insulation25c, 400 USD) { origin case_input; }
        assert "f2": nonbusiness_use_share_25d(entity_ref("urn:test:w25c:3#a"), 0.9) { origin case_input; }
    }
    evaluate truth(insulation_credit(entity_ref("urn:test:w25c:3#t"), entity_ref("urn:test:w25c:3#y"), 150.00 USD));
    expect truth_status == TRUE_ONLY;
}

