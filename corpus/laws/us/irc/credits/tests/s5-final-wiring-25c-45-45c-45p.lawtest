}

test "W45E-01-COAL-INCREASE-SPLIT-BY-GROSS-SALES-INTEREST" {
    // increase 10000; owner a 60 percent = 6000.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": coal_increase_for_credit_of_facility_45(entity_ref("urn:test:w45e:1#f"), entity_ref("urn:test:w45e:1#y"), 10000 USD) { origin case_input; }
        assert "f1": coal_increase_facility_owner_45(entity_ref("urn:test:w45e:1#f"), entity_ref("urn:test:w45e:1#a")) { origin case_input; }
        assert "f2": coal_increase_facility_owner_45(entity_ref("urn:test:w45e:1#f"), entity_ref("urn:test:w45e:1#b")) { origin case_input; }
        assert "f3": ownership_share_of_gross_sales_45(entity_ref("urn:test:w45e:1#f"), entity_ref("urn:test:w45e:1#a"), 0.6) { origin case_input; }
        assert "f4": ownership_share_of_gross_sales_45(entity_ref("urn:test:w45e:1#f"), entity_ref("urn:test:w45e:1#b"), 0.4) { origin case_input; }
    }
    evaluate truth(coal_increase_of_owner_45(entity_ref("urn:test:w45e:1#f"), entity_ref("urn:test:w45e:1#a"), entity_ref("urn:test:w45e:1#y"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

