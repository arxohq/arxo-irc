        assert "f6": research_expenses_of_year_for_base_period_41(entity_ref("urn:test:w45c:1#p"), entity_ref("urn:test:w45c:1#y1"), 300 USD) { origin case_input; }
        assert "f7": us.irc.core::year_of(entity_ref("urn:test:w45c:1#p"), entity_ref("urn:test:w45c:1#y2")) { origin case_input; }
        assert "f8": us.irc.core::calendar_year_of(entity_ref("urn:test:w45c:1#y2"), 2023) { origin case_input; }
        assert "f9": us.irc.core::begins(entity_ref("urn:test:w45c:1#y2"), @2023-01-01) { origin case_input; }
