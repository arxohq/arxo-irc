        assert "f2": coverage_kind_35(entity_ref("urn:test:s35:w66#c"), CobraContinuation) { origin case_input; }
        assert "f3": covered_by_qualified_insurance_premium_paid_by_taxpayer_35(entity_ref("urn:test:s35:w66#p"), @2010-03-01, entity_ref("urn:test:s35:w66#c")) { origin case_input; }
    }
    // (g)(10)(C)(ii): a qualifying family member immediately before the death.
    evaluate truth(eligible_individual_35(entity_ref("urn:test:s35:w66#p"), @2010-03-01));
    expect truth_status == TRUE_ONLY;
}

