test "S35-68-TAX-INCREASE-BY-EXCESS-ADVANCE-PAYMENTS" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": advance_payments_1412_and_7527_35(entity_ref("urn:test:s35:w68#p"), entity_ref("urn:test:s35:w68#y"), 5000.00 USD) { origin case_input; }
        assert "f1": credit_35_without_g1_35(entity_ref("urn:test:s35:w68#p"), entity_ref("urn:test:s35:w68#y"), 1500.00 USD) { origin case_input; }
        assert "f2": credit_36b_without_f1_35(entity_ref("urn:test:s35:w68#p"), entity_ref("urn:test:s35:w68#y"), 2000.00 USD) { origin case_input; }
    }
    // (g)(12)(B)(i): 5,000 - (1,500 + 2,000) = 1,500.
    evaluate truth(tax_increase_for_advance_payments_35(entity_ref("urn:test:s35:w68#p"), entity_ref("urn:test:s35:w68#y"), 1500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S35-69-NO-INCREASE-WHEN-CREDITS-EXCEED-ADVANCE-PAYMENTS" {
