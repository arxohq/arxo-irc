// Section 35 health coverage tax credit scenarios (stage 2e). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).
// The date of the enactment of section 35(c)(2)(B) is not pinned in the corpus: scenarios that need it assert an
// ASSUMED case date 2011-01-01 (a scenario input, not a claim about the statute).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S35-01-TAA-RECIPIENT-RECEIVING-ALLOWANCE-BEFORE-C2B" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": receives_tra_for_a_day_of_month_35(entity_ref("urn:test:s35:w1#p"), @2010-03-01) { origin case_input; }
        assert "f1": c2b_enactment_date_35(@2011-01-01) { origin case_input; }
    }
    // (c)(2)(A): receiving a trade readjustment allowance for a day of a month up to the (assumed) enactment date of (B).
    evaluate truth(eligible_taa_recipient_35(entity_ref("urn:test:s35:w1#p"), @2010-03-01));
    expect truth_status == TRUE_ONLY;
}

test "S35-02-BREAK-IN-TRAINING-COUNTS-ONLY-AFTER-C2B" {
