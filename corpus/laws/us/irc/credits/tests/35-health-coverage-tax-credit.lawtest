        }
        assert "f0": coverage_kind_35(entity_ref("urn:test:s35:w14#c"), StateHighRiskPool) { origin case_input; }
        assert "f1": state_elected_treatment_as_qualified_35(entity_ref("urn:test:s35:w14#c")) { origin case_input; }
        assert "f2": guaranteed_enrollment_for_qualifying_individuals_35(entity_ref("urn:test:s35:w14#c")) { origin case_input; }
        assert "f3": no_pre_existing_condition_limitation_35(entity_ref("urn:test:s35:w14#c")) { origin case_input; }
        assert "f4": premium_not_greater_than_for_similarly_situated_35(entity_ref("urn:test:s35:w14#c")) { origin case_input; }
        assert "f5": benefits_same_or_substantially_similar_35(entity_ref("urn:test:s35:w14#c")) { origin case_input; }
    }
    // (e)(1)(C), (e)(2)(A): the State elected and the four requirements hold.
    evaluate truth(qualified_health_insurance_35(entity_ref("urn:test:s35:w14#c")));
    expect truth_status == TRUE_ONLY;
}

