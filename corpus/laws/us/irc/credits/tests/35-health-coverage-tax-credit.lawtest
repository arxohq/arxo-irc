        assert "f1": c2b_enactment_date_35(@2011-01-01) { origin case_input; }
    }
    // (c)(2)(A): a month before the enactment of (B) is governed by (A), which has no break-in-training limb.
    evaluate truth(eligible_taa_recipient_35(entity_ref("urn:test:s35:w3#p"), @2010-03-01));
    expect truth_status == NEITHER;
}

