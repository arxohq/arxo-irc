        assert "f1": c2b_enactment_date_35(@2011-01-01) { origin case_input; }
    }
    // (c)(2)(B)(ii): the break-in-training limb applies to months after the enactment of (B): a March 2011 month qualifies.
    evaluate truth(eligible_taa_recipient_35(entity_ref("urn:test:s35:w2#p"), @2011-03-01));
    expect truth_status == TRUE_ONLY;
}

test "S35-03-BREAK-IN-TRAINING-BEFORE-C2B-DOES-NOT-COUNT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
