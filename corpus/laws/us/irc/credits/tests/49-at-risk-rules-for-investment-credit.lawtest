}

test "S49-07-FINANCING-ABOVE-BASE-FLOORS-AT-ZERO" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credit_base_49(entity_ref("urn:test:49:w7#t"), entity_ref("urn:test:49:w7#p"), entity_ref("urn:test:49:w7#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": nonrecourse_financing_item_49(entity_ref("urn:test:49:w7#p"), entity_ref("urn:test:49:w7#i"), 1200000.00 USD) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:49:w7#t"), entity_ref("urn:test:49:w7#p")) { origin case_input; }
        assert "f3": property_acquired_from_unrelated_person_49(entity_ref("urn:test:49:w7#p")) { origin case_input; }
    }
    // the reduction cannot make the base negative.
    evaluate truth(reduced_credit_base_49(entity_ref("urn:test:49:w7#t"), entity_ref("urn:test:49:w7#p"), entity_ref("urn:test:49:w7#y"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

