        }
        assert "f0": net_decrease_of_nonqualified_financing_49(entity_ref("urn:test:49:w8#t"), entity_ref("urn:test:49:w8#p"), entity_ref("urn:test:49:w8#y"), 150000.00 USD) { origin case_input; }
    }
    // (a)(2)(A): the credit base increases by the net decrease.
    evaluate truth(credit_base_after_decrease_49(entity_ref("urn:test:49:w8#t"), entity_ref("urn:test:49:w8#p"), entity_ref("urn:test:49:w8#y"), 150000.00 USD));
    expect truth_status == TRUE_ONLY;
}

