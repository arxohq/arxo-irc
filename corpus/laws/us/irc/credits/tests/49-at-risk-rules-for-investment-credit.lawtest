        assert "f1": nonrecourse_financing_item_49(entity_ref("urn:test:49:w6#p"), entity_ref("urn:test:49:w6#i"), 200000.00 USD) { origin case_input; }
        assert "f2": property_acquired_from_unrelated_person_49(entity_ref("urn:test:49:w6#p")) { origin case_input; }
    }
    // (a)(1)(B): only a section 465 taxpayer and activity.
    evaluate truth(reduced_credit_base_49(entity_ref("urn:test:49:w6#t"), entity_ref("urn:test:49:w6#p"), entity_ref("urn:test:49:w6#y"), 1000000.00 USD));
