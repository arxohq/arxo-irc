// Section 49 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S49-01-NONQUALIFIED-FINANCING-REDUCES-CREDIT-BASE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credit_base_49(entity_ref("urn:test:49:w1#t"), entity_ref("urn:test:49:w1#p"), entity_ref("urn:test:49:w1#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": nonrecourse_financing_item_49(entity_ref("urn:test:49:w1#p"), entity_ref("urn:test:49:w1#i"), 200000.00 USD) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:49:w1#t"), entity_ref("urn:test:49:w1#p")) { origin case_input; }
        assert "f3": property_acquired_from_unrelated_person_49(entity_ref("urn:test:49:w1#p")) { origin case_input; }
    }
    // The lender is not asserted as a qualified person: the 200,000 is nonqualified; 1,000,000 - 200,000.
    evaluate truth(reduced_credit_base_49(entity_ref("urn:test:49:w1#t"), entity_ref("urn:test:49:w1#p"), entity_ref("urn:test:49:w1#y"), 800000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S49-02-QUALIFIED-COMMERCIAL-FINANCING-NO-REDUCTION" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credit_base_49(entity_ref("urn:test:49:w2#t"), entity_ref("urn:test:49:w2#p"), entity_ref("urn:test:49:w2#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": nonrecourse_financing_item_49(entity_ref("urn:test:49:w2#p"), entity_ref("urn:test:49:w2#i"), 500000.00 USD) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:49:w2#t"), entity_ref("urn:test:49:w2#p")) { origin case_input; }
        assert "f3": property_acquired_from_unrelated_person_49(entity_ref("urn:test:49:w2#p")) { origin case_input; }
        assert "f4": lender_is_qualified_person_or_government_49(entity_ref("urn:test:49:w2#i")) { origin case_input; }
    }
    // Unrelated seller, 500,000 <= 80% of 1,000,000, qualified lender, not convertible.
    evaluate truth(reduced_credit_base_49(entity_ref("urn:test:49:w2#t"), entity_ref("urn:test:49:w2#p"), entity_ref("urn:test:49:w2#y"), 1000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S49-03-FINANCING-ABOVE-80-PERCENT-NONQUALIFIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credit_base_49(entity_ref("urn:test:49:w3#t"), entity_ref("urn:test:49:w3#p"), entity_ref("urn:test:49:w3#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": nonrecourse_financing_item_49(entity_ref("urn:test:49:w3#p"), entity_ref("urn:test:49:w3#i"), 900000.00 USD) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:49:w3#t"), entity_ref("urn:test:49:w3#p")) { origin case_input; }
        assert "f3": property_acquired_from_unrelated_person_49(entity_ref("urn:test:49:w3#p")) { origin case_input; }
        assert "f4": lender_is_qualified_person_or_government_49(entity_ref("urn:test:49:w3#i")) { origin case_input; }
    }
    // (D)(ii)(II): 900,000 exceeds 80% of the credit base.
    evaluate truth(reduced_credit_base_49(entity_ref("urn:test:49:w3#t"), entity_ref("urn:test:49:w3#p"), entity_ref("urn:test:49:w3#y"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S49-04-CONVERTIBLE-DEBT-NONQUALIFIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credit_base_49(entity_ref("urn:test:49:w4#t"), entity_ref("urn:test:49:w4#p"), entity_ref("urn:test:49:w4#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": nonrecourse_financing_item_49(entity_ref("urn:test:49:w4#p"), entity_ref("urn:test:49:w4#i"), 500000.00 USD) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:49:w4#t"), entity_ref("urn:test:49:w4#p")) { origin case_input; }
        assert "f3": property_acquired_from_unrelated_person_49(entity_ref("urn:test:49:w4#p")) { origin case_input; }
        assert "f4": lender_is_qualified_person_or_government_49(entity_ref("urn:test:49:w4#i")) { origin case_input; }
        assert "f5": financing_is_convertible_debt_49(entity_ref("urn:test:49:w4#i")) { origin case_input; }
    }
    // (D)(ii): convertible debt is not qualified commercial financing.
    evaluate truth(reduced_credit_base_49(entity_ref("urn:test:49:w4#t"), entity_ref("urn:test:49:w4#p"), entity_ref("urn:test:49:w4#y"), 500000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S49-05-SELLER-RELATED-PROPERTY-NOT-UNRELATED-NONQUALIFIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credit_base_49(entity_ref("urn:test:49:w5#t"), entity_ref("urn:test:49:w5#p"), entity_ref("urn:test:49:w5#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": nonrecourse_financing_item_49(entity_ref("urn:test:49:w5#p"), entity_ref("urn:test:49:w5#i"), 500000.00 USD) { origin case_input; }
        assert "f2": taxpayer_and_activity_subject_to_465_49(entity_ref("urn:test:49:w5#t"), entity_ref("urn:test:49:w5#p")) { origin case_input; }
        assert "f3": lender_is_qualified_person_or_government_49(entity_ref("urn:test:49:w5#i")) { origin case_input; }
    }
    // (D)(ii)(I): acquired from a person who is not a related person is required.
    evaluate truth(reduced_credit_base_49(entity_ref("urn:test:49:w5#t"), entity_ref("urn:test:49:w5#p"), entity_ref("urn:test:49:w5#y"), 500000.00 USD));
    expect truth_status == TRUE_ONLY;
}

