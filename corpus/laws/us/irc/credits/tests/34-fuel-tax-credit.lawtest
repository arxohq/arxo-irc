// Section 34 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S34-01-SUM-OF-6420-6421-6427-AMOUNTS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": amount_payable_under_6420_34(entity_ref("urn:test:34:w1#t"), entity_ref("urn:test:34:w1#y"), 1000.00 USD) { origin case_input; }
        assert "f1": amount_payable_under_6421_34(entity_ref("urn:test:34:w1#t"), entity_ref("urn:test:34:w1#y"), 2000.00 USD) { origin case_input; }
        assert "f2": amount_payable_under_6427_34(entity_ref("urn:test:34:w1#t"), entity_ref("urn:test:34:w1#y"), 3000.00 USD) { origin case_input; }
    }
    // (a): 1,000 + 2,000 + 3,000.
    evaluate truth(fuel_tax_credit_34(entity_ref("urn:test:34:w1#t"), entity_ref("urn:test:34:w1#y"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S34-02-CLAIM-PAYABLE-NOW-ONLY-6420-CREDITED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": amount_payable_under_6420_34(entity_ref("urn:test:34:w2#t"), entity_ref("urn:test:34:w2#y"), 1000.00 USD) { origin case_input; }
        assert "f1": amount_payable_under_6421_34(entity_ref("urn:test:34:w2#t"), entity_ref("urn:test:34:w2#y"), 2000.00 USD) { origin case_input; }
        assert "f2": amount_payable_under_6427_34(entity_ref("urn:test:34:w2#t"), entity_ref("urn:test:34:w2#y"), 3000.00 USD) { origin case_input; }
        assert "f3": claim_timely_filed_and_payable_now_34(entity_ref("urn:test:34:w2#t"), entity_ref("urn:test:34:w2#y")) { origin case_input; }
    }
    // (b): the section 6421 and 6427 amounts claimed and payable now are not credited.
    evaluate truth(fuel_tax_credit_34(entity_ref("urn:test:34:w2#t"), entity_ref("urn:test:34:w2#y"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}
