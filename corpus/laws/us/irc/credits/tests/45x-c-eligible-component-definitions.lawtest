// Section 45X(c) definitions of eligible components and 45X(d) special rules scenarios (stage 2e). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45XC-01-CENTRAL-INVERTER-ABOVE-1000-KW" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(entity_ref("urn:test:s45xc:w1#c")) { origin case_input; }
        assert "f1": suitable_for_large_utility_scale_systems_45xc(entity_ref("urn:test:s45xc:w1#c")) { origin case_input; }
        assert "f2": inverter_capacity_kw_ac_45xc(entity_ref("urn:test:s45xc:w1#c"), 1000.1) { origin case_input; }
    }
    // (c)(2)(B): suitable for large utility-scale systems and greater than 1,000 kW.
    evaluate truth(component_is_inverter_class_45xc(entity_ref("urn:test:s45xc:w1#c"), Central));
    expect truth_status == TRUE_ONLY;
}

