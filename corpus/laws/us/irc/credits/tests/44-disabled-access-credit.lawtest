// Section 44 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S44-01-CREDIT-WITHIN-RANGE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_small_business_44(entity_ref("urn:test:s44:w1#t"), entity_ref("urn:test:s44:w1#y1")) { origin case_input; }
        assert "f2": eligible_access_expenditure(entity_ref("urn:test:s44:w1#t"), entity_ref("urn:test:s44:w1#y1"), 5250.00 USD) { origin case_input; }
    }
    // (min(5250,10250)-250)=5000; 50%*5000=2500.
    evaluate truth(disabled_access_credit(entity_ref("urn:test:s44:w1#t"), entity_ref("urn:test:s44:w1#y1"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S44-02-CREDIT-CAPPED-AT-10250-CEILING" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_small_business_44(entity_ref("urn:test:s44:w2#t"), entity_ref("urn:test:s44:w2#y1")) { origin case_input; }
        assert "f2": eligible_access_expenditure(entity_ref("urn:test:s44:w2#t"), entity_ref("urn:test:s44:w2#y1"), 20000.00 USD) { origin case_input; }
    }
    // (min(20000,10250)-250)=10000; 50%*10000=5000.
    evaluate truth(disabled_access_credit(entity_ref("urn:test:s44:w2#t"), entity_ref("urn:test:s44:w2#y1"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S44-03-SIZE-TEST-MET-BY-EMPLOYEE-COUNT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": full_time_employees_preceding_year_44(entity_ref("urn:test:s44:w3#t"), entity_ref("urn:test:s44:w3#y1"), 25.0) { origin case_input; }
    }
    evaluate truth(eligible_small_business_size_test_44(entity_ref("urn:test:s44:w3#t"), entity_ref("urn:test:s44:w3#y1")));
    expect truth_status == TRUE_ONLY;
}

test "S44-04-NOT-ELECTED-NO-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": gross_receipts_preceding_year_44(entity_ref("urn:test:s44:w4#t"), entity_ref("urn:test:s44:w4#y1"), 500000.00 USD) { origin case_input; }
        assert "f2": eligible_access_expenditure(entity_ref("urn:test:s44:w4#t"), entity_ref("urn:test:s44:w4#y1"), 5000.00 USD) { origin case_input; }
    }
    // size test met but no election exercised — eligible_small_business_44 NEITHER, so the credit rule cannot fire.
    evaluate truth(disabled_access_credit(entity_ref("urn:test:s44:w4#t"), entity_ref("urn:test:s44:w4#y1"), 0 USD));
    expect truth_status == NEITHER;
}
