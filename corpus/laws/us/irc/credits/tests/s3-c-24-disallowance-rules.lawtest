// Credits stage 3: section 24(g)(1)(B) and (g)(2) disallowance derived from final determinations.
// NOT EXECUTED: status implemented_unverified. Expectations come from the pinned statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S3 24g fraud year plus 10 disallowed" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s3 24g fraud year plus 10 disallowed#y0"), @2015-01-01) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s3 24g fraud year plus 10 disallowed#y1"), @2025-01-01) { origin case_input; }
        assert "f2": fraud_final_determination_year_24g(entity_ref("urn:test:s3 24g fraud year plus 10 disallowed#p"), entity_ref("urn:test:s3 24g fraud year plus 10 disallowed#y0")) { origin case_input; }
    }
    evaluate truth(disallowed_by_final_determination_24g(entity_ref("urn:test:s3 24g fraud year plus 10 disallowed#p"), entity_ref("urn:test:s3 24g fraud year plus 10 disallowed#y1")));
    expect truth_status == TRUE_ONLY;
}

