    }
    // (d)(1): 2,200,000 x 5.
    evaluate truth(zero_emission_nuclear_power_production_credit_of_facility_45u(entity_ref("urn:test:45u:w2#f"), entity_ref("urn:test:45u:w2#y"), 11000000.00 USD));
