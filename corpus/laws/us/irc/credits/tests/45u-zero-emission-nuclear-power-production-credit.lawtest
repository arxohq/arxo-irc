// Section 45U scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45U-01-CREDIT-NET-OF-REDUCTION-AMOUNT" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": nuclear_facility_owned_by_taxpayer_45u(entity_ref("urn:test:45u:w1#f"), entity_ref("urn:test:45u:w1#t")) { origin case_input; }
        assert "f1": facility_placed_in_service_on_45u(entity_ref("urn:test:45u:w1#f"), @2010-01-01) { origin case_input; }
        assert "f2": section_45u_enacted_on(@2022-08-16) { origin case_input; }
        assert "f3": paragraph_c3_enacted_on_45u(@2025-07-04) { origin case_input; }
        assert "f4": kilowatt_hours_sold_45u(entity_ref("urn:test:45u:w1#f"), entity_ref("urn:test:45u:w1#y"), 1000000000.0) { origin case_input; }
        assert "f5": gross_receipts_from_electricity_45u(entity_ref("urn:test:45u:w1#f"), entity_ref("urn:test:45u:w1#y"), 30000000.00 USD) { origin case_input; }
        assert "f6": inflation_adjustment_factor_45u(entity_ref("urn:test:45u:w1#y"), 1.0) { origin case_input; }
        assert "f7": us.irc.core::begins(entity_ref("urn:test:45u:w1#y"), @2024-01-01) { origin case_input; }
    }
    // product 0.3 cents x 1e9 kWh = 3,000,000; 16% of (30,000,000 - 25,000,000) = 800,000; credit 2,200,000.
    evaluate truth(zero_emission_nuclear_power_production_credit_of_facility_45u(entity_ref("urn:test:45u:w1#f"), entity_ref("urn:test:45u:w1#y"), 2200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

