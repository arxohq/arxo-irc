// Section 25E scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S25E-01-CREDIT-CAPPED-AT-4000" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": vehicle_model_year_25e(entity_ref("urn:test:25e:w1#v"), 2020) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:25e:w1#y"), 2024) { origin case_input; }
        assert "f2": acquisition_date_25e(entity_ref("urn:test:25e:w1#t"), entity_ref("urn:test:25e:w1#v"), @2024-05-01) { origin case_input; }
        assert "f3": original_use_commenced_with_other_person_25e(entity_ref("urn:test:25e:w1#v"), entity_ref("urn:test:25e:w1#t")) { origin case_input; }
        assert "f4": sold_by_dealer_25e(entity_ref("urn:test:25e:w1#v")) { origin case_input; }
        assert "f5": sale_price_25e(entity_ref("urn:test:25e:w1#v"), 20000.00 USD) { origin case_input; }
        assert "f6": first_transfer_to_qualified_buyer_25e(entity_ref("urn:test:25e:w1#v"), entity_ref("urn:test:25e:w1#t")) { origin case_input; }
        assert "f7": meets_30d_vehicle_requirements_25e(entity_ref("urn:test:25e:w1#v")) { origin case_input; }
        assert "f8": purchases_for_use_not_resale_25e(entity_ref("urn:test:25e:w1#t"), entity_ref("urn:test:25e:w1#v")) { origin case_input; }
        assert "f9": modified_agi_25e(entity_ref("urn:test:25e:w1#t"), entity_ref("urn:test:25e:w1#y"), 60000.00 USD) { origin case_input; }
        assert "f10": modified_agi_preceding_year_25e(entity_ref("urn:test:25e:w1#t"), entity_ref("urn:test:25e:w1#y"), 70000.00 USD) { origin case_input; }
        assert "f11": us.irc.income_individual::filing_status(entity_ref("urn:test:25e:w1#t"), entity_ref("urn:test:25e:w1#y"), Unmarried) { origin case_input; }
        assert "f12": vin_included_on_return_25e(entity_ref("urn:test:25e:w1#t"), entity_ref("urn:test:25e:w1#v"), entity_ref("urn:test:25e:w1#y")) { origin case_input; }
    }
    // 30% of 20,000 = 6,000; the lesser is ,000.
    evaluate truth(previously_owned_clean_vehicle_credit(entity_ref("urn:test:25e:w1#t"), entity_ref("urn:test:25e:w1#v"), entity_ref("urn:test:25e:w1#y"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
}

