test "S40AD-01-BIODIESEL-DEFINED" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": monoalkyl_esters_from_plant_or_animal_matter_40a(entity_ref("urn:test:s40ad:w1#fu")) { origin case_input; }
        assert "f1": meets_epa_registration_40a(entity_ref("urn:test:s40ad:w1#fu")) { origin case_input; }
        assert "f2": meets_astm_d6751_40a(entity_ref("urn:test:s40ad:w1#fu")) { origin case_input; }
    }
    evaluate truth(biodiesel_defined_40a(entity_ref("urn:test:s40ad:w1#fu")));
    expect truth_status == TRUE_ONLY;
}

