        assert "f1": biodiesel_certification_obtained(entity_ref("urn:test:s40ad:w18#t"), entity_ref("urn:test:s40ad:w18#y")) { origin case_input; }
        assert "f2": biodiesel_used_in_qualified_mixture_gallons(entity_ref("urn:test:s40ad:w18#t"), entity_ref("urn:test:s40ad:w18#y"), 1000.0) { origin case_input; }
