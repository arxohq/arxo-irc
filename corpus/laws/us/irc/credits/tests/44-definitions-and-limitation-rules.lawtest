test "S44D-01-BARRIER-REMOVAL-AT-OLD-FACILITY-REASONABLE-PART" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gross_receipts_preceding_year_44(entity_ref("urn:test:s44d:w1#t"), entity_ref("urn:test:s44d:w1#y"), 800000.00 USD) { origin case_input; }
        assert "f1": elects_section_44(entity_ref("urn:test:s44d:w1#t"), entity_ref("urn:test:s44d:w1#y")) { origin case_input; }
        assert "f2": purpose_to_comply_with_ada_44(entity_ref("urn:test:s44d:w1#i1")) { origin case_input; }
        assert "f3": reasonable_and_necessary_part_44(entity_ref("urn:test:s44d:w1#i1"), 6000.00 USD) { origin case_input; }
        assert "f4": taxpayer_establishes_standards_met_44(entity_ref("urn:test:s44d:w1#i1")) { origin case_input; }
        assert "f5": access_expenditure_item_44(entity_ref("urn:test:s44d:w1#t"), entity_ref("urn:test:s44d:w1#i1"), entity_ref("urn:test:s44d:w1#y"), BarrierRemoval, 8000.00 USD) { origin case_input; }
        assert "f6": facility_first_placed_in_service_on_44(entity_ref("urn:test:s44d:w1#i1"), @1990-11-05) { origin case_input; }
        assert "f7": section_44_enacted_on_44(@1990-11-05) { origin case_input; }
    }
    evaluate truth(eligible_access_expenditure_defined_44(entity_ref("urn:test:s44d:w1#t"), entity_ref("urn:test:s44d:w1#i1"), entity_ref("urn:test:s44d:w1#y"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

