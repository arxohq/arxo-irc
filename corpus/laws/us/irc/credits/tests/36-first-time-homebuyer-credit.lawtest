    }
    // (c)(3)(A): not from a related person, basis not carried over.
    evaluate truth(qualifying_purchase_36(entity_ref("urn:test:s36:w2#i"), entity_ref("urn:test:s36:w2#r")));
    expect truth_status == TRUE_ONLY;
}

