        assert "f11": adjusted_basis_at_sale_36(entity_ref("urn:test:s36:w53#i"), entity_ref("urn:test:s36:w53#r"), 98000.00 USD) { origin case_input; }
    }
    // (f)(3): a sale with no gain: the increase is limited to zero.
    evaluate truth(disposition_recapture_36(entity_ref("urn:test:s36:w53#i"), entity_ref("urn:test:s36:w53#r"), entity_ref("urn:test:s36:w53#y13"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

