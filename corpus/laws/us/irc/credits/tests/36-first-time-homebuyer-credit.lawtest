        }
        assert "f0": individual_purchases_residence_36(entity_ref("urn:test:s36:w20#i"), entity_ref("urn:test:s36:w20#r")) { origin case_input; }
        assert "f1": acquisition_date_36(entity_ref("urn:test:s36:w20#i"), entity_ref("urn:test:s36:w20#r"), @2009-06-15) { origin case_input; }
        assert "f2": adjusted_basis_on_purchase_date_36(entity_ref("urn:test:s36:w20#r"), 200000.00 USD) { origin case_input; }
    }
    // (g): a purchase after December 31, 2008 within the window: the power is ACTIVE.
    evaluate positions();
    expect position(Section36GElection, ACTIVE);
}

