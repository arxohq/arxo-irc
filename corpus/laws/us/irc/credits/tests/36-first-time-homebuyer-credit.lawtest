// Section 36 first-time homebuyer credit scenarios (stage 2e). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S36-01-PURCHASE-PRICE-IS-ADJUSTED-BASIS-ON-PURCHASE-DATE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": adjusted_basis_on_purchase_date_36(entity_ref("urn:test:s36:w1#r"), 200000.00 USD) { origin case_input; }
    }
    // (c)(4): the purchase price is the adjusted basis on the purchase date.
    evaluate truth(purchase_price_36(entity_ref("urn:test:s36:w1#r"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S36-02-ACQUISITION-FROM-UNRELATED-PERSON-IS-A-PURCHASE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
