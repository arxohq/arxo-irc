            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": individual_purchases_residence_36(entity_ref("urn:test:s36:w5#i"), entity_ref("urn:test:s36:w5#r")) { origin case_input; }
        assert "f1": acquisition_date_36(entity_ref("urn:test:s36:w5#i"), entity_ref("urn:test:s36:w5#r"), @2008-01-01) { origin case_input; }
        assert "f2": adjusted_basis_on_purchase_date_36(entity_ref("urn:test:s36:w5#r"), 200000.00 USD) { origin case_input; }
        assert "f3": residence_constructed_by_taxpayer_36(entity_ref("urn:test:s36:w5#i"), entity_ref("urn:test:s36:w5#r")) { origin case_input; }
        assert "f4": first_occupancy_date_36(entity_ref("urn:test:s36:w5#i"), entity_ref("urn:test:s36:w5#r"), @2009-03-01) { origin case_input; }
    }
    // (c)(3)(B): a residence constructed by the taxpayer is purchased on the date of first occupancy.
    evaluate truth(purchase_date_36(entity_ref("urn:test:s36:w5#i"), entity_ref("urn:test:s36:w5#r"), @2009-03-01));
    expect truth_status == TRUE_ONLY;
}

