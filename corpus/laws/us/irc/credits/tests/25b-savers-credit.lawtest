// Section 25B scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S25B-01-JOINT-AT-50-PERCENT-BRACKET" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": attained_age_18_close_of_year(entity_ref("urn:test:s25b:w1#p"), entity_ref("urn:test:s25b:w1#y2023")) { origin case_input; }
        assert "f1": retirement_contribution_item(entity_ref("urn:test:s25b:w1#p"), entity_ref("urn:test:s25b:w1#y2023"), ElectiveDeferral, 1000.00 USD) { origin case_input; }
        assert "f2": testing_period_distributions_total(entity_ref("urn:test:s25b:w1#p"), entity_ref("urn:test:s25b:w1#y2023"), 0 USD) { origin case_input; }
        assert "f3": us.irc.income_individual::filing_status(entity_ref("urn:test:s25b:w1#p"), entity_ref("urn:test:s25b:w1#y2023"), us.irc.income_individual::Joint) { origin case_input; }
        // AGI $30,000, exactly at the "not over $30,000" 50 percent bracket.
        assert "f4": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s25b:w1#p"), entity_ref("urn:test:s25b:w1#y2023"), 30000.00 USD) { origin case_input; }
    }
    evaluate truth(savers_credit(entity_ref("urn:test:s25b:w1#p"), entity_ref("urn:test:s25b:w1#y2023"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S25B-02-JOINT-JUST-ABOVE-30000-20-PERCENT-BRACKET" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
