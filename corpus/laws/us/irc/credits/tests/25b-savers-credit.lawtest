        assert "f1": retirement_contribution_item(entity_ref("urn:test:s25b:w2#p"), entity_ref("urn:test:s25b:w2#y2023"), ElectiveDeferral, 1000.00 USD) { origin case_input; }
        assert "f2": testing_period_distributions_total(entity_ref("urn:test:s25b:w2#p"), entity_ref("urn:test:s25b:w2#y2023"), 0 USD) { origin case_input; }
