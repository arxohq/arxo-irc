test "S25B-04-HEAD-OF-HOUSEHOLD-SCALED-BRACKET" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": attained_age_18_close_of_year(entity_ref("urn:test:s25b:w4#p"), entity_ref("urn:test:s25b:w4#y2023")) { origin case_input; }
        assert "f1": retirement_contribution_item(entity_ref("urn:test:s25b:w4#p"), entity_ref("urn:test:s25b:w4#y2023"), ElectiveDeferral, 1000.00 USD) { origin case_input; }
        assert "f2": testing_period_distributions_total(entity_ref("urn:test:s25b:w4#p"), entity_ref("urn:test:s25b:w4#y2023"), 0 USD) { origin case_input; }
        assert "f3": us.irc.income_individual::filing_status(entity_ref("urn:test:s25b:w4#p"), entity_ref("urn:test:s25b:w4#y2023"), us.irc.income_individual::HeadOfHousehold) { origin case_input; }
        // HOH breakpoint is 75% of $30,000 = $22,500; $22,500 exactly -> 50 percent.
        assert "f4": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s25b:w4#p"), entity_ref("urn:test:s25b:w4#y2023"), 22500.00 USD) { origin case_input; }
    }
    evaluate truth(savers_credit(entity_ref("urn:test:s25b:w4#p"), entity_ref("urn:test:s25b:w4#y2023"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S25B-05-CLAIMED-AS-DEPENDENT-INELIGIBLE" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": attained_age_18_close_of_year(entity_ref("urn:test:s25b:w5#p"), entity_ref("urn:test:s25b:w5#y2023")) { origin case_input; }
        assert "f1": claimed_as_dependent_25b(entity_ref("urn:test:s25b:w5#p"), entity_ref("urn:test:s25b:w5#y2023")) { origin case_input; }
    }
    evaluate truth(saver_eligible_individual(entity_ref("urn:test:s25b:w5#p"), entity_ref("urn:test:s25b:w5#y2023")));
    expect truth_status == NEITHER;
}

