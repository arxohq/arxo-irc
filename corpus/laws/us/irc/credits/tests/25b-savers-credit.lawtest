        assert "f4": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s25b:w2#p"), entity_ref("urn:test:s25b:w2#y2023"), 30001.00 USD) { origin case_input; }
    }
    evaluate truth(savers_credit(entity_ref("urn:test:s25b:w2#p"), entity_ref("urn:test:s25b:w2#y2023"), 200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

