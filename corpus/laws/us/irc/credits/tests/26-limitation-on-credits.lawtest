// Section 26 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S26-01-LIMITATION-NOT-BINDING-CREDITS-BELOW-LIABILITY" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": tax_imposed_by_chapter_1(entity_ref("urn:test:s26:w1#p"), entity_ref("urn:test:s26:w1#y2023"), 10000.00 USD) { origin case_input; }
        assert "f1": section_26b2_carveout_amount(entity_ref("urn:test:s26:w1#p"), entity_ref("urn:test:s26:w1#y2023"), 0 USD) { origin case_input; }
        assert "f2": foreign_tax_credit_27(entity_ref("urn:test:s26:w1#p"), entity_ref("urn:test:s26:w1#y2023"), 0 USD) { origin case_input; }
        assert "f3": section_55a_tax_26a(entity_ref("urn:test:s26:w1#p"), entity_ref("urn:test:s26:w1#y2023"), 0 USD) { origin case_input; }
    }
    // limitation = regular tax liability $10,000 (no FTC, no AMT).
    evaluate truth(section_26a_limitation(entity_ref("urn:test:s26:w1#p"), entity_ref("urn:test:s26:w1#y2023"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S26-02-LIMITATION-BINDING-CREDITS-EXCEED-LIABILITY" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": tax_imposed_by_chapter_1(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023"), 500.00 USD) { origin case_input; }
        assert "f1": section_26b2_carveout_amount(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023"), 0 USD) { origin case_input; }
        assert "f2": foreign_tax_credit_27(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023"), 0 USD) { origin case_input; }
        assert "f3": section_55a_tax_26a(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023"), 0 USD) { origin case_input; }
        // Elderly credit of $2,000 exceeds the $500 limitation.
        assert "f4": elderly_or_disabled_qualified_individual(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023")) { origin case_input; }
        assert "f5": section_22_amount(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023"), 13333.33 USD) { origin case_input; }
        assert "f6": section_22_joint_return_condition_met(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023")) { origin case_input; }
        assert "f7": us.irc.income_individual::filing_status(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
    }
    // section_22_amount * 15% ~= $2,000; the limitation caps the total at $500.
    evaluate truth(nonrefundable_credits_total(entity_ref("urn:test:s26:w2#p"), entity_ref("urn:test:s26:w2#y2023"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S26-03-FOREIGN-TAX-CREDIT-REDUCES-LIMITATION" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": tax_imposed_by_chapter_1(entity_ref("urn:test:s26:w3#p"), entity_ref("urn:test:s26:w3#y2023"), 10000.00 USD) { origin case_input; }
        assert "f1": section_26b2_carveout_amount(entity_ref("urn:test:s26:w3#p"), entity_ref("urn:test:s26:w3#y2023"), 0 USD) { origin case_input; }
        assert "f2": foreign_tax_credit_27(entity_ref("urn:test:s26:w3#p"), entity_ref("urn:test:s26:w3#y2023"), 3000.00 USD) { origin case_input; }
        assert "f3": section_55a_tax_26a(entity_ref("urn:test:s26:w3#p"), entity_ref("urn:test:s26:w3#y2023"), 0 USD) { origin case_input; }
    }
    evaluate truth(section_26a_limitation(entity_ref("urn:test:s26:w3#p"), entity_ref("urn:test:s26:w3#y2023"), 7000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S26-04-UNKNOWN-TAX-LIABILITY-UNDETERMINED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        // No tax_imposed_by_chapter_1 asserted.
    }
    evaluate truth(section_26a_limitation(entity_ref("urn:test:s26:w4#p"), entity_ref("urn:test:s26:w4#y2023"), 0 USD));
    expect truth_status == NEITHER;
}
