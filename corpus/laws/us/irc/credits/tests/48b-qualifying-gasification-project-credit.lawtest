// Section 48B scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S48B-01-STANDARD-20-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": project_employs_gasification_technology_48b(entity_ref("urn:test:48b:w1#p")) { origin case_input; }
        assert "f1": carried_out_by_eligible_entity_48b(entity_ref("urn:test:48b:w1#p")) { origin case_input; }
        assert "f2": gasification_recipient_documented_requirements_48b(entity_ref("urn:test:48b:w1#p")) { origin case_input; }
        assert "f3": secretary_makes_competitive_award_48b(entity_ref("urn:test:48b:w1#p"), entity_ref("urn:test:48b:w1#a"), @2008-06-01) { origin case_input; }
        assert "f4": certificate_of_eligibility_issued_on_48b(entity_ref("urn:test:48b:w1#p"), @2008-06-01) { origin case_input; }
        assert "f5": certified_qualified_investment_48b(entity_ref("urn:test:48b:w1#p"), 100000000.00 USD) { origin case_input; }
        assert "f6": qualified_investment_48b(entity_ref("urn:test:48b:w1#t"), entity_ref("urn:test:48b:w1#p"), entity_ref("urn:test:48b:w1#y"), 50000000.00 USD) { origin case_input; }
    }
    // 20% of 50,000,000 within the certified 100,000,000.
    evaluate truth(gasification_credit_per_project_48b(entity_ref("urn:test:48b:w1#t"), entity_ref("urn:test:48b:w1#p"), entity_ref("urn:test:48b:w1#y"), 10000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

