test "S48B-05-AWARD-WITHOUT-DOCUMENTATION-PROHIBITION-VIOLATED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": secretary_makes_competitive_award_48b(entity_ref("urn:test:48b:w5#p"), entity_ref("urn:test:48b:w5#a"), @2008-06-01) { origin case_input; }
    }
    // The Secretary made an award; the recipient documentation of (d)(3)(A)-(F) is not asserted.
    evaluate positions();
    expect position(Section48bD3AwardProhibition, VIOLATED);
}

test "S48B-06-AWARD-WITH-DOCUMENTATION-NOT-VIOLATED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": secretary_makes_competitive_award_48b(entity_ref("urn:test:48b:w6#p"), entity_ref("urn:test:48b:w6#a"), @2008-06-01) { origin case_input; }
        assert "f1": gasification_recipient_documented_requirements_48b(entity_ref("urn:test:48b:w6#p")) { origin case_input; }
    }
    // With the documentation the prohibition is not violated.
    evaluate positions();
    expect not position(Section48bD3AwardProhibition, VIOLATED);
}

test "S48B-07-CREDIT-ALLOWED-UNDER-48A-EXCLUDES-48B" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": project_employs_gasification_technology_48b(entity_ref("urn:test:48b:w7#p")) { origin case_input; }
        assert "f1": carried_out_by_eligible_entity_48b(entity_ref("urn:test:48b:w7#p")) { origin case_input; }
        assert "f2": gasification_recipient_documented_requirements_48b(entity_ref("urn:test:48b:w7#p")) { origin case_input; }
        assert "f3": secretary_makes_competitive_award_48b(entity_ref("urn:test:48b:w7#p"), entity_ref("urn:test:48b:w7#a"), @2008-06-01) { origin case_input; }
        assert "f4": certificate_of_eligibility_issued_on_48b(entity_ref("urn:test:48b:w7#p"), @2008-06-01) { origin case_input; }
        assert "f5": certified_qualified_investment_48b(entity_ref("urn:test:48b:w7#p"), 100000000.00 USD) { origin case_input; }
        assert "f6": qualified_investment_48b(entity_ref("urn:test:48b:w7#t"), entity_ref("urn:test:48b:w7#p"), entity_ref("urn:test:48b:w7#y"), 50000000.00 USD) { origin case_input; }
        assert "f7": credit_allowed_under_48a_for_investment_48b(entity_ref("urn:test:48b:w7#t"), entity_ref("urn:test:48b:w7#p"), entity_ref("urn:test:48b:w7#y")) { origin case_input; }
    }
    // (e): no credit for an investment for which section 48A allows a credit.
    evaluate truth(gasification_credit_per_project_48b(entity_ref("urn:test:48b:w7#t"), entity_ref("urn:test:48b:w7#p"), entity_ref("urn:test:48b:w7#y"), 10000000.00 USD));
    expect truth_status == NEITHER;
}

