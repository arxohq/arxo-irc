test "S25DD-01-SOLAR-WATER-HEATING-HALF-SOLAR" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": installed_in_us_dwelling_used_as_residence_25d(entity_ref("urn:test:s25dd:w1#t"), entity_ref("urn:test:s25dd:w1#pr")) { origin case_input; }
        assert "f1": expenditure_for_property_25d(entity_ref("urn:test:s25dd:w1#t"), entity_ref("urn:test:s25dd:w1#pr"), 20000.00 USD) { origin case_input; }
        assert "f2": property_kind_25d(entity_ref("urn:test:s25dd:w1#pr"), SolarWaterHeating) { origin case_input; }
        assert "f3": energy_share_derived_from_sun_25d(entity_ref("urn:test:s25dd:w1#pr"), 0.50) { origin case_input; }
    }
    evaluate truth(qualified_expenditure_25d(entity_ref("urn:test:s25dd:w1#t"), entity_ref("urn:test:s25dd:w1#pr"), SolarWaterHeating, 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}

