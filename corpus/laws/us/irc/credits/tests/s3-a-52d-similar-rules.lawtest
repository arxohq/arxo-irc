            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": clean_fuel_production_credit(entity_ref("urn:test:s3 45zf4 wrong amount#e"), entity_ref("urn:test:s3 45zf4 wrong amount#y"), 1000.00 USD) { origin case_input; }
        assert "f1": section_52d_income_allocable_share(entity_ref("urn:test:s3 45zf4 wrong amount#e"), entity_ref("urn:test:s3 45zf4 wrong amount#b"), entity_ref("urn:test:s3 45zf4 wrong amount#y"), 0.5) { origin case_input; }
    }
    evaluate truth(clean_fuel_credit_apportioned_45Zf4(entity_ref("urn:test:s3 45zf4 wrong amount#e"), entity_ref("urn:test:s3 45zf4 wrong amount#b"), entity_ref("urn:test:s3 45zf4 wrong amount#y"), 600.00 USD));
    expect truth_status == NEITHER;
}

test "S3 45Zf4 no share" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": clean_fuel_production_credit(entity_ref("urn:test:s3 45zf4 no share#e"), entity_ref("urn:test:s3 45zf4 no share#y"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(clean_fuel_credit_apportioned_45Zf4(entity_ref("urn:test:s3 45zf4 no share#e"), entity_ref("urn:test:s3 45zf4 no share#b"), entity_ref("urn:test:s3 45zf4 no share#y"), 500.00 USD));
    expect truth_status == NEITHER;
}

