// Credits stage 3: rules similar to section 52(d) in 40(d)(5), 40A(d)(4), 45F(e)(2), 45K(d)(8), 45Y(g)(5), 45Z(f)(4).
// NOT EXECUTED: status implemented_unverified. Expectations come from the pinned statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S3 40d5 half" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": alcohol_fuels_credit(entity_ref("urn:test:s3 40d5 half#e"), entity_ref("urn:test:s3 40d5 half#y"), 1000.00 USD) { origin case_input; }
        assert "f1": section_52d_income_allocable_share(entity_ref("urn:test:s3 40d5 half#e"), entity_ref("urn:test:s3 40d5 half#b"), entity_ref("urn:test:s3 40d5 half#y"), 0.5) { origin case_input; }
    }
    evaluate truth(alcohol_fuels_credit_apportioned_40d5(entity_ref("urn:test:s3 40d5 half#e"), entity_ref("urn:test:s3 40d5 half#b"), entity_ref("urn:test:s3 40d5 half#y"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

