// Section 42(i)(2)-(9), (j), (k), (l), (m) scenarios (stage 2e).
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S42E-01-NEW-BUILDING-ORIGINAL-USE-BEGINS-WITH-TAXPAYER" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": original_use_begins_with_taxpayer_42(entity_ref("urn:test:42e:w1#b"), entity_ref("urn:test:42e:w1#t")) { origin case_input; }
    }
    // (i)(4): original use begins with the taxpayer.
    evaluate truth(new_building_42(entity_ref("urn:test:42e:w1#b"), entity_ref("urn:test:42e:w1#t")));
    expect truth_status == TRUE_ONLY;
}

