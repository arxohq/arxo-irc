test "S42E-04-NEW-BUILDING-WITH-PRIOR-YEAR-TAX-EXEMPT-OBLIGATION-FEDERALLY-SUBSIDIZED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": low_income_housing_building_owned_by(entity_ref("urn:test:42e:w4#b"), entity_ref("urn:test:42e:w4#t")) { origin case_input; }
        assert "f1": original_use_begins_with_taxpayer_42(entity_ref("urn:test:42e:w4#b"), entity_ref("urn:test:42e:w4#t")) { origin case_input; }
        assert "f2": tax_exempt_obligation_outstanding_used_for_building_in_year_42(entity_ref("urn:test:42e:w4#b"), entity_ref("urn:test:42e:w4#y0")) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:42e:w4#y0"), @2018-01-01) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:42e:w4#y"), @2020-01-01) { origin case_input; }
    }
    // (i)(2)(A): a tax-exempt obligation was outstanding in 2018, a prior taxable year: the building is federally subsidized for 2020.
    evaluate truth(federally_subsidized_by_i2_42(entity_ref("urn:test:42e:w4#b"), entity_ref("urn:test:42e:w4#y")));
    expect truth_status == TRUE_ONLY;
}

test "S42E-05-OBLIGATION-OUTSTANDING-ONLY-IN-LATER-YEAR-NOT-SUBSIDIZED-FOR-EARLIER-YEAR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": low_income_housing_building_owned_by(entity_ref("urn:test:42e:w5#b"), entity_ref("urn:test:42e:w5#t")) { origin case_input; }
        assert "f1": original_use_begins_with_taxpayer_42(entity_ref("urn:test:42e:w5#b"), entity_ref("urn:test:42e:w5#t")) { origin case_input; }
        assert "f2": tax_exempt_obligation_outstanding_used_for_building_in_year_42(entity_ref("urn:test:42e:w5#b"), entity_ref("urn:test:42e:w5#y0")) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:42e:w5#y0"), @2022-01-01) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:42e:w5#y"), @2020-01-01) { origin case_input; }
    }
    // (i)(2)(A): "during such taxable year or any prior taxable year": an obligation first outstanding in 2022 does not subsidize 2020.
    evaluate truth(federally_subsidized_by_i2_42(entity_ref("urn:test:42e:w5#b"), entity_ref("urn:test:42e:w5#y")));
    expect truth_status == NEITHER;
}

test "S42E-06-ELECTION-TO-EXCLUDE-PROCEEDS-NOT-SUBSIDIZED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": low_income_housing_building_owned_by(entity_ref("urn:test:42e:w6#b"), entity_ref("urn:test:42e:w6#t")) { origin case_input; }
        assert "f1": original_use_begins_with_taxpayer_42(entity_ref("urn:test:42e:w6#b"), entity_ref("urn:test:42e:w6#t")) { origin case_input; }
        assert "f2": tax_exempt_obligation_outstanding_used_for_building_in_year_42(entity_ref("urn:test:42e:w6#b"), entity_ref("urn:test:42e:w6#y0")) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:42e:w6#y0"), @2018-01-01) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:42e:w6#y"), @2020-01-01) { origin case_input; }
        assert "f5": elects_exclude_tax_exempt_proceeds_from_eligible_basis_42(entity_ref("urn:test:42e:w6#t"), entity_ref("urn:test:42e:w6#b")) { origin case_input; }
    }
    // (i)(2)(B): the taxpayer elects to exclude the proceeds from eligible basis: the obligation is not taken into account.
