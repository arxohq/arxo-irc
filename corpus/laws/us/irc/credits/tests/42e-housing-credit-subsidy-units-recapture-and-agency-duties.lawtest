    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": low_income_housing_building_owned_by(entity_ref("urn:test:42e:w9#b"), entity_ref("urn:test:42e:w9#t")) { origin case_input; }
        assert "f1": original_use_begins_with_taxpayer_42(entity_ref("urn:test:42e:w9#b"), entity_ref("urn:test:42e:w9#t")) { origin case_input; }
        assert "f2": tax_exempt_obligation_outstanding_used_for_building_in_year_42(entity_ref("urn:test:42e:w9#b"), entity_ref("urn:test:42e:w9#y0")) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:42e:w9#y0"), @2018-01-01) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:42e:w9#y"), @2020-01-01) { origin case_input; }
        assert "f5": applicable_percentage_secretary_prescribed(entity_ref("urn:test:42e:w9#b"), entity_ref("urn:test:42e:w9#y"), 0.035) { origin case_input; }
    }
    // (b)(3)/(i)(2): a federally subsidized new building: the Secretary percentage 3.5 percent is raised to the 4 percent floor.
    evaluate truth(applicable_percentage_42b(entity_ref("urn:test:42e:w9#b"), entity_ref("urn:test:42e:w9#y"), 0.04));
    expect truth_status == TRUE_ONLY;
}

