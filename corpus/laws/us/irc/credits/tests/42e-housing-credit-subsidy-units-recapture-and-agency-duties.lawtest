        assert "f1": taxpayer_certification_due_on_42(entity_ref("urn:test:42e:w69#t"), entity_ref("urn:test:42e:w69#b"), @2027-03-31) { origin case_input; }
        assert "f2": information_return_submitted_42(entity_ref("urn:test:42e:w69#t"), entity_ref("urn:test:42e:w69#y")) { origin case_input; }
    }
    // (l)(2): the return is submitted.
