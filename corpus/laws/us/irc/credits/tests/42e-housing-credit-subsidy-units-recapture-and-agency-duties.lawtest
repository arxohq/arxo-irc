        assert "f1": applicable_portion_of_credit_k4_42(entity_ref("urn:test:42e:w74#t"), entity_ref("urn:test:42e:w74#b"), entity_ref("urn:test:42e:w74#y"), 300000.00 USD) { origin case_input; }
        assert "f2": k4_interest_at_underpayment_rate_42(entity_ref("urn:test:42e:w74#t"), entity_ref("urn:test:42e:w74#b"), entity_ref("urn:test:42e:w74#y"), 40000.00 USD) { origin case_input; }
