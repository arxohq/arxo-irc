// Section 45F scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45F-01-BASE-EDITION-25-PLUS-10-PERCENT" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": principal_use_child_care_assistance_45f(entity_ref("urn:test:45f:w1#fa")) { origin case_input; }
        assert "f1": meets_local_law_and_licensing_45f(entity_ref("urn:test:45f:w1#fa")) { origin case_input; }
        assert "f2": enrollment_open_to_employees_45f(entity_ref("urn:test:45f:w1#fa"), entity_ref("urn:test:45f:w1#t"), entity_ref("urn:test:45f:w1#y")) { origin case_input; }
        assert "f3": child_care_expenditure_45f(entity_ref("urn:test:45f:w1#t"), entity_ref("urn:test:45f:w1#y"), entity_ref("urn:test:45f:w1#fa"), 100000.00 USD, 120000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45f:w1#y"), @2025-01-01) { origin case_input; }
        assert "f5": resource_referral_expenditures_45f(entity_ref("urn:test:45f:w1#t"), entity_ref("urn:test:45f:w1#y"), 20000.00 USD) { origin case_input; }
    }
    // 25% of 100,000 + 10% of 20,000 = 27,000 (below the 150,000 limit).
    evaluate truth(employer_provided_child_care_credit(entity_ref("urn:test:45f:w1#t"), entity_ref("urn:test:45f:w1#y"), 27000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45F-02-BASE-EDITION-CAP-150000" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": principal_use_child_care_assistance_45f(entity_ref("urn:test:45f:w2#fa")) { origin case_input; }
        assert "f1": meets_local_law_and_licensing_45f(entity_ref("urn:test:45f:w2#fa")) { origin case_input; }
        assert "f2": enrollment_open_to_employees_45f(entity_ref("urn:test:45f:w2#fa"), entity_ref("urn:test:45f:w2#t"), entity_ref("urn:test:45f:w2#y")) { origin case_input; }
        assert "f3": child_care_expenditure_45f(entity_ref("urn:test:45f:w2#t"), entity_ref("urn:test:45f:w2#y"), entity_ref("urn:test:45f:w2#fa"), 1000000.00 USD, 1000000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45f:w2#y"), @2025-01-01) { origin case_input; }
    }
    // 25% of 1,000,000 = 250,000 limited to 150,000.
    evaluate truth(employer_provided_child_care_credit(entity_ref("urn:test:45f:w2#t"), entity_ref("urn:test:45f:w2#y"), 150000.00 USD));
    expect truth_status == TRUE_ONLY;
}

