    expect truth_status == TRUE_ONLY;
}

test "S45F-07-PRINCIPAL-BUSINESS-FACILITY-BELOW-30-PERCENT-NOT-QUALIFIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": principal_use_child_care_assistance_45f(entity_ref("urn:test:45f:w7#fa")) { origin case_input; }
        assert "f1": meets_local_law_and_licensing_45f(entity_ref("urn:test:45f:w7#fa")) { origin case_input; }
        assert "f2": enrollment_open_to_employees_45f(entity_ref("urn:test:45f:w7#fa"), entity_ref("urn:test:45f:w7#t"), entity_ref("urn:test:45f:w7#y")) { origin case_input; }
        assert "f3": child_care_expenditure_45f(entity_ref("urn:test:45f:w7#t"), entity_ref("urn:test:45f:w7#y"), entity_ref("urn:test:45f:w7#fa"), 100000.00 USD, 120000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:45f:w7#y"), @2025-01-01) { origin case_input; }
        assert "f5": facility_is_principal_business_45f(entity_ref("urn:test:45f:w7#fa"), entity_ref("urn:test:45f:w7#t")) { origin case_input; }
        assert "f6": share_of_enrollees_employee_dependents_45f(entity_ref("urn:test:45f:w7#fa"), entity_ref("urn:test:45f:w7#t"), entity_ref("urn:test:45f:w7#y"), 20.0) { origin case_input; }
    }
    // (c)(2)(B)(ii): a facility that is the principal business needs at least 30% employee dependents.
    evaluate truth(qualified_child_care_facility_45f(entity_ref("urn:test:45f:w7#fa"), entity_ref("urn:test:45f:w7#t"), entity_ref("urn:test:45f:w7#y")));
    expect truth_status == NEITHER;
}

