test "S45F-13-READ-BEFORE-AMENDMENT-2026-YEAR-STILL-25-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": principal_use_child_care_assistance_45f(entity_ref("urn:test:45f:w13#fa")) { origin case_input; }
        assert "f1": meets_local_law_and_licensing_45f(entity_ref("urn:test:45f:w13#fa")) { origin case_input; }
