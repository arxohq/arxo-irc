// Section 36B scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S36B-01-APPLICABLE-TAXPAYER-250-PERCENT-FPL-COVERAGE-MONTH-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": temporary_400_pct_ceiling_removed_36b(entity_ref("urn:test:s36b:w1#y2024")) { origin case_input; }
        assert "f2": household_income(entity_ref("urn:test:s36b:w1#p"), entity_ref("urn:test:s36b:w1#y2024"), 36250.00 USD) { origin case_input; }
        assert "f3": family_size_36b(entity_ref("urn:test:s36b:w1#p"), entity_ref("urn:test:s36b:w1#y2024"), 1.0) { origin case_input; }
        assert "f4": poverty_line_amount(1.0, entity_ref("urn:test:s36b:w1#y2024"), 14500.00 USD) { origin case_input; }
        assert "f5": enrolled_in_exchange_qualified_health_plan(entity_ref("urn:test:s36b:w1#p"), entity_ref("urn:test:s36b:w1#y2024"), @2024-01-01) { origin case_input; }
        assert "f6": monthly_enrollment_premium(entity_ref("urn:test:s36b:w1#p"), @2024-01-01, 500.00 USD) { origin case_input; }
        assert "f7": adjusted_monthly_benchmark_premium(entity_ref("urn:test:s36b:w1#p"), @2024-01-01, 450.00 USD) { origin case_input; }
    }
    // 36250/14500 = 250.0 percent of FPL: applicable percentage = 4 + (6-4)*(2.5-2.5)/... at exact boundary 2.50 -> tier 250-300 rule (>=2.50, <3.00) gives 0.04 exactly.
    evaluate truth(household_income_pct_of_poverty_line(entity_ref("urn:test:s36b:w1#p"), entity_ref("urn:test:s36b:w1#y2024"), 2.50));
    expect truth_status == TRUE_ONLY;
    evaluate truth(applicable_taxpayer(entity_ref("urn:test:s36b:w1#p"), entity_ref("urn:test:s36b:w1#y2024")));
    expect truth_status == TRUE_ONLY;
}

test "S36B-02-DEPENDENT-OF-ANOTHER-TAXPAYER-NOT-APPLICABLE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": household_income(entity_ref("urn:test:s36b:w2#p"), entity_ref("urn:test:s36b:w2#y2024"), 30000.00 USD) { origin case_input; }
        assert "f2": family_size_36b(entity_ref("urn:test:s36b:w2#p"), entity_ref("urn:test:s36b:w2#y2024"), 1.0) { origin case_input; }
        assert "f3": poverty_line_amount(1.0, entity_ref("urn:test:s36b:w2#y2024"), 14500.00 USD) { origin case_input; }
        assert "f4": dependent_of_another_taxpayer_36b(entity_ref("urn:test:s36b:w2#p"), entity_ref("urn:test:s36b:w2#y2024")) { origin case_input; }
    }
    evaluate truth(applicable_taxpayer(entity_ref("urn:test:s36b:w2#p"), entity_ref("urn:test:s36b:w2#y2024")));
    expect truth_status == NEITHER;
}
