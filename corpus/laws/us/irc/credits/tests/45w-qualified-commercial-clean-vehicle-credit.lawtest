        assert "f5": comparable_vehicle_price_45w(entity_ref("urn:test:45w:w11#v"), 50000.00 USD) { origin case_input; }
        assert "f6": vehicle_basis_45w(entity_ref("urn:test:45w:w11#t"), entity_ref("urn:test:45w:w11#v"), entity_ref("urn:test:45w:w11#y"), 80000.00 USD) { origin case_input; }
        assert "f7": vehicle_acquired_on_45w(entity_ref("urn:test:45w:w11#v"), @2025-03-01) { origin case_input; }
        assert "f8": vehicle_identification_number_on_return_45w(entity_ref("urn:test:45w:w11#t"), entity_ref("urn:test:45w:w11#v"), entity_ref("urn:test:45w:w11#y")) { origin case_input; }
        assert "f9": unleased_vehicle_placed_in_service_by_tax_exempt_entity_45w(entity_ref("urn:test:45w:w11#v")) { origin case_input; }
    }
    // (d)(2): subsection (c)(4) does not apply.
    evaluate truth(qualified_commercial_clean_vehicle_45w(entity_ref("urn:test:45w:w11#v")));
    expect truth_status == TRUE_ONLY;
}
