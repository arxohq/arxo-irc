// Section 45W scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45W-01-LIGHT-EV-CAPPED-AT-7500" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": meets_30d_d1c_and_not_for_resale_45w(entity_ref("urn:test:45w:w1#v")) { origin case_input; }
        assert "f1": road_vehicle_under_30d_d1d_45w(entity_ref("urn:test:45w:w1#v")) { origin case_input; }
        assert "f2": vehicle_battery_kwh_45w(entity_ref("urn:test:45w:w1#v"), 40.0) { origin case_input; }
        assert "f3": subject_to_depreciation_45w(entity_ref("urn:test:45w:w1#v")) { origin case_input; }
        assert "f4": vehicle_gvwr_pounds_45w(entity_ref("urn:test:45w:w1#v"), 10000.0) { origin case_input; }
        assert "f5": vehicle_purchase_price_45w(entity_ref("urn:test:45w:w1#v"), 80000.00 USD) { origin case_input; }
        assert "f6": comparable_vehicle_price_45w(entity_ref("urn:test:45w:w1#v"), 50000.00 USD) { origin case_input; }
        assert "f7": vehicle_basis_45w(entity_ref("urn:test:45w:w1#t"), entity_ref("urn:test:45w:w1#v"), entity_ref("urn:test:45w:w1#y"), 80000.00 USD) { origin case_input; }
        assert "f8": vehicle_acquired_on_45w(entity_ref("urn:test:45w:w1#v"), @2025-03-01) { origin case_input; }
        assert "f9": vehicle_identification_number_on_return_45w(entity_ref("urn:test:45w:w1#t"), entity_ref("urn:test:45w:w1#v"), entity_ref("urn:test:45w:w1#y")) { origin case_input; }
    }
    // 30% of 80,000 = 24,000; incremental cost 30,000; cap 7,500 under 14,000 pounds.
    evaluate truth(commercial_clean_vehicle_credit_amount_45w(entity_ref("urn:test:45w:w1#t"), entity_ref("urn:test:45w:w1#v"), entity_ref("urn:test:45w:w1#y"), 7500.00 USD));
    expect truth_status == TRUE_ONLY;
}

