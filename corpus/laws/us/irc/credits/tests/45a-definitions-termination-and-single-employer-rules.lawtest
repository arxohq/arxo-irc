test "S45AD-01-EXCLUSION-PERIOD-1-YEAR-FOR-SECTION-51-WAGES" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employment_began_on_45a(entity_ref("urn:test:s45ad:w1#ee"), entity_ref("urn:test:s45ad:w1#em"), @2025-03-01) { origin case_input; }
        assert "f1": wages_taken_into_account_under_section_51_45a(entity_ref("urn:test:s45ad:w1#em"), entity_ref("urn:test:s45ad:w1#ee")) { origin case_input; }
    }
    evaluate truth(exclusion_period_end_45a(entity_ref("urn:test:s45ad:w1#ee"), entity_ref("urn:test:s45ad:w1#em"), @2026-03-01));
    expect truth_status == TRUE_ONLY;
}

