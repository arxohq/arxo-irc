test "S45A-05-TERMINATION-BEFORE-ONE-YEAR-INCREASES-TAX" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employment_began_on_45a(entity_ref("urn:test:45a:w5#w"), entity_ref("urn:test:45a:w5#e"), @2021-03-01) { origin case_input; }
        assert "f1": employment_terminated_on_45a(entity_ref("urn:test:45a:w5#w"), entity_ref("urn:test:45a:w5#e"), @2021-10-01) { origin case_input; }
        assert "f2": prior_credits_attributable_to_employee_45a(entity_ref("urn:test:45a:w5#e"), entity_ref("urn:test:45a:w5#w"), 2000.00 USD) { origin case_input; }
    }
    // (d)(1): terminated 7 months after start: the prior credits are added to tax.
    evaluate truth(indian_employment_recapture_tax_increase_45a(entity_ref("urn:test:45a:w5#e"), entity_ref("urn:test:45a:w5#w"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
}

