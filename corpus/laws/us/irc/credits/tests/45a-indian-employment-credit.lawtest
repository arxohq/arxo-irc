        assert "f4": wage_ceiling_45a(entity_ref("urn:test:45a:w4#y"), 30000.00 USD) { origin case_input; }
        assert "f5": share_of_wages_for_trade_or_business_45a(entity_ref("urn:test:45a:w4#e"), entity_ref("urn:test:45a:w4#w"), entity_ref("urn:test:45a:w4#y"), 100.0) { origin case_input; }
