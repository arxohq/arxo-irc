// Section 45A scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45A-01-CREDIT-20-PERCENT-OF-EXCESS-OVER-BASE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": enrolled_member_or_spouse_of_indian_tribe_45a(entity_ref("urn:test:45a:w1#w")) { origin case_input; }
        assert "f1": services_substantially_all_within_reservation_45a(entity_ref("urn:test:45a:w1#w"), entity_ref("urn:test:45a:w1#e"), entity_ref("urn:test:45a:w1#y")) { origin case_input; }
        assert "f2": abode_on_or_near_reservation_45a(entity_ref("urn:test:45a:w1#w"), entity_ref("urn:test:45a:w1#y")) { origin case_input; }
        assert "f3": total_wages_paid_to_employee_45a(entity_ref("urn:test:45a:w1#e"), entity_ref("urn:test:45a:w1#w"), entity_ref("urn:test:45a:w1#y"), 25000.00 USD) { origin case_input; }
        assert "f4": wage_ceiling_45a(entity_ref("urn:test:45a:w1#y"), 30000.00 USD) { origin case_input; }
        assert "f5": share_of_wages_for_trade_or_business_45a(entity_ref("urn:test:45a:w1#e"), entity_ref("urn:test:45a:w1#w"), entity_ref("urn:test:45a:w1#y"), 100.0) { origin case_input; }
        assert "f6": qualified_wages_45a(entity_ref("urn:test:45a:w1#e"), entity_ref("urn:test:45a:w1#w"), entity_ref("urn:test:45a:w1#y"), 20000.00 USD) { origin case_input; }
        assert "f7": qualified_health_insurance_costs_45a(entity_ref("urn:test:45a:w1#e"), entity_ref("urn:test:45a:w1#w"), entity_ref("urn:test:45a:w1#y"), 3000.00 USD) { origin case_input; }
        assert "f8": base_period_amount_45a(entity_ref("urn:test:45a:w1#e"), entity_ref("urn:test:45a:w1#w"), 5000.00 USD) { origin case_input; }
        assert "f9": us.irc.core::begins(entity_ref("urn:test:45a:w1#y"), @2021-01-01) { origin case_input; }
    }
    // current 20,000 (wages 20,000 + health 3,000 capped at 20,000), base 5,000: 20% of 15,000 = 3,000.
    evaluate truth(indian_employment_credit(entity_ref("urn:test:45a:w1#e"), entity_ref("urn:test:45a:w1#y"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45A-02-WAGES-ABOVE-CEILING-NOT-QUALIFIED-EMPLOYEE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": enrolled_member_or_spouse_of_indian_tribe_45a(entity_ref("urn:test:45a:w2#w")) { origin case_input; }
        assert "f1": services_substantially_all_within_reservation_45a(entity_ref("urn:test:45a:w2#w"), entity_ref("urn:test:45a:w2#e"), entity_ref("urn:test:45a:w2#y")) { origin case_input; }
        assert "f2": abode_on_or_near_reservation_45a(entity_ref("urn:test:45a:w2#w"), entity_ref("urn:test:45a:w2#y")) { origin case_input; }
        assert "f3": total_wages_paid_to_employee_45a(entity_ref("urn:test:45a:w2#e"), entity_ref("urn:test:45a:w2#w"), entity_ref("urn:test:45a:w2#y"), 35000.00 USD) { origin case_input; }
        assert "f4": wage_ceiling_45a(entity_ref("urn:test:45a:w2#y"), 30000.00 USD) { origin case_input; }
        assert "f5": share_of_wages_for_trade_or_business_45a(entity_ref("urn:test:45a:w2#e"), entity_ref("urn:test:45a:w2#w"), entity_ref("urn:test:45a:w2#y"), 100.0) { origin case_input; }
        assert "f6": qualified_wages_45a(entity_ref("urn:test:45a:w2#e"), entity_ref("urn:test:45a:w2#w"), entity_ref("urn:test:45a:w2#y"), 20000.00 USD) { origin case_input; }
        assert "f7": qualified_health_insurance_costs_45a(entity_ref("urn:test:45a:w2#e"), entity_ref("urn:test:45a:w2#w"), entity_ref("urn:test:45a:w2#y"), 3000.00 USD) { origin case_input; }
        assert "f8": base_period_amount_45a(entity_ref("urn:test:45a:w2#e"), entity_ref("urn:test:45a:w2#w"), 5000.00 USD) { origin case_input; }
        assert "f9": us.irc.core::begins(entity_ref("urn:test:45a:w2#y"), @2021-01-01) { origin case_input; }
    }
    // (c)(2): total wages 35,000 exceed the 30,000 ceiling.
    evaluate truth(qualified_employee_45a(entity_ref("urn:test:45a:w2#w"), entity_ref("urn:test:45a:w2#e"), entity_ref("urn:test:45a:w2#y")));
    expect truth_status == NEITHER;
}

