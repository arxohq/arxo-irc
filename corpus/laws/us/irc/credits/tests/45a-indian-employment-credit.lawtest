test "S45A-07-SHORT-YEAR-BASE-PRORATED-BY-DAYS-OVER-365" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": enrolled_member_or_spouse_of_indian_tribe_45a(entity_ref("urn:test:45a:w7#w")) { origin case_input; }
        assert "f1": services_substantially_all_within_reservation_45a(entity_ref("urn:test:45a:w7#w"), entity_ref("urn:test:45a:w7#e"), entity_ref("urn:test:45a:w7#y")) { origin case_input; }
        assert "f2": abode_on_or_near_reservation_45a(entity_ref("urn:test:45a:w7#w"), entity_ref("urn:test:45a:w7#y")) { origin case_input; }
        assert "f3": total_wages_paid_to_employee_45a(entity_ref("urn:test:45a:w7#e"), entity_ref("urn:test:45a:w7#w"), entity_ref("urn:test:45a:w7#y"), 25000.00 USD) { origin case_input; }
        assert "f4": wage_ceiling_45a(entity_ref("urn:test:45a:w7#y"), 30000.00 USD) { origin case_input; }
        assert "f5": share_of_wages_for_trade_or_business_45a(entity_ref("urn:test:45a:w7#e"), entity_ref("urn:test:45a:w7#w"), entity_ref("urn:test:45a:w7#y"), 100.0) { origin case_input; }
        assert "f6": qualified_wages_45a(entity_ref("urn:test:45a:w7#e"), entity_ref("urn:test:45a:w7#w"), entity_ref("urn:test:45a:w7#y"), 20000.00 USD) { origin case_input; }
        assert "f7": qualified_health_insurance_costs_45a(entity_ref("urn:test:45a:w7#e"), entity_ref("urn:test:45a:w7#w"), entity_ref("urn:test:45a:w7#y"), 3000.00 USD) { origin case_input; }
        assert "f8": base_period_amount_45a(entity_ref("urn:test:45a:w7#e"), entity_ref("urn:test:45a:w7#w"), 5000.00 USD) { origin case_input; }
        assert "f9": us.irc.core::begins(entity_ref("urn:test:45a:w7#y"), @2021-01-01) { origin case_input; }
        assert "f10": us.irc.core::short_year(entity_ref("urn:test:45a:w7#y")) { origin case_input; }
        assert "f11": taxable_year_days_45a(entity_ref("urn:test:45a:w7#y"), 73.0) { origin case_input; }
    }
    // (e)(5): 5,000 x 73/365 = 1,000.
    evaluate truth(base_period_total_45a(entity_ref("urn:test:45a:w7#e"), entity_ref("urn:test:45a:w7#y"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45A-08-HALF-OR-LESS-WAGES-IN-TRADE-OR-BUSINESS-NOT-QUALIFIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": enrolled_member_or_spouse_of_indian_tribe_45a(entity_ref("urn:test:45a:w8#w")) { origin case_input; }
        assert "f1": services_substantially_all_within_reservation_45a(entity_ref("urn:test:45a:w8#w"), entity_ref("urn:test:45a:w8#e"), entity_ref("urn:test:45a:w8#y")) { origin case_input; }
        assert "f2": abode_on_or_near_reservation_45a(entity_ref("urn:test:45a:w8#w"), entity_ref("urn:test:45a:w8#y")) { origin case_input; }
        assert "f3": total_wages_paid_to_employee_45a(entity_ref("urn:test:45a:w8#e"), entity_ref("urn:test:45a:w8#w"), entity_ref("urn:test:45a:w8#y"), 25000.00 USD) { origin case_input; }
        assert "f4": wage_ceiling_45a(entity_ref("urn:test:45a:w8#y"), 30000.00 USD) { origin case_input; }
        assert "f5": share_of_wages_for_trade_or_business_45a(entity_ref("urn:test:45a:w8#e"), entity_ref("urn:test:45a:w8#w"), entity_ref("urn:test:45a:w8#y"), 50.0) { origin case_input; }
        assert "f6": qualified_wages_45a(entity_ref("urn:test:45a:w8#e"), entity_ref("urn:test:45a:w8#w"), entity_ref("urn:test:45a:w8#y"), 20000.00 USD) { origin case_input; }
        assert "f7": qualified_health_insurance_costs_45a(entity_ref("urn:test:45a:w8#e"), entity_ref("urn:test:45a:w8#w"), entity_ref("urn:test:45a:w8#y"), 3000.00 USD) { origin case_input; }
        assert "f8": base_period_amount_45a(entity_ref("urn:test:45a:w8#e"), entity_ref("urn:test:45a:w8#w"), 5000.00 USD) { origin case_input; }
        assert "f9": us.irc.core::begins(entity_ref("urn:test:45a:w8#y"), @2021-01-01) { origin case_input; }
    }
    // (c)(4): more than 50 percent is required; exactly 50 is not more.
    evaluate truth(qualified_employee_45a(entity_ref("urn:test:45a:w8#w"), entity_ref("urn:test:45a:w8#e"), entity_ref("urn:test:45a:w8#y")));
    expect truth_status == NEITHER;
}
