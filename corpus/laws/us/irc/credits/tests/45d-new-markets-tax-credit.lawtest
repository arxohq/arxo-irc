            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tract_poverty_rate_45d(entity_ref("urn:test:45d:w15#tr"), 10.0) { origin case_input; }
        assert "f1": tract_median_family_income_45d(entity_ref("urn:test:45d:w15#tr"), 70000.00 USD) { origin case_input; }
        assert "f2": statewide_median_family_income_45d(entity_ref("urn:test:45d:w15#tr"), 100000.00 USD) { origin case_input; }
    }
    // (e)(1)(B)(i): 70,000 <= 80% of 100,000.
    evaluate truth(low_income_community_45d(entity_ref("urn:test:45d:w15#tr")));
    expect truth_status == TRUE_ONLY;
}

test "S45D-16-METRO-TRACT-90000-ABOVE-80-PERCENT-OF-GREATER-MEDIAN" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
