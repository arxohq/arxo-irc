        }
        assert "f0": secretary_allocates_limitation_45d(entity_ref("urn:test:45d:w8#c"), 2024.0) { origin case_input; }
        assert "f1": calendar_year_of_allocation_45d(entity_ref("urn:test:45d:w8#c"), 2024.0) { origin case_input; }
        assert "f2": total_allocated_for_year_45d(2024.0, 4900000000.00 USD) { origin case_input; }
    }
    // (f)(1)(H): 5,000,000,000 for 2024; total 4.9 billion.
    evaluate truth(limitation_allocated_to_cde_45d(entity_ref("urn:test:45d:w8#c"), 2024.0));
    expect truth_status == TRUE_ONLY;
}

