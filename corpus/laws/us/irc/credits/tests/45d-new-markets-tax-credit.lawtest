        assert "f2": total_allocated_for_year_45d(2026.0, 4000000000.00 USD) { origin case_input; }
    }
    // PL 119-21 section 70423: 5,000,000,000 for each calendar year after 2019 (legal time 2026-09-25).
    evaluate truth(limitation_allocated_to_cde_45d(entity_ref("urn:test:45d:w10#c"), 2026.0));
    expect truth_status == TRUE_ONLY;
}

