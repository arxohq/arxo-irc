// Section 45D scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45D-01-FIRST-ALLOWANCE-DATE-FIVE-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": acquired_at_original_issue_solely_for_cash_45d(entity_ref("urn:test:45d:w1#t"), entity_ref("urn:test:45d:w1#i")) { origin case_input; }
        assert "f1": investment_in_cde_45d(entity_ref("urn:test:45d:w1#i"), entity_ref("urn:test:45d:w1#c")) { origin case_input; }
        assert "f2": cde_is_qualified_45d(entity_ref("urn:test:45d:w1#c")) { origin case_input; }
        assert "f3": cash_used_for_qlici_substantially_all_45d(entity_ref("urn:test:45d:w1#i")) { origin case_input; }
        assert "f4": designated_by_cde_45d(entity_ref("urn:test:45d:w1#i")) { origin case_input; }
        assert "f5": designated_amount_within_allocation_45d(entity_ref("urn:test:45d:w1#i")) { origin case_input; }
        assert "f6": issued_on_45d(entity_ref("urn:test:45d:w1#i"), @2022-03-01) { origin case_input; }
        assert "f7": cde_allocation_received_on_45d(entity_ref("urn:test:45d:w1#c"), @2021-06-01) { origin case_input; }
        assert "f8": amount_paid_at_original_issue_45d(entity_ref("urn:test:45d:w1#i"), 1000000.00 USD) { origin case_input; }
        assert "f9": us.irc.core::begins(entity_ref("urn:test:45d:w1#y"), @2022-01-01) { origin case_input; }
        assert "f10": us.irc.core::ends(entity_ref("urn:test:45d:w1#y"), @2022-12-31) { origin case_input; }
    }
    // the original issue date 2022-03-01 is the first allowance date: 5% of 1,000,000.
    evaluate truth(new_markets_credit_per_investment_45d(entity_ref("urn:test:45d:w1#t"), entity_ref("urn:test:45d:w1#i"), entity_ref("urn:test:45d:w1#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

