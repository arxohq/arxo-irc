        assert "f2": tract_median_family_income_45d(entity_ref("urn:test:45d:w16#tr"), 90000.00 USD) { origin case_input; }
        assert "f3": statewide_median_family_income_45d(entity_ref("urn:test:45d:w16#tr"), 100000.00 USD) { origin case_input; }
        assert "f4": metropolitan_median_family_income_45d(entity_ref("urn:test:45d:w16#tr"), 110000.00 USD) { origin case_input; }
