        }
        assert "f0": nuclear_facility_owned_by_taxpayer_45j(entity_ref("urn:test:45j:w2#f"), entity_ref("urn:test:45j:w2#t")) { origin case_input; }
        assert "f1": nrc_reactor_design_approved_on_45j(entity_ref("urn:test:45j:w2#f"), @2000-01-01) { origin case_input; }
        assert "f2": facility_originally_placed_in_service_on_45j(entity_ref("urn:test:45j:w2#f"), @2015-01-01) { origin case_input; }
        assert "f3": section_45j_enacted_on(@2005-08-08) { origin case_input; }
        assert "f4": electricity_sale_date_45j(entity_ref("urn:test:45j:w2#f"), entity_ref("urn:test:45j:w2#y"), @2018-06-01) { origin case_input; }
        assert "f5": kilowatt_hours_sold_45j(entity_ref("urn:test:45j:w2#f"), entity_ref("urn:test:45j:w2#y"), 1000000000.0) { origin case_input; }
        assert "f6": allocated_megawatt_capacity_45j(entity_ref("urn:test:45j:w2#f"), 1000.0) { origin case_input; }
        assert "f7": nameplate_megawatt_capacity_45j(entity_ref("urn:test:45j:w2#f"), 1000.0) { origin case_input; }
        assert "f8": reference_price_cents_45j(entity_ref("urn:test:45j:w2#y"), 9.5) { origin case_input; }
        assert "f9": inflation_adjustment_factor_45j(entity_ref("urn:test:45j:w2#y"), 1.0) { origin case_input; }
    }
    // (c)(2): (9.5 - 8.0)/3 = 0.5.
    evaluate truth(facility_credit_45j(entity_ref("urn:test:45j:w2#f"), entity_ref("urn:test:45j:w2#y"), 9000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

