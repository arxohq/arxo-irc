// Section 45J scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45J-01-EIGHTEEN-HUNDREDTHS-CENT-PER-KWH" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": nuclear_facility_owned_by_taxpayer_45j(entity_ref("urn:test:45j:w1#f"), entity_ref("urn:test:45j:w1#t")) { origin case_input; }
        assert "f1": nrc_reactor_design_approved_on_45j(entity_ref("urn:test:45j:w1#f"), @2000-01-01) { origin case_input; }
        assert "f2": facility_originally_placed_in_service_on_45j(entity_ref("urn:test:45j:w1#f"), @2015-01-01) { origin case_input; }
        assert "f3": section_45j_enacted_on(@2005-08-08) { origin case_input; }
        assert "f4": electricity_sale_date_45j(entity_ref("urn:test:45j:w1#f"), entity_ref("urn:test:45j:w1#y"), @2018-06-01) { origin case_input; }
        assert "f5": kilowatt_hours_sold_45j(entity_ref("urn:test:45j:w1#f"), entity_ref("urn:test:45j:w1#y"), 1000000000.0) { origin case_input; }
        assert "f6": allocated_megawatt_capacity_45j(entity_ref("urn:test:45j:w1#f"), 1000.0) { origin case_input; }
        assert "f7": nameplate_megawatt_capacity_45j(entity_ref("urn:test:45j:w1#f"), 1000.0) { origin case_input; }
        assert "f8": reference_price_cents_45j(entity_ref("urn:test:45j:w1#y"), 7.0) { origin case_input; }
        assert "f9": inflation_adjustment_factor_45j(entity_ref("urn:test:45j:w1#y"), 1.0) { origin case_input; }
    }
    // 1.8 cents x 1e9 kWh = 18,000,000; full allocation; reference price below 8 cents.
    evaluate truth(facility_credit_45j(entity_ref("urn:test:45j:w1#f"), entity_ref("urn:test:45j:w1#y"), 18000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45J-02-REFERENCE-PRICE-9-5-CENTS-HALVES-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
