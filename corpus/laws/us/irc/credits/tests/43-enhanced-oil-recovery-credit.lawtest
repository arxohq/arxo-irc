// Section 43 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S43-01-CREDIT-BEFORE-PHASEOUT-15-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_enhanced_oil_recovery_costs(entity_ref("urn:test:s43:w1#t"), entity_ref("urn:test:s43:w1#y1"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(enhanced_oil_recovery_credit_before_phaseout(entity_ref("urn:test:s43:w1#t"), entity_ref("urn:test:s43:w1#y1"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S43-02-PHASEOUT-RATIO-WHEN-PRICE-EXCEEDS-THRESHOLD" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": reference_price_preceding_calendar_year_43(entity_ref("urn:test:s43:w2#y1"), 50.00 USD) { origin case_input; }
        assert "f2": inflation_adjusted_28_dollar_threshold_43(entity_ref("urn:test:s43:w2#y1"), 44.00 USD) { origin case_input; }
    }
    // (50-44)/6 = 1.0 (fully phased out).
    evaluate truth(phaseout_ratio_43(entity_ref("urn:test:s43:w2#y1"), 1.0));
    expect truth_status == TRUE_ONLY;
}

test "S43-03-CREDIT-REDUCED-BY-PHASEOUT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_enhanced_oil_recovery_costs(entity_ref("urn:test:s43:w3#t"), entity_ref("urn:test:s43:w3#y1"), 100000.00 USD) { origin case_input; }
        assert "f2": reference_price_preceding_calendar_year_43(entity_ref("urn:test:s43:w3#y1"), 46.00 USD) { origin case_input; }
        assert "f3": inflation_adjusted_28_dollar_threshold_43(entity_ref("urn:test:s43:w3#y1"), 44.00 USD) { origin case_input; }
    }
    // before=15000; ratio=(46-44)/6=0.3333333333; 15000*(1-0.3333333333)=15000*0.6666666667=10000.0000005 -> 10000.00.
    evaluate truth(enhanced_oil_recovery_credit(entity_ref("urn:test:s43:w3#t"), entity_ref("urn:test:s43:w3#y1"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S43-04-NO-PHASEOUT-FACT-FULL-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_enhanced_oil_recovery_costs(entity_ref("urn:test:s43:w4#t"), entity_ref("urn:test:s43:w4#y1"), 20000.00 USD) { origin case_input; }
    }
    // no reference price / threshold facts -> no phaseout ratio -> full 15% credit = 3000.
    evaluate truth(enhanced_oil_recovery_credit(entity_ref("urn:test:s43:w4#t"), entity_ref("urn:test:s43:w4#y1"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}
