// Sections 31 and 33 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S31-01-WITHHOLDING-CREDITED-TO-LAST-TAXABLE-YEAR" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": amount_withheld_wages(entity_ref("urn:test:s31:w1#p"), 2023, 5000.00 USD) { origin case_input; }
        assert "f1": last_taxable_year_beginning_in(entity_ref("urn:test:s31:w1#p"), 2023, entity_ref("urn:test:s31:w1#y2023")) { origin case_input; }
    }
    evaluate truth(wage_withholding_credit(entity_ref("urn:test:s31:w1#p"), entity_ref("urn:test:s31:w1#y2023"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S31-02-NO-WITHHOLDING-ASSERTED-UNDETERMINED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
    }
    evaluate truth(wage_withholding_credit(entity_ref("urn:test:s31:empty#p"), entity_ref("urn:test:s31:empty#y2023"), 0 USD));
    expect truth_status == NEITHER;
}

test "S33-01-CHAPTER-3-WITHHOLDING-CREDITED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": amount_withheld_chapter_3(entity_ref("urn:test:s33:w1#p"), entity_ref("urn:test:s33:w1#y2023"), 1200.00 USD) { origin case_input; }
    }
    evaluate truth(nra_withholding_credit(entity_ref("urn:test:s33:w1#p"), entity_ref("urn:test:s33:w1#y2023"), 1200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S33-02-NO-WITHHOLDING-ASSERTED-UNDETERMINED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
    }
    evaluate truth(nra_withholding_credit(entity_ref("urn:test:s33:empty#p"), entity_ref("urn:test:s33:empty#y2023"), 0 USD));
    expect truth_status == NEITHER;
}
