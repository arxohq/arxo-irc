// Credits stage 3: section 45E(c)(2) prior plan exclusion and section 45T(b) credit period.
// NOT EXECUTED: status implemented_unverified. Expectations come from the pinned statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S3 45Ec2 no prior plan costs qualify" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_startup_costs_expense(entity_ref("urn:test:s3 45ec2 no prior plan costs qualify#r"), entity_ref("urn:test:s3 45ec2 no prior plan costs qualify#y"), 1000.00 USD) { origin case_input; }
        assert "f1": eligible_employer_plan_has_nhce_participant(entity_ref("urn:test:s3 45ec2 no prior plan costs qualify#r"), entity_ref("urn:test:s3 45ec2 no prior plan costs qualify#y")) { origin case_input; }
    }
    evaluate truth(qualified_startup_costs(entity_ref("urn:test:s3 45ec2 no prior plan costs qualify#r"), entity_ref("urn:test:s3 45ec2 no prior plan costs qualify#y"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

