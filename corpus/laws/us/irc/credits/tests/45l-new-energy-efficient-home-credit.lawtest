test "S45L-01-SINGLE-FAMILY-ENERGY-STAR-2500" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": constructed_by_person_45l(entity_ref("urn:test:45l:w1#u"), entity_ref("urn:test:45l:w1#c")) { origin case_input; }
        assert "f1": dwelling_class_45l(entity_ref("urn:test:45l:w1#u"), SingleFamilyOrManufactured) { origin case_input; }
        assert "f2": dwelling_in_united_states_45l(entity_ref("urn:test:45l:w1#u")) { origin case_input; }
        assert "f3": construction_substantially_completed_on_45l(entity_ref("urn:test:45l:w1#u"), @2024-11-01) { origin case_input; }
        assert "f4": section_45l_enacted_on(@2005-08-08) { origin case_input; }
        assert "f5": meets_energy_saving_requirements_45l(entity_ref("urn:test:45l:w1#u")) { origin case_input; }
        assert "f6": acquired_from_contractor_for_residence_45l(entity_ref("urn:test:45l:w1#u"), entity_ref("urn:test:45l:w1#c"), entity_ref("urn:test:45l:w1#y"), @2025-03-01) { origin case_input; }
    }
    // (a)(2)(A)(i): ,500; base edition (legal time before 2025-07-04).
    evaluate truth(new_energy_efficient_home_credit_per_unit_45l(entity_ref("urn:test:45l:w1#c"), entity_ref("urn:test:45l:w1#u"), entity_ref("urn:test:45l:w1#y"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
}

