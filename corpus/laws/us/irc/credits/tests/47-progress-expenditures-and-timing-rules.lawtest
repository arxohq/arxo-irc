test "S47D-01-EXPENDITURES-TAKEN-INTO-ACCOUNT-IN-PLACED-IN-SERVICE-YEAR" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": building_placed_in_service_year_47(entity_ref("urn:test:s47d:w1#b"), entity_ref("urn:test:s47d:w1#y")) { origin case_input; }
        assert "f1": qualified_rehabilitation_expenditures_of_building_47(entity_ref("urn:test:s47d:w1#b"), 900000.00 USD) { origin case_input; }
    }
    evaluate truth(expenditures_taken_into_account_year_47(entity_ref("urn:test:s47d:w1#b"), entity_ref("urn:test:s47d:w1#y"), 900000.00 USD));
    expect truth_status == TRUE_ONLY;
}

