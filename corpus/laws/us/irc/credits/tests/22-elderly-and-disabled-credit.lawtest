// Section 22 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S22-01-SINGLE-QUALIFIED-BY-AGE-BELOW-AGI-THRESHOLD" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": attained_65_before_close(entity_ref("urn:test:s22:w1#p"), entity_ref("urn:test:s22:w1#y2023")) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s22:w1#p"), entity_ref("urn:test:s22:w1#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s22:w1#p"), entity_ref("urn:test:s22:w1#y2023"), 6000.00 USD) { origin case_input; }
    }
    // initial amount $5,000, AGI $6,000 < $7,500 threshold: no (d) reduction.
    evaluate truth(elderly_and_disabled_credit(entity_ref("urn:test:s22:w1#p"), entity_ref("urn:test:s22:w1#y2023"), 750.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S22-02-SINGLE-AGI-ABOVE-THRESHOLD-REDUCED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": attained_65_before_close(entity_ref("urn:test:s22:w2#p"), entity_ref("urn:test:s22:w2#y2023")) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s22:w2#p"), entity_ref("urn:test:s22:w2#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        // AGI $9,500: excess over $7,500 is $2,000; half is $1,000.
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s22:w2#p"), entity_ref("urn:test:s22:w2#y2023"), 9500.00 USD) { origin case_input; }
    }
    evaluate truth(section_22_amount(entity_ref("urn:test:s22:w2#p"), entity_ref("urn:test:s22:w2#y2023"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S22-03-JOINT-BOTH-QUALIFIED-AT-THRESHOLD" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": attained_65_before_close(entity_ref("urn:test:s22:w3#p"), entity_ref("urn:test:s22:w3#y2023")) { origin case_input; }
        assert "f1": joint_return_both_qualified(entity_ref("urn:test:s22:w3#p"), entity_ref("urn:test:s22:w3#spouse"), entity_ref("urn:test:s22:w3#y2023")) { origin case_input; }
        assert "f2": us.irc.income_individual::filing_status(entity_ref("urn:test:s22:w3#p"), entity_ref("urn:test:s22:w3#y2023"), us.irc.income_individual::Joint) { origin case_input; }
        // AGI exactly at the $10,000 joint threshold: no reduction.
        assert "f3": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s22:w3#p"), entity_ref("urn:test:s22:w3#y2023"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(section_22_amount(entity_ref("urn:test:s22:w3#p"), entity_ref("urn:test:s22:w3#y2023"), 7500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S22-04-NONRESIDENT-ALIEN-BAR" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": attained_65_before_close(entity_ref("urn:test:s22:w4#p"), entity_ref("urn:test:s22:w4#y2023")) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s22:w4#p"), entity_ref("urn:test:s22:w4#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s22:w4#p"), entity_ref("urn:test:s22:w4#y2023"), 6000.00 USD) { origin case_input; }
        assert "f3": section_22f_nonresident_alien(entity_ref("urn:test:s22:w4#p")) { origin case_input; }
    }
    // section 22(f): no credit to a nonresident alien, regardless of the
    // otherwise-qualifying facts above.
    evaluate truth(elderly_and_disabled_credit(entity_ref("urn:test:s22:w4#p"), entity_ref("urn:test:s22:w4#y2023"), 750.00 USD));
    expect truth_status == NEITHER;
}

