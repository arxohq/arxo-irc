// Sections 38 and 39 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S38-01-CURRENT-YEAR-CREDIT-BELOW-LIMITATION-ALLOWED-IN-FULL" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": general_business_credit_component_amount(entity_ref("urn:test:s38:w1#p"), entity_ref("urn:test:s38:w1#y1"), WorkOpportunityCredit51, 5000.00 USD) { origin case_input; }
        assert "f2": net_income_tax(entity_ref("urn:test:s38:w1#p"), entity_ref("urn:test:s38:w1#y1"), 50000.00 USD) { origin case_input; }
        assert "f3": tentative_minimum_tax_26c(entity_ref("urn:test:s38:w1#p"), entity_ref("urn:test:s38:w1#y1"), 0 USD) { origin case_input; }
        assert "f4": net_regular_tax_liability(entity_ref("urn:test:s38:w1#p"), entity_ref("urn:test:s38:w1#y1"), 40000.00 USD) { origin case_input; }
    }
    // limitation = 50000 - max(0, 0.25*(40000-25000)) = 50000 - 3750 = 46250; before = 5000 < limitation.
    evaluate truth(general_business_credit(entity_ref("urn:test:s38:w1#p"), entity_ref("urn:test:s38:w1#y1"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S39-01-UNUSED-CREDIT-CARRIED-BACK-ONE-YEAR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": current_year_business_credit(entity_ref("urn:test:s39:w1#p"), entity_ref("urn:test:s39:w1#y2"), 10000.00 USD) { origin case_input; }
        assert "f2": general_business_credit_limitation(entity_ref("urn:test:s39:w1#p"), entity_ref("urn:test:s39:w1#y2"), 6000.00 USD) { origin case_input; }
        assert "f3": preceding_taxable_year_of(entity_ref("urn:test:s39:w1#y2"), entity_ref("urn:test:s39:w1#y1")) { origin case_input; }
    }
    // unused = min(10000, (0+10000)-6000) = 4000; carried back to the preceding year.
    evaluate truth(business_credit_carryback_computed_to_year(entity_ref("urn:test:s39:w1#p"), entity_ref("urn:test:s39:w1#y2"), entity_ref("urn:test:s39:w1#y1"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
}
