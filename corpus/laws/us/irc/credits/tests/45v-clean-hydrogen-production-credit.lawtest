// Section 45V scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45V-01-BAND-2-5-TO-4-TWENTY-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": facility_owned_by_taxpayer_45v(entity_ref("urn:test:45v:w1#f"), entity_ref("urn:test:45v:w1#t")) { origin case_input; }
        assert "f1": lifecycle_emissions_rate_45v(entity_ref("urn:test:45v:w1#f"), 3.0) { origin case_input; }
        assert "f2": production_verified_and_in_ordinary_course_45v(entity_ref("urn:test:45v:w1#f"), entity_ref("urn:test:45v:w1#t")) { origin case_input; }
        assert "f3": facility_construction_begins_on_45v(entity_ref("urn:test:45v:w1#f"), @2025-01-01) { origin case_input; }
        assert "f4": facility_originally_placed_in_service_on_45v(entity_ref("urn:test:45v:w1#f"), @2024-01-01) { origin case_input; }
        assert "f5": hydrogen_production_date_45v(entity_ref("urn:test:45v:w1#f"), entity_ref("urn:test:45v:w1#y"), @2026-06-01) { origin case_input; }
        assert "f6": hydrogen_kilograms_produced_45v(entity_ref("urn:test:45v:w1#t"), entity_ref("urn:test:45v:w1#f"), entity_ref("urn:test:45v:w1#y"), 1000000.0) { origin case_input; }
        assert "f7": inflation_adjustment_factor_45v(entity_ref("urn:test:45v:w1#y"), 1.0) { origin case_input; }
    }
    // 20% of /bin/zsh.60 = /bin/zsh.12 per kilogram x 1,000,000.
    evaluate truth(hydrogen_credit_of_facility_45v(entity_ref("urn:test:45v:w1#t"), entity_ref("urn:test:45v:w1#f"), entity_ref("urn:test:45v:w1#y"), 120000.00 USD));
    expect truth_status == TRUE_ONLY;
}

