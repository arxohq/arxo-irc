language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45HD-01-APPLICABLE-PERIOD-ENDS-1-YEAR-AFTER-COMPLIANCE-DATE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": compliance_date_for_facility_45h(entity_ref("urn:test:s45hd:w1#f"), @2008-06-30) { origin case_input; }
    }
    evaluate truth(applicable_period_end_45h(entity_ref("urn:test:s45hd:w1#f"), @2009-06-30));
    expect truth_status == TRUE_ONLY;
}

