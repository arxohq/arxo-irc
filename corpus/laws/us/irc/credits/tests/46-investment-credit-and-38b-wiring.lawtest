            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": small_employer_pension_plan_startup_cost_credit(entity_ref("urn:test:38b:w2#t"), entity_ref("urn:test:38b:w2#y"), 500.00 USD) { origin case_input; }
        assert "f1": additional_credit_45e_f(entity_ref("urn:test:38b:w2#t"), entity_ref("urn:test:38b:w2#y"), 1000.00 USD) { origin case_input; }
    }
    // Section 38(b)(14) reads the whole section 45E credit: 500 + 1,000.
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:38b:w2#t"), entity_ref("urn:test:38b:w2#y"), SmallEmployerPensionStartupCredit45E, 1500.00 USD));
    expect truth_status == TRUE_ONLY;
}

