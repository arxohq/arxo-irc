// Section 46 and section 38(b) wiring scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S46-01-REHABILITATION-AND-ENERGY-COMPONENTS-SUM" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rehabilitation_credit(entity_ref("urn:test:46:w1#t"), entity_ref("urn:test:46:w1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": energy_credit_amount(entity_ref("urn:test:46:w1#t"), entity_ref("urn:test:46:w1#y"), 200000.00 USD) { origin case_input; }
    }
    // Two of the seven components: 100,000 + 200,000.
    evaluate truth(investment_credit(entity_ref("urn:test:46:w1#t"), entity_ref("urn:test:46:w1#y"), 300000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S46-02-ADVANCED-ENERGY-AND-MANUFACTURING-COMPONENTS-SUM" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualifying_advanced_energy_project_credit(entity_ref("urn:test:46:w2#t"), entity_ref("urn:test:46:w2#y"), 30000.00 USD) { origin case_input; }
        assert "f1": advanced_manufacturing_investment_credit(entity_ref("urn:test:46:w2#t"), entity_ref("urn:test:46:w2#y"), 50000.00 USD) { origin case_input; }
    }
    // Section 46(5) and (6): 30,000 + 50,000.
    evaluate truth(investment_credit(entity_ref("urn:test:46:w2#t"), entity_ref("urn:test:46:w2#y"), 80000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S46-03-CLEAN-ELECTRICITY-COMPONENT-SUMMED-OVER-FACILITIES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": owned_and_used_for_electricity_generation(entity_ref("urn:test:46:w3#f1"), entity_ref("urn:test:46:w3#t")) { origin case_input; }
        assert "f1": owned_and_used_for_electricity_generation(entity_ref("urn:test:46:w3#f2"), entity_ref("urn:test:46:w3#t")) { origin case_input; }
        assert "f2": clean_electricity_investment_credit(entity_ref("urn:test:46:w3#f1"), entity_ref("urn:test:46:w3#y"), 70000.00 USD) { origin case_input; }
        assert "f3": clean_electricity_investment_credit(entity_ref("urn:test:46:w3#f2"), entity_ref("urn:test:46:w3#y"), 30000.00 USD) { origin case_input; }
    }
    // Section 46(7): the section 48E credits of the taxpayer facilities, 70,000 + 30,000.
    evaluate truth(investment_credit_component_46(entity_ref("urn:test:46:w3#t"), entity_ref("urn:test:46:w3#y"), CleanElectricityInvestmentCredit48E, 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S46-04-NO-COMPONENT-NO-INVESTMENT-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    // With no component credit the investment credit is not established.
    evaluate truth(investment_credit(entity_ref("urn:test:46:w4#t"), entity_ref("urn:test:46:w4#y"), 0 USD));
    expect truth_status == NEITHER;
}

