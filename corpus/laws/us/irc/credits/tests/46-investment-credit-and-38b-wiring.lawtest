            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": disabled_access_credit(entity_ref("urn:test:38b:w4#t"), entity_ref("urn:test:38b:w4#y"), 1000.00 USD) { origin case_input; }
        assert "f1": enhanced_oil_recovery_credit(entity_ref("urn:test:38b:w4#t"), entity_ref("urn:test:38b:w4#y"), 2000.00 USD) { origin case_input; }
    }
    // Section 38(b)(6) and (7): 1,000 + 2,000.
    evaluate truth(current_year_business_credit(entity_ref("urn:test:38b:w4#t"), entity_ref("urn:test:38b:w4#y"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S38B-05-CLEAN-ELECTRICITY-PRODUCTION-CREDIT-BY-FACILITY-OWNER" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": owned_and_used_for_electricity_generation(entity_ref("urn:test:38b:w5#f1"), entity_ref("urn:test:38b:w5#t")) { origin case_input; }
        assert "f1": clean_electricity_production_credit(entity_ref("urn:test:38b:w5#f1"), entity_ref("urn:test:38b:w5#y"), 12000.00 USD) { origin case_input; }
    }
    // Section 38(b)(39): the facility credit belongs to its owner.
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:38b:w5#t"), entity_ref("urn:test:38b:w5#y"), CleanElectricityProductionCredit45Y, 12000.00 USD));
    expect truth_status == TRUE_ONLY;
}

