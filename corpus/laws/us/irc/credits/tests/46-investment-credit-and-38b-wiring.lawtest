test "S38B-04-DISABLED-ACCESS-AND-ENHANCED-OIL-RECOVERY-SUM-TO-CURRENT-YEAR-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
