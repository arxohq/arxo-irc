// Section 42 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S42-01-2050-TEST-MET-9-PERCENT-FLOOR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": minimum_set_aside_election(entity_ref("urn:test:s42:w1#b"), TwentyFifty) { origin case_input; }
        assert "f2": percent_units_rent_restricted_at_or_below_50_pct_ami(entity_ref("urn:test:s42:w1#b"), 0.25) { origin case_input; }
        assert "f3": low_income_housing_building_owned_by(entity_ref("urn:test:s42:w1#b"), entity_ref("urn:test:s42:w1#p")) { origin case_input; }
        assert "f4": within_credit_period_42f(entity_ref("urn:test:s42:w1#b"), entity_ref("urn:test:s42:w1#y1")) { origin case_input; }
        assert "f5": applicable_percentage_secretary_prescribed(entity_ref("urn:test:s42:w1#b"), entity_ref("urn:test:s42:w1#y1"), 0.07) { origin case_input; }
        assert "f6": qualified_basis(entity_ref("urn:test:s42:w1#b"), entity_ref("urn:test:s42:w1#y1"), 1000000.00 USD) { origin case_input; }
    }
    // 20-50 test: 25% >= 20% -> met; non-federally-subsidized floor 9% > secretary 7%: 0.09*1000000 = 90000.
    evaluate truth(qualified_low_income_housing_project(entity_ref("urn:test:s42:w1#b")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(low_income_housing_credit_component(entity_ref("urn:test:s42:w1#b"), entity_ref("urn:test:s42:w1#p"), entity_ref("urn:test:s42:w1#y1"), 90000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42-02-2050-TEST-NOT-MET-BELOW-20-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": minimum_set_aside_election(entity_ref("urn:test:s42:w2#b"), TwentyFifty) { origin case_input; }
        assert "f2": percent_units_rent_restricted_at_or_below_50_pct_ami(entity_ref("urn:test:s42:w2#b"), 0.15) { origin case_input; }
    }
    evaluate truth(qualified_low_income_housing_project(entity_ref("urn:test:s42:w2#b")));
    expect truth_status == NEITHER;
}
