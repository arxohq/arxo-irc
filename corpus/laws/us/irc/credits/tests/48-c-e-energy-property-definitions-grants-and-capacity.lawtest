// Section 48(c)-(e) energy property definitions, section 1603 grants and the environmental justice capacity increase scenarios (stage 2e).
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S48C-01-FUEL-CELL-HALF-KILOWATT-31-PERCENT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fuel_cell_power_plant_48(entity_ref("urn:test:s48c:w1#p")) { origin case_input; }
        assert "f1": nameplate_capacity_kw_48(entity_ref("urn:test:s48c:w1#p"), 0.5) { origin case_input; }
        assert "f2": electricity_only_generation_efficiency_48(entity_ref("urn:test:s48c:w1#p"), 0.31) { origin case_input; }
        assert "f3": energy_property_construction_begin_date(entity_ref("urn:test:s48c:w1#p"), @2024-12-31) { origin case_input; }
    }
    // (c)(1)(A): at least 0.5 kW and efficiency above 30 percent, construction before 2025.
    evaluate truth(qualified_fuel_cell_property_48(entity_ref("urn:test:s48c:w1#p")));
    expect truth_status == TRUE_ONLY;
}

