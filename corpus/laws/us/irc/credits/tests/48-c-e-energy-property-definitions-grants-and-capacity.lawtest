        assert "f1": ej_allocation_date_48(entity_ref("urn:test:s48c:w96#f"), @2023-06-01) { origin case_input; }
        assert "f2": property_placed_in_service_date_48(entity_ref("urn:test:s48c:w96#p"), @2027-06-01) { origin case_input; }
    }
    // (e)(4)(E)(i): allocated 2023-06-01, placed in service 2027-06-01.
    evaluate truth(ej_increase_applies_to_property_48(entity_ref("urn:test:s48c:w96#p")));
    expect truth_status == TRUE_ONLY;
}

