        assert "f1": dealer_registered_with_secretary_30d(entity_ref("urn:test:s30dd:w32#d")) { origin case_input; }
        assert "f2": dealer_disclosed_on_30d(entity_ref("urn:test:s30dd:w32#d"), entity_ref("urn:test:s30dd:w32#v"), @2025-06-08) { origin case_input; }
        assert "f3": election_made_on_30d(entity_ref("urn:test:s30dd:w32#t"), entity_ref("urn:test:s30dd:w32#v"), @2025-06-09) { origin case_input; }
        assert "f4": credit_otherwise_allowable_30d(entity_ref("urn:test:s30dd:w32#t"), entity_ref("urn:test:s30dd:w32#v"), 7500.00 USD) { origin case_input; }
        assert "f5": dealer_paid_taxpayer_on_30d(entity_ref("urn:test:s30dd:w32#d"), entity_ref("urn:test:s30dd:w32#v"), @2025-06-10, 7500.00 USD) { origin case_input; }
        assert "f6": incentive_availability_and_election_not_limited_30d(entity_ref("urn:test:s30dd:w32#d"), entity_ref("urn:test:s30dd:w32#v")) { origin case_input; }
        assert "f7": vehicle_purchased_on_30d(entity_ref("urn:test:s30dd:w32#t"), entity_ref("urn:test:s30dd:w32#v"), @2025-06-10) { origin case_input; }
        assert "f8": taxpayer_elects_transfer_to_eligible_entity_30d(entity_ref("urn:test:s30dd:w32#t"), entity_ref("urn:test:s30dd:w32#v"), entity_ref("urn:test:s30dd:w32#d")) { origin case_input; }
        assert "f9": payment_received_by_taxpayer_from_eligible_entity_30d(entity_ref("urn:test:s30dd:w32#t"), entity_ref("urn:test:s30dd:w32#v"), entity_ref("urn:test:s30dd:w32#d"), 7500.00 USD) { origin case_input; }
        assert "f10": credit_disallowed_under_f10_30d(entity_ref("urn:test:s30dd:w32#t"), entity_ref("urn:test:s30dd:w32#v")) { origin case_input; }
    }
    evaluate truth(tax_increase_for_recapture_of_payment_30d(entity_ref("urn:test:s30dd:w32#t"), entity_ref("urn:test:s30dd:w32#v"), 7500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S30DD-33-NO-RECAPTURE-WHEN-CREDIT-NOT-DISALLOWED-UNDER-F10" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": dealer_sold_vehicle_to_taxpayer_on_30d(entity_ref("urn:test:s30dd:w33#d"), entity_ref("urn:test:s30dd:w33#v"), entity_ref("urn:test:s30dd:w33#t"), @2025-06-10) { origin case_input; }
        assert "f1": dealer_registered_with_secretary_30d(entity_ref("urn:test:s30dd:w33#d")) { origin case_input; }
        assert "f2": dealer_disclosed_on_30d(entity_ref("urn:test:s30dd:w33#d"), entity_ref("urn:test:s30dd:w33#v"), @2025-06-08) { origin case_input; }
        assert "f3": election_made_on_30d(entity_ref("urn:test:s30dd:w33#t"), entity_ref("urn:test:s30dd:w33#v"), @2025-06-09) { origin case_input; }
        assert "f4": credit_otherwise_allowable_30d(entity_ref("urn:test:s30dd:w33#t"), entity_ref("urn:test:s30dd:w33#v"), 7500.00 USD) { origin case_input; }
        assert "f5": dealer_paid_taxpayer_on_30d(entity_ref("urn:test:s30dd:w33#d"), entity_ref("urn:test:s30dd:w33#v"), @2025-06-10, 7500.00 USD) { origin case_input; }
        assert "f6": incentive_availability_and_election_not_limited_30d(entity_ref("urn:test:s30dd:w33#d"), entity_ref("urn:test:s30dd:w33#v")) { origin case_input; }
        assert "f7": vehicle_purchased_on_30d(entity_ref("urn:test:s30dd:w33#t"), entity_ref("urn:test:s30dd:w33#v"), @2025-06-10) { origin case_input; }
        assert "f8": taxpayer_elects_transfer_to_eligible_entity_30d(entity_ref("urn:test:s30dd:w33#t"), entity_ref("urn:test:s30dd:w33#v"), entity_ref("urn:test:s30dd:w33#d")) { origin case_input; }
        assert "f9": payment_received_by_taxpayer_from_eligible_entity_30d(entity_ref("urn:test:s30dd:w33#t"), entity_ref("urn:test:s30dd:w33#v"), entity_ref("urn:test:s30dd:w33#d"), 7500.00 USD) { origin case_input; }
    }
    evaluate truth(tax_increase_for_recapture_of_payment_30d(entity_ref("urn:test:s30dd:w33#t"), entity_ref("urn:test:s30dd:w33#v"), 7500.00 USD));
    expect truth_status == NEITHER;
}
