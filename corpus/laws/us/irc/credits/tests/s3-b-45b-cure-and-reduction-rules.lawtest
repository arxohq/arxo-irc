        assert "f1": capital_account_additions_cumulative_45b3(entity_ref("urn:test:s3 45b3 fraction below cap#f"), entity_ref("urn:test:s3 45b3 fraction below cap#y"), 10000000.00 USD) { origin case_input; }
    }
