// Section 25D scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S25D-01-SOLAR-ELECTRIC-30-PERCENT-2024" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": placed_in_service_date_25d(entity_ref("urn:test:s25d:w1#t"), entity_ref("urn:test:s25d:w1#y1"), 1, @2024-06-01) { origin case_input; }
        assert "f2": qualified_solar_electric_property_expenditure(entity_ref("urn:test:s25d:w1#t"), entity_ref("urn:test:s25d:w1#y1"), 1, 20000.00 USD) { origin case_input; }
    }
    // 2024-06-01 falls in the 2022-2032 30% window.
    evaluate truth(solar_electric_credit_25d(entity_ref("urn:test:s25d:w1#t"), entity_ref("urn:test:s25d:w1#y1"), 1, 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25D-02-PHASEDOWN-TO-26-PERCENT-IN-2033" {
    given {
        context {
            legal_time @2033-04-15; decision_time @2033-04-15T09:00:00-05:00;
            knowledge_time @2033-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": placed_in_service_date_25d(entity_ref("urn:test:s25d:w2#t"), entity_ref("urn:test:s25d:w2#y1"), 1, @2033-03-01) { origin case_input; }
        assert "f2": qualified_geothermal_heat_pump_property_expenditure(entity_ref("urn:test:s25d:w2#t"), entity_ref("urn:test:s25d:w2#y1"), 1, 10000.00 USD) { origin case_input; }
    }
    // 2033-03-01 falls in the 2033 26% window.
    evaluate truth(geothermal_heat_pump_credit_25d(entity_ref("urn:test:s25d:w2#t"), entity_ref("urn:test:s25d:w2#y1"), 1, 2600.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25D-03-TERMINATED-AFTER-2034" {
    given {
        context {
            legal_time @2035-04-15; decision_time @2035-04-15T09:00:00-05:00;
            knowledge_time @2035-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": placed_in_service_date_25d(entity_ref("urn:test:s25d:w3#t"), entity_ref("urn:test:s25d:w3#y1"), 1, @2035-01-15) { origin case_input; }
    }
    evaluate truth(section_25d_terminated_25h(entity_ref("urn:test:s25d:w3#t"), entity_ref("urn:test:s25d:w3#y1"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S25D-04-FUEL-CELL-CAPPED-AT-500-PER-HALF-KW" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": placed_in_service_date_25d(entity_ref("urn:test:s25d:w4#t"), entity_ref("urn:test:s25d:w4#y1"), 1, @2024-06-01) { origin case_input; }
        assert "f2": qualified_fuel_cell_property_expenditure(entity_ref("urn:test:s25d:w4#t"), entity_ref("urn:test:s25d:w4#y1"), 1, 20000.00 USD) { origin case_input; }
        assert "f3": fuel_cell_property_capacity_half_kw(entity_ref("urn:test:s25d:w4#t"), entity_ref("urn:test:s25d:w4#y1"), 1, 4.0) { origin case_input; }
    }
    // 30%*20000=6000, but capped at 500*4=2000.
    evaluate truth(fuel_cell_credit_25d(entity_ref("urn:test:s25d:w4#t"), entity_ref("urn:test:s25d:w4#y1"), 1, 2000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25D-05-TOTAL-CREDIT-SUMS-MULTIPLE-ITEMS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": placed_in_service_date_25d(entity_ref("urn:test:s25d:w5#t"), entity_ref("urn:test:s25d:w5#y1"), 1, @2024-06-01) { origin case_input; }
        assert "f2": qualified_solar_electric_property_expenditure(entity_ref("urn:test:s25d:w5#t"), entity_ref("urn:test:s25d:w5#y1"), 1, 10000.00 USD) { origin case_input; }
        assert "f3": placed_in_service_date_25d(entity_ref("urn:test:s25d:w5#t"), entity_ref("urn:test:s25d:w5#y1"), 2, @2024-08-01) { origin case_input; }
        assert "f4": qualified_battery_storage_technology_expenditure(entity_ref("urn:test:s25d:w5#t"), entity_ref("urn:test:s25d:w5#y1"), 2, 5000.00 USD) { origin case_input; }
    }
    // item1: 30%*10000=3000; item2: 30%*5000=1500; total = 4500.
    evaluate truth(residential_clean_energy_credit(entity_ref("urn:test:s25d:w5#t"), entity_ref("urn:test:s25d:w5#y1"), 4500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25D-20-PLACED-2026-03-01-TERMINATED-UNDER-AMENDED-TEXT" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": placed_in_service_date_25d(entity_ref("urn:test:25d:w20#t"), entity_ref("urn:test:25d:w20#y"), 1, @2026-03-01) { origin case_input; }
    }
    // PL 119-21 section 70506 at legal time 2026-09-25: expenditures after 2025-12-31.
    evaluate truth(section_25d_terminated_25h(entity_ref("urn:test:25d:w20#t"), entity_ref("urn:test:25d:w20#y"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S25D-21-PLACED-2026-03-01-NOT-TERMINATED-UNDER-BASE-TEXT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": placed_in_service_date_25d(entity_ref("urn:test:25d:w21#t"), entity_ref("urn:test:25d:w21#y"), 1, @2026-03-01) { origin case_input; }
    }
    // Read at legal time 2025-04-15: the 2034-12-31 end applies.
    evaluate truth(section_25d_terminated_25h(entity_ref("urn:test:25d:w21#t"), entity_ref("urn:test:25d:w21#y"), 1));
    expect truth_status == NEITHER;
}
