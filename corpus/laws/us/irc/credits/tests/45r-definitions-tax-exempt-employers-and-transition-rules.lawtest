// Section 45R definitions, tax-exempt employer and transition rule scenarios (stage 2f).
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45RD-01-ORDINARY-WORKER-IS-EMPLOYEE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": worker_of_employer_45r(entity_ref("urn:test:s45rd:w1#pe"), entity_ref("urn:test:s45rd:w1#em")) { origin case_input; }
    }
    evaluate truth(employee_45r(entity_ref("urn:test:s45rd:w1#pe"), entity_ref("urn:test:s45rd:w1#em")));
    expect truth_status == TRUE_ONLY;
}

