// Section 40B scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S40B-01-BASE-1-25-PER-GALLON-AT-50-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": mixture_produced_by_taxpayer_in_united_states_40b(entity_ref("urn:test:40b:w1#t"), entity_ref("urn:test:40b:w1#m")) { origin case_input; }
        assert "f1": mixture_used_or_sold_for_aircraft_in_ordinary_course_40b(entity_ref("urn:test:40b:w1#t"), entity_ref("urn:test:40b:w1#m")) { origin case_input; }
        assert "f2": mixture_transferred_to_aircraft_tank_in_united_states_40b(entity_ref("urn:test:40b:w1#m")) { origin case_input; }
        assert "f3": fuel_meets_astm_and_not_excluded_feedstock_40b(entity_ref("urn:test:40b:w1#m")) { origin case_input; }
        assert "f4": lifecycle_reduction_percent_40b(entity_ref("urn:test:40b:w1#m"), 50.0) { origin case_input; }
        assert "f5": producer_registered_and_certified_40b(entity_ref("urn:test:40b:w1#t"), entity_ref("urn:test:40b:w1#m")) { origin case_input; }
        assert "f6": mixture_sold_or_used_on_40b(entity_ref("urn:test:40b:w1#m"), @2024-06-01) { origin case_input; }
        assert "f7": sustainable_aviation_fuel_gallons_in_mixture_40b(entity_ref("urn:test:40b:w1#t"), entity_ref("urn:test:40b:w1#m"), entity_ref("urn:test:40b:w1#y"), 1000.0) { origin case_input; }
    }
    // 1,000 gallons x .25; no supplementary amount at exactly 50 percent.
    evaluate truth(sustainable_aviation_fuel_credit_per_mixture_40b(entity_ref("urn:test:40b:w1#t"), entity_ref("urn:test:40b:w1#m"), entity_ref("urn:test:40b:w1#y"), 1250.00 USD));
    expect truth_status == TRUE_ONLY;
}

