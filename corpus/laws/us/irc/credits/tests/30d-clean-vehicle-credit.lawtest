test "S30D-06-MAGI-ABOVE-THRESHOLD-BLOCKS-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": modified_agi_30d(entity_ref("urn:test:s30d:w6#t"), entity_ref("urn:test:s30d:w6#y1"), 400000.00 USD) { origin case_input; }
        assert "f2": modified_agi_preceding_year_30d(entity_ref("urn:test:s30d:w6#t"), entity_ref("urn:test:s30d:w6#y1"), 380000.00 USD) { origin case_input; }
        assert "f3": us.irc.income_individual::filing_status(entity_ref("urn:test:s30d:w6#t"), entity_ref("urn:test:s30d:w6#y1"), us.irc.income_individual::Unmarried) { origin case_input; }
    }
    // lesser(400000,380000)=380000 > 150000 threshold for unmarried — no rule concludes magi_below_threshold_30d.
    evaluate truth(magi_below_threshold_30d(entity_ref("urn:test:s30d:w6#t"), entity_ref("urn:test:s30d:w6#y1")));
    expect truth_status == NEITHER;
}

test "S30D-20-ACQUIRED-2025-10-15-TERMINATED-UNDER-AMENDED-TEXT" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": acquisition_date_30d(entity_ref("urn:test:30d:w20#t"), entity_ref("urn:test:30d:w20#v"), @2025-10-15) { origin case_input; }
    }
    // PL 119-21 section 70502 at legal time 2026-09-25: vehicles acquired after 2025-09-30.
    evaluate truth(section_30d_terminated(entity_ref("urn:test:30d:w20#t"), entity_ref("urn:test:30d:w20#v")));
    expect truth_status == TRUE_ONLY;
}

test "S30D-21-ACQUIRED-2025-10-15-NOT-TERMINATED-UNDER-BASE-TEXT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": acquisition_date_30d(entity_ref("urn:test:30d:w21#t"), entity_ref("urn:test:30d:w21#v"), @2025-10-15) { origin case_input; }
    }
    // Read at legal time 2025-04-15.
    evaluate truth(section_30d_terminated(entity_ref("urn:test:30d:w21#t"), entity_ref("urn:test:30d:w21#v")));
    expect truth_status == NEITHER;
}
