// Section 30D scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S30D-01-BOTH-REQUIREMENTS-MET-FULL-7500" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": new_clean_vehicle_base_requirements_met(entity_ref("urn:test:s30d:w1#t"), entity_ref("urn:test:s30d:w1#v")) { origin case_input; }
        assert "f2": placed_in_service_date_30d(entity_ref("urn:test:s30d:w1#t"), entity_ref("urn:test:s30d:w1#v"), @2025-03-01) { origin case_input; }
        assert "f3": critical_minerals_value_percentage(entity_ref("urn:test:s30d:w1#v"), 0.80) { origin case_input; }
        assert "f4": battery_components_value_percentage(entity_ref("urn:test:s30d:w1#v"), 0.90) { origin case_input; }
        assert "f5": modified_agi_30d(entity_ref("urn:test:s30d:w1#t"), entity_ref("urn:test:s30d:w1#y1"), 100000.00 USD) { origin case_input; }
        assert "f6": modified_agi_preceding_year_30d(entity_ref("urn:test:s30d:w1#t"), entity_ref("urn:test:s30d:w1#y1"), 95000.00 USD) { origin case_input; }
        assert "f7": us.irc.income_individual::filing_status(entity_ref("urn:test:s30d:w1#t"), entity_ref("urn:test:s30d:w1#y1"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f8": manufacturer_suggested_retail_price_30d(entity_ref("urn:test:s30d:w1#v"), 45000.00 USD) { origin case_input; }
        assert "f9": vehicle_classification_30d(entity_ref("urn:test:s30d:w1#v"), OtherVehicle) { origin case_input; }
        assert "f10": vin_included_on_return_30d(entity_ref("urn:test:s30d:w1#t"), entity_ref("urn:test:s30d:w1#v"), entity_ref("urn:test:s30d:w1#y1")) { origin case_input; }
    }
    // 2025 -> critical minerals applicable 60% (80% value satisfies); battery components applicable 60% (90% value satisfies); 3750+3750=7500.
    evaluate truth(clean_vehicle_credit_per_vehicle(entity_ref("urn:test:s30d:w1#t"), entity_ref("urn:test:s30d:w1#v"), entity_ref("urn:test:s30d:w1#y1"), 7500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S30D-02-ONLY-BATTERY-COMPONENTS-MET-3750" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": new_clean_vehicle_base_requirements_met(entity_ref("urn:test:s30d:w2#t"), entity_ref("urn:test:s30d:w2#v")) { origin case_input; }
        assert "f2": placed_in_service_date_30d(entity_ref("urn:test:s30d:w2#t"), entity_ref("urn:test:s30d:w2#v"), @2025-03-01) { origin case_input; }
        assert "f3": critical_minerals_value_percentage(entity_ref("urn:test:s30d:w2#v"), 0.10) { origin case_input; }
        assert "f4": battery_components_value_percentage(entity_ref("urn:test:s30d:w2#v"), 0.90) { origin case_input; }
    }
    // critical minerals value 10% < applicable 60% -> not satisfied -> amount 0; battery components satisfied -> 3750; total 3750.
    evaluate truth(per_vehicle_dollar_limitation_30d(entity_ref("urn:test:s30d:w2#t"), entity_ref("urn:test:s30d:w2#v"), 3750.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S30D-03-MSRP-ABOVE-LIMITATION-BLOCKS-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": manufacturer_suggested_retail_price_30d(entity_ref("urn:test:s30d:w3#v"), 60000.00 USD) { origin case_input; }
        assert "f2": vehicle_classification_30d(entity_ref("urn:test:s30d:w3#v"), OtherVehicle) { origin case_input; }
    }
    // 60000 > 55000 limitation for "other" vehicles — no rule concludes msrp_below_limitation_30d.
    evaluate truth(msrp_below_limitation_30d(entity_ref("urn:test:s30d:w3#v")));
    expect truth_status == NEITHER;
}

test "S30D-04-FEOC-EXCLUDED-ENTITY-AFTER-2024" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": placed_in_service_date_30d(entity_ref("urn:test:s30d:w4#t"), entity_ref("urn:test:s30d:w4#v"), @2025-03-01) { origin case_input; }
        assert "f2": critical_minerals_extracted_by_feoc(entity_ref("urn:test:s30d:w4#v")) { origin case_input; }
    }
    evaluate truth(excluded_entity_30d(entity_ref("urn:test:s30d:w4#t"), entity_ref("urn:test:s30d:w4#v")));
    expect truth_status == TRUE_ONLY;
}

