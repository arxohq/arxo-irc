            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": electricity_used_at_clean_hydrogen_facility_by_taxpayer_or_related_45(entity_ref("urn:test:s45c:w106#f"), entity_ref("urn:test:s45c:w106#y")) { origin case_input; }
        assert "f1": hydrogen_use_and_production_verified_by_unrelated_third_party_45(entity_ref("urn:test:s45c:w106#f"), entity_ref("urn:test:s45c:w106#y")) { origin case_input; }
    }
    // (e)(13): used by the taxpayer or a related person at a clean hydrogen facility and verified by an unrelated third party.
    evaluate truth(electricity_treated_as_sold_to_unrelated_person_45(entity_ref("urn:test:s45c:w106#f"), entity_ref("urn:test:s45c:w106#y")));
    expect truth_status == TRUE_ONLY;
}

test "S45C-107-UNVERIFIED-HYDROGEN-USE-NOT-TREATED-AS-SOLD" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": electricity_used_at_clean_hydrogen_facility_by_taxpayer_or_related_45(entity_ref("urn:test:s45c:w107#f"), entity_ref("urn:test:s45c:w107#y")) { origin case_input; }
    }
    // (e)(13)(B): no verification by an unrelated third party.
    evaluate truth(electricity_treated_as_sold_to_unrelated_person_45(entity_ref("urn:test:s45c:w107#f"), entity_ref("urn:test:s45c:w107#y")));
    expect truth_status == NEITHER;
}
