// Section 45(c)-(e) definitions, qualified facilities and special rules scenarios (stage 2e). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).
// The dates of the enactment of the paragraphs of section 45(d) are not pinned in the corpus: scenarios that need one assert an ASSUMED case date (a scenario
// input, not a claim about the statute).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45C-01-WIND-IS-A-QUALIFIED-ENERGY-RESOURCE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": energy_source_of_facility_45(entity_ref("urn:test:s45c:w1#f"), Wind) { origin case_input; }
    }
    // (c)(1)(A): the facility uses wind.
    evaluate truth(facility_uses_qualified_energy_resource_45(entity_ref("urn:test:s45c:w1#f")));
    expect truth_status == TRUE_ONLY;
}

