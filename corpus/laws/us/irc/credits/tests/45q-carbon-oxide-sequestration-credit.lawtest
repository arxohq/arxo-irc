        assert "f9": capture_date_45q(entity_ref("urn:test:45q:w1#e"), entity_ref("urn:test:45q:w1#y"), @2024-06-01) { origin case_input; }
        assert "f10": qualified_carbon_oxide_measured_and_verified_45q(entity_ref("urn:test:45q:w1#t"), entity_ref("urn:test:45q:w1#e"), entity_ref("urn:test:45q:w1#y")) { origin case_input; }
