// Section 45 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45-01-WITHIN-10-YEAR-PERIOD-NO-PHASEOUT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f1": facility_placed_in_service_date_45(entity_ref("urn:test:s45:w1#f"), @2020-01-01) { origin case_input; }
        assert "f2": electricity_sale_date_45(entity_ref("urn:test:s45:w1#f"), entity_ref("urn:test:s45:w1#y1"), @2025-06-01) { origin case_input; }
        assert "f3": electricity_sold_to_unrelated_person_45(entity_ref("urn:test:s45:w1#f"), entity_ref("urn:test:s45:w1#y1")) { origin case_input; }
        assert "f4": qualified_energy_resources_electricity_produced(entity_ref("urn:test:s45:w1#f"), entity_ref("urn:test:s45:w1#y1"), 1000000.0) { origin case_input; }
        assert "f5": indexed_rate_per_kwh_cents_45(entity_ref("urn:test:s45:w1#y1"), 0.3) { origin case_input; }
    }
    // within 10 years (2020-2030); no reference_price fact -> no phaseout; (0.3/100)*1,000,000 = 3000.00.
    evaluate truth(credit_before_bonuses_45(entity_ref("urn:test:s45:w1#f"), entity_ref("urn:test:s45:w1#y1"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45-02-OUTSIDE-10-YEAR-PERIOD-UNDETERMINED" {
    given {
        context {
            legal_time @2035-04-15; decision_time @2035-04-15T09:00:00-05:00;
            knowledge_time @2035-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f1": facility_placed_in_service_date_45(entity_ref("urn:test:s45:w2#f"), @2020-01-01) { origin case_input; }
        assert "f2": electricity_sale_date_45(entity_ref("urn:test:s45:w2#f"), entity_ref("urn:test:s45:w2#y1"), @2035-06-01) { origin case_input; }
    }
    // 2035-06-01 is after 2020-01-01 + 10 years (2030-01-01) — no rule concludes within_10_year_period_45.
    evaluate truth(within_10_year_period_45(entity_ref("urn:test:s45:w2#f"), entity_ref("urn:test:s45:w2#y1")));
    expect truth_status == NEITHER;
}

test "S45-03-PHASEOUT-RATIO-AT-9-CENTS-REFERENCE-PRICE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": reference_price_45(entity_ref("urn:test:s45:w3#y1"), 9.0) { origin case_input; }
    }
    // (9-8)/3 = 0.3333333333.
    evaluate truth(phaseout_ratio_45(entity_ref("urn:test:s45:w3#y1"), 0.3333333333));
    expect truth_status == TRUE_ONLY;
}

test "S45-04-FIVE-TIMES-MULTIPLIER-WAGE-AND-APPRENTICESHIP" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": credit_before_bonuses_45(entity_ref("urn:test:s45:w4#f"), entity_ref("urn:test:s45:w4#y1"), 3000.00 USD) { origin case_input; }
        assert "f2": prevailing_wage_requirement_satisfied_45(entity_ref("urn:test:s45:w4#f"), entity_ref("urn:test:s45:w4#y1")) { origin case_input; }
        assert "f3": apprenticeship_requirement_satisfied_45(entity_ref("urn:test:s45:w4#f"), entity_ref("urn:test:s45:w4#y1")) { origin case_input; }
    }
    // 3000 * 5 = 15000.
    evaluate truth(credit_after_6_multiplier_45(entity_ref("urn:test:s45:w4#f"), entity_ref("urn:test:s45:w4#y1"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45-05-DOMESTIC-CONTENT-BONUS-10-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": credit_before_bonuses_45(entity_ref("urn:test:s45:w5#f"), entity_ref("urn:test:s45:w5#y1"), 3000.00 USD) { origin case_input; }
        assert "f2": domestic_content_requirement_satisfied_45(entity_ref("urn:test:s45:w5#f")) { origin case_input; }
    }
    // no 5x multiplier facts -> after_multiplier = 3000 (unchanged); domestic content bonus: 3000*1.10=3300.
    evaluate truth(renewable_electricity_production_credit(entity_ref("urn:test:s45:w5#f"), entity_ref("urn:test:s45:w5#y1"), 3300.00 USD));
    expect truth_status == TRUE_ONLY;
}
