        assert "f2": us.irc.core::begins(entity_ref("urn:test:42c:w28#y1"), @2020-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:42c:w28#y1"), @2020-12-31) { origin case_input; }
        assert "f4": rehab_first_credit_year_begin_42(entity_ref("urn:test:42c:w28#b"), @2022-01-01) { origin case_input; }
    }
    // (f)(5)(A): the credit period would begin 2020-01-01 but the rehabilitation credit period begins 2022-01-01: the existing building starts then.
    evaluate truth(existing_building_credit_period_begin_42(entity_ref("urn:test:42c:w28#b"), @2022-01-01));
    expect truth_status == TRUE_ONLY;
}

test "S42C-29-EXISTING-BUILDING-KEEPS-OWN-PERIOD-WHEN-REHAB-EARLIER" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": building_placed_in_service_on_42(entity_ref("urn:test:42c:w29#b"), @2020-06-15) { origin case_input; }
        assert "f1": qualified_low_income_building_at_first_year_close_42(entity_ref("urn:test:42c:w29#b")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:42c:w29#y1"), @2020-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:42c:w29#y1"), @2020-12-31) { origin case_input; }
        assert "f4": rehab_first_credit_year_begin_42(entity_ref("urn:test:42c:w29#b"), @2019-01-01) { origin case_input; }
    }
    // (f)(5)(A): the rehabilitation credit period begins earlier (2019-01-01): the building keeps its own start 2020-01-01.
    evaluate truth(existing_building_credit_period_begin_42(entity_ref("urn:test:42c:w29#b"), @2020-01-01));
    expect truth_status == TRUE_ONLY;
}

test "S42C-30-BUILDING-DESCRIBED-IN-F5B-WITH-WAIVER-AND-MODIFIED-TEST" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
