test "S42C-12-GOVERNMENTAL-UNIT-ELECTION-WAIVES-TWENTY-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": low_income_housing_building_owned_by(entity_ref("urn:test:42c:w12#b"), entity_ref("urn:test:42c:w12#t")) { origin case_input; }
        assert "f1": building_acquired_from_governmental_unit_42(entity_ref("urn:test:42c:w12#b")) { origin case_input; }
        assert "f2": elects_governmental_unit_rehab_percentage_42(entity_ref("urn:test:42c:w12#t"), entity_ref("urn:test:42c:w12#b")) { origin case_input; }
    }
    // (e)(3)(B): the building was acquired from a governmental unit and the election is made: the 20 percent test is waived (valid election, effect created).
    evaluate truth(twenty_percent_test_waived_42(entity_ref("urn:test:42c:w12#b")));
    expect truth_status == TRUE_ONLY;
}

