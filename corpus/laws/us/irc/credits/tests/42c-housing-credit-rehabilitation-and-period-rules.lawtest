test "S42C-10-SEPARATE-NEW-BUILDING-ALL-TESTS-MET" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": low_income_housing_building_owned_by(entity_ref("urn:test:42c:w10#b"), entity_ref("urn:test:42c:w10#t")) { origin case_input; }
        assert "f1": rehab_amount_chargeable_to_capital_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31, 300000.00 USD) { origin case_input; }
        assert "f2": rehab_excluded_amount_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31, 0.00 USD) { origin case_input; }
        assert "f3": rehab_property_of_depreciable_character_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31) { origin case_input; }
        assert "f4": rehab_allocable_to_low_income_units_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31) { origin case_input; }
        assert "f5": adjusted_basis_first_day_of_rehab_period_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31, 1000000.00 USD) { origin case_input; }
        assert "f6": qualified_basis_attributable_to_rehab_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31, 130000.00 USD) { origin case_input; }
        assert "f7": low_income_unit_count_of_building_42(entity_ref("urn:test:42c:w10#b"), 20.0) { origin case_input; }
        assert "f8": rehab_test_determined_at_first_year_close_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31) { origin case_input; }
    }
    // (e)(1), (3): character, low-income nexus, 20 percent (300,000 of 1,000,000), per-unit test (130,000 / 20 = 6,500) all met at the first-year close.
    evaluate truth(rehab_treated_as_separate_new_building_42(entity_ref("urn:test:42c:w10#b"), @2009-12-31));
    expect truth_status == TRUE_ONLY;
}

