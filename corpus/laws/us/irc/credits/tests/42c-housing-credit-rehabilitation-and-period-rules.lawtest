// Section 42(e), (f)(2)(B)-(5) scenarios (stage 2e). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S42C-01-REHAB-EXPENDITURES-NET-OF-ACQUISITION-COST" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rehab_amount_chargeable_to_capital_42(entity_ref("urn:test:42c:w1#b"), @2022-12-31, 300000.00 USD) { origin case_input; }
        assert "f1": rehab_excluded_amount_42(entity_ref("urn:test:42c:w1#b"), @2022-12-31, 50000.00 USD) { origin case_input; }
        assert "f2": rehab_property_of_depreciable_character_42(entity_ref("urn:test:42c:w1#b"), @2022-12-31) { origin case_input; }
    }
    // (e)(2): 300,000 capitalized depreciable amounts less 50,000 acquisition cost = 250,000.
    evaluate truth(rehabilitation_expenditures_42(entity_ref("urn:test:42c:w1#b"), @2022-12-31, 250000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42C-02-NON-DEPRECIABLE-PROPERTY-NOT-REHAB-EXPENDITURES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rehab_amount_chargeable_to_capital_42(entity_ref("urn:test:42c:w2#b"), @2022-12-31, 300000.00 USD) { origin case_input; }
        assert "f1": rehab_excluded_amount_42(entity_ref("urn:test:42c:w2#b"), @2022-12-31, 0.00 USD) { origin case_input; }
    }
    // (e)(2)(A): without the depreciable-character fact the amount is not rehabilitation expenditures.
    evaluate truth(rehabilitation_expenditures_42(entity_ref("urn:test:42c:w2#b"), @2022-12-31, 300000.00 USD));
    expect truth_status == NEITHER;
}

test "S42C-03-DOLLAR-AMOUNT-THROUGH-2009-STAYS-6000" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rehab_amount_chargeable_to_capital_42(entity_ref("urn:test:42c:w3#b"), @2009-12-31, 100000.00 USD) { origin case_input; }
    }
    // (e)(3)(A)(ii)(II): the $6,000 amount is indexed only for expenditures treated as placed in service after 2009.
    evaluate truth(rehab_dollar_amount_42(entity_ref("urn:test:42c:w3#b"), @2009-12-31, 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42C-04-DOLLAR-AMOUNT-2022-INDEXED-ROUNDED-TO-HUNDRED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rehab_amount_chargeable_to_capital_42(entity_ref("urn:test:42c:w4#b"), @2022-12-31, 100000.00 USD) { origin case_input; }
        assert "f1": cost_of_living_adjustment_2008_base_42(entity_ref("urn:test:42c:w4#b"), @2022-12-31, 0.1235) { origin case_input; }
    }
    // (e)(3)(D): 6,000 x 0.1235 = 741 rounds to 700; the amount is 6,700.
    evaluate truth(rehab_dollar_amount_42(entity_ref("urn:test:42c:w4#b"), @2022-12-31, 6700.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42C-05-DOLLAR-AMOUNT-INCREASE-750-ROUNDS-TO-800" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rehab_amount_chargeable_to_capital_42(entity_ref("urn:test:42c:w5#b"), @2022-12-31, 100000.00 USD) { origin case_input; }
        assert "f1": cost_of_living_adjustment_2008_base_42(entity_ref("urn:test:42c:w5#b"), @2022-12-31, 0.125) { origin case_input; }
    }
    // (e)(3)(D): 6,000 x 0.125 = 750 is not a multiple of 100; nearest multiple (HALF_UP judgment call) 800; amount 6,800.
    evaluate truth(rehab_dollar_amount_42(entity_ref("urn:test:42c:w5#b"), @2022-12-31, 6800.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42C-06-TWENTY-PERCENT-TEST-EXACTLY-MET" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rehab_amount_chargeable_to_capital_42(entity_ref("urn:test:42c:w6#b"), @2009-12-31, 250000.00 USD) { origin case_input; }
        assert "f1": rehab_excluded_amount_42(entity_ref("urn:test:42c:w6#b"), @2009-12-31, 0.00 USD) { origin case_input; }
        assert "f2": rehab_property_of_depreciable_character_42(entity_ref("urn:test:42c:w6#b"), @2009-12-31) { origin case_input; }
        assert "f3": adjusted_basis_first_day_of_rehab_period_42(entity_ref("urn:test:42c:w6#b"), @2009-12-31, 1250000.00 USD) { origin case_input; }
    }
    // (e)(3)(A)(ii)(I): 250,000 is exactly 20 percent of the adjusted basis 1,250,000: met ("not less than").
    evaluate truth(rehab_twenty_percent_test_met_42(entity_ref("urn:test:42c:w6#b"), @2009-12-31));
    expect truth_status == TRUE_ONLY;
}

