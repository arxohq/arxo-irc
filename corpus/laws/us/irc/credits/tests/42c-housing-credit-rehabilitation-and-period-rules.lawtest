}

test "S42C-32-F5B-BUILDING-CREDIT-PERIOD-NOT-BEFORE-MODIFIED-YEAR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": building_placed_in_service_on_42(entity_ref("urn:test:42c:w32#b"), @2020-06-15) { origin case_input; }
        assert "f1": qualified_low_income_building_at_first_year_close_42(entity_ref("urn:test:42c:w32#b")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:42c:w32#y1"), @2020-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:42c:w32#y1"), @2020-12-31) { origin case_input; }
        assert "f4": waiver_granted_under_d6b_42(entity_ref("urn:test:42c:w32#b")) { origin case_input; }
        assert "f5": rehab_credit_allowable_under_modified_test_42(entity_ref("urn:test:42c:w32#b")) { origin case_input; }
        assert "f6": modified_rehab_first_credit_year_begin_42(entity_ref("urn:test:42c:w32#b"), @2023-01-01) { origin case_input; }
    }
    // (f)(5)(B)(i)(II): modified rehabilitation credit period starts 2023-01-01, later than 2020-01-01: the credit period begins then.
    evaluate truth(credit_period_begin_for_f5b_building_42(entity_ref("urn:test:42c:w32#b"), @2023-01-01));
    expect truth_status == TRUE_ONLY;
}

test "S42C-33-D2B-IV-DOES-NOT-APPLY-TO-F5B-BUILDING" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": waiver_granted_under_d6b_42(entity_ref("urn:test:42c:w33#b")) { origin case_input; }
        assert "f1": rehab_credit_allowable_under_modified_test_42(entity_ref("urn:test:42c:w33#b")) { origin case_input; }
    }
    // (f)(5)(B)(i)(I): for a building described in clause (ii), subsection (d)(2)(B)(iv) does not apply.
    evaluate truth(d2b_iv_not_applicable_42(entity_ref("urn:test:42c:w33#b")));
    expect truth_status == TRUE_ONLY;
}
