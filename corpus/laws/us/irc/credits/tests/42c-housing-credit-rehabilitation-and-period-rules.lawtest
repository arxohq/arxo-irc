        assert "f1": qualified_basis_attributable_to_rehab_42(entity_ref("urn:test:42c:w8#b"), @2009-12-31, 120000.00 USD) { origin case_input; }
        assert "f2": low_income_unit_count_of_building_42(entity_ref("urn:test:42c:w8#b"), 20.0) { origin case_input; }
    }
    // (e)(3)(A)(ii)(II): 120,000 / 20 units = 6,000: met.
    evaluate truth(rehab_per_unit_test_met_42(entity_ref("urn:test:42c:w8#b"), @2009-12-31));
    expect truth_status == TRUE_ONLY;
}

