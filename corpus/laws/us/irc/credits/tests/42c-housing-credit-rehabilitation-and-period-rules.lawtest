            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": waiver_granted_under_d6b_42(entity_ref("urn:test:42c:w30#b")) { origin case_input; }
        assert "f1": rehab_credit_allowable_under_modified_test_42(entity_ref("urn:test:42c:w30#b")) { origin case_input; }
    }
    // (f)(5)(B)(ii): a (d)(6)(B) waiver and a credit under the modified rehabilitation test.
    evaluate truth(building_described_in_f5b_ii_42(entity_ref("urn:test:42c:w30#b")));
    expect truth_status == TRUE_ONLY;
}

test "S42C-31-WAIVER-WITHOUT-MODIFIED-TEST-NOT-DESCRIBED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
