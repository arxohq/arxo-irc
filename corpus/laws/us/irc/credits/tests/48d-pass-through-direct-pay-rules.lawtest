        assert "f1": pass_through_elects_direct_pay_48d(entity_ref("urn:test:s48dd:w5#pe"), entity_ref("urn:test:s48dd:w5#pr")) { origin case_input; }
        assert "f2": credit_of_pass_through_property_48d(entity_ref("urn:test:s48dd:w5#pr"), 800000.00 USD) { origin case_input; }
