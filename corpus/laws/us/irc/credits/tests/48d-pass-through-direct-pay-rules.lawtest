test "S48DD-01-ELECTION-MADE-BY-PARTNERSHIP-FOR-DIRECTLY-HELD-PROPERTY" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": property_held_directly_by_pass_through_48d(entity_ref("urn:test:s48dd:w1#pr"), entity_ref("urn:test:s48dd:w1#pe")) { origin case_input; }
        assert "f1": pass_through_elects_direct_pay_48d(entity_ref("urn:test:s48dd:w1#pe"), entity_ref("urn:test:s48dd:w1#pr")) { origin case_input; }
    }
    evaluate truth(election_made_by_pass_through_48d(entity_ref("urn:test:s48dd:w1#pe"), entity_ref("urn:test:s48dd:w1#pr")));
    expect truth_status == TRUE_ONLY;
}

