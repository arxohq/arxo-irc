test "S3 45c corporation member proportionate share" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.corporations::parent_subsidiary_ownership_share(entity_ref("urn:test:s3 45c corporation member proportionate share#g"), entity_ref("urn:test:s3 45c corporation member proportionate share#parent"), entity_ref("urn:test:s3 45c corporation member proportionate share#m"), 0.70, 0.70) { origin case_input; }
        assert "f1": orphan_drug_credit_of_controlled_group_45c(entity_ref("urn:test:s3 45c corporation member proportionate share#g"), entity_ref("urn:test:s3 45c corporation member proportionate share#y"), 100000.00 USD) { origin case_input; }
        assert "f2": member_share_of_aggregate_expenses_45c(entity_ref("urn:test:s3 45c corporation member proportionate share#g"), entity_ref("urn:test:s3 45c corporation member proportionate share#m"), entity_ref("urn:test:s3 45c corporation member proportionate share#y"), 0.30) { origin case_input; }
    }
    evaluate truth(orphan_drug_credit_member_share_45c(entity_ref("urn:test:s3 45c corporation member proportionate share#g"), entity_ref("urn:test:s3 45c corporation member proportionate share#m"), entity_ref("urn:test:s3 45c corporation member proportionate share#y"), 30000.00 USD));
    expect truth_status == TRUE_ONLY;
}

