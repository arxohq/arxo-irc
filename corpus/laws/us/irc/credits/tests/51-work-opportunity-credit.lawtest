// Section 51 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S51-01-QUALIFIED-IV-A-RECIPIENT-400-HOURS-40-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": certified_targeted_group_member(entity_ref("urn:test:s51:w1#emp"), entity_ref("urn:test:s51:w1#er"), entity_ref("urn:test:s51:w1#y2024"), QualifiedIvARecipient, @2024-02-01) { origin case_input; }
        assert "f2": hours_of_service(entity_ref("urn:test:s51:w1#emp"), entity_ref("urn:test:s51:w1#er"), entity_ref("urn:test:s51:w1#y2024"), 500.0) { origin case_input; }
        assert "f3": qualified_first_year_wages(entity_ref("urn:test:s51:w1#emp"), entity_ref("urn:test:s51:w1#er"), entity_ref("urn:test:s51:w1#y2024"), 8000.00 USD) { origin case_input; }
    }
    // 40 percent of the $6,000-capped first-year wages: 0.40 * 6000 = 2400.
    evaluate truth(work_opportunity_credit_component(entity_ref("urn:test:s51:w1#emp"), entity_ref("urn:test:s51:w1#er"), entity_ref("urn:test:s51:w1#y2024"), 2400.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S51-02-120-TO-399-HOURS-25-PERCENT-RATE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": certified_targeted_group_member(entity_ref("urn:test:s51:w2#emp"), entity_ref("urn:test:s51:w2#er"), entity_ref("urn:test:s51:w2#y2024"), QualifiedExFelon, @2024-02-01) { origin case_input; }
        assert "f2": hours_of_service(entity_ref("urn:test:s51:w2#emp"), entity_ref("urn:test:s51:w2#er"), entity_ref("urn:test:s51:w2#y2024"), 200.0) { origin case_input; }
        assert "f3": qualified_first_year_wages(entity_ref("urn:test:s51:w2#emp"), entity_ref("urn:test:s51:w2#er"), entity_ref("urn:test:s51:w2#y2024"), 5000.00 USD) { origin case_input; }
    }
    // 25 percent (120-399 hours): 0.25 * 5000 = 1250.
    evaluate truth(work_opportunity_credit_component(entity_ref("urn:test:s51:w2#emp"), entity_ref("urn:test:s51:w2#er"), entity_ref("urn:test:s51:w2#y2024"), 1250.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S51-03-UNDER-120-HOURS-NO-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": certified_targeted_group_member(entity_ref("urn:test:s51:w3#emp"), entity_ref("urn:test:s51:w3#er"), entity_ref("urn:test:s51:w3#y2024"), QualifiedExFelon, @2024-02-01) { origin case_input; }
        assert "f2": hours_of_service(entity_ref("urn:test:s51:w3#emp"), entity_ref("urn:test:s51:w3#er"), entity_ref("urn:test:s51:w3#y2024"), 80.0) { origin case_input; }
        assert "f3": qualified_first_year_wages(entity_ref("urn:test:s51:w3#emp"), entity_ref("urn:test:s51:w3#er"), entity_ref("urn:test:s51:w3#y2024"), 5000.00 USD) { origin case_input; }
    }
    // Under 120 hours: section 51(i)(3)(B) denies the credit entirely (no rate fires).
    evaluate truth(work_opportunity_credit_component(entity_ref("urn:test:s51:w3#emp"), entity_ref("urn:test:s51:w3#er"), entity_ref("urn:test:s51:w3#y2024"), 1250.00 USD));
    expect truth_status == NEITHER;
}

test "S51-04-LTFA-FIRST-AND-SECOND-YEAR-WAGES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": certified_targeted_group_member(entity_ref("urn:test:s51:w4#emp"), entity_ref("urn:test:s51:w4#er"), entity_ref("urn:test:s51:w4#y2024"), LongTermFamilyAssistanceRecipient, @2024-01-15) { origin case_input; }
        assert "f2": hours_of_service(entity_ref("urn:test:s51:w4#emp"), entity_ref("urn:test:s51:w4#er"), entity_ref("urn:test:s51:w4#y2024"), 500.0) { origin case_input; }
        assert "f3": qualified_first_year_wages(entity_ref("urn:test:s51:w4#emp"), entity_ref("urn:test:s51:w4#er"), entity_ref("urn:test:s51:w4#y2024"), 12000.00 USD) { origin case_input; }
        assert "f4": qualified_second_year_wages(entity_ref("urn:test:s51:w4#emp"), entity_ref("urn:test:s51:w4#er"), entity_ref("urn:test:s51:w4#y2024"), 12000.00 USD) { origin case_input; }
    }
    // 40% * min(12000,10000) + 50% * min(12000,10000) = 4000 + 5000 = 9000.
    evaluate truth(work_opportunity_credit_component(entity_ref("urn:test:s51:w4#emp"), entity_ref("urn:test:s51:w4#er"), entity_ref("urn:test:s51:w4#y2024"), 9000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S51-05-ELECTION-OUT-BARS-TOTAL" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": certified_targeted_group_member(entity_ref("urn:test:s51:w5#emp"), entity_ref("urn:test:s51:w5#er"), entity_ref("urn:test:s51:w5#y2024"), QualifiedExFelon, @2024-02-01) { origin case_input; }
        assert "f2": hours_of_service(entity_ref("urn:test:s51:w5#emp"), entity_ref("urn:test:s51:w5#er"), entity_ref("urn:test:s51:w5#y2024"), 500.0) { origin case_input; }
        assert "f3": qualified_first_year_wages(entity_ref("urn:test:s51:w5#emp"), entity_ref("urn:test:s51:w5#er"), entity_ref("urn:test:s51:w5#y2024"), 5000.00 USD) { origin case_input; }
        assert "f4": section_51_election_filed_on(entity_ref("urn:test:s51:w5#er"), entity_ref("urn:test:s51:w5#y2024"), @2025-03-01) { origin case_input; }
        assert "f5": last_date_prescribed_for_filing_return(entity_ref("urn:test:s51:w5#er"), entity_ref("urn:test:s51:w5#y2024"), @2025-04-15) { origin case_input; }
    }
    evaluate truth(work_opportunity_credit(entity_ref("urn:test:s51:w5#er"), entity_ref("urn:test:s51:w5#y2024"), 2000.00 USD));
    expect truth_status == NEITHER;
}
