// Section 25C scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S25C-01-WINDOWS-CAPPED-AT-600" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": windows_and_skylights_expenditure(entity_ref("urn:test:s25c:w1#t"), entity_ref("urn:test:s25c:w1#y1"), 3000.00 USD) { origin case_input; }
    }
    // 30% * 3000 = 900, but capped at 600.
    evaluate truth(windows_credit(entity_ref("urn:test:s25c:w1#t"), entity_ref("urn:test:s25c:w1#y1"), 600.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25C-02-DOORS-BELOW-CAP" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": exterior_doors_expenditure_before_cap(entity_ref("urn:test:s25c:w2#t"), entity_ref("urn:test:s25c:w2#y1"), 800.00 USD) { origin case_input; }
    }
    // 30% * 800 = 240, below the 500 cap.
    evaluate truth(doors_credit(entity_ref("urn:test:s25c:w2#t"), entity_ref("urn:test:s25c:w2#y1"), 240.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25C-03-HEAT-PUMP-CAPPED-AT-2000-INDEPENDENT-OF-1200-OVERALL-CAP" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": heat_pump_or_biomass_property_expenditure(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1"), 10000.00 USD) { origin case_input; }
        assert "f2": windows_and_skylights_expenditure(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1"), 0 USD) { origin case_input; }
        assert "f3": exterior_doors_expenditure_before_cap(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1"), 0 USD) { origin case_input; }
        assert "f4": building_envelope_insulation_expenditure(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1"), 0 USD) { origin case_input; }
        assert "f5": other_qualified_energy_property_expenditure_after_item_cap(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1"), 0 USD) { origin case_input; }
        assert "f6": home_energy_audit_expenditure(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1"), 0 USD) { origin case_input; }
        assert "f7": home_energy_audit_substantiated(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1")) { origin case_input; }
    }
    // heat pump: 30%*10000=3000, capped at 2000; other categories all 0; total = 0 (overall-capped) + 2000 = 2000.
    evaluate truth(energy_efficient_home_improvement_credit(entity_ref("urn:test:s25c:w3#t"), entity_ref("urn:test:s25c:w3#y1"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25C-04-COMBINED-CATEGORIES-CAPPED-AT-1200-PLUS-HEAT-PUMP" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": windows_and_skylights_expenditure(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1"), 3000.00 USD) { origin case_input; }
        assert "f2": exterior_doors_expenditure_before_cap(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1"), 2000.00 USD) { origin case_input; }
        assert "f3": building_envelope_insulation_expenditure(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1"), 1000.00 USD) { origin case_input; }
        assert "f4": other_qualified_energy_property_expenditure_after_item_cap(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1"), 0 USD) { origin case_input; }
        assert "f5": home_energy_audit_expenditure(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1"), 500.00 USD) { origin case_input; }
        assert "f6": home_energy_audit_substantiated(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1")) { origin case_input; }
        assert "f7": heat_pump_or_biomass_property_expenditure(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1"), 4000.00 USD) { origin case_input; }
    }
    // windows: min(600,900)=600; doors: min(500,600)=500; insulation: 300; audit: min(150,150)=150 -> sum=1550, capped at 1200.
    // heat pump: min(2000, 1200)=1200. total = 1200+1200=2400.
    evaluate truth(energy_efficient_home_improvement_credit(entity_ref("urn:test:s25c:w4#t"), entity_ref("urn:test:s25c:w4#y1"), 2400.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S25C-05-AUDIT-CREDIT-DENIED-WITHOUT-SUBSTANTIATION" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": home_energy_audit_expenditure(entity_ref("urn:test:s25c:w5#t"), entity_ref("urn:test:s25c:w5#y1"), 500.00 USD) { origin case_input; }
    }
    // no substantiation fact asserted — the rule's guard fails, NEITHER not a proven zero.
    evaluate truth(home_energy_audit_credit(entity_ref("urn:test:s25c:w5#t"), entity_ref("urn:test:s25c:w5#y1"), 0 USD));
    expect truth_status == NEITHER;
}

test "S25C-20-PLACED-2026-02-01-TERMINATED-UNDER-AMENDED-TEXT" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": placed_in_service_date_25c(entity_ref("urn:test:25c:w20#t"), entity_ref("urn:test:25c:w20#y"), @2026-02-01) { origin case_input; }
    }
    // PL 119-21 section 70505 at legal time 2026-09-25: property placed in service after 2025-12-31.
    evaluate truth(section_25c_terminated_25i(entity_ref("urn:test:25c:w20#t"), entity_ref("urn:test:25c:w20#y")));
    expect truth_status == TRUE_ONLY;
}

test "S25C-21-PLACED-2025-11-01-NOT-TERMINATED-UNDER-AMENDED-TEXT" {
    given {
        context {
            legal_time @2026-09-25; decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": placed_in_service_date_25c(entity_ref("urn:test:25c:w21#t"), entity_ref("urn:test:25c:w21#y"), @2025-11-01) { origin case_input; }
    }
    // before the amended end date.
    evaluate truth(section_25c_terminated_25i(entity_ref("urn:test:25c:w21#t"), entity_ref("urn:test:25c:w21#y")));
    expect truth_status == NEITHER;
}

test "S25C-22-PLACED-2026-02-01-NOT-TERMINATED-UNDER-BASE-TEXT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": placed_in_service_date_25c(entity_ref("urn:test:25c:w22#t"), entity_ref("urn:test:25c:w22#y"), @2026-02-01) { origin case_input; }
    }
    // Read at legal time 2025-04-15: the 2032-12-31 end applies.
    evaluate truth(section_25c_terminated_25i(entity_ref("urn:test:25c:w22#t"), entity_ref("urn:test:25c:w22#y")));
    expect truth_status == NEITHER;
}

test "S25C-23-PLACED-IN-2008-GAP-TERMINATED-UNDER-BASE-TEXT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": placed_in_service_date_25c(entity_ref("urn:test:25c:w23#t"), entity_ref("urn:test:25c:w23#y"), @2008-06-01) { origin case_input; }
    }
    // (i)(1): after 2007-12-31 and before 2009-01-01 (base text).
    evaluate truth(section_25c_terminated_25i(entity_ref("urn:test:25c:w23#t"), entity_ref("urn:test:25c:w23#y")));
    expect truth_status == TRUE_ONLY;
}
