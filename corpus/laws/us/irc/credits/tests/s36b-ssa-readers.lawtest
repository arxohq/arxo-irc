// Section 36B(d) SSA readers (IRC-G/G6, 27.09.2026).
// Вывод / нет факта источника: with the case-selected external-content
// fact the consequent derives (TRUE_ONLY); without it nothing derives
// (NEITHER). Expectations come from the statutory text. Honest boundary:
// the 2110(c)(5) leg reads the pinned 42 USC 1397jj text in
// `us.ssa.title42_values`; the 86(d) leg is Title-26-internal content
// entering as a case fact. NOT EXECUTED (implemented_unverified;
// execution is step 6, owner gate).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S36B-SSA-01-POVERTY-LINE-DERIVES" {
    given {
        context {
            legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": hhs_poverty_guideline_published_36bd3a(4.0, entity_ref("urn:test:s36bssa:1#y"), 30000 USD) { origin case_input; }
    }
    evaluate truth(poverty_line_amount(4.0, entity_ref("urn:test:s36bssa:1#y"), 30000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S36B-SSA-02-WITHOUT-GUIDELINE-NEITHER" {
    given {
        context {
            legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York";
        }
    }
    evaluate truth(poverty_line_amount(4.0, entity_ref("urn:test:s36bssa:2#y"), 30000 USD));
    expect truth_status == NEITHER;
}

test "S36B-SSA-03-EXCLUDED-PORTION-DERIVES" {
    given {
        context {
            legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": ss_benefits_excluded_portion_asserted_86d_36bd2b(entity_ref("urn:test:s36bssa:3#t"), entity_ref("urn:test:s36bssa:3#y"), 5000 USD) { origin case_input; }
    }
    evaluate truth(ss_benefits_excluded_from_gross_income_86d_36bd2b(entity_ref("urn:test:s36bssa:3#t"), entity_ref("urn:test:s36bssa:3#y"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S36B-SSA-04-WITHOUT-PORTION-NEITHER" {
    given {
        context {
            legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York";
        }
    }
    evaluate truth(ss_benefits_excluded_from_gross_income_86d_36bd2b(entity_ref("urn:test:s36bssa:4#t"), entity_ref("urn:test:s36bssa:4#y"), 5000 USD));
    expect truth_status == NEITHER;
}
