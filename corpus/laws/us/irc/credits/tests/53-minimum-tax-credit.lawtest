// Section 53 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S53-01-NET-MINIMUM-TAX-EQUALS-SECTION-55-TAX" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": section_55a_tax_26a(entity_ref("urn:test:s53:w1#p"), entity_ref("urn:test:s53:w1#y1"), 8000.00 USD) { origin case_input; }
    }
    evaluate truth(net_minimum_tax(entity_ref("urn:test:s53:w1#p"), entity_ref("urn:test:s53:w1#y1"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S53-02-ADJUSTED-NET-MINIMUM-TAX-REDUCED-BY-SPECIFIED-ITEMS-ONLY" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": section_55a_tax_26a(entity_ref("urn:test:s53:w2#p"), entity_ref("urn:test:s53:w2#y1"), 10000.00 USD) { origin case_input; }
        assert "f2": net_minimum_tax_specified_items_only(entity_ref("urn:test:s53:w2#p"), entity_ref("urn:test:s53:w2#y1"), 3000.00 USD) { origin case_input; }
    }
    // 10000 - 3000 = 7000.
    evaluate truth(adjusted_net_minimum_tax(entity_ref("urn:test:s53:w2#p"), entity_ref("urn:test:s53:w2#y1"), 7000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S53-03-MINIMUM-TAX-CREDIT-LIMITED-BY-PRIOR-YEARS-EXCESS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": cumulative_adjusted_net_minimum_tax_prior_years(entity_ref("urn:test:s53:w3#p"), entity_ref("urn:test:s53:w3#y2"), 12000.00 USD) { origin case_input; }
        assert "f2": cumulative_minimum_tax_credit_allowed_prior_years(entity_ref("urn:test:s53:w3#p"), entity_ref("urn:test:s53:w3#y2"), 5000.00 USD) { origin case_input; }
        assert "f3": regular_tax_liability(entity_ref("urn:test:s53:w3#p"), entity_ref("urn:test:s53:w3#y2"), 100000.00 USD) { origin case_input; }
        assert "f4": credits_allowable_under_subparts_a_and_b(entity_ref("urn:test:s53:w3#p"), entity_ref("urn:test:s53:w3#y2"), 0 USD) { origin case_input; }
        assert "f5": credits_allowable_under_subparts_d_e_f(entity_ref("urn:test:s53:w3#p"), entity_ref("urn:test:s53:w3#y2"), 0 USD) { origin case_input; }
        assert "f6": tentative_minimum_tax_26c(entity_ref("urn:test:s53:w3#p"), entity_ref("urn:test:s53:w3#y2"), 20000.00 USD) { origin case_input; }
    }
    // excess = 12000 - 5000 = 7000; limitation = (100000-0) - 20000 = 80000; min(7000, 80000) = 7000.
    evaluate truth(minimum_tax_credit(entity_ref("urn:test:s53:w3#p"), entity_ref("urn:test:s53:w3#y2"), 7000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S53-04-MINIMUM-TAX-CREDIT-CAPPED-BY-LIMITATION" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": cumulative_adjusted_net_minimum_tax_prior_years(entity_ref("urn:test:s53:w4#p"), entity_ref("urn:test:s53:w4#y2"), 50000.00 USD) { origin case_input; }
        assert "f2": cumulative_minimum_tax_credit_allowed_prior_years(entity_ref("urn:test:s53:w4#p"), entity_ref("urn:test:s53:w4#y2"), 0 USD) { origin case_input; }
        assert "f3": regular_tax_liability(entity_ref("urn:test:s53:w4#p"), entity_ref("urn:test:s53:w4#y2"), 30000.00 USD) { origin case_input; }
        assert "f4": credits_allowable_under_subparts_a_and_b(entity_ref("urn:test:s53:w4#p"), entity_ref("urn:test:s53:w4#y2"), 0 USD) { origin case_input; }
        assert "f5": credits_allowable_under_subparts_d_e_f(entity_ref("urn:test:s53:w4#p"), entity_ref("urn:test:s53:w4#y2"), 0 USD) { origin case_input; }
        assert "f6": tentative_minimum_tax_26c(entity_ref("urn:test:s53:w4#p"), entity_ref("urn:test:s53:w4#y2"), 5000.00 USD) { origin case_input; }
    }
    // excess = 50000; limitation = (30000-0) - 5000 = 25000; min(50000, 25000) = 25000.
    evaluate truth(minimum_tax_credit(entity_ref("urn:test:s53:w4#p"), entity_ref("urn:test:s53:w4#y2"), 25000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S53-05-CORPORATION-LIMITATION-INCREASED-BY-BEAT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": cumulative_net_minimum_tax_prior_years_corporation(entity_ref("urn:test:s53:w5#c"), entity_ref("urn:test:s53:w5#y1"), 9000.00 USD) { origin case_input; }
        assert "f2": cumulative_minimum_tax_credit_allowed_prior_years_corporation(entity_ref("urn:test:s53:w5#c"), entity_ref("urn:test:s53:w5#y1"), 1000.00 USD) { origin case_input; }
        assert "f3": minimum_tax_credit_limitation_corporation_before_beat(entity_ref("urn:test:s53:w5#c"), entity_ref("urn:test:s53:w5#y1"), 6000.00 USD) { origin case_input; }
        assert "f4": section_59a_tax_corporation(entity_ref("urn:test:s53:w5#c"), entity_ref("urn:test:s53:w5#y1"), 500.00 USD) { origin case_input; }
    }
    // excess = 9000-1000 = 8000; limitation = 6000+500 = 6500; min(8000, 6500) = 6500.
    evaluate truth(minimum_tax_credit_corporation(entity_ref("urn:test:s53:w5#c"), entity_ref("urn:test:s53:w5#y1"), 6500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S53-06-UNKNOWN-SECTION-55-TAX-IS-UNDETERMINED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
    }
    // no section_55a_tax fact asserted for this taxpayer/year — absence of a fact gives NEITHER, not a proven zero.
    evaluate truth(net_minimum_tax(entity_ref("urn:test:s53:w6#p"), entity_ref("urn:test:s53:w6#y1"), 0 USD));
    expect truth_status == NEITHER;
}
