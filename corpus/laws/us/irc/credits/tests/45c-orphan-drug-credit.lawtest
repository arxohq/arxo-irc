// Section 45C scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45C-01-QUALIFYING-TRIAL-25-PERCENT-OF-EXPENSES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": drug_designation_45c(entity_ref("urn:test:45c:w1#drug"), entity_ref("urn:test:45c:w1#t"), @2020-01-01) { origin case_input; }
        assert "f1": us_affected_population_at_designation_45c(entity_ref("urn:test:45c:w1#drug"), 150000.0) { origin case_input; }
        assert "f2": carried_out_under_505i_exemption_45c(entity_ref("urn:test:45c:w1#trial")) { origin case_input; }
        assert "f3": trial_of_drug_45c(entity_ref("urn:test:45c:w1#trial"), entity_ref("urn:test:45c:w1#drug")) { origin case_input; }
        assert "f4": trial_date_45c(entity_ref("urn:test:45c:w1#trial"), @2024-06-01) { origin case_input; }
        assert "f5": trial_conducted_on_behalf_of_45c(entity_ref("urn:test:45c:w1#trial"), entity_ref("urn:test:45c:w1#t")) { origin case_input; }
        assert "f6": trial_related_to_designated_condition_45c(entity_ref("urn:test:45c:w1#trial")) { origin case_input; }
        assert "f7": trial_conducted_in_united_states_45c(entity_ref("urn:test:45c:w1#trial")) { origin case_input; }
        assert "f8": clinical_testing_expense_45c(entity_ref("urn:test:45c:w1#t"), entity_ref("urn:test:45c:w1#y"), entity_ref("urn:test:45c:w1#trial"), 400000.00 USD) { origin case_input; }
        assert "f9": elects_section_45c(entity_ref("urn:test:45c:w1#t"), entity_ref("urn:test:45c:w1#y")) { origin case_input; }
    }
    // 25 percent of 400,000 = 100,000; drug designated 2020, tested 2024, not yet approved, population under 200,000, US testing, election made.
    evaluate truth(orphan_drug_credit(entity_ref("urn:test:45c:w1#t"), entity_ref("urn:test:45c:w1#y"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45C-02-FUNDED-PART-EXCLUDED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": drug_designation_45c(entity_ref("urn:test:45c:w2#drug"), entity_ref("urn:test:45c:w2#t"), @2020-01-01) { origin case_input; }
        assert "f1": us_affected_population_at_designation_45c(entity_ref("urn:test:45c:w2#drug"), 150000.0) { origin case_input; }
        assert "f2": carried_out_under_505i_exemption_45c(entity_ref("urn:test:45c:w2#trial")) { origin case_input; }
        assert "f3": trial_of_drug_45c(entity_ref("urn:test:45c:w2#trial"), entity_ref("urn:test:45c:w2#drug")) { origin case_input; }
        assert "f4": trial_date_45c(entity_ref("urn:test:45c:w2#trial"), @2024-06-01) { origin case_input; }
        assert "f5": trial_conducted_on_behalf_of_45c(entity_ref("urn:test:45c:w2#trial"), entity_ref("urn:test:45c:w2#t")) { origin case_input; }
        assert "f6": trial_related_to_designated_condition_45c(entity_ref("urn:test:45c:w2#trial")) { origin case_input; }
        assert "f7": trial_conducted_in_united_states_45c(entity_ref("urn:test:45c:w2#trial")) { origin case_input; }
        assert "f8": clinical_testing_expense_45c(entity_ref("urn:test:45c:w2#t"), entity_ref("urn:test:45c:w2#y"), entity_ref("urn:test:45c:w2#trial"), 400000.00 USD) { origin case_input; }
        assert "f9": clinical_testing_funded_by_others_45c(entity_ref("urn:test:45c:w2#t"), entity_ref("urn:test:45c:w2#y"), entity_ref("urn:test:45c:w2#trial"), 100000.00 USD) { origin case_input; }
        assert "f10": elects_section_45c(entity_ref("urn:test:45c:w2#t"), entity_ref("urn:test:45c:w2#y")) { origin case_input; }
    }
    // (400,000 - 100,000 funded) * 25 percent = 75,000.
    evaluate truth(orphan_drug_credit(entity_ref("urn:test:45c:w2#t"), entity_ref("urn:test:45c:w2#y"), 75000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45C-03-NO-ELECTION-NO-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
