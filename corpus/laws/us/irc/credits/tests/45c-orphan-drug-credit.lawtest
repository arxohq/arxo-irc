        }
        assert "f0": drug_designation_45c(entity_ref("urn:test:45c:w3#drug"), entity_ref("urn:test:45c:w3#t"), @2020-01-01) { origin case_input; }
        assert "f1": us_affected_population_at_designation_45c(entity_ref("urn:test:45c:w3#drug"), 150000.0) { origin case_input; }
        assert "f2": carried_out_under_505i_exemption_45c(entity_ref("urn:test:45c:w3#trial")) { origin case_input; }
        assert "f3": trial_of_drug_45c(entity_ref("urn:test:45c:w3#trial"), entity_ref("urn:test:45c:w3#drug")) { origin case_input; }
        assert "f4": trial_date_45c(entity_ref("urn:test:45c:w3#trial"), @2024-06-01) { origin case_input; }
        assert "f5": trial_conducted_on_behalf_of_45c(entity_ref("urn:test:45c:w3#trial"), entity_ref("urn:test:45c:w3#t")) { origin case_input; }
        assert "f6": trial_related_to_designated_condition_45c(entity_ref("urn:test:45c:w3#trial")) { origin case_input; }
        assert "f7": trial_conducted_in_united_states_45c(entity_ref("urn:test:45c:w3#trial")) { origin case_input; }
        assert "f8": clinical_testing_expense_45c(entity_ref("urn:test:45c:w3#t"), entity_ref("urn:test:45c:w3#y"), entity_ref("urn:test:45c:w3#trial"), 400000.00 USD) { origin case_input; }
    }
    // Without the (d)(4) election the section does not apply; the credit is not derived.
    evaluate truth(section_45c_applies(entity_ref("urn:test:45c:w3#t"), entity_ref("urn:test:45c:w3#y")));
    expect truth_status == NEITHER;
}

test "S45C-04-TRIAL-AFTER-APPROVAL-NOT-CLINICAL-TESTING" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": drug_designation_45c(entity_ref("urn:test:45c:w4#drug"), entity_ref("urn:test:45c:w4#t"), @2020-01-01) { origin case_input; }
        assert "f1": us_affected_population_at_designation_45c(entity_ref("urn:test:45c:w4#drug"), 150000.0) { origin case_input; }
        assert "f2": carried_out_under_505i_exemption_45c(entity_ref("urn:test:45c:w4#trial")) { origin case_input; }
        assert "f3": trial_of_drug_45c(entity_ref("urn:test:45c:w4#trial"), entity_ref("urn:test:45c:w4#drug")) { origin case_input; }
        assert "f4": trial_date_45c(entity_ref("urn:test:45c:w4#trial"), @2024-06-01) { origin case_input; }
        assert "f5": trial_conducted_on_behalf_of_45c(entity_ref("urn:test:45c:w4#trial"), entity_ref("urn:test:45c:w4#t")) { origin case_input; }
        assert "f6": trial_related_to_designated_condition_45c(entity_ref("urn:test:45c:w4#trial")) { origin case_input; }
        assert "f7": trial_conducted_in_united_states_45c(entity_ref("urn:test:45c:w4#trial")) { origin case_input; }
        assert "f8": clinical_testing_expense_45c(entity_ref("urn:test:45c:w4#t"), entity_ref("urn:test:45c:w4#y"), entity_ref("urn:test:45c:w4#trial"), 400000.00 USD) { origin case_input; }
        assert "f9": elects_section_45c(entity_ref("urn:test:45c:w4#t"), entity_ref("urn:test:45c:w4#y")) { origin case_input; }
        assert "f10": drug_approval_date_45c(entity_ref("urn:test:45c:w4#drug"), @2023-01-01) { origin case_input; }
    }
    // Testing on 2024-06-01 is after the 2023-01-01 approval, so it is not clinical testing under (b)(2)(A)(ii)(II).
    evaluate truth(clinical_testing_45c(entity_ref("urn:test:45c:w4#trial"), entity_ref("urn:test:45c:w4#t")));
    expect truth_status == NEITHER;
}

test "S45C-05-FOREIGN-TESTING-WITHOUT-INSUFFICIENT-POPULATION-DENIED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": drug_designation_45c(entity_ref("urn:test:45c:w5#drug"), entity_ref("urn:test:45c:w5#t"), @2020-01-01) { origin case_input; }
        assert "f1": us_affected_population_at_designation_45c(entity_ref("urn:test:45c:w5#drug"), 150000.0) { origin case_input; }
        assert "f2": carried_out_under_505i_exemption_45c(entity_ref("urn:test:45c:w5#trial")) { origin case_input; }
        assert "f3": trial_of_drug_45c(entity_ref("urn:test:45c:w5#trial"), entity_ref("urn:test:45c:w5#drug")) { origin case_input; }
        assert "f4": trial_date_45c(entity_ref("urn:test:45c:w5#trial"), @2024-06-01) { origin case_input; }
        assert "f5": trial_conducted_on_behalf_of_45c(entity_ref("urn:test:45c:w5#trial"), entity_ref("urn:test:45c:w5#t")) { origin case_input; }
        assert "f6": trial_related_to_designated_condition_45c(entity_ref("urn:test:45c:w5#trial")) { origin case_input; }
        assert "f7": clinical_testing_expense_45c(entity_ref("urn:test:45c:w5#t"), entity_ref("urn:test:45c:w5#y"), entity_ref("urn:test:45c:w5#trial"), 400000.00 USD) { origin case_input; }
        assert "f8": elects_section_45c(entity_ref("urn:test:45c:w5#t"), entity_ref("urn:test:45c:w5#y")) { origin case_input; }
        assert "f9": trial_conducted_outside_united_states_45c(entity_ref("urn:test:45c:w5#trial")) { origin case_input; }
    }
    // Outside the United States and no insufficient-population fact: (d)(2) denies the credit.
    evaluate truth(orphan_drug_credit(entity_ref("urn:test:45c:w5#t"), entity_ref("urn:test:45c:w5#y"), 100000.00 USD));
    expect truth_status == NEITHER;
