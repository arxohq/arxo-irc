        }
        assert "f0": us_affected_population_at_designation_45c(entity_ref("urn:test:45c:w7#drug"), 500000.0) { origin case_input; }
        assert "f1": no_reasonable_expectation_of_cost_recovery_45c(entity_ref("urn:test:45c:w7#drug")) { origin case_input; }
    }
    evaluate truth(rare_disease_drug_45c(entity_ref("urn:test:45c:w7#drug")));
