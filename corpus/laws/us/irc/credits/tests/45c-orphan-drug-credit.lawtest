test "S45C-06-POPULATION-OVER-200000-NEEDS-COST-RECOVERY-JUDGMENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us_affected_population_at_designation_45c(entity_ref("urn:test:45c:w6#drug"), 500000.0) { origin case_input; }
    }
    // Above 200,000 persons the drug is rare only under (d)(1)(B), an evaluative fact not asserted here: unknown, not negative.
    evaluate truth(rare_disease_drug_45c(entity_ref("urn:test:45c:w6#drug")));
    expect truth_status == NEITHER;
}

test "S45C-07-POPULATION-OVER-200000-WITH-ADJUDICATED-NO-RECOVERY" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
