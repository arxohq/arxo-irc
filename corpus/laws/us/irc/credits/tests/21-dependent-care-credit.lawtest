// Section 21 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S21-01-ONE-CHILD-BELOW-AGI-THRESHOLD-35-PERCENT" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::dependent_of(entity_ref("urn:test:s21:w1#child"), entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023")) { origin case_input; }
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023"), 12000.00 USD) { origin case_input; }
        assert "f3": incurred_to_enable_gainful_employment(entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023")) { origin case_input; }
        assert "f4": employment_related_expense_item(entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023"), QualifyingIndividualCare, 4000.00 USD) { origin case_input; }
        assert "f5": section_129_excludable_amount(entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023"), 0 USD) { origin case_input; }
        assert "f7": earned_income_21(entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023"), 30000.00 USD) { origin case_input; }
        assert "f8": section_21_identification_requirements_met(entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023")) { origin case_input; }
    }
    // AGI $12,000 is below the $15,000 threshold: applicable percentage stays
    // at 35 percent; expenses $4,000 capped at the $3,000 one-child limit.
    evaluate truth(dependent_care_credit(entity_ref("urn:test:s21:w1#p"), entity_ref("urn:test:s21:w1#y2023"), 1050.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S21-02-AGI-ABOVE-THRESHOLD-PERCENTAGE-STEPS-DOWN" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::dependent_of(entity_ref("urn:test:s21:w2#child"), entity_ref("urn:test:s21:w2#p"), entity_ref("urn:test:s21:w2#y2023")) { origin case_input; }
        // AGI $18,500: excess over $15,000 is $3,500 -> 2 whole $2,000 steps
        // (ceiling) -> 35% - 2% = 33%.
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s21:w2#p"), entity_ref("urn:test:s21:w2#y2023"), 18500.00 USD) { origin case_input; }
    }
    evaluate truth(dependent_care_applicable_percentage(entity_ref("urn:test:s21:w2#p"), entity_ref("urn:test:s21:w2#y2023"), 0.33));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S21-03-NO-QUALIFYING-INDIVIDUAL-UNDETERMINED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
    }
    // Open-world: no qualifying-individual fact asserted at all -> NEITHER,
    // not "credit is zero" (same idiom as s61-gross-income.law's empty case).
    evaluate truth(dependent_care_credit(entity_ref("urn:test:s21:empty#p"), entity_ref("urn:test:s21:empty#y2023"), 0 USD));
    expect truth_status == NEITHER;
}
