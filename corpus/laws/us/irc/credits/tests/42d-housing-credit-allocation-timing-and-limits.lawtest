        assert "f5": placed_in_service_year_after_allocation_42(entity_ref("urn:test:42d:w10#b"), entity_ref("urn:test:42d:w10#a"), 2020.0, 2.0) { origin case_input; }
    }
    // (h)(1)(E)(i): placed in service in the second calendar year following the allocation year: timing met.
    evaluate truth(allocation_timing_met_42(entity_ref("urn:test:42d:w10#b"), entity_ref("urn:test:42d:w10#a"), 2020.0));
