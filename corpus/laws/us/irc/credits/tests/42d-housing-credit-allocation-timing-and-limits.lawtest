// Section 42(h) allocation timing, ceiling machinery, bond-financed buildings, commitment and limits scenarios (stage 2e).
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S42D-01-ALLOCATION-IN-PLACED-IN-SERVICE-YEAR-COUNTS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w1#b"), entity_ref("urn:test:42d:w1#a"), 2020.0, 100000.00 USD) { origin case_input; }
        assert "f1": placed_in_service_calendar_year_42(entity_ref("urn:test:42d:w1#b"), 2020.0) { origin case_input; }
    }
    // (h)(1)(B): an allocation made in the calendar year the building is placed in service is taken into account.
    evaluate truth(allocation_timing_met_42(entity_ref("urn:test:42d:w1#b"), entity_ref("urn:test:42d:w1#a"), 2020.0));
    expect truth_status == TRUE_ONLY;
}

test "S42D-02-ALLOCATION-AFTER-PLACED-IN-SERVICE-YEAR-DOES-NOT-COUNT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w2#b"), entity_ref("urn:test:42d:w2#a"), 2021.0, 100000.00 USD) { origin case_input; }
        assert "f1": placed_in_service_calendar_year_42(entity_ref("urn:test:42d:w2#b"), 2020.0) { origin case_input; }
    }
    // (h)(1)(B): an allocation made in 2021 for a building placed in service in 2020 is not taken into account absent an exception.
    evaluate truth(allocation_timing_met_42(entity_ref("urn:test:42d:w2#b"), entity_ref("urn:test:42d:w2#a"), 2021.0));
    expect truth_status == NEITHER;
}

test "S42D-03-BINDING-COMMITMENT-MAKES-LATER-ALLOCATION-COUNT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w3#b"), entity_ref("urn:test:42d:w3#a"), 2022.0, 100000.00 USD) { origin case_input; }
        assert "f1": placed_in_service_calendar_year_42(entity_ref("urn:test:42d:w3#b"), 2020.0) { origin case_input; }
        assert "f2": binding_commitment_by_close_of_placed_in_service_year_42(entity_ref("urn:test:42d:w3#b"), entity_ref("urn:test:42d:w3#a")) { origin case_input; }
    }
    // (h)(1)(C): a binding commitment by the close of the placed-in-service year to allocate beginning in a later year.
    evaluate truth(allocation_timing_met_42(entity_ref("urn:test:42d:w3#b"), entity_ref("urn:test:42d:w3#a"), 2022.0));
    expect truth_status == TRUE_ONLY;
}

test "S42D-04-INCREASE-LIMITATION-IS-CREDIT-ON-EXCESS-BASIS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_percentage_after_h_42(entity_ref("urn:test:42d:w4#b"), entity_ref("urn:test:42d:w4#y2"), 0.09) { origin case_input; }
        assert "f1": qualified_basis_first_year_of_allocation_42(entity_ref("urn:test:42d:w4#b"), 1300000.00 USD) { origin case_input; }
        assert "f2": qualified_basis_first_year_of_prior_allocation_42(entity_ref("urn:test:42d:w4#b"), 1000000.00 USD) { origin case_input; }
    }
    // (h)(1)(D)(ii): 9 percent of (1,300,000 - 1,000,000) = 27,000.
    evaluate truth(allocation_increase_limitation_42(entity_ref("urn:test:42d:w4#b"), entity_ref("urn:test:42d:w4#y2"), 27000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42D-05-INCREASE-EXCEPTION-COUNTS-ONLY-UP-TO-LIMITATION" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w5#b"), entity_ref("urn:test:42d:w5#a"), 2021.0, 40000.00 USD) { origin case_input; }
        assert "f1": first_applicable_taxable_year_end_calendar_year_42(entity_ref("urn:test:42d:w5#b"), entity_ref("urn:test:42d:w5#a"), 2021.0) { origin case_input; }
        assert "f2": applicable_percentage_after_h_42(entity_ref("urn:test:42d:w5#b"), entity_ref("urn:test:42d:w5#y2"), 0.09) { origin case_input; }
        assert "f3": qualified_basis_first_year_of_allocation_42(entity_ref("urn:test:42d:w5#b"), 1300000.00 USD) { origin case_input; }
        assert "f4": qualified_basis_first_year_of_prior_allocation_42(entity_ref("urn:test:42d:w5#b"), 1000000.00 USD) { origin case_input; }
    }
    // (h)(1)(D)(i): an allocation of 40,000 made by the close of the year in which the first applicable year ends counts only up to 27,000.
    evaluate truth(allocation_counted_for_credit_42(entity_ref("urn:test:42d:w5#b"), entity_ref("urn:test:42d:w5#a"), 2021.0, entity_ref("urn:test:42d:w5#y2"), 27000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S42D-06-INCREASE-EXCEPTION-LATE-ALLOCATION-DOES-NOT-COUNT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w6#b"), entity_ref("urn:test:42d:w6#a"), 2022.0, 40000.00 USD) { origin case_input; }
        assert "f1": first_applicable_taxable_year_end_calendar_year_42(entity_ref("urn:test:42d:w6#b"), entity_ref("urn:test:42d:w6#a"), 2021.0) { origin case_input; }
        assert "f2": applicable_percentage_after_h_42(entity_ref("urn:test:42d:w6#b"), entity_ref("urn:test:42d:w6#y2"), 0.09) { origin case_input; }
        assert "f3": qualified_basis_first_year_of_allocation_42(entity_ref("urn:test:42d:w6#b"), 1300000.00 USD) { origin case_input; }
        assert "f4": qualified_basis_first_year_of_prior_allocation_42(entity_ref("urn:test:42d:w6#b"), 1000000.00 USD) { origin case_input; }
    }
    // (h)(1)(D)(i): made in 2022, after the calendar year 2021 in which the first applicable year ends: no partial counting.
    evaluate truth(allocation_counted_for_credit_42(entity_ref("urn:test:42d:w6#b"), entity_ref("urn:test:42d:w6#a"), 2022.0, entity_ref("urn:test:42d:w6#y2"), 27000.00 USD));
