test "S42D-08-TEN-PERCENT-TEST-MET-JUST-ABOVE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": low_income_housing_building_owned_by(entity_ref("urn:test:42d:w8#b"), entity_ref("urn:test:42d:w8#t")) { origin case_input; }
        assert "f1": original_use_begins_with_taxpayer_42(entity_ref("urn:test:42d:w8#b"), entity_ref("urn:test:42d:w8#t")) { origin case_input; }
        assert "f2": reasonably_expected_basis_in_project_42(entity_ref("urn:test:42d:w8#b"), 1500000.00 USD) { origin case_input; }
        assert "f3": taxpayer_basis_in_project_one_year_after_allocation_42(entity_ref("urn:test:42d:w8#b"), 150000.01 USD) { origin case_input; }
    }
    // (h)(1)(E)(ii): basis 150,000.01 is more than 10 percent of the expected 1,500,000.
    evaluate truth(qualified_building_h1e_42(entity_ref("urn:test:42d:w8#b")));
    expect truth_status == TRUE_ONLY;
}

