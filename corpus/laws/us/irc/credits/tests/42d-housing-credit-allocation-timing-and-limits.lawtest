    }
    // (h)(1)(A) chain: credit 900,000, allocation 700,000 counted, plan conditions met, commitment in effect: 700,000.
    // The credit read by section 38(b)(5) is the credit after the limits.
    evaluate truth(low_income_housing_credit(entity_ref("urn:test:42d:w81#t"), entity_ref("urn:test:42d:w81#y1"), 700000.00 USD));
    expect truth_status == TRUE_ONLY;
}

