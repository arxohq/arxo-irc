test "S42D-16-ALLOCATION-APPLIES-TO-COMPLIANCE-YEAR-ENDING-AFTER-ALLOCATION-YEAR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": building_placed_in_service_on_42(entity_ref("urn:test:42d:w16#b"), @2020-06-15) { origin case_input; }
        assert "f1": qualified_low_income_building_at_first_year_close_42(entity_ref("urn:test:42d:w16#b")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:42d:w16#y1"), @2020-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:42d:w16#y1"), @2020-12-31) { origin case_input; }
        assert "f4": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w16#b"), entity_ref("urn:test:42d:w16#a"), 2020.0, 100000.00 USD) { origin case_input; }
        assert "f5": first_day_of_calendar_year_42(2020.0, @2020-01-01) { origin case_input; }
        assert "f6": us.irc.core::begins(entity_ref("urn:test:42d:w16#y3"), @2022-01-01) { origin case_input; }
        assert "f7": us.irc.core::ends(entity_ref("urn:test:42d:w16#y3"), @2022-12-31) { origin case_input; }
    }
    // (h)(2)(A): the allocation of 2020 applies to the compliance-period year 2022 (ends 2022-12-31, after 2020-01-01).
    evaluate truth(allocation_applies_to_taxable_year_42(entity_ref("urn:test:42d:w16#b"), entity_ref("urn:test:42d:w16#a"), 2020.0, entity_ref("urn:test:42d:w16#y3")));
    expect truth_status == TRUE_ONLY;
}

