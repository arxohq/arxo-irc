        assert "f3": us.irc.core::ends(entity_ref("urn:test:42d:w17#y1"), @2020-12-31) { origin case_input; }
        assert "f4": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w17#b"), entity_ref("urn:test:42d:w17#a"), 2023.0, 100000.00 USD) { origin case_input; }
        assert "f5": first_day_of_calendar_year_42(2023.0, @2023-01-01) { origin case_input; }
        assert "f6": us.irc.core::begins(entity_ref("urn:test:42d:w17#y3"), @2022-01-01) { origin case_input; }
        assert "f7": us.irc.core::ends(entity_ref("urn:test:42d:w17#y3"), @2022-12-31) { origin case_input; }
    }
    // (h)(2)(A): the allocation of 2023 does not apply to the year ending 2022-12-31.
    evaluate truth(allocation_applies_to_taxable_year_42(entity_ref("urn:test:42d:w17#b"), entity_ref("urn:test:42d:w17#a"), 2023.0, entity_ref("urn:test:42d:w17#y3")));
    expect truth_status == NEITHER;
}

