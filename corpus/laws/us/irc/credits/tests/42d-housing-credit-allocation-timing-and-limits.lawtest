        }
        assert "f0": housing_credit_dollar_amount_allocated_42(entity_ref("urn:test:42d:w7#b"), entity_ref("urn:test:42d:w7#a"), 2021.0, 40000.00 USD) { origin case_input; }
        assert "f1": first_applicable_taxable_year_end_calendar_year_42(entity_ref("urn:test:42d:w7#b"), entity_ref("urn:test:42d:w7#a"), 2021.0) { origin case_input; }
    }
    // (h)(1)(D)(iii): the full 40,000 is taken into account under paragraph (2) although only 27,000 counts for the credit.
    evaluate truth(allocation_full_amount_reduces_agency_amount_42(entity_ref("urn:test:42d:w7#b"), entity_ref("urn:test:42d:w7#a"), 2021.0, 40000.00 USD));
