// Sections 45Y and 48E scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45Y-01-ZERO-EMISSIONS-QUALIFIES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": owned_and_used_for_electricity_generation(entity_ref("urn:test:s45y:w1#f"), entity_ref("urn:test:s45y:w1#t")) { origin case_input; }
        assert "f2": placed_in_service_date_45y(entity_ref("urn:test:s45y:w1#f"), @2025-01-15) { origin case_input; }
        assert "f3": greenhouse_gas_emissions_rate_45y(entity_ref("urn:test:s45y:w1#f"), 0.0) { origin case_input; }
    }
    evaluate truth(qualified_facility_45y(entity_ref("urn:test:s45y:w1#f"), entity_ref("urn:test:s45y:w1#t")));
    expect truth_status == TRUE_ONLY;
}

test "S45Y-02-POSITIVE-EMISSIONS-DOES-NOT-QUALIFY" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": owned_and_used_for_electricity_generation(entity_ref("urn:test:s45y:w2#f"), entity_ref("urn:test:s45y:w2#t")) { origin case_input; }
        assert "f2": placed_in_service_date_45y(entity_ref("urn:test:s45y:w2#f"), @2025-01-15) { origin case_input; }
        assert "f3": greenhouse_gas_emissions_rate_45y(entity_ref("urn:test:s45y:w2#f"), 50.0) { origin case_input; }
    }
    // 50 grams CO2e/kWh > 0 — no rule concludes qualified_facility_45y.
    evaluate truth(qualified_facility_45y(entity_ref("urn:test:s45y:w2#f"), entity_ref("urn:test:s45y:w2#t")));
    expect truth_status == NEITHER;
}

test "S45Y-03-BASE-RATE-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": owned_and_used_for_electricity_generation(entity_ref("urn:test:s45y:w3#f"), entity_ref("urn:test:s45y:w3#t")) { origin case_input; }
        assert "f2": placed_in_service_date_45y(entity_ref("urn:test:s45y:w3#f"), @2025-01-15) { origin case_input; }
        assert "f3": greenhouse_gas_emissions_rate_45y(entity_ref("urn:test:s45y:w3#f"), 0.0) { origin case_input; }
        assert "f4": electricity_sale_date_45y(entity_ref("urn:test:s45y:w3#f"), entity_ref("urn:test:s45y:w3#y1"), @2025-06-01) { origin case_input; }
        assert "f5": kilowatt_hours_produced_45y(entity_ref("urn:test:s45y:w3#f"), entity_ref("urn:test:s45y:w3#y1"), 2000000.0) { origin case_input; }
    }
    // base rate 0.3 cents; (0.3/100)*2,000,000 = 6000.00.
    evaluate truth(clean_electricity_production_credit(entity_ref("urn:test:s45y:w3#f"), entity_ref("urn:test:s45y:w3#y1"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

