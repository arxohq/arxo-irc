test "S30CD-01-CLEAN-FUEL-85-PERCENT-LISTED-COMPONENTS" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fuel_kind_30c(entity_ref("urn:test:s30cd:w1#fu"), HighBlendGaseousOrEthanolFuel) { origin case_input; }
        assert "f1": fuel_listed_component_share_30c(entity_ref("urn:test:s30cd:w1#fu"), 0.85) { origin case_input; }
    }
    evaluate truth(clean_burning_fuel_30c(entity_ref("urn:test:s30cd:w1#fu")));
    expect truth_status == TRUE_ONLY;
}

