        assert "f3": us.irc.core::begins(entity_ref("urn:test:s3 45aa credit through components#y"), @2025-01-01) { origin case_input; }
        assert "f4": us.irc.core::ends(entity_ref("urn:test:s3 45aa credit through components#y"), @2025-12-31) { origin case_input; }
        assert "f5": married_to_active_duty_uniformed_member_45aa(entity_ref("urn:test:s3 45aa credit through components#e"), entity_ref("urn:test:s3 45aa credit through components#r")) { origin case_input; }
        assert "f6": plan_admits_military_spouses_within_two_months_45aa(entity_ref("urn:test:s3 45aa credit through components#r"), entity_ref("urn:test:s3 45aa credit through components#y")) { origin case_input; }
        assert "f7": plan_immediate_employer_contribution_eligibility_45aa(entity_ref("urn:test:s3 45aa credit through components#r"), entity_ref("urn:test:s3 45aa credit through components#y")) { origin case_input; }
        assert "f8": plan_immediate_vesting_of_employer_contributions_45aa(entity_ref("urn:test:s3 45aa credit through components#r"), entity_ref("urn:test:s3 45aa credit through components#y")) { origin case_input; }
