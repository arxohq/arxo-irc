test "S3 45AAd military spouse married on active duty" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": married_to_active_duty_uniformed_member_45aa(entity_ref("urn:test:s3 45aad military spouse married on active duty#e"), entity_ref("urn:test:s3 45aad military spouse married on active duty#r")) { origin case_input; }
    }
    evaluate truth(military_spouse_45aa(entity_ref("urn:test:s3 45aad military spouse married on active duty#e"), entity_ref("urn:test:s3 45aad military spouse married on active duty#r")));
    expect truth_status == TRUE_ONLY;
}

