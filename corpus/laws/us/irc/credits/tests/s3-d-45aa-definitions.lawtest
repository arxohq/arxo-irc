    evaluate truth(military_spouse_credit_per_employee_45aa(entity_ref("urn:test:s3 45aa credit through components#r"), entity_ref("urn:test:s3 45aa credit through components#e"), entity_ref("urn:test:s3 45aa credit through components#y"), 200.00 USD));
