        }
        assert "f0": eligible_small_employer_45aa(entity_ref("urn:test:s3 45aa credit through components#r"), entity_ref("urn:test:s3 45aa credit through components#y")) { origin case_input; }
        assert "f1": participates_in_plan_during_year_45aa(entity_ref("urn:test:s3 45aa credit through components#e"), entity_ref("urn:test:s3 45aa credit through components#r"), entity_ref("urn:test:s3 45aa credit through components#y")) { origin case_input; }
