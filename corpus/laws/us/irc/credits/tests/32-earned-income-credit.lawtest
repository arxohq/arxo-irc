test "S32-17-2025-DISQUALIFIED-INCOME-BARS-CREDIT" {
    given {
        context {
            legal_time @2025-06-30; decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": eic_eligible_individual(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025")) { origin case_input; }
        assert "f2": qualifying_child_count_band(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), One) { origin case_input; }
        assert "f3": earned_income_32(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 15000.00 USD) { origin case_input; }
        assert "f4": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 15000.00 USD) { origin case_input; }
        assert "f5": disqualified_interest_dividends_32i2A(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 9000.00 USD) { origin case_input; }
        assert "f6": disqualified_tax_exempt_interest_32i2B(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 1000.00 USD) { origin case_input; }
        assert "f7": disqualified_rent_royalty_excess_32i2C(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 500.00 USD) { origin case_input; }
        assert "f8": us.irc.property_transactions::capital_gain_net_income(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 2000.00 USD) { origin case_input; }
        assert "f9": disqualified_passive_excess_32i2E(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 500.00 USD) { origin case_input; }
    }
    evaluate truth(earned_income_credit(entity_ref("urn:test:s32:w17#p"), entity_ref("urn:test:s32:w17#y2025"), 4328.20 USD));
    expect truth_status == NEITHER;
    description "2025, 1 child: disqualified aggregate 9000 + 1000 + 500 + 2000 + 500 = 13000 exceeds the 11950 limit, so no credit is allowed";
}

