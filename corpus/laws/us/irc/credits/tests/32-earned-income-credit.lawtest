test "S32-07-DISALLOWANCE-PERIOD-BARS-CREDIT" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": eic_eligible_individual(entity_ref("urn:test:s32:w7#p"), entity_ref("urn:test:s32:w7#y2023")) { origin case_input; }
        assert "f1": qualifying_child_count_band(entity_ref("urn:test:s32:w7#p"), entity_ref("urn:test:s32:w7#y2023"), Zero) { origin case_input; }
        assert "f2": earned_income_32(entity_ref("urn:test:s32:w7#p"), entity_ref("urn:test:s32:w7#y2023"), 8000.00 USD) { origin case_input; }
        assert "f3": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s32:w7#p"), entity_ref("urn:test:s32:w7#y2023"), 8000.00 USD) { origin case_input; }
        assert "f4": eic_earned_income_amount(Zero, entity_ref("urn:test:s32:w7#y2023"), 8000.00 USD) { origin case_input; }
        assert "f5": eic_phaseout_amount(Zero, entity_ref("urn:test:s32:w7#p"), entity_ref("urn:test:s32:w7#y2023"), 20000.00 USD) { origin case_input; }
        assert "f6": in_disallowance_period_32k(entity_ref("urn:test:s32:w7#p"), entity_ref("urn:test:s32:w7#y2023")) { origin case_input; }
    }
    evaluate truth(earned_income_credit(entity_ref("urn:test:s32:w7#p"), entity_ref("urn:test:s32:w7#y2023"), 612.00 USD));
    expect truth_status == NEITHER;
}

test "S32-08-CREDIT-COMPUTES-WITH-DIRECTLY-ASSERTED-TABLE-VALUES" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        // Demonstrates the (a)/(b) FORMULA is correct once the (j)-adjusted
        // dollar amounts are supplied directly by the case (bypassing the
        // SOURCE_GAP COLA multiplier) — not a claim that this package
        // computes these amounts for a real year on its own.
        assert "f0": eic_eligible_individual(entity_ref("urn:test:s32:w8#p"), entity_ref("urn:test:s32:w8#y2023")) { origin case_input; }
        assert "f1": qualifying_child_count_band(entity_ref("urn:test:s32:w8#p"), entity_ref("urn:test:s32:w8#y2023"), Zero) { origin case_input; }
        assert "f2": earned_income_32(entity_ref("urn:test:s32:w8#p"), entity_ref("urn:test:s32:w8#y2023"), 8000.00 USD) { origin case_input; }
        assert "f3": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s32:w8#p"), entity_ref("urn:test:s32:w8#y2023"), 8000.00 USD) { origin case_input; }
        assert "f4": eic_earned_income_amount(Zero, entity_ref("urn:test:s32:w8#y2023"), 8000.00 USD) { origin case_input; }
        assert "f5": eic_phaseout_amount(Zero, entity_ref("urn:test:s32:w8#p"), entity_ref("urn:test:s32:w8#y2023"), 20000.00 USD) { origin case_input; }
    }
    // 7.65% of $8,000 = $612; AGI $8,000 < $20,000 phaseout amount, so the
    // (a)(2) cap does not bind.
    evaluate truth(earned_income_credit(entity_ref("urn:test:s32:w8#p"), entity_ref("urn:test:s32:w8#y2023"), 612.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

