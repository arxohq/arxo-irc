        assert "f1": eic_eligible_individual(entity_ref("urn:test:s32:w15#p"), entity_ref("urn:test:s32:w15#y2025")) { origin case_input; }
        assert "f2": qualifying_child_count_band(entity_ref("urn:test:s32:w15#p"), entity_ref("urn:test:s32:w15#y2025"), One) { origin case_input; }
        assert "f3": earned_income_32(entity_ref("urn:test:s32:w15#p"), entity_ref("urn:test:s32:w15#y2025"), 40000.00 USD) { origin case_input; }
        assert "f4": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s32:w15#p"), entity_ref("urn:test:s32:w15#y2025"), 40000.00 USD) { origin case_input; }
    }
    evaluate truth(earned_income_credit(entity_ref("urn:test:s32:w15#p"), entity_ref("urn:test:s32:w15#y2025"), 2805.31 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    description "2025, 1 child, joint: 34% of 12730 = 4328.20 less 15.98% of (40000 - 30470) = 1522.89, credit 2805.31; the 30470 joint threshold (not other + 5000) applies";
}

