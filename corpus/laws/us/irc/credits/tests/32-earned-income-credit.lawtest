// Section 32 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).
//
// S32-01 through S32-09 test the STRUCTURE — the qualifying-child band,
// eligibility, and the pinned statutory-base table lookups
// (`eic_credit_percentage`/`eic_phaseout_percentage`, which are NOT
// COLA-adjusted and DO resolve). S32-10 onward test full DOLLAR credit
// amounts for years with pinned Rev. Proc. figures (2025: Rev. Proc.
// 2024-40 §2.06; 2026: Rev. Proc. 2025-32 §4.06), read as A3 parameters;
// every expectation below is hand-computed from the section 32(b) formula
// and the published table, and each test carries its arithmetic in
// `description`. Years without a pinned Rev. Proc. remain an honest
// refusal (no scenario asserts them).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S32-01-ZERO-QUALIFYING-CHILDREN-BAND-AND-PERCENTAGES" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s32:w0#p"), entity_ref("urn:test:s32:w0#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
    }
    evaluate truth(qualifying_child_count_band(entity_ref("urn:test:s32:w0#p"), entity_ref("urn:test:s32:w0#y2023"), Zero));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
test "S32-01B-ZERO-CHILDREN-CREDIT-PERCENTAGE-IS-765" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
    }
    evaluate truth(eic_credit_percentage(Zero, 0.0765));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

