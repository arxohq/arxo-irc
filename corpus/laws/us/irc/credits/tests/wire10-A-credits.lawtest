// WIRE-10 group A scenarios for module 96-wire10-A-credits.law of package us.irc.credits. NOT EXECUTED (implemented_unverified); no legal review.
// The consumer (us.irc.alcohol) computes the section 5011(a) lot credit; the owner sums it into the section 38(b)(20) component.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "W10A-CR-01-TWO-LOT-CREDITS-SUM-INTO-COMPONENT-20" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:w10a:cr1#t"), entity_ref("urn:test:w10a:cr1#y")) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:w10a:cr1#y"), 2025) { origin case_input; }
        assert "f2": us.irc.alcohol::lot_credit_year(entity_ref("urn:test:w10a:cr1#lot1"), 2025) { origin case_input; }
        assert "f3": us.irc.alcohol::lot_credit_year(entity_ref("urn:test:w10a:cr1#lot2"), 2025) { origin case_input; }
        assert "f4": us.irc.alcohol::distilled_spirits_credit_for_lot(entity_ref("urn:test:w10a:cr1#lot1"), entity_ref("urn:test:w10a:cr1#t"), 100.00 USD) { origin case_input; }
        assert "f5": us.irc.alcohol::distilled_spirits_credit_for_lot(entity_ref("urn:test:w10a:cr1#lot2"), entity_ref("urn:test:w10a:cr1#t"), 50.25 USD) { origin case_input; }
    }
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:w10a:cr1#t"), entity_ref("urn:test:w10a:cr1#y"), DistilledSpiritsCredit5011, 150.25 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10A-CR-02-LOT-OF-ANOTHER-CALENDAR-YEAR-IS-NOT-SUMMED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:w10a:cr2#t"), entity_ref("urn:test:w10a:cr2#y")) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:w10a:cr2#y"), 2025) { origin case_input; }
        assert "f2": us.irc.alcohol::lot_credit_year(entity_ref("urn:test:w10a:cr2#lot1"), 2025) { origin case_input; }
        assert "f3": us.irc.alcohol::lot_credit_year(entity_ref("urn:test:w10a:cr2#lot2"), 2024) { origin case_input; }
        assert "f4": us.irc.alcohol::distilled_spirits_credit_for_lot(entity_ref("urn:test:w10a:cr2#lot1"), entity_ref("urn:test:w10a:cr2#t"), 100.00 USD) { origin case_input; }
        assert "f5": us.irc.alcohol::distilled_spirits_credit_for_lot(entity_ref("urn:test:w10a:cr2#lot2"), entity_ref("urn:test:w10a:cr2#t"), 50.25 USD) { origin case_input; }
    }
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:w10a:cr2#t"), entity_ref("urn:test:w10a:cr2#y"), DistilledSpiritsCredit5011, 100.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10A-CR-03-NO-LOT-CREDIT-LEAVES-THE-COMPONENT-UNDERIVED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:w10a:cr3#t"), entity_ref("urn:test:w10a:cr3#y")) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:w10a:cr3#y"), 2025) { origin case_input; }
    }
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:w10a:cr3#t"), entity_ref("urn:test:w10a:cr3#y"), DistilledSpiritsCredit5011, 0.00 USD));
    expect truth_status == NEITHER;
}

test "W10A-CR-04-CASE-FACT-CHANNEL-STILL-ACCEPTS-THE-COMPONENT" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": general_business_credit_component_amount(entity_ref("urn:test:w10a:cr4#t"), entity_ref("urn:test:w10a:cr4#y"), DistilledSpiritsCredit5011, 75.00 USD) { origin case_input; }
    }
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:w10a:cr4#t"), entity_ref("urn:test:w10a:cr4#y"), DistilledSpiritsCredit5011, 75.00 USD));
    expect truth_status == TRUE_ONLY;
}
