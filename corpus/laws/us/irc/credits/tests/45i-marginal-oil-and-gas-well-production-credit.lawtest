        assert "f9": elects_not_to_claim_section_45k_for_well_45i(entity_ref("urn:test:45i:w11#t"), entity_ref("urn:test:45i:w11#wl"), entity_ref("urn:test:45i:w11#y")) { origin case_input; }
    }
    // (d)(3): the election out of section 45K allows this credit.
    evaluate truth(marginal_well_credit_per_well_45i(entity_ref("urn:test:45i:w11#t"), entity_ref("urn:test:45i:w11#wl"), entity_ref("urn:test:45i:w11#y"), 2400.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45I-12-YEAR-2007-INDEXED-THRESHOLDS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": holds_operating_interest_45i(entity_ref("urn:test:45i:w12#t"), entity_ref("urn:test:45i:w12#wl")) { origin case_input; }
        assert "f1": well_production_45i(entity_ref("urn:test:45i:w12#wl"), entity_ref("urn:test:45i:w12#y"), 800.0, 0.0, 0.0) { origin case_input; }
        assert "f2": well_days_of_production_45i(entity_ref("urn:test:45i:w12#wl"), entity_ref("urn:test:45i:w12#y"), 365.0) { origin case_input; }
        assert "f3": revenue_interest_ratio_45i(entity_ref("urn:test:45i:w12#t"), entity_ref("urn:test:45i:w12#wl"), entity_ref("urn:test:45i:w12#y"), 1.0) { origin case_input; }
        assert "f4": reference_price_crude_preceding_year_45i(entity_ref("urn:test:45i:w12#y"), 18.15) { origin case_input; }
        assert "f5": reference_price_gas_preceding_year_45i(entity_ref("urn:test:45i:w12#y"), 1.5) { origin case_input; }
        assert "f6": us.irc.core::begins(entity_ref("urn:test:45i:w12#y"), @2007-01-01) { origin case_input; }
        assert "f7": marginal_production_under_613a_c6_45i(entity_ref("urn:test:45i:w12#wl"), entity_ref("urn:test:45i:w12#y")) { origin case_input; }
        assert "f8": inflation_adjustment_factor_45i(entity_ref("urn:test:45i:w12#y"), 1.1) { origin case_input; }
    }
    // thresholds 15 x 1.1 = 16.5 and 3 x 1.1 = 3.3: (18.15-16.5)/3.3 = 0.5: 1.50 x 800.
    evaluate truth(marginal_well_credit_per_well_45i(entity_ref("urn:test:45i:w12#t"), entity_ref("urn:test:45i:w12#wl"), entity_ref("urn:test:45i:w12#y"), 1200.00 USD));
    expect truth_status == TRUE_ONLY;
}
