// Section 45I scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45I-01-NO-PRICE-REDUCTION-3-DOLLARS-PER-BARREL" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": holds_operating_interest_45i(entity_ref("urn:test:45i:w1#t"), entity_ref("urn:test:45i:w1#wl")) { origin case_input; }
        assert "f1": well_production_45i(entity_ref("urn:test:45i:w1#wl"), entity_ref("urn:test:45i:w1#y"), 800.0, 0.0, 0.0) { origin case_input; }
        assert "f2": well_days_of_production_45i(entity_ref("urn:test:45i:w1#wl"), entity_ref("urn:test:45i:w1#y"), 365.0) { origin case_input; }
        assert "f3": revenue_interest_ratio_45i(entity_ref("urn:test:45i:w1#t"), entity_ref("urn:test:45i:w1#wl"), entity_ref("urn:test:45i:w1#y"), 1.0) { origin case_input; }
        assert "f4": reference_price_crude_preceding_year_45i(entity_ref("urn:test:45i:w1#y"), 12.0) { origin case_input; }
        assert "f5": reference_price_gas_preceding_year_45i(entity_ref("urn:test:45i:w1#y"), 1.5) { origin case_input; }
        assert "f6": us.irc.core::begins(entity_ref("urn:test:45i:w1#y"), @2005-01-01) { origin case_input; }
        assert "f7": marginal_production_under_613a_c6_45i(entity_ref("urn:test:45i:w1#wl"), entity_ref("urn:test:45i:w1#y")) { origin case_input; }
    }
    // reference price 12 is below 15: 3.00 x 800 barrels = 2,400.
    evaluate truth(marginal_well_credit_per_well_45i(entity_ref("urn:test:45i:w1#t"), entity_ref("urn:test:45i:w1#wl"), entity_ref("urn:test:45i:w1#y"), 2400.00 USD));
    expect truth_status == TRUE_ONLY;
}

