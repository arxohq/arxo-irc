test "S45SD-01-HOURLY-WAGE-CAP" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": normal_hourly_wage_rate_45s(entity_ref("urn:test:s45sd:w1#ee"), entity_ref("urn:test:s45sd:w1#y"), 25.50 USD) { origin case_input; }
        assert "f1": hours_of_family_and_medical_leave_taken_45s(entity_ref("urn:test:s45sd:w1#ee"), entity_ref("urn:test:s45sd:w1#y"), 80.0) { origin case_input; }
    }
    evaluate truth(hourly_wage_cap_45s(entity_ref("urn:test:s45sd:w1#ee"), entity_ref("urn:test:s45sd:w1#y"), 2040.00 USD));
    expect truth_status == TRUE_ONLY;
}

