        assert "f4": normal_hourly_wage_rate_45s(entity_ref("urn:test:s45sd:w2#ee"), entity_ref("urn:test:s45sd:w2#y"), 25.00 USD) { origin case_input; }
        assert "f5": hours_of_family_and_medical_leave_taken_45s(entity_ref("urn:test:s45sd:w2#ee"), entity_ref("urn:test:s45sd:w2#y"), 80.0) { origin case_input; }
