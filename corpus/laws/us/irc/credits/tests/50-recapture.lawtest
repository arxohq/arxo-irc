// Section 50 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S50-01-DISPOSITION-WITHIN-FIRST-YEAR-100-PERCENT-RECAPTURE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": investment_credit_property_disposed_before_recapture_period_ends(entity_ref("urn:test:s50:w1#prop"), entity_ref("urn:test:s50:w1#p"), entity_ref("urn:test:s50:w1#y1"), 0.5) { origin case_input; }
        assert "f2": aggregate_prior_investment_credit_amount(entity_ref("urn:test:s50:w1#prop"), entity_ref("urn:test:s50:w1#p"), 10000.00 USD) { origin case_input; }
    }
    // Within the first full year: 100 percent recapture percentage.
    evaluate truth(credit_recapture_50(entity_ref("urn:test:s50:w1#p"), entity_ref("urn:test:s50:w1#y1"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S50-02-DISPOSITION-AFTER-TWO-FULL-YEARS-60-PERCENT-RECAPTURE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": investment_credit_property_disposed_before_recapture_period_ends(entity_ref("urn:test:s50:w2#prop"), entity_ref("urn:test:s50:w2#p"), entity_ref("urn:test:s50:w2#y1"), 2.5) { origin case_input; }
        assert "f2": aggregate_prior_investment_credit_amount(entity_ref("urn:test:s50:w2#prop"), entity_ref("urn:test:s50:w2#p"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(credit_recapture_50(entity_ref("urn:test:s50:w2#p"), entity_ref("urn:test:s50:w2#y1"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S50-03-USED-OUTSIDE-UNITED-STATES-INELIGIBLE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": used_predominantly_outside_united_states(entity_ref("urn:test:s50:w3#prop"), entity_ref("urn:test:s50:w3#y1")) { origin case_input; }
    }
    evaluate truth(investment_credit_property_ineligible(entity_ref("urn:test:s50:w3#prop"), entity_ref("urn:test:s50:w3#y1")));
    expect truth_status == TRUE_ONLY;
}
