    evaluate truth(qualified_adoption_expenses(entity_ref("urn:test:s23:w5#p"), entity_ref("urn:test:s23:w5#child"), entity_ref("urn:test:s23:w5#y2023"), 7000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S23-06-UNKNOWN-AGI-UNDETERMINED" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
