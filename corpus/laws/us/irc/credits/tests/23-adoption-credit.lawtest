        assert "f0": child_with_special_needs(entity_ref("urn:test:s23:w5#child"), entity_ref("urn:test:s23:w5#y2023")) { origin case_input; }
        assert "f1": adoption_becomes_final_in_year(entity_ref("urn:test:s23:w5#p"), entity_ref("urn:test:s23:w5#child"), entity_ref("urn:test:s23:w5#y2023")) { origin case_input; }
        assert "f2": aggregate_qualified_adoption_expenses_prior_years(entity_ref("urn:test:s23:w5#p"), entity_ref("urn:test:s23:w5#child"), entity_ref("urn:test:s23:w5#y2023"), 3000.00 USD) { origin case_input; }
