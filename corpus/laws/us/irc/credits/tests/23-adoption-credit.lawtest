// Section 23 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S23-01-BELOW-PHASEOUT-THRESHOLD-FULL-CREDIT" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "fs": us.irc.income_individual::filing_status(entity_ref("urn:test:s23:w1#p"), entity_ref("urn:test:s23:w1#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f0": qualified_adoption_expenses(entity_ref("urn:test:s23:w1#p"), entity_ref("urn:test:s23:w1#child"), entity_ref("urn:test:s23:w1#y2023"), 6000.00 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s23:w1#p"), entity_ref("urn:test:s23:w1#y2023"), 100000.00 USD) { origin case_input; }
        assert "f2": adoption_credit_agi_23b2b(entity_ref("urn:test:s23:w1#p"), entity_ref("urn:test:s23:w1#y2023"), 100000.00 USD) { origin case_input; }
    }
    // AGI $100,000 < $150,000: no phase-out.
    evaluate truth(adoption_credit(entity_ref("urn:test:s23:w1#p"), entity_ref("urn:test:s23:w1#y2023"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S23-02-ABOVE-EXPENSE-CAP-LIMITED-TO-10000" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "fs": us.irc.income_individual::filing_status(entity_ref("urn:test:s23:w2#p"), entity_ref("urn:test:s23:w2#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f0": qualified_adoption_expenses(entity_ref("urn:test:s23:w2#p"), entity_ref("urn:test:s23:w2#child"), entity_ref("urn:test:s23:w2#y2023"), 14000.00 USD) { origin case_input; }
        assert "f1": adoption_credit_agi_23b2b(entity_ref("urn:test:s23:w2#p"), entity_ref("urn:test:s23:w2#y2023"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(aggregate_qualified_adoption_expenses_all_years(entity_ref("urn:test:s23:w2#p"), entity_ref("urn:test:s23:w2#child"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S23-03-AGI-MIDWAY-THROUGH-PHASEOUT-BAND" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "fs": us.irc.income_individual::filing_status(entity_ref("urn:test:s23:w3#p"), entity_ref("urn:test:s23:w3#y2023"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f0": qualified_adoption_expenses(entity_ref("urn:test:s23:w3#p"), entity_ref("urn:test:s23:w3#child"), entity_ref("urn:test:s23:w3#y2023"), 10000.00 USD) { origin case_input; }
        // AGI $170,000: halfway through the $150,000-$190,000 band -> 50% reduction.
        assert "f1": adoption_credit_agi_23b2b(entity_ref("urn:test:s23:w3#p"), entity_ref("urn:test:s23:w3#y2023"), 170000.00 USD) { origin case_input; }
    }
    evaluate truth(adoption_credit(entity_ref("urn:test:s23:w3#p"), entity_ref("urn:test:s23:w3#y2023"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

