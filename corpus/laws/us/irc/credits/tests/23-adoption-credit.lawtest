        assert "f0": qualified_adoption_expenses(entity_ref("urn:test:s23:w6#p"), entity_ref("urn:test:s23:w6#child"), entity_ref("urn:test:s23:w6#y2023"), 6000.00 USD) { origin case_input; }
        // No adoption_credit_agi_23b2b asserted.
    }
    evaluate truth(adoption_credit(entity_ref("urn:test:s23:w6#p"), entity_ref("urn:test:s23:w6#y2023"), 6000.00 USD));
