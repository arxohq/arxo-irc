        assert "f0": qualified_adoption_expenses(entity_ref("urn:test:s23:w4#p"), entity_ref("urn:test:s23:w4#child"), entity_ref("urn:test:s23:w4#y2023"), 10000.00 USD) { origin case_input; }
        assert "f1": adoption_credit_agi_23b2b(entity_ref("urn:test:s23:w4#p"), entity_ref("urn:test:s23:w4#y2023"), 200000.00 USD) { origin case_input; }
    }
    evaluate truth(adoption_credit(entity_ref("urn:test:s23:w4#p"), entity_ref("urn:test:s23:w4#y2023"), 0 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S23-05-SPECIAL-NEEDS-DEEMED-10000-EXPENSE" {
    given {
        context {
            legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00;
