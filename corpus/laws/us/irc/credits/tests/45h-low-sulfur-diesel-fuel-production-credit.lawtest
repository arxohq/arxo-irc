        }
        assert "f0": individuals_engaged_in_refinery_operations_45h(entity_ref("urn:test:45h:w7#t"), entity_ref("urn:test:45h:w7#y"), 1000.0) { origin case_input; }
        assert "f1": average_daily_refinery_run_2002_45h(entity_ref("urn:test:45h:w7#t"), 100000.0) { origin case_input; }
        assert "f2": low_sulfur_diesel_gallons_45h(entity_ref("urn:test:45h:w7#t"), entity_ref("urn:test:45h:w7#fa"), entity_ref("urn:test:45h:w7#y"), 1000000.0) { origin case_input; }
        assert "f3": qualified_costs_45h(entity_ref("urn:test:45h:w7#t"), entity_ref("urn:test:45h:w7#fa"), 1000000.00 USD) { origin case_input; }
        assert "f4": prior_year_credits_for_facility_45h(entity_ref("urn:test:45h:w7#t"), entity_ref("urn:test:45h:w7#fa"), entity_ref("urn:test:45h:w7#y"), 0 USD) { origin case_input; }
