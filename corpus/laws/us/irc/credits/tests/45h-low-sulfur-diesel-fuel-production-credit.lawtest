// Section 45H scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45H-01-FIVE-CENTS-PER-GALLON-BELOW-LIMIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": individuals_engaged_in_refinery_operations_45h(entity_ref("urn:test:45h:w1#t"), entity_ref("urn:test:45h:w1#y"), 1000.0) { origin case_input; }
        assert "f1": average_daily_refinery_run_2002_45h(entity_ref("urn:test:45h:w1#t"), 100000.0) { origin case_input; }
        assert "f2": low_sulfur_diesel_gallons_45h(entity_ref("urn:test:45h:w1#t"), entity_ref("urn:test:45h:w1#fa"), entity_ref("urn:test:45h:w1#y"), 1000000.0) { origin case_input; }
        assert "f3": qualified_costs_45h(entity_ref("urn:test:45h:w1#t"), entity_ref("urn:test:45h:w1#fa"), 1000000.00 USD) { origin case_input; }
        assert "f4": prior_year_credits_for_facility_45h(entity_ref("urn:test:45h:w1#t"), entity_ref("urn:test:45h:w1#fa"), entity_ref("urn:test:45h:w1#y"), 0 USD) { origin case_input; }
        assert "f5": first_credit_year_begins_45h(entity_ref("urn:test:45h:w1#fa"), @2004-01-01) { origin case_input; }
        assert "f6": certification_issued_on_45h(entity_ref("urn:test:45h:w1#fa"), @2004-08-01) { origin case_input; }
    }
    // 1,000,000 gallons x 5 cents = 50,000; limit 25% of 1,000,000 = 250,000.
    evaluate truth(low_sulfur_diesel_credit_per_facility_45h(entity_ref("urn:test:45h:w1#t"), entity_ref("urn:test:45h:w1#fa"), entity_ref("urn:test:45h:w1#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

