test "S41G-01-EXCESS-OVER-THE-PASS-THRU-LIMIT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": research_credit_before_41g(entity_ref("urn:test:c41g:t1#t"), entity_ref("urn:test:c41g:t1#y"), 1300 USD) { origin case_input; }
        assert "f1": owns_interest_in_unincorporated_business_41g(entity_ref("urn:test:c41g:t1#t"), entity_ref("urn:test:c41g:t1#y")) { origin case_input; }
        assert "f2": tax_attributable_to_pass_thru_interest_41g(entity_ref("urn:test:c41g:t1#t"), entity_ref("urn:test:c41g:t1#y"), 600 USD) { origin case_input; }
    }
    evaluate truth(research_credit_excess_over_41g_limit(entity_ref("urn:test:c41g:t1#t"), entity_ref("urn:test:c41g:t1#y"), 700 USD));
    expect truth_status == TRUE_ONLY;
}

test "S41G-02-CARRYBACK-WITH-THE-41G-LIMIT-IN-LIEU-OF-38C" {
    // Room of the carryback year: 900 - 500 = 400; excess 700: the carryback is 400.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": research_credit_before_41g(entity_ref("urn:test:c41g:t2#t"), entity_ref("urn:test:c41g:t2#y"), 1300 USD) { origin case_input; }
        assert "f1": owns_interest_in_unincorporated_business_41g(entity_ref("urn:test:c41g:t2#t"), entity_ref("urn:test:c41g:t2#y")) { origin case_input; }
        assert "f2": tax_attributable_to_pass_thru_interest_41g(entity_ref("urn:test:c41g:t2#t"), entity_ref("urn:test:c41g:t2#y"), 600 USD) { origin case_input; }
        assert "f3": preceding_taxable_year_of(entity_ref("urn:test:c41g:t2#y"), entity_ref("urn:test:c41g:t2#cy")) { origin case_input; }
        assert "f4": tax_attributable_to_pass_thru_interest_41g(entity_ref("urn:test:c41g:t2#t"), entity_ref("urn:test:c41g:t2#cy"), 900 USD) { origin case_input; }
        assert "f5": research_credit(entity_ref("urn:test:c41g:t2#t"), entity_ref("urn:test:c41g:t2#cy"), 500 USD) { origin case_input; }
    }
    evaluate truth(research_credit_41g_carryback_to_year(entity_ref("urn:test:c41g:t2#t"), entity_ref("urn:test:c41g:t2#y"), entity_ref("urn:test:c41g:t2#cy"), 400 USD));
    expect truth_status == TRUE_ONLY;
}

