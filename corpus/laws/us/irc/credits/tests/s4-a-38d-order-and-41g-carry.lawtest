// Stage 4 scenarios: section 38(d) order of use and section 41(g) carry (module s4-a). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";


test "S38D-01-CREDITS-USED-IN-THE-ORDER-OF-SECTION-38B" {
    // Limit 1000: investment 300, work opportunity 400, then research gets 1000 - 700 = 300; 200 is unused.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": general_business_credit_limitation(entity_ref("urn:test:c38d:t1#t"), entity_ref("urn:test:c38d:t1#y"), 1000 USD) { origin case_input; }
        assert "f1": business_credit_carryforward_to_year_or_zero(entity_ref("urn:test:c38d:t1#t"), entity_ref("urn:test:c38d:t1#y"), 0 USD) { origin case_input; }
        assert "f2": general_business_credit_component_amount(entity_ref("urn:test:c38d:t1#t"), entity_ref("urn:test:c38d:t1#y"), InvestmentCredit46, 300 USD) { origin case_input; }
        assert "f3": general_business_credit_component_amount(entity_ref("urn:test:c38d:t1#t"), entity_ref("urn:test:c38d:t1#y"), WorkOpportunityCredit51, 400 USD) { origin case_input; }
        assert "f4": general_business_credit_component_amount(entity_ref("urn:test:c38d:t1#t"), entity_ref("urn:test:c38d:t1#y"), ResearchCredit41, 500 USD) { origin case_input; }
    }
    evaluate truth(component_credit_used_38d(entity_ref("urn:test:c38d:t1#t"), entity_ref("urn:test:c38d:t1#y"), ResearchCredit41, 300 USD));
    expect truth_status == TRUE_ONLY;
}

