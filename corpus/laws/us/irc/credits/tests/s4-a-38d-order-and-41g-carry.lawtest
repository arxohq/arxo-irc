test "S38D-04-CARRYFORWARDS-USED-BEFORE-THE-CURRENT-YEAR-CREDITS" {
    // Limit 1000 - carryforward 600 = 400: investment 300, work opportunity 100.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": general_business_credit_limitation(entity_ref("urn:test:c38d:t4#t"), entity_ref("urn:test:c38d:t4#y"), 1000 USD) { origin case_input; }
        assert "f1": business_credit_carryforward_to_year_or_zero(entity_ref("urn:test:c38d:t4#t"), entity_ref("urn:test:c38d:t4#y"), 600 USD) { origin case_input; }
        assert "f2": general_business_credit_component_amount(entity_ref("urn:test:c38d:t4#t"), entity_ref("urn:test:c38d:t4#y"), InvestmentCredit46, 300 USD) { origin case_input; }
        assert "f3": general_business_credit_component_amount(entity_ref("urn:test:c38d:t4#t"), entity_ref("urn:test:c38d:t4#y"), WorkOpportunityCredit51, 400 USD) { origin case_input; }
        assert "f4": general_business_credit_component_amount(entity_ref("urn:test:c38d:t4#t"), entity_ref("urn:test:c38d:t4#y"), ResearchCredit41, 500 USD) { origin case_input; }
    }
    evaluate truth(component_credit_used_38d(entity_ref("urn:test:c38d:t4#t"), entity_ref("urn:test:c38d:t4#y"), WorkOpportunityCredit51, 100 USD));
    expect truth_status == TRUE_ONLY;
}

