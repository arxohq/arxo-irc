test "S38D2-01-INVESTMENT-CREDIT-SPLIT-IN-THE-ORDER-OF-SECTION-46" {
    // The investment credit used is 300: rehabilitation 200, energy 100 (order of section 46).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": general_business_credit_limitation(entity_ref("urn:test:c38d:t6#t"), entity_ref("urn:test:c38d:t6#y"), 300 USD) { origin case_input; }
        assert "f1": business_credit_carryforward_to_year_or_zero(entity_ref("urn:test:c38d:t6#t"), entity_ref("urn:test:c38d:t6#y"), 0 USD) { origin case_input; }
        assert "f2": general_business_credit_component_amount(entity_ref("urn:test:c38d:t6#t"), entity_ref("urn:test:c38d:t6#y"), InvestmentCredit46, 400 USD) { origin case_input; }
        assert "f3": investment_credit_component_46(entity_ref("urn:test:c38d:t6#t"), entity_ref("urn:test:c38d:t6#y"), RehabilitationCredit47, 200 USD) { origin case_input; }
        assert "f4": investment_credit_component_46(entity_ref("urn:test:c38d:t6#t"), entity_ref("urn:test:c38d:t6#y"), EnergyCredit48, 200 USD) { origin case_input; }
    }
    evaluate truth(investment_component_used_38d2(entity_ref("urn:test:c38d:t6#t"), entity_ref("urn:test:c38d:t6#y"), EnergyCredit48, 100 USD));
    expect truth_status == TRUE_ONLY;
}

