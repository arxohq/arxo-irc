// Section 45G scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45G-01-RATE-40-PERCENT-LIMIT-NOT-BINDING" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": class_ii_or_iii_railroad_45g(entity_ref("urn:test:45g:w1#t")) { origin case_input; }
        assert "f1": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w1#t"), entity_ref("urn:test:45g:w1#y"), 100.0) { origin case_input; }
        assert "f2": qualified_railroad_track_maintenance_expenditures_45g(entity_ref("urn:test:45g:w1#t"), entity_ref("urn:test:45g:w1#y"), 200000.00 USD) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:45g:w1#y"), @2024-01-01) { origin case_input; }
    }
    // 40% of 200,000 = 80,000; cap 3,500*100 = 350,000.
    evaluate truth(railroad_track_maintenance_credit(entity_ref("urn:test:45g:w1#t"), entity_ref("urn:test:45g:w1#y"), 80000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45G-02-CAP-3500-PER-MILE-BINDS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": class_ii_or_iii_railroad_45g(entity_ref("urn:test:45g:w2#t")) { origin case_input; }
        assert "f1": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w2#t"), entity_ref("urn:test:45g:w2#y"), 10.0) { origin case_input; }
        assert "f2": qualified_railroad_track_maintenance_expenditures_45g(entity_ref("urn:test:45g:w2#t"), entity_ref("urn:test:45g:w2#y"), 200000.00 USD) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:45g:w2#y"), @2024-01-01) { origin case_input; }
    }
    // 40% of 200,000 = 80,000 exceeds 3,500*10 = 35,000.
    evaluate truth(railroad_track_maintenance_credit(entity_ref("urn:test:45g:w2#t"), entity_ref("urn:test:45g:w2#y"), 35000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45G-03-YEAR-BEFORE-2023-RATE-50-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": class_ii_or_iii_railroad_45g(entity_ref("urn:test:45g:w3#t")) { origin case_input; }
        assert "f1": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w3#t"), entity_ref("urn:test:45g:w3#y"), 100.0) { origin case_input; }
        assert "f2": qualified_railroad_track_maintenance_expenditures_45g(entity_ref("urn:test:45g:w3#t"), entity_ref("urn:test:45g:w3#y"), 200000.00 USD) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:45g:w3#y"), @2022-01-01) { origin case_input; }
    }
    // A taxable year beginning 2022-01-01 uses 50%: 100,000.
    evaluate truth(railroad_track_maintenance_credit(entity_ref("urn:test:45g:w3#t"), entity_ref("urn:test:45g:w3#y"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45G-04-ASSIGNED-MILES-MOVE-TO-ASSIGNEE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": class_ii_or_iii_railroad_45g(entity_ref("urn:test:45g:w4#r")) { origin case_input; }
        assert "f1": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w4#r"), entity_ref("urn:test:45g:w4#y"), 100.0) { origin case_input; }
        assert "f2": track_assignment_45g(entity_ref("urn:test:45g:w4#r"), entity_ref("urn:test:45g:w4#s"), entity_ref("urn:test:45g:w4#y"), 40.0) { origin case_input; }
        assert "f3": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w4#s"), entity_ref("urn:test:45g:w4#y"), 0.0) { origin case_input; }
    }
    // The shipper holds 40 assigned miles; the railroad keeps 60.
    evaluate truth(net_track_miles_45g(entity_ref("urn:test:45g:w4#s"), entity_ref("urn:test:45g:w4#y"), 40.0));
    expect truth_status == TRUE_ONLY;
}

test "S45G-05-RAILROAD-KEEPS-UNASSIGNED-MILES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": class_ii_or_iii_railroad_45g(entity_ref("urn:test:45g:w5#r")) { origin case_input; }
        assert "f1": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w5#r"), entity_ref("urn:test:45g:w5#y"), 100.0) { origin case_input; }
        assert "f2": track_assignment_45g(entity_ref("urn:test:45g:w5#r"), entity_ref("urn:test:45g:w5#s"), entity_ref("urn:test:45g:w5#y"), 40.0) { origin case_input; }
        assert "f3": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w5#s"), entity_ref("urn:test:45g:w5#y"), 0.0) { origin case_input; }
    }
    // (b)(2)(B): the assigned miles cannot be counted by the assignor.
    evaluate truth(net_track_miles_45g(entity_ref("urn:test:45g:w5#r"), entity_ref("urn:test:45g:w5#y"), 60.0));
    expect truth_status == TRUE_ONLY;
}

test "S45G-06-NOT-ELIGIBLE-TAXPAYER-NEITHER" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": track_miles_owned_or_leased_45g(entity_ref("urn:test:45g:w6#t"), entity_ref("urn:test:45g:w6#y"), 10.0) { origin case_input; }
    }
    // No Class II/III railroad fact and no assignment: eligibility is not established.
    evaluate truth(eligible_taxpayer_45g(entity_ref("urn:test:45g:w6#t"), entity_ref("urn:test:45g:w6#y")));
    expect truth_status == NEITHER;
}
