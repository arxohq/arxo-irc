// Section 45B scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45B-01-TIPS-EXCEED-WAGE-SHORTFALL-EXCESS-TAX-AT-765" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": employer_of_tipped_employees_45b(entity_ref("urn:test:s45b:w1#e"), entity_ref("urn:test:s45b:w1#y")) { origin case_input; }
        assert "f1": tips_customary_food_beverage_month_45b(entity_ref("urn:test:s45b:w1#e"), entity_ref("urn:test:s45b:w1#w"), entity_ref("urn:test:s45b:w1#y"), @2024-03-01, 1000.00 USD) { origin case_input; }
        assert "f2": non_tip_wages_month_45b(entity_ref("urn:test:s45b:w1#e"), entity_ref("urn:test:s45b:w1#w"), entity_ref("urn:test:s45b:w1#y"), @2024-03-01, 400.00 USD) { origin case_input; }
        assert "f3": minimum_wage_payable_month_45b(entity_ref("urn:test:s45b:w1#e"), entity_ref("urn:test:s45b:w1#w"), entity_ref("urn:test:s45b:w1#y"), @2024-03-01, 900.00 USD) { origin case_input; }
        assert "f4": employer_tax_rate_3111_month_45b(entity_ref("urn:test:s45b:w1#e"), entity_ref("urn:test:s45b:w1#w"), entity_ref("urn:test:s45b:w1#y"), @2024-03-01, 0.0765) { origin case_input; }
    }
    // shortfall 900-400=500; excess tips 1000-500=500; tax 0.0765*500=38.25.
    evaluate truth(employer_social_security_credit(entity_ref("urn:test:s45b:w1#e"), entity_ref("urn:test:s45b:w1#y"), 38.25 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45B-02-WAGES-ABOVE-MINIMUM-ALL-TIPS-EXCESS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": employer_of_tipped_employees_45b(entity_ref("urn:test:s45b:w2#e"), entity_ref("urn:test:s45b:w2#y")) { origin case_input; }
        assert "f1": tips_customary_food_beverage_month_45b(entity_ref("urn:test:s45b:w2#e"), entity_ref("urn:test:s45b:w2#w"), entity_ref("urn:test:s45b:w2#y"), @2024-03-01, 200.00 USD) { origin case_input; }
        assert "f2": non_tip_wages_month_45b(entity_ref("urn:test:s45b:w2#e"), entity_ref("urn:test:s45b:w2#w"), entity_ref("urn:test:s45b:w2#y"), @2024-03-01, 1200.00 USD) { origin case_input; }
        assert "f3": minimum_wage_payable_month_45b(entity_ref("urn:test:s45b:w2#e"), entity_ref("urn:test:s45b:w2#w"), entity_ref("urn:test:s45b:w2#y"), @2024-03-01, 900.00 USD) { origin case_input; }
    }
    // wages exceed the minimum-wage amount: no shortfall, so every tip dollar is excess (max(0, 900-1200)=0).
    evaluate truth(excess_tips_month_45b(entity_ref("urn:test:s45b:w2#e"), entity_ref("urn:test:s45b:w2#w"), entity_ref("urn:test:s45b:w2#y"), @2024-03-01, 200.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45B-03-ELECTION-OUT-NO-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": employer_of_tipped_employees_45b(entity_ref("urn:test:s45b:w3#e"), entity_ref("urn:test:s45b:w3#y")) { origin case_input; }
        assert "f1": elects_out_of_section_45b(entity_ref("urn:test:s45b:w3#e"), entity_ref("urn:test:s45b:w3#y")) { origin case_input; }
        assert "f2": tips_customary_food_beverage_month_45b(entity_ref("urn:test:s45b:w3#e"), entity_ref("urn:test:s45b:w3#w"), entity_ref("urn:test:s45b:w3#y"), @2024-03-01, 1000.00 USD) { origin case_input; }
        assert "f3": non_tip_wages_month_45b(entity_ref("urn:test:s45b:w3#e"), entity_ref("urn:test:s45b:w3#w"), entity_ref("urn:test:s45b:w3#y"), @2024-03-01, 400.00 USD) { origin case_input; }
        assert "f4": minimum_wage_payable_month_45b(entity_ref("urn:test:s45b:w3#e"), entity_ref("urn:test:s45b:w3#w"), entity_ref("urn:test:s45b:w3#y"), @2024-03-01, 900.00 USD) { origin case_input; }
        assert "f5": employer_tax_rate_3111_month_45b(entity_ref("urn:test:s45b:w3#e"), entity_ref("urn:test:s45b:w3#w"), entity_ref("urn:test:s45b:w3#y"), @2024-03-01, 0.0765) { origin case_input; }
    }
    // a valid election-out: the credit is not derived (the power's effect makes section_45b_does_not_apply hold).
    evaluate truth(section_45b_does_not_apply(entity_ref("urn:test:s45b:w3#e"), entity_ref("urn:test:s45b:w3#y")));
    expect truth_status == TRUE_ONLY;
}

