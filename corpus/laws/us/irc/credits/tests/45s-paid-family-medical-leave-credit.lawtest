// Section 45S scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45S-01-APPLICABLE-PERCENTAGE-AT-70-PERCENT-RATE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": rate_of_payment_45s(entity_ref("urn:test:s45s:w1#er"), entity_ref("urn:test:s45s:w1#ee"), entity_ref("urn:test:s45s:w1#y1"), 0.70) { origin case_input; }
    }
    // 12.5% + 0.25*(70-50) = 12.5 + 5 = 17.5%.
    evaluate truth(applicable_percentage_45s(entity_ref("urn:test:s45s:w1#er"), entity_ref("urn:test:s45s:w1#ee"), entity_ref("urn:test:s45s:w1#y1"), 0.175));
    expect truth_status == TRUE_ONLY;
}

test "S45S-02-APPLICABLE-PERCENTAGE-CAPPED-AT-25-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": rate_of_payment_45s(entity_ref("urn:test:s45s:w2#er"), entity_ref("urn:test:s45s:w2#ee"), entity_ref("urn:test:s45s:w2#y1"), 1.00) { origin case_input; }
    }
    // 12.5% + 0.25*(100-50) = 12.5+12.5 = 25%, at the cap.
    evaluate truth(applicable_percentage_45s(entity_ref("urn:test:s45s:w2#er"), entity_ref("urn:test:s45s:w2#ee"), entity_ref("urn:test:s45s:w2#y1"), 0.25));
    expect truth_status == TRUE_ONLY;
}

test "S45S-03-PER-EMPLOYEE-CREDIT-AT-MINIMUM-50-PERCENT-RATE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_employer_45s(entity_ref("urn:test:s45s:w3#er"), entity_ref("urn:test:s45s:w3#y1")) { origin case_input; }
        assert "f2": qualifying_employee_45s(entity_ref("urn:test:s45s:w3#ee"), entity_ref("urn:test:s45s:w3#er"), entity_ref("urn:test:s45s:w3#y1")) { origin case_input; }
        assert "f3": rate_of_payment_45s(entity_ref("urn:test:s45s:w3#er"), entity_ref("urn:test:s45s:w3#ee"), entity_ref("urn:test:s45s:w3#y1"), 0.50) { origin case_input; }
        assert "f4": wages_paid_during_leave_45s(entity_ref("urn:test:s45s:w3#er"), entity_ref("urn:test:s45s:w3#ee"), entity_ref("urn:test:s45s:w3#y1"), 4000.00 USD) { origin case_input; }
    }
    // 12.5% * 4000 = 500.00.
    evaluate truth(paid_family_medical_leave_credit_per_employee(entity_ref("urn:test:s45s:w3#er"), entity_ref("urn:test:s45s:w3#ee"), entity_ref("urn:test:s45s:w3#y1"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45S-04-ELECTION-OUT-BLOCKS-SECTION" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_employer_45s(entity_ref("urn:test:s45s:w4#er"), entity_ref("urn:test:s45s:w4#y1")) { origin case_input; }
        assert "f2": elects_out_of_section_45s(entity_ref("urn:test:s45s:w4#er"), entity_ref("urn:test:s45s:w4#y1")) { origin case_input; }
    }
    evaluate truth(section_45s_does_not_apply(entity_ref("urn:test:s45s:w4#er"), entity_ref("urn:test:s45s:w4#y1")));
    expect truth_status == TRUE_ONLY;
}

test "S45S-05-PERMANENCE-2027-YEAR-STILL-ALLOWED" {
    given {
        context {
            legal_time @2028-04-15; decision_time @2028-04-15T09:00:00-05:00;
            knowledge_time @2028-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_employer_45s(entity_ref("urn:test:s45s:w5#er"), entity_ref("urn:test:s45s:w5#y2027")) { origin case_input; }
        assert "f2": qualifying_employee_45s(entity_ref("urn:test:s45s:w5#ee"), entity_ref("urn:test:s45s:w5#er"), entity_ref("urn:test:s45s:w5#y2027")) { origin case_input; }
        assert "f3": rate_of_payment_45s(entity_ref("urn:test:s45s:w5#er"), entity_ref("urn:test:s45s:w5#ee"), entity_ref("urn:test:s45s:w5#y2027"), 0.60) { origin case_input; }
        assert "f4": wages_paid_during_leave_45s(entity_ref("urn:test:s45s:w5#er"), entity_ref("urn:test:s45s:w5#ee"), entity_ref("urn:test:s45s:w5#y2027"), 1000.00 USD) { origin case_input; }
    }
    // a taxable year well after the base text's own December 31, 2025 termination date — the credit is NOT gated by section 45S(i)
    // (PL 119-21 section 70304(a)(5) strikes it for the identical boundary), so the per-employee computation still fires.
    // 12.5% + 0.25*(60-50) = 15%; 15% * 1000 = 150.00.
    evaluate truth(paid_family_medical_leave_credit_per_employee(entity_ref("urn:test:s45s:w5#er"), entity_ref("urn:test:s45s:w5#ee"), entity_ref("urn:test:s45s:w5#y2027"), 150.00 USD));
    expect truth_status == TRUE_ONLY;
}
