// Section 41 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S41-01-REGULAR-METHOD-20-PERCENT-OVER-BASE-AMOUNT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_research_expenses(entity_ref("urn:test:s41:w1#p"), entity_ref("urn:test:s41:w1#y1"), 500000.00 USD) { origin case_input; }
        assert "f2": fixed_base_percentage_41c3(entity_ref("urn:test:s41:w1#p"), entity_ref("urn:test:s41:w1#y1"), 0.03) { origin case_input; }
        assert "f3": average_annual_gross_receipts_4yr(entity_ref("urn:test:s41:w1#p"), entity_ref("urn:test:s41:w1#y1"), 4000000.00 USD) { origin case_input; }
    }
    // base = max(0.03*4000000, 0.50*500000) = max(120000, 250000) = 250000.
    // credit component 1 = 0.20 * (500000-250000) = 50000.
    evaluate truth(base_amount_41c(entity_ref("urn:test:s41:w1#p"), entity_ref("urn:test:s41:w1#y1"), 250000.00 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(research_credit_component_1_41a1(entity_ref("urn:test:s41:w1#p"), entity_ref("urn:test:s41:w1#y1"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S41-02-ASC-ELECTION-14-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_research_expenses(entity_ref("urn:test:s41:w2#p"), entity_ref("urn:test:s41:w2#y1"), 300000.00 USD) { origin case_input; }
        assert "f2": section_41_asc_elected(entity_ref("urn:test:s41:w2#p"), entity_ref("urn:test:s41:w2#y1")) { origin case_input; }
        assert "f3": average_qualified_research_expenses_3yr(entity_ref("urn:test:s41:w2#p"), entity_ref("urn:test:s41:w2#y1"), 200000.00 USD) { origin case_input; }
    }
    // 0.14 * (300000 - 0.50*200000) = 0.14 * 200000 = 28000.
    evaluate truth(research_credit_component_1_41a1(entity_ref("urn:test:s41:w2#p"), entity_ref("urn:test:s41:w2#y1"), 28000.00 USD));
    expect truth_status == TRUE_ONLY;
}
