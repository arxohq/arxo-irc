}

test "W10C-CRE-04-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": producer_registered_under_4101_45z(entity_ref("urn:test:w10cexg:d#p")) { origin case_input; }
    }
    evaluate truth(producer_registered_under_4101_45z(entity_ref("urn:test:w10cexg:d#p")));
    expect truth_status == TRUE_ONLY;
}
