// Credits WIRE-10 (group C) scenarios: owner `excise_goods` (section 4101 registration of a clean fuel producer).
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "W10C-CRE-01-REGISTERED-CLEAN-FUEL-PRODUCER-FROM-EXCISE-GOODS" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.excise_goods::registered_with_secretary_under_4101(entity_ref("urn:test:w10cexg:a#p")) { origin case_input; }
        assert "f1": us.irc.excise_goods::person_within_4101a1_ground(entity_ref("urn:test:w10cexg:a#p"), us.irc.excise_goods::CleanFuelProductionCreditFuelProducer) { origin case_input; }
    }
    evaluate truth(producer_registered_under_4101_45z(entity_ref("urn:test:w10cexg:a#p")));
    expect truth_status == TRUE_ONLY;
}

test "W10C-CRE-02-REGISTRATION-UNDER-ANOTHER-GROUND-IS-NOT-A-CLEAN-FUEL-PRODUCER" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.excise_goods::registered_with_secretary_under_4101(entity_ref("urn:test:w10cexg:b#p")) { origin case_input; }
        assert "f1": us.irc.excise_goods::person_within_4101a1_ground(entity_ref("urn:test:w10cexg:b#p"), us.irc.excise_goods::SecretaryRequiredForFuelTax) { origin case_input; }
    }
    evaluate truth(producer_registered_under_4101_45z(entity_ref("urn:test:w10cexg:b#p")));
    expect truth_status == FALSE_ONLY;
}

