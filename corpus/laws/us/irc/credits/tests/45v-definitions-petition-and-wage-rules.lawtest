        assert "f0": hydrogen_producer_45v(entity_ref("urn:test:s45vd:w2#t"), entity_ref("urn:test:s45vd:w2#h")) { origin case_input; }
        assert "f1": files_petition_for_lifecycle_rate_45v(entity_ref("urn:test:s45vd:w2#t"), entity_ref("urn:test:s45vd:w2#h")) { origin case_input; }
        assert "f2": lifecycle_rate_determined_45v(entity_ref("urn:test:s45vd:w2#h")) { origin case_input; }
    }
    evaluate truth(lifecycle_rate_petition_pending_45v(entity_ref("urn:test:s45vd:w2#t"), entity_ref("urn:test:s45vd:w2#h")));
    expect truth_status == NEITHER;
}

