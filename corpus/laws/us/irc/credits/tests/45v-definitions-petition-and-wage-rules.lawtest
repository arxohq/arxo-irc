language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45VD-01-PETITION-POWER-FOR-HYDROGEN-WITHOUT-DETERMINED-RATE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": hydrogen_producer_45v(entity_ref("urn:test:s45vd:w1#t"), entity_ref("urn:test:s45vd:w1#h")) { origin case_input; }
        assert "f1": files_petition_for_lifecycle_rate_45v(entity_ref("urn:test:s45vd:w1#t"), entity_ref("urn:test:s45vd:w1#h")) { origin case_input; }
    }
    evaluate truth(lifecycle_rate_petition_pending_45v(entity_ref("urn:test:s45vd:w1#t"), entity_ref("urn:test:s45vd:w1#h")));
    expect truth_status == TRUE_ONLY;
}

test "S45VD-02-NO-PETITION-WHEN-RATE-ALREADY-DETERMINED" {
