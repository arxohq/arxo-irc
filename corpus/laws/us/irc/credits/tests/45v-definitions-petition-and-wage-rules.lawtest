test "S45VD-04-MODIFIED-FACILITY-DEEMED-PLACED-IN-SERVICE-AT-MODIFICATION" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": facility_originally_placed_in_service_on_45v(entity_ref("urn:test:s45vd:w4#f"), @2021-06-01) { origin case_input; }
        assert "f1": modified_to_produce_qualified_clean_hydrogen_after_original_service_45v(entity_ref("urn:test:s45vd:w4#f")) { origin case_input; }
        assert "f2": modification_amounts_chargeable_to_capital_account_45v(entity_ref("urn:test:s45vd:w4#f")) { origin case_input; }
        assert "f3": modification_property_placed_in_service_on_45v(entity_ref("urn:test:s45vd:w4#f"), @2025-03-01) { origin case_input; }
    }
    evaluate truth(deemed_originally_placed_in_service_on_45v(entity_ref("urn:test:s45vd:w4#f"), @2025-03-01));
    expect truth_status == TRUE_ONLY;
}

