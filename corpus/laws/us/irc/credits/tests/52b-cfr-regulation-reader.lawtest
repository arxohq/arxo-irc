// Section 52(b)(1) regulation reader (IRC-G/G4, CFR wiring 27.09.2026).
// Вывод / нет факта источника: with the 1.52-1 regulation content as applied
// the aggregation consequence derives (TRUE_ONLY); without it nothing
// derives (NEITHER). The existing case-asserted `under_common_control_52b`
// path is untouched (parallel). Expectations from the statutory text.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S52-CFR-01-REGULATION-AGGREGATION-DERIVES" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f1": common_control_aggregation_follows_regulation_1_52_1_52b(entity_ref("urn:test:s52cfr:1#g1"), entity_ref("urn:test:s52cfr:1#b1"), entity_ref("urn:test:s52cfr:1#y1")) { origin case_input; }
    }
    evaluate truth(common_control_aggregation_applies_under_regulation_1_52_1_52b(entity_ref("urn:test:s52cfr:1#g1"), entity_ref("urn:test:s52cfr:1#b1"), entity_ref("urn:test:s52cfr:1#y1")));
    expect truth_status == TRUE_ONLY;
}

test "S52-CFR-02-WITHOUT-REGULATION-NEITHER" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(common_control_aggregation_applies_under_regulation_1_52_1_52b(entity_ref("urn:test:s52cfr:2#g1"), entity_ref("urn:test:s52cfr:2#b1"), entity_ref("urn:test:s52cfr:2#y1")));
    expect truth_status == NEITHER;
}
