// Section 40A scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S40A-01-MIXTURE-CREDIT-ONE-DOLLAR-PER-GALLON" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": sale_or_use_date_40a(entity_ref("urn:test:s40a:w1#t"), entity_ref("urn:test:s40a:w1#y1"), @2024-06-01) { origin case_input; }
        assert "f2": biodiesel_certification_obtained(entity_ref("urn:test:s40a:w1#t"), entity_ref("urn:test:s40a:w1#y1")) { origin case_input; }
        assert "f3": biodiesel_used_in_qualified_mixture_gallons(entity_ref("urn:test:s40a:w1#t"), entity_ref("urn:test:s40a:w1#y1"), 5000.0) { origin case_input; }
    }
    evaluate truth(biodiesel_mixture_credit(entity_ref("urn:test:s40a:w1#t"), entity_ref("urn:test:s40a:w1#y1"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S40A-02-TOTAL-CREDIT-COMBINES-ALL-THREE-COMPONENTS" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": sale_or_use_date_40a(entity_ref("urn:test:s40a:w2#t"), entity_ref("urn:test:s40a:w2#y1"), @2024-06-01) { origin case_input; }
        assert "f2": biodiesel_certification_obtained(entity_ref("urn:test:s40a:w2#t"), entity_ref("urn:test:s40a:w2#y1")) { origin case_input; }
        assert "f3": biodiesel_used_in_qualified_mixture_gallons(entity_ref("urn:test:s40a:w2#t"), entity_ref("urn:test:s40a:w2#y1"), 1000.0) { origin case_input; }
        assert "f4": biodiesel_used_or_sold_not_in_mixture_gallons(entity_ref("urn:test:s40a:w2#t"), entity_ref("urn:test:s40a:w2#y1"), 500.0) { origin case_input; }
        assert "f5": eligible_small_agri_biodiesel_producer(entity_ref("urn:test:s40a:w2#t")) { origin case_input; }
        assert "f6": qualified_agri_biodiesel_production_gallons(entity_ref("urn:test:s40a:w2#t"), entity_ref("urn:test:s40a:w2#y1"), 2000.0) { origin case_input; }
    }
    // 1000*1.00 + 500*1.00 + 2000*0.10 = 1000+500+200 = 1700.
    evaluate truth(biodiesel_fuels_credit(entity_ref("urn:test:s40a:w2#t"), entity_ref("urn:test:s40a:w2#y1"), 1700.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S40A-03-TERMINATED-AFTER-2024" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": sale_or_use_date_40a(entity_ref("urn:test:s40a:w3#t"), entity_ref("urn:test:s40a:w3#y1"), @2025-01-15) { origin case_input; }
        assert "f2": biodiesel_certification_obtained(entity_ref("urn:test:s40a:w3#t"), entity_ref("urn:test:s40a:w3#y1")) { origin case_input; }
        assert "f3": biodiesel_used_in_qualified_mixture_gallons(entity_ref("urn:test:s40a:w3#t"), entity_ref("urn:test:s40a:w3#y1"), 1000.0) { origin case_input; }
    }
    // 2025-01-15 is after December 31, 2024 — not_terminated_40a is NEITHER, credit rule cannot fire.
    evaluate truth(biodiesel_mixture_credit(entity_ref("urn:test:s40a:w3#t"), entity_ref("urn:test:s40a:w3#y1"), 0 USD));
    expect truth_status == NEITHER;
}
