        assert "f0": deduction_allowable_for_cost_43(entity_ref("urn:test:s43d:w17#t"), entity_ref("urn:test:s43d:w17#i1"), entity_ref("urn:test:s43d:w17#y"), 500000.00 USD) { origin case_input; }
        assert "f1": credit_attributable_to_cost_43(entity_ref("urn:test:s43d:w17#t"), entity_ref("urn:test:s43d:w17#i1"), entity_ref("urn:test:s43d:w17#y"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_after_credit_43(entity_ref("urn:test:s43d:w17#t"), entity_ref("urn:test:s43d:w17#i1"), entity_ref("urn:test:s43d:w17#y"), 400000.00 USD));
    expect truth_status == TRUE_ONLY;
}

