test "S43D-01-QUALIFIED-PROJECT-TERTIARY-METHOD" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": project_recovery_method_43(entity_ref("urn:test:s43d:w1#pj"), TertiaryMethodUnder193b3) { origin case_input; }
        assert "f1": project_expected_to_increase_recovery_more_than_insignificantly_43(entity_ref("urn:test:s43d:w1#pj")) { origin case_input; }
        assert "f2": project_located_in_united_states_43(entity_ref("urn:test:s43d:w1#pj")) { origin case_input; }
        assert "f3": first_injection_commences_on_43(entity_ref("urn:test:s43d:w1#pj"), @1991-01-01) { origin case_input; }
        assert "f4": petroleum_engineer_certification_submitted_43(entity_ref("urn:test:s43d:w1#pj")) { origin case_input; }
    }
    evaluate truth(qualified_enhanced_oil_recovery_project_43(entity_ref("urn:test:s43d:w1#pj")));
    expect truth_status == TRUE_ONLY;
}

