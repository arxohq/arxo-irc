test "S45QD-01-ADDITIONAL-EQUIPMENT-HIGHER-DAC" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": equipment_at_facility_45q(entity_ref("urn:test:s45qd:w1#q"), entity_ref("urn:test:s45qd:w1#f")) { origin case_input; }
        assert "f1": facility_kind_45q(entity_ref("urn:test:s45qd:w1#f"), DirectAirCapture) { origin case_input; }
        assert "f2": facility_placed_in_service_on_45q(entity_ref("urn:test:s45qd:w1#f"), @2021-06-01) { origin case_input; }
        assert "f3": equipment_placed_in_service_on_45q(entity_ref("urn:test:s45qd:w1#q"), @2023-03-01) { origin case_input; }
    }
    evaluate truth(additional_equipment_treated_as_higher_dac_45q(entity_ref("urn:test:s45qd:w1#q")));
    expect truth_status == TRUE_ONLY;
}

