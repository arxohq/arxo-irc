        assert "f2": unit_placed_in_service_on_45q(entity_ref("urn:test:s45qd:w18#u"), @2022-01-01) { origin case_input; }
        assert "f3": production_since_placed_in_service_tons_45q(entity_ref("urn:test:s45qd:w18#u"), 2000000.0) { origin case_input; }
