// Section 48C scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S48C-01-ORIGINAL-PROGRAM-30-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": allocation_round_48c(entity_ref("urn:test:48c:w1#p"), OriginalProgramSubsectionD) { origin case_input; }
        assert "f1": program_total_certified_48c(OriginalProgramSubsectionD, 2000000000.00 USD) { origin case_input; }
        assert "f2": secretary_certifies_project_48c(entity_ref("urn:test:48c:w1#p"), entity_ref("urn:test:48c:w1#a"), @2011-01-01) { origin case_input; }
        assert "f3": designated_amount_48c(entity_ref("urn:test:48c:w1#p"), 10000000.00 USD) { origin case_input; }
        assert "f4": prior_years_qualified_investment_48c(entity_ref("urn:test:48c:w1#t"), entity_ref("urn:test:48c:w1#p"), entity_ref("urn:test:48c:w1#y"), 0 USD) { origin case_input; }
        assert "f5": qualified_investment_48c(entity_ref("urn:test:48c:w1#t"), entity_ref("urn:test:48c:w1#p"), entity_ref("urn:test:48c:w1#y"), 4000000.00 USD) { origin case_input; }
    }
    // 30% of 4,000,000 within the designated 10,000,000.
    evaluate truth(advanced_energy_credit_per_project_48c(entity_ref("urn:test:48c:w1#t"), entity_ref("urn:test:48c:w1#p"), entity_ref("urn:test:48c:w1#y"), 1200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S48C-02-DESIGNATED-AMOUNT-LEFT-CAPS-INVESTMENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": allocation_round_48c(entity_ref("urn:test:48c:w2#p"), OriginalProgramSubsectionD) { origin case_input; }
        assert "f1": program_total_certified_48c(OriginalProgramSubsectionD, 2000000000.00 USD) { origin case_input; }
        assert "f2": secretary_certifies_project_48c(entity_ref("urn:test:48c:w2#p"), entity_ref("urn:test:48c:w2#a"), @2011-01-01) { origin case_input; }
        assert "f3": designated_amount_48c(entity_ref("urn:test:48c:w2#p"), 10000000.00 USD) { origin case_input; }
        assert "f4": prior_years_qualified_investment_48c(entity_ref("urn:test:48c:w2#t"), entity_ref("urn:test:48c:w2#p"), entity_ref("urn:test:48c:w2#y"), 8000000.00 USD) { origin case_input; }
        assert "f5": qualified_investment_48c(entity_ref("urn:test:48c:w2#t"), entity_ref("urn:test:48c:w2#p"), entity_ref("urn:test:48c:w2#y"), 4000000.00 USD) { origin case_input; }
    }
    // designated 10,000,000 less 8,000,000 prior leaves 2,000,000: 30% = 600,000.
    evaluate truth(advanced_energy_credit_per_project_48c(entity_ref("urn:test:48c:w2#t"), entity_ref("urn:test:48c:w2#p"), entity_ref("urn:test:48c:w2#y"), 600000.00 USD));
    expect truth_status == TRUE_ONLY;
}

