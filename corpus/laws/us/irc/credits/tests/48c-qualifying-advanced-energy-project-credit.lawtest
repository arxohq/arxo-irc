test "S48C-05-EXPANDED-OUTSIDE-ENERGY-COMMUNITY-OVER-6-BILLION-INVALID" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": allocation_round_48c(entity_ref("urn:test:48c:w5#p"), ExpandedProgramSubsectionE) { origin case_input; }
        assert "f1": program_total_certified_48c(ExpandedProgramSubsectionE, 5000000000.00 USD) { origin case_input; }
        assert "f2": secretary_certifies_project_48c(entity_ref("urn:test:48c:w5#p"), entity_ref("urn:test:48c:w5#a"), @2011-01-01) { origin case_input; }
        assert "f3": designated_amount_48c(entity_ref("urn:test:48c:w5#p"), 10000000.00 USD) { origin case_input; }
        assert "f4": prior_years_qualified_investment_48c(entity_ref("urn:test:48c:w5#t"), entity_ref("urn:test:48c:w5#p"), entity_ref("urn:test:48c:w5#y"), 0 USD) { origin case_input; }
        assert "f5": qualified_investment_48c(entity_ref("urn:test:48c:w5#t"), entity_ref("urn:test:48c:w5#p"), entity_ref("urn:test:48c:w5#y"), 4000000.00 USD) { origin case_input; }
        assert "f6": expanded_program_outside_energy_community_total_48c(7000000000.00 USD) { origin case_input; }
    }
    // (e)(2): not more than 6,000,000,000 outside the census tracts: the certification is invalid.
    evaluate truth(certified_project_48c(entity_ref("urn:test:48c:w5#p")));
    expect truth_status == NEITHER;
}

test "S48C-06-PLACED-IN-SERVICE-AFTER-THREE-YEARS-LAPSED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": allocation_round_48c(entity_ref("urn:test:48c:w6#p"), OriginalProgramSubsectionD) { origin case_input; }
        assert "f1": program_total_certified_48c(OriginalProgramSubsectionD, 2000000000.00 USD) { origin case_input; }
        assert "f2": secretary_certifies_project_48c(entity_ref("urn:test:48c:w6#p"), entity_ref("urn:test:48c:w6#a"), @2011-01-01) { origin case_input; }
        assert "f3": designated_amount_48c(entity_ref("urn:test:48c:w6#p"), 10000000.00 USD) { origin case_input; }
        assert "f4": prior_years_qualified_investment_48c(entity_ref("urn:test:48c:w6#t"), entity_ref("urn:test:48c:w6#p"), entity_ref("urn:test:48c:w6#y"), 0 USD) { origin case_input; }
