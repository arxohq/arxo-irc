        assert "f6": project_placed_in_service_on_48c(entity_ref("urn:test:48c:w6#p"), @2014-06-01) { origin case_input; }
    }
    // (d)(2)(C): issued 2011-01-01, placed 2014-06-01 is after 2014-01-01.
    evaluate truth(certification_lapsed_48c(entity_ref("urn:test:48c:w6#p")));
    expect truth_status == TRUE_ONLY;
}

