        assert "f6": expanded_program_outside_energy_community_total_48c(3000000000.00 USD) { origin case_input; }
        assert "f7": satisfies_wage_and_apprenticeship_requirements_48c(entity_ref("urn:test:48c:w4#p")) { origin case_input; }
    }
    // (e)(4)(B): the 6 percent substitution does not apply: 30%.
