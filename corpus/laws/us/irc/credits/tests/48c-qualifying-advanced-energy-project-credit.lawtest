test "S48C-08-PROGRAM-NOT-ESTABLISHED-IN-180-DAYS-VIOLATED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": section_48c_program_enacted_on(OriginalProgramSubsectionD, @2009-02-17) { origin case_input; }
    }
    // Enactment 2009-02-17: 180 days elapsed with no program asserted.
    evaluate positions();
    expect position(Section48cD1ProgramDuty, VIOLATED);
}

