        assert "f2": secretary_certifies_project_48c(entity_ref("urn:test:48c:w4#p"), entity_ref("urn:test:48c:w4#a"), @2011-01-01) { origin case_input; }
        assert "f3": designated_amount_48c(entity_ref("urn:test:48c:w4#p"), 10000000.00 USD) { origin case_input; }
