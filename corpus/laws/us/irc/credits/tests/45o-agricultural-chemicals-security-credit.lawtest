// Section 45O scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45O-01-THIRTY-PERCENT-OF-EXPENDITURES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_agricultural_business_45o(entity_ref("urn:test:45o:w1#t")) { origin case_input; }
        assert "f1": qualified_security_expenditures_45o(entity_ref("urn:test:45o:w1#t"), entity_ref("urn:test:45o:w1#fa"), entity_ref("urn:test:45o:w1#y"), 200000.00 USD) { origin case_input; }
        assert "f2": prior_five_year_credits_for_facility_45o(entity_ref("urn:test:45o:w1#t"), entity_ref("urn:test:45o:w1#fa"), entity_ref("urn:test:45o:w1#y"), 0 USD) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:45o:w1#y"), @2010-01-01) { origin case_input; }
    }
    // 30% of 200,000.
    evaluate truth(agricultural_chemicals_security_credit_per_facility_45o(entity_ref("urn:test:45o:w1#t"), entity_ref("urn:test:45o:w1#fa"), entity_ref("urn:test:45o:w1#y"), 60000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45O-02-FACILITY-CAP-100000-LESS-PRIOR-CREDITS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_agricultural_business_45o(entity_ref("urn:test:45o:w2#t")) { origin case_input; }
        assert "f1": qualified_security_expenditures_45o(entity_ref("urn:test:45o:w2#t"), entity_ref("urn:test:45o:w2#fa"), entity_ref("urn:test:45o:w2#y"), 500000.00 USD) { origin case_input; }
        assert "f2": prior_five_year_credits_for_facility_45o(entity_ref("urn:test:45o:w2#t"), entity_ref("urn:test:45o:w2#fa"), entity_ref("urn:test:45o:w2#y"), 30000.00 USD) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:45o:w2#y"), @2010-01-01) { origin case_input; }
    }
    // 30% = 150,000 limited to 100,000 - 30,000 = 70,000.
    evaluate truth(agricultural_chemicals_security_credit_per_facility_45o(entity_ref("urn:test:45o:w2#t"), entity_ref("urn:test:45o:w2#fa"), entity_ref("urn:test:45o:w2#y"), 70000.00 USD));
    expect truth_status == TRUE_ONLY;
}

