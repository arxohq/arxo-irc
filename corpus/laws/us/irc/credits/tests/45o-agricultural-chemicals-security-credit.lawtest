test "S45O-04-YEAR-BEGINNING-2013-NOT-APPLICABLE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:45o:w4#y"), @2013-01-01) { origin case_input; }
    }
    // (i): no amounts paid after 2012-12-31.
    evaluate truth(section_45o_in_force_for_year(entity_ref("urn:test:45o:w4#y")));
    expect truth_status == NEITHER;
}

test "S45O-05-NOT-AN-ELIGIBLE-AGRICULTURAL-BUSINESS-NO-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_security_expenditures_45o(entity_ref("urn:test:45o:w5#t"), entity_ref("urn:test:45o:w5#fa"), entity_ref("urn:test:45o:w5#y"), 200000.00 USD) { origin case_input; }
        assert "f1": prior_five_year_credits_for_facility_45o(entity_ref("urn:test:45o:w5#t"), entity_ref("urn:test:45o:w5#fa"), entity_ref("urn:test:45o:w5#y"), 0 USD) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:45o:w5#y"), @2010-01-01) { origin case_input; }
    }
    // (a): only an eligible agricultural business.
    evaluate truth(agricultural_chemicals_security_credit_per_facility_45o(entity_ref("urn:test:45o:w5#t"), entity_ref("urn:test:45o:w5#fa"), entity_ref("urn:test:45o:w5#y"), 60000.00 USD));
    expect truth_status == NEITHER;
}
