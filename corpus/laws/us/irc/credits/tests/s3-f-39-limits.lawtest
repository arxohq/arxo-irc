test "S3 39b carryback limited by the carryback year" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": current_year_business_credit(entity_ref("urn:test:s3 39b carryback limited by the carryback year#p"), entity_ref("urn:test:s3 39b carryback limited by the carryback year#y2"), 10000.00 USD) { origin case_input; }
        assert "f1": general_business_credit_limitation(entity_ref("urn:test:s3 39b carryback limited by the carryback year#p"), entity_ref("urn:test:s3 39b carryback limited by the carryback year#y2"), 6000.00 USD) { origin case_input; }
        assert "f2": preceding_taxable_year_of(entity_ref("urn:test:s3 39b carryback limited by the carryback year#y2"), entity_ref("urn:test:s3 39b carryback limited by the carryback year#y1")) { origin case_input; }
        assert "f3": general_business_credit_limitation(entity_ref("urn:test:s3 39b carryback limited by the carryback year#p"), entity_ref("urn:test:s3 39b carryback limited by the carryback year#y1"), 8000.00 USD) { origin case_input; }
        assert "f4": current_year_business_credit(entity_ref("urn:test:s3 39b carryback limited by the carryback year#p"), entity_ref("urn:test:s3 39b carryback limited by the carryback year#y1"), 5000.00 USD) { origin case_input; }
    }
    evaluate truth(business_credit_carryback_computed_to_year(entity_ref("urn:test:s3 39b carryback limited by the carryback year#p"), entity_ref("urn:test:s3 39b carryback limited by the carryback year#y2"), entity_ref("urn:test:s3 39b carryback limited by the carryback year#y1"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

