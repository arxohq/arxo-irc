    evaluate truth(business_credit_carryforward_computed_to_year(entity_ref("urn:test:s3 39c room exceeds the unused credit#p"), entity_ref("urn:test:s3 39c room exceeds the unused credit#y2"), entity_ref("urn:test:s3 39c room exceeds the unused credit#y3"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
}

