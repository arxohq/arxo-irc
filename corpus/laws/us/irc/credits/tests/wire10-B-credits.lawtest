        assert "f1": ssn_issue_date(entity_ref("urn:test:w10b:c2#h"), @2019-01-01) { origin case_input; }
        assert "f2": return_due_date_for_ssn_24h7(entity_ref("urn:test:w10b:c2#f"), entity_ref("urn:test:w10b:c2#y"), @2020-04-15) { origin case_input; }
        assert "f3": ssn_holder_number_on_return_of(entity_ref("urn:test:w10b:c2#h"), entity_ref("urn:test:w10b:c2#f"), entity_ref("urn:test:w10b:c2#y")) { origin case_input; }
