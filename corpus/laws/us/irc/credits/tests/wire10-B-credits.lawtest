test "W10B-CR-09-SAME-CONTROLLED-GROUP-IS-A-SINGLE-EMPLOYER" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_52_controlled_group_member(entity_ref("urn:test:w10b:se1#g"), entity_ref("urn:test:w10b:se1#a")) { origin case_input; }
        assert "f1": section_52_controlled_group_member(entity_ref("urn:test:w10b:se1#g"), entity_ref("urn:test:w10b:se1#b")) { origin case_input; }
    }
    evaluate truth(treated_as_single_employer_52a(entity_ref("urn:test:w10b:se1#a"), entity_ref("urn:test:w10b:se1#b")));
    expect truth_status == TRUE_ONLY;
}
