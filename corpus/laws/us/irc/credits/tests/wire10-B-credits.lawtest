// Credits WIRE-10 group B scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "W10B-CR-01-SSN-ISSUED-BEFORE-DUE-DATE-IS-A-24H7-NUMBER" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ssn_issued_by_social_security_administration(entity_ref("urn:test:w10b:c1#h")) { origin case_input; }
        assert "f1": ssn_issued_to_citizen_or_205c2Bi_I_alien(entity_ref("urn:test:w10b:c1#h")) { origin case_input; }
        assert "f2": ssn_issue_date(entity_ref("urn:test:w10b:c1#h"), @2019-01-01) { origin case_input; }
        assert "f3": return_due_date_for_ssn_24h7(entity_ref("urn:test:w10b:c1#f"), entity_ref("urn:test:w10b:c1#y"), @2020-04-15) { origin case_input; }
        assert "f4": ssn_holder_number_on_return_of(entity_ref("urn:test:w10b:c1#h"), entity_ref("urn:test:w10b:c1#f"), entity_ref("urn:test:w10b:c1#y")) { origin case_input; }
    }
    evaluate truth(social_security_number_24h7(entity_ref("urn:test:w10b:c1#h"), entity_ref("urn:test:w10b:c1#f"), entity_ref("urn:test:w10b:c1#y")));
    expect truth_status == TRUE_ONLY;
}

