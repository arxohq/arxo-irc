// Sections 45E and 45T scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45E-01-GENERAL-50-PERCENT-CAPPED-BY-DOLLAR-LIMITATION" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_startup_costs_expense(entity_ref("urn:test:s45e:w1#e"), entity_ref("urn:test:s45e:w1#y1"), 20000.00 USD) { origin case_input; }
        assert "f2": eligible_employer_plan_has_nhce_participant(entity_ref("urn:test:s45e:w1#e"), entity_ref("urn:test:s45e:w1#y1")) { origin case_input; }
        assert "f3": within_first_three_credit_years_45e(entity_ref("urn:test:s45e:w1#e"), entity_ref("urn:test:s45e:w1#y1")) { origin case_input; }
        assert "f4": nhce_participant_count(entity_ref("urn:test:s45e:w1#e"), entity_ref("urn:test:s45e:w1#y1"), 30.0) { origin case_input; }
    }
    // before = 50% * 20000 = 10000; limitation = max(500, min(250*30=7500, 5000)) = max(500,5000) = 5000; credit = min(10000,5000) = 5000.
    evaluate truth(small_employer_pension_plan_startup_cost_credit(entity_ref("urn:test:s45e:w1#e"), entity_ref("urn:test:s45e:w1#y1"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45E-02-SMALLER-EMPLOYER-100-PERCENT-RATE" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": qualified_startup_costs_expense(entity_ref("urn:test:s45e:w2#e"), entity_ref("urn:test:s45e:w2#y1"), 2000.00 USD) { origin case_input; }
        assert "f2": eligible_employer_plan_has_nhce_participant(entity_ref("urn:test:s45e:w2#e"), entity_ref("urn:test:s45e:w2#y1")) { origin case_input; }
        assert "f3": would_be_eligible_at_50_employees_45e(entity_ref("urn:test:s45e:w2#e"), entity_ref("urn:test:s45e:w2#y1")) { origin case_input; }
    }
    // 100% * 2000 = 2000.
    evaluate truth(startup_cost_credit_before_limitation(entity_ref("urn:test:s45e:w2#e"), entity_ref("urn:test:s45e:w2#y1"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45E-03-DOLLAR-LIMITATION-MINIMUM-500-FLOOR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": within_first_three_credit_years_45e(entity_ref("urn:test:s45e:w3#e"), entity_ref("urn:test:s45e:w3#y1")) { origin case_input; }
        assert "f2": nhce_participant_count(entity_ref("urn:test:s45e:w3#e"), entity_ref("urn:test:s45e:w3#y1"), 1.0) { origin case_input; }
    }
    // max(500, min(250*1=250,5000)) = max(500,250) = 500.
    evaluate truth(dollar_limitation_45e(entity_ref("urn:test:s45e:w3#e"), entity_ref("urn:test:s45e:w3#y1"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45E-04-ELECTION-OUT-BLOCKS-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_employer_408p2c1(entity_ref("urn:test:s45e:w4#e"), entity_ref("urn:test:s45e:w4#y1")) { origin case_input; }
        assert "f2": elects_out_of_section_45e(entity_ref("urn:test:s45e:w4#e"), entity_ref("urn:test:s45e:w4#y1")) { origin case_input; }
    }
    evaluate truth(section_45e_does_not_apply(entity_ref("urn:test:s45e:w4#e"), entity_ref("urn:test:s45e:w4#y1")));
    expect truth_status == TRUE_ONLY;
}

test "S45E-05-ADDITIONAL-CREDIT-YEAR-ESTABLISHED-100-PERCENT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": plan_year_number_45e(entity_ref("urn:test:s45e:w5#e"), entity_ref("urn:test:s45e:w5#y1"), 1.0) { origin case_input; }
        assert "f2": qualifying_employer_contributions_45e_f(entity_ref("urn:test:s45e:w5#e"), entity_ref("urn:test:s45e:w5#y1"), 8000.00 USD) { origin case_input; }
    }
    // year 1 -> 100%; 100% * 8000 = 8000; no preceding-year-count fact -> no phase-in reduction.
    evaluate truth(additional_credit_45e_f(entity_ref("urn:test:s45e:w5#e"), entity_ref("urn:test:s45e:w5#y1"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45E-06-ADDITIONAL-CREDIT-PHASEIN-REDUCTION-OVER-50-EMPLOYEES" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": plan_year_number_45e(entity_ref("urn:test:s45e:w6#e"), entity_ref("urn:test:s45e:w6#y2"), 2.0) { origin case_input; }
        assert "f2": qualifying_employer_contributions_45e_f(entity_ref("urn:test:s45e:w6#e"), entity_ref("urn:test:s45e:w6#y2"), 10000.00 USD) { origin case_input; }
        assert "f3": preceding_year_employee_count_45e(entity_ref("urn:test:s45e:w6#e"), entity_ref("urn:test:s45e:w6#y2"), 60.0) { origin case_input; }
    }
    // year 2 -> 75%; before = 7500; reduction = 7500 * (0.02*(60-50)) = 7500*0.20 = 1500; net = 6000.
    evaluate truth(additional_credit_45e_f(entity_ref("urn:test:s45e:w6#e"), entity_ref("urn:test:s45e:w6#y2"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45T-01-AUTO-ENROLLMENT-CREDIT-500-DURING-PERIOD" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_employer_408p2c1(entity_ref("urn:test:s45t:w1#e"), entity_ref("urn:test:s45t:w1#y1")) { origin case_input; }
        assert "f2": within_credit_period_45t(entity_ref("urn:test:s45t:w1#e"), entity_ref("urn:test:s45t:w1#y1")) { origin case_input; }
        assert "f3": eligible_automatic_contribution_arrangement_included(entity_ref("urn:test:s45t:w1#e"), entity_ref("urn:test:s45t:w1#y1")) { origin case_input; }
    }
    evaluate truth(retirement_auto_enrollment_credit(entity_ref("urn:test:s45t:w1#e"), entity_ref("urn:test:s45t:w1#y1"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45T-02-OUTSIDE-CREDIT-PERIOD-UNDETERMINED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_employer_408p2c1(entity_ref("urn:test:s45t:w2#e"), entity_ref("urn:test:s45t:w2#y5")) { origin case_input; }
    }
    // no within_credit_period_45t fact asserted for this year — NEITHER, not a proven zero.
    evaluate truth(retirement_auto_enrollment_credit(entity_ref("urn:test:s45t:w2#e"), entity_ref("urn:test:s45t:w2#y5"), 0 USD));
    expect truth_status == NEITHER;
}
