test "S45YE-01-INDEXED-AMOUNTS-2026-ROUNDED-TO-005-AND-01-CENT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gdp_implicit_price_deflator_45(2025.0, 126.0) { origin case_input; }
        assert "f1": gdp_implicit_price_deflator_45(1992.0, 60.0) { origin case_input; }
    }
    evaluate truth(base_amount_cents_45y_c(2026.0, 0.65, 3.2));
    expect truth_status == TRUE_ONLY;
}

