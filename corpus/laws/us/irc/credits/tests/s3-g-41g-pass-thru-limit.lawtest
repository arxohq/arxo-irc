// Credits stage 3: section 41(g) limit for pass-thru interests.
// NOT EXECUTED: status implemented_unverified. Expectations come from the pinned statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S3 41g not a pass-thru holder unlimited" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_research_expenses(entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#p"), entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#y"), 500000.00 USD) { origin case_input; }
        assert "f1": fixed_base_percentage_41c3(entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#p"), entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#y"), 0.03) { origin case_input; }
        assert "f2": average_annual_gross_receipts_4yr(entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#p"), entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#y"), 4000000.00 USD) { origin case_input; }
    }
    evaluate truth(research_credit(entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#p"), entity_ref("urn:test:s3 41g not a pass-thru holder unlimited#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

