test "S32D-25-2021-NO-CHILDREN-CREDIT-COMPUTES" {
    given {
        context {
            legal_time @2021-06-30; decision_time @2021-06-30T09:00:00-05:00;
            knowledge_time @2021-06-30T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_year_begin_32n(entity_ref("urn:test:s32d:w25#y"), @2021-01-01) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s32d:w25#t"), entity_ref("urn:test:s32d:w25#y"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": principal_place_of_abode_in_us_more_than_half_year_32(entity_ref("urn:test:s32d:w25#t"), entity_ref("urn:test:s32d:w25#y")) { origin case_input; }
        assert "f3": age_attained_by_close_of_year_32n(entity_ref("urn:test:s32d:w25#t"), entity_ref("urn:test:s32d:w25#y"), 20.0) { origin case_input; }
        assert "f4": eic_identification_requirements_met(entity_ref("urn:test:s32d:w25#t"), entity_ref("urn:test:s32d:w25#y")) { origin case_input; }
        assert "f5": earned_income_32(entity_ref("urn:test:s32d:w25#t"), entity_ref("urn:test:s32d:w25#y"), 9000.00 USD) { origin case_input; }
        assert "f6": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s32d:w25#t"), entity_ref("urn:test:s32d:w25#y"), 9000.00 USD) { origin case_input; }
    }
    evaluate truth(earned_income_credit(entity_ref("urn:test:s32d:w25#t"), entity_ref("urn:test:s32d:w25#y"), 1377.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    description "2021, no children, age 20 (eligible only under the (n) special age test, not the 25-to-64 test), off a joint return: 15.3% of min(9000, 9820) = 1377.00; 9000 < 11610, no phaseout; (j) disapplied per (n)(4)(B)";
}
