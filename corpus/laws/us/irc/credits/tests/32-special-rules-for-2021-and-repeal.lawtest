test "S32D-01-YEAR-BEGINNING-JANUARY-1-2021-IN-SPECIAL-RULES" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_year_begin_32n(entity_ref("urn:test:s32d:w1#y"), @2021-01-01) { origin case_input; }
    }
    evaluate truth(year_in_2021_special_rules_32n(entity_ref("urn:test:s32d:w1#y")));
    expect truth_status == TRUE_ONLY;
}

