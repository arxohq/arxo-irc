test "S36BD-07-HOUSEHOLD-INCOME-SCALED-BY-POVERTY-LINE-FRACTION" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": household_income_before_e1_adjustment_36b(entity_ref("urn:test:s36bd:w7#t"), entity_ref("urn:test:s36bd:w7#y"), 60000.00 USD) { origin case_input; }
        assert "f1": family_size_excluding_not_lawfully_present_36b(entity_ref("urn:test:s36bd:w7#t"), entity_ref("urn:test:s36bd:w7#y"), 3.0) { origin case_input; }
        assert "f2": family_size_36b(entity_ref("urn:test:s36bd:w7#t"), entity_ref("urn:test:s36bd:w7#y"), 4.0) { origin case_input; }
        assert "f3": poverty_line_amount(3.0, entity_ref("urn:test:s36bd:w7#y"), 24000.00 USD) { origin case_input; }
        assert "f4": poverty_line_amount(4.0, entity_ref("urn:test:s36bd:w7#y"), 30000.00 USD) { origin case_input; }
    }
    evaluate truth(household_income_adjusted_for_unlawful_presence_36b(entity_ref("urn:test:s36bd:w7#t"), entity_ref("urn:test:s36bd:w7#y"), 48000.00 USD));
    expect truth_status == TRUE_ONLY;
}

