// Section 36B lawfully present and unemployment rule scenarios (stage 2f).
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S36BD-01-CITIZEN-EXPECTED-TO-REMAIN-LAWFULLY-PRESENT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": individual_status_36b(entity_ref("urn:test:s36bd:w1#p"), CitizenOrNational) { origin case_input; }
        assert "f1": reasonably_expected_to_remain_status_for_entire_enrollment_period_36b(entity_ref("urn:test:s36bd:w1#p")) { origin case_input; }
    }
    evaluate truth(lawfully_present_36b(entity_ref("urn:test:s36bd:w1#p")));
    expect truth_status == TRUE_ONLY;
}

