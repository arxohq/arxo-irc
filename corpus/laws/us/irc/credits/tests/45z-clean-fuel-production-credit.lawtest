language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45Z-01-STANDARD-20-CENTS-TIMES-EMISSIONS-FACTOR" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transportation_fuel_gallons_sold_45z(entity_ref("urn:test:45z:w1#t"), entity_ref("urn:test:45z:w1#fu"), entity_ref("urn:test:45z:w1#y"), 1000000.0) { origin case_input; }
        assert "f1": fuel_produced_on_45z(entity_ref("urn:test:45z:w1#fu"), @2025-03-01) { origin case_input; }
        assert "f2": fuel_sold_on_45z(entity_ref("urn:test:45z:w1#fu"), @2025-06-01) { origin case_input; }
        assert "f3": fuel_facility_45z(entity_ref("urn:test:45z:w1#fu"), entity_ref("urn:test:45z:w1#fa")) { origin case_input; }
        assert "f4": fuel_sold_to_unrelated_person_in_described_manner_45z(entity_ref("urn:test:45z:w1#fu")) { origin case_input; }
        assert "f5": fuel_emissions_rate_45z(entity_ref("urn:test:45z:w1#fu"), 25.0) { origin case_input; }
        assert "f6": fuel_suitable_for_highway_vehicle_or_aircraft_45z(entity_ref("urn:test:45z:w1#fu")) { origin case_input; }
        assert "f7": facility_used_for_transportation_fuel_45z(entity_ref("urn:test:45z:w1#fa")) { origin case_input; }
        assert "f8": producer_registered_under_4101_45z(entity_ref("urn:test:45z:w1#t")) { origin case_input; }
        assert "f9": fuel_produced_in_united_states_45z(entity_ref("urn:test:45z:w1#fu")) { origin case_input; }
        assert "f10": us.irc.core::begins(entity_ref("urn:test:45z:w1#y"), @2025-01-01) { origin case_input; }
        assert "f11": paragraph_f8_enacted_on_45z(@2025-07-04) { origin case_input; }
        assert "f12": inflation_adjustment_factor_45z(entity_ref("urn:test:45z:w1#y"), 1.0) { origin case_input; }
    }
    // factor (50-25)/50 = 0.5; 20 cents x 1,000,000 gallons x 0.5.
    evaluate truth(clean_fuel_credit_per_fuel_45z(entity_ref("urn:test:45z:w1#t"), entity_ref("urn:test:45z:w1#fu"), entity_ref("urn:test:45z:w1#y"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}

