test "S45Z-18-GUIDANCE-NOT-ISSUED-BY-2025-01-01-DUTY-VIOLATED" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": section_45z_enacted_on(@2022-08-16) { origin case_input; }
    }
    // The Secretary had to issue guidance by 2025-01-01; none is asserted at the 2025-04-15 reading date.
    evaluate positions();
    expect position(Section45zEGuidanceDuty, VIOLATED);
}
