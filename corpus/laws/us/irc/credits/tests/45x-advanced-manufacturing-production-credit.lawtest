// Section 45X scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45X-01-BATTERY-CELL-35-PER-KWH" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_component_produced_and_sold_45x(entity_ref("urn:test:s45x:w1#t"), entity_ref("urn:test:s45x:w1#c"), entity_ref("urn:test:s45x:w1#y1"), BatteryCell) { origin case_input; }
        assert "f2": component_quantity_45x(entity_ref("urn:test:s45x:w1#c"), 100.0) { origin case_input; }
    }
    // $35 * 100 kWh = 3500.
    evaluate truth(credit_amount_before_phaseout_45x(entity_ref("urn:test:s45x:w1#c"), entity_ref("urn:test:s45x:w1#y1"), 3500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45X-02-PHOTOVOLTAIC-CELL-4-CENTS-PER-WATT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": eligible_component_produced_and_sold_45x(entity_ref("urn:test:s45x:w2#t"), entity_ref("urn:test:s45x:w2#c"), entity_ref("urn:test:s45x:w2#y1"), PhotovoltaicCell) { origin case_input; }
        assert "f2": component_quantity_45x(entity_ref("urn:test:s45x:w2#c"), 500000.0) { origin case_input; }
    }
    // $0.04 * 500,000 watts = 20000.
    evaluate truth(credit_amount_before_phaseout_45x(entity_ref("urn:test:s45x:w2#c"), entity_ref("urn:test:s45x:w2#y1"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45X-03-PHASEOUT-75-PERCENT-IN-2030" {
    given {
        context {
            legal_time @2030-04-15; decision_time @2030-04-15T09:00:00-05:00;
            knowledge_time @2030-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": credit_amount_before_phaseout_45x(entity_ref("urn:test:s45x:w3#c"), entity_ref("urn:test:s45x:w3#y1"), 4000.00 USD) { origin case_input; }
        assert "f2": component_sale_date_45x(entity_ref("urn:test:s45x:w3#c"), @2030-03-01) { origin case_input; }
    }
    // 4000 * 0.75 = 3000.
    evaluate truth(credit_amount_45x(entity_ref("urn:test:s45x:w3#c"), entity_ref("urn:test:s45x:w3#y1"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45X-04-CRITICAL-MINERAL-10-PERCENT-OF-COST-NO-PHASEOUT" {
    given {
        context {
            legal_time @2031-04-15; decision_time @2031-04-15T09:00:00-05:00;
            knowledge_time @2031-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": applicable_critical_mineral_production_cost(entity_ref("urn:test:s45x:w4#t"), entity_ref("urn:test:s45x:w4#c"), entity_ref("urn:test:s45x:w4#y1"), 10000.00 USD) { origin case_input; }
    }
    // 10% * 10000 = 1000, unaffected by the base (b)(3) phase-out (exempt).
    evaluate truth(applicable_critical_mineral_credit_amount(entity_ref("urn:test:s45x:w4#c"), entity_ref("urn:test:s45x:w4#y1"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45X-05-WIND-COMPONENT-TERMINATED-AFTER-2027" {
    given {
        context {
            legal_time @2028-04-15; decision_time @2028-04-15T09:00:00-05:00;
            knowledge_time @2028-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f1": wind_energy_component_45x(entity_ref("urn:test:s45x:w5#c")) { origin case_input; }
        assert "f2": component_sale_date_45x(entity_ref("urn:test:s45x:w5#c"), @2028-02-01) { origin case_input; }
    }
    evaluate truth(terminated_wind_energy_component_45x(entity_ref("urn:test:s45x:w5#c")));
    expect truth_status == TRUE_ONLY;
}
