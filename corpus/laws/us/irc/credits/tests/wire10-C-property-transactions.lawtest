// Credits WIRE-10 (group C): section 38(b)(9) component from property_transactions section 1396.
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "W10C-CRE-05-ONE-EMPLOYEE-ZONE-CREDIT-IS-COMPONENT-9" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.property_transactions::empowerment_zone_employment_credit(entity_ref("urn:test:w10c:z1#e1"), entity_ref("urn:test:w10c:z1#er"), entity_ref("urn:test:w10c:z1#y"), 3000.00 USD) { origin case_input; }
    }
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:w10c:z1#er"), entity_ref("urn:test:w10c:z1#y"), EmpowermentZoneEmploymentCredit1396, 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10C-CRE-06-TWO-EMPLOYEE-ZONE-CREDITS-ARE-SUMMED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.property_transactions::empowerment_zone_employment_credit(entity_ref("urn:test:w10c:z2#e1"), entity_ref("urn:test:w10c:z2#er"), entity_ref("urn:test:w10c:z2#y"), 3000.00 USD) { origin case_input; }
        assert "f1": us.irc.property_transactions::empowerment_zone_employment_credit(entity_ref("urn:test:w10c:z2#e2"), entity_ref("urn:test:w10c:z2#er"), entity_ref("urn:test:w10c:z2#y"), 1200.50 USD) { origin case_input; }
    }
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:w10c:z2#er"), entity_ref("urn:test:w10c:z2#y"), EmpowermentZoneEmploymentCredit1396, 4200.50 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10C-CRE-07-COMPONENT-9-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": general_business_credit_component_amount(entity_ref("urn:test:w10c:z3#er"), entity_ref("urn:test:w10c:z3#y"), EmpowermentZoneEmploymentCredit1396, 900.00 USD) { origin case_input; }
    }
    evaluate truth(general_business_credit_component_amount(entity_ref("urn:test:w10c:z3#er"), entity_ref("urn:test:w10c:z3#y"), EmpowermentZoneEmploymentCredit1396, 900.00 USD));
    expect truth_status == TRUE_ONLY;
}
