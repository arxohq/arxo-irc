// Section 45AA scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

test "S45AA-01-FIRST-YEAR-200-PLUS-CONTRIBUTIONS-CAPPED-AT-300" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_small_employer_45aa(entity_ref("urn:test:45aa:w1#e"), entity_ref("urn:test:45aa:w1#y")) { origin case_input; }
        assert "f1": military_spouse_of_employer_45aa(entity_ref("urn:test:45aa:w1#w"), entity_ref("urn:test:45aa:w1#e")) { origin case_input; }
        assert "f2": eligible_defined_contribution_plan_terms_met_45aa(entity_ref("urn:test:45aa:w1#e"), entity_ref("urn:test:45aa:w1#y")) { origin case_input; }
        assert "f3": participates_in_plan_during_year_45aa(entity_ref("urn:test:45aa:w1#w"), entity_ref("urn:test:45aa:w1#e"), entity_ref("urn:test:45aa:w1#y")) { origin case_input; }
        assert "f4": began_participating_on_45aa(entity_ref("urn:test:45aa:w1#w"), entity_ref("urn:test:45aa:w1#e"), @2024-03-01) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:45aa:w1#y"), @2024-01-01) { origin case_input; }
        assert "f6": us.irc.core::ends(entity_ref("urn:test:45aa:w1#y"), @2024-12-31) { origin case_input; }
        assert "f7": employer_contributions_other_than_elective_deferrals_45aa(entity_ref("urn:test:45aa:w1#e"), entity_ref("urn:test:45aa:w1#w"), entity_ref("urn:test:45aa:w1#y"), 500.00 USD) { origin case_input; }
    }
    // 200 + min(500, 300) = 500.
    evaluate truth(military_spouse_credit_per_employee_45aa(entity_ref("urn:test:45aa:w1#e"), entity_ref("urn:test:45aa:w1#w"), entity_ref("urn:test:45aa:w1#y"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S45AA-02-CONTRIBUTIONS-BELOW-300" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_small_employer_45aa(entity_ref("urn:test:45aa:w2#e"), entity_ref("urn:test:45aa:w2#y")) { origin case_input; }
        assert "f1": military_spouse_of_employer_45aa(entity_ref("urn:test:45aa:w2#w"), entity_ref("urn:test:45aa:w2#e")) { origin case_input; }
        assert "f2": eligible_defined_contribution_plan_terms_met_45aa(entity_ref("urn:test:45aa:w2#e"), entity_ref("urn:test:45aa:w2#y")) { origin case_input; }
        assert "f3": participates_in_plan_during_year_45aa(entity_ref("urn:test:45aa:w2#w"), entity_ref("urn:test:45aa:w2#e"), entity_ref("urn:test:45aa:w2#y")) { origin case_input; }
        assert "f4": began_participating_on_45aa(entity_ref("urn:test:45aa:w2#w"), entity_ref("urn:test:45aa:w2#e"), @2024-03-01) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:45aa:w2#y"), @2024-01-01) { origin case_input; }
        assert "f6": us.irc.core::ends(entity_ref("urn:test:45aa:w2#y"), @2024-12-31) { origin case_input; }
        assert "f7": employer_contributions_other_than_elective_deferrals_45aa(entity_ref("urn:test:45aa:w2#e"), entity_ref("urn:test:45aa:w2#w"), entity_ref("urn:test:45aa:w2#y"), 100.00 USD) { origin case_input; }
    }
    // 200 + 100.
    evaluate truth(military_spouse_credit_per_employee_45aa(entity_ref("urn:test:45aa:w2#e"), entity_ref("urn:test:45aa:w2#w"), entity_ref("urn:test:45aa:w2#y"), 300.00 USD));
    expect truth_status == TRUE_ONLY;
}

