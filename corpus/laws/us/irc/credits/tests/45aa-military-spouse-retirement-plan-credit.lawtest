test "S45AA-04-SECOND-SUCCEEDING-YEAR-STILL-COUNTS" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_small_employer_45aa(entity_ref("urn:test:45aa:w4#e"), entity_ref("urn:test:45aa:w4#y")) { origin case_input; }
        assert "f1": military_spouse_of_employer_45aa(entity_ref("urn:test:45aa:w4#w"), entity_ref("urn:test:45aa:w4#e")) { origin case_input; }
        assert "f2": eligible_defined_contribution_plan_terms_met_45aa(entity_ref("urn:test:45aa:w4#e"), entity_ref("urn:test:45aa:w4#y")) { origin case_input; }
        assert "f3": participates_in_plan_during_year_45aa(entity_ref("urn:test:45aa:w4#w"), entity_ref("urn:test:45aa:w4#e"), entity_ref("urn:test:45aa:w4#y")) { origin case_input; }
        assert "f4": began_participating_on_45aa(entity_ref("urn:test:45aa:w4#w"), entity_ref("urn:test:45aa:w4#e"), @2024-03-01) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:45aa:w4#y"), @2026-01-01) { origin case_input; }
        assert "f6": us.irc.core::ends(entity_ref("urn:test:45aa:w4#y"), @2026-12-31) { origin case_input; }
        assert "f7": employer_contributions_other_than_elective_deferrals_45aa(entity_ref("urn:test:45aa:w4#e"), entity_ref("urn:test:45aa:w4#w"), entity_ref("urn:test:45aa:w4#y"), 500.00 USD) { origin case_input; }
    }
    // 2024 first year, 2026 the second succeeding year.
    evaluate truth(within_three_year_window_45aa(entity_ref("urn:test:45aa:w4#w"), entity_ref("urn:test:45aa:w4#e"), entity_ref("urn:test:45aa:w4#y")));
    expect truth_status == TRUE_ONLY;
}

test "S45AA-05-FOURTH-YEAR-OUTSIDE-WINDOW" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_small_employer_45aa(entity_ref("urn:test:45aa:w5#e"), entity_ref("urn:test:45aa:w5#y")) { origin case_input; }
        assert "f1": military_spouse_of_employer_45aa(entity_ref("urn:test:45aa:w5#w"), entity_ref("urn:test:45aa:w5#e")) { origin case_input; }
        assert "f2": eligible_defined_contribution_plan_terms_met_45aa(entity_ref("urn:test:45aa:w5#e"), entity_ref("urn:test:45aa:w5#y")) { origin case_input; }
        assert "f3": participates_in_plan_during_year_45aa(entity_ref("urn:test:45aa:w5#w"), entity_ref("urn:test:45aa:w5#e"), entity_ref("urn:test:45aa:w5#y")) { origin case_input; }
        assert "f4": began_participating_on_45aa(entity_ref("urn:test:45aa:w5#w"), entity_ref("urn:test:45aa:w5#e"), @2024-03-01) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:45aa:w5#y"), @2027-01-01) { origin case_input; }
        assert "f6": us.irc.core::ends(entity_ref("urn:test:45aa:w5#y"), @2027-12-31) { origin case_input; }
        assert "f7": employer_contributions_other_than_elective_deferrals_45aa(entity_ref("urn:test:45aa:w5#e"), entity_ref("urn:test:45aa:w5#w"), entity_ref("urn:test:45aa:w5#y"), 500.00 USD) { origin case_input; }
    }
    // 2027 is the third year after the first: outside (b).
    evaluate truth(within_three_year_window_45aa(entity_ref("urn:test:45aa:w5#w"), entity_ref("urn:test:45aa:w5#e"), entity_ref("urn:test:45aa:w5#y")));
    expect truth_status == NEITHER;
}

test "S45AA-06-PLAN-TERMS-NOT-MET-NO-CREDIT" {
    given {
        context {
            legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00;
