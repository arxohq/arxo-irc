// Section 25C — Energy efficient home improvement credit. Stage 2c (IRC-06
// stage 2c, DECISION-0379). Priority list item: §25C (30 percent, the
// $1,200/$2,000 caps and per-item limits, PL 119-21 §70505 termination —
// edition).
//
// Judgment calls / scope:
// * STAGE 2d UPDATE: `us.irc.temporal::PL119_21_S70505` IS now pinned (WIRE-3)
//   and the termination is modelled below as two `effective` editions (see
//   the section "§25C(i): termination"); the paragraph that follows is the
//   stage 2c text kept for the record. PL 119-21 section 70505 ("TERMINATION
//   OF ENERGY EFFICIENT HOME IMPROVEMENT CREDIT") was NOT among the fragments
//   `us.irc.temporal` had pinned: grepping `us.irc.temporal/sources.law` for `PL119_21_S7050[1-8]`
//   finds ONLY 70509+ (`us.irc.temporal`'s own package.law documents a "14
//   of 104 sections" extraction gap for PL 119-21 sections that insert a
//   whole new nested USLM `<section>` element; 70501-70508 and 70511 are
//   exactly the missing ones, confirmed by inspecting the gitignored raw
//   XML directly for THIS report only — never for a citation, since an
//   un-pinned source cannot be `@source`d). This package does NOT own
//   `us.irc.temporal` and cannot add the missing fragment itself (never
//   edit another owner's package). The termination is therefore SOURCE_GAP
//   (TECH-GAPS G391), not modelled as an edition boundary — this module
//   implements the CURRENT (pre-termination) 2024-Edition computation only,
//   which remains correct for every taxable year up to whenever that
//   termination's actual effective date is (2025, per general public
//   knowledge of the enactment, but NOT pinned in this corpus, so NOT
//   asserted as a rule boundary here).
// * (c) ("qualified energy efficiency improvements": building-envelope
//   components — insulation, exterior windows/skylights, exterior doors —
//   installed in the taxpayer's US principal residence, original use, 5-
//   year expected life, meeting the Energy Star/prescriptive-criteria
//   standard) and (d) ("qualified energy property": heat pumps, central air
//   conditioners, water heaters, furnaces/boilers, biomass stoves/boilers,
//   panelboards/sub-panelboards/branch circuits, meeting the highest non-
//   advanced efficiency tier) are NOT decomposed item by item — the
//   category-level cost relations below (`windows_and_skylights_
//   expenditure`, `exterior_doors_expenditure_before_cap`,
//   `building_envelope_insulation_expenditure`, `heat_pump_or_biomass_
//   property_expenditure`, `other_qualified_energy_property_expenditure_
//   after_item_cap`) are case-asserted, read as ALREADY qualifying under
//   (c)/(d)'s own tests (TECH_GAP for the item-level Energy Star/
//   efficiency-tier tests, TECH-GAPS G391).
// * (b)(4)(A)'s $250-per-door sub-cap is NOT modelled — only the (b)(4)(B)
//   $500 aggregate-across-all-doors cap is applied to a case-asserted PRE-
//   aggregated door expenditure total (`exterior_doors_expenditure_before_
//   cap`); a per-door enumeration with its own $250 ceiling is TECH_GAP,
//   same "per-item cap over a case-aggregated total" class as (b)(2)'s own
//   simplification below.
// * (b)(2)'s $600-per-item cap on "other" qualified energy property (i.e.
//   NOT heat pumps/biomass, which have their own (b)(5) $2,000 aggregate)
//   is likewise READ AS ALREADY APPLIED in the case-asserted `other_
//   qualified_energy_property_expenditure_after_item_cap` input, rather
//   than derived from a per-item breakdown — TECH_GAP.
// * (b)(6)(B) (the substantiation-documentation requirement for the home-
//   energy-audit credit) is modelled as a gating classification fact.
// * `non_heat_pump_credit_before_overall_cap` requires all FIVE category
//   facts (windows/doors/insulation/other-energy-property/home-energy-
//   audit) to be asserted for the taxable year, including as 0 USD where a
//   category does not apply — this pass does not build the "_or_zero"
//   per-category fallback idiom used elsewhere in this package (e.g.
//   section 45R/45E) for all five categories; a scenario must supply every
//   category explicitly (TECH-GAPS G391).

use self::{
    IRC_S25C_A,
    IRC_S25C_B,
    IRC_S25C_I,
    Individual,
    TaxableYear,
    doors_expenditure_for_credit_25c,
    heat_pump_expenditure_for_credit_25c,
    insulation_expenditure_for_credit_25c,
    other_expenditure_for_credit_25c,
    windows_expenditure_for_credit_25c,
};

pub relation building_envelope_insulation_expenditure(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amount paid or incurred for qualified insulation material/system building envelope components (section 25C(c)(3)(A)) — case-asserted, no separate per-item cap under (b)";
}
pub relation windows_and_skylights_expenditure(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amount paid or incurred for qualified exterior windows and skylights (section 25C(c)(3)(B)) — case-asserted, before the section 25C(b)(3) $600 aggregate cap";
}
pub relation exterior_doors_expenditure_before_cap(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "aggregate amount paid or incurred for qualified exterior doors (section 25C(c)(3)(C)) — case-asserted, ALREADY the aggregate across all doors (the section 25C(b)(4)(A) $250-per-door sub-cap is not separately derived, TECH-GAPS G391), before the section 25C(b)(4)(B) $500 aggregate cap";
}
pub relation heat_pump_or_biomass_property_expenditure(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amount paid or incurred for property described in section 25C(d)(2)(A)(i)-(ii) (electric/natural-gas heat pump water heaters and heat pumps) or (d)(2)(B) (biomass stoves/boilers) — case-asserted, before the section 25C(b)(5) $2,000 aggregate cap";
}
pub relation other_qualified_energy_property_expenditure_after_item_cap(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "aggregate amount paid or incurred for qualified energy property OTHER than heat pumps/biomass (central air conditioners, water heaters, furnaces/boilers, panelboards) — case-asserted ALREADY NET of the section 25C(b)(2) $600-per-item cap (TECH-GAPS G391)";
}
pub relation home_energy_audit_expenditure(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amount paid or incurred during the taxable year for a home energy audit (section 25C(a)(3)) — case-asserted, before the section 25C(b)(6)(A) $150 cap";
}
pub relation home_energy_audit_substantiated(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes with the return the information/documentation the Secretary requires for the home energy audit credit (section 25C(b)(6)(B)) — case-asserted";
}

// --- §25C(a)(1)/(b)(3)-(4): qualified energy efficiency improvements ----------

pub relation windows_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "30 percent of window/skylight expenditures, capped at $600 in the aggregate (section 25C(b)(3))";
}
@source(IRC_S25C_B, quote = "The credit allowed under this section by reason of subsection (a)(1) with respect to any taxpayer for any taxable year shall not exceed, in the aggregate with respect to all exterior windows and skylights, $600.")
rule WindowsCreditRule(taxpayer: Individual, y: TaxableYear, expenditure: Money) strict {
    when windows_expenditure_for_credit_25c(taxpayer, y, expenditure);
    then windows_credit(taxpayer, y, min(600.00 USD, round(0.30 * expenditure, 2, "HALF_UP")));
}
pub relation doors_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "30 percent of exterior-door expenditures, capped at $500 in the aggregate (section 25C(b)(4)(B); the (b)(4)(A) $250-per-door sub-cap is not separately modelled)";
}
@source(IRC_S25C_B, quote = "$500 in the aggregate with respect to all exterior doors")
rule DoorsCreditRule(taxpayer: Individual, y: TaxableYear, expenditure: Money) strict {
    when doors_expenditure_for_credit_25c(taxpayer, y, expenditure);
    then doors_credit(taxpayer, y, min(500.00 USD, round(0.30 * expenditure, 2, "HALF_UP")));
}
pub relation insulation_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "30 percent of building-envelope insulation expenditures — no separate per-item cap under (b), only the overall section 25C(b)(1) $1,200 cap applies";
}
@source(IRC_S25C_A, quote = "30 percent of the sum of—\n(1) the amount paid or incurred by the taxpayer for qualified energy efficiency improvements installed")
rule InsulationCreditRule(taxpayer: Individual, y: TaxableYear, expenditure: Money) strict {
    when insulation_expenditure_for_credit_25c(taxpayer, y, expenditure);
    then insulation_credit(taxpayer, y, round(0.30 * expenditure, 2, "HALF_UP"));
}

// --- §25C(a)(2)/(b)(2)/(b)(5): residential energy property expenditures -------

pub relation other_energy_property_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "30 percent of non-heat-pump/biomass qualified energy property expenditures (section 25C(a)(2)), subject to the section 25C(b)(1) overall cap but not to a separate line-item cap here (the (b)(2) per-item $600 cap is already netted into the case-asserted input)";
}
@source(IRC_S25C_A, quote = "the amount of the residential energy property expenditures paid or incurred by the taxpayer during such taxable year")
rule OtherEnergyPropertyCreditRule(taxpayer: Individual, y: TaxableYear, expenditure: Money) strict {
    when other_expenditure_for_credit_25c(taxpayer, y, expenditure);
    then other_energy_property_credit(taxpayer, y, round(0.30 * expenditure, 2, "HALF_UP"));
}
pub relation heat_pump_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "30 percent of heat pump/heat pump water heater/biomass stove-or-boiler expenditures, capped at $2,000 in the aggregate, NOTWITHSTANDING the section 25C(b)(1)/(b)(2) caps (section 25C(b)(5))";
}
@source(IRC_S25C_B, quote = "Notwithstanding paragraphs (1) and (2), the credit allowed under this section by reason of subsection (a)(2) with respect to any taxpayer for any taxable year shall not, in the aggregate, exceed $2,000 with respect to amounts paid or incurred for property described in clauses (i) and (ii) of subsection (d)(2)(A) and in subsection (d)(2)(B).")
rule HeatPumpCreditRule(taxpayer: Individual, y: TaxableYear, expenditure: Money) strict {
    when heat_pump_expenditure_for_credit_25c(taxpayer, y, expenditure);
    then heat_pump_credit(taxpayer, y, min(2000.00 USD, round(0.30 * expenditure, 2, "HALF_UP")));
}

// --- §25C(a)(3)/(b)(6): home energy audits --------------------------------------

pub relation home_energy_audit_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "30 percent of home energy audit expenditures, capped at $150 (section 25C(b)(6)(A)), conditioned on the (b)(6)(B) substantiation requirement";
}
@source(IRC_S25C_B, quote = "The amount of the credit allowed under this section by reason of subsection (a)(3) shall not exceed $150.")
rule HomeEnergyAuditCreditRule(taxpayer: Individual, y: TaxableYear, expenditure: Money) strict {
    when home_energy_audit_expenditure(taxpayer, y, expenditure);
    when home_energy_audit_substantiated(taxpayer, y);
    then home_energy_audit_credit(taxpayer, y, min(150.00 USD, round(0.30 * expenditure, 2, "HALF_UP")));
}

// --- §25C(b)(1): overall $1,200 cap and total credit ----------------------------

pub relation non_heat_pump_credit_before_overall_cap(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the windows, doors, insulation, other-energy-property and home-energy-audit credit amounts, before the section 25C(b)(1) overall $1,200 cap";
}
rule NonHeatPumpCreditBeforeOverallCapRule(taxpayer: Individual, y: TaxableYear, windows: Money, doors: Money, insulation: Money, other: Money, audit: Money) strict {
    when windows_credit(taxpayer, y, windows);
    when doors_credit(taxpayer, y, doors);
    when insulation_credit(taxpayer, y, insulation);
    when other_energy_property_credit(taxpayer, y, other);
    when home_energy_audit_credit(taxpayer, y, audit);
    then non_heat_pump_credit_before_overall_cap(taxpayer, y, windows + doors + insulation + other + audit);
}
// --- §25C(i): termination, base and PL 119-21 editions (stage 2d) -----------------
//
// The termination (2024 text: property placed in service after 2007-12-31 and
// before 2009-01-01, or after 2032-12-31; the amendment of PL 119-21 section
// 70505 is drafted against "section 25C(h)" but the pinned 2024 text has the
// termination in subsection (i)) is modelled as two `effective` editions by
// legal_time: before 2025-07-04 the 2024 text; from 2025-07-04 property placed
// in service after 2025-12-31 (`us.irc.temporal::PL119_21_S70505`). The
// property placed-in-service date is one case fact per taxable year (a year
// with property placed on several dates is read at the asserted date; G1790).
pub relation placed_in_service_date_25c(taxpayer: Individual, y: TaxableYear, on: Date) kind empirical {
    label en official "the date the qualified energy efficiency improvement or qualified energy property is placed in service in the taxable year (section 25C(i)) — case-asserted, one date per year";
}
pub relation section_25c_terminated_25i(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 25C(i): the section does not apply to property placed in service in the gap or after the end date of the applicable edition";
}
@source(IRC_S25C_I, quote = "after December 31, 2032")
rule Section25cTerminationBaseAfter2032Rule(taxpayer: Individual, y: TaxableYear, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when placed_in_service_date_25c(taxpayer, y, on);
    when on > @2032-12-31;
    then section_25c_terminated_25i(taxpayer, y);
}
@source(IRC_S25C_I, quote = "after December 31, 2007, and before January 1, 2009")
rule Section25cTerminationBaseGapRule(taxpayer: Individual, y: TaxableYear, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when placed_in_service_date_25c(taxpayer, y, on);
    when on > @2007-12-31;
    when on < @2009-01-01;
    then section_25c_terminated_25i(taxpayer, y);
}
@source(us.irc.temporal::PL119_21_S70505, quote = "Section 25C(h) is amended by striking “placed in service” and all that follows through “December 31, 2032” and inserting “placed in service after December 31, 2025”.")
rule Section25cTerminationAmendedRule(taxpayer: Individual, y: TaxableYear, on: Date) strict {
    effective [@2025-07-04, infinity);
    when placed_in_service_date_25c(taxpayer, y, on);
    when on > @2025-12-31;
    then section_25c_terminated_25i(taxpayer, y);
}

pub relation energy_efficient_home_improvement_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 25C energy efficient home improvement credit for the taxable year: the section 25C(b)(1) $1,200-capped sum of the non-heat-pump categories, plus the separately-capped $2,000 heat pump/biomass amount (section 25C(b)(5))";
}
@source(IRC_S25C_B, quote = "The credit allowed under this section with respect to any taxpayer for any taxable year shall not exceed $1,200.")
rule EnergyEfficientHomeImprovementCreditRule(taxpayer: Individual, y: TaxableYear, before: Money, heat_pump: Money) strict {
    when non_heat_pump_credit_before_overall_cap(taxpayer, y, before);
    when heat_pump_credit(taxpayer, y, heat_pump);
    when not_known(section_25c_terminated_25i(taxpayer, y));
    then energy_efficient_home_improvement_credit(taxpayer, y, min(1200.00 USD, before) + heat_pump);
}
