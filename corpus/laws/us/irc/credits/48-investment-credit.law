// Section 46/48 — Investment credit. Stage 2 (IRC-06 stage 2,
// DECISION-0379), extended stage 2c. Priority list item: §48(a) core,
// folded with §47's rehabilitation credit; stage 2c's `48-energy-
// credit.law` REPLACES this module's former `energy_credit_amount`
// dependency-contract stub (TECH-GAPS G310) with a real computation of
// section 48(a)(2)-(11)'s energy-percentage table, the prevailing-wage/
// apprenticeship 5x multiplier, and the domestic-content/energy-community
// bonuses — see that module's own header for what it does and does not
// reach. PL 119-21 terminations for section 48 energy property are still
// NOT modelled (no PL 119-21 fragment for section 48's own termination is
// pinned in `us.irc.temporal` for the property types this pass's priority
// list covers) — TECH_GAP/SOURCE_GAP, TECH-GAPS G391.
//
// §46 (as in effect before the Revenue Reconciliation Act of 1990, per
// section 49's cross-reference machinery this package does not reach) lists
// the investment credit's OWN sub-components: the rehabilitation credit
// (section 47), the energy credit (section 48), the qualifying advanced
// coal/gasification project credits, and the qualifying therapeutic
// discovery project credit. Only the rehabilitation credit and (as of stage
// 2c) the energy credit are wired; the qualifying advanced coal/
// gasification and therapeutic discovery project credits remain TECH_GAP.
//
// STAGE 2d REWRITE: section 46 (as in force) lists seven components; all seven
// are now wired through `investment_credit_component_46`: (1) rehabilitation
// (section 47), (2) energy (section 48), (3) qualifying advanced coal project
// (section 48A), (4) qualifying gasification project (section 48B), (5)
// qualifying advanced energy project (section 48C), (6) advanced manufacturing
// investment (section 48D) and (7) clean electricity investment (section 48E,
// summed over the taxpayer's facilities). The former has_energy_credit /
// energy_credit_amount_or_zero helpers are gone: the sum over the component
// relation needs no zero substitute. Deliberately NOT a recapture or
// carry-back computation (sections 50, 39).

use self::{
    Asset,
    IRC_S38_B,
    IRC_S46,
    Person,
    TaxableYear,
    advanced_manufacturing_investment_credit,
    clean_electricity_investment_credit,
    energy_credit_amount,
    owned_and_used_for_electricity_generation,
    qualifying_advanced_coal_project_credit,
    qualifying_advanced_energy_project_credit,
    qualifying_gasification_project_credit,
    rehabilitation_credit,
};

pub enum InvestmentCreditComponent46 {
    RehabilitationCredit47,
    EnergyCredit48,
    QualifyingAdvancedCoalProjectCredit48A,
    QualifyingGasificationProjectCredit48B,
    QualifyingAdvancedEnergyProjectCredit48C,
    AdvancedManufacturingInvestmentCredit48D,
    CleanElectricityInvestmentCredit48E,
}

pub relation investment_credit_component_46(taxpayer: Person, y: TaxableYear, component: InvestmentCreditComponent46, amount: Money) kind institutional {
    label en official "one of the seven section 46 components of the investment credit for the taxable year";
}
@source(IRC_S46, quote = "(1) the rehabilitation credit,")
rule InvestmentCreditComponentRehabilitation defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when rehabilitation_credit(taxpayer, y, amount);
    then investment_credit_component_46(taxpayer, y, RehabilitationCredit47, amount);
}
@source(IRC_S46, quote = "(2) the energy credit,")
rule InvestmentCreditComponentEnergy defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when energy_credit_amount(taxpayer, y, amount);
    then investment_credit_component_46(taxpayer, y, EnergyCredit48, amount);
}
@source(IRC_S46, quote = "(3) the qualifying advanced coal project credit,")
rule InvestmentCreditComponentAdvancedCoal defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when qualifying_advanced_coal_project_credit(taxpayer, y, amount);
    then investment_credit_component_46(taxpayer, y, QualifyingAdvancedCoalProjectCredit48A, amount);
}
@source(IRC_S46, quote = "(4) the qualifying gasification project credit,")
rule InvestmentCreditComponentGasification defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when qualifying_gasification_project_credit(taxpayer, y, amount);
    then investment_credit_component_46(taxpayer, y, QualifyingGasificationProjectCredit48B, amount);
}
@source(IRC_S46, quote = "(5) the qualifying advanced energy project credit,")
rule InvestmentCreditComponentAdvancedEnergy defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when qualifying_advanced_energy_project_credit(taxpayer, y, amount);
    then investment_credit_component_46(taxpayer, y, QualifyingAdvancedEnergyProjectCredit48C, amount);
}
@source(IRC_S46, quote = "(6) the advanced manufacturing investment credit, and")
rule InvestmentCreditComponentAdvancedManufacturing defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when advanced_manufacturing_investment_credit(taxpayer, y, amount);
    then investment_credit_component_46(taxpayer, y, AdvancedManufacturingInvestmentCredit48D, amount);
}
@source(IRC_S46, quote = "(7) the clean electricity investment credit.")
rule InvestmentCreditComponentCleanElectricity defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for facility: Asset;
    for amount: Money;
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when clean_electricity_investment_credit(facility, y, amount);
    then investment_credit_component_46(taxpayer, y, CleanElectricityInvestmentCredit48E,
        sum(collect all a: Money, f: Asset where owned_and_used_for_electricity_generation(f, taxpayer) and clean_electricity_investment_credit(f, y, a), empty: 0 USD));
}

pub relation investment_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 46 investment credit for the taxable year: the sum of its seven components (rehabilitation, energy, qualifying advanced coal project, qualifying gasification project, qualifying advanced energy project, advanced manufacturing investment, clean electricity investment)";
}
@source(IRC_S38_B, quote = "the investment credit determined under section 46")
@source(IRC_S46, quote = "the amount of the investment credit determined under this section for any taxable year shall be the sum of")
rule InvestmentCredit defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for component: InvestmentCreditComponent46;
    for amount: Money;
    when investment_credit_component_46(taxpayer, y, component, amount);
    then investment_credit(taxpayer, y,
        sum(collect all a: Money, c: InvestmentCreditComponent46 where investment_credit_component_46(taxpayer, y, c, a), empty: 0 USD));
}
