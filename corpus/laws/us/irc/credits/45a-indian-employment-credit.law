// Section 45A — Indian employment credit. Stage 2d (IRC-06, DECISION-0379).
// Section 45A(f): the section does not apply to taxable years beginning after
// December 31, 2021.
//
// Scope / judgment calls:
// * (a): 20 percent of the excess of (1) the qualified wages plus qualified
//   employee health insurance costs of the year over (2) the same amounts for
//   calendar year 1993 (the base, incl. predecessors). (b)(3): the aggregate
//   per employee is capped at $20,000 both for the year and for the base
//   period; the sums are over employees. The (b)(1)(B) section 51 overlap and
//   the (b)(2)(B) salary-reduction exclusion are read inside the case-asserted
//   amounts.
// * (c): qualified employee: enrolled tribe member (or spouse), substantially
//   all services within the reservation, abode on or near it, wages not above
//   the wage ceiling ($30,000, indexed under (c)(3) — the indexed ceiling is a
//   case-asserted yearly amount, TECH-GAPS G1538), more than 50 percent of
//   the wages for a trade or business of the employer, and none of the
//   (c)(5) exclusions.
// * (d): early termination (before one year of employment) removes the
//   employee from the termination year and increases tax by the prior credits
//   attributable; exceptions (voluntary leave, disability, misconduct, section
//   381 transactions and changes of form). The increase is exposed as an amount
//   (TECH-GAPS G1539).
// * (e)(5): short taxable year: the base is multiplied by days/365.

use self::{
    IRC_S45A_A,
    IRC_S45A_B,
    IRC_S45A_C,
    IRC_S45A_D,
    IRC_S45A_E,
    IRC_S45A_F,
    IRC_S45P_C,
    Individual,
    Person,
    TaxableYear,
    compensation_credit_reduction_45p,
    remuneration_disqualified_45a_51k2,
};

pub relation enrolled_member_or_spouse_of_indian_tribe_45a(employee: Individual) kind empirical {
    label en official "the employee is an enrolled member of an Indian tribe or the spouse of an enrolled member (section 45A(c)(1)(A)) — case-asserted";
}
pub relation services_substantially_all_within_reservation_45a(employee: Individual, employer: Person, y: TaxableYear) kind empirical {
    label en official "substantially all services performed for the employer during the period are performed within an Indian reservation (section 45A(c)(1)(B)) — case-asserted";
}
pub relation abode_on_or_near_reservation_45a(employee: Individual, y: TaxableYear) kind empirical {
    label en official "the principal place of abode of the employee while performing the services is on or near the reservation (section 45A(c)(1)(C)) — case-asserted";
}
pub relation total_wages_paid_to_employee_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total wages paid or incurred by the employer to the employee during the taxable year, whether or not for services within an Indian reservation (section 45A(c)(2)) — case-asserted";
}
pub relation wage_ceiling_45a(y: TaxableYear, amount: Money) kind empirical {
    label en official "the wage ceiling above which an employee is not a qualified employee: $30,000 adjusted under section 45A(c)(3) — case-asserted for the year, the indexed value is not pinned";
}
pub relation share_of_wages_for_trade_or_business_45a(employer: Person, employee: Individual, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the wages paid to the employee for services performed in a trade or business of the employer (section 45A(c)(4)) — case-asserted";
}
pub relation excluded_related_individual_45a(employee: Individual, employer: Person) kind empirical {
    label en official "the employee is an individual described in section 51(i)(1)(A), (B), or (C) (section 45A(c)(5)(A)) — case-asserted";
}
pub relation five_percent_owner_45a(employee: Individual, employer: Person) kind empirical {
    label en official "the employee is a 5-percent owner as defined in section 416(i)(1)(B) (section 45A(c)(5)(B)) — case-asserted";
}
pub relation gaming_services_45a(employee: Individual, employer: Person) kind empirical {
    label en official "the employee's services involve class I, II, or III gaming under the Indian Gaming Regulatory Act, or are performed in a building housing such gaming (section 45A(c)(5)(C)) — case-asserted";
}
pub relation qualified_wages_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified wages paid or incurred by the employer for services while the employee is a qualified employee, net of wages taken into account for the section 51 credit (section 45A(b)(1)) — case-asserted";
}
pub relation qualified_health_insurance_costs_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified employee health insurance costs (not paid under a salary reduction arrangement) for the employee (section 45A(b)(2)) — case-asserted";
}
pub relation base_period_amount_45a(employer: Person, employee: Individual, amount: Money) kind empirical {
    label en official "the qualified wages plus qualified employee health insurance costs, determined as if this section were in effect, paid or incurred by the employer (or a predecessor) for the employee during calendar year 1993 — case-asserted";
}

pub relation qualified_employee_45a(employee: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45A(c): a qualified employee of the employer for the taxable year";
}
@source(IRC_S45A_C, quote = "the employee is an enrolled member of an Indian tribe or the spouse of an enrolled member of an Indian tribe")
rule QualifiedEmployee45aRule(employee: Individual, employer: Person, y: TaxableYear, total: Money, ceiling: Money, share: Decimal) strict {
    when enrolled_member_or_spouse_of_indian_tribe_45a(employee);
    when services_substantially_all_within_reservation_45a(employee, employer, y);
    when abode_on_or_near_reservation_45a(employee, y);
    when total_wages_paid_to_employee_45a(employer, employee, y, total);
    when wage_ceiling_45a(y, ceiling);
    when total <= ceiling;
    when share_of_wages_for_trade_or_business_45a(employer, employee, y, share);
    when share > 50.0;
    when not_known(excluded_related_individual_45a(employee, employer));
    when not_known(five_percent_owner_45a(employee, employer));
    when not_known(gaming_services_45a(employee, employer));
    when not_known(remuneration_disqualified_45a_51k2(employee, employer, y));
    then qualified_employee_45a(employee, employer, y);
}

// --- (f): termination of the section -----------------------------------------------

pub relation section_45a_in_force_for_year(y: TaxableYear) kind institutional {
    label en official "section 45A(f): the section applies only to taxable years beginning on or before December 31, 2021";
}
@source(IRC_S45A_F, quote = "This section shall not apply to taxable years beginning after December 31, 2021.")
rule Section45aInForceRule(y: TaxableYear, begin: Date) strict {
    when us.irc.core::begins(y, begin);
    when begin <= @2021-12-31;
    then section_45a_in_force_for_year(y);
}

// --- (b)(3): per employee cap -----------------------------------------------------------

pub relation employee_current_amount_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45A(a)(1), (b)(3): qualified wages plus qualified employee health insurance costs for the employee, capped at $20,000";
}
@source(IRC_S45A_B, quote = "shall not exceed $20,000")
rule EmployeeCurrentAmount45aRule(employer: Person, employee: Individual, y: TaxableYear, wages: Money, health: Money) strict {
    when qualified_employee_45a(employee, employer, y);
    when qualified_wages_45a(employer, employee, y, wages);
    when qualified_health_insurance_costs_45a(employer, employee, y, health);
    then employee_current_amount_45a(employer, employee, y, min(wages + health, 20000.00 USD));
}
relation has_health_costs_45a(employer: Person, employee: Individual, y: TaxableYear) kind institutional;
rule HasHealthCosts45aRule(employer: Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    when qualified_health_insurance_costs_45a(employer, employee, y, amount);
    then has_health_costs_45a(employer, employee, y);
}
rule EmployeeCurrentAmountWagesOnly45aRule(employer: Person, employee: Individual, y: TaxableYear, wages: Money) strict {
    when qualified_employee_45a(employee, employer, y);
    when qualified_wages_45a(employer, employee, y, wages);
    when not_known(has_health_costs_45a(employer, employee, y));
    then employee_current_amount_45a(employer, employee, y, min(wages, 20000.00 USD));
}
pub relation employee_base_amount_45a(employer: Person, employee: Individual, amount: Money) kind institutional {
    label en official "section 45A(a)(2), (b)(3): the employee's 1993 base amount, capped at $20,000";
}
rule EmployeeBaseAmount45aRule(employer: Person, employee: Individual, base: Money) strict {
    when base_period_amount_45a(employer, employee, base);
    then employee_base_amount_45a(employer, employee, min(base, 20000.00 USD));
}

// --- (a), (e)(5): the credit --------------------------------------------------------------

pub relation taxable_year_days_45a(y: TaxableYear, days: Decimal) kind empirical {
    label en official "the number of days in the taxable year — case-asserted (for the section 45A(e)(5) short-year fraction)";
}
pub relation base_period_total_45a(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45A(a)(2), (e)(5): the sum of the employees' base amounts, multiplied by days/365 for a taxable year shorter than 12 months";
}
relation full_year_45a(y: TaxableYear) kind empirical;
@source(IRC_S45A_E, quote = "For any taxable year having less than 12 months, the amount determined under subsection (a)(2) shall be multiplied by a fraction, the numerator of which is the number of days in the taxable year and the denominator of which is 365.")
rule BaseTotalShortYear45aRule(employer: Person, y: TaxableYear, days: Decimal) strict {
    when base_period_amount_45a(employer, _, _);
    when us.irc.core::short_year(y);
    when taxable_year_days_45a(y, days);
    when section_45a_in_force_for_year(y);
    then base_period_total_45a(employer, y,
        round(div_round(days, 365.0, 10, "HALF_UP") * sum(collect all a: Money, e: Individual where employee_base_amount_45a(employer, e, a), empty: 0 USD), 2, "HALF_UP"));
}
relation short_or_fiscal_marker_45a(y: TaxableYear) kind institutional;
rule BaseTotalFullYear45aRule(employer: Person, y: TaxableYear) strict {
    when base_period_amount_45a(employer, _, _);
    when section_45a_in_force_for_year(y);
    when not_known(us.irc.core::short_year(y));
    then base_period_total_45a(employer, y,
        sum(collect all a: Money, e: Individual where employee_base_amount_45a(employer, e, a), empty: 0 USD));
}
pub relation indian_employment_credit_before_45p(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45A credit before the section 45P(c) reduction (final TECH_GAP pass, 26.09.2026)";
}
pub relation compensation_credit_reduction_of_qualified_employees_45a(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the section 45P credits of the qualified employees of the section 45A credit (section 45P(c)): the credit of section 45A is one aggregate over the employees, so the reduction of the employees counted in it is taken from that aggregate (JUDGMENT CALL)";
}
rule CompensationCreditReductionOfQualifiedEmployees45a(employer: Person, y: TaxableYear, base: Money) defeasible {
    label en official "the sum of the section 45P reductions of the qualified employees";
    when indian_employment_credit_before_45p(employer, y, base);
    then compensation_credit_reduction_of_qualified_employees_45a(employer, y,
        sum(collect all r: Money, e: Individual where qualified_employee_45a(e, employer, y) and compensation_credit_reduction_45p(employer, e, y, r), empty: 0.00 USD));
}
@source(IRC_S45P_C, quote = "The amount of credit otherwise allowable under this chapter with respect to compensation paid to any employee shall be reduced by the credit determined under this section with respect to such employee.")
rule IndianEmploymentCreditReducedBy45p(employer: Person, y: TaxableYear, before: Money, reduction: Money) defeasible {
    label en official "the section 45A credit less the section 45P credits of its qualified employees, not below zero (section 45P(c))";
    when indian_employment_credit_before_45p(employer, y, before);
    when compensation_credit_reduction_of_qualified_employees_45a(employer, y, reduction);
    then indian_employment_credit(employer, y, max(0 USD, before - reduction));
}
pub relation indian_employment_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45A Indian employment credit for the taxable year (a section 38(b)(10) component)";
}
@source(IRC_S45A_A, quote = "an amount equal to 20 percent of the excess (if any) of")
rule IndianEmploymentCredit45aRule(employer: Person, y: TaxableYear, base: Money) defeasible {
    when section_45a_in_force_for_year(y);
    when base_period_total_45a(employer, y, base);
    then indian_employment_credit_before_45p(employer, y, round(0.20 * max(0 USD,
        sum(collect all a: Money, e: Individual where employee_current_amount_45a(employer, e, y, a), empty: 0 USD) - base), 2, "HALF_UP"));
}

// --- (d): early termination of employment -------------------------------------------------

pub relation employment_began_on_45a(employee: Individual, employer: Person, on: Date) kind empirical {
    label en official "the day the employee began work for the employer — case-asserted";
}
pub relation employment_terminated_on_45a(employee: Individual, employer: Person, on: Date) kind empirical {
    label en official "the day the employer terminates the employment of the employee — case-asserted";
}
pub relation termination_exception_45a(employee: Individual, employer: Person) kind empirical {
    label en official "the termination is a voluntary departure, a disability not removed with no offer of reemployment, misconduct under State unemployment law, or a section 381 transaction or mere change of form with continued employment (section 45A(d)(3)) — case-asserted";
}
pub relation prior_credits_attributable_to_employee_45a(employer: Person, employee: Individual, amount: Money) kind empirical {
    label en official "the aggregate credits allowed under section 38(a) for prior taxable years by reason of wages and health insurance costs taken into account for the employee (section 45A(d)(1)(B)) — case-asserted";
}
pub relation terminated_before_one_year_45a(employee: Individual, employer: Person) kind institutional {
    label en official "section 45A(d)(1): the employer terminates the employment before the day one year after the day the employee began work, and no (d)(3) exception applies";
}
@source(IRC_S45A_D, quote = "If the employment of any employee is terminated by the taxpayer before the day 1 year after the day on which such employee began work for the employer")
rule TerminatedBeforeOneYear45aRule(employee: Individual, employer: Person, began: Date, ended: Date) defeasible {
    when employment_began_on_45a(employee, employer, began);
    when employment_terminated_on_45a(employee, employer, ended);
    when ended < add_calendar_period(began, 12 calendar_month);
    when not_known(termination_exception_45a(employee, employer));
    then terminated_before_one_year_45a(employee, employer);
}
pub relation indian_employment_recapture_tax_increase_45a(employer: Person, employee: Individual, amount: Money) kind institutional {
    label en official "section 45A(d)(1)(B): the increase in the tax for the year of termination equals the credits allowed in prior years by reason of the employee";
}
rule IndianEmploymentRecaptureTaxIncrease45aRule(employer: Person, employee: Individual, prior: Money) defeasible {
    when terminated_before_one_year_45a(employee, employer);
    when prior_credits_attributable_to_employee_45a(employer, employee, prior);
    then indian_employment_recapture_tax_increase_45a(employer, employee, prior);
}
