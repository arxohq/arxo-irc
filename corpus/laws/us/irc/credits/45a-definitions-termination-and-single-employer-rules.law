// Section 45A — the exclusion of wages counted for the work opportunity credit ((b)(1)(B)), the health insurance salary reduction exclusion
// ((b)(2)(B)), the Indian tribe definition ((c)(6)), the termination rules of (d)(1)(A), (d)(2) and (d)(4), and the single employer rules of (e)(2).
// Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of
// `45a-indian-employment-credit.law`; its credit rules read the qualified wages and health insurance costs as case facts and are NOT rewired to
// require these relations. The annual adjustment of the $30,000 amount of (c)(3) is an external directive of the Secretary.
//
// Judgment calls: the service period exclusion of (b)(1)(B) is a date comparison (1 year, or 2 years where wages are taken into account under
// section 51(e)(1)(A)); the wages attributable to service in that period are an asserted amount; the proportionate share of (e)(2)(B) follows the
// asserted share of each employer of the wages (cents HALF_UP).

// --- (b)(1)(B): wages counted for the work opportunity credit ----------------------------------------------------------------------------------------

use self::{
    IRC_S45A_B,
    IRC_S45A_C,
    IRC_S45A_D,
    IRC_S45A_E,
    Individual,
    Person,
    TaxableYear,
    employment_began_on_45a,
    employment_terminated_on_45a,
};

pub relation wages_paid_for_service_on_45a(employer: Person, employee: Individual, service_date: Date, amount: Money) kind empirical {
    label en official "wages paid for service rendered on the date — case-asserted";
}
pub relation wages_taken_into_account_under_section_51_45a(employer: Person, employee: Individual) kind empirical {
    label en official "any portion of the wages is taken into account in determining the credit under section 51 (section 45A(b)(1)(B)) — case-asserted";
}
pub relation wages_taken_into_account_under_51e1a_45a(employer: Person, employee: Individual) kind empirical {
    label en official "any portion of the wages is taken into account under subsection (e)(1)(A) of section 51 (section 45A(b)(1)(B), second sentence) — case-asserted";
}
pub relation exclusion_period_end_45a(employee: Individual, employer: Person, on: Date) kind institutional {
    label en official "section 45A(b)(1)(B): the end of the period beginning with the day the individual begins work for which wages taken into account for the work opportunity credit are not qualified wages: 1 year, or 2 years where wages are taken into account under section 51(e)(1)(A)";
}
@source(IRC_S45A_B, relation = formalizes, coverage = exact, quote = "the preceding sentence shall be applied by substituting \"2-year period\" for \"1-year period\"")
rule ExclusionPeriodEndTwoYearsRule(employee: Individual, employer: Person, began: Date) strict {
    when employment_began_on_45a(employee, employer, began);
    when wages_taken_into_account_under_51e1a_45a(employer, employee);
    then exclusion_period_end_45a(employee, employer, add_calendar_period(began, 24 calendar_month));
}
rule ExclusionPeriodEndOneYearRule(employee: Individual, employer: Person, began: Date) strict {
    when employment_began_on_45a(employee, employer, began);
    when wages_taken_into_account_under_section_51_45a(employer, employee);
    when not_known(wages_taken_into_account_under_51e1a_45a(employer, employee));
    then exclusion_period_end_45a(employee, employer, add_calendar_period(began, 12 calendar_month));
}
pub relation wages_excluded_from_qualified_wages_45a(employer: Person, employee: Individual, service_date: Date, amount: Money) kind institutional {
    label en official "section 45A(b)(1)(B): wages attributable to service during the 1-year (2-year) period beginning with the day the individual begins work are not qualified wages if any portion is taken into account for the section 51 credit";
}
rule WagesExcludedFromQualifiedWagesRule(employer: Person, employee: Individual, service_date: Date, amount: Money, began: Date, period_end: Date) strict {
    when wages_paid_for_service_on_45a(employer, employee, service_date, amount);
    when employment_began_on_45a(employee, employer, began);
    when exclusion_period_end_45a(employee, employer, period_end);
    when service_date >= began;
    when service_date < period_end;
    then wages_excluded_from_qualified_wages_45a(employer, employee, service_date, amount);
}

// --- (b)(2)(B): salary reduction arrangements ---------------------------------------------------------------------------------------------------------------

pub relation health_insurance_paid_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount paid or incurred for health insurance for the employee — case-asserted";
}
pub relation health_insurance_under_salary_reduction_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the health insurance paid or incurred pursuant to a salary reduction arrangement (section 45A(b)(2)(B)) — case-asserted";
}
pub relation health_insurance_taken_into_account_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45A(b)(2)(B): no amount paid or incurred for health insurance pursuant to a salary reduction arrangement is taken into account (not below zero)";
}
@source(IRC_S45A_B, relation = formalizes, coverage = exact, quote = "No amount paid or incurred for health insurance pursuant to a salary reduction arrangement shall be taken into account under subparagraph (A).")
rule HealthInsuranceTakenIntoAccountRule(employer: Person, employee: Individual, y: TaxableYear, paid: Money, reduced: Money) strict {
    when health_insurance_paid_45a(employer, employee, y, paid);
    when health_insurance_under_salary_reduction_45a(employer, employee, y, reduced);
    then health_insurance_taken_into_account_45a(employer, employee, y, max(paid - reduced, 0 USD));
}
rule HealthInsuranceTakenIntoAccountNoReductionRule(employer: Person, employee: Individual, y: TaxableYear, paid: Money) strict {
    when health_insurance_paid_45a(employer, employee, y, paid);
    when not_known(salary_reduction_asserted_45a(employer, employee, y));
    then health_insurance_taken_into_account_45a(employer, employee, y, paid);
}
relation salary_reduction_asserted_45a(employer: Person, employee: Individual, y: TaxableYear) kind institutional;
rule SalaryReductionAssertedRule(employer: Person, employee: Individual, y: TaxableYear, reduced: Money) strict {
    when health_insurance_under_salary_reduction_45a(employer, employee, y, reduced);
    then salary_reduction_asserted_45a(employer, employee, y);
}

// --- (c)(6): Indian tribe ----------------------------------------------------------------------------------------------------------------------------------------

pub relation group_is_tribe_band_nation_pueblo_or_native_village_or_corporation_45a(group: Person) kind empirical {
    label en official "the group is an Indian tribe, band, nation, pueblo, or other organized group or community, including any Alaska Native village, or regional or village corporation, as defined in, or established pursuant to, the Alaska Native Claims Settlement Act (section 45A(c)(6)) — case-asserted";
}
pub relation recognized_as_eligible_for_special_programs_for_indians_45a(group: Person) kind empirical {
    label en official "the group is recognized as eligible for the special programs and services provided by the United States to Indians because of their status as Indians (section 45A(c)(6)) — case-asserted";
}
pub relation indian_tribe_45a(group: Person) kind institutional {
    label en official "section 45A(c)(6): an Indian tribe, band, nation, pueblo or other organized group or community, including Alaska Native villages and corporations, recognized as eligible for the special programs and services provided by the United States to Indians";
}
@source(IRC_S45A_C, relation = formalizes, coverage = exact, quote = "which is recognized as eligible for the special programs and services provided by the United States to Indians because of their status as Indians")
rule IndianTribe45aRule(group: Person) strict {
    when group_is_tribe_band_nation_pueblo_or_native_village_or_corporation_45a(group);
    when recognized_as_eligible_for_special_programs_for_indians_45a(group);
    then indian_tribe_45a(group);
}

// --- (d)(1)(A), (d)(4): termination of employment ----------------------------------------------------------------------------------------------------------

pub relation wages_for_year_of_termination_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the wages (or qualified employee health insurance costs) of the employee for the taxable year in which the employment is terminated — case-asserted";
}
pub relation terminated_before_one_year_of_work_45a(employee: Individual, employer: Person) kind institutional {
    label en official "section 45A(d)(1): the employment is terminated before the day 1 year after the day the employee began work";
}
rule TerminatedBeforeOneYearOfWorkRule(employee: Individual, employer: Person, began: Date, ended: Date) strict {
    when employment_began_on_45a(employee, employer, began);
    when employment_terminated_on_45a(employee, employer, ended);
    when ended < add_calendar_period(began, 12 calendar_month);
    then terminated_before_one_year_of_work_45a(employee, employer);
}
pub relation wages_taken_into_account_for_termination_year_45a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45A(d)(1)(A): no wages (or qualified employee health insurance costs) of an employee terminated before 1 year of work are taken into account for the taxable year in which the employment is terminated (the amount is zero)";
}
@source(IRC_S45A_D, relation = formalizes, coverage = exact, quote = "no wages (or qualified employee health insurance costs) with respect to such employee shall be taken into account under subsection (a) for the taxable year in which such employment is terminated")
rule WagesTakenIntoAccountForTerminationYearRule(employer: Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    when terminated_before_one_year_of_work_45a(employee, employer);
    when wages_for_year_of_termination_45a(employer, employee, y, amount);
    then wages_taken_into_account_for_termination_year_45a(employer, employee, y, 0 USD);
}
pub relation section_39_carryover_adjusted_for_termination_45a(employer: Person, employee: Individual) kind institutional {
    label en official "section 45A(d)(2): for a termination of employment to which paragraph (1) applies, the carrybacks and carryovers under section 39 are properly adjusted";
}
@source(IRC_S45A_D, relation = formalizes, coverage = partial, quote = "the carrybacks and carryovers under section 39 shall be properly adjusted")
rule Section39CarryoverAdjustedForTerminationRule(employer: Person, employee: Individual) strict {
    when terminated_before_one_year_of_work_45a(employee, employer);
    then section_39_carryover_adjusted_for_termination_45a(employer, employee);
}
pub relation termination_increase_in_tax_45a(employer: Person, employee: Individual, amount: Money) kind empirical {
    label en official "the increase in tax under paragraph (1)(B) for the taxable year of termination — case-asserted";
}
pub relation termination_increase_excluded_from_tax_for_credits_and_minimum_tax_45a(employer: Person, employee: Individual) kind institutional {
    label en official "section 45A(d)(4): an increase in tax under paragraph (1) is not treated as tax imposed by the chapter for determining any credit or the tax imposed by section 55";
}
@source(IRC_S45A_D, relation = formalizes, coverage = exact, quote = "Any increase in tax under paragraph (1) shall not be treated as a tax imposed by this chapter for purposes of")
rule TerminationIncreaseExcludedRule(employer: Person, employee: Individual, amount: Money) strict {
    when termination_increase_in_tax_45a(employer, employee, amount);
    then termination_increase_excluded_from_tax_for_credits_and_minimum_tax_45a(employer, employee);
}

// --- (e)(2): single employer and proportionate shares ---------------------------------------------------------------------------------------------------

pub relation controlled_group_52_45a(group: Person, employer: Person) kind empirical {
    label en official "the employer is a member of a group treated as a single employer under subsection (a) or (b) of section 52 — case-asserted";
}
pub relation treated_as_single_employer_45a(a: Person, b: Person) kind institutional {
    label en official "section 45A(e)(2)(A): all employers treated as a single employer under section 52(a) or (b) are a single employer for this section";
}
@source(IRC_S45A_E, relation = formalizes, coverage = exact, quote = "All employers treated as a single employer under section (a) or (b) of section 52 shall be treated as a single employer for purposes of this section.")
rule TreatedAsSingleEmployer45aRule(a: Person, b: Person, group: Person) strict {
    when controlled_group_52_45a(group, a);
    when controlled_group_52_45a(group, b);
    then treated_as_single_employer_45a(a, b);
}
pub relation group_credit_45a(group: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit determined under section 45A for the single employer group — case-asserted";
}
pub relation employer_share_of_wages_45a(group: Person, employer: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the employer's share, as a fraction, of the wages and qualified employee health insurance costs giving rise to the group credit — case-asserted";
}
pub relation employer_proportionate_share_of_credit_45a(group: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45A(e)(2)(B): the credit determined with respect to each employer is its proportionate share of the wages and qualified employee health insurance costs giving rise to the credit (cents HALF_UP)";
}
@source(IRC_S45A_E, relation = formalizes, coverage = exact, quote = "The credit (if any) determined under this section with respect to each such employer shall be its proportionate share of the wages and qualified employee health insurance costs giving rise to such credit.")
rule EmployerProportionateShareOfCreditRule(group: Person, employer: Person, y: TaxableYear, credit: Money, share: Decimal) strict {
    when group_credit_45a(group, y, credit);
    when employer_share_of_wages_45a(group, employer, y, share);
    then employer_proportionate_share_of_credit_45a(group, employer, y, round(credit / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}
