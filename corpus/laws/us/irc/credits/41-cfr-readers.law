// Section 41 regulation readers (IRC-G/G4, CFR wiring 27.09.2026).
//
// 26 CFR 1.41-0..-9 is pinned phase-0 (us.cfr.t26_1_41) + 1.41-0A transitional
// TOC (us.cfr.t26_1_41_0a) — addressable, rule-less, not yet dependencies
// (registry/lock gap, g4unicap-skel STATUS). The case-selected relations below
// name the regulation content as applied; each rule derives the subsection
// consequence in parallel with the existing aggregate path in
// `41-research-credit.law`, which is untouched (QRE/basic-research/consortium
// totals stay case-asserted; TECH_GAPs noted there are not closed here).
// Covered rows stay EXTERNAL_DEPENDENCY (flip only after execution, step 6).
//
// Structural only: the 65/75-percent contract rates and other numbers stay in
// the statute text — no rates are recomputed here (SFA_STOP_NUMBER).
// The (d)(1) four-part "qualified research" test is EVALUATIVE (DECISION-0194):
// it enters only through a judgment/adjudicated channel and NEVER into the QRE
// aggregate — no rule below reads (d) rows. 1.41-5 (basic research post-1986)
// is [Reserved] on the slice — pinned as is; the (e) readers below are
// statute-based case-selected content.

// --- (b)(1): QRE gateway — in-house + contract components ---------------------

use self::{
    IRC_S41_B,
    IRC_S41_E,
    IRC_S41_F,
    Person,
    TaxableYear,
};

relation rd_qre_sum_components_as_applied_41b1(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the section 41(b)(1) QRE sum components, as applied for the year (in-house research expenses plus contract research expenses per 1.41-2 — case-selected: the regulation content enters as case facts)";
}
pub relation rd_qre_sum_recognized_41b1(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 41(b)(1): the applied in-house plus contract components are recognized as qualified research expenses";
}
@source(IRC_S41_B, relation = formalizes, coverage = partial, quote = "The term \"qualified research expenses\" means the sum of the following amounts")
rule S41b1QreComponentsViaReg1_41 strict {
    label en official "section 41(b)(1): the applied in-house and contract components sum to qualified research expenses";
    for taxpayer: Person;
    for y: TaxableYear;
    when rd_qre_sum_components_as_applied_41b1(taxpayer, y);
    then rd_qre_sum_recognized_41b1(taxpayer, y);
}

// --- (b)(2)(A)-(B): qualified services (1.41-2(c)) ------------------------------

relation rd_services_as_applied_41b2B(taxpayer: Person, y: TaxableYear, worker: Person) kind empirical {
    label en official "the worker's services, as applied for the year, are engaging in qualified research, direct (first-line) supervision, or direct support per 1.41-2(c) (case-selected)";
}
pub relation rd_services_are_qualified_services_41b2B(taxpayer: Person, y: TaxableYear, worker: Person) kind institutional {
    label en official "section 41(b)(2)(B): the worker's applied services are qualified services, so wages for them are in-house research expenses";
}
@source(IRC_S41_B, relation = formalizes, coverage = partial, quote = "The term \"qualified services\" means services consisting of")
rule S41b2QualifiedServicesViaReg1_41 strict {
    label en official "section 41(b)(2)(B): the applied engaging/supervision/support services are qualified services";
    for taxpayer: Person;
    for y: TaxableYear;
    for worker: Person;
    when rd_services_as_applied_41b2B(taxpayer, y, worker);
    then rd_services_are_qualified_services_41b2B(taxpayer, y, worker);
}

// --- (b)(2)(A),(C)-(D): supplies / wages / computer use (1.41-2(b),(d)) ---------

relation rd_supply_or_wage_use_as_applied_41b2(taxpayer: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the supply/wage/computer-use expenditure, as applied for the year, meets the (b)(2) definitions (supplies used in qualified services, wages for qualified services, computer right-to-use per 1.41-2(b),(d) — case-selected)";
}
pub relation rd_supply_wage_counts_as_inhouse_41b2(taxpayer: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 41(b)(2): the applied supply/wage/computer-use expenditure counts as an in-house research expense";
}
@source(IRC_S41_B, relation = formalizes, coverage = partial, quote = "The term \"qualified services\" means services consisting of")
rule S41b2SuppliesWagesViaReg1_41 strict {
    label en official "section 41(b)(2): the applied supply/wage/computer-use expenditure is an in-house research expense";
    for taxpayer: Person;
    for y: TaxableYear;
    for item: Integer;
    when rd_supply_or_wage_use_as_applied_41b2(taxpayer, y, item);
    then rd_supply_wage_counts_as_inhouse_41b2(taxpayer, y, item);
}

// --- (b)(3)-(4): contract research + trade-or-business (1.41-2(a),(e)) ----------

relation rd_contract_terms_as_applied_41b3(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the contract terms, as applied for the year, are payment to a non-employee for qualified research (or services that would be qualified services), paid in carrying on the taxpayer's trade or business per 1.41-2(a),(e) — new-business development excluded (case-selected)";
}
pub relation rd_contract_research_counts_41b3(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 41(b)(3)-(4): the applied contract payment counts as a contract research expense (statutory 65/75-percent inclusion stays in the statute text, not recomputed here)";
}
@source(IRC_S41_B, relation = formalizes, coverage = partial, quote = "The term \"contract research expenses\" means 65 percent of any amount paid or incurred")
rule S41b3ContractResearchViaReg1_41 strict {
    label en official "section 41(b)(3)-(4): the applied qualifying contract payment is a contract research expense";
    for taxpayer: Person;
    for y: TaxableYear;
    when rd_contract_terms_as_applied_41b3(taxpayer, y);
    then rd_contract_research_counts_41b3(taxpayer, y);
}

// --- (e) payments: basic research payments to qualified organizations ----------

relation rd_basic_research_payment_as_applied_41e(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the basic research payment, as applied for the year, is paid to a qualified organization for basic research under (e)(1)-(2),(4)-(5) (case-selected; 1.41-5 is [Reserved], so the content is statute-based)";
}
pub relation rd_basic_research_payment_counts_41e(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 41(e): the applied payment counts as a basic research payment (feeds the case-asserted basic_research_payments_41e1a aggregate path, which is untouched)";
}
@source(IRC_S41_E, relation = formalizes, coverage = partial, quote = "In the case of any taxpayer who makes basic research payments for any taxable year")
rule S41eBasicResearchPaymentsViaReg1_41 strict {
    label en official "section 41(e): the applied payment to a qualified organization is a basic research payment";
    for taxpayer: Person;
    for y: TaxableYear;
    when rd_basic_research_payment_as_applied_41e(taxpayer, y);
    then rd_basic_research_payment_counts_41e(taxpayer, y);
}

// --- (e) regime: qualified organizations, basic research def, base period -----

relation rd_qualified_org_and_def_as_applied_41e(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the (e) regime elements, as applied for the year — qualified organization status, the basic research definition (original investigation without specific commercial objective), and the base-period machinery (case-selected)";
}
pub relation rd_basic_research_regime_satisfied_41e(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 41(e): the applied qualified-organization/definition/base-period elements of the basic research regime are satisfied";
}
@source(IRC_S41_E, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, the term \"qualified organization\" means any of the following organizations")
rule S41eQualifiedOrgAndBasePeriodViaReg1_41 strict {
    label en official "section 41(e): the applied organization/definition/base-period elements hold";
    for taxpayer: Person;
    for y: TaxableYear;
    when rd_qualified_org_and_def_as_applied_41e(taxpayer, y);
    then rd_basic_research_regime_satisfied_41e(taxpayer, y);
}

// --- (f): aggregation of expenditures (1.41-6) ----------------------------------

relation rd_controlled_group_aggregation_as_applied_1_41_6(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the (f) controlled-group aggregation, as applied for the year (single-taxpayer treatment, acquisition/disposition allocation, short-year rules per 1.41-6 — case-selected; section 41-specific, parallel to the section 52 machinery)";
}
pub relation rd_expenditures_aggregated_41f(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 41(f): the taxpayer's expenditures are aggregated for the year under the applied aggregation";
}
@source(IRC_S41_F, relation = formalizes, coverage = partial, quote = "all members of the same controlled group of corporations shall be treated as a single taxpayer, and")
rule S41fAggregationViaReg1_41 strict {
    label en official "section 41(f): the applied controlled-group aggregation holds for the year";
    for taxpayer: Person;
    for y: TaxableYear;
    when rd_controlled_group_aggregation_as_applied_1_41_6(taxpayer, y);
    then rd_expenditures_aggregated_41f(taxpayer, y);
}

// --- (f)(6): energy research consortium ------------------------------------------

relation rd_consortium_payment_as_applied_41f6(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the energy research consortium payment, as applied for the year, is paid to an organization meeting the (f)(6)(A) consortium definition for energy research (case-selected)";
}
pub relation rd_consortium_payment_counts_41f6(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 41(f)(6): the applied payment counts as an energy research consortium payment (feeds the case-asserted energy_research_consortium_payments path, which is untouched)";
}
@source(IRC_S41_F, relation = formalizes, coverage = partial, quote = "The term \"energy research consortium\" means any organization")
rule S41f6EnergyConsortiumViaReg1_41 strict {
    label en official "section 41(f)(6): the applied payment to a qualifying consortium counts";
    for taxpayer: Person;
    for y: TaxableYear;
    when rd_consortium_payment_as_applied_41f6(taxpayer, y);
    then rd_consortium_payment_counts_41f6(taxpayer, y);
}
