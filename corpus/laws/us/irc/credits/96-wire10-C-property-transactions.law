// Credits -- WIRE-10 group C, owner `property_transactions` (26.09.2026, DECISION-0379, implemented_unverified; scenarios written,
// NOT executed; no legal review).
//
// Section 38(b)(9): the empowerment zone employment credit determined under section 1396(a) is component 9 of the general business
// credit. The owner computes the credit per employee (`empowerment_zone_employment_credit(employee, employer, y, amount)`, module 27);
// the component amount of the employer (taxpayer) is the sum over the employees. The rule is defeasible like the other component
// rules (LDC-E4103); the case-asserted channel of `general_business_credit_component_amount` stays valid.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

import us.irc.property_transactions version "0.1.1";

use self::{
    GeneralBusinessCreditComponent,
    Person,
    TaxableYear,
    general_business_credit_component_amount,
};

rule W10CEmpowermentZoneEmploymentCreditComponent defeasible {
    label en official "section 38(b)(9): the empowerment zone employment credit of section 1396(a) is a component of the general business credit; the amount is the sum of the per-employee credits of the employer for the taxable year";
    for taxpayer: Person;
    for y: TaxableYear;
    for e0: Person;
    for a0: Money;
    when us.irc.property_transactions::empowerment_zone_employment_credit(e0, taxpayer, y, a0);
    then general_business_credit_component_amount(taxpayer, y, EmpowermentZoneEmploymentCredit1396,
        sum(collect all a: Money, e: Person where us.irc.property_transactions::empowerment_zone_employment_credit(e, taxpayer, y, a), empty: 0 USD));
}
