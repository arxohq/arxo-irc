// Stage 4 (DECISION-0379 with deontics), credits, part M: the rules similar to section 30D(f) (without
// paragraphs (10), (11)) that sections 45W(d)(1) and 25E(e) apply, and the comparable vehicle price of
// 45W(b)(3). Part of G6416 (the 25E(f) rules similar to 30D(g) are NOT written: TECH_GAP).
//
// Written for each credit with the same shape: (1) the basis reduced by the credit; (2) no double benefit
// (the deduction or other credit for the vehicle reduced by the credit); (4) no credit for property used
// outside the United States (section 50(b)(1)); (5) the Secretary's duty to provide for recapture by
// regulations (a duty, achievement goal, no time limit in the text); (6) the election not to take the
// credit; (7) compliance with the Clean Air Act and the motor vehicle safety provisions; (8) one credit per
// vehicle by vehicle identification number; (9) the VIN on the return is a rule of the credit modules
// already. (4), (6), (7), (8) are DENIALS read by the credit rule of the section as one relation
// `credit_denied_by_30df_rules_*`; (7) and (8) are written as flags asserted only in the exceptional case
// (JUDGMENT CALL: without them the earlier scenarios, which assert neither compliance nor a second
// claim, keep computing).


// ===================== 45W(d)(1) =====================

use self::{
    Asset,
    IRC_S25E_E,
    IRC_S45W_B,
    IRC_S45W_D,
    Individual,
    Person,
    TaxableYear,
    acquisition_date_25e,
    commercial_clean_vehicle_credit_amount_45w,
    comparable_vehicle_45w,
    comparable_vehicle_price_45w,
    previously_owned_clean_vehicle_credit,
    vehicle_basis_45w,
    vehicle_purchase_price_45w,
};

pub relation vehicle_basis_reduction_by_credit_45w(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "the basis of the vehicle is reduced by the amount of the credit allowed (rule similar to section 30D(f)(1))";
}
@source(IRC_S45W_D, quote = "Rules similar to the rules under subsection (f) of section 30D (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule VehicleBasisReducedByCredit45W(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "basis - credit (45W(d)(1), by section 30D(f)(1))";
    when commercial_clean_vehicle_credit_amount_45w(taxpayer, vehicle, y, amount);
    then vehicle_basis_reduction_by_credit_45w(taxpayer, vehicle, amount);
}
pub relation other_benefit_for_vehicle_reduced_by_credit_45w(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "the deduction or other credit allowable for the vehicle is reduced by the credit allowed (rule similar to section 30D(f)(2))";
}
@source(IRC_S45W_D, quote = "Rules similar to the rules under subsection (f) of section 30D (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule NoDoubleBenefitForVehicle45W(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "no double benefit (45W(d)(1), by section 30D(f)(2))";
    when commercial_clean_vehicle_credit_amount_45w(taxpayer, vehicle, y, amount);
    then other_benefit_for_vehicle_reduced_by_credit_45w(taxpayer, vehicle, amount);
}
pub relation vehicle_property_described_in_50b1_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is property referred to in section 50(b)(1) (property used outside the United States) (rule similar to section 30D(f)(4))";
}
pub relation elects_out_of_45w_for_vehicle(taxpayer: Person, vehicle: Asset) kind empirical {
    label en official "the taxpayer elects to not have the section apply to the vehicle (rule similar to section 30D(f)(6))";
}
pub relation vehicle_not_in_compliance_with_clean_air_or_safety_provisions_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is not in compliance with the Clean Air Act provisions (or the air quality provisions of State law) or the motor vehicle safety provisions of sections 30101 through 30169 of title 49 (rule similar to section 30D(f)(7)); asserted only in the exceptional case";
}
pub relation credit_previously_allowed_for_vehicle_by_vin_45w(vehicle: Asset) kind empirical {
    label en official "the credit has already been allowed with respect to the vehicle, as determined by its vehicle identification number (rule similar to section 30D(f)(8)); asserted only in the exceptional case";
}
pub relation credit_denied_by_30df_rules_45w(taxpayer: Person, vehicle: Asset) kind institutional {
    label en official "no credit: property used outside the United States, an election not to take the credit, non-compliance with the air quality and safety provisions, or a second credit for the same vehicle (rules similar to section 30D(f)(4), (6), (7), (8))";
}
@source(IRC_S45W_D, quote = "Rules similar to the rules under subsection (f) of section 30D (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule DeniedUsedOutsideUnitedStates45W(taxpayer: Person, vehicle: Asset) defeasible {
    label en official "property used outside the United States is not eligible (45W(d)(1), by section 30D(f)(4))";
    when vehicle_property_described_in_50b1_45w(vehicle);
    when vehicle_basis_45w(taxpayer, vehicle, _, _);
    then credit_denied_by_30df_rules_45w(taxpayer, vehicle);
}
rule DeniedByElection45W(taxpayer: Person, vehicle: Asset) defeasible {
    label en official "the taxpayer elected not to take the credit (45W(d)(1), by section 30D(f)(6))";
    when elects_out_of_45w_for_vehicle(taxpayer, vehicle);
    then credit_denied_by_30df_rules_45w(taxpayer, vehicle);
}
rule DeniedNotInCompliance45W(taxpayer: Person, vehicle: Asset) defeasible {
    label en official "a vehicle not in compliance is not eligible (45W(d)(1), by section 30D(f)(7))";
    when vehicle_not_in_compliance_with_clean_air_or_safety_provisions_45w(vehicle);
    when vehicle_basis_45w(taxpayer, vehicle, _, _);
    then credit_denied_by_30df_rules_45w(taxpayer, vehicle);
}
rule DeniedSecondCreditForVin45W(taxpayer: Person, vehicle: Asset) defeasible {
    label en official "the credit is allowed only once for a vehicle by its vehicle identification number (45W(d)(1), by section 30D(f)(8))";
    when credit_previously_allowed_for_vehicle_by_vin_45w(vehicle);
    when vehicle_basis_45w(taxpayer, vehicle, _, _);
    then credit_denied_by_30df_rules_45w(taxpayer, vehicle);
}
pub relation recapture_regulations_provided_45w(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary has provided by regulations for recapturing the benefit of the credit for property that ceases to be eligible (rule similar to section 30D(f)(5))";
}
@source(IRC_S45W_D, quote = "Rules similar to the rules under subsection (f) of section 30D (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule Section30DF5RecaptureDutyRule45W(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the Secretary shall provide by regulations for recapture (45W(d)(1), by section 30D(f)(5)); the duty arises when a credit is determined; no time limit in the text";
    when commercial_clean_vehicle_credit_amount_45w(taxpayer, vehicle, y, amount);
    then duty Section30DF5RecaptureRegulationsDuty45W {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition recapture_regulations_provided_45w(us.irc.core::Secretary);
            window [-infinity, infinity];
        }
    };
}

// ===================== 25E(e) =====================

pub relation vehicle_basis_reduction_by_credit_25e(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional {
    label en official "the basis of the vehicle is reduced by the amount of the credit allowed (rule similar to section 30D(f)(1))";
}
@source(IRC_S25E_E, quote = "For purposes of this section, rules similar to the rules of section 30D(f) (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule VehicleBasisReducedByCredit25E(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "basis - credit (25E(e), by section 30D(f)(1))";
    when previously_owned_clean_vehicle_credit(taxpayer, vehicle, y, amount);
    then vehicle_basis_reduction_by_credit_25e(taxpayer, vehicle, amount);
}
pub relation other_benefit_for_vehicle_reduced_by_credit_25e(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional {
    label en official "the deduction or other credit allowable for the vehicle is reduced by the credit allowed (rule similar to section 30D(f)(2))";
}
@source(IRC_S25E_E, quote = "For purposes of this section, rules similar to the rules of section 30D(f) (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule NoDoubleBenefitForVehicle25E(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "no double benefit (25E(e), by section 30D(f)(2))";
    when previously_owned_clean_vehicle_credit(taxpayer, vehicle, y, amount);
    then other_benefit_for_vehicle_reduced_by_credit_25e(taxpayer, vehicle, amount);
}
pub relation vehicle_property_described_in_50b1_25e(vehicle: Asset) kind empirical {
    label en official "the vehicle is property referred to in section 50(b)(1) (property used outside the United States) (rule similar to section 30D(f)(4))";
}
pub relation elects_out_of_25e_for_vehicle(taxpayer: Individual, vehicle: Asset) kind empirical {
    label en official "the taxpayer elects to not have the section apply to the vehicle (rule similar to section 30D(f)(6))";
}
pub relation vehicle_not_in_compliance_with_clean_air_or_safety_provisions_25e(vehicle: Asset) kind empirical {
    label en official "the vehicle is not in compliance with the Clean Air Act provisions (or the air quality provisions of State law) or the motor vehicle safety provisions of sections 30101 through 30169 of title 49 (rule similar to section 30D(f)(7)); asserted only in the exceptional case";
}
pub relation credit_previously_allowed_for_vehicle_by_vin_25e(vehicle: Asset) kind empirical {
    label en official "the credit has already been allowed with respect to the vehicle, as determined by its vehicle identification number (rule similar to section 30D(f)(8)); asserted only in the exceptional case";
}
pub relation credit_denied_by_30df_rules_25e(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "no credit: property used outside the United States, an election not to take the credit, non-compliance with the air quality and safety provisions, or a second credit for the same vehicle (rules similar to section 30D(f)(4), (6), (7), (8))";
}
@source(IRC_S25E_E, quote = "For purposes of this section, rules similar to the rules of section 30D(f) (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule DeniedUsedOutsideUnitedStates25E(taxpayer: Individual, vehicle: Asset) defeasible {
    label en official "property used outside the United States is not eligible (25E(e), by section 30D(f)(4))";
    when vehicle_property_described_in_50b1_25e(vehicle);
    when acquisition_date_25e(taxpayer, vehicle, _);
    then credit_denied_by_30df_rules_25e(taxpayer, vehicle);
}
rule DeniedByElection25E(taxpayer: Individual, vehicle: Asset) defeasible {
    label en official "the taxpayer elected not to take the credit (25E(e), by section 30D(f)(6))";
    when elects_out_of_25e_for_vehicle(taxpayer, vehicle);
    then credit_denied_by_30df_rules_25e(taxpayer, vehicle);
}
rule DeniedNotInCompliance25E(taxpayer: Individual, vehicle: Asset) defeasible {
    label en official "a vehicle not in compliance is not eligible (25E(e), by section 30D(f)(7))";
    when vehicle_not_in_compliance_with_clean_air_or_safety_provisions_25e(vehicle);
    when acquisition_date_25e(taxpayer, vehicle, _);
    then credit_denied_by_30df_rules_25e(taxpayer, vehicle);
}
rule DeniedSecondCreditForVin25E(taxpayer: Individual, vehicle: Asset) defeasible {
    label en official "the credit is allowed only once for a vehicle by its vehicle identification number (25E(e), by section 30D(f)(8))";
    when credit_previously_allowed_for_vehicle_by_vin_25e(vehicle);
    when acquisition_date_25e(taxpayer, vehicle, _);
    then credit_denied_by_30df_rules_25e(taxpayer, vehicle);
}
pub relation recapture_regulations_provided_25e(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary has provided by regulations for recapturing the benefit of the credit for property that ceases to be eligible (rule similar to section 30D(f)(5))";
}
@source(IRC_S25E_E, quote = "For purposes of this section, rules similar to the rules of section 30D(f) (without regard to paragraph (10) or (11) thereof) shall apply for purposes of this section.")
rule Section30DF5RecaptureDutyRule25E(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the Secretary shall provide by regulations for recapture (25E(e), by section 30D(f)(5)); the duty arises when a credit is determined; no time limit in the text";
    when previously_owned_clean_vehicle_credit(taxpayer, vehicle, y, amount);
    then duty Section30DF5RecaptureRegulationsDuty25E {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition recapture_regulations_provided_25e(us.irc.core::Secretary);
            window [-infinity, infinity];
        }
    };
}

// ===================== 45W(b)(3): the price of the comparable vehicle =====================

@source(IRC_S45W_B, quote = "For purposes of this subsection, the term \"comparable vehicle\" means, with respect to any qualified commercial clean vehicle, any vehicle which is powered solely by a gasoline or diesel internal combustion engine and which is comparable in size and use to such vehicle.")
rule ComparableVehiclePriceFromComparableVehicle45w(vehicle: Asset, comparable: Asset, price: Money) defeasible {
    label en official "the price of the comparable vehicle is the price the incremental cost is measured against (section 45W(b)(2), (3)); alternative channel to the asserted comparable price";
    when comparable_vehicle_45w(comparable, vehicle);
    when vehicle_purchase_price_45w(comparable, price);
    then comparable_vehicle_price_45w(vehicle, price);
}
