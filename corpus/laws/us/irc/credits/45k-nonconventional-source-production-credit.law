// Section 45K — Credit for producing fuel from a nonconventional source.
// Stage 2d (IRC-06, DECISION-0379). An expired credit (sales before 2003, or
// before 2008 for biomass gas and coal-derived synthetic fuels of the (f)
// facilities); modelled for the record.
//
// Scope / judgment calls:
// * (a): $3 (indexed by the GNP inflation adjustment factor, except for gas
//   from a tight formation) times the barrel-of-oil equivalent of qualified
//   fuels sold to an unrelated person and attributable to the taxpayer.
// * (b)(1): a reduction by the ratio of the excess of the reference price over
//   $23.50 (indexed) to $6 (indexed); (b)(3): the proportion of grants, tax-
//   exempt bond proceeds and subsidized energy financing to capital additions;
//   (b)(4): the excess of energy-percentage credits over recapture; (b)(5):
//   the excess of enhanced oil recovery credits. The cumulative amounts are
//   case facts.
// * (e), (f)(1): eligible sales: a well drilled after 1979 and before 1993 or
//   a facility placed in service in that period, sold before 2003; biomass gas
//   and coal synthetic fuel facilities placed in service before 1998-07-01
//   under a binding written contract before 1997 (originally placed after 1992)
//   have sales through 2007. The coke and coke gas rules of (f)(2), (g) are not
//   modelled (TECH-GAPS G1779).

use self::{
    Asset,
    IRC_S45K_A,
    IRC_S45K_B,
    IRC_S45K_E,
    IRC_S45K_F,
    Person,
    TaxableYear,
};

pub enum FuelKind45K {
    OilFromShaleOrTarSands,
    GasFromTightFormation,
    OtherUnconventionalGas,
    GasFromBiomass,
    SyntheticFuelFromCoal,
}

pub relation fuel_kind_45k(project: Asset, kind: FuelKind45K) kind empirical {
    label en official "the kind of qualified fuel the project produces (section 45K(c)(1)): oil from shale and tar sands; gas from a tight formation; gas from geopressured brine, Devonian shale or coal seams; gas from biomass; synthetic fuels from coal — case-asserted";
}
pub relation boe_sold_to_unrelated_person_45k(taxpayer: Person, project: Asset, y: TaxableYear, boe: Decimal) kind empirical {
    label en official "the barrel-of-oil equivalent (5.8 million Btu) of qualified fuels sold by the taxpayer to an unrelated person during the taxable year and attributable to the taxpayer (section 45K(a)(2)) — case-asserted";
}
pub relation sale_date_45k(project: Asset, y: TaxableYear, on: Date) kind empirical {
    label en official "a date in the taxable year on which the qualified fuel is sold — case-asserted";
}
pub relation well_drilled_on_45k(project: Asset, on: Date) kind empirical {
    label en official "the date the well from which the fuel is produced is drilled (section 45K(e)(1)(A)) — case-asserted";
}
pub relation facility_placed_in_service_on_45k(project: Asset, on: Date) kind empirical {
    label en official "the date the facility is placed in service (section 45K(e)(1)(B)) — case-asserted";
}
pub relation binding_written_contract_before_1997_45k(project: Asset) kind empirical {
    label en official "the facility is placed in service pursuant to a binding written contract in effect before 1997-01-01 (section 45K(f)(1)(A)) — case-asserted";
}
pub relation production_within_united_states_45k(project: Asset) kind empirical {
    label en official "the production of the fuel is within the United States or a possession (section 45K(d)(1)) — case-asserted";
}
pub relation marketable_gas_before_1980_45k(project: Asset) kind empirical {
    label en official "gas from Devonian shale, coal seams, geopressured brine or a tight formation was produced in marketable quantities from the property before 1980-01-01 (section 45K(d)(4)) — case-asserted";
}
pub relation reference_price_45k(y: TaxableYear, dollars: Decimal) kind empirical {
    label en official "the reference price for the calendar year in which the sale occurs (section 45K(d)(2)(C)) — case-asserted, not pinned";
}
pub relation inflation_adjustment_factor_45k(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor (GNP implicit price deflator ratio to 1979, or to 2004 for fuels sold after 2005 under (g)(2)(B)) for the calendar year of the sale (section 45K(d)(2)(B)) — case-asserted, not pinned";
}
pub relation subsidies_cumulative_45k(project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum for the year and all prior years of grants, tax-exempt bond proceeds and subsidized energy financing for the project (section 45K(b)(3)(A)(i)) — case-asserted";
}
pub relation capital_additions_cumulative_45k(project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate additions to the capital account for the project for the year and all prior years (section 45K(b)(3)(A)(ii)) — case-asserted";
}
pub relation energy_percentage_credit_excess_45k(project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excess of the energy-percentage credits allowed under section 38 for the project over the amounts recaptured (section 45K(b)(4)) — case-asserted";
}
pub relation eor_credit_excess_45k(project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excess of the enhanced oil recovery credits allowed under section 38 for the project over the amounts recaptured (section 45K(b)(5)) — case-asserted";
}

// --- (e), (f)(1): eligible sales -------------------------------------------------------------------------------------------------

pub relation eligible_sale_45k(project: Asset, y: TaxableYear) kind institutional {
    label en official "sections 45K(e), (f)(1): the sale of qualified fuel from a well or facility of the qualifying period, within the sales period";
}
@source(IRC_S45K_E, quote = "produced from a well drilled after December 31, 1979, and before January 1, 1993")
rule EligibleSaleWell45kRule(project: Asset, y: TaxableYear, drilled: Date, sold: Date) strict {
    when well_drilled_on_45k(project, drilled);
    when drilled > @1979-12-31;
    when drilled < @1993-01-01;
    when sale_date_45k(project, y, sold);
    when sold < @2003-01-01;
    then eligible_sale_45k(project, y);
}
@source(IRC_S45K_E, quote = "produced in a facility placed in service after December 31, 1979, and before January 1, 1993")
rule EligibleSaleFacility45kRule(project: Asset, y: TaxableYear, placed: Date, sold: Date) strict {
    when facility_placed_in_service_on_45k(project, placed);
    when placed > @1979-12-31;
    when placed < @1993-01-01;
    when sale_date_45k(project, y, sold);
    when sold < @2003-01-01;
    then eligible_sale_45k(project, y);
}
@source(IRC_S45K_F, quote = "such facility shall be treated as being placed in service before January 1, 1993, if such facility is placed in service before July 1, 1998, pursuant to a binding written contract in effect before January 1, 1997")
rule EligibleSaleBiomassSyntheticFacility45kRule(project: Asset, y: TaxableYear, placed: Date, sold: Date) strict {
    when fuel_kind_45k(project, GasFromBiomass);
    when facility_placed_in_service_on_45k(project, placed);
    when placed > @1992-12-31;
    when placed < @1998-07-01;
    when binding_written_contract_before_1997_45k(project);
    when sale_date_45k(project, y, sold);
    when sold < @2008-01-01;
    then eligible_sale_45k(project, y);
}
rule EligibleSaleSyntheticFacility45kRule(project: Asset, y: TaxableYear, placed: Date, sold: Date) strict {
    when fuel_kind_45k(project, SyntheticFuelFromCoal);
    when facility_placed_in_service_on_45k(project, placed);
    when placed > @1992-12-31;
    when placed < @1998-07-01;
    when binding_written_contract_before_1997_45k(project);
    when sale_date_45k(project, y, sold);
    when sold < @2008-01-01;
    then eligible_sale_45k(project, y);
}

// --- (a), (b)(1)-(2): the amount per barrel-of-oil equivalent ---------------------------------------------------------------

pub relation amount_per_boe_45k(project: Asset, y: TaxableYear, dollars: Decimal) kind institutional {
    label en official "section 45K(a), (b)(2): $3, multiplied by the inflation adjustment factor except for gas from a tight formation, reduced by the price ratio of (b)(1)";
}
@source(IRC_S45K_B, quote = "In the case of gas from a tight formation, the $3 amount in subsection (a) shall not be adjusted.")
rule AmountPerBoeTightFormation45kRule(project: Asset, y: TaxableYear, price: Decimal, factor: Decimal) strict {
    when fuel_kind_45k(project, GasFromTightFormation);
    when reference_price_45k(y, price);
    when inflation_adjustment_factor_45k(y, factor);
    then amount_per_boe_45k(project, y, 3.0 * (1.0 - min(1.0, max(0.0, div_round(price - 23.5 * factor, 6.0 * factor, 10, "HALF_UP")))));
}
@source(IRC_S45K_B, quote = "The $3 amount in subsection (a) and the $23.50 and $6 amounts in paragraph (1) shall each be adjusted by multiplying such amount by the inflation adjustment factor for the calendar year in which the sale occurs.")
rule AmountPerBoeOther45kRule(project: Asset, y: TaxableYear, kind: FuelKind45K, price: Decimal, factor: Decimal) strict {
    when fuel_kind_45k(project, kind);
    when kind != GasFromTightFormation;
    when reference_price_45k(y, price);
    when inflation_adjustment_factor_45k(y, factor);
    then amount_per_boe_45k(project, y, 3.0 * factor * (1.0 - min(1.0, max(0.0, div_round(price - 23.5 * factor, 6.0 * factor, 10, "HALF_UP")))));
}

// --- (b)(3)-(5): the reductions -------------------------------------------------------------------------------------------------------

relation subsidy_fraction_45k(project: Asset, y: TaxableYear, fraction: Decimal) kind institutional;
@source(IRC_S45K_B, quote = "shall be reduced by the amount which is the product of the amount so determined for such year and a fraction")
rule SubsidyFraction45kRule(project: Asset, y: TaxableYear, subsidies: Money, capital: Money) strict {
    when subsidies_cumulative_45k(project, y, subsidies);
    when capital_additions_cumulative_45k(project, y, capital);
    then subsidy_fraction_45k(project, y, min(1.0, div_round(subsidies, capital, 10, "HALF_UP")));
}
rule SubsidyFractionNone45kRule(project: Asset, y: TaxableYear, boe: Decimal) strict {
    when boe_sold_to_unrelated_person_45k(_, project, y, boe);
    when not_known(has_subsidies_45k(project, y));
    then subsidy_fraction_45k(project, y, 0.0);
}
relation has_subsidies_45k(project: Asset, y: TaxableYear) kind institutional;
rule HasSubsidies45kRule(project: Asset, y: TaxableYear, subsidies: Money) strict {
    when subsidies_cumulative_45k(project, y, subsidies);
    then has_subsidies_45k(project, y);
}
relation other_credit_reductions_45k(project: Asset, y: TaxableYear, amount: Money) kind institutional;
rule OtherCreditReductionsBoth45kRule(project: Asset, y: TaxableYear, energy: Money, eor: Money) strict {
    when energy_percentage_credit_excess_45k(project, y, energy);
    when eor_credit_excess_45k(project, y, eor);
    then other_credit_reductions_45k(project, y, energy + eor);
}
relation has_energy_excess_45k(project: Asset, y: TaxableYear) kind institutional;
rule HasEnergyExcess45kRule(project: Asset, y: TaxableYear, amount: Money) strict {
    when energy_percentage_credit_excess_45k(project, y, amount);
    then has_energy_excess_45k(project, y);
}
relation has_eor_excess_45k(project: Asset, y: TaxableYear) kind institutional;
rule HasEorExcess45kRule(project: Asset, y: TaxableYear, amount: Money) strict {
    when eor_credit_excess_45k(project, y, amount);
    then has_eor_excess_45k(project, y);
}
rule OtherCreditReductionsEnergyOnly45kRule(project: Asset, y: TaxableYear, energy: Money) strict {
    when energy_percentage_credit_excess_45k(project, y, energy);
    when not_known(has_eor_excess_45k(project, y));
    then other_credit_reductions_45k(project, y, energy);
}
rule OtherCreditReductionsEorOnly45kRule(project: Asset, y: TaxableYear, eor: Money) strict {
    when eor_credit_excess_45k(project, y, eor);
    when not_known(has_energy_excess_45k(project, y));
    then other_credit_reductions_45k(project, y, eor);
}
rule OtherCreditReductionsNone45kRule(project: Asset, y: TaxableYear, boe: Decimal) strict {
    when boe_sold_to_unrelated_person_45k(_, project, y, boe);
    when not_known(has_energy_excess_45k(project, y));
    when not_known(has_eor_excess_45k(project, y));
    then other_credit_reductions_45k(project, y, 0 USD);
}

// --- (a): the credit -----------------------------------------------------------------------------------------------------------------------------

pub relation nonconventional_source_credit_per_project_45k(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45K(a): $3 (as adjusted and reduced) times the barrel-of-oil equivalent sold, after the (b)(3)-(5) reductions";
}
@source(IRC_S45K_A, quote = "the nonconventional source production credit determined under this section for the taxable year is an amount equal to")
rule NonconventionalSourceCreditPerProject45kRule(taxpayer: Person, project: Asset, y: TaxableYear, boe: Decimal, dollars: Decimal, fraction: Decimal, reductions: Money) defeasible {
    when eligible_sale_45k(project, y);
    when production_within_united_states_45k(project);
    when not_known(marketable_gas_before_1980_45k(project));
    when boe_sold_to_unrelated_person_45k(taxpayer, project, y, boe);
    when amount_per_boe_45k(project, y, dollars);
    when subsidy_fraction_45k(project, y, fraction);
    when other_credit_reductions_45k(project, y, reductions);
    then nonconventional_source_credit_per_project_45k(taxpayer, project, y, max(0 USD, round(round(dollars * boe, 2, "HALF_UP") * (1.0 - fraction), 2, "HALF_UP") * 1 USD - reductions));
}
pub relation nonconventional_source_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45K nonconventional source production credit for the taxable year (a section 38(b)(22) component)";
}
rule NonconventionalSourceProductionCredit45kRule(taxpayer: Person, y: TaxableYear, project: Asset, amount: Money) defeasible {
    when nonconventional_source_credit_per_project_45k(taxpayer, project, y, amount);
    then nonconventional_source_production_credit(taxpayer, y,
        sum(collect all a: Money, p: Asset where nonconventional_source_credit_per_project_45k(taxpayer, p, y, a), empty: 0 USD));
}
