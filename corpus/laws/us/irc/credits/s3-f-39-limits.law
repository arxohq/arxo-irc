// Stage 3 (TECH_GAP reduction): section 39(b) and (c) limits on the amount of the unused credit
// that may be absorbed by a carryback year and by a carryforward year.
//   (b): the amount taken into account for a preceding year does not exceed the section 38(c)
//        limitation of that year minus the sum of (1) the section 38(a)(1)-(2) amounts of that
//        year (carryforwards to it plus its current year business credit) and (2) the amounts
//        carried back to it from unused credit years preceding the unused credit year.
//   (c): the amount taken into account for a succeeding year does not exceed the section 38(c)
//        limitation of that year minus the amounts carried to it from unused credit years
//        preceding the unused credit year.
// The step is stated once here: `business_credit_carryback_computed_to_year` and
// `business_credit_carryforward_computed_to_year` (39-carryback-carryforward.law) now read the
// "before limit" relations. When the section 38(c) limitation of the absorbing year is not
// established in the case, the limit is not applied and the (a) amount passes through unchanged:
// LIMITATION of this module, kept so that a case that supplies no limitation of the other year
// still computes the (a) amount. Section 39(d) is stated in the next block.
// (b)(2), (c) earlier carrybacks/carryforwards are case facts: the full multi-year ledger is not
// derived (as in the header of 39-carryback-carryforward.law).
// STATUS: implemented_unverified (static check only).

use self::{
    IRC_S39_A,
    IRC_S39_B,
    IRC_S39_C,
    IRC_S39_D,
    Person,
    TaxableYear,
    business_credit_carryback_before_39b_limit,
    business_credit_carryback_computed_to_year,
    business_credit_carryforward_before_39c_limit,
    business_credit_carryforward_computed_to_year,
    business_credit_carryforward_to_year_or_zero,
    current_year_business_credit,
    general_business_credit_limitation,
};

pub relation carrybacks_from_earlier_unused_years_39b2(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 39(b)(2): the amounts carried back to the year by reason of section 39 and attributable to taxable years preceding the unused credit year — case-asserted";
}
pub relation carryforwards_from_earlier_unused_years_39c(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 39(c): the amounts carried to the year by reason of section 39 and attributable to taxable years preceding the unused credit year — case-asserted";
}
relation has_carrybacks_from_earlier_unused_years_39b2(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasCarrybacksFromEarlier39b2Rule(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    when carrybacks_from_earlier_unused_years_39b2(taxpayer, y, amount);
    then has_carrybacks_from_earlier_unused_years_39b2(taxpayer, y);
}
relation has_carryforwards_from_earlier_unused_years_39c(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasCarryforwardsFromEarlier39cRule(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    when carryforwards_from_earlier_unused_years_39c(taxpayer, y, amount);
    then has_carryforwards_from_earlier_unused_years_39c(taxpayer, y);
}

// --- (d): no carryback of a credit to a year before the credit is allowable -------------------------

pub relation carryback_portion_of_credit_not_yet_allowable_39d(taxpayer: Person, unused_credit_year: TaxableYear, carryback_year: TaxableYear, amount: Money) kind empirical {
    label en official "section 39(d): the portion of the unused business credit attributable to a credit specified in section 38(b) that was not allowable in the carryback year (before the first taxable year for which the specified credit is allowable, determined without regard to section 39(a)) — case-asserted; the attribution of the unused credit to the specified credits by the section 38(d) ordering is not derived";
}
relation has_portion_not_yet_allowable_39d(taxpayer: Person, unused_credit_year: TaxableYear, carryback_year: TaxableYear) kind institutional;
rule HasPortionNotYetAllowable39dRule(taxpayer: Person, uy: TaxableYear, cy: TaxableYear, amount: Money) strict {
    when carryback_portion_of_credit_not_yet_allowable_39d(taxpayer, uy, cy, amount);
    then has_portion_not_yet_allowable_39d(taxpayer, uy, cy);
}
pub relation business_credit_carryback_after_39d(taxpayer: Person, unused_credit_year: TaxableYear, carryback_year: TaxableYear, amount: Money) kind institutional {
    label en official "the section 39(a)(1)(A) carryback after removing the portion attributable to a specified credit not yet allowable in the carryback year (section 39(d)), before the section 39(b) limit";
}
@source(IRC_S39_D, relation = formalizes, coverage = exact, quote = "may be carried back to any taxable year before the first taxable year for which such specified credit or such portion is allowable (without regard to subsection (a)).")
rule CarrybackAfter39dRule(taxpayer: Person, uy: TaxableYear, cy: TaxableYear, amount: Money, portion: Money) defeasible {
    label en official "section 39(d): the portion attributable to a credit not yet allowable is not carried back";
    when business_credit_carryback_before_39b_limit(taxpayer, uy, cy, amount);
    when carryback_portion_of_credit_not_yet_allowable_39d(taxpayer, uy, cy, portion);
    then business_credit_carryback_after_39d(taxpayer, uy, cy, max(0 USD, amount - portion));
}
rule CarrybackAfter39dNoPortionRule(taxpayer: Person, uy: TaxableYear, cy: TaxableYear, amount: Money) defeasible {
    label en official "section 39(d): no portion attributable to a credit not yet allowable";
    when business_credit_carryback_before_39b_limit(taxpayer, uy, cy, amount);
    when not_known(has_portion_not_yet_allowable_39d(taxpayer, uy, cy));
    then business_credit_carryback_after_39d(taxpayer, uy, cy, amount);
}

// --- (b): the carryback limit -----------------------------------------------------------------------

pub relation carryback_limit_39b(taxpayer: Person, carryback_year: TaxableYear, limit: Money) kind institutional {
    label en official "section 39(b): the section 38(c) limitation of the carryback year minus the sum of its section 38(a)(1)-(2) amounts and the amounts carried back to it from earlier unused credit years (not below zero)";
}
@source(IRC_S39_B, relation = formalizes, coverage = exact, quote = "shall not exceed the amount by which the limitation imposed by section 38(c) for such taxable year exceeds the sum of—")
rule CarrybackLimit39bWithEarlierRule(taxpayer: Person, y: TaxableYear, lim: Money, cf: Money, cur: Money, earlier: Money) defeasible {
    label en official "section 39(b)(1), (2): the limit when carrybacks from earlier unused credit years exist";
    when general_business_credit_limitation(taxpayer, y, lim);
    when business_credit_carryforward_to_year_or_zero(taxpayer, y, cf);
    when current_year_business_credit(taxpayer, y, cur);
    when carrybacks_from_earlier_unused_years_39b2(taxpayer, y, earlier);
    then carryback_limit_39b(taxpayer, y, max(0 USD, lim - (cf + cur + earlier)));
}
rule CarrybackLimit39bNoEarlierRule(taxpayer: Person, y: TaxableYear, lim: Money, cf: Money, cur: Money) defeasible {
    label en official "section 39(b)(1): the limit when no carryback from an earlier unused credit year exists";
    when general_business_credit_limitation(taxpayer, y, lim);
    when business_credit_carryforward_to_year_or_zero(taxpayer, y, cf);
    when current_year_business_credit(taxpayer, y, cur);
    when not_known(has_carrybacks_from_earlier_unused_years_39b2(taxpayer, y));
    then carryback_limit_39b(taxpayer, y, max(0 USD, lim - (cf + cur)));
}
relation has_carryback_limit_39b(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasCarrybackLimit39bRule(taxpayer: Person, y: TaxableYear, lim: Money) defeasible {
    when carryback_limit_39b(taxpayer, y, lim);
    then has_carryback_limit_39b(taxpayer, y);
}
@source(IRC_S39_A, relation = formalizes, coverage = partial, quote = "a business credit carryback to the taxable year preceding the unused credit year")
rule CarrybackLimited39bRule(taxpayer: Person, uy: TaxableYear, cy: TaxableYear, amount: Money, lim: Money) defeasible {
    label en official "section 39(a)(1)(A) with (b): the carryback is the lesser of the unused credit and the limit of the carryback year";
    when business_credit_carryback_after_39d(taxpayer, uy, cy, amount);
    when carryback_limit_39b(taxpayer, cy, lim);
    then business_credit_carryback_computed_to_year(taxpayer, uy, cy, min(amount, lim));
}
rule CarrybackNotLimited39bRule(taxpayer: Person, uy: TaxableYear, cy: TaxableYear, amount: Money) defeasible {
    label en official "section 39(b): the limit of the carryback year is not established in the case; the amount of (a) passes through";
    when business_credit_carryback_after_39d(taxpayer, uy, cy, amount);
    when not_known(has_carryback_limit_39b(taxpayer, cy));
    then business_credit_carryback_computed_to_year(taxpayer, uy, cy, amount);
}

// --- (c): the carryforward limit --------------------------------------------------------------------

pub relation carryforward_limit_39c(taxpayer: Person, candidate: TaxableYear, limit: Money) kind institutional {
    label en official "section 39(c): the section 38(c) limitation of the succeeding year minus the amounts carried to it from earlier unused credit years (not below zero)";
}
@source(IRC_S39_C, relation = formalizes, coverage = exact, quote = "shall not exceed the amount by which the limitation imposed by section 38(c) for such taxable year exceeds the sum of the amounts which, by reason of this section, are carried to such taxable year and are attributable to taxable years preceding the unused credit year.")
rule CarryforwardLimit39cWithEarlierRule(taxpayer: Person, y: TaxableYear, lim: Money, earlier: Money) defeasible {
    label en official "section 39(c): the limit when carryforwards from earlier unused credit years exist";
    when general_business_credit_limitation(taxpayer, y, lim);
    when carryforwards_from_earlier_unused_years_39c(taxpayer, y, earlier);
    then carryforward_limit_39c(taxpayer, y, max(0 USD, lim - earlier));
}
rule CarryforwardLimit39cNoEarlierRule(taxpayer: Person, y: TaxableYear, lim: Money) defeasible {
    label en official "section 39(c): the limit when no carryforward from an earlier unused credit year exists";
    when general_business_credit_limitation(taxpayer, y, lim);
    when not_known(has_carryforwards_from_earlier_unused_years_39c(taxpayer, y));
    then carryforward_limit_39c(taxpayer, y, lim);
}
relation has_carryforward_limit_39c(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasCarryforwardLimit39cRule(taxpayer: Person, y: TaxableYear, lim: Money) defeasible {
    when carryforward_limit_39c(taxpayer, y, lim);
    then has_carryforward_limit_39c(taxpayer, y);
}
@source(IRC_S39_A, relation = formalizes, coverage = partial, quote = "The entire amount of the unused credit for an unused credit year shall be carried to the earliest of the 21 taxable years to which (by reason of paragraph (1)) such credit may be carried.")
rule CarryforwardLimited39cRule(taxpayer: Person, uy: TaxableYear, cand: TaxableYear, amount: Money, lim: Money) defeasible {
    label en official "section 39(a)(1)(B) with (c): the carryforward is the lesser of the unused credit and the limit of the candidate year";
    when business_credit_carryforward_before_39c_limit(taxpayer, uy, cand, amount);
    when carryforward_limit_39c(taxpayer, cand, lim);
    then business_credit_carryforward_computed_to_year(taxpayer, uy, cand, min(amount, lim));
}
rule CarryforwardNotLimited39cRule(taxpayer: Person, uy: TaxableYear, cand: TaxableYear, amount: Money) defeasible {
    label en official "section 39(c): the limit of the candidate year is not established in the case; the amount of (a) passes through";
    when business_credit_carryforward_before_39c_limit(taxpayer, uy, cand, amount);
    when not_known(has_carryforward_limit_39c(taxpayer, cand));
    then business_credit_carryforward_computed_to_year(taxpayer, uy, cand, amount);
}
