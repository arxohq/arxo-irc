// Section 45V — Credit for production of clean hydrogen. Stage 2d (IRC-06,
// DECISION-0379).
//
// Editions by `legal_time`: the 2024 text requires construction of the
// facility to begin before 2033-01-01; PL 119-21 section 70511
// (`us.irc.temporal::PL119_21_S70511`, enacted 2025-07-04) moves it to
// 2028-01-01. Two rules with `effective` windows carry the two texts.
//
// Scope / judgment calls:
// * (a): kilograms of qualified clean hydrogen produced during the 10 years
//   after the facility was originally placed in service times the applicable
//   amount. (b): the applicable amount is the applicable percentage of $0.60
//   (indexed by the inflation adjustment factor, rounded to the nearest 0.1
//   cent), the percentage set by the lifecycle emissions rate: 20 percent (2.5
//   to 4 kg CO2e per kg), 25 percent (1.5 to under 2.5), 33.4 percent (0.45
//   to under 1.5), 100 percent (under 0.45). (e): x5 when the wage and
//   apprenticeship requirements are met.
// * (c)-(f): the lifecycle emissions rate, verification, the modification
//   rule and the wage rules are case facts (TECH-GAPS G1724); (d)(2): no
//   credit at a facility with carbon capture equipment credited under 45Q.

use self::{
    Asset,
    IRC_S45V_A,
    IRC_S45V_B,
    IRC_S45V_C,
    IRC_S45V_D,
    IRC_S45V_E,
    Person,
    TaxableYear,
    has_reduction_fraction_45b3,
    hydrogen_kilograms_for_credit_45v,
    reduction_fraction_45b3,
};

pub relation hydrogen_kilograms_produced_45v(taxpayer: Person, facility: Asset, y: TaxableYear, kilograms: Decimal) kind empirical {
    label en official "kilograms of qualified clean hydrogen produced by the taxpayer during the taxable year at the facility (section 45V(a)(1)) — case-asserted";
}
pub relation hydrogen_production_date_45v(facility: Asset, y: TaxableYear, on: Date) kind empirical {
    label en official "a date in the taxable year on which hydrogen is produced (for the 10-year period test) — case-asserted";
}
pub relation lifecycle_emissions_rate_45v(facility: Asset, kg_co2e_per_kg: Decimal) kind empirical {
    label en official "the lifecycle greenhouse gas emissions rate of the hydrogen, in kilograms of CO2e per kilogram of hydrogen, well-to-gate (section 45V(c)(1)) — case-asserted";
}
pub relation facility_owned_by_taxpayer_45v(facility: Asset, taxpayer: Person) kind empirical {
    label en official "the facility is owned by the taxpayer (section 45V(c)(3)(A)) — case-asserted";
}
pub relation facility_originally_placed_in_service_on_45v(facility: Asset, on: Date) kind empirical {
    label en official "the date the facility was originally placed in service (deemed date after a section 45V(d)(4) modification) — case-asserted";
}
pub relation facility_construction_begins_on_45v(facility: Asset, on: Date) kind empirical {
    label en official "the date construction of the facility begins (section 45V(c)(3)(C)) — case-asserted";
}
pub relation production_verified_and_in_ordinary_course_45v(facility: Asset, taxpayer: Person) kind empirical {
    label en official "the hydrogen is produced in the United States or a possession, in the ordinary course of the taxpayer's trade or business, for sale or use, and the production and sale or use is verified by an unrelated party (section 45V(c)(2)(B)) — case-asserted";
}
pub relation facility_credit_allowed_under_45q_45v(facility: Asset) kind empirical {
    label en official "the facility includes carbon capture equipment for which a credit is allowed to any taxpayer under section 45Q for the taxable year or any prior taxable year (section 45V(d)(2)) — case-asserted";
}
pub relation prevailing_wage_and_apprenticeship_satisfied_45v(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the section 45V(e)(2) requirements (prevailing wage under (3)(A) and apprenticeship under (4), or the grandfathered construction start) are satisfied — case-asserted";
}
pub relation inflation_adjustment_factor_45v(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor of section 45(e)(2) with 2022 substituted for 1992, for the calendar year in which the hydrogen is produced (section 45V(b)(3)) — case-asserted, not pinned";
}

pub relation qualified_clean_hydrogen_45v(facility: Asset) kind institutional {
    label en official "section 45V(c)(2)(A): hydrogen produced with a lifecycle emissions rate of not greater than 4 kg CO2e per kg, produced and verified as required";
}
@source(IRC_S45V_C, quote = "hydrogen which is produced through a process that results in a lifecycle greenhouse gas emissions rate of not greater than 4 kilograms of CO2e per kilogram of hydrogen")
rule QualifiedCleanHydrogen45vRule(facility: Asset, taxpayer: Person, rate: Decimal) strict {
    when lifecycle_emissions_rate_45v(facility, rate);
    when rate <= 4.0;
    when production_verified_and_in_ordinary_course_45v(facility, taxpayer);
    then qualified_clean_hydrogen_45v(facility);
}
pub relation qualified_clean_hydrogen_production_facility_45v(facility: Asset, taxpayer: Person) kind institutional {
    label en official "section 45V(c)(3): a facility owned by the taxpayer that produces qualified clean hydrogen and whose construction begins before the end date (2033-01-01 in the 2024 text; 2028-01-01 under PL 119-21 section 70511)";
}
@source(IRC_S45V_C, quote = "the construction of which begins before January 1, 2033")
rule QualifiedFacilityBase45vRule(facility: Asset, taxpayer: Person, begins: Date) strict {
    effective (-infinity, @2025-07-04);
    when facility_owned_by_taxpayer_45v(facility, taxpayer);
    when qualified_clean_hydrogen_45v(facility);
    when facility_construction_begins_on_45v(facility, begins);
    when begins < @2033-01-01;
    then qualified_clean_hydrogen_production_facility_45v(facility, taxpayer);
}
@source(us.irc.temporal::PL119_21_S70511, quote = "Section 45V(c)(3)(C) is amended by striking “January 1, 2033” and inserting “January 1, 2028”.")
rule QualifiedFacilityAmended45vRule(facility: Asset, taxpayer: Person, begins: Date) strict {
    effective [@2025-07-04, infinity);
    when facility_owned_by_taxpayer_45v(facility, taxpayer);
    when qualified_clean_hydrogen_45v(facility);
    when facility_construction_begins_on_45v(facility, begins);
    when begins < @2028-01-01;
    then qualified_clean_hydrogen_production_facility_45v(facility, taxpayer);
}
pub relation within_ten_year_period_45v(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45V(a)(1): the hydrogen is produced within the 10-year period beginning on the date the facility was originally placed in service";
}
@source(IRC_S45V_A, quote = "during the 10-year period beginning on the date such facility was originally placed in service")
rule WithinTenYearPeriod45vRule(facility: Asset, y: TaxableYear, placed: Date, produced: Date) strict {
    when facility_originally_placed_in_service_on_45v(facility, placed);
    when hydrogen_production_date_45v(facility, y, produced);
    when produced >= placed;
    when produced < add_calendar_period(placed, 120 calendar_month);
    then within_ten_year_period_45v(facility, y);
}

// --- (b): the applicable amount ---------------------------------------------------------------------------------

pub relation applicable_percentage_45v(facility: Asset, pct: Decimal) kind institutional {
    label en official "section 45V(b)(2): 20 / 25 / 33.4 / 100 percent by lifecycle emissions rate band";
}
@source(IRC_S45V_B, quote = "the applicable percentage shall be 20 percent")
rule ApplicablePercentageTwenty45vRule(facility: Asset, rate: Decimal) strict {
    when lifecycle_emissions_rate_45v(facility, rate);
    when rate <= 4.0;
    when rate >= 2.5;
    then applicable_percentage_45v(facility, 0.20);
}
@source(IRC_S45V_B, quote = "the applicable percentage shall be 25 percent")
rule ApplicablePercentageTwentyFive45vRule(facility: Asset, rate: Decimal) strict {
    when lifecycle_emissions_rate_45v(facility, rate);
    when rate < 2.5;
    when rate >= 1.5;
    then applicable_percentage_45v(facility, 0.25);
}
@source(IRC_S45V_B, quote = "the applicable percentage shall be 33.4 percent")
rule ApplicablePercentageThirtyThree45vRule(facility: Asset, rate: Decimal) strict {
    when lifecycle_emissions_rate_45v(facility, rate);
    when rate < 1.5;
    when rate >= 0.45;
    then applicable_percentage_45v(facility, 0.334);
}
@source(IRC_S45V_B, quote = "the applicable percentage shall be 100 percent")
rule ApplicablePercentageHundred45vRule(facility: Asset, rate: Decimal) strict {
    when lifecycle_emissions_rate_45v(facility, rate);
    when rate < 0.45;
    then applicable_percentage_45v(facility, 1.00);
}
pub relation applicable_amount_per_kilogram_45v(facility: Asset, y: TaxableYear, dollars: Decimal) kind institutional {
    label en official "section 45V(b)(1), (b)(3): the applicable percentage of $0.60, indexed and rounded to the nearest 0.1 cent";
}
@source(IRC_S45V_B, quote = "If any amount as determined under the preceding sentence is not a multiple of 0.1 cent, such amount shall be rounded to the nearest multiple of 0.1 cent.")
rule ApplicableAmountPerKilogram45vRule(facility: Asset, y: TaxableYear, pct: Decimal, factor: Decimal) strict {
    when applicable_percentage_45v(facility, pct);
    when inflation_adjustment_factor_45v(y, factor);
    then applicable_amount_per_kilogram_45v(facility, y, round(0.60 * factor * pct, 3, "HALF_UP"));
}

// --- (a), (d)(2), (e): the credit ---------------------------------------------------------------------------------

pub relation hydrogen_credit_before_wage_multiplier_45v(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45V(a): kilograms times the applicable amount";
}
@source(IRC_S45V_A, quote = "the clean hydrogen production credit for any taxable year is an amount equal to the product of")
rule HydrogenCreditBeforeWageMultiplier45vRule(taxpayer: Person, facility: Asset, y: TaxableYear, kilograms: Decimal, dollars: Decimal) defeasible {
    when qualified_clean_hydrogen_production_facility_45v(facility, taxpayer);
    when within_ten_year_period_45v(facility, y);
    when not_known(facility_credit_allowed_under_45q_45v(facility));
    when hydrogen_kilograms_for_credit_45v(taxpayer, facility, y, kilograms);
    when applicable_amount_per_kilogram_45v(facility, y, dollars);
    then hydrogen_credit_before_wage_multiplier_45v(taxpayer, facility, y, round(kilograms * dollars, 2, "HALF_UP") * 1 USD);
}
pub relation hydrogen_credit_of_facility_before_45b3_45v(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45V(a), (e)(1): the credit of the facility, multiplied by 5 when the wage and apprenticeship requirements are satisfied, before the section 45V(d)(3) reduction for tax-exempt bonds (stage 4)";
}
pub relation hydrogen_credit_of_facility_45v(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45V(a), (d)(3), (e)(1): the credit of the facility after the reduction for tax-exempt bonds, by the rule similar to section 45(b)(3)";
}
@source(IRC_S45V_D, quote = "Rules similar to the rule under section 45(b)(3) shall apply for purposes of this section.")
rule HydrogenCreditReduced45vd3Rule(taxpayer: Person, facility: Asset, y: TaxableYear, before: Money, f: Decimal) defeasible {
    label en official "section 45V(d)(3): the credit of the facility reduced by the fraction of section 45(b)(3), facility by facility (stage 4)";
    when hydrogen_credit_of_facility_before_45b3_45v(taxpayer, facility, y, before);
    when reduction_fraction_45b3(facility, y, f);
    then hydrogen_credit_of_facility_45v(taxpayer, facility, y, round(before * (1.0 - f), 2, "HALF_UP"));
}
rule HydrogenCreditNotReduced45vd3Rule(taxpayer: Person, facility: Asset, y: TaxableYear, before: Money) defeasible {
    label en official "section 45V(d)(3): no tax-exempt bond financing, no reduction";
    when hydrogen_credit_of_facility_before_45b3_45v(taxpayer, facility, y, before);
    when not_known(has_reduction_fraction_45b3(facility, y));
    then hydrogen_credit_of_facility_45v(taxpayer, facility, y, before);
}
@source(IRC_S45V_E, quote = "the amount of the credit determined under subsection (a) with respect to qualified clean hydrogen described in subsection (b)(2) shall be equal to such amount (determined without regard to this sentence) multiplied by 5")
rule HydrogenCreditMultiplied45vRule(taxpayer: Person, facility: Asset, y: TaxableYear, base: Money) defeasible {
    when hydrogen_credit_before_wage_multiplier_45v(taxpayer, facility, y, base);
    when prevailing_wage_and_apprenticeship_satisfied_45v(facility, y);
    then hydrogen_credit_of_facility_before_45b3_45v(taxpayer, facility, y, base * 5.0);
}
rule HydrogenCreditBase45vRule(taxpayer: Person, facility: Asset, y: TaxableYear, base: Money) defeasible {
    when hydrogen_credit_before_wage_multiplier_45v(taxpayer, facility, y, base);
    when not_known(prevailing_wage_and_apprenticeship_satisfied_45v(facility, y));
    then hydrogen_credit_of_facility_before_45b3_45v(taxpayer, facility, y, base);
}
pub relation clean_hydrogen_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45V clean hydrogen production credit for the taxable year (a section 38(b)(36) component)";
}
rule CleanHydrogenProductionCredit45vRule(taxpayer: Person, y: TaxableYear, facility: Asset, amount: Money) defeasible {
    when hydrogen_credit_of_facility_45v(taxpayer, facility, y, amount);
    then clean_hydrogen_production_credit(taxpayer, y,
        sum(collect all a: Money, f: Asset where hydrogen_credit_of_facility_45v(taxpayer, f, y, a), empty: 0 USD));
}
