// Stage 3 (TECH_GAP reduction): section 41(g), the limit on the research credit of an individual
// who owns an interest in an unincorporated trade or business, is a partner, a beneficiary of an
// estate or trust, or an S corporation shareholder: the credit for the year does not exceed the
// tax attributable to the part of the person's taxable income allocable or apportionable to the
// interest (separately computed for the interest).
// `research_credit` (41-research-credit.law) is produced here from `research_credit_before_41g`.
// The attributable tax is a case fact (computed under section 1 on the allocable income);
// the interests are case facts.
// NOT MODELLED (G6213): the second sentence of (g), the carryover under section 39 with the
// section 41(g) limit taken into account in lieu of the section 38(c) limitation.
// STATUS: implemented_unverified (static check only).

use self::{
    IRC_S41_G,
    Person,
    TaxableYear,
    research_credit,
    research_credit_before_41g,
};

pub relation owns_interest_in_unincorporated_business_41g(individual: Person, y: TaxableYear) kind empirical {
    label en official "section 41(g)(1): the individual owns an interest in an unincorporated trade or business — case-asserted";
}
pub relation partner_in_partnership_41g(individual: Person, y: TaxableYear) kind empirical {
    label en official "section 41(g)(2): the individual is a partner in a partnership — case-asserted";
}
pub relation beneficiary_of_estate_or_trust_41g(individual: Person, y: TaxableYear) kind empirical {
    label en official "section 41(g)(3): the individual is a beneficiary of an estate or trust — case-asserted";
}
pub relation shareholder_in_s_corporation_41g(individual: Person, y: TaxableYear) kind empirical {
    label en official "section 41(g)(4): the individual is a shareholder in an S corporation — case-asserted";
}
pub relation pass_thru_interest_holder_41g(individual: Person, y: TaxableYear) kind institutional {
    label en official "section 41(g): an individual who owns an interest in an unincorporated trade or business, is a partner, a beneficiary of an estate or trust, or an S corporation shareholder";
}
@source(IRC_S41_G, relation = formalizes, coverage = partial, quote = "(1) owns an interest in an unincorporated trade or business,")
rule PassThruInterestHolder41gBusinessRule(individual: Person, y: TaxableYear) strict {
    when owns_interest_in_unincorporated_business_41g(individual, y);
    then pass_thru_interest_holder_41g(individual, y);
}
@source(IRC_S41_G, relation = formalizes, coverage = partial, quote = "(2) is a partner in a partnership,")
rule PassThruInterestHolder41gPartnerRule(individual: Person, y: TaxableYear) strict {
    when partner_in_partnership_41g(individual, y);
    then pass_thru_interest_holder_41g(individual, y);
}
@source(IRC_S41_G, relation = formalizes, coverage = partial, quote = "(3) is a beneficiary of an estate or trust, or")
rule PassThruInterestHolder41gBeneficiaryRule(individual: Person, y: TaxableYear) strict {
    when beneficiary_of_estate_or_trust_41g(individual, y);
    then pass_thru_interest_holder_41g(individual, y);
}
@source(IRC_S41_G, relation = formalizes, coverage = partial, quote = "(4) is a shareholder in an S corporation,")
rule PassThruInterestHolder41gShareholderRule(individual: Person, y: TaxableYear) strict {
    when shareholder_in_s_corporation_41g(individual, y);
    then pass_thru_interest_holder_41g(individual, y);
}
pub relation tax_attributable_to_pass_thru_interest_41g(individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 41(g): the amount of tax attributable to that portion of the person's taxable income which is allocable or apportionable to the interest, separately computed for the interest — case-asserted";
}
@source(IRC_S41_G, relation = formalizes, coverage = partial, quote = "the amount determined under subsection (a) for any taxable year shall not exceed an amount (separately computed with respect to such person's interest in such trade or business or entity) equal to the amount of tax attributable to that portion of a person's taxable income which is allocable or apportionable to the person's interest in such trade or business or entity.")
rule ResearchCreditLimited41gRule(taxpayer: Person, y: TaxableYear, before: Money, limit: Money) defeasible {
    label en official "section 41(g): the credit of a pass-thru interest holder is limited to the tax attributable to the interest";
    when research_credit_before_41g(taxpayer, y, before);
    when pass_thru_interest_holder_41g(taxpayer, y);
    when tax_attributable_to_pass_thru_interest_41g(taxpayer, y, limit);
    then research_credit(taxpayer, y, min(before, limit));
}
rule ResearchCreditNotLimited41gRule(taxpayer: Person, y: TaxableYear, before: Money) defeasible {
    label en official "section 41(g): not a pass-thru interest holder, the credit is not limited";
    when research_credit_before_41g(taxpayer, y, before);
    when not_known(pass_thru_interest_holder_41g(taxpayer, y));
    then research_credit(taxpayer, y, before);
}
