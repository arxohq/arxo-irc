// Stage 4 (DECISION-0379 with deontics), credits, part R: section 45(e)(8)(C) and (e)(10)(C) — the rules
// similar to section 45(b)(3) and (e)(1)-(5) [(e)(1), (3), (4), (5) for Indian coal] applied to the
// increases of refined coal, steel industry fuel and Indian coal. Closes G6411 (with parts 45Q/45V edits).
//
// The increases of module 45c are OUTPUT relations (no rule reads them); the increase FOR THE CREDIT is
// written here: reduced by the fraction of section 45(b)(3) of the facility (`reduction_fraction_45b3`, read
// by explicit reference), and nil when the sale is excluded by the rules of (e)(1), (4), (13) (the
// exclusion of part J, read here for production outside the United States and possessions or sales only to
// related persons: the same facility-year fact). (e)(3) (allocation among owners) and (e)(5) (estates and
// trusts) are the outputs of part J and part B (`ownership_share_of_gross_sales_45` and
// `section_52d_income_allocable_share` read for the increase are not re-derived here: the increase is
// per facility).
//
// WIRING (final TECH_GAP pass, 26.09.2026, closes the G6601 remainder): the three increases of a facility
// are bridged into one `coal_increase_for_credit_of_facility_45`; the increase is split among the owners
// by their interests in the gross sales (rule similar to (e)(3): share x the increase; an owner with no
// asserted share reads the whole increase), summed per taxpayer, apportioned between an estate or trust
// and its beneficiaries by income (rule similar to (e)(5): the estate keeps the increase less the rounded
// parts, a beneficiary receives the rounded parts), and added to the section 45 component that the
// section 38(b) wiring reads (`section_45_credit_with_coal_increase_45`, module 38b).

use self::{
    Asset,
    IRC_S45_E,
    Person,
    TaxableYear,
    has_gross_sales_share_45,
    has_reduction_fraction_45b3,
    indian_coal_increase_45,
    kilowatt_hours_excluded_by_45e_rules_45x,
    ownership_share_of_gross_sales_45,
    reduction_fraction_45b3,
    refined_coal_increase_45,
    section_52d_income_allocable_share,
    steel_industry_fuel_increase_45,
};

pub relation refined_coal_increase_for_credit_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the RefinedCoal increase for the credit: reduced by the fraction of section 45(b)(3) and nil when the sales are excluded by the rules similar to section 45(e)(1), (4), (13) ((e)(8)(C))";
}
@source(IRC_S45_E, quote = "Rules similar to the rules of the subsection (b)(3) and paragraphs (1) through (5) of this subsection shall apply for purposes of determining the amount of any increase under this paragraph.")
rule RefinedCoalIncreaseReduced45b3Similar(facility: Asset, y: TaxableYear, increase: Money, f: Decimal) defeasible {
    label en official "the increase reduced by the section 45(b)(3) fraction ((e)(8)(C))";
    when refined_coal_increase_45(facility, y, increase);
    when reduction_fraction_45b3(facility, y, f);
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then refined_coal_increase_for_credit_45(facility, y, round(increase * (1.0 - f), 2, "HALF_UP"));
}
rule RefinedCoalIncreaseNotReduced45b3Similar(facility: Asset, y: TaxableYear, increase: Money) defeasible {
    label en official "no tax-exempt bond financing: the increase stands ((e)(8)(C))";
    when refined_coal_increase_45(facility, y, increase);
    when not_known(has_reduction_fraction_45b3(facility, y));
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then refined_coal_increase_for_credit_45(facility, y, increase);
}
rule RefinedCoalIncreaseExcluded45eSimilar(facility: Asset, y: TaxableYear, increase: Money) defeasible {
    label en official "sales excluded by the rules similar to section 45(e)(1), (4), (13): no increase ((e)(8)(C))";
    when refined_coal_increase_45(facility, y, increase);
    when kilowatt_hours_excluded_by_45e_rules_45x(facility, y);
    then refined_coal_increase_for_credit_45(facility, y, 0 USD);
}
pub relation steel_industry_fuel_increase_for_credit_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the SteelIndustryFuel increase for the credit: reduced by the fraction of section 45(b)(3) and nil when the sales are excluded by the rules similar to section 45(e)(1), (4), (13) ((e)(8)(D), (C))";
}
@source(IRC_S45_E, quote = "Rules similar to the rules of the subsection (b)(3) and paragraphs (1) through (5) of this subsection shall apply for purposes of determining the amount of any increase under this paragraph.")
rule SteelIndustryFuelIncreaseReduced45b3Similar(facility: Asset, y: TaxableYear, increase: Money, f: Decimal) defeasible {
    label en official "the increase reduced by the section 45(b)(3) fraction ((e)(8)(D), (C))";
    when steel_industry_fuel_increase_45(facility, y, increase);
    when reduction_fraction_45b3(facility, y, f);
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then steel_industry_fuel_increase_for_credit_45(facility, y, round(increase * (1.0 - f), 2, "HALF_UP"));
}
rule SteelIndustryFuelIncreaseNotReduced45b3Similar(facility: Asset, y: TaxableYear, increase: Money) defeasible {
    label en official "no tax-exempt bond financing: the increase stands ((e)(8)(D), (C))";
    when steel_industry_fuel_increase_45(facility, y, increase);
    when not_known(has_reduction_fraction_45b3(facility, y));
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then steel_industry_fuel_increase_for_credit_45(facility, y, increase);
}
rule SteelIndustryFuelIncreaseExcluded45eSimilar(facility: Asset, y: TaxableYear, increase: Money) defeasible {
    label en official "sales excluded by the rules similar to section 45(e)(1), (4), (13): no increase ((e)(8)(D), (C))";
    when steel_industry_fuel_increase_45(facility, y, increase);
    when kilowatt_hours_excluded_by_45e_rules_45x(facility, y);
    then steel_industry_fuel_increase_for_credit_45(facility, y, 0 USD);
}
pub relation indian_coal_increase_for_credit_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the IndianCoal increase for the credit: reduced by the fraction of section 45(b)(3) and nil when the sales are excluded by the rules similar to section 45(e)(1), (4), (13) ((e)(10)(C))";
}
@source(IRC_S45_E, quote = "Rules similar to the rules of the subsection (b)(3) and paragraphs (1), (3), (4), and (5) of this subsection shall apply for purposes of determining the amount of any increase under this paragraph.")
rule IndianCoalIncreaseReduced45b3Similar(facility: Asset, y: TaxableYear, increase: Money, f: Decimal) defeasible {
    label en official "the increase reduced by the section 45(b)(3) fraction ((e)(10)(C))";
    when indian_coal_increase_45(facility, y, increase);
    when reduction_fraction_45b3(facility, y, f);
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then indian_coal_increase_for_credit_45(facility, y, round(increase * (1.0 - f), 2, "HALF_UP"));
}
rule IndianCoalIncreaseNotReduced45b3Similar(facility: Asset, y: TaxableYear, increase: Money) defeasible {
    label en official "no tax-exempt bond financing: the increase stands ((e)(10)(C))";
    when indian_coal_increase_45(facility, y, increase);
    when not_known(has_reduction_fraction_45b3(facility, y));
    when not_known(kilowatt_hours_excluded_by_45e_rules_45x(facility, y));
    then indian_coal_increase_for_credit_45(facility, y, increase);
}
rule IndianCoalIncreaseExcluded45eSimilar(facility: Asset, y: TaxableYear, increase: Money) defeasible {
    label en official "sales excluded by the rules similar to section 45(e)(1), (4), (13): no increase ((e)(10)(C))";
    when indian_coal_increase_45(facility, y, increase);
    when kilowatt_hours_excluded_by_45e_rules_45x(facility, y);
    then indian_coal_increase_for_credit_45(facility, y, 0 USD);
}

// ===================== the wiring: (e)(3) owners, (e)(5) estates and trusts, the section 45 total =====================

pub relation coal_increase_facility_owner_45(facility: Asset, owner: Person) kind empirical {
    label en official "the person owns the refined coal, steel industry fuel or Indian coal facility (an owner with an interest in the gross sales of section 45(e)(3), or the single owner) — case-asserted";
}
pub relation coal_increase_for_credit_of_facility_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase for the credit of the facility, whichever of the three increases applies (section 45(e)(8), (10))";
}
rule CoalIncreaseBridgeRefined45(facility: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge: the refined coal increase for the credit";
    when refined_coal_increase_for_credit_45(facility, y, amount);
    then coal_increase_for_credit_of_facility_45(facility, y, amount);
}
rule CoalIncreaseBridgeSteel45(facility: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge: the steel industry fuel increase for the credit";
    when steel_industry_fuel_increase_for_credit_45(facility, y, amount);
    then coal_increase_for_credit_of_facility_45(facility, y, amount);
}
rule CoalIncreaseBridgeIndian45(facility: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge: the Indian coal increase for the credit";
    when indian_coal_increase_for_credit_45(facility, y, amount);
    then coal_increase_for_credit_of_facility_45(facility, y, amount);
}
pub relation coal_increase_of_owner_45(facility: Asset, owner: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase for the credit of an owner of the facility: the increase times the owner's interest in the gross sales where one is asserted (rule similar to section 45(e)(3)), else the whole increase; cents HALF_UP";
}
@source(IRC_S45_E, quote = "Rules similar to the rules of the subsection (b)(3) and paragraphs (1) through (5) of this subsection shall apply for purposes of determining the amount of any increase under this paragraph.")
rule CoalIncreaseOfOwnerWithShare45(facility: Asset, owner: Person, y: TaxableYear, amount: Money, share: Decimal) defeasible {
    label en official "share x the increase of the facility ((e)(8)(C), (10)(C), by (e)(3))";
    when coal_increase_facility_owner_45(facility, owner);
    when coal_increase_for_credit_of_facility_45(facility, y, amount);
    when ownership_share_of_gross_sales_45(facility, owner, share);
    then coal_increase_of_owner_45(facility, owner, y, round(amount * share, 2, "HALF_UP"));
}
rule CoalIncreaseOfOwnerWithoutShare45(facility: Asset, owner: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "no interest asserted: the whole increase (the single-owner case)";
    when coal_increase_facility_owner_45(facility, owner);
    when coal_increase_for_credit_of_facility_45(facility, y, amount);
    when not_known(has_gross_sales_share_45(facility, owner));
    then coal_increase_of_owner_45(facility, owner, y, amount);
}
pub relation coal_increase_before_apportionment_45(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the increases of the facilities of the taxpayer, before the apportionment between an estate or trust and its beneficiaries";
}
rule CoalIncreaseBeforeApportionment45(taxpayer: Person, y: TaxableYear, f0: Asset, a0: Money) defeasible {
    label en official "the sum over the owned facilities";
    when coal_increase_of_owner_45(f0, taxpayer, y, a0);
    then coal_increase_before_apportionment_45(taxpayer, y,
        sum(collect all a: Money, f: Asset where coal_increase_of_owner_45(f, taxpayer, y, a), empty: 0.00 USD));
}
pub relation coal_increase_credit_45(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase of the taxpayer after the apportionment between an estate or trust and its beneficiaries (rule similar to section 52(d), by section 45(e)(5)): the increase less the parts apportioned plus the parts received; cents HALF_UP";
}
@source(IRC_S45_E, quote = "Rules similar to the rules of the subsection (b)(3) and paragraphs (1) through (5) of this subsection shall apply for purposes of determining the amount of any increase under this paragraph.")
rule CoalIncreaseCreditOwn45(taxpayer: Person, y: TaxableYear, total: Money) defeasible {
    label en official "own increase less the apportioned parts plus the received parts ((e)(8)(C), (10)(C), by (e)(5))";
    when coal_increase_before_apportionment_45(taxpayer, y, total);
    then coal_increase_credit_45(taxpayer, y, total
        - sum(collect all x: Money, b: Person, s: Decimal where section_52d_income_allocable_share(taxpayer, b, y, s) and x == round(total * s, 2, "HALF_UP"), empty: 0.00 USD)
        + sum(collect all r: Money, e: Person, s2: Decimal, t: Money where section_52d_income_allocable_share(e, taxpayer, y, s2) and coal_increase_before_apportionment_45(e, y, t) and r == round(t * s2, 2, "HALF_UP"), empty: 0.00 USD));
}
relation has_coal_increase_before_apportionment_45(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasCoalIncreaseBeforeApportionment45(taxpayer: Person, y: TaxableYear, a: Money) defeasible {
    label en official "bridge for the absence test";
    when coal_increase_before_apportionment_45(taxpayer, y, a);
    then has_coal_increase_before_apportionment_45(taxpayer, y);
}
rule CoalIncreaseCreditReceivedOnly45(taxpayer: Person, y: TaxableYear, e0: Person, s0: Decimal) defeasible {
    label en official "a beneficiary with no increase of its own receives the apportioned parts ((e)(8)(C), (10)(C), by (e)(5))";
    when section_52d_income_allocable_share(e0, taxpayer, y, s0);
    when not_known(has_coal_increase_before_apportionment_45(taxpayer, y));
    then coal_increase_credit_45(taxpayer, y,
        sum(collect all r: Money, e: Person, s2: Decimal, t: Money where section_52d_income_allocable_share(e, taxpayer, y, s2) and coal_increase_before_apportionment_45(e, y, t) and r == round(t * s2, 2, "HALF_UP"), empty: 0.00 USD));
}
