// Sections 45E and 45T — Small employer pension plan startup costs; the
// retirement auto-enrollment credit. Stage 2c (IRC-06 stage 2c,
// DECISION-0379). Priority list item: §45E ($5,000 startup with the
// $250xNHCE rule, 50%/100%, "(e) $500 auto-enrollment").
//
// CORRECTION to the task's own framing: the $500 auto-enrollment credit is
// NOT codified at section 45E(e) in the pinned 2024 Edition text — section
// 45E(e) is "Special rules" (aggregation under section 52, deduction
// disallowance, an election OUT of the section, and the (e)(4) 50-vs-100-
// employee increased-rate test). The $500 credit is its OWN section, 45T
// ("Auto-enrollment option for retirement savings options provided by
// small employers", 8 disposition rows, also owned by this package) —
// confirmed by grepping this package's own `sources.law` (section 45T(a)
// reads "$500 for any taxable year occurring during the credit period").
// Both sections are modelled together here since 45T(c) cross-references
// the SAME "eligible employer" definition (section 408(p)(2)(C)(i)) as
// 45E(c)(1) — a single shared relation, `eligible_employer_408p2c1`, feeds
// both.
//
// Judgment calls / scope:
// * Section 408(p)(2)(C)(i) ("eligible employer": no more than 100
//   employees who received at least $5,000 of compensation from the
//   employer for the preceding year) is not modelled anywhere in
//   `us.irc.*` — `eligible_employer_408p2c1` is a case-asserted dependency
//   contract (owner: a not-yet-built section 408 module, candidate package
//   `us.irc.deferred-compensation`).
// * Section 45E(c)(2) (the 3-taxable-year "no predecessor plan for
//   substantially the same employees" new-plan requirement) is a case-
//   asserted classification, not derived (needs a controlled-group
//   employment history this package does not carry).
// * Section 45E(d)(1) ("qualified startup costs": ordinary and necessary
//   expenses for plan establishment/administration or employee retirement
//   education, EXCLUDING plans with no NHCE participant) is modelled with
//   the (d)(1)(B) at-least-one-NHCE-participant gate as an executable
//   classification; the ordinary-and-necessary evaluative judgment itself
//   is read as already reflected in the case-asserted expense AMOUNT
//   (same convention as this package's other "qualified expenditures" case
//   facts, e.g. section 25C's analogue).
// * Section 45E(d)(2) ("eligible employer plan", section 4972(d)) and
//   section 45E(d)(3) ("first credit year", including the (B) election of
//   the PRECEDING taxable year) are modelled: (d)(3)(B)'s election is a
//   genuine POWER (the employer changes which year is the first credit
//   year, a legal-relation change, not a mere classification).
// * Section 45E(e)(1) (aggregation: all persons treated as one employer
//   under section 52(a)/(b), all eligible employer plans treated as one
//   plan) is NOT wired into a merged qualified-startup-costs total this
//   pass — TECH-GAPS G391 (would need a controlled-group-wide SUM over
//   this package's own new section 52 relations, a genuine aggregate-over-
//   derived-predicate limitation, §111).
// * Section 45E(e)(2) (deduction disallowance) is EXTERNAL_DEPENDENCY — the
//   deduction side lives in `us.irc.deductions`, not imported here.
// * Section 45E(f) (additional credit for employer contributions): the
//   (f)(3) applicable-percentage table is a genuine `.lawtable.json`
//   (`45e-applicable-percentage.lawtable.json`, mirroring this package's
//   own section 50 recapture-table idiom). The (f)(2)(A) $1,000-per-
//   employee cap and (f)(2)(C) $100,000 (2023 base, section 1(f)(3)-indexed
//   thereafter) wage limitation are NOT separately derived per-employee —
//   `qualifying_employer_contributions_45e_f` is a case-asserted amount
//   read as ALREADY net of both per-employee limitations (same "the case
//   pre-computes the population" convention as section 45R's contribution
//   inputs); only the (f)(2)(B) 50-employee phase-in reduction is modelled
//   as its own exact rule, since the coordinator's instruction singles out
//   exact phase-out computations as the priority. The indexed $100,000
//   figure has NO Revenue Procedure fragment pinned anywhere in `us.irc.
//   inflation_adjustments` (grepped, confirmed absent) — SOURCE_GAP,
//   TECH-GAPS G391, not fabricated.
// * Section 45T(b)(1) (the credit-period start year, tied to the FIRST
//   taxable year an EACA is included) is a case-asserted anchor year rather
//   than derived from a chronological search — TECH_GAP, same class as
//   this package's other "earliest year" gaps (TECH-GAPS G136-class).

use self::{
    IRC_S45E_A,
    IRC_S45E_B,
    IRC_S45E_D,
    IRC_S45E_E,
    IRC_S45E_F,
    IRC_S45T_A,
    Person,
    TaxableYear,
    employer_excluded_by_prior_plan_45e_c2,
    preceding_taxable_year_of,
};

pub relation eligible_employer_408p2c1(employer: Person, y: TaxableYear) kind institutional {
    label en official "employer is an 'eligible employer' within the meaning of section 408(p)(2)(C)(i) (no more than 100 employees who received at least $5,000 of compensation for the preceding year) — read from the owner `us.irc.deferred_compensation` (WIRE-7; the section 408(p)(2)(C)(i) test is the owner's), shared by sections 45E(c)(1) and 45T(c)";
}

// --- §45E(d): qualified startup costs -----------------------------------------

pub relation qualified_startup_costs_expense(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "ordinary and necessary expenses of an eligible employer paid or incurred in connection with plan establishment/administration or employee retirement-related education (section 45E(d)(1)(A)) — case-asserted";
}
pub relation eligible_employer_plan_has_nhce_participant(employer: Person, y: TaxableYear) kind empirical {
    label en official "the eligible employer plan has at least 1 employee eligible to participate who is not a highly compensated employee (section 45E(d)(1)(B) gate) — case-asserted";
}
pub relation qualified_startup_costs(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45E(d)(1): qualified startup costs, gated by the at-least-1-NHCE-participant requirement of (d)(1)(B)";
}
@source(IRC_S45E_D, quote = "Such term shall not include any expense in connection with a plan that does not have at least 1 employee eligible to participate who is not a highly compensated employee.")
rule QualifiedStartupCostsRule(employer: Person, y: TaxableYear, amount: Money) strict {
    when qualified_startup_costs_expense(employer, y, amount);
    when eligible_employer_plan_has_nhce_participant(employer, y);
    when not_known(employer_excluded_by_prior_plan_45e_c2(employer, y));
    then qualified_startup_costs(employer, y, amount);
}

// --- §45E(d)(3): first credit year, including the election of the preceding year ---

pub relation eligible_employer_plan_effective_date_year(employer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year that includes the date the eligible employer plan becomes effective with respect to the employer (section 45E(d)(3)(A)) — case-asserted";
}
pub relation elects_preceding_year_as_first_credit_year(employer: Person, effective_year: TaxableYear, preceding_year: TaxableYear) kind empirical {
    label en official "the employer's exercise of the section 45E(d)(3)(B) election to treat the taxable year PRECEDING the plan's effective-date year as the first credit year";
}
pub relation first_credit_year_45e(employer: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year that is the section 45E(d)(3) 'first credit year' for the employer's plan";
}
@source(IRC_S45E_D, quote = "the taxable year which includes the date that the eligible employer plan to which such costs relate becomes effective with respect to the eligible employer")
rule FirstCreditYearDefaultRule(employer: Person, y: TaxableYear) defeasible {
    when eligible_employer_plan_effective_date_year(employer, y);
    then first_credit_year_45e(employer, y);
}
@source(IRC_S45E_D, quote = "at the election of the eligible employer, the taxable year preceding the taxable year referred to in subparagraph (A)")
rule FirstCreditYearElectedPrecedingRule(employer: Person, effective_year: TaxableYear, preceding_year: TaxableYear) strict {
    when eligible_employer_plan_effective_date_year(employer, effective_year);
    when preceding_taxable_year_of(effective_year, preceding_year);
    then power Section45eD3PrecedingYearElection {
        holder employer;
        over employer;
        exercise elects_preceding_year_as_first_credit_year(employer, effective_year, preceding_year);
        valid_when eligible_employer_plan_effective_date_year(employer, effective_year);
        effect create(first_credit_year_45e(employer, preceding_year));
        window [@2002-01-01, infinity);
    };
}

// --- §45E(b): dollar limitation ------------------------------------------------

pub relation within_first_three_credit_years_45e(employer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is the first credit year or one of the 2 immediately following taxable years (section 45E(b)(1)) — case-asserted (a 3-year-window derivation from first_credit_year_45e, not chained by this module's own rule graph)";
}
pub relation nhce_participant_count(employer: Person, y: TaxableYear, count: Decimal) kind empirical {
    label en official "the number of employees of the eligible employer who are not highly compensated employees (section 414(q)) and are eligible to participate in the plan (section 45E(b)(1)(B)(i)) — case-asserted";
}
pub relation dollar_limitation_45e(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45E(b): the dollar limitation on the credit — the greater of $500 or the lesser of ($250 times the NHCE count, $5,000) for the first 3 credit years, zero thereafter";
}
@source(IRC_S45E_B, quote = "for the first credit year and each of the 2 taxable years immediately following the first credit year, the greater of—\n(A) $500, or\n(B) the lesser of—\n(i) $250 for each employee of the eligible employer who is not a highly compensated employee (as defined in section 414(q)) and who is eligible to participate in the eligible employer plan maintained by the eligible employer, or\n(ii) $5,000")
rule DollarLimitationWithinPeriodRule(employer: Person, y: TaxableYear, count: Decimal) strict {
    when within_first_three_credit_years_45e(employer, y);
    when nhce_participant_count(employer, y, count);
    then dollar_limitation_45e(employer, y, max(500.00 USD, min(round(250.00 USD * count, 2, "HALF_UP"), 5000.00 USD)));
}
@source(IRC_S45E_B, quote = "zero for any other taxable year")
rule DollarLimitationOutsidePeriodRule(employer: Person, y: TaxableYear) defeasible {
    when qualified_startup_costs(employer, y, _);
    when not_known(within_first_three_credit_years_45e(employer, y));
    then dollar_limitation_45e(employer, y, 0 USD);
}

// --- §45E(e)(4): increased 100-percent rate for smaller employers -------------

pub relation would_be_eligible_at_50_employees_45e(employer: Person, y: TaxableYear) kind empirical {
    label en official "employer would be an eligible employer under section 45E(c) if section 408(p)(2)(C)(i) were applied by substituting '50 employees' for '100 employees' (section 45E(e)(4)) — case-asserted";
}

// --- §45E(e)(3): election not to claim the credit ------------------------------

pub relation elects_out_of_section_45e(employer: Person, y: TaxableYear) kind empirical {
    label en official "the employer's exercise of the section 45E(e)(3) election to have this section not apply for the taxable year";
}
pub relation section_45e_does_not_apply(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45E(e)(3): this section does not apply to the employer for the taxable year (a valid election-out)";
}
@source(IRC_S45E_E, quote = "This section shall not apply to a taxpayer for any taxable year if such taxpayer elects to have this section not apply for such taxable year.")
rule ElectOutOf45eRule(employer: Person, y: TaxableYear) strict {
    when eligible_employer_408p2c1(employer, y);
    then power Section45eE3ElectOut {
        holder employer;
        over employer;
        exercise elects_out_of_section_45e(employer, y);
        valid_when eligible_employer_408p2c1(employer, y);
        effect create(section_45e_does_not_apply(employer, y));
        window [@2002-01-01, infinity);
    };
}

// --- §45E(a): allowance of credit -----------------------------------------------

pub relation startup_cost_credit_before_limitation(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "50 percent (100 percent under section 45E(e)(4) for a smaller eligible employer) of qualified startup costs, before the section 45E(b) dollar limitation";
}
@source(IRC_S45E_A, quote = "For purposes of section 38, in the case of an eligible employer, the small employer pension plan startup cost credit determined under this section for any taxable year is an amount equal to 50 percent of the qualified startup costs paid or incurred by the taxpayer during the taxable year.")
rule StartupCostCreditBeforeLimitationGeneralRule(employer: Person, y: TaxableYear, costs: Money) strict {
    when qualified_startup_costs(employer, y, costs);
    when not would_be_eligible_at_50_employees_45e(employer, y);
    then startup_cost_credit_before_limitation(employer, y, round(0.50 * costs, 2, "HALF_UP"));
}
@source(IRC_S45E_E, quote = "In the case of an employer which would be an eligible employer under subsection (c) if section 408(p)(2)(C)(i) was applied by substituting \"50 employees\" for \"100 employees\", subsection (a) shall be applied by substituting \"100 percent\" for \"50 percent\".")
rule StartupCostCreditBeforeLimitationSmallEmployerRule(employer: Person, y: TaxableYear, costs: Money) strict {
    when qualified_startup_costs(employer, y, costs);
    when would_be_eligible_at_50_employees_45e(employer, y);
    then startup_cost_credit_before_limitation(employer, y, costs);
}

pub relation small_employer_pension_plan_startup_cost_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45E small employer pension plan startup cost credit determined under section 38 for the taxable year: the lesser of the section 45E(b) dollar limitation and the (a)/(e)(4) rate applied to qualified startup costs, unless the employer has validly elected out under (e)(3)";
}
@source(IRC_S45E_A, quote = "the small employer pension plan startup cost credit determined under this section for any taxable year")
rule SmallEmployerPensionPlanStartupCostCreditRule(employer: Person, y: TaxableYear, before: Money, limit: Money) defeasible {
    when startup_cost_credit_before_limitation(employer, y, before);
    when dollar_limitation_45e(employer, y, limit);
    when not_known(section_45e_does_not_apply(employer, y));
    then small_employer_pension_plan_startup_cost_credit(employer, y, min(before, limit));
}

// --- §45E(f): additional credit for employer contributions --------------------

relation applicable_percentage_45e_f3(plan_year_number: Decimal, pct: Decimal) kind institutional;

pub relation qualifying_employer_contributions_45e_f(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "employer contributions (other than elective deferrals, other than to a defined benefit plan) to an eligible employer plan, ALREADY net of the section 45E(f)(2)(A) $1,000-per-employee cap and the (f)(2)(C) wage-limitation exclusion — case-asserted (the per-employee derivation itself is TECH_GAP, TECH-GAPS G391)";
}
pub relation plan_year_number_45e(employer: Person, y: TaxableYear, n: Decimal) kind empirical {
    label en official "the taxable-year ordinal since the eligible employer plan was established (1 = the year of establishment), for the section 45E(f)(3) applicable-percentage table — case-asserted";
}
pub relation additional_credit_45e_f_before_phasein(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45E(f)(1): the applicable percentage of qualifying employer contributions, before the section 45E(f)(2)(B) phase-in reduction";
}
@source(IRC_S45E_F, quote = "the credit allowed for the taxable year under subsection (a) (determined without regard to this subsection) shall be increased by an amount equal to the applicable percentage of employer contributions")
rule AdditionalCredit45eFBeforePhaseinRule(employer: Person, y: TaxableYear, n: Decimal, pct: Decimal, contributions: Money) strict {
    when plan_year_number_45e(employer, y, n);
    when applicable_percentage_45e_f3(n, pct);
    when qualifying_employer_contributions_45e_f(employer, y, contributions);
    then additional_credit_45e_f_before_phasein(employer, y, round(pct * contributions, 2, "HALF_UP"));
}

pub relation preceding_year_employee_count_45e(employer: Person, y: TaxableYear, count: Decimal) kind empirical {
    label en official "the number of employees of the employer for the PRECEDING taxable year, for the section 45E(f)(2)(B) phase-in test — case-asserted";
}
relation preceding_year_employee_count_over_50_45e(employer: Person, y: TaxableYear) kind institutional;
rule PrecedingYearEmployeeCountOver50Rule(employer: Person, y: TaxableYear, count: Decimal) strict {
    when preceding_year_employee_count_45e(employer, y, count);
    when count > 50.0;
    then preceding_year_employee_count_over_50_45e(employer, y);
}
pub relation additional_credit_45e_f_phasein_reduction(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45E(f)(2)(B): the phase-in reduction for an employer with more than 50 employees in the preceding taxable year — 2 percentage points for each employee over 50";
}
@source(IRC_S45E_F, quote = "the amount otherwise so determined under paragraph (1), multiplied by\n(ii) a percentage equal to 2 percentage points for each employee of the employer for the preceding taxable year in excess of 50 employees")
rule AdditionalCredit45eFPhaseinReductionRule(employer: Person, y: TaxableYear, before: Money, count: Decimal) strict {
    when additional_credit_45e_f_before_phasein(employer, y, before);
    when preceding_year_employee_count_45e(employer, y, count);
    when preceding_year_employee_count_over_50_45e(employer, y);
    then additional_credit_45e_f_phasein_reduction(employer, y, round(before * (0.02 * (count - 50.0)), 2, "HALF_UP"));
}
pub relation additional_credit_45e_f_phasein_reduction_or_zero(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45E(f)(2)(B) phase-in reduction, or zero when the preceding year's employee count does not exceed 50";
}
rule AdditionalCredit45eFPhaseinPresentRule(employer: Person, y: TaxableYear, amount: Money) defeasible {
    when additional_credit_45e_f_phasein_reduction(employer, y, amount);
    then additional_credit_45e_f_phasein_reduction_or_zero(employer, y, amount);
}
rule AdditionalCredit45eFPhaseinAbsentRule(employer: Person, y: TaxableYear) defeasible {
    when additional_credit_45e_f_before_phasein(employer, y, _);
    when not_known(preceding_year_employee_count_over_50_45e(employer, y));
    then additional_credit_45e_f_phasein_reduction_or_zero(employer, y, 0 USD);
}
pub relation additional_credit_45e_f(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45E(f) additional credit for employer contributions, after the phase-in reduction";
}
@source(IRC_S45E_F, quote = "In the case of any eligible employer which had for the preceding taxable year more than 50 employees, the amount determined under paragraph (1) (without regard to this subparagraph) shall be reduced")
rule AdditionalCredit45eFRule(employer: Person, y: TaxableYear, before: Money, reduction: Money) defeasible {
    when additional_credit_45e_f_before_phasein(employer, y, before);
    when additional_credit_45e_f_phasein_reduction_or_zero(employer, y, reduction);
    then additional_credit_45e_f(employer, y, max(0 USD, before - reduction));
}

// --- §45T: retirement auto-enrollment credit -----------------------------------

pub relation eligible_automatic_contribution_arrangement_included(employer: Person, y: TaxableYear) kind empirical {
    label en official "the employer includes an eligible automatic contribution arrangement (section 414(w)(3)) in a qualified employer plan (section 4972(d)) for the taxable year (section 45T(b)(1)/(2)) — case-asserted";
}
pub relation within_credit_period_45t(employer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year falls within the employer's section 45T(b)(1) 3-taxable-year credit period AND the section 414(w)(3) arrangement is maintained for the year per (b)(2) — case-asserted (the credit-period-window derivation from a first-year anchor is TECH_GAP, same class as TECH-GAPS G136; a scenario supplying this fact is expected to also assert eligible_automatic_contribution_arrangement_included for the same year, mirroring (b)(2)'s own maintenance requirement, though the two are not cross-checked by a rule this pass)";
}
pub relation retirement_auto_enrollment_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45T retirement auto-enrollment credit determined under section 38: $500 for a taxable year occurring during the section 45T(b) credit period of an eligible employer, zero otherwise";
}
@source(IRC_S45T_A, quote = "For purposes of section 38, in the case of an eligible employer, the retirement auto-enrollment credit determined under this section for any taxable year is an amount equal to—\n(1) $500 for any taxable year occurring during the credit period, and\n(2) zero for any other taxable year.")
rule RetirementAutoEnrollmentCreditRule(employer: Person, y: TaxableYear) strict {
    when eligible_employer_408p2c1(employer, y);
    when within_credit_period_45t(employer, y);
    then retirement_auto_enrollment_credit(employer, y, 500.00 USD);
}
