// Stage 4 (DECISION-0379 with deontics), credits, part C: two "rules similar to"
// sections written out. Closes the two rows of G6425.
//
// SECTION 43(c)(3): the at-risk limitation of section 49(a)(1), (a)(2) and (b) applied to
// qualified enhanced oil recovery costs. The target rules exist (module 49) but are keyed to a
// PROPERTY and its credit base; here the costs are the base of a qualified enhanced oil
// recovery PROJECT (an `Asset`) and the same relations of module 49 (the nonqualified
// nonrecourse financing of the project, the net decrease, the net increase) are READ by
// explicit reference; nothing of module 49 is copied. The credit of module 43 now reads
// `qualified_eor_costs_for_credit_43` (the asserted costs when no project link is asserted).
//
// SECTION 35(g)(6): the marital status rules of section 21(e)(3), (4), written for the
// health coverage tax credit: a legally separated individual is not considered married;
// a married individual living apart under the (e)(4) conditions is not considered married.
// (Section 21 itself asserts marital facts; the rules are stated here for section 35, the
// spouse test of (g)(5) reads them.)

// ===================== 43(c)(3): the at-risk limitation =====================

use self::{
    Asset,
    IRC_S35_G,
    IRC_S43_C,
    Individual,
    Person,
    TaxableYear,
    credit_decrease_from_financing_increase_49,
    files_separate_return_35,
    has_nonqualified_financing_49,
    married_at_close_of_year_35,
    net_decrease_of_nonqualified_financing_49,
    net_increase_of_nonqualified_financing_49,
    nonqualified_nonrecourse_financing_49,
    qualified_enhanced_oil_recovery_costs,
    taxpayer_and_activity_subject_to_465_49,
};

pub relation eor_project_of_costs_43(taxpayer: Person, y: TaxableYear, project: Asset) kind empirical {
    label en official "the qualified enhanced oil recovery project whose costs the taxpayer bears for the taxable year, the property to which the at-risk rules of section 49 are applied (section 43(c)(3))";
}
relation eor_project_link_present_43(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a project link is asserted for the year";
}
rule EorProjectLinkPresent43(taxpayer: Person, y: TaxableYear, project: Asset) defeasible {
    label en official "bridge for the absence test";
    when eor_project_of_costs_43(taxpayer, y, project);
    then eor_project_link_present_43(taxpayer, y);
}
pub relation eor_costs_after_at_risk_reduction_43c3(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified enhanced oil recovery costs reduced by the nonqualified nonrecourse financing of the project, as of the close of the year, when the taxpayer and the activity are subject to section 465 (rule similar to section 49(a)(1))";
}
@source(IRC_S43_C, quote = "For purposes of determining qualified enhanced oil recovery costs, rules similar to the rules of section 49(a)(1), section 49(a)(2), and section 49(b) shall apply.")
rule EorCostsReducedByNonqualifiedFinancing43(taxpayer: Person, y: TaxableYear, project: Asset, costs: Money, nonqualified: Money) defeasible {
    label en official "costs - nonqualified nonrecourse financing of the project (section 43(c)(3), by section 49(a)(1))";
    when qualified_enhanced_oil_recovery_costs(taxpayer, y, costs);
    when eor_project_of_costs_43(taxpayer, y, project);
    when taxpayer_and_activity_subject_to_465_49(taxpayer, project);
    when nonqualified_nonrecourse_financing_49(project, nonqualified);
    then eor_costs_after_at_risk_reduction_43c3(taxpayer, y, max(0 USD, costs - nonqualified));
}
rule EorCostsNoNonqualifiedFinancing43(taxpayer: Person, y: TaxableYear, project: Asset, costs: Money) defeasible {
    label en official "the project is subject to section 465 but has no nonqualified nonrecourse financing: the costs stand";
    when qualified_enhanced_oil_recovery_costs(taxpayer, y, costs);
    when eor_project_of_costs_43(taxpayer, y, project);
    when taxpayer_and_activity_subject_to_465_49(taxpayer, project);
    when not_known(has_nonqualified_financing_49(project));
    then eor_costs_after_at_risk_reduction_43c3(taxpayer, y, costs);
}
rule EorCostsNotSubjectToSection465(taxpayer: Person, y: TaxableYear, project: Asset, costs: Money) defeasible {
    label en official "the taxpayer and the activity are not subject to section 465: the costs stand";
    when qualified_enhanced_oil_recovery_costs(taxpayer, y, costs);
    when eor_project_of_costs_43(taxpayer, y, project);
    when not_known(taxpayer_and_activity_subject_to_465_49(taxpayer, project));
    then eor_costs_after_at_risk_reduction_43c3(taxpayer, y, costs);
}
relation eor_financing_decrease_present_43(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a net decrease of nonqualified nonrecourse financing of the project is asserted for the year";
}
rule EorFinancingDecreasePresent43(taxpayer: Person, y: TaxableYear, project: Asset, decrease: Money) defeasible {
    label en official "bridge for the absence test";
    when eor_project_of_costs_43(taxpayer, y, project);
    when net_decrease_of_nonqualified_financing_49(taxpayer, project, y, decrease);
    then eor_financing_decrease_present_43(taxpayer, y);
}
pub relation qualified_eor_costs_for_credit_43(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified enhanced oil recovery costs the section 43(a) credit is computed on: after the at-risk reduction, plus the net decrease of the nonqualified nonrecourse financing of the project treated as costs of the year of the decrease (rules similar to section 49(a)(1), (a)(2))";
}
@source(IRC_S43_C, quote = "For purposes of determining qualified enhanced oil recovery costs, rules similar to the rules of section 49(a)(1), section 49(a)(2), and section 49(b) shall apply.")
rule QualifiedEorCostsWithFinancingDecrease43(taxpayer: Person, y: TaxableYear, project: Asset, reduced: Money, decrease: Money) defeasible {
    label en official "reduced costs + the net decrease of the nonqualified financing (section 43(c)(3), by section 49(a)(2))";
    when eor_costs_after_at_risk_reduction_43c3(taxpayer, y, reduced);
    when eor_project_of_costs_43(taxpayer, y, project);
    when net_decrease_of_nonqualified_financing_49(taxpayer, project, y, decrease);
    then qualified_eor_costs_for_credit_43(taxpayer, y, reduced + decrease);
}
rule QualifiedEorCostsWithoutFinancingDecrease43(taxpayer: Person, y: TaxableYear, reduced: Money) defeasible {
    label en official "no net decrease: the reduced costs";
    when eor_costs_after_at_risk_reduction_43c3(taxpayer, y, reduced);
    when not_known(eor_financing_decrease_present_43(taxpayer, y));
    then qualified_eor_costs_for_credit_43(taxpayer, y, reduced);
}
rule QualifiedEorCostsWithoutProjectLink43(taxpayer: Person, y: TaxableYear, costs: Money) defeasible {
    label en official "no project is asserted: the asserted costs stand (the earlier channel)";
    when qualified_enhanced_oil_recovery_costs(taxpayer, y, costs);
    when not_known(eor_project_link_present_43(taxpayer, y));
    then qualified_eor_costs_for_credit_43(taxpayer, y, costs);
}
pub relation eor_at_risk_recapture_tax_increase_43c3(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax for the year is increased by the aggregate decrease of the credits that a net increase of nonqualified nonrecourse financing of the project would have produced (rule similar to section 49(b)(1)); the increase is not tax imposed by chapter 1 for the amount of any credit (49(b)(4))";
}
@source(IRC_S43_C, quote = "For purposes of determining qualified enhanced oil recovery costs, rules similar to the rules of section 49(a)(1), section 49(a)(2), and section 49(b) shall apply.")
rule EorAtRiskRecaptureTaxIncrease43c3(taxpayer: Person, y: TaxableYear, project: Asset, decrease: Money) defeasible {
    label en official "a net increase of the project's nonqualified financing recaptures the credit decrease (section 43(c)(3), by section 49(b)(1))";
    when eor_project_of_costs_43(taxpayer, y, project);
    when net_increase_of_nonqualified_financing_49(taxpayer, project, y);
    when credit_decrease_from_financing_increase_49(taxpayer, project, y, decrease);
    then eor_at_risk_recapture_tax_increase_43c3(taxpayer, project, y, decrease);
}

// ===================== 35(g)(6): marital status (rules similar to 21(e)(3), (4)) =====================

pub relation legally_separated_under_decree_35g6(person: Individual) kind empirical {
    label en official "the individual is legally separated from the spouse under a decree of divorce or of separate maintenance (rule similar to section 21(e)(3))";
}
pub relation maintains_household_for_qualifying_family_member_more_than_half_year_35g6(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the individual maintains as his home a household which for more than one-half of the taxable year is the principal place of abode of a qualifying family member (rule similar to section 21(e)(4)(A)(i))";
}
pub relation furnishes_over_half_of_household_cost_35g6(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the individual furnishes over half of the cost of maintaining the household during the taxable year (rule similar to section 21(e)(4)(A)(ii))";
}
pub relation spouse_not_member_of_household_last_six_months_35g6(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "during the last 6 months of the taxable year the individual's spouse is not a member of the household (rule similar to section 21(e)(4)(B))";
}
pub relation not_considered_married_35g6(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "the individual is not considered married for section 35: legally separated under a decree, or a married individual filing a separate return living apart under the section 21(e)(4) conditions";
}
@source(IRC_S35_G, quote = "Rules similar to the rules of paragraphs (3) and (4) of section 21(e) shall apply for purposes of this section.")
rule NotConsideredMarriedWhenLegallySeparated35g6(taxpayer: Individual, y: TaxableYear) strict {
    label en official "an individual legally separated under a decree of divorce or of separate maintenance is not considered married (section 35(g)(6), by section 21(e)(3))";
    when legally_separated_under_decree_35g6(taxpayer);
    when married_at_close_of_year_35(taxpayer, y);
    then not_considered_married_35g6(taxpayer, y);
}
@source(IRC_S35_G, quote = "Rules similar to the rules of paragraphs (3) and (4) of section 21(e) shall apply for purposes of this section.")
rule NotConsideredMarriedWhenLivingApart35g6(taxpayer: Individual, y: TaxableYear) strict {
    label en official "a married individual filing separately who maintains the household and furnishes over half of its cost while the spouse is absent the last 6 months is not considered married (section 35(g)(6), by section 21(e)(4))";
    when married_at_close_of_year_35(taxpayer, y);
    when files_separate_return_35(taxpayer, y);
    when maintains_household_for_qualifying_family_member_more_than_half_year_35g6(taxpayer, y);
    when furnishes_over_half_of_household_cost_35g6(taxpayer, y);
    when spouse_not_member_of_household_last_six_months_35g6(taxpayer, y);
    then not_considered_married_35g6(taxpayer, y);
}
pub relation considered_married_at_close_of_year_35g6(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "the individual is married at the close of the taxable year and is considered married for section 35 after the marital status rules of (g)(6)";
}
rule ConsideredMarriedAtCloseOfYear35g6(taxpayer: Individual, y: TaxableYear) strict {
    label en official "married and not excepted by the (g)(6) rules";
    when married_at_close_of_year_35(taxpayer, y);
    when not_known(not_considered_married_35g6(taxpayer, y));
    then considered_married_at_close_of_year_35g6(taxpayer, y);
}
