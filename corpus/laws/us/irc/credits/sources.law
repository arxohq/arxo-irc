    locator "section/48C/f";
    text en official """(f) Denial of double benefit
A credit shall not be allowed under this section for any qualified investment for which a credit is allowed under section 48, 48A, 48B, 48E, 45Q, or 45V.""";
    content_hash "sha256:d2a3b45b4d31bba1169bdfb0269ceed12786d305af4469516ba795bd34172788";
