// 26 U.S.C. 45P(a) — Employer wage credit for employees who are active duty members of the uniformed services
fragment IRC_S45P_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/45P/a";
    text en official """(a) General rule
For purposes of section 38, the differential wage payment credit for any taxable year is an amount equal to 20 percent of the sum of the eligible differential wage payments for each of the qualified employees of the taxpayer during such taxable year.""";
    content_hash "sha256:a8b7bceb9b89389a8c6cac1f2771b0046bbdc1c8b89865dc55f9e2294672ba1e";
}

// 26 U.S.C. 45P(b) — Employer wage credit for employees who are active duty members of the uniformed services
fragment IRC_S45P_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/45P/b";
    text en official """(b) Definitions
For purposes of this section—
(1) Eligible differential wage payments
The term "eligible differential wage payments" means, with respect to each qualified employee, so much of the differential wage payments (as defined in section 3401(h)(2)) paid to such employee for the taxable year as does not exceed $20,000.
(2) Qualified employee
The term "qualified employee" means a person who has been an employee of the taxpayer for the 91-day period immediately preceding the period for which any differential wage payment is made.
(3) Controlled groups
All persons treated as a single employer under subsection (b), (c), (m), or (o) of section 414 shall be treated as a single employer.""";
    content_hash "sha256:d6852d1f6feee192589f55605af2a0ac6a429f7ef88428e3360defbae531a46d";
}

// 26 U.S.C. 45P(c) — Employer wage credit for employees who are active duty members of the uniformed services
fragment IRC_S45P_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/45P/c";
    text en official """(c) Coordination with other credits
The amount of credit otherwise allowable under this chapter with respect to compensation paid to any employee shall be reduced by the credit determined under this section with respect to such employee.""";
    content_hash "sha256:bdf0afe41e00eb2f03fe3b058fe750be3a511fef8316aff7a620793234e30a6e";
}

// 26 U.S.C. 45P(d) — Employer wage credit for employees who are active duty members of the uniformed services
fragment IRC_S45P_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/45P/d";
    text en official """(d) Disallowance for failure to comply with employment or reemployment rights of members of the reserve components of the Armed Forces of the United States
No credit shall be allowed under subsection (a) to a taxpayer for—
(1) any taxable year, beginning after the date of the enactment of this section, in which the taxpayer is under a final order, judgment, or other process issued or required by a district court of the United States under section 4323 of title 38 of the United States Code with respect to a violation of chapter 43 of such title, and
(2) the 2 succeeding taxable years.""";
    content_hash "sha256:83410121a9229a23a5468b489bd088de71e7ac24c3ae308aa0205e9544b0c6a9";
}

// 26 U.S.C. 45P(e) — Employer wage credit for employees who are active duty members of the uniformed services
fragment IRC_S45P_E in IRC_2024_EDITION {
    kind subsection;
    locator "section/45P/e";
    text en official """(e) Certain rules to apply
For purposes of this section, rules similar to the rules of subsections (c), (d), and (e) of section 52 shall apply.""";
    content_hash "sha256:4d7c1e57f6e80e1d6a33a3e25e54fa57e6d02890dd998c732f5338ad9dae3cc8";
}

// 26 U.S.C. §45P — statutory note 5 (effectivedate-amendment-note)
