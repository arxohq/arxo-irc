    locator "section/45T/c";
    text en official """(c) Eligible employer
For purposes of this section, the term "eligible employer" has the meaning given such term in section 408(p)(2)(C)(i).""";
    content_hash "sha256:1a5f5c1413870039a06bfaea4931a0dacddc242bfbabb80c527ec336225aeb8b";
