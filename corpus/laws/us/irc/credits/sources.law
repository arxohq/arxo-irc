// 26 U.S.C. 48B(a) — Qualifying gasification project credit
fragment IRC_S48B_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/48B/a";
    text en official """(a) In general
For purposes of section 46, the qualifying gasification project credit for any taxable year is an amount equal to 20 percent (30 percent in the case of credits allocated under subsection (d)(1)(B)) of the qualified investment for such taxable year.""";
    content_hash "sha256:c8771d99a2c9d8fd89714f360bfcdbd81f593f7cfea24beccca6bc543a1d540a";
