// Section 30C — Alternative fuel vehicle refueling property credit. Stage 2d
// (IRC-06, DECISION-0379).
//
// Editions by `legal_time` (`effective` windows; PL 119-21 section 70504 is
// pinned as `us.irc.temporal::PL119_21_S70504`, enacted 2025-07-04): the 2024
// text ends the credit for property placed in service after 2032-12-31; from
// 2025-07-04 property placed in service after 2026-06-30 is excluded.
//
// Scope / judgment calls:
// * (a): 30 percent (6 percent for property of a character subject to
//   depreciation) of the cost; (b): at most $100,000 per item of depreciable
//   property and $1,000 otherwise; (g): the 6 percent is multiplied by 5 (30
//   percent) when the project meets the prevailing wage requirement (one case
//   fact).
// * (c)(3): the property must be placed in service in an eligible census tract:
//   a low-income community under section 45D(e) (this package's
//   `low_income_community_45d`) or a tract that is not an urban area (case
//   fact).
// * (d)(1): the credit attributable to depreciable property is a section 38(b)
//   credit (section 38(b)(25)), the rest is a personal credit; the (d)(2)
//   limitation of the personal credit is not computed (TECH-GAPS G1792).
// * (e)(3): no credit for property under section 50(b)(1) or the part expensed
//   under section 179; (e)(4): the election not to apply the section to an item
//   is a power.

use self::{
    Asset,
    IRC_S30C_A,
    IRC_S30C_B,
    IRC_S30C_C,
    IRC_S30C_D,
    IRC_S30C_E,
    IRC_S30C_G,
    IRC_S30C_I,
    Person,
    TaxableYear,
    low_income_community_45d,
};

pub relation qualified_refueling_property_30c(item: Asset) kind empirical {
    label en official "the property is qualified alternative fuel vehicle refueling property: it would be qualified clean-fuel vehicle refueling property under section 179A with the (c)(1) fuel list and the principal residence exception — case-asserted";
}
pub relation refueling_property_cost_30c(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cost of the item of qualified alternative fuel vehicle refueling property placed in service by the taxpayer during the taxable year (section 30C(a)) — case-asserted";
}
pub relation refueling_property_depreciable_30c(item: Asset) kind empirical {
    label en official "the item is of a character subject to an allowance for depreciation — case-asserted";
}
pub relation refueling_property_placed_in_service_on_30c(item: Asset, on: Date) kind empirical {
    label en official "the date the item is placed in service — case-asserted";
}
pub relation refueling_property_census_tract_30c(item: Asset, tract: Asset) kind empirical {
    label en official "the population census tract in which the item is placed in service (section 30C(c)(3)) — case-asserted";
}
pub relation census_tract_not_urban_area_30c(tract: Asset) kind empirical {
    label en official "the tract is not an urban area (a tract designated as an urban area by the Secretary of Commerce according to the most recent decennial census) (section 30C(c)(3)(B)(i)(II), (ii)) — case-asserted";
}
pub relation prevailing_wage_requirement_met_for_project_30c(item: Asset) kind empirical {
    label en official "the qualified alternative fuel vehicle refueling project (one or more properties of a single project) meets the prevailing wage requirement of section 30C(g)(2)(A) (or was begun before the guidance date, section 30C(g)(1)(C)) — case-asserted";
}
pub relation property_excluded_by_50b_or_179_30c(taxpayer: Person, item: Asset) kind empirical {
    label en official "the property is referred to in section 50(b)(1), or the cost is taken into account under section 179 (section 30C(e)(3)) — case-asserted";
}
pub relation elects_out_of_section_30c_30c(taxpayer: Person, item: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 30C(e)(4) election not to have the section apply to the item";
}
pub relation section_30c_does_not_apply_to_item_30c(taxpayer: Person, item: Asset) kind institutional {
    label en official "section 30C(e)(4): no credit for the item (a valid election)";
}

pub relation in_eligible_census_tract_30c(item: Asset) kind institutional {
    label en official "section 30C(c)(3): the item is placed in service in a low-income community (section 45D(e)) or in a tract that is not an urban area";
}
@source(IRC_S30C_C, quote = "is described in section 45D(e)")
rule EligibleCensusTractLowIncome30cRule(item: Asset, tract: Asset) strict {
    when refueling_property_census_tract_30c(item, tract);
    when low_income_community_45d(tract);
    then in_eligible_census_tract_30c(item);
}
@source(IRC_S30C_C, quote = "is not an urban area")
rule EligibleCensusTractNonUrban30cRule(item: Asset, tract: Asset) strict {
    when refueling_property_census_tract_30c(item, tract);
    when census_tract_not_urban_area_30c(tract);
    then in_eligible_census_tract_30c(item);
}
@source(IRC_S30C_E, quote = "No credit shall be allowed under subsection (a) for any property if the taxpayer elects not to have this section apply to such property.")
rule ElectOutOfSection30cRule(taxpayer: Person, item: Asset) strict {
    when elects_out_of_section_30c_30c(taxpayer, item);
    then power Section30cE4ElectOut {
        holder taxpayer;
        over taxpayer;
        exercise elects_out_of_section_30c_30c(taxpayer, item);
        valid_when qualified_refueling_property_30c(item);
        effect create(section_30c_does_not_apply_to_item_30c(taxpayer, item));
        window [@2005-08-08, infinity);
    };
}

// --- (i): termination, base and PL 119-21 editions ----------------------------------------------------------------------------------------------

pub relation property_placed_in_service_within_credit_period_30c(item: Asset) kind institutional {
    label en official "section 30C(i): placed in service on or before 2032-12-31 (2024 text); on or before 2026-06-30 under PL 119-21 section 70504 from its enactment";
}
@source(IRC_S30C_I, quote = "This section shall not apply to any property placed in service after December 31, 2032.")
rule PropertyWithinCreditPeriodBase30cRule(item: Asset, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when refueling_property_placed_in_service_on_30c(item, on);
    when on <= @2032-12-31;
    then property_placed_in_service_within_credit_period_30c(item);
}
@source(us.irc.temporal::PL119_21_S70504, quote = "Section 30C(i) is amended by striking “December 31, 2032” and inserting “June 30, 2026”.")
rule PropertyWithinCreditPeriodAmended30cRule(item: Asset, on: Date) strict {
    effective [@2025-07-04, infinity);
    when refueling_property_placed_in_service_on_30c(item, on);
    when on <= @2026-06-30;
    then property_placed_in_service_within_credit_period_30c(item);
}

// --- (a), (b), (g): the credit -------------------------------------------------------------------------------------------------------------------------

pub relation refueling_credit_rate_30c(item: Asset, rate: Decimal) kind institutional {
    label en official "section 30C(a), (g)(1): 30 percent; 6 percent for depreciable property, multiplied by 5 (30 percent) when the project meets the prevailing wage requirement";
}
@source(IRC_S30C_A, quote = "30 percent (6 percent in the case of property of a character subject to depreciation)")
rule RefuelingCreditRateNotDepreciable30cRule(item: Asset) strict {
    when qualified_refueling_property_30c(item);
    when not_known(refueling_property_depreciable_30c(item));
    then refueling_credit_rate_30c(item, 0.30);
}
rule RefuelingCreditRateDepreciable30cRule(item: Asset) strict {
    when qualified_refueling_property_30c(item);
    when refueling_property_depreciable_30c(item);
    when not_known(prevailing_wage_requirement_met_for_project_30c(item));
    then refueling_credit_rate_30c(item, 0.06);
}
@source(IRC_S30C_G, quote = "the amount of the credit determined under subsection (a) for any qualified alternative fuel vehicle refueling property of a character subject to an allowance for depreciation")
rule RefuelingCreditRateDepreciableWage30cRule(item: Asset) strict {
    when qualified_refueling_property_30c(item);
    when refueling_property_depreciable_30c(item);
    when prevailing_wage_requirement_met_for_project_30c(item);
    then refueling_credit_rate_30c(item, 0.30);
}
pub relation refueling_credit_per_item_30c(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 30C(a)-(b): the rate times the cost, at most $100,000 (depreciable) or $1,000 (other) per item";
}
@source(IRC_S30C_B, quote = "$100,000 in the case of any such item of property of a character subject to an allowance for depreciation")
rule RefuelingCreditPerItemDepreciable30cRule(taxpayer: Person, item: Asset, y: TaxableYear, rate: Decimal, cost: Money) defeasible {
    when in_eligible_census_tract_30c(item);
    when property_placed_in_service_within_credit_period_30c(item);
    when not_known(property_excluded_by_50b_or_179_30c(taxpayer, item));
    when not_known(section_30c_does_not_apply_to_item_30c(taxpayer, item));
    when refueling_property_depreciable_30c(item);
    when refueling_credit_rate_30c(item, rate);
    when refueling_property_cost_30c(taxpayer, item, y, cost);
    then refueling_credit_per_item_30c(taxpayer, item, y, min(round(rate * cost, 2, "HALF_UP"), 100000.00 USD));
}
@source(IRC_S30C_B, quote = "$1,000 in any other case")
rule RefuelingCreditPerItemPersonal30cRule(taxpayer: Person, item: Asset, y: TaxableYear, rate: Decimal, cost: Money) defeasible {
    when in_eligible_census_tract_30c(item);
    when property_placed_in_service_within_credit_period_30c(item);
    when not_known(property_excluded_by_50b_or_179_30c(taxpayer, item));
    when not_known(section_30c_does_not_apply_to_item_30c(taxpayer, item));
    when not_known(refueling_property_depreciable_30c(item));
    when refueling_credit_rate_30c(item, rate);
    when refueling_property_cost_30c(taxpayer, item, y, cost);
    then refueling_credit_per_item_30c(taxpayer, item, y, min(round(rate * cost, 2, "HALF_UP"), 1000.00 USD));
}
pub relation alternative_fuel_vehicle_refueling_property_business_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30C(d)(1): the credit attributable to depreciable property, treated as a section 38(b) credit (section 38(b)(25))";
}
@source(IRC_S30C_D, quote = "that is attributable to property of a character subject to an allowance for depreciation shall be treated as a credit listed in section 38(b)")
rule BusinessCredit30cRule(taxpayer: Person, y: TaxableYear, item: Asset, amount: Money) defeasible {
    when refueling_credit_per_item_30c(taxpayer, item, y, amount);
    when refueling_property_depreciable_30c(item);
    then alternative_fuel_vehicle_refueling_property_business_credit(taxpayer, y,
        sum(collect all a: Money, i: Asset where refueling_credit_per_item_30c(taxpayer, i, y, a) and refueling_property_depreciable_30c(i), empty: 0 USD));
}
pub relation alternative_fuel_vehicle_refueling_property_personal_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30C(a): the credit attributable to property not subject to depreciation, a personal credit against the tax imposed by chapter 1 (the (d)(2) limitation is not computed, G1792)";
}
rule PersonalCredit30cRule(taxpayer: Person, y: TaxableYear, item: Asset, amount: Money) defeasible {
    when refueling_credit_per_item_30c(taxpayer, item, y, amount);
    when not_known(refueling_property_depreciable_30c(item));
    then alternative_fuel_vehicle_refueling_property_personal_credit(taxpayer, y,
        sum(collect all a: Money, i: Asset where refueling_credit_per_item_30c(taxpayer, i, y, a) and not_known(refueling_property_depreciable_30c(i)), empty: 0 USD));
}
