// Stage 3 (TECH_GAP reduction): section 45E(c)(2) (no credit for an employer that had a plan for
// substantially the same employees in the 3 preceding taxable years) and section 45T(b) (the
// 3-taxable-year credit period from the first year with an eligible automatic contribution
// arrangement, maintained in each year).
// `QualifiedStartupCostsRule` (45e-45t-small-employer-plan-credits.law) carries the guard
// `not_known(employer_excluded_by_prior_plan_45e_c2(...))`.
// (c)(1) of both sections (eligible employer by section 408(p)(2)(C)(i)) stays the case fact
// `eligible_employer_408p2c1`: section 408(p) is not in a package this one imports.
// STATUS: implemented_unverified (static check only).
// APPROXIMATION: the "2 succeeding taxable years" of 45T(b)(1) are read from the beginning dates
// (12-month years), as in section 45AA(b).

use self::{
    IRC_S45E_C,
    IRC_S45T_A,
    IRC_S45T_B,
    Person,
    TaxableYear,
    eligible_automatic_contribution_arrangement_included,
    eligible_employer_408p2c1,
    retirement_auto_enrollment_credit,
};

pub relation prior_plan_for_substantially_same_employees_45e(employer: Person, y: TaxableYear) kind empirical {
    label en official "section 45E(c)(2): during the 3-taxable-year period immediately preceding the first taxable year for which the credit is otherwise allowable, the employer, a member of its controlled group or a predecessor established or maintained a qualified employer plan with contributions or accruals for substantially the same employees as are in the new plan — case-asserted for the credit year";
}
pub relation employer_excluded_by_prior_plan_45e_c2(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45E(c)(2): the employer is not an eligible employer for the credit year because of a prior plan for substantially the same employees";
}
@source(IRC_S45E_C, relation = formalizes, coverage = exact, quote = "Such term shall not include an employer if, during the 3-taxable year period immediately preceding the 1st taxable year for which the credit under this section is otherwise allowable for a qualified employer plan of the employer")
rule EmployerExcludedByPriorPlan45eC2Rule(employer: Person, y: TaxableYear) strict {
    label en official "section 45E(c)(2): a prior plan for substantially the same employees excludes the employer";
    when prior_plan_for_substantially_same_employees_45e(employer, y);
    then employer_excluded_by_prior_plan_45e_c2(employer, y);
}

pub relation first_eaca_year_45t(employer: Person, first_year: TaxableYear) kind empirical {
    label en official "section 45T(b)(1): the first taxable year for which the employer includes an eligible automatic contribution arrangement (section 414(w)(3)) in a qualified employer plan (section 4972(d)) sponsored by it — case-asserted";
}
pub relation credit_period_year_45t(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45T(b): the taxable year is in the 3-taxable-year credit period and the arrangement is included in the plan for that year";
}
@source(IRC_S45T_B, relation = formalizes, coverage = exact, quote = "The credit period with respect to any eligible employer is the 3-taxable-year period beginning with the first taxable year for which the employer includes an eligible automatic contribution arrangement")
rule CreditPeriodYear45tFirstRule(employer: Person, y: TaxableYear) strict {
    label en official "section 45T(b)(1), (2): the first year, with the arrangement included";
    when first_eaca_year_45t(employer, y);
    when eligible_automatic_contribution_arrangement_included(employer, y);
    then credit_period_year_45t(employer, y);
}
@source(IRC_S45T_B, relation = formalizes, coverage = exact, quote = "No taxable year with respect to an employer shall be treated as occurring within the credit period unless the arrangement described in paragraph (1) is included in the plan for such year.")
rule CreditPeriodYear45tLaterRule(employer: Person, y: TaxableYear, first: TaxableYear, b0: Date, b1: Date) strict {
    label en official "section 45T(b)(1), (2): one of the 2 succeeding taxable years, with the arrangement included";
    when first_eaca_year_45t(employer, first);
    when us.irc.core::begins(first, b0);
    when us.irc.core::begins(y, b1);
    when b1 > b0;
    when b1 <= add_calendar_period(b0, 24 calendar_month);
    when eligible_automatic_contribution_arrangement_included(employer, y);
    then credit_period_year_45t(employer, y);
}
@source(IRC_S45T_A, relation = formalizes, coverage = partial, quote = "$500 for any taxable year occurring during the credit period")
rule RetirementAutoEnrollmentCreditDerivedPeriodRule(employer: Person, y: TaxableYear) strict {
    label en official "section 45T(a) with (b): the 500 dollar credit for a year in the derived credit period";
    when eligible_employer_408p2c1(employer, y);
    when credit_period_year_45t(employer, y);
    then retirement_auto_enrollment_credit(employer, y, 500.00 USD);
}
