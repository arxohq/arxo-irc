// Section 45O — Agricultural chemicals security credit. Stage 2d (IRC-06,
// DECISION-0379).
//
// Scope / judgment calls:
// * (a): 30 percent of qualified security expenditures of an eligible
//   agricultural business. (b): per facility, at most $100,000 less the credits
//   determined for the facility for the 5 prior taxable years. (c): per
//   taxpayer, at most $2,000,000.
// * (i): the section does not apply to amounts paid or incurred after
//   2012-12-31; read here through the taxable year's beginning date, so a year
//   straddling that date is treated whole (TECH-GAPS G1544).
// * (d)-(h): the expenditure categories, the eligible business and specified
//   agricultural chemical definitions, section 41(f) rules and regulations are
//   read inside the case-asserted expenditure amount (G1544).

use self::{
    Asset,
    IRC_S45O_A,
    IRC_S45O_C,
    IRC_S45O_I,
    Person,
    TaxableYear,
};

pub relation eligible_agricultural_business_45o(taxpayer: Person) kind empirical {
    label en official "the taxpayer is in the trade or business of selling agricultural products at retail predominantly to farmers and ranchers, or manufacturing, formulating, distributing, or aerially applying specified agricultural chemicals (section 45O(e)) — case-asserted";
}
pub relation qualified_security_expenditures_45o(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid or incurred for the section 45O(d) security measures (training and background checks, access limits, tagging and locking, perimeter protection, lighting and cameras, computer security, assessments, site security plans) for the purpose of protecting specified agricultural chemicals at the facility — case-asserted";
}
pub relation prior_five_year_credits_for_facility_45o(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate credits determined for the facility for the 5 prior taxable years (section 45O(b)(2)) — case-asserted";
}
pub relation section_45o_in_force_for_year(y: TaxableYear) kind institutional {
    label en official "section 45O(i): the section does not apply to amounts paid or incurred after December 31, 2012 (read through the beginning date of the taxable year)";
}
@source(IRC_S45O_I, quote = "This section shall not apply to any amount paid or incurred after December 31, 2012.")
rule Section45oInForceRule(y: TaxableYear, begin: Date) strict {
    when us.irc.core::begins(y, begin);
    when begin <= @2012-12-31;
    then section_45o_in_force_for_year(y);
}
pub relation agricultural_chemicals_security_credit_per_facility_45o(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 45O(a), (b): 30 percent of the facility's qualified security expenditures, at most $100,000 less the prior 5 years' credits";
}
@source(IRC_S45O_A, quote = "the agricultural chemicals security credit determined under this section for the taxable year is 30 percent of the qualified security expenditures for the taxable year")
rule AgriculturalChemicalsSecurityCreditPerFacility45oRule(taxpayer: Person, facility: Asset, y: TaxableYear, spend: Money, prior: Money) defeasible {
    when eligible_agricultural_business_45o(taxpayer);
    when section_45o_in_force_for_year(y);
    when qualified_security_expenditures_45o(taxpayer, facility, y, spend);
    when prior_five_year_credits_for_facility_45o(taxpayer, facility, y, prior);
    then agricultural_chemicals_security_credit_per_facility_45o(taxpayer, facility, y, min(round(0.30 * spend, 2, "HALF_UP"), max(0 USD, 100000.00 USD - prior)));
}
pub relation agricultural_chemicals_security_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45O agricultural chemicals security credit for the taxable year, at most $2,000,000 per taxpayer (a section 38(b)(27) component)";
}
@source(IRC_S45O_C, quote = "with respect to any taxpayer for any taxable year shall not exceed $2,000,000")
rule AgriculturalChemicalsSecurityCredit45oRule(taxpayer: Person, y: TaxableYear, facility: Asset, amount: Money) defeasible {
    when agricultural_chemicals_security_credit_per_facility_45o(taxpayer, facility, y, amount);
    then agricultural_chemicals_security_credit(taxpayer, y, min(2000000.00 USD,
        sum(collect all a: Money, f: Asset where agricultural_chemicals_security_credit_per_facility_45o(taxpayer, f, y, a), empty: 0 USD)));
}
