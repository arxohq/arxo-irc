// Stage 4 (DECISION-0379 with deontics), credits, part B: the rules made applicable
// by "rules similar to" section 52(c)-(e), 51(k) and 24(d)(2)(C) to sections 45P(e),
// 45R(e)(5)(B), 45R(f)(3)(B) and 45A(e)(3). Closes G6423.
//
// TECHNIQUE (stated): the similar rules are written ONCE for the three credits, keyed
// by a `SimilarRule52Credit` kind, with the conditions of the section 52 rules (module
// 52, reused facts) read by explicit reference; the denial of (c) is wired into the
// section 38(b) component wiring (module 38b); the apportionment of (d) is an output
// (like `section_52d_apportioned_credit` itself: its wiring into the beneficiary's
// section 38 input is the same accepted limitation of module 52).
// NOT modelled: the "similar" rule of section 52(e): its text is the frozen section
// 46(e), (h) as in effect before the Revenue Reconciliation Act of 1990, not in the
// pinned edition (SOURCE_GAP, as at section 52(e) in module 52).

use self::{
    IRC_S45A_E,
    IRC_S45P_E,
    IRC_S45R_E,
    IRC_S45R_F,
    Individual,
    Person,
    TaxableYear,
    amount_expected_from_other_person_51k2,
    cooperative_described_in_521,
    differential_wage_payment_credit,
    exempt_from_income_tax_under_chapter_1,
    indian_employment_credit,
    remuneration_paid_for_services_to_other_person_51k2,
    section_52d_income_allocable_share,
    services_performed_for_another_person_51k2,
    small_employer_health_insurance_credit,
    total_wages_paid_to_employee_45a,
    withholding_under_3401a_45r,
};

pub enum SimilarRule52Credit {
    DifferentialWagePaymentCredit45PKind,
    SmallEmployerHealthInsuranceCredit45RKind,
    IndianEmploymentCredit45AKind,
    label en official "the credits that apply rules similar to section 52(c)-(e): sections 45P(e), 45R(e)(5)(B), 45A(e)(3)";
}

// ===================== (c): tax-exempt organizations =====================

pub relation credit_denied_by_similar_52c_rule(employer: Person, kind: SimilarRule52Credit) kind institutional {
    label en official "no credit is allowed under section 38 for the credit to an organization (other than a section 521 cooperative) that is exempt from income tax under chapter 1 (rule similar to section 52(c)(1))";
}
@source(IRC_S45P_E, quote = "For purposes of this section, rules similar to the rules of subsections (c), (d), and (e) of section 52 shall apply.")
rule DenialSimilarToSection52c45p(employer: Person) strict {
    label en official "section 45P(e): the section 52(c)(1) denial applied to the differential wage payment credit";
    when exempt_from_income_tax_under_chapter_1(employer);
    when not cooperative_described_in_521(employer);
    then credit_denied_by_similar_52c_rule(employer, DifferentialWagePaymentCredit45PKind);
}
@source(IRC_S45R_E, quote = "Rules similar to the rules of subsections (c), (d), and (e) of section 52 shall apply.")
rule DenialSimilarToSection52c45r(employer: Person) strict {
    label en official "section 45R(e)(5)(B): the section 52(c)(1) denial applied to the small employer health insurance credit";
    when exempt_from_income_tax_under_chapter_1(employer);
    when not cooperative_described_in_521(employer);
    then credit_denied_by_similar_52c_rule(employer, SmallEmployerHealthInsuranceCredit45RKind);
}
@source(IRC_S45A_E, quote = "Rules similar to the rules of section 51(k) and subsections (c), (d), and (e) of section 52 shall apply.")
rule DenialSimilarToSection52c45a(employer: Person) strict {
    label en official "section 45A(e)(3): the section 52(c)(1) denial applied to the Indian employment credit";
    when exempt_from_income_tax_under_chapter_1(employer);
    when not cooperative_described_in_521(employer);
    then credit_denied_by_similar_52c_rule(employer, IndianEmploymentCredit45AKind);
}

// ===================== (d): estates and trusts =====================

pub relation credit_apportioned_by_similar_52d_rule(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, kind: SimilarRule52Credit, amount: Money) kind institutional {
    label en official "the credit of the estate or trust apportioned between it and the beneficiaries on the basis of the income allocable to each, cents HALF_UP (rule similar to section 52(d)(1)); the beneficiary is allowed it subject to section 38(c) (52(d)(2))";
}
@source(IRC_S45P_E, quote = "For purposes of this section, rules similar to the rules of subsections (c), (d), and (e) of section 52 shall apply.")
rule ApportionmentSimilarToSection52d45p(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 45P(e): the differential wage payment credit of the estate or trust apportioned by income";
    when differential_wage_payment_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then credit_apportioned_by_similar_52d_rule(estate_or_trust, beneficiary, y, DifferentialWagePaymentCredit45PKind, round(total * share, 2, "HALF_UP"));
}
@source(IRC_S45R_E, quote = "Rules similar to the rules of subsections (c), (d), and (e) of section 52 shall apply.")
rule ApportionmentSimilarToSection52d45r(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 45R(e)(5)(B): the small employer health insurance credit of the estate or trust apportioned by income";
    when small_employer_health_insurance_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then credit_apportioned_by_similar_52d_rule(estate_or_trust, beneficiary, y, SmallEmployerHealthInsuranceCredit45RKind, round(total * share, 2, "HALF_UP"));
}
@source(IRC_S45A_E, quote = "Rules similar to the rules of section 51(k) and subsections (c), (d), and (e) of section 52 shall apply.")
rule ApportionmentSimilarToSection52d45a(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 45A(e)(3): the Indian employment credit of the estate or trust apportioned by income";
    when indian_employment_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then credit_apportioned_by_similar_52d_rule(estate_or_trust, beneficiary, y, IndianEmploymentCredit45AKind, round(total * share, 2, "HALF_UP"));
}

// ===================== 45A(e)(3): the rules of section 51(k) =====================

pub relation remuneration_disqualified_45a_51k2(employee: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "no Indian employment credit for remuneration paid for services performed for another person unless the amount expected from that person exceeds the remuneration paid (rule similar to section 51(k)(2)); reads the facts of module s3-i";
}
@source(IRC_S45A_E, quote = "Rules similar to the rules of section 51(k) and subsections (c), (d), and (e) of section 52 shall apply.")
rule RemunerationDisqualified45aSimilarTo51k2(employee: Individual, employer: Person, y: TaxableYear, expected: Money, paid: Money) strict {
    label en official "section 45A(e)(3): the section 51(k)(2) condition applied to the qualified employee of section 45A(c)";
    when services_performed_for_another_person_51k2(employee, employer, y);
    when amount_expected_from_other_person_51k2(employee, employer, y, expected);
    when remuneration_paid_for_services_to_other_person_51k2(employee, employer, y, paid);
    when expected <= paid;
    then remuneration_disqualified_45a_51k2(employee, employer, y);
}
pub relation successor_employer_45a_51k1(successor: Person, predecessor: Person) kind empirical {
    label en official "the successor employer referred to in section 3306(b)(1) and its predecessor (rule similar to section 51(k)(1))";
}
pub relation wages_treated_as_paid_by_predecessor_45a_51k1(predecessor: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the wages paid by a successor employer are treated, for the amount of the Indian employment credit, as paid by its predecessor (rule similar to section 51(k)(1)); the regulations of (k)(1) fix the details";
}
@source(IRC_S45A_E, quote = "Rules similar to the rules of section 51(k) and subsections (c), (d), and (e) of section 52 shall apply.")
rule SuccessorWagesTreatedAsPaidByPredecessor45a(successor: Person, predecessor: Person, employee: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "the successor's total wages to the employee count as the predecessor's (rule similar to section 51(k)(1))";
    when successor_employer_45a_51k1(successor, predecessor);
    when total_wages_paid_to_employee_45a(successor, employee, y, amount);
    then wages_treated_as_paid_by_predecessor_45a_51k1(predecessor, employee, y, amount);
}

// ===================== 45R(f)(3)(B): the rule of section 24(d)(2)(C) =====================

pub relation amount_paid_under_3121l_agreement_equivalent_to_3401a_45r(employer: Person, calendar_year: Decimal, amount: Money) kind empirical {
    label en official "amounts paid pursuant to an agreement under section 3121(l) (American employers with respect to foreign affiliates) equivalent to the taxes of section 3401(a) (rule similar to section 24(d)(2)(C))";
}
pub relation withholding_under_3401a_with_agreement_45r(employer: Person, calendar_year: Decimal, amount: Money) kind institutional {
    label en official "the amounts referred to in section 45R(f)(3)(A)(i): the withholding under section 3401(a) plus the equivalent amounts paid under a section 3121(l) agreement (rule similar to section 24(d)(2)(C))";
}
@source(IRC_S45R_F, quote = "A rule similar to the rule of section 24(d)(2)(C) shall apply for purposes of subparagraph (A).")
rule WithholdingIncludesAgreementAmounts45r(employer: Person, calendar_year: Decimal, a: Money, g: Money) defeasible {
    label en official "3401(a) withholding + the equivalent 3121(l) agreement amounts";
    when withholding_under_3401a_45r(employer, calendar_year, a);
    when amount_paid_under_3121l_agreement_equivalent_to_3401a_45r(employer, calendar_year, g);
    then withholding_under_3401a_with_agreement_45r(employer, calendar_year, a + g);
}
relation agreement_amount_present_45r(employer: Person, calendar_year: Decimal) kind institutional {
    label en official "bridge: an agreement amount is asserted";
}
rule AgreementAmountPresent45r(employer: Person, calendar_year: Decimal, g: Money) defeasible {
    label en official "bridge for the absence test";
    when amount_paid_under_3121l_agreement_equivalent_to_3401a_45r(employer, calendar_year, g);
    then agreement_amount_present_45r(employer, calendar_year);
}
rule WithholdingWithoutAgreementAmounts45r(employer: Person, calendar_year: Decimal, a: Money) defeasible {
    label en official "no agreement amount: the 3401(a) withholding alone";
    when withholding_under_3401a_45r(employer, calendar_year, a);
    when not_known(agreement_amount_present_45r(employer, calendar_year));
    then withholding_under_3401a_with_agreement_45r(employer, calendar_year, a);
}
