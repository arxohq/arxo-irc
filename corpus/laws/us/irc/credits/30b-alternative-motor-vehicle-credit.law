// Section 30B — Alternative motor vehicle credit (the credit expired: (k) ends each vehicle credit on the dates
// below; the plug-in conversion credit of (i) was repealed). Stage 2e (IRC-06, DECISION-0379, TECH_GAP reduction of
// TECH-GAPS G1853). The historical windows are the (k) dates, compared with the case fact of the purchase date.
//
// Scope / judgment calls:
// * (b) fuel cell vehicle: base amount by gross vehicle weight rating ($8,000, $4,000 after 2009-12-31 for a rating of
//   at most 8,500 pounds; $10,000; $20,000; $40,000) plus, for a passenger automobile or light truck under the base
//   (A) amount, an increase by the vehicle's percentage of the 2002 model year city fuel economy (150 percent and up).
//   The percentage tests are written as `city fuel economy >= n x baseline` (no rounded ratio).
// * (c) advanced lean burn: the fuel economy credit table plus the conservation credit table by lifetime fuel
//   savings (c)(4) = 120,000 / baseline - 120,000 / vehicle economy; the two quotients are rounded to 6 decimals
//   HALF_UP (JUDGMENT CALL: the text names no rounding) before the table comparison.
// * (d) hybrid: light hybrid = (c)(2)(A) + (c)(2)(B); heavy hybrid = the applicable percentage of the incremental
//   hybrid cost (capped by weight), the manufacturer's certification being a case fact. A vehicle with a section 30D
//   credit allowable is excluded ((d)(3)(D)).
// * (e) alternative fuel: (50 percent + 30 percent when the emissions certification holds) x the incremental cost
//   (capped by weight class); the mixed-fuel percentages of (e)(5) multiply the amount that would have been allowed
//   (cents HALF_UP, JUDGMENT CALL).
// * (f) phase-out: only for a light hybrid or lean burn vehicle sold in the phase-out period; the phase-out period
//   start (the second calendar quarter following the quarter of the 60,000th vehicle sale, section 52 single
//   manufacturer) is the case fact `phaseout_period_start_30b`; the quarters are 3 months from that start.
// * (g)(1): the credit attributable to property subject to depreciation is a section 38(b) credit and not allowed
//   under (a): a bridge into `general_business_credit_component_amount` (component `AlternativeMotorVehicleCredit30B`).
// * (h)(9): the election out is a power; (h)(8) regulations are NON_NORMATIVE; the tables 30B_TABLE_1..4 are pinned.

use self::{
    Asset,
    GeneralBusinessCreditComponent,
    IRC_S30B_B,
    IRC_S30B_C,
    IRC_S30B_D,
    IRC_S30B_E,
    IRC_S30B_F,
    IRC_S30B_G,
    IRC_S30B_H,
    IRC_S30B_K,
    IRC_S30B_TABLE_1,
    IRC_S30B_TABLE_2,
    IRC_S30B_TABLE_3,
    IRC_S30B_TABLE_4,
    Person,
    PropertyKind25D,
    TaxableYear,
    general_business_credit_component_amount,
};

pub enum VehicleKind30B {
    FuelCell;
    AdvancedLeanBurn;
    QualifiedHybrid;
    AlternativeFuel;
}
pub enum VehicleClass30B {
    PassengerAutomobile;
    LightTruck;
    OtherMotorVehicle;
}
pub enum MixedFuel30B {
    Mixed75Over25;
    Mixed90Over10;
}

pub relation vehicle_kind_30b(vehicle: Asset, kind: VehicleKind30B) kind empirical {
    label en official "the vehicle is claimed as a new qualified fuel cell, advanced lean burn technology, hybrid or alternative fuel motor vehicle (section 30B(a)) — case-asserted";
}
pub relation vehicle_class_30b(vehicle: Asset, class: VehicleClass30B) kind empirical {
    label en official "the vehicle is a passenger automobile, a light truck or another motor vehicle, as defined in the EPA regulations (section 30B(h)(3)) — case-asserted";
}
pub relation gross_vehicle_weight_rating_30b(vehicle: Asset, pounds: Decimal) kind empirical {
    label en official "the gross vehicle weight rating of the vehicle in pounds — case-asserted";
}
pub relation purchase_date_30b(vehicle: Asset, on: Date) kind empirical {
    label en official "the date the vehicle is purchased (section 30B(k)) — case-asserted";
}
pub relation placed_in_service_by_30b(taxpayer: Person, vehicle: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer places the vehicle in service during the taxable year (section 30B(b)(1), (c)(1), (d)(1)) — case-asserted";
}
pub relation placed_in_service_date_30b(vehicle: Asset, on: Date) kind empirical {
    label en official "the date the vehicle is placed in service (section 30B(b)(1)(A)) — case-asserted";
}
pub relation city_fuel_economy_mpg_30b(vehicle: Asset, mpg: Decimal) kind empirical {
    label en official "the city fuel economy of the vehicle, on a gasoline gallon equivalent basis, measured substantially as under 40 CFR part 600 (section 30B(h)(2)) — case-asserted";
}
pub relation inertia_weight_class_lbs_30b(vehicle: Asset, class_lbs: Decimal) kind empirical {
    label en official "the vehicle inertia weight class in pounds, as defined in the EPA regulations under title II of the Clean Air Act (section 30B(b)(2)(C)): 1,500 stands for the class \"1,500 or 1,750\" and 7,000 for the class \"7,000 to 8,500\" — case-asserted";
}

// --- (b)(2)(B): the 2002 model year city fuel economy tables ---------------------------------------------------------------------------------

relation baseline_2002_city_economy_30b(class: VehicleClass30B, class_lbs: Decimal, mpg: Decimal) kind institutional;
@source(IRC_S30B_TABLE_1, relation = formalizes, coverage = exact, quote = "1,500 or 1,750 lbs / 45.2 mpg")
assert "30b-t1-1500": baseline_2002_city_economy_30b(PassengerAutomobile, 1500.0, 45.2);
assert "30b-t1-2000": baseline_2002_city_economy_30b(PassengerAutomobile, 2000.0, 39.6);
assert "30b-t1-2250": baseline_2002_city_economy_30b(PassengerAutomobile, 2250.0, 35.2);
assert "30b-t1-2500": baseline_2002_city_economy_30b(PassengerAutomobile, 2500.0, 31.7);
assert "30b-t1-2750": baseline_2002_city_economy_30b(PassengerAutomobile, 2750.0, 28.8);
assert "30b-t1-3000": baseline_2002_city_economy_30b(PassengerAutomobile, 3000.0, 26.4);
assert "30b-t1-3500": baseline_2002_city_economy_30b(PassengerAutomobile, 3500.0, 22.6);
assert "30b-t1-4000": baseline_2002_city_economy_30b(PassengerAutomobile, 4000.0, 19.8);
assert "30b-t1-4500": baseline_2002_city_economy_30b(PassengerAutomobile, 4500.0, 17.6);
assert "30b-t1-5000": baseline_2002_city_economy_30b(PassengerAutomobile, 5000.0, 15.9);
assert "30b-t1-5500": baseline_2002_city_economy_30b(PassengerAutomobile, 5500.0, 14.4);
assert "30b-t1-6000": baseline_2002_city_economy_30b(PassengerAutomobile, 6000.0, 13.2);
assert "30b-t1-6500": baseline_2002_city_economy_30b(PassengerAutomobile, 6500.0, 12.2);
assert "30b-t1-7000": baseline_2002_city_economy_30b(PassengerAutomobile, 7000.0, 11.3);
@source(IRC_S30B_TABLE_2, relation = formalizes, coverage = exact, quote = "1,500 or 1,750 lbs / 39.4 mpg")
assert "30b-t2-1500": baseline_2002_city_economy_30b(LightTruck, 1500.0, 39.4);
assert "30b-t2-2000": baseline_2002_city_economy_30b(LightTruck, 2000.0, 35.2);
assert "30b-t2-2250": baseline_2002_city_economy_30b(LightTruck, 2250.0, 31.8);
assert "30b-t2-2500": baseline_2002_city_economy_30b(LightTruck, 2500.0, 29.0);
assert "30b-t2-2750": baseline_2002_city_economy_30b(LightTruck, 2750.0, 26.8);
assert "30b-t2-3000": baseline_2002_city_economy_30b(LightTruck, 3000.0, 24.9);
assert "30b-t2-3500": baseline_2002_city_economy_30b(LightTruck, 3500.0, 21.8);
assert "30b-t2-4000": baseline_2002_city_economy_30b(LightTruck, 4000.0, 19.4);
assert "30b-t2-4500": baseline_2002_city_economy_30b(LightTruck, 4500.0, 17.6);
assert "30b-t2-5000": baseline_2002_city_economy_30b(LightTruck, 5000.0, 16.1);
assert "30b-t2-5500": baseline_2002_city_economy_30b(LightTruck, 5500.0, 14.8);
assert "30b-t2-6000": baseline_2002_city_economy_30b(LightTruck, 6000.0, 13.7);
assert "30b-t2-6500": baseline_2002_city_economy_30b(LightTruck, 6500.0, 12.8);
assert "30b-t2-7000": baseline_2002_city_economy_30b(LightTruck, 7000.0, 12.1);
pub relation baseline_city_economy_of_vehicle_30b(vehicle: Asset, mpg: Decimal) kind institutional {
    label en official "section 30B(b)(2)(B): the 2002 model year city fuel economy of the vehicle by its class (passenger automobile or light truck) and vehicle inertia weight class";
}
rule BaselineCityEconomyOfVehicle30bRule(vehicle: Asset, class: VehicleClass30B, class_lbs: Decimal, mpg: Decimal) strict {
    when vehicle_class_30b(vehicle, class);
    when inertia_weight_class_lbs_30b(vehicle, class_lbs);
    when baseline_2002_city_economy_30b(class, class_lbs, mpg);
    then baseline_city_economy_of_vehicle_30b(vehicle, mpg);
}

// --- (k): the termination dates ----------------------------------------------------------------------------------------------------------------------

pub relation within_30b_termination_date_30b(vehicle: Asset) kind institutional {
    label en official "section 30B(k): the section applies only to property purchased on or before the date of the vehicle's kind (fuel cell 2021-12-31; lean burn and light hybrid 2010-12-31; heavy hybrid 2009-12-31; alternative fuel 2010-12-31)";
}
@source(IRC_S30B_K, relation = formalizes, coverage = exact, quote = "in the case of a new qualified fuel cell motor vehicle (as described in subsection (b)), December 31, 2021,")
rule Within30bTerminationFuelCellRule(vehicle: Asset, on: Date) strict {
    when vehicle_kind_30b(vehicle, FuelCell);
    when purchase_date_30b(vehicle, on);
    when on <= @2021-12-31;
    then within_30b_termination_date_30b(vehicle);
}
@source(IRC_S30B_K, relation = formalizes, coverage = exact, quote = "in the case of a new advanced lean burn technology motor vehicle (as described in subsection (c)) or a new qualified hybrid motor vehicle (as described in subsection (d)(2)(A)), December 31, 2010,")
rule Within30bTerminationLeanBurnRule(vehicle: Asset, on: Date) strict {
    when vehicle_kind_30b(vehicle, AdvancedLeanBurn);
    when purchase_date_30b(vehicle, on);
    when on <= @2010-12-31;
    then within_30b_termination_date_30b(vehicle);
}
rule Within30bTerminationLightHybridRule(vehicle: Asset, on: Date) strict {
    when vehicle_kind_30b(vehicle, QualifiedHybrid);
    when light_hybrid_30b(vehicle);
    when purchase_date_30b(vehicle, on);
    when on <= @2010-12-31;
    then within_30b_termination_date_30b(vehicle);
}
@source(IRC_S30B_K, relation = formalizes, coverage = exact, quote = "in the case of a new qualified hybrid motor vehicle (as described in subsection (d)(2)(B)), December 31, 2009, and")
rule Within30bTerminationHeavyHybridRule(vehicle: Asset, on: Date) strict {
    when vehicle_kind_30b(vehicle, QualifiedHybrid);
    when heavy_hybrid_30b(vehicle);
    when purchase_date_30b(vehicle, on);
    when on <= @2009-12-31;
    then within_30b_termination_date_30b(vehicle);
}
@source(IRC_S30B_K, relation = formalizes, coverage = exact, quote = "in the case of a new qualified alternative fuel vehicle (as described in subsection (e)), December 31, 2010.")
rule Within30bTerminationAlternativeFuelRule(vehicle: Asset, on: Date) strict {
    when vehicle_kind_30b(vehicle, AlternativeFuel);
    when purchase_date_30b(vehicle, on);
    when on <= @2010-12-31;
    then within_30b_termination_date_30b(vehicle);
}
relation light_hybrid_30b(vehicle: Asset) kind institutional;
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "In the case of a new qualified hybrid motor vehicle which is a passenger automobile or light truck and which has a gross vehicle weight rating of not more than 8,500 pounds, the amount determined under this paragraph is the sum of the amounts determined under clauses (i) and (ii).")
rule LightHybridPassengerRule(vehicle: Asset, pounds: Decimal) strict {
    when vehicle_class_30b(vehicle, PassengerAutomobile);
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds <= 8500.0;
    then light_hybrid_30b(vehicle);
}
rule LightHybridLightTruckRule(vehicle: Asset, pounds: Decimal) strict {
    when vehicle_class_30b(vehicle, LightTruck);
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds <= 8500.0;
    then light_hybrid_30b(vehicle);
}
relation heavy_hybrid_30b(vehicle: Asset) kind institutional;
rule HeavyHybridOtherClassRule(vehicle: Asset) strict {
    when vehicle_kind_30b(vehicle, QualifiedHybrid);
    when vehicle_class_30b(vehicle, OtherMotorVehicle);
    then heavy_hybrid_30b(vehicle);
}
rule HeavyHybridHeavyWeightRule(vehicle: Asset, pounds: Decimal) strict {
    when vehicle_kind_30b(vehicle, QualifiedHybrid);
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 8500.0;
    then heavy_hybrid_30b(vehicle);
}

// --- common vehicle requirements ------------------------------------------------------------------------------------------------------------------------

pub relation original_use_commences_with_taxpayer_30b(taxpayer: Person, vehicle: Asset) kind empirical {
    label en official "the original use of the vehicle commences with the taxpayer (section 30B(b)(3)(C), (c)(3)(B), (d)(3)(A)(v), (e)(4)(A)(ii)) — case-asserted";
}
pub relation acquired_for_use_or_lease_not_resale_30b(taxpayer: Person, vehicle: Asset) kind empirical {
    label en official "the vehicle is acquired for use or lease by the taxpayer and not for resale (section 30B(b)(3)(D), (c)(3)(C), (d)(3)(A)(vi), (e)(4)(A)(iii)) — case-asserted";
}
pub relation made_by_a_manufacturer_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle is made by a manufacturer as defined in the EPA regulations (section 30B(b)(3)(E), (c)(3)(D), (d)(3)(A)(vii), (e)(4)(A)(iv), (h)(3)) — case-asserted";
}
pub relation motor_vehicle_4_wheels_public_roads_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle is manufactured primarily for use on public streets, roads and highways (not operated exclusively on rails) and has at least 4 wheels (section 30B(h)(1)) — case-asserted";
}
pub relation complies_with_clean_air_act_and_motor_vehicle_safety_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle complies with the applicable Clean Air Act provisions (or State air quality law under a section 209(b) waiver) and with 49 U.S.C. 30101-30169 (section 30B(h)(10)) — case-asserted";
}
pub relation credit_allowable_under_30d_30b(vehicle: Asset) kind empirical {
    label en official "a credit is allowable under section 30D (determined without regard to subsection (c) thereof) with respect to the vehicle (section 30B(d)(3)(D)) — case-asserted";
}
pub relation common_requirements_met_30b(taxpayer: Person, vehicle: Asset) kind institutional {
    label en official "sections 30B(h)(1), (h)(10), the common (b)-(e) requirements: original use, acquired for use or lease, made by a manufacturer, a motor vehicle in compliance";
}
@source(IRC_S30B_H, relation = formalizes, coverage = partial, quote = "The term \"motor vehicle\" means any vehicle which is manufactured primarily for use on public streets, roads, and highways (not including a vehicle operated exclusively on a rail or rails) and which has at least 4 wheels.")
rule CommonRequirementsMet30bRule(taxpayer: Person, vehicle: Asset) strict {
    when original_use_commences_with_taxpayer_30b(taxpayer, vehicle);
    when acquired_for_use_or_lease_not_resale_30b(taxpayer, vehicle);
    when made_by_a_manufacturer_30b(vehicle);
    when motor_vehicle_4_wheels_public_roads_30b(vehicle);
    when complies_with_clean_air_act_and_motor_vehicle_safety_30b(vehicle);
    when within_30b_termination_date_30b(vehicle);
    then common_requirements_met_30b(taxpayer, vehicle);
}

// --- (b): new qualified fuel cell motor vehicle credit ----------------------------------------------------------------------------------------

pub relation propelled_by_hydrogen_fuel_cells_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle is propelled by power derived from 1 or more cells which convert chemical energy directly into electricity by combining oxygen with hydrogen fuel stored on board (section 30B(b)(3)(A)) — case-asserted";
}
pub relation certified_bin_5_tier_ii_30b(vehicle: Asset) kind empirical {
    label en official "the passenger automobile or light truck has received a certificate that it meets or exceeds the Bin 5 Tier II emission level (section 30B(b)(3)(B)) — case-asserted";
}
pub relation new_qualified_fuel_cell_motor_vehicle_30b(taxpayer: Person, vehicle: Asset) kind institutional {
    label en official "section 30B(b)(3): a motor vehicle propelled by hydrogen fuel cells, certified Bin 5 Tier II if a passenger automobile or light truck, original use with the taxpayer, acquired for use or lease, made by a manufacturer";
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"new qualified fuel cell motor vehicle\" means a motor vehicle—")
rule NewQualifiedFuelCellVehicleOtherRule(taxpayer: Person, vehicle: Asset) strict {
    when vehicle_kind_30b(vehicle, FuelCell);
    when propelled_by_hydrogen_fuel_cells_30b(vehicle);
    when vehicle_class_30b(vehicle, OtherMotorVehicle);
    when common_requirements_met_30b(taxpayer, vehicle);
    then new_qualified_fuel_cell_motor_vehicle_30b(taxpayer, vehicle);
}
rule NewQualifiedFuelCellVehiclePassengerRule(taxpayer: Person, vehicle: Asset, class: VehicleClass30B) strict {
    when vehicle_kind_30b(vehicle, FuelCell);
    when propelled_by_hydrogen_fuel_cells_30b(vehicle);
    when vehicle_class_30b(vehicle, class);
    when certified_bin_5_tier_ii_30b(vehicle);
    when common_requirements_met_30b(taxpayer, vehicle);
    then new_qualified_fuel_cell_motor_vehicle_30b(taxpayer, vehicle);
}
relation fuel_cell_base_amount_30b(vehicle: Asset, amount: Money) kind institutional;
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(A) $8,000 ($4,000 in the case of a vehicle placed in service after December 31, 2009), if such vehicle has a gross vehicle weight rating of not more than 8,500 pounds,")
rule FuelCellBaseUpTo8500Through2009Rule(vehicle: Asset, pounds: Decimal, on: Date) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when placed_in_service_date_30b(vehicle, on);
    when pounds <= 8500.0;
    when on <= @2009-12-31;
    then fuel_cell_base_amount_30b(vehicle, 8000.00 USD);
}
rule FuelCellBaseUpTo8500After2009Rule(vehicle: Asset, pounds: Decimal, on: Date) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when placed_in_service_date_30b(vehicle, on);
    when pounds <= 8500.0;
    when on > @2009-12-31;
    then fuel_cell_base_amount_30b(vehicle, 4000.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(B) $10,000, if such vehicle has a gross vehicle weight rating of more than 8,500 pounds but not more than 14,000 pounds,")
rule FuelCellBase8500To14000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 8500.0;
    when pounds <= 14000.0;
    then fuel_cell_base_amount_30b(vehicle, 10000.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(C) $20,000, if such vehicle has a gross vehicle weight rating of more than 14,000 pounds but not more than 26,000 pounds, and")
rule FuelCellBase14000To26000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 14000.0;
    when pounds <= 26000.0;
    then fuel_cell_base_amount_30b(vehicle, 20000.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(D) $40,000, if such vehicle has a gross vehicle weight rating of more than 26,000 pounds.")
rule FuelCellBaseOver26000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 26000.0;
    then fuel_cell_base_amount_30b(vehicle, 40000.00 USD);
}
relation fuel_cell_economy_increase_30b(vehicle: Asset, amount: Money) kind institutional;
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(i) $1,000, if such vehicle achieves at least 150 percent but less than 175 percent of the 2002 model year city fuel economy,")
rule FuelCellIncrease150Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when new_qualified_fuel_cell_light_vehicle_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 1.50 * baseline;
    when mpg < 1.75 * baseline;
    then fuel_cell_economy_increase_30b(vehicle, 1000.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(ii) $1,500, if such vehicle achieves at least 175 percent but less than 200 percent of the 2002 model year city fuel economy,")
rule FuelCellIncrease175Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when new_qualified_fuel_cell_light_vehicle_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 1.75 * baseline;
    when mpg < 2.00 * baseline;
    then fuel_cell_economy_increase_30b(vehicle, 1500.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(iii) $2,000, if such vehicle achieves at least 200 percent but less than 225 percent of the 2002 model year city fuel economy,")
rule FuelCellIncrease200Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when new_qualified_fuel_cell_light_vehicle_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 2.00 * baseline;
    when mpg < 2.25 * baseline;
    then fuel_cell_economy_increase_30b(vehicle, 2000.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(iv) $2,500, if such vehicle achieves at least 225 percent but less than 250 percent of the 2002 model year city fuel economy,")
rule FuelCellIncrease225Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when new_qualified_fuel_cell_light_vehicle_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 2.25 * baseline;
    when mpg < 2.50 * baseline;
    then fuel_cell_economy_increase_30b(vehicle, 2500.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(v) $3,000, if such vehicle achieves at least 250 percent but less than 275 percent of the 2002 model year city fuel economy,")
rule FuelCellIncrease250Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when new_qualified_fuel_cell_light_vehicle_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 2.50 * baseline;
    when mpg < 2.75 * baseline;
    then fuel_cell_economy_increase_30b(vehicle, 3000.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(vi) $3,500, if such vehicle achieves at least 275 percent but less than 300 percent of the 2002 model year city fuel economy, and")
rule FuelCellIncrease275Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when new_qualified_fuel_cell_light_vehicle_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 2.75 * baseline;
    when mpg < 3.00 * baseline;
    then fuel_cell_economy_increase_30b(vehicle, 3500.00 USD);
}
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "(vii) $4,000, if such vehicle achieves at least 300 percent of the 2002 model year city fuel economy.")
rule FuelCellIncrease300Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when new_qualified_fuel_cell_light_vehicle_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 3.00 * baseline;
    then fuel_cell_economy_increase_30b(vehicle, 4000.00 USD);
}
relation new_qualified_fuel_cell_light_vehicle_30b(vehicle: Asset) kind institutional;
@source(IRC_S30B_B, relation = formalizes, coverage = exact, quote = "The amount determined under paragraph (1)(A) with respect to a new qualified fuel cell motor vehicle which is a passenger automobile or light truck shall be increased by—")
rule FuelCellLightVehiclePassengerRule(taxpayer: Person, vehicle: Asset, pounds: Decimal) strict {
    when new_qualified_fuel_cell_motor_vehicle_30b(taxpayer, vehicle);
    when vehicle_class_30b(vehicle, PassengerAutomobile);
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds <= 8500.0;
    then new_qualified_fuel_cell_light_vehicle_30b(vehicle);
}
rule FuelCellLightVehicleLightTruckRule(taxpayer: Person, vehicle: Asset, pounds: Decimal) strict {
    when new_qualified_fuel_cell_motor_vehicle_30b(taxpayer, vehicle);
    when vehicle_class_30b(vehicle, LightTruck);
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds <= 8500.0;
    then new_qualified_fuel_cell_light_vehicle_30b(vehicle);
}
pub relation new_qualified_fuel_cell_motor_vehicle_credit_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(b): the new qualified fuel cell motor vehicle credit: the weight-class amount plus, for a light vehicle, the fuel economy increase";
}
rule FuelCellCreditWithIncreaseRule(taxpayer: Person, vehicle: Asset, base: Money, increase: Money) strict {
    when new_qualified_fuel_cell_motor_vehicle_30b(taxpayer, vehicle);
    when fuel_cell_base_amount_30b(vehicle, base);
    when fuel_cell_economy_increase_30b(vehicle, increase);
    then new_qualified_fuel_cell_motor_vehicle_credit_30b(taxpayer, vehicle, base + increase);
}
relation fuel_cell_increase_asserted_30b(vehicle: Asset) kind institutional;
rule FuelCellIncreaseAssertedRule(vehicle: Asset, amount: Money) strict {
    when fuel_cell_economy_increase_30b(vehicle, amount);
    then fuel_cell_increase_asserted_30b(vehicle);
}
rule FuelCellCreditBaseOnlyRule(taxpayer: Person, vehicle: Asset, base: Money) strict {
    when new_qualified_fuel_cell_motor_vehicle_30b(taxpayer, vehicle);
    when fuel_cell_base_amount_30b(vehicle, base);
    when not_known(fuel_cell_increase_asserted_30b(vehicle));
    then new_qualified_fuel_cell_motor_vehicle_credit_30b(taxpayer, vehicle, base);
}

// --- (c): advanced lean burn technology --------------------------------------------------------------------------------------------------------------

pub relation lean_burn_engine_design_30b(vehicle: Asset) kind empirical {
    label en official "the internal combustion engine is designed to operate primarily using more air than is necessary for complete combustion of the fuel and incorporates direct injection (section 30B(c)(3)(A)(i)-(ii)) — case-asserted";
}
pub relation certified_emission_standard_for_weight_30b(vehicle: Asset) kind empirical {
    label en official "for 2004 and later model vehicles, the vehicle has received a certificate that it meets or exceeds the Bin 5 Tier II standard (rating of 6,000 pounds or less) or the Bin 8 Tier II standard (more than 6,000 but not more than 8,500 pounds) (section 30B(c)(3)(A)(iv)) — case-asserted";
}
pub relation new_advanced_lean_burn_technology_motor_vehicle_30b(taxpayer: Person, vehicle: Asset) kind institutional {
    label en official "section 30B(c)(3): a passenger automobile or light truck with a lean burn direct injection engine achieving at least 125 percent of the 2002 model year city fuel economy, certified, original use with the taxpayer, acquired for use or lease, made by a manufacturer";
}
@source(IRC_S30B_C, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"new advanced lean burn technology motor vehicle\" means a passenger automobile or a light truck—")
rule NewAdvancedLeanBurnPassengerRule(taxpayer: Person, vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when vehicle_kind_30b(vehicle, AdvancedLeanBurn);
    when vehicle_class_30b(vehicle, PassengerAutomobile);
    when lean_burn_engine_design_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 1.25 * baseline;
    when certified_emission_standard_for_weight_30b(vehicle);
    when common_requirements_met_30b(taxpayer, vehicle);
    then new_advanced_lean_burn_technology_motor_vehicle_30b(taxpayer, vehicle);
}
rule NewAdvancedLeanBurnLightTruckRule(taxpayer: Person, vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when vehicle_kind_30b(vehicle, AdvancedLeanBurn);
    when vehicle_class_30b(vehicle, LightTruck);
    when lean_burn_engine_design_30b(vehicle);
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 1.25 * baseline;
    when certified_emission_standard_for_weight_30b(vehicle);
    when common_requirements_met_30b(taxpayer, vehicle);
    then new_advanced_lean_burn_technology_motor_vehicle_30b(taxpayer, vehicle);
}
pub relation fuel_economy_credit_amount_30b(vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(c)(2)(A): the fuel economy credit amount by the vehicle's percentage of the 2002 model year city fuel economy (table IRC_S30B_TABLE_3), also used by (d)(2)(A)(i)";
}
@source(IRC_S30B_TABLE_3, relation = formalizes, coverage = exact, quote = "At least 125 percent but less than 150 percent / $400")
rule FuelEconomyCredit125Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 1.25 * baseline;
    when mpg < 1.50 * baseline;
    then fuel_economy_credit_amount_30b(vehicle, 400.00 USD);
}
@source(IRC_S30B_TABLE_3, relation = formalizes, coverage = exact, quote = "At least 150 percent but less than 175 percent / $800")
rule FuelEconomyCredit150Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 1.50 * baseline;
    when mpg < 1.75 * baseline;
    then fuel_economy_credit_amount_30b(vehicle, 800.00 USD);
}
@source(IRC_S30B_TABLE_3, relation = formalizes, coverage = exact, quote = "At least 175 percent but less than 200 percent / $1,200")
rule FuelEconomyCredit175Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 1.75 * baseline;
    when mpg < 2.00 * baseline;
    then fuel_economy_credit_amount_30b(vehicle, 1200.00 USD);
}
@source(IRC_S30B_TABLE_3, relation = formalizes, coverage = exact, quote = "At least 200 percent but less than 225 percent / $1,600")
rule FuelEconomyCredit200Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 2.00 * baseline;
    when mpg < 2.25 * baseline;
    then fuel_economy_credit_amount_30b(vehicle, 1600.00 USD);
}
@source(IRC_S30B_TABLE_3, relation = formalizes, coverage = exact, quote = "At least 225 percent but less than 250 percent / $2,000")
rule FuelEconomyCredit225Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 2.25 * baseline;
    when mpg < 2.50 * baseline;
    then fuel_economy_credit_amount_30b(vehicle, 2000.00 USD);
}
@source(IRC_S30B_TABLE_3, relation = formalizes, coverage = exact, quote = "At least 250 percent / $2,400")
rule FuelEconomyCredit250Rule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg >= 2.50 * baseline;
    then fuel_economy_credit_amount_30b(vehicle, 2400.00 USD);
}
pub relation lifetime_fuel_savings_30b(vehicle: Asset, gallons: Decimal) kind institutional {
    label en official "section 30B(c)(4): the excess (if any) of 120,000 divided by the 2002 model year city fuel economy of the vehicle inertia weight class over 120,000 divided by the city fuel economy of the vehicle (6 decimals HALF_UP judgment call)";
}
@source(IRC_S30B_C, relation = formalizes, coverage = exact, quote = "(A) 120,000 divided by the 2002 model year city fuel economy for the vehicle inertia weight class, over")
rule LifetimeFuelSavings30bRule(vehicle: Asset, mpg: Decimal, baseline: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when baseline_city_economy_of_vehicle_30b(vehicle, baseline);
    when mpg > baseline;
    then lifetime_fuel_savings_30b(vehicle, div_round(120000.0, baseline, 6, "HALF_UP") - div_round(120000.0, mpg, 6, "HALF_UP"));
}
pub relation conservation_credit_amount_30b(vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(c)(2)(B): the conservation credit amount by lifetime fuel savings (table IRC_S30B_TABLE_4)";
}
@source(IRC_S30B_TABLE_4, relation = formalizes, coverage = exact, quote = "At least 1,200 but less than 1,800 / $250")
rule ConservationCredit1200Rule(vehicle: Asset, gallons: Decimal) strict {
    when lifetime_fuel_savings_30b(vehicle, gallons);
    when gallons >= 1200.0;
    when gallons < 1800.0;
    then conservation_credit_amount_30b(vehicle, 250.00 USD);
}
@source(IRC_S30B_TABLE_4, relation = formalizes, coverage = exact, quote = "At least 1,800 but less than 2,400 / $500")
rule ConservationCredit1800Rule(vehicle: Asset, gallons: Decimal) strict {
    when lifetime_fuel_savings_30b(vehicle, gallons);
    when gallons >= 1800.0;
    when gallons < 2400.0;
    then conservation_credit_amount_30b(vehicle, 500.00 USD);
}
@source(IRC_S30B_TABLE_4, relation = formalizes, coverage = exact, quote = "At least 2,400 but less than 3,000 / $750")
rule ConservationCredit2400Rule(vehicle: Asset, gallons: Decimal) strict {
    when lifetime_fuel_savings_30b(vehicle, gallons);
    when gallons >= 2400.0;
    when gallons < 3000.0;
    then conservation_credit_amount_30b(vehicle, 750.00 USD);
}
@source(IRC_S30B_TABLE_4, relation = formalizes, coverage = exact, quote = "At least 3,000 / $1,000")
rule ConservationCredit3000Rule(vehicle: Asset, gallons: Decimal) strict {
    when lifetime_fuel_savings_30b(vehicle, gallons);
    when gallons >= 3000.0;
    then conservation_credit_amount_30b(vehicle, 1000.00 USD);
}
pub relation credit_before_phaseout_lean_burn_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(c)(1)-(2): the advanced lean burn credit before the (f) phase-out: the fuel economy credit plus the conservation credit";
}
rule LeanBurnCreditWithConservationRule(taxpayer: Person, vehicle: Asset, base: Money, conservation: Money) strict {
    when new_advanced_lean_burn_technology_motor_vehicle_30b(taxpayer, vehicle);
    when fuel_economy_credit_amount_30b(vehicle, base);
    when conservation_credit_amount_30b(vehicle, conservation);
    then credit_before_phaseout_lean_burn_30b(taxpayer, vehicle, base + conservation);
}
relation conservation_asserted_30b(vehicle: Asset) kind institutional;
rule ConservationAssertedRule(vehicle: Asset, amount: Money) strict {
    when conservation_credit_amount_30b(vehicle, amount);
    then conservation_asserted_30b(vehicle);
}
rule LeanBurnCreditWithoutConservationRule(taxpayer: Person, vehicle: Asset, base: Money) strict {
    when new_advanced_lean_burn_technology_motor_vehicle_30b(taxpayer, vehicle);
    when fuel_economy_credit_amount_30b(vehicle, base);
    when not_known(conservation_asserted_30b(vehicle));
    then credit_before_phaseout_lean_burn_30b(taxpayer, vehicle, base);
}

// --- (d): new qualified hybrid motor vehicle ----------------------------------------------------------------------------------------------------------

pub relation hybrid_drawing_from_engine_and_rechargeable_storage_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle draws propulsion energy from onboard sources of stored energy that are both an internal combustion or heat engine using consumable fuel and a rechargeable energy storage system (section 30B(d)(3)(A)(i)) — case-asserted";
}
pub relation hybrid_certified_and_meets_power_and_emission_tests_30b(vehicle: Asset) kind empirical {
    label en official "the hybrid meets the certificate of conformity, California low emission vehicle or Bin 5 / Bin 8 Tier II standard, the maximum available power percentage (4, 10 or 15 percent by weight) and, for a vehicle to which paragraph (2)(B) applies, the 2004-2007 heavy duty engine standards (section 30B(d)(3)(A)(ii)-(iv), (C)) — case-asserted";
}
pub relation new_qualified_hybrid_motor_vehicle_30b(taxpayer: Person, vehicle: Asset) kind institutional {
    label en official "section 30B(d)(3)(A): a hybrid motor vehicle meeting the propulsion, emission and power tests, original use with the taxpayer, acquired for use or lease, made by a manufacturer; not a section 30D vehicle; a vehicle that is not a passenger automobile or light truck under 8,500 pounds";
}
@source(IRC_S30B_D, relation = formalizes, coverage = partial, quote = "The term \"new qualified hybrid motor vehicle\" means a motor vehicle—")
rule NewQualifiedHybridRule(taxpayer: Person, vehicle: Asset) strict {
    when vehicle_kind_30b(vehicle, QualifiedHybrid);
    when hybrid_drawing_from_engine_and_rechargeable_storage_30b(vehicle);
    when hybrid_certified_and_meets_power_and_emission_tests_30b(vehicle);
    when common_requirements_met_30b(taxpayer, vehicle);
    when not_known(credit_allowable_under_30d_30b(vehicle));
    then new_qualified_hybrid_motor_vehicle_30b(taxpayer, vehicle);
}
pub relation hybrid_light_credit_before_phaseout_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(d)(2)(A): for a passenger automobile or light truck of at most 8,500 pounds, the sum of the (c)(2)(A) fuel economy amount and the (c)(2)(B) conservation amount, computed as if it were a lean burn vehicle";
}
rule HybridLightCreditWithConservationRule(taxpayer: Person, vehicle: Asset, base: Money, conservation: Money) strict {
    when new_qualified_hybrid_motor_vehicle_30b(taxpayer, vehicle);
    when light_hybrid_30b(vehicle);
    when fuel_economy_credit_amount_30b(vehicle, base);
    when conservation_credit_amount_30b(vehicle, conservation);
    then hybrid_light_credit_before_phaseout_30b(taxpayer, vehicle, base + conservation);
}
rule HybridLightCreditWithoutConservationRule(taxpayer: Person, vehicle: Asset, base: Money) strict {
    when new_qualified_hybrid_motor_vehicle_30b(taxpayer, vehicle);
    when light_hybrid_30b(vehicle);
    when fuel_economy_credit_amount_30b(vehicle, base);
    when not_known(conservation_asserted_30b(vehicle));
    then hybrid_light_credit_before_phaseout_30b(taxpayer, vehicle, base);
}
pub relation comparable_vehicle_city_economy_mpg_30b(vehicle: Asset, mpg: Decimal) kind empirical {
    label en official "the city fuel economy of the comparable vehicle: powered solely by a gasoline or diesel internal combustion engine and comparable in weight, size and use (section 30B(d)(2)(B)(iv)) — case-asserted";
}
pub relation manufacturers_suggested_retail_price_30b(vehicle: Asset, amount: Money) kind empirical {
    label en official "the manufacturer's suggested retail price of the vehicle (section 30B(d)(2)(B)(iii), (e)(3)) — case-asserted";
}
pub relation comparable_vehicle_price_30b(vehicle: Asset, amount: Money) kind empirical {
    label en official "the manufacturer's suggested retail price of the comparable vehicle (section 30B(d)(2)(B)(iii)) or of the gasoline or diesel fuel motor vehicle of the same model (section 30B(e)(3)) — case-asserted";
}
pub relation manufacturer_certification_of_incremental_cost_30b(vehicle: Asset) kind empirical {
    label en official "the manufacturer made the certification of fuel economy savings and incremental hybrid cost in accordance with the Secretary's guidance (section 30B(d)(2)(B)(v)) — case-asserted";
}
relation incremental_cost_cap_hybrid_30b(vehicle: Asset, cap: Money) kind institutional;
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "(I) $7,500, if such vehicle has a gross vehicle weight rating of not more than 14,000 pounds,")
rule IncrementalCostCapHybridUpTo14000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds <= 14000.0;
    then incremental_cost_cap_hybrid_30b(vehicle, 7500.00 USD);
}
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "(II) $15,000, if such vehicle has a gross vehicle weight rating of more than 14,000 pounds but not more than 26,000 pounds, and")
rule IncrementalCostCapHybrid14000To26000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 14000.0;
    when pounds <= 26000.0;
    then incremental_cost_cap_hybrid_30b(vehicle, 15000.00 USD);
}
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "(III) $30,000, if such vehicle has a gross vehicle weight rating of more than 26,000 pounds.")
rule IncrementalCostCapHybridOver26000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 26000.0;
    then incremental_cost_cap_hybrid_30b(vehicle, 30000.00 USD);
}
pub relation qualified_incremental_hybrid_cost_30b(vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(d)(2)(B)(iii): the excess of the vehicle's price over the comparable vehicle's, not above the weight-class cap";
}
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, the qualified incremental hybrid cost of any vehicle is equal to the amount of the excess of the manufacturer's suggested retail price for such vehicle over such price for a comparable vehicle, to the extent such amount does not exceed—")
rule QualifiedIncrementalHybridCostRule(vehicle: Asset, price: Money, comparable: Money, cap: Money) strict {
    when manufacturers_suggested_retail_price_30b(vehicle, price);
    when comparable_vehicle_price_30b(vehicle, comparable);
    when incremental_cost_cap_hybrid_30b(vehicle, cap);
    when price > comparable;
    then qualified_incremental_hybrid_cost_30b(vehicle, min(price - comparable, cap));
}
relation hybrid_applicable_percentage_30b(vehicle: Asset, pct: Decimal) kind institutional;
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "(I) 20 percent if the vehicle achieves an increase in city fuel economy relative to a comparable vehicle of at least 30 percent but less than 40 percent,")
rule HybridApplicablePercentage20Rule(vehicle: Asset, mpg: Decimal, comparable: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when comparable_vehicle_city_economy_mpg_30b(vehicle, comparable);
    when mpg >= 1.30 * comparable;
    when mpg < 1.40 * comparable;
    then hybrid_applicable_percentage_30b(vehicle, 0.20);
}
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "(II) 30 percent if the vehicle achieves such an increase of at least 40 percent but less than 50 percent, and")
rule HybridApplicablePercentage30Rule(vehicle: Asset, mpg: Decimal, comparable: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when comparable_vehicle_city_economy_mpg_30b(vehicle, comparable);
    when mpg >= 1.40 * comparable;
    when mpg < 1.50 * comparable;
    then hybrid_applicable_percentage_30b(vehicle, 0.30);
}
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "(III) 40 percent if the vehicle achieves such an increase of at least 50 percent.")
rule HybridApplicablePercentage40Rule(vehicle: Asset, mpg: Decimal, comparable: Decimal) strict {
    when city_fuel_economy_mpg_30b(vehicle, mpg);
    when comparable_vehicle_city_economy_mpg_30b(vehicle, comparable);
    when mpg >= 1.50 * comparable;
    then hybrid_applicable_percentage_30b(vehicle, 0.40);
}
pub relation hybrid_heavy_credit_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(d)(2)(B): for other hybrids the applicable percentage of the manufacturer-certified qualified incremental hybrid cost (heavy hybrids are not subject to the (f) phase-out)";
}
@source(IRC_S30B_D, relation = formalizes, coverage = exact, quote = "In the case of any new qualified hybrid motor vehicle to which subparagraph (A) does not apply, the amount determined under this paragraph is the amount equal to the applicable percentage of the qualified incremental hybrid cost of the vehicle as certified under clause (v).")
rule HybridHeavyCreditRule(taxpayer: Person, vehicle: Asset, pct: Decimal, cost: Money) strict {
    when new_qualified_hybrid_motor_vehicle_30b(taxpayer, vehicle);
    when heavy_hybrid_30b(vehicle);
    when manufacturer_certification_of_incremental_cost_30b(vehicle);
    when hybrid_applicable_percentage_30b(vehicle, pct);
    when qualified_incremental_hybrid_cost_30b(vehicle, cost);
    then hybrid_heavy_credit_30b(taxpayer, vehicle, round(pct * cost, 2, "HALF_UP"));
}

// --- (e): new qualified alternative fuel motor vehicle ----------------------------------------------------------------------------------------------

pub relation only_capable_of_operating_on_alternative_fuel_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle is only capable of operating on an alternative fuel: compressed natural gas, liquefied natural gas, liquefied petroleum gas, hydrogen, or a liquid at least 85 percent of whose volume is methanol (section 30B(e)(4)) — case-asserted";
}
pub relation meets_most_stringent_available_emission_standard_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle has a certificate of conformity (or a California order) and meets or exceeds the most stringent standard available for certification for that make and model year, other than a zero emission standard (section 30B(e)(2)(B)); for a vehicle over 14,000 pounds the standard available on the date of enactment of the Energy Tax Incentives Act of 2005 — case-asserted";
}
pub relation new_qualified_alternative_fuel_motor_vehicle_30b(taxpayer: Person, vehicle: Asset) kind institutional {
    label en official "section 30B(e)(4)(A): a motor vehicle only capable of operating on an alternative fuel, original use with the taxpayer, acquired for use or lease, made by a manufacturer";
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "The term \"new qualified alternative fuel motor vehicle\" means any motor vehicle—")
rule NewQualifiedAlternativeFuelRule(taxpayer: Person, vehicle: Asset) strict {
    when vehicle_kind_30b(vehicle, AlternativeFuel);
    when only_capable_of_operating_on_alternative_fuel_30b(vehicle);
    when common_requirements_met_30b(taxpayer, vehicle);
    then new_qualified_alternative_fuel_motor_vehicle_30b(taxpayer, vehicle);
}
relation incremental_cost_cap_alt_fuel_30b(vehicle: Asset, cap: Money) kind institutional;
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(A) $5,000, if such vehicle has a gross vehicle weight rating of not more than 8,500 pounds,")
rule IncrementalCostCapAltFuelUpTo8500Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds <= 8500.0;
    then incremental_cost_cap_alt_fuel_30b(vehicle, 5000.00 USD);
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(B) $10,000, if such vehicle has a gross vehicle weight rating of more than 8,500 pounds but not more than 14,000 pounds,")
rule IncrementalCostCapAltFuel8500To14000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 8500.0;
    when pounds <= 14000.0;
    then incremental_cost_cap_alt_fuel_30b(vehicle, 10000.00 USD);
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(C) $25,000, if such vehicle has a gross vehicle weight rating of more than 14,000 pounds but not more than 26,000 pounds, and")
rule IncrementalCostCapAltFuel14000To26000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 14000.0;
    when pounds <= 26000.0;
    then incremental_cost_cap_alt_fuel_30b(vehicle, 25000.00 USD);
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(D) $40,000, if such vehicle has a gross vehicle weight rating of more than 26,000 pounds.")
rule IncrementalCostCapAltFuelOver26000Rule(vehicle: Asset, pounds: Decimal) strict {
    when gross_vehicle_weight_rating_30b(vehicle, pounds);
    when pounds > 26000.0;
    then incremental_cost_cap_alt_fuel_30b(vehicle, 40000.00 USD);
}
pub relation incremental_cost_alternative_fuel_30b(vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(e)(3): the excess of the vehicle's price over that of a gasoline or diesel fuel motor vehicle of the same model, not above the weight-class cap";
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the incremental cost of any new qualified alternative fuel motor vehicle is equal to the amount of the excess of the manufacturer's suggested retail price for such vehicle over such price for a gasoline or diesel fuel motor vehicle of the same model, to the extent such amount does not exceed—")
rule IncrementalCostAlternativeFuelRule(vehicle: Asset, price: Money, comparable: Money, cap: Money) strict {
    when manufacturers_suggested_retail_price_30b(vehicle, price);
    when comparable_vehicle_price_30b(vehicle, comparable);
    when incremental_cost_cap_alt_fuel_30b(vehicle, cap);
    when price > comparable;
    then incremental_cost_alternative_fuel_30b(vehicle, min(price - comparable, cap));
}
relation alternative_fuel_applicable_percentage_30b(vehicle: Asset, pct: Decimal) kind institutional;
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(A) 50 percent, plus")
rule AlternativeFuelApplicablePercentageBaseRule(vehicle: Asset) strict {
    when new_qualified_alternative_fuel_vehicle_asserted_30b(vehicle);
    when not_known(meets_most_stringent_available_emission_standard_30b(vehicle));
    then alternative_fuel_applicable_percentage_30b(vehicle, 0.50);
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(B) 30 percent, if such vehicle—")
rule AlternativeFuelApplicablePercentageEmissionsRule(vehicle: Asset) strict {
    when new_qualified_alternative_fuel_vehicle_asserted_30b(vehicle);
    when meets_most_stringent_available_emission_standard_30b(vehicle);
    then alternative_fuel_applicable_percentage_30b(vehicle, 0.80);
}
relation new_qualified_alternative_fuel_vehicle_asserted_30b(vehicle: Asset) kind institutional;
rule NewQualifiedAlternativeFuelAssertedRule(taxpayer: Person, vehicle: Asset) strict {
    when new_qualified_alternative_fuel_motor_vehicle_30b(taxpayer, vehicle);
    then new_qualified_alternative_fuel_vehicle_asserted_30b(vehicle);
}
pub relation alternative_fuel_credit_as_if_qualified_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(e)(1): the applicable percentage of the incremental cost of a new qualified alternative fuel motor vehicle";
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (5), the new qualified alternative fuel motor vehicle credit determined under this subsection is an amount equal to the applicable percentage of the incremental cost of any new qualified alternative fuel motor vehicle placed in service by the taxpayer during the taxable year.")
rule AlternativeFuelCreditAsIfQualifiedRule(taxpayer: Person, vehicle: Asset, pct: Decimal, cost: Money) strict {
    when new_qualified_alternative_fuel_motor_vehicle_30b(taxpayer, vehicle);
    when alternative_fuel_applicable_percentage_30b(vehicle, pct);
    when incremental_cost_alternative_fuel_30b(vehicle, cost);
    then alternative_fuel_credit_as_if_qualified_30b(taxpayer, vehicle, round(pct * cost, 2, "HALF_UP"));
}
pub relation mixed_fuel_kind_30b(vehicle: Asset, kind: MixedFuel30B) kind empirical {
    label en official "the vehicle is a 75/25 or a 90/10 mixed-fuel vehicle: it operates on at least 75 (90) percent alternative fuel and at most 25 (10) percent petroleum-based fuel, is certified by the manufacturer as performing efficiently on a combination, has a certificate of conformity (or California order), original use with the taxpayer, acquired for use or lease, made by a manufacturer (section 30B(e)(5)(B)-(D)) — case-asserted";
}
pub relation alternative_fuel_credit_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(e): the credit of a qualified alternative fuel vehicle, or 70 percent (75/25) or 90 percent (90/10) of it for a mixed-fuel vehicle";
}
rule AlternativeFuelCreditPureRule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when alternative_fuel_credit_as_if_qualified_30b(taxpayer, vehicle, amount);
    when not_known(mixed_fuel_kind_asserted_30b(vehicle));
    then alternative_fuel_credit_30b(taxpayer, vehicle, amount);
}
relation mixed_fuel_kind_asserted_30b(vehicle: Asset) kind institutional;
rule MixedFuelKindAssertedRule(vehicle: Asset, kind: MixedFuel30B) strict {
    when mixed_fuel_kind_30b(vehicle, kind);
    then mixed_fuel_kind_asserted_30b(vehicle);
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(i) in the case of a 75/25 mixed-fuel vehicle, 70 percent of the credit which would have been allowed under this subsection if such vehicle was a qualified alternative fuel motor vehicle, and")
rule AlternativeFuelCreditMixed7525Rule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when alternative_fuel_credit_as_if_qualified_30b(taxpayer, vehicle, amount);
    when mixed_fuel_kind_30b(vehicle, Mixed75Over25);
    then alternative_fuel_credit_30b(taxpayer, vehicle, round(0.70 * amount, 2, "HALF_UP"));
}
@source(IRC_S30B_E, relation = formalizes, coverage = exact, quote = "(ii) in the case of a 90/10 mixed-fuel vehicle, 90 percent of the credit which would have been allowed under this subsection if such vehicle was a qualified alternative fuel motor vehicle.")
rule AlternativeFuelCreditMixed9010Rule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when alternative_fuel_credit_as_if_qualified_30b(taxpayer, vehicle, amount);
    when mixed_fuel_kind_30b(vehicle, Mixed90Over10);
    then alternative_fuel_credit_30b(taxpayer, vehicle, round(0.90 * amount, 2, "HALF_UP"));
}

// --- (f): the phase-out ---------------------------------------------------------------------------------------------------------------------------------------

pub relation phaseout_period_start_30b(vehicle: Asset, start: Date) kind empirical {
    label en official "the first day of the phase-out period for the manufacturer of the vehicle: the second calendar quarter following the calendar quarter that includes the first date the manufacturer's qualified vehicles sold for use in the United States after December 31, 2005 reach 60,000, all persons treated as a single employer under sections 52(a)-(b) or 414(m), (o) being one manufacturer (section 30B(f)(2), (4)) — case-asserted";
}
pub relation vehicle_sale_date_30b(vehicle: Asset, on: Date) kind empirical {
    label en official "the date the qualified vehicle is sold (section 30B(f)(1)) — case-asserted";
}
pub relation phaseout_applicable_percentage_30b(vehicle: Asset, pct: Decimal) kind institutional {
    label en official "section 30B(f)(1), (3): 100 percent before the phase-out period; 50 percent for the first 2 calendar quarters, 25 percent for the 3rd and 4th, 0 percent thereafter";
}
rule PhaseoutPercentageBeforePeriodRule(vehicle: Asset, start: Date, sold: Date) strict {
    when phaseout_period_start_30b(vehicle, start);
    when vehicle_sale_date_30b(vehicle, sold);
    when sold < start;
    then phaseout_applicable_percentage_30b(vehicle, 1.00);
}
@source(IRC_S30B_F, relation = formalizes, coverage = exact, quote = "(A) 50 percent for the first 2 calendar quarters of the phaseout period,")
rule PhaseoutPercentageFirstTwoQuartersRule(vehicle: Asset, start: Date, sold: Date) strict {
    when phaseout_period_start_30b(vehicle, start);
    when vehicle_sale_date_30b(vehicle, sold);
    when sold >= start;
    when sold < add_calendar_period(start, 6 calendar_month);
    then phaseout_applicable_percentage_30b(vehicle, 0.50);
}
@source(IRC_S30B_F, relation = formalizes, coverage = exact, quote = "(B) 25 percent for the 3d and 4th calendar quarters of the phaseout period, and")
rule PhaseoutPercentageThirdFourthQuartersRule(vehicle: Asset, start: Date, sold: Date) strict {
    when phaseout_period_start_30b(vehicle, start);
    when vehicle_sale_date_30b(vehicle, sold);
    when sold >= add_calendar_period(start, 6 calendar_month);
    when sold < add_calendar_period(start, 12 calendar_month);
    then phaseout_applicable_percentage_30b(vehicle, 0.25);
}
@source(IRC_S30B_F, relation = formalizes, coverage = exact, quote = "(C) 0 percent for each calendar quarter thereafter.")
rule PhaseoutPercentageThereafterRule(vehicle: Asset, start: Date, sold: Date) strict {
    when phaseout_period_start_30b(vehicle, start);
    when vehicle_sale_date_30b(vehicle, sold);
    when sold >= add_calendar_period(start, 12 calendar_month);
    then phaseout_applicable_percentage_30b(vehicle, 0.00);
}
relation phaseout_percentage_asserted_30b(vehicle: Asset) kind institutional;
rule PhaseoutPercentageAssertedRule(vehicle: Asset, pct: Decimal) strict {
    when phaseout_applicable_percentage_30b(vehicle, pct);
    then phaseout_percentage_asserted_30b(vehicle);
}
pub relation lean_burn_credit_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(c), (f): the advanced lean burn credit after the phase-out";
}
rule LeanBurnCreditPhasedRule(taxpayer: Person, vehicle: Asset, base: Money, pct: Decimal) strict {
    when credit_before_phaseout_lean_burn_30b(taxpayer, vehicle, base);
    when phaseout_applicable_percentage_30b(vehicle, pct);
    then lean_burn_credit_30b(taxpayer, vehicle, round(pct * base, 2, "HALF_UP"));
}
rule LeanBurnCreditNoPhaseoutRule(taxpayer: Person, vehicle: Asset, base: Money) strict {
    when credit_before_phaseout_lean_burn_30b(taxpayer, vehicle, base);
    when not_known(phaseout_percentage_asserted_30b(vehicle));
    then lean_burn_credit_30b(taxpayer, vehicle, base);
}
pub relation hybrid_light_credit_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(d)(2)(A), (f): the light hybrid credit after the phase-out (qualified vehicle: a hybrid of (d)(2)(A) or a lean burn vehicle)";
}
rule HybridLightCreditPhasedRule(taxpayer: Person, vehicle: Asset, base: Money, pct: Decimal) strict {
    when hybrid_light_credit_before_phaseout_30b(taxpayer, vehicle, base);
    when phaseout_applicable_percentage_30b(vehicle, pct);
    then hybrid_light_credit_30b(taxpayer, vehicle, round(pct * base, 2, "HALF_UP"));
}
rule HybridLightCreditNoPhaseoutRule(taxpayer: Person, vehicle: Asset, base: Money) strict {
    when hybrid_light_credit_before_phaseout_30b(taxpayer, vehicle, base);
    when not_known(phaseout_percentage_asserted_30b(vehicle));
    then hybrid_light_credit_30b(taxpayer, vehicle, base);
}

// --- (a), (g), (h): the credit, the business portion and the special rules ---------------------------------------------------------------------

pub relation elects_out_of_30b_30b(taxpayer: Person, vehicle: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 30B(h)(9) election to not have this section apply to the vehicle";
}
pub relation section_30b_does_not_apply_30b(taxpayer: Person, vehicle: Asset) kind institutional {
    label en official "section 30B(h)(9): no credit is allowed for the vehicle (a valid election out)";
}
@source(IRC_S30B_H, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under subsection (a) for any vehicle if the taxpayer elects to not have this section apply to such vehicle.")
rule ElectOutOf30bRule(taxpayer: Person, vehicle: Asset) strict {
    when common_requirements_met_30b(taxpayer, vehicle);
    then power Section30bH9ElectOut {
        holder taxpayer;
        over vehicle;
        exercise elects_out_of_30b_30b(taxpayer, vehicle);
        valid_when common_requirements_met_30b(taxpayer, vehicle);
        effect create(section_30b_does_not_apply_30b(taxpayer, vehicle));
        window [@2005-08-08, @2021-12-31];
    };
}
pub relation vehicle_credit_amount_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(a): the credit of one vehicle: the fuel cell, advanced lean burn, hybrid or alternative fuel amount (the plug-in conversion credit of (i) was repealed)";
}
rule VehicleCreditFuelCellRule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when new_qualified_fuel_cell_motor_vehicle_credit_30b(taxpayer, vehicle, amount);
    when placed_in_service_by_30b(taxpayer, vehicle, _);
    when not_known(elects_out_of_30b_30b(taxpayer, vehicle));
    then vehicle_credit_amount_30b(taxpayer, vehicle, amount);
}
rule VehicleCreditLeanBurnRule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when lean_burn_credit_30b(taxpayer, vehicle, amount);
    when placed_in_service_by_30b(taxpayer, vehicle, _);
    when not_known(elects_out_of_30b_30b(taxpayer, vehicle));
    then vehicle_credit_amount_30b(taxpayer, vehicle, amount);
}
rule VehicleCreditLightHybridRule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when hybrid_light_credit_30b(taxpayer, vehicle, amount);
    when placed_in_service_by_30b(taxpayer, vehicle, _);
    when not_known(elects_out_of_30b_30b(taxpayer, vehicle));
    then vehicle_credit_amount_30b(taxpayer, vehicle, amount);
}
rule VehicleCreditHeavyHybridRule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when hybrid_heavy_credit_30b(taxpayer, vehicle, amount);
    when placed_in_service_by_30b(taxpayer, vehicle, _);
    when not_known(elects_out_of_30b_30b(taxpayer, vehicle));
    then vehicle_credit_amount_30b(taxpayer, vehicle, amount);
}
rule VehicleCreditAlternativeFuelRule(taxpayer: Person, vehicle: Asset, amount: Money) strict {
    when alternative_fuel_credit_30b(taxpayer, vehicle, amount);
    when placed_in_service_by_30b(taxpayer, vehicle, _);
    when not_known(elects_out_of_30b_30b(taxpayer, vehicle));
    then vehicle_credit_amount_30b(taxpayer, vehicle, amount);
}
pub relation business_use_depreciable_property_30b(taxpayer: Person, vehicle: Asset) kind empirical {
    label en official "the vehicle is property of a character subject to an allowance for depreciation in the taxpayer's hands (section 30B(g)(1)) — case-asserted";
}
pub relation section_50b1_or_179_property_30b(taxpayer: Person, vehicle: Asset) kind empirical {
    label en official "the vehicle is property referred to in section 50(b)(1) or its cost is taken into account under section 179 (section 30B(h)(7)) — case-asserted";
}
pub relation credit_allowed_after_h7_30b(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 30B(a), (h)(7): the credit of the vehicle for the year in which it is placed in service, unless the vehicle is section 50(b)(1) property or its cost is expensed under section 179";
}
@source(IRC_S30B_H, relation = formalizes, coverage = exact, quote = "No credit shall be allowable under subsection (a) with respect to any property referred to in section 50(b)(1) or with respect to the portion of the cost of any property taken into account under section 179.")
rule CreditAllowedAfterH7Rule(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) strict {
    when vehicle_credit_amount_30b(taxpayer, vehicle, amount);
    when placed_in_service_by_30b(taxpayer, vehicle, y);
    when not_known(section_50b1_or_179_property_30b(taxpayer, vehicle));
    then credit_allowed_after_h7_30b(taxpayer, vehicle, y, amount);
}
pub relation alternative_motor_vehicle_credit_business_portion_30b(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30B(g)(1): the part of the credit attributable to property subject to an allowance for depreciation, treated as a section 38(b) credit and not allowed under subsection (a)";
}
@source(IRC_S30B_G, relation = formalizes, coverage = exact, quote = "So much of the credit which would be allowed under subsection (a) for any taxable year (determined without regard to this subsection) that is attributable to property of a character subject to an allowance for depreciation shall be treated as a credit listed in section 38(b) for such taxable year (and not allowed under subsection (a)).")
rule BusinessPortion30bRule(taxpayer: Person, y: TaxableYear, one: Asset, one_amount: Money) strict {
    when credit_allowed_after_h7_30b(taxpayer, one, y, one_amount);
    when business_use_depreciable_property_30b(taxpayer, one);
    then alternative_motor_vehicle_credit_business_portion_30b(taxpayer, y,
        sum(collect all a: Money, v: Asset where credit_allowed_after_h7_30b(taxpayer, v, y, a) and business_use_depreciable_property_30b(taxpayer, v), empty: 0 USD));
}
pub relation alternative_motor_vehicle_credit_30b(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30B(a), (g): the personal credit against the tax imposed by chapter 1 for the taxable year: the sum of the vehicle credits not attributable to depreciable property; (g)(2) treats it as a credit allowable under subpart A";
}
rule AlternativeMotorVehicleCredit30bRule(taxpayer: Person, y: TaxableYear, one: Asset, one_amount: Money) strict {
    when credit_allowed_after_h7_30b(taxpayer, one, y, one_amount);
    // all vehicle credits less the part attributable to depreciable property (the section 38(b) part of (g)(1)).
    then alternative_motor_vehicle_credit_30b(taxpayer, y,
        sum(collect all a: Money, v: Asset where credit_allowed_after_h7_30b(taxpayer, v, y, a), empty: 0 USD)
        - sum(collect all a: Money, v: Asset where credit_allowed_after_h7_30b(taxpayer, v, y, a) and business_use_depreciable_property_30b(taxpayer, v), empty: 0 USD));
}
@source(IRC_S30B_G, relation = formalizes, coverage = exact, quote = "the credit allowed under subsection (a) for any taxable year (determined after application of paragraph (1)) shall be treated as a credit allowable under subpart A for such taxable year.")
rule GeneralBusinessCreditComponentAlternativeMotorVehicleRule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when alternative_motor_vehicle_credit_business_portion_30b(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, AlternativeMotorVehicleCredit30B, amount);
}

pub relation basis_reduction_30b(taxpayer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30B(h)(4): the basis of the property is reduced by the credit allowed under subsection (a) (determined without regard to subsection (g))";
}
@source(IRC_S30B_H, relation = formalizes, coverage = exact, quote = "For purposes of this subtitle, the basis of any property for which a credit is allowable under subsection (a) shall be reduced by the amount of such credit so allowed (determined without regard to subsection (g)).")
rule BasisReduction30bRule(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) strict {
    when credit_allowed_after_h7_30b(taxpayer, vehicle, y, amount);
    then basis_reduction_30b(taxpayer, vehicle, amount);
}
pub relation deduction_or_credit_before_h5_30b(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the deduction or other credit allowable under chapter 1 for the incremental cost (vehicles of (e)) or for the vehicle (vehicles of (b) or (c)) before the reduction (section 30B(h)(5)) — case-asserted";
}
pub relation deduction_or_credit_after_h5_30b(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30B(h)(5): any deduction or other credit allowable for the incremental cost taken into account under (e), or for a vehicle described in (b) or (c), is reduced by the amount of the credit attributable to it";
}
@source(IRC_S30B_H, relation = formalizes, coverage = partial, quote = "The amount of any deduction or other credit allowable under this chapter—")
rule DeductionOrCreditAfterH5Rule(taxpayer: Person, vehicle: Asset, y: TaxableYear, before: Money, credit: Money) strict {
    when deduction_or_credit_before_h5_30b(taxpayer, vehicle, y, before);
    when credit_allowed_after_h7_30b(taxpayer, vehicle, y, credit);
    then deduction_or_credit_after_h5_30b(taxpayer, vehicle, y, max(before - credit, 0 USD));
}
pub relation vehicle_use_described_in_50b3_or_4_not_leased_30b(vehicle: Asset) kind empirical {
    label en official "the vehicle's use is described in section 50(b)(3) or (4) and the vehicle is not subject to a lease (section 30B(h)(6)) — case-asserted";
}
pub relation seller_discloses_credit_amount_in_document_30b(seller: Person, vehicle: Asset) kind empirical {
    label en official "the seller clearly discloses to the user in a document the amount of any credit allowable under subsection (a) (determined without regard to (g)) (section 30B(h)(6)) — case-asserted";
}
pub relation sold_by_30b(seller: Person, vehicle: Asset, user: Person) kind empirical {
    label en official "the seller sold the vehicle to the person or entity using it — case-asserted";
}
pub relation seller_treated_as_taxpayer_that_placed_in_service_30b(seller: Person, vehicle: Asset) kind institutional {
    label en official "section 30B(h)(6): for a vehicle whose use is described in section 50(b)(3) or (4) and not subject to a lease, the seller is treated as the taxpayer that placed it in service, but only if the seller discloses the credit amount in a document";
}
@source(IRC_S30B_H, relation = formalizes, coverage = partial, quote = "In the case of a vehicle whose use is described in paragraph (3) or (4) of section 50(b) and which is not subject to a lease, the person who sold such vehicle to the person or entity using such vehicle shall be treated as the taxpayer that placed such vehicle in service, but only if such person clearly discloses to such person or entity in a document the amount of any credit allowable under subsection (a) with respect to such vehicle (determined without regard to subsection (g)).")
rule SellerTreatedAsTaxpayer30bRule(seller: Person, vehicle: Asset, user: Person) strict {
    when sold_by_30b(seller, vehicle, user);
    when vehicle_use_described_in_50b3_or_4_not_leased_30b(vehicle);
    when seller_discloses_credit_amount_in_document_30b(seller, vehicle);
    then seller_treated_as_taxpayer_that_placed_in_service_30b(seller, vehicle);
}
