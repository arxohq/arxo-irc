// Section 42 — Low-income housing credit ("LIHTC"). Stage 2 (IRC-06 stage
// 2, DECISION-0379). Priority list item: §42(a)-(b),(g).
//
// Judgment calls:
// * §42(a)/(c): `qualified_basis` (applicable fraction times eligible
//   basis) is read as a case-asserted aggregate per building — this
//   package does not derive (c)(1)'s unit-fraction/floor-space-fraction
//   or (d)'s eligible-basis computation this pass. TECH_GAP.
// * §42(b)(1) (the Secretary-prescribed monthly percentage yielding a
//   70/30-percent-present-value credit, discounted at 72 percent of the
//   blended mid-term/long-term AFR) is EXTERNAL_DEPENDENCY/SOURCE_GAP: the
//   Secretary's published monthly percentage is not pinned in this corpus.
//   Only the (b)(2)/(b)(3) STATUTORY FLOORS (9 percent for non-federally-
//   subsidized new buildings, 4 percent otherwise, for buildings placed in
//   service after the relevant enactment dates) are modelled as exact
//   rules — the priority list's own "9%/4% floors" item.
// * §42(g)(1)'s three minimum-set-aside tests (20-50, 40-60, average
//   income) are modelled as exact percentage/income-limitation tests
//   against a case-asserted PROJECT-LEVEL rent-restricted/occupied-unit
//   count and area median gross income, per the taxpayer's own election
//   among (A)/(B)/(C) (mirroring the §25B saver-bracket idiom: exact
//   breakpoints, not an evaluative "is this project low-income enough"
//   judgment). (g)(2)'s rent-restriction/gross-rent/next-available-unit
//   mechanics are NOT modelled — TECH_GAP.
// * §42(h) (state housing credit ceiling, $2.75-per-capita indexed) is NOT
//   reached this pass — SOURCE_GAP on the per-capita dollar amount for any
//   real year (same class as §32(j)'s cost-of-living multiplier gap this
//   package already carries from stage 1).

// --- §42(g): qualified low-income housing project (minimum set-aside) -------------

use self::{
    Asset,
    IRC_S42_A,
    IRC_S42_B,
    IRC_S42_G,
    IRC_S42_H,
    Person,
    TaxableYear,
    federally_subsidized_by_i2_42,
    low_income_housing_credit_after_h_limits_42,
    qualified_basis_for_credit_42,
    section_42_limits_path_applies_42,
};

pub enum MinimumSetAsideElection {
    TwentyFifty,
    FortySixty,
    AverageIncome,
}
relation minimum_set_aside_election(project: Asset, election: MinimumSetAsideElection) kind empirical {
    label en official "the taxpayer's irrevocable election among the section 42(g)(1)(A)-(C) minimum set-aside tests";
}
relation percent_units_rent_restricted_at_or_below_50_pct_ami(project: Asset, pct: Decimal) kind empirical {
    label en official "the percentage of residential units in the project that are both rent-restricted and occupied by individuals whose income is 50 percent or less of area median gross income (section 42(g)(1)(A))";
}
relation percent_units_rent_restricted_at_or_below_60_pct_ami(project: Asset, pct: Decimal) kind empirical {
    label en official "the percentage of residential units in the project that are both rent-restricted and occupied by individuals whose income is 60 percent or less of area median gross income (section 42(g)(1)(B))";
}
relation percent_units_rent_restricted_average_income_test(project: Asset, pct: Decimal) kind empirical {
    label en official "the percentage of residential units in the project that are both rent-restricted and occupied by individuals whose income does not exceed the taxpayer-designated imputed income limitation for the unit, where the average of the designated limitations does not exceed 60 percent of area median gross income (section 42(g)(1)(C))";
}

pub relation qualified_low_income_housing_project(project: Asset) kind institutional {
    label en official "a qualified low-income housing project under section 42(g)(1): the project meets whichever of the 20-50, 40-60, or average income minimum set-aside tests the taxpayer elected";
}
@source(IRC_S42_G, quote = "The project meets the requirements of this subparagraph if 20 percent or more of the residential units in such project are both rent-restricted and occupied by individuals whose income is 50 percent or less of area median gross income.")
rule QualifiedLowIncomeHousingProject2050 strict {
    for project: Asset;
    for pct: Decimal;
    when minimum_set_aside_election(project, TwentyFifty);
    when percent_units_rent_restricted_at_or_below_50_pct_ami(project, pct);
    when pct >= 0.20;
    then qualified_low_income_housing_project(project);
}
@source(IRC_S42_G, quote = "The project meets the requirements of this subparagraph if 40 percent or more of the residential units in such project are both rent-restricted and occupied by individuals whose income is 60 percent or less of area median gross income.")
rule QualifiedLowIncomeHousingProject4060 strict {
    for project: Asset;
    for pct: Decimal;
    when minimum_set_aside_election(project, FortySixty);
    when percent_units_rent_restricted_at_or_below_60_pct_ami(project, pct);
    when pct >= 0.40;
    then qualified_low_income_housing_project(project);
}
@source(IRC_S42_G, quote = "The project meets the minimum requirements of this subparagraph if 40 percent or more (25 percent or more in the case of a project described in section 142(d)(6)) of the residential units in such project are both rent-restricted and occupied by individuals whose income does not exceed the imputed income limitation designated by the taxpayer with respect to the respective unit.")
rule QualifiedLowIncomeHousingProjectAverageIncome strict {
    for project: Asset;
    for pct: Decimal;
    when minimum_set_aside_election(project, AverageIncome);
    when percent_units_rent_restricted_average_income_test(project, pct);
    when pct >= 0.40;
    then qualified_low_income_housing_project(project);
}

// --- §42(b)(2)-(3): statutory applicable-percentage floors -------------------------

relation federally_subsidized_for_taxable_year(building: Asset, y: TaxableYear) kind empirical {
    label en official "the building is federally subsidized for the taxable year (section 42(b)(2)(B)/(i))";
}
relation applicable_percentage_secretary_prescribed(building: Asset, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the Secretary-prescribed monthly applicable percentage before applying the section 42(b)(2)/(3) statutory floor — EXTERNAL_DEPENDENCY/SOURCE_GAP: the present-value/discount-rate computation of section 42(b)(1)(B)-(C) is not modelled";
}
pub relation applicable_percentage_42b(building: Asset, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the applicable percentage for the building (section 42(b)), after the section 42(b)(2) 9-percent or section 42(b)(3) 4-percent statutory floor";
}
@source(IRC_S42_B, quote = "the applicable percentage shall not be less than 9 percent")
rule ApplicablePercentage9PercentFloor strict {
    for building: Asset;
    for y: TaxableYear;
    for secretary_pct: Decimal;
    when not federally_subsidized_for_taxable_year(building, y);
    when not_known(federally_subsidized_by_i2_42(building, y));
    when applicable_percentage_secretary_prescribed(building, y, secretary_pct);
    then applicable_percentage_42b(building, y, max(secretary_pct, 0.09));
}
@source(IRC_S42_B, quote = "In the case of any new or existing building to which paragraph (2) does not apply and which is placed in service by the taxpayer after December 31, 2020, the applicable percentage shall not be less than 4 percent.")
rule ApplicablePercentage4PercentFloor strict {
    for building: Asset;
    for y: TaxableYear;
    for secretary_pct: Decimal;
    when federally_subsidized_for_taxable_year(building, y);
    when applicable_percentage_secretary_prescribed(building, y, secretary_pct);
    then applicable_percentage_42b(building, y, max(secretary_pct, 0.04));
}

// --- §42(a): amount of credit -------------------------------------------------------

pub relation qualified_basis(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified basis of the qualified low-income building for the taxable year (section 42(c)(1)) — case-asserted (the applicable-fraction/eligible-basis derivation of (c)/(d) is TECH_GAP, not modelled this pass)";
}
pub relation within_credit_period_42f(building: Asset, y: TaxableYear) kind empirical {
    label en official "the taxable year is within the 10-taxable-year credit period beginning with the taxable year the building is placed in service (or, if elected, the succeeding taxable year) — section 42(f)(1)";
}

pub relation low_income_housing_building_owned_by(building: Asset, taxpayer: Person) kind empirical {
    label en official "the taxpayer holds the ownership interest in the qualified low-income building for which the credit under section 42 is claimed";
}
pub relation low_income_housing_credit_component(building: Asset, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 42 low-income housing credit for one qualified low-income building for the taxable year: the applicable percentage of the qualified basis";
}
@source(IRC_S42_A, quote = "the amount of the low-income housing credit determined under this section for any taxable year in the credit period shall be an amount equal to—\n(1) the applicable percentage of\n(2) the qualified basis of each qualified low-income building.")
rule LowIncomeHousingCreditComponent defeasible {
    for building: Asset;
    for taxpayer: Person;
    for y: TaxableYear;
    for pct: Decimal;
    for basis: Money;
    when low_income_housing_building_owned_by(building, taxpayer);
    when qualified_low_income_housing_project(building);
    when within_credit_period_42f(building, y);
    when applicable_percentage_42b(building, y, pct);
    when qualified_basis_for_credit_42(building, taxpayer, y, basis);
    then low_income_housing_credit_component(building, taxpayer, y, round(pct * basis, 2, "HALF_UP"));
}

pub relation low_income_housing_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 42 low-income housing credit for the taxable year: the sum across all of the taxpayer's qualified low-income buildings";
}
rule LowIncomeHousingCreditTotal defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for one_building: Asset;
    for one_amount: Money;
    when low_income_housing_credit_component(one_building, taxpayer, y, one_amount);
    then low_income_housing_credit(taxpayer, y,
        sum all amount: Money for building: Asset where low_income_housing_credit_component(building, taxpayer, y, amount));
    // Stage 2e: where the section 42(h) limits path (42d) applies to the taxpayer's buildings, the credit read by
    // section 38(b)(5) is the credit after those limits (rule below), not this stage 2 total.
    unless section_42_limits_path_applies_42(taxpayer, y)
        and low_income_housing_credit_component(one_building, taxpayer, y, one_amount);
}
@source(IRC_S42_H, relation = formalizes, coverage = partial, quote = "The amount of the credit determined under this section for any taxable year with respect to any building shall not exceed the housing credit dollar amount allocated to such building under this subsection.")
rule LowIncomeHousingCreditAfterHLimitsTotal defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when low_income_housing_credit_after_h_limits_42(taxpayer, y, amount);
    then low_income_housing_credit(taxpayer, y, amount);
}
