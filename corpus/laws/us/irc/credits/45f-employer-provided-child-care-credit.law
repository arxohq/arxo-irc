// Section 45F — Employer-provided child care credit. Stage 2d (IRC-06,
// DECISION-0379).
//
// Base edition (2024): 25 percent of qualified child care expenditures plus 10
// percent of qualified child care resource and referral expenditures, capped
// at $150,000. PL 119-21 section 70401 (pinned as
// `us.irc.temporal::PL119_21_S70401`, applying to amounts paid or incurred
// after 2025-12-31) raises the first rate to 40 percent (50 percent for an
// eligible small business), the cap to $500,000 ($600,000) and indexes the
// caps for taxable years beginning after 2026. Two editions by `legal_time`
// (`effective` windows, enacted 2025-07-04, not a `revision`: the temporal
// package pins the Public Law as separate fragments), and the amounts are
// split by the taxable year's beginning date (2026-01-01); a fiscal year
// straddling 2025-12-31 is mis-assigned (TECH-GAPS G1540).
//
// Scope / judgment calls:
// * A facility is a qualified child care facility only if its use test
//   ((c)(2)(A)(i) principal use, or the operator residence carve-out), local
//   law and licensing, open enrollment, the 30 percent dependents rule for a
//   facility that is the taxpayer's principal business, and non-discrimination
//   in favor of highly compensated employees are all met (case facts).
//   Qualified expenditures per facility are limited to fair market value.
// * (d): recapture on cessation of operation or disposition, by the applicable
//   percentage of the table (`45f-recapture-percentage.lawtable.json`,
//   anchored to IRC_S45F_TABLE_1) times the aggregate prior decrease of credits
//   (a case-asserted amount). The assumption agreement and the casualty
//   restoration exceptions gate the recapture event. The tax benefit rule
//   (d)(4)(A)-(B) is not applied (G1540).

use self::{
    Asset,
    IRC_S45F_A,
    IRC_S45F_B,
    IRC_S45F_C,
    IRC_S45F_D,
    IRC_S45F_F,
    Person,
    TaxableYear,
};

pub relation principal_use_child_care_assistance_45f(facility: Asset) kind empirical {
    label en official "the principal use of the facility is to provide child care assistance (section 45F(c)(2)(A)(i)) — case-asserted";
}
pub relation principal_residence_of_operator_45f(facility: Asset) kind empirical {
    label en official "the facility is the principal residence (within the meaning of section 121) of the operator of the facility (section 45F(c)(2)(A), last sentence) — case-asserted";
}
pub relation meets_local_law_and_licensing_45f(facility: Asset) kind empirical {
    label en official "the facility meets the requirements of all applicable laws and regulations of the State or local government, including licensing as a child care facility (section 45F(c)(2)(A)(ii)) — case-asserted";
}
pub relation enrollment_open_to_employees_45f(facility: Asset, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "enrollment in the facility is open to employees of the taxpayer during the taxable year (section 45F(c)(2)(B)(i)) — case-asserted";
}
pub relation facility_is_principal_business_45f(facility: Asset, taxpayer: Person) kind empirical {
    label en official "the facility is the principal trade or business of the taxpayer — case-asserted";
}
pub relation share_of_enrollees_employee_dependents_45f(facility: Asset, taxpayer: Person, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the facility's enrollees who are dependents of employees of the taxpayer (section 45F(c)(2)(B)(ii)) — case-asserted";
}
pub relation facility_use_discriminates_in_favor_of_hce_45f(facility: Asset) kind empirical {
    label en official "the use of the facility (or the eligibility to use it) discriminates in favor of highly compensated employees within the meaning of section 414(q) (section 45F(c)(2)(B)(iii)) — case-asserted";
}
pub relation child_care_expenditure_45f(taxpayer: Person, y: TaxableYear, facility: Asset, paid: Money, fair_value: Money) kind empirical {
    label en official "an amount paid or incurred for a facility (acquisition, construction, rehabilitation or expansion of depreciable property; operating costs; or a contract for child care services, section 45F(c)(1)(A)) and the fair market value of the care (section 45F(c)(1)(B)) — case-asserted";
}
pub relation resource_referral_expenditures_45f(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid or incurred under a contract to provide child care resource and referral services to an employee (section 45F(c)(3)(A)) — case-asserted";
}
pub relation resource_referral_discriminates_in_favor_of_hce_45f(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the resource and referral services (or eligibility to use them) discriminate in favor of highly compensated employees (section 45F(c)(3)(B)) — case-asserted";
}
pub relation eligible_small_business_45f(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer is an eligible small business: it meets the section 448(c) gross receipts test with 5-taxable-year substitutions (section 45F(c)(4), added by PL 119-21 section 70401) — case-asserted";
}
pub relation cost_of_living_adjustment_45f(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the section 1(f)(3) cost-of-living adjustment for the calendar year in which the taxable year begins, with 2025 substituted for 2016 (section 45F(b)(2), as amended) — case-asserted, not pinned";
}

// --- (c)(2): qualified child care facility ------------------------------------------------

relation facility_use_test_45f(facility: Asset) kind institutional;
@source(IRC_S45F_C, quote = "the principal use of which is to provide child care assistance")
rule FacilityUseTestPrincipalUse45fRule(facility: Asset) strict {
    when principal_use_child_care_assistance_45f(facility);
    then facility_use_test_45f(facility);
}
@source(IRC_S45F_C, quote = "Clause (i) shall not apply to a facility which is the principal residence (within the meaning of section 121) of the operator of the facility.")
rule FacilityUseTestOperatorResidence45fRule(facility: Asset) strict {
    when principal_residence_of_operator_45f(facility);
    then facility_use_test_45f(facility);
}
pub relation qualified_child_care_facility_45f(facility: Asset, taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45F(c)(2): a qualified child care facility of the taxpayer for the taxable year";
}
@source(IRC_S45F_C, quote = "enrollment in the facility is open to employees of the taxpayer during the taxable year")
rule QualifiedChildCareFacilityNotPrincipalBusiness45fRule(facility: Asset, taxpayer: Person, y: TaxableYear) strict {
    when facility_use_test_45f(facility);
    when meets_local_law_and_licensing_45f(facility);
    when enrollment_open_to_employees_45f(facility, taxpayer, y);
    when not_known(facility_is_principal_business_45f(facility, taxpayer));
    when not_known(facility_use_discriminates_in_favor_of_hce_45f(facility));
    then qualified_child_care_facility_45f(facility, taxpayer, y);
}
@source(IRC_S45F_C, quote = "if the facility is the principal trade or business of the taxpayer, at least 30 percent of the enrollees of such facility are dependents of employees of the taxpayer")
rule QualifiedChildCareFacilityPrincipalBusiness45fRule(facility: Asset, taxpayer: Person, y: TaxableYear, share: Decimal) strict {
    when facility_use_test_45f(facility);
    when meets_local_law_and_licensing_45f(facility);
    when enrollment_open_to_employees_45f(facility, taxpayer, y);
    when facility_is_principal_business_45f(facility, taxpayer);
    when share_of_enrollees_employee_dependents_45f(facility, taxpayer, y, share);
    when share >= 30.0;
    when not_known(facility_use_discriminates_in_favor_of_hce_45f(facility));
    then qualified_child_care_facility_45f(facility, taxpayer, y);
}

// --- (c)(1), (c)(3): qualified expenditures -------------------------------------------------

pub relation qualified_child_care_expenditure_of_facility_45f(taxpayer: Person, y: TaxableYear, facility: Asset, amount: Money) kind institutional {
    label en official "section 45F(c)(1): the expenditure for a qualified facility, not in excess of the fair market value of the care";
}
@source(IRC_S45F_C, quote = "The term \"qualified child care expenditures\" shall not include expenses in excess of the fair market value of such care.")
rule QualifiedChildCareExpenditureOfFacility45fRule(taxpayer: Person, y: TaxableYear, facility: Asset, paid: Money, fair_value: Money) strict {
    when qualified_child_care_facility_45f(facility, taxpayer, y);
    when child_care_expenditure_45f(taxpayer, y, facility, paid, fair_value);
    then qualified_child_care_expenditure_of_facility_45f(taxpayer, y, facility, min(paid, fair_value));
}
pub relation qualified_child_care_expenditures_45f(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified child care expenditures of the taxpayer for the taxable year";
}
rule QualifiedChildCareExpenditures45fRule(taxpayer: Person, y: TaxableYear, facility: Asset, amount: Money) strict {
    when qualified_child_care_expenditure_of_facility_45f(taxpayer, y, facility, amount);
    then qualified_child_care_expenditures_45f(taxpayer, y,
        sum(collect all a: Money, f: Asset where qualified_child_care_expenditure_of_facility_45f(taxpayer, y, f, a), empty: 0 USD));
}
pub relation qualified_resource_referral_expenditures_45f(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45F(c)(3): resource and referral expenditures whose services do not discriminate in favor of highly compensated employees";
}
@source(IRC_S45F_C, quote = "The services shall not be treated as qualified unless the provision of such services (or the eligibility to use such services) does not discriminate in favor of employees of the taxpayer who are highly compensated employees")
rule QualifiedResourceReferralExpenditures45fRule(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    when resource_referral_expenditures_45f(taxpayer, y, amount);
    when not_known(resource_referral_discriminates_in_favor_of_hce_45f(taxpayer, y));
    then qualified_resource_referral_expenditures_45f(taxpayer, y, amount);
}
relation qualified_resource_referral_expenditures_or_zero_45f(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional;
rule ResourceReferralOrZeroPresent45fRule(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    when qualified_resource_referral_expenditures_45f(taxpayer, y, amount);
    then qualified_resource_referral_expenditures_or_zero_45f(taxpayer, y, amount);
}
relation has_qualified_resource_referral_45f(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasQualifiedResourceReferral45fRule(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    when qualified_resource_referral_expenditures_45f(taxpayer, y, amount);
    then has_qualified_resource_referral_45f(taxpayer, y);
}
rule ResourceReferralOrZeroAbsent45fRule(taxpayer: Person, y: TaxableYear, q: Money) strict {
    when qualified_child_care_expenditures_45f(taxpayer, y, q);
    when not_known(has_qualified_resource_referral_45f(taxpayer, y));
    then qualified_resource_referral_expenditures_or_zero_45f(taxpayer, y, 0 USD);
}

// --- (a), (b): rates and dollar limitation, base edition and PL 119-21 ---------------------

pub relation child_care_rate_45f(taxpayer: Person, y: TaxableYear, rate: Decimal) kind institutional {
    label en official "section 45F(a)(1): 25 percent; 40 percent (50 percent for an eligible small business) for amounts paid after 2025-12-31 (PL 119-21 section 70401)";
}
@source(IRC_S45F_A, quote = "25 percent of the qualified child care expenditures")
rule ChildCareRateBase45fRule(taxpayer: Person, y: TaxableYear, begin: Date, q: Money) strict {
    when qualified_child_care_expenditures_45f(taxpayer, y, q);
    when us.irc.core::begins(y, begin);
    when begin < @2026-01-01;
    then child_care_rate_45f(taxpayer, y, 0.25);
}
rule ChildCareRateBeforeAmendment45fRule(taxpayer: Person, y: TaxableYear, begin: Date, q: Money) strict {
    effective (-infinity, @2025-07-04);
    when qualified_child_care_expenditures_45f(taxpayer, y, q);
    when us.irc.core::begins(y, begin);
    when begin >= @2026-01-01;
    then child_care_rate_45f(taxpayer, y, 0.25);
}
@source(us.irc.temporal::PL119_21_S70401, quote = "Section 45F(a)(1) is amended by striking “25 percent” and inserting “40 percent (50 percent in the case of an eligible small business)”.")
rule ChildCareRateEnhanced45fRule(taxpayer: Person, y: TaxableYear, begin: Date, q: Money) strict {
    effective [@2025-07-04, infinity);
    when qualified_child_care_expenditures_45f(taxpayer, y, q);
    when us.irc.core::begins(y, begin);
    when begin >= @2026-01-01;
    when not_known(eligible_small_business_45f(taxpayer, y));
    then child_care_rate_45f(taxpayer, y, 0.40);
}
rule ChildCareRateEnhancedSmallBusiness45fRule(taxpayer: Person, y: TaxableYear, begin: Date, q: Money) strict {
    effective [@2025-07-04, infinity);
    when qualified_child_care_expenditures_45f(taxpayer, y, q);
    when us.irc.core::begins(y, begin);
    when begin >= @2026-01-01;
    when eligible_small_business_45f(taxpayer, y);
    then child_care_rate_45f(taxpayer, y, 0.50);
}
pub relation credit_limit_45f(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45F(b): $150,000; $500,000 ($600,000 for an eligible small business) for years beginning after 2025, indexed for years beginning after 2026";
}
@source(IRC_S45F_B, quote = "The credit allowable under subsection (a) for any taxable year shall not exceed $150,000.")
rule CreditLimitBase45fRule(taxpayer: Person, y: TaxableYear, begin: Date) strict {
    when qualified_child_care_expenditures_45f(taxpayer, y, _);
    when us.irc.core::begins(y, begin);
    when begin < @2026-01-01;
    then credit_limit_45f(taxpayer, y, 150000.00 USD);
}
rule CreditLimitBeforeAmendment45fRule(taxpayer: Person, y: TaxableYear, begin: Date) strict {
    effective (-infinity, @2025-07-04);
    when qualified_child_care_expenditures_45f(taxpayer, y, _);
    when us.irc.core::begins(y, begin);
    when begin >= @2026-01-01;
    then credit_limit_45f(taxpayer, y, 150000.00 USD);
}
@source(us.irc.temporal::PL119_21_S70401, quote = "The credit allowable under subsection (a) for any taxable year shall not exceed $500,000 ($600,000 in the case of an eligible small business).")
rule CreditLimit2026Rule(taxpayer: Person, y: TaxableYear, begin: Date) strict {
    effective [@2025-07-04, infinity);
    when qualified_child_care_expenditures_45f(taxpayer, y, _);
    when us.irc.core::begins(y, begin);
    when begin >= @2026-01-01;
    when begin <= @2026-12-31;
    when not_known(eligible_small_business_45f(taxpayer, y));
    then credit_limit_45f(taxpayer, y, 500000.00 USD);
}
rule CreditLimit2026SmallBusinessRule(taxpayer: Person, y: TaxableYear, begin: Date) strict {
    effective [@2025-07-04, infinity);
    when qualified_child_care_expenditures_45f(taxpayer, y, _);
    when us.irc.core::begins(y, begin);
    when begin >= @2026-01-01;
    when begin <= @2026-12-31;
    when eligible_small_business_45f(taxpayer, y);
    then credit_limit_45f(taxpayer, y, 600000.00 USD);
}
@source(us.irc.temporal::PL119_21_S70401, quote = "In the case of any taxable year beginning after 2026, the $500,000 and $600,000 amounts in paragraph (1) shall each be increased by an amount equal to")
rule CreditLimitIndexed45fRule(taxpayer: Person, y: TaxableYear, begin: Date, cola: Decimal) strict {
    effective [@2025-07-04, infinity);
    when qualified_child_care_expenditures_45f(taxpayer, y, _);
    when us.irc.core::begins(y, begin);
    when begin > @2026-12-31;
    when not_known(eligible_small_business_45f(taxpayer, y));
    when cost_of_living_adjustment_45f(y, cola);
    then credit_limit_45f(taxpayer, y, round(500000.00 USD * (1.0 + cola), 2, "HALF_UP"));
}
rule CreditLimitIndexedSmallBusiness45fRule(taxpayer: Person, y: TaxableYear, begin: Date, cola: Decimal) strict {
    effective [@2025-07-04, infinity);
    when qualified_child_care_expenditures_45f(taxpayer, y, _);
    when us.irc.core::begins(y, begin);
    when begin > @2026-12-31;
    when eligible_small_business_45f(taxpayer, y);
    when cost_of_living_adjustment_45f(y, cola);
    then credit_limit_45f(taxpayer, y, round(600000.00 USD * (1.0 + cola), 2, "HALF_UP"));
}
pub relation employer_provided_child_care_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45F employer-provided child care credit for the taxable year (a section 38(b)(15) component)";
}
@source(IRC_S45F_A, quote = "10 percent of the qualified child care resource and referral expenditures")
rule EmployerProvidedChildCareCredit45fRule(taxpayer: Person, y: TaxableYear, rate: Decimal, q: Money, r: Money, limit: Money) defeasible {
    when child_care_rate_45f(taxpayer, y, rate);
    when qualified_child_care_expenditures_45f(taxpayer, y, q);
    when qualified_resource_referral_expenditures_or_zero_45f(taxpayer, y, r);
    when credit_limit_45f(taxpayer, y, limit);
    then employer_provided_child_care_credit(taxpayer, y, min(round(rate * q + 0.10 * r, 2, "HALF_UP"), limit));
}
pub relation other_deduction_or_credit_disallowed_45f(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45F(f)(2): no deduction or credit under any other provision of chapter 1 for the amount of the credit";
}
@source(IRC_S45F_F, quote = "No deduction or credit shall be allowed under any other provision of this chapter with respect to the amount of the credit determined under this section.")
rule OtherDeductionOrCreditDisallowed45fRule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when employer_provided_child_care_credit(taxpayer, y, amount);
    then other_deduction_or_credit_disallowed_45f(taxpayer, y, amount);
}

// --- (d): recapture ----------------------------------------------------------------------------

relation recapture_percentage_45f(facility_year_number: Decimal, pct: Decimal) kind institutional;
pub relation facility_operation_ceased_45f(taxpayer: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the operation of the facility as a qualified child care facility ceases during the taxable year (section 45F(d)(3)(A)) — case-asserted";
}
pub relation casualty_loss_restored_45f(taxpayer: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the cessation is by reason of a casualty loss restored by reconstruction or replacement within a reasonable period established by the Secretary (section 45F(d)(4)(C)) — case-asserted";
}
pub relation facility_interest_disposed_45f(taxpayer: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer disposes of its interest in the facility during the taxable year (section 45F(d)(3)(B)(i)) — case-asserted";
}
pub relation acquirer_assumes_recapture_liability_in_writing_45f(taxpayer: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the person acquiring the interest agrees in writing to assume the recapture liability (section 45F(d)(3)(B)(ii)) — case-asserted";
}
pub relation facility_year_number_45f(facility: Asset, y: TaxableYear, n: Decimal) kind empirical {
    label en official "the year number of the taxable year counted from year 1, the first day of the taxable year in which the facility is placed in service (section 45F(d)(2)(B)) — case-asserted";
}
pub relation prior_credit_decrease_if_expenditures_zero_45f(taxpayer: Person, facility: Asset, amount: Money) kind empirical {
    label en official "the aggregate decrease in the section 38 credits allowed for prior taxable years that would have resulted if the (c)(1)(A) expenditures for the facility had been zero (section 45F(d)(1)(B)) — case-asserted";
}
pub relation recapture_event_45f(taxpayer: Person, facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45F(d)(3): a recapture event for the facility at the close of the taxable year";
}
@source(IRC_S45F_D, quote = "The cessation of the operation of the facility as a qualified child care facility.")
rule RecaptureEventCessation45fRule(taxpayer: Person, facility: Asset, y: TaxableYear) strict {
    when facility_operation_ceased_45f(taxpayer, facility, y);
    when not_known(casualty_loss_restored_45f(taxpayer, facility, y));
    then recapture_event_45f(taxpayer, facility, y);
}
@source(IRC_S45F_D, quote = "the disposition of a taxpayer's interest in a qualified child care facility with respect to which the credit described in subsection (a) was allowable")
rule RecaptureEventDisposition45fRule(taxpayer: Person, facility: Asset, y: TaxableYear) strict {
    when facility_interest_disposed_45f(taxpayer, facility, y);
    when not_known(acquirer_assumes_recapture_liability_in_writing_45f(taxpayer, facility, y));
    then recapture_event_45f(taxpayer, facility, y);
}
pub relation child_care_recapture_tax_increase_45f(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45F(d)(1): the increase of the tax for the year: the applicable recapture percentage times the aggregate prior decrease of credits";
}
@source(IRC_S45F_D, quote = "then the tax of the taxpayer under this chapter for such taxable year shall be increased by an amount equal to the product of")
rule ChildCareRecaptureTaxIncrease45fRule(taxpayer: Person, facility: Asset, y: TaxableYear, n: Decimal, pct: Decimal, decrease: Money) defeasible {
    when recapture_event_45f(taxpayer, facility, y);
    when facility_year_number_45f(facility, y, n);
    when recapture_percentage_45f(n, pct);
    when prior_credit_decrease_if_expenditures_zero_45f(taxpayer, facility, decrease);
    then child_care_recapture_tax_increase_45f(taxpayer, facility, y, round(pct * decrease, 2, "HALF_UP"));
}
