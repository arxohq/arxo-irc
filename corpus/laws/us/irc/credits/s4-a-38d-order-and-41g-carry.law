// ---- (d)(2): the components of the investment credit, in the order of section 46 ----

pub relation investment_credit_used_38d2(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the investment credit used in the year, the amount split among the section 46 components (section 38(d)(2))";
}
rule InvestmentCreditUsedFromComponentUse(taxpayer: Person, y: TaxableYear, used: Money) defeasible {
    label en official "the used amount of the investment credit component of section 38(b)(1)";
    when component_credit_used_38d(taxpayer, y, InvestmentCredit46, used);
    then investment_credit_used_38d2(taxpayer, y, used);
}
relation investment_component_present_38d2(taxpayer: Person, y: TaxableYear, component: InvestmentCreditComponent46) kind institutional {
    label en official "bridge: the section 46 component has an amount for the year";
}
rule InvestmentComponentPresent38d2(taxpayer: Person, y: TaxableYear, component: InvestmentCreditComponent46, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when investment_credit_component_46(taxpayer, y, component, amount);
    then investment_component_present_38d2(taxpayer, y, component);
}
pub relation investment_component_used_38d2(taxpayer: Person, y: TaxableYear, component: InvestmentCreditComponent46, amount: Money) kind institutional {
    label en official "the part of the section 46 component used in the year, in the order of the list of section 46 (section 38(d)(2))";
}
pub relation investment_component_unused_38d2(taxpayer: Person, y: TaxableYear, component: InvestmentCreditComponent46, amount: Money) kind institutional {
    label en official "the part of the section 46 component not used in the year (section 38(d)(2))";
}
relation investment_use_cumulative_38d2_0(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative amounts of the section 46 components listed before the first one: zero";
}
rule InvestmentUseCumulativeStart(taxpayer: Person, y: TaxableYear, used: Money) defeasible {
    label en official "the walk starts at the first section 46 component";
    when investment_credit_used_38d2(taxpayer, y, used);
    then investment_use_cumulative_38d2_0(taxpayer, y, 0 USD);
}
relation investment_use_cumulative_38d2_1(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative amounts of the section 46 components listed through number 1 (RehabilitationCredit47)";
}
@source(IRC_S38_D, quote = "The order in which the credits listed in section 46 are used shall be determined on the basis of the order in which such credits are listed in section 46 as of the close of the taxable year in which the credit is used.")
rule InvestmentUse38d2Position1Sum(taxpayer: Person, y: TaxableYear, cum: Money, c: Money) defeasible {
    label en official "section 46 component number 1 (RehabilitationCredit47): add its amount";
    when investment_use_cumulative_38d2_0(taxpayer, y, cum);
    when investment_credit_component_46(taxpayer, y, RehabilitationCredit47, c);
    then investment_use_cumulative_38d2_1(taxpayer, y, cum + c);
}
rule InvestmentUse38d2Position1Used(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 1 (RehabilitationCredit47): used = the lesser of its amount and what is left of the investment credit used";
    when investment_use_cumulative_38d2_0(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, RehabilitationCredit47, c);
    then investment_component_used_38d2(taxpayer, y, RehabilitationCredit47, min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position1Unused(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 1 (RehabilitationCredit47): the rest is unused";
    when investment_use_cumulative_38d2_0(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, RehabilitationCredit47, c);
    then investment_component_unused_38d2(taxpayer, y, RehabilitationCredit47, c - min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position1Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "section 46 component number 1 (RehabilitationCredit47) has no amount: the cumulative sum stays";
    when investment_use_cumulative_38d2_0(taxpayer, y, cum);
    when not_known(investment_component_present_38d2(taxpayer, y, RehabilitationCredit47));
    then investment_use_cumulative_38d2_1(taxpayer, y, cum);
}
relation investment_use_cumulative_38d2_2(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative amounts of the section 46 components listed through number 2 (EnergyCredit48)";
}
@source(IRC_S38_D, quote = "The order in which the credits listed in section 46 are used shall be determined on the basis of the order in which such credits are listed in section 46 as of the close of the taxable year in which the credit is used.")
rule InvestmentUse38d2Position2Sum(taxpayer: Person, y: TaxableYear, cum: Money, c: Money) defeasible {
    label en official "section 46 component number 2 (EnergyCredit48): add its amount";
    when investment_use_cumulative_38d2_1(taxpayer, y, cum);
    when investment_credit_component_46(taxpayer, y, EnergyCredit48, c);
    then investment_use_cumulative_38d2_2(taxpayer, y, cum + c);
}
rule InvestmentUse38d2Position2Used(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 2 (EnergyCredit48): used = the lesser of its amount and what is left of the investment credit used";
    when investment_use_cumulative_38d2_1(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, EnergyCredit48, c);
    then investment_component_used_38d2(taxpayer, y, EnergyCredit48, min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position2Unused(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 2 (EnergyCredit48): the rest is unused";
    when investment_use_cumulative_38d2_1(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, EnergyCredit48, c);
    then investment_component_unused_38d2(taxpayer, y, EnergyCredit48, c - min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position2Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "section 46 component number 2 (EnergyCredit48) has no amount: the cumulative sum stays";
    when investment_use_cumulative_38d2_1(taxpayer, y, cum);
    when not_known(investment_component_present_38d2(taxpayer, y, EnergyCredit48));
    then investment_use_cumulative_38d2_2(taxpayer, y, cum);
}
