    when credit_use_cumulative_38d_27(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, DifferentialWagePaymentCredit45P, c);
    then component_credit_unused_38d(taxpayer, y, DifferentialWagePaymentCredit45P, c - min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition28Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "component number 28 of section 38(b) (DifferentialWagePaymentCredit45P) has no amount: the cumulative sum stays";
    when credit_use_cumulative_38d_27(taxpayer, y, cum);
    when not_known(component_amount_present_38d(taxpayer, y, DifferentialWagePaymentCredit45P));
    then credit_use_cumulative_38d_28(taxpayer, y, cum);
}
relation credit_use_cumulative_38d_29(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative current year credits of the components listed through number 29 (CarbonOxideSequestrationCredit45Q)";
}
@source(IRC_S38_D, quote = "The order in which such credits are used shall be determined on the basis of the order in which they are listed in subsection (b) as of the close of the taxable year in which the credit is used.")
rule CreditUse38dPosition29Sum(taxpayer: Person, y: TaxableYear, cum: Money, c: Money) defeasible {
    label en official "component number 29 of section 38(b) (CarbonOxideSequestrationCredit45Q): add its amount to the cumulative sum";
    when credit_use_cumulative_38d_28(taxpayer, y, cum);
    when general_business_credit_component_amount(taxpayer, y, CarbonOxideSequestrationCredit45Q, c);
    then credit_use_cumulative_38d_29(taxpayer, y, cum + c);
}
rule CreditUse38dPosition29Used(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 29 of section 38(b) (CarbonOxideSequestrationCredit45Q): used = the lesser of its amount and the limitation left after the earlier components";
    when credit_use_cumulative_38d_28(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, CarbonOxideSequestrationCredit45Q, c);
    then component_credit_used_38d(taxpayer, y, CarbonOxideSequestrationCredit45Q, min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition29Unused(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 29 of section 38(b) (CarbonOxideSequestrationCredit45Q): the rest is unused";
    when credit_use_cumulative_38d_28(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, CarbonOxideSequestrationCredit45Q, c);
    then component_credit_unused_38d(taxpayer, y, CarbonOxideSequestrationCredit45Q, c - min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition29Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "component number 29 of section 38(b) (CarbonOxideSequestrationCredit45Q) has no amount: the cumulative sum stays";
