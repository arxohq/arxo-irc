    when credit_use_cumulative_38d_37(taxpayer, y, cum);
    when general_business_credit_component_amount(taxpayer, y, AdvancedManufacturingProductionCredit45X, c);
    then credit_use_cumulative_38d_38(taxpayer, y, cum + c);
}
rule CreditUse38dPosition38Used(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 38 of section 38(b) (AdvancedManufacturingProductionCredit45X): used = the lesser of its amount and the limitation left after the earlier components";
    when credit_use_cumulative_38d_37(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, AdvancedManufacturingProductionCredit45X, c);
    then component_credit_used_38d(taxpayer, y, AdvancedManufacturingProductionCredit45X, min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition38Unused(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 38 of section 38(b) (AdvancedManufacturingProductionCredit45X): the rest is unused";
    when credit_use_cumulative_38d_37(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, AdvancedManufacturingProductionCredit45X, c);
    then component_credit_unused_38d(taxpayer, y, AdvancedManufacturingProductionCredit45X, c - min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition38Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "component number 38 of section 38(b) (AdvancedManufacturingProductionCredit45X) has no amount: the cumulative sum stays";
    when credit_use_cumulative_38d_37(taxpayer, y, cum);
    when not_known(component_amount_present_38d(taxpayer, y, AdvancedManufacturingProductionCredit45X));
    then credit_use_cumulative_38d_38(taxpayer, y, cum);
}
relation credit_use_cumulative_38d_39(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative current year credits of the components listed through number 39 (CleanElectricityProductionCredit45Y)";
}
