// Stage 4 (DECISION-0379 with deontics), credits, part A: section 38(d) (the order
// in which credits are used) and section 41(g), last sentence (the carry of the
// excess over the pass-thru limit). Closes G6413 and G6414.
//
// SECTION 38(d). TECHNIQUE (stated): BOUNDED UNROLLING over the LIST. The
// components of section 38(b) are walked in their listed order (the enum
// declaration order of `GeneralBusinessCreditComponent`: 41 levels; a distinct
// relation per level, because a recursive relation is LDC-E4102). The amount of
// the section 38(c) limitation left for the current year credits is the
// limitation minus the carryforwards, which are used first (section 38(a)(1)-(2)
// order); each component uses the lesser of its amount and what is left after the
// components listed before it; the rest is unused (the input of the section 39
// attribution). The investment credit (section 46) is split among its own seven
// components in the order of the list of section 46 the same way ((d)(2)).
// JUDGMENT CALLS: (1) the listed order is the 2024 text of (b) and (46): the
// order "as of the close of the taxable year in which the credit is used" is not
// versioned by year (an amendment of the list is a revision, not modelled);
// (2) carrybacks (a)(3) come after the current year credits and are not
// allocated here; (3) the carryforward amount is not attributed to components.

use self::{
    GeneralBusinessCreditComponent,
    IRC_S38_D,
    IRC_S41_G,
    InvestmentCreditComponent46,
    Person,
    TaxableYear,
    business_credit_carryforward_to_year_or_zero,
    carryforwards_from_earlier_unused_years_39c,
    earlier_candidate_with_room_exists,
    general_business_credit_component_amount,
    general_business_credit_limitation,
    has_carryforwards_from_earlier_unused_years_39c,
    investment_credit_component_46,
    pass_thru_interest_holder_41g,
    preceding_taxable_year_of,
    research_credit,
    research_credit_before_41g,
    tax_attributable_to_pass_thru_interest_41g,
    within_20_year_carryforward_window,
};

pub relation general_business_credit_available_for_current_year_38d(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the section 38(c) limitation left for the current year business credit after the carryforwards, which are used first (section 38(a)(1)-(2), (d))";
}
rule GeneralBusinessCreditAvailableForCurrentYear(taxpayer: Person, y: TaxableYear, limitation: Money, carryforward: Money) defeasible {
    label en official "limitation - carryforwards, not below zero";
    when general_business_credit_limitation(taxpayer, y, limitation);
    when business_credit_carryforward_to_year_or_zero(taxpayer, y, carryforward);
    then general_business_credit_available_for_current_year_38d(taxpayer, y, max(0 USD, limitation - carryforward));
}
relation component_amount_present_38d(taxpayer: Person, y: TaxableYear, component: GeneralBusinessCreditComponent) kind institutional {
    label en official "bridge: the component has an amount for the year";
}
rule ComponentAmountPresent38d(taxpayer: Person, y: TaxableYear, component: GeneralBusinessCreditComponent, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when general_business_credit_component_amount(taxpayer, y, component, amount);
    then component_amount_present_38d(taxpayer, y, component);
}
pub relation component_credit_used_38d(taxpayer: Person, y: TaxableYear, component: GeneralBusinessCreditComponent, amount: Money) kind institutional {
    label en official "the part of the component credit used in the year: the lesser of its amount and the limitation left after the components listed before it in section 38(b) (section 38(d)(1))";
}
pub relation component_credit_unused_38d(taxpayer: Person, y: TaxableYear, component: GeneralBusinessCreditComponent, amount: Money) kind institutional {
    label en official "the part of the component credit not used in the year, the input of the section 39 attribution to specified credits (section 38(d)(1))";
}
relation credit_use_cumulative_38d_0(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative current year credits of the components listed before the first one: zero";
}
rule CreditUseCumulative38dStart(taxpayer: Person, y: TaxableYear, available: Money) defeasible {
    label en official "the walk starts at the first listed component";
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    then credit_use_cumulative_38d_0(taxpayer, y, 0 USD);
}
relation credit_use_cumulative_38d_1(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative current year credits of the components listed through number 1 (InvestmentCredit46)";
}
@source(IRC_S38_D, quote = "The order in which such credits are used shall be determined on the basis of the order in which they are listed in subsection (b) as of the close of the taxable year in which the credit is used.")
rule CreditUse38dPosition1Sum(taxpayer: Person, y: TaxableYear, cum: Money, c: Money) defeasible {
    label en official "component number 1 of section 38(b) (InvestmentCredit46): add its amount to the cumulative sum";
    when credit_use_cumulative_38d_0(taxpayer, y, cum);
    when general_business_credit_component_amount(taxpayer, y, InvestmentCredit46, c);
    then credit_use_cumulative_38d_1(taxpayer, y, cum + c);
}
rule CreditUse38dPosition1Used(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 1 of section 38(b) (InvestmentCredit46): used = the lesser of its amount and the limitation left after the earlier components";
    when credit_use_cumulative_38d_0(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, InvestmentCredit46, c);
    then component_credit_used_38d(taxpayer, y, InvestmentCredit46, min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition1Unused(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 1 of section 38(b) (InvestmentCredit46): the rest is unused";
    when credit_use_cumulative_38d_0(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, InvestmentCredit46, c);
    then component_credit_unused_38d(taxpayer, y, InvestmentCredit46, c - min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition1Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "component number 1 of section 38(b) (InvestmentCredit46) has no amount: the cumulative sum stays";
    when credit_use_cumulative_38d_0(taxpayer, y, cum);
    when not_known(component_amount_present_38d(taxpayer, y, InvestmentCredit46));
    then credit_use_cumulative_38d_1(taxpayer, y, cum);
}
relation credit_use_cumulative_38d_2(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative current year credits of the components listed through number 2 (WorkOpportunityCredit51)";
}
@source(IRC_S38_D, quote = "The order in which such credits are used shall be determined on the basis of the order in which they are listed in subsection (b) as of the close of the taxable year in which the credit is used.")
rule CreditUse38dPosition2Sum(taxpayer: Person, y: TaxableYear, cum: Money, c: Money) defeasible {
    label en official "component number 2 of section 38(b) (WorkOpportunityCredit51): add its amount to the cumulative sum";
    when credit_use_cumulative_38d_1(taxpayer, y, cum);
    when general_business_credit_component_amount(taxpayer, y, WorkOpportunityCredit51, c);
    then credit_use_cumulative_38d_2(taxpayer, y, cum + c);
}
rule CreditUse38dPosition2Used(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 2 of section 38(b) (WorkOpportunityCredit51): used = the lesser of its amount and the limitation left after the earlier components";
    when credit_use_cumulative_38d_1(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, WorkOpportunityCredit51, c);
    then component_credit_used_38d(taxpayer, y, WorkOpportunityCredit51, min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition2Unused(taxpayer: Person, y: TaxableYear, cum: Money, available: Money, c: Money) defeasible {
    label en official "component number 2 of section 38(b) (WorkOpportunityCredit51): the rest is unused";
    when credit_use_cumulative_38d_1(taxpayer, y, cum);
    when general_business_credit_available_for_current_year_38d(taxpayer, y, available);
    when general_business_credit_component_amount(taxpayer, y, WorkOpportunityCredit51, c);
    then component_credit_unused_38d(taxpayer, y, WorkOpportunityCredit51, c - min(c, max(0 USD, available - cum)));
}
rule CreditUse38dPosition2Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "component number 2 of section 38(b) (WorkOpportunityCredit51) has no amount: the cumulative sum stays";
    when credit_use_cumulative_38d_1(taxpayer, y, cum);
    when not_known(component_amount_present_38d(taxpayer, y, WorkOpportunityCredit51));
    then credit_use_cumulative_38d_2(taxpayer, y, cum);
}
