    then investment_use_cumulative_38d2_6(taxpayer, y, cum + c);
}
rule InvestmentUse38d2Position6Used(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 6 (AdvancedManufacturingInvestmentCredit48D): used = the lesser of its amount and what is left of the investment credit used";
    when investment_use_cumulative_38d2_5(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, AdvancedManufacturingInvestmentCredit48D, c);
    then investment_component_used_38d2(taxpayer, y, AdvancedManufacturingInvestmentCredit48D, min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position6Unused(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 6 (AdvancedManufacturingInvestmentCredit48D): the rest is unused";
    when investment_use_cumulative_38d2_5(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, AdvancedManufacturingInvestmentCredit48D, c);
    then investment_component_unused_38d2(taxpayer, y, AdvancedManufacturingInvestmentCredit48D, c - min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position6Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "section 46 component number 6 (AdvancedManufacturingInvestmentCredit48D) has no amount: the cumulative sum stays";
    when investment_use_cumulative_38d2_5(taxpayer, y, cum);
    when not_known(investment_component_present_38d2(taxpayer, y, AdvancedManufacturingInvestmentCredit48D));
    then investment_use_cumulative_38d2_6(taxpayer, y, cum);
}
relation investment_use_cumulative_38d2_7(taxpayer: Person, y: TaxableYear, cumulative: Money) kind institutional {
    label en official "cumulative amounts of the section 46 components listed through number 7 (CleanElectricityInvestmentCredit48E)";
}
@source(IRC_S38_D, quote = "The order in which the credits listed in section 46 are used shall be determined on the basis of the order in which such credits are listed in section 46 as of the close of the taxable year in which the credit is used.")
rule InvestmentUse38d2Position7Sum(taxpayer: Person, y: TaxableYear, cum: Money, c: Money) defeasible {
    label en official "section 46 component number 7 (CleanElectricityInvestmentCredit48E): add its amount";
    when investment_use_cumulative_38d2_6(taxpayer, y, cum);
    when investment_credit_component_46(taxpayer, y, CleanElectricityInvestmentCredit48E, c);
    then investment_use_cumulative_38d2_7(taxpayer, y, cum + c);
}
rule InvestmentUse38d2Position7Used(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 7 (CleanElectricityInvestmentCredit48E): used = the lesser of its amount and what is left of the investment credit used";
    when investment_use_cumulative_38d2_6(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, CleanElectricityInvestmentCredit48E, c);
    then investment_component_used_38d2(taxpayer, y, CleanElectricityInvestmentCredit48E, min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position7Unused(taxpayer: Person, y: TaxableYear, cum: Money, used: Money, c: Money) defeasible {
    label en official "section 46 component number 7 (CleanElectricityInvestmentCredit48E): the rest is unused";
    when investment_use_cumulative_38d2_6(taxpayer, y, cum);
    when investment_credit_used_38d2(taxpayer, y, used);
    when investment_credit_component_46(taxpayer, y, CleanElectricityInvestmentCredit48E, c);
    then investment_component_unused_38d2(taxpayer, y, CleanElectricityInvestmentCredit48E, c - min(c, max(0 USD, used - cum)));
}
rule InvestmentUse38d2Position7Absent(taxpayer: Person, y: TaxableYear, cum: Money) defeasible {
    label en official "section 46 component number 7 (CleanElectricityInvestmentCredit48E) has no amount: the cumulative sum stays";
    when investment_use_cumulative_38d2_6(taxpayer, y, cum);
    when not_known(investment_component_present_38d2(taxpayer, y, CleanElectricityInvestmentCredit48E));
    then investment_use_cumulative_38d2_7(taxpayer, y, cum);
}

// ===================== 41(g), last sentence: the carry of the excess over the pass-thru limit =====================
//
// The excess of the research credit over the pass-thru limit is carried under
// section 39, with the limit of 41(g) (the tax attributable to the interest of
// the carryover year) IN LIEU of the section 38(c) limitation. The candidate
// years are those of the module 39 idiom (case-supplied adjacency and window;
// the earliest candidate with room); the room of a year is its 41(g) limit
// minus the research credit already allowed for it (carryback, section 39(b))
// or minus the carryforwards from earlier unused credit years (section 39(c)).

pub relation research_credit_excess_over_41g_limit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the research credit above the pass-thru limit of section 41(g), which may be carried to other years under section 39";
}
@source(IRC_S41_G, quote = "If the amount determined under subsection (a) for any taxable year exceeds the limitation of the preceding sentence, such amount may be carried to other taxable years under the rules of section 39;")
rule ResearchCreditExcessOverPassThruLimit(taxpayer: Person, y: TaxableYear, before: Money, limit: Money) defeasible {
    label en official "the amount above the limit of the preceding sentence (section 41(g))";
    when research_credit_before_41g(taxpayer, y, before);
    when pass_thru_interest_holder_41g(taxpayer, y);
    when tax_attributable_to_pass_thru_interest_41g(taxpayer, y, limit);
    when before > limit;
    then research_credit_excess_over_41g_limit(taxpayer, y, before - limit);
}
relation research_credit_allowed_present_41g(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a research credit is allowed for the year";
}
rule ResearchCreditAllowedPresent41g(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when research_credit(taxpayer, y, amount);
    then research_credit_allowed_present_41g(taxpayer, y);
}
pub relation research_credit_41g_carryback_room(taxpayer: Person, y: TaxableYear, room: Money) kind institutional {
    label en official "the room of a carryback year under section 39(b) with the limit of section 41(g) in lieu of section 38(c): the tax attributable to the interest minus the research credit already allowed for the year";
}
@source(IRC_S41_G, quote = "except that the limitation of the preceding sentence shall be taken into account in lieu of the limitation of section 38(c) in applying section 39.")
rule ResearchCredit41gCarrybackRoomWithCredit(taxpayer: Person, y: TaxableYear, limit: Money, allowed: Money) defeasible {
    label en official "41(g) limit - research credit allowed, not below zero";
    when tax_attributable_to_pass_thru_interest_41g(taxpayer, y, limit);
    when research_credit(taxpayer, y, allowed);
    then research_credit_41g_carryback_room(taxpayer, y, max(0 USD, limit - allowed));
}
rule ResearchCredit41gCarrybackRoomWithoutCredit(taxpayer: Person, y: TaxableYear, limit: Money) defeasible {
    label en official "no research credit allowed for the year: the whole 41(g) limit";
    when tax_attributable_to_pass_thru_interest_41g(taxpayer, y, limit);
    when not_known(research_credit_allowed_present_41g(taxpayer, y));
    then research_credit_41g_carryback_room(taxpayer, y, limit);
}
pub relation research_credit_41g_carryback_to_year(taxpayer: Person, unused_credit_year: TaxableYear, carryback_year: TaxableYear, amount: Money) kind institutional {
    label en official "the excess carried back one year (section 39(a)(1)(A)) with the 41(g) limit in lieu of section 38(c) (section 39(b))";
}
rule ResearchCredit41gCarryback(taxpayer: Person, uy: TaxableYear, cy: TaxableYear, excess: Money, room: Money) defeasible {
    label en official "min(excess, room of the carryback year) (section 41(g), section 39(a)(1)(A), (b))";
    when research_credit_excess_over_41g_limit(taxpayer, uy, excess);
    when preceding_taxable_year_of(uy, cy);
    when research_credit_41g_carryback_room(taxpayer, cy, room);
    then research_credit_41g_carryback_to_year(taxpayer, uy, cy, min(excess, room));
}
pub relation research_credit_41g_carryforward_room(taxpayer: Person, y: TaxableYear, room: Money) kind institutional {
    label en official "the room of a carryforward year under section 39(c) with the limit of section 41(g) in lieu of section 38(c): the tax attributable to the interest minus the amounts carried to the year from earlier unused credit years";
}
rule ResearchCredit41gCarryforwardRoomWithEarlier(taxpayer: Person, y: TaxableYear, limit: Money, earlier: Money) defeasible {
    label en official "41(g) limit - carryforwards from earlier years, not below zero";
    when tax_attributable_to_pass_thru_interest_41g(taxpayer, y, limit);
    when carryforwards_from_earlier_unused_years_39c(taxpayer, y, earlier);
    then research_credit_41g_carryforward_room(taxpayer, y, max(0 USD, limit - earlier));
}
rule ResearchCredit41gCarryforwardRoomWithoutEarlier(taxpayer: Person, y: TaxableYear, limit: Money) defeasible {
    label en official "no earlier carryforward: the whole 41(g) limit";
    when tax_attributable_to_pass_thru_interest_41g(taxpayer, y, limit);
    when not_known(has_carryforwards_from_earlier_unused_years_39c(taxpayer, y));
    then research_credit_41g_carryforward_room(taxpayer, y, limit);
}
pub relation research_credit_41g_carryforward_to_year(taxpayer: Person, unused_credit_year: TaxableYear, candidate: TaxableYear, amount: Money) kind institutional {
    label en official "the excess carried to the earliest candidate year with the 41(g) limit in lieu of section 38(c) (section 39(a)(1)(B), (a)(2), (c))";
}
rule ResearchCredit41gCarryforward(taxpayer: Person, uy: TaxableYear, cand: TaxableYear, excess: Money, room: Money) defeasible {
    label en official "min(excess, room of the earliest candidate year) (section 41(g), section 39(a)(2), (c))";
    when research_credit_excess_over_41g_limit(taxpayer, uy, excess);
    when within_20_year_carryforward_window(taxpayer, uy, cand);
    when not earlier_candidate_with_room_exists(taxpayer, uy, cand);
    when research_credit_41g_carryforward_room(taxpayer, cand, room);
    then research_credit_41g_carryforward_to_year(taxpayer, uy, cand, min(excess, room));
}
