// Section 21 — Expenses for household and dependent care services necessary
// for gainful employment ("dependent care credit"). Stage 1 (IRC-06 stage 1).
//
// `Person`/`Individual`/`TaxableYear`/`Money`/`Decimal` aliases are declared
// once for the package in `package.law`. `dependent_of` (section 152) is
// imported from `us.irc.gross_income`, which as of its own stage 2
// (§§151-152, 25.09.2026) publishes the REAL section 152 implementation
// (`qualifying_child_of`/`dependent_of`/`qualifying_relative_of`); this
// pending contract on `us.irc.income_individual`'s own stub is REPLACED by
// the real import, per the coordinator's stage-2 assignment for this
// package.

// --- §21(b)(1): qualifying individual -----------------------------------------

use self::{
    IRC_S21_A,
    IRC_S21_B,
    IRC_S21_C,
    IRC_S21_D,
    IRC_S21_E,
    IRC_S21_G,
    Individual,
    Person,
    TaxableYear,
};

pub relation qualifying_individual(individual: Person, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "a qualifying individual with respect to the taxpayer (section 21(b)(1))";
}

relation attained_age_13(individual: Person, y: TaxableYear) kind empirical {
    label en official "has attained age 13 (section 21(b)(1)(A), negated)";
}
relation physically_or_mentally_incapable_of_self_care(individual: Person, y: TaxableYear) kind empirical {
    label en official "physically or mentally incapable of caring for himself or herself (section 21(b)(1)(B)/(C))";
}
relation same_principal_place_of_abode_more_than_half_year(individual: Person, taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "has the same principal place of abode as the taxpayer for more than one-half of such taxable year (section 21(b)(1)(B)/(C))";
}
relation spouse_of_taxpayer(individual: Person, taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the spouse of the taxpayer (section 21(b)(1)(C))";
}

// §21(e)(1): an individual whose relationship to the taxpayer violates local
// law is never treated as sharing the taxpayer's principal place of abode —
// modelled as a defeater on the shared-abode fact itself (`unless`), so every
// (b)(1)(B)/(C) rule inherits it without repeating the condition.
relation relationship_violates_local_law(individual: Person, taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the relationship between the individual and the taxpayer is in violation of local law (section 21(e)(1))";
}

@source(IRC_S21_B, quote = "a dependent of the taxpayer (as defined in section 152(a)(1)) who has not attained age 13")
rule QualifyingIndividualUnder13(individual: Person, taxpayer: Individual, y: TaxableYear) strict {
    label en official "a dependent of the taxpayer under section 152(a)(1) who has not attained age 13 is a qualifying individual";
    when us.irc.gross_income::dependent_of(individual, taxpayer, y);
    when not_known(attained_age_13(individual, y));
    then qualifying_individual(individual, taxpayer, y);
}

@source(IRC_S21_B, quote = "who is physically or mentally incapable of caring for himself or herself and who has the same principal place of abode as the taxpayer for more than one-half of such taxable year")
rule QualifyingIndividualIncapableDependent(individual: Person, taxpayer: Individual, y: TaxableYear) strict {
    label en official "a dependent of the taxpayer (determined without regard to section 152(b)(1),(b)(2),(d)(1)(B)) who is incapable of self-care and shares the taxpayer's abode for more than half the year is a qualifying individual";
    when us.irc.gross_income::dependent_of(individual, taxpayer, y);
    when physically_or_mentally_incapable_of_self_care(individual, y);
    when same_principal_place_of_abode_more_than_half_year(individual, taxpayer, y);
    when not relationship_violates_local_law(individual, taxpayer, y);
    then qualifying_individual(individual, taxpayer, y);
}

@source(IRC_S21_B, quote = "the spouse of the taxpayer, if the spouse is physically or mentally incapable of caring for himself or herself and who has the same principal place of abode as the taxpayer for more than one-half of such taxable year")
rule QualifyingIndividualIncapableSpouse(individual: Person, taxpayer: Individual, y: TaxableYear) strict {
    label en official "the taxpayer's spouse, if incapable of self-care and sharing the taxpayer's abode for more than half the year, is a qualifying individual";
    when spouse_of_taxpayer(individual, taxpayer, y);
    when physically_or_mentally_incapable_of_self_care(individual, y);
    when same_principal_place_of_abode_more_than_half_year(individual, taxpayer, y);
    when not relationship_violates_local_law(individual, taxpayer, y);
    then qualifying_individual(individual, taxpayer, y);
}

// §21(e)(5): the custodial-parent rule for a child of divorced/separated
// parents (section 152(e)) reassigns which parent may treat the child as a
// qualifying individual, overriding the ordinary dependency test. Producer of
// the section 152(e) "custodial parent" fact: `us.irc.income_individual`
// (pending, per its own filing-status.law dependency-contract note) —
// declared here as a further pending dependency, not re-derived.
relation section_152e_applies_and_custodial_parent(child: Person, custodial: Individual, y: TaxableYear) kind institutional {
    label en official "section 152(e) applies to this child for the calendar year, with this individual as the custodial parent (section 152(e)(4)(A)) — dependency contract, producer: income_individual/definitions (pending)";
}
relation under_13_or_incapable(child: Person, y: TaxableYear) kind empirical {
    label en official "under the age of 13 or physically or mentally incapable of caring for himself (section 21(e)(5)(B))";
}

@source(IRC_S21_E, quote = "such child shall be treated as a qualifying individual described in subparagraph (A) or (B) of subsection (b)(1) (whichever is appropriate) with respect to the custodial parent")
rule QualifyingIndividualCustodialParentOverride(child: Person, custodial: Individual, y: TaxableYear) strict {
    label en official "a child to whom the section 152(e) custodial-parent rule applies, and who is under 13 or incapable of self-care, is a qualifying individual of the custodial parent (and, by the same sentence, not of the noncustodial parent)";
    when section_152e_applies_and_custodial_parent(child, custodial, y);
    when under_13_or_incapable(child, y);
    then qualifying_individual(child, custodial, y);
}
// The negative half of the same sentence ("and shall not be treated as a
// qualifying individual with respect to the noncustodial parent") is not
// separately encoded as a rule: open-world semantics already give NEITHER
// for the noncustodial parent absent an assertion, and no other rule in this
// module could derive `qualifying_individual` for the noncustodial parent
// from these facts.

// --- §21(b)(2): employment-related expenses -----------------------------------

pub enum EmploymentRelatedExpenseKind {
    HouseholdServices;          // (b)(2)(A)(i)
    QualifyingIndividualCare;   // (b)(2)(A)(ii)
}

relation employment_related_expense_item(taxpayer: Individual, y: TaxableYear, kind: EmploymentRelatedExpenseKind, amount: Money) kind empirical {
    label en official "an amount paid for household services or for the care of a qualifying individual (section 21(b)(2)(A))";
}
relation incurred_to_enable_gainful_employment(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "such expenses are incurred to enable the taxpayer to be gainfully employed for a period with 1 or more qualifying individuals (section 21(b)(2)(A))";
}
relation paid_for_overnight_camp(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount paid for services outside the household at a camp where the qualifying individual stays overnight (section 21(b)(2)(A), excluded)";
}

pub relation employment_related_expenses(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "employment-related expenses (section 21(b)(2))";
}

@source(IRC_S21_B, quote = "The term \"employment-related expenses\" means amounts paid for the following expenses, but only if such expenses are incurred to enable the taxpayer to be gainfully employed")
rule EmploymentRelatedExpensesSum(taxpayer: Individual, y: TaxableYear) strict {
    label en official "employment-related expenses are the sum of the qualifying household-service and dependent-care items paid to enable gainful employment, excluding overnight-camp amounts (which are never asserted as an item under this rule)";
    when incurred_to_enable_gainful_employment(taxpayer, y);
    then employment_related_expenses(taxpayer, y,
        sum all amount: Money for kind: EmploymentRelatedExpenseKind where employment_related_expense_item(taxpayer, y, kind, amount));
}
// The overnight-camp exclusion and the (b)(2)(B)/(C)/(D) narrowing of WHICH
// out-of-household expenses count (only care of a (b)(1)(A) qualifying
// individual, or one who spends 8+ hours/day in the household; a dependent
// care center must comply with state/local law) are case-classification
// conditions on whether a given payment is asserted as an
// `employment_related_expense_item` in the first place, not further
// arithmetic — a case package asserting the item already applies them.
// Recorded as INTERPRETATION rows (narrows an already-modelled predicate,
// AGENT-BRIEF "Lessons from the pilot").

// --- §21(a): applicable percentage and the credit itself ----------------------

pub relation dependent_care_applicable_percentage(taxpayer: Individual, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the applicable percentage (section 21(a)(2))";
}

@source(IRC_S21_A, quote = "35 percent reduced (but not below 20 percent) by 1 percentage point for each $2,000 (or fraction thereof) by which the taxpayer's adjusted gross income for the taxable year exceeds $15,000")
rule ApplicablePercentageGeneralAtOrBelowThreshold(taxpayer: Individual, y: TaxableYear, agi: Money) strict {
    label en official "at or below the $15,000 AGI threshold, the applicable percentage stays at 35 percent";
    effective [@1954-01-01, @2021-01-01);
    when us.irc.gross_income::adjusted_gross_income(taxpayer, y, agi);
    when agi <= DependentCareAgiThreshold;
    then dependent_care_applicable_percentage(taxpayer, y, 0.35);
}
@source(IRC_S21_A, quote = "35 percent reduced (but not below 20 percent) by 1 percentage point for each $2,000 (or fraction thereof) by which the taxpayer's adjusted gross income for the taxable year exceeds $15,000")
rule ApplicablePercentageGeneralAboveThreshold(taxpayer: Individual, y: TaxableYear, agi: Money) strict {
    label en official "above the $15,000 AGI threshold, the applicable percentage is 35 percent reduced by 1 point per $2,000 (or fraction thereof) of the excess, not below 20 percent";
    effective [@1954-01-01, @2021-01-01);
    when us.irc.gross_income::adjusted_gross_income(taxpayer, y, agi);
    when agi > DependentCareAgiThreshold;
    then dependent_care_applicable_percentage(taxpayer, y,
        max(0.20, 0.35 - 0.01 * round((agi - DependentCareAgiThreshold) / DependentCarePhasedownIncrement, 0, "CEILING")));
}

// --- §21(g): ARPA 2021-only enhanced, fully refundable credit -----------------
// (g) applies only to taxable years beginning after December 31, 2020, and
// before January 1, 2022 — a closed historical window under DECISION-0379's
// 2024-Edition base text; modelled as a real `effective`-windowed rule set,
// not dropped as moot, because a 2021 case can still be presented.

relation principal_place_of_abode_in_us_more_than_half_year_21g(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer (or, on a joint return, either spouse) has a principal place of abode in the United States, determined as provided in section 32, for more than one-half of the taxable year (section 21(g)(1))";
}

@source(IRC_S21_G, quote = "by substituting \"50 percent\" for \"35 percent\", and")
rule ApplicablePercentageArpa2021AtOrBelow(taxpayer: Individual, y: TaxableYear, agi: Money) strict {
    label en official "for 2021 only, at or below $400,000 AGI, the applicable percentage is 50 percent";
    effective [@2021-01-01, @2022-01-01);
    when us.irc.gross_income::adjusted_gross_income(taxpayer, y, agi);
    when agi <= DependentCareArpaSecondThreshold;
    then dependent_care_applicable_percentage(taxpayer, y, 0.50);
}
@source(IRC_S21_G, quote = "20 percent reduced (but not below zero) by 1 percentage point for each $2,000 (or fraction thereof) by which the taxpayer's adjusted gross income for the taxable year exceeds $400,000")
rule ApplicablePercentageArpa2021Above(taxpayer: Individual, y: TaxableYear, agi: Money) strict {
    label en official "for 2021 only, above $400,000 AGI, the applicable percentage is the phaseout percentage: 20 percent reduced by 1 point per $2,000 (or fraction thereof) of the excess, not below zero";
    effective [@2021-01-01, @2022-01-01);
    when us.irc.gross_income::adjusted_gross_income(taxpayer, y, agi);
    when agi > DependentCareArpaSecondThreshold;
    then dependent_care_applicable_percentage(taxpayer, y,
        max(0.0, 0.20 - 0.01 * round((agi - DependentCareArpaSecondThreshold) / DependentCarePhasedownIncrement, 0, "CEILING")));
}

pub relation dependent_care_expense_limit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the dollar limit on employment-related expenses taken into account (section 21(c), before the section 129 reduction)";
}
relation section_129_excludable_amount(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate amount excludable from gross income under section 129 (dependent care assistance programs) for the taxable year — dependency contract, producer: gross-income (section 129 exclusion, pending)";
}

@source(IRC_S21_C, quote = "$3,000 if there is 1 qualifying individual with respect to the taxpayer for such taxable year")
rule ExpenseLimitOneQualifyingIndividual(taxpayer: Individual, y: TaxableYear, excl: Money) defeasible {
    label en official "the dollar limit is $3,000 with exactly one qualifying individual, reduced by the section 129 exclusion";
    effective [@1954-01-01, @2021-01-01);
    when count(collect individual: Person where qualifying_individual(individual, taxpayer, y)) == 1;
    when section_129_excludable_amount(taxpayer, y, excl);
    then dependent_care_expense_limit(taxpayer, y, max(0 USD, 3000.00 USD - excl));
}

@source(IRC_S21_C, quote = "$6,000 if there are 2 or more qualifying individuals with respect to the taxpayer for such taxable year")
rule ExpenseLimitTwoOrMoreQualifyingIndividuals(taxpayer: Individual, y: TaxableYear, excl: Money) defeasible {
    label en official "the dollar limit is $6,000 with two or more qualifying individuals, reduced by the section 129 exclusion";
    effective [@1954-01-01, @2021-01-01);
    when count(collect individual: Person where qualifying_individual(individual, taxpayer, y)) >= 2;
    when section_129_excludable_amount(taxpayer, y, excl);
    then dependent_care_expense_limit(taxpayer, y, max(0 USD, 6000.00 USD - excl));
}

@source(IRC_S21_G, quote = "by substituting \"$8,000\" for \"$3,000\" in paragraph (1) thereof")
rule ExpenseLimitOneQualifyingIndividualArpa2021(taxpayer: Individual, y: TaxableYear, excl: Money) defeasible {
    label en official "for 2021 only, the one-qualifying-individual dollar limit is $8,000, reduced by the section 129 exclusion";
    effective [@2021-01-01, @2022-01-01);
    when count(collect individual: Person where qualifying_individual(individual, taxpayer, y)) == 1;
    when section_129_excludable_amount(taxpayer, y, excl);
    then dependent_care_expense_limit(taxpayer, y, max(0 USD, 8000.00 USD - excl));
}

@source(IRC_S21_G, quote = "by substituting \"$16,000\" for \"$6,000\" in paragraph (2) thereof")
rule ExpenseLimitTwoOrMoreQualifyingIndividualsArpa2021(taxpayer: Individual, y: TaxableYear, excl: Money) defeasible {
    label en official "for 2021 only, the two-or-more dollar limit is $16,000, reduced by the section 129 exclusion";
    effective [@2021-01-01, @2022-01-01);
    when count(collect individual: Person where qualifying_individual(individual, taxpayer, y)) >= 2;
    when section_129_excludable_amount(taxpayer, y, excl);
    then dependent_care_expense_limit(taxpayer, y, max(0 USD, 16000.00 USD - excl));
}

// --- §21(d): earned income limit -----------------------------------------------

relation earned_income_21(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "earned income for purposes of section 21(d) — dependency contract; producer unresolved (candidate: employment/international, pending), asserted directly as a case fact until then";
}
relation deemed_earned_income_student_or_incapable_spouse(spouse: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "deemed earned income of a student spouse or a (b)(1)(C) qualifying-individual spouse, $250/month if one qualifying individual or $500/month if two or more (section 21(d)(2))";
}

pub relation dependent_care_earned_income_limit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earned-income limitation on employment-related expenses taken into account (section 21(d)(1))";
}

@source(IRC_S21_D, quote = "in the case of an individual who is not married at the close of such year, such individual's earned income for such year")
rule EarnedIncomeLimitUnmarried(taxpayer: Individual, y: TaxableYear, earned: Money) strict {
    label en official "for an unmarried individual, the limit is that individual's own earned income";
    when not us.irc.income_individual::married_at_close_of_year(taxpayer, y);
    when earned_income_21(taxpayer, y, earned);
    then dependent_care_earned_income_limit(taxpayer, y, earned);
}

@source(IRC_S21_D, quote = "in the case of an individual who is married at the close of such year, the lesser of such individual's earned income or the earned income of his spouse for such year")
rule EarnedIncomeLimitMarried(taxpayer: Individual, spouse: Individual, y: TaxableYear, own: Money, spouses: Money) strict {
    label en official "for a married individual, the limit is the lesser of the individual's own earned income or the spouse's earned income";
    when us.irc.income_individual::married_at_close_of_year(taxpayer, y);
    when earned_income_21(taxpayer, y, own);
    when earned_income_21(spouse, y, spouses);
    then dependent_care_earned_income_limit(taxpayer, y, min(own, spouses));
}
// §21(d)(2)'s deemed-earned-income floor for a student/incapable spouse
// narrows what counts as the SPOUSE's `earned_income_21` in the married rule
// above (it does not add a new top-level disposition): a case package
// asserting the spouse's `earned_income_21` at least at the deemed floor
// already encodes it. Recorded as INTERPRETATION, per the same idiom as
// s62-agi.law's performing-artist marriage special rules.

// --- §21(a): the credit ---------------------------------------------------------

pub relation dependent_care_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit allowed under section 21 for expenses for household and dependent care services necessary for gainful employment";
}

relation section_21_joint_return_condition_met(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "either the taxpayer is not married at the close of the taxable year, or the taxpayer and spouse file a joint return (section 21(e)(2))";
}
@source(IRC_S21_E, quote = "the credit shall be allowed under subsection (a) only if the taxpayer and his spouse file a joint return for the taxable year")
rule JointReturnConditionMarried(taxpayer: Individual, y: TaxableYear) strict {
    label en official "a taxpayer married at the close of the year satisfies the joint-return condition only by filing jointly";
    when us.irc.income_individual::married_at_close_of_year(taxpayer, y);
    when us.irc.income_individual::joint_return_filed(taxpayer, y);
    then section_21_joint_return_condition_met(taxpayer, y);
}
rule JointReturnConditionUnmarried(taxpayer: Individual, y: TaxableYear) strict {
    label en official "an unmarried taxpayer automatically satisfies the joint-return condition of section 21(e)(2)";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    when not us.irc.income_individual::married_at_close_of_year(taxpayer, y);
    then section_21_joint_return_condition_met(taxpayer, y);
}
// §21(e)(3)/(4): legally separated individuals, and certain individuals
// living apart from a nonmember spouse for the last 6 months while
// maintaining the household, "shall not be considered as married" for this
// purpose — narrows `married_at_close_of_year` as read by THIS section only;
// modelled as a further precondition a case can assert directly
// (`not_known`/`unless` at the case-fact level), not a second copy of the
// shared marital-status relation (would shadow the owner's `pub`, per
// PACKAGE-LAYOUT). Recorded as INTERPRETATION.

// §21(e)(6): no credit for amounts paid to an individual for whom a section
// 151(c) dependent exemption is allowable to the taxpayer or spouse, or who
// is the taxpayer's under-19 child (section 152(f)(1)). Modelled as a
// disqualification on the CARE-PROVIDER, gating the expense item itself.
relation care_provider_disqualified_21e6(provider: Person, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "no credit is allowed for amounts paid to this individual (section 21(e)(6))";
}
relation section_151c_exemption_allowable_for(provider: Person, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "a section 151(c) deduction for personal exemptions for dependents is allowable to the taxpayer or spouse with respect to this individual — dependency contract, producer: income_individual/deductions (pending)";
}
relation taxpayers_child_under_19(provider: Person, taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "a child of the taxpayer (within the meaning of section 152(f)(1)) who has not attained the age of 19 at the close of the taxable year (section 21(e)(6)(B))";
}
@source(IRC_S21_E, quote = "with respect to whom, for the taxable year, a deduction under section 151(c) (relating to deduction for personal exemptions for dependents) is allowable either to the taxpayer or his spouse")
rule CareProviderDisqualifiedExemption(provider: Person, taxpayer: Individual, y: TaxableYear) strict {
    label en official "a care provider for whom a section 151(c) exemption is allowable to the taxpayer or spouse is disqualified";
    when section_151c_exemption_allowable_for(provider, taxpayer, y);
    then care_provider_disqualified_21e6(provider, taxpayer, y);
}
@source(IRC_S21_E, quote = "who is a child of the taxpayer (within the meaning of section 152(f)(1)) who has not attained the age of 19 at the close of the taxable year")
rule CareProviderDisqualifiedOwnChildUnder19(provider: Person, taxpayer: Individual, y: TaxableYear) strict {
    label en official "the taxpayer's own child under 19 at the close of the taxable year is a disqualified care provider";
    when taxpayers_child_under_19(provider, taxpayer, y);
    then care_provider_disqualified_21e6(provider, taxpayer, y);
}

// §21(e)(9)/(10): identification requirements (provider's name/address/TIN,
// or the qualifying individual's TIN, on the return claiming the credit) —
// classified EVALUATIVE/case-fact for the due-diligence proviso of (e)(9)
// (DECISION-0194: "due diligence" is an external-judgment channel, the
// Secretary's), otherwise a plain case fact gating the credit.
relation section_21_identification_requirements_met(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the section 21(e)(9)/(10) provider- and qualifying-individual-identification requirements are met (or excused by due diligence)";
}

@source(IRC_S21_A, quote = "there shall be allowed as a credit against the tax imposed by this chapter for the taxable year an amount equal to the applicable percentage of the employment-related expenses")
rule DependentCareCreditGeneral(taxpayer: Individual, y: TaxableYear, pct: Decimal, expenses: Money, cap: Money, earned_cap: Money) defeasible {
    label en official "the dependent care credit is the applicable percentage of employment-related expenses, capped at the section 21(c) dollar limit and the section 21(d) earned-income limit, conditioned on the section 21(e) joint-return and identification requirements";
    when count(collect individual: Person where qualifying_individual(individual, taxpayer, y)) >= 1;
    when dependent_care_applicable_percentage(taxpayer, y, pct);
    when employment_related_expenses(taxpayer, y, expenses);
    when dependent_care_expense_limit(taxpayer, y, cap);
    when dependent_care_earned_income_limit(taxpayer, y, earned_cap);
    when section_21_joint_return_condition_met(taxpayer, y);
    when section_21_identification_requirements_met(taxpayer, y);
    then dependent_care_credit(taxpayer, y, round(pct * min(min(expenses, cap), earned_cap), 2, "HALF_UP"));
}

// §21(g)(1): for 2021, if the taxpayer's principal place of abode is in the
// United States for more than half the year, the section 21 credit is
// reallocated to subpart C — i.e., REFUNDABLE for that year, rather than
// nonrefundable. `nonrefundable_credit`/`refundable_credit` split in
// `credits-totals.law` reads this fact, not a second amount computation.
pub relation dependent_care_credit_refundable_2021(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "the section 21 credit is treated as allowed under subpart C (refundable) rather than this subpart, for 2021 (section 21(g)(1))";
}
@source(IRC_S21_G, quote = "the credit allowed under subsection (a) shall be treated as a credit allowed under subpart C (and not allowed under this subpart)")
rule DependentCareCreditRefundable2021(taxpayer: Individual, y: TaxableYear) strict {
    label en official "for 2021, a taxpayer (or either spouse on a joint return) with a US principal place of abode for more than half the year has the section 21 credit reallocated to subpart C";
    effective [@2021-01-01, @2022-01-01);
    when principal_place_of_abode_in_us_more_than_half_year_21g(taxpayer, y);
    then dependent_care_credit_refundable_2021(taxpayer, y);
}

// §21(f): regulatory-authority provision — NON_NORMATIVE (confers rulemaking
// authority on the Secretary, no taxpayer-facing test).
//
// §21(h): payments to U.S. possessions with/without a "mirror code" tax
// system, for the 2021 mirror of this credit, and the coordinating denial of
// a double credit to possession residents — an inter-governmental payment
// and eligibility-coordination provision about residents of possessions, out
// of this package's `Person`/`Individual` domain (U.S. taxpayers under
// Title 26 directly). Classified EXTERNAL_DEPENDENCY/institutional_effect:
// the (h)(3) denial condition is a real disqualification test this package
// could in principle apply to a possession-resident taxpayer, but the
// possession mirror-code and plan-approval facts it depends on are outside
// any owner package of this corpus. Recorded, not modeled further.
