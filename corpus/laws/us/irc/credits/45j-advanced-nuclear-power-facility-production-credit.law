// Section 45J — Production credit for electricity from advanced nuclear power
// facilities. Stage 2d (IRC-06, DECISION-0379).
//
// Scope / judgment calls:
// * (a): 1.8 cents per kilowatt hour produced by the taxpayer at an advanced
//   nuclear power facility during the 8 years after the facility was
//   originally placed in service and sold to an unrelated person in the year.
// * (b): the credit is limited by the ratio of the allocated national megawatt
//   capacity to the nameplate capacity; (c)(1): at most $125,000,000 x
//   allocated megawatts / 1,000; (c)(2): a price reduction by the ratio of the
//   reference price excess over 8 cents (indexed, rounded to 0.1 cent) to 3
//   cents. The (c)(2) reduction is applied before the (c)(1) cap: the text
//   orders (b) before (c)(1) only (INTERPRETATION, TECH-GAPS G1545).
// * (d): an advanced nuclear power facility is owned by the taxpayer, placed in
//   service after enactment and before 2021-01-01, with an NRC-approved reactor
//   design approved after 1993-12-31 (and not substantially similar to an
//   earlier design).
// * (e): the election by a qualified public entity to treat an eligible project
//   partner as the taxpayer is a POWER; the partner year rule and the section
//   141(b)(1) provision are not modelled (G1545).

use self::{
    Asset,
    IRC_S45J_A,
    IRC_S45J_B,
    IRC_S45J_C,
    IRC_S45J_D,
    IRC_S45J_E,
    IRC_S45J_F,
    Person,
    TaxableYear,
    has_gross_sales_share_45,
    kilowatt_hours_for_credit_45j,
    ownership_share_of_gross_sales_45,
};

pub relation nuclear_facility_owned_by_taxpayer_45j(facility: Asset, taxpayer: Person) kind empirical {
    label en official "the facility is owned by the taxpayer and uses nuclear energy to produce electricity (section 45J(d)(1)(A)) — case-asserted";
}
pub relation facility_originally_placed_in_service_on_45j(facility: Asset, on: Date) kind empirical {
    label en official "the date the facility was originally placed in service — case-asserted";
}
pub relation section_45j_enacted_on(on: Date) kind empirical {
    label en official "the date of enactment of section 45J(d)(1) — case-asserted from the pinned Public Law note";
}
pub relation nrc_reactor_design_approved_on_45j(facility: Asset, on: Date) kind empirical {
    label en official "the date the Nuclear Regulatory Commission approved the reactor design of the facility (section 45J(d)(2)) — case-asserted";
}
pub relation substantially_similar_design_approved_by_1993_45j(facility: Asset) kind empirical {
    label en official "the design or a substantially similar design of comparable capacity was approved on or before December 31, 1993 (section 45J(d)(2)) — case-asserted";
}
pub relation electricity_sale_date_45j(facility: Asset, y: TaxableYear, on: Date) kind empirical {
    label en official "a date in the taxable year on which the electricity is sold (for the 8-year period test) — case-asserted";
}
pub relation kilowatt_hours_sold_45j(facility: Asset, y: TaxableYear, kwh: Decimal) kind empirical {
    label en official "kilowatt hours produced by the taxpayer at the facility during the 8-year period and sold to an unrelated person during the taxable year (section 45J(a)(2)) — case-asserted";
}
pub relation allocated_megawatt_capacity_45j(facility: Asset, megawatts: Decimal) kind empirical {
    label en official "the national megawatt capacity limitation the Secretary allocated to the facility (sections 45J(b)(1)(A), (b)(3)) — case-asserted";
}
pub relation nameplate_megawatt_capacity_45j(facility: Asset, megawatts: Decimal) kind empirical {
    label en official "the total megawatt nameplate capacity of the facility (section 45J(b)(1)(B)) — case-asserted";
}
pub relation reference_price_cents_45j(y: TaxableYear, cents: Decimal) kind empirical {
    label en official "the reference price (section 45(e)(2)(C)) for the calendar year in which the sale occurs, in cents per kilowatt hour — case-asserted, not pinned";
}
pub relation inflation_adjustment_factor_45j(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor of section 45(e)(2)(B) for the calendar year of the sale — case-asserted, not pinned";
}

pub relation advanced_nuclear_facility_45j(facility: Asset) kind institutional {
    label en official "section 45J(d)(2): a nuclear facility whose reactor design was approved by the NRC after December 31, 1993 (and is not substantially similar to an earlier design of comparable capacity)";
}
@source(IRC_S45J_D, quote = "the reactor design for which is approved after December 31, 1993, by the Nuclear Regulatory Commission")
rule AdvancedNuclearFacility45jRule(facility: Asset, approved: Date) strict {
    when nrc_reactor_design_approved_on_45j(facility, approved);
    when approved > @1993-12-31;
    when not_known(substantially_similar_design_approved_by_1993_45j(facility));
    then advanced_nuclear_facility_45j(facility);
}
pub relation advanced_nuclear_power_facility_45j(facility: Asset, taxpayer: Person) kind institutional {
    label en official "section 45J(d)(1): an advanced nuclear facility owned by the taxpayer, placed in service after enactment and before 2021-01-01";
}
@source(IRC_S45J_D, quote = "which is placed in service after the date of the enactment of this paragraph and before January 1, 2021")
rule AdvancedNuclearPowerFacility45jRule(facility: Asset, taxpayer: Person, placed: Date, enacted: Date) strict {
    when advanced_nuclear_facility_45j(facility);
    when nuclear_facility_owned_by_taxpayer_45j(facility, taxpayer);
    when facility_originally_placed_in_service_on_45j(facility, placed);
    when section_45j_enacted_on(enacted);
    when placed > enacted;
    when placed < @2021-01-01;
    then advanced_nuclear_power_facility_45j(facility, taxpayer);
}
pub relation within_eight_year_period_45j(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45J(a)(2)(A): the sale is within the 8-year period beginning on the date the facility was originally placed in service";
}
@source(IRC_S45J_A, quote = "produced by the taxpayer at an advanced nuclear power facility during the 8-year period beginning on the date the facility was originally placed in service")
rule WithinEightYearPeriod45jRule(facility: Asset, y: TaxableYear, placed: Date, sold: Date) strict {
    when facility_originally_placed_in_service_on_45j(facility, placed);
    when electricity_sale_date_45j(facility, y, sold);
    when sold >= placed;
    when sold < add_calendar_period(placed, 96 calendar_month);
    then within_eight_year_period_45j(facility, y);
}

// --- (a), (b), (c): the credit ------------------------------------------------------------------

pub relation credit_before_limits_45j(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45J(a): 1.8 cents times the kilowatt hours produced and sold";
}
@source(IRC_S45J_A, quote = "the advanced nuclear power facility production credit of any taxpayer for any taxable year is equal to the product of")
rule CreditBeforeLimits45jRule(facility: Asset, y: TaxableYear, kwh: Decimal, taxpayer: Person) defeasible {
    when advanced_nuclear_power_facility_45j(facility, taxpayer);
    when within_eight_year_period_45j(facility, y);
    when kilowatt_hours_for_credit_45j(facility, y, kwh);
    then credit_before_limits_45j(facility, y, round(0.018 * kwh, 2, "HALF_UP") * 1 USD);
}
pub relation price_reduction_ratio_45j(y: TaxableYear, ratio: Decimal) kind institutional {
    label en official "section 45J(c)(2): the excess of the reference price over 8 cents (indexed, rounded to the nearest 0.1 cent) over 3 cents, between zero and one";
}
@source(IRC_S45J_C, quote = "If any amount as increased under the preceding sentence is not a multiple of 0.1 cent, such amount shall be rounded to the nearest multiple of 0.1 cent.")
rule PriceReductionRatio45jRule(y: TaxableYear, price: Decimal, factor: Decimal) strict {
    when reference_price_cents_45j(y, price);
    when inflation_adjustment_factor_45j(y, factor);
    then price_reduction_ratio_45j(y, min(1.0, max(0.0, div_round(price - round(8.0 * factor, 1, "HALF_UP"), 3.0, 10, "HALF_UP"))));
}
pub relation capacity_ratio_45j(facility: Asset, ratio: Decimal) kind institutional {
    label en official "section 45J(b)(1): the ratio of the allocated capacity to the nameplate capacity (at most one)";
}
@source(IRC_S45J_B, quote = "shall not exceed the amount which bears the same ratio to such amount of credit as")
rule CapacityRatio45jRule(facility: Asset, allocated: Decimal, nameplate: Decimal) strict {
    when allocated_megawatt_capacity_45j(facility, allocated);
    when nameplate_megawatt_capacity_45j(facility, nameplate);
    then capacity_ratio_45j(facility, min(1.0, div_round(allocated, nameplate, 10, "HALF_UP")));
}
pub relation facility_credit_45j(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 45J(a)-(c): the credit of the facility after the capacity ratio, the price reduction and the $125,000,000 x allocated megawatts / 1,000 cap";
}
@source(IRC_S45J_C, quote = "shall not exceed an amount which bears the same ratio to $125,000,000 as")
rule FacilityCredit45jRule(facility: Asset, y: TaxableYear, before: Money, cap_ratio: Decimal, price_ratio: Decimal, allocated: Decimal) defeasible {
    when credit_before_limits_45j(facility, y, before);
    when capacity_ratio_45j(facility, cap_ratio);
    when price_reduction_ratio_45j(y, price_ratio);
    when allocated_megawatt_capacity_45j(facility, allocated);
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then facility_credit_45j(facility, y, min(round(before * cap_ratio * (1.0 - price_ratio), 2, "HALF_UP"), div_round(125000000.00 USD * allocated, 1000.0, 2, "HALF_UP")));
}

// --- (e): election by a qualified public entity --------------------------------------------------

pub enum ProjectPartnerRole45J {
    DesignOrConstruction,
    NuclearSteamSupplySystem,
    NuclearFuel,
    FinancialInstitution,
    OwnershipInterest,
}
pub relation government_entity_45j(pub_entity: Person) kind empirical {
    label en official "a Federal, State, or local government entity, or any political subdivision, agency, or instrumentality thereof (section 45J(e)(2)(A)(i)) — case-asserted";
}
pub relation electric_cooperative_45j(pub_entity: Person) kind empirical {
    label en official "a mutual or cooperative electric company described in section 501(c)(12) or 1381(a)(2) (section 45J(e)(2)(A)(ii)) — case-asserted";
}
pub relation rural_electrification_utility_45j(pub_entity: Person) kind empirical {
    label en official "a not-for-profit electric utility which had or has received a loan or loan guarantee under the Rural Electrification Act of 1936 (section 45J(e)(2)(A)(iii)) — case-asserted";
}
pub relation project_partner_role_45j(partner: Person, facility: Asset, partner_role: ProjectPartnerRole45J) kind empirical {
    label en official "the person's role in the advanced nuclear power facility: design or construction, nuclear steam supply system, nuclear fuel, financing, or ownership interest (section 45J(e)(2)(B)) — case-asserted";
}
pub relation qualified_public_entity_45j(pub_entity: Person) kind institutional {
    label en official "section 45J(e)(2)(A): a qualified public entity";
}
rule QualifiedPublicEntityGovernment45jRule(pub_entity: Person) strict {
    when government_entity_45j(pub_entity);
    then qualified_public_entity_45j(pub_entity);
}
rule QualifiedPublicEntityCooperative45jRule(pub_entity: Person) strict {
    when electric_cooperative_45j(pub_entity);
    then qualified_public_entity_45j(pub_entity);
}
rule QualifiedPublicEntityRuralUtility45jRule(pub_entity: Person) strict {
    when rural_electrification_utility_45j(pub_entity);
    then qualified_public_entity_45j(pub_entity);
}
pub relation eligible_project_partner_45j(partner: Person, facility: Asset) kind institutional {
    label en official "section 45J(e)(2)(B): a person with a design, construction, steam supply, fuel, financing or ownership role in the facility";
}
rule EligibleProjectPartner45jRule(partner: Person, facility: Asset, partner_role: ProjectPartnerRole45J) strict {
    when project_partner_role_45j(partner, facility, partner_role);
    then eligible_project_partner_45j(partner, facility);
}
pub relation elects_project_partner_as_taxpayer_45j(pub_entity: Person, partner: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the qualified public entity's exercise of the section 45J(e)(1)(B) election with respect to the credit — case-asserted";
}
relation election_conditions_met_45j(pub_entity: Person, partner: Person, facility: Asset) kind institutional;
rule ElectionConditionsMet45jRule(pub_entity: Person, partner: Person, facility: Asset) strict {
    when qualified_public_entity_45j(pub_entity);
    when eligible_project_partner_45j(partner, facility);
    then election_conditions_met_45j(pub_entity, partner, facility);
}
pub relation partner_treated_as_taxpayer_45j(partner: Person, facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45J(e)(1): the eligible project partner, not the qualified public entity, is treated as the taxpayer for the credit";
}
@source(IRC_S45J_E, quote = "the eligible project partner specified in such election, and not the qualified public entity, shall be treated as the taxpayer for purposes of this title with respect to such credit")
rule Section45jEElectionRule(pub_entity: Person, partner: Person, facility: Asset, y: TaxableYear) strict {
    when elects_project_partner_as_taxpayer_45j(pub_entity, partner, facility, y);
    then power Section45jE1Election {
        holder pub_entity;
        over partner;
        exercise elects_project_partner_as_taxpayer_45j(pub_entity, partner, facility, y);
        valid_when election_conditions_met_45j(pub_entity, partner, facility);
        effect create(partner_treated_as_taxpayer_45j(partner, facility, y));
        window [@2005-08-08, infinity);
    };
}
pub relation credit_holder_45j(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the person treated as the taxpayer for the facility's credit: the owner, or the partner under a valid election";
}
rule CreditHolderOwner45jRule(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) defeasible {
    when nuclear_facility_owned_by_taxpayer_45j(facility, taxpayer);
    when facility_credit_45j(facility, y, amount);
    when not_known(partner_election_in_effect_45j(facility, y));
    when not_known(has_gross_sales_share_45(facility, taxpayer));
    then credit_holder_45j(taxpayer, facility, y, amount);
}
@source(IRC_S45J_F, quote = "Rules similar to the rules of paragraphs (1), (3), (4), and (5) of section 45(e) shall apply for purposes of this section.")
rule CreditHolderOwnerShare45jRule(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money, share: Decimal) defeasible {
    label en official "an owner of a facility with more than one owner: the credit of the facility times the owner's interest in the gross sales (section 45J(f), by section 45(e)(3); JUDGMENT CALL: the facility-level limits apply first)";
    when nuclear_facility_owned_by_taxpayer_45j(facility, taxpayer);
    when facility_credit_45j(facility, y, amount);
    when ownership_share_of_gross_sales_45(facility, taxpayer, share);
    when not_known(partner_election_in_effect_45j(facility, y));
    then credit_holder_45j(taxpayer, facility, y, round(amount * share, 2, "HALF_UP"));
}
relation partner_election_in_effect_45j(facility: Asset, y: TaxableYear) kind institutional;
rule PartnerElectionInEffect45jRule(partner: Person, facility: Asset, y: TaxableYear) strict {
    when partner_treated_as_taxpayer_45j(partner, facility, y);
    then partner_election_in_effect_45j(facility, y);
}
rule CreditHolderPartner45jRule(partner: Person, facility: Asset, y: TaxableYear, amount: Money) defeasible {
    when partner_treated_as_taxpayer_45j(partner, facility, y);
    when facility_credit_45j(facility, y, amount);
    then credit_holder_45j(partner, facility, y, amount);
}
pub relation advanced_nuclear_power_facility_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45J advanced nuclear power facility production credit for the taxable year (a section 38(b)(21) component)";
}
rule AdvancedNuclearPowerFacilityProductionCredit45jRule(taxpayer: Person, y: TaxableYear, facility: Asset, amount: Money) defeasible {
    when credit_holder_45j(taxpayer, facility, y, amount);
    then advanced_nuclear_power_facility_production_credit(taxpayer, y,
        sum(collect all a: Money, f: Asset where credit_holder_45j(taxpayer, f, y, a), empty: 0 USD));
}
