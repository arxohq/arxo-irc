// Section 45V — the petition for a lifecycle emissions rate of (c)(2)(C), the modified facility rule of (d)(4), the prevailing wage and
// apprenticeship requirements structure of (e)(2)-(3), and the Secretary's guidance duty of (f). Stage 2f (IRC-06, DECISION-0379, TECH_GAP
// reduction of the stage 2d rows of TECH-GAPS G1783). Companion of `45v-clean-hydrogen-production-credit.law`; its credit rules read the
// wage and apprenticeship status and the placed-in-service date as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the date the Secretary publishes the guidance of (e)(2) is a case fact (never a literal); the enactment date of section 45V
// is a case fact of the (f) time limit; the apprenticeship requirement of (e)(4) is one case fact.

// --- (c)(2)(C): the petition for a lifecycle emissions rate --------------------------------------------------------------------------------------------

use self::{
    Asset,
    IRC_S45V_C,
    IRC_S45V_D,
    IRC_S45V_E,
    IRC_S45V_F,
    Person,
    facility_construction_begins_on_45v,
    facility_originally_placed_in_service_on_45v,
};

pub relation hydrogen_producer_45v(taxpayer: Person, hydrogen: Asset) kind empirical {
    label en official "the taxpayer produces the hydrogen — case-asserted";
}
pub relation lifecycle_rate_determined_45v(hydrogen: Asset) kind empirical {
    label en official "a lifecycle greenhouse gas emissions rate has been determined for the hydrogen for purposes of this section — case-asserted";
}
pub relation files_petition_for_lifecycle_rate_45v(taxpayer: Person, hydrogen: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 45V(c)(2)(C) power to file a petition with the Secretary for the determination of the lifecycle greenhouse gas emissions rate";
}
pub relation lifecycle_rate_petition_pending_45v(taxpayer: Person, hydrogen: Asset) kind institutional {
    label en official "section 45V(c)(2)(C): a petition for the determination of the lifecycle greenhouse gas emissions rate of hydrogen for which none has been determined is filed with the Secretary";
}
@source(IRC_S45V_C, relation = formalizes, coverage = exact, quote = "a taxpayer producing such hydrogen may file a petition with the Secretary for determination of the lifecycle greenhouse gas emissions rate with respect to such hydrogen")
rule Section45VC2CPetitionRule(taxpayer: Person, hydrogen: Asset) defeasible {
    when hydrogen_producer_45v(taxpayer, hydrogen);
    when files_petition_for_lifecycle_rate_45v(taxpayer, hydrogen);
    when not_known(lifecycle_rate_determined_45v(hydrogen));
    then power Section45VC2CLifecycleRatePetition {
        holder taxpayer;
        over us.irc.core::Secretary;
        exercise files_petition_for_lifecycle_rate_45v(taxpayer, hydrogen);
        valid_when hydrogen_producer_45v(taxpayer, hydrogen);
        effect create(lifecycle_rate_petition_pending_45v(taxpayer, hydrogen));
        window [-infinity, infinity);
    };
}

// --- (d)(4): a facility modified to produce qualified clean hydrogen ----------------------------------------------------------------------------------

pub relation produced_qualified_clean_hydrogen_before_modification_45v(facility: Asset) kind empirical {
    label en official "the facility produced qualified clean hydrogen before the modification (section 45V(d)(4)(A)) — case-asserted";
}
pub relation modified_to_produce_qualified_clean_hydrogen_after_original_service_45v(facility: Asset) kind empirical {
    label en official "after the date the facility was originally placed in service, it is modified to produce qualified clean hydrogen (section 45V(d)(4)(B)(i)) — case-asserted";
}
pub relation modification_amounts_chargeable_to_capital_account_45v(facility: Asset) kind empirical {
    label en official "the amounts paid or incurred with respect to the modification are properly chargeable to the taxpayer's capital account (section 45V(d)(4)(B)(ii)) — case-asserted";
}
pub relation modification_property_placed_in_service_on_45v(facility: Asset, on: Date) kind empirical {
    label en official "the date the property required to complete the modification is placed in service — case-asserted";
}
pub relation deemed_originally_placed_in_service_on_45v(facility: Asset, on: Date) kind institutional {
    label en official "section 45V(d)(4): a facility originally placed in service before 2023 that did not produce qualified clean hydrogen and is later modified to produce it, with the cost capitalized, is deemed originally placed in service when the property required to complete the modification is placed in service";
}
@source(IRC_S45V_D, relation = formalizes, coverage = exact, quote = "such facility shall be deemed to have been originally placed in service as of the date that the property required to complete the modification described in subparagraph (B) is placed in service")
rule DeemedOriginallyPlacedInServiceRule(facility: Asset, original: Date, completed: Date) strict {
    when facility_originally_placed_in_service_on_45v(facility, original);
    when original < @2023-01-01;
    when not_known(produced_qualified_clean_hydrogen_before_modification_45v(facility));
    when modified_to_produce_qualified_clean_hydrogen_after_original_service_45v(facility);
    when modification_amounts_chargeable_to_capital_account_45v(facility);
    when modification_property_placed_in_service_on_45v(facility, completed);
    then deemed_originally_placed_in_service_on_45v(facility, completed);
}

// --- (e)(2)-(3): the prevailing wage and apprenticeship requirements ---------------------------------------------------------------------------------

pub relation guidance_published_on_45v(on: Date) kind empirical {
    label en official "the date the Secretary publishes guidance with respect to the requirements of paragraphs (3)(A) and (4) of section 45V(e) — case-asserted, not pinned";
}
pub relation wages_at_least_prevailing_for_construction_45v(facility: Asset) kind empirical {
    label en official "laborers and mechanics employed by the taxpayer or any contractor or subcontractor in the construction of the facility are paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality, as most recently determined by the Secretary of Labor (section 45V(e)(3)(A)(i)) — case-asserted";
}
pub relation wages_at_least_prevailing_for_alteration_or_repair_in_period_45v(facility: Asset) kind empirical {
    label en official "laborers and mechanics in the alteration or repair of the facility during the portion of the taxable year within the period described in subsection (a)(2) are paid wages at not less than the prevailing rates (section 45V(e)(3)(A)(ii)) — case-asserted";
}
pub relation prevailing_wage_requirement_met_45v(facility: Asset) kind institutional {
    label en official "section 45V(e)(3)(A): prevailing wages are paid for the construction and for the alteration or repair within the credit period";
}
@source(IRC_S45V_E, relation = formalizes, coverage = exact, quote = "shall be paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality in which such facility is located")
rule PrevailingWageRequirementMet45vRule(facility: Asset) strict {
    when wages_at_least_prevailing_for_construction_45v(facility);
    when wages_at_least_prevailing_for_alteration_or_repair_in_period_45v(facility);
    then prevailing_wage_requirement_met_45v(facility);
}
pub relation wages_at_least_prevailing_for_repair_after_guidance_45v(facility: Asset) kind empirical {
    label en official "the facility meets the requirements of paragraph (3)(A) with respect to alteration or repair occurring after the date 60 days after the guidance (section 45V(e)(2)(A)(ii)) — case-asserted";
}
pub relation apprenticeship_requirements_met_45v(facility: Asset) kind empirical {
    label en official "the taxpayer satisfies the requirements of paragraph (4) of section 45V(e) with respect to the construction of the facility — case-asserted";
}
pub relation facility_meets_e2_requirements_45v(facility: Asset) kind institutional {
    label en official "section 45V(e)(2): a facility whose construction begins before 60 days after the guidance and that meets the wage requirement for later alteration or repair, or a facility that satisfies paragraphs (3)(A) and (4)";
}
@source(IRC_S45V_E, relation = formalizes, coverage = exact, quote = "the construction of which begins prior to the date that is 60 days after the Secretary publishes guidance with respect to the requirements of paragraphs (3)(A) and (4)")
rule FacilityMeetsE2GrandfatheredRule(facility: Asset, begins: Date, g: Date) strict {
    when facility_construction_begins_on_45v(facility, begins);
    when guidance_published_on_45v(g);
    when begins < add_calendar_period(g, 60 calendar_day);
    when wages_at_least_prevailing_for_repair_after_guidance_45v(facility);
    then facility_meets_e2_requirements_45v(facility);
}
@source(IRC_S45V_E, relation = formalizes, coverage = exact, quote = "A facility which satisfies the requirements of paragraphs (3)(A) and (4).")
rule FacilityMeetsE2SatisfiesRule(facility: Asset) strict {
    when prevailing_wage_requirement_met_45v(facility);
    when apprenticeship_requirements_met_45v(facility);
    then facility_meets_e2_requirements_45v(facility);
}

// --- (f): the guidance duty --------------------------------------------------------------------------------------------------------------------------------------

pub relation section_45v_enacted_on_45v(on: Date) kind empirical {
    label en official "the date of enactment of section 45V (the reference date of the (f) time limit) — case-asserted from the pinned Public Law note";
}
pub relation regulations_or_guidance_issued_45v(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary has issued regulations or other guidance to carry out the purposes of section 45V, including for determining lifecycle greenhouse gas emissions";
}
@source(IRC_S45V_F, relation = formalizes, coverage = exact, quote = "Not later than 1 year after the date of enactment of this section, the Secretary shall issue regulations or other guidance to carry out the purposes of this section")
rule Section45VFGuidanceDutyRule(on: Date) strict {
    when section_45v_enacted_on_45v(on);
    then duty Section45VFGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_or_guidance_issued_45v(us.irc.core::Secretary);
            window [on, add_calendar_period(on, 12 calendar_month)];
        }
    };
}
