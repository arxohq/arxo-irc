// Section 43 — the qualified enhanced oil recovery costs of (c)(1), the qualified project of (c)(2), the tertiary method and Alaska natural gas
// rules of (c)(4)-(5), the deduction and basis reductions of (d), and the election not to apply the section of (e). Stage 2f (IRC-06,
// DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of `43-enhanced-oil-recovery-credit.law`; its credit
// rules read the qualified cost total as a case fact and are NOT rewired to require these relations.
//
// Judgment calls: the engineering test "can reasonably be expected to result in more than an insignificant increase" is one case fact
// backed by the petroleum engineer certification of (c)(2)(B); the certification is a case fact of the operator's submission; cents HALF_UP;
// the election of (e) is a power of the taxpayer whose timeliness reads the asserted return due date.

use self::{
    Asset,
    IRC_S43_C,
    IRC_S43_D,
    IRC_S43_E,
    Person,
    TaxableYear,
};

pub enum CostKind43 { TangibleProperty, IntangibleDrillingCosts, TertiaryInjectant, GasTreatmentPlant }
pub enum RecoveryMethod43 { TertiaryMethodUnder193b3, ImmiscibleNonHydrocarbonGasDisplacement, OtherMethod }

// --- (c)(2), (c)(4): the qualified enhanced oil recovery project ---------------------------------------------------------------------------------

pub relation project_recovery_method_43(project: Asset, method: RecoveryMethod43) kind empirical {
    label en official "the recovery method applied by the project (section 43(c)(2)(A)(i), (c)(4)) — case-asserted";
}
pub relation project_expected_to_increase_recovery_more_than_insignificantly_43(project: Asset) kind empirical {
    label en official "the method, applied in accordance with sound engineering principles, can reasonably be expected to result in more than an insignificant increase in the crude oil ultimately recovered (section 43(c)(2)(A)(i)) — case-asserted";
}
pub relation project_located_in_united_states_43(project: Asset) kind empirical {
    label en official "the project is located within the United States within the meaning of section 638(1) (section 43(c)(2)(A)(ii)) — case-asserted";
}
pub relation first_injection_commences_on_43(project: Asset, on: Date) kind empirical {
    label en official "the date the first injection of liquids, gases or other matter commences (section 43(c)(2)(A)(iii)) — case-asserted";
}
pub relation petroleum_engineer_certification_submitted_43(project: Asset) kind empirical {
    label en official "the operator submits to the Secretary, at such times and in such manner as the Secretary provides, a certification from a petroleum engineer that the project meets (and continues to meet) the requirements of subparagraph (A) (section 43(c)(2)(B)) — case-asserted";
}
pub relation tertiary_recovery_method_43(project: Asset) kind institutional {
    label en official "sections 43(c)(2)(A)(i), (c)(4): a tertiary recovery method under section 193(b)(3), and immiscible non-hydrocarbon gas displacement, which is treated as one";
}
rule TertiaryRecoveryMethodStatutoryRule(project: Asset) strict {
    when project_recovery_method_43(project, TertiaryMethodUnder193b3);
    then tertiary_recovery_method_43(project);
}
@source(IRC_S43_C, relation = formalizes, coverage = exact, quote = "immiscible non-hydrocarbon gas displacement shall be treated as a tertiary recovery method under section 193(b)(3)")
rule TertiaryRecoveryMethodImmiscibleGasRule(project: Asset) strict {
    when project_recovery_method_43(project, ImmiscibleNonHydrocarbonGasDisplacement);
    then tertiary_recovery_method_43(project);
}
pub relation qualified_enhanced_oil_recovery_project_43(project: Asset) kind institutional {
    label en official "section 43(c)(2): a project applying a tertiary recovery method reasonably expected to increase recovery more than insignificantly, located in the United States, with first injection after 1990-12-31, and certified by a petroleum engineer";
}
@source(IRC_S43_C, relation = formalizes, coverage = exact, quote = "The term \"qualified enhanced oil recovery project\" means any project")
rule QualifiedEnhancedOilRecoveryProjectRule(project: Asset, first: Date) strict {
    when tertiary_recovery_method_43(project);
    when project_expected_to_increase_recovery_more_than_insignificantly_43(project);
    when project_located_in_united_states_43(project);
    when first_injection_commences_on_43(project, first);
    when first > @1990-12-31;
    when petroleum_engineer_certification_submitted_43(project);
    then qualified_enhanced_oil_recovery_project_43(project);
}

// --- (c)(5): Alaska natural gas -------------------------------------------------------------------------------------------------------------------------------

pub relation gas_enters_alaska_natural_gas_pipeline_43(gas: Asset) kind empirical {
    label en official "the natural gas (section 613A(e)(2)) enters the Alaska natural gas pipeline as defined in section 168(i)(16), without regard to subparagraph (B) thereof (section 43(c)(5)(A)) — case-asserted";
}
pub relation well_north_of_64_degrees_excluding_anwr_43(gas: Asset) kind empirical {
    label en official "the gas is produced from a well located in the area of the State of Alaska lying north of 64 degrees North latitude, determined by excluding the area of the Alaska National Wildlife Refuge (including its continental shelf) (section 43(c)(5)(A)(i)) — case-asserted";
}
pub relation produced_under_pollution_and_permit_requirements_43(gas: Asset) kind empirical {
    label en official "the gas is produced pursuant to the applicable State and Federal pollution prevention, control, and permit requirements (section 43(c)(5)(A)(ii)) — case-asserted";
}
pub relation alaska_natural_gas_43(gas: Asset) kind institutional {
    label en official "section 43(c)(5)(A): natural gas entering the Alaska natural gas pipeline that is produced from a well north of 64 degrees North latitude (excluding the Alaska National Wildlife Refuge) under the applicable pollution and permit requirements";
}
@source(IRC_S43_C, relation = formalizes, coverage = exact, quote = "The term \"Alaska natural gas\" means natural gas entering the Alaska natural gas pipeline")
rule AlaskaNaturalGasRule(gas: Asset) strict {
    when gas_enters_alaska_natural_gas_pipeline_43(gas);
    when well_north_of_64_degrees_excluding_anwr_43(gas);
    when produced_under_pollution_and_permit_requirements_43(gas);
    then alaska_natural_gas_43(gas);
}

// --- (c)(1): the qualified costs ------------------------------------------------------------------------------------------------------------------------------

pub relation cost_item_of_project_43(taxpayer: Person, item: Asset, y: TaxableYear, project: Asset, kind: CostKind43, amount: Money) kind empirical {
    label en official "an amount paid or incurred during the taxable year in connection with the project, of the kind of section 43(c)(1)(A)-(D) — case-asserted";
}
pub relation cost_integral_part_and_depreciable_43(item: Asset) kind empirical {
    label en official "the tangible property is an integral part of the qualified enhanced oil recovery project and depreciation (or amortization) is allowable (section 43(c)(1)(A)) — case-asserted";
}
pub relation section_263c_election_available_43(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer may make an election under section 263(c) for the taxable year with respect to the intangible drilling and development costs (section 43(c)(1)(B)(ii)) — case-asserted";
}
pub relation tertiary_injectant_expenses_deductible_43(item: Asset) kind empirical {
    label en official "the qualified tertiary injectant expenses (section 193(b)) are paid or incurred in connection with the project and a deduction is allowable for the taxable year (section 43(c)(1)(C)) — case-asserted";
}
pub relation plant_north_of_64_degrees_43(item: Asset) kind empirical {
    label en official "the gas treatment plant is located in the area of the United States (section 638(1)) lying north of 64 degrees North latitude (section 43(c)(1)(D)(i)) — case-asserted";
}
pub relation plant_pipeline_capacity_btu_per_day_43(item: Asset, btu: Decimal) kind empirical {
    label en official "the capacity, in Btu of natural gas per day, of the pipeline for which the plant prepares Alaska natural gas (section 43(c)(1)(D)(ii)) — case-asserted";
}
pub relation plant_produces_co2_injected_into_hydrocarbon_formations_43(item: Asset) kind empirical {
    label en official "the plant produces carbon dioxide which is injected into hydrocarbon-bearing geological formations (section 43(c)(1)(D)(iii)) — case-asserted";
}
pub relation qualified_cost_43(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 43(c)(1): tangible property integral to a qualified project and depreciable, intangible drilling and development costs eligible for a section 263(c) election, deductible qualified tertiary injectant expenses, and the construction cost of a qualifying Alaska gas treatment plant";
}
@source(IRC_S43_C, relation = formalizes, coverage = exact, quote = "Any amount paid or incurred during the taxable year for tangible property")
rule QualifiedCostTangibleRule(taxpayer: Person, item: Asset, y: TaxableYear, project: Asset, amount: Money) defeasible {
    when cost_item_of_project_43(taxpayer, item, y, project, TangibleProperty, amount);
    when qualified_enhanced_oil_recovery_project_43(project);
    when cost_integral_part_and_depreciable_43(item);
    then qualified_cost_43(taxpayer, item, y, amount);
}
@source(IRC_S43_C, relation = formalizes, coverage = exact, quote = "Any intangible drilling and development costs")
rule QualifiedCostIntangibleRule(taxpayer: Person, item: Asset, y: TaxableYear, project: Asset, amount: Money) defeasible {
    when cost_item_of_project_43(taxpayer, item, y, project, IntangibleDrillingCosts, amount);
    when qualified_enhanced_oil_recovery_project_43(project);
    when section_263c_election_available_43(taxpayer, y);
    then qualified_cost_43(taxpayer, item, y, amount);
}
@source(IRC_S43_C, relation = formalizes, coverage = exact, quote = "Any qualified tertiary injectant expenses (as defined in section 193(b))")
rule QualifiedCostInjectantRule(taxpayer: Person, item: Asset, y: TaxableYear, project: Asset, amount: Money) defeasible {
    when cost_item_of_project_43(taxpayer, item, y, project, TertiaryInjectant, amount);
    when qualified_enhanced_oil_recovery_project_43(project);
    when tertiary_injectant_expenses_deductible_43(item);
    then qualified_cost_43(taxpayer, item, y, amount);
}
@source(IRC_S43_C, relation = formalizes, coverage = exact, quote = "Any amount which is paid or incurred during the taxable year to construct a gas treatment plant")
rule QualifiedCostGasTreatmentPlantRule(taxpayer: Person, item: Asset, y: TaxableYear, project: Asset, amount: Money, capacity: Decimal) defeasible {
    when cost_item_of_project_43(taxpayer, item, y, project, GasTreatmentPlant, amount);
    when plant_north_of_64_degrees_43(item);
    when plant_pipeline_capacity_btu_per_day_43(item, capacity);
    when capacity >= 2000000000000.0;
    when plant_produces_co2_injected_into_hydrocarbon_formations_43(item);
    then qualified_cost_43(taxpayer, item, y, amount);
}
pub relation qualified_costs_computed_43(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 43(c)(1): the sum of the qualified enhanced oil recovery costs of the taxable year";
}
rule QualifiedCostsComputedRule(taxpayer: Person, y: TaxableYear, one_item: Asset, one_amount: Money) defeasible {
    when qualified_cost_43(taxpayer, one_item, y, one_amount);
    then qualified_costs_computed_43(taxpayer, y,
        sum(collect all a: Money, i: Asset where qualified_cost_43(taxpayer, i, y, a), empty: 0 USD));
}

// --- (d): the deduction and basis reductions ------------------------------------------------------------------------------------------------------------

pub relation deduction_allowable_for_cost_43(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deduction otherwise allowable for the cost taken into account in computing the credit — case-asserted";
}
pub relation credit_attributable_to_cost_43(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit attributable to the cost — case-asserted";
}
pub relation deduction_after_credit_43(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 43(d)(1): any deduction allowable for the costs taken into account in computing the credit is reduced by the credit attributable to those costs (not below zero)";
}
@source(IRC_S43_D, relation = formalizes, coverage = exact, quote = "shall be reduced by the amount of such credit attributable to such costs")
rule DeductionAfterCreditRule(taxpayer: Person, item: Asset, y: TaxableYear, deduction: Money, credit: Money) strict {
    when deduction_allowable_for_cost_43(taxpayer, item, y, deduction);
    when credit_attributable_to_cost_43(taxpayer, item, y, credit);
    then deduction_after_credit_43(taxpayer, item, y, max(deduction - credit, 0 USD));
}
pub relation basis_increase_before_credit_43(taxpayer: Person, item: Asset, amount: Money) kind empirical {
    label en official "the increase in the basis of the property that would, but for subsection (d)(2), result from the expenditure — case-asserted";
}
pub relation credit_determined_for_expenditure_43(taxpayer: Person, item: Asset, amount: Money) kind empirical {
    label en official "the credit determined under section 43 for the expenditure with respect to the property — case-asserted";
}
pub relation basis_increase_after_credit_43(taxpayer: Person, item: Asset, amount: Money) kind institutional {
    label en official "section 43(d)(2): the increase in the basis of the property is reduced by the credit determined (not below zero)";
}
@source(IRC_S43_D, relation = formalizes, coverage = exact, quote = "the increase in the basis of such property which would (but for this subsection) result from such expenditure shall be reduced by the amount of the credit so allowed")
rule BasisIncreaseAfterCreditRule(taxpayer: Person, item: Asset, increase: Money, credit: Money) strict {
    when basis_increase_before_credit_43(taxpayer, item, increase);
    when credit_determined_for_expenditure_43(taxpayer, item, credit);
    then basis_increase_after_credit_43(taxpayer, item, max(increase - credit, 0 USD));
}

// --- (e): the election not to apply the section -----------------------------------------------------------------------------------------------------------

pub relation elects_not_to_apply_section_43_43(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's exercise of the section 43(e)(1) election to have the section not apply for the taxable year (or its revocation)";
}
pub relation election_made_on_43(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the date the election under paragraph (1) is made or revoked — case-asserted";
}
pub relation return_due_date_without_extensions_43(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the last date prescribed by law for filing the return for the taxable year, determined without regard to extensions — case-asserted";
}
pub relation election_timely_43(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 43(e)(2): the election may be made or revoked at any time before the expiration of the 3-year period beginning on the last date prescribed by law for filing the return (without regard to extensions)";
}
@source(IRC_S43_E, relation = formalizes, coverage = exact, quote = "at any time before the expiration of the 3-year period beginning on the last date prescribed by law for filing the return for such taxable year (determined without regard to extensions)")
rule ElectionTimelyRule(taxpayer: Person, y: TaxableYear, made: Date, due: Date) strict {
    when election_made_on_43(taxpayer, y, made);
    when return_due_date_without_extensions_43(taxpayer, y, due);
    when made < add_calendar_period(due, 36 calendar_month);
    then election_timely_43(taxpayer, y);
}
pub relation section_43_not_applicable_43(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 43(e)(1): the section does not apply for the taxable year for which the timely election is made";
}
@source(IRC_S43_E, relation = formalizes, coverage = exact, quote = "A taxpayer may elect to have this section not apply for any taxable year.")
rule Section43E1ElectionRule(taxpayer: Person, y: TaxableYear) defeasible {
    when elects_not_to_apply_section_43_43(taxpayer, y);
    when election_timely_43(taxpayer, y);
    then power Section43E1NotApplyElection {
        holder taxpayer;
        over taxpayer;
        exercise elects_not_to_apply_section_43_43(taxpayer, y);
        valid_when election_timely_43(taxpayer, y);
        effect create(section_43_not_applicable_43(taxpayer, y));
        window [-infinity, infinity);
    };
}
