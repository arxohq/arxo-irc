// Section 42 — residual subsections: credit period (f), housing credit dollar
// amount and State ceiling (h), compliance period and low-income unit (i),
// recapture (j), certifications and agency reports (l), agency determinations
// (m). Stage 2d (IRC-06, DECISION-0379). Companion of
// `42-low-income-housing-credit.law` (stage 2: (a)-(b), (g)); this module does
// NOT replace that module's `low_income_housing_credit` (read by section
// 38(b)(5)); the limits computed here are separate relations (TECH-GAPS G1822).
//
// Editions by `legal_time` (PL 119-21 section 70422, pinned as
// `us.irc.temporal::PL119_21_S70422`, enacted 2025-07-04): the 2024 text raises
// the (h)(3)(C)(ii) dollar amounts by 12.5 percent for calendar years 2018-2021;
// from 2025-07-04 the increase is 12 percent for calendar years beginning after
// 2025-12-31 (the 2018-2021 increase then applies to those years by its own
// terms). Modelled with `effective` windows.
//
// Scope / judgment calls:
// * (f)(1)-(3): the credit period (10 taxable years from the year of placing in
//   service or, by irrevocable election, the succeeding year, for a building
//   that is a qualified low-income building at the close of the first year); the
//   first-year fraction is the average of the monthly applicable fractions; an
//   increase of qualified basis in later years gets 2/3 of the applicable
//   percentage.
// * (h): the credit may not exceed the housing credit dollar amount allocated;
//   the State ceiling of a calendar year is the unused amount of the prior year,
//   the greater of $1.75 per capita and $2,000,000 (indexed, rounded down to 5
//   cents / $5,000, then increased by the (I) factor), returned amounts and the
//   Secretary allocation. Agencies are bound by prohibitions: allocations only
//   to buildings in their jurisdiction; at most 90 percent of the ceiling to
//   projects other than nonprofit-owned ones. No credit without an extended
//   low-income housing commitment in effect at the end of the year; the
//   extended use period ends on the later of the agreed date and 15 years after
//   the compliance period.
// * (i): compliance period 15 taxable years; low-income unit tests. (j):
//   recapture on a decrease of qualified basis: the accelerated portion and
//   interest are case-asserted. (l): the taxpayer certification duty and the
//   agency annual report duty. (m): the housing credit dollar amount is zero
//   unless the qualified allocation plan conditions hold.

use self::{
    Asset,
    IRC_S42_F,
    IRC_S42_H,
    IRC_S42_I,
    IRC_S42_J,
    IRC_S42_L,
    IRC_S42_M,
    Person,
    TaxableYear,
    de_minimis_relief_conditions_met_42,
    following_taxable_year_of,
    recapturable_qualified_basis_decrease_42,
    secretary_provides_de_minimis_relief_42,
    small_owner_occupied_exclusion_applies_42,
};

pub relation building_placed_in_service_on_42(building: Asset, on: Date) kind empirical {
    label en official "the date the building is placed in service (section 42(f)(1)(A)) — case-asserted";
}
pub relation elects_succeeding_year_credit_period_42(building: Asset) kind empirical {
    label en official "the taxpayer elects to begin the credit period with the succeeding taxable year (section 42(f)(1)(B)), irrevocable — case-asserted";
}
pub relation qualified_low_income_building_at_first_year_close_42(building: Asset) kind empirical {
    label en official "the building is a qualified low-income building as of the close of the first year of the credit period (section 42(f)(1), last clause) — case-asserted";
}
pub relation monthly_applicable_fraction_42(building: Asset, y: TaxableYear, month: Decimal, fraction: Decimal) kind empirical {
    label en official "the applicable fraction (section 42(c)(1)) as of the close of full month number 1-12 of the first credit year during which the building was a qualified low-income building (a month that does not qualify is asserted as 0) — case-asserted";
}
pub relation qualified_basis_at_close_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified basis of the building as of the close of the taxable year — case-asserted";
}
pub relation applicable_percentage_after_h_42(building: Asset, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the applicable percentage that applies (after the application of subsection (h)) to the building's qualified basis — case-asserted";
}

// --- (f)(1): the credit period; (i)(1): the compliance period ---------------------------------------------------------------------------

relation first_credit_year_begin_42(building: Asset, begin: Date) kind institutional;
@source(IRC_S42_F, quote = "the taxable year in which the building is placed in service")
rule FirstCreditYearPlacedInService42Rule(building: Asset, y: TaxableYear, on: Date, begin: Date, finish: Date) strict {
    when building_placed_in_service_on_42(building, on);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when begin <= on;
    when on <= finish;
    when not_known(elects_succeeding_year_credit_period_42(building));
    then first_credit_year_begin_42(building, begin);
}
@source(IRC_S42_F, quote = "at the election of the taxpayer, the succeeding taxable year")
rule FirstCreditYearElectedSucceeding42Rule(building: Asset, y: TaxableYear, on: Date, begin: Date, finish: Date) strict {
    when building_placed_in_service_on_42(building, on);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when begin <= on;
    when on <= finish;
    when elects_succeeding_year_credit_period_42(building);
    then first_credit_year_begin_42(building, add_calendar_period(begin, 12 calendar_month));
}
pub relation credit_period_year_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(f)(1): a taxable year of the 10-year credit period, for a building that is a qualified low-income building at the close of the first year";
}
rule CreditPeriodYear42Rule(building: Asset, y: TaxableYear, first: Date, begin: Date) strict {
    when first_credit_year_begin_42(building, first);
    when qualified_low_income_building_at_first_year_close_42(building);
    when us.irc.core::begins(y, begin);
    when begin >= first;
    when begin < add_calendar_period(first, 120 calendar_month);
    then credit_period_year_42(building, y);
}
pub relation compliance_period_year_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(i)(1): a taxable year of the 15-taxable-year compliance period beginning with the first year of the credit period";
}
@source(IRC_S42_I, quote = "The term \"compliance period\" means, with respect to any building, the period of 15 taxable years beginning with the 1st taxable year of the credit period with respect thereto.")
rule CompliancePeriodYear42Rule(building: Asset, y: TaxableYear, first: Date, begin: Date) strict {
    when first_credit_year_begin_42(building, first);
    when us.irc.core::begins(y, begin);
    when begin >= first;
    when begin < add_calendar_period(first, 180 calendar_month);
    then compliance_period_year_42(building, y);
}

// --- (f)(2)-(3): the first-year fraction and increased qualified basis ------------------------------------------------------------------------------

pub relation first_year_applicable_fraction_42(building: Asset, y: TaxableYear, fraction: Decimal) kind institutional {
    label en official "section 42(f)(2)(A): the sum of the monthly applicable fractions divided by 12";
}
@source(IRC_S42_F, quote = "the numerator of which is the sum of the applicable fractions determined under subsection (c)(1) as of the close of each full month of such year during which such building")
rule FirstYearApplicableFraction42Rule(building: Asset, y: TaxableYear, first: Date, begin: Date) strict {
    when first_credit_year_begin_42(building, first);
    when us.irc.core::begins(y, begin);
    when begin == first;
    when monthly_applicable_fraction_42(building, y, _, _);
    then first_year_applicable_fraction_42(building, y,
        div_round(sum(collect all f: Decimal, m: Decimal where monthly_applicable_fraction_42(building, y, m, f), empty: 0.0), 12.0, 10, "HALF_UP"));
}
pub relation increased_basis_percentage_42(building: Asset, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 42(f)(3)(A): 2/3 of the applicable percentage for the excess of qualified basis over the first-year basis";
}
@source(IRC_S42_F, quote = "the percentage equal to 2/3 of the applicable percentage which (after the application of subsection (h)) would but for this paragraph apply to such basis")
rule IncreasedBasisPercentage42Rule(building: Asset, y: TaxableYear, pct: Decimal) strict {
    when applicable_percentage_after_h_42(building, y, pct);
    then increased_basis_percentage_42(building, y, div_round(2.0 * pct, 3.0, 10, "HALF_UP"));
}

// --- (h)(3): the State housing credit ceiling ------------------------------------------------------------------------------------------------------

pub relation state_population_42(state: Person, year: Decimal, population: Decimal) kind empirical {
    label en official "the State population for the calendar year, determined under section 146(j) (section 42(h)(3)(G)) — case-asserted";
}
pub relation cost_of_living_factor_42(year: Decimal, factor: Decimal) kind empirical {
    label en official "the cost-of-living adjustment factor of section 1(f)(3) with 2001 substituted for 2016 (section 42(h)(3)(H)); 1.0 for years through 2002 — case-asserted, not pinned";
}
pub relation unused_state_ceiling_prior_year_42(state: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the unused State housing credit ceiling for the preceding calendar year (section 42(h)(3)(C)(i)) — case-asserted";
}
pub relation state_ceiling_returned_42(state: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the State housing credit ceiling returned in the calendar year (section 42(h)(3)(C)(iii)) — case-asserted";
}
pub relation secretary_allocation_to_state_42(state: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the amount allocated to the State by the Secretary from unused carryovers (section 42(h)(3)(C)(iv), (D)) — case-asserted";
}
relation dollar_amount_multiplier_42(year: Decimal, multiplier: Decimal) kind institutional;
@source(IRC_S42_H, quote = "In the case of calendar years 2018, 2019, 2020, and 2021, each of the dollar amounts in effect under clauses (I) and (II) of subparagraph (C)(ii) for any calendar year (after any increase under subparagraph (H)) shall be increased by multiplying such dollar amount by 1.125.")
rule DollarAmountMultiplier20182021Rule(year: Decimal) strict {
    when cost_of_living_factor_42(year, _);
    when year >= 2018.0;
    when year <= 2021.0;
    then dollar_amount_multiplier_42(year, 1.125);
}
rule DollarAmountMultiplierOtherYears42Rule(year: Decimal) strict {
    when cost_of_living_factor_42(year, _);
    when year < 2018.0;
    then dollar_amount_multiplier_42(year, 1.0);
}
rule DollarAmountMultiplierBetween42Rule(year: Decimal) strict {
    when cost_of_living_factor_42(year, _);
    when year > 2021.0;
    when year <= 2025.0;
    then dollar_amount_multiplier_42(year, 1.0);
}
rule DollarAmountMultiplierAfter2025BaseRule(year: Decimal) strict {
    effective (-infinity, @2025-07-04);
    when cost_of_living_factor_42(year, _);
    when year > 2025.0;
    then dollar_amount_multiplier_42(year, 1.0);
}
@source(us.irc.temporal::PL119_21_S70422, quote = "Section 42(h)(3)(I) is amended—(A) by striking “2018, 2019, 2020, and 2021,” and inserting “beginning after December 31, 2025,”, (B) by striking “1.125” and inserting “1.12”")
rule DollarAmountMultiplierAfter2025AmendedRule(year: Decimal) strict {
    effective [@2025-07-04, infinity);
    when cost_of_living_factor_42(year, _);
    when year > 2025.0;
    then dollar_amount_multiplier_42(year, 1.12);
}
pub relation state_housing_credit_ceiling_42(state: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(h)(3)(C): the unused prior-year ceiling, plus the greater of the per-capita amount ($1.75, indexed, rounded down to 5 cents) and $2,000,000 (indexed, rounded down to $5,000), each increased by the (I) multiplier, plus returned amounts and the Secretary allocation";
}
@source(IRC_S42_H, quote = "(I) $1.75 multiplied by the State population, or")
rule StateHousingCreditCeiling42Rule(state: Person, year: Decimal, pop: Decimal, cola: Decimal, multiplier: Decimal, unused: Money, returned: Money, secretary: Money) defeasible {
    when state_population_42(state, year, pop);
    when cost_of_living_factor_42(year, cola);
    when dollar_amount_multiplier_42(year, multiplier);
    when unused_state_ceiling_prior_year_42(state, year, unused);
    when state_ceiling_returned_42(state, year, returned);
    when secretary_allocation_to_state_42(state, year, secretary);
    then state_housing_credit_ceiling_42(state, year,
        unused + returned + secretary
        + max(round(div_round(round(1.75 * cola * 20.0, 0, "FLOOR"), 20.0, 10, "HALF_UP") * multiplier * pop, 2, "HALF_UP") * 1 USD,
              round(round(2000000.0 * cola / 5000.0, 0, "FLOOR") * 5000.0 * multiplier, 2, "HALF_UP") * 1 USD));
}

// --- (h)(1), (h)(7)(B): the allocation limit and its reduction ----------------------------------------------------------------------------------------

pub relation housing_credit_dollar_amount_allocated_42(building: Asset, agency: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the housing credit dollar amount the agency allocates to the building for the calendar year (section 42(h)(1)(A)) — case-asserted";
}
pub relation credit_before_allocation_limit_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 42(a), (f): the applicable percentage times the qualified basis (before the housing credit dollar amount limit)";
}
rule CreditBeforeAllocationLimit42Rule(building: Asset, y: TaxableYear, pct: Decimal, basis: Money) defeasible {
    when credit_period_year_42(building, y);
    when applicable_percentage_after_h_42(building, y, pct);
    when qualified_basis_at_close_42(building, y, basis);
    then credit_before_allocation_limit_42(building, y, round(pct * basis, 2, "HALF_UP"));
}
pub relation credit_after_allocation_limit_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(h)(1)(A): the lesser of the credit and the allocated housing credit dollar amount";
}
@source(IRC_S42_H, quote = "The amount of the credit determined under this section for any taxable year with respect to any building shall not exceed the housing credit dollar amount allocated to such building under this subsection.")
rule CreditAfterAllocationLimit42Rule(building: Asset, y: TaxableYear, credit: Money, agency: Person, year: Decimal, allocated: Money) defeasible {
    when credit_before_allocation_limit_42(building, y, credit);
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    then credit_after_allocation_limit_42(building, y, min(credit, allocated));
}
pub relation agency_allocations_total_42(agency: Person, year: Decimal, total: Money) kind empirical {
    label en official "the aggregate housing credit dollar amounts the agency allocated for the calendar year — case-asserted";
}
pub relation agency_ceiling_portion_42(agency: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the portion of the State housing credit ceiling allocated to the agency for the calendar year (section 42(h)(3)(A)-(B)) — case-asserted";
}
pub relation allocation_excess_reduction_42(agency: Person, year: Decimal, excess: Money) kind institutional {
    label en official "section 42(h)(7)(B): the allocations above the agency portion are reduced (to the extent of the excess) in the reverse order of allocation";
}
@source(IRC_S42_H, quote = "the housing credit dollar amounts so allocated shall be reduced (to the extent of such excess) for buildings in the reverse of the order in which the allocations of such amounts were made")
rule AllocationExcessReduction42Rule(agency: Person, year: Decimal, total: Money, portion: Money) strict {
    when agency_allocations_total_42(agency, year, total);
    when agency_ceiling_portion_42(agency, year, portion);
    when total > portion;
    then allocation_excess_reduction_42(agency, year, total - portion);
}

// --- (h)(7)(A), (h)(5): agency prohibitions ------------------------------------------------------------------------------------------------------------------

pub relation agency_allocates_to_building_42(agency: Person, building: Asset) kind empirical {
    label en official "the housing credit agency allocates housing credit dollar amount to the building — the action bound by section 42(h)(7)(A)";
}
pub relation building_in_agency_jurisdiction_42(agency: Person, building: Asset) kind empirical {
    label en official "the building is located in the jurisdiction of the governmental unit of which the agency is a part (section 42(h)(7)(A)) — case-asserted";
}
@source(IRC_S42_H, quote = "A housing credit agency may allocate its aggregate housing credit dollar amount only to buildings located in the jurisdiction of the governmental unit of which such agency is a part.")
rule Section42H7AJurisdictionProhibitionRule(agency: Person, building: Asset) defeasible {
    when agency_allocates_to_building_42(agency, building);
    then prohibition Section42H7AJurisdictionProhibition {
        bearer agency;
        action agency_allocates_to_building_42(agency, building);
        window [@1986-10-22, infinity);
    };
    unless building_in_agency_jurisdiction_42(agency, building)
        and agency_allocates_to_building_42(agency, building);
}
pub relation agency_allocated_to_non_nonprofit_projects_42(agency: Person, year: Decimal) kind empirical {
    label en official "the agency allocates State housing credit ceiling to projects other than qualified low-income housing projects with a qualified nonprofit organization (section 42(h)(5)(A)) — the action bound by the 90 percent limit";
}
pub relation non_nonprofit_allocations_42(agency: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the amount of the State housing credit ceiling allocated to projects other than nonprofit-owned qualified projects — case-asserted";
}
pub relation state_ceiling_of_agency_42(agency: Person, year: Decimal, amount: Money) kind empirical {
    label en official "the State housing credit ceiling for the State of the agency for the calendar year — case-asserted";
}
pub relation non_nonprofit_share_within_ninety_percent_42(agency: Person, year: Decimal) kind institutional {
    label en official "section 42(h)(5)(A): not more than 90 percent of the State ceiling goes to projects other than nonprofit-owned qualified projects";
}
rule NonNonprofitShareWithinNinety42Rule(agency: Person, year: Decimal, amount: Money, ceiling: Money) strict {
    when non_nonprofit_allocations_42(agency, year, amount);
    when state_ceiling_of_agency_42(agency, year, ceiling);
    when amount <= 0.90 * ceiling;
    then non_nonprofit_share_within_ninety_percent_42(agency, year);
}
@source(IRC_S42_H, quote = "Not more than 90 percent of the State housing credit ceiling for any State for any calendar year shall be allocated to projects other than qualified low-income housing projects described in subparagraph (B).")
rule Section42H5NonprofitSetAsideProhibitionRule(agency: Person, year: Decimal) defeasible {
    when agency_allocated_to_non_nonprofit_projects_42(agency, year);
    then prohibition Section42H5NonprofitSetAsideProhibition {
        bearer agency;
        action agency_allocated_to_non_nonprofit_projects_42(agency, year);
        window [@1986-10-22, infinity);
    };
    unless non_nonprofit_share_within_ninety_percent_42(agency, year)
        and agency_allocated_to_non_nonprofit_projects_42(agency, year);
}

// --- (h)(6): the extended low-income housing commitment --------------------------------------------------------------------------------------------------------

pub relation extended_low_income_housing_commitment_in_effect_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "an extended low-income housing commitment (an agreement with the agency meeting section 42(h)(6)(B)(i)-(vi)) is in effect as of the end of the taxable year — case-asserted";
}
pub relation credit_allowed_by_commitment_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(h)(6)(A): the credit is allowed for the year only if an extended low-income housing commitment is in effect at its end";
}
@source(IRC_S42_H, quote = "No credit shall be allowed by reason of this section with respect to any building for the taxable year unless an extended low-income housing commitment is in effect as of the end of such taxable year.")
rule CreditAllowedByCommitment42Rule(building: Asset, y: TaxableYear) strict {
    when credit_period_year_42(building, y);
    when extended_low_income_housing_commitment_in_effect_42(building, y);
    then credit_allowed_by_commitment_42(building, y);
}
pub relation agreed_extended_use_end_42(building: Asset, on: Date) kind empirical {
    label en official "the date specified by the agency in the extended low-income housing commitment (section 42(h)(6)(D)(ii)(I)) — case-asserted";
}
pub relation extended_use_period_end_42(building: Asset, on: Date) kind institutional {
    label en official "section 42(h)(6)(D): the later of the agreed date and the date 15 years after the close of the compliance period";
}
@source(IRC_S42_H, quote = "the date which is 15 years after the close of the compliance period")
rule ExtendedUseEndLaterAgreedRule(building: Asset, first: Date, agreed: Date) strict {
    when first_credit_year_begin_42(building, first);
    when agreed_extended_use_end_42(building, agreed);
    when agreed >= add_calendar_period(first, 360 calendar_month);
    then extended_use_period_end_42(building, agreed);
}
rule ExtendedUseEndLaterStatutoryRule(building: Asset, first: Date, agreed: Date) strict {
    when first_credit_year_begin_42(building, first);
    when agreed_extended_use_end_42(building, agreed);
    when agreed < add_calendar_period(first, 360 calendar_month);
    then extended_use_period_end_42(building, add_calendar_period(first, 360 calendar_month));
}

// --- (i)(3): the low-income unit ---------------------------------------------------------------------------------------------------------------------------------------

pub relation unit_rent_restricted_42(unit: Asset) kind empirical {
    label en official "the unit is rent-restricted (section 42(g)(2)) — case-asserted";
}
pub relation unit_occupants_meet_income_limitation_42(unit: Asset) kind empirical {
    label en official "the individuals occupying the unit meet the income limitation applicable under section 42(g)(1) — case-asserted";
}
pub relation unit_suitable_and_not_transient_42(unit: Asset) kind empirical {
    label en official "the unit is suitable for occupancy and used other than on a transient basis (section 42(i)(3)(B)) — case-asserted";
}
pub relation unit_in_small_owner_occupied_building_42(unit: Asset) kind empirical {
    label en official "the building has 4 or fewer residential rental units and the units are owned by an individual who occupies a residential unit in it, or a related person (section 42(i)(3)(C)) — case-asserted";
}
pub relation low_income_unit_42(unit: Asset) kind institutional {
    label en official "section 42(i)(3): a rent-restricted unit occupied by individuals meeting the income limitation, suitable and not transient, not excluded as owner-occupied in a small building";
}
@source(IRC_S42_I, quote = "such unit is rent-restricted (as defined in subsection (g)(2))")
rule LowIncomeUnit42Rule(unit: Asset) strict {
    when unit_rent_restricted_42(unit);
    when unit_occupants_meet_income_limitation_42(unit);
    when unit_suitable_and_not_transient_42(unit);
    when not_known(small_owner_occupied_exclusion_applies_42(unit));
    then low_income_unit_42(unit);
}

// --- (j): recapture ----------------------------------------------------------------------------------------------------------------------------------------------------------

pub relation accelerated_portion_decrease_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate decrease in the credits allowed for all prior years if the accelerated portion of the credit were not allowed, on the excess of the prior-year qualified basis over the current one (section 42(j)(2)(A)) — case-asserted";
}
pub relation recapture_interest_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest at the overpayment rate on the section 42(j)(2)(A) amount for each prior taxable year (section 42(j)(2)(B)) — case-asserted";
}
pub relation casualty_loss_restored_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "the reduction of qualified basis is by a casualty loss restored by reconstruction or replacement within the period established by the Secretary (section 42(j)(4)(E)) — case-asserted";
}
pub relation disposition_with_continued_qualified_operation_expected_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "the building is disposed of and it is reasonably expected that it will continue to be operated as a qualified low-income building for the remaining compliance period (section 42(j)(6)(A)) — case-asserted";
}
pub relation qualified_basis_decrease_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(1): the amount by which the qualified basis at the close of the year is less than at the close of the preceding year";
}
@source(IRC_S42_J, quote = "the amount of the qualified basis of any building with respect to the taxpayer is less than")
rule QualifiedBasisDecrease42Rule(building: Asset, y: TaxableYear, previous: TaxableYear, now: Money, before: Money) strict {
    when compliance_period_year_42(building, y);
    when following_taxable_year_of(previous, y);
    when qualified_basis_at_close_42(building, y, now);
    when qualified_basis_at_close_42(building, previous, before);
    when now < before;
    then qualified_basis_decrease_42(building, y, before - now);
}
pub relation credit_recapture_amount_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(1)-(2): the tax for the year is increased by the accelerated-portion decrease plus interest, unless the (j)(4)(E) casualty or (j)(6)(A) disposition exception applies";
}
@source(IRC_S42_J, quote = "then the taxpayer's tax under this chapter for the taxable year shall be increased by the credit recapture amount")
rule CreditRecaptureAmount42Rule(taxpayer: Person, building: Asset, y: TaxableYear, decrease: Money, accelerated: Money, interest: Money) defeasible {
    when recapturable_qualified_basis_decrease_42(building, y, decrease);
    when accelerated_portion_decrease_42(taxpayer, building, y, accelerated);
    when recapture_interest_42(taxpayer, building, y, interest);
    when not_known(casualty_loss_restored_42(building, y));
    when not_known(disposition_with_continued_qualified_operation_expected_42(building, y));
    then credit_recapture_amount_42(taxpayer, building, y, accelerated + interest);
    // Stage 2e: the decrease is the section 42(j)(4)(B)-(C) recapturable decrease (42e module), and the
    // Secretary's section 42(j)(4)(F) de minimis relief (a power; the raw exercise fact is read, see 42e) defeats it.
    unless secretary_provides_de_minimis_relief_42(building, y)
        and de_minimis_relief_conditions_met_42(building, y)
        and accelerated_portion_decrease_42(taxpayer, building, y, accelerated)
        and recapture_interest_42(taxpayer, building, y, interest);
}

// --- (l): certifications and reports ----------------------------------------------------------------------------------------------------------------------------------------

pub relation first_credit_year_closed_on_42(taxpayer: Person, building: Asset, on: Date) kind empirical {
    label en official "the date the first taxable year in the credit period of the qualified low-income building closes — case-asserted";
}
pub relation taxpayer_certification_submitted_42(taxpayer: Person, building: Asset) kind empirical {
    label en official "the taxpayer certified to the Secretary the placed-in-service year, the adjusted and eligible basis, the maximum applicable percentage and qualified basis permitted by the agency, and the section 42(g) election (section 42(l)(1)) — case-asserted";
}
@source(IRC_S42_L, quote = "Following the close of the 1st taxable year in the credit period with respect to any qualified low-income building, the taxpayer shall certify to the Secretary")
rule Section42L1CertificationDutyRule(taxpayer: Person, building: Asset, closed: Date) strict {
    when first_credit_year_closed_on_42(taxpayer, building, closed);
    then duty Section42L1CertificationDuty {
        bearer taxpayer;
        goal achievement {
            condition taxpayer_certification_submitted_42(taxpayer, building);
            window [closed, infinity);
        }
    };
}
pub relation agency_allocated_in_year_42(agency: Person, year: Decimal) kind empirical {
    label en official "the agency allocates housing credit amounts to buildings for the calendar year (section 42(l)(3)) — case-asserted";
}
pub relation agency_annual_report_submitted_42(agency: Person, year: Decimal) kind empirical {
    label en official "the agency submitted the annual report of the allocations (section 42(l)(3)) — case-asserted";
}
@source(IRC_S42_L, quote = "Each agency which allocates any housing credit amount to any building for any calendar year shall submit to the Secretary")
rule Section42L3AgencyReportDutyRule(agency: Person, year: Decimal) strict {
    when agency_allocated_in_year_42(agency, year);
    then duty Section42L3AgencyReportDuty {
        bearer agency;
        goal achievement {
            condition agency_annual_report_submitted_42(agency, year);
            window [-infinity, infinity];
        }
    };
}

// --- (m)(1): the qualified allocation plan conditions ----------------------------------------------------------------------------------------------------------------------

pub relation allocation_under_approved_qualified_plan_42(building: Asset) kind empirical {
    label en official "the amount was allocated pursuant to a qualified allocation plan approved by the governmental unit (section 42(m)(1)(A)(i)) — case-asserted";
}
pub relation agency_notified_local_chief_executive_42(building: Asset) kind empirical {
    label en official "the agency notified the chief executive officer of the local jurisdiction of the project and gave the opportunity to comment (section 42(m)(1)(A)(ii)) — case-asserted";
}
pub relation comprehensive_market_study_conducted_42(building: Asset) kind empirical {
    label en official "a comprehensive market study of the housing needs of low-income individuals in the area was conducted before the allocation (section 42(m)(1)(A)(iii)) — case-asserted";
}
pub relation written_explanation_available_for_departures_42(building: Asset) kind empirical {
    label en official "a written explanation is available to the public for any allocation not made in accordance with the established priorities (section 42(m)(1)(A)(iv)) — case-asserted";
}
pub relation effective_housing_credit_dollar_amount_42(building: Asset, agency: Person, year: Decimal, amount: Money) kind institutional {
    label en official "section 42(m)(1)(A): the housing credit dollar amount is zero unless the four conditions hold";
}
@source(IRC_S42_M, quote = "the housing credit dollar amount with respect to any building shall be zero unless")
rule EffectiveHousingCreditDollarAmountMet42Rule(building: Asset, agency: Person, year: Decimal, allocated: Money) defeasible {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    when allocation_under_approved_qualified_plan_42(building);
    when agency_notified_local_chief_executive_42(building);
    when comprehensive_market_study_conducted_42(building);
    when written_explanation_available_for_departures_42(building);
    then effective_housing_credit_dollar_amount_42(building, agency, year, allocated);
}
relation qualified_plan_conditions_met_42(building: Asset) kind institutional;
rule QualifiedPlanConditionsMet42Rule(building: Asset) strict {
    when allocation_under_approved_qualified_plan_42(building);
    when agency_notified_local_chief_executive_42(building);
    when comprehensive_market_study_conducted_42(building);
    when written_explanation_available_for_departures_42(building);
    then qualified_plan_conditions_met_42(building);
}
rule EffectiveHousingCreditDollarAmountZero42Rule(building: Asset, agency: Person, year: Decimal, allocated: Money) defeasible {
    when housing_credit_dollar_amount_allocated_42(building, agency, year, allocated);
    when not_known(qualified_plan_conditions_met_42(building));
    then effective_housing_credit_dollar_amount_42(building, agency, year, 0 USD);
}
