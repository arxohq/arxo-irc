    then ej_capacity_expired_in_year_gw_48eh(year, sum(collect all mw: Decimal, f: Asset, d: Date where ej_capacity_limitation_allocated_mw_dc_48eh(f, mw) and ej_allocation_date_48eh(f, d) and d >= @2032-01-01 and d <= @2032-12-31 and not_known(ej_facility_placed_in_time_48eh(f)), empty: 0.0) * 0.001);
}
@source(IRC_S48E_H, quote = "Any amount of environmental justice capacity limitation which expires under clause (i) during any calendar year shall be taken into account as an excess described in subparagraph (D)(i) (or as an increase in such excess) for such calendar year, subject to the limitation imposed by the last sentence of such subparagraph.")
rule EjCapacityExpiredIn203748EH(year: Decimal) defeasible {
    label en official "capacity expiring in 2037: allocations dated in 2033, without a property placed in time (48E(h)(4)(E)(ii))";
    when ej_year_48eh(year);
    when year >= 2037.0;
    when year <= 2037.0;
    then ej_capacity_expired_in_year_gw_48eh(year, sum(collect all mw: Decimal, f: Asset, d: Date where ej_capacity_limitation_allocated_mw_dc_48eh(f, mw) and ej_allocation_date_48eh(f, d) and d >= @2033-01-01 and d <= @2033-12-31 and not_known(ej_facility_placed_in_time_48eh(f)), empty: 0.0) * 0.001);
}
