// Stage 4 (DECISION-0379 with deontics), credits, part E: the expiry of an environmental justice
// capacity limitation allocation as an excess of the carryover — sections 48(e)(4)(E)(ii) and
// 48E(h)(4)(E)(ii). Closes G6415.
//
// The allocation of a facility EXPIRES when no property of the facility is placed in service within
// 4 years after the allocation ((E)(i), modules 48-c-e and 45y-48e: `ej_increase_applies_to_property_*`
// is the placed-in-time property). The expired megawatts of a calendar year are the allocations made
// 4 calendar years earlier (the date plus 48 calendar months falls in that year) to facilities without
// a property placed in time; the sum is taken over the ASSERTED allocations (an aggregate over the
// asserted facts with the non-membership of the derived "in service in time" relation), for a
// bounded list of calendar years (stated below); the total is in gigawatts (megawatts x 0.001, exact).
// It is added to the excess carried from the preceding year; the limits of the last sentence of (D)
// (no carry to a year after 2024 for section 48; after the third calendar year following the
// applicable year for 48E) stay in the available-capacity rules, which now read the sum.
// JUDGMENT CALL: an allocation expires when NO property of its facility is placed in service within 4
// years (the statute speaks of property; the capacity belongs to the facility).
// BOUND (stated): expiry years 2023-2030 (section 48) and 2025-2040 (section 48E).

use self::{
    Asset,
    IRC_S48E_H,
    IRC_S48_E,
    ej_allocation_date_48,
    ej_allocation_date_48eh,
    ej_capacity_carried_from_prior_year_gw_48,
    ej_capacity_carried_gw_48eh,
    ej_capacity_limitation_allocated_mw_dc_48eh,
    ej_capacity_limitation_allocated_to_facility_mw_dc_48,
    ej_increase_applies_to_property_48,
    ej_increase_applies_to_property_48eh,
    ej_year_48,
    ej_year_48eh,
    property_part_of_facility_48,
    property_part_of_facility_48eh,
};

relation ej_facility_placed_in_time_48(facility: Asset) kind institutional {
    label en official "some property of the facility is placed in service within 4 years after the allocation (48(e)(4)(E)(i))";
}
rule EjFacilityPlacedInTime48(prop: Asset, facility: Asset) defeasible {
    label en official "a property of the facility placed in service in time keeps the allocation";
    when property_part_of_facility_48(prop, facility);
    when ej_increase_applies_to_property_48(prop);
    then ej_facility_placed_in_time_48(facility);
}
pub relation ej_capacity_expired_in_year_gw_48(year: Decimal, gw: Decimal) kind institutional {
    label en official "the environmental justice capacity limitation that expires in the calendar year, in gigawatts: allocations made 4 calendar years earlier to facilities without a property placed in service in time (48(e)(4)(E)(i))";
}
@source(IRC_S48_E, quote = "Any amount of environmental justice solar and wind capacity limitation which expires under clause (i) during any calendar year shall be taken into account as an excess described in subparagraph (D) (or as an increase in such excess) for such calendar year, subject to the limitation imposed by the last sentence of such subparagraph.")
rule EjCapacityExpiredIn202348(year: Decimal) defeasible {
    label en official "capacity expiring in 2023: allocations dated in 2019, without a property placed in time (48(e)(4)(E)(ii))";
    when ej_year_48(year);
    when year >= 2023.0;
    when year <= 2023.0;
    then ej_capacity_expired_in_year_gw_48(year, sum(collect all mw: Decimal, f: Asset, d: Date where ej_capacity_limitation_allocated_to_facility_mw_dc_48(f, mw) and ej_allocation_date_48(f, d) and d >= @2019-01-01 and d <= @2019-12-31 and not_known(ej_facility_placed_in_time_48(f)), empty: 0.0) * 0.001);
}
@source(IRC_S48_E, quote = "Any amount of environmental justice solar and wind capacity limitation which expires under clause (i) during any calendar year shall be taken into account as an excess described in subparagraph (D) (or as an increase in such excess) for such calendar year, subject to the limitation imposed by the last sentence of such subparagraph.")
rule EjCapacityExpiredIn202448(year: Decimal) defeasible {
    label en official "capacity expiring in 2024: allocations dated in 2020, without a property placed in time (48(e)(4)(E)(ii))";
    when ej_year_48(year);
    when year >= 2024.0;
    when year <= 2024.0;
    then ej_capacity_expired_in_year_gw_48(year, sum(collect all mw: Decimal, f: Asset, d: Date where ej_capacity_limitation_allocated_to_facility_mw_dc_48(f, mw) and ej_allocation_date_48(f, d) and d >= @2020-01-01 and d <= @2020-12-31 and not_known(ej_facility_placed_in_time_48(f)), empty: 0.0) * 0.001);
}
@source(IRC_S48_E, quote = "Any amount of environmental justice solar and wind capacity limitation which expires under clause (i) during any calendar year shall be taken into account as an excess described in subparagraph (D) (or as an increase in such excess) for such calendar year, subject to the limitation imposed by the last sentence of such subparagraph.")
