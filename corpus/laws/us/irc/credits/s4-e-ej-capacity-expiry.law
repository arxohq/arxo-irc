pub relation ej_capacity_excess_including_expiry_48(year: Decimal, gw: Decimal) kind institutional {
    label en official "the excess carried to the calendar year: the asserted excess of the preceding year plus the capacity that expires in the year (48(e)(4)(D), (E)(ii))";
}
relation ej_capacity_excess_present_48(year: Decimal) kind institutional {
    label en official "bridge: an excess (asserted or from an expiry) exists for the year";
}
rule EjCapacityExcessPresent48(year: Decimal, gw: Decimal) defeasible {
    label en official "bridge for the absence test";
    when ej_capacity_excess_including_expiry_48(year, gw);
    then ej_capacity_excess_present_48(year);
}
relation ej_capacity_asserted_carry_present_48(year: Decimal) kind institutional {
    label en official "bridge: an excess carried from the preceding year is asserted";
}
rule EjCapacityAssertedCarryPresent48(year: Decimal, gw: Decimal) defeasible {
    label en official "bridge for the absence test";
    when ej_capacity_carried_from_prior_year_gw_48(year, gw);
    then ej_capacity_asserted_carry_present_48(year);
}
relation ej_capacity_expiry_present_48(year: Decimal) kind institutional {
    label en official "bridge: a positive expired amount exists for the year";
}
rule EjCapacityExpiryPresent48(year: Decimal, gw: Decimal) defeasible {
    label en official "bridge for the absence test";
    when ej_capacity_expired_in_year_gw_48(year, gw);
    when gw > 0.0;
    then ej_capacity_expiry_present_48(year);
}
rule EjCapacityExcessAssertedAndExpired48(year: Decimal, carried: Decimal, expired: Decimal) defeasible {
    label en official "asserted excess + expired capacity (48(e)(4)(D), (E)(ii))";
    when ej_capacity_carried_from_prior_year_gw_48(year, carried);
    when ej_capacity_expired_in_year_gw_48(year, expired);
    then ej_capacity_excess_including_expiry_48(year, carried + expired);
}
rule EjCapacityExcessAssertedOnly48(year: Decimal, carried: Decimal) defeasible {
    label en official "no expiry in the year: the asserted excess";
    when ej_capacity_carried_from_prior_year_gw_48(year, carried);
    when not_known(ej_capacity_expiry_present_48(year));
    then ej_capacity_excess_including_expiry_48(year, carried);
}
rule EjCapacityExcessExpiredOnly48(year: Decimal, expired: Decimal) defeasible {
    label en official "no asserted excess: the expired capacity alone";
    when ej_capacity_expired_in_year_gw_48(year, expired);
    when expired > 0.0;
    when not_known(ej_capacity_asserted_carry_present_48(year));
    then ej_capacity_excess_including_expiry_48(year, expired);
}
relation ej_facility_placed_in_time_48eh(facility: Asset) kind institutional {
    label en official "some property of the facility is placed in service within 4 years after the allocation (48E(h)(4)(E)(i))";
}
rule EjFacilityPlacedInTime48EH(prop: Asset, facility: Asset) defeasible {
    label en official "a property of the facility placed in service in time keeps the allocation";
    when property_part_of_facility_48eh(prop, facility);
    when ej_increase_applies_to_property_48eh(prop);
    then ej_facility_placed_in_time_48eh(facility);
}
pub relation ej_capacity_expired_in_year_gw_48eh(year: Decimal, gw: Decimal) kind institutional {
    label en official "the environmental justice capacity limitation that expires in the calendar year, in gigawatts: allocations made 4 calendar years earlier to facilities without a property placed in service in time (48E(h)(4)(E)(i))";
}
@source(IRC_S48E_H, quote = "Any amount of environmental justice capacity limitation which expires under clause (i) during any calendar year shall be taken into account as an excess described in subparagraph (D)(i) (or as an increase in such excess) for such calendar year, subject to the limitation imposed by the last sentence of such subparagraph.")
rule EjCapacityExpiredIn202548EH(year: Decimal) defeasible {
    label en official "capacity expiring in 2025: allocations dated in 2021, without a property placed in time (48E(h)(4)(E)(ii))";
    when ej_year_48eh(year);
    when year >= 2025.0;
    when year <= 2025.0;
    then ej_capacity_expired_in_year_gw_48eh(year, sum(collect all mw: Decimal, f: Asset, d: Date where ej_capacity_limitation_allocated_mw_dc_48eh(f, mw) and ej_allocation_date_48eh(f, d) and d >= @2021-01-01 and d <= @2021-12-31 and not_known(ej_facility_placed_in_time_48eh(f)), empty: 0.0) * 0.001);
}
