}
pub relation ej_capacity_excess_including_expiry_48eh(year: Decimal, gw: Decimal) kind institutional {
    label en official "the excess carried to the calendar year: the asserted excess of the preceding year plus the capacity that expires in the year (48E(h)(4)(D), (E)(ii))";
}
relation ej_capacity_excess_present_48eh(year: Decimal) kind institutional {
    label en official "bridge: an excess (asserted or from an expiry) exists for the year";
}
rule EjCapacityExcessPresent48EH(year: Decimal, gw: Decimal) defeasible {
    label en official "bridge for the absence test";
    when ej_capacity_excess_including_expiry_48eh(year, gw);
    then ej_capacity_excess_present_48eh(year);
}
relation ej_capacity_asserted_carry_present_48eh(year: Decimal) kind institutional {
    label en official "bridge: an excess carried from the preceding year is asserted";
}
rule EjCapacityAssertedCarryPresent48EH(year: Decimal, gw: Decimal) defeasible {
    label en official "bridge for the absence test";
    when ej_capacity_carried_gw_48eh(year, gw);
    then ej_capacity_asserted_carry_present_48eh(year);
}
relation ej_capacity_expiry_present_48eh(year: Decimal) kind institutional {
    label en official "bridge: a positive expired amount exists for the year";
}
rule EjCapacityExpiryPresent48EH(year: Decimal, gw: Decimal) defeasible {
    label en official "bridge for the absence test";
    when ej_capacity_expired_in_year_gw_48eh(year, gw);
    when gw > 0.0;
    then ej_capacity_expiry_present_48eh(year);
}
rule EjCapacityExcessAssertedAndExpired48EH(year: Decimal, carried: Decimal, expired: Decimal) defeasible {
    label en official "asserted excess + expired capacity (48E(h)(4)(D), (E)(ii))";
    when ej_capacity_carried_gw_48eh(year, carried);
    when ej_capacity_expired_in_year_gw_48eh(year, expired);
    then ej_capacity_excess_including_expiry_48eh(year, carried + expired);
}
rule EjCapacityExcessAssertedOnly48EH(year: Decimal, carried: Decimal) defeasible {
    label en official "no expiry in the year: the asserted excess";
    when ej_capacity_carried_gw_48eh(year, carried);
    when not_known(ej_capacity_expiry_present_48eh(year));
    then ej_capacity_excess_including_expiry_48eh(year, carried);
}
rule EjCapacityExcessExpiredOnly48EH(year: Decimal, expired: Decimal) defeasible {
    label en official "no asserted excess: the expired capacity alone";
    when ej_capacity_expired_in_year_gw_48eh(year, expired);
    when expired > 0.0;
    when not_known(ej_capacity_asserted_carry_present_48eh(year));
    then ej_capacity_excess_including_expiry_48eh(year, expired);
}
