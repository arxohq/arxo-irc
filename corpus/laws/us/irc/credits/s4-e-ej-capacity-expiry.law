    then ej_capacity_expired_in_year_gw_48eh(year, sum(collect all mw: Decimal, f: Asset, d: Date where ej_capacity_limitation_allocated_mw_dc_48eh(f, mw) and ej_allocation_date_48eh(f, d) and d >= @2034-01-01 and d <= @2034-12-31 and not_known(ej_facility_placed_in_time_48eh(f)), empty: 0.0) * 0.001);
}
