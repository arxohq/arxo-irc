    label en official "capacity expiring in 2025: allocations dated in 2021, without a property placed in time (48(e)(4)(E)(ii))";
    when ej_year_48(year);
    when year >= 2025.0;
    when year <= 2025.0;
    then ej_capacity_expired_in_year_gw_48(year, sum(collect all mw: Decimal, f: Asset, d: Date where ej_capacity_limitation_allocated_to_facility_mw_dc_48(f, mw) and ej_allocation_date_48(f, d) and d >= @2021-01-01 and d <= @2021-12-31 and not_known(ej_facility_placed_in_time_48(f)), empty: 0.0) * 0.001);
}
