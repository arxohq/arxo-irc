// Section 38 — General business credit. Stage 2 (IRC-06 stage 2,
// DECISION-0379). Priority list item: §38(a)-(c).
//
// Judgment calls:
// * §38(b)'s 41-item component list is modelled as ONE enum
//   (`GeneralBusinessCreditComponent`) plus ONE dependency-contract relation
//   `general_business_credit_component_amount`, mirroring the §26(b)(2)
//   "one relation, many owner-package producers" idiom this package already
//   uses for the carve-outs of section 26(b)(2). This pass WIRES FOUR
//   components directly to their own modules in this same package —
//   `work_opportunity_credit` (§51, component 2), `rehabilitation_credit`
//   (§47, folded into component 1's investment credit), `research_credit`
//   (§41, component 4) and `low_income_housing_credit` (§42, component 5) —
//   via small bridging rules below; the other 37 components remain
//   dependency-contract facts a case must assert directly (most are owned
//   by sections this stage's budget did not reach; several, like the
//   railroad-track-maintenance or biodiesel credits, are wholly outside
//   this package's own priority list).
// * §38(c)'s "net income tax"/"net regular tax liability" definitions read
//   `regular_tax_liability`/`tentative_minimum_tax` from
//   `26-limitation-on-credits.law` (already `pub`, already dependency
//   contracts on the AMT package) and introduce ONE new dependency contract,
//   `credits_allowable_under_subparts_a_and_b`, for "the credits allowable
//   under subparts A and B of this part" (subpart A: sections 21-30D;
//   subpart B: sections 31-35) — a sum this package does not itself fully
//   resolve (TECH_GAP: the aggregate ordering problem `credits-totals.law`
//   already flags for subpart A alone is a STRICT SUBSET of what §38(c)(1)
//   needs).
// * §38(c)(2) (empowerment zone 25-percent-of-TMT offset) and (c)(4)
//   (specified-credit treatment of TMT-as-zero) are NOT modelled this pass
//   as separate limitation branches — TECH_GAP, noted; only the general
//   (c)(1) limitation is executable.
// * §38(c)(5) (eligible small business), (c)(6) (special dollar-amount
//   rules for married/controlled-group/estate-trust taxpayers) are NOT
//   modelled — TECH_GAP.
// * §38(d) (ordering: credits are used in the order listed in (b), as of
//   the close of the taxable year in which used) is modelled as a total
//   order over `GeneralBusinessCreditComponent`'s enum declaration order
//   via an explicit `component_ordinal` lookup table, rather than derived
//   from the enum's own declaration order (the language does not expose
//   enum ordinals as terms) — used only for documentation/consumer
//   convenience; no rule in this package actually needs the ordering to
//   compute the sum in (a), since summation is order-independent.

use self::{
    IRC_S38_A,
    IRC_S38_B,
    IRC_S38_C,
    Individual,
    Person,
    TaxableYear,
    investment_credit,
    low_income_housing_credit,
    regular_tax_liability,
    research_credit,
    section_55a_tax_26a,
    tentative_minimum_tax_26c,
    work_opportunity_credit,
};

pub enum GeneralBusinessCreditComponent {
    InvestmentCredit46,
    WorkOpportunityCredit51,
    AlcoholFuelsCredit40,
    ResearchCredit41,
    LowIncomeHousingCredit42,
    EnhancedOilRecoveryCredit43,
    DisabledAccessCredit44,
    RenewableElectricityProductionCredit45,
    EmpowermentZoneEmploymentCredit1396,
    IndianEmploymentCredit45A,
    EmployerSocialSecurityCredit45B,
    OrphanDrugCredit45C,
    NewMarketsTaxCredit45D,
    SmallEmployerPensionStartupCredit45E,
    EmployerProvidedChildCareCredit45F,
    RailroadTrackMaintenanceCredit45G,
    BiodieselFuelsCredit40A,
    LowSulfurDieselCredit45H,
    MarginalOilAndGasWellCredit45I,
    DistilledSpiritsCredit5011,
    AdvancedNuclearPowerCredit45J,
    NonconventionalSourceProductionCredit45K,
    NewEnergyEfficientHomeCredit45L,
    AlternativeMotorVehicleCredit30B,
    AlternativeFuelVehicleRefuelingCredit30C,
    MineRescueTeamTrainingCredit45N,
    AgriculturalChemicalsSecurityCredit45O,
    DifferentialWagePaymentCredit45P,
    CarbonOxideSequestrationCredit45Q,
    NewCleanVehicleCredit30D,
    SmallEmployerHealthInsuranceCredit45R,
    PaidFamilyMedicalLeaveCredit45S,
    RetirementAutoEnrollmentCredit45T,
    ZeroEmissionNuclearPowerCredit45U,
    SustainableAviationFuelCredit40B,
    CleanHydrogenProductionCredit45V,
    QualifiedCommercialCleanVehicleCredit45W,
    AdvancedManufacturingProductionCredit45X,
    CleanElectricityProductionCredit45Y,
    CleanFuelProductionCredit45Z,
    MilitarySpouseRetirementPlanCredit45AA,
}

@source(IRC_S38_B, quote = "the amount of the current year business credit is the sum of the following credits determined for the taxable year")
pub relation general_business_credit_component_amount(taxpayer: Person, y: TaxableYear, component: GeneralBusinessCreditComponent, amount: Money) kind institutional {
    label en official "the amount of one of the 41 section 38(b) component credits for the taxable year — dependency contract; several components are wired to this package's own section 41/42/47/51 modules below, the rest are case-asserted pending their owner section's own formalization";
}

// Bridges from this package's own component modules into the generic
// contract above (avoids re-deriving arithmetic the component's own module
// already computes; §38(b)(1)'s "investment credit determined under section
// 46" folds in the section 47 rehabilitation credit computed above, since
// this package has not yet formalized section 46's OTHER components).
rule GeneralBusinessCreditComponentInvestment defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when investment_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, InvestmentCredit46, amount);
}
rule GeneralBusinessCreditComponentWotc defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when work_opportunity_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, WorkOpportunityCredit51, amount);
}
rule GeneralBusinessCreditComponentResearch defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when research_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, ResearchCredit41, amount);
}
rule GeneralBusinessCreditComponentLihtc defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when low_income_housing_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, LowIncomeHousingCredit42, amount);
}

// --- §38(b): current year business credit -----------------------------------------

pub relation current_year_business_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the current year business credit (section 38(b)): the sum of the section 38(b)(1)-(41) component credits determined for the taxable year";
}
@source(IRC_S38_B, quote = "the amount of the current year business credit is the sum of the following credits determined for the taxable year")
rule CurrentYearBusinessCredit defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for one_component: GeneralBusinessCreditComponent;
    for one_amount: Money;
    when general_business_credit_component_amount(taxpayer, y, one_component, one_amount);
    then current_year_business_credit(taxpayer, y,
        sum all amount: Money for component: GeneralBusinessCreditComponent where general_business_credit_component_amount(taxpayer, y, component, amount));
}

// --- §38(a): allowance of credit -----------------------------------------------------

pub relation business_credit_carryforward_to_year(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the business credit carryforwards carried to this taxable year (section 38(a)(1)) — case-asserted input; section 39's own computed carryforward (`business_credit_carryforward_computed_to_year`) is exposed separately rather than auto-chained into this input, to avoid an unstratifiable same-predicate cycle across taxable years (TECH_GAP: a scenario spanning the unused-credit year and the year the carryforward reaches must assert this input consistently with 39's computed output itself)";
}
pub relation business_credit_carryback_to_year(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the business credit carrybacks carried to this taxable year (section 38(a)(3)) — case-asserted input, same TECH_GAP as the carryforward input above";
}
relation has_business_credit_carryforward(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasBusinessCreditCarryforward defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when business_credit_carryforward_to_year(taxpayer, y, amount);
    then has_business_credit_carryforward(taxpayer, y);
}
relation business_credit_carryforward_to_year_or_zero(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional;
rule BusinessCreditCarryforwardPresent defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when business_credit_carryforward_to_year(taxpayer, y, amount);
    then business_credit_carryforward_to_year_or_zero(taxpayer, y, amount);
}
rule BusinessCreditCarryforwardAbsent defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when current_year_business_credit(taxpayer, y, amount);
    when not_known(has_business_credit_carryforward(taxpayer, y));
    then business_credit_carryforward_to_year_or_zero(taxpayer, y, 0 USD);
}
relation has_business_credit_carryback(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasBusinessCreditCarryback defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when business_credit_carryback_to_year(taxpayer, y, amount);
    then has_business_credit_carryback(taxpayer, y);
}
relation business_credit_carryback_to_year_or_zero(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional;
rule BusinessCreditCarrybackPresent defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when business_credit_carryback_to_year(taxpayer, y, amount);
    then business_credit_carryback_to_year_or_zero(taxpayer, y, amount);
}
rule BusinessCreditCarrybackAbsent defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when current_year_business_credit(taxpayer, y, amount);
    when not_known(has_business_credit_carryback(taxpayer, y));
    then business_credit_carryback_to_year_or_zero(taxpayer, y, 0 USD);
}

pub relation general_business_credit_before_limitation(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 38(a) sum before the section 38(c) limitation: carryforwards plus current-year credit plus carrybacks";
}
@source(IRC_S38_A, quote = "There shall be allowed as a credit against the tax imposed by this chapter for the taxable year an amount equal to the sum of—\n(1) the business credit carryforwards carried to such taxable year,\n(2) the amount of the current year business credit, plus\n(3) the business credit carrybacks carried to such taxable year.")
rule GeneralBusinessCreditBeforeLimitation defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for carryforward: Money;
    for current: Money;
    for carryback: Money;
    when business_credit_carryforward_to_year_or_zero(taxpayer, y, carryforward);
    when current_year_business_credit(taxpayer, y, current);
    when business_credit_carryback_to_year_or_zero(taxpayer, y, carryback);
    then general_business_credit_before_limitation(taxpayer, y, carryforward + current + carryback);
}

// --- §38(c)(1): limitation based on amount of tax ----------------------------------

pub relation credits_allowable_under_subparts_a_and_b(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the credits allowable under subparts A (sections 21-30D) and B (sections 31-35) of this part, for the section 38(c)(1) net-income-tax/net-regular-tax-liability definitions — dependency contract on this package's own subpart A/B totals (credits-totals.law's nonrefundable_credits_total does not yet include subpart B; TECH_GAP on the full joint aggregate)";
}

pub relation net_income_tax(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net income tax for section 38(c)(1): the sum of the regular tax liability and the section 55 tax, reduced by the credits allowable under subparts A and B of this part";
}
@source(IRC_S38_C, quote = "the term \"net income tax\" means the sum of the regular tax liability and the tax imposed by section 55, reduced by the credits allowable under subparts A and B of this part")
rule NetIncomeTax strict {
    for taxpayer: Individual;
    for y: TaxableYear;
    for regular: Money;
    for amt: Money;
    for subpart_ab: Money;
    when regular_tax_liability(taxpayer, y, regular);
    when section_55a_tax_26a(taxpayer, y, amt);
    when credits_allowable_under_subparts_a_and_b(taxpayer, y, subpart_ab);
    then net_income_tax(taxpayer, y, max(0 USD, (regular + amt) - subpart_ab));
}

pub relation net_regular_tax_liability(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net regular tax liability for section 38(c)(1): the regular tax liability reduced by the credits allowable under subparts A and B of this part";
}
@source(IRC_S38_C, quote = "the term \"net regular tax liability\" means the regular tax liability reduced by the sum of the credits allowable under subparts A and B of this part")
rule NetRegularTaxLiability strict {
    for taxpayer: Individual;
    for y: TaxableYear;
    for regular: Money;
    for subpart_ab: Money;
    when regular_tax_liability(taxpayer, y, regular);
    when credits_allowable_under_subparts_a_and_b(taxpayer, y, subpart_ab);
    then net_regular_tax_liability(taxpayer, y, max(0 USD, regular - subpart_ab));
}

pub relation general_business_credit_limitation(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 38(c)(1) limitation: net income tax minus the greater of tentative minimum tax or 25 percent of net regular tax liability in excess of $25,000 (general, non-corporate/non-married-separate/non-controlled-group rule; the section 38(c)(2)/(4)/(6) special rules are TECH_GAP, not modelled this pass)";
}
@source(IRC_S38_C, quote = "The credit allowed under subsection (a) for any taxable year shall not exceed the excess (if any) of the taxpayer's net income tax over the greater of—\n(A) the tentative minimum tax for the taxable year, or\n(B) 25 percent of so much of the taxpayer's net regular tax liability as exceeds $25,000.")
rule GeneralBusinessCreditLimitation strict {
    for taxpayer: Individual;
    for y: TaxableYear;
    for net_income: Money;
    for tmt: Money;
    for net_regular: Money;
    when net_income_tax(taxpayer, y, net_income);
    when tentative_minimum_tax_26c(taxpayer, y, tmt);
    when net_regular_tax_liability(taxpayer, y, net_regular);
    then general_business_credit_limitation(taxpayer, y, max(0 USD, net_income - max(tmt, round(0.25 * max(0 USD, net_regular - 25000.00 USD), 2, "HALF_UP"))));
}

pub relation general_business_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 38 general business credit allowed for the taxable year: the lesser of the section 38(a) sum or the section 38(c)(1) limitation";
}
@source(IRC_S38_C, quote = "The credit allowed under subsection (a) for any taxable year shall not exceed the excess (if any) of the taxpayer's net income tax over the greater of")
rule GeneralBusinessCredit defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for before: Money;
    for limitation: Money;
    when general_business_credit_before_limitation(taxpayer, y, before);
    when general_business_credit_limitation(taxpayer, y, limitation);
    then general_business_credit(taxpayer, y, min(before, limitation));
}
