// Stage 3 (TECH_GAP reduction): section 24(g)(1)(B) and (g)(2) derive the disallowance from the
// final determinations instead of a case-asserted period flag. The credit rules of
// 24-child-tax-credit.law read `disallowed_by_final_determination_24g` next to the older
// `in_disallowance_period_24g` (a case fact kept for a period established outside the record).
// STATUS: implemented_unverified (static check only).
//
// APPROXIMATIONS. The "taxable years" of the periods are counted as calendar years from the start
// of the year of the determination (exact for calendar-year taxpayers; a fiscal-year taxpayer's
// tenth year may differ by up to one year). The statute measures the period from the MOST RECENT
// year with a determination; here every year with a determination generates its own period, and
// the periods are joined. The final determination itself is a case fact (EXTERNAL_DEPENDENCY on
// the court or Service determination).

use self::{
    IRC_S24_G,
    Individual,
    TaxableYear,
};

pub relation fraud_final_determination_year_24g(taxpayer: Individual, determined_year: TaxableYear) kind empirical {
    label en official "section 24(g)(1)(B)(i): there was a final determination that the taxpayer's claim of credit under section 24 for the year was due to fraud — case-asserted";
}
pub relation reckless_final_determination_year_24g(taxpayer: Individual, determined_year: TaxableYear) kind empirical {
    label en official "section 24(g)(1)(B)(ii): there was a final determination that the taxpayer's claim of credit for the year was due to reckless or intentional disregard of rules and regulations, but not due to fraud — case-asserted";
}
pub relation deficiency_denial_year_24g(taxpayer: Individual, denied_year: TaxableYear) kind empirical {
    label en official "section 24(g)(2): the taxpayer was denied credit under section 24 for the year as a result of the deficiency procedures under subchapter B of chapter 63 — case-asserted";
}
pub relation eligibility_information_provided_24g(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "section 24(g)(2): the taxpayer provides such information as the Secretary may require to demonstrate eligibility for the credit for the year — case-asserted";
}
pub relation disallowed_by_final_determination_24g(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 24(g): no credit is allowed for the year: it falls in the disallowance period after a final determination, or follows a denial by the deficiency procedures without the required information";
}
@source(IRC_S24_G, relation = formalizes, coverage = exact, quote = "the period of 10 taxable years after the most recent taxable year")
rule DisallowancePeriodAfterFraud24gRule(taxpayer: Individual, y: TaxableYear, y0: TaxableYear, d0: Date, d1: Date) strict {
    label en official "section 24(g)(1)(B)(i): the 10 taxable years after the year of the final determination of fraud";
    when fraud_final_determination_year_24g(taxpayer, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d1);
    when d1 > d0;
    when d1 <= add_calendar_period(d0, 10 calendar_year);
    then disallowed_by_final_determination_24g(taxpayer, y);
}
@source(IRC_S24_G, relation = formalizes, coverage = exact, quote = "the period of 2 taxable years after the most recent taxable year")
rule DisallowancePeriodAfterReckless24gRule(taxpayer: Individual, y: TaxableYear, y0: TaxableYear, d0: Date, d1: Date) strict {
    label en official "section 24(g)(1)(B)(ii): the 2 taxable years after the year of the final determination of reckless or intentional disregard";
    when reckless_final_determination_year_24g(taxpayer, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d1);
    when d1 > d0;
    when d1 <= add_calendar_period(d0, 2 calendar_year);
    then disallowed_by_final_determination_24g(taxpayer, y);
}
@source(IRC_S24_G, relation = formalizes, coverage = exact, quote = "no credit shall be allowed under this section for any subsequent taxable year unless the taxpayer provides such information as the Secretary may require to demonstrate eligibility for such credit.")
rule DisallowanceAfterDeficiencyDenial24g2Rule(taxpayer: Individual, y: TaxableYear, y0: TaxableYear, d0: Date, d1: Date) strict {
    label en official "section 24(g)(2): after a denial by the deficiency procedures, no credit for a later year unless the eligibility information is provided";
    when deficiency_denial_year_24g(taxpayer, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d1);
    when d1 > d0;
    when not_known(eligibility_information_provided_24g(taxpayer, y));
    then disallowed_by_final_determination_24g(taxpayer, y);
}
