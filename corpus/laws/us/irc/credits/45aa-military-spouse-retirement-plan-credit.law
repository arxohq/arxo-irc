// Section 45AA — Military spouse retirement plan eligibility credit. Stage 2d
// (IRC-06, DECISION-0379).
//
// Scope / judgment calls:
// * (a): for an eligible small employer, $200 per military spouse who
//   participates in an eligible defined contribution plan at any time during
//   the year, plus the employer contributions (not elective deferrals) for the
//   spouse up to $300.
// * (b): a military spouse counts only for the taxable year containing the
//   date of first participation and the 2 succeeding taxable years; the
//   succeeding years are read from the years' beginning dates: a year that
//   begins after the participation date and no later than 24 months after it
//   (12-month years).
// * (c)-(f): eligible small employer, military spouse, HCE exclusion, plan
//   terms and single-employer aggregation are case facts (TECH-GAPS G1541).

use self::{
    IRC_S45AA_A,
    IRC_S45AA_B,
    Individual,
    Person,
    TaxableYear,
    eligible_plan_45aa,
    military_spouse_45aa,
};

pub relation eligible_small_employer_45aa(employer: Person, y: TaxableYear) kind empirical {
    label en official "the employer is an eligible small employer: an eligible employer as defined in section 408(p)(2)(C)(i)(I) (section 45AA(c)) — case-asserted";
}
pub relation military_spouse_of_employer_45aa(employee: Individual, employer: Person) kind empirical {
    label en official "the employee is married to a member of the uniformed services serving on active duty, per section 45AA(d)(1), and is not a highly compensated employee (section 45AA(d)(2)) — case-asserted";
}
pub relation eligible_defined_contribution_plan_terms_met_45aa(employer: Person, y: TaxableYear) kind empirical {
    label en official "the employer's defined contribution plan meets the section 45AA(e) terms: military spouses eligible within 2 months, immediate eligibility for the employer contribution amount after 2 years of service of a similarly situated participant, and immediate nonforfeitable right to employer-contribution benefits — case-asserted";
}
pub relation began_participating_on_45aa(employee: Individual, employer: Person, on: Date) kind empirical {
    label en official "the date the military spouse began participating in the eligible defined contribution plan — case-asserted";
}
pub relation participates_in_plan_during_year_45aa(employee: Individual, employer: Person, y: TaxableYear) kind empirical {
    label en official "the military spouse participates in the eligible defined contribution plan at any time during the taxable year — case-asserted";
}
pub relation employer_contributions_other_than_elective_deferrals_45aa(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the employer contributions for the employee to all such plans during the year, other than elective deferrals under section 402(g)(3) — case-asserted";
}

pub relation within_three_year_window_45aa(employee: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45AA(b): the taxable year contains the first participation date or is one of the 2 succeeding taxable years";
}
@source(IRC_S45AA_B, quote = "for the taxable year which includes the date on which such individual began participating in the eligible defined contribution plan of the employer and the 2 succeeding taxable years")
rule WithinThreeYearWindow45aaRule(employee: Individual, employer: Person, y: TaxableYear, started: Date, begin: Date) strict {
    when began_participating_on_45aa(employee, employer, started);
    when us.irc.core::begins(y, begin);
    when begin > started;
    when begin <= add_calendar_period(started, 24 calendar_month);
    then within_three_year_window_45aa(employee, employer, y);
}
@source(IRC_S45AA_B, quote = "for the taxable year which includes the date on which such individual began participating in the eligible defined contribution plan of the employer and the 2 succeeding taxable years")
rule WithinThreeYearWindowFirstYear45aaRule(employee: Individual, employer: Person, y: TaxableYear, started: Date, begin: Date, finish: Date) strict {
    when began_participating_on_45aa(employee, employer, started);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when begin <= started;
    when started <= finish;
    then within_three_year_window_45aa(employee, employer, y);
}

pub relation military_spouse_credit_per_employee_45aa(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45AA(a): $200 plus the employer contributions up to $300 for the military spouse";
}
@source(IRC_S45AA_A, quote = "so much of the contributions made by such employer (other than an elective deferral (as defined in section 402(g)(3)) [1] to all such plans with respect to such employee during such taxable year as do not exceed $300")
rule MilitarySpouseCreditPerEmployee45aaRule(employer: Person, employee: Individual, y: TaxableYear, contributions: Money) defeasible {
    when eligible_small_employer_45aa(employer, y);
    when military_spouse_45aa(employee, employer);
    when eligible_plan_45aa(employer, y);
    when participates_in_plan_during_year_45aa(employee, employer, y);
    when within_three_year_window_45aa(employee, employer, y);
    when employer_contributions_other_than_elective_deferrals_45aa(employer, employee, y, contributions);
    then military_spouse_credit_per_employee_45aa(employer, employee, y, 200.00 USD + min(contributions, 300.00 USD));
}
relation has_contributions_45aa(employer: Person, employee: Individual, y: TaxableYear) kind institutional;
rule HasContributions45aaRule(employer: Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    when employer_contributions_other_than_elective_deferrals_45aa(employer, employee, y, amount);
    then has_contributions_45aa(employer, employee, y);
}
@source(IRC_S45AA_A, quote = "$200 with respect to each military spouse who is an employee of such employer and who participates in an eligible defined contribution plan of such employer at any time during such taxable year")
rule MilitarySpouseCreditNoContributions45aaRule(employer: Person, employee: Individual, y: TaxableYear) defeasible {
    when eligible_small_employer_45aa(employer, y);
    when military_spouse_45aa(employee, employer);
    when eligible_plan_45aa(employer, y);
    when participates_in_plan_during_year_45aa(employee, employer, y);
    when within_three_year_window_45aa(employee, employer, y);
    when not_known(has_contributions_45aa(employer, employee, y));
    then military_spouse_credit_per_employee_45aa(employer, employee, y, 200.00 USD);
}
pub relation military_spouse_retirement_plan_eligibility_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45AA military spouse retirement plan eligibility credit for the taxable year (a section 38(b)(41) component)";
}
rule MilitarySpouseRetirementPlanEligibilityCredit45aaRule(employer: Person, y: TaxableYear, employee: Individual, amount: Money) defeasible {
    when military_spouse_credit_per_employee_45aa(employer, employee, y, amount);
    then military_spouse_retirement_plan_eligibility_credit(employer, y,
        sum(collect all a: Money, e: Individual where military_spouse_credit_per_employee_45aa(employer, e, y, a), empty: 0 USD));
}
