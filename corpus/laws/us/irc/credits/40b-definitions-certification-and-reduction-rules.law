// Section 40B — the sustainable aviation fuel technical requirements of (d)(1)(A)-(C), the applicable material of (d)(2)(A), the producer
// certification of (f)(2) and the reduction for other benefits of (g). Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2d
// rows of TECH-GAPS G1783). Companion of `40b-sustainable-aviation-fuel-credit.law`; its credit rules read the ASTM and feedstock facts as one
// case fact and are NOT rewired to require these relations. The credit is terminated for fuel sold or used after 2024 (section 40B(h)) in the
// credit module.
//
// Judgment calls: the coprocessing test of (d)(1)(B) reads asserted facts about the feedstock; the certification by an unrelated party and
// the CORSIA requirements are case facts; the reduction of (g) reads the asserted benefit under section 6426 or 6427(e) and the existing
// credit per mixture (cents HALF_UP).

use self::{
    ApplicableMaterialKind45Z,
    Asset,
    IRC_S40B_D,
    IRC_S40B_F,
    IRC_S40B_G,
    Person,
    SafMethodology45Z,
    TaxableYear,
    sustainable_aviation_fuel_credit_per_mixture_40b,
};

pub enum MaterialKind40B { Glycerides, FreeFattyAcids, FattyAcidEsters, OtherMaterial }
pub enum SafMethodology40B { Corsia, OtherMethodology }

// --- (d)(2)(A): applicable material ------------------------------------------------------------------------------------------------------------------------

pub relation material_kind_40b(material: Asset, kind: MaterialKind40B) kind empirical {
    label en official "the kind of the material (section 40B(d)(2)(A)) — case-asserted";
}
pub relation applicable_material_40b(material: Asset) kind institutional {
    label en official "section 40B(d)(2)(A): monoglycerides, diglycerides and triglycerides, free fatty acids, and fatty acid esters";
}
@source(IRC_S40B_D, relation = formalizes, coverage = exact, quote = "monoglycerides, diglycerides, and triglycerides")
rule ApplicableMaterialGlycerides40bRule(material: Asset) strict {
    when material_kind_40b(material, Glycerides);
    then applicable_material_40b(material);
}
@source(IRC_S40B_D, relation = formalizes, coverage = exact, quote = "free fatty acids")
rule ApplicableMaterialFreeFattyAcids40bRule(material: Asset) strict {
    when material_kind_40b(material, FreeFattyAcids);
    then applicable_material_40b(material);
}
@source(IRC_S40B_D, relation = formalizes, coverage = exact, quote = "fatty acid esters")
rule ApplicableMaterialEsters40bRule(material: Asset) strict {
    when material_kind_40b(material, FattyAcidEsters);
    then applicable_material_40b(material);
}

// --- (d)(1)(A)-(C): the technical requirements -------------------------------------------------------------------------------------------------------------

pub relation meets_astm_d7566_40b(fuel: Asset) kind empirical {
    label en official "the fuel meets the requirements of ASTM International Standard D7566 (section 40B(d)(1)(A)(i)) — case-asserted";
}
pub relation meets_fischer_tropsch_d1655_annex_a1_40b(fuel: Asset) kind empirical {
    label en official "the fuel meets the Fischer Tropsch provisions of ASTM International Standard D1655, Annex A1 (section 40B(d)(1)(A)(ii)) — case-asserted";
}
pub relation fuel_derived_by_coprocessing_applicable_material_with_non_biomass_40b(fuel: Asset) kind empirical {
    label en official "the fuel is derived from coprocessing an applicable material (or materials derived from an applicable material) with a feedstock which is not biomass (section 40B(d)(1)(B)) — case-asserted";
}
pub relation fuel_derived_from_palm_fatty_acid_distillates_40b(fuel: Asset) kind empirical {
    label en official "the fuel is derived from palm fatty acid distillates (section 40B(d)(1)(C)) — case-asserted";
}
pub relation fuel_derived_from_petroleum_40b(fuel: Asset) kind empirical {
    label en official "the fuel is derived from petroleum (section 40B(d)(1)(C)) — case-asserted";
}
pub relation liquid_fuel_portion_not_kerosene_40b(fuel: Asset) kind empirical {
    label en official "the fuel is liquid fuel, the portion of which is not kerosene (section 40B(d)(1)) — case-asserted";
}
pub relation technical_requirements_met_40b(fuel: Asset) kind institutional {
    label en official "section 40B(d)(1)(A)-(C): liquid fuel meeting ASTM D7566 or the Fischer Tropsch provisions of ASTM D1655 Annex A1, not derived from coprocessing an applicable material with a non-biomass feedstock, and not derived from palm fatty acid distillates or petroleum";
}
@source(IRC_S40B_D, relation = formalizes, coverage = exact, quote = "is not derived from coprocessing an applicable material (or materials derived from an applicable material) with a feedstock which is not biomass")
rule TechnicalRequirementsMetD7566Rule(fuel: Asset) strict {
    when liquid_fuel_portion_not_kerosene_40b(fuel);
    when meets_astm_d7566_40b(fuel);
    when not_known(fuel_derived_by_coprocessing_applicable_material_with_non_biomass_40b(fuel));
    when not_known(fuel_derived_from_palm_fatty_acid_distillates_40b(fuel));
    when not_known(fuel_derived_from_petroleum_40b(fuel));
    then technical_requirements_met_40b(fuel);
}
rule TechnicalRequirementsMetFischerTropschRule(fuel: Asset) strict {
    when liquid_fuel_portion_not_kerosene_40b(fuel);
    when meets_fischer_tropsch_d1655_annex_a1_40b(fuel);
    when not_known(fuel_derived_by_coprocessing_applicable_material_with_non_biomass_40b(fuel));
    when not_known(fuel_derived_from_palm_fatty_acid_distillates_40b(fuel));
    when not_known(fuel_derived_from_petroleum_40b(fuel));
    then technical_requirements_met_40b(fuel);
}

// --- (f)(2): the certification ---------------------------------------------------------------------------------------------------------------------------

pub relation certification_from_unrelated_party_40b(fuel: Asset) kind empirical {
    label en official "a certification, in such form and manner as the Secretary prescribes, from an unrelated party (section 40B(f)(2)(A)) — case-asserted";
}
pub relation saf_methodology_40b(fuel: Asset, methodology: SafMethodology40B) kind empirical {
    label en official "the methodology of subsection (e): the Carbon Offsetting and Reduction Scheme for International Aviation (paragraph (1)) or another methodology (paragraph (2)) — case-asserted";
}
pub relation complies_with_corsia_requirements_40b(fuel: Asset) kind empirical {
    label en official "the certification demonstrates compliance with any general requirements, supply chain traceability requirements, and information transmission requirements established under the Carbon Offsetting and Reduction Scheme for International Aviation (section 40B(f)(2)(A)(i)) — case-asserted";
}
pub relation complies_with_similar_requirements_40b(fuel: Asset) kind empirical {
    label en official "for a methodology established under paragraph (2) of subsection (e), the certification demonstrates compliance with requirements similar to those of clause (i) (section 40B(f)(2)(A)(ii)) — case-asserted";
}
pub relation other_information_required_by_secretary_provided_40b(fuel: Asset) kind empirical {
    label en official "such other information with respect to the fuel as the Secretary may require has been provided (section 40B(f)(2)(B)) — case-asserted";
}
pub relation producer_certification_provided_40b(fuel: Asset) kind institutional {
    label en official "section 40B(f)(2): the producer or importer provides a certification from an unrelated party demonstrating compliance with the CORSIA requirements (or similar requirements for another methodology) and such other information as the Secretary requires";
}
@source(IRC_S40B_F, relation = formalizes, coverage = exact, quote = "certification (in such form and manner as the Secretary shall prescribe) from an unrelated party demonstrating compliance with")
rule ProducerCertificationProvidedCorsiaRule(fuel: Asset) strict {
    when certification_from_unrelated_party_40b(fuel);
    when saf_methodology_40b(fuel, Corsia);
    when complies_with_corsia_requirements_40b(fuel);
    when other_information_required_by_secretary_provided_40b(fuel);
    then producer_certification_provided_40b(fuel);
}
rule ProducerCertificationProvidedOtherMethodologyRule(fuel: Asset) strict {
    when certification_from_unrelated_party_40b(fuel);
    when saf_methodology_40b(fuel, OtherMethodology);
    when complies_with_similar_requirements_40b(fuel);
    when other_information_required_by_secretary_provided_40b(fuel);
    then producer_certification_provided_40b(fuel);
}

// --- (g): the reduction for other benefits ---------------------------------------------------------------------------------------------------------------------

pub relation other_benefit_for_mixture_40b(mixture: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "any benefit provided with respect to the sustainable aviation fuel solely by reason of section 6426 or 6427(e) — case-asserted";
}
pub relation sustainable_aviation_fuel_credit_after_other_benefit_40b(taxpayer: Person, mixture: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40B(g): the credit with respect to the fuel is properly reduced by the benefit under section 6426 or 6427(e) (not below zero)";
}
@source(IRC_S40B_G, relation = formalizes, coverage = partial, quote = "be properly reduced to take into account any benefit provided with respect to such sustainable aviation fuel solely by reason of the application of section 6426 or 6427(e)")
rule SustainableAviationFuelCreditAfterOtherBenefitRule(taxpayer: Person, mixture: Asset, y: TaxableYear, credit: Money, benefit: Money) defeasible {
    when sustainable_aviation_fuel_credit_per_mixture_40b(taxpayer, mixture, y, credit);
    when other_benefit_for_mixture_40b(mixture, y, benefit);
    then sustainable_aviation_fuel_credit_after_other_benefit_40b(taxpayer, mixture, y, max(credit - benefit, 0 USD));
}
