// Section 40A — the biodiesel, agri-biodiesel and renewable diesel definitions, the (c) reduction for other benefits, the (d)(3) taxes on
// separation, mixing and non-fuel use, the (d)(5) foreign production exclusion, the (e) small producer, aggregation, pass-through and
// cooperative rules. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of
// `40a-biodiesel-fuels-credit.law`; its credit rules read the gallons as case facts and are NOT rewired to require these relations.
//
// Judgment calls: cents amounts HALF_UP at 2 places; the rates of the (d)(3)(A)-(B) taxes are the $1.00 per gallon of (b)(1)(A) and
// (b)(2)(A); the "including" list of virgin oils in (d)(2) is illustrative and is folded into one case fact; the approval of an
// equivalent standard for renewable diesel is an external judgment of the Secretary (DECISION-0194).

// --- (d)(1)-(2): biodiesel and agri-biodiesel ----------------------------------------------------------------------------------------------------------

use self::{
    Asset,
    ControlledGroup,
    IRC_S40A_C,
    IRC_S40A_D,
    IRC_S40A_E,
    IRC_S40A_F,
    Person,
    TaxableYear,
    biodiesel_fuels_credit,
    under_common_control_52b,
};

pub relation monoalkyl_esters_from_plant_or_animal_matter_40a(fuel: Asset) kind empirical {
    label en official "the fuel is monoalkyl esters of long chain fatty acids derived from plant or animal matter (section 40A(d)(1)) — case-asserted";
}
pub relation meets_epa_registration_40a(fuel: Asset) kind empirical {
    label en official "the fuel meets the registration requirements for fuels and fuel additives established by the EPA under section 211 of the Clean Air Act (sections 40A(d)(1)(A), (f)(3)(A)) — case-asserted";
}
pub relation meets_astm_d6751_40a(fuel: Asset) kind empirical {
    label en official "the fuel meets the requirements of ASTM D6751 (section 40A(d)(1)(B)) — case-asserted";
}
pub relation credit_determinable_under_section_40_or_40b_40a(fuel: Asset) kind empirical {
    label en official "a credit may be determined with respect to the liquid under section 40 or 40B (section 40A(d)(1), last sentence) — case-asserted";
}
pub relation biodiesel_defined_40a(fuel: Asset) kind institutional {
    label en official "section 40A(d)(1): the monoalkyl esters of long chain fatty acids derived from plant or animal matter that meet the EPA registration requirements and ASTM D6751, and are not a liquid for which a credit may be determined under section 40 or 40B";
}
@source(IRC_S40A_D, relation = formalizes, coverage = exact, quote = "The term \"biodiesel\" means the monoalkyl esters of long chain fatty acids derived from plant or animal matter which meet")
rule BiodieselDefined40aRule(fuel: Asset) strict {
    when monoalkyl_esters_from_plant_or_animal_matter_40a(fuel);
    when meets_epa_registration_40a(fuel);
    when meets_astm_d6751_40a(fuel);
    when not_known(credit_determinable_under_section_40_or_40b_40a(fuel));
    then biodiesel_defined_40a(fuel);
}
pub relation derived_solely_from_virgin_oils_or_animal_fats_40a(fuel: Asset) kind empirical {
    label en official "the biodiesel is derived solely from virgin oils, including esters derived from virgin vegetable oils from corn, soybeans, sunflower seeds, cottonseeds, canola, crambe, rapeseeds, safflowers, flaxseeds, rice bran, mustard seeds, and camelina, and from animal fats (section 40A(d)(2)) — case-asserted";
}
pub relation agri_biodiesel_defined_40a(fuel: Asset) kind institutional {
    label en official "section 40A(d)(2): biodiesel derived solely from virgin oils (including listed virgin vegetable oils) and from animal fats";
}
@source(IRC_S40A_D, relation = formalizes, coverage = exact, quote = "The term \"agri-biodiesel\" means biodiesel derived solely from virgin oils")
rule AgriBiodieselDefined40aRule(fuel: Asset) strict {
    when biodiesel_defined_40a(fuel);
    when derived_solely_from_virgin_oils_or_animal_fats_40a(fuel);
    then agri_biodiesel_defined_40a(fuel);
}
pub relation produced_outside_us_for_use_outside_us_40a(fuel: Asset) kind empirical {
    label en official "the biodiesel is produced outside the United States (including its possessions) for use as a fuel outside the United States (section 40A(d)(5)) — case-asserted";
}
pub relation credit_permitted_for_fuel_40a(fuel: Asset) kind institutional {
    label en official "section 40A(d)(5): no credit for biodiesel produced outside the United States or its possessions for use as a fuel outside them";
}
@source(IRC_S40A_D, relation = formalizes, coverage = exact, quote = "No credit shall be determined under this section with respect to any biodiesel which is produced outside the United States for use as a fuel outside the United States.")
rule CreditPermittedForFuel40aRule(fuel: Asset) strict {
    when biodiesel_defined_40a(fuel);
    when not_known(produced_outside_us_for_use_outside_us_40a(fuel));
    then credit_permitted_for_fuel_40a(fuel);
}

// --- (f): renewable diesel ------------------------------------------------------------------------------------------------------------------------------------------

pub relation liquid_fuel_derived_from_biomass_40a(fuel: Asset) kind empirical {
    label en official "the liquid fuel is derived from biomass, as defined by section 45K(c)(3) (section 40A(f)(3)) — case-asserted";
}
pub relation meets_astm_d975_or_d396_40a(fuel: Asset) kind empirical {
    label en official "the fuel meets the requirements of ASTM D975 or D396 (section 40A(f)(3)(B)) — case-asserted";
}
external judgment relation secretary_approves_equivalent_standard_40a(fuel: Asset) {
    authority Secretary;
    label en official "the fuel meets another equivalent standard approved by the Secretary (section 40A(f)(3)(B))";
}
pub relation coprocessed_with_non_biomass_feedstock_40a(fuel: Asset) kind empirical {
    label en official "the fuel is derived from coprocessing biomass with a feedstock which is not biomass (section 40A(f)(3), last sentences) — case-asserted";
}
pub relation renewable_diesel_defined_40a(fuel: Asset) kind institutional {
    label en official "section 40A(f)(3): liquid fuel derived from biomass meeting the EPA registration requirements and ASTM D975 or D396 (or an equivalent standard approved by the Secretary), not a liquid with a section 40 credit and not derived from coprocessing with a non-biomass feedstock";
}
@source(IRC_S40A_F, relation = formalizes, coverage = exact, quote = "The term \"renewable diesel\" means liquid fuel derived from biomass which meets")
rule RenewableDieselDefinedAstm40aRule(fuel: Asset) strict {
    when liquid_fuel_derived_from_biomass_40a(fuel);
    when meets_epa_registration_40a(fuel);
    when meets_astm_d975_or_d396_40a(fuel);
    when not_known(credit_determinable_under_section_40_or_40b_40a(fuel));
    when not_known(coprocessed_with_non_biomass_feedstock_40a(fuel));
    then renewable_diesel_defined_40a(fuel);
}
rule RenewableDieselDefinedApproved40aRule(fuel: Asset) defeasible {
    when liquid_fuel_derived_from_biomass_40a(fuel);
    when meets_epa_registration_40a(fuel);
    when secretary_approves_equivalent_standard_40a(fuel);
    when not_known(credit_determinable_under_section_40_or_40b_40a(fuel));
    when not_known(coprocessed_with_non_biomass_feedstock_40a(fuel));
    then renewable_diesel_defined_40a(fuel);
}
pub relation treated_as_biodiesel_40a(fuel: Asset) kind institutional {
    label en official "section 40A(f)(1): renewable diesel is treated in the same manner as biodiesel";
}
@source(IRC_S40A_F, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), renewable diesel shall be treated in the same manner as biodiesel.")
rule TreatedAsBiodieselOrdinary40aRule(fuel: Asset) strict {
    when biodiesel_defined_40a(fuel);
    then treated_as_biodiesel_40a(fuel);
}
rule TreatedAsBiodieselRenewable40aRule(fuel: Asset) defeasible {
    when renewable_diesel_defined_40a(fuel);
    then treated_as_biodiesel_40a(fuel);
}
pub relation small_producer_credit_applies_to_fuel_40a(fuel: Asset) kind institutional {
    label en official "section 40A(f)(2): the small agri-biodiesel producer credit of (b)(4) does not apply to renewable diesel";
}
@source(IRC_S40A_F, relation = formalizes, coverage = exact, quote = "Subsection (b)(4) shall not apply with respect to renewable diesel.")
rule SmallProducerCreditAppliesToFuel40aRule(fuel: Asset) defeasible {
    when agri_biodiesel_defined_40a(fuel);
    when not_known(renewable_diesel_defined_40a(fuel));
    then small_producer_credit_applies_to_fuel_40a(fuel);
}

// --- (c): the reduction for other benefits ----------------------------------------------------------------------------------------------------------------

pub relation other_benefit_for_biodiesel_40a(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any benefit provided with respect to the biodiesel solely by reason of section 6426 or 6427(e) — case-asserted";
}
pub relation biodiesel_fuels_credit_after_other_benefit_40a(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40A(c): the biodiesel credit is properly reduced by the benefit under section 6426 or 6427(e) (not below zero)";
}
@source(IRC_S40A_C, relation = formalizes, coverage = partial, quote = "shall be properly reduced to take into account any benefit provided with respect to such biodiesel solely by reason of the application of section 6426 or 6427(e)")
rule BiodieselFuelsCreditAfterOtherBenefit40aRule(taxpayer: Person, y: TaxableYear, credit: Money, benefit: Money) defeasible {
    when biodiesel_fuels_credit(taxpayer, y, credit);
    when other_benefit_for_biodiesel_40a(taxpayer, y, benefit);
    then biodiesel_fuels_credit_after_other_benefit_40a(taxpayer, y, max(credit - benefit, 0 USD));
}

// --- (d)(3): the taxes -----------------------------------------------------------------------------------------------------------------------------------------------

pub relation credit_determined_for_mixture_biodiesel_40a(batch: Asset) kind empirical {
    label en official "a credit was determined with respect to the biodiesel used in the production of a qualified biodiesel mixture (section 40A(d)(3)(A)(i)) — case-asserted";
}
pub relation biodiesel_separated_from_mixture_or_mixture_misused_40a(person: Person, batch: Asset, gallons: Decimal) kind empirical {
    label en official "the person separates the biodiesel from the mixture, or without separation uses the mixture other than as a fuel (section 40A(d)(3)(A)(ii)) — case-asserted";
}
pub relation mixture_separation_tax_40a(person: Person, batch: Asset, amount: Money) kind institutional {
    label en official "section 40A(d)(3)(A): a tax equal to the (b)(1)(A) rate ($1.00) times the gallons of biodiesel in the mixture";
}
@source(IRC_S40A_D, relation = formalizes, coverage = exact, quote = "then there is hereby imposed on such person a tax equal to the product of the rate applicable under subsection (b)(1)(A) and the number of gallons of such biodiesel in such mixture.")
rule MixtureSeparationTax40aRule(person: Person, batch: Asset, gallons: Decimal) strict {
    when credit_determined_for_mixture_biodiesel_40a(batch);
    when biodiesel_separated_from_mixture_or_mixture_misused_40a(person, batch, gallons);
    then mixture_separation_tax_40a(person, batch, round(1.00 * gallons, 2, "HALF_UP") * 1 USD);
}
pub relation credit_determined_for_retail_sale_biodiesel_40a(batch: Asset) kind empirical {
    label en official "a credit was determined with respect to the retail sale of the biodiesel (section 40A(d)(3)(B)(i)) — case-asserted";
}
pub relation biodiesel_mixed_or_used_other_than_as_fuel_40a(person: Person, batch: Asset, gallons: Decimal) kind empirical {
    label en official "the person mixes the biodiesel or uses it other than as a fuel (section 40A(d)(3)(B)(ii)) — case-asserted";
}
pub relation retail_biodiesel_tax_40a(person: Person, batch: Asset, amount: Money) kind institutional {
    label en official "section 40A(d)(3)(B): a tax equal to the (b)(2)(A) rate ($1.00) times the gallons of biodiesel";
}
@source(IRC_S40A_D, relation = formalizes, coverage = exact, quote = "then there is hereby imposed on such person a tax equal to the product of the rate applicable under subsection (b)(2)(A) and the number of gallons of such biodiesel.")
rule RetailBiodieselTax40aRule(person: Person, batch: Asset, gallons: Decimal) strict {
    when credit_determined_for_retail_sale_biodiesel_40a(batch);
    when biodiesel_mixed_or_used_other_than_as_fuel_40a(person, batch, gallons);
    then retail_biodiesel_tax_40a(person, batch, round(1.00 * gallons, 2, "HALF_UP") * 1 USD);
}
pub relation small_producer_credit_determined_for_batch_40a(batch: Asset) kind empirical {
    label en official "a credit was determined under subsection (a)(3) for the agri-biodiesel — case-asserted";
}
pub relation person_uses_for_b4b_purpose_40a(person: Person, batch: Asset) kind empirical {
    label en official "the person uses the fuel for a purpose described in subsection (b)(4)(B) — case-asserted";
}
pub relation person_holds_agri_biodiesel_40a(person: Person, batch: Asset, gallons: Decimal) kind empirical {
    label en official "the person holds the gallons of small producer agri-biodiesel — case-asserted";
}
pub relation agri_biodiesel_misuse_tax_40a(person: Person, batch: Asset, amount: Money) kind institutional {
    label en official "section 40A(d)(3)(C): a tax of 10 cents a gallon on agri-biodiesel not used as described in (b)(4)(B) where an (a)(3) credit was determined";
}
@source(IRC_S40A_D, relation = formalizes, coverage = exact, quote = "then there is hereby imposed on such person a tax equal to 10 cents a gallon for each gallon of such agri-biodiesel.")
rule AgriBiodieselMisuseTax40aRule(person: Person, batch: Asset, gallons: Decimal) strict {
    when small_producer_credit_determined_for_batch_40a(batch);
    when person_holds_agri_biodiesel_40a(person, batch, gallons);
    when not_known(person_uses_for_b4b_purpose_40a(person, batch));
    then agri_biodiesel_misuse_tax_40a(person, batch, round(0.10 * gallons, 2, "HALF_UP") * 1 USD);
}

// --- (e)(1)-(3): small producer, aggregation, pass-through ---------------------------------------------------------------------------------------------

pub relation agri_biodiesel_productive_capacity_gallons_40a(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "the productive capacity of the person for agri-biodiesel at all times during the taxable year, in gallons (section 40A(e)(1)) — case-asserted";
}
pub relation agri_biodiesel_production_gallons_40a(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "the qualified agri-biodiesel production of the person in the taxable year, in gallons — case-asserted";
}
pub relation eligible_small_agri_biodiesel_producer_by_capacity_40a(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 40A(e)(1): a person whose productive capacity for agri-biodiesel at all times during the year is not in excess of 60,000,000 gallons";
}
@source(IRC_S40A_E, relation = formalizes, coverage = exact, quote = "has a productive capacity for agri-biodiesel not in excess of 60,000,000 gallons")
rule EligibleSmallAgriBiodieselProducerByCapacity40aRule(taxpayer: Person, y: TaxableYear, capacity: Decimal) strict {
    when agri_biodiesel_productive_capacity_gallons_40a(taxpayer, y, capacity);
    when capacity <= 60000000.0;
    then eligible_small_agri_biodiesel_producer_by_capacity_40a(taxpayer, y);
}
pub relation controlled_group_agri_production_gallons_40a(group: ControlledGroup, y: TaxableYear, gallons: Decimal) kind institutional {
    label en official "section 40A(e)(2): all members of the same controlled group (section 267(f)) and all persons under common control (section 52(b), more than 50 percent) are one person: the qualified agri-biodiesel production of the group";
}
@source(IRC_S40A_E, relation = formalizes, coverage = exact, quote = "shall be treated as 1 person")
rule ControlledGroupAgriProduction40aRule(group: ControlledGroup, y: TaxableYear, member: Person, own: Decimal) strict {
    when under_common_control_52b(group, member, y);
    when agri_biodiesel_production_gallons_40a(member, y, own);
    then controlled_group_agri_production_gallons_40a(group, y,
        sum(collect all g: Decimal, p: Person where agri_biodiesel_production_gallons_40a(p, y, g), empty: 0.0));
}
pub relation controlled_group_agri_capacity_gallons_40a(group: ControlledGroup, y: TaxableYear, gallons: Decimal) kind institutional {
    label en official "section 40A(e)(2): the productive capacity of the one-person group for the 60,000,000 gallon limitation";
}
rule ControlledGroupAgriCapacity40aRule(group: ControlledGroup, y: TaxableYear, member: Person, own: Decimal) strict {
    when under_common_control_52b(group, member, y);
    when agri_biodiesel_productive_capacity_gallons_40a(member, y, own);
    then controlled_group_agri_capacity_gallons_40a(group, y,
        sum(collect all g: Decimal, p: Person where agri_biodiesel_productive_capacity_gallons_40a(p, y, g), empty: 0.0));
}
pub relation group_exceeds_gallon_limitation_40a(group: ControlledGroup, y: TaxableYear) kind institutional {
    label en official "section 40A(e)(1)-(2), (b)(4)(C): the group as one person has capacity over 60,000,000 gallons or production over 15,000,000 gallons";
}
rule GroupExceedsCapacityLimitation40aRule(group: ControlledGroup, y: TaxableYear, capacity: Decimal) strict {
    when controlled_group_agri_capacity_gallons_40a(group, y, capacity);
    when capacity > 60000000.0;
    then group_exceeds_gallon_limitation_40a(group, y);
}
rule GroupExceedsProductionLimitation40aRule(group: ControlledGroup, y: TaxableYear, production: Decimal) strict {
    when controlled_group_agri_production_gallons_40a(group, y, production);
    when production > 15000000.0;
    then group_exceeds_gallon_limitation_40a(group, y);
}
pub relation allocated_agri_production_gallons_40a(pt_entity: Person, partner: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "the gallons of the pass-through entity's qualified agri-biodiesel production allocated to the partner, shareholder or beneficiary — case-asserted";
}
relation partner_has_own_agri_production_40a(partner: Person, y: TaxableYear) kind institutional;
rule PartnerHasOwnAgriProduction40aRule(partner: Person, y: TaxableYear, own: Decimal) strict {
    when agri_biodiesel_production_gallons_40a(partner, y, own);
    then partner_has_own_agri_production_40a(partner, y);
}
pub relation agri_production_at_partner_level_40a(partner: Person, y: TaxableYear, gallons: Decimal) kind institutional {
    label en official "section 40A(e)(3): the limitations apply at the partner or similar level: the partner's own production plus the production allocated to the partner from entities";
}
@source(IRC_S40A_E, relation = formalizes, coverage = exact, quote = "the limitations contained in subsection (b)(4)(C) and paragraph (1) shall be applied at the entity level and at the partner or similar level")
rule AgriProductionAtPartnerLevelOwn40aRule(partner: Person, y: TaxableYear, own: Decimal) strict {
    when agri_biodiesel_production_gallons_40a(partner, y, own);
    then agri_production_at_partner_level_40a(partner, y,
        own + sum(collect all g: Decimal, e: Person where allocated_agri_production_gallons_40a(e, partner, y, g), empty: 0.0));
}
rule AgriProductionAtPartnerLevelOnlyAllocated40aRule(partner: Person, y: TaxableYear, pt_entity: Person, allocated: Decimal) strict {
    when allocated_agri_production_gallons_40a(pt_entity, partner, y, allocated);
    when not_known(partner_has_own_agri_production_40a(partner, y));
    then agri_production_at_partner_level_40a(partner, y,
        sum(collect all g: Decimal, e: Person where allocated_agri_production_gallons_40a(e, partner, y, g), empty: 0.0));
}
pub relation partner_level_limit_exceeded_40a(partner: Person, y: TaxableYear) kind institutional {
    label en official "section 40A(e)(3), (b)(4)(C): the production at the partner level is over 15,000,000 gallons";
}
rule PartnerLevelLimitExceeded40aRule(partner: Person, y: TaxableYear, gallons: Decimal) strict {
    when agri_production_at_partner_level_40a(partner, y, gallons);
    when gallons > 15000000.0;
    then partner_level_limit_exceeded_40a(partner, y);
}

// --- (e)(6): the cooperative apportionment -----------------------------------------------------------------------------------------------------------------

pub relation cooperative_described_in_1381a_40a(coop: Person) kind empirical {
    label en official "the organization is a cooperative organization described in section 1381(a) — case-asserted";
}
pub relation elects_apportionment_to_patrons_40a(coop: Person, y: TaxableYear) kind empirical {
    label en official "the cooperative's exercise of the section 40A(e)(6)(A)(i) election to apportion the (a)(3) credit pro rata among patrons";
}
pub relation timely_return_and_written_notice_40a(coop: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely filed return and the apportionment is designated in a written notice mailed to patrons during the payment period of section 1382(d) (section 40A(e)(6)(A)(ii)) — case-asserted";
}
pub relation apportionment_to_patrons_effective_40a(coop: Person, y: TaxableYear) kind institutional {
    label en official "section 40A(e)(6)(A): the apportionment among patrons takes effect";
}
@source(IRC_S40A_E, relation = formalizes, coverage = exact, quote = "any portion of the credit determined under subsection (a)(3) for the taxable year may, at the election of the organization, be apportioned pro rata")
rule Section40aE6ElectionRule(coop: Person, y: TaxableYear) defeasible {
    when elects_apportionment_to_patrons_40a(coop, y);
    when cooperative_described_in_1381a_40a(coop);
    when timely_return_and_written_notice_40a(coop, y);
    then power Section40aE6ApportionmentElection {
        holder coop;
        over coop;
        exercise elects_apportionment_to_patrons_40a(coop, y);
        valid_when timely_return_and_written_notice_40a(coop, y);
        effect create(apportionment_to_patrons_effective_40a(coop, y));
        window [-infinity, infinity);
    };
}
pub relation cooperative_credit_apportioned_40a(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the credit that the cooperative apportions among its patrons — case-asserted";
}
pub relation business_done_by_patron_40a(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the quantity or value of business done with or for the patron during the taxable year — case-asserted";
}
pub relation total_business_done_40a(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total business done with or for patrons during the taxable year — case-asserted";
}
pub relation credit_apportioned_to_patron_40a(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40A(e)(6)(A), (B)(ii): the apportioned credit goes to each patron pro rata by business done, included in the patron's credit for its first taxable year ending on or after the end of the payment period (or the notice date, if earlier)";
}
rule CreditApportionedToPatron40aRule(coop: Person, patron: Person, y: TaxableYear, apportioned: Money, done: Money, total: Money) strict {
    when apportionment_to_patrons_effective_40a(coop, y);
    when cooperative_credit_apportioned_40a(coop, y, apportioned);
    when business_done_by_patron_40a(coop, patron, y, done);
    when total_business_done_40a(coop, y, total);
    when total > 0 USD;
    then credit_apportioned_to_patron_40a(coop, patron, y, div_round(apportioned * (done / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation cooperative_credit_determined_40a(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit of the cooperative determined under subsection (a)(3) for the year — case-asserted";
}
pub relation cooperative_credit_shown_on_return_40a(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit shown on the cooperative's return for the year — case-asserted";
}
pub relation cooperative_credit_not_apportioned_40a(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount not apportioned to patrons for the year — case-asserted";
}
pub relation cooperative_unapportioned_credit_included_40a(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40A(e)(6)(B)(i): the credit not apportioned to patrons is included in the cooperative's credit for the year";
}
@source(IRC_S40A_E, relation = formalizes, coverage = exact, quote = "The amount of the credit not apportioned to patrons pursuant to subparagraph (A) shall be included in the amount determined under subsection (a)(3) for the taxable year of the organization.")
rule CooperativeUnapportionedCreditIncluded40aRule(coop: Person, y: TaxableYear, amount: Money) strict {
    when cooperative_credit_not_apportioned_40a(coop, y, amount);
    then cooperative_unapportioned_credit_included_40a(coop, y, amount);
}
pub relation cooperative_tax_increase_40a(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40A(e)(6)(B)(iii): if the credit determined is less than the credit shown on the return, the excess of the reduction over the amount not apportioned is an increase in tax";
}
@source(IRC_S40A_E, relation = formalizes, coverage = exact, quote = "shall be treated as an increase in tax imposed by this chapter on the organization.")
rule CooperativeTaxIncrease40aRule(coop: Person, y: TaxableYear, determined: Money, shown: Money, unapportioned: Money) strict {
    when cooperative_credit_determined_40a(coop, y, determined);
    when cooperative_credit_shown_on_return_40a(coop, y, shown);
    when cooperative_credit_not_apportioned_40a(coop, y, unapportioned);
    when shown - determined > unapportioned;
    then cooperative_tax_increase_40a(coop, y, shown - determined - unapportioned);
}
