// Section 45S — the (b) limits (hourly wage cap, 12 weeks), the (c) eligible employer (written policy, added employers, single taxpayer,
// state and local leave, no penalty), the (d) qualifying employee, the (e) family and medical leave, the (f) determination by the Secretary
// and the (g) wages. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of
// `45s-paid-family-medical-leave-credit.law`; its credit rules read the eligible employer and qualifying employee statuses as case facts
// and are NOT rewired to require these relations. The repeal for taxable years beginning after 2025 stays with the credit module.
//
// Judgment calls: the leave purposes of section 102(a)(1)(A)-(E) and (3) of the Family and Medical Leave Act are an enum fact of the leave;
// the part-time ratio of (c)(1)(A)(ii) compares the leave amount asserted for part-time employees with the full-time amount times the hours
// ratio; the 60-percent compensation test reads the asserted section 414(q)(1)(B)(i) amount for the year; the proration of wages of an
// employee not paid hourly (b)(2) stays external.

use self::{
    Asset,
    IRC_S45S_B,
    IRC_S45S_C,
    IRC_S45S_D,
    IRC_S45S_E,
    IRC_S45S_G,
    Individual,
    Person,
    TaxableYear,
    paid_family_medical_leave_credit_per_employee,
};

pub enum LeavePurpose45S {
    BirthOfChild,
    AdoptionOrFosterPlacement,
    CareOfFamilyMemberWithSeriousHealthCondition,
    OwnSeriousHealthCondition,
    QualifyingExigencyOfMilitaryFamilyMember,
    MilitaryCaregiverLeave,
    VacationLeave,
    PersonalLeave,
    MedicalOrSickLeave,
    OtherPurpose
}

// --- (b)(1), (b)(3): the hourly wage cap and the 12 weeks ---------------------------------------------------------------------------------------------

pub relation normal_hourly_wage_rate_45s(employee: Individual, y: TaxableYear, rate: Money) kind empirical {
    label en official "the normal hourly wage rate of the employee for each hour of actual services performed for the employer (section 45S(b)(1)) — case-asserted";
}
pub relation hours_of_family_and_medical_leave_taken_45s(employee: Individual, y: TaxableYear, hours: Decimal) kind empirical {
    label en official "the number of hours (or fraction thereof) for which family and medical leave is taken (section 45S(b)(1)) — case-asserted";
}
pub relation hourly_wage_cap_45s(employee: Individual, y: TaxableYear, cap: Money) kind institutional {
    label en official "section 45S(b)(1): the credit with respect to an employee does not exceed the normal hourly wage rate times the hours of family and medical leave taken (cents HALF_UP)";
}
@source(IRC_S45S_B, relation = formalizes, coverage = exact, quote = "shall not exceed an amount equal to the product of the normal hourly wage rate of such employee for each hour (or fraction thereof) of actual services performed for the employer and the number of hours (or fraction thereof) for which family and medical leave is taken")
rule HourlyWageCapRule(employee: Individual, y: TaxableYear, rate: Money, hours: Decimal) strict {
    when normal_hourly_wage_rate_45s(employee, y, rate);
    when hours_of_family_and_medical_leave_taken_45s(employee, y, hours);
    then hourly_wage_cap_45s(employee, y, round(rate / 1.00 USD * hours, 2, "HALF_UP") * 1 USD);
}
pub relation credit_after_hourly_cap_45s(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45S(b)(1): the credit with respect to the employee, after the hourly wage cap";
}
rule CreditAfterHourlyCapRule(employer: Person, employee: Individual, y: TaxableYear, credit: Money, cap: Money) defeasible {
    when paid_family_medical_leave_credit_per_employee(employer, employee, y, credit);
    when hourly_wage_cap_45s(employee, y, cap);
    then credit_after_hourly_cap_45s(employer, employee, y, min(credit, cap));
}
pub relation weeks_of_family_and_medical_leave_taken_45s(employee: Individual, y: TaxableYear, weeks: Decimal) kind empirical {
    label en official "the weeks of family and medical leave taken by the employee during the taxable year — case-asserted";
}
pub relation leave_weeks_taken_into_account_45s(employee: Individual, y: TaxableYear, weeks: Decimal) kind institutional {
    label en official "section 45S(b)(3): the family and medical leave that may be taken into account for an employee for a taxable year does not exceed 12 weeks";
}
@source(IRC_S45S_B, relation = formalizes, coverage = exact, quote = "shall not exceed 12 weeks")
rule LeaveWeeksTakenIntoAccountRule(employee: Individual, y: TaxableYear, weeks: Decimal) strict {
    when weeks_of_family_and_medical_leave_taken_45s(employee, y, weeks);
    then leave_weeks_taken_into_account_45s(employee, y, min(weeks, 12.0));
}

// --- (c)(1): the eligible employer's written policy ------------------------------------------------------------------------------------------------------

pub relation written_policy_in_place_45s(employer: Person) kind empirical {
    label en official "the employer has in place a written policy (section 45S(c)(1)) — case-asserted";
}
pub relation policy_annual_leave_weeks_full_time_45s(employer: Person, weeks: Decimal) kind empirical {
    label en official "the annual paid family and medical leave, in weeks, the policy provides for a qualifying employee who is not a part-time employee (section 4980E(d)(4)(B)) (section 45S(c)(1)(A)(i)) — case-asserted";
}
pub relation policy_has_part_time_qualifying_employees_45s(employer: Person) kind empirical {
    label en official "the employer has qualifying employees who are part-time employees — case-asserted";
}
pub relation policy_annual_leave_weeks_part_time_45s(employer: Person, weeks: Decimal) kind empirical {
    label en official "the annual paid family and medical leave, in weeks, the policy provides for a part-time qualifying employee (section 45S(c)(1)(A)(ii)) — case-asserted";
}
pub relation part_time_expected_weekly_hours_45s(employer: Person, hours: Decimal) kind empirical {
    label en official "the number of hours the part-time employee is expected to work during any week (section 45S(c)(1)(A)(ii)(I)) — case-asserted";
}
pub relation equivalent_full_time_weekly_hours_45s(employer: Person, hours: Decimal) kind empirical {
    label en official "the number of hours an equivalent qualifying full-time employee is expected to work during the week (section 45S(c)(1)(A)(ii)(II)) — case-asserted";
}
pub relation policy_rate_of_payment_45s(employer: Person, rate: Decimal) kind empirical {
    label en official "the rate of payment under the program as a fraction of the wages normally paid to the employee (section 45S(c)(1)(B)) — case-asserted";
}
pub relation policy_meets_c1_requirements_45s(employer: Person) kind institutional {
    label en official "section 45S(c)(1): a written policy providing at least 2 weeks of annual paid family and medical leave to full-time qualifying employees, part-time employees a proportionate amount by hours, and payment of at least 50 percent of normal wages";
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "not less than 2 weeks of annual paid family and medical leave")
rule PolicyMeetsC1WithoutPartTimeRule(employer: Person, weeks: Decimal, rate: Decimal) strict {
    when written_policy_in_place_45s(employer);
    when policy_annual_leave_weeks_full_time_45s(employer, weeks);
    when weeks >= 2.0;
    when not_known(policy_has_part_time_qualifying_employees_45s(employer));
    when policy_rate_of_payment_45s(employer, rate);
    when rate >= 0.50;
    then policy_meets_c1_requirements_45s(employer);
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "The policy requires that the rate of payment under the program is not less than 50 percent of the wages normally paid to such employee for services performed for the employer.")
rule PolicyMeetsC1WithPartTimeRule(employer: Person, weeks: Decimal, part_weeks: Decimal, part_hours: Decimal, full_hours: Decimal, rate: Decimal) strict {
    when written_policy_in_place_45s(employer);
    when policy_annual_leave_weeks_full_time_45s(employer, weeks);
    when weeks >= 2.0;
    when policy_has_part_time_qualifying_employees_45s(employer);
    when policy_annual_leave_weeks_part_time_45s(employer, part_weeks);
    when part_time_expected_weekly_hours_45s(employer, part_hours);
    when equivalent_full_time_weekly_hours_45s(employer, full_hours);
    when full_hours > 0.0;
    when part_weeks >= weeks * part_hours / full_hours;
    when policy_rate_of_payment_45s(employer, rate);
    when rate >= 0.50;
    then policy_meets_c1_requirements_45s(employer);
}

// --- (c)(2): added employees and added employers ---------------------------------------------------------------------------------------------------------

pub relation employee_covered_by_fmla_title_i_45s(employee: Individual) kind empirical {
    label en official "the qualifying employee is covered by title I of the Family and Medical Leave Act of 1993, as amended — case-asserted";
}
pub relation qualifying_employee_of_employer_45s(employee: Individual, employer: Person) kind empirical {
    label en official "the individual is a qualifying employee of the employer — case-asserted";
}
pub relation added_employee_45s(employee: Individual, employer: Person) kind institutional {
    label en official "section 45S(c)(2)(B)(i): a qualifying employee who is not covered by title I of the Family and Medical Leave Act of 1993";
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "The term \"added employee\" means a qualifying employee who is not covered by title I of the Family and Medical Leave Act of 1993, as amended.")
rule AddedEmployeeRule(employee: Individual, employer: Person) strict {
    when qualifying_employee_of_employer_45s(employee, employer);
    when not_known(employee_covered_by_fmla_title_i_45s(employee));
    then added_employee_45s(employee, employer);
}
pub relation offers_paid_leave_to_added_employees_45s(employer: Person) kind empirical {
    label en official "the employer offers paid family and medical leave to added employees (section 45S(c)(2)(B)(ii)) — case-asserted";
}
pub relation eligible_employer_without_c2_45s(employer: Person) kind empirical {
    label en official "the employer is an eligible employer determined without regard to paragraph (2) — case-asserted";
}
pub relation added_employer_45s(employer: Person) kind institutional {
    label en official "section 45S(c)(2)(B)(ii): an eligible employer (determined without regard to this paragraph), whether or not covered by title I of the Family and Medical Leave Act, that offers paid family and medical leave to added employees";
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "The term \"added employer\" means an eligible employer (determined without regard to this paragraph)")
rule AddedEmployerRule(employer: Person) strict {
    when eligible_employer_without_c2_45s(employer);
    when offers_paid_leave_to_added_employees_45s(employer);
    then added_employer_45s(employer);
}
pub relation policy_ensures_no_interference_45s(employer: Person) kind empirical {
    label en official "the written policy ensures that the employer will not interfere with, restrain, or deny the exercise of or the attempt to exercise, any right provided under the policy (section 45S(c)(2)(A)(i)) — case-asserted";
}
pub relation policy_ensures_no_retaliation_45s(employer: Person) kind empirical {
    label en official "the written policy ensures that the employer will not discharge or in any other manner discriminate against any individual for opposing any practice prohibited by the policy (section 45S(c)(2)(A)(ii)) — case-asserted";
}
pub relation added_employer_treated_as_eligible_45s(employer: Person) kind institutional {
    label en official "section 45S(c)(2)(A): an added employer is treated as an eligible employer only if it provides paid leave under a written policy ensuring no interference and no retaliation";
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "An added employer shall not be treated as an eligible employer unless such employer provides paid family and medical leave in compliance with a written policy which ensures that the employer")
rule AddedEmployerTreatedAsEligibleRule(employer: Person) strict {
    when added_employer_45s(employer);
    when policy_ensures_no_interference_45s(employer);
    when policy_ensures_no_retaliation_45s(employer);
    then added_employer_treated_as_eligible_45s(employer);
}

// --- (c)(3)-(5): single taxpayer, state leave, no other penalty ---------------------------------------------------------------------------------------

pub relation controlled_group_52_45s(group: Person, employer: Person) kind empirical {
    label en official "the employer is a member of a group treated as a single employer under subsection (a) or (b) of section 52 — case-asserted";
}
pub relation treated_as_single_taxpayer_45s(a: Person, b: Person) kind institutional {
    label en official "section 45S(c)(3): all persons treated as a single employer under section 52(a) and (b) are treated as a single taxpayer";
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "All persons which are treated as a single employer under subsections (a) and (b) of section 52 shall be treated as a single taxpayer.")
rule TreatedAsSingleTaxpayerRule(a: Person, b: Person, group: Person) strict {
    when controlled_group_52_45s(group, a);
    when controlled_group_52_45s(group, b);
    then treated_as_single_taxpayer_45s(a, b);
}
pub relation total_paid_leave_provided_45s(employer: Person, employee: Individual, y: TaxableYear, weeks: Decimal) kind empirical {
    label en official "the paid family and medical leave, in weeks, provided to the employee including leave paid by a State or local government or required by State or local law — case-asserted";
}
pub relation state_or_local_paid_leave_45s(employer: Person, employee: Individual, y: TaxableYear, weeks: Decimal) kind empirical {
    label en official "the leave paid by a State or local government or required by State or local law, in weeks (section 45S(c)(4)) — case-asserted";
}
pub relation employer_provided_paid_leave_weeks_45s(employer: Person, employee: Individual, y: TaxableYear, weeks: Decimal) kind institutional {
    label en official "section 45S(c)(4): leave paid by a State or local government or required by State or local law is not taken into account in the paid family and medical leave provided by the employer (not below zero)";
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "any leave which is paid by a State or local government or required by State or local law shall not be taken into account in determining the amount of paid family and medical leave provided by the employer")
rule EmployerProvidedPaidLeaveWeeksRule(employer: Person, employee: Individual, y: TaxableYear, total: Decimal, state: Decimal) strict {
    when total_paid_leave_provided_45s(employer, employee, y, total);
    when state_or_local_paid_leave_45s(employer, employee, y, state);
    then employer_provided_paid_leave_weeks_45s(employer, employee, y, max(total - state, 0.0));
}
pub relation employer_subject_to_subsection_c_requirements_45s(employer: Person) kind empirical {
    label en official "the employer is subject to the requirements of subsection (c) — case-asserted";
}
pub relation penalty_liability_or_other_consequence_imposed_45s(employer: Person) kind empirical {
    label en official "a penalty, liability, or other consequence (other than ineligibility for the credit or recapture of its benefit) is imposed on the employer for failure to comply with subsection (c) — case-asserted";
}
@source(IRC_S45S_C, relation = formalizes, coverage = exact, quote = "Nothing in this subsection shall be construed as subjecting an employer to any penalty, liability, or other consequence")
rule NoOtherConsequenceForNoncomplianceRule(employer: Person) strict {
    when employer_subject_to_subsection_c_requirements_45s(employer);
    then immunity NoOtherConsequenceForNoncomplianceImmunity {
        holder employer;
        protected_effect penalty_liability_or_other_consequence_imposed_45s(employer);
        window [-infinity, infinity);
    };
}

// --- (d): the qualifying employee -------------------------------------------------------------------------------------------------------------------------------

pub relation employee_under_flsa_3e_45s(employee: Individual, employer: Person) kind empirical {
    label en official "the individual is an employee within the meaning of section 3(e) of the Fair Labor Standards Act of 1938 (section 45S(d)) — case-asserted";
}
pub relation months_employed_by_employer_45s(employee: Individual, employer: Person, months: Decimal) kind empirical {
    label en official "the number of months the employee has been employed by the employer (section 45S(d)(1)) — case-asserted";
}
pub relation compensation_for_preceding_year_45s(employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the employee's compensation for the preceding year (section 45S(d)(2)) — case-asserted";
}
pub relation section_414q1b_i_amount_for_year_45s(y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount applicable for the year under clause (i) of section 414(q)(1)(B) (section 45S(d)(2)) — case-asserted";
}
pub relation qualifying_employee_defined_45s(employee: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45S(d): an employee (Fair Labor Standards Act section 3(e)) employed by the employer for 1 year or more whose compensation for the preceding year was not in excess of 60 percent of the section 414(q)(1)(B)(i) amount";
}
@source(IRC_S45S_D, relation = formalizes, coverage = exact, quote = "has been employed by the employer for 1 year or more")
rule QualifyingEmployeeDefinedRule(employee: Individual, employer: Person, y: TaxableYear, months: Decimal, comp: Money, limit: Money) strict {
    when employee_under_flsa_3e_45s(employee, employer);
    when months_employed_by_employer_45s(employee, employer, months);
    when months >= 12.0;
    when compensation_for_preceding_year_45s(employee, y, comp);
    when section_414q1b_i_amount_for_year_45s(y, limit);
    when comp <= 0.60 * limit;
    then qualifying_employee_defined_45s(employee, employer, y);
}

// --- (e): family and medical leave -------------------------------------------------------------------------------------------------------------------------------

pub relation leave_purpose_45s(leave: Asset, purpose: LeavePurpose45S) kind empirical {
    label en official "the purpose of the leave (section 45S(e)(1)-(2)) — case-asserted";
}
pub relation family_and_medical_leave_45s(leave: Asset) kind institutional {
    label en official "section 45S(e)(1)-(2): leave for a purpose described in section 102(a)(1)(A)-(E) or (3) of the Family and Medical Leave Act, whether provided under the Act or by the employer's policy; paid vacation, personal, or medical or sick leave (other than leave specifically for those purposes) is not family and medical leave";
}
@source(IRC_S45S_E, relation = formalizes, coverage = exact, quote = "the term \"family and medical leave\" means leave for any 1 or more of the purposes described under subparagraph (A), (B), (C), (D), or (E) of paragraph (1), or paragraph (3), of section 102(a) of the Family and Medical Leave Act of 1993")
rule FamilyAndMedicalLeaveBirthRule(leave: Asset) strict {
    when leave_purpose_45s(leave, BirthOfChild);
    then family_and_medical_leave_45s(leave);
}
rule FamilyAndMedicalLeaveAdoptionRule(leave: Asset) strict {
    when leave_purpose_45s(leave, AdoptionOrFosterPlacement);
    then family_and_medical_leave_45s(leave);
}
rule FamilyAndMedicalLeaveFamilyCareRule(leave: Asset) strict {
    when leave_purpose_45s(leave, CareOfFamilyMemberWithSeriousHealthCondition);
    then family_and_medical_leave_45s(leave);
}
rule FamilyAndMedicalLeaveOwnConditionRule(leave: Asset) strict {
    when leave_purpose_45s(leave, OwnSeriousHealthCondition);
    then family_and_medical_leave_45s(leave);
}
rule FamilyAndMedicalLeaveExigencyRule(leave: Asset) strict {
    when leave_purpose_45s(leave, QualifyingExigencyOfMilitaryFamilyMember);
    then family_and_medical_leave_45s(leave);
}
rule FamilyAndMedicalLeaveMilitaryCaregiverRule(leave: Asset) strict {
    when leave_purpose_45s(leave, MilitaryCaregiverLeave);
    then family_and_medical_leave_45s(leave);
}

// --- (f), (g): the determination by the Secretary and the wages ---------------------------------------------------------------------------------

external judgment relation secretary_determines_employer_eligibility_45s(employer: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary determines, based on the information provided by the employer, that the employer satisfies the requirements for an eligible employer (section 45S(f))";
}
pub relation employer_eligibility_determined_45s(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 45S(f): whether an employer satisfies the requirements of subsection (c) is determined by the Secretary on the information the employer provides";
}
rule EmployerEligibilityDetermined45sRule(employer: Person, y: TaxableYear) defeasible {
    when policy_meets_c1_requirements_45s(employer);
    when secretary_determines_employer_eligibility_45s(employer, y);
    then employer_eligibility_determined_45s(employer, y);
}
pub relation wages_under_3306b_45s(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the wages of the employee within the meaning of section 3306(b), determined without regard to any dollar limitation (section 45S(g)) — case-asserted";
}
pub relation wages_taken_into_account_for_other_credit_45s(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount taken into account for purposes of determining any other credit allowed under this subpart — case-asserted";
}
pub relation wages_for_section_45s_45s(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45S(g): wages have the meaning of section 3306(b) without dollar limit and do not include any amount taken into account for another credit of the subpart (not below zero)";
}
@source(IRC_S45S_G, relation = formalizes, coverage = exact, quote = "Such term shall not include any amount taken into account for purposes of determining any other credit allowed under this subpart.")
rule WagesForSection45sRule(employer: Person, employee: Individual, y: TaxableYear, wages: Money, other: Money) strict {
    when wages_under_3306b_45s(employer, employee, y, wages);
    when wages_taken_into_account_for_other_credit_45s(employer, employee, y, other);
    then wages_for_section_45s_45s(employer, employee, y, max(wages - other, 0 USD));
}
rule WagesForSection45sNoOtherRule(employer: Person, employee: Individual, y: TaxableYear, wages: Money) strict {
    when wages_under_3306b_45s(employer, employee, y, wages);
    when not_known(other_credit_wages_asserted_45s(employer, employee, y));
    then wages_for_section_45s_45s(employer, employee, y, wages);
}
relation other_credit_wages_asserted_45s(employer: Person, employee: Individual, y: TaxableYear) kind institutional;
rule OtherCreditWagesAssertedRule(employer: Person, employee: Individual, y: TaxableYear, other: Money) strict {
    when wages_taken_into_account_for_other_credit_45s(employer, employee, y, other);
    then other_credit_wages_asserted_45s(employer, employee, y);
}
