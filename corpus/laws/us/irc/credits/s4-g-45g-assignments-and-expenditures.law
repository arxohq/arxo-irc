// Stage 4 (DECISION-0379 with deontics), credits, part G: section 45G(b)(2)(A), (C) (the
// assignment of track miles: once per taxable year of the railroad, effective at the close of
// its year, taken into account by the assignee for the year that includes that date) and
// section 45G(d) (qualified railroad track maintenance expenditures derived from the items).
// Closes G6422.
//
// The assignment of module 45g is asserted for one year (`track_assignment_45g(assignor,
// assignee, y, miles)`, the same year for both). Here an assignment is an EVENT of the assignor's
// year; its effective date is the last day of that year; the assignee's year is the one that
// contains the date; the derived `track_assignment_45g` fact then feeds the miles rules of
// module 45g, which read it (the earlier channel, asserted directly, stays). The rules of
// module 45g that read the assignments became defeasible for that reason.

use self::{
    IRC_S45G_B,
    IRC_S45G_D,
    Person,
    TaxableYear,
    qualified_railroad_track_maintenance_expenditures_45g,
    track_assignment_45g,
};

pub relation track_assignment_made_45g(assignment: Integer, assignor: Person, assignee: Person, assignor_year: TaxableYear, miles: Decimal) kind empirical {
    label en official "a Class II or Class III railroad assigns miles of railroad track to the assignee for purposes of section 45G(b); the assignment belongs to a taxable year of the assignor (section 45G(b)(2))";
}
pub relation track_assignment_effective_on_45g(assignment: Integer, eff_on: Date) kind institutional {
    label en official "the assignment is treated as made as of the close of the assignor's taxable year (section 45G(b)(2)(A))";
}
@source(IRC_S45G_B, quote = "(A) such assignment may be made only once per taxable year of the Class II or Class III railroad and shall be treated as made as of the close of such taxable year,")
rule TrackAssignmentTreatedAsMadeAtYearClose45g(assignment: Integer, assignor: Person, assignee: Person, y: TaxableYear, miles: Decimal, close: Date) defeasible {
    label en official "effective on the last day of the assignor's taxable year (section 45G(b)(2)(A))";
    when track_assignment_made_45g(assignment, assignor, assignee, y, miles);
    when us.irc.core::ends(y, close);
    then track_assignment_effective_on_45g(assignment, close);
}
pub relation second_track_assignment_in_year_45g(assignor: Person, y: TaxableYear) kind institutional {
    label en official "the railroad makes a second assignment in the same taxable year";
}
rule SecondTrackAssignmentInYear45g(a1: Integer, a2: Integer, assignor: Person, e1: Person, e2: Person, y: TaxableYear, m1: Decimal, m2: Decimal) defeasible {
    label en official "two distinct assignments of the same assignor in the same year";
    when track_assignment_made_45g(a1, assignor, e1, y, m1);
    when track_assignment_made_45g(a2, assignor, e2, y, m2);
    when a1 != a2;
    then second_track_assignment_in_year_45g(assignor, y);
}
@source(IRC_S45G_B, quote = "(A) such assignment may be made only once per taxable year of the Class II or Class III railroad and shall be treated as made as of the close of such taxable year,")
rule Section45gB2AOneAssignmentPerYearProhibition(assignor: Person, y: TaxableYear) defeasible {
    label en official "a Class II or Class III railroad may not assign twice in one taxable year (section 45G(b)(2)(A)); VIOLATED on itself when a second assignment is made";
    when second_track_assignment_in_year_45g(assignor, y);
    then prohibition Section45gB2AOneAssignmentPerYear {
        bearer assignor;
        action second_track_assignment_in_year_45g(assignor, y);
        window [@2005-08-08, infinity);
    };
}
pub relation track_assignment_taken_into_account_year_45g(assignment: Integer, assignee: Person, y_assignee: TaxableYear) kind institutional {
    label en official "the taxable year of the assignee that includes the effective date of the assignment (section 45G(b)(2)(C))";
}
@source(IRC_S45G_B, quote = "(C) such assignment shall be taken into account for the taxable year of the assignee which includes the date that such assignment is treated as effective.")
rule AssignmentTakenIntoAccountInAssigneeYear45g(assignment: Integer, assignor: Person, assignee: Person, y: TaxableYear, miles: Decimal, eff_on: Date, ya: TaxableYear, begins_on: Date, ends_on: Date) defeasible {
    label en official "the assignee's year containing the effective date (section 45G(b)(2)(C))";
    when track_assignment_made_45g(assignment, assignor, assignee, y, miles);
    when track_assignment_effective_on_45g(assignment, eff_on);
    when us.irc.core::begins(ya, begins_on);
    when us.irc.core::ends(ya, ends_on);
    when eff_on >= begins_on;
    when eff_on <= ends_on;
    then track_assignment_taken_into_account_year_45g(assignment, assignee, ya);
}
@source(IRC_S45G_B, quote = "(C) such assignment shall be taken into account for the taxable year of the assignee which includes the date that such assignment is treated as effective.")
rule DerivedTrackAssignmentForAssigneeYear45g(assignment: Integer, assignor: Person, assignee: Person, y: TaxableYear, miles: Decimal, ya: TaxableYear) defeasible {
    label en official "the assignment counts for the assignee in its year of the effective date: feeds the miles rules of module 45g";
    when track_assignment_made_45g(assignment, assignor, assignee, y, miles);
    when track_assignment_taken_into_account_year_45g(assignment, assignee, ya);
    then track_assignment_45g(assignor, assignee, ya, miles);
}

// ===================== 45G(d): qualified railroad track maintenance expenditures =====================

pub relation track_maintenance_expenditure_45g(taxpayer: Person, y: TaxableYear, track: Integer, amount: Money) kind empirical {
    label en official "gross expenditures, whether or not chargeable to capital account, for maintaining the railroad track (roadbed, bridges and related track structures) in the taxable year (section 45G(d)); the consideration given by the railroad that made the assignment is disregarded, so the amount is gross";
}
pub relation track_owned_or_leased_on_january_1_2015_by_class_ii_or_iii_45g(track: Integer) kind empirical {
    label en official "the track was owned or leased as of January 1, 2015, by a Class II or Class III railroad (section 45G(d))";
}
pub relation qualified_track_maintenance_expenditures_derived_45g(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified railroad track maintenance expenditures: the gross expenditures for track owned or leased as of January 1, 2015 by a Class II or Class III railroad";
}
@source(IRC_S45G_D, quote = "the term \"qualified railroad track maintenance expenditures\" means gross expenditures (whether or not otherwise chargeable to capital account) for maintaining railroad track (including roadbed, bridges, and related track structures) owned or leased as of January 1, 2015, by a Class II or Class III railroad")
rule QualifiedTrackMaintenanceExpendituresDerived45g(taxpayer: Person, y: TaxableYear, track: Integer, amount: Money) defeasible {
    label en official "sum of the gross amounts of the qualifying track (section 45G(d))";
    when track_maintenance_expenditure_45g(taxpayer, y, track, amount);
    when track_owned_or_leased_on_january_1_2015_by_class_ii_or_iii_45g(track);
    then qualified_track_maintenance_expenditures_derived_45g(taxpayer, y,
        sum(collect all a: Money, t: Integer where track_maintenance_expenditure_45g(taxpayer, y, t, a) and track_owned_or_leased_on_january_1_2015_by_class_ii_or_iii_45g(t), empty: 0 USD));
}
pub relation qualified_track_maintenance_expenditures_for_credit_45g(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified expenditures the credit reads: the asserted amount or the derived one";
}
rule QualifiedTrackExpendituresAsserted45g(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the asserted amount (the earlier channel)";
    when qualified_railroad_track_maintenance_expenditures_45g(taxpayer, y, amount);
    then qualified_track_maintenance_expenditures_for_credit_45g(taxpayer, y, amount);
}
rule QualifiedTrackExpendituresDerived45g(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the derived amount";
    when qualified_track_maintenance_expenditures_derived_45g(taxpayer, y, amount);
    then qualified_track_maintenance_expenditures_for_credit_45g(taxpayer, y, amount);
}
