// Section 25D — Residential clean energy credit. Stage 2c (IRC-06 stage
// 2c, DECISION-0379). Priority list item: §25D (30 percent with the phase-
// down/termination edition).
//
// Judgment calls / scope:
// * The (g) applicable-percentage phase-down (30%/26%/30%/26%/22% by
//   placed-in-service date window through December 31, 2034) and the (h)
//   termination (no credit for property placed in service after December
//   31, 2034) are ALREADY part of the pinned CURRENT (2024 Edition) base
//   text — no `us.irc.temporal` PL 119-21 anchor is needed for these two
//   provisions, unlike section 25C/30D. Both are modelled EXACTLY as
//   pinned.
// * PL 119-21 section 70506 ("TERMINATION OF RESIDENTIAL CLEAN ENERGY
//   CREDIT") is expected to move the termination date EARLIER than the
//   base text's December 31, 2034 — but that fragment is NOT among the
//   ones `us.irc.temporal` has pinned (the same "14 of 104" extraction gap
//   documented in the 25C module's header; confirmed absent by grep). This
//   package cannot add it (never edit another owner's package). SOURCE_GAP
//   (TECH-GAPS G391): the (g)/(h) rules below reflect the base 2024-Edition
//   dates, which is the best CURRENTLY PINNED law, not necessarily the
//   post-PL-119-21 law.
// * (d)(1)-(6) (the six qualified-expenditure categories: solar water
//   heating, solar electric, fuel cell, small wind, geothermal heat pump,
//   battery storage) are case-asserted amounts, read as already meeting
//   their own definitional tests (residence location, Energy Star
//   standard, 3-kWh battery capacity floor) — TECH_GAP for the item-level
//   tests, TECH-GAPS G391.
// * (b)(1) (the $500-per-half-kilowatt fuel cell cap) is modelled exactly,
//   reading the fuel cell property's capacity as a case-asserted input.
// * (b)(2) (solar water heating property must be SRCC-certified) is
//   modelled as a gating classification fact.
// * (c) (carryforward of unused credit against the section 26(a)
//   limitation) is NOT modelled — same multi-year-ledger class as this
//   package's other unresolved carryforward gaps (TECH-GAPS G391).
// * (e) (labor costs includible; solar roofing not excluded merely as a
//   structural component; swimming-pool/hot-tub storage-medium exclusion;
//   the (e)(4) joint-occupancy fuel-cell dollar sub-limits) and (f) (basis
//   reduction) are NOT modelled — case-asserted expenditure amounts are
//   read as already reflecting the (e) inclusions/exclusions.

use self::{
    IRC_S25D_A,
    IRC_S25D_B,
    IRC_S25D_G,
    IRC_S25D_H,
    Individual,
    TaxableYear,
};

pub relation placed_in_service_date_25d(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) kind empirical {
    label en official "the date the qualified property (identified by an arbitrary per-taxpayer item number) was placed in service, for the section 25D(g) applicable-percentage table and the section 25D(h) termination — case-asserted";
}
pub relation applicable_percentage_25d(taxpayer: Individual, y: TaxableYear, item: Integer, pct: Decimal) kind institutional {
    label en official "section 25D(g): the applicable percentage for the item's placed-in-service date";
}
@source(IRC_S25D_G, quote = "in the case of property placed in service after December 31, 2021, and before January 1, 2033, 30 percent")
rule ApplicablePercentage25dCurrentWindowRule(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) strict {
    when placed_in_service_date_25d(taxpayer, y, item, on);
    when on > @2021-12-31;
    when on < @2033-01-01;
    then applicable_percentage_25d(taxpayer, y, item, 0.30);
}
@source(IRC_S25D_G, quote = "in the case of property placed in service after December 31, 2032, and before January 1, 2034, 26 percent")
rule ApplicablePercentage25dPhaseDown26Rule(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) strict {
    when placed_in_service_date_25d(taxpayer, y, item, on);
    when on > @2032-12-31;
    when on < @2034-01-01;
    then applicable_percentage_25d(taxpayer, y, item, 0.26);
}
@source(IRC_S25D_G, quote = "in the case of property placed in service after December 31, 2033, and before January 1, 2035, 22 percent")
rule ApplicablePercentage25dPhaseDown22Rule(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) strict {
    when placed_in_service_date_25d(taxpayer, y, item, on);
    when on > @2033-12-31;
    when on < @2035-01-01;
    then applicable_percentage_25d(taxpayer, y, item, 0.22);
}
@source(IRC_S25D_G, quote = "in the case of property placed in service after December 31, 2019, and before January 1, 2022, 26 percent")
rule ApplicablePercentage25dEarlier26Rule(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) strict {
    when placed_in_service_date_25d(taxpayer, y, item, on);
    when on > @2019-12-31;
    when on < @2022-01-01;
    then applicable_percentage_25d(taxpayer, y, item, 0.26);
}
@source(IRC_S25D_G, quote = "in the case of property placed in service after December 31, 2016, and before January 1, 2020, 30 percent")
rule ApplicablePercentage25dEarliest30Rule(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) strict {
    when placed_in_service_date_25d(taxpayer, y, item, on);
    when on > @2016-12-31;
    when on < @2020-01-01;
    then applicable_percentage_25d(taxpayer, y, item, 0.30);
}
pub relation section_25d_terminated_25h(taxpayer: Individual, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 25D(h): no credit for property placed in service after December 31, 2034 (base 2024-Edition date; PL 119-21 section 70506 is expected to move this date earlier but is not pinned in this corpus, SOURCE_GAP)";
}
@source(IRC_S25D_H, quote = "The credit allowed under this section shall not apply to property placed in service after December 31, 2034.")
rule Section25dTerminationRule(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when placed_in_service_date_25d(taxpayer, y, item, on);
    when on > @2034-12-31;
    then section_25d_terminated_25h(taxpayer, y, item);
}
// STAGE 2d: PL 119-21 section 70506 (`us.irc.temporal::PL119_21_S70506`,
// enacted 2025-07-04) replaces the end date by "expenditures made after
// December 31, 2025"; the expenditure is read at the property's asserted
// placed-in-service date (the module has no separate expenditure date, G1790).
@source(us.irc.temporal::PL119_21_S70506, quote = "Section 25D(h) is amended by striking “to property placed in service after December 31, 2034” and inserting “with respect to any expenditures made after December 31, 2025”.")
rule Section25dTerminationAmendedRule(taxpayer: Individual, y: TaxableYear, item: Integer, on: Date) strict {
    effective [@2025-07-04, infinity);
    when placed_in_service_date_25d(taxpayer, y, item, on);
    when on > @2025-12-31;
    then section_25d_terminated_25h(taxpayer, y, item);
}

// --- §25D(d): the six qualified-expenditure categories -------------------------

pub relation qualified_solar_electric_property_expenditure(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "section 25D(d)(2): expenditure for property using solar energy to generate electricity for a US dwelling used as a residence — case-asserted";
}
pub relation qualified_solar_water_heating_property_expenditure(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "section 25D(d)(1): expenditure for solar water heating property (at least half the energy from the sun) — case-asserted";
}
pub relation solar_water_heating_property_certified(taxpayer: Individual, y: TaxableYear, item: Integer) kind empirical {
    label en official "section 25D(b)(2): the solar water heating property is SRCC-certified (or a comparable state-endorsed entity) — case-asserted";
}
pub relation qualified_fuel_cell_property_expenditure(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "section 25D(d)(3): expenditure for qualified fuel cell property (section 48(c)(1)) installed at the taxpayer's principal residence — case-asserted";
}
pub relation fuel_cell_property_capacity_half_kw(taxpayer: Individual, y: TaxableYear, item: Integer, half_kw_units: Decimal) kind empirical {
    label en official "the qualified fuel cell property's capacity, expressed as a number of half-kilowatt units, for the section 25D(b)(1) $500-per-half-kilowatt cap — case-asserted";
}
pub relation qualified_small_wind_energy_property_expenditure(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "section 25D(d)(4): expenditure for a wind-turbine electricity-generating property — case-asserted";
}
pub relation qualified_geothermal_heat_pump_property_expenditure(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "section 25D(d)(5): expenditure for geothermal heat pump property meeting the Energy Star standard — case-asserted";
}
pub relation qualified_battery_storage_technology_expenditure(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "section 25D(d)(6): expenditure for battery storage technology of at least 3 kilowatt hours capacity, installed at the taxpayer's residence — case-asserted";
}

// --- Per-category credit before the section 25D(g) percentage, then capped ----

pub relation solar_electric_credit_25d(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional;
@source(IRC_S25D_A, quote = "the qualified solar electric property expenditures")
rule SolarElectricCredit25dRule(taxpayer: Individual, y: TaxableYear, item: Integer, expenditure: Money, pct: Decimal) strict {
    when qualified_solar_electric_property_expenditure(taxpayer, y, item, expenditure);
    when applicable_percentage_25d(taxpayer, y, item, pct);
    when not_known(section_25d_terminated_25h(taxpayer, y, item));
    then solar_electric_credit_25d(taxpayer, y, item, round(pct * expenditure, 2, "HALF_UP"));
}
pub relation solar_water_heating_credit_25d(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional;
@source(IRC_S25D_B, quote = "No credit shall be allowed under this section for an item of property described in subsection (d)(1) unless such property is certified for performance by the non-profit Solar Rating Certification Corporation or a comparable entity endorsed by the government of the State in which such property is installed.")
rule SolarWaterHeatingCredit25dRule(taxpayer: Individual, y: TaxableYear, item: Integer, expenditure: Money, pct: Decimal) strict {
    when qualified_solar_water_heating_property_expenditure(taxpayer, y, item, expenditure);
    when solar_water_heating_property_certified(taxpayer, y, item);
    when applicable_percentage_25d(taxpayer, y, item, pct);
    when not_known(section_25d_terminated_25h(taxpayer, y, item));
    then solar_water_heating_credit_25d(taxpayer, y, item, round(pct * expenditure, 2, "HALF_UP"));
}
pub relation fuel_cell_credit_before_cap_25d(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional;
@source(IRC_S25D_A, quote = "the qualified fuel cell property expenditures")
rule FuelCellCreditBeforeCap25dRule(taxpayer: Individual, y: TaxableYear, item: Integer, expenditure: Money, pct: Decimal) strict {
    when qualified_fuel_cell_property_expenditure(taxpayer, y, item, expenditure);
    when applicable_percentage_25d(taxpayer, y, item, pct);
    when not_known(section_25d_terminated_25h(taxpayer, y, item));
    then fuel_cell_credit_before_cap_25d(taxpayer, y, item, round(pct * expenditure, 2, "HALF_UP"));
}
pub relation fuel_cell_credit_25d(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "section 25D(b)(1): the fuel cell credit, capped at $500 per half kilowatt of capacity";
}
@source(IRC_S25D_B, quote = "the credit allowed under subsection (a) (determined without regard to subsection (c)) for any taxable year shall not exceed $500 with respect to each half kilowatt of capacity of the qualified fuel cell property (as defined in section 48(c)(1)) to which such expenditure relates")
rule FuelCellCredit25dRule(taxpayer: Individual, y: TaxableYear, item: Integer, before: Money, half_kw: Decimal) strict {
    when fuel_cell_credit_before_cap_25d(taxpayer, y, item, before);
    when fuel_cell_property_capacity_half_kw(taxpayer, y, item, half_kw);
    then fuel_cell_credit_25d(taxpayer, y, item, min(before, round(500.00 USD * half_kw, 2, "HALF_UP")));
}
pub relation small_wind_credit_25d(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional;
@source(IRC_S25D_A, quote = "the qualified small wind energy property expenditures")
rule SmallWindCredit25dRule(taxpayer: Individual, y: TaxableYear, item: Integer, expenditure: Money, pct: Decimal) strict {
    when qualified_small_wind_energy_property_expenditure(taxpayer, y, item, expenditure);
    when applicable_percentage_25d(taxpayer, y, item, pct);
    when not_known(section_25d_terminated_25h(taxpayer, y, item));
    then small_wind_credit_25d(taxpayer, y, item, round(pct * expenditure, 2, "HALF_UP"));
}
pub relation geothermal_heat_pump_credit_25d(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional;
@source(IRC_S25D_A, quote = "the qualified geothermal heat pump property expenditures")
rule GeothermalHeatPumpCredit25dRule(taxpayer: Individual, y: TaxableYear, item: Integer, expenditure: Money, pct: Decimal) strict {
    when qualified_geothermal_heat_pump_property_expenditure(taxpayer, y, item, expenditure);
    when applicable_percentage_25d(taxpayer, y, item, pct);
    when not_known(section_25d_terminated_25h(taxpayer, y, item));
    then geothermal_heat_pump_credit_25d(taxpayer, y, item, round(pct * expenditure, 2, "HALF_UP"));
}
pub relation battery_storage_credit_25d(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional;
@source(IRC_S25D_A, quote = "the qualified battery storage technology expenditures")
rule BatteryStorageCredit25dRule(taxpayer: Individual, y: TaxableYear, item: Integer, expenditure: Money, pct: Decimal) strict {
    when qualified_battery_storage_technology_expenditure(taxpayer, y, item, expenditure);
    when applicable_percentage_25d(taxpayer, y, item, pct);
    when not_known(section_25d_terminated_25h(taxpayer, y, item));
    then battery_storage_credit_25d(taxpayer, y, item, round(pct * expenditure, 2, "HALF_UP"));
}

pub relation residential_clean_energy_credit_item(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the section 25D(a) sum of applicable-percentage amounts for a single item of qualified property (at most one of the six categories is expected to apply to a given item)";
}
rule ResidentialCleanEnergyCreditItemSolarElectricRule(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    when solar_electric_credit_25d(taxpayer, y, item, amount);
    then residential_clean_energy_credit_item(taxpayer, y, item, amount);
}
rule ResidentialCleanEnergyCreditItemSolarWaterRule(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    when solar_water_heating_credit_25d(taxpayer, y, item, amount);
    then residential_clean_energy_credit_item(taxpayer, y, item, amount);
}
rule ResidentialCleanEnergyCreditItemFuelCellRule(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    when fuel_cell_credit_25d(taxpayer, y, item, amount);
    then residential_clean_energy_credit_item(taxpayer, y, item, amount);
}
rule ResidentialCleanEnergyCreditItemSmallWindRule(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    when small_wind_credit_25d(taxpayer, y, item, amount);
    then residential_clean_energy_credit_item(taxpayer, y, item, amount);
}
rule ResidentialCleanEnergyCreditItemGeothermalRule(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    when geothermal_heat_pump_credit_25d(taxpayer, y, item, amount);
    then residential_clean_energy_credit_item(taxpayer, y, item, amount);
}
rule ResidentialCleanEnergyCreditItemBatteryRule(taxpayer: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    when battery_storage_credit_25d(taxpayer, y, item, amount);
    then residential_clean_energy_credit_item(taxpayer, y, item, amount);
}

pub relation residential_clean_energy_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 25D residential clean energy credit for the taxable year: the sum across all items of qualified property (before the section 25D(c) carryforward mechanism, TECH_GAP)";
}
@source(IRC_S25D_A, quote = "there shall be allowed as a credit against the tax imposed by this chapter for the taxable year an amount equal to the sum of the applicable percentages of")
rule ResidentialCleanEnergyCreditRule(taxpayer: Individual, y: TaxableYear) defeasible {
    when placed_in_service_date_25d(taxpayer, y, _, _);
    then residential_clean_energy_credit(taxpayer, y,
        sum all amount: Money for item: Integer where residential_clean_energy_credit_item(taxpayer, y, item, amount));
}
