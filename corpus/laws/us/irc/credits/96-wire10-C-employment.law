// Credits -- WIRE-10 group C, owner `employment` (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed;
// no legal review).
//
// Section 45P(b)(1): the differential wage payments (section 3401(h)(2)) paid to the employee for the taxable year. The placeholder
// `differential_wage_payments_45p` was case-asserted. The owner (`us.irc.employment`, modules 01 and 04) records every wage payment with
// employer, employee, taxable year and amount (`wage_payment`) and classifies the payment as a differential wage payment
// (`differential_wage_payment`); the amount for the year is the sum of the amounts of the employer's differential payments to the employee.
// The case-fact channel stays valid.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

import us.irc.employment version "0.1.1";

use self::{
    Individual,
    Person,
    TaxableYear,
    differential_wage_payments_45p,
};

rule W10CDifferentialWagePaymentsFromEmployment strict {
    label en official "section 45P(b)(1): the differential wage payments paid by the taxpayer to the employee for the taxable year are the sum of the wage payments the employment package classifies as differential wage payments under section 3401(h)(2)";
    for taxpayer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for p0: us.irc.employment::WagePayment;
    for a0: Money;
    when us.irc.employment::wage_payment(p0, taxpayer, employee, y, a0, _) and us.irc.employment::differential_wage_payment(p0);
    then differential_wage_payments_45p(taxpayer, employee, y,
        sum all amt: Money for pay: us.irc.employment::WagePayment where us.irc.employment::wage_payment(pay, taxpayer, employee, y, amt, _) and us.irc.employment::differential_wage_payment(pay));
}
