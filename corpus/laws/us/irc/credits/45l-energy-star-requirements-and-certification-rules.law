// Section 45L — the energy saving requirements of (c) (zero energy ready home, Energy Star single-family, manufactured home and multifamily
// program versions and reference dates), the certification form of (d)(2), the basis rule of (e) and the prevailing wage requirement of
// (g)(2)(A). Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2d rows of TECH-GAPS G1783). Companion of
// `45l-new-energy-efficient-home-credit.law`; its credit rules read the energy saving requirement as one case fact and are NOT rewired to
// require these relations.
//
// Judgment calls: whether a unit meets a program's requirements as in effect on a given first of January is a case fact per year; the
// reference year is the later of 2023 and the year 2 (single-family, manufactured) or 3 (multifamily) calendar years before the year of
// acquisition; the successor program of the zero energy ready home program is an external judgment of the Secretary (DECISION-0194);
// the basis rule reads the asserted basis increase.

use self::{
    Asset,
    IRC_S45L_C,
    IRC_S45L_D,
    IRC_S45L_E,
    IRC_S45L_G,
    Person,
};

pub enum UnitType45L { SingleFamily, ManufacturedHome, MultifamilyDwelling }

// --- (c)(1)(B): zero energy ready home -----------------------------------------------------------------------------------------------------------------------

pub relation certified_zero_energy_ready_home_2023_program_45l(unit: Asset) kind empirical {
    label en official "the dwelling unit is certified as a zero energy ready home under the zero energy ready home program of the Department of Energy as in effect on January 1, 2023 (section 45L(c)(1)(B)) — case-asserted";
}
pub relation certified_under_successor_program_45l(unit: Asset) kind empirical {
    label en official "the dwelling unit is certified as a zero energy ready home under a successor program (section 45L(c)(1)(B)) — case-asserted";
}
external judgment relation secretary_determines_successor_program_45l(unit: Asset) {
    authority Secretary;
    label en official "the Secretary determines that the program is a successor to the zero energy ready home program of the Department of Energy (section 45L(c)(1)(B))";
}
pub relation zero_energy_ready_requirement_met_45l(unit: Asset) kind institutional {
    label en official "section 45L(c)(1)(B): a dwelling unit certified as a zero energy ready home under the Department of Energy program as in effect on January 1, 2023 (or a successor program determined by the Secretary)";
}
@source(IRC_S45L_C, relation = formalizes, coverage = exact, quote = "such dwelling unit is certified as a zero energy ready home under the zero energy ready home program of the Department of Energy as in effect on January 1, 2023")
rule ZeroEnergyReadyRequirementMet2023Rule(unit: Asset) strict {
    when certified_zero_energy_ready_home_2023_program_45l(unit);
    then zero_energy_ready_requirement_met_45l(unit);
}
rule ZeroEnergyReadyRequirementMetSuccessorRule(unit: Asset) defeasible {
    when certified_under_successor_program_45l(unit);
    when secretary_determines_successor_program_45l(unit);
    then zero_energy_ready_requirement_met_45l(unit);
}

// --- (c)(2)-(3): Energy Star requirements -----------------------------------------------------------------------------------------------------------------------

pub relation unit_type_45l_c(unit: Asset, kind: UnitType45L) kind empirical {
    label en official "the type of the dwelling unit: single-family, manufactured home, or multifamily dwelling (section 45L(c)(2)-(3)) — case-asserted";
}
pub relation acquisition_year_45l(unit: Asset, year: Decimal) kind empirical {
    label en official "the calendar year in which the dwelling unit is acquired — case-asserted";
}
pub relation meets_energy_star_sf_national_version_45l(unit: Asset, version: Decimal) kind empirical {
    label en official "the dwelling unit meets the Energy Star Single-Family New Homes National Program Requirements of this version (3.1 or 3.2) (section 45L(c)(2)(A)(i)) — case-asserted";
}
pub relation meets_requirements_in_effect_on_january_1_of_45l(unit: Asset, program: UnitType45L, year: Decimal) kind empirical {
    label en official "the dwelling unit meets the most recent Energy Star program requirements applicable to its location (regional for single-family and multifamily; national for a manufactured home; national for multifamily) as in effect on January 1 of this year (section 45L(c)(2)-(3)) — case-asserted";
}
pub relation meets_multifamily_national_requirements_in_effect_on_january_1_of_45l(unit: Asset, year: Decimal) kind empirical {
    label en official "the dwelling unit meets the most recent Energy Star Multifamily New Construction National Program Requirements as in effect on January 1 of this year (section 45L(c)(3)(A)) — case-asserted";
}
pub relation reference_year_two_years_45l(unit: Asset, year: Decimal) kind institutional {
    label en official "sections 45L(c)(2)(A)(ii), (B): the later of 2023 and the year 2 calendar years before the year of acquisition (the January 1 on which the program requirements are read)";
}
@source(IRC_S45L_C, relation = formalizes, coverage = exact, quote = "as in effect on the latter of January 1, 2023, or January 1 of two calendar years prior to the date the dwelling unit was acquired")
rule ReferenceYearTwoYearsLaterRule(unit: Asset, acq: Decimal) strict {
    when acquisition_year_45l(unit, acq);
    when acq - 2.0 >= 2023.0;
    then reference_year_two_years_45l(unit, acq - 2.0);
}
rule ReferenceYearTwoYears2023Rule(unit: Asset, acq: Decimal) strict {
    when acquisition_year_45l(unit, acq);
    when acq - 2.0 < 2023.0;
    then reference_year_two_years_45l(unit, 2023.0);
}
pub relation reference_year_three_years_45l(unit: Asset, year: Decimal) kind institutional {
    label en official "section 45L(c)(3): the later of 2023 and the year 3 calendar years before the year of acquisition";
}
@source(IRC_S45L_C, relation = formalizes, coverage = exact, quote = "as in effect on either January 1, 2023, or January 1 of three calendar years prior to the date the dwelling was acquired, whichever is later")
rule ReferenceYearThreeYearsLaterRule(unit: Asset, acq: Decimal) strict {
    when acquisition_year_45l(unit, acq);
    when acq - 3.0 >= 2023.0;
    then reference_year_three_years_45l(unit, acq - 3.0);
}
rule ReferenceYearThreeYears2023Rule(unit: Asset, acq: Decimal) strict {
    when acquisition_year_45l(unit, acq);
    when acq - 3.0 < 2023.0;
    then reference_year_three_years_45l(unit, 2023.0);
}
pub relation energy_star_requirement_met_45l(unit: Asset) kind institutional {
    label en official "section 45L(c)(2)-(3): a single-family dwelling meeting the Energy Star National Program Requirements version 3.1 (acquired before 2025) or 3.2 (acquired after 2024) and the regional requirements; a manufactured home meeting the Energy Star Manufactured Home National requirements; or a multifamily dwelling meeting the multifamily national and regional requirements, each as in effect on the reference January 1";
}
@source(IRC_S45L_C, relation = formalizes, coverage = exact, quote = "in the case of a dwelling unit acquired before January 1, 2025, the Energy Star Single-Family New Homes National Program Requirements 3.1")
rule EnergyStarSingleFamilyBefore2025Rule(unit: Asset, acq: Decimal, ref: Decimal) strict {
    when unit_type_45l_c(unit, SingleFamily);
    when acquisition_year_45l(unit, acq);
    when acq < 2025.0;
    when meets_energy_star_sf_national_version_45l(unit, 3.1);
    when reference_year_two_years_45l(unit, ref);
    when meets_requirements_in_effect_on_january_1_of_45l(unit, SingleFamily, ref);
    then energy_star_requirement_met_45l(unit);
}
@source(IRC_S45L_C, relation = formalizes, coverage = exact, quote = "in the case of a dwelling unit acquired after December 31, 2024, the Energy Star Single-Family New Homes National Program Requirements 3.2")
rule EnergyStarSingleFamilyAfter2024Rule(unit: Asset, acq: Decimal, ref: Decimal) strict {
    when unit_type_45l_c(unit, SingleFamily);
    when acquisition_year_45l(unit, acq);
    when acq >= 2025.0;
    when meets_energy_star_sf_national_version_45l(unit, 3.2);
    when reference_year_two_years_45l(unit, ref);
    when meets_requirements_in_effect_on_january_1_of_45l(unit, SingleFamily, ref);
    then energy_star_requirement_met_45l(unit);
}
@source(IRC_S45L_C, relation = formalizes, coverage = exact, quote = "such dwelling unit meets the most recent Energy Star Manufactured Home National program requirements")
rule EnergyStarManufacturedHomeRule(unit: Asset, ref: Decimal) strict {
    when unit_type_45l_c(unit, ManufacturedHome);
    when reference_year_two_years_45l(unit, ref);
    when meets_requirements_in_effect_on_january_1_of_45l(unit, ManufacturedHome, ref);
    then energy_star_requirement_met_45l(unit);
}
@source(IRC_S45L_C, relation = formalizes, coverage = exact, quote = "such dwelling unit meets the most recent Energy Star Multifamily New Construction National Program Requirements")
rule EnergyStarMultifamilyRule(unit: Asset, ref: Decimal) strict {
    when unit_type_45l_c(unit, MultifamilyDwelling);
    when reference_year_three_years_45l(unit, ref);
    when meets_multifamily_national_requirements_in_effect_on_january_1_of_45l(unit, ref);
    when meets_requirements_in_effect_on_january_1_of_45l(unit, MultifamilyDwelling, ref);
    then energy_star_requirement_met_45l(unit);
}
pub relation energy_saving_requirements_met_defined_45l(unit: Asset) kind institutional {
    label en official "section 45L(c)(1): a dwelling unit meets the requirements if it meets the Energy Star requirements of paragraph (2) or (3), or is certified as a zero energy ready home";
}
rule EnergySavingRequirementsMetDefinedEnergyStarRule(unit: Asset) strict {
    when energy_star_requirement_met_45l(unit);
    then energy_saving_requirements_met_defined_45l(unit);
}
rule EnergySavingRequirementsMetDefinedZeroEnergyRule(unit: Asset) defeasible {
    when zero_energy_ready_requirement_met_45l(unit);
    then energy_saving_requirements_met_defined_45l(unit);
}

// --- (d)(2): the certification form -------------------------------------------------------------------------------------------------------------------------------

pub relation certification_in_writing_45l(unit: Asset) kind empirical {
    label en official "the certification is made in writing (section 45L(d)(2)) — case-asserted";
}
pub relation certification_specifies_components_and_ratings_45l(unit: Asset) kind empirical {
    label en official "the certification specifies in readily verifiable fashion the energy efficient building envelope components and energy efficient heating or cooling equipment installed and their respective rated energy efficiency performance (section 45L(d)(2)) — case-asserted";
}
pub relation certification_form_met_45l(unit: Asset) kind institutional {
    label en official "section 45L(d)(2): a certification described in subsection (c) is made in writing and specifies in readily verifiable fashion the components and equipment installed and their rated energy efficiency performance";
}
@source(IRC_S45L_D, relation = formalizes, coverage = exact, quote = "shall be made in writing in a manner which specifies in readily verifiable fashion the energy efficient building envelope components and energy efficient heating or cooling equipment installed and their respective rated energy efficiency performance")
rule CertificationFormMetRule(unit: Asset) strict {
    when certification_in_writing_45l(unit);
    when certification_specifies_components_and_ratings_45l(unit);
    then certification_form_met_45l(unit);
}

// --- (e): the basis ---------------------------------------------------------------------------------------------------------------------------------------------------

pub relation basis_increase_from_expenditure_45l(contractor: Person, unit: Asset, amount: Money) kind empirical {
    label en official "the increase in the basis of the property that would, but for subsection (e), result from the expenditure — case-asserted";
}
pub relation credit_determined_for_expenditure_45l(contractor: Person, unit: Asset, amount: Money) kind empirical {
    label en official "the credit determined under section 45L in connection with the expenditure — case-asserted";
}
pub relation basis_increase_after_credit_45l(contractor: Person, unit: Asset, amount: Money) kind institutional {
    label en official "section 45L(e): the increase in the basis of the property is reduced by the credit determined (not below zero)";
}
@source(IRC_S45L_E, relation = formalizes, coverage = exact, quote = "the increase in the basis of such property which would (but for this subsection) result from such expenditure shall be reduced by the amount of the credit so determined")
rule BasisIncreaseAfterCredit45lRule(contractor: Person, unit: Asset, increase: Money, credit: Money) strict {
    when basis_increase_from_expenditure_45l(contractor, unit, increase);
    when credit_determined_for_expenditure_45l(contractor, unit, credit);
    then basis_increase_after_credit_45l(contractor, unit, max(increase - credit, 0 USD));
}
pub relation adjusted_basis_of_building_under_42_45l(building: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the building under section 42 without the section 45L(e) reduction — case-asserted";
}
pub relation basis_for_section_42_unreduced_45l(building: Asset, amount: Money) kind institutional {
    label en official "section 45L(e), last sentence: the basis reduction does not apply for determining the adjusted basis of any building under section 42";
}
@source(IRC_S45L_E, relation = formalizes, coverage = exact, quote = "This subsection shall not apply for purposes of determining the adjusted basis of any building under section 42.")
rule BasisForSection42UnreducedRule(building: Asset, amount: Money) strict {
    when adjusted_basis_of_building_under_42_45l(building, amount);
    then basis_for_section_42_unreduced_45l(building, amount);
}

// --- (g)(2)(A): the prevailing wage requirement --------------------------------------------------------------------------------------------------------------

pub relation wages_at_least_prevailing_for_construction_45l(unit: Asset) kind empirical {
    label en official "laborers and mechanics employed by the taxpayer or any contractor or subcontractor in the construction of the residence are paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality, as most recently determined by the Secretary of Labor (section 45L(g)(2)(A)) — case-asserted";
}
pub relation prevailing_wage_requirement_met_45l(unit: Asset) kind institutional {
    label en official "section 45L(g)(2)(A): prevailing wages are paid in the construction of the qualified residence";
}
@source(IRC_S45L_G, relation = formalizes, coverage = exact, quote = "shall be paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality in which such residence is located")
rule PrevailingWageRequirementMet45lRule(unit: Asset) strict {
    when wages_at_least_prevailing_for_construction_45l(unit);
    then prevailing_wage_requirement_met_45l(unit);
}
