// Section 45H — Credit for production of low sulfur diesel fuel. Stage 2d
// (IRC-06, DECISION-0379).
//
// Scope / judgment calls:
// * (a): 5 cents per gallon of low sulfur diesel fuel produced at a facility of
//   a small business refiner. (b): the aggregate credit per facility is limited
//   to a percentage (25, reduced for refiners above 155,000 barrels of
//   average daily runs in 2002 by the ratio of the excess to 50,000) of the
//   qualified costs, less the credits of prior years for the facility.
// * (c)(1): small business refiner: at most 1,500 individuals engaged in
//   refinery operations and average daily runs for 2002 at most 205,000
//   barrels (both case facts). The qualified costs, EPA regulation and
//   April 1, 2003 refinery rules are case facts (TECH-GAPS G1542).
// * (e): the credit requires the Secretary's certification obtained within 30
//   months after the first day of the first taxable year for which the credit
//   is determined; the Secretary must decide within 60 days of the application
//   (a duty) and the taxpayer may presume issuance if the Secretary does not
//   notify within 60 days.
// * (f): a cooperative may elect to apportion the credit to patrons (a power,
//   effect only on the organisation side; patron inclusion not modelled);
//   (g): the election not to apply the credit is a power.

use self::{
    Asset,
    IRC_S45H_A,
    IRC_S45H_B,
    IRC_S45H_C,
    IRC_S45H_E,
    IRC_S45H_F,
    IRC_S45H_G,
    Person,
    TaxableYear,
};

pub relation individuals_engaged_in_refinery_operations_45h(taxpayer: Person, y: TaxableYear, count: Decimal) kind empirical {
    label en official "the maximum number of individuals engaged in the refinery operations of the business on any day during the taxable year (section 45H(c)(1)(A)) — case-asserted";
}
pub relation average_daily_refinery_run_2002_45h(taxpayer: Person, barrels: Decimal) kind empirical {
    label en official "the average daily domestic refinery run or average retained production for all facilities of the taxpayer for the 1-year period ending on December 31, 2002, in barrels (sections 45H(b)(2), (c)(1)(B)) — case-asserted";
}
pub relation low_sulfur_diesel_gallons_45h(taxpayer: Person, facility: Asset, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of low sulfur diesel fuel (15 parts per million sulfur or less) produced at the facility during the taxable year (sections 45H(a), (c)(5)) — case-asserted";
}
pub relation qualified_costs_45h(taxpayer: Person, facility: Asset, amount: Money) kind empirical {
    label en official "the qualified costs incurred with respect to the facility for compliance with the applicable EPA regulations during the applicable period (section 45H(c)(2)) — case-asserted";
}
pub relation prior_year_credits_for_facility_45h(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate credits determined under this section for all prior taxable years for the facility (section 45H(b)(1)(B)) — case-asserted";
}
pub relation elects_out_of_section_45h(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's exercise of the section 45H(g) election not to have subsection (a) apply for the taxable year";
}
pub relation section_45h_does_not_apply(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45H(g): no credit for the taxable year (a valid election)";
}
pub relation small_business_refiner_45h(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45H(c)(1): a refiner of crude oil with at most 1,500 individuals engaged in refinery operations and 2002 average daily runs of at most 205,000 barrels";
}
@source(IRC_S45H_C, quote = "not more than 1,500 individuals are engaged in the refinery operations of the business on any day during such taxable year")
rule SmallBusinessRefiner45hRule(taxpayer: Person, y: TaxableYear, people: Decimal, runs: Decimal) strict {
    when individuals_engaged_in_refinery_operations_45h(taxpayer, y, people);
    when people <= 1500.0;
    when average_daily_refinery_run_2002_45h(taxpayer, runs);
    when runs <= 205000.0;
    then small_business_refiner_45h(taxpayer, y);
}
@source(IRC_S45H_G, quote = "No credit shall be determined under subsection (a) for the taxable year if the taxpayer elects not to have subsection (a) apply to such taxable year.")
rule ElectOutOf45hRule(taxpayer: Person, y: TaxableYear) strict {
    when small_business_refiner_45h(taxpayer, y);
    then power Section45hGElectOut {
        holder taxpayer;
        over taxpayer;
        exercise elects_out_of_section_45h(taxpayer, y);
        valid_when small_business_refiner_45h(taxpayer, y);
        effect create(section_45h_does_not_apply(taxpayer, y));
        window [@2004-10-22, infinity);
    };
}

// --- (e): certification --------------------------------------------------------------------

pub relation first_credit_year_begins_45h(facility: Asset, on: Date) kind empirical {
    label en official "the first day of the first taxable year in which the credit is determined with respect to the facility — case-asserted";
}
pub relation certification_issued_on_45h(facility: Asset, on: Date) kind empirical {
    label en official "the date the Secretary, after consultation with the EPA Administrator, certifies that the qualified costs are necessary for compliance — case-asserted";
}
pub relation certification_application_received_45h(facility: Asset, applicant: Person, on: Date) kind empirical {
    label en official "the date the Secretary receives the application for certification — case-asserted";
}
pub relation secretary_notified_certification_result_45h(facility: Asset) kind empirical {
    label en official "the Secretary notified the taxpayer of the result of the certification review — case-asserted";
}
pub relation reading_date_45h(on: Date) kind empirical {
    label en official "the date as of which the 60-day presumption is read — case-asserted";
}
pub relation certification_timely_45h(facility: Asset) kind institutional {
    label en official "section 45H(e)(1), (e)(3): a certification (issued, or presumed issued after 60 days without notice) obtained not later than 30 months after the first day of the first credit year";
}
@source(IRC_S45H_E, quote = "not later than the date which is 30 months after the first day of the first taxable year in which the low sulfur diesel fuel production credit is determined with respect to a facility")
rule CertificationTimelyIssued45hRule(facility: Asset, issued: Date, first_day: Date) strict {
    when certification_issued_on_45h(facility, issued);
    when first_credit_year_begins_45h(facility, first_day);
    when issued <= add_calendar_period(first_day, 30 calendar_month);
    then certification_timely_45h(facility);
}
@source(IRC_S45H_E, quote = "In the event the Secretary does not notify the taxpayer of the results of such certification within such period, the taxpayer may presume the certification to be issued until so notified.")
rule CertificationTimelyPresumed45hRule(facility: Asset, applicant: Person, received: Date, first_day: Date, asof: Date) strict {
    when certification_application_received_45h(facility, applicant, received);
    when reading_date_45h(asof);
    when asof > add_calendar_period(received, 60 calendar_day);
    when not_known(secretary_notified_certification_result_45h(facility));
    when first_credit_year_begins_45h(facility, first_day);
    when add_calendar_period(received, 60 calendar_day) <= add_calendar_period(first_day, 30 calendar_month);
    then certification_timely_45h(facility);
}
@source(IRC_S45H_E, quote = "Any application shall be reviewed and notice of certification, if applicable, shall be made within 60 days of receipt of such application.")
rule Section45hE3ReviewDutyRule(facility: Asset, applicant: Person, received: Date) strict {
    when certification_application_received_45h(facility, applicant, received);
    then duty Section45hE3ReviewDuty {
        bearer us.irc.core::Secretary;
        beneficiary applicant;
        goal achievement {
            condition secretary_notified_certification_result_45h(facility);
            window [received, add_calendar_period(received, 60 calendar_day)];
        }
    };
}

// --- (b): per-facility limitation --------------------------------------------------------------

pub relation limitation_percentage_points_45h(taxpayer: Person, points: Decimal) kind institutional {
    label en official "section 45H(b)(1)(A), (b)(2): 25 percentage points, reduced for 2002 average daily runs above 155,000 barrels by the ratio of the excess to 50,000 barrels (not below zero)";
}
@source(IRC_S45H_B, quote = "in excess of 155,000 barrels, the number of percentage points described in paragraph (1) shall be reduced (not below zero) by the product of such number (before the application of this paragraph) and the ratio of such excess to 50,000 barrels")
rule LimitationPointsReduced45hRule(taxpayer: Person, runs: Decimal) strict {
    when average_daily_refinery_run_2002_45h(taxpayer, runs);
    when runs > 155000.0;
    then limitation_percentage_points_45h(taxpayer, max(0.0, 25.0 - 25.0 * div_round(runs - 155000.0, 50000.0, 10, "HALF_UP")));
}
@source(IRC_S45H_B, quote = "25 percent of the qualified costs incurred by the small business refiner with respect to such facility")
rule LimitationPointsFull45hRule(taxpayer: Person, runs: Decimal) strict {
    when average_daily_refinery_run_2002_45h(taxpayer, runs);
    when runs <= 155000.0;
    then limitation_percentage_points_45h(taxpayer, 25.0);
}
pub relation facility_credit_limit_45h(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45H(b)(1): the percentage of qualified costs less the credits of prior years for the facility";
}
rule FacilityCreditLimit45hRule(taxpayer: Person, facility: Asset, y: TaxableYear, points: Decimal, costs: Money, prior: Money) strict {
    when limitation_percentage_points_45h(taxpayer, points);
    when qualified_costs_45h(taxpayer, facility, costs);
    when prior_year_credits_for_facility_45h(taxpayer, facility, y, prior);
    then facility_credit_limit_45h(taxpayer, facility, y, max(0 USD, round(div_round(points, 100.0, 10, "HALF_UP") * costs, 2, "HALF_UP") - prior));
}

// --- (a): the credit ----------------------------------------------------------------------------

pub relation low_sulfur_diesel_credit_per_facility_45h(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45H(a): 5 cents per gallon produced at the facility, within the (b) limit";
}
@source(IRC_S45H_A, quote = "5 cents for each gallon of low sulfur diesel fuel produced during the taxable year by such small business refiner at such facility")
rule LowSulfurDieselCreditPerFacility45hRule(taxpayer: Person, facility: Asset, y: TaxableYear, gallons: Decimal, limit: Money) defeasible {
    when small_business_refiner_45h(taxpayer, y);
    when certification_timely_45h(facility);
    when low_sulfur_diesel_gallons_45h(taxpayer, facility, y, gallons);
    when facility_credit_limit_45h(taxpayer, facility, y, limit);
    when not_known(section_45h_does_not_apply(taxpayer, y));
    then low_sulfur_diesel_credit_per_facility_45h(taxpayer, facility, y, min(round(0.05 * gallons, 2, "HALF_UP") * 1 USD, limit));
}
pub relation low_sulfur_diesel_fuel_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45H low sulfur diesel fuel production credit for the taxable year (a section 38(b)(18) component)";
}
rule LowSulfurDieselFuelProductionCredit45hRule(taxpayer: Person, y: TaxableYear, facility: Asset, amount: Money) defeasible {
    when low_sulfur_diesel_credit_per_facility_45h(taxpayer, facility, y, amount);
    then low_sulfur_diesel_fuel_production_credit(taxpayer, y,
        sum(collect all a: Money, f: Asset where low_sulfur_diesel_credit_per_facility_45h(taxpayer, f, y, a), empty: 0 USD));
}

// --- (f): cooperative apportionment to patrons ---------------------------------------------------

pub relation cooperative_organization_1381a_45h(organization: Person) kind empirical {
    label en official "the organization is a cooperative organization described in section 1381(a) — case-asserted";
}
pub relation elects_to_apportion_credit_to_patrons_45h(organization: Person, y: TaxableYear) kind empirical {
    label en official "the cooperative's exercise of the section 45H(f)(1)(A) election to apportion the credit among patrons — made on a timely filed return, irrevocable for the year";
}
pub relation credit_apportioned_to_patrons_45h(organization: Person, y: TaxableYear) kind institutional {
    label en official "section 45H(f)(1): the credit (or a portion) is apportioned among patrons eligible to share in patronage dividends";
}
@source(IRC_S45H_F, quote = "any portion of the credit determined under subsection (a) for the taxable year may, at the election of the organization, be apportioned among patrons")
rule ApportionToPatrons45hRule(organization: Person, y: TaxableYear) strict {
    when cooperative_organization_1381a_45h(organization);
    when elects_to_apportion_credit_to_patrons_45h(organization, y);
    then power Section45hF1Apportionment {
        holder organization;
        over organization;
        exercise elects_to_apportion_credit_to_patrons_45h(organization, y);
        valid_when cooperative_organization_1381a_45h(organization);
        effect create(credit_apportioned_to_patrons_45h(organization, y));
        window [@2004-10-22, infinity);
    };
}
