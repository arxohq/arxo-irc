// Stage 3 (TECH_GAP reduction): section 51(f)(1)-(2) (remuneration counts only if more than
// one-half of it is for services in the employer's trade or business) and 51(k)(2) (no credit for
// services performed for another person unless the amount reasonably expected from that person
// exceeds the remuneration paid).
// The two component rules of 51-work-opportunity-credit.law carry the guard
// `not_known(remuneration_disqualified_51fk(...))`.
// 51(f)(2): the determination is made without regard to section 52(a), (b): the share below is
// the share of the individual employer's own remuneration, not of an aggregated group's.
// NOT MODELLED: 51(k)(1) (successor employers) and 51(h): see TECH-GAPS.
// STATUS: implemented_unverified (static check only).

use self::{
    IRC_S51_F,
    IRC_S51_K,
    Individual,
    Person,
    TaxableYear,
};

pub relation share_of_remuneration_for_trade_or_business_51f(employee: Individual, employer: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the fraction of the remuneration paid by the employer to the employee during the year that is for services performed in a trade or business of the employer (section 51(f)(1)), determined without regard to section 52(a), (b) (section 51(f)(2)) — case-asserted";
}
pub relation services_performed_for_another_person_51k2(employee: Individual, employer: Person, y: TaxableYear) kind empirical {
    label en official "section 51(k)(2): the services were performed by the employee for another person — case-asserted";
}
pub relation amount_expected_from_other_person_51k2(employee: Individual, employer: Person, y: TaxableYear, expected: Money) kind empirical {
    label en official "section 51(k)(2): the amount reasonably expected to be received by the employer for the services from the other person — case-asserted";
}
pub relation remuneration_paid_for_services_to_other_person_51k2(employee: Individual, employer: Person, y: TaxableYear, paid: Money) kind empirical {
    label en official "section 51(k)(2): the remuneration paid by the employer to the employee for the services performed for the other person — case-asserted";
}
pub relation remuneration_disqualified_51fk(employee: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "sections 51(f)(1), 51(k)(2): the remuneration is not taken into account, or no credit is determined for it";
}
@source(IRC_S51_F, relation = formalizes, coverage = exact, quote = "remuneration paid by an employer to an employee during any taxable year shall be taken into account only if more than one-half of the remuneration so paid is for services performed in a trade or business of the employer.")
rule RemunerationDisqualified51f1Rule(employee: Individual, employer: Person, y: TaxableYear, share: Decimal) strict {
    label en official "section 51(f)(1): one-half or less of the remuneration is for the trade or business";
    when share_of_remuneration_for_trade_or_business_51f(employee, employer, y, share);
    when share <= 0.5;
    then remuneration_disqualified_51fk(employee, employer, y);
}
@source(IRC_S51_K, relation = formalizes, coverage = exact, quote = "No credit shall be determined under this section with respect to remuneration paid by an employer to an employee for services performed by such employee for another person unless the amount reasonably expected to be received by the employer for such services from such other person exceeds the remuneration paid by the employer to such employee for such services.")
rule RemunerationDisqualified51k2Rule(employee: Individual, employer: Person, y: TaxableYear, expected: Money, paid: Money) strict {
    label en official "section 51(k)(2): the expected receipts from the other person do not exceed the remuneration paid";
    when services_performed_for_another_person_51k2(employee, employer, y);
    when amount_expected_from_other_person_51k2(employee, employer, y, expected);
    when remuneration_paid_for_services_to_other_person_51k2(employee, employer, y, paid);
    when expected <= paid;
    then remuneration_disqualified_51fk(employee, employer, y);
}
