// Section 45Z — Clean fuel production credit. Stage 2d (IRC-06, DECISION-0379).
//
// Editions by `legal_time` (`effective` windows; PL 119-21 section 70521 is
// pinned as `us.irc.temporal::PL119_21_S70521`, enacted 2025-07-04; the
// windows are used instead of a `revision` because the temporal package pins
// the Public Law as separate fragments):
//   * base text: the credit ends for fuel sold after 2027-12-31; sustainable
//     aviation fuel gets 35 cents / $1.75; emissions rates may be negative;
//   * from 2025-07-04: the end is 2029-12-31; the SAF special rate is removed
//     and emissions rates may not be below zero (animal manure excepted) for
//     fuel produced after 2025-12-31; fuel produced after 2025-12-31 must be
//     exclusively derived from feedstock of the United States, Mexico or
//     Canada; no fuel produced from a fuel for which the credit is allowable;
//     specified foreign entities and foreign-influenced entities are barred.
//
// Scope / judgment calls:
// * (a)(1): the applicable amount per gallon times the gallons produced at a
//   qualified facility and sold as described, times the emissions factor
//   ((50 - emissions rate) / 50, rounded to the nearest 0.1); 20 cents, or
//   $1.00 when the (f)(6)-(7) prevailing wage and apprenticeship rules are
//   met; both amounts indexed for calendar years after 2024 and rounded to the
//   cent. The credit is rounded to the cent ((a)(5)); this reads the rounding
//   at the credit level (TECH-GAPS G1725).
// * (d)(4): a qualified facility is used for transportation fuel production
//   and has no credit under section 45V, the section 48(a)(15) hydrogen
//   election, or section 45Q (one case fact). (d)(5): transportation fuel is
//   suitable for a highway vehicle or aircraft, has an emissions rate of at
//   most 50, is not coprocessed with non-biomass feedstock.
// * (f)(1): registration under section 4101, SAF certification, produced in the
//   United States (or a possession). Emissions rates come from the Secretary
//   table (case-asserted).

use self::{
    Asset,
    IRC_S45Z_A,
    IRC_S45Z_B,
    IRC_S45Z_C,
    IRC_S45Z_D,
    IRC_S45Z_E,
    IRC_S45Z_F,
    IRC_S45Z_G,
    Person,
    TaxableYear,
};

pub relation transportation_fuel_gallons_sold_45z(taxpayer: Person, fuel: Asset, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons (or gallon equivalents) of the transportation fuel produced by the taxpayer at a qualified facility and sold in a manner described in section 45Z(a)(4) during the taxable year — case-asserted";
}
pub relation fuel_produced_on_45z(fuel: Asset, on: Date) kind empirical {
    label en official "the date the fuel is produced — case-asserted";
}
pub relation fuel_sold_on_45z(fuel: Asset, on: Date) kind empirical {
    label en official "the date the fuel is sold — case-asserted";
}
pub relation fuel_facility_45z(fuel: Asset, facility: Asset) kind empirical {
    label en official "the qualified facility at which the fuel is produced — case-asserted";
}
pub relation fuel_sold_to_unrelated_person_in_described_manner_45z(fuel: Asset) kind empirical {
    label en official "the fuel is sold to an unrelated person for use in a fuel mixture, in a trade or business, or at retail into a fuel tank (section 45Z(a)(4)) — case-asserted";
}
pub relation fuel_emissions_rate_45z(fuel: Asset, kg_co2e_per_mmbtu: Decimal) kind empirical {
    label en official "the emissions rate of the fuel from the Secretary table, in kilograms of CO2e per mmBTU (section 45Z(b)(1)(B)) — case-asserted";
}
pub relation fuel_suitable_for_highway_vehicle_or_aircraft_45z(fuel: Asset) kind empirical {
    label en official "the fuel is suitable for use as a fuel in a highway vehicle or aircraft (section 45Z(d)(5)(A)(i)) — case-asserted";
}
pub relation fuel_coprocessed_with_non_biomass_45z(fuel: Asset) kind empirical {
    label en official "the fuel is derived from coprocessing an applicable material with a feedstock which is not biomass (section 45Z(d)(5)(A)(iii)) — case-asserted";
}
pub relation fuel_produced_from_credited_fuel_45z(fuel: Asset) kind empirical {
    label en official "the fuel is produced from a fuel for which a credit under section 45Z is allowable (section 45Z(d)(5)(A)(iv), PL 119-21) — case-asserted";
}
pub relation fuel_derived_exclusively_from_us_mexico_canada_feedstock_45z(fuel: Asset) kind empirical {
    label en official "the fuel is exclusively derived from a feedstock produced or grown in the United States, Mexico, or Canada (section 45Z(f)(1)(A)(iii), PL 119-21) — case-asserted";
}
pub relation fuel_produced_in_united_states_45z(fuel: Asset) kind empirical {
    label en official "the fuel is produced in the United States, including any possession (section 45Z(f)(1)(A)(ii), (f)(1)(B)) — case-asserted";
}
pub relation fuel_animal_manure_derived_45z(fuel: Asset) kind empirical {
    label en official "the fuel is derived from animal manure (section 45Z(b)(1)(B)(v), PL 119-21) — case-asserted";
}
pub relation fuel_saf_facts_45z(fuel: Asset) kind empirical {
    label en official "the liquid fuel, the portion of which is not kerosene, is sold for use in an aircraft, meets ASTM D7566 or the Fischer Tropsch provisions of D1655 Annex A1, and is not derived from palm fatty acid distillates or petroleum (section 45Z(a)(3)) — case-asserted";
}
pub relation facility_used_for_transportation_fuel_45z(facility: Asset) kind empirical {
    label en official "the facility is used for the production of transportation fuels (section 45Z(d)(4)(A)) — case-asserted";
}
pub relation facility_has_excluded_credit_45z(facility: Asset, y: TaxableYear) kind empirical {
    label en official "a credit under section 45V, the section 48(a)(15)-elected energy credit, or section 45Q is allowed for the facility for the taxable year (section 45Z(d)(4)(B)) — case-asserted";
}
pub relation producer_registered_under_4101_45z(taxpayer: Person) kind empirical {
    label en official "the taxpayer is registered as a producer of clean fuel under section 4101 at the time of production (section 45Z(f)(1)(A)(i)(I)) — case-asserted";
}
pub relation saf_certification_provided_45z(taxpayer: Person, fuel: Asset) kind empirical {
    label en official "for a sustainable aviation fuel, the taxpayer provides the unrelated-party certification of compliance and the other information the Secretary requires (section 45Z(f)(1)(A)(i)(II)) — case-asserted";
}
pub relation prevailing_wage_and_apprenticeship_satisfied_45z(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the section 45Z(f)(6)-(7) prevailing wage and apprenticeship requirements are satisfied for the facility — case-asserted";
}
pub relation inflation_adjustment_factor_45z(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor of section 45Y(c) with calendar year 2022 substituted for 1992, for the calendar year in which the fuel is sold (section 45Z(c)(2)) — case-asserted, not pinned";
}
pub relation specified_foreign_entity_45z(taxpayer: Person) kind empirical {
    label en official "the taxpayer is a specified foreign entity as defined in section 7701(a)(51)(B) — case-asserted";
}
pub relation foreign_influenced_entity_45z(taxpayer: Person) kind empirical {
    label en official "the taxpayer is a foreign-influenced entity as defined in section 7701(a)(51)(D), without regard to clause (i)(II) — case-asserted";
}
pub relation paragraph_f8_enacted_on_45z(on: Date) kind empirical {
    label en official "the date of enactment of section 45Z(f)(8) (PL 119-21, July 4, 2025) — case-asserted";
}

// --- (d)(5), (d)(4): transportation fuel and qualified facility -------------------------------------------------------

pub relation transportation_fuel_45z(fuel: Asset) kind institutional {
    label en official "section 45Z(d)(5): a fuel suitable for a highway vehicle or aircraft, with an emissions rate of at most 50 kg CO2e per mmBTU, not coprocessed with a non-biomass feedstock (and, from PL 119-21, not produced from a credited fuel)";
}
@source(IRC_S45Z_D, quote = "has an emissions rate which is not greater than 50 kilograms of CO2e per mmBTU")
rule TransportationFuelBase45zRule(fuel: Asset, rate: Decimal) strict {
    effective (-infinity, @2025-07-04);
    when fuel_suitable_for_highway_vehicle_or_aircraft_45z(fuel);
    when fuel_emissions_rate_45z(fuel, rate);
    when rate <= 50.0;
    when not_known(fuel_coprocessed_with_non_biomass_45z(fuel));
    then transportation_fuel_45z(fuel);
}
rule TransportationFuelAmended45zRule(fuel: Asset, rate: Decimal) strict {
    effective [@2025-07-04, infinity);
    when fuel_suitable_for_highway_vehicle_or_aircraft_45z(fuel);
    when fuel_emissions_rate_45z(fuel, rate);
    when rate <= 50.0;
    when not_known(fuel_coprocessed_with_non_biomass_45z(fuel));
    when not_known(fuel_produced_from_credited_fuel_45z(fuel));
    then transportation_fuel_45z(fuel);
}
pub relation qualified_facility_45z(facility: Asset, fuel: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Z(d)(4): a facility used for the production of transportation fuels with none of the excluded credits for the year";
}
@source(IRC_S45Z_D, quote = "means a facility used for the production of transportation fuels")
rule QualifiedFacility45zRule(facility: Asset, fuel: Asset, y: TaxableYear) strict {
    when fuel_facility_45z(fuel, facility);
    when transportation_fuel_gallons_sold_45z(_, fuel, y, _);
    when facility_used_for_transportation_fuel_45z(facility);
    when not_known(facility_has_excluded_credit_45z(facility, y));
    then qualified_facility_45z(facility, fuel, y);
}
relation sustainable_aviation_fuel_45z(fuel: Asset) kind institutional;
rule SustainableAviationFuel45zRule(fuel: Asset) strict {
    when fuel_saf_facts_45z(fuel);
    then sustainable_aviation_fuel_45z(fuel);
}

// --- (b): the emissions factor ------------------------------------------------------------------------------------------------

pub relation emissions_factor_45z(fuel: Asset, factor: Decimal) kind institutional {
    label en official "section 45Z(b): (50 - emissions rate) / 50, rounded to the nearest 0.1; from PL 119-21 the emissions rate may not be below zero for fuel produced after 2025-12-31 (animal manure excepted)";
}
@source(IRC_S45Z_B, quote = "If any amount determined under paragraph (1)(A) is not a multiple of 0.1, such amount shall be rounded to the nearest multiple of 0.1.")
rule EmissionsFactorProducedThrough2025Rule(fuel: Asset, rate: Decimal, produced: Date) strict {
    when fuel_emissions_rate_45z(fuel, rate);
    when fuel_produced_on_45z(fuel, produced);
    when produced <= @2025-12-31;
    then emissions_factor_45z(fuel, round(div_round(50.0 - rate, 50.0, 10, "HALF_UP"), 1, "HALF_UP"));
}
rule EmissionsFactorBeforeAmendmentRule(fuel: Asset, rate: Decimal, produced: Date) strict {
    effective (-infinity, @2025-07-04);
    when fuel_emissions_rate_45z(fuel, rate);
    when fuel_produced_on_45z(fuel, produced);
    when produced > @2025-12-31;
    then emissions_factor_45z(fuel, round(div_round(50.0 - rate, 50.0, 10, "HALF_UP"), 1, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70521, quote = "For purposes of this section, the emissions rate for a transportation fuel may not be less than zero.")
rule EmissionsFactorAmendedFlooredRule(fuel: Asset, rate: Decimal, produced: Date) strict {
    effective [@2025-07-04, infinity);
    when fuel_emissions_rate_45z(fuel, rate);
    when fuel_produced_on_45z(fuel, produced);
    when produced > @2025-12-31;
    when not_known(fuel_animal_manure_derived_45z(fuel));
    then emissions_factor_45z(fuel, round(div_round(50.0 - max(0.0, rate), 50.0, 10, "HALF_UP"), 1, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70521, quote = "notwithstanding subparagraph (E), may provide an emissions rate that is less than zero")
rule EmissionsFactorAmendedManureRule(fuel: Asset, rate: Decimal, produced: Date) strict {
    effective [@2025-07-04, infinity);
    when fuel_emissions_rate_45z(fuel, rate);
    when fuel_produced_on_45z(fuel, produced);
    when produced > @2025-12-31;
    when fuel_animal_manure_derived_45z(fuel);
    then emissions_factor_45z(fuel, round(div_round(50.0 - rate, 50.0, 10, "HALF_UP"), 1, "HALF_UP"));
}

// --- (a)(2)-(3), (c): the applicable amount per gallon ----------------------------------------------------------------------------

relation saf_special_rate_applies_45z(fuel: Asset) kind institutional;
@source(IRC_S45Z_A, quote = "by substituting \"35 cents\" for \"20 cents\"")
rule SafSpecialRateThrough2025Rule(fuel: Asset, produced: Date) strict {
    when sustainable_aviation_fuel_45z(fuel);
    when fuel_produced_on_45z(fuel, produced);
    when produced <= @2025-12-31;
    then saf_special_rate_applies_45z(fuel);
}
rule SafSpecialRateBeforeAmendmentRule(fuel: Asset, produced: Date) strict {
    effective (-infinity, @2025-07-04);
    when sustainable_aviation_fuel_45z(fuel);
    when fuel_produced_on_45z(fuel, produced);
    when produced > @2025-12-31;
    then saf_special_rate_applies_45z(fuel);
}
relation inflation_multiplier_45z(y: TaxableYear, multiplier: Decimal) kind institutional;
rule InflationMultiplierBefore2025Rule(y: TaxableYear, begin: Date) strict {
    when us.irc.core::begins(y, begin);
    when begin <= @2024-12-31;
    then inflation_multiplier_45z(y, 1.0);
}
@source(IRC_S45Z_C, quote = "In the case of calendar years beginning after 2024")
rule InflationMultiplierAfter2024Rule(y: TaxableYear, begin: Date, factor: Decimal) strict {
    when us.irc.core::begins(y, begin);
    when begin > @2024-12-31;
    when inflation_adjustment_factor_45z(y, factor);
    then inflation_multiplier_45z(y, factor);
}
pub relation base_amount_per_gallon_45z(fuel: Asset, y: TaxableYear, facility: Asset, dollars: Decimal) kind institutional {
    label en official "section 45Z(a)(2)-(3): 20 cents, or $1.00 with the wage and apprenticeship requirements; 35 cents / $1.75 for sustainable aviation fuel in the base text; before indexing";
}
@source(IRC_S45Z_A, quote = "the applicable amount shall be 20 cents")
rule BaseAmountStandardRule(fuel: Asset, y: TaxableYear, facility: Asset) defeasible {
    when fuel_facility_45z(fuel, facility);
    when transportation_fuel_gallons_sold_45z(_, fuel, y, _);
    when not_known(saf_special_rate_applies_45z(fuel));
    when not_known(prevailing_wage_and_apprenticeship_satisfied_45z(facility, y));
    then base_amount_per_gallon_45z(fuel, y, facility, 0.20);
}
@source(IRC_S45Z_A, quote = "the applicable amount shall be $1.00")
rule BaseAmountStandardWageRule(fuel: Asset, y: TaxableYear, facility: Asset) defeasible {
    when fuel_facility_45z(fuel, facility);
    when not_known(saf_special_rate_applies_45z(fuel));
    when prevailing_wage_and_apprenticeship_satisfied_45z(facility, y);
    then base_amount_per_gallon_45z(fuel, y, facility, 1.00);
}
rule BaseAmountSafRule(fuel: Asset, y: TaxableYear, facility: Asset) defeasible {
    when fuel_facility_45z(fuel, facility);
    when transportation_fuel_gallons_sold_45z(_, fuel, y, _);
    when saf_special_rate_applies_45z(fuel);
    when not_known(prevailing_wage_and_apprenticeship_satisfied_45z(facility, y));
    then base_amount_per_gallon_45z(fuel, y, facility, 0.35);
}
rule BaseAmountSafWageRule(fuel: Asset, y: TaxableYear, facility: Asset) defeasible {
    when fuel_facility_45z(fuel, facility);
    when saf_special_rate_applies_45z(fuel);
    when prevailing_wage_and_apprenticeship_satisfied_45z(facility, y);
    then base_amount_per_gallon_45z(fuel, y, facility, 1.75);
}

// --- (g): the end of the credit, base and PL 119-21 editions ---------------------------------------------------------------------------

pub relation sale_within_credit_period_45z(fuel: Asset) kind institutional {
    label en official "section 45Z(g): fuel sold through 2027-12-31 (2024 text); through 2029-12-31 under PL 119-21 section 70521(d) from its enactment";
}
@source(IRC_S45Z_G, quote = "This section shall not apply to transportation fuel sold after December 31, 2027.")
rule SaleWithinCreditPeriodBaseRule(fuel: Asset, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when fuel_sold_on_45z(fuel, on);
    when on <= @2027-12-31;
    then sale_within_credit_period_45z(fuel);
}
@source(us.irc.temporal::PL119_21_S70521, quote = "Section 45Z(g) is amended by striking “December 31, 2027” and inserting “December 31, 2029”.")
rule SaleWithinCreditPeriodAmendedRule(fuel: Asset, on: Date) strict {
    effective [@2025-07-04, infinity);
    when fuel_sold_on_45z(fuel, on);
    when on <= @2029-12-31;
    then sale_within_credit_period_45z(fuel);
}

// --- (f)(1), (f)(8): conditions on the taxpayer and the fuel -----------------------------------------------------------------------------------

relation feedstock_requirement_met_45z(fuel: Asset) kind institutional;
rule FeedstockRequirementThrough2025Rule(fuel: Asset, produced: Date) strict {
    when fuel_produced_on_45z(fuel, produced);
    when produced <= @2025-12-31;
    then feedstock_requirement_met_45z(fuel);
}
rule FeedstockRequirementBeforeAmendmentRule(fuel: Asset, produced: Date) strict {
    effective (-infinity, @2025-07-04);
    when fuel_produced_on_45z(fuel, produced);
    then feedstock_requirement_met_45z(fuel);
}
@source(us.irc.temporal::PL119_21_S70521, quote = "such fuel is exclusively derived from a feedstock which was produced or grown in the United States, Mexico, or Canada")
rule FeedstockRequirementAmendedRule(fuel: Asset, produced: Date) strict {
    effective [@2025-07-04, infinity);
    when fuel_produced_on_45z(fuel, produced);
    when produced > @2025-12-31;
    when fuel_derived_exclusively_from_us_mexico_canada_feedstock_45z(fuel);
    then feedstock_requirement_met_45z(fuel);
}
relation saf_certification_ok_45z(taxpayer: Person, fuel: Asset) kind institutional;
rule SafCertificationNotSaf45zRule(taxpayer: Person, fuel: Asset, y: TaxableYear, gallons: Decimal) strict {
    when transportation_fuel_gallons_sold_45z(taxpayer, fuel, y, gallons);
    when not_known(sustainable_aviation_fuel_45z(fuel));
    then saf_certification_ok_45z(taxpayer, fuel);
}
rule SafCertificationProvided45zRule(taxpayer: Person, fuel: Asset) strict {
    when sustainable_aviation_fuel_45z(fuel);
    when saf_certification_provided_45z(taxpayer, fuel);
    then saf_certification_ok_45z(taxpayer, fuel);
}
pub relation credit_conditions_met_45z(taxpayer: Person, fuel: Asset) kind institutional {
    label en official "section 45Z(f)(1): registered producer, produced in the United States, the SAF certification, and (from PL 119-21) the feedstock requirement";
}
@source(IRC_S45Z_F, quote = "is registered as a producer of clean fuel under section 4101 at the time of production")
rule CreditConditionsMet45zRule(taxpayer: Person, fuel: Asset) strict {
    when producer_registered_under_4101_45z(taxpayer);
    when fuel_produced_in_united_states_45z(fuel);
    when saf_certification_ok_45z(taxpayer, fuel);
    when feedstock_requirement_met_45z(fuel);
    then credit_conditions_met_45z(taxpayer, fuel);
}
pub relation taxpayer_allowed_45z(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45Z(f)(8) (PL 119-21): no credit for a year beginning after enactment if the taxpayer is a specified foreign entity, or 2 years after if a foreign-influenced entity";
}
rule TaxpayerAllowedBeforeEnactmentYearsRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    when producer_registered_under_4101_45z(taxpayer);
    when us.irc.core::begins(y, begin);
    when paragraph_f8_enacted_on_45z(enacted);
    when begin <= enacted;
    then taxpayer_allowed_45z(taxpayer, y);
}
rule TaxpayerAllowedBeforeAmendmentRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective (-infinity, @2025-07-04);
    when producer_registered_under_4101_45z(taxpayer);
    when us.irc.core::begins(y, begin);
    when paragraph_f8_enacted_on_45z(enacted);
    then taxpayer_allowed_45z(taxpayer, y);
}
@source(us.irc.temporal::PL119_21_S70521, quote = "No credit shall be determined under subsection (a) for any taxable year beginning after the date of enactment of this paragraph if the taxpayer is a specified foreign entity")
rule TaxpayerAllowedFirstTwoYearsRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective [@2025-07-04, infinity);
    when producer_registered_under_4101_45z(taxpayer);
    when us.irc.core::begins(y, begin);
    when paragraph_f8_enacted_on_45z(enacted);
    when begin > enacted;
    when begin <= add_calendar_period(enacted, 24 calendar_month);
    when not_known(specified_foreign_entity_45z(taxpayer));
    then taxpayer_allowed_45z(taxpayer, y);
}
@source(us.irc.temporal::PL119_21_S70521, quote = "No credit shall be determined under subsection (a) for any taxable year beginning after the date which is 2 years after the date of enactment of this paragraph if the taxpayer is a foreign-influenced entity")
rule TaxpayerAllowedLaterYearsRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective [@2025-07-04, infinity);
    when producer_registered_under_4101_45z(taxpayer);
    when us.irc.core::begins(y, begin);
    when paragraph_f8_enacted_on_45z(enacted);
    when begin > add_calendar_period(enacted, 24 calendar_month);
    when not_known(specified_foreign_entity_45z(taxpayer));
    when not_known(foreign_influenced_entity_45z(taxpayer));
    then taxpayer_allowed_45z(taxpayer, y);
}

// --- (a)(1): the credit ---------------------------------------------------------------------------------------------------------------------------

pub relation clean_fuel_credit_per_fuel_45z(taxpayer: Person, fuel: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45Z(a)(1): the (indexed) applicable amount per gallon times the gallons times the emissions factor, rounded to the cent";
}
@source(IRC_S45Z_A, quote = "the clean fuel production credit for any taxable year is an amount equal to the product of")
rule CleanFuelCreditPerFuel45zRule(taxpayer: Person, fuel: Asset, y: TaxableYear, facility: Asset, gallons: Decimal, base: Decimal, multiplier: Decimal, factor: Decimal) defeasible {
    when transportation_fuel_45z(fuel);
    when fuel_facility_45z(fuel, facility);
    when qualified_facility_45z(facility, fuel, y);
    when fuel_sold_to_unrelated_person_in_described_manner_45z(fuel);
    when sale_within_credit_period_45z(fuel);
    when credit_conditions_met_45z(taxpayer, fuel);
    when taxpayer_allowed_45z(taxpayer, y);
    when transportation_fuel_gallons_sold_45z(taxpayer, fuel, y, gallons);
    when base_amount_per_gallon_45z(fuel, y, facility, base);
    when inflation_multiplier_45z(y, multiplier);
    when emissions_factor_45z(fuel, factor);
    then clean_fuel_credit_per_fuel_45z(taxpayer, fuel, y, round(round(base * multiplier, 2, "HALF_UP") * gallons * factor, 2, "HALF_UP") * 1 USD);
}
pub relation clean_fuel_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45Z clean fuel production credit for the taxable year (a section 38(b)(40) component)";
}
rule CleanFuelProductionCredit45zRule(taxpayer: Person, y: TaxableYear, fuel: Asset, amount: Money) defeasible {
    when clean_fuel_credit_per_fuel_45z(taxpayer, fuel, y, amount);
    then clean_fuel_production_credit(taxpayer, y,
        sum(collect all a: Money, f: Asset where clean_fuel_credit_per_fuel_45z(taxpayer, f, y, a), empty: 0 USD));
}

// --- (e): the Secretary's guidance duty ---------------------------------------------------------------------------------------------------

pub relation section_45z_enacted_on(on: Date) kind empirical {
    label en official "the date of enactment of section 45Z — case-asserted from the pinned Public Law note (the reference date of the guidance duty)";
}
pub relation guidance_issued_45z(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary has issued guidance regarding implementation of section 45Z, including emissions factors, the section 45Z(b)(1)(B)(i) table and the determination of credits — case-asserted";
}
@source(IRC_S45Z_E, quote = "Not later than January 1, 2025, the Secretary shall issue guidance regarding implementation of this section")
rule Section45zEGuidanceDutyRule(on: Date) strict {
    when section_45z_enacted_on(on);
    then duty Section45zEGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition guidance_issued_45z(us.irc.core::Secretary);
            window [on, @2025-01-01];
        }
    };
}
