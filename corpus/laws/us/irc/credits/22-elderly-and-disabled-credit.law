// Section 22 — Credit for the elderly and the permanently and totally
// disabled. Stage 1 (IRC-06 stage 1).

// --- §22(b): qualified individual ----------------------------------------------

use self::{
    IRC_S22_A,
    IRC_S22_B,
    IRC_S22_C,
    IRC_S22_D,
    IRC_S22_E,
    Individual,
    TaxableYear,
};

pub relation elderly_or_disabled_qualified_individual(p: Individual, y: TaxableYear) kind institutional {
    label en official "a qualified individual for purposes of section 22 (section 22(b))";
}
relation attained_65_before_close(p: Individual, y: TaxableYear) kind empirical {
    label en official "has attained age 65 before the close of the taxable year (section 22(b)(1))";
}
relation retired_on_disability_permanently_and_totally(p: Individual, y: TaxableYear) kind empirical {
    label en official "retired on disability before the close of the taxable year and, when retired, was permanently and totally disabled (section 22(b)(2))";
}

@source(IRC_S22_B, quote = "who has attained age 65 before the close of the taxable year")
rule QualifiedIndividualAge65(p: Individual, y: TaxableYear) strict {
    label en official "an individual who has attained age 65 before the close of the taxable year is a qualified individual";
    when attained_65_before_close(p, y);
    then elderly_or_disabled_qualified_individual(p, y);
}
@source(IRC_S22_B, quote = "who retired on disability before the close of the taxable year and who, when he retired, was permanently and totally disabled")
rule QualifiedIndividualDisability(p: Individual, y: TaxableYear) strict {
    label en official "an individual who retired on permanent and total disability before the close of the taxable year is a qualified individual";
    when retired_on_disability_permanently_and_totally(p, y);
    then elderly_or_disabled_qualified_individual(p, y);
}

// §22(e)(3): the substantive test for "permanently and totally disabled"
// (unable to engage in substantial gainful activity by reason of a medically
// determinable impairment expected to last, or that has lasted, 12+ months
// or result in death) is EVALUATIVE (DECISION-0194): a medical/vocational
// judgment the Secretary applies via required proof — modelled as an
// external-judgment channel, not a direct case fact.
relation section_22e3_disability_finding(p: Individual, authority: us.irc.core::Organ) kind institutional {
    label en official "an external-judgment finding under section 22(e)(3) that the individual is permanently and totally disabled, on proof furnished in the form and manner the Secretary requires";
}
@source(IRC_S22_E, quote = "An individual is permanently and totally disabled if he is unable to engage in any substantial gainful activity by reason of any medically determinable physical or mental impairment which can be expected to result in death or which has lasted or can be expected to last for a continuous period of not less than 12 months")
rule DisabilityFindingSatisfiesRetirementTest(p: Individual, y: TaxableYear) strict {
    label en official "an individual for whom the section 22(e)(3) disability finding has been made, who retired on that disability before the close of the year, is treated as retired on disability and permanently and totally disabled";
    when us.irc.income_individual::filing_status(p, y, _);
    when section_22e3_disability_finding(p, us.irc.core::Secretary);
    when not_known(attained_65_before_close(p, y));
    then retired_on_disability_permanently_and_totally(p, y);
}

// --- §22(c): the section 22 amount ----------------------------------------------

pub relation section_22_initial_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable initial amount (section 22(c)(2)(A))";
}
relation joint_return_both_qualified(p: Individual, spouse: Individual, y: TaxableYear) kind empirical {
    label en official "a joint return where both spouses are qualified individuals (section 22(c)(2)(A)(ii))";
}

@source(IRC_S22_C, quote = "$5,000 in the case of a single individual, or a joint return where only one spouse is a qualified individual")
rule InitialAmountSingleOrOneSpouseQualified(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the initial amount is $5,000 for a single individual, or a joint return where only one spouse is qualified";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Unmarried;
    when elderly_or_disabled_qualified_individual(p, y);
    then section_22_initial_amount(p, y, 5000.00 USD);
}
@source(IRC_S22_C, quote = "$7,500 in the case of a joint return where both spouses are qualified individuals")
rule InitialAmountJointBothQualified(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, spouse: Individual) strict {
    label en official "the initial amount is $7,500 on a joint return where both spouses are qualified individuals";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    when joint_return_both_qualified(p, spouse, y);
    then section_22_initial_amount(p, y, 7500.00 USD);
}
@source(IRC_S22_C, quote = "$3,750 in the case of a married individual filing a separate return")
rule InitialAmountMarriedSeparate(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the initial amount is $3,750 for a married individual filing separately";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::MarriedSeparate;
    when elderly_or_disabled_qualified_individual(p, y);
    then section_22_initial_amount(p, y, 3750.00 USD);
}
// §22(c)(2)(B): the disability-income cap on the initial amount for a
// qualified individual not yet 65 narrows the amount computed above rather
// than adding a new top-level disposition; recorded as INTERPRETATION
// (disability-income amounts under section 72/105(a) are a `gross-income`
// dependency contract this package does not own the wage-classification
// test for).

relation section_22_amount_before_agi_reduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "an individual's section 22 amount before the subsection (d) AGI-based reduction (section 22(c)(1))";
}
pub relation section_22_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "an individual's section 22 amount for the taxable year, after the subsection (d) AGI-based reduction (section 22(c)(1), (d))";
}
relation section_22c3_pension_reduction(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 22(c)(3) reduction: excluded social-security/railroad-retirement/VA pension, annuity, or disability-benefit amounts received (section 22(c)(3)(A), less the section 104(a)(4) carve-out of (c)(3)(A) last sentence)";
}

@source(IRC_S22_C, quote = "An individual's section 22 amount for the taxable year shall be the applicable initial amount determined under paragraph (2), reduced as provided in paragraph (3) and in subsection (d)")
rule Section22AmountBeforeAgiReduction(p: Individual, y: TaxableYear, initial: Money, pension: Money) strict {
    label en official "the section 22 amount is the initial amount reduced by the section 22(c)(3) excluded-pension reduction (subsection (d)'s AGI reduction is applied by the AgiReduction rule below, on top of this result)";
    when section_22_initial_amount(p, y, initial);
    when section_22c3_pension_reduction(p, y, pension);
    then section_22_amount_before_agi_reduction(p, y, max(0 USD, initial - pension));
}
rule Section22AmountBeforeAgiReductionNoPension(p: Individual, y: TaxableYear, initial: Money) strict {
    label en official "absent an asserted section 22(c)(3) pension/annuity/disability-benefit amount, the reduction is zero";
    when section_22_initial_amount(p, y, initial);
    when not_known(has_section_22c3_pension_reduction(p, y));
    then section_22_amount_before_agi_reduction(p, y, initial);
}
relation has_section_22c3_pension_reduction(p: Individual, y: TaxableYear) kind institutional {
    label en official "existence flag for section_22c3_pension_reduction, used only for the not_known branch above";
}
rule HasSection22c3PensionReduction(p: Individual, y: TaxableYear, pension: Money) strict {
    label en official "the existence flag is derived whenever a pension-reduction amount is asserted";
    when section_22c3_pension_reduction(p, y, pension);
    then has_section_22c3_pension_reduction(p, y);
}
// A taxpayer whose AGI does not exceed the applicable subsection (d)
// threshold has no reduction: the section 22 amount equals the pre-
// reduction amount directly.
rule Section22AmountNoAgiReduction(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, base: Money, agi: Money, threshold: Money) strict {
    label en official "at or below the applicable AGI threshold, the section 22 amount equals the amount before AGI reduction";
    when us.irc.income_individual::filing_status(p, y, s);
    when section_22_amount_before_agi_reduction(p, y, base);
    when us.irc.gross_income::adjusted_gross_income(p, y, agi);
    when section_22_agi_threshold(s, threshold);
    when agi <= threshold;
    then section_22_amount(p, y, base);
}
relation section_22_agi_threshold(s: us.irc.income_individual::FilingStatus, amount: Money) kind institutional {
    label en official "the section 22(d) AGI threshold by filing status";
}
@source(IRC_S22_D, quote = "$7,500 in the case of a single individual")
assert "22-agi-threshold-unmarried": section_22_agi_threshold(us.irc.income_individual::Unmarried, 7500.00 USD);
@source(IRC_S22_D, quote = "$10,000 in the case of a joint return")
assert "22-agi-threshold-joint": section_22_agi_threshold(us.irc.income_individual::Joint, 10000.00 USD);
@source(IRC_S22_D, quote = "$5,000 in the case of a married individual filing a separate return")
assert "22-agi-threshold-mfs": section_22_agi_threshold(us.irc.income_individual::MarriedSeparate, 5000.00 USD);

// --- §22(d): AGI-based reduction ------------------------------------------------

@source(IRC_S22_D, quote = "the section 22 amount shall be reduced by one-half of the excess of the adjusted gross income over $7,500, $10,000, or $5,000, as the case may be")
rule AgiReductionSingle(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, base: Money, agi: Money) strict {
    label en official "for a single individual, the section 22 amount (before this reduction) is further reduced by half the excess of AGI over $7,500";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Unmarried;
    when section_22_amount_before_agi_reduction(p, y, base);
    when us.irc.gross_income::adjusted_gross_income(p, y, agi);
    when agi > 7500.00 USD;
    then section_22_amount(p, y, max(0 USD, base - round(0.5 * (agi - 7500.00 USD), 2, "HALF_UP")));
}
@source(IRC_S22_D, quote = "the section 22 amount shall be reduced by one-half of the excess of the adjusted gross income over $7,500, $10,000, or $5,000, as the case may be")
rule AgiReductionJoint(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, base: Money, agi: Money) strict {
    label en official "on a joint return, the section 22 amount is reduced by half the excess of AGI over $10,000";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    when section_22_amount_before_agi_reduction(p, y, base);
    when us.irc.gross_income::adjusted_gross_income(p, y, agi);
    when agi > 10000.00 USD;
    then section_22_amount(p, y, max(0 USD, base - round(0.5 * (agi - 10000.00 USD), 2, "HALF_UP")));
}
@source(IRC_S22_D, quote = "the section 22 amount shall be reduced by one-half of the excess of the adjusted gross income over $7,500, $10,000, or $5,000, as the case may be")
rule AgiReductionMarriedSeparate(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, base: Money, agi: Money) strict {
    label en official "for a married individual filing separately, the section 22 amount is reduced by half the excess of AGI over $5,000";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::MarriedSeparate;
    when section_22_amount_before_agi_reduction(p, y, base);
    when us.irc.gross_income::adjusted_gross_income(p, y, agi);
    when agi > 5000.00 USD;
    then section_22_amount(p, y, max(0 USD, base - round(0.5 * (agi - 5000.00 USD), 2, "HALF_UP")));
}

// --- §22(a)/(e): the credit ------------------------------------------------------

pub relation elderly_and_disabled_credit(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit for the elderly and the permanently and totally disabled (section 22)";
}
relation section_22_joint_return_condition_met(p: Individual, y: TaxableYear) kind institutional {
    label en official "either the taxpayer lives apart from the spouse at all times during the year, is not married at the close of the year, or files jointly (section 22(e)(1))";
}
relation lives_apart_from_spouse_all_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "a husband and wife who live apart at all times during the taxable year (section 22(e)(1) exception)";
}
@source(IRC_S22_E, quote = "if the taxpayer is married at the close of the taxable year, the credit provided by this section shall be allowed only if the taxpayer and his spouse file a joint return for the taxable year")
rule JointReturnConditionMarried22(p: Individual, y: TaxableYear) strict {
    label en official "a married taxpayer not living apart all year satisfies the condition only by filing jointly";
    when us.irc.income_individual::married_at_close_of_year(p, y);
    when not lives_apart_from_spouse_all_year(p, y);
    when us.irc.income_individual::joint_return_filed(p, y);
    then section_22_joint_return_condition_met(p, y);
}
rule JointReturnConditionUnmarriedOrApart22(p: Individual, y: TaxableYear) strict {
    label en official "an unmarried taxpayer, or a married taxpayer living apart from the spouse all year, automatically satisfies the condition";
    when us.irc.core::year_of(p, y);
    when not us.irc.income_individual::married_at_close_of_year(p, y) or lives_apart_from_spouse_all_year(p, y);
    then section_22_joint_return_condition_met(p, y);
}

relation section_22f_nonresident_alien(p: Individual) kind empirical {
    label en official "a nonresident alien (section 22(f))";
}

@source(IRC_S22_A, quote = "there shall be allowed as a credit against the tax imposed by this chapter for the taxable year an amount equal to 15 percent of such individual's section 22 amount for such taxable year")
rule ElderlyAndDisabledCreditGeneral(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "the credit is 15 percent of the section 22 amount, conditioned on the joint-return requirement and denied to a nonresident alien";
    when elderly_or_disabled_qualified_individual(p, y);
    when section_22_amount(p, y, amount);
    when section_22_joint_return_condition_met(p, y);
    when not section_22f_nonresident_alien(p);
    then elderly_and_disabled_credit(p, y, round(0.15 * amount, 2, "HALF_UP"));
}
