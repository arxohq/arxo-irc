// Stage 4 (DECISION-0379 with deontics), credits, part L: the vehicle requirements that sections 45W and
// 25E take from sections 30D(d)(1)(C)-(F), (H) and 30B(b)(3)(A)-(B), written out as rules over vehicle
// facts, and the dealer of 30D(g)(8) read by explicit reference. Part of G6416.
//
// The bundled facts of modules 45w and 25e (`meets_30d_d1c_and_not_for_resale_45w`,
// `road_vehicle_under_30d_d1d_45w`, `fuel_cell_vehicle_meeting_30b_b3_45w`,
// `meets_30d_vehicle_requirements_25e`, `sold_by_dealer_25e`) are now DERIVED by strict rules from the
// component facts below (a case can still assert them: the earlier channel). The requirements are
// stated once (per subparagraph) and read by both credits. NOT written: the definition of "mobile
// machinery" of section 4053(8) (45W(c)(2)(B), a definition of the excise owner: EXTERNAL_DEPENDENCY,
// the fact `mobile_machinery_45w` stays asserted) and the "comparable vehicle" of 45W(b)(3), whose
// comparability in size and use is an evaluative test (below, external judgment).

// ===================== 30D(d)(1)(C): a qualified manufacturer =====================

use self::{
    Asset,
    IRC_S25E_C,
    IRC_S30B_B,
    IRC_S30D_D,
    IRC_S45W_B,
    IRC_S45W_C,
    Individual,
    Person,
    dealer_30d,
    dealer_sold_vehicle_to_taxpayer_on_30d,
    fuel_cell_vehicle_meeting_30b_b3_45w,
    meets_30d_d1c_and_not_for_resale_45w,
    meets_30d_vehicle_requirements_25e,
    road_vehicle_under_30d_d1d_45w,
    sold_by_dealer_25e,
    vehicle_gvwr_pounds_45w,
};

pub relation manufacturer_of_vehicle_30d(vehicle: Asset, manufacturer: Person) kind empirical {
    label en official "the manufacturer of the vehicle (section 30D(d)(1)(C), (d)(3)) — case-asserted";
}
pub relation manufacturer_within_epa_regulations_30d(manufacturer: Person) kind empirical {
    label en official "the person is a manufacturer within the meaning of the regulations of the Administrator of the Environmental Protection Agency under title II of the Clean Air Act (section 30D(d)(3))";
}
pub relation written_agreement_with_secretary_30d(manufacturer: Person) kind empirical {
    label en official "the manufacturer entered into a written agreement with the Secretary to make periodic written reports providing vehicle identification numbers and such other information as the Secretary may require (section 30D(d)(3))";
}
pub relation vehicle_made_by_qualified_manufacturer_30d(vehicle: Asset) kind institutional {
    label en official "the vehicle is made by a qualified manufacturer (section 30D(d)(1)(C), (d)(3))";
}
@source(IRC_S30D_D, quote = "(C) which is made by a qualified manufacturer,")
rule VehicleMadeByQualifiedManufacturer30d(vehicle: Asset, manufacturer: Person) strict {
    label en official "an EPA manufacturer with a written agreement with the Secretary (section 30D(d)(1)(C), (d)(3))";
    when manufacturer_of_vehicle_30d(vehicle, manufacturer);
    when manufacturer_within_epa_regulations_30d(manufacturer);
    when written_agreement_with_secretary_30d(manufacturer);
    then vehicle_made_by_qualified_manufacturer_30d(vehicle);
}

// ===================== 30D(d)(1)(D), (d)(2): a motor vehicle =====================

pub relation vehicle_treated_as_motor_vehicle_under_clean_air_act_title_ii_30d(vehicle: Asset) kind empirical {
    label en official "the vehicle is treated as a motor vehicle for purposes of title II of the Clean Air Act (section 30D(d)(1)(D)) — case-asserted, external classification";
}
pub relation manufactured_primarily_for_public_streets_roads_and_highways_30d(vehicle: Asset) kind empirical {
    label en official "the vehicle is manufactured primarily for use on public streets, roads, and highways (section 30D(d)(2), section 45W(c)(2)(A))";
}
pub relation operated_exclusively_on_rails_30d(vehicle: Asset) kind empirical {
    label en official "the vehicle is operated exclusively on a rail or rails (section 30D(d)(2))";
}
pub relation number_of_wheels_30d(vehicle: Asset, wheels: Integer) kind empirical {
    label en official "the number of wheels of the vehicle (section 30D(d)(2))";
}
pub relation motor_vehicle_30d(vehicle: Asset) kind institutional {
    label en official "a motor vehicle: manufactured primarily for use on public roads, not operated exclusively on rails, with at least 4 wheels (section 30D(d)(2))";
}
@source(IRC_S30D_D, quote = "The term \"motor vehicle\" means any vehicle which is manufactured primarily for use on public streets, roads, and highways (not including a vehicle operated exclusively on a rail or rails) and which has at least 4 wheels.")
rule MotorVehicle30d(vehicle: Asset, wheels: Integer) strict {
    label en official "public road vehicle, not rail-only, at least 4 wheels (section 30D(d)(2))";
    when manufactured_primarily_for_public_streets_roads_and_highways_30d(vehicle);
    when number_of_wheels_30d(vehicle, wheels);
    when wheels >= 4;
    when not_known(operated_exclusively_on_rails_30d(vehicle));
    then motor_vehicle_30d(vehicle);
}

// ===================== 30D(d)(1)(E), (F): weight and battery =====================

pub relation gross_vehicle_weight_rating_pounds_30d(vehicle: Asset, pounds: Decimal) kind empirical {
    label en official "the gross vehicle weight rating of the vehicle, in pounds (section 30D(d)(1)(E))";
}
rule GrossVehicleWeightFrom45wFact(vehicle: Asset, pounds: Decimal) strict {
    label en official "the weight rating asserted in module 45w is the same fact";
    when vehicle_gvwr_pounds_45w(vehicle, pounds);
    then gross_vehicle_weight_rating_pounds_30d(vehicle, pounds);
}
pub relation vehicle_meets_30d_d1_E(vehicle: Asset) kind institutional {
    label en official "the gross vehicle weight rating is less than 14,000 pounds (section 30D(d)(1)(E))";
}
@source(IRC_S30D_D, quote = "(E) which has a gross vehicle weight rating of less than 14,000 pounds,")
rule VehicleMeets30dD1E(vehicle: Asset, pounds: Decimal) strict {
    label en official "rating < 14000 pounds";
    when gross_vehicle_weight_rating_pounds_30d(vehicle, pounds);
    when pounds < 14000.0;
    then vehicle_meets_30d_d1_E(vehicle);
}
pub relation propelled_to_significant_extent_by_electric_motor_30d(vehicle: Asset) kind empirical {
    label en official "the vehicle is propelled to a significant extent by an electric motor which draws electricity from a battery (section 30D(d)(1)(F))";
}
pub relation battery_capacity_kwh_30d(vehicle: Asset, kwh: Decimal) kind empirical {
    label en official "the capacity of the battery, in kilowatt hours, measured from a 100 percent to a 0 percent state of charge (section 30D(d)(1)(F)(i), (d)(4))";
}
pub relation battery_rechargeable_from_external_source_30d(vehicle: Asset) kind empirical {
    label en official "the battery is capable of being recharged from an external source of electricity (section 30D(d)(1)(F)(ii))";
}
pub relation vehicle_meets_30d_d1_F(vehicle: Asset) kind institutional {
    label en official "propelled to a significant extent by an electric motor drawing from a battery of at least 7 kilowatt hours that can be recharged from an external source (section 30D(d)(1)(F))";
}
@source(IRC_S30D_D, quote = "(F) which is propelled to a significant extent by an electric motor which draws electricity from a battery which—")
rule VehicleMeets30dD1F(vehicle: Asset, kwh: Decimal) strict {
    label en official "electric motor, battery >= 7 kWh, external recharge";
    when propelled_to_significant_extent_by_electric_motor_30d(vehicle);
    when battery_capacity_kwh_30d(vehicle, kwh);
    when kwh >= 7.0;
    when battery_rechargeable_from_external_source_30d(vehicle);
    then vehicle_meets_30d_d1_F(vehicle);
}

// ===================== 30D(d)(1)(H) except clause (iv): the seller's report =====================

pub enum SellerReportItem30D {
    TaxpayerIdentification,
    VehicleIdentificationNumber,
    BatteryCapacity,
    MaximumCreditAmount,
    ElectionAmount,
    label en official "the items of the seller's report of section 30D(d)(1)(H) other than the verification of original use (clause (iv), which section 25E(c)(1)(D)(i) excepts)";
}
pub relation seller_report_item_furnished_30d(vehicle: Asset, item: SellerReportItem30D) kind empirical {
    label en official "the person who sells the vehicle to the taxpayer furnished the item in a report to the taxpayer and to the Secretary (section 30D(d)(1)(H))";
}
pub relation vehicle_not_assigned_vin_30d(vehicle: Asset) kind empirical {
    label en official "in accordance with the rules of the Secretary of Transportation the vehicle is not assigned a vehicle identification number (section 30D(d)(1)(H)(ii))";
}
pub relation seller_election_under_30d_g1_30d(vehicle: Asset) kind empirical {
    label en official "the taxpayer makes an election under subsection (g)(1) (section 30D(d)(1)(H)(vi))";
}
pub relation seller_report_complete_except_iv_30d(vehicle: Asset) kind institutional {
    label en official "the seller's report contains clauses (i), (ii), (iii), (v) and, for an electing taxpayer, (vi) (section 30D(d)(1)(H) except clause (iv))";
}
@source(IRC_S30D_D, quote = "(H) for which the person who sells any vehicle to the taxpayer furnishes a report to the taxpayer and to the Secretary, at such time and in such manner as the Secretary shall provide, containing—")
rule SellerReportCompleteVinAndElectionFurnished30d(vehicle: Asset) strict {
    label en official "all of (i), (ii), (iii), (v), (vi) furnished";
    when seller_report_item_furnished_30d(vehicle, TaxpayerIdentification);
    when seller_report_item_furnished_30d(vehicle, VehicleIdentificationNumber);
    when seller_report_item_furnished_30d(vehicle, BatteryCapacity);
    when seller_report_item_furnished_30d(vehicle, MaximumCreditAmount);
    when seller_report_item_furnished_30d(vehicle, ElectionAmount);
    then seller_report_complete_except_iv_30d(vehicle);
}
rule SellerReportCompleteNoElection30d(vehicle: Asset) strict {
    label en official "(vi) is not required without an election";
    when seller_report_item_furnished_30d(vehicle, TaxpayerIdentification);
    when seller_report_item_furnished_30d(vehicle, VehicleIdentificationNumber);
    when seller_report_item_furnished_30d(vehicle, BatteryCapacity);
    when seller_report_item_furnished_30d(vehicle, MaximumCreditAmount);
    when not_known(seller_election_under_30d_g1_30d(vehicle));
    then seller_report_complete_except_iv_30d(vehicle);
}
rule SellerReportCompleteNoVinAssigned30d(vehicle: Asset) strict {
    label en official "(ii) is excused when the vehicle is not assigned a number; (vi) furnished";
    when seller_report_item_furnished_30d(vehicle, TaxpayerIdentification);
    when vehicle_not_assigned_vin_30d(vehicle);
    when seller_report_item_furnished_30d(vehicle, BatteryCapacity);
    when seller_report_item_furnished_30d(vehicle, MaximumCreditAmount);
    when seller_report_item_furnished_30d(vehicle, ElectionAmount);
    then seller_report_complete_except_iv_30d(vehicle);
}
rule SellerReportCompleteNoVinAssignedNoElection30d(vehicle: Asset) strict {
    label en official "(ii) excused and (vi) not required";
    when seller_report_item_furnished_30d(vehicle, TaxpayerIdentification);
    when vehicle_not_assigned_vin_30d(vehicle);
    when seller_report_item_furnished_30d(vehicle, BatteryCapacity);
    when seller_report_item_furnished_30d(vehicle, MaximumCreditAmount);
    when not_known(seller_election_under_30d_g1_30d(vehicle));
    then seller_report_complete_except_iv_30d(vehicle);
}

// ===================== 30B(b)(3)(A), (B): a fuel cell motor vehicle =====================

pub relation propelled_by_hydrogen_fuel_cells_30b3A(vehicle: Asset) kind empirical {
    label en official "the vehicle is propelled by power derived from 1 or more cells which convert chemical energy directly into electricity by combining oxygen with hydrogen fuel stored on board (section 30B(b)(3)(A))";
}
pub relation passenger_automobile_or_light_truck_30b3B(vehicle: Asset) kind empirical {
    label en official "the vehicle is a passenger automobile or light truck (section 30B(b)(3)(B))";
}
pub relation bin_5_tier_ii_certificate_received_30b3B(vehicle: Asset) kind empirical {
    label en official "the vehicle has received a certificate that it meets or exceeds the Bin 5 Tier II emission level (section 30B(b)(3)(B))";
}
pub relation vehicle_meets_30b_b3_A_and_B(vehicle: Asset) kind institutional {
    label en official "a motor vehicle propelled by hydrogen fuel cells that, if a passenger automobile or light truck, has the Bin 5 Tier II certificate (section 30B(b)(3)(A)-(B))";
}
@source(IRC_S30B_B, quote = "(A) which is propelled by power derived from 1 or more cells which convert chemical energy directly into electricity by combining oxygen with hydrogen fuel which is stored on board the vehicle in any form and may or may not require reformation prior to use,")
rule VehicleMeets30bB3ANoCertificateNeeded(vehicle: Asset) strict {
    label en official "fuel cell motor vehicle that is not a passenger automobile or light truck";
    when motor_vehicle_30d(vehicle);
    when propelled_by_hydrogen_fuel_cells_30b3A(vehicle);
    when not_known(passenger_automobile_or_light_truck_30b3B(vehicle));
    then vehicle_meets_30b_b3_A_and_B(vehicle);
}
@source(IRC_S30B_B, quote = "(B) which, in the case of a passenger automobile or light truck, has received on or after the date of the enactment of this section a certificate that such vehicle meets or exceeds the Bin 5 Tier II emission level established in regulations prescribed by the Administrator of the Environmental Protection Agency under section 202(i) of the Clean Air Act for that make and model year vehicle,")
rule VehicleMeets30bB3ACertificateReceived(vehicle: Asset) strict {
    label en official "passenger automobile or light truck with the certificate";
    when motor_vehicle_30d(vehicle);
    when propelled_by_hydrogen_fuel_cells_30b3A(vehicle);
    when passenger_automobile_or_light_truck_30b3B(vehicle);
    when bin_5_tier_ii_certificate_received_30b3B(vehicle);
    then vehicle_meets_30b_b3_A_and_B(vehicle);
}

// ===================== 45W(c): the derived vehicle tests =====================

pub relation acquired_for_use_or_lease_not_for_resale_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is acquired for use or lease by the taxpayer and not for resale (section 45W(c)(1))";
}
@source(IRC_S45W_C, quote = "(1) meets the requirements of section 30D(d)(1)(C) and is acquired for use or lease by the taxpayer and not for resale,")
rule MeetsD1cAndNotForResale45w(vehicle: Asset) strict {
    label en official "made by a qualified manufacturer and acquired not for resale (section 45W(c)(1))";
    when vehicle_made_by_qualified_manufacturer_30d(vehicle);
    when acquired_for_use_or_lease_not_for_resale_45w(vehicle);
    then meets_30d_d1c_and_not_for_resale_45w(vehicle);
}
@source(IRC_S45W_C, quote = "(A) meets the requirements of subparagraph (D) of section 30D(d)(1) and is manufactured primarily for use on public streets, roads, and highways (not including a vehicle operated exclusively on a rail or rails), or")
rule RoadVehicleUnder30dD1D45w(vehicle: Asset) strict {
    label en official "treated as a motor vehicle under title II of the Clean Air Act and manufactured primarily for public roads, not rail-only (section 45W(c)(2)(A))";
    when vehicle_treated_as_motor_vehicle_under_clean_air_act_title_ii_30d(vehicle);
    when manufactured_primarily_for_public_streets_roads_and_highways_30d(vehicle);
    when not_known(operated_exclusively_on_rails_30d(vehicle));
    then road_vehicle_under_30d_d1d_45w(vehicle);
}
@source(IRC_S45W_C, quote = "(B) is a motor vehicle which satisfies the requirements under subparagraphs (A) and (B) of section 30B(b)(3), and")
rule FuelCellVehicleMeeting30bB3For45w(vehicle: Asset) strict {
    label en official "a motor vehicle satisfying section 30B(b)(3)(A) and (B) (section 45W(c)(3)(B))";
    when vehicle_meets_30b_b3_A_and_B(vehicle);
    then fuel_cell_vehicle_meeting_30b_b3_45w(vehicle);
}

// ===================== 25E(c)(1)(D): the vehicle tests =====================

@source(IRC_S25E_C, quote = "(i) meets the requirements of subparagraphs (C), (D), (E), (F), and (H) (except for clause (iv) thereof) of section 30D(d)(1), or")
rule MeetsVehicleRequirements25eThrough30d(vehicle: Asset) strict {
    label en official "clause (i): (C), (D), (E), (F) and (H) except (iv) of section 30D(d)(1)";
    when vehicle_made_by_qualified_manufacturer_30d(vehicle);
    when vehicle_treated_as_motor_vehicle_under_clean_air_act_title_ii_30d(vehicle);
    when vehicle_meets_30d_d1_E(vehicle);
    when vehicle_meets_30d_d1_F(vehicle);
    when seller_report_complete_except_iv_30d(vehicle);
    then meets_30d_vehicle_requirements_25e(vehicle);
}
@source(IRC_S25E_C, quote = "(ii) is a motor vehicle which—")
rule MeetsVehicleRequirements25eFuelCell(vehicle: Asset) strict {
    label en official "clause (ii): a motor vehicle satisfying 30B(b)(3)(A)-(B) with a gross vehicle weight rating under 14,000 pounds";
    when vehicle_meets_30b_b3_A_and_B(vehicle);
    when vehicle_meets_30d_d1_E(vehicle);
    then meets_30d_vehicle_requirements_25e(vehicle);
}
// ===================== 25E(c)(2)(A): a dealer as defined in 30D(g)(8) =====================

@source(IRC_S25E_C, quote = "(A) by a dealer (as defined in section 30D(g)(8)),")
rule SoldByDealer25eFrom30dDealer(vehicle: Asset, dealer: Person, taxpayer: Individual, on: Date) strict {
    label en official "the seller is a dealer of section 30D(g)(8), read by explicit reference (section 25E(c)(2)(A))";
    when dealer_sold_vehicle_to_taxpayer_on_30d(dealer, vehicle, taxpayer, on);
    when dealer_30d(dealer);
    then sold_by_dealer_25e(vehicle);
}

// ===================== 45W(b)(3): the comparable vehicle =====================

pub relation vehicle_powered_solely_by_gasoline_or_diesel_engine_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is powered solely by a gasoline or diesel internal combustion engine (section 45W(b)(3))";
}
external judgment relation comparable_in_size_and_use_45w(comparable: Asset, vehicle: Asset) {
    authority Secretary;
    label en official "the comparable vehicle is comparable in size and use to the qualified commercial clean vehicle (section 45W(b)(3)); an evaluative test: the judgment of the Secretary (DECISION-0194)";
}
pub relation comparable_vehicle_45w(comparable: Asset, vehicle: Asset) kind institutional {
    label en official "a comparable vehicle: powered solely by a gasoline or diesel internal combustion engine and comparable in size and use (section 45W(b)(3))";
}
@source(IRC_S45W_B, quote = "For purposes of this subsection, the term \"comparable vehicle\" means, with respect to any qualified commercial clean vehicle, any vehicle which is powered solely by a gasoline or diesel internal combustion engine and which is comparable in size and use to such vehicle.")
rule ComparableVehicle45w(comparable: Asset, vehicle: Asset) defeasible {
    label en official "ICE-only and comparable in size and use (section 45W(b)(3))";
    when vehicle_powered_solely_by_gasoline_or_diesel_engine_45w(comparable);
    when comparable_in_size_and_use_45w(comparable, vehicle);
    then comparable_vehicle_45w(comparable, vehicle);
}
