// Section 25E — Previously-owned clean vehicles. Stage 2d (IRC-06,
// DECISION-0379).
//
// Editions by `legal_time` (`effective` windows; PL 119-21 section 70501 is
// pinned as `us.irc.temporal::PL119_21_S70501`, enacted 2025-07-04): the 2024
// text ends the credit for vehicles acquired after 2032-12-31; from 2025-07-04
// vehicles acquired after 2025-09-30 are excluded.
//
// Scope / judgment calls:
// * (a): the lesser of $4,000 and 30 percent of the sale price.
// * (b): no credit if the lesser of the current-year and preceding-year
//   modified adjusted gross income exceeds the threshold: $150,000 (joint
//   return or surviving spouse), $112,500 (head of household), $75,000 others.
// * (c)(1): previously-owned clean vehicle: model year at least 2 years
//   earlier than the calendar year of acquisition, original use commencing with
//   another person, a qualified sale, and the vehicle tests of section 30D
//   (one case fact); (c)(2): qualified sale: by a dealer, price at most $25,000,
//   first transfer since enactment; (c)(3): qualified buyer: an individual who
//   buys for use, is not a dependent, and was allowed no credit in the prior 3
//   years. (d): the vehicle identification number on the return.
// * (e)-(f) (rules of section 30D(f), (g)) are not modelled (TECH-GAPS G1791).

use self::{
    Asset,
    IRC_S25E_A,
    IRC_S25E_B,
    IRC_S25E_C,
    IRC_S25E_G,
    Individual,
    TaxableYear,
    credit_denied_by_30df_rules_25e,
};

pub relation vehicle_model_year_25e(vehicle: Asset, year: Integer) kind empirical {
    label en official "the model year of the vehicle (section 25E(c)(1)(A)) — case-asserted";
}
pub relation acquisition_date_25e(taxpayer: Individual, vehicle: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer acquires the vehicle (sections 25E(a), (g)) — case-asserted";
}
pub relation original_use_commenced_with_other_person_25e(vehicle: Asset, taxpayer: Individual) kind empirical {
    label en official "the original use of the vehicle commenced with a person other than the taxpayer (section 25E(c)(1)(B)) — case-asserted";
}
pub relation meets_30d_vehicle_requirements_25e(vehicle: Asset) kind empirical {
    label en official "the vehicle meets section 30D(d)(1)(C), (D), (E), (F) and (H) (except clause (iv)), or is a motor vehicle satisfying section 30B(b)(3)(A)-(B) with a gross vehicle weight rating under 14,000 pounds (section 25E(c)(1)(D)) — case-asserted, bundled";
}
pub relation sold_by_dealer_25e(vehicle: Asset) kind empirical {
    label en official "the sale is by a dealer as defined in section 30D(g)(8) (section 25E(c)(2)(A)) — case-asserted";
}
pub relation sale_price_25e(vehicle: Asset, price: Money) kind empirical {
    label en official "the sale price of the vehicle (sections 25E(a)(2), (c)(2)(B)) — case-asserted";
}
pub relation first_transfer_to_qualified_buyer_25e(vehicle: Asset, taxpayer: Individual) kind empirical {
    label en official "the sale is the first transfer since the date of enactment of section 25E to a qualified buyer other than the person with whom the original use commenced (section 25E(c)(2)(C)) — case-asserted";
}
pub relation purchases_for_use_not_resale_25e(taxpayer: Individual, vehicle: Asset) kind empirical {
    label en official "the taxpayer purchases the vehicle for use and not for resale (section 25E(c)(3)(B)) — case-asserted";
}
pub relation dependent_of_another_taxpayer_25e(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "a deduction is allowable with respect to the taxpayer to another taxpayer under section 151 (section 25E(c)(3)(C)) — case-asserted";
}
pub relation credit_allowed_in_prior_three_years_25e(taxpayer: Individual, vehicle: Asset) kind empirical {
    label en official "the taxpayer was allowed a credit under section 25E for any sale during the 3-year period ending on the date of the sale of this vehicle (section 25E(c)(3)(D)) — case-asserted";
}
pub relation modified_agi_25e(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "modified adjusted gross income for the taxable year: adjusted gross income increased by amounts excluded under section 911, 931, or 933 (section 25E(b)(3)) — case-asserted";
}
pub relation modified_agi_preceding_year_25e(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "modified adjusted gross income for the preceding taxable year (section 25E(b)(1)(A)(ii)) — case-asserted";
}
pub relation vin_included_on_return_25e(taxpayer: Individual, vehicle: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes the vehicle identification number on the return of tax for the taxable year (section 25E(d)) — case-asserted";
}

// --- (c): the vehicle, the sale and the buyer ---------------------------------------------------------------------------------------

pub relation qualified_sale_25e(vehicle: Asset) kind institutional {
    label en official "section 25E(c)(2): a sale by a dealer for a price of at most $25,000";
}
@source(IRC_S25E_C, quote = "for a sale price which does not exceed $25,000")
rule QualifiedSale25eRule(vehicle: Asset, price: Money) strict {
    when sold_by_dealer_25e(vehicle);
    when sale_price_25e(vehicle, price);
    when price <= 25000.00 USD;
    then qualified_sale_25e(vehicle);
}
pub relation qualified_buyer_25e(taxpayer: Individual, vehicle: Asset, y: TaxableYear) kind institutional {
    label en official "section 25E(c)(3): an individual who buys for use, is not a dependent, and was allowed no credit in the prior 3 years";
}
@source(IRC_S25E_C, quote = "who has not been allowed a credit under this section for any sale during the 3-year period ending on the date of the sale of such vehicle")
rule QualifiedBuyer25eRule(taxpayer: Individual, vehicle: Asset, y: TaxableYear) strict {
    when purchases_for_use_not_resale_25e(taxpayer, vehicle);
    when acquisition_date_25e(taxpayer, vehicle, _);
    when not_known(dependent_of_another_taxpayer_25e(taxpayer, y));
    when not_known(credit_allowed_in_prior_three_years_25e(taxpayer, vehicle));
    when modified_agi_25e(taxpayer, y, _);
    then qualified_buyer_25e(taxpayer, vehicle, y);
}
pub relation previously_owned_clean_vehicle_25e(taxpayer: Individual, vehicle: Asset, y: TaxableYear) kind institutional {
    label en official "section 25E(c)(1): a motor vehicle at least 2 model years old at acquisition, with original use commencing with another person, acquired in a qualified sale, meeting the vehicle tests";
}
@source(IRC_S25E_C, quote = "the model year of which is at least 2 years earlier than the calendar year in which the taxpayer acquires such vehicle")
rule PreviouslyOwnedCleanVehicle25eRule(taxpayer: Individual, vehicle: Asset, y: TaxableYear, model: Integer, cal_year: Integer) strict {
    when vehicle_model_year_25e(vehicle, model);
    when us.irc.core::calendar_year_of(y, cal_year);
    when acquisition_date_25e(taxpayer, vehicle, _);
    when model <= cal_year - 2;
    when original_use_commenced_with_other_person_25e(vehicle, taxpayer);
    when qualified_sale_25e(vehicle);
    when first_transfer_to_qualified_buyer_25e(vehicle, taxpayer);
    when meets_30d_vehicle_requirements_25e(vehicle);
    then previously_owned_clean_vehicle_25e(taxpayer, vehicle, y);
}

// --- (b): the income limitation ----------------------------------------------------------------------------------------------------------

relation threshold_amount_25e(status: us.irc.income_individual::FilingStatus, amount: Money) kind institutional;
@source(IRC_S25E_B, quote = "in the case of a joint return or a surviving spouse (as defined in section 2(a)), $150,000")
assert "25e-threshold-joint": threshold_amount_25e(us.irc.income_individual::Joint, 150000.00 USD);
@source(IRC_S25E_B, quote = "in the case of a head of household (as defined in section 2(b)), $112,500")
assert "25e-threshold-hoh": threshold_amount_25e(us.irc.income_individual::HeadOfHousehold, 112500.00 USD);
@source(IRC_S25E_B, quote = "in the case of a taxpayer not described in subparagraph (A) or (B), $75,000")
assert "25e-threshold-unmarried": threshold_amount_25e(us.irc.income_individual::Unmarried, 75000.00 USD);
assert "25e-threshold-mfs": threshold_amount_25e(us.irc.income_individual::MarriedSeparate, 75000.00 USD);
assert "25e-threshold-estate": threshold_amount_25e(us.irc.income_individual::EstateOrTrust, 75000.00 USD);
pub relation magi_below_threshold_25e(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 25E(b)(1): the lesser of the current-year and preceding-year modified adjusted gross income does not exceed the threshold amount";
}
@source(IRC_S25E_B, quote = "the lesser of—\n(i) the modified adjusted gross income of the taxpayer for such taxable year, or\n(ii) the modified adjusted gross income of the taxpayer for the preceding taxable year, exceeds")
rule MagiBelowThreshold25eRule(taxpayer: Individual, y: TaxableYear, current: Money, preceding: Money, status: us.irc.income_individual::FilingStatus, threshold: Money) strict {
    when modified_agi_25e(taxpayer, y, current);
    when modified_agi_preceding_year_25e(taxpayer, y, preceding);
    when us.irc.income_individual::filing_status(taxpayer, y, status);
    when threshold_amount_25e(status, threshold);
    when min(current, preceding) <= threshold;
    then magi_below_threshold_25e(taxpayer, y);
}

// --- (g): termination, base and PL 119-21 editions -----------------------------------------------------------------------------------------

pub relation vehicle_acquired_within_credit_period_25e(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 25E(g): acquired on or before 2032-12-31 (2024 text); on or before 2025-09-30 under PL 119-21 section 70501 from its enactment";
}
@source(IRC_S25E_G, quote = "No credit shall be allowed under this section with respect to any vehicle acquired after December 31, 2032.")
rule VehicleAcquiredWithinCreditPeriodBase25eRule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when acquisition_date_25e(taxpayer, vehicle, on);
    when on <= @2032-12-31;
    then vehicle_acquired_within_credit_period_25e(taxpayer, vehicle);
}
@source(us.irc.temporal::PL119_21_S70501, quote = "Section 25E(g) is amended by striking “December 31, 2032” and inserting “September 30, 2025”.")
rule VehicleAcquiredWithinCreditPeriodAmended25eRule(taxpayer: Individual, vehicle: Asset, on: Date) strict {
    effective [@2025-07-04, infinity);
    when acquisition_date_25e(taxpayer, vehicle, on);
    when on <= @2025-09-30;
    then vehicle_acquired_within_credit_period_25e(taxpayer, vehicle);
}

// --- (a): the credit -----------------------------------------------------------------------------------------------------------------------------

pub relation previously_owned_clean_vehicle_credit(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 25E previously-owned clean vehicle credit: the lesser of $4,000 and 30 percent of the sale price";
}
@source(IRC_S25E_A, quote = "an amount equal to the lesser of")
rule PreviouslyOwnedCleanVehicleCredit25eRule(taxpayer: Individual, vehicle: Asset, y: TaxableYear, price: Money) defeasible {
    when previously_owned_clean_vehicle_25e(taxpayer, vehicle, y);
    when not_known(credit_denied_by_30df_rules_25e(taxpayer, vehicle));
    when qualified_buyer_25e(taxpayer, vehicle, y);
    when magi_below_threshold_25e(taxpayer, y);
    when vin_included_on_return_25e(taxpayer, vehicle, y);
    when vehicle_acquired_within_credit_period_25e(taxpayer, vehicle);
    when sale_price_25e(vehicle, price);
    then previously_owned_clean_vehicle_credit(taxpayer, vehicle, y, min(4000.00 USD, round(0.30 * price, 2, "HALF_UP")));
}
