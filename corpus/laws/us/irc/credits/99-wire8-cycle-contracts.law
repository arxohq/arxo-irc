// Credits -- WIRE-8 (26.09.2026, DECISION-0379 Д-22 item (б), implemented_unverified).
//
// The lower package `gross_income` (section 152 dependents) declares a local contract for "permanently and totally disabled, as
// defined in section 22(e)(3)" and cannot import this package (this package imports `gross_income`; a direct import back would be an
// import cycle). The owner of section 22 DERIVES the lower package's `pub` relation from its own section 22(e)(3) disability
// finding, with a qualified rule head (Д-13 item 5). The case-fact channel stays valid: scenarios of `gross_income` never load this
// package. JUDGMENT CALL: the finding is a timeless external judgment (DECISION-0194); like `DisabilityFindingSatisfiesRetirementTest`
// the taxable year is bound through the individual's filing status for that year.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

use self::{
    Individual,
    TaxableYear,
    section_22e3_disability_finding,
};

rule W8PermanentlyAndTotallyDisabledForSection152(ind: Individual, y: TaxableYear) strict {
    label en official "section 22(e)(3): an individual for whom the section 22(e)(3) disability finding has been made is permanently and totally disabled for the section 152 tests that borrow the definition";
    when us.irc.income_individual::filing_status(ind, y, _);
    when section_22e3_disability_finding(ind, us.irc.core::Secretary);
    then us.irc.gross_income::permanently_and_totally_disabled_22e3(ind, y);
}
