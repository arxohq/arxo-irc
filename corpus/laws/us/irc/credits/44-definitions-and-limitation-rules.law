// Section 44 — the eligible access expenditures of (c) (purpose, listed items, reasonableness, new facilities, standards) and the (d) special
// rules: controlled groups, partnerships, gross receipts, predecessors and the no double benefit rule. Stage 2f (IRC-06, DECISION-0379,
// TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of `44-disabled-access-credit.law`; its credit rule reads the eligible
// access expenditures as one case fact (already meeting the (c)(2)-(5) tests) and is NOT rewired to require these relations.
//
// Judgment calls: the Americans with Disabilities Act requirements as in effect on the date of enactment are a case fact of the item; the
// enactment date of section 44 is a case fact of the facility comparison; the standards of (c)(5) are an external judgment of the Secretary
// (DECISION-0194); the reasonable and necessary part of an amount is an asserted amount.

use self::{
    Asset,
    IRC_S44_C,
    IRC_S44_D,
    LeavePurpose45S,
    Person,
    TaxableYear,
    eligible_small_business_44,
};

pub enum AccessPurpose44 {
    BarrierRemoval,
    InterpretersOrAuralMaterials,
    ReadersOrVisualMaterials,
    EquipmentOrDevices,
    OtherSimilarServices,
    OtherPurpose
}

// --- (c): the eligible access expenditures ------------------------------------------------------------------------------------------------------------------

pub relation access_expenditure_item_44(taxpayer: Person, item: Asset, y: TaxableYear, purpose: AccessPurpose44, amount: Money) kind empirical {
    label en official "an amount paid or incurred by the eligible small business, with the purpose of section 44(c)(2)(A)-(E) — case-asserted";
}
pub relation purpose_to_comply_with_ada_44(item: Asset) kind empirical {
    label en official "the amount is paid or incurred for the purpose of enabling the eligible small business to comply with applicable requirements under the Americans With Disabilities Act of 1990, as in effect on the date of enactment of section 44 (section 44(c)(1)) — case-asserted";
}
pub relation reasonable_and_necessary_part_44(item: Asset, amount: Money) kind empirical {
    label en official "the part of the amount that is reasonable and necessary to accomplish the purpose (section 44(c)(3)) — case-asserted";
}
pub relation facility_first_placed_in_service_on_44(item: Asset, on: Date) kind empirical {
    label en official "the date the facility in connection with which the barrier removal amount is paid or incurred was first placed in service (section 44(c)(4)) — case-asserted";
}
pub relation section_44_enacted_on_44(on: Date) kind empirical {
    label en official "the date of enactment of section 44 — case-asserted from the pinned Public Law note";
}
external judgment relation taxpayer_establishes_standards_met_44(item: Asset) {
    authority Secretary;
    label en official "the taxpayer establishes, to the satisfaction of the Secretary, that the resulting removal of any barrier (or the provision of services, modifications, materials or equipment) meets the standards promulgated by the Secretary with the concurrence of the Architectural and Transportation Barriers Compliance Board (section 44(c)(5))";
}
pub relation eligible_access_expenditure_defined_44(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 44(c): amounts paid or incurred by an eligible small business to comply with the Americans With Disabilities Act for a listed purpose, only the reasonable and necessary part, excluding barrier removal at a facility first placed in service after the enactment, and only where the standards are established to the Secretary's satisfaction";
}
@source(IRC_S44_C, relation = formalizes, coverage = exact, quote = "amounts paid or incurred by an eligible small business for the purpose of enabling such eligible small business to comply with applicable requirements under the Americans With Disabilities Act of 1990")
rule EligibleAccessExpenditureBarrierRule(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money, reasonable: Money, placed: Date, enacted: Date) defeasible {
    when eligible_small_business_44(taxpayer, y);
    when access_expenditure_item_44(taxpayer, item, y, BarrierRemoval, amount);
    when purpose_to_comply_with_ada_44(item);
    when reasonable_and_necessary_part_44(item, reasonable);
    when facility_first_placed_in_service_on_44(item, placed);
    when section_44_enacted_on_44(enacted);
    when placed <= enacted;
    when taxpayer_establishes_standards_met_44(item);
    then eligible_access_expenditure_defined_44(taxpayer, item, y, min(amount, reasonable));
}
@source(IRC_S44_C, relation = formalizes, coverage = exact, quote = "to provide qualified interpreters or other effective methods of making aurally delivered materials available to individuals with hearing impairments")
rule EligibleAccessExpenditureOtherPurposeRule(taxpayer: Person, item: Asset, y: TaxableYear, purpose: AccessPurpose44, amount: Money, reasonable: Money) defeasible {
    when eligible_small_business_44(taxpayer, y);
    when access_expenditure_item_44(taxpayer, item, y, purpose, amount);
    when purpose != BarrierRemoval;
    when purpose != OtherPurpose;
    when purpose_to_comply_with_ada_44(item);
    when reasonable_and_necessary_part_44(item, reasonable);
    when taxpayer_establishes_standards_met_44(item);
    then eligible_access_expenditure_defined_44(taxpayer, item, y, min(amount, reasonable));
}
pub relation eligible_access_expenditures_computed_44(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 44(c): the sum of the eligible access expenditures of the taxable year";
}
rule EligibleAccessExpendituresComputedRule(taxpayer: Person, y: TaxableYear, one_item: Asset, one_amount: Money) defeasible {
    when eligible_access_expenditure_defined_44(taxpayer, one_item, y, one_amount);
    then eligible_access_expenditures_computed_44(taxpayer, y,
        sum(collect all a: Money, i: Asset where eligible_access_expenditure_defined_44(taxpayer, i, y, a), empty: 0 USD));
}

// --- (d)(2)-(3): controlled groups and partnerships ---------------------------------------------------------------------------------------------------

pub relation member_of_controlled_group_52_44(group: Person, member: Person) kind empirical {
    label en official "the person is a member of the same controlled group of corporations (section 52(a)) or under common control (section 52(b)) — case-asserted";
}
pub relation treated_as_one_person_44(a: Person, b: Person) kind institutional {
    label en official "section 44(d)(2)(A): all members of the same controlled group of corporations and all persons under common control are treated as 1 person";
}
@source(IRC_S44_D, relation = formalizes, coverage = exact, quote = "shall be treated as 1 person for purposes of this section")
rule TreatedAsOnePersonRule(a: Person, b: Person, group: Person) strict {
    when member_of_controlled_group_52_44(group, a);
    when member_of_controlled_group_52_44(group, b);
    then treated_as_one_person_44(a, b);
}
pub relation partnership_or_s_corporation_44(pt_entity: Person) kind empirical {
    label en official "the entity is a partnership or an S corporation — case-asserted";
}
pub relation owner_of_pass_through_44(pt_entity: Person, owner: Person) kind empirical {
    label en official "the person is a partner (or S corporation shareholder) of the entity — case-asserted";
}
pub relation dollar_limitation_applies_at_entity_and_owner_44(pt_entity: Person, owner: Person) kind institutional {
    label en official "section 44(d)(3): for a partnership the dollar limitation of subsection (a) applies with respect to the partnership and each partner; a similar rule applies to an S corporation and its shareholders";
}
@source(IRC_S44_D, relation = formalizes, coverage = exact, quote = "In the case of a partnership, the limitation under subsection (a) shall apply with respect to the partnership and each partner.")
rule DollarLimitationAppliesAtEntityAndOwnerRule(pt_entity: Person, owner: Person) strict {
    when partnership_or_s_corporation_44(pt_entity);
    when owner_of_pass_through_44(pt_entity, owner);
    then dollar_limitation_applies_at_entity_and_owner_44(pt_entity, owner);
}

// --- (d)(5)-(7): gross receipts, predecessors, no double benefit -------------------------------------------------------------------------------------

pub relation gross_receipts_before_returns_44(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross receipts for the taxable year before returns and allowances — case-asserted";
}
pub relation returns_and_allowances_made_during_year_44(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the returns and allowances made during the taxable year (section 44(d)(5)) — case-asserted";
}
pub relation gross_receipts_after_returns_44(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 44(d)(5): gross receipts for a taxable year are reduced by returns and allowances made during the year (not below zero)";
}
@source(IRC_S44_D, relation = formalizes, coverage = exact, quote = "Gross receipts for any taxable year shall be reduced by returns and allowances made during such year.")
rule GrossReceiptsAfterReturnsRule(taxpayer: Person, y: TaxableYear, gross: Money, returns: Money) strict {
    when gross_receipts_before_returns_44(taxpayer, y, gross);
    when returns_and_allowances_made_during_year_44(taxpayer, y, returns);
    then gross_receipts_after_returns_44(taxpayer, y, max(gross - returns, 0 USD));
}
pub relation predecessor_of_44(pred: Person, taxpayer: Person) kind empirical {
    label en official "the person is a predecessor of the taxpayer — case-asserted";
}
pub relation person_including_predecessor_44(taxpayer: Person, other: Person) kind institutional {
    label en official "section 44(d)(6): the reference to any person in subsection (b)(1) includes a reference to any predecessor";
}
@source(IRC_S44_D, relation = formalizes, coverage = exact, quote = "The reference to any person in paragraph (1) of subsection (b) shall be treated as including a reference to any predecessor.")
rule PersonIncludingPredecessorRule(taxpayer: Person, pred: Person) strict {
    when predecessor_of_44(pred, taxpayer);
    then person_including_predecessor_44(taxpayer, pred);
}
pub relation credit_amount_44(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit determined under section 44 — case-asserted";
}
pub relation deduction_or_credit_disallowed_for_credit_amount_44(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 44(d)(7)(A): no deduction or credit is allowed under any other provision of the chapter for the amount of the credit determined";
}
@source(IRC_S44_D, relation = formalizes, coverage = exact, quote = "no deduction or credit shall be allowed for such amount under any other provision of this chapter")
rule DeductionOrCreditDisallowedForCreditAmountRule(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    when credit_amount_44(taxpayer, y, amount);
    then deduction_or_credit_disallowed_for_credit_amount_44(taxpayer, y, amount);
}
pub relation basis_increase_denied_for_credit_amount_44(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 44(d)(7)(B): no increase in the adjusted basis of any property results from the amount of the credit";
}
@source(IRC_S44_D, relation = formalizes, coverage = exact, quote = "no increase in the adjusted basis of any property shall result from such amount")
rule BasisIncreaseDeniedForCreditAmountRule(taxpayer: Person, y: TaxableYear, amount: Money) strict {
    when credit_amount_44(taxpayer, y, amount);
    then basis_increase_denied_for_credit_amount_44(taxpayer, y, amount);
}
