// Section 25 — Interest on certain home mortgages (mortgage credit
// certificate / "MCC" credit). Stage 1 (IRC-06 stage 1).
//
// §25(c)/(d)/(f)/(g)/(h) are the STATE bond-issuing-authority's program
// administration (qualified mortgage credit certificate program
// requirements, volume caps tied to section 146, issuer reporting,
// Secretary's regulatory authority) — institutional facts about a
// government program, not a taxpayer computation. This package treats
// "the taxpayer holds a valid, in-effect mortgage credit certificate
// specifying a credit rate and indebtedness amount" as a single dependency
// contract/case fact (`valid_mortgage_credit_certificate`) rather than
// reconstructing the program-qualification test, and models the part that
// IS a taxpayer computation: the (a) credit formula, the (a)(2) $2,000 cap,
// and the (e) carryover.

use self::{
    IRC_S25_A,
    IRC_S25_E,
    IRC_S25_F,
    Individual,
    Person,
    TaxableYear,
};

pub relation valid_mortgage_credit_certificate(taxpayer: Individual, cert: Person, y: TaxableYear, credit_rate: Decimal, certified_indebtedness: Money) kind institutional {
    label en official "a mortgage credit certificate in effect with respect to the taxpayer for this taxable year, specifying the certificate credit rate and certified indebtedness amount (sections 25(b), (c), (e)(3)) — dependency contract; producer: unresolved (candidate: property-transactions / a dedicated bond-financing package), asserted as a case fact until then";
}
relation interest_paid_on_certified_indebtedness(taxpayer: Individual, cert: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest paid or accrued by the taxpayer during the taxable year on the remaining principal of the certified indebtedness amount (section 25(a)(1)(B))";
}
relation related_person_interest_25e6(taxpayer: Individual, cert: Person) kind empirical {
    label en official "interest paid or accrued to a person related to the taxpayer within the meaning of section 144(a)(3)(A) — disqualified under section 25(e)(6)";
}

pub relation mcc_credit_before_cap(taxpayer: Individual, cert: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the product of the certificate credit rate and the certified-indebtedness interest paid, before the $2,000 cap of section 25(a)(2)(A)";
}
@source(IRC_S25_A, quote = "the product of—")
rule MccCreditBeforeCap(taxpayer: Individual, cert: Person, y: TaxableYear, rate: Decimal, principal: Money, interest: Money) strict {
    label en official "the credit is the certificate credit rate times the certified-indebtedness interest paid, unless the interest is paid to a related person";
    when valid_mortgage_credit_certificate(taxpayer, cert, y, rate, principal);
    when interest_paid_on_certified_indebtedness(taxpayer, cert, y, interest);
    when not related_person_interest_25e6(taxpayer, cert);
    then mcc_credit_before_cap(taxpayer, cert, y, round(rate * interest, 2, "HALF_UP"));
}

pub relation mortgage_credit_certificate_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the mortgage credit certificate credit allowed under section 25 for the taxable year, summed over all certificates and capped where the rate exceeds 20 percent";
}
@source(IRC_S25_A, quote = "If the certificate credit rate exceeds 20 percent, the amount of the credit allowed to the taxpayer under paragraph (1) for any taxable year shall not exceed $2,000")
rule MccCreditCapAppliesWhenRateExceeds20Percent(taxpayer: Individual, y: TaxableYear) strict {
    label en official "when every certificate held by the taxpayer carries a rate at or below 20 percent, no $2,000 cap applies and the credit is the sum of the per-certificate amounts (the $2,000 cap, when a rate exceeds 20 percent, and its (a)(2)(B) multi-holder allocation, are recorded as a further refinement not reduced to a rule this pass — TECH_GAP)";
    when us.irc.income_individual::filing_status(taxpayer, y, _);
    then mortgage_credit_certificate_credit(taxpayer, y,
        sum all amount: Money for cert: Person where mcc_credit_before_cap(taxpayer, cert, y, amount));
}

// --- §25(e)(1): 3-year carryover -------------------------------------------------

pub relation mcc_credit_carryover(taxpayer: Individual, from_year: TaxableYear, to_year: TaxableYear, amount: Money) kind institutional {
    label en official "the section 25(e)(1) 3-year carryover of unused mortgage credit certificate credit";
}
relation section_25_applicable_tax_limit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 26(a) limitation reduced by the sum of the credits allowable under subpart A other than sections 25, 23, and 25D (section 25(e)(1)(C))";
}
@source(IRC_S25_E, quote = "such excess shall be a carryover to each of the 3 succeeding taxable years")
rule MccCreditCarryoverArises(taxpayer: Individual, y: TaxableYear, credit: Money, cap: Money, ny: TaxableYear) strict {
    label en official "the excess of the MCC credit over the applicable tax limit carries over for up to 3 succeeding years";
    when mortgage_credit_certificate_credit(taxpayer, y, credit);
    when section_25_applicable_tax_limit(taxpayer, y, cap);
    when credit > cap;
    when next_taxable_year_25(y, ny);
    then mcc_credit_carryover(taxpayer, y, ny, credit - cap);
}
relation next_taxable_year_25(y: TaxableYear, ny: TaxableYear) kind institutional {
    label en official "the taxable year immediately succeeding this one — dependency contract, producer: core/temporal (pending), shared need with 23-adoption-credit.law's next_taxable_year";
}

// §25(e)(2)-(5): the anti-abuse certification requirement, the effective
// period of a certificate, and reissuance are further qualifications of
// `valid_mortgage_credit_certificate` itself, not separate dispositions of
// this package's own arithmetic — recorded as EXTERNAL_DEPENDENCY (same
// pending producer as the certificate fact).

// --- §25(f)(1): regulation reader (IRC-G/G4, CFR wiring 27.09.2026) ---------
// The "procedural requirements with respect to volume limitations prescribed
// by the Secretary" are 26 CFR 1.25-5T (esp. paragraph (d): the State-ceiling
// 1.25-times-correction mechanism mirroring this paragraph), pinned phase-0
// as us.cfr.t26_1_25_5t — addressable, rule-less, not yet a dependency
// (registry/lock gap, cfr-wire STATUS). Two case-selected relations name the
// regulation content as applied (procedures satisfied; (d)(2) aggregate
// requirements failed); the rule derives the treated-as-satisfied consequence
// with the ceiling reduction. No amounts are computed here (program
// administration, not a taxpayer computation; no numbers in .law beyond the
// verbatim statutory keys). Coverage row 26/25/f/1/u1 stays
// EXTERNAL_DEPENDENCY (flip only after execution, owner gate step 6).

relation mcc_program_satisfies_secretary_volume_procedures_25f1(program: Person, y: TaxableYear) kind empirical {
    label en official "section 25(f)(1): this mortgage credit certificate program satisfies the Secretary's procedural requirements with respect to volume limitations for the calendar year (case-selected: the 26 CFR 1.25-5T content enters as case facts)";
}
relation mcc_program_fails_d2_aggregate_requirements_25f1(program: Person, y: TaxableYear) kind empirical {
    label en official "section 25(f)(1): this program fails to meet the requirements of subsection (d)(2) for the calendar year (case-selected)";
}
pub relation mcc_program_requirements_treated_satisfied_with_ceiling_reduction_25f1(program: Person, y: TaxableYear) kind institutional {
    label en official "section 25(f)(1): the (d)(2) requirements are treated as satisfied for the program's certified indebtedness, and the applicable section 146(d) State ceiling is reduced for the following year";
}
@source(IRC_S25_F, relation = formalizes, coverage = partial, quote = "If for any calendar year any mortgage credit certificate program which satisfies procedural requirements with respect to volume limitations prescribed by the Secretary fails to meet the requirements of paragraph (2) of subsection (d), such requirements shall be treated as satisfied with respect to any certified indebtedness of such program, but the applicable State ceiling under subsection (d) of section 146 for the State in which such program operates shall be reduced by 1.25 times the correction amount with respect to such failure.")
rule S25f1VolumeFailureTreatedSatisfied strict {
    label en official "section 25(f)(1): a procedurally compliant program that fails (d)(2) is treated as satisfied with a State-ceiling reduction";
    for program: Person;
    for y: TaxableYear;
    when mcc_program_satisfies_secretary_volume_procedures_25f1(program, y);
    when mcc_program_fails_d2_aggregate_requirements_25f1(program, y);
    then mcc_program_requirements_treated_satisfied_with_ceiling_reduction_25f1(program, y);
}
