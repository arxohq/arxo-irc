// Section 45D — New markets tax credit. Stage 2d (IRC-06, DECISION-0379).
//
// Editions by `legal_time` (`effective` windows; PL 119-21 section 70423 is
// pinned as `us.irc.temporal::PL119_21_S70423`, enacted 2025-07-04): the 2024
// text sets the annual new markets tax credit limitation for calendar years
// 2020 through 2025 ($5,000,000,000); from 2025-07-04 the limitation is
// $5,000,000,000 for each calendar year after 2019. The carryover sentence of
// (f)(3) (base: no carry to a year after 2030; PL 119-21: not after the fifth
// calendar year after the year of the excess, pre-2026 excesses treated as
// 2025) is a SOURCE_GAP row: the carryover computation is not modelled
// (TECH-GAPS G1778).
//
// Scope / judgment calls:
// * (a): on each credit allowance date (the original issue date and its 6
//   anniversaries) in the taxable year the credit is the applicable percentage
//   (5 percent for the first 3 dates, 6 percent for the rest) of the amount paid
//   for the investment at original issue.
// * (b): a qualified equity investment: acquired at original issue solely for
//   cash, substantially all of the cash (85 percent of gross assets is the
//   safe harbor of (b)(3)) used for qualified low-income community
//   investments, designated by the entity, issued within 5 years of the
//   allocation and within the allocated limitation. (c)-(e): entity
//   certification, qualified active low-income community business tests and
//   low-income community tracts are computed from asserted facts where numeric.
// * (f): the Secretary allocates the limitation among entities: a POWER whose
//   validity is that the total allocated for the year does not exceed the limit.
//   The selection priorities are evaluative (G1778).
// * (g): recapture on a recapture event within 7 years of original issue: the
//   tax is increased by the prior credit decrease plus interest (both
//   case-asserted); the tax benefit rule is not applied (G1778).
// * (h): the basis reduction is exposed as an amount.

use self::{
    Asset,
    IRC_S45D_A,
    IRC_S45D_B,
    IRC_S45D_D,
    IRC_S45D_E,
    IRC_S45D_F,
    IRC_S45D_G,
    Person,
    TaxableYear,
};

pub relation acquired_at_original_issue_solely_for_cash_45d(taxpayer: Person, investment: Asset) kind empirical {
    label en official "the equity investment is acquired by the taxpayer at its original issue (directly or through an underwriter) solely in exchange for cash (section 45D(b)(1)(A)), or would be but for that test in the hands of a prior holder (section 45D(b)(4)) — case-asserted";
}
pub relation cde_gross_assets_in_qlici_percent_45d(investment: Asset, percent: Decimal) kind empirical {
    label en official "the percentage of the aggregate gross assets of the qualified community development entity invested in qualified low-income community investments (section 45D(b)(3) safe harbor) — case-asserted";
}
pub relation cash_used_for_qlici_substantially_all_45d(investment: Asset) kind empirical {
    label en official "substantially all of the cash is used by the entity to make qualified low-income community investments (section 45D(b)(1)(B)) — case-asserted";
}
pub relation designated_by_cde_45d(investment: Asset) kind empirical {
    label en official "the investment is designated for purposes of section 45D by the qualified community development entity (section 45D(b)(1)(C)) — case-asserted";
}
pub relation investment_in_cde_45d(investment: Asset, cde: Person) kind empirical {
    label en official "the equity investment (stock other than nonqualified preferred stock, or a capital interest in a partnership) is in this qualified community development entity (section 45D(b)(6)) — case-asserted";
}
pub relation issued_on_45d(investment: Asset, on: Date) kind empirical {
    label en official "the date the equity investment is originally issued — case-asserted";
}
pub relation cde_allocation_received_on_45d(cde: Person, on: Date) kind empirical {
    label en official "the date the entity receives an allocation under section 45D(f) — case-asserted";
}
pub relation designated_amount_within_allocation_45d(investment: Asset) kind empirical {
    label en official "the equity investments designated by the entity do not exceed the portion of the limitation allocated to it (section 45D(b)(2)) — case-asserted";
}
pub relation amount_paid_at_original_issue_45d(investment: Asset, amount: Money) kind empirical {
    label en official "the amount paid to the entity for the investment at its original issue (section 45D(a)(1)) — case-asserted";
}
pub relation cde_is_qualified_45d(cde: Person) kind empirical {
    label en official "the entity is a domestic corporation or partnership whose primary mission is serving low-income communities or persons, accountable to residents, and certified by the Secretary, or a specialized small business investment company or community development financial institution (section 45D(c)) — case-asserted";
}

// --- (b)(1): qualified equity investment ----------------------------------------------------------------------------------

pub relation qualified_equity_investment_45d(taxpayer: Person, investment: Asset) kind institutional {
    label en official "section 45D(b)(1): an equity investment in a qualified community development entity acquired at original issue for cash, with the cash used for qualified low-income community investments, designated, issued within 5 years of the allocation";
}
@source(IRC_S45D_B, quote = "such investment is designated for purposes of this section by the qualified community development entity")
rule QualifiedEquityInvestment45dRule(taxpayer: Person, investment: Asset, cde: Person, issued: Date, allocated: Date) strict {
    when acquired_at_original_issue_solely_for_cash_45d(taxpayer, investment);
    when investment_in_cde_45d(investment, cde);
    when cde_is_qualified_45d(cde);
    when cash_used_for_qlici_substantially_all_45d(investment);
    when designated_by_cde_45d(investment);
    when designated_amount_within_allocation_45d(investment);
    when issued_on_45d(investment, issued);
    when cde_allocation_received_on_45d(cde, allocated);
    when issued <= add_calendar_period(allocated, 60 calendar_month);
    then qualified_equity_investment_45d(taxpayer, investment);
}
@source(IRC_S45D_B, quote = "The requirement of paragraph (1)(B) shall be treated as met if at least 85 percent of the aggregate gross assets of the qualified community development entity are invested in qualified low-income community investments.")
rule QualifiedEquityInvestmentSafeHarbor45dRule(taxpayer: Person, investment: Asset, cde: Person, issued: Date, allocated: Date, pct: Decimal) strict {
    when acquired_at_original_issue_solely_for_cash_45d(taxpayer, investment);
    when investment_in_cde_45d(investment, cde);
    when cde_is_qualified_45d(cde);
    when cde_gross_assets_in_qlici_percent_45d(investment, pct);
    when pct >= 85.0;
    when designated_by_cde_45d(investment);
    when designated_amount_within_allocation_45d(investment);
    when issued_on_45d(investment, issued);
    when cde_allocation_received_on_45d(cde, allocated);
    when issued <= add_calendar_period(allocated, 60 calendar_month);
    then qualified_equity_investment_45d(taxpayer, investment);
}

// --- (a)(3), (a)(2): credit allowance dates and applicable percentage -----------------------------------------------------

pub relation credit_allowance_number_45d(taxpayer: Person, investment: Asset, y: TaxableYear, number: Decimal) kind institutional {
    label en official "section 45D(a)(3): the credit allowance date (1 = the original issue date, 2-7 = the 6 anniversaries) that falls in the taxable year";
}
rule CreditAllowanceDate145dRule(taxpayer: Person, investment: Asset, y: TaxableYear, issued: Date, begin: Date, finish: Date) strict {
    when qualified_equity_investment_45d(taxpayer, investment);
    when issued_on_45d(investment, issued);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when add_calendar_period(issued, 0 calendar_month) >= begin;
    when add_calendar_period(issued, 0 calendar_month) <= finish;
    then credit_allowance_number_45d(taxpayer, investment, y, 1.0);
}
rule CreditAllowanceDate245dRule(taxpayer: Person, investment: Asset, y: TaxableYear, issued: Date, begin: Date, finish: Date) strict {
    when qualified_equity_investment_45d(taxpayer, investment);
    when issued_on_45d(investment, issued);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when add_calendar_period(issued, 12 calendar_month) >= begin;
    when add_calendar_period(issued, 12 calendar_month) <= finish;
    then credit_allowance_number_45d(taxpayer, investment, y, 2.0);
}
rule CreditAllowanceDate345dRule(taxpayer: Person, investment: Asset, y: TaxableYear, issued: Date, begin: Date, finish: Date) strict {
    when qualified_equity_investment_45d(taxpayer, investment);
    when issued_on_45d(investment, issued);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when add_calendar_period(issued, 24 calendar_month) >= begin;
    when add_calendar_period(issued, 24 calendar_month) <= finish;
    then credit_allowance_number_45d(taxpayer, investment, y, 3.0);
}
rule CreditAllowanceDate445dRule(taxpayer: Person, investment: Asset, y: TaxableYear, issued: Date, begin: Date, finish: Date) strict {
    when qualified_equity_investment_45d(taxpayer, investment);
    when issued_on_45d(investment, issued);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when add_calendar_period(issued, 36 calendar_month) >= begin;
    when add_calendar_period(issued, 36 calendar_month) <= finish;
    then credit_allowance_number_45d(taxpayer, investment, y, 4.0);
}
rule CreditAllowanceDate545dRule(taxpayer: Person, investment: Asset, y: TaxableYear, issued: Date, begin: Date, finish: Date) strict {
    when qualified_equity_investment_45d(taxpayer, investment);
    when issued_on_45d(investment, issued);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when add_calendar_period(issued, 48 calendar_month) >= begin;
    when add_calendar_period(issued, 48 calendar_month) <= finish;
    then credit_allowance_number_45d(taxpayer, investment, y, 5.0);
}
rule CreditAllowanceDate645dRule(taxpayer: Person, investment: Asset, y: TaxableYear, issued: Date, begin: Date, finish: Date) strict {
    when qualified_equity_investment_45d(taxpayer, investment);
    when issued_on_45d(investment, issued);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when add_calendar_period(issued, 60 calendar_month) >= begin;
    when add_calendar_period(issued, 60 calendar_month) <= finish;
    then credit_allowance_number_45d(taxpayer, investment, y, 6.0);
}
rule CreditAllowanceDate745dRule(taxpayer: Person, investment: Asset, y: TaxableYear, issued: Date, begin: Date, finish: Date) strict {
    when qualified_equity_investment_45d(taxpayer, investment);
    when issued_on_45d(investment, issued);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when add_calendar_period(issued, 72 calendar_month) >= begin;
    when add_calendar_period(issued, 72 calendar_month) <= finish;
    then credit_allowance_number_45d(taxpayer, investment, y, 7.0);
}
pub relation applicable_percentage_45d(number: Decimal, pct: Decimal) kind institutional {
    label en official "section 45D(a)(2): 5 percent for the first 3 credit allowance dates, 6 percent for the rest";
}
@source(IRC_S45D_A, quote = "5 percent with respect to the first 3 credit allowance dates")
rule ApplicablePercentageFirstThree45dRule(number: Decimal) strict {
    when credit_allowance_number_45d(_, _, _, number);
    when number <= 3.0;
    when number >= 1.0;
    then applicable_percentage_45d(number, 0.05);
}
@source(IRC_S45D_A, quote = "6 percent with respect to the remainder of the credit allowance dates")
rule ApplicablePercentageRemainder45dRule(number: Decimal) strict {
    when credit_allowance_number_45d(_, _, _, number);
    when number > 3.0;
    when number <= 7.0;
    then applicable_percentage_45d(number, 0.06);
}
pub relation new_markets_credit_per_investment_45d(taxpayer: Person, investment: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45D(a)(1): the applicable percentage of the amount paid at original issue, for a credit allowance date in the taxable year";
}
@source(IRC_S45D_A, quote = "the new markets tax credit determined under this section for such taxable year is an amount equal to the applicable percentage of the amount paid to the qualified community development entity for such investment at its original issue")
rule NewMarketsCreditPerInvestment45dRule(taxpayer: Person, investment: Asset, y: TaxableYear, number: Decimal, pct: Decimal, paid: Money) defeasible {
    when credit_allowance_number_45d(taxpayer, investment, y, number);
    when applicable_percentage_45d(number, pct);
    when amount_paid_at_original_issue_45d(investment, paid);
    then new_markets_credit_per_investment_45d(taxpayer, investment, y, round(pct * paid, 2, "HALF_UP"));
}
pub relation new_markets_tax_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45D new markets tax credit for the taxable year (a section 38(b)(13) component)";
}
rule NewMarketsTaxCredit45dRule(taxpayer: Person, y: TaxableYear, investment: Asset, amount: Money) defeasible {
    when new_markets_credit_per_investment_45d(taxpayer, investment, y, amount);
    then new_markets_tax_credit(taxpayer, y,
        sum(collect all a: Money, i: Asset where new_markets_credit_per_investment_45d(taxpayer, i, y, a), empty: 0 USD));
}

// --- (f): the annual limitation and the Secretary's allocation ------------------------------------------------------------

pub relation calendar_year_of_allocation_45d(cde: Person, year: Decimal) kind empirical {
    label en official "the calendar year for which the Secretary allocates limitation to the entity — case-asserted";
}
pub relation total_allocated_for_year_45d(year: Decimal, total: Money) kind empirical {
    label en official "the aggregate limitation allocated by the Secretary for the calendar year, including this allocation — case-asserted";
}
pub relation annual_limitation_45d(year: Decimal, amount: Money) kind institutional {
    label en official "section 45D(f)(1): the new markets tax credit limitation for the calendar year";
}
@source(IRC_S45D_F, quote = "$1,000,000,000 for 2001")
rule AnnualLimitation2001Rule(year: Decimal) strict {
    when total_allocated_for_year_45d(year, _);
    when year == 2001.0;
    then annual_limitation_45d(year, 1000000000.00 USD);
}
@source(IRC_S45D_F, quote = "$1,500,000,000 for 2002 and 2003")
rule AnnualLimitation20022003Rule(year: Decimal) strict {
    when total_allocated_for_year_45d(year, _);
    when year >= 2002.0;
    when year <= 2003.0;
    then annual_limitation_45d(year, 1500000000.00 USD);
}
@source(IRC_S45D_F, quote = "$2,000,000,000 for 2004 and 2005")
rule AnnualLimitation20042005Rule(year: Decimal) strict {
    when total_allocated_for_year_45d(year, _);
    when year >= 2004.0;
    when year <= 2005.0;
    then annual_limitation_45d(year, 2000000000.00 USD);
}
@source(IRC_S45D_F, quote = "$3,500,000,000 for 2006 and 2007")
rule AnnualLimitation20062007Rule(year: Decimal) strict {
    when total_allocated_for_year_45d(year, _);
    when year >= 2006.0;
    when year <= 2007.0;
    then annual_limitation_45d(year, 3500000000.00 USD);
}
@source(IRC_S45D_F, quote = "$5,000,000,000 for 2008")
rule AnnualLimitation20082009Rule(year: Decimal) strict {
    when total_allocated_for_year_45d(year, _);
    when year >= 2008.0;
    when year <= 2009.0;
    then annual_limitation_45d(year, 5000000000.00 USD);
}
@source(IRC_S45D_F, quote = "$3,500,000,000 for each of calendar years 2010 through 2019")
rule AnnualLimitation20102019Rule(year: Decimal) strict {
    when total_allocated_for_year_45d(year, _);
    when year >= 2010.0;
    when year <= 2019.0;
    then annual_limitation_45d(year, 3500000000.00 USD);
}
@source(IRC_S45D_F, quote = "$5,000,000,000 for for [2] each of calendar years 2020 through 2025")
rule AnnualLimitation20202025Rule(year: Decimal) strict {
    when total_allocated_for_year_45d(year, _);
    when year >= 2020.0;
    when year <= 2025.0;
    then annual_limitation_45d(year, 5000000000.00 USD);
}
@source(us.irc.temporal::PL119_21_S70423, quote = "Section 45D(f)(1)(H) is amended by striking “for for each of calendar years 2020 through 2025” and inserting “ for each calendar year after 2019”.")
rule AnnualLimitationAfter2025Rule(year: Decimal) strict {
    effective [@2025-07-04, infinity);
    when total_allocated_for_year_45d(year, _);
    when year > 2025.0;
    then annual_limitation_45d(year, 5000000000.00 USD);
}
pub relation allocation_within_limitation_45d(cde: Person, year: Decimal) kind institutional {
    label en official "section 45D(f)(1)-(2): the aggregate allocated for the calendar year does not exceed the limitation";
}
rule AllocationWithinLimitation45dRule(cde: Person, year: Decimal, total: Money, limit: Money) strict {
    when calendar_year_of_allocation_45d(cde, year);
    when total_allocated_for_year_45d(year, total);
    when annual_limitation_45d(year, limit);
    when total <= limit;
    then allocation_within_limitation_45d(cde, year);
}
pub relation secretary_allocates_limitation_45d(cde: Person, year: Decimal) kind empirical {
    label en official "the Secretary's allocation of the new markets tax credit limitation for the calendar year to the entity — the exercise of the allocation power";
}
pub relation limitation_allocated_to_cde_45d(cde: Person, year: Decimal) kind institutional {
    label en official "section 45D(f)(2): the Secretary has allocated limitation for the year to the entity";
}
@source(IRC_S45D_F, quote = "The limitation under paragraph (1) shall be allocated by the Secretary among qualified community development entities selected by the Secretary.")
rule Section45dF2AllocationRule(cde: Person, year: Decimal) strict {
    when secretary_allocates_limitation_45d(cde, year);
    then power Section45dF2Allocation {
        holder us.irc.core::Secretary;
        over cde;
        exercise secretary_allocates_limitation_45d(cde, year);
        valid_when allocation_within_limitation_45d(cde, year);
        effect create(limitation_allocated_to_cde_45d(cde, year));
        window [@2000-12-21, infinity);
    };
}

// --- (g): recapture ---------------------------------------------------------------------------------------------------------------------------

pub relation cde_ceases_to_be_qualified_45d(investment: Asset, on: Date) kind empirical {
    label en official "the entity ceases to be a qualified community development entity, on this date (section 45D(g)(3)(A)) — case-asserted";
}
pub relation proceeds_cease_to_be_used_as_required_45d(investment: Asset, on: Date) kind empirical {
    label en official "the proceeds of the investment cease to be used as required by subsection (b)(1)(B), on this date (section 45D(g)(3)(B)) — case-asserted";
}
pub relation investment_redeemed_45d(investment: Asset, on: Date) kind empirical {
    label en official "the investment is redeemed by the entity, on this date (section 45D(g)(3)(C)) — case-asserted";
}
pub relation prior_credit_decrease_45d(taxpayer: Person, investment: Asset, amount: Money) kind empirical {
    label en official "the aggregate decrease in the section 38 credits for all prior taxable years if no credit had been determined under section 45D for the investment (section 45D(g)(2)(A)) — case-asserted";
}
pub relation interest_on_credit_decrease_45d(taxpayer: Person, investment: Asset, amount: Money) kind empirical {
    label en official "interest at the section 6621 underpayment rate on the decrease for each prior taxable year from the return due date (section 45D(g)(2)(B)) — case-asserted, the underpayment rates are not pinned";
}
relation recapture_event_date_45d(investment: Asset, on: Date) kind institutional;
rule RecaptureEventCeasesQualified45dRule(investment: Asset, on: Date) strict {
    when cde_ceases_to_be_qualified_45d(investment, on);
    then recapture_event_date_45d(investment, on);
}
rule RecaptureEventProceeds45dRule(investment: Asset, on: Date) strict {
    when proceeds_cease_to_be_used_as_required_45d(investment, on);
    then recapture_event_date_45d(investment, on);
}
rule RecaptureEventRedeemed45dRule(investment: Asset, on: Date) strict {
    when investment_redeemed_45d(investment, on);
    then recapture_event_date_45d(investment, on);
}
pub relation recapture_event_within_seven_years_45d(investment: Asset) kind institutional {
    label en official "section 45D(g)(1): a recapture event during the 7-year period beginning on the date of original issue";
}
@source(IRC_S45D_G, quote = "If, at any time during the 7-year period beginning on the date of the original issue of a qualified equity investment in a qualified community development entity, there is a recapture event with respect to such investment")
rule RecaptureEventWithinSevenYears45dRule(investment: Asset, issued: Date, occurred: Date) strict {
    when recapture_event_date_45d(investment, occurred);
    when issued_on_45d(investment, issued);
    when occurred >= issued;
    when occurred < add_calendar_period(issued, 84 calendar_month);
    then recapture_event_within_seven_years_45d(investment);
}
pub relation credit_recapture_amount_45d(taxpayer: Person, investment: Asset, amount: Money) kind institutional {
    label en official "section 45D(g)(1)-(2): the tax for the year of the event is increased by the prior credit decrease plus interest";
}
@source(IRC_S45D_G, quote = "the credit recapture amount is an amount equal to the sum of")
rule CreditRecaptureAmount45dRule(taxpayer: Person, investment: Asset, decrease: Money, interest: Money) defeasible {
    when recapture_event_within_seven_years_45d(investment);
    when prior_credit_decrease_45d(taxpayer, investment, decrease);
    when interest_on_credit_decrease_45d(taxpayer, investment, interest);
    then credit_recapture_amount_45d(taxpayer, investment, decrease + interest);
}
pub relation recapture_interest_nondeductible_45d(taxpayer: Person, investment: Asset, amount: Money) kind institutional {
    label en official "section 45D(g)(2)(B): no deduction for the interest";
}
rule RecaptureInterestNondeductible45dRule(taxpayer: Person, investment: Asset, amount: Money) defeasible {
    when recapture_event_within_seven_years_45d(investment);
    when interest_on_credit_decrease_45d(taxpayer, investment, amount);
    then recapture_interest_nondeductible_45d(taxpayer, investment, amount);
}
pub relation basis_reduction_45d(taxpayer: Person, investment: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45D(h): the basis of the qualified equity investment is reduced by the credit (exposed as an amount; not applied to a basis ledger)";
}
rule BasisReduction45dRule(taxpayer: Person, investment: Asset, y: TaxableYear, amount: Money) defeasible {
    when new_markets_credit_per_investment_45d(taxpayer, investment, y, amount);
    then basis_reduction_45d(taxpayer, investment, y, amount);
}

// --- (e): low-income community tracts -----------------------------------------------------------------------------------------------------------

pub relation tract_poverty_rate_45d(tract: Asset, percent: Decimal) kind empirical {
    label en official "the poverty rate of the population census tract, in percent (section 45D(e)(1)(A)) — case-asserted";
}
pub relation tract_in_metropolitan_area_45d(tract: Asset) kind empirical {
    label en official "the tract is located within a metropolitan area — case-asserted";
}
pub relation tract_high_migration_rural_county_45d(tract: Asset) kind empirical {
    label en official "the tract is in a high migration rural county (section 45D(e)(5)) — case-asserted";
}
pub relation tract_median_family_income_45d(tract: Asset, amount: Money) kind empirical {
    label en official "the median family income of the tract — case-asserted";
}
pub relation statewide_median_family_income_45d(tract: Asset, amount: Money) kind empirical {
    label en official "the statewide (or possessionwide) median family income for the tract — case-asserted";
}
pub relation metropolitan_median_family_income_45d(tract: Asset, amount: Money) kind empirical {
    label en official "the metropolitan area median family income for a tract in a metropolitan area — case-asserted";
}
pub relation low_income_community_45d(tract: Asset) kind institutional {
    label en official "section 45D(e)(1): a population census tract with a poverty rate of at least 20 percent, or a median family income of at most 80 percent (85 percent in a high migration rural county) of the applicable benchmark";
}
@source(IRC_S45D_E, quote = "the poverty rate for such tract is at least 20 percent")
rule LowIncomeCommunityPoverty45dRule(tract: Asset, rate: Decimal) strict {
    when tract_poverty_rate_45d(tract, rate);
    when rate >= 20.0;
    then low_income_community_45d(tract);
}
@source(IRC_S45D_E, quote = "in the case of a tract not located within a metropolitan area, the median family income for such tract does not exceed 80 percent of statewide median family income")
rule LowIncomeCommunityNonMetro45dRule(tract: Asset, income: Money, state: Money) strict {
    when not_known(tract_in_metropolitan_area_45d(tract));
    when not_known(tract_high_migration_rural_county_45d(tract));
    when tract_median_family_income_45d(tract, income);
    when statewide_median_family_income_45d(tract, state);
    when income <= 0.80 * state;
    then low_income_community_45d(tract);
}
@source(IRC_S45D_E, quote = "substituting \"85 percent\" for \"80 percent\"")
rule LowIncomeCommunityHighMigration45dRule(tract: Asset, income: Money, state: Money) strict {
    when not_known(tract_in_metropolitan_area_45d(tract));
    when tract_high_migration_rural_county_45d(tract);
    when tract_median_family_income_45d(tract, income);
    when statewide_median_family_income_45d(tract, state);
    when income <= 0.85 * state;
    then low_income_community_45d(tract);
}
@source(IRC_S45D_E, quote = "the median family income for such tract does not exceed 80 percent of the greater of statewide median family income or the metropolitan area median family income")
rule LowIncomeCommunityMetro45dRule(tract: Asset, income: Money, state: Money, metro: Money) strict {
    when tract_in_metropolitan_area_45d(tract);
    when tract_median_family_income_45d(tract, income);
    when statewide_median_family_income_45d(tract, state);
    when metropolitan_median_family_income_45d(tract, metro);
    when income <= 0.80 * max(state, metro);
    then low_income_community_45d(tract);
}

// --- (d)(2): qualified active low-income community business --------------------------------------------------------------------------------------

pub relation business_gross_income_share_from_low_income_community_45d(business: Person, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the entity's total gross income derived from the active conduct of a qualified business within a low-income community (section 45D(d)(2)(A)(i)) — case-asserted";
}
pub relation business_tangible_property_and_services_in_low_income_community_45d(business: Person, y: TaxableYear) kind empirical {
    label en official "a substantial portion of the use of the entity's tangible property and of the services performed by its employees is within a low-income community (section 45D(d)(2)(A)(ii)-(iii)) — case-asserted";
}
pub relation business_collectibles_share_of_basis_45d(business: Person, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the average aggregate unadjusted bases of the entity's property attributable to collectibles other than those held primarily for sale (section 45D(d)(2)(A)(iv)) — case-asserted";
}
pub relation business_nonqualified_financial_property_share_45d(business: Person, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the average aggregate unadjusted bases attributable to nonqualified financial property under section 1397C(e) (section 45D(d)(2)(A)(v)) — case-asserted";
}
pub relation qualified_active_low_income_community_business_45d(business: Person, y: TaxableYear) kind institutional {
    label en official "section 45D(d)(2)(A): a corporation or partnership meeting the five conditions for the year";
}
@source(IRC_S45D_D, quote = "at least 50 percent of the total gross income of such entity is derived from the active conduct of a qualified business within any low-income community")
rule QualifiedActiveBusiness45dRule(business: Person, y: TaxableYear, income_share: Decimal, collectibles: Decimal, financial: Decimal) strict {
    when business_gross_income_share_from_low_income_community_45d(business, y, income_share);
    when income_share >= 50.0;
    when business_tangible_property_and_services_in_low_income_community_45d(business, y);
    when business_collectibles_share_of_basis_45d(business, y, collectibles);
    when collectibles < 5.0;
    when business_nonqualified_financial_property_share_45d(business, y, financial);
    when financial < 5.0;
    then qualified_active_low_income_community_business_45d(business, y);
}
