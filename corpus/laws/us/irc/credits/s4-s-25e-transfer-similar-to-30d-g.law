// Stage 4 (DECISION-0379 with deontics), credits, part S: section 25E(f) — rules similar to section
// 30D(g) (transfer of the credit to an eligible entity, the dealer) for the previously-owned clean vehicle
// credit. Closes the last row of G6416.
//
// The 30D(g) relations that are general (keyed by the dealer, the vehicle and the taxpayer, not by the
// section 30D credit) are READ by explicit reference: the dealer of (g)(8) (`dealer_30d`), the facts of
// the sale, the registration and the disclosure of the dealer, the election and its timeliness
// (`election_timely_30d`), the revocation of the dealer's registration (`dealer_registration_revoked_30d`),
// the payment received. What is keyed to the 30D credit is written for the 25E credit: the amount the dealer
// must have paid ((g)(2)(C): at least the credit otherwise allowable), the election power, the credit
// allowed to the eligible entity, the advance payment (the sum of the credits of the vehicles sold),
// its treatment as a refund, the exclusion of the payment from the taxpayer's gross income and its
// non-deductibility for the dealer, the VIN requirement, and the recapture when the credit would not be
// allowable (the income limit of section 25E(b)).

use self::{
    Asset,
    IRC_S25E_F,
    Individual,
    Person,
    TaxableYear,
    dealer_disclosed_on_30d,
    dealer_paid_taxpayer_on_30d,
    dealer_registered_with_secretary_30d,
    dealer_sold_vehicle_to_taxpayer_on_30d,
    election_made_on_30d,
    election_timely_30d,
    incentive_availability_and_election_not_limited_30d,
    payment_received_by_taxpayer_from_eligible_entity_30d,
    previously_owned_clean_vehicle_credit,
    taxpayer_elects_transfer_to_eligible_entity_30d,
    vin_provided_to_secretary_by_eligible_entity_30d,
};

pub relation eligible_entity_25e(dealer: Person, vehicle: Asset, taxpayer: Individual) kind institutional {
    label en official "the eligible entity of section 25E(f), by section 30D(g)(2): the dealer which sold the vehicle to the taxpayer, is registered with the Secretary, disclosed the credit to the taxpayer before the sale and the election, and paid the taxpayer at the sale at least the credit allowable under section 25E(a)";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule EligibleEntity25e(dealer: Person, vehicle: Asset, taxpayer: Individual, y: TaxableYear, sold: Date, disclosed: Date, elected: Date, paid_on: Date, paid: Money, credit: Money) defeasible {
    label en official "sold, registered, disclosed before the election and the sale, elected, paid at least the 25E credit at the sale (section 25E(f), by section 30D(g)(2))";
    when dealer_sold_vehicle_to_taxpayer_on_30d(dealer, vehicle, taxpayer, sold);
    when dealer_registered_with_secretary_30d(dealer);
    when dealer_disclosed_on_30d(dealer, vehicle, disclosed);
    when election_made_on_30d(taxpayer, vehicle, elected);
    when disclosed <= elected;
    when disclosed <= sold;
    when previously_owned_clean_vehicle_credit(taxpayer, vehicle, y, credit);
    when dealer_paid_taxpayer_on_30d(dealer, vehicle, paid_on, paid);
    when paid_on <= sold;
    when paid >= credit;
    when incentive_availability_and_election_not_limited_30d(dealer, vehicle);
    then eligible_entity_25e(dealer, vehicle, taxpayer);
}
pub relation credit_allowed_to_eligible_entity_25e(dealer: Person, vehicle: Asset, taxpayer: Individual) kind institutional {
    label en official "the credit which would (but for this subsection) be allowed to the taxpayer with respect to the vehicle is allowed to the eligible entity (section 25E(f), by section 30D(g)(1))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule Section25EFTransferElectionRule(taxpayer: Individual, vehicle: Asset, dealer: Person) defeasible {
    label en official "the taxpayer may elect to transfer the credit to the eligible entity, in time (section 25E(f), by section 30D(g)(1), (3))";
    when taxpayer_elects_transfer_to_eligible_entity_30d(taxpayer, vehicle, dealer);
    when eligible_entity_25e(dealer, vehicle, taxpayer);
    when election_timely_30d(taxpayer, vehicle);
    then power Section25EFCreditTransferElection {
        holder taxpayer;
        over dealer;
        exercise taxpayer_elects_transfer_to_eligible_entity_30d(taxpayer, vehicle, dealer);
        valid_when election_timely_30d(taxpayer, vehicle);
        effect create(credit_allowed_to_eligible_entity_25e(dealer, vehicle, taxpayer));
        window [-infinity, infinity);
    };
}
relation transfer_elected_and_valid_25e(taxpayer: Individual, vehicle: Asset, dealer: Person) kind institutional {
    label en official "the election is made, the dealer is an eligible entity and the election is timely";
}
rule TransferElectedAndValid25eRule(taxpayer: Individual, vehicle: Asset, dealer: Person) defeasible {
    label en official "election + eligible entity + timeliness";
    when taxpayer_elects_transfer_to_eligible_entity_30d(taxpayer, vehicle, dealer);
    when eligible_entity_25e(dealer, vehicle, taxpayer);
    when election_timely_30d(taxpayer, vehicle);
    then transfer_elected_and_valid_25e(taxpayer, vehicle, dealer);
}
pub relation credit_not_allowed_to_taxpayer_after_transfer_25e(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "no credit is allowed to the taxpayer for the vehicle after a valid transfer (section 25E(f), by section 30D(g)(1))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule CreditNotAllowedToTaxpayerAfterTransfer25eRule(taxpayer: Individual, vehicle: Asset, dealer: Person) defeasible {
    label en official "transferred: not allowed to the taxpayer";
    when transfer_elected_and_valid_25e(taxpayer, vehicle, dealer);
    then credit_not_allowed_to_taxpayer_after_transfer_25e(taxpayer, vehicle);
}
pub relation payment_excluded_from_gross_income_25e(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional {
    label en official "the payment received by the taxpayer from the eligible entity is not includible in gross income (section 25E(f), by section 30D(g)(5))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule PaymentExcludedFromGrossIncome25eRule(taxpayer: Individual, vehicle: Asset, dealer: Person, amount: Money) defeasible {
    label en official "the eligible entity's payment is excluded from gross income";
    when payment_received_by_taxpayer_from_eligible_entity_30d(taxpayer, vehicle, dealer, amount);
    when eligible_entity_25e(dealer, vehicle, taxpayer);
    then payment_excluded_from_gross_income_25e(taxpayer, vehicle, amount);
}
pub relation payment_not_deductible_by_dealer_25e(dealer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "the payment made by the eligible entity is not deductible by the dealer (section 25E(f), by section 30D(g)(5))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule PaymentNotDeductibleByDealer25eRule(taxpayer: Individual, vehicle: Asset, dealer: Person, amount: Money) defeasible {
    label en official "the dealer's payment is not deductible";
    when payment_received_by_taxpayer_from_eligible_entity_30d(taxpayer, vehicle, dealer, amount);
    when eligible_entity_25e(dealer, vehicle, taxpayer);
    then payment_not_deductible_by_dealer_25e(dealer, vehicle, amount);
}
pub relation vin_requirement_treated_as_satisfied_25e(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "the VIN requirement of section 25E(d) is treated as satisfied if the eligible entity provides the vehicle identification number to the Secretary (section 25E(f), by section 30D(g)(6))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule VinRequirementTreatedAsSatisfied25eRule(taxpayer: Individual, vehicle: Asset, dealer: Person) defeasible {
    label en official "the dealer provides the VIN";
    when transfer_elected_and_valid_25e(taxpayer, vehicle, dealer);
    when vin_provided_to_secretary_by_eligible_entity_30d(dealer, vehicle);
    then vin_requirement_treated_as_satisfied_25e(taxpayer, vehicle);
}
pub relation credit_allowed_amount_for_elected_vehicle_25e(dealer: Person, vehicle: Asset, amount: Money) kind empirical {
    label en official "the credit allowed under section 25E(a) with respect to a vehicle sold by the eligible entity for which the transfer was elected (section 25E(f), by section 30D(g)(7)) — case-asserted";
}
pub relation advance_payment_amount_25e(dealer: Person, amount: Money) kind institutional {
    label en official "the advance payment to the eligible entity: the cumulative amount of the credits allowed under section 25E(a) with respect to the vehicles sold for which the transfer was elected (section 25E(f), by section 30D(g)(7))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule AdvancePaymentAmount25eRule(dealer: Person, one_vehicle: Asset, one_amount: Money) strict {
    label en official "sum of the credits of the elected vehicles";
    when credit_allowed_amount_for_elected_vehicle_25e(dealer, one_vehicle, one_amount);
    then advance_payment_amount_25e(dealer, sum(collect all a: Money, v: Asset where credit_allowed_amount_for_elected_vehicle_25e(dealer, v, a), empty: 0 USD));
}
pub relation advance_payment_treated_as_refund_25e(dealer: Person) kind institutional {
    label en official "the advance payments are treated in the same manner as a refund due from a credit provision referred to in section 1324(b)(2) (section 25E(f), by section 30D(g)(7))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule AdvancePaymentTreatedAsRefund25eRule(dealer: Person, amount: Money) strict {
    label en official "refund treatment";
    when advance_payment_amount_25e(dealer, amount);
    then advance_payment_treated_as_refund_25e(dealer);
}
pub relation credit_disallowed_under_25eb_25e(taxpayer: Individual, vehicle: Asset) kind empirical {
    label en official "the credit would otherwise, but for the transfer, not be allowable to the taxpayer because of the income limitation of section 25E(b) (rule similar to section 30D(g)(10)) — case-asserted";
}
pub relation tax_increase_for_recapture_of_payment_25e(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional {
    label en official "for a taxpayer who made the election and received the payment, if the credit would otherwise not be allowable, the tax for the year the vehicle was acquired is increased by the payment received (section 25E(f), by section 30D(g)(10))";
}
@source(IRC_S25E_F, quote = "Rules similar to the rules of section 30D(g) shall apply.")
rule TaxIncreaseForRecaptureOfPayment25eRule(taxpayer: Individual, vehicle: Asset, dealer: Person, amount: Money) defeasible {
    label en official "recapture of the payment when the credit would not be allowable";
    when transfer_elected_and_valid_25e(taxpayer, vehicle, dealer);
    when payment_received_by_taxpayer_from_eligible_entity_30d(taxpayer, vehicle, dealer, amount);
    when credit_disallowed_under_25eb_25e(taxpayer, vehicle);
    then tax_increase_for_recapture_of_payment_25e(taxpayer, vehicle, amount);
}
