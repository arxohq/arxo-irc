// Sections 45Y and 48E — the inflation adjustment (45Y(c)), definitions (45Y(e)), guidance duties (45Y(f), 48E(i)),
// special rules (45Y(g)), and the 48E qualified investment (b), energy storage (c), phase-out (e), termination for
// greenhouse gas emissions (g) and environmental justice capacity increase (h). Stage 2e (IRC-06, DECISION-0379,
// TECH_GAP reduction of the stage 2c rows for 45Y(c), (e), (f), (g) and 48E(b)-(i)). Companion of
// `45y-48e-clean-electricity-credits.law`; that module's credit rules are NOT rewired to require these relations (its
// scenarios assert their inputs directly).
//
// Scope / judgment calls:
// * 45Y(c): the inflation adjustment factor is `inflation_adjustment_factor_45` of the 45 module (the same GDP deflator
//   ratio with base year 1992); the indexed amounts are rounded to the nearest multiple of 0.05 cent (0.3 cent amount)
//   and 0.1 cent (1.5 cent amount) HALF_UP.
// * 45Y(g)(11): the domestic content bonus is 10 percent of the credit determined without paragraph (7); the adjusted
//   percentage depends on the year in which the construction begins; the taxpayer's certification is a case fact.
// * 45Y(g)(12): the elective payment applicable percentage; the Secretary's exceptions of (D) are an external
//   judgment (DECISION-0194).
// * 45Y(g)(6): the cooperative apportionment is a power like 45(e)(11), with its own relations.
// * 45Y(g)(8), (9), (10) and 48E(d)(1)-(4) ("rules similar to" section 45(b)(3), (7), (8), 48(a)(10) and former
//   section 46(c)(4), (d)) stay TECH_GAP (analogical incorporation, TECH-GAPS G3811).
// * 48E(h): the annual capacity limitation is 1.8 GW for each calendar year from 2025 to the applicable year (a case
//   fact of the Secretary's determination under section 45Y(d)(3)), zero after; carryover is not allowed after the
//   third calendar year following the applicable year, and the 2024 excess of section 48(e)(4)(D) may be carried to 2025.

// --- 45Y(c): the inflation adjustment ------------------------------------------------------------------------------------------------------------------------

use self::{
    Asset,
    ControlledGroup,
    IRC_S45Y_C,
    IRC_S45Y_E,
    IRC_S45Y_F,
    IRC_S45Y_G,
    IRC_S48E_B,
    IRC_S48E_C,
    IRC_S48E_D,
    IRC_S48E_E,
    IRC_S48E_G,
    IRC_S48E_H,
    IRC_S48E_I,
    Person,
    TaxableYear,
    applicable_amount_cents_45y,
    chp_energy_efficiency_percentage_48,
    chp_property_transports_or_distributes_energy_48,
    chp_useful_power_share_48,
    chp_useful_thermal_share_48,
    chp_uses_same_energy_source_for_electric_or_mechanical_and_thermal_48,
    ej_capacity_excess_including_expiry_48eh,
    ej_capacity_excess_present_48eh,
    inflation_adjustment_factor_45,
    kilowatt_hours_produced_45y,
    primarily_used_in_transportation_and_not_for_electricity_48,
    receives_stores_delivers_energy_for_conversion_to_electricity_48,
    storage_nameplate_capacity_kwh_48,
    thermal_energy_storage_property_48,
    under_common_control_52b,
};

pub relation base_amount_cents_45y_c(year: Decimal, base_cents: Decimal, alternative_cents: Decimal) kind institutional {
    label en official "section 45Y(c)(1): for a calendar year after 2024 the 0.3 cent amount and the 1.5 cent amount are multiplied by the inflation adjustment factor, the first rounded to the nearest multiple of 0.05 cent and the second to the nearest multiple of 0.1 cent (HALF_UP)";
}
@source(IRC_S45Y_C, relation = formalizes, coverage = partial, quote = "In the case of a calendar year beginning after 2024, the 0.3 cent amount in paragraph (2)(A) of subsection (a) and the 1.5 cent amount in paragraph (2)(B) of such subsection shall each be adjusted by multiplying such amount by the inflation adjustment factor for the calendar year in which the sale, consumption, or storage of the electricity occurs.")
rule IndexedAmountsCents45yRule(year: Decimal, factor: Decimal) strict {
    when inflation_adjustment_factor_45(year, factor);
    when year > 2024.0;
    then base_amount_cents_45y_c(year, round(0.3 * factor / 0.05, 0, "HALF_UP") * 0.05, round(1.5 * factor / 0.1, 0, "HALF_UP") * 0.1);
}
pub relation calendar_year_april_first_45y(year: Decimal, on: Date) kind empirical {
    label en official "April 1 of the calendar year — calendar helper fact for the Secretary's publication deadline";
}
pub relation inflation_factor_published_45y(year: Decimal) kind empirical {
    label en official "the Secretary determined and published in the Federal Register the inflation adjustment factor for the calendar year (section 45Y(c)(2)) — case-asserted";
}
@source(IRC_S45Y_C, relation = formalizes, coverage = exact, quote = "The Secretary shall, not later than April 1 of each calendar year, determine and publish in the Federal Register the inflation adjustment factor for such calendar year in accordance with this subsection.")
rule Section45YC2SecretaryPublicationDutyRule(year: Decimal, deadline: Date) strict {
    when calendar_year_april_first_45y(year, deadline);
    then duty Section45YC2SecretaryPublicationDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition inflation_factor_published_45y(year);
            window [-infinity, deadline];
        }
    };
}

// --- 45Y(e): definitions ----------------------------------------------------------------------------------------------------------------------------------------

pub relation greenhouse_gas_co2e_grams_45y(facility: Asset, grams: Decimal) kind empirical {
    label en official "the equivalent carbon dioxide (determined by global warming potential) emitted by the facility, in grams for the electricity produced (section 45Y(e)(1)); \"greenhouse gas\" has the meaning of section 211(o)(1)(G) of the Clean Air Act as in effect on the enactment (section 45Y(e)(2)) — case-asserted";
}
pub relation kwh_electricity_produced_45y_e(facility: Asset, kwh: Decimal) kind empirical {
    label en official "the kilowatt hours of electricity produced (section 45Y(e)(1)) — case-asserted";
}
pub relation co2e_per_kwh_45y(facility: Asset, rate: Decimal) kind institutional {
    label en official "section 45Y(e)(1): the equivalent carbon dioxide per kilowatt hour of electricity produced (6 decimals HALF_UP judgment call)";
}
@source(IRC_S45Y_E, relation = formalizes, coverage = exact, quote = "The term \"CO2e per KWh\" means, with respect to any greenhouse gas, the equivalent carbon dioxide (as determined based on global warming potential) per kilowatt hour of electricity produced.")
rule Co2ePerKwh45yRule(facility: Asset, grams: Decimal, kwh: Decimal) strict {
    when greenhouse_gas_co2e_grams_45y(facility, grams);
    when kwh_electricity_produced_45y_e(facility, kwh);
    when kwh > 0.0;
    then co2e_per_kwh_45y(facility, div_round(grams, kwh, 6, "HALF_UP"));
}
pub relation co2_would_otherwise_be_released_as_industrial_emission_45y(co2: Asset) kind empirical {
    label en official "the carbon dioxide captured from an industrial source would otherwise be released into the atmosphere as industrial emission of greenhouse gas (section 45Y(e)(3)(A)) — case-asserted";
}
pub relation co2_measured_at_source_and_verified_at_disposal_45y(co2: Asset) kind empirical {
    label en official "the carbon dioxide is measured at the source of capture and verified at the point of disposal or utilization (section 45Y(e)(3)(B)) — case-asserted";
}
pub relation co2_captured_and_disposed_in_united_states_or_possession_45y(co2: Asset) kind empirical {
    label en official "the carbon dioxide is captured and disposed or utilized within the United States (section 638(1)) or a possession (section 638(2)) (section 45Y(e)(3)(C)) — case-asserted external classification";
}
pub relation qualified_carbon_dioxide_45y(co2: Asset) kind institutional {
    label en official "section 45Y(e)(3): carbon dioxide captured from an industrial source that would otherwise be released, measured at the source and verified at disposal or utilization, captured and disposed or utilized in the United States or a possession";
}
@source(IRC_S45Y_E, relation = formalizes, coverage = exact, quote = "The term \"qualified carbon dioxide\" means carbon dioxide captured from an industrial source which—")
rule QualifiedCarbonDioxide45yRule(co2: Asset) strict {
    when co2_would_otherwise_be_released_as_industrial_emission_45y(co2);
    when co2_measured_at_source_and_verified_at_disposal_45y(co2);
    when co2_captured_and_disposed_in_united_states_or_possession_45y(co2);
    then qualified_carbon_dioxide_45y(co2);
}

// --- 45Y(f), 48E(i): guidance duties of the Secretary -----------------------------------------------------------------------------------------------

relation guidance_deadline_45y(on: Date) kind institutional;
@source(IRC_S45Y_F, relation = formalizes, coverage = exact, quote = "Not later than January 1, 2025, the Secretary shall issue guidance regarding implementation of this section, including calculation of greenhouse gas emission rates for qualified facilities and determination of clean electricity production credits under this section.")
assert "45y-f-deadline": guidance_deadline_45y(@2025-01-01);
pub relation guidance_issued_45y(section: Decimal) kind empirical {
    label en official "the Secretary issued the implementing guidance for the section (45Y = 45.0, 48E = 48.5) — case-asserted";
}
rule Section45YFGuidanceDutyRule(deadline: Date) strict {
    when guidance_deadline_45y(deadline);
    then duty Section45YFGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition guidance_issued_45y(45.0);
            window [-infinity, deadline];
        }
    };
}
@source(IRC_S48E_I, relation = formalizes, coverage = exact, quote = "Not later than January 1, 2025, the Secretary shall issue guidance regarding implementation of this section.")
rule Section48EIGuidanceDutyRule(deadline: Date) strict {
    when guidance_deadline_45y(deadline);
    then duty Section48EIGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition guidance_issued_45y(48.5);
            window [-infinity, deadline];
        }
    };
}

// --- 45Y(g)(1)-(5): production, combined heat and power, ownership, related persons ------------------------------------------------------------------

pub relation electricity_produced_in_united_states_or_possession_45y(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the electricity is produced within the United States (section 638(1)) or a possession of the United States (section 638(2)) (section 45Y(g)(1)) — case-asserted external classification";
}
pub relation consumption_sales_or_storage_taken_into_account_45y(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Y(g)(1): consumption, sales or storage are taken into account only for electricity produced within the United States or a possession";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "Consumption, sales, or storage shall be taken into account under this section only with respect to electricity the production of which is within—")
rule ConsumptionSalesOrStorageTakenIntoAccount45yRule(facility: Asset, y: TaxableYear) strict {
    when electricity_produced_in_united_states_or_possession_45y(facility, y);
    then consumption_sales_or_storage_taken_into_account_45y(facility, y);
}
pub relation useful_thermal_energy_btu_45y(facility: Asset, y: TaxableYear, btu: Decimal) kind empirical {
    label en official "the total useful thermal energy produced by the combined heat and power system property within the qualified facility, in Btu (section 45Y(g)(2)(C)(i)(I)) — case-asserted";
}
pub relation facility_heat_rate_btu_per_kwh_45y(facility: Asset, rate: Decimal) kind empirical {
    label en official "the heat rate: the energy the facility uses to generate 1 kilowatt hour of electricity, in Btu per net kilowatt hour generated (section 45Y(g)(2)(C)(ii)) — case-asserted";
}
pub relation thermal_energy_kwh_equivalent_45y(facility: Asset, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "section 45Y(g)(2)(C)(i): the kilowatt hours of electricity produced in the form of useful thermal energy: the total useful thermal energy over the heat rate (6 decimals HALF_UP judgment call)";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A)(i), the amount of kilowatt hours of electricity produced in the form of useful thermal energy shall be equal to the quotient of—")
rule ThermalEnergyKwhEquivalent45yRule(facility: Asset, y: TaxableYear, btu: Decimal, rate: Decimal) strict {
    when useful_thermal_energy_btu_45y(facility, y, btu);
    when facility_heat_rate_btu_per_kwh_45y(facility, rate);
    when rate > 0.0;
    then thermal_energy_kwh_equivalent_45y(facility, y, div_round(btu, rate, 6, "HALF_UP"));
}
pub relation kilowatt_hours_including_thermal_45y(facility: Asset, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "section 45Y(g)(2)(A)(i): the kilowatt hours of electricity produced at a qualified facility include any production in the form of useful thermal energy by combined heat and power system property within the facility";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(i) the kilowatt hours of electricity produced by a taxpayer at a qualified facility shall include any production in the form of useful thermal energy by any combined heat and power system property within such facility, and")
rule KilowattHoursIncludingThermal45yRule(facility: Asset, y: TaxableYear, produced: Decimal, thermal: Decimal) strict {
    when kilowatt_hours_produced_45y(facility, y, produced);
    when thermal_energy_kwh_equivalent_45y(facility, y, thermal);
    then kilowatt_hours_including_thermal_45y(facility, y, produced + thermal);
}
pub relation ghg_grams_emitted_for_thermal_energy_45y(facility: Asset, grams: Decimal) kind empirical {
    label en official "the greenhouse gases the facility emits into the atmosphere in producing the useful thermal energy, in grams of CO2e (section 45Y(g)(2)(A)(ii)) — case-asserted";
}
pub relation emissions_rate_including_thermal_45y(facility: Asset, y: TaxableYear, rate: Decimal) kind institutional {
    label en official "section 45Y(g)(2)(A)(ii): the greenhouse gas emissions for the useful thermal energy are included in determining the facility's emissions rate (grams per kilowatt hour including the thermal equivalent, 6 decimals HALF_UP)";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(ii) the amount of greenhouse gases emitted into the atmosphere by such facility in the production of such useful thermal energy shall be included for purposes of determining the greenhouse gas emissions rate for such facility.")
rule EmissionsRateIncludingThermal45yRule(facility: Asset, y: TaxableYear, electricity_grams: Decimal, thermal_grams: Decimal, kwh: Decimal) strict {
    when greenhouse_gas_co2e_grams_45y(facility, electricity_grams);
    when ghg_grams_emitted_for_thermal_energy_45y(facility, thermal_grams);
    when kilowatt_hours_including_thermal_45y(facility, y, kwh);
    when kwh > 0.0;
    then emissions_rate_including_thermal_45y(facility, y, div_round(electricity_grams + thermal_grams, kwh, 6, "HALF_UP"));
}
pub relation chp_meets_48c3_definition_without_a4_b_d_45y(prop: Asset) kind institutional {
    label en official "section 45Y(g)(2)(B): combined heat and power system property has the meaning of section 48(c)(3) without regard to subparagraphs (A)(iv) (construction before 2025), (B) (capacity limits) and (D) (biomass): one energy source for power and useful thermal energy, at least 20 percent each, energy efficiency above 60 percent, not transport or distribution property";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"combined heat and power system property\" has the same meaning given such term by section 48(c)(3) (without regard to subparagraphs (A)(iv), (B), and (D) thereof).")
rule ChpMeets48c3WithoutA4BD45yRule(prop: Asset, thermal: Decimal, useful_power: Decimal, efficiency: Decimal) strict {
    when chp_uses_same_energy_source_for_electric_or_mechanical_and_thermal_48(prop);
    when chp_useful_thermal_share_48(prop, thermal);
    when thermal >= 0.20;
    when chp_useful_power_share_48(prop, useful_power);
    when useful_power >= 0.20;
    when chp_energy_efficiency_percentage_48(prop, efficiency);
    when efficiency > 0.60;
    when not_known(chp_property_transports_or_distributes_energy_48(prop));
    then chp_meets_48c3_definition_without_a4_b_d_45y(prop);
}
pub relation ownership_share_of_gross_sales_45y(facility: Asset, owner: Person, share: Decimal) kind empirical {
    label en official "the owner's ownership interest in the gross sales from the facility, as a fraction (section 45Y(g)(3)) — case-asserted";
}
pub relation production_allocated_to_owner_kwh_45y(facility: Asset, owner: Person, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "section 45Y(g)(3): production from a facility with more than one owner is allocated in proportion to the owners' interests in gross sales (except as provided in regulations)";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = partial, quote = "In the case of a qualified facility in which more than 1 person has an ownership interest, except to the extent provided in regulations prescribed by the Secretary, production from the facility shall be allocated among such persons in proportion to their respective ownership interests in the gross sales from such facility.")
rule ProductionAllocatedToOwner45yRule(facility: Asset, owner: Person, y: TaxableYear, total: Decimal, share: Decimal) strict {
    when kilowatt_hours_produced_45y(facility, y, total);
    when ownership_share_of_gross_sales_45y(facility, owner, share);
    then production_allocated_to_owner_kwh_45y(facility, owner, y, total * share);
}
pub relation persons_related_45y(a: Person, b: Person, y: TaxableYear) kind institutional {
    label en official "section 45Y(g)(4): persons are related if they would be treated as a single employer under the section 52(b) regulations";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = partial, quote = "Persons shall be treated as related to each other if such persons would be treated as a single employer under the regulations prescribed under section 52(b).")
rule PersonsRelated45yRule(a: Person, b: Person, y: TaxableYear, group: ControlledGroup) strict {
    when under_common_control_52b(group, a, y);
    when under_common_control_52b(group, b, y);
    then persons_related_45y(a, b, y);
}
pub relation consolidated_group_member_45y(corp: Person, group: Person) kind empirical {
    label en official "the corporation is a member of an affiliated group of corporations filing a consolidated return (section 45Y(g)(4)) — case-asserted";
}
pub relation electricity_sold_by_member_to_unrelated_person_45y(seller: Person, buyer: Person) kind empirical {
    label en official "the electricity is sold to the buyer by another member of the consolidated group — case-asserted";
}
pub relation treated_as_selling_to_unrelated_person_45y(corp: Person, buyer: Person) kind institutional {
    label en official "section 45Y(g)(4), last sentence: a corporation in a consolidated group is treated as selling electricity to an unrelated person if another member sells it to that person";
}
rule TreatedAsSellingToUnrelatedPerson45yRule(corp: Person, group: Person, seller: Person, buyer: Person) strict {
    when consolidated_group_member_45y(corp, group);
    when consolidated_group_member_45y(seller, group);
    when electricity_sold_by_member_to_unrelated_person_45y(seller, buyer);
    then treated_as_selling_to_unrelated_person_45y(corp, buyer);
}

// --- 45Y(g)(6): the cooperative apportionment ---------------------------------------------------------------------------------------------------------------

pub relation cooperative_described_in_1381a_45y(coop: Person) kind empirical {
    label en official "the organization is a cooperative organization described in section 1381(a) — case-asserted";
}
pub relation owned_more_than_half_by_agricultural_producers_45y(coop: Person) kind empirical {
    label en official "the cooperative is owned more than 50 percent by agricultural producers or by entities owned by agricultural producers (section 45Y(g)(6)(D)) — case-asserted";
}
pub relation eligible_cooperative_45y(coop: Person) kind institutional {
    label en official "section 45Y(g)(6)(D): a section 1381(a) cooperative owned more than 50 percent by agricultural producers or by entities they own";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"eligible cooperative\" means a cooperative organization described in section 1381(a) which is owned more than 50 percent by agricultural producers or by entities owned by agricultural producers.")
rule EligibleCooperative45yRule(coop: Person) strict {
    when cooperative_described_in_1381a_45y(coop);
    when owned_more_than_half_by_agricultural_producers_45y(coop);
    then eligible_cooperative_45y(coop);
}
pub relation elects_to_apportion_credit_to_patrons_45y(coop: Person, y: TaxableYear) kind empirical {
    label en official "the eligible cooperative's exercise of the section 45Y(g)(6)(A) election to apportion any portion of the credit among patrons on the basis of business done";
}
pub relation timely_return_and_written_notice_to_patrons_45y(coop: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely filed return and the apportionment is designated in a written notice mailed to patrons during the payment period of section 1382(d) (section 45Y(g)(6)(A)(ii)) — case-asserted";
}
pub relation apportionment_to_patrons_effective_45y(coop: Person, y: TaxableYear) kind institutional {
    label en official "section 45Y(g)(6)(A): the apportionment among patrons takes effect (a valid, irrevocable election with the timely notice)";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "In the case of an eligible cooperative organization, any portion of the credit determined under subsection (a) for the taxable year may, at the election of the organization, be apportioned among patrons of the organization on the basis of the amount of business done by the patrons during the taxable year.")
rule Section45YG6ElectionRule(coop: Person, y: TaxableYear) defeasible {
    when eligible_cooperative_45y(coop);
    when timely_return_and_written_notice_to_patrons_45y(coop, y);
    then power Section45YG6ApportionmentElection {
        holder coop;
        over coop;
        exercise elects_to_apportion_credit_to_patrons_45y(coop, y);
        valid_when timely_return_and_written_notice_to_patrons_45y(coop, y);
        effect create(apportionment_to_patrons_effective_45y(coop, y));
        window [@2022-08-16, infinity);
    };
}
pub relation cooperative_credit_apportioned_45y(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the credit under subsection (a) that the cooperative apportions among its patrons — case-asserted";
}
pub relation business_done_by_patron_45y(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the business done by the patron with the cooperative during the taxable year — case-asserted";
}
pub relation total_business_done_45y(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total business done with the cooperative's patrons during the taxable year — case-asserted";
}
pub relation credit_apportioned_to_patron_45y(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45Y(g)(6)(A)-(B): the apportioned credit goes to each patron on the basis of business done, excluded from the cooperative's credit and included in the patron's credit for its first taxable year ending on or after the end of the payment period (or the notice date, if earlier)";
}
rule CreditApportionedToPatron45yRule(coop: Person, patron: Person, y: TaxableYear, apportioned: Money, done: Money, total: Money) strict {
    when apportionment_to_patrons_effective_45y(coop, y);
    when cooperative_credit_apportioned_45y(coop, y, apportioned);
    when business_done_by_patron_45y(coop, patron, y, done);
    when total_business_done_45y(coop, y, total);
    when total > 0 USD;
    then credit_apportioned_to_patron_45y(coop, patron, y, div_round(apportioned * (done / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation cooperative_credit_determined_45y(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit of the cooperative determined under subsection (a) for the year, as finally determined — case-asserted";
}
pub relation cooperative_credit_shown_on_return_45y(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit shown on the cooperative's return for the year — case-asserted";
}
pub relation cooperative_credit_not_apportioned_45y(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount not apportioned to patrons for the year — case-asserted";
}
pub relation cooperative_tax_increase_for_excess_reduction_45y(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45Y(g)(6)(C): if the credit determined is less than the credit shown on the return, the excess of the reduction over the amount not apportioned is an increase in tax";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "If the amount of the credit of a cooperative organization determined under subsection (a) for a taxable year is less than the amount of such credit shown on the return of the cooperative organization for such year, an amount equal to the excess of—")
rule CooperativeTaxIncreaseForExcessReduction45yRule(coop: Person, y: TaxableYear, determined: Money, shown: Money, unapportioned: Money) strict {
    when cooperative_credit_determined_45y(coop, y, determined);
    when cooperative_credit_shown_on_return_45y(coop, y, shown);
    when cooperative_credit_not_apportioned_45y(coop, y, unapportioned);
    when shown - determined > unapportioned;
    then cooperative_tax_increase_for_excess_reduction_45y(coop, y, shown - determined - unapportioned);
}

// --- 45Y(g)(7): the energy community increase ------------------------------------------------------------------------------------------------------------------

pub relation qualified_facility_in_energy_community_45y(facility: Asset) kind empirical {
    label en official "the qualified facility is located in an energy community (section 45(b)(11)(B)) — case-asserted (the community classification belongs to section 45)";
}
pub relation applicable_amount_with_energy_community_45y(facility: Asset, y: TaxableYear, cents: Decimal) kind institutional {
    label en official "section 45Y(g)(7): for a facility in an energy community the applicable amount is increased by 10 percent of the amount otherwise in effect";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "the applicable amount under paragraph (2) of such subsection shall be increased by an amount equal to 10 percent of the amount otherwise in effect under such paragraph.")
rule ApplicableAmountWithEnergyCommunity45yRule(facility: Asset, y: TaxableYear, cents: Decimal) defeasible {
    when qualified_facility_in_energy_community_45y(facility);
    when applicable_amount_cents_45y(facility, y, cents);
    then applicable_amount_with_energy_community_45y(facility, y, cents * 1.10);
}

// --- 45Y(g)(11): the domestic content increase ------------------------------------------------------------------------------------------------------------

pub enum FacilityKind45yG11 {
    OffshoreWindFacility;
    OtherFacility;
}
pub relation facility_kind_45y_g11(facility: Asset, kind: FacilityKind45yG11) kind empirical {
    label en official "whether the qualified facility is an offshore wind facility (section 45Y(g)(11)(C)(ii)) or another facility — case-asserted";
}
pub relation construction_begin_date_45y_g11(facility: Asset, on: Date) kind empirical {
    label en official "the date the construction of the facility begins (section 45Y(g)(11)(C)) — case-asserted";
}
pub relation domestic_content_adjusted_percentage_45y(facility: Asset, pct: Decimal) kind institutional {
    label en official "section 45Y(g)(11)(C): the adjusted percentage by the year construction begins: 40, 45, 50, 55 percent; for an offshore wind facility 20, 27.5, 35, 45, 55 percent";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(I) in the case of a facility the construction of which begins before January 1, 2025, 40 percent,")
rule AdjustedPercentageOtherBefore2025Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OtherFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on < @2025-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.40);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(II) in the case of a facility the construction of which begins after December 31, 2024, and before January 1, 2026, 45 percent,")
rule AdjustedPercentageOther2025Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OtherFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on >= @2025-01-01;
    when on < @2026-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.45);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(III) in the case of a facility the construction of which begins after December 31, 2025, and before January 1, 2027, 50 percent, and")
rule AdjustedPercentageOther2026Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OtherFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on >= @2026-01-01;
    when on < @2027-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.50);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(IV) in the case of a facility the construction of which begins after December 31, 2026, 55 percent.")
rule AdjustedPercentageOtherAfter2026Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OtherFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on >= @2027-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.55);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(I) in the case of a facility the construction of which begins before January 1, 2025, 20 percent,")
rule AdjustedPercentageOffshoreBefore2025Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OffshoreWindFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on < @2025-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.20);
}
rule AdjustedPercentageOffshore2025Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OffshoreWindFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on >= @2025-01-01;
    when on < @2026-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.275);
}
rule AdjustedPercentageOffshore2026Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OffshoreWindFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on >= @2026-01-01;
    when on < @2027-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.35);
}
rule AdjustedPercentageOffshore2027Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OffshoreWindFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on >= @2027-01-01;
    when on < @2028-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.45);
}
rule AdjustedPercentageOffshoreAfter2027Rule(facility: Asset, on: Date) strict {
    when facility_kind_45y_g11(facility, OffshoreWindFacility);
    when construction_begin_date_45y_g11(facility, on);
    when on >= @2028-01-01;
    then domestic_content_adjusted_percentage_45y(facility, 0.55);
}
pub relation taxpayer_certifies_steel_iron_and_manufactured_products_us_produced_45y(facility: Asset) kind empirical {
    label en official "the taxpayer certifies to the Secretary that any steel, iron or manufactured product which is a component of the facility upon completion of construction was produced in the United States (as determined under 49 CFR 661) (section 45Y(g)(11)(B)(i)-(ii)) — case-asserted certification";
}
pub relation share_of_manufactured_product_costs_attributable_to_us_products_45y(facility: Asset, share: Decimal) kind empirical {
    label en official "the share (fraction) of the total costs of all manufactured products which are components of the facility attributable to manufactured products (including components) mined, produced or manufactured in the United States (section 45Y(g)(11)(B)(iii)) — case-asserted";
}
pub relation domestic_content_requirement_met_45y(facility: Asset) kind institutional {
    label en official "section 45Y(g)(11)(B): the taxpayer certifies US-produced steel, iron and manufactured products; manufactured products are deemed produced in the United States if not less than the adjusted percentage of their total costs is attributable to US products";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "the manufactured products which are components of a qualified facility upon completion of construction shall be deemed to have been produced in the United States if not less than the adjusted percentage (as determined under subparagraph (C)) of the total costs of all such manufactured products of such facility are attributable to manufactured products (including components) which are mined, produced, or manufactured in the United States.")
rule DomesticContentRequirementMet45yRule(facility: Asset, share: Decimal, adjusted: Decimal) strict {
    when taxpayer_certifies_steel_iron_and_manufactured_products_us_produced_45y(facility);
    when share_of_manufactured_product_costs_attributable_to_us_products_45y(facility, share);
    when domestic_content_adjusted_percentage_45y(facility, adjusted);
    when share >= adjusted;
    then domestic_content_requirement_met_45y(facility);
}
pub relation credit_before_g7_and_g11_45y(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit determined under subsection (a) without application of paragraph (7) — case-asserted";
}
pub relation domestic_content_credit_increase_45y(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45Y(g)(11)(A): for a facility satisfying the (B)(i) requirement the credit is increased by 10 percent of the amount determined without paragraph (7)";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "In the case of any qualified facility which satisfies the requirement under subparagraph (B)(i), the amount of the credit determined under subsection (a) shall be increased by an amount equal to 10 percent of the amount so determined (as determined without application of paragraph (7)).")
rule DomesticContentCreditIncrease45yRule(facility: Asset, y: TaxableYear, credit: Money) strict {
    when domestic_content_requirement_met_45y(facility);
    when credit_before_g7_and_g11_45y(facility, y, credit);
    then domestic_content_credit_increase_45y(facility, y, round(0.10 * credit, 2, "HALF_UP"));
}

// --- 45Y(g)(12): the elective payment applicable percentage -----------------------------------------------------------------------------------------------

pub relation facility_maximum_net_output_mw_ac_45y(facility: Asset, mw: Decimal) kind empirical {
    label en official "the maximum net output of the facility in megawatts, as measured in alternating current (section 45Y(g)(12)(B)(ii)) — case-asserted";
}
external judgment relation secretary_provides_domestic_content_exception_45y(facility: Asset) {
    authority Secretary;
    label en official "the Secretary provides an exception to the requirements of paragraph (12) because the inclusion of US steel, iron or manufactured products increases the overall construction costs of qualified facilities by more than 25 percent, or they are not produced in the United States in sufficient and reasonably available quantities or of a satisfactory quality (section 45Y(g)(12)(D)(i))";
}
pub relation elective_payment_applicable_percentage_45y(facility: Asset, pct: Decimal) kind institutional {
    label en official "section 45Y(g)(12): the applicable percentage for an elective payment: 100 percent for a facility meeting the (11)(B) requirements or with a maximum net output under 1 MW; otherwise 100 percent (construction before 2024), 90 percent (2024), 85 percent (2025), 0 percent (after 2025); 100 percent where the Secretary provides an exception";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "the applicable percentage shall be 100 percent.")
rule ElectivePercentageDomesticContentRule(facility: Asset) strict {
    when domestic_content_requirement_met_45y(facility);
    then elective_payment_applicable_percentage_45y(facility, 1.00);
}
rule ElectivePercentageSmallFacilityRule(facility: Asset, mw: Decimal) strict {
    when facility_maximum_net_output_mw_ac_45y(facility, mw);
    when mw < 1.0;
    then elective_payment_applicable_percentage_45y(facility, 1.00);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(i) if construction of such facility began before January 1, 2024, 100 percent,")
rule ElectivePercentageBefore2024Rule(facility: Asset, on: Date) strict {
    when construction_begin_date_45y_g11(facility, on);
    when not_known(elective_payment_facility_described_in_b_45y(facility));
    when on < @2024-01-01;
    then elective_payment_applicable_percentage_45y(facility, 1.00);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(ii) if construction of such facility began in calendar year 2024, 90 percent,")
rule ElectivePercentage2024Rule(facility: Asset, on: Date) strict {
    when construction_begin_date_45y_g11(facility, on);
    when not_known(elective_payment_facility_described_in_b_45y(facility));
    when on >= @2024-01-01;
    when on < @2025-01-01;
    then elective_payment_applicable_percentage_45y(facility, 0.90);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(iii) if construction of such facility began in calendar year 2025, 85 percent, and")
rule ElectivePercentage2025Rule(facility: Asset, on: Date) strict {
    when construction_begin_date_45y_g11(facility, on);
    when not_known(elective_payment_facility_described_in_b_45y(facility));
    when on >= @2025-01-01;
    when on < @2026-01-01;
    then elective_payment_applicable_percentage_45y(facility, 0.85);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "(iv) if construction of such facility began after December 31, 2025, 0 percent.")
rule ElectivePercentageAfter2025Rule(facility: Asset, on: Date) strict {
    when construction_begin_date_45y_g11(facility, on);
    when not_known(elective_payment_facility_described_in_b_45y(facility));
    when on >= @2026-01-01;
    then elective_payment_applicable_percentage_45y(facility, 0.00);
}
relation elective_payment_facility_described_in_b_45y(facility: Asset) kind institutional;
rule ElectivePaymentFacilityDescribedInBDomesticRule(facility: Asset) strict {
    when domestic_content_requirement_met_45y(facility);
    then elective_payment_facility_described_in_b_45y(facility);
}
rule ElectivePaymentFacilityDescribedInBSmallRule(facility: Asset, mw: Decimal) strict {
    when facility_maximum_net_output_mw_ac_45y(facility, mw);
    when mw < 1.0;
    then elective_payment_facility_described_in_b_45y(facility);
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "In any case in which the Secretary provides an exception pursuant to clause (i), the applicable percentage shall be 100 percent.")
rule ElectivePercentageSecretaryExceptionRule(facility: Asset) defeasible {
    when secretary_provides_domestic_content_exception_45y(facility);
    then elective_payment_applicable_percentage_45y(facility, 1.00);
}
pub relation credit_value_before_elective_payment_45y(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the value of the credit determined without regard to paragraph (12) (section 45Y(g)(12)(A)(i)) — case-asserted";
}
pub relation elects_elective_payment_6417_45y(taxpayer: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer makes an election under section 6417 with respect to the credit — case-asserted";
}
pub relation credit_after_elective_payment_percentage_45y(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45Y(g)(12)(A): for a taxpayer making a section 6417 election the credit is the value of the credit multiplied by the applicable percentage";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "In the case of a taxpayer making an election under section 6417 with respect to a credit under this section, the amount of such credit shall be replaced with—")
rule CreditAfterElectivePaymentPercentage45yRule(taxpayer: Person, facility: Asset, y: TaxableYear, value: Money, pct: Decimal) defeasible {
    when elects_elective_payment_6417_45y(taxpayer, facility, y);
    when credit_value_before_elective_payment_45y(facility, y, value);
    when elective_payment_applicable_percentage_45y(facility, pct);
    then credit_after_elective_payment_percentage_45y(taxpayer, facility, y, round(value * pct, 2, "HALF_UP"));
}

// --- 48E(b): the qualified investment ----------------------------------------------------------------------------------------------------------------------------

pub relation qualified_property_basis_48e(taxpayer: Person, facility: Asset, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the basis of a qualified property placed in service by the taxpayer during the taxable year which is part of the qualified facility (section 48E(b)(1)(A)) — case-asserted";
}
pub relation interconnection_expenditure_48e(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount paid or incurred for qualified interconnection property (section 48(a)(8)(B)) in connection with the facility, placed in service during the year and properly chargeable to capital account (section 48E(b)(1)(B)) — case-asserted";
}
pub relation facility_max_net_output_mw_ac_48e(facility: Asset, mw: Decimal) kind empirical {
    label en official "the maximum net output of the qualified facility, in megawatts as measured in alternating current (section 48E(b)(1)(B)(i)(I)) — case-asserted";
}
pub relation basis_attributable_to_qualified_rehabilitation_expenditures_48e(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the basis of the property attributable to qualified rehabilitation expenditures (section 47(c)(2)) (section 48E(b)(5)) — case-asserted";
}
pub relation qualified_investment_computed_48e(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48E(b)(1), (5): the basis of qualified property placed in service plus the interconnection expenditures (for a facility of at most 5 MW AC) less the part of the basis attributable to qualified rehabilitation expenditures";
}
@source(IRC_S48E_B, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), the qualified investment with respect to any qualified facility for any taxable year is the sum of—")
rule QualifiedInvestmentComputed48eRule(taxpayer: Person, facility: Asset, y: TaxableYear, one_prop: Asset, one_amount: Money) strict {
    when qualified_property_basis_48e(taxpayer, facility, one_prop, y, one_amount);
    when not_known(interconnection_expenditure_counted_48e(taxpayer, facility, y));
    then qualified_investment_computed_48e(taxpayer, facility, y,
        sum(collect all a: Money, p: Asset where qualified_property_basis_48e(taxpayer, facility, p, y, a), empty: 0 USD));
}
relation interconnection_expenditure_counted_48e(taxpayer: Person, facility: Asset, y: TaxableYear) kind institutional;
rule InterconnectionExpenditureCounted48eRule(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money, mw: Decimal) strict {
    when interconnection_expenditure_48e(taxpayer, facility, y, amount);
    when facility_max_net_output_mw_ac_48e(facility, mw);
    when mw <= 5.0;
    then interconnection_expenditure_counted_48e(taxpayer, facility, y);
}
rule QualifiedInvestmentWithInterconnection48eRule(taxpayer: Person, facility: Asset, y: TaxableYear, one_prop: Asset, one_amount: Money, inter: Money) strict {
    when qualified_property_basis_48e(taxpayer, facility, one_prop, y, one_amount);
    when interconnection_expenditure_counted_48e(taxpayer, facility, y);
    when interconnection_expenditure_48e(taxpayer, facility, y, inter);
    then qualified_investment_computed_48e(taxpayer, facility, y,
        sum(collect all a: Money, p: Asset where qualified_property_basis_48e(taxpayer, facility, p, y, a), empty: 0 USD) + inter);
}
pub relation qualified_investment_after_rehabilitation_exclusion_48e(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48E(b)(5): the qualified investment does not include the portion of basis attributable to qualified rehabilitation expenditures";
}
@source(IRC_S48E_B, relation = formalizes, coverage = exact, quote = "The qualified investment with respect to any qualified facility for any taxable year shall not include that portion of the basis of any property which is attributable to qualified rehabilitation expenditures (as defined in section 47(c)(2)).")
rule QualifiedInvestmentAfterRehabilitationExclusion48eRule(taxpayer: Person, facility: Asset, y: TaxableYear, computed: Money, rehab: Money) strict {
    when qualified_investment_computed_48e(taxpayer, facility, y, computed);
    when basis_attributable_to_qualified_rehabilitation_expenditures_48e(facility, y, rehab);
    then qualified_investment_after_rehabilitation_exclusion_48e(taxpayer, facility, y, max(computed - rehab, 0 USD));
}
pub relation property_is_tangible_personal_property_48e(prop: Asset) kind empirical {
    label en official "the property is tangible personal property (section 48E(b)(2)(A)(i)) — case-asserted";
}
pub relation property_is_other_tangible_integral_part_of_facility_48e(prop: Asset) kind empirical {
    label en official "the property is other tangible property (not a building or its structural components) used as an integral part of the qualified facility (section 48E(b)(2)(A)(ii)) — case-asserted";
}
pub relation depreciation_or_amortization_allowable_48e(prop: Asset) kind empirical {
    label en official "depreciation (or amortization in lieu of depreciation) is allowable with respect to the property (section 48E(b)(2)(B)) — case-asserted";
}
pub relation construction_completed_by_taxpayer_48e(taxpayer: Person, prop: Asset) kind empirical {
    label en official "the construction, reconstruction or erection of the property is completed by the taxpayer (section 48E(b)(2)(C)(i)) — case-asserted";
}
pub relation acquired_with_original_use_with_taxpayer_48e(taxpayer: Person, prop: Asset) kind empirical {
    label en official "the property is acquired by the taxpayer and its original use commences with the taxpayer (section 48E(b)(2)(C)(ii)) — case-asserted";
}
pub relation qualified_property_48e(taxpayer: Person, prop: Asset) kind institutional {
    label en official "section 48E(b)(2): tangible personal property or other tangible property integral to the facility, depreciable, constructed by the taxpayer or acquired with original use commencing with the taxpayer";
}
@source(IRC_S48E_B, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"qualified property\" means property—")
rule QualifiedProperty48ePersonalConstructedRule(taxpayer: Person, prop: Asset) strict {
    when property_is_tangible_personal_property_48e(prop);
    when depreciation_or_amortization_allowable_48e(prop);
    when construction_completed_by_taxpayer_48e(taxpayer, prop);
    then qualified_property_48e(taxpayer, prop);
}
rule QualifiedProperty48ePersonalAcquiredRule(taxpayer: Person, prop: Asset) strict {
    when property_is_tangible_personal_property_48e(prop);
    when depreciation_or_amortization_allowable_48e(prop);
    when acquired_with_original_use_with_taxpayer_48e(taxpayer, prop);
    then qualified_property_48e(taxpayer, prop);
}
rule QualifiedProperty48eIntegralConstructedRule(taxpayer: Person, prop: Asset) strict {
    when property_is_other_tangible_integral_part_of_facility_48e(prop);
    when depreciation_or_amortization_allowable_48e(prop);
    when construction_completed_by_taxpayer_48e(taxpayer, prop);
    then qualified_property_48e(taxpayer, prop);
}
rule QualifiedProperty48eIntegralAcquiredRule(taxpayer: Person, prop: Asset) strict {
    when property_is_other_tangible_integral_part_of_facility_48e(prop);
    when depreciation_or_amortization_allowable_48e(prop);
    when acquired_with_original_use_with_taxpayer_48e(taxpayer, prop);
    then qualified_property_48e(taxpayer, prop);
}
pub relation facility_used_for_generation_of_electricity_48e(facility: Asset) kind empirical {
    label en official "the facility is used for the generation of electricity (section 48E(b)(3)(A)(i)) — case-asserted";
}
pub relation facility_placed_in_service_date_48e(facility: Asset, on: Date) kind empirical {
    label en official "the date the facility is placed in service (section 48E(b)(3)(A)(ii)) — case-asserted";
}
pub relation anticipated_ghg_emissions_rate_48e(facility: Asset, grams: Decimal) kind empirical {
    label en official "the anticipated greenhouse gas emissions rate of the facility in grams of CO2e per kilowatt hour, determined under rules similar to section 45Y(b)(1)(C), (b)(2) (section 48E(b)(3)(B)) — case-asserted";
}
pub relation credit_allowed_for_facility_under_excluded_sections_48e(facility: Asset) kind empirical {
    label en official "a credit under section 45, 45J, 45Q, 45U, 45Y, 48 or 48A is allowed under section 38 for the facility for the taxable year or any prior taxable year (section 48E(b)(3)(C)) — case-asserted";
}
pub relation qualified_facility_48e(facility: Asset) kind institutional {
    label en official "section 48E(b)(3): a facility used for the generation of electricity, placed in service after 2024-12-31, with an anticipated greenhouse gas emissions rate not greater than zero, and no credit under sections 45, 45J, 45Q, 45U, 45Y, 48 or 48A allowed for it";
}
@source(IRC_S48E_B, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"qualified facility\" means a facility—")
rule QualifiedFacility48eRule(facility: Asset, on: Date, grams: Decimal) strict {
    when facility_used_for_generation_of_electricity_48e(facility);
    when facility_placed_in_service_date_48e(facility, on);
    when on > @2024-12-31;
    when anticipated_ghg_emissions_rate_48e(facility, grams);
    when grams <= 0.0;
    when not_known(credit_allowed_for_facility_under_excluded_sections_48e(facility));
    then qualified_facility_48e(facility);
}
pub relation section_48a8b_qualified_interconnection_property_48e(prop: Asset) kind empirical {
    label en official "the property is qualified interconnection property within the meaning of section 48(a)(8)(B) (section 48E(b)(4)) — case-asserted external classification";
}

// --- 48E(c): energy storage technology -------------------------------------------------------------------------------------------------------------------

pub relation energy_storage_technology_basis_48e(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the basis of energy storage technology placed in service by the taxpayer during the taxable year (section 48E(c)(1)) — case-asserted";
}
pub relation energy_storage_technology_48e(prop: Asset) kind institutional {
    label en official "section 48E(c)(2): energy storage technology has the meaning of section 48(c)(6) except that subparagraph (D) (construction not begun after 2024-12-31) does not apply";
}
rule EnergyStorageTechnology48eElectricRule(prop: Asset, kwh: Decimal) strict {
    when receives_stores_delivers_energy_for_conversion_to_electricity_48(prop);
    when not_known(primarily_used_in_transportation_and_not_for_electricity_48(prop));
    when storage_nameplate_capacity_kwh_48(prop, kwh);
    when kwh >= 5.0;
    then energy_storage_technology_48e(prop);
}
rule EnergyStorageTechnology48eThermalRule(prop: Asset) strict {
    when thermal_energy_storage_property_48(prop);
    then energy_storage_technology_48e(prop);
}
pub relation storage_qualified_investment_48e(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48E(c)(1): the qualified investment with respect to energy storage technology is the basis of the energy storage technology placed in service during the year";
}
@source(IRC_S48E_C, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), the qualified investment with respect to energy storage technology for any taxable year is the basis of any energy storage technology placed in service by the taxpayer during such taxable year.")
rule StorageQualifiedInvestment48eRule(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) strict {
    when energy_storage_technology_basis_48e(taxpayer, prop, y, amount);
    when energy_storage_technology_48e(prop);
    then storage_qualified_investment_48e(taxpayer, prop, y, amount);
}

// --- 48E(d)(5): elective payment; (e): the phase-out; (g): termination -----------------------------------------------------------------------------------

pub relation credit_after_elective_payment_percentage_48e(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48E(d)(5): for a taxpayer making a section 6417 election, rules similar to section 45Y(g)(12): the credit value times the applicable percentage";
}
pub relation credit_value_before_elective_payment_48e(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the value of the section 48E credit determined without regard to the elective payment percentage — case-asserted";
}
pub relation elects_elective_payment_6417_48e(taxpayer: Person, facility: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer makes an election under section 6417 with respect to the credit — case-asserted";
}
@source(IRC_S48E_D, relation = formalizes, coverage = exact, quote = "In the case of a taxpayer making an election under section 6417 with respect to a credit under this section, rules similar to the rules of section 45Y(g)(12) shall apply.")
rule CreditAfterElectivePaymentPercentage48eRule(taxpayer: Person, facility: Asset, y: TaxableYear, value: Money, pct: Decimal) defeasible {
    when elects_elective_payment_6417_48e(taxpayer, facility, y);
    when credit_value_before_elective_payment_48e(facility, y, value);
    when elective_payment_applicable_percentage_45y(facility, pct);
    then credit_after_elective_payment_percentage_48e(taxpayer, facility, y, round(value * pct, 2, "HALF_UP"));
}
pub relation applicable_year_45y(year: Decimal) kind empirical {
    label en official "the applicable year of section 45Y(d)(3): the calendar year the Secretary determines annual greenhouse gas emissions from the production of electricity in the United States are not greater than 25 percent of such emissions for 2022 (a determination of the Secretary) — case-asserted";
}
pub relation construction_begin_calendar_year_48e(facility: Asset, year: Decimal) kind empirical {
    label en official "the calendar year in which the construction of the qualified facility or energy storage technology begins (section 48E(e)(1)) — case-asserted";
}
pub relation phase_out_percentage_48e(facility: Asset, pct: Decimal) kind institutional {
    label en official "section 48E(e)(2): 100 percent for construction beginning in the first calendar year following the applicable year, 75 percent in the second, 50 percent in the third, 0 percent afterwards";
}
@source(IRC_S48E_E, relation = formalizes, coverage = exact, quote = "(A) for any qualified investment with respect to any qualified facility or energy storage technology the construction of which begins during the first calendar year following the applicable year, 100 percent,")
rule PhaseOutPercentage48eFirstYearRule(facility: Asset, year: Decimal, applicable: Decimal) strict {
    when construction_begin_calendar_year_48e(facility, year);
    when applicable_year_45y(applicable);
    when year == applicable + 1.0;
    then phase_out_percentage_48e(facility, 1.00);
}
@source(IRC_S48E_E, relation = formalizes, coverage = exact, quote = "(B) for any qualified investment with respect to any qualified facility or energy storage technology the construction of which begins during the second calendar year following the applicable year, 75 percent,")
rule PhaseOutPercentage48eSecondYearRule(facility: Asset, year: Decimal, applicable: Decimal) strict {
    when construction_begin_calendar_year_48e(facility, year);
    when applicable_year_45y(applicable);
    when year == applicable + 2.0;
    then phase_out_percentage_48e(facility, 0.75);
}
@source(IRC_S48E_E, relation = formalizes, coverage = exact, quote = "(C) for any qualified investment with respect to any qualified facility or energy storage technology the construction of which begins during the third calendar year following the applicable year, 50 percent, and")
rule PhaseOutPercentage48eThirdYearRule(facility: Asset, year: Decimal, applicable: Decimal) strict {
    when construction_begin_calendar_year_48e(facility, year);
    when applicable_year_45y(applicable);
    when year == applicable + 3.0;
    then phase_out_percentage_48e(facility, 0.50);
}
@source(IRC_S48E_E, relation = formalizes, coverage = exact, quote = "(D) for any qualified investment with respect to any qualified facility or energy storage technology the construction of which begins during any calendar year subsequent to the calendar year described in subparagraph (C), 0 percent.")
rule PhaseOutPercentage48eLaterRule(facility: Asset, year: Decimal, applicable: Decimal) strict {
    when construction_begin_calendar_year_48e(facility, year);
    when applicable_year_45y(applicable);
    when year > applicable + 3.0;
    then phase_out_percentage_48e(facility, 0.00);
}
pub relation credit_before_phase_out_48e(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit determined under subsection (a) without regard to subsection (e) — case-asserted";
}
pub relation credit_after_phase_out_48e(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48E(e)(1): the credit times the phase-out percentage (cents HALF_UP)";
}
@source(IRC_S48E_E, relation = formalizes, coverage = exact, quote = "The amount of the clean electricity investment credit under subsection (a) for any qualified investment with respect to any qualified facility or energy storage technology the construction of which begins during a calendar year described in paragraph (2) shall be equal to the product of—")
rule CreditAfterPhaseOut48eRule(facility: Asset, y: TaxableYear, credit: Money, pct: Decimal) strict {
    when credit_before_phase_out_48e(facility, y, credit);
    when phase_out_percentage_48e(facility, pct);
    then credit_after_phase_out_48e(facility, y, round(credit * pct, 2, "HALF_UP"));
}
pub relation secretary_determination_ghg_rate_48e(facility: Asset, y: TaxableYear, grams: Decimal) kind empirical {
    label en official "the Secretary's determination, in the taxable year, of the greenhouse gas emissions rate of the qualified facility in grams of CO2e per kilowatt hour (section 48E(g)) — case-asserted";
}
pub relation property_ceases_to_be_investment_credit_property_48e(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 48E(g): if the Secretary determines that the emissions rate of the facility is greater than 10 grams of CO2e per kilowatt hour, property for which a credit was allowed with respect to the facility ceases to be investment credit property in the taxable year of the determination";
}
@source(IRC_S48E_G, relation = formalizes, coverage = exact, quote = "For purposes of section 50, if the Secretary determines that the greenhouse gas emissions rate for a qualified facility is greater than 10 grams of CO2e per KWh, any property for which a credit was allowed under this section with respect to such facility shall cease to be investment credit property in the taxable year in which the determination is made.")
rule PropertyCeasesToBeInvestmentCreditProperty48eRule(facility: Asset, y: TaxableYear, grams: Decimal) strict {
    when secretary_determination_ghg_rate_48e(facility, y, grams);
    when grams > 10.0;
    then property_ceases_to_be_investment_credit_property_48e(facility, y);
}

// --- 48E(h): the environmental justice capacity increase -------------------------------------------------------------------------------------------------

pub relation applicable_facility_48e_by_size_and_location_48eh(facility: Asset) kind institutional {
    label en official "section 48E(h)(2)(A): a qualified facility not described in section 45Y(b)(2)(B), with a maximum net output of less than 5 MW (AC), in a low-income community or on Indian land, or part of a qualified low-income residential building project or economic benefit project";
}
pub relation facility_described_in_45y_b2b_48eh(facility: Asset) kind empirical {
    label en official "the facility is described in section 45Y(b)(2)B (the section 45Y alternative-rate facility) (section 48E(h)(2)(A)(i)) — case-asserted";
}
pub relation facility_in_low_income_community_or_on_indian_land_48eh(facility: Asset) kind empirical {
    label en official "the facility is located in a low-income community (section 45D(e)) or on Indian land (section 2601(2) of the Energy Policy Act of 1992) (section 48E(h)(2)(A)(iii)(I)) — case-asserted";
}
pub relation part_of_low_income_project_48eh(facility: Asset) kind empirical {
    label en official "the facility is part of a qualified low-income residential building project or a qualified low-income economic benefit project (section 48E(h)(2)(A)(iii)(II), (B)-(D)); the tests are those of section 48(e)(2)(B)-(D) — case-asserted";
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "The term \"applicable facility\" means any qualified facility—")
rule ApplicableFacility48ehLocationRule(facility: Asset, mw: Decimal) strict {
    when qualified_facility_48e(facility);
    when not_known(facility_described_in_45y_b2b_48eh(facility));
    when facility_max_net_output_mw_ac_48e(facility, mw);
    when mw < 5.0;
    when facility_in_low_income_community_or_on_indian_land_48eh(facility);
    then applicable_facility_48e_by_size_and_location_48eh(facility);
}
rule ApplicableFacility48ehProjectRule(facility: Asset, mw: Decimal) strict {
    when qualified_facility_48e(facility);
    when not_known(facility_described_in_45y_b2b_48eh(facility));
    when facility_max_net_output_mw_ac_48e(facility, mw);
    when mw < 5.0;
    when part_of_low_income_project_48eh(facility);
    then applicable_facility_48e_by_size_and_location_48eh(facility);
}
pub relation applicable_percentage_increase_points_48eh(facility: Asset, points: Decimal) kind institutional {
    label en official "section 48E(h)(1)(A): the applicable percentage is increased by 10 percentage points for a facility described in (2)(A)(iii)(I) and not (II), and by 20 points for one described in (2)(A)(iii)(II) (with an allocation of the environmental justice capacity limitation)";
}
pub relation ej_capacity_limitation_allocated_mw_dc_48eh(facility: Asset, mw: Decimal) kind empirical {
    label en official "the environmental justice capacity limitation the Secretary allocated to the facility, in megawatts of DC capacity (section 48E(h)(1)(B)(i)) — case-asserted";
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "(i) in the case of a facility described in subclause (I) of paragraph (2)(A)(iii) and not described in subclause (II) of such paragraph, 10 percentage points, and")
rule IncreasePoints10Rule(facility: Asset) strict {
    when applicable_facility_48e_by_size_and_location_48eh(facility);
    when ej_capacity_limitation_allocated_mw_dc_48eh(facility, _);
    when facility_in_low_income_community_or_on_indian_land_48eh(facility);
    when not_known(part_of_low_income_project_48eh(facility));
    then applicable_percentage_increase_points_48eh(facility, 10.0);
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "(ii) in the case of a facility described in subclause (II) of paragraph (2)(A)(iii), 20 percentage points, and")
rule IncreasePoints20Rule(facility: Asset) strict {
    when applicable_facility_48e_by_size_and_location_48eh(facility);
    when ej_capacity_limitation_allocated_mw_dc_48eh(facility, _);
    when part_of_low_income_project_48eh(facility);
    then applicable_percentage_increase_points_48eh(facility, 20.0);
}
pub relation facility_total_capacity_mw_dc_48eh(facility: Asset, mw: Decimal) kind empirical {
    label en official "the total megawatt nameplate capacity of the facility, as measured in direct current (section 48E(h)(1)(B)(ii)) — case-asserted";
}
pub relation increase_in_credit_before_ratio_48eh(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the increase in the credit determined under subsection (a) by reason of subsection (h) for all property of the facility, before the (h)(1)(B) ratio — case-asserted";
}
pub relation increase_in_credit_after_ratio_48eh(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48E(h)(1)(B): the increase does not exceed the increase times the ratio of the allocated limitation to the total DC capacity (cents HALF_UP judgment call)";
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "(B) the increase in the credit determined under subsection (a) by reason of this subsection for any taxable year with respect to all property which is part of such facility shall not exceed the amount which bears the same ratio to the amount of such increase (determined without regard to this subparagraph) as—")
rule IncreaseInCreditAfterRatio48ehRule(facility: Asset, y: TaxableYear, increase: Money, limit: Decimal, total: Decimal) strict {
    when applicable_facility_48e_by_size_and_location_48eh(facility);
    when increase_in_credit_before_ratio_48eh(facility, y, increase);
    when ej_capacity_limitation_allocated_mw_dc_48eh(facility, limit);
    when facility_total_capacity_mw_dc_48eh(facility, total);
    when total > 0.0;
    then increase_in_credit_after_ratio_48eh(facility, y, min(increase, div_round(increase * limit, total, 2, "HALF_UP")));
}
pub relation eligible_property_48eh(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48E(h)(3): eligible property is a qualified investment with respect to any applicable facility";
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"eligible property\" means a qualified investment with respect to any applicable facility.")
rule EligibleProperty48ehRule(taxpayer: Person, facility: Asset, y: TaxableYear, amount: Money) strict {
    when applicable_facility_48e_by_size_and_location_48eh(facility);
    when qualified_investment_after_rehabilitation_exclusion_48e(taxpayer, facility, y, amount);
    then eligible_property_48eh(taxpayer, facility, y, amount);
}
pub relation ej_program_deadline_48eh(on: Date) kind institutional {
    label en official "section 48E(h)(4)(A): not later than January 1, 2025 the Secretary shall establish a program to allocate the environmental justice capacity limitation to applicable facilities";
}
@source(IRC_S48E_H, relation = formalizes, coverage = partial, quote = "Not later than January 1, 2025, the Secretary shall establish a program to allocate amounts of environmental justice capacity limitation to applicable facilities.")
assert "48eh-program-deadline": ej_program_deadline_48eh(@2025-01-01);
pub relation ej_program_established_48eh(on: Date) kind empirical {
    label en official "the Secretary established the program to allocate the environmental justice capacity limitation on this date — case-asserted";
}
pub relation ej_program_established_by_deadline_48eh(deadline: Date) kind institutional {
    label en official "the program of section 48E(h)(4)(A) is established by the deadline";
}
rule EjProgramEstablishedByDeadline48ehRule(deadline: Date, on: Date) strict {
    when ej_program_deadline_48eh(deadline);
    when ej_program_established_48eh(on);
    when on <= deadline;
    then ej_program_established_by_deadline_48eh(deadline);
}
rule Section48EH4ASecretaryProgramDutyRule(deadline: Date) strict {
    when ej_program_deadline_48eh(deadline);
    then duty Section48EH4AProgramDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition ej_program_established_by_deadline_48eh(deadline);
            window [-infinity, deadline];
        }
    };
}
pub relation annual_capacity_limitation_gw_dc_48eh(year: Decimal, gw: Decimal) kind institutional {
    label en official "section 48E(h)(4)(C): 1.8 gigawatts of direct current capacity for each calendar year from January 1, 2025 through the applicable year, and zero thereafter";
}
pub relation ej_year_48eh(year: Decimal) kind empirical {
    label en official "a calendar year under consideration for the allocation of the environmental justice capacity limitation — case-asserted";
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"annual capacity limitation\" means 1.8 gigawatts of direct current capacity for each calendar year during the period beginning on January 1, 2025, and ending on December 31 of the applicable year (as defined in section 45Y(d)(3)), and zero thereafter.")
rule AnnualCapacityLimitation48ehWithinRule(year: Decimal, applicable: Decimal) strict {
    when ej_year_48eh(year);
    when applicable_year_45y(applicable);
    when year >= 2025.0;
    when year <= applicable;
    then annual_capacity_limitation_gw_dc_48eh(year, 1.8);
}
rule AnnualCapacityLimitation48ehAfterRule(year: Decimal, applicable: Decimal) strict {
    when ej_year_48eh(year);
    when applicable_year_45y(applicable);
    when year > applicable;
    then annual_capacity_limitation_gw_dc_48eh(year, 0.0);
}
pub relation ej_capacity_carried_gw_48eh(year: Decimal, gw: Decimal) kind empirical {
    label en official "the excess of the annual capacity limitation of the preceding year over the allocation, carried to the calendar year (section 48E(h)(4)(D)(i)); for 2025 also the 2024 excess of section 48(e)(4)(D) ((D)(ii)) — case-asserted";
}
pub relation ej_capacity_available_48eh(year: Decimal, gw: Decimal) kind institutional {
    label en official "section 48E(h)(4)(B), (D): the annual capacity limitation plus the excess carried from the preceding year; no carryover to a calendar year after the third calendar year following the applicable year";
}
@source(IRC_S48E_H, relation = formalizes, coverage = partial, quote = "No amount may be carried under the preceding sentence to any calendar year after the third calendar year following the applicable year (as defined in section 45Y(d)(3)).")
rule EjCapacityAvailable48ehRule(year: Decimal, limit: Decimal, carried: Decimal, applicable: Decimal) defeasible {
    when annual_capacity_limitation_gw_dc_48eh(year, limit);
    when ej_capacity_excess_including_expiry_48eh(year, carried);
    when applicable_year_45y(applicable);
    when year <= applicable + 3.0;
    then ej_capacity_available_48eh(year, limit + carried);
}
relation ej_capacity_carried_asserted_48eh(year: Decimal) kind institutional;
rule EjCapacityCarriedAsserted48ehRule(year: Decimal, gw: Decimal) strict {
    when ej_capacity_carried_gw_48eh(year, gw);
    then ej_capacity_carried_asserted_48eh(year);
}
rule EjCapacityAvailable48ehNoCarryRule(year: Decimal, limit: Decimal) defeasible {
    when annual_capacity_limitation_gw_dc_48eh(year, limit);
    when not_known(ej_capacity_excess_present_48eh(year));
    then ej_capacity_available_48eh(year, limit);
}
pub relation ej_capacity_allocated_gw_48eh(year: Decimal, gw: Decimal) kind empirical {
    label en official "the aggregate environmental justice capacity limitation the Secretary allocated during the calendar year, in gigawatts — case-asserted";
}
pub relation secretary_allocates_above_annual_limitation_48eh(year: Decimal) kind institutional {
    label en official "section 48E(h)(4)(B): the amount allocated during the calendar year exceeds the annual capacity limitation";
}
rule SecretaryAllocatesAboveAnnualLimitation48ehRule(year: Decimal, allocated: Decimal, available: Decimal) defeasible {
    when ej_capacity_allocated_gw_48eh(year, allocated);
    when ej_capacity_available_48eh(year, available);
    when allocated > available;
    then secretary_allocates_above_annual_limitation_48eh(year);
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "The amount of environmental justice capacity limitation allocated by the Secretary under subparagraph (A) during any calendar year shall not exceed the annual capacity limitation with respect to such year.")
rule Section48EH4BAllocationLimitRule(year: Decimal) defeasible {
    when secretary_allocates_above_annual_limitation_48eh(year);
    then prohibition Section48EH4BAllocationLimit {
        bearer us.irc.core::Secretary;
        action secretary_allocates_above_annual_limitation_48eh(year);
        window [@2025-01-01, infinity);
    };
}
pub relation ej_allocation_date_48eh(facility: Asset, on: Date) kind empirical {
    label en official "the date of the allocation of the environmental justice capacity limitation to the facility (section 48E(h)(4)(E)(i)) — case-asserted";
}
pub relation property_placed_in_service_date_48eh(prop: Asset, on: Date) kind empirical {
    label en official "the date the property is placed in service — case-asserted";
}
pub relation property_part_of_facility_48eh(prop: Asset, facility: Asset) kind empirical {
    label en official "the property is part of the facility — case-asserted";
}
pub relation ej_increase_applies_to_property_48eh(prop: Asset) kind institutional {
    label en official "section 48E(h)(4)(E)(i): paragraph (1) does not apply to property placed in service after the date 4 years after the allocation to its facility";
}
@source(IRC_S48E_H, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply with respect to any property which is placed in service after the date that is 4 years after the date of the allocation with respect to the facility of which such property is a part.")
rule EjIncreaseAppliesToProperty48ehRule(prop: Asset, facility: Asset, allocated: Date, placed: Date) strict {
    when property_part_of_facility_48eh(prop, facility);
    when ej_allocation_date_48eh(facility, allocated);
    when property_placed_in_service_date_48eh(prop, placed);
    when placed <= add_calendar_period(allocated, 48 calendar_month);
    then ej_increase_applies_to_property_48eh(prop);
}
