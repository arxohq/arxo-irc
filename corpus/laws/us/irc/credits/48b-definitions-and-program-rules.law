// Section 48B — the qualified investment of (b)(1), the definitions of (c) (gasification technology, biomass, carbon capture capability, coal,
// eligible entity, petroleum residue, eligible property) and the (d)(1) program duty and allocation caps. Stage 2f (IRC-06, DECISION-0379,
// TECH_GAP reduction of the stage 2c rows of TECH-GAPS G1522). Companion of `48b-qualifying-gasification-project-credit.law`; its credit rules
// read the qualified investment and the technology tests as case facts and are NOT rewired to require these relations.
//
// Judgment calls: "principally intended" for the application of an eligible entity is one case fact per application area; the carbon capture
// capability of (c)(5) is an external judgment of the Secretary (DECISION-0194); the enactment date of section 48B is a case fact (never a
// literal).

use self::{
    Asset,
    CoalKind48A,
    IRC_S48B_B,
    IRC_S48B_C,
    IRC_S48B_D,
    Person,
    TaxableYear,
    qualifying_gasification_project_48b,
};

pub enum CoalKind48B { Anthracite, BituminousCoal, SubbituminousCoal, Lignite, Peat, OtherSolidFuel }
pub enum GasificationFeedstock48B { Coal, PetroleumResidue, Biomass, OtherRecoveredMaterial, NonQualifyingFeedstock }
pub enum BiomassKind48B { AgriculturalOrPlantWaste, WoodOrPaperMillByproduct, ForestryMaintenanceProduct, RecycledPaper, OtherMaterial }
pub enum GasificationApplication48B { Chemicals, Fertilizers, Glass, Steel, PetroleumResidues, ForestProducts, Agriculture, TransportationGradeLiquidFuels, OtherApplication }

// --- (c)(6), (c)(8), (c)(4): coal, petroleum residue, biomass ----------------------------------------------------------------------------------

pub relation coal_kind_48b(fuel: Asset, kind: CoalKind48B) kind empirical {
    label en official "the kind of the solid fuel (section 48B(c)(6)) — case-asserted";
}
pub relation coal_48b(fuel: Asset) kind institutional {
    label en official "section 48B(c)(6): coal means anthracite, bituminous coal, subbituminous coal, lignite, and peat";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "The term \"coal\" means anthracite, bituminous coal, subbituminous coal, lignite, and peat.")
rule CoalAnthracite48bRule(fuel: Asset) strict {
    when coal_kind_48b(fuel, Anthracite);
    then coal_48b(fuel);
}
rule CoalBituminous48bRule(fuel: Asset) strict {
    when coal_kind_48b(fuel, BituminousCoal);
    then coal_48b(fuel);
}
rule CoalSubbituminous48bRule(fuel: Asset) strict {
    when coal_kind_48b(fuel, SubbituminousCoal);
    then coal_48b(fuel);
}
rule CoalLignite48bRule(fuel: Asset) strict {
    when coal_kind_48b(fuel, Lignite);
    then coal_48b(fuel);
}
rule CoalPeat48bRule(fuel: Asset) strict {
    when coal_kind_48b(fuel, Peat);
    then coal_48b(fuel);
}
pub relation carbonized_product_of_high_boiling_fractions_48b(material: Asset) kind empirical {
    label en official "the material is the carbonized product of high-boiling hydrocarbon fractions obtained in petroleum processing (section 48B(c)(8)) — case-asserted";
}
pub relation petroleum_residue_48b(material: Asset) kind institutional {
    label en official "section 48B(c)(8): the carbonized product of high-boiling hydrocarbon fractions obtained in petroleum processing";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "the carbonized product of high-boiling hydrocarbon fractions obtained in petroleum processing")
rule PetroleumResidue48bRule(material: Asset) strict {
    when carbonized_product_of_high_boiling_fractions_48b(material);
    then petroleum_residue_48b(material);
}
pub relation biomass_kind_48b(material: Asset, kind: BiomassKind48B) kind empirical {
    label en official "the kind of the material (section 48B(c)(4)) — case-asserted";
}
pub relation biomass_48b(material: Asset) kind institutional {
    label en official "section 48B(c)(4): agricultural or plant waste, byproducts of wood or paper mill operations (including lignin in spent pulping liquors) and other products of forestry maintenance, not paper which is commonly recycled";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "agricultural or plant waste")
rule Biomass48bAgriculturalRule(material: Asset) strict {
    when biomass_kind_48b(material, AgriculturalOrPlantWaste);
    then biomass_48b(material);
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "byproduct of wood or paper mill operations, including lignin in spent pulping liquors")
rule Biomass48bMillRule(material: Asset) strict {
    when biomass_kind_48b(material, WoodOrPaperMillByproduct);
    then biomass_48b(material);
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "other products of forestry maintenance")
rule Biomass48bForestryRule(material: Asset) strict {
    when biomass_kind_48b(material, ForestryMaintenanceProduct);
    then biomass_48b(material);
}

// --- (c)(2): gasification technology -----------------------------------------------------------------------------------------------------------------------

pub relation process_feedstock_48b(process: Asset, feedstock: GasificationFeedstock48B) kind empirical {
    label en official "the kind of the solid or liquid product the process converts: coal, petroleum residue, biomass, or other materials recovered for their energy or feedstock value (section 48B(c)(2)) — case-asserted";
}
pub relation process_produces_synthesis_gas_of_carbon_monoxide_and_hydrogen_48b(process: Asset) kind empirical {
    label en official "the process converts the product into a synthesis gas composed primarily of carbon monoxide and hydrogen (section 48B(c)(2)) — case-asserted";
}
pub relation synthesis_gas_for_direct_use_or_subsequent_conversion_48b(process: Asset) kind empirical {
    label en official "the synthesis gas is for direct use or subsequent chemical or physical conversion (section 48B(c)(2)) — case-asserted";
}
pub relation gasification_technology_defined_48b(process: Asset) kind institutional {
    label en official "section 48B(c)(2): a process converting coal, petroleum residue, biomass or other materials recovered for their energy or feedstock value into a synthesis gas of primarily carbon monoxide and hydrogen for direct use or subsequent conversion";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "means any process which converts a solid or liquid product from coal, petroleum residue, biomass, or other materials which are recovered for their energy or feedstock value into a synthesis gas composed primarily of carbon monoxide and hydrogen")
rule GasificationTechnologyDefinedRule(process: Asset, feedstock: GasificationFeedstock48B) strict {
    when process_feedstock_48b(process, feedstock);
    when feedstock != NonQualifyingFeedstock;
    when process_produces_synthesis_gas_of_carbon_monoxide_and_hydrogen_48b(process);
    when synthesis_gas_for_direct_use_or_subsequent_conversion_48b(process);
    then gasification_technology_defined_48b(process);
}

// --- (c)(5): carbon capture capability -----------------------------------------------------------------------------------------------------------------------

pub relation plant_design_48b(design: Asset) kind empirical {
    label en official "the gasification plant design — case-asserted";
}
pub relation design_accommodates_carbon_dioxide_capture_equipment_48b(design: Asset) kind empirical {
    label en official "the design reflects reasonable consideration for, and is capable of, accommodating the equipment likely to be necessary to capture carbon dioxide from the gaseous stream for later use or sequestration (section 48B(c)(5)) — case-asserted";
}
external judgment relation secretary_determines_carbon_capture_capability_48b(design: Asset) {
    authority Secretary;
    label en official "the Secretary determines that the gasification plant design reflects reasonable consideration for, and is capable of accommodating, the equipment likely to be necessary to capture carbon dioxide (section 48B(c)(5))";
}
pub relation carbon_capture_capability_48b(design: Asset) kind institutional {
    label en official "section 48B(c)(5): a gasification plant design determined by the Secretary to reflect reasonable consideration for, and be capable of, accommodating carbon dioxide capture equipment";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "means a gasification plant design which is determined by the Secretary to reflect reasonable consideration for, and be capable of, accommodating the equipment likely to be necessary to capture carbon dioxide from the gaseous stream")
rule CarbonCaptureCapability48bRule(design: Asset) defeasible {
    when plant_design_48b(design);
    when design_accommodates_carbon_dioxide_capture_equipment_48b(design);
    when secretary_determines_carbon_capture_capability_48b(design);
    then carbon_capture_capability_48b(design);
}

// --- (c)(7): eligible entity ----------------------------------------------------------------------------------------------------------------------------------------

pub relation application_principally_intended_for_domestic_project_with_application_48b(applicant: Person, application: GasificationApplication48B) kind empirical {
    label en official "the applicant's application for certification is principally intended for use in a domestic project which employs domestic gasification applications of the kind (section 48B(c)(7)) — case-asserted";
}
pub relation eligible_entity_48b(applicant: Person) kind institutional {
    label en official "section 48B(c)(7): a person whose application is principally intended for a domestic project employing domestic gasification applications related to chemicals, fertilizers, glass, steel, petroleum residues, forest products, agriculture (including feedlots and dairy operations) or transportation grade liquid fuels";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "The term \"eligible entity\" means any person whose application for certification is principally intended for use in a domestic project which employs domestic gasification applications related to")
rule EligibleEntity48bRule(applicant: Person, application: GasificationApplication48B) strict {
    when application_principally_intended_for_domestic_project_with_application_48b(applicant, application);
    when application != OtherApplication;
    then eligible_entity_48b(applicant);
}

// --- (c)(1), (c)(3): the project and eligible property ------------------------------------------------------------------------------------------------

pub relation project_process_48b(project: Asset, process: Asset) kind empirical {
    label en official "the gasification process of the project — case-asserted";
}
pub relation project_sponsor_48b(project: Asset, applicant: Person) kind empirical {
    label en official "the applicant that carries out the project — case-asserted";
}
pub relation project_meets_c1_a_and_b_48b(project: Asset) kind institutional {
    label en official "section 48B(c)(1)(A)-(B): the project employs gasification technology and will be carried out by an eligible entity";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "will be carried out by an eligible entity")
rule ProjectMeetsC1AAndBRule(project: Asset, process: Asset, applicant: Person) strict {
    when project_process_48b(project, process);
    when gasification_technology_defined_48b(process);
    when project_sponsor_48b(project, applicant);
    when eligible_entity_48b(applicant);
    then project_meets_c1_a_and_b_48b(project);
}
pub relation part_of_project_48b(part: Asset, project: Asset) kind empirical {
    label en official "the property is a part of the qualifying gasification project — case-asserted";
}
pub relation part_necessary_for_gasification_technology_48b(part: Asset) kind empirical {
    label en official "the property is necessary for the gasification technology of the project (section 48B(c)(3)) — case-asserted";
}
pub relation eligible_property_48b(part: Asset, project: Asset) kind institutional {
    label en official "section 48B(c)(3): property that is part of a qualifying gasification project and is necessary for its gasification technology";
}
@source(IRC_S48B_C, relation = formalizes, coverage = exact, quote = "any property which is a part of a qualifying gasification project and is necessary for the gasification technology of such project")
rule EligibleProperty48bRule(part: Asset, project: Asset) defeasible {
    when qualifying_gasification_project_48b(project);
    when part_of_project_48b(part, project);
    when part_necessary_for_gasification_technology_48b(part);
    then eligible_property_48b(part, project);
}

// --- (b)(1): the qualified investment --------------------------------------------------------------------------------------------------------------------------

pub relation part_basis_placed_in_service_in_year_48b(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the basis of the property placed in service by the taxpayer during the taxable year — case-asserted";
}
pub relation part_completed_by_taxpayer_48b(taxpayer: Person, part: Asset) kind empirical {
    label en official "the construction, reconstruction or erection of the property is completed by the taxpayer (section 48B(b)(1)(A)(i)) — case-asserted";
}
pub relation part_acquired_with_original_use_48b(taxpayer: Person, part: Asset) kind empirical {
    label en official "the property is acquired by the taxpayer and its original use commences with the taxpayer (section 48B(b)(1)(A)(ii)) — case-asserted";
}
pub relation part_depreciation_allowable_48b(part: Asset) kind empirical {
    label en official "depreciation (or amortization in lieu of depreciation) is allowable with respect to the property (section 48B(b)(1)(B)) — case-asserted";
}
pub relation qualified_part_basis_48b(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48B(b)(1): the basis of eligible property of a qualifying gasification project placed in service by the taxpayer in the year, completed by the taxpayer or acquired with original use, and depreciable";
}
@source(IRC_S48B_B, relation = formalizes, coverage = exact, quote = "the qualified investment for any taxable year is the basis of eligible property placed in service by the taxpayer during such taxable year which is part of a qualifying gasification project")
rule QualifiedPartBasisCompleted48bRule(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) defeasible {
    when eligible_property_48b(part, project);
    when part_basis_placed_in_service_in_year_48b(taxpayer, project, part, y, amount);
    when part_completed_by_taxpayer_48b(taxpayer, part);
    when part_depreciation_allowable_48b(part);
    then qualified_part_basis_48b(taxpayer, project, part, y, amount);
}
rule QualifiedPartBasisAcquired48bRule(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) defeasible {
    when eligible_property_48b(part, project);
    when part_basis_placed_in_service_in_year_48b(taxpayer, project, part, y, amount);
    when part_acquired_with_original_use_48b(taxpayer, part);
    when part_depreciation_allowable_48b(part);
    then qualified_part_basis_48b(taxpayer, project, part, y, amount);
}
pub relation qualified_investment_computed_48b(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48B(b)(1): the sum of the basis of the qualified eligible property of the project placed in service in the year";
}
rule QualifiedInvestmentComputed48bRule(taxpayer: Person, project: Asset, y: TaxableYear, one_part: Asset, one_amount: Money) defeasible {
    when qualified_part_basis_48b(taxpayer, project, one_part, y, one_amount);
    then qualified_investment_computed_48b(taxpayer, project, y,
        sum(collect all a: Money, p: Asset where qualified_part_basis_48b(taxpayer, project, p, y, a), empty: 0 USD));
}

// --- (d)(1): the program duty and the allocation caps ---------------------------------------------------------------------------------------------------

pub relation section_48b_enacted_on_48b(on: Date) kind empirical {
    label en official "the date of enactment of section 48B (the reference date of the (d)(1) time limit) — case-asserted from the pinned Public Law note";
}
pub relation program_established_48b(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary, in consultation with the Secretary of Energy, has established the qualifying gasification project program";
}
@source(IRC_S48B_D, relation = formalizes, coverage = exact, quote = "the Secretary, in consultation with the Secretary of Energy, shall establish a qualifying gasification project program to consider and award certifications")
rule Section48bD1ProgramDutyRule(on: Date) strict {
    when section_48b_enacted_on_48b(on);
    then duty Section48bD1ProgramDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition program_established_48b(us.irc.core::Secretary);
            window [on, add_calendar_period(on, 180 calendar_day)];
        }
    };
}
pub relation total_credits_allocated_48b(total: Money) kind empirical {
    label en official "the total amount of credit allocated under the program, including this allocation — case-asserted";
}
pub relation credits_allocated_to_sequestering_projects_48b(total: Money) kind empirical {
    label en official "the amount of credit allocated to qualifying gasification projects that include equipment which separates and sequesters at least 75 percent of the project's total carbon dioxide emissions — case-asserted";
}
pub relation allocation_within_program_caps_48b(total: Money) kind institutional {
    label en official "section 48B(d)(1): the total amount of credit allocated does not exceed $350,000,000 plus $250,000,000 for projects that separate and sequester at least 75 percent of their carbon dioxide emissions (the excess over $350,000,000 must be allocated to such projects)";
}
@source(IRC_S48B_D, relation = formalizes, coverage = exact, quote = "$250,000,000 for qualifying gasification projects that include equipment which separates and sequesters at least 75 percent of such project's total carbon dioxide emissions")
rule AllocationWithinProgramCaps48bRule(total: Money, sequestering: Money) strict {
    when total_credits_allocated_48b(total);
    when credits_allocated_to_sequestering_projects_48b(sequestering);
    when total <= 600000000.00 USD;
    when sequestering >= max(total - 350000000.00 USD, 0 USD);
    then allocation_within_program_caps_48b(total);
}
