// Section 48B — Qualifying gasification project credit. Stage 2d (IRC-06,
// DECISION-0379). A section 46 component (an investment credit).
//
// Scope / judgment calls:
// * (a): 20 percent of the qualified investment; 30 percent for credits
//   allocated under (d)(1)(B) (projects with equipment that separates and
//   sequesters at least 75 percent of total carbon dioxide emissions).
// * The qualified investment is limited to the amount the Secretary certified
//   ((c)(1)(C): not more than $650,000,000); the certified amount is a case
//   fact and the limit is applied per year to that year's investment (the
//   cumulative limit over years is not tracked; TECH-GAPS G1523).
// * (d): certification is a power of the Secretary with a timing window
//   (certificates only during the 10 fiscal years beginning on 2005-10-01);
//   (d)(3) is a PROHIBITION on the Secretary: no competitive certification
//   award unless the recipient has documented (A)-(F). The (d)(4) priority
//   directives and (c)(2)-(8) technology, biomass and eligible-entity
//   definitions are not decomposed (G1523, G1522-style classification facts).
// * (e): no credit for an investment for which section 48A allows a credit.
// * (f): the Secretary's recapture directive is a duty.

use self::{
    Asset,
    IRC_S48B_A,
    IRC_S48B_B,
    IRC_S48B_C,
    IRC_S48B_D,
    IRC_S48B_F,
    Person,
    TaxableYear,
    has_reduction_fraction_45b3,
    reduction_fraction_45b3,
};

pub relation qualified_investment_48b(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 48B(b)(1) qualified investment for the taxable year: the basis of eligible property placed in service as part of a qualifying gasification project — case-asserted";
}
pub relation certified_qualified_investment_48b(project: Asset, amount: Money) kind empirical {
    label en official "the portion of the qualified investment the Secretary certified as eligible for credit (section 48B(c)(1)(C)) — case-asserted";
}
pub relation project_employs_gasification_technology_48b(project: Asset) kind empirical {
    label en official "the project employs gasification technology (section 48B(c)(1)(A), (c)(2)) — case-asserted";
}
pub relation carried_out_by_eligible_entity_48b(project: Asset) kind empirical {
    label en official "the project is carried out by an eligible entity (section 48B(c)(1)(B), (c)(7)) — case-asserted";
}
pub relation allocated_under_d1b_48b(project: Asset) kind empirical {
    label en official "the credit is allocated under section 48B(d)(1)(B): the project includes equipment that separates and sequesters at least 75 percent of its total carbon dioxide emissions — case-asserted";
}
pub relation credit_allowed_under_48a_for_investment_48b(taxpayer: Person, project: Asset, y: TaxableYear) kind empirical {
    label en official "a credit is allowed under section 48A for the same qualified investment — case-asserted";
}

// --- (d): certification ------------------------------------------------------------

pub relation gasification_recipient_documented_requirements_48b(project: Asset) kind empirical {
    label en official "the award recipient documented to the Secretary's satisfaction (A) financial viability, (B) efficient spending information, (C) a market for the products, (D) at least 90 percent of the required fuels identified, (E) a competent project team, and (F) other published criteria (section 48B(d)(3)) — case-asserted";
}
pub relation secretary_makes_competitive_award_48b(project: Asset, applicant: Person, on: Date) kind empirical {
    label en official "the Secretary makes a competitive certification award for the project, on this date";
}
pub relation certificate_of_eligibility_issued_on_48b(project: Asset, on: Date) kind empirical {
    label en official "the certificate of eligibility under section 48B(d)(1) is issued on this date";
}
pub relation certification_within_issuance_period_48b(project: Asset) kind institutional {
    label en official "section 48B(d)(2): the certificate is issued during the 10-fiscal-year period beginning on October 1, 2005";
}
@source(IRC_S48B_D, quote = "A certificate of eligibility under paragraph (1) may be issued only during the 10-fiscal year period beginning on October 1, 2005.")
rule CertificationWithinIssuancePeriod48bRule(project: Asset, on: Date) strict {
    when certificate_of_eligibility_issued_on_48b(project, on);
    when on >= @2005-10-01;
    when on < @2015-10-01;
    then certification_within_issuance_period_48b(project);
}
pub relation certified_project_48b(project: Asset) kind institutional {
    label en official "the project's qualified investment is certified under the qualifying gasification program";
}
@source(IRC_S48B_D, quote = "to consider and award certifications for qualified investment eligible for credits under this section to qualifying gasification project sponsors under this section")
rule Section48bCertificationPowerRule(project: Asset, applicant: Person, on: Date) strict {
    when secretary_makes_competitive_award_48b(project, applicant, on);
    then power Section48bDCertification {
        holder us.irc.core::Secretary;
        over applicant;
        exercise secretary_makes_competitive_award_48b(project, applicant, on);
        valid_when certification_within_issuance_period_48b(project);
        effect create(certified_project_48b(project));
        window [@2005-08-08, infinity);
    };
}
@source(IRC_S48B_D, quote = "The Secretary shall not make a competitive certification award for qualified investment for credit eligibility under this section unless the recipient has documented to the satisfaction of the Secretary that")
rule Section48bD3AwardProhibitionRule(project: Asset, applicant: Person, on: Date) defeasible {
    when secretary_makes_competitive_award_48b(project, applicant, on);
    then prohibition Section48bD3AwardProhibition {
        bearer us.irc.core::Secretary;
        action secretary_makes_competitive_award_48b(project, applicant, on);
        window [@2005-08-08, infinity);
    };
    unless gasification_recipient_documented_requirements_48b(project)
        and secretary_makes_competitive_award_48b(project, applicant, on);
}

// --- (f): recapture directive ---------------------------------------------------------

pub relation project_fails_sequestration_requirements_48b(project: Asset) kind empirical {
    label en official "the project fails to attain or maintain the separation and sequestration requirements under subsection (d)(1) — case-asserted";
}
pub relation recapture_provided_for_48b(project: Asset) kind empirical {
    label en official "the Secretary has provided for recapturing the benefit of the credit for the project — case-asserted";
}
@source(IRC_S48B_F, quote = "The Secretary shall provide for recapturing the benefit of any credit allowable under subsection (a) with respect to any project which fails to attain or maintain the separation and sequestration requirements for such project under subsection (d)(1).")
rule Section48bFRecaptureDutyRule(project: Asset) strict {
    when project_fails_sequestration_requirements_48b(project);
    then duty Section48bFRecaptureDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition recapture_provided_for_48b(project);
            window [@2005-08-08, infinity);
        }
    };
}

// --- (a), (b), (e): the credit ---------------------------------------------------------

pub relation qualifying_gasification_project_48b(project: Asset) kind institutional {
    label en official "section 48B(c)(1): a project that employs gasification technology, is carried out by an eligible entity, and has a certified portion of its qualified investment";
}
@source(IRC_S48B_C, quote = "any portion of the qualified investment of which is certified under the qualifying gasification program as eligible for credit under this section")
rule QualifyingGasificationProject48bRule(project: Asset) strict {
    when project_employs_gasification_technology_48b(project);
    when carried_out_by_eligible_entity_48b(project);
    when certified_project_48b(project);
    then qualifying_gasification_project_48b(project);
}
pub relation gasification_credit_rate_48b(project: Asset, rate: Decimal) kind institutional {
    label en official "section 48B(a): 20 percent, or 30 percent for credits allocated under subsection (d)(1)(B)";
}
rule GasificationCreditRateStandard48bRule(project: Asset) strict {
    when qualifying_gasification_project_48b(project);
    when not_known(allocated_under_d1b_48b(project));
    then gasification_credit_rate_48b(project, 0.20);
}
@source(IRC_S48B_A, quote = "20 percent (30 percent in the case of credits allocated under subsection (d)(1)(B))")
rule GasificationCreditRateSequestration48bRule(project: Asset) strict {
    when qualifying_gasification_project_48b(project);
    when allocated_under_d1b_48b(project);
    then gasification_credit_rate_48b(project, 0.30);
}
pub relation gasification_credit_before_45b3_48b(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48B(a): the qualifying gasification project credit of one project before the section 48B(b)(2) reduction for tax-exempt bonds (stage 4)";
}
pub relation gasification_credit_per_project_48b(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48B(a), (b)(2): the qualifying gasification project credit of one project for the taxable year, after the reduction for tax-exempt bonds by the rule similar to section 45(b)(3)";
}
@source(IRC_S48B_B, quote = "Rules similar to section 48(a)(4) (without regard to subparagraph (D) thereof) shall apply for purposes of this section.")
rule GasificationCreditReduced45b3Similar48b(taxpayer: Person, project: Asset, y: TaxableYear, before: Money, f: Decimal) defeasible {
    label en official "section 48B(b)(2): the credit of the project reduced by the fraction of section 45(b)(3), the rule that section 48(a)(4) makes similar (stage 4)";
    when gasification_credit_before_45b3_48b(taxpayer, project, y, before);
    when reduction_fraction_45b3(project, y, f);
    then gasification_credit_per_project_48b(taxpayer, project, y, round(before * (1.0 - f), 2, "HALF_UP"));
}
rule GasificationCreditNotReduced45b3Similar48b(taxpayer: Person, project: Asset, y: TaxableYear, before: Money) defeasible {
    label en official "no tax-exempt bond financing of the project: the credit stands";
    when gasification_credit_before_45b3_48b(taxpayer, project, y, before);
    when not_known(has_reduction_fraction_45b3(project, y));
    then gasification_credit_per_project_48b(taxpayer, project, y, before);
}
@source(IRC_S48B_A, quote = "the qualifying gasification project credit for any taxable year is an amount equal to 20 percent")
rule GasificationCreditPerProject48bRule(taxpayer: Person, project: Asset, y: TaxableYear, rate: Decimal, investment: Money, certified: Money) defeasible {
    when gasification_credit_rate_48b(project, rate);
    when qualified_investment_48b(taxpayer, project, y, investment);
    when certified_qualified_investment_48b(project, certified);
    when not_known(credit_allowed_under_48a_for_investment_48b(taxpayer, project, y));
    then gasification_credit_before_45b3_48b(taxpayer, project, y, round(rate * min(investment, min(certified, 650000000.00 USD)), 2, "HALF_UP"));
}
pub relation qualifying_gasification_project_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 48B qualifying gasification project credit for the taxable year (a section 46(4) component of the investment credit)";
}
rule QualifyingGasificationProjectCredit48bRule(taxpayer: Person, y: TaxableYear, project: Asset, amount: Money) defeasible {
    when gasification_credit_per_project_48b(taxpayer, project, y, amount);
    then qualifying_gasification_project_credit(taxpayer, y,
        sum(collect all a: Money, p: Asset where gasification_credit_per_project_48b(taxpayer, p, y, a), empty: 0 USD));
}
