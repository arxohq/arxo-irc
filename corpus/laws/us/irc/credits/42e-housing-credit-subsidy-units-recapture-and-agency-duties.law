// Section 42 — (i)(2)-(9) federally subsidized buildings, the low-income unit
// exceptions, new and existing buildings, estates and trusts, rights of first
// refusal, the rural and 2009 rules; (j)(2)-(6) recapture refinements;
// (k) nonprofit and qualified-commercial financing; (l) certification, the
// information return and the agency report; (m)(1)(D) and (m)(2)(C)-(D)
// determinations; (n) regulations. Stage 2e (IRC-06, DECISION-0379, TECH_GAP
// reduction of TECH-GAPS G1822).
//
// Scope / judgment calls:
// * (i)(2): the new building is treated as federally subsidized when a tax-exempt
//   obligation whose proceeds were used for it (or its operation) is or was
//   outstanding at any time in the year or a prior year, unless the taxpayer
//   elects to exclude the proceeds from eligible basis or the construction-
//   financing exception applies. The election of (B) is a power; the negative
//   reader uses the raw exercise fact (a power effect is invisible to the
//   status-sensitive reader of the same round).
// * (j)(3): the accelerated portion is the credit allowed on the basis over the
//   credit that would have been allowable had the whole-period credit been
//   allowable ratably over 15 years (cents HALF_UP; the number of prior years is
//   a case fact).
// * (k)(3) (present value of below-market financing) is a TECH_GAP (a payment
//   schedule and a discount-rate present value are not expressible).
// * "Penalty under section 6652(j)" ((l)(2), (l)(3)) belongs to the penalties
//   package: an external dependency, only the failure to file is modelled.
// * Sections 42(n) and other regulation-authority clauses set no taxpayer-facing
//   test and are recorded as NON_NORMATIVE in the coverage.

// --- (i)(4)-(5): new and existing buildings ---------------------------------------------------------------------------------------------------------

use self::{
    Asset,
    IRC_S42_B,
    IRC_S42_I,
    IRC_S42_J,
    IRC_S42_K,
    IRC_S42_L,
    IRC_S42_M,
    Person,
    TaxableYear,
    agency_annual_report_submitted_42,
    applicable_fraction_of_building_without_e1_42,
    applicable_percentage_42b,
    applicable_percentage_secretary_prescribed,
    credit_period_year_42,
    credit_recapture_amount_42,
    following_taxable_year_of,
    has_qualified_basis_increase_42,
    issuer_determination_similar_to_m2_ab_made_42,
    low_income_housing_building_owned_by,
    low_income_unit_42,
    nonprofit_lender_special_repayment_date_applies_42k2d,
    original_use_begins_with_taxpayer_42,
    project_satisfies_allocation_plan_requirements_42,
    qualified_basis_at_close_42,
    qualified_basis_increase_42,
    qualified_nonprofit_organization_42,
    recapture_interest_42,
    taxpayer_certification_submitted_42,
    unit_in_building_42,
    unit_in_small_owner_occupied_building_42,
    unit_occupants_meet_income_limitation_42,
    unit_rent_restricted_42,
    unit_suitable_and_not_transient_42,
};

pub relation new_building_42(building: Asset, taxpayer: Person) kind institutional {
    label en official "section 42(i)(4): a building the original use of which begins with the taxpayer";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "The term \"new building\" means a building the original use of which begins with the taxpayer.")
rule NewBuilding42Rule(building: Asset, taxpayer: Person) strict {
    when original_use_begins_with_taxpayer_42(building, taxpayer);
    then new_building_42(building, taxpayer);
}
pub relation existing_building_42(building: Asset, taxpayer: Person) kind institutional {
    label en official "section 42(i)(5): any building which is not a new building";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "The term \"existing building\" means any building which is not a new building.")
rule ExistingBuilding42Rule(building: Asset, taxpayer: Person) strict {
    when low_income_housing_building_owned_by(building, taxpayer);
    when not_known(original_use_begins_with_taxpayer_42(building, taxpayer));
    then existing_building_42(building, taxpayer);
}

// --- (i)(2): federally subsidized ---------------------------------------------------------------------------------------------------------------------

pub relation tax_exempt_obligation_outstanding_used_for_building_in_year_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "at some time in the taxable year there is (or was) outstanding an obligation the interest on which is exempt from tax under section 103 the proceeds of which are or were used (directly or indirectly) with respect to the building or its operation (section 42(i)(2)(A)) — case-asserted per year";
}
pub relation elects_exclude_tax_exempt_proceeds_from_eligible_basis_42(taxpayer: Person, building: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 42(i)(2)(B) election to exclude the proceeds of the tax-exempt obligation from the eligible basis of the building";
}
pub relation tax_exempt_proceeds_excluded_from_eligible_basis_42(building: Asset) kind institutional {
    label en official "section 42(i)(2)(B): the proceeds of the tax-exempt obligation are excluded from the eligible basis for purposes of subsection (d) (a valid election)";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "A tax-exempt obligation shall not be taken into account under subparagraph (A) if the taxpayer elects to exclude from the eligible basis of the building for purposes of subsection (d) the proceeds of such obligation.")
rule Section42I2BElectionRule(taxpayer: Person, building: Asset, y: TaxableYear) defeasible {
    when low_income_housing_building_owned_by(building, taxpayer);
    when tax_exempt_obligation_outstanding_used_for_building_in_year_42(building, y);
    then power Section42I2BElection {
        holder taxpayer;
        over building;
        exercise elects_exclude_tax_exempt_proceeds_from_eligible_basis_42(taxpayer, building);
        valid_when tax_exempt_obligation_outstanding_used_for_building_in_year_42(building, y);
        effect create(tax_exempt_proceeds_excluded_from_eligible_basis_42(building));
        window [@1986-10-22, infinity);
    };
}
pub relation obligation_identified_building_when_issued_42(building: Asset) kind empirical {
    label en official "the obligation, when issued, identified the building for which its proceeds would be used (section 42(i)(2)(C)(i)) — case-asserted";
}
pub relation obligation_redeemed_before_placed_in_service_42(building: Asset) kind empirical {
    label en official "the obligation is redeemed before the building is placed in service (section 42(i)(2)(C)(ii)) — case-asserted";
}
pub relation construction_financing_exception_42(building: Asset) kind institutional {
    label en official "section 42(i)(2)(C): a tax-exempt obligation that provided construction financing, identified the building when issued and was redeemed before the building was placed in service, is not taken into account";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to any tax-exempt obligation used to provide construction financing for any building if—")
rule ConstructionFinancingException42Rule(building: Asset) strict {
    when obligation_identified_building_when_issued_42(building);
    when obligation_redeemed_before_placed_in_service_42(building);
    then construction_financing_exception_42(building);
}
pub relation federally_subsidized_by_i2_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(i)(2)(A): a new building is treated as federally subsidized for the year if at any time in the year or a prior year a tax-exempt obligation the proceeds of which were used with respect to it was outstanding, unless excluded by election or by the construction-financing exception";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this paragraph, for purposes of subsection (b)(1), a new building shall be treated as federally subsidized for any taxable year if, at any time during such taxable year or any prior taxable year, there is or was outstanding any obligation the interest on which is exempt from tax under section 103 the proceeds of which [1] are or were used (directly or indirectly) with respect to such building or the operation thereof.")
rule FederallySubsidizedByI2Rule(building: Asset, taxpayer: Person, y: TaxableYear, y0: TaxableYear, begin: Date, begin0: Date) strict {
    when low_income_housing_building_owned_by(building, taxpayer);
    when new_building_42(building, taxpayer);
    when tax_exempt_obligation_outstanding_used_for_building_in_year_42(building, y0);
    when us.irc.core::begins(y0, begin0);
    when us.irc.core::begins(y, begin);
    when begin0 <= begin;
    when not_known(elects_exclude_tax_exempt_proceeds_from_eligible_basis_42(taxpayer, building));
    when not_known(construction_financing_exception_42(building));
    then federally_subsidized_by_i2_42(building, y);
}
@source(IRC_S42_B, relation = formalizes, coverage = partial, quote = "In the case of any new or existing building to which paragraph (2) does not apply and which is placed in service by the taxpayer after December 31, 2020, the applicable percentage shall not be less than 4 percent.")
rule ApplicablePercentage4PercentFloorFederallySubsidizedI2Rule(building: Asset, y: TaxableYear, secretary_pct: Decimal) strict {
    when federally_subsidized_by_i2_42(building, y);
    when applicable_percentage_secretary_prescribed(building, y, secretary_pct);
    then applicable_percentage_42b(building, y, max(secretary_pct, 0.04));
}

// --- (i)(3)(B)(ii)-(iv), (D), (E): the low-income unit refinements ------------------------------------------------------------------------

pub relation unit_suitable_for_occupancy_42(unit: Asset) kind empirical {
    label en official "the unit is suitable for occupancy, determined under regulations taking into account local health, safety and building codes (section 42(i)(3)(B)(ii)) — case-asserted determination";
}
pub relation unit_has_sleeping_kitchen_and_bathroom_42(unit: Asset) kind empirical {
    label en official "the unit contains sleeping accommodations and kitchen and bathroom facilities (section 42(i)(3)(B)(iii)) — case-asserted";
}
pub relation building_used_exclusively_for_homeless_transition_within_24_months_42(building: Asset) kind empirical {
    label en official "the building is used exclusively to facilitate the transition of homeless individuals (section 103 of the McKinney-Vento Homeless Assistance Act) to independent living within 24 months (section 42(i)(3)(B)(iii)(I)) — case-asserted";
}
pub relation governmental_entity_or_nonprofit_provides_temporary_housing_and_services_42(building: Asset) kind empirical {
    label en official "a governmental entity or qualified nonprofit organization (section 42(h)(5)) provides the individuals with temporary housing and supportive services designed to help them locate and retain permanent housing (section 42(i)(3)(B)(iii)(II)) — case-asserted";
}
pub relation unit_is_single_room_occupancy_rented_month_to_month_42(unit: Asset) kind empirical {
    label en official "the unit is a single-room occupancy unit rented on a month-by-month basis (section 42(i)(3)(B)(iv)) — case-asserted";
}
pub relation unit_used_other_than_on_transient_basis_42(unit: Asset) kind institutional {
    label en official "section 42(i)(3)(B)(iii)-(iv): a unit in a homeless-transition building with the required facilities and supportive services is used other than on a transient basis; a single-room occupancy unit is not transient merely because rented month to month";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), a unit shall be considered to be used other than on a transient basis if the unit contains sleeping accommodations and kitchen and bathroom facilities and is located in a building—")
rule UnitNonTransientHomelessTransitionRule(unit: Asset, building: Asset) strict {
    when unit_in_building_42(unit, building);
    when unit_has_sleeping_kitchen_and_bathroom_42(unit);
    when building_used_exclusively_for_homeless_transition_within_24_months_42(building);
    when governmental_entity_or_nonprofit_provides_temporary_housing_and_services_42(building);
    then unit_used_other_than_on_transient_basis_42(unit);
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), a single-room occupancy unit shall not be treated as used on a transient basis merely because it is rented on a month-by-month basis.")
rule UnitNonTransientSingleRoomOccupancyRule(unit: Asset) strict {
    when unit_is_single_room_occupancy_rented_month_to_month_42(unit);
    then unit_used_other_than_on_transient_basis_42(unit);
}

pub relation occupant_student_receiving_title_iv_assistance_42(unit: Asset) kind empirical {
    label en official "the unit is occupied by a student receiving assistance under title IV of the Social Security Act (section 42(i)(3)(D)(i)(I)) — case-asserted";
}
pub relation occupant_former_foster_care_student_42(unit: Asset) kind empirical {
    label en official "the unit is occupied by a student previously under the care and placement responsibility of the State agency administering a plan under part B or E of title IV of the Social Security Act (section 42(i)(3)(D)(i)(II)) — case-asserted";
}
pub relation occupant_enrolled_in_job_training_program_42(unit: Asset) kind empirical {
    label en official "the unit is occupied by an individual enrolled in a job training program receiving assistance under the Job Training Partnership Act or similar Federal, State or local laws (section 42(i)(3)(D)(i)(III)) — case-asserted";
}
pub relation unit_occupied_entirely_by_full_time_single_parent_students_42(unit: Asset) kind empirical {
    label en official "the unit is occupied entirely by full-time students who are single parents and their children, the parents not dependents of another individual (section 152 determined without regard to (b)(1), (b)(2), (d)(1)(B)) and the children not dependents of another individual other than a parent (section 42(i)(3)(D)(ii)(I)) — case-asserted";
}
pub relation unit_occupied_entirely_by_full_time_students_married_filing_jointly_42(unit: Asset) kind empirical {
    label en official "the unit is occupied entirely by full-time students who are married and file a joint return (section 42(i)(3)(D)(ii)(II)) — case-asserted";
}
pub relation unit_occupancy_excepted_under_i3d_42(unit: Asset) kind institutional {
    label en official "section 42(i)(3)(D): a unit does not fail to be a low-income unit merely because it is occupied by the listed students or trainees, or entirely by qualifying full-time students";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "A unit shall not fail to be treated as a low-income unit merely because it is occupied—")
rule UnitOccupancyExceptedTitleIvRule(unit: Asset) strict {
    when occupant_student_receiving_title_iv_assistance_42(unit);
    then unit_occupancy_excepted_under_i3d_42(unit);
}
rule UnitOccupancyExceptedFosterCareRule(unit: Asset) strict {
    when occupant_former_foster_care_student_42(unit);
    then unit_occupancy_excepted_under_i3d_42(unit);
}
rule UnitOccupancyExceptedJobTrainingRule(unit: Asset) strict {
    when occupant_enrolled_in_job_training_program_42(unit);
    then unit_occupancy_excepted_under_i3d_42(unit);
}
rule UnitOccupancyExceptedSingleParentStudentsRule(unit: Asset) strict {
    when unit_occupied_entirely_by_full_time_single_parent_students_42(unit);
    then unit_occupancy_excepted_under_i3d_42(unit);
}
rule UnitOccupancyExceptedMarriedStudentsRule(unit: Asset) strict {
    when unit_occupied_entirely_by_full_time_students_married_filing_jointly_42(unit);
    then unit_occupancy_excepted_under_i3d_42(unit);
}

pub relation development_plan_sponsored_by_government_or_nonprofit_42(building: Asset) kind empirical {
    label en official "the acquisition or rehabilitation of the building is pursuant to a development plan of action sponsored by a State or local government or a qualified nonprofit organization (section 42(h)(5)(C)) (section 42(i)(3)(E)(i)) — case-asserted";
}
pub relation unit_fraction_of_building_42(building: Asset, fraction: Decimal) kind empirical {
    label en official "the unit fraction of the building (section 42(c)(1)(B)(i)) — case-asserted";
}
pub relation applicable_fraction_after_i3e_cap_42(building: Asset, fraction: Decimal) kind institutional {
    label en official "section 42(i)(3)(E)(ii): for a building to which clause (i) applies, the applicable fraction does not exceed 80 percent of the unit fraction";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "In the case of a building to which clause (i) applies, the applicable fraction shall not exceed 80 percent of the unit fraction.")
rule ApplicableFractionAfterI3eCapRule(building: Asset, applicable: Decimal, unit_fraction: Decimal) strict {
    when development_plan_sponsored_by_government_or_nonprofit_42(building);
    when applicable_fraction_of_building_without_e1_42(building, applicable);
    when unit_fraction_of_building_42(building, unit_fraction);
    then applicable_fraction_after_i3e_cap_42(building, min(applicable, 0.80 * unit_fraction));
}
pub relation unit_not_rented_for_90_days_or_more_42(unit: Asset) kind empirical {
    label en official "the unit is not rented for 90 days or more (section 42(i)(3)(E)(iii)) — case-asserted";
}
pub relation unit_treated_as_owner_occupied_42(unit: Asset) kind institutional {
    label en official "section 42(i)(3)(E)(iii): in a building to which clause (i) applies, a unit not rented for 90 days or more is treated as occupied by the owner as of the first day it is not rented";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "In the case of a building to which clause (i) applies, any unit which is not rented for 90 days or more shall be treated as occupied by the owner of the building as of the 1st day it is not rented.")
rule UnitTreatedAsOwnerOccupiedRule(unit: Asset, building: Asset) strict {
    when unit_in_building_42(unit, building);
    when development_plan_sponsored_by_government_or_nonprofit_42(building);
    when unit_not_rented_for_90_days_or_more_42(unit);
    then unit_treated_as_owner_occupied_42(unit);
}
pub relation small_owner_occupied_exclusion_applies_42(unit: Asset) kind institutional {
    label en official "section 42(i)(3)(C), (E)(i): the exclusion of units in a small owner-occupied building applies unless the building is acquired or rehabilitated under a sponsored development plan of action";
}
rule SmallOwnerOccupiedExclusionAppliesRule(unit: Asset, building: Asset) strict {
    when unit_in_small_owner_occupied_building_42(unit);
    when unit_in_building_42(unit, building);
    when not_known(development_plan_sponsored_by_government_or_nonprofit_42(building));
    then small_owner_occupied_exclusion_applies_42(unit);
}
@source(IRC_S42_I, relation = formalizes, coverage = partial, quote = "Subparagraph (C) shall not apply to the acquisition or rehabilitation of a building pursuant to a development plan of action sponsored by a State or local government or a qualified nonprofit organization (as defined in subsection (h)(5)(C)).")
rule LowIncomeUnitNonTransientIiiRule(unit: Asset) strict {
    when unit_rent_restricted_42(unit);
    when unit_occupants_meet_income_limitation_42(unit);
    when unit_suitable_for_occupancy_42(unit);
    when unit_used_other_than_on_transient_basis_42(unit);
    when not_known(small_owner_occupied_exclusion_applies_42(unit));
    then low_income_unit_42(unit);
}
rule LowIncomeUnitStudentExceptionRule(unit: Asset) strict {
    when unit_rent_restricted_42(unit);
    when unit_occupancy_excepted_under_i3d_42(unit);
    when unit_suitable_and_not_transient_42(unit);
    when not_known(small_owner_occupied_exclusion_applies_42(unit));
    then low_income_unit_42(unit);
}

// --- (i)(6): estates and trusts -----------------------------------------------------------------------------------------------------------------------------

pub relation income_of_estate_or_trust_allocable_to_42(estate: Person, recipient: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the income of the estate or trust for the year allocable to the recipient (the estate or trust itself or a beneficiary) (section 42(i)(6)) — case-asserted";
}
pub relation total_income_of_estate_or_trust_42(estate: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total income of the estate or trust for the year (section 42(i)(6)) — case-asserted";
}
pub relation credit_of_estate_or_trust_42(estate: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit determined under section 42(a) for the estate or trust before apportionment — case-asserted";
}
pub relation credit_apportioned_to_recipient_42(estate: Person, recipient: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(i)(6): the credit is apportioned between the estate or trust and the beneficiaries on the basis of the income of the estate or trust allocable to each";
}
@source(IRC_S42_I, relation = formalizes, coverage = partial, quote = "In the case of an estate or trust, the amount of the credit determined under subsection (a) and any increase in tax under subsection (j) shall be apportioned between the estate or trust and the beneficiaries on the basis of the income of the estate or trust allocable to each.")
rule CreditApportionedToRecipientRule(estate: Person, recipient: Person, y: TaxableYear, credit: Money, share: Money, total: Money) strict {
    when credit_of_estate_or_trust_42(estate, y, credit);
    when income_of_estate_or_trust_allocable_to_42(estate, recipient, y, share);
    when total_income_of_estate_or_trust_42(estate, y, total);
    when total > 0 USD;
    // JUDGMENT CALL: cents, HALF_UP.
    then credit_apportioned_to_recipient_42(estate, recipient, y, div_round(credit * (share / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation recapture_of_estate_or_trust_42(estate: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the increase in tax under section 42(j) for the estate or trust before apportionment — case-asserted";
}
pub relation recapture_apportioned_to_recipient_42(estate: Person, recipient: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(i)(6): any increase in tax under subsection (j) is apportioned by the income of the estate or trust allocable to each";
}
rule RecaptureApportionedToRecipientRule(estate: Person, recipient: Person, y: TaxableYear, recapture: Money, share: Money, total: Money) strict {
    when recapture_of_estate_or_trust_42(estate, y, recapture);
    when income_of_estate_or_trust_allocable_to_42(estate, recipient, y, share);
    when total_income_of_estate_or_trust_42(estate, y, total);
    when total > 0 USD;
    then recapture_apportioned_to_recipient_42(estate, recipient, y, div_round(recapture * (share / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// --- (i)(7): rights of first refusal --------------------------------------------------------------------------------------------------------------------------

pub relation right_of_first_refusal_held_by_tenants_or_nonprofit_or_agency_42(building: Asset) kind empirical {
    label en official "a right of first refusal to purchase the property after the close of the compliance period is held by the tenants (in cooperative form or otherwise), a resident management corporation, a qualified nonprofit organization (section 42(h)(5)(C)) or a government agency (section 42(i)(7)(A)) — case-asserted";
}
pub relation rofr_purchase_price_42(building: Asset, amount: Money) kind empirical {
    label en official "the price at which the right of first refusal may be exercised — case-asserted";
}
pub relation rofr_indebtedness_other_than_recent_42(building: Asset, amount: Money) kind empirical {
    label en official "the principal amount of outstanding indebtedness secured by the building, other than indebtedness incurred within the 5-year period ending on the date of the sale to the tenants (section 42(i)(7)(B)(i)) — case-asserted";
}
pub relation rofr_taxes_attributable_to_sale_42(building: Asset, amount: Money) kind empirical {
    label en official "all Federal, State and local taxes attributable to the sale, without any additional non-Federal-income tax attributable to the application of clause (ii) (section 42(i)(7)(B)(ii), last sentence) — case-asserted";
}
pub relation rofr_minimum_purchase_price_42(building: Asset, amount: Money) kind institutional {
    label en official "section 42(i)(7)(B): the minimum purchase price is the outstanding secured indebtedness (excluding indebtedness of the last 5 years) plus the taxes attributable to the sale";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the minimum purchase price under this subparagraph is an amount equal to the sum of—")
rule RofrMinimumPurchasePriceRule(building: Asset, debt: Money, taxes: Money) strict {
    when rofr_indebtedness_other_than_recent_42(building, debt);
    when rofr_taxes_attributable_to_sale_42(building, taxes);
    then rofr_minimum_purchase_price_42(building, debt + taxes);
}
pub relation federal_income_tax_benefit_protected_from_rofr_42(taxpayer: Person, building: Asset) kind institutional {
    label en official "section 42(i)(7)(A): no Federal income tax benefit fails to be allowable to the taxpayer merely by reason of a right of first refusal at a price not less than the minimum purchase price";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "No Federal income tax benefit shall fail to be allowable to the taxpayer with respect to any qualified low-income building merely by reason of a right of 1st refusal held by the tenants (in cooperative form or otherwise) or resident management corporation of such building or by a qualified nonprofit organization")
rule RofrImmunityRule(taxpayer: Person, building: Asset, price: Money, minimum: Money) strict {
    when low_income_housing_building_owned_by(building, taxpayer);
    when right_of_first_refusal_held_by_tenants_or_nonprofit_or_agency_42(building);
    when rofr_purchase_price_42(building, price);
    when rofr_minimum_purchase_price_42(building, minimum);
    when price >= minimum;
    then immunity Section42I7RofrProtection {
        holder taxpayer;
        protected_effect federal_income_tax_benefit_disallowed_by_rofr_42(taxpayer, building);
        window [@1986-10-22, infinity);
    };
}
pub relation federal_income_tax_benefit_disallowed_by_rofr_42(taxpayer: Person, building: Asset) kind institutional {
    label en official "the disallowance of a Federal income tax benefit with respect to the qualified low-income building by reason of the right of first refusal (the effect protected by section 42(i)(7)(A))";
}

// --- (i)(8): rural areas; (i)(9): the 2009 grant rules ------------------------------------------------------------------------------------------

pub relation project_in_rural_area_42(project: Asset) kind empirical {
    label en official "the project is residential rental property located in a rural area as defined in section 520 of the Housing Act of 1949 (section 42(i)(8)) — case-asserted";
}
pub relation area_median_gross_income_42(project: Asset, amount: Money) kind empirical {
    label en official "area median gross income for the project — case-asserted";
}
pub relation national_non_metropolitan_median_income_42(amount: Money) kind empirical {
    label en official "national non-metropolitan median income — case-asserted";
}
pub relation h1_does_not_apply_by_reason_of_h4_42(project: Asset) kind empirical {
    label en official "section 42(h)(1) does not apply to the building by reason of paragraph (4) of section 42(h) (section 42(i)(8), last sentence) — case-asserted";
}
pub relation income_measure_for_limitation_42(project: Asset, amount: Money) kind institutional {
    label en official "section 42(i)(8): for a rural project, an income limitation measured by area median gross income is measured by the greater of area median gross income or national non-metropolitan median income (the sentence does not apply where paragraph (1) of section 42(h) does not apply by reason of paragraph (4))";
}
@source(IRC_S42_I, relation = formalizes, coverage = partial, quote = "any income limitation measured by reference to area median gross income shall be measured by reference to the greater of area median gross income or national non-metropolitan median income.")
rule IncomeMeasureRuralRule(project: Asset, ami: Money, national: Money) strict {
    when project_in_rural_area_42(project);
    when area_median_gross_income_42(project, ami);
    when national_non_metropolitan_median_income_42(national);
    when not_known(h1_does_not_apply_by_reason_of_h4_42(project));
    then income_measure_for_limitation_42(project, max(ami, national));
}
rule IncomeMeasureNonRuralRule(project: Asset, ami: Money) strict {
    when area_median_gross_income_42(project, ami);
    when not_known(project_in_rural_area_42(project));
    then income_measure_for_limitation_42(project, ami);
}
rule IncomeMeasureRuralH4Rule(project: Asset, ami: Money) strict {
    when project_in_rural_area_42(project);
    when area_median_gross_income_42(project, ami);
    when h1_does_not_apply_by_reason_of_h4_42(project);
    then income_measure_for_limitation_42(project, ami);
}
pub relation state_2009_ceiling_component_42(state: Person, component: Decimal, amount: Money) kind empirical {
    label en official "one of the amounts described in clauses (i) through (iv) of section 42(h)(3)(C) for the State for 2009: component number 1-4 — case-asserted";
}
pub relation section_1602_grant_taken_into_account_42(state: Person, component: Decimal, amount: Money) kind empirical {
    label en official "so much of the component amount as is taken into account in determining the grant to the State under section 1602 of the American Recovery and Reinvestment Tax Act of 2009 (section 42(i)(9)(A)) — case-asserted";
}
pub relation state_2009_ceiling_component_reduced_42(state: Person, component: Decimal, amount: Money) kind institutional {
    label en official "section 42(i)(9)(A): each of the 2009 amounts described in clauses (i) through (iv) of subsection (h)(3)(C) is reduced by the part taken into account in the section 1602 grant";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "For purposes of this section, the amounts described in clauses (i) through (iv) of subsection (h)(3)(C) with respect to any State for 2009 shall each be reduced by so much of such amount as is taken into account in determining the amount of any grant to such State under section 1602 of the American Recovery and Reinvestment Tax Act of 2009.")
rule State2009CeilingComponentReducedRule(state: Person, component: Decimal, amount: Money, grant: Money) strict {
    when state_2009_ceiling_component_42(state, component, amount);
    when section_1602_grant_taken_into_account_42(state, component, grant);
    then state_2009_ceiling_component_reduced_42(state, component, amount - grant);
}
pub relation basis_reduction_for_section_1602_grant_42(building: Asset, amount: Money) kind institutional {
    label en official "section 42(i)(9)(B): the basis of a qualified low-income building is not reduced by the amount of a section 1602 grant (the basis reduction is zero)";
}
pub relation building_basis_before_grant_adjustment_42(building: Asset, amount: Money) kind empirical {
    label en official "the basis of the qualified low-income building before considering any section 1602 grant — case-asserted";
}
pub relation building_basis_after_grant_adjustment_42(building: Asset, amount: Money) kind institutional {
    label en official "section 42(i)(9)(B): the basis of a qualified low-income building is not reduced by the amount of a grant described in subparagraph (A)";
}
@source(IRC_S42_I, relation = formalizes, coverage = exact, quote = "Basis of a qualified low-income building shall not be reduced by the amount of any grant described in subparagraph (A).")
rule BuildingBasisNotReducedByGrantRule(building: Asset, basis: Money) strict {
    when building_basis_before_grant_adjustment_42(building, basis);
    then building_basis_after_grant_adjustment_42(building, basis);
}

// --- (j)(3): the accelerated portion ----------------------------------------------------------------------------------------------------------------------

pub relation aggregate_credit_allowed_prior_years_on_basis_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate credit allowed by reason of section 42 (without regard to subsection (j)) for the prior years with respect to the basis (section 42(j)(3)(A)) — case-asserted";
}
pub relation aggregate_credit_for_entire_compliance_period_on_basis_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate credit that would (but for subsection (j)) have been allowable for the entire compliance period with respect to the basis (section 42(j)(3)(B)) — case-asserted";
}
pub relation prior_taxable_years_count_42(building: Asset, y: TaxableYear, years: Decimal) kind empirical {
    label en official "the number of prior taxable years taken into account (of the 15-year ratable period) — case-asserted";
}
pub relation accelerated_portion_of_credit_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(3): the excess of the credit allowed for the prior years over the credit that would be allowable had the whole-period credit been allowable ratably over 15 years";
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (2), the accelerated portion of the credit for the prior taxable years with respect to any amount of basis is the excess of—")
rule AcceleratedPortionOfCredit42Rule(building: Asset, y: TaxableYear, allowed: Money, whole: Money, years: Decimal) strict {
    when aggregate_credit_allowed_prior_years_on_basis_42(building, y, allowed);
    when aggregate_credit_for_entire_compliance_period_on_basis_42(building, y, whole);
    when prior_taxable_years_count_42(building, y, years);
    when allowed > div_round(whole * years, 15.0, 2, "HALF_UP");
    then accelerated_portion_of_credit_42(building, y, allowed - div_round(whole * years, 15.0, 2, "HALF_UP"));
}

// --- (j)(4): limitations and the Secretary's de minimis relief --------------------------------------------------------------------------------

pub relation qualified_basis_credited_in_year_42(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified basis taken into account in determining the credit under subsection (a) for the taxable year (section 42(j)(4)(B)) — case-asserted";
}
pub relation recapturable_qualified_basis_decrease_42(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(4)(B)-(C): the decrease in qualified basis, counting the preceding-year basis only to the extent credited and only to the extent it exceeds the basis credited by reason of subsection (f)(3)";
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "Qualified basis shall be taken into account under paragraph (1)(B) only to the extent such basis was taken into account in determining the credit under subsection (a) for the preceding taxable year referred to in such paragraph.")
rule RecapturableDecreaseNoF3Rule(building: Asset, y: TaxableYear, previous: TaxableYear, now: Money, before: Money, credited: Money) strict {
    when following_taxable_year_of(previous, y);
    when qualified_basis_at_close_42(building, y, now);
    when qualified_basis_at_close_42(building, previous, before);
    when qualified_basis_credited_in_year_42(building, previous, credited);
    when not_known(has_qualified_basis_increase_42(building, previous));
    when min(before, credited) > now;
    then recapturable_qualified_basis_decrease_42(building, y, min(before, credited) - now);
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall apply to a decrease in qualified basis only to the extent such decrease exceeds the amount of qualified basis with respect to which a credit was allowable for the taxable year referred to in paragraph (1)(B) by reason of subsection (f)(3).")
rule RecapturableDecreaseAfterF3Rule(building: Asset, y: TaxableYear, previous: TaxableYear, now: Money, before: Money, credited: Money, increase: Money) strict {
    when following_taxable_year_of(previous, y);
    when qualified_basis_at_close_42(building, y, now);
    when qualified_basis_at_close_42(building, previous, before);
    when qualified_basis_credited_in_year_42(building, previous, credited);
    when qualified_basis_increase_42(building, previous, increase);
    when min(before, credited) - now > increase;
    then recapturable_qualified_basis_decrease_42(building, y, min(before, credited) - now - increase);
}
pub relation credit_used_to_reduce_tax_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the credits allowed by reason of section 42 that was used to reduce tax liability (section 42(j)(4)(A)) — case-asserted";
}
pub relation recapture_limited_to_credits_used_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(4)(A): the tax is increased only with respect to credits used to reduce tax liability";
}
@source(IRC_S42_J, relation = formalizes, coverage = partial, quote = "The tax for the taxable year shall be increased under paragraph (1) only with respect to credits allowed by reason of this section which were used to reduce tax liability.")
rule RecaptureLimitedToCreditsUsedRule(taxpayer: Person, building: Asset, y: TaxableYear, recapture: Money, used: Money) defeasible {
    when credit_recapture_amount_42(taxpayer, building, y, recapture);
    when credit_used_to_reduce_tax_42(taxpayer, building, y, used);
    then recapture_limited_to_credits_used_42(taxpayer, building, y, min(recapture, used));
}
pub relation carryover_adjustment_for_unused_credit_recapture_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(4)(A): for credits not used to reduce tax liability, the section 39 carryforwards and carrybacks are appropriately adjusted (the recapture amount not collected as tax)";
}
rule CarryoverAdjustmentForUnusedCreditRule(taxpayer: Person, building: Asset, y: TaxableYear, recapture: Money, used: Money) defeasible {
    when credit_recapture_amount_42(taxpayer, building, y, recapture);
    when credit_used_to_reduce_tax_42(taxpayer, building, y, used);
    when recapture > used;
    then carryover_adjustment_for_unused_credit_recapture_42(taxpayer, building, y, recapture - used);
}
pub relation tax_imposed_by_chapter_1_before_recapture_42(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the tax imposed by chapter 1 for the taxable year — case-asserted";
}
pub relation increase_in_tax_under_42j_total_42(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate increase in tax under section 42(j) for the taxable year — case-asserted";
}
pub relation tax_for_credit_limits_excluding_42j_42(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(4)(D): the increase in tax under subsection (j) is not treated as a tax imposed by chapter 1 for purposes of determining the amount of any credit under chapter 1";
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "Any increase in tax under this subsection shall not be treated as a tax imposed by this chapter for purposes of determining the amount of any credit under this chapter.")
rule TaxForCreditLimitsExcluding42jRule(taxpayer: Person, y: TaxableYear, tax: Money, increase: Money) strict {
    when tax_imposed_by_chapter_1_before_recapture_42(taxpayer, y, tax);
    when increase_in_tax_under_42j_total_42(taxpayer, y, increase);
    then tax_for_credit_limits_excluding_42j_42(taxpayer, y, tax - increase);
}
pub relation de_minimis_floor_space_change_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "the increase in tax results from a de minimis change in the floor space fraction under subsection (c)(1) (section 42(j)(4)(F)(i)) — case-asserted";
}
pub relation building_qualified_after_change_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "the building is a qualified low-income building after the change (section 42(j)(4)(F)(ii)) — case-asserted";
}
relation de_minimis_relief_conditions_met_42(building: Asset, y: TaxableYear) kind institutional;
rule DeMinimisReliefConditionsMetRule(building: Asset, y: TaxableYear) strict {
    when de_minimis_floor_space_change_42(building, y);
    when building_qualified_after_change_42(building, y);
    then de_minimis_relief_conditions_met_42(building, y);
}
pub relation secretary_provides_de_minimis_relief_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "the Secretary's exercise of the section 42(j)(4)(F) authority to provide that the increase in tax does not apply to the building for the year";
}
pub relation recapture_disapplied_by_secretary_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(j)(4)(F): the Secretary provides that the increase in tax under subsection (j) does not apply to the building (a de minimis floor space change, the building still qualified)";
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "The Secretary may provide that the increase in tax under this subsection shall not apply with respect to any building if—")
rule Section42J4FSecretaryReliefRule(building: Asset, y: TaxableYear) defeasible {
    when de_minimis_relief_conditions_met_42(building, y);
    then power Section42J4FDeMinimisRelief {
        holder us.irc.core::Secretary;
        over building;
        exercise secretary_provides_de_minimis_relief_42(building, y);
        valid_when de_minimis_relief_conditions_met_42(building, y);
        effect create(recapture_disapplied_by_secretary_42(building, y));
        window [@1986-10-22, infinity);
    };
}

// --- (j)(5): partnerships with 35 or more partners -----------------------------------------------------------------------------------------------

pub relation partnership_partner_count_42(partnership: Person, partners: Decimal) kind empirical {
    label en official "the number of partners of the partnership, a husband and wife (and their estates) counting as 1 partner (section 42(j)(5)(C)(i)) — case-asserted";
}
pub relation partnership_elects_out_of_j5_42(partnership: Person) kind empirical {
    label en official "the partnership's election not to have section 42(j)(5) apply (section 42(j)(5)(B)); once made, irrevocable (clause (C)(ii))";
}
pub relation section_42_j5_applies_to_partnership_42(partnership: Person) kind institutional {
    label en official "section 42(j)(5)(B): paragraph (5) applies to any partnership with 35 or more partners unless the partnership elects not to have it apply";
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "This paragraph shall apply to any partnership which has 35 or more partners unless the partnership elects not to have this paragraph apply.")
rule Section42J5AppliesRule(partnership: Person, partners: Decimal) strict {
    when partnership_partner_count_42(partnership, partners);
    when partners >= 35.0;
    when not_known(partnership_elects_out_of_j5_42(partnership));
    then section_42_j5_applies_to_partnership_42(partnership);
}
pub relation partner_share_of_taxable_income_42(partnership: Person, partner: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the partner's allocated share of the partnership's taxable income for the year (section 42(j)(5)(A)(iv)) — case-asserted";
}
pub relation partnership_taxable_income_42(partnership: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the partnership's taxable income for the year — case-asserted";
}
pub relation partnership_recapture_amount_42(partnership: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the increase in tax under section 42(j) computed with the partnership treated as the taxpayer to which the credit was allowed (section 42(j)(5)(A)(i)-(iii)) — case-asserted";
}
pub relation partner_share_of_partnership_recapture_42(partnership: Person, partner: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(5)(A)(iv): the increase in tax is allocated among the partners in the same manner as the partnership's taxable income is allocated";
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "(iv) the amount of the increase in tax under this subsection for any taxable year shall be allocated among the partners of such partnership in the same manner as such partnership's taxable income for such year is allocated among such partners.")
rule PartnerShareOfPartnershipRecaptureRule(partnership: Person, partner: Person, y: TaxableYear, recapture: Money, share: Money, total: Money) strict {
    when section_42_j5_applies_to_partnership_42(partnership);
    when partnership_recapture_amount_42(partnership, y, recapture);
    when partner_share_of_taxable_income_42(partnership, partner, y, share);
    when partnership_taxable_income_42(partnership, y, total);
    when total > 0 USD;
    then partner_share_of_partnership_recapture_42(partnership, partner, y, div_round(recapture * (share / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// --- (j)(2)(C), (j)(6)(B): interest deduction and the extended assessment period --------------------------------------------------------------

pub relation interest_on_recapture_amount_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(j)(2)(B): the interest described in that subparagraph; no deduction is allowed under chapter 1 for it (section 42(j)(2), last sentence)";
}
rule InterestOnRecaptureAmountRule(taxpayer: Person, building: Asset, y: TaxableYear, interest: Money) strict {
    when recapture_interest_42(taxpayer, building, y, interest);
    then interest_on_recapture_amount_42(taxpayer, building, y, interest);
}
pub relation interest_on_recapture_deducted_42(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer claims a deduction under chapter 1 for interest described in section 42(j)(2)(B) — the action bound by section 42(j)(2), last sentence";
}
@source(IRC_S42_J, relation = formalizes, coverage = exact, quote = "No deduction shall be allowed under this chapter for interest described in subparagraph (B).")
rule Section42J2NoInterestDeductionRule(taxpayer: Person, y: TaxableYear) defeasible {
    when interest_on_recapture_deducted_42(taxpayer, y);
    then prohibition Section42J2NoInterestDeduction {
        bearer taxpayer;
        action interest_on_recapture_deducted_42(taxpayer, y);
        window [@1986-10-22, infinity);
    };
}
pub relation building_disposed_of_with_qualified_basis_reduction_in_year_42(building: Asset, y: TaxableYear) kind empirical {
    label en official "the building (or an interest in it) is disposed of during the taxable year and there is a reduction in its qualified basis resulting in an increase in tax under section 42(j) for that or a later year (section 42(j)(6)(B)) — case-asserted";
}
pub relation secretary_notified_of_basis_reduction_on_42(building: Asset, on: Date) kind empirical {
    label en official "the date the Secretary is notified by the taxpayer of the reduction in qualified basis (section 42(j)(6)(B)(i)) — case-asserted";
}
pub relation assessment_period_end_for_42j_deficiency_42(building: Asset, until: Date) kind institutional {
    label en official "section 42(j)(6)(B)(i): the statutory period for assessing the deficiency does not expire before 3 years from the date the Secretary is notified of the reduction in qualified basis";
}
@source(IRC_S42_J, relation = formalizes, coverage = partial, quote = "(i) the statutory period for the assessment of any deficiency with respect to such increase in tax shall not expire before the expiration of 3 years from the date the Secretary is notified by the taxpayer (in such manner as the Secretary may prescribe) of such reduction in qualified basis, and")
rule AssessmentPeriodEndFor42jRule(building: Asset, y: TaxableYear, notified: Date) strict {
    when building_disposed_of_with_qualified_basis_reduction_in_year_42(building, y);
    when secretary_notified_of_basis_reduction_on_42(building, notified);
    then assessment_period_end_for_42j_deficiency_42(building, add_calendar_period(notified, 36 calendar_month));
}
pub relation deficiency_assessable_notwithstanding_other_law_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(j)(6)(B)(ii): the deficiency may be assessed before the 3-year period expires notwithstanding any other law or rule of law that would otherwise prevent the assessment";
}
rule DeficiencyAssessableNotwithstandingRule(building: Asset, y: TaxableYear, until: Date) strict {
    when building_disposed_of_with_qualified_basis_reduction_in_year_42(building, y);
    when assessment_period_end_for_42j_deficiency_42(building, until);
    then deficiency_assessable_notwithstanding_other_law_42(building, y);
}

// --- (k): qualified commercial financing and nonprofit lenders -------------------------------------------------------------------------------

pub relation financing_borrowed_from_qualified_nonprofit_42(financing: Asset, org: Person) kind empirical {
    label en official "the financing is borrowed from a qualified nonprofit organization (section 42(h)(5)) (section 42(k)(2)(A)) — case-asserted";
}
pub relation financing_secured_by_building_42(financing: Asset) kind empirical {
    label en official "the financing is secured by the qualified low-income building (section 42(k)(2)(B)) — case-asserted";
}
pub relation federally_assisted_building_no_security_interest_permitted_42(financing: Asset) kind empirical {
    label en official "the building is a federally assisted building described in section 42(d)(6)(C), a security interest is not permitted by the Federal agency holding or insuring the mortgage, and the proceeds are applied to acquire or improve the building (section 42(k)(2)(B)(i)-(ii)) — case-asserted";
}
pub relation financing_share_of_eligible_basis_42(financing: Asset, share: Decimal) kind empirical {
    label en official "the portion of the eligible basis of the qualified low-income building attributable to the financing as of the close of the taxable year, reduced by the principal and interest of any governmental financing that is part of a wrap-around mortgage (section 42(k)(2)(C)), as a fraction — case-asserted";
}
pub relation financing_repayment_date_42(financing: Asset, on: Date) kind empirical {
    label en official "the date the financing is fully repaid — case-asserted";
}
pub relation financing_maturity_date_42(financing: Asset, on: Date) kind empirical {
    label en official "the date the financing matures (section 42(k)(2)(D)(i)) — case-asserted";
}
pub relation financing_refinancing_or_sale_date_42(financing: Asset, on: Date) kind empirical {
    label en official "the date of the refinancing of the financing or the sale of the building (section 42(k)(2)(D)(iii)) — case-asserted";
}
pub relation compliance_period_close_date_42(financing: Asset, on: Date) kind empirical {
    label en official "the close of the compliance period with respect to the qualified low-income building (section 42(k)(2)(D)(ii)) — case-asserted";
}
pub relation financing_repaid_by_earliest_required_date_42(financing: Asset) kind institutional {
    label en official "section 42(k)(2)(D): the financing is fully repaid on or before the earliest of its maturity, the 90th day after the close of the compliance period, and the date of its refinancing or of the sale of the building";
}
@source(IRC_S42_K, relation = formalizes, coverage = partial, quote = "The requirements of this subparagraph are met with respect to any financing if such financing is fully repaid on or before the earliest of—")
rule FinancingRepaidByEarliestRequiredDateRule(financing: Asset, repaid: Date, maturity: Date, close: Date, other: Date) strict {
    when financing_repayment_date_42(financing, repaid);
    when financing_maturity_date_42(financing, maturity);
    when compliance_period_close_date_42(financing, close);
    when financing_refinancing_or_sale_date_42(financing, other);
    when repaid <= maturity;
    when repaid <= add_calendar_period(close, 90 calendar_day);
    when repaid <= other;
    when not_known(nonprofit_lender_special_repayment_date_applies_42k2d(financing));
    then financing_repaid_by_earliest_required_date_42(financing);
}
pub relation nonprofit_lender_financing_treated_as_qualified_commercial_42(financing: Asset) kind institutional {
    label en official "section 42(k)(2)(A)-(D): financing borrowed from a qualified nonprofit organization is qualified commercial financing without regard to whether it is engaged in lending or is a related person, if it is secured, within the 60-percent basis limit and repaid on time";
}
@source(IRC_S42_K, relation = formalizes, coverage = partial, quote = "If the requirements of subparagraphs (B), (C), and (D) are met with respect to any financing borrowed from a qualified nonprofit organization (as defined in subsection (h)(5)), the determination of whether such financing is qualified commercial financing with respect to any qualified low-income building shall be made without regard to whether such organization—")
rule NonprofitLenderFinancingSecuredRule(financing: Asset, org: Person, share: Decimal) strict {
    when financing_borrowed_from_qualified_nonprofit_42(financing, org);
    when qualified_nonprofit_organization_42(org);
    when financing_secured_by_building_42(financing);
    when financing_share_of_eligible_basis_42(financing, share);
    when share <= 0.60;
    when financing_repaid_by_earliest_required_date_42(financing);
    then nonprofit_lender_financing_treated_as_qualified_commercial_42(financing);
}
rule NonprofitLenderFinancingFederallyAssistedRule(financing: Asset, org: Person, share: Decimal) strict {
    when financing_borrowed_from_qualified_nonprofit_42(financing, org);
    when qualified_nonprofit_organization_42(org);
    when federally_assisted_building_no_security_interest_permitted_42(financing);
    when financing_share_of_eligible_basis_42(financing, share);
    when share <= 0.60;
    when financing_repaid_by_earliest_required_date_42(financing);
    then nonprofit_lender_financing_treated_as_qualified_commercial_42(financing);
}
pub relation applicable_portion_of_credit_k4_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate decrease in the credits allowed under section 38 for all prior taxable years which would have resulted if the eligible basis were reduced by the financing not meeting paragraph (2)(D) (section 42(k)(4)(B)) — case-asserted";
}
pub relation k4_interest_at_underpayment_rate_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest for the period from the due date of the return for the 1st taxable year for which the credit was allowable to the due date for the year of failure, at the section 6621 underpayment rate and method (section 42(k)(4)(A)(i)-(ii)) — case-asserted amount";
}
pub relation financing_fails_k2d_in_year_42(taxpayer: Person, building: Asset, y: TaxableYear) kind empirical {
    label en official "the requirements of section 42(k)(2)(D) are not met with respect to the financing, the failure occurring in the taxable year (section 42(k)(4)(A)) — case-asserted";
}
pub relation increase_in_tax_for_k2d_failure_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(k)(4)(A): the tax is increased by the applicable portion of the credit plus interest";
}
@source(IRC_S42_K, relation = formalizes, coverage = partial, quote = "To the extent that the requirements of paragraph (2)(D) are not met, then the taxpayer's tax under this chapter for the taxable year in which such failure occurs shall be increased by an amount equal to the applicable portion of the credit under this section with respect to such building, increased by an amount of interest for the period—")
rule IncreaseInTaxForK2dFailureRule(taxpayer: Person, building: Asset, y: TaxableYear, portion: Money, interest: Money) strict {
    when financing_fails_k2d_in_year_42(taxpayer, building, y);
    when applicable_portion_of_credit_k4_42(taxpayer, building, y, portion);
    when k4_interest_at_underpayment_rate_42(taxpayer, building, y, interest);
    then increase_in_tax_for_k2d_failure_42(taxpayer, building, y, portion + interest);
}
pub relation k4_increase_limited_to_credits_used_42(taxpayer: Person, building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 42(k)(4)(C): rules similar to section 42(j)(4)(A): the tax is increased only with respect to credits used to reduce tax liability";
}
@source(IRC_S42_K, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of subparagraphs (A) and (D) of subsection (j)(4) shall apply for purposes of this subsection.")
rule K4IncreaseLimitedToCreditsUsedRule(taxpayer: Person, building: Asset, y: TaxableYear, increase: Money, used: Money) strict {
    when increase_in_tax_for_k2d_failure_42(taxpayer, building, y, increase);
    when credit_used_to_reduce_tax_42(taxpayer, building, y, used);
    then k4_increase_limited_to_credits_used_42(taxpayer, building, y, min(increase, used));
}

// --- (l): certification, information return, agency report ---------------------------------------------------------------------------------------

pub relation taxpayer_certification_due_on_42(taxpayer: Person, building: Asset, due: Date) kind empirical {
    label en official "the date prescribed for the certification of section 42(l)(1) — set by the Secretary, case-asserted";
}
pub relation taxpayer_certification_made_on_42(taxpayer: Person, building: Asset, made: Date) kind empirical {
    label en official "the date the taxpayer makes the certification of section 42(l)(1) — case-asserted";
}
external judgment relation certification_failure_due_to_reasonable_cause_42(building: Asset) {
    authority Secretary;
    label en official "the failure to make the certification on the prescribed date is shown to be due to reasonable cause and not to willful neglect (section 42(l)(1), last sentence)";
}
pub relation certification_contents_stated_42(taxpayer: Person, building: Asset) kind empirical {
    label en official "the certification states the placed-in-service taxable and calendar year, the adjusted and eligible basis at the close of the 1st year, the maximum applicable percentage and qualified basis the agency permits, and the section 42(g) election (section 42(l)(1)(A)-(D)) — case-asserted";
}
pub relation taxpayer_certification_complete_42(taxpayer: Person, building: Asset) kind institutional {
    label en official "section 42(l)(1): the certification was submitted and states the placed-in-service year, the bases, the maximum applicable percentage and qualified basis and the section 42(g) election";
}
rule TaxpayerCertificationCompleteRule(taxpayer: Person, building: Asset) strict {
    when taxpayer_certification_submitted_42(taxpayer, building);
    when certification_contents_stated_42(taxpayer, building);
    then taxpayer_certification_complete_42(taxpayer, building);
}
pub relation credit_disallowed_for_uncertified_year_42(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 42(l)(1), last sentence: no credit is allowable for any taxable year ending before the certification is made if it was not made on the prescribed date, unless reasonable cause is shown";
}
@source(IRC_S42_L, relation = formalizes, coverage = exact, quote = "In the case of a failure to make the certification required by the preceding sentence on the date prescribed therefor, unless it is shown that such failure is due to reasonable cause and not to willful neglect, no credit shall be allowable by reason of subsection (a) with respect to such building for any taxable year ending before such certification is made.")
rule CreditDisallowedForUncertifiedYearRule(building: Asset, taxpayer: Person, y: TaxableYear, due: Date, made: Date, finish: Date) defeasible {
    when taxpayer_certification_due_on_42(taxpayer, building, due);
    when taxpayer_certification_made_on_42(taxpayer, building, made);
    when made > due;
    when credit_period_year_42(building, y);
    when us.irc.core::ends(y, finish);
    when finish < made;
    then credit_disallowed_for_uncertified_year_42(building, y);
    unless certification_failure_due_to_reasonable_cause_42(building)
        and credit_period_year_42(building, y);
}
pub relation agency_report_states_allocation_amounts_42(agency: Person, year: Decimal) kind empirical {
    label en official "the agency's annual report states the housing credit amount allocated to each building for the year (section 42(l)(3)(A)) — case-asserted";
}
pub relation agency_report_identifies_buildings_and_taxpayers_42(agency: Person, year: Decimal) kind empirical {
    label en official "the agency's annual report contains sufficient information to identify each building and the taxpayer with respect thereto (section 42(l)(3)(B)) — case-asserted";
}
pub relation agency_report_complete_42(agency: Person, year: Decimal) kind institutional {
    label en official "section 42(l)(3): the agency report states the allocation amounts and identifies each building and taxpayer (other Secretary-required information is not tested)";
}
rule AgencyReportCompleteRule(agency: Person, year: Decimal) strict {
    when agency_annual_report_submitted_42(agency, year);
    when agency_report_states_allocation_amounts_42(agency, year);
    when agency_report_identifies_buildings_and_taxpayers_42(agency, year);
    then agency_report_complete_42(agency, year);
}
pub relation secretary_requires_information_return_42(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary requires the taxpayer to submit the information return of section 42(l)(2) for the taxable year — case-asserted";
}
pub relation information_return_submitted_42(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer submitted the information return of section 42(l)(2) on the prescribed date — case-asserted";
}
@source(IRC_S42_L, relation = formalizes, coverage = partial, quote = "The Secretary may require taxpayers to submit an information return (at such time and in such form and manner as the Secretary prescribes) for each taxable year setting forth—")
rule Section42L2InformationReturnDutyRule(taxpayer: Person, y: TaxableYear, due: Date) strict {
    when secretary_requires_information_return_42(taxpayer, y);
    when taxpayer_certification_due_on_42(taxpayer, _, due);
    then duty Section42L2InformationReturnDuty {
        bearer taxpayer;
        goal achievement {
            condition information_return_submitted_42(taxpayer, y);
            window [-infinity, due];
        }
    };
}

// --- (m)(1)(D), (m)(2)(C)-(D): determinations ---------------------------------------------------------------------------------------------------------

pub relation h4_conditions_of_m_met_42(building: Asset) kind institutional {
    label en official "section 42(m)(1)(D), (m)(2)(D): subsection (h)(4) applies only if the project satisfies the allocation requirements of the qualified allocation plan and the bond issuer makes the determination";
}
@source(IRC_S42_M, relation = formalizes, coverage = exact, quote = "Subsection (h)(4) shall not apply to any project unless the project satisfies the requirements for allocation of a housing credit dollar amount under the qualified allocation plan applicable to the area in which the project is located.")
rule H4ConditionsOfMMetRule(building: Asset) strict {
    when project_satisfies_allocation_plan_requirements_42(building);
    when issuer_determination_similar_to_m2_ab_made_42(building);
    then h4_conditions_of_m_met_42(building);
}
pub relation determination_stage_42(building: Asset, stage: Decimal, on: Date) kind empirical {
    label en official "the housing credit agency's section 42(m)(2)(A) determination is made at this time: stage 1 the application, stage 2 the allocation, stage 3 the date the building is placed in service (section 42(m)(2)(C)(i)) — case-asserted";
}
pub relation subsidy_certification_submitted_42(taxpayer: Person, building: Asset, stage: Decimal) kind empirical {
    label en official "the taxpayer certified to the agency the full extent of all Federal, State and local subsidies which apply or are expected to apply before the determination of the stage (section 42(m)(2)(C)(ii)) — case-asserted";
}
@source(IRC_S42_M, relation = formalizes, coverage = exact, quote = "Prior to each determination under clause (i), the taxpayer shall certify to the housing credit agency the full extent of all Federal, State, and local subsidies which apply (or which the taxpayer expects to apply) with respect to the building.")
rule Section42M2CSubsidyCertificationDutyRule(taxpayer: Person, building: Asset, stage: Decimal, on: Date) strict {
    when low_income_housing_building_owned_by(building, taxpayer);
    when determination_stage_42(building, stage, on);
    then duty Section42M2CSubsidyCertificationDuty {
        bearer taxpayer;
        goal achievement {
            condition subsidy_certification_submitted_42(taxpayer, building, stage);
            window [-infinity, on];
        }
    };
}
