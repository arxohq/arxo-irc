{
  "schemaVersion": "law.decision/0.1",
  "kind": "decision-table",
  "id": "urn:us:irc:credits:clir:table:45e-applicable-percentage",
  "mode": "rules",
  "hitPolicy": "first",
  "total": true,
  "inputs": [
    { "id": "plan_year_number", "name": "the taxable year number since the eligible employer plan was established (1st = the year of establishment)", "type": { "name": "urn:law:std#Decimal" } }
  ],
  "outputs": [
    { "id": "pct", "name": "applicable percentage under section 45E(f)(3)", "type": { "name": "urn:law:std#Decimal" } }
  ],
  "emit": {
    "predicate": "urn:us:irc:credits:clir#applicable_percentage_45e_f3",
    "polarity": "positive",
    "args": [
      { "kind": "input", "id": "plan_year_number" },
      { "kind": "output", "id": "pct" }
    ]
  },
  "labels": [
    { "language": "en", "status": "official", "text": "Section 45E(f)(3) applicable-percentage table (IRC_S45E_TABLE_1): 100 percent for the year the plan is established, then 75/50/25/0 percent for the 2nd/3rd/4th/later taxable years" }
  ],
  "rows": [
    {
      "id": "year-established",
      "when": [
        { "input": "plan_year_number", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "2" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "1.00" } } ],
      "anchors": ["IRC_S45E_F"]
    },
    {
      "id": "second-year",
      "when": [
        { "input": "plan_year_number", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "3" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.75" } } ],
      "anchors": ["IRC_S45E_TABLE_1"]
    },
    {
      "id": "third-year",
      "when": [
        { "input": "plan_year_number", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "4" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.50" } } ],
      "anchors": ["IRC_S45E_TABLE_1"]
    },
    {
      "id": "fourth-year",
      "when": [
        { "input": "plan_year_number", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "5" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.25" } } ],
      "anchors": ["IRC_S45E_TABLE_1"]
    },
    {
      "id": "fifth-year-and-thereafter",
      "when": [
        { "input": "plan_year_number", "condition": { "kind": "comparison", "op": "gte", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "5" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.00" } } ],
      "anchors": ["IRC_S45E_TABLE_1"]
    }
  ]
}
