// Stage 4 (DECISION-0379 with deontics), credits, part K: the rules made applicable by "rules similar
// to" section 45(b)(7)(B) (correction and penalty of the prevailing wage requirement) and
// section 45(b)(8) (the apprenticeship requirement and its exception) to sections 45U(d)(2)(B),
// 45Z(f)(6)-(7), 45Q(h)(4), 45V(e)(4), 30C(g)(3) and 48C(e)(6). Closes G6410 except the 45(e)(8)/(10)
// increases (G6411, not in this module).
//
// The cure of module s3-b (`prevailing_wage_cure_satisfied_45b7B`,
// `apprenticeship_requirement_cured_45b8D`, keyed by an asset and a year) is READ; the derivation
// that had to be a case fact in the incorporating sections is now a rule: the relation each credit
// reads (the combined wage-and-apprenticeship fact, the apprenticeship fact) is derived from the cure,
// exactly as module s3-b already derives `prevailing_wage_requirement_met_45q` and its siblings for the
// wage side. A cure made in a year is read as covering the requirement of the year-less consumers
// (the approximation of module s3-b). Where a section keeps one COMBINED fact, the cure derives it only
// when both the wage requirement (its own relation, cured or asserted) and the apprenticeship
// requirement are cured; a case that satisfies the requirements without a cure keeps asserting the
// fact (the earlier channel).

// ---- 45U(d)(2)(B): the wage cure ----

use self::{
    Asset,
    IRC_S30C_G,
    IRC_S45Q_H,
    IRC_S45U_D,
    IRC_S45V_E,
    IRC_S45Z_F,
    IRC_S48C_E,
    TaxableYear,
    apprenticeship_requirement_cured_45b8D,
    apprenticeship_requirements_met_45q,
    apprenticeship_requirements_met_45v,
    prevailing_wage_and_apprenticeship_satisfied_45z,
    prevailing_wage_cure_satisfied_45b7B,
    prevailing_wage_requirement_met_30c,
    prevailing_wage_requirement_met_48c,
    prevailing_wage_requirements_satisfied_45u,
    project_satisfies_wage_and_apprenticeship_30c,
    satisfies_wage_and_apprenticeship_requirements_48c,
};

@source(IRC_S45U_D, quote = "Rules similar to the rules of section 45(b)(7)(B) shall apply.")
rule PrevailingWageRequirementCured45u(facility: Asset, y: TaxableYear) defeasible {
    label en official "a corrected and penalized wage failure does not defeat the requirement (section 45U(d)(2)(B), by section 45(b)(7)(B))";
    when prevailing_wage_cure_satisfied_45b7B(facility, y);
    then prevailing_wage_requirements_satisfied_45u(facility, y);
}

// ---- 45Q(h)(4), 45V(e)(4): the apprenticeship exception ----

@source(IRC_S45Q_H, quote = "Rules similar to the rules of section 45(b)(8) shall apply.")
rule ApprenticeshipRequirementsMetByCure45q(equipment: Asset, y: TaxableYear) strict {
    label en official "a cured apprenticeship failure counts as met for the equipment (section 45Q(h)(4), by section 45(b)(8)(D))";
    when apprenticeship_requirement_cured_45b8D(equipment, y);
    then apprenticeship_requirements_met_45q(equipment);
}
@source(IRC_S45V_E, quote = "Rules similar to the rules of section 45(b)(8) shall apply.")
rule ApprenticeshipRequirementsMetByCure45v(facility: Asset, y: TaxableYear) strict {
    label en official "a cured apprenticeship failure counts as met for the facility (section 45V(e)(4), by section 45(b)(8)(D))";
    when apprenticeship_requirement_cured_45b8D(facility, y);
    then apprenticeship_requirements_met_45v(facility);
}

// ---- 30C(g)(3), 48C(e)(6): the combined fact ----

@source(IRC_S30C_G, quote = "Rules similar to the rules of section 45(b)(8) shall apply.")
rule WageAndApprenticeshipMetByCure30c(project: Asset, y: TaxableYear) strict {
    label en official "wage requirement met (its own relation) and the apprenticeship requirement cured (section 30C(g)(3), by section 45(b)(8)(D))";
    when prevailing_wage_requirement_met_30c(project);
    when apprenticeship_requirement_cured_45b8D(project, y);
    then project_satisfies_wage_and_apprenticeship_30c(project);
}
@source(IRC_S48C_E, quote = "Rules similar to the rules of section 45(b)(8) shall apply.")
rule WageAndApprenticeshipMetByCure48c(project: Asset, y: TaxableYear) strict {
    label en official "wage requirement met (its own relation) and the apprenticeship requirement cured (section 48C(e)(6), by section 45(b)(8)(D))";
    when prevailing_wage_requirement_met_48c(project);
    when apprenticeship_requirement_cured_45b8D(project, y);
    then satisfies_wage_and_apprenticeship_requirements_48c(project);
}

// ---- 45Z(f)(6)-(7) ----

pub relation qualified_facility_placed_in_service_on_45z_f6(facility: Asset, on: Date) kind empirical {
    label en official "the date the qualified facility was placed in service (section 45Z(f)(6)(B)) — case-asserted";
}
pub relation prevailing_wage_construction_satisfied_45z(facility: Asset) kind empirical {
    label en official "the prevailing wage requirement for the construction of the facility (rule similar to section 45(b)(7)(A)(i)) is satisfied — case-asserted";
}
pub relation prevailing_wage_alteration_repair_satisfied_45z(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the prevailing wage requirement for alteration or repair of the facility in the taxable year (rule similar to section 45(b)(7)(A)(ii)) is satisfied — case-asserted";
}
pub relation apprenticeship_satisfied_45z(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the apprenticeship requirements (rules similar to section 45(b)(8)) are satisfied without a cure — case-asserted";
}
pub relation construction_wage_requirement_applies_45z(facility: Asset) kind institutional {
    label en official "clause (i) of section 45(b)(7)(A) applies to the facility: it does not for a facility placed in service before January 1, 2025 (section 45Z(f)(6)(B)(i))";
}
@source(IRC_S45Z_F, quote = "(i) clause (i) of section 45(b)(7)(A) shall not apply, and")
rule ConstructionWageRequirementAppliesFrom2025(facility: Asset, placed: Date) defeasible {
    label en official "a facility placed in service on or after 1 January 2025 keeps the construction wage requirement (section 45Z(f)(6)(B)(i))";
    when qualified_facility_placed_in_service_on_45z_f6(facility, placed);
    when placed >= @2025-01-01;
    then construction_wage_requirement_applies_45z(facility);
}
pub relation alteration_repair_wage_requirement_applies_45z(facility: Asset, y: TaxableYear) kind institutional {
    label en official "clause (ii) of section 45(b)(7)(A) applies to the taxable year: for a facility placed in service before January 1, 2025, only for a taxable year beginning after December 31, 2024 for which the credit is allowed (section 45Z(f)(6)(B)(ii))";
}
@source(IRC_S45Z_F, quote = "(ii) clause (ii) of such section shall be applied by substituting \"with respect to any taxable year beginning after December 31, 2024, for which the credit is allowed under this section\" for \"with respect to any taxable year, for any portion of such taxable year which is within the period described in subsection (a)(2)(A)(ii)\".")
rule AlterationRepairWageRequirementAppliesAfter2024(facility: Asset, y: TaxableYear, placed: Date, begins_on: Date) defeasible {
    label en official "a facility placed in service before 2025: the alteration or repair requirement for a taxable year beginning after 2024 (section 45Z(f)(6)(B)(ii))";
    when qualified_facility_placed_in_service_on_45z_f6(facility, placed);
    when placed < @2025-01-01;
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2024-12-31;
    then alteration_repair_wage_requirement_applies_45z(facility, y);
}
rule AlterationRepairWageRequirementAppliesNewFacility(facility: Asset, y: TaxableYear, placed: Date, begins_on: Date) defeasible {
    label en official "a facility placed in service on or after 2025: the requirement of (b)(7)(A)(ii) as written";
    when qualified_facility_placed_in_service_on_45z_f6(facility, placed);
    when placed >= @2025-01-01;
    when us.irc.core::begins(y, begins_on);
    then alteration_repair_wage_requirement_applies_45z(facility, y);
}
pub relation construction_wage_ok_45z(facility: Asset) kind institutional {
    label en official "the construction wage requirement is met or does not apply (section 45Z(f)(6)(A), (B)(i))";
}
@source(IRC_S45Z_F, quote = "Subject to subparagraph (B), rules similar to the rules of section 45(b)(7) shall apply.")
rule ConstructionWageOkWhenItApplies45z(facility: Asset) defeasible {
    label en official "the requirement applies and is satisfied";
    when construction_wage_requirement_applies_45z(facility);
    when prevailing_wage_construction_satisfied_45z(facility);
    then construction_wage_ok_45z(facility);
}
rule ConstructionWageOkWhenItDoesNotApply45z(facility: Asset, placed: Date) defeasible {
    label en official "a facility placed in service before 2025: clause (i) does not apply (section 45Z(f)(6)(B)(i))";
    when qualified_facility_placed_in_service_on_45z_f6(facility, placed);
    when not_known(construction_wage_requirement_applies_45z(facility));
    then construction_wage_ok_45z(facility);
}
pub relation alteration_repair_wage_ok_45z(facility: Asset, y: TaxableYear) kind institutional {
    label en official "the alteration or repair wage requirement is met, cured by the correction and penalty, or does not apply for the year (section 45Z(f)(6)(A), (B)(ii))";
}
rule AlterationRepairWageOkWhenSatisfied45z(facility: Asset, y: TaxableYear) defeasible {
    label en official "the requirement applies and is satisfied";
    when alteration_repair_wage_requirement_applies_45z(facility, y);
    when prevailing_wage_alteration_repair_satisfied_45z(facility, y);
    then alteration_repair_wage_ok_45z(facility, y);
}
@source(IRC_S45Z_F, quote = "Subject to subparagraph (B), rules similar to the rules of section 45(b)(7) shall apply.")
rule AlterationRepairWageOkWhenCured45z(facility: Asset, y: TaxableYear) defeasible {
    label en official "the failure is corrected and penalized (rule similar to section 45(b)(7)(B))";
    when alteration_repair_wage_requirement_applies_45z(facility, y);
    when prevailing_wage_cure_satisfied_45b7B(facility, y);
    then alteration_repair_wage_ok_45z(facility, y);
}
rule AlterationRepairWageOkWhenItDoesNotApply45z(facility: Asset, y: TaxableYear, placed: Date, begins_on: Date) defeasible {
    label en official "the requirement does not apply to the year";
    when qualified_facility_placed_in_service_on_45z_f6(facility, placed);
    when us.irc.core::begins(y, begins_on);
    when not_known(alteration_repair_wage_requirement_applies_45z(facility, y));
    then alteration_repair_wage_ok_45z(facility, y);
}
pub relation apprenticeship_ok_45z(facility: Asset, y: TaxableYear) kind institutional {
    label en official "the apprenticeship requirements are satisfied or the failure is cured (rules similar to section 45(b)(8))";
}
@source(IRC_S45Z_F, quote = "Rules similar to the rules of section 45(b)(8) shall apply.")
rule ApprenticeshipOkWhenSatisfied45z(facility: Asset, y: TaxableYear) defeasible {
    label en official "satisfied without a cure (section 45Z(f)(7))";
    when apprenticeship_satisfied_45z(facility, y);
    then apprenticeship_ok_45z(facility, y);
}
rule ApprenticeshipOkWhenCured45z(facility: Asset, y: TaxableYear) defeasible {
    label en official "cured by the good-faith effort or the penalty (section 45Z(f)(7), by section 45(b)(8)(D))";
    when apprenticeship_requirement_cured_45b8D(facility, y);
    then apprenticeship_ok_45z(facility, y);
}
@source(IRC_S45Z_F, quote = "Subject to subparagraph (B), rules similar to the rules of section 45(b)(7) shall apply.")
rule WageAndApprenticeshipSatisfiedFromRules45z(facility: Asset, y: TaxableYear) defeasible {
    label en official "the wage requirements (construction where it applies, alteration or repair) and the apprenticeship requirements are met: the combined fact the credit reads (section 45Z(f)(6), (7)); alternative channel to the asserted fact";
    when construction_wage_ok_45z(facility);
    when alteration_repair_wage_ok_45z(facility, y);
    when apprenticeship_ok_45z(facility, y);
    then prevailing_wage_and_apprenticeship_satisfied_45z(facility, y);
}
