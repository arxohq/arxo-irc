// Section 45K — the year-end measurement of (b)(3)(B), the recapture reduction of (b)(4), the tight formation and biomass definitions of (c),
// the ownership and related person rules of (d)(3), (d)(7), the coke facility rule of (f)(2), and the (g) rules for coke and coke gas
// facilities (period, 4,000 barrel limit, inflation base year, exclusions). Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage
// 2c rows of TECH-GAPS G391). Companion of `45k-nonconventional-source-production-credit.law`; its credit rules read the fuel kind and
// the sale facts as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the classification of gas under section 503 of the Natural Gas Policy Act is a case fact of the fuel; the enactment date of
// clause (c)(2)(B)(ii) is a case fact (never a literal); the barrel-of-oil equivalent average is the sum over the days after placement in
// service; the $3 amount of (g)(2)(B) is read as 3 times the asserted inflation adjustment factor computed with base year 2004.

// --- (b)(3)(B), (b)(4): year-end measurement and recapture reduction ------------------------------------------------------------------------------

use self::{
    Asset,
    ControlledGroup,
    FuelKind45K,
    IRC_S45K_B,
    IRC_S45K_C,
    IRC_S45K_D,
    IRC_S45K_F,
    IRC_S45K_G,
    Person,
    TaxableYear,
    facility_placed_in_service_on_45k,
    fuel_kind_45k,
    well_drilled_on_45k,
};

pub relation subsidy_amount_at_date_45k(project: Asset, on: Date, amount: Money) kind empirical {
    label en official "the amount of the subsidies and other amounts under section 45K(b)(3)(A) as of this date — case-asserted";
}
pub relation taxable_year_close_date_45k(y: TaxableYear, on: Date) kind empirical {
    label en official "the close of the taxable year — case-asserted";
}
pub relation subsidy_amount_as_of_year_end_45k(project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45K(b)(3)(B): the amounts under subparagraph (A) for a taxable year are determined as of the close of the taxable year";
}
@source(IRC_S45K_B, relation = formalizes, coverage = exact, quote = "The amounts under subparagraph (A) for any taxable year shall be determined as of the close of the taxable year.")
rule SubsidyAmountAsOfYearEndRule(project: Asset, y: TaxableYear, on: Date, amount: Money) strict {
    when taxable_year_close_date_45k(y, on);
    when subsidy_amount_at_date_45k(project, on, amount);
    then subsidy_amount_as_of_year_end_45k(project, y, amount);
}
pub relation recapture_amount_under_49b_or_50a_45k(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount recaptured under section 49(b) or 50(a) with respect to the property — case-asserted";
}
pub relation credit_reduction_by_reason_of_b4_45k(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the reduction in the credit allowed under section 45K by reason of the preceding sentence of subsection (b)(4) — case-asserted";
}
pub relation recapture_amount_after_reduction_45k(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45K(b)(4): the amount recaptured under section 49(b) or 50(a) is appropriately reduced by the reduction in the credit (not below zero)";
}
@source(IRC_S45K_B, relation = formalizes, coverage = exact, quote = "The amount recaptured under section 49(b) or 50(a) with respect to any property shall be appropriately reduced to take into account any reduction in the credit allowed by this section")
rule RecaptureAmountAfterReductionRule(taxpayer: Person, prop: Asset, y: TaxableYear, recapture: Money, reduction: Money) strict {
    when recapture_amount_under_49b_or_50a_45k(taxpayer, prop, y, recapture);
    when credit_reduction_by_reason_of_b4_45k(taxpayer, prop, y, reduction);
    then recapture_amount_after_reduction_45k(taxpayer, prop, y, max(recapture - reduction, 0 USD));
}

// --- (c)(2)(B), (c)(3): tight formation gas and biomass ----------------------------------------------------------------------------------------------

pub relation formation_committed_to_interstate_commerce_on_1977_04_20_45k(project: Asset) kind empirical {
    label en official "the tight formation was, as of April 20, 1977, committed or dedicated to interstate commerce (as defined in section 2(18) of the Natural Gas Policy Act of 1978, as in effect on the date of enactment of the clause) (section 45K(c)(2)(B)(i)) — case-asserted";
}
pub relation clause_enactment_date_45k(on: Date) kind empirical {
    label en official "the date of enactment of section 45K(c)(2)(B)(ii) — case-asserted from the pinned Public Law note";
}
pub relation tight_formation_gas_included_45k(project: Asset) kind institutional {
    label en official "section 45K(c)(2)(B): gas produced from a tight formation includes only gas from a formation committed or dedicated to interstate commerce as of April 20, 1977, or produced from a well drilled after the enactment of the clause";
}
@source(IRC_S45K_C, relation = formalizes, coverage = exact, quote = "which, as of April 20, 1977, was committed or dedicated to interstate commerce")
rule TightFormationGasCommittedRule(project: Asset) strict {
    when fuel_kind_45k(project, GasFromTightFormation);
    when formation_committed_to_interstate_commerce_on_1977_04_20_45k(project);
    then tight_formation_gas_included_45k(project);
}
@source(IRC_S45K_C, relation = formalizes, coverage = exact, quote = "which is produced from a well drilled after such date of enactment")
rule TightFormationGasNewWellRule(project: Asset, drilled: Date, enacted: Date) strict {
    when fuel_kind_45k(project, GasFromTightFormation);
    when well_drilled_on_45k(project, drilled);
    when clause_enactment_date_45k(enacted);
    when drilled > enacted;
    then tight_formation_gas_included_45k(project);
}
pub relation material_is_oil_natural_gas_or_product_45k(material: Asset) kind empirical {
    label en official "the material is oil or natural gas, or a product thereof (section 45K(c)(3)(A)) — case-asserted";
}
pub relation material_is_coal_lignite_or_product_45k(material: Asset) kind empirical {
    label en official "the material is coal (including lignite) or any product thereof (section 45K(c)(3)(B)) — case-asserted";
}
pub relation organic_material_45k(material: Asset) kind empirical {
    label en official "the material is organic material — case-asserted";
}
pub relation biomass_45k(material: Asset) kind institutional {
    label en official "section 45K(c)(3): organic material other than oil and natural gas (or any product thereof) and coal (including lignite) or any product thereof";
}
@source(IRC_S45K_C, relation = formalizes, coverage = exact, quote = "The term \"biomass\" means any organic material other than")
rule Biomass45kRule(material: Asset) strict {
    when organic_material_45k(material);
    when not_known(material_is_oil_natural_gas_or_product_45k(material));
    when not_known(material_is_coal_lignite_or_product_45k(material));
    then biomass_45k(material);
}

// --- (d)(3), (d)(7): ownership and related persons ----------------------------------------------------------------------------------------------------

pub relation production_boe_of_property_45k(project: Asset, y: TaxableYear, boe: Decimal) kind empirical {
    label en official "the barrel-of-oil equivalent produced from the property or facility during the taxable year — case-asserted";
}
pub relation interest_share_of_gross_sales_45k(project: Asset, holder: Person, share: Decimal) kind empirical {
    label en official "the person's interest in the gross sales from the property or facility, as a fraction (section 45K(d)(3)) — case-asserted";
}
pub relation production_allocated_to_holder_45k(project: Asset, holder: Person, y: TaxableYear, boe: Decimal) kind institutional {
    label en official "section 45K(d)(3): production from a property or facility with more than one interest holder is allocated in proportion to their interests in gross sales (except as regulations provide)";
}
@source(IRC_S45K_D, relation = formalizes, coverage = partial, quote = "production from the property or facility (as the case may be) shall be allocated among such persons in proportion to their respective interests in the gross sales from such property or facility")
rule ProductionAllocatedToHolder45kRule(project: Asset, holder: Person, y: TaxableYear, total: Decimal, share: Decimal) strict {
    when production_boe_of_property_45k(project, y, total);
    when interest_share_of_gross_sales_45k(project, holder, share);
    then production_allocated_to_holder_45k(project, holder, y, total * share);
}
pub relation single_employer_under_52b_45k(group: ControlledGroup, member: Person, y: TaxableYear) kind empirical {
    label en official "the person would be treated as a single employer with the group under the regulations prescribed under section 52(b) (section 45K(d)(7)) — case-asserted";
}
pub relation persons_related_45k(a: Person, b: Person, y: TaxableYear) kind institutional {
    label en official "section 45K(d)(7): persons are related if they would be treated as a single employer under the section 52(b) regulations";
}
@source(IRC_S45K_D, relation = formalizes, coverage = partial, quote = "Persons shall be treated as related to each other if such persons would be treated as a single employer under the regulations prescribed under section 52(b).")
rule PersonsRelated45kRule(a: Person, b: Person, y: TaxableYear, group: ControlledGroup) strict {
    when single_employer_under_52b_45k(group, a, y);
    when single_employer_under_52b_45k(group, b, y);
    then persons_related_45k(a, b, y);
}
pub relation consolidated_member_45k(corp: Person, group: Person) kind empirical {
    label en official "the corporation is a member of an affiliated group of corporations filing a consolidated return — case-asserted";
}
pub relation fuels_sold_by_member_to_unrelated_person_45k(seller: Person, buyer: Person) kind empirical {
    label en official "another member of the consolidated group sells the qualified fuels to the unrelated person — case-asserted";
}
pub relation treated_as_selling_fuels_to_unrelated_person_45k(corp: Person, buyer: Person) kind institutional {
    label en official "section 45K(d)(7), last sentence: a member of a consolidated group is treated as selling qualified fuels to an unrelated person if another member sells them to that person";
}
rule TreatedAsSellingFuels45kRule(corp: Person, group: Person, seller: Person, buyer: Person) strict {
    when consolidated_member_45k(corp, group);
    when consolidated_member_45k(seller, group);
    when fuels_sold_by_member_to_unrelated_person_45k(seller, buyer);
    then treated_as_selling_fuels_to_unrelated_person_45k(corp, buyer);
}

// --- (f)(2): coke facilities -----------------------------------------------------------------------------------------------------------------------------------

pub relation facility_produces_coke_or_coke_gas_45k(facility: Asset) kind empirical {
    label en official "the facility produces coke or coke gas (section 45K(f)(2)) — case-asserted";
}
pub relation original_use_of_facility_commences_with_taxpayer_45k(facility: Asset) kind empirical {
    label en official "the original use of the facility commences with the taxpayer (section 45K(f)(2)) — case-asserted";
}
pub relation paragraph_f1_applies_to_facility_45k(facility: Asset) kind institutional {
    label en official "section 45K(f)(2): paragraph (1) does not apply to a facility which produces coke or coke gas unless the original use of the facility commences with the taxpayer";
}
@source(IRC_S45K_F, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any facility which produces coke or coke gas unless the original use of the facility commences with the taxpayer.")
rule ParagraphF1AppliesCokeRule(facility: Asset) strict {
    when facility_produces_coke_or_coke_gas_45k(facility);
    when original_use_of_facility_commences_with_taxpayer_45k(facility);
    then paragraph_f1_applies_to_facility_45k(facility);
}
rule ParagraphF1AppliesOtherRule(facility: Asset) strict {
    when facility_placed_in_service_on_45k(facility, _);
    when not_known(facility_produces_coke_or_coke_gas_45k(facility));
    then paragraph_f1_applies_to_facility_45k(facility);
}

// --- (g): coke and coke gas facilities -------------------------------------------------------------------------------------------------------------------------

pub relation coke_facility_not_from_petroleum_products_45k(facility: Asset) kind empirical {
    label en official "the facility produces coke or coke gas other than from petroleum based products (section 45K(g)(1)) — case-asserted";
}
pub relation g_facility_placed_in_service_on_45k(facility: Asset, on: Date) kind empirical {
    label en official "the date the facility is placed in service — case-asserted";
}
pub relation g_facility_qualifies_45k(facility: Asset) kind institutional {
    label en official "section 45K(g)(1): a facility producing coke or coke gas (other than from petroleum based products) placed in service before 1993-01-01, or after 1998-06-30 and before 2010-01-01";
}
@source(IRC_S45K_G, relation = formalizes, coverage = exact, quote = "In the case of a facility for producing coke or coke gas (other than from petroleum based products) which was placed in service before January 1, 1993, or after June 30, 1998, and before January 1, 2010")
rule GFacilityQualifiesEarlyRule(facility: Asset, on: Date) strict {
    when coke_facility_not_from_petroleum_products_45k(facility);
    when g_facility_placed_in_service_on_45k(facility, on);
    when on < @1993-01-01;
    then g_facility_qualifies_45k(facility);
}
rule GFacilityQualifiesLateRule(facility: Asset, on: Date) strict {
    when coke_facility_not_from_petroleum_products_45k(facility);
    when g_facility_placed_in_service_on_45k(facility, on);
    when on > @1998-06-30;
    when on < @2010-01-01;
    then g_facility_qualifies_45k(facility);
}
pub relation g_period_start_45k(facility: Asset, on: Date) kind institutional {
    label en official "section 45K(g)(1)(A): the period begins on the later of 2006-01-01 or the date the facility is placed in service";
}
@source(IRC_S45K_G, relation = formalizes, coverage = exact, quote = "beginning on the later of January 1, 2006, or the date that such facility is placed in service")
rule GPeriodStartPlacedLaterRule(facility: Asset, placed: Date) strict {
    when g_facility_qualifies_45k(facility);
    when g_facility_placed_in_service_on_45k(facility, placed);
    when placed >= @2006-01-01;
    then g_period_start_45k(facility, placed);
}
rule GPeriodStart2006Rule(facility: Asset, placed: Date) strict {
    when g_facility_qualifies_45k(facility);
    when g_facility_placed_in_service_on_45k(facility, placed);
    when placed < @2006-01-01;
    then g_period_start_45k(facility, @2006-01-01);
}
pub relation coke_sold_on_45k(facility: Asset, on: Date) kind empirical {
    label en official "the date of a sale of coke or coke gas produced in the facility — case-asserted";
}
pub relation sale_within_g_period_45k(facility: Asset, on: Date) kind institutional {
    label en official "section 45K(g)(1)(B): the period ends on the date 4 years after the date it began";
}
@source(IRC_S45K_G, relation = formalizes, coverage = exact, quote = "ending on the date which is 4 years after the date such period began")
rule SaleWithinGPeriodRule(facility: Asset, on: Date, start: Date) strict {
    when coke_sold_on_45k(facility, on);
    when g_period_start_45k(facility, start);
    when on >= start;
    when on <= add_calendar_period(start, 48 calendar_month);
    then sale_within_g_period_45k(facility, on);
}
pub relation boe_sold_by_facility_in_year_45k(facility: Asset, y: TaxableYear, boe: Decimal) kind empirical {
    label en official "the barrels of oil equivalent of qualified fuels sold by the facility during the taxable year by reason of subsection (g) — case-asserted";
}
pub relation days_in_year_after_placed_in_service_45k(facility: Asset, y: TaxableYear, days: Decimal) kind empirical {
    label en official "the days of the taxable year on or after the date the facility is placed in service (section 45K(g)(2)(A)) — case-asserted";
}
pub relation boe_taken_into_account_g_45k(facility: Asset, y: TaxableYear, boe: Decimal) kind institutional {
    label en official "section 45K(g)(2)(A): the amount taken into account does not exceed an average of 4,000 barrels of oil equivalent per day, days before placement in service not counted";
}
@source(IRC_S45K_G, relation = formalizes, coverage = exact, quote = "shall not exceed an average barrel-of-oil equivalent of 4,000 barrels per day")
rule BoeTakenIntoAccountGRule(facility: Asset, y: TaxableYear, boe: Decimal, days: Decimal) strict {
    when boe_sold_by_facility_in_year_45k(facility, y, boe);
    when days_in_year_after_placed_in_service_45k(facility, y, days);
    then boe_taken_into_account_g_45k(facility, y, min(boe, 4000.0 * days));
}
pub relation inflation_adjustment_factor_base_2004_45k(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor with 2004 substituted for 1979 in section 45K(d)(2)(B) (section 45K(g)(2)(B)) — case-asserted";
}
pub relation g_amount_per_boe_45k(facility: Asset, y: TaxableYear, dollars: Decimal) kind institutional {
    label en official "section 45K(g)(2)(B), (D): for fuels sold after 2005 the $3 amount is adjusted by the inflation factor with base year 2004, and the price reduction of (b)(1) does not apply (cents HALF_UP)";
}
@source(IRC_S45K_G, relation = formalizes, coverage = exact, quote = "in the case of fuels sold after 2005, subsection (d)(2)(B) shall be applied by substituting \"2004\" for \"1979\"")
rule GAmountPerBoeRule(facility: Asset, y: TaxableYear, factor: Decimal) strict {
    when g_facility_qualifies_45k(facility);
    when inflation_adjustment_factor_base_2004_45k(y, factor);
    then g_amount_per_boe_45k(facility, y, round(3.0 * factor, 2, "HALF_UP"));
}
pub relation credit_allowed_by_reason_of_subsection_f_45k(facility: Asset, y: TaxableYear) kind empirical {
    label en official "a credit was allowed under section 45K for the taxable year or any preceding taxable year by reason of subsection (f) for the facility (section 45K(g)(2)(C)) — case-asserted";
}
pub relation subsection_g_applies_to_facility_45k(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45K(g)(2)(C): subsection (g) does not apply to a facility producing qualified fuels for which a credit was allowed by reason of subsection (f) for the year or a preceding year";
}
@source(IRC_S45K_G, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any facility producing qualified fuels for which a credit was allowed under this section for the taxable year or any preceding taxable year by reason of subsection (f).")
rule SubsectionGAppliesToFacilityRule(facility: Asset, y: TaxableYear) strict {
    when g_facility_qualifies_45k(facility);
    when boe_sold_by_facility_in_year_45k(facility, y, _);
    when not_known(credit_allowed_by_reason_of_subsection_f_45k(facility, y));
    then subsection_g_applies_to_facility_45k(facility, y);
}
pub relation feedstock_is_steel_industry_fuel_45k(facility: Asset) kind empirical {
    label en official "the coke or coke gas is produced using steel industry fuel (section 45(c)(7)) as feedstock (section 45K(g)(2)(E)) — case-asserted";
}
pub relation credit_allowed_under_45_for_steel_industry_fuel_45k(facility: Asset) kind empirical {
    label en official "a credit is allowed to any taxpayer under section 45 with respect to the production of the steel industry fuel — case-asserted";
}
pub relation credit_permitted_for_coke_45k(facility: Asset) kind institutional {
    label en official "section 45K(g)(2)(E): no credit for coke or coke gas produced using steel industry fuel as feedstock if a section 45 credit is allowed for the steel industry fuel";
}
@source(IRC_S45K_G, relation = formalizes, coverage = exact, quote = "No credit shall be allowed with respect to any coke or coke gas which is produced using steel industry fuel (as defined in section 45(c)(7)) as feedstock if a credit is allowed to any taxpayer under section 45 with respect to the production of such steel industry fuel.")
rule CreditPermittedForCokeRule(facility: Asset) strict {
    when g_facility_qualifies_45k(facility);
    when not_known(credit_allowed_under_45_for_steel_industry_fuel_45k(facility));
    then credit_permitted_for_coke_45k(facility);
}
rule CreditPermittedForCokeNotSteelFuelRule(facility: Asset) strict {
    when g_facility_qualifies_45k(facility);
    when not_known(feedstock_is_steel_industry_fuel_45k(facility));
    then credit_permitted_for_coke_45k(facility);
}
