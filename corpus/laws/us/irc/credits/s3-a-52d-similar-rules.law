// Stage 3 (TECH_GAP reduction): "under regulations prescribed by the Secretary, rules similar to
// the rules of subsection (d) of section 52 shall apply" in sections 40(d)(5), 40A(d)(4),
// 45F(e)(2), 45K(d)(8), 45Y(g)(5) and 45Z(f)(4): the credit of an estate or trust is
// apportioned between the estate or trust and its beneficiaries on the basis of the income of
// the estate or trust allocable to each.
// STATUS: implemented_unverified (static check only; scenarios in
// tests/s3-a-52d-similar-rules.lawtest are NOT executed).
//
// SHAPE. Each rule reads the credit of the section in question (its own institutional
// relation), the allocable share of section 52(d) (`section_52d_income_allocable_share`, the
// same case fact that section 52(d)(1) reads) and applies the same rounding as
// `Section52dApportionmentRule`. The regulations the text refers to are not pinned; the rule
// is the statutory apportionment on the basis of allocable income and is the same one the
// section 52(d) rule states. The apportioned amount is a new relation per section (a credit of
// the beneficiary under the section); the section 38(c) limitation is the module 38 concern.

use self::{
    Asset,
    IRC_S40A_D,
    IRC_S40_D,
    IRC_S45F_E,
    IRC_S45K_D,
    IRC_S45Y_G,
    IRC_S45Z_F,
    Person,
    TaxableYear,
    alcohol_fuels_credit,
    biodiesel_fuels_credit,
    clean_electricity_production_credit,
    clean_fuel_production_credit,
    employer_provided_child_care_credit,
    nonconventional_source_production_credit,
    qualified_facility_45y,
    section_52d_income_allocable_share,
};

pub relation alcohol_fuels_credit_apportioned_40d5(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the beneficiary's apportioned share of the alcohol fuels credit of the estate or trust, under rules similar to section 52(d) (section 40(d)(5))";
}
@source(IRC_S40_D, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, rules similar to the rules of subsection (d) of section 52 shall apply.")
rule AlcoholFuelsCreditApportioned40d5(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 40(d)(5) with section 52(d)(1): on the basis of the allocable income; one rounding to cents HALF_UP";
    when alcohol_fuels_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then alcohol_fuels_credit_apportioned_40d5(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}
pub relation biodiesel_fuels_credit_apportioned_40Ad4(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the beneficiary's apportioned share of the biodiesel fuels credit of the estate or trust, under rules similar to section 52(d) (section 40A(d)(4))";
}
@source(IRC_S40A_D, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, rules similar to the rules of subsection (d) of section 52 shall apply.")
rule BiodieselFuelsCreditApportioned40Ad4(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 40A(d)(4) with section 52(d)(1): on the basis of the allocable income; one rounding to cents HALF_UP";
    when biodiesel_fuels_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then biodiesel_fuels_credit_apportioned_40Ad4(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}
