@source(IRC_S45K_D, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, rules similar to the rules of subsection (d) of section 52 shall apply.")
rule NonconventionalSourceCreditApportioned45Kd8(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 45K(d)(8) with section 52(d)(1): on the basis of the allocable income; one rounding to cents HALF_UP";
    when nonconventional_source_production_credit(estate_or_trust, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then nonconventional_source_credit_apportioned_45Kd8(estate_or_trust, beneficiary, y, round(total * share, 2, "HALF_UP"));
}
pub relation clean_electricity_credit_apportioned_45Yg5(estate_or_trust: Person, beneficiary: Person, facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the beneficiary's apportioned share of the clean electricity production credit for a facility owned by the estate or trust, under rules similar to section 52(d) (section 45Y(g)(5))";
}
@source(IRC_S45Y_G, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, rules similar to the rules of subsection (d) of section 52 shall apply.")
rule CleanElectricityCreditApportioned45Yg5(estate_or_trust: Person, beneficiary: Person, facility: Asset, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 45Y(g)(5) with section 52(d)(1): the credit of a facility owned by the estate or trust, on the basis of the allocable income; one rounding to cents HALF_UP";
    when qualified_facility_45y(facility, estate_or_trust);
    when clean_electricity_production_credit(facility, y, total);
    when section_52d_income_allocable_share(estate_or_trust, beneficiary, y, share);
    then clean_electricity_credit_apportioned_45Yg5(estate_or_trust, beneficiary, facility, y, round(total * share, 2, "HALF_UP"));
}
