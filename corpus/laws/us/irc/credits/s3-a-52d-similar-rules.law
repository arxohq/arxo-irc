@source(IRC_S45Z_F, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, rules similar to the rules of subsection (d) of section 52 shall apply.")
rule CleanFuelCreditApportioned45Zf4(estate_or_trust: Person, beneficiary: Person, y: TaxableYear, total: Money, share: Decimal) defeasible {
    label en official "section 45Z(f)(4) with section 52(d)(1): on the basis of the allocable income; one rounding to cents HALF_UP";
