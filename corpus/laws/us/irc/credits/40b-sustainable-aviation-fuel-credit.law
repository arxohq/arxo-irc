// Section 40B — Sustainable aviation fuel credit. Stage 2d (IRC-06,
// DECISION-0379).
//
// Scope / judgment calls:
// * (a): per gallon of sustainable aviation fuel in a qualified mixture sold or
//   used in the year: $1.25 plus the applicable supplementary amount. (b): the
//   supplementary amount is $0.01 for each whole percentage point by which the
//   lifecycle greenhouse gas emissions reduction percentage exceeds 50, at
//   most $0.50 (whole points: floor, INTERPRETATION of "each percentage
//   point").
// * (c), (d), (e), (f): the qualified mixture, the SAF definition, the
//   lifecycle percentage and the producer registration/certification are case
//   facts (TECH-GAPS G1723). (g): the reduction for benefits under section
//   6426 or 6427(e) is not applied.
// * (h): the section does not apply to any sale or use after 2024-12-31.

use self::{
    Asset,
    IRC_S40B_A,
    IRC_S40B_B,
    IRC_S40B_C,
    IRC_S40B_D,
    IRC_S40B_H,
    Person,
    TaxableYear,
};

pub relation sustainable_aviation_fuel_gallons_in_mixture_40b(taxpayer: Person, mixture: Asset, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of sustainable aviation fuel in the qualified mixture sold or used during the taxable year (section 40B(a)(1)) — case-asserted";
}
pub relation lifecycle_reduction_percent_40b(mixture: Asset, percent: Decimal) kind empirical {
    label en official "the lifecycle greenhouse gas emissions reduction percentage of the fuel compared with petroleum-based jet fuel (section 40B(e)) — case-asserted";
}
pub relation mixture_sold_or_used_on_40b(mixture: Asset, on: Date) kind empirical {
    label en official "the date of the sale or use of the mixture — case-asserted";
}
pub relation mixture_produced_by_taxpayer_in_united_states_40b(taxpayer: Person, mixture: Asset) kind empirical {
    label en official "the mixture of sustainable aviation fuel and kerosene is produced by the taxpayer in the United States (section 40B(c)(1)) — case-asserted";
}
pub relation mixture_used_or_sold_for_aircraft_in_ordinary_course_40b(taxpayer: Person, mixture: Asset) kind empirical {
    label en official "the mixture is used by the taxpayer (or sold for use) in an aircraft, in the ordinary course of a trade or business (section 40B(c)(2)-(3)) — case-asserted";
}
pub relation mixture_transferred_to_aircraft_tank_in_united_states_40b(mixture: Asset) kind empirical {
    label en official "the transfer of the mixture to the fuel tank of the aircraft occurs in the United States (section 40B(c)(4)) — case-asserted";
}
pub relation fuel_meets_astm_and_not_excluded_feedstock_40b(mixture: Asset) kind empirical {
    label en official "the liquid fuel meets ASTM D7566 or the Fischer Tropsch provisions of D1655 Annex A1, is not derived from coprocessing with a non-biomass feedstock, and not from palm fatty acid distillates or petroleum (section 40B(d)(1)(A)-(C)) — case-asserted";
}
pub relation producer_registered_and_certified_40b(taxpayer: Person, mixture: Asset) kind empirical {
    label en official "the producer or importer is registered under section 4101 and provides the unrelated-party certification and information (section 40B(f)) — case-asserted";
}

pub relation qualified_mixture_40b(taxpayer: Person, mixture: Asset) kind institutional {
    label en official "section 40B(c): a mixture of sustainable aviation fuel and kerosene meeting the four conditions";
}
@source(IRC_S40B_C, quote = "such mixture is produced by the taxpayer in the United States")
rule QualifiedMixture40bRule(taxpayer: Person, mixture: Asset) strict {
    when mixture_produced_by_taxpayer_in_united_states_40b(taxpayer, mixture);
    when mixture_used_or_sold_for_aircraft_in_ordinary_course_40b(taxpayer, mixture);
    when mixture_transferred_to_aircraft_tank_in_united_states_40b(mixture);
    then qualified_mixture_40b(taxpayer, mixture);
}
pub relation sustainable_aviation_fuel_40b(mixture: Asset) kind institutional {
    label en official "section 40B(d)(1): sustainable aviation fuel, certified with a lifecycle reduction of at least 50 percent";
}
@source(IRC_S40B_D, quote = "has been certified in accordance with subsection (e) as having a lifecycle greenhouse gas emissions reduction percentage of at least 50 percent")
rule SustainableAviationFuel40bRule(mixture: Asset, percent: Decimal) strict {
    when fuel_meets_astm_and_not_excluded_feedstock_40b(mixture);
    when lifecycle_reduction_percent_40b(mixture, percent);
    when percent >= 50.0;
    then sustainable_aviation_fuel_40b(mixture);
}
pub relation applicable_supplementary_amount_40b(mixture: Asset, amount: Decimal) kind institutional {
    label en official "section 40B(b): $0.01 for each whole percentage point over 50, at most $0.50";
}
@source(IRC_S40B_B, quote = "an amount equal to $0.01 for each percentage point by which the lifecycle greenhouse gas emissions reduction percentage with respect to such fuel exceeds 50 percent")
rule ApplicableSupplementaryAmount40bRule(mixture: Asset, percent: Decimal) strict {
    when lifecycle_reduction_percent_40b(mixture, percent);
    then applicable_supplementary_amount_40b(mixture, min(0.50, 0.01 * round(max(0.0, percent - 50.0), 0, "FLOOR")));
}
pub relation sale_or_use_within_period_40b(mixture: Asset) kind institutional {
    label en official "section 40B(h): sales or uses through 2024-12-31";
}
@source(IRC_S40B_H, quote = "This section shall not apply to any sale or use after December 31, 2024.")
rule SaleOrUseWithinPeriod40bRule(mixture: Asset, on: Date) strict {
    when mixture_sold_or_used_on_40b(mixture, on);
    when on <= @2024-12-31;
    then sale_or_use_within_period_40b(mixture);
}
pub relation sustainable_aviation_fuel_credit_per_mixture_40b(taxpayer: Person, mixture: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40B(a): gallons times $1.25 plus the supplementary amount";
}
@source(IRC_S40B_A, quote = "the number of gallons of sustainable aviation fuel in such mixture, multiplied by")
rule SustainableAviationFuelCreditPerMixture40bRule(taxpayer: Person, mixture: Asset, y: TaxableYear, gallons: Decimal, supplement: Decimal) defeasible {
    when qualified_mixture_40b(taxpayer, mixture);
    when sustainable_aviation_fuel_40b(mixture);
    when producer_registered_and_certified_40b(taxpayer, mixture);
    when sale_or_use_within_period_40b(mixture);
    when sustainable_aviation_fuel_gallons_in_mixture_40b(taxpayer, mixture, y, gallons);
    when applicable_supplementary_amount_40b(mixture, supplement);
    then sustainable_aviation_fuel_credit_per_mixture_40b(taxpayer, mixture, y, round(gallons * (1.25 + supplement), 2, "HALF_UP") * 1 USD);
}
pub relation sustainable_aviation_fuel_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 40B sustainable aviation fuel credit for the taxable year (a section 38(b)(35) component)";
}
rule SustainableAviationFuelCredit40bRule(taxpayer: Person, y: TaxableYear, mixture: Asset, amount: Money) defeasible {
    when sustainable_aviation_fuel_credit_per_mixture_40b(taxpayer, mixture, y, amount);
    then sustainable_aviation_fuel_credit(taxpayer, y,
        sum(collect all a: Money, m: Asset where sustainable_aviation_fuel_credit_per_mixture_40b(taxpayer, m, y, a), empty: 0 USD));
}
