// Section 48A — Qualifying advanced coal project credit. Stage 2d (IRC-06,
// DECISION-0379). A section 46 component (an investment credit).
//
// Scope / judgment calls:
// * (a): the credit is a percentage of the qualified investment by project
//   class: 20 percent (integrated gasification combined cycle projects
//   certified in the first application period), 15 percent (other advanced
//   coal-based technology, first period), 30 percent (second-period projects
//   with 65/70 percent carbon-dioxide separation and sequestration).
// * The qualified investment (b)(1) is a case-asserted amount (the basis of
//   eligible property placed in service, completed by or originally used by
//   the taxpayer, depreciable). The technology tests of (c)/(f) are case
//   facts; the engineering formulas are not computed (TECH-GAPS G1522).
// * (d)/(e): the certification is a POWER of the Secretary. Its validity
//   needs the (e)(1) minimum requirements (75 percent coal fuel input, 400 MW
//   nameplate capacity, located in the United States, the applicant's evidence
//   of output and site, and for second-round projects the sequestration
//   percentage) and the (e)(2) authorizations and turbine contract. The
//   Secretary's remaining directives are duties: the 60-day determination,
//   public disclosure, the 6-year review, the recapture directive of (i).
//   Priority and preference directives are evaluative (TECH-GAPS G1523).
// * (d)(2)(E): a certification lapses if the project is not placed in service
//   within 5 years of issuance.

use self::{
    Asset,
    IRC_S48A_A,
    IRC_S48A_B,
    IRC_S48A_C,
    IRC_S48A_D,
    IRC_S48A_E,
    IRC_S48A_I,
    Person,
    TaxableYear,
    has_reduction_fraction_45b3,
    reduction_fraction_45b3,
};

pub enum AdvancedCoalProjectClass48A {
    IntegratedGasificationFirstRound,
    OtherTechnologyFirstRound,
    CarbonSequestrationSecondRound,
}

pub relation advanced_coal_project_class_48a(project: Asset, class: AdvancedCoalProjectClass48A) kind empirical {
    label en official "the section 48A(d)(3)(B) allocation class of the project: (i) integrated gasification combined cycle, first period; (ii) other advanced coal-based technology, first period; (iii) second period — case-asserted";
}
pub relation qualified_investment_48a(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 48A(b)(1) qualified investment for the taxable year: the basis of eligible property placed in service by the taxpayer as part of a qualifying advanced coal project — case-asserted";
}
pub relation project_fuel_input_coal_percent_48a(project: Asset, percent: Decimal) kind empirical {
    label en official "percentage of the fuel input of the completed project that is coal (section 48A(e)(1)(B)) — case-asserted";
}
pub relation project_nameplate_capacity_mw_48a(project: Asset, megawatts: Decimal) kind empirical {
    label en official "total nameplate generating capacity of the project at one site, in megawatts (section 48A(e)(1)(C)) — case-asserted";
}
pub relation project_located_in_united_states_48a(project: Asset) kind empirical {
    label en official "the project will be located in the United States (section 48A(e)(1)(F)) — case-asserted";
}
pub relation project_uses_advanced_coal_technology_48a(project: Asset) kind empirical {
    label en official "the project uses an advanced coal-based generation technology to power a new unit or to retrofit or repower an existing unit (section 48A(e)(1)(A)) — case-asserted; the technology test of subsection (f) is not computed";
}
pub relation applicant_evidence_of_output_and_site_48a(project: Asset) kind empirical {
    label en official "the applicant provides evidence that a majority of the output is reasonably expected to be acquired or utilized (section 48A(e)(1)(D)) and of ownership or control of a site of sufficient size (E) — case-asserted";
}
pub relation project_sequestration_percent_48a(project: Asset, percent: Decimal) kind empirical {
    label en official "the percentage of the project's total carbon dioxide emissions the project's equipment separates and sequesters (section 48A(e)(1)(G)) — case-asserted";
}
pub relation second_round_reallocation_application_48a(project: Asset) kind empirical {
    label en official "the application is for reallocated credits under section 48A(d)(4) (70 percent sequestration instead of 65) — case-asserted";
}
pub relation environmental_authorizations_received_48a(project: Asset) kind empirical {
    label en official "the applicant has received all Federal and State environmental authorizations or reviews necessary to commence construction (section 48A(e)(2)(A)) — case-asserted";
}
pub relation main_steam_turbine_contract_or_retrofit_48a(project: Asset) kind empirical {
    label en official "the applicant has purchased or entered into a binding contract for the main steam turbine(s), or the project is a retrofit or repower of an existing unit (section 48A(e)(2)(B)) — case-asserted";
}

// --- (e): minimum requirements for certification ---------------------------------

pub relation project_meets_certification_requirements_48a(project: Asset) kind institutional {
    label en official "sections 48A(e)(1)-(2): the project meets the minimum requirements the Secretary may certify";
}
relation project_meets_common_requirements_48a(project: Asset) kind institutional;
@source(IRC_S48A_E, quote = "the fuel input for the project, when completed, is at least 75 percent coal")
rule ProjectMeetsCommonRequirements48aRule(project: Asset, coal: Decimal, mw: Decimal) strict {
    when project_uses_advanced_coal_technology_48a(project);
    when project_fuel_input_coal_percent_48a(project, coal);
    when coal >= 75.0;
    when project_nameplate_capacity_mw_48a(project, mw);
    when mw >= 400.0;
    when applicant_evidence_of_output_and_site_48a(project);
    when project_located_in_united_states_48a(project);
    when environmental_authorizations_received_48a(project);
    when main_steam_turbine_contract_or_retrofit_48a(project);
    then project_meets_common_requirements_48a(project);
}
rule ProjectMeetsRequirementsFirstRound48aRule(project: Asset) strict {
    when project_meets_common_requirements_48a(project);
    when advanced_coal_project_class_48a(project, IntegratedGasificationFirstRound);
    then project_meets_certification_requirements_48a(project);
}
rule ProjectMeetsRequirementsFirstRoundOther48aRule(project: Asset) strict {
    when project_meets_common_requirements_48a(project);
    when advanced_coal_project_class_48a(project, OtherTechnologyFirstRound);
    then project_meets_certification_requirements_48a(project);
}
@source(IRC_S48A_E, quote = "the project includes equipment which separates and sequesters at least 65 percent (70 percent in the case of an application for reallocated credits under subsection (d)(4)) of such project's total carbon dioxide emissions")
rule ProjectMeetsRequirementsSecondRound48aRule(project: Asset, pct: Decimal) strict {
    when project_meets_common_requirements_48a(project);
    when advanced_coal_project_class_48a(project, CarbonSequestrationSecondRound);
    when project_sequestration_percent_48a(project, pct);
    when pct >= 65.0;
    when not_known(second_round_reallocation_application_48a(project));
    then project_meets_certification_requirements_48a(project);
}
rule ProjectMeetsRequirementsSecondRoundReallocated48aRule(project: Asset, pct: Decimal) strict {
    when project_meets_common_requirements_48a(project);
    when advanced_coal_project_class_48a(project, CarbonSequestrationSecondRound);
    when project_sequestration_percent_48a(project, pct);
    when pct >= 70.0;
    when second_round_reallocation_application_48a(project);
    then project_meets_certification_requirements_48a(project);
}

// --- (d)(2)-(3): certification by the Secretary -----------------------------------

pub relation certification_program_total_48a(total: Money) kind empirical {
    label en official "the aggregate credits certified by the Secretary under section 48A(d)(2), including this certification — case-asserted";
}
pub relation certification_within_program_cap_48a(project: Asset) kind institutional {
    label en official "section 48A(d)(3)(A): the aggregate credits allowed for certified projects do not exceed $2,550,000,000";
}
@source(IRC_S48A_D, quote = "The aggregate credits allowed under subsection (a) for projects certified by the Secretary under paragraph (2) may not exceed $2,550,000,000.")
rule CertificationWithinProgramCap48aRule(project: Asset, total: Money) strict {
    when project_meets_certification_requirements_48a(project);
    when certification_program_total_48a(total);
    when total <= 2550000000.00 USD;
    then certification_within_program_cap_48a(project);
}
pub relation secretary_certifies_project_48a(project: Asset, applicant: Person, on: Date) kind empirical {
    label en official "the Secretary's certification of the project under section 48A(d)(2), issued on this date — the exercise of the certification power";
}
pub relation certified_project_48a(project: Asset) kind institutional {
    label en official "the project is certified by the Secretary under section 48A(d)(2)";
}
@source(IRC_S48A_E, quote = "a project shall be considered a qualifying advanced coal project that the Secretary may certify under subsection (d)(2) if the Secretary determines that, at a minimum")
rule Section48aCertificationPowerRule(project: Asset, applicant: Person, on: Date) strict {
    when secretary_certifies_project_48a(project, applicant, on);
    then power Section48aD2Certification {
        holder us.irc.core::Secretary;
        over applicant;
        exercise secretary_certifies_project_48a(project, applicant, on);
        valid_when certification_within_program_cap_48a(project);
        effect create(certified_project_48a(project));
        window [@2005-08-08, infinity);
    };
}
pub relation certification_lapsed_48a(project: Asset) kind institutional {
    label en official "section 48A(d)(2)(E): the certification is no longer valid because the project was not placed in service within 5 years of issuance";
}
pub relation project_placed_in_service_on_48a(project: Asset, on: Date) kind empirical {
    label en official "the date the certified project is placed in service — case-asserted";
}
relation project_placed_in_service_48a(project: Asset) kind institutional;
rule ProjectPlacedInService48aRule(project: Asset, on: Date) strict {
    when project_placed_in_service_on_48a(project, on);
    then project_placed_in_service_48a(project);
}
@source(IRC_S48A_D, quote = "An applicant which receives a certification shall have 5 years from the date of issuance of the certification in order to place the project in service")
rule CertificationLapsedLate48aRule(project: Asset, applicant: Person, issued: Date, placed: Date) strict {
    when secretary_certifies_project_48a(project, applicant, issued);
    when project_placed_in_service_on_48a(project, placed);
    when placed > add_calendar_period(issued, 60 calendar_month);
    then certification_lapsed_48a(project);
}
rule CertificationLapsedNotPlaced48aRule(project: Asset, applicant: Person, issued: Date, asof: Date) strict {
    when secretary_certifies_project_48a(project, applicant, issued);
    when not_known(project_placed_in_service_48a(project));
    when decision_date_48a(asof);
    when asof > add_calendar_period(issued, 60 calendar_month);
    then certification_lapsed_48a(project);
}
pub relation decision_date_48a(asof: Date) kind empirical {
    label en official "the date as of which the lapse of an unplaced project's certification is read — case-asserted";
}
pub relation qualifying_advanced_coal_project_48a(project: Asset) kind institutional {
    label en official "section 48A(c)(1): a project that meets the requirements of subsection (e) and is certified, with the certification not lapsed";
}
@source(IRC_S48A_C, quote = "The term \"qualifying advanced coal project\" means a project which meets the requirements of subsection (e).")
rule QualifyingAdvancedCoalProject48aRule(project: Asset) defeasible {
    when certified_project_48a(project);
    when not_known(certification_lapsed_48a(project));
    then qualifying_advanced_coal_project_48a(project);
}

// --- Secretary duties ---------------------------------------------------------------

pub relation section_48a_enacted_on(on: Date) kind empirical {
    label en official "the date of enactment of section 48A (the reference date of the (d)(1), (d)(4) time limits) — case-asserted from the pinned Public Law note";
}
pub relation program_established_48a(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary, in consultation with the Secretary of Energy, has established the qualifying advanced coal project program";
}
@source(IRC_S48A_D, quote = "the Secretary, in consultation with the Secretary of Energy, shall establish a qualifying advanced coal project program for the deployment of advanced coal-based generation technologies")
rule Section48aD1ProgramDutyRule(on: Date) strict {
    when section_48a_enacted_on(on);
    then duty Section48aD1ProgramDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition program_established_48a(us.irc.core::Secretary);
            window [on, add_calendar_period(on, 180 calendar_day)];
        }
    };
}
pub relation certification_application_submitted_48a(applicant: Person, project: Asset, on: Date) kind empirical {
    label en official "the applicant submitted an application for certification of the project on this date — case-asserted";
}
pub relation determination_issued_48a(project: Asset) kind empirical {
    label en official "the Secretary issued a determination whether the applicant met the requirements under subsection (e)(1) — case-asserted";
}
@source(IRC_S48A_D, quote = "The Secretary shall issue a determination as to whether an applicant has met the requirements under subsection (e)(1) within 60 days following the date of submittal of the application for certification.")
rule Section48aD2CDeterminationDutyRule(applicant: Person, project: Asset, on: Date) strict {
    when certification_application_submitted_48a(applicant, project, on);
    then duty Section48aD2CDeterminationDuty {
        bearer us.irc.core::Secretary;
        beneficiary applicant;
        goal achievement {
            condition determination_issued_48a(project);
            window [on, add_calendar_period(on, 60 calendar_day)];
        }
    };
}
pub relation certification_publicly_disclosed_48a(project: Asset) kind empirical {
    label en official "the Secretary publicly disclosed the identity of the applicant and the amount of the credit certified — case-asserted";
}
@source(IRC_S48A_D, quote = "The Secretary shall, upon making a certification under this subsection or section 48B(d), publicly disclose the identity of the applicant and the amount of the credit certified with respect to such applicant.")
rule Section48aD5DisclosureDutyRule(project: Asset, applicant: Person, on: Date) strict {
    when secretary_certifies_project_48a(project, applicant, on);
    then duty Section48aD5DisclosureDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition certification_publicly_disclosed_48a(project);
            window [on, infinity);
        }
    };
}
pub relation allocation_review_completed_48a(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary reviewed the credits allocated as of the date 6 years after enactment (section 48A(d)(4)(A)) — case-asserted";
}
@source(IRC_S48A_D, quote = "Not later than 6 years after the date of enactment of this section, the Secretary shall review the credits allocated under this section")
rule Section48aD4AReviewDutyRule(on: Date) strict {
    when section_48a_enacted_on(on);
    then duty Section48aD4AReviewDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition allocation_review_completed_48a(us.irc.core::Secretary);
            window [on, add_calendar_period(on, 72 calendar_month)];
        }
    };
}
pub relation reallocation_grounds_48a(secretary: us.irc.core::Organ) kind empirical {
    label en official "at the review the Secretary determined that qualifying applications were insufficient, or a certification was revoked because of third-party delay (section 48A(d)(4)(B)) — case-asserted";
}
pub relation secretary_reallocates_credits_48a(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary's exercise of the reallocation power of section 48A(d)(4)(B) — case-asserted";
}
pub relation credits_reallocated_48a(secretary: us.irc.core::Organ) kind institutional {
    label en official "credits available under clauses (i) and (ii) of paragraph (3)(B) are reallocated";
}
@source(IRC_S48A_D, quote = "The Secretary may reallocate credits available under clauses (i) and (ii) of paragraph (3)(B) if the Secretary determines that")
rule Section48aD4BReallocationPowerRule(secretary: us.irc.core::Organ) strict {
    when reallocation_grounds_48a(secretary);
    then power Section48aD4BReallocation {
        holder us.irc.core::Secretary;
        over us.irc.core::Secretary;
        exercise secretary_reallocates_credits_48a(secretary);
        valid_when reallocation_grounds_48a(secretary);
        effect create(credits_reallocated_48a(secretary));
        window [@2005-08-08, infinity);
    };
}

// --- (i): recapture --------------------------------------------------------------

pub relation project_fails_sequestration_requirements_48a(project: Asset) kind empirical {
    label en official "the project fails to attain or maintain the separation and sequestration requirements of subsection (e)(1)(G) — case-asserted";
}
pub relation recapture_provided_for_48a(project: Asset) kind empirical {
    label en official "the Secretary has provided for recapturing the benefit of the credit for the project — case-asserted";
}
@source(IRC_S48A_I, quote = "The Secretary shall provide for recapturing the benefit of any credit allowable under subsection (a) with respect to any project which fails to attain or maintain the separation and sequestration requirements of subsection (e)(1)(G).")
rule Section48aIRecaptureDutyRule(project: Asset) strict {
    when project_fails_sequestration_requirements_48a(project);
    then duty Section48aIRecaptureDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition recapture_provided_for_48a(project);
            window [@2005-08-08, infinity);
        }
    };
}

// --- (a): the credit ---------------------------------------------------------------

pub relation advanced_coal_project_credit_before_45b3_48a(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48A(a): the qualifying advanced coal project credit of one project before the section 48A(b)(2) reduction for tax-exempt bonds (stage 4)";
}
pub relation advanced_coal_project_credit_per_project_48a(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48A(a), (b)(2): the qualifying advanced coal project credit of one project for the taxable year, after the reduction for tax-exempt bonds by the rule similar to section 45(b)(3)";
}
@source(IRC_S48A_B, quote = "Rules similar to section 48(a)(4) (without regard to subparagraph (D) thereof) shall apply for purposes of this section.")
rule AdvancedCoalCreditReduced45b3Similar48a(taxpayer: Person, project: Asset, y: TaxableYear, before: Money, f: Decimal) defeasible {
    label en official "section 48A(b)(2): the credit of the project reduced by the fraction of section 45(b)(3), the rule that section 48(a)(4) makes similar (stage 4)";
    when advanced_coal_project_credit_before_45b3_48a(taxpayer, project, y, before);
    when reduction_fraction_45b3(project, y, f);
    then advanced_coal_project_credit_per_project_48a(taxpayer, project, y, round(before * (1.0 - f), 2, "HALF_UP"));
}
rule AdvancedCoalCreditNotReduced45b3Similar48a(taxpayer: Person, project: Asset, y: TaxableYear, before: Money) defeasible {
    label en official "no tax-exempt bond financing of the project: the credit stands";
    when advanced_coal_project_credit_before_45b3_48a(taxpayer, project, y, before);
    when not_known(has_reduction_fraction_45b3(project, y));
    then advanced_coal_project_credit_per_project_48a(taxpayer, project, y, before);
}
@source(IRC_S48A_A, quote = "20 percent of the qualified investment for such taxable year in the case of projects described in subsection (d)(3)(B)(i)")
rule AdvancedCoalCreditIgcc48aRule(taxpayer: Person, project: Asset, y: TaxableYear, investment: Money) defeasible {
    when qualifying_advanced_coal_project_48a(project);
    when advanced_coal_project_class_48a(project, IntegratedGasificationFirstRound);
    when qualified_investment_48a(taxpayer, project, y, investment);
    then advanced_coal_project_credit_before_45b3_48a(taxpayer, project, y, round(0.20 * investment, 2, "HALF_UP"));
}
@source(IRC_S48A_A, quote = "15 percent of the qualified investment for such taxable year in the case of projects described in subsection (d)(3)(B)(ii)")
rule AdvancedCoalCreditOther48aRule(taxpayer: Person, project: Asset, y: TaxableYear, investment: Money) defeasible {
    when qualifying_advanced_coal_project_48a(project);
    when advanced_coal_project_class_48a(project, OtherTechnologyFirstRound);
    when qualified_investment_48a(taxpayer, project, y, investment);
    then advanced_coal_project_credit_before_45b3_48a(taxpayer, project, y, round(0.15 * investment, 2, "HALF_UP"));
}
@source(IRC_S48A_A, quote = "30 percent of the qualified investment for such taxable year in the case of projects described in clause (iii) of subsection (d)(3)(B)")
rule AdvancedCoalCreditSecondRound48aRule(taxpayer: Person, project: Asset, y: TaxableYear, investment: Money) defeasible {
    when qualifying_advanced_coal_project_48a(project);
    when advanced_coal_project_class_48a(project, CarbonSequestrationSecondRound);
    when qualified_investment_48a(taxpayer, project, y, investment);
    then advanced_coal_project_credit_before_45b3_48a(taxpayer, project, y, round(0.30 * investment, 2, "HALF_UP"));
}
pub relation qualifying_advanced_coal_project_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 48A qualifying advanced coal project credit for the taxable year (a section 46(3) component of the investment credit)";
}
rule QualifyingAdvancedCoalProjectCredit48aRule(taxpayer: Person, y: TaxableYear, project: Asset, amount: Money) defeasible {
    when advanced_coal_project_credit_per_project_48a(taxpayer, project, y, amount);
    then qualifying_advanced_coal_project_credit(taxpayer, y,
        sum(collect all a: Money, p: Asset where advanced_coal_project_credit_per_project_48a(taxpayer, p, y, a), empty: 0 USD));
}
