// Section 45 — subsections (c) definitions (qualified energy resources), (d) qualified facilities and (e) special
// rules. Stage 2e (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows "subsection 45(c), (d), (e) not
// reached"). Companion of `45-renewable-electricity-production-credit.law` ((a)-(b)); the credit rules of that module
// do NOT require a qualified facility (they read case-asserted production): the definitions below are exposed as
// separate derived relations so that a case can ask whether a facility qualifies, and the (e)(7) exclusion and the
// (e)(8)/(e)(10) increases are computed here.
//
// Scope / judgment calls:
// * "The date of the enactment of this paragraph" ((d)(3)-(7), (d)(9), (d)(11), (c)(8)) is not pinned in the section
//   45 statutory notes of this corpus: each is a case fact `enactment_date_of_paragraph_45(paragraph, date)` (SOURCE_GAP
//   note in the coverage rows), never a literal invented here. The dates written in the text (1992-12-31, 1993-12-31,
//   2008-10-03, 2010-01-01, 2012-01-01, 2025-01-01, 2005-06-14) are literals.
// * (e)(2)(B): the inflation adjustment factor is the ratio of the GDP implicit price deflators (case facts) with 10
//   decimals HALF_UP (the text names no rounding); the reference price is the Secretary's determination (external
//   judgment, case fact `reference_price_45`).
// * (e)(8), (e)(10): the refined coal and Indian coal increases are computed per ton with cents HALF_UP.
// * (e)(5), (c)(4) ("geothermal deposit", section 613(e)(2)), (c)(6) (solid waste, 42 U.S.C. 6903), (c)(9)(B) (section
//   7871), (e)(1) (sections 638(1)-(2)) are external references: case facts.

use self::{
    Asset,
    ControlledGroup,
    IRC_S45_C,
    IRC_S45_D,
    IRC_S45_E,
    Person,
    TaxableYear,
    facility_placed_in_service_date_45,
    owned_and_used_for_electricity_generation,
    qualified_energy_resources_electricity_produced,
    under_common_control_52b,
};

pub enum EnergyResource45 {
    Wind;
    ClosedLoopBiomass;
    OpenLoopBiomass;
    Geothermal;
    Solar;
    SmallIrrigationPower;
    MunicipalSolidWaste;
    QualifiedHydropowerProduction;
    MarineAndHydrokineticEnergy;
}
pub enum FacilityKind45 {
    WindFacility;
    ClosedLoopBiomassNewFacility;
    ClosedLoopBiomassCofiringModification;
    OpenLoopBiomassLivestockFacility;
    OpenLoopBiomassOtherFacility;
    GeothermalOrSolarFacility;
    SmallIrrigationPowerFacility;
    LandfillGasFacility;
    MunicipalSolidWasteFacility;
    HydropowerFacility;
    MarineAndHydrokineticFacility;
}
pub enum EnactedParagraph45 {
    D3AIOpenLoopLivestock;
    D4GeothermalSolar;
    D5SmallIrrigation;
    D6LandfillGas;
    D7MunicipalSolidWaste;
    D9Hydropower;
    D11MarineHydrokinetic;
    C8Hydropower;
    D8AmericanJobsCreationAct2004;
    D2BNewUnit;
    D2CCofiring;
}

pub relation enactment_date_of_paragraph_45(paragraph: EnactedParagraph45, on: Date) kind empirical {
    label en official "the date of the enactment of the named paragraph or subclause of section 45 (\"the date of the enactment of this paragraph\") — not pinned in the corpus (SOURCE_GAP), case-asserted";
}
pub relation facility_kind_45(facility: Asset, kind: FacilityKind45) kind empirical {
    label en official "the kind of facility described in section 45(d)(1)-(11) — case-asserted";
}
pub relation construction_begin_date_45(facility: Asset, on: Date) kind empirical {
    label en official "the date the construction of the facility (or of the modification, new unit or efficiency improvement) begins — case-asserted";
}
pub relation nameplate_capacity_kw_45(facility: Asset, kw: Decimal) kind empirical {
    label en official "the nameplate capacity rating of the facility in kilowatts (section 45(c)(5)(B), (d)(3)(A)(i)(II), (d)(11)(A)) — case-asserted";
}
pub relation small_wind_expenditure_taken_into_account_under_25d_45(facility: Asset) kind empirical {
    label en official "a qualified small wind energy property expenditure (section 25D(d)(4)) with respect to the facility is taken into account in determining the credit under section 25D (section 45(d)(1)) — case-asserted";
}
pub relation section_48a3_property_basis_used_for_48_credit_45(facility: Asset) kind empirical {
    label en official "the property is described in section 48(a)(3) and its basis is taken into account by the taxpayer for the energy credit under section 48 (section 45(d)(4)) — case-asserted";
}
pub relation biogas_property_with_48_credit_45(facility: Asset) kind empirical {
    label en official "the facility produces electricity from gas produced by qualified biogas property (section 48(c)(7)) and a credit is allowed under section 48 for the taxable year or a prior taxable year (section 45(e)(12)) — case-asserted";
}
pub relation landfill_gas_from_facility_with_45k_credit_45(facility: Asset) kind empirical {
    label en official "the gas derives from biodegradation in a facility (section 45K) the production from which is allowed as a credit under section 45K for the taxable year or a prior year (section 45(e)(9)(A)) — case-asserted";
}

// --- (c)(1): qualified energy resources ---------------------------------------------------------------------------------------------------------------------

relation qualified_energy_resource_45(resource: EnergyResource45) kind institutional;
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "The term \"qualified energy resources\" means—")
assert "45c-r-wind": qualified_energy_resource_45(Wind);
assert "45c-r-closed": qualified_energy_resource_45(ClosedLoopBiomass);
assert "45c-r-open": qualified_energy_resource_45(OpenLoopBiomass);
assert "45c-r-geo": qualified_energy_resource_45(Geothermal);
assert "45c-r-solar": qualified_energy_resource_45(Solar);
assert "45c-r-irrigation": qualified_energy_resource_45(SmallIrrigationPower);
assert "45c-r-msw": qualified_energy_resource_45(MunicipalSolidWaste);
assert "45c-r-hydro": qualified_energy_resource_45(QualifiedHydropowerProduction);
assert "45c-r-marine": qualified_energy_resource_45(MarineAndHydrokineticEnergy);
pub relation energy_source_of_facility_45(facility: Asset, resource: EnergyResource45) kind empirical {
    label en official "the facility produces electricity from this energy source — case-asserted";
}
pub relation facility_uses_qualified_energy_resource_45(facility: Asset) kind institutional {
    label en official "section 45(c)(1): the facility uses wind, closed-loop biomass, open-loop biomass, geothermal energy, solar energy, small irrigation power, municipal solid waste, qualified hydropower production or marine and hydrokinetic renewable energy";
}
rule FacilityUsesQualifiedEnergyResourceRule(facility: Asset, resource: EnergyResource45) strict {
    when energy_source_of_facility_45(facility, resource);
    when qualified_energy_resource_45(resource);
    then facility_uses_qualified_energy_resource_45(facility);
}

// --- (c)(2)-(3): biomass ---------------------------------------------------------------------------------------------------------------------------------

pub relation planted_exclusively_for_electricity_at_qualified_facility_45(material: Asset) kind empirical {
    label en official "the organic material is from a plant which is planted exclusively for purposes of being used at a qualified facility to produce electricity (section 45(c)(2)) — case-asserted";
}
pub relation closed_loop_biomass_45(material: Asset) kind institutional {
    label en official "section 45(c)(2): organic material from a plant planted exclusively for use at a qualified facility to produce electricity";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "The term \"closed-loop biomass\" means any organic material from a plant which is planted exclusively for purposes of being used at a qualified facility to produce electricity.")
rule ClosedLoopBiomassRule(material: Asset) strict {
    when planted_exclusively_for_electricity_at_qualified_facility_45(material);
    then closed_loop_biomass_45(material);
}
pub enum BiomassSource45 {
    LivestockManureAndLitter;
    ForestMillHarvestingResidueThinningsSlashBrush;
    SolidWoodWaste;
    AgricultureCropByProductsOrResidues;
    MunicipalSolidWasteGasOrRecycledPaper;
    OtherMaterial;
}
pub relation biomass_material_source_45(material: Asset, origin_kind: BiomassSource45) kind empirical {
    label en official "the biomass material derives from this source (section 45(c)(3)): agricultural livestock manure and litter (bovine, swine, poultry, sheep, with bedding); forest mill and harvesting residues, precommercial thinnings, slash and brush; solid wood waste (not pressure-treated, chemically-treated or painted, not municipal solid waste, biodegradation gas or commonly recycled paper); agriculture sources (orchard tree crops, vineyard, grain, legumes, sugar and other crop by-products or residues) — case-asserted classification";
}
pub relation solid_nonhazardous_cellulosic_or_lignin_waste_45(material: Asset) kind empirical {
    label en official "the material is solid, nonhazardous, cellulosic waste material or lignin material (section 45(c)(3)(A)(ii)) — case-asserted";
}
pub relation cofired_with_fossil_fuel_beyond_startup_45(material: Asset) kind empirical {
    label en official "the biomass is burned in conjunction with fossil fuel (cofiring) beyond the fossil fuel required for startup and flame stabilization (section 45(c)(3)(A), last sentence) — case-asserted";
}
pub relation open_loop_biomass_45(material: Asset) kind institutional {
    label en official "section 45(c)(3): agricultural livestock waste nutrients, or solid nonhazardous cellulosic waste or lignin from forest, wood-waste or agriculture sources; not closed-loop biomass and not cofired with fossil fuel beyond startup";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "(i) any agricultural livestock waste nutrients, or")
rule OpenLoopBiomassLivestockRule(material: Asset) strict {
    when biomass_material_source_45(material, LivestockManureAndLitter);
    when not_known(closed_loop_biomass_45(material));
    when not_known(cofired_with_fossil_fuel_beyond_startup_45(material));
    then open_loop_biomass_45(material);
}
rule OpenLoopBiomassForestRule(material: Asset) strict {
    when biomass_material_source_45(material, ForestMillHarvestingResidueThinningsSlashBrush);
    when solid_nonhazardous_cellulosic_or_lignin_waste_45(material);
    when not_known(closed_loop_biomass_45(material));
    when not_known(cofired_with_fossil_fuel_beyond_startup_45(material));
    then open_loop_biomass_45(material);
}
rule OpenLoopBiomassWoodWasteRule(material: Asset) strict {
    when biomass_material_source_45(material, SolidWoodWaste);
    when solid_nonhazardous_cellulosic_or_lignin_waste_45(material);
    when not_known(closed_loop_biomass_45(material));
    when not_known(cofired_with_fossil_fuel_beyond_startup_45(material));
    then open_loop_biomass_45(material);
}
rule OpenLoopBiomassAgricultureRule(material: Asset) strict {
    when biomass_material_source_45(material, AgricultureCropByProductsOrResidues);
    when solid_nonhazardous_cellulosic_or_lignin_waste_45(material);
    when not_known(closed_loop_biomass_45(material));
    when not_known(cofired_with_fossil_fuel_beyond_startup_45(material));
    then open_loop_biomass_45(material);
}

// --- (c)(4)-(6): geothermal, small irrigation power, municipal solid waste ----------------------------------------------------------------------------

pub relation energy_derived_from_geothermal_deposit_45(facility: Asset) kind empirical {
    label en official "the energy is derived from a geothermal deposit within the meaning of section 613(e)(2) (section 45(c)(4)) — case-asserted (section 613 is owned by another package)";
}
pub relation generated_without_dam_through_irrigation_canal_or_ditch_45(facility: Asset) kind empirical {
    label en official "the power is generated without any dam or impoundment of water through an irrigation system canal or ditch (section 45(c)(5)(A)) — case-asserted";
}
pub relation small_irrigation_power_45(facility: Asset) kind institutional {
    label en official "section 45(c)(5): power generated without a dam or impoundment through an irrigation canal or ditch by a facility with a nameplate capacity of at least 150 kilowatts and less than 5 megawatts";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "(B) the nameplate capacity rating of which is not less than 150 kilowatts but is less than 5 megawatts.")
rule SmallIrrigationPowerRule(facility: Asset, kw: Decimal) strict {
    when generated_without_dam_through_irrigation_canal_or_ditch_45(facility);
    when nameplate_capacity_kw_45(facility, kw);
    when kw >= 150.0;
    when kw < 5000.0;
    then small_irrigation_power_45(facility);
}
pub relation solid_waste_under_swda_1004_27_45(material: Asset) kind empirical {
    label en official "the material is solid waste under section 1004(27) of the Solid Waste Disposal Act (42 U.S.C. 6903) (section 45(c)(6)) — case-asserted external classification";
}
pub relation paper_commonly_recycled_and_segregated_45(material: Asset) kind empirical {
    label en official "the material is paper which is commonly recycled and which has been segregated from other solid waste (section 45(c)(6)) — case-asserted";
}
pub relation municipal_solid_waste_45(material: Asset) kind institutional {
    label en official "section 45(c)(6): solid waste under the Solid Waste Disposal Act, except paper commonly recycled and segregated from other solid waste";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "except that such term does not include paper which is commonly recycled and which has been segregated from other solid waste (as so defined).")
rule MunicipalSolidWasteRule(material: Asset) strict {
    when solid_waste_under_swda_1004_27_45(material);
    when not_known(paper_commonly_recycled_and_segregated_45(material));
    then municipal_solid_waste_45(material);
}

// --- (c)(7): refined coal ---------------------------------------------------------------------------------------------------------------------------------

pub relation fuel_from_coal_or_high_carbon_fly_ash_45(fuel: Asset) kind empirical {
    label en official "the fuel is a liquid, gaseous or solid fuel produced from coal (including lignite) or high carbon fly ash, including such fuel used as a feedstock (section 45(c)(7)(A)(i)(I)) — case-asserted";
}
pub relation sold_with_reasonable_expectation_of_use_for_steam_45(fuel: Asset) kind empirical {
    label en official "the fuel is sold by the taxpayer with the reasonable expectation that it will be used for the purpose of producing steam (section 45(c)(7)(A)(i)(II)) — case-asserted";
}
pub relation certified_qualified_emission_reduction_45(fuel: Asset) kind empirical {
    label en official "the fuel is certified by the taxpayer as resulting, when used in the production of steam, in a qualified emission reduction (section 45(c)(7)(A)(i)(III)) — case-asserted";
}
pub relation nitrogen_oxide_reduction_pct_45(fuel: Asset, pct: Decimal) kind empirical {
    label en official "the reduction, as a fraction, of the emissions of nitrogen oxide when burning the refined coal compared with the feedstock coal (excluding dilution) (section 45(c)(7)(B)) — case-asserted";
}
pub relation sulfur_dioxide_reduction_pct_45(fuel: Asset, pct: Decimal) kind empirical {
    label en official "the reduction, as a fraction, of the emissions of sulfur dioxide (section 45(c)(7)(B)) — case-asserted";
}
pub relation mercury_reduction_pct_45(fuel: Asset, pct: Decimal) kind empirical {
    label en official "the reduction, as a fraction, of the emissions of mercury (section 45(c)(7)(B)) — case-asserted";
}
pub relation qualified_emission_reduction_45(fuel: Asset) kind institutional {
    label en official "section 45(c)(7)(B): a reduction of at least 20 percent of nitrogen oxide emissions and at least 40 percent of the emissions of either sulfur dioxide or mercury";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "The term \"qualified emission reduction\" means a reduction of at least 20 percent of the emissions of nitrogen oxide and at least 40 percent of the emissions of either sulfur dioxide or mercury released when burning the refined coal")
rule QualifiedEmissionReductionSulfurRule(fuel: Asset, nox: Decimal, so2: Decimal) strict {
    when nitrogen_oxide_reduction_pct_45(fuel, nox);
    when sulfur_dioxide_reduction_pct_45(fuel, so2);
    when nox >= 0.20;
    when so2 >= 0.40;
    then qualified_emission_reduction_45(fuel);
}
rule QualifiedEmissionReductionMercuryRule(fuel: Asset, nox: Decimal, hg: Decimal) strict {
    when nitrogen_oxide_reduction_pct_45(fuel, nox);
    when mercury_reduction_pct_45(fuel, hg);
    when nox >= 0.20;
    when hg >= 0.40;
    then qualified_emission_reduction_45(fuel);
}
pub relation produced_by_liquefying_coal_waste_sludge_and_distributing_on_coal_45(fuel: Asset) kind empirical {
    label en official "the fuel is produced through a process of liquifying coal waste sludge (tar decanter sludge and related coking byproducts) and distributing it on coal (section 45(c)(7)(C)(i)(I), (ii)) — case-asserted";
}
pub relation used_as_feedstock_for_coke_45(fuel: Asset) kind empirical {
    label en official "the fuel is used as a feedstock for the manufacture of coke (section 45(c)(7)(C)(i)(II)) — case-asserted";
}
pub relation steel_industry_fuel_45(fuel: Asset) kind institutional {
    label en official "section 45(c)(7)(C): a fuel produced by liquefying coal waste sludge and distributing it on coal, used as a feedstock for coke";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "The term \"steel industry fuel\" means a fuel which—")
rule SteelIndustryFuelRule(fuel: Asset) strict {
    when produced_by_liquefying_coal_waste_sludge_and_distributing_on_coal_45(fuel);
    when used_as_feedstock_for_coke_45(fuel);
    then steel_industry_fuel_45(fuel);
}
pub relation refined_coal_45(fuel: Asset) kind institutional {
    label en official "section 45(c)(7)(A): a fuel produced from coal or high carbon fly ash, sold for steam production and certified as a qualified emission reduction, or steel industry fuel";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "The term \"refined coal\" means a fuel—")
rule RefinedCoalEmissionRule(fuel: Asset) strict {
    when fuel_from_coal_or_high_carbon_fly_ash_45(fuel);
    when sold_with_reasonable_expectation_of_use_for_steam_45(fuel);
    when certified_qualified_emission_reduction_45(fuel);
    when qualified_emission_reduction_45(fuel);
    then refined_coal_45(fuel);
}
rule RefinedCoalSteelIndustryRule(fuel: Asset) strict {
    when steel_industry_fuel_45(fuel);
    then refined_coal_45(fuel);
}

// --- (c)(8): qualified hydropower production -------------------------------------------------------------------------------------------------------------

pub relation hydroelectric_dam_placed_in_service_on_or_before_45(facility: Asset) kind empirical {
    label en official "the hydroelectric dam was placed in service on or before the date of the enactment of paragraph (8) (section 45(c)(8)(A)(i)) — case-asserted";
}
pub relation average_annual_hydropower_production_kwh_45(facility: Asset, kwh: Decimal) kind empirical {
    label en official "the historic average annual hydropower production of the facility in kilowatt hours, from the same water flow information (section 45(c)(8)(B)(i)) — case-asserted";
}
pub relation share_attributable_to_improvements_after_enactment_45(facility: Asset, share: Decimal) kind empirical {
    label en official "the share (fraction) of average annual hydropower production attributable to efficiency improvements or additions of capacity placed in service after the enactment of paragraph (8) (section 45(c)(8)(B)(i)) — case-asserted";
}
pub relation improvement_share_based_on_operational_changes_45(facility: Asset) kind empirical {
    label en official "the determination is based on operational changes at the facility not directly associated with the efficiency improvements or additions of capacity (section 45(c)(8)(B)(ii)) — case-asserted";
}
pub relation incremental_hydropower_production_kwh_45(facility: Asset, kwh: Decimal) kind institutional {
    label en official "section 45(c)(8)(B): the percentage of the average annual hydropower production attributable to efficiency improvements or additions of capacity placed in service after the enactment (not based on operational changes)";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), incremental hydropower production for any taxable year shall be equal to the percentage of average annual hydropower production at the facility attributable to the efficiency improvements or additions of capacity placed in service after the date of the enactment of this paragraph")
rule IncrementalHydropowerProduction45Rule(facility: Asset, average: Decimal, share: Decimal) strict {
    when hydroelectric_dam_placed_in_service_on_or_before_45(facility);
    when average_annual_hydropower_production_kwh_45(facility, average);
    when share_attributable_to_improvements_after_enactment_45(facility, share);
    when not_known(improvement_share_based_on_operational_changes_45(facility));
    then incremental_hydropower_production_kwh_45(facility, average * share);
}
pub relation licensed_by_ferc_and_meets_requirements_45(facility: Asset) kind empirical {
    label en official "the hydroelectric project installed on the nonhydroelectric dam is licensed by the Federal Energy Regulatory Commission and meets all other applicable environmental, licensing and regulatory requirements (section 45(c)(8)(C)(i)) — case-asserted";
}
pub relation nonhydroelectric_dam_placed_before_enactment_for_flood_navigation_or_water_supply_45(facility: Asset) kind empirical {
    label en official "the nonhydroelectric dam was placed in service before the enactment of paragraph (8), operated for flood control, navigation or water supply purposes and did not produce hydroelectric power on that date (section 45(c)(8)(C)(ii)) — case-asserted";
}
external judgment relation secretary_certifies_water_surface_elevation_maintained_45(facility: Asset) {
    authority Secretary;
    label en official "the Secretary, in consultation with the Federal Energy Regulatory Commission, certifies that the hydroelectric project is operated so that the water surface elevation at any location and time that would have occurred in the absence of the project is maintained, subject to license requirements (section 45(c)(8)(C)(iii))";
}
pub relation nonhydroelectric_dam_facility_45(facility: Asset) kind institutional {
    label en official "section 45(c)(8)(C): a hydroelectric project on a nonhydroelectric dam that is FERC-licensed, on a dam in service before the enactment used for flood control, navigation or water supply, and certified to maintain water surface elevation";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), a facility is described in this subparagraph if—")
rule NonhydroelectricDamFacilityRule(facility: Asset) defeasible {
    when licensed_by_ferc_and_meets_requirements_45(facility);
    when nonhydroelectric_dam_placed_before_enactment_for_flood_navigation_or_water_supply_45(facility);
    when secretary_certifies_water_surface_elevation_maintained_45(facility);
    then nonhydroelectric_dam_facility_45(facility);
}

// --- (c)(9): Indian coal ----------------------------------------------------------------------------------------------------------------------------------

pub relation coal_reserves_owned_by_indian_tribe_on_june_14_2005_45(coal: Asset) kind empirical {
    label en official "the coal is produced from coal reserves which on June 14, 2005 were owned by an Indian tribe (section 45(c)(9)(A)(i)) — case-asserted (\"Indian tribe\": section 7871(c)(3)(E)(ii), another package)";
}
pub relation coal_reserves_held_in_trust_for_indian_tribe_on_june_14_2005_45(coal: Asset) kind empirical {
    label en official "the coal is produced from coal reserves which on June 14, 2005 were held in trust by the United States for the benefit of an Indian tribe or its members (section 45(c)(9)(A)(ii)) — case-asserted";
}
pub relation indian_coal_45(coal: Asset) kind institutional {
    label en official "section 45(c)(9): coal produced from coal reserves that on June 14, 2005 were owned by an Indian tribe or held in trust for an Indian tribe or its members";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "The term \"Indian coal\" means coal which is produced from coal reserves which, on June 14, 2005—")
rule IndianCoalOwnedRule(coal: Asset) strict {
    when coal_reserves_owned_by_indian_tribe_on_june_14_2005_45(coal);
    then indian_coal_45(coal);
}
rule IndianCoalTrustRule(coal: Asset) strict {
    when coal_reserves_held_in_trust_for_indian_tribe_on_june_14_2005_45(coal);
    then indian_coal_45(coal);
}

// --- (c)(10): marine and hydrokinetic renewable energy -----------------------------------------------------------------------------------------------

pub enum MarineSource45 {
    WavesTidesCurrentsOceansEstuaries;
    FreeFlowingWaterRiversLakesStreams;
    FreeFlowingWaterInIrrigationSystemCanalOrChannel;
    OceanTemperatureDifferentials;
    PressurizedWaterInDistributionPipeline;
}
pub relation marine_energy_source_45(facility: Asset, origin_kind: MarineSource45) kind empirical {
    label en official "the energy is derived from this source (section 45(c)(10)(A)(i)-(v)) — case-asserted";
}
pub relation pipeline_operated_for_water_distribution_not_primarily_for_electricity_45(facility: Asset) kind empirical {
    label en official "the pressurized-water pipeline (or similar conveyance) is operated for the distribution of water for agricultural, municipal or industrial consumption and not primarily for the generation of electricity (section 45(c)(10)(A)(v)(I)-(II)) — case-asserted";
}
pub relation source_utilizes_dam_diversion_or_impoundment_45(facility: Asset) kind empirical {
    label en official "the source utilizes a dam, diversionary structure or impoundment for electric power production purposes (section 45(c)(10)(B)) — case-asserted";
}
pub relation marine_and_hydrokinetic_renewable_energy_45(facility: Asset) kind institutional {
    label en official "section 45(c)(10): energy derived from waves, tides and currents, free flowing water, water in an irrigation system or man-made channel, ocean temperature differentials, or pressurized water in a distribution pipeline; not from a source utilizing a dam, diversionary structure or impoundment (except as in (A)(iii))";
}
@source(IRC_S45_C, relation = formalizes, coverage = exact, quote = "Such term shall not include any energy which is derived from any source which utilizes a dam, diversionary structure (except as provided in subparagraph (A)(iii)), or impoundment for electric power production purposes.")
rule MarineWavesRule(facility: Asset) strict {
    when marine_energy_source_45(facility, WavesTidesCurrentsOceansEstuaries);
    when not_known(source_utilizes_dam_diversion_or_impoundment_45(facility));
    then marine_and_hydrokinetic_renewable_energy_45(facility);
}
rule MarineFreeFlowingWaterRule(facility: Asset) strict {
    when marine_energy_source_45(facility, FreeFlowingWaterRiversLakesStreams);
    when not_known(source_utilizes_dam_diversion_or_impoundment_45(facility));
    then marine_and_hydrokinetic_renewable_energy_45(facility);
}
rule MarineIrrigationChannelRule(facility: Asset) strict {
    when marine_energy_source_45(facility, FreeFlowingWaterInIrrigationSystemCanalOrChannel);
    // subparagraph (A)(iii) is the exception to the dam/diversionary-structure exclusion: nonmechanical structures allowed.
    then marine_and_hydrokinetic_renewable_energy_45(facility);
}
rule MarineOceanThermalRule(facility: Asset) strict {
    when marine_energy_source_45(facility, OceanTemperatureDifferentials);
    when not_known(source_utilizes_dam_diversion_or_impoundment_45(facility));
    then marine_and_hydrokinetic_renewable_energy_45(facility);
}
rule MarinePipelineRule(facility: Asset) strict {
    when marine_energy_source_45(facility, PressurizedWaterInDistributionPipeline);
    when pipeline_operated_for_water_distribution_not_primarily_for_electricity_45(facility);
    when not_known(source_utilizes_dam_diversion_or_impoundment_45(facility));
    then marine_and_hydrokinetic_renewable_energy_45(facility);
}

// --- (d): qualified facilities ------------------------------------------------------------------------------------------------------------------------------

pub relation qualified_facility_45(facility: Asset, taxpayer: Person) kind institutional {
    label en official "section 45(d)(1)-(11): a facility of the kind described in the paragraph, owned by the taxpayer, originally placed in service and with construction beginning within the paragraph's dates";
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "In the case of a facility using wind to produce electricity, the term \"qualified facility\" means any facility owned by the taxpayer which is originally placed in service after December 31, 1993, and the construction of which begins before January 1, 2025.")
rule QualifiedFacilityWindRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date) strict {
    when facility_kind_45(facility, WindFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when placed > @1993-12-31;
    when begun < @2025-01-01;
    when not_known(small_wind_expenditure_taken_into_account_under_25d_45(facility));
    then qualified_facility_45(facility, taxpayer);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "(i) owned by the taxpayer which is originally placed in service after December 31, 1992, and the construction of which begins before January 1, 2025, or")
rule QualifiedFacilityClosedLoopNewRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date) strict {
    when facility_kind_45(facility, ClosedLoopBiomassNewFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when placed > @1992-12-31;
    when begun < @2025-01-01;
    then qualified_facility_45(facility, taxpayer);
}
pub relation cofiring_modification_approved_under_biomass_power_program_45(facility: Asset) kind empirical {
    label en official "the modification to co-fire closed-loop biomass with coal, other biomass or both is approved under the Biomass Power for Rural Development Programs or is part of a pilot project of the Commodity Credit Corporation described in 65 Fed. Reg. 63052 (section 45(d)(2)(A)(ii)) — case-asserted";
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "(ii) owned by the taxpayer which before January 1, 2025, is originally placed in service and modified to use closed-loop biomass to co-fire with coal, with other biomass, or with both")
rule QualifiedFacilityClosedLoopCofiringRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date) strict {
    when facility_kind_45(facility, ClosedLoopBiomassCofiringModification);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when cofiring_modification_approved_under_biomass_power_program_45(facility);
    when placed < @2025-01-01;
    when begun < @2025-01-01;
    then qualified_facility_45(facility, taxpayer);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "(I) is originally placed in service after the date of the enactment of this subclause and the construction of which begins before January 1, 2025, and")
rule QualifiedFacilityOpenLoopLivestockRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date, enacted: Date, kw: Decimal) strict {
    when facility_kind_45(facility, OpenLoopBiomassLivestockFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when enactment_date_of_paragraph_45(D3AIOpenLoopLivestock, enacted);
    when nameplate_capacity_kw_45(facility, kw);
    when placed > enacted;
    when begun < @2025-01-01;
    when kw >= 150.0;
    then qualified_facility_45(facility, taxpayer);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "(ii) in the case of any other facility, the construction of which begins before January 1, 2025.")
rule QualifiedFacilityOpenLoopOtherRule(facility: Asset, taxpayer: Person, begun: Date) strict {
    when facility_kind_45(facility, OpenLoopBiomassOtherFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when construction_begin_date_45(facility, begun);
    when begun < @2025-01-01;
    then qualified_facility_45(facility, taxpayer);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "In the case of a facility using geothermal or solar energy to produce electricity, the term \"qualified facility\" means any facility owned by the taxpayer which is originally placed in service after the date of the enactment of this paragraph and the construction of which begins before January 1, 2025.")
rule QualifiedFacilityGeothermalSolarRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date, enacted: Date) strict {
    when facility_kind_45(facility, GeothermalOrSolarFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when enactment_date_of_paragraph_45(D4GeothermalSolar, enacted);
    when placed > enacted;
    when begun < @2025-01-01;
    when not_known(section_48a3_property_basis_used_for_48_credit_45(facility));
    then qualified_facility_45(facility, taxpayer);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "In the case of a facility using small irrigation power to produce electricity, the term \"qualified facility\" means any facility owned by the taxpayer which is originally placed in service after the date of the enactment of this paragraph and before October 3, 2008.")
rule QualifiedFacilitySmallIrrigationRule(facility: Asset, taxpayer: Person, placed: Date, enacted: Date) strict {
    when facility_kind_45(facility, SmallIrrigationPowerFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when enactment_date_of_paragraph_45(D5SmallIrrigation, enacted);
    when placed > enacted;
    when placed < @2008-10-03;
    then qualified_facility_45(facility, taxpayer);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "In the case of a facility producing electricity from gas derived from the biodegradation of municipal solid waste, the term \"qualified facility\" means any facility owned by the taxpayer which is originally placed in service after the date of the enactment of this paragraph and the construction of which begins before January 1, 2025.")
rule QualifiedFacilityLandfillGasRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date, enacted: Date) strict {
    when facility_kind_45(facility, LandfillGasFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when enactment_date_of_paragraph_45(D6LandfillGas, enacted);
    when placed > enacted;
    when begun < @2025-01-01;
    when not_known(landfill_gas_from_facility_with_45k_credit_45(facility));
    then qualified_facility_45(facility, taxpayer);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "In the case of a facility (other than a facility described in paragraph (6)) which uses municipal solid waste to produce electricity, the term \"qualified facility\" means any facility owned by the taxpayer which is originally placed in service after the date of the enactment of this paragraph and the construction of which begins before January 1, 2025.")
rule QualifiedFacilityMunicipalSolidWasteRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date, enacted: Date) strict {
    when facility_kind_45(facility, MunicipalSolidWasteFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when enactment_date_of_paragraph_45(D7MunicipalSolidWaste, enacted);
    when placed > enacted;
    when begun < @2025-01-01;
    then qualified_facility_45(facility, taxpayer);
}
pub relation efficiency_improvement_construction_begin_date_45(facility: Asset, on: Date) kind empirical {
    label en official "the date the construction of the efficiency improvement or addition to capacity begins (section 45(d)(9)(C)) — case-asserted";
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "(ii) any other facility placed in service after the date of the enactment of this paragraph and the construction of which begins before January 1, 2025.")
rule QualifiedFacilityHydropowerOtherRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date, enacted: Date) strict {
    when facility_kind_45(facility, HydropowerFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when enactment_date_of_paragraph_45(D9Hydropower, enacted);
    when placed > enacted;
    when begun < @2025-01-01;
    then qualified_facility_45(facility, taxpayer);
}
pub relation qualified_incremental_hydropower_share_45(facility: Asset, kwh: Decimal) kind institutional {
    label en official "section 45(d)(9)(A)(i): a facility producing incremental hydropower production is a qualified facility only to the extent of the incremental production attributable to improvements or additions placed in service (construction begun) before 2025-01-01 and after the enactment of the paragraph";
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "(i) in the case of any facility producing incremental hydropower production, such facility but only to the extent of its incremental hydropower production attributable to efficiency improvements or additions to capacity described in subsection (c)(8)(B) placed in service after the date of the enactment of this paragraph and before January 1, 2025, and")
rule QualifiedIncrementalHydropowerShareRule(facility: Asset, incremental: Decimal, begun: Date, enacted: Date) strict {
    when incremental_hydropower_production_kwh_45(facility, incremental);
    when efficiency_improvement_construction_begin_date_45(facility, begun);
    when enactment_date_of_paragraph_45(D9Hydropower, enacted);
    when begun > enacted;
    when begun < @2025-01-01;
    then qualified_incremental_hydropower_share_45(facility, incremental);
}
pub relation hydropower_credit_period_begin_45(facility: Asset, on: Date) kind institutional {
    label en official "section 45(d)(9)(B): the 10-year period of subsection (a) begins on the date the efficiency improvements or additions to capacity are placed in service";
}
pub relation efficiency_improvement_placed_in_service_date_45(facility: Asset, on: Date) kind empirical {
    label en official "the date the efficiency improvements or additions to capacity are placed in service — case-asserted";
}
@source(IRC_S45_D, relation = formalizes, coverage = exact, quote = "In the case of a qualified facility described in subparagraph (A), the 10-year period referred to in subsection (a) shall be treated as beginning on the date the efficiency improvements or additions to capacity are placed in service.")
rule HydropowerCreditPeriodBeginRule(facility: Asset, on: Date) strict {
    when qualified_incremental_hydropower_share_45(facility, _);
    when efficiency_improvement_placed_in_service_date_45(facility, on);
    then hydropower_credit_period_begin_45(facility, on);
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "(B) which is originally placed in service on or after the date of the enactment of this paragraph and the construction of which begins before January 1, 2025.")
rule QualifiedFacilityMarineRule(facility: Asset, taxpayer: Person, placed: Date, begun: Date, enacted: Date, kw: Decimal) strict {
    when facility_kind_45(facility, MarineAndHydrokineticFacility);
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when facility_placed_in_service_date_45(facility, placed);
    when construction_begin_date_45(facility, begun);
    when enactment_date_of_paragraph_45(D11MarineHydrokinetic, enacted);
    when nameplate_capacity_kw_45(facility, kw);
    when placed >= enacted;
    when begun < @2025-01-01;
    when kw >= 25.0;
    then qualified_facility_45(facility, taxpayer);
}
pub relation new_unit_added_to_qualified_facility_45(facility: Asset) kind empirical {
    label en official "a new unit placed in service after the enactment of the subparagraph in connection with a qualified facility (section 45(d)(2)(B), (3)(B), (7)) — case-asserted";
}
pub relation increased_electricity_by_new_unit_kwh_45(facility: Asset, y: TaxableYear, kwh: Decimal) kind empirical {
    label en official "the increased amount of electricity produced at the facility by reason of the new unit, in kilowatt hours — case-asserted";
}
pub relation new_unit_qualified_kwh_45(facility: Asset, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "section 45(d)(2)(B), (3)(B), (7): the new unit is a qualified facility only to the extent of the increased amount of electricity produced by reason of the new unit (not above the facility's production)";
}
@source(IRC_S45_D, relation = formalizes, coverage = partial, quote = "Such term shall include a new unit placed in service after the date of the enactment of this subparagraph in connection with a facility described in subparagraph (A)(i), but only to the extent of the increased amount of electricity produced at the facility by reason of such new unit.")
rule NewUnitQualifiedKwhRule(facility: Asset, y: TaxableYear, increase: Decimal, total: Decimal) strict {
    when new_unit_added_to_qualified_facility_45(facility);
    when increased_electricity_by_new_unit_kwh_45(facility, y, increase);
    when qualified_energy_resources_electricity_produced(facility, y, total);
    then new_unit_qualified_kwh_45(facility, y, min(increase, total));
}
pub relation lessee_or_operator_of_facility_45(facility: Asset, person: Person) kind empirical {
    label en official "the person is the lessee or the operator of the facility — case-asserted";
}
pub relation owner_produces_the_electricity_45(facility: Asset, owner: Person) kind empirical {
    label en official "the owner of the facility is the producer of the electricity — case-asserted";
}
pub relation person_eligible_for_credit_45(facility: Asset, person: Person) kind institutional {
    label en official "section 45(d)(2)(C)(ii), (3)(C): if the owner of a closed-loop cofiring or open-loop biomass facility is not the producer of the electricity, the person eligible for the credit is the lessee or the operator";
}
@source(IRC_S45_D, relation = formalizes, coverage = exact, quote = "In the case of any facility described in subparagraph (A), if the owner of such facility is not the producer of the electricity, the person eligible for the credit allowable under subsection (a) shall be the lessee or the operator of such facility.")
rule PersonEligibleLesseeOrOperatorRule(facility: Asset, owner: Person, person: Person) strict {
    when owned_and_used_for_electricity_generation(facility, owner);
    when facility_kind_45(facility, OpenLoopBiomassOtherFacility);
    when not_known(owner_produces_the_electricity_45(facility, owner));
    when lessee_or_operator_of_facility_45(facility, person);
    then person_eligible_for_credit_45(facility, person);
}
rule PersonEligibleLesseeOrOperatorLivestockRule(facility: Asset, owner: Person, person: Person) strict {
    when owned_and_used_for_electricity_generation(facility, owner);
    when facility_kind_45(facility, OpenLoopBiomassLivestockFacility);
    when not_known(owner_produces_the_electricity_45(facility, owner));
    when lessee_or_operator_of_facility_45(facility, person);
    then person_eligible_for_credit_45(facility, person);
}
rule PersonEligibleLesseeOrOperatorCofiringRule(facility: Asset, owner: Person, person: Person) strict {
    when owned_and_used_for_electricity_generation(facility, owner);
    when facility_kind_45(facility, ClosedLoopBiomassCofiringModification);
    when not_known(owner_produces_the_electricity_45(facility, owner));
    when lessee_or_operator_of_facility_45(facility, person);
    then person_eligible_for_credit_45(facility, person);
}
pub relation cofiring_credit_period_begin_45(facility: Asset, on: Date) kind institutional {
    label en official "section 45(d)(2)(C)(i): the 10-year period for a cofiring modification facility begins no earlier than the date of the enactment of that clause";
}
pub relation cofiring_period_start_asserted_45(facility: Asset, on: Date) kind empirical {
    label en official "the date the 10-year period would begin under subsection (a) for the cofiring modification facility (its placed-in-service date) — case-asserted";
}
@source(IRC_S45_D, relation = formalizes, coverage = exact, quote = "(i) the 10-year period referred to in subsection (a) shall be treated as beginning no earlier than the date of the enactment of this clause, and")
rule CofiringCreditPeriodBeginLaterRule(facility: Asset, start: Date, enacted: Date) strict {
    when facility_kind_45(facility, ClosedLoopBiomassCofiringModification);
    when cofiring_period_start_asserted_45(facility, start);
    when enactment_date_of_paragraph_45(D2CCofiring, enacted);
    when start >= enacted;
    then cofiring_credit_period_begin_45(facility, start);
}
rule CofiringCreditPeriodBeginEnactmentRule(facility: Asset, start: Date, enacted: Date) strict {
    when facility_kind_45(facility, ClosedLoopBiomassCofiringModification);
    when cofiring_period_start_asserted_45(facility, start);
    when enactment_date_of_paragraph_45(D2CCofiring, enacted);
    when start < enacted;
    then cofiring_credit_period_begin_45(facility, enacted);
}
pub relation refined_coal_production_facility_kind_45(facility: Asset, steel_industry: Boolean) kind empirical {
    label en official "the facility produces refined coal; true when it produces steel industry fuel — case-asserted";
}
pub relation refined_coal_production_facility_45(facility: Asset) kind institutional {
    label en official "section 45(d)(8): a facility producing steel industry fuel placed in service (or modified) before 2010-01-01, or any other refined coal facility placed in service after the enactment of the American Jobs Creation Act of 2004 and before 2012-01-01";
}
@source(IRC_S45_D, relation = formalizes, coverage = exact, quote = "(A) with respect to a facility producing steel industry fuel, any facility (or any modification to a facility) which is placed in service before January 1, 2010, and")
rule RefinedCoalProductionFacilitySteelRule(facility: Asset, placed: Date) strict {
    when refined_coal_production_facility_kind_45(facility, true);
    when facility_placed_in_service_date_45(facility, placed);
    when placed < @2010-01-01;
    then refined_coal_production_facility_45(facility);
}
@source(IRC_S45_D, relation = formalizes, coverage = exact, quote = "(B) with respect to any other facility producing refined coal, any facility placed in service after the date of the enactment of the American Jobs Creation Act of 2004 and before January 1, 2012.")
rule RefinedCoalProductionFacilityOtherRule(facility: Asset, placed: Date, enacted: Date) strict {
    when refined_coal_production_facility_kind_45(facility, false);
    when facility_placed_in_service_date_45(facility, placed);
    when enactment_date_of_paragraph_45(D8AmericanJobsCreationAct2004, enacted);
    when placed > enacted;
    when placed < @2012-01-01;
    then refined_coal_production_facility_45(facility);
}
pub relation indian_coal_production_facility_45(facility: Asset) kind institutional {
    label en official "section 45(d)(10): a facility that produces Indian coal";
}
@source(IRC_S45_D, relation = formalizes, coverage = exact, quote = "The term \"Indian coal production facility\" means a facility that produces Indian coal.")
rule IndianCoalProductionFacilityRule(facility: Asset, coal: Asset) strict {
    when facility_produces_45(facility, coal);
    when indian_coal_45(coal);
    then indian_coal_production_facility_45(facility);
}
pub relation facility_produces_45(facility: Asset, product: Asset) kind empirical {
    label en official "the facility produces the coal or fuel — case-asserted";
}

// --- (e)(1): production within the United States or a possession -----------------------------------------------------------------------------

pub relation electricity_produced_in_united_states_or_possession_45(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the electricity is produced within the United States (section 638(1)) or a possession of the United States (section 638(2)) (section 45(e)(1)) — case-asserted external classification";
}
pub relation sales_taken_into_account_45(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45(e)(1): sales are taken into account only with respect to electricity produced within the United States or a possession";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "Sales shall be taken into account under this section only with respect to electricity the production of which is within—")
rule SalesTakenIntoAccountRule(facility: Asset, y: TaxableYear) strict {
    when electricity_produced_in_united_states_or_possession_45(facility, y);
    then sales_taken_into_account_45(facility, y);
}

// --- (e)(2): the inflation adjustment factor and the reference price -----------------------------------------------------------------------------

pub relation gdp_implicit_price_deflator_45(year: Decimal, value: Decimal) kind empirical {
    label en official "the most recent revision of the implicit price deflator for the gross domestic product as computed and published by the Department of Commerce before March 15 of the calendar year, for the named year (section 45(e)(2)(B)) — case-asserted";
}
pub relation inflation_adjustment_factor_45(year: Decimal, factor: Decimal) kind institutional {
    label en official "section 45(e)(2)(B): the GDP implicit price deflator for the preceding calendar year over the deflator for 1992 (10 decimals HALF_UP judgment call)";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "The term \"inflation adjustment factor\" means, with respect to a calendar year, a fraction the numerator of which is the GDP implicit price deflator for the preceding calendar year and the denominator of which is the GDP implicit price deflator for the calendar year 1992.")
rule InflationAdjustmentFactor45Rule(preceding: Decimal, previous: Decimal, base: Decimal) strict {
    when gdp_implicit_price_deflator_45(preceding, previous);
    when gdp_implicit_price_deflator_45(1992.0, base);
    when base > 0.0;
    then inflation_adjustment_factor_45(preceding + 1.0, div_round(previous, base, 10, "HALF_UP"));
}
pub relation calendar_year_april_first_45(year: Decimal, on: Date) kind empirical {
    label en official "April 1 of the calendar year — calendar helper fact for the Secretary's publication deadline";
}
pub relation factor_and_reference_price_published_45(year: Decimal) kind empirical {
    label en official "the Secretary determined and published in the Federal Register the inflation adjustment factor and the reference price for the calendar year (section 45(e)(2)(A)) — case-asserted";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "The Secretary shall, not later than April 1 of each calendar year, determine and publish in the Federal Register the inflation adjustment factor and the reference price for such calendar year in accordance with this paragraph.")
rule Section45E2ASecretaryPublicationDutyRule(year: Decimal, deadline: Date) strict {
    when calendar_year_april_first_45(year, deadline);
    then duty Section45E2ASecretaryPublicationDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition factor_and_reference_price_published_45(year);
            window [-infinity, deadline];
        }
    };
}

// --- (e)(3)-(4): allocation among owners; related persons -------------------------------------------------------------------------------------------

pub relation ownership_share_of_gross_sales_45(facility: Asset, owner: Person, share: Decimal) kind empirical {
    label en official "the owner's ownership interest in the gross sales from the facility, as a fraction (section 45(e)(3)) — case-asserted";
}
pub relation production_allocated_to_owner_kwh_45(facility: Asset, owner: Person, y: TaxableYear, kwh: Decimal) kind institutional {
    label en official "section 45(e)(3): production from a facility with more than one owner is allocated in proportion to the owners' interests in gross sales (except as provided in regulations)";
}
@source(IRC_S45_E, relation = formalizes, coverage = partial, quote = "In the case of a facility in which more than 1 person has an ownership interest, except to the extent provided in regulations prescribed by the Secretary, production from the facility shall be allocated among such persons in proportion to their respective ownership interests in the gross sales from such facility.")
rule ProductionAllocatedToOwnerRule(facility: Asset, owner: Person, y: TaxableYear, total: Decimal, share: Decimal) strict {
    when qualified_energy_resources_electricity_produced(facility, y, total);
    when ownership_share_of_gross_sales_45(facility, owner, share);
    then production_allocated_to_owner_kwh_45(facility, owner, y, total * share);
}
pub relation persons_related_45(a: Person, b: Person, y: TaxableYear) kind institutional {
    label en official "section 45(e)(4): persons are related if they would be treated as a single employer under the section 52(b) regulations";
}
@source(IRC_S45_E, relation = formalizes, coverage = partial, quote = "Persons shall be treated as related to each other if such persons would be treated as a single employer under the regulations prescribed under section 52(b).")
rule PersonsRelatedRule(a: Person, b: Person, y: TaxableYear, group: ControlledGroup) strict {
    when under_common_control_52b(group, a, y);
    when under_common_control_52b(group, b, y);
    then persons_related_45(a, b, y);
}
pub relation consolidated_group_member_45(corp: Person, group: Person) kind empirical {
    label en official "the corporation is a member of an affiliated group of corporations filing a consolidated return (section 45(e)(4)) — case-asserted";
}
pub relation electricity_sold_by_member_to_unrelated_person_45(seller: Person, buyer: Person) kind empirical {
    label en official "the electricity is sold to the buyer by another member of the consolidated group — case-asserted";
}
pub relation treated_as_selling_to_unrelated_person_45(corp: Person, buyer: Person) kind institutional {
    label en official "section 45(e)(4), last sentence: a corporation in a consolidated group is treated as selling electricity to an unrelated person if another member of the group sells it to that person";
}
rule TreatedAsSellingToUnrelatedPersonRule(corp: Person, group: Person, seller: Person, buyer: Person) strict {
    when consolidated_group_member_45(corp, group);
    when consolidated_group_member_45(seller, group);
    when electricity_sold_by_member_to_unrelated_person_45(seller, buyer);
    then treated_as_selling_to_unrelated_person_45(corp, buyer);
}

// --- (e)(7): wind facilities selling to utilities under pre-1987 contracts ---------------------------------------------------------------------

pub relation contract_with_utility_originally_entered_before_1987_45(facility: Asset) kind empirical {
    label en official "the electricity is sold to a utility pursuant to a contract originally entered into before January 1, 1987 (whether or not amended or restated after that date) (section 45(e)(7)(A)(ii)) — case-asserted";
}
pub relation amendment_establishes_prices_and_caps_excess_quantities_45(facility: Asset) kind empirical {
    label en official "the prices are established pursuant to an amendment providing that contract prices above avoided cost prices apply only to annual quantities not above the greater of the 1994-1998 average annual quantity and the contract estimate (or greatest 1996-1998 quantity), (section 45(e)(7)(B)(i)-(ii)) — case-asserted";
}
pub relation excess_energy_sold_only_at_avoided_cost_or_to_third_party_45(facility: Asset) kind empirical {
    label en official "the amendment provides that energy and capacity above the limit may be sold to the utility only at prices not above avoided cost, or to a third party on mutually agreed advance notice (section 45(e)(7)(B)(iii)) — case-asserted";
}
pub relation electricity_excluded_by_e7_45(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45(e)(7)(A): the credit does not apply to electricity produced at a wind facility placed in service after June 30, 1999 and sold to a utility under a pre-1987 contract, unless the (B) amendment conditions are met";
}
@source(IRC_S45_E, relation = formalizes, coverage = partial, quote = "The credit determined under subsection (a) shall not apply to electricity—")
rule ElectricityExcludedByE7Rule(facility: Asset, y: TaxableYear, placed: Date) defeasible {
    when facility_kind_45(facility, WindFacility);
    when facility_placed_in_service_date_45(facility, placed);
    when placed > @1999-06-30;
    when contract_with_utility_originally_entered_before_1987_45(facility);
    when qualified_energy_resources_electricity_produced(facility, y, _);
    then electricity_excluded_by_e7_45(facility, y);
    unless amendment_establishes_prices_and_caps_excess_quantities_45(facility)
        and excess_energy_sold_only_at_avoided_cost_or_to_third_party_45(facility)
        and qualified_energy_resources_electricity_produced(facility, y, _);
}

// --- (e)(8): the refined coal increase ------------------------------------------------------------------------------------------------------------------

pub relation qualified_refined_coal_tons_45(facility: Asset, y: TaxableYear, tons: Decimal) kind empirical {
    label en official "the tons of qualified refined coal produced by the taxpayer at a refined coal production facility during the 10-year period beginning on the date the facility was originally placed in service and sold by the taxpayer to an unrelated person during that period and the taxable year (section 45(e)(8)(A)) — case-asserted";
}
pub relation feedstock_reference_price_per_ton_45(y: TaxableYear, price: Money) kind empirical {
    label en official "the reference price of the fuel used as a feedstock (section 45(c)(7)(A)) for the calendar year in which the sale occurs (section 45(e)(8)(B)(i)) — case-asserted (the Secretary's determination)";
}
pub relation feedstock_reference_price_2002_per_ton_45(price: Money) kind empirical {
    label en official "the reference price for such fuel in 2002 (section 45(e)(8)(B)(i)) — case-asserted";
}
pub relation refined_coal_increase_before_reduction_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45(e)(8)(A): $4.375 per ton of qualified refined coal";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "In the case of a producer of refined coal, the credit determined under this section (without regard to this paragraph) for any taxable year shall be increased by an amount equal to $4.375 per ton of qualified refined coal—")
rule RefinedCoalIncreaseBeforeReductionRule(facility: Asset, y: TaxableYear, tons: Decimal) strict {
    when refined_coal_production_facility_45(facility);
    when qualified_refined_coal_tons_45(facility, y, tons);
    when not_known(refined_coal_facility_is_steel_industry_45(facility));
    then refined_coal_increase_before_reduction_45(facility, y, round(tons * 4.375 USD, 2, "HALF_UP"));
}
relation refined_coal_facility_is_steel_industry_45(facility: Asset) kind institutional;
rule RefinedCoalFacilityIsSteelIndustryRule(facility: Asset) strict {
    when refined_coal_production_facility_kind_45(facility, true);
    then refined_coal_facility_is_steel_industry_45(facility);
}
pub relation refined_coal_increase_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45(e)(8)(A)-(B): the increase reduced by the ratio of the excess of the feedstock reference price over 1.7 times the 2002 reference price to $8.75 (not below zero)";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "The amount of the increase determined under subparagraph (A) shall be reduced by an amount which bears the same ratio to the amount of the increase (determined without regard to this subparagraph) as—")
rule RefinedCoalIncreaseReducedRule(facility: Asset, y: TaxableYear, increase: Money, price: Money, base: Money) strict {
    when refined_coal_increase_before_reduction_45(facility, y, increase);
    when feedstock_reference_price_per_ton_45(y, price);
    when feedstock_reference_price_2002_per_ton_45(base);
    when price > 1.70 * base;
    // excess / 8.75: the reduction is increase x (price - 1.7 x base) / 8.75, cents HALF_UP; the increase is not below zero.
    then refined_coal_increase_45(facility, y, max(increase - div_round(increase * ((price - 1.70 * base) / 1.00 USD), 8.75, 2, "HALF_UP"), 0 USD));
}
rule RefinedCoalIncreaseNotReducedRule(facility: Asset, y: TaxableYear, increase: Money, price: Money, base: Money) strict {
    when refined_coal_increase_before_reduction_45(facility, y, increase);
    when feedstock_reference_price_per_ton_45(y, price);
    when feedstock_reference_price_2002_per_ton_45(base);
    when price <= 1.70 * base;
    then refined_coal_increase_45(facility, y, increase);
}
pub relation steel_industry_boe_45(facility: Asset, y: TaxableYear, btus: Decimal) kind empirical {
    label en official "the Btu content of the steel industry fuel produced and sold in the year (section 45(e)(8)(D)(iv)) — case-asserted";
}
pub relation steel_industry_fuel_increase_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45(e)(8)(D)(ii)(I), (iii), (iv): $2 per barrel-of-oil equivalent (5,800,000 Btus) of steel industry fuel; subparagraph (B) does not apply";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall be applied by substituting \"$2 per barrel-of-oil equivalent\" for \"$4.375 per ton\".")
rule SteelIndustryFuelIncreaseRule(facility: Asset, y: TaxableYear, btus: Decimal) strict {
    when refined_coal_production_facility_45(facility);
    when refined_coal_facility_is_steel_industry_45(facility);
    when steel_industry_boe_45(facility, y, btus);
    then steel_industry_fuel_increase_45(facility, y, round(div_round(btus, 5800000.0, 10, "HALF_UP") * 2.00 USD, 2, "HALF_UP"));
}
pub relation steel_industry_credit_period_45(facility: Asset, start: Date, finish: Date) kind institutional {
    label en official "section 45(e)(8)(D)(ii)(II): for steel industry fuel the credit period begins on the later of the date the facility (or its steel-fuel modifications) was placed in service and 2008-10-01 and ends on the later of 2009-12-31 and 1 year after that placement";
}
pub relation steel_facility_or_modification_placed_in_service_date_45(facility: Asset, on: Date) kind empirical {
    label en official "the date the steel industry fuel facility (or the modification allowing it to produce steel industry fuel) was originally placed in service — case-asserted";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "In lieu of the 10-year period referred to in clauses (i) and (ii)(II) of subparagraph (A), the credit period shall be the period beginning on the later of the date such facility was originally placed in service, the date the modifications described in clause (iii) were placed in service, or October 1, 2008, and ending on the later of December 31, 2009, or the date which is 1 year after the date such facility or the modifications described in clause (iii) were placed in service.")
rule SteelIndustryCreditPeriodLaterPlacedRule(facility: Asset, placed: Date) strict {
    when refined_coal_facility_is_steel_industry_45(facility);
    when steel_facility_or_modification_placed_in_service_date_45(facility, placed);
    when placed >= @2008-10-01;
    when add_calendar_period(placed, 12 calendar_month) >= @2009-12-31;
    then steel_industry_credit_period_45(facility, placed, add_calendar_period(placed, 12 calendar_month));
}
rule SteelIndustryCreditPeriodEarlyPlacedRule(facility: Asset, placed: Date) strict {
    when refined_coal_facility_is_steel_industry_45(facility);
    when steel_facility_or_modification_placed_in_service_date_45(facility, placed);
    when placed < @2008-10-01;
    when add_calendar_period(placed, 12 calendar_month) < @2009-12-31;
    then steel_industry_credit_period_45(facility, @2008-10-01, @2009-12-31);
}
rule SteelIndustryCreditPeriodEarlyStartLateEndRule(facility: Asset, placed: Date) strict {
    when refined_coal_facility_is_steel_industry_45(facility);
    when steel_facility_or_modification_placed_in_service_date_45(facility, placed);
    when placed < @2008-10-01;
    when add_calendar_period(placed, 12 calendar_month) >= @2009-12-31;
    then steel_industry_credit_period_45(facility, @2008-10-01, add_calendar_period(placed, 12 calendar_month));
}
rule SteelIndustryCreditPeriodLateStartEarlyEndRule(facility: Asset, placed: Date) strict {
    when refined_coal_facility_is_steel_industry_45(facility);
    when steel_facility_or_modification_placed_in_service_date_45(facility, placed);
    when placed >= @2008-10-01;
    when add_calendar_period(placed, 12 calendar_month) < @2009-12-31;
    then steel_industry_credit_period_45(facility, placed, @2009-12-31);
}

// --- (e)(9), (e)(12): no double credit ---------------------------------------------------------------------------------------------------------------

pub relation qualified_facility_excluded_by_e9_e12_45(facility: Asset) kind institutional {
    label en official "section 45(e)(9)(A), (e)(12): the facility does not qualify if the landfill gas comes from a facility with a section 45K credit, or the gas is from qualified biogas property with a section 48 credit";
}
rule QualifiedFacilityExcludedByE9LandfillRule(facility: Asset) strict {
    when landfill_gas_from_facility_with_45k_credit_45(facility);
    then qualified_facility_excluded_by_e9_e12_45(facility);
}
rule QualifiedFacilityExcludedByE12BiogasRule(facility: Asset) strict {
    when biogas_property_with_48_credit_45(facility);
    then qualified_facility_excluded_by_e9_e12_45(facility);
}
pub relation refined_coal_facility_with_45k_credit_45(facility: Asset) kind empirical {
    label en official "the production from the refined coal facility is allowed as a credit under section 45K (or under former section 29) for the taxable year or a prior year (section 45(e)(9)(B)(i)) — case-asserted";
}
pub relation refined_coal_production_facility_after_e9_45(facility: Asset) kind institutional {
    label en official "section 45(e)(9)(B): a refined coal production facility whose production is allowed a section 45K (or former section 29) credit is excluded, except for the steel industry fuel part of the refined coal";
}
rule RefinedCoalProductionFacilityAfterE9Rule(facility: Asset) strict {
    when refined_coal_production_facility_45(facility);
    when not_known(refined_coal_facility_with_45k_credit_45(facility));
    then refined_coal_production_facility_after_e9_45(facility);
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "In the case of a facility producing steel industry fuel, clause (i) shall not apply to so much of the refined coal produced at such facility as is steel industry fuel.")
rule RefinedCoalProductionFacilityAfterE9SteelRule(facility: Asset) strict {
    when refined_coal_production_facility_45(facility);
    when refined_coal_facility_is_steel_industry_45(facility);
    then refined_coal_production_facility_after_e9_45(facility);
}

// --- (e)(10): Indian coal increase ------------------------------------------------------------------------------------------------------------------------

pub relation indian_coal_tons_sold_45(facility: Asset, y: TaxableYear, tons: Decimal) kind empirical {
    label en official "the tons of Indian coal produced by the taxpayer at an Indian coal production facility during the 16-year period beginning on 2006-01-01 and sold to an unrelated person (directly or after transfer to related persons) during that period and the taxable year (section 45(e)(10)(A)) — case-asserted";
}
pub relation calendar_year_of_taxable_year_45(y: TaxableYear, year: Decimal) kind empirical {
    label en official "the calendar year in which the taxable year begins — calendar helper fact";
}
pub relation indian_coal_applicable_dollar_amount_45(year: Decimal, amount: Money) kind institutional {
    label en official "section 45(e)(10)(B)(i): $1.50 for calendar years 2006 through 2009 and $2.00 for later years (before the inflation adjustment of clause (ii))";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "(I) $1.50 in the case of calendar years 2006 through 2009, and")
rule IndianCoalDollarAmount2006To2009Rule(year: Decimal) strict {
    when calendar_year_of_taxable_year_45(_, year);
    when year >= 2006.0;
    when year <= 2009.0;
    then indian_coal_applicable_dollar_amount_45(year, 1.50 USD);
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "(II) $2.00 in the case of calendar years beginning after 2009.")
rule IndianCoalDollarAmountAfter2009Rule(year: Decimal) strict {
    when calendar_year_of_taxable_year_45(_, year);
    when year > 2009.0;
    then indian_coal_applicable_dollar_amount_45(year, 2.00 USD);
}
pub relation indian_coal_increase_45(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45(e)(10): the applicable dollar amount per ton of Indian coal, for calendar years after 2006 multiplied by the inflation adjustment factor with 2005 as the base year (cents HALF_UP judgment call)";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "In the case of any calendar year after 2006, each of the dollar amounts under clause (i) shall be equal to the product of such dollar amount and the inflation adjustment factor determined under paragraph (2)(B) for the calendar year, except that such paragraph shall be applied by substituting \"2005\" for \"1992\".")
rule IndianCoalIncreaseAfter2006Rule(facility: Asset, y: TaxableYear, tons: Decimal, year: Decimal, dollars: Money, previous: Decimal, base: Decimal) strict {
    when indian_coal_production_facility_45(facility);
    when indian_coal_tons_sold_45(facility, y, tons);
    when calendar_year_of_taxable_year_45(y, year);
    when year > 2006.0;
    when indian_coal_applicable_dollar_amount_45(year, dollars);
    when gdp_implicit_price_deflator_45(year - 1.0, previous);
    when gdp_implicit_price_deflator_45(2005.0, base);
    when base > 0.0;
    then indian_coal_increase_45(facility, y, round(tons * div_round(previous, base, 10, "HALF_UP") * dollars, 2, "HALF_UP"));
}
rule IndianCoalIncrease2006Rule(facility: Asset, y: TaxableYear, tons: Decimal, year: Decimal, dollars: Money) strict {
    when indian_coal_production_facility_45(facility);
    when indian_coal_tons_sold_45(facility, y, tons);
    when calendar_year_of_taxable_year_45(y, year);
    when year <= 2006.0;
    when indian_coal_applicable_dollar_amount_45(year, dollars);
    then indian_coal_increase_45(facility, y, round(tons * dollars, 2, "HALF_UP"));
}

// --- (e)(11): cooperative apportionment to patrons ------------------------------------------------------------------------------------------------------

pub relation owned_more_than_half_by_agricultural_producers_45(coop: Person) kind empirical {
    label en official "the cooperative organization described in section 1381(a) is owned more than 50 percent by agricultural producers or by entities owned by agricultural producers (an entity owned by an agricultural producer is one more than 50 percent owned by agricultural producers) (section 45(e)(11)(D)) — case-asserted";
}
pub relation cooperative_described_in_1381a_45(coop: Person) kind empirical {
    label en official "the organization is a cooperative organization described in section 1381(a) — case-asserted";
}
pub relation eligible_cooperative_45(coop: Person) kind institutional {
    label en official "section 45(e)(11)(D): a section 1381(a) cooperative owned more than 50 percent by agricultural producers or by entities they own";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "For purposes of this section the term \"eligible cooperative\" means a cooperative organization described in section 1381(a) which is owned more than 50 percent by agricultural producers or by entities owned by agricultural producers.")
rule EligibleCooperativeRule(coop: Person) strict {
    when cooperative_described_in_1381a_45(coop);
    when owned_more_than_half_by_agricultural_producers_45(coop);
    then eligible_cooperative_45(coop);
}
pub relation elects_to_apportion_credit_to_patrons_45(coop: Person, y: TaxableYear) kind empirical {
    label en official "the eligible cooperative organization's exercise of the section 45(e)(11)(A) election to apportion any portion of the credit among patrons on the basis of the business done by the patrons";
}
pub relation timely_filed_return_and_written_notice_to_patrons_45(coop: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely filed return and the cooperative designates the apportionment as such in a written notice mailed to its patrons during the payment period of section 1382(d) (section 45(e)(11)(A)(ii)) — case-asserted";
}
pub relation apportionment_to_patrons_effective_45(coop: Person, y: TaxableYear) kind institutional {
    label en official "section 45(e)(11)(A): the apportionment among patrons takes effect (a valid, irrevocable election with the timely designated notice)";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "In the case of an eligible cooperative organization, any portion of the credit determined under subsection (a) for the taxable year may, at the election of the organization, be apportioned among patrons of the organization on the basis of the amount of business done by the patrons during the taxable year.")
rule Section45E11AElectionRule(coop: Person, y: TaxableYear) defeasible {
    when eligible_cooperative_45(coop);
    when timely_filed_return_and_written_notice_to_patrons_45(coop, y);
    then power Section45E11AApportionmentElection {
        holder coop;
        over coop;
        exercise elects_to_apportion_credit_to_patrons_45(coop, y);
        valid_when timely_filed_return_and_written_notice_to_patrons_45(coop, y);
        effect create(apportionment_to_patrons_effective_45(coop, y));
        window [@2005-08-08, infinity);
    };
}
pub relation cooperative_credit_apportioned_45(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the credit determined under subsection (a) that the cooperative apportions among its patrons — case-asserted";
}
pub relation business_done_by_patron_45(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of business done by the patron with the cooperative during the taxable year — case-asserted";
}
pub relation total_business_done_45(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total business done with the cooperative's patrons during the taxable year — case-asserted";
}
pub relation credit_apportioned_to_patron_45(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45(e)(11)(A), (B): the apportioned credit goes to each patron on the basis of business done; it is excluded from the cooperative's credit and included in the patron's credit for its first taxable year ending on or after the end of the payment period (or the notice date, if earlier)";
}
@source(IRC_S45_E, relation = formalizes, coverage = partial, quote = "(ii) shall be included in the amount determined under subsection (a) for the first taxable year of each patron ending on or after the last day of the payment period (as defined in section 1382(d)) for the taxable year of the organization")
rule CreditApportionedToPatronRule(coop: Person, patron: Person, y: TaxableYear, apportioned: Money, done: Money, total: Money) strict {
    when apportionment_to_patrons_effective_45(coop, y);
    when cooperative_credit_apportioned_45(coop, y, apportioned);
    when business_done_by_patron_45(coop, patron, y, done);
    when total_business_done_45(coop, y, total);
    when total > 0 USD;
    // JUDGMENT CALL: cents HALF_UP.
    then credit_apportioned_to_patron_45(coop, patron, y, div_round(apportioned * (done / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation cooperative_credit_determined_45(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit of the cooperative determined under subsection (a) for the year, as finally determined — case-asserted";
}
pub relation cooperative_credit_shown_on_return_45(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit shown on the cooperative's return for the year — case-asserted";
}
pub relation cooperative_credit_not_apportioned_45(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount not apportioned to patrons under subparagraph (A) for the year — case-asserted";
}
pub relation cooperative_tax_increase_for_excess_reduction_45(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45(e)(11)(C): if the credit determined is less than the credit shown on the return, the excess of the reduction over the amount not apportioned to patrons is treated as an increase in tax (not a tax imposed by chapter 1 for the purpose of any credit)";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "If the amount of the credit of a cooperative organization determined under subsection (a) for a taxable year is less than the amount of such credit shown on the return of the cooperative organization for such year, an amount equal to the excess of—")
rule CooperativeTaxIncreaseForExcessReductionRule(coop: Person, y: TaxableYear, determined: Money, shown: Money, unapportioned: Money) strict {
    when cooperative_credit_determined_45(coop, y, determined);
    when cooperative_credit_shown_on_return_45(coop, y, shown);
    when cooperative_credit_not_apportioned_45(coop, y, unapportioned);
    when shown - determined > unapportioned;
    then cooperative_tax_increase_for_excess_reduction_45(coop, y, shown - determined - unapportioned);
}

// --- (e)(13): electricity used for hydrogen production ----------------------------------------------------------------------------------------------------------

pub relation electricity_used_at_clean_hydrogen_facility_by_taxpayer_or_related_45(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the electricity is used during the taxable year by the taxpayer or a related person at a qualified clean hydrogen production facility (section 45V(c)(3)) to produce qualified clean hydrogen (section 45V(c)(2)) (section 45(e)(13)(A)) — case-asserted";
}
pub relation hydrogen_use_and_production_verified_by_unrelated_third_party_45(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the use and production are verified, in the form and manner the Secretary prescribes, by an unrelated third party (section 45(e)(13)(B)) — case-asserted";
}
pub relation electricity_treated_as_sold_to_unrelated_person_45(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45(e)(13): electricity used at a qualified clean hydrogen production facility by the taxpayer or a related person, verified by an unrelated third party, is treated as sold to an unrelated person";
}
@source(IRC_S45_E, relation = formalizes, coverage = exact, quote = "Electricity produced by the taxpayer shall be treated as sold by such taxpayer to an unrelated person during the taxable year if—")
rule ElectricityTreatedAsSoldToUnrelatedPersonRule(facility: Asset, y: TaxableYear) strict {
    when electricity_used_at_clean_hydrogen_facility_by_taxpayer_or_related_45(facility, y);
    when hydrogen_use_and_production_verified_by_unrelated_third_party_45(facility, y);
    then electricity_treated_as_sold_to_unrelated_person_45(facility, y);
}
