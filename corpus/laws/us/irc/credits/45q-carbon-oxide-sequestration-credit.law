// Section 45Q — Credit for carbon oxide sequestration. Stage 2d (IRC-06,
// DECISION-0379).
//
// Editions by `legal_time` (`effective` windows; PL 119-21 section 70522 is
// pinned as `us.irc.temporal::PL119_21_S70522`, enacted 2025-07-04; windows
// instead of a `revision` because the temporal package pins the Public Law as
// separate fragments):
//   * base text: post-2018 equipment earns $17 per ton for geological storage
//     and $12 for enhanced recovery or utilization ($36 / $26 for direct air
//     capture facilities placed in service after 2022), indexed after 2026;
//   * from 2025-07-04, for equipment placed in service after enactment: parity,
//     the utilization amount equals the geological amount ($17 / $36); no
//     credit for a specified foreign entity for a taxable year beginning after
//     enactment, nor for a foreign-influenced entity two years later.
//
// Scope / judgment calls:
// * (a)(1)-(2): equipment placed in service before the Bipartisan Budget Act of
//   2018: $20 / $10 per ton (indexed by the (f)(7) factor, 2008 base) for
//   capture before 2023-01-01 (the (g) national-cap year is not modelled).
//   (a)(3)-(4): post-2018 equipment: the (b)(1) applicable dollar amount for
//   the 12 years after the equipment is placed in service, x 5 under (h) when
//   the wage and apprenticeship requirements are satisfied, rounded to the
//   cent.
// * (d): the qualified facility thresholds are computed from asserted tons:
//   1,000 tons (direct air capture), 18,750 tons and 75 percent capture design
//   capacity (electricity generating), 12,500 tons (other).
// * Tons captured, stored and used are case facts per equipment; the rest of
//   the section is recorded in TECH-GAPS G1777.

use self::{
    Asset,
    IRC_S45Q_A,
    IRC_S45Q_B,
    IRC_S45Q_D,
    IRC_S45Q_F,
    IRC_S45Q_G,
    IRC_S45Q_H,
    Person,
    TaxableYear,
    has_reduction_fraction_45b3,
    reduction_fraction_45b3,
};

pub enum FacilityKind45Q {
    DirectAirCapture,
    ElectricityGenerating,
    OtherIndustrial,
}
pub enum Use45Q {
    GeologicalStorage,
    EnhancedRecoveryOrUtilization,
}

pub relation bba_2018_enacted_on_45q(on: Date) kind empirical {
    label en official "the date of enactment of the Bipartisan Budget Act of 2018 (the reference date of section 45Q(a), (d)) — case-asserted from the pinned Public Law note";
}
pub relation section_119_21_enacted_on_45q(on: Date) kind empirical {
    label en official "the date of enactment of PL 119-21 (2025-07-04), the reference date of the parity and foreign-entity amendments — case-asserted";
}
pub relation equipment_at_facility_45q(equipment: Asset, facility: Asset) kind empirical {
    label en official "the carbon capture equipment is installed at the qualified facility — case-asserted";
}
pub relation equipment_placed_in_service_on_45q(equipment: Asset, on: Date) kind empirical {
    label en official "the date the carbon capture equipment is originally placed in service — case-asserted";
}
pub relation facility_kind_45q(facility: Asset, kind: FacilityKind45Q) kind empirical {
    label en official "the facility is a direct air capture facility, an electricity generating facility, or another industrial facility (section 45Q(d)(2)) — case-asserted";
}
pub relation facility_construction_begins_on_45q(facility: Asset, on: Date) kind empirical {
    label en official "the date construction of the facility begins (section 45Q(d)(1)) — case-asserted";
}
pub relation capture_equipment_construction_or_planning_before_2033_45q(facility: Asset) kind empirical {
    label en official "construction of carbon capture equipment begins before 2033-01-01, or the original planning and design of the facility includes installation of carbon capture equipment (section 45Q(d)(1)(A)-(B)) — case-asserted";
}
pub relation facility_tons_captured_45q(facility: Asset, y: TaxableYear, tons: Decimal) kind empirical {
    label en official "metric tons of qualified carbon oxide captured at the facility during the taxable year (section 45Q(d)(2)) — case-asserted";
}
pub relation capture_design_capacity_percent_45q(facility: Asset, percent: Decimal) kind empirical {
    label en official "the capture design capacity of the carbon capture equipment of an electricity generating facility as a percentage of the baseline carbon oxide production of the applicable unit (section 45Q(d)(2)(B)(ii)) — case-asserted";
}
pub relation tons_45q(taxpayer: Person, equipment: Asset, y: TaxableYear, use: Use45Q, tons: Decimal) kind empirical {
    label en official "metric tons of qualified carbon oxide captured by the taxpayer with the equipment during the taxable year and disposed of in secure geological storage (not otherwise used), or used as a tertiary injectant and disposed of, or utilized (section 45Q(a)) — case-asserted";
}
pub relation capture_date_45q(equipment: Asset, y: TaxableYear, on: Date) kind empirical {
    label en official "a date in the taxable year on which carbon oxide is captured with the equipment (for the 12-year period test) — case-asserted";
}
pub relation qualified_carbon_oxide_measured_and_verified_45q(taxpayer: Person, equipment: Asset, y: TaxableYear) kind empirical {
    label en official "the carbon oxide is captured from an industrial source or directly from the air, would otherwise be released, is measured at the source and verified at the point of disposal, injection or utilization, and its capture and disposal or use is within the United States or a possession (sections 45Q(c)(1), (f)(1)) — case-asserted";
}
pub relation inflation_adjustment_factor_45q(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor of section 43(b)(3)(B) with 2025 substituted for 1990 (section 45Q(b)(1)(A)(ii)) and, for pre-2018 equipment, with 2008 substituted (section 45Q(f)(7)) — case-asserted, not pinned";
}
pub relation prevailing_wage_and_apprenticeship_satisfied_45q(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the section 45Q(h)(2) requirements (prevailing wage under (3)(A), apprenticeship under (4), or the grandfathered construction start) are satisfied — case-asserted";
}
pub relation specified_foreign_entity_45q(taxpayer: Person) kind empirical {
    label en official "the taxpayer is a specified foreign entity as defined in section 7701(a)(51)(B) — case-asserted";
}
pub relation foreign_influenced_entity_45q(taxpayer: Person) kind empirical {
    label en official "the taxpayer is a foreign-influenced entity as defined in section 7701(a)(51)(D), without regard to clause (i)(II) — case-asserted";
}

// --- (d): qualified facility ---------------------------------------------------------------------------------------------------------

pub relation qualified_facility_45q(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Q(d): an industrial or direct air capture facility whose construction begins before 2033 and that meets the capture threshold of its kind";
}
@source(IRC_S45Q_D, quote = "captures not less than 1,000 metric tons of qualified carbon oxide during the taxable year")
rule QualifiedFacilityDirectAirCapture45qRule(facility: Asset, y: TaxableYear, begins: Date, tons: Decimal) strict {
    when facility_kind_45q(facility, DirectAirCapture);
    when facility_construction_begins_on_45q(facility, begins);
    when begins < @2033-01-01;
    when capture_equipment_construction_or_planning_before_2033_45q(facility);
    when facility_tons_captured_45q(facility, y, tons);
    when tons >= 1000.0;
    then qualified_facility_45q(facility, y);
}
@source(IRC_S45Q_D, quote = "captures not less than 18,750 metric tons of qualified carbon oxide during the taxable year")
rule QualifiedFacilityElectricity45qRule(facility: Asset, y: TaxableYear, begins: Date, tons: Decimal, capacity: Decimal) strict {
    when facility_kind_45q(facility, ElectricityGenerating);
    when facility_construction_begins_on_45q(facility, begins);
    when begins < @2033-01-01;
    when capture_equipment_construction_or_planning_before_2033_45q(facility);
    when facility_tons_captured_45q(facility, y, tons);
    when tons >= 18750.0;
    when capture_design_capacity_percent_45q(facility, capacity);
    when capacity >= 75.0;
    then qualified_facility_45q(facility, y);
}
@source(IRC_S45Q_D, quote = "captures not less than 12,500 metric tons of qualified carbon oxide during the taxable year")
rule QualifiedFacilityOther45qRule(facility: Asset, y: TaxableYear, begins: Date, tons: Decimal) strict {
    when facility_kind_45q(facility, OtherIndustrial);
    when facility_construction_begins_on_45q(facility, begins);
    when begins < @2033-01-01;
    when capture_equipment_construction_or_planning_before_2033_45q(facility);
    when facility_tons_captured_45q(facility, y, tons);
    when tons >= 12500.0;
    then qualified_facility_45q(facility, y);
}

// --- (a): periods --------------------------------------------------------------------------------------------------------------------------------

relation post_bba_equipment_45q(equipment: Asset) kind institutional;
rule PostBbaEquipment45qRule(equipment: Asset, placed: Date, bba: Date) strict {
    when equipment_placed_in_service_on_45q(equipment, placed);
    when bba_2018_enacted_on_45q(bba);
    when placed >= bba;
    then post_bba_equipment_45q(equipment);
}
relation pre_bba_equipment_45q(equipment: Asset) kind institutional;
rule PreBbaEquipment45qRule(equipment: Asset, placed: Date, bba: Date) strict {
    when equipment_placed_in_service_on_45q(equipment, placed);
    when bba_2018_enacted_on_45q(bba);
    when placed < bba;
    then pre_bba_equipment_45q(equipment);
}
pub relation within_credit_period_45q(equipment: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Q(a)(3)-(4): the capture is within the 12-year period beginning on the date the post-2018 equipment was originally placed in service; (g): pre-2018 equipment captures before 2023-01-01";
}
@source(IRC_S45Q_A, quote = "during the 12-year period beginning on the date the equipment was originally placed in service")
rule WithinCreditPeriodPostBba45qRule(equipment: Asset, y: TaxableYear, placed: Date, captured: Date) strict {
    when post_bba_equipment_45q(equipment);
    when equipment_placed_in_service_on_45q(equipment, placed);
    when capture_date_45q(equipment, y, captured);
    when captured >= placed;
    when captured < add_calendar_period(placed, 144 calendar_month);
    then within_credit_period_45q(equipment, y);
}
@source(IRC_S45Q_G, quote = "the credit under this section shall apply with respect to qualified carbon oxide captured using such equipment before the earlier of January 1, 2023")
rule WithinCreditPeriodPreBba45qRule(equipment: Asset, y: TaxableYear, captured: Date) strict {
    when pre_bba_equipment_45q(equipment);
    when capture_date_45q(equipment, y, captured);
    when captured < @2023-01-01;
    then within_credit_period_45q(equipment, y);
}

// --- (b)(1): the applicable dollar amounts ----------------------------------------------------------------------------------------------

relation higher_dac_amounts_45q(equipment: Asset) kind institutional;
@source(IRC_S45Q_B, quote = "In the case of any qualified facility described in subsection (d)(2)(A) which is placed in service after December 31, 2022")
rule HigherDacAmounts45qRule(equipment: Asset, facility: Asset, placed: Date) strict {
    when equipment_at_facility_45q(equipment, facility);
    when facility_kind_45q(facility, DirectAirCapture);
    when equipment_placed_in_service_on_45q(equipment, placed);
    when placed > @2022-12-31;
    then higher_dac_amounts_45q(equipment);
}
relation utilization_parity_45q(equipment: Asset) kind institutional;
@source(us.irc.temporal::PL119_21_S70522, quote = "The amendments made subsections (b) and (c) shall apply to facilities or equipment placed in service after the date of enactment of this Act.")
rule UtilizationParity45qRule(equipment: Asset, placed: Date, enacted: Date) strict {
    effective [@2025-07-04, infinity);
    when equipment_placed_in_service_on_45q(equipment, placed);
    when section_119_21_enacted_on_45q(enacted);
    when placed > enacted;
    then utilization_parity_45q(equipment);
}
relation geological_base_dollars_45q(equipment: Asset, dollars: Decimal) kind institutional;
relation utilization_base_dollars_45q(equipment: Asset, dollars: Decimal) kind institutional;
@source(IRC_S45Q_B, quote = "for purposes of paragraph (3) of subsection (a), $17")
rule BaseDollarsGeological45qRule(equipment: Asset) strict {
    when post_bba_equipment_45q(equipment);
    when not_known(higher_dac_amounts_45q(equipment));
    then geological_base_dollars_45q(equipment, 17.0);
}
@source(IRC_S45Q_B, quote = "(i) by substituting \"$36\" for \"$17\" each place it appears")
rule BaseDollarsGeologicalDac45qRule(equipment: Asset) strict {
    when post_bba_equipment_45q(equipment);
    when higher_dac_amounts_45q(equipment);
    then geological_base_dollars_45q(equipment, 36.0);
}
@source(IRC_S45Q_B, quote = "for purposes of paragraph (4) of such subsection, $12")
rule BaseDollarsUtilization45qRule(equipment: Asset) strict {
    when post_bba_equipment_45q(equipment);
    when not_known(higher_dac_amounts_45q(equipment));
    when not_known(utilization_parity_45q(equipment));
    then utilization_base_dollars_45q(equipment, 12.0);
}
@source(IRC_S45Q_B, quote = "(ii) by substituting \"$26\" for \"$12\" each place it appears")
rule BaseDollarsUtilizationDac45qRule(equipment: Asset) strict {
    when post_bba_equipment_45q(equipment);
    when higher_dac_amounts_45q(equipment);
    when not_known(utilization_parity_45q(equipment));
    then utilization_base_dollars_45q(equipment, 26.0);
}
rule BaseDollarsUtilizationParity45qRule(equipment: Asset, dollars: Decimal) strict {
    when utilization_parity_45q(equipment);
    when geological_base_dollars_45q(equipment, dollars);
    then utilization_base_dollars_45q(equipment, dollars);
}
pub relation base_dollars_45q(equipment: Asset, use: Use45Q, dollars: Decimal) kind institutional {
    label en official "section 45Q(b)(1): $17 (geological storage) / $12 (enhanced recovery or utilization); $36 / $26 for a direct air capture facility placed in service after 2022; the utilization amount equals the geological amount for equipment placed in service after 2025-07-04 (PL 119-21 section 70522(b))";
}
rule BaseDollarsGeologicalBridge45qRule(equipment: Asset, dollars: Decimal) strict {
    when geological_base_dollars_45q(equipment, dollars);
    then base_dollars_45q(equipment, GeologicalStorage, dollars);
}
rule BaseDollarsUtilizationBridge45qRule(equipment: Asset, dollars: Decimal) strict {
    when utilization_base_dollars_45q(equipment, dollars);
    then base_dollars_45q(equipment, EnhancedRecoveryOrUtilization, dollars);
}
relation inflation_multiplier_45q(y: TaxableYear, multiplier: Decimal) kind institutional;
rule InflationMultiplierThrough2026Rule(y: TaxableYear, begin: Date) strict {
    when us.irc.core::begins(y, begin);
    when begin <= @2026-12-31;
    then inflation_multiplier_45q(y, 1.0);
}
@source(IRC_S45Q_B, quote = "for any taxable year beginning in a calendar year after 2026")
rule InflationMultiplierAfter2026Rule(y: TaxableYear, begin: Date, factor: Decimal) strict {
    when us.irc.core::begins(y, begin);
    when begin > @2026-12-31;
    when inflation_adjustment_factor_45q(y, factor);
    then inflation_multiplier_45q(y, factor);
}
relation wage_multiplier_45q(equipment: Asset, y: TaxableYear, multiplier: Decimal) kind institutional;
@source(IRC_S45Q_H, quote = "the amount of the credit determined under subsection (a) shall be equal to such amount (determined without regard to this sentence) multiplied by 5")
rule WageMultiplierFive45qRule(equipment: Asset, y: TaxableYear, facility: Asset) strict {
    when equipment_at_facility_45q(equipment, facility);
    when prevailing_wage_and_apprenticeship_satisfied_45q(facility, y);
    then wage_multiplier_45q(equipment, y, 5.0);
}
rule WageMultiplierOne45qRule(equipment: Asset, y: TaxableYear, facility: Asset) strict {
    when equipment_at_facility_45q(equipment, facility);
    when capture_date_45q(equipment, y, _);
    when not_known(prevailing_wage_and_apprenticeship_satisfied_45q(facility, y));
    then wage_multiplier_45q(equipment, y, 1.0);
}
pub relation dollars_per_ton_45q(equipment: Asset, y: TaxableYear, use: Use45Q, dollars: Decimal) kind institutional {
    label en official "section 45Q(b)(1), (h)(1): the applicable dollar amount, indexed after 2026, x 5 with the wage requirements, rounded to the nearest cent; for pre-2018 equipment $20 / $10 indexed by the (f)(7) factor";
}
@source(IRC_S45Q_B, quote = "The applicable dollar amount determined under subparagraph (A), (B), or (C) shall be rounded to the nearest cent.")
rule DollarsPerTonPostBba45qRule(equipment: Asset, y: TaxableYear, use: Use45Q, dollars: Decimal, multiplier: Decimal, wage: Decimal) strict {
    when base_dollars_45q(equipment, use, dollars);
    when inflation_multiplier_45q(y, multiplier);
    when wage_multiplier_45q(equipment, y, wage);
    then dollars_per_ton_45q(equipment, y, use, round(round(dollars * multiplier, 2, "HALF_UP") * wage, 2, "HALF_UP"));
}
@source(IRC_S45Q_A, quote = "$20 per metric ton of qualified carbon oxide which is")
rule DollarsPerTonPreBbaGeological45qRule(equipment: Asset, y: TaxableYear, factor: Decimal) strict {
    when pre_bba_equipment_45q(equipment);
    when inflation_adjustment_factor_45q(y, factor);
    then dollars_per_ton_45q(equipment, y, GeologicalStorage, round(20.0 * factor, 2, "HALF_UP"));
}
@source(IRC_S45Q_A, quote = "$10 per metric ton of qualified carbon oxide which is")
rule DollarsPerTonPreBbaUtilization45qRule(equipment: Asset, y: TaxableYear, factor: Decimal) strict {
    when pre_bba_equipment_45q(equipment);
    when inflation_adjustment_factor_45q(y, factor);
    then dollars_per_ton_45q(equipment, y, EnhancedRecoveryOrUtilization, round(10.0 * factor, 2, "HALF_UP"));
}

// --- (f)(10): prohibited foreign entities (PL 119-21) ---------------------------------------------------------------------------------------

pub relation paragraph_f10_enacted_on_45q(on: Date) kind empirical {
    label en official "the date of enactment of section 45Q(f)(10) (PL 119-21, July 4, 2025) — case-asserted";
}
pub relation taxpayer_allowed_45q(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45Q(f)(10) (PL 119-21): no credit for a year beginning after enactment if the taxpayer is a specified foreign entity, or 2 years after if a foreign-influenced entity";
}
rule TaxpayerAllowedBeforeEnactmentYears45qRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    when tons_45q(taxpayer, _, y, _, _);
    when us.irc.core::begins(y, begin);
    when paragraph_f10_enacted_on_45q(enacted);
    when begin <= enacted;
    then taxpayer_allowed_45q(taxpayer, y);
}
rule TaxpayerAllowedBeforeAmendment45qRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective (-infinity, @2025-07-04);
    when tons_45q(taxpayer, _, y, _, _);
    when us.irc.core::begins(y, begin);
    when paragraph_f10_enacted_on_45q(enacted);
    then taxpayer_allowed_45q(taxpayer, y);
}
@source(us.irc.temporal::PL119_21_S70522, quote = "No credit shall be determined under subsection (a) for any taxable year beginning after the date of enactment of this paragraph if the taxpayer is")
rule TaxpayerAllowedFirstTwoYears45qRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective [@2025-07-04, infinity);
    when tons_45q(taxpayer, _, y, _, _);
    when us.irc.core::begins(y, begin);
    when paragraph_f10_enacted_on_45q(enacted);
    when begin > enacted;
    when begin <= add_calendar_period(enacted, 24 calendar_month);
    when not_known(specified_foreign_entity_45q(taxpayer));
    then taxpayer_allowed_45q(taxpayer, y);
}
rule TaxpayerAllowedLaterYears45qRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective [@2025-07-04, infinity);
    when tons_45q(taxpayer, _, y, _, _);
    when us.irc.core::begins(y, begin);
    when paragraph_f10_enacted_on_45q(enacted);
    when begin > add_calendar_period(enacted, 24 calendar_month);
    when not_known(specified_foreign_entity_45q(taxpayer));
    when not_known(foreign_influenced_entity_45q(taxpayer));
    then taxpayer_allowed_45q(taxpayer, y);
}

// --- (a): the credit ----------------------------------------------------------------------------------------------------------------------------------

pub relation carbon_oxide_credit_component_before_45b3_45q(taxpayer: Person, equipment: Asset, y: TaxableYear, use: Use45Q, amount: Money) kind institutional {
    label en official "section 45Q(a): the dollars per ton times the metric tons of one use captured with one item of equipment in the taxable year, before the section 45Q(f)(8) reduction for tax-exempt bonds (stage 4)";
}
pub relation carbon_oxide_credit_component_45q(taxpayer: Person, equipment: Asset, y: TaxableYear, use: Use45Q, amount: Money) kind institutional {
    label en official "section 45Q(a), (f)(8): the credit component of one item of equipment after the reduction for tax-exempt bonds, by the rule similar to section 45(b)(3), applied at the facility of the equipment";
}
@source(IRC_S45Q_F, quote = "Rules similar to the rule under section 45(b)(3) shall apply for purposes of this section.")
rule CarbonOxideComponentReduced45qf8Rule(taxpayer: Person, equipment: Asset, y: TaxableYear, use: Use45Q, before: Money, facility: Asset, f: Decimal) defeasible {
    label en official "section 45Q(f)(8): the component reduced by the fraction of section 45(b)(3) of its facility (stage 4)";
    when carbon_oxide_credit_component_before_45b3_45q(taxpayer, equipment, y, use, before);
    when equipment_at_facility_45q(equipment, facility);
    when reduction_fraction_45b3(facility, y, f);
    then carbon_oxide_credit_component_45q(taxpayer, equipment, y, use, round(before * (1.0 - f), 2, "HALF_UP"));
}
rule CarbonOxideComponentNotReduced45qf8Rule(taxpayer: Person, equipment: Asset, y: TaxableYear, use: Use45Q, before: Money, facility: Asset) defeasible {
    label en official "section 45Q(f)(8): no tax-exempt bond financing at the facility, no reduction";
    when carbon_oxide_credit_component_before_45b3_45q(taxpayer, equipment, y, use, before);
    when equipment_at_facility_45q(equipment, facility);
    when not_known(has_reduction_fraction_45b3(facility, y));
    then carbon_oxide_credit_component_45q(taxpayer, equipment, y, use, before);
}
@source(IRC_S45Q_A, quote = "the carbon oxide sequestration credit for any taxable year is an amount equal to the sum of")
rule CarbonOxideCreditComponent45qRule(taxpayer: Person, equipment: Asset, y: TaxableYear, use: Use45Q, tons: Decimal, dollars: Decimal, facility: Asset) defeasible {
    when tons_45q(taxpayer, equipment, y, use, tons);
    when equipment_at_facility_45q(equipment, facility);
    when qualified_facility_45q(facility, y);
    when within_credit_period_45q(equipment, y);
    when qualified_carbon_oxide_measured_and_verified_45q(taxpayer, equipment, y);
    when taxpayer_allowed_45q(taxpayer, y);
    when dollars_per_ton_45q(equipment, y, use, dollars);
    then carbon_oxide_credit_component_before_45b3_45q(taxpayer, equipment, y, use, round(tons * dollars, 2, "HALF_UP") * 1 USD);
}
pub relation carbon_dioxide_sequestration_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45Q carbon oxide sequestration credit for the taxable year (a section 38(b)(29) component)";
}
rule CarbonDioxideSequestrationCredit45qRule(taxpayer: Person, y: TaxableYear, equipment: Asset, use: Use45Q, amount: Money) defeasible {
    when carbon_oxide_credit_component_45q(taxpayer, equipment, y, use, amount);
    then carbon_dioxide_sequestration_credit(taxpayer, y,
        sum(collect all a: Money, e: Asset, u: Use45Q where carbon_oxide_credit_component_45q(taxpayer, e, y, u, a), empty: 0 USD));
}
