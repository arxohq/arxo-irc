// Stage 3 (TECH_GAP reduction): section 45Z(f)(5), "rules similar to the rules of section 45Y(g)(6)"
// (allocation of the credit to patrons of an agricultural cooperative).
// SHAPE. The section 45Y(g)(6) rules are in 45y-48e-adjustments-definitions-and-capacity.law and are
// reused by reference: `eligible_cooperative_45y` (the definition of (D)), the business-done facts
// `business_done_by_patron_45y` and `total_business_done_45y` (they describe the cooperative and its
// patrons, not the credit), and the timely-notice fact `timely_return_and_written_notice_to_patrons_45y`.
// New here: the election power over the section 45Z credit, the apportionment to each patron
// (one rounding to cents HALF_UP, as in the 45Y rule) and the (C) tax increase for a reduced credit.
// The section 45Z credit of the cooperative apportioned among its patrons is a case fact.
// STATUS: implemented_unverified (static check only).

use self::{
    IRC_S45Z_F,
    Person,
    TaxableYear,
    business_done_by_patron_45y,
    eligible_cooperative_45y,
    timely_return_and_written_notice_to_patrons_45y,
    total_business_done_45y,
};

pub relation elects_to_apportion_credit_to_patrons_45z(coop: Person, y: TaxableYear) kind empirical {
    label en official "the eligible cooperative's exercise of the election to apportion any portion of the section 45Z credit among patrons on the basis of business done (section 45Z(f)(5), rules similar to section 45Y(g)(6)(A))";
}
pub relation apportionment_to_patrons_effective_45z(coop: Person, y: TaxableYear) kind institutional {
    label en official "section 45Z(f)(5) with 45Y(g)(6)(A): the apportionment among patrons takes effect (a valid election with the timely notice)";
}
@source(IRC_S45Z_F, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of section 45Y(g)(6) shall apply.")
rule Section45ZF5ElectionRule(coop: Person, y: TaxableYear) defeasible {
    label en official "section 45Z(f)(5): the election of section 45Y(g)(6)(A) applied to the section 45Z credit; the eligible cooperative is the section 45Y(g)(6)(D) definition";
    when eligible_cooperative_45y(coop);
    when timely_return_and_written_notice_to_patrons_45y(coop, y);
    then power Section45ZF5ApportionmentElection {
        holder coop;
        over coop;
        exercise elects_to_apportion_credit_to_patrons_45z(coop, y);
        valid_when timely_return_and_written_notice_to_patrons_45y(coop, y);
        effect create(apportionment_to_patrons_effective_45z(coop, y));
        window [@2022-08-16, infinity);
    };
}
pub relation cooperative_credit_apportioned_45z(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the section 45Z credit that the cooperative apportions among its patrons — case-asserted";
}
pub relation credit_apportioned_to_patron_45z(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45Z(f)(5) with 45Y(g)(6)(A)-(B): the apportioned section 45Z credit goes to each patron on the basis of business done";
}
@source(IRC_S45Z_F, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of section 45Y(g)(6) shall apply.")
rule CreditApportionedToPatron45zRule(coop: Person, patron: Person, y: TaxableYear, apportioned: Money, done: Money, total: Money) strict {
    label en official "section 45Z(f)(5): apportionment on the basis of business done";
    when apportionment_to_patrons_effective_45z(coop, y);
    when cooperative_credit_apportioned_45z(coop, y, apportioned);
    when business_done_by_patron_45y(coop, patron, y, done);
    when total_business_done_45y(coop, y, total);
    when total > 0 USD;
    then credit_apportioned_to_patron_45z(coop, patron, y, div_round(apportioned * (done / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation cooperative_credit_determined_45z(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 45Z credit of the cooperative for the year, as finally determined — case-asserted";
}
pub relation cooperative_credit_shown_on_return_45z(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 45Z credit shown on the cooperative's return for the year — case-asserted";
}
pub relation cooperative_credit_not_apportioned_45z(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 45Z credit amount not apportioned to patrons for the year — case-asserted";
}
pub relation cooperative_tax_increase_for_excess_reduction_45z(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45Z(f)(5) with 45Y(g)(6)(C): if the credit determined is less than the credit shown on the return, the excess of the reduction over the amount not apportioned is an increase in tax";
}
@source(IRC_S45Z_F, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of section 45Y(g)(6) shall apply.")
rule CooperativeTaxIncreaseForExcessReduction45zRule(coop: Person, y: TaxableYear, determined: Money, shown: Money, unapportioned: Money) strict {
    label en official "section 45Z(f)(5): the increase in tax for a reduction of the credit beyond the amount not apportioned";
    when cooperative_credit_determined_45z(coop, y, determined);
    when cooperative_credit_shown_on_return_45z(coop, y, shown);
    when cooperative_credit_not_apportioned_45z(coop, y, unapportioned);
    when shown - determined > unapportioned;
    then cooperative_tax_increase_for_excess_reduction_45z(coop, y, shown - determined - unapportioned);
}
