// Section 48C — Qualifying advanced energy project credit. Stage 2d (IRC-06,
// DECISION-0379). A section 46 component (an investment credit).
//
// Scope / judgment calls:
// * Two certification rounds: the subsection (d) program (30 percent, cap
//   $2,300,000,000) and the subsection (e) program added in 2022 (6 percent,
//   30 percent when the (e)(5)(A) prevailing wage and (e)(6) apprenticeship
//   rules are met; cap $10,000,000,000 of which at most $6,000,000,000 outside
//   energy communities).
// * (b)(3): the qualified investment over all years is limited to the amount
//   the Secretary designated; prior-year investment is a case fact.
// * Certification is a power of the Secretary (valid_when: within the round's
//   cap); the certification lapses if the project is not placed in service in
//   3 years ((d)(2)(C)) or 2 years ((e)(3)(C)).
// * PL 119-21 section 70515 (effective on enactment) changed (e)(3)(C) from
//   "shall be increased" to "shall not be increased" (revoked credits no
//   longer restore the cap); the 2024 base text is modelled and the amended
//   sentence is a SOURCE_GAP row, not a revision.
// * (c)(1)-(2) project and eligible-property lists, (d)(3) and (e)(3)
//   priority directives, the (e)(5)-(6) wage rules and the (e)(2)(B) census
//   tract description are not decomposed (TECH-GAPS G1523).

use self::{
    Asset,
    IRC_S48C_A,
    IRC_S48C_B,
    IRC_S48C_C,
    IRC_S48C_D,
    IRC_S48C_E,
    IRC_S48C_F,
    Person,
    TaxableYear,
};

pub enum AllocationRound48C {
    OriginalProgramSubsectionD,
    ExpandedProgramSubsectionE,
}

pub relation qualified_investment_48c(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 48C(b)(1) qualified investment for the taxable year: the basis of eligible property placed in service as part of a qualifying advanced energy project — case-asserted";
}
pub relation prior_years_qualified_investment_48c(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified investment treated as such for the project for all earlier taxable years (section 48C(b)(3)) — case-asserted";
}
pub relation designated_amount_48c(project: Asset, amount: Money) kind empirical {
    label en official "the amount the Secretary designated as eligible for the credit for the project (section 48C(b)(3)) — case-asserted";
}
pub relation allocation_round_48c(project: Asset, round: AllocationRound48C) kind empirical {
    label en official "the certification program the project's allocation belongs to — case-asserted";
}
pub relation satisfies_wage_and_apprenticeship_requirements_48c(project: Asset) kind empirical {
    label en official "the section 48C(e)(5)(A) prevailing wage requirements and the section 48C(e)(6) apprenticeship requirements are satisfied — case-asserted";
}
pub relation credit_allowed_under_other_section_48c(taxpayer: Person, project: Asset, y: TaxableYear) kind empirical {
    label en official "a credit is allowed for the same qualified investment under section 48, 48A, 48B, 48E, 45Q, or 45V (section 48C(f)) — case-asserted";
}

// --- (d)-(e): certification and program caps ------------------------------------------

pub relation program_total_certified_48c(round: AllocationRound48C, total: Money) kind empirical {
    label en official "the aggregate credits certified in the round, including this certification — case-asserted";
}
pub relation expanded_program_outside_energy_community_total_48c(total: Money) kind empirical {
    label en official "the part of the expanded program allocation that goes to qualified investments outside the section 48C(e)(2)(A)-(B) census tracts — case-asserted";
}
pub relation certification_within_program_cap_48c(project: Asset) kind institutional {
    label en official "sections 48C(d)(1)(B), (e)(2): the certified credits are within the round's cap (and, for the expanded program, the $6,000,000,000 limit outside energy communities)";
}
@source(IRC_S48C_D, quote = "The total amount of credits that may be allocated under the program shall not exceed $2,300,000,000.")
rule CertificationWithinCapOriginal48cRule(project: Asset, total: Money) strict {
    when allocation_round_48c(project, OriginalProgramSubsectionD);
    when program_total_certified_48c(OriginalProgramSubsectionD, total);
    when total <= 2300000000.00 USD;
    then certification_within_program_cap_48c(project);
}
@source(IRC_S48C_E, quote = "The total amount of credits which may be allocated under the program established under paragraph (1) shall not exceed $10,000,000,000")
rule CertificationWithinCapExpanded48cRule(project: Asset, total: Money, outside: Money) strict {
    when allocation_round_48c(project, ExpandedProgramSubsectionE);
    when program_total_certified_48c(ExpandedProgramSubsectionE, total);
    when total <= 10000000000.00 USD;
    when expanded_program_outside_energy_community_total_48c(outside);
    when outside <= 6000000000.00 USD;
    then certification_within_program_cap_48c(project);
}
pub relation secretary_certifies_project_48c(project: Asset, applicant: Person, on: Date) kind empirical {
    label en official "the Secretary's certification of the project under section 48C(d) or (e), issued on this date — the exercise of the certification power";
}
pub relation certified_project_48c(project: Asset) kind institutional {
    label en official "the project's qualified investment is certified by the Secretary as eligible for the section 48C credit";
}
@source(IRC_S48C_C, quote = "any portion of the qualified investment of which is certified by the Secretary under subsection (e) as eligible for a credit under this section")
rule Section48cCertificationPowerRule(project: Asset, applicant: Person, on: Date) strict {
    when secretary_certifies_project_48c(project, applicant, on);
    then power Section48cCertification {
        holder us.irc.core::Secretary;
        over applicant;
        exercise secretary_certifies_project_48c(project, applicant, on);
        valid_when certification_within_program_cap_48c(project);
        effect create(certified_project_48c(project));
        window [@2009-02-17, infinity);
    };
}
pub relation project_placed_in_service_on_48c(project: Asset, on: Date) kind empirical {
    label en official "the date the certified project is placed in service — case-asserted";
}
pub relation certification_lapsed_48c(project: Asset) kind institutional {
    label en official "sections 48C(d)(2)(C), (e)(3)(C): the certification is no longer valid because the project was not placed in service within 3 years (original program) or 2 years (expanded program) of issuance";
}
@source(IRC_S48C_D, quote = "An applicant which receives a certification shall have 3 years from the date of issuance of the certification in order to place the project in service")
rule CertificationLapsedOriginal48cRule(project: Asset, applicant: Person, issued: Date, placed: Date) strict {
    when allocation_round_48c(project, OriginalProgramSubsectionD);
    when secretary_certifies_project_48c(project, applicant, issued);
    when project_placed_in_service_on_48c(project, placed);
    when placed > add_calendar_period(issued, 36 calendar_month);
    then certification_lapsed_48c(project);
}
@source(IRC_S48C_E, quote = "An applicant which receives a certification shall have 2 years from the date of issuance of the certification in order to place the project in service")
rule CertificationLapsedExpanded48cRule(project: Asset, applicant: Person, issued: Date, placed: Date) strict {
    when allocation_round_48c(project, ExpandedProgramSubsectionE);
    when secretary_certifies_project_48c(project, applicant, issued);
    when project_placed_in_service_on_48c(project, placed);
    when placed > add_calendar_period(issued, 24 calendar_month);
    then certification_lapsed_48c(project);
}
pub relation qualifying_advanced_energy_project_48c(project: Asset) kind institutional {
    label en official "section 48C(c)(1): a project any portion of whose qualified investment is certified by the Secretary, the certification not lapsed";
}
rule QualifyingAdvancedEnergyProject48cRule(project: Asset) defeasible {
    when certified_project_48c(project);
    when not_known(certification_lapsed_48c(project));
    then qualifying_advanced_energy_project_48c(project);
}

// --- Secretary duties -----------------------------------------------------------------

pub relation section_48c_program_enacted_on(round: AllocationRound48C, on: Date) kind empirical {
    label en official "the date of enactment of section 48C (original program) or of subsection (e) (expanded program) — case-asserted from the pinned Public Law notes";
}
pub relation program_established_48c(round: AllocationRound48C) kind empirical {
    label en official "the Secretary has established the program for the round — case-asserted";
}
@source(IRC_S48C_D, quote = "the Secretary, in consultation with the Secretary of Energy, shall establish a qualifying advanced energy project program to consider and award certifications for qualified investments eligible for credits under this section to qualifying advanced energy project sponsors")
rule Section48cD1ProgramDutyRule(on: Date) strict {
    when section_48c_program_enacted_on(OriginalProgramSubsectionD, on);
    then duty Section48cD1ProgramDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition program_established_48c(OriginalProgramSubsectionD);
            window [on, add_calendar_period(on, 180 calendar_day)];
        }
    };
}
@source(IRC_S48C_E, quote = "Not later than 180 days after the date of enactment of this subsection, the Secretary shall establish a program to consider and award certifications")
rule Section48cE1ProgramDutyRule(on: Date) strict {
    when section_48c_program_enacted_on(ExpandedProgramSubsectionE, on);
    then duty Section48cE1ProgramDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition program_established_48c(ExpandedProgramSubsectionE);
            window [on, add_calendar_period(on, 180 calendar_day)];
        }
    };
}
pub relation allocation_review_completed_48c(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary reviewed the credits allocated as of the date 4 years after enactment (section 48C(d)(4)(A)) — case-asserted";
}
@source(IRC_S48C_D, quote = "Not later than 4 years after the date of enactment of this section, the Secretary shall review the credits allocated under this section as of such date.")
rule Section48cD4AReviewDutyRule(on: Date) strict {
    when section_48c_program_enacted_on(OriginalProgramSubsectionD, on);
    then duty Section48cD4AReviewDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition allocation_review_completed_48c(us.irc.core::Secretary);
            window [on, add_calendar_period(on, 48 calendar_month)];
        }
    };
}
pub relation certification_publicly_disclosed_48c(project: Asset) kind empirical {
    label en official "the Secretary publicly disclosed the identity of the applicant and the amount of the credit (sections 48C(d)(5), (e)(7)) — case-asserted";
}
@source(IRC_S48C_D, quote = "The Secretary shall, upon making a certification under this subsection, publicly disclose the identity of the applicant and the amount of the credit with respect to such applicant.")
rule Section48cDisclosureDutyRule(project: Asset, applicant: Person, on: Date) strict {
    when secretary_certifies_project_48c(project, applicant, on);
    then duty Section48cDisclosureDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition certification_publicly_disclosed_48c(project);
            window [on, infinity);
        }
    };
}
pub relation reallocation_grounds_48c(secretary: us.irc.core::Organ) kind empirical {
    label en official "at the review the Secretary determined that qualifying applications were insufficient, or a certification was revoked because of third-party delay (section 48C(d)(4)(B)) — case-asserted";
}
pub relation secretary_reallocates_credits_48c(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary's exercise of the reallocation power of section 48C(d)(4)(B) — case-asserted";
}
pub relation credits_reallocated_48c(secretary: us.irc.core::Organ) kind institutional {
    label en official "credits awarded under this section are reallocated";
}
@source(IRC_S48C_D, quote = "The Secretary may reallocate credits awarded under this section if the Secretary determines that")
rule Section48cD4BReallocationPowerRule(secretary: us.irc.core::Organ) strict {
    when reallocation_grounds_48c(secretary);
    then power Section48cD4BReallocation {
        holder us.irc.core::Secretary;
        over us.irc.core::Secretary;
        exercise secretary_reallocates_credits_48c(secretary);
        valid_when reallocation_grounds_48c(secretary);
        effect create(credits_reallocated_48c(secretary));
        window [@2009-02-17, infinity);
    };
}

// --- (a), (b): the credit -------------------------------------------------------------

pub relation allowed_qualified_investment_48c(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48C(b)(3): the qualified investment for the year, limited by the amount designated by the Secretary less the investment of prior years";
}
@source(IRC_S48C_B, quote = "The amount which is treated as the qualified investment for all taxable years with respect to any qualifying advanced energy project shall not exceed the amount designated by the Secretary as eligible for the credit under this section.")
rule AllowedQualifiedInvestment48cRule(taxpayer: Person, project: Asset, y: TaxableYear, investment: Money, prior: Money, designated: Money) strict {
    when qualified_investment_48c(taxpayer, project, y, investment);
    when prior_years_qualified_investment_48c(taxpayer, project, y, prior);
    when designated_amount_48c(project, designated);
    then allowed_qualified_investment_48c(taxpayer, project, y, max(0 USD, min(investment, designated - prior)));
}
pub relation advanced_energy_credit_rate_48c(project: Asset, rate: Decimal) kind institutional {
    label en official "section 48C(a), (e)(4): 30 percent; 6 percent for allocations under subsection (e) unless the wage and apprenticeship requirements are satisfied";
}
@source(IRC_S48C_A, quote = "an amount equal to 30 percent of the qualified investment for such taxable year with respect to any qualifying advanced energy project of the taxpayer")
rule AdvancedEnergyCreditRateOriginal48cRule(project: Asset) strict {
    when allocation_round_48c(project, OriginalProgramSubsectionD);
    then advanced_energy_credit_rate_48c(project, 0.30);
}
@source(IRC_S48C_E, quote = "the amount of the credit determined under subsection (a) shall be determined by substituting \"6 percent\" for \"30 percent\"")
rule AdvancedEnergyCreditRateExpandedReduced48cRule(project: Asset) strict {
    when allocation_round_48c(project, ExpandedProgramSubsectionE);
    when not_known(satisfies_wage_and_apprenticeship_requirements_48c(project));
    then advanced_energy_credit_rate_48c(project, 0.06);
}
@source(IRC_S48C_E, quote = "In the case of any project which satisfies the requirements of paragraphs (5)(A) and (6), subparagraph (A) shall not apply.")
rule AdvancedEnergyCreditRateExpandedFull48cRule(project: Asset) strict {
    when allocation_round_48c(project, ExpandedProgramSubsectionE);
    when satisfies_wage_and_apprenticeship_requirements_48c(project);
    then advanced_energy_credit_rate_48c(project, 0.30);
}
pub relation advanced_energy_credit_per_project_48c(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48C(a): the qualifying advanced energy project credit of one project for the taxable year";
}
@source(IRC_S48C_F, quote = "A credit shall not be allowed under this section for any qualified investment for which a credit is allowed under section 48, 48A, 48B, 48E, 45Q, or 45V.")
rule AdvancedEnergyCreditPerProject48cRule(taxpayer: Person, project: Asset, y: TaxableYear, rate: Decimal, investment: Money) defeasible {
    when qualifying_advanced_energy_project_48c(project);
    when advanced_energy_credit_rate_48c(project, rate);
    when allowed_qualified_investment_48c(taxpayer, project, y, investment);
    when not_known(credit_allowed_under_other_section_48c(taxpayer, project, y));
    then advanced_energy_credit_per_project_48c(taxpayer, project, y, round(rate * investment, 2, "HALF_UP"));
}
pub relation qualifying_advanced_energy_project_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 48C qualifying advanced energy project credit for the taxable year (a section 46(5) component of the investment credit)";
}
rule QualifyingAdvancedEnergyProjectCredit48cRule(taxpayer: Person, y: TaxableYear, project: Asset, amount: Money) defeasible {
    when advanced_energy_credit_per_project_48c(taxpayer, project, y, amount);
    then qualifying_advanced_energy_project_credit(taxpayer, y,
        sum(collect all a: Money, p: Asset where advanced_energy_credit_per_project_48c(taxpayer, p, y, a), empty: 0 USD));
}
