// Section 36B — the (e) rules for individuals who are not lawfully present (reduced premiums, the two household income methods, the lawful
// presence test) and the (g) rules for taxpayers receiving unemployment compensation in 2021. Stage 2f (IRC-06, DECISION-0379, TECH_GAP
// reduction of the stage 2c rows of TECH-GAPS G391). Companion of `36b-premium-tax-credit.law`; its credit rules read household income and
// the premiums as case facts and are NOT rewired to consult these relations.
//
// Judgment calls: the "comparable method" of (e)(1)(B)(ii) is the same computation and is not a separate rule; the poverty lines for the
// reduced and the full family sizes are asserted through the existing poverty line relation; the 133 percent cap of (g)(1)(B) is applied
// to the household income (cents HALF_UP); amounts are Money.

use self::{
    Asset,
    IRC_S36B_E,
    IRC_S36B_G,
    Person,
    TaxableYear,
    family_size_36b,
    poverty_line_amount,
};

pub enum Citizenship36B { CitizenOrNational, AlienLawfullyPresent, OtherPerson }
pub enum IncomePurpose36B { PremiumAssistance, CoverageOfC2CiII, CoverageOfC4Cii }

// --- (e)(2): lawfully present ---------------------------------------------------------------------------------------------------------------------------------

pub relation individual_status_36b(person: Person, status: Citizenship36B) kind empirical {
    label en official "whether the individual is a citizen or national of the United States or an alien lawfully present in the United States (section 36B(e)(2)) — case-asserted";
}
pub relation reasonably_expected_to_remain_status_for_entire_enrollment_period_36b(person: Person) kind empirical {
    label en official "the individual is reasonably expected to be such a person for the entire period of enrollment for which the credit is being claimed (section 36B(e)(2)) — case-asserted";
}
pub relation lawfully_present_36b(person: Person) kind institutional {
    label en official "section 36B(e)(2): an individual is treated as lawfully present only if the individual is, and is reasonably expected to be for the entire period of enrollment, a citizen or national of the United States or an alien lawfully present in the United States";
}
@source(IRC_S36B_E, relation = formalizes, coverage = exact, quote = "an individual shall be treated as lawfully present only if the individual is, and is reasonably expected to be for the entire period of enrollment for which the credit under this section is being claimed")
rule LawfullyPresentCitizenRule(person: Person) strict {
    when individual_status_36b(person, CitizenOrNational);
    when reasonably_expected_to_remain_status_for_entire_enrollment_period_36b(person);
    then lawfully_present_36b(person);
}
rule LawfullyPresentAlienRule(person: Person) strict {
    when individual_status_36b(person, AlienLawfullyPresent);
    when reasonably_expected_to_remain_status_for_entire_enrollment_period_36b(person);
    then lawfully_present_36b(person);
}

// --- (e)(1): individuals not lawfully present ---------------------------------------------------------------------------------------------------------------

pub relation premiums_otherwise_taken_into_account_36b(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount of premiums otherwise taken into account under clauses (i) and (ii) of subsection (b)(2)(A) — case-asserted";
}
pub relation premiums_attributable_to_not_lawfully_present_36b(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the premiums attributable to individuals for whom the taxpayer is allowed a section 151 deduction (including the taxpayer or spouse) who are not lawfully present (section 36B(e)(1)(A)) — case-asserted";
}
pub relation premiums_after_unlawful_presence_reduction_36b(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 36B(e)(1)(A): the aggregate premiums are reduced by the portion attributable to individuals who are not lawfully present (not below zero)";
}
@source(IRC_S36B_E, relation = formalizes, coverage = exact, quote = "the aggregate amount of premiums otherwise taken into account under clauses (i) and (ii) of subsection (b)(2)(A) shall be reduced by the portion (if any) of such premiums which is attributable to such individuals")
rule PremiumsAfterUnlawfulPresenceReductionRule(taxpayer: Person, y: TaxableYear, premiums: Money, attributable: Money) strict {
    when premiums_otherwise_taken_into_account_36b(taxpayer, y, premiums);
    when premiums_attributable_to_not_lawfully_present_36b(taxpayer, y, attributable);
    then premiums_after_unlawful_presence_reduction_36b(taxpayer, y, max(premiums - attributable, 0 USD));
}
pub relation family_size_excluding_not_lawfully_present_36b(taxpayer: Person, y: TaxableYear, size: Decimal) kind empirical {
    label en official "the taxpayer's family size determined by not taking into account the individuals who are not lawfully present (section 36B(e)(1)(B)(i)(I)) — case-asserted";
}
pub relation household_income_before_e1_adjustment_36b(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's household income determined without regard to subsection (e)(1) — case-asserted";
}
pub relation household_income_adjusted_for_unlawful_presence_36b(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 36B(e)(1)(B)(i): household income is the household income times the fraction whose numerator is the poverty line for the family size excluding the individuals not lawfully present and whose denominator is the poverty line for the family size without that exclusion (cents HALF_UP)";
}
@source(IRC_S36B_E, relation = formalizes, coverage = exact, quote = "the taxpayer's household income is equal to the product of the taxpayer's household income (determined without regard to this subsection) and a fraction")
rule HouseholdIncomeAdjustedForUnlawfulPresenceRule(taxpayer: Person, y: TaxableYear, income: Money, reduced_size: Decimal, full_size: Decimal, reduced_line: Money, full_line: Money) strict {
    when household_income_before_e1_adjustment_36b(taxpayer, y, income);
    when family_size_excluding_not_lawfully_present_36b(taxpayer, y, reduced_size);
    when family_size_36b(taxpayer, y, full_size);
    when poverty_line_amount(reduced_size, y, reduced_line);
    when poverty_line_amount(full_size, y, full_line);
    when full_line > 0 USD;
    then household_income_adjusted_for_unlawful_presence_36b(taxpayer, y, div_round(income * (reduced_line / 1.00 USD), full_line / 1.00 USD, 2, "HALF_UP"));
}

// --- (g): unemployment compensation received in 2021 --------------------------------------------------------------------------------------------------

pub relation unemployment_compensation_week_begins_on_36b(taxpayer: Person, week: Asset, on: Date) kind empirical {
    label en official "a week for which the taxpayer has received, or has been approved to receive, unemployment compensation begins on this date (section 36B(g)(1)) — case-asserted";
}
pub relation self_attestation_and_documentation_provided_36b(taxpayer: Person, week: Asset) kind empirical {
    label en official "the taxpayer provides self-attestation of, and the documentation the Secretary prescribes which demonstrates, the receipt or approval of unemployment compensation for the week (section 36B(g)(3)) — case-asserted";
}
pub relation week_begins_in_taxable_year_36b(week: Asset, y: TaxableYear) kind empirical {
    label en official "the week begins in the taxable year — case-asserted";
}
pub relation treated_as_receiving_unemployment_compensation_36b(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 36B(g)(1), (3): a taxpayer who has received or been approved to receive unemployment compensation (section 85(b)) for any week beginning during 2021, on self-attestation and the prescribed documentation, for the taxable year in which the week begins";
}
@source(IRC_S36B_G, relation = formalizes, coverage = exact, quote = "a taxpayer shall not be treated as having received (or been approved to receive) unemployment compensation for any week unless such taxpayer provides self-attestation of, and such documentation as the Secretary shall prescribe which demonstrates, such receipt or approval")
rule TreatedAsReceivingUnemploymentCompensationRule(taxpayer: Person, week: Asset, y: TaxableYear, on: Date) strict {
    when unemployment_compensation_week_begins_on_36b(taxpayer, week, on);
    when on >= @2021-01-01;
    when on <= @2021-12-31;
    when self_attestation_and_documentation_provided_36b(taxpayer, week);
    when week_begins_in_taxable_year_36b(week, y);
    then treated_as_receiving_unemployment_compensation_36b(taxpayer, y);
}
pub relation treated_as_applicable_taxpayer_by_g1a_36b(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 36B(g)(1)(A): a taxpayer receiving unemployment compensation for a week beginning in 2021 is treated as an applicable taxpayer";
}
@source(IRC_S36B_G, relation = formalizes, coverage = exact, quote = "such taxpayer shall be treated as an applicable taxpayer")
rule TreatedAsApplicableTaxpayerByG1aRule(taxpayer: Person, y: TaxableYear) strict {
    when treated_as_receiving_unemployment_compensation_36b(taxpayer, y);
    then treated_as_applicable_taxpayer_by_g1a_36b(taxpayer, y);
}
pub relation section_c1c_application_unaffected_by_g1a_36b(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 36B(g)(4)(A): paragraph (1)(A) does not affect the application of subsection (c)(1)(C)";
}
@source(IRC_S36B_G, relation = formalizes, coverage = exact, quote = "Paragraph (1)(A) shall not affect the application of subsection (c)(1)(C).")
rule SectionC1cApplicationUnaffectedByG1aRule(taxpayer: Person, y: TaxableYear) strict {
    when treated_as_applicable_taxpayer_by_g1a_36b(taxpayer, y);
    then section_c1c_application_unaffected_by_g1a_36b(taxpayer, y);
}
pub relation household_income_asserted_for_purpose_36b(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's household income before the section 36B(g)(1)(B) cap — case-asserted";
}
pub relation poverty_line_for_family_size_of_taxpayer_36b(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the poverty line for a family of the size involved for the taxpayer — case-asserted";
}
pub relation household_income_taken_into_account_36b(taxpayer: Person, y: TaxableYear, purpose: IncomePurpose36B, amount: Money) kind institutional {
    label en official "section 36B(g)(1)(B), (4)(B): for a taxpayer receiving unemployment compensation in 2021, household income in excess of 133 percent of the poverty line is not taken into account, except for the determinations under (c)(2)(C)(i)(II) and (c)(4)(C)(ii) (cents HALF_UP)";
}
@source(IRC_S36B_G, relation = formalizes, coverage = exact, quote = "there shall not be taken into account any household income of the taxpayer in excess of 133 percent of the poverty line for a family of the size involved")
rule HouseholdIncomeTakenIntoAccountCappedRule(taxpayer: Person, y: TaxableYear, income: Money, line: Money) strict {
    when treated_as_receiving_unemployment_compensation_36b(taxpayer, y);
    when household_income_asserted_for_purpose_36b(taxpayer, y, income);
    when poverty_line_for_family_size_of_taxpayer_36b(taxpayer, y, line);
    then household_income_taken_into_account_36b(taxpayer, y, PremiumAssistance, min(income, round(1.33 * (line / 1.00 USD), 2, "HALF_UP") * 1 USD));
}
@source(IRC_S36B_G, relation = formalizes, coverage = exact, quote = "Paragraph (1)(B) shall not apply to any determination of household income for purposes of paragraph (2)(C)(i)(II) or (4)(C)(ii) of subsection (c)")
rule HouseholdIncomeTakenIntoAccountNotCappedC2Rule(taxpayer: Person, y: TaxableYear, income: Money) strict {
    when household_income_asserted_for_purpose_36b(taxpayer, y, income);
    then household_income_taken_into_account_36b(taxpayer, y, CoverageOfC2CiII, income);
}
rule HouseholdIncomeTakenIntoAccountNotCappedC4Rule(taxpayer: Person, y: TaxableYear, income: Money) strict {
    when household_income_asserted_for_purpose_36b(taxpayer, y, income);
    then household_income_taken_into_account_36b(taxpayer, y, CoverageOfC4Cii, income);
}
