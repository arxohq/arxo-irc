// Credits -- WIRE-10 group C, owner `excise_goods` (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// The section 45Z(f)(1)(A)(i)(I) registration test ("registered as a producer of clean fuel under section 4101") was a case-asserted
// placeholder. The owner (`us.irc.excise_goods`, module 17) formalizes section 4101(a)(1): the person is registered with the Secretary
// (`registered_with_secretary_under_4101`) and the ground of the registration requirement is the production of a fuel eligible for the
// clean fuel production credit (`person_within_4101a1_ground` with `CleanFuelProductionCreditFuelProducer`). The placeholder is derived
// from both owner facts. The case-fact channel stays valid.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

import us.irc.excise_goods version "0.1.1";

use self::{
    Person,
    producer_registered_under_4101_45z,
};

rule W10CProducerRegisteredUnder4101FromExciseGoods strict {
    label en official "section 45Z(f)(1)(A)(i)(I): the taxpayer is registered as a producer of clean fuel under section 4101 when the excise-goods package records both the registration with the Secretary and the clean-fuel-producer ground of section 4101(a)(1)";
    for taxpayer: Person;
    when us.irc.excise_goods::registered_with_secretary_under_4101(taxpayer);
    when us.irc.excise_goods::person_within_4101a1_ground(taxpayer, us.irc.excise_goods::CleanFuelProductionCreditFuelProducer);
    then producer_registered_under_4101_45z(taxpayer);
}
