// Sections 45Y and 48E — Clean electricity production credit; clean
// electricity investment credit. Stage 2c (IRC-06 stage 2c,
// DECISION-0379). Priority list item: §45Y/§48E core (the emissions-rate
// <=0 test, phase-out by beginning-of-construction dates per PL 119-21).
//
// Judgment calls / scope:
// * The (b)(1)(A) "qualified facility" test — owned by the taxpayer, used
//   to generate electricity, placed in service after December 31, 2024,
//   greenhouse-gas emissions rate NOT GREATER THAN ZERO — IS modelled as a
//   genuine computation against a case-asserted emissions-rate figure
//   (`greenhouse_gas_emissions_rate_45y`/`_48e`), not a blanket case fact.
//   The emissions-rate MEASUREMENT itself (the (b)(2) combustion/
//   gasification net-rate methodology and the Secretary's published
//   emissions-rate table for non-combustion technologies) is NOT derived
//   — TECH-GAPS G391, EXTERNAL_DEPENDENCY.
// * `us.irc.temporal::PL119_21_S70512` IS pinned and IS used for the
//   section 45Y(d)(4) wind/solar termination (placed in service after
//   December 31, 2027) and the (b)(1)(E) prohibited-foreign-entity
//   material-assistance restriction (construction begins after December
//   31, 2025) — both cited directly from the pinned Public Law text, a
//   genuine "editions from us.irc.temporal" case, unlike sections 25C/25D/
//   30D/45(d) where the analogous PL 119-21 section is NOT pinned.
//   `us.irc.temporal::PL119_21_S70513` is likewise pinned and used for the
//   PARALLEL section 48E restriction (its own (b) amendment mirrors
//   45Y(d)(4)/(b)(1)(E) closely enough to reuse the SAME wind/solar and
//   FEOC relations across both sections, rather than duplicating them
//   under `_48e`-suffixed names).
// * The (a)(2) base/alternative rate structure (0.3 cents / 1.5 cents for
//   section 45Y; 6 percent / 30 percent for section 48E) mirrors section
//   45(b)(6)-(8)'s own small-facility/pre-guidance/wage-and-apprenticeship
//   gate exactly — modelled with the SAME shape of rules as that module,
//   but as a DIRECT statutory dual-rate (no separate 5x-multiplier step;
//   the alternative rate is already 5x the base rate written directly into
//   the text).
// * The 10-year production-period mechanic (section 45Y(b)(1)(B)) reuses
//   the SAME `add_calendar_period`-based derivation as section 45(a)(2)(A)(ii).
// * (b)(1)(C) (expansion/incremental-production qualified facilities),
//   (b)(1)(D) (coordination with sections 45/45J/45Q/45U/48/48A/48E — no
//   double-dipping), (c) (the full technology-specific emissions-rate
//   table), (e)-(g) (elective payment, transferability, the (g)(9)-(13)
//   domestic-content/energy-community/prohibited-foreign-entity provisions
//   beyond the (b)(1)(E)/(d)(4) ones already modelled) are NOT modelled —
//   TECH_GAP, TECH-GAPS G391.
// * §48E's own (b) qualified-facility/(c) energy-storage-technology
//   definitions, (d)(1)-(2) domestic-content and energy-community bonus
//   percentages, (f) phase-out schedule (tied to the national greenhouse-
//   gas-emissions-from-electricity-production target), and (g)-(i) are NOT
//   modelled — only the (a) applicable-percentage/qualified-investment
//   formula and the shared qualified-facility/termination gates are
//   reached this pass.

// --- Shared: qualified facility (emissions rate <= 0) ---------------------------

use self::{
    Asset,
    IRC_S45Y_A,
    IRC_S45Y_B,
    IRC_S48E_A,
    Person,
    TaxableYear,
};

pub relation owned_and_used_for_electricity_generation(facility: Asset, taxpayer: Person) kind empirical {
    label en official "the facility is owned by the taxpayer and used for the generation of electricity (sections 45Y(b)(1)(A)(i), 48E(b)) — case-asserted";
}
pub relation greenhouse_gas_emissions_rate_45y(facility: Asset, grams_co2e_per_kwh: Decimal) kind empirical {
    label en official "the facility's greenhouse gas emissions rate, in grams of CO2e per kWh (sections 45Y(b)(2), 48E(b)(2)) — case-asserted, EXTERNAL_DEPENDENCY on the Secretary's emissions-rate methodology/table";
}
pub relation placed_in_service_date_45y(facility: Asset, on: Date) kind empirical {
    label en official "the date the facility was placed in service, for the section 45Y(b)(1)(A)(ii)/48E(b) after-2024 gate and the 45Y(b)(1)(B) 10-year period — case-asserted";
}
pub relation qualified_facility_45y(facility: Asset, taxpayer: Person) kind institutional {
    label en official "section 45Y(b)(1)(A)/48E(b): a facility owned by the taxpayer, used for electricity generation, placed in service after December 31, 2024, with a greenhouse gas emissions rate not greater than zero";
}
@source(IRC_S45Y_B, quote = "the term \"qualified facility\" means a facility owned by the taxpayer—\n(i) which is used for the generation of electricity,\n(ii) which is placed in service after December 31, 2024, and\n(iii) for which the greenhouse gas emissions rate (as determined under paragraph (2)) is not greater than zero")
rule QualifiedFacility45yRule(facility: Asset, taxpayer: Person, on: Date, rate: Decimal) strict {
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when placed_in_service_date_45y(facility, on);
    when on > @2024-12-31;
    when greenhouse_gas_emissions_rate_45y(facility, rate);
    when rate <= 0.0;
    then qualified_facility_45y(facility, taxpayer);
}

pub relation electricity_sale_date_45y(facility: Asset, y: TaxableYear, on: Date) kind empirical {
    label en official "a representative date within the taxable year on which the electricity was sold/consumed/stored, for the section 45Y(b)(1)(B) 10-year period test — case-asserted";
}
pub relation within_10_year_period_45y(facility: Asset, y: TaxableYear) kind institutional {
    label en official "section 45Y(b)(1)(B): the sale/consumption/storage occurred during the 10-year period beginning on the date the facility was originally placed in service";
}
@source(IRC_S45Y_B, quote = "a facility shall only be treated as a qualified facility during the 10-year period beginning on the date the facility was originally placed in service")
rule Within10YearPeriod45yRule(facility: Asset, y: TaxableYear, placed_on: Date, sold_on: Date) strict {
    when placed_in_service_date_45y(facility, placed_on);
    when electricity_sale_date_45y(facility, y, sold_on);
    when sold_on < add_calendar_period(placed_on, 10 calendar_year);
    then within_10_year_period_45y(facility, y);
}

// --- Shared: PL 119-21 wind/solar termination and FEOC restriction --------------

pub relation wind_or_solar_facility_45y(facility: Asset) kind empirical {
    label en official "the facility uses wind (section 45(d)(1)) or solar energy (section 45(d)(4)) to produce electricity, without regard to any construction-date requirement of section 45 itself (section 45Y(d)(4)(B) as added by PL 119-21 section 70512(a)) — case-asserted";
}
pub relation terminated_wind_solar_45y(facility: Asset) kind institutional {
    label en official "section 45Y(d)(4)(A) (added by PL 119-21 section 70512(a)): no credit for a wind or solar 'applicable facility' placed in service after December 31, 2027";
}
@source(us.irc.temporal::PL119_21_S70512, quote = "This section shall not apply with respect to any applicable facility placed in service after December 31, 2027.")
rule TerminatedWindSolar45yRule(facility: Asset, on: Date) strict {
    when wind_or_solar_facility_45y(facility);
    when placed_in_service_date_45y(facility, on);
    when on > @2027-12-31;
    then terminated_wind_solar_45y(facility);
}

pub relation construction_begin_date_45y(facility: Asset, on: Date) kind empirical {
    label en official "the date construction of the facility began, for the PL 119-21 prohibited-foreign-entity material-assistance restriction — case-asserted";
}
pub relation material_assistance_from_prohibited_foreign_entity_45y(facility: Asset) kind empirical {
    label en official "construction of the facility includes material assistance from a prohibited foreign entity (section 7701(a)(52)) — case-asserted, EXTERNAL_DEPENDENCY on the section 7701(a)(51)/(52) prohibited-foreign-entity definitions added by the same Public Law";
}
pub relation excluded_prohibited_foreign_entity_45y(facility: Asset) kind institutional {
    label en official "section 45Y(b)(1)(E) (added by PL 119-21 section 70512(b)(1)): a qualified facility does not include one whose post-2025 construction includes material assistance from a prohibited foreign entity";
}
@source(us.irc.temporal::PL119_21_S70512, quote = "The term ‘qualified facility’ shall not include any facility for which construction begins after December 31, 2025, if the construction of such facility includes any material assistance from a prohibited foreign entity (as defined in section 7701(a)(52)).")
rule ExcludedProhibitedForeignEntity45yRule(facility: Asset, on: Date) strict {
    when construction_begin_date_45y(facility, on);
    when on > @2025-12-31;
    when material_assistance_from_prohibited_foreign_entity_45y(facility);
    then excluded_prohibited_foreign_entity_45y(facility);
}

// --- Shared: base/alternative rate gate (small facility / pre-guidance / wage+apprenticeship) --

pub relation qualified_facility_under_1mw_45y(facility: Asset) kind empirical {
    label en official "the facility (or, for section 48E, the energy storage technology) has a maximum net output/capacity of less than 1 megawatt — case-asserted, shared by sections 45Y(a)(2)(B)(i) and 48E(a)(2)(A)(ii)(I)/(B)(ii)(I)";
}
pub relation qualified_facility_construction_before_guidance_45y(facility: Asset) kind empirical {
    label en official "construction began before the 60-day-after-guidance date — case-asserted, shared by sections 45Y(a)(2)(B)(ii) and 48E(a)(2)(A)(ii)(II)/(B)(ii)(II)";
}
pub relation prevailing_wage_requirement_satisfied_45y(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the prevailing-wage requirement is satisfied (sections 45Y(g)(9), 48E(d)(3)) — case-asserted";
}
pub relation apprenticeship_requirement_satisfied_45y(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the apprenticeship requirement is satisfied (sections 45Y(g)(10), 48E(d)(4)) — case-asserted";
}
pub relation alternative_rate_requirements_met_45y(facility: Asset) kind institutional {
    label en official "the facility qualifies for the higher (alternative) rate: small facility, pre-guidance construction, or wage-and-apprenticeship satisfied for at least one taxable year — modelled facility-level rather than year-level for the small-facility/pre-guidance branches (both are construction-time, not annual, tests); the wage-and-apprenticeship branch IS technically annual in the statute, collapsed here to facility-level as a disclosed simplification (TECH-GAPS G391)";
}
rule AlternativeRateSmallFacilityRule(facility: Asset) defeasible {
    when qualified_facility_under_1mw_45y(facility);
    then alternative_rate_requirements_met_45y(facility);
}
rule AlternativeRatePreGuidanceRule(facility: Asset) defeasible {
    when qualified_facility_construction_before_guidance_45y(facility);
    then alternative_rate_requirements_met_45y(facility);
}
rule AlternativeRateWageApprenticeshipRule(facility: Asset, y: TaxableYear) defeasible {
    when prevailing_wage_requirement_satisfied_45y(facility, y);
    when apprenticeship_requirement_satisfied_45y(facility, y);
    then alternative_rate_requirements_met_45y(facility);
}

// --- §45Y(a): clean electricity production credit -------------------------------

pub relation kilowatt_hours_produced_45y(facility: Asset, y: TaxableYear, kwh: Decimal) kind empirical {
    label en official "kilowatt hours of electricity produced by the taxpayer at the qualified facility and sold/consumed/stored per section 45Y(a)(1)(A) — case-asserted";
}
pub relation applicable_amount_cents_45y(facility: Asset, y: TaxableYear, cents: Decimal) kind institutional {
    label en official "section 45Y(a)(2): 0.3 cents (base) or 1.5 cents (alternative rate)";
}
@source(IRC_S45Y_A, quote = "the applicable amount shall be 1.5 cents")
rule ApplicableAmountAlternative45yRule(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    when kilowatt_hours_produced_45y(facility, y, kwh);
    when alternative_rate_requirements_met_45y(facility);
    then applicable_amount_cents_45y(facility, y, 1.5);
}
@source(IRC_S45Y_A, quote = "the applicable amount shall be 0.3 cents")
rule ApplicableAmountBase45yRule(facility: Asset, y: TaxableYear, kwh: Decimal) defeasible {
    when kilowatt_hours_produced_45y(facility, y, kwh);
    when not_known(alternative_rate_requirements_met_45y(facility));
    then applicable_amount_cents_45y(facility, y, 0.3);
}
pub relation clean_electricity_credit_before_45b3_45y(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45Y(a) product before the section 45Y(g)(8) reduction (rules similar to section 45(b)(3)); the reduction step is in s3-b-45b-cure-and-reduction-rules.law";
}
pub relation clean_electricity_production_credit(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45Y clean electricity production credit for the taxable year";
}
@source(IRC_S45Y_A, quote = "the clean electricity production credit for any taxable year is an amount equal to the product of—\n(A) the kilowatt hours of electricity")
rule CleanElectricityProductionCreditRule(facility: Asset, taxpayer: Person, y: TaxableYear, kwh: Decimal, cents: Decimal) defeasible {
    when qualified_facility_45y(facility, taxpayer);
    when within_10_year_period_45y(facility, y);
    when not_known(terminated_wind_solar_45y(facility));
    when not_known(excluded_prohibited_foreign_entity_45y(facility));
    when kilowatt_hours_produced_45y(facility, y, kwh);
    when applicable_amount_cents_45y(facility, y, cents);
    then clean_electricity_credit_before_45b3_45y(facility, y, round((cents / 100.0) * kwh, 2, "HALF_UP"));
}

// --- §48E(a): clean electricity investment credit -------------------------------

pub relation qualified_investment_48e(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified investment (basis of qualified property) with respect to the qualified facility or energy storage technology for the taxable year (section 48E(a)(1)) — case-asserted";
}
pub relation applicable_percentage_48e(facility: Asset, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 48E(a)(2): 6 percent (base) or 30 percent (alternative rate)";
}
@source(IRC_S48E_A, quote = "the applicable percentage shall be 30 percent")
rule ApplicablePercentageAlternative48eRule(facility: Asset, y: TaxableYear, investment: Money) defeasible {
    when qualified_investment_48e(facility, y, investment);
    when alternative_rate_requirements_met_45y(facility);
    then applicable_percentage_48e(facility, y, 0.30);
}
@source(IRC_S48E_A, quote = "the applicable percentage shall be 6 percent")
rule ApplicablePercentageBase48eRule(facility: Asset, y: TaxableYear, investment: Money) defeasible {
    when qualified_investment_48e(facility, y, investment);
    when not_known(alternative_rate_requirements_met_45y(facility));
    then applicable_percentage_48e(facility, y, 0.06);
}
pub relation clean_electricity_investment_before_45b3_48e(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 48E(a) product before the section 48E(d)(2) reduction (rules similar to section 45(b)(3)); the reduction step is in s3-b-45b-cure-and-reduction-rules.law";
}
pub relation clean_electricity_investment_credit(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 48E clean electricity investment credit for the taxable year, for purposes of section 46";
}
@source(IRC_S48E_A, quote = "the clean electricity investment credit for any taxable year is an amount equal to the applicable percentage of the qualified investment for such taxable year")
rule CleanElectricityInvestmentCreditRule(facility: Asset, taxpayer: Person, y: TaxableYear, investment: Money, pct: Decimal) defeasible {
    when qualified_facility_45y(facility, taxpayer);
    when not_known(terminated_wind_solar_45y(facility));
    when not_known(excluded_prohibited_foreign_entity_45y(facility));
    when qualified_investment_48e(facility, y, investment);
    when applicable_percentage_48e(facility, y, pct);
    then clean_electricity_investment_before_45b3_48e(facility, y, round(pct * investment, 2, "HALF_UP"));
}
