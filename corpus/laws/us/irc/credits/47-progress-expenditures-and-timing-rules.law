// Section 47 — the time at which qualified rehabilitation expenditures are taken into account under (b) and the progress expenditure rules of
// (d): the application test, the self-rehabilitated building, the component and loan rules, the yearly limit and its carryover, the period
// limits and the election. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of
// `47-rehabilitation-credit.law`; its credit rules read the qualified rehabilitation expenditures of the building as one case-derived amount
// and are NOT rewired to require these relations.
//
// Judgment calls: the "normal rehabilitation period" is the asserted expected period, tested by comparing the expected date the property is
// available for placing in service with 24 months after the start; the yearly figures are asserted amounts; the recapture year of section
// 50(a)(2) is an asserted date; the engineering determination of (d)(3)(D) stays external.

// --- (b): the time expenditures are taken into account ---------------------------------------------------------------------------------------------------

use self::{
    Asset,
    IRC_S47_B,
    IRC_S47_D,
    Person,
    TaxableYear,
};

pub relation building_placed_in_service_year_47(building: Asset, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the qualified rehabilitated building is placed in service — case-asserted";
}
pub relation qualified_rehabilitation_expenditures_of_building_47(building: Asset, amount: Money) kind empirical {
    label en official "the qualified rehabilitation expenditures with respect to the qualified rehabilitated building — case-asserted";
}
pub relation expenditures_taken_into_account_year_47(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 47(b)(1): qualified rehabilitation expenditures are taken into account for the taxable year in which the qualified rehabilitated building is placed in service";
}
@source(IRC_S47_B, relation = formalizes, coverage = exact, quote = "Qualified rehabilitation expenditures with respect to any qualified rehabilitated building shall be taken into account for the taxable year in which such qualified rehabilitated building is placed in service.")
rule ExpendituresTakenIntoAccountYearRule(building: Asset, y: TaxableYear, amount: Money) strict {
    when building_placed_in_service_year_47(building, y);
    when qualified_rehabilitation_expenditures_of_building_47(building, amount);
    then expenditures_taken_into_account_year_47(building, y, amount);
}
pub relation progress_expenditures_taken_into_account_earlier_47(building: Asset, amount: Money) kind empirical {
    label en official "the qualified rehabilitation expenditures taken into account under subsection (d) by the taxpayer or a predecessor (or, for a sale and leaseback described in section 50(a)(2)(C), by the lessee), to the extent not required to be recaptured — case-asserted";
}
pub relation expenditures_after_progress_reduction_47(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 47(b)(2): the amount taken into account under paragraph (1) is reduced (but not below zero) by the qualified rehabilitation expenditures already taken into account under subsection (d) and not recaptured";
}
@source(IRC_S47_B, relation = formalizes, coverage = exact, quote = "shall be reduced (but not below zero) by any amount of qualified rehabilitation expenditures taken into account under subsection (d)")
rule ExpendituresAfterProgressReductionRule(building: Asset, y: TaxableYear, amount: Money, earlier: Money) strict {
    when expenditures_taken_into_account_year_47(building, y, amount);
    when progress_expenditures_taken_into_account_earlier_47(building, earlier);
    then expenditures_after_progress_reduction_47(building, y, max(amount - earlier, 0 USD));
}
rule ExpendituresAfterProgressReductionNoneRule(building: Asset, y: TaxableYear, amount: Money) strict {
    when expenditures_taken_into_account_year_47(building, y, amount);
    when not_known(earlier_progress_asserted_47(building));
    then expenditures_after_progress_reduction_47(building, y, amount);
}
relation earlier_progress_asserted_47(building: Asset) kind institutional;
rule EarlierProgressAssertedRule(building: Asset, earlier: Money) strict {
    when progress_expenditures_taken_into_account_earlier_47(building, earlier);
    then earlier_progress_asserted_47(building);
}

// --- (d)(2), (d)(4): the application of the progress expenditure rule -------------------------------------------------------------------------------------

pub relation physical_work_begins_on_47(building: Asset, on: Date) kind empirical {
    label en official "the date on which physical work on the rehabilitation begins (section 47(d)(2)(B)(i)) — case-asserted";
}
pub relation first_election_year_begin_47(building: Asset, on: Date) kind empirical {
    label en official "the first day of the first taxable year to which an election under subsection (d) applies — case-asserted";
}
pub relation expected_available_for_placing_in_service_on_47(building: Asset, on: Date) kind empirical {
    label en official "the date on which it is expected that the property will be available for placing in service (section 47(d)(2)(B)(ii)) — case-asserted, on the facts known at the close of the year of (d)(2)(A)";
}
pub relation reasonable_to_expect_qualified_rehabilitated_building_47(building: Asset) kind empirical {
    label en official "it is reasonable to expect that the building will be a qualified rehabilitated building in the hands of the taxpayer when placed in service (section 47(d)(2)(A)(ii)) — case-asserted on the facts known at the close of the year";
}
pub relation normal_rehabilitation_period_start_47(building: Asset, on: Date) kind institutional {
    label en official "section 47(d)(2)(B)(i): the normal rehabilitation period begins on the date physical work begins or, if later, the first day of the first taxable year to which the election applies";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "beginning with the date on which physical work on the rehabilitation begins (or, if later, the first day of the first taxable year to which an election under this subsection applies)")
rule NormalPeriodStartWorkLaterRule(building: Asset, work: Date, election: Date) strict {
    when physical_work_begins_on_47(building, work);
    when first_election_year_begin_47(building, election);
    when work >= election;
    then normal_rehabilitation_period_start_47(building, work);
}
rule NormalPeriodStartElectionLaterRule(building: Asset, work: Date, election: Date) strict {
    when physical_work_begins_on_47(building, work);
    when first_election_year_begin_47(building, election);
    when work < election;
    then normal_rehabilitation_period_start_47(building, election);
}
pub relation progress_subsection_applies_to_building_47(building: Asset) kind institutional {
    label en official "section 47(d)(2): subsection (d) applies to a building being rehabilitated by or for the taxpayer if the normal rehabilitation period is 2 years or more and it is reasonable to expect that it will be a qualified rehabilitated building when placed in service";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "the normal rehabilitation period for such building is 2 years or more")
rule ProgressSubsectionAppliesRule(building: Asset, start: Date, ready: Date) strict {
    when normal_rehabilitation_period_start_47(building, start);
    when expected_available_for_placing_in_service_on_47(building, ready);
    when ready >= add_calendar_period(start, 24 calendar_month);
    when reasonable_to_expect_qualified_rehabilitated_building_47(building);
    then progress_subsection_applies_to_building_47(building);
}
pub relation expected_share_of_expenditures_made_directly_by_taxpayer_47(building: Asset, share: Decimal) kind empirical {
    label en official "the share, as a fraction, of the qualified rehabilitation expenditures reasonably believed to be made directly by the taxpayer (section 47(d)(4)) — case-asserted";
}
pub relation self_rehabilitated_building_47(building: Asset) kind institutional {
    label en official "section 47(d)(4): a building for which it is reasonable to believe that more than half of the qualified rehabilitation expenditures will be made directly by the taxpayer";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "means any building if it is reasonable to believe that more than half of the qualified rehabilitation expenditures for such building will be made directly by the taxpayer")
rule SelfRehabilitatedBuildingRule(building: Asset, share: Decimal) strict {
    when expected_share_of_expenditures_made_directly_by_taxpayer_47(building, share);
    when share > 0.50;
    then self_rehabilitated_building_47(building);
}

// --- (d)(1), (d)(3): the year of the expenditure, components, loans -----------------------------------------------------------------------------------------

pub relation expenditure_47(building: Asset, item: Asset, amount: Money) kind empirical {
    label en official "a qualified rehabilitation expenditure with respect to the building — case-asserted";
}
pub relation expenditure_chargeable_to_capital_account_in_year_47(item: Asset, y: TaxableYear) kind empirical {
    label en official "the taxable year for which the expenditure is properly chargeable to capital account with respect to the building (section 47(d)(1)(A)) — case-asserted";
}
pub relation expenditure_paid_in_year_47(item: Asset, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the expenditure is paid (section 47(d)(1)(B)) — case-asserted";
}
pub relation expenditure_taken_into_account_in_year_47(building: Asset, item: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 47(d)(1): for a building to which subsection (d) applies, an expenditure is taken into account for the year it is properly chargeable to capital account (self-rehabilitated property) or the year it is paid (otherwise)";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "if such building is self-rehabilitated property, any qualified rehabilitation expenditure with respect to such building shall be taken into account for the taxable year for which such expenditure is properly chargeable to capital account")
rule ExpenditureTakenIntoAccountSelfRehabilitatedRule(building: Asset, item: Asset, y: TaxableYear, amount: Money) strict {
    when progress_subsection_applies_to_building_47(building);
    when self_rehabilitated_building_47(building);
    when expenditure_47(building, item, amount);
    when expenditure_chargeable_to_capital_account_in_year_47(item, y);
    then expenditure_taken_into_account_in_year_47(building, item, y, amount);
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "if such building is not self-rehabilitated property, any qualified rehabilitation expenditure with respect to such building shall be taken into account for the taxable year in which paid")
rule ExpenditureTakenIntoAccountPaidRule(building: Asset, item: Asset, y: TaxableYear, amount: Money) strict {
    when progress_subsection_applies_to_building_47(building);
    when not_known(self_rehabilitated_building_47(building));
    when expenditure_47(building, item, amount);
    when expenditure_paid_in_year_47(item, y);
    then expenditure_taken_into_account_in_year_47(building, item, y, amount);
}
pub relation irrevocably_devoted_to_use_in_building_on_47(component: Asset, on: Date) kind empirical {
    label en official "the date on which the component becomes irrevocably devoted to use in the building (section 47(d)(3)(A)(i)) — case-asserted";
}
pub relation taxable_year_end_47(y: TaxableYear, on: Date) kind empirical {
    label en official "the last day of the taxable year — case-asserted";
}
pub relation component_cost_chargeable_to_capital_account_in_year_47(component: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the cost to the taxpayer of the component that is properly chargeable during the taxable year to capital account with respect to the building (section 47(d)(3)(A)(ii)) — case-asserted";
}
pub relation component_taken_into_account_47(component: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 47(d)(3)(A): property to be a component of the building is taken into account at a time not earlier than when it becomes irrevocably devoted to use in the building, as if the taxpayer had expended the portion of its cost chargeable to capital account during the year";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "at a time not earlier than the time at which it becomes irrevocably devoted to use in the building")
rule ComponentTakenIntoAccountRule(component: Asset, y: TaxableYear, devoted: Date, year_end: Date, amount: Money) strict {
    when irrevocably_devoted_to_use_in_building_on_47(component, devoted);
    when taxable_year_end_47(y, year_end);
    when devoted <= year_end;
    when component_cost_chargeable_to_capital_account_in_year_47(component, y, amount);
    then component_taken_into_account_47(component, y, amount);
}
pub relation amount_borrowed_from_rehabilitating_person_47(building: Asset, borrowed: Money) kind empirical {
    label en official "the amount borrowed directly or indirectly by the taxpayer from the person rehabilitating the property for him (section 47(d)(3)(B)) — case-asserted";
}
pub relation gross_amount_expended_for_rehabilitation_47(building: Asset, gross: Money) kind empirical {
    label en official "the gross amount expended for the rehabilitation before excluding borrowed amounts — case-asserted";
}
pub relation amount_treated_as_expended_47(building: Asset, amount: Money) kind institutional {
    label en official "section 47(d)(3)(B): any amount borrowed from the person rehabilitating the property is not treated as expended for the rehabilitation (not below zero)";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "shall not be treated as an amount expended for such rehabilitation")
rule AmountTreatedAsExpendedRule(building: Asset, gross: Money, borrowed: Money) strict {
    when gross_amount_expended_for_rehabilitation_47(building, gross);
    when amount_borrowed_from_rehabilitating_person_47(building, borrowed);
    then amount_treated_as_expended_47(building, max(gross - borrowed, 0 USD));
}

// --- (d)(3)(C): the yearly limit and carryover ---------------------------------------------------------------------------------------------------------------

pub relation overall_rehabilitation_cost_47(building: Asset, amount: Money) kind empirical {
    label en official "the overall cost to the taxpayer of the rehabilitation — case-asserted";
}
pub relation share_of_rehabilitation_completed_in_year_47(building: Asset, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the portion, as a fraction, of the rehabilitation completed during the taxable year (determined under regulations, section 47(d)(3)(D)) — case-asserted";
}
pub relation carried_increase_of_limit_47(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excess of the prior year's limitation over the amount taken into account, which increases the limitation of this year (section 47(d)(3)(C)(ii)(II)) — case-asserted";
}
pub relation amount_carried_into_year_47(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excess of the prior year's amount over the limitation, taken into account for this year (section 47(d)(3)(C)(ii)(I)) — case-asserted";
}
pub relation amount_otherwise_taken_into_account_in_year_47(building: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount that would, but for the limitation of clause (i), be taken into account under paragraph (1)(B) for the year, before any carried amount — case-asserted";
}
pub relation yearly_limit_47(building: Asset, y: TaxableYear, limit: Money) kind institutional {
    label en official "section 47(d)(3)(C)(i)-(ii)(II): for a building not self-rehabilitated, the limit is the portion of the overall cost attributable to the rehabilitation completed during the year plus any excess limitation carried from the prior year (cents HALF_UP)";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "shall not exceed the amount which represents the portion of the overall cost to the taxpayer of the rehabilitation which is properly attributable to the portion of the rehabilitation which is completed during such taxable year")
rule YearlyLimitRule(building: Asset, y: TaxableYear, cost: Money, share: Decimal, carried: Money) strict {
    when not_known(self_rehabilitated_building_47(building));
    when overall_rehabilitation_cost_47(building, cost);
    when share_of_rehabilitation_completed_in_year_47(building, y, share);
    when carried_increase_of_limit_47(building, y, carried);
    then yearly_limit_47(building, y, round(cost / 1.00 USD * share, 2, "HALF_UP") * 1 USD + carried);
}
pub relation amount_taken_into_account_after_limit_47(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 47(d)(3)(C)(i)-(ii)(I): the amount taken into account (including the excess carried from the prior year) does not exceed the yearly limit";
}
rule AmountTakenIntoAccountAfterLimitRule(building: Asset, y: TaxableYear, base: Money, carried: Money, limit: Money) strict {
    when amount_otherwise_taken_into_account_in_year_47(building, y, base);
    when amount_carried_into_year_47(building, y, carried);
    when yearly_limit_47(building, y, limit);
    then amount_taken_into_account_after_limit_47(building, y, min(base + carried, limit));
}
pub relation excess_carried_to_succeeding_year_47(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 47(d)(3)(C)(ii)(I): the amount which but for the limit would have been taken into account and exceeds it is taken into account for the succeeding taxable year";
}
rule ExcessCarriedToSucceedingYearRule(building: Asset, y: TaxableYear, base: Money, carried: Money, limit: Money) strict {
    when amount_otherwise_taken_into_account_in_year_47(building, y, base);
    when amount_carried_into_year_47(building, y, carried);
    when yearly_limit_47(building, y, limit);
    when base + carried > limit;
    then excess_carried_to_succeeding_year_47(building, y, base + carried - limit);
}
pub relation unused_limit_increases_succeeding_limit_47(building: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 47(d)(3)(C)(ii)(II): the excess of the limitation over the amount taken into account increases the limitation for the succeeding taxable year";
}
rule UnusedLimitIncreasesSucceedingLimitRule(building: Asset, y: TaxableYear, base: Money, carried: Money, limit: Money) strict {
    when amount_otherwise_taken_into_account_in_year_47(building, y, base);
    when amount_carried_into_year_47(building, y, carried);
    when yearly_limit_47(building, y, limit);
    when limit > base + carried;
    then unused_limit_increases_succeeding_limit_47(building, y, limit - base - carried);
}

// --- (d)(3)(E)-(F): the period limits ---------------------------------------------------------------------------------------------------------------------------

pub relation expenditure_period_date_47(item: Asset, on: Date) kind empirical {
    label en official "the date of the period for which the qualified rehabilitation expenditure would be taken into account — case-asserted";
}
pub relation expenditure_period_allowed_47(building: Asset, item: Asset) kind institutional {
    label en official "section 47(d)(3)(E): no qualified rehabilitation expenditures are taken into account for any period before the first day of the first taxable year to which the election applies";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "No qualified rehabilitation expenditures shall be taken into account under this subsection for any period before the first day of the first taxable year to which an election under this subsection applies.")
rule ExpenditurePeriodAllowedRule(building: Asset, item: Asset, on: Date, first: Date) strict {
    when expenditure_period_date_47(item, on);
    when first_election_year_begin_47(building, first);
    when on >= first;
    then expenditure_period_allowed_47(building, item);
}
pub relation placed_in_service_year_begin_47(building: Asset, on: Date) kind empirical {
    label en official "the first day of the taxable year in which the building is placed in service — case-asserted";
}
pub relation first_recapture_year_begin_47(building: Asset, on: Date) kind empirical {
    label en official "the first day of the first taxable year for which recapture is required under section 50(a)(2) with respect to the property — case-asserted";
}
pub relation taxable_year_begin_47(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year — case-asserted";
}
pub relation year_before_cutoff_47(building: Asset, y: TaxableYear) kind institutional {
    label en official "section 47(d)(3)(F): no expenditures are taken into account for the earlier of the year the building is placed in service and the first recapture year, or any year thereafter";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "no qualified rehabilitation expenditures shall be taken into account under this subsection for the earlier of")
rule YearBeforeCutoffRule(building: Asset, y: TaxableYear, begin: Date, placed: Date) strict {
    when taxable_year_begin_47(y, begin);
    when placed_in_service_year_begin_47(building, placed);
    when begin < placed;
    when not_known(first_recapture_year_asserted_47(building));
    then year_before_cutoff_47(building, y);
}
rule YearBeforeCutoffWithRecaptureRule(building: Asset, y: TaxableYear, begin: Date, placed: Date, recapture: Date) strict {
    when taxable_year_begin_47(y, begin);
    when placed_in_service_year_begin_47(building, placed);
    when first_recapture_year_begin_47(building, recapture);
    when begin < placed;
    when begin < recapture;
    then year_before_cutoff_47(building, y);
}
relation first_recapture_year_asserted_47(building: Asset) kind institutional;
rule FirstRecaptureYearAssertedRule(building: Asset, recapture: Date) strict {
    when first_recapture_year_begin_47(building, recapture);
    then first_recapture_year_asserted_47(building);
}

// --- (d)(5): the election ------------------------------------------------------------------------------------------------------------------------------------------

pub relation elects_progress_expenditure_rules_47(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's exercise of the section 47(d)(5) election to have subsection (d) apply";
}
pub relation progress_election_in_effect_47(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 47(d)(5): the election applies to the taxable year for which made and all subsequent taxable years";
}
@source(IRC_S47_D, relation = formalizes, coverage = exact, quote = "This subsection shall apply to any taxpayer only if such taxpayer has made an election under this paragraph.")
rule Section47D5ElectionRule(taxpayer: Person, y: TaxableYear) defeasible {
    when elects_progress_expenditure_rules_47(taxpayer, y);
    then power Section47D5ProgressElection {
        holder taxpayer;
        over taxpayer;
        exercise elects_progress_expenditure_rules_47(taxpayer, y);
        valid_when elects_progress_expenditure_rules_47(taxpayer, y);
        effect create(progress_election_in_effect_47(taxpayer, y));
        window [-infinity, infinity);
    };
}
pub relation election_year_begin_47(taxpayer: Person, on: Date) kind empirical {
    label en official "the first day of the taxable year for which the election is made — case-asserted";
}
pub relation election_revoked_with_consent_of_secretary_47(taxpayer: Person, on: Date) kind empirical {
    label en official "the first day of the taxable year from which the election is revoked with the consent of the Secretary (section 47(d)(5)) — case-asserted";
}
pub relation election_applies_to_year_47(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 47(d)(5): once made the election applies to all subsequent taxable years and may be revoked only with the consent of the Secretary";
}
rule ElectionAppliesToYearRule(taxpayer: Person, y: TaxableYear, made: Date, begin: Date) strict {
    when election_year_begin_47(taxpayer, made);
    when taxable_year_begin_47(y, begin);
    when begin >= made;
    when not_known(election_revocation_asserted_47(taxpayer));
    then election_applies_to_year_47(taxpayer, y);
}
rule ElectionAppliesToYearBeforeRevocationRule(taxpayer: Person, y: TaxableYear, made: Date, begin: Date, revoked: Date) strict {
    when election_year_begin_47(taxpayer, made);
    when taxable_year_begin_47(y, begin);
    when election_revoked_with_consent_of_secretary_47(taxpayer, revoked);
    when begin >= made;
    when begin < revoked;
    then election_applies_to_year_47(taxpayer, y);
}
relation election_revocation_asserted_47(taxpayer: Person) kind institutional;
rule ElectionRevocationAssertedRule(taxpayer: Person, revoked: Date) strict {
    when election_revoked_with_consent_of_secretary_47(taxpayer, revoked);
    then election_revocation_asserted_47(taxpayer);
}
