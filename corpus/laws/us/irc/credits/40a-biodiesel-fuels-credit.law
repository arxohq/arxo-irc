// Section 40A — Biodiesel and renewable diesel used as fuel. Stage 2c
// (IRC-06 stage 2c, DECISION-0379), "as budget allows" item: §40A
// (biodiesel $1.00/gallon).
//
// Judgment calls / scope:
// * The three (a) components — biodiesel mixture credit ($1.00/gallon,
//   (b)(1)), biodiesel credit ($1.00/gallon, (b)(2)), and the small-agri-
//   biodiesel-producer credit (10 cents/gallon) — ARE modelled exactly.
// * (b)(1)(C)-(D) (trade-or-business/timing requirement, casual-off-farm
//   exclusion) and (b)(2)(B) (no user credit for retail-sold biodiesel) are
//   NOT separately derived — the case-asserted gallon counts are read as
//   already meeting these tests (TECH_GAP, TECH-GAPS G391).
// * (b)(3)'s certification requirement (gating the (a)(1)/(a)(2) credits)
//   IS modelled as a gating classification fact.
// * The small-agri-biodiesel-producer definition and the eligibility/
//   volume-cap tests underneath it are EXTERNAL_DEPENDENCY case facts.
// * (c)-(f) (renewable diesel treated as biodiesel, coordination with the
//   alcohol fuels credit, recordkeeping, other definitions) are NOT
//   modelled.
// * (g) termination (no credit for a sale or use after December 31, 2024)
//   IS modelled exactly as pinned in the base 2024-Edition text — PL
//   119-21 does not appear to touch section 40A (superseded by section 45Z
//   for post-2024 clean fuel production; not confirmed against a pinned
//   PL 119-21 fragment, since none references section 40A).

use self::{
    IRC_S40A_A,
    IRC_S40A_B,
    IRC_S40A_G,
    Person,
    TaxableYear,
};

pub relation biodiesel_certification_obtained(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer obtains the section 40A(b)(3) producer/importer certification — case-asserted, gates the (a)(1)/(a)(2) credits";
}
pub relation sale_or_use_date_40a(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the date of the sale or use giving rise to the credit, for the section 40A(g) termination — case-asserted";
}
pub relation not_terminated_40a(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 40A(g): the sale or use occurred on or before December 31, 2024";
}
@source(IRC_S40A_G, quote = "This section shall not apply to any sale or use after December 31, 2024.")
rule NotTerminated40aRule(taxpayer: Person, y: TaxableYear, on: Date) strict {
    when sale_or_use_date_40a(taxpayer, y, on);
    when on <= @2024-12-31;
    then not_terminated_40a(taxpayer, y);
}

pub relation biodiesel_used_in_qualified_mixture_gallons(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of biodiesel used by the taxpayer in the production of a qualified biodiesel mixture (section 40A(b)(1)) — case-asserted";
}
pub relation biodiesel_mixture_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40A(b)(1)(A): $1.00 per gallon of biodiesel used in a qualified mixture";
}
@source(IRC_S40A_B, quote = "The biodiesel mixture credit of any taxpayer for any taxable year is $1.00 for each gallon of biodiesel used by the taxpayer in the production of a qualified biodiesel mixture.")
rule BiodieselMixtureCreditRule(taxpayer: Person, y: TaxableYear, gallons: Decimal) strict {
    when not_terminated_40a(taxpayer, y);
    when biodiesel_certification_obtained(taxpayer, y);
    when biodiesel_used_in_qualified_mixture_gallons(taxpayer, y, gallons);
    then biodiesel_mixture_credit(taxpayer, y, round(1.00 USD * gallons, 2, "HALF_UP"));
}

pub relation biodiesel_used_or_sold_not_in_mixture_gallons(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of biodiesel not in a mixture used by the taxpayer as fuel or sold at retail and placed in a vehicle's fuel tank (section 40A(b)(2)(A)) — case-asserted, already net of any retail-sold gallons counted elsewhere per (b)(2)(B)";
}
pub relation biodiesel_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40A(b)(2)(A): $1.00 per gallon of biodiesel not in a mixture";
}
@source(IRC_S40A_B, quote = "The biodiesel credit of any taxpayer for any taxable year is $1.00 for each gallon of biodiesel which is not in a mixture with diesel fuel")
rule BiodieselCreditRule(taxpayer: Person, y: TaxableYear, gallons: Decimal) strict {
    when not_terminated_40a(taxpayer, y);
    when biodiesel_certification_obtained(taxpayer, y);
    when biodiesel_used_or_sold_not_in_mixture_gallons(taxpayer, y, gallons);
    then biodiesel_credit(taxpayer, y, round(1.00 USD * gallons, 2, "HALF_UP"));
}

pub relation eligible_small_agri_biodiesel_producer(taxpayer: Person) kind empirical {
    label en official "taxpayer is an eligible small agri-biodiesel producer — case-asserted, EXTERNAL_DEPENDENCY on the underlying production-capacity definition";
}
pub relation qualified_agri_biodiesel_production_gallons(taxpayer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "gallons of qualified agri-biodiesel production by an eligible small agri-biodiesel producer — case-asserted";
}
pub relation small_agri_biodiesel_producer_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "10 cents per gallon of qualified agri-biodiesel production, for an eligible small agri-biodiesel producer";
}
@source(IRC_S40A_B, quote = "The small agri-biodiesel producer credit of any eligible small agri-biodiesel producer for any taxable year is 10 cents for each gallon of qualified agri-biodiesel production of such producer.")
rule SmallAgriBiodieselProducerCreditRule(taxpayer: Person, y: TaxableYear, gallons: Decimal) strict {
    when not_terminated_40a(taxpayer, y);
    when eligible_small_agri_biodiesel_producer(taxpayer);
    when qualified_agri_biodiesel_production_gallons(taxpayer, y, gallons);
    then small_agri_biodiesel_producer_credit(taxpayer, y, round(0.10 USD * gallons, 2, "HALF_UP"));
}
pub relation small_agri_biodiesel_producer_credit_or_zero(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional;
rule SmallAgriBiodieselProducerCreditPresentRule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when small_agri_biodiesel_producer_credit(taxpayer, y, amount);
    then small_agri_biodiesel_producer_credit_or_zero(taxpayer, y, amount);
}
rule SmallAgriBiodieselProducerCreditAbsentRule(taxpayer: Person, y: TaxableYear) defeasible {
    when not_terminated_40a(taxpayer, y);
    when not_known(eligible_small_agri_biodiesel_producer(taxpayer));
    then small_agri_biodiesel_producer_credit_or_zero(taxpayer, y, 0 USD);
}

pub relation biodiesel_fuels_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40A(a): the biodiesel fuels credit — the sum of the mixture, biodiesel, and (where applicable) small agri-biodiesel producer credits";
}
@source(IRC_S40A_A, quote = "the biodiesel fuels credit determined under this section for the taxable year is an amount equal to the sum of—\n(1) the biodiesel mixture credit, plus\n(2) the biodiesel credit, plus\n(3) in the case of an eligible small agri-biodiesel producer, the small agri-biodiesel producer credit")
rule BiodieselFuelsCreditRule(taxpayer: Person, y: TaxableYear, mixture: Money, biodiesel: Money, agri: Money) defeasible {
    when biodiesel_mixture_credit(taxpayer, y, mixture);
    when biodiesel_credit(taxpayer, y, biodiesel);
    when small_agri_biodiesel_producer_credit_or_zero(taxpayer, y, agri);
    then biodiesel_fuels_credit(taxpayer, y, mixture + biodiesel + agri);
}
