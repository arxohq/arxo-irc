// Section 47 — Rehabilitation credit (a component of the section 46
// investment credit). Stage 2 (IRC-06 stage 2, DECISION-0379). Priority
// list item: §47 rehabilitation 20% over 5 years.
//
// Judgment calls:
// * §47(a): the credit is 20 percent of qualified rehabilitation
//   expenditures, ALLOCATED RATABLY over the 5-taxable-year period
//   beginning with the year the building is placed in service (post-TCJA
//   rule) — modelled as a per-year ratable-share relation plus a
//   `taxable_year_ordinal_in_period` case fact (which of the 5 years this
//   is), rather than a self-recursive day-by-day/year-by-year ledger
//   (HANDOFF's own warning on LDC-E4102 self-recursive arithmetic).
// * §47(c)(1) "qualified rehabilitated building" and (c)(3) "certified
//   historic structure" are modelled as classification relations resting on
//   Department of the Interior/National Register certification facts
//   (EXTERNAL_DEPENDENCY — an executive-branch certification the statute
//   itself makes conclusive, not a fact this package can derive).
// * §47(c)(1)(B)(i)'s "substantially rehabilitated" 24-month-expenditure
//   test is modelled as an exact comparison (qualified rehabilitation
//   expenditures during the selected 24-month period > greater of adjusted
//   basis or $5,000); the (c)(1)(B)(ii) 60-month phased-rehabilitation
//   variant is a second, independent rule reusing the same relation
//   (an `unless`-free alternative, since the two periods are mutually
//   exclusive by the taxpayer's own selection, modelled as a case fact
//   `phased_rehabilitation_elected`).
// * §47(c)(2)(B) (expenditures NOT included: non-straight-line
//   depreciation, acquisition cost, enlargements, non-certified
//   rehabilitation, tax-exempt-use property, short-remaining-lease-term
//   lessee expenditures) is modelled as ONE relation with five independent
//   defining rules, the §50(b)/§6334(a) "one relation, N facts" idiom.
// * §47(b)/(d) (timing; coordination with progress-expenditure elections)
//   is NOT modelled this pass — TECH_GAP, noted: this package reads
//   "placed in service" as the case-supplied anchor year directly.

use self::{
    Asset,
    IRC_S47_A,
    IRC_S47_C,
    Person,
    TaxableYear,
};

pub relation certified_historic_structure(building: Asset) kind empirical {
    label en official "listed in the National Register, or located in and certified as being of historic significance to a registered historic district (section 47(c)(3)) — EXTERNAL_DEPENDENCY on Department of the Interior/National Register certification";
}

relation placed_in_service_before_rehabilitation(building: Asset) kind empirical;
relation depreciation_allowable(building: Asset) kind empirical;

relation qualified_rehabilitation_expenditure_excluded(building: Asset, item: Money) kind institutional {
    label en official "an amount otherwise chargeable to capital account is NOT a qualified rehabilitation expenditure by reason of section 47(c)(2)(B) (i)-(vi)";
}
relation non_straight_line_depreciation_expenditure(building: Asset, item: Money) kind empirical;
rule ExcludedNonStraightLine strict {
    for building: Asset;
    for item: Money;
    when non_straight_line_depreciation_expenditure(building, item);
    then qualified_rehabilitation_expenditure_excluded(building, item);
}
relation acquisition_cost_expenditure(building: Asset, item: Money) kind empirical;
rule ExcludedAcquisitionCost strict {
    for building: Asset;
    for item: Money;
    when acquisition_cost_expenditure(building, item);
    then qualified_rehabilitation_expenditure_excluded(building, item);
}
relation enlargement_expenditure(building: Asset, item: Money) kind empirical;
rule ExcludedEnlargement strict {
    for building: Asset;
    for item: Money;
    when enlargement_expenditure(building, item);
    then qualified_rehabilitation_expenditure_excluded(building, item);
}
relation tax_exempt_use_property_expenditure(building: Asset, item: Money) kind empirical;
rule ExcludedTaxExemptUse strict {
    for building: Asset;
    for item: Money;
    when tax_exempt_use_property_expenditure(building, item);
    then qualified_rehabilitation_expenditure_excluded(building, item);
}
relation lessee_short_remaining_term_expenditure(building: Asset, item: Money) kind empirical;
rule ExcludedLesseeShortTerm strict {
    for building: Asset;
    for item: Money;
    when lessee_short_remaining_term_expenditure(building, item);
    then qualified_rehabilitation_expenditure_excluded(building, item);
}

@source(IRC_S47_C, quote = "Rehabilitation includes reconstruction.")
pub relation not_certified_rehabilitation(building: Asset) kind empirical {
    label en official "the rehabilitation of the building is NOT a certified rehabilitation within the meaning of section 47(c)(2)(C) (the Secretary of the Interior has not certified it as consistent with the historic character of the property or district) — its expenditures are excluded by section 47(c)(2)(B)(iv)";
}
rule ExcludedNotCertifiedRehabilitation strict {
    for building: Asset;
    for item: Money;
    when not_certified_rehabilitation(building);
    when qualified_rehabilitation_expenditure_candidate(building, item);
    then qualified_rehabilitation_expenditure_excluded(building, item);
}
relation qualified_rehabilitation_expenditure_candidate(building: Asset, item: Money) kind empirical {
    label en official "an amount properly chargeable to capital account in connection with the rehabilitation of the building, for depreciable nonresidential/residential-rental/12.5-year-class-life real property (section 47(c)(2)(A)), before applying the section 47(c)(2)(B) exclusions";
}

pub relation qualified_rehabilitation_expenditures(building: Asset, amount: Money) kind institutional {
    label en official "aggregate qualified rehabilitation expenditures with respect to the qualified rehabilitated building (section 47(c)(2))";
}
rule QualifiedRehabilitationExpendituresTotal defeasible {
    for building: Asset;
    for one_item: Money;
    when qualified_rehabilitation_expenditure_candidate(building, one_item);
    then qualified_rehabilitation_expenditures(building,
        sum all item: Money for one: Money where qualified_rehabilitation_expenditure_candidate(building, item) and not qualified_rehabilitation_expenditure_excluded(building, item));
}

relation aggregate_rehabilitation_expenditures_24_month_period(building: Asset, amount: Money) kind empirical {
    label en official "qualified rehabilitation expenditures during the taxpayer-selected 24-month period ending with or within the taxable year (section 47(c)(1)(B)(i))";
}
relation aggregate_rehabilitation_expenditures_60_month_period(building: Asset, amount: Money) kind empirical {
    label en official "qualified rehabilitation expenditures during the taxpayer-selected 60-month phased-rehabilitation period (section 47(c)(1)(B)(ii))";
}
relation phased_rehabilitation_elected(building: Asset) kind empirical {
    label en official "the rehabilitation is expected to be completed in phases set forth in architectural plans and specifications completed before the rehabilitation begins (section 47(c)(1)(B)(ii))";
}
relation adjusted_basis_at_start_of_measurement_period(building: Asset, amount: Money) kind empirical;

pub relation substantially_rehabilitated(building: Asset) kind institutional {
    label en official "the building has been substantially rehabilitated (section 47(c)(1)(B))";
}
@source(IRC_S47_C, quote = "the qualified rehabilitation expenditures during the 24-month period selected by the taxpayer (at the time and in the manner prescribed by regulation) and ending with or within the taxable year exceed the greater of—\n(I) the adjusted basis of such building (and its structural components), or\n(II) $5,000")
rule SubstantiallyRehabilitated24Month strict {
    for building: Asset;
    for expenditures: Money;
    for basis: Money;
    when not phased_rehabilitation_elected(building);
    when aggregate_rehabilitation_expenditures_24_month_period(building, expenditures);
    when adjusted_basis_at_start_of_measurement_period(building, basis);
    when expenditures > max(basis, 5000.00 USD);
    then substantially_rehabilitated(building);
}
@source(IRC_S47_C, quote = "In the case of any rehabilitation which may reasonably be expected to be completed in phases set forth in architectural plans and specifications completed before the rehabilitation begins, clause (i) shall be applied by substituting \"60-month period\" for \"24-month period\".")
rule SubstantiallyRehabilitated60Month strict {
    for building: Asset;
    for expenditures: Money;
    for basis: Money;
    when phased_rehabilitation_elected(building);
    when aggregate_rehabilitation_expenditures_60_month_period(building, expenditures);
    when adjusted_basis_at_start_of_measurement_period(building, basis);
    when expenditures > max(basis, 5000.00 USD);
    then substantially_rehabilitated(building);
}

pub relation qualified_rehabilitated_building(building: Asset) kind institutional {
    label en official "the building is a qualified rehabilitated building (section 47(c)(1)(A))";
}
@source(IRC_S47_C, quote = "The term \"qualified rehabilitated building\" means any building (and its structural components) if—\n(i) such building has been substantially rehabilitated,\n(ii) such building was placed in service before the beginning of the rehabilitation,\n(iii) such building is a certified historic structure, and\n(iv) depreciation (or amortization in lieu of depreciation) is allowable with respect to such building.")
rule QualifiedRehabilitatedBuilding strict {
    for building: Asset;
    when substantially_rehabilitated(building)
        and placed_in_service_before_rehabilitation(building)
        and certified_historic_structure(building)
        and depreciation_allowable(building);
    then qualified_rehabilitated_building(building);
}

// --- §47(a): 20 percent, ratable over 5 years -------------------------------------

pub relation rehabilitation_credit_ratable_share(building: Asset, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the ratable share of the rehabilitation credit for this taxable year within the 5-year period beginning in the year the building is placed in service (section 47(a)(2))";
}
relation within_5_year_ratable_period(building: Asset, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year falls within the 5-year period beginning in the taxable year the qualified rehabilitated building is placed in service (section 47(a)(1))";
}
@source(IRC_S47_A, quote = "the ratable share for any taxable year during the period described in such paragraph is the amount equal to 20 percent of the qualified rehabilitation expenditures with respect to the qualified rehabilitated building, as allocated ratably to each year during such period")
rule RehabilitationCreditRatableShare defeasible {
    for building: Asset;
    for taxpayer: Person;
    for y: TaxableYear;
    for expenditures: Money;
    when qualified_rehabilitated_building(building);
    when within_5_year_ratable_period(building, taxpayer, y);
    when qualified_rehabilitation_expenditures(building, expenditures);
    then rehabilitation_credit_ratable_share(building, taxpayer, y, round(0.20 * expenditures / 5.0, 2, "HALF_UP"));
}

pub relation rehabilitation_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 47 rehabilitation credit for the taxable year (aggregate ratable share across all of the taxpayer's qualified rehabilitated buildings) — a component of the section 46 investment credit";
}
rule RehabilitationCreditTotal defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for one_building: Asset;
    for one_amount: Money;
    when rehabilitation_credit_ratable_share(one_building, taxpayer, y, one_amount);
    then rehabilitation_credit(taxpayer, y,
        sum all amount: Money for building: Asset where rehabilitation_credit_ratable_share(building, taxpayer, y, amount));
}
