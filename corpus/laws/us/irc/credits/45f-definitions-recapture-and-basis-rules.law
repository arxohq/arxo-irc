// Section 45F — the qualified child care expenditure kinds of (c)(1)(A)(i)-(ii), the year 1 of the recapture table of (d)(2)(B), the tax benefit
// rule of (d)(4), the single taxpayer of (e)(1), the partnership allocation of (e)(3), and the basis and no double benefit rules of (f).
// Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of
// `45f-employer-provided-child-care-credit.law`; its credit rules read the expenditure amounts as case facts and are NOT rewired to require
// these relations. Section 45F(c)(1)(A)(iii) has no pinned text (SOURCE_GAP) and stays as is.
//
// Judgment calls: the operating cost kinds of (c)(1)(A)(ii) are an enum fact; the recapture event of (f)(1)(B) reads the asserted recapture amount
// (the increase in tax); the partnership allocation regulations stay external (DECISION-0194); amounts are cents HALF_UP.

use self::{
    Asset,
    IRC_S45F_C,
    IRC_S45F_D,
    IRC_S45F_E,
    IRC_S45F_F,
    Person,
    TaxableYear,
    qualified_child_care_facility_45f,
};

pub enum OperatingCostKind45F { OrdinaryOperatingCost, EmployeeTraining, ScholarshipPrograms, IncreasedCompensationForTrainedEmployees, OtherPayment }

// --- (c)(1)(A)(i)-(ii): the expenditure kinds -----------------------------------------------------------------------------------------------------------

pub relation property_to_be_used_in_taxpayer_facility_45f(prop: Asset, facility: Asset) kind empirical {
    label en official "the property is to be used as part of a qualified child care facility of the taxpayer (section 45F(c)(1)(A)(i)(I)) — case-asserted";
}
pub relation property_depreciable_45f(prop: Asset) kind empirical {
    label en official "a deduction for depreciation (or amortization in lieu of depreciation) is allowable with respect to the property (section 45F(c)(1)(A)(i)(II)) — case-asserted";
}
pub relation property_part_of_principal_residence_45f(prop: Asset) kind empirical {
    label en official "the property constitutes part of the principal residence (within the meaning of section 121) of the taxpayer or any employee of the taxpayer (section 45F(c)(1)(A)(i)(III)) — case-asserted";
}
pub relation property_expenditure_45f(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount paid or incurred to acquire, construct, rehabilitate, or expand the property — case-asserted";
}
pub relation property_expenditure_qualified_45f(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45F(c)(1)(A)(i): an amount paid to acquire, construct, rehabilitate or expand depreciable property to be used as part of the taxpayer's qualified child care facility that is not part of the principal residence of the taxpayer or an employee";
}
@source(IRC_S45F_C, relation = formalizes, coverage = exact, quote = "to acquire, construct, rehabilitate, or expand property")
rule PropertyExpenditureQualifiedRule(taxpayer: Person, prop: Asset, y: TaxableYear, facility: Asset, amount: Money) strict {
    when property_expenditure_45f(taxpayer, prop, y, amount);
    when property_to_be_used_in_taxpayer_facility_45f(prop, facility);
    when qualified_child_care_facility_45f(facility, taxpayer, y);
    when property_depreciable_45f(prop);
    when not_known(property_part_of_principal_residence_45f(prop));
    then property_expenditure_qualified_45f(taxpayer, prop, y, amount);
}
pub relation operating_cost_45f(taxpayer: Person, item: Asset, y: TaxableYear, facility: Asset, kind: OperatingCostKind45F, amount: Money) kind empirical {
    label en official "an amount paid or incurred for the operating costs of the taxpayer's qualified child care facility, of the kind (section 45F(c)(1)(A)(ii)) — case-asserted";
}
pub relation operating_cost_qualified_45f(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45F(c)(1)(A)(ii): the operating costs of a qualified child care facility of the taxpayer, including costs related to the training of employees, scholarship programs, and increased compensation for employees with higher levels of child care training";
}
@source(IRC_S45F_C, relation = formalizes, coverage = exact, quote = "for the operating costs of a qualified child care facility of the taxpayer, including costs related to the training of employees, to scholarship programs, and to the providing of increased compensation to employees with higher levels of child care training")
rule OperatingCostQualifiedRule(taxpayer: Person, item: Asset, y: TaxableYear, facility: Asset, kind: OperatingCostKind45F, amount: Money) strict {
    when operating_cost_45f(taxpayer, item, y, facility, kind, amount);
    when kind != OtherPayment;
    when qualified_child_care_facility_45f(facility, taxpayer, y);
    then operating_cost_qualified_45f(taxpayer, item, y, amount);
}

// --- (d)(2)(B), (d)(4): year 1 and the tax benefit rule ---------------------------------------------------------------------------------------------------

pub relation facility_placed_in_service_taxable_year_begin_45f(facility: Asset, on: Date) kind empirical {
    label en official "the first day of the taxable year in which the qualified child care facility is placed in service by the taxpayer (section 45F(d)(2)(B)) — case-asserted";
}
pub relation recapture_year_1_begin_45f(facility: Asset, on: Date) kind institutional {
    label en official "section 45F(d)(2)(B): year 1 of the recapture table begins on the first day of the taxable year in which the qualified child care facility is placed in service by the taxpayer";
}
@source(IRC_S45F_D, relation = formalizes, coverage = exact, quote = "year 1 shall begin on the first day of the taxable year in which the qualified child care facility is placed in service by the taxpayer")
rule RecaptureYear1BeginRule(facility: Asset, on: Date) strict {
    when facility_placed_in_service_taxable_year_begin_45f(facility, on);
    then recapture_year_1_begin_45f(facility, on);
}
pub relation recapture_year_2_begin_45f(facility: Asset, on: Date) kind institutional {
    label en official "section 45F(d)(2)(B): year 2 begins 12 months after year 1";
}
rule RecaptureYear2BeginRule(facility: Asset, on: Date) strict {
    when recapture_year_1_begin_45f(facility, on);
    then recapture_year_2_begin_45f(facility, add_calendar_period(on, 12 calendar_month));
}
pub relation recapture_year_3_begin_45f(facility: Asset, on: Date) kind institutional {
    label en official "section 45F(d)(2)(B): year 3 begins 24 months after year 1";
}
rule RecaptureYear3BeginRule(facility: Asset, on: Date) strict {
    when recapture_year_1_begin_45f(facility, on);
    then recapture_year_3_begin_45f(facility, add_calendar_period(on, 24 calendar_month));
}
pub relation credit_used_to_reduce_tax_liability_45f(taxpayer: Person, prop: Asset, amount: Money) kind empirical {
    label en official "the amount of the credits allowed by reason of section 45F that were used to reduce tax liability — case-asserted";
}
pub relation recapture_amount_45f(taxpayer: Person, prop: Asset, amount: Money) kind empirical {
    label en official "the recapture amount determined under subsection (d)(1) — case-asserted";
}
pub relation tax_increase_for_recapture_45f(taxpayer: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 45F(d)(4)(A): the tax is increased under paragraph (1) only with respect to credits used to reduce tax liability";
}
@source(IRC_S45F_D, relation = formalizes, coverage = exact, quote = "The tax for the taxable year shall be increased under paragraph (1) only with respect to credits allowed by reason of this section which were used to reduce tax liability.")
rule TaxIncreaseForRecapture45fRule(taxpayer: Person, prop: Asset, recapture: Money, used: Money) strict {
    when recapture_amount_45f(taxpayer, prop, recapture);
    when credit_used_to_reduce_tax_liability_45f(taxpayer, prop, used);
    then tax_increase_for_recapture_45f(taxpayer, prop, min(recapture, used));
}
pub relation section_39_carryover_adjustment_45f(taxpayer: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 45F(d)(4)(A): for credits not used to reduce tax liability, the section 39 carryforwards and carrybacks are appropriately adjusted (the unused part of the recapture amount)";
}
rule Section39CarryoverAdjustment45fRule(taxpayer: Person, prop: Asset, recapture: Money, used: Money) strict {
    when recapture_amount_45f(taxpayer, prop, recapture);
    when credit_used_to_reduce_tax_liability_45f(taxpayer, prop, used);
    then section_39_carryover_adjustment_45f(taxpayer, prop, max(recapture - used, 0 USD));
}
pub relation recapture_increase_excluded_from_tax_for_credits_45f(taxpayer: Person, prop: Asset) kind institutional {
    label en official "section 45F(d)(4)(B): an increase in tax under subsection (d) is not treated as tax imposed by this chapter for determining any credit or for section 55";
}
@source(IRC_S45F_D, relation = formalizes, coverage = exact, quote = "Any increase in tax under this subsection shall not be treated as a tax imposed by this chapter for purposes of determining the amount of any credit under this chapter or for purposes of section 55.")
rule RecaptureIncreaseExcluded45fRule(taxpayer: Person, prop: Asset, recapture: Money) strict {
    when recapture_amount_45f(taxpayer, prop, recapture);
    then recapture_increase_excluded_from_tax_for_credits_45f(taxpayer, prop);
}

// --- (e)(1), (e)(3): single taxpayer and partnership allocation ---------------------------------------------------------------------------------------

pub relation controlled_group_52_45f(group: Person, person: Person) kind empirical {
    label en official "the person is a member of a group treated as a single employer under subsection (a) or (b) of section 52 — case-asserted";
}
pub relation treated_as_single_taxpayer_45f(a: Person, b: Person) kind institutional {
    label en official "section 45F(e)(1): all persons treated as a single employer under section 52(a) and (b) are treated as a single taxpayer";
}
@source(IRC_S45F_E, relation = formalizes, coverage = exact, quote = "All persons which are treated as a single employer under subsections (a) and (b) of section 52 shall be treated as a single taxpayer.")
rule TreatedAsSingleTaxpayer45fRule(a: Person, b: Person, group: Person) strict {
    when controlled_group_52_45f(group, a);
    when controlled_group_52_45f(group, b);
    then treated_as_single_taxpayer_45f(a, b);
}

// --- (f): the basis and no double benefit ---------------------------------------------------------------------------------------------------------------------

pub relation basis_before_reduction_45f(taxpayer: Person, prop: Asset, amount: Money) kind empirical {
    label en official "the basis of the property before the reduction — case-asserted";
}
pub relation credit_for_property_expenditure_45f(taxpayer: Person, prop: Asset, amount: Money) kind empirical {
    label en official "the credit determined by reason of expenditures described in subsection (c)(1)(A) for the property — case-asserted";
}
pub relation basis_after_credit_45f(taxpayer: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 45F(f)(1)(A): the basis of the property is reduced by the credit determined by reason of expenditures described in subsection (c)(1)(A) (not below zero)";
}
@source(IRC_S45F_F, relation = formalizes, coverage = exact, quote = "the basis of such property shall be reduced by the amount of the credit so determined")
rule BasisAfterCredit45fRule(taxpayer: Person, prop: Asset, basis: Money, credit: Money) strict {
    when basis_before_reduction_45f(taxpayer, prop, basis);
    when credit_for_property_expenditure_45f(taxpayer, prop, credit);
    then basis_after_credit_45f(taxpayer, prop, max(basis - credit, 0 USD));
}
pub relation basis_immediately_before_recapture_event_45f(taxpayer: Person, prop: Asset, amount: Money) kind empirical {
    label en official "the basis of the property, reduced under subparagraph (A), immediately before the event resulting in recapture — case-asserted";
}
pub relation basis_increased_for_recapture_45f(taxpayer: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 45F(f)(1)(B): the basis of property reduced under subparagraph (A) is increased, immediately before the recapture event, by the recapture amount (the increase in tax)";
}
@source(IRC_S45F_F, relation = formalizes, coverage = exact, quote = "the basis of such property (immediately before the event resulting in such recapture) shall be increased by an amount equal to such recapture amount")
rule BasisIncreasedForRecapture45fRule(taxpayer: Person, prop: Asset, basis: Money, recapture: Money) strict {
    when basis_immediately_before_recapture_event_45f(taxpayer, prop, basis);
    when recapture_amount_45f(taxpayer, prop, recapture);
    then basis_increased_for_recapture_45f(taxpayer, prop, basis + recapture);
}
