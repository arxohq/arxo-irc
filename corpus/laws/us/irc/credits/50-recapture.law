// Section 50 — Other special rules relating to investment credit credit_property
// (recapture on early disposition; ineligible credit_property; basis adjustment).
// Stage 2 (IRC-06 stage 2, DECISION-0379). Priority list item: §50 recapture
// 100/80/60/40/20% by year of disposition.
//
// Judgment calls:
// * §50(a)(1) is the ONLY recapture branch modelled this pass (early
//   disposition/cessation). §50(a)(2) (progress-expenditure buildings),
//   (a)(3) (semiconductor "applicable transaction"), (a)(4) (carryback/
//   carryover adjustment), (a)(5) (death/§381(a) exception), (a)(6)(B)
//   (spousal-transfer carryover) are NOT modelled — TECH_GAP, noted in
//   coverage. The recapture percentage table itself (IRC_S50_TABLE_1) is
//   anchored directly as `50-recapture.lawtable.json`, matching the
//   `25b-saver-bracket-joint.lawtable.json` convention already in this
//   package.
// * §50(b) ("certain credit_property not eligible") is modelled as ONE relation
//   `investment_credit_property_ineligible` with FOUR independent defining
//   rules (predominantly-outside-U.S. use, lodging use, tax-exempt-
//   organization use, governmental/foreign-person use), mirroring the
//   `credit_property_exempt_from_levy`/§6334(a) idiom `collection` uses for its own
//   multi-item exemption list — each rule reads only its own paragraph's
//   empirical facts, never the relation it concludes.
// * §50(c)(1)/(2) (basis reduction/restoration) is modelled as a pure
//   calculation. (c)(3) (50-percent-only basis adjustment for an energy or
//   clean-electricity credit), (c)(4)-(5) are NON_NORMATIVE cross-references
//   to sections 1245/1250/partnership-basis mechanics this package does not
//   own — noted, not modelled.
// * §50(d) ("certain rules made applicable", incorporating pre-1990 §46(e)/
//   (f)/(h) and §48(b)/(d)/(f)/(r) by cross-reference to REPEALED text) is
//   NON_NORMATIVE for this pass' operative rules: it is a historical
//   incorporation-by-reference the pinned 2024-Edition text itself frames as
//   applying "as in effect on the day before" a 1990 Act — EXTERNAL_
//   DEPENDENCY/SOURCE_GAP on the pre-1990 text, which `sources.law` does not
//   pin.

// --- §50(a)(1): early disposition recapture --------------------------------------

use self::{
    Asset,
    IRC_S50_A,
    IRC_S50_B,
    IRC_S50_C,
    Person,
    TaxableYear,
};

relation recapture_percentage_50(full_years_held: Decimal, pct: Decimal) kind institutional;

pub relation investment_credit_property_disposed_before_recapture_period_ends(credit_property: Asset, taxpayer: Person, y: TaxableYear, full_years_held: Decimal) kind empirical {
    label en official "during the taxable year the investment credit credit_property was disposed of, or otherwise ceased to be investment credit credit_property with respect to the taxpayer, before the close of the recapture period, having been held for this many full years since being placed in service (section 50(a)(1)(A))";
}
pub relation aggregate_prior_investment_credit_amount(credit_property: Asset, taxpayer: Person, amount: Money) kind institutional {
    label en official "the aggregate decrease in the credits allowed under section 38 for all prior taxable years which would result solely from reducing to zero the section 46 subpart credit determined with respect to this credit_property (section 50(a)(1)(A)) — dependency contract on the taxpayer's own credit history, produced by whichever component credit (section 47/48/etc.) was originally claimed on the credit_property";
}

pub relation credit_recapture_50(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 50(a)(1) increase in tax for the taxable year on account of an early disposition of investment credit credit_property";
}
@source(IRC_S50_A, quote = "then the tax under this chapter for such taxable year shall be increased by the recapture percentage of the aggregate decrease in the credits allowed under section 38 for all prior taxable years which would have resulted solely from reducing to zero any credit determined under this subpart with respect to such property")
rule CreditRecapture50EarlyDisposition strict {
    for credit_property: Asset;
    for taxpayer: Person;
    for y: TaxableYear;
    for full_years_held: Decimal;
    for prior_credit: Money;
    for pct: Decimal;
    when investment_credit_property_disposed_before_recapture_period_ends(credit_property, taxpayer, y, full_years_held);
    when aggregate_prior_investment_credit_amount(credit_property, taxpayer, prior_credit);
    when recapture_percentage_50(full_years_held, pct);
    then credit_recapture_50(taxpayer, y, round(pct * prior_credit, 2, "HALF_UP"));
}

// --- §50(b): credit_property not eligible ------------------------------------------------

pub relation investment_credit_property_ineligible(credit_property: Asset, y: TaxableYear) kind institutional {
    label en official "no credit shall be determined under this subpart with respect to this property for this taxable year (section 50(b))";
}

relation used_predominantly_outside_united_states(credit_property: Asset, y: TaxableYear) kind empirical;
relation section_168g4_exception_credit_property(credit_property: Asset) kind empirical {
    label en official "credit_property described in section 168(g)(4) (the section 50(b)(1)(B) exception to the outside-U.S. rule)";
}
@source(IRC_S50_B, quote = "no credit shall be determined under this subpart with respect to any property which is used predominantly outside the United States")
rule IneligibleOutsideUnitedStates strict {
    for credit_property: Asset;
    for y: TaxableYear;
    when used_predominantly_outside_united_states(credit_property, y);
    when not section_168g4_exception_credit_property(credit_property);
    then investment_credit_property_ineligible(credit_property, y);
}

relation used_predominantly_for_lodging(credit_property: Asset, y: TaxableYear) kind empirical;
relation lodging_exception_credit_property(credit_property: Asset, y: TaxableYear) kind empirical {
    label en official "one of the section 50(b)(2)(A)-(D) lodging exceptions (nonlodging commercial facility open on equal terms, hotel/motel transient-use credit_property, the qualified-rehabilitation-expenditure portion of a certified historic structure, or any energy credit_property)";
}
@source(IRC_S50_B, quote = "No credit shall be determined under this subpart with respect to any property which is used predominantly to furnish lodging or in connection with the furnishing of lodging.")
rule IneligibleLodging strict {
    for credit_property: Asset;
    for y: TaxableYear;
    when used_predominantly_for_lodging(credit_property, y);
    when not lodging_exception_credit_property(credit_property, y);
    then investment_credit_property_ineligible(credit_property, y);
}

relation used_by_exempt_organization_not_in_unrelated_business(credit_property: Asset, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "used by an organization (other than a section 521 cooperative) exempt from chapter 1 tax, other than predominantly in an unrelated trade or business taxed under section 511 (section 50(b)(3))";
}
@source(IRC_S50_B, quote = "No credit shall be determined under this subpart with respect to any property used by an organization (other than a cooperative described in section 521) which is exempt from the tax imposed by this chapter unless such property is used predominantly in an unrelated trade or business the income of which is subject to tax under section 511.")
rule IneligibleExemptOrganizationUse strict {
    for credit_property: Asset;
    for taxpayer: Person;
    for y: TaxableYear;
    when used_by_exempt_organization_not_in_unrelated_business(credit_property, taxpayer, y);
    then investment_credit_property_ineligible(credit_property, y);
}

relation used_by_governmental_unit_or_foreign_person(credit_property: Asset, y: TaxableYear) kind empirical;
relation short_term_lease_exception_50b4(credit_property: Asset, y: TaxableYear) kind empirical {
    label en official "the credit_property is used only under a lease with a term of less than 6 months (section 50(b)(4)(B)), or is a qualified rehabilitated building leased to the governmental unit or foreign person/entity (section 50(b)(4)(C))";
}
@source(IRC_S50_B, quote = "No credit shall be determined under this subpart with respect to any property used—\n(i) by the United States, any State or political subdivision thereof, any possession of the United States, or any agency or instrumentality of any of the foregoing, or\n(ii) by any foreign person or entity (as defined in section 168(h)(2)(C)), but only with respect to property to which section 168(h)(2)(A)(iii) applies (determined after the application of section 168(h)(2)(B)).")
rule IneligibleGovernmentalOrForeignUse strict {
    for credit_property: Asset;
    for y: TaxableYear;
    when used_by_governmental_unit_or_foreign_person(credit_property, y);
    when not short_term_lease_exception_50b4(credit_property, y);
    then investment_credit_property_ineligible(credit_property, y);
}

// --- §50(c)(1)-(2): basis adjustment -----------------------------------------------

pub relation investment_credit_property_basis_reduction(credit_property: Asset, taxpayer: Person, amount: Money) kind institutional {
    label en official "the reduction to the basis of investment credit credit_property required by section 50(c)(1) when a credit is determined with respect to it (full amount; the 50-percent special rule of section 50(c)(3) for an energy or clean electricity credit is a TECH_GAP not modelled this pass)";
}
relation investment_credit_determined_with_respect_to(credit_property: Asset, taxpayer: Person, amount: Money) kind institutional {
    label en official "the amount of credit determined under this subpart with respect to the credit_property — dependency contract on the component credit actually claimed";
}
@source(IRC_S50_C, quote = "if a credit is determined under this subpart with respect to any property, the basis of such property shall be reduced by the amount of the credit so determined")
rule InvestmentCreditPropertyBasisReduction strict {
    for credit_property: Asset;
    for taxpayer: Person;
    for amount: Money;
    when investment_credit_determined_with_respect_to(credit_property, taxpayer, amount);
    then investment_credit_property_basis_reduction(credit_property, taxpayer, amount);
}

pub relation investment_credit_property_basis_restoration(credit_property: Asset, taxpayer: Person, amount: Money) kind institutional {
    label en official "the section 50(c)(2) increase to the basis of investment credit credit_property, immediately before the recapture event, equal to the recapture amount";
}
@source(IRC_S50_C, quote = "the basis of such property (immediately before the event resulting in such recapture) shall be increased by an amount equal to such recapture amount")
rule InvestmentCreditPropertyBasisRestoration strict {
    for credit_property: Asset;
    for taxpayer: Person;
    for y: TaxableYear;
    for full_years_held: Decimal;
    for amount: Money;
    when investment_credit_property_disposed_before_recapture_period_ends(credit_property, taxpayer, y, full_years_held);
    when credit_recapture_50(taxpayer, y, amount);
    then investment_credit_property_basis_restoration(credit_property, taxpayer, amount);
}
