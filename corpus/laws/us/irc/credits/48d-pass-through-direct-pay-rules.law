// Section 48D — the direct payment rules for property held directly by a partnership or S corporation ((d)(2)(A)), the payment treated as a
// refund for section 1324 ((d)(2)(D)), the possession mirror code rule of (d)(4) and the guidance duty of (d)(6). Stage 2f (IRC-06,
// DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G1536). Companion of `48d-advanced-manufacturing-investment-credit.law`;
// its election and payment rules are NOT rewired to consult these relations. The section 50 similarity rules of (d)(5) and the section 46
// similarity rule of (b)(5) stay TECH_GAP.
//
// Judgment calls: the election of a partnership or S corporation is asserted by its own exercise fact; the payment equal to the credit is
// the asserted credit amount; the guidance duty of (d)(6) has no date in the statute and is therefore an external directive; the tax exempt
// income of a partner follows the partner's distributive share of the otherwise applicable credit (fraction, cents HALF_UP).

// --- (d)(2)(A): partnerships and S corporations -------------------------------------------------------------------------------------------------------------

use self::{
    Asset,
    IRC_S48D_D,
    Person,
    TaxableYear,
};

pub relation property_held_directly_by_pass_through_48d(prop: Asset, pt_entity: Person) kind empirical {
    label en official "the property is held directly by the partnership or S corporation (section 48D(d)(2)(A)) — case-asserted";
}
pub relation pass_through_elects_direct_pay_48d(pt_entity: Person, prop: Asset) kind empirical {
    label en official "the partnership or S corporation makes the election under paragraph (1), in such manner as the Secretary may provide, with respect to the credit for the property (section 48D(d)(2)(A)(i))";
}
pub relation partner_or_shareholder_of_48d(owner: Person, pt_entity: Person) kind empirical {
    label en official "the person is a partner or shareholder of the partnership or S corporation — case-asserted";
}
pub relation owner_elects_direct_pay_for_pass_through_property_48d(owner: Person, prop: Asset) kind empirical {
    label en official "a partner or shareholder attempts to make an election under paragraph (1) with respect to the credit for property held directly by the partnership or S corporation — case-asserted";
}
pub relation election_by_owner_disallowed_48d(owner: Person, prop: Asset) kind institutional {
    label en official "section 48D(d)(2)(A)(ii): for property held directly by a partnership or S corporation, no election by any partner or shareholder is allowed with respect to the credit";
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "no election by any partner or shareholder shall be allowed under paragraph (1) with respect to any credit determined under subsection (a) with respect to such property")
rule ElectionByOwnerDisallowedRule(owner: Person, prop: Asset, pt_entity: Person) strict {
    when property_held_directly_by_pass_through_48d(prop, pt_entity);
    when partner_or_shareholder_of_48d(owner, pt_entity);
    when owner_elects_direct_pay_for_pass_through_property_48d(owner, prop);
    then election_by_owner_disallowed_48d(owner, prop);
}
pub relation credit_of_pass_through_property_48d(prop: Asset, amount: Money) kind empirical {
    label en official "the credit determined under subsection (a) with respect to the property held directly by the partnership or S corporation — case-asserted";
}
pub relation election_made_by_pass_through_48d(pt_entity: Person, prop: Asset) kind institutional {
    label en official "section 48D(d)(2)(A)(i): for the credit for property held directly by a partnership or S corporation, the election is made by the partnership or S corporation";
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "any election under paragraph (1) shall be made by such partnership or S corporation")
rule ElectionMadeByPassThroughRule(pt_entity: Person, prop: Asset) strict {
    when property_held_directly_by_pass_through_48d(prop, pt_entity);
    when pass_through_elects_direct_pay_48d(pt_entity, prop);
    then election_made_by_pass_through_48d(pt_entity, prop);
}
pub relation secretary_payment_to_pass_through_48d(pt_entity: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 48D(d)(2)(A)(i)(I): the Secretary makes a payment to the partnership or S corporation equal to the amount of the credit";
}
rule SecretaryPaymentToPassThroughRule(pt_entity: Person, prop: Asset, amount: Money) strict {
    when election_made_by_pass_through_48d(pt_entity, prop);
    when credit_of_pass_through_property_48d(prop, amount);
    then secretary_payment_to_pass_through_48d(pt_entity, prop, amount);
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "the Secretary shall make a payment to such partnership or S corporation equal to the amount of such credit")
rule Section48dD2AISecretaryPaymentDutyRule(pt_entity: Person, prop: Asset, amount: Money) strict {
    when election_made_by_pass_through_48d(pt_entity, prop);
    when credit_of_pass_through_property_48d(prop, amount);
    then duty Section48dD2AISecretaryPaymentDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_payment_made_to_pass_through_48d(pt_entity, prop);
            window [@2023-01-01, infinity);
        }
    };
}
pub relation secretary_payment_made_to_pass_through_48d(pt_entity: Person, prop: Asset) kind empirical {
    label en official "the Secretary has made the payment to the partnership or S corporation — case-asserted";
}
pub relation credit_applied_before_distributive_share_48d(prop: Asset, amount: Money) kind institutional {
    label en official "section 48D(d)(2)(A)(i)(II): paragraph (3) (the limitation on the credit) is applied to the credit before determining any partner's distributive share or shareholder's pro rata share";
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "paragraph (3) shall be applied with respect to such credit before determining any partner's distributive share, or shareholder's pro rata share, of such credit")
rule CreditAppliedBeforeDistributiveShareRule(pt_entity: Person, prop: Asset, amount: Money) strict {
    when election_made_by_pass_through_48d(pt_entity, prop);
    when credit_of_pass_through_property_48d(prop, amount);
    then credit_applied_before_distributive_share_48d(prop, amount);
}
pub relation amount_treated_as_tax_exempt_income_48d(pt_entity: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 48D(d)(2)(A)(i)(III): any amount with respect to which the election is made is treated as tax exempt income for purposes of sections 705 and 1366";
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "any amount with respect to which the election in paragraph (1) is made shall be treated as tax exempt income for purposes of sections 705 and 1366")
rule AmountTreatedAsTaxExemptIncomeRule(pt_entity: Person, prop: Asset, amount: Money) strict {
    when election_made_by_pass_through_48d(pt_entity, prop);
    when credit_of_pass_through_property_48d(prop, amount);
    then amount_treated_as_tax_exempt_income_48d(pt_entity, prop, amount);
}
pub relation owner_distributive_share_of_credit_48d(owner: Person, prop: Asset, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the partner's distributive share (as a fraction) of the otherwise applicable credit for the taxable year (section 48D(d)(2)(A)(i)(IV)) — case-asserted";
}
pub relation owner_distributive_share_of_tax_exempt_income_48d(owner: Person, pt_entity: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(d)(2)(A)(i)(IV): a partner's distributive share of the tax exempt income is based on the partner's distributive share of the otherwise applicable credit for each taxable year (cents HALF_UP)";
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "a partner's distributive share of such tax exempt income shall be based on such partner's distributive share of the otherwise applicable credit for each taxable year")
rule OwnerDistributiveShareOfTaxExemptIncomeRule(owner: Person, pt_entity: Person, prop: Asset, y: TaxableYear, credit: Money, share: Decimal) strict {
    when partner_or_shareholder_of_48d(owner, pt_entity);
    when amount_treated_as_tax_exempt_income_48d(pt_entity, prop, credit);
    when owner_distributive_share_of_credit_48d(owner, prop, y, share);
    then owner_distributive_share_of_tax_exempt_income_48d(owner, pt_entity, prop, y, round(credit / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}

// --- (d)(2)(D): section 1324; (d)(4): possessions; (d)(6): guidance -------------------------------------------------------------------------------------

pub relation payment_treated_as_refund_for_section_1324_48d(pt_entity: Person, prop: Asset) kind institutional {
    label en official "section 48D(d)(2)(D): for section 1324 of title 31, the payments under subparagraph (A)(i)(I) are treated as a refund due from a credit provision referred to in subsection (b)(2) of that section";
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "the payments under subparagraph (A)(i)(I) shall be treated in the same manner as a refund due from a credit provision referred to in subsection (b)(2) of such section")
rule PaymentTreatedAsRefundForSection1324Rule(pt_entity: Person, prop: Asset, amount: Money) strict {
    when secretary_payment_to_pass_through_48d(pt_entity, prop, amount);
    then payment_treated_as_refund_for_section_1324_48d(pt_entity, prop);
}
pub relation possession_with_mirror_code_tax_system_48d(possession: Person) kind empirical {
    label en official "the possession of the United States has a mirror code tax system (as defined in section 24(k)) (section 48D(d)(4)) — case-asserted";
}
pub relation possession_elects_subsection_treated_as_income_tax_law_48d(possession: Person) kind empirical {
    label en official "the possession elects to have subsection (d) treated as part of the income tax laws for purposes of determining its income tax law (section 48D(d)(4)) — case-asserted";
}
pub relation subsection_d_part_of_possession_income_tax_law_48d(possession: Person) kind institutional {
    label en official "section 48D(d)(4): for a possession with a mirror code tax system, subsection (d) is not treated as part of the income tax laws of the United States for determining the income tax law of the possession unless the possession elects";
}
@source(IRC_S48D_D, relation = formalizes, coverage = exact, quote = "this subsection shall not be treated as part of the income tax laws of the United States for purposes of determining the income tax law of such possession unless such possession elects to have this subsection be so treated")
rule SubsectionDPartOfPossessionIncomeTaxLawRule(possession: Person) strict {
    when possession_with_mirror_code_tax_system_48d(possession);
    when possession_elects_subsection_treated_as_income_tax_law_48d(possession);
    then subsection_d_part_of_possession_income_tax_law_48d(possession);
}
