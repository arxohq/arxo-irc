// Credits -- WIRE-10, group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Norms that the credits package lacked and that consumer packages of group B need as `pub` relations. Each block names the
// consumer that reads it. Case facts stay a valid channel for every consumer (WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

use self::{
    Asset,
    ControlledGroup,
    Corporation,
    IRC_S24_H,
    IRC_S45D_E,
    IRC_S52_A,
    Individual,
    Person,
    TaxableYear,
    low_income_community_45d,
    section_52_controlled_group_member,
    ssn_included_24h7,
};

// --- section 24(h)(7): "social security number" (read by payment_refunds_interest, sections 6428, 6428A, 6428B) ----------------

pub relation ssn_issued_by_social_security_administration(holder: Person) kind empirical {
    label en official "a social security number issued to an individual by the Social Security Administration (section 24(h)(7))";
}
pub relation ssn_issued_to_citizen_or_205c2Bi_I_alien(holder: Person) kind empirical {
    label en official "the social security number is issued to a citizen of the United States or pursuant to subclause (I) (or that portion of subclause (III) that relates to subclause (I)) of section 205(c)(2)(B)(i) of the Social Security Act (section 24(h)(7)(A))";
}
pub relation ssn_issue_date(holder: Person, d: Date) kind empirical {
    label en unofficial "the date on which the social security number was issued to the individual";
}
pub relation return_due_date_for_ssn_24h7(filer: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the due date for the return of tax of the filer for the taxable year, as compared with the issue date of a social security number under section 24(h)(7)(B)";
}
pub relation ssn_holder_number_on_return_of(holder: Person, filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the filer includes the social security number of the holder on the return of tax for the taxable year";
}

@source(IRC_S24_H, relation = formalizes, coverage = partial, quote = "the term \"social security number\" means a social security number issued to an individual by the Social Security Administration, but only if the social security number is issued")
pub relation social_security_number_24h7(holder: Person, filer: Person, y: TaxableYear) kind institutional {
    label en official "the term \"social security number\" of section 24(h)(7): issued by the Social Security Administration, to a citizen or under section 205(c)(2)(B)(i)(I), and before the due date for the filer's return";
}
@source(IRC_S24_H, relation = formalizes, coverage = partial, quote = "the term \"social security number\" means a social security number issued to an individual by the Social Security Administration, but only if the social security number is issued")
rule W10SocialSecurityNumber24h7Definition(holder: Person, filer: Person, y: TaxableYear, issued: Date, due: Date) strict {
    label en official "a number issued by the Social Security Administration to a citizen or a section 205(c)(2)(B)(i)(I) person before the due date for the return is a social security number under section 24(h)(7)";
    when ssn_issued_by_social_security_administration(holder);
    when ssn_issued_to_citizen_or_205c2Bi_I_alien(holder);
    when ssn_issue_date(holder, issued);
    when return_due_date_for_ssn_24h7(filer, y, due);
    when issued < due;
    then social_security_number_24h7(holder, filer, y);
}

pub relation social_security_number_24h7_included_on_return(holder: Person, filer: Person, y: TaxableYear) kind institutional {
    label en official "the filer includes on the return of tax for the taxable year a social security number of the holder that satisfies section 24(h)(7)";
}
@source(IRC_S24_H, relation = formalizes, coverage = partial, quote = "unless the taxpayer includes the social security number of such child on the return of tax for the taxable year")
rule W10SocialSecurityNumberIncludedOnReturn(holder: Person, filer: Person, y: TaxableYear) strict {
    label en official "a social security number under section 24(h)(7) that the filer includes on the return is a valid number included on the return";
    when social_security_number_24h7(holder, filer, y);
    when ssn_holder_number_on_return_of(holder, filer, y);
    then social_security_number_24h7_included_on_return(holder, filer, y);
}

@source(IRC_S24_H, relation = formalizes, coverage = partial, quote = "unless the taxpayer includes the social security number of such child on the return of tax for the taxable year")
rule W10ChildSsnIncludedFromDefinition24h7(taxpayer: Individual, child: Person, y: TaxableYear) strict {
    label en official "the section 24(h)(7) social security number of the child included on the taxpayer's return is the fact the child tax credit reads";
    when social_security_number_24h7_included_on_return(child, taxpayer, y);
    then ssn_included_24h7(taxpayer, child, y);
}

// --- section 45D(e): low-income community (read by property_transactions, section 1400Z-1(c)(1), 2024 text) -------------------------
// Owner-derives-consumer technique: property_transactions cannot import credits (cycle through gross_income), so this package derives
// the pub stub of the lower consumer. The consumer's census tract entity is a subtype of `core::Asset`, the key of section 45D here.

@source(IRC_S45D_E, relation = formalizes, coverage = partial, quote = "the poverty rate for such tract is at least 20 percent")
rule W10LowIncomeCommunityForSection1400Z1(tract: us.irc.property_transactions::CensusTract) strict {
    label en official "a census tract that is a low-income community under section 45D(e) is one for the 2024 text of section 1400Z-1(c)(1)";
    when low_income_community_45d(tract);
    then us.irc.property_transactions::low_income_community_45d(tract);
}

// --- section 52(a): persons treated as a single employer (read by accounting, section 453A(b)(2)) --------------------------------
// Pairwise reading of the group-member relation: two corporations of the same section 52(a) controlled group are treated as a
// single employer. The section 52(b) branch (trades or businesses under common control) is keyed by year and stays with the group
// relations of the year-keyed consumers.

pub relation treated_as_single_employer_52a(a: Person, b: Person) kind institutional {
    label en official "the two corporations are members of the same section 52(a) controlled group and are treated as employed by a single employer";
}
@source(IRC_S52_A, relation = formalizes, coverage = partial, quote = "all employees of all corporations which are members of the same controlled group of corporations shall be treated as employed by a single employer")
rule W10SingleEmployerSection52a defeasible {
    label en official "corporations that are members of the same section 52(a) controlled group are treated as a single employer";
    for group: us.irc.corporations::ControlledGroup;
    for a: Corporation;
    for b: Corporation;
    when section_52_controlled_group_member(group, a);
    when section_52_controlled_group_member(group, b);
    then treated_as_single_employer_52a(a, b);
}
