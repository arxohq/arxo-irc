// Section 48C — the qualifying advanced energy project of (c)(1) and its exclusion, the eligible property of (c)(2), the application window
// and evidence periods of (d)(2) and (e)(3), the additional program of (d)(4)(C), the census tract description of (e)(2), the invalidity of a
// certification for a materially different location (e)(3)(D), and the prevailing wage requirement of (e)(5)(A). Stage 2f (IRC-06,
// DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G1536). Companion of
// `48c-qualifying-advanced-energy-project-credit.law`; its credit rules read the qualified investment and the wage and apprenticeship
// requirements as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the project kinds of (c)(1)(A)(i)(I)-(IX) are one enum fact of what the facility produces or recycles; the "other ... as
// may be determined by the Secretary" kinds are external judgments (DECISION-0194); "greenhouse gas reduction of at least 20 percent"
// is a fraction fact.

use self::{
    AllocationRound48C,
    Asset,
    IRC_S48C_C,
    IRC_S48C_D,
    IRC_S48C_E,
    Person,
    allocation_round_48c,
    certified_project_48c,
};

pub enum ProjectProduct48C {
    RenewableEnergyProperty,
    FuelCellsMicroturbinesOrStorage,
    GridModernizationEquipment,
    CarbonOxideCaptureProperty,
    RenewableOrLowCarbonFuelEquipment,
    EnergyConservationTechnologies,
    ElectricOrFuelCellVehicles,
    HybridVehiclesOver14000Pounds,
    OtherProduct
}
pub enum ReductionInstall48C {
    LowCarbonProcessHeat,
    CarbonCaptureTransportUtilizationStorage,
    EnergyEfficiencyAndWasteReduction,
    OtherInstall
}

// --- (c)(1): the qualifying advanced energy project ----------------------------------------------------------------------------------------------------

pub relation facility_action_reequips_expands_or_establishes_48c(project: Asset) kind empirical {
    label en official "the project re-equips, expands, or establishes an industrial or manufacturing facility (section 48C(c)(1)(A)(i)) — case-asserted";
}
pub relation facility_action_reequips_48c(project: Asset) kind empirical {
    label en official "the project re-equips an industrial or manufacturing facility (section 48C(c)(1)(A)(ii)) — case-asserted";
}
pub relation project_product_48c(project: Asset, product: ProjectProduct48C) kind empirical {
    label en official "the kind of property the facility produces or recycles under section 48C(c)(1)(A)(i)(I)-(IX) — case-asserted";
}
pub relation product_fuel_renewable_or_low_carbon_48c(project: Asset) kind empirical {
    label en official "the fuel, chemical, or product refined, electrolyzed or blended is renewable, or low-carbon and low-emission (section 48C(c)(1)(A)(i)(V)) — case-asserted";
}
external judgment relation secretary_determines_other_advanced_energy_property_48c(project: Asset) {
    authority Secretary;
    label en official "the Secretary determines that the property is other advanced energy property designed to reduce greenhouse gas emissions (section 48C(c)(1)(A)(i)(IX))";
}
pub relation reequip_ghg_reduction_fraction_48c(project: Asset, fraction: Decimal) kind empirical {
    label en official "the reduction of greenhouse gas emissions the equipment is designed to achieve, as a fraction (section 48C(c)(1)(A)(ii)) — case-asserted";
}
pub relation reequip_install_48c(project: Asset, install: ReductionInstall48C) kind empirical {
    label en official "the kind of installation of the re-equipping (section 48C(c)(1)(A)(ii)(I)-(IV)) — case-asserted";
}
external judgment relation secretary_determines_other_industrial_technology_48c(project: Asset) {
    authority Secretary;
    label en official "the Secretary determines that the technology is other industrial technology designed to reduce greenhouse gas emissions (section 48C(c)(1)(A)(ii)(IV))";
}
pub relation facility_processes_refines_or_recycles_critical_materials_48c(project: Asset) kind empirical {
    label en official "the project re-equips, expands, or establishes an industrial facility for the processing, refining, or recycling of critical materials as defined in section 7002(a) of the Energy Act of 2020 (section 48C(c)(1)(A)(iii)) — case-asserted";
}
pub relation project_type_qualifies_48c(project: Asset) kind institutional {
    label en official "section 48C(c)(1)(A): a project which re-equips, expands or establishes a facility for the production or recycling of listed property, re-equips a facility to reduce greenhouse gas emissions by at least 20 percent, or processes, refines or recycles critical materials";
}
@source(IRC_S48C_C, relation = formalizes, coverage = exact, quote = "which re-equips, expands, or establishes an industrial or manufacturing facility for the production or recycling of")
rule ProjectTypeProductionRule(project: Asset, product: ProjectProduct48C) defeasible {
    when facility_action_reequips_expands_or_establishes_48c(project);
    when project_product_48c(project, product);
    when product != RenewableOrLowCarbonFuelEquipment;
    when product != OtherProduct;
    then project_type_qualifies_48c(project);
}
@source(IRC_S48C_C, relation = formalizes, coverage = exact, quote = "equipment designed to refine, electrolyze, or blend any fuel, chemical, or product which is")
rule ProjectTypeFuelEquipmentRule(project: Asset) defeasible {
    when facility_action_reequips_expands_or_establishes_48c(project);
    when project_product_48c(project, RenewableOrLowCarbonFuelEquipment);
    when product_fuel_renewable_or_low_carbon_48c(project);
    then project_type_qualifies_48c(project);
}
@source(IRC_S48C_C, relation = formalizes, coverage = exact, quote = "other advanced energy property designed to reduce greenhouse gas emissions as may be determined by the Secretary")
rule ProjectTypeOtherProductRule(project: Asset) defeasible {
    when facility_action_reequips_expands_or_establishes_48c(project);
    when project_product_48c(project, OtherProduct);
    when secretary_determines_other_advanced_energy_property_48c(project);
    then project_type_qualifies_48c(project);
}
@source(IRC_S48C_C, relation = formalizes, coverage = exact, quote = "which re-equips an industrial or manufacturing facility with equipment designed to reduce greenhouse gas emissions by at least 20 percent through the installation of")
rule ProjectTypeReequipRule(project: Asset, fraction: Decimal, install: ReductionInstall48C) defeasible {
    when facility_action_reequips_48c(project);
    when reequip_ghg_reduction_fraction_48c(project, fraction);
    when fraction >= 0.20;
    when reequip_install_48c(project, install);
    when install != OtherInstall;
    then project_type_qualifies_48c(project);
}
rule ProjectTypeReequipOtherInstallRule(project: Asset, fraction: Decimal) defeasible {
    when facility_action_reequips_48c(project);
    when reequip_ghg_reduction_fraction_48c(project, fraction);
    when fraction >= 0.20;
    when reequip_install_48c(project, OtherInstall);
    when secretary_determines_other_industrial_technology_48c(project);
    then project_type_qualifies_48c(project);
}
@source(IRC_S48C_C, relation = formalizes, coverage = exact, quote = "which re-equips, expands, or establishes an industrial facility for the processing, refining, or recycling of critical materials")
rule ProjectTypeCriticalMaterialsRule(project: Asset) defeasible {
    when facility_processes_refines_or_recycles_critical_materials_48c(project);
    then project_type_qualifies_48c(project);
}
pub relation portion_produces_property_for_refining_transport_fuel_48c(project: Asset) kind empirical {
    label en official "the portion of the project produces property used in the refining or blending of a transportation fuel (section 48C(c)(1)(B)) — case-asserted";
}
pub relation transport_fuel_is_renewable_fuel_48c(project: Asset) kind empirical {
    label en official "the transportation fuel is a renewable fuel (section 48C(c)(1)(B)) — case-asserted";
}
relation excluded_fuel_refining_portion_48c(project: Asset) kind institutional;
rule ExcludedFuelRefiningPortionRule(project: Asset) strict {
    when portion_produces_property_for_refining_transport_fuel_48c(project);
    when not_known(transport_fuel_is_renewable_fuel_48c(project));
    then excluded_fuel_refining_portion_48c(project);
}
pub relation qualifying_project_portion_48c(project: Asset) kind institutional {
    label en official "section 48C(c)(1): a qualifying project portion: of a qualifying project type, excluding any portion producing property used in refining or blending transportation fuel other than renewable fuels";
}
rule QualifyingProjectPortionRule(project: Asset) defeasible {
    when project_type_qualifies_48c(project);
    unless excluded_fuel_refining_portion_48c(project);
    then qualifying_project_portion_48c(project);
}

// --- (c)(2): eligible property ---------------------------------------------------------------------------------------------------------------------------

pub relation part_necessary_for_project_kind_48c(part: Asset, project: Asset) kind empirical {
    label en official "the property is necessary for the production or recycling of the property of clause (i), the re-equipping of clause (ii), or the re-equipping, expansion or establishment of clause (iii) (section 48C(c)(2)(A)) — case-asserted";
}
pub relation part_is_tangible_personal_property_48c(part: Asset) kind empirical {
    label en official "the property is tangible personal property (section 48C(c)(2)(B)(i)) — case-asserted";
}
pub relation part_is_integral_tangible_property_48c(part: Asset) kind empirical {
    label en official "the property is other tangible property (not a building or its structural components) used as an integral part of the qualified investment credit facility (section 48C(c)(2)(B)(ii)) — case-asserted";
}
pub relation part_depreciation_allowable_48c(part: Asset) kind empirical {
    label en official "depreciation (or amortization in lieu of depreciation) is allowable with respect to the property (section 48C(c)(2)(C)) — case-asserted";
}
pub relation eligible_property_48c(part: Asset, project: Asset) kind institutional {
    label en official "section 48C(c)(2): property necessary for the project types, that is tangible personal property or integral tangible property, and depreciable";
}
@source(IRC_S48C_C, relation = formalizes, coverage = exact, quote = "The term \"eligible property\" means any property")
rule EligiblePropertyTangiblePersonalRule(part: Asset, project: Asset) defeasible {
    when qualifying_project_portion_48c(project);
    when part_necessary_for_project_kind_48c(part, project);
    when part_is_tangible_personal_property_48c(part);
    when part_depreciation_allowable_48c(part);
    then eligible_property_48c(part, project);
}
rule EligiblePropertyIntegralRule(part: Asset, project: Asset) defeasible {
    when qualifying_project_portion_48c(project);
    when part_necessary_for_project_kind_48c(part, project);
    when part_is_integral_tangible_property_48c(part);
    when part_depreciation_allowable_48c(part);
    then eligible_property_48c(part, project);
}

// --- (d)(2), (e)(3): application windows and evidence periods -------------------------------------------------------------------------------------

pub relation program_established_on_48c(round: AllocationRound48C, on: Date) kind empirical {
    label en official "the date the Secretary establishes the program for the round — case-asserted";
}
pub relation application_submitted_on_48c(applicant: Person, project: Asset, on: Date) kind empirical {
    label en official "the applicant submits the application for certification on this date — case-asserted";
}
pub relation application_within_window_48c(applicant: Person, project: Asset) kind institutional {
    label en official "section 48C(d)(2)(A): the application is submitted during the 2-year period beginning on the date the Secretary establishes the program";
}
@source(IRC_S48C_D, relation = formalizes, coverage = exact, quote = "during the 2-year period beginning on the date the Secretary establishes the program under paragraph (1)")
rule ApplicationWithinWindowRule(applicant: Person, project: Asset, on: Date, start: Date) strict {
    when application_submitted_on_48c(applicant, project, on);
    when program_established_on_48c(OriginalProgramSubsectionD, start);
    when on >= start;
    when on < add_calendar_period(start, 24 calendar_month);
    then application_within_window_48c(applicant, project);
}
pub relation application_accepted_on_48c(applicant: Person, project: Asset, on: Date) kind empirical {
    label en official "the Secretary accepts the application on this date — case-asserted";
}
pub relation evidence_that_certification_requirements_met_48c(applicant: Person, project: Asset) kind empirical {
    label en official "the applicant has provided the Secretary evidence that the requirements of the certification have been met — case-asserted";
}
@source(IRC_S48C_D, relation = formalizes, coverage = exact, quote = "Each applicant for certification shall have 1 year from the date of acceptance by the Secretary of the application during which to provide to the Secretary evidence that the requirements of the certification have been met.")
rule Section48cD2BEvidenceDutyRule(applicant: Person, project: Asset, accepted: Date) strict {
    when application_accepted_on_48c(applicant, project, accepted);
    then duty Section48cD2BEvidenceDuty {
        bearer applicant;
        goal achievement {
            condition evidence_that_certification_requirements_met_48c(applicant, project);
            window [accepted, add_calendar_period(accepted, 12 calendar_month)];
        }
    };
}
@source(IRC_S48C_E, relation = formalizes, coverage = exact, quote = "Each applicant for certification shall have 2 years from the date of acceptance by the Secretary of the application during which to provide to the Secretary evidence that the requirements of the certification have been met.")
rule Section48cE3BEvidenceDutyRule(applicant: Person, project: Asset, accepted: Date) strict {
    when application_accepted_on_48c(applicant, project, accepted);
    when allocation_round_48c(project, ExpandedProgramSubsectionE);
    then duty Section48cE3BEvidenceDuty {
        bearer applicant;
        goal achievement {
            condition evidence_that_certification_requirements_met_48c(applicant, project);
            window [accepted, add_calendar_period(accepted, 24 calendar_month)];
        }
    };
}

// --- (d)(4)(C): the additional program ---------------------------------------------------------------------------------------------------------------

pub relation credits_available_for_reallocation_48c(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary determines that credits under section 48C are available for reallocation pursuant to the requirements of paragraph (2) — case-asserted";
}
pub relation secretary_conducts_additional_program_48c(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary's exercise of the authority of section 48C(d)(4)(C) to conduct an additional program for applications for certification — case-asserted";
}
pub relation additional_program_conducted_48c(secretary: us.irc.core::Organ) kind institutional {
    label en official "an additional program for applications for certification is conducted";
}
@source(IRC_S48C_D, relation = formalizes, coverage = exact, quote = "the Secretary is authorized to conduct an additional program for applications for certification")
rule Section48cD4CAdditionalProgramPowerRule(secretary: us.irc.core::Organ) strict {
    when credits_available_for_reallocation_48c(secretary);
    then power Section48cD4CAdditionalProgram {
        holder us.irc.core::Secretary;
        over us.irc.core::Secretary;
        exercise secretary_conducts_additional_program_48c(secretary);
        valid_when credits_available_for_reallocation_48c(secretary);
        effect create(additional_program_conducted_48c(secretary));
        window [@2009-02-17, infinity);
    };
}

// --- (e)(2)-(3): the census tract and the location of the certified project ---------------------------------------------------------------------------

pub relation tract_described_in_45b11b_iii_48c(tract: Asset) kind empirical {
    label en official "the census tract is described in clause (iii) of section 45(b)(11)(B) (section 48C(e)(2)(A)) — case-asserted external classification";
}
pub relation tract_had_project_certified_under_d_before_enactment_48c(tract: Asset) kind empirical {
    label en official "prior to the enactment of subsection (e), a project in the tract received a certification and allocation of credits under subsection (d) (section 48C(e)(2)(B)) — case-asserted";
}
pub relation census_tract_for_expanded_program_48c(tract: Asset) kind institutional {
    label en official "section 48C(e)(2): a census tract described in section 45(b)(11)(B)(iii) that, before the enactment of subsection (e), had no project which received a certification and allocation of credits under subsection (d)";
}
@source(IRC_S48C_E, relation = formalizes, coverage = exact, quote = "is described in clause (iii) of section 45(b)(11)(B), and")
rule CensusTractForExpandedProgramRule(tract: Asset) strict {
    when tract_described_in_45b11b_iii_48c(tract);
    when not_known(tract_had_project_certified_under_d_before_enactment_48c(tract));
    then census_tract_for_expanded_program_48c(tract);
}
external judgment relation secretary_determines_materially_different_location_48c(project: Asset) {
    authority Secretary;
    label en official "the Secretary determines that the project has been placed in service at a location which is materially different than the location specified in the application (section 48C(e)(3)(D))";
}
pub relation certification_remains_valid_48c(project: Asset) kind institutional {
    label en official "section 48C(e)(3)(D): a certification is no longer valid if the Secretary determines that the project has been placed in service at a materially different location than specified in the application";
}
@source(IRC_S48C_E, relation = formalizes, coverage = exact, quote = "the certification shall no longer be valid")
rule CertificationRemainsValidRule(project: Asset) defeasible {
    when certified_project_48c(project);
    unless secretary_determines_materially_different_location_48c(project);
    then certification_remains_valid_48c(project);
}

// --- (e)(5)(A): the prevailing wage requirement ------------------------------------------------------------------------------------------------------

pub relation wages_at_least_prevailing_for_project_48c(project: Asset) kind empirical {
    label en official "laborers and mechanics employed by the taxpayer or any contractor or subcontractor in the re-equipping, expansion, or establishment of a manufacturing facility are paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality, as most recently determined by the Secretary of Labor (section 48C(e)(5)(A)) — case-asserted";
}
pub relation prevailing_wage_requirement_met_48c(project: Asset) kind institutional {
    label en official "section 48C(e)(5)(A): prevailing wages are paid in the re-equipping, expansion or establishment of the manufacturing facility";
}
@source(IRC_S48C_E, relation = formalizes, coverage = exact, quote = "shall be paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality in which such project is located")
rule PrevailingWageRequirementMetRule(project: Asset) strict {
    when wages_at_least_prevailing_for_project_48c(project);
    then prevailing_wage_requirement_met_48c(project);
}
