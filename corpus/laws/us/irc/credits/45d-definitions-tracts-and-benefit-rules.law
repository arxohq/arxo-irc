// Section 45D — the equity investment and qualified community development entity definitions, qualified low-income community investments,
// the extensions of the qualified active low-income community business, the qualified business of (d)(3), the low-income community rules
// of (e)(3)-(5), the tax benefit rule of (g)(4) and the basis rule of (h). Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage
// 2c rows of TECH-GAPS G1778). Companion of `45d-new-markets-tax-credit.law`; its credit rules read the equity investment and entity tests as
// case facts and are NOT rewired to require these relations.
//
// Judgment calls: the qualified business of section 1397C(d) is one case fact (the business is a qualified business other than the two
// rental and (d)(3) provisions this subsection modifies); the certification of an entity, the services specified by regulations and the
// targeted populations are external judgments or directives (DECISION-0194); the low-income community of (e)(4) is a new relation that
// includes the existing (e)(1) relation, so no predicate cycle arises.

use self::{
    Asset,
    IRC_S45D_B,
    IRC_S45D_C,
    IRC_S45D_D,
    IRC_S45D_E,
    IRC_S45D_G,
    IRC_S45D_H,
    Person,
    TaxableYear,
    basis_reduction_45d,
    credit_recapture_amount_45d,
    low_income_community_45d,
    qualified_active_low_income_community_business_45d,
};

pub enum EquityForm45D { CorporateStock, NonqualifiedPreferredStock, PartnershipCapitalInterest, OtherInterest }
pub enum QliciKind45D { InvestmentOrLoanToBusiness, PurchaseOfQlichLoanFromCde, CounselingAndServices, InvestmentOrLoanToCde }

// --- (b)(4), (b)(6): the equity investment and prior holders -------------------------------------------------------------------------------------

pub relation equity_form_45d(investment: Asset, form: EquityForm45D) kind empirical {
    label en official "the form of the investment: stock, nonqualified preferred stock, or a capital interest in a partnership (section 45D(b)(6)) — case-asserted";
}
pub relation entity_is_corporation_45d(investment: Asset) kind empirical {
    label en official "the entity in which the investment is held is a corporation — case-asserted";
}
pub relation entity_is_partnership_45d(investment: Asset) kind empirical {
    label en official "the entity in which the investment is held is a partnership — case-asserted";
}
pub relation equity_investment_45d(investment: Asset) kind institutional {
    label en official "section 45D(b)(6): any stock (other than nonqualified preferred stock as defined in section 351(g)(2)) in a corporation, and any capital interest in a partnership";
}
@source(IRC_S45D_B, relation = formalizes, coverage = exact, quote = "any stock (other than nonqualified preferred stock as defined in section 351(g)(2)) in an entity which is a corporation")
rule EquityInvestmentStockRule(investment: Asset) strict {
    when equity_form_45d(investment, CorporateStock);
    when entity_is_corporation_45d(investment);
    then equity_investment_45d(investment);
}
@source(IRC_S45D_B, relation = formalizes, coverage = exact, quote = "any capital interest in an entity which is a partnership")
rule EquityInvestmentPartnershipRule(investment: Asset) strict {
    when equity_form_45d(investment, PartnershipCapitalInterest);
    when entity_is_partnership_45d(investment);
    then equity_investment_45d(investment);
}
pub relation would_be_qualified_equity_investment_but_for_original_issue_45d(taxpayer: Person, investment: Asset) kind empirical {
    label en official "the equity investment would, but for paragraph (1)(A) (acquisition at original issue solely for cash), be a qualified equity investment in the hands of the taxpayer (section 45D(b)(4)) — case-asserted";
}
pub relation was_qualified_equity_investment_in_hands_of_prior_holder_45d(investment: Asset) kind empirical {
    label en official "the investment was a qualified equity investment in the hands of a prior holder (section 45D(b)(4)) — case-asserted";
}
pub relation qualified_equity_investment_of_later_holder_45d(taxpayer: Person, investment: Asset) kind institutional {
    label en official "section 45D(b)(4): an equity investment that was a qualified equity investment in the hands of a prior holder qualifies in the hands of the taxpayer if it would otherwise qualify but for the original issue requirement";
}
@source(IRC_S45D_B, relation = formalizes, coverage = exact, quote = "includes any equity investment which would (but for paragraph (1)(A)) be a qualified equity investment in the hands of the taxpayer if such investment was a qualified equity investment in the hands of a prior holder")
rule QualifiedEquityInvestmentOfLaterHolderRule(taxpayer: Person, investment: Asset) strict {
    when would_be_qualified_equity_investment_but_for_original_issue_45d(taxpayer, investment);
    when was_qualified_equity_investment_in_hands_of_prior_holder_45d(investment);
    then qualified_equity_investment_of_later_holder_45d(taxpayer, investment);
}

// --- (c): the qualified community development entity ---------------------------------------------------------------------------------------------------

pub relation entity_is_domestic_corporation_or_partnership_45d(cde: Person) kind empirical {
    label en official "the entity is a domestic corporation or partnership (section 45D(c)(1)) — case-asserted";
}
pub relation primary_mission_serves_low_income_communities_or_persons_45d(cde: Person) kind empirical {
    label en official "the primary mission of the entity is serving, or providing investment capital for, low-income communities or low-income persons (section 45D(c)(1)(A)) — case-asserted";
}
pub relation accountable_to_residents_through_board_representation_45d(cde: Person) kind empirical {
    label en official "the entity maintains accountability to residents of low-income communities through their representation on any governing board or advisory board (section 45D(c)(1)(B)) — case-asserted";
}
external judgment relation secretary_certifies_entity_as_cde_45d(cde: Person) {
    authority Secretary;
    label en official "the entity is certified by the Secretary for purposes of section 45D as a qualified community development entity (section 45D(c)(1)(C))";
}
pub relation specialized_small_business_investment_company_45d(cde: Person) kind empirical {
    label en official "the entity is a specialized small business investment company as defined in section 1044(c)(3) (section 45D(c)(2)(A)) — case-asserted";
}
pub relation community_development_financial_institution_45d(cde: Person) kind empirical {
    label en official "the entity is a community development financial institution as defined in section 103 of the Community Development Banking and Financial Institutions Act of 1994 (section 45D(c)(2)(B)) — case-asserted";
}
pub relation qualified_community_development_entity_45d(cde: Person) kind institutional {
    label en official "section 45D(c): a domestic corporation or partnership with a primary mission of serving low-income communities or persons, accountable to residents, and certified by the Secretary; a specialized small business investment company or community development financial institution is treated as meeting the requirements";
}
@source(IRC_S45D_C, relation = formalizes, coverage = exact, quote = "means any domestic corporation or partnership if")
rule QualifiedCommunityDevelopmentEntityDefinedRule(cde: Person) defeasible {
    when entity_is_domestic_corporation_or_partnership_45d(cde);
    when primary_mission_serves_low_income_communities_or_persons_45d(cde);
    when accountable_to_residents_through_board_representation_45d(cde);
    when secretary_certifies_entity_as_cde_45d(cde);
    then qualified_community_development_entity_45d(cde);
}
@source(IRC_S45D_C, relation = formalizes, coverage = exact, quote = "The requirements of paragraph (1) shall be treated as met by")
rule QualifiedCommunityDevelopmentEntitySsbicRule(cde: Person) strict {
    when specialized_small_business_investment_company_45d(cde);
    then qualified_community_development_entity_45d(cde);
}
rule QualifiedCommunityDevelopmentEntityCdfiRule(cde: Person) strict {
    when community_development_financial_institution_45d(cde);
    then qualified_community_development_entity_45d(cde);
}

// --- (d)(1): qualified low-income community investments ----------------------------------------------------------------------------------------

pub relation qlici_transaction_45d(cde: Person, item: Asset, y: TaxableYear, kind: QliciKind45D, counterparty: Person) kind empirical {
    label en official "the transaction of the entity: a capital or equity investment in or loan to a business, the purchase of a loan from another entity, financial counseling and other services, or an equity investment in or loan to an entity (section 45D(d)(1)) — case-asserted";
}
pub relation purchased_loan_is_qlici_of_seller_45d(item: Asset) kind empirical {
    label en official "the loan purchased from the other qualified community development entity is itself a qualified low-income community investment (section 45D(d)(1)(B)) — case-asserted";
}
external judgment relation regulations_specify_services_45d(item: Asset) {
    authority Secretary;
    label en official "the financial counseling and other services are specified in regulations prescribed by the Secretary (section 45D(d)(1)(C))";
}
pub relation qualified_low_income_community_investment_45d(cde: Person, item: Asset, y: TaxableYear) kind institutional {
    label en official "section 45D(d)(1): an investment in or loan to a qualified active low-income community business, the purchase of a qualifying loan from another entity, specified counseling and services, or an equity investment in or loan to a qualified community development entity";
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "any capital or equity investment in, or loan to, any qualified active low-income community business")
rule QliciBusinessInvestmentRule(cde: Person, item: Asset, y: TaxableYear, business: Person) strict {
    when qlici_transaction_45d(cde, item, y, InvestmentOrLoanToBusiness, business);
    when qualified_active_low_income_community_business_45d(business, y);
    then qualified_low_income_community_investment_45d(cde, item, y);
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "the purchase from another qualified community development entity of any loan made by such entity which is a qualified low-income community investment")
rule QliciPurchasedLoanRule(cde: Person, item: Asset, y: TaxableYear, seller: Person) defeasible {
    when qlici_transaction_45d(cde, item, y, PurchaseOfQlichLoanFromCde, seller);
    when qualified_community_development_entity_45d(seller);
    when purchased_loan_is_qlici_of_seller_45d(item);
    then qualified_low_income_community_investment_45d(cde, item, y);
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "financial counseling and other services specified in regulations prescribed by the Secretary to businesses located in, and residents of, low-income communities")
rule QliciServicesRule(cde: Person, item: Asset, y: TaxableYear, recipient: Person) defeasible {
    when qlici_transaction_45d(cde, item, y, CounselingAndServices, recipient);
    when regulations_specify_services_45d(item);
    then qualified_low_income_community_investment_45d(cde, item, y);
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "any equity investment in, or loan to, any qualified community development entity")
rule QliciCdeInvestmentRule(cde: Person, item: Asset, y: TaxableYear, other: Person) defeasible {
    when qlici_transaction_45d(cde, item, y, InvestmentOrLoanToCde, other);
    when qualified_community_development_entity_45d(other);
    then qualified_low_income_community_investment_45d(cde, item, y);
}

// --- (d)(2)(B)-(C), (d)(3): the business extensions and the qualified business -------------------------------------------------------------------

pub relation business_carried_on_by_individual_as_proprietor_45d(business: Person) kind empirical {
    label en official "the business is carried on by an individual as a proprietor (section 45D(d)(2)(B)) — case-asserted";
}
pub relation business_would_meet_requirements_if_incorporated_45d(business: Person, y: TaxableYear) kind empirical {
    label en official "the business would meet the requirements of subparagraph (A) were it incorporated (section 45D(d)(2)(B)) — case-asserted";
}
pub relation business_would_qualify_if_separately_incorporated_45d(business: Person, y: TaxableYear) kind empirical {
    label en official "the trade or business would qualify as a qualified active low-income community business if it were separately incorporated (section 45D(d)(2)(C)) — case-asserted";
}
pub relation qalicb_extended_45d(business: Person, y: TaxableYear) kind institutional {
    label en official "section 45D(d)(2)(B)-(C): a proprietor business meeting the tests if incorporated, and a trade or business that would qualify if separately incorporated, are qualified active low-income community businesses";
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "Such term shall include any business carried on by an individual as a proprietor if such business would meet the requirements of subparagraph (A) were it incorporated.")
rule QalicbProprietorRule(business: Person, y: TaxableYear) strict {
    when business_carried_on_by_individual_as_proprietor_45d(business);
    when business_would_meet_requirements_if_incorporated_45d(business, y);
    then qalicb_extended_45d(business, y);
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "includes any trades or businesses which would qualify as a qualified active low-income community business if such trades or businesses were separately incorporated")
rule QalicbSeparatelyIncorporatedRule(business: Person, y: TaxableYear) strict {
    when business_would_qualify_if_separately_incorporated_45d(business, y);
    then qalicb_extended_45d(business, y);
}
pub relation qualified_business_under_1397c_d_without_rental_or_d3_45d(business: Person, y: TaxableYear) kind empirical {
    label en official "the business is a qualified business within the meaning of section 1397C(d) other than by the rental real property rule of (d)(2)(B) and without regard to (d)(3) (section 45D(d)(3)) — case-asserted";
}
pub relation business_rents_real_property_to_others_45d(business: Person) kind empirical {
    label en official "the business is the rental to others of real property (section 45D(d)(3)(A)) — case-asserted";
}
pub relation rented_real_property_in_low_income_community_45d(business: Person) kind empirical {
    label en official "the rented real property is located in a low-income community (section 45D(d)(3)(A)) — case-asserted";
}
pub relation substantial_improvements_on_rented_property_45d(business: Person) kind empirical {
    label en official "there are substantial improvements located on the rented property (section 45D(d)(3)(A)) — case-asserted";
}
pub relation rental_business_tested_year_45d(business: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year for which the rental business is tested as a qualified business — case-asserted";
}
pub relation qualified_business_45d(business: Person, y: TaxableYear) kind institutional {
    label en official "section 45D(d)(3): a qualified business under section 1397C(d), except that the rental to others of real property in a low-income community is a qualified business if there are substantial improvements on it, and 1397C(d)(3) does not apply";
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "the term \"qualified business\" has the meaning given to such term by section 1397C(d)")
rule QualifiedBusinessOrdinaryRule(business: Person, y: TaxableYear) strict {
    when qualified_business_under_1397c_d_without_rental_or_d3_45d(business, y);
    then qualified_business_45d(business, y);
}
@source(IRC_S45D_D, relation = formalizes, coverage = exact, quote = "the rental to others of real property located in any low-income community shall be treated as a qualified business if there are substantial improvements located on such property")
rule QualifiedBusinessRentalRule(business: Person, y: TaxableYear) strict {
    when business_rents_real_property_to_others_45d(business);
    when rented_real_property_in_low_income_community_45d(business);
    when substantial_improvements_on_rented_property_45d(business);
    when rental_business_tested_year_45d(business, y);
    then qualified_business_45d(business, y);
}

// --- (e)(3)-(5): low-income community rules ------------------------------------------------------------------------------------------------------------

pub relation unit_is_population_census_tract_45d(unit: Asset) kind empirical {
    label en official "the unit is a population census tract — case-asserted";
}
pub relation unit_is_equivalent_county_division_of_untracted_area_45d(unit: Asset) kind empirical {
    label en official "the unit is an equivalent county division (as defined by the Bureau of the Census for defining poverty areas) of an area not tracted for population census tracts (section 45D(e)(3)) — case-asserted";
}
pub relation unit_used_for_poverty_and_income_tests_45d(unit: Asset) kind institutional {
    label en official "section 45D(e)(3): a population census tract, or for an area not tracted the equivalent county division, is used for determining poverty rates and median family income";
}
@source(IRC_S45D_E, relation = formalizes, coverage = exact, quote = "the equivalent county divisions (as defined by the Bureau of the Census for purposes of defining poverty areas) shall be used for purposes of determining poverty rates and median family income")
rule UnitUsedForTestsTractRule(unit: Asset) strict {
    when unit_is_population_census_tract_45d(unit);
    then unit_used_for_poverty_and_income_tests_45d(unit);
}
rule UnitUsedForTestsCountyDivisionRule(unit: Asset) strict {
    when unit_is_equivalent_county_division_of_untracted_area_45d(unit);
    then unit_used_for_poverty_and_income_tests_45d(unit);
}
pub relation tract_population_45d(tract: Asset, population: Decimal) kind empirical {
    label en official "the population of the population census tract (section 45D(e)(4)) — case-asserted";
}
pub relation tract_in_empowerment_zone_in_effect_45d(tract: Asset) kind empirical {
    label en official "the tract is within an empowerment zone the designation of which is in effect under section 1391 (section 45D(e)(4)(A)) — case-asserted";
}
pub relation tract_contiguous_to_45d(tract: Asset, other: Asset) kind empirical {
    label en official "the tract is contiguous to the other tract (section 45D(e)(4)(B)) — case-asserted";
}
pub relation low_income_community_including_e4_45d(tract: Asset) kind institutional {
    label en official "section 45D(e)(1), (4): a low-income community under paragraph (1), or a census tract of under 2,000 population within an empowerment zone in effect and contiguous to one or more low-income communities determined without regard to this paragraph";
}
rule LowIncomeCommunityIncludingE4BaseRule(tract: Asset) strict {
    when low_income_community_45d(tract);
    then low_income_community_including_e4_45d(tract);
}
@source(IRC_S45D_E, relation = formalizes, coverage = exact, quote = "A population census tract with a population of less than 2,000 shall be treated as a low-income community for purposes of this section if such tract")
rule LowIncomeCommunityEmpowermentZoneRule(tract: Asset, population: Decimal, other: Asset) strict {
    when tract_population_45d(tract, population);
    when population < 2000.0;
    when tract_in_empowerment_zone_in_effect_45d(tract);
    when tract_contiguous_to_45d(tract, other);
    when low_income_community_45d(other);
    then low_income_community_including_e4_45d(tract);
}
pub relation county_net_out_migration_45d(county: Asset, inhabitants: Decimal) kind empirical {
    label en official "the net out-migration of inhabitants from the county during the 20-year period ending with the year in which the most recent census was conducted (section 45D(e)(5)(B)) — case-asserted";
}
pub relation county_population_at_period_start_45d(county: Asset, population: Decimal) kind empirical {
    label en official "the population of the county at the beginning of that 20-year period — case-asserted";
}
pub relation high_migration_rural_county_defined_45d(county: Asset) kind institutional {
    label en official "section 45D(e)(5)(B): a county with a net out-migration of at least 10 percent of its population at the beginning of the 20-year period ending with the year of the most recent census";
}
@source(IRC_S45D_E, relation = formalizes, coverage = exact, quote = "has a net out-migration of inhabitants from the county of at least 10 percent of the population of the county at the beginning of such period")
rule HighMigrationRuralCountyDefinedRule(county: Asset, out: Decimal, population: Decimal) strict {
    when county_net_out_migration_45d(county, out);
    when county_population_at_period_start_45d(county, population);
    when population > 0.0;
    when out >= 0.10 * population;
    then high_migration_rural_county_defined_45d(county);
}

// --- (g)(4): the tax benefit rule -------------------------------------------------------------------------------------------------------------------------

pub relation credit_used_to_reduce_tax_liability_45d(taxpayer: Person, investment: Asset, amount: Money) kind empirical {
    label en official "the amount of the credits allowed by reason of section 45D that were used to reduce tax liability — case-asserted";
}
pub relation tax_increase_for_recapture_45d(taxpayer: Person, investment: Asset, amount: Money) kind institutional {
    label en official "section 45D(g)(4)(A): the tax is increased only with respect to credits that were used to reduce tax liability";
}
@source(IRC_S45D_G, relation = formalizes, coverage = exact, quote = "The tax for the taxable year shall be increased under paragraph (1) only with respect to credits allowed by reason of this section which were used to reduce tax liability.")
rule TaxIncreaseForRecaptureRule(taxpayer: Person, investment: Asset, recapture: Money, used: Money) defeasible {
    when credit_recapture_amount_45d(taxpayer, investment, recapture);
    when credit_used_to_reduce_tax_liability_45d(taxpayer, investment, used);
    then tax_increase_for_recapture_45d(taxpayer, investment, min(recapture, used));
}
pub relation section_39_carryover_adjustment_45d(taxpayer: Person, investment: Asset, amount: Money) kind institutional {
    label en official "section 45D(g)(4)(A): for credits not used to reduce tax liability, the section 39 carryforwards and carrybacks are appropriately adjusted (the unused part of the recapture amount)";
}
@source(IRC_S45D_G, relation = formalizes, coverage = partial, quote = "In the case of credits not so used to reduce tax liability, the carryforwards and carrybacks under section 39 shall be appropriately adjusted.")
rule Section39CarryoverAdjustmentRule(taxpayer: Person, investment: Asset, recapture: Money, used: Money) defeasible {
    when credit_recapture_amount_45d(taxpayer, investment, recapture);
    when credit_used_to_reduce_tax_liability_45d(taxpayer, investment, used);
    then section_39_carryover_adjustment_45d(taxpayer, investment, max(recapture - used, 0 USD));
}
pub relation recapture_increase_excluded_from_tax_for_credits_and_minimum_tax_45d(taxpayer: Person, investment: Asset) kind institutional {
    label en official "section 45D(g)(4)(B): an increase in tax under subsection (g) is not treated as tax imposed by this chapter for determining the amount of any credit or for section 55";
}
@source(IRC_S45D_G, relation = formalizes, coverage = exact, quote = "Any increase in tax under this subsection shall not be treated as a tax imposed by this chapter for purposes of determining the amount of any credit under this chapter or for purposes of section 55.")
rule RecaptureIncreaseExcludedRule(taxpayer: Person, investment: Asset, recapture: Money) defeasible {
    when credit_recapture_amount_45d(taxpayer, investment, recapture);
    then recapture_increase_excluded_from_tax_for_credits_and_minimum_tax_45d(taxpayer, investment);
}

// --- (h): the basis --------------------------------------------------------------------------------------------------------------------------------------------

pub relation investment_basis_before_credit_45d(taxpayer: Person, investment: Asset, y: TaxableYear, basis: Money) kind empirical {
    label en official "the basis of the qualified equity investment before the reduction — case-asserted";
}
pub relation investment_basis_after_credit_45d(taxpayer: Person, investment: Asset, y: TaxableYear, basis: Money) kind institutional {
    label en official "section 45D(h): the basis of the qualified equity investment is reduced by the credit determined with respect to it (not below zero)";
}
@source(IRC_S45D_H, relation = formalizes, coverage = exact, quote = "The basis of any qualified equity investment shall be reduced by the amount of any credit determined under this section with respect to such investment.")
rule InvestmentBasisAfterCreditRule(taxpayer: Person, investment: Asset, y: TaxableYear, basis: Money, credit: Money) defeasible {
    when investment_basis_before_credit_45d(taxpayer, investment, y, basis);
    when basis_reduction_45d(taxpayer, investment, y, credit);
    then investment_basis_after_credit_45d(taxpayer, investment, y, max(basis - credit, 0 USD));
}
pub relation investment_basis_for_section_1202_45d(taxpayer: Person, investment: Asset, y: TaxableYear, basis: Money) kind institutional {
    label en official "section 45D(h), last sentence: the basis reduction does not apply for purposes of section 1202";
}
@source(IRC_S45D_H, relation = formalizes, coverage = exact, quote = "This subsection shall not apply for purposes of section 1202.")
rule InvestmentBasisForSection1202Rule(taxpayer: Person, investment: Asset, y: TaxableYear, basis: Money) strict {
    when investment_basis_before_credit_45d(taxpayer, investment, y, basis);
    then investment_basis_for_section_1202_45d(taxpayer, investment, y, basis);
}
