// Stage 4 (DECISION-0379 with deontics), credits, part H: section 48D(d)(5) — rules similar to
// section 50(a) (recapture) and 50(c) (basis) for the amounts treated as payments under the 48D
// direct pay election ((A): the deemed payment of (d)(1)) and for the payments made to pass-through
// entities ((B): (d)(2)(A)). Closes G6427.
//
// The section 50 rules are READ by explicit reference where they are general: the recapture
// percentage table (`recapture_percentage_50`, the decision table of module 50) and the early
// disposition event of module 50 (`investment_credit_property_disposed_before_recapture_period_ends`,
// keyed by the property and its holder). What module 50 keys to the credit of section 46 is written
// here for the payment: the amount attributable to a property is the 48D credit of the property in
// the year it is claimed by a taxpayer with the direct pay election in effect (the deemed payment),
// or the payment of the Secretary to the pass-through for the property.
// JUDGMENT CALL: the payment of a property is the credit of the property for its (single) year of
// placement in service; the 50-percent special rule of section 50(c)(3) does not apply to 48D.

use self::{
    Asset,
    IRC_S48D_D,
    Person,
    TaxableYear,
    advanced_manufacturing_credit_of_property_48d,
    direct_pay_election_in_effect_48d,
    investment_credit_property_disposed_before_recapture_period_ends,
    recapture_percentage_50,
    secretary_payment_to_pass_through_48d,
};

pub relation deemed_payment_amount_of_property_48d5(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount treated as a payment made by the taxpayer under section 48D(d)(1) that is attributable to the property: its 48D credit for a year in which the direct pay election is in effect";
}
@source(IRC_S48D_D, quote = "Rules similar to the rules of subsections (a) and (c) of section 50 shall apply with respect to—")
rule DeemedPaymentOfProperty48d5(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the credit of the property under the direct pay election is the deemed payment for it (section 48D(d)(1), (5)(A))";
    when direct_pay_election_in_effect_48d(taxpayer, y);
    when advanced_manufacturing_credit_of_property_48d(taxpayer, prop, y, amount);
    then deemed_payment_amount_of_property_48d5(taxpayer, prop, y, amount);
}
pub relation pass_through_payment_of_property_48d5(pt_entity: Person, prop: Asset, amount: Money) kind institutional {
    label en official "the payment made by the Secretary to the pass-through entity for the property (section 48D(d)(2)(A), (5)(B))";
}
@source(IRC_S48D_D, quote = "(B) any payment made pursuant to paragraph (2)(A).")
rule PassThroughPaymentOfProperty48d5(pt_entity: Person, prop: Asset, amount: Money) defeasible {
    label en official "the payment to the pass-through for the property";
    when secretary_payment_to_pass_through_48d(pt_entity, prop, amount);
    then pass_through_payment_of_property_48d5(pt_entity, prop, amount);
}

// ---- 50(c): basis reduction ----

pub relation basis_reduction_for_deemed_payment_48d5(taxpayer: Person, prop: Asset, amount: Money) kind institutional {
    label en official "the basis of the property is reduced by the amount treated as a payment (rule similar to section 50(c)(1))";
}
@source(IRC_S48D_D, quote = "(A) any amount treated as a payment which is made by the taxpayer under paragraph (1), and")
rule BasisReductionForDeemedPayment48d5(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "basis reduced by the deemed payment (section 48D(d)(5)(A), by section 50(c)(1))";
    when deemed_payment_amount_of_property_48d5(taxpayer, prop, y, amount);
    then basis_reduction_for_deemed_payment_48d5(taxpayer, prop, amount);
}
pub relation basis_reduction_for_pass_through_payment_48d5(pt_entity: Person, prop: Asset, amount: Money) kind institutional {
    label en official "the basis of the property is reduced by the payment made to the pass-through (rule similar to section 50(c)(1))";
}
@source(IRC_S48D_D, quote = "(B) any payment made pursuant to paragraph (2)(A).")
rule BasisReductionForPassThroughPayment48d5(pt_entity: Person, prop: Asset, amount: Money) defeasible {
    label en official "basis reduced by the pass-through payment (section 48D(d)(5)(B), by section 50(c)(1))";
    when pass_through_payment_of_property_48d5(pt_entity, prop, amount);
    then basis_reduction_for_pass_through_payment_48d5(pt_entity, prop, amount);
}

// ---- 50(a): recapture on an early disposition ----

pub relation recapture_of_deemed_payment_48d5(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax for the year is increased by the recapture percentage of the amount treated as a payment for the property, when it is disposed of or ceases to be qualified before the recapture period ends (rule similar to section 50(a)(1))";
}
@source(IRC_S48D_D, quote = "(A) any amount treated as a payment which is made by the taxpayer under paragraph (1), and")
rule RecaptureOfDeemedPayment48d5(taxpayer: Person, prop: Asset, y: TaxableYear, y0: TaxableYear, years: Decimal, pct: Decimal, paid: Money) defeasible {
    label en official "recapture percentage x the deemed payment (section 48D(d)(5)(A), by section 50(a)(1))";
    when investment_credit_property_disposed_before_recapture_period_ends(prop, taxpayer, y, years);
    when recapture_percentage_50(years, pct);
    when deemed_payment_amount_of_property_48d5(taxpayer, prop, y0, paid);
    then recapture_of_deemed_payment_48d5(taxpayer, prop, y, round(pct * paid, 2, "HALF_UP"));
}
pub relation recapture_of_pass_through_payment_48d5(pt_entity: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax of the pass-through for the year is increased by the recapture percentage of the payment made to it for the property (rule similar to section 50(a)(1))";
}
@source(IRC_S48D_D, quote = "(B) any payment made pursuant to paragraph (2)(A).")
rule RecaptureOfPassThroughPayment48d5(pt_entity: Person, prop: Asset, y: TaxableYear, years: Decimal, pct: Decimal, paid: Money) defeasible {
    label en official "recapture percentage x the pass-through payment (section 48D(d)(5)(B), by section 50(a)(1))";
    when investment_credit_property_disposed_before_recapture_period_ends(prop, pt_entity, y, years);
    when recapture_percentage_50(years, pct);
    when pass_through_payment_of_property_48d5(pt_entity, prop, paid);
    then recapture_of_pass_through_payment_48d5(pt_entity, prop, y, round(pct * paid, 2, "HALF_UP"));
}
pub relation basis_restoration_for_recaptured_payment_48d5(holder: Person, prop: Asset, amount: Money) kind institutional {
    label en official "the basis of the property, immediately before the recapture event, is increased by the recapture amount (rule similar to section 50(c)(2))";
}
@source(IRC_S48D_D, quote = "Rules similar to the rules of subsections (a) and (c) of section 50 shall apply with respect to—")
rule BasisRestorationForRecapturedDeemedPayment48d5(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "basis restored by the recapture of the deemed payment (section 48D(d)(5)(A), by section 50(c)(2))";
    when recapture_of_deemed_payment_48d5(taxpayer, prop, y, amount);
    then basis_restoration_for_recaptured_payment_48d5(taxpayer, prop, amount);
}
rule BasisRestorationForRecapturedPassThroughPayment48d5(pt_entity: Person, prop: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "basis restored by the recapture of the pass-through payment (section 48D(d)(5)(B), by section 50(c)(2))";
    when recapture_of_pass_through_payment_48d5(pt_entity, prop, y, amount);
    then basis_restoration_for_recaptured_payment_48d5(pt_entity, prop, amount);
}
