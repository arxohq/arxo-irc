// Section 53 — Credit for prior year minimum tax liability. Stage 2b
// (IRC-06 stage 2b, DECISION-0379). Priority list item: §53 (the (b)-(c)
// computation with the income_individual AMT contract, (e) prior-year
// minimum tax).
//
// Judgment calls / scope:
// * `us.irc.income_individual` does NOT export an AMT interface — section
//   55/56/57 (the alternative minimum tax itself, its adjustments and
//   preference items) are not modelled anywhere in `us.irc.*` yet (grepping
//   `income_individual` for 'minimum'/'tentative' finds nothing; the ONLY
//   AMT-shaped relations that exist anywhere are this SAME package's own
//   `26-limitation-on-credits.law` dependency-contract stubs
//   `tentative_minimum_tax`/`section_55a_tax`, already `pub`/package-private
//   respectively, both still unproduced). This module therefore REUSES
//   those two existing relations directly (no new stub) for section
//   53(d)(1)(A) ("net minimum tax" = section 55(a) tax = `section_55a_tax`)
//   and section 53(d)(2) ("tentative minimum tax" = section 55(b) amount =
//   `tentative_minimum_tax`) — both remain EXTERNAL_DEPENDENCY/pending, same
//   producer gap already recorded for module 38 (TECH-GAPS G303-class).
// * §53(d)(1)(B)(i)-(ii) ("adjusted net minimum tax": net minimum tax minus
//   what the net minimum tax would be with ONLY the section 56(b)(1)
//   adjustments and section 57(a)(1),(5),(7) preferences taken into
//   account) needs a SECOND, narrower AMT recomputation that section 56/57
//   (also unmodelled) would have to produce. Modelled as its own dependency
//   contract, `net_minimum_tax_specified_items_only` — a NEW contract, not
//   a copy of `section_55a_tax` (the two differ in general: the specified-
//   items recompute is always <= the full net minimum tax).
// * §53(d)(1)(B)(iii) (corporations: adjusted net minimum tax = net minimum
//   tax, no reduction) is modelled with its OWN corporation-scoped
//   dependency contract (`net_minimum_tax_corporation`), since this
//   package's existing `section_55a_tax`/`tentative_minimum_tax` (from
//   module 26) are typed to `Individual` only (module 26's own convention);
//   widening their type is out of this pass's scope (would touch module 26
//   and module 38, not owned by this stage's task). A corporation's own
//   `regular_tax_liability` is likewise not modelled anywhere in this
//   package (module 26 types it to `Individual`) — so the (c)/(e) limitation
//   for a CORPORATION is EXTERNAL_DEPENDENCY end to end, recorded as
//   TECH-GAPS G390 rather than silently narrowed to individuals only.
// * §53(b) (the credit = excess of ALL PRIOR YEARS' adjusted net minimum tax
//   over ALL PRIOR YEARS' section 53(a) credit allowed) is the SAME
//   multi-year running-ledger shape already confirmed unstratifiable
//   (LDC-E4102) for section 39's carryback/carryforward chain (HANDOFF
//   "us.irc.credits (A03c) stage 2", TECH-GAPS G304) and section 41(c)(3)'s
//   fixed-base-percentage lookback (G305): this module does NOT chain
//   `minimum_tax_credit`/`adjusted_net_minimum_tax` across years through its
//   own rule graph. Instead, following the SAME convention as G304's
//   resolution, the two cumulative PRIOR-YEARS totals are case-asserted
//   inputs (`cumulative_adjusted_net_minimum_tax_prior_years`,
//   `cumulative_minimum_tax_credit_allowed_prior_years`); a scenario
//   supplies each year's own running total directly rather than the engine
//   deriving year N's total from year N-1's.
// * §53(c)(1)'s "credits allowable under subparts A, B, D, E, and F of this
//   part" reuses module 38's own `credits_allowable_under_subparts_a_and_b`
//   (subparts A/B) and adds ONE further dependency contract for subparts
//   D/E/F (`credits_allowable_under_subparts_d_e_f`) rather than trying to
//   precisely enumerate which of this package's own component credits sit
//   in D vs. E vs. F (subpart D is sections 38-45D generally, but several of
//   ITS OWN listed credits are themselves still dependency contracts per
//   module 38's own header) — TECH-GAPS G390, same aggregate-ordering class
//   as G303.
// * §53(e)(2) (corporation: increase the (c)(1) amount by the section 59A
//   BEAT tax) is a further dependency contract
//   (`section_59a_tax_corporation`) — section 59A is not modelled anywhere
//   in `us.irc.*`.

// --- §53(d)(1): net minimum tax and adjusted net minimum tax -----------------

use self::{
    Corporation,
    IRC_S53_A,
    IRC_S53_B,
    IRC_S53_C,
    IRC_S53_D,
    IRC_S53_E,
    Individual,
    Person,
    TaxableYear,
    credits_allowable_under_subparts_a_and_b,
    regular_tax_liability,
    section_55a_tax_26a,
    tentative_minimum_tax_26c,
};

pub relation net_minimum_tax(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the term \"net minimum tax\" means the tax imposed by section 55 (section 53(d)(1)(A))";
}
@source(IRC_S53_D, quote = "The term \"net minimum tax\" means the tax imposed by section 55.")
rule NetMinimumTaxRule(taxpayer: Individual, y: TaxableYear, amt: Money) strict {
    when section_55a_tax_26a(taxpayer, y, amt);
    then net_minimum_tax(taxpayer, y, amt);
}

pub relation net_minimum_tax_specified_items_only(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net minimum tax for the taxable year if the only adjustments and items of tax preference taken into account were the section 56(b)(1) adjustments and the section 57(a)(1),(5),(7) preference items (section 53(d)(1)(B)(ii)) — EXTERNAL_DEPENDENCY: sections 56/57 are not modelled anywhere in us.irc.*, so this is a case-asserted contract rather than a derived recomputation";
}

pub relation adjusted_net_minimum_tax(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted net minimum tax for the taxable year (section 53(d)(1)(B)(i)): net minimum tax reduced by the specified-items-only recomputation, for a NON-corporate taxpayer";
}
@source(IRC_S53_D, quote = "the amount of the net minimum tax for such taxable year, reduced by\n(II) the amount which would be the net minimum tax for such taxable year if the only adjustments and items of tax preference taken into account were those specified in clause (ii)")
rule AdjustedNetMinimumTaxRule(taxpayer: Individual, y: TaxableYear, full: Money, specified: Money) strict {
    when net_minimum_tax(taxpayer, y, full);
    when net_minimum_tax_specified_items_only(taxpayer, y, specified);
    then adjusted_net_minimum_tax(taxpayer, y, max(0 USD, full - specified));
}

pub relation net_minimum_tax_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the term \"net minimum tax\" for a CORPORATION (section 53(d)(1)(A), section 55) — EXTERNAL_DEPENDENCY dependency contract; this package's own section_55a_tax relation (module 26) is typed to Individual only";
}
pub relation adjusted_net_minimum_tax_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "for a corporation, the adjusted net minimum tax for any taxable year IS the net minimum tax for such year — no reduction (section 53(d)(1)(B)(iii))";
}
@source(IRC_S53_D, quote = "In the case of a corporation—\n(I) the preceding provisions of this subparagraph shall not apply, and\n(II) the adjusted net minimum tax for any taxable year is the amount of the net minimum tax for such year.")
rule AdjustedNetMinimumTaxCorporationRule(taxpayer: Corporation, y: TaxableYear, amt: Money) strict {
    when net_minimum_tax_corporation(taxpayer, y, amt);
    then adjusted_net_minimum_tax_corporation(taxpayer, y, amt);
}

// §53(d)(2): "tentative minimum tax" already has the meaning given by
// section 55(b) — this package's `tentative_minimum_tax` relation (module
// 26) is that same dependency contract already; no new relation needed.

// --- §53(b): minimum tax credit (prior-years excess) --------------------------

pub relation cumulative_adjusted_net_minimum_tax_prior_years(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of the adjusted net minimum tax imposed for ALL prior taxable years beginning after 1986 (section 53(b)(1)) — case-asserted running total (multi-year ledger, TECH-GAPS G390, same class as G304/G305)";
}
pub relation cumulative_minimum_tax_credit_allowed_prior_years(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of the amounts allowable as a credit under section 53(a) for ALL such prior taxable years (section 53(b)(2)) — case-asserted running total";
}
pub relation minimum_tax_credit_prior_years_excess(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 53(b) minimum tax credit for the taxable year: the excess (if any) of cumulative prior-years adjusted net minimum tax over cumulative prior-years section 53(a) credit allowed";
}
@source(IRC_S53_B, quote = "the minimum tax credit for any taxable year is the excess (if any) of—\n(1) the adjusted net minimum tax imposed for all prior taxable years beginning after 1986, over\n(2) the amount allowable as a credit under subsection (a) for such prior taxable years")
rule MinimumTaxCreditPriorYearsExcessRule(taxpayer: Individual, y: TaxableYear, cum_adj: Money, cum_allowed: Money) strict {
    when cumulative_adjusted_net_minimum_tax_prior_years(taxpayer, y, cum_adj);
    when cumulative_minimum_tax_credit_allowed_prior_years(taxpayer, y, cum_allowed);
    then minimum_tax_credit_prior_years_excess(taxpayer, y, max(0 USD, cum_adj - cum_allowed));
}

pub relation cumulative_net_minimum_tax_prior_years_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "for a corporation, the sum of the (unadjusted) net minimum tax for ALL prior taxable years beginning after 2022 (section 53(e)(1) substitution into (b)(1)) — case-asserted running total";
}
pub relation cumulative_minimum_tax_credit_allowed_prior_years_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "for a corporation, the sum of the amounts allowable as a credit under section 53(a) for ALL such prior taxable years (section 53(b)(2), unchanged by (e)) — case-asserted running total";
}
pub relation minimum_tax_credit_prior_years_excess_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 53(b)/(e)(1) minimum tax credit prior-years excess for a corporation: net (not adjusted) minimum tax for all prior years beginning after 2022, minus prior-years credit allowed";
}
@source(IRC_S53_E, quote = "subsection (b)(1) shall be applied by substituting \"the net minimum tax for all prior taxable years beginning after 2022\" for \"the adjusted net minimum tax imposed for all prior taxable years beginning after 1986\"")
rule MinimumTaxCreditPriorYearsExcessCorporationRule(taxpayer: Corporation, y: TaxableYear, cum_net: Money, cum_allowed: Money) strict {
    when cumulative_net_minimum_tax_prior_years_corporation(taxpayer, y, cum_net);
    when cumulative_minimum_tax_credit_allowed_prior_years_corporation(taxpayer, y, cum_allowed);
    then minimum_tax_credit_prior_years_excess_corporation(taxpayer, y, max(0 USD, cum_net - cum_allowed));
}

// --- §53(c): limitation --------------------------------------------------------

pub relation credits_allowable_under_subparts_d_e_f(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the credits allowable under subparts D, E and F of this part (Part IV), for the section 53(c)(1) limitation — dependency contract, not yet reconciled against this package's own subpart-D component list (module 38); TECH-GAPS G390";
}
pub relation credits_allowable_under_53c1_subparts(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the credits allowable under subparts A, B, D, E and F of this part (section 53(c)(1)): module 38's own subpart A/B contract plus the subpart D/E/F contract above";
}
@source(IRC_S53_C, quote = "the regular tax liability of the taxpayer for such taxable year reduced by the sum of the credits allowable under subparts A, B, D, E, and F of this part")
rule Credits53c1SubpartsRule(taxpayer: Individual, y: TaxableYear, ab: Money, def: Money) strict {
    when credits_allowable_under_subparts_a_and_b(taxpayer, y, ab);
    when credits_allowable_under_subparts_d_e_f(taxpayer, y, def);
    then credits_allowable_under_53c1_subparts(taxpayer, y, ab + def);
}

pub relation minimum_tax_credit_limitation(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 53(c) limitation: the excess (if any) of the taxpayer's regular tax liability reduced by the section 53(c)(1) subpart credits, over the tentative minimum tax for the taxable year";
}
@source(IRC_S53_C, quote = "The credit allowable under subsection (a) for any taxable year shall not exceed the excess (if any) of—\n(1) the regular tax liability of the taxpayer for such taxable year reduced by the sum of the credits allowable under subparts A, B, D, E, and F of this part, over\n(2) the tentative minimum tax for the taxable year.")
rule MinimumTaxCreditLimitationRule(taxpayer: Individual, y: TaxableYear, regular: Money, subparts: Money, tmt: Money) strict {
    when regular_tax_liability(taxpayer, y, regular);
    when credits_allowable_under_53c1_subparts(taxpayer, y, subparts);
    when tentative_minimum_tax_26c(taxpayer, y, tmt);
    then minimum_tax_credit_limitation(taxpayer, y, max(0 USD, (regular - subparts) - tmt));
}

pub relation section_59a_tax_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed under section 59A (base erosion and anti-abuse tax) for the taxable year — EXTERNAL_DEPENDENCY, section 59A is not modelled anywhere in us.irc.*";
}
pub relation minimum_tax_credit_limitation_corporation_before_beat(taxpayer: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 53(c)(1) amount for a corporation before the section 53(e)(2) BEAT increase — EXTERNAL_DEPENDENCY end to end: a corporation's regular_tax_liability/credits_allowable_under_53c1_subparts/tentative_minimum_tax are not modelled anywhere in this package (module 26 types all three to Individual); recorded as a pure dependency contract rather than derived, TECH-GAPS G390";
}
pub relation minimum_tax_credit_limitation_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 53(c)/(e) limitation for a corporation: the (c)(1) amount increased by the section 59A tax (section 53(e)(2))";
}
@source(IRC_S53_E, quote = "the amount determined under subsection (c)(1) shall be increased by the amount of tax imposed under section 59A for the taxable year")
rule MinimumTaxCreditLimitationCorporationRule(taxpayer: Corporation, y: TaxableYear, before: Money, beat: Money) strict {
    when minimum_tax_credit_limitation_corporation_before_beat(taxpayer, y, before);
    when section_59a_tax_corporation(taxpayer, y, beat);
    then minimum_tax_credit_limitation_corporation(taxpayer, y, before + beat);
}

// --- §53(a): allowance of credit -----------------------------------------------

pub relation minimum_tax_credit(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the minimum tax credit allowed under section 53(a) for the taxable year: the lesser of the section 53(b) prior-years excess or the section 53(c) limitation";
}
@source(IRC_S53_A, quote = "There shall be allowed as a credit against the tax imposed by this chapter for any taxable year an amount equal to the minimum tax credit for such taxable year.")
rule MinimumTaxCreditRule(taxpayer: Individual, y: TaxableYear, excess: Money, limitation: Money) strict {
    when minimum_tax_credit_prior_years_excess(taxpayer, y, excess);
    when minimum_tax_credit_limitation(taxpayer, y, limitation);
    then minimum_tax_credit(taxpayer, y, min(excess, limitation));
}

pub relation minimum_tax_credit_corporation(taxpayer: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 53(a)/(e) minimum tax credit allowed for a corporation: the lesser of the section 53(b)/(e)(1) prior-years excess or the section 53(c)/(e)(2) limitation";
}
@source(IRC_S53_A, quote = "There shall be allowed as a credit against the tax imposed by this chapter for any taxable year an amount equal to the minimum tax credit for such taxable year.")
rule MinimumTaxCreditCorporationRule(taxpayer: Corporation, y: TaxableYear, excess: Money, limitation: Money) strict {
    when minimum_tax_credit_prior_years_excess_corporation(taxpayer, y, excess);
    when minimum_tax_credit_limitation_corporation(taxpayer, y, limitation);
    then minimum_tax_credit_corporation(taxpayer, y, min(excess, limitation));
}
