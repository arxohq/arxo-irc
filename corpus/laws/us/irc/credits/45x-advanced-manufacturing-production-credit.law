// Section 45X — Advanced manufacturing production credit. Stage 2c
// (IRC-06 stage 2c, DECISION-0379). Priority list item: §45X core
// (per-unit amounts table).
//
// Judgment calls / scope:
// * The 18 flat-rate categories of section 45X(b)(1)-(2) — photovoltaic
//   cells/wafers/polysilicon/backsheets/modules, the 5 wind-energy-
//   component sub-rates, torque tubes, structural fasteners, the 5
//   inverter sub-rates, and battery cells/modules — ARE modelled as a
//   genuine `.lawtable.json` rate table (`45x-rate-table.lawtable.json`,
//   mirroring `us.irc.accounting`'s own Text-keyed `613-b-percentage-
//   rates.lawtable.json` idiom for a rate keyed by an enumerated NAME
//   rather than a numeric band). The case supplies the component's
//   QUANTITY already normalized to that component's own natural unit
//   (watts for capacity-based rates, square meters, kilograms, or
//   kilowatt-hours) via `component_quantity_45x` — this pass does NOT
//   separately track which physical unit each component type uses or
//   convert between them; a scenario must supply the quantity in the
//   correct unit itself (TECH-GAPS G391).
// * (b)(1)(J) (electrode active materials) and (b)(1)(M) (applicable
//   critical minerals) are NOT rate-per-unit at all — both are 10 percent
//   of PRODUCTION COST, modelled as their own separate rule reading a
//   case-asserted cost amount, not part of the rate table.
// * (b)(3) (the 2030-2032 75/50/25/0-percent phase-out, critical minerals
//   originally exempt) is modelled exactly for the 18 rate-table
//   categories and electrode active materials; the exemption for
//   applicable critical minerals is read directly (no phase-out rule
//   applies to them in this module).
// * `us.irc.temporal::PL119_21_S70514` IS pinned and used for the NEW
//   (D) wind-energy-component termination (produced and sold after
//   December 31, 2027) it adds to section 45X(b)(3). The (C) critical-
//   minerals-other-than-metallurgical-coal 2031-2034 phase-out PL 119-21
//   also adds is NOT modelled this pass (a second, later-starting phase-
//   out schedule layered onto the base exemption — TECH_GAP, TECH-GAPS
//   G391) — the base text's flat critical-minerals exemption from the
//   ORIGINAL (b)(3) phase-out remains as modelled.
// * (a)(2) (production/sale must be in a trade or business), (a)(3)
//   (unrelated-person treatment and the related-party election),
//   (b)(4) (the battery capacity-to-power 100:1 ratio limitation), (c)
//   (the full "eligible component"/"applicable critical mineral" catalog
//   of definitions), and (d) (special rules, including the (d)(4) sale-
//   of-integrated-components rule PL 119-21 section 70514(a) rewrites) are
//   NOT modelled — TECH_GAP, case-asserted inputs are read as already
//   reflecting these constraints.

use self::{
    Asset,
    IRC_S45X_A,
    IRC_S45X_B,
    Person,
    TaxableYear,
};

pub enum EligibleComponentType45x {
    PhotovoltaicCell, PhotovoltaicWafer, SolarGradePolysilicon, PolymericBacksheet, SolarModule,
    WindBlade, WindNacelle, WindTower, WindFoundationFixed, WindFoundationFloating,
    TorqueTube, StructuralFastener,
    InverterCentral, InverterUtility, InverterCommercial, InverterResidential, InverterMicroOrDistributedWind,
    BatteryCell, BatteryModuleWithCells, BatteryModuleNoCells
}
relation rate_per_unit_45x(component_type: EligibleComponentType45x, rate: Money) kind institutional;

pub relation eligible_component_produced_and_sold_45x(taxpayer: Person, component: Asset, y: TaxableYear, component_type: EligibleComponentType45x) kind empirical {
    label en official "the component was produced by the taxpayer and, during the taxable year, sold to an unrelated person, in the taxpayer's trade or business (section 45X(a)(1)-(2)) — case-asserted";
}
pub relation component_quantity_45x(component: Asset, quantity: Decimal) kind empirical {
    label en official "the component's quantity, ALREADY expressed in its own natural unit for section 45X(b)(1) (watts of capacity, square meters, or kilograms as applicable) — case-asserted (TECH-GAPS G391: unit tracking/conversion is not separately modelled)";
}
pub relation component_sale_date_45x(component: Asset, on: Date) kind empirical {
    label en official "the date the component was sold, for the section 45X(b)(3) phase-out and the PL 119-21 wind-termination date — case-asserted";
}

pub relation credit_amount_before_phaseout_45x(component: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45X(b)(1): rate per unit times quantity, before the section 45X(b)(3) phase-out";
}
@source(IRC_S45X_B, quote = "the amount determined under this subsection with respect to any eligible component, including any eligible component it incorporates, shall be equal to")
rule CreditAmountBeforePhaseout45xRule(taxpayer: Person, component: Asset, y: TaxableYear, component_type: EligibleComponentType45x, rate: Money, quantity: Decimal) strict {
    when eligible_component_produced_and_sold_45x(taxpayer, component, y, component_type);
    when rate_per_unit_45x(component_type, rate);
    when component_quantity_45x(component, quantity);
    then credit_amount_before_phaseout_45x(component, y, round(rate * quantity, 2, "HALF_UP"));
}

// --- §45X(b)(1)(J)/(M): percentage-of-cost components ---------------------------

pub relation electrode_active_materials_production_cost(taxpayer: Person, component: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "costs incurred by the taxpayer to produce electrode active materials (section 45X(b)(1)(J)) — case-asserted";
}
pub relation electrode_active_materials_credit_amount(component: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45X(b)(1)(J): 10 percent of electrode-active-materials production costs";
}
@source(IRC_S45X_B, quote = "in the case of electrode active materials, an amount equal to 10 percent of the costs incurred by the taxpayer with respect to production of such materials")
rule ElectrodeActiveMaterialsCreditAmountRule(taxpayer: Person, component: Asset, y: TaxableYear, cost: Money) strict {
    when electrode_active_materials_production_cost(taxpayer, component, y, cost);
    then electrode_active_materials_credit_amount(component, y, round(0.10 * cost, 2, "HALF_UP"));
}

pub relation applicable_critical_mineral_production_cost(taxpayer: Person, component: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "costs incurred by the taxpayer to produce an applicable critical mineral (section 45X(b)(1)(M)) — case-asserted";
}
pub relation applicable_critical_mineral_credit_amount(component: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45X(b)(1)(M): 10 percent of applicable-critical-mineral production costs — exempt from the section 45X(b)(3) phase-out per (b)(3)(C)";
}
@source(IRC_S45X_B, quote = "in the case of any applicable critical mineral, an amount equal to 10 percent of the costs incurred by the taxpayer with respect to production of such mineral")
rule ApplicableCriticalMineralCreditAmountRule(taxpayer: Person, component: Asset, y: TaxableYear, cost: Money) strict {
    when applicable_critical_mineral_production_cost(taxpayer, component, y, cost);
    then applicable_critical_mineral_credit_amount(component, y, round(0.10 * cost, 2, "HALF_UP"));
}

// --- §45X(b)(3): phase out (rate-table and electrode-active-material components) --

pub relation phaseout_percentage_45x(on: Date, pct: Decimal) kind institutional {
    label en official "section 45X(b)(3)(B): the phase-out percentage applied to the pre-phase-out amount";
}
@source(IRC_S45X_B, quote = "in the case of an eligible component sold during calendar year 2030, 75 percent")
rule PhaseoutPercentage45x2030Rule(component: Asset, on: Date) strict {
    when component_sale_date_45x(component, on);
    when on > @2029-12-31;
    when on < @2031-01-01;
    then phaseout_percentage_45x(on, 0.75);
}
@source(IRC_S45X_B, quote = "in the case of an eligible component sold during calendar year 2031, 50 percent")
rule PhaseoutPercentage45x2031Rule(component: Asset, on: Date) strict {
    when component_sale_date_45x(component, on);
    when on > @2030-12-31;
    when on < @2032-01-01;
    then phaseout_percentage_45x(on, 0.50);
}
@source(IRC_S45X_B, quote = "in the case of an eligible component sold during calendar year 2032, 25 percent")
rule PhaseoutPercentage45x2032Rule(component: Asset, on: Date) strict {
    when component_sale_date_45x(component, on);
    when on > @2031-12-31;
    when on < @2033-01-01;
    then phaseout_percentage_45x(on, 0.25);
}
@source(IRC_S45X_B, quote = "in the case of an eligible component sold after December 31, 2032, 0 percent")
rule PhaseoutPercentage45xAfter2032Rule(component: Asset, on: Date) strict {
    when component_sale_date_45x(component, on);
    when on > @2032-12-31;
    then phaseout_percentage_45x(on, 0.0);
}

pub relation credit_amount_45x(component: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45X(b)(1)/(3): the credit amount for a rate-table eligible component, after the phase-out for components sold after December 31, 2029";
}
@source(IRC_S45X_B, quote = "the amount determined under paragraph (1) with respect to such component, as determined without regard to this paragraph, multiplied by\n(ii) the phase out percentage")
rule CreditAmount45xPhasedOutRule(component: Asset, y: TaxableYear, before: Money, on: Date, pct: Decimal) strict {
    when credit_amount_before_phaseout_45x(component, y, before);
    when component_sale_date_45x(component, on);
    when phaseout_percentage_45x(on, pct);
    then credit_amount_45x(component, y, round(before * pct, 2, "HALF_UP"));
}
relation has_component_sale_date_45x(component: Asset) kind institutional;
rule HasComponentSaleDate45xRule(component: Asset, on: Date) strict {
    when component_sale_date_45x(component, on);
    then has_component_sale_date_45x(component);
}
rule CreditAmount45xNotYetPhasedOutRule(component: Asset, y: TaxableYear, before: Money) defeasible {
    when credit_amount_before_phaseout_45x(component, y, before);
    when not_known(has_component_sale_date_45x(component));
    then credit_amount_45x(component, y, before);
}

// --- PL 119-21 section 70514: wind-energy-component termination ----------------

pub relation wind_energy_component_45x(component: Asset) kind empirical {
    label en official "the component is a wind energy component (section 45X(c)(3)) — case-asserted, for the PL 119-21 section 70514(b) termination";
}
pub relation terminated_wind_energy_component_45x(component: Asset) kind institutional {
    label en official "PL 119-21 section 70514(b), new section 45X(b)(3)(D): this section shall not apply to any wind energy component produced and sold after December 31, 2027";
}
@source(us.irc.temporal::PL119_21_S70514, quote = "Termination for wind energy components.—This section shall not apply to any wind energy component produced and sold after December 31, 2027.")
rule TerminatedWindEnergyComponent45xRule(component: Asset, on: Date) strict {
    when wind_energy_component_45x(component);
    when component_sale_date_45x(component, on);
    when on > @2027-12-31;
    then terminated_wind_energy_component_45x(component);
}

// --- §45X(a): allowance of credit -----------------------------------------------

pub relation total_component_credit_45x(taxpayer: Person, component: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "a single component's contribution to the section 45X credit, whichever of the three rules (rate-table, electrode-active-materials, applicable-critical-mineral) produced it — a bridging relation so the (a) sum can range over one uniform predicate";
}
rule TotalComponentCredit45xRateTableRule(taxpayer: Person, component: Asset, y: TaxableYear, amount: Money) defeasible {
    when eligible_component_produced_and_sold_45x(taxpayer, component, y, _);
    when credit_amount_45x(component, y, amount);
    then total_component_credit_45x(taxpayer, component, y, amount);
}
rule TotalComponentCredit45xElectrodeRule(taxpayer: Person, component: Asset, y: TaxableYear, amount: Money) defeasible {
    when electrode_active_materials_production_cost(taxpayer, component, y, _);
    when electrode_active_materials_credit_amount(component, y, amount);
    then total_component_credit_45x(taxpayer, component, y, amount);
}
rule TotalComponentCredit45xCriticalMineralRule(taxpayer: Person, component: Asset, y: TaxableYear, amount: Money) defeasible {
    when applicable_critical_mineral_production_cost(taxpayer, component, y, _);
    when applicable_critical_mineral_credit_amount(component, y, amount);
    then total_component_credit_45x(taxpayer, component, y, amount);
}
pub relation advanced_manufacturing_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45X(a): the advanced manufacturing production credit for the taxable year, summed across all eligible components (rate-table, electrode-active-material, and applicable-critical-mineral)";
}
@source(IRC_S45X_A, quote = "the advanced manufacturing production credit for any taxable year is an amount equal to the sum of the credit amounts determined under subsection (b) with respect to each eligible component")
rule AdvancedManufacturingProductionCreditRule(taxpayer: Person, y: TaxableYear) defeasible {
    when eligible_component_produced_and_sold_45x(taxpayer, _, y, _);
    then advanced_manufacturing_production_credit(taxpayer, y,
        sum all amount: Money for component: Asset where total_component_credit_45x(taxpayer, component, y, amount));
}
