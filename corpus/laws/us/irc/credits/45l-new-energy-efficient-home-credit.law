// Section 45L — New energy efficient home credit. Stage 2d (IRC-06,
// DECISION-0379).
//
// Editions (by `legal_time`, the temporal package pattern): the 2024 base text
// allows the credit for homes acquired through 2032-12-31; PL 119-21 section
// 70508 (`us.irc.temporal::PL119_21_S70508`, enacted 2025-07-04) moves the end
// to 2026-06-30. Two rules with `effective` windows carry the two texts; the
// windows are used instead of a `revision` because the temporal package pins
// the Public Law as separate fragments with no operation chain onto the IRC
// 2024 fragments.
//
// Scope / judgment calls:
// * (a)(2): the applicable amount: $2,500 (Energy Star single-family or
//   manufactured, (c)(1)(A)) or $5,000 (zero energy ready, (c)(1)(B)); $500 or
//   $1,000 for a multifamily unit. (g): a multifamily unit meeting the
//   prevailing wage requirements gets $2,500 / $5,000.
// * (c)(2)-(3): the versions of the Energy Star program requirements by
//   acquisition date are not computed: meeting the applicable requirements is
//   one case fact (TECH-GAPS G1546).
// * (e): the basis reduction is exposed as an amount; (f): expenditures taken
//   into account under section 47 or 48(a) are excluded.

use self::{
    Asset,
    IRC_S45L_A,
    IRC_S45L_B,
    IRC_S45L_G,
    IRC_S45L_H,
    Person,
    TaxableYear,
};

pub enum DwellingClass45L {
    SingleFamilyOrManufactured,
    Multifamily,
}

pub relation dwelling_class_45l(unit: Asset, cls: DwellingClass45L) kind empirical {
    label en official "the dwelling unit is a single-family or manufactured home (Energy Star Residential New Construction or Manufactured New Homes program), or a unit of a multifamily building (Energy Star Multifamily New Construction program) — case-asserted";
}
pub relation dwelling_in_united_states_45l(unit: Asset) kind empirical {
    label en official "the dwelling unit is located in the United States (section 45L(b)(2)(A)) — case-asserted";
}
pub relation construction_substantially_completed_on_45l(unit: Asset, on: Date) kind empirical {
    label en official "the date the construction (including substantial reconstruction and rehabilitation) is substantially completed (sections 45L(b)(2)(B), (b)(3)) — case-asserted";
}
pub relation section_45l_enacted_on(on: Date) kind empirical {
    label en official "the date of enactment of section 45L — case-asserted from the pinned Public Law note";
}
pub relation meets_energy_saving_requirements_45l(unit: Asset) kind empirical {
    label en official "the dwelling unit meets the (c)(2) (single-family/manufactured) or (c)(3) (multifamily) Energy Star program requirements applicable by acquisition date (section 45L(c)(1)(A)) — case-asserted, versions not computed";
}
pub relation certified_zero_energy_ready_home_45l(unit: Asset) kind empirical {
    label en official "the dwelling unit is certified as a zero energy ready home under the Department of Energy program as in effect on January 1, 2023 (section 45L(c)(1)(B)) — case-asserted";
}
pub relation constructed_by_person_45l(unit: Asset, person: Person) kind empirical {
    label en official "the person constructed the dwelling unit — case-asserted";
}
pub relation manufactured_home_producer_of_45l(unit: Asset, person: Person) kind empirical {
    label en official "the person is the manufactured home producer of the dwelling unit (section 45L(b)(1)(B)) — case-asserted";
}
pub relation acquired_from_contractor_for_residence_45l(unit: Asset, contractor: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "a person acquired the unit from the contractor for use as a residence during the taxable year, on this date (section 45L(a)(1)(B)) — case-asserted";
}
pub relation meets_prevailing_wage_requirements_45l(unit: Asset) kind empirical {
    label en official "the taxpayer ensures the prevailing wage requirements for laborers and mechanics in the construction of the residence (section 45L(g)(2)(A)) — case-asserted";
}
pub relation expenditures_taken_into_account_under_47_or_48_45l(unit: Asset) kind empirical {
    label en official "expenditures for the unit are taken into account under section 47 or 48(a) (section 45L(f)) — case-asserted";
}

pub relation eligible_contractor_45l(person: Person, unit: Asset) kind institutional {
    label en official "section 45L(b)(1): the person who constructed the home, or for a manufactured home the manufactured home producer";
}
rule EligibleContractorBuilder45lRule(person: Person, unit: Asset) strict {
    when constructed_by_person_45l(unit, person);
    then eligible_contractor_45l(person, unit);
}
rule EligibleContractorProducer45lRule(person: Person, unit: Asset) strict {
    when manufactured_home_producer_of_45l(unit, person);
    then eligible_contractor_45l(person, unit);
}
pub relation qualified_new_energy_efficient_home_45l(unit: Asset) kind institutional {
    label en official "section 45L(b)(2): a dwelling unit in the United States, construction substantially completed after enactment, meeting the energy saving requirements";
}
@source(IRC_S45L_B, quote = "the construction of which is substantially completed after the date of the enactment of this section")
rule QualifiedNewEnergyEfficientHome45lRule(unit: Asset, done: Date, enacted: Date) strict {
    when dwelling_in_united_states_45l(unit);
    when construction_substantially_completed_on_45l(unit, done);
    when section_45l_enacted_on(enacted);
    when done > enacted;
    when meets_energy_saving_requirements_45l(unit);
    then qualified_new_energy_efficient_home_45l(unit);
}

// --- (a)(2), (g): the applicable amount ---------------------------------------------------------------

pub relation applicable_amount_45l(unit: Asset, amount: Money) kind institutional {
    label en official "section 45L(a)(2), (g)(1): $2,500 / $5,000 for a single-family or manufactured home; $500 / $1,000 for a multifamily unit, $2,500 / $5,000 when the prevailing wage requirements are met";
}
@source(IRC_S45L_A, quote = "which meets the requirements of subsection (c)(1)(B), $5,000")
rule ApplicableAmountSingleFamilyZeroEnergy45lRule(unit: Asset) strict {
    when dwelling_class_45l(unit, SingleFamilyOrManufactured);
    when certified_zero_energy_ready_home_45l(unit);
    then applicable_amount_45l(unit, 5000.00 USD);
}
@source(IRC_S45L_A, quote = "(and which does not meet the requirements of subsection (c)(1)(B)), $2,500")
rule ApplicableAmountSingleFamilyEnergyStar45lRule(unit: Asset) strict {
    when dwelling_class_45l(unit, SingleFamilyOrManufactured);
    when not_known(certified_zero_energy_ready_home_45l(unit));
    then applicable_amount_45l(unit, 2500.00 USD);
}
@source(IRC_S45L_A, quote = "which meets the requirements of subsection (c)(1)(B), $1,000")
rule ApplicableAmountMultifamilyZeroEnergy45lRule(unit: Asset) strict {
    when dwelling_class_45l(unit, Multifamily);
    when certified_zero_energy_ready_home_45l(unit);
    when not_known(meets_prevailing_wage_requirements_45l(unit));
    then applicable_amount_45l(unit, 1000.00 USD);
}
@source(IRC_S45L_A, quote = "(and which does not meet the requirements of subsection (c)(1)(B)), $500")
rule ApplicableAmountMultifamilyEnergyStar45lRule(unit: Asset) strict {
    when dwelling_class_45l(unit, Multifamily);
    when not_known(certified_zero_energy_ready_home_45l(unit));
    when not_known(meets_prevailing_wage_requirements_45l(unit));
    then applicable_amount_45l(unit, 500.00 USD);
}
@source(IRC_S45L_G, quote = "$5,000 in the case of a residence which meets the requirements of subsection (c)(1)(B)")
rule ApplicableAmountMultifamilyZeroEnergyWage45lRule(unit: Asset) strict {
    when dwelling_class_45l(unit, Multifamily);
    when certified_zero_energy_ready_home_45l(unit);
    when meets_prevailing_wage_requirements_45l(unit);
    then applicable_amount_45l(unit, 5000.00 USD);
}
@source(IRC_S45L_G, quote = "$2,500 in the case of a residence which meets the requirements of subparagraph (A) of subsection (c)(1)")
rule ApplicableAmountMultifamilyEnergyStarWage45lRule(unit: Asset) strict {
    when dwelling_class_45l(unit, Multifamily);
    when not_known(certified_zero_energy_ready_home_45l(unit));
    when meets_prevailing_wage_requirements_45l(unit);
    then applicable_amount_45l(unit, 2500.00 USD);
}

// --- (h): termination, base and PL 119-21 editions --------------------------------------------------------

pub relation acquired_within_credit_period_45l(unit: Asset) kind institutional {
    label en official "section 45L(h): acquired on or before 2032-12-31 (2024 text); on or before 2026-06-30 under PL 119-21 section 70508 from its enactment";
}
@source(IRC_S45L_H, quote = "This section shall not apply to any qualified new energy efficient home acquired after December 31, 2032.")
rule AcquiredWithinCreditPeriodBase45lRule(unit: Asset, contractor: Person, y: TaxableYear, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when acquired_from_contractor_for_residence_45l(unit, contractor, y, on);
    when on <= @2032-12-31;
    then acquired_within_credit_period_45l(unit);
}
@source(us.irc.temporal::PL119_21_S70508, quote = "Section 45L(h) is amended by striking “December 31, 2032” and inserting “June 30, 2026”.")
rule AcquiredWithinCreditPeriodAmended45lRule(unit: Asset, contractor: Person, y: TaxableYear, on: Date) strict {
    effective [@2025-07-04, infinity);
    when acquired_from_contractor_for_residence_45l(unit, contractor, y, on);
    when on <= @2026-06-30;
    then acquired_within_credit_period_45l(unit);
}

// --- (a): the credit ---------------------------------------------------------------------------------------------

pub relation new_energy_efficient_home_credit_per_unit_45l(contractor: Person, unit: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45L(a)(1): the applicable amount for a qualified new energy efficient home constructed by the eligible contractor and acquired for use as a residence during the taxable year";
}
@source(IRC_S45L_A, quote = "the new energy efficient home credit for the taxable year is the applicable amount for each qualified new energy efficient home")
rule NewEnergyEfficientHomeCreditPerUnit45lRule(contractor: Person, unit: Asset, y: TaxableYear, on: Date, amount: Money) defeasible {
    when eligible_contractor_45l(contractor, unit);
    when qualified_new_energy_efficient_home_45l(unit);
    when acquired_from_contractor_for_residence_45l(unit, contractor, y, on);
    when acquired_within_credit_period_45l(unit);
    when not_known(expenditures_taken_into_account_under_47_or_48_45l(unit));
    when applicable_amount_45l(unit, amount);
    then new_energy_efficient_home_credit_per_unit_45l(contractor, unit, y, amount);
}
pub relation new_energy_efficient_home_credit(contractor: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45L new energy efficient home credit for the taxable year (a section 38(b)(23) component)";
}
rule NewEnergyEfficientHomeCredit45lRule(contractor: Person, y: TaxableYear, unit: Asset, amount: Money) defeasible {
    when new_energy_efficient_home_credit_per_unit_45l(contractor, unit, y, amount);
    then new_energy_efficient_home_credit(contractor, y,
        sum(collect all a: Money, u: Asset where new_energy_efficient_home_credit_per_unit_45l(contractor, u, y, a), empty: 0 USD));
}
pub relation basis_reduction_45l(contractor: Person, unit: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45L(e): the increase in basis resulting from the expenditure is reduced by the credit (exposed as an amount; the basis ledger is owned by another package)";
}
rule BasisReduction45lRule(contractor: Person, unit: Asset, y: TaxableYear, amount: Money) defeasible {
    when new_energy_efficient_home_credit_per_unit_45l(contractor, unit, y, amount);
    then basis_reduction_45l(contractor, unit, y, amount);
}
