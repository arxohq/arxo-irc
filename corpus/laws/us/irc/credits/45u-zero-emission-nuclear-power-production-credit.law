// Section 45U — Zero-emission nuclear power production credit. Stage 2d
// (IRC-06, DECISION-0379).
//
// Base edition (2024) modelled with the PL 119-21 section 70510 restrictions
// (`us.irc.temporal::PL119_21_S70510`): no credit for a taxable year beginning
// after the date of enactment if the taxpayer is a specified foreign entity,
// nor after the date 2 years later if a foreign-influenced entity.
//
// Scope / judgment calls:
// * (a): the credit is the excess of 0.3 cents x kilowatt hours produced at a
//   qualified nuclear facility and sold to an unrelated person over the
//   reduction amount; (b)(2): the reduction amount is the lesser of the
//   (a)(1) amount and 16 percent of the excess of gross receipts (including
//   zero-emission credit program payments, unless fully offset by the credit)
//   over 2.5 cents x kilowatt hours. (c)(1): both cent amounts are multiplied
//   by the inflation adjustment factor (case-asserted, not pinned), rounded to
//   0.05 cent and 0.1 cent. (d): x5 when the prevailing wage requirements are
//   satisfied (one case fact). (e): not after taxable years beginning after
//   2032-12-31.
// * The date of enactment of section 45U and of paragraph (3) are case facts
//   (the latter July 4, 2025 for PL 119-21). Rules similar to section 45(e)
//   ((c)(2)) and the regulations of (d)(3) are not modelled (TECH-GAPS G1544).

use self::{
    Asset,
    IRC_S45U_A,
    IRC_S45U_B,
    IRC_S45U_C,
    IRC_S45U_D,
    IRC_S45U_E,
    Person,
    TaxableYear,
    credit_of_owner_of_facility_45u,
    electricity_kilowatt_hours_for_credit_45u,
    zero_emission_program_receipts_for_credit_45u,
};

pub relation nuclear_facility_owned_by_taxpayer_45u(facility: Asset, taxpayer: Person) kind empirical {
    label en official "the facility is owned by the taxpayer and uses nuclear energy to produce electricity (section 45U(b)(1)(A)) — case-asserted";
}
pub relation advanced_nuclear_power_facility_45u(facility: Asset) kind empirical {
    label en official "the facility is an advanced nuclear power facility as defined in section 45J(d)(1) (section 45U(b)(1)(B)) — case-asserted";
}
pub relation facility_placed_in_service_on_45u(facility: Asset, on: Date) kind empirical {
    label en official "the date the facility is placed in service — case-asserted";
}
pub relation section_45u_enacted_on(on: Date) kind empirical {
    label en official "the date of enactment of section 45U — case-asserted from the pinned Public Law note";
}
pub relation kilowatt_hours_sold_45u(facility: Asset, y: TaxableYear, kwh: Decimal) kind empirical {
    label en official "kilowatt hours of electricity produced by the taxpayer at the facility and sold to an unrelated person during the taxable year (section 45U(a)(1)(B)) — case-asserted";
}
pub relation gross_receipts_from_electricity_45u(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross receipts from electricity produced by the facility (including electricity services or products provided in conjunction) sold to an unrelated person during the taxable year (section 45U(b)(2)(A)(ii)(I)) — case-asserted";
}
pub relation zero_emission_credit_program_receipts_45u(facility: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts received during the taxable year from a zero-emission credit program with respect to the facility, net of reductions required under the program (section 45U(b)(2)(B)(i)) — case-asserted";
}
pub relation credit_fully_offsets_program_payments_45u(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the full amount of the credit calculated under subsection (a) is used to reduce payments from the zero-emission credit program (section 45U(b)(2)(B)(iii)) — case-asserted";
}
pub relation inflation_adjustment_factor_45u(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the inflation adjustment factor for the calendar year of the sale under section 45(e)(2) with 2023 substituted for 1992 (section 45U(c)(1)) — case-asserted, not pinned";
}
pub relation prevailing_wage_requirements_satisfied_45u(facility: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer ensures prevailing wages in the alteration or repair of the facility, under rules similar to section 45(b)(7)(B) (section 45U(d)(2)) — case-asserted";
}
pub relation specified_foreign_entity_45u(taxpayer: Person) kind empirical {
    label en official "the taxpayer is a specified foreign entity as defined in section 7701(a)(51)(B) — case-asserted";
}
pub relation foreign_influenced_entity_45u(taxpayer: Person) kind empirical {
    label en official "the taxpayer is a foreign-influenced entity as defined in section 7701(a)(51)(D), without regard to clause (i)(II) — case-asserted";
}
pub relation paragraph_c3_enacted_on_45u(on: Date) kind empirical {
    label en official "the date of enactment of section 45U(c)(3) (PL 119-21, July 4, 2025) — case-asserted";
}

pub relation qualified_nuclear_power_facility_45u(facility: Asset, taxpayer: Person) kind institutional {
    label en official "section 45U(b)(1): a nuclear facility owned by the taxpayer, not an advanced nuclear power facility, placed in service before the date of enactment";
}
@source(IRC_S45U_B, quote = "which is placed in service before the date of the enactment of this section")
rule QualifiedNuclearPowerFacility45uRule(facility: Asset, taxpayer: Person, placed: Date, enacted: Date) strict {
    when nuclear_facility_owned_by_taxpayer_45u(facility, taxpayer);
    when not_known(advanced_nuclear_power_facility_45u(facility));
    when facility_placed_in_service_on_45u(facility, placed);
    when section_45u_enacted_on(enacted);
    when placed < enacted;
    then qualified_nuclear_power_facility_45u(facility, taxpayer);
}

pub relation section_45u_in_force_for_year(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "sections 45U(e), (c)(3) (PL 119-21): taxable years beginning on or before 2032-12-31, and no specified foreign entity after enactment of paragraph (3), no foreign-influenced entity 2 years after";
}
@source(IRC_S45U_E, quote = "This section shall not apply to taxable years beginning after December 31, 2032.")
rule Section45uInForceRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    when nuclear_facility_owned_by_taxpayer_45u(_, taxpayer);
    when us.irc.core::begins(y, begin);
    when begin <= @2032-12-31;
    when paragraph_c3_enacted_on_45u(enacted);
    when begin <= enacted;
    then section_45u_in_force_for_year(taxpayer, y);
}
@source(us.irc.temporal::PL119_21_S70510, quote = "No credit shall be determined under subsection (a) for any taxable year beginning after the date of enactment of this paragraph if the taxpayer is a specified foreign entity")
rule Section45uInForceAfterEnactmentRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective [@2025-07-04, infinity);
    when nuclear_facility_owned_by_taxpayer_45u(_, taxpayer);
    when us.irc.core::begins(y, begin);
    when begin <= @2032-12-31;
    when paragraph_c3_enacted_on_45u(enacted);
    when begin > enacted;
    when begin <= add_calendar_period(enacted, 24 calendar_month);
    when not_known(specified_foreign_entity_45u(taxpayer));
    then section_45u_in_force_for_year(taxpayer, y);
}
@source(us.irc.temporal::PL119_21_S70510, quote = "No credit shall be determined under subsection (a) for any taxable year beginning after the date which is 2 years after the date of enactment of this paragraph if the taxpayer is a foreign-influenced entity")
rule Section45uInForceLateRule(taxpayer: Person, y: TaxableYear, begin: Date, enacted: Date) strict {
    effective [@2025-07-04, infinity);
    when nuclear_facility_owned_by_taxpayer_45u(_, taxpayer);
    when us.irc.core::begins(y, begin);
    when begin <= @2032-12-31;
    when paragraph_c3_enacted_on_45u(enacted);
    when begin > add_calendar_period(enacted, 24 calendar_month);
    when not_known(specified_foreign_entity_45u(taxpayer));
    when not_known(foreign_influenced_entity_45u(taxpayer));
    then section_45u_in_force_for_year(taxpayer, y);
}

// --- (c)(1): the indexed cent amounts ---------------------------------------------------------------

rule Section45uInForceBeforeAmendmentRule(taxpayer: Person, y: TaxableYear, begin: Date) strict {
    effective (-infinity, @2025-07-04);
    when nuclear_facility_owned_by_taxpayer_45u(_, taxpayer);
    when us.irc.core::begins(y, begin);
    when begin > @2025-07-04;
    when begin <= @2032-12-31;
    then section_45u_in_force_for_year(taxpayer, y);
}

pub relation credit_cents_per_kwh_45u(y: TaxableYear, cents: Decimal) kind institutional {
    label en official "section 45U(a)(1)(A), (c)(1): 0.3 cent times the inflation adjustment factor, rounded to the nearest 0.05 cent";
}
@source(IRC_S45U_C, quote = "If the 0.3 cent amount as increased under this paragraph is not a multiple of 0.05 cent, such amount shall be rounded to the nearest multiple of 0.05 cent.")
rule CreditCentsPerKwh45uRule(y: TaxableYear, factor: Decimal) strict {
    when inflation_adjustment_factor_45u(y, factor);
    then credit_cents_per_kwh_45u(y, div_round(round(0.3 * factor * 20.0, 0, "HALF_UP"), 20.0, 10, "HALF_UP"));
}
pub relation threshold_cents_per_kwh_45u(y: TaxableYear, cents: Decimal) kind institutional {
    label en official "section 45U(b)(2)(A)(ii)(II)(aa), (c)(1): 2.5 cents times the inflation adjustment factor, rounded to the nearest 0.1 cent";
}
@source(IRC_S45U_C, quote = "If the 2.5 cent amount as increased under this paragraph is not a multiple of 0.1 cent, such amount shall be rounded to the nearest multiple of 0.1 cent.")
rule ThresholdCentsPerKwh45uRule(y: TaxableYear, factor: Decimal) strict {
    when inflation_adjustment_factor_45u(y, factor);
    then threshold_cents_per_kwh_45u(y, round(2.5 * factor, 1, "HALF_UP"));
}

// --- (a), (b)(2): the credit and the reduction amount ------------------------------------------------

pub relation credit_before_reduction_45u(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45U(a)(1): the indexed cents per kilowatt hour times the kilowatt hours produced and sold";
}
@source(IRC_S45U_A, quote = "the product of—\n(A) 0.3 cents, multiplied by")
rule CreditBeforeReduction45uRule(facility: Asset, y: TaxableYear, cents: Decimal, kwh: Decimal) defeasible {
    when credit_cents_per_kwh_45u(y, cents);
    when electricity_kilowatt_hours_for_credit_45u(facility, y, kwh);
    then credit_before_reduction_45u(facility, y, round(div_round(cents, 100.0, 10, "HALF_UP") * kwh, 2, "HALF_UP") * 1 USD);
}
pub relation section_45u_program_receipts_included_45u(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45U(b)(2)(B): zero-emission credit program receipts included in gross receipts, unless the credit fully offsets the program payments";
}
@source(IRC_S45U_B, quote = "any amount received by the taxpayer from a zero-emission credit program shall be excluded from the amount determined under subparagraph (A)(ii)(I) if the full amount of the credit calculated pursuant to subsection (a)")
rule ProgramReceiptsIncluded45uRule(facility: Asset, y: TaxableYear, program: Money) defeasible {
    when zero_emission_program_receipts_for_credit_45u(facility, y, program);
    when not_known(credit_fully_offsets_program_payments_45u(facility, y));
    then section_45u_program_receipts_included_45u(facility, y, program);
}
rule ProgramReceiptsExcluded45uRule(facility: Asset, y: TaxableYear, program: Money) defeasible {
    when zero_emission_program_receipts_for_credit_45u(facility, y, program);
    when credit_fully_offsets_program_payments_45u(facility, y);
    then section_45u_program_receipts_included_45u(facility, y, 0 USD);
}
relation has_program_receipts_45u(facility: Asset, y: TaxableYear) kind institutional;
rule HasProgramReceipts45uRule(facility: Asset, y: TaxableYear, program: Money) defeasible {
    when zero_emission_program_receipts_for_credit_45u(facility, y, program);
    then has_program_receipts_45u(facility, y);
}
rule NoProgramReceipts45uRule(facility: Asset, y: TaxableYear, receipts: Money) defeasible {
    when gross_receipts_from_electricity_45u(facility, y, receipts);
    when not_known(has_program_receipts_45u(facility, y));
    then section_45u_program_receipts_included_45u(facility, y, 0 USD);
}
pub relation reduction_amount_45u(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45U(b)(2)(A): the lesser of the (a)(1) amount and 16 percent of the excess of gross receipts over 2.5 (indexed) cents times the kilowatt hours";
}
@source(IRC_S45U_B, quote = "the amount equal to 16 percent of the excess of")
rule ReductionAmount45uRule(facility: Asset, y: TaxableYear, product: Money, receipts: Money, program: Money, threshold_cents: Decimal, kwh: Decimal) defeasible {
    when credit_before_reduction_45u(facility, y, product);
    when gross_receipts_from_electricity_45u(facility, y, receipts);
    when section_45u_program_receipts_included_45u(facility, y, program);
    when threshold_cents_per_kwh_45u(y, threshold_cents);
    when electricity_kilowatt_hours_for_credit_45u(facility, y, kwh);
    then reduction_amount_45u(facility, y, min(product, round(0.16 * max(0 USD, receipts + program - round(div_round(threshold_cents, 100.0, 10, "HALF_UP") * kwh, 2, "HALF_UP") * 1 USD), 2, "HALF_UP")));
}
pub relation zero_emission_nuclear_credit_before_wage_multiplier_45u(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45U(a): the excess of the (a)(1) product over the reduction amount";
}
rule CreditBeforeWageMultiplier45uRule(facility: Asset, y: TaxableYear, product: Money, reduction: Money) defeasible {
    when credit_before_reduction_45u(facility, y, product);
    when reduction_amount_45u(facility, y, reduction);
    then zero_emission_nuclear_credit_before_wage_multiplier_45u(facility, y, product - reduction);
}
pub relation zero_emission_nuclear_power_production_credit_of_facility_45u(facility: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45U(a), (d)(1): the credit of the facility, multiplied by 5 when the prevailing wage requirements are satisfied";
}
@source(IRC_S45U_D, quote = "the amount of the credit determined under subsection (a) shall be equal to such amount (as determined without regard to this sentence) multiplied by 5")
rule ZeroEmissionCreditMultiplied45uRule(facility: Asset, y: TaxableYear, taxpayer: Person, base: Money) defeasible {
    when qualified_nuclear_power_facility_45u(facility, taxpayer);
    when section_45u_in_force_for_year(taxpayer, y);
    when zero_emission_nuclear_credit_before_wage_multiplier_45u(facility, y, base);
    when prevailing_wage_requirements_satisfied_45u(facility, y);
    then zero_emission_nuclear_power_production_credit_of_facility_45u(facility, y, base * 5.0);
}
@source(IRC_S45U_A, quote = "the zero-emission nuclear power production credit for any taxable year is an amount equal to the amount by which")
rule ZeroEmissionCreditBase45uRule(facility: Asset, y: TaxableYear, taxpayer: Person, base: Money) defeasible {
    when qualified_nuclear_power_facility_45u(facility, taxpayer);
    when section_45u_in_force_for_year(taxpayer, y);
    when zero_emission_nuclear_credit_before_wage_multiplier_45u(facility, y, base);
    when not_known(prevailing_wage_requirements_satisfied_45u(facility, y));
    then zero_emission_nuclear_power_production_credit_of_facility_45u(facility, y, base);
}
pub relation zero_emission_nuclear_power_production_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45U zero-emission nuclear power production credit for the taxable year (a section 38(b)(34) component)";
}
rule ZeroEmissionNuclearPowerProductionCredit45uRule(taxpayer: Person, y: TaxableYear, facility: Asset, amount: Money) defeasible {
    when credit_of_owner_of_facility_45u(facility, taxpayer, y, amount);
    then zero_emission_nuclear_power_production_credit(taxpayer, y,
        sum(collect all a: Money, f: Asset where credit_of_owner_of_facility_45u(f, taxpayer, y, a), empty: 0 USD));
}
