// Section 48D — Advanced manufacturing investment credit. Stage 2d (IRC-06,
// DECISION-0379). A section 46 component (an investment credit).
//
// Scope / judgment calls:
// * (a): 25 percent of the qualified investment; 35 percent for property
//   placed in service after 2025-12-31 (PL 119-21 section 70308, pinned as
//   `us.irc.temporal::PL119_21_S70308`, enacted 2025-07-04). Two editions by
//   `legal_time` (`effective` windows, not a `revision`: the temporal package
//   pins the Public Law as separate fragments): before 2025-07-04 the rate is 25
//   percent for all property; from 2025-07-04 property placed in service after
//   2025-12-31 gets 35 percent.
// * (e): no credit for property the construction of which begins after
//   2026-12-31.
// * (b)(2): qualified property is derived from the case facts (tangible,
//   depreciable, constructed or originally used by the taxpayer, integral to
//   the facility; a building portion used for offices or functions unrelated
//   to manufacturing is excluded). (b)(3): the facility test is a case fact.
// * (c): eligible taxpayer: not a foreign entity of concern and no
//   applicable transaction (section 50(a)) in the year; both are case facts.
// * (d): the direct-pay election is a POWER; its validity is the timing rule
//   (not earlier than 270 days after enactment, not later than the return due
//   date including extensions). The payment is deemed made on the later of the
//   due date without extensions and the filing date; the credit is reduced to
//   zero but deemed allowed. Excessive payments add tax and a 20 percent
//   amount unless reasonable cause (an external judgment of the Secretary).
//   Partnership and S corporation mechanics, possessions, section 1324 of
//   title 31 and the regulatory mandate are not modelled (TECH-GAPS G1524).

use self::{
    Asset,
    IRC_S48D_A,
    IRC_S48D_B,
    IRC_S48D_C,
    IRC_S48D_D,
    IRC_S48D_E,
    Person,
    TaxableYear,
};

pub relation qualified_property_basis_48d(taxpayer: Person, facility: Asset, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the basis of qualified property placed in service by the taxpayer during the taxable year as part of the advanced manufacturing facility (section 48D(b)(1)) — case-asserted";
}
pub relation property_placed_in_service_date_48d(prop: Asset, on: Date) kind empirical {
    label en official "the date the property is placed in service — case-asserted";
}
pub relation property_construction_begin_date_48d(prop: Asset, on: Date) kind empirical {
    label en official "the date construction of the property begins — case-asserted";
}
pub relation rehabilitation_portion_of_basis_48d(prop: Asset, amount: Money) kind empirical {
    label en official "the part of the property's basis attributable to qualified rehabilitation expenditures (section 47(c)(2)) — case-asserted";
}
pub relation facility_primary_purpose_semiconductor_manufacturing_48d(facility: Asset) kind empirical {
    label en official "the primary purpose of the facility is the manufacturing of semiconductors or semiconductor manufacturing equipment (section 48D(b)(3)) — case-asserted";
}
pub relation tangible_property_48d(prop: Asset) kind empirical {
    label en official "the property is tangible property (section 48D(b)(2)(A)(i)) — case-asserted";
}
pub relation depreciation_allowable_48d(prop: Asset) kind empirical {
    label en official "depreciation (or amortization in lieu of depreciation) is allowable for the property (section 48D(b)(2)(A)(ii)) — case-asserted";
}
pub relation constructed_or_originally_used_by_taxpayer_48d(prop: Asset, taxpayer: Person) kind empirical {
    label en official "the property was constructed, reconstructed, or erected by the taxpayer, or acquired with original use commencing with the taxpayer (section 48D(b)(2)(A)(iii)) — case-asserted";
}
pub relation integral_to_operation_of_facility_48d(prop: Asset, facility: Asset) kind empirical {
    label en official "the property is integral to the operation of the advanced manufacturing facility (section 48D(b)(2)(A)(iv)) — case-asserted";
}
pub relation building_used_for_offices_or_unrelated_functions_48d(prop: Asset) kind empirical {
    label en official "the building or portion of a building is used for offices, administrative services, or other functions unrelated to manufacturing (section 48D(b)(2)(B)(ii)) — case-asserted";
}
pub relation foreign_entity_of_concern_48d(taxpayer: Person) kind empirical {
    label en official "the taxpayer is a foreign entity of concern as defined in section 9901(6) of the FY2021 National Defense Authorization Act (section 48D(c)(1)) — case-asserted";
}
pub relation made_applicable_transaction_48d(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer made an applicable transaction, as defined in section 50(a), during the taxable year (section 48D(c)(2)) — case-asserted";
}

// --- (b)(2), (c): qualified property, eligible taxpayer ---------------------------------

pub relation qualified_property_48d(prop: Asset, facility: Asset, taxpayer: Person) kind institutional {
    label en official "section 48D(b)(2): qualified property of an advanced manufacturing facility";
}
@source(IRC_S48D_B, quote = "which is integral to the operation of the advanced manufacturing facility")
rule QualifiedProperty48dRule(prop: Asset, facility: Asset, taxpayer: Person) strict {
    when tangible_property_48d(prop);
    when depreciation_allowable_48d(prop);
    when constructed_or_originally_used_by_taxpayer_48d(prop, taxpayer);
    when integral_to_operation_of_facility_48d(prop, facility);
    when facility_primary_purpose_semiconductor_manufacturing_48d(facility);
    when not_known(building_used_for_offices_or_unrelated_functions_48d(prop));
    then qualified_property_48d(prop, facility, taxpayer);
}
pub relation eligible_taxpayer_48d(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 48D(c): a taxpayer that is not a foreign entity of concern and made no applicable transaction during the taxable year";
}
@source(IRC_S48D_C, quote = "has not made an applicable transaction (as defined in section 50(a)) during the taxable year")
rule EligibleTaxpayer48dRule(taxpayer: Person, y: TaxableYear, prop: Asset, facility: Asset, basis: Money) strict {
    when qualified_property_basis_48d(taxpayer, facility, prop, y, basis);
    when not_known(foreign_entity_of_concern_48d(taxpayer));
    when not_known(made_applicable_transaction_48d(taxpayer, y));
    then eligible_taxpayer_48d(taxpayer, y);
}

// --- (a), (b), (e): the credit ---------------------------------------------------------

pub relation qualified_investment_of_property_48d(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(b)(1), (b)(4): the basis of the qualified property less the part attributable to qualified rehabilitation expenditures";
}
@source(IRC_S48D_B, quote = "The qualified investment with respect to any advanced manufacturing facility for any taxable year shall not include that portion of the basis of any property which is attributable to qualified rehabilitation expenditures (as defined in section 47(c)(2)).")
rule QualifiedInvestmentWithRehab48dRule(taxpayer: Person, facility: Asset, prop: Asset, y: TaxableYear, basis: Money, rehab: Money) strict {
    when qualified_property_basis_48d(taxpayer, facility, prop, y, basis);
    when qualified_property_48d(prop, facility, taxpayer);
    when rehabilitation_portion_of_basis_48d(prop, rehab);
    then qualified_investment_of_property_48d(taxpayer, prop, y, max(0 USD, basis - rehab));
}
relation has_rehabilitation_portion_48d(prop: Asset) kind institutional;
rule HasRehabilitationPortion48dRule(prop: Asset, rehab: Money) strict {
    when rehabilitation_portion_of_basis_48d(prop, rehab);
    then has_rehabilitation_portion_48d(prop);
}
rule QualifiedInvestmentNoRehab48dRule(taxpayer: Person, facility: Asset, prop: Asset, y: TaxableYear, basis: Money) strict {
    when qualified_property_basis_48d(taxpayer, facility, prop, y, basis);
    when qualified_property_48d(prop, facility, taxpayer);
    when not_known(has_rehabilitation_portion_48d(prop));
    then qualified_investment_of_property_48d(taxpayer, prop, y, basis);
}
pub relation credit_rate_48d(prop: Asset, rate: Decimal) kind institutional {
    label en official "section 48D(a): 25 percent; 35 percent for property placed in service after December 31, 2025 (PL 119-21 section 70308)";
}
@source(IRC_S48D_A, quote = "25 percent of the qualified investment for such taxable year with respect to any advanced manufacturing facility of an eligible taxpayer")
rule CreditRate48dBaseRule(prop: Asset, on: Date) strict {
    when property_placed_in_service_date_48d(prop, on);
    when on <= @2025-12-31;
    then credit_rate_48d(prop, 0.25);
}
rule CreditRate48dBeforeAmendmentRule(prop: Asset, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when property_placed_in_service_date_48d(prop, on);
    when on > @2025-12-31;
    then credit_rate_48d(prop, 0.25);
}
@source(us.irc.temporal::PL119_21_S70308, quote = "Section 48D(a) is amended by striking “25 percent” and inserting “35 percent”.")
rule CreditRate48dEnhancedRule(prop: Asset, on: Date) strict {
    effective [@2025-07-04, infinity);
    when property_placed_in_service_date_48d(prop, on);
    when on > @2025-12-31;
    then credit_rate_48d(prop, 0.35);
}
pub relation section_48d_construction_window_open(prop: Asset) kind institutional {
    label en official "section 48D(e): the credit applies only to property the construction of which begins on or before December 31, 2026";
}
@source(IRC_S48D_E, quote = "The credit allowed under this section shall not apply to property the construction of which begins after December 31, 2026.")
rule Section48dConstructionWindowRule(prop: Asset, on: Date) strict {
    when property_construction_begin_date_48d(prop, on);
    when on <= @2026-12-31;
    then section_48d_construction_window_open(prop);
}
pub relation advanced_manufacturing_credit_of_property_48d(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(a): the credit of one property for the taxable year";
}
rule AdvancedManufacturingCreditOfProperty48dRule(taxpayer: Person, prop: Asset, y: TaxableYear, rate: Decimal, investment: Money) defeasible {
    when eligible_taxpayer_48d(taxpayer, y);
    when section_48d_construction_window_open(prop);
    when credit_rate_48d(prop, rate);
    when qualified_investment_of_property_48d(taxpayer, prop, y, investment);
    then advanced_manufacturing_credit_of_property_48d(taxpayer, prop, y, round(rate * investment, 2, "HALF_UP"));
}
pub relation advanced_manufacturing_credit_before_election_48d(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(a): the advanced manufacturing investment credit for the taxable year before the subsection (d) election is considered";
}
rule AdvancedManufacturingCreditBeforeElection48dRule(taxpayer: Person, y: TaxableYear, prop: Asset, amount: Money) defeasible {
    when advanced_manufacturing_credit_of_property_48d(taxpayer, prop, y, amount);
    then advanced_manufacturing_credit_before_election_48d(taxpayer, y,
        sum(collect all a: Money, p: Asset where advanced_manufacturing_credit_of_property_48d(taxpayer, p, y, a), empty: 0 USD));
}

// --- (d): election to treat the credit as a payment -------------------------------------

pub relation section_48d_enacted_on(on: Date) kind empirical {
    label en official "the date of enactment of section 48D — case-asserted from the pinned Public Law note (August 9, 2022 appears in the note to the section)";
}
pub relation elects_direct_pay_48d(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's exercise of the section 48D(d)(1) election to be treated as making a payment against tax";
}
pub relation direct_pay_election_made_on_48d(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the date the election is made — case-asserted";
}
pub relation return_due_date_with_extensions_48d(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the due date (including extensions of time) for the return of tax for the taxable year — case-asserted";
}
pub relation return_due_date_without_extensions_48d(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the due date (determined without regard to extensions) for the return of tax for the taxable year — case-asserted";
}
pub relation return_filed_on_48d(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the date the return for the taxable year is filed — case-asserted";
}
pub relation direct_pay_election_timely_48d(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 48D(d)(2)(B): the election is made not later than the return due date including extensions, and not earlier than 270 days after enactment";
}
@source(IRC_S48D_D, quote = "Any election under paragraph (1) shall be made not later than the due date (including extensions of time) for the return of tax for the taxable year for which the election is made, but in no event earlier than 270 days after the date of the enactment of this section.")
rule DirectPayElectionTimely48dRule(taxpayer: Person, y: TaxableYear, made: Date, due: Date, enacted: Date) strict {
    when direct_pay_election_made_on_48d(taxpayer, y, made);
    when return_due_date_with_extensions_48d(taxpayer, y, due);
    when section_48d_enacted_on(enacted);
    when made <= due;
    when made >= add_calendar_period(enacted, 270 calendar_day);
    then direct_pay_election_timely_48d(taxpayer, y);
}
pub relation direct_pay_election_in_effect_48d(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 48D(d)(1): the taxpayer is treated as making a payment against the tax imposed by subtitle A for the taxable year";
}
@source(IRC_S48D_D, quote = "such taxpayer shall be treated as making a payment against the tax imposed by subtitle A")
rule Section48dDirectPayElectionRule(taxpayer: Person, y: TaxableYear) strict {
    when elects_direct_pay_48d(taxpayer, y);
    then power Section48dD1Election {
        holder taxpayer;
        over taxpayer;
        exercise elects_direct_pay_48d(taxpayer, y);
        valid_when direct_pay_election_timely_48d(taxpayer, y);
        effect create(direct_pay_election_in_effect_48d(taxpayer, y));
        window [@2023-01-01, infinity);
    };
}
pub relation direct_pay_payment_amount_48d(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(d)(1): the amount treated as a payment: the credit determined under subsection (a)";
}
rule DirectPayPaymentAmount48dRule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when direct_pay_election_in_effect_48d(taxpayer, y);
    when advanced_manufacturing_credit_before_election_48d(taxpayer, y, amount);
    then direct_pay_payment_amount_48d(taxpayer, y, amount);
}
pub relation direct_pay_payment_made_on_48d(taxpayer: Person, y: TaxableYear, on: Date) kind institutional {
    label en official "section 48D(d)(2)(C): the payment is treated as made on the later of the return due date (without extensions) and the date the return is filed";
}
@source(IRC_S48D_D, quote = "The payment described in paragraph (1) shall be treated as made on the later of the due date (determined without regard to extensions) of the return of tax for the taxable year or the date on which such return is filed.")
rule DirectPayPaymentDateFiledLate48dRule(taxpayer: Person, y: TaxableYear, due: Date, filed: Date) strict {
    when direct_pay_election_in_effect_48d(taxpayer, y);
    when return_due_date_without_extensions_48d(taxpayer, y, due);
    when return_filed_on_48d(taxpayer, y, filed);
    when filed >= due;
    then direct_pay_payment_made_on_48d(taxpayer, y, filed);
}
rule DirectPayPaymentDateFiledEarly48dRule(taxpayer: Person, y: TaxableYear, due: Date, filed: Date) strict {
    when direct_pay_election_in_effect_48d(taxpayer, y);
    when return_due_date_without_extensions_48d(taxpayer, y, due);
    when return_filed_on_48d(taxpayer, y, filed);
    when filed < due;
    then direct_pay_payment_made_on_48d(taxpayer, y, due);
}
pub relation advanced_manufacturing_investment_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 48D credit remaining for the taxable year (a section 46(6) component of the investment credit): reduced to zero when the section 48D(d) election is in effect";
}
@source(IRC_S48D_D, quote = "such credit shall be reduced to zero and shall, for any other purposes under this title, be deemed to have been allowed to the taxpayer for such taxable year")
rule AdvancedManufacturingCreditElectedRule(taxpayer: Person, y: TaxableYear) defeasible {
    when direct_pay_election_in_effect_48d(taxpayer, y);
    then advanced_manufacturing_investment_credit(taxpayer, y, 0 USD);
}
rule AdvancedManufacturingCreditNotElectedRule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when advanced_manufacturing_credit_before_election_48d(taxpayer, y, amount);
    when not_known(direct_pay_election_in_effect_48d(taxpayer, y));
    then advanced_manufacturing_investment_credit(taxpayer, y, amount);
}
pub relation credit_deemed_allowed_48d(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(d)(3): for any other purposes under the title the credit is deemed allowed for the taxable year (in the amount determined under subsection (a))";
}
rule CreditDeemedAllowed48dRule(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    when direct_pay_election_in_effect_48d(taxpayer, y);
    when advanced_manufacturing_credit_before_election_48d(taxpayer, y, amount);
    then credit_deemed_allowed_48d(taxpayer, y, amount);
}

// --- (d)(2)(E)-(F): registration and excessive payments ----------------------------------

pub relation secretary_requires_registration_48d(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary requires information or registration as a condition of treating the amount as a payment (section 48D(d)(2)(E))";
}
pub relation registration_required_48d(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "the payment treatment is conditioned on the information or registration the Secretary requires";
}
@source(IRC_S48D_D, quote = "the Secretary may require such information or registration as the Secretary deems necessary or appropriate for purposes of preventing duplication, fraud, improper payments, or excessive payments under this section")
rule Section48dRegistrationPowerRule(taxpayer: Person, y: TaxableYear) strict {
    when direct_pay_election_in_effect_48d(taxpayer, y);
    then power Section48dD2ERegistrationRequirement {
        holder us.irc.core::Secretary;
        over taxpayer;
        exercise secretary_requires_registration_48d(taxpayer, y);
        valid_when direct_pay_election_in_effect_48d(taxpayer, y);
        effect create(registration_required_48d(taxpayer, y));
        window [@2023-01-01, infinity);
    };
}
pub relation excessive_payment_determination_48d(taxpayer: Person, determination_year: TaxableYear, payment: Money, otherwise_allowable_credit: Money) kind empirical {
    label en official "the Secretary determines that the payment treated as made (or paid) exceeds the credit otherwise allowable without regard to subsection (d) and section 38(c); the year of the determination — case-asserted";
}
pub relation excessive_payment_48d(taxpayer: Person, determination_year: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(d)(2)(F)(iii): the excess of the payment over the credit otherwise allowable";
}
@source(IRC_S48D_D, quote = "the term \"excessive payment\" means, with respect to property for which an election is made under this subsection for any taxable year, an amount equal to the excess of")
rule ExcessivePayment48dRule(taxpayer: Person, determination_year: TaxableYear, payment: Money, allowable: Money) strict {
    when excessive_payment_determination_48d(taxpayer, determination_year, payment, allowable);
    when payment > allowable;
    then excessive_payment_48d(taxpayer, determination_year, payment - allowable);
}
pub relation reasonable_cause_for_excessive_payment_48d(taxpayer: Person, determination_year: TaxableYear) kind empirical {
    label en official "the taxpayer demonstrates to the satisfaction of the Secretary that the excessive payment resulted from reasonable cause (section 48D(d)(2)(F)(ii)) — an evaluative judgment, DECISION-0194 external judgment of the Secretary, case-asserted";
}
pub relation excessive_payment_tax_increase_48d(taxpayer: Person, determination_year: TaxableYear, amount: Money) kind institutional {
    label en official "section 48D(d)(2)(F)(i): the increase of the chapter 1 tax for the year of the determination: the excessive payment plus 20 percent of it";
}
@source(IRC_S48D_D, quote = "the tax imposed on such taxpayer by chapter 1 for the taxable year in which such determination is made shall be increased by an amount equal to the sum of")
rule ExcessivePaymentTaxIncreaseWithoutRelief48dRule(taxpayer: Person, determination_year: TaxableYear, excess: Money) defeasible {
    when excessive_payment_48d(taxpayer, determination_year, excess);
    when not_known(reasonable_cause_for_excessive_payment_48d(taxpayer, determination_year));
    then excessive_payment_tax_increase_48d(taxpayer, determination_year, round(excess + 0.20 * excess, 2, "HALF_UP"));
}
@source(IRC_S48D_D, quote = "Clause (i)(II) shall not apply if the taxpayer demonstrates to the satisfaction of the Secretary that the excessive payment resulted from reasonable cause.")
rule ExcessivePaymentTaxIncreaseReasonableCause48dRule(taxpayer: Person, determination_year: TaxableYear, excess: Money) defeasible {
    when excessive_payment_48d(taxpayer, determination_year, excess);
    when reasonable_cause_for_excessive_payment_48d(taxpayer, determination_year);
    then excessive_payment_tax_increase_48d(taxpayer, determination_year, excess);
}
