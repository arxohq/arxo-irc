// Section 38(b) — wiring of the component credits into the current year
// business credit. Stage 2d (IRC-06, DECISION-0379).
//
// Stage 2 wired four components (investment credit 46, work opportunity 51,
// research 41, low-income housing 42). This module wires every other component
// whose own module exists in this package, so that `current_year_business_credit`
// (section 38(b)) sums them. The bridging rules are defeasible, as the section 38
// consumer reads defeasible producers (a strict consumer of a defeasible output
// fails LDC-E4103).
//
// Wired in stage 2d (second batch, modules 45a/45aa/45f/45h/45i/45j/45l/45o/
// 45u/45w/40b/45v/45z at the end of this file): 45A, 45F, 45H, 45I, 45J, 45L,
// 45O, 45U, 45W, 40B, 45V, 45Z, 45AA.
//
// Wired here: 40A (biodiesel), 43 (enhanced oil recovery), 44 (disabled
// access), 45 (renewable electricity production; taxpayer = owner of the
// facility as recorded by `owned_and_used_for_electricity_generation`), 45B
// (employer social security tips), 45C (orphan drug), 45E (pension startup and
// employer contribution credits, summed), 45G (railroad track), 45N (mine
// rescue), 45P (differential wage), 45R (small employer health insurance), 45S
// (paid family and medical leave), 45T (auto-enrollment), 45X (advanced
// manufacturing production), 45Y (clean electricity production, taxpayer =
// owner of the facility).
//
// NOT wired (their section modules are absent or personal-use only): the
// business-use parts of 30B, 30C and 30D (the wiring table is completed at the
// end of stage 2d); 40, 45D, 45K, 45Q are wired at the end of this file; the section 1396 and 5011
// components belong to other packages. They remain case-asserted through
// `general_business_credit_component_amount` (TECH-GAPS G1821 lists the ones
// still missing at the end of stage 2d).

use self::{
    Asset,
    GeneralBusinessCreditComponent,
    IRC_S38_B,
    Person,
    SimilarRule52Credit,
    TaxableYear,
    additional_credit_45e_f,
    advanced_manufacturing_production_credit,
    advanced_nuclear_credit_after_estate_apportionment_45j,
    agricultural_chemicals_security_credit,
    alcohol_fuels_credit,
    alternative_fuel_vehicle_refueling_property_business_credit,
    biodiesel_fuels_credit,
    carbon_dioxide_sequestration_credit,
    clean_electricity_production_credit,
    clean_fuel_production_credit,
    clean_hydrogen_production_credit,
    coal_increase_credit_45,
    credit_denied_by_similar_52c_rule,
    differential_wage_payment_credit,
    disabled_access_credit,
    employer_provided_child_care_credit,
    employer_social_security_credit,
    enhanced_oil_recovery_credit,
    general_business_credit_component_amount,
    indian_employment_credit,
    low_sulfur_diesel_fuel_production_credit,
    marginal_oil_and_gas_well_production_credit,
    military_spouse_retirement_plan_eligibility_credit,
    mine_rescue_team_training_credit,
    new_energy_efficient_home_credit,
    new_markets_tax_credit,
    nonconventional_source_production_credit,
    orphan_drug_credit,
    owned_and_used_for_electricity_generation,
    paid_family_medical_leave_credit,
    qualified_commercial_clean_vehicle_credit,
    railroad_track_maintenance_credit,
    renewable_electricity_production_credit,
    retirement_auto_enrollment_credit,
    small_employer_health_insurance_credit,
    small_employer_pension_plan_startup_cost_credit,
    sustainable_aviation_fuel_credit,
    zero_emission_credit_after_estate_apportionment_45u,
};

@source(IRC_S38_B, quote = "the biodiesel fuels credit determined under section 40A(a)")
rule GeneralBusinessCreditComponentBiodiesel defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when biodiesel_fuels_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, BiodieselFuelsCredit40A, amount);
}
@source(IRC_S38_B, quote = "the enhanced oil recovery credit under section 43(a)")
rule GeneralBusinessCreditComponentEnhancedOilRecovery defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when enhanced_oil_recovery_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, EnhancedOilRecoveryCredit43, amount);
}
@source(IRC_S38_B, quote = "the disabled access credit determined under section 44(a)")
rule GeneralBusinessCreditComponentDisabledAccess defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when disabled_access_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, DisabledAccessCredit44, amount);
}
// Section 45 total of the taxpayer: the credits of the owned electricity facilities plus the increases of
// refined coal, steel industry fuel and Indian coal after the owner allocation and the estate/trust
// apportionment (module s4-r); the three cases follow the pattern of the section 45E total below.
relation has_electricity_credit_45(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasElectricityCredit45 defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for facility: Asset;
    for amount: Money;
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when renewable_electricity_production_credit(facility, y, amount);
    then has_electricity_credit_45(taxpayer, y);
}
relation has_coal_increase_credit_45(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasCoalIncreaseCredit45 defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when coal_increase_credit_45(taxpayer, y, amount);
    then has_coal_increase_credit_45(taxpayer, y);
}
relation section_45_credit_with_coal_increase_45(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional;
rule Section45CreditBothParts defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for facility: Asset;
    for amount: Money;
    for increase: Money;
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when renewable_electricity_production_credit(facility, y, amount);
    when coal_increase_credit_45(taxpayer, y, increase);
    then section_45_credit_with_coal_increase_45(taxpayer, y,
        sum(collect all a: Money, f: Asset where owned_and_used_for_electricity_generation(f, taxpayer) and renewable_electricity_production_credit(f, y, a), empty: 0 USD) + increase);
}
rule Section45CreditElectricityOnly defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for facility: Asset;
    for amount: Money;
    when owned_and_used_for_electricity_generation(facility, taxpayer);
    when renewable_electricity_production_credit(facility, y, amount);
    when not_known(has_coal_increase_credit_45(taxpayer, y));
    then section_45_credit_with_coal_increase_45(taxpayer, y,
        sum(collect all a: Money, f: Asset where owned_and_used_for_electricity_generation(f, taxpayer) and renewable_electricity_production_credit(f, y, a), empty: 0 USD));
}
rule Section45CreditCoalIncreaseOnly defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for increase: Money;
    when coal_increase_credit_45(taxpayer, y, increase);
    when not_known(has_electricity_credit_45(taxpayer, y));
    then section_45_credit_with_coal_increase_45(taxpayer, y, increase);
}
@source(IRC_S38_B, quote = "the renewable electricity production credit under section 45(a)")
rule GeneralBusinessCreditComponentRenewableElectricity defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when section_45_credit_with_coal_increase_45(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, RenewableElectricityProductionCredit45, amount);
}
@source(IRC_S38_B, quote = "the employer social security credit determined under section 45B(a)")
rule GeneralBusinessCreditComponentEmployerSocialSecurity defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
