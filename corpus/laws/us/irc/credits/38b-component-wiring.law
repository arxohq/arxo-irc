// Section 38(b)(14): "the small employer pension plan startup cost credit
// determined under section 45E(a)" — the section 45E(f) additional employer
// contribution credit is part of the section 45E credit; both amounts are
// summed into one component row (two rows with the same amount would collapse
// in the distinct collection of the consumer).
relation section_45e_total_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional;
rule Section45eTotalCreditBoth defeasible {
    for employer: Person;
    for y: TaxableYear;
    for startup: Money;
    for additional: Money;
    when small_employer_pension_plan_startup_cost_credit(employer, y, startup);
    when additional_credit_45e_f(employer, y, additional);
    then section_45e_total_credit(employer, y, startup + additional);
}
relation has_additional_credit_45e_f(employer: Person, y: TaxableYear) kind institutional;
rule HasAdditionalCredit45eF defeasible {
    for employer: Person;
    for y: TaxableYear;
    for amount: Money;
    when additional_credit_45e_f(employer, y, amount);
    then has_additional_credit_45e_f(employer, y);
}
rule Section45eTotalCreditStartupOnly defeasible {
    for employer: Person;
    for y: TaxableYear;
    for startup: Money;
    when small_employer_pension_plan_startup_cost_credit(employer, y, startup);
    when not_known(has_additional_credit_45e_f(employer, y));
    then section_45e_total_credit(employer, y, startup);
}
relation has_startup_cost_credit_45e(employer: Person, y: TaxableYear) kind institutional;
rule HasStartupCostCredit45e defeasible {
    for employer: Person;
    for y: TaxableYear;
    for amount: Money;
    when small_employer_pension_plan_startup_cost_credit(employer, y, amount);
    then has_startup_cost_credit_45e(employer, y);
}
rule Section45eTotalCreditAdditionalOnly defeasible {
    for employer: Person;
    for y: TaxableYear;
    for additional: Money;
    when additional_credit_45e_f(employer, y, additional);
    when not_known(has_startup_cost_credit_45e(employer, y));
    then section_45e_total_credit(employer, y, additional);
}
@source(IRC_S38_B, quote = "the small employer pension plan startup cost credit determined under section 45E(a)")
rule GeneralBusinessCreditComponentSmallEmployerPension defeasible {
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when section_45e_total_credit(taxpayer, y, amount);
    then general_business_credit_component_amount(taxpayer, y, SmallEmployerPensionStartupCredit45E, amount);
}
