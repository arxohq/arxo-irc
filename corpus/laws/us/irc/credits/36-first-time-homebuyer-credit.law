// Section 36 — First-time homebuyer credit (the credit expired: the purchase must fall in the window of
// subsection (h)). Stage 2e (IRC-06, DECISION-0379, TECH_GAP reduction). The window is modelled as the text states
// it: comparisons of the purchase date with the statutory dates (the credit rules apply to a purchase on or after
// 2008-04-09 and before 2010-05-01, extended by (h)(2) to 2010-10-01 for a binding contract and by (h)(3) to
// 2011-05-01 (2011-10-01) for military and Foreign Service personnel abroad).
//
// Scope / judgment calls:
// * (a)-(b): 10 percent of the purchase price (adjusted basis at purchase), capped at $8,000 ($4,000 married filing
//   separately; $6,500 / $3,250 for a long-time resident, (c)(6)); unmarried co-purchasers split under the Secretary's
//   allocation (case facts) with the total held to the cap; phase-out over modified adjusted gross income above
//   $125,000 ($225,000 joint) over $20,000; no credit above an $800,000 price; age 18 (the spouse's age counts).
// * (c): first-time homebuyer = no present ownership interest in a principal residence in the 3 years ending on the
//   purchase date (taxpayer and spouse); "principal residence" (section 121), "related person" (sections 267,
//   707(b), family of spouse, ancestors and lineal descendants) and section 1014 / 1041 / 1033 references are
//   case facts of the neighbour sections (EXTERNAL_DEPENDENCY).
// * (f): the annual recapture of 1/15 (62/3 percent, written as `div_round(credit, 15.0, 2, "HALF_UP")`, never the
//   decimal 0.0667) applies to credits for purchases before 2009 only; for a later purchase only the 36-month
//   disposition recapture applies ((f)(4)(D)). The recapture in the disposition year is the credit less the annual
//   amounts already recaptured (cents HALF_UP judgment call: each year's 1/15 is rounded; the count of full years
//   already recaptured is a case fact).
// * (g): the election to treat the purchase as made on December 31 of the preceding calendar year is a power. The
//   preceding December 31 is one day before the first day of the calendar year of the purchase.
// * (e): the section 6045 reporting exception is EXTERNAL_DEPENDENCY (information-reporting package).

use self::{
    Asset,
    IRC_S36_A,
    IRC_S36_B,
    IRC_S36_C,
    IRC_S36_D,
    IRC_S36_F,
    IRC_S36_G,
    IRC_S36_H,
    Individual,
    TaxableYear,
};

pub relation individual_purchases_residence_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the individual acquires the principal residence in the United States (section 36(a), (c)(3)) — case-asserted";
}
pub relation acquisition_date_36(individual: Individual, residence: Asset, on: Date) kind empirical {
    label en official "the date the individual acquires the residence (section 36(c)(3)) — case-asserted";
}
pub relation residence_constructed_by_taxpayer_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the residence is constructed by the taxpayer (section 36(c)(3)(B)) — case-asserted";
}
pub relation first_occupancy_date_36(individual: Individual, residence: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer first occupies the constructed residence (section 36(c)(3)(B)) — case-asserted";
}
pub relation acquired_from_related_person_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the property is acquired from a person related to the acquirer (or, if married, the spouse): a relationship that would disallow losses under section 267 or 707(b), the family of an individual being only the spouse, ancestors and lineal descendants (section 36(c)(3)(A)(i), (c)(5)) — case-asserted (sections 267 and 707(b) are owned by other packages)";
}
pub relation basis_from_transferor_or_decedent_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the basis of the property in the acquirer's hands is determined in whole or in part by reference to the transferor's adjusted basis, or under section 1014(a) (property acquired from a decedent) (section 36(c)(3)(A)(ii)) — case-asserted";
}
pub relation adjusted_basis_on_purchase_date_36(residence: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the principal residence on the date it is purchased (section 36(c)(4)) — case-asserted";
}
pub relation spouse_of_36(individual: Individual, spouse: Individual) kind empirical {
    label en official "the spouse of the (married) individual (section 7703) — case-asserted";
}
relation is_married_36(individual: Individual) kind institutional;
rule IsMarried36Rule(individual: Individual, spouse: Individual) strict {
    when spouse_of_36(individual, spouse);
    then is_married_36(individual);
}

// --- (c)(3)-(4): the purchase, its date and the purchase price -----------------------------------------------------------------

pub relation qualifying_purchase_36(individual: Individual, residence: Asset) kind institutional {
    label en official "section 36(c)(3)(A): an acquisition not from a related person and whose basis is not carried over from the transferor and not determined under section 1014(a)";
}
@source(IRC_S36_C, relation = formalizes, coverage = exact, quote = "The term \"purchase\" means any acquisition, but only if—")
rule QualifyingPurchase36Rule(individual: Individual, residence: Asset) strict {
    when individual_purchases_residence_36(individual, residence);
    when not_known(acquired_from_related_person_36(individual, residence));
    when not_known(basis_from_transferor_or_decedent_36(individual, residence));
    then qualifying_purchase_36(individual, residence);
}
pub relation purchase_date_36(individual: Individual, residence: Asset, on: Date) kind institutional {
    label en official "the date of the purchase: the acquisition date, or for a residence constructed by the taxpayer the date the taxpayer first occupies it (section 36(c)(3)(B))";
}
rule PurchaseDateAcquisition36Rule(individual: Individual, residence: Asset, on: Date) strict {
    when qualifying_purchase_36(individual, residence);
    when acquisition_date_36(individual, residence, on);
    when not_known(residence_constructed_by_taxpayer_36(individual, residence));
    then purchase_date_36(individual, residence, on);
}
@source(IRC_S36_C, relation = formalizes, coverage = exact, quote = "A residence which is constructed by the taxpayer shall be treated as purchased by the taxpayer on the date the taxpayer first occupies such residence.")
rule PurchaseDateConstructed36Rule(individual: Individual, residence: Asset, on: Date) strict {
    when qualifying_purchase_36(individual, residence);
    when residence_constructed_by_taxpayer_36(individual, residence);
    when first_occupancy_date_36(individual, residence, on);
    then purchase_date_36(individual, residence, on);
}
pub relation purchase_price_36(residence: Asset, amount: Money) kind institutional {
    label en official "section 36(c)(4): the purchase price is the adjusted basis of the principal residence on the date it is purchased";
}
@source(IRC_S36_C, relation = formalizes, coverage = exact, quote = "The term \"purchase price\" means the adjusted basis of the principal residence on the date such residence is purchased.")
rule PurchasePrice36Rule(residence: Asset, amount: Money) strict {
    when adjusted_basis_on_purchase_date_36(residence, amount);
    then purchase_price_36(residence, amount);
}

// --- (c)(1), (c)(6): first-time homebuyer ------------------------------------------------------------------------------------------------

pub relation ownership_interest_in_principal_residence_in_3_years_36(person: Individual, purchase_date: Date) kind empirical {
    label en official "the person had a present ownership interest in a principal residence during the 3-year period ending on the date of the purchase (section 36(c)(1)) — case-asserted (the principal residence of section 121 is a case classification)";
}
pub relation owned_and_used_same_residence_5_of_8_years_36(person: Individual, purchase_date: Date) kind empirical {
    label en official "the person has owned and used the same residence as principal residence for any 5-consecutive-year period during the 8-year period ending on the date of the purchase of a subsequent principal residence (section 36(c)(6)) — case-asserted";
}
pub relation first_time_homebuyer_36(individual: Individual, residence: Asset) kind institutional {
    label en official "section 36(c)(1): an individual (and if married, the spouse) with no present ownership interest in a principal residence during the 3-year period ending on the purchase date";
}
@source(IRC_S36_C, relation = formalizes, coverage = exact, quote = "The term \"first-time homebuyer\" means any individual if such individual (and if married, such individual's spouse) had no present ownership interest in a principal residence during the 3-year period ending on the date of the purchase of the principal residence to which this section applies.")
rule FirstTimeHomebuyerUnmarried36Rule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when not_known(ownership_interest_in_principal_residence_in_3_years_36(individual, on));
    when not_known(is_married_36(individual));
    then first_time_homebuyer_36(individual, residence);
}
rule FirstTimeHomebuyerMarried36Rule(individual: Individual, residence: Asset, on: Date, spouse: Individual) strict {
    when purchase_date_36(individual, residence, on);
    when spouse_of_36(individual, spouse);
    when not_known(ownership_interest_in_principal_residence_in_3_years_36(individual, on));
    when not_known(ownership_interest_in_principal_residence_in_3_years_36(spouse, on));
    then first_time_homebuyer_36(individual, residence);
}
pub relation long_time_resident_36(individual: Individual, residence: Asset) kind institutional {
    label en official "section 36(c)(6): an individual (and, if married, the spouse) who owned and used the same residence as principal residence for 5 consecutive years of the 8 years ending on the purchase date of a subsequent principal residence: treated as a first-time homebuyer, and the credit cap is $6,500";
}
@source(IRC_S36_C, relation = formalizes, coverage = exact, quote = "In the case of an individual (and, if married, such individual's spouse) who has owned and used the same residence as such individual's principal residence for any 5-consecutive-year period during the 8-year period ending on the date of the purchase of a subsequent principal residence, such individual shall be treated as a first-time homebuyer for purposes of this section with respect to the purchase of such subsequent residence.")
rule LongTimeResidentUnmarried36Rule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when owned_and_used_same_residence_5_of_8_years_36(individual, on);
    when not_known(is_married_36(individual));
    then long_time_resident_36(individual, residence);
}
rule LongTimeResidentMarried36Rule(individual: Individual, residence: Asset, on: Date, spouse: Individual) strict {
    when purchase_date_36(individual, residence, on);
    when spouse_of_36(individual, spouse);
    when owned_and_used_same_residence_5_of_8_years_36(individual, on);
    when owned_and_used_same_residence_5_of_8_years_36(spouse, on);
    then long_time_resident_36(individual, residence);
}
pub relation treated_as_first_time_homebuyer_36(individual: Individual, residence: Asset) kind institutional {
    label en official "first-time homebuyer under (c)(1) or treated as one under (c)(6)";
}
rule TreatedAsFirstTimeHomebuyerFirstTimeRule(individual: Individual, residence: Asset) strict {
    when first_time_homebuyer_36(individual, residence);
    then treated_as_first_time_homebuyer_36(individual, residence);
}
rule TreatedAsFirstTimeHomebuyerLongTimeRule(individual: Individual, residence: Asset) strict {
    when long_time_resident_36(individual, residence);
    then treated_as_first_time_homebuyer_36(individual, residence);
}

// --- (h): the window of the credit; (g): the election to treat the purchase as made in the preceding year -----------------------------

pub relation binding_contract_before_may_2010_closing_before_july_2010_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the taxpayer entered into a written binding contract before May 1, 2010, to close on the purchase before July 1, 2010 (section 36(h)(2)) — case-asserted";
}
pub relation serves_qualified_official_extended_duty_abroad_90_days_36(person: Individual) kind empirical {
    label en official "the person serves on qualified official extended duty service (section 121(d)(9)(C)(i)) outside the United States for at least 90 days during the period beginning after December 31, 2008 and ending before May 1, 2010 (section 36(h)(3)) — case-asserted";
}
pub relation binding_contract_before_may_2011_closing_before_july_2011_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the written binding contract of section 36(h)(2) with the dates of subsection (h)(3)(A)-(B) substituted (before May 1, 2011; closing before July 1, 2011) — case-asserted";
}
pub relation covered_by_military_extension_36(individual: Individual) kind institutional {
    label en official "section 36(h)(3): the individual serving on qualified official extended duty abroad, or the spouse of such an individual";
}
rule CoveredByMilitaryExtensionSelf36Rule(individual: Individual) strict {
    when serves_qualified_official_extended_duty_abroad_90_days_36(individual);
    then covered_by_military_extension_36(individual);
}
rule CoveredByMilitaryExtensionSpouse36Rule(individual: Individual, spouse: Individual) strict {
    when spouse_of_36(individual, spouse);
    when serves_qualified_official_extended_duty_abroad_90_days_36(spouse);
    then covered_by_military_extension_36(individual);
}
pub relation purchase_within_credit_window_36(individual: Individual, residence: Asset) kind institutional {
    label en official "section 36(h): a principal residence purchased on or after April 9, 2008, and before May 1, 2010 (October 1, 2010 under a binding contract; May 1, 2011 (October 1, 2011) for covered military personnel)";
}
@source(IRC_S36_H, relation = formalizes, coverage = exact, quote = "This section shall only apply to a principal residence purchased by the taxpayer on or after April 9, 2008, and before May 1, 2010.")
rule PurchaseWithinCreditWindowBaseRule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when on >= @2008-04-09;
    when on < @2010-05-01;
    then purchase_within_credit_window_36(individual, residence);
}
@source(IRC_S36_H, relation = formalizes, coverage = exact, quote = "In the case of any taxpayer who enters into a written binding contract before May 1, 2010, to close on the purchase of a principal residence before July 1, 2010, and who purchases such residence before October 1, 2010, paragraph (1) shall be applied by substituting \"October 1, 2010\" for \"May 1, 2010\".")
rule PurchaseWithinCreditWindowBindingContractRule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when binding_contract_before_may_2010_closing_before_july_2010_36(individual, residence);
    when on >= @2008-04-09;
    when on < @2010-10-01;
    then purchase_within_credit_window_36(individual, residence);
}
@source(IRC_S36_H, relation = formalizes, coverage = exact, quote = "(A) paragraphs (1) and (2) shall each be applied by substituting \"May 1, 2011\" for \"May 1, 2010\", and")
rule PurchaseWithinCreditWindowMilitaryRule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when covered_by_military_extension_36(individual);
    when on >= @2008-04-09;
    when on < @2011-05-01;
    then purchase_within_credit_window_36(individual, residence);
}
@source(IRC_S36_H, relation = formalizes, coverage = exact, quote = "(B) paragraph (2) shall be applied by substituting \"July 1, 2011\" for \"July 1, 2010\", and for \"October 1, 2010\".")
rule PurchaseWithinCreditWindowMilitaryContractRule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when covered_by_military_extension_36(individual);
    when binding_contract_before_may_2011_closing_before_july_2011_36(individual, residence);
    when on >= @2008-04-09;
    when on < @2011-10-01;
    then purchase_within_credit_window_36(individual, residence);
}

pub relation elects_to_treat_purchase_as_made_in_prior_year_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 36(g) election to treat the purchase as made on December 31 of the calendar year preceding the purchase";
}
pub relation purchase_treated_as_made_in_prior_year_36(individual: Individual, residence: Asset) kind institutional {
    label en official "section 36(g): the purchase (after December 31, 2008) is treated as made on December 31 of the preceding calendar year (a valid election)";
}
@source(IRC_S36_G, relation = formalizes, coverage = exact, quote = "In the case of a purchase of a principal residence after December 31, 2008, a taxpayer may elect to treat such purchase as made on December 31 of the calendar year preceding such purchase for purposes of this section (other than subsections (b)(4), (c), (f)(4)(D), and (h)).")
rule Section36GElectionRule(individual: Individual, residence: Asset, on: Date) defeasible {
    when purchase_date_36(individual, residence, on);
    when on > @2008-12-31;
    then power Section36GElection {
        holder individual;
        over residence;
        exercise elects_to_treat_purchase_as_made_in_prior_year_36(individual, residence);
        valid_when purchase_within_credit_window_36(individual, residence);
        effect create(purchase_treated_as_made_in_prior_year_36(individual, residence));
        window [@2008-12-31, @2011-10-01];
    };
}
pub relation credit_year_36(individual: Individual, residence: Asset, y: TaxableYear) kind institutional {
    label en official "the taxable year for which the credit is allowed: the year containing the purchase date, or containing the preceding December 31 if the section 36(g) election is made";
}
rule CreditYearPurchaseDateRule(individual: Individual, residence: Asset, y: TaxableYear, on: Date, begin: Date, finish: Date) strict {
    when purchase_date_36(individual, residence, on);
    when not_known(elects_to_treat_purchase_as_made_in_prior_year_36(individual, residence));
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when begin <= on;
    when on <= finish;
    then credit_year_36(individual, residence, y);
}
// The election reads the raw exercise fact (a power effect is invisible to a same-round reader). The preceding
// December 31 is the day before the first day of the calendar year of the purchase (a calendar helper fact).
pub relation begin_of_year_of_purchase_36(residence: Asset, first_day: Date) kind empirical {
    label en official "the first day (January 1) of the calendar year in which the residence is purchased — calendar helper fact for the section 36(g) election";
}
rule CreditYearElectionRule(individual: Individual, residence: Asset, y: TaxableYear, first_day: Date, prior_end: Date) strict {
    when purchase_within_credit_window_36(individual, residence);
    when elects_to_treat_purchase_as_made_in_prior_year_36(individual, residence);
    when begin_of_year_of_purchase_36(residence, first_day);
    when us.irc.core::ends(y, prior_end);
    when add_calendar_period(prior_end, 1 calendar_day) == first_day;
    then credit_year_36(individual, residence, y);
}

// --- (d): no credit ----------------------------------------------------------------------------------------------------------------------

pub relation nonresident_alien_36(individual: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer is a nonresident alien (section 36(d)(1)) — case-asserted";
}
pub relation disposed_of_residence_or_ceased_principal_residence_before_close_of_year_36(individual: Individual, residence: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer disposes of the residence (or it ceases to be the principal residence of the taxpayer and spouse) before the close of the taxable year (section 36(d)(2)) — case-asserted";
}
pub relation deduction_under_151_allowable_to_another_36(individual: Individual, y: TaxableYear) kind empirical {
    label en official "a deduction under section 151 with respect to the taxpayer is allowable to another taxpayer for the year (section 36(d)(3)) — case-asserted";
}
pub relation settlement_statement_attached_to_return_36(individual: Individual, residence: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer attaches to the return a properly executed copy of the settlement statement used to complete the purchase (section 36(d)(4)) — case-asserted";
}
pub relation age_on_purchase_date_36(individual: Individual, years: Decimal) kind empirical {
    label en official "the age in years of the individual on the date of the purchase (section 36(b)(4)) — case-asserted";
}
pub relation credit_allowed_by_d_and_b4_36(individual: Individual, residence: Asset, y: TaxableYear) kind institutional {
    label en official "sections 36(b)(3)-(4), (d): none of the disallowing conditions applies: price not above $800,000, the taxpayer (or spouse) is 18, not a nonresident alien, did not dispose of the residence in the year, not a dependent of another, settlement statement attached";
}
@source(IRC_S36_D, relation = formalizes, coverage = exact, quote = "No credit under subsection (a) shall be allowed to any taxpayer for any taxable year with respect to the purchase of a residence if—")
rule CreditAllowedByDAndB4UnmarriedRule(individual: Individual, residence: Asset, y: TaxableYear, price: Money, age: Decimal) strict {
    when credit_year_36(individual, residence, y);
    when purchase_price_36(residence, price);
    when price <= 800000.00 USD;
    when age_on_purchase_date_36(individual, age);
    when age >= 18.0;
    when not_known(is_married_36(individual));
    when not_known(nonresident_alien_36(individual, y));
    when not_known(disposed_of_residence_or_ceased_principal_residence_before_close_of_year_36(individual, residence, y));
    when not_known(deduction_under_151_allowable_to_another_36(individual, y));
    when settlement_statement_attached_to_return_36(individual, residence, y);
    then credit_allowed_by_d_and_b4_36(individual, residence, y);
}
rule CreditAllowedByDAndB4MarriedRule(individual: Individual, residence: Asset, y: TaxableYear, price: Money, age: Decimal, spouse: Individual, spouse_age: Decimal) strict {
    when credit_year_36(individual, residence, y);
    when purchase_price_36(residence, price);
    when price <= 800000.00 USD;
    when spouse_of_36(individual, spouse);
    when age_on_purchase_date_36(individual, age);
    when age_on_purchase_date_36(spouse, spouse_age);
    when max(age, spouse_age) >= 18.0;
    when not_known(nonresident_alien_36(individual, y));
    when not_known(disposed_of_residence_or_ceased_principal_residence_before_close_of_year_36(individual, residence, y));
    when not_known(deduction_under_151_allowable_to_another_36(individual, y));
    when settlement_statement_attached_to_return_36(individual, residence, y);
    then credit_allowed_by_d_and_b4_36(individual, residence, y);
}

// --- (b)(1)-(2): the dollar limit and the phase-out -----------------------------------------------------------------------------------------

pub relation files_separate_return_36(individual: Individual, y: TaxableYear) kind empirical {
    label en official "the married individual files a separate return for the year (section 36(b)(1)(B)) — case-asserted";
}
pub relation coowner_credit_allocated_36(individual: Individual, residence: Asset, amount: Money) kind empirical {
    label en official "the part of the credit allocated to the unmarried co-purchaser in the manner the Secretary prescribes (section 36(b)(1)(C)) — case-asserted";
}
pub relation unmarried_coowners_36(residence: Asset) kind empirical {
    label en official "two or more individuals who are not married purchase the principal residence (section 36(b)(1)(C)) — case-asserted";
}
relation dollar_limit_36(individual: Individual, residence: Asset, limit: Money) kind institutional;
@source(IRC_S36_B, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this paragraph, the credit allowed under subsection (a) shall not exceed $8,000.")
rule DollarLimitGeneralRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when credit_year_36(individual, residence, y);
    when not_known(files_separate_return_36(individual, y));
    when not_known(long_time_resident_36(individual, residence));
    then dollar_limit_36(individual, residence, 8000.00 USD);
}
@source(IRC_S36_B, relation = formalizes, coverage = exact, quote = "In the case of a married individual filing a separate return, subparagraph (A) shall be applied by substituting \"$4,000\" for \"$8,000\".")
rule DollarLimitSeparateReturnRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when credit_year_36(individual, residence, y);
    when files_separate_return_36(individual, y);
    when not_known(long_time_resident_36(individual, residence));
    then dollar_limit_36(individual, residence, 4000.00 USD);
}
@source(IRC_S36_B, relation = formalizes, coverage = exact, quote = "In the case of a taxpayer to whom a credit under subsection (a) is allowed by reason of subsection (c)(6), subparagraphs (A), (B), and (C) shall be applied by substituting \"$6,500\" for \"$8,000\" and \"$3,250\" for \"$4,000\".")
rule DollarLimitLongTimeResidentRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when credit_year_36(individual, residence, y);
    when long_time_resident_36(individual, residence);
    when not_known(files_separate_return_36(individual, y));
    then dollar_limit_36(individual, residence, 6500.00 USD);
}
rule DollarLimitLongTimeResidentSeparateReturnRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when credit_year_36(individual, residence, y);
    when long_time_resident_36(individual, residence);
    when files_separate_return_36(individual, y);
    then dollar_limit_36(individual, residence, 3250.00 USD);
}
pub relation coowner_allocations_total_36(residence: Asset, total: Money) kind institutional {
    label en official "the total of the credits allocated to the unmarried co-purchasers of the residence";
}
rule CoownerAllocationsTotalRule(residence: Asset, one: Individual, amount: Money) strict {
    when unmarried_coowners_36(residence);
    when coowner_credit_allocated_36(one, residence, amount);
    then coowner_allocations_total_36(residence, sum(collect all a: Money, p: Individual where coowner_credit_allocated_36(p, residence, a), empty: 0 USD));
}
pub relation coowner_allocation_within_cap_36(residence: Asset) kind institutional {
    label en official "section 36(b)(1)(C): the total of the credits allowed to all the unmarried co-purchasers does not exceed $8,000 ($6,500 in the (c)(6) case)";
}
@source(IRC_S36_B, relation = formalizes, coverage = exact, quote = "If two or more individuals who are not married purchase a principal residence, the amount of the credit allowed under subsection (a) shall be allocated among such individuals in such manner as the Secretary may prescribe, except that the total amount of the credits allowed to all such individuals shall not exceed $8,000.")
rule CoownerAllocationWithinCapRule(residence: Asset, total: Money) strict {
    when coowner_allocations_total_36(residence, total);
    when total <= 8000.00 USD;
    then coowner_allocation_within_cap_36(residence);
}
pub relation credit_before_phaseout_36(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 36(a), (b)(1): 10 percent of the purchase price, not above the dollar limit (for unmarried co-purchasers, not above the Secretary's allocation)";
}
@source(IRC_S36_A, relation = formalizes, coverage = exact, quote = "there shall be allowed as a credit against the tax imposed by this subtitle for such taxable year an amount equal to 10 percent of the purchase price of the residence.")
rule CreditBeforePhaseoutRule(individual: Individual, residence: Asset, y: TaxableYear, price: Money, limit: Money) strict {
    when credit_allowed_by_d_and_b4_36(individual, residence, y);
    when treated_as_first_time_homebuyer_36(individual, residence);
    when purchase_within_credit_window_36(individual, residence);
    when purchase_price_36(residence, price);
    when dollar_limit_36(individual, residence, limit);
    when not_known(unmarried_coowners_36(residence));
    then credit_before_phaseout_36(individual, residence, y, min(round(0.10 * price, 2, "HALF_UP"), limit));
}
rule CreditBeforePhaseoutCoownerRule(individual: Individual, residence: Asset, y: TaxableYear, price: Money, limit: Money, allocated: Money) strict {
    when credit_allowed_by_d_and_b4_36(individual, residence, y);
    when treated_as_first_time_homebuyer_36(individual, residence);
    when purchase_within_credit_window_36(individual, residence);
    when purchase_price_36(residence, price);
    when dollar_limit_36(individual, residence, limit);
    when unmarried_coowners_36(residence);
    when coowner_allocation_within_cap_36(residence);
    when coowner_credit_allocated_36(individual, residence, allocated);
    then credit_before_phaseout_36(individual, residence, y, min(round(0.10 * price, 2, "HALF_UP"), min(limit, allocated)));
}

pub relation magi_addbacks_36(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amounts excluded from gross income under section 911, 931 or 933 (section 36(b)(2)(B)) — case-asserted";
}
pub relation modified_agi_36(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 36(b)(2)(B): adjusted gross income increased by any amount excluded from gross income under section 911, 931 or 933";
}
@source(IRC_S36_B, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"modified adjusted gross income\" means the adjusted gross income of the taxpayer for the taxable year increased by any amount excluded from gross income under section 911, 931, or 933.")
rule ModifiedAgi36Rule(individual: Individual, y: TaxableYear, agi: Money, addbacks: Money) strict {
    when us.irc.gross_income::adjusted_gross_income(individual, y, agi);
    when magi_addbacks_36(individual, y, addbacks);
    then modified_agi_36(individual, y, agi + addbacks);
}
relation phaseout_threshold_36(status: us.irc.income_individual::FilingStatus, amount: Money) kind institutional;
@source(IRC_S36_B, relation = formalizes, coverage = exact, quote = "$125,000 ($225,000 in the case of a joint return)")
assert "36-threshold-joint": phaseout_threshold_36(us.irc.income_individual::Joint, 225000.00 USD);
assert "36-threshold-hoh": phaseout_threshold_36(us.irc.income_individual::HeadOfHousehold, 125000.00 USD);
assert "36-threshold-unmarried": phaseout_threshold_36(us.irc.income_individual::Unmarried, 125000.00 USD);
assert "36-threshold-mfs": phaseout_threshold_36(us.irc.income_individual::MarriedSeparate, 125000.00 USD);
assert "36-threshold-estate": phaseout_threshold_36(us.irc.income_individual::EstateOrTrust, 125000.00 USD);
pub relation first_time_homebuyer_credit_36(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 36 first-time homebuyer credit for the taxable year, after the (b)(2) phase-out: the credit is reduced (not below zero) by the ratio of the excess of modified adjusted gross income over the threshold to $20,000";
}
@source(IRC_S36_B, relation = formalizes, coverage = exact, quote = "The amount allowable as a credit under subsection (a) (determined without regard to this paragraph) for the taxable year shall be reduced (but not below zero) by the amount which bears the same ratio to the amount which is so allowable as—")
rule FirstTimeHomebuyerCreditAboveThresholdRule(individual: Individual, residence: Asset, y: TaxableYear, credit: Money, magi: Money, status: us.irc.income_individual::FilingStatus, threshold: Money) strict {
    when credit_before_phaseout_36(individual, residence, y, credit);
    when modified_agi_36(individual, y, magi);
    when us.irc.income_individual::filing_status(individual, y, status);
    when phaseout_threshold_36(status, threshold);
    when magi > threshold;
    // JUDGMENT CALL: cents HALF_UP; the ratio is (MAGI - threshold) / 20,000; the credit is not reduced below zero.
    then first_time_homebuyer_credit_36(individual, residence, y,
        max(credit - div_round(credit * ((magi - threshold) / 1.00 USD), 20000.0, 2, "HALF_UP"), 0 USD));
}
rule FirstTimeHomebuyerCreditAtOrBelowThresholdRule(individual: Individual, residence: Asset, y: TaxableYear, credit: Money, magi: Money, status: us.irc.income_individual::FilingStatus, threshold: Money) strict {
    when credit_before_phaseout_36(individual, residence, y, credit);
    when modified_agi_36(individual, y, magi);
    when us.irc.income_individual::filing_status(individual, y, status);
    when phaseout_threshold_36(status, threshold);
    when magi <= threshold;
    then first_time_homebuyer_credit_36(individual, residence, y, credit);
}

// --- (f): recapture ----------------------------------------------------------------------------------------------------------------------------

pub relation recapture_period_year_36(individual: Individual, residence: Asset, y: TaxableYear) kind institutional {
    label en official "section 36(f)(7): the recapture period is the 15 taxable years beginning with the second taxable year following the taxable year of the purchase";
}
@source(IRC_S36_F, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"recapture period\" means the 15 taxable years beginning with the second taxable year following the taxable year in which the purchase of the principal residence for which a credit is allowed under subsection (a) was made.")
rule RecapturePeriodYear36Rule(individual: Individual, residence: Asset, y: TaxableYear, y0: TaxableYear, begin0: Date, begin: Date) strict {
    when credit_year_36(individual, residence, y0);
    when us.irc.core::begins(y0, begin0);
    when us.irc.core::begins(y, begin);
    when begin >= add_calendar_period(begin0, 24 calendar_month);
    when begin < add_calendar_period(begin0, 204 calendar_month);
    then recapture_period_year_36(individual, residence, y);
}
pub relation year_ends_after_death_36(individual: Individual, y: TaxableYear) kind institutional {
    label en official "the taxable year ends after the date of the taxpayer's death (section 36(f)(4)(A))";
}
pub relation date_of_death_36(individual: Individual, on: Date) kind empirical {
    label en official "the date of the taxpayer's death — case-asserted";
}
rule YearEndsAfterDeath36Rule(individual: Individual, y: TaxableYear, death: Date, finish: Date) strict {
    when date_of_death_36(individual, death);
    when us.irc.core::ends(y, finish);
    when finish > death;
    then year_ends_after_death_36(individual, y);
}
pub relation joint_return_credit_36(individual: Individual, residence: Asset, y: TaxableYear) kind empirical {
    label en official "the credit was allowed with respect to a joint return (section 36(f)(5)) — case-asserted";
}
pub relation credit_allowed_amount_36(individual: Individual, residence: Asset, amount: Money) kind empirical {
    label en official "the amount of the credit allowed under subsection (a) with respect to the residence (for recapture) — case-asserted from the credit year";
}
pub relation recapture_base_credit_36(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 36(f)(5): with respect to a joint return, half of the credit is treated as allowed to each individual filing it";
}
rule RecaptureBaseCreditJointRule(individual: Individual, residence: Asset, y: TaxableYear, credit: Money, y0: TaxableYear) strict {
    when credit_allowed_amount_36(individual, residence, credit);
    when credit_year_36(individual, residence, y0);
    when joint_return_credit_36(individual, residence, y0);
    when recapture_period_year_36(individual, residence, y);
    then recapture_base_credit_36(individual, residence, y, div_round(credit, 2.0, 2, "HALF_UP"));
}
rule RecaptureBaseCreditSeparateRule(individual: Individual, residence: Asset, y: TaxableYear, credit: Money, y0: TaxableYear) strict {
    when credit_allowed_amount_36(individual, residence, credit);
    when credit_year_36(individual, residence, y0);
    when not_known(joint_return_credit_36(individual, residence, y0));
    when recapture_period_year_36(individual, residence, y);
    then recapture_base_credit_36(individual, residence, y, credit);
}
pub relation purchase_date_after_2008_36(individual: Individual, residence: Asset) kind institutional {
    label en official "section 36(f)(4)(D): the credit is allowed with respect to a purchase of a principal residence after December 31, 2008";
}
rule PurchaseDateAfter2008Rule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when on > @2008-12-31;
    then purchase_date_after_2008_36(individual, residence);
}
pub relation transfer_incident_to_divorce_1041_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the residence is transferred in a transfer to which section 1041(a) applies (section 36(f)(4)(C)) — case-asserted";
}
pub relation compulsory_conversion_with_new_residence_within_2_years_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the residence is compulsorily or involuntarily converted (section 1033(a)) and the taxpayer acquires a new principal residence within the 2 years beginning on the date of the disposition or cessation (section 36(f)(4)(B)) — case-asserted";
}
pub relation disposition_for_qualified_official_extended_duty_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the disposition (or cessation) after December 31, 2008 is in connection with Government orders received for qualified official extended duty service (section 36(f)(4)(E)) — case-asserted";
}
pub relation residence_acquired_before_2009_36(individual: Individual, residence: Asset) kind institutional {
    label en official "the residence was acquired before January 1, 2009 (section 36(f)(4)(E)(i)(II))";
}
rule ResidenceAcquiredBefore2009Rule(individual: Individual, residence: Asset, on: Date) strict {
    when purchase_date_36(individual, residence, on);
    when on < @2009-01-01;
    then residence_acquired_before_2009_36(individual, residence);
}
pub relation disposition_year_36(individual: Individual, residence: Asset, y: TaxableYear) kind empirical {
    label en official "the taxable year of the disposition of the residence or of its ceasing to be the principal residence (section 36(f)(2)) — case-asserted";
}
pub relation disposition_date_36(individual: Individual, residence: Asset, on: Date) kind empirical {
    label en official "the date of the disposition of the residence or of its ceasing to be the principal residence — case-asserted";
}
relation annual_recapture_excepted_36(individual: Individual, residence: Asset, y: TaxableYear) kind institutional;
rule AnnualRecaptureExceptedDeathRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when year_ends_after_death_36(individual, y);
    when recapture_period_year_36(individual, residence, y);
    then annual_recapture_excepted_36(individual, residence, y);
}
rule AnnualRecaptureExceptedMilitaryRule(individual: Individual, residence: Asset, y: TaxableYear, y0: TaxableYear, begin0: Date, begin: Date) strict {
    when disposition_for_qualified_official_extended_duty_36(individual, residence);
    when residence_acquired_before_2009_36(individual, residence);
    when disposition_year_36(individual, residence, y0);
    when us.irc.core::begins(y0, begin0);
    when us.irc.core::begins(y, begin);
    when begin >= begin0;
    when recapture_period_year_36(individual, residence, y);
    then annual_recapture_excepted_36(individual, residence, y);
}
pub relation annual_recapture_36(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 36(f)(1): the tax is increased by 6 2/3 percent (1/15) of the credit for each taxable year in the recapture period (credits for purchases before 2009 only, (f)(4)(D)(i))";
}
@source(IRC_S36_F, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this subsection, if a credit under subsection (a) is allowed to a taxpayer, the tax imposed by this chapter shall be increased by 62/3 percent of the amount of such credit for each taxable year in the recapture period.")
rule AnnualRecapture36Rule(individual: Individual, residence: Asset, y: TaxableYear, base: Money) defeasible {
    when recapture_base_credit_36(individual, residence, y, base);
    when not_known(purchase_date_after_2008_36(individual, residence));
    then annual_recapture_36(individual, residence, y, div_round(base, 15.0, 2, "HALF_UP"));
    unless annual_recapture_excepted_36(individual, residence, y)
        and recapture_base_credit_36(individual, residence, y, base);
}
pub relation full_recapture_years_elapsed_36(individual: Individual, residence: Asset, years: Decimal) kind empirical {
    label en official "the number of taxable years of the recapture period for which the (f)(1) increase was already imposed before the disposition year — case-asserted";
}
pub relation amount_realized_on_sale_36(individual: Individual, residence: Asset, amount: Money) kind empirical {
    label en official "the amount realized on the sale of the principal residence to a person not related to the taxpayer (section 36(f)(3)) — case-asserted";
}
pub relation adjusted_basis_at_sale_36(individual: Individual, residence: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the residence at the sale, before the section 36(f)(3) reduction — case-asserted";
}
pub relation sale_to_unrelated_person_36(individual: Individual, residence: Asset) kind empirical {
    label en official "the residence is sold to a person who is not related to the taxpayer (section 36(f)(3)) — case-asserted";
}
relation disposition_recapture_excepted_36(individual: Individual, residence: Asset, y: TaxableYear) kind institutional;
rule DispositionRecaptureExceptedConversionRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when compulsory_conversion_with_new_residence_within_2_years_36(individual, residence);
    when disposition_year_36(individual, residence, y);
    then disposition_recapture_excepted_36(individual, residence, y);
}
rule DispositionRecaptureExceptedDivorceRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when transfer_incident_to_divorce_1041_36(individual, residence);
    when disposition_year_36(individual, residence, y);
    then disposition_recapture_excepted_36(individual, residence, y);
}
rule DispositionRecaptureExceptedDeathRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when year_ends_after_death_36(individual, y);
    when disposition_year_36(individual, residence, y);
    then disposition_recapture_excepted_36(individual, residence, y);
}
rule DispositionRecaptureExceptedMilitaryRule(individual: Individual, residence: Asset, y: TaxableYear) strict {
    when disposition_for_qualified_official_extended_duty_36(individual, residence);
    when disposition_year_36(individual, residence, y);
    then disposition_recapture_excepted_36(individual, residence, y);
}
pub relation disposition_recapture_before_gain_limit_36(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 36(f)(2)(A): on a disposition (or cessation) before the end of the recapture period the tax for the year is increased by the credit allowed less the amounts imposed by paragraph (1) for preceding years";
}
@source(IRC_S36_F, relation = formalizes, coverage = exact, quote = "(A) the tax imposed by this chapter for the taxable year of such disposition or cessation shall be increased by the excess of the amount of the credit allowed over the amounts of tax imposed by paragraph (1) for preceding taxable years, and")
rule DispositionRecaptureBeforeGainLimitBefore2009Rule(individual: Individual, residence: Asset, y: TaxableYear, base: Money, years: Decimal) defeasible {
    when disposition_year_36(individual, residence, y);
    when recapture_period_year_36(individual, residence, y);
    when recapture_base_credit_36(individual, residence, y, base);
    when full_recapture_years_elapsed_36(individual, residence, years);
    when not_known(purchase_date_after_2008_36(individual, residence));
    then disposition_recapture_before_gain_limit_36(individual, residence, y, base - div_round(base * years, 15.0, 2, "HALF_UP"));
    unless disposition_recapture_excepted_36(individual, residence, y)
        and recapture_base_credit_36(individual, residence, y, base)
        and full_recapture_years_elapsed_36(individual, residence, years);
}
@source(IRC_S36_F, relation = formalizes, coverage = exact, quote = "(ii) paragraph (2) shall apply only if the disposition or cessation described in paragraph (2) with respect to such residence occurs during the 36-month period beginning on the date of the purchase of such residence by the taxpayer.")
rule DispositionRecaptureAfter2008Rule(individual: Individual, residence: Asset, y: TaxableYear, base: Money, bought: Date, disposed: Date) defeasible {
    when disposition_year_36(individual, residence, y);
    when recapture_period_year_36(individual, residence, y);
    when recapture_base_credit_36(individual, residence, y, base);
    when purchase_date_36(individual, residence, bought);
    when purchase_date_after_2008_36(individual, residence);
    when disposition_date_36(individual, residence, disposed);
    when disposed >= bought;
    when disposed <= add_calendar_period(bought, 36 calendar_month);
    then disposition_recapture_before_gain_limit_36(individual, residence, y, base);
    unless disposition_recapture_excepted_36(individual, residence, y)
        and recapture_base_credit_36(individual, residence, y, base);
}
pub relation disposition_recapture_36(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 36(f)(2)-(3): the increase in tax on a disposition, limited on a sale to an unrelated person to the gain (the adjusted basis reduced by the credit not previously recaptured)";
}
rule DispositionRecaptureNoGainLimitRule(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) defeasible {
    when disposition_recapture_before_gain_limit_36(individual, residence, y, amount);
    when not_known(sale_to_unrelated_person_36(individual, residence));
    then disposition_recapture_36(individual, residence, y, amount);
}
@source(IRC_S36_F, relation = formalizes, coverage = exact, quote = "In the case of the sale of the principal residence to a person who is not related to the taxpayer, the increase in tax determined under paragraph (2) shall not exceed the amount of gain (if any) on such sale.")
rule DispositionRecaptureGainLimitRule(individual: Individual, residence: Asset, y: TaxableYear, amount: Money, realized: Money, basis: Money, credit: Money, elapsed: Decimal) defeasible {
    when disposition_recapture_before_gain_limit_36(individual, residence, y, amount);
    when sale_to_unrelated_person_36(individual, residence);
    when amount_realized_on_sale_36(individual, residence, realized);
    when adjusted_basis_at_sale_36(individual, residence, basis);
    when credit_allowed_amount_36(individual, residence, credit);
    when full_recapture_years_elapsed_36(individual, residence, elapsed);
    // gain = amount realized - (adjusted basis reduced by the credit not previously recaptured), not below zero.
    then disposition_recapture_36(individual, residence, y,
        min(amount, max(realized - (basis - (credit - div_round(credit * elapsed, 15.0, 2, "HALF_UP"))), 0 USD)));
}
pub relation return_filed_for_recapture_year_36(individual: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer files a return with respect to the taxes imposed under subtitle A for the year — case-asserted";
}
@source(IRC_S36_F, relation = formalizes, coverage = exact, quote = "If the tax imposed by this chapter for the taxable year is increased under this subsection, the taxpayer shall, notwithstanding section 6012, be required to file a return with respect to the taxes imposed under this subtitle.")
rule Section36F6ReturnDutyRule(individual: Individual, residence: Asset, y: TaxableYear, amount: Money) strict {
    when disposition_recapture_36(individual, residence, y, amount);
    then duty Section36F6ReturnDuty {
        bearer individual;
        goal achievement {
            condition return_filed_for_recapture_year_36(individual, y);
            window [-infinity, infinity];
        }
    };
}
pub relation transfer_date_1041_36(individual: Individual, residence: Asset, transferee: Individual, on: Date) kind empirical {
    label en official "the date of the section 1041(a) transfer of the residence to the transferee (section 36(f)(4)(C)) — case-asserted";
}
pub relation recapture_bearer_36(residence: Asset, person: Individual, y: TaxableYear) kind institutional {
    label en official "section 36(f)(4)(C)(ii): for taxable years ending after a section 1041(a) transfer, paragraphs (1) and (2) apply to the transferee as if the transferee were the transferor (and not to the transferor)";
}
rule RecaptureBearerTransfereeRule(residence: Asset, transferor: Individual, transferee: Individual, y: TaxableYear, moved: Date, finish: Date) strict {
    when transfer_date_1041_36(transferor, residence, transferee, moved);
    when transfer_incident_to_divorce_1041_36(transferor, residence);
    when us.irc.core::ends(y, finish);
    when finish > moved;
    when recapture_period_year_36(transferor, residence, y);
    then recapture_bearer_36(residence, transferee, y);
}
rule RecaptureBearerTransferorRule(residence: Asset, transferor: Individual, transferee: Individual, y: TaxableYear, moved: Date, finish: Date) strict {
    when transfer_date_1041_36(transferor, residence, transferee, moved);
    when transfer_incident_to_divorce_1041_36(transferor, residence);
    when us.irc.core::ends(y, finish);
    when finish <= moved;
    when recapture_period_year_36(transferor, residence, y);
    then recapture_bearer_36(residence, transferor, y);
}
