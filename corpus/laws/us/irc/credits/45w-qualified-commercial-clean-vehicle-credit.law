// Section 45W — Credit for qualified commercial clean vehicles. Stage 2d
// (IRC-06, DECISION-0379).
//
// Editions by `legal_time`: the 2024 text ends the credit for vehicles
// acquired after 2032-12-31; PL 119-21 section 70503
// (`us.irc.temporal::PL119_21_S70503`, enacted 2025-07-04) moves the end to
// 2025-09-30. Two rules with `effective` windows carry the two texts.
//
// Scope / judgment calls:
// * (b): the lesser of 15 percent of the vehicle basis (30 percent for a
//   vehicle not powered by a gasoline or diesel internal combustion engine)
//   and the incremental cost (purchase price less the comparable vehicle
//   price), capped at $7,500 (gross vehicle weight rating under 14,000 pounds)
//   or $40,000.
// * (c): a qualified commercial clean vehicle meets the requirements derived
//   from case facts: the section 30D(d)(1)(C) test and not for resale; a
//   road vehicle under section 30D(d)(1)(D) or mobile machinery; a
//   propulsion test (electric with a 15 kWh battery, 7 kWh under 14,000 pounds,
//   or a fuel cell vehicle under section 30B(b)(3)); depreciable (waived for an
//   unleased vehicle placed in service by a tax-exempt entity, (d)(2)).
// * (d)(3): no credit if a section 30D credit was allowed; (e): the vehicle
//   identification number must be on the return.
// * The cross-referenced tests are case facts (TECH-GAPS G1547).

use self::{
    Asset,
    IRC_S45W_A,
    IRC_S45W_B,
    IRC_S45W_C,
    IRC_S45W_D,
    IRC_S45W_G,
    Person,
    TaxableYear,
    credit_denied_by_30df_rules_45w,
};

pub relation vehicle_basis_45w(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the basis of the qualified commercial clean vehicle placed in service by the taxpayer during the taxable year (section 45W(b)(1)(A)) — case-asserted";
}
pub relation vehicle_purchase_price_45w(vehicle: Asset, price: Money) kind empirical {
    label en official "the purchase price of the vehicle (section 45W(b)(2)) — case-asserted";
}
pub relation comparable_vehicle_price_45w(vehicle: Asset, price: Money) kind empirical {
    label en official "the price of a comparable vehicle powered solely by a gasoline or diesel internal combustion engine and comparable in size and use (section 45W(b)(2), (b)(3)) — case-asserted";
}
pub relation vehicle_gvwr_pounds_45w(vehicle: Asset, pounds: Decimal) kind empirical {
    label en official "the gross vehicle weight rating of the vehicle, in pounds — case-asserted";
}
pub relation vehicle_powered_by_internal_combustion_engine_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is powered by a gasoline or diesel internal combustion engine (section 45W(b)(1)(A)) — case-asserted";
}
pub relation vehicle_acquired_on_45w(vehicle: Asset, on: Date) kind empirical {
    label en official "the date the vehicle is acquired — case-asserted";
}
pub relation meets_30d_d1c_and_not_for_resale_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle meets section 30D(d)(1)(C) and is acquired for use or lease by the taxpayer and not for resale (section 45W(c)(1)) — case-asserted";
}
pub relation road_vehicle_under_30d_d1d_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle meets section 30D(d)(1)(D) and is manufactured primarily for use on public streets, roads, and highways (section 45W(c)(2)(A)) — case-asserted";
}
pub relation mobile_machinery_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is mobile machinery as defined in section 4053(8) (section 45W(c)(2)(B)) — case-asserted";
}
pub relation vehicle_battery_kwh_45w(vehicle: Asset, kwh: Decimal) kind empirical {
    label en official "the capacity of the vehicle's battery, in kilowatt hours, for a vehicle propelled to a significant extent by an electric motor drawing from the battery and rechargeable from an external source (section 45W(c)(3)(A)) — case-asserted";
}
pub relation fuel_cell_vehicle_meeting_30b_b3_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is a motor vehicle satisfying the requirements under subparagraphs (A) and (B) of section 30B(b)(3) (section 45W(c)(3)(B)) — case-asserted";
}
pub relation subject_to_depreciation_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is of a character subject to the allowance for depreciation (section 45W(c)(4)) — case-asserted";
}
pub relation unleased_vehicle_placed_in_service_by_tax_exempt_entity_45w(vehicle: Asset) kind empirical {
    label en official "the vehicle is not subject to a lease and is placed in service by a tax-exempt entity described in section 168(h)(2)(A)(i), (ii), or (iv) (section 45W(d)(2)) — case-asserted";
}
pub relation credit_allowed_under_30d_for_vehicle_45w(vehicle: Asset) kind empirical {
    label en official "a credit was allowed under section 30D for the vehicle (section 45W(d)(3)) — case-asserted";
}
pub relation vehicle_identification_number_on_return_45w(taxpayer: Person, vehicle: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes the vehicle identification number on the return for the taxable year (section 45W(e)) — case-asserted";
}

// --- (c): qualified commercial clean vehicle ----------------------------------------------------------------------

relation meets_use_test_45w(vehicle: Asset) kind institutional;
rule MeetsUseTestRoadVehicle45wRule(vehicle: Asset) strict {
    when road_vehicle_under_30d_d1d_45w(vehicle);
    then meets_use_test_45w(vehicle);
}
rule MeetsUseTestMobileMachinery45wRule(vehicle: Asset) strict {
    when mobile_machinery_45w(vehicle);
    then meets_use_test_45w(vehicle);
}
relation meets_propulsion_test_45w(vehicle: Asset) kind institutional;
@source(IRC_S45W_C, quote = "is propelled to a significant extent by an electric motor which draws electricity from a battery which has a capacity of not less than 15 kilowatt hours (or, in the case of a vehicle which has a gross vehicle weight rating of less than 14,000 pounds, 7 kilowatt hours)")
rule MeetsPropulsionTestHeavy45wRule(vehicle: Asset, kwh: Decimal, pounds: Decimal) strict {
    when vehicle_battery_kwh_45w(vehicle, kwh);
    when vehicle_gvwr_pounds_45w(vehicle, pounds);
    when pounds >= 14000.0;
    when kwh >= 15.0;
    then meets_propulsion_test_45w(vehicle);
}
rule MeetsPropulsionTestLight45wRule(vehicle: Asset, kwh: Decimal, pounds: Decimal) strict {
    when vehicle_battery_kwh_45w(vehicle, kwh);
    when vehicle_gvwr_pounds_45w(vehicle, pounds);
    when pounds < 14000.0;
    when kwh >= 7.0;
    then meets_propulsion_test_45w(vehicle);
}
rule MeetsPropulsionTestFuelCell45wRule(vehicle: Asset) strict {
    when fuel_cell_vehicle_meeting_30b_b3_45w(vehicle);
    then meets_propulsion_test_45w(vehicle);
}
relation meets_depreciation_test_45w(vehicle: Asset) kind institutional;
rule MeetsDepreciationTestDepreciable45wRule(vehicle: Asset) strict {
    when subject_to_depreciation_45w(vehicle);
    then meets_depreciation_test_45w(vehicle);
}
@source(IRC_S45W_D, quote = "Subsection (c)(4) shall not apply to any vehicle which is not subject to a lease and which is placed in service by a tax-exempt entity")
rule MeetsDepreciationTestTaxExempt45wRule(vehicle: Asset) strict {
    when unleased_vehicle_placed_in_service_by_tax_exempt_entity_45w(vehicle);
    then meets_depreciation_test_45w(vehicle);
}
pub relation qualified_commercial_clean_vehicle_45w(vehicle: Asset) kind institutional {
    label en official "section 45W(c): a qualified commercial clean vehicle";
}
@source(IRC_S45W_C, quote = "For purposes of this section, the term \"qualified commercial clean vehicle\" means any vehicle which")
rule QualifiedCommercialCleanVehicle45wRule(vehicle: Asset) strict {
    when meets_30d_d1c_and_not_for_resale_45w(vehicle);
    when meets_use_test_45w(vehicle);
    when meets_propulsion_test_45w(vehicle);
    when meets_depreciation_test_45w(vehicle);
    then qualified_commercial_clean_vehicle_45w(vehicle);
}

// --- (g): termination, base and PL 119-21 editions --------------------------------------------------------------------

pub relation vehicle_acquired_within_credit_period_45w(vehicle: Asset) kind institutional {
    label en official "section 45W(g): acquired on or before 2032-12-31 (2024 text); on or before 2025-09-30 under PL 119-21 section 70503 from its enactment";
}
@source(IRC_S45W_G, quote = "No credit shall be determined under this section with respect to any vehicle acquired after December 31, 2032.")
rule VehicleAcquiredWithinCreditPeriodBase45wRule(vehicle: Asset, on: Date) strict {
    effective (-infinity, @2025-07-04);
    when vehicle_acquired_on_45w(vehicle, on);
    when on <= @2032-12-31;
    then vehicle_acquired_within_credit_period_45w(vehicle);
}
@source(us.irc.temporal::PL119_21_S70503, quote = "Section 45W(g) is amended by striking “December 31, 2032” and inserting “September 30, 2025”.")
rule VehicleAcquiredWithinCreditPeriodAmended45wRule(vehicle: Asset, on: Date) strict {
    effective [@2025-07-04, infinity);
    when vehicle_acquired_on_45w(vehicle, on);
    when on <= @2025-09-30;
    then vehicle_acquired_within_credit_period_45w(vehicle);
}

// --- (b): the amount -------------------------------------------------------------------------------------------------------

pub relation incremental_cost_45w(vehicle: Asset, amount: Money) kind institutional {
    label en official "section 45W(b)(2): the excess of the purchase price over the price of a comparable vehicle";
}
@source(IRC_S45W_B, quote = "the incremental cost of any qualified commercial clean vehicle is an amount equal to the excess of the purchase price for such vehicle over such price of a comparable vehicle")
rule IncrementalCost45wRule(vehicle: Asset, price: Money, comparable: Money) defeasible {
    when vehicle_purchase_price_45w(vehicle, price);
    when comparable_vehicle_price_45w(vehicle, comparable);
    then incremental_cost_45w(vehicle, max(0 USD, price - comparable));
}
pub relation credit_rate_45w(vehicle: Asset, rate: Decimal) kind institutional {
    label en official "section 45W(b)(1)(A): 15 percent of the basis; 30 percent for a vehicle not powered by a gasoline or diesel internal combustion engine";
}
@source(IRC_S45W_B, quote = "15 percent of the basis of such vehicle (30 percent in the case of a vehicle not powered by a gasoline or diesel internal combustion engine)")
rule CreditRateIce45wRule(vehicle: Asset) strict {
    when vehicle_powered_by_internal_combustion_engine_45w(vehicle);
    then credit_rate_45w(vehicle, 0.15);
}
rule CreditRateNonIce45wRule(vehicle: Asset) strict {
    when vehicle_acquired_on_45w(vehicle, _);
    when not_known(vehicle_powered_by_internal_combustion_engine_45w(vehicle));
    then credit_rate_45w(vehicle, 0.30);
}
pub relation credit_cap_45w(vehicle: Asset, cap: Money) kind institutional {
    label en official "section 45W(b)(4): $7,500 for a gross vehicle weight rating under 14,000 pounds, otherwise $40,000";
}
@source(IRC_S45W_B, quote = "in the case of a vehicle which has a gross vehicle weight rating of less than 14,000 pounds, $7,500")
rule CreditCapLight45wRule(vehicle: Asset, pounds: Decimal) strict {
    when vehicle_gvwr_pounds_45w(vehicle, pounds);
    when pounds < 14000.0;
    then credit_cap_45w(vehicle, 7500.00 USD);
}
@source(IRC_S45W_B, quote = "in the case of a vehicle not described in subparagraph (A), $40,000")
rule CreditCapHeavy45wRule(vehicle: Asset, pounds: Decimal) strict {
    when vehicle_gvwr_pounds_45w(vehicle, pounds);
    when pounds >= 14000.0;
    then credit_cap_45w(vehicle, 40000.00 USD);
}
pub relation commercial_clean_vehicle_credit_amount_45w(taxpayer: Person, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45W(b): the lesser of the rate times the basis and the incremental cost, within the cap";
}
rule CommercialCleanVehicleCreditAmount45wRule(taxpayer: Person, vehicle: Asset, y: TaxableYear, basis: Money, rate: Decimal, incremental: Money, cap: Money) defeasible {
    when qualified_commercial_clean_vehicle_45w(vehicle);
    when vehicle_acquired_within_credit_period_45w(vehicle);
    when not_known(credit_allowed_under_30d_for_vehicle_45w(vehicle));
    when not_known(credit_denied_by_30df_rules_45w(taxpayer, vehicle));
    when vehicle_identification_number_on_return_45w(taxpayer, vehicle, y);
    when vehicle_basis_45w(taxpayer, vehicle, y, basis);
    when credit_rate_45w(vehicle, rate);
    when incremental_cost_45w(vehicle, incremental);
    when credit_cap_45w(vehicle, cap);
    then commercial_clean_vehicle_credit_amount_45w(taxpayer, vehicle, y, min(min(round(rate * basis, 2, "HALF_UP"), incremental), cap));
}
pub relation qualified_commercial_clean_vehicle_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45W qualified commercial clean vehicle credit for the taxable year (a section 38(b)(37) component)";
}
@source(IRC_S45W_A, quote = "the qualified commercial clean vehicle credit for any taxable year is an amount equal to the sum of the credit amounts determined under subsection (b)")
rule QualifiedCommercialCleanVehicleCredit45wRule(taxpayer: Person, y: TaxableYear, vehicle: Asset, amount: Money) defeasible {
    when commercial_clean_vehicle_credit_amount_45w(taxpayer, vehicle, y, amount);
    then qualified_commercial_clean_vehicle_credit(taxpayer, y,
        sum(collect all a: Money, v: Asset where commercial_clean_vehicle_credit_amount_45w(taxpayer, v, y, a), empty: 0 USD));
}
