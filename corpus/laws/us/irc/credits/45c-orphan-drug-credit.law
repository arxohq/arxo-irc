// Section 45C — Clinical testing expenses for certain drugs for rare diseases
// or conditions (orphan drug credit). Stage 2d (IRC-06, DECISION-0379).
//
// Scope / judgment calls:
// * The credit is 25 percent of qualified clinical testing expenses; the
//   expense per testing activity is case-asserted as the section 41(b)
//   amount already computed with the (b)(1)(B) modifications (100 percent of
//   contract research expenses); the section 41(b) machinery is not re-run
//   here (TECH-GAPS G1517). The (b)(1)(C) funding exclusion IS computed.
// * "clinical testing" ((b)(2)) is derived from case facts: the FDCA
//   section 505(i) exemption, the testing date against the FDCA section 526
//   designation date and the section 505(b)/PHSA 351 approval date, the
//   designation holder, and the relation to the designated condition.
// * "rare disease or condition" ((d)(1)): (A) is the 200,000-person count at
//   the designation date; (B) is an evaluative judgment ("no reasonable
//   expectation ...") modelled as an adjudicated fact (DECISION-0194), the
//   text names no deciding authority.
// * (d)(2): testing outside the United States counts only if the U.S.
//   population is insufficient and a U.S. or unrelated person conducts it.
// * (d)(4): the election is a power; the credit needs it.
// * (c)(1)/(c)(2) (interaction with section 41) are exposed as amounts only;
//   section 41 does not consume them yet (TECH-GAPS G1518). (d)(3) (rules of
//   section 41(f)(1)-(2)) is not modelled.

use self::{
    Asset,
    IRC_S45C_A,
    IRC_S45C_B,
    IRC_S45C_C,
    IRC_S45C_D,
    Person,
    TaxableYear,
    clinical_testing_expense_for_credit_45c,
};

pub entity ClinicalTest45C { label en official "a human clinical testing activity carried out for a drug with an orphan designation"; }

pub relation drug_designation_45c(drug: Asset, holder: Person, on: Date) kind empirical {
    label en official "the drug is designated under section 526 of the Federal Food, Drug, and Cosmetic Act for a rare disease or condition, the designation applying to this holder, on this date — case-asserted";
}
pub relation drug_approval_date_45c(drug: Asset, on: Date) kind empirical {
    label en official "the date the application for the drug is approved under FDCA section 505(b) or the biological product license is issued under PHSA section 351 — case-asserted";
}
pub relation us_affected_population_at_designation_45c(drug: Asset, count: Decimal) kind empirical {
    label en official "the number of persons in the United States affected by the disease or condition, as of the designation date (section 45C(d)(1)) — case-asserted";
}
pub relation no_reasonable_expectation_of_cost_recovery_45c(drug: Asset) kind empirical {
    label en official "adjudicated evaluative fact: there is no reasonable expectation that the cost of developing and making available the drug in the United States will be recovered from U.S. sales (section 45C(d)(1)(B)); determined on the facts as of the designation date";
}
pub relation carried_out_under_505i_exemption_45c(trial: ClinicalTest45C) kind empirical {
    label en official "the human clinical testing is carried out under an exemption for a drug being tested for a rare disease or condition under FDCA section 505(i) — case-asserted";
}
pub relation trial_of_drug_45c(trial: ClinicalTest45C, drug: Asset) kind empirical {
    label en official "the clinical testing is testing of this drug — case-asserted";
}
pub relation trial_date_45c(trial: ClinicalTest45C, on: Date) kind empirical {
    label en official "the date the clinical testing occurs — case-asserted";
}
pub relation trial_conducted_on_behalf_of_45c(trial: ClinicalTest45C, party: Person) kind empirical {
    label en official "the clinical testing is conducted by or on behalf of this taxpayer — case-asserted";
}
pub relation trial_related_to_designated_condition_45c(trial: ClinicalTest45C) kind empirical {
    label en official "the testing is related to the use of the drug for the rare disease or condition for which it was designated (section 45C(b)(2)(B)) — case-asserted";
}
pub relation trial_conducted_in_united_states_45c(trial: ClinicalTest45C) kind empirical {
    label en official "the clinical testing is conducted in the United States — case-asserted";
}
pub relation trial_conducted_outside_united_states_45c(trial: ClinicalTest45C) kind empirical {
    label en official "the clinical testing is conducted outside the United States — case-asserted";
}
pub relation insufficient_us_testing_population_45c(trial: ClinicalTest45C) kind empirical {
    label en official "the testing is conducted outside the United States because there is an insufficient testing population in the United States (section 45C(d)(2)(A)) — case-asserted";
}
pub relation trial_conducted_by_us_person_or_unrelated_45c(trial: ClinicalTest45C) kind empirical {
    label en official "the testing outside the United States is conducted by a United States person or by a person not related to the designation holder (section 45C(d)(2)(B)) — case-asserted";
}

// --- (d)(1): rare disease or condition -------------------------------------------

pub relation rare_disease_drug_45c(drug: Asset) kind institutional {
    label en official "section 45C(d)(1): the drug's disease or condition is a rare disease or condition";
}
@source(IRC_S45C_D, quote = "affects less than 200,000 persons in the United States")
rule RareDiseaseByPopulation45cRule(drug: Asset, count: Decimal) strict {
    when us_affected_population_at_designation_45c(drug, count);
    when count < 200000.0;
    then rare_disease_drug_45c(drug);
}
@source(IRC_S45C_D, quote = "there is no reasonable expectation that the cost of developing and making available in the United States a drug for such disease or condition will be recovered from sales in the United States of such drug")
rule RareDiseaseByCostRecovery45cRule(drug: Asset, count: Decimal) strict {
    when us_affected_population_at_designation_45c(drug, count);
    when count > 200000.0;
    when no_reasonable_expectation_of_cost_recovery_45c(drug);
    then rare_disease_drug_45c(drug);
}

// --- (b)(2): clinical testing ----------------------------------------------------

relation drug_approved_45c(drug: Asset) kind institutional;
rule DrugApproved45cRule(drug: Asset, on: Date) strict {
    when drug_approval_date_45c(drug, on);
    then drug_approved_45c(drug);
}
relation testing_before_approval_45c(trial: ClinicalTest45C) kind institutional;
@source(IRC_S45C_B, quote = "before the date on which an application with respect to such drug is approved under section 505(b) of such Act")
rule TestingBeforeApproval45cRule(trial: ClinicalTest45C, drug: Asset, on: Date, approval: Date) strict {
    when trial_of_drug_45c(trial, drug);
    when trial_date_45c(trial, on);
    when drug_approval_date_45c(drug, approval);
    when on < approval;
    then testing_before_approval_45c(trial);
}
rule TestingBeforeApprovalNotYetApproved45cRule(trial: ClinicalTest45C, drug: Asset) strict {
    when trial_of_drug_45c(trial, drug);
    when not_known(drug_approved_45c(drug));
    then testing_before_approval_45c(trial);
}
pub relation clinical_testing_45c(trial: ClinicalTest45C, holder: Person) kind institutional {
    label en official "section 45C(b)(2): human clinical testing under a section 505(i) exemption, after designation and before approval, conducted by or on behalf of the designation holder, and related to the designated condition";
}
@source(IRC_S45C_B, quote = "which is conducted by or on behalf of the taxpayer to whom the designation under such section 526 applies")
rule ClinicalTesting45cRule(trial: ClinicalTest45C, drug: Asset, holder: Person, on: Date, designated: Date) strict {
    when carried_out_under_505i_exemption_45c(trial);
    when trial_of_drug_45c(trial, drug);
    when drug_designation_45c(drug, holder, designated);
    when trial_date_45c(trial, on);
    when on > designated;
    when testing_before_approval_45c(trial);
    when trial_conducted_on_behalf_of_45c(trial, holder);
    when trial_related_to_designated_condition_45c(trial);
    then clinical_testing_45c(trial, holder);
}

// --- (d)(2): location ------------------------------------------------------------

relation eligible_testing_location_45c(trial: ClinicalTest45C) kind institutional;
rule EligibleLocationUnitedStates45cRule(trial: ClinicalTest45C) strict {
    when trial_conducted_in_united_states_45c(trial);
    then eligible_testing_location_45c(trial);
}
@source(IRC_S45C_D, quote = "No credit shall be allowed under this section with respect to any clinical testing conducted outside the United States unless")
rule EligibleLocationOutsideUnitedStates45cRule(trial: ClinicalTest45C) strict {
    when trial_conducted_outside_united_states_45c(trial);
    when insufficient_us_testing_population_45c(trial);
    when trial_conducted_by_us_person_or_unrelated_45c(trial);
    then eligible_testing_location_45c(trial);
}

// --- (b)(1)(A), (C): qualified clinical testing expenses -------------------------

pub relation clinical_testing_expense_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) kind empirical {
    label en official "the section 41(b) amounts (with the (b)(1)(B) modifications) paid or incurred for this testing in the taxable year — case-asserted, the section 41 machinery is not re-run";
}
pub relation clinical_testing_funded_by_others_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) kind empirical {
    label en official "the part of the testing expense funded by a grant, contract, or otherwise by another person or a governmental entity (section 45C(b)(1)(C)) — case-asserted";
}
relation has_funded_amount_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C) kind institutional;
rule HasFundedAmount45cRule(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) strict {
    when clinical_testing_funded_by_others_45c(taxpayer, y, trial, amount);
    then has_funded_amount_45c(taxpayer, y, trial);
}
pub relation qualified_clinical_testing_expenses_of_trial_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) kind institutional {
    label en official "section 45C(b)(1): the qualified clinical testing expense of one testing activity, net of the amount funded by another person";
}
@source(IRC_S45C_B, quote = "shall not include any amount to the extent such amount is funded by any grant, contract, or otherwise by another person (or any governmental entity)")
rule QualifiedExpensesFunded45cRule(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, drug: Asset, expense: Money, funded: Money) defeasible {
    when clinical_testing_45c(trial, taxpayer);
    when trial_of_drug_45c(trial, drug);
    when rare_disease_drug_45c(drug);
    when eligible_testing_location_45c(trial);
    when clinical_testing_expense_for_credit_45c(taxpayer, y, trial, expense);
    when clinical_testing_funded_by_others_45c(taxpayer, y, trial, funded);
    then qualified_clinical_testing_expenses_of_trial_45c(taxpayer, y, trial, max(0 USD, expense - funded));
}
rule QualifiedExpensesUnfunded45cRule(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, drug: Asset, expense: Money) defeasible {
    when clinical_testing_45c(trial, taxpayer);
    when trial_of_drug_45c(trial, drug);
    when rare_disease_drug_45c(drug);
    when eligible_testing_location_45c(trial);
    when clinical_testing_expense_for_credit_45c(taxpayer, y, trial, expense);
    when not_known(has_funded_amount_45c(taxpayer, y, trial));
    then qualified_clinical_testing_expenses_of_trial_45c(taxpayer, y, trial, expense);
}

// --- (d)(4): election ------------------------------------------------------------

pub relation elects_section_45c(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's exercise of the section 45C(d)(4) election to have this section apply for the taxable year";
}
pub relation section_45c_applies(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45C(d)(4): this section applies to the taxpayer for the taxable year (a valid election)";
}
relation has_qualified_clinical_testing_45c(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasQualifiedClinicalTesting45cRule(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) defeasible {
    when qualified_clinical_testing_expenses_of_trial_45c(taxpayer, y, trial, amount);
    then has_qualified_clinical_testing_45c(taxpayer, y);
}
@source(IRC_S45C_D, quote = "This section shall apply to any taxpayer for any taxable year only if such taxpayer elects")
rule Section45cElectionRule(taxpayer: Person, y: TaxableYear) defeasible {
    when has_qualified_clinical_testing_45c(taxpayer, y);
    then power Section45cD4Election {
        holder taxpayer;
        over taxpayer;
        exercise elects_section_45c(taxpayer, y);
        valid_when has_qualified_clinical_testing_45c(taxpayer, y);
        effect create(section_45c_applies(taxpayer, y));
        window [@1983-01-01, infinity);
    };
}

// --- (a): the credit -------------------------------------------------------------

pub relation qualified_clinical_testing_expenses_45c(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45C(b)(1): total qualified clinical testing expenses for the taxable year";
}
rule QualifiedClinicalTestingExpenses45cRule(taxpayer: Person, y: TaxableYear) defeasible {
    when has_qualified_clinical_testing_45c(taxpayer, y);
    then qualified_clinical_testing_expenses_45c(taxpayer, y,
        sum(collect all a: Money, trial: ClinicalTest45C where qualified_clinical_testing_expenses_of_trial_45c(taxpayer, y, trial, a), empty: 0 USD));
}
pub relation orphan_drug_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45C orphan drug credit for the taxable year (a section 38(b)(12) component)";
}
@source(IRC_S45C_A, quote = "the credit determined under this section for the taxable year is an amount equal to 25 percent of the qualified clinical testing expenses for the taxable year")
rule OrphanDrugCredit45cRule(taxpayer: Person, y: TaxableYear, expenses: Money) defeasible {
    when section_45c_applies(taxpayer, y);
    when qualified_clinical_testing_expenses_45c(taxpayer, y, expenses);
    then orphan_drug_credit(taxpayer, y, round(0.25 * expenses, 2, "HALF_UP"));
}

// --- (c): interaction with section 41 (amounts only) ------------------------------

pub relation section_41_exclusion_for_45c_expenses(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45C(c)(1): the qualified clinical testing expenses of a year to which the election applies are not taken into account for the section 41 credit (exposed as an amount; section 41 does not consume it yet)";
}
@source(IRC_S45C_C, quote = "shall not be taken into account for purposes of determining the credit allowable under section 41 for such taxable year")
rule Section41ExclusionFor45cExpensesRule(taxpayer: Person, y: TaxableYear, expenses: Money) defeasible {
    when section_45c_applies(taxpayer, y);
    when qualified_clinical_testing_expenses_45c(taxpayer, y, expenses);
    then section_41_exclusion_for_45c_expenses(taxpayer, y, expenses);
}
