// Credits -- WIRE-10, group A (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 38(b)(20): the distilled spirits credit determined under section 5011(a) is component number 20 of the general
// business credit. The credit itself is computed lot by lot by `us.irc.alcohol` (section 5011(a)-(d)); this owner package sums the
// lot credits of the taxpayer for the calendar taxable year into the `general_business_credit_component_amount` that the
// section 38(d) order and the section 39 carryover rules already read (`s4-a-38d-order-and-41g-carry.law`). The case-asserted
// channel of `general_business_credit_component_amount` stays valid (the rule is `defeasible`, like the other component rules).
//
// JUDGMENT CALLS
//  - `us.irc.alcohol::lot_credit_year` names the credit year as a calendar-year Integer (section 5011(a)(2)); the taxable year is
//    tied to it through `us.irc.core::calendar_year_of`, so only a taxpayer whose taxable year IS a calendar year gets a derived
//    component (a fiscal-year taxpayer keeps the case-fact channel).
//  - The owner reads the consumer (credits -> alcohol): alcohol imports only core and corporations, so the edge is acyclic.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

use self::{
    GeneralBusinessCreditComponent,
    IRC_S38_B,
    Person,
    TaxableYear,
    general_business_credit_component_amount,
};

@source(IRC_S38_B, relation = formalizes, coverage = exact, quote = "the distilled spirits credit determined under section 5011(a)")
rule W10ADistilledSpiritsCreditComponent defeasible {
    label en official "section 38(b)(20): the distilled spirits credit determined under section 5011(a) is a component of the general business credit; the amount is the sum of the section 5011(a) lot credits of the taxpayer for the calendar year of the taxable year";
    for taxpayer: Person;
    for y: TaxableYear;
    for n: Integer;
    for lot: us.irc.alcohol::BottledSpiritsPurchase;
    for lotAmount: Money;
    when us.irc.core::year_of(taxpayer, y)
        and us.irc.core::calendar_year_of(y, n)
        and us.irc.alcohol::lot_credit_year(lot, n)
        and us.irc.alcohol::distilled_spirits_credit_for_lot(lot, taxpayer, lotAmount);
    then general_business_credit_component_amount(taxpayer, y, DistilledSpiritsCredit5011,
        sum(collect all a: Money, l2: us.irc.alcohol::BottledSpiritsPurchase where us.irc.alcohol::lot_credit_year(l2, n) and us.irc.alcohol::distilled_spirits_credit_for_lot(l2, taxpayer, a), empty: 0 USD));
}
