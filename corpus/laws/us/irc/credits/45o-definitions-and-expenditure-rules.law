// Section 45O — the qualified chemical security expenditure of (d), the eligible agricultural business of (e) and the specified agricultural
// chemical of (f). Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G391). Companion of
// `45o-agricultural-chemicals-security-credit.law`; its credit rules read the security expenditures and the business status as case facts and
// are NOT rewired to require these relations.
//
// Judgment calls: the nine measures of (d)(1)-(9) are an enum fact of the expenditure; the amount taken into account is the asserted part
// paid or incurred for protecting specified agricultural chemicals; the measure "such other measures as the Secretary may identify in
// regulation" is an external judgment (DECISION-0194); the listing of a fertilizer under the three lists is one fact per list.

use self::{
    Asset,
    IRC_S45O_D,
    IRC_S45O_E,
    IRC_S45O_F,
    Person,
    TaxableYear,
};

pub enum SecurityMeasure45O {
    EmployeeTrainingAndBackgroundChecks,
    LimitingAccessToControls,
    TaggingLockingAndAdditives,
    PerimeterProtection,
    LightingCamerasAndSensors,
    ComputerNetworkSecurity,
    VulnerabilityAssessment,
    SiteSecurityPlan,
    OtherMeasure
}
pub enum BusinessActivity45O { RetailSalesToFarmersAndRanchers, ManufacturingFormulatingDistributingOrAerialApplication, OtherActivity }
pub enum ChemicalKind45O { Fertilizer, Pesticide, OtherChemical }

// --- (e): the eligible agricultural business -----------------------------------------------------------------------------------------------------------------

pub relation business_activity_45o(taxpayer: Person, activity: BusinessActivity45O) kind empirical {
    label en official "the trade or business of the person (section 45O(e)) — case-asserted";
}
pub relation sells_predominantly_to_farmers_and_ranchers_45o(taxpayer: Person) kind empirical {
    label en official "the retail sales of agricultural products, including specified agricultural chemicals, are predominantly to farmers and ranchers (section 45O(e)(1)) — case-asserted";
}
pub relation eligible_agricultural_business_defined_45o(taxpayer: Person) kind institutional {
    label en official "section 45O(e): a person in the trade or business of selling agricultural products (including specified agricultural chemicals) at retail predominantly to farmers and ranchers, or of manufacturing, formulating, distributing, or aerially applying specified agricultural chemicals";
}
@source(IRC_S45O_E, relation = formalizes, coverage = exact, quote = "selling agricultural products, including specified agricultural chemicals, at retail predominantly to farmers and ranchers")
rule EligibleAgriculturalBusinessRetailRule(taxpayer: Person) strict {
    when business_activity_45o(taxpayer, RetailSalesToFarmersAndRanchers);
    when sells_predominantly_to_farmers_and_ranchers_45o(taxpayer);
    then eligible_agricultural_business_defined_45o(taxpayer);
}
@source(IRC_S45O_E, relation = formalizes, coverage = exact, quote = "manufacturing, formulating, distributing, or aerially applying specified agricultural chemicals")
rule EligibleAgriculturalBusinessChemicalsRule(taxpayer: Person) strict {
    when business_activity_45o(taxpayer, ManufacturingFormulatingDistributingOrAerialApplication);
    then eligible_agricultural_business_defined_45o(taxpayer);
}

// --- (f): the specified agricultural chemical ----------------------------------------------------------------------------------------------------------------

pub relation chemical_kind_45o(chemical: Asset, kind: ChemicalKind45O) kind empirical {
    label en official "the kind of the chemical (section 45O(f)) — case-asserted";
}
pub relation fertilizer_commonly_used_in_agricultural_operations_45o(chemical: Asset) kind empirical {
    label en official "the fertilizer is commonly used in agricultural operations (section 45O(f)(1)) — case-asserted";
}
pub relation listed_under_emergency_planning_act_302a2_45o(chemical: Asset) kind empirical {
    label en official "the fertilizer is listed under section 302(a)(2) of the Emergency Planning and Community Right-to-Know Act of 1986 (section 45O(f)(1)(A)) — case-asserted";
}
pub relation listed_under_49_cfr_172_101_45o(chemical: Asset) kind empirical {
    label en official "the fertilizer is listed under section 101 of part 172 of title 49, Code of Federal Regulations (section 45O(f)(1)(B)) — case-asserted";
}
pub relation listed_under_33_cfr_parts_126_127_154_45o(chemical: Asset) kind empirical {
    label en official "the fertilizer is listed under part 126, 127, or 154 of title 33, Code of Federal Regulations (section 45O(f)(1)(C)) — case-asserted";
}
pub relation pesticide_under_fifra_2u_45o(chemical: Asset) kind empirical {
    label en official "the chemical is a pesticide as defined in section 2(u) of the Federal Insecticide, Fungicide, and Rodenticide Act, including all active and inert ingredients (section 45O(f)(2)) — case-asserted";
}
pub relation customarily_used_on_crops_for_food_feed_or_fiber_45o(chemical: Asset) kind empirical {
    label en official "the pesticide is customarily used on crops grown for food, feed, or fiber (section 45O(f)(2)) — case-asserted";
}
pub relation specified_agricultural_chemical_45o(chemical: Asset) kind institutional {
    label en official "section 45O(f): a fertilizer commonly used in agricultural operations that is listed under the Emergency Planning Act, 49 CFR 172.101 or 33 CFR parts 126, 127 or 154, or a pesticide (with its active and inert ingredients) customarily used on crops for food, feed or fiber";
}
@source(IRC_S45O_F, relation = formalizes, coverage = exact, quote = "any fertilizer commonly used in agricultural operations which is listed under")
rule SpecifiedChemicalFertilizerEpcraRule(chemical: Asset) strict {
    when chemical_kind_45o(chemical, Fertilizer);
    when fertilizer_commonly_used_in_agricultural_operations_45o(chemical);
    when listed_under_emergency_planning_act_302a2_45o(chemical);
    then specified_agricultural_chemical_45o(chemical);
}
rule SpecifiedChemicalFertilizerHazmatRule(chemical: Asset) strict {
    when chemical_kind_45o(chemical, Fertilizer);
    when fertilizer_commonly_used_in_agricultural_operations_45o(chemical);
    when listed_under_49_cfr_172_101_45o(chemical);
    then specified_agricultural_chemical_45o(chemical);
}
rule SpecifiedChemicalFertilizerCoastGuardRule(chemical: Asset) strict {
    when chemical_kind_45o(chemical, Fertilizer);
    when fertilizer_commonly_used_in_agricultural_operations_45o(chemical);
    when listed_under_33_cfr_parts_126_127_154_45o(chemical);
    then specified_agricultural_chemical_45o(chemical);
}
@source(IRC_S45O_F, relation = formalizes, coverage = exact, quote = "which is customarily used on crops grown for food, feed, or fiber")
rule SpecifiedChemicalPesticideRule(chemical: Asset) strict {
    when chemical_kind_45o(chemical, Pesticide);
    when pesticide_under_fifra_2u_45o(chemical);
    when customarily_used_on_crops_for_food_feed_or_fiber_45o(chemical);
    then specified_agricultural_chemical_45o(chemical);
}

// --- (d): the qualified chemical security expenditure --------------------------------------------------------------------------------------------------

pub relation security_expenditure_45o(taxpayer: Person, item: Asset, y: TaxableYear, measure: SecurityMeasure45O, amount: Money) kind empirical {
    label en official "an amount paid or incurred by the business during the taxable year for a measure of section 45O(d)(1)-(9) — case-asserted";
}
pub relation amount_for_protecting_specified_chemicals_45o(item: Asset, amount: Money) kind empirical {
    label en official "the part of the amount paid or incurred for the purpose of protecting specified agricultural chemicals (section 45O(d), last sentence) — case-asserted";
}
external judgment relation secretary_identifies_other_measure_45o(item: Asset) {
    authority Secretary;
    label en official "the measure is another measure for the protection of specified agricultural chemicals that the Secretary identifies in regulation (section 45O(d)(9))";
}
pub relation qualified_chemical_security_expenditure_45o(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45O(d): an amount paid or incurred by an eligible agricultural business for one of the nine listed measures, taken into account only to the extent paid or incurred for the purpose of protecting specified agricultural chemicals";
}
@source(IRC_S45O_D, relation = formalizes, coverage = exact, quote = "Amounts described in the preceding sentence shall be taken into account only to the extent that such amounts are paid or incurred for the purpose of protecting specified agricultural chemicals.")
rule QualifiedExpenditureListedMeasureRule(taxpayer: Person, item: Asset, y: TaxableYear, measure: SecurityMeasure45O, amount: Money, protecting: Money) defeasible {
    when eligible_agricultural_business_defined_45o(taxpayer);
    when security_expenditure_45o(taxpayer, item, y, measure, amount);
    when measure != OtherMeasure;
    when amount_for_protecting_specified_chemicals_45o(item, protecting);
    then qualified_chemical_security_expenditure_45o(taxpayer, item, y, min(amount, protecting));
}
@source(IRC_S45O_D, relation = formalizes, coverage = exact, quote = "such other measures for the protection of specified agricultural chemicals as the Secretary may identify in regulation")
rule QualifiedExpenditureOtherMeasureRule(taxpayer: Person, item: Asset, y: TaxableYear, amount: Money, protecting: Money) defeasible {
    when eligible_agricultural_business_defined_45o(taxpayer);
    when security_expenditure_45o(taxpayer, item, y, OtherMeasure, amount);
    when secretary_identifies_other_measure_45o(item);
    when amount_for_protecting_specified_chemicals_45o(item, protecting);
    then qualified_chemical_security_expenditure_45o(taxpayer, item, y, min(amount, protecting));
}
pub relation qualified_chemical_security_expenditures_computed_45o(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45O(d): the sum of the qualified chemical security expenditures of the taxable year";
}
rule QualifiedExpendituresComputedRule(taxpayer: Person, y: TaxableYear, one_item: Asset, one_amount: Money) defeasible {
    when qualified_chemical_security_expenditure_45o(taxpayer, one_item, y, one_amount);
    then qualified_chemical_security_expenditures_computed_45o(taxpayer, y,
        sum(collect all a: Money, i: Asset where qualified_chemical_security_expenditure_45o(taxpayer, i, y, a), empty: 0 USD));
}
