// Section 49 — At-risk rules. Stage 2d (IRC-06, DECISION-0379).
//
// Scope / judgment calls:
// * (a)(1): for property of a taxpayer described in section 465(a)(1) used in
//   an activity subject to section 465, the credit base is reduced by the
//   nonqualified nonrecourse financing as of the close of the year of placing in
//   service. Nonqualified nonrecourse financing is nonrecourse financing that is
//   not qualified commercial financing: property acquired from an unrelated
//   person, financing at most 80 percent of the credit base, borrowed from a
//   qualified person or a government (or government-guaranteed), and not
//   convertible debt. The 80 percent test is computed over the asserted
//   financing items of the property.
// * (a)(2): a net decrease of the nonqualified nonrecourse financing increases
//   the credit base by the decrease (an asserted amount per year); (b): a net
//   increase at the close of a later year increases the tax by the credit that
//   would have been lost (an asserted amount).
// * The credit base pieces, the section 465 tests, the partner and shareholder
//   allocation and the section 50 interaction are case facts or not modelled
//   (TECH-GAPS G1806).

use self::{
    Asset,
    IRC_S49_A,
    IRC_S49_B,
    Person,
    TaxableYear,
};

pub relation credit_base_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit base of the property: the basis of the qualified rehabilitated building attributable to qualified rehabilitation expenditures, energy property, or property of a section 48A, 48B, 48C, 48D or 48E project (section 49(a)(1)(C)) — case-asserted";
}
pub relation taxpayer_and_activity_subject_to_465_49(taxpayer: Person, prop: Asset) kind empirical {
    label en official "the property is placed in service by a taxpayer described in section 465(a)(1) and used in an activity with respect to which any loss is subject to limitation under section 465 (section 49(a)(1)(B)) — case-asserted";
}
pub relation nonrecourse_financing_item_49(prop: Asset, item: Asset, amount: Money) kind empirical {
    label en official "an item of nonrecourse financing with respect to the property (including guaranteed or stop-loss amounts and amounts borrowed from an interested person, section 49(a)(1)(D)(iii)), as of the close of the year of placing in service — case-asserted";
}
pub relation property_acquired_from_unrelated_person_49(prop: Asset) kind empirical {
    label en official "the property is acquired by the taxpayer from a person who is not a related person (section 49(a)(1)(D)(ii)(I)) — case-asserted";
}
pub relation lender_is_qualified_person_or_government_49(item: Asset) kind empirical {
    label en official "the financing is borrowed from a qualified person (actively and regularly in the business of lending money, not a related person, the seller, or a fee recipient) or is a loan from or guaranteed by a Federal, State or local government (section 49(a)(1)(D)(ii)(III), (iv)) — case-asserted";
}
pub relation financing_is_convertible_debt_49(item: Asset) kind empirical {
    label en official "the financing is convertible debt (section 49(a)(1)(D)(ii), last sentence) — case-asserted";
}
pub relation net_decrease_of_nonqualified_financing_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net decrease in the amount of nonqualified nonrecourse financing at the close of a later taxable year (section 49(a)(2)(A)) — case-asserted";
}
pub relation credit_decrease_from_financing_increase_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate decrease in the credits allowed under section 38 for all prior taxable years that would have resulted from the net increase of nonqualified nonrecourse financing (section 49(b)(1)) — case-asserted";
}
pub relation net_increase_of_nonqualified_financing_49(taxpayer: Person, prop: Asset, y: TaxableYear) kind empirical {
    label en official "there is a net increase at the close of the taxable year in the amount of nonqualified nonrecourse financing for property to which subsection (a)(1) applies (section 49(b)(1)) — case-asserted";
}

// --- (a)(1)(D): qualified commercial financing ------------------------------------------------------------------------------------

pub relation total_nonrecourse_financing_49(prop: Asset, amount: Money) kind institutional {
    label en official "the amount of nonrecourse financing with respect to the property (section 49(a)(1)(D)(ii)(II))";
}
rule TotalNonrecourseFinancing49Rule(prop: Asset, item: Asset, amount: Money) strict {
    when nonrecourse_financing_item_49(prop, item, amount);
    then total_nonrecourse_financing_49(prop, sum(collect all a: Money, i: Asset where nonrecourse_financing_item_49(prop, i, a), empty: 0 USD));
}
pub relation qualified_commercial_financing_49(prop: Asset, item: Asset) kind institutional {
    label en official "section 49(a)(1)(D)(ii): financing of property acquired from an unrelated person, at most 80 percent of the credit base in total, from a qualified person or government, not convertible debt";
}
@source(IRC_S49_A, quote = "the amount of the nonrecourse financing with respect to such property does not exceed 80 percent of the credit base of such property")
rule QualifiedCommercialFinancing49Rule(taxpayer: Person, prop: Asset, item: Asset, y: TaxableYear, amount: Money, base: Money, total: Money) strict {
    when nonrecourse_financing_item_49(prop, item, amount);
    when property_acquired_from_unrelated_person_49(prop);
    when credit_base_49(taxpayer, prop, y, base);
    when total_nonrecourse_financing_49(prop, total);
    when total <= 0.80 * base;
    when lender_is_qualified_person_or_government_49(item);
    when not_known(financing_is_convertible_debt_49(item));
    then qualified_commercial_financing_49(prop, item);
}
pub relation nonqualified_nonrecourse_financing_49(prop: Asset, amount: Money) kind institutional {
    label en official "section 49(a)(1)(D)(i): the nonrecourse financing that is not qualified commercial financing";
}
@source(IRC_S49_A, quote = "the term \"nonqualified nonrecourse financing\" means any nonrecourse financing which is not qualified commercial financing")
rule NonqualifiedNonrecourseFinancing49Rule(prop: Asset, item: Asset, amount: Money) defeasible {
    when nonrecourse_financing_item_49(prop, item, amount);
    when not_known(qualified_commercial_financing_49(prop, item));
    then nonqualified_nonrecourse_financing_49(prop,
        sum(collect all a: Money, i: Asset where nonrecourse_financing_item_49(prop, i, a) and not_known(qualified_commercial_financing_49(prop, i)), empty: 0 USD));
}
relation has_nonqualified_financing_49(prop: Asset) kind institutional;
rule HasNonqualifiedFinancing49Rule(prop: Asset, amount: Money) defeasible {
    when nonqualified_nonrecourse_financing_49(prop, amount);
    then has_nonqualified_financing_49(prop);
}

// --- (a)(1)(A): the reduced credit base ------------------------------------------------------------------------------------------------------

pub relation reduced_credit_base_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 49(a)(1)(A): the credit base reduced by the nonqualified nonrecourse financing as of the close of the year in which the property is placed in service";
}
@source(IRC_S49_A, quote = "The credit base of any property to which this paragraph applies shall be reduced by the nonqualified nonrecourse financing with respect to such credit base")
rule ReducedCreditBaseWithFinancing49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, base: Money, nonqualified: Money) defeasible {
    when credit_base_49(taxpayer, prop, y, base);
    when taxpayer_and_activity_subject_to_465_49(taxpayer, prop);
    when nonqualified_nonrecourse_financing_49(prop, nonqualified);
    then reduced_credit_base_49(taxpayer, prop, y, max(0 USD, base - nonqualified));
}
rule ReducedCreditBaseNoFinancing49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, base: Money) defeasible {
    when credit_base_49(taxpayer, prop, y, base);
    when taxpayer_and_activity_subject_to_465_49(taxpayer, prop);
    when not_known(has_nonqualified_financing_49(prop));
    then reduced_credit_base_49(taxpayer, prop, y, base);
}
rule ReducedCreditBaseNotSubject49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, base: Money) defeasible {
    when credit_base_49(taxpayer, prop, y, base);
    when not_known(taxpayer_and_activity_subject_to_465_49(taxpayer, prop));
    then reduced_credit_base_49(taxpayer, prop, y, base);
}

// --- (a)(2): increase of the credit base on a later decrease -------------------------------------------------------------------------------

pub relation credit_base_after_decrease_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 49(a)(2)(A): a net decrease in nonqualified nonrecourse financing at the close of a later year increases the credit base, treated as earned in the year of the decrease (section 49(a)(2)(C)(ii))";
}
@source(IRC_S49_A, quote = "there is a net decrease in the amount of nonqualified nonrecourse financing with respect to such property")
rule CreditBaseAfterDecrease49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, decrease: Money) defeasible {
    when net_decrease_of_nonqualified_financing_49(taxpayer, prop, y, decrease);
    then credit_base_after_decrease_49(taxpayer, prop, y, decrease);
}

// --- (b): recapture of the credit on a later increase ---------------------------------------------------------------------------------------------

pub relation at_risk_recapture_tax_increase_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 49(b)(1): the tax for the year is increased by the aggregate decrease of prior credits that would have resulted from the net increase of nonqualified nonrecourse financing";
}
@source(IRC_S49_B, quote = "there is a net increase with respect to the taxpayer in the amount of nonqualified nonrecourse financing")
rule AtRiskRecaptureTaxIncrease49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, decrease: Money) defeasible {
    when net_increase_of_nonqualified_financing_49(taxpayer, prop, y);
    when credit_decrease_from_financing_increase_49(taxpayer, prop, y, decrease);
    then at_risk_recapture_tax_increase_49(taxpayer, prop, y, decrease);
}
