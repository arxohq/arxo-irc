// Credits -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified).
//
// Each relation below was a local contract (a fact or an underived institutional placeholder naming its owner). The owner package
// publishes the same concept, so the local relation is now DERIVED from the owner's `pub` relation; the case-fact channel stays valid
// (an institutional relation may still be asserted, DECISIONS Д-15/Д-19), so existing scenarios are unchanged. Nothing is restated.

language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

use self::{
    Person,
    TaxableYear,
    eligible_employer_408p2c1,
};

rule W7EligibleEmployer408pFromDeferredCompensation strict {
    label en official "section 45E(c)(1): an eligible employer is the section 408(p)(2)(C)(i) employer (size test and the 2-year grace period) of the owner package `deferred_compensation`";
    for employer: Person;
    for y: TaxableYear;
    when us.irc.deferred_compensation::eligible_employer_408pCi(employer, y);
    then eligible_employer_408p2c1(employer, y);
}

