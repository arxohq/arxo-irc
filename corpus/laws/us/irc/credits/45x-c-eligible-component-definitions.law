// Section 45X — subsection (c) definitions of "eligible component" (solar, wind, inverter, qualifying battery component,
// applicable critical mineral) and subsection (d) special rules. Stage 2e (IRC-06, DECISION-0379, TECH_GAP reduction of the
// stage 2c rows "subsection 45X(c) not reached"). Companion of `45x-advanced-manufacturing-production-credit.law`, whose
// credit rules read case-asserted component types: the classification below yields the same
// `EligibleComponentType45x` value from the physical facts of the component, but the credit module is NOT rewired to
// require it (the stage 2c scenarios assert the type directly).
//
// Scope / judgment calls:
// * The inverter classes are decided by rated output (volts, phases) and capacity (kilowatts, "per alternating current
//   watt basis"); one component can satisfy several definitions (a 208-volt three-phase 50 kW inverter is commercial;
//   a 650-watt three-phase inverter for one module is also a microinverter): every class it meets is derived.
// * The applicable critical mineral catalogue of (c)(6) is a table of (mineral, form, minimum purity) alternatives:
//   the case supplies the mineral, its form and the purity as a fraction of the stated basis (mass of the named form).
// * PL 119-21 section 70514 (pinned `us.irc.temporal::PL119_21_S70514`, enacted 2025-07-04): (a) rewrites (d)(4) for
//   components sold in taxable years beginning after 2026-12-31 (same manufacturing facility, 65 percent of the direct
//   material costs attributable to primary components made in the United States); (d) adds a subclause (III) to the
//   battery module definition; (e) adds metallurgical coal as applicable critical mineral (R); (c)(1)(C) excludes
//   property with material assistance from a prohibited foreign entity. They are modelled with `effective` windows on
//   `legal_time` (the "taxable years beginning after" test is approximated by the date, as in the other PL 119-21
//   editions of this package).
// * (d)(3): rules similar to section 52(d) under regulations: EXTERNAL_DEPENDENCY (regulations not pinned).

// --- (c)(1): eligible component ---------------------------------------------------------------------------------------------------------

use self::{
    Asset,
    ControlledGroup,
    EligibleComponentType45x,
    IRC_S45X_C,
    IRC_S45X_D,
    Person,
    TaxableYear,
    under_common_control_52b,
};

pub enum InverterClass45xc {
    Central;
    Commercial;
    DistributedWind;
    Micro;
    Residential;
    Utility;
}
pub enum SolarComponentKind45xc {
    SolarModule;
    PhotovoltaicCell;
    PhotovoltaicWafer;
    SolarGradePolysilicon;
    TorqueTubeOrStructuralFastener;
    PolymericBacksheet;
}
pub enum WindComponentKind45xc {
    Blade;
    Nacelle;
    Tower;
    OffshoreWindFoundation;
    RelatedOffshoreWindVessel;
}
pub enum BatteryComponentKind45xc {
    ElectrodeActiveMaterial;
    BatteryCell;
    BatteryModule;
}

pub relation component_is_inverter_class_45xc(component: Asset, class: InverterClass45xc) kind institutional {
    label en official "section 45X(c)(2): the component is an inverter of this class (central, commercial, distributed wind, micro, residential or utility)";
}
pub relation converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(component: Asset) kind empirical {
    label en official "the end product is suitable to convert direct current electricity from 1 or more solar modules or certified distributed wind energy systems into alternating current electricity (section 45X(c)(2)(A)) — case-asserted";
}
pub relation inverter_capacity_kw_ac_45xc(component: Asset, kw: Decimal) kind empirical {
    label en official "the capacity of the inverter in kilowatts, expressed on a per alternating current watt basis (section 45X(c)(2)(B)-(G)) — case-asserted";
}
pub relation inverter_rated_output_45xc(component: Asset, volts: Decimal, phases: Decimal) kind empirical {
    label en official "the rated output of the inverter: volts and number of phases (section 45X(c)(2)) — case-asserted";
}
pub relation suitable_for_large_utility_scale_systems_45xc(component: Asset) kind empirical {
    label en official "the inverter is suitable for large utility-scale systems (section 45X(c)(2)(B)) — case-asserted";
}
pub relation suitable_for_commercial_or_utility_scale_45xc(component: Asset) kind empirical {
    label en official "the inverter is suitable for commercial or utility-scale applications or systems (section 45X(c)(2)(C)(i), (G)(i)) — case-asserted";
}
pub relation used_in_system_with_certified_distributed_wind_energy_system_45xc(component: Asset) kind empirical {
    label en official "the inverter is used in a residential or non-residential system which utilizes 1 or more certified distributed wind energy systems (section 45X(c)(2)(D)(i)(I)) — case-asserted; a certified distributed wind energy system is certified by an accredited certification agency to meet Standard 9.1-2009 of the American Wind Energy Association (including approved revisions) (clause (ii))";
}
pub relation suitable_to_connect_with_one_solar_module_45xc(component: Asset) kind empirical {
    label en official "the inverter is suitable to connect with one solar module (section 45X(c)(2)(E)(i)) — case-asserted";
}
pub relation suitable_for_a_residence_45xc(component: Asset) kind empirical {
    label en official "the inverter is suitable for a residence (section 45X(c)(2)(F)(i)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"central inverter\" means an inverter which is suitable for large utility-scale systems and has a capacity which is greater than 1,000 kilowatts (expressed on a per alternating current watt basis).")
rule CentralInverter45xcRule(component: Asset, kw: Decimal) strict {
    when converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(component);
    when suitable_for_large_utility_scale_systems_45xc(component);
    when inverter_capacity_kw_ac_45xc(component, kw);
    when kw > 1000.0;
    then component_is_inverter_class_45xc(component, Central);
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(iii) has a capacity which is not less than 20 kilowatts and not greater than 125 kilowatts (expressed on a per alternating current watt basis).")
rule CommercialInverter45xcRule(component: Asset, kw: Decimal, volts: Decimal, phases: Decimal) strict {
    when converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(component);
    when suitable_for_commercial_or_utility_scale_45xc(component);
    when inverter_rated_output_45xc(component, volts, phases);
    when phases == 3.0;
    when commercial_inverter_voltage_45xc(volts);
    when inverter_capacity_kw_ac_45xc(component, kw);
    when kw >= 20.0;
    when kw <= 125.0;
    then component_is_inverter_class_45xc(component, Commercial);
}
relation commercial_inverter_voltage_45xc(volts: Decimal) kind institutional;
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(ii) has a rated output of 208, 480, 600, or 800 volt three-phase power, and")
assert "45xc-cv-208": commercial_inverter_voltage_45xc(208.0);
assert "45xc-cv-480": commercial_inverter_voltage_45xc(480.0);
assert "45xc-cv-600": commercial_inverter_voltage_45xc(600.0);
assert "45xc-cv-800": commercial_inverter_voltage_45xc(800.0);
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(II) has a rated output of not greater than 150 kilowatts.")
rule DistributedWindInverter45xcRule(component: Asset, kw: Decimal) strict {
    when converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(component);
    when used_in_system_with_certified_distributed_wind_energy_system_45xc(component);
    when inverter_capacity_kw_ac_45xc(component, kw);
    when kw <= 150.0;
    then component_is_inverter_class_45xc(component, DistributedWind);
}
relation micro_inverter_output_45xc(volts: Decimal, phases: Decimal) kind institutional;
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(I) 120 or 240 volt single-phase power, or")
assert "45xc-mo-120": micro_inverter_output_45xc(120.0, 1.0);
assert "45xc-mo-240": micro_inverter_output_45xc(240.0, 1.0);
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(II) 208 or 480 volt three-phase power, and")
assert "45xc-mo-208": micro_inverter_output_45xc(208.0, 3.0);
assert "45xc-mo-480": micro_inverter_output_45xc(480.0, 3.0);
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(iii) has a capacity which is not greater than 650 watts (expressed on a per alternating current watt basis).")
rule MicroInverter45xcRule(component: Asset, kw: Decimal, volts: Decimal, phases: Decimal) strict {
    when converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(component);
    when suitable_to_connect_with_one_solar_module_45xc(component);
    when inverter_rated_output_45xc(component, volts, phases);
    when micro_inverter_output_45xc(volts, phases);
    when inverter_capacity_kw_ac_45xc(component, kw);
    when kw <= 0.65;
    then component_is_inverter_class_45xc(component, Micro);
}
relation residential_inverter_output_45xc(volts: Decimal) kind institutional;
assert "45xc-ro-120": residential_inverter_output_45xc(120.0);
assert "45xc-ro-240": residential_inverter_output_45xc(240.0);
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(iii) has a capacity which is not greater than 20 kilowatts (expressed on a per alternating current watt basis).")
rule ResidentialInverter45xcRule(component: Asset, kw: Decimal, volts: Decimal, phases: Decimal) strict {
    when converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(component);
    when suitable_for_a_residence_45xc(component);
    when inverter_rated_output_45xc(component, volts, phases);
    when phases == 1.0;
    when residential_inverter_output_45xc(volts);
    when inverter_capacity_kw_ac_45xc(component, kw);
    when kw <= 20.0;
    then component_is_inverter_class_45xc(component, Residential);
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(iii) has a capacity which is greater than 125 kilowatts and not greater than 1000 kilowatts (expressed on a per alternating current watt basis)")
rule UtilityInverter45xcRule(component: Asset, kw: Decimal, volts: Decimal, phases: Decimal) strict {
    when converts_dc_from_solar_modules_or_certified_wind_systems_to_ac_45xc(component);
    when suitable_for_commercial_or_utility_scale_45xc(component);
    when inverter_rated_output_45xc(component, volts, phases);
    when phases == 3.0;
    when volts >= 600.0;
    when inverter_capacity_kw_ac_45xc(component, kw);
    when kw > 125.0;
    when kw <= 1000.0;
    then component_is_inverter_class_45xc(component, Utility);
}

// --- (c)(3): solar energy components ---------------------------------------------------------------------------------------------------------

pub relation solar_component_kind_45xc(component: Asset, kind: SolarComponentKind45xc) kind institutional {
    label en official "section 45X(c)(3)(A): the component is a solar module, photovoltaic cell, photovoltaic wafer, solar grade polysilicon, torque tube or structural fastener, or polymeric backsheet";
}
pub relation smallest_semiconductor_element_converting_light_to_electricity_45xc(component: Asset) kind empirical {
    label en official "the component is the smallest semiconductor element of a solar module which performs the immediate conversion of light into electricity (section 45X(c)(3)(B)(i)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"photovoltaic cell\" means the smallest semiconductor element of a solar module which performs the immediate conversion of light into electricity.")
rule PhotovoltaicCell45xcRule(component: Asset) strict {
    when smallest_semiconductor_element_converting_light_to_electricity_45xc(component);
    then solar_component_kind_45xc(component, PhotovoltaicCell);
}
pub relation semiconductor_layer_area_cm2_45xc(component: Asset, area: Decimal) kind empirical {
    label en official "the area in square centimeters of the thin slice, sheet or layer of semiconductor material (section 45X(c)(3)(B)(ii)) — case-asserted";
}
pub relation produced_by_single_manufacturer_from_polysilicon_or_thin_film_or_ingot_slicing_45xc(component: Asset) kind empirical {
    label en official "the layer is produced by a single manufacturer directly from molten or evaporated solar grade polysilicon or deposition of a thin film semiconductor absorber layer, or through formation of an ingot from molten polysilicon and subsequent slicing (section 45X(c)(3)(B)(ii)(I)) — case-asserted";
}
pub relation comprises_substrate_or_absorber_layer_of_photovoltaic_cells_45xc(component: Asset) kind empirical {
    label en official "the layer comprises the substrate or absorber layer of one or more photovoltaic cells (section 45X(c)(3)(B)(ii)(II)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"photovoltaic wafer\" means a thin slice, sheet, or layer of semiconductor material of at least 240 square centimeters—")
rule PhotovoltaicWafer45xcRule(component: Asset, area: Decimal) strict {
    when semiconductor_layer_area_cm2_45xc(component, area);
    when area >= 240.0;
    when produced_by_single_manufacturer_from_polysilicon_or_thin_film_or_ingot_slicing_45xc(component);
    when comprises_substrate_or_absorber_layer_of_photovoltaic_cells_45xc(component);
    then solar_component_kind_45xc(component, PhotovoltaicWafer);
}
pub relation silicon_purity_by_mass_45xc(component: Asset, purity: Decimal) kind empirical {
    label en official "the purity of the silicon by mass, as a fraction (section 45X(c)(3)(B)(iv)(II)) — case-asserted";
}
pub relation suitable_for_photovoltaic_manufacturing_45xc(component: Asset) kind empirical {
    label en official "the silicon is suitable for use in photovoltaic manufacturing (section 45X(c)(3)(B)(iv)(I)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "(II) purified to a minimum purity of 99.999999 percent silicon by mass.")
rule SolarGradePolysilicon45xcRule(component: Asset, purity: Decimal) strict {
    when suitable_for_photovoltaic_manufacturing_45xc(component);
    when silicon_purity_by_mass_45xc(component, purity);
    when purity >= 0.99999999;
    then solar_component_kind_45xc(component, SolarGradePolysilicon);
}
pub relation sheet_on_back_of_solar_module_insulating_and_protecting_45xc(component: Asset) kind empirical {
    label en official "the component is a sheet on the back of a solar module which acts as an electric insulator and protects the inner components of the module from the surrounding environment (section 45X(c)(3)(B)(iii)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"polymeric backsheet\" means a sheet on the back of a solar module which acts as an electric insulator and protects the inner components of such module from the surrounding environment.")
rule PolymericBacksheet45xcRule(component: Asset) strict {
    when sheet_on_back_of_solar_module_insulating_and_protecting_45xc(component);
    then solar_component_kind_45xc(component, PolymericBacksheet);
}
pub relation lamination_of_cells_final_assembly_suitable_to_generate_45xc(component: Asset) kind empirical {
    label en official "the component is the connection and lamination of photovoltaic cells into an environmentally protected final assembly suitable to generate electricity when exposed to sunlight (section 45X(c)(3)(B)(v)(I)) — case-asserted";
}
pub relation ready_for_installation_without_additional_manufacturing_45xc(component: Asset) kind empirical {
    label en official "the assembly is ready for installation without an additional manufacturing process (section 45X(c)(3)(B)(v)(II)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"solar module\" means the connection and lamination of photovoltaic cells into an environmentally protected final assembly which is—")
rule SolarModule45xcRule(component: Asset) strict {
    when lamination_of_cells_final_assembly_suitable_to_generate_45xc(component);
    when ready_for_installation_without_additional_manufacturing_45xc(component);
    then solar_component_kind_45xc(component, SolarModule);
}
pub relation part_of_solar_tracker_45xc(component: Asset) kind empirical {
    label en official "the component is part of a solar tracker: a mechanical system that moves solar modules according to the position of the sun to increase energy output (section 45X(c)(3)(B)(vi), (vii)(I)(aa)) — case-asserted";
}
pub relation structural_steel_support_spanning_between_foundation_posts_supporting_panels_45xc(component: Asset) kind empirical {
    label en official "the structural steel support element (including longitudinal purlins), of any cross-sectional shape, possibly assembled from individually manufactured segments, spans longitudinally between foundation posts, supports solar panels and is connected to a mounting attachment for them, and is rotated by a drive system (section 45X(c)(3)(B)(vii)(I)(bb)-(ff)) — case-asserted, bundled";
}
pub relation torque_tube_45xc(component: Asset) kind institutional {
    label en official "section 45X(c)(3)(B)(vii)(I): a structural steel support element that is part of a solar tracker and has the six listed features";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"torque tube\" means a structural steel support element (including longitudinal purlins) which—")
rule TorqueTube45xcRule(component: Asset) strict {
    when part_of_solar_tracker_45xc(component);
    when structural_steel_support_spanning_between_foundation_posts_supporting_panels_45xc(component);
    then torque_tube_45xc(component);
}
pub relation connects_tracker_components_to_foundation_or_torque_tubes_45xc(component: Asset) kind empirical {
    label en official "the component is used to connect the mechanical and drive system components of a solar tracker to its foundation, to connect torque tubes to drive assemblies, or to connect segments of torque tubes to one another (section 45X(c)(3)(B)(vii)(II)) — case-asserted";
}
pub relation structural_fastener_45xc(component: Asset) kind institutional {
    label en official "section 45X(c)(3)(B)(vii)(II): a component used to connect tracker components to the foundation, torque tubes to drive assemblies, or torque tube segments to each other";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"structural fastener\" means a component which is used—")
rule StructuralFastener45xcRule(component: Asset) strict {
    when connects_tracker_components_to_foundation_or_torque_tubes_45xc(component);
    then structural_fastener_45xc(component);
}
rule TorqueTubeIsSolarComponent45xcRule(component: Asset) strict {
    when torque_tube_45xc(component);
    then solar_component_kind_45xc(component, TorqueTubeOrStructuralFastener);
}
rule StructuralFastenerIsSolarComponent45xcRule(component: Asset) strict {
    when structural_fastener_45xc(component);
    then solar_component_kind_45xc(component, TorqueTubeOrStructuralFastener);
}

// --- (c)(4): wind energy components -----------------------------------------------------------------------------------------------------------

pub relation wind_component_kind_45xc(component: Asset, kind: WindComponentKind45xc) kind institutional {
    label en official "section 45X(c)(4)(A): the component is a blade, nacelle, tower, offshore wind foundation or related offshore wind vessel";
}
pub relation airfoil_shaped_blade_converting_wind_to_low_speed_rotation_45xc(component: Asset) kind empirical {
    label en official "the component is an airfoil-shaped blade responsible for converting wind energy to low-speed rotational energy (section 45X(c)(4)(B)(i)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"blade\" means an airfoil-shaped blade which is responsible for converting wind energy to low-speed rotational energy.")
rule WindBlade45xcRule(component: Asset) strict {
    when airfoil_shaped_blade_converting_wind_to_low_speed_rotation_45xc(component);
    then wind_component_kind_45xc(component, Blade);
}
pub relation secures_offshore_tower_to_seafloor_by_fixed_or_floating_platform_45xc(component: Asset) kind empirical {
    label en official "the component (including a transition piece) secures an offshore wind tower and any above-water turbine components to the seafloor using fixed platforms (monopiles, jackets, gravity-based foundations) or floating platforms and associated mooring systems (section 45X(c)(4)(B)(ii)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"offshore wind foundation\" means the component (including transition piece) which secures an offshore wind tower and any above-water turbine components to the seafloor using—")
rule OffshoreWindFoundation45xcRule(component: Asset) strict {
    when secures_offshore_tower_to_seafloor_by_fixed_or_floating_platform_45xc(component);
    then wind_component_kind_45xc(component, OffshoreWindFoundation);
}
pub relation drivetrain_and_tower_top_assembly_within_cover_housing_45xc(component: Asset) kind empirical {
    label en official "the component is the assembly of the drivetrain and other tower-top components of a wind turbine (except the blades and the hub) within their cover housing (section 45X(c)(4)(B)(iii)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"nacelle\" means the assembly of the drivetrain and other tower-top components of a wind turbine (with the exception of the blades and the hub) within their cover housing.")
rule WindNacelle45xcRule(component: Asset) strict {
    when drivetrain_and_tower_top_assembly_within_cover_housing_45xc(component);
    then wind_component_kind_45xc(component, Nacelle);
}
pub relation vessel_purpose_built_or_retrofitted_for_offshore_wind_45xc(component: Asset) kind empirical {
    label en official "the vessel is purpose-built or retrofitted for the development, transport, installation, operation or maintenance of offshore wind energy components (section 45X(c)(4)(B)(iv)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"related offshore wind vessel\" means any vessel which is purpose-built or retrofitted for purposes of the development, transport, installation, operation, or maintenance of offshore wind energy components.")
rule RelatedOffshoreWindVessel45xcRule(component: Asset) strict {
    when vessel_purpose_built_or_retrofitted_for_offshore_wind_45xc(component);
    then wind_component_kind_45xc(component, RelatedOffshoreWindVessel);
}
pub relation tubular_or_lattice_structure_supporting_nacelle_and_rotor_45xc(component: Asset) kind empirical {
    label en official "the component is a tubular or lattice structure which supports the nacelle and rotor of a wind turbine (section 45X(c)(4)(B)(v)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"tower\" means a tubular or lattice structure which supports the nacelle and rotor of a wind turbine.")
rule WindTower45xcRule(component: Asset) strict {
    when tubular_or_lattice_structure_supporting_nacelle_and_rotor_45xc(component);
    then wind_component_kind_45xc(component, Tower);
}

// --- (c)(5): qualifying battery components ------------------------------------------------------------------------------------------------

pub relation battery_component_kind_45xc(component: Asset, kind: BatteryComponentKind45xc) kind institutional {
    label en official "section 45X(c)(5)(A): the component is an electrode active material, a battery cell or a battery module";
}
pub relation cathode_anode_or_electrochemically_active_material_45xc(component: Asset) kind empirical {
    label en official "the material is a cathode material, anode material, anode foil or electrochemically active material, including solvents, additives and electrolyte salts that contribute to the electrochemical processes necessary for energy storage (section 45X(c)(5)(B)(i)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"electrode active material\" means cathode materials, anode materials, anode foils, and electrochemically active materials, including solvents, additives, and electrolyte salts that contribute to the electrochemical processes necessary for energy storage.")
rule ElectrodeActiveMaterial45xcRule(component: Asset) strict {
    when cathode_anode_or_electrochemically_active_material_45xc(component);
    then battery_component_kind_45xc(component, ElectrodeActiveMaterial);
}
pub relation electrochemical_cell_with_positive_and_negative_electrodes_45xc(component: Asset) kind empirical {
    label en official "the component is an electrochemical cell comprised of 1 or more positive electrodes and 1 or more negative electrodes (section 45X(c)(5)(B)(ii)(I)) — case-asserted";
}
pub relation energy_density_wh_per_liter_45xc(component: Asset, density: Decimal) kind empirical {
    label en official "the energy density of the cell in watt-hours per liter (section 45X(c)(5)(B)(ii)(II)) — case-asserted";
}
pub relation storage_capacity_wh_45xc(component: Asset, wh: Decimal) kind empirical {
    label en official "the energy the cell is capable of storing, in watt-hours (section 45X(c)(5)(B)(ii)(III)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"battery cell\" means an electrochemical cell—")
rule BatteryCell45xcRule(component: Asset, density: Decimal, wh: Decimal) strict {
    when electrochemical_cell_with_positive_and_negative_electrodes_45xc(component);
    when energy_density_wh_per_liter_45xc(component, density);
    when density >= 100.0;
    when storage_capacity_wh_45xc(component, wh);
    when wh >= 12.0;
    then battery_component_kind_45xc(component, BatteryCell);
}
pub relation module_of_battery_cells_45xc(component: Asset, cells: Decimal) kind empirical {
    label en official "the module uses battery cells: the number of battery cells configured electrically, in series or parallel, to create voltage or current for a specified end use (section 45X(c)(5)(B)(iii)(I)(aa)) — case-asserted";
}
pub relation module_without_battery_cells_45xc(component: Asset) kind empirical {
    label en official "the module has no battery cells (section 45X(c)(5)(B)(iii)(I)(bb)) — case-asserted";
}
pub relation module_aggregate_capacity_kwh_45xc(component: Asset, kwh: Decimal) kind empirical {
    label en official "the aggregate capacity of the module in kilowatt-hours (section 45X(c)(5)(B)(iii)(II)) — case-asserted";
}
pub relation module_for_hydrogen_fuel_cell_vehicle_45xc(component: Asset) kind empirical {
    label en official "the module is for a hydrogen fuel cell vehicle (section 45X(c)(5)(B)(iii)(II)) — case-asserted";
}
pub relation module_comprises_all_other_essential_equipment_45xc(component: Asset) kind empirical {
    label en official "the module is comprised of all other essential equipment needed for battery functionality, such as current collector assemblies and voltage sense harnesses, or any other essential energy collection equipment (section 45X(c)(5)(B)(iii)(I)(III) added by PL 119-21 section 70514(d)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = partial, quote = "(II) with an aggregate capacity of not less than 7 kilowatt-hours (or, in the case of a module for a hydrogen fuel cell vehicle, not less than 1 kilowatt-hour).")
rule BatteryModuleWithCellsBase45xcRule(component: Asset, cells: Decimal, kwh: Decimal) strict {
    effective (-infinity, @2025-07-04);
    when module_of_battery_cells_45xc(component, cells);
    when cells >= 2.0;
    when module_aggregate_capacity_kwh_45xc(component, kwh);
    when kwh >= 7.0;
    then battery_component_kind_45xc(component, BatteryModule);
}
rule BatteryModuleWithoutCellsBase45xcRule(component: Asset, kwh: Decimal) strict {
    effective (-infinity, @2025-07-04);
    when module_without_battery_cells_45xc(component);
    when module_aggregate_capacity_kwh_45xc(component, kwh);
    when kwh >= 7.0;
    then battery_component_kind_45xc(component, BatteryModule);
}
rule BatteryModuleHydrogenVehicleBase45xcRule(component: Asset, kwh: Decimal) strict {
    effective (-infinity, @2025-07-04);
    when module_for_hydrogen_fuel_cell_vehicle_45xc(component);
    when module_aggregate_capacity_kwh_45xc(component, kwh);
    when kwh >= 1.0;
    then battery_component_kind_45xc(component, BatteryModule);
}
@source(us.irc.temporal::PL119_21_S70514, relation = formalizes, coverage = partial, quote = "(III) which is comprised of all other essential equipment needed for battery functionality, such as current collector assemblies and voltage sense harnesses, or any other essential energy collection equipment.")
rule BatteryModuleWithCellsAmended45xcRule(component: Asset, cells: Decimal, kwh: Decimal) strict {
    effective [@2025-07-04, infinity);
    when module_of_battery_cells_45xc(component, cells);
    when cells >= 2.0;
    when module_aggregate_capacity_kwh_45xc(component, kwh);
    when kwh >= 7.0;
    when module_comprises_all_other_essential_equipment_45xc(component);
    then battery_component_kind_45xc(component, BatteryModule);
}
rule BatteryModuleWithoutCellsAmended45xcRule(component: Asset, kwh: Decimal) strict {
    effective [@2025-07-04, infinity);
    when module_without_battery_cells_45xc(component);
    when module_aggregate_capacity_kwh_45xc(component, kwh);
    when kwh >= 7.0;
    when module_comprises_all_other_essential_equipment_45xc(component);
    then battery_component_kind_45xc(component, BatteryModule);
}
rule BatteryModuleHydrogenVehicleAmended45xcRule(component: Asset, kwh: Decimal) strict {
    effective [@2025-07-04, infinity);
    when module_for_hydrogen_fuel_cell_vehicle_45xc(component);
    when module_aggregate_capacity_kwh_45xc(component, kwh);
    when kwh >= 1.0;
    when module_comprises_all_other_essential_equipment_45xc(component);
    then battery_component_kind_45xc(component, BatteryModule);
}

// --- (c)(6): applicable critical minerals (generated rows) ---------------------------------------------------------------------------------------

pub relation mineral_state_45xc(material: Asset, mineral: Text, form: Text) kind empirical {
    label en official "the mineral (aluminum, antimony, ..., zirconium) is in this form: the named mineral itself (purified) or the compound or alloy it is converted to (section 45X(c)(6)) — case-asserted";
}
pub relation mineral_purity_45xc(material: Asset, mineral: Text, form: Text, purity: Decimal) kind empirical {
    label en official "the purity by mass of the named form of the mineral, as a fraction (0.99 for 99 percent) (section 45X(c)(6)) — case-asserted";
}
pub relation applicable_critical_mineral_45xc(material: Asset) kind institutional {
    label en official "section 45X(c)(6): the material is one of the listed minerals in a listed form converted or purified to the stated minimum purity";
}
pub relation low_alpha_tin_purity_45xc(material: Asset, purity: Decimal) kind empirical {
    label en official "the purity by mass of the low alpha emitting tin, as a fraction (section 45X(c)(6)(V)(i)) — case-asserted";
}
pub relation tin_alpha_emission_rate_45xc(material: Asset, counts_per_hour_per_cm2: Decimal) kind empirical {
    label en official "the alpha emission rate of the tin in counts per hour per square centimeter (section 45X(c)(6)(V)(ii)) — case-asserted";
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "Tin which is purified to low alpha emitting tin which—")
rule ApplicableCriticalMineralTin45xcRule(material: Asset, purity: Decimal, rate: Decimal) strict {
    when low_alpha_tin_purity_45xc(material, purity);
    when purity > 0.9999;
    when tin_alpha_emission_rate_45xc(material, rate);
    when rate <= 0.01;
    then applicable_critical_mineral_45xc(material);
}
rule ApplicableCriticalMineralAluminumAlumina45xcRule(material: Asset, purity: Decimal) strict {
    when mineral_state_45xc(material, "aluminum", "alumina");
    when mineral_purity_45xc(material, "aluminum", "alumina", purity);
    when purity >= 0.99;
    then applicable_critical_mineral_45xc(material);
}
