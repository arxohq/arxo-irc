@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "Any of the following minerals, provided that such mineral is purified to a minimum purity of 99 percent by mass:")
rule ApplicableCriticalMineralListedMinorMineral45xcRule(material: Asset, mineral: Text, purity: Decimal) strict {
    when minor_critical_mineral_45xc(mineral);
    when mineral_state_45xc(material, mineral, mineral);
    when mineral_purity_45xc(material, mineral, mineral, purity);
    when purity >= 0.99;
    then applicable_critical_mineral_45xc(material);
}
pub relation metallurgical_coal_suitable_for_steel_production_45xc(material: Asset) kind empirical {
    label en official "the material is metallurgical coal suitable for use in the production of steel (within the meaning of the Department of Energy notice, 90 Fed. Reg. 22711 (May 29, 2025)), whether or not the production occurs in the United States (section 45X(c)(6)(R) added by PL 119-21 section 70514(e)) — case-asserted";
}
@source(us.irc.temporal::PL119_21_S70514, relation = formalizes, coverage = partial, quote = "Metallurgical coal which is suitable for use in the production of steel")
rule ApplicableCriticalMineralMetallurgicalCoal45xcRule(material: Asset) strict {
    effective [@2025-07-04, infinity);
    when metallurgical_coal_suitable_for_steel_production_45xc(material);
    then applicable_critical_mineral_45xc(material);
}

// --- (c)(1): the eligible component and its credit type -----------------------------------------------------------------------------------------

pub relation basis_of_facility_property_taken_into_account_for_48c_after_enactment_45xc(component: Asset) kind empirical {
    label en official "the component is produced at a facility if the basis of any property which is part of the facility is taken into account for the credit under section 48C after the date of the enactment of section 45X (section 45X(c)(1)(B)) — case-asserted";
}
pub relation material_assistance_from_prohibited_foreign_entity_45xc(component: Asset) kind empirical {
    label en official "the component includes material assistance from a prohibited foreign entity (section 7701(a)(52), with the product-sold date 2027-01-01 substituted) (section 45X(c)(1)(C) added by PL 119-21 section 70514(c)(1)) — case-asserted";
}
pub relation eligible_component_class_45xc(component: Asset, kind: EligibleComponentType45x) kind institutional {
    label en official "section 45X(c)(1)(A): the eligible component type (solar, wind, inverter, qualifying battery component, applicable critical mineral) derived from the physical facts of the component";
}
rule EligibleComponentClassSolarModule45xcRule(component: Asset) strict {
    when solar_component_kind_45xc(component, SolarModule);
    when not_known(basis_of_facility_property_taken_into_account_for_48c_after_enactment_45xc(component));
    then eligible_component_class_45xc(component, SolarModule);
}
