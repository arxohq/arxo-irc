    when not_known(material_assistance_from_prohibited_foreign_entity_45xc(component));
    then eligible_component_45xc(component);
}
rule EligibleComponentElectrodeActiveMaterialRule(component: Asset) strict {
    when battery_component_kind_45xc(component, ElectrodeActiveMaterial);
    when not_known(basis_of_facility_property_taken_into_account_for_48c_after_enactment_45xc(component));
    when not_known(material_assistance_from_prohibited_foreign_entity_45xc(component));
    then eligible_component_45xc(component);
}
@source(IRC_S45X_C, relation = formalizes, coverage = exact, quote = "The term \"eligible component\" shall not include any property which is produced at a facility if the basis of any property which is part of such facility is taken into account for purposes of the credit allowed under section 48C after the date of the enactment of this section.")
rule Section48cFacilityExclusionMarker45xcRule(component: Asset) strict {
    when basis_of_facility_property_taken_into_account_for_48c_after_enactment_45xc(component);
    then component_excluded_by_48c_45xc(component);
}
pub relation component_excluded_by_48c_45xc(component: Asset) kind institutional {
    label en official "section 45X(c)(1)(B): the component is produced at a facility whose property basis is taken into account for the section 48C credit";
}

// --- (d): special rules -----------------------------------------------------------------------------------------------------------------------------

pub relation persons_related_45x(a: Person, b: Person, y: TaxableYear) kind institutional {
    label en official "section 45X(d)(1): persons are related if they would be treated as a single employer under the section 52(b) regulations";
}
@source(IRC_S45X_D, relation = formalizes, coverage = partial, quote = "Persons shall be treated as related to each other if such persons would be treated as a single employer under the regulations prescribed under section 52(b).")
rule PersonsRelated45xRule(a: Person, b: Person, y: TaxableYear, group: ControlledGroup) strict {
    when under_common_control_52b(group, a, y);
    when under_common_control_52b(group, b, y);
    then persons_related_45x(a, b, y);
}
pub relation component_produced_in_united_states_or_possession_45x(component: Asset) kind empirical {
    label en official "the production of the eligible component is within the United States (section 638(1)) or a possession of the United States (section 638(2)) (section 45X(d)(2)) — case-asserted external classification";
}
pub relation sale_taken_into_account_45x(component: Asset) kind institutional {
    label en official "section 45X(d)(2): sales are taken into account only for eligible components produced within the United States or a possession";
}
@source(IRC_S45X_D, relation = formalizes, coverage = exact, quote = "Sales shall be taken into account under this section only with respect to eligible components the production of which is within—")
rule SaleTakenIntoAccount45xRule(component: Asset) strict {
    when component_produced_in_united_states_or_possession_45x(component);
    then sale_taken_into_account_45x(component);
}
pub relation component_integrated_into_secondary_component_45x(primary: Asset, secondary: Asset) kind empirical {
    label en official "the primary component is integrated, incorporated or assembled into another eligible component (the secondary component) (section 45X(d)(4)) — case-asserted";
}
pub relation secondary_component_sold_to_unrelated_person_45x(secondary: Asset) kind empirical {
    label en official "the secondary (or, before the PL 119-21 edition, the other eligible) component is sold to an unrelated person — case-asserted";
}
pub relation produced_in_same_manufacturing_facility_45x(primary: Asset, secondary: Asset) kind empirical {
    label en official "the secondary component is produced within the same manufacturing facility as the primary component (section 45X(d)(4)(A)(i), PL 119-21 edition) — case-asserted";
}
pub relation domestic_share_of_direct_material_costs_45x(secondary: Asset, share: Decimal) kind empirical {
    label en official "the share (fraction) of the total direct material costs paid or incurred by the taxpayer to produce the secondary component attributable to primary components mined, produced or manufactured in the United States (section 45X(d)(4)(B), PL 119-21 edition) — case-asserted";
}
pub relation treated_as_sold_to_unrelated_person_45x(primary: Asset) kind institutional {
    label en official "section 45X(d)(4): the component is treated as sold to an unrelated person if it is integrated into another eligible component that is sold to an unrelated person (from taxable years beginning after 2026-12-31: same manufacturing facility and at least 65 percent domestic direct material costs)";
}
@source(IRC_S45X_D, relation = formalizes, coverage = exact, quote = "For purposes of this section, a person shall be treated as having sold an eligible component to an unrelated person if such component is integrated, incorporated, or assembled into another eligible component which is sold to an unrelated person.")
rule TreatedAsSoldToUnrelatedPerson45xBaseRule(primary: Asset, secondary: Asset) strict {
    effective (-infinity, @2027-01-01);
    when component_integrated_into_secondary_component_45x(primary, secondary);
    when secondary_component_sold_to_unrelated_person_45x(secondary);
    then treated_as_sold_to_unrelated_person_45x(primary);
}
@source(us.irc.temporal::PL119_21_S70514, relation = formalizes, coverage = exact, quote = "the secondary component is sold to an unrelated person.")
rule TreatedAsSoldToUnrelatedPerson45xAmendedRule(primary: Asset, secondary: Asset, share: Decimal) strict {
    effective [@2027-01-01, infinity);
    when component_integrated_into_secondary_component_45x(primary, secondary);
    when produced_in_same_manufacturing_facility_45x(primary, secondary);
    when secondary_component_sold_to_unrelated_person_45x(secondary);
    when domestic_share_of_direct_material_costs_45x(secondary, share);
    when share >= 0.65;
    then treated_as_sold_to_unrelated_person_45x(primary);
}
