pub relation eligible_component_45xc(component: Asset) kind institutional {
    label en official "section 45X(c)(1): an eligible component: a solar energy component, a wind energy component, an inverter of (c)(2)(B)-(G), a qualifying battery component or an applicable critical mineral, not produced at a facility with property taken into account for the section 48C credit, and (from the PL 119-21 edition) without material assistance from a prohibited foreign entity";
}
rule EligibleComponentSolarWindInverterBatteryRule(component: Asset, kind: EligibleComponentType45x) strict {
    when eligible_component_class_45xc(component, kind);
    when not_known(material_assistance_from_prohibited_foreign_entity_45xc(component));
    then eligible_component_45xc(component);
}
rule EligibleComponentCriticalMineralRule(component: Asset) strict {
    when applicable_critical_mineral_45xc(component);
    when not_known(basis_of_facility_property_taken_into_account_for_48c_after_enactment_45xc(component));
    when not_known(material_assistance_from_prohibited_foreign_entity_45xc(component));
    then eligible_component_45xc(component);
}
rule EligibleComponentWindVesselRule(component: Asset) strict {
    when wind_component_kind_45xc(component, RelatedOffshoreWindVessel);
