// Section 49 — the credit base of (a)(1)(C), nonrecourse financing and qualified person of (a)(1)(D), the partner and S corporation
// shareholder rules of (a)(1)(E), the (a)(2) refinements and the (b) recapture refinements. Stage 2f (IRC-06, DECISION-0379, TECH_GAP
// reduction of the stage 2c rows of TECH-GAPS G1806). Companion of `49-at-risk-rules-for-investment-credit.law`; its financing rules read the
// items as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the meaning of section 465(b)(3)(C) related person and the determination at the close of the year in which the
// property is placed in service are one case fact per pair; the allocable share of financing follows the partner's asserted share of the
// credit under section 38; sums are over the asserted components.

use self::{
    Asset,
    IRC_S49_A,
    IRC_S49_B,
    Person,
    TaxableYear,
    at_risk_recapture_tax_increase_49,
    credit_base_after_decrease_49,
    net_decrease_of_nonqualified_financing_49,
};

pub enum CreditBaseKind49 {
    RehabilitationExpenditures,
    EnergyProperty,
    AdvancedCoalProject48A,
    GasificationProject48B,
    AdvancedEnergyProject48C,
    AdvancedManufacturing48D,
    QualifiedFacility48E,
    EnergyStorage48E
}

// --- (a)(1)(C): the credit base ---------------------------------------------------------------------------------------------------------------------------------

pub relation credit_base_component_49(taxpayer: Person, prop: Asset, y: TaxableYear, kind: CreditBaseKind49, amount: Money) kind empirical {
    label en official "a component of the credit base of the property: the basis attributable to qualified rehabilitation expenditures, energy property, or property of a section 48A, 48B, 48C, 48D or 48E project (section 49(a)(1)(C)) — case-asserted";
}
pub relation credit_base_defined_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 49(a)(1)(C): the credit base is the sum of the basis of the qualified rehabilitated building attributable to qualified rehabilitation expenditures, energy property, and the property of qualifying section 48A, 48B, 48C, 48D and 48E projects and energy storage technology";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "the term \"credit base\" means")
rule CreditBaseDefined49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, one_kind: CreditBaseKind49, one_amount: Money) strict {
    when credit_base_component_49(taxpayer, prop, y, one_kind, one_amount);
    then credit_base_defined_49(taxpayer, prop, y,
        sum(collect all a: Money, k: CreditBaseKind49 where credit_base_component_49(taxpayer, prop, y, k, a), empty: 0 USD));
}

// --- (a)(1)(D)(iii)-(v): nonrecourse financing, qualified person, related person ---------------------------------------------------------------------

pub relation financing_protected_against_loss_49(item: Asset) kind empirical {
    label en official "the taxpayer is protected against loss with respect to the amount through guarantees, stop-loss agreements, or other similar arrangements (section 49(a)(1)(D)(iii)(I)) — case-asserted";
}
pub relation borrowed_from_person_with_interest_in_activity_49(item: Asset) kind empirical {
    label en official "the amount is borrowed from a person who has an interest (other than as a creditor) in the activity in which the property is used, or from a related person to such a person (section 49(a)(1)(D)(iii)(II)) — case-asserted";
}
pub relation regulations_except_interested_lender_49(item: Asset) kind empirical {
    label en official "the borrowing is excepted by regulations from subclause (II) — case-asserted";
}
pub relation interest_is_only_as_shareholder_of_borrowing_corporation_49(item: Asset) kind empirical {
    label en official "the amount is borrowed by a corporation from a shareholder whose interest is only as a shareholder (section 49(a)(1)(D)(iii), last sentence) — case-asserted";
}
pub relation nonrecourse_financing_includes_49(item: Asset) kind institutional {
    label en official "section 49(a)(1)(D)(iii): nonrecourse financing includes amounts protected against loss through guarantees or stop-loss arrangements and, except by regulation, amounts borrowed from a person interested in the activity (other than as a creditor or, for a corporation, as a shareholder) or from a person related to one";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "any amount with respect to which the taxpayer is protected against loss through guarantees, stop-loss agreements, or other similar arrangements")
rule NonrecourseFinancingProtectedRule(item: Asset) strict {
    when financing_protected_against_loss_49(item);
    then nonrecourse_financing_includes_49(item);
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "any amount borrowed from a person who has an interest (other than as a creditor) in the activity in which the property is used or from a related person to a person (other than the taxpayer) having such an interest")
rule NonrecourseFinancingInterestedLenderRule(item: Asset) strict {
    when borrowed_from_person_with_interest_in_activity_49(item);
    when not_known(regulations_except_interested_lender_49(item));
    when not_known(interest_is_only_as_shareholder_of_borrowing_corporation_49(item));
    then nonrecourse_financing_includes_49(item);
}
pub relation lender_actively_and_regularly_in_business_of_lending_49(lender: Person) kind empirical {
    label en official "the person is actively and regularly engaged in the business of lending money (section 49(a)(1)(D)(iv)) — case-asserted";
}
pub relation lender_related_to_taxpayer_49(lender: Person, taxpayer: Person) kind empirical {
    label en official "the lender is a related person with respect to the taxpayer, determined by section 465(b)(3)(C) (section 49(a)(1)(D)(iv)(I)) — case-asserted";
}
pub relation lender_is_seller_or_related_to_seller_49(lender: Person, prop: Asset) kind empirical {
    label en official "the lender is a person from which the taxpayer acquired the property, or a related person to such person (section 49(a)(1)(D)(iv)(II)) — case-asserted";
}
pub relation lender_receives_fee_on_investment_or_related_49(lender: Person, prop: Asset) kind empirical {
    label en official "the lender is a person who receives a fee with respect to the taxpayer's investment in the property, or a related person to such person (section 49(a)(1)(D)(iv)(III)) — case-asserted";
}
pub relation lender_of_financing_49(lender: Person, taxpayer: Person, prop: Asset) kind empirical {
    label en official "the person lends to the taxpayer with respect to the property — case-asserted";
}
pub relation qualified_person_49(lender: Person, taxpayer: Person, prop: Asset) kind institutional {
    label en official "section 49(a)(1)(D)(iv): a person actively and regularly engaged in the business of lending money that is not a related person, the seller (or related to the seller) or a fee recipient (or related to one)";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "the term \"qualified person\" means any person which is actively and regularly engaged in the business of lending money")
rule QualifiedPerson49Rule(lender: Person, taxpayer: Person, prop: Asset) strict {
    when lender_of_financing_49(lender, taxpayer, prop);
    when lender_actively_and_regularly_in_business_of_lending_49(lender);
    when not_known(lender_related_to_taxpayer_49(lender, taxpayer));
    when not_known(lender_is_seller_or_related_to_seller_49(lender, prop));
    when not_known(lender_receives_fee_on_investment_or_related_49(lender, prop));
    then qualified_person_49(lender, taxpayer, prop);
}
pub relation related_at_close_of_year_property_placed_in_service_49(a: Person, b: Person, y: TaxableYear) kind empirical {
    label en official "the persons are related persons within the meaning of section 465(b)(3)(C), determined as of the close of the taxable year in which the property is placed in service (section 49(a)(1)(D)(v)) — case-asserted";
}
pub relation related_person_by_465_49(a: Person, b: Person, y: TaxableYear) kind institutional {
    label en official "section 49(a)(1)(D)(v): the meaning of related person is that of section 465(b)(3)(C), determined as of the close of the taxable year in which the property is placed in service";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "the determination of whether a person is a related person shall be made as of the close of the taxable year in which the property is placed in service")
rule RelatedPersonBy46549Rule(a: Person, b: Person, y: TaxableYear) strict {
    when related_at_close_of_year_property_placed_in_service_49(a, b, y);
    then related_person_by_465_49(a, b, y);
}

// --- (a)(1)(E): partnerships and S corporations ------------------------------------------------------------------------------------------------------------

pub relation owner_of_entity_49(owner: Person, pt_entity: Person) kind empirical {
    label en official "the partner or S corporation shareholder owns an interest in the partnership or S corporation — case-asserted";
}
pub relation owner_share_of_credit_49(owner: Person, prop: Asset, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the share, as a fraction, in which the partner or shareholder shares the credit allowable by section 38 with respect to the property (section 49(a)(1)(E)(iv)) — case-asserted";
}
pub relation entity_nonqualified_nonrecourse_financing_49(pt_entity: Person, prop: Asset, amount: Money) kind empirical {
    label en official "the amount of financing of the property at the partnership or S corporation level — case-asserted";
}
pub relation allocable_share_of_nonqualified_financing_49(owner: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 49(a)(1)(E)(i), (iv): the determination of whether a partner's or shareholder's allocable share of financing is nonqualified nonrecourse financing is made at the partner or shareholder level, the allocable share following the credit under section 38 (cents HALF_UP)";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "in the case of any partnership or S corporation, the determination of whether a partner's or shareholder's allocable share of any financing is nonqualified nonrecourse financing shall be made at the partner or shareholder level")
rule AllocableShareOfNonqualifiedFinancing49Rule(owner: Person, prop: Asset, y: TaxableYear, pt_entity: Person, amount: Money, share: Decimal) strict {
    when owner_of_entity_49(owner, pt_entity);
    when entity_nonqualified_nonrecourse_financing_49(pt_entity, prop, amount);
    when owner_share_of_credit_49(owner, prop, y, share);
    then allocable_share_of_nonqualified_financing_49(owner, prop, y, round(amount * share, 2, "HALF_UP"));
}
pub relation corporation_uses_property_in_active_trade_or_business_49(corp: Person, prop: Asset) kind empirical {
    label en official "the property is used by the corporation in the active conduct of a trade or business (section 49(a)(1)(E)(iii)(I)) — case-asserted";
}
pub relation corporation_full_time_non_owner_employees_49(corp: Person, y: TaxableYear, count: Decimal) kind empirical {
    label en official "the number of full-time employees who were not owner-employees (section 465(c)(7)(E)(i)), substantially all of whose services were directly related to the trade or business, throughout the 12-month period ending on the last day of the taxable year (section 49(a)(1)(E)(iii)(II)) — case-asserted";
}
pub relation corporation_full_time_management_employees_49(corp: Person, y: TaxableYear, count: Decimal) kind empirical {
    label en official "the number of full-time employees substantially all of whose services were in the active management of the trade or business throughout the 12-month period ending on the last day of the taxable year (section 49(a)(1)(E)(iii)(III)) — case-asserted";
}
pub relation qualified_business_property_49(corp: Person, prop: Asset, y: TaxableYear) kind institutional {
    label en official "section 49(a)(1)(E)(iii): property used by the corporation in the active conduct of a trade or business where the corporation had at least 3 full-time non-owner employees directly related to the business and at least 1 full-time employee in active management for the 12-month period";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "the term \"qualified business property\" means any property if")
rule QualifiedBusinessProperty49Rule(corp: Person, prop: Asset, y: TaxableYear, staff: Decimal, managers: Decimal) strict {
    when corporation_uses_property_in_active_trade_or_business_49(corp, prop);
    when corporation_full_time_non_owner_employees_49(corp, y, staff);
    when staff >= 3.0;
    when corporation_full_time_management_employees_49(corp, y, managers);
    when managers >= 1.0;
    then qualified_business_property_49(corp, prop, y);
}
pub relation financing_by_qualified_person_to_corporation_49(corp: Person, prop: Asset) kind empirical {
    label en official "the financing is provided by a qualified person to the S corporation with respect to the property — case-asserted";
}
pub relation financing_is_recourse_at_corporate_level_49(corp: Person, prop: Asset) kind empirical {
    label en official "the financing is recourse financing, determined at the corporate level (section 49(a)(1)(E)(ii)(I)) — case-asserted";
}
pub relation shareholder_treated_as_liable_for_allocable_share_49(shareholder: Person, corp: Person, prop: Asset, y: TaxableYear) kind institutional {
    label en official "section 49(a)(1)(E)(ii): a shareholder of an S corporation is treated as liable for his allocable share of financing provided by a qualified person if the financing is recourse at the corporate level and provided with respect to qualified business property of the corporation";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "A shareholder of an S corporation shall be treated as liable for his allocable share of any financing provided by a qualified person to such corporation if")
rule ShareholderTreatedAsLiable49Rule(shareholder: Person, corp: Person, prop: Asset, y: TaxableYear) strict {
    when owner_of_entity_49(shareholder, corp);
    when financing_by_qualified_person_to_corporation_49(corp, prop);
    when financing_is_recourse_at_corporate_level_49(corp, prop);
    when qualified_business_property_49(corp, prop, y);
    then shareholder_treated_as_liable_for_allocable_share_49(shareholder, corp, prop, y);
}

// --- (a)(2)(B)-(C): the credit base increase --------------------------------------------------------------------------------------------------------------

pub relation decrease_through_surrender_of_financed_property_49(prop: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the decrease in nonqualified nonrecourse financing that arises through the surrender or other use of the property financed by it (section 49(a)(2)(B)) — case-asserted";
}
pub relation counted_net_decrease_of_nonqualified_financing_49(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 49(a)(2)(B): nonqualified nonrecourse financing is not treated as decreased through the surrender or other use of the property financed by it";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "nonqualified nonrecourse financing shall not be treated as decreased through the surrender or other use of property financed by nonqualified nonrecourse financing")
rule CountedNetDecreaseOfNonqualifiedFinancing49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, decrease: Money, surrendered: Money) strict {
    when net_decrease_of_nonqualified_financing_49(taxpayer, prop, y, decrease);
    when decrease_through_surrender_of_financed_property_49(prop, y, surrendered);
    then counted_net_decrease_of_nonqualified_financing_49(taxpayer, prop, y, max(decrease - surrendered, 0 USD));
}
pub relation property_first_placed_in_service_in_year_49(prop: Asset, first_year: TaxableYear) kind empirical {
    label en official "the taxable year in which the property referred to in subparagraph (A) was first placed in service (section 49(a)(2)(C)(i)) — case-asserted";
}
pub relation credit_base_increase_treated_as_placed_in_service_49(taxpayer: Person, prop: Asset, first_year: TaxableYear, amount: Money) kind institutional {
    label en official "section 49(a)(2)(C)(i): an increase in the credit base is taken into account for the section 38 credit and the section 50(a) rules as if it were property placed in service in the taxable year in which the property was first placed in service";
}
@source(IRC_S49_A, relation = formalizes, coverage = exact, quote = "any increase in a taxpayer's credit base for any property by reason of this paragraph shall be taken into account as if it were property placed in service by the taxpayer in the taxable year in which the property referred to in subparagraph (A) was first placed in service")
rule CreditBaseIncreaseTreatedAsPlacedInService49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money, first_year: TaxableYear) defeasible {
    when credit_base_after_decrease_49(taxpayer, prop, y, amount);
    when property_first_placed_in_service_in_year_49(prop, first_year);
    then credit_base_increase_treated_as_placed_in_service_49(taxpayer, prop, first_year, amount);
}

// --- (b)(2), (b)(4): recapture refinements -------------------------------------------------------------------------------------------------------------------

pub relation evidence_of_indebtedness_incurred_on_49(item: Asset, on: Date) kind empirical {
    label en official "the date the indebtedness was incurred (section 49(b)(2)) — case-asserted";
}
pub relation evidence_of_indebtedness_transferred_or_agreed_on_49(item: Asset, on: Date) kind empirical {
    label en official "the date the evidence of the indebtedness is transferred, or an agreement to transfer it is entered into (section 49(b)(2)) — case-asserted";
}
pub relation transfer_counts_toward_increase_in_financing_49(item: Asset) kind institutional {
    label en official "section 49(b)(2): the amount of nonqualified nonrecourse financing is not treated as increased by a transfer of, or agreement to transfer, evidence of indebtedness that occurs more than 1 year after the indebtedness was incurred";
}
@source(IRC_S49_B, relation = formalizes, coverage = exact, quote = "if such transfer occurs (or such agreement is entered into) more than 1 year after the date such indebtedness was incurred")
rule TransferCountsTowardIncreaseInFinancing49Rule(item: Asset, incurred: Date, transferred: Date) strict {
    when evidence_of_indebtedness_incurred_on_49(item, incurred);
    when evidence_of_indebtedness_transferred_or_agreed_on_49(item, transferred);
    when transferred <= add_calendar_period(incurred, 12 calendar_month);
    then transfer_counts_toward_increase_in_financing_49(item);
}
pub relation recapture_increase_excluded_from_tax_for_credits_49(taxpayer: Person, prop: Asset, y: TaxableYear) kind institutional {
    label en official "section 49(b)(4): an increase in tax under paragraph (1) is not treated as tax imposed by this chapter for determining the amount of any credit allowable under this chapter";
}
@source(IRC_S49_B, relation = formalizes, coverage = exact, quote = "Any increase in tax under paragraph (1) shall not be treated as tax imposed by this chapter for purposes of determining the amount of any credit allowable under this chapter.")
rule RecaptureIncreaseExcludedFromTaxForCredits49Rule(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) defeasible {
    when at_risk_recapture_tax_increase_49(taxpayer, prop, y, amount);
    then recapture_increase_excluded_from_tax_for_credits_49(taxpayer, prop, y);
}
