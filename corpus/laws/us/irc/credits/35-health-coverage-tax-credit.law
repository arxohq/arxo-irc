// Section 35 — Health insurance costs of eligible individuals (the health coverage tax credit; the credit expired:
// an eligible coverage month must begin more than 90 days after the enactment of the Trade Act of 2002 and before
// 2022-01-01). Stage 2e (IRC-06, DECISION-0379, TECH_GAP reduction).
//
// Scope / judgment calls:
// * A month is keyed by its first day (a Date). Every "as of the first day of the month" test is a fact keyed by that
//   date. The Trade Act of 2002 was enacted on 2002-08-06 (Pub. L. 107-210, pinned in the section 35 statutory
//   note); "more than 90 days after" is read as a month starting after 2002-08-06 plus 90 days (2002-11-04).
// * (c)(2)(B) applies to months beginning after "the date of the enactment of this paragraph"; that date is not
//   pinned in the statutory notes of this corpus, so it is the case fact `c2b_enactment_date_35` (SOURCE_GAP note in
//   the coverage row); (c)(2)(A) applies to months beginning on or before it.
// * The credit is 72.5 percent of the premiums treated as paid for the year's eligible coverage months for which the
//   election of (g)(11) is made, less advance payments under section 7527 ((g)(1)); the sum of the monthly amounts is
//   multiplied once (cents HALF_UP, JUDGMENT CALL) and never rounded per month.
// * The election of (g)(11) is a power; its effect is read by strict consumers through the positive fact.
// * "Rules similar to the rules of section 21(e)(3) and (4)" ((g)(6)) and of section 213(d)(6) ((g)(7)) are
//   analogical incorporations of other sections (TECH-GAPS G3805).
// * The private-plan facts of (e)(2)(A)(i)-(iv) ("substantially similar" benefits, guaranteed enrollment) are case
//   facts (evaluative for the "similar" comparison, DECISION-0194).

use self::{
    Asset,
    IRC_S35_A,
    IRC_S35_B,
    IRC_S35_C,
    IRC_S35_D,
    IRC_S35_E,
    IRC_S35_F,
    IRC_S35_G,
    Individual,
    TaxableYear,
    considered_married_at_close_of_year_35g6,
    legally_separated_under_decree_35g6,
};

pub enum HealthInsuranceKind35 {
    CobraContinuation;
    StateContinuation;
    StateHighRiskPool;
    StateEmployeePlan;
    StateComparablePlan;
    StateArrangementWithPlanIssuerAdministratorOrEmployer;
    StatePurchasingPool;
    StateOperatedPlanWithoutFederalFinancialParticipation;
    SpouseEmployerGroupPlan;
    IndividualHealthInsurance;
    BankruptcyVebaPlan;
}

pub relation coverage_kind_35(coverage: Asset, kind: HealthInsuranceKind35) kind empirical {
    label en official "the health coverage is of this kind of section 35(e)(1)(A)-(K) — case-asserted";
}
pub relation spouse_of_35(person: Individual, spouse: Individual) kind empirical {
    label en official "the spouse of the person — case-asserted";
}
relation is_married_35(person: Individual) kind institutional;
rule IsMarried35Rule(person: Individual, spouse: Individual) strict {
    when spouse_of_35(person, spouse);
    when not_known(legally_separated_under_decree_35g6(person));
    then is_married_35(person);
}

// --- (e): qualified health insurance ---------------------------------------------------------------------------------------------------------

pub relation state_elected_treatment_as_qualified_35(coverage: Asset) kind empirical {
    label en official "the State has elected to have the coverage treated as qualified health insurance under this section (section 35(e)(2)(A)) — case-asserted";
}
pub relation guaranteed_enrollment_for_qualifying_individuals_35(coverage: Asset) kind empirical {
    label en official "each qualifying individual is guaranteed enrollment on paying the premium (or supplying a section 7527 certificate and paying the remainder) (section 35(e)(2)(A)(i)) — case-asserted";
}
pub relation no_pre_existing_condition_limitation_35(coverage: Asset) kind empirical {
    label en official "no pre-existing condition limitations are imposed on any qualifying individual (section 35(e)(2)(A)(ii)) — case-asserted";
}
pub relation premium_not_greater_than_for_similarly_situated_35(coverage: Asset) kind empirical {
    label en official "the total premium (without regard to subsidies) for a qualifying individual is not greater than for a similarly situated individual who is not a qualifying individual (section 35(e)(2)(A)(iii)) — case-asserted";
}
pub relation benefits_same_or_substantially_similar_35(coverage: Asset) kind empirical {
    label en official "the benefits are the same as (or substantially similar to) those for similarly situated individuals who are not qualifying individuals (section 35(e)(2)(A)(iv)) — evaluative comparison (DECISION-0194), case-asserted";
}
pub relation coverage_is_flexible_spending_or_similar_arrangement_35(coverage: Asset) kind empirical {
    label en official "the coverage is a flexible spending or similar arrangement (section 35(e)(3)(A)) — case-asserted";
}
pub relation coverage_substantially_all_excepted_benefits_35(coverage: Asset) kind empirical {
    label en official "substantially all of the coverage is of excepted benefits described in section 9832(c) (section 35(e)(3)(B)) — case-asserted";
}
pub relation coverage_enrolled_through_exchange_35(coverage: Asset) kind empirical {
    label en official "the coverage was enrolled in through an Exchange established under the Patient Protection and Affordable Care Act (section 35(e)(1)(J)) — case-asserted";
}
pub relation coverage_is_federal_or_state_based_health_insurance_35(coverage: Asset) kind empirical {
    label en official "the insurance is Federal- or State-based health insurance coverage, which individual health insurance excludes (section 35(e)(1)(J)) — case-asserted";
}
relation kind_needs_state_election_35(kind: HealthInsuranceKind35) kind institutional;
assert "35-kind-b": kind_needs_state_election_35(StateContinuation);
assert "35-kind-c": kind_needs_state_election_35(StateHighRiskPool);
assert "35-kind-d": kind_needs_state_election_35(StateEmployeePlan);
assert "35-kind-e": kind_needs_state_election_35(StateComparablePlan);
assert "35-kind-f": kind_needs_state_election_35(StateArrangementWithPlanIssuerAdministratorOrEmployer);
assert "35-kind-g": kind_needs_state_election_35(StatePurchasingPool);
assert "35-kind-h": kind_needs_state_election_35(StateOperatedPlanWithoutFederalFinancialParticipation);
pub relation qualified_health_insurance_35(coverage: Asset) kind institutional {
    label en official "section 35(e): coverage described in (e)(1)(A)-(K) (the State coverages of (B)-(H) only with the State election and the four (e)(2)(A) requirements), not a flexible spending arrangement or substantially all excepted benefits";
}
@source(IRC_S35_E, relation = formalizes, coverage = partial, quote = "(A) Coverage under a COBRA continuation provision (as defined in section 9832(d)(1)).")
rule QualifiedInsuranceCobraRule(coverage: Asset) strict {
    when coverage_kind_35(coverage, CobraContinuation);
    when not_known(coverage_is_flexible_spending_or_similar_arrangement_35(coverage));
    when not_known(coverage_substantially_all_excepted_benefits_35(coverage));
    then qualified_health_insurance_35(coverage);
}
rule QualifiedInsuranceSpouseGroupRule(coverage: Asset) strict {
    when coverage_kind_35(coverage, SpouseEmployerGroupPlan);
    when not_known(coverage_is_flexible_spending_or_similar_arrangement_35(coverage));
    when not_known(coverage_substantially_all_excepted_benefits_35(coverage));
    then qualified_health_insurance_35(coverage);
}
rule QualifiedInsuranceBankruptcyVebaRule(coverage: Asset) strict {
    when coverage_kind_35(coverage, BankruptcyVebaPlan);
    when not_known(coverage_is_flexible_spending_or_similar_arrangement_35(coverage));
    when not_known(coverage_substantially_all_excepted_benefits_35(coverage));
    then qualified_health_insurance_35(coverage);
}
@source(IRC_S35_E, relation = formalizes, coverage = partial, quote = "(J) In the case of any eligible individual and such individual's qualifying family members, coverage under individual health insurance (other than coverage enrolled in through an Exchange established under the Patient Protection and Affordable Care Act).")
rule QualifiedInsuranceIndividualRule(coverage: Asset) strict {
    when coverage_kind_35(coverage, IndividualHealthInsurance);
    when not_known(coverage_enrolled_through_exchange_35(coverage));
    when not_known(coverage_is_federal_or_state_based_health_insurance_35(coverage));
    when not_known(coverage_is_flexible_spending_or_similar_arrangement_35(coverage));
    when not_known(coverage_substantially_all_excepted_benefits_35(coverage));
    then qualified_health_insurance_35(coverage);
}
@source(IRC_S35_E, relation = formalizes, coverage = exact, quote = "The term \"qualified health insurance\" does not include any coverage described in subparagraphs (B) through (H) of paragraph (1) unless the State involved has elected to have such coverage treated as qualified health insurance under this section and such coverage meets the following requirements:")
rule QualifiedInsuranceStateCoverageRule(coverage: Asset, kind: HealthInsuranceKind35) strict {
    when coverage_kind_35(coverage, kind);
    when kind_needs_state_election_35(kind);
    when state_elected_treatment_as_qualified_35(coverage);
    when guaranteed_enrollment_for_qualifying_individuals_35(coverage);
    when no_pre_existing_condition_limitation_35(coverage);
    when premium_not_greater_than_for_similarly_situated_35(coverage);
    when benefits_same_or_substantially_similar_35(coverage);
    when not_known(coverage_is_flexible_spending_or_similar_arrangement_35(coverage));
    when not_known(coverage_substantially_all_excepted_benefits_35(coverage));
    then qualified_health_insurance_35(coverage);
}

// --- (c): eligible individuals ----------------------------------------------------------------------------------------------------------------------------

pub relation c2b_enactment_date_35(on: Date) kind empirical {
    label en official "the date of the enactment of section 35(c)(2)(B) — not pinned in the statutory notes of this corpus (SOURCE_GAP), case-asserted";
}
pub relation receives_tra_for_a_day_of_month_35(person: Individual, month: Date) kind empirical {
    label en official "the individual receives for any day of the month a trade readjustment allowance under chapter 2 of title II of the Trade Act of 1974 (section 35(c)(2)) — case-asserted";
}
pub relation would_be_eligible_for_tra_disregarding_231a3b_35(person: Individual, month: Date) kind empirical {
    label en official "the individual would be eligible for the allowance if section 231 of the Trade Act were applied without regard to subsection (a)(3)(B) (section 35(c)(2)(A)) — case-asserted";
}
pub relation in_tra_break_in_training_within_233a_period_35(person: Individual, month: Date) kind empirical {
    label en official "the individual would be eligible except that they are in a break in training under a section 236 program exceeding the period of section 233(e) but within the period of section 233(a) (section 35(c)(2)(B)(ii)) — case-asserted";
}
pub relation receives_unemployment_compensation_and_would_be_tra_eligible_35(person: Individual, month: Date) kind empirical {
    label en official "the individual receives unemployment compensation (section 85(b)) for any day of the month and would be eligible for the allowance for the month if section 231 were applied without regard to subsections (a)(3)(B) and (a)(5) (section 35(c)(2)(B)(iii)) — case-asserted";
}
pub relation first_month_would_otherwise_cease_as_tra_recipient_35(person: Individual, month: Date) kind empirical {
    label en official "this is the first month in which the individual would otherwise cease to be an eligible TAA recipient (section 35(c)(2), last sentence) — case-asserted";
}
pub relation participates_in_246_program_and_receives_benefit_35(person: Individual, month: Date) kind empirical {
    label en official "a worker described in section 246(a)(3)(B) of the Trade Act participating in the program of section 246(a)(1) and receiving a benefit for the month under section 246(a)(2) (section 35(c)(3)) — case-asserted";
}
pub relation first_month_would_otherwise_cease_as_alternative_taa_recipient_35(person: Individual, month: Date) kind empirical {
    label en official "this is the first month in which the individual would otherwise cease to be an eligible alternative TAA recipient (section 35(c)(3), last sentence) — case-asserted";
}
pub relation age_on_first_day_of_month_35(person: Individual, month: Date, years: Decimal) kind empirical {
    label en official "the age in years of the individual on the first day of the month (section 35(c)(4)(A)) — case-asserted";
}
pub relation receives_pbgc_benefit_for_month_35(person: Individual, month: Date) kind empirical {
    label en official "the individual is receiving a benefit for the month any portion of which is paid by the Pension Benefit Guaranty Corporation under title IV of ERISA (section 35(c)(4)(B)) — case-asserted";
}
pub relation eligible_taa_recipient_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(c)(2): an eligible TAA recipient for the month (the definition before or after the enactment of paragraph (2)(B))";
}
@source(IRC_S35_C, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraph (B), the term \"eligible TAA recipient\" means, with respect to any month, any individual who is receiving for any day of such month a trade readjustment allowance under chapter 2 of title II of the Trade Act of 1974 or who would be eligible to receive such allowance if section 231 of such Act were applied without regard to subsection (a)(3)(B) of such section.")
rule EligibleTaaRecipientReceivingRule(person: Individual, month: Date, on: Date) strict {
    when receives_tra_for_a_day_of_month_35(person, month);
    when c2b_enactment_date_35(on);
    when month <= on;
    then eligible_taa_recipient_35(person, month);
}
rule EligibleTaaRecipientWouldBeEligibleRule(person: Individual, month: Date, on: Date) strict {
    when would_be_eligible_for_tra_disregarding_231a3b_35(person, month);
    when c2b_enactment_date_35(on);
    when month <= on;
    then eligible_taa_recipient_35(person, month);
}
@source(IRC_S35_C, relation = formalizes, coverage = partial, quote = "In the case of any eligible coverage month beginning after the date of the enactment of this paragraph, the term \"eligible TAA recipient\" means, with respect to any month, any individual who—")
rule EligibleTaaRecipientAfterReceivingRule(person: Individual, month: Date, on: Date) strict {
    when receives_tra_for_a_day_of_month_35(person, month);
    when c2b_enactment_date_35(on);
    when month > on;
    then eligible_taa_recipient_35(person, month);
}
rule EligibleTaaRecipientAfterBreakInTrainingRule(person: Individual, month: Date, on: Date) strict {
    when in_tra_break_in_training_within_233a_period_35(person, month);
    when c2b_enactment_date_35(on);
    when month > on;
    then eligible_taa_recipient_35(person, month);
}
rule EligibleTaaRecipientAfterUnemploymentRule(person: Individual, month: Date, on: Date) strict {
    when receives_unemployment_compensation_and_would_be_tra_eligible_35(person, month);
    when c2b_enactment_date_35(on);
    when month > on;
    then eligible_taa_recipient_35(person, month);
}
rule EligibleTaaRecipientContinuesRule(person: Individual, month: Date) strict {
    when first_month_would_otherwise_cease_as_tra_recipient_35(person, month);
    then eligible_taa_recipient_35(person, month);
}
pub relation eligible_alternative_taa_recipient_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(c)(3): an eligible alternative TAA recipient for the month";
}
@source(IRC_S35_C, relation = formalizes, coverage = exact, quote = "The term \"eligible alternative TAA recipient\" means, with respect to any month, any individual who—")
rule EligibleAlternativeTaaRecipientRule(person: Individual, month: Date) strict {
    when participates_in_246_program_and_receives_benefit_35(person, month);
    then eligible_alternative_taa_recipient_35(person, month);
}
rule EligibleAlternativeTaaRecipientContinuesRule(person: Individual, month: Date) strict {
    when first_month_would_otherwise_cease_as_alternative_taa_recipient_35(person, month);
    then eligible_alternative_taa_recipient_35(person, month);
}
pub relation eligible_pbgc_pension_recipient_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(c)(4): an individual aged 55 as of the first day of the month who receives a PBGC-paid benefit for the month";
}
@source(IRC_S35_C, relation = formalizes, coverage = exact, quote = "(A) has attained age 55 as of the first day of such month, and")
rule EligiblePbgcPensionRecipientRule(person: Individual, month: Date, years: Decimal) strict {
    when age_on_first_day_of_month_35(person, month, years);
    when years >= 55.0;
    when receives_pbgc_benefit_for_month_35(person, month);
    then eligible_pbgc_pension_recipient_35(person, month);
}
pub relation divorce_finalized_on_35(person: Individual, former_spouse: Individual, on: Date) kind empirical {
    label en official "the date of the finalization of the divorce between the eligible individual and the spouse (section 35(g)(10)(B)) — case-asserted";
}
pub relation death_of_eligible_individual_on_35(decedent: Individual, on: Date) kind empirical {
    label en official "the date of the death of the eligible individual (section 35(g)(10)(C)) — case-asserted";
}
pub relation eligible_individual_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(c)(1): an eligible TAA recipient, an eligible alternative TAA recipient or an eligible PBGC pension recipient; and the (g)(10)(B)-(C) extensions after divorce or death";
}
rule EligibleIndividualTaaRule(person: Individual, month: Date) strict {
    when eligible_taa_recipient_35(person, month);
    then eligible_individual_35(person, month);
}
rule EligibleIndividualAlternativeTaaRule(person: Individual, month: Date) strict {
    when eligible_alternative_taa_recipient_35(person, month);
    then eligible_individual_35(person, month);
}
rule EligibleIndividualPbgcRule(person: Individual, month: Date) strict {
    when eligible_pbgc_pension_recipient_35(person, month);
    then eligible_individual_35(person, month);
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "In the case of the finalization of a divorce between an eligible individual and such individual's spouse, such spouse shall be treated as an eligible individual for purposes of this section and section 7527 for a period of 24 months beginning with the date of such finalization")
rule EligibleIndividualAfterDivorceRule(person: Individual, month: Date, former: Individual, on: Date) strict {
    when divorce_finalized_on_35(former, person, on);
    when covered_by_qualified_insurance_premium_paid_by_taxpayer_35(person, month, _);
    when month >= on;
    when month < add_calendar_period(on, 24 calendar_month);
    then eligible_individual_35(person, month);
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "(i) any spouse of such individual (determined at the time of such death) shall be treated as an eligible individual for purposes of this section and section 7527 for a period of 24 months beginning with the date of such death")
rule EligibleIndividualSpouseAfterDeathRule(person: Individual, month: Date, decedent: Individual, on: Date) strict {
    when death_of_eligible_individual_on_35(decedent, on);
    when spouse_of_35(decedent, person);
    when covered_by_qualified_insurance_premium_paid_by_taxpayer_35(person, month, _);
    when month >= on;
    when month < add_calendar_period(on, 24 calendar_month);
    then eligible_individual_35(person, month);
}
pub relation was_qualifying_family_member_immediately_before_event_35(person: Individual, family_member: Individual) kind empirical {
    label en official "the individual was a qualifying family member of the person immediately before the divorce or death (section 35(g)(10)(B), (C)) — case-asserted";
}
rule EligibleIndividualFamilyAfterDeathRule(person: Individual, month: Date, decedent: Individual, on: Date) strict {
    when death_of_eligible_individual_on_35(decedent, on);
    when was_qualifying_family_member_immediately_before_event_35(decedent, person);
    when covered_by_qualified_insurance_premium_paid_by_taxpayer_35(person, month, _);
    when month >= on;
    when month < add_calendar_period(on, 24 calendar_month);
    then eligible_individual_35(person, month);
}

// --- (f): other specified coverage ------------------------------------------------------------------------------------------------------------------------

pub relation covered_under_employer_health_plan_35(person: Individual, month: Date) kind empirical {
    label en official "as of the first day of the month the individual is covered under insurance which constitutes medical care (other than substantially all excepted benefits) under a health plan maintained by an employer (or former employer) of the taxpayer or the spouse (section 35(f)(1)(A)) — case-asserted";
}
pub relation employer_paid_or_incurred_share_of_coverage_cost_35(person: Individual, month: Date, share: Decimal) kind empirical {
    label en official "the share of the cost of coverage (determined under section 4980B) paid or incurred by the employer (or former employer) — case-asserted, without the cafeteria-plan amounts";
}
pub relation cafeteria_in_lieu_share_of_coverage_cost_35(person: Individual, month: Date, share: Decimal) kind empirical {
    label en official "the share of the cost of coverage that is in lieu of a right to receive cash or other qualified benefits under a cafeteria plan (section 125(d)), treated as paid by the employer (section 35(f)(1)(C)) — case-asserted";
}
relation employer_share_including_cafeteria_35(person: Individual, month: Date, share: Decimal) kind institutional;
rule EmployerShareWithCafeteriaRule(person: Individual, month: Date, share: Decimal, in_lieu: Decimal) strict {
    when employer_paid_or_incurred_share_of_coverage_cost_35(person, month, share);
    when cafeteria_in_lieu_share_of_coverage_cost_35(person, month, in_lieu);
    then employer_share_including_cafeteria_35(person, month, share + in_lieu);
}
relation cafeteria_share_asserted_35(person: Individual, month: Date) kind institutional;
rule CafeteriaShareAssertedRule(person: Individual, month: Date, share: Decimal) strict {
    when cafeteria_in_lieu_share_of_coverage_cost_35(person, month, share);
    then cafeteria_share_asserted_35(person, month);
}
rule EmployerShareWithoutCafeteriaRule(person: Individual, month: Date, share: Decimal) strict {
    when employer_paid_or_incurred_share_of_coverage_cost_35(person, month, share);
    when not_known(cafeteria_share_asserted_35(person, month));
    then employer_share_including_cafeteria_35(person, month, share);
}
pub relation eligible_for_qualified_insurance_with_employer_share_35(person: Individual, month: Date, coverage: Asset) kind empirical {
    label en official "the eligible alternative TAA recipient is eligible for coverage under the qualified health insurance (other than that described in (e)(1)(A), (B) or (F)) — case-asserted (section 35(f)(1)(B)(i))";
}
pub relation covered_under_qualified_insurance_with_employer_share_35(person: Individual, month: Date, coverage: Asset) kind empirical {
    label en official "the eligible alternative TAA recipient is covered under such qualified health insurance under which any portion of the cost of coverage is paid or incurred by an employer (or former employer) of the taxpayer or the spouse (section 35(f)(1)(B)(ii)) — case-asserted";
}
pub relation entitled_to_medicare_part_a_or_enrolled_in_part_b_35(person: Individual, month: Date) kind empirical {
    label en official "as of the first day of the month the individual is entitled to benefits under part A of title XVIII of the Social Security Act or enrolled under part B (section 35(f)(2)(A)) — case-asserted";
}
pub relation enrolled_in_medicaid_or_chip_35(person: Individual, month: Date) kind empirical {
    label en official "the individual is enrolled in the program under title XIX or XXI of the Social Security Act (other than under section 1928) (section 35(f)(2)(B)) — case-asserted";
}
pub relation enrolled_in_fehbp_or_entitled_to_military_benefits_35(person: Individual, month: Date) kind empirical {
    label en official "the individual is enrolled in a health benefits plan under chapter 89 of title 5, United States Code, or entitled to benefits under chapter 55 of title 10 (section 35(f)(3)) — case-asserted";
}
pub relation other_specified_coverage_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(f): as of the first day of the month the individual has employer-paid coverage (50 percent or more of the cost), or is entitled to Medicare, enrolled in Medicaid/CHIP, FEHBP or military coverage, or (for an alternative TAA recipient) has the (B) coverage";
}
@source(IRC_S35_F, relation = formalizes, coverage = exact, quote = "Such individual is covered under any insurance which constitutes medical care (except insurance substantially all of the coverage of which is of excepted benefits described in section 9832(c)) under any health plan maintained by any employer (or former employer) of the taxpayer or the taxpayer's spouse and at least 50 percent of the cost of such coverage (determined under section 4980B) is paid or incurred by the employer.")
rule OtherSpecifiedCoverageEmployerRule(person: Individual, month: Date, share: Decimal) strict {
    when covered_under_employer_health_plan_35(person, month);
    when employer_share_including_cafeteria_35(person, month, share);
    when share >= 0.50;
    then other_specified_coverage_35(person, month);
}
rule OtherSpecifiedCoverageAlternativeEligibleRule(person: Individual, month: Date, coverage: Asset, share: Decimal) strict {
    when eligible_alternative_taa_recipient_35(person, month);
    when eligible_for_qualified_insurance_with_employer_share_35(person, month, coverage);
    when qualified_health_insurance_35(coverage);
    when employer_share_including_cafeteria_35(person, month, share);
    when share >= 0.50;
    then other_specified_coverage_35(person, month);
}
rule OtherSpecifiedCoverageAlternativeCoveredRule(person: Individual, month: Date, coverage: Asset, share: Decimal) strict {
    when eligible_alternative_taa_recipient_35(person, month);
    when covered_under_qualified_insurance_with_employer_share_35(person, month, coverage);
    when qualified_health_insurance_35(coverage);
    when employer_share_including_cafeteria_35(person, month, share);
    when share > 0.0;
    then other_specified_coverage_35(person, month);
}
@source(IRC_S35_F, relation = formalizes, coverage = exact, quote = "(A) is entitled to benefits under part A of title XVIII of the Social Security Act or is enrolled under part B of such title, or")
rule OtherSpecifiedCoverageMedicareRule(person: Individual, month: Date) strict {
    when entitled_to_medicare_part_a_or_enrolled_in_part_b_35(person, month);
    then other_specified_coverage_35(person, month);
}
rule OtherSpecifiedCoverageMedicaidRule(person: Individual, month: Date) strict {
    when enrolled_in_medicaid_or_chip_35(person, month);
    then other_specified_coverage_35(person, month);
}
@source(IRC_S35_F, relation = formalizes, coverage = exact, quote = "(A) is enrolled in a health benefits plan under chapter 89 of title 5, United States Code, or")
rule OtherSpecifiedCoverageFederalRule(person: Individual, month: Date) strict {
    when enrolled_in_fehbp_or_entitled_to_military_benefits_35(person, month);
    then other_specified_coverage_35(person, month);
}

// --- (d): qualifying family members --------------------------------------------------------------------------------------------------------------------

pub relation entitled_to_151c_deduction_for_dependent_35(taxpayer: Individual, dependent: Individual) kind empirical {
    label en official "the taxpayer is entitled to a deduction under section 151(c) for the dependent (section 35(d)(1)(B)) — case-asserted";
}
pub relation section_152e_applies_taxpayer_noncustodial_parent_35(taxpayer: Individual, child: Individual) kind empirical {
    label en official "section 152(e) applies to the child for the calendar year and the taxpayer is the noncustodial parent (section 35(d)(2)) — case-asserted";
}
pub relation files_separate_return_35(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer files a separate return for the taxable year (section 35(g)(5)(C)) — case-asserted";
}
pub relation married_at_close_of_year_35(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer is married at the close of the taxable year (section 35(g)(5)(A)) — case-asserted";
}
pub relation month_in_taxable_year_of_35(taxpayer: Individual, month: Date, y: TaxableYear) kind institutional {
    label en official "the month begins in the taxable year of the taxpayer";
}
rule MonthInTaxableYearOfRule(taxpayer: Individual, month: Date, y: TaxableYear, begin: Date, finish: Date) strict {
    when eligible_individual_35(taxpayer, month);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when month >= begin;
    when month <= finish;
    then month_in_taxable_year_of_35(taxpayer, month, y);
}
relation spouse_excluded_by_g5_35(taxpayer: Individual, spouse: Individual, y: TaxableYear) kind institutional;
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "The spouse of the taxpayer shall not be treated as a qualifying family member for purposes of subsection (a), if—")
rule SpouseExcludedByG5Rule(taxpayer: Individual, spouse: Individual, y: TaxableYear, m1: Date, m2: Date) strict {
    when spouse_of_35(taxpayer, spouse);
    when considered_married_at_close_of_year_35g6(taxpayer, y);
    when eligible_individual_35(taxpayer, m1);
    when eligible_individual_35(spouse, m2);
    when month_in_taxable_year_of_35(taxpayer, m1, y);
    when month_in_taxable_year_of_35(spouse, m2, y);
    when files_separate_return_35(taxpayer, y);
    then spouse_excluded_by_g5_35(taxpayer, spouse, y);
}
pub relation qualifying_family_member_35(taxpayer: Individual, person: Individual, month: Date) kind institutional {
    label en official "section 35(d)(1)-(2): the taxpayer's spouse (unless (g)(5) applies) and any dependent for whom the taxpayer is entitled to a section 151(c) deduction (the custodial parent under section 152(e)); not an individual with other specified coverage; after a divorce or death only those who were qualifying family members immediately before ((g)(10))";
}
@source(IRC_S35_D, relation = formalizes, coverage = exact, quote = "(A) the taxpayer's spouse, and")
rule QualifyingFamilySpouseRule(taxpayer: Individual, person: Individual, month: Date, y: TaxableYear) strict {
    when spouse_of_35(taxpayer, person);
    when month_in_taxable_year_of_35(taxpayer, month, y);
    when not_known(spouse_excluded_by_g5_35(taxpayer, person, y));
    when not_known(other_specified_coverage_35(person, month));
    then qualifying_family_member_35(taxpayer, person, month);
}
@source(IRC_S35_D, relation = formalizes, coverage = exact, quote = "(B) any dependent of the taxpayer with respect to whom the taxpayer is entitled to a deduction under section 151(c).")
rule QualifyingFamilyDependentRule(taxpayer: Individual, person: Individual, month: Date) strict {
    when entitled_to_151c_deduction_for_dependent_35(taxpayer, person);
    when eligible_individual_35(taxpayer, month);
    when not_known(section_152e_applies_taxpayer_noncustodial_parent_35(taxpayer, person));
    when not_known(other_specified_coverage_35(person, month));
    then qualifying_family_member_35(taxpayer, person, month);
}

// --- (b): the eligible coverage month ---------------------------------------------------------------------------------------------------------------------

pub relation premium_paid_for_person_35(taxpayer: Individual, person: Individual, month: Date, amount: Money) kind empirical {
    label en official "the amount paid by the taxpayer for the month for the coverage of this person (the taxpayer or a family member) under qualified health insurance, excluding payments by the Secretary and amounts funded by Archer MSA or HSA distributions — case-asserted";
}
pub relation covered_by_qualified_insurance_premium_paid_by_taxpayer_35(taxpayer: Individual, month: Date, coverage: Asset) kind empirical {
    label en official "as of the first day of the month the taxpayer is covered by the coverage, the premium for which is paid by the taxpayer (section 35(b)(1)(A)(ii)) — case-asserted";
}
pub relation imprisoned_under_authority_35(person: Individual, month: Date) kind empirical {
    label en official "as of the first day of the month the individual is imprisoned under Federal, State or local authority (section 35(b)(1)(A)(iv)) — case-asserted";
}
pub relation month_meets_b1a_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(b)(1)(A): as of the first day of the month the individual is an eligible individual, covered by qualified health insurance the premium for which is paid by the taxpayer, has no other specified coverage and is not imprisoned";
}
@source(IRC_S35_B, relation = formalizes, coverage = exact, quote = "(A) as of the first day of such month, the taxpayer—")
rule MonthMeetsB1aRule(person: Individual, month: Date, coverage: Asset) strict {
    when eligible_individual_35(person, month);
    when covered_by_qualified_insurance_premium_paid_by_taxpayer_35(person, month, coverage);
    when qualified_health_insurance_35(coverage);
    when not_known(other_specified_coverage_35(person, month));
    when not_known(imprisoned_under_authority_35(person, month));
    then month_meets_b1a_35(person, month);
}
pub relation month_within_credit_window_35(month: Date) kind institutional {
    label en official "section 35(b)(1)(B): the month begins more than 90 days after the enactment of the Trade Act of 2002 (2002-08-06) and before January 1, 2022";
}
@source(IRC_S35_B, relation = formalizes, coverage = exact, quote = "(B) such month begins more than 90 days after the date of the enactment of the Trade Act of 2002, and before January 1, 2022.")
rule MonthWithinCreditWindowRule(month: Date) strict {
    when eligible_individual_35(_, month);
    when month > add_calendar_period(@2002-08-06, 90 calendar_day);
    when month < @2022-01-01;
    then month_within_credit_window_35(month);
}
pub relation joint_return_35(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer files a joint return for the taxable year (section 35(b)(2)) — case-asserted";
}
pub relation eligible_coverage_month_35(taxpayer: Individual, month: Date) kind institutional {
    label en official "section 35(b)(1)-(2): a month within the window in which the taxpayer (or, on a joint return, at least 1 spouse) meets the requirements of (b)(1)(A)";
}
rule EligibleCoverageMonthOwnRule(taxpayer: Individual, month: Date) strict {
    when month_meets_b1a_35(taxpayer, month);
    when month_within_credit_window_35(month);
    then eligible_coverage_month_35(taxpayer, month);
}
@source(IRC_S35_B, relation = formalizes, coverage = exact, quote = "In the case of a joint return, the requirements of paragraph (1)(A) shall be treated as met with respect to any month if at least 1 spouse satisfies such requirements.")
rule EligibleCoverageMonthSpouseRule(taxpayer: Individual, month: Date, spouse: Individual, y: TaxableYear) strict {
    when spouse_of_35(taxpayer, spouse);
    when joint_return_35(taxpayer, y);
    when month_meets_b1a_35(spouse, month);
    when month_within_credit_window_35(month);
    then eligible_coverage_month_35(taxpayer, month);
}
pub relation premium_assistance_under_arpa_9501_for_month_35(person: Individual, month: Date) kind empirical {
    label en official "the individual receives premium assistance for continuation coverage under section 9501(a)(1) of the American Rescue Plan Act of 2021 for the month (section 35(g)(9)) — case-asserted";
}

// --- (g)(11): the election, a power -----------------------------------------------------------------------------------------------------------------------

pub relation elects_section_35_for_month_35(taxpayer: Individual, month: Date) kind empirical {
    label en official "the taxpayer's exercise of the section 35(g)(11) election to have this section apply for the eligible coverage month";
}
pub relation return_due_date_including_extensions_35(taxpayer: Individual, y: TaxableYear, due: Date) kind empirical {
    label en official "the due date (including extensions) for the return of tax for the taxable year (section 35(g)(11)(B)(i)) — case-asserted";
}
pub relation section_35_elected_for_month_35(taxpayer: Individual, month: Date) kind institutional {
    label en official "section 35(g)(11)(A): this section applies to the taxpayer for the eligible coverage month (a valid, timely election)";
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "This section shall not apply to any taxpayer for any eligible coverage month unless such taxpayer elects the application of this section for such month.")
rule Section35G11ElectionRule(taxpayer: Individual, month: Date, y: TaxableYear, due: Date) defeasible {
    when eligible_coverage_month_35(taxpayer, month);
    when month_in_taxable_year_of_35(taxpayer, month, y);
    when return_due_date_including_extensions_35(taxpayer, y, due);
    then power Section35G11Election {
        holder taxpayer;
        over taxpayer;
        exercise elects_section_35_for_month_35(taxpayer, month);
        valid_when eligible_coverage_month_35(taxpayer, month);
        effect create(section_35_elected_for_month_35(taxpayer, month));
        window [-infinity, due];
    };
}
pub relation section_35_applies_for_month_35(taxpayer: Individual, month: Date) kind institutional {
    label en official "section 35(g)(11): the election applies for the elected month and for all subsequent eligible coverage months in the taxable year (irrevocable for those months)";
}
rule Section35AppliesElectedMonthRule(taxpayer: Individual, month: Date) strict {
    when section_35_elected_for_month_35(taxpayer, month);
    then section_35_applies_for_month_35(taxpayer, month);
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "(ii) any election for this section to apply for an eligible coverage month shall apply for all subsequent eligible coverage months in the taxable year and, once made, shall be irrevocable with respect to such months.")
rule Section35AppliesSubsequentMonthsRule(taxpayer: Individual, month: Date, elected: Date, y: TaxableYear, begin: Date, finish: Date) strict {
    when section_35_elected_for_month_35(taxpayer, elected);
    when eligible_coverage_month_35(taxpayer, month);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when elected >= begin;
    when elected <= finish;
    when month >= elected;
    when month <= finish;
    then section_35_applies_for_month_35(taxpayer, month);
}

// --- (a), (g)(1)-(4), (g)(8): the amount of the credit ----------------------------------------------------------------------------------------------------------

pub relation secretary_payment_for_month_35(taxpayer: Individual, month: Date, amount: Money) kind empirical {
    label en official "a payment made by the Secretary on behalf of the taxpayer under section 7527 for the month (section 35(g)(8)(A)) — case-asserted";
}
pub relation premium_paid_from_msa_or_hsa_35(taxpayer: Individual, month: Date, amount: Money) kind empirical {
    label en official "the part of the payment funded by amounts distributed from an Archer MSA or a health savings account (section 35(g)(3)) — case-asserted";
}
pub relation coverage_month_premium_35(taxpayer: Individual, y: TaxableYear, month: Date, amount: Money) kind institutional {
    label en official "sections 35(a), (g)(3), (g)(8): the premiums for the eligible coverage month treated as paid by the taxpayer (own payments for the taxpayer and qualifying family members plus the Secretary's payments, less amounts funded by MSA or HSA distributions), for a month to which the election applies";
}
@source(IRC_S35_A, relation = formalizes, coverage = exact, quote = "an amount equal to 72.5 percent of the amount paid by the taxpayer for coverage of the taxpayer and qualifying family members under qualified health insurance for eligible coverage months beginning in the taxable year.")
rule CoverageMonthPremiumRule(taxpayer: Individual, y: TaxableYear, month: Date, begin: Date, finish: Date) strict {
    when eligible_coverage_month_35(taxpayer, month);
    when section_35_applies_for_month_35(taxpayer, month);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when month >= begin;
    when month <= finish;
    when not_known(premium_assistance_under_arpa_9501_for_month_35(taxpayer, month));
    then coverage_month_premium_35(taxpayer, y, month,
        sum(collect all a: Money where premium_paid_for_person_35(taxpayer, taxpayer, month, a), empty: 0 USD)
        + sum(collect all a: Money, p: Individual where premium_paid_for_person_35(taxpayer, p, month, a) and qualifying_family_member_35(taxpayer, p, month), empty: 0 USD)
        + sum(collect all a: Money where secretary_payment_for_month_35(taxpayer, month, a), empty: 0 USD)
        - sum(collect all a: Money where premium_paid_from_msa_or_hsa_35(taxpayer, month, a), empty: 0 USD));
}
pub relation deduction_under_151_allowable_to_another_35(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "a deduction under section 151 with respect to the individual is allowable to another taxpayer for a taxable year beginning in the calendar year in which the individual's taxable year begins (section 35(g)(4)) — case-asserted";
}
pub relation advance_payments_under_7527_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount paid on behalf of the taxpayer under section 7527 for months beginning in the taxable year (section 35(g)(1)) — case-asserted";
}
pub relation credit_before_advance_payments_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 35(a): 72.5 percent of the premiums treated as paid for the year's eligible coverage months to which the election applies (a single rounding, cents HALF_UP judgment call)";
}
rule CreditBeforeAdvancePaymentsRule(taxpayer: Individual, y: TaxableYear, month: Date, one: Money) strict {
    when coverage_month_premium_35(taxpayer, y, month, one);
    when not_known(deduction_under_151_allowable_to_another_35(taxpayer, y));
    then credit_before_advance_payments_35(taxpayer, y,
        round(0.725 * sum(collect all a: Money, m: Date where coverage_month_premium_35(taxpayer, y, m, a), empty: 0 USD), 2, "HALF_UP"));
}
pub relation health_coverage_tax_credit_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 35 credit for the taxable year: the amount under subsection (a) reduced (not below zero) by the advance payments under section 7527";
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "With respect to any taxable year, the amount which would (but for this subsection) be allowed as a credit to the taxpayer under subsection (a) shall be reduced (but not below zero) by the aggregate amount paid on behalf of such taxpayer under section 7527 for months beginning in such taxable year.")
rule HealthCoverageTaxCreditWithAdvanceRule(taxpayer: Individual, y: TaxableYear, before: Money, advance: Money) strict {
    when credit_before_advance_payments_35(taxpayer, y, before);
    when advance_payments_under_7527_35(taxpayer, y, advance);
    then health_coverage_tax_credit_35(taxpayer, y, max(before - advance, 0 USD));
}
relation advance_payments_asserted_35(taxpayer: Individual, y: TaxableYear) kind institutional;
rule AdvancePaymentsAssertedRule(taxpayer: Individual, y: TaxableYear, amount: Money) strict {
    when advance_payments_under_7527_35(taxpayer, y, amount);
    then advance_payments_asserted_35(taxpayer, y);
}
rule HealthCoverageTaxCreditNoAdvanceRule(taxpayer: Individual, y: TaxableYear, before: Money) strict {
    when credit_before_advance_payments_35(taxpayer, y, before);
    when not_known(advance_payments_asserted_35(taxpayer, y));
    then health_coverage_tax_credit_35(taxpayer, y, before);
}
pub relation amount_excluded_from_162l_and_213_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 35(g)(2): amounts taken into account under subsection (a) are not taken into account in determining any deduction under section 162(l) or 213";
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "Amounts taken into account under subsection (a) shall not be taken into account in determining any deduction allowed under section 162(l) or 213.")
rule AmountExcludedFrom162lAnd213Rule(taxpayer: Individual, y: TaxableYear, month: Date, one: Money) strict {
    when coverage_month_premium_35(taxpayer, y, month, one);
    then amount_excluded_from_162l_and_213_35(taxpayer, y,
        sum(collect all a: Money, m: Date where coverage_month_premium_35(taxpayer, y, m, a), empty: 0 USD));
}
pub relation payment_treated_as_made_on_first_day_of_month_35(taxpayer: Individual, month: Date, on: Date) kind institutional {
    label en official "section 35(g)(8): payments by the Secretary under section 7527 and payments by the taxpayer for eligible coverage months are treated as made by the taxpayer on the first day of the month for which they are made";
}
rule PaymentTreatedAsMadeFirstDaySecretaryRule(taxpayer: Individual, month: Date, amount: Money) strict {
    when secretary_payment_for_month_35(taxpayer, month, amount);
    then payment_treated_as_made_on_first_day_of_month_35(taxpayer, month, month);
}
rule PaymentTreatedAsMadeFirstDayTaxpayerRule(taxpayer: Individual, month: Date, person: Individual, amount: Money) strict {
    when premium_paid_for_person_35(taxpayer, person, month, amount);
    when eligible_coverage_month_35(taxpayer, month);
    then payment_treated_as_made_on_first_day_of_month_35(taxpayer, month, month);
}

// --- (g)(10)(A): the Medicare month ------------------------------------------------------------------------------------------------------------------------

pub relation first_entitled_to_medicare_on_35(person: Individual, on: Date) kind empirical {
    label en official "the date the eligible individual is first entitled to the benefits described in subsection (f)(2)(A) — case-asserted";
}
pub relation month_eligible_but_for_f2a_35(person: Individual, month: Date) kind empirical {
    label en official "the month would be an eligible coverage month for the eligible individual but for subsection (f)(2)(A) — case-asserted";
}
pub relation month_treated_eligible_for_family_members_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(g)(10)(A): the month is treated as an eligible coverage month solely for the credit for qualifying family members (and advance payments), only for the first 24 months after the individual is first entitled to the (f)(2)(A) benefits";
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "In the case of any month which would be an eligible coverage month with respect to an eligible individual but for subsection (f)(2)(A), such month shall be treated as an eligible coverage month with respect to such eligible individual solely for purposes of determining the amount of the credit under this section with respect to any qualifying family members of such individual (and any advance payment of such credit under section 7527).")
rule MonthTreatedEligibleForFamilyMembersRule(person: Individual, month: Date, entitled: Date) strict {
    when month_eligible_but_for_f2a_35(person, month);
    when first_entitled_to_medicare_on_35(person, entitled);
    when month >= entitled;
    when month < add_calendar_period(entitled, 24 calendar_month);
    then month_treated_eligible_for_family_members_35(person, month);
}

// --- (g)(12): coordination with section 36B ---------------------------------------------------------------------------------------------------------------

pub relation advance_payments_1412_and_7527_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of any advance payments made on behalf of the taxpayer under section 1412 of the Patient Protection and Affordable Care Act and section 7527 for months during the taxable year (section 35(g)(12)(B)(i)(I)) — case-asserted";
}
pub relation credit_35_without_g1_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit allowed under section 35 determined without regard to paragraph (1) of subsection (g) (section 35(g)(12)(B)(i)(II)) — case-asserted";
}
pub relation credit_36b_without_f1_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit allowed under section 36B determined without regard to subsection (f)(1) of that section (section 35(g)(12)(B)(i)(II)) — case-asserted";
}
pub relation month_not_a_coverage_month_for_36b_35(taxpayer: Individual, month: Date) kind institutional {
    label en official "section 35(g)(12)(A): an eligible coverage month to which the election applies is not a coverage month for section 36B with respect to the taxpayer";
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "An eligible coverage month to which the election under paragraph (11) applies shall not be treated as a coverage month (as defined in section 36B(c)(2)) for purposes of section 36B with respect to the taxpayer.")
rule MonthNotACoverageMonthFor36bRule(taxpayer: Individual, month: Date) strict {
    when section_35_applies_for_month_35(taxpayer, month);
    then month_not_a_coverage_month_for_36b_35(taxpayer, month);
}
pub relation tax_increase_for_advance_payments_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 35(g)(12)(B)(i): the tax for the year is increased by the excess (if any) of the advance payments under section 1412 of the ACA and section 7527 over the credits allowed under sections 35 (without (g)(1)) and 36B (without (f)(1))";
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "(i) the tax imposed by this chapter for the taxable year shall be increased by the excess, if any, of—")
rule TaxIncreaseForAdvancePaymentsRule(taxpayer: Individual, y: TaxableYear, advance: Money, c35: Money, c36b: Money) strict {
    when advance_payments_1412_and_7527_35(taxpayer, y, advance);
    when credit_35_without_g1_35(taxpayer, y, c35);
    when credit_36b_without_f1_35(taxpayer, y, c36b);
    then tax_increase_for_advance_payments_35(taxpayer, y, max(advance - (c35 + c36b), 0 USD));
}
pub relation section_36b_f2_disapplied_35(taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "section 35(g)(12)(B)(ii): section 36B(f)(2) does not apply to the taxpayer for the year";
}
@source(IRC_S35_G, relation = formalizes, coverage = exact, quote = "(ii) section 36B(f)(2) shall not apply with respect to such taxpayer for such taxable year")
rule Section36bF2DisappliedAdvanceRule(taxpayer: Individual, y: TaxableYear, amount: Money) strict {
    when advance_payments_1412_and_7527_35(taxpayer, y, amount);
    then section_36b_f2_disapplied_35(taxpayer, y);
}
rule Section36bF2DisappliedElectionRule(taxpayer: Individual, y: TaxableYear, month: Date, begin: Date, finish: Date) strict {
    when section_35_applies_for_month_35(taxpayer, month);
    when us.irc.core::begins(y, begin);
    when us.irc.core::ends(y, finish);
    when month >= begin;
    when month <= finish;
    then section_36b_f2_disapplied_35(taxpayer, y);
}
pub relation received_7527_advance_payment_for_month_in_year_35(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer received advance payments under section 7527 for any month in the taxable year (section 35(g)(12)(B)(ii)) — case-asserted";
}
pub relation later_allowed_credit_under_36b_35(taxpayer: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer is later allowed a credit under section 36B for the taxable year — case-asserted";
}
pub relation section_36b_f2b_substituted_amount_35(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 35(g)(12)(B)(ii): where advance payments under section 7527 were received and a section 36B credit is later allowed, section 36B(f)(2)(B) is applied substituting the amount determined under clause (i) for the amount determined under section 36B(f)(2)(A)";
}
rule Section36bF2bSubstitutedAmountRule(taxpayer: Individual, y: TaxableYear, amount: Money) strict {
    when received_7527_advance_payment_for_month_in_year_35(taxpayer, y);
    when later_allowed_credit_under_36b_35(taxpayer, y);
    when tax_increase_for_advance_payments_35(taxpayer, y, amount);
    then section_36b_f2b_substituted_amount_35(taxpayer, y, amount);
}

// --- (e)(2)(B): qualifying individuals ----------------------------------------------------------------------------------------------------------------

pub relation aggregate_creditable_coverage_months_35(person: Individual, month: Date, months: Decimal) kind empirical {
    label en official "the aggregate of the periods of creditable coverage (section 9801(c)), in months, as of the date the individual seeks to enroll in the State coverage (section 35(e)(2)(B)(i)) — case-asserted";
}
relation qualifying_eligible_individual_35(person: Individual, month: Date) kind institutional;
pub relation qualifying_individual_35(person: Individual, month: Date) kind institutional {
    label en official "section 35(e)(2)(B): an eligible individual with 3 months or more of creditable coverage who meets clauses (iii) and (iv) of subsection (b)(1)(A) (no other specified coverage, not imprisoned), and the qualifying family members of such an individual";
}
@source(IRC_S35_E, relation = formalizes, coverage = exact, quote = "(i) an eligible individual for whom, as of the date on which the individual seeks to enroll in the coverage described in subparagraphs (B) through (H) of paragraph (1), the aggregate of the periods of creditable coverage (as defined in section 9801(c)) is 3 months or longer and who, with respect to any month, meets the requirements of clauses (iii) and (iv) of subsection (b)(1)(A); and")
rule QualifyingIndividualEligibleRule(person: Individual, month: Date, months: Decimal) strict {
    when eligible_individual_35(person, month);
    when aggregate_creditable_coverage_months_35(person, month, months);
    when months >= 3.0;
    when not_known(other_specified_coverage_35(person, month));
    when not_known(imprisoned_under_authority_35(person, month));
    then qualifying_eligible_individual_35(person, month);
}
rule QualifyingIndividualBaseRule(person: Individual, month: Date) strict {
    when qualifying_eligible_individual_35(person, month);
    then qualifying_individual_35(person, month);
}
@source(IRC_S35_E, relation = formalizes, coverage = exact, quote = "(ii) the qualifying family members of such eligible individual.")
rule QualifyingIndividualFamilyRule(person: Individual, month: Date, taxpayer: Individual) strict {
    when qualifying_family_member_35(taxpayer, person, month);
    when qualifying_eligible_individual_35(taxpayer, month);
    then qualifying_individual_35(person, month);
}
