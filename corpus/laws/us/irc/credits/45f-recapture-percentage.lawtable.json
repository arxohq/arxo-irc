{
  "schemaVersion": "law.decision/0.1",
  "kind": "decision-table",
  "id": "urn:us:irc:credits:clir:table:45f-recapture-percentage",
  "mode": "rules",
  "hitPolicy": "first",
  "total": true,
  "inputs": [
    {
      "id": "facility_year_number",
      "name": "the year of the recapture event counted from the first day of the taxable year in which the facility is placed in service (year 1)",
      "type": {
        "name": "urn:law:std#Decimal"
      }
    }
  ],
  "outputs": [
    {
      "id": "pct",
      "name": "applicable recapture percentage under section 45F(d)(2)",
      "type": {
        "name": "urn:law:std#Decimal"
      }
    }
  ],
  "emit": {
    "predicate": "urn:us:irc:credits:clir#recapture_percentage_45f",
    "polarity": "positive",
    "args": [
      {
        "kind": "input",
        "id": "facility_year_number"
      },
      {
        "kind": "output",
        "id": "pct"
      }
    ]
  },
  "labels": [
    {
      "language": "en",
      "status": "official",
      "text": "Section 45F(d)(2)(A) applicable-recapture-percentage table (IRC_S45F_TABLE_1): 100 percent in years 1-3, 85, 70, 55, 40, 25 in years 4-8, 10 percent in years 9-10, 0 from year 11"
    }
  ],
  "rows": [
    {
      "id": "years-1-to-3",
      "when": [
        {
          "input": "facility_year_number",
          "condition": {
            "kind": "comparison",
            "op": "lt",
            "value": {
              "kind": "value",
              "type": {
                "name": "urn:law:std#Decimal"
              },
              "value": "4"
            }
          }
        }
      ],
      "then": [
        {
          "output": "pct",
          "value": {
            "kind": "value",
            "type": {
              "name": "urn:law:std#Decimal"
            },
            "value": "1.00"
          }
        }
      ],
      "anchors": [
        "IRC_S45F_TABLE_1"
      ]
    },
    {
