// Section 43 — Enhanced oil recovery credit. Stage 2c (IRC-06 stage 2c,
// DECISION-0379), "as budget allows" item: §43 (enhanced oil recovery 15%
// with the phase-out by reference price -> SOURCE_GAP).
//
// Judgment calls / scope:
// * (a) (15 percent of qualified enhanced oil recovery costs) and (b)(1)
//   (the phase-out ratio itself) ARE modelled as exact arithmetic.
// * (b)(2) (the section 45K(d)(2)(C) reference price) and the (b)(3)
//   inflation-adjusted $28 threshold (a GNP-implicit-price-deflator
//   mechanism, NOT the standard section 1(f)(3) CPI mechanism this
//   package's other indexed amounts use) are BOTH case-asserted dependency
//   contracts — SOURCE_GAP: neither the section 45K(d)(2)(C) reference
//   price nor a GNP-deflator-based inflation adjustment factor is pinned
//   anywhere in `us.irc.inflation_adjustments` or elsewhere in this
//   corpus. This matches the coordinator's own explicit framing for this
//   section ("phase-out by reference price -> SOURCE_GAP").
// * (c) (qualified enhanced oil recovery costs: tertiary-injectant,
//   tangible-property, intangible-drilling-cost categories for a qualified
//   domestic project) and (d)-(f) (special rules, basis adjustment,
//   election not to claim the credit) are NOT modelled — TECH_GAP,
//   TECH-GAPS G391.

use self::{
    IRC_S43_A,
    IRC_S43_B,
    Person,
    TaxableYear,
    qualified_eor_costs_for_credit_43,
};

pub relation qualified_enhanced_oil_recovery_costs(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's qualified enhanced oil recovery costs for the taxable year (section 43(c)) — case-asserted";
}
pub relation reference_price_preceding_calendar_year_43(y: TaxableYear, price: Money) kind empirical {
    label en official "the section 45K(d)(2)(C) reference price for the calendar year preceding the one in which the taxable year begins (section 43(b)(2)) — case-asserted, SOURCE_GAP (not pinned anywhere in this corpus)";
}
pub relation inflation_adjusted_28_dollar_threshold_43(y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 43(b)(3) GNP-implicit-price-deflator-indexed $28 threshold for the calendar year — case-asserted, SOURCE_GAP (a distinct inflation mechanism from section 1(f)(3), not pinned anywhere in this corpus)";
}
pub relation enhanced_oil_recovery_credit_before_phaseout(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 43(a): 15 percent of qualified enhanced oil recovery costs, before the (b) phase-out";
}
@source(IRC_S43_A, quote = "the enhanced oil recovery credit for any taxable year is an amount equal to 15 percent of the taxpayer's qualified enhanced oil recovery costs for such taxable year")
rule EnhancedOilRecoveryCreditBeforePhaseoutRule(taxpayer: Person, y: TaxableYear, costs: Money) defeasible {
    when qualified_eor_costs_for_credit_43(taxpayer, y, costs);
    then enhanced_oil_recovery_credit_before_phaseout(taxpayer, y, round(0.15 * costs, 2, "HALF_UP"));
}

pub relation phaseout_ratio_43(y: TaxableYear, ratio: Decimal) kind institutional {
    label en official "section 43(b)(1): the ratio by which the credit is reduced, when the preceding year's reference price exceeds the inflation-adjusted $28 threshold";
}
@source(IRC_S43_B, quote = "the amount by which the reference price for the calendar year preceding the calendar year in which the taxable year begins exceeds $28, bears to\n(B) $6")
rule PhaseoutRatio43Rule(y: TaxableYear, price: Money, threshold: Money) strict {
    when reference_price_preceding_calendar_year_43(y, price);
    when inflation_adjusted_28_dollar_threshold_43(y, threshold);
    when price > threshold;
    then phaseout_ratio_43(y, div_round(price - threshold, 6.00 USD, 10, "HALF_UP"));
}
relation has_phaseout_ratio_43(y: TaxableYear) kind institutional;
rule HasPhaseoutRatio43Rule(y: TaxableYear, ratio: Decimal) strict {
    when phaseout_ratio_43(y, ratio);
    then has_phaseout_ratio_43(y);
}

pub relation enhanced_oil_recovery_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 43 enhanced oil recovery credit for the taxable year, after the section 43(b) phase-out";
}
@source(IRC_S43_B, quote = "The amount of the credit determined under subsection (a) for any taxable year shall be reduced by an amount which bears the same ratio to the amount of such credit")
rule EnhancedOilRecoveryCreditWithPhaseoutRule(taxpayer: Person, y: TaxableYear, before: Money, ratio: Decimal) defeasible {
    when enhanced_oil_recovery_credit_before_phaseout(taxpayer, y, before);
    when phaseout_ratio_43(y, ratio);
    then enhanced_oil_recovery_credit(taxpayer, y, round(before * (1.0 - ratio), 2, "HALF_UP"));
}
rule EnhancedOilRecoveryCreditNoPhaseoutRule(taxpayer: Person, y: TaxableYear, before: Money) defeasible {
    when enhanced_oil_recovery_credit_before_phaseout(taxpayer, y, before);
    when not_known(has_phaseout_ratio_43(y));
    then enhanced_oil_recovery_credit(taxpayer, y, before);
}
