// Section 45P — Employer wage credit for employees who are active duty
// members of the uniformed services. Stage 2d (IRC-06, DECISION-0379).
//
// Scope / judgment calls:
// * (a)/(b): 20 percent of the sum over qualified employees of the differential
//   wage payments (section 3401(h)(2)) up to $20,000 each. A qualified
//   employee has been an employee for the 91 days before the period of payment
//   (case fact: days employed).
// * (b)(3)/(e): single-employer aggregation (sections 414(b),(c),(m),(o); rules
//   of section 52(c)-(e)) is not modelled (TECH-GAPS G1521).
// * (c): the compensation-credit reduction is exposed as an amount per
//   employee; consumers (e.g. section 51, 41) do not read it yet (G1521).
// * (d): disallowance while the taxpayer is under a final order under 38 USC
//   4323 for the year of the order and the 2 succeeding taxable years; the
//   succeeding years are read from the years' beginning dates, assuming
//   12-month years (G1521).

use self::{
    IRC_S45P_A,
    IRC_S45P_B,
    IRC_S45P_C,
    IRC_S45P_D,
    Individual,
    Person,
    TaxableYear,
};

pub relation differential_wage_payments_45p(taxpayer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "differential wage payments (section 3401(h)(2)) paid to the employee for the taxable year — case-asserted";
}
pub relation days_employed_before_differential_period_45p(taxpayer: Person, employee: Individual, y: TaxableYear, days: Decimal) kind empirical {
    label en official "the number of days the person has been an employee of the taxpayer immediately preceding the period for which a differential wage payment is made — case-asserted";
}
pub relation final_order_under_38_usc_4323_45p(taxpayer: Person, order_year: TaxableYear) kind empirical {
    label en official "the taxpayer is, in this taxable year, under a final order, judgment, or other process of a district court under 38 U.S.C. 4323 for a violation of chapter 43 — case-asserted";
}

pub relation qualified_employee_45p(taxpayer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en official "section 45P(b)(2): a person who has been an employee of the taxpayer for the 91-day period immediately preceding the period of the differential wage payment";
}
@source(IRC_S45P_B, quote = "a person who has been an employee of the taxpayer for the 91-day period immediately preceding the period for which any differential wage payment is made")
rule QualifiedEmployee45pRule(taxpayer: Person, employee: Individual, y: TaxableYear, days: Decimal) strict {
    when days_employed_before_differential_period_45p(taxpayer, employee, y, days);
    when days >= 91.0;
    then qualified_employee_45p(taxpayer, employee, y);
}
pub relation eligible_differential_wage_payments_45p(taxpayer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45P(b)(1): differential wage payments up to $20,000 for the qualified employee";
}
@source(IRC_S45P_B, quote = "so much of the differential wage payments (as defined in section 3401(h)(2)) paid to such employee for the taxable year as does not exceed $20,000")
rule EligibleDifferentialWagePayments45pRule(taxpayer: Person, employee: Individual, y: TaxableYear, paid: Money) strict {
    when qualified_employee_45p(taxpayer, employee, y);
    when differential_wage_payments_45p(taxpayer, employee, y, paid);
    then eligible_differential_wage_payments_45p(taxpayer, employee, y, min(paid, 20000.00 USD));
}

// --- (d): disallowance after an order ---------------------------------------------

pub relation section_45p_disallowed_for_year(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 45P(d): no credit for the taxable year of a final order under 38 U.S.C. 4323 or for the 2 succeeding taxable years";
}
@source(IRC_S45P_D, quote = "any taxable year, beginning after the date of the enactment of this section, in which the taxpayer is under a final order, judgment, or other process issued or required by a district court of the United States under section 4323 of title 38 of the United States Code")
rule Section45pDisallowedOrderYearRule(taxpayer: Person, y: TaxableYear) strict {
    when final_order_under_38_usc_4323_45p(taxpayer, y);
    then section_45p_disallowed_for_year(taxpayer, y);
}
@source(IRC_S45P_D, quote = "the 2 succeeding taxable years")
rule Section45pDisallowedSucceedingYearsRule(taxpayer: Person, y: TaxableYear, order_year: TaxableYear, order_begin: Date, begin: Date) strict {
    when final_order_under_38_usc_4323_45p(taxpayer, order_year);
    when us.irc.core::begins(order_year, order_begin);
    when us.irc.core::begins(y, begin);
    when begin > order_begin;
    when begin < add_calendar_period(order_begin, 36 calendar_month);
    then section_45p_disallowed_for_year(taxpayer, y);
}
relation has_disallowance_45p(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasDisallowance45pRule(taxpayer: Person, y: TaxableYear) strict {
    when section_45p_disallowed_for_year(taxpayer, y);
    then has_disallowance_45p(taxpayer, y);
}

// --- (a): the credit --------------------------------------------------------------

pub relation differential_wage_payment_credit_per_employee_45p(taxpayer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45P(a): 20 percent of the employee's eligible differential wage payments (also the section 45P(c) reduction of other compensation credits for that employee)";
}
@source(IRC_S45P_A, quote = "an amount equal to 20 percent of the sum of the eligible differential wage payments for each of the qualified employees of the taxpayer during such taxable year")
rule DifferentialWageCreditPerEmployee45pRule(taxpayer: Person, employee: Individual, y: TaxableYear, eligible: Money) defeasible {
    when eligible_differential_wage_payments_45p(taxpayer, employee, y, eligible);
    when not_known(has_disallowance_45p(taxpayer, y));
    then differential_wage_payment_credit_per_employee_45p(taxpayer, employee, y, round(0.20 * eligible, 2, "HALF_UP"));
}
pub relation differential_wage_payment_credit(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 45P differential wage payment credit for the taxable year (a section 38(b)(24) component)";
}
rule DifferentialWagePaymentCredit45pRule(taxpayer: Person, y: TaxableYear, employee: Individual, amount: Money) defeasible {
    when differential_wage_payment_credit_per_employee_45p(taxpayer, employee, y, amount);
    then differential_wage_payment_credit(taxpayer, y,
        sum(collect all a: Money, e: Individual where differential_wage_payment_credit_per_employee_45p(taxpayer, e, y, a), empty: 0 USD));
}
pub relation compensation_credit_reduction_45p(taxpayer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 45P(c): the amount by which the credit otherwise allowable under this chapter for compensation paid to the employee is reduced";
}
@source(IRC_S45P_C, quote = "The amount of credit otherwise allowable under this chapter with respect to compensation paid to any employee shall be reduced by the credit determined under this section with respect to such employee.")
rule CompensationCreditReduction45pRule(taxpayer: Person, employee: Individual, y: TaxableYear, amount: Money) defeasible {
    when differential_wage_payment_credit_per_employee_45p(taxpayer, employee, y, amount);
    then compensation_credit_reduction_45p(taxpayer, employee, y, amount);
}
