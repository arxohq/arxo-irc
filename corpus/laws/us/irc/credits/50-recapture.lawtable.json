{
  "schemaVersion": "law.decision/0.1",
  "kind": "decision-table",
  "id": "urn:us:irc:credits:clir:table:50-recapture-percentage",
  "mode": "rules",
  "hitPolicy": "first",
  "total": true,
  "inputs": [
    { "id": "full_years_held", "name": "Full years investment credit property was held after being placed in service", "type": { "name": "urn:law:std#Decimal" } }
  ],
  "outputs": [
    { "id": "pct", "name": "Recapture percentage", "type": { "name": "urn:law:std#Decimal" } }
  ],
  "emit": {
    "predicate": "urn:us:irc:credits:clir#recapture_percentage_50",
    "polarity": "positive",
    "args": [
      { "kind": "input", "id": "full_years_held" },
      { "kind": "output", "id": "pct" }
    ]
  },
  "labels": [
    { "language": "en", "status": "official", "text": "Section 50(a)(1)(B) recapture-percentage table (IRC_S50_TABLE_1): 100/80/60/40/20 percent by full year of early disposition" }
  ],
  "rows": [
    {
      "id": "within-first-year",
      "when": [
        { "input": "full_years_held", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "1" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "1.00" } } ],
      "anchors": ["IRC_S50_TABLE_1"]
    },
    {
      "id": "one-full-year",
      "when": [
        { "input": "full_years_held", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "2" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.80" } } ],
      "anchors": ["IRC_S50_TABLE_1"]
    },
    {
      "id": "two-full-years",
      "when": [
        { "input": "full_years_held", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "3" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.60" } } ],
      "anchors": ["IRC_S50_TABLE_1"]
    },
    {
      "id": "three-full-years",
      "when": [
        { "input": "full_years_held", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "4" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.40" } } ],
      "anchors": ["IRC_S50_TABLE_1"]
    },
    {
      "id": "four-full-years",
      "when": [
        { "input": "full_years_held", "condition": { "kind": "comparison", "op": "lt", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "5" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.20" } } ],
      "anchors": ["IRC_S50_TABLE_1"]
    },
    {
      "id": "five-or-more-full-years",
      "when": [
        { "input": "full_years_held", "condition": { "kind": "comparison", "op": "gte", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "5" } } }
      ],
      "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.00" } } ],
      "anchors": ["IRC_S50_TABLE_1"]
    }
  ]
}
