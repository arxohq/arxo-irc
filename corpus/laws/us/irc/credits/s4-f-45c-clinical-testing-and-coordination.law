// Stage 4 (DECISION-0379 with deontics), credits, part F: section 45C(b)(1)(A)-(B) (the
// qualified clinical testing expenses as section 41(b) amounts with two modifications) and
// section 45C(c)(1)-(2) (the coordination with the research credit). Closes G6420 (45C(c);
// the 45P(c) row is wired in module 51) and G6421.
//
// SECTION 45C(b)(1). Section 41(b) is not formalized as a computation in this package (module
// 41 reads `qualified_research_expenses` as a case-asserted aggregate), so there is no
// section 41(b) rule to re-run with substitutions: the two modifications are written out for the
// activity: the "in-house" amounts (wages for qualified services, supplies, the right to use
// computers: 41(b)(2)) and the contract amounts (41(b)(3)(A)), with "clinical testing" for
// "qualified research" (the activity must be a clinical testing of module 45c) and 100 percent
// in place of 65 percent of the contract amounts. The amount of one testing activity is the sum
// of the items; it is an ALTERNATIVE channel to the asserted `clinical_testing_expense_45c`
// (a case supplies either, never both). JUDGMENT CALLS: the (b)(2)(B) tests of "qualified
// services" and the (b)(3) requirements (the contract is entered before the testing, payment is
// contingent...) are read as facts of the items (the case classifies an amount as an item of
// the kind); cents HALF_UP.
//
// SECTION 45C(c). (1): the qualified clinical testing expenses are removed from the qualified
// research expenses that the section 41 credit reads (module 41 now reads
// `qualified_research_expenses_for_credit_41`). (2): the part of them that are qualified research
// expenses within section 41(b) is taken into account in the base period research expenses of
// later years: an OUTPUT relation `research_expenses_of_year_for_base_period_41` (the base
// amounts of module 41 are asserted; a case that computes them reads it).

use self::{
    ClinicalTest45C,
    IRC_S41_C,
    IRC_S45C_B,
    IRC_S45C_C,
    Person,
    TaxableYear,
    average_qualified_research_expenses_3yr,
    clinical_testing_45c,
    clinical_testing_expense_45c,
    fixed_base_percentage_41c3,
    qualified_research_expenses,
    section_41_exclusion_for_45c_expenses,
};

pub enum ClinicalTestingExpenseKind45C {
    Wages,
    Supplies,
    ComputerUse,
    Contract,
    label en official "the kinds of amounts of section 41(b)(2)-(3) applied to clinical testing by section 45C(b)(1)(B)";
}
pub relation clinical_testing_expense_item_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, kind: ClinicalTestingExpenseKind45C, amount: Money) kind empirical {
    label en official "an amount paid or incurred by the taxpayer in the taxable year for the clinical testing that is described in section 41(b)(2) (wages for qualified services, supplies, computer use) or 41(b)(3)(A) (contract amounts paid to a person other than an employee) with 'clinical testing' for 'qualified research' — case-asserted by kind";
}
relation clinical_testing_item_present_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C) kind institutional {
    label en official "bridge: an item is asserted for the testing activity";
}
rule ClinicalTestingItemPresent45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, kind: ClinicalTestingExpenseKind45C, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when clinical_testing_expense_item_45c(taxpayer, y, trial, kind, amount);
    then clinical_testing_item_present_45c(taxpayer, y, trial);
}
pub relation clinical_testing_expense_computed_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) kind institutional {
    label en official "the section 41(b) amounts of the testing activity with the section 45C(b)(1)(B) modifications: wages + supplies + computer use + 100 percent (not 65 percent) of the contract amounts";
}
@source(IRC_S45C_B, quote = "(ii) by substituting \"100 percent\" for \"65 percent\" in paragraph (3)(A) of such subsection.")
rule ClinicalTestingExpenseComputed45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C) defeasible {
    label en official "in-house amounts plus 100 percent of the contract amounts, for a clinical testing activity (section 45C(b)(1)(A)-(B))";
    when clinical_testing_45c(trial, taxpayer);
    when clinical_testing_item_present_45c(taxpayer, y, trial);
    then clinical_testing_expense_computed_45c(taxpayer, y, trial,
        sum(collect all a: Money where clinical_testing_expense_item_45c(taxpayer, y, trial, Wages, a), empty: 0 USD)
        + sum(collect all a: Money where clinical_testing_expense_item_45c(taxpayer, y, trial, Supplies, a), empty: 0 USD)
        + sum(collect all a: Money where clinical_testing_expense_item_45c(taxpayer, y, trial, ComputerUse, a), empty: 0 USD)
        + round(1.00 * sum(collect all a: Money where clinical_testing_expense_item_45c(taxpayer, y, trial, Contract, a), empty: 0 USD), 2, "HALF_UP"));
}
pub relation clinical_testing_expense_for_credit_45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) kind institutional {
    label en official "the section 41(b) amount of the testing activity the credit reads: the asserted amount or the computed one";
}
@source(IRC_S45C_B, quote = "the term \"qualified clinical testing expenses\" means the amounts which are paid or incurred by the taxpayer during the taxable year which would be described in subsection (b) of section 41 if such subsection were applied with the modifications set forth in subparagraph (B).")
rule ClinicalTestingExpenseForCreditAsserted45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) defeasible {
    label en official "the asserted amount (the earlier channel)";
    when clinical_testing_expense_45c(taxpayer, y, trial, amount);
    then clinical_testing_expense_for_credit_45c(taxpayer, y, trial, amount);
}
rule ClinicalTestingExpenseForCreditComputed45c(taxpayer: Person, y: TaxableYear, trial: ClinicalTest45C, amount: Money) defeasible {
    label en official "the computed amount when no amount is asserted";
    when clinical_testing_expense_computed_45c(taxpayer, y, trial, amount);
    then clinical_testing_expense_for_credit_45c(taxpayer, y, trial, amount);
}

// ===================== 45C(c)(1): removed from the research credit =====================

pub relation qualified_research_expenses_for_credit_41(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified research expenses the section 41 credit reads: the asserted amount less the qualified clinical testing expenses of a year to which the section 45C election applies (section 45C(c)(1)), not below zero";
}
@source(IRC_S45C_C, quote = "shall not be taken into account for purposes of determining the credit allowable under section 41 for such taxable year")
rule ResearchExpensesLess45cExpenses(taxpayer: Person, y: TaxableYear, qre: Money, excluded: Money) defeasible {
    label en official "qualified research expenses minus the section 45C expenses (section 45C(c)(1))";
    when qualified_research_expenses(taxpayer, y, qre);
    when section_41_exclusion_for_45c_expenses(taxpayer, y, excluded);
    then qualified_research_expenses_for_credit_41(taxpayer, y, max(0 USD, qre - excluded));
}
relation section_41_exclusion_present_45c(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a section 45C exclusion exists for the year";
}
rule Section41ExclusionPresent45c(taxpayer: Person, y: TaxableYear, excluded: Money) defeasible {
    label en official "bridge for the absence test";
    when section_41_exclusion_for_45c_expenses(taxpayer, y, excluded);
    then section_41_exclusion_present_45c(taxpayer, y);
}
rule ResearchExpensesWithout45cExclusion(taxpayer: Person, y: TaxableYear, qre: Money) defeasible {
    label en official "no section 45C election: the asserted amount stands";
    when qualified_research_expenses(taxpayer, y, qre);
    when not_known(section_41_exclusion_present_45c(taxpayer, y));
    then qualified_research_expenses_for_credit_41(taxpayer, y, qre);
}

// ===================== 45C(c)(2): base period research expenses =====================

pub relation clinical_testing_expenses_that_are_41b_qualified_research_expenses_45c(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified clinical testing expenses of the year that are also qualified research expenses within the meaning of section 41(b) (section 45C(c)(2)) — case-asserted";
}
pub relation research_expenses_of_year_for_base_period_41(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the research expenses of the year taken into account in the base period research expenses of later years: the qualified research expenses credited plus the section 45C expenses that are also qualified research expenses (section 45C(c)(2))";
}
@source(IRC_S45C_C, quote = "Any qualified clinical testing expenses for any taxable year which are qualified research expenses (within the meaning of section 41(b)) shall be taken into account in determining base period research expenses for purposes of applying section 41 to subsequent taxable years.")
rule ResearchExpensesForBasePeriodInclude45c(taxpayer: Person, y: TaxableYear, credited: Money, clinical: Money) defeasible {
    label en official "credited expenses + the section 45C expenses that are qualified research expenses (section 45C(c)(2))";
    when qualified_research_expenses_for_credit_41(taxpayer, y, credited);
    when clinical_testing_expenses_that_are_41b_qualified_research_expenses_45c(taxpayer, y, clinical);
    then research_expenses_of_year_for_base_period_41(taxpayer, y, credited + clinical);
}
relation clinical_qre_present_45c(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a clinical testing amount that is a qualified research expense is asserted";
}
rule ClinicalQrePresent45c(taxpayer: Person, y: TaxableYear, clinical: Money) defeasible {
    label en official "bridge for the absence test";
    when clinical_testing_expenses_that_are_41b_qualified_research_expenses_45c(taxpayer, y, clinical);
    then clinical_qre_present_45c(taxpayer, y);
}
rule ResearchExpensesForBasePeriodWithout45c(taxpayer: Person, y: TaxableYear, credited: Money) defeasible {
    label en official "no section 45C expense that is a qualified research expense: the credited amount";
    when qualified_research_expenses_for_credit_41(taxpayer, y, credited);
    when not_known(clinical_qre_present_45c(taxpayer, y));
    then research_expenses_of_year_for_base_period_41(taxpayer, y, credited);
}

// ===================== 45C(c)(2) wired into the section 41 base amount and the ASC average =====================
//
// WIRING (final TECH_GAP pass, 26.09.2026, closes G6602): the research expenses of a year taken into the base
// period (`research_expenses_of_year_for_base_period_41`, the credited expenses plus the 45C expenses that
// are qualified research expenses) are now READ by two computations of section 41 that were case-asserted:
// (1) the fixed-base percentage of section 41(c)(3): (A) the ratio of the aggregate expenses of the years
// beginning in 1984-1988 to the aggregate gross receipts of those years, (B)(ii) the start-up ramp (3 percent
// for the first 5 years, the fractions 1/6..5/6 of the ratio over the 4th..9th years, a ratio over 5 selected
// years after the 10th), (C) at most 16 percent, (D) to the nearest 1/100th of 1 percent (single rounding of
// the fraction); (2) the average expenses of the 3 preceding calendar years for the ASC of (c)(4)(A). The
// asserted `fixed_base_percentage_41c3` and `average_qualified_research_expenses_3yr` are kept as the channel
// used when the computation has no inputs (JUDGMENT CALL: the computed value wins where it exists).
// Bounded: the ASC average is computed only for a taxpayer whose 3 immediately preceding CALENDAR years all
// carry expense facts (a fiscal-year taxpayer reads the asserted average); the start-up ordinal of a year
// (the k-th taxable year beginning after 1993 with expenses), the selection of the 5 years for the 11th and later
// years and the status of a start-up company ((B)(i)) are case facts; the de minimis regulation of (B)(iii) is
// not applied.

pub relation gross_receipts_of_year_41c3(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross receipts of the taxpayer for the taxable year, for the fixed-base percentage of section 41(c)(3) — case-asserted";
}
pub relation startup_company_41c3B(taxpayer: Person) kind empirical {
    label en official "the fixed-base percentage is determined under section 41(c)(3)(B) (start-up company: the first year with gross receipts and expenses begins after 1983, or fewer than 3 such years in 1984-1988) — case-asserted";
}
pub relation startup_taxable_year_41c3B(taxpayer: Person, k: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is the k-th taxable year of the taxpayer beginning after December 31, 1993 for which the taxpayer has qualified research expenses (section 41(c)(3)(B)(ii)) — case-asserted";
}
pub relation selected_startup_year_41c3B(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is one of the 5 years selected by the taxpayer from among the 5th through 10th such years (section 41(c)(3)(B)(ii)(VII)) — case-asserted";
}
relation base_period_aggregate_41c3A(taxpayer: Person, y: TaxableYear, expenses: Money, receipts: Money) kind institutional;
@source(IRC_S41_C, quote = "the fixed-base percentage is the percentage which the aggregate qualified research expenses of the taxpayer for taxable years beginning after December 31, 1983, and before January 1, 1989")
rule BasePeriodAggregate41c3A(taxpayer: Person, y: TaxableYear, q: Money) defeasible {
    label en official "the aggregates of the years beginning in 1984-1988 (section 41(c)(3)(A))";
    when qualified_research_expenses(taxpayer, y, q);
    when not_known(startup_company_41c3B(taxpayer));
    then base_period_aggregate_41c3A(taxpayer, y,
        sum(collect all e: Money, yb: TaxableYear, d: Date where research_expenses_of_year_for_base_period_41(taxpayer, yb, e) and us.irc.core::begins(yb, d) and d >= @1984-01-01 and d <= @1988-12-31, empty: 0.00 USD),
        sum(collect all r: Money, yb2: TaxableYear, d2: Date where gross_receipts_of_year_41c3(taxpayer, yb2, r) and us.irc.core::begins(yb2, d2) and d2 >= @1984-01-01 and d2 <= @1988-12-31, empty: 0.00 USD));
}
pub relation fixed_base_percentage_computed_41c3(taxpayer: Person, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the fixed-base percentage computed from the base period research expenses (section 41(c)(3)(A), (B)(ii), (C), (D))";
}
@source(IRC_S41_C, quote = "the fixed-base percentage is the percentage which the aggregate qualified research expenses of the taxpayer for taxable years beginning after December 31, 1983, and before January 1, 1989")
rule FixedBasePercentageGeneral41c3A(taxpayer: Person, y: TaxableYear, e: Money, r: Money) defeasible {
    label en official "aggregate expenses over aggregate gross receipts of 1984-1988, at most 16 percent, 1/100th of 1 percent (section 41(c)(3)(A), (C), (D))";
    when base_period_aggregate_41c3A(taxpayer, y, e, r);
    when r > 0.00 USD;
    then fixed_base_percentage_computed_41c3(taxpayer, y, min(0.16, div_round(e / 1.00 USD, r / 1.00 USD, 4, "HALF_UP")));
}
@source(IRC_S41_C, quote = "3 percent for each of the taxpayer's 1st 5 taxable years beginning after December 31, 1993, for which the taxpayer has qualified research expenses")
rule FixedBasePercentageStartupFirstFive41c3B(taxpayer: Person, y: TaxableYear, m: Integer) defeasible {
    label en official "3 percent for each of the first 5 start-up years (section 41(c)(3)(B)(ii)(I))";
    when startup_taxable_year_41c3B(taxpayer, m, y);
    when m >= 1;
    when m <= 5;
    then fixed_base_percentage_computed_41c3(taxpayer, y, 0.03);
}
relation startup_aggregate_41c3B_year6(taxpayer: Person, y: TaxableYear, expenses: Money, receipts: Money) kind institutional;
@source(IRC_S41_C, quote = "in the case of the taxpayer's 6th such taxable year, 1/6 of the percentage which the aggregate qualified research expenses of the taxpayer for the 4th and 5th such taxable years")
rule StartupAggregate41c3BYear6(taxpayer: Person, y: TaxableYear, m: Integer) defeasible {
    label en official "the aggregates of the years the ramp reads for the 6th year (section 41(c)(3)(B)(ii)(II))";
    when startup_taxable_year_41c3B(taxpayer, m, y);
    when m == 6;
    then startup_aggregate_41c3B_year6(taxpayer, y, sum(collect all e6: Money, k6: Integer, yk6: TaxableYear where startup_taxable_year_41c3B(taxpayer, k6, yk6) and k6 >= 4 and k6 <= 5 and research_expenses_of_year_for_base_period_41(taxpayer, yk6, e6), empty: 0.00 USD), sum(collect all r6: Money, j6: Integer, yj6: TaxableYear where startup_taxable_year_41c3B(taxpayer, j6, yj6) and j6 >= 4 and j6 <= 5 and gross_receipts_of_year_41c3(taxpayer, yj6, r6), empty: 0.00 USD));
}
@source(IRC_S41_C, quote = "in the case of the taxpayer's 6th such taxable year, 1/6 of the percentage which the aggregate qualified research expenses of the taxpayer for the 4th and 5th such taxable years")
rule FixedBasePercentageStartupYear641c3B(taxpayer: Person, y: TaxableYear, e: Money, r: Money) defeasible {
    label en official "1/6 of the ratio over the 4th and 5th years, at most 16 percent, single rounding to 1/100th of 1 percent (section 41(c)(3)(B)(ii)(II), (C), (D))";
    when startup_aggregate_41c3B_year6(taxpayer, y, e, r);
    when r > 0.00 USD;
    then fixed_base_percentage_computed_41c3(taxpayer, y, min(0.16, div_round(e / 1.00 USD, 6.0 * (r / 1.00 USD), 4, "HALF_UP")));
}
relation startup_aggregate_41c3B_year7(taxpayer: Person, y: TaxableYear, expenses: Money, receipts: Money) kind institutional;
@source(IRC_S41_C, quote = "in the case of the taxpayer's 7th such taxable year, 1/3 of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th and 6th such taxable years")
rule StartupAggregate41c3BYear7(taxpayer: Person, y: TaxableYear, m: Integer) defeasible {
    label en official "the aggregates of the years the ramp reads for the 7th year (section 41(c)(3)(B)(ii)(III))";
    when startup_taxable_year_41c3B(taxpayer, m, y);
    when m == 7;
    then startup_aggregate_41c3B_year7(taxpayer, y, sum(collect all e7: Money, k7: Integer, yk7: TaxableYear where startup_taxable_year_41c3B(taxpayer, k7, yk7) and k7 >= 5 and k7 <= 6 and research_expenses_of_year_for_base_period_41(taxpayer, yk7, e7), empty: 0.00 USD), sum(collect all r7: Money, j7: Integer, yj7: TaxableYear where startup_taxable_year_41c3B(taxpayer, j7, yj7) and j7 >= 5 and j7 <= 6 and gross_receipts_of_year_41c3(taxpayer, yj7, r7), empty: 0.00 USD));
}
@source(IRC_S41_C, quote = "in the case of the taxpayer's 7th such taxable year, 1/3 of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th and 6th such taxable years")
rule FixedBasePercentageStartupYear741c3B(taxpayer: Person, y: TaxableYear, e: Money, r: Money) defeasible {
    label en official "1/3 of the ratio over the 5th and 6th years, at most 16 percent, single rounding to 1/100th of 1 percent (section 41(c)(3)(B)(ii)(III), (C), (D))";
    when startup_aggregate_41c3B_year7(taxpayer, y, e, r);
    when r > 0.00 USD;
    then fixed_base_percentage_computed_41c3(taxpayer, y, min(0.16, div_round(e / 1.00 USD, 3.0 * (r / 1.00 USD), 4, "HALF_UP")));
}
relation startup_aggregate_41c3B_year8(taxpayer: Person, y: TaxableYear, expenses: Money, receipts: Money) kind institutional;
@source(IRC_S41_C, quote = "in the case of the taxpayer's 8th such taxable year, ½ of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th, 6th, and 7th such taxable years")
rule StartupAggregate41c3BYear8(taxpayer: Person, y: TaxableYear, m: Integer) defeasible {
    label en official "the aggregates of the years the ramp reads for the 8th year (section 41(c)(3)(B)(ii)(IV))";
    when startup_taxable_year_41c3B(taxpayer, m, y);
    when m == 8;
    then startup_aggregate_41c3B_year8(taxpayer, y, sum(collect all e8: Money, k8: Integer, yk8: TaxableYear where startup_taxable_year_41c3B(taxpayer, k8, yk8) and k8 >= 5 and k8 <= 7 and research_expenses_of_year_for_base_period_41(taxpayer, yk8, e8), empty: 0.00 USD), sum(collect all r8: Money, j8: Integer, yj8: TaxableYear where startup_taxable_year_41c3B(taxpayer, j8, yj8) and j8 >= 5 and j8 <= 7 and gross_receipts_of_year_41c3(taxpayer, yj8, r8), empty: 0.00 USD));
}
@source(IRC_S41_C, quote = "in the case of the taxpayer's 8th such taxable year, ½ of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th, 6th, and 7th such taxable years")
rule FixedBasePercentageStartupYear841c3B(taxpayer: Person, y: TaxableYear, e: Money, r: Money) defeasible {
    label en official "1/2 of the ratio over the 5th to 7th years, at most 16 percent, single rounding to 1/100th of 1 percent (section 41(c)(3)(B)(ii)(IV), (C), (D))";
    when startup_aggregate_41c3B_year8(taxpayer, y, e, r);
    when r > 0.00 USD;
    then fixed_base_percentage_computed_41c3(taxpayer, y, min(0.16, div_round(e / 1.00 USD, 2.0 * (r / 1.00 USD), 4, "HALF_UP")));
}
relation startup_aggregate_41c3B_year9(taxpayer: Person, y: TaxableYear, expenses: Money, receipts: Money) kind institutional;
@source(IRC_S41_C, quote = "in the case of the taxpayer's 9th such taxable year, 2/3 of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th, 6th, 7th, and 8th such taxable years")
rule StartupAggregate41c3BYear9(taxpayer: Person, y: TaxableYear, m: Integer) defeasible {
    label en official "the aggregates of the years the ramp reads for the 9th year (section 41(c)(3)(B)(ii)(V))";
    when startup_taxable_year_41c3B(taxpayer, m, y);
    when m == 9;
    then startup_aggregate_41c3B_year9(taxpayer, y, sum(collect all e9: Money, k9: Integer, yk9: TaxableYear where startup_taxable_year_41c3B(taxpayer, k9, yk9) and k9 >= 5 and k9 <= 8 and research_expenses_of_year_for_base_period_41(taxpayer, yk9, e9), empty: 0.00 USD), sum(collect all r9: Money, j9: Integer, yj9: TaxableYear where startup_taxable_year_41c3B(taxpayer, j9, yj9) and j9 >= 5 and j9 <= 8 and gross_receipts_of_year_41c3(taxpayer, yj9, r9), empty: 0.00 USD));
}
@source(IRC_S41_C, quote = "in the case of the taxpayer's 9th such taxable year, 2/3 of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th, 6th, 7th, and 8th such taxable years")
rule FixedBasePercentageStartupYear941c3B(taxpayer: Person, y: TaxableYear, e: Money, r: Money) defeasible {
    label en official "2/3 of the ratio over the 5th to 8th years, at most 16 percent, single rounding to 1/100th of 1 percent (section 41(c)(3)(B)(ii)(V), (C), (D))";
    when startup_aggregate_41c3B_year9(taxpayer, y, e, r);
    when r > 0.00 USD;
    then fixed_base_percentage_computed_41c3(taxpayer, y, min(0.16, div_round(2.0 * (e / 1.00 USD), 3.0 * (r / 1.00 USD), 4, "HALF_UP")));
}
relation startup_aggregate_41c3B_year10(taxpayer: Person, y: TaxableYear, expenses: Money, receipts: Money) kind institutional;
@source(IRC_S41_C, quote = "in the case of the taxpayer's 10th such taxable year, 5/6 of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th, 6th, 7th, 8th, and 9th such taxable years")
rule StartupAggregate41c3BYear10(taxpayer: Person, y: TaxableYear, m: Integer) defeasible {
    label en official "the aggregates of the years the ramp reads for the 10th year (section 41(c)(3)(B)(ii)(VI))";
    when startup_taxable_year_41c3B(taxpayer, m, y);
    when m == 10;
    then startup_aggregate_41c3B_year10(taxpayer, y, sum(collect all e10: Money, k10: Integer, yk10: TaxableYear where startup_taxable_year_41c3B(taxpayer, k10, yk10) and k10 >= 5 and k10 <= 9 and research_expenses_of_year_for_base_period_41(taxpayer, yk10, e10), empty: 0.00 USD), sum(collect all r10: Money, j10: Integer, yj10: TaxableYear where startup_taxable_year_41c3B(taxpayer, j10, yj10) and j10 >= 5 and j10 <= 9 and gross_receipts_of_year_41c3(taxpayer, yj10, r10), empty: 0.00 USD));
}
@source(IRC_S41_C, quote = "in the case of the taxpayer's 10th such taxable year, 5/6 of the percentage which the aggregate qualified research expenses of the taxpayer for the 5th, 6th, 7th, 8th, and 9th such taxable years")
rule FixedBasePercentageStartupYear1041c3B(taxpayer: Person, y: TaxableYear, e: Money, r: Money) defeasible {
    label en official "5/6 of the ratio over the 5th to 9th years, at most 16 percent, single rounding to 1/100th of 1 percent (section 41(c)(3)(B)(ii)(VI), (C), (D))";
    when startup_aggregate_41c3B_year10(taxpayer, y, e, r);
    when r > 0.00 USD;
    then fixed_base_percentage_computed_41c3(taxpayer, y, min(0.16, div_round(5.0 * (e / 1.00 USD), 6.0 * (r / 1.00 USD), 4, "HALF_UP")));
}
relation startup_aggregate_41c3B_selected(taxpayer: Person, y: TaxableYear, expenses: Money, receipts: Money) kind institutional;
@source(IRC_S41_C, quote = "for taxable years thereafter, the percentage which the aggregate qualified research expenses for any 5 taxable years selected by the taxpayer from among the 5th through the 10th such taxable years")
rule StartupAggregate41c3BSelected(taxpayer: Person, y: TaxableYear, m: Integer) defeasible {
    label en official "the aggregates of the 5 selected years for the 11th and later years (section 41(c)(3)(B)(ii)(VII))";
    when startup_taxable_year_41c3B(taxpayer, m, y);
    when m >= 11;
    then startup_aggregate_41c3B_selected(taxpayer, y,
        sum(collect all es: Money, ys: TaxableYear where selected_startup_year_41c3B(taxpayer, ys) and research_expenses_of_year_for_base_period_41(taxpayer, ys, es), empty: 0.00 USD),
        sum(collect all rs: Money, yr: TaxableYear where selected_startup_year_41c3B(taxpayer, yr) and gross_receipts_of_year_41c3(taxpayer, yr, rs), empty: 0.00 USD));
}
@source(IRC_S41_C, quote = "for taxable years thereafter, the percentage which the aggregate qualified research expenses for any 5 taxable years selected by the taxpayer from among the 5th through the 10th such taxable years")
rule FixedBasePercentageStartupSelected41c3B(taxpayer: Person, y: TaxableYear, e: Money, r: Money) defeasible {
    label en official "the ratio over the 5 selected years, at most 16 percent, 1/100th of 1 percent (section 41(c)(3)(B)(ii)(VII), (C), (D))";
    when startup_aggregate_41c3B_selected(taxpayer, y, e, r);
    when r > 0.00 USD;
    then fixed_base_percentage_computed_41c3(taxpayer, y, min(0.16, div_round(e / 1.00 USD, r / 1.00 USD, 4, "HALF_UP")));
}

pub relation fixed_base_percentage_for_credit_41c3(taxpayer: Person, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the fixed-base percentage the base amount reads: computed from the base period research expenses where the computation has its inputs, else the asserted percentage";
}
rule FixedBasePercentageForCreditComputed41c3(taxpayer: Person, y: TaxableYear, pct: Decimal) defeasible {
    label en official "the computed percentage (section 41(c)(3), with the section 45C(c)(2) expenses in the base period)";
    when fixed_base_percentage_computed_41c3(taxpayer, y, pct);
    then fixed_base_percentage_for_credit_41c3(taxpayer, y, pct);
}
relation has_computed_fixed_base_percentage_41c3(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasComputedFixedBasePercentage41c3(taxpayer: Person, y: TaxableYear, pct: Decimal) defeasible {
    label en official "bridge for the absence test";
    when fixed_base_percentage_computed_41c3(taxpayer, y, pct);
    then has_computed_fixed_base_percentage_41c3(taxpayer, y);
}
rule FixedBasePercentageForCreditAsserted41c3(taxpayer: Person, y: TaxableYear, pct: Decimal) defeasible {
    label en official "the asserted percentage (the earlier channel)";
    when fixed_base_percentage_41c3(taxpayer, y, pct);
    when not_known(has_computed_fixed_base_percentage_41c3(taxpayer, y));
    then fixed_base_percentage_for_credit_41c3(taxpayer, y, pct);
}

// ---- the ASC average of the 3 preceding years (section 41(c)(4)(A)) ----

pub relation average_expenses_preceding_three_years_computed_41c4(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the average of the research expenses of the 3 preceding calendar years, each taken into the base period with the section 45C expenses (section 45C(c)(2), section 41(c)(4)(A)); cents HALF_UP";
}
@source(IRC_S45C_C, quote = "shall be taken into account in determining base period research expenses for purposes of applying section 41 to subsequent taxable years")
rule AverageExpensesPrecedingThreeYearsComputed41c4(taxpayer: Person, y: TaxableYear, n: Integer) defeasible {
    label en official "the sum over the 3 preceding calendar years divided by 3, when all 3 carry expense facts";
    when us.irc.core::year_of(taxpayer, y);
    when us.irc.core::calendar_year_of(y, n);
    when count(collect yb: TaxableYear, mb: Integer, eb: Money where us.irc.core::year_of(taxpayer, yb) and us.irc.core::calendar_year_of(yb, mb) and mb >= n - 3 and mb <= n - 1 and research_expenses_of_year_for_base_period_41(taxpayer, yb, eb)) == 3;
    then average_expenses_preceding_three_years_computed_41c4(taxpayer, y, div_round(
        sum(collect all e: Money, y2: TaxableYear, m2: Integer where us.irc.core::year_of(taxpayer, y2) and us.irc.core::calendar_year_of(y2, m2) and m2 >= n - 3 and m2 <= n - 1 and research_expenses_of_year_for_base_period_41(taxpayer, y2, e), empty: 0.00 USD), 3.0, 2, "HALF_UP"));
}
pub relation average_qualified_research_expenses_for_asc_41(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the average expenses of the 3 preceding years the alternative simplified credit reads: computed from the base period research expenses where the 3 years carry facts, else the asserted average";
}
rule AverageExpensesForAscComputed41(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the computed average";
    when average_expenses_preceding_three_years_computed_41c4(taxpayer, y, amount);
    then average_qualified_research_expenses_for_asc_41(taxpayer, y, amount);
}
relation has_computed_average_expenses_41c4(taxpayer: Person, y: TaxableYear) kind institutional;
rule HasComputedAverageExpenses41c4(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when average_expenses_preceding_three_years_computed_41c4(taxpayer, y, amount);
    then has_computed_average_expenses_41c4(taxpayer, y);
}
rule AverageExpensesForAscAsserted41(taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the asserted average (the earlier channel)";
    when average_qualified_research_expenses_3yr(taxpayer, y, amount);
    when not_known(has_computed_average_expenses_41c4(taxpayer, y));
    then average_qualified_research_expenses_for_asc_41(taxpayer, y, amount);
}
