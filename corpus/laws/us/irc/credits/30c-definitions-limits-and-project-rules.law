// Section 30C — the qualified alternative fuel vehicle refueling property definitions of (c) and (f), the (d)(2) limitation of the personal
// credit, the (e)(1) basis reduction, the (e)(2) seller rule, and the (g) refueling project and prevailing wage rules. Stage 2f (IRC-06,
// DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G1792). Companion of `30c-alternative-fuel-vehicle-refueling-property-credit.law`;
// its credit rules read the property tests as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the meaning of section 179A (other than paragraph (d)(1), which does not apply to property installed on a principal
// residence) is one case fact of the item; the credit and limit amounts are decimals in cents HALF_UP; the personal credit after the (d)(2)
// limit reads the existing personal credit relation.

use self::{
    Asset,
    FuelKind25C,
    IRC_S30C_C,
    IRC_S30C_D,
    IRC_S30C_E,
    IRC_S30C_F,
    IRC_S30C_G,
    Person,
    TaxableYear,
    alternative_fuel_vehicle_refueling_property_personal_credit,
    refueling_property_depreciable_30c,
};

pub enum CleanFuelKind30C { HighBlendGaseousOrEthanolFuel, BiodieselMixture, Electricity, TransportationFuel45Z, OtherFuel }

// --- (c)(1)-(2): qualified alternative fuel vehicle refueling property ---------------------------------------------------------------------------------

pub relation fuel_kind_30c(fuel: Asset, kind: CleanFuelKind30C) kind empirical {
    label en official "the kind of the fuel stored or dispensed: a fuel of at least 85 percent ethanol, natural gas, compressed or liquefied natural gas, liquefied petroleum gas or hydrogen; a biodiesel mixture; electricity; or transportation fuel (section 45Z(d)(5)) (section 30C(c)(1)(B)) — case-asserted";
}
pub relation fuel_listed_component_share_30c(fuel: Asset, share: Decimal) kind empirical {
    label en official "the share by volume, as a fraction, of the fuel that consists of one or more of ethanol, natural gas, compressed natural gas, liquefied natural gas, liquefied petroleum gas or hydrogen (section 30C(c)(1)(B)(i)) — case-asserted";
}
pub relation mixture_component_count_30c(fuel: Asset, count: Decimal) kind empirical {
    label en official "the number of the following in the mixture: biodiesel (section 40A(d)(1)), diesel fuel (section 4083(a)(3)), kerosene (section 30C(c)(1)(B)(ii)(I)) — case-asserted";
}
pub relation biodiesel_share_excluding_kerosene_30c(fuel: Asset, share: Decimal) kind empirical {
    label en official "the share by volume, as a fraction, of the mixture that consists of biodiesel, determined without regard to any kerosene in the mixture (section 30C(c)(1)(B)(ii)(II)) — case-asserted";
}
pub relation clean_burning_fuel_30c(fuel: Asset) kind institutional {
    label en official "section 30C(c)(1)(B): for section 179A(d) only a fuel of at least 85 percent listed components, a mixture of two or more of biodiesel, diesel fuel and kerosene with at least 20 percent biodiesel, electricity, and transportation fuel are clean-burning fuels";
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "Any fuel at least 85 percent of the volume of which consists of one or more of the following")
rule CleanBurningFuelHighBlend30cRule(fuel: Asset, share: Decimal) strict {
    when fuel_kind_30c(fuel, HighBlendGaseousOrEthanolFuel);
    when fuel_listed_component_share_30c(fuel, share);
    when share >= 0.85;
    then clean_burning_fuel_30c(fuel);
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "at least 20 percent of the volume of which consists of biodiesel (as so defined) determined without regard to any kerosene in such mixture")
rule CleanBurningFuelBiodieselMixture30cRule(fuel: Asset, n: Decimal, share: Decimal) strict {
    when fuel_kind_30c(fuel, BiodieselMixture);
    when mixture_component_count_30c(fuel, n);
    when n >= 2.0;
    when biodiesel_share_excluding_kerosene_30c(fuel, share);
    when share >= 0.20;
    then clean_burning_fuel_30c(fuel);
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "Electricity.")
rule CleanBurningFuelElectricity30cRule(fuel: Asset) strict {
    when fuel_kind_30c(fuel, Electricity);
    then clean_burning_fuel_30c(fuel);
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "Any transportation fuel (as defined in section 45Z(d)(5)).")
rule CleanBurningFuelTransportation30cRule(fuel: Asset) strict {
    when fuel_kind_30c(fuel, TransportationFuel45Z);
    then clean_burning_fuel_30c(fuel);
}
pub relation item_meets_179a_meaning_other_than_d1_30c(item: Asset) kind empirical {
    label en official "the property meets the meaning of qualified clean-fuel vehicle refueling property under section 179A other than the exclusion of paragraph (1) of section 179A(d) — case-asserted";
}
pub relation item_stores_or_dispenses_fuel_30c(item: Asset, fuel: Asset) kind empirical {
    label en official "the property stores or dispenses the fuel into the fuel tank of a motor vehicle — case-asserted";
}
pub relation installed_on_taxpayer_principal_residence_30c(item: Asset) kind empirical {
    label en official "the property is installed on property used as the principal residence (section 121) of the taxpayer (section 30C(c)(1)(A)) — case-asserted";
}
pub relation qualified_refueling_property_defined_30c(item: Asset) kind institutional {
    label en official "section 30C(c)(1): property that is qualified clean-fuel vehicle refueling property under section 179A, applied without section 179A(d)(1) for property on the principal residence and with only the listed clean-burning fuels";
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "The term \"qualified alternative fuel vehicle refueling property\" has the same meaning as the term \"qualified clean-fuel vehicle refueling property\" would have under section 179A")
rule QualifiedRefuelingPropertyDefined30cRule(item: Asset, fuel: Asset) strict {
    when item_meets_179a_meaning_other_than_d1_30c(item);
    when item_stores_or_dispenses_fuel_30c(item, fuel);
    when clean_burning_fuel_30c(fuel);
    then qualified_refueling_property_defined_30c(item);
}
pub relation residence_installation_not_excluded_30c(item: Asset) kind institutional {
    label en official "section 30C(c)(1)(A): paragraph (1) of section 179A(d) does not apply to property installed on the principal residence of the taxpayer";
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "paragraph (1) of section 179A(d) did not apply to property installed on property which is used as the principal residence (within the meaning of section 121) of the taxpayer")
rule ResidenceInstallationNotExcluded30cRule(item: Asset) strict {
    when installed_on_taxpayer_principal_residence_30c(item);
    then residence_installation_not_excluded_30c(item);
}
pub relation capable_of_charging_electric_vehicle_battery_30c(item: Asset) kind empirical {
    label en official "the property is capable of charging the battery of a motor vehicle propelled by electricity (section 30C(c)(2)(A)) — case-asserted";
}
pub relation allows_discharging_to_external_load_30c(item: Asset) kind empirical {
    label en official "the property allows discharging electricity from the battery to an electric load external to the vehicle (section 30C(c)(2)(B)) — case-asserted";
}
pub relation bidirectional_charging_not_disqualifying_30c(item: Asset) kind institutional {
    label en official "section 30C(c)(2): property does not fail to be qualified refueling property solely because it can charge a vehicle battery and allows discharge to an external electric load";
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "Property shall not fail to be treated as qualified alternative fuel vehicle refueling property solely because such property")
rule BidirectionalChargingNotDisqualifying30cRule(item: Asset) strict {
    when capable_of_charging_electric_vehicle_battery_30c(item);
    when allows_discharging_to_external_load_30c(item);
    then bidirectional_charging_not_disqualifying_30c(item);
}

// --- (c)(3)(B)(ii): urban area -------------------------------------------------------------------------------------------------------------------------------

pub relation tract_designated_urban_area_by_commerce_30c(tract: Asset) kind empirical {
    label en official "the census tract has, according to the most recent decennial census, been designated as an urban area by the Secretary of Commerce (section 30C(c)(3)(B)(ii)) — case-asserted";
}
pub relation urban_area_defined_30c(tract: Asset) kind institutional {
    label en official "section 30C(c)(3)(B)(ii): a census tract designated as an urban area by the Secretary of Commerce according to the most recent decennial census";
}
@source(IRC_S30C_C, relation = formalizes, coverage = exact, quote = "the term \"urban area\" means a census tract (as defined by the Bureau of the Census) which, according to the most recent decennial census, has been designated as an urban area by the Secretary of Commerce")
rule UrbanAreaDefined30cRule(tract: Asset) strict {
    when tract_designated_urban_area_by_commerce_30c(tract);
    then urban_area_defined_30c(tract);
}

// --- (d)(2): the limitation of the personal credit ------------------------------------------------------------------------------------------------------

pub relation regular_tax_liability_30c(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the regular tax liability of the taxpayer (section 26(b)) — case-asserted";
}
pub relation credits_allowable_under_subpart_a_and_27_30c(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of the credits allowable under subpart A of part IV of subchapter A (other than this section) and section 27 — case-asserted";
}
pub relation tentative_minimum_tax_for_year_30c(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the tentative minimum tax for the taxable year — case-asserted";
}
pub relation personal_credit_limit_30c(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30C(d)(2): the excess (if any) of the regular tax liability reduced by the credits under subpart A and section 27, over the tentative minimum tax";
}
@source(IRC_S30C_D, relation = formalizes, coverage = exact, quote = "shall not exceed the excess (if any) of")
rule PersonalCreditLimit30cRule(taxpayer: Person, y: TaxableYear, tax: Money, credits: Money, tmt: Money) strict {
    when regular_tax_liability_30c(taxpayer, y, tax);
    when credits_allowable_under_subpart_a_and_27_30c(taxpayer, y, credits);
    when tentative_minimum_tax_for_year_30c(taxpayer, y, tmt);
    then personal_credit_limit_30c(taxpayer, y, max(tax - credits - tmt, 0 USD));
}
pub relation personal_credit_after_limit_30c(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30C(d)(2): the personal credit, after paragraph (1), does not exceed the limit";
}
rule PersonalCreditAfterLimit30cRule(taxpayer: Person, y: TaxableYear, credit: Money, limit: Money) defeasible {
    when alternative_fuel_vehicle_refueling_property_personal_credit(taxpayer, y, credit);
    when personal_credit_limit_30c(taxpayer, y, limit);
    then personal_credit_after_limit_30c(taxpayer, y, min(credit, limit));
}

// --- (e)(1)-(2): basis and the seller rule ------------------------------------------------------------------------------------------------------------

pub relation basis_before_credit_30c(taxpayer: Person, item: Asset, basis: Money) kind empirical {
    label en official "the basis of the property before the reduction — case-asserted";
}
pub relation credit_allowed_without_regard_to_d_30c(taxpayer: Person, item: Asset, amount: Money) kind empirical {
    label en official "the credit allowed for the property, determined without regard to subsection (d) — case-asserted";
}
pub relation basis_after_credit_30c(taxpayer: Person, item: Asset, basis: Money) kind institutional {
    label en official "section 30C(e)(1): the basis of the property is reduced by the credit allowed, determined without regard to subsection (d) (not below zero)";
}
@source(IRC_S30C_E, relation = formalizes, coverage = exact, quote = "the basis of any property for which a credit is allowable under subsection (a) shall be reduced by the amount of such credit so allowed")
rule BasisAfterCredit30cRule(taxpayer: Person, item: Asset, basis: Money, credit: Money) strict {
    when basis_before_credit_30c(taxpayer, item, basis);
    when credit_allowed_without_regard_to_d_30c(taxpayer, item, credit);
    then basis_after_credit_30c(taxpayer, item, max(basis - credit, 0 USD));
}
pub relation use_described_in_50b3_or_50b4_30c(item: Asset) kind empirical {
    label en official "the use of the property is described in paragraph (3) or (4) of section 50(b) (tax-exempt organizations, governmental units, foreign persons) — case-asserted";
}
pub relation property_subject_to_lease_30c(item: Asset) kind empirical {
    label en official "the property is subject to a lease — case-asserted";
}
pub relation seller_of_property_30c(seller: Person, item: Asset) kind empirical {
    label en official "the person sold the property to the person or entity using it — case-asserted";
}
pub relation seller_discloses_credit_amount_in_document_30c(seller: Person, item: Asset) kind empirical {
    label en official "the seller clearly discloses to the user, in a document, the amount of any credit allowable under subsection (a) with respect to the property — case-asserted";
}
pub relation seller_treated_as_placing_in_service_30c(seller: Person, item: Asset) kind institutional {
    label en official "section 30C(e)(2): for property used by an entity described in section 50(b)(3) or (4) and not subject to a lease, the seller is treated as the taxpayer that placed the property in service, if it discloses the credit amount in a document";
}
@source(IRC_S30C_E, relation = formalizes, coverage = partial, quote = "the person who sold such property to the person or entity using such property shall be treated as the taxpayer that placed such property in service")
rule SellerTreatedAsPlacingInService30cRule(seller: Person, item: Asset) strict {
    when use_described_in_50b3_or_50b4_30c(item);
    when not_known(property_subject_to_lease_30c(item));
    when seller_of_property_30c(seller, item);
    when seller_discloses_credit_amount_in_document_30c(seller, item);
    then seller_treated_as_placing_in_service_30c(seller, item);
}

// --- (f): two- and three-wheeled electric vehicles ----------------------------------------------------------------------------------------------------

pub relation vehicle_manufactured_primarily_for_public_roads_30c(vehicle: Asset) kind empirical {
    label en official "the motor vehicle is manufactured primarily for use on public streets, roads, or highways (not a vehicle operated exclusively on rails) (section 30C(f)(2)(A)) — case-asserted";
}
pub relation vehicle_wheel_count_30c(vehicle: Asset, wheels: Decimal) kind empirical {
    label en official "the number of wheels of the motor vehicle (section 30C(f)(2)(B)) — case-asserted";
}
pub relation vehicle_propelled_by_electricity_30c(vehicle: Asset) kind empirical {
    label en official "the motor vehicle is propelled by electricity (section 30C(f)(2)(C)) — case-asserted";
}
pub relation motor_vehicle_described_in_f2_30c(vehicle: Asset) kind institutional {
    label en official "section 30C(f)(2): a motor vehicle manufactured primarily for public roads, with 2 or 3 wheels, propelled by electricity";
}
@source(IRC_S30C_F, relation = formalizes, coverage = exact, quote = "is manufactured primarily for use on public streets, roads, or highways")
rule MotorVehicleDescribedInF2Wheels230cRule(vehicle: Asset) strict {
    when vehicle_manufactured_primarily_for_public_roads_30c(vehicle);
    when vehicle_wheel_count_30c(vehicle, 2.0);
    when vehicle_propelled_by_electricity_30c(vehicle);
    then motor_vehicle_described_in_f2_30c(vehicle);
}
rule MotorVehicleDescribedInF2Wheels330cRule(vehicle: Asset) strict {
    when vehicle_manufactured_primarily_for_public_roads_30c(vehicle);
    when vehicle_wheel_count_30c(vehicle, 3.0);
    when vehicle_propelled_by_electricity_30c(vehicle);
    then motor_vehicle_described_in_f2_30c(vehicle);
}
pub relation property_recharges_vehicle_30c(item: Asset, vehicle: Asset) kind empirical {
    label en official "the property is for the recharging of the motor vehicle — case-asserted";
}
pub relation property_meets_a2_requirements_30c(item: Asset) kind empirical {
    label en official "the property meets the requirements of subsection (a)(2) — case-asserted";
}
pub relation recharging_property_included_30c(item: Asset) kind institutional {
    label en official "section 30C(f)(1): property described in subsection (c) for the recharging of a two- or three-wheeled electric motor vehicle is included, but only if it meets the requirements of subsection (a)(2) and is of a character subject to depreciation";
}
@source(IRC_S30C_F, relation = formalizes, coverage = exact, quote = "includes any property described in subsection (c) for the recharging of a motor vehicle described in paragraph (2), but only if such property")
rule RechargingPropertyIncluded30cRule(item: Asset, vehicle: Asset) strict {
    when qualified_refueling_property_defined_30c(item);
    when property_recharges_vehicle_30c(item, vehicle);
    when motor_vehicle_described_in_f2_30c(vehicle);
    when property_meets_a2_requirements_30c(item);
    when refueling_property_depreciable_30c(item);
    then recharging_property_included_30c(item);
}

// --- (g)(1)-(2): the refueling project and the prevailing wage requirement -------------------------------------------------------------------------------

pub relation item_part_of_single_project_30c(item: Asset, project: Asset) kind empirical {
    label en official "the property is one of the properties that are part of a single project (section 30C(g)(1)(B)) — case-asserted";
}
pub relation guidance_published_on_30c(on: Date) kind empirical {
    label en official "the date the Secretary publishes guidance with respect to the requirements of paragraphs (2)(A) and (3) of section 30C(g) — case-asserted, not pinned";
}
pub relation project_construction_begins_on_30c(project: Asset, on: Date) kind empirical {
    label en official "the date the construction of the project begins — case-asserted";
}
pub relation project_satisfies_wage_and_apprenticeship_30c(project: Asset) kind empirical {
    label en official "the project satisfies the requirements of paragraphs (2)(A) and (3) of section 30C(g) — case-asserted";
}
pub relation wages_at_least_prevailing_for_construction_30c(project: Asset) kind empirical {
    label en official "laborers and mechanics employed by the taxpayer or any contractor or subcontractor in the construction of the refueling property that is part of the project are paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality (section 30C(g)(2)(A)) — case-asserted";
}
pub relation prevailing_wage_requirement_met_30c(project: Asset) kind institutional {
    label en official "section 30C(g)(2)(A): prevailing wages are paid in the construction of the refueling property of the project";
}
@source(IRC_S30C_G, relation = formalizes, coverage = exact, quote = "shall be paid wages at rates not less than the prevailing rates for construction, alteration, or repair of a similar character in the locality")
rule PrevailingWageRequirementMet30cRule(project: Asset) strict {
    when wages_at_least_prevailing_for_construction_30c(project);
    then prevailing_wage_requirement_met_30c(project);
}
pub relation project_meets_g1c_requirements_30c(project: Asset) kind institutional {
    label en official "section 30C(g)(1)(C): a project meets the requirements if its construction begins before the date 60 days after the guidance is published, or if it satisfies the requirements of paragraphs (2)(A) and (3)";
}
@source(IRC_S30C_G, relation = formalizes, coverage = exact, quote = "A project the construction of which begins prior to the date that is 60 days after the Secretary publishes guidance with respect to the requirements of paragraphs (2)(A) and (3).")
rule ProjectMeetsG1cGrandfatheredRule(project: Asset, begins: Date, g: Date) strict {
    when project_construction_begins_on_30c(project, begins);
    when guidance_published_on_30c(g);
    when begins < add_calendar_period(g, 60 calendar_day);
    then project_meets_g1c_requirements_30c(project);
}
@source(IRC_S30C_G, relation = formalizes, coverage = exact, quote = "A project which satisfies the requirements of paragraphs (2)(A) and (3).")
rule ProjectMeetsG1cSatisfiesRule(project: Asset) strict {
    when prevailing_wage_requirement_met_30c(project);
    when project_satisfies_wage_and_apprenticeship_30c(project);
    then project_meets_g1c_requirements_30c(project);
}
