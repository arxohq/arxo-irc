// Section 45Z — the sustainable aviation fuel definition of (a)(3)(B), the petition for an emissions rate of (b)(1)(D), the applicable
// material of (d)(5)(B)(i), the SAF certification of (f)(1)(A)(ii), and the ownership and related person rules of (f)(2)-(3). Stage 2f
// (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2d rows of TECH-GAPS G1783). Companion of `45z-clean-fuel-production-credit.law`;
// its credit rules read the SAF facts and the certification as case facts and are NOT rewired to require these relations.
//
// Judgment calls: the "portion not kerosene" of (a)(3)(B) is one case fact of the fuel; the petition of (b)(1)(D) is a power whose
// effect (a pending petition) is read from the raw exercise fact; the certification by an unrelated party and the CORSIA requirements
// are case facts; ownership allocation and related persons mirror the section 45Y(g)(3)-(4) rules (kept as separate relations).

use self::{
    Asset,
    ControlledGroup,
    IRC_S45Z_A,
    IRC_S45Z_B,
    IRC_S45Z_D,
    IRC_S45Z_F,
    MaterialKind40B,
    Person,
    SafMethodology40B,
    TaxableYear,
};

pub enum ApplicableMaterialKind45Z { Glycerides, FreeFattyAcids, FattyAcidEsters, OtherMaterial }
pub enum SafMethodology45Z { Corsia, OtherMethodology }

// --- (a)(3)(B): sustainable aviation fuel --------------------------------------------------------------------------------------------------------------------

pub relation liquid_fuel_45z(fuel: Asset) kind empirical {
    label en official "the fuel is a liquid fuel (section 45Z(a)(3)(B)) — case-asserted";
}
pub relation portion_not_kerosene_45z(fuel: Asset) kind empirical {
    label en official "the portion of the liquid fuel is not kerosene (section 45Z(a)(3)(B)) — case-asserted";
}
pub relation sold_for_use_in_aircraft_45z(fuel: Asset) kind empirical {
    label en official "the fuel is sold for use in an aircraft (section 45Z(a)(3)(B)) — case-asserted";
}
pub relation meets_astm_d7566_45z(fuel: Asset) kind empirical {
    label en official "the fuel meets the requirements of ASTM International Standard D7566 (section 45Z(a)(3)(B)(i)(I)) — case-asserted";
}
pub relation meets_fischer_tropsch_d1655_annex_a1_45z(fuel: Asset) kind empirical {
    label en official "the fuel meets the Fischer Tropsch provisions of ASTM International Standard D1655, Annex A1 (section 45Z(a)(3)(B)(i)(II)) — case-asserted";
}
pub relation derived_from_palm_fatty_acid_distillates_45z(fuel: Asset) kind empirical {
    label en official "the fuel is derived from palm fatty acid distillates (section 45Z(a)(3)(B)(ii)) — case-asserted";
}
pub relation derived_from_petroleum_45z(fuel: Asset) kind empirical {
    label en official "the fuel is derived from petroleum (section 45Z(a)(3)(B)(ii)) — case-asserted";
}
pub relation sustainable_aviation_fuel_defined_45z(fuel: Asset) kind institutional {
    label en official "section 45Z(a)(3)(B): liquid fuel, the portion of which is not kerosene, sold for use in an aircraft, that meets ASTM D7566 or the Fischer Tropsch provisions of ASTM D1655 Annex A1 and is not derived from palm fatty acid distillates or petroleum";
}
@source(IRC_S45Z_A, relation = formalizes, coverage = exact, quote = "the term \"sustainable aviation fuel\" means liquid fuel, the portion of which is not kerosene, which is sold for use in an aircraft")
rule SustainableAviationFuelDefinedD7566Rule(fuel: Asset) strict {
    when liquid_fuel_45z(fuel);
    when portion_not_kerosene_45z(fuel);
    when sold_for_use_in_aircraft_45z(fuel);
    when meets_astm_d7566_45z(fuel);
    when not_known(derived_from_palm_fatty_acid_distillates_45z(fuel));
    when not_known(derived_from_petroleum_45z(fuel));
    then sustainable_aviation_fuel_defined_45z(fuel);
}
rule SustainableAviationFuelDefinedFischerTropschRule(fuel: Asset) strict {
    when liquid_fuel_45z(fuel);
    when portion_not_kerosene_45z(fuel);
    when sold_for_use_in_aircraft_45z(fuel);
    when meets_fischer_tropsch_d1655_annex_a1_45z(fuel);
    when not_known(derived_from_palm_fatty_acid_distillates_45z(fuel));
    when not_known(derived_from_petroleum_45z(fuel));
    then sustainable_aviation_fuel_defined_45z(fuel);
}

// --- (b)(1)(D): the petition for an emissions rate -------------------------------------------------------------------------------------------------------------

pub relation emissions_rate_established_under_b1b_45z(fuel: Asset) kind empirical {
    label en official "an emissions rate has been established for the fuel under subparagraph (B) — case-asserted";
}
pub relation taxpayer_produces_fuel_45z(taxpayer: Person, fuel: Asset) kind empirical {
    label en official "the taxpayer produces the fuel — case-asserted";
}
pub relation files_petition_for_emissions_rate_45z(taxpayer: Person, fuel: Asset) kind empirical {
    label en official "the taxpayer's exercise of the section 45Z(b)(1)(D) power to file a petition with the Secretary for the determination of the emissions rate of the fuel";
}
pub relation emissions_rate_petition_pending_45z(taxpayer: Person, fuel: Asset) kind institutional {
    label en official "section 45Z(b)(1)(D): a petition for the determination of the emissions rate of a transportation fuel for which no rate has been established is filed with the Secretary";
}
@source(IRC_S45Z_B, relation = formalizes, coverage = exact, quote = "a taxpayer producing such fuel may file a petition with the Secretary for determination of the emissions rate with respect to such fuel")
rule Section45ZB1DPetitionRule(taxpayer: Person, fuel: Asset) defeasible {
    when taxpayer_produces_fuel_45z(taxpayer, fuel);
    when files_petition_for_emissions_rate_45z(taxpayer, fuel);
    when not_known(emissions_rate_established_under_b1b_45z(fuel));
    then power Section45ZB1DEmissionsRatePetition {
        holder taxpayer;
        over us.irc.core::Secretary;
        exercise files_petition_for_emissions_rate_45z(taxpayer, fuel);
        valid_when taxpayer_produces_fuel_45z(taxpayer, fuel);
        effect create(emissions_rate_petition_pending_45z(taxpayer, fuel));
        window [-infinity, infinity);
    };
}

// --- (d)(5)(B)(i): applicable material -----------------------------------------------------------------------------------------------------------------------------

pub relation material_kind_45z(material: Asset, kind: ApplicableMaterialKind45Z) kind empirical {
    label en official "the kind of the material (section 45Z(d)(5)(B)(i)) — case-asserted";
}
pub relation applicable_material_45z(material: Asset) kind institutional {
    label en official "section 45Z(d)(5)(B)(i): monoglycerides, diglycerides and triglycerides, free fatty acids, and fatty acid esters";
}
@source(IRC_S45Z_D, relation = formalizes, coverage = exact, quote = "monoglycerides, diglycerides, and triglycerides")
rule ApplicableMaterialGlyceridesRule(material: Asset) strict {
    when material_kind_45z(material, Glycerides);
    then applicable_material_45z(material);
}
@source(IRC_S45Z_D, relation = formalizes, coverage = exact, quote = "free fatty acids")
rule ApplicableMaterialFreeFattyAcidsRule(material: Asset) strict {
    when material_kind_45z(material, FreeFattyAcids);
    then applicable_material_45z(material);
}
@source(IRC_S45Z_D, relation = formalizes, coverage = exact, quote = "fatty acid esters")
rule ApplicableMaterialEstersRule(material: Asset) strict {
    when material_kind_45z(material, FattyAcidEsters);
    then applicable_material_45z(material);
}

// --- (f)(1)(A)(ii): the sustainable aviation fuel certification ---------------------------------------------------------------------------------------

pub relation certification_from_unrelated_party_45z(fuel: Asset) kind empirical {
    label en official "a certification, in such form and manner as the Secretary prescribes, from an unrelated party (section 45Z(f)(1)(A)(ii)(I)(aa)) — case-asserted";
}
pub relation saf_methodology_45z(fuel: Asset, methodology: SafMethodology45Z) kind empirical {
    label en official "the methodology of subsection (b)(1)(B)(iii): the Carbon Offsetting and Reduction Scheme for International Aviation (subclause (I)) or another methodology (subclause (II)) — case-asserted";
}
pub relation complies_with_corsia_requirements_45z(fuel: Asset) kind empirical {
    label en official "the certification demonstrates compliance with any general requirements, supply chain traceability requirements, and information transmission requirements established under the Carbon Offsetting and Reduction Scheme for International Aviation (section 45Z(f)(1)(A)(ii)(I)(aa)(AA)) — case-asserted";
}
pub relation complies_with_similar_requirements_45z(fuel: Asset) kind empirical {
    label en official "for a methodology described in subclause (II), the certification demonstrates compliance with requirements similar to those of subitem (AA) (section 45Z(f)(1)(A)(ii)(I)(aa)(BB)) — case-asserted";
}
pub relation other_information_required_by_secretary_provided_45z(fuel: Asset) kind empirical {
    label en official "such other information with respect to the fuel as the Secretary may require has been provided (section 45Z(f)(1)(A)(ii)(I)(bb)) — case-asserted";
}
pub relation saf_certification_requirements_met_45z(fuel: Asset) kind institutional {
    label en official "section 45Z(f)(1)(A)(ii)(I): a certification from an unrelated party demonstrating compliance with the CORSIA requirements (or similar requirements for another methodology), and such other information as the Secretary requires";
}
@source(IRC_S45Z_F, relation = formalizes, coverage = exact, quote = "certification (in such form and manner as the Secretary shall prescribe) from an unrelated party demonstrating compliance with")
rule SafCertificationRequirementsMetCorsiaRule(fuel: Asset) strict {
    when certification_from_unrelated_party_45z(fuel);
    when saf_methodology_45z(fuel, Corsia);
    when complies_with_corsia_requirements_45z(fuel);
    when other_information_required_by_secretary_provided_45z(fuel);
    then saf_certification_requirements_met_45z(fuel);
}
rule SafCertificationRequirementsMetOtherMethodologyRule(fuel: Asset) strict {
    when certification_from_unrelated_party_45z(fuel);
    when saf_methodology_45z(fuel, OtherMethodology);
    when complies_with_similar_requirements_45z(fuel);
    when other_information_required_by_secretary_provided_45z(fuel);
    then saf_certification_requirements_met_45z(fuel);
}

// --- (f)(2)-(3): ownership allocation and related persons ---------------------------------------------------------------------------------------------

pub relation fuel_production_gallons_of_facility_45z(facility: Asset, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "the gallons of fuel produced at the facility during the taxable year — case-asserted";
}
pub relation ownership_share_of_gross_sales_45z(facility: Asset, owner: Person, share: Decimal) kind empirical {
    label en official "the owner's ownership interest in the gross sales from the facility, as a fraction (section 45Z(f)(2)) — case-asserted";
}
pub relation production_allocated_to_owner_gallons_45z(facility: Asset, owner: Person, y: TaxableYear, gallons: Decimal) kind institutional {
    label en official "section 45Z(f)(2): production from a facility with more than one owner is allocated in proportion to the owners' interests in gross sales (except as provided in regulations)";
}
@source(IRC_S45Z_F, relation = formalizes, coverage = partial, quote = "production from the facility shall be allocated among such persons in proportion to their respective ownership interests in the gross sales from such facility")
rule ProductionAllocatedToFacilityOwner45zRule(facility: Asset, owner: Person, y: TaxableYear, total: Decimal, share: Decimal) strict {
    when fuel_production_gallons_of_facility_45z(facility, y, total);
    when ownership_share_of_gross_sales_45z(facility, owner, share);
    then production_allocated_to_owner_gallons_45z(facility, owner, y, total * share);
}
pub relation single_employer_under_52b_45z(group: ControlledGroup, member: Person, y: TaxableYear) kind empirical {
    label en official "the person would be treated as a single employer with the group under the regulations prescribed under section 52(b) (section 45Z(f)(3)) — case-asserted";
}
pub relation persons_related_45z(a: Person, b: Person, y: TaxableYear) kind institutional {
    label en official "section 45Z(f)(3): persons are related if they would be treated as a single employer under the section 52(b) regulations";
}
@source(IRC_S45Z_F, relation = formalizes, coverage = partial, quote = "Persons shall be treated as related to each other if such persons would be treated as a single employer under the regulations prescribed under section 52(b).")
rule PersonsRelated45zRule(a: Person, b: Person, y: TaxableYear, group: ControlledGroup) strict {
    when single_employer_under_52b_45z(group, a, y);
    when single_employer_under_52b_45z(group, b, y);
    then persons_related_45z(a, b, y);
}
pub relation consolidated_member_of_group_45z(corp: Person, group: Person) kind empirical {
    label en official "the corporation is a member of an affiliated group of corporations filing a consolidated return (section 45Z(f)(3)) — case-asserted";
}
pub relation fuel_sold_by_member_to_unrelated_person_45z(seller: Person, buyer: Person) kind empirical {
    label en official "another member of the consolidated group sells the fuel to the unrelated person — case-asserted";
}
pub relation treated_as_selling_fuel_to_unrelated_person_45z(corp: Person, buyer: Person) kind institutional {
    label en official "section 45Z(f)(3), last sentence: a member of a consolidated group is treated as selling fuel to an unrelated person if another member sells it to that person";
}
rule TreatedAsSellingFuelToUnrelatedPersonRule(corp: Person, group: Person, seller: Person, buyer: Person) strict {
    when consolidated_member_of_group_45z(corp, group);
    when consolidated_member_of_group_45z(seller, group);
    when fuel_sold_by_member_to_unrelated_person_45z(seller, buyer);
    then treated_as_selling_fuel_to_unrelated_person_45z(corp, buyer);
}
