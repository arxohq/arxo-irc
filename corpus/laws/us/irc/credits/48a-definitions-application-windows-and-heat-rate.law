// Section 48A — the qualified investment of (b)(1), the definitions of (c), the application windows, evidence period and pool
// caps of (d)(2)-(4), the advanced coal-based generation technology test of (f) with the design net heat rate, and the (h) directive
// to modify awards. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the stage 2c rows of TECH-GAPS G1522, G1523). Companion of
// `48a-qualifying-advanced-coal-project-credit.law`; its credit rules read `qualified_investment_48a` as a case fact and are NOT
// rewired to require these relations.
//
// Judgment calls: the performance table of (f)(1)(B) is not in the pinned text (an empty table row, SOURCE_GAP), so "designed to meet
// the performance requirements" is a case fact, with the subbituminous SO2 level of (f)(1) modelled; the correction of the design net
// heat rate to the site reference conditions is a case fact (the reference conditions are asserted below); heat rates and formula
// results are decimals to 6 places HALF_UP.

use self::{
    AdvancedCoalProjectClass48A,
    Asset,
    CoalKind48B,
    IRC_S48A_B,
    IRC_S48A_C,
    IRC_S48A_D,
    IRC_S48A_F,
    IRC_S48A_H,
    Person,
    TaxableYear,
    advanced_coal_project_class_48a,
    qualifying_advanced_coal_project_48a,
};

pub enum CoalKind48A { Anthracite, BituminousCoal, SubbituminousCoal, Lignite, Peat, OtherSolidFuel }

// --- (c)(4)-(7): coal, capture capability, electric generation unit, integrated gasification combined cycle -----------------------------

pub relation coal_kind_48a(fuel: Asset, kind: CoalKind48A) kind empirical {
    label en official "the kind of the solid fuel (section 48A(c)(4)) — case-asserted";
}
pub relation coal_48a(fuel: Asset) kind institutional {
    label en official "section 48A(c)(4): coal means anthracite, bituminous coal, subbituminous coal, lignite, and peat";
}
@source(IRC_S48A_C, relation = formalizes, coverage = exact, quote = "The term \"coal\" means anthracite, bituminous coal, subbituminous coal, lignite, and peat.")
rule CoalAnthracite48aRule(fuel: Asset) strict {
    when coal_kind_48a(fuel, Anthracite);
    then coal_48a(fuel);
}
rule CoalBituminous48aRule(fuel: Asset) strict {
    when coal_kind_48a(fuel, BituminousCoal);
    then coal_48a(fuel);
}
rule CoalSubbituminous48aRule(fuel: Asset) strict {
    when coal_kind_48a(fuel, SubbituminousCoal);
    then coal_48a(fuel);
}
rule CoalLignite48aRule(fuel: Asset) strict {
    when coal_kind_48a(fuel, Lignite);
    then coal_48a(fuel);
}
rule CoalPeat48aRule(fuel: Asset) strict {
    when coal_kind_48a(fuel, Peat);
    then coal_48a(fuel);
}
pub relation net_electrical_share_of_annual_output_48a(unit: Asset, share: Decimal) kind empirical {
    label en official "the share, as a fraction, of the total annual net output of the facility that is electrical power (section 48A(c)(6)) — case-asserted";
}
pub relation electric_generation_unit_48a(unit: Asset) kind institutional {
    label en official "section 48A(c)(6): a facility at least 50 percent of the total annual net output of which is electrical power, including an otherwise eligible facility used in an industrial application";
}
@source(IRC_S48A_C, relation = formalizes, coverage = exact, quote = "any facility at least 50 percent of the total annual net output of which is electrical power")
rule ElectricGenerationUnit48aRule(unit: Asset, share: Decimal) strict {
    when net_electrical_share_of_annual_output_48a(unit, share);
    when share >= 0.50;
    then electric_generation_unit_48a(unit);
}
pub relation converts_coal_to_synthesis_gas_for_combined_cycle_48a(unit: Asset) kind empirical {
    label en official "the unit produces electricity by converting coal to synthesis gas which is used to fuel a combined-cycle plant (section 48A(c)(7)) — case-asserted";
}
pub relation combined_cycle_has_combustion_turbine_and_steam_turbine_48a(unit: Asset) kind empirical {
    label en official "the combined-cycle plant produces electricity from both a combustion turbine (including a combustion turbine/fuel cell hybrid) and a steam turbine (section 48A(c)(7)) — case-asserted";
}
pub relation integrated_gasification_combined_cycle_48a(unit: Asset) kind institutional {
    label en official "section 48A(c)(7): an electric generation unit which converts coal to synthesis gas fuelling a combined-cycle plant with a combustion turbine and a steam turbine";
}
@source(IRC_S48A_C, relation = formalizes, coverage = exact, quote = "The term \"integrated gasification combined cycle\" means an electric generation unit which produces electricity by converting coal to synthesis gas which is used to fuel a combined-cycle plant")
rule IntegratedGasificationCombinedCycle48aRule(unit: Asset) strict {
    when electric_generation_unit_48a(unit);
    when converts_coal_to_synthesis_gas_for_combined_cycle_48a(unit);
    when combined_cycle_has_combustion_turbine_and_steam_turbine_48a(unit);
    then integrated_gasification_combined_cycle_48a(unit);
}
pub relation capable_of_adding_components_that_capture_and_sequester_ghg_48a(unit: Asset) kind empirical {
    label en official "the facility is capable of adding components which can capture, separate on a long-term basis, isolate, remove, and sequester greenhouse gases which result from the generation of electricity (section 48A(c)(5)) — case-asserted";
}
pub relation greenhouse_gas_capture_capability_48a(unit: Asset) kind institutional {
    label en official "section 48A(c)(5): an integrated gasification combined cycle facility capable of adding components which can capture and sequester the greenhouse gases of the generation of electricity";
}
@source(IRC_S48A_C, relation = formalizes, coverage = exact, quote = "means an integrated gasification combined cycle technology facility capable of adding components which can capture, separate on a long-term basis, isolate, remove, and sequester greenhouse gases")
rule GreenhouseGasCaptureCapability48aRule(unit: Asset) strict {
    when integrated_gasification_combined_cycle_48a(unit);
    when capable_of_adding_components_that_capture_and_sequester_ghg_48a(unit);
    then greenhouse_gas_capture_capability_48a(unit);
}

// --- (f)(2): the design net heat rate ---------------------------------------------------------------------------------------------------------

pub relation design_annual_heat_input_btu_48a(unit: Asset, btu: Decimal) kind empirical {
    label en official "the design annual heat input to the unit, in Btu, higher heating value (section 48A(f)(2)(A)-(B)) — case-asserted";
}
pub relation rated_net_electrical_output_kwh_48a(unit: Asset, kwh: Decimal) kind empirical {
    label en official "the rated net electrical power, fuels and chemicals output of the unit, in kilowatt hours, determined without regard to the cogeneration of steam (section 48A(f)(2)(B)) — case-asserted";
}
pub relation design_coal_heat_content_btu_per_pound_48a(unit: Asset, btu: Decimal) kind empirical {
    label en official "the heat content of the design coal to be used by the unit, in Btu per pound (section 48A(f)(2)(C)) — case-asserted";
}
pub relation site_reference_conditions_48a(elevation_feet: Decimal, psia: Decimal, dry_bulb_f: Decimal, wet_bulb_f: Decimal, humidity: Decimal) kind institutional {
    label en official "section 48A(f)(2)(D): the site reference conditions: elevation 500 feet, air pressure 14.4 psia, dry bulb 63 degrees F, wet bulb 54 degrees F, relative humidity 55 percent";
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "temperature, dry bulb of 63°F")
assert "48a-f2d-site-reference-conditions": site_reference_conditions_48a(500.0, 14.4, 63.0, 54.0, 0.55);
pub relation corrected_to_site_reference_conditions_48a(unit: Asset) kind empirical {
    label en official "the design net heat rate of the unit is corrected for the site reference conditions of section 48A(f)(2)(D) — case-asserted";
}
pub relation unit_net_heat_rate_48a(unit: Asset, rate: Decimal) kind institutional {
    label en official "section 48A(f)(2)(B): the design annual heat input over the rated net electrical output, in Btu per kilowatt hour (6 decimals HALF_UP)";
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "be based on the design annual heat input to the unit and the rated net electrical power, fuels, and chemicals output of the unit (determined without regard to the cogeneration of steam by the unit)")
rule UnitNetHeatRate48aRule(unit: Asset, input: Decimal, output: Decimal) strict {
    when design_annual_heat_input_btu_48a(unit, input);
    when rated_net_electrical_output_kwh_48a(unit, output);
    when output > 0.0;
    then unit_net_heat_rate_48a(unit, div_round(input, output, 6, "HALF_UP"));
}
pub relation design_net_heat_rate_48a(unit: Asset, rate: Decimal) kind institutional {
    label en official "section 48A(f)(2)(C): the unit net heat rate adjusted for the heat content of the design coal: unchanged at 13,500 Btu per pound or more, times 1 minus 0.013 per 1,000 Btu below 13,500 (above 7,000), times 1 minus 0.018 per 1,000 Btu below 13,500 (7,000 or less)";
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "if the heat content is less than 13,500 Btu per pound, but greater than 7,000 Btu per pound, according to the following formula")
rule DesignNetHeatRateMiddleCoal48aRule(unit: Asset, base: Decimal, hc: Decimal) strict {
    when unit_net_heat_rate_48a(unit, base);
    when corrected_to_site_reference_conditions_48a(unit);
    when design_coal_heat_content_btu_per_pound_48a(unit, hc);
    when hc < 13500.0;
    when hc > 7000.0;
    then design_net_heat_rate_48a(unit, round(base * (1.0 - div_round(13500.0 - hc, 1000.0, 10, "HALF_UP") * 0.013), 6, "HALF_UP"));
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "if the heat content is less than or equal to 7,000 Btu per pound, according to the following formula")
rule DesignNetHeatRateLowCoal48aRule(unit: Asset, base: Decimal, hc: Decimal) strict {
    when unit_net_heat_rate_48a(unit, base);
    when corrected_to_site_reference_conditions_48a(unit);
    when design_coal_heat_content_btu_per_pound_48a(unit, hc);
    when hc <= 7000.0;
    then design_net_heat_rate_48a(unit, round(base * (1.0 - div_round(13500.0 - hc, 1000.0, 10, "HALF_UP") * 0.018), 6, "HALF_UP"));
}
rule DesignNetHeatRateHighCoal48aRule(unit: Asset, base: Decimal, hc: Decimal) strict {
    when unit_net_heat_rate_48a(unit, base);
    when corrected_to_site_reference_conditions_48a(unit);
    when design_coal_heat_content_btu_per_pound_48a(unit, hc);
    when hc >= 13500.0;
    then design_net_heat_rate_48a(unit, base);
}

// --- (f)(3): the existing-unit alternative --------------------------------------------------------------------------------------------------------

pub relation unit_in_existence_on_enactment_48a(unit: Asset) kind empirical {
    label en official "the electric generation unit is in existence on the date of the enactment of section 48A (section 48A(f)(3)) — case-asserted";
}
pub relation efficiency_as_operated_48a(unit: Asset, efficiency: Decimal) kind empirical {
    label en official "the efficiency of the unit as operated, as a fraction — case-asserted";
}
pub relation thermal_design_efficiency_48a(unit: Asset, efficiency: Decimal) kind empirical {
    label en official "the overall thermal design efficiency of the unit after the project, as a fraction (section 48A(f)(3)) — case-asserted";
}
pub relation existing_unit_alternative_met_48a(unit: Asset) kind institutional {
    label en official "section 48A(f)(3): an existing unit achieves a minimum efficiency of 35 percent and a thermal design efficiency improvement of at least 7 (coal over 9,000 Btu), 6 (7,000 to 9,000) or 4 (under 7,000) percentage points";
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "7 percentage points for coal of more than 9,000 Btu")
rule ExistingUnitAlternativeHighCoal48aRule(unit: Asset, hc: Decimal, base: Decimal, design: Decimal) strict {
    when unit_in_existence_on_enactment_48a(unit);
    when design_coal_heat_content_btu_per_pound_48a(unit, hc);
    when hc > 9000.0;
    when efficiency_as_operated_48a(unit, base);
    when thermal_design_efficiency_48a(unit, design);
    when design >= 0.35;
    when design - base >= 0.07;
    then existing_unit_alternative_met_48a(unit);
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "6 percentage points for coal of 7,000 to 9,000 Btu")
rule ExistingUnitAlternativeMiddleCoal48aRule(unit: Asset, hc: Decimal, base: Decimal, design: Decimal) strict {
    when unit_in_existence_on_enactment_48a(unit);
    when design_coal_heat_content_btu_per_pound_48a(unit, hc);
    when hc >= 7000.0;
    when hc <= 9000.0;
    when efficiency_as_operated_48a(unit, base);
    when thermal_design_efficiency_48a(unit, design);
    when design >= 0.35;
    when design - base >= 0.06;
    then existing_unit_alternative_met_48a(unit);
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "4 percentage points for coal of less than 7,000 Btu")
rule ExistingUnitAlternativeLowCoal48aRule(unit: Asset, hc: Decimal, base: Decimal, design: Decimal) strict {
    when unit_in_existence_on_enactment_48a(unit);
    when design_coal_heat_content_btu_per_pound_48a(unit, hc);
    when hc < 7000.0;
    when efficiency_as_operated_48a(unit, base);
    when thermal_design_efficiency_48a(unit, design);
    when design >= 0.35;
    when design - base >= 0.04;
    then existing_unit_alternative_met_48a(unit);
}

// --- (f)(1): the advanced coal-based generation technology test ----------------------------------------------------------------------------------

pub relation designed_to_meet_performance_table_48a(unit: Asset) kind empirical {
    label en official "the unit is designed to meet the performance requirements in the table of section 48A(f)(1)(B) (the table is not in the pinned text) — case-asserted";
}
pub relation feedstock_substantially_all_subbituminous_48a(unit: Asset) kind empirical {
    label en official "the unit is designed for the use of feedstock substantially all of which is subbituminous coal (section 48A(f)(1), SO2 rule) — case-asserted";
}
pub relation so2_removal_design_level_48a(unit: Asset, level: Decimal) kind empirical {
    label en official "the SO2 removal design level of the unit, as a fraction — case-asserted";
}
pub relation so2_emission_level_pounds_per_million_btu_48a(unit: Asset, level: Decimal) kind empirical {
    label en official "the SO2 emission level of the unit in pounds per million Btu, on a 30-day average — case-asserted";
}
pub relation so2_removal_design_requirement_met_48a(unit: Asset) kind institutional {
    label en official "section 48A(f)(1): for a unit designed for substantially all subbituminous coal feedstock, 99 percent SO2 removal or an emission level of 0.04 pounds or less per million Btu on a 30-day average";
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "shall be 99 percent SO2 removal or the achievement of an emission level of 0.04 pounds or less of SO2 per million Btu, determined on a 30-day average")
rule So2RemovalDesignRequirementMetByRemoval48aRule(unit: Asset, level: Decimal) strict {
    when feedstock_substantially_all_subbituminous_48a(unit);
    when so2_removal_design_level_48a(unit, level);
    when level >= 0.99;
    then so2_removal_design_requirement_met_48a(unit);
}
rule So2RemovalDesignRequirementMetByEmissionLevel48aRule(unit: Asset, level: Decimal) strict {
    when feedstock_substantially_all_subbituminous_48a(unit);
    when so2_emission_level_pounds_per_million_btu_48a(unit, level);
    when level <= 0.04;
    then so2_removal_design_requirement_met_48a(unit);
}
pub relation uses_advanced_coal_based_generation_technology_48a(unit: Asset) kind institutional {
    label en official "section 48A(f)(1), (c)(2): an electric generation unit using integrated gasification combined cycle technology, or with a design net heat rate of 8,530 Btu/kWh (40 percent efficiency) or the existing-unit alternative, and designed to meet the performance requirements";
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "uses integrated gasification combined cycle technology")
rule AdvancedCoalTechnologyIgcc48aRule(unit: Asset) strict {
    when electric_generation_unit_48a(unit);
    when integrated_gasification_combined_cycle_48a(unit);
    when designed_to_meet_performance_table_48a(unit);
    then uses_advanced_coal_based_generation_technology_48a(unit);
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "has a design net heat rate of 8530 Btu/kWh (40 percent efficiency)")
rule AdvancedCoalTechnologyHeatRate48aRule(unit: Asset, rate: Decimal) strict {
    when electric_generation_unit_48a(unit);
    when design_net_heat_rate_48a(unit, rate);
    when rate <= 8530.0;
    when not_known(unit_in_existence_on_enactment_48a(unit));
    when designed_to_meet_performance_table_48a(unit);
    then uses_advanced_coal_based_generation_technology_48a(unit);
}
@source(IRC_S48A_F, relation = formalizes, coverage = exact, quote = "such unit uses advanced coal-based generation technology if, in lieu of the requirements under paragraph (1)(A)(ii)")
rule AdvancedCoalTechnologyExistingUnit48aRule(unit: Asset) strict {
    when electric_generation_unit_48a(unit);
    when existing_unit_alternative_met_48a(unit);
    when designed_to_meet_performance_table_48a(unit);
    then uses_advanced_coal_based_generation_technology_48a(unit);
}

// --- (c)(3), (b)(1): eligible property and the qualified investment ----------------------------------------------------------------------------------

pub relation part_of_project_48a(part: Asset, project: Asset) kind empirical {
    label en official "the property is part of the qualifying advanced coal project — case-asserted";
}
pub relation part_necessary_for_gasification_of_coal_48a(part: Asset) kind empirical {
    label en official "the property is necessary for the gasification of coal, including coal handling and gas separation equipment (section 48A(c)(3)(A)) — case-asserted";
}
pub relation project_is_igcc_48a(project: Asset) kind empirical {
    label en official "the qualifying advanced coal project uses an integrated gasification combined cycle (section 48A(c)(3)(A)) — case-asserted";
}
pub relation eligible_property_48a(part: Asset, project: Asset) kind institutional {
    label en official "section 48A(c)(3): for an integrated gasification combined cycle project, the property necessary for the gasification of coal; for any other qualifying project, any property that is part of it";
}
@source(IRC_S48A_C, relation = formalizes, coverage = exact, quote = "any property which is a part of such project and is necessary for the gasification of coal, including any coal handling and gas separation equipment")
rule EligiblePropertyIgcc48aRule(part: Asset, project: Asset) strict {
    when part_of_project_48a(part, project);
    when project_is_igcc_48a(project);
    when part_necessary_for_gasification_of_coal_48a(part);
    then eligible_property_48a(part, project);
}
@source(IRC_S48A_C, relation = formalizes, coverage = exact, quote = "in the case of any other qualifying advanced coal project, any property which is a part of such project")
rule EligiblePropertyOther48aRule(part: Asset, project: Asset) strict {
    when part_of_project_48a(part, project);
    when not_known(project_is_igcc_48a(project));
    then eligible_property_48a(part, project);
}
pub relation part_basis_placed_in_service_in_year_48a(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the basis of the property placed in service by the taxpayer during the taxable year — case-asserted";
}
pub relation part_completed_by_taxpayer_48a(taxpayer: Person, part: Asset) kind empirical {
    label en official "the construction, reconstruction or erection of the property is completed by the taxpayer (section 48A(b)(1)(A)(i)) — case-asserted";
}
pub relation part_acquired_with_original_use_48a(taxpayer: Person, part: Asset) kind empirical {
    label en official "the property is acquired by the taxpayer and its original use commences with the taxpayer (section 48A(b)(1)(A)(ii)) — case-asserted";
}
pub relation part_depreciation_allowable_48a(part: Asset) kind empirical {
    label en official "depreciation (or amortization in lieu of depreciation) is allowable with respect to the property (section 48A(b)(1)(B)) — case-asserted";
}
pub relation qualified_part_basis_48a(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48A(b)(1): the basis of eligible property of a qualifying advanced coal project placed in service by the taxpayer in the year, completed by the taxpayer or acquired with original use, and depreciable";
}
@source(IRC_S48A_B, relation = formalizes, coverage = exact, quote = "the qualified investment for any taxable year is the basis of eligible property placed in service by the taxpayer during such taxable year which is part of a qualifying advanced coal project")
rule QualifiedPartBasisCompleted48aRule(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) defeasible {
    when qualifying_advanced_coal_project_48a(project);
    when eligible_property_48a(part, project);
    when part_basis_placed_in_service_in_year_48a(taxpayer, project, part, y, amount);
    when part_completed_by_taxpayer_48a(taxpayer, part);
    when part_depreciation_allowable_48a(part);
    then qualified_part_basis_48a(taxpayer, project, part, y, amount);
}
rule QualifiedPartBasisAcquired48aRule(taxpayer: Person, project: Asset, part: Asset, y: TaxableYear, amount: Money) defeasible {
    when qualifying_advanced_coal_project_48a(project);
    when eligible_property_48a(part, project);
    when part_basis_placed_in_service_in_year_48a(taxpayer, project, part, y, amount);
    when part_acquired_with_original_use_48a(taxpayer, part);
    when part_depreciation_allowable_48a(part);
    then qualified_part_basis_48a(taxpayer, project, part, y, amount);
}
pub relation qualified_investment_computed_48a(taxpayer: Person, project: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48A(b)(1): the sum of the basis of the qualified eligible property of the project placed in service in the year";
}
rule QualifiedInvestmentComputed48aRule(taxpayer: Person, project: Asset, y: TaxableYear, one_part: Asset, one_amount: Money) defeasible {
    when qualified_part_basis_48a(taxpayer, project, one_part, y, one_amount);
    then qualified_investment_computed_48a(taxpayer, project, y,
        sum(collect all a: Money, p: Asset where qualified_part_basis_48a(taxpayer, project, p, y, a), empty: 0 USD));
}

// --- (d)(2): application windows, evidence period ----------------------------------------------------------------------------------------------------

pub relation program_established_on_48a(on: Date) kind empirical {
    label en official "the date the Secretary establishes the qualifying advanced coal project program under section 48A(d)(1) — case-asserted";
}
pub relation third_period_prescribed_start_48a(on: Date) kind empirical {
    label en official "the date prescribed by the Secretary for the start of the second application period of section 48A(d)(2)(A)(ii) — case-asserted";
}
pub relation application_submitted_on_48a(applicant: Person, project: Asset, on: Date) kind empirical {
    label en official "the applicant submits the application for certification on this date — case-asserted";
}
pub relation application_within_window_48a(applicant: Person, project: Asset) kind institutional {
    label en official "section 48A(d)(2)(A): an application for the (3)(B)(i)-(ii) allocations is submitted within the 3-year period beginning on the date the program is established; for the (3)(B)(iii) allocation, within the 3-year period beginning at the earlier of the end of the first period or the date prescribed by the Secretary";
}
@source(IRC_S48A_D, relation = formalizes, coverage = exact, quote = "during the 3-year period beginning on the date the Secretary establishes the program under paragraph (1)")
rule ApplicationWithinFirstWindowIgcc48aRule(applicant: Person, project: Asset, on: Date, start: Date) strict {
    when application_submitted_on_48a(applicant, project, on);
    when advanced_coal_project_class_48a(project, IntegratedGasificationFirstRound);
    when program_established_on_48a(start);
    when on >= start;
    when on < add_calendar_period(start, 36 calendar_month);
    then application_within_window_48a(applicant, project);
}
rule ApplicationWithinFirstWindowOther48aRule(applicant: Person, project: Asset, on: Date, start: Date) strict {
    when application_submitted_on_48a(applicant, project, on);
    when advanced_coal_project_class_48a(project, OtherTechnologyFirstRound);
    when program_established_on_48a(start);
    when on >= start;
    when on < add_calendar_period(start, 36 calendar_month);
    then application_within_window_48a(applicant, project);
}
@source(IRC_S48A_D, relation = formalizes, coverage = exact, quote = "during the 3-year period beginning at the earlier of the termination of the period described in clause (i) or the date prescribed by the Secretary")
rule ApplicationWithinSecondWindowEndOfFirst48aRule(applicant: Person, project: Asset, on: Date, start: Date) strict {
    when application_submitted_on_48a(applicant, project, on);
    when advanced_coal_project_class_48a(project, CarbonSequestrationSecondRound);
    when program_established_on_48a(start);
    when not_known(prescribed_start_asserted_48a(start));
    when on >= add_calendar_period(start, 36 calendar_month);
    when on < add_calendar_period(start, 72 calendar_month);
    then application_within_window_48a(applicant, project);
}
relation prescribed_start_asserted_48a(start: Date) kind institutional;
rule PrescribedStartAsserted48aRule(start: Date, prescribed: Date) strict {
    when program_established_on_48a(start);
    when third_period_prescribed_start_48a(prescribed);
    then prescribed_start_asserted_48a(start);
}
rule ApplicationWithinSecondWindowPrescribedEarlier48aRule(applicant: Person, project: Asset, on: Date, start: Date, prescribed: Date) strict {
    when application_submitted_on_48a(applicant, project, on);
    when advanced_coal_project_class_48a(project, CarbonSequestrationSecondRound);
    when program_established_on_48a(start);
    when third_period_prescribed_start_48a(prescribed);
    when prescribed < add_calendar_period(start, 36 calendar_month);
    when on >= prescribed;
    when on < add_calendar_period(prescribed, 36 calendar_month);
    then application_within_window_48a(applicant, project);
}
rule ApplicationWithinSecondWindowPrescribedLater48aRule(applicant: Person, project: Asset, on: Date, start: Date, prescribed: Date) strict {
    when application_submitted_on_48a(applicant, project, on);
    when advanced_coal_project_class_48a(project, CarbonSequestrationSecondRound);
    when program_established_on_48a(start);
    when third_period_prescribed_start_48a(prescribed);
    when prescribed >= add_calendar_period(start, 36 calendar_month);
    when on >= add_calendar_period(start, 36 calendar_month);
    when on < add_calendar_period(start, 72 calendar_month);
    then application_within_window_48a(applicant, project);
}
pub relation application_accepted_on_48a(applicant: Person, project: Asset, on: Date) kind empirical {
    label en official "the Secretary accepts the application on this date (section 48A(d)(2)(D)) — case-asserted";
}
pub relation evidence_of_subsection_e2_criteria_provided_48a(applicant: Person, project: Asset) kind empirical {
    label en official "the applicant has provided the Secretary evidence that the criteria of subsection (e)(2) have been met — case-asserted";
}
@source(IRC_S48A_D, relation = formalizes, coverage = exact, quote = "Each applicant for certification shall have 2 years from the date of acceptance by the Secretary of the application during which to provide to the Secretary evidence that the criteria set forth in subsection (e)(2) have been met.")
rule Section48aD2DEvidenceDutyRule(applicant: Person, project: Asset, accepted: Date) strict {
    when application_accepted_on_48a(applicant, project, accepted);
    then duty Section48aD2DEvidenceDuty {
        bearer applicant;
        goal achievement {
            condition evidence_of_subsection_e2_criteria_provided_48a(applicant, project);
            window [accepted, add_calendar_period(accepted, 24 calendar_month)];
        }
    };
}

// --- (d)(3)(B): the pool caps --------------------------------------------------------------------------------------------------------------------------

pub relation pool_cap_48a(class: AdvancedCoalProjectClass48A, cap: Money) kind institutional {
    label en official "section 48A(d)(3)(B): of the $2,550,000,000, the Secretary may certify $800,000,000 for integrated gasification combined cycle projects (first period), $500,000,000 for other advanced coal-based technologies (first period) and $1,250,000,000 for advanced coal-based projects (second period)";
}
@source(IRC_S48A_D, relation = formalizes, coverage = exact, quote = "$800,000,000 for integrated gasification combined cycle projects the application for which is submitted during the period described in paragraph (2)(A)(i)")
assert "48a-d3b-pool-igcc": pool_cap_48a(IntegratedGasificationFirstRound, 800000000.00 USD);
@source(IRC_S48A_D, relation = formalizes, coverage = exact, quote = "$500,000,000 for projects which use other advanced coal-based generation technologies")
assert "48a-d3b-pool-other": pool_cap_48a(OtherTechnologyFirstRound, 500000000.00 USD);
@source(IRC_S48A_D, relation = formalizes, coverage = exact, quote = "$1,250,000,000 for advanced coal-based generation technology projects")
assert "48a-d3b-pool-second": pool_cap_48a(CarbonSequestrationSecondRound, 1250000000.00 USD);
pub relation pool_certified_total_48a(class: AdvancedCoalProjectClass48A, total: Money) kind empirical {
    label en official "the aggregate credits the Secretary certifies from the pool, including this certification — case-asserted";
}
pub relation pool_certification_within_cap_48a(class: AdvancedCoalProjectClass48A) kind institutional {
    label en official "section 48A(d)(3)(B): the credits certified from the pool do not exceed its dollar amount";
}
rule PoolCertificationWithinCap48aRule(class: AdvancedCoalProjectClass48A, cap: Money, total: Money) strict {
    when pool_cap_48a(class, cap);
    when pool_certified_total_48a(class, total);
    when total <= cap;
    then pool_certification_within_cap_48a(class);
}

// --- (d)(4)(C): the additional program ---------------------------------------------------------------------------------------------------------------

pub relation credits_available_for_reallocation_48a(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary determines that credits under clause (i) or (ii) of paragraph (3)(B) are available for reallocation pursuant to the requirements of paragraph (2) — case-asserted";
}
pub relation secretary_conducts_additional_program_48a(secretary: us.irc.core::Organ) kind empirical {
    label en official "the Secretary's exercise of the authority of section 48A(d)(4)(C) to conduct an additional program for applications for certification — case-asserted";
}
pub relation additional_program_conducted_48a(secretary: us.irc.core::Organ) kind institutional {
    label en official "an additional program for applications for certification is conducted";
}
@source(IRC_S48A_D, relation = formalizes, coverage = exact, quote = "the Secretary is authorized to conduct an additional program for applications for certification")
rule Section48aD4CAdditionalProgramPowerRule(secretary: us.irc.core::Organ) strict {
    when credits_available_for_reallocation_48a(secretary);
    then power Section48aD4CAdditionalProgram {
        holder us.irc.core::Secretary;
        over us.irc.core::Secretary;
        exercise secretary_conducts_additional_program_48a(secretary);
        valid_when credits_available_for_reallocation_48a(secretary);
        effect create(additional_program_conducted_48a(secretary));
        window [@2005-08-08, infinity);
    };
}

// --- (h): the directive to modify certification awards ------------------------------------------------------------------------------------------------

pub relation modification_requested_by_recipient_on_48a(project: Asset, on: Date) kind empirical {
    label en official "the recipient of the competitive certification award requests the modification on this date (section 48A(h)(2)) — case-asserted";
}
pub relation modification_consistent_with_objectives_48a(project: Asset) kind empirical {
    label en official "the modification is consistent with the objectives of section 48A or 48B (section 48A(h)(1)) — case-asserted";
}
pub relation modification_moves_project_site_for_carbon_capture_and_costs_48a(project: Asset) kind empirical {
    label en official "the modification involves moving the project site to improve the potential to capture and sequester carbon dioxide, reduce feedstock transport costs and serve a broader customer base (section 48A(h)(3)) — case-asserted";
}
external judgment relation secretary_determines_credit_increase_or_uncertified_48a(project: Asset) {
    authority Secretary;
    label en official "the Secretary determines that the tax credits available to the taxpayer would increase as a result of the modification or that it would result in the project not being originally certified (section 48A(h))";
}
relation modification_exception_applies_48a(project: Asset, requested: Date) kind institutional;
rule ModificationExceptionApplies48aRule(project: Asset, requested: Date) strict {
    when modification_requested_by_recipient_on_48a(project, requested);
    when secretary_determines_credit_increase_or_uncertified_48a(project);
    then modification_exception_applies_48a(project, requested);
}
pub relation award_modified_48a(project: Asset) kind empirical {
    label en official "the Secretary modifies the terms of the competitive certification award and any associated closing agreement — case-asserted";
}
@source(IRC_S48A_H, relation = formalizes, coverage = exact, quote = "the Secretary is directed to modify the terms of any competitive certification award and any associated closing agreement where such modification")
rule Section48aHModificationDutyRule(project: Asset, requested: Date) defeasible {
    when modification_requested_by_recipient_on_48a(project, requested);
    when modification_consistent_with_objectives_48a(project);
    when modification_moves_project_site_for_carbon_capture_and_costs_48a(project);
    unless modification_exception_applies_48a(project, requested);
    then duty Section48aHModificationDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition award_modified_48a(project);
            window [requested, infinity);
        }
    };
}
pub relation consulted_other_agencies_48a(project: Asset) kind empirical {
    label en official "the Secretary consulted other relevant Federal agencies, including the Department of Energy, in considering the modification — case-asserted";
}
@source(IRC_S48A_H, relation = formalizes, coverage = exact, quote = "In considering any such modification, the Secretary shall consult with other relevant Federal agencies, including the Department of Energy.")
rule Section48aHConsultationDutyRule(project: Asset, requested: Date) strict {
    when modification_requested_by_recipient_on_48a(project, requested);
    then duty Section48aHConsultationDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition consulted_other_agencies_48a(project);
            window [requested, infinity);
        }
    };
}
