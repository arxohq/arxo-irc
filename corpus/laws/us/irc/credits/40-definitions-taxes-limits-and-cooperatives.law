// Section 40 — the qualified mixture and second generation biofuel definitions, qualified ethanol fuel production, the (d)(3) tax on
// non-fuel use, the volume of alcohol with denaturants, the 15,000,000 and 60,000,000 gallon aggregation and pass-through rules,
// the (g)(6) cooperative apportionment, the (e)(2) carryover limit and the (h)(3) 51-cent adjustment. Stage 2f (IRC-06,
// DECISION-0379, TECH_GAP reduction of the stage 2d rows of TECH-GAPS G1789). Companion of `40-alcohol-fuels-credit.law`; the credit
// rules there read the technical tests as case facts and are NOT rewired to require these relations.
//
// Judgment calls: cents amounts HALF_UP at 2 places; the denaturant cap is 2 percent of the volume including denaturants, i.e.
// alcohol x 0.02 / 0.98 (6 decimals HALF_UP); the aggregation of a controlled group is a sum over the members asserted by the
// section 52(b) group fact (the more-than-50-percent controlling-interest test is part of that case fact).

use self::{
    Asset,
    ControlledGroup,
    IRC_S40_B,
    IRC_S40_C,
    IRC_S40_D,
    IRC_S40_E,
    IRC_S40_G,
    IRC_S40_H,
    Person,
    TaxableYear,
    alcohol_batch_facts_40,
    alcohol_credit_per_batch_40,
    alcohol_is_ethanol_40,
    batch_sale_or_use_date_40,
    eligible_small_ethanol_producer_40,
    productive_capacity_gallons_40,
    qualified_ethanol_fuel_production_gallons_40,
    second_generation_applicable_amount_40,
    under_common_control_52b,
};

pub enum EthanolDisposition40 { SoldForMixtureProduction, SoldForFuelInTradeOrBusiness, SoldAtRetailIntoTank }
pub enum FeedstockKind40 { LignocellulosicOrHemicellulosic, CultivatedAlgaeCyanobacteriaOrLemna, OtherFeedstock }
pub enum CreditKind40 { SmallEthanolProducer, SecondGenerationBiofuelProducer }

// --- (b)(1): the qualified mixture -------------------------------------------------------------------------------------------------------------------------

pub relation mixture_of_alcohol_with_gasoline_or_special_fuel_40(mixture: Asset) kind empirical {
    label en official "the mixture is of alcohol and gasoline, or of alcohol and a special fuel (section 40(b)(1)(B)) — case-asserted";
}
pub relation mixture_sold_by_producer_for_use_as_fuel_40(mixture: Asset) kind empirical {
    label en official "the mixture is sold by the taxpayer producing it to any person for use as a fuel (section 40(b)(1)(B)(i)) — case-asserted";
}
pub relation mixture_used_as_fuel_by_producer_40(mixture: Asset) kind empirical {
    label en official "the mixture is used as a fuel by the taxpayer producing it (section 40(b)(1)(B)(ii)) — case-asserted";
}
pub relation qualified_mixture_40(mixture: Asset) kind institutional {
    label en official "section 40(b)(1)(B): a mixture of alcohol and gasoline or a special fuel that is sold for use as a fuel by the producer or used as a fuel by the producer";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "The term \"qualified mixture\" means a mixture of alcohol and gasoline or of alcohol and a special fuel which")
rule QualifiedMixtureSold40Rule(mixture: Asset) strict {
    when mixture_of_alcohol_with_gasoline_or_special_fuel_40(mixture);
    when mixture_sold_by_producer_for_use_as_fuel_40(mixture);
    then qualified_mixture_40(mixture);
}
rule QualifiedMixtureUsed40Rule(mixture: Asset) strict {
    when mixture_of_alcohol_with_gasoline_or_special_fuel_40(mixture);
    when mixture_used_as_fuel_by_producer_40(mixture);
    then qualified_mixture_40(mixture);
}
pub relation only_denaturant_added_40(mixture: Asset) kind empirical {
    label en official "the only addition to the alcohol is a denaturant (section 40(b)(5)) — case-asserted";
}
pub relation production_of_mixture_40(taxpayer: Person, mixture: Asset) kind empirical {
    label en official "the taxpayer produces the mixture (section 40(b)(1)) — case-asserted";
}
pub relation mixture_production_recognized_40(taxpayer: Person, mixture: Asset) kind institutional {
    label en official "section 40(b)(5): the adding of any denaturant to alcohol is not the production of a mixture";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "The adding of any denaturant to alcohol shall not be treated as the production of a mixture.")
rule MixtureProductionRecognized40Rule(taxpayer: Person, mixture: Asset) strict {
    when production_of_mixture_40(taxpayer, mixture);
    when qualified_mixture_40(mixture);
    when not_known(only_denaturant_added_40(mixture));
    then mixture_production_recognized_40(taxpayer, mixture);
}
pub relation sale_or_use_in_trade_or_business_40(taxpayer: Person, mixture: Asset) kind empirical {
    label en official "the sale or use of the mixture is in a trade or business of the taxpayer (section 40(b)(1)(C)(i)) — case-asserted";
}
pub relation sale_or_use_year_40(mixture: Asset, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the sale or use of the mixture occurs (section 40(b)(1)(C)(ii)) — case-asserted";
}
pub relation casual_off_farm_production_40(taxpayer: Person, mixture: Asset) kind empirical {
    label en official "the mixture is casual off-farm production (section 40(b)(1)(D)) — case-asserted";
}
pub relation alcohol_taken_into_account_for_year_40(taxpayer: Person, mixture: Asset, y: TaxableYear) kind institutional {
    label en official "section 40(b)(1)(C)-(D): alcohol used in a qualified mixture is taken into account only for a sale or use in a trade or business, for the taxable year of the sale or use, and not for casual off-farm production";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "only if the sale or use described in subparagraph (B) is in a trade or business of the taxpayer, and")
rule AlcoholTakenIntoAccountForYear40Rule(taxpayer: Person, mixture: Asset, y: TaxableYear) strict {
    when mixture_production_recognized_40(taxpayer, mixture);
    when sale_or_use_in_trade_or_business_40(taxpayer, mixture);
    when sale_or_use_year_40(mixture, y);
    when not_known(casual_off_farm_production_40(taxpayer, mixture));
    then alcohol_taken_into_account_for_year_40(taxpayer, mixture, y);
}
pub relation alcohol_sold_in_retail_sale_to_fuel_tank_40(batch: Asset) kind empirical {
    label en official "the alcohol was sold in a retail sale described in subparagraph (A)(ii) (section 40(b)(2)(A)(ii)) — case-asserted";
}
pub relation alcohol_credit_a1_allowed_40(batch: Asset) kind institutional {
    label en official "section 40(b)(2)(B): no credit under subparagraph (A)(i) for alcohol sold in a retail sale described in (A)(ii)";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under subparagraph (A)(i) with respect to any alcohol which was sold in a retail sale described in subparagraph (A)(ii).")
rule AlcoholCreditA1Allowed40Rule(batch: Asset, proof: Decimal) strict {
    when alcohol_batch_facts_40(batch, proof);
    when not_known(alcohol_sold_in_retail_sale_to_fuel_tank_40(batch));
    then alcohol_credit_a1_allowed_40(batch);
}

// --- (d)(2), (d)(4): special fuel and the volume of alcohol -----------------------------------------------------------------------------------------

pub relation liquid_fuel_other_than_gasoline_suitable_for_engine_40(fuel: Asset) kind empirical {
    label en official "the liquid fuel is other than gasoline and suitable for use in an internal combustion engine (section 40(d)(2)) — case-asserted";
}
pub relation special_fuel_40(fuel: Asset) kind institutional {
    label en official "section 40(d)(2): special fuel includes any liquid fuel (other than gasoline) suitable for use in an internal combustion engine";
}
@source(IRC_S40_D, relation = formalizes, coverage = exact, quote = "The term \"special fuel\" includes any liquid fuel (other than gasoline) which is suitable for use in an internal combustion engine.")
rule SpecialFuel40Rule(fuel: Asset) strict {
    when liquid_fuel_other_than_gasoline_suitable_for_engine_40(fuel);
    then special_fuel_40(fuel);
}
pub relation alcohol_gallons_before_denaturant_40(batch: Asset, gallons: Decimal) kind empirical {
    label en official "the gallons of alcohol, without denaturants — case-asserted";
}
pub relation approved_denaturant_gallons_40(batch: Asset, gallons: Decimal) kind empirical {
    label en official "the gallons of denaturant (including gasoline) added under any formula approved by the Secretary — case-asserted";
}
pub relation alcohol_volume_including_denaturant_40(batch: Asset, gallons: Decimal) kind institutional {
    label en official "section 40(d)(4): the volume of alcohol includes the added denaturants up to 2 percent of the volume of the alcohol including denaturants";
}
@source(IRC_S40_D, relation = formalizes, coverage = exact, quote = "the volume of alcohol shall include the volume of any denaturant (including gasoline) which is added under any formulas approved by the Secretary to the extent that such denaturants do not exceed 2 percent of the volume of such alcohol (including denaturants)")
rule AlcoholVolumeIncludingDenaturant40Rule(batch: Asset, alcohol: Decimal, denaturant: Decimal) strict {
    when alcohol_gallons_before_denaturant_40(batch, alcohol);
    when approved_denaturant_gallons_40(batch, denaturant);
    then alcohol_volume_including_denaturant_40(batch, alcohol + min(denaturant, div_round(alcohol * 0.02, 0.98, 6, "HALF_UP")));
}

// --- (b)(4): qualified ethanol fuel production ----------------------------------------------------------------------------------------------------

pub relation ethanol_produced_by_40(producer: Person, batch: Asset) kind empirical {
    label en official "the ethanol is produced by the producer (section 40(b)(4)(B)) — case-asserted";
}
pub relation ethanol_disposition_40(batch: Asset, kind: EthanolDisposition40) kind empirical {
    label en official "the disposition of the ethanol: sold to another person for mixture production, for use as a fuel in a trade or business, or at retail into a fuel tank (section 40(b)(4)(B)(i)(I)-(III)) — case-asserted";
}
pub relation ethanol_sold_or_used_by_producer_for_disposition_40(batch: Asset) kind empirical {
    label en official "the ethanol is sold by the producer to another person for the disposition, or used or sold by the producer for that purpose (section 40(b)(4)(B)(i)-(ii)) — case-asserted";
}
pub relation purchased_alcohol_with_proof_raised_40(producer: Person, batch: Asset) kind empirical {
    label en official "the alcohol is purchased by the producer and its proof is increased by additional distillation (section 40(b)(4)(D)) — case-asserted";
}
pub relation qualified_ethanol_fuel_batch_40(producer: Person, batch: Asset, y: TaxableYear) kind institutional {
    label en official "section 40(b)(4)(B), (D): ethanol produced by an eligible small ethanol producer and sold or used for a listed disposition in the year, excluding purchased alcohol whose proof the producer raised by additional distillation";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "means any alcohol which is ethanol which is produced by an eligible small ethanol producer")
rule QualifiedEthanolFuelBatchMixture40Rule(producer: Person, batch: Asset, y: TaxableYear) strict {
    when eligible_small_ethanol_producer_40(producer, y);
    when ethanol_produced_by_40(producer, batch);
    when ethanol_disposition_40(batch, SoldForMixtureProduction);
    when ethanol_sold_or_used_by_producer_for_disposition_40(batch);
    when not_known(purchased_alcohol_with_proof_raised_40(producer, batch));
    then qualified_ethanol_fuel_batch_40(producer, batch, y);
}
rule QualifiedEthanolFuelBatchFuel40Rule(producer: Person, batch: Asset, y: TaxableYear) strict {
    when eligible_small_ethanol_producer_40(producer, y);
    when ethanol_produced_by_40(producer, batch);
    when ethanol_disposition_40(batch, SoldForFuelInTradeOrBusiness);
    when ethanol_sold_or_used_by_producer_for_disposition_40(batch);
    when not_known(purchased_alcohol_with_proof_raised_40(producer, batch));
    then qualified_ethanol_fuel_batch_40(producer, batch, y);
}
rule QualifiedEthanolFuelBatchRetail40Rule(producer: Person, batch: Asset, y: TaxableYear) strict {
    when eligible_small_ethanol_producer_40(producer, y);
    when ethanol_produced_by_40(producer, batch);
    when ethanol_disposition_40(batch, SoldAtRetailIntoTank);
    when ethanol_sold_or_used_by_producer_for_disposition_40(batch);
    when not_known(purchased_alcohol_with_proof_raised_40(producer, batch));
    then qualified_ethanol_fuel_batch_40(producer, batch, y);
}

// --- (b)(6)(C)-(G): second generation biofuel ----------------------------------------------------------------------------------------------------------

pub relation second_generation_produced_by_40(producer: Person, fuel: Asset) kind empirical {
    label en official "the second generation biofuel is produced by the taxpayer (section 40(b)(6)(C)) — case-asserted";
}
pub relation second_generation_disposition_40(fuel: Asset, kind: EthanolDisposition40) kind empirical {
    label en official "the disposition of the second generation biofuel (section 40(b)(6)(C)(i)(I)-(III)) — case-asserted";
}
pub relation second_generation_sold_or_used_for_disposition_40(fuel: Asset) kind empirical {
    label en official "the fuel is sold by the taxpayer to another person for the disposition, or used or sold by the taxpayer for that purpose (section 40(b)(6)(C)(i)-(ii)) — case-asserted";
}
pub relation second_generation_purchased_alcohol_proof_raised_40(producer: Person, fuel: Asset) kind empirical {
    label en official "the alcohol is purchased by the taxpayer and its proof is increased by additional distillation (section 40(b)(6)(C), last sentence) — case-asserted";
}
pub relation second_generation_fuel_meets_definition_40(fuel: Asset) kind institutional {
    label en official "section 40(b)(6)(E): a liquid fuel derived from qualified feedstocks that meets the EPA registration requirements and is not excluded by proof, water and sediment, ash or acid number";
}
pub relation qualified_second_generation_production_40(producer: Person, fuel: Asset) kind institutional {
    label en official "section 40(b)(6)(C): second generation biofuel produced by the taxpayer and sold or used for a listed disposition, excluding purchased alcohol whose proof the taxpayer raised by additional distillation";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "the term \"qualified second generation biofuel production\" means any second generation biofuel which is produced by the taxpayer")
rule QualifiedSecondGenerationProductionMixture40Rule(producer: Person, fuel: Asset) strict {
    when second_generation_produced_by_40(producer, fuel);
    when second_generation_fuel_meets_definition_40(fuel);
    when second_generation_disposition_40(fuel, SoldForMixtureProduction);
    when second_generation_sold_or_used_for_disposition_40(fuel);
    when not_known(second_generation_purchased_alcohol_proof_raised_40(producer, fuel));
    then qualified_second_generation_production_40(producer, fuel);
}
rule QualifiedSecondGenerationProductionFuel40Rule(producer: Person, fuel: Asset) strict {
    when second_generation_produced_by_40(producer, fuel);
    when second_generation_fuel_meets_definition_40(fuel);
    when second_generation_disposition_40(fuel, SoldForFuelInTradeOrBusiness);
    when second_generation_sold_or_used_for_disposition_40(fuel);
    when not_known(second_generation_purchased_alcohol_proof_raised_40(producer, fuel));
    then qualified_second_generation_production_40(producer, fuel);
}
rule QualifiedSecondGenerationProductionRetail40Rule(producer: Person, fuel: Asset) strict {
    when second_generation_produced_by_40(producer, fuel);
    when second_generation_fuel_meets_definition_40(fuel);
    when second_generation_disposition_40(fuel, SoldAtRetailIntoTank);
    when second_generation_sold_or_used_for_disposition_40(fuel);
    when not_known(second_generation_purchased_alcohol_proof_raised_40(producer, fuel));
    then qualified_second_generation_production_40(producer, fuel);
}
pub relation second_generation_mixture_of_fuel_with_gasoline_or_special_fuel_40(mixture: Asset) kind empirical {
    label en official "the mixture is of second generation biofuel and gasoline, or of second generation biofuel and a special fuel (section 40(b)(6)(D)) — case-asserted";
}
pub relation second_generation_mixture_sold_or_used_as_fuel_40(mixture: Asset) kind empirical {
    label en official "the mixture is sold by the person producing it for use as a fuel, or used as a fuel by that person (section 40(b)(6)(D)(i)-(ii)) — case-asserted";
}
pub relation qualified_second_generation_mixture_40(mixture: Asset) kind institutional {
    label en official "section 40(b)(6)(D): a mixture of second generation biofuel and gasoline or a special fuel sold for use as a fuel or used as a fuel by the producer";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "the term \"qualified second generation biofuel mixture\" means a mixture of second generation biofuel and gasoline or of second generation biofuel and a special fuel")
rule QualifiedSecondGenerationMixture40Rule(mixture: Asset) strict {
    when second_generation_mixture_of_fuel_with_gasoline_or_special_fuel_40(mixture);
    when second_generation_mixture_sold_or_used_as_fuel_40(mixture);
    then qualified_second_generation_mixture_40(mixture);
}
pub relation feedstock_kind_40(feedstock: Asset, kind: FeedstockKind40) kind empirical {
    label en official "the kind of the feedstock (section 40(b)(6)(F)) — case-asserted";
}
pub relation feedstock_available_on_renewable_or_recurring_basis_40(feedstock: Asset) kind empirical {
    label en official "the feedstock is available on a renewable or recurring basis (section 40(b)(6)(F)(i)) — case-asserted";
}
pub relation qualified_feedstock_40(feedstock: Asset) kind institutional {
    label en official "section 40(b)(6)(F): lignocellulosic or hemicellulosic matter available on a renewable or recurring basis, or cultivated algae, cyanobacteria or lemna";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "any lignocellulosic or hemicellulosic matter that is available on a renewable or recurring basis")
rule QualifiedFeedstockLignocellulosic40Rule(feedstock: Asset) strict {
    when feedstock_kind_40(feedstock, LignocellulosicOrHemicellulosic);
    when feedstock_available_on_renewable_or_recurring_basis_40(feedstock);
    then qualified_feedstock_40(feedstock);
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "any cultivated algae, cyanobacteria, or lemna")
rule QualifiedFeedstockAlgae40Rule(feedstock: Asset) strict {
    when feedstock_kind_40(feedstock, CultivatedAlgaeCyanobacteriaOrLemna);
    then qualified_feedstock_40(feedstock);
}
pub relation fuel_derived_from_feedstock_40(fuel: Asset, feedstock: Asset) kind empirical {
    label en official "the liquid fuel is derived by, or from, the feedstock (section 40(b)(6)(E)(i)(I)) — case-asserted";
}
pub relation fuel_meets_epa_registration_40(fuel: Asset) kind empirical {
    label en official "the fuel meets the registration requirements for fuels and fuel additives under section 211 of the Clean Air Act (section 40(b)(6)(E)(i)(II)) — case-asserted";
}
pub relation fuel_is_alcohol_with_proof_40(fuel: Asset, proof: Decimal) kind empirical {
    label en official "the fuel is an alcohol with this proof, determined without regard to added denaturants (section 40(b)(6)(E)(ii)) — case-asserted";
}
pub relation fuel_water_and_sediment_share_40(fuel: Asset, share: Decimal) kind empirical {
    label en official "the share by weight of water and sediment in the fuel, as a fraction (section 40(b)(6)(E)(iii)(I)) — case-asserted";
}
pub relation fuel_ash_share_40(fuel: Asset, share: Decimal) kind empirical {
    label en official "the ash content by weight of the fuel, as a fraction (section 40(b)(6)(E)(iii)(II)) — case-asserted";
}
pub relation fuel_acid_number_40(fuel: Asset, number: Decimal) kind empirical {
    label en official "the acid number of the fuel (section 40(b)(6)(E)(iii)(III)) — case-asserted";
}
relation second_generation_fuel_excluded_40(fuel: Asset) kind institutional;
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "The term \"second generation biofuel\" shall not include any alcohol with a proof of less than 150.")
rule SecondGenerationExcludedLowProof40Rule(fuel: Asset, proof: Decimal) strict {
    when fuel_is_alcohol_with_proof_40(fuel, proof);
    when proof < 150.0;
    then second_generation_fuel_excluded_40(fuel);
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "more than 4 percent of such fuel (determined by weight) is any combination of water and sediment")
rule SecondGenerationExcludedWater40Rule(fuel: Asset, share: Decimal) strict {
    when fuel_water_and_sediment_share_40(fuel, share);
    when share > 0.04;
    then second_generation_fuel_excluded_40(fuel);
}
rule SecondGenerationExcludedAsh40Rule(fuel: Asset, share: Decimal) strict {
    when fuel_ash_share_40(fuel, share);
    when share > 0.01;
    then second_generation_fuel_excluded_40(fuel);
}
rule SecondGenerationExcludedAcid40Rule(fuel: Asset, number: Decimal) strict {
    when fuel_acid_number_40(fuel, number);
    when number > 25.0;
    then second_generation_fuel_excluded_40(fuel);
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "is derived by, or from, qualified feedstocks")
rule SecondGenerationFuelMeetsDefinition40Rule(fuel: Asset, feedstock: Asset) strict {
    when liquid_fuel_other_than_gasoline_suitable_for_engine_40(fuel);
    when fuel_derived_from_feedstock_40(fuel, feedstock);
    when qualified_feedstock_40(feedstock);
    when fuel_meets_epa_registration_40(fuel);
    when not_known(second_generation_fuel_excluded_40(fuel));
    then second_generation_fuel_meets_definition_40(fuel);
}
pub relation algae_fuel_sold_for_refining_40(taxpayer: Person, fuel: Asset) kind empirical {
    label en official "the fuel is derived from cultivated algae, cyanobacteria or lemna, sold by the taxpayer to another person for refining into a fuel meeting the EPA registration requirement, and the refined fuel is not excluded under subparagraph (E)(iii) (section 40(b)(6)(G)) — case-asserted";
}
pub relation algae_sale_treated_as_qualifying_sale_40(taxpayer: Person, fuel: Asset) kind institutional {
    label en official "section 40(b)(6)(G)(i): the sale is treated as described in subparagraph (C)(i)";
}
@source(IRC_S40_B, relation = formalizes, coverage = exact, quote = "such sale shall be treated as described in subparagraph (C)(i)")
rule AlgaeSaleTreatedAsQualifyingSale40Rule(taxpayer: Person, fuel: Asset) strict {
    when algae_fuel_sold_for_refining_40(taxpayer, fuel);
    then algae_sale_treated_as_qualifying_sale_40(taxpayer, fuel);
}
pub relation algae_fuel_treated_as_meeting_requirements_40(taxpayer: Person, fuel: Asset) kind institutional {
    label en official "section 40(b)(6)(G)(ii): the fuel is treated as meeting the EPA registration requirement and as not excluded under (E)(iii) in the hands of the taxpayer";
}
rule AlgaeFuelTreatedAsMeetingRequirements40Rule(taxpayer: Person, fuel: Asset) strict {
    when algae_fuel_sold_for_refining_40(taxpayer, fuel);
    then algae_fuel_treated_as_meeting_requirements_40(taxpayer, fuel);
}
pub relation algae_fuel_not_taken_into_account_for_others_40(fuel: Asset, other: Person) kind institutional {
    label en official "section 40(b)(6)(G)(iii): except as provided, the fuel (and any fuel derived from it) is not taken into account under subparagraph (C) for the taxpayer or any other person";
}
rule AlgaeFuelNotTakenIntoAccountForOthers40Rule(taxpayer: Person, fuel: Asset, other: Person) strict {
    when algae_fuel_sold_for_refining_40(taxpayer, fuel);
    when second_generation_produced_by_40(other, fuel);
    then algae_fuel_not_taken_into_account_for_others_40(fuel, other);
}

// --- (c): the reduction for other benefits ----------------------------------------------------------------------------------------------------------------

pub relation other_fuel_benefit_for_batch_40(batch: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "any benefit provided with respect to the alcohol solely by reason of section 4041(b)(2), 6426 or 6427(e) — case-asserted";
}
pub relation alcohol_credit_after_other_benefit_40(taxpayer: Person, batch: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(c): the alcohol credit for the batch properly reduced by the benefit under section 4041(b)(2), 6426 or 6427(e) (not below zero)";
}
@source(IRC_S40_C, relation = formalizes, coverage = partial, quote = "be properly reduced to take into account any benefit provided with respect to such alcohol solely by reason of the application of section 4041(b)(2), section 6426, or section 6427(e)")
rule AlcoholCreditAfterOtherBenefit40Rule(taxpayer: Person, batch: Asset, y: TaxableYear, credit: Money, benefit: Money) defeasible {
    when alcohol_credit_per_batch_40(taxpayer, batch, y, credit);
    when other_fuel_benefit_for_batch_40(batch, y, benefit);
    then alcohol_credit_after_other_benefit_40(taxpayer, batch, y, max(credit - benefit, 0 USD));
}

// --- (d)(3)(C)-(D): the taxes on non-fuel use of small ethanol and second generation fuel ---------------------------------------------------------------

pub relation small_ethanol_credit_determined_for_batch_40(batch: Asset) kind empirical {
    label en official "a credit was determined under subsection (a)(3) for the alcohol — case-asserted";
}
pub relation person_uses_for_b4b_purpose_40(person: Person, batch: Asset) kind empirical {
    label en official "the person uses the fuel for a purpose described in subsection (b)(4)(B) — case-asserted";
}
pub relation person_holds_small_ethanol_40(person: Person, batch: Asset, gallons: Decimal) kind empirical {
    label en official "the person holds the gallons of small ethanol producer alcohol — case-asserted";
}
pub relation small_ethanol_misuse_tax_40(person: Person, batch: Asset, amount: Money) kind institutional {
    label en official "section 40(d)(3)(C): a tax of 10 cents a gallon on each gallon of alcohol not used as described in (b)(4)(B) where a (a)(3) credit was determined";
}
@source(IRC_S40_D, relation = formalizes, coverage = exact, quote = "then there is hereby imposed on such person a tax equal to 10 cents a gallon for each gallon of such alcohol.")
rule SmallEthanolMisuseTax40Rule(person: Person, batch: Asset, gallons: Decimal) strict {
    when small_ethanol_credit_determined_for_batch_40(batch);
    when person_holds_small_ethanol_40(person, batch, gallons);
    when not_known(person_uses_for_b4b_purpose_40(person, batch));
    then small_ethanol_misuse_tax_40(person, batch, round(0.10 * gallons, 2, "HALF_UP") * 1 USD);
}
pub relation second_generation_credit_allowed_for_fuel_40(fuel: Asset) kind empirical {
    label en official "a credit is allowed under subsection (a)(4) for the second generation biofuel — case-asserted";
}
pub relation person_uses_for_b6c_purpose_40(person: Person, fuel: Asset) kind empirical {
    label en official "the person uses the fuel for a purpose described in subsection (b)(6)(C) — case-asserted";
}
pub relation person_holds_second_generation_fuel_40(person: Person, fuel: Asset, producer: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "the person holds the gallons of second generation biofuel produced by the producer in the year — case-asserted";
}
pub relation second_generation_misuse_tax_40(person: Person, fuel: Asset, amount: Money) kind institutional {
    label en official "section 40(d)(3)(D): a tax equal to the applicable amount (section 40(b)(6)(B)) per gallon of second generation biofuel not used as described in (b)(6)(C) where an (a)(4) credit was allowed";
}
@source(IRC_S40_D, relation = formalizes, coverage = exact, quote = "then there is hereby imposed on such person a tax equal to the applicable amount (as defined in subsection (b)(6)(B)) for each gallon of such second generation biofuel.")
rule SecondGenerationMisuseTax40Rule(person: Person, fuel: Asset, producer: Person, y: TaxableYear, gallons: Decimal, dollars: Decimal) defeasible {
    when second_generation_credit_allowed_for_fuel_40(fuel);
    when person_holds_second_generation_fuel_40(person, fuel, producer, y, gallons);
    when not_known(person_uses_for_b6c_purpose_40(person, fuel));
    when second_generation_applicable_amount_40(producer, y, dollars);
    then second_generation_misuse_tax_40(person, fuel, round(dollars * gallons, 2, "HALF_UP") * 1 USD);
}

// --- (e)(2), (b)(6)(J)(ii): the carryover limit ----------------------------------------------------------------------------------------------------------

pub relation taxable_year_begin_40(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year — case-asserted";
}
pub relation cessation_year_begin_40(taxpayer: Person, kind: CreditKind40, on: Date) kind empirical {
    label en official "the first day of the taxable year in which falls the first day of the period for which the section (or the paragraph (b)(6)) ceases to apply (sections 40(e)(1)-(2), (b)(6)(J)) — case-asserted";
}
pub relation section_39_carryover_permitted_40(taxpayer: Person, kind: CreditKind40, y: TaxableYear) kind institutional {
    label en official "sections 40(e)(2), (b)(6)(J)(ii): no amount attributable to a sale or use before the first day of the period may be carried under section 39 to a taxable year beginning after the 3-taxable-year period beginning with the year in which the first day occurs";
}
@source(IRC_S40_E, relation = formalizes, coverage = exact, quote = "to any taxable year beginning after the 3-taxable-year period beginning with the taxable year in which such first day occurs")
rule Section39CarryoverPermitted40Rule(taxpayer: Person, kind: CreditKind40, y: TaxableYear, cessation: Date, begin: Date) strict {
    when cessation_year_begin_40(taxpayer, kind, cessation);
    when taxable_year_begin_40(y, begin);
    when begin < add_calendar_period(cessation, 36 calendar_month);
    then section_39_carryover_permitted_40(taxpayer, kind, y);
}

// --- (g)(2)-(3): aggregation and pass-through --------------------------------------------------------------------------------------------------------------

pub relation controlled_group_production_gallons_40(group: ControlledGroup, y: TaxableYear, gallons: Decimal) kind institutional {
    label en official "section 40(g)(2): all members of the same controlled group (section 267(f)) and all persons under common control (section 52(b), more than 50 percent) are one person: the qualified ethanol fuel production of the group";
}
@source(IRC_S40_G, relation = formalizes, coverage = exact, quote = "shall be treated as 1 person")
rule ControlledGroupProduction40Rule(group: ControlledGroup, y: TaxableYear, member: Person, own: Decimal) strict {
    when under_common_control_52b(group, member, y);
    when qualified_ethanol_fuel_production_gallons_40(member, y, own);
    then controlled_group_production_gallons_40(group, y,
        sum(collect all g: Decimal, p: Person where qualified_ethanol_fuel_production_gallons_40(p, y, g), empty: 0.0));
}
pub relation controlled_group_capacity_gallons_40(group: ControlledGroup, y: TaxableYear, gallons: Decimal) kind institutional {
    label en official "section 40(g)(2): the productive capacity of the one-person group for the 60,000,000 gallon limitation";
}
rule ControlledGroupCapacity40Rule(group: ControlledGroup, y: TaxableYear, member: Person, own: Decimal) strict {
    when under_common_control_52b(group, member, y);
    when productive_capacity_gallons_40(member, y, own);
    then controlled_group_capacity_gallons_40(group, y,
        sum(collect all g: Decimal, p: Person where productive_capacity_gallons_40(p, y, g), empty: 0.0));
}
pub relation group_exceeds_gallon_limitation_40(group: ControlledGroup, y: TaxableYear) kind institutional {
    label en official "section 40(g)(1), (2), (b)(4)(C): the group as one person has capacity over 60,000,000 gallons or production over 15,000,000 gallons";
}
rule GroupExceedsCapacityLimitation40Rule(group: ControlledGroup, y: TaxableYear, capacity: Decimal) strict {
    when controlled_group_capacity_gallons_40(group, y, capacity);
    when capacity > 60000000.0;
    then group_exceeds_gallon_limitation_40(group, y);
}
rule GroupExceedsProductionLimitation40Rule(group: ControlledGroup, y: TaxableYear, production: Decimal) strict {
    when controlled_group_production_gallons_40(group, y, production);
    when production > 15000000.0;
    then group_exceeds_gallon_limitation_40(group, y);
}
pub relation allocated_entity_production_gallons_40(pt_entity: Person, partner: Person, y: TaxableYear, gallons: Decimal) kind empirical {
    label en official "the gallons of the pass-through entity's qualified ethanol fuel production allocated to the partner, shareholder or beneficiary — case-asserted";
}
pub relation production_at_partner_level_40(partner: Person, y: TaxableYear, gallons: Decimal) kind institutional {
    label en official "section 40(g)(3): the limitations apply at the partner or similar level: the partner's own production plus the production allocated to the partner from entities";
}
@source(IRC_S40_G, relation = formalizes, coverage = exact, quote = "the limitations contained in subsection (b)(4)(C) and paragraph (1) shall be applied at the entity level and at the partner or similar level")
rule ProductionAtPartnerLevel40Rule(partner: Person, y: TaxableYear, own: Decimal) strict {
    when qualified_ethanol_fuel_production_gallons_40(partner, y, own);
    then production_at_partner_level_40(partner, y,
        own + sum(collect all g: Decimal, e: Person where allocated_entity_production_gallons_40(e, partner, y, g), empty: 0.0));
}
rule ProductionAtPartnerLevelNoOwn40Rule(partner: Person, y: TaxableYear, pt_entity: Person, allocated: Decimal) strict {
    when allocated_entity_production_gallons_40(pt_entity, partner, y, allocated);
    when not_known(partner_has_own_production_40(partner, y));
    then production_at_partner_level_40(partner, y,
        sum(collect all g: Decimal, e: Person where allocated_entity_production_gallons_40(e, partner, y, g), empty: 0.0));
}
relation partner_has_own_production_40(partner: Person, y: TaxableYear) kind institutional;
rule PartnerHasOwnProduction40Rule(partner: Person, y: TaxableYear, own: Decimal) strict {
    when qualified_ethanol_fuel_production_gallons_40(partner, y, own);
    then partner_has_own_production_40(partner, y);
}
pub relation partner_level_limit_exceeded_40(partner: Person, y: TaxableYear) kind institutional {
    label en official "section 40(g)(3), (b)(4)(C): the production at the partner level is over 15,000,000 gallons";
}
rule PartnerLevelLimitExceeded40Rule(partner: Person, y: TaxableYear, gallons: Decimal) strict {
    when production_at_partner_level_40(partner, y, gallons);
    when gallons > 15000000.0;
    then partner_level_limit_exceeded_40(partner, y);
}

// --- (g)(6): the cooperative apportionment ---------------------------------------------------------------------------------------------------------------

pub relation cooperative_described_in_1381a_40(coop: Person) kind empirical {
    label en official "the organization is a cooperative organization described in section 1381(a) — case-asserted";
}
pub relation elects_apportionment_to_patrons_40(coop: Person, kind: CreditKind40, y: TaxableYear) kind empirical {
    label en official "the cooperative's exercise of the section 40(g)(6)(A)(i) election (also for the (b)(6)(H) second generation credit) to apportion the credit pro rata among patrons";
}
pub relation timely_return_and_written_notice_40(coop: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely filed return and the apportionment is designated in a written notice mailed to patrons during the payment period of section 1382(d) (section 40(g)(6)(A)(ii)) — case-asserted";
}
pub relation apportionment_to_patrons_effective_40(coop: Person, kind: CreditKind40, y: TaxableYear) kind institutional {
    label en official "section 40(g)(6)(A): the apportionment among patrons takes effect";
}
@source(IRC_S40_G, relation = formalizes, coverage = exact, quote = "any portion of the credit determined under subsection (a)(3) for the taxable year may, at the election of the organization, be apportioned pro rata among patrons of the organization")
rule Section40G6ElectionRule(coop: Person, kind: CreditKind40, y: TaxableYear) defeasible {
    when elects_apportionment_to_patrons_40(coop, kind, y);
    when cooperative_described_in_1381a_40(coop);
    when timely_return_and_written_notice_40(coop, y);
    then power Section40G6ApportionmentElection {
        holder coop;
        over coop;
        exercise elects_apportionment_to_patrons_40(coop, kind, y);
        valid_when timely_return_and_written_notice_40(coop, y);
        effect create(apportionment_to_patrons_effective_40(coop, kind, y));
        window [-infinity, infinity);
    };
}
pub relation cooperative_credit_apportioned_40(coop: Person, kind: CreditKind40, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the credit that the cooperative apportions among its patrons — case-asserted";
}
pub relation business_done_by_patron_40(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the quantity or value of business done with or for the patron during the taxable year — case-asserted";
}
pub relation total_business_done_40(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total business done with or for patrons during the taxable year — case-asserted";
}
pub relation credit_apportioned_to_patron_40(coop: Person, patron: Person, kind: CreditKind40, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(g)(6)(A), (B)(ii): the apportioned credit goes to each patron pro rata by business done, included in the patron's credit for its first taxable year ending on or after the end of the payment period (or the notice date, if earlier)";
}
rule CreditApportionedToPatron40Rule(coop: Person, patron: Person, kind: CreditKind40, y: TaxableYear, apportioned: Money, done: Money, total: Money) strict {
    when apportionment_to_patrons_effective_40(coop, kind, y);
    when cooperative_credit_apportioned_40(coop, kind, y, apportioned);
    when business_done_by_patron_40(coop, patron, y, done);
    when total_business_done_40(coop, y, total);
    when total > 0 USD;
    then credit_apportioned_to_patron_40(coop, patron, kind, y, div_round(apportioned * (done / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation cooperative_credit_determined_40(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit of the cooperative determined under subsection (a)(3) (or (a)(4)) for the year — case-asserted";
}
pub relation cooperative_credit_shown_on_return_40(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit shown on the cooperative's return for the year — case-asserted";
}
pub relation cooperative_credit_not_apportioned_40(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount not apportioned to patrons for the year — case-asserted";
}
pub relation cooperative_unapportioned_credit_included_40(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(g)(6)(B)(i): the credit not apportioned to patrons is included in the cooperative's credit for the year";
}
@source(IRC_S40_G, relation = formalizes, coverage = exact, quote = "The amount of the credit not apportioned to patrons pursuant to subparagraph (A) shall be included in the amount determined under subsection (a)(3) for the taxable year of the organization.")
rule CooperativeUnapportionedCreditIncluded40Rule(coop: Person, y: TaxableYear, amount: Money) strict {
    when cooperative_credit_not_apportioned_40(coop, y, amount);
    then cooperative_unapportioned_credit_included_40(coop, y, amount);
}
pub relation cooperative_tax_increase_40(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 40(g)(6)(B)(iii): if the credit determined is less than the credit shown on the return, the excess of the reduction over the amount not apportioned is an increase in tax";
}
@source(IRC_S40_G, relation = formalizes, coverage = exact, quote = "shall be treated as an increase in tax imposed by this chapter on the organization.")
rule CooperativeTaxIncrease40Rule(coop: Person, y: TaxableYear, determined: Money, shown: Money, unapportioned: Money) strict {
    when cooperative_credit_determined_40(coop, y, determined);
    when cooperative_credit_shown_on_return_40(coop, y, shown);
    when cooperative_credit_not_apportioned_40(coop, y, unapportioned);
    when shown - determined > unapportioned;
    then cooperative_tax_increase_40(coop, y, shown - determined - unapportioned);
}

// --- (h)(3): the 51-cent adjustment -----------------------------------------------------------------------------------------------------------------------

external judgment relation secretary_h3b_determination_for_all_preceding_years_40(batch: Asset) {
    authority Secretary;
    label en official "the Secretary determines, in consultation with the EPA Administrator, for all preceding calendar years after 2007 that less than 7,500,000,000 gallons of ethanol were produced in or imported into the United States (section 40(h)(3)(A)-(B))";
}
pub relation blender_amount_2009_2011_cents_40(batch: Asset, cents: Decimal) kind institutional {
    label en official "section 40(h)(2)-(3): the blender amount of the last row of the table (45 cents, or 51 cents where the Secretary made the determination for all preceding years after 2007) for ethanol sold or used in 2009-2011";
}
@source(IRC_S40_H, relation = formalizes, coverage = exact, quote = "the last row in the table in paragraph (2) shall be applied by substituting \"51 cents\" for \"45 cents\"")
rule BlenderAmountAdjusted51Cents40Rule(batch: Asset, on: Date) defeasible {
    when alcohol_is_ethanol_40(batch);
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2009-01-01;
    when on <= @2011-12-31;
    when secretary_h3b_determination_for_all_preceding_years_40(batch);
    then blender_amount_2009_2011_cents_40(batch, 51.0);
}
rule BlenderAmountUnadjusted45Cents40Rule(batch: Asset, on: Date) defeasible {
    when alcohol_is_ethanol_40(batch);
    when batch_sale_or_use_date_40(batch, on);
    when on >= @2009-01-01;
    when on <= @2011-12-31;
    when not_known(secretary_h3b_determination_for_all_preceding_years_40(batch));
    then blender_amount_2009_2011_cents_40(batch, 45.0);
}
