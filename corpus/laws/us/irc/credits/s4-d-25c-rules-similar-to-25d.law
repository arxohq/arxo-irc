// Stage 4 (DECISION-0379 with deontics), credits, part D: section 25C(f)(1) — rules
// similar to section 25D(e)(4)-(8) for the energy efficient home improvement credit.
// Closes G6417.
//
// WIRING (final TECH_GAP pass, 26.09.2026): the two case channels below (`cooperative_expenditure_25c`,
// `expenditure_for_item_25c`) now carry a category (`Spend25c`), and the five category totals that the
// section 25C credit rules read are `<category>_expenditure_for_credit_25c` = the case-asserted category
// total (expenditures NOT subject to the attribution rules) + the sum over the tenant-stockholder shares
// + the sum over the condominium-member shares + the sum over the items after the nonbusiness use
// allocation. The sums are aggregates over EMPIRICAL relations only (no aggregate over a derived
// relation), so the derived per-coop / per-item relations below remain the explaining outputs and the
// credit chain does not read them. JUDGMENT CALL: the year `y` of an item is the year in which the case
// treats the expenditure as made (the date rule of (e)(8), `expenditure_treated_as_made_on_25c`, is
// exposed but not used as an aggregate filter: it is derived); the condominium qualification (B) is read
// through its two empirical premises.
//
// The 25D rules (module 25d-definitions-and-special-rules) are READ by explicit reference where
// they are general (the tenant-stockholder and condominium shares, the 80-percent nonbusiness
// use fraction of an item, the installation date of an item); the amounts are keyed to the
// 25C expenditures. (e)(4) (the fuel cell limit for a jointly occupied dwelling unit) has no
// object here: section 25C has no fuel cell property. The 25C credit chains read case-asserted
// category expenditures (module 25c); a case supplies the amounts of the relations below as
// those expenditures (the same channel as the asserted inputs of the section).

use self::{
    Asset,
    IRC_S25C_F,
    Individual,
    Person,
    TaxableYear,
    association_meets_528c1_other_than_e_25d,
    building_envelope_insulation_expenditure,
    condominium_management_association_25d,
    condominium_member_proportionate_share_25d,
    condominium_project_substantially_all_units_residences_25d,
    expenditure_treated_as_made_on_25d,
    exterior_doors_expenditure_before_cap,
    heat_pump_or_biomass_property_expenditure,
    nonbusiness_use_share_25d,
    other_qualified_energy_property_expenditure_after_item_cap,
    tenant_stockholder_proportionate_share_25d,
    windows_and_skylights_expenditure,
};

pub enum Spend25c { WindowsAndSkylights25c; ExteriorDoors25c; Insulation25c; HeatPumpOrBiomass25c; OtherEnergyProperty25c; label en unofficial "the category of section 25C expenditure that a credit rule of module 25c reads"; }

pub relation cooperative_expenditure_25c(coop: Person, y: TaxableYear, cat: Spend25c, amount: Money) kind empirical {
    label en official "the expenditures of the cooperative housing corporation or condominium management association that qualify under section 25C for the taxable year (section 25C(f)(1), by section 25D(e)(5)-(6)) — case-asserted";
}
pub relation expenditure_treated_as_made_by_tenant_stockholder_25c(individual: Individual, coop: Person, y: TaxableYear, cat: Spend25c, amount: Money) kind institutional {
    label en official "a tenant-stockholder is treated as having made the proportionate share of the expenditures of the cooperative housing corporation (rules similar to section 25D(e)(5)); the share is that of section 25D(e)(5), cents HALF_UP";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule TenantStockholderShareOf25cExpenditures(individual: Individual, coop: Person, y: TaxableYear, cat: Spend25c, share: Decimal, amount: Money) defeasible {
    label en official "share x the cooperative's expenditures (section 25C(f)(1), by section 25D(e)(5))";
    when tenant_stockholder_proportionate_share_25d(individual, coop, share);
    when cooperative_expenditure_25c(coop, y, cat, amount);
    then expenditure_treated_as_made_by_tenant_stockholder_25c(individual, coop, y, cat, round(amount / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}
pub relation expenditure_treated_as_made_by_condominium_member_25c(individual: Individual, assoc: Person, y: TaxableYear, cat: Spend25c, amount: Money) kind institutional {
    label en official "a member of a condominium management association is treated as having made the proportionate share of the association's expenditures (rules similar to section 25D(e)(6)); cents HALF_UP";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule CondominiumMemberShareOf25cExpenditures(individual: Individual, assoc: Person, y: TaxableYear, cat: Spend25c, share: Decimal, amount: Money) defeasible {
    label en official "share x the association's expenditures, for an association meeting section 25D(e)(6)(B) (section 25C(f)(1), by section 25D(e)(6))";
    when condominium_management_association_25d(assoc);
    when condominium_member_proportionate_share_25d(individual, assoc, share);
    when cooperative_expenditure_25c(assoc, y, cat, amount);
    then expenditure_treated_as_made_by_condominium_member_25c(individual, assoc, y, cat, round(amount / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}
pub relation expenditure_for_item_25c(taxpayer: Individual, prop: Asset, y: TaxableYear, cat: Spend25c, amount: Money) kind empirical {
    label en official "the expenditure for the item, before the nonbusiness use allocation (section 25C(f)(1), by section 25D(e)(7)) — case-asserted";
}
pub relation expenditure_after_business_use_allocation_25c(taxpayer: Individual, prop: Asset, y: TaxableYear, cat: Spend25c, amount: Money) kind institutional {
    label en official "if less than 80 percent of the use of an item is for nonbusiness purposes, only the portion of the expenditure allocable to nonbusiness use is taken into account (rule similar to section 25D(e)(7); the fraction of module 25d); cents HALF_UP";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule ExpenditureAfterBusinessUseBelow80For25c(taxpayer: Individual, prop: Asset, y: TaxableYear, cat: Spend25c, amount: Money, share: Decimal) defeasible {
    label en official "below 80 percent nonbusiness use: the nonbusiness portion (section 25C(f)(1), by section 25D(e)(7))";
    when expenditure_for_item_25c(taxpayer, prop, y, cat, amount);
    when nonbusiness_use_share_25d(prop, share);
    when share < 0.80;
    then expenditure_after_business_use_allocation_25c(taxpayer, prop, y, cat, round(amount / 1.00 USD * share, 2, "HALF_UP") * 1 USD);
}
rule ExpenditureAfterBusinessUseAtLeast80For25c(taxpayer: Individual, prop: Asset, y: TaxableYear, cat: Spend25c, amount: Money, share: Decimal) defeasible {
    label en official "at least 80 percent nonbusiness use: the whole expenditure (section 25C(f)(1), by section 25D(e)(7))";
    when expenditure_for_item_25c(taxpayer, prop, y, cat, amount);
    when nonbusiness_use_share_25d(prop, share);
    when share >= 0.80;
    then expenditure_after_business_use_allocation_25c(taxpayer, prop, y, cat, amount);
}
pub relation expenditure_treated_as_made_on_25c(prop: Asset, on: Date) kind institutional {
    label en official "the date an expenditure for the item is treated as made: the completion of the original installation or, for construction or reconstruction of a structure, the beginning of the original use (rules similar to section 25D(e)(8), read from module 25d)";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule ExpenditureTreatedAsMadeOn25cBy25dRule(prop: Asset, on: Date) defeasible {
    label en official "the timing rule of section 25D(e)(8), read by explicit reference (section 25C(f)(1))";
    when expenditure_treated_as_made_on_25d(prop, on);
    then expenditure_treated_as_made_on_25c(prop, on);
}

// --- the wiring: the category totals read by the section 25C credit rules -----------------------------------------------------------

pub relation windows_expenditure_for_credit_25c(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the windows expenditure the section 25C credit reads: the case-asserted category total plus the tenant-stockholder shares, the condominium-member shares and the items after the nonbusiness use allocation (section 25C(f)(1), by section 25D(e)(5)-(7))";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule WindowsExpenditureForCredit25c(taxpayer: Individual, y: TaxableYear, base: Money) strict {
    label en official "the category total plus the attributed expenditures of the category (section 25C(f)(1), by section 25D(e)(5)-(7))";
    when windows_and_skylights_expenditure(taxpayer, y, base);
    then windows_expenditure_for_credit_25c(taxpayer, y, base
        + sum(collect all x: Money, c: Person, sh: Decimal, a: Money where cooperative_expenditure_25c(c, y, WindowsAndSkylights25c, a) and tenant_stockholder_proportionate_share_25d(taxpayer, c, sh) and x == round(a / 1.00 USD * sh, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x2: Money, c2: Person, sh2: Decimal, a2: Money where cooperative_expenditure_25c(c2, y, WindowsAndSkylights25c, a2) and association_meets_528c1_other_than_e_25d(c2) and condominium_project_substantially_all_units_residences_25d(c2) and condominium_member_proportionate_share_25d(taxpayer, c2, sh2) and x2 == round(a2 / 1.00 USD * sh2, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x3: Money, p3: Asset, sh3: Decimal, a3: Money where expenditure_for_item_25c(taxpayer, p3, y, WindowsAndSkylights25c, a3) and nonbusiness_use_share_25d(p3, sh3) and sh3 < 0.80 and x3 == round(a3 / 1.00 USD * sh3, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all a4: Money, p4: Asset, sh4: Decimal where expenditure_for_item_25c(taxpayer, p4, y, WindowsAndSkylights25c, a4) and nonbusiness_use_share_25d(p4, sh4) and sh4 >= 0.80, empty: 0.00 USD));
}

pub relation doors_expenditure_for_credit_25c(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the doors expenditure the section 25C credit reads: the case-asserted category total plus the tenant-stockholder shares, the condominium-member shares and the items after the nonbusiness use allocation (section 25C(f)(1), by section 25D(e)(5)-(7))";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule DoorsExpenditureForCredit25c(taxpayer: Individual, y: TaxableYear, base: Money) strict {
    label en official "the category total plus the attributed expenditures of the category (section 25C(f)(1), by section 25D(e)(5)-(7))";
    when exterior_doors_expenditure_before_cap(taxpayer, y, base);
    then doors_expenditure_for_credit_25c(taxpayer, y, base
        + sum(collect all x: Money, c: Person, sh: Decimal, a: Money where cooperative_expenditure_25c(c, y, ExteriorDoors25c, a) and tenant_stockholder_proportionate_share_25d(taxpayer, c, sh) and x == round(a / 1.00 USD * sh, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x2: Money, c2: Person, sh2: Decimal, a2: Money where cooperative_expenditure_25c(c2, y, ExteriorDoors25c, a2) and association_meets_528c1_other_than_e_25d(c2) and condominium_project_substantially_all_units_residences_25d(c2) and condominium_member_proportionate_share_25d(taxpayer, c2, sh2) and x2 == round(a2 / 1.00 USD * sh2, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x3: Money, p3: Asset, sh3: Decimal, a3: Money where expenditure_for_item_25c(taxpayer, p3, y, ExteriorDoors25c, a3) and nonbusiness_use_share_25d(p3, sh3) and sh3 < 0.80 and x3 == round(a3 / 1.00 USD * sh3, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all a4: Money, p4: Asset, sh4: Decimal where expenditure_for_item_25c(taxpayer, p4, y, ExteriorDoors25c, a4) and nonbusiness_use_share_25d(p4, sh4) and sh4 >= 0.80, empty: 0.00 USD));
}

pub relation insulation_expenditure_for_credit_25c(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the insulation expenditure the section 25C credit reads: the case-asserted category total plus the tenant-stockholder shares, the condominium-member shares and the items after the nonbusiness use allocation (section 25C(f)(1), by section 25D(e)(5)-(7))";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule InsulationExpenditureForCredit25c(taxpayer: Individual, y: TaxableYear, base: Money) strict {
    label en official "the category total plus the attributed expenditures of the category (section 25C(f)(1), by section 25D(e)(5)-(7))";
    when building_envelope_insulation_expenditure(taxpayer, y, base);
    then insulation_expenditure_for_credit_25c(taxpayer, y, base
        + sum(collect all x: Money, c: Person, sh: Decimal, a: Money where cooperative_expenditure_25c(c, y, Insulation25c, a) and tenant_stockholder_proportionate_share_25d(taxpayer, c, sh) and x == round(a / 1.00 USD * sh, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x2: Money, c2: Person, sh2: Decimal, a2: Money where cooperative_expenditure_25c(c2, y, Insulation25c, a2) and association_meets_528c1_other_than_e_25d(c2) and condominium_project_substantially_all_units_residences_25d(c2) and condominium_member_proportionate_share_25d(taxpayer, c2, sh2) and x2 == round(a2 / 1.00 USD * sh2, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x3: Money, p3: Asset, sh3: Decimal, a3: Money where expenditure_for_item_25c(taxpayer, p3, y, Insulation25c, a3) and nonbusiness_use_share_25d(p3, sh3) and sh3 < 0.80 and x3 == round(a3 / 1.00 USD * sh3, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all a4: Money, p4: Asset, sh4: Decimal where expenditure_for_item_25c(taxpayer, p4, y, Insulation25c, a4) and nonbusiness_use_share_25d(p4, sh4) and sh4 >= 0.80, empty: 0.00 USD));
}

pub relation heat_pump_expenditure_for_credit_25c(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the heat_pump expenditure the section 25C credit reads: the case-asserted category total plus the tenant-stockholder shares, the condominium-member shares and the items after the nonbusiness use allocation (section 25C(f)(1), by section 25D(e)(5)-(7))";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule HeatPumpExpenditureForCredit25c(taxpayer: Individual, y: TaxableYear, base: Money) strict {
    label en official "the category total plus the attributed expenditures of the category (section 25C(f)(1), by section 25D(e)(5)-(7))";
    when heat_pump_or_biomass_property_expenditure(taxpayer, y, base);
    then heat_pump_expenditure_for_credit_25c(taxpayer, y, base
        + sum(collect all x: Money, c: Person, sh: Decimal, a: Money where cooperative_expenditure_25c(c, y, HeatPumpOrBiomass25c, a) and tenant_stockholder_proportionate_share_25d(taxpayer, c, sh) and x == round(a / 1.00 USD * sh, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x2: Money, c2: Person, sh2: Decimal, a2: Money where cooperative_expenditure_25c(c2, y, HeatPumpOrBiomass25c, a2) and association_meets_528c1_other_than_e_25d(c2) and condominium_project_substantially_all_units_residences_25d(c2) and condominium_member_proportionate_share_25d(taxpayer, c2, sh2) and x2 == round(a2 / 1.00 USD * sh2, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x3: Money, p3: Asset, sh3: Decimal, a3: Money where expenditure_for_item_25c(taxpayer, p3, y, HeatPumpOrBiomass25c, a3) and nonbusiness_use_share_25d(p3, sh3) and sh3 < 0.80 and x3 == round(a3 / 1.00 USD * sh3, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all a4: Money, p4: Asset, sh4: Decimal where expenditure_for_item_25c(taxpayer, p4, y, HeatPumpOrBiomass25c, a4) and nonbusiness_use_share_25d(p4, sh4) and sh4 >= 0.80, empty: 0.00 USD));
}

pub relation other_expenditure_for_credit_25c(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the other expenditure the section 25C credit reads: the case-asserted category total plus the tenant-stockholder shares, the condominium-member shares and the items after the nonbusiness use allocation (section 25C(f)(1), by section 25D(e)(5)-(7))";
}
@source(IRC_S25C_F, quote = "Rules similar to the rules under paragraphs (4), (5), (6), (7), and (8) of section 25D(e) shall apply.")
rule OtherExpenditureForCredit25c(taxpayer: Individual, y: TaxableYear, base: Money) strict {
    label en official "the category total plus the attributed expenditures of the category (section 25C(f)(1), by section 25D(e)(5)-(7))";
    when other_qualified_energy_property_expenditure_after_item_cap(taxpayer, y, base);
    then other_expenditure_for_credit_25c(taxpayer, y, base
        + sum(collect all x: Money, c: Person, sh: Decimal, a: Money where cooperative_expenditure_25c(c, y, OtherEnergyProperty25c, a) and tenant_stockholder_proportionate_share_25d(taxpayer, c, sh) and x == round(a / 1.00 USD * sh, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x2: Money, c2: Person, sh2: Decimal, a2: Money where cooperative_expenditure_25c(c2, y, OtherEnergyProperty25c, a2) and association_meets_528c1_other_than_e_25d(c2) and condominium_project_substantially_all_units_residences_25d(c2) and condominium_member_proportionate_share_25d(taxpayer, c2, sh2) and x2 == round(a2 / 1.00 USD * sh2, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all x3: Money, p3: Asset, sh3: Decimal, a3: Money where expenditure_for_item_25c(taxpayer, p3, y, OtherEnergyProperty25c, a3) and nonbusiness_use_share_25d(p3, sh3) and sh3 < 0.80 and x3 == round(a3 / 1.00 USD * sh3, 2, "HALF_UP") * 1 USD, empty: 0.00 USD)
        + sum(collect all a4: Money, p4: Asset, sh4: Decimal where expenditure_for_item_25c(taxpayer, p4, y, OtherEnergyProperty25c, a4) and nonbusiness_use_share_25d(p4, sh4) and sh4 >= 0.80, empty: 0.00 USD));
}
