// Section 30D — the (c) treatment of the credit (business credit portion and subpart A) and the (g) transfer of the credit to an eligible entity:
// the election, the eligible entity and dealer definitions, the registration revocation, the tax treatment of the payment, the advance payment
// program, the effect on the vehicle requirements and the recapture of the payment. Stage 2f (IRC-06, DECISION-0379, TECH_GAP reduction of the
// stage 2c rows of TECH-GAPS G391). Companion of `30d-clean-vehicle-credit.law`; its credit rules are NOT rewired to require these relations.
// Termination of the credit for a vehicle acquired after 2025-09-30 (PL 119-21) stays with the credit module.
//
// Judgment calls: the dates of sale, disclosure, election and payment are asserted facts compared as dates; the payment equal to the credit
// otherwise allowable is compared as money; the requirements of (f)(1)-(2) and (9) are folded into flags because their text is not part of
// these rows; amounts are cents HALF_UP.

use self::{
    Asset,
    IRC_S30D_C,
    IRC_S30D_G,
    Individual,
    Person,
    TaxableYear,
    clean_vehicle_credit_per_vehicle,
};

pub enum LicensingBody30D { State, DistrictOfColumbia, PuertoRico, OtherTerritoryOrPossession, IndianTribalGovernment, AlaskaNativeCorporation, OtherBody }

// --- (c): business credit portion and subpart A ----------------------------------------------------------------------------------------------------------

pub relation vehicle_of_depreciable_character_30d(vehicle: Asset) kind empirical {
    label en official "the vehicle is property of a character subject to an allowance for depreciation (section 30D(c)(1)) — case-asserted";
}
pub relation business_credit_portion_30d(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30D(c)(1): so much of the credit as is attributable to property subject to depreciation is treated as a section 38(b) credit for the year, not allowed under subsection (a)";
}
@source(IRC_S30D_C, relation = formalizes, coverage = exact, quote = "shall be treated as a credit listed in section 38(b) for such taxable year (and not allowed under subsection (a))")
rule BusinessCreditPortion30dRule(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    when clean_vehicle_credit_per_vehicle(taxpayer, vehicle, y, amount);
    when vehicle_of_depreciable_character_30d(vehicle);
    then business_credit_portion_30d(taxpayer, vehicle, y, amount);
}
pub relation personal_credit_portion_30d(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30D(a), (c)(1): the credit attributable to a vehicle not subject to depreciation remains allowed under subsection (a)";
}
rule PersonalCreditPortion30dRule(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    when clean_vehicle_credit_per_vehicle(taxpayer, vehicle, y, amount);
    when not_known(vehicle_of_depreciable_character_30d(vehicle));
    then personal_credit_portion_30d(taxpayer, vehicle, y, amount);
}
pub relation credit_treated_as_subpart_a_credit_30d(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 30D(c)(2): the credit allowed under subsection (a), after paragraph (1), is treated as a credit allowable under subpart A for the taxable year";
}
@source(IRC_S30D_C, relation = formalizes, coverage = exact, quote = "shall be treated as a credit allowable under subpart A for such taxable year")
rule CreditTreatedAsSubpartA30dRule(taxpayer: Individual, vehicle: Asset, y: TaxableYear, amount: Money) defeasible {
    when personal_credit_portion_30d(taxpayer, vehicle, y, amount);
    then credit_treated_as_subpart_a_credit_30d(taxpayer, vehicle, y, amount);
}

// --- (g)(8)-(9): dealer and Indian tribal government --------------------------------------------------------------------------------------------------

pub relation licensed_by_30d(person: Person, body: LicensingBody30D) kind empirical {
    label en official "the person is licensed by the body to engage in the sale of vehicles (section 30D(g)(8)) — case-asserted";
}
pub relation dealer_30d(person: Person) kind institutional {
    label en official "section 30D(g)(8): a person licensed by a State, the District of Columbia, Puerto Rico, any other territory or possession, an Indian tribal government or an Alaska Native Corporation to engage in the sale of vehicles";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "the term \"dealer\" means a person licensed by a State, the District of Columbia, the Commonwealth of Puerto Rico, any other territory or possession of the United States, an Indian tribal government, or any Alaska Native Corporation")
rule Dealer30dRule(person: Person, body: LicensingBody30D) strict {
    when licensed_by_30d(person, body);
    when body != OtherBody;
    then dealer_30d(person);
}
pub relation body_is_recognized_governing_body_of_tribe_30d(body: Person) kind empirical {
    label en official "the body is the recognized governing body of an Indian or Alaska Native tribe, band, nation, pueblo, village, community, component band, or component reservation (section 30D(g)(9)) — case-asserted";
}
pub relation body_on_list_published_under_section_104_30d(body: Person) kind empirical {
    label en official "the tribe is individually identified (including parenthetically) in the list published most recently as of the date of enactment of the subsection pursuant to section 104 of the Federally Recognized Indian Tribe List Act of 1994 — case-asserted";
}
pub relation indian_tribal_government_30d(body: Person) kind institutional {
    label en official "section 30D(g)(9): the recognized governing body of a tribe individually identified in the most recently published list under section 104 of the Federally Recognized Indian Tribe List Act of 1994";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "the term \"Indian tribal government\" means the recognized governing body of any Indian or Alaska Native tribe")
rule IndianTribalGovernment30dRule(body: Person) strict {
    when body_is_recognized_governing_body_of_tribe_30d(body);
    when body_on_list_published_under_section_104_30d(body);
    then indian_tribal_government_30d(body);
}

// --- (g)(2): the eligible entity ------------------------------------------------------------------------------------------------------------------------------

pub relation dealer_sold_vehicle_to_taxpayer_on_30d(dealer: Person, vehicle: Asset, taxpayer: Individual, on: Date) kind empirical {
    label en official "the dealer sold the vehicle to the taxpayer on this date — case-asserted";
}
pub relation dealer_registered_with_secretary_30d(dealer: Person) kind empirical {
    label en official "the dealer has registered with the Secretary for purposes of paragraph (2), at such time and in such form and manner as the Secretary may prescribe, subject to paragraph (4) (section 30D(g)(2)(A)) — case-asserted";
}
pub relation dealer_disclosed_on_30d(dealer: Person, vehicle: Asset, on: Date) kind empirical {
    label en official "the date the dealer disclosed to the taxpayer the manufacturer's suggested retail price, the value of the credit and any other incentive, and the amount provided by the dealer as a condition of the election (section 30D(g)(2)(B)(i)-(iii)) — case-asserted";
}
pub relation election_made_on_30d(taxpayer: Individual, vehicle: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer makes the election of paragraph (1) — case-asserted";
}
pub relation credit_otherwise_allowable_30d(taxpayer: Individual, vehicle: Asset, amount: Money) kind empirical {
    label en official "the credit otherwise allowable to the taxpayer for the vehicle — case-asserted";
}
pub relation dealer_paid_taxpayer_on_30d(dealer: Person, vehicle: Asset, on: Date, amount: Money) kind empirical {
    label en official "the date and amount of the payment the dealer made to the taxpayer, in cash or as a partial payment or down payment for the vehicle (section 30D(g)(2)(C)) — case-asserted";
}
pub relation incentive_availability_and_election_not_limited_30d(dealer: Person, vehicle: Asset) kind empirical {
    label en official "the dealer ensured that the availability or use of any incentive (including a dealer or manufacturer rebate or discount) does not limit the taxpayer's ability to make the election and that the election does not limit the value or use of the incentive (section 30D(g)(2)(D)) — case-asserted";
}
pub relation eligible_entity_30d(dealer: Person, vehicle: Asset, taxpayer: Individual) kind institutional {
    label en official "section 30D(g)(2): the dealer that sold the vehicle to the taxpayer and has registered, disclosed the price, credit value, other incentives and its payment before the election and by the sale, paid the taxpayer the credit otherwise allowable by the sale, and ensured the incentives are unaffected";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "the term \"eligible entity\" means, with respect to the vehicle for which the credit is allowed under subsection (a), the dealer which sold such vehicle to the taxpayer")
rule EligibleEntity30dRule(dealer: Person, vehicle: Asset, taxpayer: Individual, sold: Date, disclosed: Date, elected: Date, paid_on: Date, paid: Money, credit: Money) strict {
    when dealer_sold_vehicle_to_taxpayer_on_30d(dealer, vehicle, taxpayer, sold);
    when dealer_registered_with_secretary_30d(dealer);
    when dealer_disclosed_on_30d(dealer, vehicle, disclosed);
    when election_made_on_30d(taxpayer, vehicle, elected);
    when disclosed <= elected;
    when disclosed <= sold;
    when credit_otherwise_allowable_30d(taxpayer, vehicle, credit);
    when dealer_paid_taxpayer_on_30d(dealer, vehicle, paid_on, paid);
    when paid_on <= sold;
    when paid >= credit;
    when incentive_availability_and_election_not_limited_30d(dealer, vehicle);
    then eligible_entity_30d(dealer, vehicle, taxpayer);
}

// --- (g)(1), (g)(3): the election ------------------------------------------------------------------------------------------------------------------------------

pub relation taxpayer_elects_transfer_to_eligible_entity_30d(taxpayer: Individual, vehicle: Asset, dealer: Person) kind empirical {
    label en official "the taxpayer's exercise of the section 30D(g)(1) election that the credit be allowed to the eligible entity specified in the election";
}
pub relation election_timely_30d(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 30D(g)(3): the election is made not later than the date on which the vehicle is purchased";
}
pub relation vehicle_purchased_on_30d(taxpayer: Individual, vehicle: Asset, on: Date) kind empirical {
    label en official "the date on which the vehicle is purchased — case-asserted";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "An election described in paragraph (1) shall be made by the taxpayer not later than the date on which the vehicle for which the credit is allowed under subsection (a) is purchased.")
rule ElectionTimely30dRule(taxpayer: Individual, vehicle: Asset, elected: Date, purchased: Date) strict {
    when election_made_on_30d(taxpayer, vehicle, elected);
    when vehicle_purchased_on_30d(taxpayer, vehicle, purchased);
    when elected <= purchased;
    then election_timely_30d(taxpayer, vehicle);
}
pub relation credit_allowed_to_eligible_entity_30d(dealer: Person, vehicle: Asset, taxpayer: Individual) kind institutional {
    label en official "section 30D(g)(1): the credit which would be allowed to the taxpayer is allowed to the eligible entity specified in the election (and not to the taxpayer)";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "the credit which would (but for this subsection) be allowed to such taxpayer with respect to such vehicle shall be allowed to the eligible entity specified in such election (and not to such taxpayer)")
rule Section30DG1ElectionRule(taxpayer: Individual, vehicle: Asset, dealer: Person) defeasible {
    when taxpayer_elects_transfer_to_eligible_entity_30d(taxpayer, vehicle, dealer);
    when eligible_entity_30d(dealer, vehicle, taxpayer);
    when election_timely_30d(taxpayer, vehicle);
    then power Section30DG1CreditTransferElection {
        holder taxpayer;
        over dealer;
        exercise taxpayer_elects_transfer_to_eligible_entity_30d(taxpayer, vehicle, dealer);
        valid_when election_timely_30d(taxpayer, vehicle);
        effect create(credit_allowed_to_eligible_entity_30d(dealer, vehicle, taxpayer));
        window [-infinity, infinity);
    };
}
relation transfer_elected_and_valid_30d(taxpayer: Individual, vehicle: Asset, dealer: Person) kind institutional;
rule TransferElectedAndValid30dRule(taxpayer: Individual, vehicle: Asset, dealer: Person) strict {
    when taxpayer_elects_transfer_to_eligible_entity_30d(taxpayer, vehicle, dealer);
    when eligible_entity_30d(dealer, vehicle, taxpayer);
    when election_timely_30d(taxpayer, vehicle);
    then transfer_elected_and_valid_30d(taxpayer, vehicle, dealer);
}
pub relation credit_not_allowed_to_taxpayer_after_transfer_30d(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 30D(g)(1): the credit is not allowed to the taxpayer who transferred it";
}
rule CreditNotAllowedToTaxpayerAfterTransfer30dRule(taxpayer: Individual, vehicle: Asset, dealer: Person) strict {
    when transfer_elected_and_valid_30d(taxpayer, vehicle, dealer);
    then credit_not_allowed_to_taxpayer_after_transfer_30d(taxpayer, vehicle);
}

// --- (g)(4): revocation of the registration ------------------------------------------------------------------------------------------------------------------

external judgment relation secretary_determines_dealer_noncompliance_30d(dealer: Person) {
    authority Secretary;
    label en official "the Secretary determines that the dealer has failed to comply with the requirements described in paragraph (2) (section 30D(g)(4))";
}
pub relation secretary_revokes_dealer_registration_30d(dealer: Person) kind empirical {
    label en official "the Secretary's exercise of the power to revoke the dealer's registration — case-asserted";
}
pub relation dealer_registration_revoked_30d(dealer: Person) kind institutional {
    label en official "section 30D(g)(4): the Secretary may revoke the registration of a dealer that fails to comply with the requirements of paragraph (2)";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "Upon determination by the Secretary that a dealer has failed to comply with the requirements described in paragraph (2), the Secretary may revoke the registration")
rule Section30DG4RevocationPowerRule(dealer: Person) defeasible {
    when secretary_determines_dealer_noncompliance_30d(dealer);
    then power Section30DG4RegistrationRevocation {
        holder us.irc.core::Secretary;
        over dealer;
        exercise secretary_revokes_dealer_registration_30d(dealer);
        valid_when secretary_determines_dealer_noncompliance_30d(dealer);
        effect create(dealer_registration_revoked_30d(dealer));
        window [-infinity, infinity);
    };
}

// --- (g)(5)-(7), (g)(10): the payment, the requirements, the advance payments, recapture -------------------------------------------------------------

pub relation payment_received_by_taxpayer_from_eligible_entity_30d(taxpayer: Individual, vehicle: Asset, dealer: Person, amount: Money) kind empirical {
    label en official "the payment described in paragraph (2)(C) received by the taxpayer from the eligible entity — case-asserted";
}
pub relation payment_excluded_from_gross_income_30d(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30D(g)(5)(A): the payment described in paragraph (2)(C) is not includible in the gross income of the taxpayer";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "shall not be includible in the gross income of the taxpayer")
rule PaymentExcludedFromGrossIncome30dRule(taxpayer: Individual, vehicle: Asset, dealer: Person, amount: Money) strict {
    when payment_received_by_taxpayer_from_eligible_entity_30d(taxpayer, vehicle, dealer, amount);
    when eligible_entity_30d(dealer, vehicle, taxpayer);
    then payment_excluded_from_gross_income_30d(taxpayer, vehicle, amount);
}
pub relation payment_not_deductible_by_dealer_30d(dealer: Person, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30D(g)(5)(B): with respect to the dealer, the payment is not deductible under this title";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "with respect to the dealer, shall not be deductible under this title")
rule PaymentNotDeductibleByDealer30dRule(taxpayer: Individual, vehicle: Asset, dealer: Person, amount: Money) strict {
    when payment_received_by_taxpayer_from_eligible_entity_30d(taxpayer, vehicle, dealer, amount);
    when eligible_entity_30d(dealer, vehicle, taxpayer);
    then payment_not_deductible_by_dealer_30d(dealer, vehicle, amount);
}
pub relation vin_provided_to_secretary_by_eligible_entity_30d(dealer: Person, vehicle: Asset) kind empirical {
    label en official "the eligible entity provides the vehicle identification number of the vehicle to the Secretary in such manner as the Secretary may provide (section 30D(g)(6)(C)) — case-asserted";
}
pub relation vin_requirement_treated_as_satisfied_30d(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 30D(g)(6)(C): for an election, the vehicle identification number requirement of subsection (f)(9) is treated as satisfied if the eligible entity provides the number to the Secretary";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "the requirement of paragraph (9) of such subsection (f) shall be treated as satisfied if the eligible entity provides the vehicle identification number of such vehicle to the Secretary")
rule VinRequirementTreatedAsSatisfied30dRule(taxpayer: Individual, vehicle: Asset, dealer: Person) strict {
    when transfer_elected_and_valid_30d(taxpayer, vehicle, dealer);
    when vin_provided_to_secretary_by_eligible_entity_30d(dealer, vehicle);
    then vin_requirement_treated_as_satisfied_30d(taxpayer, vehicle);
}
pub relation election_requirements_apply_as_if_credit_allowed_30d(taxpayer: Individual, vehicle: Asset) kind institutional {
    label en official "section 30D(g)(6)(A)-(B): for an election, the requirements of paragraphs (1) and (2) of subsection (f) apply to the taxpayer as if the credit were allowed to the taxpayer, and paragraph (6) of subsection (f) does not apply";
}
@source(IRC_S30D_G, relation = formalizes, coverage = partial, quote = "the requirements of paragraphs (1) and (2) of subsection (f) shall apply to the taxpayer who acquired the vehicle in the same manner as if the credit determined under this section with respect to such vehicle were allowed to such taxpayer")
rule ElectionRequirementsApplyAsIfCreditAllowed30dRule(taxpayer: Individual, vehicle: Asset, dealer: Person) strict {
    when transfer_elected_and_valid_30d(taxpayer, vehicle, dealer);
    then election_requirements_apply_as_if_credit_allowed_30d(taxpayer, vehicle);
}
pub relation credit_allowed_amount_for_elected_vehicle_30d(dealer: Person, vehicle: Asset, amount: Money) kind empirical {
    label en official "the amount of the credit allowed under subsection (a) with respect to a vehicle sold by the entity for which an election has been made — case-asserted";
}
pub relation advance_payment_amount_30d(dealer: Person, amount: Money) kind institutional {
    label en official "section 30D(g)(7)(A): the advance payment to an eligible entity equals the cumulative amount of the credits allowed with respect to the vehicles it sold for which an election has been made";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "in an amount equal to the cumulative amount of the credits allowed under subsection (a) with respect to any vehicles sold by such entity for which an election described in paragraph (1) has been made")
rule AdvancePaymentAmount30dRule(dealer: Person, one_vehicle: Asset, one_amount: Money) strict {
    when credit_allowed_amount_for_elected_vehicle_30d(dealer, one_vehicle, one_amount);
    then advance_payment_amount_30d(dealer, sum(collect all a: Money, v: Asset where credit_allowed_amount_for_elected_vehicle_30d(dealer, v, a), empty: 0 USD));
}
pub relation advance_payment_treated_as_refund_30d(dealer: Person) kind institutional {
    label en official "section 30D(g)(7)(C): for section 1324 of title 31, the advance payments are treated as a refund due from a credit provision referred to in subsection (b)(2) of that section";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "the payments under subparagraph (A) shall be treated in the same manner as a refund due from a credit provision referred to in subsection (b)(2) of such section")
rule AdvancePaymentTreatedAsRefund30dRule(dealer: Person, amount: Money) strict {
    when advance_payment_amount_30d(dealer, amount);
    then advance_payment_treated_as_refund_30d(dealer);
}
pub relation credit_disallowed_under_f10_30d(taxpayer: Individual, vehicle: Asset) kind empirical {
    label en official "the credit under subsection (a) would otherwise, but for subsection (g), not be allowable to the taxpayer pursuant to the application of subsection (f)(10) — case-asserted";
}
pub relation tax_increase_for_recapture_of_payment_30d(taxpayer: Individual, vehicle: Asset, amount: Money) kind institutional {
    label en official "section 30D(g)(10): for a taxpayer who made the election and received the payment, if the credit would otherwise not be allowable under subsection (f)(10), the tax for the year the vehicle was placed in service is increased by the payment received";
}
@source(IRC_S30D_G, relation = formalizes, coverage = exact, quote = "shall be increased by the amount of the payment received by such taxpayer")
rule TaxIncreaseForRecaptureOfPayment30dRule(taxpayer: Individual, vehicle: Asset, dealer: Person, amount: Money) strict {
    when transfer_elected_and_valid_30d(taxpayer, vehicle, dealer);
    when payment_received_by_taxpayer_from_eligible_entity_30d(taxpayer, vehicle, dealer, amount);
    when credit_disallowed_under_f10_30d(taxpayer, vehicle);
    then tax_increase_for_recapture_of_payment_30d(taxpayer, vehicle, amount);
}
