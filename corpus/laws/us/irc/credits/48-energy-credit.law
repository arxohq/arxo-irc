// Section 48 — Energy credit. Stage 2c (IRC-06 stage 2c, DECISION-0379).
// Priority list item: §48(a)(2)-(11) (energy percentage table by prop
// type with the wage/content rules) — extended through (a)(14), since (12)
// domestic content and (14) energy community are the SAME "applicable
// credit rate increase" idiom the coordinator's own framing names.
//
// This module REPLACES `48-investment-credit.law`'s stage-2 dependency
// contract `energy_credit_amount` (TECH-GAPS G310) with a real
// computation — the first "replace the §38(b) component contracts with
// real rules where implemented" item the coordinator's stage 2c task asks
// for. `48-investment-credit.law` itself (section 48(a) folded into
// `investment_credit`) is NOT edited by this module; the wiring is left as
// a follow-up (TECH-GAPS G391) since that module's own `investment_credit`
// composition is owned by an earlier stage and touching it is outside this
// pass's own scope discipline (module-per-section boundaries).
//
// Judgment calls / scope:
// * (a)(2)(A) energy-percentage table: the 6-percent list is (I) qualified
//   fuel cell prop (ALWAYS 6%, no construction-date test), (III)/(IX)
//   qualified small wind/waste energy recovery/energy storage/biogas/
//   microgrid-controller/combined-heat-and-power/ground-source-heat-pump
//   prop (ALWAYS 6%), and (II) solar-electric/heating-cooling prop
//   (3)(A)(i) OR geothermal-deposit prop (3)(A)(iii) OR solar-
//   illumination/electrochromic prop (3)(A)(ii) — but ONLY for
//   construction beginning before January 1, 2025 (after that date these
//   three fall to the DEFAULT 2 percent, a genuine bifurcation this module
//   models with its own date test). Qualified MICROTURBINE prop
//   (3)(A)(iv)'s second half) is NOT in the 6-percent list at all — it
//   defaults to 2 percent, modelled explicitly as its own category rather
//   than silently merged with fuel cells (both share paragraph (3)(A)(iv)
//   but the RATE list only names "qualified fuel cell prop").
// * (a)(9) the 5x multiplier and its (a)(9)(B) project-requirements gate
//   mirror section 45(b)(6)'s shape exactly — modelled the same way (small
//   project / pre-guidance / wage-and-apprenticeship).
// * (a)(10)-(11) (prevailing wage, apprenticeship) are case-asserted
//   satisfaction facts, same convention as section 45(b)(7)-(8) — the
//   underlying wage/hour arithmetic is EXTERNAL_DEPENDENCY.
// * (a)(12) domestic content and (a)(14) energy community are BOTH modelled
//   as their own "applicable credit rate increase" (2 or 10 PERCENTAGE
//   POINTS depending on whether the (9)(B) project requirements are ALSO
//   satisfied) — added directly to the energy percentage, not as a
//   multiplicative bonus (the statute adds PERCENTAGE POINTS here, unlike
//   section 45(b)(9)'s 10-PERCENT-of-the-amount bonus).
// * (a)(1) (basis of energy prop), (a)(3)(B)-(D) (the completed-
//   construction/original-use, depreciation-allowable, and Secretary
//   performance-standard gates), (a)(4) (tax-exempt-bond reduction), (a)(5)
//   (election to treat qualified facilities as energy prop), (a)(6)-(8)
//   (the historical/solar-specific phaseout schedules and interconnection
//   prop), (a)(13) (elective-payment phaseout), (a)(15)-(16) (clean
//   hydrogen election, regulations) are NOT modelled — TECH_GAP,
//   TECH-GAPS G391.

use self::{
    Asset,
    IRC_S48_A,
    Person,
    TaxableYear,
};

pub enum EnergyPropertyType48 {
    QualifiedFuelCellProperty, QualifiedMicroturbineProperty,
    SolarElectricOrHeatingCoolingProperty, SolarIlluminationOrElectrochromicProperty, GeothermalDepositProperty,
    QualifiedSmallWindEnergyProperty, WasteEnergyRecoveryProperty, EnergyStorageTechnology,
    QualifiedBiogasProperty, MicrogridControllers, CombinedHeatAndPowerSystemProperty, GroundSourceHeatPumpProperty
}

pub relation energy_property_basis(taxpayer: Person, prop: Asset, y: TaxableYear, property_type: EnergyPropertyType48, amount: Money) kind empirical {
    label en official "the basis of the energy prop placed in service during the taxable year (section 48(a)(1)) — case-asserted";
}
pub relation energy_property_construction_begin_date(prop: Asset, on: Date) kind empirical {
    label en official "the date construction of the energy prop began, for the section 48(a)(2)(A)(i)(II) 'before January 1, 2025' test — case-asserted";
}

relation always_six_percent_category_48(property_type: EnergyPropertyType48) kind institutional;
assert "48-six-pct-fuel-cell": always_six_percent_category_48(QualifiedFuelCellProperty);
assert "48-six-pct-small-wind": always_six_percent_category_48(QualifiedSmallWindEnergyProperty);
assert "48-six-pct-waste-energy": always_six_percent_category_48(WasteEnergyRecoveryProperty);
assert "48-six-pct-storage": always_six_percent_category_48(EnergyStorageTechnology);
assert "48-six-pct-biogas": always_six_percent_category_48(QualifiedBiogasProperty);
assert "48-six-pct-microgrid": always_six_percent_category_48(MicrogridControllers);
assert "48-six-pct-chp": always_six_percent_category_48(CombinedHeatAndPowerSystemProperty);
assert "48-six-pct-ground-source": always_six_percent_category_48(GroundSourceHeatPumpProperty);

relation date_dependent_category_48(property_type: EnergyPropertyType48) kind institutional;
assert "48-date-dependent-solar-electric": date_dependent_category_48(SolarElectricOrHeatingCoolingProperty);
assert "48-date-dependent-solar-illumination": date_dependent_category_48(SolarIlluminationOrElectrochromicProperty);
assert "48-date-dependent-geothermal": date_dependent_category_48(GeothermalDepositProperty);

pub relation base_energy_percentage_48(prop: Asset, pct: Decimal) kind institutional {
    label en official "section 48(a)(2)(A): the base energy percentage (before the (9)/(12)/(14) increases) — 6 percent for the always-6-percent categories and for the date-dependent categories with pre-2025 construction, 2 percent otherwise (including qualified microturbine prop, which is not in the 6-percent list)";
}
@source(IRC_S48_A, quote = "6 percent in the case of—\n(I) qualified fuel cell prop")
rule BaseEnergyPercentage48AlwaysSixRule(prop: Asset, property_type: EnergyPropertyType48) strict {
    when energy_property_basis(_, prop, _, property_type, _);
    when always_six_percent_category_48(property_type);
    then base_energy_percentage_48(prop, 0.06);
}
@source(IRC_S48_A, quote = "energy property described in clause (i) or (iii) of paragraph (3)(A) but only with respect to property the construction of which begins before January 1, 2025")
rule BaseEnergyPercentage48DateDependentBeforeRule(prop: Asset, property_type: EnergyPropertyType48, on: Date) strict {
    when energy_property_basis(_, prop, _, property_type, _);
    when date_dependent_category_48(property_type);
    when energy_property_construction_begin_date(prop, on);
    when on < @2025-01-01;
    then base_energy_percentage_48(prop, 0.06);
}
@source(IRC_S48_A, quote = "in the case of any energy property to which clause (i) does not apply, 2 percent")
rule BaseEnergyPercentage48DateDependentAfterRule(prop: Asset, property_type: EnergyPropertyType48, on: Date) strict {
    when energy_property_basis(_, prop, _, property_type, _);
    when date_dependent_category_48(property_type);
    when energy_property_construction_begin_date(prop, on);
    when on >= @2025-01-01;
    then base_energy_percentage_48(prop, 0.02);
}
@source(IRC_S48_A, quote = "in the case of any energy property to which clause (i) does not apply, 2 percent")
rule BaseEnergyPercentage48MicroturbineRule(prop: Asset) strict {
    when energy_property_basis(_, prop, _, QualifiedMicroturbineProperty, _);
    then base_energy_percentage_48(prop, 0.02);
}

// --- §48(a)(9)-(11): the 5x multiplier -------------------------------------------

pub relation energy_project_under_1mw_48(prop: Asset) kind empirical {
    label en official "the energy project has a maximum net output of less than 1 megawatt of electrical or thermal energy (section 48(a)(9)(B)(i)) — case-asserted";
}
pub relation energy_project_construction_before_guidance_48(prop: Asset) kind empirical {
    label en official "construction of the energy project began before the 60-day-after-guidance date (section 48(a)(9)(B)(ii)) — case-asserted";
}
pub relation prevailing_wage_requirement_satisfied_48(prop: Asset, y: TaxableYear) kind empirical {
    label en official "the section 48(a)(10) prevailing-wage requirement is satisfied — case-asserted";
}
pub relation apprenticeship_requirement_satisfied_48(prop: Asset, y: TaxableYear) kind empirical {
    label en official "the section 48(a)(11) apprenticeship requirement (rules similar to section 45(b)(8)) is satisfied — case-asserted";
}
pub relation energy_project_meets_9b_requirements_48(prop: Asset, y: TaxableYear) kind institutional {
    label en official "section 48(a)(9)(B): the energy project meets one of the three qualifying conditions for the 5x multiplier and for the higher domestic-content/energy-community bonus tier";
}
rule EnergyProjectMeets9bSmallProjectRule(prop: Asset, y: TaxableYear) defeasible {
    when energy_property_basis(_, prop, y, _, _);
    when energy_project_under_1mw_48(prop);
    then energy_project_meets_9b_requirements_48(prop, y);
}
rule EnergyProjectMeets9bPreGuidanceRule(prop: Asset, y: TaxableYear) defeasible {
    when energy_property_basis(_, prop, y, _, _);
    when energy_project_construction_before_guidance_48(prop);
    then energy_project_meets_9b_requirements_48(prop, y);
}
rule EnergyProjectMeets9bWageApprenticeshipRule(prop: Asset, y: TaxableYear) defeasible {
    when prevailing_wage_requirement_satisfied_48(prop, y);
    when apprenticeship_requirement_satisfied_48(prop, y);
    then energy_project_meets_9b_requirements_48(prop, y);
}

// --- §48(a)(12)/(14): domestic content and energy community bonuses ------------

pub relation domestic_content_requirement_satisfied_48(prop: Asset) kind empirical {
    label en official "section 48(a)(12)(B) (rules similar to section 45(b)(9)(B)): the domestic-content certification requirement is satisfied — case-asserted";
}
pub relation energy_community_project_48(prop: Asset) kind empirical {
    label en official "section 48(a)(14)(A): the energy project is placed in service within an energy community (section 45(b)(11)(B)) — case-asserted";
}
pub relation domestic_content_rate_increase_48(prop: Asset, y: TaxableYear, points: Decimal) kind institutional {
    label en official "section 48(a)(12)(C): 10 percentage points if the (9)(B) project requirements are also satisfied, else 2 percentage points";
}
@source(IRC_S48_A, quote = "in the case of an energy project which satisfies the requirements of paragraph (9)(B), 10 percentage points")
rule DomesticContentRateIncrease48HighRule(prop: Asset, y: TaxableYear) defeasible {
    when domestic_content_requirement_satisfied_48(prop);
    when energy_project_meets_9b_requirements_48(prop, y);
    then domestic_content_rate_increase_48(prop, y, 0.10);
}
@source(IRC_S48_A, quote = "in the case of an energy project which does not satisfy the requirements of paragraph (9)(B), 2 percentage points")
rule DomesticContentRateIncrease48LowRule(prop: Asset, y: TaxableYear) defeasible {
    when energy_percentage_before_bonuses_48(prop, y, _);
    when domestic_content_requirement_satisfied_48(prop);
    when not_known(energy_project_meets_9b_requirements_48(prop, y));
    then domestic_content_rate_increase_48(prop, y, 0.02);
}
pub relation energy_community_rate_increase_48(prop: Asset, y: TaxableYear, points: Decimal) kind institutional {
    label en official "section 48(a)(14)(B): 10 percentage points if the (9)(B) project requirements are also satisfied, else 2 percentage points";
}
@source(IRC_S48_A, quote = "in the case of any energy project which satisfies the requirements of paragraph (9)(B), 10 percentage points")
rule EnergyCommunityRateIncrease48HighRule(prop: Asset, y: TaxableYear) defeasible {
    when energy_community_project_48(prop);
    when energy_project_meets_9b_requirements_48(prop, y);
    then energy_community_rate_increase_48(prop, y, 0.10);
}
@source(IRC_S48_A, quote = "in the case of any energy project which does not satisfy the requirements of paragraph (9)(B), 2 percentage points")
rule EnergyCommunityRateIncrease48LowRule(prop: Asset, y: TaxableYear) defeasible {
    when energy_percentage_before_bonuses_48(prop, y, _);
    when energy_community_project_48(prop);
    when not_known(energy_project_meets_9b_requirements_48(prop, y));
    then energy_community_rate_increase_48(prop, y, 0.02);
}

// --- §48(a): energy credit --------------------------------------------------------

pub relation energy_percentage_before_bonuses_48(prop: Asset, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 48(a)(2)/(9): the base energy percentage, multiplied by 5 for a qualifying energy project, before the (12)/(14) percentage-point bonuses";
}
@source(IRC_S48_A, quote = "the amount of the credit determined under this subsection (determined after the application of paragraphs (1) through (8) and paragraph (15) and without regard to this clause) shall be equal to such amount multiplied by 5")
rule EnergyPercentageBeforeBonusesFiveTimesRule(prop: Asset, y: TaxableYear, base: Decimal) defeasible {
    when energy_property_basis(_, prop, y, _, _);
    when base_energy_percentage_48(prop, base);
    when energy_project_meets_9b_requirements_48(prop, y);
    then energy_percentage_before_bonuses_48(prop, y, base * 5.0);
}
rule EnergyPercentageBeforeBonusesBaseOnlyRule(prop: Asset, y: TaxableYear, base: Decimal) defeasible {
    when energy_property_basis(_, prop, y, _, _);
    when base_energy_percentage_48(prop, base);
    when not_known(energy_project_meets_9b_requirements_48(prop, y));
    then energy_percentage_before_bonuses_48(prop, y, base);
}

pub relation domestic_content_rate_increase_or_zero_48(prop: Asset, y: TaxableYear, points: Decimal) kind institutional;
rule DomesticContentRateIncreaseOrZero48PresentRule(prop: Asset, y: TaxableYear, points: Decimal) defeasible {
    when domestic_content_rate_increase_48(prop, y, points);
    then domestic_content_rate_increase_or_zero_48(prop, y, points);
}
rule DomesticContentRateIncreaseOrZero48AbsentRule(prop: Asset, y: TaxableYear) defeasible {
    when energy_percentage_before_bonuses_48(prop, y, _);
    when not_known(domestic_content_requirement_satisfied_48(prop));
    then domestic_content_rate_increase_or_zero_48(prop, y, 0.0);
}
pub relation energy_community_rate_increase_or_zero_48(prop: Asset, y: TaxableYear, points: Decimal) kind institutional;
rule EnergyCommunityRateIncreaseOrZero48PresentRule(prop: Asset, y: TaxableYear, points: Decimal) defeasible {
    when energy_community_rate_increase_48(prop, y, points);
    then energy_community_rate_increase_or_zero_48(prop, y, points);
}
rule EnergyCommunityRateIncreaseOrZero48AbsentRule(prop: Asset, y: TaxableYear) defeasible {
    when energy_percentage_before_bonuses_48(prop, y, _);
    when not_known(energy_community_project_48(prop));
    then energy_community_rate_increase_or_zero_48(prop, y, 0.0);
}

pub relation energy_percentage_48(prop: Asset, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the section 48(a)(2) energy percentage after the (9) 5x multiplier and the (12)/(14) percentage-point bonuses";
}
rule EnergyPercentage48Rule(prop: Asset, y: TaxableYear, before: Decimal, dc: Decimal, ec: Decimal) defeasible {
    when energy_percentage_before_bonuses_48(prop, y, before);
    when domestic_content_rate_increase_or_zero_48(prop, y, dc);
    when energy_community_rate_increase_or_zero_48(prop, y, ec);
    then energy_percentage_48(prop, y, before + dc + ec);
}
pub relation energy_credit_amount_per_property(taxpayer: Person, prop: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(a): the energy credit for a single energy property for the taxable year";
}
@source(IRC_S48_A, quote = "the energy credit for any taxable year is the energy percentage of the basis of each energy property placed in service during such taxable year")
rule EnergyCreditAmountPerPropertyRule(taxpayer: Person, prop: Asset, y: TaxableYear, pct: Decimal, basis: Money) defeasible {
    when energy_percentage_48(prop, y, pct);
    when energy_property_basis(taxpayer, prop, y, _, basis);
    then energy_credit_amount_per_property(taxpayer, prop, y, round(pct * basis, 2, "HALF_UP"));
}
pub relation energy_credit_amount(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 48(a): the energy credit for the taxable year, summed across all energy properties — REPLACES the pending TECH-GAPS G310 dependency contract (48-investment-credit.law) with a real computation";
}
rule EnergyCreditAmountRule(taxpayer: Person, y: TaxableYear) defeasible {
    when energy_property_basis(taxpayer, _, y, _, _);
    then energy_credit_amount(taxpayer, y,
        sum all amount: Money for prop: Asset where energy_credit_amount_per_property(taxpayer, prop, y, amount));
}
