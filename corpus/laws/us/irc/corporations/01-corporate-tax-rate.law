// Section 11 (tax imposed on corporations) and section 12 (cross
// references). Stage 1 (IRC-08 stage 1, A06), priority section.
//
// METHOD: section 11(a) imposes the liability; section 11(b) fixes the flat
// 21 percent rate as an A3 parameter (`.lawparam.json`, half-open interval
// from the amendment's effective date — Pub. L. 115-97 section 13001,
// applicable to taxable years beginning after December 31, 2017), never a
// bare literal, per AGENT-BRIEF's "never invent a rate" rule even though
// this rate is exact text, not indexed: the flat rate itself has a history
// (graduated brackets before 2018) that a later stage may need to carry
// as additional interval rows. `taxable_income` is asserted as a case fact
// (the computation of taxable income itself belongs to `gross-income` /
// `deductions`, not this package).
//
// Section 11(c) (exceptions for corporations taxed under section 594,
// subchapter L or subchapter M) is a NEGATIVE CONDITION on the section
// 11(a)/(b) liability, not a separate norm: modelled as an `unless` guard
// keyed to a classification relation this package does NOT itself compute
// (whether a corporation IS subject to a section 594/subchapter L/
// subchapter M tax is `insurance`/mutual-savings-bank ownership,
// EXTERNAL_DEPENDENCY, package not yet assigned in OWNERSHIP.json as read).
// Section 11(d) (foreign corporations: section 11(a) and section 55 apply
// only as section 882 provides) is the same shape — a negative condition
// keyed to `taxed_under_882_only`, EXTERNAL_DEPENDENCY on `international`
// (section 882 owner). Section 12 is a pure cross-reference table (five
// "for ... see section ..." pointers to sections 511, 531-565, 891, 1442,
// and a fifth item) — NON_NORMATIVE, no independent legal consequence.


use self::{
    Corporation,
    IRC_S11_A,
    IRC_S11_B,
    IRC_S11_C,
    IRC_S11_NOTE_4,
    TaxableYear,
};

@source(IRC_S11_A, quote = "A tax is hereby imposed for each taxable year on the taxable income of every corporation.")
pub relation taxable_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of a corporation for a taxable year";
}

// Negative conditions for section 11(c)-(d); asserted by the (not yet
// owned) classification package(s), never guessed here.
pub relation subject_to_section_594_tax(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the corporation is subject to the section 594 tax on mutual savings banks conducting life insurance business, for the taxable year";
}
pub relation subject_to_subchapter_l_tax(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the corporation is subject to a subchapter L tax (insurance companies), for the taxable year";
}
pub relation subject_to_subchapter_m_tax(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the corporation is subject to a subchapter M tax (regulated investment companies and real estate investment trusts), for the taxable year";
}
pub relation section_11_c_exception_applies(c: Corporation, y: TaxableYear) kind institutional {
    label en official "section 11(a) does not apply because the corporation is subject to a tax imposed by section 594, subchapter L, or subchapter M";
}
@source(IRC_S11_C, quote = "Subsection (a) shall not apply to a corporation subject to a tax imposed by—")
rule Section11cExceptionFrom594(c: Corporation, y: TaxableYear) strict {
    label en official "section 11(c)(1): section 11(a) does not apply to a corporation subject to the section 594 tax";
    when subject_to_section_594_tax(c, y);
    then section_11_c_exception_applies(c, y);
}
@source(IRC_S11_C, quote = "(2) subchapter L (sec. 801 and following, relating to insurance companies), or")
rule Section11cExceptionFromSubchapterL(c: Corporation, y: TaxableYear) strict {
    label en official "section 11(c)(2): section 11(a) does not apply to a corporation subject to a subchapter L tax";
    when subject_to_subchapter_l_tax(c, y);
    then section_11_c_exception_applies(c, y);
}
@source(IRC_S11_C, quote = "(3) subchapter M (sec. 851 and following, relating to regulated investment companies and real estate investment trusts).")
rule Section11cExceptionFromSubchapterM(c: Corporation, y: TaxableYear) strict {
    label en official "section 11(c)(3): section 11(a) does not apply to a corporation subject to a subchapter M tax";
    when subject_to_subchapter_m_tax(c, y);
    then section_11_c_exception_applies(c, y);
}

// Section 11(d): foreign corporations taxed only as section 882 provides.
// EXTERNAL_DEPENDENCY: `foreign(c)` (section 7701(a)(5) classification) and
// `taxed_under_882_only` are owned by `us.irc.definitions` / `international`
// respectively; asserted here as institutional switches this package reads,
// never computed by this package.
pub relation foreign_corporation(c: Corporation) kind institutional {
    label en official "a foreign corporation, for purposes of section 11(d)";
}

@source(IRC_S11_B, quote = "The amount of the tax imposed by subsection (a) shall be 21 percent of taxable income.")
pub relation corporate_tax(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the tax imposed by section 11(a): 21 percent of taxable income (section 11(b))";
}

@source(IRC_S11_A, quote = "A tax is hereby imposed for each taxable year on the taxable income of every corporation.")
@source(IRC_S11_B, quote = "The amount of the tax imposed by subsection (a) shall be 21 percent of taxable income.")
rule CorporateTaxRule(c: Corporation, y: TaxableYear, income: Money) defeasible {
    label en official "section 11(a)-(b): a flat 21 percent tax on the taxable income of every corporation, unless section 11(c) or 11(d) displaces it";
    when taxable_income(c, y, income);
    when not_known(section_11_c_exception_applies(c, y));
    when not_known(foreign_corporation(c));
    then corporate_tax(c, y, round(income * CorporateTaxRate21Percent, 2, "HALF_UP"));
}

// Section 11(d): a foreign corporation's liability under this section is
// NOT computed here (section 882 is the owning norm) — recorded as a
// TECH_GAP/EXTERNAL_DEPENDENCY switch only: `foreign_corporation` blocks
// the default rule above, and `international` (section 882's owner) is
// expected to assert the corporation's actual chapter-1 liability instead
// of this package inventing one.

// WIRE-2 (stage 2, HANDOFF.md): several sibling packages (international,
// s-corporations, exempt-organizations, special-entities, trusts-estates)
// need "the section 11(b) rate" (or "the highest rate under section 11(b)")
// as a `pub` fact rather than re-deriving/duplicating the A3 dataset. This
// exports the SAME constant `CorporateTaxRule` reads, for the identical
// (corporation, taxable year) key a consumer already has from its own
// section 11 computation or from asserting one.
@source(IRC_S11_B, quote = "The amount of the tax imposed by subsection (a) shall be 21 percent of taxable income.")
pub relation corporate_tax_rate(c: Corporation, y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the flat rate of tax under section 11(b) applicable to the corporation for the taxable year (0.21 since taxable years beginning after December 31, 2017), exported so other packages need not duplicate the A3 rate dataset";
}
@source(IRC_S11_B, quote = "The amount of the tax imposed by subsection (a) shall be 21 percent of taxable income.")
rule CorporateTaxRateExportRule(c: Corporation, y: TaxableYear, income: Money) strict {
    label en official "section 11(b): export the flat rate for the same (corporation, taxable year) pair the section 11 tax computation reads";
    when taxable_income(c, y, income);
    then corporate_tax_rate(c, y, CorporateTaxRate21Percent);
}

// STAGE 3 (26.09.2026) — DECISIONS Д-11: the maximum-rate export, keyed by
// the taxable year ALONE. `corporate_tax_rate(c, y, rate)` above needs the
// corporation's own `taxable_income` fact, so a consumer that needs "the
// highest rate of tax specified in section 11(b)" without a corporation or
// an income figure (s-corporations §1374(b)/§1375, international
// §954(b)(4)/§904, assessment §6225(b)(1)(B), special-entities §1352) could
// not import it. The year is bound by core's `begins(y, d)` and the section
// 11(b) applicability boundary is read from the pinned effective-date note
// (Pub. L. 115-97 §13001(c)(1): taxable years beginning after December 31,
// 2017); the VALUE is the same A3 constant `CorporateTaxRule` reads. Under
// current law section 11(b) is ONE flat rate, so "the highest rate" IS that
// rate. For a year beginning before 2018 no rule concludes (the graduated
// 15-to-35-percent schedule is not in the pinned 2024 text; TECH-GAPS
// G3300) — an absent rate, never a guessed one.
@source(IRC_S11_NOTE_4, quote = "Except as otherwise provided in this subsection, the amendments made by subsections (a) and (b)")
pub relation maximum_section_11b_rate(y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the highest rate of tax specified in section 11(b) for the taxable year (0.21 for taxable years beginning after December 31, 2017); keyed by the year alone so that other packages can read it without a corporation or a taxable-income figure";
}
@source(IRC_S11_B, quote = "The amount of the tax imposed by subsection (a) shall be 21 percent of taxable income.")
@source(IRC_S11_NOTE_4, quote = "Except as otherwise provided in this subsection, the amendments made by subsections (a) and (b)")
rule MaximumSection11bRateRule(y: TaxableYear, begins_on: Date) strict {
    label en official "section 11(b) as amended by Pub. L. 115-97 section 13001: for a taxable year beginning after December 31, 2017 the single rate of 21 percent is the highest section 11(b) rate";
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2017-12-31;
    then maximum_section_11b_rate(y, CorporateTaxRate21Percent);
}

// Section 12 is a pure cross-reference table (no operative rule):
// (1) section 511 (unrelated business income tax); (2) subchapter G, parts
// I-II, sections 531 and following (accumulated earnings / personal
// holding company tax — stage 2 per the owner's scope note); (3) section
// 891 (doubling of tax for certain foreign countries); (4) section 1442
// (withholding rate for foreign corporations); a fifth cross-reference
// item recorded in the pinned text. NON_NORMATIVE: "for ... see section
// ..." creates no independent legal consequence of its own.
