// Section 338 — certain stock purchases treated as asset acquisitions.
// Stage 2 (IRC-08 stage 2, A06), priority section ("§338 fully: qualified
// stock purchase 80% within 12 months, the election as a power with the
// 15th day of the 9th month deadline — exact date arithmetic, deemed sale,
// the aggregate deemed sale price / adjusted grossed-up basis as
// calculations with intermediate values, (h)(10) election").
//
// METHOD: section 338(d)(3)'s "qualified stock purchase" reuses module 06's
// `meets_1504a2_ownership(owner, subsidiary, on)` (the section 1504(a)(2)
// 80%-vote-and-80%-value test) rather than redeclaring an equivalent
// relation, per this package's own convention of naming a shared
// cross-reference instead of duplicating it. Section 338(g)'s election
// deadline (15th day of the 9th month beginning after the month of the
// acquisition date) is computed with EXACT date arithmetic via
// `add_calendar_period`, modelled as a `power` (irrevocable once validly
// exercised, per (g)(3)). Section 338(a)'s deemed-sale/deemed-new-
// corporation treatment and section 338(b)'s grossed-up-basis/aggregate-
// basis formulas are calculations with the named intermediate values
// (grossed-up basis, then total basis = grossed-up basis + nonrecently
// purchased stock basis). Section 338(b)(2)'s liability adjustment and
// (b)(5)'s asset-by-asset allocation are EXTERNAL_DEPENDENCY (regulations
// prescribed by the Secretary, no statutory formula — same posture as
// section 312(h)/307(a)). Section 338(h)(10) is modelled as a further power
// (elective recognition by the target with nonrecognition to the selling
// group). Sections 338(e) (deemed election on asset acquisitions), (f)
// (consistency requirement), and the deep (h) definitional apparatus beyond
// (h)(1)-(2) (12-month acquisition period, acquisition date) are TECH_GAP/
// NON_NORMATIVE this stage (see file footer).

use self::{
    Asset,
    Corporation,
    IRC_S338_A,
    IRC_S338_B,
    IRC_S338_D,
    IRC_S338_G,
    IRC_S338_H,
    meets_1504a2_ownership,
};

pub entity StockPurchaseElection { label en unofficial "a purchasing corporation's election under section 338 with respect to a qualified stock purchase of a target corporation"; }

// --- Section 338(d): purchasing/target corporation, qualified stock ------
// --- purchase ---------------------------------------------------------------

@source(IRC_S338_D, quote = "The term \"qualified stock purchase\" means any transaction or series of transactions in which stock (meeting the requirements of section 1504(a)(2)) of 1 corporation is acquired by another corporation by purchase during the 12-month acquisition period.")
pub relation stock_acquired_by_purchase_in_12_month_period(purchasing: Corporation, target: Corporation, acquisition_date: Date) kind empirical {
    label en official "section 338(h)(1)/(3): the purchasing corporation acquired stock of the target corporation by purchase (section 338(h)(3)'s own basis/nonrecognition/attribution conditions — TECH_GAP, read as a case fact) during the 12-month acquisition period ending on the acquisition date";
}
pub relation qualified_stock_purchase(purchasing: Corporation, target: Corporation, acquisition_date: Date) kind institutional {
    label en official "section 338(d)(3): a qualified stock purchase — stock meeting the section 1504(a)(2) 80 percent vote/value test acquired by purchase during the 12-month acquisition period";
}
@source(IRC_S338_D, quote = "The term \"qualified stock purchase\" means any transaction or series of transactions in which stock (meeting the requirements of section 1504(a)(2)) of 1 corporation is acquired by another corporation by purchase during the 12-month acquisition period.")
rule QualifiedStockPurchaseRule(purchasing: Corporation, target: Corporation, acquisition_date: Date) strict {
    label en official "section 338(d)(3): the 80 percent section 1504(a)(2) test, acquired by purchase during the 12-month period, is a qualified stock purchase";
    when stock_acquired_by_purchase_in_12_month_period(purchasing, target, acquisition_date);
    when meets_1504a2_ownership(purchasing, target, acquisition_date);
    then qualified_stock_purchase(purchasing, target, acquisition_date);
}

// --- Section 338(g): the election, exact date arithmetic ------------------

pub relation section_338_election_filed(e: StockPurchaseElection, purchasing: Corporation, target: Corporation, acquisition_date: Date, filed_on: Date) kind empirical {
    label en official "section 338(g)(2): the purchasing corporation's election under section 338, in the manner the Secretary prescribes, filed on the given date";
}
// The 15th day of the 9th month beginning after the month in which the
// acquisition date occurs: 9 months after the FIRST day of the month of
// the acquisition date reaches the first day of the 9th following month;
// its 15th day is 14 days later (same construction this package's sibling
// packages use for "Nth day of the Mth month" deadlines).
pub relation first_day_of_acquisition_month(acquisition_date: Date, first_of_month: Date) kind empirical {
    label en unofficial "the first day of the calendar month in which the acquisition date falls (an input this package does not itself derive from a bare Date, absent a `month_start`-style core primitive — same TERM-OF-DATES class as TECH-GAPS G9/G10/G21)";
}
pub relation section_338g_deadline(purchasing: Corporation, target: Corporation, acquisition_date: Date, deadline: Date) kind institutional {
    label en official "section 338(g)(1): the 15th day of the 9th month beginning after the month in which the acquisition date occurs";
}
@source(IRC_S338_G, quote = "an election under this section shall be made not later than the 15th day of the 9th month beginning after the month in which the acquisition date occurs.")
rule Section338gDeadlineRule(purchasing: Corporation, target: Corporation, acquisition_date: Date, first_of_month: Date) strict {
    label en official "section 338(g)(1): exact date arithmetic for the 15th-day-of-the-9th-month deadline";
    when qualified_stock_purchase(purchasing, target, acquisition_date);
    when first_day_of_acquisition_month(acquisition_date, first_of_month);
    then section_338g_deadline(purchasing, target, acquisition_date, add_calendar_period(add_calendar_period(first_of_month, 9 calendar_month), 14 calendar_day));
}
pub relation section_338_election_timely(e: StockPurchaseElection, purchasing: Corporation, target: Corporation, acquisition_date: Date, filed_on: Date) kind institutional {
    label en official "section 338(g)(1): the election is timely — filed not later than the section 338(g) deadline";
}
rule Section338ElectionTimelyRule(e: StockPurchaseElection, purchasing: Corporation, target: Corporation, acquisition_date: Date, filed_on: Date, deadline: Date) strict {
    label en official "section 338(g)(1): timeliness is exactly filed_on <= deadline";
    when section_338_election_filed(e, purchasing, target, acquisition_date, filed_on);
    when section_338g_deadline(purchasing, target, acquisition_date, deadline);
    when filed_on <= deadline;
    then section_338_election_timely(e, purchasing, target, acquisition_date, filed_on);
}
pub relation section_338_election_made(e: StockPurchaseElection, purchasing: Corporation, target: Corporation, acquisition_date: Date) kind institutional {
    label en official "section 338(a): the purchasing corporation has made a valid, irrevocable election under section 338 with respect to the qualified stock purchase";
}
@source(IRC_S338_G, quote = "An election by a purchasing corporation under this section, once made, shall be irrevocable.")
rule Section338ElectionPowerRule strict {
    label en official "section 338(g): the purchasing corporation's power to elect section 338 treatment, valid only if timely filed, irrevocable once made";
    for e: StockPurchaseElection; for purchasing: Corporation; for target: Corporation; for acquisition_date: Date; for filed_on: Date;
    when section_338_election_filed(e, purchasing, target, acquisition_date, filed_on);
    when qualified_stock_purchase(purchasing, target, acquisition_date);
    then power Section338Election {
        holder purchasing;
        over target;
        exercise section_338_election_filed(e, purchasing, target, acquisition_date, filed_on);
        valid_when section_338_election_timely(e, purchasing, target, acquisition_date, filed_on);
        effect create(section_338_election_made(e, purchasing, target, acquisition_date));
        window [@1982-09-01, infinity);
    };
}

// --- Section 338(a): deemed sale and deemed new corporation ---------------

pub relation target_deemed_sold_all_assets(e: StockPurchaseElection, target: Corporation, acquisition_date: Date) kind institutional {
    label en official "section 338(a)(1): the target corporation is treated as having sold all of its assets, at the close of the acquisition date, at fair market value in a single transaction";
}
@source(IRC_S338_A, quote = "shall be treated as having sold all of its assets at the close of the acquisition date at fair market value in a single transaction, and")
rule TargetDeemedSoldAllAssetsRule(e: StockPurchaseElection, purchasing: Corporation, target: Corporation, acquisition_date: Date) strict {
    label en official "section 338(a)(1): the deemed asset sale";
    when section_338_election_made(e, purchasing, target, acquisition_date);
    then target_deemed_sold_all_assets(e, target, acquisition_date);
}
pub relation target_deemed_new_corporation(e: StockPurchaseElection, target: Corporation, acquisition_date: Date) kind institutional {
    label en official "section 338(a)(2): the target corporation is treated as a new corporation, which purchased all of the deemed-sold assets as of the beginning of the day after the acquisition date";
}
@source(IRC_S338_A, quote = "shall be treated as a new corporation which purchased all of the assets referred to in paragraph (1) as of the beginning of the day after the acquisition date.")
rule TargetDeemedNewCorporationRule(e: StockPurchaseElection, purchasing: Corporation, target: Corporation, acquisition_date: Date) strict {
    label en official "section 338(a)(2): the deemed new corporation";
    when section_338_election_made(e, purchasing, target, acquisition_date);
    then target_deemed_new_corporation(e, target, acquisition_date);
}

// --- Section 338(b): the aggregate deemed sale price / adjusted grossed- --
// --- up basis calculation, with intermediate values ------------------------

pub relation recently_purchased_stock_basis(e: StockPurchaseElection, amount: Money) kind empirical {
    label en official "section 338(b)(6)(A): the basis of the purchasing corporation's recently purchased stock (acquired during the 12-month acquisition period)";
}
pub relation nonrecently_purchased_stock_basis(e: StockPurchaseElection, amount: Money) kind empirical {
    label en official "section 338(b)(6)(B): the basis of the purchasing corporation's nonrecently purchased stock (held on the acquisition date, not recently purchased)";
}
pub relation recently_purchased_stock_value_percentage(e: StockPurchaseElection, share: Decimal) kind empirical {
    label en unofficial "the percentage of stock (by value) in the target corporation attributable to the purchasing corporation's recently purchased stock, for the section 338(b)(4) grossed-up-basis fraction";
}
pub relation nonrecently_purchased_stock_value_percentage(e: StockPurchaseElection, share: Decimal) kind empirical {
    label en unofficial "the percentage of stock (by value) in the target corporation attributable to the purchasing corporation's nonrecently purchased stock";
}
pub relation grossed_up_basis_338b4(e: StockPurchaseElection, amount: Money) kind institutional {
    label en official "section 338(b)(4): the grossed-up basis — the basis of the recently purchased stock, multiplied by (100 percent minus the nonrecently-purchased-stock percentage) over the recently-purchased-stock percentage";
}
@source(IRC_S338_B, quote = "the grossed-up basis shall be an amount equal to the basis of the corporation's recently purchased stock, multiplied by a fraction—")
rule GrossedUpBasisRule(e: StockPurchaseElection, recent_basis: Money, recent_pct: Decimal, nonrecent_pct: Decimal) strict {
    label en official "section 338(b)(4): exact grossed-up basis calculation";
    when recently_purchased_stock_basis(e, recent_basis);
    when recently_purchased_stock_value_percentage(e, recent_pct);
    when nonrecently_purchased_stock_value_percentage(e, nonrecent_pct);
    when recent_pct > 0.0;
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then grossed_up_basis_338b4(e, div_round(recent_basis * (1.0 - nonrecent_pct), recent_pct, 2, "HALF_UP"));
}
pub relation aggregate_deemed_purchase_price_338b1(e: StockPurchaseElection, amount: Money) kind institutional {
    label en official "section 338(b)(1): the amount for which the target corporation's assets are treated as purchased — the grossed-up basis of recently purchased stock plus the basis of nonrecently purchased stock (before the section 338(b)(2) liability adjustment)";
}
@source(IRC_S338_B, quote = "the grossed-up basis of the purchasing corporation's recently purchased stock, and")
rule AggregateDeemedPurchasePriceRule(e: StockPurchaseElection, grossed_up: Money, nonrecent_basis: Money) strict {
    label en official "section 338(b)(1): aggregate deemed purchase price before the (b)(2) liability adjustment";
    when grossed_up_basis_338b4(e, grossed_up);
    when nonrecently_purchased_stock_basis(e, nonrecent_basis);
    then aggregate_deemed_purchase_price_338b1(e, grossed_up + nonrecent_basis);
}
// Section 338(b)(2): the liability/other-relevant-items adjustment — no
// statutory formula, delegated to Treasury regulations; EXTERNAL_DEPENDENCY,
// same posture as section 312(h)/307(a).
external judgment relation aggregate_deemed_purchase_price_adjusted_338b2(e: StockPurchaseElection, adjusted_amount: Money) {
    authority Secretary;
    label en official "section 338(b)(2): the section 338(b)(1) amount as adjusted, under regulations prescribed by the Secretary, for liabilities of the target corporation and other relevant items — the ADJUSTED grossed-up basis (no statutory formula)";
}
// Section 338(b)(5): allocation of the adjusted amount among the target's
// assets — also delegated to Treasury regulations.
external judgment relation adjusted_purchase_price_allocated_to_asset_338b5(e: StockPurchaseElection, asset: Asset, allocated_amount: Money) {
    authority Secretary;
    label en official "section 338(b)(5): the amount determined under section 338(b)(1)-(2) allocated to a specific asset of the target corporation, under regulations prescribed by the Secretary";
}

// --- Section 338(h)(10): elective recognition by target, nonrecognition ----
// --- to the selling consolidated group -------------------------------------

pub relation target_member_of_selling_consolidated_group(e: StockPurchaseElection, target: Corporation) kind empirical {
    label en official "section 338(h)(10)(A)(i): before the transaction, the target corporation was a member of the selling consolidated group";
}
pub relation target_recognizes_gain_as_if_asset_sale_338h10(e: StockPurchaseElection, target: Corporation) kind empirical {
    label en official "section 338(h)(10)(A)(ii): the target corporation recognizes gain or loss with respect to the transaction as if it sold all of its assets in a single transaction";
}
pub relation section_338h10_election_made(e: StockPurchaseElection, target: Corporation) kind institutional {
    label en official "section 338(h)(10)(A): the target corporation is treated as a member of the selling consolidated group with respect to the deemed sale, and (to the extent regulations provide) no gain or loss is recognized on the stock sold by members of the selling consolidated group";
}
@source(IRC_S338_H, quote = "then the target corporation shall be treated as a member of the selling consolidated group with respect to such sale, and (to the extent provided in regulations) no gain or loss will be recognized on stock sold or exchanged in the transaction by members of the selling consolidated group.")
rule Section338h10ElectionMadeRule(e: StockPurchaseElection, target: Corporation) strict {
    label en official "section 338(h)(10)(A): the elective recognition/nonrecognition combination";
    when target_member_of_selling_consolidated_group(e, target);
    when target_recognizes_gain_as_if_asset_sale_338h10(e, target);
    then section_338h10_election_made(e, target);
}

// NOT DONE this stage (TECH_GAP/EXTERNAL_DEPENDENCY/NON_NORMATIVE, see
// coverage rows): section 338(b)(3) (the election to step up the basis of
// nonrecently purchased stock, itself a further power with its own
// gain-recognition consequence); section 338(e)-(f) (deemed election on
// asset acquisitions during the consistency period, and the consistency-
// required-for-all-acquisitions rule); section 338(h)(1) (12-month
// acquisition period start date via the section 318(a) constructive-
// ownership bridge for subparagraph-(C) purchases — same bounded-hop class
// as G37/G61/G63), (h)(3)(A)-(C) ("purchase" definition's own three sub-
// conditions and the related-corporation exception), (h)(4)-(9) (consistency
// period, affiliated group/target affiliate definitions, the affiliated-
// group-as-one-corporation aggregation, the target-not-a-selling-group-
// member default), (h)(11) (elective fair-market-value formula), (h)(13)
// (coordination with estimated-tax section 6655), (h)(15)-(16) (combined
// deemed sale returns, foreign-tax-credit coordination); section 338(c) is
// REPEALED (confirmed on the pinned fragment's face — NON_NORMATIVE).
