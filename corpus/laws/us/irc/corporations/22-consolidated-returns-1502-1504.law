// Stage 3b (26.09.2026, TECH_GAP reduction). Sections 1502 (consolidated
// return regulations: a power of the Secretary), 1503 (computation and
// payment: the governing regulations, the section 801 insurance-company
// loss rule, dual consolidated losses, intragroup stock basis, preferred
// dividend loss limitation) and section 1504(a)(3)-(5), (b)-(f) (five-year
// bar to reconsolidation, excluded preferred stock, includible corporations,
// insurance companies, the contiguous-country subsidiary, tax-exempt groups,
// former DISCs). Status implemented_unverified: nothing here was executed.

// --- Section 1502: regulations ---------------------------------------------------

use self::{
    AffiliatedGroup,
    Asset,
    Corporation,
    IRC_S1502,
    IRC_S1503_A,
    IRC_S1503_C,
    IRC_S1503_D,
    IRC_S1503_E,
    IRC_S1503_F,
    IRC_S1504_A,
    IRC_S1504_B,
    IRC_S1504_C,
    IRC_S1504_D,
    IRC_S1504_E,
    IRC_S1504_F,
    TaxableYear,
    affiliated_group,
    common_parent_of,
    makes_consolidated_return,
    meets_1504a2_ownership,
    member_of_affiliated_group,
};

pub entity Section1502Regulation { label en unofficial "a regulation prescribed by the Secretary under section 1502 for affiliated groups making consolidated returns"; }
pub relation secretary_prescribes_1502_regulation(reg: Section1502Regulation) kind empirical {
    label en unofficial "the Secretary prescribes the regulation";
}
pub relation regulation_clearly_reflects_income_or_prevents_avoidance_1502(reg: Section1502Regulation) kind empirical {
    label en official "the regulation is necessary in order that the tax liability of the group and of each member may be returned, determined, computed, assessed, collected and adjusted in such manner as clearly to reflect the income-tax liability, or in order to prevent avoidance of such tax liability (section 1502) — the Secretary's own determination";
}
pub relation regulation_prescribed_on_1502(reg: Section1502Regulation, on: Date) kind empirical {
    label en unofficial "the date on which the regulation was prescribed";
}
pub relation section_1502_regulation_in_force(reg: Section1502Regulation) kind institutional {
    label en official "the regulation under section 1502 is validly prescribed and in force";
}
@source(IRC_S1502, quote = "The Secretary shall prescribe such regulations as he may deem necessary in order that the tax liability of any affiliated group of corporations making a consolidated return and of each corporation in the group")
rule Section1502RegulationPowerRule strict {
    label en official "section 1502: the Secretary's power to prescribe the consolidated-return regulations; a regulation that neither clearly reflects income nor prevents avoidance is an invalid exercise and has no effect (E-0239)";
    for reg: Section1502Regulation;
    when secretary_prescribes_1502_regulation(reg);
    then power Section1502RegulationPower {
        holder us.irc.core::Secretary;
        over reg;
        exercise secretary_prescribes_1502_regulation(reg);
        valid_when regulation_clearly_reflects_income_or_prevents_avoidance_1502(reg);
        effect create(section_1502_regulation_in_force(reg));
        window [-infinity, infinity];
    };
}
pub relation secretary_prescribes_differing_rules_1502(group: AffiliatedGroup) kind empirical {
    label en unofficial "the Secretary prescribes rules for the group that differ from the chapter 1 provisions that would apply if the corporations filed separate returns";
}
@source(IRC_S1502, quote = "the Secretary may prescribe rules that are different from the provisions of chapter 1 that would apply if such corporations filed separate returns.")
rule Section1502DifferentRulesLibertyRule(group: AffiliatedGroup, parent: Corporation) defeasible {
    label en official "section 1502, second sentence: the Secretary may prescribe rules different from those for separate returns";
    when common_parent_of(group, parent);
    then liberty SecretaryMayPrescribeRulesDifferentFromSeparateReturns1502 {
        holder us.irc.core::Secretary;
        against parent;
        action secretary_prescribes_differing_rules_1502(group);
        window [-infinity, infinity];
    };
}

// --- Section 1503(a): the governing regulations -------------------------------------

pub relation consolidated_return_required_1503(group: AffiliatedGroup, y: TaxableYear) kind empirical {
    label en unofficial "a consolidated return is required to be made for the taxable year";
}
pub relation consolidated_return_made_or_required_1503(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "a consolidated return is made or is required to be made (section 1503(a))";
}
@source(IRC_S1503_A, quote = "In any case in which a consolidated return is made or is required to be made")
rule Section1503aMadeRule(group: AffiliatedGroup, y: TaxableYear) defeasible {
    label en official "section 1503(a): a consolidated return is made";
    when makes_consolidated_return(group, y);
    then consolidated_return_made_or_required_1503(group, y);
}
@source(IRC_S1503_A, quote = "In any case in which a consolidated return is made or is required to be made")
rule Section1503aRequiredRule(group: AffiliatedGroup, y: TaxableYear) defeasible {
    label en official "section 1503(a): a consolidated return is required to be made";
    when consolidated_return_required_1503(group, y);
    then consolidated_return_made_or_required_1503(group, y);
}
pub relation consolidated_return_due_date_1503(group: AffiliatedGroup, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the last day prescribed by law for filing the consolidated return";
}
pub relation tax_governed_by_1502_regulation_1503a(group: AffiliatedGroup, y: TaxableYear, reg: Section1502Regulation) kind institutional {
    label en official "the tax is determined, computed, assessed, collected and adjusted in accordance with the section 1502 regulation prescribed before the last day for filing the return (section 1503(a))";
}
@source(IRC_S1503_A, quote = "the tax shall be determined, computed, assessed, collected, and adjusted in accordance with the regulations under section 1502 prescribed before the last day prescribed by law for the filing of such return.")
rule Section1503aGoverningRegulationRule(group: AffiliatedGroup, y: TaxableYear, reg: Section1502Regulation, prescribed: Date, due: Date) defeasible {
    label en official "section 1503(a): a regulation in force under section 1502 governs when prescribed strictly before the return's last filing day";
    when consolidated_return_made_or_required_1503(group, y);
    when section_1502_regulation_in_force(reg);
    when regulation_prescribed_on_1502(reg, prescribed);
    when consolidated_return_due_date_1503(group, y, due);
    when prescribed < due;
    then tax_governed_by_1502_regulation_1503a(group, y, reg);
}

// --- Section 1503(c): insurance companies taxed under section 801 -----------------

pub relation nonlife_members_consolidated_nol_1503c1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the consolidated net operating loss of the members of the group not taxed under section 801 for the taxable year";
}
pub relation nol_absorbed_in_carrybacks_1503c1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of that loss absorbed in the applicable carryback periods against the taxable income of the members not taxed under section 801";
}
pub relation life_members_taxable_income_1503c1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of the members taxed under section 801";
}
pub relation unabsorbed_nonlife_loss_1503c1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the loss which cannot be absorbed in the applicable carryback periods";
}
@source(IRC_S1503_C, quote = "the amount of such loss which cannot be absorbed in the applicable carry-back periods against the taxable income of such members not taxed under section 801")
rule Section1503c1UnabsorbedLossRule(group: AffiliatedGroup, y: TaxableYear, loss: Money, absorbed: Money) defeasible {
    label en official "section 1503(c)(1): the unabsorbed part of the nonlife consolidated net operating loss";
    when election_1504c2_in_effect(group, y);
    when nonlife_members_consolidated_nol_1503c1(group, y, loss);
    when nol_absorbed_in_carrybacks_1503c1(group, y, absorbed);
    when loss >= absorbed;
    then unabsorbed_nonlife_loss_1503c1(group, y, loss - absorbed);
}
pub relation nonlife_loss_taken_into_account_1503c1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unabsorbed loss taken into account in determining the group's consolidated taxable income, to the extent of 35 percent of the loss or 35 percent of the taxable income of the members taxed under section 801, whichever is less (section 1503(c)(1))";
}
@source(IRC_S1503_C, quote = "to the extent of 35 percent of such loss or 35 percent of the taxable income of the members taxed under section 801, whichever is less.")
rule Section1503c1LossCapLessRule(group: AffiliatedGroup, y: TaxableYear, unabsorbed: Money, life_income: Money) defeasible {
    label en official "section 1503(c)(1): the 35-percent-of-loss limit is the lesser (cents HALF_UP, JUDGMENT CALL: the statute names no rounding)";
    when unabsorbed_nonlife_loss_1503c1(group, y, unabsorbed);
    when life_members_taxable_income_1503c1(group, y, life_income);
    when round(unabsorbed * 35 percent, 2, "HALF_UP") <= round(life_income * 35 percent, 2, "HALF_UP");
    then nonlife_loss_taken_into_account_1503c1(group, y, round(unabsorbed * 35 percent, 2, "HALF_UP"));
}
@source(IRC_S1503_C, quote = "to the extent of 35 percent of such loss or 35 percent of the taxable income of the members taxed under section 801, whichever is less.")
rule Section1503c1IncomeCapLessRule(group: AffiliatedGroup, y: TaxableYear, unabsorbed: Money, life_income: Money) defeasible {
    label en official "section 1503(c)(1): the 35-percent-of-life-income limit is the lesser";
    when unabsorbed_nonlife_loss_1503c1(group, y, unabsorbed);
    when life_members_taxable_income_1503c1(group, y, life_income);
    when round(unabsorbed * 35 percent, 2, "HALF_UP") > round(life_income * 35 percent, 2, "HALF_UP");
    then nonlife_loss_taken_into_account_1503c1(group, y, round(life_income * 35 percent, 2, "HALF_UP"));
}
pub relation unused_nonlife_loss_carryover_1503c1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unused portion of the loss, available as a carryover in applicable carryover years (section 1503(c)(1), second sentence)";
}
@source(IRC_S1503_C, quote = "The unused portion of such loss shall be available as a carryover")
rule Section1503c1CarryoverRule(group: AffiliatedGroup, y: TaxableYear, unabsorbed: Money, taken: Money) defeasible {
    label en official "section 1503(c)(1): the unabsorbed loss less the amount taken into account carries over";
    when unabsorbed_nonlife_loss_1503c1(group, y, unabsorbed);
    when nonlife_loss_taken_into_account_1503c1(group, y, taken);
    then unused_nonlife_loss_carryover_1503c1(group, y, unabsorbed - taken);
}
pub relation taxable_year_ordinal_in_group_1503c2(group: AffiliatedGroup, y: TaxableYear, ordinal: Integer) kind empirical {
    label en official "the ordinal number of the taxable year among the years such members have been members of the same affiliated group (determined without regard to section 1504(b)(2))";
}
pub relation nonlife_member_nol_year_1503c2(group: AffiliatedGroup, member: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "a member of the group not taxed under section 801 has a net operating loss for the taxable year";
}
pub relation nonlife_member_loss_not_taken_into_account_1503c2(group: AffiliatedGroup, member: Corporation, y: TaxableYear) kind institutional {
    label en official "the net operating loss of a recent nonlife affiliate is not taken into account in determining the taxable income of a life member, for the year or as a carryover or carryback (section 1503(c)(2))";
}
@source(IRC_S1503_C, quote = "shall not be taken into account in determining the taxable income of a member taxed under section 801")
rule Section1503c2RecentAffiliateRule(group: AffiliatedGroup, member: Corporation, y: TaxableYear, ordinal: Integer) defeasible {
    label en official "section 1503(c)(2): a loss of a year that precedes the sixth taxable year of membership is not taken into account";
    when nonlife_member_nol_year_1503c2(group, member, y);
    when taxable_year_ordinal_in_group_1503c2(group, y, ordinal);
    when ordinal < 6;
    then nonlife_member_loss_not_taken_into_account_1503c2(group, member, y);
}

// --- Section 1503(d): dual consolidated loss ----------------------------------------

pub relation domestic_corporation_net_operating_loss_1503d(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net operating loss of a domestic corporation for the taxable year";
}
pub relation subject_to_foreign_income_tax_worldwide_or_residence_1503d2a(corp: Corporation) kind empirical {
    label en official "the corporation is subject to an income tax of a foreign country on its income without regard to whether the income is from sources in or outside that country, or is subject to such a tax on a residence basis (section 1503(d)(2)(A))";
}
pub relation regulations_exclude_loss_not_offsetting_foreign_income_1503d2b(corp: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: to the extent provided in regulations the loss is excluded because under the foreign income tax law it does not offset the income of any foreign corporation (section 1503(d)(2)(B))";
}
pub relation dual_consolidated_loss_1503d2(corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the dual consolidated loss: a net operating loss of a domestic corporation subject to foreign income tax on a worldwide or residence basis, save as regulations exclude (section 1503(d)(2))";
}
@source(IRC_S1503_D, quote = "the term \"dual consolidated loss\" means any net operating loss of a domestic corporation which is subject to an income tax of a foreign country on its income without regard to whether such income is from sources in or outside of such foreign country, or is subject to such a tax on a residence basis.")
rule Section1503d2DualConsolidatedLossRule(corp: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1503(d)(2)(A)-(B): the dual consolidated loss definition, less the regulatory exclusion";
    when domestic_corporation_net_operating_loss_1503d(corp, y, amount);
    when subject_to_foreign_income_tax_worldwide_or_residence_1503d2a(corp);
    when not_known(regulations_exclude_loss_not_offsetting_foreign_income_1503d2b(corp, y));
    then dual_consolidated_loss_1503d2(corp, y, amount);
}
pub relation dual_loss_offset_disallowed_1503d1(loss_corp: Corporation, other: Corporation) kind institutional {
    label en official "the dual consolidated loss of one corporation is not allowed to reduce the taxable income of any other member of the affiliated group for the taxable year or any other taxable year (section 1503(d)(1))";
}
pub relation claims_offset_by_dual_consolidated_loss_1503d1(parent: Corporation, loss_corp: Corporation, other: Corporation) kind empirical {
    label en unofficial "the group's return applies the dual consolidated loss of loss_corp to reduce the taxable income of another member";
}
@source(IRC_S1503_D, quote = "The dual consolidated loss for any taxable year of any corporation shall not be allowed to reduce the taxable income of any other member of the affiliated group for the taxable year or any other taxable year.")
rule Section1503d1OffsetBarRule(group: AffiliatedGroup, parent: Corporation, loss_corp: Corporation, other: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1503(d)(1): a dual consolidated loss may not be used against another member's income; applying it is a breach by the filing parent";
    when common_parent_of(group, parent);
    when member_of_affiliated_group(group, loss_corp);
    when member_of_affiliated_group(group, other);
    when dual_consolidated_loss_1503d2(loss_corp, y, amount);
    then prohibition Section1503d1DualLossOffsetBar {
        bearer parent;
        action claims_offset_by_dual_consolidated_loss_1503d1(parent, loss_corp, other);
        window [-infinity, infinity];
    };
}
@source(IRC_S1503_D, quote = "shall not be allowed to reduce the taxable income of any other member of the affiliated group")
rule Section1503d1DisallowanceRule(group: AffiliatedGroup, loss_corp: Corporation, other: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1503(d)(1): the offset of the dual consolidated loss against another member is disallowed";
    when member_of_affiliated_group(group, loss_corp);
    when member_of_affiliated_group(group, other);
    when dual_consolidated_loss_1503d2(loss_corp, y, amount);
    then dual_loss_offset_disallowed_1503d1(loss_corp, other);
}
pub entity SeparateUnit1503 { label en unofficial "a separate unit of a domestic corporation (section 1503(d)(3))"; }
pub relation separate_unit_of_domestic_corporation_1503d3(unit: SeparateUnit1503, corp: Corporation) kind empirical {
    label en unofficial "the unit is a separate unit of the domestic corporation";
}
pub relation regulations_extend_1503d_to_separate_unit(unit: SeparateUnit1503) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: to the extent provided in regulations the unit's loss is subject to the limitations of subsection (d)";
}
pub relation separate_unit_treated_as_wholly_owned_subsidiary_1503d3(unit: SeparateUnit1503, corp: Corporation) kind institutional {
    label en official "a separate unit's loss is subject to the subsection (d) limitations as if the unit were a wholly owned subsidiary of the corporation (section 1503(d)(3))";
}
@source(IRC_S1503_D, quote = "any loss of a separate unit of a domestic corporation shall be subject to the limitations of this subsection in the same manner as if such unit were a wholly owned subsidiary of such corporation.")
rule Section1503d3SeparateUnitRule(unit: SeparateUnit1503, corp: Corporation) defeasible {
    label en official "section 1503(d)(3): separate-unit losses are treated as those of a wholly owned subsidiary, to the extent provided in regulations";
    when separate_unit_of_domestic_corporation_1503d3(unit, corp);
    when regulations_extend_1503d_to_separate_unit(unit);
    then separate_unit_treated_as_wholly_owned_subsidiary_1503d3(unit, corp);
}
pub relation regulations_prevent_asset_contribution_avoidance_1503d4(corp: Corporation) kind empirical {
    label en official "the Secretary has prescribed regulations necessary or appropriate to prevent avoidance of the purposes of subsection (d) by contributing assets to the corporation with the dual consolidated loss after the loss was sustained";
}
@source(IRC_S1503_D, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to prevent the avoidance of the purposes of this subsection")
rule Section1503d4RegulationsDutyRule(corp: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1503(d)(4): the Secretary shall prescribe anti-avoidance regulations; no day count is stated, so the window is open (a duty without an intrinsic deadline, G4004)";
    when dual_consolidated_loss_1503d2(corp, y, amount);
    then duty Section1503d4PrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prevent_asset_contribution_avoidance_1503d4(corp);
            window [-infinity, infinity];
        }
    };
}

// --- Section 1503(e): basis adjustments for intragroup stock -------------------------

pub relation consolidated_year_1503e2b(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "a consolidated year: a taxable year for which the affiliated group makes a consolidated return (section 1503(e)(2)(B))";
}
@source(IRC_S1503_E, quote = "The term \"consolidated year\" means any taxable year for which the affiliated group makes a consolidated return.")
rule Section1503e2bConsolidatedYearRule(group: AffiliatedGroup, y: TaxableYear) strict {
    label en official "section 1503(e)(2)(B): consolidated year";
    when makes_consolidated_return(group, y);
    then consolidated_year_1503e2b(group, y);
}
pub relation stock_in_member_1503e2a(stock: Asset, issuer: Corporation) kind empirical {
    label en official "the stock is in a corporation which is or was a member of an affiliated group (section 1503(e)(2)(A)(i))";
}
pub relation stock_held_by_member_1503e2a(stock: Asset, holder: Corporation) kind empirical {
    label en official "the stock is held by another corporation which is or was a member of the group (section 1503(e)(2)(A)(ii))";
}
pub relation property_basis_by_reference_to_intragroup_stock_1503e2a(prop: Asset, stock: Asset) kind empirical {
    label en official "the basis of the property is determined in whole or in part by reference to the basis of intragroup stock (section 1503(e)(2)(A), last sentence)";
}
pub relation direct_intragroup_stock_1503e2a(stock: Asset) kind institutional {
    label en official "stock in a corporation which is or was a member of an affiliated group, held by another corporation which is or was a member (section 1503(e)(2)(A), first sentence)";
}
@source(IRC_S1503_E, quote = "The term \"intragroup stock\" means any stock which—")
rule Section1503e2aStockRule(stock: Asset, issuer: Corporation, holder: Corporation) defeasible {
    label en official "section 1503(e)(2)(A)(i)-(ii): stock in a member held by another member";
    when stock_in_member_1503e2a(stock, issuer);
    when stock_held_by_member_1503e2a(stock, holder);
    then direct_intragroup_stock_1503e2a(stock);
}
pub relation intragroup_stock_1503e2a(x: Asset) kind institutional {
    label en official "intragroup stock: the stock above, and any other property whose basis is determined in whole or in part by reference to the basis of such stock (section 1503(e)(2)(A))";
}
@source(IRC_S1503_E, quote = "The term \"intragroup stock\" means any stock which—")
rule Section1503e2aDirectRule(x: Asset) defeasible {
    label en official "section 1503(e)(2)(A): direct intragroup stock is intragroup stock";
    when direct_intragroup_stock_1503e2a(x);
    then intragroup_stock_1503e2a(x);
}
@source(IRC_S1503_E, quote = "Such term includes any other property the basis of which is determined (in whole or in part) by reference to the basis of stock described in the preceding sentence.")
rule Section1503e2aDerivedBasisPropertyRule(prop: Asset, stock: Asset) defeasible {
    label en official "section 1503(e)(2)(A), last sentence: property with a basis derived from intragroup stock is intragroup stock";
    when property_basis_by_reference_to_intragroup_stock_1503e2a(prop, stock);
    when direct_intragroup_stock_1503e2a(stock);
    then intragroup_stock_1503e2a(prop);
}
pub relation earnings_and_profits_without_312k_and_n_1503e1a(member: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "earnings and profits determined as if section 312 were applied for the year (and all preceding consolidated years of the member with respect to the group) without regard to subsections (k) and (n), the reference to (n) not including (n)(7) (section 1503(e)(1)(A), (2)(C))";
}
pub relation section_108_exclusion_not_applied_to_attributes_1503e1b(member: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount excluded from gross income under section 108 to the extent not applied to reduce tax attributes other than basis in property (section 1503(e)(1)(B))";
}
pub relation earnings_and_profits_for_intragroup_stock_basis_1503e1(member: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings and profits used, solely for gain or loss on disposition of intragroup stock and any excess loss account inclusion, to adjust the basis of intragroup stock (section 1503(e)(1))";
}
@source(IRC_S1503_E, quote = "earnings and profits shall not include any amount excluded from gross income under section 108 to the extent the amount so excluded was not applied to reduce tax attributes (other than basis in property).")
rule Section1503e1EarningsAndProfitsRule(group: AffiliatedGroup, member: Corporation, y: TaxableYear, ep: Money, excluded: Money) defeasible {
    label en official "section 1503(e)(1)(A)-(B): E&P without (k) and (n), less the section 108 exclusion not applied to attributes";
    when member_of_affiliated_group(group, member);
    when consolidated_year_1503e2b(group, y);
    when earnings_and_profits_without_312k_and_n_1503e1a(member, y, ep);
    when section_108_exclusion_not_applied_to_attributes_1503e1b(member, y, excluded);
    then earnings_and_profits_for_intragroup_stock_basis_1503e1(member, y, ep - excluded);
}
pub relation regulations_require_1503e3_adjustments(prop: Asset) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: the regulations under section 1503(e)(3) require proper adjustments to paragraph (1) for the property";
}
pub relation property_acquired_before_consolidation_1503e3a(prop: Asset) kind empirical {
    label en official "the property was acquired by the corporation before consolidation (section 1503(e)(3)(A))";
}
pub relation adjusted_basis_for_taxable_income_1503e3a(prop: Asset, amount: Money) kind empirical {
    label en unofficial "adjusted basis of the property for purposes of computing taxable income";
}
pub relation adjusted_basis_for_earnings_and_profits_1503e3a(prop: Asset, amount: Money) kind empirical {
    label en unofficial "adjusted basis of the property for purposes of computing earnings and profits";
}
pub relation basis_difference_adjustment_1503e3a(prop: Asset, amount: Money) kind institutional {
    label en official "proper adjustment for the difference between the adjusted basis of the property for taxable income and its adjusted basis for earnings and profits (section 1503(e)(3)(A))";
}
@source(IRC_S1503_E, quote = "for the difference between the adjusted basis of such property for purposes of computing taxable income and its adjusted basis for purposes of computing earnings and profits, and")
rule Section1503e3aBasisDifferenceRule(prop: Asset, taxable_basis: Money, ep_basis: Money) defeasible {
    label en official "section 1503(e)(3)(A): the adjustment is the taxable-income basis less the earnings-and-profits basis, for property acquired before consolidation";
    when regulations_require_1503e3_adjustments(prop);
    when property_acquired_before_consolidation_1503e3a(prop);
    when adjusted_basis_for_taxable_income_1503e3a(prop, taxable_basis);
    when adjusted_basis_for_earnings_and_profits_1503e3a(prop, ep_basis);
    then basis_difference_adjustment_1503e3a(prop, taxable_basis - ep_basis);
}
pub relation section_50c_basis_adjustment_1503e3b(prop: Asset, amount: Money) kind empirical {
    label en official "a basis adjustment under section 50(c) for the property";
}
pub relation section_50c_adjustment_carried_1503e3b(prop: Asset, amount: Money) kind institutional {
    label en official "proper adjustment for any basis adjustment under section 50(c) (section 1503(e)(3)(B))";
}
@source(IRC_S1503_E, quote = "in the case of any property, for any basis adjustment under section 50(c).")
rule Section1503e3bSection50cRule(prop: Asset, amount: Money) defeasible {
    label en official "section 1503(e)(3)(B): section 50(c) basis adjustments carried into the application of paragraph (1)";
    when regulations_require_1503e3_adjustments(prop);
    when section_50c_basis_adjustment_1503e3b(prop, amount);
    then section_50c_adjustment_carried_1503e3b(prop, amount);
}
pub relation regulation_permits_ela_reduction_for_indebtedness_basis_1503e4(reg: Section1502Regulation) kind empirical {
    label en official "the regulation permits a reduction in the amount otherwise included in gross income by reason of an excess loss account, on account of a reduction in the basis of indebtedness";
}
@source(IRC_S1503_E, quote = "Nothing in the regulations prescribed under section 1502 shall permit any reduction in the amount otherwise included in gross income by reason of an excess loss account if such reduction is on account of a reduction in the basis of indebtedness.")
rule Section1503e4NoIndebtednessBasisReductionRule(reg: Section1502Regulation) defeasible {
    label en official "section 1503(e)(4): a section 1502 regulation must not permit an excess-loss-account inclusion to be reduced on account of a reduction in the basis of indebtedness";
    when section_1502_regulation_in_force(reg);
    then prohibition Section1503e4RegulationMustNotPermitBar {
        bearer us.irc.core::Secretary;
        action regulation_permits_ela_reduction_for_indebtedness_basis_1503e4(reg);
        window [-infinity, infinity];
    };
}

// --- Section 1503(f): preferred dividends of a subsidiary -----------------------------

pub relation subsidiary_of_consolidated_group_1503f3c(group: AffiliatedGroup, sub: Corporation) kind institutional {
    label en official "subsidiary: a member of an affiliated group filing a consolidated return other than the common parent (section 1503(f)(3)(C))";
}
@source(IRC_S1503_F, quote = "The term \"subsidiary\" means any corporation which is a member of an affiliated group filing a consolidated return other than the common parent.")
rule Section1503f3cSubsidiaryRule(group: AffiliatedGroup, sub: Corporation, y: TaxableYear, parent: Corporation) defeasible {
    label en official "section 1503(f)(3)(C): subsidiary";
    when member_of_affiliated_group(group, sub);
    when makes_consolidated_return(group, y);
    when common_parent_of(group, parent);
    when parent_differs_from_1503f(parent, sub);
    then subsidiary_of_consolidated_group_1503f3c(group, sub);
}
pub relation parent_differs_from_1503f(parent: Corporation, sub: Corporation) kind empirical {
    label en unofficial "the member is not the common parent (asserted: the language has no entity-inequality test in a rule body)";
}
pub relation preferred_dividend_item_1503f(sub: Corporation, y: TaxableYear, stock: Asset, issued_on: Date, amount: Money) kind empirical {
    label en unofficial "a dividend distributed by the subsidiary during the year on stock, issued on the given date";
}
pub relation stock_described_in_1504a4_1503f(stock: Asset) kind empirical {
    label en official "the stock is stock described in section 1504(a)(4) (nonvoting, limited and preferred, redemption rights within issue price, not convertible)";
}
pub relation stock_held_outside_group_1503f3d(stock: Asset) kind empirical {
    label en official "the stock is held by a person other than a member of the same affiliated group as the subsidiary (section 1503(f)(3)(D)(ii))";
}
pub relation applicable_preferred_dividends_1503f(sub: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the dividends distributed by the subsidiary during the year on applicable preferred stock: section 1504(a)(4) stock issued after November 17, 1989 and held outside the group (section 1503(f)(3)(D))";
}
@source(IRC_S1503_F, quote = "The term \"applicable preferred stock\" means stock described in section 1504(a)(4) in the subsidiary which is—")
rule Section1503f3dApplicablePreferredDividendsRule(sub: Corporation, y: TaxableYear) defeasible {
    label en official "section 1503(f)(3)(D): total dividends on applicable preferred stock, an exact sum over the case's dividend items filtered by the November 17, 1989 issue date, section 1504(a)(4) description and outside holding";
    when preferred_dividend_item_1503f(sub, y, _, _, _);
    then applicable_preferred_dividends_1503f(sub, y, sum all amt: Money for stock: Asset where preferred_dividend_item_1503f(sub, y, stock, _, amt) and stock_described_in_1504a4_1503f(stock) and stock_held_outside_group_1503f3d(stock) and stock_issued_after_nov_17_1989_1503f3d(stock));
}
pub relation stock_issued_after_nov_17_1989_1503f3d(stock: Asset) kind empirical {
    label en official "the stock was issued after November 17, 1989 (section 1503(f)(3)(D)(i))";
}
pub relation separately_computed_taxable_income_1503f3b(sub: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the separate taxable income of the subsidiary for the year, taking into account capital gains and losses and section 1231 gains and losses, without regard to net operating loss or capital loss carryovers or carrybacks, with the adjustments the Secretary prescribes (section 1503(f)(3)(B))";
}
pub relation disqualified_separately_computed_income_1503f3a(sub: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the separately computed taxable income of the subsidiary which does not exceed the dividends distributed on applicable preferred stock (section 1503(f)(3)(A))";
}
@source(IRC_S1503_F, quote = "the portion of the separately computed taxable income of the subsidiary which does not exceed the dividends distributed by the subsidiary during the taxable year on applicable preferred stock.")
rule Section1503f3aIncomeWithinDividendsRule(sub: Corporation, y: TaxableYear, income: Money, dividends: Money) defeasible {
    label en official "section 1503(f)(3)(A): income at or below the applicable preferred dividends is wholly disqualified";
    when separately_computed_taxable_income_1503f3b(sub, y, income);
    when applicable_preferred_dividends_1503f(sub, y, dividends);
    when income <= dividends;
    then disqualified_separately_computed_income_1503f3a(sub, y, income);
}
@source(IRC_S1503_F, quote = "the portion of the separately computed taxable income of the subsidiary which does not exceed the dividends distributed by the subsidiary during the taxable year on applicable preferred stock.")
rule Section1503f3aIncomeAboveDividendsRule(sub: Corporation, y: TaxableYear, income: Money, dividends: Money) defeasible {
    label en official "section 1503(f)(3)(A): income above the applicable preferred dividends is disqualified only up to the dividends";
    when separately_computed_taxable_income_1503f3b(sub, y, income);
    when applicable_preferred_dividends_1503f(sub, y, dividends);
    when income > dividends;
    then disqualified_separately_computed_income_1503f3a(sub, y, dividends);
}
pub entity GroupItem1503 { label en unofficial "an item of a member of an affiliated group: a loss or a credit (section 1503(f)(2))"; }
pub relation item_of_other_member_1503f2(item: GroupItem1503, sub: Corporation) kind empirical {
    label en official "the item belongs to another member of the affiliated group which includes the subsidiary";
}
pub relation item_is_nol_or_carryover_172_1503f2ai(item: GroupItem1503) kind empirical {
    label en official "the item is a net operating loss or a net operating loss carryover or carryback under section 172 (section 1503(f)(2)(A)(i))";
}
pub relation item_is_capital_loss_or_carryover_1212_1503f2aii(item: GroupItem1503) kind empirical {
    label en official "the item is a loss from the sale or exchange of a capital asset or a capital loss carryover or carryback under section 1212 (section 1503(f)(2)(A)(ii))";
}
pub relation item_is_part_iv_credit_1503f2b(item: GroupItem1503) kind empirical {
    label en official "the item is a credit allowable under part IV of subchapter A (other than section 34), or a carryover or carryback of one (section 1503(f)(2)(B))";
}
pub relation group_loss_item_1503f2a(item: GroupItem1503, sub: Corporation) kind institutional {
    label en official "group loss item (section 1503(f)(2)(A))";
}
@source(IRC_S1503_F, quote = "Any net operating loss and any net operating loss carryover or carryback under section 172.")
rule Section1503f2aiLossItemRule(item: GroupItem1503, sub: Corporation) defeasible {
    label en official "section 1503(f)(2)(A)(i): a section 172 loss of another member is a group loss item";
    when item_of_other_member_1503f2(item, sub);
    when item_is_nol_or_carryover_172_1503f2ai(item);
    then group_loss_item_1503f2a(item, sub);
}
@source(IRC_S1503_F, quote = "Any loss from the sale or exchange of any capital asset and any capital loss carryover or carryback under section 1212.")
rule Section1503f2aiiLossItemRule(item: GroupItem1503, sub: Corporation) defeasible {
    label en official "section 1503(f)(2)(A)(ii): a capital loss of another member is a group loss item";
    when item_of_other_member_1503f2(item, sub);
    when item_is_capital_loss_or_carryover_1212_1503f2aii(item);
    then group_loss_item_1503f2a(item, sub);
}
pub relation group_credit_item_1503f2b(item: GroupItem1503, sub: Corporation) kind institutional {
    label en official "group credit item (section 1503(f)(2)(B))";
}
@source(IRC_S1503_F, quote = "The term \"group credit item\" means any credit allowable under part IV of subchapter A of chapter 1")
rule Section1503f2bCreditItemRule(item: GroupItem1503, sub: Corporation) defeasible {
    label en official "section 1503(f)(2)(B): a part IV credit of another member is a group credit item";
    when item_of_other_member_1503f2(item, sub);
    when item_is_part_iv_credit_1503f2b(item);
    then group_credit_item_1503f2b(item, sub);
}
pub relation subsidiary_distributes_applicable_preferred_dividends_1503f1(sub: Corporation, y: TaxableYear) kind institutional {
    label en official "the subsidiary distributes during the taxable year dividends on applicable preferred stock (section 1503(f)(1))";
}
@source(IRC_S1503_F, quote = "In the case of any subsidiary distributing during any taxable year dividends on any applicable preferred stock—")
rule Section1503f1TriggerRule(sub: Corporation, y: TaxableYear, dividends: Money) defeasible {
    label en official "section 1503(f)(1): the limitation applies to a subsidiary distributing dividends on applicable preferred stock";
    when applicable_preferred_dividends_1503f(sub, y, dividends);
    when dividends > 0.00 USD;
    then subsidiary_distributes_applicable_preferred_dividends_1503f1(sub, y);
}
pub relation loss_item_applied_against_disqualified_income_1503f1a(parent: Corporation, sub: Corporation, y: TaxableYear, item: GroupItem1503) kind empirical {
    label en unofficial "the group's return applies the group loss item to reduce the subsidiary's disqualified separately computed income";
}
@source(IRC_S1503_F, quote = "no group loss item shall be allowed to reduce the disqualified separately computed income of such subsidiary for such taxable year")
rule Section1503f1aLossBarRule(group: AffiliatedGroup, parent: Corporation, sub: Corporation, y: TaxableYear, item: GroupItem1503) defeasible {
    label en official "section 1503(f)(1)(A): a group loss item may not reduce the subsidiary's disqualified separately computed income; applying it is a breach by the filing parent";
    when common_parent_of(group, parent);
    when subsidiary_distributes_applicable_preferred_dividends_1503f1(sub, y);
    when group_loss_item_1503f2a(item, sub);
    then prohibition Section1503f1aGroupLossBar {
        bearer parent;
        action loss_item_applied_against_disqualified_income_1503f1a(parent, sub, y, item);
        window [-infinity, infinity];
    };
}
pub relation credit_item_applied_against_tax_on_disqualified_income_1503f1b(parent: Corporation, sub: Corporation, y: TaxableYear, item: GroupItem1503) kind empirical {
    label en unofficial "the group's return applies the group credit item against the tax on the subsidiary's disqualified separately computed income";
}
@source(IRC_S1503_F, quote = "no group credit item shall be allowed against the tax imposed by this chapter on such disqualified separately computed income.")
rule Section1503f1bCreditBarRule(group: AffiliatedGroup, parent: Corporation, sub: Corporation, y: TaxableYear, item: GroupItem1503) defeasible {
    label en official "section 1503(f)(1)(B): a group credit item may not be allowed against the tax on the disqualified income; applying it is a breach by the filing parent";
    when common_parent_of(group, parent);
    when subsidiary_distributes_applicable_preferred_dividends_1503f1(sub, y);
    when group_credit_item_1503f2b(item, sub);
    then prohibition Section1503f1bGroupCreditBar {
        bearer parent;
        action credit_item_applied_against_tax_on_disqualified_income_1503f1b(parent, sub, y, item);
        window [-infinity, infinity];
    };
}
pub relation regulations_carry_out_1503f_prescribed(sub: Corporation) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary or appropriate to carry out subsection (f) (anti-avoidance for transferred built-in losses, subsidiaries owning group stock, dividends not paid currently or redemption rights above issue price)";
}
@source(IRC_S1503_F, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to carry out the provisions of this subsection")
rule Section1503f4RegulationsDutyRule(sub: Corporation, y: TaxableYear) defeasible {
    label en official "section 1503(f)(4): the Secretary shall prescribe implementing regulations; no day count is stated (G4004)";
    when subsidiary_distributes_applicable_preferred_dividends_1503f1(sub, y);
    then duty Section1503f4PrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_carry_out_1503f_prescribed(sub);
            window [-infinity, infinity];
        }
    };
}

// --- Section 1504(a)(3): five years must elapse before reconsolidation --------------

pub relation corporation_ceased_to_be_member_1504a3(group: AffiliatedGroup, corp: Corporation) kind empirical {
    label en official "the corporation was included (or required to be included) in a consolidated return filed by the affiliated group and ceases to be a member of the group (section 1504(a)(3)(A)(i)-(ii))";
}
pub relation first_month_beginning_after_cessation_year_1504a3(corp: Corporation, on: Date) kind empirical {
    label en unofficial "the first month beginning after the corporation's first taxable year in which it ceased to be a member begins on the given date (first-of-next-month arithmetic has no term: G4005)";
}
pub relation reconsolidation_bar_ends_1504a3(corp: Corporation, on: Date) kind institutional {
    label en official "the 61st month beginning after the first taxable year of cessation begins on this date: before it the corporation may not be included in a consolidated return of the group (section 1504(a)(3)(A))";
}
@source(IRC_S1504_A, quote = "before the 61st month beginning after its first taxable year in which it ceased to be a member of such affiliated group.")
rule Section1504a3BarEndsRule(corp: Corporation, first_month: Date) defeasible {
    label en official "section 1504(a)(3)(A): the 61st month beginning after the first taxable year of cessation is 60 calendar months after the first such month";
    when first_month_beginning_after_cessation_year_1504a3(corp, first_month);
    then reconsolidation_bar_ends_1504a3(corp, add_calendar_period(first_month, 60 calendar_month));
}
pub relation successor_of_corporation_1504a3(corp: Corporation, successor: Corporation) kind empirical {
    label en official "the corporation is a successor of the corporation that ceased to be a member (section 1504(a)(3)(A))";
}
pub relation inclusion_period_begins_1504a3(group: AffiliatedGroup, corp: Corporation, on: Date) kind empirical {
    label en unofficial "the group's consolidated return would include the corporation for a period beginning on the given date";
}
pub relation reconsolidation_waived_1504a3b(group: AffiliatedGroup, corp: Corporation, on: Date) kind institutional {
    label en official "the Secretary has waived application of subparagraph (A) to the corporation for the period, subject to prescribed conditions (section 1504(a)(3)(B))";
}
pub relation secretary_waives_reconsolidation_bar_1504a3b(group: AffiliatedGroup, corp: Corporation, on: Date) kind empirical {
    label en unofficial "the Secretary waives the bar for the corporation for the period beginning on the given date";
}
pub relation waiver_conditions_prescribed_by_secretary_met_1504a3b(group: AffiliatedGroup, corp: Corporation, on: Date) kind empirical {
    label en official "the conditions the Secretary prescribes for the waiver are met (the Secretary's own determination, section 1504(a)(3)(B))";
}
@source(IRC_S1504_A, quote = "The Secretary may waive the application of subparagraph (A) to any corporation for any period subject to such conditions as the Secretary may prescribe.")
rule Section1504a3bWaiverPowerRule strict {
    label en official "section 1504(a)(3)(B): the Secretary's power to waive the five-year bar; a waiver outside the prescribed conditions is an invalid exercise and has no effect (E-0239)";
    for group: AffiliatedGroup;
    for corp: Corporation;
    for on: Date;
    when secretary_waives_reconsolidation_bar_1504a3b(group, corp, on);
    then power Section1504a3bWaiver {
        holder us.irc.core::Secretary;
        over corp;
        exercise secretary_waives_reconsolidation_bar_1504a3b(group, corp, on);
        valid_when waiver_conditions_prescribed_by_secretary_met_1504a3b(group, corp, on);
        effect create(reconsolidation_waived_1504a3b(group, corp, on));
        window [-infinity, infinity];
    };
}
pub relation reconsolidation_barred_1504a3(group: AffiliatedGroup, corp: Corporation, on: Date) kind institutional {
    label en official "the corporation may not be included in the group's consolidated return for a period beginning on the given date (section 1504(a)(3)(A))";
}
@source(IRC_S1504_A, quote = "may not be included in any consolidated return filed by the affiliated group (or by another affiliated group with the same common parent or a successor of such common parent)")
rule Section1504a3BarRule(group: AffiliatedGroup, corp: Corporation, on: Date, bar_end: Date) defeasible {
    label en official "section 1504(a)(3)(A): a former member may not be reconsolidated for a period beginning before the bar ends, unless the Secretary waives it";
    when corporation_ceased_to_be_member_1504a3(group, corp);
    when reconsolidation_bar_ends_1504a3(corp, bar_end);
    when inclusion_period_begins_1504a3(group, corp, on);
    when on < bar_end;
    when not_known(reconsolidation_waived_1504a3b(group, corp, on));
    then reconsolidation_barred_1504a3(group, corp, on);
}
@source(IRC_S1504_A, quote = "(and any successor of such corporation)")
rule Section1504a3SuccessorBarRule(group: AffiliatedGroup, corp: Corporation, successor: Corporation, on: Date, bar_end: Date) defeasible {
    label en official "section 1504(a)(3)(A): the bar applies equally to a successor of the former member";
    when corporation_ceased_to_be_member_1504a3(group, corp);
    when successor_of_corporation_1504a3(corp, successor);
    when reconsolidation_bar_ends_1504a3(corp, bar_end);
    when inclusion_period_begins_1504a3(group, successor, on);
    when on < bar_end;
    when not_known(reconsolidation_waived_1504a3b(group, successor, on));
    then reconsolidation_barred_1504a3(group, successor, on);
}
pub relation includes_barred_corporation_in_consolidated_return_1504a3(parent: Corporation, corp: Corporation, on: Date) kind empirical {
    label en unofficial "the common parent files a consolidated return that includes the corporation for a period beginning on the given date";
}
@source(IRC_S1504_A, quote = "may not be included in any consolidated return filed by the affiliated group")
rule Section1504a3InclusionProhibitionRule(group: AffiliatedGroup, parent: Corporation, corp: Corporation, on: Date) defeasible {
    label en official "section 1504(a)(3)(A): inclusion of a barred corporation in the consolidated return is prohibited";
    when common_parent_of(group, parent);
    when reconsolidation_barred_1504a3(group, corp, on);
    then prohibition Section1504a3ReconsolidationBar {
        bearer parent;
        action includes_barred_corporation_in_consolidated_return_1504a3(parent, corp, on);
        window [-infinity, infinity];
    };
}

// --- Section 1504(a)(4): stock does not include certain preferred stock -------------

pub relation stock_not_entitled_to_vote_1504a4a(stock: Asset) kind empirical {
    label en official "the stock is not entitled to vote (section 1504(a)(4)(A))";
}
pub relation stock_limited_preferred_nonparticipating_1504a4b(stock: Asset) kind empirical {
    label en official "the stock is limited and preferred as to dividends and does not participate in corporate growth to any significant extent (section 1504(a)(4)(B))";
}
pub relation redemption_rights_within_issue_price_1504a4c(stock: Asset) kind empirical {
    label en official "the stock has redemption and liquidation rights which do not exceed its issue price, except for a reasonable redemption or liquidation premium (section 1504(a)(4)(C))";
}
pub relation stock_not_convertible_1504a4d(stock: Asset) kind empirical {
    label en official "the stock is not convertible into another class of stock (section 1504(a)(4)(D))";
}
pub relation stock_excluded_from_1504a_definition(stock: Asset) kind institutional {
    label en official "for purposes of subsection (a) the term stock does not include this stock (section 1504(a)(4))";
}
@source(IRC_S1504_A, quote = "For purposes of this subsection, the term \"stock\" does not include any stock which—")
rule Section1504a4ExcludedStockRule(stock: Asset) defeasible {
    label en official "section 1504(a)(4): the four conditions (A)-(D) are cumulative";
    when stock_not_entitled_to_vote_1504a4a(stock);
    when stock_limited_preferred_nonparticipating_1504a4b(stock);
    when redemption_rights_within_issue_price_1504a4c(stock);
    when stock_not_convertible_1504a4d(stock);
    then stock_excluded_from_1504a_definition(stock);
}

// --- Section 1504(a)(5): regulations ---------------------------------------------------

pub relation regulations_prescribed_1504a5(group: AffiliatedGroup) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary or appropriate to carry out the purposes of subsection (a)";
}
@source(IRC_S1504_A, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to carry out the purposes of this subsection")
rule Section1504a5RegulationsDutyRule(group: AffiliatedGroup, parent: Corporation) defeasible {
    label en official "section 1504(a)(5): the Secretary shall prescribe regulations to carry out subsection (a); no day count is stated (G4004)";
    when common_parent_of(group, parent);
    then duty Section1504a5PrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_1504a5(group);
            window [-infinity, infinity];
        }
    };
}
pub relation regulation_treats_interest_as_stock_1504a5a(interest: Asset) kind empirical {
    label en official "regulations treat the warrant, convertible obligation or similar interest as stock (section 1504(a)(5)(A))";
}
pub relation regulation_treats_stock_as_not_stock_1504a5a(stock: Asset) kind empirical {
    label en official "regulations treat the stock as not stock (section 1504(a)(5)(A))";
}
pub relation regulation_treats_option_as_exercised_1504a5b(option: Asset) kind empirical {
    label en official "regulations treat the option to acquire or sell stock as exercised (section 1504(a)(5)(B))";
}
pub relation treated_as_stock_1504a5(x: Asset) kind institutional {
    label en official "the interest is treated as stock for the section 1504(a) tests under the regulations (section 1504(a)(5)(A))";
}
@source(IRC_S1504_A, quote = "which treat warrants, obligations convertible into stock, and other similar interests as stock, and stock as not stock,")
rule Section1504a5aTreatedAsStockRule(x: Asset) defeasible {
    label en official "section 1504(a)(5)(A): an interest the regulations treat as stock";
    when regulation_treats_interest_as_stock_1504a5a(x);
    then treated_as_stock_1504a5(x);
}
pub relation treated_as_not_stock_1504a5(x: Asset) kind institutional {
    label en official "the stock is treated as not stock for the section 1504(a) tests under the regulations (section 1504(a)(5)(A))";
}
@source(IRC_S1504_A, quote = "which treat warrants, obligations convertible into stock, and other similar interests as stock, and stock as not stock,")
rule Section1504a5aTreatedAsNotStockRule(x: Asset) defeasible {
    label en official "section 1504(a)(5)(A): stock the regulations treat as not stock";
    when regulation_treats_stock_as_not_stock_1504a5a(x);
    then treated_as_not_stock_1504a5(x);
}
pub relation option_treated_as_exercised_1504a5(option: Asset) kind institutional {
    label en official "the option is treated as exercised for the section 1504(a) tests under the regulations (section 1504(a)(5)(B))";
}
@source(IRC_S1504_A, quote = "which treat options to acquire or sell stock as having been exercised,")
rule Section1504a5bOptionRule(option: Asset) defeasible {
    label en official "section 1504(a)(5)(B): an option the regulations treat as exercised";
    when regulation_treats_option_as_exercised_1504a5b(option);
    then option_treated_as_exercised_1504a5(option);
}
pub relation regulation_good_faith_value_rule_1504a5c(group: AffiliatedGroup) kind empirical {
    label en official "regulations provide that the value requirement of (2)(B) is treated as met where the group relied on a good faith determination of value (section 1504(a)(5)(C))";
}
pub relation group_treated_value_requirement_as_met_in_good_faith_1504a5c(group: AffiliatedGroup) kind empirical {
    label en official "the affiliated group, in reliance on a good faith determination of value, treated the value requirement as met";
}
pub relation value_requirement_treated_as_met_1504a5c(group: AffiliatedGroup) kind institutional {
    label en official "the requirement of paragraph (2)(B) is treated as met (section 1504(a)(5)(C))";
}
@source(IRC_S1504_A, quote = "which provide that the requirements of paragraph (2)(B) shall be treated as met if the affiliated group, in reliance on a good faith determination of value, treated such requirements as met,")
rule Section1504a5cGoodFaithRule(group: AffiliatedGroup) defeasible {
    label en official "section 1504(a)(5)(C): good-faith valuation reliance under the regulation";
    when regulation_good_faith_value_rule_1504a5c(group);
    when group_treated_value_requirement_as_met_in_good_faith_1504a5c(group);
    then value_requirement_treated_as_met_1504a5c(group);
}
pub relation regulation_disregards_inadvertent_value_change_1504a5d(group: AffiliatedGroup) kind empirical {
    label en official "regulations disregard an inadvertent ceasing to meet (2)(B) by reason of changes in relative values of classes of stock (section 1504(a)(5)(D))";
}
pub relation cessation_by_inadvertent_relative_value_change_1504a5d(group: AffiliatedGroup, corp: Corporation) kind empirical {
    label en official "the corporation ceased to meet (2)(B) inadvertently by reason of changes in the relative values of different classes of stock";
}
pub relation cessation_disregarded_1504a5d(group: AffiliatedGroup, corp: Corporation) kind institutional {
    label en official "the cessation is disregarded (section 1504(a)(5)(D))";
}
@source(IRC_S1504_A, quote = "which disregard an inadvertent ceasing to meet the requirements of paragraph (2)(B) by reason of changes in relative values of different classes of stock,")
rule Section1504a5dInadvertentRule(group: AffiliatedGroup, corp: Corporation) defeasible {
    label en official "section 1504(a)(5)(D): an inadvertent value-driven cessation is disregarded under the regulation";
    when regulation_disregards_inadvertent_value_change_1504a5d(group);
    when cessation_by_inadvertent_relative_value_change_1504a5d(group, corp);
    then cessation_disregarded_1504a5d(group, corp);
}
pub relation regulation_disregards_intragroup_transfers_1504a5e(group: AffiliatedGroup) kind empirical {
    label en official "regulations provide that transfers of stock within the group are not taken into account in determining whether a corporation ceases to be a member (section 1504(a)(5)(E))";
}
pub relation stock_transfer_within_group_1504a5e(group: AffiliatedGroup, corp: Corporation) kind empirical {
    label en unofficial "the corporation's stock is transferred within the group";
}
pub relation intragroup_transfer_disregarded_for_cessation_1504a5e(group: AffiliatedGroup, corp: Corporation) kind institutional {
    label en official "the intragroup transfer is not taken into account for the cessation of membership (section 1504(a)(5)(E))";
}
@source(IRC_S1504_A, quote = "which provide that transfers of stock within the group shall not be taken into account in determining whether a corporation ceases to be a member of an affiliated group, and")
rule Section1504a5eTransfersRule(group: AffiliatedGroup, corp: Corporation) defeasible {
    label en official "section 1504(a)(5)(E): intragroup stock transfers are disregarded under the regulation";
    when regulation_disregards_intragroup_transfers_1504a5e(group);
    when stock_transfer_within_group_1504a5e(group, corp);
    then intragroup_transfer_disregarded_for_cessation_1504a5e(group, corp);
}
pub relation regulation_disregards_disproportionate_voting_change_1504a5f(group: AffiliatedGroup) kind empirical {
    label en official "regulations disregard changes in voting power to the extent disproportionate to related changes in value (section 1504(a)(5)(F))";
}
pub relation voting_power_change_disproportionate_to_value_1504a5f(group: AffiliatedGroup, corp: Corporation) kind empirical {
    label en unofficial "the change in the corporation's voting power is disproportionate to related changes in value";
}
pub relation voting_change_disregarded_1504a5f(group: AffiliatedGroup, corp: Corporation) kind institutional {
    label en official "the change in voting power is disregarded to that extent (section 1504(a)(5)(F))";
}
@source(IRC_S1504_A, quote = "which disregard changes in voting power to the extent such changes are disproportionate to related changes in value.")
rule Section1504a5fVotingChangeRule(group: AffiliatedGroup, corp: Corporation) defeasible {
    label en official "section 1504(a)(5)(F): disproportionate voting-power changes are disregarded under the regulation";
    when regulation_disregards_disproportionate_voting_change_1504a5f(group);
    when voting_power_change_disproportionate_to_value_1504a5f(group, corp);
    then voting_change_disregarded_1504a5f(group, corp);
}

// --- Section 1504(b)-(f): includible corporations ------------------------------------------

pub relation corporation_tested_for_1504b(corp: Corporation) kind empirical {
    label en unofficial "the corporation is tested for includible status under section 1504(b)";
}
pub relation exempt_under_501_1504b1(corp: Corporation) kind empirical {
    label en official "the corporation is exempt from taxation under section 501 (section 1504(b)(1))";
}
pub relation insurance_company_taxed_under_801_1504b2(corp: Corporation) kind empirical {
    label en official "the corporation is an insurance company subject to taxation under section 801 (section 1504(b)(2))";
}
pub relation foreign_corporation_1504b3(corp: Corporation) kind empirical {
    label en official "the corporation is a foreign corporation (section 1504(b)(3))";
}
pub relation regulated_investment_company_or_reit_1504b4(corp: Corporation) kind empirical {
    label en official "the corporation is a regulated investment company or a real estate investment trust subject to tax under subchapter M (section 1504(b)(4))";
}
pub relation disc_1504b5(corp: Corporation) kind empirical {
    label en official "the corporation is a DISC as defined in section 992(a)(1) (section 1504(b)(5))";
}
pub relation s_corporation_1504b6(corp: Corporation) kind empirical {
    label en official "the corporation is an S corporation (section 1504(b)(6))";
}
pub relation domestic_insurance_company_treated_as_includible_1504c1(corp: Corporation) kind institutional {
    label en official "a domestic insurance company treated as includible for applying subsection (a) to such insurance companies alone (section 1504(c)(1))";
}
pub relation treated_as_domestic_corporation_1504d(foreign: Corporation) kind institutional {
    label en official "the foreign corporation is treated for the purposes of the subtitle as a domestic corporation, at the option of the domestic corporation (section 1504(d))";
}
pub relation exempt_group_includible_1504e(corp: Corporation) kind institutional {
    label en official "the tax-exempt organization is considered an includible corporation for applying subsection (a) to such organizations alone (section 1504(e))";
}
pub relation insurer_treated_includible_under_election_1504c2(group: AffiliatedGroup, corp: Corporation, y: TaxableYear) kind institutional {
    label en official "the domestic insurance company is treated as an includible corporation under a section 1504(c)(2) election (section 1504(c)(2)(A))";
}
pub relation includible_corporation_1504b(corp: Corporation) kind institutional {
    label en official "includible corporation: any corporation except the six categories of subsection (b)(1)-(6), save as (c), (d) and (e) provide (section 1504(b))";
}
pub relation exclusion_applies_1504b(corp: Corporation) kind institutional {
    label en unofficial "helper: an exclusion of section 1504(b)(1)-(6) applies and no override of (c)-(e) applies";
}
@source(IRC_S1504_B, quote = "the term \"includible corporation\" means any corporation except—")
rule Section1504bIncludibleRule(corp: Corporation) defeasible {
    label en official "section 1504(b): a corporation is includible unless an exclusion applies; an exception in (c)-(e) restores includible status";
    when corporation_tested_for_1504b(corp);
    when not_known(exclusion_applies_1504b(corp));
    then includible_corporation_1504b(corp);
}
@source(IRC_S1504_B, quote = "(1) Corporations exempt from taxation under section 501.")
rule Section1504b1ExclusionRule(corp: Corporation) defeasible {
    label en official "section 1504(b)(1): exempt corporations are excluded, unless (e) applies";
    when exempt_under_501_1504b1(corp);
    when not_known(exempt_group_includible_1504e(corp));
    then exclusion_applies_1504b(corp);
}
@source(IRC_S1504_B, quote = "(2) Insurance companies subject to taxation under section 801.")
rule Section1504b2ExclusionRule(corp: Corporation) defeasible {
    label en official "section 1504(b)(2): section 801 insurance companies are excluded, unless (c) applies";
    when insurance_company_taxed_under_801_1504b2(corp);
    when not_known(domestic_insurance_company_treated_as_includible_1504c1(corp));
    then exclusion_applies_1504b(corp);
}
@source(IRC_S1504_B, quote = "(3) Foreign corporations.")
rule Section1504b3ExclusionRule(corp: Corporation) defeasible {
    label en official "section 1504(b)(3): foreign corporations are excluded, unless (d) treats the corporation as domestic";
    when foreign_corporation_1504b3(corp);
    when not_known(treated_as_domestic_corporation_1504d(corp));
    then exclusion_applies_1504b(corp);
}
@source(IRC_S1504_B, quote = "(4) Regulated investment companies and real estate investment trusts subject to tax under subchapter M of chapter 1.")
rule Section1504b4ExclusionRule(corp: Corporation) defeasible {
    label en official "section 1504(b)(4): RICs and REITs are excluded";
    when regulated_investment_company_or_reit_1504b4(corp);
    then exclusion_applies_1504b(corp);
}
@source(IRC_S1504_B, quote = "(5) A DISC (as defined in section 992(a)(1)).")
rule Section1504b5ExclusionRule(corp: Corporation) defeasible {
    label en official "section 1504(b)(5): a DISC is excluded";
    when disc_1504b5(corp);
    then exclusion_applies_1504b(corp);
}
@source(IRC_S1504_B, quote = "(6) An S corporation.")
rule Section1504b6ExclusionRule(corp: Corporation) defeasible {
    label en official "section 1504(b)(6): an S corporation is excluded";
    when s_corporation_1504b6(corp);
    then exclusion_applies_1504b(corp);
}
@source(IRC_S1504_A, quote = "1 or more chains of includible corporations connected through stock ownership with a common parent corporation which is an includible corporation")
rule Section1504aAffiliatedGroupViaDerivedIncludibleRule(group: AffiliatedGroup, parent: Corporation, member: Corporation, on: Date) defeasible {
    label en official "section 1504(a)(1) with the derived (b) status: affiliated group when the parent and the member are includible corporations by section 1504(b) and the 80-percent voting and value test is met";
    when common_parent_of(group, parent);
    when includible_corporation_1504b(parent);
    when member_of_affiliated_group(group, member);
    when includible_corporation_1504b(member);
    when meets_1504a2_ownership(parent, member, on);
    then affiliated_group(group);
}

// --- Section 1504(c): includible insurance companies ---------------------------------

pub relation domestic_insurance_company_801_1504c(corp: Corporation) kind empirical {
    label en official "the corporation is a domestic insurance company subject to tax under section 801";
}
pub relation member_of_insurance_only_set_1504c1(corp: Corporation, partner: Corporation) kind empirical {
    label en unofficial "the corporation and the partner are two domestic section 801 insurance companies considered together for subsection (a)";
}
@source(IRC_S1504_C, quote = "Two or more domestic insurance companies each of which is subject to tax under section 801 shall be treated as includible corporations for purposes of applying subsection (a) to such insurance companies alone.")
rule Section1504c1InsuranceOnlyRule(corp: Corporation, partner: Corporation) defeasible {
    label en official "section 1504(c)(1): two or more domestic section 801 insurance companies are includible for applying (a) to them alone";
    when domestic_insurance_company_801_1504c(corp);
    when domestic_insurance_company_801_1504c(partner);
    when member_of_insurance_only_set_1504c1(corp, partner);
    then domestic_insurance_company_treated_as_includible_1504c1(corp);
}
pub relation election_1504c2_in_effect(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "the section 1504(c)(2) election to treat the group's domestic section 801 insurance companies as includible corporations is in effect for the taxable year";
}
pub relation group_includes_domestic_801_insurer_1504c2(group: AffiliatedGroup) kind empirical {
    label en official "the affiliated group, determined without regard to (b)(2), includes one or more domestic insurance companies taxed under section 801 (section 1504(c)(2)(A))";
}
pub relation election_1504c2_made(group: AffiliatedGroup, y: TaxableYear) kind empirical {
    label en unofficial "the common parent elects, pursuant to regulations, under section 1504(c)(2) for the taxable year";
}
pub relation election_1504c2_available(group: AffiliatedGroup) kind institutional {
    label en unofficial "helper: the group includes a domestic section 801 insurer (the single atom of the power's valid_when)";
}
@source(IRC_S1504_C, quote = "includes one or more domestic insurance companies taxed under section 801")
rule Section1504c2AvailableRule(group: AffiliatedGroup) defeasible {
    label en unofficial "helper: election availability";
    when group_includes_domestic_801_insurer_1504c2(group);
    then election_1504c2_available(group);
}
@source(IRC_S1504_C, quote = "the common parent of such group may elect (pursuant to regulations prescribed by the Secretary) to treat all such companies as includible corporations for purposes of applying subsection (a)")
rule Section1504c2ElectionPowerRule strict {
    label en official "section 1504(c)(2)(A): the common parent's power to elect to treat the group's section 801 insurers as includible; an election by a group with no such insurer is invalid and has no effect (E-0239)";
    for group: AffiliatedGroup;
    for parent: Corporation;
    for y: TaxableYear;
    when common_parent_of(group, parent);
    when election_1504c2_made(group, y);
    then power Section1504c2Election {
        holder parent;
        over group;
        exercise election_1504c2_made(group, y);
        valid_when election_1504c2_available(group);
        effect create(election_1504c2_in_effect(group, y));
        window [-infinity, infinity];
    };
}
pub relation taxable_years_as_member_before_1504c2a(group: AffiliatedGroup, corp: Corporation, y: TaxableYear, years: Integer) kind empirical {
    label en official "the number of taxable years immediately preceding the taxable year for which the return is filed that the company has been a member of the affiliated group (section 1504(c)(2)(A))";
}
@source(IRC_S1504_C, quote = "except that no such company shall be so treated until it has been a member of the affiliated group for the 5 taxable years immediately preceding the taxable year for which the consolidated return is filed.")
rule Section1504c2FiveYearRule(group: AffiliatedGroup, corp: Corporation, y: TaxableYear, years: Integer) defeasible {
    label en official "section 1504(c)(2)(A): an insurer is treated as includible only after five preceding taxable years of membership";
    when election_1504c2_in_effect(group, y);
    when domestic_insurance_company_801_1504c(corp);
    when taxable_years_as_member_before_1504c2a(group, corp, y, years);
    when years >= 5;
    then insurer_treated_includible_under_election_1504c2(group, corp, y);
}
pub relation section_243b3_ineffective_1504c2b(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "section 243(b)(3) and the exception in section 243(b)(2) with respect to subsections (b)(2) and (c) of this section are not effective for the taxable year (section 1504(c)(2)(B)(i))";
}
pub relation section_542b5_ineffective_1504c2b(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "section 542(b)(5) is not effective for the taxable year (section 1504(c)(2)(B)(ii))";
}
pub relation section_1563_a4_b2d_ineffective_1504c2b(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "section 1563(a)(4) and (b)(2)(D), and the reference to section 1563(b)(2)(D) in section 1563(b)(3)(C), are not effective for the taxable year (section 1504(c)(2)(B)(iii))";
}
@source(IRC_S1504_C, quote = "(i) section 243(b)(3) and the exception provided under section 243(b)(2) with respect to subsections (b)(2) and (c) of this section,")
rule Section1504c2B243Rule(group: AffiliatedGroup, y: TaxableYear) defeasible {
    label en official "section 1504(c)(2)(B)(i): with the election in effect section 243(b)(3) is not effective";
    when election_1504c2_in_effect(group, y);
    then section_243b3_ineffective_1504c2b(group, y);
}
@source(IRC_S1504_C, quote = "(ii) section 542(b)(5), and")
rule Section1504c2B542Rule(group: AffiliatedGroup, y: TaxableYear) defeasible {
    label en official "section 1504(c)(2)(B)(ii): with the election in effect section 542(b)(5) is not effective";
    when election_1504c2_in_effect(group, y);
    then section_542b5_ineffective_1504c2b(group, y);
}
@source(IRC_S1504_C, quote = "(iii) subsection (a)(4) and (b)(2)(D) of section 1563, and the reference to section 1563(b)(2)(D) contained in section 1563(b)(3)(C),")
rule Section1504c2B1563Rule(group: AffiliatedGroup, y: TaxableYear) defeasible {
    label en official "section 1504(c)(2)(B)(iii): with the election in effect section 1563(a)(4) and (b)(2)(D) are not effective";
    when election_1504c2_in_effect(group, y);
    then section_1563_a4_b2d_ineffective_1504c2b(group, y);
}

// --- Section 1504(d): subsidiary formed to comply with foreign law -------------------

pub relation capital_stock_share_excluding_directors_shares_1504d(domestic: Corporation, foreign: Corporation, share: Decimal) kind empirical {
    label en official "the domestic corporation owns or controls, directly or indirectly, this share of the capital stock (exclusive of directors' qualifying shares) of the foreign corporation (section 1504(d))";
}
pub relation organized_in_contiguous_foreign_country_1504d(foreign: Corporation) kind empirical {
    label en official "the corporation is organized under the laws of a contiguous foreign country";
}
pub relation maintained_solely_to_comply_with_foreign_property_law_1504d(foreign: Corporation) kind empirical {
    label en official "the corporation is maintained solely for the purpose of complying with the laws of that country as to title and operation of property";
}
pub relation domestic_elects_domestic_treatment_1504d(domestic: Corporation, foreign: Corporation) kind empirical {
    label en unofficial "the domestic corporation exercises its option to treat the foreign corporation as domestic";
}
pub relation contiguous_country_subsidiary_conditions_met_1504d(domestic: Corporation, foreign: Corporation) kind institutional {
    label en unofficial "helper: 100 percent owned, contiguous-country organized and maintained solely for compliance (the single atom of the power's valid_when)";
}
@source(IRC_S1504_D, quote = "owning or controlling, directly or indirectly, 100 percent of the capital stock (exclusive of directors' qualifying shares)")
rule Section1504dConditionsRule(domestic: Corporation, foreign: Corporation, share: Decimal) defeasible {
    label en unofficial "helper: the section 1504(d) conditions";
    when capital_stock_share_excluding_directors_shares_1504d(domestic, foreign, share);
    when share == 1.0;
    when organized_in_contiguous_foreign_country_1504d(foreign);
    when maintained_solely_to_comply_with_foreign_property_law_1504d(foreign);
    then contiguous_country_subsidiary_conditions_met_1504d(domestic, foreign);
}
@source(IRC_S1504_D, quote = "such foreign corporation may, at the option of the domestic corporation, be treated for the purpose of this subtitle as a domestic corporation.")
rule Section1504dOptionPowerRule strict {
    label en official "section 1504(d): the domestic corporation's option to have the foreign subsidiary treated as domestic; an option outside the conditions is invalid and has no effect (E-0239)";
    for domestic: Corporation;
    for foreign: Corporation;
    when domestic_elects_domestic_treatment_1504d(domestic, foreign);
    then power Section1504dDomesticTreatmentOption {
        holder domestic;
        over foreign;
        exercise domestic_elects_domestic_treatment_1504d(domestic, foreign);
        valid_when contiguous_country_subsidiary_conditions_met_1504d(domestic, foreign);
        effect create(treated_as_domestic_corporation_1504d(foreign));
        window [-infinity, infinity];
    };
}

// --- Section 1504(e): includible tax-exempt organizations ----------------------------

pub relation exempt_organization_described_in_501c2_1504e(corp: Corporation) kind empirical {
    label en official "the organization is exempt from taxation under section 501 and is described in section 501(c)(2)";
}
pub relation exempt_organization_deriving_income_from_501c2_1504e(corp: Corporation, src: Corporation) kind empirical {
    label en official "the organization is exempt under section 501 and derives income from the section 501(c)(2) organization named";
}
@source(IRC_S1504_E, quote = "shall be considered as includible corporations for the purpose of the application of subsection (a) to such organizations alone.")
rule Section1504eIncomeDerivingRule(corp: Corporation, src: Corporation) defeasible {
    label en official "section 1504(e): an exempt organization deriving income from a section 501(c)(2) organization is includible for applying (a) to those organizations alone";
    when exempt_organization_deriving_income_from_501c2_1504e(corp, src);
    when exempt_organization_described_in_501c2_1504e(src);
    then exempt_group_includible_1504e(corp);
}
@source(IRC_S1504_E, quote = "one or more of which is described in section 501(c)(2)")
rule Section1504eTitleHolderRule(corp: Corporation, other: Corporation) defeasible {
    label en official "section 1504(e): the section 501(c)(2) organization itself is includible where another exempt organization derives income from it";
    when exempt_organization_described_in_501c2_1504e(corp);
    when exempt_organization_deriving_income_from_501c2_1504e(other, corp);
    then exempt_group_includible_1504e(corp);
}

// --- Section 1504(f): former DISCs -------------------------------------------------------

pub relation former_disc_distribution_of_untaxed_accumulated_income_1504f1(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "a distribution or deemed distribution of accumulated DISC income not treated as previously taxed income under section 805(b)(2)(A) of the Tax Reform Act of 1984 (section 1504(f)(1))";
}
pub relation former_disc_amount_received_805b3_1504f2(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount treated as received under section 805(b)(3) of the Tax Reform Act of 1984 (section 1504(f)(2))";
}
pub relation former_disc_not_a_member_for_amount_1504f(corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "for a taxable year beginning after December 31, 1984, the former DISC is not treated as a group member with respect to the amount (section 1504(f))";
}
@source(IRC_S1504_F, quote = "a corporation which had been a DISC and which would otherwise be a member of such group shall not be treated as such a member with respect to—")
rule Section1504f1Rule(corp: Corporation, y: TaxableYear, amount: Money, begins_on: Date) defeasible {
    label en official "section 1504(f)(1): untaxed accumulated DISC income distributions of a former DISC are outside membership, for taxable years beginning after 1984";
    when us.irc.core::begins(y, begins_on);
    when begins_on > @1984-12-31;
    when former_disc_distribution_of_untaxed_accumulated_income_1504f1(corp, y, amount);
    then former_disc_not_a_member_for_amount_1504f(corp, y, amount);
}
@source(IRC_S1504_F, quote = "(2) any amount treated as received under section 805(b)(3) of such Act.")
rule Section1504f2Rule(corp: Corporation, y: TaxableYear, amount: Money, begins_on: Date) defeasible {
    label en official "section 1504(f)(2): amounts treated as received under section 805(b)(3) are outside membership, for taxable years beginning after 1984";
    when us.irc.core::begins(y, begins_on);
    when begins_on > @1984-12-31;
    when former_disc_amount_received_805b3_1504f2(corp, y, amount);
    then former_disc_not_a_member_for_amount_1504f(corp, y, amount);
}
