// Stage 3b (26.09.2026, TECH_GAP reduction). Section 338(e), (f), (h), (i):
// deemed election on asset acquisitions, consistency, and the definitions
// (12-month acquisition period, acquisition date, purchase, consistency
// period, affiliated group, target affiliate, aggregation, (h)(10) election
// with its duties, formula value, estimated tax, combined return, foreign
// tax credit coordination) and the regulations. Status implemented_unverified:
// nothing here was executed.

// --- Section 338(h)(3): purchase ---------------------------------------------------------

use self::{
    AffiliatedGroup,
    Asset,
    Corporation,
    IRC_S338_E,
    IRC_S338_F,
    IRC_S338_H,
    IRC_S338_I,
    Person,
    StockPurchaseElection,
    common_parent_of,
    meets_1504a2_ownership,
    member_of_affiliated_group,
    qualified_stock_purchase,
    section_338h10_election_made,
    target_deemed_sold_all_assets,
    target_member_of_selling_consolidated_group,
    target_recognizes_gain_as_if_asset_sale_338h10,
};

pub entity StockAcquisition338 { label en unofficial "an acquisition of stock of the target corporation by the purchasing corporation, tested as a purchase (section 338(h)(3))"; }
pub relation stock_acquisition_338h3(acq: StockAcquisition338, purchasing: Corporation, target: Corporation, on: Date) kind empirical {
    label en official "the purchasing corporation acquires stock of the target corporation on the given date";
}
pub relation basis_by_reference_to_transferor_basis_338h3ai1(acq: StockAcquisition338) kind empirical {
    label en official "the basis of the stock in the purchaser's hands is determined in whole or in part by reference to its adjusted basis in the hands of the person from whom acquired (section 338(h)(3)(A)(i)(I))";
}
pub relation basis_under_1014a_338h3ai2(acq: StockAcquisition338) kind empirical {
    label en official "the basis is determined under section 1014(a) (property acquired from a decedent) (section 338(h)(3)(A)(i)(II))";
}
pub relation acquired_in_351_354_355_356_exchange_338h3aii(acq: StockAcquisition338) kind empirical {
    label en official "the stock is acquired in an exchange to which section 351, 354, 355 or 356 applies";
}
pub relation acquired_in_regulated_nonrecognition_transaction_338h3aii(acq: StockAcquisition338) kind empirical {
    label en official "the stock is acquired in another transaction described in regulations in which the transferor does not recognize the entire gain or loss realized";
}
pub relation acquired_from_person_attributed_to_acquirer_338h3aiii(acq: StockAcquisition338, from_person: Person) kind empirical {
    label en official "the stock is acquired from a person whose stock would be attributed to the acquirer under section 318(a) (other than paragraph (4))";
}
pub relation deemed_purchase_under_338a2_338h3b(acq: StockAcquisition338) kind empirical {
    label en official "the acquisition is a deemed purchase under subsection (a)(2) (section 338(h)(3)(B))";
}
pub relation related_corporation_fifty_percent_purchased_338h3ci(acq: StockAcquisition338, from_corp: Corporation) kind empirical {
    label en official "the stock is acquired from a related corporation at least 50 percent in value of whose stock was acquired by purchase (section 338(h)(3)(C)(i))";
}
pub relation acquirer_made_qsp_and_election_for_related_338h3cii(acq: StockAcquisition338, from_corp: Corporation) kind empirical {
    label en official "the acquirer made a qualified stock purchase of stock of the related corporation and made an election under this section, or is treated under (e) as having made one (section 338(h)(3)(C)(ii))";
}
pub relation basis_condition_met_338h3ai(acq: StockAcquisition338) kind institutional {
    label en unofficial "helper: condition (i) is met: no carryover or section 1014(a) basis, or the (C)(ii) exception applies";
}
@source(IRC_S338_H, quote = "the basis of the stock in the hands of the purchasing corporation is not determined (I) in whole or in part by reference to the adjusted basis of such stock in the hands of the person from whom acquired, or (II) under section 1014(a) (relating to property acquired from a decedent),")
rule Section338h3aiPlainRule(acq: StockAcquisition338, purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(3)(A)(i): neither a carryover basis nor a section 1014(a) basis";
    when stock_acquisition_338h3(acq, purchasing, target, on);
    when not_known(basis_by_reference_to_transferor_basis_338h3ai1(acq));
    when not_known(basis_under_1014a_338h3ai2(acq));
    then basis_condition_met_338h3ai(acq);
}
@source(IRC_S338_H, quote = "Clause (i) of subparagraph (A) shall not apply to an acquisition of stock described in clause (i) of this subparagraph if the corporation acquiring such stock—")
rule Section338h3cIiRule(acq: StockAcquisition338, from_corp: Corporation) defeasible {
    label en official "section 338(h)(3)(C)(ii): clause (A)(i) does not apply to an acquisition from a related corporation after a qualified stock purchase and election";
    when related_corporation_fifty_percent_purchased_338h3ci(acq, from_corp);
    when acquirer_made_qsp_and_election_for_related_338h3cii(acq, from_corp);
    then basis_condition_met_338h3ai(acq);
}
pub relation attribution_condition_met_338h3aiii(acq: StockAcquisition338) kind institutional {
    label en unofficial "helper: condition (iii) is met: not acquired from an attributed person, or the (C)(i) exception applies";
}
@source(IRC_S338_H, quote = "the stock is not acquired from a person the ownership of whose stock would, under section 318(a) (other than paragraph (4) thereof), be attributed to the person acquiring such stock.")
rule Section338h3aiiiPlainRule(acq: StockAcquisition338, purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(3)(A)(iii): not acquired from an attributed person";
    when stock_acquisition_338h3(acq, purchasing, target, on);
    when not_known(acquired_from_attributed_person_exists_338h3aiii(acq));
    then attribution_condition_met_338h3aiii(acq);
}
pub relation acquired_from_attributed_person_exists_338h3aiii(acq: StockAcquisition338) kind institutional {
    label en unofficial "helper: some attributed seller exists";
}
rule Section338h3aiiiHelperRule(acq: StockAcquisition338, p: Person) defeasible {
    label en unofficial "helper: an attributed seller";
    when acquired_from_person_attributed_to_acquirer_338h3aiii(acq, p);
    then acquired_from_attributed_person_exists_338h3aiii(acq);
}
@source(IRC_S338_H, quote = "Clause (iii) of subparagraph (A) shall not apply to an acquisition of stock from a related corporation if at least 50 percent in value of the stock of such related corporation was acquired by purchase")
rule Section338h3cIRule(acq: StockAcquisition338, from_corp: Corporation) defeasible {
    label en official "section 338(h)(3)(C)(i): a related-corporation acquisition with at least 50 percent purchased satisfies (iii)";
    when related_corporation_fifty_percent_purchased_338h3ci(acq, from_corp);
    then attribution_condition_met_338h3aiii(acq);
}
pub relation purchase_338h3(acq: StockAcquisition338) kind institutional {
    label en official "the acquisition is a purchase (section 338(h)(3))";
}
@source(IRC_S338_H, quote = "The term \"purchase\" means any acquisition of stock, but only if—")
rule Section338h3aRule(acq: StockAcquisition338, purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(3)(A)(i)-(iii): all three conditions";
    when stock_acquisition_338h3(acq, purchasing, target, on);
    when basis_condition_met_338h3ai(acq);
    when not_known(acquired_in_351_354_355_356_exchange_338h3aii(acq));
    when not_known(acquired_in_regulated_nonrecognition_transaction_338h3aii(acq));
    when attribution_condition_met_338h3aiii(acq);
    then purchase_338h3(acq);
}
@source(IRC_S338_H, quote = "The term \"purchase\" includes any deemed purchase under subsection (a)(2).")
rule Section338h3bRule(acq: StockAcquisition338) defeasible {
    label en official "section 338(h)(3)(B): a deemed purchase is a purchase";
    when deemed_purchase_under_338a2_338h3b(acq);
    then purchase_338h3(acq);
}
pub relation related_corporation_338h3ciii(purchasing: Corporation, related: Corporation) kind institutional {
    label en official "related corporation: stock owned by it is treated under section 318(a) (other than paragraph (4)) as owned by the corporation acquiring the stock (section 338(h)(3)(C)(iii))";
}
pub relation stock_of_corporation_attributed_to_acquirer_338h3ciii(purchasing: Corporation, related: Corporation) kind empirical {
    label en official "stock owned by the related corporation is treated as owned by the acquiring corporation under section 318(a) (other than paragraph (4)) (asserted; module 03 is not re-run)";
}
@source(IRC_S338_H, quote = "a corporation is a related corporation if stock owned by such corporation is treated (under section 318(a) other than paragraph (4) thereof) as owned by the corporation acquiring the stock.")
rule Section338h3ciiiRule(purchasing: Corporation, related: Corporation) defeasible {
    label en official "section 338(h)(3)(C)(iii)";
    when stock_of_corporation_attributed_to_acquirer_338h3ciii(purchasing, related);
    then related_corporation_338h3ciii(purchasing, related);
}

// --- Section 338(h)(1), (2), (4): acquisition period, acquisition date, consistency period ----

pub relation first_purchase_date_338h1(purchasing: Corporation, target: Corporation, on: Date) kind empirical {
    label en official "the date of the first acquisition by purchase of stock included in the qualified stock purchase";
}
pub relation first_considered_owning_related_stock_date_338h1(purchasing: Corporation, target: Corporation, on: Date) kind empirical {
    label en official "for stock whose acquisition is a purchase by reason of paragraph (3)(C): the date the acquiring corporation is first considered under section 318(a) (other than paragraph (4)) as owning stock owned by the corporation from which the acquisition was made";
}
pub relation twelve_month_acquisition_period_start_338h1(purchasing: Corporation, target: Corporation, start: Date) kind institutional {
    label en official "the 12-month acquisition period begins on the date of the first purchase (or, in the (3)(C) case, the date the acquirer is first considered as owning the related corporation's stock) (section 338(h)(1))";
}
@source(IRC_S338_H, quote = "The term \"12-month acquisition period\" means the 12-month period beginning with the date of the first acquisition by purchase of stock included in a qualified stock purchase")
rule Section338h1FirstPurchaseRule(purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(1): the first purchase date";
    when first_purchase_date_338h1(purchasing, target, on);
    when not_known(first_considered_owning_related_stock_date_exists_338h1(purchasing, target));
    then twelve_month_acquisition_period_start_338h1(purchasing, target, on);
}
pub relation first_considered_owning_related_stock_date_exists_338h1(purchasing: Corporation, target: Corporation) kind institutional {
    label en unofficial "helper: the (3)(C) alternative date exists";
}
rule Section338h1AlternativeHelperRule(purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en unofficial "helper: alternative date";
    when first_considered_owning_related_stock_date_338h1(purchasing, target, on);
    then first_considered_owning_related_stock_date_exists_338h1(purchasing, target);
}
@source(IRC_S338_H, quote = "the date on which the acquiring corporation is first considered under section 318(a) (other than paragraph (4) thereof) as owning stock owned by the corporation from which such acquisition was made")
rule Section338h1AlternativeRule(purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(1): where stock was acquired as a purchase by reason of (3)(C), the date of first attribution";
    when first_considered_owning_related_stock_date_338h1(purchasing, target, on);
    then twelve_month_acquisition_period_start_338h1(purchasing, target, on);
}
pub relation twelve_month_acquisition_period_end_338h1(purchasing: Corporation, target: Corporation, end: Date) kind institutional {
    label en official "the last day of the 12-month period beginning with the start date (the day before its first anniversary)";
}
@source(IRC_S338_H, quote = "the 12-month period beginning with the date of the first acquisition by purchase")
rule Section338h1EndRule(purchasing: Corporation, target: Corporation, start: Date, calendar_before_1: Date) defeasible {
    label en official "section 338(h)(1): 12 calendar months from the start, ending the day before the anniversary";
    when twelve_month_acquisition_period_start_338h1(purchasing, target, start)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(start, 12 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then twelve_month_acquisition_period_end_338h1(purchasing, target, calendar_before_1);
}
pub relation earlier_qsp_date_exists_338h2(target: Corporation, on: Date) kind institutional {
    label en unofficial "helper: a strictly earlier qualified stock purchase date exists for the target";
}
rule Section338h2EarlierRule(purchasing: Corporation, other_purchasing: Corporation, target: Corporation, on: Date, other: Date) defeasible {
    label en unofficial "helper: an earlier qualified stock purchase";
    when qualified_stock_purchase(purchasing, target, on);
    when qualified_stock_purchase(other_purchasing, target, other);
    when other < on;
    then earlier_qsp_date_exists_338h2(target, on);
}
pub relation acquisition_date_338h2(target: Corporation, on: Date) kind institutional {
    label en official "the acquisition date: the first day on which there is a qualified stock purchase with respect to the stock of the corporation (section 338(h)(2))";
}
@source(IRC_S338_H, quote = "The term \"acquisition date\" means, with respect to any corporation, the first day on which there is a qualified stock purchase with respect to the stock of such corporation.")
rule Section338h2Rule(purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(2): the earliest qualified stock purchase day (\"no strictly earlier candidate\", TECH-GAPS G136)";
    when qualified_stock_purchase(purchasing, target, on);
    when not_known(earlier_qsp_date_exists_338h2(target, on));
    then acquisition_date_338h2(target, on);
}
pub relation consistency_period_begins_338h4ai(purchasing: Corporation, target: Corporation, on: Date) kind institutional {
    label en official "the consistency period begins 1 year before the beginning of the 12-month acquisition period (section 338(h)(4)(A)(i))";
}
@source(IRC_S338_H, quote = "the 1-year period before the beginning of the 12-month acquisition period for the target corporation,")
rule Section338h4aiRule(purchasing: Corporation, target: Corporation, start: Date, calendar_before_1: Date) defeasible {
    label en official "section 338(h)(4)(A)(i)";
    when twelve_month_acquisition_period_start_338h1(purchasing, target, start)
        and us.irc.core::civil_calendar_boundary_before(start, 1, us.irc.core::CalendarYear, calendar_before_1);
    then consistency_period_begins_338h4ai(purchasing, target, calendar_before_1);
}
pub relation consistency_period_ends_338h4aiii(purchasing: Corporation, target: Corporation, on: Date) kind institutional {
    label en official "the consistency period ends 1 year after the acquisition date (the 1-year period beginning on the day after it, section 338(h)(4)(A)(iii))";
}
@source(IRC_S338_H, quote = "the 1-year period beginning on the day after the acquisition date.")
rule Section338h4aiiiRule(purchasing: Corporation, target: Corporation, acquired: Date) defeasible {
    label en official "section 338(h)(4)(A)(iii)";
    when qualified_stock_purchase(purchasing, target, acquired);
    when acquisition_date_338h2(target, acquired);
    then consistency_period_ends_338h4aiii(purchasing, target, add_calendar_period(acquired, 1 calendar_year));
}
pub relation date_in_consistency_period_338h4a(purchasing: Corporation, target: Corporation, d: Date) kind institutional {
    label en official "the date falls within the consistency period of subparagraph (A)";
}
@source(IRC_S338_H, quote = "Except as provided in subparagraph (B), the term \"consistency period\" means the period consisting of—")
rule Section338h4aRule(purchasing: Corporation, target: Corporation, d: Date, begin: Date, finish: Date) defeasible {
    label en official "section 338(h)(4)(A): from the year before the acquisition period through the year after the acquisition date (both ends inclusive)";
    when consistency_period_begins_338h4ai(purchasing, target, begin);
    when consistency_period_ends_338h4aiii(purchasing, target, finish);
    when date_tested_338h4(purchasing, target, d);
    when d >= begin;
    when d <= finish;
    then date_in_consistency_period_338h4a(purchasing, target, d);
}
pub relation date_tested_338h4(purchasing: Corporation, target: Corporation, d: Date) kind empirical {
    label en unofficial "a date whose place in the consistency period is asked (an acquisition date of an asset or of a stock purchase)";
}
pub relation secretary_plan_period_338h4b(target: Corporation, from_date: Date, to_date: Date) kind empirical {
    label en official "a period during which the Secretary determines that a plan was in effect to make a qualified stock purchase plus one or more other qualified stock purchases or asset acquisitions described in (e) with respect to the target or a target affiliate (section 338(h)(4)(B); the Secretary's determination is asserted with origin adjudicated)";
}
pub relation date_in_consistency_period_338h4(purchasing: Corporation, target: Corporation, d: Date) kind institutional {
    label en official "the date falls within the consistency period, including an extension for a plan (section 338(h)(4))";
}
@source(IRC_S338_H, quote = "Except as provided in subparagraph (B), the term \"consistency period\" means the period consisting of—")
rule Section338h4BaseRule(purchasing: Corporation, target: Corporation, d: Date) defeasible {
    label en official "section 338(h)(4)(A)";
    when date_in_consistency_period_338h4a(purchasing, target, d);
    then date_in_consistency_period_338h4(purchasing, target, d);
}
@source(IRC_S338_H, quote = "The period referred to in subparagraph (A) shall also include any period during which the Secretary determines that there was in effect a plan")
rule Section338h4bRule(purchasing: Corporation, target: Corporation, d: Date, from_date: Date, to_date: Date) defeasible {
    label en official "section 338(h)(4)(B): the plan period extends the consistency period";
    when date_tested_338h4(purchasing, target, d);
    when secretary_plan_period_338h4b(target, from_date, to_date);
    when d >= from_date;
    when d <= to_date;
    then date_in_consistency_period_338h4(purchasing, target, d);
}

// --- Section 338(h)(5), (6), (8), (9): affiliated groups ---------------------------------------

pub relation affiliated_group_without_1504b_338h5(group: AffiliatedGroup) kind institutional {
    label en official "affiliated group as in section 1504(a), determined without regard to the exceptions of section 1504(b) (section 338(h)(5)): the 80-percent chain test without the includible-corporation test";
}
@source(IRC_S338_H, quote = "The term \"affiliated group\" has the meaning given to such term by section 1504(a) (determined without regard to the exceptions contained in section 1504(b)).")
rule Section338h5Rule(group: AffiliatedGroup, parent: Corporation, member: Corporation, on: Date) defeasible {
    label en official "section 338(h)(5): the ownership test of section 1504(a) for the group's parent and a member, whether or not either is an includible corporation";
    when common_parent_of(group, parent);
    when member_of_affiliated_group(group, member);
    when meets_1504a2_ownership(parent, member, on);
    then affiliated_group_without_1504b_338h5(group);
}
pub relation member_of_group_during_period_ending_on_acquisition_date_338h6a(corp: Corporation, group: AffiliatedGroup) kind empirical {
    label en official "the corporation was, at any time during so much of the consistency period as ends on the acquisition date, a member of the affiliated group (section 338(h)(6)(A))";
}
pub relation foreign_corporation_or_disc_338h6bi(corp: Corporation) kind empirical {
    label en official "the corporation is a foreign corporation or a DISC";
}
pub relation regulations_provide_otherwise_338h6b(corp: Corporation) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise for the foreign corporation or DISC exclusion";
}
pub relation target_affiliate_338h6(target: Corporation, affiliate: Corporation) kind institutional {
    label en official "target affiliate: a member, with the target, of an affiliated group with the same common parent during the consistency period ending on the acquisition date, other than (unless regulations provide otherwise) a foreign corporation or DISC (section 338(h)(6))";
}
@source(IRC_S338_H, quote = "A corporation shall be treated as a target affiliate of the target corporation if each of such corporations was, at any time during so much of the consistency period as ends on the acquisition date of the target corporation, a member of an affiliated group which had the same common parent.")
rule Section338h6aRule(target: Corporation, affiliate: Corporation, group: AffiliatedGroup) defeasible {
    label en official "section 338(h)(6)(A): both members of the same group, subject to the (B) exclusion (distinctness of the two corporations is a case matter, no inequality atom)";
    when member_of_group_during_period_ending_on_acquisition_date_338h6a(target, group);
    when member_of_group_during_period_ending_on_acquisition_date_338h6a(affiliate, group);
    when not_known(foreign_corporation_or_disc_excluded_338h6bi(affiliate));
    then target_affiliate_338h6(target, affiliate);
}
pub relation foreign_corporation_or_disc_excluded_338h6bi(corp: Corporation) kind institutional {
    label en official "the foreign corporation or DISC is not a target affiliate, save as regulations provide (section 338(h)(6)(B)(i))";
}
@source(IRC_S338_H, quote = "the term \"target affiliate\" does not include a foreign corporation or a DISC, and")
rule Section338h6bIRule(corp: Corporation) defeasible {
    label en official "section 338(h)(6)(B)(i)";
    when foreign_corporation_or_disc_338h6bi(corp);
    when not_known(regulations_provide_otherwise_338h6b(corp));
    then foreign_corporation_or_disc_excluded_338h6bi(corp);
}
pub relation stock_in_foreign_or_disc_corporation_held_by_affiliate_338h6bii(stock: Asset) kind empirical {
    label en official "stock held by a target affiliate in a foreign corporation, or in a domestic corporation which is a DISC or described in section 1248(e)";
}
pub relation stock_excluded_from_operation_of_338_338h6bii(stock: Asset) kind institutional {
    label en official "the stock is excluded from the operation of section 338 (section 338(h)(6)(B)(ii)), save as regulations provide";
}
@source(IRC_S338_H, quote = "stock held by a target affiliate in a foreign corporation or a domestic corporation which is a DISC or described in section 1248(e) shall be excluded from the operation of this section.")
rule Section338h6bIIRule(stock: Asset) defeasible {
    label en official "section 338(h)(6)(B)(ii)";
    when stock_in_foreign_or_disc_corporation_held_by_affiliate_338h6bii(stock);
    then stock_excluded_from_operation_of_338_338h6bii(stock);
}
pub relation members_of_same_affiliated_group_338h8(a: Corporation, b: Corporation) kind empirical {
    label en official "the corporations are members of the same affiliated group";
}
pub relation regulations_provide_otherwise_338h8(a: Corporation, b: Corporation) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise";
}
pub relation acquisitions_treated_as_by_one_corporation_338h8(a: Corporation, b: Corporation) kind institutional {
    label en official "stock and asset acquisitions by members of the same affiliated group are treated as made by 1 corporation (section 338(h)(8))";
}
@source(IRC_S338_H, quote = "stock and asset acquisitions made by members of the same affiliated group shall be treated as made by 1 corporation.")
rule Section338h8Rule(a: Corporation, b: Corporation) defeasible {
    label en official "section 338(h)(8)";
    when members_of_same_affiliated_group_338h8(a, b);
    when not_known(regulations_provide_otherwise_338h8(a, b));
    then acquisitions_treated_as_by_one_corporation_338h8(a, b);
}
pub relation regulations_provide_otherwise_338h9(target: Corporation) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations under paragraph (9) provide otherwise";
}
pub relation h10_election_exists_338h9(target: Corporation) kind institutional {
    label en unofficial "helper: a section 338(h)(10) election exists for the target";
}
rule Section338h9HelperRule(e: StockPurchaseElection, target: Corporation) defeasible {
    label en unofficial "helper: an (h)(10) election";
    when section_338h10_election_made(e, target);
    then h10_election_exists_338h9(target);
}
pub relation target_sold_in_338a1_sale_338h9(target: Corporation) kind empirical {
    label en official "the target corporation is the seller in the deemed sale described in subsection (a)(1)";
}
pub relation target_not_treated_as_member_of_affiliated_group_338h9(target: Corporation) kind institutional {
    label en official "the target corporation is not treated as a member of an affiliated group with respect to the deemed sale, except under paragraph (10) or regulations (section 338(h)(9))";
}
@source(IRC_S338_H, quote = "the target corporation shall not be treated as a member of an affiliated group with respect to the sale described in subsection (a)(1).")
rule Section338h9Rule(target: Corporation) defeasible {
    label en official "section 338(h)(9)";
    when target_sold_in_338a1_sale_338h9(target);
    when not_known(h10_election_exists_338h9(target));
    when not_known(regulations_provide_otherwise_338h9(target));
    then target_not_treated_as_member_of_affiliated_group_338h9(target);
}

// --- Section 338(h)(10): the election ---------------------------------------------------------

pub relation h10_election_filed_338h10(e: StockPurchaseElection, purchasing: Corporation, seller_parent: Corporation, target: Corporation) kind empirical {
    label en official "under the regulations the purchasing corporation and the common parent of the selling consolidated group make the section 338(h)(10) election";
}
pub relation group_includes_target_and_files_consolidated_return_338h10b(e: StockPurchaseElection, target: Corporation) kind empirical {
    label en official "the selling consolidated group includes the target corporation and files a consolidated return for the taxable period that includes the transaction (section 338(h)(10)(B)(i)-(ii))";
}
pub relation affiliated_group_including_target_regulations_338h10b(e: StockPurchaseElection, target: Corporation) kind empirical {
    label en official "to the extent provided in regulations an affiliated group which includes the target (whether or not it files a consolidated return) is a selling consolidated group";
}
pub relation selling_consolidated_group_338h10b(e: StockPurchaseElection, target: Corporation) kind institutional {
    label en official "selling consolidated group (section 338(h)(10)(B))";
}
@source(IRC_S338_H, quote = "For purposes of subparagraph (A), the term \"selling consolidated group\" means any group of corporations which (for the taxable period which includes the transaction)—")
rule Section338h10bConsolidatedRule(e: StockPurchaseElection, target: Corporation) defeasible {
    label en official "section 338(h)(10)(B): a consolidated-return group that includes the target";
    when group_includes_target_and_files_consolidated_return_338h10b(e, target);
    then selling_consolidated_group_338h10b(e, target);
}
@source(IRC_S338_H, quote = "To the extent provided in regulations, such term also includes any affiliated group of corporations which includes the target corporation (whether or not such group files a consolidated return).")
rule Section338h10bAffiliatedRule(e: StockPurchaseElection, target: Corporation) defeasible {
    label en official "section 338(h)(10)(B), last sentence: an affiliated group as regulations provide";
    when affiliated_group_including_target_regulations_338h10b(e, target);
    then selling_consolidated_group_338h10b(e, target);
}
pub relation h10_election_conditions_met_338h10a(e: StockPurchaseElection, target: Corporation) kind institutional {
    label en unofficial "helper: the target was a member of the selling consolidated group and recognizes gain or loss as if it sold all its assets (the single atom of the power's valid_when)";
}
@source(IRC_S338_H, quote = "the target corporation was, before the transaction, a member of the selling consolidated group, and")
rule Section338h10aConditionsRule(e: StockPurchaseElection, target: Corporation) defeasible {
    label en unofficial "helper: conditions (i) and (ii)";
    when target_member_of_selling_consolidated_group(e, target);
    when target_recognizes_gain_as_if_asset_sale_338h10(e, target);
    when selling_consolidated_group_338h10b(e, target);
    then h10_election_conditions_met_338h10a(e, target);
}
pub relation h10_election_effect_338h10a(e: StockPurchaseElection, target: Corporation) kind institutional {
    label en official "the target is treated as a member of the selling consolidated group for the deemed sale and (as regulations provide) no gain or loss is recognized on the stock sold by group members (section 338(h)(10)(A))";
}
@source(IRC_S338_H, quote = "Under regulations prescribed by the Secretary, an election may be made under which if—")
rule Section338h10ElectionPowerRule strict {
    label en official "section 338(h)(10)(A): the joint election of the purchasing corporation and the selling group's parent as a power, valid only when the target was a group member and recognizes gain or loss as on an asset sale; an election outside the conditions is invalid and has no effect (E-0239); the module 13 derived relation section_338h10_election_made is kept";
    for e: StockPurchaseElection;
    for purchasing: Corporation;
    for seller_parent: Corporation;
    for target: Corporation;
    when h10_election_filed_338h10(e, purchasing, seller_parent, target);
    then power Section338h10Election {
        holder purchasing;
        over target;
        exercise h10_election_filed_338h10(e, purchasing, seller_parent, target);
        valid_when h10_election_conditions_met_338h10a(e, target);
        effect create(h10_election_effect_338h10a(e, target));
        window [-infinity, infinity];
    };
}
pub relation h10_information_furnished_338h10c(e: StockPurchaseElection, furnisher: Corporation) kind empirical {
    label en official "the corporation has furnished to the Secretary the amount allocated to goodwill or going concern value, any modification of it, and the other information the Secretary requires (section 338(h)(10)(C)(i)-(iii))";
}
@source(IRC_S338_H, quote = "the purchasing corporation and the common parent of the selling consolidated group shall, at such times and in such manner as may be provided in regulations, furnish to the Secretary the following information:")
rule Section338h10cPurchasingDutyRule(e: StockPurchaseElection, purchasing: Corporation, seller_parent: Corporation, target: Corporation) defeasible {
    label en official "section 338(h)(10)(C): the purchasing corporation's duty to furnish the information; the time and manner are regulations (no day count, G4004)";
    when h10_election_filed_338h10(e, purchasing, seller_parent, target);
    when h10_election_conditions_met_338h10a(e, target);
    then duty Section338h10cPurchasingInformationDuty {
        bearer purchasing;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition h10_information_furnished_338h10c(e, purchasing);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S338_H, quote = "the purchasing corporation and the common parent of the selling consolidated group shall, at such times and in such manner as may be provided in regulations, furnish to the Secretary the following information:")
rule Section338h10cParentDutyRule(e: StockPurchaseElection, purchasing: Corporation, seller_parent: Corporation, target: Corporation) defeasible {
    label en official "section 338(h)(10)(C): the common parent's duty to furnish the information";
    when h10_election_filed_338h10(e, purchasing, seller_parent, target);
    when h10_election_conditions_met_338h10a(e, target);
    then duty Section338h10cParentInformationDuty {
        bearer seller_parent;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition h10_information_furnished_338h10c(e, seller_parent);
            window [-infinity, infinity];
        }
    };
}

// --- Section 338(h)(11), (13), (15), (16) -------------------------------------------------------

pub relation purchasing_uses_regulation_formula_for_fmv_338h11(e: StockPurchaseElection) kind empirical {
    label en unofficial "the fair market value for subsection (a)(1) is determined on the basis of the formula in the regulations";
}
@source(IRC_S338_H, quote = "fair market value may be determined on the basis of a formula provided in regulations prescribed by the Secretary which takes into account liabilities and other relevant items.")
rule Section338h11LibertyRule(e: StockPurchaseElection, purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(11): the purchasing corporation's liberty to use the regulation formula for fair market value";
    when target_deemed_sold_all_assets(e, target, on);
    when qualified_stock_purchase(purchasing, target, on);
    then liberty PurchasingMayUseFormulaFairMarketValue338h11 {
        holder purchasing;
        against us.irc.core::Secretary;
        action purchasing_uses_regulation_formula_for_fmv_338h11(e);
        window [-infinity, infinity];
    };
}
pub relation deemed_sale_tax_excluded_from_estimated_tax_338h13(e: StockPurchaseElection, target: Corporation) kind institutional {
    label en official "for section 6655 the tax attributable to the deemed sale is not taken into account, unless a paragraph (10) election is made (section 338(h)(13))";
}
@source(IRC_S338_H, quote = "For purposes of section 6655, tax attributable to the sale described in subsection (a)(1) shall not be taken into account.")
rule Section338h13Rule(e: StockPurchaseElection, target: Corporation, on: Date) defeasible {
    label en official "section 338(h)(13)";
    when target_deemed_sold_all_assets(e, target, on);
    when not_known(section_338h10_election_made(e, target));
    then deemed_sale_tax_excluded_from_estimated_tax_338h13(e, target);
}
pub relation targets_of_same_selling_consolidated_group_338h15(t1: Corporation, t2: Corporation) kind empirical {
    label en official "the target corporations were members of the same selling consolidated group (as defined in paragraph (10)(B))";
}
pub relation regulations_permit_combined_deemed_sale_return_338h15(purchasing: Corporation) kind empirical {
    label en official "the regulations under paragraph (15) permit a combined deemed sale return (external fact)";
}
pub relation combined_deemed_sale_return_permitted_338h15(purchasing: Corporation, t1: Corporation, t2: Corporation, on: Date) kind institutional {
    label en official "a combined deemed sale return may be filed by target corporations acquired by the purchasing corporation on the same acquisition date and members of the same selling consolidated group (section 338(h)(15))";
}
@source(IRC_S338_H, quote = "a combined deemed sale return may be filed by all target corporations acquired by a purchasing corporation on the same acquisition date if such target corporations were members of the same selling consolidated group")
rule Section338h15Rule(purchasing: Corporation, t1: Corporation, t2: Corporation, on: Date) defeasible {
    label en official "section 338(h)(15)";
    when qualified_stock_purchase(purchasing, t1, on);
    when qualified_stock_purchase(purchasing, t2, on);
    when targets_of_same_selling_consolidated_group_338h15(t1, t2);
    when regulations_permit_combined_deemed_sale_return_338h15(purchasing);
    then combined_deemed_sale_return_permitted_338h15(purchasing, t1, t2, on);
}
pub relation item_for_foreign_tax_credit_source_or_character_338h16(item: Asset) kind empirical {
    label en official "the question is the source or character of an item for the foreign tax credit provisions (subpart A of part III of subchapter N)";
}
pub relation gain_includible_as_dividend_under_1248_338h16(item: Asset) kind empirical {
    label en official "the gain is includible in gross income as a dividend under section 1248 (determined without regard to any deemed sale under section 338 by a foreign corporation)";
}
pub relation regulations_provide_otherwise_338h16(item: Asset) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise";
}
pub relation section_338_disapplied_for_ftc_338h16(item: Asset) kind institutional {
    label en official "section 338 does not apply in determining the source or character of the item for the foreign tax credit, except as regulations provide and except for section 1248 dividend gain (section 338(h)(16))";
}
@source(IRC_S338_H, quote = "this section shall not apply for purposes of determining the source or character of any item for purposes of subpart A of part III of subchapter N of this chapter (relating to foreign tax credit).")
rule Section338h16Rule(item: Asset) defeasible {
    label en official "section 338(h)(16)";
    when item_for_foreign_tax_credit_source_or_character_338h16(item);
    when not_known(gain_includible_as_dividend_under_1248_338h16(item));
    when not_known(regulations_provide_otherwise_338h16(item));
    then section_338_disapplied_for_ftc_338h16(item);
}

// --- Section 338(e): deemed election on asset acquisitions --------------------------------------

pub entity AssetAcquisition338 { label en unofficial "an acquisition by the purchasing corporation of an asset of the target corporation (or a target affiliate), tested under section 338(e)"; }
pub relation asset_acquisition_338e(acq: AssetAcquisition338, purchasing: Corporation, target: Corporation, on: Date) kind empirical {
    label en official "the purchasing corporation acquires an asset of the target corporation or a target affiliate on the given date";
}
pub relation acquisition_by_ordinary_course_sale_338e2a(acq: AssetAcquisition338) kind empirical {
    label en official "the acquisition is pursuant to a sale by the target (or target affiliate) in the ordinary course of its trade or business (section 338(e)(2)(A))";
}
pub relation basis_wholly_by_reference_to_transferor_basis_338e2b(acq: AssetAcquisition338) kind empirical {
    label en official "the basis of the property acquired is determined wholly by reference to the adjusted basis in the hands of the person from whom acquired (section 338(e)(2)(B))";
}
pub relation acquisition_described_in_regulations_338e2d(acq: AssetAcquisition338) kind empirical {
    label en official "the acquisition is described in regulations and meets the conditions they provide (section 338(e)(2)(D))";
}
pub relation acquisition_excepted_338e2(acq: AssetAcquisition338) kind institutional {
    label en official "paragraph (1) does not apply to the acquisition (section 338(e)(2))";
}
@source(IRC_S338_E, quote = "such acquisition is pursuant to a sale by the target corporation (or the target affiliate) in the ordinary course of its trade or business,")
rule Section338e2aRule(acq: AssetAcquisition338) defeasible {
    label en official "section 338(e)(2)(A)";
    when acquisition_by_ordinary_course_sale_338e2a(acq);
    then acquisition_excepted_338e2(acq);
}
@source(IRC_S338_E, quote = "the basis of the property acquired is determined wholly by reference to the adjusted basis of such property in the hands of the person from whom acquired,")
rule Section338e2bRule(acq: AssetAcquisition338) defeasible {
    label en official "section 338(e)(2)(B)";
    when basis_wholly_by_reference_to_transferor_basis_338e2b(acq);
    then acquisition_excepted_338e2(acq);
}
@source(IRC_S338_E, quote = "such acquisition was before September 1, 1982, or")
rule Section338e2cRule(acq: AssetAcquisition338, purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(e)(2)(C): an acquisition before September 1, 1982 (an acquisition on that day is not before it)";
    when asset_acquisition_338e(acq, purchasing, target, on);
    when on < @1982-09-01;
    then acquisition_excepted_338e2(acq);
}
@source(IRC_S338_E, quote = "such acquisition is described in regulations prescribed by the Secretary and meets such conditions as such regulations may provide.")
rule Section338e2dRule(acq: AssetAcquisition338) defeasible {
    label en official "section 338(e)(2)(D)";
    when acquisition_described_in_regulations_338e2d(acq);
    then acquisition_excepted_338e2(acq);
}
pub relation deemed_election_338e1(purchasing: Corporation, target: Corporation) kind institutional {
    label en official "the purchasing corporation is treated as having made an election under this section with respect to the target (section 338(e)(1))";
}
@source(IRC_S338_E, quote = "A purchasing corporation shall be treated as having made an election under this section with respect to any target corporation if, at any time during the consistency period, it acquires any asset of the target corporation (or a target affiliate).")
rule Section338e1Rule(acq: AssetAcquisition338, purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(e)(1): an asset acquisition on a day of the consistency period, unless excepted";
    when asset_acquisition_338e(acq, purchasing, target, on);
    when date_tested_338h4(purchasing, target, on);
    when date_in_consistency_period_338h4(purchasing, target, on);
    when not_known(acquisition_excepted_338e2(acq));
    then deemed_election_338e1(purchasing, target);
}
pub relation stock_acquisition_pursuant_to_plan_meeting_1504a2_338e3(acq: StockAcquisition338) kind empirical {
    label en official "stock acquisitions which are pursuant to a plan and which meet the requirements of section 1504(a)(2) (section 338(e)(3))";
}
pub relation secretary_treats_acquisition_as_qsp_338e3(acq: StockAcquisition338) kind empirical {
    label en unofficial "the Secretary treats the stock acquisition as a qualified stock purchase";
}
pub relation treated_as_qualified_stock_purchase_338e3(acq: StockAcquisition338) kind institutional {
    label en official "the stock acquisition is treated as a qualified stock purchase (section 338(e)(3))";
}
@source(IRC_S338_E, quote = "the Secretary may treat stock acquisitions which are pursuant to a plan and which meet the requirements of section 1504(a)(2) as qualified stock purchases.")
rule Section338e3PowerRule strict {
    label en official "section 338(e)(3): the Secretary's anti-avoidance power, valid only for planned stock acquisitions meeting the 80-percent test; an exercise outside them is invalid and has no effect (E-0239)";
    for acq: StockAcquisition338;
    when secretary_treats_acquisition_as_qsp_338e3(acq);
    then power Section338e3Treatment {
        holder us.irc.core::Secretary;
        over acq;
        exercise secretary_treats_acquisition_as_qsp_338e3(acq);
        valid_when stock_acquisition_pursuant_to_plan_meeting_1504a2_338e3(acq);
        effect create(treated_as_qualified_stock_purchase_338e3(acq));
        window [-infinity, infinity];
    };
}

// --- Section 338(f): consistency ---------------------------------------------------------------------

pub relation qsp_of_target_or_affiliate_in_consistency_period_338f(purchasing: Corporation, corp: Corporation, on: Date) kind empirical {
    label en official "the purchasing corporation makes a qualified stock purchase of the target or of a target affiliate during the consistency period, on the given date";
}
pub relation first_qsp_date_338f(purchasing: Corporation, first_on: Date) kind institutional {
    label en official "the date of the first qualified stock purchase in the consistency period";
}
pub relation earlier_qsp_exists_338f(purchasing: Corporation, on: Date) kind institutional {
    label en unofficial "helper: an earlier qualified stock purchase in the period";
}
rule Section338fEarlierRule(purchasing: Corporation, a: Corporation, b: Corporation, on: Date, other: Date) defeasible {
    label en unofficial "helper: an earlier purchase";
    when qsp_of_target_or_affiliate_in_consistency_period_338f(purchasing, a, on);
    when qsp_of_target_or_affiliate_in_consistency_period_338f(purchasing, b, other);
    when other < on;
    then earlier_qsp_exists_338f(purchasing, on);
}
@source(IRC_S338_F, quote = "any election under this section with respect to the first such purchase shall apply to each other such purchase, and")
rule Section338fFirstRule(purchasing: Corporation, corp: Corporation, on: Date) defeasible {
    label en official "section 338(f): the first purchase date (\"no strictly earlier candidate\")";
    when qsp_of_target_or_affiliate_in_consistency_period_338f(purchasing, corp, on);
    when not_known(earlier_qsp_exists_338f(purchasing, on));
    then first_qsp_date_338f(purchasing, on);
}
pub relation election_made_for_first_purchase_338f(purchasing: Corporation, first_on: Date) kind empirical {
    label en official "an election under this section was made with respect to the first such purchase";
}
pub relation regulations_or_338e_provide_otherwise_338f(purchasing: Corporation) kind empirical {
    label en unofficial "subsection (e) provides otherwise (the parenthetical 'except as otherwise provided in subsection (e)')";
}
pub relation election_applies_to_other_purchase_338f1(purchasing: Corporation, corp: Corporation, on: Date) kind institutional {
    label en official "the election made for the first purchase applies to each other such purchase (section 338(f)(1))";
}
@source(IRC_S338_F, quote = "any election under this section with respect to the first such purchase shall apply to each other such purchase, and")
rule Section338f1Rule(purchasing: Corporation, corp: Corporation, on: Date, first_on: Date) defeasible {
    label en official "section 338(f)(1): a later purchase inherits the election of the first";
    when qsp_of_target_or_affiliate_in_consistency_period_338f(purchasing, corp, on);
    when first_qsp_date_338f(purchasing, first_on);
    when election_made_for_first_purchase_338f(purchasing, first_on);
    when on > first_on;
    when not_known(regulations_or_338e_provide_otherwise_338f(purchasing));
    then election_applies_to_other_purchase_338f1(purchasing, corp, on);
}
pub relation election_barred_for_later_purchase_338f2(purchasing: Corporation, corp: Corporation, on: Date) kind institutional {
    label en official "no election may be made for the second or a later purchase if none was made for the first (section 338(f)(2))";
}
@source(IRC_S338_F, quote = "no election may be made under this section with respect to the second or subsequent such purchase if such an election was not made with respect to the first such purchase.")
rule Section338f2Rule(purchasing: Corporation, corp: Corporation, on: Date, first_on: Date) defeasible {
    label en official "section 338(f)(2)";
    when qsp_of_target_or_affiliate_in_consistency_period_338f(purchasing, corp, on);
    when first_qsp_date_338f(purchasing, first_on);
    when on > first_on;
    when not_known(election_made_for_first_purchase_338f(purchasing, first_on));
    when not_known(regulations_or_338e_provide_otherwise_338f(purchasing));
    then election_barred_for_later_purchase_338f2(purchasing, corp, on);
}
pub relation files_election_for_later_purchase_338f2(purchasing: Corporation, corp: Corporation, on: Date) kind empirical {
    label en unofficial "the purchasing corporation files an election for the later purchase";
}
@source(IRC_S338_F, quote = "no election may be made under this section with respect to the second or subsequent such purchase")
rule Section338f2ProhibitionRule(purchasing: Corporation, corp: Corporation, on: Date) defeasible {
    label en official "section 338(f)(2): filing an election for a barred later purchase is a breach";
    when election_barred_for_later_purchase_338f2(purchasing, corp, on);
    then prohibition Section338f2ElectionBar {
        bearer purchasing;
        action files_election_for_later_purchase_338f2(purchasing, corp, on);
        window [-infinity, infinity];
    };
}

// --- Section 338(i): regulations ---------------------------------------------------------------------

pub relation regulations_prescribed_338i(purchasing: Corporation) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary or appropriate to carry out the purposes of section 338";
}
@source(IRC_S338_I, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to carry out the purposes of this section")
rule Section338iRegulationsDutyRule(purchasing: Corporation, target: Corporation, on: Date) defeasible {
    label en official "section 338(i): the Secretary shall prescribe regulations once a qualified stock purchase exists; no day count is stated (G4004)";
    when qualified_stock_purchase(purchasing, target, on);
    then duty Section338iPrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_338i(purchasing);
            window [-infinity, infinity];
        }
    };
}
