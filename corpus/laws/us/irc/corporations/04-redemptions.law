// Section 302 — distributions in redemption of stock. Stage 1 (IRC-08
// stage 1, A06), priority section. Ownership for this section is
// determined under section 318(a) (section 302(c)(1)), imported from
// module 03 of this same package.
//
// METHOD: section 302(a) gives exchange (capital) treatment if ANY of
// (b)(1)-(5) applies; otherwise section 302(d) defaults to section 301
// treatment. (b)(1) ("not essentially equivalent to a dividend") is
// EVALUATIVE (DECISION-0194): modelled as an `external judgment relation`
// naming the Secretary/court as the authority, per AGENT-BRIEF's channel
// list — never an arithmetic guard. (b)(2) ("substantially disproportionate")
// is an EXACT computation: the 80 percent ratio-of-ratios test plus the
// independent "less than 50 percent after" floor, both applied to voting
// stock, and a separate 80 percent test for common stock (whether voting or
// nonvoting, by fair market value if more than one class). (b)(3) (complete
// termination of interest) reads section 318(a) attribution UNLESS the
// section 302(c)(2) family-attribution waiver conditions are met. (b)(4)
// (partial liquidation) is EVALUATIVE at the corporate level (section
// 302(e)(1)(A)) — modelled as an EVALUATIVE switch, with the (e)(2)
// "qualified trade or business" safe harbor as an EXACT precondition FEEDING
// that switch rather than a full second evaluative channel. (b)(5)
// (publicly offered RIC demand redemptions) is NOT modelled this stage —
// TECH_GAP: needs the section 67(c)(2)(B) "publicly offered" classification,
// EXTERNAL_DEPENDENCY. (b)(6) (redemption meeting more than one paragraph;
// interaction with the section 302(c)(2) 10-year lookback) is NOT modelled
// this stage — TECH_GAP.


use self::{
    AttributionKind,
    Corporation,
    IRC_S302_B,
    IRC_S302_C,
    IRC_S302_D,
    IRC_S302_E,
    Person,
    constructive_ownership,
    entity_waiver_barred_302c2c,
    related_person_acquired_interest_302c2c,
};

pub entity Redemption { label en unofficial "a corporation's redemption of its stock, within the meaning of section 317(b)"; }
pub relation redemption(r: Redemption, corp: Corporation, shareholder: Person, on: Date) kind empirical {
    label en official "a corporation redeems its stock from the shareholder (section 302(a), via section 317(b))";
}

pub relation redemption_exchange_treatment(r: Redemption) kind institutional {
    label en official "the redemption is treated as a distribution in part or full payment in exchange for the stock (section 302(a) capital/exchange treatment, as opposed to section 301 dividend treatment)";
}

// --- Section 302(b)(1): not essentially equivalent to a dividend (EVALUATIVE) --

@source(IRC_S302_B, quote = "Subsection (a) shall apply if the redemption is not essentially equivalent to a dividend.")
pub external judgment relation NotEssentiallyEquivalentToDividend(r: Redemption) {
    authority Secretary;
    label en official "the redemption is not essentially equivalent to a dividend (section 302(b)(1)) — DECISION-0194 evaluative channel: an external judgment of the Secretary or a court, never an arithmetic guard";
}
@source(IRC_S302_B, quote = "Subsection (a) shall apply if the redemption is not essentially equivalent to a dividend.")
rule NotEssentiallyEquivalentRule(r: Redemption) defeasible {
    label en official "section 302(b)(1): exchange treatment if the redemption is not essentially equivalent to a dividend";
    when NotEssentiallyEquivalentToDividend(r);
    then redemption_exchange_treatment(r);
}

// --- Section 302(b)(2): substantially disproportionate (EXACT) ---------------

pub relation voting_stock_owned_share(r: Redemption, shareholder: Person, corp: Corporation, before: Decimal, after: Decimal) kind empirical {
    label en unofficial "the shareholder's share of all voting stock of the corporation entitled to vote, immediately before and immediately after the redemption (section 302(b)(2)(C)(i)-(ii)), incorporating section 318(a) attribution per section 302(c)(1) as a case-asserted aggregate";
}
pub relation common_stock_owned_share(r: Redemption, shareholder: Person, corp: Corporation, before: Decimal, after: Decimal) kind empirical {
    label en unofficial "the shareholder's share of the corporation's common stock (voting or nonvoting; by fair market value if more than one class), immediately before and immediately after the redemption (section 302(b)(2)(C), second sentence)";
}

pub relation substantially_disproportionate(r: Redemption) kind institutional {
    label en official "the distribution is substantially disproportionate with respect to the shareholder (section 302(b)(2))";
}
@source(IRC_S302_B, quote = "This paragraph shall not apply unless immediately after the redemption the shareholder owns less than 50 percent of the total combined voting power of all classes of stock entitled to vote.")
@source(IRC_S302_B, quote = "the ratio which the voting stock of the corporation owned by the shareholder immediately after the redemption bears to all of the voting stock of the corporation at such time,")
@source(IRC_S302_B, quote = "no distribution shall be treated as substantially disproportionate unless the shareholder's ownership of the common stock of the corporation (whether voting or nonvoting) after and before redemption also meets the 80 percent requirement")
rule SubstantiallyDisproportionateRule(r: Redemption, shareholder: Person, corp: Corporation, voting_before: Decimal, voting_after: Decimal, common_before: Decimal, common_after: Decimal) defeasible {
    label en official "section 302(b)(2): substantially disproportionate if voting-power-after < 50%, the voting-ratio-after is less than 80% of the voting-ratio-before, and the common-stock ratio also meets the 80% test";
    when redemption(r, corp, shareholder, _);
    when voting_stock_owned_share(r, shareholder, corp, voting_before, voting_after);
    when common_stock_owned_share(r, shareholder, corp, common_before, common_after);
    when voting_after < 0.50;
    when voting_after < (0.80 * voting_before);
    when common_after < (0.80 * common_before);
    then substantially_disproportionate(r);
}
@source(IRC_S302_B, quote = "This paragraph shall not apply to any redemption made pursuant to a plan the purpose or effect of which is a series of redemptions resulting in a distribution which (in the aggregate) is not substantially disproportionate with respect to the shareholder.")
pub relation part_of_nondisproportionate_series(r: Redemption) kind empirical {
    label en official "the redemption is made pursuant to a plan whose purpose or effect is a series of redemptions that, in the aggregate, is not substantially disproportionate — blocks section 302(b)(2) (section 302(b)(2)(D))";
}
rule ExchangeTreatmentFromSubstantiallyDisproportionate(r: Redemption) defeasible {
    label en official "section 302(b)(2): exchange treatment for a substantially disproportionate redemption, unless it is part of a plan of nondisproportionate-in-the-aggregate redemptions (section 302(b)(2)(D))";
    when substantially_disproportionate(r);
    when not_known(part_of_nondisproportionate_series(r));
    then redemption_exchange_treatment(r);
}

// --- Section 302(b)(3): complete termination of interest ---------------------

pub relation owns_no_stock_after_redemption(r: Redemption, shareholder: Person, corp: Corporation) kind empirical {
    label en unofficial "the shareholder owns (actually and, subject to the section 302(c)(2) waiver, constructively) NO stock of the corporation immediately after the redemption — section 302(b)(3)'s complete-redemption test as a case-asserted aggregate over section 318(a) attribution and any waiver";
}
pub relation complete_termination_of_interest(r: Redemption) kind institutional {
    label en official "the redemption is in complete redemption of all of the stock of the corporation owned by the shareholder (section 302(b)(3))";
}
@source(IRC_S302_B, quote = "Subsection (a) shall apply if the redemption is in complete redemption of all of the stock of the corporation owned by the shareholder.")
rule CompleteTerminationRule(r: Redemption, shareholder: Person, corp: Corporation) strict {
    label en official "section 302(b)(3): exchange treatment for complete termination of the shareholder's interest";
    when redemption(r, corp, shareholder, _);
    when owns_no_stock_after_redemption(r, shareholder, corp);
    then complete_termination_of_interest(r);
    then redemption_exchange_treatment(r);
}
@source(IRC_S302_B, quote = "Subsection (a) shall apply if the redemption is in complete redemption of all of the stock of the corporation owned by the shareholder.")
rule CompleteTerminationFromAttributionRule(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en official "section 302(b)(3): the same exchange treatment, reached from module 03's summed constructive_ownership (section 302(c)(1) wiring) instead of a case-asserted aggregate";
    when redemption(r, corp, shareholder, _);
    when owns_no_stock_after_redemption_from_attribution(r, shareholder, corp);
    then complete_termination_of_interest(r);
    then redemption_exchange_treatment(r);
}

// Section 302(c)(2): the family-attribution (section 318(a)(1)) waiver for
// a (b)(3) complete termination — the three conditions, and the 10-year
// look-forward/look-back that disqualifies the waiver.
pub relation retains_no_prohibited_interest(r: Redemption, shareholder: Person, corp: Corporation) kind empirical {
    label en official "immediately after the distribution the distributee has no interest in the corporation (including as officer, director, or employee), other than an interest as a creditor (section 302(c)(2)(A)(i))";
}
pub relation no_acquisition_within_10_years(r: Redemption, shareholder: Person, corp: Corporation) kind empirical {
    label en official "the distributee does not acquire any prohibited interest (other than stock acquired by bequest or inheritance) within 10 years from the date of the distribution (section 302(c)(2)(A)(ii))";
}
pub relation files_303c2_notification_agreement(r: Redemption, shareholder: Person, corp: Corporation) kind empirical {
    label en official "the distributee files, at the time and in the manner the Secretary prescribes, an agreement to notify the Secretary of a prohibited acquisition and to retain necessary records (section 302(c)(2)(A)(iii))";
}
pub relation acquired_from_attributed_person_within_10_years(r: Redemption, shareholder: Person, corp: Corporation) kind empirical {
    label en official "part of the redeemed stock was acquired within the 10-year period ending on the distribution date from a person whose stock ownership would be attributable to the distributee under section 318(a) — blocks the waiver (section 302(c)(2)(B)(i)), unless the principal-purpose-of-tax-avoidance exception removes the block";
}
pub relation transferred_to_attributed_person_within_10_years(r: Redemption, shareholder: Person, corp: Corporation) kind empirical {
    label en official "a person whose stock ownership is attributable to the distributee under section 318(a) acquired stock in the corporation from the distributee within the 10-year period ending on the distribution date, and that stock was not redeemed in the same transaction — blocks the waiver (section 302(c)(2)(B)(ii)), unless the principal-purpose-of-tax-avoidance exception removes the block";
}
pub relation acquisition_or_disposition_had_tax_avoidance_purpose(r: Redemption, shareholder: Person, corp: Corporation) kind institutional {
    label en unofficial "the acquisition (or, for the transferred-to-attributed-person branch, the disposition) had as one of its principal purposes the avoidance of Federal income tax — DECISION-0194 evaluative element removing the section 302(c)(2)(B) block on the waiver";
}
@source(IRC_S302_C, quote = "did not have as one of its principal purposes the avoidance of Federal income tax")
pub external judgment relation TaxAvoidancePurposeOf302c2(r: Redemption, shareholder: Person, corp: Corporation) {
    authority Secretary;
    label en official "whether the acquisition or disposition described in section 302(c)(2)(B) had a principal purpose of Federal income tax avoidance — DECISION-0194 evaluative channel";
}
rule TaxAvoidancePurposeFromJudgment(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en unofficial "bridges the named evaluative channel to the institutional relation the waiver rules below read";
    when TaxAvoidancePurposeOf302c2(r, shareholder, corp);
    then acquisition_or_disposition_had_tax_avoidance_purpose(r, shareholder, corp);
}

pub relation section_318a1_waived_for_redemption(r: Redemption, shareholder: Person, corp: Corporation) kind institutional {
    label en official "section 318(a)(1) family attribution does not apply in determining ownership for this section 302(b)(3) distribution (section 302(c)(2)(A) waiver)";
}
@source(IRC_S302_C, quote = "In the case of a distribution described in subsection (b)(3), section 318(a)(1) shall not apply if—")
rule Section302c2WaiverRule(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en official "section 302(c)(2)(A): the family-attribution waiver applies once the three conditions are met, unless the (B) block applies and is not lifted by the tax-avoidance exception";
    when retains_no_prohibited_interest(r, shareholder, corp);
    when no_acquisition_within_10_years(r, shareholder, corp);
    when files_303c2_notification_agreement(r, shareholder, corp);
    when not_known(acquired_from_attributed_person_within_10_years(r, shareholder, corp));
    when not_known(transferred_to_attributed_person_within_10_years(r, shareholder, corp));
    when not_known(entity_waiver_barred_302c2c(r, shareholder));
    when not_known(related_person_acquired_interest_302c2c(r, shareholder));
    then section_318a1_waived_for_redemption(r, shareholder, corp);
}
@source(IRC_S302_C, quote = "any portion of the stock redeemed was acquired, directly or indirectly, within the 10-year period ending on the date of the distribution by the distributee from a person the ownership of whose stock would (at the time of distribution) be attributable to the distributee under section 318(a), or")
rule Section302c2WaiverBlockedByAcquisitionRule(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en official "section 302(c)(2)(B)(i): the waiver is still available despite an attributed-person acquisition within 10 years if that acquisition's principal purpose was NOT tax avoidance";
    when retains_no_prohibited_interest(r, shareholder, corp);
    when no_acquisition_within_10_years(r, shareholder, corp);
    when files_303c2_notification_agreement(r, shareholder, corp);
    when acquired_from_attributed_person_within_10_years(r, shareholder, corp);
    when not_known(acquisition_or_disposition_had_tax_avoidance_purpose(r, shareholder, corp));
    when not_known(entity_waiver_barred_302c2c(r, shareholder));
    then section_318a1_waived_for_redemption(r, shareholder, corp);
}

// --- Section 302(b)(4)/(e): partial liquidation -------------------------------

pub relation partial_liquidation_qualified_trade_or_business_safe_harbor(r: Redemption) kind empirical {
    label en official "the distribution meets the section 302(e)(2)(A)-(B) safe harbor: attributable to (or consisting of the assets of) a qualified trade or business the distributing corporation ceases to conduct, and the corporation is actively engaged in a qualified trade or business immediately after (asserted as a case fact incorporating the section 302(e)(3) 5-year active-conduct/no-recognized-gain-or-loss-acquisition test on the retained business, which this stage does not further decompose)";
}
pub relation not_essentially_equivalent_to_dividend_at_corporate_level(r: Redemption) kind institutional {
    label en unofficial "section 302(e)(1)(A): the distribution is not essentially equivalent to a dividend, determined at the CORPORATE level rather than the shareholder level — a distinct evaluative test from section 302(b)(1)'s shareholder-level test";
}
@source(IRC_S302_E, quote = "the distribution is not essentially equivalent to a dividend (determined at the corporate level rather than at the shareholder level)")
pub external judgment relation NotEssentiallyEquivalentAtCorporateLevel(r: Redemption) {
    authority Secretary;
    label en official "section 302(e)(1)(A) corporate-level not-essentially-equivalent-to-a-dividend test — DECISION-0194 evaluative channel, distinct from the shareholder-level section 302(b)(1) channel";
}
rule CorporateLevelNotEssentiallyEquivalentFromJudgment(r: Redemption) defeasible {
    label en unofficial "bridges the named evaluative channel to the institutional relation the partial-liquidation rules below read";
    when NotEssentiallyEquivalentAtCorporateLevel(r);
    then not_essentially_equivalent_to_dividend_at_corporate_level(r);
}
pub relation within_plan_adoption_window(r: Redemption) kind empirical {
    label en official "the distribution is pursuant to a plan and occurs within the taxable year the plan is adopted or the succeeding taxable year (section 302(e)(1)(B))";
}
pub relation redeemed_shareholder_not_a_corporation(r: Redemption, shareholder: Person) kind empirical {
    label en official "the shareholder whose stock is redeemed is not a corporation (section 302(b)(4)(A); stock held by a partnership, estate, or trust is treated as held proportionately by its partners or beneficiaries for this purpose, section 302(e)(5) — asserted here as a case-level classification of the ultimate redeemed shareholder)";
}
pub relation partial_liquidation(r: Redemption) kind institutional {
    label en official "the distribution is treated as in partial liquidation of the distributing corporation (section 302(e)(1))";
}
@source(IRC_S302_E, quote = "For purposes of subsection (b)(4), a distribution shall be treated as in partial liquidation of a corporation if—")
rule PartialLiquidationByCorporateLevelJudgmentRule(r: Redemption) defeasible {
    label en official "section 302(e)(1): partial liquidation via the general corporate-level not-essentially-equivalent test plus the plan-window timing requirement";
    when not_essentially_equivalent_to_dividend_at_corporate_level(r);
    when within_plan_adoption_window(r);
    then partial_liquidation(r);
}
@source(IRC_S302_E, quote = "The distributions which meet the requirements of paragraph (1)(A) shall include (but shall not be limited to) a distribution which meets the requirements of subparagraphs (A) and (B) of this paragraph")
rule PartialLiquidationBySafeHarborRule(r: Redemption) defeasible {
    label en official "section 302(e)(2): the qualified-trade-or-business safe harbor independently satisfies the section 302(e)(1)(A) requirement (not exclusively — 'shall include but not be limited to')";
    when partial_liquidation_qualified_trade_or_business_safe_harbor(r);
    when within_plan_adoption_window(r);
    then partial_liquidation(r);
}
@source(IRC_S302_B, quote = "Subsection (a) shall apply to a distribution if such distribution is—")
rule ExchangeTreatmentFromPartialLiquidationRule(r: Redemption, corp: Corporation, shareholder: Person) defeasible {
    label en official "section 302(b)(4): exchange treatment for a partial-liquidation redemption of a noncorporate shareholder's stock";
    when redemption(r, corp, shareholder, _);
    when redeemed_shareholder_not_a_corporation(r, shareholder);
    when partial_liquidation(r);
    then redemption_exchange_treatment(r);
}

// --- Section 302(d): default to section 301 -----------------------------------

pub relation redemption_section_301_treatment(r: Redemption) kind institutional {
    label en official "the redemption is treated as a distribution of property to which section 301 applies (section 302(d) default)";
}
@source(IRC_S302_D, quote = "Except as otherwise provided in this subchapter, if a corporation redeems its stock (within the meaning of section 317(b)), and if subsection (a) of this section does not apply, such redemption shall be treated as a distribution of property to which section 301 applies.")
rule Section302dDefaultRule(r: Redemption, corp: Corporation, shareholder: Person) defeasible {
    label en official "section 302(d): a redemption not qualifying for exchange treatment under (b)(1)-(5) defaults to section 301 dividend treatment";
    when redemption(r, corp, shareholder, _);
    when not_known(redemption_exchange_treatment(r));
    then redemption_section_301_treatment(r);
}

// Section 302(f): pure cross-reference (sections 303, 306, 331) —
// NON_NORMATIVE.

// --- Section 302(c)(1) wired end-to-end into module 03's attribution --------
//
// Stage 1b (coordinator continuation): section 302(c)(1) ("section 318(a)
// shall apply in determining the ownership of stock for purposes of this
// section") is now derived FROM module 03's `constructive_ownership`
// relation, summed across every attribution kind, rather than read only as
// a case-asserted aggregate (`voting_stock_owned_share`/`owns_no_stock_
// after_redemption` above remain available for a case that supplies the
// aggregate directly — the two are alternative ways to reach the same
// facts, not a replacement).
pub relation total_constructive_ownership_share(p: Person, corp: Corporation, share: Decimal) kind institutional {
    label en official "section 302(c)(1)/section 318(a): the sum, across every attribution kind module 03 derives (Actual, Family, FromEntity, ToEntity, Option), of a person's actual-and-constructive ownership share in a corporation";
}
@source(IRC_S302_C, quote = "Except as provided in paragraph (2) of this subsection, section 318(a) shall apply in determining the ownership of stock for purposes of this section.")
rule TotalConstructiveOwnershipShareRule(p: Person, corp: Corporation) defeasible {
    label en official "section 302(c)(1): sum module 03's constructive_ownership over every AttributionKind for the (person, corporation) pair";
    when constructive_ownership(p, corp, _, _);
    then total_constructive_ownership_share(p, corp, sum all share: Decimal for via: AttributionKind where constructive_ownership(p, corp, share, via));
}
pub relation owns_no_stock_after_redemption_from_attribution(r: Redemption, shareholder: Person, corp: Corporation) kind institutional {
    label en unofficial "the section 302(b)(3) complete-termination test, derived from total_constructive_ownership_share being exactly zero — valid ONLY when the case's us.irc.core::ownership_interest facts already represent the ownership graph AS OF immediately after the redemption (see the SOURCE_GAP note below: ownership_interest carries no time parameter, so 'before'/'after' cannot be distinguished by this package from the same fact shape — the case bears the burden of asserting the post-redemption graph, which this rule then sums)";
}
rule OwnsNoStockAfterRedemptionFromAttributionRule(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en unofficial "bridges the summed attribution total to the section 302(b)(3) test this module's CompleteTerminationRule reads";
    when redemption(r, corp, shareholder, _);
    when total_constructive_ownership_share(shareholder, corp, 0.0);
    then owns_no_stock_after_redemption_from_attribution(r, shareholder, corp);
}
// SOURCE_GAP / TECH_GAP filed as TECH-GAPS.md G60: `us.irc.core::
// ownership_interest(o, holder, held_in, share)` has no temporal
// parameter, so a single redemption event's BEFORE and AFTER ownership
// states cannot both be represented as facts of the same relation without
// an owner-level convention (e.g. two disjoint OwnershipInterest instances,
// one for each snapshot) that this package does not itself define — core
// owns that shape. The `total_constructive_ownership_share` sum above is
// therefore correct only when a scenario's `ownership_interest` facts are
// understood to describe ONE named snapshot (here, "after") consistently.
// Analogous wiring for `voting_stock_owned_share`'s "before"/"after" pair
// (section 302(b)(2)) would need the SAME two-snapshot convention TWICE
// over — not attempted this stage, same gap.
//
// NOT DONE this stage: section 302(b)(5) (publicly offered RIC demand
// redemptions — needs section 67(c)(2)(B) classification, EXTERNAL_
// DEPENDENCY, not built); section 302(b)(6) (paragraph-(3)-and-also-(1)/(2)/
// (4) interaction with the section 302(c)(2) 10-year lookback period of
// limitations) — TECH_GAP, not modelled; section 302(c)(2)(C) (entity
// version of the waiver: joint-and-several liability agreement among
// related persons) — TECH_GAP, not modelled.
