// Stage 3b (26.09.2026, TECH_GAP reduction). Residual rows of section 302
// ((b)(5), (b)(6), (c)(2) tail, (c)(2)(B)(ii), (c)(2)(C), (e)(3), (e)(5)),
// section 303(c)-(d) and section 306(d)-(g). Status implemented_unverified:
// nothing here was executed.
// Wiring notes (TECH-GAPS G4027, G4032): the section 303(b)(4) four-year
// ceiling is not applied to substituted or generation-skipping stock; the
// section 302(b)(6) waiver variant does not lift the (B) blocks by the
// tax-avoidance exception.

// --- Section 302(b)(5): publicly offered regulated investment companies -------------------------

use self::{
    Asset,
    Corporation,
    IRC_S302_B,
    IRC_S302_C,
    IRC_S302_E,
    IRC_S303_C,
    IRC_S303_D,
    IRC_S306_D,
    IRC_S306_E,
    IRC_S306_F,
    IRC_S306_G,
    NotEssentiallyEquivalentToDividend,
    Person,
    Redemption,
    Section306StockDisposition,
    acquired_from_attributed_person_within_10_years,
    acquisition_or_disposition_had_tax_avoidance_purpose,
    complete_termination_of_interest,
    death_taxes_imposed_303a1,
    distribution_more_than_4_years_after_death,
    distribution_within_303b1_period,
    files_303c2_notification_agreement,
    funeral_and_administration_expenses_303a2,
    no_acquisition_within_10_years,
    no_earnings_and_profits_exception_306c2,
    partial_liquidation,
    redeemed_shareholder_not_a_corporation,
    redemption,
    redemption_exchange_treatment,
    retains_no_prohibited_interest,
    section_303_exchange_treatment,
    section_303a_ceiling,
    section_303b2_relationship_satisfied,
    section_306_stock,
    section_306a1a_ordinary_income,
    section_318a1_waived_for_redemption,
    shareholder_interest_reduced_by_payment_303b3,
    stock_distributed_excluded_under_305a_306c1a,
    substantially_disproportionate,
    transferred_to_attributed_person_within_10_years,
};

pub relation publicly_offered_ric_302b5(corp: Corporation) kind empirical {
    label en official "the corporation is a publicly offered regulated investment company within the meaning of section 67(c)(2)(B) (classification asserted; EXTERNAL_DEPENDENCY on the RIC status determination)";
}
pub relation redemption_upon_demand_of_stockholder_302b5a(r: Redemption) kind empirical {
    label en official "the redemption is upon the demand of the stockholder (section 302(b)(5)(A))";
}
pub relation company_issues_only_demand_redeemable_stock_302b5b(corp: Corporation) kind empirical {
    label en official "the company issues only stock which is redeemable upon the demand of the stockholder (section 302(b)(5)(B))";
}
pub relation regulations_provide_otherwise_302b5(r: Redemption) kind empirical {
    label en official "the regulations prescribed by the Secretary provide otherwise for this redemption (section 302(b)(5), 'except to the extent provided in regulations'; regulation content is an asserted fact)";
}
@source(IRC_S302_B, quote = "Except to the extent provided in regulations prescribed by the Secretary, subsection (a) shall apply to any distribution in redemption of stock of a publicly offered regulated investment company (within the meaning of section 67(c)(2)(B)) if—")
rule Section302b5Rule(r: Redemption, corp: Corporation, shareholder: Person) defeasible {
    label en official "section 302(b)(5): demand redemptions by a publicly offered RIC that issues only demand-redeemable stock get exchange treatment";
    when redemption(r, corp, shareholder, _);
    when publicly_offered_ric_302b5(corp);
    when redemption_upon_demand_of_stockholder_302b5a(r);
    when company_issues_only_demand_redeemable_stock_302b5b(corp);
    when not_known(regulations_provide_otherwise_302b5(r));
    then redemption_exchange_treatment(r);
}

// --- Section 302(b)(6) and (c)(2): the waiver, its 10-year rule, entities ---------------------

pub relation redemption_also_meets_302b1_302b2_or_302b4(r: Redemption) kind institutional {
    label en official "the redemption meets the requirements of paragraph (3) and also those of paragraph (1), (2) or (4) (section 302(b)(6), second sentence)";
}
@source(IRC_S302_B, quote = "If a redemption meets the requirements of paragraph (3) and also the requirements of paragraph (1), (2), or (4), then so much of subsection (c)(2) as would (but for this sentence) apply in respect of the acquisition of an interest in the corporation within the 10-year period beginning on the date of the distribution shall not apply.")
rule Section302b6With302b1Rule(r: Redemption) defeasible {
    label en official "section 302(b)(6): (3) together with (1)";
    when complete_termination_of_interest(r);
    when NotEssentiallyEquivalentToDividend(r);
    then redemption_also_meets_302b1_302b2_or_302b4(r);
}
@source(IRC_S302_B, quote = "If a redemption meets the requirements of paragraph (3) and also the requirements of paragraph (1), (2), or (4), then so much of subsection (c)(2) as would (but for this sentence) apply in respect of the acquisition of an interest in the corporation within the 10-year period beginning on the date of the distribution shall not apply.")
rule Section302b6With302b2Rule(r: Redemption) defeasible {
    label en official "section 302(b)(6): (3) together with (2)";
    when complete_termination_of_interest(r);
    when substantially_disproportionate(r);
    then redemption_also_meets_302b1_302b2_or_302b4(r);
}
@source(IRC_S302_B, quote = "If a redemption meets the requirements of paragraph (3) and also the requirements of paragraph (1), (2), or (4), then so much of subsection (c)(2) as would (but for this sentence) apply in respect of the acquisition of an interest in the corporation within the 10-year period beginning on the date of the distribution shall not apply.")
rule Section302b6With302b4Rule(r: Redemption) defeasible {
    label en official "section 302(b)(6): (3) together with (4)";
    when complete_termination_of_interest(r);
    when partial_liquidation(r);
    when redeemed_shareholder_not_a_corporation(r, _);
    then redemption_also_meets_302b1_302b2_or_302b4(r);
}
@source(IRC_S302_C, quote = "(i) immediately after the distribution the distributee has no interest in the corporation (including an interest as officer, director, or employee), other than an interest as a creditor,")
rule Section302c2WaiverWithoutTenYearRule(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en official "section 302(c)(2) as limited by section 302(b)(6): with (b)(3) and one of (b)(1), (2), (4) met the 10-year no-acquisition clause does not apply; the no-interest and agreement clauses and the (B) blocks remain";
    when redemption(r, corp, shareholder, _);
    when redemption_also_meets_302b1_302b2_or_302b4(r);
    when retains_no_prohibited_interest(r, shareholder, corp);
    when files_303c2_notification_agreement(r, shareholder, corp);
    when not_known(acquired_from_attributed_person_within_10_years(r, shareholder, corp));
    when not_known(transferred_to_attributed_person_within_10_years(r, shareholder, corp));
    when not_known(entity_waiver_barred_302c2c(r, shareholder));
    then section_318a1_waived_for_redemption(r, shareholder, corp);
}
pub relation transferred_stock_redeemed_in_same_transaction_302c2bii(r: Redemption, shareholder: Person, corp: Corporation) kind empirical {
    label en official "the stock acquired from the distributee by the attributed person is redeemed in the same transaction (section 302(c)(2)(B)(ii), 'unless')";
}
@source(IRC_S302_C, quote = "unless such stock so acquired from the distributee is redeemed in the same transaction.")
rule Section302c2WaiverSameTransactionRedemptionRule(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en official "section 302(c)(2)(B)(ii): a transfer to an attributed person does not block the waiver if the transferred stock is redeemed in the same transaction";
    when retains_no_prohibited_interest(r, shareholder, corp);
    when no_acquisition_within_10_years(r, shareholder, corp);
    when files_303c2_notification_agreement(r, shareholder, corp);
    when transferred_stock_redeemed_in_same_transaction_302c2bii(r, shareholder, corp);
    when not_known(acquired_from_attributed_person_within_10_years(r, shareholder, corp));
    when not_known(entity_waiver_barred_302c2c(r, shareholder));
    then section_318a1_waived_for_redemption(r, shareholder, corp);
}
@source(IRC_S302_C, quote = "The preceding sentence shall not apply if the acquisition (or, in the case of clause (ii), the disposition) by the distributee did not have as one of its principal purposes the avoidance of Federal income tax.")
rule Section302c2WaiverBlockedByTransferRule(r: Redemption, shareholder: Person, corp: Corporation) defeasible {
    label en official "section 302(c)(2)(B)(ii): the waiver stands despite a transfer to an attributed person within 10 years when the disposition had no principal purpose of tax avoidance";
    when retains_no_prohibited_interest(r, shareholder, corp);
    when no_acquisition_within_10_years(r, shareholder, corp);
    when files_303c2_notification_agreement(r, shareholder, corp);
    when transferred_to_attributed_person_within_10_years(r, shareholder, corp);
    when not_known(acquisition_or_disposition_had_tax_avoidance_purpose(r, shareholder, corp));
    when not_known(acquired_from_attributed_person_within_10_years(r, shareholder, corp));
    when not_known(entity_waiver_barred_302c2c(r, shareholder));
    then section_318a1_waived_for_redemption(r, shareholder, corp);
}
pub relation interest_acquired_within_10_years_on_302c2a(r: Redemption, shareholder: Person, on: Date) kind empirical {
    label en official "the distributee acquires an interest in the corporation (other than by bequest or inheritance) within 10 years from the distribution date (asserted with the acquisition date)";
}
pub relation distributee_notified_secretary_on_302c2a(r: Redemption, shareholder: Person, on: Date) kind empirical {
    label en official "the date on which the distributee (in accordance with regulations) notifies the Secretary of the acquisition";
}
pub relation assessment_and_collection_open_through_302c2a(r: Redemption, shareholder: Person, through: Date) kind institutional {
    label en official "the periods of limitation under sections 6501 and 6502 for any deficiency resulting from the acquisition include the one year immediately following the notification date (section 302(c)(2)(A), last sentence)";
}
@source(IRC_S302_C, quote = "include one year immediately following the date on which the distributee (in accordance with regulations prescribed by the Secretary) notifies the Secretary of such acquisition")
rule Section302c2ALimitationsExtensionRule(r: Redemption, shareholder: Person, notified: Date) defeasible {
    label en official "section 302(c)(2)(A): the limitation periods run through one year after notice, notwithstanding any bar; not when (b)(6) disapplies the 10-year rule";
    when interest_acquired_within_10_years_on_302c2a(r, shareholder, _);
    when distributee_notified_secretary_on_302c2a(r, shareholder, notified);
    when not_known(redemption_also_meets_302b1_302b2_or_302b4(r));
    then assessment_and_collection_open_through_302c2a(r, shareholder, add_calendar_period(notified, 1 calendar_year));
}
pub relation distribution_to_entity_302c2c(r: Redemption, shareholder: Person) kind empirical {
    label en official "the distributee is an entity: a partnership, estate, trust or corporation (section 302(c)(2)(C)(ii)(I))";
}
pub relation related_person_of_entity_302c2c(r: Redemption, shareholder: Person, related: Person) kind empirical {
    label en official "a person to whom stock ownership is attributable under section 318(a)(1) at the distribution time and further attributable to the entity under section 318(a)(3) (section 302(c)(2)(C)(ii)(II); attribution asserted)";
}
pub relation related_person_meets_302c2a_conditions_302c2ci1(r: Redemption, related: Person) kind empirical {
    label en official "the related person meets clauses (i), (ii) and (iii) of subparagraph (A)";
}
pub relation related_person_agrees_joint_and_several_302c2ci2(r: Redemption, related: Person) kind empirical {
    label en official "the related person agrees to be jointly and severally liable for any deficiency resulting from an acquisition described in (A)(ii)";
}
pub relation related_person_cleared_302c2c(r: Redemption, related: Person) kind institutional {
    label en unofficial "helper: the related person meets (A)(i)-(iii) and agrees to joint and several liability";
}
rule Section302c2cRelatedPersonClearedRule(r: Redemption, related: Person) strict {
    label en unofficial "helper: both related-person conditions";
    when related_person_meets_302c2a_conditions_302c2ci1(r, related);
    when related_person_agrees_joint_and_several_302c2ci2(r, related);
    then related_person_cleared_302c2c(r, related);
}
pub relation related_person_uncleared_302c2c(r: Redemption, shareholder: Person) kind institutional {
    label en unofficial "helper: some related person of the entity is not cleared";
}
rule Section302c2cUnclearedRule(r: Redemption, shareholder: Person, related: Person) strict {
    label en unofficial "helper: an uncleared related person";
    when related_person_of_entity_302c2c(r, shareholder, related);
    when not_known(related_person_cleared_302c2c(r, related));
    then related_person_uncleared_302c2c(r, shareholder);
}
pub relation related_person_acquired_interest_302c2c(r: Redemption, shareholder: Person) kind empirical {
    label en official "a related person acquired a prohibited interest within 10 years (section 302(c)(2)(C)(i), last sentence: 'distributee or any related person' substituted in (A) second sentence)";
}
pub relation entity_waiver_barred_302c2c(r: Redemption, shareholder: Person) kind institutional {
    label en official "subparagraph (A) does not apply to a distribution to an entity unless the entity and each related person meet (A)(i)-(iii) and each related person agrees to joint and several liability (section 302(c)(2)(C)(i))";
}
@source(IRC_S302_C, quote = "Subparagraph (A) shall not apply to a distribution to any entity unless—")
rule Section302c2cBarredRule(r: Redemption, shareholder: Person) strict {
    label en official "section 302(c)(2)(C)(i): an entity distribution with an uncleared related person";
    when distribution_to_entity_302c2c(r, shareholder);
    when related_person_uncleared_302c2c(r, shareholder);
    then entity_waiver_barred_302c2c(r, shareholder);
}
@source(IRC_S302_C, quote = "In any case to which the preceding sentence applies, the second sentence of subparagraph (A) and subparagraph (B)(ii) shall be applied by substituting \"distributee or any related person\" for \"distributee\" each place it appears.")
rule Section302c2cRelatedAcquisitionBarsRule(r: Redemption, shareholder: Person) strict {
    label en official "section 302(c)(2)(C)(i): a related person's prohibited acquisition bars the entity waiver as the distributee's would";
    when distribution_to_entity_302c2c(r, shareholder);
    when related_person_acquired_interest_302c2c(r, shareholder);
    then entity_waiver_barred_302c2c(r, shareholder);
}

// --- Section 302(e)(3), (e)(5) -------------------------------------------------------------------

pub entity BusinessCandidate302e { label en unofficial "a trade or business tested as a qualified trade or business (section 302(e)(3))"; }
pub relation actively_conducted_throughout_5_years_302e3a(tb: BusinessCandidate302e) kind empirical {
    label en official "the trade or business was actively conducted throughout the 5-year period ending on the date of the redemption";
}
pub relation acquired_in_recognition_transaction_within_5_years_302e3b(tb: BusinessCandidate302e) kind empirical {
    label en official "the trade or business was acquired by the corporation within that period in a transaction in which gain or loss was recognized in whole or in part";
}
pub relation qualified_trade_or_business_302e3(tb: BusinessCandidate302e) kind institutional {
    label en official "a qualified trade or business (section 302(e)(3))";
}
@source(IRC_S302_E, quote = "was actively conducted throughout the 5-year period ending on the date of the redemption, and")
rule Section302e3Rule(tb: BusinessCandidate302e) strict {
    label en official "section 302(e)(3): (A) and not (B)";
    when actively_conducted_throughout_5_years_302e3a(tb);
    when not_known(acquired_in_recognition_transaction_within_5_years_302e3b(tb));
    then qualified_trade_or_business_302e3(tb);
}
pub relation pass_through_holds_redeemed_stock_302e5(r: Redemption, pt: Person) kind empirical {
    label en official "the redeemed stock is held by a partnership, estate or trust";
}
pub relation proportionate_interest_in_pass_through_302e5(pt: Person, owner: Person, share: Decimal) kind empirical {
    label en official "the partner or beneficiary's proportionate interest in the partnership, estate or trust";
}
pub relation stock_treated_held_by_owner_302e5(r: Redemption, owner: Person, share: Decimal) kind institutional {
    label en official "for the (b)(4) noncorporate-shareholder test, the stock held by a partnership, estate or trust is treated as held proportionately by its partners or beneficiaries (section 302(e)(5)); not wired into module 04 (G4027)";
}
@source(IRC_S302_E, quote = "any stock held by a partnership, estate, or trust shall be treated as if it were actually held proportionately by its partners or beneficiaries.")
rule Section302e5Rule(r: Redemption, pt: Person, owner: Person, share: Decimal) strict {
    label en official "section 302(e)(5)";
    when pass_through_holds_redeemed_stock_302e5(r, pt);
    when proportionate_interest_in_pass_through_302e5(pt, owner, share);
    then stock_treated_held_by_owner_302e5(r, owner, share);
}

// --- Section 303(c)-(d) -------------------------------------------------------------------------

pub relation new_stock_basis_from_old_stock_303c1(r: Redemption, shareholder: Person) kind empirical {
    label en official "the shareholder owns the redeemed stock ('new stock') whose basis is determined by reference to the basis of 'old stock' (section 303(c)(1))";
}
pub relation old_stock_included_in_gross_estate_303c2(r: Redemption, decedent: Person) kind empirical {
    label en official "the old stock was included (for Federal estate tax purposes) in determining the gross estate of a decedent";
}
pub relation section_303a_would_apply_to_old_stock_303c3(r: Redemption) kind empirical {
    label en official "subsection (a) would apply to a distribution in redemption of the old stock";
}
pub relation section_303_substituted_stock_applies_303c(r: Redemption, shareholder: Person) kind institutional {
    label en official "subsection (a) applies to the redemption of the new stock, subject to (b) (section 303(c))";
}
@source(IRC_S303_C, quote = "then, subject to the limitation specified in subsection (b), subsection (a) shall apply in respect of a distribution in redemption of the new stock.")
rule Section303cRule(r: Redemption, shareholder: Person, decedent: Person) strict {
    label en official "section 303(c): the three conditions";
    when new_stock_basis_from_old_stock_303c1(r, shareholder);
    when old_stock_included_in_gross_estate_303c2(r, decedent);
    when section_303a_would_apply_to_old_stock_303c3(r);
    then section_303_substituted_stock_applies_303c(r, shareholder);
}
@source(IRC_S303_C, quote = "then, subject to the limitation specified in subsection (b), subsection (a) shall apply in respect of a distribution in redemption of the new stock.")
rule Section303cExchangeTreatmentRule(r: Redemption, shareholder: Person, ceiling: Money, reduction: Money) defeasible {
    label en official "section 303(c) with (b): full-payment exchange treatment for the new stock up to the lesser of the ceiling and the (b)(3) reduction, within the (b)(1) period and the (b)(2) relationship";
    when section_303_substituted_stock_applies_303c(r, shareholder);
    when distribution_within_303b1_period(r);
    when section_303b2_relationship_satisfied(r);
    when section_303a_ceiling(r, ceiling);
    when shareholder_interest_reduced_by_payment_303b3(r, reduction);
    when not_known(distribution_more_than_4_years_after_death(r));
    when reduction <= ceiling;
    then section_303_exchange_treatment(r, shareholder, reduction);
}
@source(IRC_S303_C, quote = "then, subject to the limitation specified in subsection (b), subsection (a) shall apply in respect of a distribution in redemption of the new stock.")
rule Section303cExchangeTreatmentCeilingLowerRule(r: Redemption, shareholder: Person, ceiling: Money, reduction: Money) defeasible {
    label en official "section 303(c) with (b): capped at the ceiling where it is lower than the (b)(3) reduction";
    when section_303_substituted_stock_applies_303c(r, shareholder);
    when distribution_within_303b1_period(r);
    when section_303b2_relationship_satisfied(r);
    when section_303a_ceiling(r, ceiling);
    when shareholder_interest_reduced_by_payment_303b3(r, reduction);
    when not_known(distribution_more_than_4_years_after_death(r));
    when ceiling < reduction;
    then section_303_exchange_treatment(r, shareholder, ceiling);
}
pub relation generation_skipping_transfer_at_death_303d(r: Redemption, decedent: Person) kind empirical {
    label en official "the redeemed stock is the subject of a generation-skipping transfer (section 2611(a)) occurring at the same time as and as a result of the death of the individual";
}
pub relation generation_skipping_tax_imposed_303d2(r: Redemption, amount: Money) kind empirical {
    label en official "the tax imposed by section 2601 because of the generation-skipping transfer";
}
pub relation generation_skipping_transfer_date_303d3(r: Redemption, on: Date) kind empirical {
    label en official "the date of the generation-skipping transfer";
}
pub relation redemption_within_period_from_gst_303d3(r: Redemption) kind empirical {
    label en official "the distribution is made within the section 303(b)(1) period measured from the generation-skipping transfer date (window asserted; the estate-gift limitation machinery is an EXTERNAL_DEPENDENCY)";
}
pub relation stock_value_relative_to_gst_amount_303d4(r: Redemption, stock_value: Money, gst_amount: Money) kind empirical {
    label en official "the value of the stock and the amount of the generation-skipping transfer, the sole measure of the 35 percent relationship";
}
pub relation stock_deemed_in_gross_estate_303d1(r: Redemption, decedent: Person) kind institutional {
    label en official "the stock is deemed to be included in the gross estate of the individual (section 303(d)(1))";
}
@source(IRC_S303_D, quote = "(1) the stock shall be deemed to be included in the gross estate of such individual;")
rule Section303d1Rule(r: Redemption, decedent: Person) strict {
    label en official "section 303(d)(1)";
    when generation_skipping_transfer_at_death_303d(r, decedent);
    then stock_deemed_in_gross_estate_303d1(r, decedent);
}
pub relation section_303d_ceiling(r: Redemption, amount: Money) kind institutional {
    label en official "the section 303(a) ceiling with the section 2601 tax treated as an estate tax: death taxes plus generation-skipping tax plus funeral and administration expenses (section 303(d)(2))";
}
@source(IRC_S303_D, quote = "(2) taxes of the kind referred to in subsection (a)(1) which are imposed because of the generation-skipping transfer shall be treated as imposed because of such individual's death (and for this purpose the tax imposed by section 2601 shall be treated as an estate tax);")
rule Section303d2CeilingRule(r: Redemption, decedent: Person, taxes: Money, gst: Money, expenses: Money) strict {
    label en official "section 303(d)(2)";
    when generation_skipping_transfer_at_death_303d(r, decedent);
    when death_taxes_imposed_303a1(r, taxes);
    when generation_skipping_tax_imposed_303d2(r, gst);
    when funeral_and_administration_expenses_303a2(r, expenses);
    then section_303d_ceiling(r, taxes + gst + expenses);
}
pub relation section_303d_relationship_satisfied_303d4(r: Redemption) kind institutional {
    label en official "the stock value exceeds 35 percent of the generation-skipping transfer amount, measured solely by that amount (section 303(d)(4))";
}
@source(IRC_S303_D, quote = "(4) the relationship of stock to the decedent's estate shall be measured with reference solely to the amount of the generation-skipping transfer.")
rule Section303d4Rule(r: Redemption, stock_value: Money, gst_amount: Money) strict {
    label en official "section 303(d)(4): stock value more than 35 percent of the generation-skipping transfer amount";
    when stock_value_relative_to_gst_amount_303d4(r, stock_value, gst_amount);
    when stock_value > round(gst_amount * 0.35, 2, "HALF_UP");
    then section_303d_relationship_satisfied_303d4(r);
}
@source(IRC_S303_D, quote = "(3) the period of distribution shall be measured from the date of the generation-skipping transfer; and")
rule Section303dExchangeTreatmentRule(r: Redemption, shareholder: Person, decedent: Person, ceiling: Money, reduction: Money) defeasible {
    label en official "section 303(a) with (d): exchange treatment for generation-skipping stock, up to the (d)(2) ceiling and the (b)(3) reduction";
    when redemption(r, _, shareholder, _);
    when stock_deemed_in_gross_estate_303d1(r, decedent);
    when redemption_within_period_from_gst_303d3(r);
    when section_303d_relationship_satisfied_303d4(r);
    when section_303d_ceiling(r, ceiling);
    when shareholder_interest_reduced_by_payment_303b3(r, reduction);
    when reduction <= ceiling;
    then section_303_exchange_treatment(r, shareholder, reduction);
}
@source(IRC_S303_D, quote = "(3) the period of distribution shall be measured from the date of the generation-skipping transfer; and")
rule Section303dExchangeTreatmentCeilingLowerRule(r: Redemption, shareholder: Person, decedent: Person, ceiling: Money, reduction: Money) defeasible {
    label en official "section 303(a) with (d): capped at the (d)(2) ceiling where it is lower";
    when redemption(r, _, shareholder, _);
    when stock_deemed_in_gross_estate_303d1(r, decedent);
    when redemption_within_period_from_gst_303d3(r);
    when section_303d_relationship_satisfied_303d4(r);
    when section_303d_ceiling(r, ceiling);
    when shareholder_interest_reduced_by_payment_303b3(r, reduction);
    when ceiling < reduction;
    then section_303_exchange_treatment(r, shareholder, ceiling);
}

// --- Section 306(d)-(g) -----------------------------------------------------------------------

pub relation is_stock_right_306d(right: Asset) kind empirical {
    label en official "the asset is a stock right";
}
pub relation stock_right_treated_as_stock_306d1(right: Asset) kind institutional {
    label en official "stock rights are treated as stock for section 306 (section 306(d)(1))";
}
@source(IRC_S306_D, quote = "(1) stock rights shall be treated as stock, and")
rule Section306d1Rule(right: Asset) strict {
    label en official "section 306(d)(1)";
    when is_stock_right_306d(right);
    then stock_right_treated_as_stock_306d1(right);
}
pub relation stock_acquired_by_exercise_of_rights_306d2(stock: Asset, right: Asset, fmv_of_rights: Money) kind empirical {
    label en official "the stock was acquired through the exercise of the stock rights; the fair market value of the rights at their distribution";
}
pub relation rights_distribution_date_306d2(right: Asset, on: Date) kind empirical {
    label en official "the date of the distribution of the stock rights";
}
pub relation stock_treated_distributed_306d2(stock: Asset, on: Date, amount: Money) kind institutional {
    label en official "the stock is treated as distributed at the time of the rights distribution, to the extent of the fair market value of the rights then (section 306(d)(2))";
}
@source(IRC_S306_D, quote = "(2) stock acquired through the exercise of stock rights shall be treated as stock distributed at the time of the distribution of the stock rights, to the extent of the fair market value of such rights at the time of the distribution.")
rule Section306d2Rule(stock: Asset, right: Asset, fmv: Money, on: Date) strict {
    label en official "section 306(d)(2)";
    when stock_acquired_by_exercise_of_rights_306d2(stock, right, fmv);
    when rights_distribution_date_306d2(right, on);
    then stock_treated_distributed_306d2(stock, on, fmv);
}
pub relation section_306_stock_exchanged_for_common_306e1(new_stock: Asset, old_stock: Asset) kind empirical {
    label en official "section 306 stock issued with respect to common stock is later exchanged for common stock in the same corporation (conversion privilege or not); 'new_stock' is the common stock received";
}
pub relation common_stock_with_conversion_privilege_306e2(stock: Asset) kind empirical {
    label en official "the common stock has a privilege of converting into stock other than common stock (or into property), whether or not the privilege is in the stock itself";
}
pub relation section_306_taint_removed_306e1(stock: Asset) kind institutional {
    label en official "the common stock received in the exchange is not section 306 stock (section 306(e)(1)), except as provided in paragraph (2)";
}
@source(IRC_S306_E, quote = "then (except as provided in paragraph (2)) the common stock so received shall not be treated as section 306 stock; and")
rule Section306e1Rule(new_stock: Asset, old_stock: Asset) strict {
    label en official "section 306(e)(1): unless the received stock has a conversion privilege ((e)(2))";
    when section_306_stock_exchanged_for_common_306e1(new_stock, old_stock);
    when not_known(common_stock_with_conversion_privilege_306e2(new_stock));
    then section_306_taint_removed_306e1(new_stock);
}
pub relation not_treated_as_common_stock_306e2(stock: Asset) kind institutional {
    label en official "the common stock with a conversion privilege is not treated as common stock (section 306(e)(2))";
}
@source(IRC_S306_E, quote = "shall not be treated as common stock.")
rule Section306e2Rule(stock: Asset) strict {
    label en official "section 306(e)(2)";
    when common_stock_with_conversion_privilege_306e2(stock);
    then not_treated_as_common_stock_306e2(stock);
}
pub relation convertible_common_distributed_excluded_under_305a_306e2(stock: Asset) kind empirical {
    label en official "common stock with a conversion privilege was distributed and, by reason of section 305(a), part of the distribution was not includible in the shareholder's gross income";
}
@source(IRC_S306_E, quote = "shall not be treated as common stock.")
rule Section306StockFromConvertibleCommonRule(stock: Asset) defeasible {
    label en official "section 306(e)(2) with (c)(1)(A): convertible common stock is not 'common stock', so its 305(a) distribution makes it section 306 stock unless the (c)(2) exception applies";
    when convertible_common_distributed_excluded_under_305a_306e2(stock);
    when common_stock_with_conversion_privilege_306e2(stock);
    when not_known(no_earnings_and_profits_exception_306c2(stock));
    then section_306_stock(stock);
}
pub relation dividend_source_us_if_money_306f(d: Section306StockDisposition) kind empirical {
    label en official "if money had been received from the corporation as a dividend at the time of the distribution of the stock, the amount would be derived from sources within the United States";
}
pub relation section_306a1a_income_us_source_306f(d: Section306StockDisposition, shareholder: Person, amount: Money) kind institutional {
    label en official "the section 306(a)(1)(A) ordinary income has the source a dividend would have (section 306(f), first sentence): United States source";
}
@source(IRC_S306_F, quote = "be treated as derived from the same source as would have been the source if money had been received from the corporation as a dividend at the time of the distribution of such stock.")
rule Section306fSourceRule(d: Section306StockDisposition, shareholder: Person, amount: Money) strict {
    label en official "section 306(f): United States source when the dividend would be";
    when section_306a1a_ordinary_income(d, shareholder, amount);
    when dividend_source_us_if_money_306f(d);
    then section_306a1a_income_us_source_306f(d, shareholder, amount);
}
pub relation section_306a1a_income_fdap_871a_881a_306f(d: Section306StockDisposition, shareholder: Person, amount: Money) kind institutional {
    label en official "a United States source amount is fixed or determinable annual or periodical gains, profits and income within section 871(a) or 881(a) (section 306(f), second sentence)";
}
@source(IRC_S306_F, quote = "such amount shall be considered to be fixed or determinable annual or periodical gains, profits, and income within the meaning of section 871(a) or section 881(a), as the case may be.")
rule Section306fFdapRule(d: Section306StockDisposition, shareholder: Person, amount: Money) strict {
    label en official "section 306(f), second sentence";
    when section_306a1a_income_us_source_306f(d, shareholder, amount);
    then section_306a1a_income_fdap_871a_881a_306f(d, shareholder, amount);
}
pub relation substantial_change_in_terms_306g(stock: Asset) kind empirical {
    label en official "a substantial change is made in the terms and conditions of the stock";
}
pub relation fair_market_value_at_distribution_306g(stock: Asset, amount: Money) kind empirical {
    label en official "the fair market value of the stock at the time of the distribution";
}
pub relation fair_market_value_at_change_306g(stock: Asset, amount: Money) kind empirical {
    label en official "the fair market value of the stock at the time of the change";
}
pub relation fair_market_value_for_306_306g1(stock: Asset, amount: Money) kind institutional {
    label en official "the higher of the two values (section 306(g)(1))";
}
@source(IRC_S306_G, quote = "(1) the fair market value of such stock shall be the fair market value at the time of the distribution or at the time of such change, whichever such value is higher;")
rule Section306g1AtDistributionRule(stock: Asset, at_dist: Money, at_change: Money) strict {
    label en official "section 306(g)(1): the distribution value when it is at least the change value";
    when substantial_change_in_terms_306g(stock);
    when fair_market_value_at_distribution_306g(stock, at_dist);
    when fair_market_value_at_change_306g(stock, at_change);
    when at_dist >= at_change;
    then fair_market_value_for_306_306g1(stock, at_dist);
}
@source(IRC_S306_G, quote = "(1) the fair market value of such stock shall be the fair market value at the time of the distribution or at the time of such change, whichever such value is higher;")
rule Section306g1AtChangeRule(stock: Asset, at_dist: Money, at_change: Money) strict {
    label en official "section 306(g)(1): the change value when it is higher";
    when substantial_change_in_terms_306g(stock);
    when fair_market_value_at_distribution_306g(stock, at_dist);
    when fair_market_value_at_change_306g(stock, at_change);
    when at_change > at_dist;
    then fair_market_value_for_306_306g1(stock, at_change);
}
pub relation ratable_share_at_distribution_306g(stock: Asset, amount: Money) kind empirical {
    label en official "the stock's ratable share of the amount that would have been a dividend, determined at the time of the distribution";
}
pub relation ratable_share_at_change_306g(stock: Asset, amount: Money) kind empirical {
    label en official "the stock's ratable share of the amount that would have been a dividend, determined at the time of the change";
}
pub relation ratable_share_for_306_306g2(stock: Asset, amount: Money) kind institutional {
    label en official "the higher of the two ratable shares (section 306(g)(2))";
}
@source(IRC_S306_G, quote = "(2) such stock's ratable share of the amount which would have been a dividend if money had been distributed in lieu of stock shall be determined as of the time of distribution or as of the time of such change, whichever such ratable share is higher; and")
rule Section306g2AtDistributionRule(stock: Asset, at_dist: Money, at_change: Money) strict {
    label en official "section 306(g)(2): the distribution share when it is at least the change share";
    when substantial_change_in_terms_306g(stock);
    when ratable_share_at_distribution_306g(stock, at_dist);
    when ratable_share_at_change_306g(stock, at_change);
    when at_dist >= at_change;
    then ratable_share_for_306_306g2(stock, at_dist);
}
@source(IRC_S306_G, quote = "(2) such stock's ratable share of the amount which would have been a dividend if money had been distributed in lieu of stock shall be determined as of the time of distribution or as of the time of such change, whichever such ratable share is higher; and")
rule Section306g2AtChangeRule(stock: Asset, at_dist: Money, at_change: Money) strict {
    label en official "section 306(g)(2): the change share when it is higher";
    when substantial_change_in_terms_306g(stock);
    when ratable_share_at_distribution_306g(stock, at_dist);
    when ratable_share_at_change_306g(stock, at_change);
    when at_change > at_dist;
    then ratable_share_for_306_306g2(stock, at_change);
}
pub relation no_earnings_and_profits_at_distribution_306g3(stock: Asset) kind empirical {
    label en official "the stock meets the section 306(c)(2) requirements at the time of the distribution";
}
pub relation no_earnings_and_profits_at_change_306g3(stock: Asset) kind empirical {
    label en official "the stock meets the section 306(c)(2) requirements at the time of the change";
}
pub relation section_306c2_exception_holds_both_times_306g3(stock: Asset) kind institutional {
    label en official "the section 306(c)(2) exception applies to stock whose terms were substantially changed only if it holds at both times (section 306(g)(3))";
}
@source(IRC_S306_G, quote = "(3) subsection (c)(2) shall not apply unless the stock meets the requirements of such subsection both at the time of such distribution and at the time of such change.")
rule Section306g3Rule(stock: Asset) strict {
    label en official "section 306(g)(3)";
    when substantial_change_in_terms_306g(stock);
    when no_earnings_and_profits_at_distribution_306g3(stock);
    when no_earnings_and_profits_at_change_306g3(stock);
    then section_306c2_exception_holds_both_times_306g3(stock);
}
@source(IRC_S306_G, quote = "(3) subsection (c)(2) shall not apply unless the stock meets the requirements of such subsection both at the time of such distribution and at the time of such change.")
rule Section306StockAfterSubstantialChangeRule(stock: Asset) defeasible {
    label en official "section 306(g)(3) with (c)(1)(A): a substantially changed stock is section 306 stock unless the (c)(2) exception holds at both times";
    when stock_distributed_excluded_under_305a_306c1a(stock);
    when substantial_change_in_terms_306g(stock);
    when not_known(section_306c2_exception_holds_both_times_306g3(stock));
    then section_306_stock(stock);
}
