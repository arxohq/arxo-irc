// Sections 346(a) (a series of redemptions of all the stock is a complete
// liquidation) and 361 (nonrecognition to the corporation that is a party to
// a reorganization). Stage 3 (26.09.2026, A06). Reads module 10's
// `ReorganizationTransaction` / `party_to_a_reorganization`, module 02's
// `DistributionEvent` and module 07's liability vocabulary.
//
// METHOD. Section 361 has three layers, modelled as three families of rules:
// (a) no gain or loss to a corporation party to a reorganization that
// exchanges property, in pursuance of the plan, SOLELY for stock or
// securities of another party; (b) an exchange that is not solely in kind:
// (b)(1) gain is recognized only on the "other property or money" that is
// NOT distributed in pursuance of the plan, and never beyond that amount;
// (b)(2) no loss is ever recognized; (b)(3) a transfer to creditors counts as
// a distribution (with the sentence-three cap for a type D reorganization
// followed by a section 355 distribution); (c) distributions to shareholders:
// (c)(1) no gain or loss, (c)(2) except gain on appreciated property that is
// not "qualified property", with the (c)(2)(C) liability floor on fair market
// value, (c)(3) transfers of qualified property to creditors are
// distributions, (c)(4) sections 311 and 336-337 do not apply to such a
// distribution.
//
// MONEY. Every amount is exact `Money` (a section 361(b)(3) transfer to
// creditors is asserted as `0.00 USD` when there is none: an absent amount
// leaves the distributed total, and with it the recognized gain, unknown); no rounding is applied because the
// statute names none and every operation is addition, subtraction or
// comparison. A missing liability is NOT zero: as in section 301(b)(2), a
// case asserts `0.00 USD` when the property carries no liability.
//
// DEONTICS. Section 361 sets no duty, prohibition, power or liberty: it is a
// classification of a transferor/distributing corporation's recognition
// (nonrecognition, capped recognition), an institutional-effect layer the
// coverage rows record as `classification`/`calculation`. The regulation
// authorisations (the (b)(3) second sentence) are EXTERNAL_DEPENDENCY.
//
// Every rule that reads a derived relation is `defeasible` (a `strict` rule
// may read only empirical facts, LDC-E4103).

// --- Section 346(a): a series of redemptions of all the stock ---------------

use self::{
    Asset,
    Corporation,
    DistributionEvent,
    IRC_S346_A,
    IRC_S361_A,
    IRC_S361_B,
    IRC_S361_C,
    ReorganizationTransaction,
    party_to_a_reorganization,
};

@source(IRC_S346_A, quote = "a distribution shall be treated as in complete liquidation of a corporation if the distribution is one of a series of distributions in redemption of all of the stock of the corporation pursuant to a plan.")
pub relation distribution_is_one_of_series_in_redemption_346a(d: DistributionEvent, corp: Corporation) kind empirical {
    label en official "the distribution is one of a series of distributions in redemption of the stock of the corporation";
}
pub relation series_redeems_all_stock_of_corporation_pursuant_to_plan_346a(d: DistributionEvent, corp: Corporation) kind empirical {
    label en official "the series of distributions redeems ALL of the stock of the corporation and is made pursuant to a plan";
}
pub relation distribution_treated_as_in_complete_liquidation_346a(d: DistributionEvent, corp: Corporation) kind institutional {
    label en official "for purposes of subchapter C, the distribution is treated as in complete liquidation of the corporation (section 346(a))";
}
@source(IRC_S346_A, quote = "a distribution shall be treated as in complete liquidation of a corporation if the distribution is one of a series of distributions in redemption of all of the stock of the corporation pursuant to a plan.")
rule Section346aSeriesOfRedemptionsIsCompleteLiquidationRule(d: DistributionEvent, corp: Corporation) strict {
    label en official "section 346(a): a distribution that is one of a plan-based series redeeming all the stock of the corporation is treated as in complete liquidation";
    when distribution_is_one_of_series_in_redemption_346a(d, corp);
    when series_redeems_all_stock_of_corporation_pursuant_to_plan_346a(d, corp);
    then distribution_treated_as_in_complete_liquidation_346a(d, corp);
}
// JUDGMENT CALL: module 06's `Liquidation` entity (section 331/332) is a
// different object from module 02's `DistributionEvent`; this rule concludes
// the section 346(a) status on the distribution and does NOT fabricate a
// `Liquidation` from it (an empirical relation cannot be concluded by a
// rule). A consumer that wants section 331 treatment for such a distribution
// asserts the `liquidating_distribution` fact, guided by this conclusion.

// --- Section 361(a): nonrecognition, solely stock or securities -------------

pub entity ReorganizationPropertyExchange { label en unofficial "a corporation's exchange of property, in pursuance of the plan of reorganization, for consideration from another corporation, tested against section 361"; }

pub relation corporation_exchanges_property_in_pursuance_of_plan_361(x: ReorganizationPropertyExchange, r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) kind empirical {
    label en official "the transferor corporation exchanges property, in pursuance of the plan of reorganization, with the other corporation (section 361(a))";
}
pub relation property_received_solely_stock_or_securities_361a(x: ReorganizationPropertyExchange) kind empirical {
    label en official "the property received in the exchange consists solely of stock or securities in another corporation a party to the reorganization";
}
pub relation property_received_includes_other_property_or_money_361b(x: ReorganizationPropertyExchange) kind empirical {
    label en official "the property received consists not only of stock or securities permitted by section 361(a) but also of other property or money";
}
pub relation exchange_between_parties_to_reorganization_361(x: ReorganizationPropertyExchange, transferor: Corporation) kind institutional {
    label en unofficial "both corporations of the exchange are parties to the named reorganization (helper for section 361(a)-(b))";
}
rule ExchangeBetweenPartiesToReorganizationRule(x: ReorganizationPropertyExchange, r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) defeasible {
    label en unofficial "helper: transferor and transferee are both parties to the reorganization";
    when corporation_exchanges_property_in_pursuance_of_plan_361(x, r, transferor, transferee);
    when party_to_a_reorganization(r, transferor);
    when party_to_a_reorganization(r, transferee);
    then exchange_between_parties_to_reorganization_361(x, transferor);
}
pub relation no_gain_or_loss_recognized_to_corporation_361a(x: ReorganizationPropertyExchange, transferor: Corporation) kind institutional {
    label en official "no gain or loss is recognized to the corporation on the exchange (section 361(a))";
}
@source(IRC_S361_A, quote = "No gain or loss shall be recognized to a corporation if such corporation is a party to a reorganization and exchanges property, in pursuance of the plan of reorganization, solely for stock or securities in another corporation a party to the reorganization.")
rule Section361aNonrecognitionRule(x: ReorganizationPropertyExchange, transferor: Corporation) defeasible {
    label en official "section 361(a): no gain or loss to a corporation party to a reorganization that exchanges property, under the plan, solely for stock or securities of another party";
    when exchange_between_parties_to_reorganization_361(x, transferor);
    when property_received_solely_stock_or_securities_361a(x);
    then no_gain_or_loss_recognized_to_corporation_361a(x, transferor);
}

// --- Section 361(b)(3): transfers to creditors ------------------------------

@source(IRC_S361_B, quote = "the property received in exchange consists not only of stock or securities permitted by subsection (a) to be received without the recognition of gain, but also of other property or money")
pub relation other_property_or_money_received_361b(x: ReorganizationPropertyExchange, amount: Money) kind empirical {
    label en official "the sum of the money and the fair market value of the other property received in the exchange (section 361(b)(1))";
}
pub relation other_property_or_money_distributed_to_shareholders_361b1(x: ReorganizationPropertyExchange, amount: Money) kind empirical {
    label en official "the part of the other property or money that the corporation distributes in pursuance of the plan of reorganization (section 361(b)(1)(A))";
}
pub relation other_property_or_money_transferred_to_creditors_361b3(x: ReorganizationPropertyExchange, amount: Money) kind empirical {
    label en official "the part of the other property or money transferred to the corporation's creditors in connection with the reorganization (section 361(b)(3))";
}
@source(IRC_S361_B, quote = "In the case of a reorganization described in section 368(a)(1)(D) with respect to which stock or securities of the corporation to which the assets are transferred are distributed in a transaction which qualifies under section 355")
pub relation type_d_reorganization_followed_by_section_355_distribution_361b3(x: ReorganizationPropertyExchange) kind empirical {
    label en official "the exchange is in a section 368(a)(1)(D) reorganization in which the transferee's stock or securities are distributed in a transaction qualifying under section 355";
}
@source(IRC_S361_B, quote = "the adjusted bases of such assets transferred (reduced by the amount of the liabilities assumed (within the meaning of section 357(c)))")
pub relation adjusted_basis_of_transferred_assets_net_of_357c_liabilities_361b3(x: ReorganizationPropertyExchange, amount: Money) kind empirical {
    label en official "the adjusted bases of the assets transferred, reduced by the liabilities assumed within the meaning of section 357(c) — the third-sentence ceiling of section 361(b)(3)";
}

pub relation creditor_transfers_counted_as_distribution_361b3(x: ReorganizationPropertyExchange, amount: Money) kind institutional {
    label en official "the amount of transfers to creditors that is treated as a distribution in pursuance of the plan (section 361(b)(3)); in a type D plus section 355 case only up to the adjusted-basis ceiling";
}
@source(IRC_S361_B, quote = "any transfer of the other property or money received in the exchange by the corporation to its creditors in connection with the reorganization shall be treated as a distribution in pursuance of the plan of reorganization.")
rule Section361b3CreditorTransfersCountedInFullRule(x: ReorganizationPropertyExchange, to_creditors: Money) defeasible {
    label en official "section 361(b)(3) first sentence: a transfer to creditors is a distribution in pursuance of the plan (outside the type D plus section 355 case the whole amount counts)";
    when other_property_or_money_transferred_to_creditors_361b3(x, to_creditors);
    when not_known(type_d_reorganization_followed_by_section_355_distribution_361b3(x));
    then creditor_transfers_counted_as_distribution_361b3(x, to_creditors);
}
@source(IRC_S361_B, quote = "this paragraph shall apply only to the extent that the sum of the money and the fair market value of other property transferred to such creditors does not exceed the adjusted bases of such assets transferred")
rule Section361b3TypeDBelowCeilingRule(x: ReorganizationPropertyExchange, to_creditors: Money, ceiling: Money) defeasible {
    label en official "section 361(b)(3) third sentence: in a type D plus section 355 case the whole transfer counts while it does not exceed the net adjusted-basis ceiling";
    when other_property_or_money_transferred_to_creditors_361b3(x, to_creditors);
    when type_d_reorganization_followed_by_section_355_distribution_361b3(x);
    when adjusted_basis_of_transferred_assets_net_of_357c_liabilities_361b3(x, ceiling);
    when ceiling > 0.00 USD;
    when to_creditors <= ceiling;
    then creditor_transfers_counted_as_distribution_361b3(x, to_creditors);
}
@source(IRC_S361_B, quote = "this paragraph shall apply only to the extent that the sum of the money and the fair market value of other property transferred to such creditors does not exceed the adjusted bases of such assets transferred")
rule Section361b3TypeDAboveCeilingRule(x: ReorganizationPropertyExchange, to_creditors: Money, ceiling: Money) defeasible {
    label en official "section 361(b)(3) third sentence: in a type D plus section 355 case only the net adjusted-basis ceiling counts when the transfers exceed it";
    when other_property_or_money_transferred_to_creditors_361b3(x, to_creditors);
    when type_d_reorganization_followed_by_section_355_distribution_361b3(x);
    when adjusted_basis_of_transferred_assets_net_of_357c_liabilities_361b3(x, ceiling);
    when ceiling > 0.00 USD;
    when to_creditors > ceiling;
    then creditor_transfers_counted_as_distribution_361b3(x, ceiling);
}
@source(IRC_S361_B, quote = "this paragraph shall apply only to the extent that the sum of the money and the fair market value of other property transferred to such creditors does not exceed the adjusted bases of such assets transferred")
rule Section361b3TypeDNoCeilingRoomRule(x: ReorganizationPropertyExchange, ceiling: Money) defeasible {
    label en official "section 361(b)(3) third sentence: a zero (or negative) net adjusted-basis ceiling leaves no room, so no transfer to creditors counts";
    when type_d_reorganization_followed_by_section_355_distribution_361b3(x);
    when adjusted_basis_of_transferred_assets_net_of_357c_liabilities_361b3(x, ceiling);
    when ceiling <= 0.00 USD;
    then creditor_transfers_counted_as_distribution_361b3(x, 0.00 USD);
}

// --- Section 361(b)(1): gain recognized only on the undistributed boot ------

pub relation other_property_or_money_distributed_in_pursuance_of_plan_361b1(x: ReorganizationPropertyExchange, amount: Money) kind institutional {
    label en official "the other property or money distributed in pursuance of the plan: distributions to shareholders plus the transfers to creditors that section 361(b)(3) treats as distributions";
}
rule Section361b1DistributedTotalRule(x: ReorganizationPropertyExchange, to_shareholders: Money, counted: Money) defeasible {
    label en official "section 361(b)(1) with (b)(3): distributed total = distributions to shareholders + the counted transfers to creditors";
    when other_property_or_money_distributed_to_shareholders_361b1(x, to_shareholders);
    when creditor_transfers_counted_as_distribution_361b3(x, counted);
    then other_property_or_money_distributed_in_pursuance_of_plan_361b1(x, to_shareholders + counted);
}
pub relation other_property_or_money_not_distributed_361b1(x: ReorganizationPropertyExchange, amount: Money) kind institutional {
    label en official "the money and fair market value of the other property received that is not distributed in pursuance of the plan (the ceiling of section 361(b)(1) last sentence)";
}
@source(IRC_S361_B, quote = "The amount of gain recognized under subparagraph (B) shall not exceed the sum of the money and the fair market value of the other property so received which is not so distributed.")
rule Section361b1UndistributedRule(x: ReorganizationPropertyExchange, received: Money, distributed: Money) defeasible {
    label en official "section 361(b)(1)(B): the undistributed part of the other property or money is the amount received less the amount distributed";
    when other_property_or_money_received_361b(x, received);
    when other_property_or_money_distributed_in_pursuance_of_plan_361b1(x, distributed);
    when received >= distributed;
    then other_property_or_money_not_distributed_361b1(x, received - distributed);
}
@source(IRC_S361_B, quote = "The amount of gain recognized under subparagraph (B) shall not exceed the sum of the money and the fair market value of the other property so received which is not so distributed.")
rule Section361b1UndistributedFloorRule(x: ReorganizationPropertyExchange, received: Money, distributed: Money) defeasible {
    label en official "section 361(b)(1)(B): distributions cannot exceed the amount received, so the undistributed part floors at zero";
    when other_property_or_money_received_361b(x, received);
    when other_property_or_money_distributed_in_pursuance_of_plan_361b1(x, distributed);
    when distributed > received;
    then other_property_or_money_not_distributed_361b1(x, 0.00 USD);
}

pub relation realized_gain_or_loss_on_exchange_361b(x: ReorganizationPropertyExchange, amount: Money) kind empirical {
    label en official "the gain (positive) or loss (negative) the corporation realizes on the exchange, before section 361(b)";
}
pub relation section_361b_exchange_not_solely_in_kind(x: ReorganizationPropertyExchange, transferor: Corporation) kind institutional {
    label en official "the exchange would qualify under section 361(a) but for the receipt of other property or money (section 361(b)(1)-(2) applies)";
}
@source(IRC_S361_B, quote = "If subsection (a) would apply to an exchange but for the fact that the property received in exchange consists not only of stock or securities permitted by subsection (a) to be received without the recognition of gain, but also of other property or money, then—")
rule Section361bExchangeNotSolelyInKindRule(x: ReorganizationPropertyExchange, transferor: Corporation) defeasible {
    label en official "section 361(b): the exchange is between parties to the reorganization and includes other property or money";
    when exchange_between_parties_to_reorganization_361(x, transferor);
    when property_received_includes_other_property_or_money_361b(x);
    then section_361b_exchange_not_solely_in_kind(x, transferor);
}
pub relation gain_recognized_to_corporation_361b1(x: ReorganizationPropertyExchange, transferor: Corporation, amount: Money) kind institutional {
    label en official "the gain recognized to the corporation on an exchange not solely in kind: the realized gain, never more than the undistributed other property or money (section 361(b)(1)(B))";
}
@source(IRC_S361_B, quote = "If the corporation receiving such other property or money does not distribute it in pursuance of the plan of reorganization, the gain, if any, to the corporation shall be recognized.")
rule Section361b1GainBelowCeilingRule(x: ReorganizationPropertyExchange, transferor: Corporation, gain: Money, undistributed: Money) defeasible {
    label en official "section 361(b)(1)(B): a realized gain not above the undistributed other property or money is recognized in full";
    when section_361b_exchange_not_solely_in_kind(x, transferor);
    when realized_gain_or_loss_on_exchange_361b(x, gain);
    when other_property_or_money_not_distributed_361b1(x, undistributed);
    when gain > 0.00 USD;
    when gain <= undistributed;
    then gain_recognized_to_corporation_361b1(x, transferor, gain);
}
@source(IRC_S361_B, quote = "The amount of gain recognized under subparagraph (B) shall not exceed the sum of the money and the fair market value of the other property so received which is not so distributed.")
rule Section361b1GainCappedAtUndistributedRule(x: ReorganizationPropertyExchange, transferor: Corporation, gain: Money, undistributed: Money) defeasible {
    label en official "section 361(b)(1) last sentence: a realized gain above the undistributed other property or money is recognized only up to that amount (a fully distributed boot leaves zero)";
    when section_361b_exchange_not_solely_in_kind(x, transferor);
    when realized_gain_or_loss_on_exchange_361b(x, gain);
    when other_property_or_money_not_distributed_361b1(x, undistributed);
    when gain > undistributed;
    then gain_recognized_to_corporation_361b1(x, transferor, undistributed);
}
@source(IRC_S361_B, quote = "the gain, if any, to the corporation shall be recognized.")
rule Section361b1NoGainRealizedRule(x: ReorganizationPropertyExchange, transferor: Corporation, loss: Money) defeasible {
    label en official "section 361(b)(1): a realized loss (or no gain) recognizes no gain";
    when section_361b_exchange_not_solely_in_kind(x, transferor);
    when realized_gain_or_loss_on_exchange_361b(x, loss);
    when loss <= 0.00 USD;
    then gain_recognized_to_corporation_361b1(x, transferor, 0.00 USD);
}

pub relation loss_not_recognized_to_corporation_361b2(x: ReorganizationPropertyExchange, transferor: Corporation) kind institutional {
    label en official "no loss from the exchange is recognized to the corporation (section 361(b)(2))";
}
@source(IRC_S361_B, quote = "then no loss from the exchange shall be recognized.")
rule Section361b2NoLossRule(x: ReorganizationPropertyExchange, transferor: Corporation) defeasible {
    label en official "section 361(b)(2): no loss is recognized on an exchange that includes other property or money";
    when section_361b_exchange_not_solely_in_kind(x, transferor);
    then loss_not_recognized_to_corporation_361b2(x, transferor);
}

// --- Section 361(c): distributions to shareholders --------------------------

pub entity PlanDistribution { label en unofficial "a distribution of property by a corporation, in pursuance of the plan of reorganization, to its shareholders or (section 361(c)(3)) to its creditors"; }

pub relation property_distributed_to_shareholders_in_pursuance_of_plan_361c1(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset) kind empirical {
    label en official "the corporation, a party to the reorganization, distributes the property to its shareholders in pursuance of the plan (section 361(c)(1))";
}
pub relation property_transferred_to_creditors_in_connection_with_reorganization_361c3(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset) kind empirical {
    label en official "the corporation transfers the property to its creditors in connection with the reorganization (section 361(c)(3))";
}
pub relation fair_market_value_of_distributed_property_361c(d: PlanDistribution, a: Asset, amount: Money) kind empirical {
    label en official "the fair market value of the distributed property";
}
pub relation adjusted_basis_of_distributed_property_361c2a(d: PlanDistribution, a: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the property in the hands of the distributing corporation (section 361(c)(2)(A)(ii))";
}
pub relation liability_on_distributed_property_361c2c(d: PlanDistribution, a: Asset, amount: Money) kind empirical {
    label en official "the liability to which the distributed property is subject, or which the shareholder assumes in connection with the distribution (0.00 USD when there is none, section 361(c)(2)(C))";
}
@source(IRC_S361_C, quote = "any stock in (or right to acquire stock in) the distributing corporation or obligation of the distributing corporation, or")
pub relation distributed_property_is_stock_right_or_obligation_of_distributing_corporation_361c2b(d: PlanDistribution, a: Asset) kind empirical {
    label en official "the property is stock in (or a right to acquire stock in) the distributing corporation, or an obligation of the distributing corporation";
}
@source(IRC_S361_C, quote = "if such stock (or right) or obligation is received by the distributing corporation in the exchange.")
pub relation distributed_property_is_stock_right_or_obligation_of_other_party_received_in_exchange_361c2b(d: PlanDistribution, a: Asset) kind empirical {
    label en official "the property is stock (or a right to acquire stock) or an obligation of another corporation a party to the reorganization, received by the distributing corporation in the exchange";
}
pub relation qualified_property_361c2b(d: PlanDistribution, a: Asset) kind institutional {
    label en official "the property is qualified property within the meaning of section 361(c)(2)(B)";
}
@source(IRC_S361_C, quote = "any stock in (or right to acquire stock in) the distributing corporation or obligation of the distributing corporation, or")
rule Section361c2bQualifiedFromOwnStockOrObligationRule(d: PlanDistribution, a: Asset) strict {
    label en official "section 361(c)(2)(B)(i): the distributing corporation's own stock, right to acquire stock, or obligation is qualified property";
    when distributed_property_is_stock_right_or_obligation_of_distributing_corporation_361c2b(d, a);
    then qualified_property_361c2b(d, a);
}
@source(IRC_S361_C, quote = "if such stock (or right) or obligation is received by the distributing corporation in the exchange.")
rule Section361c2bQualifiedFromOtherPartyRule(d: PlanDistribution, a: Asset) strict {
    label en official "section 361(c)(2)(B)(ii): stock, right or obligation of another party to the reorganization, received in the exchange, is qualified property";
    when distributed_property_is_stock_right_or_obligation_of_other_party_received_in_exchange_361c2b(d, a);
    then qualified_property_361c2b(d, a);
}

pub relation distribution_treated_as_to_shareholders_361c(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset) kind institutional {
    label en official "the transfer is a distribution to shareholders in pursuance of the plan of reorganization within section 361(c)(1): a direct distribution, or (section 361(c)(3)) a transfer of qualified property to creditors";
}
@source(IRC_S361_C, quote = "no gain or loss shall be recognized to a corporation a party to a reorganization on the distribution to its shareholders of property in pursuance of the plan of reorganization.")
rule Section361c1DirectDistributionRule(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset) defeasible {
    label en official "section 361(c)(1): a distribution to shareholders by a party to the reorganization, in pursuance of the plan";
    when property_distributed_to_shareholders_in_pursuance_of_plan_361c1(d, r, corp, a);
    when party_to_a_reorganization(r, corp);
    then distribution_treated_as_to_shareholders_361c(d, r, corp, a);
}
@source(IRC_S361_C, quote = "For purposes of this subsection, any transfer of qualified property by the corporation to its creditors in connection with the reorganization shall be treated as a distribution to its shareholders pursuant to the plan of reorganization.")
rule Section361c3CreditorTransferOfQualifiedPropertyRule(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset) defeasible {
    label en official "section 361(c)(3): a transfer of QUALIFIED property to creditors in connection with the reorganization is a distribution to shareholders (other property transferred to creditors is not)";
    when property_transferred_to_creditors_in_connection_with_reorganization_361c3(d, r, corp, a);
    when party_to_a_reorganization(r, corp);
    when qualified_property_361c2b(d, a);
    then distribution_treated_as_to_shareholders_361c(d, r, corp, a);
}

pub relation fair_market_value_for_361c2a(d: PlanDistribution, a: Asset, amount: Money) kind institutional {
    label en official "the fair market value used for section 361(c)(2)(A): treated as not less than the liability the property is subject to or the shareholder assumes (section 361(c)(2)(C))";
}
@source(IRC_S361_C, quote = "the fair market value of such property shall be treated as not less than the amount of such liability.")
rule Section361c2cFmvAtLeastLiabilityRule(d: PlanDistribution, a: Asset, fmv: Money, liability: Money) strict {
    label en official "section 361(c)(2)(C): fair market value stands when it is not below the liability";
    when fair_market_value_of_distributed_property_361c(d, a, fmv);
    when liability_on_distributed_property_361c2c(d, a, liability);
    when fmv >= liability;
    then fair_market_value_for_361c2a(d, a, fmv);
}
@source(IRC_S361_C, quote = "the fair market value of such property shall be treated as not less than the amount of such liability.")
rule Section361c2cFmvRaisedToLiabilityRule(d: PlanDistribution, a: Asset, fmv: Money, liability: Money) strict {
    label en official "section 361(c)(2)(C): fair market value is treated as the liability when it is below the liability";
    when fair_market_value_of_distributed_property_361c(d, a, fmv);
    when liability_on_distributed_property_361c2c(d, a, liability);
    when fmv < liability;
    then fair_market_value_for_361c2a(d, a, liability);
}

pub relation section_361c2a_gain_applies(d: PlanDistribution, a: Asset) kind institutional {
    label en official "the distributed property is not qualified property and its (liability-floored) fair market value exceeds its adjusted basis, so gain is recognized as on a sale (section 361(c)(2)(A))";
}
@source(IRC_S361_C, quote = "then gain shall be recognized to the distributing corporation as if such property were sold to the distributee at its fair market value.")
rule Section361c2aGainAppliesRule(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset, fmv: Money, basis: Money) defeasible {
    label en official "section 361(c)(2)(A): a distribution of appreciated property other than qualified property triggers gain";
    when distribution_treated_as_to_shareholders_361c(d, r, corp, a);
    when not_known(qualified_property_361c2b(d, a));
    when fair_market_value_for_361c2a(d, a, fmv);
    when adjusted_basis_of_distributed_property_361c2a(d, a, basis);
    when fmv > basis;
    then section_361c2a_gain_applies(d, a);
}
pub relation gain_recognized_on_distribution_361c2a(d: PlanDistribution, a: Asset, amount: Money) kind institutional {
    label en official "the gain recognized to the distributing corporation as if the property were sold to the distributee at fair market value: liability-floored fair market value less adjusted basis (section 361(c)(2)(A))";
}
@source(IRC_S361_C, quote = "then gain shall be recognized to the distributing corporation as if such property were sold to the distributee at its fair market value.")
rule Section361c2aGainAmountRule(d: PlanDistribution, a: Asset, fmv: Money, basis: Money) defeasible {
    label en official "section 361(c)(2)(A): gain = fair market value (floored at the liability) less adjusted basis";
    when section_361c2a_gain_applies(d, a);
    when fair_market_value_for_361c2a(d, a, fmv);
    when adjusted_basis_of_distributed_property_361c2a(d, a, basis);
    then gain_recognized_on_distribution_361c2a(d, a, fmv - basis);
}
pub relation no_gain_or_loss_recognized_on_distribution_361c1(d: PlanDistribution, corp: Corporation, a: Asset) kind institutional {
    label en official "no gain or loss is recognized to the corporation on the distribution (section 361(c)(1)), except the (c)(2) gain on appreciated non-qualified property; a loss on depreciated property is never recognized";
}
@source(IRC_S361_C, quote = "Except as provided in paragraph (2), no gain or loss shall be recognized to a corporation a party to a reorganization on the distribution to its shareholders of property in pursuance of the plan of reorganization.")
rule Section361c1NonrecognitionRule(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset) defeasible {
    label en official "section 361(c)(1): no gain or loss on a distribution to shareholders in pursuance of the plan unless paragraph (2) recognizes gain";
    when distribution_treated_as_to_shareholders_361c(d, r, corp, a);
    when not_known(section_361c2a_gain_applies(d, a));
    then no_gain_or_loss_recognized_on_distribution_361c1(d, corp, a);
}
pub relation section_311_and_subpart_b_of_part_ii_inapplicable_361c4(d: PlanDistribution, a: Asset) kind institutional {
    label en official "section 311 and subpart B of part II of subchapter C (sections 336-337) do not apply to the distribution (section 361(c)(4))";
}
@source(IRC_S361_C, quote = "Section 311 and subpart B of part II of this subchapter shall not apply to any distribution referred to in paragraph (1).")
rule Section361c4CoordinationRule(d: PlanDistribution, r: ReorganizationTransaction, corp: Corporation, a: Asset) defeasible {
    label en official "section 361(c)(4): sections 311 and 336-337 are displaced for a distribution referred to in paragraph (1)";
    when distribution_treated_as_to_shareholders_361c(d, r, corp, a);
    then section_311_and_subpart_b_of_part_ii_inapplicable_361c4(d, a);
}
// Section 361(c)(4) is a coordination NORM stated on the distribution's
// legal characterization; module 02's section 311 rules read a
// `DistributionEvent`, a different object, so a case that asserts a
// `PlanDistribution` never feeds them (same construction as section 331(b)
// in module 06). The relation above is the visible, testable form.
//
// NOT DONE (coverage rows, TECH-GAPS G3301-G3303): the (b)(3) second
// sentence (regulations to prevent avoidance) and the (c)(5) cross reference
// are classified EXTERNAL_DEPENDENCY / NON_NORMATIVE; the realized gain of
// (b) and the FMV/basis of (c) are case facts, not derived from the
// property-transactions package.
