// Stage 3b (26.09.2026, TECH_GAP reduction). Section 358(b)-(c), (g), (h)
// (basis allocation, section 355 exchange treatment, intragroup basis
// adjustments, basis reduction for liabilities outside (d)(1)) and section
// 362(c)-(e)(2) (contributions to capital, the FMV ceiling on basis
// increases from liability gain, the built-in-loss limitation for section
// 351 transfers with its joint election). Status implemented_unverified:
// nothing here was executed.

// --- Section 358(b): allocation of basis among properties received -------------

use self::{
    Asset,
    ControlledCorporationDistribution,
    ControlledTransfer,
    Corporation,
    IRC_S358_B,
    IRC_S358_C,
    IRC_S358_G,
    IRC_S358_H,
    IRC_S362_C,
    IRC_S362_D,
    IRC_S362_E,
    Person,
    corp_basis_carryover_351,
    net_built_in_loss_importation,
    section_355_nonrecognition,
    substituted_basis_358,
    would_qualify_under_355_but_for_other_property,
};

pub relation basis_allocation_item_358b(t: ControlledTransfer, transferor: Person, item: Asset, amount: Money) kind empirical {
    label en unofficial "the part of the section 358(a)(1) basis that is allocated to one of the properties permitted to be received without recognition (allocation content is prescribed by regulations and is supplied by the case)";
}
pub relation basis_allocation_covers_retained_stock_358b2(t: ControlledTransfer, transferor: Person) kind empirical {
    label en unofficial "in a section 355 exchange the allocation also takes into account the stock of the distributing corporation that was retained (section 358(b)(2))";
}
pub relation section_355_exchange_358b2(t: ControlledTransfer, transferor: Person) kind empirical {
    label en unofficial "the exchange is one to which section 355 (or so much of section 356 as relates to section 355) applies (section 358(b)(2))";
}
pub relation total_basis_allocated_358b1(t: ControlledTransfer, transferor: Person, amount: Money) kind institutional {
    label en unofficial "the sum of the basis allocated among the properties received";
}
@source(IRC_S358_B, quote = "the basis determined under subsection (a)(1) shall be allocated among the properties permitted to be received without the recognition of gain or loss.")
rule Section358b1TotalAllocatedRule(t: ControlledTransfer, transferor: Person) strict {
    label en official "section 358(b)(1): the basis allocated among the properties received is the sum of the per-property allocations";
    when substituted_basis_358(transferor, t, _);
    then total_basis_allocated_358b1(t, transferor, sum all amt: Money for item: Asset where basis_allocation_item_358b(t, transferor, item, amt));
}
pub relation basis_fully_allocated_358b1(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "the whole of the section 358(a)(1) basis has been allocated among the properties permitted to be received (section 358(b)(1))";
}
@source(IRC_S358_B, quote = "the basis determined under subsection (a)(1) shall be allocated among the properties permitted to be received without the recognition of gain or loss.")
rule Section358b1FullyAllocatedRule(t: ControlledTransfer, transferor: Person, basis: Money, allocated: Money) strict {
    label en official "section 358(b)(1): the allocation is complete exactly when the allocated amounts equal the basis determined under (a)(1)";
    when substituted_basis_358(transferor, t, basis);
    when total_basis_allocated_358b1(t, transferor, allocated);
    when allocated == basis;
    then basis_fully_allocated_358b1(t, transferor);
}
@source(IRC_S358_B, quote = "the basis determined under subsection (a)(1) shall be allocated among the properties permitted to be received without the recognition of gain or loss.")
rule Section358b1AllocationDutyRule(t: ControlledTransfer, transferor: Person, basis: Money) defeasible {
    label en official "section 358(b)(1): the basis determined under (a)(1) shall be allocated among the properties received (the duty of the taxpayer whose basis it is)";
    when substituted_basis_358(transferor, t, basis);
    then duty Section358b1AllocateBasisDuty {
        bearer transferor;
        goal achievement {
            condition basis_fully_allocated_358b1(t, transferor);
            window [-infinity, infinity];
        }
    };
}
pub relation allocation_takes_retained_stock_into_account_358b2(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "in a section 355 exchange the allocation under (b)(1) takes into account not only the property received but also the stock of the distributing corporation which is retained (section 358(b)(2))";
}
@source(IRC_S358_B, quote = "there shall be taken into account not only the property so permitted to be received without the recognition of gain or loss, but also the stock or securities (if any) of the distributing corporation which are retained")
rule Section358b2RetainedStockRule(t: ControlledTransfer, transferor: Person) defeasible {
    label en official "section 358(b)(2): in a section 355 exchange the allocation covers the retained stock and securities of the distributing corporation";
    when section_355_exchange_358b2(t, transferor);
    when basis_allocation_covers_retained_stock_358b2(t, transferor);
    then allocation_takes_retained_stock_into_account_358b2(t, transferor);
}

// --- Section 358(c): section 355 transactions which are not exchanges --------

pub relation retained_stock_of_distributing_358c(cd: ControlledCorporationDistribution, stock: Asset) kind empirical {
    label en unofficial "stock or securities of the distributing corporation which are retained by the distributee in the section 355 distribution";
}
pub relation section_355_distribution_treated_as_exchange_358c(cd: ControlledCorporationDistribution) kind institutional {
    label en official "for purposes of section 358 a distribution to which section 355 applies is treated as an exchange (section 358(c))";
}
@source(IRC_S358_C, quote = "a distribution to which section 355 (or so much of section 356 as relates to section 355) applies shall be treated as an exchange")
rule Section358cExchangeFromSection355Rule(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation, holder: Person) defeasible {
    label en official "section 358(c): a distribution to which section 355 applies is an exchange for section 358 purposes";
    when section_355_nonrecognition(cd, distributing, controlled, holder);
    then section_355_distribution_treated_as_exchange_358c(cd);
}
@source(IRC_S358_C, quote = "(or so much of section 356 as relates to section 355)")
rule Section358cExchangeFromSection356Rule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 358(c): so much of section 356 as relates to section 355 (a distribution that would qualify but for other property) is likewise an exchange for section 358 purposes";
    when would_qualify_under_355_but_for_other_property(cd);
    then section_355_distribution_treated_as_exchange_358c(cd);
}
pub relation retained_stock_treated_as_surrendered_and_received_back_358c(cd: ControlledCorporationDistribution, stock: Asset) kind institutional {
    label en official "the retained stock and securities of the distributing corporation are treated as surrendered, and received back, in the exchange (section 358(c))";
}
@source(IRC_S358_C, quote = "the stock and securities of the distributing corporation which are retained shall be treated as surrendered, and received back, in the exchange.")
rule Section358cRetainedStockRule(cd: ControlledCorporationDistribution, stock: Asset) defeasible {
    label en official "section 358(c): retained stock of the distributing corporation is treated as surrendered and received back";
    when section_355_distribution_treated_as_exchange_358c(cd);
    when retained_stock_of_distributing_358c(cd, stock);
    then retained_stock_treated_as_surrendered_and_received_back_358c(cd, stock);
}

// --- Section 358(g): intragroup section 355 adjustments -----------------------

pub relation intragroup_section_355_distribution_358g(cd: ControlledCorporationDistribution) kind empirical {
    label en official "a distribution to which section 355 (or so much of section 356 as relates to section 355) applies, involving the distribution of stock from one member of an affiliated group (section 1504(a) without regard to (b)) to another member";
}
pub relation secretary_provides_intragroup_basis_adjustment_358g(cd: ControlledCorporationDistribution) kind empirical {
    label en unofficial "the Secretary provides adjustments to the adjusted basis of stock in a group member held by another member";
}
pub relation intragroup_basis_adjustment_authorized_358g(cd: ControlledCorporationDistribution) kind institutional {
    label en official "the adjusted basis of stock in a member of the group held by another member is adjusted to appropriately reflect the proper treatment of the distribution (section 358(g))";
}
@source(IRC_S358_G, quote = "the Secretary may, notwithstanding any other provision of this section, provide adjustments to the adjusted basis of any stock")
rule Section358gIntragroupAdjustmentPowerRule strict {
    label en official "section 358(g): the Secretary's power to adjust the basis of intragroup stock after an intragroup section 355 distribution; an exercise outside such a distribution is invalid and has no effect";
    for cd: ControlledCorporationDistribution;
    when secretary_provides_intragroup_basis_adjustment_358g(cd);
    then power Section358gIntragroupBasisAdjustment {
        holder us.irc.core::Secretary;
        over cd;
        exercise secretary_provides_intragroup_basis_adjustment_358g(cd);
        valid_when intragroup_section_355_distribution_358g(cd);
        effect create(intragroup_basis_adjustment_authorized_358g(cd));
        window [-infinity, infinity];
    };
}

// --- Section 358(h): basis reduction for liabilities outside (d)(1) -----------

pub entity AssumedObligation358 { label en unofficial "a fixed or contingent obligation to make payment that another person assumes as part of an exchange (section 358(h)(3))"; }
pub relation obligation_fixed_358h3(l: AssumedObligation358) kind empirical {
    label en official "the obligation is a fixed obligation to make payment (section 358(h)(3))";
}
pub relation obligation_contingent_358h3(l: AssumedObligation358) kind empirical {
    label en official "the obligation is a contingent obligation to make payment (section 358(h)(3))";
}
pub relation liability_358h3(l: AssumedObligation358) kind institutional {
    label en official "for subsection (h) a liability includes any fixed or contingent obligation to make payment, whether or not it is otherwise taken into account under the title (section 358(h)(3))";
}
@source(IRC_S358_H, quote = "the term \"liability\" shall include any fixed or contingent obligation to make payment")
rule Section358h3FixedLiabilityRule(l: AssumedObligation358) strict {
    label en official "section 358(h)(3): a fixed obligation to make payment is a liability";
    when obligation_fixed_358h3(l);
    then liability_358h3(l);
}
@source(IRC_S358_H, quote = "the term \"liability\" shall include any fixed or contingent obligation to make payment")
rule Section358h3ContingentLiabilityRule(l: AssumedObligation358) strict {
    label en official "section 358(h)(3): a contingent obligation to make payment is a liability";
    when obligation_contingent_358h3(l);
    then liability_358h3(l);
}
pub relation obligation_assumed_in_exchange_358h(t: ControlledTransfer, transferor: Person, l: AssumedObligation358, amount: Money) kind empirical {
    label en unofficial "the obligation, in the amount determined as of the date of the exchange, is assumed by another person as part of the exchange (section 358(h)(1)(A))";
}
pub relation obligation_within_358d1_358h(l: AssumedObligation358) kind empirical {
    label en unofficial "subsection (d)(1) applies to the assumption, so the liability is already treated as money (section 358(h)(1)(B) negated)";
}
pub relation obligation_business_transferred_358h2a(l: AssumedObligation358) kind empirical {
    label en official "the trade or business with which the liability is associated is transferred to the person assuming the liability as part of the exchange (section 358(h)(2)(A))";
}
pub relation obligation_substantially_all_assets_transferred_358h2b(l: AssumedObligation358) kind empirical {
    label en official "substantially all of the assets with which the liability is associated are transferred to the person assuming the liability as part of the exchange (section 358(h)(2)(B)); an evaluative element (DECISION-0194 channel 2): asserted with origin adjudicated, by the Secretary or a court";
}
pub relation total_reducing_liabilities_358h1(t: ControlledTransfer, transferor: Person, amount: Money) kind institutional {
    label en official "the amount of the liabilities assumed as part of the exchange to which (d)(1) does not apply and which no (h)(2) exception removes (the Secretary's power to disapply the exceptions is not applied: TECH_GAP G4001)";
}
@source(IRC_S358_H, quote = "by the amount (determined as of the date of the exchange) of any liability—")
rule Section358h1TotalLiabilitiesRule(t: ControlledTransfer, transferor: Person) strict {
    label en official "section 358(h)(1)-(2): total of the liabilities that reduce basis — assumed as part of the exchange, outside (d)(1), and outside both (h)(2) exceptions";
    when substituted_basis_358(transferor, t, _);
    then total_reducing_liabilities_358h1(t, transferor, sum all amt: Money for l: AssumedObligation358 where obligation_assumed_in_exchange_358h(t, transferor, l, amt) and not obligation_within_358d1_358h(l) and not obligation_business_transferred_358h2a(l) and not obligation_substantially_all_assets_transferred_358h2b(l));
}
pub relation property_fair_market_value_358h(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate fair market value of the property to which subsection (a)(1) applies, at the time of the exchange";
}
pub relation basis_reduced_by_liabilities_358h(transferor: Person, t: ControlledTransfer, amount: Money) kind institutional {
    label en official "the basis of the property, reduced (but not below fair market value) by the liabilities assumed outside (d)(1) (section 358(h)(1))";
}
@source(IRC_S358_H, quote = "then such basis shall be reduced (but not below such fair market value) by the amount")
rule Section358h1ReductionWithinExcessRule(transferor: Person, t: ControlledTransfer, basis: Money, fmv: Money, liabilities: Money) defeasible {
    label en official "section 358(h)(1): when the liabilities do not exceed the excess of basis over fair market value, basis is reduced by all of them";
    when substituted_basis_358(transferor, t, basis);
    when property_fair_market_value_358h(t, transferor, fmv);
    when total_reducing_liabilities_358h1(t, transferor, liabilities);
    when basis > fmv;
    when liabilities <= basis - fmv;
    then basis_reduced_by_liabilities_358h(transferor, t, basis - liabilities);
}
@source(IRC_S358_H, quote = "then such basis shall be reduced (but not below such fair market value) by the amount")
rule Section358h1ReductionFloorRule(transferor: Person, t: ControlledTransfer, basis: Money, fmv: Money, liabilities: Money) defeasible {
    label en official "section 358(h)(1): when the liabilities exceed the excess of basis over fair market value, basis is reduced only down to fair market value";
    when substituted_basis_358(transferor, t, basis);
    when property_fair_market_value_358h(t, transferor, fmv);
    when total_reducing_liabilities_358h1(t, transferor, liabilities);
    when basis > fmv;
    when liabilities > basis - fmv;
    then basis_reduced_by_liabilities_358h(transferor, t, fmv);
}
@source(IRC_S358_H, quote = "If, after application of the other provisions of this section to an exchange or series of exchanges, the basis of property to which subsection (a)(1) applies exceeds the fair market value of such property")
rule Section358h1NoExcessNoReductionRule(transferor: Person, t: ControlledTransfer, basis: Money, fmv: Money) defeasible {
    label en official "section 358(h)(1): basis that does not exceed fair market value is not reduced";
    when substituted_basis_358(transferor, t, basis);
    when property_fair_market_value_358h(t, transferor, fmv);
    when basis <= fmv;
    then basis_reduced_by_liabilities_358h(transferor, t, basis);
}

// --- Section 362(c): contributions to capital not made by a shareholder -------

pub entity CapitalContribution362 { label en unofficial "a contribution to the capital of a corporation (section 362(c))"; }
pub relation capital_contribution_to_corporation_362c(c: CapitalContribution362, corp: Corporation, contributor: Person) kind empirical {
    label en unofficial "the contribution is made to the corporation's capital by the contributor";
}
pub relation contribution_of_nonmoney_property_362c(c: CapitalContribution362, asset: Asset) kind empirical {
    label en unofficial "the contribution is of property other than money, namely the asset";
}
pub relation contribution_of_money_362c(c: CapitalContribution362, amount: Money, received_on: Date) kind empirical {
    label en unofficial "the contribution is of money received on the given day";
}
pub relation contributed_by_shareholder_as_such_362c(c: CapitalContribution362) kind empirical {
    label en official "the property or money is contributed by a shareholder as such (section 362(c)(1)(B), (2)(B))";
}
pub relation contribution_by_nonshareholder_362c(c: CapitalContribution362) kind institutional {
    label en unofficial "the contribution is not contributed by a shareholder as such";
}
@source(IRC_S362_C, quote = "is not contributed by a shareholder as such,")
rule Section362cNonShareholderRule(c: CapitalContribution362, corp: Corporation, contributor: Person) defeasible {
    label en official "section 362(c): a contribution to capital that is not made by a shareholder as such";
    when capital_contribution_to_corporation_362c(c, corp, contributor);
    when not_known(contributed_by_shareholder_as_such_362c(c));
    then contribution_by_nonshareholder_362c(c);
}
pub relation basis_of_contributed_property_zero_362c1(corp: Corporation, asset: Asset, amount: Money) kind institutional {
    label en official "the basis of property other than money contributed to capital by a nonshareholder is zero (section 362(c)(1))";
}
@source(IRC_S362_C, quote = "then the basis of such property shall be zero.")
rule Section362c1ZeroBasisRule(c: CapitalContribution362, corp: Corporation, contributor: Person, asset: Asset) defeasible {
    label en official "section 362(c)(1): notwithstanding (a)(2), property other than money contributed to capital by a nonshareholder has a zero basis";
    when capital_contribution_to_corporation_362c(c, corp, contributor);
    when contribution_of_nonmoney_property_362c(c, asset);
    when contribution_by_nonshareholder_362c(c);
    then basis_of_contributed_property_zero_362c1(corp, asset, 0.00 USD);
}
pub relation property_acquired_with_contributed_money_362c2(c: CapitalContribution362, asset: Asset, acquired_on: Date, cost: Money) kind empirical {
    label en unofficial "property acquired with the contributed money, on the given day, at the given cost";
}
pub relation contribution_money_window_ends_362c2(c: CapitalContribution362, ends_on: Date) kind institutional {
    label en official "the last day of the 12-month period beginning on the day the contribution is received (section 362(c)(2))";
}
@source(IRC_S362_C, quote = "during the 12-month period beginning on the day the contribution is received")
rule Section362c2WindowRule(c: CapitalContribution362, amount: Money, received_on: Date, calendar_before_1: Date) strict {
    label en official "section 362(c)(2): the 12-month period beginning on the day the money is received, ending the day before its anniversary";
    when contribution_of_money_362c(c, amount, received_on)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(received_on, 12 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then contribution_money_window_ends_362c2(c, calendar_before_1);
}
pub relation cost_of_property_bought_within_window_362c2(c: CapitalContribution362, amount: Money) kind institutional {
    label en official "the total cost of property acquired with the contributed money within the 12-month period";
}
@source(IRC_S362_C, quote = "the basis of any property acquired with such money during the 12-month period beginning on the day the contribution is received shall be reduced by the amount of such contribution.")
rule Section362c2CostWithinWindowRule(c: CapitalContribution362, amount: Money, received_on: Date, ends_on: Date) strict {
    label en official "section 362(c)(2): the cost of property acquired with the contributed money on or after receipt and by the window's last day";
    when contribution_of_money_362c(c, amount, received_on);
    when contribution_money_window_ends_362c2(c, ends_on);
    then cost_of_property_bought_within_window_362c2(c, sum all cost: Money for asset: Asset where property_acquired_with_contributed_money_362c2(c, asset, _, cost));
}
pub relation basis_reduction_on_acquired_property_362c2(c: CapitalContribution362, amount: Money) kind institutional {
    label en official "the reduction of the basis of property acquired with the contributed money — the smaller of the contribution and the cost (section 362(c)(2), first sentence)";
}
@source(IRC_S362_C, quote = "shall be reduced by the amount of such contribution.")
rule Section362c2ReductionFullRule(c: CapitalContribution362, corp: Corporation, contributor: Person, amount: Money, cost: Money) defeasible {
    label en official "section 362(c)(2): when the acquired property cost at least the contribution, the reduction is the whole contribution";
    when capital_contribution_to_corporation_362c(c, corp, contributor);
    when contribution_by_nonshareholder_362c(c);
    when contribution_of_money_362c(c, amount, _);
    when cost_of_property_bought_within_window_362c2(c, cost);
    when cost >= amount;
    then basis_reduction_on_acquired_property_362c2(c, amount);
}
@source(IRC_S362_C, quote = "shall be reduced by the amount of such contribution.")
rule Section362c2ReductionCappedRule(c: CapitalContribution362, corp: Corporation, contributor: Person, amount: Money, cost: Money) defeasible {
    label en official "section 362(c)(2): when the acquired property cost less than the contribution, the first-sentence reduction is limited to the cost";
    when capital_contribution_to_corporation_362c(c, corp, contributor);
    when contribution_by_nonshareholder_362c(c);
    when contribution_of_money_362c(c, amount, _);
    when cost_of_property_bought_within_window_362c2(c, cost);
    when cost < amount;
    then basis_reduction_on_acquired_property_362c2(c, cost);
}
pub relation excess_reduction_of_other_property_362c2(c: CapitalContribution362, amount: Money, as_of: Date) kind institutional {
    label en official "the excess of the contribution over the first-sentence reduction is applied, as of the last day of the 12-month period, to reduce the basis of other property held by the taxpayer (section 362(c)(2))";
}
@source(IRC_S362_C, quote = "The excess (if any) of the amount of such contribution over the amount of the reduction under the preceding sentence shall be applied to the reduction (as of the last day of the period specified in the preceding sentence) of the basis of any other property held by the taxpayer.")
rule Section362c2ExcessRule(c: CapitalContribution362, amount: Money, reduction: Money, ends_on: Date) defeasible {
    label en official "section 362(c)(2): the excess of the contribution over the first-sentence reduction reduces other property's basis as of the window's last day";
    when contribution_of_money_362c(c, amount, _);
    when basis_reduction_on_acquired_property_362c2(c, reduction);
    when contribution_money_window_ends_362c2(c, ends_on);
    when amount > reduction;
    then excess_reduction_of_other_property_362c2(c, amount - reduction, ends_on);
}
pub relation regulations_allocate_contribution_reduction_362c2(c: CapitalContribution362, asset: Asset, amount: Money) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: the particular properties to which the reductions are allocated are determined under regulations prescribed by the Secretary; the allocation is supplied by the case";
}

// --- Section 362(d): limitation on basis increase from liability gain ---------

pub relation gain_recognized_from_liability_assumption_362d(corp: Corporation, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the gain recognized to the transferor as a result of the assumption of a liability";
}
pub relation property_fair_market_value_362d(corp: Corporation, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the fair market value of the property, determined without regard to section 7701(g)";
}
pub relation basis_after_liability_gain_limit_362d1(corp: Corporation, transferor: Person, amount: Money) kind institutional {
    label en official "the basis under (a) or (b), with any increase by reason of liability-assumption gain held to fair market value (section 362(d)(1))";
}
@source(IRC_S362_D, quote = "In no event shall the basis of any property be increased under subsection (a) or (b) above the fair market value of such property")
rule Section362d1WithinFmvRule(corp: Corporation, transferor: Person, basis: Money, fmv: Money, liability_gain: Money) defeasible {
    label en official "section 362(d)(1): a basis that does not exceed fair market value is left as computed";
    when corp_basis_carryover_351(corp, basis);
    when property_fair_market_value_362d(corp, transferor, fmv);
    when gain_recognized_from_liability_assumption_362d(corp, transferor, liability_gain);
    when basis <= fmv;
    then basis_after_liability_gain_limit_362d1(corp, transferor, basis);
}
@source(IRC_S362_D, quote = "by reason of any gain recognized to the transferor as a result of the assumption of a liability.")
rule Section362d1TrimmedToFmvRule(corp: Corporation, transferor: Person, basis: Money, fmv: Money, liability_gain: Money) defeasible {
    label en official "section 362(d)(1): the liability-gain part of the increase is trimmed so that the basis reaches fair market value but not below the basis without that gain";
    when corp_basis_carryover_351(corp, basis);
    when property_fair_market_value_362d(corp, transferor, fmv);
    when gain_recognized_from_liability_assumption_362d(corp, transferor, liability_gain);
    when basis > fmv;
    when basis - liability_gain >= fmv;
    then basis_after_liability_gain_limit_362d1(corp, transferor, basis - liability_gain);
}
@source(IRC_S362_D, quote = "by reason of any gain recognized to the transferor as a result of the assumption of a liability.")
rule Section362d1FloorAtFmvRule(corp: Corporation, transferor: Person, basis: Money, fmv: Money, liability_gain: Money) defeasible {
    label en official "section 362(d)(1): the trimmed basis is fair market value when removing all liability gain would go below it";
    when corp_basis_carryover_351(corp, basis);
    when property_fair_market_value_362d(corp, transferor, fmv);
    when gain_recognized_from_liability_assumption_362d(corp, transferor, liability_gain);
    when basis > fmv;
    when basis - liability_gain < fmv;
    then basis_after_liability_gain_limit_362d1(corp, transferor, fmv);
}
pub entity NonrecourseLiability362 { label en unofficial "a nonrecourse liability assumed by a transferee and secured also by assets not transferred to it (section 362(d)(2))"; }
pub relation nonrecourse_liability_assumed_362d2(l: NonrecourseLiability362, transferee: Corporation, amount: Money) kind empirical {
    label en official "gain is recognized to the transferor as a result of an assumption of a nonrecourse liability by the transferee which is also secured by assets not transferred to it (section 362(d)(2)(A))";
}
pub relation no_person_taxed_on_liability_gain_362d2(l: NonrecourseLiability362) kind empirical {
    label en official "no person is subject to tax under the title on the gain (section 362(d)(2)(B))";
}
pub relation asset_secures_liability_fmv_362d2(l: NonrecourseLiability362, asset: Asset, fmv: Money) kind empirical {
    label en unofficial "the asset is subject to the liability, at its fair market value determined without regard to section 7701(g)";
}
pub relation asset_secures_liability_transferred_to_transferee_362d2(l: NonrecourseLiability362, asset: Asset, fmv: Money) kind empirical {
    label en unofficial "the asset subject to the liability was transferred to the transferee, at its fair market value";
}
pub relation regulations_disapply_ratable_portion_362d2(l: NonrecourseLiability362) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise (\"except as provided in regulations\")";
}
pub relation total_fmv_of_assets_subject_362d2(l: NonrecourseLiability362, amount: Money) kind institutional {
    label en official "the fair market value of all the assets subject to the liability";
}
@source(IRC_S362_D, quote = "the relative fair market values (determined without regard to section 7701(g)) of all of the assets subject to such liability.")
rule Section362d2TotalFmvRule(l: NonrecourseLiability362, transferee: Corporation, liability: Money) strict {
    label en official "section 362(d)(2): denominator of the ratable portion — fair market value of all assets subject to the liability";
    when nonrecourse_liability_assumed_362d2(l, transferee, liability);
    then total_fmv_of_assets_subject_362d2(l, sum all f: Money for a: Asset where asset_secures_liability_fmv_362d2(l, a, f));
}
pub relation transferred_fmv_of_assets_subject_362d2(l: NonrecourseLiability362, amount: Money) kind institutional {
    label en official "the fair market value of the assets subject to the liability that were transferred to the transferee";
}
@source(IRC_S362_D, quote = "such transferee's ratable portion of such liability")
rule Section362d2TransferredFmvRule(l: NonrecourseLiability362, transferee: Corporation, liability: Money) strict {
    label en official "section 362(d)(2): numerator of the ratable portion — fair market value of the subject assets transferred to the transferee";
    when nonrecourse_liability_assumed_362d2(l, transferee, liability);
    then transferred_fmv_of_assets_subject_362d2(l, sum all f: Money for a: Asset where asset_secures_liability_transferred_to_transferee_362d2(l, a, f));
}
pub relation ratable_portion_of_nonrecourse_liability_362d2(l: NonrecourseLiability362, amount: Money) kind institutional {
    label en official "the transferee's ratable portion of the liability by the relative fair market values of all the assets subject to it, used to determine the transferor's gain for basis purposes (section 362(d)(2))";
}
@source(IRC_S362_D, quote = "the amount of gain recognized by the transferor as a result of the assumption of the liability shall be determined as if the liability assumed by the transferee equaled such transferee's ratable portion of such liability determined on the basis of the relative fair market values")
rule Section362d2RatablePortionRule(l: NonrecourseLiability362, transferee: Corporation, liability: Money, part: Money, total: Money) defeasible {
    label en official "section 362(d)(2): the assumed liability is taken as the transferee's ratable share by relative fair market value of all assets subject to it, when no person is taxed on the gain (one rounding, JUDGMENT CALL: cents HALF_UP)";
    when nonrecourse_liability_assumed_362d2(l, transferee, liability);
    when no_person_taxed_on_liability_gain_362d2(l);
    when not_known(regulations_disapply_ratable_portion_362d2(l));
    when transferred_fmv_of_assets_subject_362d2(l, part);
    when total_fmv_of_assets_subject_362d2(l, total);
    when total > 0.00 USD;
    then ratable_portion_of_nonrecourse_liability_362d2(l, div_round(liability * (part / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// --- Section 362(e)(2): built-in losses in section 351 transactions -----------

pub relation transferee_aggregate_basis_362e2(corp: Corporation, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the transferee's aggregate adjusted bases of the property transferred in the section 351 transaction, but for paragraph (2)";
}
pub relation transferred_property_aggregate_fmv_362e2(corp: Corporation, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate fair market value of that property immediately after the transaction";
}
pub relation built_in_loss_of_transferred_property_362e2(corp: Corporation, transferor: Person, asset: Asset, amount: Money) kind empirical {
    label en unofficial "the built-in loss of one transferred property immediately before the transaction";
}
pub relation section_351_transfer_outside_362e1_362e2(corp: Corporation, transferor: Person) kind empirical {
    label en official "property is transferred in a transaction described in subsection (a) and not described in paragraph (1) (section 362(e)(2)(A)(i))";
}
pub relation joint_election_in_effect_362e2c(corp: Corporation, transferor: Person) kind institutional {
    label en official "the transferor and transferee both elected the application of subparagraph (C), so (A) does not apply (section 362(e)(2)(C)(i)(I))";
}
pub relation transferor_elects_362e2c(corp: Corporation, transferor: Person) kind empirical {
    label en unofficial "the transferor elects the application of subparagraph (C)";
}
pub relation transferee_elects_362e2c(corp: Corporation, transferor: Person) kind empirical {
    label en unofficial "the transferee elects the application of subparagraph (C)";
}
pub relation election_362e2c_made_in_prescribed_form(corp: Corporation, transferor: Person) kind empirical {
    label en unofficial "the election is made at the time and in the form and manner the Secretary prescribes (section 362(e)(2)(C)(ii))";
}
pub relation both_parties_elect_362e2c(corp: Corporation, transferor: Person) kind institutional {
    label en unofficial "helper: both transferor and transferee elect, in the prescribed form (the single atom of the power's valid_when)";
}
@source(IRC_S362_E, quote = "If the transferor and transferee of a transaction described in subparagraph (A) both elect the application of this subparagraph")
rule BothPartiesElect362e2cRule(corp: Corporation, transferor: Person) defeasible {
    label en unofficial "helper: transferor and transferee both elect, in the prescribed form";
    when transferor_elects_362e2c(corp, transferor);
    when transferee_elects_362e2c(corp, transferor);
    when election_362e2c_made_in_prescribed_form(corp, transferor);
    then both_parties_elect_362e2c(corp, transferor);
}
@source(IRC_S362_E, quote = "If the transferor and transferee of a transaction described in subparagraph (A) both elect the application of this subparagraph")
rule Section362e2cElectionPowerRule strict {
    label en official "section 362(e)(2)(C): the transferor's power, jointly with the transferee, to switch the built-in-loss limitation to the transferor's stock basis; an election lacking the other party or the prescribed form is invalid and has no effect";
    for corp: Corporation;
    for transferor: Person;
    when transferor_elects_362e2c(corp, transferor);
    then power Section362e2cJointElection {
        holder transferor;
        over corp;
        exercise transferor_elects_362e2c(corp, transferor);
        valid_when both_parties_elect_362e2c(corp, transferor);
        effect create(joint_election_in_effect_362e2c(corp, transferor));
        window [-infinity, infinity];
    };
}
pub relation election_362e2c_revocation_attempt(corp: Corporation, transferor: Person) kind empirical {
    label en unofficial "a party purports to revoke its section 362(e)(2)(C) election";
}
@source(IRC_S362_E, quote = "once made, shall be irrevocable.")
rule Section362e2cIrrevocableRule(corp: Corporation, transferor: Person) defeasible {
    label en official "section 362(e)(2)(C)(ii): an election, once made, is irrevocable — the parties are protected in the election's effect";
    when joint_election_in_effect_362e2c(corp, transferor);
    then immunity Section362e2cElectionIrrevocable {
        holder transferor;
        protected_effect joint_election_in_effect_362e2c(corp, transferor);
        window [-infinity, infinity];
    };
}
pub relation importation_of_net_built_in_loss_362e1(corp: Corporation, transferor: Person) kind institutional {
    label en unofficial "helper: the transaction is one described in paragraph (1), an importation of a net built-in loss";
}
rule ImportationHelper362e1Rule(corp: Corporation, transferor: Person, basis: Money, fmv: Money) defeasible {
    label en unofficial "helper: bridges the (e)(1) importation fact to the paragraph (2) exclusion";
    when net_built_in_loss_importation(corp, transferor, basis, fmv);
    then importation_of_net_built_in_loss_362e1(corp, transferor);
}
pub relation transferee_basis_cap_362e2a(corp: Corporation, transferor: Person, cap: Money) kind institutional {
    label en official "the transferee's aggregate adjusted bases of the transferred property shall not exceed its fair market value immediately after the transaction (section 362(e)(2)(A))";
}
@source(IRC_S362_E, quote = "the transferee's aggregate adjusted bases of the property so transferred shall not exceed the fair market value of such property immediately after such transaction.")
rule Section362e2aCapRule(corp: Corporation, transferor: Person, basis: Money, fmv: Money) defeasible {
    label en official "section 362(e)(2)(A): aggregate basis is limited to aggregate fair market value where it would exceed it, absent the (C) election";
    when section_351_transfer_outside_362e1_362e2(corp, transferor);
    when not_known(importation_of_net_built_in_loss_362e1(corp, transferor));
    when transferee_aggregate_basis_362e2(corp, transferor, basis);
    when transferred_property_aggregate_fmv_362e2(corp, transferor, fmv);
    when basis > fmv;
    when not_known(joint_election_in_effect_362e2c(corp, transferor));
    then transferee_basis_cap_362e2a(corp, transferor, fmv);
}
pub relation aggregate_basis_reduction_362e2(corp: Corporation, transferor: Person, amount: Money) kind institutional {
    label en official "the aggregate reduction in basis under subparagraph (A)";
}
@source(IRC_S362_E, quote = "The aggregate reduction in basis by reason of subparagraph (A) shall be allocated among the property so transferred in proportion to their respective built-in losses immediately before the transaction.")
rule Section362e2aReductionRule(corp: Corporation, transferor: Person, basis: Money, cap: Money) defeasible {
    label en official "section 362(e)(2)(A)-(B): the aggregate reduction is the excess of aggregate basis over the cap";
    when transferee_aggregate_basis_362e2(corp, transferor, basis);
    when transferee_basis_cap_362e2a(corp, transferor, cap);
    then aggregate_basis_reduction_362e2(corp, transferor, basis - cap);
}
pub relation total_built_in_loss_362e2(corp: Corporation, transferor: Person, amount: Money) kind institutional {
    label en official "the sum of the respective built-in losses of the transferred properties";
}
@source(IRC_S362_E, quote = "in proportion to their respective built-in losses immediately before the transaction.")
rule Section362e2bTotalBuiltInLossRule(corp: Corporation, transferor: Person) strict {
    label en official "section 362(e)(2)(B): the denominator of the allocation — the total of the built-in losses";
    when transferee_aggregate_basis_362e2(corp, transferor, _);
    then total_built_in_loss_362e2(corp, transferor, sum all bil: Money for asset: Asset where built_in_loss_of_transferred_property_362e2(corp, transferor, asset, bil));
}
pub relation basis_reduction_allocated_to_property_362e2b(corp: Corporation, transferor: Person, asset: Asset, amount: Money) kind institutional {
    label en official "the part of the aggregate basis reduction allocated to one property in proportion to its built-in loss (section 362(e)(2)(B))";
}
@source(IRC_S362_E, quote = "shall be allocated among the property so transferred in proportion to their respective built-in losses immediately before the transaction.")
rule Section362e2bAllocationRule(corp: Corporation, transferor: Person, asset: Asset, reduction: Money, bil: Money, total_bil: Money) defeasible {
    label en official "section 362(e)(2)(B): allocation of the aggregate reduction by built-in loss, one rounding (JUDGMENT CALL: the statute names none, corpus convention cents HALF_UP)";
    when aggregate_basis_reduction_362e2(corp, transferor, reduction);
    when built_in_loss_of_transferred_property_362e2(corp, transferor, asset, bil);
    when total_built_in_loss_362e2(corp, transferor, total_bil);
    when total_bil > 0.00 USD;
    then basis_reduction_allocated_to_property_362e2b(corp, transferor, asset, div_round(reduction * (bil / 1.00 USD), total_bil / 1.00 USD, 2, "HALF_UP"));
}
pub relation transferor_stock_basis_fmv_362e2c(corp: Corporation, transferor: Person, stock_basis: Money, stock_fmv: Money) kind empirical {
    label en unofficial "the transferor's basis in the stock received and the stock's fair market value immediately after the transfer";
}
pub relation transferor_stock_basis_after_election_362e2c(corp: Corporation, transferor: Person, amount: Money) kind institutional {
    label en official "under the election the transferor's basis in the stock shall not exceed its fair market value immediately after the transfer (section 362(e)(2)(C)(i)(II))";
}
@source(IRC_S362_E, quote = "the transferor's basis in the stock received for property to which subparagraph (A) does not apply by reason of the election shall not exceed its fair market value immediately after the transfer.")
rule Section362e2cStockBasisWithinRule(corp: Corporation, transferor: Person, basis: Money, fmv: Money) defeasible {
    label en official "section 362(e)(2)(C)(i)(II): stock basis at or below fair market value is unchanged";
    when joint_election_in_effect_362e2c(corp, transferor);
    when transferor_stock_basis_fmv_362e2c(corp, transferor, basis, fmv);
    when basis <= fmv;
    then transferor_stock_basis_after_election_362e2c(corp, transferor, basis);
}
@source(IRC_S362_E, quote = "the transferor's basis in the stock received for property to which subparagraph (A) does not apply by reason of the election shall not exceed its fair market value immediately after the transfer.")
rule Section362e2cStockBasisCappedRule(corp: Corporation, transferor: Person, basis: Money, fmv: Money) defeasible {
    label en official "section 362(e)(2)(C)(i)(II): stock basis above fair market value is limited to it";
    when joint_election_in_effect_362e2c(corp, transferor);
    when transferor_stock_basis_fmv_362e2c(corp, transferor, basis, fmv);
    when basis > fmv;
    then transferor_stock_basis_after_election_362e2c(corp, transferor, fmv);
}
