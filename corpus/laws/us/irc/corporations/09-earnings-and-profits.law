// Section 312 — effect on earnings and profits. Stage 2 (IRC-08 stage 2,
// A06), priority section (owner's task: "(a)-(d), (f), (h), (k)
// depreciation adjustment -> contract to deductions section 168, (n)
// adjustments (n)(1)-(8) — as classification/calculation rules feeding
// `earnings_and_profits` as a history").
//
// METHOD: module 02 (`02-distributions-and-dividends.law`) already declares
// `earnings_and_profits_current`/`earnings_and_profits_accumulated` as
// `kind empirical` INPUT facts a case asserts directly (section 316's own
// scope, stage 1). Changing those relations' kind or producers now would
// break every already-locked consumer of this package and every existing
// scenario in `tests/s301-s316-distributions-and-dividends.lawtest` — not
// permitted (AGENT-BRIEF: "keep existing `pub` signatures stable").
// Section 312 is therefore modelled as a SEPARATE, additive computation of
// the PER-DISTRIBUTION effect on E&P (the decrease under (a)-(c), the
// increase under (b) for appreciated property, the exclusion under (d)):
// `earnings_and_profits_effect_of_distribution(dist, net_change)`. A future
// stage that wires module 02's E&P input facts to a running ledger fed by
// this module's per-event effects hits the SAME multi-year running-ledger
// gap as section 316(a)'s "most recently accumulated" ordering (G38) — the
// reduction here is a per-EVENT net change, not a year-to-year accumulator;
// chaining events chronologically into a running E&P balance is filed as a
// new technical gap (G6x, see module footer) rather than silently modelled
// by decrementing a single scalar with no history.
//
// Sections not reduced to an executable computation this stage: (f) (gain/
// loss recognized on disposition of property affects E&P using the SAME
// adjusted basis used to compute gain for regular tax purposes, except no
// regard to the pre-1913 value — this is a CONTRACT to `property-
// transactions`/`gross-income`'s own gain computation, which this package
// does not own or duplicate: EXTERNAL_DEPENDENCY), (h) (allocation of E&P
// between distributing/controlled or acquiring/acquired corporations in a
// section 355/368(a)(1)(C)-(D) transaction "under regulations prescribed by
// the Secretary" — no statutory formula, regulations not promulgated in
// this package's text: EXTERNAL_DEPENDENCY, EVALUATIVE-adjacent since the
// allocation METHOD is left to Treasury), (k) (depreciation for E&P
// purposes is deemed to be the STRAIGHT-LINE amount regardless of the
// method used for regular tax — a real computation needs `us.irc.
// property_transactions`'s section 168/167 depreciation schedule as an
// input the E&P adjustment SUBTRACTS the difference against; modelled as a
// classification relation naming the required contract, not a duplicated
// depreciation schedule), (n) (the eight named "more accurate reflection of
// economic gain and loss" adjustment ITEMS are classified by kind — each
// item's own detailed computation is, in turn, a contract to the section it
// cross-references: section 263A/263(c) capitalized costs, section 173
// circulation expenditures, section 248/709 organizational/start-up
// expenditures, section 616 mine development, section 447/471 installment/
// LIFO inventory methods, etc. — none of which this package owns; every
// item is TECH_GAP or EXTERNAL_DEPENDENCY, never computed with an invented
// figure).

// --- Section 312(a)-(c): the reduction of E&P on a distribution ------------

use self::{
    Asset,
    Corporation,
    DistributionEvent,
    IRC_S312_A,
    IRC_S312_B,
    IRC_S312_C,
    IRC_S312_D,
    IRC_S312_F,
    IRC_S312_H,
    IRC_S312_K,
    TaxableYear,
};

@source(IRC_S312_A, quote = "the earnings and profits of the corporation (to the extent thereof) shall be decreased by the sum of—")
pub relation earnings_and_profits_charge_money(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "section 312(a)(1): the amount of money distributed, for the earnings and profits reduction";
}
@source(IRC_S312_A, quote = "the principal amount of the obligations of such corporation")
pub relation earnings_and_profits_charge_obligations(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "section 312(a)(2): the principal amount of the distributing corporation's own obligations distributed (issue price, if issued at a discount), for the earnings and profits reduction";
}
@source(IRC_S312_A, quote = "the adjusted basis of the other property, so distributed.")
pub relation earnings_and_profits_charge_property_basis(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "section 312(a)(3): the adjusted basis (for earnings and profits purposes) of any other property distributed, before the section 312(b) fair-market-value substitution";
}

// Section 312(b): the corporation distributes appreciated property (other
// than its own obligation) — E&P is INCREASED by the excess of fair market
// value over adjusted basis, and the (a)(3) charge uses fair market value
// instead of adjusted basis.
@source(IRC_S312_B, quote = "the fair market value of which exceeds the adjusted basis thereof")
pub relation distributed_property_fmv_312b(dist: DistributionEvent, fmv: Money, adjusted_basis: Money) kind empirical {
    label en official "section 312(b): the fair market value and adjusted basis of property (other than the distributing corporation's own obligation) distributed with respect to its stock, read for the appreciated-property E&P adjustment";
}
pub relation earnings_and_profits_appreciation_312b(dist: DistributionEvent, excess: Money) kind institutional {
    label en official "section 312(b)(1): the excess of fair market value over adjusted basis of appreciated property distributed, by which earnings and profits are increased";
}
@source(IRC_S312_B, quote = "the earnings and profits of the corporation shall be increased by the amount of such excess")
rule EarningsAndProfitsAppreciationRule(dist: DistributionEvent, fmv: Money, basis: Money) strict {
    label en official "section 312(b)(1): earnings and profits increase by the excess of fair market value over adjusted basis of distributed appreciated property";
    when distributed_property_fmv_312b(dist, fmv, basis);
    when fmv > basis;
    then earnings_and_profits_appreciation_312b(dist, fmv - basis);
}
// Section 312(b)(2): for appreciated property the (a)(3) charge is FMV, not
// adjusted basis — a separate relation rather than mutating (a)(3)'s input,
// since a case with appreciated property supplies THIS relation instead of
// `earnings_and_profits_charge_property_basis` for that item.
pub relation earnings_and_profits_charge_property_fmv_312b(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "section 312(b)(2): for appreciated property, the section 312(a)(3) charge to earnings and profits is the fair market value, substituted for adjusted basis";
}
@source(IRC_S312_B, quote = "subsection (a)(3) shall be applied by substituting \"fair market value\" for \"adjusted basis\".")
rule EarningsAndProfitsChargeFmvRule(dist: DistributionEvent, fmv: Money, basis: Money) strict {
    label en official "section 312(b)(2): the section 312(a)(3) property charge uses fair market value for appreciated property";
    when distributed_property_fmv_312b(dist, fmv, basis);
    when fmv > basis;
    then earnings_and_profits_charge_property_fmv_312b(dist, fmv);
}

// Section 312(c): proper adjustment for liabilities on the property or
// assumed by the shareholder — read as case facts naming the SAME liability
// amounts section 301(b)(2)/311(b) already use for the shareholder/
// corporate-gain side (module 02), not re-derived.
@source(IRC_S312_C, quote = "the amount of any liability to which the property distributed is subject, and")
pub relation earnings_and_profits_liability_adjustment(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "section 312(c): the amount of liability on the distributed property or assumed by the shareholder, by which the section 312(a)-(b) earnings and profits charge is reduced (\"proper adjustment ... for\" — the statute names no formula beyond the liability amount itself)";
}

// Projection helpers for `not_known(...)` guards below: `not_known` rejects
// `_` as an argument (LDC-E0207), so a same-key "does some tuple exist"
// witness relation is needed instead of probing the amount-carrying
// relation directly.
pub relation earnings_and_profits_charge_property_fmv_312b_exists(dist: DistributionEvent) kind institutional {
    label en unofficial "witness: some section 312(b)(2) fair-market-value charge exists for the distribution (projection helper for the not_known guard, LDC-E0207)";
}
rule EarningsAndProfitsChargeFmvExistsRule(dist: DistributionEvent, amount: Money) strict {
    label en unofficial "projection helper";
    when earnings_and_profits_charge_property_fmv_312b(dist, amount);
    then earnings_and_profits_charge_property_fmv_312b_exists(dist);
}
pub relation earnings_and_profits_appreciation_312b_exists(dist: DistributionEvent) kind institutional {
    label en unofficial "witness: some section 312(b)(1) appreciation increase exists for the distribution (projection helper for the not_known guard, LDC-E0207)";
}
rule EarningsAndProfitsAppreciationExistsRule(dist: DistributionEvent, amount: Money) strict {
    label en unofficial "projection helper";
    when earnings_and_profits_appreciation_312b(dist, amount);
    then earnings_and_profits_appreciation_312b_exists(dist);
}
pub relation earnings_and_profits_liability_adjustment_exists(dist: DistributionEvent) kind institutional {
    label en unofficial "witness: some section 312(c) liability adjustment exists for the distribution (projection helper for the not_known guard, LDC-E0207)";
}
rule EarningsAndProfitsLiabilityAdjustmentExistsRule(dist: DistributionEvent, amount: Money) strict {
    label en unofficial "projection helper";
    when earnings_and_profits_liability_adjustment(dist, amount);
    then earnings_and_profits_liability_adjustment_exists(dist);
}

pub relation earnings_and_profits_reduction_312a(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "the total reduction to earnings and profits under section 312(a), before the section 312(c) liability adjustment: money, obligations, and the adjusted basis (or, for appreciated property, the fair market value under section 312(b)) of property distributed";
}
@source(IRC_S312_A, quote = "the earnings and profits of the corporation (to the extent thereof) shall be decreased by the sum of—")
rule EarningsAndProfitsReductionOrdinaryRule(dist: DistributionEvent, money: Money, obligations: Money, basis: Money) defeasible {
    label en official "section 312(a): the E&P reduction for property that is not appreciated is money plus obligations plus the property's adjusted basis";
    when earnings_and_profits_charge_money(dist, money);
    when earnings_and_profits_charge_obligations(dist, obligations);
    when earnings_and_profits_charge_property_basis(dist, basis);
    when not_known(earnings_and_profits_charge_property_fmv_312b_exists(dist));
    then earnings_and_profits_reduction_312a(dist, money + obligations + basis);
}
@source(IRC_S312_B, quote = "subsection (a)(3) shall be applied by substituting \"fair market value\" for \"adjusted basis\".")
rule EarningsAndProfitsReductionAppreciatedRule(dist: DistributionEvent, money: Money, obligations: Money, fmv: Money) defeasible {
    label en official "section 312(a) as modified by section 312(b)(2): the E&P reduction for appreciated property uses fair market value in place of adjusted basis";
    when earnings_and_profits_charge_money(dist, money);
    when earnings_and_profits_charge_obligations(dist, obligations);
    when earnings_and_profits_charge_property_fmv_312b(dist, fmv);
    then earnings_and_profits_reduction_312a(dist, money + obligations + fmv);
}

pub relation earnings_and_profits_net_effect_of_distribution(dist: DistributionEvent, net_change: Money) kind institutional {
    label en official "section 312(a)-(c): the net change to the distributing corporation's earnings and profits from a single distribution — the section 312(b) appreciation increase, less the section 312(a) reduction (as adjusted under section 312(c) for liabilities)";
}
@source(IRC_S312_C, quote = "In making the adjustments to the earnings and profits of a corporation under subsection (a) or (b), proper adjustment shall be made for—")
rule EarningsAndProfitsNetEffectWithLiabilityRule(dist: DistributionEvent, reduction: Money, appreciation: Money, liability: Money) defeasible {
    label en official "section 312(a)-(c): net E&P effect, reduction adjusted for a liability, offset by any section 312(b) appreciation increase";
    when earnings_and_profits_reduction_312a(dist, reduction);
    when earnings_and_profits_liability_adjustment(dist, liability);
    when earnings_and_profits_appreciation_312b(dist, appreciation);
    then earnings_and_profits_net_effect_of_distribution(dist, appreciation - (reduction - liability));
}
@source(IRC_S312_C, quote = "In making the adjustments to the earnings and profits of a corporation under subsection (a) or (b), proper adjustment shall be made for—")
rule EarningsAndProfitsNetEffectWithLiabilityNoAppreciationRule(dist: DistributionEvent, reduction: Money, liability: Money) defeasible {
    label en official "section 312(a) and (c): net E&P effect (reduction only), adjusted for a liability, no appreciated property";
    when earnings_and_profits_reduction_312a(dist, reduction);
    when earnings_and_profits_liability_adjustment(dist, liability);
    when not_known(earnings_and_profits_appreciation_312b_exists(dist));
    then earnings_and_profits_net_effect_of_distribution(dist, 0.00 USD - (reduction - liability));
}
@source(IRC_S312_A, quote = "the earnings and profits of the corporation (to the extent thereof) shall be decreased by the sum of—")
rule EarningsAndProfitsNetEffectNoLiabilityRule(dist: DistributionEvent, reduction: Money) defeasible {
    label en official "section 312(a): net E&P effect (reduction only), no section 312(c) liability and no section 312(b) appreciation";
    when earnings_and_profits_reduction_312a(dist, reduction);
    when not_known(earnings_and_profits_liability_adjustment_exists(dist));
    when not_known(earnings_and_profits_appreciation_312b_exists(dist));
    then earnings_and_profits_net_effect_of_distribution(dist, 0.00 USD - reduction);
}

// --- Section 312(d): distributions of stock/securities excluded -----------

@source(IRC_S312_D, quote = "shall not be considered a distribution of the earnings and profits of any corporation—")
pub relation distribution_gain_not_recognized_312d(dist: DistributionEvent) kind empirical {
    label en official "section 312(d)(1)(A): no gain to the distributee from the receipt of the stock, securities, or property was recognized under Title 26";
}
@source(IRC_S312_D, quote = "if the distribution was not subject to tax in the hands of such distributee by reason of section 305(a).")
pub relation distribution_exempt_under_305a(dist: DistributionEvent) kind empirical {
    label en official "section 312(d)(1)(B): the distribution was not subject to tax in the distributee's hands by reason of section 305(a)";
}
pub relation earnings_and_profits_distribution_excluded_312d(dist: DistributionEvent) kind institutional {
    label en official "section 312(d)(1): the distribution of stock or securities is not considered a distribution of earnings and profits of any corporation";
}
@source(IRC_S312_D, quote = "shall not be considered a distribution of the earnings and profits of any corporation—")
rule Section312dExclusionFromNoGainRule(dist: DistributionEvent) strict {
    label en official "section 312(d)(1)(A): no E&P distribution where no gain was recognized to the distributee";
    when distribution_gain_not_recognized_312d(dist);
    then earnings_and_profits_distribution_excluded_312d(dist);
}
@source(IRC_S312_D, quote = "if the distribution was not subject to tax in the hands of such distributee by reason of section 305(a).")
rule Section312dExclusionFrom305aRule(dist: DistributionEvent) strict {
    label en official "section 312(d)(1)(B): no E&P distribution where section 305(a) excludes the distribution from tax";
    when distribution_exempt_under_305a(dist);
    then earnings_and_profits_distribution_excluded_312d(dist);
}

// --- Section 312(f): gain/loss and receipt of tax-free distributions ------
// EXTERNAL_DEPENDENCY: the adjusted basis used to compute gain/loss for E&P
// purposes is a contract to whichever package computes gain on a
// disposition (`property-transactions`/`gross-income`), not duplicated
// here; only the SWITCH the statute names (whether the pre-1913 valuation
// exception applies) is classified.
pub relation gain_or_loss_recognized_on_corporate_disposition(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 312(f)(1): the gain or loss realized from the sale or other disposition (after February 28, 1913) of property by the corporation, computed using the adjusted basis under the law applicable to the year of disposition (EXTERNAL_DEPENDENCY: the gain/loss computation itself is `property-transactions`'/`gross-income`'s own norm, read here as an input)";
}
@source(IRC_S312_F, quote = "shall (except as provided in subparagraph (B)) be determined by using as the adjusted basis the adjusted basis (under the law applicable to the year in which the sale or other disposition was made) for determining gain, except that no regard shall be had to the value of the property as of March 1, 1913; but")
pub relation earnings_and_profits_effect_of_gain_or_loss_312f(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 312(f)(1): the effect on earnings and profits of gain or loss realized on a disposition of property equals the gain or loss recognized for regular tax purposes, computed without regard to the March 1, 1913 value (an identity contract on the EXTERNAL_DEPENDENCY input, not an independent computation)";
}
@source(IRC_S312_F, quote = "shall (except as provided in subparagraph (B)) be determined by using as the adjusted basis the adjusted basis (under the law applicable to the year in which the sale or other disposition was made) for determining gain, except that no regard shall be had to the value of the property as of March 1, 1913; but")
rule EarningsAndProfitsGainOrLossRule(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "section 312(f)(1)(A): earnings and profits reflect the same gain or loss computed for regular tax purposes";
    when gain_or_loss_recognized_on_corporate_disposition(c, y, amount);
    then earnings_and_profits_effect_of_gain_or_loss_312f(c, y, amount);
}

// --- Section 312(h): allocation in section 355/368(a)(1)(C)-(D) -----------
// EXTERNAL_DEPENDENCY / EVALUATIVE-adjacent: the statute itself delegates
// the ALLOCATION METHOD to Treasury regulations ("proper allocation ...
// shall be made under regulations prescribed by the Secretary") — no
// statutory formula exists in the pinned text to execute; classified as an
// external judgment channel per DECISION-0194 rather than invented.
@source(IRC_S312_H, quote = "proper allocation with respect to the earnings and profits of the distributing corporation and the controlled corporation (or corporations) shall be made under regulations prescribed by the Secretary.")
external judgment relation earnings_and_profits_allocated_under_312h(distributing_or_acquired: Corporation, controlled_or_acquiring: Corporation, y: TaxableYear, allocated_amount: Money) {
    authority Secretary;
    label en official "section 312(h): the proper allocation of earnings and profits between the two corporations, as determined under regulations prescribed by the Secretary (no statutory formula; EXTERNAL_DEPENDENCY on regulations not carried into this package's pinned text)";
}

// --- Section 312(k): depreciation for E&P purposes -------------------------
// EXTERNAL_DEPENDENCY / TECH_GAP: the straight-line recomputation contracts
// to `property-transactions`'s section 167/168 depreciation schedule
// (which this package does not own); only the STRUCTURE of the required
// adjustment (regular-method allowance minus straight-line allowance) is
// classified, not computed with an invented schedule.
pub relation depreciation_allowed_for_regular_tax(c: Corporation, y: TaxableYear, asset: Asset, amount: Money) kind empirical {
    label en official "the depreciation (or amortization) allowance actually claimed for regular tax purposes for the taxable year (contract to section 167/168, owned by `property-transactions`)";
}
pub relation depreciation_straight_line_for_ep(c: Corporation, y: TaxableYear, asset: Asset, amount: Money) kind empirical {
    label en official "section 312(k)(1): the depreciation allowance that would be allowable using the straight line method for the taxable year, for purposes of computing earnings and profits (contract to section 167/168, owned by `property-transactions`; the section 312(k)(2)-(3) unit-of-production and tangible-property exceptions are TECH_GAP, read as a single asserted figure this stage)";
}
pub relation earnings_and_profits_depreciation_adjustment_312k(c: Corporation, y: TaxableYear, asset: Asset, amount: Money) kind institutional {
    label en official "section 312(k)(1): the earnings and profits depreciation adjustment — the excess of the regular-tax allowance over the straight-line allowance for the taxable year, added back to (or subtracted from) earnings and profits computed otherwise";
}
@source(IRC_S312_K, quote = "the allowance for depreciation (and amortization, if any) shall be deemed to be the amount which would be allowable for such year if the straight line method of depreciation had been used for each taxable year beginning after June 30, 1972.")
rule EarningsAndProfitsDepreciationAdjustmentRule(c: Corporation, y: TaxableYear, asset: Asset, regular: Money, straight_line: Money) strict {
    label en official "section 312(k)(1): earnings and profits depreciation is deemed to be the straight-line amount, so the adjustment is the excess of the regular-tax allowance over the straight-line allowance";
    when depreciation_allowed_for_regular_tax(c, y, asset, regular);
    when depreciation_straight_line_for_ep(c, y, asset, straight_line);
    then earnings_and_profits_depreciation_adjustment_312k(c, y, asset, regular - straight_line);
}

// --- Section 312(n): classification of the eight listed adjustment items --
// Every item cross-references a section owned by another package (section
// 263A/263(c), 173, 248/709, 616, 447/471, etc.); none is computed here.
// Modelled as a closed classification enum naming each item, so a coverage
// row can point at a real relation rather than prose, with each item's
// actual adjustment amount left TECH_GAP/EXTERNAL_DEPENDENCY.
enum Section312nItemKind {
    ConstructionPeriodCarryingCharges;
    IntangibleDrillingAndMineralDevelopmentCosts;
    CirculationAndOrganizationalExpenditures;
    LifoInventoryAdjustment;
    InstallmentSalesAdjustment;
    OtherListed312nItem;
}
pub relation earnings_and_profits_adjustment_item_312n(c: Corporation, y: TaxableYear, item: Section312nItemKind, amount: Money) kind empirical {
    label en official "section 312(n)(1)-(8): the amount of a listed adjustment to earnings and profits to more accurately reflect economic gain and loss, by item (construction period carrying charges, intangible drilling/mineral development costs, circulation/organizational expenditures, LIFO inventory, installment sales, and the remaining listed items) — EXTERNAL_DEPENDENCY: each item's own computation is owned by the section it cross-references (263A, 263(c), 173, 248, 709, 616, 453, 472), not this package; read here as a case-asserted figure once that owner exists";
}

// Module footer (technical gap): chaining the per-distribution net effect
// above, section 312(f)/(n)'s per-year items, and module 02's E&P INPUT
// facts into one running year-to-year E&P balance (so that a scenario need
// only assert the corporation's ORIGINAL E&P and every event thereafter,
// rather than the derived current/accumulated totals as of each date) is
// the same self-referential multi-year ledger class as G1/G10/G38 —
// unattempted this stage; see TECH-GAPS.md.
