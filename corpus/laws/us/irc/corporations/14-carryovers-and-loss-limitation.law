// Sections 381 (carryovers in certain corporate acquisitions), 382 (NOL
// limitation after an ownership change), 383 (excess credits and capital
// losses), and 384 (built-in gain limitation on preacquisition losses).
// Stage 2 (IRC-08 stage 2, A06), priority sections.
//
// METHOD: section 381(c)'s carryover item list is a CLOSED classification
// (an enum of the items that carry over, per the coordinator's own framing
// "the (c) items list as classification of what carries over"); the
// items' own substantive computations (net operating loss carryover under
// section 172, earnings and profits history under section 312, capital
// loss carryover, method-of-accounting continuity, etc.) are each owned by
// a DIFFERENT section/package and not recomputed here — EXTERNAL_
// DEPENDENCY/reference, matching the "reference" kind the task brief
// itself lists among the seven dispositive kinds. Section 381(b)'s taxable-
// year-closing operating rule is executable exactly (the acquiring
// corporation's carryback bar is a classification switch). Section 382's
// core arithmetic — the section 382 limitation as value times the long-
// term tax-exempt rate (b)(1), the carryforward of unused limitation
// (b)(2), the continuity-of-business-enterprise zero-limitation rule (c),
// and the built-in gain/loss increase/limitation with the exact numeric
// caps (h)(1) — is modelled as exact calculations. The rate itself is
// SOURCE_GAP (published monthly by the IRS under section 1274(d), never a
// statutory figure — no pinned fragment names it; TECH-GAPS.md "Источник не
// закреплён" class). The section 382(g) ownership-change 50-percentage-
// point test is executable as a COMPARISON over a case-asserted percentage
// shift (the underlying multi-year, multi-shareholder tracking over the
// 3-year testing period is the same self-referential running-ledger class
// as G1/G10/G38 — TECH_GAP, not attempted). Section 382(l)(5)'s bankruptcy
// special rule is modelled to the level of its own election (a power, per
// the task's framing "elections as powers") and the (l)(5)(D) exact-date
// zero-limitation-if-another-change-within-2-years rule; the rest of its
// deep sub-machinery ((l)(5)(A)-(C), (E)-(F)) is TECH_GAP/reference.
// Section 383 is modelled as a direct reference/contract to section 382's
// own limitation (the statute's own "to the extent available after the
// application of section 382" framing). Section 384 is a classification
// (gain corporation, preacquisition loss, the common-control exception)
// with the built-in-gain computation itself contracted to section 382(h).

// --- Section 381: carryovers in certain corporate acquisitions ------------

use self::{
    Corporation,
    IRC_S381_A,
    IRC_S381_B,
    IRC_S381_C,
    IRC_S382_B,
    IRC_S382_C,
    IRC_S382_F,
    IRC_S382_G,
    IRC_S382_H,
    IRC_S382_L,
    IRC_S383_A,
    IRC_S384_A,
    IRC_S384_B,
    ReorganizationTransaction,
    TaxableYear,
};

pub entity CorporateAcquisitionCarryoverEvent { label en unofficial "an acquisition of assets of a distributor/transferor corporation by an acquiring corporation, tested for section 381 carryover succession"; }

@source(IRC_S381_A, quote = "in a distribution to such other corporation to which section 332 (relating to liquidations of subsidiaries) applies; or")
pub relation acquisition_via_332_liquidation(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation) kind empirical {
    label en official "section 381(a)(1): the acquisition is a distribution to which section 332 (liquidation of a subsidiary) applies";
}
@source(IRC_S381_A, quote = "in a transfer to which section 361 (relating to nonrecognition of gain or loss to corporations) applies, but only if the transfer is in connection with a reorganization described in subparagraph (A), (C), (D), (F), or (G) of section 368(a)(1),")
pub relation acquisition_via_361_reorganization_acdfg(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation) kind empirical {
    label en official "section 381(a)(2): the acquisition is a section 361 transfer in connection with a type A, C, D, F, or G reorganization (with the section 381(a) last-sentence proviso that a type D or G reorganization qualifies only if the section 354(b)(1)(A)-(B) requirements are met)";
}
pub relation section_381a_carryover_succession_applies(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation) kind institutional {
    label en official "section 381(a): the acquiring corporation succeeds to and takes into account the section 381(c) items of the transferor corporation, as of the close of the day of distribution or transfer";
}
@source(IRC_S381_A, quote = "the acquiring corporation shall succeed to and take into account, as of the close of the day of distribution or transfer, the items described in subsection (c) of the distributor or transferor corporation, subject to the conditions and limitations specified in subsections (b) and (c).")
rule Section381aFrom332Rule(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation) strict {
    label en official "section 381(a)(1): carryover succession on a section 332 liquidation";
    when acquisition_via_332_liquidation(e, acquiring, transferor);
    then section_381a_carryover_succession_applies(e, acquiring, transferor);
}
@source(IRC_S381_A, quote = "the acquiring corporation shall succeed to and take into account, as of the close of the day of distribution or transfer, the items described in subsection (c) of the distributor or transferor corporation, subject to the conditions and limitations specified in subsections (b) and (c).")
rule Section381aFrom361Rule(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation) strict {
    label en official "section 381(a)(2): carryover succession on a qualifying type A/C/D/F/G reorganization transfer";
    when acquisition_via_361_reorganization_acdfg(e, acquiring, transferor);
    then section_381a_carryover_succession_applies(e, acquiring, transferor);
}

// Section 381(c): the closed classification of items that carry over.
enum Section381cItemKind {
    NetOperatingLossCarryover;
    EarningsAndProfitsHistory;
    CapitalLossCarryover;
    MethodOfAccounting;
    InventoryMethod;
    DepreciationMethod;
    InstallmentMethod;
    DeferredCompensationObligation;
    OtherSection381cItem;
}
pub relation succeeds_to_381c_item(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation, item: Section381cItemKind) kind institutional {
    label en official "section 381(c): the acquiring corporation succeeds to the named item of the transferor corporation — the item's own substantive computation is owned by a different section/package (reference kind), not recomputed here";
}
@source(IRC_S381_C, quote = "The items referred to in subsection (a) are:")
rule SucceedsTo381cItemRule(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation, item: Section381cItemKind) strict {
    label en official "section 381(c): a section 381(a)-qualifying acquisition carries over every listed item, classified by kind";
    when section_381a_carryover_succession_applies(e, acquiring, transferor);
    when section_381c_item_asserted(e, item);
    then succeeds_to_381c_item(e, acquiring, transferor, item);
}
pub relation section_381c_item_asserted(e: CorporateAcquisitionCarryoverEvent, item: Section381cItemKind) kind empirical {
    label en unofficial "the transferor corporation in fact has the named section 381(c) item to carry over (a case fact — whether a transferor HAS, say, a net operating loss carryover is section 172's own computation)";
}

// Section 381(b): operating rules (taxable year closing, no acquirer
// carryback).
@source(IRC_S381_B, quote = "The taxable year of the distributor or transferor corporation shall end on the date of distribution or transfer.")
pub relation transferor_taxable_year_ends_on_transfer_date(e: CorporateAcquisitionCarryoverEvent, transferor: Corporation, on: Date) kind institutional {
    label en official "section 381(b)(1): the transferor corporation's taxable year ends on the date of distribution or transfer (except for a type F reorganization, where the transferor's year does not close)";
}
@source(IRC_S381_B, quote = "The taxable year of the distributor or transferor corporation shall end on the date of distribution or transfer.")
rule TransferorTaxableYearEndsRule(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation, on: Date) strict {
    label en official "section 381(b)(1): the taxable year closing, outside the type F exception";
    when section_381a_carryover_succession_applies(e, acquiring, transferor);
    when distribution_or_transfer_date_381(e, on);
    when not_known(acquisition_is_type_f_reorganization_381b_exists(e));
    then transferor_taxable_year_ends_on_transfer_date(e, transferor, on);
}
pub relation distribution_or_transfer_date_381(e: CorporateAcquisitionCarryoverEvent, on: Date) kind empirical {
    label en official "section 381(b)(2): the date of distribution or transfer";
}
pub relation acquisition_is_type_f_reorganization_381b(e: CorporateAcquisitionCarryoverEvent, r: ReorganizationTransaction) kind empirical {
    label en official "section 381(b): the acquisition is in connection with a section 368(a)(1)(F) reorganization, excepted from the (b)(1)-(3) operating rules";
}
pub relation acquisition_is_type_f_reorganization_381b_exists(e: CorporateAcquisitionCarryoverEvent) kind institutional {
    label en unofficial "witness: the acquisition is a type F reorganization for SOME r (projection helper for the not_known guard, LDC-E0207)";
}
rule AcquisitionIsTypeFReorganization381bExistsRule(e: CorporateAcquisitionCarryoverEvent, r: ReorganizationTransaction) strict {
    label en unofficial "projection helper";
    when acquisition_is_type_f_reorganization_381b(e, r);
    then acquisition_is_type_f_reorganization_381b_exists(e);
}
pub relation acquiring_corp_barred_from_carryback(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation) kind institutional {
    label en official "section 381(b)(3): the acquiring corporation may not carry back a net operating loss or net capital loss for a year ending after the transfer date to a taxable year of the transferor corporation";
}
@source(IRC_S381_B, quote = "The corporation acquiring property in a distribution or transfer described in subsection (a) shall not be entitled to carry back a net operating loss or a net capital loss for a taxable year ending after the date of distribution or transfer to a taxable year of the distributor or transferor corporation.")
rule AcquiringCorpBarredFromCarrybackRule(e: CorporateAcquisitionCarryoverEvent, acquiring: Corporation, transferor: Corporation) strict {
    label en official "section 381(b)(3): the no-carryback-to-transferor rule";
    when section_381a_carryover_succession_applies(e, acquiring, transferor);
    when not_known(acquisition_is_type_f_reorganization_381b_exists(e));
    then acquiring_corp_barred_from_carryback(e, acquiring, transferor);
}

// --- Section 382: NOL limitation after an ownership change -----------------

pub entity OwnershipChangeEvent { label en unofficial "an asserted ownership change of a loss corporation, tested under section 382(g)"; }

// (g)(1): the 50-percentage-point test — executable comparison over a
// case-asserted percentage shift; the underlying 3-year testing-period
// tracking of every 5-percent shareholder's percentage over time is the
// TECH_GAP (same self-referential running-ledger class as G1/G10/G38).
pub relation five_percent_shareholder_percentage_increase(oc: OwnershipChangeEvent, loss_corp: Corporation, increase_points: Decimal) kind empirical {
    label en official "section 382(g)(1): the percentage of stock of the loss corporation owned by one or more 5-percent shareholders, immediately after an owner shift or equity structure shift, LESS the lowest percentage such shareholders owned at any time during the testing period — expressed directly in percentage points (TECH_GAP: the underlying multi-year, multi-shareholder tracking behind this figure is not derived, read as a case-asserted result)";
}
pub relation ownership_change_382g(oc: OwnershipChangeEvent, loss_corp: Corporation) kind institutional {
    label en official "section 382(g)(1): an ownership change has occurred — the 5-percent-shareholder percentage increased by MORE THAN 50 percentage points over the testing period";
}
@source(IRC_S382_G, quote = "the percentage of the stock of the loss corporation owned by 1 or more 5-percent shareholders has increased by more than 50 percentage points, over")
rule OwnershipChange382gRule(oc: OwnershipChangeEvent, loss_corp: Corporation, increase_points: Decimal) strict {
    label en official "section 382(g)(1): exact more-than-50-percentage-point test";
    when five_percent_shareholder_percentage_increase(oc, loss_corp, increase_points);
    when increase_points > 50.0;
    then ownership_change_382g(oc, loss_corp);
}

// (b)(1): the section 382 limitation = value x long-term tax-exempt rate.
// The rate is SOURCE_GAP: published monthly by the IRS under section
// 1274(d)(4), never a statutory figure in the pinned text.
pub relation old_loss_corporation_value_382b1(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "section 382(b)(1)(A): the value of the old loss corporation (generally its stock value immediately before the ownership change, subject to the section 382(e)/(l) adjustments — TECH_GAP for those adjustments, read here as one case-asserted figure)";
}
pub relation long_term_tax_exempt_rate_382b1(oc: OwnershipChangeEvent, rate: Decimal) kind empirical {
    label en official "section 382(b)(1)(B): the long-term tax-exempt rate for the month of the ownership change — SOURCE_GAP: published monthly by the IRS (section 382(f)), no statutory rate in the pinned text; read as a case-asserted figure with its own IRB citation required when a real value is supplied";
}
pub relation post_change_year_382(oc: OwnershipChangeEvent, y: TaxableYear) kind empirical {
    label en unofficial "a post-change year of the new loss corporation following the ownership change, for which a section 382 limitation is computed";
}
pub relation section_382_limitation(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 382(b)(1): the section 382 limitation for a post-change year — the value of the old loss corporation multiplied by the long-term tax-exempt rate";
}
@source(IRC_S382_B, quote = "the value of the old loss corporation, multiplied by")
rule Section382LimitationRule(oc: OwnershipChangeEvent, y: TaxableYear, value: Money, rate: Decimal) strict {
    label en official "section 382(b)(1): exact limitation calculation";
    when ownership_change_382g(oc, _);
    when post_change_year_382(oc, y);
    when old_loss_corporation_value_382b1(oc, value);
    when long_term_tax_exempt_rate_382b1(oc, rate);
    then section_382_limitation(oc, y, round(value * rate, 2, "HALF_UP"));
}

// --- Section 382(f): long-term tax-exempt and adjusted Federal long-term rates from pinned Table 3 ---
// The rates are published monthly by the IRS in Revenue Rulings ("Rates Under Section 382", Table 3).
// This module reads them from the us.irs.rev_rul_afr Table 3 contract
// (section382_table3_rate/2: rate_kind, rate) under the month-index policy
// (corpus/laws/us/rev-rul-afr/month-index.json, table382 per month): a table rule below fires only
// for a pinned month ("2026-08" via Rev. Rul. 2026-13, "2026-10" via Rev. Rul. 2026-19); a month
// absent from the index (e.g. 2026-09) keeps the case-fact path (long_term_tax_exempt_rate_382b1
// above), which is not touched here. The section 382(f)(1) 3-calendar-month highest-of window is
// computed in the published tax-exempt figure by the IRS issue itself (August 2026: 3.77% exceeds
// the current-month adjusted 3.72%), and the section 382(f)(2) construction (the section 1274(d)
// Federal long-term rate without paragraphs (2)-(3), adjusted for taxable/tax-exempt differences)
// is embodied in the published adjusted figure — neither is recomputed here, and only two issues
// are pinned. Every rate number comes from the tables; .law carries only the statutory key
// literals ("adjusted"/"tax_exempt") and the month policy data above — no rate is written here.
pub relation change_month_382f(oc: OwnershipChangeEvent, m: Text) kind empirical {
    label en unofficial "the calendar month (YYYY-MM) of the change date whose Revenue Ruling issue supplies the section 382(f) rates (case-selected: normally the month of the change date)";
}
pub relation table3_month_382f(m: Text) kind institutional {
    label en unofficial "the calendar month (YYYY-MM) whose Revenue Ruling issue governs a Table 3 lookup: a month pinned in the AFR month-index (the freshest ruling of that month)";
}
rule Section382fTableMonth202608 strict {
    label en unofficial "August 2026 is a pinned Table 3 month (Rev. Rul. 2026-13, month-index selection policy)";
    when true;
    then table3_month_382f("2026-08");
}
rule Section382fTableMonth202610 strict {
    label en unofficial "October 2026 is a pinned Table 3 month (Rev. Rul. 2026-19, month-index selection policy)";
    when true;
    then table3_month_382f("2026-10");
}
pub relation adjusted_federal_long_term_rate_from_table_382f(oc: OwnershipChangeEvent, m: Text, rate: Decimal) kind institutional {
    label en official "the adjusted Federal long-term rate for the month from the pinned Table 3 (section 382(f)(2))";
}
@source(IRC_S382_F, relation = formalizes, coverage = partial, quote = "For purposes of paragraph (1), the term \"adjusted Federal long-term rate\" means the Federal long-term rate determined under section 1274(d), except that—")
rule S382AdjustedRateFromTable382f2(oc: OwnershipChangeEvent, m: Text, rate: Decimal) strict {
    label en official "section 382(f)(2): the adjusted Federal long-term rate for a pinned month, read from the published Table 3 (the paragraphs (2)-(3) exclusion and the taxable/tax-exempt adjustment are embodied in the published figure, not recomputed here)";
    when change_month_382f(oc, m);
    when table3_month_382f(m);
    when us.irs.rev_rul_afr::section382_table3_rate("adjusted", rate);
    then adjusted_federal_long_term_rate_from_table_382f(oc, m, rate);
}
pub relation long_term_tax_exempt_rate_from_table_382f(oc: OwnershipChangeEvent, m: Text, rate: Decimal) kind institutional {
    label en official "the long-term tax-exempt rate for ownership changes during the month from the pinned Table 3 (section 382(f)(1))";
}
@source(IRC_S382_F, relation = formalizes, coverage = partial, quote = "The long-term tax-exempt rate shall be the highest of the adjusted Federal long-term rates in effect for any month in the 3-calendar-month period ending with the calendar month in which the change date occurs.")
rule S382TaxExemptRateFromTable382f1(oc: OwnershipChangeEvent, m: Text, rate: Decimal) strict {
    label en official "section 382(f)(1): the long-term tax-exempt rate for a pinned month, read from the published Table 3 (the 3-month highest-of window is computed in the published figure by the IRS issue, not re-derived here — only two issues are pinned)";
    when change_month_382f(oc, m);
    when table3_month_382f(m);
    when us.irs.rev_rul_afr::section382_table3_rate("tax_exempt", rate);
    then long_term_tax_exempt_rate_from_table_382f(oc, m, rate);
}

// (b)(2): carryforward of unused limitation.
pub relation taxable_income_offset_by_prechange_losses(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income of the new loss corporation for the post-change year which was actually offset by pre-change losses, for the section 382(b)(2) carryforward comparison";
}
pub relation section_382_limitation_carryforward(oc: OwnershipChangeEvent, y: TaxableYear, next_y: TaxableYear, amount: Money) kind institutional {
    label en official "section 382(b)(2): the excess of the section 382 limitation over the offset taxable income, added to the NEXT post-change year's limitation";
}
pub relation next_post_change_year_382(y: TaxableYear, next_y: TaxableYear) kind empirical {
    label en unofficial "the post-change year immediately following y, for the section 382(b)(2) carryforward (a term-of-dates helper this package does not derive from a bare TaxableYear, same class as TECH-GAPS G9/G10/G21)";
}
@source(IRC_S382_B, quote = "the section 382 limitation for the next post-change year shall be increased by the amount of such excess.")
rule Section382LimitationCarryforwardRule(oc: OwnershipChangeEvent, y: TaxableYear, next_y: TaxableYear, limitation: Money, offset: Money) strict {
    label en official "section 382(b)(2): carryforward amount is the excess of the limitation over the offset income";
    when section_382_limitation(oc, y, limitation);
    when taxable_income_offset_by_prechange_losses(oc, y, offset);
    when next_post_change_year_382(y, next_y);
    when limitation > offset;
    then section_382_limitation_carryforward(oc, y, next_y, limitation - offset);
}

// (c): continuity of business enterprise for 2 years — zero limitation if
// not maintained.
@source(IRC_S382_C, quote = "if the new loss corporation does not continue the business enterprise of the old loss corporation at all times during the 2-year period beginning on the change date, the section 382 limitation for any post-change year shall be zero.")
pub relation continues_business_enterprise_2_years_382c(oc: OwnershipChangeEvent) kind empirical {
    label en unofficial "the new loss corporation continues the business enterprise of the old loss corporation at all times during the 2-year period beginning on the change date — section 382(c)(1) (reuses the same continuity-of-business-enterprise concept as module 10's section 368 evaluative channel; a distinct fact here because section 382(c)'s own 2-year window is statutory, not regulatory)";
}
pub relation section_382_limitation_zero_382c(oc: OwnershipChangeEvent, y: TaxableYear) kind institutional {
    label en official "section 382(c)(1): the section 382 limitation for the post-change year is zero, continuity of business enterprise not having been maintained";
}
@source(IRC_S382_C, quote = "the section 382 limitation for any post-change year shall be zero.")
rule Section382LimitationZeroRule(oc: OwnershipChangeEvent, y: TaxableYear) strict {
    label en official "section 382(c)(1): zero limitation absent continuity of business enterprise";
    when ownership_change_382g(oc, _);
    when post_change_year_382(oc, y);
    when not_known(continues_business_enterprise_2_years_382c(oc));
    then section_382_limitation_zero_382c(oc, y);
}

// (h)(1): built-in gains/losses — the 15 percent / $10,000,000 threshold
// (section 382(h)(3)(B), read as the net-unrealized-built-in-gain/loss
// classification switch) and the increase/limitation with exact caps.
pub relation net_unrealized_built_in_gain_382h(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "section 382(h)(3)(A): the old loss corporation's net unrealized built-in gain (fair market value of its assets over their aggregate adjusted basis on the change date) — a net unrealized built-in gain/loss exists only if it exceeds the lesser of 15 percent of the value of the corporation's assets or $10,000,000 (section 382(h)(3)(B), TECH_GAP for the full asset-by-asset computation, read as a case-asserted net figure)";
}
pub relation recognized_built_in_gain_for_year_382h(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 382(h)(2)(A): the recognized built-in gain for a recognition-period taxable year — gain on disposition of an asset held on the change date, not exceeding the built-in appreciation as of that date";
}
pub relation prior_years_recognized_built_in_gain_382h(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 382(h)(1)(A)(ii): recognized built-in gains for prior recognition-period taxable years ending in the recognition period, for the section 382(h)(1)(A)(ii) cumulative cap";
}
pub relation section_382h_gain_increase_cap(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 382(h)(1)(A)(ii): the cap on the recognized-built-in-gain increase — net unrealized built-in gain, reduced by recognized built-in gains for prior years";
}
@source(IRC_S382_H, quote = "the net unrealized built-in gain, reduced by")
rule Section382hGainIncreaseCapRule(oc: OwnershipChangeEvent, y: TaxableYear, nubig: Money, prior: Money) strict {
    label en official "section 382(h)(1)(A)(ii): exact cumulative cap calculation";
    when net_unrealized_built_in_gain_382h(oc, nubig);
    when prior_years_recognized_built_in_gain_382h(oc, y, prior);
    then section_382h_gain_increase_cap(oc, y, nubig - prior);
}
pub relation section_382h_limitation_increase(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 382(h)(1)(A)(i)-(ii): the actual increase to the section 382 limitation for the recognition period year — the lesser of the recognized built-in gain for the year and the section 382(h)(1)(A)(ii) cumulative cap";
}
@source(IRC_S382_H, quote = "the section 382 limitation for any recognition period taxable year shall be increased by the recognized built-in gains for such taxable year.")
rule Section382hLimitationIncreaseBelowCapRule(oc: OwnershipChangeEvent, y: TaxableYear, recognized: Money, cap: Money) strict {
    label en official "section 382(h)(1)(A): full recognized gain when below the cap";
    when recognized_built_in_gain_for_year_382h(oc, y, recognized);
    when section_382h_gain_increase_cap(oc, y, cap);
    when recognized <= cap;
    then section_382h_limitation_increase(oc, y, recognized);
}
@source(IRC_S382_H, quote = "The increase under clause (i) for any recognition period taxable year shall not exceed—")
rule Section382hLimitationIncreaseCappedRule(oc: OwnershipChangeEvent, y: TaxableYear, recognized: Money, cap: Money) strict {
    label en official "section 382(h)(1)(A)(ii): capped at the cumulative limit when recognized gain exceeds it";
    when recognized_built_in_gain_for_year_382h(oc, y, recognized);
    when section_382h_gain_increase_cap(oc, y, cap);
    when recognized > cap;
    then section_382h_limitation_increase(oc, y, cap);
}

// (l)(5): the bankruptcy special rule, as an election (power) not to have
// it apply, and the exact-date (D) zero-limitation-on-a-second-change rule.
pub relation new_loss_corp_elects_out_of_382l5(oc: OwnershipChangeEvent, corp: Corporation, filed_on: Date) kind empirical {
    label en official "section 382(l)(5)(G): the new loss corporation elects, subject to Secretary-prescribed terms, not to have the section 382(l)(5) bankruptcy special rule apply";
}
pub relation section_382l5_election_out_valid(oc: OwnershipChangeEvent, corp: Corporation, filed_on: Date) kind institutional {
    label en official "section 382(l)(5)(G): the election-out is treated as validly made once filed (the Secretary's own terms/conditions are EXTERNAL_DEPENDENCY, not separately tested)";
}
rule Section382l5ElectionOutValidRule strict {
    label en official "section 382(l)(5)(G): election-out validity";
    for oc: OwnershipChangeEvent; for corp: Corporation; for filed_on: Date;
    when new_loss_corp_elects_out_of_382l5(oc, corp, filed_on);
    then section_382l5_election_out_valid(oc, corp, filed_on);
}
pub relation section_382l5_election_out_made(oc: OwnershipChangeEvent, corp: Corporation) kind institutional {
    label en official "section 382(l)(5)(G): the new loss corporation has validly elected out of the section 382(l)(5) bankruptcy special rule";
}
@source(IRC_S382_L, quote = "A new loss corporation may elect, subject to such terms and conditions as the Secretary may prescribe, not to have the provisions of this paragraph apply.")
rule Section382l5ElectionOutPowerRule strict {
    label en official "section 382(l)(5)(G): the power to elect out of paragraph (5)";
    for oc: OwnershipChangeEvent; for corp: Corporation; for filed_on: Date;
    when new_loss_corp_elects_out_of_382l5(oc, corp, filed_on);
    then power Section382l5ElectionOut {
        holder corp;
        over oc;
        exercise new_loss_corp_elects_out_of_382l5(oc, corp, filed_on);
        valid_when section_382l5_election_out_valid(oc, corp, filed_on);
        effect create(section_382l5_election_out_made(oc, corp));
        window [@1986-01-01, infinity);
    };
}
pub relation second_ownership_change_date(oc: OwnershipChangeEvent, second_oc: OwnershipChangeEvent, second_change_date: Date) kind empirical {
    label en unofficial "the change date of a second ownership change of the new loss corporation, for the section 382(l)(5)(D) 2-year window test";
}
pub relation first_change_date_382l5(oc: OwnershipChangeEvent, first_change_date: Date) kind empirical {
    label en unofficial "the change date of the first ownership change to which section 382(l)(5) applied, for the section 382(l)(5)(D) 2-year window test";
}
pub relation second_change_within_2_years_382l5d(oc: OwnershipChangeEvent, second_oc: OwnershipChangeEvent) kind institutional {
    label en official "section 382(l)(5)(D): the second ownership change occurs during the 2-year period immediately following the first — exact date test";
}
@source(IRC_S382_L, quote = "If, during the 2-year period immediately following an ownership change to which this paragraph applies, an ownership change of the new loss corporation occurs, this paragraph shall not apply and the section 382 limitation with respect to the 2nd ownership change for any post-change year ending after the change date of the 2nd ownership change shall be zero.")
rule SecondChangeWithin2Years382l5dRule(oc: OwnershipChangeEvent, second_oc: OwnershipChangeEvent, first_change_date: Date, second_change_date: Date) strict {
    label en official "section 382(l)(5)(D): exact 2-year window test";
    when first_change_date_382l5(oc, first_change_date);
    when second_ownership_change_date(oc, second_oc, second_change_date);
    when second_change_date <= add_calendar_period(first_change_date, 2 calendar_year);
    then second_change_within_2_years_382l5d(oc, second_oc);
}
pub relation section_382_limitation_zero_382l5d(second_oc: OwnershipChangeEvent, y: TaxableYear) kind institutional {
    label en official "section 382(l)(5)(D): the section 382 limitation with respect to the second ownership change is zero for any post-change year ending after its change date";
}
rule Section382LimitationZero382l5dRule(oc: OwnershipChangeEvent, second_oc: OwnershipChangeEvent, y: TaxableYear) strict {
    label en official "section 382(l)(5)(D): zero limitation on the second change";
    when second_change_within_2_years_382l5d(oc, second_oc);
    when post_change_year_382(second_oc, y);
    then section_382_limitation_zero_382l5d(second_oc, y);
}

// --- Section 383: excess credits and capital losses -------------------------
// Modelled as a direct reference/contract to section 382's own limitation
// machinery, per the statute's own "to the extent available after the
// application of section 382" framing — no separate arithmetic of its own
// beyond reading the section 382 limitation and the excess-credit/capital-
// loss figures (which are section 39/53/1211's own computations,
// EXTERNAL_DEPENDENCY, not this package's).
pub relation excess_credit_383a2(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 383(a)(2): an unused general business credit (section 39) or unused minimum tax credit (section 53) of the corporation — EXTERNAL_DEPENDENCY, not this package's own computation";
}
pub relation excess_credit_usable_in_post_change_year(corp: Corporation, y: TaxableYear, oc: OwnershipChangeEvent, post_change_y: TaxableYear, amount: Money) kind institutional {
    label en official "section 383(a)(1): the excess credit usable in a post-change year, limited to the tax liability attributable to taxable income not exceeding the section 382 limitation to the extent available after section 382 and section 383(b)-(c)'s own applications — read here as a direct reference to the section 382 limitation figure (the section-1(a)-style tax-liability-attributable-to-income computation itself is EXTERNAL_DEPENDENCY on the rate schedule packages)";
}
@source(IRC_S383_A, quote = "the amount of any excess credit for any taxable year which may be used in any post-change year shall be limited to an amount determined on the basis of the tax liability which is attributable to so much of the taxable income as does not exceed the section 382 limitation for such post-change year")
rule ExcessCreditUsableInPostChangeYearRule(corp: Corporation, y: TaxableYear, oc: OwnershipChangeEvent, post_change_y: TaxableYear, credit: Money, limitation: Money) strict {
    label en official "section 383(a)(1): excess credit usage is capped by the section 382 limitation figure (as a reference, not a re-derivation)";
    when excess_credit_383a2(corp, y, credit);
    when section_382_limitation(oc, post_change_y, limitation);
    when credit <= limitation;
    then excess_credit_usable_in_post_change_year(corp, y, oc, post_change_y, credit);
}

// --- Section 384: built-in gain limitation on preacquisition losses --------

pub relation acquires_control_of_another_corp_384a1a(acquiring: Corporation, acquired: Corporation) kind empirical {
    label en official "section 384(a)(1)(A): a corporation acquires directly (or through one or more other corporations) control of another corporation";
}
pub relation asset_acquisition_via_368a1acd_384a1b(acquiring: Corporation, acquired: Corporation) kind empirical {
    label en official "section 384(a)(1)(B): the assets of a corporation are acquired by another corporation in a type A, C, or D reorganization";
}
pub relation is_gain_corporation_384a2(corp: Corporation) kind empirical {
    label en official "section 384(a)(2): the corporation is a \"gain corporation\" — one with a net unrealized built-in gain (section 384(c)(4), TECH_GAP for the full computation)";
}
pub relation preacquisition_loss_384(loss_corp: Corporation, amount: Money) kind empirical {
    label en official "section 384(c)(3): a preacquisition loss of a corporation (a net operating loss carryforward, or certain built-in losses recognized in the pre-acquisition period) — TECH_GAP for the full definitional decomposition, read as a case fact";
}
pub relation section_384a_applies(acquiring: Corporation, acquired: Corporation, gain_corp: Corporation, loss_corp: Corporation) kind institutional {
    label en official "section 384(a): the preacquisition-loss offset restriction applies — recognized built-in gain income of the gain corporation may not be offset by a preacquisition loss of another party to the acquisition";
}
@source(IRC_S384_A, quote = "income for any recognition period taxable year (to the extent attributable to recognized built-in gains) shall not be offset by any preacquisition loss (other than a preacquisition loss of the gain corporation).")
rule Section384aAppliesFromControlAcquisitionRule(acquiring: Corporation, acquired: Corporation, gain_corp: Corporation, loss_corp: Corporation) strict {
    label en official "section 384(a)(1)(A)-(2): control acquisition plus a gain corporation, absent the section 384(b) common-control exception";
    when acquires_control_of_another_corp_384a1a(acquiring, acquired);
    when is_gain_corporation_384a2(gain_corp);
    when preacquisition_loss_384(loss_corp, _);
    when not_known(common_control_exception_384b_exists(gain_corp, loss_corp));
    then section_384a_applies(acquiring, acquired, gain_corp, loss_corp);
}
@source(IRC_S384_B, quote = "Subsection (a) shall not apply to the preacquisition loss of any corporation if such corporation and the gain corporation were members of the same controlled group at all times during the 5-year period ending on the acquisition date.")
pub relation common_control_exception_384b(gain_corp: Corporation, loss_corp: Corporation) kind empirical {
    label en official "section 384(b)(1): the loss corporation and the gain corporation were members of the same controlled group (section 1563(a), modified: more-than-50-percent, both vote and value, without regard to section 1563(a)(4)) at all times during the 5-year period ending on the acquisition date";
}
pub relation common_control_exception_384b_exists(gain_corp: Corporation, loss_corp: Corporation) kind institutional {
    label en unofficial "witness: the section 384(b) exception applies to the (gain_corp, loss_corp) pair (projection helper, same relation as the rule above — declared for symmetry with the not_known-guard convention this file uses elsewhere)";
}
rule CommonControlException384bExistsRule(gain_corp: Corporation, loss_corp: Corporation) strict {
    label en unofficial "projection helper";
    when common_control_exception_384b(gain_corp, loss_corp);
    then common_control_exception_384b_exists(gain_corp, loss_corp);
}

