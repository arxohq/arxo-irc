// Stage 3b (26.09.2026, TECH_GAP reduction). Section 1561(b) (short taxable
// year), section 1563(a)(3)-(4) (combined and insurance-company controlled
// groups), (b) (component members: excluded, additional and overlapping),
// (c) (excluded stock), (f)(3)-(4) (special ownership rules, franchised
// corporations). Status implemented_unverified: nothing here was executed.

// --- Section 1563(a)(3): combined group ---------------------------------------------

use self::{
    Asset,
    AttributionKind,
    ControlledGroup,
    Corporation,
    IRC_S1561_A,
    IRC_S1561_B,
    IRC_S1563_A,
    IRC_S1563_B,
    IRC_S1563_C,
    IRC_S1563_F,
    Individual,
    Person,
    TaxableYear,
    brother_sister_controlled_group,
    component_member_of_controlled_group,
    constructive_ownership_1563,
    five_or_fewer_owners_combined_voting_share,
    option_to_acquire_stock_1563,
    parent_subsidiary_controlled_group,
    parent_subsidiary_ownership_share,
    principal_function_is_qualified_service_535c2b,
};

pub relation controlled_group_candidate_member_1563a3(cg: ControlledGroup, corp: Corporation) kind empirical {
    label en unofficial "the corporation belongs to the roster of the candidate combined group (a roster is asserted because a count over a derived relation is outside the runtime subset)";
}
pub relation in_parent_subsidiary_group_1563(g: ControlledGroup, corp: Corporation) kind institutional {
    label en official "the corporation is the common parent or a subsidiary in a parent-subsidiary controlled group (section 1563(a)(1))";
}
@source(IRC_S1563_A, quote = "One or more chains of corporations connected through stock ownership with a common parent corporation")
rule Section1563a1ParentMemberRule(g: ControlledGroup, parent: Corporation, sub: Corporation) defeasible {
    label en official "section 1563(a)(1): the common parent is a member of its group";
    when parent_subsidiary_controlled_group(g, parent, sub);
    then in_parent_subsidiary_group_1563(g, parent);
}
@source(IRC_S1563_A, quote = "One or more chains of corporations connected through stock ownership with a common parent corporation")
rule Section1563a1SubsidiaryMemberRule(g: ControlledGroup, parent: Corporation, sub: Corporation) defeasible {
    label en official "section 1563(a)(1): the subsidiary is a member of the group";
    when parent_subsidiary_controlled_group(g, parent, sub);
    then in_parent_subsidiary_group_1563(g, sub);
}
pub relation combined_link_1563a3(cg: ControlledGroup, corp: Corporation, g1: ControlledGroup, g2: ControlledGroup) kind empirical {
    label en official "the corporation is the common parent included in the group g1 described in paragraph (1) and is also included in the group g2 described in paragraph (2) (section 1563(a)(3)(A)-(B))";
}
pub relation combined_group_member_1563a3(cg: ControlledGroup, corp: Corporation) kind institutional {
    label en official "the corporation is a member of the combined group: a member of a paragraph (1) or (2) group linked through a common parent that is also in a paragraph (2) group, with three or more corporations (section 1563(a)(3))";
}
@source(IRC_S1563_A, quote = "Three or more corporations each of which is a member of a group of corporations described in paragraph (1) or (2)")
rule Section1563a3ParentSubsidiaryMemberRule(cg: ControlledGroup, link: Corporation, g1: ControlledGroup, g2: ControlledGroup, m: Corporation) defeasible {
    label en official "section 1563(a)(3): a member of the paragraph (1) group of the link corporation belongs to the combined group";
    when combined_link_1563a3(cg, link, g1, g2);
    when in_parent_subsidiary_group_1563(g1, link);
    when in_parent_subsidiary_group_1563(g1, m);
    when count(collect x: Corporation where controlled_group_candidate_member_1563a3(cg, x)) >= 3;
    then combined_group_member_1563a3(cg, m);
}
@source(IRC_S1563_A, quote = "Three or more corporations each of which is a member of a group of corporations described in paragraph (1) or (2)")
rule Section1563a3BrotherSisterMemberRule(cg: ControlledGroup, link: Corporation, g1: ControlledGroup, g2: ControlledGroup, m: Corporation) defeasible {
    label en official "section 1563(a)(3): a member of the paragraph (2) group that includes the link corporation belongs to the combined group";
    when combined_link_1563a3(cg, link, g1, g2);
    when in_parent_subsidiary_group_1563(g1, link);
    when brother_sister_controlled_group(g2, m);
    when count(collect x: Corporation where controlled_group_candidate_member_1563a3(cg, x)) >= 3;
    then combined_group_member_1563a3(cg, m);
}

// --- Section 1563(a)(4): insurance companies -----------------------------------------

pub relation insurance_company_801_1563a4(corp: Corporation) kind empirical {
    label en official "the corporation is an insurance company subject to taxation under section 801";
}
pub relation member_of_controlled_group_1563(cg: ControlledGroup, corp: Corporation) kind empirical {
    label en unofficial "the corporation is a member of the controlled group of corporations described in paragraph (1), (2) or (3) (asserted membership, used for the paragraph (4) carve-out)";
}
pub relation insurer_roster_1563a4(cg: ControlledGroup, corp: Corporation) kind empirical {
    label en unofficial "the insurance company is on the roster of section 801 insurers of the controlled group (asserted roster: a count over a derived relation is outside the runtime subset)";
}
pub relation election_1504c2_disapplies_1563a4(cg: ControlledGroup) kind empirical {
    label en unofficial "a section 1504(c)(2) election is in effect and section 1563(a)(4) is therefore not effective for the year (section 1504(c)(2)(B)(iii); the link between ControlledGroup and AffiliatedGroup is asserted, G4008)";
}
pub relation insurance_subgroup_member_1563a4(cg: ControlledGroup, corp: Corporation) kind institutional {
    label en official "two or more section 801 insurance companies which are members of a controlled group are treated as a separate controlled group from the other members (section 1563(a)(4))";
}
@source(IRC_S1563_A, quote = "Two or more insurance companies subject to taxation under section 801 which are members of a controlled group of corporations described in paragraph (1), (2), or (3).")
rule Section1563a4InsuranceSubgroupRule(cg: ControlledGroup, corp: Corporation) defeasible {
    label en official "section 1563(a)(4): an 801 insurer of a controlled group with at least one other such insurer forms the separate insurance group";
    when insurance_company_801_1563a4(corp);
    when member_of_controlled_group_1563(cg, corp);
    when count(collect x: Corporation where insurer_roster_1563a4(cg, x)) >= 2;
    when not_known(election_1504c2_disapplies_1563a4(cg));
    then insurance_subgroup_member_1563a4(cg, corp);
}
pub relation treated_as_separate_from_other_members_1563a4(cg: ControlledGroup, corp: Corporation) kind institutional {
    label en official "the insurance companies are treated as a controlled group separate from any other corporations which are members of the controlled group (section 1563(a)(4), second sentence)";
}
@source(IRC_S1563_A, quote = "Such insurance companies shall be treated as a controlled group of corporations separate from any other corporations which are members of the controlled group")
rule Section1563a4SeparateRule(cg: ControlledGroup, corp: Corporation) defeasible {
    label en official "section 1563(a)(4), second sentence: separate treatment of the insurance subgroup";
    when insurance_subgroup_member_1563a4(cg, corp);
    then treated_as_separate_from_other_members_1563a4(cg, corp);
}

// --- Section 1563(f)(4): franchised corporation --------------------------------------

pub relation franchise_stock_sale_duty_1563f4a(corp: Corporation) kind empirical {
    label en official "a parent corporation or common owner of the group member is under a duty, arising out of a written agreement, to sell stock of the franchised corporation, which is franchised to sell the products of another member or the common owner (section 1563(f)(4)(A))";
}
@source(IRC_S1563_F, quote = "such stock is to be sold to an employee (or employees) of such franchised corporation pursuant to a bona fide plan designed to eliminate the stock ownership of the parent corporation or of the common owner in the franchised corporation")
pub external judgment relation bona_fide_elimination_plan_1563f4b(corp: Corporation) {
    authority Secretary;
    label en official "section 1563(f)(4)(B): the stock is to be sold to employees pursuant to a bona fide plan designed to eliminate the stock ownership of the parent or common owner — DECISION-0194 evaluative channel";
}
@source(IRC_S1563_F, quote = "provides a reasonable selling price for such stock")
pub external judgment relation reasonable_selling_price_1563f4c1(corp: Corporation) {
    authority Secretary;
    label en official "section 1563(f)(4)(C)(i): the plan provides a reasonable selling price for the stock — DECISION-0194 evaluative channel";
}
pub relation plan_applies_profit_share_to_purchase_1563f4c2(corp: Corporation) kind empirical {
    label en official "the plan requires that a portion of the employee's share of the profits (as compensation or dividend) be applied to the purchase of the stock or of notes, bonds, debentures or similar evidence of indebtedness held by the parent or common owner (section 1563(f)(4)(C)(ii))";
}
pub relation employee_direct_value_share_1563f4d(corp: Corporation, share: Decimal) kind empirical {
    label en official "the share of the total value of all classes of stock of the franchised corporation that the employee (or employees) owns directly (section 1563(f)(4)(D))";
}
pub relation inventory_acquired_from_group_share_1563f4e(corp: Corporation, share: Decimal) kind empirical {
    label en official "the share of the franchised corporation's inventory acquired from members of the controlled group, the common owner, or both (section 1563(f)(4)(E))";
}
pub relation days_all_franchise_conditions_met_1563f4f(corp: Corporation, on: Date, days: Integer) kind empirical {
    label en official "the number of days preceding the December 31 (or the last day of the year if it has none) on which all of conditions (A)-(E) were met (section 1563(f)(4)(F))";
}
pub relation days_preceding_dec_31_in_year_1563f4f(corp: Corporation, on: Date, days: Integer) kind empirical {
    label en official "the number of days of the taxable year preceding the December 31 (or the last day of the year)";
}
pub relation franchised_corporation_1563f4(corp: Corporation, on: Date) kind institutional {
    label en official "the franchised corporation is treated as an excluded member of the group under subsection (b)(2) for the taxable year (section 1563(f)(4))";
}
@source(IRC_S1563_F, quote = "then such franchised corporation shall be treated as an excluded member of such group, under subsection (b)(2), for such taxable year.")
rule Section1563f4FranchisedCorporationRule(corp: Corporation, on: Date, share_d: Decimal, share_e: Decimal, met: Integer, total: Integer) defeasible {
    label en official "section 1563(f)(4): conditions (A)-(F) together make the franchised corporation an excluded member";
    when franchise_stock_sale_duty_1563f4a(corp);
    when bona_fide_elimination_plan_1563f4b(corp);
    when reasonable_selling_price_1563f4c1(corp);
    when plan_applies_profit_share_to_purchase_1563f4c2(corp);
    when employee_direct_value_share_1563f4d(corp, share_d);
    when share_d > 0.20;
    when inventory_acquired_from_group_share_1563f4e(corp, share_e);
    when share_e > 0.50;
    when days_all_franchise_conditions_met_1563f4f(corp, on, met);
    when days_preceding_dec_31_in_year_1563f4f(corp, on, total);
    when met * 2 >= total;
    then franchised_corporation_1563f4(corp, on);
}

// --- Section 1563(b): component members -----------------------------------------------

pub relation member_of_controlled_group_on_1563b(group: ControlledGroup, corp: Corporation, on: Date) kind empirical {
    label en official "the corporation is a member of the controlled group on the December 31 (or on the last day of a short taxable year, section 1561(b)) (section 1563(b)(1)(A))";
}
pub relation days_member_before_1563b(group: ControlledGroup, corp: Corporation, on: Date, days: Integer) kind empirical {
    label en official "the number of days in the taxable year preceding the December 31 on which the corporation was a member of the group (section 1563(b)(2)(A), (3))";
}
pub relation days_in_year_before_1563b(corp: Corporation, on: Date, days: Integer) kind empirical {
    label en official "the number of days in the taxable year which precede the December 31";
}
pub relation exempt_501a_1563b2b(corp: Corporation, on: Date) kind empirical {
    label en official "the corporation is exempt from taxation under section 501(a) for the taxable year (section 1563(b)(2)(B))";
}
pub relation taxed_on_unrelated_business_income_511_1563b2b(corp: Corporation, on: Date) kind empirical {
    label en official "the exempt corporation is subject to tax on its unrelated business taxable income under section 511";
}
pub relation foreign_corporation_taxed_under_881_1563b2c(corp: Corporation, on: Date) kind empirical {
    label en official "the corporation is a foreign corporation subject to tax under section 881 for the taxable year (section 1563(b)(2)(C))";
}
pub relation member_of_insurance_group_1563a4_1563b2d(corp: Corporation, on: Date) kind empirical {
    label en official "the section 801 insurer is a member of a controlled group described in subsection (a)(4) (section 1563(b)(2)(D), parenthetical)";
}
pub relation excluded_member_b_to_e_1563b2(group: ControlledGroup, corp: Corporation, on: Date) kind institutional {
    label en official "the corporation is an excluded member by reason of (B), (C), (D) or (E) of paragraph (2)";
}
@source(IRC_S1563_B, quote = "is exempt from taxation under section 501(a) (except a corporation which is subject to tax on its unrelated business taxable income under section 511) for such taxable year")
rule Section1563b2BExemptRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(2)(B): an exempt corporation is excluded unless it is taxed on unrelated business income";
    when member_of_controlled_group_on_1563b(group, corp, on);
    when exempt_501a_1563b2b(corp, on);
    when not_known(taxed_on_unrelated_business_income_511_1563b2b(corp, on));
    then excluded_member_b_to_e_1563b2(group, corp, on);
}
@source(IRC_S1563_B, quote = "is a foreign corporation subject to tax under section 881 for such taxable year")
rule Section1563b2CForeignRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(2)(C): a foreign corporation subject to tax under section 881 is excluded";
    when member_of_controlled_group_on_1563b(group, corp, on);
    when foreign_corporation_taxed_under_881_1563b2c(corp, on);
    then excluded_member_b_to_e_1563b2(group, corp, on);
}
@source(IRC_S1563_B, quote = "is an insurance company subject to taxation under section 801 (other than an insurance company which is a member of a controlled group described in subsection (a)(4)), or")
rule Section1563b2DInsuranceRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(2)(D): an 801 insurer is excluded unless it is a member of an (a)(4) group";
    when member_of_controlled_group_on_1563b(group, corp, on);
    when insurance_company_801_1563a4(corp);
    when not_known(member_of_insurance_group_1563a4_1563b2d(corp, on));
    when not_known(election_1504c2_disapplies_1563a4(group));
    then excluded_member_b_to_e_1563b2(group, corp, on);
}
@source(IRC_S1563_B, quote = "is a franchised corporation, as defined in subsection (f)(4).")
rule Section1563b2EFranchisedRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(2)(E): a franchised corporation is excluded";
    when member_of_controlled_group_on_1563b(group, corp, on);
    when franchised_corporation_1563f4(corp, on);
    then excluded_member_b_to_e_1563b2(group, corp, on);
}
pub relation excluded_member_1563b2(group: ControlledGroup, corp: Corporation, on: Date) kind institutional {
    label en official "the corporation, a member on the December 31, is treated as an excluded member for the taxable year including it (section 1563(b)(2))";
}
@source(IRC_S1563_B, quote = "is a member of such group for less than one-half the number of days in such taxable year which precede such December 31")
rule Section1563b2AShortMembershipRule(group: ControlledGroup, corp: Corporation, on: Date, days: Integer, total: Integer) defeasible {
    label en official "section 1563(b)(2)(A): a member for fewer than one-half of the preceding days of the year is excluded";
    when member_of_controlled_group_on_1563b(group, corp, on);
    when days_member_before_1563b(group, corp, on, days);
    when days_in_year_before_1563b(corp, on, total);
    when days * 2 < total;
    then excluded_member_1563b2(group, corp, on);
}
@source(IRC_S1563_B, quote = "A corporation which is a member of a controlled group of corporations on December 31 of any taxable year shall be treated as an excluded member of such group for the taxable year including such December 31 if such corporation—")
rule Section1563b2OtherExclusionsRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(2)(B)-(E): the other exclusions make the corporation an excluded member";
    when excluded_member_b_to_e_1563b2(group, corp, on);
    then excluded_member_1563b2(group, corp, on);
}
pub relation additional_member_1563b3(group: ControlledGroup, corp: Corporation, on: Date) kind institutional {
    label en official "the corporation, not a member on the December 31, is treated as an additional member (section 1563(b)(3))";
}
pub relation member_at_some_time_in_calendar_year_1563b3a(group: ControlledGroup, corp: Corporation, on: Date) kind empirical {
    label en official "the corporation was a member of the controlled group at any time during the calendar year (section 1563(b)(3)(A))";
}
pub relation additional_candidate_exclusion_b_to_e_1563b3c(group: ControlledGroup, corp: Corporation, on: Date) kind institutional {
    label en unofficial "helper: the corporation, not a member on December 31, is described in (2)(B), (C), (D) or (E) with respect to the group";
}
@source(IRC_S1563_B, quote = "is not described, with respect to such group, in subparagraph (B), (C), (D), or (E) of paragraph (2)")
rule Section1563b3cExemptRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(3)(C): an exempt corporation is not an additional member";
    when member_at_some_time_in_calendar_year_1563b3a(group, corp, on);
    when exempt_501a_1563b2b(corp, on);
    when not_known(taxed_on_unrelated_business_income_511_1563b2b(corp, on));
    then additional_candidate_exclusion_b_to_e_1563b3c(group, corp, on);
}
@source(IRC_S1563_B, quote = "is not described, with respect to such group, in subparagraph (B), (C), (D), or (E) of paragraph (2)")
rule Section1563b3cForeignRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(3)(C): a foreign corporation taxed under section 881 is not an additional member";
    when member_at_some_time_in_calendar_year_1563b3a(group, corp, on);
    when foreign_corporation_taxed_under_881_1563b2c(corp, on);
    then additional_candidate_exclusion_b_to_e_1563b3c(group, corp, on);
}
@source(IRC_S1563_B, quote = "is not described, with respect to such group, in subparagraph (B), (C), (D), or (E) of paragraph (2)")
rule Section1563b3cInsuranceRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(3)(C): an 801 insurer outside an (a)(4) group is not an additional member";
    when member_at_some_time_in_calendar_year_1563b3a(group, corp, on);
    when insurance_company_801_1563a4(corp);
    when not_known(member_of_insurance_group_1563a4_1563b2d(corp, on));
    when not_known(election_1504c2_disapplies_1563a4(group));
    then additional_candidate_exclusion_b_to_e_1563b3c(group, corp, on);
}
@source(IRC_S1563_B, quote = "is not described, with respect to such group, in subparagraph (B), (C), (D), or (E) of paragraph (2)")
rule Section1563b3cFranchisedRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(3)(C): a franchised corporation is not an additional member";
    when member_at_some_time_in_calendar_year_1563b3a(group, corp, on);
    when franchised_corporation_1563f4(corp, on);
    then additional_candidate_exclusion_b_to_e_1563b3c(group, corp, on);
}
@source(IRC_S1563_B, quote = "shall be treated as an additional member of such group on December 31 for its taxable year including such December 31 if it was a member of such group for one-half (or more) of the number of days in such taxable year which precede such December 31.")
rule Section1563b3AdditionalMemberRule(group: ControlledGroup, corp: Corporation, on: Date, days: Integer, total: Integer) defeasible {
    label en official "section 1563(b)(3): a corporation that was a member during the calendar year but not on December 31 is an additional member when a member for one-half or more of the preceding days and not described in (2)(B)-(E)";
    when member_at_some_time_in_calendar_year_1563b3a(group, corp, on);
    when not_known(member_of_controlled_group_on_1563b(group, corp, on));
    when not_known(additional_candidate_exclusion_b_to_e_1563b3c(group, corp, on));
    when days_member_before_1563b(group, corp, on, days);
    when days_in_year_before_1563b(corp, on, total);
    when days * 2 >= total;
    then additional_member_1563b3(group, corp, on);
}
@source(IRC_S1563_B, quote = "is a member of such controlled group of corporations on the December 31 included in such year and is not treated as an excluded member under paragraph (2), or")
rule Section1563b1AMemberRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(1)(A): a member on the December 31 that is not an excluded member is a component member";
    when member_of_controlled_group_on_1563b(group, corp, on);
    when not_known(excluded_member_1563b2(group, corp, on));
    then component_member_of_controlled_group(group, corp, on);
}
@source(IRC_S1563_B, quote = "is not a member of such controlled group of corporations on the December 31 included in such year but is treated as an additional member under paragraph (3).")
rule Section1563b1BAdditionalRule(group: ControlledGroup, corp: Corporation, on: Date) defeasible {
    label en official "section 1563(b)(1)(B): an additional member is a component member";
    when additional_member_1563b3(group, corp, on);
    then component_member_of_controlled_group(group, corp, on);
}
pub relation regulations_select_group_1563b4(corp: Corporation, on: Date, group: ControlledGroup) kind empirical {
    label en official "under regulations prescribed by the Secretary the corporation is treated as a component member of only this group (section 1563(b)(4))";
}
pub relation component_member_of_only_one_group_1563b4(corp: Corporation, on: Date, group: ControlledGroup) kind institutional {
    label en official "a corporation that is a component member of more than one controlled group is treated as a component member of only one, selected under the regulations (section 1563(b)(4))";
}
@source(IRC_S1563_B, quote = "such corporation shall be treated as a component member of only one controlled group.")
rule Section1563b4OverlapRule(corp: Corporation, on: Date, chosen: ControlledGroup, other: ControlledGroup) defeasible {
    label en official "section 1563(b)(4): of several groups the regulations select one";
    when component_member_of_controlled_group(chosen, corp, on);
    when component_member_of_controlled_group(other, corp, on);
    when regulations_select_group_1563b4(corp, on, chosen);
    then component_member_of_only_one_group_1563b4(corp, on, chosen);
}

// --- Section 1561(b): short taxable years ------------------------------------------------

pub relation short_year_without_dec_31_1561b(corp: Corporation, last_day: Date) kind empirical {
    label en official "the corporation has a short taxable year which does not include a December 31, ending on the given last day (section 1561(b))";
}
pub relation service_corporation_member_1561a(group: ControlledGroup, on: Date) kind institutional {
    label en unofficial "helper: some component member is a corporation described in section 535(c)(2)(B)";
}
@source(IRC_S1561_A, quote = "($150,000 if any component member is a corporation described in section 535(c)(2)(B))")
rule Section1561aServiceMemberHelperRule(group: ControlledGroup, m: Corporation, on: Date, y: TaxableYear) defeasible {
    label en unofficial "helper: a component member whose principal function is a qualified service";
    when component_member_of_controlled_group(group, m, on);
    when principal_function_is_qualified_service_535c2b(m, y);
    then service_corporation_member_1561a(group, on);
}
pub relation group_credit_amount_1561a(group: ControlledGroup, on: Date, amount: Money) kind institutional {
    label en official "the one $250,000 ($150,000 if any component member is a section 535(c)(2)(B) corporation) amount of the group for computing the accumulated earnings credit (section 1561(a))";
}
@source(IRC_S1561_A, quote = "be limited for purposes of this subtitle to one $250,000 ($150,000 if any component member is a corporation described in section 535(c)(2)(B)) amount")
rule Section1561aGeneralAmountRule(group: ControlledGroup, on: Date, m: Corporation) defeasible {
    label en official "section 1561(a): the $250,000 amount (the statutory floor of section 535(c)(2)(A), A3 parameter MinimumCreditFloorGeneral) absent a section 535(c)(2)(B) member; note the A3 parameter is a head argument here, same shape as MinimumCreditFloorGeneralRule of module 15";
    when component_member_of_controlled_group(group, m, on);
    when not_known(service_corporation_member_1561a(group, on));
    then group_credit_amount_1561a(group, on, MinimumCreditFloorGeneral);
}
@source(IRC_S1561_A, quote = "($150,000 if any component member is a corporation described in section 535(c)(2)(B))")
rule Section1561aServiceAmountRule(group: ControlledGroup, on: Date) defeasible {
    label en official "section 1561(a): the $150,000 amount (A3 parameter MinimumCreditFloorServiceCorporation) when a component member is a section 535(c)(2)(B) corporation";
    when service_corporation_member_1561a(group, on);
    then group_credit_amount_1561a(group, on, MinimumCreditFloorServiceCorporation);
}
pub relation component_member_count_on_last_day_1561b(group: ControlledGroup, on: Date, members: Integer) kind empirical {
    label en official "the number of corporations which are component members of the group on the last day of the short taxable year (a count over the derived component relation is outside the runtime subset, so the count is asserted, G4009)";
}
pub relation short_year_credit_amount_1561b(group: ControlledGroup, corp: Corporation, on: Date, amount: Money) kind institutional {
    label en official "for a short taxable year without a December 31 the amount used in computing the accumulated earnings credit is the group's amount divided by the number of component members on the last day (section 1561(b))";
}
@source(IRC_S1561_B, quote = "shall be the amount specified in subsection (a) with respect to such group, divided by the number of corporations which are component members of such group on the last day of such taxable year.")
rule Section1561bShortYearRule(group: ControlledGroup, corp: Corporation, last_day: Date, amount: Money, members: Integer) defeasible {
    label en official "section 1561(b): the (a) amount divided equally by the number of component members on the last day (one rounding, cents HALF_UP, JUDGMENT CALL: the statute names none)";
    when short_year_without_dec_31_1561b(corp, last_day);
    when component_member_of_controlled_group(group, corp, last_day);
    when group_credit_amount_1561a(group, last_day, amount);
    when component_member_count_on_last_day_1561b(group, last_day, members);
    when members > 0;
    then short_year_credit_amount_1561b(group, corp, last_day, div_round(amount, members * 1.0, 2, "HALF_UP"));
}

// --- Section 1563(c): certain stock excluded ---------------------------------------------

pub relation stock_nonvoting_limited_preferred_1563c1a(stock: Asset) kind empirical {
    label en official "the stock is nonvoting stock which is limited and preferred as to dividends (section 1563(c)(1)(A))";
}
pub relation treasury_stock_1563c1b(stock: Asset) kind empirical {
    label en official "the stock is treasury stock (section 1563(c)(1)(B))";
}
pub relation excluded_stock_1563c2(stock: Asset) kind institutional {
    label en official "the stock is treated as excluded stock under paragraph (2)";
}
pub relation exclusion_would_defeat_component_membership_1563f3c(stock: Asset) kind empirical {
    label en official "treating the stock as excluded stock would leave the corporation, otherwise a component member of a controlled group by reason of that ownership, not a component member (section 1563(f)(3)(C)) — a counterfactual test supplied by the case";
}
pub relation stock_excluded_from_1563_stock(stock: Asset) kind institutional {
    label en official "for the purposes of the part the term stock does not include this stock (section 1563(c)(1))";
}
@source(IRC_S1563_C, quote = "nonvoting stock which is limited and preferred as to dividends,")
rule Section1563c1ARule(stock: Asset) defeasible {
    label en official "section 1563(c)(1)(A): nonvoting stock limited and preferred as to dividends is not stock";
    when stock_nonvoting_limited_preferred_1563c1a(stock);
    then stock_excluded_from_1563_stock(stock);
}
@source(IRC_S1563_C, quote = "treasury stock, and")
rule Section1563c1BRule(stock: Asset) defeasible {
    label en official "section 1563(c)(1)(B): treasury stock is not stock";
    when treasury_stock_1563c1b(stock);
    then stock_excluded_from_1563_stock(stock);
}
@source(IRC_S1563_C, quote = "stock which is treated as \"excluded stock\" under paragraph (2).")
rule Section1563c1CRule(stock: Asset) defeasible {
    label en official "section 1563(c)(1)(C): excluded stock under paragraph (2) is not stock";
    when excluded_stock_1563c2(stock);
    then stock_excluded_from_1563_stock(stock);
}
pub relation parent_owns_50_percent_of_subsidiary_1563c2a(group: ControlledGroup, parent: Corporation, sub: Corporation) kind institutional {
    label en official "a parent corporation owns (within (d)(1) and (e)(4)) 50 percent or more of the voting power or of the value of a subsidiary (section 1563(c)(2)(A))";
}
@source(IRC_S1563_C, quote = "50 percent or more of the total combined voting power of all classes of stock entitled to vote or 50 percent or more of the total value of shares of all classes of stock in another corporation")
rule Section1563c2AVotingRule(group: ControlledGroup, parent: Corporation, sub: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 1563(c)(2)(A): 50 percent of the voting power";
    when parent_subsidiary_ownership_share(group, parent, sub, voting, value);
    when voting >= 0.50;
    then parent_owns_50_percent_of_subsidiary_1563c2a(group, parent, sub);
}
@source(IRC_S1563_C, quote = "50 percent or more of the total combined voting power of all classes of stock entitled to vote or 50 percent or more of the total value of shares of all classes of stock in another corporation")
rule Section1563c2AValueRule(group: ControlledGroup, parent: Corporation, sub: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 1563(c)(2)(A): 50 percent of the value";
    when parent_subsidiary_ownership_share(group, parent, sub, voting, value);
    when value >= 0.50;
    then parent_owns_50_percent_of_subsidiary_1563c2a(group, parent, sub);
}
pub relation stock_in_sub_held_by_deferred_compensation_trust_1563c2ai(stock: Asset, sub: Corporation, parent: Corporation) kind empirical {
    label en official "the stock in the subsidiary is held by a trust which is part of a plan of deferred compensation for the benefit of the employees of the parent corporation or the subsidiary (section 1563(c)(2)(A)(i))";
}
pub relation stock_in_sub_owned_by_individual_1563c2aii(stock: Asset, sub: Corporation, ind: Individual) kind empirical {
    label en official "the stock in the subsidiary is owned (within (d)(2)) by the individual";
}
pub relation individual_share_in_parent_1563c2aii(ind: Individual, parent: Corporation, voting: Decimal, value: Decimal) kind empirical {
    label en official "the individual owns (within (d)(2)) this share of the voting power and of the value of the parent's stock";
}
pub relation individual_officer_of_1563c2aii(ind: Individual, corp: Corporation) kind empirical {
    label en official "the individual is an officer of the corporation";
}
pub relation principal_stockholder_1563c2aii(ind: Individual, corp: Corporation) kind institutional {
    label en official "principal stockholder: an individual who owns 5 percent or more of the total combined voting power or 5 percent or more of the total value of the stock (section 1563(c)(2)(A)(ii))";
}
@source(IRC_S1563_C, quote = "the term \"principal stockholder\" of a corporation means an individual who owns (within the meaning of subsection (d)(2)) 5 percent or more of the total combined voting power of all classes of stock entitled to vote")
rule Section1563c2AiiPrincipalVotingRule(ind: Individual, corp: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 1563(c)(2)(A)(ii): principal stockholder by voting power";
    when individual_share_in_parent_1563c2aii(ind, corp, voting, value);
    when voting >= 0.05;
    then principal_stockholder_1563c2aii(ind, corp);
}
@source(IRC_S1563_C, quote = "or 5 percent or more of the total value of shares of all classes of stock in such corporation")
rule Section1563c2AiiPrincipalValueRule(ind: Individual, corp: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 1563(c)(2)(A)(ii): principal stockholder by value";
    when individual_share_in_parent_1563c2aii(ind, corp, voting, value);
    when value >= 0.05;
    then principal_stockholder_1563c2aii(ind, corp);
}
pub relation stock_in_sub_owned_by_restricted_employee_1563c2aiii(stock: Asset, sub: Corporation, parent: Corporation) kind empirical {
    label en official "the stock in the subsidiary is owned by an employee of the subsidiary and is subject to conditions running in favor of the parent (or subsidiary) that substantially restrict or limit the right to dispose of it (section 1563(c)(2)(A)(iii))";
}
pub relation stock_in_sub_owned_by_controlled_exempt_org_1563c2aiv(stock: Asset, sub: Corporation, parent: Corporation) kind empirical {
    label en official "the stock in the subsidiary is owned by a section 501 organization, other than the parent, controlled directly or indirectly by the parent, the subsidiary, a principal stockholder or officer of the parent, or a combination (section 1563(c)(2)(A)(iv))";
}
@source(IRC_S1563_C, quote = "stock in the subsidiary corporation held by a trust which is part of a plan of deferred compensation for the benefit of the employees of the parent corporation or the subsidiary corporation,")
rule Section1563c2AiRule(stock: Asset, group: ControlledGroup, parent: Corporation, sub: Corporation) defeasible {
    label en official "section 1563(c)(2)(A)(i): subsidiary stock held by a deferred-compensation trust is excluded stock";
    when parent_owns_50_percent_of_subsidiary_1563c2a(group, parent, sub);
    when stock_in_sub_held_by_deferred_compensation_trust_1563c2ai(stock, sub, parent);
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}
@source(IRC_S1563_C, quote = "stock in the subsidiary corporation owned by an individual (within the meaning of subsection (d)(2)) who is a principal stockholder or officer of the parent corporation.")
rule Section1563c2AiiPrincipalRule(stock: Asset, group: ControlledGroup, parent: Corporation, sub: Corporation, ind: Individual) defeasible {
    label en official "section 1563(c)(2)(A)(ii): subsidiary stock owned by a principal stockholder of the parent is excluded stock";
    when parent_owns_50_percent_of_subsidiary_1563c2a(group, parent, sub);
    when stock_in_sub_owned_by_individual_1563c2aii(stock, sub, ind);
    when principal_stockholder_1563c2aii(ind, parent);
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}
@source(IRC_S1563_C, quote = "stock in the subsidiary corporation owned by an individual (within the meaning of subsection (d)(2)) who is a principal stockholder or officer of the parent corporation.")
rule Section1563c2AiiOfficerRule(stock: Asset, group: ControlledGroup, parent: Corporation, sub: Corporation, ind: Individual) defeasible {
    label en official "section 1563(c)(2)(A)(ii): subsidiary stock owned by an officer of the parent is excluded stock";
    when parent_owns_50_percent_of_subsidiary_1563c2a(group, parent, sub);
    when stock_in_sub_owned_by_individual_1563c2aii(stock, sub, ind);
    when individual_officer_of_1563c2aii(ind, parent);
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}
@source(IRC_S1563_C, quote = "stock in the subsidiary corporation owned (within the meaning of subsection (d)(2)) by an employee of the subsidiary corporation if such stock is subject to conditions which run in favor of such parent (or subsidiary) corporation")
rule Section1563c2AiiiRule(stock: Asset, group: ControlledGroup, parent: Corporation, sub: Corporation) defeasible {
    label en official "section 1563(c)(2)(A)(iii): restricted employee-owned subsidiary stock is excluded stock";
    when parent_owns_50_percent_of_subsidiary_1563c2a(group, parent, sub);
    when stock_in_sub_owned_by_restricted_employee_1563c2aiii(stock, sub, parent);
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}
@source(IRC_S1563_C, quote = "stock in the subsidiary corporation owned (within the meaning of subsection (d)(2)) by an organization (other than the parent corporation) to which section 501")
rule Section1563c2AivRule(stock: Asset, group: ControlledGroup, parent: Corporation, sub: Corporation) defeasible {
    label en official "section 1563(c)(2)(A)(iv): subsidiary stock owned by a controlled section 501 organization is excluded stock";
    when parent_owns_50_percent_of_subsidiary_1563c2a(group, parent, sub);
    when stock_in_sub_owned_by_controlled_exempt_org_1563c2aiv(stock, sub, parent);
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}
pub relation common_owners_own_50_percent_of_corp_1563c2b(group: ControlledGroup, corp: Corporation) kind institutional {
    label en official "5 or fewer common owners (individuals, estates or trusts) own (within (d)(2)) 50 percent or more of the voting power or the value of a corporation (section 1563(c)(2)(B))";
}
@source(IRC_S1563_C, quote = "own (within the meaning of subsection (d)(2)), 50 percent or more of the total combined voting power of all classes of stock entitled to vote or 50 percent or more of the total value of shares of all classes of stock in a corporation")
rule Section1563c2BCommonOwnersRule(group: ControlledGroup, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1563(c)(2)(B): common owners at 50 percent or more (the combined share is the case's identical-ownership figure)";
    when five_or_fewer_owners_combined_voting_share(group, corp, share);
    when share >= 0.50;
    then common_owners_own_50_percent_of_corp_1563c2b(group, corp);
}
pub relation stock_held_by_employees_trust_401a_1563c2bi(stock: Asset, corp: Corporation) kind empirical {
    label en official "the stock is held by an employees' trust described in section 401(a), exempt under section 501(a), for the benefit of the employees of the corporation (section 1563(c)(2)(B)(i))";
}
pub relation stock_owned_by_restricted_employee_1563c2bii(stock: Asset, corp: Corporation) kind empirical {
    label en official "the stock is owned by an employee of the corporation and is subject to conditions running in favor of a common owner or the corporation that substantially restrict or limit the right to dispose of it (section 1563(c)(2)(B)(ii))";
}
pub relation restriction_applies_also_to_common_owner_stock_reciprocal_1563c2bii(stock: Asset) kind empirical {
    label en official "the restricting condition also applies to the stock held by a common owner under a bona fide reciprocal stock purchase arrangement, so it is not treated as restricting the employee (section 1563(c)(2)(B)(ii), second sentence)";
}
pub relation stock_owned_by_controlled_exempt_org_1563c2biii(stock: Asset, corp: Corporation) kind empirical {
    label en official "the stock is owned by a section 501 organization controlled by the corporation, by a principal stockholder, by an officer, or by a combination (section 1563(c)(2)(B)(iii))";
}
@source(IRC_S1563_C, quote = "stock in such corporation held by an employees' trust described in section 401(a) which is exempt from tax under section 501(a), if such trust is for the benefit of the employees of such corporation")
rule Section1563c2BiRule(stock: Asset, group: ControlledGroup, corp: Corporation) defeasible {
    label en official "section 1563(c)(2)(B)(i): stock held by the corporation's employees' trust is excluded stock";
    when common_owners_own_50_percent_of_corp_1563c2b(group, corp);
    when stock_held_by_employees_trust_401a_1563c2bi(stock, corp);
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}
@source(IRC_S1563_C, quote = "such condition shall not be treated as one which restricts or limits the employee's right to dispose of such stock")
rule Section1563c2BiiRule(stock: Asset, group: ControlledGroup, corp: Corporation) defeasible {
    label en official "section 1563(c)(2)(B)(ii): restricted employee-owned stock is excluded stock unless the restriction is part of a reciprocal purchase arrangement";
    when common_owners_own_50_percent_of_corp_1563c2b(group, corp);
    when stock_owned_by_restricted_employee_1563c2bii(stock, corp);
    when not_known(restriction_applies_also_to_common_owner_stock_reciprocal_1563c2bii(stock));
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}
@source(IRC_S1563_C, quote = "stock in such corporation owned (within the meaning of subsection (d)(2)) by an organization to which section 501")
rule Section1563c2BiiiRule(stock: Asset, group: ControlledGroup, corp: Corporation) defeasible {
    label en official "section 1563(c)(2)(B)(iii): stock owned by a controlled section 501 organization is excluded stock";
    when common_owners_own_50_percent_of_corp_1563c2b(group, corp);
    when stock_owned_by_controlled_exempt_org_1563c2biii(stock, corp);
    when not_known(exclusion_would_defeat_component_membership_1563f3c(stock));
    then excluded_stock_1563c2(stock);
}

// --- Section 1563(f)(3): special rules ------------------------------------------------------

pub relation attribution_1563f3a(p: Person, corp: Corporation, share: Decimal, via: AttributionKind) kind institutional {
    label en official "the stock is considered owned by the person under the governing paragraph of subsection (e): an option holder is governed by (e)(1) even if another paragraph also attributes the stock (section 1563(f)(3)(A))";
}
pub relation option_attribution_present_1563f3a(p: Person, corp: Corporation) kind institutional {
    label en unofficial "helper: the person is an option holder of the corporation's stock under (e)(1)";
}
@source(IRC_S1563_F, quote = "If stock may be considered as owned by a person under subsection (e)(1) and under any other paragraph of subsection (e), it shall be considered as owned by him under subsection (e)(1).")
rule Section1563f3aOptionHelperRule(p: Person, corp: Corporation, share: Decimal) defeasible {
    label en unofficial "helper: option attribution exists";
    when option_to_acquire_stock_1563(p, corp, share);
    then option_attribution_present_1563f3a(p, corp);
}
@source(IRC_S1563_F, quote = "it shall be considered as owned by him under subsection (e)(1).")
rule Section1563f3aOptionGovernsRule(p: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1563(f)(3)(A): option attribution governs";
    when constructive_ownership_1563(p, corp, share, Option);
    then attribution_1563f3a(p, corp, share, Option);
}
@source(IRC_S1563_F, quote = "If stock may be considered as owned by a person under subsection (e)(1) and under any other paragraph of subsection (e)")
rule Section1563f3aOtherFamilyRule(p: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1563(f)(3)(A): family attribution counts only when no option attribution exists for the same person and stock";
    when constructive_ownership_1563(p, corp, share, Family);
    when not_known(option_attribution_present_1563f3a(p, corp));
    then attribution_1563f3a(p, corp, share, Family);
}
@source(IRC_S1563_F, quote = "If stock may be considered as owned by a person under subsection (e)(1) and under any other paragraph of subsection (e)")
rule Section1563f3aOtherEntityRule(p: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1563(f)(3)(A): entity attribution counts only when no option attribution exists for the same person and stock";
    when constructive_ownership_1563(p, corp, share, FromEntity);
    when not_known(option_attribution_present_1563f3a(p, corp));
    then attribution_1563f3a(p, corp, share, FromEntity);
}
pub relation stock_owned_by_two_or_more_persons_1563f3b(stock: Asset, person: Person) kind empirical {
    label en official "the stock is owned (within (d)) by two or more persons, one of them being the person";
}
pub relation ownership_by_person_makes_corporation_component_member_1563f3b(stock: Asset, person: Person) kind empirical {
    label en official "the person's ownership of the stock results in the corporation being a component member of a controlled group";
}
pub relation stock_considered_owned_by_1563f3b(stock: Asset, person: Person) kind institutional {
    label en official "stock owned by two or more persons is considered owned by the person whose ownership results in the corporation being a component member (section 1563(f)(3)(B))";
}
@source(IRC_S1563_F, quote = "such stock shall be considered as owned by the person whose ownership of such stock results in the corporation being a component member of a controlled group.")
rule Section1563f3bRule(stock: Asset, person: Person) defeasible {
    label en official "section 1563(f)(3)(B): the stock is assigned to the person whose ownership yields component membership";
    when stock_owned_by_two_or_more_persons_1563f3b(stock, person);
    when ownership_by_person_makes_corporation_component_member_1563f3b(stock, person);
    then stock_considered_owned_by_1563f3b(stock, person);
}
pub relation stock_owned_and_makes_component_member_1563f3c(stock: Asset) kind empirical {
    label en official "stock is owned by a person within (d) and that ownership results in the corporation being a component member of a controlled group (section 1563(f)(3)(C))";
}
pub relation stock_not_treated_as_excluded_1563f3c(stock: Asset) kind institutional {
    label en official "the stock is not treated as excluded stock under (c)(2) because doing so would leave the corporation without component membership (section 1563(f)(3)(C))";
}
@source(IRC_S1563_F, quote = "such stock shall not be treated as excluded stock under subsection (c)(2), if by reason of treating such stock as excluded stock the result is that such corporation is not a component member of a controlled group of corporations.")
rule Section1563f3cRule(stock: Asset) defeasible {
    label en official "section 1563(f)(3)(C): excluded-stock treatment is withdrawn where it would defeat component membership (the counterfactual is a case fact; the (c)(2) rules read it)";
    when stock_owned_and_makes_component_member_1563f3c(stock);
    when exclusion_would_defeat_component_membership_1563f3c(stock);
    then stock_not_treated_as_excluded_1563f3c(stock);
}
