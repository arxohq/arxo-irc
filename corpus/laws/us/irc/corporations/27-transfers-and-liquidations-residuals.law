// Stage 3b (26.09.2026, TECH_GAP reduction). Residuals of Part I and II:
// section 301(c)(3)(B), 311(b)(3), 316(b)(2)-(4), 332(c), 336(d)(2) and (e),
// 337(b) and (d), 351(c), (e) and (g), 354(c), 356(c)-(g), 357(c)(3) and (d),
// 367(d)(2)(A)(i). Status implemented_unverified: nothing here was executed.

// --- Section 301(c)(3)(B): pre-March 1, 1913 increase in value --------------------------

use self::{
    Asset,
    AssumedObligation358,
    ControlledTransfer,
    Corporation,
    DistributionEvent,
    ForeignCorporationExchange,
    IRC_S301_C,
    IRC_S311_B,
    IRC_S316_B,
    IRC_S332_C,
    IRC_S336_D,
    IRC_S336_E,
    IRC_S337_B,
    IRC_S337_D,
    IRC_S351_C,
    IRC_S351_E,
    IRC_S351_G,
    IRC_S354_C,
    IRC_S356_C,
    IRC_S356_D,
    IRC_S356_E,
    IRC_S356_F,
    IRC_S357_C,
    IRC_S357_D,
    IRC_S367_D,
    Liquidation,
    Person,
    ReorganizationExchange,
    StockClass565,
    TaxableYear,
    controls_immediately_after,
    distribution,
    distribution_gain,
    exchange_solely_for_stock_or_securities_354,
    meets_1504a2_ownership,
    no_gain_or_loss_recognized_354,
    non_dividend_portion,
    section_332_applies_to_liquidation,
    section_332_complete_liquidation,
    section_354a2a_limitation_applies,
    section_367d_applies_to_transfer,
    stock_basis,
    total_liabilities_assumed,
    transfer_to_corporation,
    would_qualify_under_354_or_355_but_for_other_property,
};

pub relation distribution_out_of_pre_1913_increase_in_value_301c3b(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the part of the distribution that is out of increase in value accrued before March 1, 1913";
}
pub relation pre_1913_excess_exempt_from_tax_301c3b(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "the non-dividend part of the distribution above the stock basis that is out of pre-1913 increase in value is exempt from tax (section 301(c)(3)(B))";
}
@source(IRC_S301_C, quote = "to the extent that it exceeds the adjusted basis of the stock and to the extent that it is out of increase in value accrued before March 1, 1913, shall be exempt from tax.")
rule Section301c3bWithinExcessRule(dist: DistributionEvent, corp: Corporation, shareholder: Person, on: Date, non_dividend: Money, basis: Money, pre1913: Money) defeasible {
    label en official "section 301(c)(3)(B): the exempt part when the pre-1913 amount does not exceed the excess over basis";
    when distribution(dist, corp, shareholder, on);
    when non_dividend_portion(dist, non_dividend);
    when stock_basis(shareholder, corp, on, basis);
    when distribution_out_of_pre_1913_increase_in_value_301c3b(dist, pre1913);
    when non_dividend > basis;
    when pre1913 <= non_dividend - basis;
    then pre_1913_excess_exempt_from_tax_301c3b(dist, pre1913);
}
@source(IRC_S301_C, quote = "to the extent that it exceeds the adjusted basis of the stock and to the extent that it is out of increase in value accrued before March 1, 1913, shall be exempt from tax.")
rule Section301c3bCappedRule(dist: DistributionEvent, corp: Corporation, shareholder: Person, on: Date, non_dividend: Money, basis: Money, pre1913: Money) defeasible {
    label en official "section 301(c)(3)(B): the exempt part is limited to the excess over basis";
    when distribution(dist, corp, shareholder, on);
    when non_dividend_portion(dist, non_dividend);
    when stock_basis(shareholder, corp, on, basis);
    when distribution_out_of_pre_1913_increase_in_value_301c3b(dist, pre1913);
    when non_dividend > basis;
    when pre1913 > non_dividend - basis;
    then pre_1913_excess_exempt_from_tax_301c3b(dist, non_dividend - basis);
}
pub relation gain_after_pre_1913_exemption_301c3(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "the gain from the sale or exchange of property under (A): the excess over basis less the (B) exempt part (section 301(c)(3)(A), 'except as provided in subparagraph (B)'); module 02 distribution_gain is the gross excess and is not changed";
}
@source(IRC_S301_C, quote = "Except as provided in subparagraph (B), that portion of the distribution which is not a dividend, to the extent that it exceeds the adjusted basis of the stock, shall be treated as gain from the sale or exchange of property.")
rule Section301c3aNetGainRule(dist: DistributionEvent, gross: Money, exempt: Money) defeasible {
    label en official "section 301(c)(3)(A)-(B): the gain net of the exempt part";
    when distribution_gain(dist, gross);
    when pre_1913_excess_exempt_from_tax_301c3b(dist, exempt);
    then gain_after_pre_1913_exemption_301c3(dist, gross - exempt);
}

// --- Section 311(b)(3): partnership or trust interests ---------------------------------

pub relation distributed_property_is_partnership_or_trust_interest_311b3(dist: DistributionEvent) kind empirical {
    label en official "the distributed property consists of an interest in a partnership or trust";
}
pub relation secretary_provides_311b3_regulation(dist: DistributionEvent) kind empirical {
    label en official "the Secretary has by regulations provided that the gain under paragraph (1) is computed without regard to loss attributable to property contributed to the partnership or trust for the principal purpose of recognizing loss on the distribution";
}
pub relation gain_under_311b1_with_contributed_loss_311b3(dist: DistributionEvent, gain: Money, contributed_loss: Money) kind empirical {
    label en official "the gain recognized under paragraph (1), and the loss attributable to property contributed for the principal purpose of recognizing loss";
}
pub relation gain_disregarding_contributed_loss_311b3(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "the gain computed without regard to loss attributable to property contributed for the principal purpose of recognizing loss (section 311(b)(3)); the loss is added back to the gain, JUDGMENT CALL";
}
@source(IRC_S311_B, quote = "the Secretary may by regulations provide that the amount of the gain recognized under paragraph (1) shall be computed without regard to any loss attributable to property contributed to the partnership or trust for the principal purpose of recognizing such loss on the distribution.")
rule Section311b3Rule(dist: DistributionEvent, gain: Money, loss: Money) defeasible {
    label en official "section 311(b)(3): when the regulations so provide, the contributed-property loss does not reduce the gain";
    when distributed_property_is_partnership_or_trust_interest_311b3(dist);
    when secretary_provides_311b3_regulation(dist);
    when gain_under_311b1_with_contributed_loss_311b3(dist, gain, loss);
    then gain_disregarding_contributed_loss_311b3(dist, gain + loss);
}
pub relation secretary_prescribes_311b3_rule(dist: DistributionEvent) kind empirical {
    label en unofficial "the Secretary prescribes the paragraph (3) regulation";
}
@source(IRC_S311_B, quote = "the Secretary may by regulations provide")
rule Section311b3LibertyRule(dist: DistributionEvent, corp: Corporation, shareholder: Person, on: Date) defeasible {
    label en official "section 311(b)(3): the Secretary is at liberty to prescribe the rule";
    when distribution(dist, corp, shareholder, on);
    when distributed_property_is_partnership_or_trust_interest_311b3(dist);
    then liberty SecretaryMayProvideContributedLossRule311b3 {
        holder us.irc.core::Secretary;
        against corp;
        action secretary_prescribes_311b3_rule(dist);
        window [-infinity, infinity];
    };
}

// --- Section 316(b)(2)-(4) -----------------------------------------------------------------------

pub relation personal_holding_company_for_year_of_distribution_316b2ai(c: Corporation, y: TaxableYear) kind empirical {
    label en official "under the law applicable to the taxable year in which the distribution is made, the corporation is a personal holding company (section 316(b)(2)(A)(i))";
}
pub relation personal_holding_company_for_year_in_respect_316b2aii(c: Corporation, y: TaxableYear) kind empirical {
    label en official "for the taxable year in respect of which the distribution is made under section 563(b) or 547 (or the corresponding prior law) the corporation is a personal holding company (section 316(b)(2)(A)(ii))";
}
pub relation uphci_without_316b2_distributions(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the undistributed personal holding company income determined under section 545 without regard to distributions under paragraph (2)";
}
pub relation distribution_of_property_316b2(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "a distribution of property by the corporation to its shareholders for the year";
}
pub relation phc_dividend_316b2a(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "the distribution is also a dividend, to the extent of the undistributed personal holding company income for the year (section 316(b)(2)(A))";
}
pub relation phc_for_316b2a(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "helper: personal holding company under (A)(i) or (ii)";
}
@source(IRC_S316_B, quote = "under the law applicable to the taxable year in which the distribution is made, is a personal holding company (as defined in section 542), or")
rule Section316b2aiRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 316(b)(2)(A)(i)";
    when personal_holding_company_for_year_of_distribution_316b2ai(c, y);
    then phc_for_316b2a(c, y);
}
@source(IRC_S316_B, quote = "is a personal holding company under the law applicable to such taxable year,")
rule Section316b2aiiRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 316(b)(2)(A)(ii)";
    when personal_holding_company_for_year_in_respect_316b2aii(c, y);
    then phc_for_316b2a(c, y);
}
@source(IRC_S316_B, quote = "the term \"dividend\" also means any distribution of property (whether or not a dividend as defined in subsection (a)) made by the corporation to its shareholders, to the extent of its undistributed personal holding company income")
rule Section316b2aWithinRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money, uphci: Money) defeasible {
    label en official "section 316(b)(2)(A): the distribution is a dividend when it does not exceed the undistributed income";
    when phc_for_316b2a(c, y);
    when distribution_of_property_316b2(dist, c, y, amount);
    when uphci_without_316b2_distributions(c, y, uphci);
    when amount <= uphci;
    then phc_dividend_316b2a(dist, amount);
}
@source(IRC_S316_B, quote = "the term \"dividend\" also means any distribution of property (whether or not a dividend as defined in subsection (a)) made by the corporation to its shareholders, to the extent of its undistributed personal holding company income")
rule Section316b2aCappedRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money, uphci: Money) defeasible {
    label en official "section 316(b)(2)(A): the dividend part is limited to the undistributed income";
    when phc_for_316b2a(c, y);
    when distribution_of_property_316b2(dist, c, y, amount);
    when uphci_without_316b2_distributions(c, y, uphci);
    when amount > uphci;
    then phc_dividend_316b2a(dist, uphci);
}
pub relation liquidation_within_24_months_316b2b(dist: DistributionEvent) kind empirical {
    label en official "the distribution is in complete liquidation occurring within 24 months after the adoption of a plan of liquidation (section 316(b)(2)(B))";
}
pub relation amount_to_noncorporate_distributees_316b2bi(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the amounts distributed to distributees other than corporate shareholders";
}
pub relation designated_and_notified_as_dividend_316b2bii(dist: DistributionEvent) kind empirical {
    label en official "the corporation designates the amounts as a dividend distribution and duly notifies the distributees under regulations";
}
pub relation allocable_share_of_uphci_316b2biii(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the distributees' allocable share of the undistributed personal holding company income for the year, computed without regard to subparagraph (B) or section 562(b)";
}
pub relation phc_liquidation_dividend_316b2b(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "a liquidating distribution counted as a dividend by paragraph (2)(B): only to non-corporate distributees, only if designated and notified, not above their allocable share";
}
@source(IRC_S316_B, quote = "For purposes of subparagraph (A), the term \"distribution of property\" includes a distribution in complete liquidation occurring within 24 months after the adoption of a plan of liquidation, but—")
rule Section316b2bWithinRule(dist: DistributionEvent, noncorp: Money, share: Money) defeasible {
    label en official "section 316(b)(2)(B)(i)-(iii): the amount to non-corporate distributees within their allocable share";
    when liquidation_within_24_months_316b2b(dist);
    when designated_and_notified_as_dividend_316b2bii(dist);
    when amount_to_noncorporate_distributees_316b2bi(dist, noncorp);
    when allocable_share_of_uphci_316b2biii(dist, share);
    when noncorp <= share;
    then phc_liquidation_dividend_316b2b(dist, noncorp);
}
@source(IRC_S316_B, quote = "not in excess of the sum of such distributees' allocable share of the undistributed personal holding company income for such year, computed without regard to this subparagraph or section 562(b).")
rule Section316b2bCappedRule(dist: DistributionEvent, noncorp: Money, share: Money) defeasible {
    label en official "section 316(b)(2)(B)(iii): limited to the allocable share";
    when liquidation_within_24_months_316b2b(dist);
    when designated_and_notified_as_dividend_316b2bii(dist);
    when amount_to_noncorporate_distributees_316b2bi(dist, noncorp);
    when allocable_share_of_uphci_316b2biii(dist, share);
    when noncorp > share;
    then phc_liquidation_dividend_316b2b(dist, share);
}
pub relation deficiency_dividend_860f_316b3(dist: DistributionEvent) kind empirical {
    label en official "the distribution constitutes a deficiency dividend as defined in section 860(f) (a RIC or REIT; the section 860 owner package is outside this stage)";
}
pub relation dividend_by_deficiency_316b3(dist: DistributionEvent) kind institutional {
    label en official "the distribution is also a dividend as a deficiency dividend (section 316(b)(3))";
}
@source(IRC_S316_B, quote = "The term \"dividend\" also means any distribution of property (whether or not a dividend as defined in subsection (a)) which constitutes a \"deficiency dividend\" as defined in section 860(f).")
rule Section316b3Rule(dist: DistributionEvent) defeasible {
    label en official "section 316(b)(3): a section 860(f) deficiency dividend is a dividend";
    when deficiency_dividend_860f_316b3(dist);
    then dividend_by_deficiency_316b3(dist);
}
pub relation ric_noncalendar_year_316b4(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the regulated investment company has a taxable year other than a calendar year";
}
pub relation class_distributions_and_earnings_316b4(c: Corporation, y: TaxableYear, cls: StockClass565, distributions: Money, earnings_available: Money) kind empirical {
    label en official "the distributions for the class for the year and the current and accumulated earnings and profits that may be used to pay dividends on it";
}
pub relation class_distributions_before_january_1_316b4(c: Corporation, y: TaxableYear, cls: StockClass565, amount: Money) kind empirical {
    label en official "the distributions for the class made during the portion of the taxable year which precedes January 1";
}
pub relation current_earnings_and_profits_316b4(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the company's current earnings and profits";
}
pub relation current_ep_allocated_to_pre_january_distributions_316b4(c: Corporation, y: TaxableYear, cls: StockClass565, amount: Money) kind institutional {
    label en official "the current earnings and profits allocated first to distributions for the class made before January 1 (section 316(b)(4)); the amount is the lesser of current earnings and profits and those distributions";
}
@source(IRC_S316_B, quote = "the company's current earnings and profits shall, for purposes of subsection (a), be allocated first to distributions with respect to such class of stock made during the portion of the taxable year which precedes January 1.")
rule Section316b4WithinRule(c: Corporation, y: TaxableYear, cls: StockClass565, distributions: Money, available: Money, before: Money, current: Money) defeasible {
    label en official "section 316(b)(4): current earnings cover the pre-January distributions in full";
    when ric_noncalendar_year_316b4(c, y);
    when class_distributions_and_earnings_316b4(c, y, cls, distributions, available);
    when class_distributions_before_january_1_316b4(c, y, cls, before);
    when current_earnings_and_profits_316b4(c, y, current);
    when distributions > available;
    when current >= before;
    then current_ep_allocated_to_pre_january_distributions_316b4(c, y, cls, before);
}
@source(IRC_S316_B, quote = "the company's current earnings and profits shall, for purposes of subsection (a), be allocated first to distributions with respect to such class of stock made during the portion of the taxable year which precedes January 1.")
rule Section316b4CappedRule(c: Corporation, y: TaxableYear, cls: StockClass565, distributions: Money, available: Money, before: Money, current: Money) defeasible {
    label en official "section 316(b)(4): current earnings, when smaller, are allocated entirely to the pre-January distributions";
    when ric_noncalendar_year_316b4(c, y);
    when class_distributions_and_earnings_316b4(c, y, cls, distributions, available);
    when class_distributions_before_january_1_316b4(c, y, cls, before);
    when current_earnings_and_profits_316b4(c, y, current);
    when distributions > available;
    when current < before;
    then current_ep_allocated_to_pre_january_distributions_316b4(c, y, cls, current);
}

// --- Section 332(c): RIC and REIT liquidating distributions ------------------------------

pub relation distribution_from_ric_or_reit_in_complete_liquidation_332c(liq: Liquidation, recipient: Corporation) kind empirical {
    label en official "a corporation receives a distribution from a regulated investment company or a REIT which is considered under subsection (b) as being in complete liquidation of the company or trust";
}
pub relation dividends_paid_deduction_by_reason_of_distribution_332c(liq: Liquidation, amount: Money) kind empirical {
    label en official "the deduction for dividends paid allowable to the company or trust by reason of the distribution";
}
pub relation liquidating_distribution_recognized_as_dividend_332c(liq: Liquidation, recipient: Corporation, amount: Money) kind institutional {
    label en official "the recipient recognizes and treats as a dividend an amount equal to the deduction for dividends paid (section 332(c))";
}
@source(IRC_S332_C, quote = "such corporation shall recognize and treat as a dividend from such company or trust an amount equal to the deduction for dividends paid allowable to such company or trust by reason of such distribution.")
rule Section332cRule(liq: Liquidation, recipient: Corporation, amount: Money) defeasible {
    label en official "section 332(c): the recipient's dividend equals the dividends paid deduction";
    when distribution_from_ric_or_reit_in_complete_liquidation_332c(liq, recipient);
    when dividends_paid_deduction_by_reason_of_distribution_332c(liq, amount);
    then liquidating_distribution_recognized_as_dividend_332c(liq, recipient, amount);
}

// --- Section 336(d)(2), (e) -------------------------------------------------------------------

pub entity LiquidatedProperty336 { label en unofficial "property of a liquidating corporation tested under section 336(d)(2)"; }
pub relation property_acquired_in_351_or_contribution_336d2bi1(prop: LiquidatedProperty336) kind empirical {
    label en official "the property was acquired by the liquidating corporation in a section 351 transaction or as a contribution to capital (section 336(d)(2)(B)(i)(I))";
}
pub relation acquired_as_part_of_loss_plan_336d2bi2(prop: LiquidatedProperty336) kind empirical {
    label en official "the acquisition was part of a plan a principal purpose of which was to recognize loss with respect to the property in connection with the liquidation (section 336(d)(2)(B)(i)(II)); an evaluative element asserted with origin adjudicated";
}
pub relation basis_determined_by_reference_to_described_property_336d2b(prop: LiquidatedProperty336, src: LiquidatedProperty336) kind empirical {
    label en official "the adjusted basis of the property is determined in whole or in part by reference to the adjusted basis of described property (section 336(d)(2)(B)(i), last sentence)";
}
pub relation acquired_on_336d2bii(prop: LiquidatedProperty336, on: Date) kind empirical {
    label en official "the date the property was acquired by the liquidated corporation";
}
pub relation liquidation_plan_adopted_on_336d2bii(prop: LiquidatedProperty336, on: Date) kind empirical {
    label en official "the date of the adoption of the plan of complete liquidation";
}
pub relation regulations_disapply_two_year_presumption_336d2bii(prop: LiquidatedProperty336) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise for the two-year presumption";
}
pub relation treated_as_acquired_as_part_of_loss_plan_336d2bii(prop: LiquidatedProperty336) kind institutional {
    label en official "property acquired in a 351 transaction or contribution within 2 years before the plan adoption is treated as acquired as part of a loss plan, except as regulations provide (section 336(d)(2)(B)(ii))";
}
@source(IRC_S336_D, quote = "any property described in clause (i)(I) acquired by the liquidated corporation after the date 2 years before the date of the adoption of the plan of complete liquidation shall, except as provided in regulations, be treated as acquired as part of a plan described in clause (i)(II).")
rule Section336d2bPresumptionRule(prop: LiquidatedProperty336, acquired: Date, adopted: Date, calendar_before_1: Date) defeasible {
    label en official "section 336(d)(2)(B)(ii): acquisition after the date 2 years before the plan adoption (a day exactly 2 years before is not after it)";
    when property_acquired_in_351_or_contribution_336d2bi1(prop);
    when acquired_on_336d2bii(prop, acquired);
    when liquidation_plan_adopted_on_336d2bii(prop, adopted);
    when acquired > calendar_before_1;
    when not_known(regulations_disapply_two_year_presumption_336d2bii(prop))
        and us.irc.core::civil_calendar_boundary_before(adopted, 2, us.irc.core::CalendarYear, calendar_before_1);
    then treated_as_acquired_as_part_of_loss_plan_336d2bii(prop);
}
pub relation directly_described_336d2b(prop: LiquidatedProperty336) kind institutional {
    label en official "property acquired in a 351 transaction or as a contribution as part of a loss plan (section 336(d)(2)(B)(i)(I)-(II))";
}
@source(IRC_S336_D, quote = "such property is acquired by the liquidating corporation in a transaction to which section 351 applied or as a contribution to capital, and")
rule Section336d2bAdjudicatedRule(prop: LiquidatedProperty336) defeasible {
    label en official "section 336(d)(2)(B)(i): (I) and an adjudicated (II)";
    when property_acquired_in_351_or_contribution_336d2bi1(prop);
    when acquired_as_part_of_loss_plan_336d2bi2(prop);
    then directly_described_336d2b(prop);
}
@source(IRC_S336_D, quote = "such property is acquired by the liquidating corporation in a transaction to which section 351 applied or as a contribution to capital, and")
rule Section336d2bPresumedRule(prop: LiquidatedProperty336) defeasible {
    label en official "section 336(d)(2)(B)(i)-(ii): (I) and the two-year presumption";
    when property_acquired_in_351_or_contribution_336d2bi1(prop);
    when treated_as_acquired_as_part_of_loss_plan_336d2bii(prop);
    then directly_described_336d2b(prop);
}
pub relation property_described_336d2b(prop: LiquidatedProperty336) kind institutional {
    label en official "property described in subparagraph (B): directly described, or with a basis derived from such property (section 336(d)(2)(B))";
}
@source(IRC_S336_D, quote = "such property is acquired by the liquidating corporation in a transaction to which section 351 applied or as a contribution to capital, and")
rule Section336d2bDirectRule(prop: LiquidatedProperty336) defeasible {
    label en official "section 336(d)(2)(B): directly described property";
    when directly_described_336d2b(prop);
    then property_described_336d2b(prop);
}
@source(IRC_S336_D, quote = "Other property shall be treated as so described if the adjusted basis of such other property is determined (in whole or in part) by reference to the adjusted basis of property described in the preceding sentence.")
rule Section336d2bDerivedBasisRule(prop: LiquidatedProperty336, src: LiquidatedProperty336) defeasible {
    label en official "section 336(d)(2)(B)(i), last sentence: derived-basis property";
    when basis_determined_by_reference_to_described_property_336d2b(prop, src);
    when directly_described_336d2b(src);
    then property_described_336d2b(prop);
}
pub relation basis_immediately_after_acquisition_336d2a(prop: LiquidatedProperty336, amount: Money) kind empirical {
    label en official "the adjusted basis of the property immediately after its acquisition by the corporation";
}
pub relation fair_market_value_at_acquisition_336d2a(prop: LiquidatedProperty336, amount: Money) kind empirical {
    label en official "the fair market value of the property at that time";
}
pub relation current_adjusted_basis_for_loss_336d2a(prop: LiquidatedProperty336, amount: Money) kind empirical {
    label en official "the adjusted basis of the property at the sale, exchange or distribution, before the (d)(2) reduction";
}
pub relation basis_for_loss_after_336d2_reduction(prop: LiquidatedProperty336, amount: Money) kind institutional {
    label en official "for determining the loss the adjusted basis is reduced (but not below zero) by the excess of the basis after acquisition over the fair market value then (section 336(d)(2)(A))";
}
@source(IRC_S336_D, quote = "the adjusted basis of such property shall be reduced (but not below zero) by the excess (if any) of—")
rule Section336d2aReductionRule(prop: LiquidatedProperty336, current: Money, basis_at: Money, fmv_at: Money) defeasible {
    label en official "section 336(d)(2)(A): reduction by the built-in loss at acquisition, floored at zero (case: the reduction leaves a positive basis)";
    when property_described_336d2b(prop);
    when current_adjusted_basis_for_loss_336d2a(prop, current);
    when basis_immediately_after_acquisition_336d2a(prop, basis_at);
    when fair_market_value_at_acquisition_336d2a(prop, fmv_at);
    when basis_at > fmv_at;
    when current > basis_at - fmv_at;
    then basis_for_loss_after_336d2_reduction(prop, current - (basis_at - fmv_at));
}
@source(IRC_S336_D, quote = "the adjusted basis of such property shall be reduced (but not below zero) by the excess (if any) of—")
rule Section336d2aFloorRule(prop: LiquidatedProperty336, current: Money, basis_at: Money, fmv_at: Money) defeasible {
    label en official "section 336(d)(2)(A): the reduction exceeds the basis: zero";
    when property_described_336d2b(prop);
    when current_adjusted_basis_for_loss_336d2a(prop, current);
    when basis_immediately_after_acquisition_336d2a(prop, basis_at);
    when fair_market_value_at_acquisition_336d2a(prop, fmv_at);
    when basis_at > fmv_at;
    when current <= basis_at - fmv_at;
    then basis_for_loss_after_336d2_reduction(prop, 0.00 USD);
}
@source(IRC_S336_D, quote = "the adjusted basis of such property shall be reduced (but not below zero) by the excess (if any) of—")
rule Section336d2aNoExcessRule(prop: LiquidatedProperty336, current: Money, basis_at: Money, fmv_at: Money) defeasible {
    label en official "section 336(d)(2)(A): no excess of basis over value at acquisition: no reduction";
    when property_described_336d2b(prop);
    when current_adjusted_basis_for_loss_336d2a(prop, current);
    when basis_immediately_after_acquisition_336d2a(prop, basis_at);
    when fair_market_value_at_acquisition_336d2a(prop, fmv_at);
    when basis_at <= fmv_at;
    then basis_for_loss_after_336d2_reduction(prop, current);
}
pub relation secretary_prescribes_recapture_in_lieu_336d2c(prop: LiquidatedProperty336) kind empirical {
    label en unofficial "the Secretary prescribes regulations under which the gross income of the liquidating corporation for the plan year is increased by the disallowed loss instead of disallowing the loss for a prior year";
}
@source(IRC_S336_D, quote = "The Secretary may prescribe regulations under which, in lieu of disallowing a loss under subparagraph (A) for a prior taxable year, the gross income of the liquidating corporation for the taxable year in which the plan of complete liquidation is adopted shall be increased by the amount of the disallowed loss.")
rule Section336d2cLibertyRule(prop: LiquidatedProperty336, corp: Corporation) defeasible {
    label en official "section 336(d)(2)(C): the Secretary is at liberty to prescribe recapture in lieu of disallowance";
    when property_described_336d2b(prop);
    when liquidating_corporation_of_336d2(prop, corp);
    then liberty SecretaryMayPrescribeRecaptureInLieu336d2C {
        holder us.irc.core::Secretary;
        against corp;
        action secretary_prescribes_recapture_in_lieu_336d2c(prop);
        window [-infinity, infinity];
    };
}
pub relation liquidating_corporation_of_336d2(prop: LiquidatedProperty336, corp: Corporation) kind empirical {
    label en unofficial "the liquidating corporation that holds the property";
}
pub relation election_336e_made(seller: Corporation, target: Corporation) kind empirical {
    label en official "an election is made under regulations to treat the sale, exchange or distribution of the target's stock as a disposition of all of its assets";
}
pub relation seller_owns_1504a2_stock_336e1(seller: Corporation, target: Corporation, on: Date) kind empirical {
    label en official "the corporation owns stock in another corporation meeting the requirements of section 1504(a)(2) (asserted; module 06 meets_1504a2_ownership is read by the helper)";
}
pub relation seller_disposes_of_all_stock_336e2(seller: Corporation, target: Corporation) kind empirical {
    label en official "the corporation sells, exchanges or distributes all of such stock";
}
pub relation stock_disposition_qualifies_for_336e_election(seller: Corporation, target: Corporation) kind institutional {
    label en unofficial "helper: 80-percent stock ownership and disposition of all of it (the single atom of the power's valid_when)";
}
@source(IRC_S336_E, quote = "a corporation owns stock in another corporation meeting the requirements of section 1504(a)(2), and")
rule Section336eQualificationRule(seller: Corporation, target: Corporation, on: Date) defeasible {
    label en unofficial "helper: the (e)(1)-(2) conditions";
    when meets_1504a2_ownership(seller, target, on);
    when seller_disposes_of_all_stock_336e2(seller, target);
    then stock_disposition_qualifies_for_336e_election(seller, target);
}
pub relation stock_disposition_treated_as_asset_disposition_336e(seller: Corporation, target: Corporation) kind institutional {
    label en official "the disposition of the stock is treated as a disposition of all the assets of the target (section 336(e))";
}
@source(IRC_S336_E, quote = "an election may be made to treat such sale, exchange, or distribution as a disposition of all of the assets of such other corporation")
rule Section336eElectionPowerRule strict {
    label en official "section 336(e): the seller's election to treat a qualifying stock disposition as an asset disposition; an election outside the conditions is invalid and has no effect (E-0239)";
    for seller: Corporation;
    for target: Corporation;
    when election_336e_made(seller, target);
    then power Section336eElection {
        holder seller;
        over target;
        exercise election_336e_made(seller, target);
        valid_when stock_disposition_qualifies_for_336e_election(seller, target);
        effect create(stock_disposition_treated_as_asset_disposition_336e(seller, target));
        window [-infinity, infinity];
    };
}
pub relation no_gain_or_loss_on_stock_336e(seller: Corporation, target: Corporation) kind institutional {
    label en official "no gain or loss is recognized on the sale, exchange or distribution of the stock (section 336(e))";
}
@source(IRC_S336_E, quote = "and no gain or loss shall be recognized on the sale, exchange, or distribution of such stock.")
rule Section336eNoStockGainRule(seller: Corporation, target: Corporation) defeasible {
    label en official "section 336(e): the stock itself gives no gain or loss";
    when stock_disposition_treated_as_asset_disposition_336e(seller, target);
    then no_gain_or_loss_on_stock_336e(seller, target);
}

// --- Section 337(b), (d) ---------------------------------------------------------------------------

pub relation indebted_to_80_percent_distributee_on_plan_date_337b1(liq: Liquidation, distributee: Corporation) kind empirical {
    label en official "on the date of the adoption of the plan of liquidation the corporation was indebted to the 80-percent distributee (section 337(b)(1)(B))";
}
pub relation transfer_in_satisfaction_of_indebtedness_337b1(liq: Liquidation, distributee: Corporation, amount: Money) kind empirical {
    label en official "a transfer of property to the 80-percent distributee in satisfaction of that indebtedness, in this amount";
}
pub relation transfer_treated_as_liquidating_distribution_337b1(liq: Liquidation, distributee: Corporation, amount: Money) kind institutional {
    label en official "for sections 336 and 337 the transfer in satisfaction of the indebtedness is treated as a distribution to the 80-percent distributee in the liquidation (section 337(b)(1))";
}
@source(IRC_S337_B, quote = "for purposes of this section and section 336, any transfer of property to the 80-percent distributee in satisfaction of such indebtedness shall be treated as a distribution to such distributee in such liquidation.")
rule Section337b1Rule(liq: Liquidation, distributee: Corporation, amount: Money) defeasible {
    label en official "section 337(b)(1): a section 332 liquidation and the indebtedness on the plan date";
    when section_332_applies_to_liquidation(liq);
    when indebted_to_80_percent_distributee_on_plan_date_337b1(liq, distributee);
    when transfer_in_satisfaction_of_indebtedness_337b1(liq, distributee, amount);
    then transfer_treated_as_liquidating_distribution_337b1(liq, distributee, amount);
}
pub relation distributee_exempt_from_chapter_1_tax_337b2a(distributee: Corporation) kind empirical {
    label en official "the 80-percent distributee is an organization (other than a section 521 cooperative) exempt from the tax imposed by chapter 1";
}
pub relation distributee_described_in_511a2_337b2b(distributee: Corporation) kind empirical {
    label en official "the organization is described in section 511(a)(2)";
}
pub relation uses_property_in_activity_taxed_under_511a_immediately_after_337b2bi(liq: Liquidation, distributee: Corporation) kind empirical {
    label en official "immediately after the distribution the organization uses the property in an activity the income from which is subject to tax under section 511(a)";
}
pub relation liquidation_distributee_337(liq: Liquidation, distributee: Corporation) kind empirical {
    label en unofficial "the 80-percent distributee of the liquidation";
}
pub relation section_337_disapplied_337b2(liq: Liquidation) kind institutional {
    label en official "paragraph (1) and subsection (a) do not apply where the 80-percent distributee is a tax-exempt organization, unless (B) restores them (section 337(b)(2)(A))";
}
pub relation unrelated_use_exception_337b2b(liq: Liquidation, distributee: Corporation) kind institutional {
    label en official "the exception for a section 511(a)(2) organization using the property in a section 511(a) activity (section 337(b)(2)(B)(i))";
}
@source(IRC_S337_B, quote = "Subparagraph (A) shall not apply to any distribution of property to an organization described in section 511(a)(2) if, immediately after such distribution, such organization uses such property in an activity the income from which is subject to tax under section 511(a).")
rule Section337b2biRule(liq: Liquidation, distributee: Corporation) defeasible {
    label en official "section 337(b)(2)(B)(i)";
    when distributee_described_in_511a2_337b2b(distributee);
    when uses_property_in_activity_taxed_under_511a_immediately_after_337b2bi(liq, distributee);
    then unrelated_use_exception_337b2b(liq, distributee);
}
@source(IRC_S337_B, quote = "Except as provided in subparagraph (B), paragraph (1) and subsection (a) shall not apply where the 80-percent distributee is an organization (other than a cooperative described in section 521) which is exempt from the tax imposed by this chapter.")
rule Section337b2aRule(liq: Liquidation, distributee: Corporation) defeasible {
    label en official "section 337(b)(2)(A): the exempt distributee disapplies (a) and (b)(1), unless the unrelated-use exception applies";
    when liquidation_distributee_337(liq, distributee);
    when distributee_exempt_from_chapter_1_tax_337b2a(distributee);
    when not_known(unrelated_use_exception_337b2b(liq, distributee));
    then section_337_disapplied_337b2(liq);
}
pub relation exempt_org_disposes_of_property_337b2bii(liq: Liquidation, distributee: Corporation, gain: Money) kind empirical {
    label en official "the organization disposes of the property, or ceases to use it in the section 511(a) activity (deemed disposition on the cessation date), with this gain";
}
pub relation amount_not_recognized_by_reason_of_337b2bi(liq: Liquidation, amount: Money) kind empirical {
    label en official "the amount not recognized by reason of clause (i)";
}
pub relation gain_included_in_unrelated_business_taxable_income_337b2bii(liq: Liquidation, distributee: Corporation, amount: Money) kind institutional {
    label en official "the gain (not in excess of the amount not recognized by reason of clause (i)) is included in the organization's unrelated business taxable income (section 337(b)(2)(B)(ii))";
}
@source(IRC_S337_B, quote = "any gain (not in excess of the amount not recognized by reason of clause (i)) shall be included in such organization's unrelated business taxable income.")
rule Section337b2biiWithinRule(liq: Liquidation, distributee: Corporation, gain: Money, cap: Money) defeasible {
    label en official "section 337(b)(2)(B)(ii): the gain within the amount not recognized";
    when unrelated_use_exception_337b2b(liq, distributee);
    when exempt_org_disposes_of_property_337b2bii(liq, distributee, gain);
    when amount_not_recognized_by_reason_of_337b2bi(liq, cap);
    when gain <= cap;
    then gain_included_in_unrelated_business_taxable_income_337b2bii(liq, distributee, gain);
}
@source(IRC_S337_B, quote = "any gain (not in excess of the amount not recognized by reason of clause (i)) shall be included in such organization's unrelated business taxable income.")
rule Section337b2biiCappedRule(liq: Liquidation, distributee: Corporation, gain: Money, cap: Money) defeasible {
    label en official "section 337(b)(2)(B)(ii): the gain above the amount not recognized is not included by this rule";
    when unrelated_use_exception_337b2b(liq, distributee);
    when exempt_org_disposes_of_property_337b2bii(liq, distributee, gain);
    when amount_not_recognized_by_reason_of_337b2bi(liq, cap);
    when gain > cap;
    then gain_included_in_unrelated_business_taxable_income_337b2bii(liq, distributee, cap);
}
pub relation regulations_prescribed_337d(liq: Liquidation) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary or appropriate to carry out the purposes of the amendments of the Tax Reform Act of 1986";
}
@source(IRC_S337_D, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to carry out the purposes of the amendments made by subtitle D of title VI of the Tax Reform Act of 1986")
rule Section337dRegulationsDutyRule(liq: Liquidation, owner: Corporation, subsidiary: Corporation) defeasible {
    label en official "section 337(d): the Secretary shall prescribe regulations for a section 332 liquidation; no day count is stated (G4004)";
    when section_332_complete_liquidation(liq, owner, subsidiary);
    then duty Section337dPrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_337d(liq);
            window [-infinity, infinity];
        }
    };
}

// --- Section 351(c), (e), (g) ------------------------------------------------------------------------

pub relation corporate_transferor_distributes_received_stock_351c1(t: ControlledTransfer, transferor: Person) kind empirical {
    label en official "a corporate transferor distributes part or all of the stock in the corporation which it receives in the exchange to its shareholders (section 351(c)(1))";
}
pub relation transferor_control_before_distribution_351c1(t: ControlledTransfer, transferor: Person, corp: Corporation) kind empirical {
    label en official "the transferor (with the other transferors) was in section 368(c) control of the corporation before the distribution of the stock";
}
@source(IRC_S351_C, quote = "the fact that any corporate transferor distributes part or all of the stock in the corporation which it receives in the exchange to its shareholders shall not be taken into account.")
rule Section351c1Rule(t: ControlledTransfer, transferor: Person, corp: Corporation) defeasible {
    label en official "section 351(c)(1): the distribution of the received stock is disregarded in determining control (concludes module 05 controls_immediately_after)";
    when transfer_to_corporation(t, transferor, corp);
    when corporate_transferor_distributes_received_stock_351c1(t, transferor);
    when transferor_control_before_distribution_351c1(t, transferor, corp);
    then controls_immediately_after(t, transferor, corp);
}
pub relation requirements_of_355_met_for_351c2(t: ControlledTransfer) kind empirical {
    label en official "the requirements of section 355 (or so much of section 356 as relates to it) are met for a distribution described in paragraph (1) (section 351(c)(2))";
}
pub relation control_before_later_stock_changes_351c2(t: ControlledTransfer, transferor: Person, corp: Corporation) kind empirical {
    label en official "control of the corporation, disregarding the distributing shareholders' later dispositions of the distributed stock and additional stock issued by the distributed corporation (section 351(c)(2))";
}
@source(IRC_S351_C, quote = "the fact that the shareholders of the distributing corporation dispose of part or all of the distributed stock, or the fact that the corporation whose stock was distributed issues additional stock, shall not be taken into account in determining control for purposes of this section.")
rule Section351c2Rule(t: ControlledTransfer, transferor: Person, corp: Corporation) defeasible {
    label en official "section 351(c)(2): in a section 355 case, later stock changes do not affect control (concludes module 05 controls_immediately_after)";
    when transfer_to_corporation(t, transferor, corp);
    when corporate_transferor_distributes_received_stock_351c1(t, transferor);
    when requirements_of_355_met_for_351c2(t);
    when control_before_later_stock_changes_351c2(t, transferor, corp);
    then controls_immediately_after(t, transferor, corp);
}
pub relation company_is_investment_company_under_regulations_351e1(t: ControlledTransfer, corp: Corporation) kind empirical {
    label en official "the transferee is an investment company: determined by taking into account all stock and securities held by the company, with the section 351(e)(1)(B) items treated as stock and securities (the ratio test is in the regulations, a case fact)";
}
pub relation transfer_to_investment_company_351e1(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "a transfer of property to an investment company (section 351(e)(1))";
}
@source(IRC_S351_E, quote = "A transfer of property to an investment company.")
rule Section351e1Rule(t: ControlledTransfer, transferor: Person, corp: Corporation) defeasible {
    label en official "section 351(e)(1): the transfer is to an investment company";
    when transfer_to_corporation(t, transferor, corp);
    when company_is_investment_company_under_regulations_351e1(t, corp);
    then transfer_to_investment_company_351e1(t, transferor);
}
pub relation title_11_debtor_transfer_351e2(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en official "a transfer of property of a debtor pursuant to a plan while under the jurisdiction of a court in a title 11 or similar case, to the extent the stock received is used to satisfy indebtedness of the debtor";
}
pub relation section_351_excluded_351e(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "section 351 does not apply to the transfer: an investment company transfer (section 351(e)(1)); the partial title 11 exclusion of (e)(2) is the amount relation below";
}
@source(IRC_S351_E, quote = "This section shall not apply to—")
rule Section351eExcludedRule(t: ControlledTransfer, transferor: Person) defeasible {
    label en official "section 351(e)(1): exclusion of an investment company transfer (wired into module 05 Section351NonrecognitionRule)";
    when transfer_to_investment_company_351e1(t, transferor);
    then section_351_excluded_351e(t, transferor);
}
pub relation section_351_excluded_amount_351e2(t: ControlledTransfer, transferor: Person, amount: Money) kind institutional {
    label en official "the part of the transfer to which section 351 does not apply because the stock received satisfies the debtor's indebtedness in a title 11 case (section 351(e)(2)); the exclusion is to the extent of that amount, the rest keeps section 351";
}
@source(IRC_S351_E, quote = "to the extent that the stock received in the exchange is used to satisfy the indebtedness of such debtor.")
rule Section351e2Rule(t: ControlledTransfer, transferor: Person, amount: Money) defeasible {
    label en official "section 351(e)(2)";
    when title_11_debtor_transfer_351e2(t, transferor, amount);
    then section_351_excluded_amount_351e2(t, transferor, amount);
}
pub relation money_351e1bi(asset: Asset) kind empirical {
    label en official "the asset is money";
}
pub relation equity_or_derivative_351e1bii(asset: Asset) kind empirical {
    label en official "the asset is stock or another equity interest in a corporation, an evidence of indebtedness, an option, forward or futures contract, notional principal contract or derivative";
}
pub relation foreign_currency_351e1biii(asset: Asset) kind empirical {
    label en official "the asset is foreign currency";
}
pub relation fund_or_convertible_interest_351e1biv(asset: Asset) kind empirical {
    label en official "the asset is an interest in a REIT, common trust fund, RIC, publicly traded partnership, or another non-corporate equity interest readily convertible into listed assets";
}
pub relation precious_metal_351e1bv(asset: Asset) kind empirical {
    label en official "the asset is an interest in a precious metal";
}
pub relation precious_metal_used_in_active_business_351e1bv(asset: Asset) kind empirical {
    label en official "the metal is used or held in the active conduct of a trade or business after the contribution";
}
pub relation entity_interest_substantially_all_listed_assets_351e1bvi(asset: Asset) kind empirical {
    label en official "the asset is an interest in an entity substantially all of whose assets consist directly or indirectly of listed assets";
}
pub relation regulations_extend_351e1_list_351e1(asset: Asset) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations specify the asset (clauses (vii), (viii))";
}
pub relation regulations_treat_asset_as_not_listed_351e1(asset: Asset) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations treat the asset described in clauses (i) through (v) as not listed (last sentence), or provide otherwise for (v) and (vi)";
}
pub relation treated_as_stock_or_securities_351e1b(asset: Asset) kind institutional {
    label en official "the asset is treated as stock and securities in the investment company determination (section 351(e)(1)(B))";
}
@source(IRC_S351_E, quote = "(i) money,")
rule Section351e1biRule(a: Asset) defeasible {
    label en official "section 351(e)(1)(B)(i)";
    when money_351e1bi(a);
    when not_known(regulations_treat_asset_as_not_listed_351e1(a));
    then treated_as_stock_or_securities_351e1b(a);
}
@source(IRC_S351_E, quote = "(ii) stocks and other equity interests in a corporation, evidences of indebtedness, options, forward or futures contracts, notional principal contracts and derivatives,")
rule Section351e1biiRule(a: Asset) defeasible {
    label en official "section 351(e)(1)(B)(ii)";
    when equity_or_derivative_351e1bii(a);
    when not_known(regulations_treat_asset_as_not_listed_351e1(a));
    then treated_as_stock_or_securities_351e1b(a);
}
@source(IRC_S351_E, quote = "(iii) any foreign currency,")
rule Section351e1biiiRule(a: Asset) defeasible {
    label en official "section 351(e)(1)(B)(iii)";
    when foreign_currency_351e1biii(a);
    when not_known(regulations_treat_asset_as_not_listed_351e1(a));
    then treated_as_stock_or_securities_351e1b(a);
}
@source(IRC_S351_E, quote = "any interest in a real estate investment trust, a common trust fund, a regulated investment company, a publicly-traded partnership")
rule Section351e1bivRule(a: Asset) defeasible {
    label en official "section 351(e)(1)(B)(iv)";
    when fund_or_convertible_interest_351e1biv(a);
    when not_known(regulations_treat_asset_as_not_listed_351e1(a));
    then treated_as_stock_or_securities_351e1b(a);
}
@source(IRC_S351_E, quote = "any interest in a precious metal, unless such metal is used or held in the active conduct of a trade or business after the contribution,")
rule Section351e1bvRule(a: Asset) defeasible {
    label en official "section 351(e)(1)(B)(v): a precious metal, unless used in an active business after the contribution or regulations provide otherwise";
    when precious_metal_351e1bv(a);
    when not_known(precious_metal_used_in_active_business_351e1bv(a));
    when not_known(regulations_treat_asset_as_not_listed_351e1(a));
    then treated_as_stock_or_securities_351e1b(a);
}
@source(IRC_S351_E, quote = "interests in any entity if substantially all of the assets of such entity consist (directly or indirectly) of any assets described in any preceding clause or clause (viii),")
rule Section351e1bviRule(a: Asset) defeasible {
    label en official "section 351(e)(1)(B)(vi): an entity interest look-through (substantially all is asserted)";
    when entity_interest_substantially_all_listed_assets_351e1bvi(a);
    when not_known(regulations_treat_asset_as_not_listed_351e1(a));
    then treated_as_stock_or_securities_351e1b(a);
}
@source(IRC_S351_E, quote = "any other asset specified in regulations prescribed by the Secretary.")
rule Section351e1bviiiRule(a: Asset) defeasible {
    label en official "section 351(e)(1)(B)(vii)-(viii): assets specified in regulations";
    when regulations_extend_351e1_list_351e1(a);
    then treated_as_stock_or_securities_351e1b(a);
}
pub relation preferred_stock_351g3a(stock: Asset) kind empirical {
    label en official "stock which is limited and preferred as to dividends and does not participate in corporate growth to any significant extent (no real and meaningful likelihood of participation, section 351(g)(3)(A))";
}
pub relation holder_put_right_351g2ai(stock: Asset) kind empirical {
    label en official "the holder has the right to require the issuer or a related person to redeem or purchase the stock";
}
pub relation issuer_required_to_redeem_351g2aii(stock: Asset) kind empirical {
    label en official "the issuer or a related person is required to redeem or purchase the stock";
}
pub relation issuer_call_more_likely_than_not_351g2aiii(stock: Asset) kind empirical {
    label en official "the issuer or a related person has the right to redeem or purchase and, as of the issue date, it is more likely than not that the right will be exercised";
}
pub relation dividend_rate_varies_with_index_351g2aiv(stock: Asset) kind empirical {
    label en official "the dividend rate varies in whole or in part, directly or indirectly, with reference to interest rates, commodity prices or other similar indices";
}
pub relation right_exercisable_within_20_years_351g2b(stock: Asset) kind empirical {
    label en official "the right or obligation may be exercised within the 20-year period beginning on the issue date";
}
pub relation contingency_makes_remote_351g2b(stock: Asset) kind empirical {
    label en official "the right or obligation is subject to a contingency which, as of the issue date, makes remote the likelihood of the redemption or purchase";
}
pub relation exercisable_only_on_death_disability_incompetency_351g2ci1(stock: Asset) kind empirical {
    label en official "the right or obligation may be exercised only upon the death, disability or mental incompetency of the holder";
}
pub relation services_stock_exercisable_only_on_separation_351g2ci2(stock: Asset) kind empirical {
    label en official "stock transferred in connection with services (representing reasonable compensation) whose right or obligation may be exercised only upon the holder's separation from service";
}
pub relation stock_in_publicly_traded_corporation_or_becoming_so_351g2cii(stock: Asset) kind empirical {
    label en official "the stock relinquished or acquired is in a corporation any class of whose stock (or that of a related party) is readily tradable, or in one that is to become such in the transaction (section 351(g)(2)(C)(ii))";
}
pub relation feature_excepted_351g2c(stock: Asset) kind institutional {
    label en official "the right or obligation is not treated as described in (A)(i)-(iii) by reason of (C)";
}
@source(IRC_S351_G, quote = "it may be exercised only upon the death, disability, or mental incompetency of the holder, or")
rule Section351g2ci1Rule(stock: Asset) defeasible {
    label en official "section 351(g)(2)(C)(i)(I), unless (C)(ii) removes it";
    when exercisable_only_on_death_disability_incompetency_351g2ci1(stock);
    when not_known(stock_in_publicly_traded_corporation_or_becoming_so_351g2cii(stock));
    then feature_excepted_351g2c(stock);
}
@source(IRC_S351_G, quote = "it may be exercised only upon the holder's separation from service from the issuer or a related person.")
rule Section351g2ci2Rule(stock: Asset) defeasible {
    label en official "section 351(g)(2)(C)(i)(II)";
    when services_stock_exercisable_only_on_separation_351g2ci2(stock);
    then feature_excepted_351g2c(stock);
}
pub relation redemption_feature_within_limits_351g2b(stock: Asset) kind institutional {
    label en official "the (A)(i)-(iii) right or obligation counts only if exercisable within 20 years of issue and not remote by contingency (section 351(g)(2)(B))";
}
@source(IRC_S351_G, quote = "Clauses (i), (ii), and (iii) of subparagraph (A) shall apply only if the right or obligation referred to therein may be exercised within the 20-year period beginning on the issue date of such stock")
rule Section351g2bRule(stock: Asset) defeasible {
    label en official "section 351(g)(2)(B)";
    when right_exercisable_within_20_years_351g2b(stock);
    when not_known(contingency_makes_remote_351g2b(stock));
    then redemption_feature_within_limits_351g2b(stock);
}
pub relation nonqualified_preferred_stock_351g2(stock: Asset) kind institutional {
    label en official "nonqualified preferred stock: preferred stock with a counting put, mandatory redemption or likely call, or an index-linked dividend (section 351(g)(2)(A))";
}
@source(IRC_S351_G, quote = "the holder of such stock has the right to require the issuer or a related person to redeem or purchase the stock,")
rule Section351g2aiRule(stock: Asset) defeasible {
    label en official "section 351(g)(2)(A)(i)";
    when preferred_stock_351g3a(stock);
    when holder_put_right_351g2ai(stock);
    when redemption_feature_within_limits_351g2b(stock);
    when not_known(feature_excepted_351g2c(stock));
    then nonqualified_preferred_stock_351g2(stock);
}
@source(IRC_S351_G, quote = "the issuer or a related person is required to redeem or purchase such stock,")
rule Section351g2aiiRule(stock: Asset) defeasible {
    label en official "section 351(g)(2)(A)(ii)";
    when preferred_stock_351g3a(stock);
    when issuer_required_to_redeem_351g2aii(stock);
    when redemption_feature_within_limits_351g2b(stock);
    when not_known(feature_excepted_351g2c(stock));
    then nonqualified_preferred_stock_351g2(stock);
}
@source(IRC_S351_G, quote = "the issuer or a related person has the right to redeem or purchase the stock and, as of the issue date, it is more likely than not that such right will be exercised, or")
rule Section351g2aiiiRule(stock: Asset) defeasible {
    label en official "section 351(g)(2)(A)(iii)";
    when preferred_stock_351g3a(stock);
    when issuer_call_more_likely_than_not_351g2aiii(stock);
    when redemption_feature_within_limits_351g2b(stock);
    when not_known(feature_excepted_351g2c(stock));
    then nonqualified_preferred_stock_351g2(stock);
}
@source(IRC_S351_G, quote = "the dividend rate on such stock varies in whole or in part (directly or indirectly) with reference to interest rates, commodity prices, or other similar indices.")
rule Section351g2aivRule(stock: Asset) defeasible {
    label en official "section 351(g)(2)(A)(iv)";
    when preferred_stock_351g3a(stock);
    when dividend_rate_varies_with_index_351g2aiv(stock);
    then nonqualified_preferred_stock_351g2(stock);
}
pub relation transferor_receives_stock_351g1(t: ControlledTransfer, transferor: Person, stock: Asset) kind empirical {
    label en official "the transferor receives the stock in the exchange";
}
pub relation transferor_receives_nonqualified_preferred_stock_351g1(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "a person who transfers property to a corporation receives nonqualified preferred stock (section 351(g)(1))";
}
@source(IRC_S351_G, quote = "In the case of a person who transfers property to a corporation and receives nonqualified preferred stock—")
rule Section351g1ReceivesRule(t: ControlledTransfer, transferor: Person, stock: Asset) defeasible {
    label en official "section 351(g)(1): the transferor receives NQPS";
    when transferor_receives_stock_351g1(t, transferor, stock);
    when nonqualified_preferred_stock_351g2(stock);
    then transferor_receives_nonqualified_preferred_stock_351g1(t, transferor);
}
pub relation section_351a_inapplicable_351g1a(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "subsection (a) does not apply to the transferor who receives nonqualified preferred stock (section 351(g)(1)(A)); subsection (b) may then apply under (B) — not wired into module 05, whose boot amount is a case fact (G4026)";
}
@source(IRC_S351_G, quote = "subsection (a) shall not apply to such transferor, and")
rule Section351g1aRule(t: ControlledTransfer, transferor: Person) defeasible {
    label en official "section 351(g)(1)(A)";
    when transferor_receives_nonqualified_preferred_stock_351g1(t, transferor);
    then section_351a_inapplicable_351g1a(t, transferor);
}
pub relation transferor_receives_other_stock_351g1b(t: ControlledTransfer, transferor: Person) kind empirical {
    label en official "the transferor receives stock other than nonqualified preferred stock";
}
pub relation subsection_b_applies_and_nqps_is_other_property_351g1b(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "if (and only if) the transferor also receives other stock: subsection (b) applies and the nonqualified preferred stock is other property (section 351(g)(1)(B))";
}
@source(IRC_S351_G, quote = "if (and only if) the transferor receives stock other than nonqualified preferred stock—")
rule Section351g1bRule(t: ControlledTransfer, transferor: Person) defeasible {
    label en official "section 351(g)(1)(B)(i)-(ii)";
    when transferor_receives_nonqualified_preferred_stock_351g1(t, transferor);
    when transferor_receives_other_stock_351g1b(t, transferor);
    then subsection_b_applies_and_nqps_is_other_property_351g1b(t, transferor);
}
pub relation secretary_prescribes_351g4_regulations(t: ControlledTransfer) kind empirical {
    label en unofficial "the Secretary prescribes regulations to carry out subsection (g) and the related sections";
}
@source(IRC_S351_G, quote = "The Secretary may prescribe such regulations as may be necessary or appropriate to carry out the purposes of this subsection")
rule Section351g4LibertyRule(t: ControlledTransfer, transferor: Person, corp: Corporation) defeasible {
    label en official "section 351(g)(4): the Secretary is at liberty to prescribe regulations";
    when transfer_to_corporation(t, transferor, corp);
    then liberty SecretaryMayPrescribeNqpsRegulations351g4 {
        holder us.irc.core::Secretary;
        against corp;
        action secretary_prescribes_351g4_regulations(t);
        window [-infinity, infinity];
    };
}
pub relation related_person_267b_707b_351g3b(a: Person, b: Person) kind empirical {
    label en official "a person bears to another a relationship described in section 267(b) or 707(b) (section 351(g)(3)(B))";
}
pub relation related_person_for_351g(a: Person, b: Person) kind institutional {
    label en official "a person treated as related to another for section 351(g)";
}
@source(IRC_S351_G, quote = "A person shall be treated as related to another person if they bear a relationship to such other person described in section 267(b) or 707(b).")
rule Section351g3bRule(a: Person, b: Person) defeasible {
    label en official "section 351(g)(3)(B)";
    when related_person_267b_707b_351g3b(a, b);
    then related_person_for_351g(a, b);
}

// --- Section 354(c): railroad reorganizations ---------------------------------------------------------

pub relation railroad_plan_confirmed_under_title_11_section_1173_354c(x: ReorganizationExchange) kind empirical {
    label en official "the exchange is in pursuance of a plan of reorganization (whether or not within section 368(a)) for a railroad confirmed under section 1173 of title 11 as being in the public interest (section 354(c))";
}
@source(IRC_S354_C, quote = "subsection (a)(1) (and so much of section 356 as relates to this section) shall apply with respect to a plan of reorganization (whether or not a reorganization within the meaning of section 368(a)) for a railroad confirmed under section 1173 of title 11 of the United States Code, as being in the public interest.")
rule Section354cRailroadRule(x: ReorganizationExchange, holder: Person, target_corp: Corporation, received_corp: Corporation) defeasible {
    label en official "section 354(c): nonrecognition for a solely-stock-or-securities exchange under a confirmed railroad plan (concludes the module 11 no_gain_or_loss_recognized_354)";
    when railroad_plan_confirmed_under_title_11_section_1173_354c(x);
    when exchange_solely_for_stock_or_securities_354(x, holder, target_corp, received_corp);
    when not_known(section_354a2a_limitation_applies(x));
    then no_gain_or_loss_recognized_354(x, holder);
}

// --- Section 356(c)-(g) -------------------------------------------------------------------------------

pub relation no_loss_recognized_356c(x: ReorganizationExchange, holder: Person) kind institutional {
    label en official "no loss from the exchange or distribution is recognized where section 354 or 355 would apply but for other property or money (section 356(c))";
}
@source(IRC_S356_C, quote = "then no loss from the exchange or distribution shall be recognized.")
rule Section356cRule(x: ReorganizationExchange, holder: Person) defeasible {
    label en official "section 356(c): no loss";
    when would_qualify_under_354_or_355_but_for_other_property(x, holder);
    then no_loss_recognized_356c(x, holder);
}
pub relation securities_principal_received_356d(x: ReorganizationExchange, principal: Money, fmv: Money) kind empirical {
    label en official "the principal amount of the securities received and their fair market value";
}
pub relation securities_principal_surrendered_356d(x: ReorganizationExchange, principal: Money) kind empirical {
    label en official "the principal amount of the securities surrendered (zero if none)";
}
pub relation exchange_is_section_354c_railroad_356d2b(x: ReorganizationExchange) kind empirical {
    label en official "the exchange is under section 354(c) (excluded from (d)(2)(B))";
}
pub relation exchange_is_355_356d2c(x: ReorganizationExchange) kind empirical {
    label en official "the exchange or distribution is described in section 355 (paragraph (2)(C) applies to it in place of (B))";
}
pub relation securities_other_property_356d(x: ReorganizationExchange, amount: Money) kind institutional {
    label en official "the securities that are other property: only the fair market value of the excess principal amount received (section 356(d)(1), (2)(B)-(C)); the excess share of the fair market value is proportional to the principal amounts, JUDGMENT CALL";
}
@source(IRC_S356_D, quote = "then, with respect to such securities received, the term \"other property\" means only the fair market value of such excess.")
rule Section356d2bExcessRule(x: ReorganizationExchange, principal: Money, fmv: Money, surrendered: Money) defeasible {
    label en official "section 356(d)(2)(B): a section 354 exchange with a greater principal amount received";
    when securities_principal_received_356d(x, principal, fmv);
    when securities_principal_surrendered_356d(x, surrendered);
    when not_known(exchange_is_section_354c_railroad_356d2b(x));
    when not_known(exchange_is_355_356d2c(x));
    when principal > surrendered;
    when principal > 0.00 USD;
    then securities_other_property_356d(x, div_round(fmv * ((principal - surrendered) / 1.00 USD), principal / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S356_D, quote = "If, in an exchange or distribution described in section 355, the principal amount of the securities in the controlled corporation which are received exceeds the principal amount of the securities in the distributing corporation which are surrendered")
rule Section356d2cExcessRule(x: ReorganizationExchange, principal: Money, fmv: Money, surrendered: Money) defeasible {
    label en official "section 356(d)(2)(C): a section 355 transaction with a greater principal amount received";
    when securities_principal_received_356d(x, principal, fmv);
    when securities_principal_surrendered_356d(x, surrendered);
    when exchange_is_355_356d2c(x);
    when principal > surrendered;
    when principal > 0.00 USD;
    then securities_other_property_356d(x, div_round(fmv * ((principal - surrendered) / 1.00 USD), principal / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S356_D, quote = "The term \"other property\" does not include securities to the extent that, under section 354 or 355, such securities would be permitted to be received without the recognition of gain.")
rule Section356d2aNoExcessRule(x: ReorganizationExchange, principal: Money, fmv: Money, surrendered: Money) defeasible {
    label en official "section 356(d)(2)(A): securities not exceeding those surrendered are permitted, so not other property";
    when securities_principal_received_356d(x, principal, fmv);
    when securities_principal_surrendered_356d(x, surrendered);
    when principal <= surrendered;
    then securities_other_property_356d(x, 0.00 USD);
}
pub relation nqps_received_356e(x: ReorganizationExchange, stock: Asset, fmv: Money) kind empirical {
    label en official "nonqualified preferred stock (section 351(g)(2)) received in the exchange, with its fair market value";
}
pub relation nqps_permitted_without_recognition_356e2(x: ReorganizationExchange, stock: Asset) kind empirical {
    label en official "under section 354 or 355 the preferred stock would be permitted to be received without recognition of gain";
}
pub relation nqps_other_property_356e(x: ReorganizationExchange, stock: Asset, fmv: Money) kind institutional {
    label en official "nonqualified preferred stock is other property, except to the extent 354 or 355 would permit it (section 356(e))";
}
@source(IRC_S356_E, quote = "the term \"other property\" includes nonqualified preferred stock (as defined in section 351(g)(2)).")
rule Section356e1Rule(x: ReorganizationExchange, stock: Asset, fmv: Money) defeasible {
    label en official "section 356(e)(1), (2)";
    when nqps_received_356e(x, stock, fmv);
    when nonqualified_preferred_stock_351g2(stock);
    when not_known(nqps_permitted_without_recognition_356e2(x, stock));
    then nqps_other_property_356e(x, stock, fmv);
}
pub relation exchange_for_section_306_stock_356f(x: ReorganizationExchange) kind empirical {
    label en official "the other property or money is received in exchange for section 306 stock";
}
pub relation other_property_or_money_for_306_stock_356f(x: ReorganizationExchange, amount: Money) kind empirical {
    label en official "the fair market value of the other property, or the amount of the money, received";
}
pub relation treated_as_section_301_distribution_356f(x: ReorganizationExchange, amount: Money) kind institutional {
    label en official "an amount equal to the fair market value of the other property (or the money) is treated as a distribution of property to which section 301 applies (section 356(f))";
}
@source(IRC_S356_F, quote = "an amount equal to the fair market value of such other property (or the amount of such money) shall be treated as a distribution of property to which section 301 applies.")
rule Section356fRule(x: ReorganizationExchange, amount: Money) defeasible {
    label en official "section 356(f): boot received for section 306 stock is a section 301 distribution";
    when exchange_for_section_306_stock_356f(x);
    when other_property_or_money_for_306_stock_356f(x, amount);
    then treated_as_section_301_distribution_356f(x, amount);
}

// --- Section 357(c)(3), (d) ------------------------------------------------------------------------------

pub relation liability_item_357c3(t: ControlledTransfer, transferor: Person, l: AssumedObligation358, amount: Money) kind empirical {
    label en official "a liability transferred in the exchange, in this amount";
}
pub relation payment_would_give_rise_to_deduction_357c3ai(l: AssumedObligation358) kind empirical {
    label en official "the payment of the liability would give rise to a deduction";
}
pub relation payment_described_in_736a_357c3aii(l: AssumedObligation358) kind empirical {
    label en official "the payment of the liability would be described in section 736(a)";
}
pub relation incurrence_created_or_increased_basis_357c3b(l: AssumedObligation358) kind empirical {
    label en official "the incurrence of the liability resulted in the creation of, or an increase in, the basis of property (to that extent (A) does not apply)";
}
pub relation excluded_liabilities_357c3(t: ControlledTransfer, transferor: Person, amount: Money) kind institutional {
    label en official "the liabilities excluded in determining the amount of liabilities assumed: deduction-generating and section 736(a) liabilities, save to the extent they created basis (section 357(c)(3)); the basis exception is whole-liability here (asserted flag), JUDGMENT CALL";
}
@source(IRC_S357_C, quote = "then, for purposes of paragraph (1), the amount of such liability shall be excluded in determining the amount of liabilities assumed.")
rule Section357c3ExcludedRule(t: ControlledTransfer, transferor: Person) defeasible {
    label en official "section 357(c)(3)(A)-(B): the exact sum of the excluded items (deduction ones, and 736(a) ones not already counted as deduction ones)";
    when liability_item_357c3(t, transferor, _, _);
    then excluded_liabilities_357c3(t, transferor, (sum all amt: Money for l: AssumedObligation358 where liability_item_357c3(t, transferor, l, amt) and payment_would_give_rise_to_deduction_357c3ai(l) and not incurrence_created_or_increased_basis_357c3b(l)) + (sum all amt2: Money for l2: AssumedObligation358 where liability_item_357c3(t, transferor, l2, amt2) and payment_described_in_736a_357c3aii(l2) and not payment_would_give_rise_to_deduction_357c3ai(l2) and not incurrence_created_or_increased_basis_357c3b(l2)));
}
pub relation liability_items_present_357c3(t: ControlledTransfer, transferor: Person) kind institutional {
    label en unofficial "helper: the case lists the transferred liabilities item by item";
}
rule Section357c3ItemsHelperRule(t: ControlledTransfer, transferor: Person) defeasible {
    label en unofficial "helper: item facts exist";
    when liability_item_357c3(t, transferor, _, _);
    then liability_items_present_357c3(t, transferor);
}
pub relation net_liabilities_assumed_357c3(t: ControlledTransfer, transferor: Person, amount: Money) kind institutional {
    label en official "the amount of liabilities assumed for section 357(c)(1): the asserted total (the case has netted the exclusions) or, when the items are listed, the total less the section 357(c)(3) exclusions";
}
rule Section357c3NoItemsRule(t: ControlledTransfer, transferor: Person, total: Money) defeasible {
    label en official "section 357(c)(1): no item facts, the asserted total stands";
    when total_liabilities_assumed(t, transferor, total);
    when not_known(liability_items_present_357c3(t, transferor));
    then net_liabilities_assumed_357c3(t, transferor, total);
}
@source(IRC_S357_C, quote = "the amount of such liability shall be excluded in determining the amount of liabilities assumed.")
rule Section357c3NetRule(t: ControlledTransfer, transferor: Person, total: Money, excluded: Money) defeasible {
    label en official "section 357(c)(3): the total less the excluded liabilities";
    when total_liabilities_assumed(t, transferor, total);
    when liability_items_present_357c3(t, transferor);
    when excluded_liabilities_357c3(t, transferor, excluded);
    then net_liabilities_assumed_357c3(t, transferor, total - excluded);
}
pub relation recourse_liability_357d1a(l: AssumedObligation358) kind empirical {
    label en official "the liability (or portion) is a recourse liability";
}
pub relation transferee_agreed_and_expected_to_satisfy_357d1a(l: AssumedObligation358) kind empirical {
    label en official "on all facts and circumstances the transferee has agreed to, and is expected to, satisfy the liability (or portion), whether or not the transferor is relieved";
}
pub relation regulations_provide_otherwise_357d1(l: AssumedObligation358) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise (\"except as provided in regulations\")";
}
pub relation recourse_liability_treated_as_assumed_357d1a(l: AssumedObligation358) kind institutional {
    label en official "a recourse liability treated as assumed (section 357(d)(1)(A))";
}
@source(IRC_S357_D, quote = "a recourse liability (or portion thereof) shall be treated as having been assumed if, as determined on the basis of all facts and circumstances, the transferee has agreed to, and is expected to, satisfy such liability (or portion), whether or not the transferor has been relieved of such liability; and")
rule Section357d1aRule(l: AssumedObligation358) defeasible {
    label en official "section 357(d)(1)(A)";
    when recourse_liability_357d1a(l);
    when transferee_agreed_and_expected_to_satisfy_357d1a(l);
    when not_known(regulations_provide_otherwise_357d1(l));
    then recourse_liability_treated_as_assumed_357d1a(l);
}
pub relation nonrecourse_liability_357d1b(l: AssumedObligation358, amount: Money) kind empirical {
    label en official "a nonrecourse liability of the transferred asset, in this amount";
}
pub relation other_assets_owner_agreed_to_satisfy_357d2a(l: AssumedObligation358, amount: Money) kind empirical {
    label en official "the amount of the liability which an owner of other assets, not transferred and also subject to the liability, has agreed with the transferee to, and is expected to, satisfy";
}
pub relation fair_market_value_of_other_assets_357d2b(l: AssumedObligation358, amount: Money) kind empirical {
    label en official "the fair market value of such other assets, determined without regard to section 7701(g)";
}
pub relation nonrecourse_liability_treated_as_assumed_357d1b(l: AssumedObligation358, amount: Money) kind institutional {
    label en official "a nonrecourse liability treated as assumed by the transferee of the asset, reduced by the lesser of the (2)(A) and (2)(B) amounts (section 357(d)(1)(B), (2))";
}
@source(IRC_S357_D, quote = "The amount of the nonrecourse liability treated as described in paragraph (1)(B) shall be reduced by the lesser of—")
rule Section357d2ByAgreementRule(l: AssumedObligation358, liability: Money, agreed: Money, fmv: Money) defeasible {
    label en official "section 357(d)(2): reduction by the agreed amount when it is the lesser";
    when nonrecourse_liability_357d1b(l, liability);
    when other_assets_owner_agreed_to_satisfy_357d2a(l, agreed);
    when fair_market_value_of_other_assets_357d2b(l, fmv);
    when not_known(regulations_provide_otherwise_357d1(l));
    when agreed <= fmv;
    when liability >= agreed;
    then nonrecourse_liability_treated_as_assumed_357d1b(l, liability - agreed);
}
@source(IRC_S357_D, quote = "The amount of the nonrecourse liability treated as described in paragraph (1)(B) shall be reduced by the lesser of—")
rule Section357d2ByValueRule(l: AssumedObligation358, liability: Money, agreed: Money, fmv: Money) defeasible {
    label en official "section 357(d)(2): reduction by the value of the other assets when it is the lesser";
    when nonrecourse_liability_357d1b(l, liability);
    when other_assets_owner_agreed_to_satisfy_357d2a(l, agreed);
    when fair_market_value_of_other_assets_357d2b(l, fmv);
    when not_known(regulations_provide_otherwise_357d1(l));
    when agreed > fmv;
    when liability >= fmv;
    then nonrecourse_liability_treated_as_assumed_357d1b(l, liability - fmv);
}
pub relation nonrecourse_liability_without_other_assets_357d1b(l: AssumedObligation358) kind institutional {
    label en unofficial "helper: some fact about other assets exists";
}
rule Section357d2OtherAssetsHelperRule(l: AssumedObligation358, amount: Money) defeasible {
    label en unofficial "helper: other-assets facts exist";
    when other_assets_owner_agreed_to_satisfy_357d2a(l, amount);
    then nonrecourse_liability_without_other_assets_357d1b(l);
}
@source(IRC_S357_D, quote = "a nonrecourse liability shall be treated as having been assumed by the transferee of any asset subject to such liability.")
rule Section357d1bFullRule(l: AssumedObligation358, liability: Money) defeasible {
    label en official "section 357(d)(1)(B): with no other assets the whole nonrecourse liability is assumed";
    when nonrecourse_liability_357d1b(l, liability);
    when not_known(nonrecourse_liability_without_other_assets_357d1b(l));
    then nonrecourse_liability_treated_as_assumed_357d1b(l, liability);
}
pub relation regulations_prescribed_357d3(t: ControlledTransfer) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary to carry out the purposes of subsection (d) and section 362(d)";
}
@source(IRC_S357_D, quote = "The Secretary shall prescribe such regulations as may be necessary to carry out the purposes of this subsection and section 362(d).")
rule Section357d3DutyRule(t: ControlledTransfer, transferor: Person, corp: Corporation) defeasible {
    label en official "section 357(d)(3): the Secretary shall prescribe regulations; no day count is stated (G4004)";
    when transfer_to_corporation(t, transferor, corp);
    then duty Section357d3PrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_357d3(t);
            window [-infinity, infinity];
        }
    };
}

// --- Section 367(d)(2)(A)(i): deemed sale for contingent payments --------------------------------------------

pub relation deemed_sale_for_contingent_payments_367d2ai(x: ForeignCorporationExchange, a: Asset) kind institutional {
    label en official "the United States person is treated as having sold the property in exchange for payments contingent upon its productivity, use or disposition (section 367(d)(2)(A)(i))";
}
@source(IRC_S367_D, quote = "having sold such property in exchange for payments which are contingent upon the productivity, use, or disposition of such property, and")
rule Section367d2aiRule(x: ForeignCorporationExchange, a: Asset) defeasible {
    label en official "section 367(d)(2)(A)(i): the deemed sale follows from section 367(d)(1)";
    when section_367d_applies_to_transfer(x, a);
    then deemed_sale_for_contingent_payments_367d2ai(x, a);
}
