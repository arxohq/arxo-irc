// Stage 3b (26.09.2026, TECH_GAP reduction). Subchapter G residuals:
// section 534(c)-(d) (statement of grounds, jeopardy assessment), 537(b)
// (redemption needs and reserves), 544 (constructive ownership for personal
// holding companies), 545(c) (foreign corporations), 547(b)-(g) (deficiency
// dividend rules), 562 (dividends eligible for the dividends paid
// deduction), 563(c), 564 (dividend carryover) and 565(c)-(f) (consent
// dividends). Status implemented_unverified: nothing here was executed.

// --- Section 534(c)-(d): the taxpayer's statement ----------------------------------

use self::{
    Asset,
    Corporation,
    DistributionEvent,
    IRC_S534_C,
    IRC_S534_D,
    IRC_S537_B,
    IRC_S544_A,
    IRC_S544_B,
    IRC_S545_C,
    IRC_S547_B,
    IRC_S547_C,
    IRC_S547_E,
    IRC_S547_F,
    IRC_S562_A,
    IRC_S562_B,
    IRC_S562_C,
    IRC_S562_D,
    IRC_S562_E,
    IRC_S563_C,
    IRC_S564_A,
    IRC_S564_B,
    IRC_S565_C,
    IRC_S565_D,
    IRC_S565_E,
    IRC_S565_F,
    Individual,
    OwnershipInterest,
    Person,
    PhcDeficiencyDetermination,
    TaxableYear,
    consent_dividend_recognized_565,
    consent_dividends_561a2,
    dividend_within_563_grace_period,
    dividends_paid_during_year_561a1,
    personal_holding_company,
    taxable_income_adjusted_545b,
};

pub relation notification_mailed_on_534b(c: Corporation, y: TaxableYear, on: Date) kind empirical {
    label en official "the date on which the notification described in section 534(b) was mailed";
}
pub relation statement_deadline_prescribed_534c(c: Corporation, y: TaxableYear, on: Date) kind empirical {
    label en official "the last day for the statement, as the Secretary prescribes by regulations (a case fact: the regulations are outside the snapshot)";
}
pub relation statement_deadline_effective_534c(c: Corporation, y: TaxableYear, on: Date) kind institutional {
    label en official "the effective last day for the statement: the prescribed day, but never less than 30 days after the mailing (section 534(c))";
}
@source(IRC_S534_C, quote = "Within such time (but not less than 30 days) after the mailing of the notification described in subsection (b) as the Secretary may prescribe by regulations")
rule Section534cDeadlineAtLeast30DaysRule(c: Corporation, y: TaxableYear, mailed: Date, prescribed: Date) defeasible {
    label en official "section 534(c): a prescribed period of at least 30 days stands";
    when notification_mailed_on_534b(c, y, mailed);
    when statement_deadline_prescribed_534c(c, y, prescribed);
    when prescribed >= add_calendar_period(mailed, 30 calendar_day);
    then statement_deadline_effective_534c(c, y, prescribed);
}
@source(IRC_S534_C, quote = "Within such time (but not less than 30 days) after the mailing of the notification described in subsection (b) as the Secretary may prescribe by regulations")
rule Section534cDeadlineFloorRule(c: Corporation, y: TaxableYear, mailed: Date, prescribed: Date) defeasible {
    label en official "section 534(c): a prescribed period shorter than 30 days is raised to 30 days";
    when notification_mailed_on_534b(c, y, mailed);
    when statement_deadline_prescribed_534c(c, y, prescribed);
    when prescribed < add_calendar_period(mailed, 30 calendar_day);
    then statement_deadline_effective_534c(c, y, add_calendar_period(mailed, 30 calendar_day));
}
pub relation statement_of_grounds_submitted_on_534c(c: Corporation, y: TaxableYear, on: Date) kind empirical {
    label en official "the taxpayer submits the statement of the grounds on which it relies to establish that the earnings and profits have not been permitted to accumulate beyond the reasonable needs of the business";
}
pub relation statement_includes_supporting_facts_534c(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the statement is accompanied by facts sufficient to show the basis of the grounds (section 534(c))";
}
pub relation statement_timely_and_supported_534c(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "helper: the statement is submitted after the mailing, within the effective time, with supporting facts (the single atom of the power's valid_when)";
}
@source(IRC_S534_C, quote = "the taxpayer may submit a statement of the grounds (together with facts sufficient to show the basis thereof)")
rule Section534cStatementTimelyRule(c: Corporation, y: TaxableYear, mailed: Date, submitted: Date, deadline: Date) defeasible {
    label en unofficial "helper: timely and supported statement";
    when notification_mailed_on_534b(c, y, mailed);
    when statement_of_grounds_submitted_on_534c(c, y, submitted);
    when statement_deadline_effective_534c(c, y, deadline);
    when statement_includes_supporting_facts_534c(c, y);
    when submitted >= mailed;
    when submitted <= deadline;
    then statement_timely_and_supported_534c(c, y);
}
pub relation statement_of_grounds_effective_534c(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the taxpayer's statement of grounds is effective for the burden-of-proof rule of section 534(a)(2)";
}
@source(IRC_S534_C, quote = "the taxpayer may submit a statement of the grounds")
rule Section534cStatementPowerRule strict {
    label en official "section 534(c): the taxpayer's power to submit the statement; one outside the time or without supporting facts is an invalid exercise and has no effect (E-0239)";
    for c: Corporation;
    for y: TaxableYear;
    for on: Date;
    when statement_of_grounds_submitted_on_534c(c, y, on);
    then power Section534cStatement {
        holder c;
        over c;
        exercise statement_of_grounds_submitted_on_534c(c, y, on);
        valid_when statement_timely_and_supported_534c(c, y);
        effect create(statement_of_grounds_effective_534c(c, y));
        window [-infinity, infinity];
    };
}
pub relation jeopardy_assessment_before_deficiency_notice_534d(c: Corporation, y: TaxableYear) kind empirical {
    label en official "pursuant to section 6861(a) a jeopardy assessment is made before the mailing of the notice of deficiency referred to in subsection (a)";
}
pub relation deficiency_notice_informs_aet_included_534d(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the notice of deficiency informs the taxpayer that the deficiency includes the accumulated earnings tax imposed by section 531";
}
pub relation deficiency_notice_is_the_534b_notification_534d(c: Corporation, y: TaxableYear) kind institutional {
    label en official "to that extent the notice of deficiency constitutes the notification described in subsection (b) (section 534(d))";
}
@source(IRC_S534_D, quote = "such notice of deficiency shall, to the extent that it informs the taxpayer that such deficiency includes the accumulated earnings tax imposed by section 531, constitute the notification described in subsection (b)")
rule Section534dNoticeAsNotificationRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 534(d): after a jeopardy assessment the deficiency notice is the (b) notification";
    when jeopardy_assessment_before_deficiency_notice_534d(c, y);
    when deficiency_notice_informs_aet_included_534d(c, y);
    then deficiency_notice_is_the_534b_notification_534d(c, y);
}
pub relation statement_included_in_tax_court_petition_534d(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer includes the statement described in subsection (c) in its petition to the Tax Court";
}
@source(IRC_S534_D, quote = "the statement described in subsection (c) may be included in the taxpayer's petition to the Tax Court.")
rule Section534dPetitionLibertyRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 534(d): after such a jeopardy assessment the taxpayer is at liberty to include the statement in its Tax Court petition";
    when deficiency_notice_is_the_534b_notification_534d(c, y);
    then liberty Section534dStatementInPetitionLiberty {
        holder c;
        against us.irc.core::Secretary;
        action statement_included_in_tax_court_petition_534d(c, y);
        window [-infinity, infinity];
    };
}

// --- Section 537(b): special rules --------------------------------------------------

pub relation shareholder_death_year_537b1(c: Corporation, death_year: TaxableYear) kind empirical {
    label en official "the taxable year of the corporation in which a shareholder of the corporation died (section 537(b)(1))";
}
pub relation stock_needed_for_redemption_included_in_gross_estate_537b1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount needed (or reasonably anticipated to be needed) to make a redemption of stock included in the gross estate of the decedent";
}
pub relation section_303_redemption_needs_capped_537b1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 303 redemption needs: the amount needed, not in excess of the maximum amount of stock to which section 303(a) may apply, for the death year and later years (section 537(b)(1))";
}
pub relation redemption_ceiling_303a_for_537(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the maximum amount of stock to which section 303(a) may apply (module 12's ceiling for the redemption, asserted for the corporation and year)";
}
@source(IRC_S537_B, quote = "the amount needed (or reasonably anticipated to be needed) to make a redemption of stock included in the gross estate of the decedent (but not in excess of the maximum amount of stock to which section 303(a) may apply).")
rule Section537b1WithinCeilingRule(c: Corporation, y: TaxableYear, death_year: TaxableYear, needed: Money, ceiling: Money, y_begins: Date, death_begins: Date) defeasible {
    label en official "section 537(b)(1): the needs when they do not exceed the section 303(a) ceiling";
    when shareholder_death_year_537b1(c, death_year);
    when us.irc.core::begins(y, y_begins);
    when us.irc.core::begins(death_year, death_begins);
    when y_begins >= death_begins;
    when stock_needed_for_redemption_included_in_gross_estate_537b1(c, y, needed);
    when redemption_ceiling_303a_for_537(c, y, ceiling);
    when needed <= ceiling;
    then section_303_redemption_needs_capped_537b1(c, y, needed);
}
@source(IRC_S537_B, quote = "(but not in excess of the maximum amount of stock to which section 303(a) may apply)")
rule Section537b1CappedRule(c: Corporation, y: TaxableYear, death_year: TaxableYear, needed: Money, ceiling: Money, y_begins: Date, death_begins: Date) defeasible {
    label en official "section 537(b)(1): the needs limited to the section 303(a) ceiling";
    when shareholder_death_year_537b1(c, death_year);
    when us.irc.core::begins(y, y_begins);
    when us.irc.core::begins(death_year, death_begins);
    when y_begins >= death_begins;
    when stock_needed_for_redemption_included_in_gross_estate_537b1(c, y, needed);
    when redemption_ceiling_303a_for_537(c, y, ceiling);
    when needed > ceiling;
    then section_303_redemption_needs_capped_537b1(c, y, ceiling);
}
pub relation foundation_held_stock_on_may_26_1969_537b2a(stock: Asset) kind empirical {
    label en official "the private foundation held the stock on May 26, 1969 (section 537(b)(2)(A))";
}
pub relation foundation_received_stock_under_will_or_trust_4943c5_537b2a(stock: Asset) kind empirical {
    label en official "the foundation received the stock pursuant to a will or irrevocable trust to which section 4943(c)(5) applies (section 537(b)(2)(A))";
}
pub relation stock_was_excess_business_holdings_on_may_26_1969_537b2b(stock: Asset) kind empirical {
    label en official "the stock constituted excess business holdings on May 26, 1969 (section 537(b)(2)(B))";
}
pub relation stock_would_have_been_excess_business_holdings_with_adjustments_537b2b(stock: Asset) kind empirical {
    label en official "the stock would have constituted excess business holdings on May 26, 1969 if there were taken into account stock received under a will or trust and the reduction in outstanding stock from the redemption of the foundation's stock (section 537(b)(2)(B)(i)-(ii))";
}
pub relation stock_within_537b2(stock: Asset) kind institutional {
    label en official "stock whose redemption from a private foundation counts as an excess business holdings redemption need (section 537(b)(2))";
}
@source(IRC_S537_B, quote = "such foundation held on May 26, 1969 (or which was received by such foundation pursuant to a will or irrevocable trust to which section 4943(c)(5) applies)")
rule Section537b2HeldExcessRule(stock: Asset) defeasible {
    label en official "section 537(b)(2): held on May 26, 1969 and excess business holdings on that date";
    when foundation_held_stock_on_may_26_1969_537b2a(stock);
    when stock_was_excess_business_holdings_on_may_26_1969_537b2b(stock);
    then stock_within_537b2(stock);
}
@source(IRC_S537_B, quote = "would have constituted excess business holdings as of such date if there were taken into account")
rule Section537b2HeldWouldRule(stock: Asset) defeasible {
    label en official "section 537(b)(2): held on May 26, 1969 and excess business holdings with the (B)(i)-(ii) adjustments";
    when foundation_held_stock_on_may_26_1969_537b2a(stock);
    when stock_would_have_been_excess_business_holdings_with_adjustments_537b2b(stock);
    then stock_within_537b2(stock);
}
@source(IRC_S537_B, quote = "(or which was received by such foundation pursuant to a will or irrevocable trust to which section 4943(c)(5) applies)")
rule Section537b2ReceivedExcessRule(stock: Asset) defeasible {
    label en official "section 537(b)(2): received under a will or irrevocable trust and excess business holdings on that date";
    when foundation_received_stock_under_will_or_trust_4943c5_537b2a(stock);
    when stock_was_excess_business_holdings_on_may_26_1969_537b2b(stock);
    then stock_within_537b2(stock);
}
@source(IRC_S537_B, quote = "(or which was received by such foundation pursuant to a will or irrevocable trust to which section 4943(c)(5) applies)")
rule Section537b2ReceivedWouldRule(stock: Asset) defeasible {
    label en official "section 537(b)(2): received under a will or irrevocable trust and excess business holdings with the (B)(i)-(ii) adjustments";
    when foundation_received_stock_under_will_or_trust_4943c5_537b2a(stock);
    when stock_would_have_been_excess_business_holdings_with_adjustments_537b2b(stock);
    then stock_within_537b2(stock);
}
pub relation redemption_need_for_foundation_stock_537b2(c: Corporation, y: TaxableYear, stock: Asset, amount: Money) kind empirical {
    label en official "the amount needed (or reasonably anticipated to be needed) to redeem the stock from a private foundation";
}
pub relation qualifying_excess_holdings_need_537b2(c: Corporation, y: TaxableYear, stock: Asset, amount: Money) kind institutional {
    label en official "the redemption need for stock within paragraph (2); the corporation-level total over several stocks is an aggregate over a derived relation and stays asserted in module 15 (G4011)";
}
@source(IRC_S537_B, quote = "The term \"excess business holdings redemption needs\" means the amount needed (or reasonably anticipated to be needed) to redeem from a private foundation stock which—")
rule Section537b2QualifyingNeedRule(c: Corporation, y: TaxableYear, stock: Asset, amount: Money) defeasible {
    label en official "section 537(b)(2): the need for stock within paragraph (2)";
    when redemption_need_for_foundation_stock_537b2(c, y, stock, amount);
    when stock_within_537b2(stock);
    then qualifying_excess_holdings_need_537b2(c, y, stock, amount);
}
pub relation obligation_discharged_for_redemption_537b3(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the corporation discharges an obligation incurred to make a redemption described in paragraphs (1) and (2)";
}
pub relation obligation_discharge_treated_as_redemption_537b3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the discharge of the obligation is treated as the making of the redemption (section 537(b)(3))";
}
@source(IRC_S537_B, quote = "the discharge of any obligation incurred to make a redemption described in such paragraphs shall be treated as the making of such redemption.")
rule Section537b3DischargeRule(c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 537(b)(3): discharging the redemption obligation is a redemption";
    when obligation_discharged_for_redemption_537b3(c, y, amount);
    then obligation_discharge_treated_as_redemption_537b3(c, y, amount);
}
pub relation accumulation_for_product_liability_losses_537b4(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the corporation accumulates an amount for the payment of reasonably anticipated product liability losses (as defined in section 172(f) as in effect before the Tax Cuts and Jobs Act)";
}
@source(IRC_S537_B, quote = "as determined under regulations prescribed by the Secretary")
pub external judgment relation product_liability_reserve_reasonable_under_regulations_537b4(c: Corporation, y: TaxableYear, amount: Money) {
    authority Secretary;
    label en official "section 537(b)(4): the amount is a reasonable amount for reasonably anticipated product liability losses, as determined under regulations — DECISION-0194 evaluative channel";
}
pub relation accumulated_for_reasonably_anticipated_needs_537b4(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the accumulation is treated as accumulated for the reasonably anticipated needs of the business (section 537(b)(4))";
}
@source(IRC_S537_B, quote = "shall be treated as accumulated for the reasonably anticipated needs of the business.")
rule Section537b4ProductLiabilityRule(c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 537(b)(4): reasonable product liability reserves are reasonable needs";
    when accumulation_for_product_liability_losses_537b4(c, y, amount);
    when product_liability_reserve_reasonable_under_regulations_537b4(c, y, amount);
    then accumulated_for_reasonably_anticipated_needs_537b4(c, y, amount);
}
pub relation later_redemption_of_the_537b_kind_made_537b5(c: Corporation) kind empirical {
    label en official "distributions in redemption coming within paragraphs (1) and (2) were subsequently made";
}
pub relation taxable_year_before_first_year_537b5(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the taxable year is before the first taxable year specified in paragraph (1) (the year of the shareholder's death)";
}
pub relation subsequent_redemption_disregarded_537b5(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the application of the part to the earlier year is made without regard to the subsequent redemption (section 537(b)(5))";
}
@source(IRC_S537_B, quote = "shall be made without regard to the fact that distributions in redemption coming within the terms of such paragraphs were subsequently made.")
rule Section537b5NoInferenceRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 537(b)(5): a later redemption is disregarded for earlier years";
    when taxable_year_before_first_year_537b5(c, y);
    when later_redemption_of_the_537b_kind_made_537b5(c);
    then subsequent_redemption_disregarded_537b5(c, y);
}

// --- Section 544: constructive ownership for personal holding companies -----------

pub enum PhcOwnershipPurpose544 {
    StockOwnership542a2;
    PersonalServiceContracts543a7;
    UseOfProperty543a6;
    CopyrightRoyalties543a4;
    label en unofficial "the determination in which section 544(a) constructive ownership is used";
}
pub relation phc_owned_actually_544(p: Person, corp: Corporation, share: Decimal) kind institutional {
    label en unofficial "the person owns the stock directly (the base of the bounded attribution chain)";
}
@source(IRC_S544_A, quote = "Stock owned, directly or indirectly, by or for a corporation, partnership, estate, or trust shall be considered as being owned proportionately by its shareholders, partners, or beneficiaries.")
rule PhcActualOwnershipRule(p: Person, corp: Corporation, share: Decimal, oi: OwnershipInterest) strict {
    label en unofficial "actual ownership restated for the bounded chain";
    when us.irc.core::ownership_interest(oi, p, corp, share);
    then phc_owned_actually_544(p, corp, share);
}
pub relation owner_share_in_entity_544a1(owner: Person, ent: Person, share: Decimal) kind empirical {
    label en official "the shareholder, partner or beneficiary owns this proportion of the corporation, partnership, estate or trust (section 544(a)(1))";
}
pub relation phc_entity_attribution_544a1(owner: Person, corp: Corporation, share: Decimal) kind institutional {
    label en official "stock owned by or for a corporation, partnership, estate or trust is considered owned proportionately by its shareholders, partners or beneficiaries (section 544(a)(1))";
}
@source(IRC_S544_A, quote = "Stock owned, directly or indirectly, by or for a corporation, partnership, estate, or trust shall be considered as being owned proportionately by its shareholders, partners, or beneficiaries.")
rule Section544a1EntityRule(owner: Person, ent: Person, corp: Corporation, entity_share: Decimal, owner_share: Decimal) defeasible {
    label en official "section 544(a)(1): proportionate attribution to the entity's owners";
    when phc_owned_actually_544(ent, corp, entity_share);
    when owner_share_in_entity_544a1(owner, ent, owner_share);
    then phc_entity_attribution_544a1(owner, corp, entity_share * owner_share);
}
pub relation option_to_acquire_stock_or_option_544a3(holder: Person, corp: Corporation, share: Decimal) kind empirical {
    label en official "the person has an option to acquire the stock, or an option to acquire such an option, or is at the head of a series of such options (section 544(a)(3), second sentence)";
}
pub relation phc_option_attribution_544a3(holder: Person, corp: Corporation, share: Decimal) kind institutional {
    label en official "stock subject to an option is considered owned by the option holder (section 544(a)(3))";
}
@source(IRC_S544_A, quote = "If any person has an option to acquire stock, such stock shall be considered as owned by such person.")
rule Section544a3OptionRule(holder: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 544(a)(3): option attribution, including an option to acquire an option";
    when option_to_acquire_stock_or_option_544a3(holder, corp, share);
    then phc_option_attribution_544a3(holder, corp, share);
}
pub relation family_of_544a2(a: Individual, b: Individual) kind empirical {
    label en official "the individual is a brother or sister (whole or half blood), spouse, ancestor or lineal descendant of the other (section 544(a)(2), family includes only these)";
}
pub relation partner_of_544a2(a: Individual, b: Individual) kind empirical {
    label en official "the individual is a partner of the other (section 544(a)(2))";
}
pub relation effect_of_family_option_rules_makes_phc_544a4(corp: Corporation, purpose: PhcOwnershipPurpose544) kind empirical {
    label en official "the effect of applying paragraphs (2) and (3) is to make the corporation a personal holding company (542(a)(2)) or to make the amounts referred to includible as personal holding company income (543(a)(7), (6), (4)) — a counterfactual test supplied by the case";
}
pub relation phc_family_attribution_544a2(ind: Individual, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) kind institutional {
    label en official "an individual is considered as owning stock owned by his family or partner, where paragraph (4) allows it (section 544(a)(2), (4))";
}
@source(IRC_S544_A, quote = "An individual shall be considered as owning the stock owned, directly or indirectly, by or for his family or by or for his partner.")
rule Section544a2FamilyActualRule(ind: Individual, rel: Individual, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(a)(2): family attribution from actually owned stock";
    when family_of_544a2(rel, ind);
    when phc_owned_actually_544(rel, corp, share);
    when effect_of_family_option_rules_makes_phc_544a4(corp, purpose);
    then phc_family_attribution_544a2(ind, corp, share, purpose);
}
@source(IRC_S544_A, quote = "An individual shall be considered as owning the stock owned, directly or indirectly, by or for his family or by or for his partner.")
rule Section544a2PartnerActualRule(ind: Individual, rel: Individual, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(a)(2): partner attribution from actually owned stock";
    when partner_of_544a2(rel, ind);
    when phc_owned_actually_544(rel, corp, share);
    when effect_of_family_option_rules_makes_phc_544a4(corp, purpose);
    then phc_family_attribution_544a2(ind, corp, share, purpose);
}
@source(IRC_S544_A, quote = "Stock constructively owned by a person by reason of the application of paragraph (1) or (3), shall, for purposes of applying paragraph (1) or (2), be treated as actually owned by such person")
rule Section544a5FamilyFromEntityRule(ind: Individual, rel: Individual, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(a)(5): stock constructively owned by a relative through paragraph (1) is treated as actually owned when applying (2)";
    when family_of_544a2(rel, ind);
    when phc_entity_attribution_544a1(rel, corp, share);
    when effect_of_family_option_rules_makes_phc_544a4(corp, purpose);
    then phc_family_attribution_544a2(ind, corp, share, purpose);
}
@source(IRC_S544_A, quote = "Stock constructively owned by a person by reason of the application of paragraph (1) or (3), shall, for purposes of applying paragraph (1) or (2), be treated as actually owned by such person")
rule Section544a5FamilyFromOptionRule(ind: Individual, rel: Individual, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(a)(5): stock constructively owned by a relative through an option is treated as actually owned when applying (2)";
    when family_of_544a2(rel, ind);
    when phc_option_attribution_544a3(rel, corp, share);
    when effect_of_family_option_rules_makes_phc_544a4(corp, purpose);
    then phc_family_attribution_544a2(ind, corp, share, purpose);
}
// Section 544(a)(5), last clause (family attribution never feeds itself): satisfied
// by construction, the (2) rules read only actual, (1)- and (3)-derived
// ownership (the bounded chain of module 03, one hop per kind).
pub relation phc_constructive_owner_544(p: Person, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) kind institutional {
    label en official "the person is considered as owning the stock under section 544(a), with paragraph (6) preferring the option rule over the family and partnership rule";
}
pub relation phc_option_present_544a6(p: Person, corp: Corporation) kind institutional {
    label en unofficial "helper: an option attribution exists for the person and the corporation";
}
@source(IRC_S544_A, quote = "If stock may be considered as owned by an individual under either paragraph (2) or (3) it shall be considered as owned by him under paragraph (3).")
rule Section544a6OptionHelperRule(p: Person, corp: Corporation, share: Decimal) defeasible {
    label en unofficial "helper: option attribution exists";
    when phc_option_attribution_544a3(p, corp, share);
    then phc_option_present_544a6(p, corp);
}
@source(IRC_S544_A, quote = "If stock may be considered as owned by an individual under either paragraph (2) or (3) it shall be considered as owned by him under paragraph (3).")
rule Section544a6OptionRule(p: Person, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(a)(6): the option rule governs, where paragraph (4) allows it";
    when phc_option_attribution_544a3(p, corp, share);
    when effect_of_family_option_rules_makes_phc_544a4(corp, purpose);
    then phc_constructive_owner_544(p, corp, share, purpose);
}
@source(IRC_S544_A, quote = "If stock may be considered as owned by an individual under either paragraph (2) or (3) it shall be considered as owned by him under paragraph (3).")
rule Section544a6FamilyRule(p: Individual, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(a)(6): family and partnership ownership counts only when no option attribution exists for the same individual and stock";
    when phc_family_attribution_544a2(p, corp, share, purpose);
    when not_known(phc_option_present_544a6(p, corp));
    then phc_constructive_owner_544(p, corp, share, purpose);
}
@source(IRC_S544_A, quote = "Stock owned, directly or indirectly, by or for a corporation, partnership, estate, or trust shall be considered as being owned proportionately by its shareholders, partners, or beneficiaries.")
rule Section544a1OwnerRule(p: Person, corp: Corporation, share: Decimal, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(a)(1): entity attribution applies to every purpose named in the preface";
    when phc_entity_attribution_544a1(p, corp, share);
    when effect_of_family_option_rules_makes_phc_544a4(corp, purpose);
    then phc_constructive_owner_544(p, corp, share, purpose);
}
pub entity ConvertibleSecurityClass544 { label en unofficial "a class of outstanding securities convertible into stock (section 544(b))"; }
pub relation convertible_class_of_544b(corp: Corporation, cls: ConvertibleSecurityClass544, first_convertible_on: Date) kind empirical {
    label en official "the class of outstanding securities convertible into stock, whether or not convertible during the taxable year, and the date after which it is convertible";
}
pub relation inclusion_through_class_makes_phc_544b(corp: Corporation, cls: ConvertibleSecurityClass544, purpose: PhcOwnershipPurpose544) kind empirical {
    label en official "the effect of including this class and every class with an earlier conversion date is to make the corporation a personal holding company or the amounts includible as personal holding company income — a counterfactual test supplied by the case";
}
pub relation class_included_by_effect_544b(corp: Corporation, cls: ConvertibleSecurityClass544, purpose: PhcOwnershipPurpose544) kind institutional {
    label en unofficial "helper: the inclusion of the class and of every earlier-dated class has the stated effect";
}
@source(IRC_S544_B, quote = "Outstanding securities convertible into stock (whether or not convertible during the taxable year) shall be considered as outstanding stock—")
rule Section544bEffectRule(corp: Corporation, cls: ConvertibleSecurityClass544, purpose: PhcOwnershipPurpose544, on: Date) defeasible {
    label en unofficial "helper: a class whose inclusion has the stated effect";
    when convertible_class_of_544b(corp, cls, on);
    when inclusion_through_class_makes_phc_544b(corp, cls, purpose);
    then class_included_by_effect_544b(corp, cls, purpose);
}
pub relation convertible_class_included_as_stock_544b(corp: Corporation, cls: ConvertibleSecurityClass544, purpose: PhcOwnershipPurpose544) kind institutional {
    label en official "the convertible securities of the class are considered as outstanding stock for the purpose (section 544(b))";
}
@source(IRC_S544_B, quote = "Outstanding securities convertible into stock (whether or not convertible during the taxable year) shall be considered as outstanding stock—")
rule Section544bIncludedRule(corp: Corporation, cls: ConvertibleSecurityClass544, purpose: PhcOwnershipPurpose544) defeasible {
    label en official "section 544(b)(1)-(4): a class is included when the inclusion of it and of all earlier-dated classes has the stated effect";
    when class_included_by_effect_544b(corp, cls, purpose);
    then convertible_class_included_as_stock_544b(corp, cls, purpose);
}
@source(IRC_S544_B, quote = "but no convertible securities shall be included unless all outstanding securities having a prior conversion date are also included.")
rule Section544bEarlierClassesRule(corp: Corporation, later: ConvertibleSecurityClass544, earlier: ConvertibleSecurityClass544, purpose: PhcOwnershipPurpose544, later_on: Date, earlier_on: Date) defeasible {
    label en official "section 544(b), last paragraph: no class is included unless all classes with a prior conversion date are also included";
    when class_included_by_effect_544b(corp, later, purpose);
    when convertible_class_of_544b(corp, later, later_on);
    when convertible_class_of_544b(corp, earlier, earlier_on);
    when earlier_on < later_on;
    then convertible_class_included_as_stock_544b(corp, earlier, purpose);
}

// --- Section 545(c): certain foreign corporations ------------------------------------

pub relation all_stock_owned_by_nonresident_aliens_last_half_545c(c: Corporation, y: TaxableYear) kind empirical {
    label en official "all the outstanding stock of the foreign corporation during the last half of the taxable year is owned by nonresident alien individuals, directly or through foreign estates, trusts, partnerships or corporations (section 545(c))";
}
pub relation personal_service_contract_income_543a7_545c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the income which constitutes personal holding company income under section 543(a)(7)";
}
pub relation deductions_attributable_to_543a7_income_545c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions attributable to that income";
}
pub relation adjustments_545b_on_543a7_income_545c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net reduction of that income by the adjustments provided in section 545(b) (sign convention supplied by the case: a positive amount reduces the income, JUDGMENT CALL)";
}
pub relation taxable_income_of_foreign_corporation_545c(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income of the foreign corporation for subsection (a): section 543(a)(7) income, less attributable deductions, adjusted as in subsection (b) (section 545(c))";
}
@source(IRC_S545_C, quote = "the taxable income for purposes of subsection (a) shall be the income which constitutes personal holding company income under section 543(a)(7), reduced by the deductions attributable to such income, and adjusted, with respect to such income, in the manner provided in subsection (b).")
rule Section545cRule(c: Corporation, y: TaxableYear, income: Money, deductions: Money, adjustments: Money) defeasible {
    label en official "section 545(c): the taxable income of an all-nonresident-alien-owned foreign corporation";
    when all_stock_owned_by_nonresident_aliens_last_half_545c(c, y);
    when personal_service_contract_income_543a7_545c(c, y, income);
    when deductions_attributable_to_543a7_income_545c(c, y, deductions);
    when adjustments_545b_on_543a7_income_545c(c, y, adjustments);
    then taxable_income_of_foreign_corporation_545c(c, y, income - deductions - adjustments);
}

// --- Section 547(b)-(g): deficiency dividends ---------------------------------------

pub relation final_court_decision_547c1(det: PhcDeficiencyDetermination) kind empirical {
    label en official "a decision by the Tax Court or a judgment, decree or other order by a court of competent jurisdiction which has become final (section 547(c)(1))";
}
pub relation closing_agreement_7121_547c2(det: PhcDeficiencyDetermination) kind empirical {
    label en official "a closing agreement made under section 7121 (section 547(c)(2))";
}
pub relation agreement_under_regulations_signed_547c3(det: PhcDeficiencyDetermination) kind empirical {
    label en official "under regulations, an agreement signed by the Secretary and by or on behalf of the taxpayer relating to personal holding company tax liability (section 547(c)(3))";
}
pub relation determination_547c(det: PhcDeficiencyDetermination) kind institutional {
    label en official "a determination within the meaning of section 547";
}
@source(IRC_S547_C, quote = "a decision by the Tax Court or a judgment, decree, or other order by any court of competent jurisdiction, which has become final;")
rule Section547c1Rule(det: PhcDeficiencyDetermination) defeasible {
    label en official "section 547(c)(1): a final decision or judgment";
    when final_court_decision_547c1(det);
    then determination_547c(det);
}
@source(IRC_S547_C, quote = "a closing agreement made under section 7121; or")
rule Section547c2Rule(det: PhcDeficiencyDetermination) defeasible {
    label en official "section 547(c)(2): a closing agreement";
    when closing_agreement_7121_547c2(det);
    then determination_547c(det);
}
@source(IRC_S547_C, quote = "under regulations prescribed by the Secretary, an agreement signed by the Secretary and by, or on behalf of, the taxpayer")
rule Section547c3Rule(det: PhcDeficiencyDetermination) defeasible {
    label en official "section 547(c)(3): an agreement under regulations";
    when agreement_under_regulations_signed_547c3(det);
    then determination_547c(det);
}
pub relation determination_date_547(det: PhcDeficiencyDetermination, on: Date) kind empirical {
    label en official "the date of the determination";
}
pub relation claim_for_deficiency_dividend_deduction_filed_547e(det: PhcDeficiencyDetermination, c: Corporation, on: Date) kind empirical {
    label en official "the corporation files the claim for the deficiency dividend deduction, under the regulations";
}
pub relation finding_of_fraud_or_willful_failure_to_file_547g(det: PhcDeficiencyDetermination) kind empirical {
    label en official "the determination contains a finding that any part of the deficiency is due to fraud with intent to evade tax, or to wilful failure to file an income tax return within the prescribed time (section 547(g))";
}
pub relation claim_timely_and_not_barred_547(det: PhcDeficiencyDetermination, c: Corporation) kind institutional {
    label en unofficial "helper: the claim is filed within 120 days after a determination without a fraud finding (the single atom of the power's valid_when)";
}
@source(IRC_S547_E, quote = "unless (under regulations prescribed by the Secretary) claim therefor is filed within 120 days after the determination.")
rule Section547eTimelyClaimRule(det: PhcDeficiencyDetermination, c: Corporation, determined: Date, filed: Date) defeasible {
    label en unofficial "helper: timely claim without a fraud finding (a claim on the 120th day is timely)";
    when determination_547c(det);
    when determination_date_547(det, determined);
    when claim_for_deficiency_dividend_deduction_filed_547e(det, c, filed);
    when filed <= add_calendar_period(determined, 120 calendar_day);
    when filed >= determined;
    when not_known(finding_of_fraud_or_willful_failure_to_file_547g(det));
    then claim_timely_and_not_barred_547(det, c);
}
pub relation deficiency_dividend_deduction_allowed_as_of_547b1(det: PhcDeficiencyDetermination, c: Corporation, on: Date) kind institutional {
    label en official "the deficiency dividend deduction is allowed as of the date the claim is filed (section 547(b)(1))";
}
@source(IRC_S547_B, quote = "The deficiency dividend deduction shall be allowed as of the date the claim for the deficiency dividend deduction is filed.")
rule Section547ClaimPowerRule strict {
    label en official "sections 547(b)(1), (e), (g): the corporation's power to claim the deduction, valid only within 120 days after a determination and without a fraud finding; an invalid claim has no effect (E-0239)";
    for det: PhcDeficiencyDetermination;
    for c: Corporation;
    for on: Date;
    when claim_for_deficiency_dividend_deduction_filed_547e(det, c, on);
    then power Section547DeficiencyDividendClaim {
        holder c;
        over det;
        exercise claim_for_deficiency_dividend_deduction_filed_547e(det, c, on);
        valid_when claim_timely_and_not_barred_547(det, c);
        effect create(deficiency_dividend_deduction_allowed_as_of_547b1(det, c, on));
        window [-infinity, infinity];
    };
}
pub relation overpayment_results_from_deficiency_dividend_547b2(det: PhcDeficiencyDetermination, c: Corporation) kind empirical {
    label en official "the allowance of a deficiency dividend deduction results in an overpayment of personal holding company tax for a taxable year";
}
pub relation refund_limitation_treated_as_ending_547b2(det: PhcDeficiencyDetermination, on: Date) kind institutional {
    label en official "credit or refund is made as if on the date of the determination 2 years remained before the expiration of the period of limitation on filing a claim for refund (section 547(b)(2))";
}
@source(IRC_S547_B, quote = "credit or refund with respect to such overpayment shall be made as if on the date of the determination 2 years remained before the expiration of the period of limitation on the filing of claim for refund for the taxable year to which the overpayment relates.")
rule Section547b2RefundPeriodRule(det: PhcDeficiencyDetermination, c: Corporation, determined: Date) defeasible {
    label en official "section 547(b)(2): the refund period is treated as ending two years after the determination";
    when overpayment_results_from_deficiency_dividend_547b2(det, c);
    when determination_date_547(det, determined);
    then refund_limitation_treated_as_ending_547b2(det, add_calendar_period(determined, 2 calendar_year));
}
pub relation interest_on_547_credit_or_refund_disallowed(det: PhcDeficiencyDetermination) kind institutional {
    label en official "no interest is allowed on a credit or refund arising from the application of the section (section 547(b)(2), last sentence)";
}
@source(IRC_S547_B, quote = "No interest shall be allowed on a credit or refund arising from the application of this section.")
rule Section547b2NoInterestRule(det: PhcDeficiencyDetermination, c: Corporation) defeasible {
    label en official "section 547(b)(2): no interest on the credit or refund";
    when overpayment_results_from_deficiency_dividend_547b2(det, c);
    then interest_on_547_credit_or_refund_disallowed(det);
}
pub relation limitation_suspended_until_547f1(det: PhcDeficiencyDetermination, until: Date) kind institutional {
    label en official "the running of the section 6501 limitation on assessment, and on distraint or court proceedings for collection, is suspended until two years after the determination (section 547(f)(1))";
}
@source(IRC_S547_F, quote = "shall be suspended for a period of 2 years after the date of the determination.")
rule Section547f1SuspensionRule(det: PhcDeficiencyDetermination, c: Corporation, determined: Date, filed: Date) defeasible {
    label en official "section 547(f)(1): a claim made as provided in (e) suspends the limitation for two years after the determination";
    when claim_timely_and_not_barred_547(det, c);
    when determination_date_547(det, determined);
    when claim_for_deficiency_dividend_deduction_filed_547e(det, c, filed);
    then limitation_suspended_until_547f1(det, add_calendar_period(determined, 2 calendar_year));
}
pub relation collection_stay_120_days_ends_547f2a(det: PhcDeficiencyDetermination, until: Date) kind institutional {
    label en official "collection of the deficiency is stayed, except in cases of jeopardy, until the expiration of 120 days after the date of the determination (section 547(f)(2)(A))";
}
pub relation jeopardy_case_547f2a(det: PhcDeficiencyDetermination) kind empirical {
    label en official "the case is one of jeopardy";
}
@source(IRC_S547_F, quote = "shall, except in cases of jeopardy, be stayed until the expiration of 120 days after the date of the determination")
rule Section547f2aStayRule(det: PhcDeficiencyDetermination, determined: Date) defeasible {
    label en official "section 547(f)(2)(A): stay for 120 days, not in a jeopardy case";
    when determination_547c(det);
    when determination_date_547(det, determined);
    when not_known(jeopardy_case_547f2a(det));
    then collection_stay_120_days_ends_547f2a(det, add_calendar_period(determined, 120 calendar_day));
}
pub relation claim_disallowed_on_547f2b(det: PhcDeficiencyDetermination, on: Date) kind empirical {
    label en official "the claim for the deficiency dividend deduction is disallowed, in whole or in part, on the given date; collection is then made only of the part disallowed";
}
pub relation collection_stayed_until_claim_disallowed_547f2b(det: PhcDeficiencyDetermination, until: Date) kind institutional {
    label en official "if a claim is filed the collection of the part of the deficiency not reduced by the deduction is stayed until the claim is disallowed (section 547(f)(2)(B))";
}
@source(IRC_S547_F, quote = "shall be stayed until the date the claim is disallowed (in whole or in part) and if disallowed in part collection shall be made only with respect to the part disallowed.")
rule Section547f2bStayRule(det: PhcDeficiencyDetermination, c: Corporation, filed: Date, disallowed: Date) defeasible {
    label en official "section 547(f)(2)(B): stay until the claim is disallowed";
    when claim_for_deficiency_dividend_deduction_filed_547e(det, c, filed);
    when claim_disallowed_on_547f2b(det, disallowed);
    then collection_stayed_until_claim_disallowed_547f2b(det, disallowed);
}
pub relation secretary_begins_distraint_or_proceeding_for_stayed_amount_547f2(det: PhcDeficiencyDetermination) kind empirical {
    label en unofficial "the Secretary begins a distraint or a court proceeding for the collection of an amount stayed under subparagraph (A) or (B)";
}
@source(IRC_S547_F, quote = "No distraint or proceeding in court shall be begun for the collection of an amount the collection of which is stayed under subparagraph (A) or (B) during the period for which the collection of such amount is stayed.")
rule Section547f2NoDistraintRule(det: PhcDeficiencyDetermination, determined: Date, until: Date) defeasible {
    label en official "section 547(f)(2), last sentence: the Secretary may not begin distraint or a proceeding for a stayed amount during the stay";
    when determination_date_547(det, determined);
    when collection_stay_120_days_ends_547f2a(det, until);
    then prohibition Section547f2NoCollectionDuringStayBar {
        bearer us.irc.core::Secretary;
        action secretary_begins_distraint_or_proceeding_for_stayed_amount_547f2(det);
        window [-infinity, infinity];
    };
}

// --- Section 562: dividends eligible for the dividends paid deduction ---------------

pub relation distribution_562(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a distribution by the corporation in the taxable year, in the amount, tested for the dividends paid deduction";
}
pub relation dividend_for_dividends_paid_deduction_562(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the distribution is a dividend for computing the dividends paid deduction (section 562)";
}
pub relation section_316_dividend_562a(dist: DistributionEvent) kind empirical {
    label en official "the distribution is a dividend described in section 316 (asserted: module 02's dividend_amount is per distribution and is not read here, to keep the test on the case's own classification)";
}
pub relation distribution_qualifies_after_preferential_test_562c(dist: DistributionEvent) kind institutional {
    label en unofficial "helper: the distribution passes the preferential-dividend test of subsection (c)";
}
@source(IRC_S562_A, quote = "the term \"dividend\" shall, except as otherwise provided in this section, include only dividends described in section 316")
rule Section562aRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 562(a): only section 316 dividends, and only when they pass the preferential-dividend test of (c)";
    when distribution_562(dist, c, y, amount);
    when section_316_dividend_562a(dist);
    when distribution_qualifies_after_preferential_test_562c(dist);
    then dividend_for_dividends_paid_deduction_562(dist, c, y, amount);
}
pub relation liquidating_distribution_562b(dist: DistributionEvent) kind empirical {
    label en official "the amount is distributed in liquidation";
}
pub relation amount_chargeable_to_earnings_accumulated_after_1913_562b1a(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the part of the liquidating distribution properly chargeable to earnings and profits accumulated after February 28, 1913";
}
@source(IRC_S562_B, quote = "the part of such distribution which is properly chargeable to earnings and profits accumulated after February 28, 1913, shall be treated as a dividend for purposes of computing the dividends paid deduction")
rule Section562b1aRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, total: Money, chargeable: Money) defeasible {
    label en official "section 562(b)(1)(A): the part chargeable to post-1913 earnings is a dividend, except for a personal holding company";
    when distribution_562(dist, c, y, total);
    when liquidating_distribution_562b(dist);
    when amount_chargeable_to_earnings_accumulated_after_1913_562b1a(dist, chargeable);
    when not_known(personal_holding_company(c, y));
    then dividend_for_dividends_paid_deduction_562(dist, c, y, chargeable);
}
pub relation redemption_treated_as_liquidation_562b1(dist: DistributionEvent) kind institutional {
    label en official "for subparagraph (A) a liquidation includes a redemption of stock to which section 302 applies, except for a mere holding or investment company that is not a regulated investment company, unless regulations provide otherwise (section 562(b)(1), last sentences)";
}
pub relation redemption_to_which_302_applies_562b1(dist: DistributionEvent) kind empirical {
    label en official "the distribution is a redemption of stock to which section 302 applies";
}
pub relation mere_holding_or_investment_company_not_ric_562b1(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a mere holding or investment company which is not a regulated investment company";
}
pub relation regulations_extend_redemption_rule_to_holding_company_562b1(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: to the extent provided in regulations the redemption rule also applies to a mere holding or investment company";
}
@source(IRC_S562_B, quote = "For purposes of subparagraph (A), a liquidation includes a redemption of stock to which section 302 applies.")
rule Section562b1RedemptionRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 562(b)(1): a section 302 redemption is a liquidation for (A), save for a mere holding company (unless regulations extend it)";
    when distribution_562(dist, c, y, amount);
    when redemption_to_which_302_applies_562b1(dist);
    when not_known(mere_holding_or_investment_company_not_ric_562b1(c, y));
    then redemption_treated_as_liquidation_562b1(dist);
}
@source(IRC_S562_B, quote = "Except to the extent provided in regulations, the preceding sentence shall not apply in the case of any mere holding or investment company which is not a regulated investment company.")
rule Section562b1RedemptionRegulationsRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 562(b)(1): regulations may extend the redemption rule to a mere holding company";
    when distribution_562(dist, c, y, amount);
    when redemption_to_which_302_applies_562b1(dist);
    when mere_holding_or_investment_company_not_ric_562b1(c, y);
    when regulations_extend_redemption_rule_to_holding_company_562b1(c, y);
    then redemption_treated_as_liquidation_562b1(dist);
}
pub relation plan_of_liquidation_adopted_on_562b(c: Corporation, on: Date) kind empirical {
    label en official "the corporation adopts a plan of liquidation on the given date";
}
pub relation complete_liquidation_completed_on_562b(c: Corporation, on: Date) kind empirical {
    label en official "the complete liquidation is completed on the given date";
}
pub relation distribution_made_on_562b(dist: DistributionEvent, on: Date) kind empirical {
    label en official "the distribution pursuant to the plan is made on the given date";
}
pub relation earnings_and_profits_without_capital_losses_562b1b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the earnings and profits computed without regard to capital losses for the taxable year in which the distribution is made";
}
pub relation liquidation_within_24_months_562b(c: Corporation, dist: DistributionEvent) kind institutional {
    label en unofficial "helper: a complete liquidation within 24 months after the plan, and a distribution within that period";
}
@source(IRC_S562_B, quote = "in the case of a complete liquidation occurring within 24 months after the adoption of a plan of liquidation, any distribution within such period pursuant to such plan")
rule Section562b24MonthsRule(c: Corporation, dist: DistributionEvent, plan_on: Date, done_on: Date, paid_on: Date) defeasible {
    label en official "section 562(b)(1)(B): the 24-month window (plan date plus 24 calendar months)";
    when plan_of_liquidation_adopted_on_562b(c, plan_on);
    when complete_liquidation_completed_on_562b(c, done_on);
    when distribution_made_on_562b(dist, paid_on);
    when done_on <= add_calendar_period(plan_on, 24 calendar_month);
    when paid_on >= plan_on;
    when paid_on <= add_calendar_period(plan_on, 24 calendar_month);
    then liquidation_within_24_months_562b(c, dist);
}
@source(IRC_S562_B, quote = "to the extent of the earnings and profits (computed without regard to capital losses) of the corporation for the taxable year in which such distribution is made, be treated as a dividend for purposes of computing the dividends paid deduction.")
rule Section562b1bWithinEpRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, total: Money, ep: Money) defeasible {
    label en official "section 562(b)(1)(B): the distribution is a dividend up to the year's earnings and profits (this case: the distribution does not exceed them)";
    when distribution_562(dist, c, y, total);
    when liquidation_within_24_months_562b(c, dist);
    when earnings_and_profits_without_capital_losses_562b1b(c, y, ep);
    when not_known(personal_holding_company(c, y));
    when total <= ep;
    then dividend_for_dividends_paid_deduction_562(dist, c, y, total);
}
@source(IRC_S562_B, quote = "to the extent of the earnings and profits (computed without regard to capital losses) of the corporation for the taxable year in which such distribution is made")
rule Section562b1bCappedRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, total: Money, ep: Money) defeasible {
    label en official "section 562(b)(1)(B): the distribution is a dividend only up to the year's earnings and profits";
    when distribution_562(dist, c, y, total);
    when liquidation_within_24_months_562b(c, dist);
    when earnings_and_profits_without_capital_losses_562b1b(c, y, ep);
    when not_known(personal_holding_company(c, y));
    when total > ep;
    then dividend_for_dividends_paid_deduction_562(dist, c, y, ep);
}
pub relation allocable_share_of_undistributed_phc_income_562b2(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the corporate distributees' allocable share of the undistributed personal holding company income for the year, computed without regard to this paragraph and to section 316(b)(2)(B)";
}
pub relation amount_distributed_to_corporate_distributees_562b2(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the amount of the distribution that goes to corporate distributees";
}
@source(IRC_S562_B, quote = "the amount of any distribution within such period pursuant to such plan shall be treated as a dividend for purposes of computing the dividends paid deduction, to the extent that such amount is distributed to corporate distributees and represents such corporate distributees' allocable share of the undistributed personal holding company income")
rule Section562b2WithinRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, total: Money, to_corp: Money, share: Money) defeasible {
    label en official "section 562(b)(2): a personal holding company's liquidating distribution to corporate distributees is a dividend up to their allocable share (this case: not above it)";
    when distribution_562(dist, c, y, total);
    when personal_holding_company(c, y);
    when liquidation_within_24_months_562b(c, dist);
    when amount_distributed_to_corporate_distributees_562b2(dist, to_corp);
    when allocable_share_of_undistributed_phc_income_562b2(dist, share);
    when to_corp <= share;
    then dividend_for_dividends_paid_deduction_562(dist, c, y, to_corp);
}
@source(IRC_S562_B, quote = "to the extent that such amount is distributed to corporate distributees and represents such corporate distributees' allocable share of the undistributed personal holding company income")
rule Section562b2CappedRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, total: Money, to_corp: Money, share: Money) defeasible {
    label en official "section 562(b)(2): limited to the corporate distributees' allocable share";
    when distribution_562(dist, c, y, total);
    when personal_holding_company(c, y);
    when liquidation_within_24_months_562b(c, dist);
    when amount_distributed_to_corporate_distributees_562b2(dist, to_corp);
    when allocable_share_of_undistributed_phc_income_562b2(dist, share);
    when to_corp > share;
    then dividend_for_dividends_paid_deduction_562(dist, c, y, share);
}
pub relation distribution_pro_rata_within_class_562c1(dist: DistributionEvent) kind empirical {
    label en official "the distribution is pro rata, with no preference to any share of stock as compared with other shares of the same class";
}
pub relation no_preference_between_classes_562c1(dist: DistributionEvent) kind empirical {
    label en official "no preference to one class of stock as compared with another class except to the extent that the former is entitled (without reference to waivers) to such preference";
}
pub relation publicly_offered_regulated_investment_company_562c1(c: Corporation) kind empirical {
    label en official "the corporation is a publicly offered regulated investment company as defined in section 67(c)(2)(B) (cross-reference outside this package)";
}
pub relation real_estate_investment_trust_562c2(c: Corporation) kind empirical {
    label en official "the corporation is a real estate investment trust";
}
pub relation required_to_file_sec_reports_under_1934_act_562c2(c: Corporation) kind empirical {
    label en official "the trust is required to file annual and periodic reports with the Securities and Exchange Commission under the Securities Exchange Act of 1934";
}
pub relation publicly_offered_reit_562c2(c: Corporation) kind institutional {
    label en official "publicly offered REIT: a real estate investment trust required to file annual and periodic reports with the SEC (section 562(c)(2))";
}
@source(IRC_S562_C, quote = "the term \"publicly offered REIT\" means a real estate investment trust which is required to file annual and periodic reports with the Securities and Exchange Commission under the Securities Exchange Act of 1934.")
rule Section562c2PubliclyOfferedReitRule(c: Corporation) defeasible {
    label en official "section 562(c)(2): publicly offered REIT";
    when real_estate_investment_trust_562c2(c);
    when required_to_file_sec_reports_under_1934_act_562c2(c);
    then publicly_offered_reit_562c2(c);
}
pub relation distributing_corporation_of_562c(dist: DistributionEvent, c: Corporation) kind empirical {
    label en unofficial "the corporation that makes the distribution";
}
pub relation ric_shareholder_initial_investment_562c1(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the shareholder of a regulated investment company (not publicly offered) made an initial investment of this amount in the company";
}
pub relation increase_solely_from_administrative_expense_reduction_562c1(dist: DistributionEvent) kind empirical {
    label en official "the distribution is increased solely by reason of reductions in the administrative expenses of the company";
}
pub relation treated_as_pro_rata_without_preference_562c1(dist: DistributionEvent) kind institutional {
    label en official "the distribution is treated as pro rata and not preferential (section 562(c)(1))";
}
@source(IRC_S562_C, quote = "unless such distribution is pro rata, with no preference to any share of stock as compared with other shares of the same class")
rule Section562c1ProRataRule(dist: DistributionEvent) defeasible {
    label en official "section 562(c)(1): pro rata within the class and no preference between classes";
    when distribution_pro_rata_within_class_562c1(dist);
    when no_preference_between_classes_562c1(dist);
    then treated_as_pro_rata_without_preference_562c1(dist);
}
@source(IRC_S562_C, quote = "such distribution shall not be treated as not being pro rata or as being preferential solely by reason of an increase in the distribution by reason of reductions in administrative expenses of the company.")
rule Section562c1RicLargeInvestorRule(dist: DistributionEvent, c: Corporation, investment: Money) defeasible {
    label en official "section 562(c)(1), second sentence: a distribution to a RIC shareholder with an initial investment of at least $10,000,000 is not preferential solely because of expense-driven increases";
    when distributing_corporation_of_562c(dist, c);
    when not_known(publicly_offered_regulated_investment_company_562c1(c));
    when ric_shareholder_initial_investment_562c1(dist, investment);
    when investment >= 10000000.00 USD;
    when increase_solely_from_administrative_expense_reduction_562c1(dist);
    then treated_as_pro_rata_without_preference_562c1(dist);
}
@source(IRC_S562_C, quote = "Except in the case of a publicly offered regulated investment company (as defined in section 67(c)(2)(B)) or a publicly offered REIT")
rule Section562c1QualifiesRule(dist: DistributionEvent) defeasible {
    label en official "section 562(c)(1): a pro rata distribution passes the test";
    when treated_as_pro_rata_without_preference_562c1(dist);
    then distribution_qualifies_after_preferential_test_562c(dist);
}
@source(IRC_S562_C, quote = "Except in the case of a publicly offered regulated investment company (as defined in section 67(c)(2)(B)) or a publicly offered REIT")
rule Section562c1PubliclyOfferedRicRule(dist: DistributionEvent, c: Corporation) defeasible {
    label en official "section 562(c)(1): a publicly offered RIC is outside the test";
    when distributing_corporation_of_562c(dist, c);
    when publicly_offered_regulated_investment_company_562c1(c);
    then distribution_qualifies_after_preferential_test_562c(dist);
}
@source(IRC_S562_C, quote = "Except in the case of a publicly offered regulated investment company (as defined in section 67(c)(2)(B)) or a publicly offered REIT")
rule Section562c1PubliclyOfferedReitRule(dist: DistributionEvent, c: Corporation) defeasible {
    label en official "section 562(c)(1): a publicly offered REIT is outside the test";
    when distributing_corporation_of_562c(dist, c);
    when publicly_offered_reit_562c2(c);
    then distribution_qualifies_after_preferential_test_562c(dist);
}
pub relation member_of_affiliated_group_filing_consolidated_return_562d(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a member of an affiliated group filing or required to file a consolidated return for the taxable year";
}
pub relation required_to_file_separate_phc_schedule_562d(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the member is required to file a separate personal holding company schedule for the taxable year";
}
pub relation distribution_to_other_member_562d(dist: DistributionEvent) kind empirical {
    label en official "the distribution is to another member of the affiliated group";
}
pub relation would_be_dividend_to_nonmember_562d(dist: DistributionEvent) kind empirical {
    label en official "the distribution would constitute a dividend under the other provisions of the section to a recipient which is not a member of an affiliated group";
}
@source(IRC_S562_D, quote = "a distribution by such corporation to another member of the affiliated group shall be considered as a dividend for purposes of computing the dividends paid deduction if such distribution would constitute a dividend under the other provisions of this section to a recipient which is not a member of an affiliated group.")
rule Section562dRule(dist: DistributionEvent, c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 562(d): an intragroup distribution counts if it would be a dividend to a non-member";
    when distribution_562(dist, c, y, amount);
    when member_of_affiliated_group_filing_consolidated_return_562d(c, y);
    when required_to_file_separate_phc_schedule_562d(c, y);
    when distribution_to_other_member_562d(dist);
    when would_be_dividend_to_nonmember_562d(dist);
    then dividend_for_dividends_paid_deduction_562(dist, c, y, amount);
}
pub relation reit_earnings_and_profits_for_year_562e1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the real estate investment trust's earnings and profits for the taxable year (not its accumulated earnings) before the gain adjustment";
}
pub relation reit_real_property_gain_in_taxable_income_562e1a(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gain on the sale or exchange of real property taken into account in determining the trust's taxable income and not otherwise taken into account in determining its earnings and profits";
}
pub relation reit_earnings_and_profits_for_dividends_paid_562e1a(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the REIT's current earnings and profits increased by that gain, for determining dividends under section 316 for the dividends paid deduction (section 562(e)(1)(A))";
}
@source(IRC_S562_E, quote = "the earnings and profits of such trust for any taxable year (but not its accumulated earnings) shall be increased by the amount of gain (if any) on the sale or exchange of real property")
rule Section562e1aRule(c: Corporation, y: TaxableYear, ep: Money, gain: Money) defeasible {
    label en official "section 562(e)(1)(A): current E&P plus the real property gain";
    when real_estate_investment_trust_562c2(c);
    when reit_earnings_and_profits_for_year_562e1(c, y, ep);
    when reit_real_property_gain_in_taxable_income_562e1a(c, y, gain);
    then reit_earnings_and_profits_for_dividends_paid_562e1a(c, y, ep + gain);
}
pub relation reit_failed_562c_562e2(dist: DistributionEvent) kind empirical {
    label en official "a distribution by a real estate investment trust fails to comply with the requirements of subsection (c)";
}
pub relation secretary_provides_remedy_562e2(dist: DistributionEvent) kind empirical {
    label en unofficial "the Secretary provides an appropriate remedy to cure the failure, in lieu of not considering the distribution a dividend";
}
@source(IRC_S562_E, quote = "the Secretary determines that such failure is inadvertent or is due to reasonable cause and not due to willful neglect, or")
pub external judgment relation failure_inadvertent_or_reasonable_cause_562e2a(dist: DistributionEvent) {
    authority Secretary;
    label en official "section 562(e)(2)(A): the failure is inadvertent or is due to reasonable cause and not due to willful neglect — DECISION-0194 evaluative channel, determined by the Secretary";
}
pub relation failure_of_type_identified_by_secretary_562e2b(dist: DistributionEvent) kind empirical {
    label en official "the failure is of a type which the Secretary has identified as described in subparagraph (A)";
}
pub relation remedy_conditions_met_562e2(dist: DistributionEvent) kind institutional {
    label en unofficial "helper: the REIT failed (c) and (A) or (B) holds (the single atom of the power's valid_when)";
}
@source(IRC_S562_E, quote = "the Secretary determines that such failure is inadvertent or is due to reasonable cause and not due to willful neglect, or")
rule Section562e2aRule(dist: DistributionEvent) defeasible {
    label en unofficial "helper: failure within (A)";
    when reit_failed_562c_562e2(dist);
    when failure_inadvertent_or_reasonable_cause_562e2a(dist);
    then remedy_conditions_met_562e2(dist);
}
@source(IRC_S562_E, quote = "such failure is of a type of failure which the Secretary has identified for purposes of this paragraph as being described in subparagraph (A).")
rule Section562e2bRule(dist: DistributionEvent) defeasible {
    label en unofficial "helper: failure within (B)";
    when reit_failed_562c_562e2(dist);
    when failure_of_type_identified_by_secretary_562e2b(dist);
    then remedy_conditions_met_562e2(dist);
}
pub relation failure_cured_by_remedy_562e2(dist: DistributionEvent) kind institutional {
    label en official "the failure is cured by the Secretary's remedy, in lieu of disqualifying the distribution (section 562(e)(2))";
}
@source(IRC_S562_E, quote = "the Secretary may provide an appropriate remedy to cure such failure in lieu of not considering the distribution to be a dividend")
rule Section562e2RemedyPowerRule strict {
    label en official "section 562(e)(2): the Secretary's power to cure a REIT's failure of (c); an exercise outside (A) or (B) is invalid and has no effect (E-0239)";
    for dist: DistributionEvent;
    when secretary_provides_remedy_562e2(dist);
    then power Section562e2Remedy {
        holder us.irc.core::Secretary;
        over dist;
        exercise secretary_provides_remedy_562e2(dist);
        valid_when remedy_conditions_met_562e2(dist);
        effect create(failure_cured_by_remedy_562e2(dist));
        window [-infinity, infinity];
    };
}

// --- Section 563(c): distributions after the close of the year ------------------------

pub relation distribution_deemed_made_on_last_day_563c(c: Corporation, y: TaxableYear, paid_on: Date, amount: Money) kind institutional {
    label en official "for section 562(a) a distribution after the close of the taxable year and on or before the 15th day of the fourth month following it is considered made on the last day of that year (section 563(c))";
}
@source(IRC_S563_C, quote = "a distribution made after the close of a taxable year and on or before the 15th day of the fourth month following the close of the taxable year shall be considered as made on the last day of such taxable year.")
rule Section563cRule(c: Corporation, y: TaxableYear, paid_on: Date, amount: Money) defeasible {
    label en official "section 563(c): a distribution within the grace period is considered made on the year's last day (reads the grace-period membership of module 16)";
    when dividend_within_563_grace_period(c, y, paid_on, amount);
    then distribution_deemed_made_on_last_day_563c(c, y, paid_on, amount);
}

// --- Section 564: dividend carryover -------------------------------------------------

pub relation first_preceding_taxable_year_564(y: TaxableYear, first: TaxableYear) kind empirical {
    label en official "the first preceding taxable year";
}
pub relation second_preceding_taxable_year_564(y: TaxableYear, second: TaxableYear) kind empirical {
    label en official "the second preceding taxable year";
}
pub relation dividends_paid_deduction_without_carryover_564b1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for dividends paid during the year under section 561, determined without regard to the dividend carryover to that year (section 564(b)(1))";
}
@source(IRC_S564_B, quote = "the deduction for dividends paid during such year as provided in section 561 (but determined without regard to the dividend carryover to such year).")
rule Section564b1DeductionRule(c: Corporation, y: TaxableYear, paid: Money, consent: Money) defeasible {
    label en official "section 564(b)(1): dividends paid plus consent dividends, without the carryover";
    when dividends_paid_during_year_561a1(c, y, paid);
    when consent_dividends_561a2(c, y, consent);
    then dividends_paid_deduction_without_carryover_564b1(c, y, paid + consent);
}
pub relation carryover_from_first_preceding_year_564b3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the deduction for dividends paid over taxable income for the first preceding year is allowed as a dividend carryover to the year (section 564(b)(3))";
}
@source(IRC_S564_B, quote = "If there is an excess of such deductions for dividends paid over such taxable income for the first preceding taxable year, such excess shall be allowed as a dividend carryover to the taxable year.")
rule Section564b3ExcessRule(c: Corporation, y: TaxableYear, y1: TaxableYear, dpd: Money, ti: Money) defeasible {
    label en official "section 564(b)(3): first preceding year excess";
    when first_preceding_taxable_year_564(y, y1);
    when dividends_paid_deduction_without_carryover_564b1(c, y1, dpd);
    when taxable_income_adjusted_545b(c, y1, ti);
    when dpd > ti;
    then carryover_from_first_preceding_year_564b3(c, y, dpd - ti);
}
@source(IRC_S564_B, quote = "If there is an excess of such deductions for dividends paid over such taxable income for the first preceding taxable year")
rule Section564b3NoExcessRule(c: Corporation, y: TaxableYear, y1: TaxableYear, dpd: Money, ti: Money) defeasible {
    label en official "section 564(b)(3): no excess for the first preceding year, no carryover from it";
    when first_preceding_taxable_year_564(y, y1);
    when dividends_paid_deduction_without_carryover_564b1(c, y1, dpd);
    when taxable_income_adjusted_545b(c, y1, ti);
    when dpd <= ti;
    then carryover_from_first_preceding_year_564b3(c, y, 0.00 USD);
}
pub relation reduction_for_second_year_excess_564b5(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduction of the second preceding year's excess: the excess of taxable income over the deduction for dividends paid for the first preceding year, if any (section 564(b)(5))";
}
@source(IRC_S564_B, quote = "The amount of the reduction specified in paragraph (4) shall be the amount of the excess of the taxable income, if any, for the first preceding taxable year over such deduction for dividends paid, if any, for the first preceding taxable year.")
rule Section564b5ReductionRule(c: Corporation, y: TaxableYear, y1: TaxableYear, dpd: Money, ti: Money) defeasible {
    label en official "section 564(b)(5): reduction when income exceeds the deduction in the first year";
    when first_preceding_taxable_year_564(y, y1);
    when dividends_paid_deduction_without_carryover_564b1(c, y1, dpd);
    when taxable_income_adjusted_545b(c, y1, ti);
    when ti > dpd;
    then reduction_for_second_year_excess_564b5(c, y, ti - dpd);
}
@source(IRC_S564_B, quote = "The amount of the reduction specified in paragraph (4) shall be the amount of the excess of the taxable income, if any, for the first preceding taxable year over such deduction for dividends paid, if any, for the first preceding taxable year.")
rule Section564b5NoReductionRule(c: Corporation, y: TaxableYear, y1: TaxableYear, dpd: Money, ti: Money) defeasible {
    label en official "section 564(b)(5): no reduction when income does not exceed the deduction in the first year";
    when first_preceding_taxable_year_564(y, y1);
    when dividends_paid_deduction_without_carryover_564b1(c, y1, dpd);
    when taxable_income_adjusted_545b(c, y1, ti);
    when ti <= dpd;
    then reduction_for_second_year_excess_564b5(c, y, 0.00 USD);
}
pub relation carryover_from_second_preceding_year_564b4(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess for the second preceding year, reduced by the paragraph (5) amount, remainder allowed as a dividend carryover (section 564(b)(4))";
}
@source(IRC_S564_B, quote = "such excess shall be reduced by the amount determined in paragraph (5), and the remainder of such excess shall be allowed as a dividend carryover to the taxable year.")
rule Section564b4RemainderRule(c: Corporation, y: TaxableYear, y2: TaxableYear, dpd: Money, ti: Money, reduction: Money) defeasible {
    label en official "section 564(b)(4): the second-year excess less the reduction, when a positive remainder is left";
    when second_preceding_taxable_year_564(y, y2);
    when dividends_paid_deduction_without_carryover_564b1(c, y2, dpd);
    when taxable_income_adjusted_545b(c, y2, ti);
    when reduction_for_second_year_excess_564b5(c, y, reduction);
    when dpd > ti;
    when dpd - ti > reduction;
    then carryover_from_second_preceding_year_564b4(c, y, dpd - ti - reduction);
}
@source(IRC_S564_B, quote = "such excess shall be reduced by the amount determined in paragraph (5), and the remainder of such excess shall be allowed as a dividend carryover to the taxable year.")
rule Section564b4NoRemainderRule(c: Corporation, y: TaxableYear, y2: TaxableYear, dpd: Money, ti: Money, reduction: Money) defeasible {
    label en official "section 564(b)(4): nothing remains after the reduction";
    when second_preceding_taxable_year_564(y, y2);
    when dividends_paid_deduction_without_carryover_564b1(c, y2, dpd);
    when taxable_income_adjusted_545b(c, y2, ti);
    when reduction_for_second_year_excess_564b5(c, y, reduction);
    when dpd > ti;
    when dpd - ti <= reduction;
    then carryover_from_second_preceding_year_564b4(c, y, 0.00 USD);
}
@source(IRC_S564_B, quote = "If there is an excess of such deduction for dividends paid over such taxable income for the second preceding taxable year")
rule Section564b4NoExcessRule(c: Corporation, y: TaxableYear, y2: TaxableYear, dpd: Money, ti: Money) defeasible {
    label en official "section 564(b)(4): no excess for the second preceding year";
    when second_preceding_taxable_year_564(y, y2);
    when dividends_paid_deduction_without_carryover_564b1(c, y2, dpd);
    when taxable_income_adjusted_545b(c, y2, ti);
    when dpd <= ti;
    then carryover_from_second_preceding_year_564b4(c, y, 0.00 USD);
}
pub relation dividend_carryover_564(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the dividend carryover to the taxable year of a personal holding company: the sum of the amounts carried from the two preceding years (section 564(a)); it is not yet wired into module 16's asserted dividend_carryover_561a3_phc (G4013)";
}
@source(IRC_S564_A, quote = "the dividend carryover for any taxable year shall be the dividend carryover to such taxable year, computed as provided in subsection (b), from the two preceding taxable years.")
rule Section564aTotalRule(c: Corporation, y: TaxableYear, first: Money, second: Money) defeasible {
    label en official "section 564(a): the carryover is the sum of the two years' amounts";
    when personal_holding_company(c, y);
    when carryover_from_first_preceding_year_564b3(c, y, first);
    when carryover_from_second_preceding_year_564b4(c, y, second);
    then dividend_carryover_564(c, y, first + second);
}

// --- Section 565(c)-(f): consent dividends -------------------------------------------

pub relation consent_dividend_deemed_money_distribution_565c1(sh: Person, c: Corporation, y: TaxableYear, amount: Money, on: Date) kind institutional {
    label en official "the consent dividend is considered distributed in money by the corporation to the shareholder on the last day of the corporation's taxable year (section 565(c)(1))";
}
@source(IRC_S565_C, quote = "as distributed in money by the corporation to the shareholder on the last day of the taxable year of the corporation")
rule Section565c1Rule(sh: Person, c: Corporation, y: TaxableYear, amount: Money, last_day: Date) defeasible {
    label en official "section 565(c)(1): deemed distribution in money on the last day of the year";
    when consent_dividend_recognized_565(sh, c, y, amount);
    when us.irc.core::ends(y, last_day);
    then consent_dividend_deemed_money_distribution_565c1(sh, c, y, amount, last_day);
}
pub relation consent_dividend_deemed_capital_contribution_565c2(sh: Person, c: Corporation, y: TaxableYear, amount: Money, on: Date) kind institutional {
    label en official "the consent dividend is considered contributed to the capital of the corporation by the shareholder on that day (section 565(c)(2))";
}
@source(IRC_S565_C, quote = "as contributed to the capital of the corporation by the shareholder on such day.")
rule Section565c2Rule(sh: Person, c: Corporation, y: TaxableYear, amount: Money, last_day: Date) defeasible {
    label en official "section 565(c)(2): deemed contribution to capital on the last day of the year";
    when consent_dividend_recognized_565(sh, c, y, amount);
    when us.irc.core::ends(y, last_day);
    then consent_dividend_deemed_capital_contribution_565c2(sh, c, y, amount, last_day);
}
pub relation money_or_property_distributed_with_consent_565d(sh: Person, c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the money or other property distributed together with the consent dividends";
}
pub relation consent_and_other_distribution_considered_together_565d(sh: Person, c: Corporation, y: TaxableYear, total: Money) kind institutional {
    label en official "the entire amount specified in the consents and the amount of the money or other property are considered together (section 565(d))";
}
@source(IRC_S565_D, quote = "the entire amount specified in the consents and the amount of such money or other property shall be considered together for purposes of applying this title.")
rule Section565dRule(sh: Person, c: Corporation, y: TaxableYear, consent: Money, other: Money) defeasible {
    label en official "section 565(d): the consent amount and the other distribution together";
    when consent_dividend_recognized_565(sh, c, y, consent);
    when money_or_property_distributed_with_consent_565d(sh, c, y, other);
    then consent_and_other_distribution_considered_together_565d(sh, c, y, consent + other);
}
pub relation consent_dividend_subject_to_withholding_1441_1442_565e(sh: Person, c: Corporation, y: TaxableYear, withholding: Money) kind empirical {
    label en official "the consent dividend, if paid in money, would be subject to section 1441 or 1442 withholding, in this amount";
}
pub relation money_accompanying_consent_565e(sh: Person, c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the money or other authorized medium of payment that accompanies the consent";
}
pub relation section_565_applies_to_withholding_case_565e(sh: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en official "section 565 applies to a consent dividend that would be subject to withholding only if the consent is accompanied by an amount equal to the withholding (section 565(e))";
}
@source(IRC_S565_E, quote = "this section shall not apply unless the consent is accompanied by money, or such other medium of payment as the Secretary may by regulations authorize, in an amount equal to the amount that would be required to be deducted and withheld under sections 1441 or 1442")
rule Section565eAccompaniedRule(sh: Person, c: Corporation, y: TaxableYear, withholding: Money, paid: Money) defeasible {
    label en official "section 565(e): the accompanying amount must equal the withholding that would be due";
    when consent_dividend_subject_to_withholding_1441_1442_565e(sh, c, y, withholding);
    when money_accompanying_consent_565e(sh, c, y, paid);
    when paid == withholding;
    then section_565_applies_to_withholding_case_565e(sh, c, y);
}
pub relation credit_against_shareholder_tax_565e(sh: Person, c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount accompanying the consent is credited against the tax imposed by the subtitle on the shareholder (section 565(e), last sentence)";
}
@source(IRC_S565_E, quote = "The amount accompanying the consent shall be credited against the tax imposed by this subtitle on the shareholder.")
rule Section565eCreditRule(sh: Person, c: Corporation, y: TaxableYear, withholding: Money, paid: Money) defeasible {
    label en official "section 565(e): credit of the accompanying amount";
    when consent_dividend_subject_to_withholding_1441_1442_565e(sh, c, y, withholding);
    when money_accompanying_consent_565e(sh, c, y, paid);
    when section_565_applies_to_withholding_case_565e(sh, c, y);
    then credit_against_shareholder_tax_565e(sh, c, y, paid);
}
pub entity StockClass565 { label en unofficial "a class of stock of the corporation (section 565(f))"; }
pub relation class_entitled_to_remaining_earnings_after_preferred_565f1(c: Corporation, cls: StockClass565) kind empirical {
    label en official "the class is entitled, after the payment of preferred dividends, to a share in the distribution within the taxable year of all the remaining earnings and profits (not in complete or partial liquidation)";
}
pub relation share_same_proportion_regardless_of_amount_565f1(c: Corporation, cls: StockClass565) kind empirical {
    label en official "the share constitutes the same proportion of the distribution regardless of its amount";
}
pub relation consent_stock_class_565f1(c: Corporation, cls: StockClass565) kind institutional {
    label en official "consent stock: a class entitled after preferred dividends to the same proportion of all remaining earnings and profits distributed within the year (section 565(f)(1))";
}
@source(IRC_S565_F, quote = "Consent stock, for purposes of this section, means the class or classes of stock entitled, after the payment of preferred dividends, to a share in the distribution")
rule Section565f1Rule(c: Corporation, cls: StockClass565) defeasible {
    label en official "section 565(f)(1): both conditions together make the class consent stock";
    when class_entitled_to_remaining_earnings_after_preferred_565f1(c, cls);
    when share_same_proportion_regardless_of_amount_565f1(c, cls);
    then consent_stock_class_565f1(c, cls);
}
pub relation distribution_other_than_liquidation_565f2(dist: DistributionEvent) kind empirical {
    label en official "the distribution is other than in complete or partial liquidation";
}
pub relation distribution_limited_in_amount_565f2(dist: DistributionEvent) kind empirical {
    label en official "the distribution is limited in amount";
}
pub relation must_be_made_before_further_earnings_distribution_565f2(dist: DistributionEvent) kind empirical {
    label en official "the distribution must be made on a class of stock before a further distribution of earnings and profits may be made within the taxable year";
}
pub relation preferred_dividend_565f2(dist: DistributionEvent) kind institutional {
    label en official "preferred dividends for section 565 (section 565(f)(2))";
}
@source(IRC_S565_F, quote = "Preferred dividends, for purposes of this section, means a distribution (other than in complete or partial liquidation), limited in amount")
rule Section565f2Rule(dist: DistributionEvent) defeasible {
    label en official "section 565(f)(2): the three conditions together";
    when distribution_other_than_liquidation_565f2(dist);
    when distribution_limited_in_amount_565f2(dist);
    when must_be_made_before_further_earnings_distribution_565f2(dist);
    then preferred_dividend_565f2(dist);
}
