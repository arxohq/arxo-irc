// Stage 3b (26.09.2026, TECH_GAP reduction). Section 382(a), (b)(3), (d), (e),
// (i), (j), (k), (n), section 383(b)-(e) and section 384(c), (f): the offset
// ceiling, pre-change losses, the value of the old loss corporation, the
// testing period, the change date, definitions, the 2008 Treasury
// restructuring exception, the section 383 analogues and the section 384
// definitions. Status implemented_unverified: nothing here was executed.

// --- Section 382(k): definitions --------------------------------------------------------

use self::{
    Asset,
    Corporation,
    IRC_S382_A,
    IRC_S382_B,
    IRC_S382_D,
    IRC_S382_E,
    IRC_S382_I,
    IRC_S382_J,
    IRC_S382_K,
    IRC_S382_N,
    IRC_S383_B,
    IRC_S383_C,
    IRC_S383_D,
    IRC_S384_C,
    IRC_S384_F,
    OwnershipChangeEvent,
    Person,
    TaxableYear,
    acquires_control_of_another_corp_384a1a,
    asset_acquisition_via_368a1acd_384a1b,
    meets_1504a2_ownership,
    ownership_change_382g,
    section_382_limitation,
    section_384a_applies,
    stock_excluded_from_1504a_definition,
    taxable_income_offset_by_prechange_losses,
};

pub relation entitled_to_use_nol_carryover_or_has_nol_382k1(corp: Corporation, oc: OwnershipChangeEvent) kind empirical {
    label en official "the corporation is entitled to use a net operating loss carryover or has a net operating loss for the taxable year in which the ownership change occurs (section 382(k)(1))";
}
pub relation entitled_to_use_disallowed_interest_carryforward_382k1(corp: Corporation, oc: OwnershipChangeEvent) kind empirical {
    label en official "the corporation is entitled to use a carryforward of disallowed interest described in section 381(c)(20) (section 382(k)(1), second sentence)";
}
pub relation has_net_unrealized_built_in_loss_382k1(corp: Corporation, oc: OwnershipChangeEvent) kind empirical {
    label en official "the corporation has a net unrealized built-in loss (section 382(k)(1), third sentence)";
}
pub relation regulations_exclude_nubil_corporation_382k1(corp: Corporation) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: to the extent provided in regulations a corporation with a net unrealized built-in loss is not a loss corporation";
}
pub relation loss_corporation_382k1(corp: Corporation, oc: OwnershipChangeEvent) kind institutional {
    label en official "loss corporation: entitled to a net operating loss carryover or having a net operating loss for the year, entitled to a disallowed-interest carryforward, or (unless regulations provide otherwise) having a net unrealized built-in loss (section 382(k)(1))";
}
@source(IRC_S382_K, quote = "The term \"loss corporation\" means a corporation entitled to use a net operating loss carryover or having a net operating loss for the taxable year in which the ownership change occurs.")
rule Section382k1NolRule(corp: Corporation, oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(k)(1), first sentence";
    when entitled_to_use_nol_carryover_or_has_nol_382k1(corp, oc);
    then loss_corporation_382k1(corp, oc);
}
@source(IRC_S382_K, quote = "Such term shall include any corporation entitled to use a carryforward of disallowed interest described in section 381(c)(20).")
rule Section382k1InterestRule(corp: Corporation, oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(k)(1), second sentence";
    when entitled_to_use_disallowed_interest_carryforward_382k1(corp, oc);
    then loss_corporation_382k1(corp, oc);
}
@source(IRC_S382_K, quote = "Except to the extent provided in regulations, such term includes any corporation with a net unrealized built-in loss.")
rule Section382k1NubilRule(corp: Corporation, oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(k)(1), third sentence";
    when has_net_unrealized_built_in_loss_382k1(corp, oc);
    when not_known(regulations_exclude_nubil_corporation_382k1(corp));
    then loss_corporation_382k1(corp, oc);
}
pub relation was_loss_corporation_before_change_382k2b(corp: Corporation, oc: OwnershipChangeEvent) kind empirical {
    label en official "before the ownership change the corporation was a loss corporation (section 382(k)(2)(B))";
}
pub relation old_loss_corporation_382k2(corp: Corporation, oc: OwnershipChangeEvent) kind institutional {
    label en official "old loss corporation: a corporation with respect to which there is an ownership change and which before it was a loss corporation (section 382(k)(2))";
}
@source(IRC_S382_K, quote = "The term \"old loss corporation\" means any corporation—")
rule Section382k2Rule(corp: Corporation, oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(k)(2)(A)-(B): both conditions";
    when ownership_change_382g(oc, corp);
    when was_loss_corporation_before_change_382k2b(corp, oc);
    then old_loss_corporation_382k2(corp, oc);
}
pub relation is_loss_corporation_after_change_382k3(corp: Corporation, oc: OwnershipChangeEvent) kind empirical {
    label en official "after the ownership change the corporation is a loss corporation (section 382(k)(3))";
}
pub relation new_loss_corporation_382k3(corp: Corporation, oc: OwnershipChangeEvent) kind institutional {
    label en official "new loss corporation: a corporation which after an ownership change is a loss corporation; the same corporation may be both the old and the new loss corporation (section 382(k)(3))";
}
@source(IRC_S382_K, quote = "The term \"new loss corporation\" means a corporation which (after an ownership change) is a loss corporation.")
rule Section382k3Rule(corp: Corporation, oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(k)(3): a loss corporation after an ownership change";
    when ownership_change_382g(oc, corp);
    when is_loss_corporation_after_change_382k3(corp, oc);
    then new_loss_corporation_382k3(corp, oc);
}
pub relation taxable_income_with_172d_modifications_382k4(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "taxable income computed with the modifications set forth in section 172(d) (section 382(k)(4)); the modifications belong to the net operating loss owner and are not recomputed here";
}
pub relation fair_market_value_of_stock_382k5(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "the value is fair market value (section 382(k)(5))";
}
pub relation stock_of_loss_corporation_382(stock: Asset) kind empirical {
    label en unofficial "the interest is stock of the loss corporation as classified before the section 382(k)(6) exclusions";
}
pub relation regulations_treat_stock_382k6a(stock: Asset) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations, or subsection (e), provide a different treatment of the stock";
}
pub relation stock_for_section_382_382k6a(stock: Asset) kind institutional {
    label en official "stock for section 382: stock other than section 1504(a)(4) preferred stock, except as regulations and subsection (e) provide (section 382(k)(6)(A))";
}
@source(IRC_S382_K, quote = "the term \"stock\" means stock other than stock described in section 1504(a)(4).")
rule Section382k6aRule(stock: Asset) defeasible {
    label en official "section 382(k)(6)(A): stock other than 1504(a)(4) stock (module 22 relation stock_excluded_from_1504a_definition)";
    when stock_of_loss_corporation_382(stock);
    when not_known(stock_excluded_from_1504a_definition(stock));
    when not_known(regulations_treat_stock_382k6a(stock));
    then stock_for_section_382_382k6a(stock);
}
pub relation regulations_prescribed_382k6b(corp: Corporation) kind empirical {
    label en official "the Secretary has prescribed the regulations treating warrants, options, contracts to acquire stock, convertible debt and similar interests as stock, and stock as not stock";
}
@source(IRC_S382_K, quote = "The Secretary shall prescribe such regulations as may be necessary—")
rule Section382k6bRegulationsDutyRule(corp: Corporation, oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(k)(6)(B): the Secretary shall prescribe regulations on rights treated as stock; no day count is stated (G4004)";
    when ownership_change_382g(oc, corp);
    then duty Section382k6bPrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_382k6b(corp);
            window [-infinity, infinity];
        }
    };
}
pub relation regulation_treats_interest_as_stock_382k6bi(interest: Asset) kind empirical {
    label en official "regulations treat the warrant, option, contract to acquire stock, convertible debt interest or similar interest as stock (section 382(k)(6)(B)(i))";
}
pub relation regulation_treats_stock_as_not_stock_382k6bii(stock: Asset) kind empirical {
    label en official "regulations treat the stock as not stock (section 382(k)(6)(B)(ii))";
}
pub relation treated_as_stock_382k6b(x: Asset) kind institutional {
    label en official "the interest is stock for section 382 under the regulations";
}
@source(IRC_S382_K, quote = "to treat warrants, options, contracts to acquire stock, convertible debt interests, and other similar interests as stock, and")
rule Section382k6biRule(x: Asset) defeasible {
    label en official "section 382(k)(6)(B)(i)";
    when regulation_treats_interest_as_stock_382k6bi(x);
    then treated_as_stock_382k6b(x);
}
pub relation treated_as_not_stock_382k6b(x: Asset) kind institutional {
    label en official "the stock is not stock for section 382 under the regulations";
}
@source(IRC_S382_K, quote = "(ii) to treat stock as not stock.")
rule Section382k6biiRule(x: Asset) defeasible {
    label en official "section 382(k)(6)(B)(ii)";
    when regulation_treats_stock_as_not_stock_382k6bii(x);
    then treated_as_not_stock_382k6b(x);
}
pub relation stock_value_of_person_382k6c(person: Person, corp: Corporation, amount: Money) kind empirical {
    label en official "the value of the stock of the corporation held by the person";
}
pub relation total_stock_value_382k6c(corp: Corporation, amount: Money) kind empirical {
    label en official "the value of all stock of the corporation";
}
pub relation percentage_of_stock_by_value_382k6c(person: Person, corp: Corporation, share: Decimal) kind institutional {
    label en official "the percentage of the stock held by the person, determined on the basis of value (section 382(k)(6)(C)); one rounding to six places HALF_UP, JUDGMENT CALL";
}
@source(IRC_S382_K, quote = "Determinations of the percentage of stock of any corporation held by any person shall be made on the basis of value.")
rule Section382k6cRule(person: Person, corp: Corporation, held: Money, total: Money) defeasible {
    label en official "section 382(k)(6)(C): percentage by value";
    when stock_value_of_person_382k6c(person, corp, held);
    when total_stock_value_382k6c(corp, total);
    when total > 0.00 USD;
    then percentage_of_stock_by_value_382k6c(person, corp, div_round(held / 1.00 USD, total / 1.00 USD, 6, "HALF_UP"));
}

// --- Section 382(j): change date; (i): testing period ---------------------------------------

pub relation last_component_owner_shift_382j1(oc: OwnershipChangeEvent, on: Date) kind empirical {
    label en official "the last component of the ownership change is an owner shift involving a 5-percent shareholder, occurring on the given date (section 382(j)(1))";
}
pub relation last_component_equity_structure_shift_382j2(oc: OwnershipChangeEvent, on: Date) kind empirical {
    label en official "the last component of the ownership change is an equity structure shift; the given date is the date of the reorganization (section 382(j)(2))";
}
pub relation change_date_382j(oc: OwnershipChangeEvent, on: Date) kind institutional {
    label en official "the change date of the ownership change (section 382(j))";
}
@source(IRC_S382_J, quote = "in the case where the last component of an ownership change is an owner shift involving a 5-percent shareholder, the date on which such shift occurs, and")
rule Section382j1Rule(oc: OwnershipChangeEvent, on: Date) defeasible {
    label en official "section 382(j)(1): the owner shift date";
    when last_component_owner_shift_382j1(oc, on);
    then change_date_382j(oc, on);
}
@source(IRC_S382_J, quote = "in the case where the last component of an ownership change is an equity structure shift, the date of the reorganization.")
rule Section382j2Rule(oc: OwnershipChangeEvent, on: Date) defeasible {
    label en official "section 382(j)(2): the date of the reorganization";
    when last_component_equity_structure_shift_382j2(oc, on);
    then change_date_382j(oc, on);
}
pub relation post_change_year_defined_382d2(oc: OwnershipChangeEvent, y: TaxableYear) kind institutional {
    label en official "post-change year: any taxable year ending after the change date (section 382(d)(2))";
}
@source(IRC_S382_D, quote = "The term \"post-change year\" means any taxable year ending after the change date.")
rule Section382d2Rule(oc: OwnershipChangeEvent, y: TaxableYear, change: Date, year_end: Date) defeasible {
    label en official "section 382(d)(2): a year ending after the change date (a year ending on the change date is not a post-change year)";
    when change_date_382j(oc, change);
    when us.irc.core::ends(y, year_end);
    when year_end > change;
    then post_change_year_defined_382d2(oc, y);
}
pub relation owner_shift_or_equity_structure_shift_date_382i(oc: OwnershipChangeEvent, on: Date) kind empirical {
    label en official "the day of the owner shift involving a 5-percent shareholder or of the equity structure shift being tested (section 382(i)(1))";
}
pub relation testing_period_start_candidate_382i(oc: OwnershipChangeEvent, start: Date) kind institutional {
    label en unofficial "helper: a candidate first day of the testing period";
}
@source(IRC_S382_I, quote = "the testing period is the 3-year period ending on the day of any owner shift involving a 5-percent shareholder or equity structure shift.")
rule Section382i1ThreeYearRule(oc: OwnershipChangeEvent, on: Date, calendar_before_1: Date) defeasible {
    label en official "section 382(i)(1): the 3-year period ending on the day of the shift begins the day after the third anniversary date before it";
    when owner_shift_or_equity_structure_shift_date_382i(oc, on)
        and us.irc.core::civil_calendar_boundary_before(on, 3, us.irc.core::CalendarYear, calendar_before_1);
    then testing_period_start_candidate_382i(oc, add_calendar_period(calendar_before_1, 1 calendar_day));
}
pub relation earlier_change_date_382i2(oc: OwnershipChangeEvent, on: Date) kind empirical {
    label en official "the change date of an earlier ownership change under section 382 (section 382(i)(2))";
}
@source(IRC_S382_I, quote = "the testing period for determining whether a 2nd ownership change has occurred shall not begin before the 1st day following the change date for such earlier ownership change.")
rule Section382i2Rule(oc: OwnershipChangeEvent, earlier: Date) defeasible {
    label en official "section 382(i)(2): the testing period does not begin before the day after the earlier change date";
    when earlier_change_date_382i2(oc, earlier);
    then testing_period_start_candidate_382i(oc, add_calendar_period(earlier, 1 calendar_day));
}
pub relation first_day_of_first_carryforward_year_382i3(oc: OwnershipChangeEvent, on: Date) kind empirical {
    label en official "the first day of the first taxable year from which there is a carryforward of a loss or of an excess credit to the first post-change year (section 382(i)(3))";
}
pub relation first_day_of_year_of_tested_transaction_382i3(oc: OwnershipChangeEvent, on: Date) kind empirical {
    label en official "the first day of the taxable year in which the transaction being tested occurs (section 382(i)(3))";
}
pub relation loss_corporation_has_nubil_382i3(oc: OwnershipChangeEvent) kind empirical {
    label en official "the loss corporation has a net unrealized built-in loss (determined after section 382(h)(3)(B)), so paragraph (3) does not apply";
}
pub relation regulations_apply_382i3_to_nubil_corporation(oc: OwnershipChangeEvent) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide that paragraph (3) applies also to a net unrealized built-in loss corporation";
}
pub relation carryforward_floor_candidate_382i3(oc: OwnershipChangeEvent, on: Date) kind institutional {
    label en unofficial "helper: a candidate for the earlier of the two dates of paragraph (3)";
}
@source(IRC_S382_I, quote = "The testing period shall not begin before the earlier of the 1st day of the 1st taxable year from which there is a carryforward of a loss or of an excess credit to the 1st post-change year or the taxable year in which the transaction being tested occurs.")
rule Section382i3CarryforwardYearRule(oc: OwnershipChangeEvent, on: Date) defeasible {
    label en unofficial "helper: first carryforward year";
    when first_day_of_first_carryforward_year_382i3(oc, on);
    then carryforward_floor_candidate_382i3(oc, on);
}
@source(IRC_S382_I, quote = "The testing period shall not begin before the earlier of the 1st day of the 1st taxable year from which there is a carryforward of a loss or of an excess credit to the 1st post-change year or the taxable year in which the transaction being tested occurs.")
rule Section382i3TransactionYearRule(oc: OwnershipChangeEvent, on: Date) defeasible {
    label en unofficial "helper: year of the tested transaction";
    when first_day_of_year_of_tested_transaction_382i3(oc, on);
    then carryforward_floor_candidate_382i3(oc, on);
}
pub relation earlier_floor_candidate_exists_382i3(oc: OwnershipChangeEvent, on: Date) kind institutional {
    label en unofficial "helper: a strictly earlier candidate exists";
}
rule Section382i3EarlierExistsRule(oc: OwnershipChangeEvent, on: Date, other: Date) defeasible {
    label en unofficial "helper: an earlier floor candidate";
    when carryforward_floor_candidate_382i3(oc, on);
    when carryforward_floor_candidate_382i3(oc, other);
    when other < on;
    then earlier_floor_candidate_exists_382i3(oc, on);
}
pub relation shorter_period_floor_382i3(oc: OwnershipChangeEvent, on: Date) kind institutional {
    label en official "the earlier of the two dates, below which the testing period does not begin (section 382(i)(3), first sentence)";
}
@source(IRC_S382_I, quote = "The testing period shall not begin before the earlier of the 1st day of the 1st taxable year from which there is a carryforward of a loss or of an excess credit to the 1st post-change year or the taxable year in which the transaction being tested occurs.")
rule Section382i3EarlierRule(oc: OwnershipChangeEvent, on: Date) defeasible {
    label en official "section 382(i)(3): the earlier of the two dates (\"no strictly earlier candidate\", TECH-GAPS G136)";
    when carryforward_floor_candidate_382i3(oc, on);
    when not_known(earlier_floor_candidate_exists_382i3(oc, on));
    then shorter_period_floor_382i3(oc, on);
}
@source(IRC_S382_I, quote = "Except as provided in regulations, this paragraph shall not apply to any loss corporation which has a net unrealized built-in loss")
rule Section382i3AsCandidateRule(oc: OwnershipChangeEvent, on: Date) defeasible {
    label en official "section 382(i)(3): the floor is a candidate for the testing period start, except for a net unrealized built-in loss corporation unless regulations provide otherwise";
    when shorter_period_floor_382i3(oc, on);
    when not_known(loss_corporation_has_nubil_382i3(oc));
    then testing_period_start_candidate_382i(oc, on);
}
@source(IRC_S382_I, quote = "Except as provided in regulations, this paragraph shall not apply to any loss corporation which has a net unrealized built-in loss")
rule Section382i3NubilRegulationsRule(oc: OwnershipChangeEvent, on: Date) defeasible {
    label en official "section 382(i)(3): regulations may extend the floor to a net unrealized built-in loss corporation";
    when shorter_period_floor_382i3(oc, on);
    when loss_corporation_has_nubil_382i3(oc);
    when regulations_apply_382i3_to_nubil_corporation(oc);
    then testing_period_start_candidate_382i(oc, on);
}
pub relation later_start_candidate_exists_382i(oc: OwnershipChangeEvent, start: Date) kind institutional {
    label en unofficial "helper: a strictly later start candidate exists";
}
rule Section382iLaterExistsRule(oc: OwnershipChangeEvent, start: Date, other: Date) defeasible {
    label en unofficial "helper: a later start candidate";
    when testing_period_start_candidate_382i(oc, start);
    when testing_period_start_candidate_382i(oc, other);
    when other > start;
    then later_start_candidate_exists_382i(oc, start);
}
pub relation testing_period_start_382i(oc: OwnershipChangeEvent, start: Date) kind institutional {
    label en official "the first day of the testing period: the latest of the 3-year start and the floors that apply (section 382(i))";
}
@source(IRC_S382_I, quote = "Except as otherwise provided in this section, the testing period is the 3-year period ending on the day of any owner shift involving a 5-percent shareholder or equity structure shift.")
rule Section382iStartRule(oc: OwnershipChangeEvent, start: Date) defeasible {
    label en official "section 382(i): the latest candidate is the start (\"no strictly later candidate\")";
    when testing_period_start_candidate_382i(oc, start);
    when not_known(later_start_candidate_exists_382i(oc, start));
    then testing_period_start_382i(oc, start);
}
pub relation holding_share_on_382k7(person: Person, corp: Corporation, share: Decimal, on: Date) kind empirical {
    label en official "the person holds this percentage of the stock (by value) of the corporation on the given date";
}
pub relation five_percent_shareholder_382k7(person: Person, corp: Corporation, oc: OwnershipChangeEvent) kind institutional {
    label en official "5-percent shareholder: a person holding 5 percent or more of the stock at any time during the testing period (section 382(k)(7))";
}
@source(IRC_S382_K, quote = "The term \"5-percent shareholder\" means any person holding 5 percent or more of the stock of the corporation at any time during the testing period.")
rule Section382k7Rule(person: Person, corp: Corporation, oc: OwnershipChangeEvent, share: Decimal, on: Date, start: Date, shift: Date) defeasible {
    label en official "section 382(k)(7): 5 percent or more on a day of the testing period (start to the day of the shift)";
    when holding_share_on_382k7(person, corp, share, on);
    when testing_period_start_382i(oc, start);
    when owner_shift_or_equity_structure_shift_date_382i(oc, shift);
    when share >= 0.05;
    when on >= start;
    when on <= shift;
    then five_percent_shareholder_382k7(person, corp, oc);
}

// --- Section 382(d): pre-change loss --------------------------------------------------------

pub relation nol_carryforward_to_year_of_change_382d1a(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "any net operating loss carryforward of the old loss corporation to the taxable year ending with the ownership change or in which the change date occurs (section 382(d)(1)(A))";
}
pub relation nol_of_year_of_change_382d1b(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "the net operating loss of the old loss corporation for the taxable year in which the ownership change occurs";
}
pub relation days_in_year_on_or_before_change_date_382d1b(oc: OwnershipChangeEvent, days: Integer) kind empirical {
    label en official "the number of days in that year on or before the change date";
}
pub relation days_in_year_of_change_382d1b(oc: OwnershipChangeEvent, days: Integer) kind empirical {
    label en official "the total number of days in that year";
}
pub relation regulations_or_382h5_allocate_otherwise_382d1(oc: OwnershipChangeEvent) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: subsection (h)(5) or regulations allocate the net operating loss otherwise than ratably";
}
pub relation year_of_change_nol_allocated_to_pre_change_382d1b(oc: OwnershipChangeEvent, amount: Money) kind institutional {
    label en official "the part of the year's net operating loss allocable to the period on or before the change date, allocated ratably to each day (section 382(d)(1)(B)); one rounding cents HALF_UP, JUDGMENT CALL";
}
@source(IRC_S382_D, quote = "Except as provided in subsection (h)(5) and in regulations, the net operating loss shall, for purposes of subparagraph (B), be allocated ratably to each day in the year.")
rule Section382d1bRatableRule(oc: OwnershipChangeEvent, nol: Money, before: Integer, total: Integer) defeasible {
    label en official "section 382(d)(1)(B): ratable allocation by days";
    when nol_of_year_of_change_382d1b(oc, nol);
    when days_in_year_on_or_before_change_date_382d1b(oc, before);
    when days_in_year_of_change_382d1b(oc, total);
    when total > 0;
    when not_known(regulations_or_382h5_allocate_otherwise_382d1(oc));
    then year_of_change_nol_allocated_to_pre_change_382d1b(oc, div_round(nol * before, total * 1.0, 2, "HALF_UP"));
}
pub relation disallowed_interest_carryforward_382d3(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "the carryover of disallowed interest described in section 163(j)(2) (section 382(d)(3))";
}
pub relation pre_change_loss_total_382d(oc: OwnershipChangeEvent, amount: Money) kind institutional {
    label en official "the pre-change losses: the carryforward, the ratable part of the year-of-change loss and the disallowed interest carryover (section 382(d)(1), (3))";
}
@source(IRC_S382_D, quote = "The term \"pre-change loss\" means—")
rule Section382d1TotalRule(oc: OwnershipChangeEvent, carry: Money, current: Money, interest: Money) defeasible {
    label en official "section 382(d)(1) and (3): the sum of the three components";
    when nol_carryforward_to_year_of_change_382d1a(oc, carry);
    when year_of_change_nol_allocated_to_pre_change_382d1b(oc, current);
    when disallowed_interest_carryforward_382d3(oc, interest);
    then pre_change_loss_total_382d(oc, carry + current + interest);
}

// --- Section 382(e): value of the old loss corporation ---------------------------------------

pub relation stock_value_immediately_before_change_382e1(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "the value of the stock of the old loss corporation (including section 1504(a)(4) stock) immediately before the ownership change (section 382(e)(1))";
}
pub relation redemption_or_contraction_in_connection_382e2(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "the amount by which a redemption or other corporate contraction in connection with the change reduces the value (section 382(e)(2))";
}
pub relation foreign_old_loss_corporation_382e3(oc: OwnershipChangeEvent) kind empirical {
    label en official "the old loss corporation is a foreign corporation (section 382(e)(3))";
}
pub relation value_of_us_trade_or_business_items_382e3(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "the value of items treated as connected with the conduct of a trade or business in the United States";
}
pub relation regulations_provide_otherwise_382e3(oc: OwnershipChangeEvent) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise for the foreign corporation";
}
pub relation contraction_present_382e2(oc: OwnershipChangeEvent) kind institutional {
    label en unofficial "helper: a redemption or contraction occurs in connection with the change";
}
rule Section382e2HelperRule(oc: OwnershipChangeEvent, amount: Money) defeasible {
    label en unofficial "helper: contraction exists";
    when redemption_or_contraction_in_connection_382e2(oc, amount);
    then contraction_present_382e2(oc);
}
pub relation old_loss_corporation_value_382e(oc: OwnershipChangeEvent, amount: Money) kind institutional {
    label en official "the value of the old loss corporation (section 382(e)); it is not yet wired into module 14 asserted old_loss_corporation_value_382b1 (G4022)";
}
@source(IRC_S382_E, quote = "the value of the old loss corporation is the value of the stock of such corporation (including any stock described in section 1504(a)(4)) immediately before the ownership change.")
rule Section382e1Rule(oc: OwnershipChangeEvent, value: Money) defeasible {
    label en official "section 382(e)(1): the stock value, with no contraction and no foreign-corporation rule";
    when stock_value_immediately_before_change_382e1(oc, value);
    when not_known(contraction_present_382e2(oc));
    when not_known(foreign_old_loss_corporation_382e3(oc));
    then old_loss_corporation_value_382e(oc, value);
}
@source(IRC_S382_E, quote = "the value under paragraph (1) shall be determined after taking such redemption or other corporate contraction into account.")
rule Section382e2Rule(oc: OwnershipChangeEvent, value: Money, contraction: Money) defeasible {
    label en official "section 382(e)(2): the value determined after the redemption or contraction";
    when stock_value_immediately_before_change_382e1(oc, value);
    when redemption_or_contraction_in_connection_382e2(oc, contraction);
    when not_known(foreign_old_loss_corporation_382e3(oc));
    then old_loss_corporation_value_382e(oc, value - contraction);
}
@source(IRC_S382_E, quote = "there shall be taken into account only items treated as connected with the conduct of a trade or business in the United States.")
rule Section382e3Rule(oc: OwnershipChangeEvent, value: Money) defeasible {
    label en official "section 382(e)(3): a foreign old loss corporation is valued by its U.S. trade or business items, unless regulations provide otherwise";
    when foreign_old_loss_corporation_382e3(oc);
    when value_of_us_trade_or_business_items_382e3(oc, value);
    when not_known(regulations_provide_otherwise_382e3(oc));
    then old_loss_corporation_value_382e(oc, value);
}

// --- Section 382(a) and (b)(3): the offset ceiling -------------------------------------------

pub relation taxable_income_of_new_loss_corporation_382a(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of the new loss corporation for the post-change year";
}
pub relation section_382a_disapplied_382n(oc: OwnershipChangeEvent) kind institutional {
    label en official "the section 382(a) limitation does not apply to the ownership change (section 382(n), see below)";
}
pub relation prechange_offset_ceiling_382a(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of taxable income that pre-change losses may offset for the post-change year: not more than the section 382 limitation (section 382(a))";
}
@source(IRC_S382_A, quote = "The amount of the taxable income of any new loss corporation for any post-change year which may be offset by pre-change losses shall not exceed the section 382 limitation for such year.")
rule Section382aCeilingWithinRule(oc: OwnershipChangeEvent, y: TaxableYear, income: Money, limitation: Money) defeasible {
    label en official "section 382(a): the taxable income is within the limitation: all of it may be offset";
    when taxable_income_of_new_loss_corporation_382a(oc, y, income);
    when section_382_limitation(oc, y, limitation);
    when not_known(section_382a_disapplied_382n(oc));
    when income <= limitation;
    then prechange_offset_ceiling_382a(oc, y, income);
}
@source(IRC_S382_A, quote = "The amount of the taxable income of any new loss corporation for any post-change year which may be offset by pre-change losses shall not exceed the section 382 limitation for such year.")
rule Section382aCeilingLimitedRule(oc: OwnershipChangeEvent, y: TaxableYear, income: Money, limitation: Money) defeasible {
    label en official "section 382(a): the taxable income above the limitation cannot be offset";
    when taxable_income_of_new_loss_corporation_382a(oc, y, income);
    when section_382_limitation(oc, y, limitation);
    when not_known(section_382a_disapplied_382n(oc));
    when income > limitation;
    then prechange_offset_ceiling_382a(oc, y, limitation);
}
pub relation offset_above_limitation_claimed_382a(corp: Corporation, oc: OwnershipChangeEvent, y: TaxableYear) kind institutional {
    label en unofficial "the new loss corporation offsets more taxable income by pre-change losses than the section 382 limitation allows (the action of the prohibition)";
}
@source(IRC_S382_A, quote = "shall not exceed the section 382 limitation for such year.")
rule Section382aExcessOffsetRule(corp: Corporation, oc: OwnershipChangeEvent, y: TaxableYear, offset: Money, limitation: Money) defeasible {
    label en official "section 382(a): the offset actually claimed exceeds the limitation (reads the module 14 offset fact)";
    when new_loss_corporation_382k3(corp, oc);
    when taxable_income_offset_by_prechange_losses(oc, y, offset);
    when section_382_limitation(oc, y, limitation);
    when not_known(section_382a_disapplied_382n(oc));
    when offset > limitation;
    then offset_above_limitation_claimed_382a(corp, oc, y);
}
@source(IRC_S382_A, quote = "shall not exceed the section 382 limitation for such year.")
rule Section382aProhibitionRule(corp: Corporation, oc: OwnershipChangeEvent, y: TaxableYear) defeasible {
    label en official "section 382(a): prohibition on the new loss corporation against offsetting more than the limitation";
    when offset_above_limitation_claimed_382a(corp, oc, y);
    then prohibition Section382aOffsetAboveLimitationBar {
        bearer corp;
        action offset_above_limitation_claimed_382a(corp, oc, y);
        window [-infinity, infinity];
    };
}
pub relation days_in_year_after_change_date_382b3b(oc: OwnershipChangeEvent, y: TaxableYear, days: Integer) kind empirical {
    label en official "the number of days in the post-change year after the change date (section 382(b)(3)(B)(i))";
}
pub relation days_in_year_382b3(oc: OwnershipChangeEvent, y: TaxableYear, days: Integer) kind empirical {
    label en official "the total number of days in the year (section 382(b)(3)(B)(ii))";
}
pub relation year_includes_change_date_382b3(oc: OwnershipChangeEvent, y: TaxableYear) kind empirical {
    label en official "the post-change year includes the change date (section 382(b)(3))";
}
pub relation limitation_for_period_after_change_382b3b(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "for the year that includes the change date the limitation applied to the taxable income of the period after it bears the same ratio to the full limitation as the days after the change date bear to all days (section 382(b)(3)(B)); one rounding cents HALF_UP, JUDGMENT CALL";
}
@source(IRC_S382_B, quote = "the section 382 limitation shall be an amount which bears the same ratio to such limitation (determined without regard to this paragraph) as—")
rule Section382b3bRule(oc: OwnershipChangeEvent, y: TaxableYear, limitation: Money, after: Integer, total: Integer) defeasible {
    label en official "section 382(b)(3)(B): ratable share of the limitation";
    when year_includes_change_date_382b3(oc, y);
    when section_382_limitation(oc, y, limitation);
    when days_in_year_after_change_date_382b3b(oc, y, after);
    when days_in_year_382b3(oc, y, total);
    when total > 0;
    then limitation_for_period_after_change_382b3b(oc, y, div_round(limitation * after, total * 1.0, 2, "HALF_UP"));
}
pub relation taxable_income_of_year_of_change_382b3a(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of the post-change year that includes the change date";
}
pub relation regulations_or_382h5_allocate_income_otherwise_382b3a(oc: OwnershipChangeEvent) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: subsection (h)(5) or regulations allocate the taxable income otherwise than ratably";
}
pub relation income_before_change_date_outside_limitation_382b3a(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the taxable income allocable to the period on or before the change date, to which subsection (a) does not apply, allocated ratably to each day (section 382(b)(3)(A)); one rounding cents HALF_UP, JUDGMENT CALL";
}
@source(IRC_S382_B, quote = "Subsection (a) shall not apply to the portion of the taxable income for such year which is allocable to the period in such year on or before the change date.")
rule Section382b3aRule(oc: OwnershipChangeEvent, y: TaxableYear, income: Money, after: Integer, total: Integer) defeasible {
    label en official "section 382(b)(3)(A): the days-before share of the income is outside the limitation";
    when year_includes_change_date_382b3(oc, y);
    when taxable_income_of_year_of_change_382b3a(oc, y, income);
    when days_in_year_after_change_date_382b3b(oc, y, after);
    when days_in_year_382b3(oc, y, total);
    when total > 0;
    when not_known(regulations_or_382h5_allocate_income_otherwise_382b3a(oc));
    then income_before_change_date_outside_limitation_382b3a(oc, y, div_round(income * (total - after), total * 1.0, 2, "HALF_UP"));
}

// --- Section 382(n): restructuring under the Emergency Economic Stabilization Act -----------

pub relation restructuring_plan_required_by_eesa_treasury_agreement_382n1a(oc: OwnershipChangeEvent) kind empirical {
    label en official "the ownership change is pursuant to a restructuring plan required under a loan agreement or a line-of-credit commitment with the Department of the Treasury under the Emergency Economic Stabilization Act of 2008 (section 382(n)(1)(A))";
}
pub relation restructuring_plan_rationalizes_costs_382n1b(oc: OwnershipChangeEvent) kind empirical {
    label en official "the plan is intended to result in a rationalization of the costs, capitalization and capacity with respect to the manufacturing workforce of, and suppliers to, the taxpayer and its subsidiaries (section 382(n)(1)(B))";
}
pub relation person_owns_50_percent_of_new_loss_corporation_382n3a(oc: OwnershipChangeEvent, p: Person) kind institutional {
    label en official "immediately after the ownership change a person (other than a section 501(c)(9) VEBA) owns stock of the new loss corporation with 50 percent or more of the voting power or of the value (section 382(n)(3)(A)); related persons are one person";
}
pub relation combined_stock_ownership_after_change_382n3(oc: OwnershipChangeEvent, p: Person, voting: Decimal, value: Decimal) kind empirical {
    label en official "the combined share of the voting power and of the value of the new loss corporation owned by the person and the persons related to it (asserted: a sum over the related set, defined by a derived relation, is outside the runtime subset, G4023)";
}
pub relation voluntary_employees_beneficiary_association_501c9_382n3a(p: Person) kind empirical {
    label en official "the person is a voluntary employees' beneficiary association under section 501(c)(9)";
}
@source(IRC_S382_N, quote = "owns stock of the new loss corporation possessing 50 percent or more of the total combined voting power of all classes of stock entitled to vote, or of the total value of the stock of such corporation.")
rule Section382n3aVotingRule(oc: OwnershipChangeEvent, p: Person, voting: Decimal, value: Decimal) defeasible {
    label en official "section 382(n)(3)(A): 50 percent of the voting power";
    when combined_stock_ownership_after_change_382n3(oc, p, voting, value);
    when voting >= 0.50;
    when not_known(voluntary_employees_beneficiary_association_501c9_382n3a(p));
    then person_owns_50_percent_of_new_loss_corporation_382n3a(oc, p);
}
@source(IRC_S382_N, quote = "owns stock of the new loss corporation possessing 50 percent or more of the total combined voting power of all classes of stock entitled to vote, or of the total value of the stock of such corporation.")
rule Section382n3aValueRule(oc: OwnershipChangeEvent, p: Person, voting: Decimal, value: Decimal) defeasible {
    label en official "section 382(n)(3)(A): 50 percent of the value";
    when combined_stock_ownership_after_change_382n3(oc, p, voting, value);
    when value >= 0.50;
    when not_known(voluntary_employees_beneficiary_association_501c9_382n3a(p));
    then person_owns_50_percent_of_new_loss_corporation_382n3a(oc, p);
}
pub relation bears_267b_or_707b_relationship_382n3bii(a: Person, b: Person) kind empirical {
    label en official "the person bears a relationship to the other described in section 267(b) or 707(b) (section 382(n)(3)(B)(ii)(I))";
}
pub relation acting_in_concert_382n3bii(a: Person, b: Person) kind empirical {
    label en official "the persons are members of a group of persons acting in concert (section 382(n)(3)(B)(ii)(II))";
}
pub relation related_persons_382n3bii(a: Person, b: Person) kind institutional {
    label en official "related persons for the 50 percent test: a 267(b)/707(b) relationship or persons acting in concert (section 382(n)(3)(B)(ii))";
}
@source(IRC_S382_N, quote = "such person bears a relationship to such other person described in section 267(b) or 707(b), or")
rule Section382n3biiIRule(a: Person, b: Person) defeasible {
    label en official "section 382(n)(3)(B)(ii)(I)";
    when bears_267b_or_707b_relationship_382n3bii(a, b);
    then related_persons_382n3bii(a, b);
}
@source(IRC_S382_N, quote = "such persons are members of a group of persons acting in concert.")
rule Section382n3biiIIRule(a: Person, b: Person) defeasible {
    label en official "section 382(n)(3)(B)(ii)(II)";
    when acting_in_concert_382n3bii(a, b);
    then related_persons_382n3bii(a, b);
}
pub relation ownership_change_described_in_382n1(oc: OwnershipChangeEvent) kind institutional {
    label en official "the ownership change is described in paragraph (1): pursuant to an EESA Treasury restructuring plan, and no person owns 50 percent or more afterwards (section 382(n)(1), (3))";
}
@source(IRC_S382_N, quote = "The limitation contained in subsection (a) shall not apply in the case of an ownership change which is pursuant to a restructuring plan of a taxpayer which—")
rule Section382n1Rule(oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(n)(1): the EESA restructuring conditions";
    when restructuring_plan_required_by_eesa_treasury_agreement_382n1a(oc);
    when restructuring_plan_rationalizes_costs_382n1b(oc);
    when not_known(person_owns_50_percent_of_new_loss_corporation_382n3a_exists(oc));
    then ownership_change_described_in_382n1(oc);
}
pub relation person_owns_50_percent_of_new_loss_corporation_382n3a_exists(oc: OwnershipChangeEvent) kind institutional {
    label en unofficial "helper: some person owns 50 percent or more after the change";
}
rule Section382n3aExistsRule(oc: OwnershipChangeEvent, p: Person) defeasible {
    label en unofficial "helper: a 50 percent owner exists";
    when person_owns_50_percent_of_new_loss_corporation_382n3a(oc, p);
    then person_owns_50_percent_of_new_loss_corporation_382n3a_exists(oc);
}
pub relation prior_ownership_change_was_described_in_382n1(oc: OwnershipChangeEvent) kind empirical {
    label en official "this is a subsequent ownership change and an earlier one was described in paragraph (1) (section 382(n)(2))";
}
@source(IRC_S382_N, quote = "Paragraph (1) shall not apply in the case of any subsequent ownership change unless such ownership change is described in such paragraph.")
rule Section382n2SubsequentRule(oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(n)(2): a subsequent ownership change is excepted only if itself described in paragraph (1); with the EESA conditions failing there is no disapplication (this rule concludes the disapplication only for a change that itself meets (1))";
    when prior_ownership_change_was_described_in_382n1(oc);
    when ownership_change_described_in_382n1(oc);
    then section_382a_disapplied_382n(oc);
}
@source(IRC_S382_N, quote = "The limitation contained in subsection (a) shall not apply in the case of an ownership change which is pursuant to a restructuring plan of a taxpayer which—")
rule Section382n1DisapplicationRule(oc: OwnershipChangeEvent) defeasible {
    label en official "section 382(n)(1): the limitation does not apply to a change described in paragraph (1) (a first change; a subsequent one goes through paragraph (2))";
    when ownership_change_described_in_382n1(oc);
    when not_known(prior_ownership_change_was_described_in_382n1(oc));
    then section_382a_disapplied_382n(oc);
}

// --- Section 383(b)-(e): net capital losses and foreign tax credits ---------------------------

pub relation net_capital_loss_1212_383b(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "a net capital loss under section 1212 for a taxable year before the first post-change year";
}
pub relation regulations_limit_net_capital_loss_383b(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the net capital loss that the regulations, based on the principles of section 382, permit to be used in the post-change year (the regulation is outside the snapshot: a case fact)";
}
pub relation net_capital_loss_usable_383b(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net capital loss usable in the post-change year, not more than the section 382 limitation available to it (section 383(b), reading the regulation limit as a cap by the limitation, JUDGMENT CALL)";
}
@source(IRC_S383_B, quote = "the amount of any net capital loss under section 1212 for any taxable year before the 1st post-change year which may be used in any post-change year shall be limited under regulations which shall be based on the principles applicable under section 382.")
rule Section383bUsableWithinRule(oc: OwnershipChangeEvent, y: TaxableYear, permitted: Money, limitation: Money) defeasible {
    label en official "section 383(b): the regulation amount when within the section 382 limitation";
    when regulations_limit_net_capital_loss_383b(oc, y, permitted);
    when section_382_limitation(oc, y, limitation);
    when permitted <= limitation;
    then net_capital_loss_usable_383b(oc, y, permitted);
}
@source(IRC_S383_B, quote = "shall be limited under regulations which shall be based on the principles applicable under section 382.")
rule Section383bUsableCappedRule(oc: OwnershipChangeEvent, y: TaxableYear, permitted: Money, limitation: Money) defeasible {
    label en official "section 383(b): the regulation amount above the limitation is capped by it";
    when regulations_limit_net_capital_loss_383b(oc, y, permitted);
    when section_382_limitation(oc, y, limitation);
    when permitted > limitation;
    then net_capital_loss_usable_383b(oc, y, limitation);
}
pub relation net_capital_loss_used_in_post_change_year_383b(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net capital loss actually used in the post-change year";
}
pub relation section_382_limitation_after_capital_loss_383b(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "a net capital loss used in a post-change year reduces the section 382 limitation applied to pre-change losses for that year (section 383(b), second sentence); not below zero (JUDGMENT CALL)";
}
@source(IRC_S383_B, quote = "Such regulations shall provide that any such net capital loss used in a post-change year shall reduce the section 382 limitation which is applied to pre-change losses under section 382 for such year.")
rule Section383bReductionRule(oc: OwnershipChangeEvent, y: TaxableYear, limitation: Money, used: Money) defeasible {
    label en official "section 383(b), second sentence: the limitation less the capital loss used, when it covers it";
    when section_382_limitation(oc, y, limitation);
    when net_capital_loss_used_in_post_change_year_383b(oc, y, used);
    when limitation >= used;
    then section_382_limitation_after_capital_loss_383b(oc, y, limitation - used);
}
@source(IRC_S383_B, quote = "Such regulations shall provide that any such net capital loss used in a post-change year shall reduce the section 382 limitation which is applied to pre-change losses under section 382 for such year.")
rule Section383bReductionFloorRule(oc: OwnershipChangeEvent, y: TaxableYear, limitation: Money, used: Money) defeasible {
    label en official "section 383(b), second sentence: the capital loss above the limitation leaves nothing";
    when section_382_limitation(oc, y, limitation);
    when net_capital_loss_used_in_post_change_year_383b(oc, y, used);
    when limitation < used;
    then section_382_limitation_after_capital_loss_383b(oc, y, 0.00 USD);
}
pub relation excess_foreign_taxes_904c_383c(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "excess foreign taxes under section 904(c) for a taxable year before the first post-change taxable year";
}
pub relation regulations_limit_excess_foreign_taxes_383c(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the excess foreign taxes that the regulations, consistent with the purposes of sections 383 and 382, permit to be used (a case fact)";
}
pub relation excess_foreign_taxes_usable_383c(oc: OwnershipChangeEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess foreign taxes usable in the post-change year as the regulations provide (section 383(c)); the regulation amount is taken as given";
}
@source(IRC_S383_C, quote = "shall be limited under regulations which shall be consistent with purposes of this section and section 382.")
rule Section383cRule(oc: OwnershipChangeEvent, y: TaxableYear, permitted: Money) defeasible {
    label en official "section 383(c): the regulation amount";
    when regulations_limit_excess_foreign_taxes_383c(oc, y, permitted);
    then excess_foreign_taxes_usable_383c(oc, y, permitted);
}
pub relation net_capital_loss_of_year_of_change_383d(oc: OwnershipChangeEvent, amount: Money) kind empirical {
    label en official "the net capital loss (or excess credit) for the taxable year in which the ownership change occurs";
}
pub relation net_capital_loss_allocated_to_pre_change_383d(oc: OwnershipChangeEvent, amount: Money) kind institutional {
    label en official "rules similar to section 382(d)(1)(B): the part of the year's loss allocable to the period on or before the change date, ratably by days (section 383(d)); one rounding cents HALF_UP, JUDGMENT CALL";
}
@source(IRC_S383_D, quote = "rules similar to the rules of subsections (b)(3) and (d)(1)(B) of section 382 shall apply.")
rule Section383dRule(oc: OwnershipChangeEvent, loss: Money, before: Integer, total: Integer) defeasible {
    label en official "section 383(d): ratable allocation in the year that includes the change";
    when net_capital_loss_of_year_of_change_383d(oc, loss);
    when days_in_year_on_or_before_change_date_382d1b(oc, before);
    when days_in_year_of_change_382d1b(oc, total);
    when total > 0;
    then net_capital_loss_allocated_to_pre_change_383d(oc, div_round(loss * before, total * 1.0, 2, "HALF_UP"));
}

// --- Section 384(c), (f): definitions and regulations -----------------------------------------

pub relation asset_disposition_gain_in_recognition_period_384(asset: Asset, gain: Money) kind empirical {
    label en official "the gain recognized during the recognition period on the disposition of the asset";
}
pub relation asset_held_by_gain_corporation_on_acquisition_date_384(asset: Asset) kind empirical {
    label en official "the asset was held by the gain corporation on the acquisition date (the corporation establishes otherwise, section 384(c)(1)(A)(i))";
}
pub relation fair_market_value_on_acquisition_date_384(asset: Asset, amount: Money) kind empirical {
    label en official "the fair market value of the asset on the acquisition date (section 384(c)(1)(A)(ii)(I))";
}
pub relation adjusted_basis_on_acquisition_date_384(asset: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the asset on that date (section 384(c)(1)(A)(ii)(II))";
}
pub relation recognized_built_in_gain_on_asset_384c1a(asset: Asset, amount: Money) kind institutional {
    label en official "the recognized built-in gain on an asset: the gain, but nothing for an asset not held on the acquisition date and not more than the built-in appreciation on that date (section 384(c)(1)(A))";
}
@source(IRC_S384_C, quote = "such asset was not held by the gain corporation on the acquisition date, or")
rule Section384c1aNotHeldRule(asset: Asset, gain: Money) defeasible {
    label en official "section 384(c)(1)(A)(i): an asset not held on the acquisition date has no recognized built-in gain";
    when asset_disposition_gain_in_recognition_period_384(asset, gain);
    when not_known(asset_held_by_gain_corporation_on_acquisition_date_384(asset));
    then recognized_built_in_gain_on_asset_384c1a(asset, 0.00 USD);
}
@source(IRC_S384_C, quote = "such gain exceeds the excess (if any) of—")
rule Section384c1aWithinAppreciationRule(asset: Asset, gain: Money, fmv: Money, basis: Money) defeasible {
    label en official "section 384(c)(1)(A)(ii): the gain when it does not exceed the built-in appreciation";
    when asset_disposition_gain_in_recognition_period_384(asset, gain);
    when asset_held_by_gain_corporation_on_acquisition_date_384(asset);
    when fair_market_value_on_acquisition_date_384(asset, fmv);
    when adjusted_basis_on_acquisition_date_384(asset, basis);
    when gain <= fmv - basis;
    then recognized_built_in_gain_on_asset_384c1a(asset, gain);
}
@source(IRC_S384_C, quote = "such gain exceeds the excess (if any) of—")
rule Section384c1aAboveAppreciationRule(asset: Asset, gain: Money, fmv: Money, basis: Money) defeasible {
    label en official "section 384(c)(1)(A)(ii): the gain above the built-in appreciation counts only up to it";
    when asset_disposition_gain_in_recognition_period_384(asset, gain);
    when asset_held_by_gain_corporation_on_acquisition_date_384(asset);
    when fair_market_value_on_acquisition_date_384(asset, fmv);
    when adjusted_basis_on_acquisition_date_384(asset, basis);
    when gain > fmv - basis;
    when fmv > basis;
    then recognized_built_in_gain_on_asset_384c1a(asset, fmv - basis);
}
@source(IRC_S384_C, quote = "such gain exceeds the excess (if any) of—")
rule Section384c1aNoAppreciationRule(asset: Asset, gain: Money, fmv: Money, basis: Money) defeasible {
    label en official "section 384(c)(1)(A)(ii): no built-in appreciation, no recognized built-in gain";
    when asset_disposition_gain_in_recognition_period_384(asset, gain);
    when asset_held_by_gain_corporation_on_acquisition_date_384(asset);
    when fair_market_value_on_acquisition_date_384(asset, fmv);
    when adjusted_basis_on_acquisition_date_384(asset, basis);
    when fmv <= basis;
    then recognized_built_in_gain_on_asset_384c1a(asset, 0.00 USD);
}
pub relation income_item_attributable_to_pre_acquisition_period_384c1b(corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "an item of income properly taken into account for a recognition period taxable year but attributable to periods before the acquisition date";
}
pub relation income_item_treated_as_recognized_built_in_gain_384c1b(corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the item is a recognized built-in gain for the year in which it is properly taken into account and counts in the net unrealized built-in gain (section 384(c)(1)(B))";
}
@source(IRC_S384_C, quote = "shall be treated as a recognized built-in gain for the taxable year in which it is properly taken into account and shall be taken into account in determining the amount of the net unrealized built-in gain.")
rule Section384c1bRule(corp: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 384(c)(1)(B)";
    when income_item_attributable_to_pre_acquisition_period_384c1b(corp, y, amount);
    then income_item_treated_as_recognized_built_in_gain_384c1b(corp, y, amount);
}
pub relation recognized_built_in_gains_before_limit_384c1c(gc: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the recognized built-in gains for the recognition period taxable year before the (C) limit (the total over assets is asserted: a sum over the derived per-asset amounts is outside the runtime subset, G4024)";
}
pub relation net_unrealized_built_in_gain_384(gc: Corporation, amount: Money) kind empirical {
    label en official "the net unrealized built-in gain of the gain corporation, defined as in section 382(h) with the acquisition date for the change date (section 384(c)(8))";
}
pub relation prior_recognized_built_in_gains_offset_384c1c(gc: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the recognized built-in gains for prior years ending in the recognition period which (but for the section) would have been offset by preacquisition losses (section 384(c)(1)(C)(ii))";
}
pub relation recognized_built_in_gains_after_limit_384c1c(gc: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the recognized built-in gains for the year, not more than the net unrealized built-in gain less the prior years' offset gains (section 384(c)(1)(C))";
}
@source(IRC_S384_C, quote = "The amount of the recognized built-in gains for any recognition period taxable year shall not exceed—")
rule Section384c1cWithinRule(gc: Corporation, y: TaxableYear, gains: Money, nubig: Money, prior: Money) defeasible {
    label en official "section 384(c)(1)(C): the gains within the cap";
    when recognized_built_in_gains_before_limit_384c1c(gc, y, gains);
    when net_unrealized_built_in_gain_384(gc, nubig);
    when prior_recognized_built_in_gains_offset_384c1c(gc, y, prior);
    when gains <= nubig - prior;
    then recognized_built_in_gains_after_limit_384c1c(gc, y, gains);
}
@source(IRC_S384_C, quote = "the net unrealized built-in gain, reduced by")
rule Section384c1cCappedRule(gc: Corporation, y: TaxableYear, gains: Money, nubig: Money, prior: Money) defeasible {
    label en official "section 384(c)(1)(C): the gains above the cap are limited to it";
    when recognized_built_in_gains_before_limit_384c1c(gc, y, gains);
    when net_unrealized_built_in_gain_384(gc, nubig);
    when prior_recognized_built_in_gains_offset_384c1c(gc, y, prior);
    when gains > nubig - prior;
    then recognized_built_in_gains_after_limit_384c1c(gc, y, nubig - prior);
}
pub relation control_acquired_on_384c2a(acquiring: Corporation, acquired: Corporation, on: Date) kind empirical {
    label en official "the date on which the acquisition of control occurs (section 384(c)(2)(A))";
}
pub relation reorganization_transfer_date_384c2b(acquiring: Corporation, acquired: Corporation, on: Date) kind empirical {
    label en official "the date of the transfer in the reorganization (section 384(c)(2)(B))";
}
pub relation acquisition_date_384c2(acquiring: Corporation, acquired: Corporation, on: Date) kind institutional {
    label en official "the acquisition date (section 384(c)(2))";
}
@source(IRC_S384_C, quote = "in any case described in subsection (a)(1)(A), the date on which the acquisition of control occurs, or")
rule Section384c2aRule(acquiring: Corporation, acquired: Corporation, on: Date) defeasible {
    label en official "section 384(c)(2)(A): control acquisition";
    when acquires_control_of_another_corp_384a1a(acquiring, acquired);
    when control_acquired_on_384c2a(acquiring, acquired, on);
    then acquisition_date_384c2(acquiring, acquired, on);
}
@source(IRC_S384_C, quote = "in any case described in subsection (a)(1)(B), the date of the transfer in the reorganization.")
rule Section384c2bRule(acquiring: Corporation, acquired: Corporation, on: Date) defeasible {
    label en official "section 384(c)(2)(B): asset acquisition in a reorganization";
    when asset_acquisition_via_368a1acd_384a1b(acquiring, acquired);
    when reorganization_transfer_date_384c2b(acquiring, acquired, on);
    then acquisition_date_384c2(acquiring, acquired, on);
}
pub relation nol_carryforward_to_acquisition_year_384c3ai(corp: Corporation, amount: Money) kind empirical {
    label en official "any net operating loss carryforward to the taxable year in which the acquisition date occurs (section 384(c)(3)(A)(i))";
}
pub relation nol_of_acquisition_year_384c3aii(corp: Corporation, amount: Money) kind empirical {
    label en official "the net operating loss for the taxable year in which the acquisition date occurs";
}
pub relation days_on_or_before_acquisition_date_384c3a(corp: Corporation, days: Integer) kind empirical {
    label en official "the number of days in that year on or before the acquisition date";
}
pub relation days_in_acquisition_year_384c3a(corp: Corporation, days: Integer) kind empirical {
    label en official "the total number of days in that year";
}
pub relation regulations_allocate_acquisition_year_nol_otherwise_384c3a(corp: Corporation) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations allocate the net operating loss otherwise than ratably";
}
pub relation recognized_built_in_loss_384c3b(corp: Corporation, amount: Money) kind empirical {
    label en official "recognized built-in loss of a corporation with a net unrealized built-in loss (section 384(c)(3)(B))";
}
pub relation has_net_unrealized_built_in_loss_384c3b(corp: Corporation) kind empirical {
    label en official "the corporation has a net unrealized built-in loss";
}
pub relation acquisition_year_nol_allocated_to_pre_acquisition_384c3aii(corp: Corporation, amount: Money) kind institutional {
    label en official "the part of the acquisition year's net operating loss allocable to the period on or before the acquisition date, ratably by days (section 384(c)(3)(A)(ii)); one rounding cents HALF_UP, JUDGMENT CALL";
}
@source(IRC_S384_C, quote = "Except as provided in regulations, the net operating loss shall, for purposes of clause (ii), be allocated ratably to each day in the year.")
rule Section384c3aRatableRule(corp: Corporation, nol: Money, before: Integer, total: Integer) defeasible {
    label en official "section 384(c)(3)(A): ratable allocation";
    when nol_of_acquisition_year_384c3aii(corp, nol);
    when days_on_or_before_acquisition_date_384c3a(corp, before);
    when days_in_acquisition_year_384c3a(corp, total);
    when total > 0;
    when not_known(regulations_allocate_acquisition_year_nol_otherwise_384c3a(corp));
    then acquisition_year_nol_allocated_to_pre_acquisition_384c3aii(corp, div_round(nol * before, total * 1.0, 2, "HALF_UP"));
}
pub relation preacquisition_loss_total_384c3(corp: Corporation, amount: Money) kind institutional {
    label en official "the preacquisition loss: the carryforward, the ratable part of the acquisition-year loss and, for a net unrealized built-in loss corporation, its recognized built-in loss (section 384(c)(3))";
}
@source(IRC_S384_C, quote = "The term \"preacquisition loss\" means—")
rule Section384c3TotalRule(corp: Corporation, carry: Money, current: Money) defeasible {
    label en official "section 384(c)(3)(A): the sum without the built-in loss";
    when nol_carryforward_to_acquisition_year_384c3ai(corp, carry);
    when acquisition_year_nol_allocated_to_pre_acquisition_384c3aii(corp, current);
    when not_known(has_net_unrealized_built_in_loss_384c3b(corp));
    then preacquisition_loss_total_384c3(corp, carry + current);
}
@source(IRC_S384_C, quote = "In the case of a corporation with a net unrealized built-in loss, the term \"preacquisition loss\" includes any recognized built-in loss.")
rule Section384c3bTotalRule(corp: Corporation, carry: Money, current: Money, rbil: Money) defeasible {
    label en official "section 384(c)(3)(B): the sum plus the recognized built-in loss";
    when nol_carryforward_to_acquisition_year_384c3ai(corp, carry);
    when acquisition_year_nol_allocated_to_pre_acquisition_384c3aii(corp, current);
    when has_net_unrealized_built_in_loss_384c3b(corp);
    when recognized_built_in_loss_384c3b(corp, rbil);
    then preacquisition_loss_total_384c3(corp, carry + current + rbil);
}
pub relation gain_corporation_384c4(corp: Corporation) kind institutional {
    label en official "gain corporation: a corporation with a net unrealized built-in gain (section 384(c)(4)); asserted amount above zero";
}
@source(IRC_S384_C, quote = "The term \"gain corporation\" means any corporation with a net unrealized built-in gain.")
rule Section384c4Rule(corp: Corporation, nubig: Money) defeasible {
    label en official "section 384(c)(4): a positive net unrealized built-in gain";
    when net_unrealized_built_in_gain_384(corp, nubig);
    when nubig > 0.00 USD;
    then gain_corporation_384c4(corp);
}
pub relation control_384c5(owner: Corporation, corp: Corporation, on: Date) kind institutional {
    label en official "control: ownership of stock meeting section 1504(a)(2) (80 percent of voting power and of value) (section 384(c)(5)); reads the module 06 test";
}
@source(IRC_S384_C, quote = "The term \"control\" means ownership of stock in a corporation which meets the requirements of section 1504(a)(2).")
rule Section384c5Rule(owner: Corporation, corp: Corporation, on: Date) defeasible {
    label en official "section 384(c)(5): the section 1504(a)(2) test";
    when meets_1504a2_ownership(owner, corp, on);
    then control_384c5(owner, corp, on);
}
pub relation members_of_same_affiliated_group_immediately_before_acquisition_384c6(a: Corporation, b: Corporation) kind empirical {
    label en official "the corporations are members of the same affiliated group immediately before the acquisition date";
}
pub relation regulations_disapply_one_corporation_rule_384c6(a: Corporation, b: Corporation) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide otherwise";
}
pub relation treated_as_one_corporation_384c6(a: Corporation, b: Corporation) kind institutional {
    label en official "all corporations which are members of the same affiliated group immediately before the acquisition date are treated as one corporation, except for the purposes of subsection (b) (section 384(c)(6))";
}
@source(IRC_S384_C, quote = "all corporations which are members of the same affiliated group immediately before the acquisition date shall be treated as 1 corporation.")
rule Section384c6Rule(a: Corporation, b: Corporation) defeasible {
    label en official "section 384(c)(6): one corporation, unless regulations provide otherwise; the subsection (b) carve-out is that module 14 tests (b) on the unmerged corporations";
    when members_of_same_affiliated_group_immediately_before_acquisition_384c6(a, b);
    when not_known(regulations_disapply_one_corporation_rule_384c6(a, b));
    then treated_as_one_corporation_384c6(a, b);
}
pub relation predecessor_or_successor_of_384c7(corp: Corporation, other: Corporation) kind empirical {
    label en official "the other corporation is a predecessor or successor of the corporation";
}
pub relation same_corporation_for_384_384c7(corp: Corporation, other: Corporation) kind institutional {
    label en official "a reference to a corporation includes its predecessors and successors (section 384(c)(7))";
}
@source(IRC_S384_C, quote = "Any reference in this section to a corporation shall include a reference to any predecessor or successor thereof.")
rule Section384c7Rule(corp: Corporation, other: Corporation) defeasible {
    label en official "section 384(c)(7)";
    when predecessor_or_successor_of_384c7(corp, other);
    then same_corporation_for_384_384c7(corp, other);
}
pub relation regulations_prescribed_384f(corp: Corporation) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary to carry out the purposes of section 384, including regulations against circumvention through other provisions of law and contributions of property";
}
@source(IRC_S384_F, quote = "The Secretary shall prescribe such regulations as may be necessary to carry out the purposes of this section")
rule Section384fRegulationsDutyRule(acquiring: Corporation, acquired: Corporation, gain_corp: Corporation, loss_corp: Corporation) defeasible {
    label en official "section 384(f): the Secretary shall prescribe regulations once section 384(a) applies; no day count is stated (G4004)";
    when section_384a_applies(acquiring, acquired, gain_corp, loss_corp);
    then duty Section384fPrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_384f(gain_corp);
            window [-infinity, infinity];
        }
    };
}
