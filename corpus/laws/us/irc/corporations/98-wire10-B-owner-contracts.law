// Corporations -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 367: whether the transferor of an exchange is a United States person is the test of section 7701(a)(30) that the definitions
// package publishes (`united_states_person`). The exchange carried no transferor identity, so a bridging fact names the transferor;
// the case-fact channel of `transferor_is_united_states_person_367` stays valid.

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

use self::{
    ForeignCorporationExchange,
    IRC_S367_A,
    Person,
    transferor_is_united_states_person_367,
};

pub relation transferor_of_exchange_367(x: ForeignCorporationExchange, p: Person) kind empirical {
    label en unofficial "the person that transfers property to a corporation in the exchange (identity of the transferor of section 367)";
}

@source(IRC_S367_A, relation = formalizes, coverage = partial, quote = "a United States person transfers property to a foreign corporation")
rule W10TransferorIsUnitedStatesPersonFromDefinitions(x: ForeignCorporationExchange, p: Person) strict {
    label en official "the transferor of the exchange is a United States person when the definitions package classifies that person as one (section 7701(a)(30))";
    when transferor_of_exchange_367(x, p);
    when us.irc.definitions::united_states_person(p);
    then transferor_is_united_states_person_367(x);
}
