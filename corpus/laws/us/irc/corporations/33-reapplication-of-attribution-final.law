// Corporations -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): section 318(a)(5)(A), the re-application
// of paragraphs (1)-(4) to stock constructively owned.
//
// TECHNIQUE. Module 03 reads only DIRECT `ownership_interest` facts, one hop per kind, because a predicate cannot feed itself
// (LDC-E4102). The second hop is a DIFFERENT relation, `constructive_ownership_second_hop(person, corp, share, first, second)`, whose rules
// read the FIRST-hop result `constructive_ownership(x, corp, share, first)` (the stock constructively owned by x by reason of
// (1)-(4), treated as actually owned by x for the re-application) and apply the attribution kind `second` to it; the tag of the
// first kind is kept, so each path is one row and no two paths are added. The exclusions of (5)(A) "except as provided in
// subparagraphs (B) and (C)": (B) no family attribution of stock constructively owned by reason of the family attribution (first =
// Family, second = Family is not written); (C) no attribution by (2) of stock that an entity owns by reason of (3) (first =
// ToEntity, second = FromEntity is not written). A first hop of kind Actual is the stock owned actually: module 03 already
// applies the kinds to it. The option kind is not re-applied to a constructively owned stock (an option is a fact about the
// holder), but stock the holder owns by option is re-attributed by the rules below (first = Option).
// BOUND (stated in the coverage row): ONE re-application (two hops). A third hop needs a third relation; the depth is not open
// (LDC-E4102). Shares along a path are multiplied; two paths to the same person are not added (the same limit as module 03).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

use self::{
    AttributionKind,
    Corporation,
    Estate,
    IRC_S318_A,
    Individual,
    Partnership,
    Person,
    Trust,
    beneficiary_of_estate,
    beneficiary_of_trust_actuarial_share,
    child_grandchild_or_parent_of,
    constructive_ownership,
    deemed_owner_of_trust_portion,
    fifty_percent_or_more_owner_of_corp,
    legally_separated_spouse,
    partner_of,
    spouse_of,
    trust_beneficiary_remote_contingent_interest,
};

pub relation constructive_ownership_second_hop(p: Person, corp: Corporation, share: Decimal, first: AttributionKind, second: AttributionKind) kind institutional {
    label en official "section 318(a)(5)(A): a person is considered as owning stock that is constructively owned by another by reason of one attribution (first) and re-attributed to the person by a second attribution (second), the stock first attributed being treated as actually owned";
}
@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopFamilyFromSpouse(ind: Individual, spouse: Individual, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(1)(A)(i) applied to the stock the spouse constructively owns, except the stock the spouse owns by the family attribution ((5)(B))";
    when spouse_of(spouse, ind);
    when not_known(legally_separated_spouse(spouse, ind));
    when constructive_ownership(spouse, corp, share, v1);
    when v1 != Actual;
    when v1 != Family;
    then constructive_ownership_second_hop(ind, corp, share, v1, Family);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopFamilyFromLinealRelative(ind: Individual, relative: Individual, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(1)(A)(ii) applied to the stock the relative constructively owns, except the stock the relative owns by the family attribution ((5)(B))";
    when child_grandchild_or_parent_of(relative, ind);
    when constructive_ownership(relative, corp, share, v1);
    when v1 != Actual;
    when v1 != Family;
    then constructive_ownership_second_hop(ind, corp, share, v1, Family);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopFromPartnership(partner: Person, partnership: Partnership, interest_share: Decimal, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(2)(A) applied to the stock the partnership constructively owns, except the stock it owns by (3) ((5)(C))";
    when partner_of(partner, partnership, interest_share);
    when constructive_ownership(partnership, corp, share, v1);
    when v1 != Actual;
    when v1 != ToEntity;
    then constructive_ownership_second_hop(partner, corp, share * interest_share, v1, FromEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopFromEstate(beneficiary: Person, estate: Estate, interest_share: Decimal, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(2)(A) applied to the stock the estate constructively owns, except the stock it owns by (3) ((5)(C))";
    when beneficiary_of_estate(beneficiary, estate, interest_share);
    when constructive_ownership(estate, corp, share, v1);
    when v1 != Actual;
    when v1 != ToEntity;
    then constructive_ownership_second_hop(beneficiary, corp, share * interest_share, v1, FromEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopFromTrustActuarial(beneficiary: Person, trust: Trust, actuarial_share: Decimal, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(2)(B)(i) applied to the stock the trust constructively owns, except the stock it owns by (3) ((5)(C))";
    when beneficiary_of_trust_actuarial_share(beneficiary, trust, actuarial_share);
    when constructive_ownership(trust, corp, share, v1);
    when v1 != Actual;
    when v1 != ToEntity;
    then constructive_ownership_second_hop(beneficiary, corp, share * actuarial_share, v1, FromEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopFromTrustGrantor(owner: Person, trust: Trust, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(2)(B)(ii) applied to the stock the trust constructively owns, except the stock it owns by (3) ((5)(C))";
    when deemed_owner_of_trust_portion(owner, trust);
    when constructive_ownership(trust, corp, share, v1);
    when v1 != Actual;
    when v1 != ToEntity;
    then constructive_ownership_second_hop(owner, corp, share, v1, FromEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopFromFiftyPercentOwnedCorp(owner: Person, held: Corporation, owned_share: Decimal, target: Corporation, held_share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(2)(C) applied to the stock the corporation constructively owns, except the stock it owns by (3) ((5)(C))";
    when fifty_percent_or_more_owner_of_corp(owner, held, owned_share);
    when owned_share >= 0.50;
    when constructive_ownership(held, target, held_share, v1);
    when v1 != Actual;
    when v1 != ToEntity;
    then constructive_ownership_second_hop(owner, target, held_share * owned_share, v1, FromEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopToPartnership(partnership: Partnership, partner: Person, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(3)(A) applied to the stock the partner constructively owns";
    when partner_of(partner, partnership, _);
    when constructive_ownership(partner, corp, share, v1);
    when v1 != Actual;
    then constructive_ownership_second_hop(partnership, corp, share, v1, ToEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopToEstate(estate: Estate, beneficiary: Person, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(3)(A) applied to the stock the beneficiary constructively owns";
    when beneficiary_of_estate(beneficiary, estate, _);
    when constructive_ownership(beneficiary, corp, share, v1);
    when v1 != Actual;
    then constructive_ownership_second_hop(estate, corp, share, v1, ToEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopToTrustFromBeneficiary(trust: Trust, beneficiary: Person, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(3)(B)(i) applied to the stock the beneficiary constructively owns";
    when beneficiary_of_trust_actuarial_share(beneficiary, trust, _);
    when not_known(trust_beneficiary_remote_contingent_interest(beneficiary, trust));
    when constructive_ownership(beneficiary, corp, share, v1);
    when v1 != Actual;
    then constructive_ownership_second_hop(trust, corp, share, v1, ToEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopToTrustFromGrantor(trust: Trust, owner: Person, corp: Corporation, share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(3)(B)(ii) applied to the stock the deemed owner constructively owns";
    when deemed_owner_of_trust_portion(owner, trust);
    when constructive_ownership(owner, corp, share, v1);
    when v1 != Actual;
    then constructive_ownership_second_hop(trust, corp, share, v1, ToEntity);
}

@source(IRC_S318_A, quote = "Except as provided in subparagraphs (B) and (C), stock constructively owned by a person by reason of the application of paragraph (1), (2), (3), or (4), shall, for purposes of applying paragraphs (1), (2), (3), and (4), be considered as actually owned by such person.")
rule SecondHopToCorpFromFiftyPercentOwner(held: Corporation, owner: Person, owned_share: Decimal, target: Corporation, held_share: Decimal, v1: AttributionKind) defeasible {
    label en official "section 318(a)(3)(C) applied to the stock the 50-percent owner constructively owns";
    when fifty_percent_or_more_owner_of_corp(owner, held, owned_share);
    when owned_share >= 0.50;
    when constructive_ownership(owner, target, held_share, v1);
    when v1 != Actual;
    then constructive_ownership_second_hop(held, target, held_share, v1, ToEntity);
}
