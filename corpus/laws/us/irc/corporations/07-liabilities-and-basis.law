// Stage 1b (coordinator continuation, 25.09.2026). Section 357(a)-(c)
// (assumption of liabilities in a section 351/361 exchange: not boot,
// unless a tax-avoidance/no-bona-fide-business-purpose EVALUATIVE finding,
// or liabilities exceed basis -> gain), section 358(a)-(b) (basis to
// distributees: substituted basis with boot adjustments), section
// 362(a)-(b),(e) (basis to corporations: carryover + gain recognized;
// loss-importation limitation).

// --- Section 357(a): assumption of liability is not boot --------------------

use self::{
    Asset,
    ControlledTransfer,
    Corporation,
    IRC_S357_A,
    IRC_S357_B,
    IRC_S357_C,
    IRC_S358_A,
    IRC_S358_D,
    IRC_S362_A,
    IRC_S362_B,
    IRC_S362_E,
    Person,
    net_liabilities_assumed_357c3,
};

pub relation would_qualify_without_boot(t: ControlledTransfer, transferor: Person) kind empirical {
    label en unofficial "the property received would be permitted to be received under section 351 or 361 without recognition of gain if it were the sole consideration (section 357(a)(1))";
}
pub relation liability_assumed_by_other_party(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en official "as part of the consideration, another party to the exchange assumes a liability of the taxpayer (section 357(a)(2))";
}
pub relation assumption_not_treated_as_boot(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "the liability assumption is not treated as money or other property, and does not prevent section 351/361 treatment (section 357(a))";
}
@source(IRC_S357_A, quote = "then such assumption shall not be treated as money or other property, and shall not prevent the exchange from being within the provisions of section 351 or 361, as the case may be.")
rule Section357aNotBootRule(t: ControlledTransfer, transferor: Person, amount: Money) defeasible {
    label en official "section 357(a): assumption of a liability is not boot, absent the (b) tax-avoidance finding or the (c) excess-liabilities gain";
    when would_qualify_without_boot(t, transferor);
    when liability_assumed_by_other_party(t, transferor, amount);
    when not_known(assumption_treated_as_money_357b(t, transferor));
    then assumption_not_treated_as_boot(t, transferor);
}

// --- Section 357(b): tax-avoidance purpose (EVALUATIVE) ----------------------

pub relation assumption_treated_as_money_357b(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "the liability assumption is considered as money received by the taxpayer on the exchange, because its principal purpose was tax avoidance or lacked a bona fide business purpose (section 357(b)(1))";
}
@source(IRC_S357_B, quote = "was a purpose to avoid Federal income tax on the exchange, or")
pub external judgment relation LiabilityAssumptionPrincipalPurposeTaxAvoidance(t: ControlledTransfer, transferor: Person) {
    authority Secretary;
    label en official "section 357(b)(1)(A): the principal purpose of the liability assumption was to avoid Federal income tax on the exchange — DECISION-0194 evaluative channel";
}
@source(IRC_S357_B, quote = "if not such purpose, was not a bona fide business purpose,")
pub external judgment relation LiabilityAssumptionNotBonaFideBusinessPurpose(t: ControlledTransfer, transferor: Person) {
    authority Secretary;
    label en official "section 357(b)(1)(B): the liability assumption, absent a tax-avoidance purpose, was not for a bona fide business purpose — DECISION-0194 evaluative channel";
}
rule Section357bFromTaxAvoidanceJudgment(t: ControlledTransfer, transferor: Person) defeasible {
    when LiabilityAssumptionPrincipalPurposeTaxAvoidance(t, transferor);
    then assumption_treated_as_money_357b(t, transferor);
}
rule Section357bFromNoBonaFideBusinessPurposeJudgment(t: ControlledTransfer, transferor: Person) defeasible {
    when LiabilityAssumptionNotBonaFideBusinessPurpose(t, transferor);
    then assumption_treated_as_money_357b(t, transferor);
}
// Section 357(b)(2) (clear-preponderance burden of proof on the taxpayer) —
// a procedural/evidentiary rule, NON_NORMATIVE for this formalization's
// executable surface (no `evaluate`-level burden-of-proof construct).

// --- Section 357(c): liabilities in excess of basis -> gain ------------------

pub relation total_liabilities_assumed(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the sum of the amount of liabilities assumed pursuant to the exchange (section 357(c)(1))";
}
pub relation total_adjusted_basis_of_transferred_property(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the total of the adjusted basis of the property transferred pursuant to the exchange (section 357(c)(1))";
}
pub relation section_357c_eligible_exchange(t: ControlledTransfer, transferor: Person) kind empirical {
    label en unofficial "the exchange is one to which section 351 applies, or to which section 361 applies by reason of a section 368(a)(1)(D) plan whose stock is distributed in a qualifying section 355 transaction (section 357(c)(1)(A)-(B))";
}
pub relation section_357c_liabilities_excess_gain(t: ControlledTransfer, transferor: Person, amount: Money) kind institutional {
    label en official "the excess of liabilities assumed over the total adjusted basis of the transferred property is treated as gain from the sale or exchange of property (section 357(c)(1))";
}
@source(IRC_S357_C, quote = "if the sum of the amount of the liabilities assumed exceeds the total of the adjusted basis of the property transferred pursuant to such exchange, then such excess shall be considered as a gain from the sale or exchange of a capital asset or of property which is not a capital asset, as the case may be.")
rule Section357cExcessLiabilitiesGainRule(t: ControlledTransfer, transferor: Person, liabilities: Money, basis: Money) defeasible {
    label en official "section 357(c)(1): gain equal to liabilities assumed in excess of transferred basis, unless (c)(2) removes the exchange from this rule";
    when section_357c_eligible_exchange(t, transferor);
    when net_liabilities_assumed_357c3(t, transferor, liabilities);
    when total_adjusted_basis_of_transferred_property(t, transferor, basis);
    when liabilities > basis;
    when not_known(section_357c2_exception_applies(t, transferor));
    then section_357c_liabilities_excess_gain(t, transferor, liabilities - basis);
}
pub relation section_357c2_exception_applies(t: ControlledTransfer, transferor: Person) kind institutional {
    label en official "section 357(c)(1) does not apply: either the (b)(1) tax-avoidance/no-business-purpose finding already governs the exchange, or it is a section 368(a)(1)(G) plan where no former shareholder receives consideration (section 357(c)(2))";
}
@source(IRC_S357_C, quote = "to which subsection (b)(1) of this section applies, or")
rule Section357c2ExceptionFromB1Rule(t: ControlledTransfer, transferor: Person) defeasible {
    when assumption_treated_as_money_357b(t, transferor);
    then section_357c2_exception_applies(t, transferor);
}
pub relation section_368a1g_no_shareholder_consideration(t: ControlledTransfer, transferor: Person) kind empirical {
    label en official "the exchange is pursuant to a section 368(a)(1)(G) plan of reorganization where no former shareholder of the transferor corporation receives any consideration for its stock (section 357(c)(2)(B))";
}
rule Section357c2ExceptionFromG1Rule(t: ControlledTransfer, transferor: Person) defeasible {
    when section_368a1g_no_shareholder_consideration(t, transferor);
    then section_357c2_exception_applies(t, transferor);
}
// Section 357(c)(3) (excluding from "liabilities assumed" a liability whose
// payment would give rise to a deduction or a section 736(a) payment,
// unless it created or increased basis) and section 357(d) (recourse vs.
// nonrecourse liability "assumed" definitional rules) — TECH_GAP, not
// modelled this stage: `total_liabilities_assumed` is read as a single
// case-level aggregate that a case must already net against (c)(3)/(d)
// itself, rather than this package deriving the netted figure.

// --- Section 358(a)-(b): basis to distributees -------------------------------

pub relation exchange_basis_of_property_exchanged(transferor: Person, t: ControlledTransfer, amount: Money) kind empirical {
    label en unofficial "the transferor's basis in the property exchanged, before section 358 adjustments (section 358(a)(1) starting point)";
}
pub relation other_property_fmv_received_358(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the fair market value of other (non-money) property received by the taxpayer in the exchange (section 358(a)(1)(A)(i))";
}
pub relation money_received_358(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the amount of money received by the taxpayer in the exchange (section 358(a)(1)(A)(ii))";
}
pub relation loss_recognized_on_exchange_358(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the amount of loss recognized to the taxpayer on the exchange (section 358(a)(1)(A)(iii))";
}
pub relation dividend_treated_amount_358(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the amount of the exchange's gain treated as a dividend (section 358(a)(1)(B)(i))";
}
pub relation gain_recognized_on_exchange_358(t: ControlledTransfer, transferor: Person, amount: Money) kind empirical {
    label en unofficial "the amount of gain recognized to the taxpayer on the exchange, not including any portion treated as a dividend (section 358(a)(1)(B)(ii))";
}
pub relation substituted_basis_358(transferor: Person, t: ControlledTransfer, amount: Money) kind institutional {
    label en official "the basis of the property permitted to be received without recognition of gain or loss under section 351/354/355/356/361: substituted basis, decreased by other-property FMV, money received and recognized loss, increased by the dividend-treated amount and recognized gain (section 358(a)(1))";
}
@source(IRC_S358_A, quote = "The basis of the property permitted to be received under such section without the recognition of gain or loss shall be the same as that of the property exchanged—")
rule Section358aSubstitutedBasisRule(transferor: Person, t: ControlledTransfer, exchanged_basis: Money, other_fmv: Money, money: Money, loss: Money, dividend_amt: Money, gain: Money) strict {
    label en official "section 358(a)(1): substituted basis with the (A) decreases and (B) increases";
    when exchange_basis_of_property_exchanged(transferor, t, exchanged_basis);
    when other_property_fmv_received_358(t, transferor, other_fmv);
    when money_received_358(t, transferor, money);
    when loss_recognized_on_exchange_358(t, transferor, loss);
    when dividend_treated_amount_358(t, transferor, dividend_amt);
    when gain_recognized_on_exchange_358(t, transferor, gain);
    then substituted_basis_358(transferor, t, (exchanged_basis - other_fmv - money - loss) + dividend_amt + gain);
}
pub relation basis_of_other_property_358(transferor: Person, t: ControlledTransfer, amount: Money) kind institutional {
    label en official "the basis of any other (non-money) property received by the taxpayer is its fair market value (section 358(a)(2))";
}
@source(IRC_S358_A, quote = "The basis of any other property (except money) received by the taxpayer shall be its fair market value.")
rule Section358a2OtherPropertyBasisRule(transferor: Person, t: ControlledTransfer, fmv: Money) strict {
    label en official "section 358(a)(2): FMV basis for non-money, non-permitted property received";
    when other_property_fmv_received_358(t, transferor, fmv);
    then basis_of_other_property_358(transferor, t, fmv);
}

// Section 358(d): liability assumption treated as money for section 358
// purposes, unless excluded under section 357(c)(3).
pub relation liability_treated_as_money_358d(t: ControlledTransfer, transferor: Person, amount: Money) kind institutional {
    label en official "a liability assumed by another party to the exchange is treated as money received by the taxpayer for purposes of section 358 (section 358(d)(1))";
}
@source(IRC_S358_D, quote = "such assumption shall, for purposes of this section, be treated as money received by the taxpayer on the exchange.")
rule Section358dLiabilityAsMoneyRule(t: ControlledTransfer, transferor: Person, amount: Money) defeasible {
    label en official "section 358(d)(1): liability assumption is money received, for section 358 purposes only, unless section 357(c)(3) excludes it (section 358(d)(2))";
    when liability_assumed_by_other_party(t, transferor, amount);
    when not_known(liability_excluded_under_357c3(t, transferor));
    then liability_treated_as_money_358d(t, transferor, amount);
}
pub relation liability_excluded_under_357c3(t: ControlledTransfer, transferor: Person) kind institutional {
    label en unofficial "section 357(c)(3) exclusion switch (TECH_GAP, not derived this stage — see module 07's section 357(c) note); a case may assert it directly to exercise this branch";
}

// NOT DONE this stage in section 358: (b) Secretary's regulatory allocation
// of basis among several properties received, (c) the section 355 exchange
// treatment and retained-stock rule, (e) inapplicability to property
// acquired as consideration for a transfer TO the acquiring corporation
// (a scope-of-section boundary, not a computed rule), (f) property under
// section 361 treated as consisting only of stock/securities, (g) Secretary
// intra-group basis adjustments, (h) the basis-reduction-to-FMV rule for
// liabilities not already treated as money under (d)(1) — all TECH_GAP,
// not modelled.

// --- Section 362(a)-(b): basis to corporations -------------------------------

pub relation property_acquired_in_351_transaction(corp: Corporation, transferor: Person, amount: Money, gain_recognized: Money) kind empirical {
    label en unofficial "property was acquired by the corporation in a section 351 transaction (or as paid-in surplus/contribution to capital); amount is the transferor's basis, gain_recognized is the transferor's recognized gain on the transfer (section 362(a))";
}
pub relation corp_basis_carryover_351(corp: Corporation, amount: Money) kind institutional {
    label en official "the corporation's basis in property acquired in a section 351 transaction or as a capital contribution: transferor's basis increased by the transferor's recognized gain (section 362(a))";
}
@source(IRC_S362_A, quote = "then the basis shall be the same as it would be in the hands of the transferor, increased in the amount of gain recognized to the transferor on such transfer.")
rule Section362aCarryoverBasisRule(corp: Corporation, transferor: Person, transferor_basis: Money, gain_recognized: Money) strict {
    label en official "section 362(a): carryover basis plus recognized gain, capped by the section 362(d)(1) FMV ceiling (module cross-reference, not enforced here — see NOT DONE)";
    when property_acquired_in_351_transaction(corp, transferor, transferor_basis, gain_recognized);
    then corp_basis_carryover_351(corp, transferor_basis + gain_recognized);
}

pub relation property_acquired_in_reorganization(corp: Corporation, transferor: Person, amount: Money, gain_recognized: Money) kind empirical {
    label en unofficial "property was acquired by the corporation in connection with a Part III reorganization; amount is the transferor's basis, gain_recognized is the transferor's recognized gain (section 362(b))";
}
pub relation reorganization_property_is_transferee_stock_or_securities(corp: Corporation, transferor: Person) kind empirical {
    label en official "the property acquired consists of stock or securities in a corporation a party to the reorganization, NOT acquired by exchange of the transferee's (or its controlling corporation's) own stock/securities as consideration — blocks section 362(b) (the section's own carve-out)";
}
pub relation corp_basis_carryover_reorganization(corp: Corporation, amount: Money) kind institutional {
    label en official "the corporation's basis in property acquired in a reorganization: transferor's basis increased by the transferor's recognized gain (section 362(b))";
}
@source(IRC_S362_B, quote = "then the basis shall be the same as it would be in the hands of the transferor, increased in the amount of gain recognized to the transferor on such transfer.")
rule Section362bCarryoverBasisRule(corp: Corporation, transferor: Person, transferor_basis: Money, gain_recognized: Money) defeasible {
    label en official "section 362(b): carryover basis plus recognized gain in a reorganization, unless the stock-or-securities carve-out applies";
    when property_acquired_in_reorganization(corp, transferor, transferor_basis, gain_recognized);
    when not_known(reorganization_property_is_transferee_stock_or_securities(corp, transferor));
    then corp_basis_carryover_reorganization(corp, transferor_basis + gain_recognized);
}

// --- Section 362(e): loss-importation and loss-duplication limitations ------

pub relation transferor_untaxed_on_property_362e(corp: Corporation, transferor: Person, asset: Asset) kind empirical {
    label en official "gain or loss on the property is not subject to tax under this subtitle in the hands of the transferor immediately before the transfer (section 362(e)(1)(B)(i))";
}
pub relation transferee_taxed_on_property_362e(corp: Corporation, transferor: Person, asset: Asset) kind empirical {
    label en official "gain or loss on the property is subject to tax in the hands of the transferee immediately after the transfer (section 362(e)(1)(B)(ii))";
}
pub relation net_built_in_loss_importation(corp: Corporation, transferor: Person, aggregate_basis: Money, aggregate_fmv: Money) kind empirical {
    label en unofficial "the transferee's aggregate adjusted basis of section 362(e)(1)(B) property exceeds its aggregate FMV immediately after the transaction — an importation of a net built-in loss (section 362(e)(1)(C))";
}
pub relation corp_basis_fmv_ceiling_importation(corp: Corporation, asset: Asset, amount: Money) kind institutional {
    label en official "the basis of section 362(e)(1)(B) property is its FMV immediately after the transaction, notwithstanding (a)/(b), when there is an importation of a net built-in loss (section 362(e)(1)(A))";
}
@source(IRC_S362_E, quote = "the basis of each property described in subparagraph (B) which is acquired in such transaction shall (notwithstanding subsections (a) and (b)) be its fair market value immediately after such transaction.")
rule Section362e1ImportedLossFmvRule(corp: Corporation, transferor: Person, asset: Asset, aggregate_basis: Money, aggregate_fmv: Money, property_fmv: Money) defeasible {
    label en official "section 362(e)(1): built-in-loss-importation property takes an FMV basis instead of the (a)/(b) carryover";
    when transferor_untaxed_on_property_362e(corp, transferor, asset);
    when transferee_taxed_on_property_362e(corp, transferor, asset);
    when net_built_in_loss_importation(corp, transferor, aggregate_basis, aggregate_fmv);
    when other_property_fmv_received_358(_, _, property_fmv);
    then corp_basis_fmv_ceiling_importation(corp, asset, property_fmv);
}
// Section 362(e)(2) (the non-importation aggregate basis reduction to FMV
// for section 351 transfers, with its (C) elective transferor-side basis
// alternative) — TECH_GAP, not modelled this stage: needs a proportional
// allocation of the aggregate reduction across several transferred assets
// by their respective built-in losses (same multi-object proportional-
// allocation shape as TECH-GAPS.md G30).

// NOT DONE this stage in section 362: (c) contributions to capital not made
// by a shareholder as such (zero basis for property; 12-month basis
// reduction for money) — TECH_GAP; (d) the FMV ceiling on basis increases
// from gain recognized on liability assumption, and the nonrecourse-
// liability ratable-portion rule — TECH_GAP, cross-references module 07's
// section 357(c)/(d) which are themselves only partly modelled.
