// Section 543(d) — active business computer software royalties (the
// exclusion of such royalties from personal holding company income under
// section 543(a)(1)), with the Pub. L. 119-21 section 70302(b)(8) edition
// split. Stage 3 (26.09.2026, A06). Reads module 16's
// `personal_holding_company_income_amount_543a`; the classified income items
// of section 543(a) stay in module 16.
//
// METHOD. Paragraph (1) defines the royalties: received during the taxable
// year in connection with licensing computer software AND meeting the four
// requirements: (2) the corporation is actively engaged in the software
// business and the software is its own or directly related; (3) the royalties
// are at least 50 percent of ordinary gross income; (4) the deductions under
// sections 162, 174 (and, after the amendment, 174A) and 195 properly
// allocable to the business are at least 25 percent of ordinary gross income
// (for the year, or on the 5-year average), less compensation of the five
// largest shareholders; (5) dividends (562 + 563(c) + 565) at least equal
// the excess of PHC income (recomputed under (B)) over 10 percent of
// ordinary gross income. Paragraph (6) lets a taxpayer that receives such
// royalties rely on an affiliated-group member that meets (2)-(5).
//
// EDITION. Pub. L. 119-21 section 70302(b)(8) (4 July 2025) inserts "174A,"
// after "174," in (4)(A)(i); it applies to amounts paid or incurred in
// taxable years beginning after December 31, 2024 (section 70302(f)(1); the
// amendment-registry row `title26_section 543`). The pre-amendment text
// (the pinned 2024 edition) sums sections 162, 174 and 195; the amended text
// sums 162, 174, 174A and 195. Two rules, one head:
//   * pre-amendment text — while the reading date precedes the enactment
//     date, for every year; from the enactment date on, only for a taxable
//     year beginning on or before December 31, 2024;
//   * amended text — from the enactment date on, for a taxable year
//     beginning after December 31, 2024.
// The `effective` windows are over `legal_time` (the date the law is read),
// the year test over the taxable year's first day.
//
// MONEY. Percentage tests use exact Decimal arithmetic (no rounding is
// prescribed). The 5-year averages, the first-5-year interest window and the
// (B)(iii) rent/mineral-royalty inclusion are case-asserted figures
// (TECH-GAPS G3307): the 5-year ledger is a running computation over years,
// and the language has no iteration primitive over derived tax years.
//
// DEONTICS. None: a definition of an excluded class of income; no conduct is
// required, forbidden, granted or empowered.

// --- Paragraph (1)-(3): royalties, active conduct, 50 percent ----------------

use self::{
    AffiliatedGroup,
    Corporation,
    IRC_S543_D,
    TaxableYear,
    affiliated_group,
    member_of_affiliated_group,
    personal_holding_company_income_amount_543a,
};

pub relation computer_software_royalties_received_543d1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the royalties received by the corporation during the taxable year in connection with the licensing of computer software";
}
pub relation ordinary_gross_income_543d(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the ordinary gross income of the corporation for the taxable year (the base of the 50, 25 and 10 percent tests of section 543(d))";
}
pub relation engaged_in_active_conduct_of_computer_software_business_543d2a(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is engaged in the active conduct of the trade or business of developing, manufacturing, or producing computer software";
}
pub relation software_developed_by_corporation_or_directly_related_543d2b(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the software was developed, manufactured, or produced by the corporation (or its predecessor) in connection with that business, or is directly related to it";
}
pub relation requirement_543d2_met(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the requirement of section 543(d)(2) is met: royalties received by a corporation actively engaged in the computer software business, attributable to its own or directly related software";
}
@source(IRC_S543_D, quote = "are received by a corporation engaged in the active conduct of the trade or business of developing, manufacturing, or producing computer software, and")
rule Requirement543d2Rule(c: Corporation, y: TaxableYear, royalties: Money) strict {
    label en official "section 543(d)(2): active conduct of the software business (A) and own or directly related software (B)";
    when computer_software_royalties_received_543d1(c, y, royalties);
    when engaged_in_active_conduct_of_computer_software_business_543d2a(c, y);
    when software_developed_by_corporation_or_directly_related_543d2b(c, y);
    then requirement_543d2_met(c, y);
}
pub relation requirement_543d3_met(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the requirement of section 543(d)(3) is met: the royalties are at least 50 percent of the ordinary gross income of the corporation for the taxable year";
}
@source(IRC_S543_D, quote = "The requirements of this paragraph are met if the royalties described in paragraph (1) constitute at least 50 percent of the ordinary gross income of the corporation for the taxable year.")
rule Requirement543d3Rule(c: Corporation, y: TaxableYear, royalties: Money, ogi: Money) strict {
    label en official "section 543(d)(3): royalties >= 50 percent of ordinary gross income (exact)";
    when computer_software_royalties_received_543d1(c, y, royalties);
    when ordinary_gross_income_543d(c, y, ogi);
    when royalties > 0.00 USD;
    when royalties >= ogi * 0.50;
    then requirement_543d3_met(c, y);
}

// --- Paragraph (4): deductions of at least 25 percent (edition split) -----------

pub relation deduction_under_section_162_allocable_543d4(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowable under section 162 for the taxable year, properly allocable to the trade or business of paragraph (2), and not specifically allowable under another section (section 543(d)(4)(B))";
}
pub relation deduction_under_section_174_allocable_543d4(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowable under section 174 for the taxable year, properly allocable to that business";
}
pub relation deduction_under_section_174a_allocable_543d4(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowable under section 174A (domestic research or experimental expenditures) for the taxable year, properly allocable to that business";
}
pub relation deduction_under_section_195_allocable_543d4(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowable under section 195 for the taxable year, properly allocable to that business";
}
pub relation compensation_of_five_largest_shareholders_in_deductions_543d4c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the compensation for personal services rendered by the 5 individual shareholders holding the largest percentage (by value) of the stock — individuals under 5 percent and shareholders by section 544(a)(2) attribution alone disregarded — included in the deductions above (0.00 USD when none)";
}

pub relation deductions_before_limitation_543d4a(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the deductions allowable under sections 162, 174 (and, for taxable years beginning after December 31, 2024, 174A) and 195 that are properly allocable to the paragraph (2) business, before the (C) limitation";
}
@source(IRC_S543_D, quote = "the sum of the deductions allowable to the corporation under sections 162, 174, and 195 for the taxable year which are properly allocable to the trade or business described in paragraph (2)")
rule Deductions543d4aBeforeAmendmentRule(c: Corporation, y: TaxableYear, d162: Money, d174: Money, d195: Money) defeasible {
    label en official "section 543(d)(4)(A)(i), text before Pub. L. 119-21 section 70302(b)(8): sections 162, 174 and 195 (read before the enactment date, any year)";
    effective (-infinity, @2025-07-04);
    when deduction_under_section_162_allocable_543d4(c, y, d162);
    when deduction_under_section_174_allocable_543d4(c, y, d174);
    when deduction_under_section_195_allocable_543d4(c, y, d195);
    then deductions_before_limitation_543d4a(c, y, d162 + d174 + d195);
}
@source(IRC_S543_D, quote = "the sum of the deductions allowable to the corporation under sections 162, 174, and 195 for the taxable year which are properly allocable to the trade or business described in paragraph (2)")
rule Deductions543d4aEarlierYearsAfterEnactmentRule(c: Corporation, y: TaxableYear, d162: Money, d174: Money, d195: Money, begins_on: Date) defeasible {
    label en official "section 543(d)(4)(A)(i), text before the amendment: a taxable year beginning on or before December 31, 2024 keeps sections 162, 174 and 195 when read after the enactment date";
    effective [@2025-07-04, infinity);
    when us.irc.core::begins(y, begins_on);
    when begins_on <= @2024-12-31;
    when deduction_under_section_162_allocable_543d4(c, y, d162);
    when deduction_under_section_174_allocable_543d4(c, y, d174);
    when deduction_under_section_195_allocable_543d4(c, y, d195);
    then deductions_before_limitation_543d4a(c, y, d162 + d174 + d195);
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "Section 543(d)(4)(A)(i) is amended by inserting “174A,” after “174,”.")
@source(IRC_S543_D, quote = "the sum of the deductions allowable to the corporation under sections 162, 174, and 195 for the taxable year which are properly allocable to the trade or business described in paragraph (2)")
rule Deductions543d4aAfterAmendmentRule(c: Corporation, y: TaxableYear, d162: Money, d174: Money, d174a: Money, d195: Money, begins_on: Date) defeasible {
    label en official "section 543(d)(4)(A)(i) as amended by Pub. L. 119-21 section 70302(b)(8): sections 162, 174, 174A and 195, for a taxable year beginning after December 31, 2024 (section 70302(f)(1)), read from the enactment date";
    effective [@2025-07-04, infinity);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2024-12-31;
    when deduction_under_section_162_allocable_543d4(c, y, d162);
    when deduction_under_section_174_allocable_543d4(c, y, d174);
    when deduction_under_section_174a_allocable_543d4(c, y, d174a);
    when deduction_under_section_195_allocable_543d4(c, y, d195);
    then deductions_before_limitation_543d4a(c, y, d162 + d174 + d174a + d195);
}
pub relation qualifying_deductions_543d4(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deductions taken into account under section 543(d)(4)(A): the sum above less the compensation of the five largest shareholders (section 543(d)(4)(C))";
}
@source(IRC_S543_D, quote = "no deduction shall be taken into account with respect to compensation for personal services rendered by the 5 individual shareholders holding the largest percentage (by value) of the outstanding stock of the corporation.")
rule QualifyingDeductions543d4cRule(c: Corporation, y: TaxableYear, gross: Money, top_five: Money) defeasible {
    label en official "section 543(d)(4)(C): the five largest shareholders' compensation is not taken into account";
    when deductions_before_limitation_543d4a(c, y, gross);
    when compensation_of_five_largest_shareholders_in_deductions_543d4c(c, y, top_five);
    then qualifying_deductions_543d4(c, y, gross - top_five);
}
pub relation average_qualifying_deductions_5_year_543d4a(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average of the qualifying deductions for the 5-taxable year period ending with the taxable year (the period of existence, if shorter) — a case-asserted figure, TECH-GAPS G3307";
}
pub relation average_ordinary_gross_income_5_year_543d4a(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average ordinary gross income for the same 5-taxable year period (or the period of existence) — a case-asserted figure, TECH-GAPS G3307";
}
pub relation requirement_543d4_met(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the requirement of section 543(d)(4) is met: qualifying deductions are at least 25 percent of ordinary gross income, for the year (A)(i) or on the 5-year average (A)(ii)";
}
@source(IRC_S543_D, quote = "equals or exceeds 25 percent of the ordinary gross income of such corporation for such taxable year, or")
rule Requirement543d4aiRule(c: Corporation, y: TaxableYear, deductions: Money, ogi: Money) defeasible {
    label en official "section 543(d)(4)(A)(i): the year's qualifying deductions are at least 25 percent of the year's ordinary gross income (exact)";
    when qualifying_deductions_543d4(c, y, deductions);
    when ordinary_gross_income_543d(c, y, ogi);
    when ogi > 0.00 USD;
    when deductions >= ogi * 0.25;
    then requirement_543d4_met(c, y);
}
@source(IRC_S543_D, quote = "the average of such deductions for the 5-taxable year period ending with such taxable year equals or exceeds 25 percent of the average ordinary gross income of such corporation for such period.")
rule Requirement543d4aiiRule(c: Corporation, y: TaxableYear, avg_deductions: Money, avg_ogi: Money) strict {
    label en official "section 543(d)(4)(A)(ii): the 5-year average of the deductions is at least 25 percent of the 5-year average ordinary gross income (exact)";
    when average_qualifying_deductions_5_year_543d4a(c, y, avg_deductions);
    when average_ordinary_gross_income_5_year_543d4a(c, y, avg_ogi);
    when avg_ogi > 0.00 USD;
    when avg_deductions >= avg_ogi * 0.25;
    then requirement_543d4_met(c, y);
}

// --- Paragraph (5): dividends against recomputed PHC income -----------------------

pub relation dividends_paid_562_543d5(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the dividends paid during the taxable year, determined under section 562";
}
pub relation dividends_considered_paid_563c_543d5(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the dividends considered as paid on the last day of the taxable year under section 563(c), as limited by the second sentence of section 563(b)";
}
pub relation consent_dividends_565_543d5(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the consent dividends for the taxable year, determined under section 565";
}
pub relation amounts_described_in_543a1c_543d5(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amounts described in section 543(a)(1)(C) included in personal holding company income, to be disregarded (section 543(d)(5)(B)(i)); 0.00 USD when none";
}
pub relation interest_income_in_phc_income_543d5(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the interest income included in personal holding company income for the taxable year";
}
pub relation year_in_first_five_year_period_of_software_business_543d5b2i(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the taxable year is in the 5-taxable year period beginning with the later of the corporation's first taxable year or the first taxable year in which it conducted the paragraph (2) business";
}
pub relation adjusted_rents_and_mineral_royalties_to_include_543d5b3(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted income from rents and from mineral, oil, and gas royalties (within the meaning of section 543(a)(2) and (3)) that section 543(d)(5)(B)(iii) requires to be included, to the extent not already in personal holding company income (0.00 USD when none)";
}
pub relation interest_disregarded_for_543d5_year(c: Corporation, y: TaxableYear) kind institutional {
    label en official "interest income of the taxable year is disregarded in computing personal holding company income for paragraph (5): a year in the first 5-year period in which the corporation meets paragraphs (2), (3) and (4)";
}
@source(IRC_S543_D, quote = "during which the corporation meets the requirements of paragraphs (2), (3), and (4)")
rule InterestDisregardedFor543d5YearRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 543(d)(5)(B)(ii): interest income is disregarded in a first-5-year-period year in which paragraphs (2), (3) and (4) are met";
    when year_in_first_five_year_period_of_software_business_543d5b2i(c, y);
    when requirement_543d2_met(c, y);
    when requirement_543d3_met(c, y);
    when requirement_543d4_met(c, y);
    then interest_disregarded_for_543d5_year(c, y);
}
pub relation personal_holding_company_income_for_543d5(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "personal holding company income computed for section 543(d)(5): without the (a)(1)(C) amounts, without interest income in a qualifying first-5-year year, and including the adjusted rents and mineral royalties";
}
@source(IRC_S543_D, quote = "(ii) without regard to interest income during any taxable year—")
rule PersonalHoldingCompanyIncomeFor543d5WithoutInterestRule(c: Corporation, y: TaxableYear, phc: Money, a1c: Money, interest: Money, adds: Money) defeasible {
    label en official "section 543(d)(5)(B): recomputed PHC income = PHC income - (a)(1)(C) amounts - interest income (qualifying year) + adjusted rents and mineral royalties";
    when personal_holding_company_income_amount_543a(c, y, phc);
    when amounts_described_in_543a1c_543d5(c, y, a1c);
    when interest_income_in_phc_income_543d5(c, y, interest);
    when adjusted_rents_and_mineral_royalties_to_include_543d5b3(c, y, adds);
    when interest_disregarded_for_543d5_year(c, y);
    then personal_holding_company_income_for_543d5(c, y, phc - a1c - interest + adds);
}
@source(IRC_S543_D, quote = "(i) without regard to amounts described in subsection (a)(1)(C),")
rule PersonalHoldingCompanyIncomeFor543d5WithInterestRule(c: Corporation, y: TaxableYear, phc: Money, a1c: Money, adds: Money) defeasible {
    label en official "section 543(d)(5)(B): recomputed PHC income = PHC income - (a)(1)(C) amounts + adjusted rents and mineral royalties (interest stays in)";
    when personal_holding_company_income_amount_543a(c, y, phc);
    when amounts_described_in_543a1c_543d5(c, y, a1c);
    when adjusted_rents_and_mineral_royalties_to_include_543d5b3(c, y, adds);
    when not_known(interest_disregarded_for_543d5_year(c, y));
    then personal_holding_company_income_for_543d5(c, y, phc - a1c + adds);
}
pub relation requirement_543d5_met(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the requirement of section 543(d)(5) is met: the dividends (562 + 563(c) + 565) equal or exceed the excess, if any, of the recomputed personal holding company income over 10 percent of ordinary gross income";
}
@source(IRC_S543_D, quote = "equals or exceeds the amount, if any, by which the personal holding company income for the taxable year exceeds 10 percent of the ordinary gross income of such corporation for such taxable year.")
rule Requirement543d5NoExcessRule(c: Corporation, y: TaxableYear, phc: Money, ogi: Money) defeasible {
    label en official "section 543(d)(5)(A): met when recomputed PHC income does not exceed 10 percent of ordinary gross income (no excess to cover)";
    when personal_holding_company_income_for_543d5(c, y, phc);
    when ordinary_gross_income_543d(c, y, ogi);
    when phc <= ogi * 0.10;
    then requirement_543d5_met(c, y);
}
@source(IRC_S543_D, quote = "equals or exceeds the amount, if any, by which the personal holding company income for the taxable year exceeds 10 percent of the ordinary gross income of such corporation for such taxable year.")
rule Requirement543d5DividendsCoverExcessRule(c: Corporation, y: TaxableYear, phc: Money, ogi: Money, paid: Money, considered: Money, consent: Money) defeasible {
    label en official "section 543(d)(5)(A): met when dividends paid + considered paid + consent dividends are at least the excess of recomputed PHC income over 10 percent of ordinary gross income (exact)";
    when personal_holding_company_income_for_543d5(c, y, phc);
    when ordinary_gross_income_543d(c, y, ogi);
    when dividends_paid_562_543d5(c, y, paid);
    when dividends_considered_paid_563c_543d5(c, y, considered);
    when consent_dividends_565_543d5(c, y, consent);
    when phc > ogi * 0.10;
    when paid + considered + consent >= phc - ogi * 0.10;
    then requirement_543d5_met(c, y);
}

// --- Paragraph (6): affiliated group members; the royalties themselves ----------------

pub relation requirements_543d2_to_5_met_directly(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation itself meets the requirements of section 543(d)(2), (3), (4) and (5) for the taxable year";
}
rule RequirementsMetDirectlyRule(c: Corporation, y: TaxableYear) defeasible {
    label en unofficial "helper: all four requirements met by the corporation itself";
    when requirement_543d2_met(c, y);
    when requirement_543d3_met(c, y);
    when requirement_543d4_met(c, y);
    when requirement_543d5_met(c, y);
    then requirements_543d2_to_5_met_directly(c, y);
}
pub relation same_software_as_affiliated_member_543d6(c: Corporation, y: TaxableYear, other: Corporation) kind empirical {
    label en official "the royalties the taxpayer receives are in connection with the licensing of computer software with respect to which the other affiliated-group member meets paragraphs (2)-(5)";
}
pub relation requirements_543d2_to_5_treated_as_met(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the taxpayer is treated as having met the requirements of section 543(d)(2)-(5): directly, or through a member of the same affiliated group (section 543(d)(6))";
}
rule RequirementsTreatedAsMetDirectlyRule(c: Corporation, y: TaxableYear) defeasible {
    label en unofficial "directly met";
    when requirements_543d2_to_5_met_directly(c, y);
    then requirements_543d2_to_5_treated_as_met(c, y);
}
@source(IRC_S543_D, quote = "the taxpayer shall be treated as having met such requirements.")
rule Section543d6AffiliatedMemberRule(c: Corporation, y: TaxableYear, other: Corporation, group: AffiliatedGroup, royalties: Money) defeasible {
    label en official "section 543(d)(6): a taxpayer receiving software licensing royalties is treated as meeting (2)-(5) when another member of the same affiliated group (section 1504(a)) meets them for the same software";
    when computer_software_royalties_received_543d1(c, y, royalties);
    when affiliated_group(group);
    when member_of_affiliated_group(group, c);
    when member_of_affiliated_group(group, other);
    when same_software_as_affiliated_member_543d6(c, y, other);
    when requirements_543d2_to_5_met_directly(other, y);
    then requirements_543d2_to_5_treated_as_met(c, y);
}
pub relation active_business_computer_software_royalties_543d(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the corporation's active business computer software royalties for the taxable year (section 543(d)(1)): the royalties received, when the requirements of paragraphs (2)-(5) are met; such royalties are outside personal holding company income under section 543(a)(1)";
}
@source(IRC_S543_D, quote = "means any royalties—")
rule ActiveBusinessComputerSoftwareRoyaltiesRule(c: Corporation, y: TaxableYear, royalties: Money) defeasible {
    label en official "section 543(d)(1): royalties received in connection with licensing computer software, with the requirements of paragraphs (2), (3), (4) and (5) met (directly or under paragraph (6))";
    when computer_software_royalties_received_543d1(c, y, royalties);
    when requirements_543d2_to_5_treated_as_met(c, y);
    then active_business_computer_software_royalties_543d(c, y, royalties);
}
// NOT DONE (TECH-GAPS G3307): the wiring of `active_business_computer_
// software_royalties_543d` into module 16's `personal_holding_company_income_
// item_543a` (the (a)(1) item there is a case-asserted amount per kind; the
// exclusion is stated here as its own conclusion for a consumer to subtract),
// and the 5-year ledger behind the (4)(A)(ii) averages.
