// Sections 354 (exchanges of stock/securities in reorganizations), 355
// (distributions of stock of a controlled corporation), and 356 (receipt of
// additional consideration — boot). Stage 2 (IRC-08 stage 2, A06), priority
// sections. Reads module 10's `reorganization`/`party_to_a_reorganization`
// classification and module 05's section 368(c) `control` relation.
//
// METHOD: section 354(a)(1) nonrecognition, with the (a)(2)(A) excess-
// principal-amount limitation and the (b) exception for type D/G
// reorganizations requiring the section 355-style substantially-all-and-
// distribution conditions; section 355(a)(1)(A)-(D)'s four cumulative
// requirements (control before, solely stock/securities distributed, not a
// device (EVALUATIVE), active business, and the all-stock-or-control-amount
// distribution test with the Secretary's satisfaction as a power/evaluative
// channel), section 355(b)'s active-trade-or-business definition (the core
// 5-year/not-taxably-acquired tests decomposed; the (2)(D) control-
// acquisition sub-test is one composite case fact — TECH_GAP, the same
// judgment-call shape as this package's own section 302(e)(2) safe harbor),
// section 355(d)'s disqualified-distribution 50-percent test (the
// "purchase"/attribution tracing behind `disqualified stock` is itself a
// deep multi-part definition, sections 355(d)(3)-(9) — read here as a
// case-asserted aggregate share, TECH_GAP for the full trace), section
// 355(e)'s 50-percent-or-greater-interest-within-the-window test (the ONE
// piece of this file with EXACT DATE ARITHMETIC per the task brief: the
// 4-year window from 2 years before to 2 years after the distribution date,
// via `add_calendar_period`), and section 356(a)-(b) (boot gain recognition
// with the (a)(2) dividend-treatment E&P ceiling, and the (b) additional-
// consideration-as-section-301-distribution bridge).

// --- Section 354(a): nonrecognition on exchange of stock/securities -------

use self::{
    Corporation,
    IRC_S354_A,
    IRC_S354_B,
    IRC_S355_A,
    IRC_S355_B,
    IRC_S355_D,
    IRC_S355_E,
    IRC_S356_A,
    IRC_S356_B,
    Person,
    ReorganizationTransaction,
    section_355_disapplied_355fgh,
};

pub entity ReorganizationExchange { label en unofficial "a holder's exchange of stock or securities in a corporation a party to a reorganization, in pursuance of the plan of reorganization"; }

@source(IRC_S354_A, quote = "stock or securities in a corporation a party to a reorganization are, in pursuance of the plan of reorganization, exchanged solely for stock or securities in such corporation or in another corporation a party to the reorganization.")
pub relation exchange_solely_for_stock_or_securities_354(x: ReorganizationExchange, holder: Person, target_corp: Corporation, received_corp: Corporation) kind empirical {
    label en official "the holder's stock or securities in a corporation a party to a reorganization are, in pursuance of the plan, exchanged solely for stock or securities in that corporation or another corporation a party to the reorganization — section 354(a)(1)";
}
pub relation exchange_in_pursuance_of_reorganization_plan(x: ReorganizationExchange, r: ReorganizationTransaction) kind empirical {
    label en unofficial "the exchange is made in pursuance of the plan of the named reorganization, linking a ReorganizationExchange to module 10's ReorganizationTransaction";
}
@source(IRC_S354_A, quote = "the principal amount of any such securities received exceeds the principal amount of any such securities surrendered, or")
pub relation securities_received_exceed_surrendered_354(x: ReorganizationExchange) kind empirical {
    label en official "section 354(a)(2)(A)(i): the principal amount of securities received exceeds the principal amount of securities surrendered";
}
@source(IRC_S354_A, quote = "any such securities are received and no such securities are surrendered.")
pub relation securities_received_none_surrendered_354(x: ReorganizationExchange) kind empirical {
    label en official "section 354(a)(2)(A)(ii): securities are received and none are surrendered";
}
pub relation section_354a2a_limitation_applies(x: ReorganizationExchange) kind institutional {
    label en official "section 354(a)(2)(A): the excess-principal-amount limitation applies, so section 354(a)(1) nonrecognition does not apply to the exchange";
}
@source(IRC_S354_A, quote = "Paragraph (1) shall not apply if—")
rule Section354a2aFromExcessRule(x: ReorganizationExchange) strict {
    label en official "section 354(a)(2)(A)(i): excess principal amount of securities received blocks nonrecognition";
    when securities_received_exceed_surrendered_354(x);
    then section_354a2a_limitation_applies(x);
}
@source(IRC_S354_A, quote = "Paragraph (1) shall not apply if—")
rule Section354a2aFromNoneSurrenderedRule(x: ReorganizationExchange) strict {
    label en official "section 354(a)(2)(A)(ii): securities received with none surrendered blocks nonrecognition";
    when securities_received_none_surrendered_354(x);
    then section_354a2a_limitation_applies(x);
}

// Section 354(b): the exception for type D/G reorganizations — nonrecognition
// under (a) does NOT apply to a type D/G exchange UNLESS the transferee
// acquires substantially all of the transferor's assets AND the transferor
// distributes everything it received (plus its other properties) under the
// plan.
@source(IRC_S354_B, quote = "the corporation to which the assets are transferred acquires substantially all of the assets of the transferor of such assets; and")
pub relation type_dg_transferee_acquires_substantially_all(x: ReorganizationExchange) kind empirical {
    label en official "section 354(b)(1)(A): in a type D/G reorganization, the transferee acquires substantially all of the transferor's assets";
}
@source(IRC_S354_B, quote = "the stock, securities, and other properties received by such transferor, as well as the other properties of such transferor, are distributed in pursuance of the plan of reorganization.")
pub relation type_dg_transferor_distributes_everything(x: ReorganizationExchange) kind empirical {
    label en official "section 354(b)(1)(B): in a type D/G reorganization, the transferor distributes the stock, securities, and other properties received, as well as its other properties, under the plan";
}
pub relation section_354b_exception_satisfied(x: ReorganizationExchange) kind institutional {
    label en official "section 354(b)(1): the type D/G exception's own conditions are satisfied, so section 354(a) nonrecognition is NOT barred by section 354(b)";
}
@source(IRC_S354_B, quote = "Subsection (a) shall not apply to an exchange in pursuance of a plan of reorganization within the meaning of subparagraph (D) or (G) of section 368(a)(1), unless—")
rule Section354bExceptionSatisfiedRule(x: ReorganizationExchange) strict {
    label en official "section 354(b)(1): the type D/G conditions (substantially-all acquisition and full distribution) are both met";
    when type_dg_transferee_acquires_substantially_all(x);
    when type_dg_transferor_distributes_everything(x);
    then section_354b_exception_satisfied(x);
}
pub relation exchange_is_type_d_or_g(x: ReorganizationExchange, r: ReorganizationTransaction) kind empirical {
    label en unofficial "the exchange is in pursuance of a plan of reorganization within the meaning of section 368(a)(1)(D) or (G) — triggers the section 354(b) exception";
}
pub relation exchange_is_type_d_or_g_exists(x: ReorganizationExchange) kind institutional {
    label en unofficial "witness: the exchange is a type D or G exchange for SOME reorganization (projection helper for the not_known guard, LDC-E0207)";
}
rule ExchangeIsTypeDOrGExistsRule(x: ReorganizationExchange, r: ReorganizationTransaction) strict {
    label en unofficial "projection helper";
    when exchange_is_type_d_or_g(x, r);
    then exchange_is_type_d_or_g_exists(x);
}

pub relation no_gain_or_loss_recognized_354(x: ReorganizationExchange, holder: Person) kind institutional {
    label en official "section 354(a)(1): no gain or loss is recognized to the holder on the exchange of stock or securities in a reorganization";
}
@source(IRC_S354_A, quote = "No gain or loss shall be recognized if stock or securities in a corporation a party to a reorganization are, in pursuance of the plan of reorganization, exchanged solely for stock or securities in such corporation or in another corporation a party to the reorganization.")
rule Section354NonrecognitionOrdinaryRule(x: ReorganizationExchange, holder: Person, target_corp: Corporation, received_corp: Corporation) defeasible {
    label en official "section 354(a)(1): nonrecognition on a solely-stock-or-securities exchange, not a type D/G exchange, and not blocked by the (a)(2)(A) limitation";
    when exchange_solely_for_stock_or_securities_354(x, holder, target_corp, received_corp);
    when not_known(exchange_is_type_d_or_g_exists(x));
    when not_known(section_354a2a_limitation_applies(x));
    then no_gain_or_loss_recognized_354(x, holder);
}
@source(IRC_S354_B, quote = "Subsection (a) shall not apply to an exchange in pursuance of a plan of reorganization within the meaning of subparagraph (D) or (G) of section 368(a)(1), unless—")
rule Section354NonrecognitionTypeDgRule(x: ReorganizationExchange, holder: Person, target_corp: Corporation, received_corp: Corporation, r: ReorganizationTransaction) defeasible {
    label en official "section 354(a)(1) as limited by 354(b): nonrecognition on a type D/G exchange only when the 354(b)(1) conditions are met, and not blocked by the (a)(2)(A) limitation";
    when exchange_solely_for_stock_or_securities_354(x, holder, target_corp, received_corp);
    when exchange_is_type_d_or_g(x, r);
    when section_354b_exception_satisfied(x);
    when not_known(section_354a2a_limitation_applies(x));
    then no_gain_or_loss_recognized_354(x, holder);
}

// --- Section 355: distributions of stock of a controlled corporation ------

pub entity ControlledCorporationDistribution { label en unofficial "a distribution by a distributing corporation of stock or securities of a corporation it controls, to a shareholder or security holder"; }

@source(IRC_S355_A, quote = "distributes to a shareholder, with respect to its stock, or")
pub relation distributes_solely_stock_or_securities_of_controlled(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation, holder: Person) kind empirical {
    label en official "the distributing corporation distributes to a shareholder (with respect to its stock) or security holder (in exchange for securities) solely stock or securities of the controlled corporation — section 355(a)(1)(A)";
}
pub relation controls_before_distribution_355(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation) kind empirical {
    label en unofficial "the distributing corporation controls (section 368(c)) the controlled corporation immediately before the distribution — section 355(a)(1)(A)";
}

// (a)(1)(B): not a device for distributing E&P — DECISION-0194 evaluative
// channel; the statute's own parenthetical (post-distribution sale is not
// itself conclusive) is a negative inference, not an additional test this
// package computes.
external judgment relation distribution_not_principally_a_device(cd: ControlledCorporationDistribution) {
    authority Secretary;
    label en official "section 355(a)(1)(B): the transaction was not used principally as a device for the distribution of the earnings and profits of the distributing corporation, the controlled corporation, or both";
}

// (b): active trade or business, both sides
@source(IRC_S355_B, quote = "the distributing corporation, and the controlled corporation (or, if stock of more than one controlled corporation is distributed, each of such corporations), is engaged immediately after the distribution in the active conduct of a trade or business, or")
pub relation engaged_in_active_conduct_of_trade_or_business(cd: ControlledCorporationDistribution, corp: Corporation) kind empirical {
    label en unofficial "the corporation is engaged, immediately after the distribution, in the active conduct of a trade or business — section 355(b)(1)(A)/(b)(2)(A)";
}
@source(IRC_S355_B, quote = "such trade or business has been actively conducted throughout the 5-year period ending on the date of the distribution,")
pub relation trade_or_business_active_for_5_years(cd: ControlledCorporationDistribution, corp: Corporation) kind empirical {
    label en official "section 355(b)(2)(B): the trade or business has been actively conducted throughout the 5-year period ending on the date of the distribution";
}
@source(IRC_S355_B, quote = "such trade or business was not acquired within the period described in subparagraph (B) in a transaction in which gain or loss was recognized in whole or in part,")
pub relation trade_or_business_not_taxably_acquired_in_5_years(cd: ControlledCorporationDistribution, corp: Corporation) kind empirical {
    label en official "section 355(b)(2)(C): the trade or business was not acquired within the 5-year period in a transaction in which gain or loss was recognized";
}
pub relation control_acquisition_355b2d_satisfied(cd: ControlledCorporationDistribution, corp: Corporation) kind empirical {
    label en official "section 355(b)(2)(D): the control-acquisition test — control of the corporation conducting the trade or business was not acquired within the 5-year period by any distributee corporation (or the distributing corporation), or was so acquired only by reason of transactions in which gain or loss was not recognized — read as ONE composite case fact (TECH_GAP: the (i)/(ii) branches, the affiliated-group aggregation rule, and the (b)(3) separate-affiliated-group special rules are not separately decomposed this stage, the same judgment-call shape as this package's own section 302(e)(2) safe harbor)";
}
pub relation active_trade_or_business_355b2(cd: ControlledCorporationDistribution, corp: Corporation) kind institutional {
    label en official "section 355(b)(2): the corporation is treated as engaged in the active conduct of a trade or business for section 355(b)(1) purposes";
}
@source(IRC_S355_B, quote = "a corporation shall be treated as engaged in the active conduct of a trade or business if and only if—")
rule ActiveTradeOrBusiness355b2Rule(cd: ControlledCorporationDistribution, corp: Corporation) strict {
    label en official "section 355(b)(2): all four (A)-(D) sub-tests together make a corporation \"engaged in the active conduct of a trade or business\"";
    when engaged_in_active_conduct_of_trade_or_business(cd, corp);
    when trade_or_business_active_for_5_years(cd, corp);
    when trade_or_business_not_taxably_acquired_in_5_years(cd, corp);
    when control_acquisition_355b2d_satisfied(cd, corp);
    then active_trade_or_business_355b2(cd, corp);
}
pub relation active_business_requirement_satisfied_355b(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation) kind institutional {
    label en official "section 355(b)(1)(A): both the distributing and the controlled corporation are engaged, immediately after the distribution, in the active conduct of a trade or business";
}
@source(IRC_S355_B, quote = "the distributing corporation, and the controlled corporation (or, if stock of more than one controlled corporation is distributed, each of such corporations), is engaged immediately after the distribution in the active conduct of a trade or business, or")
rule ActiveBusinessRequirementBothSidesRule(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation) strict {
    label en official "section 355(b)(1)(A): the active-business requirement, both-sides branch";
    when active_trade_or_business_355b2(cd, distributing);
    when active_trade_or_business_355b2(cd, controlled);
    then active_business_requirement_satisfied_355b(cd, distributing, controlled);
}

// (a)(1)(D): distribute all stock/securities, or a controlling amount with
// the Secretary satisfied that retention was not tax-motivated — modelled
// as a power (E-0239: an invalid exercise has no effect) since the
// "established to the satisfaction of the Secretary" branch changes the
// legal consequence of a partial retention.
@source(IRC_S355_A, quote = "all of the stock and securities in the controlled corporation held by it immediately before the distribution, or")
pub relation distributes_all_controlled_stock_and_securities(cd: ControlledCorporationDistribution) kind empirical {
    label en official "section 355(a)(1)(D)(i): the distributing corporation distributes all of the stock and securities in the controlled corporation it held immediately before the distribution";
}
@source(IRC_S355_A, quote = "an amount of stock in the controlled corporation constituting control within the meaning of section 368(c), and it is established to the satisfaction of the Secretary that the retention by the distributing corporation of stock (or stock and securities) in the controlled corporation was not in pursuance of a plan having as one of its principal purposes the avoidance of Federal income tax,")
pub relation distributes_control_amount_of_stock(cd: ControlledCorporationDistribution) kind empirical {
    label en official "section 355(a)(1)(D)(ii): the distributing corporation distributes an amount of controlled-corporation stock constituting section 368(c) control, retaining the rest";
}
external judgment relation retention_not_tax_avoidance_motivated(cd: ControlledCorporationDistribution) {
    authority Secretary;
    label en official "section 355(a)(1)(D)(ii): it is established to the satisfaction of the Secretary that the distributing corporation's retention of controlled-corporation stock was not in pursuance of a tax-avoidance plan";
}
pub relation distribution_satisfies_355a1d(cd: ControlledCorporationDistribution) kind institutional {
    label en official "section 355(a)(1)(D): the distribution meets the all-stock-or-control-amount requirement";
}
@source(IRC_S355_A, quote = "all of the stock and securities in the controlled corporation held by it immediately before the distribution, or")
rule Distribution355a1dAllStockRule(cd: ControlledCorporationDistribution) strict {
    label en official "section 355(a)(1)(D)(i): distributing all controlled stock and securities satisfies the requirement outright";
    when distributes_all_controlled_stock_and_securities(cd);
    then distribution_satisfies_355a1d(cd);
}
@source(IRC_S355_A, quote = "it is established to the satisfaction of the Secretary that the retention by the distributing corporation of stock (or stock and securities) in the controlled corporation was not in pursuance of a plan having as one of its principal purposes the avoidance of Federal income tax,")
rule Distribution355a1dControlAmountRule(cd: ControlledCorporationDistribution) strict {
    label en official "section 355(a)(1)(D)(ii): distributing a control amount, with the Secretary satisfied about the retention, satisfies the requirement";
    when distributes_control_amount_of_stock(cd);
    when retention_not_tax_avoidance_motivated(cd);
    then distribution_satisfies_355a1d(cd);
}

pub relation section_355_nonrecognition(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation, holder: Person) kind institutional {
    label en official "section 355(a)(1): no gain or loss is recognized to (and no amount is includible in the income of) the shareholder or security holder on the receipt of the controlled corporation's stock or securities";
}
@source(IRC_S355_A, quote = "then no gain or loss shall be recognized to (and no amount shall be includible in the income of) such shareholder or security holder on the receipt of such stock or securities.")
rule Section355NonrecognitionRule(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation, holder: Person) defeasible {
    label en official "section 355(a)(1): the four cumulative requirements ((A) control-before-and-solely-stock, (B) not a device, (C) active business, (D) all-or-control-amount distribution) together give nonrecognition";
    when distributes_solely_stock_or_securities_of_controlled(cd, distributing, controlled, holder);
    when controls_before_distribution_355(cd, distributing, controlled);
    when distribution_not_principally_a_device(cd);
    when active_business_requirement_satisfied_355b(cd, distributing, controlled);
    when distribution_satisfies_355a1d(cd);
    when not_known(section_355_disapplied_355fgh(cd));
    then section_355_nonrecognition(cd, distributing, controlled, holder);
}

// (d): disqualified distribution — 50-percent-or-greater disqualified-stock
// test. The "disqualified stock"/"purchase" tracing machinery (paragraphs
// (3), (5)-(9)) is TECH_GAP; the 50-percent numeric test itself is
// executable over a case-asserted disqualified-stock share.
pub relation disqualified_stock_share_in_distributing(cd: ControlledCorporationDistribution, share: Decimal) kind empirical {
    label en official "section 355(d)(3): the share of disqualified stock (acquired by purchase within the 5-year period, section 355(d)(3)(A)) held in the distributing corporation immediately after the distribution — TECH_GAP: the underlying \"purchase\"/attribution tracing (paragraphs (5)-(9)) is not decomposed, read as a case-asserted aggregate";
}
pub relation disqualified_stock_share_in_controlled(cd: ControlledCorporationDistribution, share: Decimal) kind empirical {
    label en official "section 355(d)(3)(B): the share of disqualified stock held in the controlled corporation immediately after the distribution (same TECH_GAP as the distributing-corporation share)";
}
pub relation disqualified_distribution_355d(cd: ControlledCorporationDistribution) kind institutional {
    label en official "section 355(d)(2): the distribution is a \"disqualified distribution\" — immediately after it, some person holds a 50-percent-or-greater disqualified-stock interest in the distributing or a controlled corporation";
}
@source(IRC_S355_D, quote = "any person holds disqualified stock in the distributing corporation which constitutes a 50-percent or greater interest in such corporation, or")
rule DisqualifiedDistribution355dFromDistributingRule(cd: ControlledCorporationDistribution, share: Decimal) strict {
    label en official "section 355(d)(2)(A): a 50-percent-or-greater disqualified-stock interest in the distributing corporation makes the distribution disqualified";
    when disqualified_stock_share_in_distributing(cd, share);
    when share >= 0.50;
    then disqualified_distribution_355d(cd);
}
@source(IRC_S355_D, quote = "any person holds disqualified stock in the controlled corporation (or, if stock of more than 1 controlled corporation is distributed, in any controlled corporation) which constitutes a 50-percent or greater interest in such corporation.")
rule DisqualifiedDistribution355dFromControlledRule(cd: ControlledCorporationDistribution, share: Decimal) strict {
    label en official "section 355(d)(2)(B): a 50-percent-or-greater disqualified-stock interest in the controlled corporation makes the distribution disqualified";
    when disqualified_stock_share_in_controlled(cd, share);
    when share >= 0.50;
    then disqualified_distribution_355d(cd);
}
pub relation controlled_stock_not_qualified_property_355d(cd: ControlledCorporationDistribution) kind institutional {
    label en official "section 355(d)(1): in the case of a disqualified distribution, stock or securities in the controlled corporation are not treated as qualified property for purposes of section 355(c)(2) or section 361(c)(2)";
}
@source(IRC_S355_D, quote = "In the case of a disqualified distribution, any stock or securities in the controlled corporation shall not be treated as qualified property for purposes of subsection (c)(2) of this section or section 361(c)(2).")
rule ControlledStockNotQualifiedProperty355dRule(cd: ControlledCorporationDistribution) strict {
    label en official "section 355(d)(1): disqualified-distribution stock is not qualified property";
    when disqualified_distribution_355d(cd);
    then controlled_stock_not_qualified_property_355d(cd);
}

// (e): recognition of gain on distributions in connection with acquisitions —
// exact date arithmetic: the plan is PRESUMED under (e)(2)(B) if a 50%-or-
// greater acquisition occurs within the 4-year window from 2 years before
// to 2 years after the distribution date.
pub relation distribution_date_355(cd: ControlledCorporationDistribution, on: Date) kind empirical {
    label en unofficial "the date of the section 355 distribution, for the section 355(e)(2)(B) 4-year presumption window";
}
pub relation acquisition_of_50_percent_or_greater_interest(cd: ControlledCorporationDistribution, acquired_on: Date) kind empirical {
    label en official "section 355(e)(2)(A)(ii)/(4)(A): one or more persons acquire, directly or indirectly, stock representing a 50-percent-or-greater interest in the distributing corporation or a controlled corporation, on the given date";
}
pub relation acquisition_within_355e_presumption_window(cd: ControlledCorporationDistribution, acquired_on: Date, distribution_on: Date) kind institutional {
    label en official "section 355(e)(2)(B): the 50-percent-or-greater acquisition occurred within the 4-year period beginning 2 years before the date of the distribution and ending 2 years after — the plan is presumed";
}
@source(IRC_S355_E, quote = "If 1 or more persons acquire directly or indirectly stock representing a 50-percent or greater interest in the distributing corporation or any controlled corporation during the 4-year period beginning on the date which is 2 years before the date of the distribution, such acquisition shall be treated as pursuant to a plan described in subparagraph (A)(ii) unless it is established that the distribution and the acquisition are not pursuant to a plan or series of related transactions.")
rule AcquisitionWithin355ePresumptionWindowRule(cd: ControlledCorporationDistribution, acquired_on: Date, distribution_on: Date, calendar_before_1: Date) strict {
    label en official "section 355(e)(2)(B): exact date test for the 4-year presumption window (2 years before to 2 years after the distribution)";
    when acquisition_of_50_percent_or_greater_interest(cd, acquired_on);
    when distribution_date_355(cd, distribution_on);
    when acquired_on >= calendar_before_1;
    when acquired_on <= add_calendar_period(distribution_on, 2 calendar_year)
        and us.irc.core::civil_calendar_boundary_before(distribution_on, 2, us.irc.core::CalendarYear, calendar_before_1);
    then acquisition_within_355e_presumption_window(cd, acquired_on, distribution_on);
}
external judgment relation acquisition_established_unrelated_to_plan(cd: ControlledCorporationDistribution) {
    authority Secretary;
    label en official "section 355(e)(2)(B): it is established that the distribution and the acquisition are not pursuant to a plan or series of related transactions, rebutting the 4-year presumption";
}
pub relation distribution_part_of_355e_plan(cd: ControlledCorporationDistribution) kind institutional {
    label en official "section 355(e)(2)(A): the distribution is part of a plan (or series of related transactions) under which one or more persons acquire a 50-percent-or-greater interest — section 355(e) applies";
}
@source(IRC_S355_E, quote = "such acquisition shall be treated as pursuant to a plan described in subparagraph (A)(ii) unless it is established that the distribution and the acquisition are not pursuant to a plan or series of related transactions.")
rule DistributionPart355ePlanPresumedRule(cd: ControlledCorporationDistribution, acquired_on: Date, distribution_on: Date) defeasible {
    label en official "section 355(e)(2)(B): the 4-year-window acquisition is presumed part of a plan unless the taxpayer rebuts the presumption";
    when acquisition_within_355e_presumption_window(cd, acquired_on, distribution_on);
    when not_known(acquisition_established_unrelated_to_plan(cd));
    then distribution_part_of_355e_plan(cd);
}
pub relation controlled_stock_not_qualified_property_355e(cd: ControlledCorporationDistribution) kind institutional {
    label en official "section 355(e)(1): stock or securities in the controlled corporation are not treated as qualified property for purposes of section 355(c)(2) or section 361(c)(2), where the distribution is part of a section 355(e) plan";
}
@source(IRC_S355_E, quote = "If there is a distribution to which this subsection applies, any stock or securities in the controlled corporation shall not be treated as qualified property for purposes of subsection (c)(2) of this section or section 361(c)(2).")
rule ControlledStockNotQualifiedProperty355eRule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 355(e)(1): a distribution part of a section 355(e) plan loses qualified-property treatment for the controlled stock, unless section 355(d) already governs (355(e)(2)(D) coordination)";
    when distribution_part_of_355e_plan(cd);
    when not_known(disqualified_distribution_355d(cd));
    then controlled_stock_not_qualified_property_355e(cd);
}

// --- Section 356: receipt of additional consideration (boot) --------------

pub relation would_qualify_under_354_or_355_but_for_other_property(x: ReorganizationExchange, holder: Person) kind empirical {
    label en official "section 356(a)(1)(A): section 354 or 355 would apply to the exchange but for the receipt of other property or money in addition to the permitted stock/securities";
}
pub relation money_or_other_property_received_356(x: ReorganizationExchange, amount: Money, fmv_of_other_property: Money) kind empirical {
    label en official "section 356(a)(1)(B): the money and the fair market value of the other (non-permitted) property received in the exchange";
}
pub relation realized_gain_on_exchange_356(x: ReorganizationExchange, holder: Person, amount: Money) kind empirical {
    label en unofficial "the gain, if any, realized by the holder on the exchange (before the section 356(a)(1) recognition ceiling) — the general gain-realization computation this package does not itself own (contract to gross-income/property-transactions)";
}
pub relation boot_recognized_gain_356a(x: ReorganizationExchange, holder: Person, amount: Money) kind institutional {
    label en official "section 356(a)(1): the gain recognized to the holder, not in excess of the sum of the money and the fair market value of the other property received";
}
@source(IRC_S356_A, quote = "then the gain, if any, to the recipient shall be recognized, but in an amount not in excess of the sum of such money and the fair market value of such other property.")
rule BootRecognizedGainRule(x: ReorganizationExchange, holder: Person, realized: Money, money: Money, fmv: Money) strict {
    label en official "section 356(a)(1): recognized gain is the lesser of realized gain and the boot received (money plus fair market value of other property)";
    when would_qualify_under_354_or_355_but_for_other_property(x, holder);
    when realized_gain_on_exchange_356(x, holder, realized);
    when money_or_other_property_received_356(x, money, fmv);
    when realized <= money + fmv;
    then boot_recognized_gain_356a(x, holder, realized);
}
@source(IRC_S356_A, quote = "then the gain, if any, to the recipient shall be recognized, but in an amount not in excess of the sum of such money and the fair market value of such other property.")
rule BootRecognizedGainCappedRule(x: ReorganizationExchange, holder: Person, realized: Money, money: Money, fmv: Money) strict {
    label en official "section 356(a)(1): recognized gain capped at the boot received where realized gain exceeds it";
    when would_qualify_under_354_or_355_but_for_other_property(x, holder);
    when realized_gain_on_exchange_356(x, holder, realized);
    when money_or_other_property_received_356(x, money, fmv);
    when realized > money + fmv;
    then boot_recognized_gain_356a(x, holder, money + fmv);
}

// (a)(2): dividend treatment — the recognized gain is a dividend to the
// extent of the distributee's ratable share of undistributed E&P
// accumulated after February 28, 1913 (section 316(a)'s own accumulated-E&P
// concept, read here as a case-level ratable share rather than re-derived
// from module 02's aggregate, since section 356(a)(2)'s "ratable share" is
// itself a distinct allocation this package does not further decompose).
pub relation exchange_has_effect_of_dividend_356a2(x: ReorganizationExchange, holder: Person) kind empirical {
    label en official "section 356(a)(2): the exchange, determined with the application of section 318(a) attribution, has the effect of the distribution of a dividend";
}
pub relation ratable_share_of_undistributed_ep_356a2(x: ReorganizationExchange, holder: Person, amount: Money) kind empirical {
    label en official "section 356(a)(2): the distributee's ratable share of the corporation's undistributed earnings and profits accumulated after February 28, 1913";
}
pub relation boot_treated_as_dividend_356a2(x: ReorganizationExchange, holder: Person, amount: Money) kind institutional {
    label en official "section 356(a)(2): the portion of the section 356(a)(1) recognized gain treated as a dividend — the lesser of the recognized gain and the ratable share of undistributed E&P";
}
@source(IRC_S356_A, quote = "then there shall be treated as a dividend to each distributee such an amount of the gain recognized under paragraph (1) as is not in excess of his ratable share of the undistributed earnings and profits of the corporation accumulated after February 28, 1913.")
rule BootDividendTreatmentBelowEpRule(x: ReorganizationExchange, holder: Person, gain: Money, ep_share: Money) strict {
    label en official "section 356(a)(2): recognized gain not exceeding the E&P share is entirely a dividend";
    when exchange_has_effect_of_dividend_356a2(x, holder);
    when boot_recognized_gain_356a(x, holder, gain);
    when ratable_share_of_undistributed_ep_356a2(x, holder, ep_share);
    when gain <= ep_share;
    then boot_treated_as_dividend_356a2(x, holder, gain);
}
@source(IRC_S356_A, quote = "then there shall be treated as a dividend to each distributee such an amount of the gain recognized under paragraph (1) as is not in excess of his ratable share of the undistributed earnings and profits of the corporation accumulated after February 28, 1913.")
rule BootDividendTreatmentCappedAtEpRule(x: ReorganizationExchange, holder: Person, gain: Money, ep_share: Money) strict {
    label en official "section 356(a)(2): the dividend portion is capped at the E&P share when recognized gain exceeds it";
    when exchange_has_effect_of_dividend_356a2(x, holder);
    when boot_recognized_gain_356a(x, holder, gain);
    when ratable_share_of_undistributed_ep_356a2(x, holder, ep_share);
    when gain > ep_share;
    then boot_treated_as_dividend_356a2(x, holder, ep_share);
}
pub relation boot_treated_as_exchange_gain_356a2(x: ReorganizationExchange, holder: Person, amount: Money) kind institutional {
    label en official "section 356(a)(2) last sentence: the remainder, if any, of the section 356(a)(1) recognized gain not treated as a dividend, is treated as gain from the exchange of property";
}
@source(IRC_S356_A, quote = "The remainder, if any, of the gain recognized under paragraph (1) shall be treated as gain from the exchange of property.")
rule BootExchangeGainRemainderRule(x: ReorganizationExchange, holder: Person, gain: Money, dividend: Money) strict {
    label en official "section 356(a)(2) last sentence: the non-dividend remainder of recognized gain is capital-transaction gain";
    when boot_recognized_gain_356a(x, holder, gain);
    when boot_treated_as_dividend_356a2(x, holder, dividend);
    then boot_treated_as_exchange_gain_356a2(x, holder, gain - dividend);
}

// (b): additional consideration in certain section 355 distributions —
// treated as a section 301 distribution (bridges to module 02's section 301
// three-tier machinery).
pub relation would_qualify_under_355_but_for_other_property(cd: ControlledCorporationDistribution) kind empirical {
    label en official "section 356(b)(1): section 355 would apply to the distribution but for the receipt of other property or money in addition to the permitted stock/securities";
}
pub relation money_or_other_property_received_356b(cd: ControlledCorporationDistribution, amount: Money, fmv_of_other_property: Money) kind empirical {
    label en official "section 356(b)(2): the money and the fair market value of the other property received in the distribution";
}
pub relation additional_consideration_treated_as_301_distribution(cd: ControlledCorporationDistribution, amount: Money) kind institutional {
    label en official "section 356(b): an amount equal to the money plus the fair market value of the other property is treated as a distribution of property to which section 301 applies";
}
@source(IRC_S356_B, quote = "then an amount equal to the sum of such money and the fair market value of such other property shall be treated as a distribution of property to which section 301 applies.")
rule AdditionalConsiderationAs301DistributionRule(cd: ControlledCorporationDistribution, money: Money, fmv: Money) strict {
    label en official "section 356(b): additional consideration in a section 355 distribution is treated as a section 301 distribution";
    when would_qualify_under_355_but_for_other_property(cd);
    when money_or_other_property_received_356b(cd, money, fmv);
    then additional_consideration_treated_as_301_distribution(cd, money + fmv);
}

// NOT DONE this stage (TECH_GAP/EXTERNAL_DEPENDENCY, see coverage rows):
// section 354(a)(2)(B)-(C) (accrued-interest carve-out, nonqualified-
// preferred-stock reclassification, and the family-owned-corporation
// recapitalization exception with its own 8-year lookback and extended
// limitations period), section 354(c) (railroad reorganizations), section
// 355(a)(2)-(3) (non-pro-rata/no-surrender/not-a-plan-of-reorganization
// clarifications, the excess-principal-amount and 5-year-taxable-
// acquisition-as-boot limitations, accrued-interest and nonqualified-
// preferred-stock carve-outs), section 355(b)(3) (separate-affiliated-group
// special rules), section 355(c) (corporate-level gain/loss on the
// distribution itself — a distinct provision from 355(a), not reached this
// stage), section 355(f)-(h) (further special rules and the (g) disqualified
// investment company / (h) qualified real estate investment trust
// treatment).
