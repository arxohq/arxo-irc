// Sections 303 (redemptions to pay death taxes), 304 (redemptions through
// related corporations), 306 (disposition of section 306 stock), and 307
// (basis of stock rights). Stage 2 (IRC-08 stage 2, A06), priority sections.
// Reuses module 04's `Redemption` entity and module 05's `control_368c`-
// style facts are NOT reused here: section 304(c) defines its own,
// DIFFERENT 50 percent (not 80 percent) "control" test — a distinct
// relation, not an alias, since the threshold differs (matching this
// package's own precedent of `constructive_ownership_1563` being distinct
// from module 03's `constructive_ownership`, module 08 header).
//
// METHOD: section 303(a)'s exchange-treatment ceiling (the sum of death
// taxes and section 2053/2106 funeral/administration expenses) as an exact
// calculation; section 303(b)(1)'s TIMING window is a CONTRACT to
// `estate-gift` (section 6501(a) limitations, section 6213 Tax Court
// proceedings, section 6166 installment elections) — per the task's own
// framing ("contract to estate-gift for the adjusted gross estate"), NOT
// imported (the owner's task explicitly declines importing `estate-gift`
// for section 303 stage 1; this stage keeps that same EXTERNAL_DEPENDENCY
// posture rather than reversing it without instruction), so it is read as
// a case-asserted window-membership fact; section 303(b)(2)(A)'s 35 percent
// test IS computed exactly from case-supplied estate-tax-return figures
// (the values themselves come from `estate-gift`, not re-derived); section
// 303(b)(3)-(4) as executable comparisons over case facts. Section 304(a)(1)-
// (2)'s two acquisition types are classified, and (b)(2)'s two-tier E&P
// dividend computation (acquiring corporation first, then issuing
// corporation) is modelled as an exact calculation with BOTH intermediate
// values, per the task's explicit instruction. Section 304(c)(1)'s 50
// percent control test (including the chain-control second sentence) is
// executable; (c)(2)-(3)'s constructive-ownership-modification and stock-
// acquired-in-the-transaction machinery is TECH_GAP (layering a modified
// section 318(a) on top of module 03's `constructive_ownership`, the same
// bounded-hop class as G37/G61/G63). Section 306(a)(1)-(2) and (c)(1) are
// executable (ordinary income up to the section 301(a)-style ceiling, gain
// on the excess, no loss, redemption treated as section 301); the (b)
// exceptions are classified, with (b)(1) EXACT and (b)(4) EVALUATIVE.
// Section 307(a) is an allocation rule (regulations prescribed by the
// Secretary — EXTERNAL_DEPENDENCY on the allocation METHOD, matching
// section 312(h)'s posture) and 307(b) the 15 percent safe-harbor/zero-
// basis default with the election as a POWER (irrevocable once made, filed
// by the section 6081-extended return deadline).

// --- Section 303: redemptions to pay death taxes ---------------------------

use self::{
    Asset,
    Corporation,
    DistributionEvent,
    IRC_S303_A,
    IRC_S303_B,
    IRC_S304_A,
    IRC_S304_B,
    IRC_S304_C,
    IRC_S306_A,
    IRC_S306_B,
    IRC_S306_C,
    IRC_S307_B,
    Person,
    Redemption,
    redemption,
    section_306_taint_removed_306e1,
};

@source(IRC_S303_A, quote = "A distribution of property to a shareholder by a corporation in redemption of part or all of the stock of such corporation which (for Federal estate tax purposes) is included in determining the gross estate of a decedent")
pub relation redeemed_stock_included_in_gross_estate(r: Redemption, decedent: Person) kind empirical {
    label en official "the redeemed stock is (for Federal estate tax purposes) included in determining the gross estate of a decedent — section 303(a)";
}
@source(IRC_S303_A, quote = "the estate, inheritance, legacy, and succession taxes (including any interest collected as a part of such taxes) imposed because of such decedent's death, and")
pub relation death_taxes_imposed_303a1(r: Redemption, amount: Money) kind empirical {
    label en official "section 303(a)(1): the estate, inheritance, legacy, and succession taxes (including interest collected as part of such taxes) imposed because of the decedent's death (EXTERNAL_DEPENDENCY: the tax figure itself is `estate-gift`'s own computation, read here as a case fact)";
}
@source(IRC_S303_A, quote = "the amount of funeral and administration expenses allowable as deductions to the estate under section 2053 (or under section 2106 in the case of the estate of a decedent nonresident, not a citizen of the United States),")
pub relation funeral_and_administration_expenses_303a2(r: Redemption, amount: Money) kind empirical {
    label en official "section 303(a)(2): funeral and administration expenses allowable as deductions to the estate under section 2053 or 2106 (EXTERNAL_DEPENDENCY: `estate-gift`'s own computation, read here as a case fact)";
}
pub relation section_303a_ceiling(r: Redemption, amount: Money) kind institutional {
    label en official "section 303(a): the ceiling on the amount of a redemption distribution treated as full payment in exchange for the stock — the sum of the section 303(a)(1) death taxes and the section 303(a)(2) funeral/administration expenses";
}
@source(IRC_S303_A, quote = "to the extent that the amount of such distribution does not exceed the sum of—")
rule Section303aCeilingRule(r: Redemption, taxes: Money, expenses: Money) strict {
    label en official "section 303(a): the exchange-treatment ceiling is death taxes plus funeral/administration expenses";
    when death_taxes_imposed_303a1(r, taxes);
    when funeral_and_administration_expenses_303a2(r, expenses);
    then section_303a_ceiling(r, taxes + expenses);
}

// Section 303(b)(1): the timing window — EXTERNAL_DEPENDENCY on
// `estate-gift`'s section 6501(a)/6213/6166 machinery; read as a
// case-asserted membership fact rather than imported (task instruction).
pub relation distribution_within_303b1_period(r: Redemption) kind empirical {
    label en official "section 303(b)(1): the distribution is made after the decedent's death and within the section 6501(a) estate-tax assessment period (or the 90-day/60-day/section 6166-installment extensions) — EXTERNAL_DEPENDENCY on `estate-gift`'s own limitations computation, read as a case fact per the task's instruction not to import that package here";
}

// Section 303(b)(2)(A): the 35 percent test — computed exactly from
// case-supplied estate-tax-return figures (the underlying VALUES are
// `estate-gift`'s, the ARITHMETIC is this package's).
pub relation stock_value_in_gross_estate_303b2(r: Redemption, amount: Money) kind empirical {
    label en official "section 303(b)(2)(A): the value (for Federal estate tax purposes) of all of the stock of the corporation included in determining the value of the decedent's gross estate (aggregated across two-or-more-corporations per (b)(2)(B) where applicable — read as one case-asserted figure, TECH_GAP for the (B) 20-percent aggregation sub-test)";
}
pub relation gross_estate_value_303b2(r: Redemption, amount: Money) kind empirical {
    label en unofficial "section 303(b)(2)(A)(i): the value of the decedent's gross estate";
}
pub relation section_2053_2054_deductions_303b2(r: Redemption, amount: Money) kind empirical {
    label en unofficial "section 303(b)(2)(A)(ii): the sum of the amounts allowable as a deduction under section 2053 or 2054";
}
pub relation section_303b2a_excess(r: Redemption, amount: Money) kind institutional {
    label en official "section 303(b)(2)(A): the excess of the gross estate value over the section 2053/2054 deductions, the denominator of the 35 percent test";
}
@source(IRC_S303_B, quote = "the value of the gross estate of such decedent, over")
rule Section303b2aExcessRule(r: Redemption, gross_estate: Money, deductions: Money) strict {
    label en official "section 303(b)(2)(A): computes the excess of gross estate value over section 2053/2054 deductions";
    when gross_estate_value_303b2(r, gross_estate);
    when section_2053_2054_deductions_303b2(r, deductions);
    then section_303b2a_excess(r, gross_estate - deductions);
}
pub relation section_303b2_relationship_satisfied(r: Redemption) kind institutional {
    label en official "section 303(b)(2)(A): the value of the includible stock exceeds 35 percent of the excess of the gross estate value over the section 2053/2054 deductions";
}
@source(IRC_S303_B, quote = "the value (for Federal estate tax purposes) of all of the stock of such corporation which is included in determining the value of the decedent's gross estate exceeds 35 percent of the excess of—")
rule Section303b2RelationshipSatisfiedRule(r: Redemption, stock_value: Money, excess: Money) strict {
    label en official "section 303(b)(2)(A): the exact 35 percent stock-to-estate relationship test";
    when stock_value_in_gross_estate_303b2(r, stock_value);
    when section_303b2a_excess(r, excess);
    when stock_value > round(excess * 0.35, 2, "HALF_UP");
    then section_303b2_relationship_satisfied(r);
}

// Section 303(b)(3): the shareholder's interest must be reduced (directly
// or through a binding contribution obligation) by the death-tax/expense
// payment.
@source(IRC_S303_B, quote = "Subsection (a) shall apply to a distribution by a corporation only to the extent that the interest of the shareholder is reduced directly (or through a binding obligation to contribute) by any payment of an amount described in paragraph (1) or (2) of subsection (a).")
pub relation shareholder_interest_reduced_by_payment_303b3(r: Redemption, amount: Money) kind empirical {
    label en official "section 303(b)(3): the extent to which the shareholder's interest is reduced (directly or through a binding contribution obligation) by payment of the death taxes/expenses — the CEILING for that shareholder's own section 303 treatment";
}

// Section 303(b)(4): distributions more than 4 years after death — the
// lesser-of test (exact date arithmetic for the 4-year boundary).
pub relation decedent_death_date_303(r: Redemption, death_on: Date) kind empirical {
    label en unofficial "the date of the decedent's death, for the section 303(b)(4) 4-year boundary";
}
pub relation redemption_distribution_date_303(r: Redemption, on: Date) kind empirical {
    label en unofficial "the date of the redemption distribution, for the section 303(b)(4) 4-year boundary";
}
pub relation distribution_more_than_4_years_after_death(r: Redemption) kind institutional {
    label en official "section 303(b)(4): the distribution is made more than 4 years after the date of the decedent's death, triggering the additional lesser-of limitation";
}
@source(IRC_S303_B, quote = "In the case of amounts distributed more than 4 years after the date of the decedent's death, subsection (a) shall apply to a distribution by a corporation only to the extent of the lesser of—")
rule DistributionMoreThan4YearsAfterDeathRule(r: Redemption, death_on: Date, on: Date) strict {
    label en official "section 303(b)(4): exact date test for the 4-year boundary";
    when decedent_death_date_303(r, death_on);
    when redemption_distribution_date_303(r, on);
    when on > add_calendar_period(death_on, 4 calendar_year);
    then distribution_more_than_4_years_after_death(r);
}
pub relation unpaid_303a_amount_immediately_before_distribution(r: Redemption, amount: Money) kind empirical {
    label en official "section 303(b)(4)(A): the aggregate of the section 303(a)(1)/(2) amounts which remained unpaid immediately before the distribution";
}
pub relation paid_303a_amount_within_1_year_after_distribution(r: Redemption, amount: Money) kind empirical {
    label en official "section 303(b)(4)(B): the aggregate of the section 303(a)(1)/(2) amounts paid during the 1-year period beginning on the date of the distribution";
}
pub relation section_303b4_ceiling(r: Redemption, amount: Money) kind institutional {
    label en official "section 303(b)(4): the additional ceiling for a more-than-4-years-after-death distribution — the lesser of the unpaid amount immediately before, and the amount paid within the following year";
}
@source(IRC_S303_B, quote = "the aggregate of the amounts referred to in paragraph (1) or (2) of subsection (a) which remained unpaid immediately before the distribution, or")
rule Section303b4CeilingUnpaidLesserRule(r: Redemption, unpaid: Money, paid: Money) strict {
    label en official "section 303(b)(4): the unpaid-before figure governs when it is the lesser";
    when distribution_more_than_4_years_after_death(r);
    when unpaid_303a_amount_immediately_before_distribution(r, unpaid);
    when paid_303a_amount_within_1_year_after_distribution(r, paid);
    when unpaid <= paid;
    then section_303b4_ceiling(r, unpaid);
}
@source(IRC_S303_B, quote = "the aggregate of the amounts referred to in paragraph (1) or (2) of subsection (a) which are paid during the 1-year period beginning on the date of such distribution.")
rule Section303b4CeilingPaidLesserRule(r: Redemption, unpaid: Money, paid: Money) strict {
    label en official "section 303(b)(4): the paid-within-1-year figure governs when it is the lesser";
    when distribution_more_than_4_years_after_death(r);
    when unpaid_303a_amount_immediately_before_distribution(r, unpaid);
    when paid_303a_amount_within_1_year_after_distribution(r, paid);
    when paid < unpaid;
    then section_303b4_ceiling(r, paid);
}

pub relation section_303_exchange_treatment(r: Redemption, shareholder: Person, amount: Money) kind institutional {
    label en official "section 303(a): the redemption distribution (up to the section 303(a) ceiling, as limited by section 303(b)) is treated as a distribution in full payment in exchange for the stock redeemed";
}
@source(IRC_S303_A, quote = "shall be treated as a distribution in full payment in exchange for the stock so redeemed.")
rule Section303ExchangeTreatmentRule(r: Redemption, shareholder: Person, decedent: Person, ceiling: Money, reduction: Money) defeasible {
    label en official "section 303(a)-(b): full-payment exchange treatment, up to the lesser of the section 303(a) ceiling and the section 303(b)(3) shareholder-interest-reduction cap, within the section 303(b)(1) period and meeting the section 303(b)(2) 35 percent relationship, and not more than 4 years after death";
    when redemption(r, _, shareholder, _);
    when redeemed_stock_included_in_gross_estate(r, decedent);
    when distribution_within_303b1_period(r);
    when section_303b2_relationship_satisfied(r);
    when section_303a_ceiling(r, ceiling);
    when shareholder_interest_reduced_by_payment_303b3(r, reduction);
    when not_known(distribution_more_than_4_years_after_death(r));
    when reduction <= ceiling;
    then section_303_exchange_treatment(r, shareholder, reduction);
}
@source(IRC_S303_A, quote = "shall be treated as a distribution in full payment in exchange for the stock so redeemed.")
rule Section303ExchangeTreatmentCeilingLowerRule(r: Redemption, shareholder: Person, decedent: Person, ceiling: Money, reduction: Money) defeasible {
    label en official "section 303(a)-(b): full-payment exchange treatment capped at the section 303(a) ceiling where it is lower than the section 303(b)(3) reduction";
    when redemption(r, _, shareholder, _);
    when redeemed_stock_included_in_gross_estate(r, decedent);
    when distribution_within_303b1_period(r);
    when section_303b2_relationship_satisfied(r);
    when section_303a_ceiling(r, ceiling);
    when shareholder_interest_reduced_by_payment_303b3(r, reduction);
    when not_known(distribution_more_than_4_years_after_death(r));
    when ceiling < reduction;
    then section_303_exchange_treatment(r, shareholder, ceiling);
}
@source(IRC_S303_B, quote = "In the case of amounts distributed more than 4 years after the date of the decedent's death, subsection (a) shall apply to a distribution by a corporation only to the extent of the lesser of—")
rule Section303ExchangeTreatmentAfter4YearsRule(r: Redemption, shareholder: Person, decedent: Person, cap_4y: Money, reduction: Money) defeasible {
    label en official "section 303(a) as limited by section 303(b)(4): full-payment exchange treatment for a more-than-4-years-after-death distribution, capped by the section 303(b)(4) lesser-of ceiling";
    when redemption(r, _, shareholder, _);
    when redeemed_stock_included_in_gross_estate(r, decedent);
    when distribution_within_303b1_period(r);
    when section_303b2_relationship_satisfied(r);
    when distribution_more_than_4_years_after_death(r);
    when section_303b4_ceiling(r, cap_4y);
    when shareholder_interest_reduced_by_payment_303b3(r, reduction);
    when cap_4y <= reduction;
    then section_303_exchange_treatment(r, shareholder, cap_4y);
}

// --- Section 304: redemptions through use of related corporations ---------

@source(IRC_S304_A, quote = "one or more persons are in control of each of two corporations, and")
pub relation same_persons_control_both_corporations_304a1(t: DistributionEvent, acquiring: Corporation, other: Corporation) kind empirical {
    label en unofficial "section 304(a)(1)(A): one or more persons are in control (section 304(c)) of each of the two (brother-sister) corporations";
}
@source(IRC_S304_A, quote = "in return for property, one of the corporations acquires stock in the other corporation from the person (or persons) so in control,")
pub relation acquiring_corp_buys_stock_of_other_304a1(t: DistributionEvent, acquiring: Corporation, other: Corporation, transferor: Person, property_amount: Money) kind empirical {
    label en official "section 304(a)(1)(B): in return for property, the acquiring corporation acquires stock in the other corporation from the person(s) in control of both — the brother-sister acquisition";
}
pub relation section_304a1_applies(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) kind institutional {
    label en official "section 304(a)(1): the property is treated as a distribution in redemption of the stock of the ACQUIRING corporation (unless section 304(a)(2), the subsidiary case, applies instead)";
}
@source(IRC_S304_A, quote = "then (unless paragraph (2) applies) such property shall be treated as a distribution in redemption of the stock of the corporation acquiring such stock.")
rule Section304a1AppliesRule(t: DistributionEvent, acquiring: Corporation, other: Corporation, transferor: Person, amount: Money) strict {
    label en official "section 304(a)(1): brother-sister stock purchase treated as a redemption of the acquiring corporation's own stock";
    when same_persons_control_both_corporations_304a1(t, acquiring, other);
    when acquiring_corp_buys_stock_of_other_304a1(t, acquiring, other, transferor, amount);
    when not_known(section_304a2_applies_exists(t));
    then section_304a1_applies(t, acquiring, other, transferor, amount);
}

@source(IRC_S304_A, quote = "in return for property, one corporation acquires from a shareholder of another corporation stock in such other corporation, and")
pub relation acquiring_corp_buys_stock_from_shareholder_304a2(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) kind empirical {
    label en official "section 304(a)(2)(A): in return for property, the acquiring corporation acquires stock of the issuing corporation from one of the issuing corporation's shareholders";
}
@source(IRC_S304_A, quote = "the issuing corporation controls the acquiring corporation,")
pub relation issuing_corp_controls_acquiring_304a2(t: DistributionEvent, issuing: Corporation, acquiring: Corporation) kind empirical {
    label en official "section 304(a)(2)(B): the issuing corporation controls (section 304(c)) the acquiring corporation — the parent-subsidiary acquisition";
}
pub relation section_304a2_applies(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) kind institutional {
    label en official "section 304(a)(2): the property is treated as a distribution in redemption of the stock of the ISSUING corporation";
}
@source(IRC_S304_A, quote = "then such property shall be treated as a distribution in redemption of the stock of the issuing corporation.")
rule Section304a2AppliesRule(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) strict {
    label en official "section 304(a)(2): subsidiary stock purchase treated as a redemption of the issuing (parent) corporation's own stock";
    when acquiring_corp_buys_stock_from_shareholder_304a2(t, acquiring, issuing, transferor, amount);
    when issuing_corp_controls_acquiring_304a2(t, issuing, acquiring);
    then section_304a2_applies(t, acquiring, issuing, transferor, amount);
}
pub relation section_304a2_applies_exists(t: DistributionEvent) kind institutional {
    label en unofficial "witness: section 304(a)(2) applies to the transaction for SOME (acquiring, issuing, transferor, amount) tuple (projection helper for the not_known guard, LDC-E0207)";
}
rule Section304a2AppliesExistsRule(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) strict {
    label en unofficial "projection helper";
    when section_304a2_applies(t, acquiring, issuing, transferor, amount);
    then section_304a2_applies_exists(t);
}

// Section 304(b)(2): the two-tier dividend computation — amount treated as a
// dividend first out of the ACQUIRING corporation's E&P, then out of the
// ISSUING corporation's E&P — an exact calculation with both intermediate
// values, per the task's explicit instruction.
pub relation acquiring_corp_ep_304b2(t: DistributionEvent, acquiring: Corporation, amount: Money) kind empirical {
    label en unofficial "the acquiring corporation's earnings and profits available for the section 304(b)(2)(A) first-tier dividend determination";
}
pub relation issuing_corp_ep_304b2(t: DistributionEvent, issuing: Corporation, amount: Money) kind empirical {
    label en unofficial "the issuing corporation's earnings and profits available for the section 304(b)(2)(B) second-tier dividend determination";
}
pub relation dividend_amount_from_acquiring_corp_304b2a(t: DistributionEvent, amount: Money) kind institutional {
    label en official "section 304(b)(2)(A): the amount treated as a dividend out of the acquiring corporation's earnings and profits — the lesser of the property received and the acquiring corporation's E&P";
}
pub relation property_received_304(t: DistributionEvent, amount: Money) kind empirical {
    label en unofficial "the amount of property received in the section 304(a) transaction (the term \"property\" itself is a reserved word in this language, so the relation is named accordingly)";
}
@source(IRC_S304_B, quote = "by the acquiring corporation to the extent of its earnings and profits, and")
rule DividendFromAcquiringCorpLesserPropertyRule(t: DistributionEvent, prop_amount: Money, ep: Money) strict {
    label en official "section 304(b)(2)(A): first-tier dividend is the property amount, when it does not exceed acquiring-corp E&P";
    when property_received_304(t, prop_amount);
    when acquiring_corp_ep_304b2(t, _, ep);
    when prop_amount <= ep;
    then dividend_amount_from_acquiring_corp_304b2a(t, prop_amount);
}
@source(IRC_S304_B, quote = "by the acquiring corporation to the extent of its earnings and profits, and")
rule DividendFromAcquiringCorpLesserEpRule(t: DistributionEvent, prop_amount: Money, ep: Money) strict {
    label en official "section 304(b)(2)(A): first-tier dividend is capped at acquiring-corp E&P when the property amount exceeds it";
    when property_received_304(t, prop_amount);
    when acquiring_corp_ep_304b2(t, _, ep);
    when prop_amount > ep;
    then dividend_amount_from_acquiring_corp_304b2a(t, ep);
}
pub relation dividend_amount_from_issuing_corp_304b2b(t: DistributionEvent, amount: Money) kind institutional {
    label en official "section 304(b)(2)(B): the amount treated as a dividend out of the issuing corporation's earnings and profits — the lesser of the property remaining after the first tier and the issuing corporation's E&P";
}
@source(IRC_S304_B, quote = "then by the issuing corporation to the extent of its earnings and profits.")
rule DividendFromIssuingCorpLesserRemainderRule(t: DistributionEvent, prop_amount: Money, first_tier: Money, issuing_ep: Money) strict {
    label en official "section 304(b)(2)(B): second-tier dividend is the property remaining after the first tier, when it does not exceed issuing-corp E&P";
    when property_received_304(t, prop_amount);
    when dividend_amount_from_acquiring_corp_304b2a(t, first_tier);
    when issuing_corp_ep_304b2(t, _, issuing_ep);
    when prop_amount - first_tier <= issuing_ep;
    then dividend_amount_from_issuing_corp_304b2b(t, prop_amount - first_tier);
}
@source(IRC_S304_B, quote = "then by the issuing corporation to the extent of its earnings and profits.")
rule DividendFromIssuingCorpLesserEpRule(t: DistributionEvent, prop_amount: Money, first_tier: Money, issuing_ep: Money) strict {
    label en official "section 304(b)(2)(B): second-tier dividend capped at issuing-corp E&P when the remainder exceeds it";
    when property_received_304(t, prop_amount);
    when dividend_amount_from_acquiring_corp_304b2a(t, first_tier);
    when issuing_corp_ep_304b2(t, _, issuing_ep);
    when prop_amount - first_tier > issuing_ep;
    then dividend_amount_from_issuing_corp_304b2b(t, issuing_ep);
}
pub relation section_304_total_dividend_amount(t: DistributionEvent, amount: Money) kind institutional {
    label en official "section 304(b)(2): the total amount treated as a dividend — the sum of the first-tier (acquiring corporation) and second-tier (issuing corporation) dividend amounts";
}
@source(IRC_S304_B, quote = "the determination of the amount which is a dividend (and the source thereof) shall be made as if the property were distributed—")
rule Section304TotalDividendAmountRule(t: DistributionEvent, tier1: Money, tier2: Money) strict {
    label en official "section 304(b)(2): total dividend amount is the sum of both tiers";
    when dividend_amount_from_acquiring_corp_304b2a(t, tier1);
    when dividend_amount_from_issuing_corp_304b2b(t, tier2);
    then section_304_total_dividend_amount(t, tier1 + tier2);
}

// Section 304(c)(1): "control" — 50 percent of voting power or 50 percent of
// total value, with the chain-control second sentence.
pub relation voting_power_share_304c(p: Person, corp: Corporation, share: Decimal) kind empirical {
    label en unofficial "person's share of the total combined voting power of all classes of stock of the corporation entitled to vote, for purposes of section 304(c) (distinct threshold from section 368(c)'s 80 percent)";
}
pub relation total_value_share_304c(p: Person, corp: Corporation, share: Decimal) kind empirical {
    label en unofficial "person's share of the total value of shares of all classes of stock of the corporation, for purposes of section 304(c)";
}
pub relation control_304c_direct(p: Person, corp: Corporation) kind institutional {
    label en official "person directly has \"control\" of the corporation within the meaning of section 304(c)(1), first sentence: at least 50 percent of total combined voting power, OR at least 50 percent of total value of all classes of stock";
}
@source(IRC_S304_C, quote = "control means the ownership of stock possessing at least 50 percent of the total combined voting power of all classes of stock entitled to vote, or at least 50 percent of the total value of shares of all classes of stock.")
rule Control304cDirectFromVotingPowerRule(p: Person, corp: Corporation, share: Decimal) strict {
    label en official "section 304(c)(1): control via the 50 percent voting-power test";
    when voting_power_share_304c(p, corp, share);
    when share >= 0.50;
    then control_304c_direct(p, corp);
}
@source(IRC_S304_C, quote = "control means the ownership of stock possessing at least 50 percent of the total combined voting power of all classes of stock entitled to vote, or at least 50 percent of the total value of shares of all classes of stock.")
rule Control304cDirectFromTotalValueRule(p: Person, corp: Corporation, share: Decimal) strict {
    label en official "section 304(c)(1): control via the 50 percent total-value test";
    when total_value_share_304c(p, corp, share);
    when share >= 0.50;
    then control_304c_direct(p, corp);
}
pub relation control_304c(p: Person, corp: Corporation) kind institutional {
    label en official "person has \"control\" of the corporation within the meaning of section 304(c): direct 50 percent ownership, or (chain, one level) direct control of an intermediate corporation that itself owns at least 50 percent of the corporation";
}
rule Control304cFromDirectRule(p: Person, corp: Corporation) strict {
    label en official "section 304(c)(1) first sentence: direct control is control";
    when control_304c_direct(p, corp);
    then control_304c(p, corp);
}
@source(IRC_S304_C, quote = "If a person (or persons) is in control (within the meaning of the preceding sentence) of a corporation which in turn owns at least 50 percent of the total combined voting power of all stock entitled to vote of another corporation, or owns at least 50 percent of the total value of the shares of all classes of stock of another corporation, then such person (or persons) shall be treated as in control of such other corporation.")
pub relation intermediate_corp_owns_50_percent_of_other(intermediate: Corporation, other: Corporation) kind empirical {
    label en official "section 304(c)(1) second sentence: the intermediate corporation owns at least 50 percent of the voting power or total value of another corporation's stock — the chain-control link";
}
rule Control304cChainRule(p: Person, intermediate: Corporation, other: Corporation) strict {
    label en official "section 304(c)(1) second sentence: DIRECT control of an intermediate corporation that itself owns 50 percent of another corporation makes the person in control of that other corporation (one level of chaining; a longer chain is TECH_GAP, same bounded-hop class as G37/G61/G63)";
    when control_304c_direct(p, intermediate);
    when intermediate_corp_owns_50_percent_of_other(intermediate, other);
    then control_304c(p, other);
}

// --- Section 306: disposition of section 306 stock -------------------------

pub entity Section306StockDisposition { label en unofficial "a shareholder's sale or other disposition of section 306 stock"; }

@source(IRC_S306_C, quote = "Stock (other than common stock issued with respect to common stock) which was distributed to the shareholder selling or otherwise disposing of such stock if, by reason of section 305(a), any part of such distribution was not includible in the gross income of the shareholder.")
pub relation stock_distributed_excluded_under_305a_306c1a(stock: Asset) kind empirical {
    label en official "section 306(c)(1)(A): non-common stock distributed to the shareholder where, by reason of section 305(a), part of the distribution was not includible in gross income";
}
pub relation section_306_stock(stock: Asset) kind institutional {
    label en official "the stock is \"section 306 stock\" within the meaning of section 306(c)";
}
@source(IRC_S306_C, quote = "the term \"section 306 stock\" means stock which meets the requirements of subparagraph (A), (B), or (C) of this paragraph.")
rule Section306StockFromDistributedRule(stock: Asset) defeasible {
    label en official "section 306(c)(1)(A): non-common stock excludible in part under section 305(a) is section 306 stock, unless the section 306(c)(2) no-E&P exception applies";
    when stock_distributed_excluded_under_305a_306c1a(stock);
    when not_known(no_earnings_and_profits_exception_306c2(stock));
    when not_known(section_306_taint_removed_306e1(stock));
    then section_306_stock(stock);
}
@source(IRC_S306_C, quote = "the term \"section 306 stock\" does not include any stock no part of the distribution of which would have been a dividend at the time of the distribution if money had been distributed in lieu of the stock.")
pub relation no_earnings_and_profits_exception_306c2(stock: Asset) kind empirical {
    label en official "section 306(c)(2): no part of the distribution of the stock would have been a dividend if money had been distributed instead — the stock is NOT section 306 stock";
}

pub relation section_306_disposition_not_redemption(d: Section306StockDisposition, shareholder: Person, stock: Asset) kind empirical {
    label en official "the disposition of section 306 stock is not a redemption within the meaning of section 317(b) — section 306(a)(1)";
}
pub relation amount_realized_306(d: Section306StockDisposition, amount: Money) kind empirical {
    label en official "the amount realized by the shareholder on the disposition of section 306 stock";
}
pub relation ratable_hypothetical_dividend_306a1a(d: Section306StockDisposition, amount: Money) kind empirical {
    label en official "section 306(a)(1)(A)(ii): the section 306 stock's ratable share of the amount which would have been a dividend at the time of distribution if the corporation had distributed money equal to the stock's fair market value, instead of the section 306 stock";
}
pub relation section_306a1a_ordinary_income(d: Section306StockDisposition, shareholder: Person, amount: Money) kind institutional {
    label en official "section 306(a)(1)(A): the amount realized is treated as ordinary income, up to the section 306(a)(1)(A) ratable-hypothetical-dividend amount";
}
@source(IRC_S306_A, quote = "The amount realized shall be treated as ordinary income.")
rule Section306a1aOrdinaryIncomeAtOrBelowRule(d: Section306StockDisposition, shareholder: Person, realized: Money, hypothetical: Money) strict {
    label en official "section 306(a)(1)(A): the full amount realized is ordinary income when it does not exceed the ratable hypothetical dividend";
    when section_306_disposition_not_redemption(d, shareholder, _);
    when amount_realized_306(d, realized);
    when ratable_hypothetical_dividend_306a1a(d, hypothetical);
    when realized <= hypothetical;
    then section_306a1a_ordinary_income(d, shareholder, realized);
}
@source(IRC_S306_A, quote = "This subparagraph shall not apply to the extent that—")
rule Section306a1aOrdinaryIncomeCappedRule(d: Section306StockDisposition, shareholder: Person, realized: Money, hypothetical: Money) strict {
    label en official "section 306(a)(1)(A): ordinary income is capped at the ratable hypothetical dividend when the amount realized exceeds it";
    when section_306_disposition_not_redemption(d, shareholder, _);
    when amount_realized_306(d, realized);
    when ratable_hypothetical_dividend_306a1a(d, hypothetical);
    when realized > hypothetical;
    then section_306a1a_ordinary_income(d, shareholder, hypothetical);
}
pub relation adjusted_basis_of_306_stock(d: Section306StockDisposition, amount: Money) kind empirical {
    label en official "the adjusted basis of the section 306 stock disposed of, for the section 306(a)(1)(B) gain computation";
}
pub relation section_306a1b_gain(d: Section306StockDisposition, shareholder: Person, amount: Money) kind institutional {
    label en official "section 306(a)(1)(B): the excess of the amount realized over the sum of the section 306(a)(1)(A) ordinary income and the adjusted basis of the stock is treated as gain from the sale of the stock";
}
@source(IRC_S306_A, quote = "Any excess of the amount realized over the sum of—")
rule Section306a1bGainRule(d: Section306StockDisposition, shareholder: Person, realized: Money, ordinary: Money, basis: Money) strict {
    label en official "section 306(a)(1)(B): gain is the excess of amount realized over ordinary income plus basis (zero or below is no gain, per (a)(1)(C) no-loss)";
    when section_306a1a_ordinary_income(d, shareholder, ordinary);
    when adjusted_basis_of_306_stock(d, basis);
    when amount_realized_306(d, realized);
    when realized > ordinary + basis;
    then section_306a1b_gain(d, shareholder, realized - (ordinary + basis));
}
// Section 306(a)(1)(C): no loss shall be recognized — a negative fact, no
// rule concludes a loss; the absence of `section_306a1b_gain` when realized
// does not exceed ordinary income plus basis IS the no-loss result (no
// relation to derive a loss into).

@source(IRC_S306_A, quote = "If the disposition is a redemption, the amount realized shall be treated as a distribution of property to which section 301 applies.")
pub relation section_306_disposition_is_redemption(d: Section306StockDisposition, shareholder: Person, stock: Asset) kind empirical {
    label en official "the disposition of section 306 stock is a redemption — section 306(a)(2)";
}
pub relation section_306a2_treated_as_301(d: Section306StockDisposition, shareholder: Person, amount: Money) kind institutional {
    label en official "section 306(a)(2): the amount realized on a redemption of section 306 stock is treated as a distribution of property to which section 301 applies";
}
@source(IRC_S306_A, quote = "the amount realized shall be treated as a distribution of property to which section 301 applies.")
rule Section306a2TreatedAs301Rule(d: Section306StockDisposition, shareholder: Person, stock: Asset, realized: Money) strict {
    label en official "section 306(a)(2): redemption of section 306 stock -> section 301 treatment of the amount realized";
    when section_306_disposition_is_redemption(d, shareholder, stock);
    when amount_realized_306(d, realized);
    then section_306a2_treated_as_301(d, shareholder, realized);
}

// Section 306(b) exceptions — (b)(1) EXACT (termination of interest, mirrors
// module 04's complete-termination machinery), (b)(2)/(3) classification,
// (b)(4) EVALUATIVE (Secretary satisfaction that the plan was not tax-
// avoidance motivated).
@source(IRC_S306_B, quote = "is not, directly or indirectly, to a person the ownership of whose stock would (under section 318(a)) be attributable to the shareholder; and")
pub relation disposition_not_to_attributed_person_306b1(d: Section306StockDisposition) kind empirical {
    label en official "section 306(b)(1)(A)(ii): the disposition is not, directly or indirectly, to a person whose stock ownership would be attributable to the shareholder under section 318(a)";
}
@source(IRC_S306_B, quote = "terminates the entire stock interest of the shareholder in the corporation (and for purposes of this clause, section 318(a) shall apply).")
pub relation disposition_terminates_entire_interest_306b1(d: Section306StockDisposition) kind empirical {
    label en official "section 306(b)(1)(A)(iii): the disposition terminates the shareholder's entire stock interest in the corporation, section 318(a) applying";
}
pub relation section_306b1_exception_applies(d: Section306StockDisposition, shareholder: Person, stock: Asset) kind institutional {
    label en official "section 306(b)(1)(A): the not-a-redemption/not-to-attributed-person/complete-termination exception applies, so section 306(a) does not apply to the disposition";
}
@source(IRC_S306_B, quote = "If the disposition—")
rule Section306b1ExceptionNotRedemptionRule(d: Section306StockDisposition, shareholder: Person, stock: Asset) strict {
    label en official "section 306(b)(1)(A): the complete-termination exception, non-redemption branch";
    when section_306_disposition_not_redemption(d, shareholder, stock);
    when disposition_not_to_attributed_person_306b1(d);
    when disposition_terminates_entire_interest_306b1(d);
    then section_306b1_exception_applies(d, shareholder, stock);
}
@source(IRC_S306_B, quote = "If the disposition is a redemption and paragraph (3) or (4) of section 302(b) applies.")
pub relation redemption_qualifies_under_302b3_or_302b4(d: Section306StockDisposition) kind empirical {
    label en official "section 306(b)(1)(B): the redemption of section 306 stock qualifies under section 302(b)(3) (complete termination) or section 302(b)(4) (partial liquidation)";
}
rule Section306b1ExceptionRedemptionRule(d: Section306StockDisposition, shareholder: Person, stock: Asset) strict {
    label en official "section 306(b)(1)(B): the complete-termination/partial-liquidation exception, redemption branch";
    when section_306_disposition_is_redemption(d, shareholder, stock);
    when redemption_qualifies_under_302b3_or_302b4(d);
    then section_306b1_exception_applies(d, shareholder, stock);
}
@source(IRC_S306_B, quote = "If the section 306 stock is redeemed in a distribution in complete liquidation to which part II (sec. 331 and following) applies.")
pub relation section_306_stock_redeemed_in_complete_liquidation(d: Section306StockDisposition) kind empirical {
    label en official "section 306(b)(2): the section 306 stock is redeemed in a distribution in complete liquidation to which Part II (section 331 and following) applies";
}
pub relation section_306b2_exception_applies(d: Section306StockDisposition) kind institutional {
    label en official "section 306(b)(2): the complete-liquidation exception applies, so section 306(a) does not apply";
}
rule Section306b2ExceptionRule(d: Section306StockDisposition) strict {
    label en official "section 306(b)(2): complete-liquidation exception";
    when section_306_stock_redeemed_in_complete_liquidation(d);
    then section_306b2_exception_applies(d);
}
external judgment relation section_306_plan_not_tax_avoidance(d: Section306StockDisposition) {
    authority Secretary;
    label en official "section 306(b)(4): it is established to the satisfaction of the Secretary that the distribution and disposition (or redemption) of the section 306 stock was not in pursuance of a plan having as a principal purpose the avoidance of Federal income tax";
}
pub relation section_306b4_exception_applies(d: Section306StockDisposition) kind institutional {
    label en official "section 306(b)(4): the transactions-not-in-avoidance exception applies";
}
rule Section306b4ExceptionRule(d: Section306StockDisposition) strict {
    label en official "section 306(b)(4): the Secretary is satisfied there was no tax-avoidance purpose";
    when section_306_plan_not_tax_avoidance(d);
    then section_306b4_exception_applies(d);
}

// --- Section 307: basis of stock and stock rights ---------------------------

pub relation stock_rights_distribution_305a(sh: Person, old_stock: Asset, new_stock: Asset) kind empirical {
    label en official "the shareholder receives new stock or stock rights in a distribution to which section 305(a) applies — section 307(a)";
}
pub relation old_stock_adjusted_basis_307(old_stock: Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the old stock immediately before the section 305(a) distribution, for the section 307(a) allocation";
}
// Section 307(a): the allocation METHOD is left to Treasury regulations
// ("Such allocation shall be made under regulations prescribed by the
// Secretary") — EXTERNAL_DEPENDENCY, same posture as section 312(h)/355's
// Secretary-prescribed-allocation provisions; only the INPUT (old stock's
// basis, to be allocated) and the fact that an allocation occurs are
// modelled, not an invented allocation formula.
external judgment relation stock_and_rights_basis_allocation_307a(old_stock: Asset, new_stock: Asset, old_stock_basis: Money, new_stock_basis: Money) {
    authority Secretary;
    label en official "section 307(a): the allocation, under Treasury regulations, of the adjusted basis of the old stock between the old stock and the new stock or rights received";
}

// Section 307(b): the 15 percent safe harbor and the election.
@source(IRC_S307_B, quote = "a corporation distributes rights to acquire its stock to a shareholder in a distribution to which section 305(a) applies, and")
pub relation stock_rights_distribution_307b(sh: Person, old_stock: Asset, rights: Asset) kind empirical {
    label en official "section 307(b)(1)(A): the corporation distributes rights to acquire its stock, in a distribution to which section 305(a) applies";
}
pub relation fmv_of_rights_307b(rights: Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the stock rights at the time of the distribution, for the section 307(b)(1)(B) 15 percent test";
}
pub relation fmv_of_old_stock_307b(old_stock: Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the old stock at the time of the distribution, for the section 307(b)(1)(B) 15 percent test";
}
pub relation rights_below_15_percent_of_old_stock_307b(sh: Person, old_stock: Asset, rights: Asset) kind institutional {
    label en official "section 307(b)(1)(B): the fair market value of the stock rights is less than 15 percent of the fair market value of the old stock at the time of the distribution";
}
@source(IRC_S307_B, quote = "the fair market value of such rights at the time of the distribution is less than 15 percent of the fair market value of the old stock at such time,")
rule RightsBelow15PercentRule(sh: Person, old_stock: Asset, rights: Asset, rights_fmv: Money, old_fmv: Money) strict {
    label en official "section 307(b)(1)(B): exact 15 percent threshold test";
    when stock_rights_distribution_307b(sh, old_stock, rights);
    when fmv_of_rights_307b(rights, rights_fmv);
    when fmv_of_old_stock_307b(old_stock, old_fmv);
    when rights_fmv < round(old_fmv * 0.15, 2, "HALF_UP");
    then rights_below_15_percent_of_old_stock_307b(sh, old_stock, rights);
}
pub relation stock_rights_basis_zero_307b1(rights: Asset) kind institutional {
    label en official "section 307(b)(1): absent the section 307(b)(2) election, the basis of stock rights below the 15 percent threshold is zero and section 307(a) allocation does not apply";
}
@source(IRC_S307_B, quote = "then subsection (a) shall not apply and the basis of such rights shall be zero, unless the taxpayer elects under paragraph (2) of this subsection to determine the basis of the old stock and of the stock rights under the method of allocation provided in subsection (a).")
rule StockRightsBasisZeroRule(sh: Person, old_stock: Asset, rights: Asset) defeasible {
    label en official "section 307(b)(1): zero basis for below-threshold rights, absent the section 307(b)(2) election";
    when rights_below_15_percent_of_old_stock_307b(sh, old_stock, rights);
    when not_known(section_307b2_allocation_election_exists(rights));
    then stock_rights_basis_zero_307b1(rights);
}
// Section 307(b)(2): the election to use section 307(a) allocation instead
// of the zero-basis default — a POWER (irrevocable once made, exercised on
// the return filed by the deadline for the year the rights were received,
// including extensions).
pub relation election_return_filed_within_deadline_307b2(sh: Person, rights: Asset, filed_on: Date, deadline: Date) kind empirical {
    label en official "section 307(b)(2): the taxpayer's return, containing the election, is filed by the prescribed deadline (including extensions) for the taxable year in which the rights were received";
}
pub relation section_307b2_election_valid(sh: Person, rights: Asset, filed_on: Date, deadline: Date) kind institutional {
    label en official "section 307(b)(2): the election is validly made — the return containing it was filed by the prescribed deadline (including extensions)";
}
rule Section307b2ElectionValidRule strict {
    label en official "section 307(b)(2): the election is valid exactly when the return is filed by the deadline";
    for sh: Person; for rights: Asset; for filed_on: Date; for deadline: Date;
    when election_return_filed_within_deadline_307b2(sh, rights, filed_on, deadline);
    when filed_on <= deadline;
    then section_307b2_election_valid(sh, rights, filed_on, deadline);
}
pub relation section_307b2_allocation_elected(sh: Person, rights: Asset) kind institutional {
    label en official "section 307(b)(2): the taxpayer has validly elected to determine the basis of the old stock and the stock rights under the section 307(a) allocation method, in lieu of the zero-basis default — irrevocable once made";
}
@source(IRC_S307_B, quote = "Such election shall be made in such manner as the Secretary may by regulations prescribe, and shall be irrevocable when made.")
rule Section307b2AllocationElectionPowerRule strict {
    label en official "section 307(b)(2): the taxpayer's power to elect section 307(a) allocation over the zero-basis default, irrevocable once validly exercised";
    for sh: Person; for rights: Asset; for filed_on: Date; for deadline: Date;
    when election_return_filed_within_deadline_307b2(sh, rights, filed_on, deadline);
    then power Section307b2AllocationElection {
        holder sh;
        over rights;
        exercise election_return_filed_within_deadline_307b2(sh, rights, filed_on, deadline);
        valid_when section_307b2_election_valid(sh, rights, filed_on, deadline);
        effect create(section_307b2_allocation_elected(sh, rights));
        window [@1954-06-22, infinity);
    };
}
pub relation section_307b2_allocation_election_exists(rights: Asset) kind institutional {
    label en unofficial "witness: the section 307(b)(2) election has been validly made for these rights, for SOME holder (projection helper for the not_known guard, LDC-E0207)";
}
rule Section307b2AllocationElectionExistsRule(sh: Person, rights: Asset) strict {
    label en unofficial "projection helper";
    when section_307b2_allocation_elected(sh, rights);
    then section_307b2_allocation_election_exists(rights);
}

// NOT DONE this stage (TECH_GAP/EXTERNAL_DEPENDENCY, see coverage rows):
// section 303(b)(2)(B) (the two-or-more-corporations 20-percent aggregation
// sub-test, and the community-property/joint-tenancy surviving-spouse
// inclusion rule); section 304(b)(1) (the section 302(b) redetermination-by-
// reference-to-issuing-corporation-stock mechanics, and the section
// 318(a)(2)(C)/(3)(C) 50-percent-limitation removal), 304(b)(3)-(6)
// (coordination with section 351, bank-holding-company formations,
// intragroup adjustments, and the foreign-acquiring-corporation special
// rules), 304(c)(2)-(3) (the stock-acquired-in-the-transaction control-group
// definition and the modified section 318(a) constructive-ownership rules —
// same bounded-hop class as G37/G61/G63); section 306(c)(1)(B)-(C) and
// (c)(3)-(4) (reorganization/separation-received section 306 stock, the
// transferred/substituted-basis category, the section 351-exchange
// extension, and the section 318(a) attribution layered on top of them);
// section 307(c) (the pre-June-22-1954 cross-reference to section 1052 —
// NON_NORMATIVE, historical).
