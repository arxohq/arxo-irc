// Stage 3b (26.09.2026, TECH_GAP reduction). Section 304(b)(1), (3)-(6)
// (special rules for related-corporation redemptions; (b)(2) is module 12) and
// section 305(c), (e) (transactions treated as distributions; stripped
// preferred stock). Status implemented_unverified: nothing here was executed.
// Wiring notes (TECH-GAPS G4033-G4036): the foreign-acquirer earnings and
// profits (b)(5) are a parallel relation and do not replace the asserted
// acquiring_corp_ep_304b2; the (b)(3)(B) liability exclusion is per liability;
// the section 305(e) inclusion is the total original issue discount, not a
// period accrual under section 1272(a).

// --- Section 304(b)(1) ----------------------------------------------------------------

use self::{
    Asset,
    Corporation,
    DistributionEvent,
    IRC_S304_B,
    IRC_S305_C,
    IRC_S305_E,
    Person,
    property_received_304,
    section_304a1_applies,
    section_304a2_applies,
};

pub relation redemption_test_corporation_304b1(t: DistributionEvent, issuing: Corporation) kind institutional {
    label en official "the section 302(b) determinations are made by reference to the stock of the issuing corporation (section 304(b)(1), first sentence)";
}
@source(IRC_S304_B, quote = "determinations as to whether the acquisition is, by reason of section 302(b), to be treated as a distribution in part or full payment in exchange for the stock shall be made by reference to the stock of the issuing corporation.")
rule Section304b1FromA1Rule(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) strict {
    label en official "section 304(b)(1): a section 304(a)(1) acquisition";
    when section_304a1_applies(t, acquiring, issuing, transferor, amount);
    then redemption_test_corporation_304b1(t, issuing);
}
@source(IRC_S304_B, quote = "determinations as to whether the acquisition is, by reason of section 302(b), to be treated as a distribution in part or full payment in exchange for the stock shall be made by reference to the stock of the issuing corporation.")
rule Section304b1FromA2Rule(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) strict {
    label en official "section 304(b)(1): a section 304(a)(2) acquisition";
    when section_304a2_applies(t, acquiring, issuing, transferor, amount);
    then redemption_test_corporation_304b1(t, issuing);
}
pub relation attribution_50_percent_limit_disregarded_304b1(t: DistributionEvent) kind institutional {
    label en official "sections 318(a)(2)(C) and 318(a)(3)(C) are applied without regard to their 50 percent limitation for the section 302(b) tests of a section 304 acquisition (section 304(b)(1), second sentence); the attribution itself is module 03 and is not re-run";
}
@source(IRC_S304_B, quote = "sections 318(a)(2)(C) and 318(a)(3)(C) shall be applied without regard to the 50 percent limitation contained therein.")
rule Section304b1AttributionRule(t: DistributionEvent, issuing: Corporation) strict {
    label en official "section 304(b)(1), second sentence";
    when redemption_test_corporation_304b1(t, issuing);
    then attribution_50_percent_limit_disregarded_304b1(t);
}

// --- Section 304(b)(3): coordination with section 351 ---------------------------------------

pub relation section_304_governs_instead_of_351_304b3a(t: DistributionEvent) kind institutional {
    label en official "section 304(a), and not section 351 or the section 351 parts of sections 357 and 358, applies to property received in the distribution (section 304(b)(3)(A)); the section 351 modules are not re-gated on this relation (G4033)";
}
@source(IRC_S304_B, quote = "Except as otherwise provided in this paragraph, subsection (a) (and not section 351 and not so much of sections 357 and 358 as relates to section 351) shall apply to any property received in a distribution described in subsection (a).")
rule Section304b3aFromA1Rule(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) strict {
    label en official "section 304(b)(3)(A): a section 304(a)(1) acquisition";
    when section_304a1_applies(t, acquiring, issuing, transferor, amount);
    then section_304_governs_instead_of_351_304b3a(t);
}
@source(IRC_S304_B, quote = "Except as otherwise provided in this paragraph, subsection (a) (and not section 351 and not so much of sections 357 and 358 as relates to section 351) shall apply to any property received in a distribution described in subsection (a).")
rule Section304b3aFromA2Rule(t: DistributionEvent, acquiring: Corporation, issuing: Corporation, transferor: Person, amount: Money) strict {
    label en official "section 304(b)(3)(A): a section 304(a)(2) acquisition";
    when section_304a2_applies(t, acquiring, issuing, transferor, amount);
    then section_304_governs_instead_of_351_304b3a(t);
}
pub entity Liability304 { label en unofficial "a liability assumed by the acquiring corporation or to which the acquired stock is subject (section 304(b)(3)(B))"; }
pub relation acquisition_described_in_351_304b3b(t: DistributionEvent) kind empirical {
    label en official "the acquisition is also described in section 351";
}
pub relation liability_assumed_or_stock_subject_304b3bi(t: DistributionEvent, l: Liability304, amount: Money) kind empirical {
    label en official "a liability of this amount assumed by the acquiring corporation or to which the stock is subject (section 304(b)(3)(B)(i)(I)-(II))";
}
pub relation liability_incurred_to_acquire_stock_304b3bi(l: Liability304) kind empirical {
    label en official "the liability was incurred by the transferor to acquire the stock referred to in (a)(1)(B) or (a)(2)(A)";
}
pub relation liability_is_extension_renewal_or_refinancing_304b3bii(l: Liability304, of: Liability304) kind empirical {
    label en official "the liability is an extension, renewal or refinancing of the liability 'of'";
}
pub relation stock_from_person_without_attributed_stock_304b3biii1(t: DistributionEvent) kind empirical {
    label en official "the stock was acquired by the transferor from a person none of whose stock is attributable to the transferor under section 318(a) (other than paragraph (4)) (asserted)";
}
pub relation stock_from_person_meeting_302c2_rules_for_both_304b3biii2(t: DistributionEvent) kind empirical {
    label en official "the stock was acquired from a person who satisfies rules similar to section 302(c)(2) for both the acquiring and the issuing corporations, as if a distributee of each";
}
pub relation liability_stock_source_qualifies_304b3biii(t: DistributionEvent) kind institutional {
    label en official "clause (i) applies only to stock acquired from a person meeting (I) or (II) (section 304(b)(3)(B)(iii))";
}
@source(IRC_S304_B, quote = "none of whose stock is attributable to the transferor under section 318(a) (other than paragraph (4) thereof), or")
rule Section304b3biiiIRule(t: DistributionEvent) strict {
    label en official "section 304(b)(3)(B)(iii)(I)";
    when stock_from_person_without_attributed_stock_304b3biii1(t);
    then liability_stock_source_qualifies_304b3biii(t);
}
@source(IRC_S304_B, quote = "who satisfies rules similar to the rules of section 302(c)(2) with respect to both the acquiring and the issuing corporations (determined as if such person were a distributee of each such corporation).")
rule Section304b3biiiIIRule(t: DistributionEvent) strict {
    label en official "section 304(b)(3)(B)(iii)(II)";
    when stock_from_person_meeting_302c2_rules_for_both_304b3biii2(t);
    then liability_stock_source_qualifies_304b3biii(t);
}
pub relation liability_outside_304a_304b3bi(t: DistributionEvent, l: Liability304, amount: Money) kind institutional {
    label en official "subsection (a) does not apply to this liability (section 304(b)(3)(B)(i)), with the extension rule of clause (ii)";
}
@source(IRC_S304_B, quote = "if such liability was incurred by the transferor to acquire the stock.")
rule Section304b3biRule(t: DistributionEvent, l: Liability304, amount: Money) strict {
    label en official "section 304(b)(3)(B)(i): a section 351 acquisition, a liability incurred to acquire the stock, from a qualifying source";
    when acquisition_described_in_351_304b3b(t);
    when liability_assumed_or_stock_subject_304b3bi(t, l, amount);
    when liability_incurred_to_acquire_stock_304b3bi(l);
    when liability_stock_source_qualifies_304b3biii(t);
    then liability_outside_304a_304b3bi(t, l, amount);
}
@source(IRC_S304_B, quote = "For purposes of clause (i), an extension, renewal, or refinancing of a liability which meets the requirements of clause (i) shall be treated as meeting such requirements.")
rule Section304b3biiRule(t: DistributionEvent, l: Liability304, of: Liability304, amount: Money) strict {
    label en official "section 304(b)(3)(B)(ii): a refinancing of a qualifying liability qualifies too";
    when acquisition_described_in_351_304b3b(t);
    when liability_assumed_or_stock_subject_304b3bi(t, l, amount);
    when liability_is_extension_renewal_or_refinancing_304b3bii(l, of);
    when liability_incurred_to_acquire_stock_304b3bi(of);
    when liability_stock_source_qualifies_304b3biii(t);
    then liability_outside_304a_304b3bi(t, l, amount);
}
pub relation property_amount_after_liability_exclusion_304b3b(t: DistributionEvent, l: Liability304, amount: Money) kind institutional {
    label en official "the section 304(a) property amount less one excluded liability (single-liability form; the sum over several is not aggregated, G4034)";
}
@source(IRC_S304_B, quote = "subsection (a) shall not apply to any liability—")
rule Section304b3bNetRule(t: DistributionEvent, l: Liability304, liability: Money, prop_amount: Money) strict {
    label en official "section 304(b)(3)(B)";
    when liability_outside_304a_304b3bi(t, l, liability);
    when property_received_304(t, prop_amount);
    then property_amount_after_liability_exclusion_304b3b(t, l, prop_amount - liability);
}
// (C)-(D): bank holding company formations
pub relation control_of_bank_acquired_on_304b3ci(t: DistributionEvent, on: Date) kind empirical {
    label en official "control of a bank is acquired pursuant to a plan on this date";
}
pub relation bank_control_transferred_to_bhc_on_304b3ci(t: DistributionEvent, on: Date) kind empirical {
    label en official "stock constituting control of the bank is transferred to a BHC in connection with its formation on this date";
}
pub relation distribution_incident_to_bhc_formation_304b3cii(t: DistributionEvent) kind empirical {
    label en official "incident to the formation of the BHC there is a distribution of property described in subsection (a)";
}
pub relation bhc_recipient_shareholders_have_control_304b3ciii(t: DistributionEvent) kind empirical {
    label en official "the shareholders of the BHC who receive distributions of the property have control of the BHC";
}
pub relation bhc_formation_case_304b3c(t: DistributionEvent) kind institutional {
    label en official "the three conditions of section 304(b)(3)(C)(i)-(iii): control transferred to the BHC within 2 years of its acquisition, the distribution, and the recipients lacking control";
}
@source(IRC_S304_B, quote = "(i) pursuant to a plan, control of a bank is acquired and within 2 years after the date on which such control is acquired, stock constituting control of such bank is transferred to a BHC in connection with its formation,")
rule Section304b3cRule(t: DistributionEvent, acquired: Date, transferred: Date) strict {
    label en official "section 304(b)(3)(C): the within-2-years window is inclusive of the anniversary";
    when control_of_bank_acquired_on_304b3ci(t, acquired);
    when bank_control_transferred_to_bhc_on_304b3ci(t, transferred);
    when transferred >= acquired;
    when transferred <= add_calendar_period(acquired, 2 calendar_year);
    when distribution_incident_to_bhc_formation_304b3cii(t);
    when not_known(bhc_recipient_shareholders_have_control_304b3ciii(t));
    then bhc_formation_case_304b3c(t);
}
pub relation is_bank_holding_company_304b3dii(corp: Corporation) kind empirical {
    label en official "the corporation is a bank holding company within section 2(a) of the Bank Holding Company Act of 1956";
}
pub relation shareholder_value_share_in_bhc_304b3di(t: DistributionEvent, holder: Person, bhc: Corporation, share: Decimal) kind empirical {
    label en official "the holder's share (in value, with the section 304(c)(3) attribution rules applied) of the stock of the BHC";
}
pub relation qualified_minority_shareholder_304b3di(t: DistributionEvent, holder: Person) kind institutional {
    label en official "a shareholder owning less than 10 percent (in value) of the BHC stock (section 304(b)(3)(D)(i))";
}
@source(IRC_S304_B, quote = "The term \"qualified minority shareholder\" means any shareholder who owns less than 10 percent (in value) of the stock of the BHC.")
rule Section304b3diRule(t: DistributionEvent, holder: Person, bhc: Corporation, share: Decimal) strict {
    label en official "section 304(b)(3)(D)(i): strictly below 10 percent";
    when is_bank_holding_company_304b3dii(bhc);
    when shareholder_value_share_in_bhc_304b3di(t, holder, bhc, share);
    when share < 0.10;
    then qualified_minority_shareholder_304b3di(t, holder);
}
pub relation securities_received_incident_to_bhc_formation_304b3c(t: DistributionEvent, holder: Person) kind empirical {
    label en official "the holder received securities incident to the formation of the BHC";
}
pub relation section_304a_disapplied_for_securities_304b3c(t: DistributionEvent, holder: Person) kind institutional {
    label en official "subsection (a) does not apply to the securities a qualified minority shareholder receives incident to the BHC formation (section 304(b)(3)(C))";
}
@source(IRC_S304_B, quote = "then, subsection (a) shall not apply to any securities received by a qualified minority shareholder incident to the formation of such BHC.")
rule Section304b3cDisapplicationRule(t: DistributionEvent, holder: Person) strict {
    label en official "section 304(b)(3)(C): the formation case, a qualified minority shareholder, securities received";
    when bhc_formation_case_304b3c(t);
    when qualified_minority_shareholder_304b3di(t, holder);
    when securities_received_incident_to_bhc_formation_304b3c(t, holder);
    then section_304a_disapplied_for_securities_304b3c(t, holder);
}
pub relation liability_assumption_not_a_distribution_304b3c(t: DistributionEvent, l: Liability304) kind institutional {
    label en official "in a BHC formation case an assumption of (or acquisition subject to) a liability under (B) is not treated as a distribution of property (section 304(b)(3)(C), last sentence)";
}
@source(IRC_S304_B, quote = "For purposes of this subparagraph, any assumption of (or acquisition of stock subject to) a liability under subparagraph (B) shall not be treated as a distribution of property.")
rule Section304b3cLiabilityRule(t: DistributionEvent, l: Liability304, amount: Money) strict {
    label en official "section 304(b)(3)(C), last sentence";
    when bhc_formation_case_304b3c(t);
    when liability_outside_304a_304b3bi(t, l, amount);
    then liability_assumption_not_a_distribution_304b3c(t, l);
}

// --- Section 304(b)(4): intragroup transfers ---------------------------------------------------

pub relation transfer_of_stock_between_affiliated_group_members_304b4a(t: DistributionEvent, from: Corporation, to: Corporation) kind empirical {
    label en official "a transfer described in subsection (a) of stock from one member of an affiliated group (section 1504(a), asserted membership) to another member";
}
pub relation intragroup_stock_304b4bii(stock: Asset) kind institutional {
    label en official "stock in a member of an affiliated group that is held by another member (section 304(b)(4)(B)(ii))";
}
pub relation stock_in_affiliated_group_member_304b4bii1(stock: Asset) kind empirical {
    label en official "the stock is in a corporation that is a member of an affiliated group";
}
pub relation stock_held_by_another_member_304b4bii2(stock: Asset) kind empirical {
    label en official "the stock is held by another member of that group";
}
@source(IRC_S304_B, quote = "The term \"intragroup stock\" means any stock which—")
rule Section304b4bRule(stock: Asset) strict {
    label en official "section 304(b)(4)(B)(ii): both prongs";
    when stock_in_affiliated_group_member_304b4bii1(stock);
    when stock_held_by_another_member_304b4bii2(stock);
    then intragroup_stock_304b4bii(stock);
}
pub relation intragroup_adjustments_required_304b4a(t: DistributionEvent, from: Corporation, to: Corporation) kind institutional {
    label en official "proper adjustments to the adjusted basis of intragroup stock and to the earnings and profits of any group member are required to the extent necessary to carry out the purposes of the section (section 304(b)(4)(A)); the amounts are set by regulations (G4035)";
}
@source(IRC_S304_B, quote = "proper adjustments shall be made to—")
rule Section304b4aRule(t: DistributionEvent, from: Corporation, to: Corporation) strict {
    label en official "section 304(b)(4)(A): the transfer between group members";
    when transfer_of_stock_between_affiliated_group_members_304b4a(t, from, to);
    then intragroup_adjustments_required_304b4a(t, from, to);
}

// --- Section 304(b)(5): foreign acquiring corporations ---------------------------------------------

pub relation acquiring_corporation_is_foreign_304b5(t: DistributionEvent) kind empirical {
    label en official "the acquiring corporation is a foreign corporation";
}
pub relation acquirer_earnings_and_profits_qualifying_304b5a(t: DistributionEvent, amount: Money) kind empirical {
    label en official "the acquiring corporation's earnings and profits attributable (under regulations) to stock owned (section 958(a)) by a United States shareholder that is the transferor or a section 267(b)/707(b) related person, accumulated while the stock was so owned and the acquirer was a controlled foreign corporation (clauses (i)-(ii); attribution asserted)";
}
pub relation dividends_arising_304b5b(t: DistributionEvent, amount: Money) kind empirical {
    label en official "the dividends arising from the acquisition, determined without regard to subparagraph (B)";
}
pub relation dividends_neither_taxed_nor_in_cfc_earnings_304b5b(t: DistributionEvent, amount: Money) kind empirical {
    label en official "the part of those dividends that would neither be subject to tax under this chapter for the year nor be includible in the earnings and profits of a controlled foreign corporation";
}
pub relation foreign_acquirer_earnings_excluded_304b5b(t: DistributionEvent) kind institutional {
    label en official "more than 50 percent of the dividends would be untaxed and outside CFC earnings: no earnings and profits are taken into account (section 304(b)(5)(B))";
}
@source(IRC_S304_B, quote = "no earnings and profits shall be taken into account under paragraph (2)(A) (and subparagraph (A) shall not apply) if more than 50 percent of the dividends arising from such acquisition")
rule Section304b5bRule(t: DistributionEvent, total: Money, untaxed: Money) strict {
    label en official "section 304(b)(5)(B): untaxed x 2 > total (exactly 50 percent is not more)";
    when acquiring_corporation_is_foreign_304b5(t);
    when dividends_arising_304b5b(t, total);
    when dividends_neither_taxed_nor_in_cfc_earnings_304b5b(t, untaxed);
    when untaxed * 2 > total;
    then foreign_acquirer_earnings_excluded_304b5b(t);
}
pub relation foreign_acquirer_earnings_taken_into_account_304b5(t: DistributionEvent, amount: Money) kind institutional {
    label en official "the earnings and profits taken into account under paragraph (2)(A) for a foreign acquiring corporation; a parallel relation not wired into acquiring_corp_ep_304b2 (G4033)";
}
@source(IRC_S304_B, quote = "the only earnings and profits taken into account under paragraph (2)(A) shall be those earnings and profits—")
rule Section304b5aRule(t: DistributionEvent, qualifying: Money) strict {
    label en official "section 304(b)(5)(A): only the qualifying earnings and profits, unless (B) removes all of them";
    when acquiring_corporation_is_foreign_304b5(t);
    when acquirer_earnings_and_profits_qualifying_304b5a(t, qualifying);
    when not_known(foreign_acquirer_earnings_excluded_304b5b(t));
    then foreign_acquirer_earnings_taken_into_account_304b5(t, qualifying);
}
@source(IRC_S304_B, quote = "no earnings and profits shall be taken into account under paragraph (2)(A) (and subparagraph (A) shall not apply) if more than 50 percent of the dividends arising from such acquisition")
rule Section304b5bZeroRule(t: DistributionEvent) strict {
    label en official "section 304(b)(5)(B): zero when the more-than-50-percent test is met";
    when foreign_acquirer_earnings_excluded_304b5b(t);
    then foreign_acquirer_earnings_taken_into_account_304b5(t, 0.00 USD);
}
pub relation regulations_prescribed_304b5c(t: DistributionEvent) kind empirical {
    label en official "the Secretary has prescribed the regulations appropriate to carry out paragraph (5)";
}
@source(IRC_S304_B, quote = "The Secretary shall prescribe such regulations as are appropriate to carry out the purposes of this paragraph.")
rule Section304b5cRegulationsDutyRule(t: DistributionEvent) defeasible {
    label en official "section 304(b)(5)(C): the Secretary shall prescribe regulations; no day count is stated (G4004)";
    when acquiring_corporation_is_foreign_304b5(t);
    then duty Section304b5cPrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_304b5c(t);
            window [-infinity, infinity];
        }
    };
}
pub relation acquiring_or_issuing_corporation_is_foreign_304b6(t: DistributionEvent) kind empirical {
    label en official "the acquiring corporation or the issuing corporation is a foreign corporation";
}
pub relation regulations_prescribed_304b6(t: DistributionEvent) kind empirical {
    label en official "the Secretary has prescribed the regulations appropriate to eliminate a multiple inclusion of any item in income and to provide basis adjustments (including modifications to sections 959 and 961)";
}
@source(IRC_S304_B, quote = "the Secretary shall prescribe such regulations as are appropriate in order to eliminate a multiple inclusion of any item in income by reason of this subpart")
rule Section304b6RegulationsDutyRule(t: DistributionEvent) defeasible {
    label en official "section 304(b)(6): the Secretary shall prescribe regulations against multiple inclusions; no day count is stated (G4004)";
    when acquiring_or_issuing_corporation_is_foreign_304b6(t);
    then duty Section304b6PrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_304b6(t);
            window [-infinity, infinity];
        }
    };
}

// --- Section 305(c): transactions treated as distributions -----------------------------------------

pub entity StockEvent305 { label en unofficial "a change in conversion ratio or redemption price, a redemption price and issue price difference, a redemption treated under section 301, or a similar transaction (section 305(c))"; }
pub relation event_of_kind_305c(ev: StockEvent305, corp: Corporation) kind empirical {
    label en official "the event is a change in conversion ratio, a change in redemption price, a difference between redemption price and issue price, a redemption treated as a section 301 distribution, or a transaction (including a recapitalization) having a similar effect";
}
pub relation shareholder_interest_increased_305c(ev: StockEvent305, shareholder: Person) kind empirical {
    label en official "the shareholder's proportionate interest in the earnings and profits or assets of the corporation is increased by the event";
}
pub relation distribution_305c(ev: StockEvent305, shareholder: Person) kind institutional {
    label en official "the event is treated as a distribution with respect to the shareholder whose proportionate interest is increased (section 305(c), first sentence, as carried out by the regulations)";
}
@source(IRC_S305_C, quote = "shall be treated as a distribution with respect to any shareholder whose proportionate interest in the earnings and profits or assets of the corporation is increased by such change, difference, redemption, or similar transaction.")
rule Section305cRule(ev: StockEvent305, corp: Corporation, shareholder: Person) strict {
    label en official "section 305(c): an event of the listed kinds and an increased proportionate interest";
    when event_of_kind_305c(ev, corp);
    when shareholder_interest_increased_305c(ev, shareholder);
    then distribution_305c(ev, shareholder);
}
pub relation regulations_prescribed_305c(ev: StockEvent305) kind empirical {
    label en official "the Secretary has prescribed the regulations under section 305(c)";
}
@source(IRC_S305_C, quote = "For purposes of this section and section 301, the Secretary shall prescribe regulations under which")
rule Section305cRegulationsDutyRule(ev: StockEvent305, corp: Corporation) defeasible {
    label en official "section 305(c): the Secretary shall prescribe regulations; no day count is stated (G4004)";
    when event_of_kind_305c(ev, corp);
    then duty Section305cPrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_305c(ev);
            window [-infinity, infinity];
        }
    };
}
pub relation redemption_required_or_optional_305c1(stock: Asset) kind empirical {
    label en official "the issuer is required to redeem the stock at a specified time, or the holder has the option to require redemption";
}
pub relation redemption_premium_305c1(stock: Asset, premium: Money) kind empirical {
    label en official "the redemption premium resulting from that requirement or option";
}
pub relation premium_limit_1273a3_305c1(stock: Asset, limit: Money) kind empirical {
    label en official "the amount determined under the principles of section 1273(a)(3) (asserted)";
}
pub relation redemption_premium_reasonable_305c1(stock: Asset) kind institutional {
    label en official "a redemption premium is treated as reasonable only if it does not exceed the section 1273(a)(3) amount (section 305(c)(1)); an equal amount is reasonable";
}
@source(IRC_S305_C, quote = "a redemption premium resulting from such requirement or option shall be treated as reasonable only if the amount of such premium does not exceed the amount determined under the principles of section 1273(a)(3),")
rule Section305c1Rule(stock: Asset, premium: Money, limit: Money) strict {
    label en official "section 305(c)(1)";
    when redemption_required_or_optional_305c1(stock);
    when redemption_premium_305c1(stock, premium);
    when premium_limit_1273a3_305c1(stock, limit);
    when premium <= limit;
    then redemption_premium_reasonable_305c1(stock);
}
pub relation stock_is_callable_305c2(stock: Asset) kind empirical {
    label en official "the stock is callable";
}
pub relation redemption_premium_not_a_distribution_apart_from_call_305c2(stock: Asset) kind empirical {
    label en official "the premium would be treated as a distribution (or series of distributions) apart from the fact that the stock is callable";
}
pub relation premium_treated_as_distribution_305c2(stock: Asset) kind institutional {
    label en official "the redemption premium is treated as a distribution (or series of distributions) although the stock is callable (section 305(c)(2))";
}
@source(IRC_S305_C, quote = "(2) a redemption premium shall not fail to be treated as a distribution (or series of distributions) merely because the stock is callable, and")
rule Section305c2Rule(stock: Asset) strict {
    label en official "section 305(c)(2): callability is disregarded";
    when redemption_premium_not_a_distribution_apart_from_call_305c2(stock);
    then premium_treated_as_distribution_305c2(stock);
}
pub relation premium_taken_into_account_under_1272a_principles_305c3(stock: Asset) kind institutional {
    label en official "a premium treated as a distribution is taken into account under principles similar to section 1272(a) (section 305(c)(3)); the accrual computation itself is not performed here (G4036)";
}
@source(IRC_S305_C, quote = "such premium shall be taken into account under principles similar to the principles of section 1272(a).")
rule Section305c3Rule(stock: Asset) strict {
    label en official "section 305(c)(3)";
    when premium_treated_as_distribution_305c2(stock);
    then premium_taken_into_account_under_1272a_principles_305c3(stock);
}

// --- Section 305(e): stripped preferred stock ---------------------------------------------------------

pub relation stock_limited_and_preferred_no_growth_305e5bi(stock: Asset) kind empirical {
    label en official "the stock is limited and preferred as to dividends and does not participate in corporate growth to any significant extent";
}
pub relation stock_has_fixed_redemption_price_305e5bii(stock: Asset) kind empirical {
    label en official "the stock has a fixed redemption price";
}
pub relation stock_described_in_305e5b(stock: Asset) kind institutional {
    label en official "stock described in section 305(e)(5)(B)";
}
@source(IRC_S305_E, quote = "(ii) has a fixed redemption price.")
rule Section305e5bRule(stock: Asset) strict {
    label en official "section 305(e)(5)(B): both clauses";
    when stock_limited_and_preferred_no_growth_305e5bi(stock);
    when stock_has_fixed_redemption_price_305e5bii(stock);
    then stock_described_in_305e5b(stock);
}
pub relation separation_of_stock_and_unpayable_dividend_305e5a(stock: Asset) kind empirical {
    label en official "there has been a separation in ownership between the stock and any dividend on it that has not become payable";
}
pub relation stripped_preferred_stock_305e5a(stock: Asset) kind institutional {
    label en official "stripped preferred stock (section 305(e)(5)(A))";
}
@source(IRC_S305_E, quote = "The term \"stripped preferred stock\" means any stock described in subparagraph (B) if there has been a separation in ownership between such stock and any dividend on such stock which has not become payable.")
rule Section305e5aRule(stock: Asset) strict {
    label en official "section 305(e)(5)(A)";
    when stock_described_in_305e5b(stock);
    when separation_of_stock_and_unpayable_dividend_305e5a(stock);
    then stripped_preferred_stock_305e5a(stock);
}
pub relation acquisition_of_stock_305e6(stock: Asset, person: Person, on: Date, price: Money) kind empirical {
    label en official "the person acquires the stock on this date for this price";
}
pub relation basis_by_reference_to_transferor_basis_305e6b(stock: Asset, person: Person) kind empirical {
    label en official "the basis of the stock is determined in whole or in part by reference to its adjusted basis in the hands of the person from whom acquired";
}
pub relation purchase_305e6(stock: Asset, person: Person, on: Date, price: Money) kind institutional {
    label en official "a purchase: an acquisition whose basis is not determined by reference to the transferor's basis (section 305(e)(6))";
}
@source(IRC_S305_E, quote = "(B) the basis of such stock is not determined in whole or in part by the reference to the adjusted basis of such stock in the hands of the person from whom acquired.")
rule Section305e6Rule(stock: Asset, person: Person, on: Date, price: Money) strict {
    label en official "section 305(e)(6)";
    when acquisition_of_stock_305e6(stock, person, on, price);
    when not_known(basis_by_reference_to_transferor_basis_305e6b(stock, person));
    then purchase_305e6(stock, person, on, price);
}
pub relation dividend_rights_stripped_and_disposed_305e3(stock: Asset, person: Person, on: Date) kind empirical {
    label en official "the person strips the rights to one or more dividends from stock described in (5)(B) and disposes of the dividend rights on this date";
}
pub relation adjusted_basis_in_stripped_stock_305e3(stock: Asset, person: Person, basis: Money) kind empirical {
    label en official "the person's adjusted basis in the stripped preferred stock";
}
pub relation purchase_or_deemed_purchase_305e(stock: Asset, person: Person, on: Date, price: Money) kind institutional {
    label en official "a purchase, or the deemed purchase of the stripper on the date of disposition at the adjusted basis (section 305(e)(3))";
}
@source(IRC_S305_E, quote = "such person shall be treated as having purchased the stripped preferred stock on the date of such disposition for a purchase price equal to such person's adjusted basis in such stripped preferred stock.")
rule Section305e3Rule(stock: Asset, person: Person, on: Date, basis: Money) strict {
    label en official "section 305(e)(3): after April 30, 1993";
    when dividend_rights_stripped_and_disposed_305e3(stock, person, on);
    when stock_described_in_305e5b(stock);
    when adjusted_basis_in_stripped_stock_305e3(stock, person, basis);
    when on > @1993-04-30;
    then purchase_or_deemed_purchase_305e(stock, person, on, basis);
}
@source(IRC_S305_E, quote = "If any person purchases after April 30, 1993, any stripped preferred stock, then such person, while holding such stock,")
rule Section305ePurchaseRule(stock: Asset, person: Person, on: Date, price: Money) strict {
    label en official "section 305(e)(1): a purchase";
    when purchase_305e6(stock, person, on, price);
    then purchase_or_deemed_purchase_305e(stock, person, on, price);
}
pub relation redemption_price_305e1a(stock: Asset, amount: Money) kind empirical {
    label en official "the redemption price for the stock";
}
pub relation stripped_preferred_stock_income_305e1(stock: Asset, person: Person, amount: Money) kind institutional {
    label en official "the amount treated as original issue discount includible in gross income: the excess of the redemption price over the purchase price, if any (section 305(e)(1)); the total OID, not a period accrual (G4036)";
}
@source(IRC_S305_E, quote = "having original issue discount equal to the excess, if any, of—")
rule Section305e1Rule(stock: Asset, person: Person, on: Date, price: Money, redemption: Money) strict {
    label en official "section 305(e)(1): a positive excess, purchase after April 30, 1993 (the purchase date itself is after)";
    when purchase_or_deemed_purchase_305e(stock, person, on, price);
    when stripped_preferred_stock_305e5a(stock);
    when redemption_price_305e1a(stock, redemption);
    when on > @1993-04-30;
    when redemption > price;
    then stripped_preferred_stock_income_305e1(stock, person, redemption - price);
}
pub relation basis_by_reference_to_purchaser_basis_305e1(stock: Asset, person: Person, purchaser: Person) kind empirical {
    label en official "the person's basis in the stock is determined by reference to the basis in the hands of the purchaser";
}
@source(IRC_S305_E, quote = "The preceding sentence shall also apply in the case of any person whose basis in such stock is determined by reference to the basis in the hands of such purchaser.")
rule Section305e1SuccessorRule(stock: Asset, person: Person, purchaser: Person, on: Date, price: Money, redemption: Money) strict {
    label en official "section 305(e)(1), last sentence: a person with a carryover basis from the purchaser is taxed as the purchaser";
    when basis_by_reference_to_purchaser_basis_305e1(stock, person, purchaser);
    when purchase_or_deemed_purchase_305e(stock, purchaser, on, price);
    when stripped_preferred_stock_305e5a(stock);
    when redemption_price_305e1a(stock, redemption);
    when on > @1993-04-30;
    when redemption > price;
    then stripped_preferred_stock_income_305e1(stock, person, redemption - price);
}
pub relation basis_adjustment_305e2(stock: Asset, person: Person, amount: Money) kind institutional {
    label en official "the person's basis in the stock is increased by the amount included in gross income (section 305(e)(2))";
}
@source(IRC_S305_E, quote = "Appropriate adjustments to basis shall be made for amounts includible in gross income under paragraph (1).")
rule Section305e2Rule(stock: Asset, person: Person, amount: Money) strict {
    label en official "section 305(e)(2)";
    when stripped_preferred_stock_income_305e1(stock, person, amount);
    then basis_adjustment_305e2(stock, person, amount);
}
pub relation ordinary_income_305e4(stock: Asset, person: Person, amount: Money) kind institutional {
    label en official "the amount included under paragraph (1) is ordinary income (section 305(e)(4))";
}
@source(IRC_S305_E, quote = "Any amount included in gross income under paragraph (1) shall be treated as ordinary income.")
rule Section305e4Rule(stock: Asset, person: Person, amount: Money) strict {
    label en official "section 305(e)(4)";
    when stripped_preferred_stock_income_305e1(stock, person, amount);
    then ordinary_income_305e4(stock, person, amount);
}
