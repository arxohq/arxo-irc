// Section 312 (E&P adjustments) scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S312-01-CASH-DISTRIBUTION-REDUCES-EP" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": earnings_and_profits_charge_money(entity_ref("urn:test:s312:c1#dist"), 10000.00 USD) { origin case_input; }
        assert "f1": earnings_and_profits_charge_obligations(entity_ref("urn:test:s312:c1#dist"), 0.00 USD) { origin case_input; }
        assert "f2": earnings_and_profits_charge_property_basis(entity_ref("urn:test:s312:c1#dist"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(earnings_and_profits_reduction_312a(entity_ref("urn:test:s312:c1#dist"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S312-02-APPRECIATED-PROPERTY-INCREASES-EP" {
    given {
        context {
            legal_time @2024-06-01;
