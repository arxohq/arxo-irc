            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distributed_property_fmv_312b(entity_ref("urn:test:s312:c2#dist"), 50000.00 USD, 30000.00 USD) { origin case_input; }
    }
    evaluate truth(earnings_and_profits_appreciation_312b(entity_ref("urn:test:s312:c2#dist"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

