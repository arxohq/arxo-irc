test "S312-K-01-DEPRECIATION-ADJUSTMENT-IS-EXCESS-OVER-STRAIGHT-LINE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": depreciation_allowed_for_regular_tax(entity_ref("urn:test:s312:c4#corp"), entity_ref("urn:test:s312:c4#y2024"), entity_ref("urn:test:s312:c4#asset"), 15000.00 USD) { origin case_input; }
        assert "f1": depreciation_straight_line_for_ep(entity_ref("urn:test:s312:c4#corp"), entity_ref("urn:test:s312:c4#y2024"), entity_ref("urn:test:s312:c4#asset"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(earnings_and_profits_depreciation_adjustment_312k(entity_ref("urn:test:s312:c4#corp"), entity_ref("urn:test:s312:c4#y2024"), entity_ref("urn:test:s312:c4#asset"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
