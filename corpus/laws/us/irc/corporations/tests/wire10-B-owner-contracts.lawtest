// Corporations WIRE-10 group B scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "W10B-CO-01-TRANSFEROR-US-PERSON-FROM-DEFINITIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": transferor_of_exchange_367(entity_ref("urn:test:w10b:c1#x"), entity_ref("urn:test:w10b:c1#p")) { origin case_input; }
        assert "f1": us.irc.definitions::united_states_person(entity_ref("urn:test:w10b:c1#p")) { origin case_input; }
    }
    evaluate truth(transferor_is_united_states_person_367(entity_ref("urn:test:w10b:c1#x")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-CO-02-TRANSFEROR-WITHOUT-US-PERSON-STATUS-IS-NOT-DERIVED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": transferor_of_exchange_367(entity_ref("urn:test:w10b:c2#x"), entity_ref("urn:test:w10b:c2#p")) { origin case_input; }
    }
    evaluate truth(transferor_is_united_states_person_367(entity_ref("urn:test:w10b:c2#x")));
    expect truth_status == NEITHER;
}

test "W10B-CO-03-TRANSFEROR-FACT-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": transferor_is_united_states_person_367(entity_ref("urn:test:w10b:c3#x")) { origin case_input; }
    }
    evaluate truth(transferor_is_united_states_person_367(entity_ref("urn:test:w10b:c3#x")));
    expect truth_status == TRUE_ONLY;
}
