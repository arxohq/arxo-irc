        assert "f0": change_month_382f(entity_ref("urn:test:s382f:c3#oc"), "2026-08") { origin case_input; }
    }
    evaluate truth(adjusted_federal_long_term_rate_from_table_382f(entity_ref("urn:test:s382f:c3#oc"), "2026-08", 0.0372));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

