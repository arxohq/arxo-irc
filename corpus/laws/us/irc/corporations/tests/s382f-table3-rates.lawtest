// Section 382(f) Table 3 scenarios: the long-term tax-exempt rate (f)(1)
// and the adjusted Federal long-term rate (f)(2) read from the pinned
// us.irs.rev_rul_afr Table 3 for a pinned month, and no derivation for a
// month absent from the month-index (the case-fact path
// long_term_tax_exempt_rate_382b1 keeps serving those months).
//
// NOT EXECUTED in this session (IRC-G Table 3 wiring, 2026-09-27): scenarios
// are registered in law.toml; execution (step 6) runs only with owner
// permission, same gate as the Table 1 consumer wirings (which carry no
// scenarios yet). Coverage rows 26/382/f/u1, 26/382/f/1/u1, 26/382/f/2/u1-u3
// reference these scenario names with classification unchanged.

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S382F-T3-01-TAX-EXEMPT-RATE-FROM-PINNED-TABLE" {
    given {
        context {
            legal_time @2026-10-15;
            decision_time @2026-10-15T09:00:00-05:00;
            knowledge_time @2026-10-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": change_month_382f(entity_ref("urn:test:s382f:c1#oc"), "2026-10") { origin case_input; }
    }
    evaluate truth(long_term_tax_exempt_rate_from_table_382f(entity_ref("urn:test:s382f:c1#oc"), "2026-10", 0.0395));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S382F-T3-02-UNPINNED-MONTH-NO-TAX-EXEMPT-RATE" {
    given {
        context {
            legal_time @2026-10-15;
            decision_time @2026-10-15T09:00:00-05:00;
            knowledge_time @2026-10-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": change_month_382f(entity_ref("urn:test:s382f:c2#oc"), "2026-09") { origin case_input; }
    }
    evaluate truth(long_term_tax_exempt_rate_from_table_382f(entity_ref("urn:test:s382f:c2#oc"), "2026-09", 0.0395));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

