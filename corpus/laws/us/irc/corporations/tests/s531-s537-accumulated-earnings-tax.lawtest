// Sections 531-537 (accumulated earnings tax) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S531-01-20-PERCENT-TAX-ON-ACCUMULATED-TAXABLE-INCOME" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": corporation_described_in_532(entity_ref("urn:test:s531:c1#corp"), entity_ref("urn:test:s531:c1#y")) { origin case_input; }
        assert "f1": accumulated_taxable_income(entity_ref("urn:test:s531:c1#corp"), entity_ref("urn:test:s531:c1#y"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(accumulated_earnings_tax(entity_ref("urn:test:s531:c1#corp"), entity_ref("urn:test:s531:c1#y"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S533A-01-UNREASONABLE-ACCUMULATION-PRESUMED-AVOIDANCE-PURPOSE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": earnings_permitted_to_accumulate_beyond_reasonable_needs(entity_ref("urn:test:s533a:c1#corp"), entity_ref("urn:test:s533a:c1#y")) { origin case_input; }
    }
    evaluate truth(formed_or_availed_for_tax_avoidance_532a(entity_ref("urn:test:s533a:c1#corp"), entity_ref("urn:test:s533a:c1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S533A-02-PREPONDERANCE-OF-EVIDENCE-REBUTS-PRESUMPTION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": earnings_permitted_to_accumulate_beyond_reasonable_needs(entity_ref("urn:test:s533a:c2#corp"), entity_ref("urn:test:s533a:c2#y")) { origin case_input; }
        assert "f1": corporation_proves_no_avoidance_purpose_by_preponderance(entity_ref("urn:test:s533a:c2#corp"), entity_ref("urn:test:s533a:c2#y")) { origin case_input; }
    }
    evaluate truth(formed_or_availed_for_tax_avoidance_532a(entity_ref("urn:test:s533a:c2#corp"), entity_ref("urn:test:s533a:c2#y")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
