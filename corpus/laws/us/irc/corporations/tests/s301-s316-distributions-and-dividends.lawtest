// Sections 301, 316, 317 scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

// Full three-tier scenario: distribution of 12,000, E&P of 5,000
// (current 2,000 + accumulated 3,000), stock basis 4,000.
//   dividend = 5,000 (the E&P ceiling)
//   non-dividend portion = 12,000 - 5,000 = 7,000
//   return of basis = 4,000 (the whole basis)
//   gain = 7,000 - 4,000 = 3,000
test "S301-01-THREE-TIER-DISTRIBUTION-EXCEEDING-EP-AND-BASIS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution(entity_ref("urn:test:s301:t1#dist"), entity_ref("urn:test:s301:t1#corp"), entity_ref("urn:test:s301:t1#sh"), @2024-06-01) { origin case_input; }
        assert "f1": money_received_in_distribution(entity_ref("urn:test:s301:t1#dist"), 12000.00 USD) { origin case_input; }
        assert "f2": fmv_of_property_in_distribution(entity_ref("urn:test:s301:t1#dist"), 0.00 USD) { origin case_input; }
        assert "f3": liability_assumed_by_shareholder(entity_ref("urn:test:s301:t1#dist"), 0.00 USD) { origin case_input; }
        assert "f4": liability_on_property_received(entity_ref("urn:test:s301:t1#dist"), 0.00 USD) { origin case_input; }
        assert "f5": distribution_in_year(entity_ref("urn:test:s301:t1#dist"), entity_ref("urn:test:s301:t1#y")) { origin case_input; }
        assert "f6": earnings_and_profits_current(entity_ref("urn:test:s301:t1#corp"), entity_ref("urn:test:s301:t1#y"), 2000.00 USD) { origin case_input; }
        assert "f7": earnings_and_profits_accumulated(entity_ref("urn:test:s301:t1#corp"), @2024-06-01, 3000.00 USD) { origin case_input; }
        assert "f8": stock_basis(entity_ref("urn:test:s301:t1#sh"), entity_ref("urn:test:s301:t1#corp"), @2024-06-01, 4000.00 USD) { origin case_input; }
    }
    evaluate truth(dividend_amount(entity_ref("urn:test:s301:t1#dist"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
