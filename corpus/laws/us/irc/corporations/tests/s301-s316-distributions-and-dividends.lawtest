// Distribution fully covered by E&P: entirely a dividend, no basis/gain tiers.
test "S301-04-DISTRIBUTION-FULLY-WITHIN-EP-IS-ALL-DIVIDEND" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution(entity_ref("urn:test:s301:t2#dist"), entity_ref("urn:test:s301:t2#corp"), entity_ref("urn:test:s301:t2#sh"), @2024-06-01) { origin case_input; }
        assert "f1": money_received_in_distribution(entity_ref("urn:test:s301:t2#dist"), 3000.00 USD) { origin case_input; }
        assert "f2": fmv_of_property_in_distribution(entity_ref("urn:test:s301:t2#dist"), 0.00 USD) { origin case_input; }
        assert "f3": liability_assumed_by_shareholder(entity_ref("urn:test:s301:t2#dist"), 0.00 USD) { origin case_input; }
        assert "f4": liability_on_property_received(entity_ref("urn:test:s301:t2#dist"), 0.00 USD) { origin case_input; }
        assert "f5": distribution_in_year(entity_ref("urn:test:s301:t2#dist"), entity_ref("urn:test:s301:t2#y")) { origin case_input; }
        assert "f6": earnings_and_profits_current(entity_ref("urn:test:s301:t2#corp"), entity_ref("urn:test:s301:t2#y"), 2000.00 USD) { origin case_input; }
        assert "f7": earnings_and_profits_accumulated(entity_ref("urn:test:s301:t2#corp"), @2024-06-01, 3000.00 USD) { origin case_input; }
        assert "f8": stock_basis(entity_ref("urn:test:s301:t2#sh"), entity_ref("urn:test:s301:t2#corp"), @2024-06-01, 4000.00 USD) { origin case_input; }
    }
    evaluate truth(dividend_amount(entity_ref("urn:test:s301:t2#dist"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Section 301(b)(2): liabilities reduce the amount distributed, floored at zero.
test "S301-05-LIABILITY-REDUCTION-FLOORED-AT-ZERO" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": money_received_in_distribution(entity_ref("urn:test:s301:lb1#dist"), 1000.00 USD) { origin case_input; }
        assert "f1": fmv_of_property_in_distribution(entity_ref("urn:test:s301:lb1#dist"), 0.00 USD) { origin case_input; }
        assert "f2": liability_assumed_by_shareholder(entity_ref("urn:test:s301:lb1#dist"), 1500.00 USD) { origin case_input; }
        assert "f3": liability_on_property_received(entity_ref("urn:test:s301:lb1#dist"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(amount_distributed(entity_ref("urn:test:s301:lb1#dist"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Section 316(a): E&P unknown (neither current nor accumulated asserted) —
// the dividend ceiling, and so the dividend amount, is UNDETERMINED, not
// zero. Feeds why_not per the PLAN task's "unknown E&P -> NEITHER" scenario.
test "S316-01-UNKNOWN-EP-GIVES-UNDETERMINED-DIVIDEND" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution(entity_ref("urn:test:s316:u1#dist"), entity_ref("urn:test:s316:u1#corp"), entity_ref("urn:test:s316:u1#sh"), @2024-06-01) { origin case_input; }
        assert "f1": money_received_in_distribution(entity_ref("urn:test:s316:u1#dist"), 5000.00 USD) { origin case_input; }
        assert "f2": fmv_of_property_in_distribution(entity_ref("urn:test:s316:u1#dist"), 0.00 USD) { origin case_input; }
        assert "f3": liability_assumed_by_shareholder(entity_ref("urn:test:s316:u1#dist"), 0.00 USD) { origin case_input; }
        assert "f4": liability_on_property_received(entity_ref("urn:test:s316:u1#dist"), 0.00 USD) { origin case_input; }
        // deliberately no E&P facts asserted
    }
    evaluate truth(dividend_amount(entity_ref("urn:test:s316:u1#dist"), 5000.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
