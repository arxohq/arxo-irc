// PHC income 100000.00 equals 10 percent of OGI 1000000.00: no excess, nothing to distribute.
test "S543D5-01-NO-EXCESS-OVER-10-PERCENT-REQUIREMENT-MET" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": personal_holding_company_income_amount_543a(entity_ref("urn:test:s543d:c1#c"), entity_ref("urn:test:s543d:c1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": ordinary_gross_income_543d(entity_ref("urn:test:s543d:c1#c"), entity_ref("urn:test:s543d:c1#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": amounts_described_in_543a1c_543d5(entity_ref("urn:test:s543d:c1#c"), entity_ref("urn:test:s543d:c1#y"), 0.00 USD) { origin case_input; }
