// Section 543(d) (active business computer software royalties; Pub. L. 119-21 section 70302 edition split) scenarios. NOT EXECUTED (implemented_unverified: stage 3, 26.09.2026,
// owner restriction: no mass .lawtest execution, no differential). Expectations
// come from the statutory text and its arithmetic, not from engine output.

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S543D2-01-ACTIVE-CONDUCT-AND-OWN-SOFTWARE-REQUIREMENT-MET" {
    given {
        context {
            legal_time @2025-08-01;
            decision_time @2025-08-01T09:00:00-05:00;
            knowledge_time @2025-08-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": computer_software_royalties_received_543d1(entity_ref("urn:test:s543d:a1#c"), entity_ref("urn:test:s543d:a1#y"), 600000.00 USD) { origin case_input; }
        assert "f1": engaged_in_active_conduct_of_computer_software_business_543d2a(entity_ref("urn:test:s543d:a1#c"), entity_ref("urn:test:s543d:a1#y")) { origin case_input; }
        assert "f2": software_developed_by_corporation_or_directly_related_543d2b(entity_ref("urn:test:s543d:a1#c"), entity_ref("urn:test:s543d:a1#y")) { origin case_input; }
    }
    evaluate truth(requirement_543d2_met(entity_ref("urn:test:s543d:a1#c"), entity_ref("urn:test:s543d:a1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

