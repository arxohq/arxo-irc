        assert "f2": deduction_under_section_162_allocable_543d4(entity_ref("urn:test:s543d:b3#c"), entity_ref("urn:test:s543d:b3#y"), 150000.00 USD) { origin case_input; }
        assert "f3": deduction_under_section_174_allocable_543d4(entity_ref("urn:test:s543d:b3#c"), entity_ref("urn:test:s543d:b3#y"), 40000.00 USD) { origin case_input; }
        assert "f4": deduction_under_section_174a_allocable_543d4(entity_ref("urn:test:s543d:b3#c"), entity_ref("urn:test:s543d:b3#y"), 60000.00 USD) { origin case_input; }
        assert "f5": deduction_under_section_195_allocable_543d4(entity_ref("urn:test:s543d:b3#c"), entity_ref("urn:test:s543d:b3#y"), 50000.00 USD) { origin case_input; }
        assert "f6": compensation_of_five_largest_shareholders_in_deductions_543d4c(entity_ref("urn:test:s543d:b3#c"), entity_ref("urn:test:s543d:b3#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(qualifying_deductions_543d4(entity_ref("urn:test:s543d:b3#c"), entity_ref("urn:test:s543d:b3#y"), 240000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

