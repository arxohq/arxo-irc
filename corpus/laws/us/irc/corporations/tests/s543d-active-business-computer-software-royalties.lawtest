// Read the day before Pub. L. 119-21 (4 July 2025): 174A is not in the sum: 150000 + 40000 + 50000 = 240000.
test "S543D4-01-BEFORE-ENACTMENT-SUM-OF-162-174-195-ONLY" {
    given {
        context {
            legal_time @2025-07-03;
            decision_time @2025-07-03T09:00:00-05:00;
            knowledge_time @2025-07-03T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s543d:b1#y"), @2024-01-01) { origin case_input; }
        assert "f1": ordinary_gross_income_543d(entity_ref("urn:test:s543d:b1#c"), entity_ref("urn:test:s543d:b1#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": deduction_under_section_162_allocable_543d4(entity_ref("urn:test:s543d:b1#c"), entity_ref("urn:test:s543d:b1#y"), 150000.00 USD) { origin case_input; }
        assert "f3": deduction_under_section_174_allocable_543d4(entity_ref("urn:test:s543d:b1#c"), entity_ref("urn:test:s543d:b1#y"), 40000.00 USD) { origin case_input; }
        assert "f4": deduction_under_section_174a_allocable_543d4(entity_ref("urn:test:s543d:b1#c"), entity_ref("urn:test:s543d:b1#y"), 60000.00 USD) { origin case_input; }
        assert "f5": deduction_under_section_195_allocable_543d4(entity_ref("urn:test:s543d:b1#c"), entity_ref("urn:test:s543d:b1#y"), 50000.00 USD) { origin case_input; }
        assert "f6": compensation_of_five_largest_shareholders_in_deductions_543d4c(entity_ref("urn:test:s543d:b1#c"), entity_ref("urn:test:s543d:b1#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(qualifying_deductions_543d4(entity_ref("urn:test:s543d:b1#c"), entity_ref("urn:test:s543d:b1#y"), 240000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Boundary: on the enactment date, for a year beginning 1 Jan 2025 (after 31 Dec 2024): 150000 + 40000 + 60000 + 50000 = 300000.
test "S543D4-02-ON-ENACTMENT-DATE-2025-YEAR-INCLUDES-174A" {
    given {
        context {
            legal_time @2025-07-04;
            decision_time @2025-07-04T09:00:00-05:00;
            knowledge_time @2025-07-04T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s543d:b2#y"), @2025-01-01) { origin case_input; }
        assert "f1": ordinary_gross_income_543d(entity_ref("urn:test:s543d:b2#c"), entity_ref("urn:test:s543d:b2#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": deduction_under_section_162_allocable_543d4(entity_ref("urn:test:s543d:b2#c"), entity_ref("urn:test:s543d:b2#y"), 150000.00 USD) { origin case_input; }
        assert "f3": deduction_under_section_174_allocable_543d4(entity_ref("urn:test:s543d:b2#c"), entity_ref("urn:test:s543d:b2#y"), 40000.00 USD) { origin case_input; }
        assert "f4": deduction_under_section_174a_allocable_543d4(entity_ref("urn:test:s543d:b2#c"), entity_ref("urn:test:s543d:b2#y"), 60000.00 USD) { origin case_input; }
        assert "f5": deduction_under_section_195_allocable_543d4(entity_ref("urn:test:s543d:b2#c"), entity_ref("urn:test:s543d:b2#y"), 50000.00 USD) { origin case_input; }
        assert "f6": compensation_of_five_largest_shareholders_in_deductions_543d4c(entity_ref("urn:test:s543d:b2#c"), entity_ref("urn:test:s543d:b2#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(qualifying_deductions_543d4(entity_ref("urn:test:s543d:b2#c"), entity_ref("urn:test:s543d:b2#y"), 300000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Read in 2026, a fiscal year that began 1 Jul 2024 is not after 31 Dec 2024: the old sum without 174A applies.
