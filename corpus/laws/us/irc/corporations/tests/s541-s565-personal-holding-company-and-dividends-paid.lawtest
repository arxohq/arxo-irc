// Sections 541-547, 561-565 (personal holding company tax, dividends paid
// deduction) scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S542A-01-60-PERCENT-AND-STOCK-OWNERSHIP-TESTS-MAKE-PHC" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adjusted_ordinary_gross_income_543b2(entity_ref("urn:test:s542a:c1#corp"), entity_ref("urn:test:s542a:c1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": personal_holding_company_income_amount_543a(entity_ref("urn:test:s542a:c1#corp"), entity_ref("urn:test:s542a:c1#y"), 70000.00 USD) { origin case_input; }
        assert "f2": five_or_fewer_combined_ownership_share_542a2(entity_ref("urn:test:s542a:c1#corp"), entity_ref("urn:test:s542a:c1#y"), 0.60) { origin case_input; }
    }
    evaluate truth(personal_holding_company(entity_ref("urn:test:s542a:c1#corp"), entity_ref("urn:test:s542a:c1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S542A-02-BELOW-60-PERCENT-AOGI-NOT-PHC" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adjusted_ordinary_gross_income_543b2(entity_ref("urn:test:s542a:c2#corp"), entity_ref("urn:test:s542a:c2#y"), 100000.00 USD) { origin case_input; }
        assert "f1": personal_holding_company_income_amount_543a(entity_ref("urn:test:s542a:c2#corp"), entity_ref("urn:test:s542a:c2#y"), 50000.00 USD) { origin case_input; }
        assert "f2": five_or_fewer_combined_ownership_share_542a2(entity_ref("urn:test:s542a:c2#corp"), entity_ref("urn:test:s542a:c2#y"), 0.60) { origin case_input; }
    }
    evaluate truth(personal_holding_company(entity_ref("urn:test:s542a:c2#corp"), entity_ref("urn:test:s542a:c2#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S563A-01-DIVIDEND-WITHIN-GRACE-PERIOD-CONSIDERED-PAID" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": dividend_paid_after_year_close(entity_ref("urn:test:s563a:c1#corp"), entity_ref("urn:test:s563a:c1#y"), @2023-12-31, @2024-03-01, 5000.00 USD) { origin case_input; }
    }
    evaluate truth(dividend_considered_paid_during_year_563a(entity_ref("urn:test:s563a:c1#corp"), entity_ref("urn:test:s563a:c1#y"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S561A-01-DEDUCTION-SUMS-PAID-AND-CONSENT-NON-PHC" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dividends_paid_during_year_561a1(entity_ref("urn:test:s561a:c1#corp"), entity_ref("urn:test:s561a:c1#y"), 30000.00 USD) { origin case_input; }
        assert "f1": consent_dividends_561a2(entity_ref("urn:test:s561a:c1#corp"), entity_ref("urn:test:s561a:c1#y"), 5000.00 USD) { origin case_input; }
    }
    evaluate truth(dividends_paid_deduction_561(entity_ref("urn:test:s561a:c1#corp"), entity_ref("urn:test:s561a:c1#y"), 35000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
