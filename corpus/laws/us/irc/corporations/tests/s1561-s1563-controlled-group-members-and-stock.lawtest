        assert "f2": restriction_applies_also_to_common_owner_stock_reciprocal_1563c2bii(entity_ref("urn:test:s1563:c2biii#st")) { origin case_input; }
    }
    evaluate truth(excluded_stock_1563c2(entity_ref("urn:test:s1563:c2biii#st")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}


