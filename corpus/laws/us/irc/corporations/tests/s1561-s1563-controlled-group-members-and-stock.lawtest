// Section 1563(f)(4): (A)-(F) all met: franchised corporation.
test "S1563F4-01-ALL-CONDITIONS-MET-EXCLUDED-MEMBER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": franchise_stock_sale_duty_1563f4a(entity_ref("urn:test:s1563:f4a#c")) { origin case_input; }
        assert "f1": bona_fide_elimination_plan_1563f4b(entity_ref("urn:test:s1563:f4a#c")) { origin adjudicated; }
        assert "f2": reasonable_selling_price_1563f4c1(entity_ref("urn:test:s1563:f4a#c")) { origin adjudicated; }
        assert "f3": plan_applies_profit_share_to_purchase_1563f4c2(entity_ref("urn:test:s1563:f4a#c")) { origin case_input; }
        assert "f4": employee_direct_value_share_1563f4d(entity_ref("urn:test:s1563:f4a#c"), 0.25) { origin case_input; }
        assert "f5": inventory_acquired_from_group_share_1563f4e(entity_ref("urn:test:s1563:f4a#c"), 0.6) { origin case_input; }
        assert "f6": days_all_franchise_conditions_met_1563f4f(entity_ref("urn:test:s1563:f4a#c"), @2024-12-31, 200) { origin case_input; }
        assert "f7": days_preceding_dec_31_in_year_1563f4f(entity_ref("urn:test:s1563:f4a#c"), @2024-12-31, 365) { origin case_input; }
    }
    evaluate truth(franchised_corporation_1563f4(entity_ref("urn:test:s1563:f4a#c"), @2024-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


