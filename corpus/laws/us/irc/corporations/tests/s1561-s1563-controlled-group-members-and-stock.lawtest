        }
        assert "f0": insurance_company_801_1563a4(entity_ref("urn:test:s1563:a4a#a")) { origin case_input; }
        assert "f1": member_of_controlled_group_1563(entity_ref("urn:test:s1563:a4a#cg"), entity_ref("urn:test:s1563:a4a#a")) { origin case_input; }
        assert "f2": insurer_roster_1563a4(entity_ref("urn:test:s1563:a4a#cg"), entity_ref("urn:test:s1563:a4a#a")) { origin case_input; }
        assert "f3": insurer_roster_1563a4(entity_ref("urn:test:s1563:a4a#cg"), entity_ref("urn:test:s1563:a4a#b")) { origin case_input; }
    }
    evaluate truth(insurance_subgroup_member_1563a4(entity_ref("urn:test:s1563:a4a#cg"), entity_ref("urn:test:s1563:a4a#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


