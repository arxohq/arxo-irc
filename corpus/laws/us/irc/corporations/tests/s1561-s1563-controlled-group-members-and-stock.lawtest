// Sections 1561(b), 1563(a)(3)-(4), (b), (c), (f)(3)-(4): short-year credit amount, combined and insurance groups, component members, excluded stock, franchised corporations
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 1563(a)(3): link parent L (in an (a)(1) group and an (a)(2) group), three corporations on the roster: subsidiary S is a combined member.
test "S1563A3-01-SUBSIDIARY-OF-THE-LINK-GROUP-IS-COMBINED-MEMBER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": parent_subsidiary_ownership_share(entity_ref("urn:test:s1563:a3a#g1"), entity_ref("urn:test:s1563:a3a#L"), entity_ref("urn:test:s1563:a3a#S"), 0.90, 0.90) { origin case_input; }
        assert "f1": five_or_fewer_owners_combined_voting_share(entity_ref("urn:test:s1563:a3a#g2"), entity_ref("urn:test:s1563:a3a#M"), 0.60) { origin case_input; }
        assert "f2": combined_link_1563a3(entity_ref("urn:test:s1563:a3a#cg"), entity_ref("urn:test:s1563:a3a#L"), entity_ref("urn:test:s1563:a3a#g1"), entity_ref("urn:test:s1563:a3a#g2")) { origin case_input; }
        assert "f3": controlled_group_candidate_member_1563a3(entity_ref("urn:test:s1563:a3a#cg"), entity_ref("urn:test:s1563:a3a#L")) { origin case_input; }
        assert "f4": controlled_group_candidate_member_1563a3(entity_ref("urn:test:s1563:a3a#cg"), entity_ref("urn:test:s1563:a3a#S")) { origin case_input; }
        assert "f5": controlled_group_candidate_member_1563a3(entity_ref("urn:test:s1563:a3a#cg"), entity_ref("urn:test:s1563:a3a#M")) { origin case_input; }
    }
    evaluate truth(combined_group_member_1563a3(entity_ref("urn:test:s1563:a3a#cg"), entity_ref("urn:test:s1563:a3a#S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


