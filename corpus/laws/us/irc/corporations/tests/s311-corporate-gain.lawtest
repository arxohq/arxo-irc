// Section 311 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S311-01-CORPORATE-GAIN-ON-APPRECIATED-PROPERTY" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution(entity_ref("urn:test:s311:g1#dist"), entity_ref("urn:test:s311:g1#corp"), entity_ref("urn:test:s311:g1#sh"), @2024-06-01) { origin case_input; }
        assert "f1": distribution_not_in_complete_liquidation(entity_ref("urn:test:s311:g1#dist")) { origin case_input; }
        assert "f2": fmv_of_property_in_distribution(entity_ref("urn:test:s311:g1#dist"), 10000.00 USD) { origin case_input; }
        assert "f3": corp_adjusted_basis_of_distributed_property(entity_ref("urn:test:s311:g1#dist"), 6000.00 USD) { origin case_input; }
    }
    evaluate truth(corp_gain_on_distribution(entity_ref("urn:test:s311:g1#dist"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S311-02-NO-LOSS-ON-DEPRECIATED-PROPERTY" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution(entity_ref("urn:test:s311:l1#dist"), entity_ref("urn:test:s311:l1#corp"), entity_ref("urn:test:s311:l1#sh"), @2024-06-01) { origin case_input; }
        assert "f1": distribution_not_in_complete_liquidation(entity_ref("urn:test:s311:l1#dist")) { origin case_input; }
        assert "f2": fmv_of_property_in_distribution(entity_ref("urn:test:s311:l1#dist"), 4000.00 USD) { origin case_input; }
        assert "f3": corp_adjusted_basis_of_distributed_property(entity_ref("urn:test:s311:l1#dist"), 6000.00 USD) { origin case_input; }
    }
    // section 311(a): no loss to the corporation even though FMV < basis.
    evaluate truth(corp_no_loss_recognized_on_distribution(entity_ref("urn:test:s311:l1#dist")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(corp_gain_on_distribution(entity_ref("urn:test:s311:l1#dist"), 0.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
