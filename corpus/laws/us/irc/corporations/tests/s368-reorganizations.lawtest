// Section 368(a)-(b) (reorganization types, party to a reorganization)
// scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF
// NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S368A-01-STATUTORY-MERGER-IS-TYPE-A" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": statutory_merger_or_consolidation(entity_ref("urn:test:s368a:c1#r"), entity_ref("urn:test:s368a:c1#acquiring"), entity_ref("urn:test:s368a:c1#target")) { origin case_input; }
    }
    evaluate truth(reorganization(entity_ref("urn:test:s368a:c1#r"), TypeAStatutoryMergerOrConsolidation));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S368A-02-SUBSTANTIALLY-ALL-WITH-20-PERCENT-BOOT-STILL-TYPE-C" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": acquisition_of_substantially_all_properties(entity_ref("urn:test:s368a:c2#r"), entity_ref("urn:test:s368a:c2#acquiring"), entity_ref("urn:test:s368a:c2#target")) { origin case_input; }
        assert "f1": acquisition_with_boot(entity_ref("urn:test:s368a:c2#r"), entity_ref("urn:test:s368a:c2#acquiring"), entity_ref("urn:test:s368a:c2#target")) { origin case_input; }
        assert "f2": stock_only_acquisition_fmv_share(entity_ref("urn:test:s368a:c2#r"), 0.82) { origin case_input; }
    }
    evaluate truth(reorganization(entity_ref("urn:test:s368a:c2#r"), TypeCSubstantiallyAllForVotingStock));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S368A-03-BELOW-80-PERCENT-BOOT-ALLOWANCE-FAILS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": acquisition_of_substantially_all_properties(entity_ref("urn:test:s368a:c3#r"), entity_ref("urn:test:s368a:c3#acquiring"), entity_ref("urn:test:s368a:c3#target")) { origin case_input; }
        assert "f1": acquisition_with_boot(entity_ref("urn:test:s368a:c3#r"), entity_ref("urn:test:s368a:c3#acquiring"), entity_ref("urn:test:s368a:c3#target")) { origin case_input; }
        assert "f2": stock_only_acquisition_fmv_share(entity_ref("urn:test:s368a:c3#r"), 0.75) { origin case_input; }
    }
    evaluate truth(reorganization(entity_ref("urn:test:s368a:c3#r"), TypeCSubstantiallyAllForVotingStock));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S368B-01-PARTY-TO-REORGANIZATION-FROM-RESULT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": statutory_merger_or_consolidation(entity_ref("urn:test:s368b:c1#r"), entity_ref("urn:test:s368b:c1#acquiring"), entity_ref("urn:test:s368b:c1#target")) { origin case_input; }
        assert "f1": corporation_resulting_from_reorganization(entity_ref("urn:test:s368b:c1#r"), entity_ref("urn:test:s368b:c1#surviving")) { origin case_input; }
    }
    evaluate truth(party_to_a_reorganization(entity_ref("urn:test:s368b:c1#r"), entity_ref("urn:test:s368b:c1#surviving")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
