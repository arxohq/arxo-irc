// Section 338 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF
// NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S338G-01-DEADLINE-IS-15TH-DAY-OF-9TH-MONTH" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": stock_acquired_by_purchase_in_12_month_period(entity_ref("urn:test:s338g:c1#purchasing"), entity_ref("urn:test:s338g:c1#target"), @2024-03-15) { origin case_input; }
        assert "f1": meets_1504a2_ownership(entity_ref("urn:test:s338g:c1#purchasing"), entity_ref("urn:test:s338g:c1#target"), @2024-03-15) { origin case_input; }
        assert "f2": first_day_of_acquisition_month(@2024-03-15, @2024-03-01) { origin case_input; }
    }
    evaluate truth(section_338g_deadline(entity_ref("urn:test:s338g:c1#purchasing"), entity_ref("urn:test:s338g:c1#target"), @2024-03-15, @2024-12-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S338B4-01-GROSSED-UP-BASIS-100-PERCENT-RECENTLY-PURCHASED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": recently_purchased_stock_basis(entity_ref("urn:test:s338b4:c1#e"), 1000000.00 USD) { origin case_input; }
        assert "f1": recently_purchased_stock_value_percentage(entity_ref("urn:test:s338b4:c1#e"), 1.0) { origin case_input; }
        assert "f2": nonrecently_purchased_stock_value_percentage(entity_ref("urn:test:s338b4:c1#e"), 0.0) { origin case_input; }
    }
    evaluate truth(grossed_up_basis_338b4(entity_ref("urn:test:s338b4:c1#e"), 1000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
