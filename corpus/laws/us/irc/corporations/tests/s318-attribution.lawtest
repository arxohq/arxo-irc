// Section 318 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

// Family attribution chain of three persons: grandparent <- parent (child of
// grandparent) <- grandchild, each holding direct stock, per section
// 318(a)(1)(A)(ii). Tests that EACH pairwise hop attributes correctly
// without chaining a second family hop (the (5)(A)/(B) no-double-family-
// attribution limit — this module does not derive family-of-family).
test "S318-01-FAMILY-ATTRIBUTION-PARENT-FROM-CHILD" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": child_grandchild_or_parent_of(entity_ref("urn:test:s318:fam1#child"), entity_ref("urn:test:s318:fam1#parent")) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s318:fam1#oi"), entity_ref("urn:test:s318:fam1#child"), entity_ref("urn:test:s318:fam1#corp"), 0.30) { origin case_input; }
    }
    evaluate truth(constructive_ownership(entity_ref("urn:test:s318:fam1#parent"), entity_ref("urn:test:s318:fam1#corp"), 0.30, Family));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S318-02-NO-DOUBLE-FAMILY-ATTRIBUTION" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // grandparent <- (family) <- parent <- (family) <- grandchild:
        // grandchild's own DIRECT stock attributes to parent (section
        // 318(a)(1)(A)(ii)); it must NOT re-attribute a second hop from
        // parent to grandparent as "family" stock of the grandparent,
        // since this module reads only direct ownership_interest, never
        // constructive_ownership(..., Family), for the family rules.
        assert "f0": child_grandchild_or_parent_of(entity_ref("urn:test:s318:fam2#grandchild"), entity_ref("urn:test:s318:fam2#parent")) { origin case_input; }
        assert "f1": child_grandchild_or_parent_of(entity_ref("urn:test:s318:fam2#parent"), entity_ref("urn:test:s318:fam2#grandparent")) { origin case_input; }
        assert "f2": us.irc.core::ownership_interest(entity_ref("urn:test:s318:fam2#oi"), entity_ref("urn:test:s318:fam2#grandchild"), entity_ref("urn:test:s318:fam2#corp"), 0.20) { origin case_input; }
    }
    // parent IS attributed the grandchild's 0.20 share (one hop).
    evaluate truth(constructive_ownership(entity_ref("urn:test:s318:fam2#parent"), entity_ref("urn:test:s318:fam2#corp"), 0.20, Family));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    // grandparent is NOT attributed that same share through a second family
    // hop off of parent's (family-derived) constructive ownership — this
    // module derives no such fact (documented under-approximation, see
    // module 03's file header and TECH-GAPS.md).
    evaluate truth(constructive_ownership(entity_ref("urn:test:s318:fam2#grandparent"), entity_ref("urn:test:s318:fam2#corp"), 0.20, Family));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S318-03-SPOUSE-ATTRIBUTION-BLOCKED-BY-LEGAL-SEPARATION" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": spouse_of(entity_ref("urn:test:s318:sp1#spouse"), entity_ref("urn:test:s318:sp1#ind")) { origin case_input; }
        assert "f1": legally_separated_spouse(entity_ref("urn:test:s318:sp1#spouse"), entity_ref("urn:test:s318:sp1#ind")) { origin case_input; }
        assert "f2": us.irc.core::ownership_interest(entity_ref("urn:test:s318:sp1#oi"), entity_ref("urn:test:s318:sp1#spouse"), entity_ref("urn:test:s318:sp1#corp"), 0.40) { origin case_input; }
    }
    evaluate truth(constructive_ownership(entity_ref("urn:test:s318:sp1#ind"), entity_ref("urn:test:s318:sp1#corp"), 0.40, Family));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S318-04-PARTNER-ATTRIBUTION-FROM-PARTNERSHIP-PROPORTIONATE" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": partner_of(entity_ref("urn:test:s318:pt1#partner"), entity_ref("urn:test:s318:pt1#pship"), 0.25) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s318:pt1#oi"), entity_ref("urn:test:s318:pt1#pship"), entity_ref("urn:test:s318:pt1#corp"), 0.80) { origin case_input; }
    }
    // 0.80 * 0.25 = 0.20
    evaluate truth(constructive_ownership(entity_ref("urn:test:s318:pt1#partner"), entity_ref("urn:test:s318:pt1#corp"), 0.20, FromEntity));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S318-05-OPTION-ATTRIBUTION" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": option_to_acquire_stock(entity_ref("urn:test:s318:op1#holder"), entity_ref("urn:test:s318:op1#corp"), 0.15) { origin case_input; }
    }
    evaluate truth(constructive_ownership(entity_ref("urn:test:s318:op1#holder"), entity_ref("urn:test:s318:op1#corp"), 0.15, Option));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
