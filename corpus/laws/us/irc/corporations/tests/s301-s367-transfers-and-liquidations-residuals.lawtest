// Section 311(b)(3): with the regulation the 12000 contributed-property loss is added back: 42000.
test "S311B3-01-GAIN-WITHOUT-REGARD-TO-CONTRIBUTED-LOSS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": distributed_property_is_partnership_or_trust_interest_311b3(entity_ref("urn:test:s311:a#d")) { origin case_input; }
        assert "f1": secretary_provides_311b3_regulation(entity_ref("urn:test:s311:a#d")) { origin case_input; }
        assert "f2": gain_under_311b1_with_contributed_loss_311b3(entity_ref("urn:test:s311:a#d"), 30000.00 USD, 12000.00 USD) { origin case_input; }
    }
    evaluate truth(gain_disregarding_contributed_loss_311b3(entity_ref("urn:test:s311:a#d"), 42000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


