        assert "f2": owned_continuously_from_plan_adoption(entity_ref("urn:test:s337:b1#o"), entity_ref("urn:test:s337:b1#sub"), @2024-01-01, @2024-03-01) { origin case_input; }
        assert "f3": transfer_completed_within_taxable_year(entity_ref("urn:test:s337:b1#liq"), entity_ref("urn:test:s337:b1#y")) { origin case_input; }
        assert "f4": indebted_to_80_percent_distributee_on_plan_date_337b1(entity_ref("urn:test:s337:b1#liq"), entity_ref("urn:test:s337:b1#o")) { origin case_input; }
