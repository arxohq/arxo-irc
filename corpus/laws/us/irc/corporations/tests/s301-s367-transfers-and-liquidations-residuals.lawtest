// Section 316(b)(2)(A)(i): distribution 1000 above undistributed income 600: dividend 600.
test "S316B2A-01-DISTRIBUTION-CAPPED-AT-UNDISTRIBUTED-INCOME" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": distribution_of_property_316b2(entity_ref("urn:test:s316:a#d"), entity_ref("urn:test:s316:a#c"), entity_ref("urn:test:s316:a#y"), 1000.00 USD) { origin case_input; }
        assert "f1": uphci_without_316b2_distributions(entity_ref("urn:test:s316:a#c"), entity_ref("urn:test:s316:a#y"), 600.00 USD) { origin case_input; }
        assert "f2": personal_holding_company_for_year_of_distribution_316b2ai(entity_ref("urn:test:s316:a#c"), entity_ref("urn:test:s316:a#y")) { origin case_input; }
    }
    evaluate truth(phc_dividend_316b2a(entity_ref("urn:test:s316:a#d"), 600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


