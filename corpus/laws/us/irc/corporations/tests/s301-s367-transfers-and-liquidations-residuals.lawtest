            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": amount_to_noncorporate_distributees_316b2bi(entity_ref("urn:test:s316:f#d"), 500.00 USD) { origin case_input; }
        assert "f1": allocable_share_of_uphci_316b2biii(entity_ref("urn:test:s316:f#d"), 700.00 USD) { origin case_input; }
        assert "f2": designated_and_notified_as_dividend_316b2bii(entity_ref("urn:test:s316:f#d")) { origin case_input; }
        assert "f3": liquidation_within_24_months_316b2b(entity_ref("urn:test:s316:f#d")) { origin case_input; }
    }
    evaluate truth(phc_liquidation_dividend_316b2b(entity_ref("urn:test:s316:f#d"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


