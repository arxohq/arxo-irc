// Residuals of Parts I and II: sections 301(c)(3)(B), 311(b)(3), 316(b), 332(c), 336(d)(2),(e), 337(b),(d), 351(c),(e),(g), 354(c), 356(c)-(f), 357(c)(3),(d), 367(d)(2)(A)(i)
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 301(c)(3)(B): excess over basis 6000; pre-1913 part 2000 is exempt.
test "S301C3B-01-PRE-1913-PART-OF-THE-EXCESS-EXEMPT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": distribution(entity_ref("urn:test:s301:a#d"), entity_ref("urn:test:s301:a#c"), entity_ref("urn:test:s301:a#sh"), @2024-06-01) { origin case_input; }
        assert "f1": amount_distributed(entity_ref("urn:test:s301:a#d"), 10000.00 USD) { origin case_input; }
        assert "f2": dividend_ceiling(entity_ref("urn:test:s301:a#d"), 0.00 USD) { origin case_input; }
        assert "f3": stock_basis(entity_ref("urn:test:s301:a#sh"), entity_ref("urn:test:s301:a#c"), @2024-06-01, 4000.00 USD) { origin case_input; }
        assert "f4": distribution_out_of_pre_1913_increase_in_value_301c3b(entity_ref("urn:test:s301:a#d"), 2000.00 USD) { origin case_input; }
    }
    evaluate truth(pre_1913_excess_exempt_from_tax_301c3b(entity_ref("urn:test:s301:a#d"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


