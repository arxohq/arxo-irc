// Sections 1502, 1503, 1504(a)(3)-(5), (b)-(f): consolidated return regulations, governing regulation, insurer loss rule, dual consolidated loss, intragroup stock basis, preferred dividend limitation, reconsolidation bar, includible corporations
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 1502: the Secretary prescribes a regulation that clearly reflects income: valid exercise.
test "S1502-01-REGULATION-POWER-VALIDLY-EXERCISED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": secretary_prescribes_1502_regulation(entity_ref("urn:test:s1502:a#reg")) { origin case_input; }
        assert "f1": regulation_clearly_reflects_income_or_prevents_avoidance_1502(entity_ref("urn:test:s1502:a#reg")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1502RegulationPower, VALIDLY_EXERCISED);
}


// The valid exercise puts the regulation in force.
test "S1502-02-REGULATION-IN-FORCE-AFTER-VALID-EXERCISE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": secretary_prescribes_1502_regulation(entity_ref("urn:test:s1502:b#reg")) { origin case_input; }
        assert "f1": regulation_clearly_reflects_income_or_prevents_avoidance_1502(entity_ref("urn:test:s1502:b#reg")) { origin case_input; }
    }
    evaluate truth(section_1502_regulation_in_force(entity_ref("urn:test:s1502:b#reg")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


// A regulation that neither reflects income nor prevents avoidance: invalid exercise, no effect.
test "S1502-03-REGULATION-NOT-SERVING-THE-PURPOSE-INVALID" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
