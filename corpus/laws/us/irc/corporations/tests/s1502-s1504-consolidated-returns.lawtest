// Second sentence: the Secretary is at liberty to prescribe rules different from separate-return rules.
test "S1502-05-SECRETARY-MAY-PRESCRIBE-DIFFERENT-RULES" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": common_parent_of(entity_ref("urn:test:s1502:e#grp"), entity_ref("urn:test:s1502:e#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(SecretaryMayPrescribeRulesDifferentFromSeparateReturns1502, ACTIVE);
}


// Section 1503(a): regulation prescribed 2024-03-01 before the last filing day 2024-04-15 governs.
test "S1503A-01-REGULATION-BEFORE-DUE-DATE-GOVERNS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": makes_consolidated_return(entity_ref("urn:test:s1503:a1#grp"), entity_ref("urn:test:s1503:a1#y")) { origin case_input; }
        assert "f1": consolidated_return_due_date_1503(entity_ref("urn:test:s1503:a1#grp"), entity_ref("urn:test:s1503:a1#y"), @2024-04-15) { origin case_input; }
        assert "f2": regulation_prescribed_on_1502(entity_ref("urn:test:s1503:a1#reg"), @2024-03-01) { origin case_input; }
        assert "f3": secretary_prescribes_1502_regulation(entity_ref("urn:test:s1503:a1#reg")) { origin case_input; }
        assert "f4": regulation_clearly_reflects_income_or_prevents_avoidance_1502(entity_ref("urn:test:s1503:a1#reg")) { origin case_input; }
    }
    evaluate truth(tax_governed_by_1502_regulation_1503a(entity_ref("urn:test:s1503:a1#grp"), entity_ref("urn:test:s1503:a1#y"), entity_ref("urn:test:s1503:a1#reg")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


