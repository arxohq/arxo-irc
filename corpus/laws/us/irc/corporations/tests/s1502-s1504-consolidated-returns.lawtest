// Section 1503(e)(4): a regulation that permits the reduction is a breach by the Secretary.
test "S1503E4-01-REGULATION-PERMITTING-ELA-REDUCTION-VIOLATES-BAR" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": secretary_prescribes_1502_regulation(entity_ref("urn:test:s1503:e10#reg")) { origin case_input; }
        assert "f1": regulation_clearly_reflects_income_or_prevents_avoidance_1502(entity_ref("urn:test:s1503:e10#reg")) { origin case_input; }
        assert "f2": regulation_permits_ela_reduction_for_indebtedness_basis_1503e4(entity_ref("urn:test:s1503:e10#reg")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1503e4RegulationMustNotPermitBar, VIOLATED);
}


