        assert "f1": maintained_solely_to_comply_with_foreign_property_law_1504d(entity_ref("urn:test:s1504:d5#fo")) { origin case_input; }
        assert "f2": domestic_elects_domestic_treatment_1504d(entity_ref("urn:test:s1504:d5#dom"), entity_ref("urn:test:s1504:d5#fo")) { origin case_input; }
    }
    evaluate truth(treated_as_domestic_corporation_1504d(entity_ref("urn:test:s1504:d5#fo")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}


// With the option the foreign corporation is includible under (b).
test "S1504D-06-OPTION-LIFTS-THE-FOREIGN-EXCLUSION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": capital_stock_share_excluding_directors_shares_1504d(entity_ref("urn:test:s1504:d6#dom"), entity_ref("urn:test:s1504:d6#fo"), 1.0) { origin case_input; }
        assert "f1": organized_in_contiguous_foreign_country_1504d(entity_ref("urn:test:s1504:d6#fo")) { origin case_input; }
        assert "f2": maintained_solely_to_comply_with_foreign_property_law_1504d(entity_ref("urn:test:s1504:d6#fo")) { origin case_input; }
        assert "f3": domestic_elects_domestic_treatment_1504d(entity_ref("urn:test:s1504:d6#dom"), entity_ref("urn:test:s1504:d6#fo")) { origin case_input; }
        assert "f4": corporation_tested_for_1504b(entity_ref("urn:test:s1504:d6#fo")) { origin case_input; }
        assert "f5": foreign_corporation_1504b3(entity_ref("urn:test:s1504:d6#fo")) { origin case_input; }
    }
    evaluate truth(includible_corporation_1504b(entity_ref("urn:test:s1504:d6#fo")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


