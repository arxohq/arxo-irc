// Section 1503(c)(1): unabsorbed = 1000000 - 400000 = 600000.
test "S1503C1-01-UNABSORBED-LOSS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": election_1504c2_made(entity_ref("urn:test:s1503:c1#grp"), entity_ref("urn:test:s1503:c1#y")) { origin case_input; }
        assert "f1": common_parent_of(entity_ref("urn:test:s1503:c1#grp"), entity_ref("urn:test:s1503:c1#p")) { origin case_input; }
        assert "f2": group_includes_domestic_801_insurer_1504c2(entity_ref("urn:test:s1503:c1#grp")) { origin case_input; }
        assert "f3": nonlife_members_consolidated_nol_1503c1(entity_ref("urn:test:s1503:c1#grp"), entity_ref("urn:test:s1503:c1#y"), 1000000.00 USD) { origin case_input; }
        assert "f4": nol_absorbed_in_carrybacks_1503c1(entity_ref("urn:test:s1503:c1#grp"), entity_ref("urn:test:s1503:c1#y"), 400000.00 USD) { origin case_input; }
        assert "f5": life_members_taxable_income_1503c1(entity_ref("urn:test:s1503:c1#grp"), entity_ref("urn:test:s1503:c1#y"), 10000000.00 USD) { origin case_input; }
    }
    evaluate truth(unabsorbed_nonlife_loss_1503c1(entity_ref("urn:test:s1503:c1#grp"), entity_ref("urn:test:s1503:c1#y"), 600000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


// 35% of 600000 = 210000 < 35% of 10000000 = 3500000: 210000 taken into account.
test "S1503C1-02-LOSS-CAP-LESS-THAN-INCOME-CAP" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": election_1504c2_made(entity_ref("urn:test:s1503:c2#grp"), entity_ref("urn:test:s1503:c2#y")) { origin case_input; }
        assert "f1": common_parent_of(entity_ref("urn:test:s1503:c2#grp"), entity_ref("urn:test:s1503:c2#p")) { origin case_input; }
        assert "f2": group_includes_domestic_801_insurer_1504c2(entity_ref("urn:test:s1503:c2#grp")) { origin case_input; }
        assert "f3": nonlife_members_consolidated_nol_1503c1(entity_ref("urn:test:s1503:c2#grp"), entity_ref("urn:test:s1503:c2#y"), 1000000.00 USD) { origin case_input; }
        assert "f4": nol_absorbed_in_carrybacks_1503c1(entity_ref("urn:test:s1503:c2#grp"), entity_ref("urn:test:s1503:c2#y"), 400000.00 USD) { origin case_input; }
        assert "f5": life_members_taxable_income_1503c1(entity_ref("urn:test:s1503:c2#grp"), entity_ref("urn:test:s1503:c2#y"), 10000000.00 USD) { origin case_input; }
    }
    evaluate truth(nonlife_loss_taken_into_account_1503c1(entity_ref("urn:test:s1503:c2#grp"), entity_ref("urn:test:s1503:c2#y"), 210000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


