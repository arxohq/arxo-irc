// Section 1504(f)(1): year beginning 1985-01-01, after 1984-12-31.
test "S1504F1-01-DISTRIBUTION-YEAR-AFTER-1984-NOT-A-MEMBER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s1504:f1#y"), @1985-01-01) { origin case_input; }
        assert "f1": former_disc_distribution_of_untaxed_accumulated_income_1504f1(entity_ref("urn:test:s1504:f1#c"), entity_ref("urn:test:s1504:f1#y"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(former_disc_not_a_member_for_amount_1504f(entity_ref("urn:test:s1504:f1#c"), entity_ref("urn:test:s1504:f1#y"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


