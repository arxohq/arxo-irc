// Section 1503(f)(3)(D): dividends on two applicable preferred issues 100000 + 50000 = 150000.
test "S1503F3D-01-APPLICABLE-PREFERRED-DIVIDENDS-SUMMED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": member_of_affiliated_group(entity_ref("urn:test:s1503:f1#grp"), entity_ref("urn:test:s1503:f1#sub")) { origin case_input; }
        assert "f1": makes_consolidated_return(entity_ref("urn:test:s1503:f1#grp"), entity_ref("urn:test:s1503:f1#y")) { origin case_input; }
        assert "f2": common_parent_of(entity_ref("urn:test:s1503:f1#grp"), entity_ref("urn:test:s1503:f1#p")) { origin case_input; }
        assert "f3": parent_differs_from_1503f(entity_ref("urn:test:s1503:f1#p"), entity_ref("urn:test:s1503:f1#sub")) { origin case_input; }
        assert "f4": separately_computed_taxable_income_1503f3b(entity_ref("urn:test:s1503:f1#sub"), entity_ref("urn:test:s1503:f1#y"), 300000.00 USD) { origin case_input; }
        assert "f5": preferred_dividend_item_1503f(entity_ref("urn:test:s1503:f1#sub"), entity_ref("urn:test:s1503:f1#y"), entity_ref("urn:test:s1503:f1#s1"), @1990-01-15, 100000.00 USD) { origin case_input; }
        assert "f6": stock_described_in_1504a4_1503f(entity_ref("urn:test:s1503:f1#s1")) { origin case_input; }
        assert "f7": stock_held_outside_group_1503f3d(entity_ref("urn:test:s1503:f1#s1")) { origin case_input; }
        assert "f8": stock_issued_after_nov_17_1989_1503f3d(entity_ref("urn:test:s1503:f1#s1")) { origin case_input; }
        assert "f9": preferred_dividend_item_1503f(entity_ref("urn:test:s1503:f1#sub"), entity_ref("urn:test:s1503:f1#y"), entity_ref("urn:test:s1503:f1#s2"), @1990-01-15, 50000.00 USD) { origin case_input; }
        assert "f10": stock_described_in_1504a4_1503f(entity_ref("urn:test:s1503:f1#s2")) { origin case_input; }
        assert "f11": stock_held_outside_group_1503f3d(entity_ref("urn:test:s1503:f1#s2")) { origin case_input; }
        assert "f12": stock_issued_after_nov_17_1989_1503f3d(entity_ref("urn:test:s1503:f1#s2")) { origin case_input; }
    }
    evaluate truth(applicable_preferred_dividends_1503f(entity_ref("urn:test:s1503:f1#sub"), entity_ref("urn:test:s1503:f1#y"), 150000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


