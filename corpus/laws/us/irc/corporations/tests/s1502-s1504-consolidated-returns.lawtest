    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": regulations_require_1503e3_adjustments(entity_ref("urn:test:s1503:e8#pr")) { origin case_input; }
        assert "f1": adjusted_basis_for_taxable_income_1503e3a(entity_ref("urn:test:s1503:e8#pr"), 80000.00 USD) { origin case_input; }
        assert "f2": adjusted_basis_for_earnings_and_profits_1503e3a(entity_ref("urn:test:s1503:e8#pr"), 60000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_difference_adjustment_1503e3a(entity_ref("urn:test:s1503:e8#pr"), 20000.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}


