// Section 1504(a)(3)(A): the 61st month beginning after the cessation year starts 2025-01-01 (60 months after 2020-01-01).
test "S1504A3-01-BAR-ENDS-60-MONTHS-AFTER-FIRST-MONTH" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": corporation_ceased_to_be_member_1504a3(entity_ref("urn:test:s1504:a3a#grp"), entity_ref("urn:test:s1504:a3a#c")) { origin case_input; }
        assert "f1": first_month_beginning_after_cessation_year_1504a3(entity_ref("urn:test:s1504:a3a#c"), @2020-01-01) { origin case_input; }
        assert "f2": inclusion_period_begins_1504a3(entity_ref("urn:test:s1504:a3a#grp"), entity_ref("urn:test:s1504:a3a#c"), @2020-01-01) { origin case_input; }
        assert "f3": common_parent_of(entity_ref("urn:test:s1504:a3a#grp"), entity_ref("urn:test:s1504:a3a#p")) { origin case_input; }
    }
    evaluate truth(reconsolidation_bar_ends_1504a3(entity_ref("urn:test:s1504:a3a#c"), @2025-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


