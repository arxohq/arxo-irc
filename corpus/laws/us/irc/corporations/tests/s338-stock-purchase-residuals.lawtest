// Section 338(e),(f),(h),(i): purchase, acquisition period and date, consistency period, affiliated groups, (h)(10) election and duties, formula value, estimated tax, combined return, foreign tax credit, deemed election, consistency, regulations
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 338(h)(3)(A): none of the disqualifying facts.
test "S338H3A-01-PLAIN-ACQUISITION-IS-A-PURCHASE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": stock_acquisition_338h3(entity_ref("urn:test:s338:p1#a"), entity_ref("urn:test:s338:p1#p"), entity_ref("urn:test:s338:p1#t"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(purchase_338h3(entity_ref("urn:test:s338:p1#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


