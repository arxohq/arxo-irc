        assert "f1": voting_power_share_in(entity_ref("urn:test:s338:j2#p"), entity_ref("urn:test:s338:j2#t"), @2024-06-01, 0.85) { origin case_input; }
        assert "f2": value_share_in(entity_ref("urn:test:s338:j2#p"), entity_ref("urn:test:s338:j2#t"), @2024-06-01, 0.85) { origin case_input; }
        assert "f3": regulations_prescribed_338i(entity_ref("urn:test:s338:j2#p")) { origin case_input; }
    }
