        assert "f0": stock_acquired_by_purchase_in_12_month_period(entity_ref("urn:test:s338:j1#p"), entity_ref("urn:test:s338:j1#t"), @2024-06-01) { origin case_input; }
        assert "f1": voting_power_share_in(entity_ref("urn:test:s338:j1#p"), entity_ref("urn:test:s338:j1#t"), @2024-06-01, 0.85) { origin case_input; }
        assert "f2": value_share_in(entity_ref("urn:test:s338:j1#p"), entity_ref("urn:test:s338:j1#t"), @2024-06-01, 0.85) { origin case_input; }
    }
    evaluate positions();
    expect position(Section338iPrescribeRegulationsDuty, ACTIVE);
}


// Satisfied when the regulations exist.
test "S338I-02-REGULATIONS-DUTY-SATISFIED" {
    given {
        context {
            legal_time @2024-06-01;
