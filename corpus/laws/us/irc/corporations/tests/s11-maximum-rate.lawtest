// Section 11(b) year-keyed maximum-rate export (stage 3) scenarios. NOT EXECUTED (implemented_unverified: stage 3, 26.09.2026,
// owner restriction: no mass .lawtest execution, no differential). Expectations
// come from the statutory text and its arithmetic, not from engine output.

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S11B-MAX-01-CALENDAR-2018-YEAR-RATE-21-PERCENT" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s11m:a1#y"), @2018-01-01) { origin case_input; }
    }
    evaluate truth(maximum_section_11b_rate(entity_ref("urn:test:s11m:a1#y"), 0.21));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S11B-MAX-02-CALENDAR-2026-YEAR-RATE-21-PERCENT" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s11m:a2#y"), @2026-01-01) { origin case_input; }
    }
    evaluate truth(maximum_section_11b_rate(entity_ref("urn:test:s11m:a2#y"), 0.21));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Section 11(b) as amended applies to years beginning AFTER December 31, 2017: a year beginning on that date has no rate here (graduated schedule not pinned, TECH-GAPS G3300).
test "S11B-MAX-03-FISCAL-YEAR-BEGINNING-DEC-31-2017-BOUNDARY-NOT-COVERED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s11m:a3#y"), @2017-12-31) { origin case_input; }
    }
    evaluate truth(maximum_section_11b_rate(entity_ref("urn:test:s11m:a3#y"), 0.21));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

