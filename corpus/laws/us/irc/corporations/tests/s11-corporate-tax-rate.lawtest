// Section 11 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S11-01-FLAT-21-PERCENT-TAX" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_income(entity_ref("urn:test:s11:g1#c"), entity_ref("urn:test:s11:g1#y"), 1000000.00 USD) { origin case_input; }
    }
    // 21% of 1,000,000 = 210,000.
    evaluate truth(corporate_tax(entity_ref("urn:test:s11:g1#c"), entity_ref("urn:test:s11:g1#y"), 210000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S11-02-ROUNDING-TO-THE-CENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_income(entity_ref("urn:test:s11:g2#c"), entity_ref("urn:test:s11:g2#y"), 100.00 USD) { origin case_input; }
    }
    // 21% of 100.00 = 21.00 exactly, no rounding ambiguity.
    evaluate truth(corporate_tax(entity_ref("urn:test:s11:g2#c"), entity_ref("urn:test:s11:g2#y"), 21.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S11-03-SUBCHAPTER-L-EXCEPTION-BLOCKS-SECTION-11" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_income(entity_ref("urn:test:s11:e1#c"), entity_ref("urn:test:s11:e1#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": subject_to_subchapter_l_tax(entity_ref("urn:test:s11:e1#c"), entity_ref("urn:test:s11:e1#y")) { origin case_input; }
    }
    // section 11(c)(2): a subchapter L (insurance company) taxpayer is
    // outside section 11(a) — the flat-rate rule must not fire.
    evaluate truth(corporate_tax(entity_ref("urn:test:s11:e1#c"), entity_ref("urn:test:s11:e1#y"), 210000.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S11-04-FOREIGN-CORPORATION-BLOCKS-SECTION-11" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_income(entity_ref("urn:test:s11:e2#c"), entity_ref("urn:test:s11:e2#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": foreign_corporation(entity_ref("urn:test:s11:e2#c")) { origin case_input; }
    }
    // section 11(d): a foreign corporation is taxed only as section 882
    // provides — this package does not compute that liability.
    evaluate truth(corporate_tax(entity_ref("urn:test:s11:e2#c"), entity_ref("urn:test:s11:e2#y"), 210000.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
