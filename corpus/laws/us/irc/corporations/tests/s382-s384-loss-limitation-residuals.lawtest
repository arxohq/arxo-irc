// Sections 382(a),(b)(3),(d),(e),(i),(j),(k),(n), 383(b)-(e), 384(c),(f): offset ceiling, definitions, testing period, change date, pre-change loss, value, EESA exception, capital loss analogues, built-in gain definitions
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 382(k)(1).
test "S382K1-01-NOL-CARRYOVER-MAKES-A-LOSS-CORPORATION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": entitled_to_use_nol_carryover_or_has_nol_382k1(entity_ref("urn:test:s382:k10#c"), entity_ref("urn:test:s382:k10#oc")) { origin case_input; }
    }
    evaluate truth(loss_corporation_382k1(entity_ref("urn:test:s382:k10#c"), entity_ref("urn:test:s382:k10#oc")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


