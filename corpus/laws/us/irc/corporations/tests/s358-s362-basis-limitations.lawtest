        assert "f1": basis_allocation_item_358b(entity_ref("urn:test:s358:b2#t"), entity_ref("urn:test:s358:b2#tr"), entity_ref("urn:test:s358:b2#a1"), 6000.00 USD) { origin case_input; }
        assert "f2": basis_allocation_item_358b(entity_ref("urn:test:s358:b2#t"), entity_ref("urn:test:s358:b2#tr"), entity_ref("urn:test:s358:b2#a2"), 3000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_fully_allocated_358b1(entity_ref("urn:test:s358:b2#t"), entity_ref("urn:test:s358:b2#tr")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}


