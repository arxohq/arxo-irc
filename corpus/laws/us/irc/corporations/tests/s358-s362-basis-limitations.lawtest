    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


// Duty of the taxpayer to allocate the basis: satisfied when the allocation is complete.
test "S358B-04-ALLOCATION-DUTY-SATISFIED-WHEN-COMPLETE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": exchange_basis_of_property_exchanged(entity_ref("urn:test:s358:b4#tr"), entity_ref("urn:test:s358:b4#t"), 10000.00 USD) { origin case_input; }
        assert "f1": basis_allocation_item_358b(entity_ref("urn:test:s358:b4#t"), entity_ref("urn:test:s358:b4#tr"), entity_ref("urn:test:s358:b4#a1"), 10000.00 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section358b1AllocateBasisDuty, SATISFIED);
}


// Duty of the taxpayer to allocate: not satisfied while allocations fall short.
test "S358B-05-ALLOCATION-DUTY-ACTIVE-WHEN-INCOMPLETE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
