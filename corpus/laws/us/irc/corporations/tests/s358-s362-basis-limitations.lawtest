// Section 358(c): a distribution to which section 355 applies is treated as an exchange.
test "S358C-01-SECTION-355-DISTRIBUTION-IS-AN-EXCHANGE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": distributes_solely_stock_or_securities_of_controlled(entity_ref("urn:test:s358:c1#cd"), entity_ref("urn:test:s358:c1#d"), entity_ref("urn:test:s358:c1#c"), entity_ref("urn:test:s358:c1#h")) { origin case_input; }
        assert "f1": controls_before_distribution_355(entity_ref("urn:test:s358:c1#cd"), entity_ref("urn:test:s358:c1#d"), entity_ref("urn:test:s358:c1#c")) { origin case_input; }
        assert "f2": distribution_not_principally_a_device(entity_ref("urn:test:s358:c1#cd")) { origin case_input; }
        assert "f3": active_business_requirement_satisfied_355b(entity_ref("urn:test:s358:c1#cd"), entity_ref("urn:test:s358:c1#d"), entity_ref("urn:test:s358:c1#c")) { origin case_input; }
        assert "f4": distribution_satisfies_355a1d(entity_ref("urn:test:s358:c1#cd")) { origin case_input; }
    }
    evaluate truth(section_355_distribution_treated_as_exchange_358c(entity_ref("urn:test:s358:c1#cd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


