// Section 358(h)(1): basis 10000 exceeds FMV 7000; liability 2000 <= excess 3000; basis 8000.
test "S358H-01-BASIS-REDUCED-BY-LIABILITY-WITHIN-EXCESS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": exchange_basis_of_property_exchanged(entity_ref("urn:test:s358:h1#tr"), entity_ref("urn:test:s358:h1#t"), 10000.00 USD) { origin case_input; }
        assert "f1": property_fair_market_value_358h(entity_ref("urn:test:s358:h1#t"), entity_ref("urn:test:s358:h1#tr"), 7000.00 USD) { origin case_input; }
        assert "f2": obligation_assumed_in_exchange_358h(entity_ref("urn:test:s358:h1#t"), entity_ref("urn:test:s358:h1#tr"), entity_ref("urn:test:s358:h1#l1"), 2000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_reduced_by_liabilities_358h(entity_ref("urn:test:s358:h1#tr"), entity_ref("urn:test:s358:h1#t"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


