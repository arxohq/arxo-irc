// Sections 358(b)-(c),(g),(h) and 362(c)-(e)(2): basis allocation, section 355 exchange treatment, intragroup adjustment, liabilities outside (d)(1), contributions to capital, liability-gain ceiling, built-in-loss limitation
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 358(b)(1): allocations 6000 + 4000 equal the (a)(1) basis 10000.
test "S358B-01-ALLOCATION-SUMS-TO-BASIS-FULLY-ALLOCATED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": exchange_basis_of_property_exchanged(entity_ref("urn:test:s358:b1#tr"), entity_ref("urn:test:s358:b1#t"), 10000.00 USD) { origin case_input; }
        assert "f1": basis_allocation_item_358b(entity_ref("urn:test:s358:b1#t"), entity_ref("urn:test:s358:b1#tr"), entity_ref("urn:test:s358:b1#a1"), 6000.00 USD) { origin case_input; }
        assert "f2": basis_allocation_item_358b(entity_ref("urn:test:s358:b1#t"), entity_ref("urn:test:s358:b1#tr"), entity_ref("urn:test:s358:b1#a2"), 4000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_fully_allocated_358b1(entity_ref("urn:test:s358:b1#t"), entity_ref("urn:test:s358:b1#tr")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


// Allocations 6000 + 3000 leave 1000 unallocated: no conclusion that the allocation is complete.
