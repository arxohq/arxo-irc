        assert "f1": basis_allocation_item_358b(entity_ref("urn:test:s358:b5#t"), entity_ref("urn:test:s358:b5#tr"), entity_ref("urn:test:s358:b5#a1"), 1000.00 USD) { origin case_input; }
    }
    evaluate positions();
    expect not position(Section358b1AllocateBasisDuty, SATISFIED);
}


