// Section 302 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

// Exactly at the boundary: after-ratio / before-ratio = 80% exactly does
// NOT satisfy "less than 80 percent" -> not substantially disproportionate.
test "S302-01-EXACTLY-80-PERCENT-RATIO-FAILS-SUBSTANTIALLY-DISPROPORTIONATE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": redemption(entity_ref("urn:test:s302:b1#r"), entity_ref("urn:test:s302:b1#corp"), entity_ref("urn:test:s302:b1#sh"), @2024-06-01) { origin case_input; }
        // before 0.50, after 0.40: ratio 0.40/0.50 = 0.80 exactly (not < 0.80).
        assert "f1": voting_stock_owned_share(entity_ref("urn:test:s302:b1#r"), entity_ref("urn:test:s302:b1#sh"), entity_ref("urn:test:s302:b1#corp"), 0.50, 0.40) { origin case_input; }
        assert "f2": common_stock_owned_share(entity_ref("urn:test:s302:b1#r"), entity_ref("urn:test:s302:b1#sh"), entity_ref("urn:test:s302:b1#corp"), 0.50, 0.40) { origin case_input; }
    }
    evaluate truth(substantially_disproportionate(entity_ref("urn:test:s302:b1#r")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Just below the boundary: after-ratio/before-ratio < 80%, and after < 50%
// voting power -> substantially disproportionate, exchange treatment.
test "S302-02-BELOW-80-PERCENT-RATIO-AND-BELOW-50-PERCENT-AFTER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": redemption(entity_ref("urn:test:s302:b2#r"), entity_ref("urn:test:s302:b2#corp"), entity_ref("urn:test:s302:b2#sh"), @2024-06-01) { origin case_input; }
        // before 0.50, after 0.39: ratio 0.39/0.50 = 0.78 < 0.80; after < 0.50.
        assert "f1": voting_stock_owned_share(entity_ref("urn:test:s302:b2#r"), entity_ref("urn:test:s302:b2#sh"), entity_ref("urn:test:s302:b2#corp"), 0.50, 0.39) { origin case_input; }
        assert "f2": common_stock_owned_share(entity_ref("urn:test:s302:b2#r"), entity_ref("urn:test:s302:b2#sh"), entity_ref("urn:test:s302:b2#corp"), 0.50, 0.39) { origin case_input; }
    }
    evaluate truth(substantially_disproportionate(entity_ref("urn:test:s302:b2#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(redemption_exchange_treatment(entity_ref("urn:test:s302:b2#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Exactly 50 percent after redemption fails the independent voting-power
// floor even if the 80/80 ratio tests would otherwise be met.
test "S302-03-EXACTLY-50-PERCENT-AFTER-FAILS-FLOOR" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": redemption(entity_ref("urn:test:s302:b3#r"), entity_ref("urn:test:s302:b3#corp"), entity_ref("urn:test:s302:b3#sh"), @2024-06-01) { origin case_input; }
        // before 1.00, after 0.50: ratio 0.50 < 0.80, but after == 0.50, not < 0.50.
        assert "f1": voting_stock_owned_share(entity_ref("urn:test:s302:b3#r"), entity_ref("urn:test:s302:b3#sh"), entity_ref("urn:test:s302:b3#corp"), 1.00, 0.50) { origin case_input; }
        assert "f2": common_stock_owned_share(entity_ref("urn:test:s302:b3#r"), entity_ref("urn:test:s302:b3#sh"), entity_ref("urn:test:s302:b3#corp"), 1.00, 0.50) { origin case_input; }
    }
    evaluate truth(substantially_disproportionate(entity_ref("urn:test:s302:b3#r")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S302-04-COMPLETE-TERMINATION-WITH-VALID-FAMILY-WAIVER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": redemption(entity_ref("urn:test:s302:ct1#r"), entity_ref("urn:test:s302:ct1#corp"), entity_ref("urn:test:s302:ct1#sh"), @2024-06-01) { origin case_input; }
        assert "f1": owns_no_stock_after_redemption(entity_ref("urn:test:s302:ct1#r"), entity_ref("urn:test:s302:ct1#sh"), entity_ref("urn:test:s302:ct1#corp")) { origin case_input; }
        assert "f2": retains_no_prohibited_interest(entity_ref("urn:test:s302:ct1#r"), entity_ref("urn:test:s302:ct1#sh"), entity_ref("urn:test:s302:ct1#corp")) { origin case_input; }
        assert "f3": no_acquisition_within_10_years(entity_ref("urn:test:s302:ct1#r"), entity_ref("urn:test:s302:ct1#sh"), entity_ref("urn:test:s302:ct1#corp")) { origin case_input; }
        assert "f4": files_303c2_notification_agreement(entity_ref("urn:test:s302:ct1#r"), entity_ref("urn:test:s302:ct1#sh"), entity_ref("urn:test:s302:ct1#corp")) { origin case_input; }
    }
    evaluate truth(complete_termination_of_interest(entity_ref("urn:test:s302:ct1#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_318a1_waived_for_redemption(entity_ref("urn:test:s302:ct1#r"), entity_ref("urn:test:s302:ct1#sh"), entity_ref("urn:test:s302:ct1#corp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// No exchange-treatment ground applies -> section 302(d) default to
// section 301 dividend treatment.
test "S302-05-DEFAULT-TO-SECTION-301" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": redemption(entity_ref("urn:test:s302:d1#r"), entity_ref("urn:test:s302:d1#corp"), entity_ref("urn:test:s302:d1#sh"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(redemption_section_301_treatment(entity_ref("urn:test:s302:d1#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
