// Sections 303, 304, 306, 307 scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S303-01-CEILING-IS-TAXES-PLUS-EXPENSES" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": death_taxes_imposed_303a1(entity_ref("urn:test:s303:c1#r"), 40000.00 USD) { origin case_input; }
        assert "f1": funeral_and_administration_expenses_303a2(entity_ref("urn:test:s303:c1#r"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(section_303a_ceiling(entity_ref("urn:test:s303:c1#r"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S303B4-01-MORE-THAN-4-YEARS-AFTER-DEATH" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": decedent_death_date_303(entity_ref("urn:test:s303b4:c1#r"), @2019-01-01) { origin case_input; }
        assert "f1": redemption_distribution_date_303(entity_ref("urn:test:s303b4:c1#r"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(distribution_more_than_4_years_after_death(entity_ref("urn:test:s303b4:c1#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S304A1-01-BROTHER-SISTER-ACQUISITION-TREATED-AS-ACQUIRING-REDEMPTION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": same_persons_control_both_corporations_304a1(entity_ref("urn:test:s304a1:c1#t"), entity_ref("urn:test:s304a1:c1#acquiring"), entity_ref("urn:test:s304a1:c1#other")) { origin case_input; }
        assert "f1": acquiring_corp_buys_stock_of_other_304a1(entity_ref("urn:test:s304a1:c1#t"), entity_ref("urn:test:s304a1:c1#acquiring"), entity_ref("urn:test:s304a1:c1#other"), entity_ref("urn:test:s304a1:c1#transferor"), 30000.00 USD) { origin case_input; }
    }
    evaluate truth(section_304a1_applies(entity_ref("urn:test:s304a1:c1#t"), entity_ref("urn:test:s304a1:c1#acquiring"), entity_ref("urn:test:s304a1:c1#other"), entity_ref("urn:test:s304a1:c1#transferor"), 30000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S304B2-01-TWO-TIER-DIVIDEND-COMPUTATION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": property_received_304(entity_ref("urn:test:s304b2:c1#t"), 100000.00 USD) { origin case_input; }
        assert "f1": acquiring_corp_ep_304b2(entity_ref("urn:test:s304b2:c1#t"), entity_ref("urn:test:s304b2:c1#acquiring"), 60000.00 USD) { origin case_input; }
        assert "f2": issuing_corp_ep_304b2(entity_ref("urn:test:s304b2:c1#t"), entity_ref("urn:test:s304b2:c1#issuing"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(section_304_total_dividend_amount(entity_ref("urn:test:s304b2:c1#t"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

