        assert "f1": amount_realized_306(entity_ref("urn:test:s306:c1#d"), 15000.00 USD) { origin case_input; }
        assert "f2": ratable_hypothetical_dividend_306a1a(entity_ref("urn:test:s306:c1#d"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(section_306a1a_ordinary_income(entity_ref("urn:test:s306:c1#d"), entity_ref("urn:test:s306:c1#sh"), 10000.00 USD));
