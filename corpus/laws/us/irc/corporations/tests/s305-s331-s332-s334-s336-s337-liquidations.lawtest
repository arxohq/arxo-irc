// Sections 305(a)-(b), 331, 332, 334(a)-(b), 336(a)-(b),(d), 337(a)
// scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF
// NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S305-01-PRO-RATA-STOCK-DIVIDEND-EXCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": stock_distribution(entity_ref("urn:test:s305:g1#dist"), entity_ref("urn:test:s305:g1#corp"), entity_ref("urn:test:s305:g1#sh"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(stock_dividend_non_inclusion(entity_ref("urn:test:s305:g1#dist")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S305-02-ELECTIVE-STOCK-OR-PROPERTY-IS-301" {
    given {
        context {
            legal_time @2024-06-01;
