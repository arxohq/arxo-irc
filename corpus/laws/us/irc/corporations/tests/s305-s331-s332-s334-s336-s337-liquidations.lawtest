    evaluate truth(effective_fmv_for_336(entity_ref("urn:test:s336:f1#liq"), 9000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(liquidating_corp_gain(entity_ref("urn:test:s336:f1#liq"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S336-03-NO-LOSS-TO-RELATED-PERSON-NON-PRO-RATA" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": liquidation_property_fmv(entity_ref("urn:test:s336:r1#liq"), entity_ref("urn:test:s336:r1#sh"), 4000.00 USD) { origin case_input; }
        assert "f1": liability_on_liquidated_property(entity_ref("urn:test:s336:r1#liq"), 0.00 USD) { origin case_input; }
        assert "f2": corp_adjusted_basis_of_liquidated_property(entity_ref("urn:test:s336:r1#liq"), 6000.00 USD) { origin case_input; }
        assert "f3": liquidation_distributee_is_related_person(entity_ref("urn:test:s336:r1#liq"), entity_ref("urn:test:s336:r1#sh")) { origin case_input; }
        assert "f4": liquidation_not_pro_rata(entity_ref("urn:test:s336:r1#liq")) { origin case_input; }
    }
    evaluate truth(section_336d_loss_disallowed(entity_ref("urn:test:s336:r1#liq")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(liquidating_corp_loss(entity_ref("urn:test:s336:r1#liq"), 2000.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

