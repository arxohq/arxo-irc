        assert "f1": liability_on_liquidated_property(entity_ref("urn:test:s336:f1#liq"), 9000.00 USD) { origin case_input; }
        assert "f2": corp_adjusted_basis_of_liquidated_property(entity_ref("urn:test:s336:f1#liq"), 6000.00 USD) { origin case_input; }
