// Section 332 WITH control: parent owns 80%/80% continuously, transfer
// completes within the taxable year -> nonrecognition to the parent.
test "S332-01-WITH-80-PERCENT-CONTROL-NONRECOGNITION" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": voting_power_share_in(entity_ref("urn:test:s332:w1#parent"), entity_ref("urn:test:s332:w1#sub"), @2024-01-15, 0.80) { origin case_input; }
        assert "f1": value_share_in(entity_ref("urn:test:s332:w1#parent"), entity_ref("urn:test:s332:w1#sub"), @2024-01-15, 0.80) { origin case_input; }
        assert "f2": owned_continuously_from_plan_adoption(entity_ref("urn:test:s332:w1#parent"), entity_ref("urn:test:s332:w1#sub"), @2024-01-15, @2024-12-31) { origin case_input; }
        assert "f3": transfer_completed_within_taxable_year(entity_ref("urn:test:s332:w1#liq"), entity_ref("urn:test:s332:w1#y")) { origin case_input; }
    }
    evaluate truth(section_332_complete_liquidation(entity_ref("urn:test:s332:w1#liq"), entity_ref("urn:test:s332:w1#parent"), entity_ref("urn:test:s332:w1#sub")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_332_nonrecognition(entity_ref("urn:test:s332:w1#liq"), entity_ref("urn:test:s332:w1#parent")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Section 332 WITHOUT control: parent owns only 70% — no section 332
// qualification, so nonrecognition does not follow (UNDETERMINED, the
// ordinary section 331/1001 gain-or-loss track applies instead).
test "S332-02-WITHOUT-CONTROL-NO-NONRECOGNITION" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": voting_power_share_in(entity_ref("urn:test:s332:n1#parent"), entity_ref("urn:test:s332:n1#sub"), @2024-01-15, 0.70) { origin case_input; }
        assert "f1": value_share_in(entity_ref("urn:test:s332:n1#parent"), entity_ref("urn:test:s332:n1#sub"), @2024-01-15, 0.70) { origin case_input; }
        assert "f2": owned_continuously_from_plan_adoption(entity_ref("urn:test:s332:n1#parent"), entity_ref("urn:test:s332:n1#sub"), @2024-01-15, @2024-12-31) { origin case_input; }
        assert "f3": transfer_completed_within_taxable_year(entity_ref("urn:test:s332:n1#liq"), entity_ref("urn:test:s332:n1#y")) { origin case_input; }
    }
    evaluate truth(section_332_complete_liquidation(entity_ref("urn:test:s332:n1#liq"), entity_ref("urn:test:s332:n1#parent"), entity_ref("urn:test:s332:n1#sub")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Section 334(a): FMV basis when gain/loss recognized (no section 332).
test "S334-01-FMV-BASIS-WHEN-GAIN-RECOGNIZED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": liquidation_gain_or_loss_recognized(entity_ref("urn:test:s334:a1#liq"), entity_ref("urn:test:s334:a1#sh"), @2024-06-01) { origin case_input; }
        assert "f1": liquidation_property_fmv(entity_ref("urn:test:s334:a1#liq"), entity_ref("urn:test:s334:a1#sh"), 15000.00 USD) { origin case_input; }
    }
    evaluate truth(liquidation_property_basis(entity_ref("urn:test:s334:a1#sh"), entity_ref("urn:test:s334:a1#liq"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Section 334(b)(1): carryover basis to the 80-percent corporate parent
// under section 332, absent the recognized-gain exception.
test "S334-02-CARRYOVER-BASIS-UNDER-332" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": voting_power_share_in(entity_ref("urn:test:s334:b1#parent"), entity_ref("urn:test:s334:b1#sub"), @2024-01-15, 0.80) { origin case_input; }
        assert "f1": value_share_in(entity_ref("urn:test:s334:b1#parent"), entity_ref("urn:test:s334:b1#sub"), @2024-01-15, 0.80) { origin case_input; }
        assert "f2": owned_continuously_from_plan_adoption(entity_ref("urn:test:s334:b1#parent"), entity_ref("urn:test:s334:b1#sub"), @2024-01-15, @2024-12-31) { origin case_input; }
        assert "f3": transfer_completed_within_taxable_year(entity_ref("urn:test:s334:b1#liq"), entity_ref("urn:test:s334:b1#y")) { origin case_input; }
        assert "f4": transferor_basis_in_liquidated_property(entity_ref("urn:test:s334:b1#sub"), entity_ref("urn:test:s334:b1#liq"), @2024-12-31, 9000.00 USD) { origin case_input; }
    }
    evaluate truth(liquidation_property_basis(entity_ref("urn:test:s334:b1#parent"), entity_ref("urn:test:s334:b1#liq"), 9000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

