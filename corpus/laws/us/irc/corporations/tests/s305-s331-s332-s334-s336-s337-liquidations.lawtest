            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": stock_distribution(entity_ref("urn:test:s305:e1#dist"), entity_ref("urn:test:s305:e1#corp"), entity_ref("urn:test:s305:e1#sh"), @2024-06-01) { origin case_input; }
        assert "f1": elective_stock_or_property_distribution(entity_ref("urn:test:s305:e1#dist")) { origin case_input; }
    }
    evaluate truth(stock_distribution_section_301_treatment(entity_ref("urn:test:s305:e1#dist")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(stock_dividend_non_inclusion(entity_ref("urn:test:s305:e1#dist")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

