// Sections 354-356 (reorganization exchanges, boot) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S354-01-SOLELY-STOCK-FOR-STOCK-NO-GAIN-OR-LOSS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": exchange_solely_for_stock_or_securities_354(entity_ref("urn:test:s354:c1#x"), entity_ref("urn:test:s354:c1#holder"), entity_ref("urn:test:s354:c1#target"), entity_ref("urn:test:s354:c1#acquiring")) { origin case_input; }
    }
    evaluate truth(no_gain_or_loss_recognized_354(entity_ref("urn:test:s354:c1#x"), entity_ref("urn:test:s354:c1#holder")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S354-02-EXCESS-PRINCIPAL-AMOUNT-BLOCKS-NONRECOGNITION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": exchange_solely_for_stock_or_securities_354(entity_ref("urn:test:s354:c2#x"), entity_ref("urn:test:s354:c2#holder"), entity_ref("urn:test:s354:c2#target"), entity_ref("urn:test:s354:c2#acquiring")) { origin case_input; }
        assert "f1": securities_received_exceed_surrendered_354(entity_ref("urn:test:s354:c2#x")) { origin case_input; }
    }
    evaluate truth(no_gain_or_loss_recognized_354(entity_ref("urn:test:s354:c2#x"), entity_ref("urn:test:s354:c2#holder")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S355-01-FOUR-REQUIREMENTS-SATISFIED-NONRECOGNITION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": distributes_solely_stock_or_securities_of_controlled(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#distributing"), entity_ref("urn:test:s355:c1#controlled"), entity_ref("urn:test:s355:c1#holder")) { origin case_input; }
        assert "f1": controls_before_distribution_355(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#distributing"), entity_ref("urn:test:s355:c1#controlled")) { origin case_input; }
        assert "f2": distribution_not_principally_a_device(entity_ref("urn:test:s355:c1#cd")) { origin case_input; }
        assert "f3": engaged_in_active_conduct_of_trade_or_business(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#distributing")) { origin case_input; }
        assert "f4": trade_or_business_active_for_5_years(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#distributing")) { origin case_input; }
        assert "f5": trade_or_business_not_taxably_acquired_in_5_years(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#distributing")) { origin case_input; }
        assert "f6": control_acquisition_355b2d_satisfied(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#distributing")) { origin case_input; }
        assert "f7": engaged_in_active_conduct_of_trade_or_business(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#controlled")) { origin case_input; }
        assert "f8": trade_or_business_active_for_5_years(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#controlled")) { origin case_input; }
        assert "f9": trade_or_business_not_taxably_acquired_in_5_years(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#controlled")) { origin case_input; }
        assert "f10": control_acquisition_355b2d_satisfied(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#controlled")) { origin case_input; }
        assert "f11": distributes_all_controlled_stock_and_securities(entity_ref("urn:test:s355:c1#cd")) { origin case_input; }
    }
    evaluate truth(section_355_nonrecognition(entity_ref("urn:test:s355:c1#cd"), entity_ref("urn:test:s355:c1#distributing"), entity_ref("urn:test:s355:c1#controlled"), entity_ref("urn:test:s355:c1#holder")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S355E-01-ACQUISITION-WITHIN-4-YEAR-WINDOW-PRESUMED-PLAN" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": distribution_date_355(entity_ref("urn:test:s355e:c1#cd"), @2023-01-15) { origin case_input; }
        assert "f1": acquisition_of_50_percent_or_greater_interest(entity_ref("urn:test:s355e:c1#cd"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(distribution_part_of_355e_plan(entity_ref("urn:test:s355e:c1#cd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S356-01-BOOT-GAIN-CAPPED-AT-BOOT-RECEIVED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": would_qualify_under_354_or_355_but_for_other_property(entity_ref("urn:test:s356:c1#x"), entity_ref("urn:test:s356:c1#holder")) { origin case_input; }
        assert "f1": realized_gain_on_exchange_356(entity_ref("urn:test:s356:c1#x"), entity_ref("urn:test:s356:c1#holder"), 50000.00 USD) { origin case_input; }
        assert "f2": money_or_other_property_received_356(entity_ref("urn:test:s356:c1#x"), 20000.00 USD, 0.00 USD) { origin case_input; }
    }
    evaluate truth(boot_recognized_gain_356a(entity_ref("urn:test:s356:c1#x"), entity_ref("urn:test:s356:c1#holder"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
