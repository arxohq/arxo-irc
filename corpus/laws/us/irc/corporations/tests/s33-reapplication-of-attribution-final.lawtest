// Final TECH_GAP pass (26.09.2026): section 318(a)(5)(A) (G6895). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S318A5A-01-SPOUSE-OF-A-PARTNER-OWNS-THE-PARTNERSHIP-STOCK-BY-TWO-HOPS" {
    // P (a partnership) owns 60 percent of C; A is a 50-percent partner: A owns 30 percent of C by (2)(A); A's spouse S owns it by re-application of (1) (first FromEntity, second Family).
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": partner_of(entity_ref("urn:test:s318a5:1#a"), entity_ref("urn:test:s318a5:1#p"), 0.5) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s318a5:1#oi"), entity_ref("urn:test:s318a5:1#p"), entity_ref("urn:test:s318a5:1#c"), 0.6) { origin case_input; }
        assert "f2": spouse_of(entity_ref("urn:test:s318a5:1#a"), entity_ref("urn:test:s318a5:1#s")) { origin case_input; }
    }
    evaluate truth(constructive_ownership_second_hop(entity_ref("urn:test:s318a5:1#s"), entity_ref("urn:test:s318a5:1#c"), 0.30, FromEntity, Family));
    expect truth_status == TRUE_ONLY;
}

test "S318A5B-01-NO-DOUBLE-FAMILY-ATTRIBUTION" {
    // A owns 40 percent of C; A's spouse S owns it by (1); S's child K does not own it again by (1) ((5)(B)): no (Family, Family) row.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::ownership_interest(entity_ref("urn:test:s318a5:2#oi"), entity_ref("urn:test:s318a5:2#a"), entity_ref("urn:test:s318a5:2#c"), 0.4) { origin case_input; }
        assert "f1": spouse_of(entity_ref("urn:test:s318a5:2#a"), entity_ref("urn:test:s318a5:2#s")) { origin case_input; }
        assert "f2": child_grandchild_or_parent_of(entity_ref("urn:test:s318a5:2#s"), entity_ref("urn:test:s318a5:2#k")) { origin case_input; }
    }
    evaluate truth(constructive_ownership_second_hop(entity_ref("urn:test:s318a5:2#k"), entity_ref("urn:test:s318a5:2#c"), 0.40, Family, Family));
    expect truth_status == NEITHER;
}

test "S318A5C-01-NO-SIDEWISE-ATTRIBUTION" {
    // Q owns 30 percent of C and is a 50-percent partner of P; P owns it by (3); P's other partner R does not own it again by (2) ((5)(C)): no (ToEntity, FromEntity) row.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::ownership_interest(entity_ref("urn:test:s318a5:3#oi"), entity_ref("urn:test:s318a5:3#q"), entity_ref("urn:test:s318a5:3#c"), 0.3) { origin case_input; }
        assert "f1": partner_of(entity_ref("urn:test:s318a5:3#q"), entity_ref("urn:test:s318a5:3#p"), 0.5) { origin case_input; }
        assert "f2": partner_of(entity_ref("urn:test:s318a5:3#r"), entity_ref("urn:test:s318a5:3#p"), 0.5) { origin case_input; }
    }
    evaluate truth(constructive_ownership_second_hop(entity_ref("urn:test:s318a5:3#r"), entity_ref("urn:test:s318a5:3#c"), 0.15, ToEntity, FromEntity));
    expect truth_status == NEITHER;
}

test "S318A5A-02-PARTNERSHIP-OWNS-THE-STOCK-OF-A-PARTNERS-SPOUSE" {
    // A owns 50 percent of C; A's spouse S is a partner of P: S owns it by (1); P owns it by re-application of (3) (first Family, second ToEntity).
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::ownership_interest(entity_ref("urn:test:s318a5:4#oi"), entity_ref("urn:test:s318a5:4#a"), entity_ref("urn:test:s318a5:4#c"), 0.5) { origin case_input; }
        assert "f1": spouse_of(entity_ref("urn:test:s318a5:4#a"), entity_ref("urn:test:s318a5:4#s")) { origin case_input; }
        assert "f2": partner_of(entity_ref("urn:test:s318a5:4#s"), entity_ref("urn:test:s318a5:4#p"), 0.5) { origin case_input; }
    }
    evaluate truth(constructive_ownership_second_hop(entity_ref("urn:test:s318a5:4#p"), entity_ref("urn:test:s318a5:4#c"), 0.50, Family, ToEntity));
    expect truth_status == TRUE_ONLY;
}

test "S318A5A-03-CHAIN-A-TO-P1-TO-P2-TO-C" {
    // P2 owns 80 percent of C; P1 is a 50-percent partner of P2 (40 percent by (2)); A is a 50-percent partner of P1: A owns 20 percent by re-application of (2) (first FromEntity, second FromEntity).
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::ownership_interest(entity_ref("urn:test:s318a5:5#oi"), entity_ref("urn:test:s318a5:5#p2"), entity_ref("urn:test:s318a5:5#c"), 0.8) { origin case_input; }
        assert "f1": partner_of(entity_ref("urn:test:s318a5:5#p1"), entity_ref("urn:test:s318a5:5#p2"), 0.5) { origin case_input; }
        assert "f2": partner_of(entity_ref("urn:test:s318a5:5#a"), entity_ref("urn:test:s318a5:5#p1"), 0.5) { origin case_input; }
    }
    evaluate truth(constructive_ownership_second_hop(entity_ref("urn:test:s318a5:5#a"), entity_ref("urn:test:s318a5:5#c"), 0.20, FromEntity, FromEntity));
    expect truth_status == TRUE_ONLY;
}

test "S318A5A-04-FIFTY-PERCENT-OWNER-OF-A-CORPORATION-OWNS-ITS-STOCK-IN-ANOTHER-BY-TWO-HOPS" {
    // P owns 60 percent of C1, A is a 50 percent partner of P (30 percent of C1 by (2)); C1 owns 100 percent of C2; A holds only 30 percent of C1: below the 50 percent of (2)(C): no attribution of C2 to A.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::ownership_interest(entity_ref("urn:test:s318a5:6#oi1"), entity_ref("urn:test:s318a5:6#p"), entity_ref("urn:test:s318a5:6#c1"), 0.6) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s318a5:6#oi2"), entity_ref("urn:test:s318a5:6#c1"), entity_ref("urn:test:s318a5:6#c2"), 1.0) { origin case_input; }
        assert "f2": partner_of(entity_ref("urn:test:s318a5:6#a"), entity_ref("urn:test:s318a5:6#p"), 0.5) { origin case_input; }
    }
    evaluate truth(constructive_ownership_second_hop(entity_ref("urn:test:s318a5:6#a"), entity_ref("urn:test:s318a5:6#c2"), 1.0, FromEntity, FromEntity));
    expect truth_status == NEITHER;
}
