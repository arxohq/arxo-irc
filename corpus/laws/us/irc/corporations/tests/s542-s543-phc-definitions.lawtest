            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dealer_interest_on_us_obligations_543b2ci(entity_ref("urn:test:s543:i1#c"), entity_ref("urn:test:s543:i1#y"), 2000.00 USD) { origin case_input; }
        assert "f1": interest_on_award_judgment_or_refund_543b2cii(entity_ref("urn:test:s543:i1#c"), entity_ref("urn:test:s543:i1#y"), 500.00 USD) { origin case_input; }
    }
    evaluate truth(excluded_interest_543b2c(entity_ref("urn:test:s543:i1#c"), entity_ref("urn:test:s543:i1#y"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


