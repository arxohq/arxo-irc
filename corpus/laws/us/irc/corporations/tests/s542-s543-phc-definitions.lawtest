// Section 542(c)(6)(A): 60000 of 100000 is exactly 60 percent.
test "S542C6A-01-EXACTLY-60-PERCENT-MEETS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ordinary_gross_income_542c6(entity_ref("urn:test:s542:a1#c"), entity_ref("urn:test:s542:a1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": ordinary_gross_income_from_lending_business_542c6(entity_ref("urn:test:s542:a1#c"), entity_ref("urn:test:s542:a1#y"), 60000.00 USD) { origin case_input; }
    }
    evaluate truth(meets_60_percent_of_ordinary_gross_income_lending_542c6a(entity_ref("urn:test:s542:a1#c"), entity_ref("urn:test:s542:a1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


