// 162 item 4000 counted, shareholder compensation 2000 not, 167 item for lending 1000 counted, 167 item not used in lending 700 not: 5000.
test "S542D2-01-COUNTED-DEDUCTIONS-ARE-A-PLUS-B" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": deduction_item_542d2(entity_ref("urn:test:s542:d2#c"), entity_ref("urn:test:s542:d2#y"), entity_ref("urn:test:s542:d2#i1"), 4000.00 USD) { origin case_input; }
        assert "f1": deduction_allowable_only_by_162_or_404_542d2a(entity_ref("urn:test:s542:d2#i1")) { origin case_input; }
        assert "f2": deduction_item_542d2(entity_ref("urn:test:s542:d2#c"), entity_ref("urn:test:s542:d2#y"), entity_ref("urn:test:s542:d2#i2"), 2000.00 USD) { origin case_input; }
        assert "f3": deduction_allowable_only_by_162_or_404_542d2a(entity_ref("urn:test:s542:d2#i2")) { origin case_input; }
        assert "f4": deduction_is_compensation_to_shareholder_or_family_542d2a(entity_ref("urn:test:s542:d2#i2")) { origin case_input; }
        assert "f5": deduction_item_542d2(entity_ref("urn:test:s542:d2#c"), entity_ref("urn:test:s542:d2#y"), entity_ref("urn:test:s542:d2#i3"), 1000.00 USD) { origin case_input; }
        assert "f6": deduction_under_167_or_164_real_property_tax_542d2b(entity_ref("urn:test:s542:d2#i3")) { origin case_input; }
        assert "f7": deduction_property_used_directly_in_lending_business_542d2b(entity_ref("urn:test:s542:d2#i3")) { origin case_input; }
        assert "f8": deduction_item_542d2(entity_ref("urn:test:s542:d2#c"), entity_ref("urn:test:s542:d2#y"), entity_ref("urn:test:s542:d2#i4"), 700.00 USD) { origin case_input; }
        assert "f9": deduction_under_167_or_164_real_property_tax_542d2b(entity_ref("urn:test:s542:d2#i4")) { origin case_input; }
    }
    evaluate truth(deductions_counted_542d2(entity_ref("urn:test:s542:d2#c"), entity_ref("urn:test:s542:d2#y"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


