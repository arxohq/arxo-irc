// Base 30000 less lending income 10000 = 20000.
test "S542C6B-01-COMPUTED-INCOME-EXCLUDES-LENDING-INCOME" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ordinary_gross_income_542c6(entity_ref("urn:test:s542:b1#c"), entity_ref("urn:test:s542:b1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": ordinary_gross_income_from_lending_business_542c6(entity_ref("urn:test:s542:b1#c"), entity_ref("urn:test:s542:b1#y"), 60000.00 USD) { origin case_input; }
        assert "f2": phci_base_for_542c6b(entity_ref("urn:test:s542:b1#c"), entity_ref("urn:test:s542:b1#y"), 30000.00 USD) { origin case_input; }
        assert "f3": lending_business_income_in_phci_base_542c6b(entity_ref("urn:test:s542:b1#c"), entity_ref("urn:test:s542:b1#y"), 10000.00 USD) { origin case_input; }
        assert "f4": affiliated_lending_company_income_542d3(entity_ref("urn:test:s542:b1#c"), entity_ref("urn:test:s542:b1#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(phci_computed_for_542c6b(entity_ref("urn:test:s542:b1#c"), entity_ref("urn:test:s542:b1#y"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


