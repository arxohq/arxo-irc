// Section 542(b)-(d) and 543(b)-(c): consolidated returns, exceptions, lending or finance companies, ordinary gross income, adjusted income from rents and royalties, adjusted ordinary gross income, insurance company gross income
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 542(c)(1): excluded from the personal holding company definition.
test "S542C1-01-EXEMPT-IS-EXCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": exempt_under_subchapter_f(entity_ref("urn:test:s542:x1#c"), entity_ref("urn:test:s542:x1#y")) { origin case_input; }
    }
    evaluate truth(personal_holding_company_excluded_542c_derived(entity_ref("urn:test:s542:x1#c"), entity_ref("urn:test:s542:x1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


