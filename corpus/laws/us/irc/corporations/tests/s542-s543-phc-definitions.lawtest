// Section 543(b)(2): 75000 - 8000 - 4000 - 3000 - 2500 - 1000 = 56500.
test "S543B2-01-ADJUSTED-ORDINARY-GROSS-INCOME-IS-THE-SUM-OF-ADJUSTMENTS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_income_543(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": capital_asset_gains_543b1a(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 20000.00 USD) { origin case_input; }
        assert "f2": gains_from_1231b_property_543b1b(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 5000.00 USD) { origin case_input; }
        assert "f3": rent_receipt_543b3(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), entity_ref("urn:test:s543:t1#i1"), 20000.00 USD) { origin case_input; }
        assert "f4": compensation_for_use_of_property_543b3(entity_ref("urn:test:s543:t1#i1")) { origin case_input; }
        assert "f5": rent_deductions_allocable_543b2a(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 8000.00 USD) { origin case_input; }
        assert "f6": royalty_income_543b4(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 10000.00 USD) { origin case_input; }
        assert "f7": royalty_deductions_allocable_543b2b(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 4000.00 USD) { origin case_input; }
        assert "f8": working_interest_income_543b2b(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 10000.00 USD) { origin case_input; }
        assert "f9": working_interest_deductions_allocable_543b2b(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 3000.00 USD) { origin case_input; }
        assert "f10": dealer_interest_on_us_obligations_543b2ci(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 2000.00 USD) { origin case_input; }
        assert "f11": interest_on_award_judgment_or_refund_543b2cii(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 500.00 USD) { origin case_input; }
        assert "f12": excluded_rents_compensation_543b2d(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 4000.00 USD) { origin case_input; }
        assert "f13": excluded_rents_deductions_allocable_543b2d(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(computed_adjusted_ordinary_gross_income_543b2(entity_ref("urn:test:s543:t1#c"), entity_ref("urn:test:s543:t1#y"), 56500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

