// The liberty is the Secretary's freedom from the issuer's characterization; its state is ACTIVE while the liberty stands (position names of section 134).
test "S385C1-05-SECRETARY-NOT-BOUND-LIBERTY-TO-RECHARACTERIZE" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": interest_issued_by_corporation_385(entity_ref("urn:test:s385:a9#i"), entity_ref("urn:test:s385:a9#issuer")) { origin case_input; }
        assert "f1": issuer_characterization_at_issuance_385c1(entity_ref("urn:test:s385:a9#i"), CharacterizedAsIndebtedness) { origin case_input; }
    }
    evaluate positions();
    expect position(SecretaryMayRecharacterizeInterest, ACTIVE);
}

