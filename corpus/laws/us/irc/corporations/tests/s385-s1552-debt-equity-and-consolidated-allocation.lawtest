    evaluate truth(member_allocated_tax_1552a3(entity_ref("urn:test:s385:e4#g"), entity_ref("urn:test:s385:e4#y"), entity_ref("urn:test:s385:e4#m3"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

