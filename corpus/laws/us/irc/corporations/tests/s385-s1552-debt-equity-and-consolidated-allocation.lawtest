        assert "f4": member_separate_return_tax_1552a2(entity_ref("urn:test:s385:e4#g"), entity_ref("urn:test:s385:e4#y"), entity_ref("urn:test:s385:e4#m3"), 10000.00 USD) { origin case_input; }
        assert "f5": member_tax_on_contribution_basis_1552a3(entity_ref("urn:test:s385:e4#g"), entity_ref("urn:test:s385:e4#y"), entity_ref("urn:test:s385:e4#m3"), 15000.00 USD) { origin case_input; }
        assert "f6": tax_increase_from_consolidation_1552a3(entity_ref("urn:test:s385:e4#g"), entity_ref("urn:test:s385:e4#y"), 6000.00 USD) { origin case_input; }
        assert "f7": total_reduction_from_consolidation_1552a3(entity_ref("urn:test:s385:e4#g"), entity_ref("urn:test:s385:e4#y"), 20000.00 USD) { origin case_input; }
