// A valid section 385(c)(2) disclosure releases the holder: the power's effect (holder_not_bound...) closes the prohibition.
test "S385C2-01-HOLDER-DISCLOSES-ON-RETURN-RELEASED-NO-BREACH" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": interest_issued_by_corporation_385(entity_ref("urn:test:s385:a5#i"), entity_ref("urn:test:s385:a5#issuer")) { origin case_input; }
        assert "f1": issuer_characterization_at_issuance_385c1(entity_ref("urn:test:s385:a5#i"), CharacterizedAsIndebtedness) { origin case_input; }
        assert "f2": holder_of_interest_385(entity_ref("urn:test:s385:a5#i"), entity_ref("urn:test:s385:a5#h")) { origin case_input; }
        assert "f3": party_treats_interest_inconsistently_with_characterization_385c1(entity_ref("urn:test:s385:a5#i"), entity_ref("urn:test:s385:a5#h")) { origin case_input; }
        assert "f4": holder_discloses_inconsistent_treatment_385c2(entity_ref("urn:test:s385:a5#i"), entity_ref("urn:test:s385:a5#h")) { origin case_input; }
        assert "f5": disclosure_made_on_holders_return_385c2(entity_ref("urn:test:s385:a5#i"), entity_ref("urn:test:s385:a5#h")) { origin case_input; }
    }
    evaluate positions();
    expect not position(Section385c1HolderBindingBar, VIOLATED);
}

