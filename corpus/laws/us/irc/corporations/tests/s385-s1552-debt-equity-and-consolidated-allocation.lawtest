// Disclosure outside the return is an invalid exercise (E-0239): no effect, the holder stays bound and its inconsistent treatment is a breach.
test "S385C2-03-DISCLOSURE-NOT-ON-THE-RETURN-INVALID-EXERCISE-NO-RELEASE" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": interest_issued_by_corporation_385(entity_ref("urn:test:s385:a7#i"), entity_ref("urn:test:s385:a7#issuer")) { origin case_input; }
        assert "f1": issuer_characterization_at_issuance_385c1(entity_ref("urn:test:s385:a7#i"), CharacterizedAsIndebtedness) { origin case_input; }
        assert "f2": holder_of_interest_385(entity_ref("urn:test:s385:a7#i"), entity_ref("urn:test:s385:a7#h")) { origin case_input; }
        assert "f3": party_treats_interest_inconsistently_with_characterization_385c1(entity_ref("urn:test:s385:a7#i"), entity_ref("urn:test:s385:a7#h")) { origin case_input; }
        assert "f4": holder_discloses_inconsistent_treatment_385c2(entity_ref("urn:test:s385:a7#i"), entity_ref("urn:test:s385:a7#h")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section385c1HolderBindingBar, VIOLATED);
}

