// Sections 385 and 1552 scenarios. NOT EXECUTED (implemented_unverified: stage 3, 26.09.2026,
// owner restriction: no mass .lawtest execution, no differential). Expectations
// come from the statutory text and its arithmetic, not from engine output.

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S385C1-01-ISSUER-BOUND-INCONSISTENT-TREATMENT-IS-A-BREACH" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": interest_issued_by_corporation_385(entity_ref("urn:test:s385:a1#i"), entity_ref("urn:test:s385:a1#issuer")) { origin case_input; }
        assert "f1": issuer_characterization_at_issuance_385c1(entity_ref("urn:test:s385:a1#i"), CharacterizedAsIndebtedness) { origin case_input; }
        assert "f2": party_treats_interest_inconsistently_with_characterization_385c1(entity_ref("urn:test:s385:a1#i"), entity_ref("urn:test:s385:a1#issuer")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section385c1IssuerBindingBar, VIOLATED);
}

