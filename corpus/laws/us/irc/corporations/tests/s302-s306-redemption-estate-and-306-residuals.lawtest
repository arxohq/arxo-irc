// Ceiling 70000, reduction 50000.
test "S303C-05-EXCHANGE-TREATMENT-UP-TO-THE-REDUCTION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": redemption(entity_ref("urn:test:s303:e1#r"), entity_ref("urn:test:s303:e1#k"), entity_ref("urn:test:s303:e1#s"), @2024-06-01) { origin case_input; }
        assert "f1": new_stock_basis_from_old_stock_303c1(entity_ref("urn:test:s303:e1#r"), entity_ref("urn:test:s303:e1#s")) { origin case_input; }
        assert "f2": old_stock_included_in_gross_estate_303c2(entity_ref("urn:test:s303:e1#r"), entity_ref("urn:test:s303:e1#d")) { origin case_input; }
        assert "f3": section_303a_would_apply_to_old_stock_303c3(entity_ref("urn:test:s303:e1#r")) { origin case_input; }
        assert "f4": distribution_within_303b1_period(entity_ref("urn:test:s303:e1#r")) { origin case_input; }
        assert "f5": stock_value_in_gross_estate_303b2(entity_ref("urn:test:s303:e1#r"), 500000.00 USD) { origin case_input; }
        assert "f6": gross_estate_value_303b2(entity_ref("urn:test:s303:e1#r"), 1000000.00 USD) { origin case_input; }
        assert "f7": section_2053_2054_deductions_303b2(entity_ref("urn:test:s303:e1#r"), 0.00 USD) { origin case_input; }
        assert "f8": death_taxes_imposed_303a1(entity_ref("urn:test:s303:e1#r"), 60000.00 USD) { origin case_input; }
        assert "f9": funeral_and_administration_expenses_303a2(entity_ref("urn:test:s303:e1#r"), 10000.00 USD) { origin case_input; }
        assert "f10": shareholder_interest_reduced_by_payment_303b3(entity_ref("urn:test:s303:e1#r"), 50000.00 USD) { origin case_input; }
    }
    evaluate truth(section_303_exchange_treatment(entity_ref("urn:test:s303:e1#r"), entity_ref("urn:test:s303:e1#s"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


