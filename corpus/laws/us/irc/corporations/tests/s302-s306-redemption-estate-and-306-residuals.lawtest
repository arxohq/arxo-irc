        assert "f5": transferred_stock_redeemed_in_same_transaction_302c2bii(entity_ref("urn:test:s302:w4#r"), entity_ref("urn:test:s302:w4#s"), entity_ref("urn:test:s302:w4#k")) { origin case_input; }
