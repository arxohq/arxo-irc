            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": interest_acquired_within_10_years_on_302c2a(entity_ref("urn:test:s302:x1#r"), entity_ref("urn:test:s302:x1#s"), @2028-03-01) { origin case_input; }
        assert "f1": distributee_notified_secretary_on_302c2a(entity_ref("urn:test:s302:x1#r"), entity_ref("urn:test:s302:x1#s"), @2028-04-15) { origin case_input; }
    }
    evaluate truth(assessment_and_collection_open_through_302c2a(entity_ref("urn:test:s302:x1#r"), entity_ref("urn:test:s302:x1#s"), @2029-04-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


