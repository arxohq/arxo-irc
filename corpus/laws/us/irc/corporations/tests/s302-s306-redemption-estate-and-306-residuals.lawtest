// Sections 302(b)(5)-(6), 302(c)(2), 302(e)(3),(5), 303(c)-(d) and 306(d)-(g): demand redemptions of RICs, waiver and its entity and 10-year rules, qualified trade or business, pass-through look-through, substituted and generation-skipping stock, stock rights, convertible stock, source, substantial change
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 302(b)(5): all conditions.
test "S302B5-01-DEMAND-REDEMPTION-BY-PUBLIC-RIC-IS-AN-EXCHANGE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": redemption(entity_ref("urn:test:s302:a1#r"), entity_ref("urn:test:s302:a1#k"), entity_ref("urn:test:s302:a1#s"), @2024-06-01) { origin case_input; }
        assert "f1": publicly_offered_ric_302b5(entity_ref("urn:test:s302:a1#k")) { origin case_input; }
        assert "f2": redemption_upon_demand_of_stockholder_302b5a(entity_ref("urn:test:s302:a1#r")) { origin case_input; }
        assert "f3": company_issues_only_demand_redeemable_stock_302b5b(entity_ref("urn:test:s302:a1#k")) { origin case_input; }
    }
    evaluate truth(redemption_exchange_treatment(entity_ref("urn:test:s302:a1#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


