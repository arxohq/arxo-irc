// Sections 381-384 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S381A-01-332-LIQUIDATION-CARRYOVER-SUCCESSION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": acquisition_via_332_liquidation(entity_ref("urn:test:s381a:c1#e"), entity_ref("urn:test:s381a:c1#acquiring"), entity_ref("urn:test:s381a:c1#transferor")) { origin case_input; }
    }
    evaluate truth(section_381a_carryover_succession_applies(entity_ref("urn:test:s381a:c1#e"), entity_ref("urn:test:s381a:c1#acquiring"), entity_ref("urn:test:s381a:c1#transferor")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S382G-01-MORE-THAN-50-POINT-SHIFT-IS-OWNERSHIP-CHANGE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": five_percent_shareholder_percentage_increase(entity_ref("urn:test:s382g:c1#oc"), entity_ref("urn:test:s382g:c1#corp"), 55.0) { origin case_input; }
    }
    evaluate truth(ownership_change_382g(entity_ref("urn:test:s382g:c1#oc"), entity_ref("urn:test:s382g:c1#corp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S382G-02-EXACTLY-50-POINT-SHIFT-IS-NOT-OWNERSHIP-CHANGE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": five_percent_shareholder_percentage_increase(entity_ref("urn:test:s382g:c2#oc"), entity_ref("urn:test:s382g:c2#corp"), 50.0) { origin case_input; }
    }
    evaluate truth(ownership_change_382g(entity_ref("urn:test:s382g:c2#oc"), entity_ref("urn:test:s382g:c2#corp")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S382C-01-NO-CONTINUITY-ZERO-LIMITATION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": five_percent_shareholder_percentage_increase(entity_ref("urn:test:s382c:c1#oc"), entity_ref("urn:test:s382c:c1#corp"), 60.0) { origin case_input; }
        assert "f1": post_change_year_382(entity_ref("urn:test:s382c:c1#oc"), entity_ref("urn:test:s382c:c1#y1")) { origin case_input; }
    }
    evaluate truth(section_382_limitation_zero_382c(entity_ref("urn:test:s382c:c1#oc"), entity_ref("urn:test:s382c:c1#y1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S384A-01-CONTROL-ACQUISITION-OF-GAIN-CORP-RESTRICTS-LOSS-OFFSET" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": acquires_control_of_another_corp_384a1a(entity_ref("urn:test:s384a:c1#acquiring"), entity_ref("urn:test:s384a:c1#acquired")) { origin case_input; }
        assert "f1": is_gain_corporation_384a2(entity_ref("urn:test:s384a:c1#gain_corp")) { origin case_input; }
        assert "f2": preacquisition_loss_384(entity_ref("urn:test:s384a:c1#loss_corp"), 20000.00 USD) { origin case_input; }
    }
    evaluate truth(section_384a_applies(entity_ref("urn:test:s384a:c1#acquiring"), entity_ref("urn:test:s384a:c1#acquired"), entity_ref("urn:test:s384a:c1#gain_corp"), entity_ref("urn:test:s384a:c1#loss_corp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
