            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution_is_one_of_series_in_redemption_346a(entity_ref("urn:test:s361:a1#d"), entity_ref("urn:test:s361:a1#corp")) { origin case_input; }
        assert "f1": series_redeems_all_stock_of_corporation_pursuant_to_plan_346a(entity_ref("urn:test:s361:a1#d"), entity_ref("urn:test:s361:a1#corp")) { origin case_input; }
    }
    evaluate truth(distribution_treated_as_in_complete_liquidation_346a(entity_ref("urn:test:s361:a1#d"), entity_ref("urn:test:s361:a1#corp")));
