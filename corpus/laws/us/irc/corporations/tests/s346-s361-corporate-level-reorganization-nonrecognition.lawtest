        assert "f1": acquisition_solely_for_voting_stock(entity_ref("urn:test:s361:f2#r"), entity_ref("urn:test:s361:f2#corp"), entity_ref("urn:test:s361:f2#other")) { origin case_input; }
    }
    evaluate truth(distribution_treated_as_to_shareholders_361c(entity_ref("urn:test:s361:f2#d"), entity_ref("urn:test:s361:f2#r"), entity_ref("urn:test:s361:f2#corp"), entity_ref("urn:test:s361:f2#a")));
