// Sections 1501, 1504(a), 1561, 1563(a),(d)-(e) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S1501-01-VALID-CONSOLIDATED-RETURN-ELECTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": common_parent_of(entity_ref("urn:test:s1501:g1#group"), entity_ref("urn:test:s1501:g1#parent")) { origin case_input; }
        assert "f1": is_includible_corporation(entity_ref("urn:test:s1501:g1#parent")) { origin case_input; }
        assert "f2": member_of_affiliated_group(entity_ref("urn:test:s1501:g1#group"), entity_ref("urn:test:s1501:g1#member")) { origin case_input; }
        assert "f3": is_includible_corporation(entity_ref("urn:test:s1501:g1#member")) { origin case_input; }
        assert "f4": voting_power_share_in(entity_ref("urn:test:s1501:g1#parent"), entity_ref("urn:test:s1501:g1#member"), @2024-04-15, 0.90) { origin case_input; }
        assert "f5": value_share_in(entity_ref("urn:test:s1501:g1#parent"), entity_ref("urn:test:s1501:g1#member"), @2024-04-15, 0.90) { origin case_input; }
        assert "f6": makes_consolidated_return(entity_ref("urn:test:s1501:g1#group"), entity_ref("urn:test:s1501:g1#y")) { origin case_input; }
    }
    evaluate truth(consolidated_return_election_effective(entity_ref("urn:test:s1501:g1#group"), entity_ref("urn:test:s1501:g1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1501-02-NO-RETURN-FILED-NO-ELECTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": member_of_affiliated_group(entity_ref("urn:test:s1501:n1#group"), entity_ref("urn:test:s1501:n1#member")) { origin case_input; }
    }
    evaluate truth(consolidated_return_election_effective(entity_ref("urn:test:s1501:n1#group"), entity_ref("urn:test:s1501:n1#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Invalid exercise: a group that files a "consolidated return" but is NOT
// actually an affiliated group under section 1504(a) (e.g. only 60% owned)
// — the power's valid_when fails, so the election has no effect
// (E-0239/POWER_INVALID_EXERCISE), not a fallback to some other treatment.
test "S1501-03-INVALID-EXERCISE-NOT-AFFILIATED-GROUP" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": common_parent_of(entity_ref("urn:test:s1501:i1#group"), entity_ref("urn:test:s1501:i1#parent")) { origin case_input; }
        assert "f1": is_includible_corporation(entity_ref("urn:test:s1501:i1#parent")) { origin case_input; }
        assert "f2": member_of_affiliated_group(entity_ref("urn:test:s1501:i1#group"), entity_ref("urn:test:s1501:i1#member")) { origin case_input; }
        assert "f3": is_includible_corporation(entity_ref("urn:test:s1501:i1#member")) { origin case_input; }
        assert "f4": voting_power_share_in(entity_ref("urn:test:s1501:i1#parent"), entity_ref("urn:test:s1501:i1#member"), @2024-04-15, 0.60) { origin case_input; }
        assert "f5": value_share_in(entity_ref("urn:test:s1501:i1#parent"), entity_ref("urn:test:s1501:i1#member"), @2024-04-15, 0.60) { origin case_input; }
        assert "f6": makes_consolidated_return(entity_ref("urn:test:s1501:i1#group"), entity_ref("urn:test:s1501:i1#y")) { origin case_input; }
    }
    evaluate truth(consolidated_return_election_effective(entity_ref("urn:test:s1501:i1#group"), entity_ref("urn:test:s1501:i1#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

