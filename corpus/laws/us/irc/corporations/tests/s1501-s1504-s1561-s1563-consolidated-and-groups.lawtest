// section 1563(f)(5) 80%-and->50% double test (e.g. as incorporated by
// section 1561): both branches satisfied.
test "S1563F5-01-EIGHTY-AND-FIFTY-DOUBLE-TEST-SATISFIED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": identical_ownership_share_80(entity_ref("urn:test:s1563:f5a#group"), entity_ref("urn:test:s1563:f5a#corp"), 0.85) { origin case_input; }
        assert "f1": identical_ownership_share_over_50(entity_ref("urn:test:s1563:f5a#group"), entity_ref("urn:test:s1563:f5a#corp"), 0.85) { origin case_input; }
    }
    evaluate truth(brother_sister_controlled_group_1563f5(entity_ref("urn:test:s1563:f5a#group"), entity_ref("urn:test:s1563:f5a#corp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Only the >50% branch is met, the 80% branch is not -> double test fails.
test "S1563F5-02-ONLY-FIFTY-BRANCH-MET-DOUBLE-TEST-FAILS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": identical_ownership_share_80(entity_ref("urn:test:s1563:f5b#group"), entity_ref("urn:test:s1563:f5b#corp"), 0.60) { origin case_input; }
        assert "f1": identical_ownership_share_over_50(entity_ref("urn:test:s1563:f5b#group"), entity_ref("urn:test:s1563:f5b#corp"), 0.60) { origin case_input; }
    }
    evaluate truth(brother_sister_controlled_group_1563f5(entity_ref("urn:test:s1563:f5b#group"), entity_ref("urn:test:s1563:f5b#corp")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Section 1563(d)-(e) attribution: 5-percent-or-more partner attribution.
test "S1563DE-01-PARTNER-ATTRIBUTION-AT-5-PERCENT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": partner_5_percent_or_more_1563(entity_ref("urn:test:s1563:p1#partner"), entity_ref("urn:test:s1563:p1#pship"), 0.10) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s1563:p1#oi"), entity_ref("urn:test:s1563:p1#pship"), entity_ref("urn:test:s1563:p1#corp"), 0.60) { origin case_input; }
    }
    // 0.60 * 0.10 = 0.06
    evaluate truth(constructive_ownership_1563(entity_ref("urn:test:s1563:p1#partner"), entity_ref("urn:test:s1563:p1#corp"), 0.06, FromEntity));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Ownership-share diagnostic scenario recorded for the coverage row on
// affiliated_group_at_79_9_percent (see module 08 header) — reuses
// S1504A-02 above rather than duplicating; no separate test needed since
// the same boundary applies to both relations.

test "S1561-01-SHARED-CREDIT-BY-APPORTIONMENT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": component_member_of_controlled_group(entity_ref("urn:test:s1561:g1#group"), entity_ref("urn:test:s1561:g1#member"), @2024-12-31) { origin case_input; }
        assert "f1": controlled_group_apportionment_agreement(entity_ref("urn:test:s1561:g1#group"), entity_ref("urn:test:s1561:g1#member"), @2024-12-31, 62500.00 USD) { origin case_input; }
    }
    evaluate truth(accumulated_earnings_credit_limit_shared(entity_ref("urn:test:s1561:g1#group"), entity_ref("urn:test:s1561:g1#member"), @2024-12-31, 62500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
