// Sections 357(a)-(c), 358(a)-(b), 362(a)-(b),(e) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S357-01-ASSUMPTION-NOT-BOOT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": would_qualify_without_boot(entity_ref("urn:test:s357:g1#t"), entity_ref("urn:test:s357:g1#transferor")) { origin case_input; }
        assert "f1": liability_assumed_by_other_party(entity_ref("urn:test:s357:g1#t"), entity_ref("urn:test:s357:g1#transferor"), 3000.00 USD) { origin case_input; }
    }
    evaluate truth(assumption_not_treated_as_boot(entity_ref("urn:test:s357:g1#t"), entity_ref("urn:test:s357:g1#transferor")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Liabilities in excess of basis -> gain (section 357(c)(1)).
test "S357-02-LIABILITIES-IN-EXCESS-OF-BASIS-GAIN" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_357c_eligible_exchange(entity_ref("urn:test:s357:c1#t"), entity_ref("urn:test:s357:c1#transferor")) { origin case_input; }
        assert "f1": total_liabilities_assumed(entity_ref("urn:test:s357:c1#t"), entity_ref("urn:test:s357:c1#transferor"), 10000.00 USD) { origin case_input; }
        assert "f2": total_adjusted_basis_of_transferred_property(entity_ref("urn:test:s357:c1#t"), entity_ref("urn:test:s357:c1#transferor"), 7000.00 USD) { origin case_input; }
    }
    evaluate truth(section_357c_liabilities_excess_gain(entity_ref("urn:test:s357:c1#t"), entity_ref("urn:test:s357:c1#transferor"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Liabilities equal to basis: no excess, no (c)(1) gain.
test "S357-03-LIABILITIES-EQUAL-TO-BASIS-NO-GAIN" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_357c_eligible_exchange(entity_ref("urn:test:s357:c2#t"), entity_ref("urn:test:s357:c2#transferor")) { origin case_input; }
        assert "f1": total_liabilities_assumed(entity_ref("urn:test:s357:c2#t"), entity_ref("urn:test:s357:c2#transferor"), 7000.00 USD) { origin case_input; }
        assert "f2": total_adjusted_basis_of_transferred_property(entity_ref("urn:test:s357:c2#t"), entity_ref("urn:test:s357:c2#transferor"), 7000.00 USD) { origin case_input; }
    }
    evaluate truth(section_357c_liabilities_excess_gain(entity_ref("urn:test:s357:c2#t"), entity_ref("urn:test:s357:c2#transferor"), 0.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

