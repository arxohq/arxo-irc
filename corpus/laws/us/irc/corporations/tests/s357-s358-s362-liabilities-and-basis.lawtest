test "S358-01-SUBSTITUTED-BASIS-WITH-BOOT-ADJUSTMENTS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": exchange_basis_of_property_exchanged(entity_ref("urn:test:s358:g1#transferor"), entity_ref("urn:test:s358:g1#t"), 10000.00 USD) { origin case_input; }
        assert "f1": other_property_fmv_received_358(entity_ref("urn:test:s358:g1#t"), entity_ref("urn:test:s358:g1#transferor"), 1000.00 USD) { origin case_input; }
        assert "f2": money_received_358(entity_ref("urn:test:s358:g1#t"), entity_ref("urn:test:s358:g1#transferor"), 500.00 USD) { origin case_input; }
        assert "f3": loss_recognized_on_exchange_358(entity_ref("urn:test:s358:g1#t"), entity_ref("urn:test:s358:g1#transferor"), 0.00 USD) { origin case_input; }
        assert "f4": dividend_treated_amount_358(entity_ref("urn:test:s358:g1#t"), entity_ref("urn:test:s358:g1#transferor"), 0.00 USD) { origin case_input; }
        assert "f5": gain_recognized_on_exchange_358(entity_ref("urn:test:s358:g1#t"), entity_ref("urn:test:s358:g1#transferor"), 200.00 USD) { origin case_input; }
    }
    // 10000 - 1000 - 500 - 0 + 0 + 200 = 8700
    evaluate truth(substituted_basis_358(entity_ref("urn:test:s358:g1#transferor"), entity_ref("urn:test:s358:g1#t"), 8700.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

