test "S367A1-01-US-PERSON-TRANSFER-IN-SECTION-351-FOREIGN-CORPORATION-NOT-A-CORPORATION" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": transferor_is_united_states_person_367(entity_ref("urn:test:s367:a1#x")) { origin case_input; }
        assert "f1": transferee_is_foreign_corporation_367(entity_ref("urn:test:s367:a1#x"), entity_ref("urn:test:s367:a1#f")) { origin case_input; }
        assert "f2": property_transferred_in_exchange_367(entity_ref("urn:test:s367:a1#x"), entity_ref("urn:test:s367:a1#a")) { origin case_input; }
        assert "f3": exchange_described_in_section_367(entity_ref("urn:test:s367:a1#x"), Exchange351) { origin case_input; }
    }
    evaluate truth(foreign_corporation_not_considered_corporation_for_gain_367a1(entity_ref("urn:test:s367:a1#x"), entity_ref("urn:test:s367:a1#a"), entity_ref("urn:test:s367:a1#f")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

