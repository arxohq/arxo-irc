// Sections 304(b)(1),(3)-(6) and 305(c),(e): issuing-corporation tests, coordination with section 351, liabilities, bank holding company formations, intragroup transfers, foreign acquirers, regulations duties, treated-as-distribution events, redemption premiums, stripped preferred stock
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 304(b)(1): the 302(b) tests use the issuing corporation's stock.
test "S304B1-01-A1-ACQUISITION-TESTED-BY-THE-ISSUING-CORPORATION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": same_persons_control_both_corporations_304a1(entity_ref("urn:test:s304:a1#t"), entity_ref("urn:test:s304:a1#a"), entity_ref("urn:test:s304:a1#i")) { origin case_input; }
        assert "f1": acquiring_corp_buys_stock_of_other_304a1(entity_ref("urn:test:s304:a1#t"), entity_ref("urn:test:s304:a1#a"), entity_ref("urn:test:s304:a1#i"), entity_ref("urn:test:s304:a1#p"), 50000.00 USD) { origin case_input; }
        assert "f2": property_received_304(entity_ref("urn:test:s304:a1#t"), 50000.00 USD) { origin case_input; }
    }
    evaluate truth(redemption_test_corporation_304b1(entity_ref("urn:test:s304:a1#t"), entity_ref("urn:test:s304:a1#i")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


