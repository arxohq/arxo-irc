// Section 304(b)(3)(B)(i): 351 acquisition, liability incurred to buy the stock, unrelated source.
test "S304B3Bi-01-ACQUISITION-LIABILITY-IS-OUTSIDE-304A" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": same_persons_control_both_corporations_304a1(entity_ref("urn:test:s304:l1#t"), entity_ref("urn:test:s304:l1#a"), entity_ref("urn:test:s304:l1#i")) { origin case_input; }
        assert "f1": acquiring_corp_buys_stock_of_other_304a1(entity_ref("urn:test:s304:l1#t"), entity_ref("urn:test:s304:l1#a"), entity_ref("urn:test:s304:l1#i"), entity_ref("urn:test:s304:l1#p"), 50000.00 USD) { origin case_input; }
        assert "f2": property_received_304(entity_ref("urn:test:s304:l1#t"), 50000.00 USD) { origin case_input; }
        assert "f3": acquisition_described_in_351_304b3b(entity_ref("urn:test:s304:l1#t")) { origin case_input; }
        assert "f4": liability_assumed_or_stock_subject_304b3bi(entity_ref("urn:test:s304:l1#t"), entity_ref("urn:test:s304:l1#l"), 20000.00 USD) { origin case_input; }
        assert "f5": liability_incurred_to_acquire_stock_304b3bi(entity_ref("urn:test:s304:l1#l")) { origin case_input; }
        assert "f6": stock_from_person_without_attributed_stock_304b3biii1(entity_ref("urn:test:s304:l1#t")) { origin case_input; }
    }
    evaluate truth(liability_outside_304a_304b3bi(entity_ref("urn:test:s304:l1#t"), entity_ref("urn:test:s304:l1#l"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


