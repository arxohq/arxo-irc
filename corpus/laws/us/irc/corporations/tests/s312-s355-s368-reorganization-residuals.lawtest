            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": adjusted_basis_of_security_property_312i(entity_ref("urn:test:s312:i1#d"), 40000.00 USD) { origin case_input; }
        assert "f1": loan_made_guaranteed_or_insured_by_united_states_312i(entity_ref("urn:test:s312:i1#d"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(ep_increase_loan_excess_312i(entity_ref("urn:test:s312:i1#d"), 60000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


