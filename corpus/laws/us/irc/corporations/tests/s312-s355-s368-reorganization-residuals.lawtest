// Sections 312(g),(i),(l),(m), 355(c),(f)-(h), 368(a)(1)-(3), 368(b): earnings and profits residuals, corporate-level nonrecognition, exclusions, reorganization special rules and party status
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 312(g)(1): the difference 4000 increases the pre-1913 part.
test "S312G1-01-DIFFERENCE-INCREASES-PRE-1913-PART" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": ep_change_difference_from_1913_basis_312g1(entity_ref("urn:test:s312:g1#c"), entity_ref("urn:test:s312:g1#y"), 4000.00 USD) { origin case_input; }
    }
    evaluate truth(pre_1913_value_part_increase_312g1(entity_ref("urn:test:s312:g1#c"), entity_ref("urn:test:s312:g1#y"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


