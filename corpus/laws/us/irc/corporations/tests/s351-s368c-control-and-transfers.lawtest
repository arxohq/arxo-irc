test "S351-03-BOOT-GAIN-CAPPED-AT-BOOT-RECEIVED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": money_received_in_transfer(entity_ref("urn:test:s351:bt1#t"), entity_ref("urn:test:s351:bt1#transferor"), 2000.00 USD) { origin case_input; }
        assert "f1": other_property_received_in_transfer(entity_ref("urn:test:s351:bt1#t"), entity_ref("urn:test:s351:bt1#transferor"), 0.00 USD) { origin case_input; }
        assert "f2": transfer_realized_gain(entity_ref("urn:test:s351:bt1#t"), entity_ref("urn:test:s351:bt1#transferor"), 9000.00 USD) { origin case_input; }
    }
    evaluate truth(transfer_boot_recognized_gain(entity_ref("urn:test:s351:bt1#t"), entity_ref("urn:test:s351:bt1#transferor"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

