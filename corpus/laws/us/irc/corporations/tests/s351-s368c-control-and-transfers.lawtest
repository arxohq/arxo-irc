// Sections 368(c), 351 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";

test "S368C-01-EXACTLY-80-PERCENT-IS-CONTROL" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": voting_power_share(entity_ref("urn:test:s368c:c1#p"), entity_ref("urn:test:s368c:c1#corp"), 0.80) { origin case_input; }
        assert "f1": other_classes_share(entity_ref("urn:test:s368c:c1#p"), entity_ref("urn:test:s368c:c1#corp"), 0.80) { origin case_input; }
    }
    evaluate truth(controls_80(entity_ref("urn:test:s368c:c1#p"), entity_ref("urn:test:s368c:c1#corp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S368C-02-79-POINT-9-PERCENT-IS-NOT-CONTROL" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": voting_power_share(entity_ref("urn:test:s368c:c2#p"), entity_ref("urn:test:s368c:c2#corp"), 0.799) { origin case_input; }
        assert "f1": other_classes_share(entity_ref("urn:test:s368c:c2#p"), entity_ref("urn:test:s368c:c2#corp"), 0.799) { origin case_input; }
    }
    evaluate truth(controls_80(entity_ref("urn:test:s368c:c2#p"), entity_ref("urn:test:s368c:c2#corp")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S351-01-CONTROL-AT-80-PERCENT-NONRECOGNITION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": transfer_to_corporation(entity_ref("urn:test:s351:c1#t"), entity_ref("urn:test:s351:c1#transferor"), entity_ref("urn:test:s351:c1#corp")) { origin case_input; }
        assert "f1": solely_for_stock(entity_ref("urn:test:s351:c1#t"), entity_ref("urn:test:s351:c1#transferor")) { origin case_input; }
        assert "f2": voting_power_share(entity_ref("urn:test:s351:c1#transferor"), entity_ref("urn:test:s351:c1#corp"), 0.80) { origin case_input; }
        assert "f3": other_classes_share(entity_ref("urn:test:s351:c1#transferor"), entity_ref("urn:test:s351:c1#corp"), 0.80) { origin case_input; }
    }
    evaluate truth(section_351_nonrecognition(entity_ref("urn:test:s351:c1#t"), entity_ref("urn:test:s351:c1#transferor")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

