        assert "f2": statement_of_grounds_submitted_on_534c(entity_ref("urn:test:s534:b#c"), entity_ref("urn:test:s534:b#y"), @2024-03-20) { origin case_input; }
        assert "f3": statement_includes_supporting_facts_534c(entity_ref("urn:test:s534:b#c"), entity_ref("urn:test:s534:b#y")) { origin case_input; }
    }
    evaluate truth(statement_deadline_effective_534c(entity_ref("urn:test:s534:b#c"), entity_ref("urn:test:s534:b#y"), @2024-03-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


