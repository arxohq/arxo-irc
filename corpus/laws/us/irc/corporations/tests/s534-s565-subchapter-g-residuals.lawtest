    }
    evaluate truth(section_565_applies_to_withholding_case_565e(entity_ref("urn:test:s565:h#sh"), entity_ref("urn:test:s565:h#c"), entity_ref("urn:test:s565:h#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}


