// Section 537(b)(1): needs 400000 within the 500000 ceiling.
test "S537B1-01-NEEDS-WITHIN-303A-CEILING" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": shareholder_death_year_537b1(entity_ref("urn:test:s537:a#c"), entity_ref("urn:test:s537:a#dy")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s537:a#dy"), @2020-01-01) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s537:a#y"), @2020-01-01) { origin case_input; }
        assert "f3": stock_needed_for_redemption_included_in_gross_estate_537b1(entity_ref("urn:test:s537:a#c"), entity_ref("urn:test:s537:a#y"), 400000.00 USD) { origin case_input; }
        assert "f4": redemption_ceiling_303a_for_537(entity_ref("urn:test:s537:a#c"), entity_ref("urn:test:s537:a#y"), 500000.00 USD) { origin case_input; }
    }
    evaluate truth(section_303_redemption_needs_capped_537b1(entity_ref("urn:test:s537:a#c"), entity_ref("urn:test:s537:a#y"), 400000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


