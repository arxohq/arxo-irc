// Subchapter G residuals: sections 534(c)-(d), 537(b), 544, 545(c), 547(b)-(g), 562, 563(c), 564, 565(c)-(f)
// Stage 3b scenarios. NOT EXECUTED (implemented_unverified; NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.corporations version "0.1.1";
namespace "urn:us:irc:corporations:clir";


// Section 534(c): prescribed 2024-04-30 is more than 30 days after the 2024-03-01 mailing: it stands.
test "S534C-01-PRESCRIBED-DEADLINE-OVER-30-DAYS-STANDS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": notification_mailed_on_534b(entity_ref("urn:test:s534:a#c"), entity_ref("urn:test:s534:a#y"), @2024-03-01) { origin case_input; }
        assert "f1": statement_deadline_prescribed_534c(entity_ref("urn:test:s534:a#c"), entity_ref("urn:test:s534:a#y"), @2024-04-30) { origin case_input; }
        assert "f2": statement_of_grounds_submitted_on_534c(entity_ref("urn:test:s534:a#c"), entity_ref("urn:test:s534:a#y"), @2024-04-01) { origin case_input; }
        assert "f3": statement_includes_supporting_facts_534c(entity_ref("urn:test:s534:a#c"), entity_ref("urn:test:s534:a#y")) { origin case_input; }
    }
    evaluate truth(statement_deadline_effective_534c(entity_ref("urn:test:s534:a#c"), entity_ref("urn:test:s534:a#y"), @2024-04-30));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}


// Prescribed 2024-03-15 (14 days) is raised to 2024-03-31 (30 days).
