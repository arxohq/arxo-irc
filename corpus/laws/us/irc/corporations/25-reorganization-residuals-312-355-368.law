// Stage 3b (26.09.2026, TECH_GAP reduction). Section 312(g), (i), (l), (m)
// (earnings and profits residuals), section 355(c), (f)-(h) (corporate-level
// nonrecognition, intragroup and investment-corporation and REIT
// exclusions), section 368(a)(2)(A), (C)-(H), (a)(3) and (b) (special rules
// for reorganizations and "party to a reorganization"). Status
// implemented_unverified: nothing here was executed.

// --- Section 312(g): pre-March 1, 1913 increase in value ----------------------------

use self::{
    Asset,
    ControlledCorporationDistribution,
    Corporation,
    DistributionEvent,
    IRC_S312_G,
    IRC_S312_I,
    IRC_S312_L,
    IRC_S312_M,
    IRC_S355_C,
    IRC_S355_F,
    IRC_S355_G,
    IRC_S355_H,
    IRC_S355_NOTE_5,
    IRC_S368_A,
    IRC_S368_B,
    Partnership,
    Person,
    ReorganizationTransaction,
    ReorganizationTypeKind,
    TaxableYear,
    asset_transfer_with_control_368d,
    control_304c,
    controlled_stock_not_qualified_property_355d,
    controlled_stock_not_qualified_property_355e,
    distribution_part_of_355e_plan,
    party_to_a_reorganization,
    reorganization,
    reorganization_c_and_d_both_described,
    section_355_nonrecognition,
    stock_or_securities_distributed_under_354_355_356,
    title_11_or_similar_case,
};

pub relation ep_change_difference_from_1913_basis_312g1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount by which an increase or decrease in earnings and profits for a period beginning after February 28, 1913 would differ had the adjusted basis been determined without regard to its March 1, 1913 value (section 312(g)(1))";
}
pub relation pre_1913_value_part_increase_312g1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase made in that part of earnings and profits consisting of increase in value of property accrued before March 1, 1913, properly reflecting the difference (section 312(g)(1)); JUDGMENT CALL: the amount is the asserted difference";
}
@source(IRC_S312_G, quote = "an increase (properly reflecting such difference) shall be made in that part of the earnings and profits consisting of increase in value of property accrued before March 1, 1913.")
rule Section312g1Rule(c: Corporation, y: TaxableYear, difference: Money) defeasible {
    label en official "section 312(g)(1): the pre-1913 part is increased by the difference, except where paragraph (2) applies";
    when ep_change_difference_from_1913_basis_312g1(c, y, difference);
    when not_known(section_312g2_applies(c, y));
    when difference > 0.00 USD;
    then pre_1913_value_part_increase_312g1(c, y, difference);
}
pub relation section_312g2_applies(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "helper: subsection (f) applied to a post-February 28, 1913 disposition results in a loss to be applied in decrease of earnings and profits";
}
pub relation loss_applied_in_decrease_of_ep_312g2(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the loss resulting from applying subsection (f) to a sale or other disposition after February 28, 1913, to be applied in decrease of earnings and profits";
}
pub relation adjusted_basis_used_in_determining_loss_312g2(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis of the property used in determining the loss";
}
pub relation adjusted_basis_without_1913_value_312g2(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis computed without regard to the value of the property on March 1, 1913";
}
@source(IRC_S312_G, quote = "If the application of subsection (f) to a sale or other disposition after February 28, 1913, results in a loss which is to be applied in decrease of earnings and profits")
rule Section312g2HelperRule(c: Corporation, y: TaxableYear, loss: Money) defeasible {
    label en unofficial "helper: a loss applied in decrease of earnings and profits";
    when loss_applied_in_decrease_of_ep_312g2(c, y, loss);
    then section_312g2_applies(c, y);
}
pub relation basis_excess_reduction_312g2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount by which the adjusted basis used in determining the loss exceeds the adjusted basis computed without regard to the March 1, 1913 value (section 312(g)(2))";
}
@source(IRC_S312_G, quote = "the amount of such loss so to be applied shall be reduced by the amount, if any, by which the adjusted basis of the property used in determining the loss exceeds the adjusted basis computed without regard to the value of the property on March 1, 1913")
rule Section312g2ReductionRule(c: Corporation, y: TaxableYear, used: Money, without: Money) defeasible {
    label en official "section 312(g)(2): the excess of the basis used over the basis without the 1913 value";
    when adjusted_basis_used_in_determining_loss_312g2(c, y, used);
    when adjusted_basis_without_1913_value_312g2(c, y, without);
    when used > without;
    then basis_excess_reduction_312g2(c, y, used - without);
}
@source(IRC_S312_G, quote = "the amount, if any, by which the adjusted basis of the property used in determining the loss exceeds the adjusted basis computed without regard to the value of the property on March 1, 1913")
rule Section312g2NoReductionRule(c: Corporation, y: TaxableYear, used: Money, without: Money) defeasible {
    label en official "section 312(g)(2): no excess, no reduction";
    when adjusted_basis_used_in_determining_loss_312g2(c, y, used);
    when adjusted_basis_without_1913_value_312g2(c, y, without);
    when used <= without;
    then basis_excess_reduction_312g2(c, y, 0.00 USD);
}
pub relation loss_applied_after_reduction_312g2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the loss actually applied in decrease of earnings and profits after the reduction (section 312(g)(2))";
}
@source(IRC_S312_G, quote = "the amount of such loss so to be applied shall be reduced by the amount")
rule Section312g2LossRemainsRule(c: Corporation, y: TaxableYear, loss: Money, reduction: Money) defeasible {
    label en official "section 312(g)(2): the loss less the reduction, when the loss is larger";
    when loss_applied_in_decrease_of_ep_312g2(c, y, loss);
    when basis_excess_reduction_312g2(c, y, reduction);
    when loss >= reduction;
    then loss_applied_after_reduction_312g2(c, y, loss - reduction);
}
@source(IRC_S312_G, quote = "the amount of such loss so to be applied shall be reduced by the amount")
rule Section312g2LossConsumedRule(c: Corporation, y: TaxableYear, loss: Money, reduction: Money) defeasible {
    label en official "section 312(g)(2): the reduction exceeds the loss: nothing is applied";
    when loss_applied_in_decrease_of_ep_312g2(c, y, loss);
    when basis_excess_reduction_312g2(c, y, reduction);
    when loss < reduction;
    then loss_applied_after_reduction_312g2(c, y, 0.00 USD);
}
pub relation pre_1913_value_part_increase_from_excess_312g2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the reduction over the loss increases that part of earnings and profits consisting of increase in value accrued before March 1, 1913 (section 312(g)(2), last clause)";
}
@source(IRC_S312_G, quote = "and if such amount so applied in reduction of the decrease exceeds such loss, the excess over such loss shall increase that part of the earnings and profits consisting of increase in value of property accrued before March 1, 1913.")
rule Section312g2ExcessIncreaseRule(c: Corporation, y: TaxableYear, loss: Money, reduction: Money) defeasible {
    label en official "section 312(g)(2): the excess of the reduction over the loss";
    when loss_applied_in_decrease_of_ep_312g2(c, y, loss);
    when basis_excess_reduction_312g2(c, y, reduction);
    when reduction > loss;
    then pre_1913_value_part_increase_from_excess_312g2(c, y, reduction - loss);
}

// --- Section 312(i): distribution of proceeds of a federally insured loan ---------

pub relation loan_made_guaranteed_or_insured_by_united_states_312i(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "at the time of distribution there is outstanding a loan to the corporation made, guaranteed or insured by the United States (or an agency or instrumentality), in this amount (section 312(i)(1))";
}
pub relation commitment_to_make_guarantee_or_insure_loan_312i(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "a commitment to make, guarantee or insure a loan, in this amount (section 312(i), last sentence)";
}
pub relation adjusted_basis_of_security_property_312i(dist: DistributionEvent, amount: Money) kind empirical {
    label en official "the adjusted basis of the property constituting security for the loan at the time of distribution, determined without regard to any adjustment under section 1016(a)(2) (section 312(i)(2))";
}
pub relation loan_treated_as_outstanding_312i(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "the loan, or the commitment treated as the making, guaranteeing or insuring of a loan (section 312(i), last sentence)";
}
@source(IRC_S312_I, quote = "there is outstanding a loan to such corporation which was made, guaranteed, or insured by the United States")
rule Section312iLoanRule(dist: DistributionEvent, amount: Money) defeasible {
    label en official "section 312(i)(1): the outstanding loan";
    when loan_made_guaranteed_or_insured_by_united_states_312i(dist, amount);
    then loan_treated_as_outstanding_312i(dist, amount);
}
@source(IRC_S312_I, quote = "a commitment to make, guarantee, or insure a loan shall be treated as the making, guaranteeing, or insuring of a loan.")
rule Section312iCommitmentRule(dist: DistributionEvent, amount: Money) defeasible {
    label en official "section 312(i): a commitment counts as a loan";
    when commitment_to_make_guarantee_or_insure_loan_312i(dist, amount);
    then loan_treated_as_outstanding_312i(dist, amount);
}
pub relation ep_increase_loan_excess_312i(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "earnings and profits are increased by the amount by which the loan exceeds the adjusted basis of the security property (section 312(i))";
}
@source(IRC_S312_I, quote = "then the earnings and profits of the corporation shall be increased by the amount of such excess")
rule Section312iIncreaseRule(dist: DistributionEvent, loan: Money, basis: Money) defeasible {
    label en official "section 312(i): increase by the excess of the loan over the security property basis";
    when loan_treated_as_outstanding_312i(dist, loan);
    when adjusted_basis_of_security_property_312i(dist, basis);
    when loan > basis;
    then ep_increase_loan_excess_312i(dist, loan - basis);
}
pub relation ep_decrease_after_distribution_312i(dist: DistributionEvent, amount: Money) kind institutional {
    label en official "immediately after the distribution earnings and profits are decreased by the same amount (section 312(i))";
}
@source(IRC_S312_I, quote = "and (immediately after the distribution) shall be decreased by the amount of such excess.")
rule Section312iDecreaseRule(dist: DistributionEvent, amount: Money) defeasible {
    label en official "section 312(i): the offsetting decrease immediately after the distribution";
    when ep_increase_loan_excess_312i(dist, amount);
    then ep_decrease_after_distribution_312i(dist, amount);
}

// --- Section 312(l): discharge of indebtedness income ------------------------------

pub relation discharge_income_applied_to_reduce_basis_1017_312l1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the discharge of indebtedness income to the extent of the amount applied to reduce basis under section 1017";
}
pub relation ep_excludes_discharge_income_312l1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "earnings and profits do not include that discharge of indebtedness income (section 312(l)(1))";
}
@source(IRC_S312_L, quote = "The earnings and profits of a corporation shall not include income from the discharge of indebtedness to the extent of the amount applied to reduce basis under section 1017.")
rule Section312l1Rule(c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 312(l)(1): the basis-reduced amount is excluded from earnings and profits";
    when discharge_income_applied_to_reduce_basis_1017_312l1(c, y, amount);
    then ep_excludes_discharge_income_312l1(c, y, amount);
}
pub relation shareholder_interest_terminated_in_title_11_case_312l2(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the interest of a shareholder is terminated or extinguished in a title 11 or similar case (within the meaning of section 368(a)(3)(A))";
}
pub relation deficit_in_earnings_and_profits_312l2(c: Corporation, y: TaxableYear, deficit: Money) kind empirical {
    label en official "there is a deficit in the earnings and profits of the corporation, in this amount";
}
pub relation paid_in_capital_allocable_to_terminated_interest_312l2(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the paid-in capital allocable to the interest of the shareholder which is terminated or extinguished";
}
pub relation deficit_after_reduction_312l2(c: Corporation, y: TaxableYear, deficit: Money) kind institutional {
    label en official "the deficit reduced by the allocable paid-in capital (section 312(l)(2)); JUDGMENT CALL: the text states no floor, so the reduction is applied literally";
}
@source(IRC_S312_L, quote = "then such deficit shall be reduced by an amount equal to the paid-in capital which is allocable to the interest of the shareholder which is so terminated or extinguished.")
rule Section312l2Rule(c: Corporation, y: TaxableYear, deficit: Money, paid_in: Money) defeasible {
    label en official "section 312(l)(2): reduction of the deficit by the allocable paid-in capital";
    when shareholder_interest_terminated_in_title_11_case_312l2(c, y);
    when deficit_in_earnings_and_profits_312l2(c, y, deficit);
    when paid_in_capital_allocable_to_terminated_interest_312l2(c, y, paid_in);
    then deficit_after_reduction_312l2(c, y, deficit - paid_in);
}

// --- Section 312(m): interest on registration-required obligations ------------------

pub relation interest_not_deductible_by_163f_312m(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest with respect to which a deduction is not or would not be allowable by reason of section 163(f)";
}
pub relation issuer_foreign_corporation_not_cfc_312m(c: Corporation) kind empirical {
    label en official "at the time of issuance the issuer is a foreign corporation that is not a controlled foreign corporation within the meaning of section 957";
}
pub relation issuance_without_163f_avoidance_purpose_312m(c: Corporation) kind empirical {
    label en official "the issuance did not have as a purpose the avoidance of section 163(f) — an evaluative element asserted with origin adjudicated (DECISION-0194 channel 2)";
}
pub relation ep_not_decreased_by_interest_312m(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings and profits are not decreased by this interest (section 312(m))";
}
@source(IRC_S312_M, quote = "The earnings and profits of any corporation shall not be decreased by any interest with respect to which a deduction is not or would not be allowable by reason of section 163(f)")
rule Section312mRule(c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 312(m): no decrease for interest disallowed by section 163(f), save for the foreign non-CFC issuer without avoidance purpose";
    when interest_not_deductible_by_163f_312m(c, y, amount);
    unless issuer_foreign_corporation_not_cfc_312m(c) and issuance_without_163f_avoidance_purpose_312m(c) and interest_not_deductible_by_163f_312m(c, y, amount);
    then ep_not_decreased_by_interest_312m(c, y, amount);
}

// --- Section 355(c): taxability of the distributing corporation -------------------------

pub relation distribution_in_pursuance_of_plan_of_reorganization_355c1(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the distribution is in pursuance of a plan of reorganization (section 355(c)(1))";
}
pub relation distributed_property_355c(cd: ControlledCorporationDistribution, prop: Asset, fmv: Money, basis: Money) kind empirical {
    label en official "property distributed by the distributing corporation, with its fair market value and its adjusted basis in the hands of the distributing corporation";
}
pub relation distributed_property_is_controlled_stock_or_securities_355c2b(cd: ControlledCorporationDistribution, prop: Asset) kind empirical {
    label en official "the distributed property is stock or securities in the controlled corporation";
}
pub relation liability_on_distributed_property_355c2c(cd: ControlledCorporationDistribution, prop: Asset, amount: Money) kind empirical {
    label en official "the property is subject to a liability, or the shareholder assumes a liability of the distributing corporation in connection with the distribution (section 355(c)(2)(C))";
}
pub relation corporate_nonrecognition_355c1(cd: ControlledCorporationDistribution) kind institutional {
    label en official "no gain or loss is recognized to the distributing corporation on the distribution, except for appreciated property other than qualified property (section 355(c)(1))";
}
@source(IRC_S355_C, quote = "no gain or loss shall be recognized to a corporation on any distribution to which this section (or so much of section 356 as relates to this section) applies and which is not in pursuance of a plan of reorganization.")
rule Section355c1Rule(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation, holder: Person) defeasible {
    label en official "section 355(c)(1): corporate nonrecognition for a section 355 distribution not in pursuance of a reorganization plan";
    when section_355_nonrecognition(cd, distributing, controlled, holder);
    when not_known(distribution_in_pursuance_of_plan_of_reorganization_355c1(cd));
    then corporate_nonrecognition_355c1(cd);
}
pub relation qualified_property_355c2b(cd: ControlledCorporationDistribution, prop: Asset) kind institutional {
    label en official "qualified property: any stock or securities in the controlled corporation, unless section 355(d) or (e) denies that treatment (section 355(c)(2)(B), (d)(1), (e)(1))";
}
@source(IRC_S355_C, quote = "the term \"qualified property\" means any stock or securities in the controlled corporation.")
rule Section355c2bRule(cd: ControlledCorporationDistribution, prop: Asset) defeasible {
    label en official "section 355(c)(2)(B): controlled stock or securities, save where a disqualified distribution (d) or a section 355(e) plan removes qualified-property treatment";
    when distributed_property_is_controlled_stock_or_securities_355c2b(cd, prop);
    when not_known(controlled_stock_not_qualified_property_355d(cd));
    when not_known(controlled_stock_not_qualified_property_355e(cd));
    then qualified_property_355c2b(cd, prop);
}
pub relation effective_fair_market_value_355c2c(cd: ControlledCorporationDistribution, prop: Asset, amount: Money) kind institutional {
    label en official "the fair market value of the property, treated as not less than the amount of any liability to which it is subject or which the shareholder assumes (section 355(c)(2)(C))";
}
pub relation liability_present_355c2c(cd: ControlledCorporationDistribution, prop: Asset) kind institutional {
    label en unofficial "helper: the property is subject to a liability or a liability is assumed in connection with it";
}
rule Section355c2cLiabilityHelperRule(cd: ControlledCorporationDistribution, prop: Asset, amount: Money) defeasible {
    label en unofficial "helper: a liability exists for the property";
    when liability_on_distributed_property_355c2c(cd, prop, amount);
    then liability_present_355c2c(cd, prop);
}
@source(IRC_S355_C, quote = "then, for purposes of subparagraph (A), the fair market value of such property shall be treated as not less than the amount of such liability.")
rule Section355c2cNoLiabilityRule(cd: ControlledCorporationDistribution, prop: Asset, fmv: Money, basis: Money) defeasible {
    label en official "section 355(c)(2)(C): no liability, the fair market value stands";
    when distributed_property_355c(cd, prop, fmv, basis);
    when not_known(liability_present_355c2c(cd, prop));
    then effective_fair_market_value_355c2c(cd, prop, fmv);
}
@source(IRC_S355_C, quote = "then, for purposes of subparagraph (A), the fair market value of such property shall be treated as not less than the amount of such liability.")
rule Section355c2cAboveLiabilityRule(cd: ControlledCorporationDistribution, prop: Asset, fmv: Money, basis: Money, liability: Money) defeasible {
    label en official "section 355(c)(2)(C): the fair market value is at least the liability";
    when distributed_property_355c(cd, prop, fmv, basis);
    when liability_on_distributed_property_355c2c(cd, prop, liability);
    when fmv >= liability;
    then effective_fair_market_value_355c2c(cd, prop, fmv);
}
@source(IRC_S355_C, quote = "then, for purposes of subparagraph (A), the fair market value of such property shall be treated as not less than the amount of such liability.")
rule Section355c2cBelowLiabilityRule(cd: ControlledCorporationDistribution, prop: Asset, fmv: Money, basis: Money, liability: Money) defeasible {
    label en official "section 355(c)(2)(C): the fair market value below the liability is raised to the liability";
    when distributed_property_355c(cd, prop, fmv, basis);
    when liability_on_distributed_property_355c2c(cd, prop, liability);
    when fmv < liability;
    then effective_fair_market_value_355c2c(cd, prop, liability);
}
pub relation gain_recognized_on_appreciated_property_355c2a(cd: ControlledCorporationDistribution, prop: Asset, amount: Money) kind institutional {
    label en official "gain is recognized to the distributing corporation as if the property were sold to the distributee at its fair market value (section 355(c)(2)(A))";
}
@source(IRC_S355_C, quote = "then gain shall be recognized to the distributing corporation as if such property were sold to the distributee at its fair market value.")
rule Section355c2aRule(cd: ControlledCorporationDistribution, distributing: Corporation, controlled: Corporation, holder: Person, prop: Asset, fmv: Money, basis: Money, eff_fmv: Money) defeasible {
    label en official "section 355(c)(2)(A): appreciated property other than qualified property, in a distribution not in pursuance of a reorganization plan";
    when section_355_nonrecognition(cd, distributing, controlled, holder);
    when not_known(distribution_in_pursuance_of_plan_of_reorganization_355c1(cd));
    when distributed_property_355c(cd, prop, fmv, basis);
    when not_known(qualified_property_355c2b(cd, prop));
    when effective_fair_market_value_355c2c(cd, prop, eff_fmv);
    when eff_fmv > basis;
    then gain_recognized_on_appreciated_property_355c2a(cd, prop, eff_fmv - basis);
}
pub relation sections_311_and_336a_disapplied_355c3(cd: ControlledCorporationDistribution) kind institutional {
    label en official "sections 311 and 336(a) do not apply to a distribution referred to in paragraph (1) (section 355(c)(3)); the module 02 section 311 rules are keyed on DistributionEvent and are not re-wired (G4018)";
}
@source(IRC_S355_C, quote = "Sections 311 and 336(a) shall not apply to any distribution referred to in paragraph (1).")
rule Section355c3Rule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 355(c)(3): coordination with sections 311 and 336(a)";
    when corporate_nonrecognition_355c1(cd);
    then sections_311_and_336a_disapplied_355c3(cd);
}

// --- Sections 355(f)-(h): situations where section 355 does not apply ------------------

pub relation section_355_disapplied_355fgh(cd: ControlledCorporationDistribution) kind institutional {
    label en official "section 355 (and so much of section 356 as relates to it) does not apply to the distribution by reason of subsection (f), (g) or (h)";
}
pub relation intragroup_stock_distribution_355f(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the distribution of stock is from one member of an affiliated group (section 1504(a)) to another member of the group (section 355(f))";
}
pub relation regulations_except_intragroup_distribution_355f(cd: ControlledCorporationDistribution) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: regulations provide an exception to subsection (f)";
}
@source(IRC_S355_F, quote = "this section (or so much of section 356 as relates to this section) shall not apply to the distribution of stock from 1 member of an affiliated group (as defined in section 1504(a)) to another member of such group if such distribution is part of a plan (or series of related transactions) described in subsection (e)(2)(A)(ii)")
rule Section355fRule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 355(f): an intragroup distribution that is part of a section 355(e) plan is outside section 355, save as regulations provide";
    when intragroup_stock_distribution_355f(cd);
    when distribution_part_of_355e_plan(cd);
    when not_known(regulations_except_intragroup_distribution_355f(cd));
    then section_355_disapplied_355fgh(cd);
}
pub relation transaction_series_355g4(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the distribution is part of a series of transactions (section 355(g)(4): the term transaction includes a series of transactions)";
}
pub relation distribution_part_of_a_transaction_355g1(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the distribution is part of a transaction";
}
pub relation transaction_including_series_355g(cd: ControlledCorporationDistribution) kind institutional {
    label en official "the distribution is part of a transaction, which includes a series of transactions (section 355(g)(1), (4))";
}
@source(IRC_S355_G, quote = "For purposes of this subsection, the term \"transaction\" includes a series of transactions.")
rule Section355g4SeriesRule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 355(g)(4): a series of transactions is a transaction";
    when transaction_series_355g4(cd);
    then transaction_including_series_355g(cd);
}
@source(IRC_S355_G, quote = "any distribution which is part of a transaction if—")
rule Section355g1TransactionRule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 355(g)(1): the distribution is part of a transaction";
    when distribution_part_of_a_transaction_355g1(cd);
    then transaction_including_series_355g(cd);
}
pub relation asset_of_corporation_355g(corp: Corporation, asset: Asset, fmv: Money) kind empirical {
    label en official "an asset of the distributing or controlled corporation, with its fair market value; the ratable shares of the assets of a 20-percent controlled entity and of qualifying partnerships (look-through) are asserted as assets of the corporation (section 355(g)(2)(B)(iv)(II), (v)(II))";
}
pub relation asset_of_investment_type_355g2bi(asset: Asset) kind empirical {
    label en official "the asset is cash, stock or securities in a corporation, a partnership interest, a debt instrument, an option, forward, futures, notional principal contract or derivative, foreign currency, or a similar asset (section 355(g)(2)(B)(i)(I)-(VII))";
}
pub relation asset_held_in_active_financial_business_355g2bii(asset: Asset) kind empirical {
    label en official "the asset is held for use in the active and regular conduct of a lending or finance business, a banking business or an insurance business (section 355(g)(2)(B)(ii)(I)-(III))";
}
pub relation financial_business_income_substantially_all_unrelated_355g2bii(asset: Asset) kind empirical {
    label en official "substantially all of the income of that business is derived from persons not related within section 267(b) or 707(b)(1) (section 355(g)(2)(B)(ii), last sentence)";
}
pub relation dealer_marked_to_market_security_355g2biii(asset: Asset) kind empirical {
    label en official "the asset is a security (section 475(c)(2)) held by a dealer in securities to which section 475(a) applies";
}
pub relation stock_or_debt_of_20_percent_controlled_entity_355g2biv(asset: Asset) kind empirical {
    label en official "the asset is stock or securities in, or a debt instrument or derivative issued by, a 20-percent controlled entity (section 355(g)(2)(B)(iv)(I))";
}
pub relation partnership_interest_of_business_taken_into_account_355g2bv(asset: Asset) kind empirical {
    label en official "the asset is an interest in, or a debt instrument issued by, a partnership one or more of whose businesses are taken into account in the section 355(b) test (section 355(g)(2)(B)(v)(I))";
}
pub relation total_assets_fmv_355g(corp: Corporation, amount: Money) kind institutional {
    label en official "the fair market value of all assets of the corporation";
}
@source(IRC_S355_G, quote = "the fair market value of the investment assets of the corporation is—")
rule Section355gTotalAssetsRule(corp: Corporation) defeasible {
    label en official "section 355(g)(2)(A): the denominator, an exact sum over the asserted assets";
    when asset_of_corporation_355g(corp, _, _);
    then total_assets_fmv_355g(corp, sum all v: Money for a: Asset where asset_of_corporation_355g(corp, a, v));
}
pub relation candidate_investment_assets_fmv_355g(corp: Corporation, amount: Money) kind institutional {
    label en unofficial "helper: the fair market value of assets of investment type outside exceptions (iii), (iv) and (v)";
}
@source(IRC_S355_G, quote = "Except as otherwise provided in this subparagraph, the term \"investment assets\" means—")
rule Section355gCandidateRule(corp: Corporation) defeasible {
    label en unofficial "helper: candidate investment assets";
    when asset_of_corporation_355g(corp, _, _);
    then candidate_investment_assets_fmv_355g(corp, sum all v: Money for a: Asset where asset_of_corporation_355g(corp, a, v) and asset_of_investment_type_355g2bi(a) and not dealer_marked_to_market_security_355g2biii(a) and not stock_or_debt_of_20_percent_controlled_entity_355g2biv(a) and not partnership_interest_of_business_taken_into_account_355g2bv(a));
}
pub relation financial_business_assets_fmv_355g(corp: Corporation, amount: Money) kind institutional {
    label en unofficial "helper: the fair market value of candidate assets held in a qualifying active financial business (exception (ii))";
}
@source(IRC_S355_G, quote = "Such term shall not include any asset which is held for use in the active and regular conduct of—")
rule Section355gFinancialRule(corp: Corporation) defeasible {
    label en unofficial "helper: candidate assets excluded by clause (ii)";
    when asset_of_corporation_355g(corp, _, _);
    then financial_business_assets_fmv_355g(corp, sum all v: Money for a: Asset where asset_of_corporation_355g(corp, a, v) and asset_of_investment_type_355g2bi(a) and not dealer_marked_to_market_security_355g2biii(a) and not stock_or_debt_of_20_percent_controlled_entity_355g2biv(a) and not partnership_interest_of_business_taken_into_account_355g2bv(a) and asset_held_in_active_financial_business_355g2bii(a) and financial_business_income_substantially_all_unrelated_355g2bii(a));
}
pub relation investment_assets_fmv_355g(corp: Corporation, amount: Money) kind institutional {
    label en official "the fair market value of the corporation's investment assets (section 355(g)(2)(B))";
}
@source(IRC_S355_G, quote = "This clause shall only apply with respect to any business if substantially all of the income of the business is derived from persons who are not related")
rule Section355gInvestmentAssetsRule(corp: Corporation, candidate: Money, financial: Money) defeasible {
    label en official "section 355(g)(2)(B): candidate assets less the financial-business exception";
    when candidate_investment_assets_fmv_355g(corp, candidate);
    when financial_business_assets_fmv_355g(corp, financial);
    then investment_assets_fmv_355g(corp, candidate - financial);
}
pub relation distribution_date_355g(cd: ControlledCorporationDistribution, on: Date) kind empirical {
    label en official "the date of the distribution (the same fact as module 11 distribution_date_355 is not read: this test needs the date next to the ratio)";
}
pub relation corporation_of_distribution_355g(cd: ControlledCorporationDistribution, corp: Corporation) kind empirical {
    label en official "the distributing corporation or a controlled corporation of the distribution";
}
pub relation disqualified_investment_corporation_355g2a(cd: ControlledCorporationDistribution, corp: Corporation) kind institutional {
    label en official "disqualified investment corporation: investment assets are 2/3 or more (3/4 or more during the first year after enactment, May 17, 2006) of the fair market value of all assets (section 355(g)(2)(A))";
}
@source(IRC_S355_NOTE_5, quote = "shall apply to distributions after the date of the enactment of this Act [May 17, 2006].")
rule Section355g2aTwoThirdsRule(cd: ControlledCorporationDistribution, corp: Corporation, on: Date, investment: Money, total: Money) defeasible {
    label en official "section 355(g)(2)(A)(i): distributions after the first year: 2/3 or more (investment x 3 >= total x 2)";
    when corporation_of_distribution_355g(cd, corp);
    when distribution_date_355g(cd, on);
    when on >= add_calendar_period(@2006-05-17, 1 calendar_year);
    when investment_assets_fmv_355g(corp, investment);
    when total_assets_fmv_355g(corp, total);
    when investment * 3 >= total * 2;
    then disqualified_investment_corporation_355g2a(cd, corp);
}
@source(IRC_S355_NOTE_5, quote = "shall apply to distributions after the date of the enactment of this Act [May 17, 2006].")
rule Section355g2aThreeQuartersRule(cd: ControlledCorporationDistribution, corp: Corporation, on: Date, investment: Money, total: Money) defeasible {
    label en official "section 355(g)(2)(A)(ii): distributions during the first year: 3/4 or more (investment x 4 >= total x 3)";
    when corporation_of_distribution_355g(cd, corp);
    when distribution_date_355g(cd, on);
    when on < add_calendar_period(@2006-05-17, 1 calendar_year);
    when on >= @2006-05-17;
    when investment_assets_fmv_355g(corp, investment);
    when total_assets_fmv_355g(corp, total);
    when investment * 4 >= total * 3;
    then disqualified_investment_corporation_355g2a(cd, corp);
}
pub relation interest_after_transaction_355g(person: Person, corp: Corporation, voting: Decimal, value: Decimal) kind empirical {
    label en official "the person's share of the voting power and of the value of the corporation immediately after the transaction, after the section 318 attribution required by section 355(g)(3)(B) (asserted, module 03 is not re-run: G4019)";
}
pub relation interest_before_transaction_355g(person: Person, corp: Corporation, voting: Decimal, value: Decimal) kind empirical {
    label en official "the person's share of the voting power and of the value of the corporation immediately before the transaction, after attribution";
}
pub relation holds_50_percent_interest_after_355g(person: Person, corp: Corporation) kind institutional {
    label en official "the person holds a 50-percent or greater interest (355(d)(4): 50 percent or more of the voting power or of the value) immediately after the transaction (section 355(g)(3)(A))";
}
@source(IRC_S355_G, quote = "The term \"50-percent or greater interest\" has the meaning given such term by subsection (d)(4).")
rule Section355g3aAfterVotingRule(person: Person, corp: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 355(g)(3)(A): 50 percent of the voting power after the transaction";
    when interest_after_transaction_355g(person, corp, voting, value);
    when voting >= 0.50;
    then holds_50_percent_interest_after_355g(person, corp);
}
@source(IRC_S355_G, quote = "The term \"50-percent or greater interest\" has the meaning given such term by subsection (d)(4).")
rule Section355g3aAfterValueRule(person: Person, corp: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 355(g)(3)(A): 50 percent of the value after the transaction";
    when interest_after_transaction_355g(person, corp, voting, value);
    when value >= 0.50;
    then holds_50_percent_interest_after_355g(person, corp);
}
pub relation held_50_percent_interest_before_355g(person: Person, corp: Corporation) kind institutional {
    label en official "the person held a 50-percent or greater interest immediately before the transaction";
}
@source(IRC_S355_G, quote = "but only if such person did not hold such an interest in such corporation immediately before the transaction.")
rule Section355g3aBeforeVotingRule(person: Person, corp: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 355(g)(1)(B): held 50 percent of the voting power before";
    when interest_before_transaction_355g(person, corp, voting, value);
    when voting >= 0.50;
    then held_50_percent_interest_before_355g(person, corp);
}
@source(IRC_S355_G, quote = "but only if such person did not hold such an interest in such corporation immediately before the transaction.")
rule Section355g3aBeforeValueRule(person: Person, corp: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 355(g)(1)(B): held 50 percent of the value before";
    when interest_before_transaction_355g(person, corp, voting, value);
    when value >= 0.50;
    then held_50_percent_interest_before_355g(person, corp);
}
@source(IRC_S355_G, quote = "any person holds, immediately after the transaction, a 50-percent or greater interest in any disqualified investment corporation")
rule Section355g1Rule(cd: ControlledCorporationDistribution, corp: Corporation, person: Person) defeasible {
    label en official "section 355(g)(1): the distribution is outside section 355 when it is part of a transaction after which a disqualified investment corporation has a new 50-percent holder";
    when transaction_including_series_355g(cd);
    when disqualified_investment_corporation_355g2a(cd, corp);
    when holds_50_percent_interest_after_355g(person, corp);
    when not_known(held_50_percent_interest_before_355g(person, corp));
    then section_355_disapplied_355fgh(cd);
}
pub relation regulations_prescribed_355g5(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the Secretary has prescribed the regulations necessary to carry out or prevent avoidance of the purposes of subsection (g)";
}
@source(IRC_S355_G, quote = "The Secretary shall prescribe such regulations as may be necessary to carry out, or prevent the avoidance of, the purposes of this subsection")
rule Section355g5RegulationsDutyRule(cd: ControlledCorporationDistribution, corp: Corporation) defeasible {
    label en official "section 355(g)(5): the Secretary shall prescribe implementing regulations; no day count is stated (G4004)";
    when disqualified_investment_corporation_355g2a(cd, corp);
    then duty Section355g5PrescribeRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition regulations_prescribed_355g5(cd);
            window [-infinity, infinity];
        }
    };
}
pub relation reit_party_355h(cd: ControlledCorporationDistribution, corp: Corporation) kind empirical {
    label en official "the distributing corporation or the controlled corporation is a real estate investment trust";
}
pub relation both_reits_immediately_after_355h2a(cd: ControlledCorporationDistribution) kind empirical {
    label en official "immediately after the distribution the distributing corporation and the controlled corporation are both real estate investment trusts (section 355(h)(2)(A))";
}
pub relation distributing_reit_throughout_3_years_355h2bi(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the distributing corporation has been a REIT at all times during the 3-year period ending on the distribution date (section 355(h)(2)(B)(i))";
}
pub relation controlled_trs_of_distributing_throughout_3_years_355h2bii(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the controlled corporation has been a taxable REIT subsidiary (section 856(l)) of the distributing corporation at all times during the period (section 355(h)(2)(B)(ii))";
}
pub relation distributing_had_control_throughout_3_years_355h2biii(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the distributing corporation had section 368(c) control, counting stock owned directly or indirectly through corporations or partnerships, of the controlled corporation at all times during the period (section 355(h)(2)(B)(iii))";
}
pub relation controlled_stock_distributed_by_trs_solely_trs_assets_355h2b(cd: ControlledCorporationDistribution) kind empirical {
    label en official "the controlled corporation's stock was distributed by a taxable REIT subsidiary in a section 355 transaction and its assets consist solely of stock or assets held by taxable REIT subsidiaries of the distributing corporation meeting (ii) and (iii) (section 355(h)(2)(B), deemed satisfaction)";
}
pub relation trs_distribution_exception_355h2b(cd: ControlledCorporationDistribution) kind institutional {
    label en official "the taxable REIT subsidiary exception to paragraph (1) applies (section 355(h)(2)(B))";
}
@source(IRC_S355_H, quote = "the distributing corporation has been a real estate investment trust at all times during the 3-year period ending on the date of such distribution,")
rule Section355h2bDirectRule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 355(h)(2)(B)(i)-(iii): all three conditions";
    when distributing_reit_throughout_3_years_355h2bi(cd);
    when controlled_trs_of_distributing_throughout_3_years_355h2bii(cd);
    when distributing_had_control_throughout_3_years_355h2biii(cd);
    then trs_distribution_exception_355h2b(cd);
}
@source(IRC_S355_H, quote = "A controlled corporation will be treated as meeting the requirements of clauses (ii) and (iii) if the stock of such corporation was distributed by a taxable REIT subsidiary")
rule Section355h2bDeemedRule(cd: ControlledCorporationDistribution) defeasible {
    label en official "section 355(h)(2)(B), last paragraph: a controlled corporation distributed by a TRS with only TRS assets is treated as meeting (ii) and (iii)";
    when distributing_reit_throughout_3_years_355h2bi(cd);
    when controlled_stock_distributed_by_trs_solely_trs_assets_355h2b(cd);
    then trs_distribution_exception_355h2b(cd);
}
pub relation partnership_profits_and_capital_shares_355h(distributing: Corporation, partnership: Partnership, profits: Decimal, capital: Decimal) kind empirical {
    label en official "the distributing corporation's profits interest and capital interest in the partnership";
}
pub relation distributing_controls_partnership_355h(distributing: Corporation, partnership: Partnership) kind institutional {
    label en official "for clause (iii) control of a partnership means ownership of at least 80 percent of the profits interest and at least 80 percent of the capital interests (section 355(h)(2)(B), last sentence)";
}
@source(IRC_S355_H, quote = "For purposes of clause (iii), control of a partnership means ownership of at least 80 percent of the profits interest and at least 80 percent of the capital interests.")
rule Section355hPartnershipControlRule(distributing: Corporation, partnership: Partnership, profits: Decimal, capital: Decimal) defeasible {
    label en official "section 355(h)(2)(B): the partnership control test";
    when partnership_profits_and_capital_shares_355h(distributing, partnership, profits, capital);
    when profits >= 0.80;
    when capital >= 0.80;
    then distributing_controls_partnership_355h(distributing, partnership);
}
@source(IRC_S355_H, quote = "This section (and so much of section 356 as relates to this section) shall not apply to any distribution if either the distributing corporation or controlled corporation is a real estate investment trust.")
rule Section355h1Rule(cd: ControlledCorporationDistribution, corp: Corporation) defeasible {
    label en official "section 355(h)(1): a distribution by or of a REIT is outside section 355, unless paragraph (2) excepts it";
    when reit_party_355h(cd, corp);
    when not_known(both_reits_immediately_after_355h2a(cd));
    when not_known(trs_distribution_exception_355h2b(cd));
    then section_355_disapplied_355fgh(cd);
}

// --- Section 368(a)(2)(A), (C)-(H): special rules for reorganization types ------------

pub relation effective_reorganization_type_368a2(r: ReorganizationTransaction, kind: ReorganizationTypeKind) kind institutional {
    label en official "the type under which the transaction is treated for the purposes of the subchapter after the special rules of section 368(a)(2)(A) and (a)(3)(C)";
}
pub relation also_qualifies_under_332_or_351_368a3C(r: ReorganizationTransaction) kind empirical {
    label en official "the transaction would (but for subparagraph (C)) qualify under section 332 or 351 (section 368(a)(3)(C)(ii))";
}
pub relation reorganization_type_g_and_other_368a3C(r: ReorganizationTransaction) kind institutional {
    label en unofficial "helper: the transaction qualifies under (1)(G) and under another subparagraph of (1) or under section 332 or 351";
}
@source(IRC_S368_A, quote = "under any other subparagraph of paragraph (1) or under section 332 or 351,")
rule Section368a3CWithTypeARule(r: ReorganizationTransaction) defeasible {
    label en unofficial "helper: (1)(G) together with type A";
    when reorganization(r, TypeGInsolvencyReorganization);
    when reorganization(r, TypeAStatutoryMergerOrConsolidation);
    then reorganization_type_g_and_other_368a3C(r);
}
@source(IRC_S368_A, quote = "under any other subparagraph of paragraph (1) or under section 332 or 351,")
rule Section368a3CWithTypeBRule(r: ReorganizationTransaction) defeasible {
    label en unofficial "helper: (1)(G) together with type B";
    when reorganization(r, TypeGInsolvencyReorganization);
    when reorganization(r, TypeBStockForVotingStock);
    then reorganization_type_g_and_other_368a3C(r);
}
@source(IRC_S368_A, quote = "under any other subparagraph of paragraph (1) or under section 332 or 351,")
rule Section368a3CWithTypeCRule(r: ReorganizationTransaction) defeasible {
    label en unofficial "helper: (1)(G) together with type C";
    when reorganization(r, TypeGInsolvencyReorganization);
    when reorganization(r, TypeCSubstantiallyAllForVotingStock);
    then reorganization_type_g_and_other_368a3C(r);
}
@source(IRC_S368_A, quote = "under any other subparagraph of paragraph (1) or under section 332 or 351,")
rule Section368a3CWithTypeDRule(r: ReorganizationTransaction) defeasible {
    label en unofficial "helper: (1)(G) together with type D";
    when reorganization(r, TypeGInsolvencyReorganization);
    when reorganization(r, TypeDAssetTransferWithControlAndDistribution);
    then reorganization_type_g_and_other_368a3C(r);
}
@source(IRC_S368_A, quote = "under any other subparagraph of paragraph (1) or under section 332 or 351,")
rule Section368a3CWithTypeERule(r: ReorganizationTransaction) defeasible {
    label en unofficial "helper: (1)(G) together with type E";
    when reorganization(r, TypeGInsolvencyReorganization);
    when reorganization(r, TypeERecapitalization);
    then reorganization_type_g_and_other_368a3C(r);
}
@source(IRC_S368_A, quote = "under any other subparagraph of paragraph (1) or under section 332 or 351,")
rule Section368a3CWithTypeFRule(r: ReorganizationTransaction) defeasible {
    label en unofficial "helper: (1)(G) together with type F";
    when reorganization(r, TypeGInsolvencyReorganization);
    when reorganization(r, TypeFMereChange);
    then reorganization_type_g_and_other_368a3C(r);
}
@source(IRC_S368_A, quote = "under any other subparagraph of paragraph (1) or under section 332 or 351,")
rule Section368a3CSection332Or351Rule(r: ReorganizationTransaction) defeasible {
    label en unofficial "helper: (1)(G) together with section 332 or 351";
    when reorganization(r, TypeGInsolvencyReorganization);
    when also_qualifies_under_332_or_351_368a3C(r);
    then reorganization_type_g_and_other_368a3C(r);
}
@source(IRC_S368_A, quote = "such transaction shall be treated as qualifying only under subparagraph (G) of paragraph (1).")
rule Section368a3CTypeGRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(C): a transaction that qualifies under (G) and another provision is treated as (G) only";
    when reorganization(r, TypeGInsolvencyReorganization);
    then effective_reorganization_type_368a2(r, TypeGInsolvencyReorganization);
}
@source(IRC_S368_A, quote = "such transaction shall be treated as described only in paragraph (1)(D).")
rule Section368a2ATypeDRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(2)(A): a transaction described in both (C) and (D) is treated as (D) only";
    when reorganization(r, TypeDAssetTransferWithControlAndDistribution);
    when not_known(reorganization_type_g_and_other_368a3C(r));
    then effective_reorganization_type_368a2(r, TypeDAssetTransferWithControlAndDistribution);
}
@source(IRC_S368_A, quote = "such transaction shall be treated as described only in paragraph (1)(D).")
rule Section368a2ATypeCRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(2)(A): type C stands unless the transaction is also described in D";
    when reorganization(r, TypeCSubstantiallyAllForVotingStock);
    when not_known(reorganization_c_and_d_both_described(r));
    when not_known(reorganization_type_g_and_other_368a3C(r));
    then effective_reorganization_type_368a2(r, TypeCSubstantiallyAllForVotingStock);
}
@source(IRC_S368_A, quote = "such transaction shall be treated as qualifying only under subparagraph (G) of paragraph (1).")
rule Section368a3COtherTypeARule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(C): type A stands unless the transaction is also (G)";
    when reorganization(r, TypeAStatutoryMergerOrConsolidation);
    when not_known(reorganization_type_g_and_other_368a3C(r));
    then effective_reorganization_type_368a2(r, TypeAStatutoryMergerOrConsolidation);
}
@source(IRC_S368_A, quote = "such transaction shall be treated as qualifying only under subparagraph (G) of paragraph (1).")
rule Section368a3COtherTypeBRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(C): type B stands unless the transaction is also (G)";
    when reorganization(r, TypeBStockForVotingStock);
    when not_known(reorganization_type_g_and_other_368a3C(r));
    then effective_reorganization_type_368a2(r, TypeBStockForVotingStock);
}
@source(IRC_S368_A, quote = "such transaction shall be treated as qualifying only under subparagraph (G) of paragraph (1).")
rule Section368a3COtherTypeERule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(C): type E stands unless the transaction is also (G)";
    when reorganization(r, TypeERecapitalization);
    when not_known(reorganization_type_g_and_other_368a3C(r));
    then effective_reorganization_type_368a2(r, TypeERecapitalization);
}
@source(IRC_S368_A, quote = "such transaction shall be treated as qualifying only under subparagraph (G) of paragraph (1).")
rule Section368a3COtherTypeFRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(C): type F stands unless the transaction is also (G)";
    when reorganization(r, TypeFMereChange);
    when not_known(reorganization_type_g_and_other_368a3C(r));
    then effective_reorganization_type_368a2(r, TypeFMereChange);
}

// (C) transfers to controlled subsidiaries; (b) party status.
pub relation transaction_assets_or_stock_transferred_to_controlled_corporation_368a2C(r: ReorganizationTransaction, acquiring: Corporation, controlled_sub: Corporation) kind empirical {
    label en official "part or all of the assets or stock acquired in the transaction are transferred to a corporation controlled by the acquiring corporation (section 368(a)(2)(C))";
}
pub relation requirements_354b1a_and_b_met_368a2C(r: ReorganizationTransaction) kind empirical {
    label en official "the requirements of section 354(b)(1)(A) and (B) are met with respect to the acquisition of the assets (section 368(a)(2)(C), second sentence)";
}
pub relation dropdown_does_not_disqualify_368a2C(r: ReorganizationTransaction) kind institutional {
    label en official "a transaction otherwise qualifying under (1)(A), (B) or (C), or (1)(G) with 354(b)(1)(A)-(B) met, is not disqualified by the transfer to a controlled corporation (section 368(a)(2)(C))";
}
@source(IRC_S368_A, quote = "shall not be disqualified by reason of the fact that part or all of the assets or stock which were acquired in the transaction are transferred to a corporation controlled by the corporation acquiring such assets or stock.")
rule Section368a2CTypeARule(r: ReorganizationTransaction, acquiring: Corporation, sub: Corporation) defeasible {
    label en official "section 368(a)(2)(C): type A survives the transfer";
    when reorganization(r, TypeAStatutoryMergerOrConsolidation);
    when transaction_assets_or_stock_transferred_to_controlled_corporation_368a2C(r, acquiring, sub);
    then dropdown_does_not_disqualify_368a2C(r);
}
@source(IRC_S368_A, quote = "shall not be disqualified by reason of the fact that part or all of the assets or stock which were acquired in the transaction are transferred to a corporation controlled by the corporation acquiring such assets or stock.")
rule Section368a2CTypeBRule(r: ReorganizationTransaction, acquiring: Corporation, sub: Corporation) defeasible {
    label en official "section 368(a)(2)(C): type B survives the transfer";
    when reorganization(r, TypeBStockForVotingStock);
    when transaction_assets_or_stock_transferred_to_controlled_corporation_368a2C(r, acquiring, sub);
    then dropdown_does_not_disqualify_368a2C(r);
}
@source(IRC_S368_A, quote = "shall not be disqualified by reason of the fact that part or all of the assets or stock which were acquired in the transaction are transferred to a corporation controlled by the corporation acquiring such assets or stock.")
rule Section368a2CTypeCRule(r: ReorganizationTransaction, acquiring: Corporation, sub: Corporation) defeasible {
    label en official "section 368(a)(2)(C): type C survives the transfer";
    when reorganization(r, TypeCSubstantiallyAllForVotingStock);
    when transaction_assets_or_stock_transferred_to_controlled_corporation_368a2C(r, acquiring, sub);
    then dropdown_does_not_disqualify_368a2C(r);
}
@source(IRC_S368_A, quote = "A similar rule shall apply to a transaction otherwise qualifying under paragraph (1)(G) where the requirements of subparagraphs (A) and (B) of section 354(b)(1) are met with respect to the acquisition of the assets.")
rule Section368a2CTypeGRule(r: ReorganizationTransaction, acquiring: Corporation, sub: Corporation) defeasible {
    label en official "section 368(a)(2)(C): type G survives the transfer where 354(b)(1)(A) and (B) are met";
    when reorganization(r, TypeGInsolvencyReorganization);
    when requirements_354b1a_and_b_met_368a2C(r);
    when transaction_assets_or_stock_transferred_to_controlled_corporation_368a2C(r, acquiring, sub);
    then dropdown_does_not_disqualify_368a2C(r);
}
@source(IRC_S368_B, quote = "In the case of a reorganization qualifying under paragraph (1)(A), (1)(B), (1)(C), or (1)(G) of subsection (a) by reason of paragraph (2)(C) of subsection (a), the term \"a party to a reorganization\" includes the corporation controlling the corporation to which the acquired assets or stock are transferred.")
rule Section368bDropdownControllingPartyRule(r: ReorganizationTransaction, acquiring: Corporation, sub: Corporation) defeasible {
    label en official "section 368(b): the corporation controlling the transferee subsidiary is a party (the acquiring corporation controls it)";
    when dropdown_does_not_disqualify_368a2C(r);
    when transaction_assets_or_stock_transferred_to_controlled_corporation_368a2C(r, acquiring, sub);
    then party_to_a_reorganization(r, acquiring);
}
pub relation forward_triangular_acquisition_368a2D(r: ReorganizationTransaction, controlling: Corporation, acquiring: Corporation) kind empirical {
    label en official "the acquiring corporation acquires substantially all of the properties of another corporation in exchange for stock of a controlling corporation in control of the acquiring corporation (section 368(a)(2)(D))";
}
pub relation no_acquiring_corporation_stock_used_368a2Di(r: ReorganizationTransaction) kind empirical {
    label en official "no stock of the acquiring corporation is used in the transaction (section 368(a)(2)(D)(i))";
}
pub relation would_qualify_as_merger_into_controlling_corporation_368a2Dii(r: ReorganizationTransaction) kind empirical {
    label en official "the transaction would have qualified under paragraph (1)(A) had the merger been into the controlling corporation (section 368(a)(2)(D)(ii))";
}
pub relation qualifies_under_368a2D_as_type_a(r: ReorganizationTransaction) kind institutional {
    label en official "the transaction is not disqualified under (1)(A) by the use of the controlling corporation's stock (section 368(a)(2)(D))";
}
@source(IRC_S368_A, quote = "shall not disqualify a transaction under paragraph (1)(A) or (1)(G) if—")
rule Section368a2DTypeARule(r: ReorganizationTransaction, controlling: Corporation, acquiring: Corporation) defeasible {
    label en official "section 368(a)(2)(D): forward triangular merger under (1)(A)";
    when reorganization(r, TypeAStatutoryMergerOrConsolidation);
    when forward_triangular_acquisition_368a2D(r, controlling, acquiring);
    when no_acquiring_corporation_stock_used_368a2Di(r);
    when would_qualify_as_merger_into_controlling_corporation_368a2Dii(r);
    then qualifies_under_368a2D_as_type_a(r);
}
pub relation qualifies_under_368a2D_as_type_g(r: ReorganizationTransaction) kind institutional {
    label en official "the transaction is not disqualified under (1)(G) by the use of the controlling corporation's stock (section 368(a)(2)(D))";
}
@source(IRC_S368_A, quote = "shall not disqualify a transaction under paragraph (1)(A) or (1)(G) if—")
rule Section368a2DTypeGRule(r: ReorganizationTransaction, controlling: Corporation, acquiring: Corporation) defeasible {
    label en official "section 368(a)(2)(D): the (1)(G) case needs only clause (i)";
    when reorganization(r, TypeGInsolvencyReorganization);
    when forward_triangular_acquisition_368a2D(r, controlling, acquiring);
    when no_acquiring_corporation_stock_used_368a2Di(r);
    then qualifies_under_368a2D_as_type_g(r);
}
@source(IRC_S368_B, quote = "In the case of a reorganization qualifying under paragraph (1)(A) or (1)(G) of subsection (a) by reason of paragraph (2)(D) of that subsection, the term \"a party to a reorganization\" includes the controlling corporation referred to in such paragraph (2)(D).")
rule Section368bControllingPartyDTypeARule(r: ReorganizationTransaction, controlling: Corporation, acquiring: Corporation) defeasible {
    label en official "section 368(b): the controlling corporation of a (2)(D) type A transaction is a party";
    when qualifies_under_368a2D_as_type_a(r);
    when forward_triangular_acquisition_368a2D(r, controlling, acquiring);
    then party_to_a_reorganization(r, controlling);
}
@source(IRC_S368_B, quote = "In the case of a reorganization qualifying under paragraph (1)(A) or (1)(G) of subsection (a) by reason of paragraph (2)(D) of that subsection, the term \"a party to a reorganization\" includes the controlling corporation referred to in such paragraph (2)(D).")
rule Section368bControllingPartyDTypeGRule(r: ReorganizationTransaction, controlling: Corporation, acquiring: Corporation) defeasible {
    label en official "section 368(b): the controlling corporation of a (2)(D) type G transaction is a party";
    when qualifies_under_368a2D_as_type_g(r);
    when forward_triangular_acquisition_368a2D(r, controlling, acquiring);
    then party_to_a_reorganization(r, controlling);
}
pub relation reverse_merger_using_controlling_stock_368a2E(r: ReorganizationTransaction, controlling: Corporation, surviving: Corporation) kind empirical {
    label en official "stock of a corporation which before the merger was in control of the merged corporation is used in the transaction (section 368(a)(2)(E))";
}
pub relation surviving_corporation_holds_substantially_all_properties_368a2Ei(r: ReorganizationTransaction) kind empirical {
    label en official "after the transaction the surviving corporation holds substantially all of its properties and of the merged corporation's properties, other than distributed stock of the controlling corporation (section 368(a)(2)(E)(i)); an evaluative element asserted with origin adjudicated";
}
pub relation former_shareholders_exchanged_for_control_368a2Eii(r: ReorganizationTransaction) kind empirical {
    label en official "in the transaction former shareholders of the surviving corporation exchanged, for voting stock of the controlling corporation, stock of the surviving corporation constituting control of it (section 368(a)(2)(E)(ii))";
}
pub relation title_11_no_shareholder_consideration_368a3Ei(r: ReorganizationTransaction) kind empirical {
    label en official "no former shareholder of the surviving corporation received any consideration for his stock (section 368(a)(3)(E)(i))";
}
pub relation creditor_debt_exchanged_fmv_368a3Eii(r: ReorganizationTransaction, exchanged: Money, total: Money) kind empirical {
    label en official "the fair market value of the surviving corporation's debt that former creditors exchanged for voting stock of the controlling corporation, and the total fair market value of its debt (section 368(a)(3)(E)(ii))";
}
pub relation requirement_368a2Eii_treated_as_met_368a3E(r: ReorganizationTransaction) kind institutional {
    label en official "in a title 11 or similar case the requirement of (2)(E)(ii) is treated as met (section 368(a)(3)(E))";
}
@source(IRC_S368_A, quote = "the former creditors of the surviving corporation exchanged, for an amount of voting stock of the controlling corporation, debt of the surviving corporation which had a fair market value equal to 80 percent or more of the total fair market value of the debt of the surviving corporation.")
rule Section368a3ERule(r: ReorganizationTransaction, exchanged: Money, total: Money) defeasible {
    label en official "section 368(a)(3)(E): in a title 11 case, no shareholder consideration and creditors exchanging at least 80 percent of the debt value satisfy (2)(E)(ii)";
    when title_11_or_similar_case(r);
    when title_11_no_shareholder_consideration_368a3Ei(r);
    when creditor_debt_exchanged_fmv_368a3Eii(r, exchanged, total);
    when exchanged >= total * 80 percent;
    then requirement_368a2Eii_treated_as_met_368a3E(r);
}
pub relation qualifies_under_368a2E(r: ReorganizationTransaction) kind institutional {
    label en official "a transaction otherwise qualifying under (1)(A) is not disqualified by the use of the controlling corporation's stock (section 368(a)(2)(E))";
}
@source(IRC_S368_A, quote = "A transaction otherwise qualifying under paragraph (1)(A) shall not be disqualified by reason of the fact that stock of a corporation (referred to in this subparagraph as the \"controlling corporation\") which before the merger was in control of the merged corporation is used in the transaction, if—")
rule Section368a2EDirectRule(r: ReorganizationTransaction, controlling: Corporation, surviving: Corporation) defeasible {
    label en official "section 368(a)(2)(E): reverse subsidiary merger with the (i) and (ii) conditions";
    when reorganization(r, TypeAStatutoryMergerOrConsolidation);
    when reverse_merger_using_controlling_stock_368a2E(r, controlling, surviving);
    when surviving_corporation_holds_substantially_all_properties_368a2Ei(r);
    when former_shareholders_exchanged_for_control_368a2Eii(r);
    then qualifies_under_368a2E(r);
}
@source(IRC_S368_A, quote = "In the case of a title 11 or similar case, the requirement of clause (ii) of paragraph (2)(E) shall be treated as met if—")
rule Section368a2ETitle11Rule(r: ReorganizationTransaction, controlling: Corporation, surviving: Corporation) defeasible {
    label en official "section 368(a)(3)(E): the (ii) requirement replaced by the title 11 rule";
    when reorganization(r, TypeAStatutoryMergerOrConsolidation);
    when reverse_merger_using_controlling_stock_368a2E(r, controlling, surviving);
    when surviving_corporation_holds_substantially_all_properties_368a2Ei(r);
    when requirement_368a2Eii_treated_as_met_368a3E(r);
    then qualifies_under_368a2E(r);
}
@source(IRC_S368_B, quote = "In the case of a reorganization qualifying under subsection (a)(1)(A) by reason of subsection (a)(2)(E), the term \"party to a reorganization\" includes the controlling corporation referred to in subsection (a)(2)(E).")
rule Section368bControllingPartyERule(r: ReorganizationTransaction, controlling: Corporation, surviving: Corporation) defeasible {
    label en official "section 368(b): the controlling corporation of a (2)(E) transaction is a party";
    when qualifies_under_368a2E(r);
    when reverse_merger_using_controlling_stock_368a2E(r, controlling, surviving);
    then party_to_a_reorganization(r, controlling);
}

// (F): two or more investment companies.
pub relation total_assets_fmv_368a2F(corp: Corporation, amount: Money) kind empirical {
    label en official "the value of the corporation's total assets, excluding cash and cash items (including receivables), Government securities and assets acquired to meet clause (ii) or to cease to be an investment company (section 368(a)(2)(F)(iv), asserted after the exclusions)";
}
pub relation stock_and_securities_fmv_368a2F(corp: Corporation, amount: Money) kind empirical {
    label en official "the value of the corporation's assets that are stock and securities, with subsidiaries disregarded and the parent owning its ratable share of the subsidiary's assets (section 368(a)(2)(F)(iii))";
}
pub relation held_for_investment_fmv_368a2F(corp: Corporation, amount: Money) kind empirical {
    label en official "the value of the corporation's assets held for investment";
}
pub relation largest_single_issuer_fmv_368a2F(corp: Corporation, amount: Money) kind empirical {
    label en official "the value of the corporation's assets invested in the stock and securities of any one issuer (all members of a section 1563(a) controlled group treated as one issuer)";
}
pub relation five_or_fewer_issuers_fmv_368a2F(corp: Corporation, amount: Money) kind empirical {
    label en official "the value of the corporation's assets invested in the stock and securities of 5 or fewer issuers";
}
pub relation regulated_investment_company_368a2F(corp: Corporation) kind empirical {
    label en official "the corporation is a regulated investment company";
}
pub relation real_estate_investment_trust_368a2F(corp: Corporation) kind empirical {
    label en official "the corporation is a real estate investment trust";
}
pub relation investment_company_368a2Fiii(corp: Corporation) kind institutional {
    label en official "investment company: a RIC, a REIT, or a corporation 50 percent or more of whose total assets are stock and securities and 80 percent or more of whose total assets are held for investment (section 368(a)(2)(F)(iii))";
}
@source(IRC_S368_A, quote = "For purposes of this subparagraph the term \"investment company\" means a regulated investment company, a real estate investment trust, or a corporation 50 percent or more of the value of whose total assets are stock and securities and 80 percent or more of the value of whose total assets are assets held for investment.")
rule Section368a2FiiiRicRule(corp: Corporation) defeasible {
    label en official "section 368(a)(2)(F)(iii): a RIC is an investment company";
    when regulated_investment_company_368a2F(corp);
    then investment_company_368a2Fiii(corp);
}
@source(IRC_S368_A, quote = "For purposes of this subparagraph the term \"investment company\" means a regulated investment company, a real estate investment trust, or a corporation 50 percent or more of the value of whose total assets are stock and securities and 80 percent or more of the value of whose total assets are assets held for investment.")
rule Section368a2FiiiReitRule(corp: Corporation) defeasible {
    label en official "section 368(a)(2)(F)(iii): a REIT is an investment company";
    when real_estate_investment_trust_368a2F(corp);
    then investment_company_368a2Fiii(corp);
}
@source(IRC_S368_A, quote = "a corporation 50 percent or more of the value of whose total assets are stock and securities and 80 percent or more of the value of whose total assets are assets held for investment.")
rule Section368a2FiiiThresholdsRule(corp: Corporation, total: Money, securities: Money, investment: Money) defeasible {
    label en official "section 368(a)(2)(F)(iii): 50 percent in stock and securities and 80 percent held for investment";
    when total_assets_fmv_368a2F(corp, total);
    when stock_and_securities_fmv_368a2F(corp, securities);
    when held_for_investment_fmv_368a2F(corp, investment);
    when securities * 2 >= total;
    when investment * 5 >= total * 4;
    then investment_company_368a2Fiii(corp);
}
pub relation meets_diversification_368a2Fii(corp: Corporation) kind institutional {
    label en official "not more than 25 percent of the value of total assets is invested in the stock and securities of any one issuer and not more than 50 percent in 5 or fewer issuers (section 368(a)(2)(F)(ii))";
}
@source(IRC_S368_A, quote = "A corporation meets the requirements of this clause if not more than 25 percent of the value of its total assets is invested in the stock and securities of any one issuer, and not more than 50 percent of the value of its total assets is invested in the stock and securities of 5 or fewer issuers.")
rule Section368a2FiiRule(corp: Corporation, total: Money, one: Money, five: Money) defeasible {
    label en official "section 368(a)(2)(F)(ii): the 25/50 diversification test (at exactly 25 and 50 percent the corporation meets it)";
    when total_assets_fmv_368a2F(corp, total);
    when largest_single_issuer_fmv_368a2F(corp, one);
    when five_or_fewer_issuers_fmv_368a2F(corp, five);
    when one * 4 <= total;
    when five * 2 <= total;
    then meets_diversification_368a2Fii(corp);
}
pub relation party_to_transaction_368a2F(r: ReorganizationTransaction, corp: Corporation) kind empirical {
    label en official "the corporation is a party to the transaction described in paragraph (1)";
}
pub relation transaction_is_type_e_368a2F(r: ReorganizationTransaction) kind empirical {
    label en official "the transaction is a recapitalization, which subparagraph (F) excludes";
}
pub relation same_persons_same_proportions_368a2Fv(r: ReorganizationTransaction) kind empirical {
    label en official "the stock of each investment company is owned substantially by the same persons in the same proportions (section 368(a)(2)(F)(v))";
}
pub relation investment_company_count_at_least_two_368a2Fi(r: ReorganizationTransaction) kind institutional {
    label en unofficial "helper: 2 or more parties to the transaction were investment companies immediately before it";
}
pub relation investment_company_party_roster_368a2Fi(r: ReorganizationTransaction, corp: Corporation) kind empirical {
    label en unofficial "the party is on the roster of investment companies immediately before the transaction (asserted: a count over the derived investment_company_368a2Fiii is outside the runtime subset, G4009)";
}
@source(IRC_S368_A, quote = "2 or more parties to the transaction were investment companies")
rule Section368a2FiCountRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(2)(F)(i): two or more investment company parties (an exact count over the asserted roster)";
    when investment_company_party_roster_368a2Fi(r, _);
    when count(collect p: Corporation where investment_company_party_roster_368a2Fi(r, p)) >= 2;
    then investment_company_count_at_least_two_368a2Fi(r);
}
pub relation not_a_reorganization_for_investment_company_368a2Fi(r: ReorganizationTransaction, corp: Corporation) kind institutional {
    label en official "the transaction is not considered a reorganization with respect to the investment company and its shareholders (section 368(a)(2)(F)(i))";
}
@source(IRC_S368_A, quote = "then the transaction shall not be considered to be a reorganization with respect to any such investment company (and its shareholders and security holders) unless it was a regulated investment company, a real estate investment trust, or a corporation which meets the requirements of clause (ii).")
rule Section368a2FiRule(r: ReorganizationTransaction, corp: Corporation) defeasible {
    label en official "section 368(a)(2)(F)(i): a non-RIC, non-REIT investment company that fails the diversification test loses reorganization treatment; the rule does not apply to a recapitalization or where the same persons own each company in the same proportions";
    when investment_company_count_at_least_two_368a2Fi(r);
    when party_to_transaction_368a2F(r, corp);
    when investment_company_368a2Fiii(corp);
    when not_known(transaction_is_type_e_368a2F(r));
    when not_known(same_persons_same_proportions_368a2Fv(r));
    when not_known(regulated_investment_company_368a2F(corp));
    when not_known(real_estate_investment_trust_368a2F(corp));
    when not_known(meets_diversification_368a2Fii(corp));
    then not_a_reorganization_for_investment_company_368a2Fi(r, corp);
}
pub relation acquires_assets_of_another_corporation_368a2Fvi(r: ReorganizationTransaction, ic: Corporation, other: Corporation) kind empirical {
    label en official "an investment company that does not meet clause (ii) acquires assets of another corporation (section 368(a)(2)(F)(vi))";
}
pub relation acquires_stock_in_b_reorganization_368a2Fvi(r: ReorganizationTransaction, ic: Corporation, other: Corporation) kind empirical {
    label en official "such an investment company acquires stock of another corporation in a (1)(B) reorganization";
}
pub relation clause_i_applied_as_if_assets_acquired_by_other_368a2Fvi(r: ReorganizationTransaction, ic: Corporation) kind institutional {
    label en official "clause (i) is applied to the investment company and its shareholders as though its assets had been acquired by the other corporation (section 368(a)(2)(F)(vi), first sentence)";
}
@source(IRC_S368_A, quote = "If an investment company which does not meet the requirements of clause (ii) acquires assets of another corporation, clause (i) shall be applied to such investment company and its shareholders and security holders as though its assets had been acquired by such other corporation.")
rule Section368a2FviAssetsRule(r: ReorganizationTransaction, ic: Corporation, other: Corporation) defeasible {
    label en official "section 368(a)(2)(F)(vi): asset acquisition by an investment company failing the diversification test";
    when investment_company_368a2Fiii(ic);
    when not_known(meets_diversification_368a2Fii(ic));
    when acquires_assets_of_another_corporation_368a2Fvi(r, ic, other);
    then clause_i_applied_as_if_assets_acquired_by_other_368a2Fvi(r, ic);
}
pub relation shareholders_deemed_exchanged_stock_for_other_corporation_368a2Fvi(r: ReorganizationTransaction, ic: Corporation) kind institutional {
    label en official "clause (i) is applied to the shareholders of the investment company as though they had exchanged all their stock in it for stock of the other corporation of equal value (section 368(a)(2)(F)(vi), second sentence)";
}
@source(IRC_S368_A, quote = "If such investment company acquires stock of another corporation in a reorganization described in section 368(a)(1)(B), clause (i) shall be applied to the shareholders of such investment company as though they had exchanged with such other corporation all of their stock in such company")
rule Section368a2FviStockRule(r: ReorganizationTransaction, ic: Corporation, other: Corporation) defeasible {
    label en official "section 368(a)(2)(F)(vi): stock acquisition in a (1)(B) reorganization by an investment company failing the diversification test";
    when investment_company_368a2Fiii(ic);
    when not_known(meets_diversification_368a2Fii(ic));
    when acquires_stock_in_b_reorganization_368a2Fvi(r, ic, other);
    then shareholders_deemed_exchanged_stock_for_other_corporation_368a2Fvi(r, ic);
}
pub relation deemed_acquisition_is_sale_or_exchange_1001_368a2Fvi(r: ReorganizationTransaction, ic: Corporation) kind institutional {
    label en official "for section 1001 the deemed acquisition or exchange is a sale or exchange of property by the corporation and by the shareholders and security holders (section 368(a)(2)(F)(vi), last sentence)";
}
@source(IRC_S368_A, quote = "For purposes of section 1001, the deemed acquisition or exchange referred to in the two preceding sentences shall be treated as a sale or exchange of property by the corporation and by the shareholders and security holders to which clause (i) is applied.")
rule Section368a2FviSaleRule(r: ReorganizationTransaction, ic: Corporation) defeasible {
    label en official "section 368(a)(2)(F)(vi): the deemed transaction is a sale or exchange";
    when clause_i_applied_as_if_assets_acquired_by_other_368a2Fvi(r, ic);
    then deemed_acquisition_is_sale_or_exchange_1001_368a2Fvi(r, ic);
}
@source(IRC_S368_A, quote = "For purposes of section 1001, the deemed acquisition or exchange referred to in the two preceding sentences shall be treated as a sale or exchange of property by the corporation and by the shareholders and security holders to which clause (i) is applied.")
rule Section368a2FviSaleStockRule(r: ReorganizationTransaction, ic: Corporation) defeasible {
    label en official "section 368(a)(2)(F)(vi): the deemed stock exchange is a sale or exchange";
    when shareholders_deemed_exchanged_stock_for_other_corporation_368a2Fvi(r, ic);
    then deemed_acquisition_is_sale_or_exchange_1001_368a2Fvi(r, ic);
}
pub relation obligation_of_state_or_local_government_368a2Fvii(asset: Asset) kind empirical {
    label en official "the asset is an obligation of a State or local government";
}
pub relation commodity_futures_contract_368a2Fvii(asset: Asset) kind empirical {
    label en official "the asset is a commodity futures contract";
}
pub relation share_of_ric_or_reit_368a2Fvii(asset: Asset) kind empirical {
    label en official "the asset is a share of a regulated investment company or a real estate investment trust";
}
pub relation security_within_investment_company_act_368a2Fvii(asset: Asset) kind empirical {
    label en official "the asset is another investment constituting a security within the Investment Company Act of 1940 (15 U.S.C. 80a-2(a)(36))";
}
pub relation security_for_clauses_ii_iii_368a2Fvii(asset: Asset) kind institutional {
    label en official "the term securities in clauses (ii) and (iii) includes State and local obligations, commodity futures contracts, RIC and REIT shares and other Investment Company Act securities (section 368(a)(2)(F)(vii))";
}
@source(IRC_S368_A, quote = "the term \"securities\" includes obligations of State and local governments, commodity futures contracts, shares of regulated investment companies and real estate investment trusts, and other investments constituting a security within the meaning of the Investment Company Act of 1940")
rule Section368a2FviiStateRule(a: Asset) defeasible {
    label en official "section 368(a)(2)(F)(vii): State and local government obligations";
    when obligation_of_state_or_local_government_368a2Fvii(a);
    then security_for_clauses_ii_iii_368a2Fvii(a);
}
@source(IRC_S368_A, quote = "the term \"securities\" includes obligations of State and local governments, commodity futures contracts, shares of regulated investment companies and real estate investment trusts, and other investments constituting a security within the meaning of the Investment Company Act of 1940")
rule Section368a2FviiFuturesRule(a: Asset) defeasible {
    label en official "section 368(a)(2)(F)(vii): commodity futures contracts";
    when commodity_futures_contract_368a2Fvii(a);
    then security_for_clauses_ii_iii_368a2Fvii(a);
}
@source(IRC_S368_A, quote = "the term \"securities\" includes obligations of State and local governments, commodity futures contracts, shares of regulated investment companies and real estate investment trusts, and other investments constituting a security within the meaning of the Investment Company Act of 1940")
rule Section368a2FviiSharesRule(a: Asset) defeasible {
    label en official "section 368(a)(2)(F)(vii): RIC and REIT shares";
    when share_of_ric_or_reit_368a2Fvii(a);
    then security_for_clauses_ii_iii_368a2Fvii(a);
}
@source(IRC_S368_A, quote = "the term \"securities\" includes obligations of State and local governments, commodity futures contracts, shares of regulated investment companies and real estate investment trusts, and other investments constituting a security within the meaning of the Investment Company Act of 1940")
rule Section368a2FviiActRule(a: Asset) defeasible {
    label en official "section 368(a)(2)(F)(vii): Investment Company Act securities";
    when security_within_investment_company_act_368a2Fvii(a);
    then security_for_clauses_ii_iii_368a2Fvii(a);
}

// (G): distribution requirement for type C.
pub relation acquired_corporation_distributes_everything_pursuant_to_plan_368a2Gi(r: ReorganizationTransaction) kind empirical {
    label en official "the acquired corporation distributes the stock, securities and other properties it receives, as well as its other properties, in pursuance of the plan (section 368(a)(2)(G)(i))";
}
pub relation acquired_corporation_liquidated_and_paid_creditors_368a2Gi(r: ReorganizationTransaction) kind empirical {
    label en official "the acquired corporation is liquidated pursuant to the plan and distributes to its creditors in connection with the liquidation";
}
pub relation type_c_distribution_requirement_met_368a2G(r: ReorganizationTransaction) kind institutional {
    label en official "the distribution requirement for a (1)(C) transaction is met, counting creditor distributions in a liquidation under the plan (section 368(a)(2)(G)(i))";
}
@source(IRC_S368_A, quote = "A transaction shall fail to meet the requirements of paragraph (1)(C) unless the acquired corporation distributes the stock, securities, and other properties it receives, as well as its other properties, in pursuance of the plan of reorganization.")
rule Section368a2GiRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(2)(G)(i): the acquired corporation distributes everything under the plan";
    when acquired_corporation_distributes_everything_pursuant_to_plan_368a2Gi(r);
    then type_c_distribution_requirement_met_368a2G(r);
}
@source(IRC_S368_A, quote = "any distribution to its creditors in connection with such liquidation shall be treated as pursuant to the plan of reorganization.")
rule Section368a2GiCreditorsRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(2)(G)(i), second sentence: creditor distributions in a plan liquidation are pursuant to the plan";
    when acquired_corporation_liquidated_and_paid_creditors_368a2Gi(r);
    then type_c_distribution_requirement_met_368a2G(r);
}
pub relation secretary_waives_368a2Gi(r: ReorganizationTransaction) kind empirical {
    label en unofficial "the Secretary waives clause (i) for the transaction";
}
pub relation waiver_conditions_prescribed_met_368a2Gii(r: ReorganizationTransaction) kind empirical {
    label en official "the conditions the Secretary prescribes for the waiver are met (the Secretary's own determination)";
}
pub relation type_c_distribution_requirement_waived_368a2Gii(r: ReorganizationTransaction) kind institutional {
    label en official "the Secretary has waived the distribution requirement (section 368(a)(2)(G)(ii))";
}
@source(IRC_S368_A, quote = "The Secretary may waive the application of clause (i) to any transaction subject to any conditions the Secretary may prescribe.")
rule Section368a2GiiWaiverPowerRule strict {
    label en official "section 368(a)(2)(G)(ii): the Secretary's power to waive the distribution requirement; a waiver outside the prescribed conditions is invalid and has no effect (E-0239)";
    for r: ReorganizationTransaction;
    when secretary_waives_368a2Gi(r);
    then power Section368a2GiiWaiver {
        holder us.irc.core::Secretary;
        over r;
        exercise secretary_waives_368a2Gi(r);
        valid_when waiver_conditions_prescribed_met_368a2Gii(r);
        effect create(type_c_distribution_requirement_waived_368a2Gii(r));
        window [-infinity, infinity];
    };
}
pub relation type_c_qualifies_with_distribution_368a2G(r: ReorganizationTransaction) kind institutional {
    label en official "a (1)(C) transaction that satisfies the distribution requirement, or is waived from it";
}
@source(IRC_S368_A, quote = "A transaction shall fail to meet the requirements of paragraph (1)(C) unless")
rule Section368a2GTypeCMetRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(2)(G): type C with the distribution requirement met";
    when reorganization(r, TypeCSubstantiallyAllForVotingStock);
    when type_c_distribution_requirement_met_368a2G(r);
    then type_c_qualifies_with_distribution_368a2G(r);
}
@source(IRC_S368_A, quote = "A transaction shall fail to meet the requirements of paragraph (1)(C) unless")
rule Section368a2GTypeCWaivedRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(2)(G): type C with the requirement waived";
    when reorganization(r, TypeCSubstantiallyAllForVotingStock);
    when type_c_distribution_requirement_waived_368a2Gii(r);
    then type_c_qualifies_with_distribution_368a2G(r);
}

// (H): special rules for (1)(D).
pub relation control_for_type_d_is_304c_368a2Hi(r: ReorganizationTransaction, transferor: Person, transferee: Corporation) kind institutional {
    label en official "where the requirements of section 354(b)(1)(A) and (B) are met, control for (1)(D) has the meaning of section 304(c) (section 368(a)(2)(H)(i))";
}
@source(IRC_S368_A, quote = "in the case of a transaction with respect to which the requirements of subparagraphs (A) and (B) of section 354(b)(1) are met, the term \"control\" has the meaning given such term by section 304(c)")
rule Section368a2HiRule(r: ReorganizationTransaction, transferor: Person, transferee: Corporation) defeasible {
    label en official "section 368(a)(2)(H)(i): control by the section 304(c) meaning (module 12 control_304c)";
    when requirements_354b1a_and_b_met_368a2C(r);
    when control_304c(transferor, transferee);
    then control_for_type_d_is_304c_368a2Hi(r, transferor, transferee);
}
pub relation asset_transfer_368d_ignoring_later_stock_changes_368a2Hii(r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) kind empirical {
    label en official "in a transaction meeting section 355 (or the part of 356 relating to it), control immediately after the transfer, disregarding the shareholders' later disposition of distributed stock and additional stock issued by the distributed corporation (section 368(a)(2)(H)(ii))";
}
pub relation requirements_of_355_met_368a2Hii(r: ReorganizationTransaction) kind empirical {
    label en official "the requirements of section 355 (or so much of section 356 as relates to section 355) are met";
}
pub relation type_d_qualifies_disregarding_later_changes_368a2Hii(r: ReorganizationTransaction) kind institutional {
    label en official "the transaction qualifies under (1)(D): later dispositions of distributed stock and later stock issuances are not taken into account (section 368(a)(2)(H)(ii))";
}
@source(IRC_S368_A, quote = "the fact that the shareholders of the distributing corporation dispose of part or all of the distributed stock, or the fact that the corporation whose stock was distributed issues additional stock, shall not be taken into account.")
rule Section368a2HiiRule(r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) defeasible {
    label en official "section 368(a)(2)(H)(ii): a section 355 divisive transaction is tested for control before later stock changes";
    when requirements_of_355_met_368a2Hii(r);
    when asset_transfer_368d_ignoring_later_stock_changes_368a2Hii(r, transferor, transferee);
    when stock_or_securities_distributed_under_354_355_356(r);
    then type_d_qualifies_disregarding_later_changes_368a2Hii(r);
}

// (3)(A), (B), (D): title 11 and similar cases.
pub relation case_under_title_11_368a3Ai(r: ReorganizationTransaction) kind empirical {
    label en official "a case under title 11 of the United States Code";
}
pub relation receivership_foreclosure_or_similar_proceeding_in_court_368a3Aii(r: ReorganizationTransaction) kind empirical {
    label en official "a receivership, foreclosure or similar proceeding in a Federal or State court";
}
pub relation title_11_or_similar_case_defined_368a3A(r: ReorganizationTransaction) kind institutional {
    label en official "title 11 or similar case: a title 11 case, or a receivership, foreclosure or similar proceeding in a Federal or State court (section 368(a)(3)(A)); the module 10 empirical title_11_or_similar_case is left unchanged";
}
@source(IRC_S368_A, quote = "a case under title 11 of the United States Code, or")
rule Section368a3AiRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(A)(i): a title 11 case";
    when case_under_title_11_368a3Ai(r);
    then title_11_or_similar_case_defined_368a3A(r);
}
@source(IRC_S368_A, quote = "a receivership, foreclosure, or similar proceeding in a Federal or State court.")
rule Section368a3AiiRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(A)(ii): a receivership, foreclosure or similar proceeding";
    when receivership_foreclosure_or_similar_proceeding_in_court_368a3Aii(r);
    then title_11_or_similar_case_defined_368a3A(r);
}
pub relation party_under_jurisdiction_of_court_368a3Bi(r: ReorganizationTransaction) kind empirical {
    label en official "any party to the reorganization is under the jurisdiction of the court in such case";
}
pub relation financial_institution_agency_proceeding_368a3D(r: ReorganizationTransaction) kind empirical {
    label en official "the proceeding is a receivership, foreclosure or similar proceeding before a Federal or State agency involving a financial institution referred to in section 581 or 591 (section 368(a)(3)(D))";
}
pub relation party_under_agency_jurisdiction_368a3D(r: ReorganizationTransaction) kind empirical {
    label en official "a party is under the jurisdiction of that agency";
}
pub relation party_under_court_or_agency_jurisdiction_368a3B(r: ReorganizationTransaction) kind institutional {
    label en official "a party is under the jurisdiction of the court, or of an agency treated as a court for a financial institution (section 368(a)(3)(B)(i), (D))";
}
@source(IRC_S368_A, quote = "any party to the reorganization is under the jurisdiction of the court in such case, and")
rule Section368a3BiCourtRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(B)(i): a party under the court's jurisdiction";
    when party_under_jurisdiction_of_court_368a3Bi(r);
    then party_under_court_or_agency_jurisdiction_368a3B(r);
}
@source(IRC_S368_A, quote = "the agency shall be treated as a court.")
rule Section368a3DAgencyRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(D): the agency is treated as a court for a financial institution";
    when financial_institution_agency_proceeding_368a3D(r);
    when party_under_agency_jurisdiction_368a3D(r);
    then party_under_court_or_agency_jurisdiction_368a3B(r);
}
pub relation plan_approved_by_the_court_368a3Bii(r: ReorganizationTransaction) kind empirical {
    label en official "the transfer is pursuant to a plan of reorganization approved by the court";
}
pub relation transfer_treated_as_in_title_11_case_368a3B(r: ReorganizationTransaction) kind institutional {
    label en official "a transfer of assets is treated as made in a title 11 or similar case if and only if a party is under the court's jurisdiction and the transfer is pursuant to a court-approved plan (section 368(a)(3)(B)); only the affirmative direction is derived";
}
@source(IRC_S368_A, quote = "a transfer of the assets of a corporation shall be treated as made in a title 11 or similar case if and only if—")
rule Section368a3BRule(r: ReorganizationTransaction) defeasible {
    label en official "section 368(a)(3)(B): both conditions together";
    when party_under_court_or_agency_jurisdiction_368a3B(r);
    when plan_approved_by_the_court_368a3Bii(r);
    then transfer_treated_as_in_title_11_case_368a3B(r);
}
pub relation type_g_via_defined_title_11_368a3(r: ReorganizationTransaction) kind institutional {
    label en official "a transaction that is (1)(G) by the definitions of (a)(3)(A), (B) and (D): title 11 or similar case, transfer in the case, asset transfer with control and a qualifying distribution";
}
@source(IRC_S368_A, quote = "a transfer by a corporation of all or part of its assets to another corporation in a title 11 or similar case;")
rule Section368a3TypeGDefinedRule(r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) defeasible {
    label en official "section 368(a)(1)(G) with (a)(3)(A)-(B): the transfer treated as made in a title 11 or similar case";
    when title_11_or_similar_case_defined_368a3A(r);
    when transfer_treated_as_in_title_11_case_368a3B(r);
    when asset_transfer_with_control_368d(r, transferor, transferee);
    when stock_or_securities_distributed_under_354_355_356(r);
    then type_g_via_defined_title_11_368a3(r);
}

// --- Section 355(g)(2)(B)(iv)(III): 20-percent controlled entity -----------------------

pub relation ownership_shares_in_entity_355g2biv(owner: Corporation, ent: Corporation, voting: Decimal, value: Decimal) kind empirical {
    label en official "the distributing or controlled corporation owns directly or indirectly this share of the voting power and of the value of the other corporation, without regard to stock described in section 1504(a)(4)";
}
pub relation twenty_percent_controlled_entity_355g2biv(owner: Corporation, ent: Corporation) kind institutional {
    label en official "20-percent controlled entity: the owner holds stock meeting section 1504(a)(2) with 20 percent substituted for 80 percent, both by voting power and by value (section 355(g)(2)(B)(iv)(III))";
}
@source(IRC_S355_G, quote = "any corporation with respect to which the distributing or controlled corporation owns directly or indirectly stock meeting the requirements of section 1504(a)(2), except that such section shall be applied by substituting \"20 percent\" for \"80 percent\"")
rule Section355g2biv3Rule(owner: Corporation, ent: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 355(g)(2)(B)(iv)(III): at least 20 percent of the voting power and at least 20 percent of the value";
    when ownership_shares_in_entity_355g2biv(owner, ent, voting, value);
    when voting >= 0.20;
    when value >= 0.20;
    then twenty_percent_controlled_entity_355g2biv(owner, ent);
}
