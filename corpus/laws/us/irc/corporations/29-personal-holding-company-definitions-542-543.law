// Stage 3b (26.09.2026, TECH_GAP reduction). Section 542(b)-(d) (consolidated
// returns, exceptions, lending or finance companies) and section 543(b)-(c)
// (ordinary gross income, adjusted ordinary gross income, adjusted income
// from rents and royalties, insurance company gross income). Status
// implemented_unverified: nothing here was executed. The rules concluding
// exclusions are strict, because the module 16 personal holding company rule
// that reads them is strict (a strict rule may read only strict conclusions).

// --- Section 542(c): exceptions --------------------------------------------------------------

use self::{
    AffiliatedGroup,
    Asset,
    Corporation,
    IRC_S542_B,
    IRC_S542_C,
    IRC_S542_D,
    IRC_S543_B,
    IRC_S543_C,
    Person,
    TaxableYear,
    exempt_under_subchapter_f,
};

pub relation bank_or_building_and_loan_association_542c2(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a bank as defined in section 581, or a domestic building and loan association within section 7701(a)(19) (section 542(c)(2))";
}
pub relation life_insurance_company_542c3(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a life insurance company (section 542(c)(3))";
}
pub relation surety_company_542c4(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a surety company (section 542(c)(4))";
}
pub relation foreign_corporation_542c5(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a foreign corporation (section 542(c)(5))";
}
pub relation ordinary_gross_income_542c6(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the corporation's ordinary gross income as defined in section 543(b)(1)";
}
pub relation ordinary_gross_income_from_lending_business_542c6(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the ordinary gross income derived directly from the active and regular conduct of a lending or finance business";
}
pub relation phci_base_for_542c6b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the personal holding company income for the year computed by including as such the entire gross income from rents, royalties, produced film rents and compensation for use of corporate property by shareholders (section 542(c)(6)(B))";
}
pub relation lending_business_income_in_phci_base_542c6b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the income derived directly from the active and regular conduct of a lending or finance business, contained in that base and excluded from the computation";
}
pub relation affiliated_lending_company_income_542d3(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "lawful income received from a corporation that meets section 542(c)(6) and is a member of the same affiliated group (section 542(d)(3))";
}
pub relation phci_computed_for_542c6b(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the personal holding company income for the section 542(c)(6)(B) test: the base less the direct lending income and, where (c)(6)(A) is met, the affiliated lending company income (section 542(d)(3))";
}
@source(IRC_S542_D, quote = "there shall not be treated as personal holding company income the lawful income received from a corporation which meets the requirements of subsection (c)(6) and which is a member of the same affiliated group")
rule Section542c6bComputationRule(c: Corporation, y: TaxableYear, base: Money, lending: Money, affiliated: Money) strict {
    label en official "section 542(c)(6)(B) with (d)(3): the computed income";
    when phci_base_for_542c6b(c, y, base);
    when lending_business_income_in_phci_base_542c6b(c, y, lending);
    when affiliated_lending_company_income_542d3(c, y, affiliated);
    when meets_60_percent_of_ordinary_gross_income_lending_542c6a(c, y);
    then phci_computed_for_542c6b(c, y, base - lending - affiliated);
}
pub relation meets_60_percent_of_ordinary_gross_income_lending_542c6a(c: Corporation, y: TaxableYear) kind institutional {
    label en official "60 percent or more of the ordinary gross income is derived directly from the active and regular conduct of a lending or finance business (section 542(c)(6)(A))";
}
@source(IRC_S542_C, quote = "60 percent or more of its ordinary gross income (as defined in section 543(b)(1)) is derived directly from the active and regular conduct of a lending or finance business;")
rule Section542c6aRule(c: Corporation, y: TaxableYear, ogi: Money, lending: Money) strict {
    label en official "section 542(c)(6)(A): lending income x 5 >= ordinary gross income x 3 (at exactly 60 percent it is met)";
    when ordinary_gross_income_542c6(c, y, ogi);
    when ordinary_gross_income_from_lending_business_542c6(c, y, lending);
    when lending * 5 >= ogi * 3;
    then meets_60_percent_of_ordinary_gross_income_lending_542c6a(c, y);
}
pub relation phci_within_20_percent_542c6b(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the computed personal holding company income is not more than 20 percent of the ordinary gross income (section 542(c)(6)(B))";
}
@source(IRC_S542_C, quote = "is not more than 20 percent of the ordinary gross income;")
rule Section542c6bRule(c: Corporation, y: TaxableYear, ogi: Money, phci: Money) strict {
    label en official "section 542(c)(6)(B): phci x 5 <= ordinary gross income (at exactly 20 percent it is met)";
    when ordinary_gross_income_542c6(c, y, ogi);
    when phci_computed_for_542c6b(c, y, phci);
    when phci * 5 <= ogi;
    then phci_within_20_percent_542c6b(c, y);
}
pub relation deduction_item_542d2(c: Corporation, y: TaxableYear, item: Asset, amount: Money) kind empirical {
    label en official "a deduction of the corporation for the year, in this amount";
}
pub relation deduction_allowable_only_by_162_or_404_542d2a(item: Asset) kind empirical {
    label en official "the deduction is allowable only by reason of section 162 or section 404 (section 542(d)(2)(A))";
}
pub relation deduction_is_compensation_to_shareholder_or_family_542d2a(item: Asset) kind empirical {
    label en official "the deduction is in respect of compensation for personal services rendered by shareholders (including family members within section 544(a)(2))";
}
pub relation deduction_under_167_or_164_real_property_tax_542d2b(item: Asset) kind empirical {
    label en official "the deduction is allowable under section 167, or under section 164 for real property taxes (section 542(d)(2)(B))";
}
pub relation deduction_property_used_directly_in_lending_business_542d2b(item: Asset) kind empirical {
    label en official "the property with respect to which the deduction is allowable is used directly in the active and regular conduct of the lending or finance business";
}
pub relation deductions_counted_542d2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deductions that may be taken into account for (c)(6)(C): (A) section 162 or 404 deductions other than shareholder compensation, and (B) section 167 and real property tax deductions for property used directly in the lending business (section 542(d)(2)); an item within both (A) and (B) counts once";
}
@source(IRC_S542_D, quote = "For purposes of subsection (c)(6)(C), the deductions which may be taken into account shall include only—")
rule Section542d2Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(d)(2): two exact sums over the listed deduction items";
    when deduction_item_542d2(c, y, _, _);
    then deductions_counted_542d2(c, y, (sum all a: Money for i: Asset where deduction_item_542d2(c, y, i, a) and deduction_allowable_only_by_162_or_404_542d2a(i) and not deduction_is_compensation_to_shareholder_or_family_542d2a(i)) + (sum all b: Money for j: Asset where deduction_item_542d2(c, y, j, b) and deduction_under_167_or_164_real_property_tax_542d2b(j) and deduction_property_used_directly_in_lending_business_542d2b(j) and not deduction_allowable_only_by_162_or_404_542d2a(j)));
}
pub relation deductions_meet_lending_floor_542c6c(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the directly allocable deductions equal or exceed 15 percent of the first $500,000 of lending ordinary gross income plus 5 percent of the excess (section 542(c)(6)(C))";
}
@source(IRC_S542_C, quote = "15 percent of so much of the ordinary gross income derived therefrom as does not exceed $500,000, plus")
rule Section542c6cLowRule(c: Corporation, y: TaxableYear, lending: Money, deductions: Money) strict {
    label en official "section 542(c)(6)(C)(i): lending income up to $500,000: 15 percent";
    when ordinary_gross_income_from_lending_business_542c6(c, y, lending);
    when deductions_counted_542d2(c, y, deductions);
    when lending <= 500000.00 USD;
    when deductions >= lending * 15 percent;
    then deductions_meet_lending_floor_542c6c(c, y);
}
@source(IRC_S542_C, quote = "5 percent of so much of the ordinary gross income derived therefrom as exceeds $500,000; and")
rule Section542c6cHighRule(c: Corporation, y: TaxableYear, lending: Money, deductions: Money) strict {
    label en official "section 542(c)(6)(C)(ii): 15 percent of the first $500,000 (75000) plus 5 percent of the excess";
    when ordinary_gross_income_from_lending_business_542c6(c, y, lending);
    when deductions_counted_542d2(c, y, deductions);
    when lending > 500000.00 USD;
    when deductions >= 75000.00 USD + (lending - 500000.00 USD) * 5 percent;
    then deductions_meet_lending_floor_542c6c(c, y);
}
pub relation loan_to_10_percent_shareholder_542c6d(c: Corporation, y: TaxableYear, person: Person, principal: Money) kind empirical {
    label en official "the principal amount of loans outstanding at any time during the year to a person who is a shareholder holding 10 percent or more in value (with family attribution under section 544(a)(2))";
}
pub relation shareholder_loan_above_5000_542c6d(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "helper: loans to some 10-percent shareholder exceed $5,000 in principal";
}
rule Section542c6dHelperRule(c: Corporation, y: TaxableYear, person: Person, principal: Money) strict {
    label en unofficial "helper: a shareholder loan above the limit";
    when loan_to_10_percent_shareholder_542c6d(c, y, person, principal);
    when principal > 5000.00 USD;
    then shareholder_loan_above_5000_542c6d(c, y);
}
pub relation lending_or_finance_company_excluded_542c6(c: Corporation, y: TaxableYear) kind institutional {
    label en official "a lending or finance company meeting all of (A)-(D) is excluded from the personal holding company definition (section 542(c)(6))";
}
@source(IRC_S542_C, quote = "a lending or finance company if—")
rule Section542c6Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(6): the four cumulative conditions";
    when meets_60_percent_of_ordinary_gross_income_lending_542c6a(c, y);
    when phci_within_20_percent_542c6b(c, y);
    when deductions_meet_lending_floor_542c6c(c, y);
    when not_known(shareholder_loan_above_5000_542c6d(c, y));
    then lending_or_finance_company_excluded_542c6(c, y);
}
pub relation licensed_sbic_actively_engaged_542c7(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a small business investment company licensed by the Small Business Administration, operating under the Small Business Investment Act of 1958 and actively engaged in providing funds to small business concerns";
}
pub relation shareholder_holds_5_percent_in_funded_concern_542c7(c: Corporation, y: TaxableYear) kind empirical {
    label en official "a shareholder owns at any time during the year, directly or indirectly, a 5 percent or more proprietary interest in a small business concern to which the company provides funds, or 5 percent or more in value of its stock (section 542(c)(7), second sentence)";
}
pub relation sbic_excluded_542c7(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the small business investment company is excluded (section 542(c)(7))";
}
@source(IRC_S542_C, quote = "a small business investment company which is licensed by the Small Business Administration and operating under the Small Business Investment Act of 1958")
rule Section542c7Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(7): unless a shareholder holds a 5 percent interest in a funded concern";
    when licensed_sbic_actively_engaged_542c7(c, y);
    when not_known(shareholder_holds_5_percent_in_funded_concern_542c7(c, y));
    then sbic_excluded_542c7(c, y);
}
pub relation subject_to_title_11_or_similar_case_542c8(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is subject to the jurisdiction of the court in a title 11 or similar case (within section 368(a)(3)(A))";
}
pub external judgment relation major_purpose_of_case_is_avoidance_of_541_tax_542c8(c: Corporation, y: TaxableYear) {
    authority Secretary;
    label en official "section 542(c)(8): a major purpose of instituting or continuing the case is the avoidance of the tax imposed by section 541 — DECISION-0194 evaluative channel";
}
pub relation title_11_corporation_excluded_542c8(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation subject to a title 11 or similar case is excluded, unless a major purpose of the case is avoidance of the section 541 tax (section 542(c)(8))";
}
@source(IRC_S542_C, quote = "a corporation which is subject to the jurisdiction of the court in a title 11 or similar case (within the meaning of section 368(a)(3)(A)) unless a major purpose of instituting or continuing such case is the avoidance of the tax imposed by section 541.")
rule Section542c8Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(8)";
    when subject_to_title_11_or_similar_case_542c8(c, y);
    when not_known(major_purpose_of_case_is_avoidance_of_541_tax_542c8(c, y));
    then title_11_corporation_excluded_542c8(c, y);
}
pub relation personal_holding_company_excluded_542c_derived(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation is excluded from the personal holding company definition by a derived paragraph of section 542(c) (exempt corporation, bank, life insurer, surety, foreign corporation, lending or finance company, SBIC, or title 11 debtor); it is read by the module 16 personal holding company rule next to the asserted section_542c_excluded_corporation";
}
@source(IRC_S542_C, quote = "(1) a corporation exempt from tax under subchapter F (sec. 501 and following);")
rule Section542c1Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(1): exempt corporation (module 15 fact exempt_under_subchapter_f)";
    when exempt_under_subchapter_f(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}
@source(IRC_S542_C, quote = "(2) a bank as defined in section 581, or a domestic building and loan association within the meaning of section 7701(a)(19);")
rule Section542c2Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(2)";
    when bank_or_building_and_loan_association_542c2(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}
@source(IRC_S542_C, quote = "(3) a life insurance company;")
rule Section542c3Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(3)";
    when life_insurance_company_542c3(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}
@source(IRC_S542_C, quote = "(4) a surety company;")
rule Section542c4Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(4)";
    when surety_company_542c4(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}
@source(IRC_S542_C, quote = "(5) a foreign corporation;")
rule Section542c5Rule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(5)";
    when foreign_corporation_542c5(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}
@source(IRC_S542_C, quote = "a lending or finance company if—")
rule Section542c6ExcludedRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(6)";
    when lending_or_finance_company_excluded_542c6(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}
@source(IRC_S542_C, quote = "a small business investment company which is licensed by the Small Business Administration")
rule Section542c7ExcludedRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(7)";
    when sbic_excluded_542c7(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}
@source(IRC_S542_C, quote = "a corporation which is subject to the jurisdiction of the court in a title 11 or similar case")
rule Section542c8ExcludedRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 542(c)(8)";
    when title_11_corporation_excluded_542c8(c, y);
    then personal_holding_company_excluded_542c_derived(c, y);
}

// --- Section 542(d)(1): lending or finance business -----------------------------------------

pub entity FinanceActivity542 { label en unofficial "an activity of a corporation tested as a lending or finance business (section 542(d)(1))"; }
pub relation makes_loans_542d1ai(act: FinanceActivity542) kind empirical {
    label en official "the business makes loans (section 542(d)(1)(A)(i))";
}
pub relation purchases_or_discounts_receivables_542d1aii(act: FinanceActivity542) kind empirical {
    label en official "the business purchases or discounts accounts receivable, notes or installment obligations";
}
pub relation services_in_connection_with_own_lending_542d1aiii(act: FinanceActivity542) kind empirical {
    label en official "the business renders services or makes facilities available in connection with (i) and (ii) activities carried on by the corporation itself";
}
pub relation services_to_affiliated_lending_corporation_542d1aiv(act: FinanceActivity542) kind empirical {
    label en official "the business renders services or makes facilities available, related to the lending or finance business of another corporation of the same affiliated group engaged in it";
}
pub relation remaining_maturity_months_542d1bi(act: FinanceActivity542, months: Integer) kind empirical {
    label en official "the remaining maturity at the time of the loan, purchase or discount, including any renewal or extension period the borrower may elect (section 542(d)(1)(B), last sentence)";
}
pub relation secured_by_conditional_sale_or_chattel_542d1bi1(act: FinanceActivity542) kind empirical {
    label en official "the loans, notes or installment obligations are evidenced or secured by contracts of conditional sale, chattel mortgages or chattel lease agreements from sales of goods or services in the borrower's or transferor's trade or business";
}
pub relation creditor_agrees_to_advance_on_request_542d1c1(act: FinanceActivity542) kind empirical {
    label en official "under the agreement the creditor agrees to make loans or advances (not above an agreed maximum) from time to time upon request";
}
pub relation debtor_may_repay_in_full_or_installments_542d1c2(act: FinanceActivity542) kind empirical {
    label en official "under the agreement the debtor may repay the loan or advance in full or in installments";
}
pub relation indefinite_maturity_credit_542d1c(act: FinanceActivity542) kind institutional {
    label en official "a loan, note or installment obligation made under an agreement with (i) advances on request up to a maximum and (ii) repayment in full or installments (section 542(d)(1)(C))";
}
@source(IRC_S542_D, quote = "For purposes of subparagraph (B)(i), a loan, note, or installment obligation meets the requirements of this subparagraph if it is made under an agreement—")
rule Section542d1cRule(act: FinanceActivity542) strict {
    label en official "section 542(d)(1)(C)";
    when creditor_agrees_to_advance_on_request_542d1c1(act);
    when debtor_may_repay_in_full_or_installments_542d1c2(act);
    then indefinite_maturity_credit_542d1c(act);
}
pub relation made_by_taxpayer_and_indefinite_maturity_542d1bi2(act: FinanceActivity542) kind empirical {
    label en official "the loans, notes or installment obligations are made or acquired by the taxpayer and meet the requirements of subparagraph (C) (section 542(d)(1)(B)(i)(II))";
}
pub relation series_certificates_under_trust_indenture_542d1bii(act: FinanceActivity542) kind empirical {
    label en official "the business is making loans evidenced by, or purchasing, certificates of indebtedness issued in a series under a trust indenture in registered form or with interest coupons attached";
}
pub relation excluded_from_lending_business_542d1b(act: FinanceActivity542) kind institutional {
    label en official "the activity is not a lending or finance business by reason of subparagraph (B)";
}
@source(IRC_S542_D, quote = "if (at the time of the loan, purchase, or discount) the remaining maturity exceeds 144 months; unless—")
rule Section542d1bLongMaturityRule(act: FinanceActivity542, months: Integer) strict {
    label en official "section 542(d)(1)(B)(i): a remaining maturity above 144 months (exactly 144 is not above), unless (I) conditional-sale paper or (II) indefinite-maturity credit made by the taxpayer";
    when remaining_maturity_months_542d1bi(act, months);
    when months > 144;
    when not_known(secured_by_conditional_sale_or_chattel_542d1bi1(act));
    when not_known(made_by_taxpayer_and_indefinite_maturity_542d1bi2(act));
    then excluded_from_lending_business_542d1b(act);
}
@source(IRC_S542_D, quote = "making loans evidenced by, or purchasing, certificates of indebtedness issued in a series, under a trust indenture, and in registered form or with interest coupons attached.")
rule Section542d1bSeriesRule(act: FinanceActivity542) strict {
    label en official "section 542(d)(1)(B)(ii)";
    when series_certificates_under_trust_indenture_542d1bii(act);
    then excluded_from_lending_business_542d1b(act);
}
pub relation lending_or_finance_business_542d1(act: FinanceActivity542) kind institutional {
    label en official "a lending or finance business: making loans, purchasing or discounting receivables, own or affiliated related services, save the (B) exceptions (section 542(d)(1))";
}
@source(IRC_S542_D, quote = "making loans,")
rule Section542d1aiRule(act: FinanceActivity542) strict {
    label en official "section 542(d)(1)(A)(i)";
    when makes_loans_542d1ai(act);
    when not_known(excluded_from_lending_business_542d1b(act));
    then lending_or_finance_business_542d1(act);
}
@source(IRC_S542_D, quote = "purchasing or discounting accounts receivable, notes, or installment obligations,")
rule Section542d1aiiRule(act: FinanceActivity542) strict {
    label en official "section 542(d)(1)(A)(ii)";
    when purchases_or_discounts_receivables_542d1aii(act);
    when not_known(excluded_from_lending_business_542d1b(act));
    then lending_or_finance_business_542d1(act);
}
@source(IRC_S542_D, quote = "rendering services or making facilities available in connection with activities described in clauses (i) and (ii) carried on by the corporation rendering services or making facilities available, or")
rule Section542d1aiiiRule(act: FinanceActivity542) strict {
    label en official "section 542(d)(1)(A)(iii)";
    when services_in_connection_with_own_lending_542d1aiii(act);
    then lending_or_finance_business_542d1(act);
}
@source(IRC_S542_D, quote = "rendering services or making facilities available to another corporation which is engaged in the lending or finance business")
rule Section542d1aivRule(act: FinanceActivity542) strict {
    label en official "section 542(d)(1)(A)(iv)";
    when services_to_affiliated_lending_corporation_542d1aiv(act);
    then lending_or_finance_business_542d1(act);
}

// --- Section 542(b): consolidated returns ---------------------------------------------------------

pub relation consolidated_aogi_542b1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the consolidated adjusted ordinary gross income of the affiliated group";
}
pub relation consolidated_phci_542b1(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the consolidated personal holding company income of the affiliated group";
}
pub relation dividends_from_nonincludible_life_insurer_542b5(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "dividends received by a member from a section 801 life insurance company that is not a group member solely by reason of section 1504(b)(2) (section 542(b)(5))";
}
pub relation group_files_or_required_to_file_consolidated_return_542b1(group: AffiliatedGroup, y: TaxableYear) kind empirical {
    label en official "the affiliated group files or is required to file a consolidated return under section 1501 for the year";
}
pub relation member_of_group_542b(group: AffiliatedGroup, c: Corporation) kind empirical {
    label en official "the corporation is a member of the affiliated group, including the common parent";
}
pub relation member_outside_income_542b2(group: AffiliatedGroup, y: TaxableYear, member: Corporation, aogi: Money, outside: Money, outside_phci: Money) kind empirical {
    label en official "a member's adjusted ordinary gross income, the part derived from sources outside the affiliated group, and the part of that which is personal holding company income (section 543 applied as if the outside amount were the adjusted ordinary gross income)";
}
pub relation dividends_from_over_50_percent_subsidiary_542b4(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind empirical {
    label en official "dividends received by the common parent from a corporation of which it owns more than 50 percent of the voting stock, which is not a personal holding company for the year the dividends are paid (section 542(b)(4)); the (A) and (B) tests are asserted in the fact";
}
pub relation ineligible_group_542b2(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "the affiliated group is ineligible for consolidated testing: a member derived 10 percent or more of its adjusted ordinary gross income from outside sources, of which 80 percent or more is personal holding company income (section 542(b)(2))";
}
@source(IRC_S542_B, quote = "any member of the affiliated group of corporations (including the common parent corporation) derived 10 percent or more of its adjusted ordinary gross income for the taxable year from sources outside the affiliated group, and")
rule Section542b2Rule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, aogi: Money, outside: Money, phci_outside: Money, dividends: Money) strict {
    label en official "section 542(b)(2), (4): outside share x 10 >= aogi and phci share x 5 >= outside x 4, after removing the (4) dividends (a member with dividends asserted through the (4) fact)";
    when member_outside_income_542b2(group, y, member, aogi, outside, phci_outside);
    when dividends_from_over_50_percent_subsidiary_542b4(group, y, member, dividends);
    when (outside - dividends) * 10 >= (aogi - dividends);
    when (phci_outside - dividends) * 5 >= (outside - dividends) * 4;
    then ineligible_group_542b2(group, y);
}
@source(IRC_S542_B, quote = "any member of the affiliated group of corporations (including the common parent corporation) derived 10 percent or more of its adjusted ordinary gross income for the taxable year from sources outside the affiliated group, and")
rule Section542b2NoDividendsRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, aogi: Money, outside: Money, phci_outside: Money) strict {
    label en official "section 542(b)(2): the test without (4) dividends";
    when member_outside_income_542b2(group, y, member, aogi, outside, phci_outside);
    when not_known(member_has_542b4_dividends(group, y, member));
    when outside * 10 >= aogi;
    when phci_outside * 5 >= outside * 4;
    then ineligible_group_542b2(group, y);
}
pub relation member_has_542b4_dividends(group: AffiliatedGroup, y: TaxableYear, member: Corporation) kind institutional {
    label en unofficial "helper: the member has (4) dividends";
}
rule Section542b4HelperRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) strict {
    label en unofficial "helper: (4) dividends exist";
    when dividends_from_over_50_percent_subsidiary_542b4(group, y, member, amount);
    then member_has_542b4_dividends(group, y, member);
}
pub relation group_has_excluded_member_542b3(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "a member of the affiliated group (including the common parent) is excluded from the personal holding company definition by subsection (c) (section 542(b)(3))";
}
@source(IRC_S542_B, quote = "Paragraph (1) shall not apply to an affiliated group of corporations if any member of the affiliated group (including the common parent corporation) is a corporation excluded from the definition of personal holding company under subsection (c).")
rule Section542b3Rule(group: AffiliatedGroup, y: TaxableYear, member: Corporation) strict {
    label en official "section 542(b)(3): a member excluded by (c)";
    when member_of_group_542b(group, member);
    when personal_holding_company_excluded_542c_derived(member, y);
    then group_has_excluded_member_542b3(group, y);
}
pub relation consolidated_aogi_test_governs_542b1(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "the adjusted ordinary gross income requirement is applied on a consolidated basis for the group (section 542(b)(1))";
}
@source(IRC_S542_B, quote = "In the case of an affiliated group of corporations filing or required to file a consolidated return under section 1501 for any taxable year, the adjusted ordinary gross income requirement of subsection (a)(1) of this section shall, except as provided in paragraphs (2) and (3), be applied for such year with respect to the consolidated adjusted ordinary gross income and the consolidated personal holding company income of the affiliated group.")
rule Section542b1GovernsRule(group: AffiliatedGroup, y: TaxableYear) strict {
    label en official "section 542(b)(1): a consolidated-return group that is neither ineligible nor has an excluded member";
    when group_files_or_required_to_file_consolidated_return_542b1(group, y);
    when not_known(ineligible_group_542b2(group, y));
    when not_known(group_has_excluded_member_542b3(group, y));
    then consolidated_aogi_test_governs_542b1(group, y);
}
pub relation consolidated_aogi_after_542b5(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind institutional {
    label en official "the consolidated adjusted ordinary gross income less the section 542(b)(5) life insurer dividends";
}
@source(IRC_S542_B, quote = "there shall be excluded from consolidated personal holding company income and consolidated adjusted ordinary gross income for purposes of this part dividends received by a member of the affiliated group from a life insurance company")
rule Section542b5AogiRule(group: AffiliatedGroup, y: TaxableYear, aogi: Money, dividends: Money) strict {
    label en official "section 542(b)(5): the dividends are removed from consolidated adjusted ordinary gross income";
    when consolidated_aogi_542b1(group, y, aogi);
    when dividends_from_nonincludible_life_insurer_542b5(group, y, dividends);
    then consolidated_aogi_after_542b5(group, y, aogi - dividends);
}
pub relation consolidated_phci_after_542b5(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind institutional {
    label en official "the consolidated personal holding company income less the section 542(b)(5) life insurer dividends";
}
@source(IRC_S542_B, quote = "there shall be excluded from consolidated personal holding company income and consolidated adjusted ordinary gross income for purposes of this part dividends received by a member of the affiliated group from a life insurance company")
rule Section542b5PhciRule(group: AffiliatedGroup, y: TaxableYear, phci: Money, dividends: Money) strict {
    label en official "section 542(b)(5): the dividends are removed from consolidated personal holding company income";
    when consolidated_phci_542b1(group, y, phci);
    when dividends_from_nonincludible_life_insurer_542b5(group, y, dividends);
    then consolidated_phci_after_542b5(group, y, phci - dividends);
}
pub relation consolidated_60_percent_test_met_542b1(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "the group's consolidated personal holding company income is at least 60 percent of its consolidated adjusted ordinary gross income (section 542(b)(1), (a)(1))";
}
@source(IRC_S542_B, quote = "No member of such an affiliated group shall be considered to meet such adjusted ordinary gross income requirement unless the affiliated group meets such requirement.")
rule Section542b1SixtyRule(group: AffiliatedGroup, y: TaxableYear, aogi: Money, phci: Money) strict {
    label en official "section 542(b)(1): phci x 5 >= aogi x 3 (60 percent)";
    when consolidated_aogi_test_governs_542b1(group, y);
    when consolidated_aogi_after_542b5(group, y, aogi);
    when consolidated_phci_after_542b5(group, y, phci);
    when aogi > 0.00 USD;
    when phci * 5 >= aogi * 3;
    then consolidated_60_percent_test_met_542b1(group, y);
}
pub relation member_meets_aogi_requirement_by_group_542b1(c: Corporation, y: TaxableYear) kind institutional {
    label en official "a member is considered to meet the adjusted ordinary gross income requirement because the group does (section 542(b)(1), last sentence)";
}
@source(IRC_S542_B, quote = "No member of such an affiliated group shall be considered to meet such adjusted ordinary gross income requirement unless the affiliated group meets such requirement.")
rule Section542b1MemberRule(group: AffiliatedGroup, y: TaxableYear, c: Corporation) strict {
    label en official "section 542(b)(1): a member meets the requirement when the governing consolidated test is met (wired into module 16 meets_60_percent_aogi_test_542a1)";
    when member_of_group_542b(group, c);
    when consolidated_60_percent_test_met_542b1(group, y);
    then member_meets_aogi_requirement_by_group_542b1(c, y);
}
pub relation member_of_governing_consolidated_group_542b1(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "helper: the member belongs to a group whose consolidated test governs";
}
rule Section542b1GoverningMemberRule(group: AffiliatedGroup, y: TaxableYear, c: Corporation) strict {
    label en unofficial "helper: governing group member";
    when member_of_group_542b(group, c);
    when consolidated_aogi_test_governs_542b1(group, y);
    then member_of_governing_consolidated_group_542b1(c, y);
}

// --- Section 543(b)-(c): definitions -----------------------------------------------------------------

pub relation gross_income_543(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the corporation's gross income for the year (for an insurance company other than life, the section 543(c) amount below)";
}
pub relation capital_asset_gains_543b1a(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "all gains from the sale or other disposition of capital assets (section 543(b)(1)(A))";
}
pub relation gains_from_1231b_property_543b1b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "all gains, other than those in (A), from the sale or other disposition of property described in section 1231(b) (section 543(b)(1)(B))";
}
pub relation ordinary_gross_income_543b1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "ordinary gross income: gross income excluding capital asset gains and section 1231(b) property gains (section 543(b)(1))";
}
@source(IRC_S543_B, quote = "The term \"ordinary gross income\" means the gross income determined by excluding—")
rule Section543b1Rule(c: Corporation, y: TaxableYear, gross: Money, cap: Money, s1231: Money) strict {
    label en official "section 543(b)(1)";
    when gross_income_543(c, y, gross);
    when capital_asset_gains_543b1a(c, y, cap);
    when gains_from_1231b_property_543b1b(c, y, s1231);
    then ordinary_gross_income_543b1(c, y, gross - cap - s1231);
}
pub relation gross_income_832b1_543c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income of a non-life insurance company as defined in section 832(b)(1)";
}
pub relation losses_incurred_832b5_543c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the losses incurred as defined in section 832(b)(5)";
}
pub relation expenses_incurred_832b6_543c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the expenses incurred as defined in section 832(b)(6)";
}
pub relation tax_free_interest_deductible_832c7_543c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount deductible under section 832(c)(7) (tax-free interest)";
}
pub relation gross_income_of_nonlife_insurer_543c(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income of an insurance company other than a life insurance company for this part: the 832(b)(1) gross income plus losses incurred plus expenses incurred, less the 832(c)(7) tax-free interest (section 543(c))";
}
@source(IRC_S543_C, quote = "the term \"gross income\" as used in this part means the gross income, as defined in section 832(b)(1), increased by the amount of losses incurred, as defined in section 832(b)(5), and the amount of expenses incurred, as defined in section 832(b)(6), and decreased by the amount deductible under section 832(c)(7) (relating to tax-free interest).")
rule Section543cRule(c: Corporation, y: TaxableYear, gross: Money, losses: Money, expenses: Money, tax_free: Money) strict {
    label en official "section 543(c)";
    when gross_income_832b1_543c(c, y, gross);
    when losses_incurred_832b5_543c(c, y, losses);
    when expenses_incurred_832b6_543c(c, y, expenses);
    when tax_free_interest_deductible_832c7_543c(c, y, tax_free);
    then gross_income_of_nonlife_insurer_543c(c, y, gross + losses + expenses - tax_free);
}
pub relation rent_receipt_543b3(c: Corporation, y: TaxableYear, item: Asset, amount: Money) kind empirical {
    label en official "a receipt of the corporation for the year, in this amount";
}
pub relation compensation_for_use_of_property_543b3(item: Asset) kind empirical {
    label en official "the receipt is compensation, however designated, for the use of, or the right to use, property";
}
pub relation interest_on_debt_for_real_property_held_for_sale_543b3(item: Asset) kind empirical {
    label en official "the receipt is interest on debts owed to the corporation to the extent they represent the price of real property held primarily for sale to customers in the ordinary course";
}
pub relation receipt_is_543a6_income_543b3a(item: Asset) kind empirical {
    label en official "the receipt constitutes personal holding company income under subsection (a)(6) (section 543(b)(3)(A))";
}
pub relation receipt_is_copyright_royalty_543b3b(item: Asset) kind empirical {
    label en official "the receipt is a copyright royalty (section 543(b)(3)(B))";
}
pub relation receipt_is_produced_film_rent_543b3c(item: Asset) kind empirical {
    label en official "the receipt is a produced film rent (section 543(b)(3)(C))";
}
pub relation receipt_is_manufacturer_personal_property_compensation_543b3d(item: Asset) kind empirical {
    label en official "the receipt is compensation for tangible personal property manufactured or produced by the taxpayer, which is engaged in substantial manufacturing of the same type (section 543(b)(3)(D))";
}
pub relation receipt_is_active_business_computer_software_royalty_543b3e(item: Asset) kind empirical {
    label en official "the receipt is an active business computer software royalty (section 543(b)(3)(E), (d))";
}
pub relation gross_income_from_rents_543b3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income from rents: use compensation and real property sale interest, other than the (A)-(E) items (section 543(b)(3)); exact sums over the listed receipts";
}
@source(IRC_S543_B, quote = "For purposes of the preceding sentence, the term \"rents\" means compensation, however designated, for the use of, or right to use, property, and the interest on debts owed to the corporation, to the extent such debts represent the price for which real property held primarily for sale to customers in the ordinary course of its trade or business was sold or exchanged by the corporation; but such term does not include—")
rule Section543b3RentsRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 543(b)(3): the sum over use compensation and the real property sale interest, outside (A)-(E)";
    when rent_receipt_543b3(c, y, _, _);
    then gross_income_from_rents_543b3(c, y, (sum all a: Money for i: Asset where rent_receipt_543b3(c, y, i, a) and compensation_for_use_of_property_543b3(i) and not receipt_is_543a6_income_543b3a(i) and not receipt_is_copyright_royalty_543b3b(i) and not receipt_is_produced_film_rent_543b3c(i) and not receipt_is_manufacturer_personal_property_compensation_543b3d(i) and not receipt_is_active_business_computer_software_royalty_543b3e(i)) + (sum all b: Money for j: Asset where rent_receipt_543b3(c, y, j, b) and interest_on_debt_for_real_property_held_for_sale_543b3(j) and not compensation_for_use_of_property_543b3(j)));
}
pub relation rent_deductions_allocable_543b2a(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions for depreciation of property other than short-retained tangible personal property, property taxes, interest and rent, allocable under regulations to the gross income from rents (allocation is a case fact)";
}
pub relation rent_subtraction_543b2a(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount subtracted from rents: the allocable deductions, not more than the gross income from rents (section 543(b)(2)(A))";
}
@source(IRC_S543_B, quote = "The amount subtracted under this subparagraph shall not exceed such gross income from rents.")
rule Section543b2aWithinRule(c: Corporation, y: TaxableYear, rents: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(A): deductions within the rents";
    when gross_income_from_rents_543b3(c, y, rents);
    when rent_deductions_allocable_543b2a(c, y, deductions);
    when deductions <= rents;
    then rent_subtraction_543b2a(c, y, deductions);
}
@source(IRC_S543_B, quote = "The amount subtracted under this subparagraph shall not exceed such gross income from rents.")
rule Section543b2aCappedRule(c: Corporation, y: TaxableYear, rents: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(A): deductions above the rents are capped at them";
    when gross_income_from_rents_543b3(c, y, rents);
    when rent_deductions_allocable_543b2a(c, y, deductions);
    when deductions > rents;
    then rent_subtraction_543b2a(c, y, rents);
}
pub relation adjusted_income_from_rents_543b3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted income from rents: gross income from rents less the (2)(A) subtraction (section 543(b)(3))";
}
@source(IRC_S543_B, quote = "The term \"adjusted income from rents\" means the gross income from rents, reduced by the amount subtracted under paragraph (2)(A) of this subsection.")
rule Section543b3AdjustedRule(c: Corporation, y: TaxableYear, rents: Money, subtraction: Money) strict {
    label en official "section 543(b)(3)";
    when gross_income_from_rents_543b3(c, y, rents);
    when rent_subtraction_543b2a(c, y, subtraction);
    then adjusted_income_from_rents_543b3(c, y, rents - subtraction);
}
pub relation royalty_income_543b4(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income from mineral, oil and gas royalties (including production payments and overriding royalties)";
}
pub relation royalty_deductions_allocable_543b2b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions (depreciation, depletion, property and severance taxes, interest, rent) allocable under regulations to the royalties";
}
pub relation royalty_subtraction_543b2b(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount subtracted with respect to royalties, not more than the royalties (section 543(b)(2)(B))";
}
@source(IRC_S543_B, quote = "The amount subtracted under this subparagraph with respect to royalties shall not exceed the gross income from such royalties")
rule Section543b2bRoyaltyWithinRule(c: Corporation, y: TaxableYear, income: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(B): within the royalties";
    when royalty_income_543b4(c, y, income);
    when royalty_deductions_allocable_543b2b(c, y, deductions);
    when deductions <= income;
    then royalty_subtraction_543b2b(c, y, deductions);
}
@source(IRC_S543_B, quote = "The amount subtracted under this subparagraph with respect to royalties shall not exceed the gross income from such royalties")
rule Section543b2bRoyaltyCappedRule(c: Corporation, y: TaxableYear, income: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(B): capped at the royalties";
    when royalty_income_543b4(c, y, income);
    when royalty_deductions_allocable_543b2b(c, y, deductions);
    when deductions > income;
    then royalty_subtraction_543b2b(c, y, income);
}
pub relation adjusted_income_from_mineral_oil_gas_royalties_543b4(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted income from mineral, oil and gas royalties: gross royalties less the (2)(B) subtraction for royalties (section 543(b)(4))";
}
@source(IRC_S543_B, quote = "The term \"adjusted income from mineral, oil, and gas royalties\" means the gross income from mineral, oil, and gas royalties (including production payments and overriding royalties), reduced by the amount subtracted under paragraph (2)(B) of this subsection in respect of such royalties.")
rule Section543b4Rule(c: Corporation, y: TaxableYear, income: Money, subtraction: Money) strict {
    label en official "section 543(b)(4)";
    when royalty_income_543b4(c, y, income);
    when royalty_subtraction_543b2b(c, y, subtraction);
    then adjusted_income_from_mineral_oil_gas_royalties_543b4(c, y, income - subtraction);
}
pub relation working_interest_income_543b2b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income from working interests in an oil or gas well";
}
pub relation working_interest_deductions_allocable_543b2b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allocable to the working interests";
}
pub relation working_interest_subtraction_543b2b(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount subtracted with respect to working interests, not more than that income (section 543(b)(2)(B))";
}
@source(IRC_S543_B, quote = "the amount subtracted under this subparagraph with respect to working interests shall not exceed the gross income from such working interests.")
rule Section543b2bWorkingWithinRule(c: Corporation, y: TaxableYear, income: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(B): within the working interest income";
    when working_interest_income_543b2b(c, y, income);
    when working_interest_deductions_allocable_543b2b(c, y, deductions);
    when deductions <= income;
    then working_interest_subtraction_543b2b(c, y, deductions);
}
@source(IRC_S543_B, quote = "the amount subtracted under this subparagraph with respect to working interests shall not exceed the gross income from such working interests.")
rule Section543b2bWorkingCappedRule(c: Corporation, y: TaxableYear, income: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(B): capped at the working interest income";
    when working_interest_income_543b2b(c, y, income);
    when working_interest_deductions_allocable_543b2b(c, y, deductions);
    when deductions > income;
    then working_interest_subtraction_543b2b(c, y, income);
}
pub relation dealer_interest_on_us_obligations_543b2ci(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest on a direct obligation of the United States held for sale to customers in the ordinary course by a regular dealer making a primary market in such obligations";
}
pub relation interest_on_award_judgment_or_refund_543b2cii(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest on a condemnation award, a judgment or a tax refund";
}
pub relation excluded_interest_543b2c(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest excluded from adjusted ordinary gross income (section 543(b)(2)(C))";
}
@source(IRC_S543_B, quote = "There shall be excluded—")
rule Section543b2cRule(c: Corporation, y: TaxableYear, dealer: Money, award: Money) strict {
    label en official "section 543(b)(2)(C)(i)-(ii)";
    when dealer_interest_on_us_obligations_543b2ci(c, y, dealer);
    when interest_on_award_judgment_or_refund_543b2cii(c, y, award);
    then excluded_interest_543b2c(c, y, dealer + award);
}
pub relation excluded_rents_compensation_543b2d(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income consisting of compensation described in paragraph (3)(D)";
}
pub relation excluded_rents_deductions_allocable_543b2d(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions of clauses (i)-(iv) of subparagraph (A) allocable to that income";
}
pub relation excluded_rents_subtraction_543b2d(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount subtracted from the (3)(D) compensation, not more than that income (section 543(b)(2)(D))";
}
@source(IRC_S543_B, quote = "The amount subtracted under this subparagraph shall not exceed such gross income.")
rule Section543b2dWithinRule(c: Corporation, y: TaxableYear, income: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(D): within the income";
    when excluded_rents_compensation_543b2d(c, y, income);
    when excluded_rents_deductions_allocable_543b2d(c, y, deductions);
    when deductions <= income;
    then excluded_rents_subtraction_543b2d(c, y, deductions);
}
@source(IRC_S543_B, quote = "The amount subtracted under this subparagraph shall not exceed such gross income.")
rule Section543b2dCappedRule(c: Corporation, y: TaxableYear, income: Money, deductions: Money) strict {
    label en official "section 543(b)(2)(D): capped at the income";
    when excluded_rents_compensation_543b2d(c, y, income);
    when excluded_rents_deductions_allocable_543b2d(c, y, deductions);
    when deductions > income;
    then excluded_rents_subtraction_543b2d(c, y, income);
}
pub relation computed_adjusted_ordinary_gross_income_543b2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted ordinary gross income: ordinary gross income less the rent, royalty, working interest and excluded-rent subtractions and the excluded interest (section 543(b)(2)); it is not wired into module 16 asserted adjusted_ordinary_gross_income_543b2 (G4029)";
}
@source(IRC_S543_B, quote = "The term \"adjusted ordinary gross income\" means the ordinary gross income adjusted as follows:")
rule Section543b2Rule(c: Corporation, y: TaxableYear, ogi: Money, rent: Money, royalty: Money, working: Money, interest: Money, excluded_rent: Money) strict {
    label en official "section 543(b)(2)(A)-(D)";
    when ordinary_gross_income_543b1(c, y, ogi);
    when rent_subtraction_543b2a(c, y, rent);
    when royalty_subtraction_543b2b(c, y, royalty);
    when working_interest_subtraction_543b2b(c, y, working);
    when excluded_interest_543b2c(c, y, interest);
    when excluded_rents_subtraction_543b2d(c, y, excluded_rent);
    then computed_adjusted_ordinary_gross_income_543b2(c, y, ogi - rent - royalty - working - interest - excluded_rent);
}
