// Sections 385 (treatment of certain interests in corporations as stock or
// indebtedness) and 1552 (earnings and profits of the members of a
// consolidated group: allocation of the group's tax liability). Stage 3
// (26.09.2026, A06). Section 1505 and section 12 are cross-reference
// tables (NON_NORMATIVE, coverage rows only).
//
// SECTION 385. The section authorizes regulations ((a)-(b): factors) and
// states ONE self-executing rule, (c): the issuer's characterization "as of
// the time of issuance" is binding on the issuer and on all holders, but not
// on the Secretary; a holder that discloses on its return that it treats the
// interest inconsistently is released (except as regulations provide). The
// binding effect is a PROHIBITION of inconsistent treatment (bearer: the
// issuer, and each holder not released), the Secretary's freedom is a LIBERTY,
// and the holder's disclosure is a POWER (it changes the holder's legal
// position: from bound to not bound). E-0239: an invalid disclosure has no
// effect. The regulatory factors (b)(1)-(5) and the authorizations (a), (c)(3)
// are EXTERNAL_DEPENDENCY: the pinned text is the delegation, not the test.
//
// SECTION 1552. The group's E&P allocation method is elected "in its first
// consolidated return filed for such a taxable year" from four methods; with
// no election the (a)(1) method applies ((b)). The election is a POWER of the
// common parent over the group (valid only in the first consolidated return;
// method (4) only with the Secretary's approval); the default is a rule; the
// methods (1), (2) and (3) are exact allocations of the group's tax
// liability with the "bears the same ratio" form of the money-arithmetic
// consultation (`div_round(base * (a / 1.00 USD), b / 1.00 USD, 2, "HALF_UP")`,
// one rounding, cents HALF_UP — a JUDGMENT CALL, the statute names no
// rounding). Method (4) has no formula (the Secretary approves the group's own
// method): EXTERNAL_DEPENDENCY, the allocated amount is a case fact.
// The (a)(3) denominator (the sum of the members' reductions) is a case fact:
// summing a DERIVED per-member reduction is an aggregate over a derived
// relation (§111, LDC-E4103), TECH-GAPS G3306.

// --- Section 385(c): effect of classification by the issuer -------------------

use self::{
    AffiliatedGroup,
    Corporation,
    IRC_S1552_A,
    IRC_S1552_B,
    IRC_S385_C,
    Person,
    TaxableYear,
    common_parent_of,
    makes_consolidated_return,
};

pub entity DebtEquityInterest { label en unofficial "an interest in a corporation whose treatment as stock or indebtedness is in question (section 385)"; }

pub enum InterestCharacterization385 {
    CharacterizedAsStock;
    CharacterizedAsIndebtedness;
    CharacterizedAsPartStockPartIndebtedness;
    label en unofficial "the issuer's characterization of the interest: stock, indebtedness, or in part stock and in part indebtedness (section 385(a))";
}

pub relation interest_issued_by_corporation_385(i: DebtEquityInterest, issuer: Corporation) kind empirical {
    label en official "the interest in a corporation was issued by the corporation";
}
pub relation holder_of_interest_385(i: DebtEquityInterest, holder: Person) kind empirical {
    label en official "the person holds the interest";
}
@source(IRC_S385_C, quote = "The characterization (as of the time of issuance) by the issuer as to whether an interest in a corporation is stock or indebtedness shall be binding on such issuer and on all holders of such interest")
pub relation issuer_characterization_at_issuance_385c1(i: DebtEquityInterest, characterization: InterestCharacterization385) kind empirical {
    label en official "the issuer's characterization, as of the time of issuance, of the interest as stock or indebtedness";
}
pub relation party_treats_interest_inconsistently_with_characterization_385c1(i: DebtEquityInterest, p: Person) kind empirical {
    label en official "the person treats the interest in a manner inconsistent with the issuer's characterization";
}

pub relation regulations_deny_disclosure_relief_385c2(i: DebtEquityInterest, holder: Person) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations provide that the section 385(c)(2) relief is not available to the holder (\"except as provided in regulations\")";
}
pub relation holder_discloses_inconsistent_treatment_385c2(i: DebtEquityInterest, holder: Person) kind empirical {
    label en official "the holder discloses that it is treating the interest in a manner inconsistent with the issuer's characterization";
}
pub relation disclosure_made_on_holders_return_385c2(i: DebtEquityInterest, holder: Person) kind empirical {
    label en official "the disclosure is made on the holder's return";
}
pub relation disclosure_relief_available_385c2(i: DebtEquityInterest, holder: Person) kind institutional {
    label en unofficial "helper: the disclosure was made on the holder's return and regulations do not deny the relief (the single atom of the power's valid_when)";
}
rule DisclosureReliefAvailableRule(i: DebtEquityInterest, holder: Person) defeasible {
    label en unofficial "helper: disclosure on the return, not denied by regulations";
    when disclosure_made_on_holders_return_385c2(i, holder);
    when not_known(regulations_deny_disclosure_relief_385c2(i, holder));
    then disclosure_relief_available_385c2(i, holder);
}
pub relation holder_not_bound_by_issuer_characterization_385c2(i: DebtEquityInterest, holder: Person) kind institutional {
    label en official "section 385(c)(1) does not apply to the holder, which on its return disclosed that it treats the interest inconsistently with the issuer's characterization (section 385(c)(2))";
}
@source(IRC_S385_C, quote = "paragraph (1) shall not apply to any holder of an interest if such holder on his return discloses that he is treating such interest in a manner inconsistent with the characterization referred to in paragraph (1).")
rule Section385c2DisclosurePowerRule strict {
    label en official "section 385(c)(2): the holder's power to escape the issuer's binding characterization by disclosure on its return; an invalid disclosure has no effect";
    for i: DebtEquityInterest;
    for holder: Person;
    when holder_of_interest_385(i, holder);
    when holder_discloses_inconsistent_treatment_385c2(i, holder);
    then power Section385c2DisclosureRelease {
        holder holder;
        over i;
        exercise holder_discloses_inconsistent_treatment_385c2(i, holder);
        valid_when disclosure_relief_available_385c2(i, holder);
        effect create(holder_not_bound_by_issuer_characterization_385c2(i, holder));
        window [-infinity, infinity];
    };
}

@source(IRC_S385_C, quote = "shall be binding on such issuer and on all holders of such interest (but shall not be binding on the Secretary).")
rule Section385c1IssuerBoundRule(i: DebtEquityInterest, issuer: Corporation, characterization: InterestCharacterization385) defeasible {
    label en official "section 385(c)(1): the issuer's characterization binds the issuer — it must not treat the interest inconsistently with it";
    when interest_issued_by_corporation_385(i, issuer);
    when issuer_characterization_at_issuance_385c1(i, characterization);
    then prohibition Section385c1IssuerBindingBar {
        bearer issuer;
        action party_treats_interest_inconsistently_with_characterization_385c1(i, issuer);
        window [-infinity, infinity];
    };
}
@source(IRC_S385_C, quote = "shall be binding on such issuer and on all holders of such interest (but shall not be binding on the Secretary).")
rule Section385c1HolderBoundRule(i: DebtEquityInterest, holder: Person, characterization: InterestCharacterization385) defeasible {
    label en official "section 385(c)(1): the issuer's characterization binds every holder that has not been released by a section 385(c)(2) disclosure";
    when holder_of_interest_385(i, holder);
    when issuer_characterization_at_issuance_385c1(i, characterization);
    when not_known(holder_not_bound_by_issuer_characterization_385c2(i, holder));
    then prohibition Section385c1HolderBindingBar {
        bearer holder;
        action party_treats_interest_inconsistently_with_characterization_385c1(i, holder);
        window [-infinity, infinity];
    };
}
pub relation secretary_recharacterizes_interest_385c1(i: DebtEquityInterest) kind empirical {
    label en official "the Secretary treats the interest differently from the issuer's characterization";
}
@source(IRC_S385_C, quote = "(but shall not be binding on the Secretary)")
rule Section385c1SecretaryNotBoundRule(i: DebtEquityInterest, issuer: Corporation, characterization: InterestCharacterization385) defeasible {
    label en official "section 385(c)(1): the issuer's characterization is not binding on the Secretary, who is free to treat the interest differently";
    when interest_issued_by_corporation_385(i, issuer);
    when issuer_characterization_at_issuance_385c1(i, characterization);
    then liberty SecretaryMayRecharacterizeInterest {
        holder us.irc.core::Secretary;
        against issuer;
        action secretary_recharacterizes_interest_385c1(i);
        window [-infinity, infinity];
    };
}

// --- Section 1552: allocation of the group's tax liability for E&P ------------

pub enum EarningsAndProfitsAllocationMethod1552 {
    ProportionateToConsolidatedTaxableIncome;
    SeparateReturnTaxRatio;
    ContributionToConsolidatedTaxableIncome;
    OtherMethodApprovedBySecretary;
    label en unofficial "the four methods of section 1552(a)(1)-(4) for allocating the group's tax liability among its members for earnings and profits";
}

pub relation allocation_method_elected_1552a(group: AffiliatedGroup, y: TaxableYear, method: EarningsAndProfitsAllocationMethod1552) kind empirical {
    label en official "the group elects the allocation method in its consolidated return";
}
pub relation election_made_in_first_consolidated_return_1552a(group: AffiliatedGroup, y: TaxableYear) kind empirical {
    label en official "the election is made in the group's FIRST consolidated return filed for the taxable year";
}
pub relation secretary_approved_other_method_1552a4(group: AffiliatedGroup, y: TaxableYear) kind empirical {
    label en official "the Secretary approved the method selected by the group under section 1552(a)(4)";
}
pub relation election_valid_1552a(group: AffiliatedGroup, y: TaxableYear, method: EarningsAndProfitsAllocationMethod1552) kind institutional {
    label en official "the election of the method is valid: made in the first consolidated return and, for a method under (a)(4), approved by the Secretary";
}
@source(IRC_S1552_A, quote = "in accord with whichever of the following methods the group shall elect in its first consolidated return filed for such a taxable year:")
rule Election1552aValidOrdinaryMethodRule(group: AffiliatedGroup, y: TaxableYear, method: EarningsAndProfitsAllocationMethod1552) defeasible {
    label en official "section 1552(a)(1)-(3): a method elected in the first consolidated return is valid";
    when allocation_method_elected_1552a(group, y, method);
    when election_made_in_first_consolidated_return_1552a(group, y);
    when method != OtherMethodApprovedBySecretary;
    then election_valid_1552a(group, y, method);
}
@source(IRC_S1552_A, quote = "The tax liability of the group shall be allocated in accord with any other method selected by the group with the approval of the Secretary.")
rule Election1552aValidApprovedMethodRule(group: AffiliatedGroup, y: TaxableYear, method: EarningsAndProfitsAllocationMethod1552) defeasible {
    label en official "section 1552(a)(4): any other method selected by the group is valid only with the Secretary's approval, elected in the first consolidated return";
    when allocation_method_elected_1552a(group, y, method);
    when election_made_in_first_consolidated_return_1552a(group, y);
    when method == OtherMethodApprovedBySecretary;
    when secretary_approved_other_method_1552a4(group, y);
    then election_valid_1552a(group, y, method);
}
pub relation valid_allocation_election_exists_1552(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en unofficial "helper projection: some valid election exists for the group and year (guard of the section 1552(b) default; `not_known` rejects an unbound `_`, LDC-E0207)";
}
rule ValidAllocationElectionExistsRule(group: AffiliatedGroup, y: TaxableYear, method: EarningsAndProfitsAllocationMethod1552) defeasible {
    label en unofficial "helper projection";
    when election_valid_1552a(group, y, method);
    then valid_allocation_election_exists_1552(group, y);
}
pub relation allocation_method_in_effect_1552(group: AffiliatedGroup, y: TaxableYear, method: EarningsAndProfitsAllocationMethod1552) kind institutional {
    label en official "the method by which the group's tax liability is allocated among its members for earnings and profits for the taxable year";
}
@source(IRC_S1552_A, quote = "whichever of the following methods the group shall elect in its first consolidated return filed for such a taxable year:")
rule Section1552aAllocationElectionPowerRule strict {
    label en official "section 1552(a): the common parent's power to elect the allocation method in the group's first consolidated return; a late or unapproved election is invalid and has no effect (E-0239)";
    for group: AffiliatedGroup;
    for y: TaxableYear;
    for parent: Corporation;
    for method: EarningsAndProfitsAllocationMethod1552;
    when common_parent_of(group, parent);
    when allocation_method_elected_1552a(group, y, method);
    then power Section1552aAllocationElection {
        holder parent;
        over group;
        exercise allocation_method_elected_1552a(group, y, method);
        valid_when election_valid_1552a(group, y, method);
        effect create(allocation_method_in_effect_1552(group, y, method));
        window [-infinity, infinity];
    };
}
@source(IRC_S1552_B, quote = "If no election is made in such first return, the tax liability shall be allocated among the several members of the group pursuant to the method prescribed in subsection (a)(1).")
rule Section1552bDefaultMethodRule(group: AffiliatedGroup, y: TaxableYear) defeasible {
    label en official "section 1552(b): a group that makes a consolidated return but no valid election in the first return is allocated under the (a)(1) method";
    when makes_consolidated_return(group, y);
    when not_known(valid_allocation_election_exists_1552(group, y));
    then allocation_method_in_effect_1552(group, y, ProportionateToConsolidatedTaxableIncome);
}

// --- Section 1552(a)(1): proportion to consolidated taxable income -------------

pub relation group_tax_liability_1552(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the tax liability of the group for the consolidated return year";
}
pub relation consolidated_taxable_income_1552(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the consolidated taxable income of the group";
}
pub relation member_portion_of_consolidated_taxable_income_1552a1(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind empirical {
    label en official "the portion of the consolidated taxable income attributable to the member";
}
pub relation member_allocated_tax_1552a1(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind institutional {
    label en official "the member's allocation of the group's tax liability under section 1552(a)(1): in the ratio of the member's portion of consolidated taxable income to the consolidated taxable income, for a member having taxable income";
}
@source(IRC_S1552_A, quote = "The tax liability shall be apportioned among the members of the group in accordance with the ratio which that portion of the consolidated taxable income attributable to each member of the group having taxable income bears to the consolidated taxable income.")
rule Section1552a1AllocationRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, tax: Money, consolidated: Money, portion: Money) strict {
    label en official "section 1552(a)(1): tax allocated to a member with taxable income = group tax x (member portion / consolidated taxable income), one rounding to cents HALF_UP";
    when group_tax_liability_1552(group, y, tax);
    when consolidated_taxable_income_1552(group, y, consolidated);
    when member_portion_of_consolidated_taxable_income_1552a1(group, y, member, portion);
    when consolidated > 0.00 USD;
    when portion > 0.00 USD;
    then member_allocated_tax_1552a1(group, y, member, div_round(tax * (portion / 1.00 USD), consolidated / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S1552_A, quote = "each member of the group having taxable income")
rule Section1552a1NoTaxableIncomeNoAllocationRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, portion: Money) strict {
    label en official "section 1552(a)(1): a member without taxable income is allocated no part of the group's tax liability";
    when member_portion_of_consolidated_taxable_income_1552a1(group, y, member, portion);
    when portion <= 0.00 USD;
    then member_allocated_tax_1552a1(group, y, member, 0.00 USD);
}

// --- Section 1552(a)(2): ratio of separate-return taxes -----------------------------

pub relation member_separate_return_tax_1552a2(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind empirical {
    label en official "the tax of the member if computed on a separate return";
}
pub relation member_allocated_tax_1552a2(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind institutional {
    label en official "the member's allocation under section 1552(a)(2): group tax x (member's separate-return tax / the total of the separate-return taxes of all members)";
}
pub relation total_separate_return_taxes_1552a2(group: AffiliatedGroup, y: TaxableYear, total: Money) kind institutional {
    label en official "the total amount of the taxes for all members of the group computed on separate returns (section 1552(a)(2))";
}
@source(IRC_S1552_A, quote = "to the total amount of the taxes for all members of the group so computed.")
rule TotalSeparateReturnTaxesRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, separate: Money) defeasible {
    label en official "section 1552(a)(2): the denominator, summed over the members' separate-return taxes (an aggregate over an EMPIRICAL relation, so expressible)";
    when member_separate_return_tax_1552a2(group, y, member, separate);
    then total_separate_return_taxes_1552a2(group, y, sum all t: Money for m: Corporation where member_separate_return_tax_1552a2(group, y, m, t));
}
@source(IRC_S1552_A, quote = "on the basis of the percentage of the total tax which the tax of such member if computed on a separate return would bear to the total amount of the taxes for all members of the group so computed.")
rule Section1552a2AllocationRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, tax: Money, separate: Money, total_separate: Money) defeasible {
    label en official "section 1552(a)(2): tax allocated on the basis of each member's separate-return tax as a share of the total of all members' separate-return taxes, one rounding to cents HALF_UP";
    when group_tax_liability_1552(group, y, tax);
    when member_separate_return_tax_1552a2(group, y, member, separate);
    when total_separate_return_taxes_1552a2(group, y, total_separate);
    when total_separate > 0.00 USD;
    then member_allocated_tax_1552a2(group, y, member, div_round(tax * (separate / 1.00 USD), total_separate / 1.00 USD, 2, "HALF_UP"));
}

// --- Section 1552(a)(3): contribution to consolidated taxable income ----------------

pub relation member_tax_on_contribution_basis_1552a3(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind empirical {
    label en official "the member's share of the group's tax liability, excluding the tax increases arising from the consolidation, on the basis of its contribution to the consolidated taxable income";
}
pub relation tax_increase_from_consolidation_1552a3(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the tax increases arising from the consolidation, to be distributed to the members";
}
pub relation total_reduction_from_consolidation_1552a3(group: AffiliatedGroup, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total, over the members, of the reduction in tax liability resulting from filing the consolidated return (a case fact: TECH-GAPS G3306)";
}
pub relation member_reduction_from_consolidation_1552a3(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind institutional {
    label en official "the reduction in the member's tax liability resulting from the consolidated return: separate-return tax less tax on the contribution basis";
}
@source(IRC_S1552_A, quote = "as measured by the difference between their tax liabilities determined on a separate return basis and their tax liabilities based on their contributions to the consolidated taxable income.")
rule Section1552a3MemberReductionRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, separate: Money, contribution: Money) defeasible {
    label en official "section 1552(a)(3): a member's reduction = tax on a separate return basis less tax based on its contribution (a positive difference)";
    when member_separate_return_tax_1552a2(group, y, member, separate);
    when member_tax_on_contribution_basis_1552a3(group, y, member, contribution);
    when separate > contribution;
    then member_reduction_from_consolidation_1552a3(group, y, member, separate - contribution);
}
pub relation member_allocated_tax_1552a3(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind institutional {
    label en official "the member's allocation under section 1552(a)(3): its tax on the contribution basis plus its share of the consolidation tax increases, in direct proportion to its reduction";
}
@source(IRC_S1552_A, quote = "Any tax increases arising from the consolidation shall be distributed to the several members in direct proportion to the reduction in tax liability resulting to such members from the filing of the consolidated return")
rule Section1552a3AllocationWithReductionRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, contribution: Money, increase: Money, reduction: Money, total_reduction: Money) defeasible {
    label en official "section 1552(a)(3): contribution-basis tax plus the increase x (member reduction / total reduction), one rounding to cents HALF_UP";
    when member_tax_on_contribution_basis_1552a3(group, y, member, contribution);
    when tax_increase_from_consolidation_1552a3(group, y, increase);
    when member_reduction_from_consolidation_1552a3(group, y, member, reduction);
    when total_reduction_from_consolidation_1552a3(group, y, total_reduction);
    when total_reduction > 0.00 USD;
    then member_allocated_tax_1552a3(group, y, member, contribution + div_round(increase * (reduction / 1.00 USD), total_reduction / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S1552_A, quote = "The tax liability of the group (excluding the tax increases arising from the consolidation) shall be allocated on the basis of the contribution of each member of the group to the consolidated taxable income of the group.")
rule Section1552a3AllocationNoReductionRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, contribution: Money) defeasible {
    label en official "section 1552(a)(3): a member with no reduction bears only its contribution-basis tax";
    when member_tax_on_contribution_basis_1552a3(group, y, member, contribution);
    when not_known(member_has_reduction_from_consolidation_1552a3(group, y, member));
    then member_allocated_tax_1552a3(group, y, member, contribution);
}
pub relation member_has_reduction_from_consolidation_1552a3(group: AffiliatedGroup, y: TaxableYear, member: Corporation) kind institutional {
    label en unofficial "helper projection: the member has a positive reduction (guard of the no-reduction branch; LDC-E0207)";
}
rule MemberHasReductionRule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) defeasible {
    label en unofficial "helper projection";
    when member_reduction_from_consolidation_1552a3(group, y, member, amount);
    then member_has_reduction_from_consolidation_1552a3(group, y, member);
}

// --- Section 1552(a)(4) and the resulting allocation -----------------------------------

pub relation member_allocated_tax_other_method_1552a4(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: the member's allocation under the method selected by the group with the Secretary's approval (no statutory formula)";
}
pub relation member_share_of_group_tax_for_earnings_and_profits_1552(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) kind institutional {
    label en official "the member's share of the group's tax liability by which its earnings and profits are determined, under the method in effect (section 1552(a))";
}
@source(IRC_S1552_A, quote = "the earnings and profits of each member of an affiliated group required to be included in a consolidated return for such group filed for a taxable year shall be determined by allocating the tax liability of the group for such year among the members of the group")
rule Section1552ShareFromMethod1Rule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) defeasible {
    label en official "section 1552(a)(1) method in effect: the member's share is its proportion of consolidated taxable income";
    when allocation_method_in_effect_1552(group, y, ProportionateToConsolidatedTaxableIncome);
    when member_allocated_tax_1552a1(group, y, member, amount);
    then member_share_of_group_tax_for_earnings_and_profits_1552(group, y, member, amount);
}
@source(IRC_S1552_A, quote = "the earnings and profits of each member of an affiliated group required to be included in a consolidated return for such group filed for a taxable year shall be determined by allocating the tax liability of the group for such year among the members of the group")
rule Section1552ShareFromMethod2Rule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) defeasible {
    label en official "section 1552(a)(2) method in effect: the member's share is its separate-return-tax ratio";
    when allocation_method_in_effect_1552(group, y, SeparateReturnTaxRatio);
    when member_allocated_tax_1552a2(group, y, member, amount);
    then member_share_of_group_tax_for_earnings_and_profits_1552(group, y, member, amount);
}
@source(IRC_S1552_A, quote = "the earnings and profits of each member of an affiliated group required to be included in a consolidated return for such group filed for a taxable year shall be determined by allocating the tax liability of the group for such year among the members of the group")
rule Section1552ShareFromMethod3Rule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) defeasible {
    label en official "section 1552(a)(3) method in effect: the member's share is its contribution-based allocation";
    when allocation_method_in_effect_1552(group, y, ContributionToConsolidatedTaxableIncome);
    when member_allocated_tax_1552a3(group, y, member, amount);
    then member_share_of_group_tax_for_earnings_and_profits_1552(group, y, member, amount);
}
@source(IRC_S1552_A, quote = "the earnings and profits of each member of an affiliated group required to be included in a consolidated return for such group filed for a taxable year shall be determined by allocating the tax liability of the group for such year among the members of the group")
rule Section1552ShareFromMethod4Rule(group: AffiliatedGroup, y: TaxableYear, member: Corporation, amount: Money) defeasible {
    label en official "section 1552(a)(4) method in effect: the member's share is the amount under the approved method";
    when allocation_method_in_effect_1552(group, y, OtherMethodApprovedBySecretary);
    when member_allocated_tax_other_method_1552a4(group, y, member, amount);
    then member_share_of_group_tax_for_earnings_and_profits_1552(group, y, member, amount);
}
