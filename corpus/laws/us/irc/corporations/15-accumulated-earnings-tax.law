// Subchapter G, Part I — the accumulated earnings tax, sections 531-537.
// Stage 2 (IRC-08 stage 2, A06), priority sections ("20% on accumulated
// taxable income (531), the (532) applicability, (533) evidence of
// purpose — the presumption on unreasonable accumulation as a
// `presumption` with the (533(b)) holding-company rule, (535) accumulated
// taxable income computation with the (535(c)) accumulated earnings
// credit $250,000/$150,000, (537) reasonable needs as EVALUATIVE").
//
// METHOD: section 531's flat 20 percent rate is an A3 parameter
// (`.lawparam.json`), matching section 11(b)'s own convention rather than a
// bare literal. Section 532's applicability reads section 533(a)'s
// `presumption` (unreasonable accumulation is DETERMINATIVE of the tax-
// avoidance purpose, rebuttable by a preponderance of the evidence) — the
// language's `presumption` construct (DECISION/§146, `unless ... then
// not ...`) is used exactly as the coordinator's task names it, rather than
// an ordinary defeasible rule, since the statute's own structure IS a
// presumption (determinative unless rebutted). Section 533(b)'s holding/
// investment-company "prima facie evidence" is a SEPARATE, weaker
// evidentiary rule (prima facie, not determinative) — modelled as its own
// classification feeding the same tax-avoidance-purpose conclusion.
// Section 535(a)/(b)'s accumulated-taxable-income computation is exact
// arithmetic over the section 535(b)(1)-(4) adjustments (taxes allowed,
// charitable contributions allowed in full, special deductions disallowed,
// NOL disallowed); section 535(b)(5)'s capital-loss recapture is TECH_GAP
// beyond its (A) general deduction. Section 535(c)'s accumulated earnings
// credit computes the general rule, the $250,000/$150,000 minimum floor
// (with the service-corporation substitution), and the holding/investment-
// company credit, as three alternative calculations. Section 537's
// "reasonable needs of the business" is channeled as DECISION-0194
// EVALUATIVE (no statutory quantification of "reasonably anticipated
// needs"), with the section 303/excess-business-holdings redemption needs
// as their own classification heads per (b)(1)-(2). Section 534's burden-
// of-proof allocation is a Tax Court PROCEDURAL rule — modelled as an
// institutional_effect classification (which party bears the burden), not
// executed as part of the substantive tax computation.

// --- Section 531: imposition ------------------------------------------------

use self::{
    Corporation,
    IRC_S531,
    IRC_S532_A,
    IRC_S532_B,
    IRC_S533_A,
    IRC_S533_B,
    IRC_S534_A,
    IRC_S535_A,
    IRC_S535_B,
    IRC_S535_C,
    IRC_S537_A,
    IRC_S537_B,
    TaxableYear,
    dividends_paid_deduction_561,
};

@source(IRC_S531, quote = "In addition to other taxes imposed by this chapter, there is hereby imposed for each taxable year on the accumulated taxable income (as defined in section 535) of each corporation described in section 532, an accumulated earnings tax equal to 20 percent of the accumulated taxable income.")
pub relation accumulated_taxable_income(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 535(a): the corporation's accumulated taxable income for the taxable year";
}
pub relation corporation_described_in_532(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation is described in section 532 — the accumulated earnings tax applies to it for the taxable year";
}
pub relation accumulated_earnings_tax(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 531: the accumulated earnings tax — 20 percent of accumulated taxable income, imposed on a corporation described in section 532";
}
@source(IRC_S531, quote = "an accumulated earnings tax equal to 20 percent of the accumulated taxable income.")
rule AccumulatedEarningsTaxRule(c: Corporation, y: TaxableYear, income: Money) defeasible {
    label en official "section 531: exact 20 percent calculation";
    when corporation_described_in_532(c, y);
    when accumulated_taxable_income(c, y, income);
    then accumulated_earnings_tax(c, y, round(income * AccumulatedEarningsTaxRate20Percent, 2, "HALF_UP"));
}

// --- Section 532: applicability ---------------------------------------------

pub relation formed_or_availed_for_tax_avoidance_532a(c: Corporation, y: TaxableYear) kind institutional {
    label en official "section 532(a): the corporation is formed or availed of for the purpose of avoiding the income tax with respect to its shareholders (or those of another corporation), by permitting earnings and profits to accumulate instead of being divided or distributed";
}
pub relation personal_holding_company_542(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 532(b)(1): the corporation is a personal holding company as defined in section 542 (this package's own section 542 classification, module 16)";
}
pub relation exempt_under_subchapter_f(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 532(b)(2): the corporation is exempt from tax under subchapter F (section 501 and following) — EXTERNAL_DEPENDENCY, `exempt-organizations`'s own classification";
}
pub relation passive_foreign_investment_company_1297(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 532(b)(3): the corporation is a passive foreign investment company as defined in section 1297 — EXTERNAL_DEPENDENCY, `international`'s own classification";
}
pub relation section_532b_exception_applies(c: Corporation, y: TaxableYear) kind institutional {
    label en official "section 532(b): one of the three exceptions (personal holding company, subchapter F exempt organization, passive foreign investment company) applies, so the accumulated earnings tax does not apply";
}
@source(IRC_S532_B, quote = "a personal holding company (as defined in section 542),")
rule Section532bExceptionFromPhcRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 532(b)(1)";
    when personal_holding_company_542(c, y);
    then section_532b_exception_applies(c, y);
}
@source(IRC_S532_B, quote = "a corporation exempt from tax under subchapter F (section 501 and following), or")
rule Section532bExceptionFromExemptRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 532(b)(2)";
    when exempt_under_subchapter_f(c, y);
    then section_532b_exception_applies(c, y);
}
@source(IRC_S532_B, quote = "a passive foreign investment company (as defined in section 1297).")
rule Section532bExceptionFromPfciRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 532(b)(3)";
    when passive_foreign_investment_company_1297(c, y);
    then section_532b_exception_applies(c, y);
}
@source(IRC_S532_A, quote = "The accumulated earnings tax imposed by section 531 shall apply to every corporation (other than those described in subsection (b)) formed or availed of for the purpose of avoiding the income tax with respect to its shareholders or the shareholders of any other corporation, by permitting earnings and profits to accumulate instead of being divided or distributed.")
rule CorporationDescribedIn532Rule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 532(a): the accumulated-earnings-tax purpose test, outside the section 532(b) exceptions";
    when formed_or_availed_for_tax_avoidance_532a(c, y);
    when not_known(section_532b_exception_applies(c, y));
    then corporation_described_in_532(c, y);
}

// --- Section 533: evidence of purpose — the presumption -------------------

pub relation earnings_permitted_to_accumulate_beyond_reasonable_needs(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 533(a): the earnings and profits of the corporation are permitted to accumulate beyond the reasonable needs of the business";
}
pub relation corporation_proves_no_avoidance_purpose_by_preponderance(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 533(a): the corporation proves, by a preponderance of the evidence, that unreasonable accumulation was not for the purpose of avoiding the income tax with respect to shareholders — rebuts the presumption";
}
@source(IRC_S533_A, quote = "the fact that the earnings and profits of a corporation are permitted to accumulate beyond the reasonable needs of the business shall be determinative of the purpose to avoid the income tax with respect to shareholders, unless the corporation by the preponderance of the evidence shall prove to the contrary.")
presumption UnreasonableAccumulationIsAvoidancePurpose(c: Corporation, y: TaxableYear) {
    label en official "section 533(a): unreasonable accumulation is determinative of the tax-avoidance purpose, unless the corporation proves the contrary by a preponderance of the evidence";
    when earnings_permitted_to_accumulate_beyond_reasonable_needs(c, y);
    presume formed_or_availed_for_tax_avoidance_532a(c, y);
    unless corporation_proves_no_avoidance_purpose_by_preponderance(c, y) then not formed_or_availed_for_tax_avoidance_532a(c, y);
}

// Section 533(b): the holding/investment-company prima facie rule — a
// SEPARATE, weaker evidentiary path (prima facie, not "determinative"),
// feeding the same section 532(a) purpose conclusion via its own defeasible
// rule rather than folding into the presumption above.
pub relation mere_holding_or_investment_company_533b(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 533(b): the corporation is a mere holding or investment company";
}
@source(IRC_S533_B, quote = "The fact that any corporation is a mere holding or investment company shall be prima facie evidence of the purpose to avoid the income tax with respect to shareholders.")
rule HoldingCompanyPrimaFacieAvoidancePurposeRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 533(b): prima facie evidence of avoidance purpose from mere-holding-or-investment-company status, rebuttable the same way as the section 533(a) presumption";
    when mere_holding_or_investment_company_533b(c, y);
    when not_known(corporation_proves_no_avoidance_purpose_by_preponderance(c, y));
    then formed_or_availed_for_tax_avoidance_532a(c, y);
}

// --- Section 534: burden of proof (Tax Court procedure) --------------------

pub relation notification_sent_534b(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 534(b): the Secretary sent, by certified or registered mail, a notification that the proposed deficiency notice includes an accumulated-earnings-tax amount, before mailing the deficiency notice";
}
pub relation taxpayer_statement_submitted_534c(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 534(a)(2)/(c): the taxpayer submitted the statement described in section 534(c) (grounds relied upon to establish that earnings were not permitted to accumulate beyond reasonable needs)";
}
pub relation burden_of_proof_on_secretary_534(c: Corporation, y: TaxableYear) kind institutional {
    label en official "section 534(a): in a Tax Court proceeding on an accumulated-earnings-tax deficiency, the burden of proof on the unreasonable-accumulation allegation is on the Secretary — either because no section 534(b) notification was sent, or (as to the grounds set forth) because the taxpayer submitted the section 534(c) statement";
}
@source(IRC_S534_A, quote = "if notification has not been sent in accordance with subsection (b), be on the Secretary, or")
rule BurdenOnSecretaryNoNotificationRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 534(a)(1): burden on the Secretary absent a section 534(b) notification";
    when corporation_described_in_532(c, y);
    when not_known(notification_sent_534b(c, y));
    then burden_of_proof_on_secretary_534(c, y);
}
@source(IRC_S534_A, quote = "if the taxpayer has submitted the statement described in subsection (c), be on the Secretary with respect to the grounds set forth in such statement in accordance with the provisions of such subsection.")
rule BurdenOnSecretaryStatementSubmittedRule(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 534(a)(2): burden on the Secretary as to the grounds in a submitted section 534(c) statement";
    when notification_sent_534b(c, y);
    when taxpayer_statement_submitted_534c(c, y);
    then burden_of_proof_on_secretary_534(c, y);
}

// --- Section 535: accumulated taxable income --------------------------------

pub relation taxable_income_535(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the corporation's taxable income for the taxable year, before the section 535(b) adjustments (reuses section 11's own `taxable_income` figure conceptually; declared separately here since section 535(b) computes a DIFFERENT adjusted figure from it, not the section 11 base itself)";
}
pub relation section_535b1_taxes_deduction(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 535(b)(1): Federal income/excess-profits taxes and foreign income/war-profits/excess-profits taxes accrued during the year (or deemed paid under section 960), other than the accumulated earnings tax itself and the section 541 personal holding company tax";
}
pub relation section_535b2_charitable_contributions(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 535(b)(2): the section 170 charitable contributions deduction, allowed WITHOUT the section 170(b)(2) percentage limitation";
}
pub relation section_535b3_special_deductions_in_taxable_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 535(b)(3): the amount of part VIII special deductions (dividends-received deduction etc., other than section 248) that was allowed in computing the taxable-income figure above and must now be DISALLOWED for accumulated-taxable-income purposes";
}
pub relation section_535b4_nol_deduction_in_taxable_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 535(b)(4): the amount of the section 172 net operating loss deduction that was allowed in computing the taxable-income figure above and must now be DISALLOWED";
}
pub relation section_535b5a_net_capital_loss(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 535(b)(5)(A): the net capital loss for the taxable year, allowed as a deduction (before the section 535(b)(5)(B) recapture reduction — TECH_GAP, read here as the (A) amount only)";
}
pub relation taxable_income_adjusted_535b(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 535(b): taxable income as adjusted — plus the section 535(b)(1)-(2) allowed items, minus the section 535(b)(3)-(4) disallowed items, plus the section 535(b)(5)(A) capital loss deduction";
}
@source(IRC_S535_B, quote = "For purposes of subsection (a), taxable income shall be adjusted as follows:")
rule TaxableIncomeAdjusted535bRule(c: Corporation, y: TaxableYear, base: Money, taxes: Money, charitable: Money, special: Money, nol: Money, capital_loss: Money) strict {
    label en official "section 535(b)(1)-(5)(A): exact adjustment arithmetic";
    when taxable_income_535(c, y, base);
    when section_535b1_taxes_deduction(c, y, taxes);
    when section_535b2_charitable_contributions(c, y, charitable);
    when section_535b3_special_deductions_in_taxable_income(c, y, special);
    when section_535b4_nol_deduction_in_taxable_income(c, y, nol);
    when section_535b5a_net_capital_loss(c, y, capital_loss);
    then taxable_income_adjusted_535b(c, y, base + taxes + charitable - special - nol + capital_loss);
}

// Section 535(c): accumulated earnings credit.
pub relation is_mere_holding_or_investment_company_535c(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the corporation is a mere holding or investment company, for section 535(c)(1)/(3)'s branching (same concept as section 533(b), a distinct fact here since the two subsections apply it to different consequences)";
}
pub relation earnings_retained_for_reasonable_needs_535c1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 535(c)(1): the part of the earnings and profits for the taxable year retained for the reasonable needs of the business (EVALUATIVE, section 537 — read as a case fact once the section 537 channel resolves it)";
}
pub relation section_535b6_deduction(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 535(b)(6): the deduction referenced in section 535(c)(1)(B) (foreign-tax-credit-related, not separately decomposed this stage)";
}
pub relation accumulated_earnings_credit_general_535c1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 535(c)(1): the general-rule accumulated earnings credit — retained earnings for reasonable needs, minus the section 535(b)(6) deduction";
}
@source(IRC_S535_C, quote = "an amount equal to such part of the earnings and profits for the taxable year as are retained for the reasonable needs of the business, minus (B) the deduction allowed by subsection (b)(6).")
rule AccumulatedEarningsCreditGeneralRule(c: Corporation, y: TaxableYear, retained: Money, b6: Money) strict {
    label en official "section 535(c)(1): exact general-rule credit calculation";
    when not_known(is_mere_holding_or_investment_company_535c(c, y));
    when earnings_retained_for_reasonable_needs_535c1(c, y, retained);
    when section_535b6_deduction(c, y, b6);
    then accumulated_earnings_credit_general_535c1(c, y, retained - b6);
}
pub relation accumulated_earnings_and_profits_preceding_year_535c(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the corporation's accumulated earnings and profits at the close of the preceding taxable year, for the section 535(c)(2)-(3) minimum-credit floor";
}
pub relation principal_function_is_qualified_service_535c2b(c: Corporation, y: TaxableYear) kind empirical {
    label en official "section 535(c)(2)(B): the corporation's principal function is the performance of services in health, law, engineering, architecture, accounting, actuarial science, performing arts, or consulting — substitutes $150,000 for $250,000 in the minimum credit";
}
pub relation minimum_credit_floor_535c2(c: Corporation, y: TaxableYear, floor_amount: Money) kind institutional {
    label en official "section 535(c)(2): the minimum-credit statutory floor amount — $250,000, or $150,000 for a qualified service corporation";
}
@source(IRC_S535_C, quote = "In the case of a corporation the principal function of which is the performance of services in the field of health, law, engineering, architecture, accounting, actuarial science, performing arts, or consulting, subparagraph (A) shall be applied by substituting \"$150,000\" for \"$250,000\".")
rule MinimumCreditFloorServiceRule(c: Corporation, y: TaxableYear) strict {
    label en official "section 535(c)(2)(B): $150,000 floor for a qualified service corporation";
    when principal_function_is_qualified_service_535c2b(c, y);
    then minimum_credit_floor_535c2(c, y, MinimumCreditFloorServiceCorporation);
}
@source(IRC_S535_C, quote = "The credit allowable under paragraph (1) shall in no case be less than the amount by which $250,000 exceeds the accumulated earnings and profits of the corporation at the close of the preceding taxable year.")
rule MinimumCreditFloorGeneralRule(c: Corporation, y: TaxableYear, prior_ep: Money) strict {
    label en official "section 535(c)(2)(A): $250,000 floor absent the service-corporation substitution";
    when accumulated_earnings_and_profits_preceding_year_535c(c, y, prior_ep);
    when not_known(principal_function_is_qualified_service_535c2b(c, y));
    then minimum_credit_floor_535c2(c, y, MinimumCreditFloorGeneral);
}
pub relation minimum_credit_535c2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 535(c)(2): the minimum credit — the floor amount minus the accumulated earnings and profits at the close of the preceding taxable year (not below zero in effect, since the credit is a floor on paragraph (1)'s allowance)";
}
@source(IRC_S535_C, quote = "The credit allowable under paragraph (1) shall in no case be less than the amount by which $250,000 exceeds the accumulated earnings and profits of the corporation at the close of the preceding taxable year.")
rule MinimumCredit535c2Rule(c: Corporation, y: TaxableYear, floor_amount: Money, prior_ep: Money) strict {
    label en official "section 535(c)(2): exact minimum-credit calculation";
    when minimum_credit_floor_535c2(c, y, floor_amount);
    when accumulated_earnings_and_profits_preceding_year_535c(c, y, prior_ep);
    when floor_amount > prior_ep;
    then minimum_credit_535c2(c, y, floor_amount - prior_ep);
}
pub relation accumulated_earnings_credit_holding_company_535c3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 535(c)(3): for a mere holding or investment company, the credit is the amount (if any) by which $250,000 exceeds the accumulated earnings and profits at the close of the preceding taxable year";
}
@source(IRC_S535_C, quote = "In the case of a corporation which is a mere holding or investment company, the accumulated earnings credit is the amount (if any) by which $250,000 exceeds the accumulated earnings and profits of the corporation at the close of the preceding taxable year.")
rule AccumulatedEarningsCreditHoldingCompanyRule(c: Corporation, y: TaxableYear, prior_ep: Money) strict {
    label en official "section 535(c)(3): exact holding-company credit calculation";
    when is_mere_holding_or_investment_company_535c(c, y);
    when accumulated_earnings_and_profits_preceding_year_535c(c, y, prior_ep);
    when MinimumCreditFloorGeneral > prior_ep;
    then accumulated_earnings_credit_holding_company_535c3(c, y, MinimumCreditFloorGeneral - prior_ep);
}
pub relation accumulated_earnings_credit_535c(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 535(c): the accumulated earnings credit actually used in the section 535(a) computation — the general-rule credit (not below the section 535(c)(2) minimum) for a non-holding-company, or the section 535(c)(3) holding-company credit";
}
rule AccumulatedEarningsCreditNonHoldingBelowFloorRule(c: Corporation, y: TaxableYear, general: Money, minimum: Money) strict {
    label en official "section 535(c)(2): the minimum credit governs when it exceeds the general-rule credit";
    when accumulated_earnings_credit_general_535c1(c, y, general);
    when minimum_credit_535c2(c, y, minimum);
    when minimum > general;
    then accumulated_earnings_credit_535c(c, y, minimum);
}
rule AccumulatedEarningsCreditNonHoldingAboveFloorRule(c: Corporation, y: TaxableYear, general: Money, minimum: Money) strict {
    label en official "the general-rule credit governs when it is not below the minimum";
    when accumulated_earnings_credit_general_535c1(c, y, general);
    when minimum_credit_535c2(c, y, minimum);
    when general >= minimum;
    then accumulated_earnings_credit_535c(c, y, general);
}
rule AccumulatedEarningsCreditHoldingCompanyResultRule(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "section 535(c)(3): the holding-company credit is the final figure for a mere holding or investment company";
    when accumulated_earnings_credit_holding_company_535c3(c, y, amount);
    then accumulated_earnings_credit_535c(c, y, amount);
}

// Section 535(a): the top-level computation.
// `dividends_paid_deduction_561` is declared and computed in module 16
// (section 561) and read here directly (same package, no import needed).
@source(IRC_S535_A, quote = "the term \"accumulated taxable income\" means the taxable income, adjusted in the manner provided in subsection (b), minus the sum of the dividends paid deduction (as defined in section 561) and the accumulated earnings credit (as defined in subsection (c)).")
rule AccumulatedTaxableIncomeRule(c: Corporation, y: TaxableYear, adjusted: Money, dpd: Money, credit: Money) strict {
    label en official "section 535(a): exact accumulated-taxable-income calculation";
    when taxable_income_adjusted_535b(c, y, adjusted);
    when dividends_paid_deduction_561(c, y, dpd);
    when accumulated_earnings_credit_535c(c, y, credit);
    then accumulated_taxable_income(c, y, adjusted - (dpd + credit));
}

// --- Section 537: reasonable needs of the business (EVALUATIVE) -----------

external judgment relation earnings_needed_for_anticipated_business_needs(c: Corporation, y: TaxableYear, amount: Money) {
    authority Secretary;
    label en official "section 537(a)(1): the reasonably anticipated needs of the business — DECISION-0194 evaluative channel, no statutory quantification";
}
@source(IRC_S537_B, quote = "the amount needed (or reasonably anticipated to be needed) to make a redemption of stock included in the gross estate of the decedent (but not in excess of the maximum amount of stock to which section 303(a) may apply).")
pub relation section_303_redemption_needs_537b1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 537(a)(2)/(b)(1): the section 303 redemption needs of the business, capped at the section 303(a) ceiling (module 12's `section_303a_ceiling`)";
}
@source(IRC_S537_B, quote = "the amount needed (or reasonably anticipated to be needed) to redeem from a private foundation stock which—")
pub relation excess_business_holdings_redemption_needs_537b2(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 537(a)(3)/(b)(2): the excess business holdings redemption needs of the business (redemption of stock a private foundation held on May 26, 1969 that constituted excess business holdings — TECH_GAP for the full (A)-(B) qualification test, read as a case fact)";
}
pub relation reasonable_needs_of_the_business_537(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 537(a): the reasonable needs of the business — the sum of the reasonably anticipated needs, the section 303 redemption needs, and the excess business holdings redemption needs";
}
@source(IRC_S537_A, quote = "the term \"reasonable needs of the business\" includes—")
rule ReasonableNeedsOfTheBusinessRule(c: Corporation, y: TaxableYear, anticipated: Money, s303: Money, ebh: Money) strict {
    label en official "section 537(a): sum of the three named components";
    when earnings_needed_for_anticipated_business_needs(c, y, anticipated);
    when section_303_redemption_needs_537b1(c, y, s303);
    when excess_business_holdings_redemption_needs_537b2(c, y, ebh);
    then reasonable_needs_of_the_business_537(c, y, anticipated + s303 + ebh);
}

// NOT DONE this stage (TECH_GAP/EXTERNAL_DEPENDENCY, see coverage rows):
// section 532(c) (application without regard to shareholder count —
// NON_NORMATIVE, no independent operative content beyond confirming the
// tax is not limited to closely-held corporations); section 534(c)-(e)
// (the taxpayer's statement contents, the 60-day response window with its
// own exact-date mechanics, and the section 534(a)(2) grounds-matching
// rule); section 535(b)(5)(B)-(C) (the capital-gain-deduction-recapture
// reduction, and its own "nonrecaptured capital gains deductions"
// definition), (b)(6)-(9) (the remaining listed adjustments this file's
// `section_535b6_deduction` placeholder does not itself decompose),
// section 535(d) (United-States-owned foreign corporation source rule —
// EXTERNAL_DEPENDENCY on `international`); section 537(b)(3)-(5)
// (obligations-incurred-to-redeem treated as redemption, product-liability
// loss reserves, and the no-inference-as-to-prior-years clarification).
