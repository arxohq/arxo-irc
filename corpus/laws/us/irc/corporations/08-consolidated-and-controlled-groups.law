// Stage 1b (coordinator continuation, 25.09.2026). Chapter 6: section 1501
// (privilege to file consolidated returns, modelled as a `power`),
// section 1504(a) (affiliated group: 80% vote-and-value test — reuses
// module 06's `meets_1504a2_ownership`). Section 1561 ($250,000
// accumulated-earnings-credit sharing among component members of a
// controlled group) and section 1563(a),(d)-(e) (parent-subsidiary 80%
// test, brother-sister >50% test and the section 1563(f)(5) 80%-and->50%
// "applicable provision" variant, with the (d)-(e) attribution rules).

use self::{
    AttributionKind,
    Corporation,
    IRC_S1501,
    IRC_S1504_A,
    IRC_S1561_A,
    IRC_S1563_A,
    IRC_S1563_E,
    IRC_S1563_F,
    Individual,
    Partnership,
    Person,
    TaxableYear,
    meets_1504a2_ownership,
};

type Organ = us.irc.core::Organ;

// --- Section 1501: privilege to file consolidated returns (power) -----------

pub entity AffiliatedGroup { label en unofficial "one or more chains of includible corporations connected through stock ownership with a common parent (section 1504(a))"; }
pub relation common_parent_of(group: AffiliatedGroup, parent: Corporation) kind empirical {
    label en official "the common parent corporation of the affiliated group (section 1504(a)(1))";
}
pub relation member_of_affiliated_group(group: AffiliatedGroup, member: Corporation) kind empirical {
    label en unofficial "a corporation that is a member of the affiliated group at some time during the taxable year (section 1501)";
}
pub relation all_members_consent_to_1502_regulations(group: AffiliatedGroup, y: TaxableYear) kind empirical {
    label en official "all corporations that were members of the group at any time during the taxable year consent to the section 1502 consolidated return regulations before the return's due date (section 1501)";
}
pub relation makes_consolidated_return(group: AffiliatedGroup, y: TaxableYear) kind empirical {
    label en official "the group makes a consolidated return for the taxable year — itself considered the required consent (section 1501, third sentence)";
}
pub relation consolidated_return_election_effective(group: AffiliatedGroup, y: TaxableYear) kind institutional {
    label en official "the consolidated-return election is validly in effect for the taxable year, in lieu of separate returns (section 1501)";
}
@source(IRC_S1501, quote = "An affiliated group of corporations shall, subject to the provisions of this chapter, have the privilege of making a consolidated return with respect to the income tax imposed by chapter 1 for the taxable year in lieu of separate returns.")
rule Section1501ConsolidatedReturnPowerRule(group: AffiliatedGroup, y: TaxableYear) strict {
    label en official "section 1501: the privilege of filing a consolidated return belongs only to an AFFILIATED group (section 1504(a)) — the election is exercised by filing, but valid only when the filer actually is an affiliated group";
    when makes_consolidated_return(group, y);
    then power Section1501ConsolidatedReturnElection {
        holder AffiliatedGroupHolder(group);
        over group;
        exercise makes_consolidated_return(group, y);
        valid_when affiliated_group(group);
        effect create(consolidated_return_election_effective(group, y));
        window [@1954-08-16, infinity);
    };
}
// `AffiliatedGroupHolder` bridges the group entity to a Person-shaped power
// holder (the common parent files on the group's behalf, section 1502);
// modelled as a thin wrapper rather than making AffiliatedGroup a Person
// subtype, since section 1504(a) never calls the group itself a "person".
pub relation AffiliatedGroupHolder(group: AffiliatedGroup) kind institutional {
    label en unofficial "the affiliated group, referenced as the power's nominal holder (the common parent exercises it in fact per section 1502, not separately modelled)";
}
// The `all_members_consent_to_1502_regulations` fact is a member-level
// condition the (b) sentence spells out in detail (consent = making the
// return); it is exposed as its own relation for a scenario to assert an
// INVALID attempt (e.g. a member that never consents), which by
// construction leaves `makes_consolidated_return` false for that year and
// so `POWER_INVALID_EXERCISE`/no effect follows (E-0239), without a
// separate negative rule.

// --- Section 1504(a): affiliated group definition (80% vote-and-value) ------

pub relation chain_connected_through_ownership(group: AffiliatedGroup, member: Corporation, owner: Corporation) kind empirical {
    label en unofficial "member is connected to the group's chain through stock ownership by owner (an includible corporation), per section 1504(a)(1)(A)/(B)";
}
pub relation is_includible_corporation(corp: Corporation) kind empirical {
    label en unofficial "corp is an 'includible corporation' under section 1504(b) (not exempt under 501, not an 801 insurance company, not foreign, not a RIC/REIT/DISC/S corporation) — asserted directly as a case fact; the six exclusions are TECH_GAP/EXTERNAL_DEPENDENCY, not derived this stage";
}
pub relation affiliated_group(group: AffiliatedGroup) kind institutional {
    label en official "the group of corporations meets the section 1504(a) definition of 'affiliated group'";
}
@source(IRC_S1504_A, quote = "1 or more chains of includible corporations connected through stock ownership with a common parent corporation which is an includible corporation")
rule Section1504aAffiliatedGroupRule(group: AffiliatedGroup, parent: Corporation, member: Corporation, on: Date) defeasible {
    label en official "section 1504(a)(1): affiliated group when the common parent owns 80%-and-80% of at least one member (directly), and every other includible member is 80%-and-80%-owned by one or more other includible members of the group";
    when common_parent_of(group, parent);
    when is_includible_corporation(parent);
    when member_of_affiliated_group(group, member);
    when is_includible_corporation(member);
    when meets_1504a2_ownership(parent, member, on);
    then affiliated_group(group);
}
// A full multi-tier chain proof (paragraph (1)(B)(ii): EVERY non-parent
// member owned 80%-and-80% by SOME other member of the group) is not
// generically derived for an arbitrary chain depth this stage — the rule
// above proves affiliation from the common parent's own direct 80%-and-80%
// stake in AT LEAST one member (paragraph (1)(B)(i)), matching the
// "at least 1" wording exactly; a scenario needing a longer chain asserts
// `meets_1504a2_ownership` pairwise for each link and expects the derived
// `affiliated_group` fact once any one direct parent-to-member link clears
// the bar — TECH_GAP for the full transitive-chain closure over 3+ tiers
// (same object-keyed-chain class as TECH-GAPS.md G24/G25/G37).

pub relation affiliated_group_at_79_9_percent(group: AffiliatedGroup, parent: Corporation, member: Corporation) kind empirical {
    label en unofficial "diagnostic marker for the boundary scenario: parent's voting/value share in member is 79.9%, just under the section 1504(a)(2) threshold — no rule concludes affiliated_group for this case (documented for the coverage row and scenario, not a derived fact)";
}

// NOT DONE this stage: section 1504(a)(3) (5-year re-entry bar after a
// member leaves the group), (a)(4) (excluded "stock" definition: nonvoting/
// limited-preferred/no-conversion), (a)(5) (Secretary's anti-abuse
// regulations); section 1502 (regulations), 1503 (computation and payment,
// dual consolidated loss) — all TECH_GAP/EXTERNAL_DEPENDENCY, not reached
// (outside the "§1501-§1504(a)" boundary the coordinator specified).

// --- Section 1561: accumulated-earnings-credit sharing (controlled group) ---

pub entity ControlledGroup { label en unofficial "a controlled group of corporations within the meaning of section 1563(a)"; }
pub relation component_member_of_controlled_group(group: ControlledGroup, member: Corporation, on_dec_31: Date) kind institutional {
    label en official "a corporation is a component member of the controlled group on a December 31 (section 1563(b))";
}
pub relation controlled_group_apportionment_agreement(group: ControlledGroup, member: Corporation, on_dec_31: Date, share: Money) kind empirical {
    label en unofficial "the apportionment plan/consent under section 1561(a) allocating a share of the single $250,000 ($150,000 if applicable) amount to this component member, for the taxable year including the stated December 31";
}
pub relation accumulated_earnings_credit_limit_shared(group: ControlledGroup, member: Corporation, on_dec_31: Date, amount: Money) kind institutional {
    label en official "the component member's section 535(c)(2)(A) accumulated-earnings-credit minimum amount is limited to its apportioned share of the single group-wide $250,000 ($150,000 for a section 535(c)(2)(B) corporation) amount (section 1561(a))";
}
@source(IRC_S1561_A, quote = "The component members of a controlled group of corporations on a December 31 shall, for their taxable years which include such December 31, be limited for purposes of this subtitle to one $250,000 ($150,000 if any component member is a corporation described in section 535(c)(2)(B)) amount for purposes")
rule Section1561SharedCreditRule(group: ControlledGroup, member: Corporation, on_dec_31: Date, share: Money) defeasible {
    label en official "section 1561(a): the component member's accumulated-earnings-credit minimum is its apportioned share of the ONE group-wide $250,000/$150,000 amount";
    when component_member_of_controlled_group(group, member, on_dec_31);
    when controlled_group_apportionment_agreement(group, member, on_dec_31, share);
    then accumulated_earnings_credit_limit_shared(group, member, on_dec_31, share);
}
// The $250,000/$150,000 group-wide ceiling itself is an A3 parameter
// candidate; not split out as its own `.lawparam.json` this stage since no
// rule here computes a DEFAULT equal-apportionment absent an agreement —
// section 1561(a)'s own text delegates the split to "such consents,
// elections, and other items" the Secretary requires, which this package
// reads as the case-asserted `controlled_group_apportionment_agreement`
// share directly (TECH_GAP: no default equal-share rule when the case
// asserts no apportionment agreement at all). Section 1561(b) (short-
// taxable-year proration) — TECH_GAP, not modelled.

// --- Section 1563(a): controlled group of corporations -----------------------

pub relation parent_subsidiary_ownership_share(group: ControlledGroup, parent: Corporation, subsidiary: Corporation, voting: Decimal, value: Decimal) kind empirical {
    label en unofficial "parent's section 1563(d)(1) stock ownership share (direct plus (e)(1)-(3) attribution) in subsidiary, within the named candidate group: voting power and value, each as a fraction of the total";
}
pub relation parent_subsidiary_controlled_group(group: ControlledGroup, parent: Corporation, subsidiary: Corporation) kind institutional {
    label en official "parent and subsidiary are within a parent-subsidiary controlled group (section 1563(a)(1))";
}
@source(IRC_S1563_A, quote = "stock possessing at least 80 percent of the total combined voting power of all classes of stock entitled to vote or at least 80 percent of the total value of shares of all classes of stock of each of the corporations, except the common parent corporation, is owned")
rule Section1563a1ParentSubsidiaryVotingRule(group: ControlledGroup, parent: Corporation, subsidiary: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 1563(a)(1): 80% voting power (or 80% value) held within the chain, common parent owning at least one member directly at the 80% level (paragraph (1)(B))";
    when parent_subsidiary_ownership_share(group, parent, subsidiary, voting, value);
    when voting >= 0.80;
    then parent_subsidiary_controlled_group(group, parent, subsidiary);
}
@source(IRC_S1563_A, quote = "at least 80 percent of the total value of shares of all classes of stock of each of the corporations")
rule Section1563a1ParentSubsidiaryValueRule(group: ControlledGroup, parent: Corporation, subsidiary: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 1563(a)(1): the alternative 80%-of-value branch of the parent-subsidiary test";
    when parent_subsidiary_ownership_share(group, parent, subsidiary, voting, value);
    when value >= 0.80;
    then parent_subsidiary_controlled_group(group, parent, subsidiary);
}

pub relation five_or_fewer_owners_combined_voting_share(group: ControlledGroup, corp: Corporation, share: Decimal) kind empirical {
    label en unofficial "the combined section 1563(d)(2) ownership share (voting power) that 5 or fewer individuals/estates/trusts hold in corp, identically across the group (section 1563(a)(2))";
}
pub relation brother_sister_controlled_group(group: ControlledGroup, corp: Corporation) kind institutional {
    label en official "corp is a member of a brother-sister controlled group: 5 or fewer individuals/estates/trusts own more than 50 percent of its voting power or value (section 1563(a)(2))";
}
@source(IRC_S1563_A, quote = "Two or more corporations if 5 or fewer persons who are individuals, estates, or trusts own (within the meaning of subsection (d)(2)) stock possessing more than 50 percent of the total combined voting power of all classes of stock entitled to vote or more than 50 percent of the total value of shares")
rule Section1563a2BrotherSisterGeneralRule(group: ControlledGroup, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1563(a)(2): the general (post-simplification) brother-sister test — more than 50 percent combined ownership by 5 or fewer individuals/estates/trusts";
    when five_or_fewer_owners_combined_voting_share(group, corp, share);
    when share > 0.50;
    then brother_sister_controlled_group(group, corp);
}

// Section 1563(f)(5): for an "applicable provision" that incorporates the
// section 1563(a) definition without saying otherwise, (a)(2) is applied as
// if it required BOTH at least 80% identical ownership AND more than 50%
// identical ownership (the historical pre-simplification double test) —
// this is the "brother-sister 50%/80%" test the coordinator's task names.
// (Section 1561 is itself such an "applicable provision": it incorporates
// section 1563(a) for the accumulated-earnings-credit sharing rule.)
pub relation identical_ownership_share_80(group: ControlledGroup, corp: Corporation, share: Decimal) kind empirical {
    label en unofficial "each corporation's identical (i.e. taking the LOWER of each person's ownership across the corporations being compared) combined ownership share, for the section 1563(f)(5) 80% branch";
}
pub relation identical_ownership_share_over_50(group: ControlledGroup, corp: Corporation, share: Decimal) kind empirical {
    label en unofficial "each corporation's identical combined ownership share, for the section 1563(f)(5) more-than-50% branch (the same 5-or-fewer-owners identical-ownership computation as the 80% branch, kept as a separate relation since the statute states them as two independent tests over the same ownership facts)";
}
pub relation brother_sister_controlled_group_1563f5(group: ControlledGroup, corp: Corporation) kind institutional {
    label en official "corp is a member of a brother-sister controlled group under the section 1563(f)(5) 80%-and-more-than-50% double test, for an 'applicable provision' incorporating section 1563(a)(2) (e.g. section 1561)";
}
@source(IRC_S1563_F, quote = "at least 80 percent of the total combined voting power of all classes of stock entitled to vote, or at least 80 percent of the total value of shares of all classes of stock, of each corporation, and")
rule Section1563f5EightyPercentBranchRule(group: ControlledGroup, corp: Corporation, share80: Decimal, share50: Decimal) defeasible {
    label en official "section 1563(f)(5)(A)-(B): 80% identical ownership AND more than 50% identical ownership (taking into account each person's ownership only to the extent it is identical across the corporations)";
    when identical_ownership_share_80(group, corp, share80);
    when identical_ownership_share_over_50(group, corp, share50);
    when share80 >= 0.80;
    when share50 > 0.50;
    then brother_sister_controlled_group_1563f5(group, corp);
}

// --- Section 1563(d): attribution for parent-subsidiary/brother-sister ------

pub relation option_to_acquire_stock_1563(holder: Person, corp: Corporation, share: Decimal) kind empirical {
    label en official "an option to acquire stock, considered owned by the option holder for section 1563 purposes (section 1563(e)(1))";
}
pub relation partner_5_percent_or_more_1563(partner: Person, partnership: Partnership, interest_share: Decimal) kind empirical {
    label en official "a partner with a 5 percent or more interest in capital or profits of the partnership, for section 1563(e)(2) attribution";
}
pub relation beneficiary_5_percent_actuarial_interest_1563(beneficiary: Person, estate_or_trust: Person, actuarial_share: Decimal) kind empirical {
    label en official "a beneficiary with a 5 percent or more actuarial interest in an estate or trust, for section 1563(e)(3)(A) attribution";
}
pub relation five_percent_or_more_owner_of_corp_1563(owner: Person, corp: Corporation, owned_share: Decimal) kind empirical {
    label en official "a person who owns 5 percent or more in value of a corporation's stock, for section 1563(e)(4) attribution FROM that corporation";
}
pub relation spouse_of_1563(spouse: Individual, ind: Individual) kind empirical {
    label en official "spouse attribution under section 1563(e)(5), before the four exceptions (e)(5)(A)-(D)";
}
pub relation spouse_attribution_1563e5_exception_applies(spouse: Individual, ind: Individual, corp: Corporation) kind institutional {
    label en unofficial "one of the four section 1563(e)(5)(A)-(D) exceptions removes spouse-to-spouse attribution for this corporation (no direct ownership, no director/employee/management participation, at most 50% passive-income gross receipts, and no restrictive-transfer conditions) — asserted as a case-level composite, not decomposed into the four sub-tests this stage";
}
pub relation minor_child_or_parent_of_1563(a: Individual, b: Individual) kind empirical {
    label en official "a is the minor child (under 21) of b, or (if b has not attained 21) a is b's parent, for section 1563(e)(6)(A) attribution (adopted child treated as a child by blood, section 1563(e)(6)(C))";
}

pub relation constructive_ownership_1563(p: Person, corp: Corporation, share: Decimal, via: AttributionKind) kind institutional {
    label en official "constructive stock ownership for section 1563 purposes (section 1563(d)-(e)) — a SEPARATE relation from module 03's section 318(a) constructive_ownership, since the two sections' attribution rules differ (e.g. 5%-not-50% partnership/estate/corporation thresholds, and the minor-child-under-21 family test)";
}
@source(IRC_S1563_E, quote = "If any person has an option to acquire stock, such stock shall be considered as owned by such person.")
rule Section1563OptionAttributionRule(holder: Person, corp: Corporation, share: Decimal) defeasible {
    when option_to_acquire_stock_1563(holder, corp, share);
    then constructive_ownership_1563(holder, corp, share, Option);
}
@source(IRC_S1563_E, quote = "Stock owned, directly or indirectly, by or for a partnership shall be considered as owned by any partner having an interest of 5 percent or more in either the capital or profits of the partnership in proportion to his interest in capital or profits, whichever such proportion is the greater.")
rule Section1563PartnerAttributionRule(partner: Person, partnership: Partnership, interest_share: Decimal, corp: Corporation, share: Decimal) defeasible {
    when partner_5_percent_or_more_1563(partner, partnership, interest_share);
    when us.irc.core::ownership_interest(_, partnership, corp, share);
    then constructive_ownership_1563(partner, corp, share * interest_share, FromEntity);
}
@source(IRC_S1563_E, quote = "Stock owned, directly or indirectly, by or for an estate or trust shall be considered as owned by any beneficiary who has an actuarial interest of 5 percent or more in such stock, to the extent of such actuarial interest.")
rule Section1563BeneficiaryAttributionRule(beneficiary: Person, estate_or_trust: Person, actuarial_share: Decimal, corp: Corporation, share: Decimal) defeasible {
    when beneficiary_5_percent_actuarial_interest_1563(beneficiary, estate_or_trust, actuarial_share);
    when us.irc.core::ownership_interest(_, estate_or_trust, corp, share);
    then constructive_ownership_1563(beneficiary, corp, share * actuarial_share, FromEntity);
}
@source(IRC_S1563_E, quote = "Stock owned, directly or indirectly, by or for a corporation shall be considered as owned by any person who owns (within the meaning of subsection (d)) 5 percent or more in value of its stock in that proportion which the value of the stock which such person so owns bears to the value of all the stock")
rule Section1563FivePercentCorpAttributionRule(owner: Person, held: Corporation, owned_share: Decimal, target: Corporation, held_share: Decimal) defeasible {
    when five_percent_or_more_owner_of_corp_1563(owner, held, owned_share);
    when owned_share >= 0.05;
    when us.irc.core::ownership_interest(_, held, target, held_share);
    then constructive_ownership_1563(owner, target, held_share * owned_share, FromEntity);
}
@source(IRC_S1563_E, quote = "An individual shall be considered as owning stock in a corporation owned, directly or indirectly, by or for his spouse")
rule Section1563SpouseAttributionRule(ind: Individual, spouse: Individual, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1563(e)(5): spouse attribution, unless one of the (A)-(D) exceptions applies";
    when spouse_of_1563(spouse, ind);
    when not_known(spouse_attribution_1563e5_exception_applies(spouse, ind, corp));
    when us.irc.core::ownership_interest(_, spouse, corp, share);
    then constructive_ownership_1563(ind, corp, share, Family);
}
@source(IRC_S1563_E, quote = "An individual shall be considered as owning stock owned, directly or indirectly, by or for his children who have not attained the age of 21 years, and, if the individual has not attained the age of 21 years, the stock owned, directly or indirectly, by or for his parents.")
rule Section1563MinorChildParentAttributionRule(a: Individual, b: Individual, corp: Corporation, share: Decimal) defeasible {
    when minor_child_or_parent_of_1563(a, b);
    when us.irc.core::ownership_interest(_, b, corp, share);
    then constructive_ownership_1563(a, corp, share, Family);
}
// Section 1563(f)(2)(A)-(B) (the analogous "actually owned" re-application
// and no-double-family/no-re-family-attribution operating rules) are
// satisfied BY CONSTRUCTION, same pattern as module 03's section
// 318(a)(5)(B)-(C): every rule above reads only direct `ownership_interest`,
// never `constructive_ownership_1563` itself, so no double attribution can
// occur. Section 1563(f)(3) (tie-break among several persons/provisions
// attributing the same stock) — TECH_GAP, not modelled.

// NOT DONE this stage in section 1563: (a)(3)-(4) (combined and insurance-
// company controlled groups), (b) (component-member timing rules:
// excluded/additional members, short years), (c) (the "stock" exclusions
// and the 50%-common-ownership excluded-stock carve-outs (c)(2)(A)-(B)),
// (f)(1) (the "employee" cross-reference to section 3121(d)), (f)(4)
// (franchised-corporation excluded-member test) — all TECH_GAP, not
// reached (outside the "(a),(d)-(e)" boundary the coordinator specified,
// except where (f)(5)/(f)(2) were needed to complete the named tests).
