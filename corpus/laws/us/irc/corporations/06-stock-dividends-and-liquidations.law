// Stage 1b (coordinator continuation, 25.09.2026). Section 305(a)-(b) (stock
// dividends), Part II subpart A: section 331 (gain/loss to shareholder in
// complete liquidation), section 332 (complete liquidations of
// subsidiaries: 80% control, the 3-year plan), section 334(a)-(b) (basis of
// property received in liquidation), section 336(a)-(b),(d) (corporate gain
// or loss on liquidating distribution; related-person loss limitations),
// section 337(a) (nonrecognition for property distributed to the
// 80-percent distributee in a section 332 liquidation).
//
// METHOD: "80-percent distributee"/"the requirements of section 1504(a)(2)"
// is the SAME 80%-voting-power-and-80%-value test as module 05's
// `controls_80` (section 368(c)) IN SUBSTANCE, but section 332(b)(1)/
// 337(c) name section 1504(a)(2) specifically, not section 368(c) — modelled
// as its own relation `meets_1504a2_ownership` (module 08 also reads this
// same relation for the affiliated-group test, so the two are unified
// rather than duplicated under different names).

use self::{
    Corporation,
    DistributionEvent,
    IRC_S1504_A,
    IRC_S305_A,
    IRC_S305_B,
    IRC_S331_A,
    IRC_S332_A,
    IRC_S332_B,
    IRC_S334_A,
    IRC_S334_B,
    IRC_S336_A,
    IRC_S336_B,
    IRC_S336_D,
    IRC_S337_A,
    Person,
    TaxableYear,
    section_337_disapplied_337b2,
    section_337a_and_b1_disapplied_367e2,
};

pub relation stock_distribution(dist: DistributionEvent, corp: Corporation, shareholder: Person, on: Date) kind empirical {
    label en official "a distribution of the stock of a corporation made by the corporation to its shareholders with respect to its stock (section 305(a))";
}

// --- Section 305(a)-(b): stock dividends -------------------------------------

pub relation stock_dividend_non_inclusion(dist: DistributionEvent) kind institutional {
    label en official "gross income does not include the amount of the stock distribution (section 305(a))";
}
pub relation elective_stock_or_property_distribution(dist: DistributionEvent) kind empirical {
    label en official "the distribution is, at the election of any shareholder, payable either in stock or in property (section 305(b)(1))";
}
pub relation disproportionate_result_property_and_increased_interest(dist: DistributionEvent) kind empirical {
    label en unofficial "the distribution (or series) results in some shareholders receiving property and others having an increased proportionate interest (section 305(b)(2))";
}
pub relation preferred_common_split_result(dist: DistributionEvent) kind empirical {
    label en unofficial "the distribution (or series) results in some common shareholders receiving preferred stock and others receiving common stock (section 305(b)(3))";
}
pub relation distribution_with_respect_to_preferred_stock(dist: DistributionEvent) kind empirical {
    label en official "the distribution is with respect to preferred stock, other than a conversion-ratio increase solely accounting for a stock dividend or split (section 305(b)(4))";
}
pub relation convertible_preferred_stock_distribution(dist: DistributionEvent) kind empirical {
    label en official "the distribution is of convertible preferred stock (section 305(b)(5))";
}
pub relation established_no_305b2_result(dist: DistributionEvent) kind institutional {
    label en unofficial "it is established to the Secretary's satisfaction that the convertible-preferred distribution will not have the section 305(b)(2) disproportionate result (section 305(b)(5) exception)";
}
pub external judgment relation Section305b5NoDisproportionateResultEstablished(dist: DistributionEvent) {
    authority Secretary;
    label en official "DECISION-0194 evaluative channel bridging to established_no_305b2_result";
}
rule EstablishedNo305b2ResultFromJudgment(dist: DistributionEvent) defeasible {
    when Section305b5NoDisproportionateResultEstablished(dist);
    then established_no_305b2_result(dist);
}

pub relation stock_distribution_section_301_treatment(dist: DistributionEvent) kind institutional {
    label en official "section 305(a) non-inclusion does not apply, and the distribution is treated as a section 301 property distribution (section 305(b))";
}
@source(IRC_S305_B, quote = "If the distribution is, at the election of any of the shareholders (whether exercised before or after the declaration thereof), payable either—")
rule Section305bFromElection(dist: DistributionEvent) defeasible {
    label en official "section 305(b)(1): elective stock-or-property distributions are section 301 property distributions";
    when elective_stock_or_property_distribution(dist);
    then stock_distribution_section_301_treatment(dist);
}
@source(IRC_S305_B, quote = "If the distribution (or a series of distributions of which such distribution is one) has the result of—")
rule Section305bFromDisproportionateResult(dist: DistributionEvent) defeasible {
    label en official "section 305(b)(2): disproportionate stock distributions are section 301 property distributions";
    when disproportionate_result_property_and_increased_interest(dist);
    then stock_distribution_section_301_treatment(dist);
}
@source(IRC_S305_B, quote = "If the distribution (or a series of distributions of which such distribution is one) has the result of—")
rule Section305bFromPreferredCommonSplit(dist: DistributionEvent) defeasible {
    label en official "section 305(b)(3): preferred/common split distributions are section 301 property distributions";
    when preferred_common_split_result(dist);
    then stock_distribution_section_301_treatment(dist);
}
@source(IRC_S305_B, quote = "If the distribution is with respect to preferred stock, other than an increase in the conversion ratio of convertible preferred stock made solely to take account of a stock dividend or stock split with respect to the stock into which such convertible stock is convertible.")
rule Section305bFromPreferredStockDistribution(dist: DistributionEvent) defeasible {
    label en official "section 305(b)(4): distributions with respect to preferred stock are section 301 property distributions";
    when distribution_with_respect_to_preferred_stock(dist);
    then stock_distribution_section_301_treatment(dist);
}
@source(IRC_S305_B, quote = "If the distribution is of convertible preferred stock, unless it is established to the satisfaction of the Secretary that such distribution will not have the result described in paragraph (2).")
rule Section305bFromConvertiblePreferred(dist: DistributionEvent) defeasible {
    label en official "section 305(b)(5): convertible preferred stock distributions are section 301 property distributions unless the Secretary is satisfied there is no (b)(2) result";
    when convertible_preferred_stock_distribution(dist);
    when not_known(established_no_305b2_result(dist));
    then stock_distribution_section_301_treatment(dist);
}
@source(IRC_S305_A, quote = "Except as otherwise provided in this section, gross income does not include the amount of any distribution of the stock of a corporation made by such corporation to its shareholders with respect to its stock.")
rule Section305aNonInclusionDefaultRule(dist: DistributionEvent, corp: Corporation, shareholder: Person, on: Date) defeasible {
    label en official "section 305(a): a stock distribution is excluded from gross income unless section 305(b) applies";
    when stock_distribution(dist, corp, shareholder, on);
    when not_known(stock_distribution_section_301_treatment(dist));
    then stock_dividend_non_inclusion(dist);
}

// --- Section 331: gain or loss to shareholder in complete liquidation --------

pub entity Liquidation { label en unofficial "a complete liquidation of a corporation, for purposes of Part II subpart A"; }
pub relation liquidating_distribution(liq: Liquidation, corp: Corporation, shareholder: Person, on: Date) kind empirical {
    label en official "amounts received by a shareholder in a distribution in complete liquidation of the corporation (section 331(a))";
}
pub relation liquidation_full_payment_exchange_treatment(liq: Liquidation, shareholder: Person) kind institutional {
    label en official "amounts received by the shareholder are treated as in full payment in exchange for the stock (section 331(a))";
}
@source(IRC_S331_A, quote = "Amounts received by a shareholder in a distribution in complete liquidation of a corporation shall be treated as in full payment in exchange for the stock.")
rule Section331ExchangeTreatmentRule(liq: Liquidation, corp: Corporation, shareholder: Person, on: Date) strict {
    label en official "section 331(a): complete-liquidation proceeds are exchange consideration for the stock, not a section 301 distribution";
    when liquidating_distribution(liq, corp, shareholder, on);
    then liquidation_full_payment_exchange_treatment(liq, shareholder);
}
// Section 331(b): section 301 does not apply to a complete-liquidation
// distribution — the negative counterpart of (a), satisfied by construction
// since this package's section 301 rules key off `distribution`
// (module 02), a DIFFERENT relation from `liquidating_distribution`; a case
// asserting a liquidating distribution never triggers module 02's rules.
// Section 331(c) is a pure cross-reference to section 1001 — NON_NORMATIVE
// (satisfied by the property-transactions package's own section 1001 rules,
// not repeated here).

// --- Section 332: complete liquidations of subsidiaries ---------------------

pub relation meets_1504a2_ownership(owner: Corporation, subsidiary: Corporation, on: Date) kind institutional {
    label en official "the owner possesses stock in the subsidiary meeting section 1504(a)(2): at least 80 percent of total voting power and at least 80 percent of total value, as of the date (shared by section 332(b)(1), section 337(c), and module 08's affiliated-group test)";
}
@source(IRC_S1504_A, quote = "possesses at least 80 percent of the total voting power of the stock of such corporation, and")
@source(IRC_S1504_A, quote = "has a value equal to at least 80 percent of the total value of the stock of such corporation.")
rule Meets1504a2OwnershipRule(owner: Corporation, subsidiary: Corporation, on: Date, voting: Decimal, value: Decimal) strict {
    label en official "section 1504(a)(2): 80% voting power and 80% value";
    when voting_power_share_in(owner, subsidiary, on, voting);
    when value_share_in(owner, subsidiary, on, value);
    when voting >= 0.80;
    when value >= 0.80;
    then meets_1504a2_ownership(owner, subsidiary, on);
}
pub relation voting_power_share_in(owner: Corporation, subsidiary: Corporation, on: Date, share: Decimal) kind empirical {
    label en unofficial "owner's share of the total voting power of the subsidiary's stock, as of the date";
}
pub relation value_share_in(owner: Corporation, subsidiary: Corporation, on: Date, share: Decimal) kind empirical {
    label en unofficial "owner's share of the total value of the subsidiary's stock, as of the date";
}

pub relation owned_continuously_from_plan_adoption(owner: Corporation, subsidiary: Corporation, plan_adopted_on: Date, receipt_on: Date) kind empirical {
    label en official "the owner held the section 1504(a)(2) ownership continuously from the date the plan of liquidation was adopted until the receipt of the property (section 332(b)(1))";
}
pub relation liquidation_plan_adopted(liq: Liquidation, plan_adopted_on: Date) kind empirical {
    label en official "the date the plan of complete liquidation was adopted (section 332(b))";
}
pub relation transfer_completed_within_taxable_year(liq: Liquidation, y: TaxableYear) kind empirical {
    label en official "the complete cancellation-or-redemption transfer of all property occurs within the taxable year of the first distribution (section 332(b)(2))";
}
pub relation series_of_distributions_within_3_years(liq: Liquidation, first_distribution_year: TaxableYear) kind empirical {
    label en official "the liquidation is one of a series of distributions completing the transfer of all property within 3 years from the close of the taxable year of the first distribution under the plan (section 332(b)(3))";
}
pub relation qualified_continuously_until_transfer_complete(liq: Liquidation, owner: Corporation, subsidiary: Corporation) kind empirical {
    label en unofficial "the taxpayer continued to qualify under section 332(b)(1) until the completion of the (b)(3) 3-year transfer";
}

pub relation section_332_complete_liquidation(liq: Liquidation, owner: Corporation, subsidiary: Corporation) kind institutional {
    label en official "the distribution is considered to be a complete liquidation of the subsidiary for section 332 purposes (section 332(b))";
}
@source(IRC_S332_B, quote = "the distribution is by such other corporation in complete cancellation or redemption of all its stock, and the transfer of all the property occurs within the taxable year")
rule Section332CompleteLiquidationSingleYearRule(liq: Liquidation, owner: Corporation, subsidiary: Corporation, plan_adopted_on: Date, receipt_on: Date, y: TaxableYear) defeasible {
    label en official "section 332(b)(1)+(2): 80%-control ownership continuously held, and the whole transfer completed within one taxable year";
    when meets_1504a2_ownership(owner, subsidiary, plan_adopted_on);
    when owned_continuously_from_plan_adoption(owner, subsidiary, plan_adopted_on, receipt_on);
    when transfer_completed_within_taxable_year(liq, y);
    then section_332_complete_liquidation(liq, owner, subsidiary);
}
@source(IRC_S332_B, quote = "such distribution is one of a series of distributions by such other corporation in complete cancellation or redemption of all its stock in accordance with a plan of liquidation under which the transfer of all the property under the liquidation is to be completed within 3 years from the close of the taxable year during which is made the first of the series of distributions under the plan")
rule Section332CompleteLiquidation3YearPlanRule(liq: Liquidation, owner: Corporation, subsidiary: Corporation, plan_adopted_on: Date, receipt_on: Date, y: TaxableYear) defeasible {
    label en official "section 332(b)(1)+(3): 80%-control ownership continuously held, and the transfer completed within the 3-year plan window with continued qualification";
    when meets_1504a2_ownership(owner, subsidiary, plan_adopted_on);
    when owned_continuously_from_plan_adoption(owner, subsidiary, plan_adopted_on, receipt_on);
    when series_of_distributions_within_3_years(liq, y);
    when qualified_continuously_until_transfer_complete(liq, owner, subsidiary);
    then section_332_complete_liquidation(liq, owner, subsidiary);
}

pub relation section_332_nonrecognition(liq: Liquidation, owner: Corporation) kind institutional {
    label en official "no gain or loss is recognized on the receipt by the parent corporation of property distributed in complete liquidation of the subsidiary (section 332(a))";
}
@source(IRC_S332_A, quote = "No gain or loss shall be recognized on the receipt by a corporation of property distributed in complete liquidation of another corporation.")
rule Section332NonrecognitionRule(liq: Liquidation, owner: Corporation, subsidiary: Corporation) defeasible {
    label en official "section 332(a): nonrecognition to the parent, conditioned on the section 332(b) complete-liquidation qualification";
    when section_332_complete_liquidation(liq, owner, subsidiary);
    then section_332_nonrecognition(liq, owner);
}
// Without section 332(b) qualification, `section_332_complete_liquidation`
// is not derived, so `section_332_nonrecognition` stays UNDETERMINED and
// the ordinary section 331/section 1001 gain-or-loss rules of module 02/
// property-transactions apply instead — the negative branch by construction,
// matching the pattern used throughout this package for "unless qualified".

pub relation section_332_applies_to_liquidation(liq: Liquidation) kind institutional {
    label en unofficial "true whenever some section_332_complete_liquidation(liq, owner, subsidiary) holds for this liquidation — a projection helper so other rules can guard with not_known(...) without an unbound '_' (§98/E-0165 forbids '_' under not_known)";
}
rule Section332AppliesHelperRule(liq: Liquidation, owner: Corporation, subsidiary: Corporation) defeasible {
    label en unofficial "helper projection, not itself a norm";
    when section_332_complete_liquidation(liq, owner, subsidiary);
    then section_332_applies_to_liquidation(liq);
}

// --- Section 334(a)-(b): basis of property received in liquidation ----------

pub relation liquidation_gain_or_loss_recognized(liq: Liquidation, shareholder: Person, on: Date) kind empirical {
    label en unofficial "gain or loss IS recognized on receipt of the liquidating distribution (section 334(a) trigger) — the ordinary case, i.e. section 332 does NOT apply to this shareholder";
}
pub relation liquidation_property_fmv(liq: Liquidation, shareholder: Person, amount: Money) kind empirical {
    label en unofficial "the fair market value of property received in the liquidating distribution, at the time of distribution";
}
pub relation liquidation_property_basis(shareholder: Person, liq: Liquidation, amount: Money) kind institutional {
    label en official "the basis of property received in a complete liquidation in the hands of the distributee (section 334(a): FMV when gain/loss is recognized; section 334(b): carryover, with the two 334(b)(1) exceptions, when section 332 applies)";
}
@source(IRC_S334_A, quote = "If property is received in a distribution in complete liquidation, and if gain or loss is recognized on receipt of such property, then the basis of the property in the hands of the distributee shall be the fair market value of such property at the time of the distribution.")
rule Section334aFmvBasisRule(shareholder: Person, liq: Liquidation, on: Date, fmv: Money) defeasible {
    label en official "section 334(a): FMV basis when gain or loss is recognized on the liquidating distribution";
    when liquidation_gain_or_loss_recognized(liq, shareholder, on);
    when liquidation_property_fmv(liq, shareholder, fmv);
    then liquidation_property_basis(shareholder, liq, fmv);
}

pub relation transferor_basis_in_liquidated_property(subsidiary: Corporation, liq: Liquidation, on: Date, amount: Money) kind empirical {
    label en unofficial "the liquidating subsidiary's own adjusted basis in the distributed property immediately before the distribution — the section 334(b)(1) carryover starting point";
}
pub relation liquidating_corp_recognizes_gain_on_property(liq: Liquidation, on: Date) kind empirical {
    label en official "the liquidating corporation recognizes gain or loss with respect to this specific property (section 334(b)(1)(A) exception, e.g. under section 336(a) because section 337 does not shield it)";
}
@source(IRC_S334_B, quote = "If property is received by a corporate distributee in a distribution in a complete liquidation to which section 332 applies (or in a transfer described in section 337(b)(1)), the basis of such property in the hands of such distributee shall be the same as it would be in the hands of the transferor")
rule Section334bCarryoverBasisRule(owner: Corporation, liq: Liquidation, subsidiary: Corporation, on: Date, transferor_basis: Money) defeasible {
    label en official "section 334(b)(1): carryover basis for a corporate distributee under section 332, absent the (A) recognized-gain exception";
    when section_332_complete_liquidation(liq, owner, subsidiary);
    when transferor_basis_in_liquidated_property(subsidiary, liq, on, transferor_basis);
    when not_known(liquidating_corp_recognizes_gain_on_property(liq, on));
    then liquidation_property_basis(owner, liq, transferor_basis);
}
@source(IRC_S334_B, quote = "the basis of such property shall be the fair market value of the property at the time of the distribution in any case in which gain or loss is recognized by the liquidating corporation with respect to such property, and")
rule Section334b1aFmvExceptionRule(owner: Corporation, liq: Liquidation, subsidiary: Corporation, on: Date, fmv: Money) defeasible {
    label en official "section 334(b)(1)(A): FMV basis exception when the liquidating corporation recognizes gain or loss on this property";
    when section_332_complete_liquidation(liq, owner, subsidiary);
    when liquidating_corp_recognizes_gain_on_property(liq, on);
    when liquidation_property_fmv(liq, owner, fmv);
    then liquidation_property_basis(owner, liq, fmv);
}
// Section 334(b)(1)(B) (section 362(e)(1)(B) built-in-loss-importation
// exception) — TECH_GAP, needs module 07's section 362(e) built-in-loss
// machinery cross-referenced into the liquidation basis rule; not wired
// this stage.

// --- Section 336(a)-(b),(d): corporate gain/loss on liquidating distribution -

pub relation corp_adjusted_basis_of_liquidated_property(liq: Liquidation, amount: Money) kind empirical {
    label en unofficial "the liquidating corporation's adjusted basis in the property distributed in the liquidation";
}
pub relation liquidating_corp_gain(liq: Liquidation, amount: Money) kind institutional {
    label en official "gain recognized to the liquidating corporation as if the distributed property were sold to the distributee at FMV (section 336(a))";
}
pub relation liquidating_corp_loss(liq: Liquidation, amount: Money) kind institutional {
    label en official "loss recognized to the liquidating corporation as if the distributed property were sold to the distributee at FMV (section 336(a))";
}
pub relation liability_on_liquidated_property(liq: Liquidation, amount: Money) kind empirical {
    label en unofficial "the amount of a liability to which the liquidated property is subject, or which the shareholder assumes in connection with the distribution (section 336(b) FMV floor)";
}
pub relation effective_fmv_for_336(liq: Liquidation, amount: Money) kind institutional {
    label en unofficial "the FMV used for section 336(a)/section 337 purposes, treated as not less than any liability under section 336(b)";
}
@source(IRC_S336_B, quote = "the fair market value of such property shall be treated as not less than the amount of such liability.")
rule EffectiveFmv336FloorRule(liq: Liquidation, fmv: Money, liability: Money) defeasible {
    label en official "section 336(b): the FMV floor is the liability amount when it exceeds stated FMV";
    when liquidation_property_fmv(liq, _, fmv);
    when liability_on_liquidated_property(liq, liability);
    when liability > fmv;
    then effective_fmv_for_336(liq, liability);
}
@source(IRC_S336_B, quote = "the fair market value of such property shall be treated as not less than the amount of such liability.")
rule EffectiveFmv336StatedRule(liq: Liquidation, fmv: Money, liability: Money) defeasible {
    label en official "section 336(b): stated FMV governs when it is at least the liability amount";
    when liquidation_property_fmv(liq, _, fmv);
    when liability_on_liquidated_property(liq, liability);
    when fmv >= liability;
    then effective_fmv_for_336(liq, fmv);
}
@source(IRC_S336_A, quote = "gain or loss shall be recognized to a liquidating corporation on the distribution of property in complete liquidation as if such property were sold to the distributee at its fair market value.")
rule Section336aGainRule(liq: Liquidation, fmv: Money, basis: Money) defeasible {
    label en official "section 336(a): gain to the liquidating corporation when effective FMV exceeds adjusted basis";
    when effective_fmv_for_336(liq, fmv);
    when corp_adjusted_basis_of_liquidated_property(liq, basis);
    when not_known(section_332_applies_to_liquidation(liq));
    when fmv > basis;
    then liquidating_corp_gain(liq, fmv - basis);
}
@source(IRC_S336_A, quote = "gain or loss shall be recognized to a liquidating corporation on the distribution of property in complete liquidation as if such property were sold to the distributee at its fair market value.")
rule Section336aLossRule(liq: Liquidation, fmv: Money, basis: Money) defeasible {
    label en official "section 336(a): loss to the liquidating corporation when adjusted basis exceeds effective FMV, absent a section 332 liquidation or a related-person/disqualified-property block";
    when effective_fmv_for_336(liq, fmv);
    when corp_adjusted_basis_of_liquidated_property(liq, basis);
    when not_known(section_332_applies_to_liquidation(liq));
    when not_known(section_336d_loss_disallowed(liq));
    when basis > fmv;
    then liquidating_corp_loss(liq, basis - fmv);
}

pub relation liquidation_distributee_is_related_person(liq: Liquidation, distributee: Person) kind empirical {
    label en official "the distributee is a related person within the meaning of section 267 (section 336(d)(1)(A))";
}
pub relation liquidation_not_pro_rata(liq: Liquidation) kind empirical {
    label en official "the distribution to the related person is not pro rata (section 336(d)(1)(A)(i))";
}
pub relation liquidation_property_is_disqualified(liq: Liquidation) kind empirical {
    label en official "the distributed property is disqualified property: acquired by the liquidating corporation in a section 351 transaction or as a contribution to capital during the 5-year period ending on the distribution date, or has a basis determined by reference to such property (section 336(d)(1)(B))";
}
pub relation section_336d_loss_disallowed(liq: Liquidation) kind institutional {
    label en official "no loss is recognized to the liquidating corporation on the distribution to a related person (section 336(d)(1))";
}
@source(IRC_S336_D, quote = "No loss shall be recognized to a liquidating corporation on the distribution of any property to a related person (within the meaning of section 267) if—")
rule Section336dLossDisallowedNotProRataRule(liq: Liquidation, distributee: Person) defeasible {
    label en official "section 336(d)(1)(A)(i): related-person, non-pro-rata distribution — no loss";
    when liquidation_distributee_is_related_person(liq, distributee);
    when liquidation_not_pro_rata(liq);
    then section_336d_loss_disallowed(liq);
}
@source(IRC_S336_D, quote = "No loss shall be recognized to a liquidating corporation on the distribution of any property to a related person (within the meaning of section 267) if—")
rule Section336dLossDisallowedDisqualifiedPropertyRule(liq: Liquidation, distributee: Person) defeasible {
    label en official "section 336(d)(1)(A)(ii): related-person distribution of disqualified property — no loss";
    when liquidation_distributee_is_related_person(liq, distributee);
    when liquidation_property_is_disqualified(liq);
    then section_336d_loss_disallowed(liq);
}
@source(IRC_S336_D, quote = "In the case of any liquidation to which section 332 applies, no loss shall be recognized to the liquidating corporation on any distribution in such liquidation.")
rule Section336d3NoLossUnder332Rule(liq: Liquidation, owner: Corporation, subsidiary: Corporation) defeasible {
    label en official "section 336(d)(3): no loss to the liquidating corporation on any distribution in a section 332 liquidation";
    when section_332_complete_liquidation(liq, owner, subsidiary);
    then section_336d_loss_disallowed(liq);
}
// Section 336(d)(2) (basis-haircut for built-in-loss property acquired with
// a tax-avoidance principal purpose, in lieu of outright disallowance) —
// TECH_GAP, not modelled (a narrower alternative to (d)(1) this stage does
// not reach). Section 336(e) (stock-sale-as-asset-sale election) — TECH_GAP,
// a `power` this stage does not model.

// --- Section 337(a): nonrecognition to the subsidiary on liquidation ---------

pub relation section_337_nonrecognition(liq: Liquidation, subsidiary: Corporation) kind institutional {
    label en official "no gain or loss is recognized to the liquidating corporation on the distribution to the 80-percent distributee in a section 332 liquidation (section 337(a))";
}
@source(IRC_S337_A, quote = "No gain or loss shall be recognized to the liquidating corporation on the distribution to the 80-percent distributee of any property in a complete liquidation to which section 332 applies.")
rule Section337aNonrecognitionRule(liq: Liquidation, owner: Corporation, subsidiary: Corporation) defeasible {
    label en official "section 337(a): nonrecognition to the subsidiary, conditioned on the section 332 qualification (the 80-percent distributee is `owner` per section 337(c) / section 332(b)'s meets_1504a2_ownership)";
    when section_332_complete_liquidation(liq, owner, subsidiary);
    when not_known(section_337a_and_b1_disapplied_367e2(liq));
    when not_known(section_337_disapplied_337b2(liq));
    then section_337_nonrecognition(liq, subsidiary);
}
// This displaces module 06's own Section336aGainRule/Section336aLossRule
// for the same `liq` via their shared `not_known(section_332_complete_
// liquidation(liq, _, _))` guard — the two outcomes are mutually exclusive
// by construction, matching the pattern used for section 1001(c) in
// property-transactions.

// NOT DONE this stage: section 305(c) (anti-abuse regulations for
// conversion-ratio/redemption-price changes with a similar effect) —
// TECH_GAP, a Secretary regulatory power not modelled; section 305(e)
// (stripped preferred stock OID inclusion) — TECH_GAP, a separate
// computation this stage does not reach; section 332(c)-(d) (RIC/REIT
// liquidating dividend recharacterization; foreign-corporation applicable-
// holding-company override) — TECH_GAP/EXTERNAL_DEPENDENCY, not modelled;
// section 334(b)(2) ("corporate distributee" cross-reference to section
// 332(b)) — satisfied by construction (this module's rules already key
// corporate-distributee basis off `section_332_complete_liquidation`);
