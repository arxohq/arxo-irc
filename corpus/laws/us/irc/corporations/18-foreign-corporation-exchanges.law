// Section 367 — foreign corporations (transfers by United States persons to
// foreign corporations, outbound and other exchanges, section 355 and
// section 332 special rules, intangibles). Stage 3 (26.09.2026, A06).
//
// METHOD. Section 367 is an OVERRIDE of the nonrecognition provisions of
// subchapter C: for an exchange described in sections 332, 351, 354, 355, 356
// or 361 a foreign corporation is "not considered a corporation" for the
// purpose of deciding whether gain is recognized ((a)(1)) — or, when the
// transfer is not one described in (a)(1), is considered a corporation
// except as regulations provide ((b)(1)). The rules are modelled as
// classification conclusions on an `ForeignCorporationExchange`, one per
// transferred asset where the statute distinguishes property ((a)(2)-(5),
// (d)). The recognition of gain itself is NOT recomputed here: it belongs to
// the nonrecognition provisions (sections 351, 354, 361 ...) that consume the
// conclusion.
//
// (a)(1) exceptions are positive predicates guarded by `not_known`: the
// (a)(2) stock-or-securities exception (which (a)(4) takes back for section
// 361 exchanges unless the transferor is controlled by five or fewer domestic
// corporations), the (a)(5) Secretary designation, and section 367(d) (which
// (d)(1)(A) makes displace (a) for intangible property in a section 351 or
// 361 exchange).
//
// EVALUATIVE. "Commensurate with the income attributable to the intangible"
// ((d)(2)(A), last sentence) is a DECISION-0194 judgment channel
// (`external judgment relation`, authority Secretary): never an arithmetic
// guard. The (d)(2)(D) valuation-basis determination is the same channel.
//
// REGULATIONS. Every "except as provided in regulations" / "to the extent
// provided in regulations" clause is an EXTERNAL_DEPENDENCY fact the case
// asserts (the pinned text contains no regulation); an absent fact means the
// regulation is not shown to apply — never that it does not exist.
//
// DEONTICS. Section 367 sets no duty, prohibition, power or liberty: it is a
// set of characterizations ("shall be treated as", "shall not be considered")
// and of income inclusions; the coverage rows classify them `classification`
// / `calculation`. The section 367(d)(2)(A) inclusion is a consequence of the
// transfer, not a duty to include.
//
// SHARED: `foreign_corporation` (module 01) is NOT reused for the transferee:
// here the transferee is asserted per exchange (`transferee_is_foreign_
// corporation_367`), because one case may carry several exchanges.

use self::{
    Asset,
    Corporation,
    IRC_S367_A,
    IRC_S367_B,
    IRC_S367_C,
    IRC_S367_D,
    IRC_S367_E,
    IRC_S367_F,
    Liquidation,
    TaxableYear,
    corp_adjusted_basis_of_liquidated_property,
    effective_fmv_for_336,
    liquidating_corp_gain,
    section_332_applies_to_liquidation,
};

pub entity ForeignCorporationExchange { label en unofficial "an exchange in which a person transfers property to a corporation, tested against section 367"; }

pub enum ExchangeSectionKind367 {
    Exchange332;
    Exchange351;
    Exchange354;
    Exchange355;
    Exchange356;
    Exchange361;
    label en unofficial "the subchapter C provision that describes the exchange (sections 332, 351, 354, 355, 356 and 361 are the ones section 367 names)";
}

pub relation exchange_described_in_section_367(x: ForeignCorporationExchange, kind: ExchangeSectionKind367) kind empirical {
    label en official "the exchange is described in the named section of subchapter C";
}
pub relation transferor_is_united_states_person_367(x: ForeignCorporationExchange) kind institutional {
    label en official "the transferor is a United States person";
}
pub relation transferee_is_foreign_corporation_367(x: ForeignCorporationExchange, foreign: Corporation) kind empirical {
    label en official "the transferee is a foreign corporation";
}
pub relation property_transferred_in_exchange_367(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "the property transferred by the United States person to the foreign corporation in the exchange";
}

// --- Section 367(a)(1): the list of exchanges --------------------------------

pub relation exchange_described_in_367a1_list(x: ForeignCorporationExchange) kind institutional {
    label en official "the exchange is described in section 332, 351, 354, 356, or 361 (section 367(a)(1))";
}
@source(IRC_S367_A, quote = "If, in connection with any exchange described in section 332, 351, 354, 356, or 361, a United States person transfers property to a foreign corporation")
rule Exchange367a1ListSection332Rule(x: ForeignCorporationExchange) strict {
    label en official "section 367(a)(1): a section 332 exchange";
    when exchange_described_in_section_367(x, Exchange332);
    then exchange_described_in_367a1_list(x);
}
@source(IRC_S367_A, quote = "If, in connection with any exchange described in section 332, 351, 354, 356, or 361, a United States person transfers property to a foreign corporation")
rule Exchange367a1ListSection351Rule(x: ForeignCorporationExchange) strict {
    label en official "section 367(a)(1): a section 351 exchange";
    when exchange_described_in_section_367(x, Exchange351);
    then exchange_described_in_367a1_list(x);
}
@source(IRC_S367_A, quote = "If, in connection with any exchange described in section 332, 351, 354, 356, or 361, a United States person transfers property to a foreign corporation")
rule Exchange367a1ListSection354Rule(x: ForeignCorporationExchange) strict {
    label en official "section 367(a)(1): a section 354 exchange";
    when exchange_described_in_section_367(x, Exchange354);
    then exchange_described_in_367a1_list(x);
}
@source(IRC_S367_A, quote = "If, in connection with any exchange described in section 332, 351, 354, 356, or 361, a United States person transfers property to a foreign corporation")
rule Exchange367a1ListSection356Rule(x: ForeignCorporationExchange) strict {
    label en official "section 367(a)(1): a section 356 exchange";
    when exchange_described_in_section_367(x, Exchange356);
    then exchange_described_in_367a1_list(x);
}
@source(IRC_S367_A, quote = "If, in connection with any exchange described in section 332, 351, 354, 356, or 361, a United States person transfers property to a foreign corporation")
rule Exchange367a1ListSection361Rule(x: ForeignCorporationExchange) strict {
    label en official "section 367(a)(1): a section 361 exchange";
    when exchange_described_in_section_367(x, Exchange361);
    then exchange_described_in_367a1_list(x);
}

pub relation transfer_of_property_described_in_367a1(x: ForeignCorporationExchange) kind institutional {
    label en official "a United States person transfers property to a foreign corporation in connection with an exchange described in section 367(a)(1) (helper: also the negative condition of section 367(b)(1))";
}
rule TransferDescribedIn367a1Rule(x: ForeignCorporationExchange, foreign: Corporation, a: Asset) defeasible {
    label en unofficial "helper: the exchange is on the (a)(1) list, the transferor is a United States person, the transferee is foreign and some property is transferred";
    when exchange_described_in_367a1_list(x);
    when transferor_is_united_states_person_367(x);
    when transferee_is_foreign_corporation_367(x, foreign);
    when property_transferred_in_exchange_367(x, a);
    then transfer_of_property_described_in_367a1(x);
}

// --- Section 367(a)(2)-(5): exceptions ----------------------------------------

pub relation property_is_stock_or_securities_of_foreign_party_367a2(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "the property is stock or securities of a foreign corporation which is a party to the exchange or a party to the reorganization";
}
pub relation transferor_corporation_controlled_by_five_or_fewer_domestic_corporations_367a4(x: ForeignCorporationExchange) kind empirical {
    label en official "the transferor corporation is controlled (within the meaning of section 368(c)) by 5 or fewer domestic corporations, all members of the same affiliated group counting as 1 corporation";
}
pub relation section_367a2_exception_applies(x: ForeignCorporationExchange, a: Asset) kind institutional {
    label en official "section 367(a)(1) does not apply to the transfer of stock or securities of a foreign party (section 367(a)(2)), as restored by section 367(a)(4) for a section 361 exchange with a transferor controlled by 5 or fewer domestic corporations";
}
@source(IRC_S367_A, quote = "Except to the extent provided in regulations, paragraph (1) shall not apply to the transfer of stock or securities of a foreign corporation which is a party to the exchange or a party to the reorganization.")
rule Section367a2ExceptionOutsideSection361Rule(x: ForeignCorporationExchange, a: Asset) defeasible {
    label en official "section 367(a)(2): the stock-or-securities exception, in an exchange that is not a section 361 exchange";
    when property_is_stock_or_securities_of_foreign_party_367a2(x, a);
    when not_known(exchange_described_in_section_367(x, Exchange361));
    when not_known(regulations_provide_367a2_stock_exception_does_not_apply(x, a));
    then section_367a2_exception_applies(x, a);
}
@source(IRC_S367_A, quote = "Paragraph (2) shall not apply in the case of an exchange described in subsection (a) or (b) of section 361. Subject to such basis adjustments and such other conditions as shall be provided in regulations, the preceding sentence shall not apply if the transferor corporation is controlled (within the meaning of section 368(c)) by 5 or fewer domestic corporations.")
rule Section367a4ExceptionRestoredForControlledTransferorRule(x: ForeignCorporationExchange, a: Asset) defeasible {
    label en official "section 367(a)(4): in a section 361 exchange paragraph (2) does not apply, unless the transferor is controlled by 5 or fewer domestic corporations (then the exception applies again)";
    when property_is_stock_or_securities_of_foreign_party_367a2(x, a);
    when exchange_described_in_section_367(x, Exchange361);
    when transferor_corporation_controlled_by_five_or_fewer_domestic_corporations_367a4(x);
    when not_known(regulations_provide_367a2_stock_exception_does_not_apply(x, a));
    then section_367a2_exception_applies(x, a);
}
pub relation regulations_provide_367a2_stock_exception_does_not_apply(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations provide that the section 367(a)(2) exception does not apply to this transfer (\"except to the extent provided in regulations\"); the pinned text holds no regulation";
}
pub relation property_designated_by_regulation_367a5(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: the Secretary designates the property by regulation to carry out the purposes of section 367(a) (section 367(a)(5)); section 367(a)(1) does not apply to it";
}

pub relation property_is_partnership_interest_367a3(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "the property transferred is an interest in a partnership";
}
pub relation regulations_provide_otherwise_for_partnership_interest_367a3(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations prescribed by the Secretary provide otherwise for the transfer of the partnership interest";
}
pub relation transfer_treated_as_pro_rata_share_of_partnership_assets_367a3(x: ForeignCorporationExchange, a: Asset) kind institutional {
    label en official "for purposes of section 367(a), the transfer of the partnership interest is treated as a transfer of the person's pro rata share of the assets of the partnership";
}
@source(IRC_S367_A, quote = "a transfer by a United States person of an interest in a partnership to a foreign corporation in an exchange described in paragraph (1) shall, for purposes of this subsection, be treated as a transfer to such corporation of such person's pro rata share of the assets of the partnership.")
rule Section367a3PartnershipInterestLookThroughRule(x: ForeignCorporationExchange, a: Asset) defeasible {
    label en official "section 367(a)(3): a partnership interest transferred in an (a)(1) exchange is treated as a transfer of the pro rata share of partnership assets, unless regulations provide otherwise";
    when exchange_described_in_367a1_list(x);
    when transferor_is_united_states_person_367(x);
    when property_transferred_in_exchange_367(x, a);
    when property_is_partnership_interest_367a3(x, a);
    when not_known(regulations_provide_otherwise_for_partnership_interest_367a3(x, a));
    then transfer_treated_as_pro_rata_share_of_partnership_assets_367a3(x, a);
}

// --- Section 367(d)(1), (4): intangible property -------------------------------

pub enum IntangiblePropertyKind367 {
    PatentInventionFormulaProcessDesignPatternKnowHow;
    CopyrightLiteraryMusicalArtisticComposition;
    TrademarkTradeNameBrandName;
    FranchiseLicenseContract;
    MethodProgramSystemProcedureCampaignSurveyStudyForecastEstimateCustomerListTechnicalData;
    GoodwillGoingConcernValueWorkforceInPlace;
    OtherItemValueNotAttributableToTangiblePropertyOrServices;
    label en unofficial "the seven categories of intangible property listed in section 367(d)(4)(A)-(G)";
}
pub relation transferred_intangible_kind_367d4(x: ForeignCorporationExchange, a: Asset, kind: IntangiblePropertyKind367) kind empirical {
    label en official "the transferred property falls in the named category of section 367(d)(4) intangible property (the residual category (G) is a classification the case asserts)";
}
pub relation transferred_property_is_intangible_367d4(x: ForeignCorporationExchange, a: Asset) kind institutional {
    label en official "the transferred property is intangible property within section 367(d)(4)(A)-(G)";
}
@source(IRC_S367_D, quote = "For purposes of this subsection, the term \"intangible property\" means any—")
rule TransferredPropertyIsIntangibleRule(x: ForeignCorporationExchange, a: Asset, kind: IntangiblePropertyKind367) strict {
    label en official "section 367(d)(4): property in any of the seven listed categories is intangible property";
    when transferred_intangible_kind_367d4(x, a, kind);
    then transferred_property_is_intangible_367d4(x, a);
}
pub relation regulations_except_transfer_from_367d1_367d(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations prescribed by the Secretary except the transfer from section 367(d)(1) (\"except as provided in regulations\")";
}
pub relation section_367d_applies_to_transfer(x: ForeignCorporationExchange, a: Asset) kind institutional {
    label en official "section 367(d) applies to the transfer of the intangible property, and section 367(a) does not (section 367(d)(1)(A)-(B))";
}
@source(IRC_S367_D, quote = "if a United States person transfers any intangible property to a foreign corporation in an exchange described in section 351 or 361—")
rule Section367d1AppliesSection351Rule(x: ForeignCorporationExchange, foreign: Corporation, a: Asset) defeasible {
    label en official "section 367(d)(1): a United States person's transfer of intangible property to a foreign corporation in a section 351 exchange";
    when transferor_is_united_states_person_367(x);
    when transferee_is_foreign_corporation_367(x, foreign);
    when property_transferred_in_exchange_367(x, a);
    when transferred_property_is_intangible_367d4(x, a);
    when exchange_described_in_section_367(x, Exchange351);
    when not_known(regulations_except_transfer_from_367d1_367d(x, a));
    then section_367d_applies_to_transfer(x, a);
}
@source(IRC_S367_D, quote = "if a United States person transfers any intangible property to a foreign corporation in an exchange described in section 351 or 361—")
rule Section367d1AppliesSection361Rule(x: ForeignCorporationExchange, foreign: Corporation, a: Asset) defeasible {
    label en official "section 367(d)(1): a United States person's transfer of intangible property to a foreign corporation in a section 361 exchange";
    when transferor_is_united_states_person_367(x);
    when transferee_is_foreign_corporation_367(x, foreign);
    when property_transferred_in_exchange_367(x, a);
    when transferred_property_is_intangible_367d4(x, a);
    when exchange_described_in_section_367(x, Exchange361);
    when not_known(regulations_except_transfer_from_367d1_367d(x, a));
    then section_367d_applies_to_transfer(x, a);
}

// --- Section 367(a)(1): the main conclusion ------------------------------------

pub relation foreign_corporation_not_considered_corporation_for_gain_367a1(x: ForeignCorporationExchange, a: Asset, foreign: Corporation) kind institutional {
    label en official "for purposes of determining the extent to which gain is recognized on the transfer of the property, the foreign corporation is not considered to be a corporation (section 367(a)(1))";
}
@source(IRC_S367_A, quote = "such foreign corporation shall not, for purposes of determining the extent to which gain shall be recognized on such transfer, be considered to be a corporation.")
rule Section367a1ForeignCorporationNotACorporationRule(x: ForeignCorporationExchange, a: Asset, foreign: Corporation) defeasible {
    label en official "section 367(a)(1): on the transfer of property by a United States person to a foreign corporation in a listed exchange, the transferee is not a corporation for gain recognition, unless the (a)(2) exception, a regulation, the (a)(5) designation or section 367(d) takes the property out";
    when exchange_described_in_367a1_list(x);
    when transferor_is_united_states_person_367(x);
    when transferee_is_foreign_corporation_367(x, foreign);
    when property_transferred_in_exchange_367(x, a);
    when not_known(section_367a2_exception_applies(x, a));
    when not_known(property_designated_by_regulation_367a5(x, a));
    when not_known(section_367d_applies_to_transfer(x, a));
    then foreign_corporation_not_considered_corporation_for_gain_367a1(x, a, foreign);
}
// JUDGMENT CALL: the (a)(2) lead-in "except to the extent provided in
// regulations" is carried by the two exception rules above, each guarded by
// `not_known(regulations_provide_367a2_stock_exception_does_not_apply)`: when
// the regulation is shown to apply the exception rule is silent and (a)(1)
// concludes through its own `not_known(section_367a2_exception_applies)`.

// --- Section 367(b)(1): other transfers -----------------------------------------

pub relation exchange_described_in_367b_list(x: ForeignCorporationExchange) kind institutional {
    label en official "the exchange is described in section 332, 351, 354, 355, 356, or 361 (section 367(b)(1))";
}
@source(IRC_S367_B, quote = "In the case of any exchange described in section 332, 351, 354, 355, 356, or 361")
rule Exchange367bListFromA1ListRule(x: ForeignCorporationExchange) defeasible {
    label en official "section 367(b)(1): every exchange on the (a)(1) list is also on the (b)(1) list";
    when exchange_described_in_367a1_list(x);
    then exchange_described_in_367b_list(x);
}
@source(IRC_S367_B, quote = "In the case of any exchange described in section 332, 351, 354, 355, 356, or 361")
rule Exchange367bListSection355Rule(x: ForeignCorporationExchange) strict {
    label en official "section 367(b)(1): a section 355 exchange (which the (a)(1) list omits)";
    when exchange_described_in_section_367(x, Exchange355);
    then exchange_described_in_367b_list(x);
}
pub relation regulations_prevent_avoidance_367b1_exception(x: ForeignCorporationExchange, foreign: Corporation) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations prescribed by the Secretary, necessary or appropriate to prevent the avoidance of Federal income taxes, provide that the foreign corporation is not considered a corporation for the exchange";
}
pub relation foreign_corporation_considered_corporation_367b1(x: ForeignCorporationExchange, foreign: Corporation) kind institutional {
    label en official "in an exchange with no transfer of property described in section 367(a)(1), the foreign corporation is considered to be a corporation (section 367(b)(1)), except as regulations provide";
}
@source(IRC_S367_B, quote = "a foreign corporation shall be considered to be a corporation except to the extent provided in regulations prescribed by the Secretary which are necessary or appropriate to prevent the avoidance of Federal income taxes.")
rule Section367b1ForeignCorporationIsCorporationRule(x: ForeignCorporationExchange, foreign: Corporation) defeasible {
    label en official "section 367(b)(1): where no property described in (a)(1) is transferred, the foreign corporation is a corporation, unless regulations prescribed to prevent avoidance provide otherwise";
    when exchange_described_in_367b_list(x);
    when transferee_is_foreign_corporation_367(x, foreign);
    when not_known(transfer_of_property_described_in_367a1(x));
    when not_known(regulations_prevent_avoidance_367b1_exception(x, foreign));
    then foreign_corporation_considered_corporation_367b1(x, foreign);
}

// --- Section 367(c): transactions treated as exchanges ---------------------------

pub relation section_356_distribution_relating_to_section_355_367c1(x: ForeignCorporationExchange) kind empirical {
    label en official "the distribution is described in so much of section 356 as relates to section 355";
}
pub relation treated_as_exchange_367c1(x: ForeignCorporationExchange) kind institutional {
    label en official "for purposes of section 367, the section 355 distribution (or so much of section 356 as relates to it) is treated as an exchange whether or not it is an exchange (section 367(c)(1))";
}
@source(IRC_S367_C, quote = "any distribution described in section 355 (or so much of section 356 as relates to section 355) shall be treated as an exchange whether or not it is an exchange.")
rule Section367c1Section355DistributionIsExchangeRule(x: ForeignCorporationExchange) strict {
    label en official "section 367(c)(1): a section 355 distribution is treated as an exchange";
    when exchange_described_in_section_367(x, Exchange355);
    then treated_as_exchange_367c1(x);
}
@source(IRC_S367_C, quote = "any distribution described in section 355 (or so much of section 356 as relates to section 355) shall be treated as an exchange whether or not it is an exchange.")
rule Section367c1Section356Relating355IsExchangeRule(x: ForeignCorporationExchange) strict {
    label en official "section 367(c)(1): so much of section 356 as relates to section 355 is treated as an exchange";
    when section_356_distribution_relating_to_section_355_367c1(x);
    then treated_as_exchange_367c1(x);
}

pub relation contribution_to_capital_of_foreign_corporation_367c2(x: ForeignCorporationExchange, a: Asset, fmv: Money) kind empirical {
    label en official "a transfer of the property to a foreign corporation as a contribution to its capital, with the fair market value of the property transferred";
}
pub relation contributors_voting_share_after_transfer_318_367c2(x: ForeignCorporationExchange, share: Decimal) kind empirical {
    label en official "the share of the total combined voting power of all classes of voting stock that the contributing persons own (within the meaning of section 318) immediately after the transfer; module 03's attribution is not summed into it (TECH-GAPS G251 class)";
}
pub relation treated_as_exchange_for_stock_of_equal_value_367c2(x: ForeignCorporationExchange, a: Asset, value: Money) kind institutional {
    label en official "the contribution to capital is treated as an exchange of the property for stock of the foreign corporation equal in value to the fair market value of the property transferred (section 367(c)(2))";
}
@source(IRC_S367_C, quote = "own (within the meaning of section 318) stock possessing at least 80 percent of the total combined voting power of all classes of stock of such corporation entitled to vote shall be treated as an exchange of such property for stock of the foreign corporation equal in value to the fair market value of the property transferred.")
rule Section367c2ContributionTreatedAsExchangeRule(x: ForeignCorporationExchange, a: Asset, fmv: Money, share: Decimal) strict {
    label en official "section 367(c)(2): a contribution to the capital of a foreign corporation by persons owning at least 80 percent of its voting power is treated as an exchange for stock of equal value";
    when contribution_to_capital_of_foreign_corporation_367c2(x, a, fmv);
    when contributors_voting_share_after_transfer_318_367c2(x, share);
    when share >= 0.80;
    then treated_as_exchange_for_stock_of_equal_value_367c2(x, a, fmv);
}

// --- Section 367(d)(2): contingent-payment treatment of the intangible ------------

pub relation commensurate_annual_amount_367d2a(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount which reasonably reflects the payments that would have been received annually over the useful life of the intangible (or at the time of a later disposition), for the taxable year";
}
@source(IRC_S367_D, quote = "The amounts taken into account under clause (ii) shall be commensurate with the income attributable to the intangible.")
pub external judgment relation AmountsCommensurateWithIncomeAttributableToIntangible367d2a(x: ForeignCorporationExchange, a: Asset, y: TaxableYear) {
    authority Secretary;
    label en official "the amounts taken into account are commensurate with the income attributable to the intangible (section 367(d)(2)(A), last sentence) — DECISION-0194 evaluative channel: an external judgment of the Secretary or a court, never an arithmetic guard";
}
pub relation inclusion_in_gross_income_367d2a(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount the transferor is treated as receiving, on a sale for payments contingent on the productivity, use or disposition of the intangible, for the taxable year (section 367(d)(2)(A))";
}
@source(IRC_S367_D, quote = "the United States person transferring such property shall be treated as—")
rule Section367d2aContingentPaymentInclusionRule(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 367(d)(2)(A): the transferor is treated as having sold the intangible for contingent payments and as receiving the commensurate amounts";
    when section_367d_applies_to_transfer(x, a);
    when commensurate_annual_amount_367d2a(x, a, y, amount);
    when AmountsCommensurateWithIncomeAttributableToIntangible367d2a(x, a, y);
    then inclusion_in_gross_income_367d2a(x, a, y, amount);
}
pub relation foreign_corporation_earnings_and_profits_reduction_367d2b(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings and profits of the foreign corporation are reduced by the amount the transferor must include under section 367(d)(2)(A)(ii) (section 367(d)(2)(B))";
}
@source(IRC_S367_D, quote = "the earnings and profits of a foreign corporation to which the intangible property was transferred shall be reduced by the amount required to be included in the income of the transferor of the intangible property under subparagraph (A)(ii).")
rule Section367d2bEarningsAndProfitsReductionRule(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 367(d)(2)(B): the foreign corporation's earnings and profits are reduced by the transferor's inclusion";
    when inclusion_in_gross_income_367d2a(x, a, y, amount);
    then foreign_corporation_earnings_and_profits_reduction_367d2b(x, a, y, amount);
}
pub relation inclusion_is_ordinary_income_367d2c(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount included in gross income by reason of section 367(d) is ordinary income (section 367(d)(2)(C), first sentence)";
}
@source(IRC_S367_D, quote = "any amount included in gross income by reason of this subsection shall be treated as ordinary income.")
rule Section367d2cOrdinaryIncomeRule(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 367(d)(2)(C): the inclusion is ordinary income";
    when inclusion_in_gross_income_367d2a(x, a, y, amount);
    then inclusion_is_ordinary_income_367d2c(x, a, y, amount);
}
pub relation inclusion_treated_as_royalty_for_section_904d_367d2c(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "for purposes of applying section 904(d), the amount is treated in the same manner as if it were a royalty (section 367(d)(2)(C), second sentence)";
}
@source(IRC_S367_D, quote = "For purposes of applying section 904(d), any such amount shall be treated in the same manner as if such amount were a royalty.")
rule Section367d2cRoyaltyForSection904dRule(x: ForeignCorporationExchange, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 367(d)(2)(C): the inclusion is a royalty for section 904(d)";
    when inclusion_in_gross_income_367d2a(x, a, y, amount);
    then inclusion_treated_as_royalty_for_section_904d_367d2c(x, a, y, amount);
}
@source(IRC_S367_D, quote = "if the Secretary determines that such basis is the most reliable means of valuation of such transfers.")
pub external judgment relation SecretaryDeterminesAggregateOrRealisticAlternativesBasisMostReliable367d2d(x: ForeignCorporationExchange, a: Asset) {
    authority Secretary;
    label en official "the Secretary determines that valuation of the transfer on an aggregate basis, or on the basis of the realistic alternatives to the transfer, is the most reliable means of valuation (section 367(d)(2)(D)) — DECISION-0194 evaluative channel";
}
pub relation valuation_on_aggregate_or_realistic_alternatives_basis_required_367d2d(x: ForeignCorporationExchange, a: Asset) kind institutional {
    label en official "the Secretary requires the valuation of the transfer on an aggregate basis or on the basis of the realistic alternatives to the transfer (section 367(d)(2)(D))";
}
@source(IRC_S367_D, quote = "the Secretary shall require—")
rule Section367d2dValuationBasisRequiredRule(x: ForeignCorporationExchange, a: Asset) defeasible {
    label en official "section 367(d)(2)(D): where the Secretary determines the basis most reliable, that valuation basis is required for the (d)(2)(A) amounts";
    when section_367d_applies_to_transfer(x, a);
    when SecretaryDeterminesAggregateOrRealisticAlternativesBasisMostReliable367d2d(x, a);
    then valuation_on_aggregate_or_realistic_alternatives_basis_required_367d2d(x, a);
}

// --- Section 367(e): distributions and liquidations --------------------------------

pub relation distribution_355_by_domestic_corporation_to_non_united_states_person_367e1(x: ForeignCorporationExchange) kind empirical {
    label en official "a distribution described in section 355 (or so much of section 356 as relates to it) by a domestic corporation to a person who is not a United States person";
}
pub relation regulations_provide_gain_recognition_367e1(x: ForeignCorporationExchange) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations provide that gain is recognized on the distribution under principles similar to those of section 367";
}
pub relation gain_recognized_under_principles_similar_to_367_367e1(x: ForeignCorporationExchange) kind institutional {
    label en official "to the extent provided in regulations, gain is recognized on the distribution under principles similar to the principles of section 367 (section 367(e)(1))";
}
@source(IRC_S367_E, quote = "to the extent provided in regulations, gain shall be recognized under principles similar to the principles of this section.")
rule Section367e1GainRecognizedRule(x: ForeignCorporationExchange) defeasible {
    label en official "section 367(e)(1): gain on a section 355 distribution to a non-United States person, to the extent regulations provide";
    when distribution_355_by_domestic_corporation_to_non_united_states_person_367e1(x);
    when regulations_provide_gain_recognition_367e1(x);
    then gain_recognized_under_principles_similar_to_367_367e1(x);
}

pub relation eighty_percent_distributee_is_foreign_corporation_367e2(liq: Liquidation) kind empirical {
    label en official "the 80-percent distributee (section 337(c)) of the section 332 liquidation is a foreign corporation";
}
pub relation regulations_provide_otherwise_for_337_367e2(liq: Liquidation) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations provide that sections 337(a) and (b)(1) apply despite the foreign 80-percent distributee";
}
pub relation section_337a_and_b1_disapplied_367e2(liq: Liquidation) kind institutional {
    label en official "in a section 332 liquidation whose 80-percent distributee is a foreign corporation, section 337(a) and (b)(1) do not apply, except as regulations provide (section 367(e)(2))";
}
@source(IRC_S367_E, quote = "In the case of any liquidation to which section 332 applies, except as provided in regulations, subsections (a) and (b)(1) of section 337 shall not apply where the 80-percent distributee (as defined in section 337(c)) is a foreign corporation.")
rule Section367e2Section337DisapplicationRule(liq: Liquidation) defeasible {
    label en official "section 367(e)(2): section 337(a) and (b)(1) do not apply to a section 332 liquidation into a foreign corporation";
    when section_332_applies_to_liquidation(liq);
    when eighty_percent_distributee_is_foreign_corporation_367e2(liq);
    when not_known(regulations_provide_otherwise_for_337_367e2(liq));
    then section_337a_and_b1_disapplied_367e2(liq);
}
// With section 337(a) disapplied, the liquidating corporation recognizes gain
// on the distribution under section 336(a) as if the property were sold at its
// fair market value; module 06's section 336(a) rules are guarded off a
// section 332 liquidation, so the recognition is restated here for exactly
// this case. The loss side stays blocked: section 336(d)(3) (no loss in a
// section 332 liquidation) is not touched by section 367(e)(2).
@source(IRC_S367_E, quote = "subsections (a) and (b)(1) of section 337 shall not apply where the 80-percent distributee (as defined in section 337(c)) is a foreign corporation.")
rule Section367e2LiquidatingCorporationGainRecognizedRule(liq: Liquidation, fmv: Money, basis: Money) defeasible {
    label en official "section 367(e)(2) with section 336(a): gain to the liquidating corporation when section 337(a) is disapplied and effective fair market value exceeds adjusted basis";
    when section_337a_and_b1_disapplied_367e2(liq);
    when effective_fmv_for_336(liq, fmv);
    when corp_adjusted_basis_of_liquidated_property(liq, basis);
    when fmv > basis;
    then liquidating_corp_gain(liq, fmv - basis);
}

// --- Section 367(f) --------------------------------------------------------------------

pub relation transfer_as_paid_in_surplus_or_capital_contribution_not_otherwise_described_367f(x: ForeignCorporationExchange, a: Asset, fmv: Money, adjusted_basis: Money) kind empirical {
    label en official "a United States person's transfer of the property to a foreign corporation as paid-in surplus or as a contribution to capital, in a transaction not otherwise described in section 367, with its fair market value and adjusted basis (for determining gain) in the transferor's hands";
}
pub relation regulations_provide_367f_treatment(x: ForeignCorporationExchange, a: Asset) kind empirical {
    label en official "EXTERNAL_DEPENDENCY: regulations provide, to the extent stated, that the transfer is treated as a sale or exchange";
}
pub relation gain_recognized_on_other_transfer_367f(x: ForeignCorporationExchange, a: Asset, amount: Money) kind institutional {
    label en official "to the extent provided in regulations, the transfer is treated as a sale or exchange for fair market value and the transferor recognizes the excess of fair market value over adjusted basis as gain (section 367(f))";
}
@source(IRC_S367_F, quote = "such transfer shall be treated as a sale or exchange for an amount equal to the fair market value of the property transferred, and the transferor shall recognize as gain the excess of—")
rule Section367fGainRule(x: ForeignCorporationExchange, a: Asset, fmv: Money, basis: Money) defeasible {
    label en official "section 367(f): to the extent regulations provide, gain equal to fair market value less adjusted basis on a transfer as paid-in surplus or capital contribution";
    when transferor_is_united_states_person_367(x);
    when transfer_as_paid_in_surplus_or_capital_contribution_not_otherwise_described_367f(x, a, fmv, basis);
    when regulations_provide_367f_treatment(x, a);
    when fmv > basis;
    then gain_recognized_on_other_transfer_367f(x, a, fmv - basis);
}
// NOT DONE (coverage rows, TECH-GAPS G3304-G3305): section 367(b)(2)
// (the content of the regulations on sales of stock of foreign corporations,
// EXTERNAL_DEPENDENCY: the Secretary's future regulations, no statutory
// formula), (d)(3) (regulatory extension to partnerships), (a)(4)'s "basis
// adjustments and other conditions" (regulations). The five-or-fewer control
// and the 80-percent voting share are case-asserted aggregates (module 03's
// attribution is not summed into them, TECH-GAPS G251).
