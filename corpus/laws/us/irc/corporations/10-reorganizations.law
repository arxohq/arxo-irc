// Section 368(a)-(b) — reorganization types and "party to a reorganization".
// Stage 2 (IRC-08 stage 2, A06), priority section. Section 368(c) ("control"
// defined) was already formalized in stage 1 (`05-control-and-transfers.law`)
// and is reused here unchanged.
//
// METHOD: section 368(a)(1) is a CLOSED classification of seven reorganization
// types (A-G), each with its own statutory conditions; a transaction is
// classified into a `ReorganizationTypeKind` by satisfying one type's
// conditions, and `reorganization(r, kind)` is the classification relation
// every downstream Part III section (354/355/356/357/358/361/362, already
// wired to `reorganization_property_is_transferee_stock_or_securities`-style
// facts in module 07) is meant to read. Section 368(a)(2)'s special rules
// (A)-(H) are OVERRIDES/exceptions to the (a)(1) classification, modelled as
// additional classification rules reaching the SAME `reorganization` relation
// rather than a separate layer — matching the statute's own "shall be
// treated as" language. Section 368(a)(1)(F) investment-company special
// rules (the (F) clause of paragraph (2), a distinct and much deeper
// provision from the (a)(1)(F) "mere change" type — same letter, different
// paragraph) and the title 11 paragraph (3) sub-definitions are TECH_GAP /
// NON_NORMATIVE-classified only (see file footer): the statute's own scope
// here is already large, and the coordinator's task lists (a)(2)(A)-(H) at
// the level of "special rules", not each clause's own multi-part test.
//
// Section 368(b)'s continuity of interest / continuity of business
// enterprise / business purpose tests are NOT in the pinned statutory text
// at all — they are REGULATORY (26 CFR 1.368-1(b), (d), (e)) — so they are
// channeled as DECISION-0194 `external judgment relation`s with the
// Secretary as the nominal authority, exactly as the task brief directs
// ("EVALUATIVE, regulatory tests EXTERNAL_DEPENDENCY").

use self::{
    Corporation,
    IRC_S368_A,
    IRC_S368_B,
};

pub entity ReorganizationTransaction { label en unofficial "a transaction asserted to be tested for reorganization status under section 368(a)"; }

enum ReorganizationTypeKind {
    TypeAStatutoryMergerOrConsolidation;
    TypeBStockForVotingStock;
    TypeCSubstantiallyAllForVotingStock;
    TypeDAssetTransferWithControlAndDistribution;
    TypeERecapitalization;
    TypeFMereChange;
    TypeGInsolvencyReorganization;
}

pub relation reorganization(r: ReorganizationTransaction, kind: ReorganizationTypeKind) kind institutional {
    label en official "the transaction is a \"reorganization\" within the meaning of section 368(a)(1), of the given type";
}

// --- (a)(1)(A): statutory merger or consolidation --------------------------

@source(IRC_S368_A, quote = "a statutory merger or consolidation;")
pub relation statutory_merger_or_consolidation(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) kind empirical {
    label en official "the transaction is a merger or consolidation effected under applicable corporate statute — section 368(a)(1)(A) (a factual/procedural predicate this package reads as a case fact, not itself a Title 26 computation)";
}
@source(IRC_S368_A, quote = "a statutory merger or consolidation;")
rule ReorganizationTypeARule(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) strict {
    label en official "section 368(a)(1)(A): a statutory merger or consolidation is a reorganization";
    when statutory_merger_or_consolidation(r, acquiring, target);
    then reorganization(r, TypeAStatutoryMergerOrConsolidation);
}

// --- (a)(1)(B): stock-for-voting-stock acquisition with control -----------

@source(IRC_S368_A, quote = "the acquisition by one corporation, in exchange solely for all or a part of its voting stock (or in exchange solely for all or a part of the voting stock of a corporation which is in control of the acquiring corporation), of stock of another corporation")
pub relation acquisition_solely_for_voting_stock(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) kind empirical {
    label en official "the acquiring corporation (or a corporation in control of it) exchanges solely its own voting stock (or that controlling corporation's voting stock) for stock of the target corporation — section 368(a)(1)(B)'s \"solely for voting stock\" test";
}
@source(IRC_S368_A, quote = "immediately after the acquisition, the acquiring corporation has control of such other corporation (whether or not such acquiring corporation had control immediately before the acquisition)")
pub relation control_immediately_after_368b(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) kind empirical {
    label en unofficial "immediately after the acquisition, the acquiring corporation has section 368(c) control of the target corporation";
}
@source(IRC_S368_A, quote = "the acquisition by one corporation, in exchange solely for all or a part of its voting stock (or in exchange solely for all or a part of the voting stock of a corporation which is in control of the acquiring corporation), of stock of another corporation if, immediately after the acquisition, the acquiring corporation has control of such other corporation")
rule ReorganizationTypeBRule(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) strict {
    label en official "section 368(a)(1)(B): a solely-voting-stock acquisition of another corporation's stock, with control immediately after, is a reorganization";
    when acquisition_solely_for_voting_stock(r, acquiring, target);
    when control_immediately_after_368b(r, acquiring, target);
    then reorganization(r, TypeBStockForVotingStock);
}

// --- (a)(1)(C): substantially-all-properties acquisition for voting stock,
// --- with the (a)(2)(B) 20%-boot allowance ---------------------------------

@source(IRC_S368_A, quote = "the acquisition by one corporation, in exchange solely for all or a part of its voting stock (or in exchange solely for all or a part of the voting stock of a corporation which is in control of the acquiring corporation), of substantially all of the properties of another corporation, but in determining whether the exchange is solely for stock the assumption by the acquiring corporation of a liability of the other shall be disregarded;")
pub relation acquisition_of_substantially_all_properties(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) kind empirical {
    label en official "the acquiring corporation acquires substantially all of the target corporation's properties, solely for voting stock (liabilities assumed disregarded) — section 368(a)(1)(C), read here as the case's own \"substantially all\" determination (no statutory percentage; a fact this package does not itself test)";
}
@source(IRC_S368_A, quote = "the acquisition by one corporation, in exchange solely for all or a part of its voting stock (or in exchange solely for all or a part of the voting stock of a corporation which is in control of the acquiring corporation), of substantially all of the properties of another corporation")
rule ReorganizationTypeCRule(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) strict {
    label en official "section 368(a)(1)(C): a solely-voting-stock acquisition of substantially all of the target's properties is a reorganization";
    when acquisition_of_substantially_all_properties(r, acquiring, target);
    when not_known(reorganization_c_and_d_both_described(r));
    then reorganization(r, TypeCSubstantiallyAllForVotingStock);
}

// Section 368(a)(2)(B): the 20% boot allowance — an acquisition that would
// qualify under (1)(C) but for non-stock consideration STILL qualifies if
// at least 80% of the fair market value of the target's property is
// acquired solely for the (1)(C) voting stock (liabilities assumed treated
// as money paid, for this 80% test only).
@source(IRC_S368_A, quote = "the acquiring corporation exchanges money or other property in addition to voting stock, and")
pub relation acquisition_with_boot(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) kind empirical {
    label en official "section 368(a)(2)(B)(ii): the acquiring corporation exchanges money or other property (\"boot\") in addition to voting stock, which would otherwise disqualify the transaction under section 368(a)(1)(C)";
}
@source(IRC_S368_A, quote = "the acquiring corporation acquires, solely for voting stock described in paragraph (1)(C), property of the other corporation having a fair market value which is at least 80 percent of the fair market value of all of the property of the other corporation")
pub relation stock_only_acquisition_fmv_share(r: ReorganizationTransaction, fmv_share: Decimal) kind empirical {
    label en official "section 368(a)(2)(B)(iii): the fraction (fair market value acquired solely for voting stock) / (fair market value of all of the target's property), with any liability assumed by the acquiring corporation treated as money paid, for the 80 percent boot-allowance test";
}
@source(IRC_S368_A, quote = "then such acquisition shall (subject to subparagraph (A) of this paragraph) be treated as qualifying under paragraph (1)(C).")
rule ReorganizationTypeCBootAllowanceRule(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation, fmv_share: Decimal) strict {
    label en official "section 368(a)(2)(B): an acquisition with up to 20 percent boot still qualifies under section 368(a)(1)(C) if at least 80 percent of the target's property (by fair market value) is acquired solely for voting stock";
    when acquisition_of_substantially_all_properties(r, acquiring, target);
    when acquisition_with_boot(r, acquiring, target);
    when stock_only_acquisition_fmv_share(r, fmv_share);
    when fmv_share >= 0.80;
    when not_known(reorganization_c_and_d_both_described(r));
    then reorganization(r, TypeCSubstantiallyAllForVotingStock);
}

// --- (a)(1)(D): asset transfer with control + section 354/355/356 --------
// --- distribution, and the (a)(2)(A) "C-and-D both described -> D only" --
// --- override -------------------------------------------------------------

@source(IRC_S368_A, quote = "a transfer by a corporation of all or a part of its assets to another corporation if immediately after the transfer the transferor, or one or more of its shareholders (including persons who were shareholders immediately before the transfer), or any combination thereof, is in control of the corporation to which the assets are transferred")
pub relation asset_transfer_with_control_368d(r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) kind empirical {
    label en official "section 368(a)(1)(D): a corporation transfers all or part of its assets to another corporation, and immediately after the transfer the transferor, one or more of its shareholders, or a combination, has section 368(c) control of the transferee";
}
@source(IRC_S368_A, quote = "but only if, in pursuance of the plan, stock or securities of the corporation to which the assets are transferred are distributed in a transaction which qualifies under section 354, 355, or 356;")
pub relation stock_or_securities_distributed_under_354_355_356(r: ReorganizationTransaction) kind empirical {
    label en official "section 368(a)(1)(D): stock or securities of the transferee corporation are, in pursuance of the plan, distributed in a transaction qualifying under section 354, 355, or 356";
}
@source(IRC_S368_A, quote = "a transfer by a corporation of all or a part of its assets to another corporation if immediately after the transfer the transferor, or one or more of its shareholders (including persons who were shareholders immediately before the transfer), or any combination thereof, is in control of the corporation to which the assets are transferred; but only if, in pursuance of the plan, stock or securities of the corporation to which the assets are transferred are distributed in a transaction which qualifies under section 354, 355, or 356;")
rule ReorganizationTypeDRule(r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) strict {
    label en official "section 368(a)(1)(D): an asset transfer with post-transfer control and a qualifying section 354/355/356 distribution is a reorganization";
    when asset_transfer_with_control_368d(r, transferor, transferee);
    when stock_or_securities_distributed_under_354_355_356(r);
    then reorganization(r, TypeDAssetTransferWithControlAndDistribution);
}

// Section 368(a)(2)(A): if a transaction is described in BOTH (1)(C) and
// (1)(D), it is treated (outside of (1)(C) itself) as described ONLY in
// (1)(D) — modelled as a projection-helper witness relation the (1)(C)
// rules above read under `not_known` (LDC-E0207: `not_known` rejects `_`).
pub relation reorganization_c_and_d_both_described(r: ReorganizationTransaction) kind institutional {
    label en official "section 368(a)(2)(A): the transaction is described in both section 368(a)(1)(C) and section 368(a)(1)(D) — for purposes of this subchapter (other than paragraph (1)(C) itself), it is treated as described only in paragraph (1)(D)";
}
@source(IRC_S368_A, quote = "If a transaction is described in both paragraph (1)(C) and paragraph (1)(D), then, for purposes of this subchapter (other than for purposes of subparagraph (C)), such transaction shall be treated as described only in paragraph (1)(D).")
rule ReorganizationCAndDBothDescribedRule(r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) strict {
    label en official "section 368(a)(2)(A): witness that both paragraph (1)(C) and paragraph (1)(D) describe the transaction";
    when acquisition_of_substantially_all_properties(r, transferor, transferee);
    when asset_transfer_with_control_368d(r, transferor, transferee);
    when stock_or_securities_distributed_under_354_355_356(r);
    then reorganization_c_and_d_both_described(r);
}

// --- (a)(1)(E): recapitalization --------------------------------------------

@source(IRC_S368_A, quote = "a recapitalization;")
pub relation recapitalization(r: ReorganizationTransaction, corp: Corporation) kind empirical {
    label en official "the transaction is a recapitalization of a single corporation's own capital structure — section 368(a)(1)(E) (no statutory definition; read as a case fact per the settled case-law meaning, a reshuffling of one corporation's own capital structure)";
}
@source(IRC_S368_A, quote = "a recapitalization;")
rule ReorganizationTypeERule(r: ReorganizationTransaction, corp: Corporation) strict {
    label en official "section 368(a)(1)(E): a recapitalization is a reorganization";
    when recapitalization(r, corp);
    then reorganization(r, TypeERecapitalization);
}

// --- (a)(1)(F): mere change in identity, form, or place of organization ---

@source(IRC_S368_A, quote = "a mere change in identity, form, or place of organization of one corporation, however effected; or")
pub relation mere_change_in_identity_form_or_place(r: ReorganizationTransaction, corp: Corporation) kind empirical {
    label en official "the transaction is a mere change in identity, form, or place of organization of one corporation, however effected — section 368(a)(1)(F)";
}
@source(IRC_S368_A, quote = "a mere change in identity, form, or place of organization of one corporation, however effected; or")
rule ReorganizationTypeFRule(r: ReorganizationTransaction, corp: Corporation) strict {
    label en official "section 368(a)(1)(F): a mere change of one corporation's identity, form, or place of organization is a reorganization";
    when mere_change_in_identity_form_or_place(r, corp);
    then reorganization(r, TypeFMereChange);
}

// --- (a)(1)(G): title 11 or similar case, with section 354/355/356 --------
// --- distribution -----------------------------------------------------------

@source(IRC_S368_A, quote = "a case under title 11 of the United States Code, or")
pub relation title_11_or_similar_case(r: ReorganizationTransaction) kind empirical {
    label en official "section 368(a)(3)(A): the transfer is made in a case under title 11 of the United States Code, or a receivership, foreclosure, or similar proceeding in a Federal or State court";
}
@source(IRC_S368_A, quote = "a transfer by a corporation of all or part of its assets to another corporation in a title 11 or similar case; but only if, in pursuance of the plan, stock or securities of the corporation to which the assets are transferred are distributed in a transaction which qualifies under section 354, 355, or 356.")
rule ReorganizationTypeGRule(r: ReorganizationTransaction, transferor: Corporation, transferee: Corporation) strict {
    label en official "section 368(a)(1)(G): a title 11 or similar case asset transfer with a qualifying section 354/355/356 distribution is a reorganization";
    when title_11_or_similar_case(r);
    when asset_transfer_with_control_368d(r, transferor, transferee);
    when stock_or_securities_distributed_under_354_355_356(r);
    then reorganization(r, TypeGInsolvencyReorganization);
}

// --- Section 368(b): "a party to a reorganization" -------------------------

pub relation party_to_a_reorganization(r: ReorganizationTransaction, corp: Corporation) kind institutional {
    label en official "the corporation is \"a party to a reorganization\" within the meaning of section 368(b)";
}
@source(IRC_S368_B, quote = "a corporation resulting from a reorganization, and")
pub relation corporation_resulting_from_reorganization(r: ReorganizationTransaction, corp: Corporation) kind empirical {
    label en official "section 368(b)(1): the corporation results from the reorganization";
}
rule PartyToAReorganizationFromResultRule(r: ReorganizationTransaction, corp: Corporation, kind: ReorganizationTypeKind) strict {
    label en official "section 368(b)(1): a corporation resulting from a reorganization is a party to it";
    when reorganization(r, kind);
    when corporation_resulting_from_reorganization(r, corp);
    then party_to_a_reorganization(r, corp);
}
@source(IRC_S368_B, quote = "both corporations, in the case of a reorganization resulting from the acquisition by one corporation of stock or properties of another.")
rule PartyToAReorganizationBothAcquisitionRule(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) strict {
    label en official "section 368(b)(2): both the acquiring and the acquired corporation are parties to a reorganization resulting from an acquisition of stock or properties";
    when acquisition_solely_for_voting_stock(r, acquiring, target);
    then party_to_a_reorganization(r, acquiring);
}
rule PartyToAReorganizationBothAcquisitionTargetRule(r: ReorganizationTransaction, acquiring: Corporation, target: Corporation) strict {
    label en official "section 368(b)(2): the acquired corporation is also a party to the reorganization";
    when acquisition_solely_for_voting_stock(r, acquiring, target);
    then party_to_a_reorganization(r, target);
}
@source(IRC_S368_B, quote = "In the case of a reorganization qualifying under paragraph (1)(B) or (1)(C) of subsection (a), if the stock exchanged for the stock or properties is stock of a corporation which is in control of the acquiring corporation, the term \"a party to a reorganization\" includes the corporation so controlling the acquiring corporation.")
pub relation controlling_corporation_stock_used_in_368a1bc(r: ReorganizationTransaction, controlling: Corporation, acquiring: Corporation) kind empirical {
    label en official "section 368(b): in a section 368(a)(1)(B) or (C) reorganization, the stock exchanged is stock of a corporation in control of the acquiring corporation";
}
rule PartyToAReorganizationControllingCorporationRule(r: ReorganizationTransaction, controlling: Corporation, acquiring: Corporation) strict {
    label en official "section 368(b): the controlling corporation whose stock is used is also a party to the reorganization";
    when controlling_corporation_stock_used_in_368a1bc(r, controlling, acquiring);
    then party_to_a_reorganization(r, controlling);
}

// --- Section 368(b)/(a) continuity requirements: EVALUATIVE ---------------
// (DECISION-0194) — not in the pinned statutory text: continuity of
// shareholder interest, continuity of business enterprise, and business
// purpose are wholly REGULATORY tests (26 CFR 1.368-1(b), (d), (e)), never
// reduced to a statutory formula. Channeled as external judgment relations
// with the Secretary as the nominal authority, matching the shape this
// package's own section 302(b)(1)/357(b)(1) evaluative channels already
// use, per the task brief's explicit instruction ("EVALUATIVE, regulatory
// tests EXTERNAL_DEPENDENCY").
external judgment relation continuity_of_shareholder_interest_maintained(r: ReorganizationTransaction) {
    authority Secretary;
    label en official "continuity of (proprietary) shareholder interest is maintained in the reorganization — 26 CFR 1.368-1(b), (e) (not in the pinned statutory text; EXTERNAL_DEPENDENCY on Treasury regulations)";
}
external judgment relation continuity_of_business_enterprise_maintained(r: ReorganizationTransaction) {
    authority Secretary;
    label en official "continuity of business enterprise is maintained — the acquiring corporation continues the acquired corporation's historic business or uses a significant portion of its historic business assets (26 CFR 1.368-1(d); EXTERNAL_DEPENDENCY on Treasury regulations)";
}
external judgment relation reorganization_has_valid_business_purpose(r: ReorganizationTransaction) {
    authority Secretary;
    label en official "the reorganization has a valid business purpose — 26 CFR 1.368-1(b) (EXTERNAL_DEPENDENCY on Treasury regulations)";
}
pub relation reorganization_satisfies_judicial_doctrines(r: ReorganizationTransaction) kind institutional {
    label en official "the reorganization satisfies continuity of interest, continuity of business enterprise, and business purpose — the regulatory (non-statutory) prerequisites courts and the Secretary have read into section 368(a)'s reorganization types, all three DECISION-0194 evaluative channels";
}
rule ReorganizationSatisfiesJudicialDoctrinesRule(r: ReorganizationTransaction) defeasible {
    label en unofficial "combines the three regulatory continuity/purpose tests into one classification witness";
    when continuity_of_shareholder_interest_maintained(r);
    when continuity_of_business_enterprise_maintained(r);
    when reorganization_has_valid_business_purpose(r);
    then reorganization_satisfies_judicial_doctrines(r);
}

// NOT DONE this stage (TECH_GAP/NON_NORMATIVE, see coverage rows): section
// 368(a)(2)(C)-(H) (dropdowns to controlled subsidiaries, use of a
// controlling corporation's stock in (1)(A)/(1)(G)/statutory-merger cases,
// the (2)(F) 2-or-more-investment-companies special rule (a much deeper,
// separately numbered provision), the (2)(G) distribution requirement for
// (1)(C) with its own Secretary-waiver power, and the (2)(H) special rules
// for (1)(D) using section 304(c) control/section 355 disposition — each is
// its own multi-clause sub-provision the coordinator's "special rules"
// framing does not require decomposing further this stage); section
// 368(a)(3) title 11/similar-case sub-definitions beyond the bare
// `title_11_or_similar_case` switch used by type G above.
