// §6049 (interest $10), §6050H (mortgage interest $600 — brief), §6050I
// (cash > $10,000), §6050P (discharge of indebtedness $600 — brief),
// §6050S (tuition — brief), §6050W (payment card / third-party network),
// package `us.irc.information_reporting`, module 04. §6049 and §6050I and
// §6050W STAGE 1 FULL; §6050H/§6050P/§6050S STAGE 1 PARTIAL (threshold +
// duty only, no full content-list/statement detail beyond what is shown).
//
// JUDGMENT CALLS
//  - §6049(b)'s eight-category "interest" definition and its exceptions
//    ((2)(A)-(C)) are modeled as a single classification test
//    (`is_reportable_interest_payment`) built from the (b)(1)(A)-(G)
//    categories as an enum, with the (b)(2) exceptions as `unless`
//    defeaters — this stage does not further test each exception's own
//    sub-classification (foreign government/central bank/foreign
//    corporation not engaged in USTB, etc.), which is `definitions`'/
//    `international`'s own norm (EXTERNAL_DEPENDENCY).
//  - §6050I(a)'s "at such time as the Secretary may by regulations
//    prescribe" gives no literal filing deadline in the statute text
//    itself; the commonly cited 15-day period (26 CFR 1.6050I-1(e)) is a
//    REGULATORY, not statutory, deadline — this package does NOT invent
//    it. `information_return_due` for §6050I is EXTERNAL_DEPENDENCY
//    (Secretary's regulatory prescription), never a literal "15 days" this
//    package writes into the statute's own rule. Only the (e) payee
//    statement (January 31, a literal in the text) gets a computed date.
//  - §6050I(f) (anti-structuring) is modeled as three `prohibition`s (one
//    per (1)(A)-(C) act) sharing the same civil/criminal-sanction
//    consequence cross-reference in (2) — NON_NORMATIVE for (2) itself
//    (penalties owned by `penalties`/`crimes`).
//  - §6050I(g) (cash received by criminal court clerks) stays `unreviewed`,
//    stage 2 — a structurally separate duty-bearer (court clerks) not
//    named among the owner's priority items.
//  - §6050W(e)'s edition split follows PL 119-21 §70432: the base 2024
//    text's $600 de minimis exception for third-party settlement
//    organizations (the American Rescue Plan Act's 2021 rule) is REPEALED
//    RETROACTIVELY "as if included in section 9674 of the American Rescue
//    Plan Act" — i.e., PL 119-21 treats the $20,000/200-transaction
//    threshold as having been the law continuously since ARPA's original
//    effective date, not merely prospectively from 2026. This package
//    therefore models the PL119-21 era as the ENTIRE window the American
//    Rescue Plan Act's amendment would otherwise have covered, with the
//    base 2024-edition $600 text treated as superseded text rather than a
//    genuine earlier era — flagged for the coordinator: the exact
//    retroactivity boundary date (ARPA §9674's own original effective
//    date) is not in this package's pinned fragments and is not invented
//    here (SOURCE_GAP: need ARPA §9674's effective-date text to fix the
//    window's left edge precisely; this package's rule uses `effective
//    (-infinity, infinity)` for the $20,000/200 rule and does NOT also
//    write a competing $600 rule, avoiding a false conflict rather than
//    guessing the boundary).
//  - §6050W(b)-(d) (payment settlement entity / reportable payment
//    transaction / participating payee definitions) are read as
//    classification facts a case asserts directly (`is_payment_settlement_entity`,
//    `is_third_party_network_transaction`), not further
//    decomposed into the aggregation-intermediary and electronic-payment-
//    facilitator special rules of (b)(4) — stage 2.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6049_A,
    IRC_S6049_B,
    IRC_S6050H_A,
    IRC_S6050H_D,
    IRC_S6050I_A,
    IRC_S6050I_E,
    IRC_S6050I_F,
    IRC_S6050P_A,
    IRC_S6050P_D,
    IRC_S6050S_A,
    IRC_S6050W_A,
    IRC_S6050W_F,
    Individual,
    InformationReturnKind,
    Person,
    Secretary,
    TaxableYear,
    filed_information_return,
    furnished_payee_statement,
    information_return_required,
    middleman_reports_interest,
    not_first_recipient_6050h,
    payee_statement_due,
    payee_statement_required,
};

// ============================================================================
// §6049 — Returns regarding payments of interest
// ============================================================================

relation is_reportable_interest_payment(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the payment is 'interest' within §6049(b)(1)'s categories and not excepted by §6049(b)(2)";
}
relation interest_payment_candidate(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "case fact: the payer pays the payee an amount described in one of §6049(b)(1)(A)-(G)'s interest categories, aggregating this amount for the calendar year";
}
relation interest_payment_excepted(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "one of §6049(b)(2)'s exceptions applies (obligation issued by a natural person; a §6049(b)(4)/(5) payee; foreign-source/foreign-payor income) — pending: `definitions`/`international`, not this package's norm";
}
@source(IRC_S6049_B, relation = formalizes, coverage = partial, quote = "interest on any obligation")
rule S6049IsReportableInterest defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_payment_candidate(payer, payee, y, amount);
    then is_reportable_interest_payment(payer, payee, y, amount);
    unless interest_payment_excepted(payer, payee, y, amount);
}

relation makes_or_nominee_forwards_interest(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "§6049(a)(1)/(2): the payer makes payments of interest aggregating this amount, or receives interest as a nominee and forwards payments aggregating this amount, to the payee during the calendar year";
}
@source(IRC_S6049_A, relation = formalizes, coverage = exact, quote = "who makes payments of interest (as defined in subsection (b)) aggregating $10 or more to any other person during any calendar year, or")
rule S6049InterestReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when makes_or_nominee_forwards_interest(payer, payee, y, amount) and is_reportable_interest_payment(payer, payee, y, amount) and amount >= 10 USD;
    then duty MakeInterestReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, InterestPayments6049);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, InterestPayments6049);
    unless middleman_reports_interest(payer, payee, y, amount);
}

// ============================================================================
// §6050H — Returns relating to mortgage interest received in trade or
// business from individuals (brief: threshold + duty only)
// ============================================================================

relation mortgage_interest_received(lender: Person, borrower: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the lender, in the course of a trade or business, receives from the individual borrower interest aggregating this amount on a mortgage during the calendar year";
}
@source(IRC_S6050H_A, relation = formalizes, coverage = exact, quote = "who, in the course of such trade or business, receives from any individual interest aggregating $600 or more for any calendar year on any mortgage,")
rule S6050HMortgageInterestReturnDuty defeasible {
    for lender: Person;
    for borrower: Individual;
    for y: TaxableYear;
    for amount: Money;
    when mortgage_interest_received(lender, borrower, y, amount) and amount >= 600 USD;
    then duty MakeMortgageInterestReturn {
        bearer lender;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(lender, borrower, y, MortgageInterestReceived6050H);
            window [-infinity, infinity];
        }
    };
    then information_return_required(lender, borrower, y, MortgageInterestReceived6050H);
    unless not_first_recipient_6050h(lender, borrower, y, amount);
}
@source(IRC_S6050H_D, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050HStatementDuty defeasible {
    for lender: Person;
    for borrower: Individual;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(lender, borrower, y, MortgageInterestReceived6050H);
    when us.irc.core::ends(y, end_date);
    then duty FurnishMortgageInterestStatement {
        bearer lender;
        beneficiary borrower;
        goal achievement {
            condition furnished_payee_statement(lender, borrower, y, MortgageInterestReceived6050H);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(lender, borrower, y, MortgageInterestReceived6050H);
    then payee_statement_due(lender, y, MortgageInterestReceived6050H, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

// ============================================================================
// §6050I — Returns relating to cash received in trade or business, etc.
// ============================================================================

relation trade_or_business(person: Person) kind institutional {
    label en unofficial "the person is engaged in a trade or business (pending: `definitions`, not this package's norm — asserted directly where a case's cash-transaction facts presuppose it)";
}
relation cash_received_in_transaction(recipient: Person, payer: Person, y: TaxableYear, amount: Money, on: Date) kind empirical {
    label en unofficial "§6050I(a)(2): the recipient, in the course of a trade or business, receives this amount of cash from the payer in 1 transaction (or 2 or more related transactions) on this date";
}
relation cash_receipt_excepted(recipient: Person, payer: Person, y: TaxableYear) kind institutional {
    label en unofficial "one of §6050I(c)'s exceptions applies (Title 31 duplicate reporting; a listed financial institution; the entire transaction occurs outside the United States) — pending classification, not this package's own test of which Title 31 category the recipient falls in";
}
@source(IRC_S6050I_A, relation = formalizes, coverage = exact, quote = "who, in the course of such trade or business, receives more than $10,000 in cash in 1 transaction (or 2 or more related transactions),")
rule S6050ICashReturnDuty defeasible {
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    for amount: Money;
    for on: Date;
    when trade_or_business(recipient) and cash_received_in_transaction(recipient, payer, y, amount, on) and amount > 10000 USD;
    then duty MakeCashReceiptReturn {
        bearer recipient;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(recipient, payer, y, CashOverTenThousand6050I);
            window [-infinity, infinity];
        }
    };
    then information_return_required(recipient, payer, y, CashOverTenThousand6050I);
    unless cash_receipt_excepted(recipient, payer, y);
}

@source(IRC_S6050I_E, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050IStatementDuty defeasible {
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(recipient, payer, y, CashOverTenThousand6050I);
    when us.irc.core::ends(y, end_date);
    then duty FurnishCashReceiptStatement {
        bearer recipient;
        beneficiary payer;
        goal achievement {
            condition furnished_payee_statement(recipient, payer, y, CashOverTenThousand6050I);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(recipient, payer, y, CashOverTenThousand6050I);
    then payee_statement_due(recipient, y, CashOverTenThousand6050I, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

// --- §6050I(f): anti-structuring prohibitions --------------------------------

relation causes_trade_or_business_to_fail_to_file(person: Person, recipient: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "§6050I(f)(1)(A): the person causes or attempts to cause a trade or business to fail to file a §6050I return, for the purpose of evading the return requirements";
}
@source(IRC_S6050I_F, relation = formalizes, coverage = exact, quote = "cause or attempt to cause a trade or business to fail to file a return required under this section,")
rule S6050INoCausingFailureToFile strict {
    for person: Person;
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    when causes_trade_or_business_to_fail_to_file(person, recipient, payer, y);
    then prohibition S6050INoCausingFailureToFileProhibition {
        bearer person;
        action causes_trade_or_business_to_fail_to_file(person, recipient, payer, y);
        window [-infinity, infinity];
    };
}
relation causes_return_material_omission_or_misstatement(person: Person, recipient: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "§6050I(f)(1)(B): the person causes or attempts to cause a trade or business to file a §6050I return containing a material omission or misstatement of fact, for the purpose of evading the return requirements";
}
@source(IRC_S6050I_F, relation = formalizes, coverage = exact, quote = "cause or attempt to cause a trade or business to file a return required under this section that contains a material omission or misstatement of fact, or")
rule S6050INoCausingMaterialOmission strict {
    for person: Person;
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    when causes_return_material_omission_or_misstatement(person, recipient, payer, y);
    then prohibition S6050INoCausingMaterialOmissionProhibition {
        bearer person;
        action causes_return_material_omission_or_misstatement(person, recipient, payer, y);
        window [-infinity, infinity];
    };
}
relation structures_transaction_to_evade_reporting(person: Person, recipient: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "§6050I(f)(1)(C): the person structures or assists in structuring, or attempts to structure or assist in structuring, a transaction with one or more trades or businesses, for the purpose of evading the return requirements";
}
@source(IRC_S6050I_F, relation = formalizes, coverage = exact, quote = "structure or assist in structuring, or attempt to structure or assist in structuring, any transaction with one or more trades or businesses.")
rule S6050INoStructuring strict {
    for person: Person;
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    when structures_transaction_to_evade_reporting(person, recipient, payer, y);
    then prohibition S6050INoStructuringProhibition {
        bearer person;
        action structures_transaction_to_evade_reporting(person, recipient, payer, y);
        window [-infinity, infinity];
    };
}
// §6050I(f)(2) (penalties cross-reference) — NON_NORMATIVE here, owner
// `penalties`/`crimes`. §6050I(g) (criminal court clerks) — `unreviewed`,
// stage 2.

// ============================================================================
// §6050P — Returns relating to the cancellation of indebtedness by certain
// entities (brief: threshold + duty only)
// ============================================================================

relation is_applicable_entity_6050P(obligor: Person) kind institutional {
    label en unofficial "the person is an 'applicable entity' under §6050P(c) (financial institutions, credit unions, federal agencies, etc. — pending, not this package's norm)";
}
relation indebtedness_discharged(obligor: Person, debtor: Person, y: TaxableYear, amount: Money, on: Date) kind empirical {
    label en unofficial "the applicable entity discharges (in whole or in part) the debtor's indebtedness of this amount on this date during the calendar year";
}
@source(IRC_S6050P_A, relation = formalizes, coverage = exact, quote = "Any applicable entity which discharges (in whole or in part) the indebtedness of any person during any calendar year shall make a return")
rule S6050PDischargeReturnDuty defeasible {
    for obligor: Person;
    for debtor: Person;
    for y: TaxableYear;
    for amount: Money;
    for on: Date;
    when is_applicable_entity_6050P(obligor) and indebtedness_discharged(obligor, debtor, y, amount, on) and amount >= 600 USD;
    then duty MakeDischargeOfIndebtednessReturn {
        bearer obligor;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(obligor, debtor, y, DischargeOfIndebtedness6050P);
            window [-infinity, infinity];
        }
    };
    then information_return_required(obligor, debtor, y, DischargeOfIndebtedness6050P);
}
@source(IRC_S6050P_D, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was made.")
rule S6050PStatementDuty defeasible {
    for obligor: Person;
    for debtor: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(obligor, debtor, y, DischargeOfIndebtedness6050P);
    when us.irc.core::ends(y, end_date);
    then duty FurnishDischargeOfIndebtednessStatement {
        bearer obligor;
        beneficiary debtor;
        goal achievement {
            condition furnished_payee_statement(obligor, debtor, y, DischargeOfIndebtedness6050P);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(obligor, debtor, y, DischargeOfIndebtedness6050P);
    then payee_statement_due(obligor, y, DischargeOfIndebtedness6050P, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

// ============================================================================
// §6050S — Returns relating to higher education tuition and related
// expenses (brief: duty only, no dollar threshold in the (a)(1)/(a)(2)
// branches; (a)(3) education-loan-interest branch shares §6050H's $600)
// ============================================================================

relation is_eligible_educational_institution(institution: Person) kind institutional {
    label en unofficial "the person is an eligible educational institution within the meaning of §25A (read from the owner (WIRE-7): `credits`, not this package's norm)";
}
relation enrolls_individual_for_academic_period(institution: Person, individual: Individual, y: TaxableYear) kind empirical;
@source(IRC_S6050S_A, relation = formalizes, coverage = exact, quote = "which is an eligible educational institution which enrolls any individual for any academic period;")
rule S6050STuitionReturnDuty defeasible {
    for institution: Person;
    for individual: Individual;
    for y: TaxableYear;
    when is_eligible_educational_institution(institution) and enrolls_individual_for_academic_period(institution, individual, y);
    then duty MakeTuitionReturn {
        bearer institution;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(institution, individual, y, QualifiedTuitionPayments6050S);
            window [-infinity, infinity];
        }
    };
    then information_return_required(institution, individual, y, QualifiedTuitionPayments6050S);
}

// ============================================================================
// §6050W — Returns relating to payments made in settlement of payment card
// and third party network transactions
// ============================================================================

relation is_payment_settlement_entity(obligor: Person) kind institutional {
    label en unofficial "the person is a payment settlement entity under §6050W(b) — the merchant acquiring entity for a payment card transaction, or the third party settlement organization for a third party network transaction";
}
relation is_third_party_settlement_organization(obligor: Person) kind institutional {
    label en unofficial "the payment settlement entity is specifically a third party settlement organization (§6050W(b)(3)) — the (e) de minimis exception applies only to this subtype";
}
relation reportable_payment_transaction(obligor: Person, payee: Person, y: TaxableYear, gross_amount: Money) kind empirical {
    label en unofficial "the payment settlement entity settles reportable payment transactions with this participating payee, aggregating this gross amount for the calendar year";
}
relation third_party_network_transaction_count(obligor: Person, payee: Person, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the aggregate number of third party network transactions with the participating payee during the calendar year (used only by the (e) de minimis exception)";
}

pub relation payment_card_and_network_de_minimis_threshold_amount(y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the §6050W(e) de minimis dollar threshold for third party settlement organizations in effect for the year";
}
pub relation payment_card_and_network_de_minimis_threshold_count(y: TaxableYear, count: Integer) kind institutional {
    label en unofficial "the §6050W(e) de minimis transaction-count threshold for third party settlement organizations in effect for the year (0 before PL 119-21, since the base 2024-edition text has no count prong)";
}
relation threshold_6050W_lookup_year(y: TaxableYear) kind empirical {
    label en unofficial "positive anchor (§190): the case asserts this is the calendar year whose §6050W(e) de minimis threshold is at issue";
}
// The base 2024-edition text sets a $600/no-count-prong de minimis
// exception (the American Rescue Plan Act's 2021 rule). PL 119-21 §70432
// retroactively REPEALS that text "as if included in section 9674 of the
// American Rescue Plan Act" — i.e., for the entire window ARPA's 2021
// amendment would otherwise have governed, not merely prospectively from
// 2026. This package does not pin ARPA §9674's own effective-date text
// (SOURCE_GAP, see header), so it gives ONE unconditional rule for the
// $20,000/200 threshold, rather than a competing pair with an invented
// boundary date and rather than also writing the superseded $600/no-count
// text as a live rule (which would conflict with this one for the same
// `TaxableYear` with no `priority` available between two `strict` rules on
// the same head, per the compiler's LDC-E2142 restriction).
@source(us.irc.temporal::PL119_21_S70432, relation = formalizes, coverage = exact, quote = "the amount which would otherwise be reported under subsection (a)(2) with respect to such transactions exceeds $20,000, and")
rule S6050WDeMinimisThresholdReinstated strict {
    for y: TaxableYear;
    when threshold_6050W_lookup_year(y);
    then payment_card_and_network_de_minimis_threshold_amount(y, 20000 USD);
}
@source(us.irc.temporal::PL119_21_S70432, relation = formalizes, coverage = exact, quote = "the aggregate number of such transactions exceeds 200.")
rule S6050WDeMinimisTransactionCountReinstated strict {
    for y: TaxableYear;
    when threshold_6050W_lookup_year(y);
    then payment_card_and_network_de_minimis_threshold_count(y, 200);
}

relation payment_card_and_network_de_minimis_excepted(obligor: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "§6050W(e): the third party settlement organization is excepted from reporting because BOTH the amount and (under the PL 119-21 text) the transaction count fall at or under the de minimis thresholds";
}
@source(us.irc.temporal::PL119_21_S70432, relation = formalizes, coverage = partial, quote = "third party settlement organization shall be required to report any information under subsection (a) with respect to third party network transactions of any participating payee only if")
rule S6050WDeMinimisExceptionApplies strict {
    for obligor: Person;
    for payee: Person;
    for y: TaxableYear;
    for gross_amount: Money;
    for count: Integer;
    for threshold_amount: Money;
    for threshold_count: Integer;
    when is_third_party_settlement_organization(obligor);
    when reportable_payment_transaction(obligor, payee, y, gross_amount);
    when third_party_network_transaction_count(obligor, payee, y, count);
    when payment_card_and_network_de_minimis_threshold_amount(y, threshold_amount);
    when payment_card_and_network_de_minimis_threshold_count(y, threshold_count);
    when gross_amount <= threshold_amount;
    when count <= threshold_count;
    then payment_card_and_network_de_minimis_excepted(obligor, payee, y);
}

@source(IRC_S6050W_A, relation = formalizes, coverage = exact, quote = "Each payment settlement entity shall make a return for each calendar year setting forth—")
rule S6050WPaymentCardReturnDuty defeasible {
    for obligor: Person;
    for payee: Person;
    for y: TaxableYear;
    for gross_amount: Money;
    when is_payment_settlement_entity(obligor) and reportable_payment_transaction(obligor, payee, y, gross_amount);
    then duty MakePaymentCardReturn {
        bearer obligor;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(obligor, payee, y, PaymentCardAndThirdPartyNetwork6050W);
            window [-infinity, infinity];
        }
    };
    then information_return_required(obligor, payee, y, PaymentCardAndThirdPartyNetwork6050W);
    unless payment_card_and_network_de_minimis_excepted(obligor, payee, y);
}

@source(IRC_S6050W_F, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050WStatementDuty defeasible {
    for obligor: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(obligor, payee, y, PaymentCardAndThirdPartyNetwork6050W);
    when us.irc.core::ends(y, end_date);
    then duty FurnishPaymentCardStatement {
        bearer obligor;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(obligor, payee, y, PaymentCardAndThirdPartyNetwork6050W);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(obligor, payee, y, PaymentCardAndThirdPartyNetwork6050W);
    then payee_statement_due(obligor, y, PaymentCardAndThirdPartyNetwork6050W, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}
