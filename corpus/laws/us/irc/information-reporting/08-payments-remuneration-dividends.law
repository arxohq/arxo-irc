// §6041 (d)-(g), §6041A, §6042, §6043, §6043A, §6044 — payments-at-source,
// remuneration, dividends, liquidation and patronage-dividend returns of
// package `us.irc.information_reporting`, module 08 (STAGE 2). Completes what
// module 02 did for these sections: statement content, exceptions,
// definitions and the paragraphs stage 1 left `unreviewed`.
//
// JUDGMENT CALLS
//  - §6041(f)'s and (e)'s exclusions feed one derived `excluded_from_6041`
//    that the (a) duty now reads in its `unless` (module 02 edited).
//  - §6041(g) (nonqualified deferred compensation) is a second duty rule with
//    its own threshold read; the 409A / §6051(a)(13) classifications are
//    case facts (EXTERNAL_DEPENDENCY: deferred-compensation, employment).
//  - §6041A(c)'s no-return rule reads `payee_statement_required` of the
//    §6051/§6052/§6053 kinds; the two duties of module 02 have the matching
//    `unless`.
//  - §6042(b) is a definition relation (`dividend_for_6042`) and the
//    exception relation the duty reads; the stage-1 `dividend_payment` fact
//    stays the duty's trigger (it is asserted as already classified).

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6041A_B,
    IRC_S6041A_C,
    IRC_S6041A_D,
    IRC_S6041A_E,
    IRC_S6041A_F,
    IRC_S6041_A,
    IRC_S6041_B,
    IRC_S6041_D,
    IRC_S6041_E,
    IRC_S6041_F,
    IRC_S6041_G,
    IRC_S6042_A,
    IRC_S6042_B,
    IRC_S6042_C,
    IRC_S6042_D,
    IRC_S6043A_A,
    IRC_S6043A_B,
    IRC_S6043A_C,
    IRC_S6043A_D,
    IRC_S6043_B,
    IRC_S6043_C,
    IRC_S6044_B,
    IRC_S6044_C,
    IRC_S6044_D,
    IRC_S6044_E,
    Individual,
    InformationReturnKind,
    Organ,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    designated_officer_for_return,
    dividend_payment,
    excluded_from_6041_by_other_section,
    filed_information_return,
    furnished_payee_statement,
    governmental_unit,
    information_return_required,
    information_return_threshold_6041,
    patronage_dividend_excepted,
    patronage_dividend_payment,
    payee_statement_due,
    payee_statement_required,
    required_return_item,
    required_statement_item,
    service_remuneration_payment,
    w2_required,
};

// ============================================================================
// §6041(b), (d)-(g) — foreign items, statement content, carve-outs, deferred compensation
// ============================================================================

relation foreign_item_collection_undertaken_as_business(collector: Person, recipient: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person undertakes, as a matter of business or for profit, the collection of foreign payments (not payable in the United States) of interest on foreign-country bonds or of interest or dividends of foreign corporations by coupons, checks or bills of exchange, and collects this amount for the recipient (section 6041(b))";
}

@source(IRC_S6041_B, relation = formalizes, coverage = exact, quote = "such person shall make a return according to the forms or regulations prescribed by the Secretary, setting forth the amount paid and the name and address of the recipient of each such payment.")
rule S6041bForeignItemCollectionReturnDuty defeasible {
    for collector: Person;
    for recipient: Person;
    for y: TaxableYear;
    for amount: Money;
    when foreign_item_collection_undertaken_as_business(collector, recipient, y, amount);
    then duty MakeForeignItemCollectionReturn {
        bearer collector;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(collector, recipient, y, ForeignItemCollectionReturn6041B);
            window [-infinity, infinity];
        }
    };
    then information_return_required(collector, recipient, y, ForeignItemCollectionReturn6041B);
}

@source(IRC_S6041_D, relation = formalizes, coverage = exact, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6041StatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PaymentsAtSource6041);
    then required_statement_item(payer, y, PaymentsAtSource6041, I6041_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, PaymentsAtSource6041, I6041_AggregateAmountOfPaymentsToPerson);
}

relation excluded_from_6041(payer: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6041 does not apply to this payment (another section governs it, tips under section 6053(a), or a health arrangement payment)";
}

relation payment_is_tips_subject_to_6053a(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the payment is tips with respect to which section 6053(a) applies";
}

relation medical_care_payment_under_fsa(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the payment for medical care (section 213(d)) is made under a flexible spending arrangement (section 106(c)(2))";
}

relation medical_care_payment_under_employer_coverage_hra(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the payment for medical care is made under a health reimbursement arrangement treated as employer-provided coverage under an accident or health plan for section 106";
}

@source(IRC_S6041_A, relation = formalizes, coverage = partial, quote = "other than payments to which section 6042(a)(1), 6044(a)(1), 6047(e), 6049(a), or 6050N(a) applies")
rule S6041ExclusionByOtherSection strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when excluded_from_6041_by_other_section(payer, payee, y);
    then excluded_from_6041(payer, payee, y);
}

@source(IRC_S6041_E, relation = formalizes, coverage = exact, quote = "This section shall not apply to tips with respect to which section 6053(a) (relating to reporting of tips) applies.")
rule S6041eTipsExclusion strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payment_is_tips_subject_to_6053a(payer, payee, y);
    then excluded_from_6041(payer, payee, y);
}

@source(IRC_S6041_F, relation = formalizes, coverage = exact, quote = "a flexible spending arrangement (as defined in section 106(c)(2)), or")
rule S6041fFlexibleSpendingArrangementCarveOut strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when medical_care_payment_under_fsa(payer, payee, y);
    then excluded_from_6041(payer, payee, y);
}

@source(IRC_S6041_F, relation = formalizes, coverage = exact, quote = "a health reimbursement arrangement which is treated as employer-provided coverage under an accident or health plan for purposes of section 106.")
rule S6041fHealthReimbursementArrangementCarveOut strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when medical_care_payment_under_employer_coverage_hra(payer, payee, y);
    then excluded_from_6041(payer, payee, y);
}

relation nqdc_deferral_for_year(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "deferrals for the year under a nonqualified deferred compensation plan (section 409A(d)), whether or not paid";
}

relation nqdc_deferral_reportable_under_6051a13(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the deferral is required to be reported under section 6051(a)(13) (without regard to any de minimis exception)";
}

relation amount_includible_under_409a(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount includible under section 409A";
}

relation amount_treated_as_wages_3401a(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the amount is treated as wages under section 3401(a)";
}

@source(IRC_S6041_G, relation = formalizes, coverage = exact, quote = "any deferrals for the year under a nonqualified deferred compensation plan (within the meaning of section 409A(d)), whether or not paid")
rule S6041gNqdcDeferralReturnDuty1 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    for threshold: Money;
    when nqdc_deferral_for_year(payer, payee, y, amount);
    when information_return_threshold_6041(y, threshold);
    when amount >= threshold;
    then duty MakeNqdcPaymentReturn1 {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, PaymentsAtSource6041);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, PaymentsAtSource6041);
    unless nqdc_deferral_reportable_under_6051a13(payer, payee, y);
}

@source(IRC_S6041_G, relation = formalizes, coverage = exact, quote = "any amount includible under section 409A and which is not treated as wages under section 3401(a).")
rule S6041gNqdcDeferralReturnDuty2 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    for threshold: Money;
    when amount_includible_under_409a(payer, payee, y, amount);
    when information_return_threshold_6041(y, threshold);
    when amount >= threshold;
    then duty MakeNqdcPaymentReturn2 {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, PaymentsAtSource6041);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, PaymentsAtSource6041);
    unless amount_treated_as_wages_3401a(payer, payee, y);
}

// ============================================================================
// §6041A — remuneration for services and direct sales
// ============================================================================

relation statement_required_under_6051_6052_6053(payer: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "a statement with respect to the services is required to be furnished under section 6051, 6052 or 6053";
}

relation group_term_life_statement_required(employer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the employer is required to furnish the employee a statement of the cost of group-term life insurance (section 6052(b))";
}

relation tip_allocation_statement_required(employer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the employer is required to furnish the employee a statement of allocated tips (section 6053(c)(2))";
}

@source(IRC_S6041A_C, relation = formalizes, coverage = exact, quote = "No return shall be required under subsection (a) or (b) if a statement with respect to the services is required to be furnished under section 6051, 6052, or 6053.")
rule S6041AStatementRequiredElsewhere1 defeasible {
    for payer: Person;
    for payee: Individual;
    for y: TaxableYear;
    when w2_required(payer, payee, y);
    then statement_required_under_6051_6052_6053(payer, payee, y);
}

@source(IRC_S6041A_C, relation = formalizes, coverage = exact, quote = "No return shall be required under subsection (a) or (b) if a statement with respect to the services is required to be furnished under section 6051, 6052, or 6053.")
rule S6041AStatementRequiredElsewhere2 defeasible {
    for payer: Person;
    for payee: Individual;
    for y: TaxableYear;
    when group_term_life_statement_required(payer, payee, y);
    then statement_required_under_6051_6052_6053(payer, payee, y);
}

@source(IRC_S6041A_C, relation = formalizes, coverage = exact, quote = "No return shall be required under subsection (a) or (b) if a statement with respect to the services is required to be furnished under section 6051, 6052, or 6053.")
rule S6041AStatementRequiredElsewhere3 defeasible {
    for payer: Person;
    for payee: Individual;
    for y: TaxableYear;
    when tip_allocation_statement_required(payer, payee, y);
    then statement_required_under_6051_6052_6053(payer, payee, y);
}

relation buyer_retains_price_difference_as_remuneration(seller: Person, buyer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the buyer performing the services is entitled to retain part or all of the difference between purchase price and sale price as remuneration";
}

relation buyer_retains_purchase_deposit_as_remuneration(seller: Person, buyer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the buyer is entitled to retain part or all of a purchase deposit paid by the consumer as remuneration";
}

relation transaction_on_buy_sell_basis(seller: Person, buyer: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6041A(b)(2)(A): the transaction is on a buy-sell basis";
}

relation transaction_on_deposit_commission_basis(seller: Person, buyer: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6041A(b)(2)(B): the transaction is on a deposit-commission basis";
}

@source(IRC_S6041A_B, relation = formalizes, coverage = exact, quote = "A transaction is on a buy-sell basis if the buyer performing the services is entitled to retain part or all of the difference between the price at which the buyer purchases the product and the price at which the buyer sells the product as part or all of the buyer's remuneration for the services, and")
rule S6041ABuySellBasisDefinition strict {
    for seller: Person;
    for buyer: Person;
    for y: TaxableYear;
    when buyer_retains_price_difference_as_remuneration(seller, buyer, y);
    then transaction_on_buy_sell_basis(seller, buyer, y);
}

@source(IRC_S6041A_B, relation = formalizes, coverage = exact, quote = "A transaction is on a deposit-commission basis if the buyer performing the services is entitled to retain part or all of a purchase deposit paid by the consumer in connection with the transaction as part or all of the buyer's remuneration for the services.")
rule S6041ADepositCommissionBasisDefinition strict {
    for seller: Person;
    for buyer: Person;
    for y: TaxableYear;
    when buyer_retains_purchase_deposit_as_remuneration(seller, buyer, y);
    then transaction_on_deposit_commission_basis(seller, buyer, y);
}

@source(IRC_S6041A_D, relation = formalizes, coverage = exact, quote = "any return under this section shall be made by the officer or employee having control of the payment or appropriately designated for the purpose of making such return.")
rule S6041AOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, ServiceRemunerationOrDirectSales6041A);
    when information_return_required(unit, payee, y, ServiceRemunerationOrDirectSales6041A);
    then duty MakeReturnAsDesignatedOfficer6041A {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, ServiceRemunerationOrDirectSales6041A);
            window [-infinity, infinity];
        }
    };
}

relation federal_executive_agency_pays_corporation(agency: Person, corporation: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a Federal executive agency (section 6050M(b)) pays remuneration to a corporation, aggregating this amount for the calendar year";
}

relation agency_contract_protected_6050M_e3(agency: Person, corporation: Person, y: TaxableYear) kind empirical {
    label en unofficial "the services are under a contract described in section 6050M(e)(3) with respect to which the requirements of section 6050M(e)(2) are met";
}

relation secretary_specified_service_excepted_6041A(agency: Person, corporation: Person, y: TaxableYear) kind empirical {
    label en unofficial "the services are ones the Secretary has specified in regulations issued after the enactment of paragraph (3)";
}

relation federal_agency_payment_excepted_6041A(agency: Person, corporation: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6041A(d)(3)(B): the Federal-agency remuneration to a corporation is excepted from subparagraph (A)";
}

@source(IRC_S6041A_D, relation = formalizes, coverage = exact, quote = "services under contracts described in section 6050M(e)(3) with respect to which the requirements of section 6050M(e)(2) are met, and")
rule S6041AFederalAgencyProtectedContractException strict {
    for agency: Person;
    for corporation: Person;
    for y: TaxableYear;
    when agency_contract_protected_6050M_e3(agency, corporation, y);
    then federal_agency_payment_excepted_6041A(agency, corporation, y);
}

@source(IRC_S6041A_D, relation = formalizes, coverage = exact, quote = "such other services as the Secretary may specify in regulations prescribed after the date of the enactment of this paragraph.")
rule S6041AFederalAgencySecretarySpecifiedException strict {
    for agency: Person;
    for corporation: Person;
    for y: TaxableYear;
    when secretary_specified_service_excepted_6041A(agency, corporation, y);
    then federal_agency_payment_excepted_6041A(agency, corporation, y);
}

@source(IRC_S6041A_D, relation = formalizes, coverage = exact, quote = "subsection (a) shall apply to remuneration paid to a corporation by any Federal executive agency")
rule S6041AFederalAgencyPaymentsToCorporationsReturnDuty defeasible {
    for agency: Person;
    for corporation: Person;
    for y: TaxableYear;
    for amount: Money;
    for threshold: Money;
    when federal_executive_agency_pays_corporation(agency, corporation, y, amount);
    when information_return_threshold_6041(y, threshold);
    when amount >= threshold;
    then duty MakeFederalAgencyRemunerationReturn {
        bearer agency;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(agency, corporation, y, ServiceRemunerationOrDirectSales6041A);
            window [-infinity, infinity];
        }
    };
    then information_return_required(agency, corporation, y, ServiceRemunerationOrDirectSales6041A);
    unless federal_agency_payment_excepted_6041A(agency, corporation, y);
}

@source(IRC_S6041A_E, relation = formalizes, coverage = partial, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was made.")
rule S6041AStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, ServiceRemunerationOrDirectSales6041A, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6041A_E, relation = formalizes, coverage = partial, quote = "Every person required to make a return under subsection (a) or (b) shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6041AStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    when us.irc.core::ends(y, end_date);
    then duty FurnishServiceRemunerationStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
}

@source(IRC_S6041A_E, relation = formalizes, coverage = exact, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6041AStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    then required_statement_item(payer, y, ServiceRemunerationOrDirectSales6041A, I6041A_InformationContactNameAddressPhone);
}

@source(IRC_S6041A_E, relation = formalizes, coverage = exact, quote = "in the case of subsection (a), the aggregate amount of payments to the person required to be shown on such return.")
rule S6041AStatementAggregateAmount defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    when service_remuneration_payment(payer, payee, y, _);
    then required_statement_item(payer, y, ServiceRemunerationOrDirectSales6041A, I6041A_AggregateAmountOfPaymentsToPerson);
}

relation payee_furnished_tin_6041a(payee: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the payee furnished the payer name, address and identification number";
}

@source(IRC_S6041A_F, relation = formalizes, coverage = exact, quote = "shall furnish to such other person his name, address, and identification number at such time and in such manner as the Secretary may prescribe by regulations.")
rule S6041APayeeMustFurnishIdentificationDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    then duty FurnishIdentificationNumberTo6041APayer {
        bearer payee;
        beneficiary payer;
        goal achievement {
            condition payee_furnished_tin_6041a(payee, payer, y);
            window [-infinity, infinity];
        }
    };
}

relation payer_included_tin_on_return_6041a(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the payer included the identification number on the return";
}

@source(IRC_S6041A_F, relation = formalizes, coverage = exact, quote = "shall include such number on any return which such person is required to file under this section and to which such identification number relates.")
rule S6041APayerMustIncludeIdentificationDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    when payee_furnished_tin_6041a(payee, payer, y);
    then duty IncludeIdentificationNumberOn6041AReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition payer_included_tin_on_return_6041a(payer, payee, y);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6042 — dividends: nominee return, definition, exceptions, statements
// ============================================================================

relation dividend_payment_forwarded_as_nominee(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the payer receives dividends as a nominee and makes payments to the payee aggregating this amount during the calendar year (section 6042(a)(1)(B))";
}

@source(IRC_S6042_A, relation = formalizes, coverage = exact, quote = "who receives payments of dividends as a nominee and who makes payments aggregating $10 or more during any calendar year to any other person with respect to the dividends so received,")
rule S6042NomineeDividendReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when dividend_payment_forwarded_as_nominee(payer, payee, y, amount);
    when amount >= 10 USD;
    then duty MakeNomineeDividendReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, Dividends6042);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, Dividends6042);
}

relation corporate_distribution_is_316_dividend(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the payment is a distribution by a corporation which is a dividend as defined in section 316 (pending: corporations)";
}

relation stockbroker_substitute_dividend_payment(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the payment is made by a stockbroker to any person as a substitute for a dividend";
}

relation unable_to_determine_dividend_portion(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the payer is unable to determine the portion of the payment that is a dividend or is paid with respect to a dividend";
}

relation dividend_for_6042(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the payment is a dividend for the purposes of section 6042 (definition, section 6042(b))";
}

@source(IRC_S6042_B, relation = formalizes, coverage = exact, quote = "any distribution by a corporation which is a dividend (as defined in section 316); and")
rule S6042DividendDefinitionDistribution strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when corporate_distribution_is_316_dividend(payer, payee, y, amount);
    then dividend_for_6042(payer, payee, y, amount);
}

@source(IRC_S6042_B, relation = formalizes, coverage = exact, quote = "any payment made by a stockbroker to any person as a substitute for a dividend (as so defined).")
rule S6042DividendDefinitionSubstitute strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when stockbroker_substitute_dividend_payment(payer, payee, y, amount);
    then dividend_for_6042(payer, payee, y, amount);
}

@source(IRC_S6042_B, relation = formalizes, coverage = partial, quote = "For purposes of this section, the term \"dividend\" means—")
rule S6042DividendDefinitionAssertedPayment strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when dividend_payment(payer, payee, y, amount);
    then dividend_for_6042(payer, payee, y, amount);
}

@source(IRC_S6042_B, relation = formalizes, coverage = exact, quote = "he shall, for purposes of subsection (a)(1), treat the entire amount of such payment as a dividend or as an amount paid with respect to a dividend.")
rule S6042SpecialRuleUndeterminedPortionIsEntirelyDividend strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when unable_to_determine_dividend_portion(payer, payee, y, amount);
    then dividend_for_6042(payer, payee, y, amount);
}

relation payer_is_foreign_corporation_6042(payer: Person) kind institutional {
    label en unofficial "the payer is a foreign corporation (pending: definitions)";
}

relation payee_is_foreign_corporation_nonresident_alien_or_foreign_partnership_6042(payee: Person) kind institutional {
    label en unofficial "the payee is a foreign corporation, a nonresident alien, or a partnership not engaged in a United States trade or business and composed in whole or in part of nonresident aliens";
}

relation payee_described_in_6049b4(payee: Person) kind institutional {
    label en unofficial "the payee is a person described in section 6049(b)(4) (corporation, exempt organization, governmental unit and the other listed payees)";
}

relation regulation_excludes_dividend_6042(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: a Secretary regulation excludes this distribution or payment from the term dividend";
}

relation regulation_provides_otherwise_6042b2B(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: a Secretary regulation otherwise provides for payments to persons described in section 6049(b)(4)";
}

relation dividend_excluded_6042(payer: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6042(b)(2): the distribution or payment is not a dividend for the section";
}

@source(IRC_S6042_B, relation = formalizes, coverage = exact, quote = "by a foreign corporation, or")
rule S6042ExclusionForeignPayer strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payer_is_foreign_corporation_6042(payer);
    when regulation_excludes_dividend_6042(payer, payee, y);
    then dividend_excluded_6042(payer, payee, y);
}

@source(IRC_S6042_B, relation = formalizes, coverage = exact, quote = "to a foreign corporation, a nonresident alien, or a partnership not engaged in a trade or business in the United States and composed in whole or in part of nonresident aliens, or")
rule S6042ExclusionForeignPayee strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_is_foreign_corporation_nonresident_alien_or_foreign_partnership_6042(payee);
    when regulation_excludes_dividend_6042(payer, payee, y);
    then dividend_excluded_6042(payer, payee, y);
}

@source(IRC_S6042_B, relation = formalizes, coverage = exact, quote = "except to the extent otherwise provided in regulations prescribed by the Secretary, to any person described in section 6049(b)(4).")
rule S6042ExclusionExemptPayees strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_described_in_6049b4(payee);
    when not_known(regulation_provides_otherwise_6042b2B(payer, payee, y));
    when dividend_payment(payer, payee, y, _);
    then dividend_excluded_6042(payer, payee, y);
}

@source(IRC_S6042_C, relation = formalizes, coverage = exact, quote = "to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made")
rule S6042StatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, Dividends6042);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, Dividends6042, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6042_C, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6042StatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, Dividends6042);
    when us.irc.core::ends(y, end_date);
    then duty FurnishDividendStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, Dividends6042);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, Dividends6042);
}

@source(IRC_S6042_C, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6042StatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, Dividends6042);
    then required_statement_item(payer, y, Dividends6042, I6042_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, Dividends6042, I6042_AggregateAmountOfPaymentsToPerson);
}

relation secretary_requires_corporation_statement_6042d(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary requires the corporation to furnish the section 6042(d) statements for the year";
}

@source(IRC_S6042_D, relation = formalizes, coverage = exact, quote = "Every corporation shall, when required by the Secretary—")
rule S6042dCorporationStatementDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when secretary_requires_corporation_statement_6042d(filer, y);
    then duty FurnishCorporationShareholderStatements {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, CorporationShareholderStatement6042D);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, CorporationShareholderStatement6042D);
}

@source(IRC_S6042_D, relation = formalizes, coverage = exact, quote = "furnish to the Secretary a statement stating the name and address of each shareholder, and the number of shares owned by each shareholder;")
rule S6042dStatementContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, CorporationShareholderStatement6042D);
    then required_return_item(filer, y, CorporationShareholderStatement6042D, I6042_ShareholderNamesAddressesAndShares);
    then required_return_item(filer, y, CorporationShareholderStatement6042D, I6042_EarningsAndProfitsDistributionFacts);
    then required_return_item(filer, y, CorporationShareholderStatement6042D, I6042_AccumulatedEarningsAndProfitsStatement);
}

// ============================================================================
// §6043(b)-(d) — exempt-organization terminations and control changes
// ============================================================================

relation was_exempt_501a_in_last_5_taxable_years(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization was exempt from taxation under section 501(a) for any of its last 5 taxable years preceding the event (pending: exempt-organizations)";
}

relation org_liquidated_dissolved_terminated_or_contracted(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization liquidates, dissolves, terminates or substantially contracts during the year";
}

@source(IRC_S6043_B, relation = formalizes, coverage = exact, quote = "shall file such return and other information with respect to such liquidation, dissolution, termination, or substantial contraction as the Secretary shall by forms or regulations prescribe")
rule S6043bTerminationReturnDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when org_liquidated_dissolved_terminated_or_contracted(filer, y);
    when was_exempt_501a_in_last_5_taxable_years(filer, y);
    then duty FileExemptOrganizationTerminationReturn {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, ExemptOrganizationTerminationReturn6043B);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, ExemptOrganizationTerminationReturn6043B);
    unless termination_return_excepted_6043b(filer, y);
}

relation termination_return_excepted_6043b(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6043(b)(1)-(2): no return is required from this organization";
}

relation church_or_auxiliary_6043b(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is a church, an integrated auxiliary, or a convention or association of churches";
}

relation small_non_foundation_6043b(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is not a private foundation (section 509(a)) and its gross receipts in each taxable year are normally not more than $5,000";
}

relation employer_files_return_for_401a_organization(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization is described in section 401(a) and the employer who established it files such a return";
}

@source(IRC_S6043_B, relation = formalizes, coverage = exact, quote = "no return shall be required under this subsection from churches, their integrated auxiliaries, conventions or associations of churches")
rule S6043bChurchException strict {
    for org: Person;
    for y: TaxableYear;
    when church_or_auxiliary_6043b(org, y);
    then termination_return_excepted_6043b(org, y);
}

@source(IRC_S6043_B, relation = formalizes, coverage = exact, quote = "or any organization which is not a private foundation (as defined in section 509(a)) and the gross receipts of which in each taxable year are normally not more than $5,000")
rule S6043bSmallOrganizationException strict {
    for org: Person;
    for y: TaxableYear;
    when small_non_foundation_6043b(org, y);
    then termination_return_excepted_6043b(org, y);
}

@source(IRC_S6043_B, relation = formalizes, coverage = exact, quote = "with respect to an organization described in section 401(a), where the employer who established such organization files such a return.")
rule S6043bEmployerFilesException strict {
    for org: Person;
    for y: TaxableYear;
    when employer_files_return_for_401a_organization(org, y);
    then termination_return_excepted_6043b(org, y);
}

external judgment relation secretary_determines_termination_return_unnecessary(org: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary determines that the section 6043(b) filing is not necessary to the efficient administration of the internal revenue laws (DECISION-0194: committed to the Secretary by the text)";
}

relation secretary_exercises_termination_return_relief_6043b(secretary: Organ, org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary relieves the organization from the termination return (the exercise)";
}

relation termination_return_relief_6043b_in_effect(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the relief is in force (effect of the power)";
}

relation termination_return_relief_6043b(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "computational twin of the relief power (E-0134)";
}

@source(IRC_S6043_B, relation = formalizes, coverage = exact, quote = "the Secretary may relieve any organization from such filing where he determines that such filing is not necessary to the efficient administration of the internal revenue laws")
rule S6043TerminationReturnRelief6043bPowerTwin strict {
    for org: Person;
    for y: TaxableYear;
    when secretary_determines_termination_return_unnecessary(org, y);
    when secretary_exercises_termination_return_relief_6043b(us.irc.core::Secretary, org, y);
    then termination_return_relief_6043b(org, y);
}

@source(IRC_S6043_B, relation = formalizes, coverage = exact, quote = "the Secretary may relieve any organization from such filing where he determines that such filing is not necessary to the efficient administration of the internal revenue laws")
rule S6043TerminationReturnRelief6043bPower defeasible {
    for org: Person;
    for y: TaxableYear;
    when org_liquidated_dissolved_terminated_or_contracted(org, y);
    then power SecretaryRelievesFromTerminationReturn {
        holder us.irc.core::Secretary; over org;
        exercise secretary_exercises_termination_return_relief_6043b(us.irc.core::Secretary, org, y);
        valid_when secretary_determines_termination_return_unnecessary(org, y);
        effect create(termination_return_relief_6043b_in_effect(org, y));
        window [-infinity, infinity];
    };
}

@source(IRC_S6043_B, relation = formalizes, coverage = exact, quote = "the Secretary may relieve any organization from such filing")
rule S6043bSecretaryReliefException strict {
    for org: Person;
    for y: TaxableYear;
    when termination_return_relief_6043b(org, y);
    then termination_return_excepted_6043b(org, y);
}

relation control_of_corporation_acquired_6043c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "control (section 304(c)(1)) of the corporation is acquired by any person or group in a transaction or series of related transactions";
}

relation recapitalization_or_substantial_capital_change_6043c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "there is a recapitalization of the corporation or other substantial change in its capital structure";
}

relation secretary_requires_control_change_return_6043c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary requires a section 6043(c) return for the transaction";
}

@source(IRC_S6043_C, relation = formalizes, coverage = exact, quote = "such corporation shall make a return (at such time and in such manner as the Secretary may prescribe) setting forth the identity of the parties to the transaction, the fees involved, the changes in the capital structure involved, and such other information as the Secretary may require with respect to such transaction.")
rule S6043cControlOrCapitalChangeReturnDuty defeasible {
    for c: Person;
    for y: TaxableYear;
    when (control_of_corporation_acquired_6043c(c, y) or recapitalization_or_substantial_capital_change_6043c(c, y));
    when secretary_requires_control_change_return_6043c(c, y);
    then duty MakeControlOrCapitalChangeReturn {
        bearer c;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(c, Secretary, y, ControlOrCapitalStructureReturn6043C);
            window [-infinity, infinity];
        }
    };
    then information_return_required(c, Secretary, y, ControlOrCapitalStructureReturn6043C);
}

@source(IRC_S6043_C, relation = formalizes, coverage = partial, quote = "setting forth the identity of the parties to the transaction, the fees involved, the changes in the capital structure involved")
rule S6043cReturnContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ControlOrCapitalStructureReturn6043C);
    then required_return_item(filer, y, ControlOrCapitalStructureReturn6043C, I6043_IdentityOfPartiesToTransaction);
    then required_return_item(filer, y, ControlOrCapitalStructureReturn6043C, I6043_FeesInvolved);
    then required_return_item(filer, y, ControlOrCapitalStructureReturn6043C, I6043_ChangesInCapitalStructure);
}

// ============================================================================
// §6043A — returns relating to taxable acquisitions
// ============================================================================

relation acquisition_of_stock_or_property_of_corporation(acquirer: Person, acquired: Person, y: TaxableYear) kind empirical {
    label en unofficial "a corporation acquires stock in or property of another corporation during the calendar year";
}

relation shareholder_required_to_recognize_gain(shareholder: Person, acquired: Person, y: TaxableYear) kind empirical {
    label en unofficial "the shareholder of the acquired corporation is required to recognize gain, if any, as a result of the acquisition";
}

relation taxable_acquisition(acquirer: Person, acquired: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6043A(c): an acquisition in which any shareholder of the acquired corporation is required to recognize gain";
}

@source(IRC_S6043A_C, relation = formalizes, coverage = exact, quote = "means any acquisition by a corporation of stock in or property of another corporation if any shareholder of the acquired corporation is required to recognize gain (if any) as a result of such acquisition.")
rule S6043ATaxableAcquisitionDefinition strict {
    for acquirer: Person;
    for acquired: Person;
    for shareholder: Person;
    for y: TaxableYear;
    when acquisition_of_stock_or_property_of_corporation(acquirer, acquired, y);
    when shareholder_required_to_recognize_gain(shareholder, acquired, y);
    then taxable_acquisition(acquirer, acquired, y);
}

relation nominee_holds_acquired_stock_for(nominee: Person, holder: Person, acquired: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person holds stock of the acquired corporation as a nominee for another person";
}

relation stock_held_through_nominee_6043a(holder: Person, acquired: Person, y: TaxableYear) kind institutional {
    label en unofficial "the beneficial holder has a nominee for the stock";
}

@source(IRC_S6043A_B, relation = formalizes, coverage = exact, quote = "Any person who holds stock as a nominee for another person")
rule S6043AHolderHasNominee strict {
    for nominee: Person;
    for holder: Person;
    for acquired: Person;
    for y: TaxableYear;
    when nominee_holds_acquired_stock_for(nominee, holder, acquired, y);
    then stock_held_through_nominee_6043a(holder, acquired, y);
}

relation reporting_shareholder_6043a(shareholder: Person, acquired: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person is the shareholder named in the return and statement: the shareholder itself, or its nominee for stock held by a nominee (section 6043A(b)(2))";
}

@source(IRC_S6043A_A, relation = formalizes, coverage = exact, quote = "the name and address of each shareholder of the acquired corporation who is required to recognize gain (if any) as a result of the acquisition,")
rule S6043AReportingShareholderDirect defeasible {
    for shareholder: Person;
    for acquired: Person;
    for y: TaxableYear;
    when shareholder_required_to_recognize_gain(shareholder, acquired, y);
    when not_known(stock_held_through_nominee_6043a(shareholder, acquired, y));
    then reporting_shareholder_6043a(shareholder, acquired, y);
}

@source(IRC_S6043A_B, relation = formalizes, coverage = exact, quote = "In the case of stock held by any person as a nominee, references in this section (other than in subsection (c)) to a shareholder shall be treated as a reference to the nominee.")
rule S6043AReportingShareholderNominee defeasible {
    for nominee: Person;
    for holder: Person;
    for acquired: Person;
    for y: TaxableYear;
    when nominee_holds_acquired_stock_for(nominee, holder, acquired, y);
    when shareholder_required_to_recognize_gain(holder, acquired, y);
    then reporting_shareholder_6043a(nominee, acquired, y);
}

relation acquired_corporation_reporting_shift_6043a(acquirer: Person, acquired: Person, y: TaxableYear) kind institutional {
    label en unofficial "computational twin of the Secretary's power to place the section 6043A requirements on the acquired corporation instead of the acquiring corporation";
}

relation secretary_exercises_acquired_corporation_reporting_shift_6043a_x(secretary: Organ, acquirer: Person, acquired: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary provides that the acquired corporation makes the return instead (the exercise)";
}

relation acquired_corporation_reporting_shift_6043a_x_in_effect(acquirer: Person, acquired: Person, y: TaxableYear) kind institutional {
    label en unofficial "the shift is in force (effect)";
}

relation acquired_corporation_reporting_shift_6043a_x(acquirer: Person, acquired: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the shift power (E-0134)";
}

@source(IRC_S6043A_A, relation = formalizes, coverage = exact, quote = "To the extent provided by the Secretary, the requirements of this section applicable to the acquiring corporation shall be applicable to the acquired corporation and not to the acquiring corporation.")
rule S6043AAcquiredCorporationReportingShift6043aXPowerTwin strict {
    for acquirer: Person;
    for acquired: Person;
    for y: TaxableYear;
    when taxable_acquisition(acquirer, acquired, y);
    when secretary_exercises_acquired_corporation_reporting_shift_6043a_x(us.irc.core::Secretary, acquirer, acquired, y);
    then acquired_corporation_reporting_shift_6043a_x(acquirer, acquired, y);
}

@source(IRC_S6043A_A, relation = formalizes, coverage = exact, quote = "To the extent provided by the Secretary, the requirements of this section applicable to the acquiring corporation shall be applicable to the acquired corporation and not to the acquiring corporation.")
rule S6043AAcquiredCorporationReportingShift6043aXPower defeasible {
    for acquirer: Person;
    for acquired: Person;
    for y: TaxableYear;
    when acquisition_of_stock_or_property_of_corporation(acquirer, acquired, y);
    then power SecretaryShiftsTaxableAcquisitionReporting {
        holder us.irc.core::Secretary; over acquired;
        exercise secretary_exercises_acquired_corporation_reporting_shift_6043a_x(us.irc.core::Secretary, acquirer, acquired, y);
        valid_when taxable_acquisition(acquirer, acquired, y);
        effect create(acquired_corporation_reporting_shift_6043a_x_in_effect(acquirer, acquired, y));
        window [-infinity, infinity];
    };
}

relation return_shifted_to_acquired_corporation_6043a(acquirer: Person, shareholder: Person, y: TaxableYear) kind institutional {
    label en unofficial "the acquiring corporation's reporting for this shareholder is placed on the acquired corporation";
}

@source(IRC_S6043A_A, relation = formalizes, coverage = exact, quote = "shall be applicable to the acquired corporation and not to the acquiring corporation.")
rule S6043AShiftedReportingApplies defeasible {
    for acquirer: Person;
    for acquired: Person;
    for shareholder: Person;
    for y: TaxableYear;
    when acquired_corporation_reporting_shift_6043a_x(acquirer, acquired, y);
    when reporting_shareholder_6043a(shareholder, acquired, y);
    then return_shifted_to_acquired_corporation_6043a(acquirer, shareholder, y);
}

@source(IRC_S6043A_A, relation = formalizes, coverage = exact, quote = "the acquiring corporation in any taxable acquisition shall make a return setting forth—")
rule S6043AAcquiringCorporationReturnDuty defeasible {
    for acquirer: Person;
    for acquired: Person;
    for shareholder: Person;
    for y: TaxableYear;
    when taxable_acquisition(acquirer, acquired, y);
    when reporting_shareholder_6043a(shareholder, acquired, y);
    then duty MakeTaxableAcquisitionReturn {
        bearer acquirer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(acquirer, shareholder, y, TaxableAcquisitionReturn6043A);
            window [-infinity, infinity];
        }
    };
    then information_return_required(acquirer, shareholder, y, TaxableAcquisitionReturn6043A);
    unless return_shifted_to_acquired_corporation_6043a(acquirer, shareholder, y);
}

@source(IRC_S6043A_A, relation = formalizes, coverage = exact, quote = "shall be applicable to the acquired corporation and not to the acquiring corporation.")
rule S6043AAcquiredCorporationReturnDuty defeasible {
    for acquirer: Person;
    for acquired: Person;
    for shareholder: Person;
    for y: TaxableYear;
    when return_shifted_to_acquired_corporation_6043a(acquirer, shareholder, y);
    when reporting_shareholder_6043a(shareholder, acquired, y);
    then duty MakeTaxableAcquisitionReturnAsAcquiredCorporation {
        bearer acquired;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(acquired, shareholder, y, TaxableAcquisitionReturn6043A);
            window [-infinity, infinity];
        }
    };
    then information_return_required(acquired, shareholder, y, TaxableAcquisitionReturn6043A);
}

@source(IRC_S6043A_A, relation = formalizes, coverage = exact, quote = "a description of the acquisition,")
rule S6043AReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, TaxableAcquisitionReturn6043A);
    then required_return_item(payer, y, TaxableAcquisitionReturn6043A, I6043A_DescriptionOfAcquisition);
    then required_return_item(payer, y, TaxableAcquisitionReturn6043A, I6043A_ShareholderNameAndAddress);
    then required_return_item(payer, y, TaxableAcquisitionReturn6043A, I6043A_MoneyAndPropertyTransferredToShareholder);
    then required_return_item(payer, y, TaxableAcquisitionReturn6043A, I6043A_OtherInformationAsPrescribed);
}

relation nominee_forwarded_6043a_information(nominee: Person, holder: Person, acquired: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the nominee furnished the other person the information provided by the corporation under section 6043A(d)";
}

@source(IRC_S6043A_B, relation = formalizes, coverage = exact, quote = "shall furnish in the manner prescribed by the Secretary to such other person the information provided by the corporation under subsection (d).")
rule S6043ANomineeForwardsInformationDuty defeasible {
    for nominee: Person;
    for holder: Person;
    for acquired: Person;
    for y: TaxableYear;
    when nominee_holds_acquired_stock_for(nominee, holder, acquired, y);
    then duty ForwardTaxableAcquisitionInformationToHolder {
        bearer nominee;
        beneficiary holder;
        goal achievement {
            condition nominee_forwarded_6043a_information(nominee, holder, acquired, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6043A_D, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the shareholder on or before January 31 of the year following the calendar year during which the taxable acquisition occurred.")
rule S6043AStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, TaxableAcquisitionReturn6043A);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, TaxableAcquisitionReturn6043A, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6043A_D, relation = formalizes, coverage = exact, quote = "every person required to make a return under subsection (a) shall furnish to each shareholder whose name is required to be set forth in such return a written statement showing—")
rule S6043AStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, TaxableAcquisitionReturn6043A);
    when us.irc.core::ends(y, end_date);
    then duty FurnishTaxableAcquisitionStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, TaxableAcquisitionReturn6043A);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, TaxableAcquisitionReturn6043A);
}

@source(IRC_S6043A_D, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return,")
rule S6043AStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, TaxableAcquisitionReturn6043A);
    then required_statement_item(payer, y, TaxableAcquisitionReturn6043A, I6043A_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, TaxableAcquisitionReturn6043A, I6043A_InformationShownOnReturnForThisShareholder);
    then required_statement_item(payer, y, TaxableAcquisitionReturn6043A, I6043A_OtherInformationAsPrescribed);
}

// ============================================================================
// §6044 — patronage dividends: amounts, exceptions, exemption, valuation, statements
// ============================================================================

relation patronage_dividend_paid_in_money_qwna_or_property(coop: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 6044(b)(1)(A): a patronage dividend (section 1388(a)) paid in money, qualified written notices of allocation or other property (not nonqualified notices)";
}

relation nonpatronage_distribution_by_farmers_coop(coop: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 6044(b)(1)(B): an amount described in section 1382(c)(2)(A) paid in money, qualified notices or other property by a section 521 organization";
}

relation redemption_of_nonqualified_notices(coop: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 6044(b)(1)(C): an amount described in section 1382(b)(2), or for a section 1381(a)(1) organization an amount described in section 1382(c)(2)(B)";
}

relation per_unit_retain_allocation_in_qualified_certificates(coop: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 6044(b)(1)(D): a per-unit retain allocation (section 1388(f)) paid in qualified per-unit retain certificates (section 1388(h))";
}

relation redemption_of_nonqualified_per_unit_retain_certificates(coop: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 6044(b)(1)(E): an amount described in section 1382(b)(4)";
}

relation amount_described_in_6044b(coop: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the amount is subject to reporting under section 6044(a) (definition, section 6044(b)(1))";
}

@source(IRC_S6044_B, relation = formalizes, coverage = exact, quote = "any patronage dividend (as defined in section 1388(a)) which is paid in money")
rule S6044bAmountCategoryA strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when patronage_dividend_paid_in_money_qwna_or_property(coop, payee, y, amount);
    then amount_described_in_6044b(coop, payee, y, amount);
}

@source(IRC_S6044_B, relation = formalizes, coverage = exact, quote = "any amount described in section 1382(c)(2)(A) (relating to certain nonpatronage distributions)")
rule S6044bAmountCategoryB strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when nonpatronage_distribution_by_farmers_coop(coop, payee, y, amount);
    then amount_described_in_6044b(coop, payee, y, amount);
}

@source(IRC_S6044_B, relation = formalizes, coverage = exact, quote = "any amount described in section 1382(b)(2) (relating to redemption of nonqualified written notices of allocation)")
rule S6044bAmountCategoryC strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when redemption_of_nonqualified_notices(coop, payee, y, amount);
    then amount_described_in_6044b(coop, payee, y, amount);
}

@source(IRC_S6044_B, relation = formalizes, coverage = exact, quote = "the amount of any per-unit retain allocation (as defined in section 1388(f))")
rule S6044bAmountCategoryD strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when per_unit_retain_allocation_in_qualified_certificates(coop, payee, y, amount);
    then amount_described_in_6044b(coop, payee, y, amount);
}

@source(IRC_S6044_B, relation = formalizes, coverage = exact, quote = "any amount described in section 1382(b)(4)")
rule S6044bAmountCategoryE strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when redemption_of_nonqualified_per_unit_retain_certificates(coop, payee, y, amount);
    then amount_described_in_6044b(coop, payee, y, amount);
}

@source(IRC_S6044_B, relation = formalizes, coverage = partial, quote = "the amounts subject to reporting under subsection (a) are—")
rule S6044bAmountBridgeFromAssertedPayment strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when patronage_dividend_payment(coop, payee, y, amount);
    then amount_described_in_6044b(coop, payee, y, amount);
}

relation regulation_excepts_patronage_payment_6044b2(coop: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: a Secretary regulation excepts the payment (paid by a foreign corporation, or to a foreign corporation, nonresident alien or foreign partnership) from section 6044(a)";
}

relation coop_is_foreign_corporation_6044(coop: Person) kind institutional {
    label en unofficial "the cooperative is a foreign corporation";
}

relation payee_is_foreign_or_nonresident_6044(payee: Person) kind institutional {
    label en unofficial "the payee is a foreign corporation, a nonresident alien, or a partnership not engaged in a United States trade or business composed in whole or in part of nonresident aliens";
}

@source(IRC_S6044_B, relation = formalizes, coverage = exact, quote = "by a foreign corporation, or")
rule S6044bExceptionForeignCooperative strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    when coop_is_foreign_corporation_6044(coop);
    when regulation_excepts_patronage_payment_6044b2(coop, payee, y);
    then patronage_dividend_excepted(coop, payee, y);
}

@source(IRC_S6044_B, relation = formalizes, coverage = exact, quote = "to a foreign corporation, a nonresident alien, or a partnership not engaged in trade or business in the United States and composed in whole or in part of nonresident aliens.")
rule S6044bExceptionForeignPayee strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_is_foreign_or_nonresident_6044(payee);
    when regulation_excepts_patronage_payment_6044b2(coop, payee, y);
    then patronage_dividend_excepted(coop, payee, y);
}

external judgment relation secretary_determines_coop_primarily_retail_consumer(coop: Person) {
    authority Secretary;
    label en unofficial "the Secretary determines that the cooperative is primarily engaged in selling at retail goods or services of a type generally for personal, living or family use (DECISION-0194)";
}

relation coop_applies_for_6044c_exemption(coop: Person) kind empirical {
    label en unofficial "the cooperative applies to the Secretary for exemption under section 6044(c)";
}

relation secretary_exercises_consumer_cooperative_exemption_6044c(secretary: Organ, coop: Person) kind empirical {
    label en unofficial "the Secretary grants the consumer cooperative exemption on application (the exercise)";
}

relation consumer_cooperative_exemption_6044c_in_effect(coop: Person) kind institutional {
    label en unofficial "the exemption is in force (effect)";
}

relation consumer_cooperative_exemption_6044c(coop: Person) kind institutional {
    label en unofficial "twin of the exemption power (E-0134)";
}

@source(IRC_S6044_C, relation = formalizes, coverage = exact, quote = "shall, upon application to the Secretary, be granted exemption from the reporting requirements imposed by subsection (a).")
rule S6044ConsumerCooperativeExemption6044cPowerTwin strict {
    for coop: Person;
    when secretary_determines_coop_primarily_retail_consumer(coop);
    when secretary_exercises_consumer_cooperative_exemption_6044c(us.irc.core::Secretary, coop);
    then consumer_cooperative_exemption_6044c(coop);
}

@source(IRC_S6044_C, relation = formalizes, coverage = exact, quote = "shall, upon application to the Secretary, be granted exemption from the reporting requirements imposed by subsection (a).")
rule S6044ConsumerCooperativeExemption6044cPower defeasible {
    for coop: Person;
    when coop_applies_for_6044c_exemption(coop);
    then power SecretaryGrantsConsumerCooperativeExemption {
        holder us.irc.core::Secretary; over coop;
        exercise secretary_exercises_consumer_cooperative_exemption_6044c(us.irc.core::Secretary, coop);
        valid_when secretary_determines_coop_primarily_retail_consumer(coop);
        effect create(consumer_cooperative_exemption_6044c_in_effect(coop));
        window [-infinity, infinity];
    };
}

@source(IRC_S6044_C, relation = formalizes, coverage = exact, quote = "be granted exemption from the reporting requirements imposed by subsection (a).")
rule S6044cExemptionExcepts strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when consumer_cooperative_exemption_6044c(coop);
    when patronage_dividend_payment(coop, payee, y, amount);
    then patronage_dividend_excepted(coop, payee, y);
}

pub enum PatronageComponentKind {
    PropertyOtherThanQualifiedInstruments;
    QualifiedWrittenNoticeOfAllocation;
    QualifiedPerUnitRetainCertificate;
}

relation patronage_component(coop: Person, payee: Person, y: TaxableYear, component: PatronageComponentKind, stated_amount: Money, fair_market_value: Money) kind empirical {
    label en unofficial "a component of the payment: the instrument, its stated dollar amount and its fair market value";
}

relation patronage_component_amount(coop: Person, payee: Person, y: TaxableYear, component: PatronageComponentKind, amount: Money) kind institutional {
    label en unofficial "the amount of the component taken into account in determining the payment (section 6044(d))";
}

@source(IRC_S6044_D, relation = formalizes, coverage = exact, quote = "property (other than a qualified written notice of allocation or a qualified per-unit retain certificate) shall be taken into account at its fair market value, and")
rule S6044dPropertyAtFairMarketValue strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for stated: Money;
    for fmv: Money;
    when patronage_component(coop, payee, y, PropertyOtherThanQualifiedInstruments, stated, fmv);
    then patronage_component_amount(coop, payee, y, PropertyOtherThanQualifiedInstruments, fmv);
}

@source(IRC_S6044_D, relation = formalizes, coverage = exact, quote = "a qualified written notice of allocation or a qualified per-unit retain certificate shall be taken into account at its stated dollar amount.")
rule S6044dQualifiedNoticeAtStatedAmount strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for stated: Money;
    for fmv: Money;
    when patronage_component(coop, payee, y, QualifiedWrittenNoticeOfAllocation, stated, fmv);
    then patronage_component_amount(coop, payee, y, QualifiedWrittenNoticeOfAllocation, stated);
}

@source(IRC_S6044_D, relation = formalizes, coverage = exact, quote = "a qualified written notice of allocation or a qualified per-unit retain certificate shall be taken into account at its stated dollar amount.")
rule S6044dQualifiedRetainCertificateAtStatedAmount strict {
    for coop: Person;
    for payee: Person;
    for y: TaxableYear;
    for stated: Money;
    for fmv: Money;
    when patronage_component(coop, payee, y, QualifiedPerUnitRetainCertificate, stated, fmv);
    then patronage_component_amount(coop, payee, y, QualifiedPerUnitRetainCertificate, stated);
}

@source(IRC_S6044_E, relation = formalizes, coverage = exact, quote = "to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made")
rule S6044StatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, PatronageDividends6044);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, PatronageDividends6044, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6044_E, relation = formalizes, coverage = exact, quote = "Every cooperative required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6044StatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, PatronageDividends6044);
    when us.irc.core::ends(y, end_date);
    then duty FurnishPatronageDividendStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, PatronageDividends6044);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, PatronageDividends6044);
}

@source(IRC_S6044_E, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the cooperative required to make such return, and")
rule S6044StatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PatronageDividends6044);
    then required_statement_item(payer, y, PatronageDividends6044, I6044_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, PatronageDividends6044, I6044_AggregateAmountOfPaymentsToPerson);
}
