// §6033 — returns by exempt organizations (STAGE 2, all subsections), plus
// the Pub. L. 119-21 §70415 addition (§6033(o) student counts), of package
// `us.irc.information_reporting`, module 11.
//
// JUDGMENT CALLS
//  - The stage-1 finding stands: the pinned §6033(a)(3)(A)(ii) threshold is
//    $5,000; the $50,000 e-Postcard figure is the Secretary's own
//    §6033(i) notification threshold (Rev. Proc. 2011-15, not pinned).
//  - Return content is modelled as `required_return_item` conclusions keyed
//    on the annual return (`ExemptOrganizationAnnualReturn6033`); items that
//    the text conditions ((b)(8) §501(h), (b)(15) §501(r), (b) last sentence
//    §4911(f), (k), (l), (m), (h), (f)) carry their condition as a relation.
//  - The §6033(e)(2)(A) tax reads the highest §11 rate as a case fact
//    (`highest_section_11_rate_for_year`): the corporate-rate owner has no
//    `pub` for a rate without a corporation (DECISIONS Д-11).
//  - §6033(j) consecutive-year counting uses `us.irc.core::calendar_year_of`
//    (calendar-year filers only; fiscal years are TECH-GAPS G2407).
//  - The §6033(a)(3)(B), (e)(2)(B), (g)(4), (j)(3) discretions are `power`s
//    with a judgment relation (DECISION-0194) and a computational twin.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6033_A,
    IRC_S6033_B,
    IRC_S6033_C,
    IRC_S6033_D,
    IRC_S6033_E,
    IRC_S6033_F,
    IRC_S6033_G,
    IRC_S6033_H,
    IRC_S6033_I,
    IRC_S6033_J,
    IRC_S6033_K,
    IRC_S6033_L,
    IRC_S6033_M,
    IRC_S6033_N,
    InformationReturnKind,
    Organ,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    Trust,
    exempt_from_501a_annual_return,
    filed_information_return,
    gross_receipts_normally_not_more_than_5000,
    information_return_required,
    is_501a_exempt_organization,
    required_return_item,
    trust_described_in_4947a1,
};

// ============================================================================
// §6033(a) — annual return; prohibited tax shelter disclosure; exceptions
// ============================================================================

relation entity_party_to_prohibited_tax_shelter_transaction(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the tax-exempt entity (section 4965(c)) is a party to a prohibited tax shelter transaction (section 4965(e)) in the year";
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "Every tax-exempt entity described in section 4965(c) shall file (in such form and manner and at such time as determined by the Secretary) a disclosure of—")
rule S6033a2DisclosureDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when entity_party_to_prohibited_tax_shelter_transaction(filer, y);
    then duty FileProhibitedTaxShelterDisclosure {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, ProhibitedTaxShelterDisclosure6033A2);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, ProhibitedTaxShelterDisclosure6033A2);
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "such entity's being a party to any prohibited tax shelter transaction (as defined in section 4965(e)), and")
rule S6033a2DisclosureContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ProhibitedTaxShelterDisclosure6033A2);
    then required_return_item(filer, y, ProhibitedTaxShelterDisclosure6033A2, I6033_PartyToProhibitedTaxShelterTransaction);
    then required_return_item(filer, y, ProhibitedTaxShelterDisclosure6033A2, I6033_IdentityOfKnownOtherParty);
}

relation religious_organization_501c3(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "a religious organization described in section 501(c)(3)";
}

relation educational_organization_170b1Aii(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "an educational organization described in section 170(b)(1)(A)(ii)";
}

relation charitable_org_publicly_or_governmentally_supported(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "a charitable organization, or one for the prevention of cruelty to children or animals, described in section 501(c)(3), supported in whole or in part by funds contributed by the United States or a State or political subdivision, or primarily supported by contributions of the general public";
}

relation org_501c3_controlled_by_religious_organization(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "a section 501(c)(3) organization operated, supervised, or controlled by or in connection with a religious organization described in clause (i)";
}

relation org_described_in_501c8(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "an organization described in section 501(c)(8)";
}

relation wholly_owned_us_corporation_501c1(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "a section 501(c)(1) corporation wholly owned by the United States or an agency or instrumentality, or a wholly-owned subsidiary of such a corporation";
}

relation organization_described_in_6033a3C(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(a)(3)(C): one of the organizations to which the small-receipts exception can apply";
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "a religious organization described in section 501(c)(3);")
rule S6033a3COrganizationList1 strict {
    for org: Person;
    for y: TaxableYear;
    when religious_organization_501c3(org, y);
    then organization_described_in_6033a3C(org, y);
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "an educational organization described in section 170(b)(1)(A)(ii);")
rule S6033a3COrganizationList2 strict {
    for org: Person;
    for y: TaxableYear;
    when educational_organization_170b1Aii(org, y);
    then organization_described_in_6033a3C(org, y);
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "is supported, in whole or in part, by funds contributed by the United States or any State or political subdivision thereof, or is primarily supported by contributions of the general public;")
rule S6033a3COrganizationList3 strict {
    for org: Person;
    for y: TaxableYear;
    when charitable_org_publicly_or_governmentally_supported(org, y);
    then organization_described_in_6033a3C(org, y);
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "an organization described in section 501(c)(3), if such organization is operated, supervised, or controlled by or in connection with a religious organization described in clause (i);")
rule S6033a3COrganizationList4 strict {
    for org: Person;
    for y: TaxableYear;
    when org_501c3_controlled_by_religious_organization(org, y);
    then organization_described_in_6033a3C(org, y);
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "an organization described in section 501(c)(8); and")
rule S6033a3COrganizationList5 strict {
    for org: Person;
    for y: TaxableYear;
    when org_described_in_501c8(org, y);
    then organization_described_in_6033a3C(org, y);
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "an organization described in section 501(c)(1), if such organization is a corporation wholly owned by the United States or any agency or instrumentality thereof, or a wholly-owned subsidiary of such a corporation.")
rule S6033a3COrganizationList6 strict {
    for org: Person;
    for y: TaxableYear;
    when wholly_owned_us_corporation_501c1(org, y);
    then organization_described_in_6033a3C(org, y);
}

relation normal_gross_receipts_6033(org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the organization's gross receipts in each taxable year are normally this amount";
}

relation org_is_private_foundation_509a(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is a private foundation as defined in section 509(a) (pending: exempt-organizations)";
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "any organization (other than a private foundation, as defined in section 509(a)) described in subparagraph (C), the gross receipts of which in each taxable year are normally not more than $5,000, or")
rule S6033a3ASmallOrganizationClassification defeasible {
    for org: Person;
    for y: TaxableYear;
    for amount: Money;
    when organization_described_in_6033a3C(org, y);
    when normal_gross_receipts_6033(org, y, amount);
    when amount <= 5000 USD;
    when not_known(org_is_private_foundation_509a(org, y));
    then gross_receipts_normally_not_more_than_5000(org, y);
}

external judgment relation secretary_determines_6033_filing_unnecessary(org: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary determines that the annual return filing is not necessary to the efficient administration of the internal revenue laws (DECISION-0194)";
}

relation org_described_in_509a3(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is a supporting organization described in section 509(a)(3) (pending: exempt-organizations)";
}

relation secretary_exercises_annual_return_relief_6033(secretary: Organ, org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary relieves the organization from filing the annual return (the exercise)";
}

relation annual_return_relief_6033_in_effect(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the relief is in force (effect)";
}

relation annual_return_relief_6033(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the relief power (E-0134)";
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "The Secretary may relieve any organization required under paragraph (1) (other than an organization described in section 509(a)(3)) to file an information return from filing such a return where he determines that such filing is not necessary to the efficient administration of the internal revenue laws.")
rule S6033AnnualReturnRelief6033PowerTwin strict {
    for org: Person;
    for y: TaxableYear;
    when secretary_determines_6033_filing_unnecessary(org, y);
    when secretary_exercises_annual_return_relief_6033(us.irc.core::Secretary, org, y);
    then annual_return_relief_6033(org, y);
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "The Secretary may relieve any organization required under paragraph (1) (other than an organization described in section 509(a)(3)) to file an information return from filing such a return where he determines that such filing is not necessary to the efficient administration of the internal revenue laws.")
rule S6033AnnualReturnRelief6033Power defeasible {
    for org: Person;
    for y: TaxableYear;
    when is_501a_exempt_organization(org, y);
    then power SecretaryRelievesFromAnnualReturn {
        holder us.irc.core::Secretary; over org;
        exercise secretary_exercises_annual_return_relief_6033(us.irc.core::Secretary, org, y);
        valid_when secretary_determines_6033_filing_unnecessary(org, y);
        effect create(annual_return_relief_6033_in_effect(org, y));
        window [-infinity, infinity];
    };
}

@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "The Secretary may relieve any organization required under paragraph (1) (other than an organization described in section 509(a)(3))")
rule S6033a3BReliefExemption defeasible {
    for org: Person;
    for y: TaxableYear;
    when annual_return_relief_6033(org, y);
    when not_known(org_described_in_509a3(org, y));
    then exempt_from_501a_annual_return(org, y);
}

// ============================================================================
// §6033(b) — information furnished by section 501(c)(3) organizations
// ============================================================================

relation org_described_in_501c3_6033(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is described in section 501(c)(3) (pending: exempt-organizations)";
}

relation treated_as_501c3_for_6033b(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is a section 501(c)(3) organization, or under subsection (d) is treated as one";
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "Every organization described in section 501(c)(3) which is subject to the requirements of subsection (a)")
rule S6033bIs501c3 strict {
    for org: Person;
    for y: TaxableYear;
    when org_described_in_501c3_6033(org, y);
    then treated_as_501c3_for_6033b(org, y);
}

relation section_501h_election_effective(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "an election under section 501(h) is effective for the organization for the taxable year";
}

relation section_501r_applies(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the requirements of section 501(r) apply to the organization for the taxable year";
}

relation section_4911f_applies(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4911(f) applies to the organization for the taxable year (affiliated group)";
}

relation org_furnished_6033b_information(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the organization furnished the section 6033(b) information";
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "shall furnish annually information, at such time and in such manner as the Secretary may by forms or regulations prescribe, setting forth—")
rule S6033bInformationDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    when treated_as_501c3_for_6033b(org, y);
    when information_return_required(org, Secretary, y, ExemptOrganizationAnnualReturn6033);
    then duty FurnishSection6033bInformation {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition org_furnished_6033b_information(org, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "its gross income for the year,")
rule S6033bIncomeExpensesDisbursements defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when treated_as_501c3_for_6033b(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_GrossIncomeForTheYear);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ExpensesAttributableToIncome);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_DisbursementsForExemptPurposes);
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "a balance sheet showing its assets, liabilities, and net worth as of the beginning of such year,")
rule S6033bBalanceContributorsManagers defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when treated_as_501c3_for_6033b(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_BalanceSheetAtYearStart);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ContributionsAndNamesOfSubstantialContributors);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_NamesOfFoundationManagersAndHighlyCompensatedEmployees);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_CompensationToManagersAndHighlyCompensatedEmployees);
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "the lobbying expenditures (as defined in section 4911(c)(1)),")
rule S6033bLobbyingAmounts defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when section_501h_election_effective(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_LobbyingExpenditures);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_LobbyingNontaxableAmount);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_GrassRootsExpenditures);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_GrassRootsNontaxableAmount);
}

@source(IRC_S6033_B, relation = formalizes, coverage = partial, quote = "such other information with respect to direct or indirect transfers to, and other direct or indirect transactions and relationships with, other organizations described in section 501(c) (other than paragraph (3) thereof) or section 527 as the Secretary may require to prevent—")
rule S6033bTransfersWithOtherOrganizations defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when treated_as_501c3_for_6033b(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_DiversionOfFundsPreventionInformation);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_MisallocationOfRevenuesOrExpensesPreventionInformation);
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "the respective amounts (if any) of the taxes imposed on the organization, or any organization manager of the organization, during the taxable year under any of the following provisions")
rule S6033bTaxesImposed defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when treated_as_501c3_for_6033b(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_Taxes4911);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_Taxes4912);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_Taxes4955ExceptSection4962Credited);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_Taxes4959);
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "the taxes imposed with respect to the organization on any organization manager, or any disqualified person, during the taxable year under section 4958")
rule S6033bSection4958Taxes defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when treated_as_501c3_for_6033b(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_Taxes4958OnManagersAndDisqualifiedPersons);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ReimbursementsOfSection4958Taxes);
}

@source(IRC_S6033_B, relation = formalizes, coverage = partial, quote = "such information as the Secretary may require with respect to any excess benefit transaction (as defined in section 4958),")
rule S6033bExcessBenefitDisqualifiedDisaster defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when treated_as_501c3_for_6033b(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ExcessBenefitTransactionInformation);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_DisqualifiedPersonInformation);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_DisasterReliefActivitiesInformation);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_OtherInformationRequiredBySecretary);
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "in the case of an organization to which the requirements of section 501(r) apply for the taxable year—")
rule S6033bHospitalInformation defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when section_501r_applies(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_CommunityHealthNeedsAssessmentAddressing);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_AuditedFinancialStatements);
}

@source(IRC_S6033_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (8), if section 4911(f) applies to the organization for the taxable year, such organization shall furnish the amounts with respect to the affiliated group as well as with respect to such organization.")
rule S6033bAffiliatedGroupAmounts defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when section_4911f_applies(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_AffiliatedGroupLobbyingAmounts);
}

// ============================================================================
// §6033(c), (d) — private foundations and section 4947 trusts
// ============================================================================

relation org_is_private_foundation_6033c(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is a private foundation within the meaning of section 509(a) (pending: exempt-organizations)";
}

relation foundation_manager_of(manager: Person, foundation: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person is a foundation manager (section 4946(b)(1)) of the foundation";
}

relation managers_furnished_return_copies_to_state_officials(manager: Person, foundation: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the manager furnished copies of the annual return to the State officials as prescribed";
}

@source(IRC_S6033_C, relation = formalizes, coverage = exact, quote = "the foundation managers shall furnish copies of the annual return under this section to such State officials, at such times, and under such conditions, as the Secretary may by regulations prescribe.")
rule S6033cManagersFurnishCopiesToStateOfficials defeasible {
    for manager: Person;
    for foundation: Person;
    for y: TaxableYear;
    when org_is_private_foundation_6033c(foundation, y);
    when foundation_manager_of(manager, foundation, y);
    when information_return_required(foundation, Secretary, y, ExemptOrganizationAnnualReturn6033);
    then duty FurnishAnnualReturnCopiesToStateOfficials {
        bearer manager;
        beneficiary manager;
        goal achievement {
            condition managers_furnished_return_copies_to_state_officials(manager, foundation, y);
            window [-infinity, infinity];
        }
    };
}

relation gift_to_indigent_recipient_aggregate(foundation: Person, recipient: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the foundation's charitable gifts or grants to the recipient as an indigent or needy person aggregate this amount during the year";
}

relation recipient_is_disqualified_person_4946(recipient: Person) kind institutional {
    label en unofficial "the recipient is a disqualified person within the meaning of section 4946";
}

relation recipient_name_and_address_not_required_6033c(foundation: Person, recipient: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(c) last sentence: the name and address of the recipient need not be included";
}

@source(IRC_S6033_C, relation = formalizes, coverage = exact, quote = "Nothing in paragraph (1) shall require the inclusion of the name and address of any recipient (other than a disqualified person within the meaning of section 4946) of 1 or more charitable gifts or grants made by the foundation to such recipient as an indigent or needy person if the aggregate of such gifts or grants made by the foundation to such recipient during the year does not exceed $1,000.")
rule S6033cIndigentRecipientNamesNotRequired defeasible {
    for foundation: Person;
    for recipient: Person;
    for y: TaxableYear;
    for amount: Money;
    when gift_to_indigent_recipient_aggregate(foundation, recipient, y, amount);
    when amount <= 1000 USD;
    when not_known(recipient_is_disqualified_person_4946(recipient));
    then recipient_name_and_address_not_required_6033c(foundation, recipient, y);
}

relation nonexempt_private_foundation_6033d(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "a private foundation which is not exempt from tax under section 501(a) (pending: exempt-organizations)";
}

relation treated_as_501c3_exempt_for_6033d(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(d): the organization complies with section 6033 as an exempt section 501(c)(3) organization";
}

@source(IRC_S6033_D, relation = formalizes, coverage = exact, quote = "A trust described in section 4947(a)(1) (relating to nonexempt charitable trusts).")
rule S6033dTrust4947a1 strict {
    for t: Trust;
    for y: TaxableYear;
    when trust_described_in_4947a1(t, y);
    then treated_as_501c3_exempt_for_6033d(t, y);
}

@source(IRC_S6033_D, relation = formalizes, coverage = exact, quote = "A private foundation which is not exempt from tax under section 501(a).")
rule S6033dNonexemptPrivateFoundation strict {
    for org: Person;
    for y: TaxableYear;
    when nonexempt_private_foundation_6033d(org, y);
    then treated_as_501c3_exempt_for_6033d(org, y);
}

@source(IRC_S6033_D, relation = formalizes, coverage = exact, quote = "shall comply with the requirements of this section in the same manner as organizations described in section 501(c)(3) which are exempt from tax under section 501(a):")
rule S6033dTreatedAs501c3ForItems strict {
    for org: Person;
    for y: TaxableYear;
    when treated_as_501c3_exempt_for_6033d(org, y);
    then treated_as_501c3_for_6033b(org, y);
}

relation filed_6033d_return(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the organization filed the section 6033 annual return";
}

@source(IRC_S6033_D, relation = formalizes, coverage = exact, quote = "shall comply with the requirements of this section in the same manner as organizations described in section 501(c)(3) which are exempt from tax under section 501(a):")
rule S6033dReturnDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    when treated_as_501c3_exempt_for_6033d(org, y);
    then duty FileAnnualReturnAsIfExemptOrganization6033d {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition filed_6033d_return(org, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(org, Secretary, y, ExemptOrganizationAnnualReturn6033);
}

// ============================================================================
// §6033(e) — lobbying activities: reporting, notice, tax
// ============================================================================

relation org_exempt_under_501_other_than_c3(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is exempt from taxation under section 501 other than an organization described in section 501(c)(3)";
}

relation section_6033e_applies(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(e) applies to the organization for the taxable year";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "This subsection shall apply to any organization which is exempt from taxation under section 501 other than an organization described in section 501(c)(3).")
rule S6033eApplicability strict {
    for org: Person;
    for y: TaxableYear;
    when org_exempt_under_501_other_than_c3(org, y);
    then section_6033e_applies(org, y);
}

relation in_house_expenditures_amount(org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the organization's in-house expenditures (section 162(e)(4)(B)(ii)) for the year, not counting overhead allocable to activities described in section 162(e)(1)(A) and (D)";
}

relation in_house_expenditures_outside_6033e(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(e)(1)(B)(ii): the subsection does not apply to the in-house expenditures (they do not exceed $2,000)";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to the in-house expenditures (within the meaning of section 162(e)(4)(B)(ii)) of an organization for a taxable year if such expenditures do not exceed $2,000.")
rule S6033eInHouseDeMinimis strict {
    for org: Person;
    for y: TaxableYear;
    for amount: Money;
    when in_house_expenditures_amount(org, y, amount);
    when amount <= 2000 USD;
    then in_house_expenditures_outside_6033e(org, y);
}

relation amount_taxed_under_527f(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the amount is one on which tax is imposed by reason of section 527(f)";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any amount on which tax is imposed by reason of section 527(f).")
rule S6033e527fCoordination strict {
    for org: Person;
    for y: TaxableYear;
    when amount_taxed_under_527f(org, y);
    then amount_outside_6033e_by_527f(org, y);
}

relation amount_outside_6033e_by_527f(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(e)(1)(B)(iii): the amount taxed under section 527(f) is outside the subsection";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "information setting forth the total expenditures of the organization to which section 162(e)(1) applies and the total amount of the dues or other similar amounts paid to the organization to which such expenditures are allocable")
rule S6033eReturnInformation defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when section_6033e_applies(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_TotalSection162e1Expenditures);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_TotalDuesAllocableToExpenditures);
}

relation dues_payment_to_organization(org: Person, payer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person pays dues or similar amounts to the organization for the year";
}

relation dues_notice_given(org: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the organization gave the payer notice with a reasonable estimate of the portion of the dues allocable to section 162(e)(1) expenditures";
}

relation org_elects_not_to_provide_notices(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization elects not to provide the notices described in paragraph (1)(A) for the taxable year";
}

external judgment relation org_establishes_dues_substantially_non_deductible(org: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the organization establishes to the satisfaction of the Secretary that substantially all of the dues or similar amounts are not deductible without regard to section 162(e) (DECISION-0194)";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "shall, at the time of assessment or payment of such dues or other similar amounts, provide notice to each person making such payment which contains a reasonable estimate of the portion of such dues or other similar amounts to which such expenditures are so allocable.")
rule S6033eDuesNoticeDuty defeasible {
    for org: Person;
    for payer: Person;
    for y: TaxableYear;
    for amount: Money;
    when section_6033e_applies(org, y);
    when dues_payment_to_organization(org, payer, y, amount);
    when not_known(org_elects_not_to_provide_notices(org, y));
    when not_known(org_establishes_dues_substantially_non_deductible(org, y));
    then duty ProvideDuesLobbyingNotice {
        bearer org;
        beneficiary payer;
        goal achievement {
            condition dues_notice_given(org, payer, y);
            window [-infinity, infinity];
        }
    };
}

relation section_162e1_expenditures_total(org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total expenditures of the organization to which section 162(e)(1) applies for the year";
}

relation dues_total_6033e(org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total dues and similar amounts paid to the organization for the year";
}

relation lobbying_expenditure_paid_out_of_dues(org: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6033(e)(1)(C)(i): the expenditures treated as paid out of dues, to the extent of the dues";
}

relation following_year_calendar(y: TaxableYear, next: TaxableYear) kind empirical {
    label en unofficial "the taxable year that follows";
}

relation lobbying_excess_carried_to_following_year(org: Person, next: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6033(e)(1)(C)(ii): the excess of expenditures over dues is treated as paid or incurred in the following taxable year";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "Expenditures to which section 162(e)(1) applies shall be treated as paid out of dues or other similar amounts to the extent thereof.")
rule S6033eExpenditurePaidOutOfDuesWithinDues strict {
    for org: Person;
    for y: TaxableYear;
    for e: Money;
    for d: Money;
    when section_162e1_expenditures_total(org, y, e);
    when dues_total_6033e(org, y, d);
    when e <= d;
    then lobbying_expenditure_paid_out_of_dues(org, y, e);
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "Expenditures to which section 162(e)(1) applies shall be treated as paid out of dues or other similar amounts to the extent thereof.")
rule S6033eExpenditurePaidOutOfDuesToDues strict {
    for org: Person;
    for y: TaxableYear;
    for e: Money;
    for d: Money;
    when section_162e1_expenditures_total(org, y, e);
    when dues_total_6033e(org, y, d);
    when e > d;
    then lobbying_expenditure_paid_out_of_dues(org, y, d);
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "such excess shall be treated as expenditures to which section 162(e)(1) applies which are paid or incurred by the organization during the following taxable year.")
rule S6033eCarryoverOfExcess strict {
    for org: Person;
    for y: TaxableYear;
    for next: TaxableYear;
    for e: Money;
    for d: Money;
    when section_162e1_expenditures_total(org, y, e);
    when dues_total_6033e(org, y, d);
    when e > d;
    when following_year_calendar(y, next);
    then lobbying_excess_carried_to_following_year(org, next, e - d);
}

relation amount_not_included_in_notices(org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount not included in the notices by reason of the election or the failure";
}

relation notices_omitted_actual_amount_by_failure(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization failed to include in the notices the amount allocable to section 162(e)(1) expenditures (on the basis of actual amounts rather than reasonable estimates)";
}

relation highest_section_11_rate_for_year(y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the highest rate of tax imposed by section 11 for the taxable year (pending: corporations; DECISIONS Д-11)";
}

relation lobbying_notice_tax_6033e2(org: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6033(e)(2)(A): the tax imposed on the organization for the year";
}

relation lobbying_notice_tax_waiver_condition(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization agrees to adjust its estimates under paragraph (1)(A)(ii) for the following taxable year to correct any failures";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "then there is hereby imposed on such organization for such taxable year a tax in an amount equal to the product of the highest rate of tax imposed by section 11 for the taxable year and the aggregate amount not included in such notices by reason of such election or failure.")
rule S6033e2AElectionTax defeasible {
    for org: Person;
    for y: TaxableYear;
    for amount: Money;
    for rate: Decimal;
    when section_6033e_applies(org, y);
    when org_elects_not_to_provide_notices(org, y);
    when amount_not_included_in_notices(org, y, amount);
    when highest_section_11_rate_for_year(y, rate);
    then lobbying_notice_tax_6033e2(org, y, amount * rate);
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "fails to include in such notices the amount allocable to expenditures to which section 162(e)(1) applies (determined on the basis of actual amounts rather than the reasonable estimates under paragraph (1)(A)(ii)),")
rule S6033e2AFailureTax defeasible {
    for org: Person;
    for y: TaxableYear;
    for amount: Money;
    for rate: Decimal;
    when section_6033e_applies(org, y);
    when notices_omitted_actual_amount_by_failure(org, y);
    when amount_not_included_in_notices(org, y, amount);
    when highest_section_11_rate_for_year(y, rate);
    when not_known(lobbying_notice_tax_waived_6033e2B(org, y));
    then lobbying_notice_tax_6033e2(org, y, amount * rate);
}

relation lobbying_notice_tax_waived_6033e2B(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "computational twin of the waiver power: the Secretary waived the section 6033(e)(2)(A)(ii) tax";
}

relation secretary_exercises_lobbying_notice_tax_waived_6033e2B_x(secretary: Organ, org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary waives the failure tax (the exercise)";
}

relation lobbying_notice_tax_waived_6033e2B_x_in_effect(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the waiver is in force (effect)";
}

relation lobbying_notice_tax_waived_6033e2B_x(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the waiver power (E-0134)";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "The Secretary may waive the tax imposed by subparagraph (A)(ii) for any taxable year if the organization agrees to adjust its estimates under paragraph (1)(A)(ii) for the following taxable year to correct any failures.")
rule S6033LobbyingNoticeTaxWaived6033e2bXPowerTwin strict {
    for org: Person;
    for y: TaxableYear;
    when lobbying_notice_tax_waiver_condition(org, y);
    when secretary_exercises_lobbying_notice_tax_waived_6033e2B_x(us.irc.core::Secretary, org, y);
    then lobbying_notice_tax_waived_6033e2B_x(org, y);
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "The Secretary may waive the tax imposed by subparagraph (A)(ii) for any taxable year if the organization agrees to adjust its estimates under paragraph (1)(A)(ii) for the following taxable year to correct any failures.")
rule S6033LobbyingNoticeTaxWaived6033e2bXPower defeasible {
    for org: Person;
    for y: TaxableYear;
    when notices_omitted_actual_amount_by_failure(org, y);
    then power SecretaryWaivesLobbyingNoticeFailureTax {
        holder us.irc.core::Secretary; over org;
        exercise secretary_exercises_lobbying_notice_tax_waived_6033e2B_x(us.irc.core::Secretary, org, y);
        valid_when lobbying_notice_tax_waiver_condition(org, y);
        effect create(lobbying_notice_tax_waived_6033e2B_x_in_effect(org, y));
        window [-infinity, infinity];
    };
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "The Secretary may waive the tax imposed by subparagraph (A)(ii) for any taxable year")
rule S6033e2BWaiverTwin strict {
    for org: Person;
    for y: TaxableYear;
    when lobbying_notice_tax_waived_6033e2B_x(org, y);
    then lobbying_notice_tax_waived_6033e2B(org, y);
}

relation lobbying_notice_tax_treated_as_chapter_1_tax(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(e)(2)(C): for the title, the tax is treated in the same manner as a tax imposed by chapter 1";
}

@source(IRC_S6033_E, relation = formalizes, coverage = exact, quote = "For purposes of this title, the tax imposed by subparagraph (A) shall be treated in the same manner as a tax imposed by chapter 1 (relating to income taxes).")
rule S6033e2CTaxTreatedAsChapter1 defeasible {
    for org: Person;
    for y: TaxableYear;
    for amount: Money;
    when lobbying_notice_tax_6033e2(org, y, amount);
    then lobbying_notice_tax_treated_as_chapter_1_tax(org, y);
}

// ============================================================================
// §6033(f)-(h), (k)-(n) — additional content by organization type; electronic filing
// ============================================================================

relation org_described_in_501c4(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is described in section 501(c)(4) (pending: exempt-organizations)";
}

relation first_return_after_506a_notice(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "this is the first return the organization files after submitting a notice to the Secretary under section 506(a)";
}

@source(IRC_S6033_F, relation = formalizes, coverage = exact, quote = "the information referred to in paragraphs (11), (12) and (13) of subsection (b) with respect to such organization, and")
rule S6033f501c4Information defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when org_described_in_501c4(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_Taxes4958OnManagersAndDisqualifiedPersons);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ExcessBenefitTransactionInformation);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_DisqualifiedPersonInformation);
}

@source(IRC_S6033_F, relation = formalizes, coverage = exact, quote = "such information as the Secretary shall by regulation require in support of the organization's treatment as an organization described in section 501(c)(4).")
rule S6033fFirstReturnSupportInformation defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when org_described_in_501c4(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_InformationSupportingSection501c4Treatment);
}

@source(IRC_S6033_F, relation = formalizes, coverage = exact, quote = "in the case of the first such return filed by such an organization after submitting a notice to the Secretary under section 506(a)")
rule S6033fFirstReturnSupportInformationCondition strict {
    for payer: Person;
    for y: TaxableYear;
    when first_return_after_506a_notice(payer, y);
    when org_described_in_501c4(payer, y);
    then first_return_support_information_applies_6033f(payer, y);
}

relation first_return_support_information_applies_6033f(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the first-return support information of section 6033(f)(2) applies";
}

relation controlling_organization_512b13(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is a controlling organization within the meaning of section 512(b)(13) (pending: exempt-organizations)";
}

@source(IRC_S6033_H, relation = formalizes, coverage = exact, quote = "any interest, annuities, royalties, or rents received from each controlled entity (within the meaning of section 512(b)(13)),")
rule S6033hControllingOrganizationItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when controlling_organization_512b13(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_InterestAnnuitiesRoyaltiesRentsFromControlledEntity);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_LoansToControlledEntity);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_TransfersOfFundsWithControlledEntity);
}

relation org_described_in_4966d1(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is a sponsoring organization described in section 4966(d)(1) (pending: exempt-organizations)";
}

@source(IRC_S6033_K, relation = formalizes, coverage = exact, quote = "list the total number of donor advised funds (as defined in section 4966(d)(2)) it owns at the end of such taxable year,")
rule S6033kSponsoringOrganizationItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when org_described_in_4966d1(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_TotalNumberOfDonorAdvisedFunds);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_AggregateValueOfAssetsInFunds);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_AggregateContributionsToAndGrantsFromFunds);
}

@source(IRC_S6033_L, relation = formalizes, coverage = exact, quote = "list the supported organizations (as defined in section 509(f)(3)) with respect to which such organization provides support,")
rule S6033lSupportingOrganizationItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when org_described_in_509a3(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ListOfSupportedOrganizations);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_WhichSection509a3BClauseMet);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_CertificationOfSection509a3CCompliance);
}

relation org_described_in_501c29(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is described in section 501(c)(29) (pending: exempt-organizations)";
}

@source(IRC_S6033_M, relation = formalizes, coverage = exact, quote = "An organization described in section 501(c)(29) shall include on the return required under subsection (a) the following information:")
rule S6033mQualifiedHealthPlanReserves defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ExemptOrganizationAnnualReturn6033);
    when org_described_in_501c29(payer, y);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ReservesRequiredByEachState);
    then required_return_item(payer, y, ExemptOrganizationAnnualReturn6033, I6033_ReservesOnHand);
}

relation filed_return_in_electronic_form(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the organization filed the section 6033 return in electronic form";
}

@source(IRC_S6033_N, relation = formalizes, coverage = exact, quote = "Any organization required to file a return under this section shall file such return in electronic form.")
rule S6033nElectronicFilingDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    when information_return_required(org, Secretary, y, ExemptOrganizationAnnualReturn6033);
    then duty FileSection6033ReturnInElectronicForm {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition filed_return_in_electronic_form(org, y);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6033(g) — political organizations
// ============================================================================

relation political_organization_gross_receipts(org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the political organization (section 527(e)(1)) has gross receipts of this amount for the taxable year";
}

relation qualified_state_or_local_political_org(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the political organization is a qualified State or local political organization (section 527(e)(5))";
}

relation section_6033g_applies(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033 applies to the political organization: gross receipts of $25,000 or more ($100,000 or more for a qualified State or local political organization)";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "This section shall apply to a political organization (as defined by section 527(e)(1)) which has gross receipts of $25,000 or more for the taxable year.")
rule S6033g1GeneralThreshold strict {
    for org: Person;
    for y: TaxableYear;
    for amount: Money;
    when political_organization_gross_receipts(org, y, amount);
    when amount >= 25000 USD;
    when not_known(qualified_state_or_local_political_org(org, y));
    then section_6033g_applies(org, y);
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "In the case of a political organization which is a qualified State or local political organization (as defined in section 527(e)(5)), the preceding sentence shall be applied by substituting \"$100,000\" for \"$25,000\".")
rule S6033g1QualifiedStateLocalThreshold strict {
    for org: Person;
    for y: TaxableYear;
    for amount: Money;
    when political_organization_gross_receipts(org, y, amount);
    when qualified_state_or_local_political_org(org, y);
    when amount >= 100000 USD;
    then section_6033g_applies(org, y);
}

relation state_local_party_or_candidate_committee(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "which is a State or local committee of a political party, or political committee of a State or local candidate";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "which is a State or local committee of a political party, or political committee of a State or local candidate,")
rule S6033g3ExceptionA strict {
    for org: Person;
    for y: TaxableYear;
    when state_local_party_or_candidate_committee(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation caucus_or_association_of_state_local_officials(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "which is a caucus or association of State or local officials";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "which is a caucus or association of State or local officials,")
rule S6033g3ExceptionB strict {
    for org: Person;
    for y: TaxableYear;
    when caucus_or_association_of_state_local_officials(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation authorized_committee_of_federal_candidate(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "which is an authorized committee (as defined in section 301(6) of the Federal Election Campaign Act of 1971) of a candidate for Federal office";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "which is an authorized committee (as defined in section 301(6) of the Federal Election Campaign Act of 1971) of a candidate for Federal office,")
rule S6033g3ExceptionC strict {
    for org: Person;
    for y: TaxableYear;
    when authorized_committee_of_federal_candidate(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation national_committee_of_political_party(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "which is a national committee (as defined in section 301(14) of the Federal Election Campaign Act of 1971) of a political party";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "which is a national committee (as defined in section 301(14) of the Federal Election Campaign Act of 1971) of a political party,")
rule S6033g3ExceptionD strict {
    for org: Person;
    for y: TaxableYear;
    when national_committee_of_political_party(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation house_or_senate_campaign_committee(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "which is a United States House of Representatives or United States Senate campaign committee of a political party committee";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "which is a United States House of Representatives or United States Senate campaign committee of a political party committee,")
rule S6033g3ExceptionE strict {
    for org: Person;
    for y: TaxableYear;
    when house_or_senate_campaign_committee(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation required_to_report_under_feca_as_political_committee(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "which is required to report under the Federal Election Campaign Act of 1971 as a political committee (as defined in section 301(4) of such Act), or";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "which is required to report under the Federal Election Campaign Act of 1971 as a political committee (as defined in section 301(4) of such Act), or")
rule S6033g3ExceptionF strict {
    for org: Person;
    for y: TaxableYear;
    when required_to_report_under_feca_as_political_committee(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation section_527_applies_solely_by_527f1(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "to which section 527 applies for the taxable year solely by reason of subsection (f)(1) of such section";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "to which section 527 applies for the taxable year solely by reason of subsection (f)(1) of such section.")
rule S6033g3ExceptionG strict {
    for org: Person;
    for y: TaxableYear;
    when section_527_applies_solely_by_527f1(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation political_org_return_excepted_6033g3(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6033(g)(3): the political organization is excepted from filing the paragraph (2) return";
}

external judgment relation secretary_determines_political_org_filing_unnecessary(org: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary determines that the political organization filing is not necessary to the efficient administration of the internal revenue laws (DECISION-0194)";
}

relation political_org_return_relief_candidate(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor: the political organization is required to file under paragraph (2) and relief is at issue";
}

relation secretary_exercises_political_org_return_relief_6033g4(secretary: Organ, org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary relieves the political organization from filing (the exercise)";
}

relation political_org_return_relief_6033g4_in_effect(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the relief is in force (effect)";
}

relation political_org_return_relief_6033g4(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the relief power (E-0134)";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "The Secretary may relieve any organization required under paragraph (2) to file an information return from filing such a return if the Secretary determines that such filing is not necessary to the efficient administration of the internal revenue laws.")
rule S6033PoliticalOrgReturnRelief6033g4PowerTwin strict {
    for org: Person;
    for y: TaxableYear;
    when secretary_determines_political_org_filing_unnecessary(org, y);
    when secretary_exercises_political_org_return_relief_6033g4(us.irc.core::Secretary, org, y);
    then political_org_return_relief_6033g4(org, y);
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "The Secretary may relieve any organization required under paragraph (2) to file an information return from filing such a return if the Secretary determines that such filing is not necessary to the efficient administration of the internal revenue laws.")
rule S6033PoliticalOrgReturnRelief6033g4Power defeasible {
    for org: Person;
    for y: TaxableYear;
    when political_org_return_relief_candidate(org, y);
    then power SecretaryRelievesPoliticalOrgFromReturn {
        holder us.irc.core::Secretary; over org;
        exercise secretary_exercises_political_org_return_relief_6033g4(us.irc.core::Secretary, org, y);
        valid_when secretary_determines_political_org_filing_unnecessary(org, y);
        effect create(political_org_return_relief_6033g4_in_effect(org, y));
        window [-infinity, infinity];
    };
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "from filing such a return if the Secretary determines that such filing is not necessary to the efficient administration of the internal revenue laws.")
rule S6033g4ReliefException strict {
    for org: Person;
    for y: TaxableYear;
    when political_org_return_relief_6033g4(org, y);
    then political_org_return_excepted_6033g3(org, y);
}

relation filed_political_org_return(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the political organization filed the annual return";
}

@source(IRC_S6033_G, relation = formalizes, coverage = exact, quote = "Political organizations described in paragraph (1) shall file an annual return—")
rule S6033g2PoliticalOrganizationReturnDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    when section_6033g_applies(org, y);
    then duty FilePoliticalOrganizationAnnualReturn {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition filed_political_org_return(org, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(org, Secretary, y, PoliticalOrganizationAnnualReturn6033G);
    unless political_org_return_excepted_6033g3(org, y);
}

// ============================================================================
// §6033(i) — additional notification requirements
// ============================================================================

relation org_in_notification_class_6033i(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization's gross receipts put it in section 6033(a)(3)(A)(ii) or (a)(3)(B): small-receipts exception or Secretary relief";
}

@source(IRC_S6033_I, relation = formalizes, coverage = exact, quote = "Any organization the gross receipts of which in any taxable year result in such organization being referred to in subsection (a)(3)(A)(ii) or (a)(3)(B)—")
rule S6033iSmallReceiptsClass defeasible {
    for org: Person;
    for y: TaxableYear;
    when gross_receipts_normally_not_more_than_5000(org, y);
    then org_in_notification_class_6033i(org, y);
}

@source(IRC_S6033_I, relation = formalizes, coverage = exact, quote = "Any organization the gross receipts of which in any taxable year result in such organization being referred to in subsection (a)(3)(A)(ii) or (a)(3)(B)—")
rule S6033iSecretaryReliefClass defeasible {
    for org: Person;
    for y: TaxableYear;
    when annual_return_relief_6033(org, y);
    then org_in_notification_class_6033i(org, y);
}

relation org_furnished_notification_info(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the organization furnished the annual electronic notification information";
}

@source(IRC_S6033_I, relation = formalizes, coverage = exact, quote = "shall furnish annually, in electronic form, and at such time and in such manner as the Secretary may by regulations prescribe, information setting forth—")
rule S6033iAnnualNotificationDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    when org_in_notification_class_6033i(org, y);
    then duty FurnishAnnualElectronicNotification {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition org_furnished_notification_info(org, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(org, Secretary, y, ExemptOrganizationNotification6033I);
}

@source(IRC_S6033_I, relation = formalizes, coverage = exact, quote = "the legal name of the organization,")
rule S6033iNotificationContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ExemptOrganizationNotification6033I);
    then required_return_item(filer, y, ExemptOrganizationNotification6033I, I6033_LegalName);
    then required_return_item(filer, y, ExemptOrganizationNotification6033I, I6033_NameOperatedOrDoingBusinessUnder);
    then required_return_item(filer, y, ExemptOrganizationNotification6033I, I6033_MailingAddressAndWebsite);
    then required_return_item(filer, y, ExemptOrganizationNotification6033I, I6033_TaxpayerIdentificationNumber);
    then required_return_item(filer, y, ExemptOrganizationNotification6033I, I6033_PrincipalOfficerNameAndAddress);
    then required_return_item(filer, y, ExemptOrganizationNotification6033I, I6033_EvidenceOfContinuingBasisForExemptionFromFiling);
}

relation org_terminates_existence(org: Person, d: Date) kind empirical {
    label en unofficial "the organization's existence terminates on this date";
}

relation termination_notice_furnished(org: Person, d: Date) kind empirical {
    label en unofficial "case fact: the organization furnished notice of termination";
}

@source(IRC_S6033_I, relation = formalizes, coverage = exact, quote = "upon the termination of the existence of the organization, shall furnish notice of such termination.")
rule S6033iTerminationNoticeDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    for d: Date;
    when org_in_notification_class_6033i(org, y);
    when org_terminates_existence(org, d);
    then duty FurnishTerminationNotice {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition termination_notice_furnished(org, d);
            window [d, infinity);
        }
    };
}

// ============================================================================
// §6033(j) — loss of exempt status for failure to file
// ============================================================================

relation missed_annual_filing_6033(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization described in subsection (a)(1) or (i) failed to file the annual return or notice for the taxable year";
}

relation missed_two_consecutive_years_6033(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization failed to file for this year and the preceding calendar year";
}

relation missed_three_consecutive_years_6033(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization failed to file for this year and the two preceding calendar years";
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "fails to file the annual return or notice required under either subsection for 2 consecutive years")
rule S6033jTwoConsecutiveYears strict {
    for org: Person;
    for y1: TaxableYear;
    for y2: TaxableYear;
    for n1: Integer;
    for n2: Integer;
    when missed_annual_filing_6033(org, y1);
    when missed_annual_filing_6033(org, y2);
    when us.irc.core::calendar_year_of(y1, n1);
    when us.irc.core::calendar_year_of(y2, n2);
    when n2 == n1 + 1;
    then missed_two_consecutive_years_6033(org, y2);
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "fails to file an annual return or notice required under either subsection for 3 consecutive years")
rule S6033jThreeConsecutiveYears strict {
    for org: Person;
    for y2: TaxableYear;
    for y3: TaxableYear;
    for n2: Integer;
    for n3: Integer;
    when missed_two_consecutive_years_6033(org, y2);
    when missed_annual_filing_6033(org, y3);
    when us.irc.core::calendar_year_of(y2, n2);
    when us.irc.core::calendar_year_of(y3, n3);
    when n3 == n2 + 1;
    then missed_three_consecutive_years_6033(org, y3);
}

relation irs_notified_organization_of_impending_revocation(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the Secretary notified the organization that the Service has no record for 2 consecutive years and about the revocation";
}

relation third_return_due_date_set_by_secretary(org: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the date set by the Secretary for the filing of the third annual return or notice";
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "the Secretary shall notify the organization—")
rule S6033jSecretaryNoticeDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    when missed_two_consecutive_years_6033(org, y);
    then duty NotifyOrganizationOfImpendingRevocation {
        bearer Secretary;
        beneficiary org;
        goal achievement {
            condition irs_notified_organization_of_impending_revocation(org, y);
            window [-infinity, infinity];
        }
    };
}

relation exempt_status_revoked_from(org: Person, d: Date) kind institutional {
    label en unofficial "section 6033(j)(1)(B): the organization's exempt status is considered revoked on and after this date";
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "such organization's status as an organization exempt from tax under section 501(a) shall be considered revoked on and after the date set by the Secretary for the filing of the third annual return or notice.")
rule S6033jRevocationEffect strict {
    for org: Person;
    for y: TaxableYear;
    for d: Date;
    when missed_three_consecutive_years_6033(org, y);
    when third_return_due_date_set_by_secretary(org, y, d);
    then exempt_status_revoked_from(org, d);
}

relation list_of_revoked_organizations_published(org: Person) kind empirical {
    label en unofficial "case fact: the Secretary published the organization on the list of organizations whose status is revoked";
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "The Secretary shall publish and maintain a list of any organization the status of which is so revoked.")
rule S6033jPublishListDuty defeasible {
    for org: Person;
    for d: Date;
    when exempt_status_revoked_from(org, d);
    then duty PublishAndMaintainListOfRevokedOrganizations {
        bearer Secretary;
        beneficiary org;
        goal maintenance {
            condition list_of_revoked_organizations_published(org);
            window [-infinity, infinity];
        }
    };
}

relation must_apply_for_reinstatement_6033(org: Person) kind institutional {
    label en unofficial "section 6033(j)(2): the organization must apply in order to obtain reinstatement, whether or not it originally had to apply for exemption";
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "Any organization the tax-exempt status of which is revoked under paragraph (1) must apply in order to obtain reinstatement of such status regardless of whether such organization was originally required to make such an application.")
rule S6033jApplicationNecessary strict {
    for org: Person;
    for d: Date;
    when exempt_status_revoked_from(org, d);
    then must_apply_for_reinstatement_6033(org);
}

external judgment relation reasonable_cause_shown_for_6033j_failure(org: Person) {
    authority Secretary;
    label en unofficial "the organization shows to the satisfaction of the Secretary evidence of reasonable cause for the failure to file for 3 consecutive years (DECISION-0194: committed to the Secretary)";
}

relation reinstatement_application_filed(org: Person) kind empirical {
    label en unofficial "positive anchor: the organization applied for reinstatement of exempt status";
}

relation exempt_status_reinstated_effective_6033j3(org: Person, d: Date) kind institutional {
    label en unofficial "the exempt status is reinstated effective from the date of revocation";
}

relation secretary_exercises_retroactive_reinstatement_6033j3(secretary: Organ, org: Person, d: Date) kind empirical {
    label en unofficial "the Secretary reinstates the exempt status effective from the revocation date (the exercise)";
}

relation retroactive_reinstatement_6033j3_in_effect(org: Person, d: Date) kind institutional {
    label en unofficial "the retroactive reinstatement is in force (effect)";
}

relation retroactive_reinstatement_6033j3(org: Person, d: Date) kind institutional {
    label en unofficial "twin of the reinstatement power (E-0134)";
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "the organization's exempt status may, in the discretion of the Secretary, be reinstated effective from the date of the revocation under such paragraph.")
rule S6033RetroactiveReinstatement6033j3PowerTwin strict {
    for org: Person;
    for d: Date;
    when reasonable_cause_shown_for_6033j_failure(org);
    when secretary_exercises_retroactive_reinstatement_6033j3(us.irc.core::Secretary, org, d);
    then retroactive_reinstatement_6033j3(org, d);
}

@source(IRC_S6033_J, relation = formalizes, coverage = exact, quote = "the organization's exempt status may, in the discretion of the Secretary, be reinstated effective from the date of the revocation under such paragraph.")
rule S6033RetroactiveReinstatement6033j3Power defeasible {
    for org: Person;
    for d: Date;
    when reinstatement_application_filed(org);
    when exempt_status_revoked_from(org, d);
    then power SecretaryReinstatesExemptStatusRetroactively {
        holder us.irc.core::Secretary; over org;
        exercise secretary_exercises_retroactive_reinstatement_6033j3(us.irc.core::Secretary, org, d);
        valid_when reasonable_cause_shown_for_6033j_failure(org);
        effect create(retroactive_reinstatement_6033j3_in_effect(org, d));
        window [-infinity, infinity];
    };
}

// ============================================================================
// §6033(o) — cross references; Pub. L. 119-21 §70415 student counts
// ============================================================================

relation applicable_educational_institution_4968c(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is an applicable educational institution described in section 4968(c) (as substituted by Pub. L. 119-21 section 70415(a); pending: other-income-taxes)";
}

relation tuition_paying_students_count(org: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the number of tuition-paying students taken into account under section 4968(c)";
}

relation students_count_4968e(org: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the number of students determined under the rules of section 4968(e)";
}

@source(us.irc.temporal::PL119_21_S70415, relation = formalizes, coverage = exact, quote = "Each applicable educational institution described in section 4968(c) which is subject to the requirements of subsection (a) shall include on the return required under subsection (a)—")
rule S6033oStudentCountItems119_21 defeasible {
    for org: Person;
    for y: TaxableYear;
    for s: Date;
    when information_return_required(org, Secretary, y, ExemptOrganizationAnnualReturn6033);
    when applicable_educational_institution_4968c(org, y);
    when us.irc.core::begins(y, s);
    when s > @2025-12-31;
    then required_return_item(org, y, ExemptOrganizationAnnualReturn6033, I6033_NumberOfTuitionPayingStudentsUnder4968c);
    then required_return_item(org, y, ExemptOrganizationAnnualReturn6033, I6033_NumberOfStudentsUnder4968e);
}
