// --- Shared `pub` interface (task's naming; read by `employment`, and by
//     any consumer that needs to know an information-return duty exists,
//     when it is due, or whether it discharged). Each module below
//     produces these from its own section's rules. --------------------------

pub relation information_return_required(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind) kind institutional {
    label en unofficial "the payer is under a duty to make an information return to the Secretary reporting this payee for the calendar/taxable year";
}
pub relation information_return_due(payer: Person, y: TaxableYear, kind: InformationReturnKind, d: Date) kind institutional {
    label en unofficial "the statutory date by which the information return of this kind must be made (return-to-Secretary side; the Secretary sets the actual filing date by regulation for most Part III returns — see each module's note)";
}
relation filed_information_return(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind) kind empirical {
    label en unofficial "case fact: the payer in fact made the information return to the Secretary reporting this payee for the year";
}

pub relation payee_statement_required(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind) kind institutional {
    label en unofficial "the payer is under a duty to furnish the payee a written statement of the information reported";
}
pub relation payee_statement_due(payer: Person, y: TaxableYear, kind: InformationReturnKind, d: Date) kind institutional {
    label en unofficial "the statutory date by which the written statement to the payee must be furnished";
}
relation furnished_payee_statement(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind) kind empirical {
    label en unofficial "case fact: the payer in fact furnished the payee's written statement for the year";
}

// §6051 (Form W-2) and §6053 (tip reporting) get their own named `pub`
// relations per the task's naming, over and above the generic ones above
// (a W-2 is also an `information_return_required`/`WageAndTaxStatement6051`
// instance; the named relations are conveniences for the `employment`
// consumer that reads them directly by name).
pub relation w2_required(employer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en unofficial "§6051(a): the employer is under a duty to furnish the employee a Form W-2 wage and tax statement for the calendar year";
}
relation w2_furnished(employer: Person, employee: Individual, y: TaxableYear) kind empirical;

pub relation tip_report_required(employee: Individual, employer: Person, period: Period) kind institutional {
    label en unofficial "§6053(a): the employee is under a duty to report tips received in the calendar month to the employer";
}
relation tip_report_filed(employee: Individual, employer: Person, period: Period) kind empirical;

pub relation broker_statement_required(broker: Person, customer: Person, y: TaxableYear) kind institutional {
    label en unofficial "§6045(b): the broker is under a duty to furnish the customer a written statement by February 15";
}
