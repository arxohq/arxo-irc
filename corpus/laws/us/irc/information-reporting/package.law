    ForeignPartnershipInterestReturn6046A;
    RetirementPlanReturn6047;
    ForeignTrustNotice6048;
    ForeignTrustOwnerInformation6048B;
    ForeignTrustDistributionReturn6048C;
    ProhibitedTaxShelterDisclosure6033A2;
