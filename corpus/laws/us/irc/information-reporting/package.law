// 26 U.S.C. Chapter 61, Subchapter A, Part III — Information Returns
// (`us.irc.information_reporting`, code F01b, IRC-15 stage 1). The text is
// pinned whole (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package
// information-reporting` from the shared Title 26 snapshot,
// `docs/foundations/us-irc/SOURCE-MANIFEST.json`). This package owns 75
// sections (`docs/foundations/us-irc/OWNERSHIP.json`); this stage formalizes
// the information returns the payroll/pilot families actually read.
//
// STAGE 1 SCOPE (owner's task; full list and rationale in the coverage
// rows and the final report):
//   FULL:    §6031 (partnership return + (b) copies to partners), §6037
//            (S corporation return, (b) copies to shareholders, (c)
//            consistency duty), §6041 (payments-at-source $600/$2,000
//            threshold, PL 119-21 §70433 edition), §6045 ((a) broker
//            return duty, (b) February 15 customer statement, (g) covered-
//            security basis reporting), §6049 (interest $10 threshold),
//            §6050I (cash > $10,000 duty, (e) statement, (f) anti-
//            structuring prohibition), §6050W (payment-card/third-party-
//            network duty, (e) de minimis exception, PL 119-21 §70432
//            edition), §6051 (Form W-2 duty, (a)(1)-(17) content list, (d)
//            duplicate to Secretary, (f) third-party sick pay), §6053 (tip
//            reporting chain: employee to employer by the 10th, (b) excess
//            withholding statement, (c) large food/beverage 8% allocation).
//   PARTIAL: §6033 (duty + (a)(3)(A)(ii) $50,000 gross-receipts exception
//            only — (e)-(n) disclosures left `unreviewed`), §6034A
//            (beneficiary statement duty only), §6038 (duty + $10,000/
//            90-day/$50,000-cap penalty structure + reasonable-cause
//            channel), §6038A (record-maintenance duty only), §6038D
//            ($50,000 threshold + duty only), §6039 (ISO/ESPP statement
//            duty only), §6041A (service-remuneration threshold, tracking
//            §6041's edition), §6042 (dividends $10 threshold), §6044
//            (patronage dividends $10/$100 thresholds), §6050H (mortgage
//            interest $600 threshold + duty), §6050P (discharge-of-
//            indebtedness $600 threshold + duty), §6050S (tuition
//            statement duty only), §6055/§6056 (duty + January 31
//            statement only), §6057-§6059 (registration/notification duty
//            only, no benefit-computation detail), §6060 (preparer-list
//            duty only).
//   Everything else among this package's 75 sections/2,030 disposition
//   rows stays `unreviewed` with note "stage 2" —
//   `docs/foundations/us-irc/coverage/information-reporting.json`.
//
// MODULE MAP
//   package.law                    — shared ontology, imports, enums, the
//                                     `pub` interface every consumer reads
//   01-partnership-and-scorp.law   — §6031, §6037
//   02-payments-and-dividends.law  — §6041, §6041A, §6042, §6043, §6044
//   03-brokers.law                 — §6045
//   04-interest-and-cash.law       — §6049, §6050H, §6050I, §6050P,
//                                     §6050S, §6050W
//   05-wages-and-tips.law          — §6051, §6053
//   06-exempt-orgs-and-misc.law    — §6033, §6034A, §6038, §6038A, §6038D,
//                                     §6039, §6055, §6056, §6057-§6059,
//                                     §6060
//
// ONTOLOGY. This package does NOT reuse `us.irc.core::Return`/`return_of`
// (which types a return to a `TaxKind`, i.e. a tax LIABILITY): an
// information return under Part III reports a THIRD PARTY's payments, not
// the filer's own liability, so forcing it through `TaxKind` would invent a
// tax that does not exist. Instead every duty's achievement goal reads a
// plain empirical relation the case asserts directly
// (`filed_information_return`/`furnished_payee_statement`/…), matching the
// convention `us.irc.returns` uses for `income_tax_return_filed`. Every
// `Money`, `Date`, `Organ`, `Person`/`Individual`/`Corporation`/
// `Partnership` type is `us.irc.core`'s own. `us.irc.returns` (statutory
// due date, §6072) and `us.irc.administration` (§7503 rollover) are NOT
// imported: every priority section states its own filing/furnishing date
// directly in the pinned text (January 31, February 15, the 10th day of
// the following month) — none of stage 1's duties needs §6072's income-tax
// due-date formula, and the weekend/holiday rollover of an already-literal
// statutory date is the same "not this package's norm" boundary `returns`
// itself draws (`us.irc.administration::last_day_rolled`, referenced only
// in comments, per that package's convention).
//
// JUDGMENT CALLS AND EXTERNAL DEPENDENCIES (see report; also flagged
// inline at each use site):
//  - `is_s_corporation` (§6037), `is_partnership` test beyond a bare
//    `Partnership` instance (§6031's §761(a) definition), `foreign
//    corporation`/`foreign partnership` classification (§6038),
//    `substantial presence`/`resident alien` (referenced by §6050I's
//    "United States person" context only in passing) are typed
//    institutional dependency contracts from `us.irc.definitions`
//    (concurrent, not imported per task instruction).
//  - `reasonable_cause` (§6038(c)(4)) is an external judgment relation
//    (DECISION-0194 channel: Secretary), never an arithmetic guard.
//  - PL 119-21 (`us.irc.temporal`) fragments `PL119_21_S70433` (§6041
//    $600→$2,000, taxable — actually calendar — years/payments after
//    December 31, 2025) and `PL119_21_S70432` (§6050W(e) de minimis
//    reinstated at $20,000/200 transactions, retroactive to the American
//    Rescue Plan Act's original effective date) are cited on the amended-
//    era rules; the base 2024-edition text ($600 for both) is the earlier
//    era. `us.irc.temporal::PL119_21_S70433`/`PL119_21_S70432` are `pub`
//    fragments this package cites directly — no new `pub` was needed from
//    a neighbour.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

import us.irc.core version "0.1.1";
import us.irc.temporal version "0.1.1";
import us.irc.definitions version "0.1.1";
import us.irc.s_corporations version "0.1.1";
import us.irc.exempt_organizations version "0.1.1";
import us.irc.credits version "0.1.1";
import us.irc.excise_entities version "0.1.1";
import us.irc.returns version "0.1.1";
import us.irc.property_transactions version "0.1.1";

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type Partnership = us.irc.core::Partnership;
type Trust = us.irc.core::Trust;
type Estate = us.irc.core::Estate;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;
type Period = us.irc.core::Period;

const Secretary: Organ = us.irc.core::Secretary;

// --- Shared classification of "which information return" -------------------

