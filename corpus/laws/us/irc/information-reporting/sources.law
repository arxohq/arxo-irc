// 26 U.S.C. §6039 — statutory note 7 (savingsprovision-note)
fragment IRC_S6039_NOTE_7 in IRC_2024_EDITION {
    kind note;
    locator "section/6039/note/7";
    text en official """Savings Provision
For provisions that nothing in amendment by Pub. L. 101–508 be construed to affect treatment of certain transactions occurring, property acquired, or items of income, loss, deduction, or credit taken into account prior to Nov. 5, 1990, for purposes of determining liability for tax for periods ending after Nov. 5, 1990, see section 11821(b) of Pub. L. 101–508, set out as a note under section 45K of this title.""";
    content_hash "sha256:2aba5c4e7993845da96a76875f25f045423d59798dad98f46bce60e75699ace1";
