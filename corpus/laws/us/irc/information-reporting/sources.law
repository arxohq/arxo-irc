// 26 U.S.C. 6050V(b) — Returns relating to applicable insurance contracts in which certain exempt organizations hold interests
fragment IRC_S6050V_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/6050V/b";
    text en official """(b) Time for making return
Any applicable exempt organization required to make a return under subsection (a) shall file such return at such time as may be established by the Secretary.""";
    content_hash "sha256:b783e60a5e0fbeb4315267bcd03a9744d30a185423e4f72acce532cdbafeb3da";
