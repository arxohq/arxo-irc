// structural heading: subpart F/61/A/III/F
fragment IRC_HEAD_SUBPART_F_61_A_III_F in IRC_2024_EDITION {
    kind heading;
    locator "subpart/F/61/A/III/F";
    text en official """Subpart F/61/A/III/F""";
    content_hash "sha256:b1e2ece8f2a13ef004cfc0d333a5aa58bec612edc6829c9f838e5ccba1e5e0f1";
