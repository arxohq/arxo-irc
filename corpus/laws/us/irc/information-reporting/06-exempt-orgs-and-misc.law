// §6033 (exempt organizations), §6034A (estate/trust beneficiary
// statements), §6038 (foreign corporations/partnerships), §6038A (25%-
// foreign-owned domestic corporations), §6038D (foreign financial assets),
// §6039 (ISO/ESPP statements), §6055/§6056 (health coverage), §6057-§6059
// (pension plan reporting), §6060 (tax return preparer lists), package
// `us.irc.information_reporting`, module 06. All STAGE 1 PARTIAL: duty (and,
// for §6038, the penalty structure) only — see package.law's scope header
// and each block's own note for exactly which paragraphs this covers.
//
// FINDING (task asked to check the text): §6033(a)(3)(A)(ii)'s pinned
// statutory threshold is **$5,000**, not $50,000. The commonly cited
// "$50,000 gross receipts" figure is the Form 990-N (e-Postcard) filing
// threshold the Secretary sets under §6033(i)'s delegated "additional
// notification requirements" authority (Rev. Proc. 2011-15), not a Title 26
// dollar amount — no §6033 fragment in this pinned snapshot contains
// "$50,000" (verified by full-text grep of the generated `sources.law`).
// This package models the pinned $5,000 statutory exception only, and does
// NOT invent a $50,000 literal for §6033 itself; §6038D's OWN $50,000
// threshold (a different section, foreign financial assets) IS pinned
// verbatim and is modeled below.
//
// JUDGMENT CALLS
//  - §6033(a)(1)'s duty and (a)(3)(A)(i)-(iii) mandatory exceptions
//    (churches, the $5,000 organizations, religious orders) are modeled;
//    (a)(2) (prohibited tax shelter transaction disclosure), (a)(3)(B)-(C)
//    (discretionary exception, the enumerated (C) organization list),
//    (b)-(d) (private foundation/supporting organization/§501(c)(4) content
//    requirements), (e)-(h) (additional information, group returns,
//    exceptions), (i)-(n) (additional notification, cessation-of-existence
//    notice, group-exemption reporting on affiliates, automatic revocation
//    for 3-year non-filing, retroactive reinstatement) stay `unreviewed`,
//    stage 2 (not named among the owner's priority items beyond the
//    threshold check itself).
//  - §6038's (a) duty and (b)/(c) penalty structure are modeled; (c)(4)(B)'s
//    reasonable-cause channel extends the "time prescribed" (and so the
//    90-day clock) rather than excusing the penalty outright — modeled as
//    a DECISION-0194 external judgment relation (authority: Secretary)
//    that shifts the reference date the penalty clock reads, not as a
//    blanket `unless` on the penalty conclusion. (d) (aggregation of
//    multiple persons' duty into one) and (e) (definitions: "foreign
//    business entity", "control") stay `unreviewed`, stage 2 — `control`
//    is read as an empirical fact here, not computed from the >50%-
//    ownership test §6038(e)(2) actually gives (EXTERNAL_DEPENDENCY,
//    `international`).
//  - §6038A, §6039, §6055, §6056 model only the (a) duty (no content list,
//    no exceptions) plus, for §6055/§6056, the (c) January 31 individual
//    statement (both sections share an identical (c)(1)-(2) structure).
//  - §6057-§6059's duties are modeled with no benefit-computation detail
//    (registration/return/actuarial-report content is entirely delegated
//    to Secretary-prescribed form content in the pinned text itself, so no
//    literal is available to compute beyond the duty's existence).
//  - §6060's duty reads "return period" as an opaque `Period` the case
//    supplies; the July 31 deadline is modeled directly from the pinned
//    text's own literal.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Corporation,
    IRC_S6033_A,
    IRC_S6034A_A,
    IRC_S6038A_A,
    IRC_S6038D_A,
    IRC_S6038_A,
    IRC_S6038_B,
    IRC_S6039_A,
    IRC_S6055_A,
    IRC_S6055_C,
    IRC_S6056_A,
    IRC_S6056_C,
    IRC_S6057_A,
    IRC_S6058_A,
    IRC_S6059_A,
    IRC_S6060_A,
    Individual,
    InformationReturnKind,
    Period,
    Person,
    Secretary,
    TaxableYear,
    exempt_from_6058_annual_return,
    filed_information_return,
    furnished_payee_statement,
    information_return_required,
    multiple_employer_plan_outside_6057,
    payee_statement_due,
    payee_statement_required,
    reporting_corporation_6038a_or_c,
    return_period_6060,
    secretary_approved_alternative_preparer_reporting,
};

// ============================================================================
// §6033 — Returns by exempt organizations
// ============================================================================

relation is_501a_exempt_organization(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is exempt from taxation under §501(a) (read from the owner (WIRE-7): `exempt-organizations`, not this package's norm)";
}
relation is_church_integrated_auxiliary_or_convention(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "§6033(a)(3)(A)(i): a church, its integrated auxiliary, or a convention or association of churches";
}
relation is_exclusively_religious_activity_of_religious_order(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "§6033(a)(3)(A)(iii): the exclusively religious activities of a religious order";
}
relation gross_receipts_normally_not_more_than_5000(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "§6033(a)(3)(A)(ii): the organization's gross receipts in each taxable year are normally not more than $5,000 (the pinned statutory figure — see module header finding), and it is not a private foundation described in §509(a)";
}
relation exempt_from_501a_annual_return(org: Person, y: TaxableYear) kind institutional {
    label en unofficial "one of §6033(a)(3)(A)'s mandatory exceptions applies";
}
@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "churches, their integrated auxiliaries, and conventions or associations of churches,")
rule S6033ChurchException strict { for org: Person; for y: TaxableYear; when is_church_integrated_auxiliary_or_convention(org, y); then exempt_from_501a_annual_return(org, y); }
@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "any organization (other than a private foundation, as defined in section 509(a)) described in subparagraph (C), the gross receipts of which in each taxable year are normally not more than $5,000, or")
rule S6033SmallOrganizationException defeasible { for org: Person; for y: TaxableYear; when gross_receipts_normally_not_more_than_5000(org, y); then exempt_from_501a_annual_return(org, y); }
@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "the exclusively religious activities of any religious order.")
rule S6033ReligiousOrderException strict { for org: Person; for y: TaxableYear; when is_exclusively_religious_activity_of_religious_order(org, y); then exempt_from_501a_annual_return(org, y); }

relation filed_501a_annual_return(org: Person, y: TaxableYear) kind empirical;
@source(IRC_S6033_A, relation = formalizes, coverage = exact, quote = "every organization exempt from taxation under section 501(a) shall file an annual return, stating specifically the items of gross income, receipts, and disbursements, and such other information for the purpose of carrying out the internal revenue laws as the Secretary may by forms or regulations prescribe,")
rule S6033AnnualReturnDuty defeasible {
    for org: Person;
    for y: TaxableYear;
    when is_501a_exempt_organization(org, y);
    then duty FileExemptOrganizationAnnualReturn {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition filed_501a_annual_return(org, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(org, Secretary, y, ExemptOrganizationAnnualReturn6033);
    unless exempt_from_501a_annual_return(org, y);
}

// ============================================================================
// §6034A — Information regarding beneficiaries of estates and trusts
// ============================================================================

relation fiduciary_of(fiduciary: Person, obligor: Person) kind institutional {
    label en unofficial "the person is the fiduciary of the estate or trust (section 7701(a)(6)); derived from `us.irc.core::fiduciary_for` in 21-wire9-owner-contracts.law, a case may still assert it directly";
}
relation entity_required_to_file_6012a_return(obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "the estate or trust is required to file a return under §6012(a) for the taxable year; derived from `us.irc.returns::required_to_file_income_tax_return` in 21-wire9-owner-contracts.law, a case may still assert it directly";
}
relation is_beneficiary_or_nominee(beneficiary: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person receives a distribution from the estate or trust with respect to the taxable year, or an item is allocated to the person with respect to the taxable year (§6034A(a)(1)-(2))";
}
@source(IRC_S6034A_A, relation = formalizes, coverage = exact, quote = "shall, on or before the date on which such return was required to be filed, furnish to each beneficiary (or nominee thereof)")
rule S6034ABeneficiaryStatementDuty strict {
    for fiduciary: Person;
    for obligor: Person;
    for beneficiary: Person;
    for y: TaxableYear;
    when fiduciary_of(fiduciary, obligor) and entity_required_to_file_6012a_return(obligor, y) and is_beneficiary_or_nominee(beneficiary, obligor, y);
    then duty FurnishBeneficiaryStatement {
        bearer fiduciary;
        beneficiary beneficiary;
        goal achievement {
            condition furnished_payee_statement(fiduciary, beneficiary, y, EstateTrustBeneficiaryStatement6034A);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(fiduciary, beneficiary, y, EstateTrustBeneficiaryStatement6034A);
}

// ============================================================================
// §6038 — Information reporting with respect to certain foreign
// corporations and partnerships
// ============================================================================

relation is_united_states_person(person: Person) kind institutional {
    label en unofficial "the person is a United States person (read from the owner (WIRE-7): `us.irc.definitions`, not this package's norm)";
}
relation controls_foreign_business_entity(person: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person controls the foreign corporation or foreign partnership for the annual accounting period (pending: `international`'s §6038(e)(2) >50%-ownership test, asserted directly here)";
}
relation furnished_6038a_information(person: Person, obligor: Person, y: TaxableYear) kind empirical;
@source(IRC_S6038_A, relation = formalizes, coverage = partial, quote = "Every United States person shall furnish, with respect to any foreign business entity which such person controls, such information as the Secretary may prescribe")
rule S6038InformationReturnDuty defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when is_united_states_person(person) and controls_foreign_business_entity(person, obligor, y);
    then duty Furnish6038Information {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition furnished_6038a_information(person, obligor, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(person, obligor, y, ForeignBusinessEntityInformation6038);
}

relation reasonable_cause_for_6038_failure_until(person: Person, obligor: Person, y: TaxableYear, last_reasonable_cause_date: Date) kind empirical {
    label en unofficial "DECISION-0194 external judgment relation (authority: Secretary): as shown to the Secretary's satisfaction, reasonable cause for the §6038 failure existed through this date — §6038(c)(4)(B) treats the prescribed time (and the 90-day notice clock) as not earlier than this date";
}
relation failed_to_furnish_6038_information_by(person: Person, obligor: Person, y: TaxableYear, prescribed_by: Date) kind empirical;
relation secretary_mailed_6038_failure_notice_on(person: Person, obligor: Person, y: TaxableYear, mailed_on: Date) kind empirical;

pub relation dollar_penalty_6038(person: Person, obligor: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the §6038(b) dollar penalty owed for this annual accounting period: $10,000 for the initial failure, plus $10,000 for each 30-day period (or fraction) the failure continues more than 90 days after the Secretary's mailed notice, capped at an additional $50,000";
}
@source(IRC_S6038_B, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $10,000 for each annual accounting period with respect to which such failure exists.")
rule S6038InitialDollarPenalty strict {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for prescribed_by: Date;
    when failed_to_furnish_6038_information_by(person, obligor, y, prescribed_by);
    when not_known(furnished_6038a_information(person, obligor, y));
    then dollar_penalty_6038(person, obligor, y, 10000 USD);
}
relation continuation_periods_elapsed_6038(person: Person, obligor: Person, y: TaxableYear, periods: Integer) kind empirical {
    label en unofficial "case fact: the number of complete or partial 30-day periods that have elapsed since the 90th day after the Secretary's mailed notice, during which the §6038(a) failure continues (capped at 5 for the $50,000 additional-penalty ceiling by the rule below, not by this fact)";
}
@source(IRC_S6038_B, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty (in addition to the amount required under paragraph (1)) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues with respect to any annual accounting period after the expiration of such 90-day period. The increase in any penalty under this paragraph shall not exceed $50,000.")
rule S6038ContinuationDollarPenaltyUnderCap strict {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for prescribed_by: Date;
    for mailed_on: Date;
    for periods: Integer;
    when failed_to_furnish_6038_information_by(person, obligor, y, prescribed_by);
    when secretary_mailed_6038_failure_notice_on(person, obligor, y, mailed_on);
    when not_known(furnished_6038a_information(person, obligor, y));
    when continuation_periods_elapsed_6038(person, obligor, y, periods);
    when periods <= 5;
    then dollar_penalty_6038(person, obligor, y, 10000 USD * periods);
}
rule S6038ContinuationDollarPenaltyAtCap strict {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for prescribed_by: Date;
    for mailed_on: Date;
    for periods: Integer;
    when failed_to_furnish_6038_information_by(person, obligor, y, prescribed_by);
    when secretary_mailed_6038_failure_notice_on(person, obligor, y, mailed_on);
    when not_known(furnished_6038a_information(person, obligor, y));
    when continuation_periods_elapsed_6038(person, obligor, y, periods);
    when periods > 5;
    then dollar_penalty_6038(person, obligor, y, 50000 USD);
}
// The $50,000 cap is the ADDITIONAL amount under (b)(2) (5 periods x
// $10,000); this package does not sum the (b)(1) initial $10,000 with the
// (b)(2) continuation amount into one combined total — a consumer reads
// both `dollar_penalty_6038` conclusions (initial and continuation share no
// head, so both can hold; TECH_GAP: no `sum`/aggregate combines them here,
// see report) rather than this package inventing a combined figure.

// ============================================================================
// §6038A — Information with respect to certain foreign-owned corporations
// (brief: duty only)
// ============================================================================

relation is_domestic_corporation(c: Corporation) kind institutional {
    label en unofficial "the corporation is a domestic corporation (read from the owner (WIRE-7): `us.irc.definitions`, §7701(a)(4), not this package's norm)";
}
relation is_25_percent_foreign_owned(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the corporation is 25-percent foreign-owned (pending: `international`, not this package's norm)";
}
relation furnished_6038a_reporting_corporation_information(c: Corporation, y: TaxableYear) kind empirical;
@source(IRC_S6038A_A, relation = formalizes, coverage = exact, quote = "such corporation shall furnish, at such time and in such manner as the Secretary shall by regulations prescribe, the information described in subsection (b) and such corporation shall maintain")
rule S6038AReportingCorporationDuty strict {
    for c: Corporation;
    for y: TaxableYear;
    when is_domestic_corporation(c) and is_25_percent_foreign_owned(c, y);
    then duty FurnishReportingCorporationInformation {
        bearer c;
        beneficiary Secretary;
        goal maintenance {
            condition furnished_6038a_reporting_corporation_information(c, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(c, Secretary, y, ReportingCorporationInformation6038A);
    then reporting_corporation_6038a_or_c(c);
}

// ============================================================================
// §6038D — Information with respect to foreign financial assets
// ============================================================================

relation holds_interest_in_specified_foreign_financial_asset(individual: Individual, y: TaxableYear) kind empirical;
relation aggregate_specified_foreign_financial_asset_value(individual: Individual, y: TaxableYear, amount: Money) kind empirical;
relation attached_6038d_information(individual: Individual, y: TaxableYear) kind empirical;
@source(IRC_S6038D_A, relation = formalizes, coverage = exact, quote = "shall attach to such person's return of tax imposed by subtitle A for such taxable year the information described in subsection (c) with respect to each such asset if the aggregate value of all such assets exceeds $50,000 (or such higher dollar amount as the Secretary may prescribe).")
rule S6038DForeignFinancialAssetDuty defeasible {
    for individual: Individual;
    for y: TaxableYear;
    for amount: Money;
    when holds_interest_in_specified_foreign_financial_asset(individual, y);
    when aggregate_specified_foreign_financial_asset_value(individual, y, amount);
    when amount > 50000 USD;
    then duty Attach6038DInformation {
        bearer individual;
        beneficiary Secretary;
        goal achievement {
            condition attached_6038d_information(individual, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(individual, Secretary, y, ForeignFinancialAssetInformation6038D);
}

// ============================================================================
// §6039 — Returns required in connection with certain options (ISO/ESPP)
// (brief: duty only)
// ============================================================================

relation transfers_stock_pursuant_to_iso_exercise(c: Corporation, transferee: Person, y: TaxableYear) kind empirical;
relation records_transfer_pursuant_to_423c_option(c: Corporation, transferor: Person, y: TaxableYear) kind empirical;
relation filed_6039_return(c: Corporation, person: Person, y: TaxableYear) kind empirical;
@source(IRC_S6039_A, relation = formalizes, coverage = exact, quote = "which in any calendar year transfers to any person a share of stock pursuant to such person's exercise of an incentive stock option,")
rule S6039IsoReturnDuty strict {
    for c: Corporation;
    for transferee: Person;
    for y: TaxableYear;
    when transfers_stock_pursuant_to_iso_exercise(c, transferee, y);
    then duty MakeIsoTransferReturn {
        bearer c;
        beneficiary Secretary;
        goal achievement {
            condition filed_6039_return(c, transferee, y);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S6039_A, relation = formalizes, coverage = exact, quote = "which in any calendar year records (or has by its agent recorded) a transfer of the legal title of a share of stock acquired by the transferor pursuant to his exercise of an option described in section 423(c)")
rule S6039EspTransferReturnDuty strict {
    for c: Corporation;
    for transferor: Person;
    for y: TaxableYear;
    when records_transfer_pursuant_to_423c_option(c, transferor, y);
    then duty MakeEspTransferReturn {
        bearer c;
        beneficiary Secretary;
        goal achievement {
            condition filed_6039_return(c, transferor, y);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6055 — Minimum essential coverage reporting (brief: duty + January 31
// individual statement)
// ============================================================================

relation provides_minimum_essential_coverage(provider: Person, individual: Individual, y: TaxableYear) kind empirical;
@source(IRC_S6055_A, relation = formalizes, coverage = exact, quote = "Every person who provides minimum essential coverage to an individual during a calendar year shall, at such time as the Secretary may prescribe, make a return described in subsection (b).")
rule S6055CoverageReturnDuty strict {
    for provider: Person;
    for individual: Individual;
    for y: TaxableYear;
    when provides_minimum_essential_coverage(provider, individual, y);
    then duty MakeMinimumEssentialCoverageReturn {
        bearer provider;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(provider, individual, y, MinimumEssentialCoverage6055);
            window [-infinity, infinity];
        }
    };
    then information_return_required(provider, individual, y, MinimumEssentialCoverage6055);
}
@source(IRC_S6055_C, relation = formalizes, coverage = exact, quote = "The written statement required under paragraph (1) shall be furnished on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6055StatementDuty defeasible {
    for provider: Person;
    for individual: Individual;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(provider, individual, y, MinimumEssentialCoverage6055);
    when us.irc.core::ends(y, end_date);
    then duty FurnishMinimumEssentialCoverageStatement {
        bearer provider;
        beneficiary individual;
        goal achievement {
            condition furnished_payee_statement(provider, individual, y, MinimumEssentialCoverage6055);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(provider, individual, y, MinimumEssentialCoverage6055);
    then payee_statement_due(provider, y, MinimumEssentialCoverage6055, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

// ============================================================================
// §6056 — Applicable large employer health coverage reporting (brief:
// duty + January 31 individual statement)
// ============================================================================

relation is_applicable_large_employer_subject_to_4980h(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the employer is an applicable large employer required to meet §4980H's requirements with respect to its full-time employees for the calendar year (read from the owner `excise_entities` (WIRE-7); was pending: `employment`, not this package's norm)";
}
@source(IRC_S6056_A, relation = formalizes, coverage = exact, quote = "Every applicable large employer required to meet the requirements of section 4980H with respect to its full-time employees during a calendar year shall, at such time as the Secretary may prescribe, make a return described in subsection (b).")
rule S6056EmployerCoverageReturnDuty strict {
    for employer: Person;
    for y: TaxableYear;
    when is_applicable_large_employer_subject_to_4980h(employer, y);
    then duty MakeApplicableLargeEmployerCoverageReturn {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(employer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
            window [-infinity, infinity];
        }
    };
    then information_return_required(employer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
}
@source(IRC_S6056_C, relation = formalizes, coverage = exact, quote = "The written statement required under paragraph (1) shall be furnished on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
relation is_full_time_employee_of(employee: Individual, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor (§190): the individual is a full-time employee of the applicable large employer whose name is required to be set forth on the §6056(a) return under (b)(2)(E), for the calendar year";
}
rule S6056StatementDuty defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for end_date: Date;
    when is_applicable_large_employer_subject_to_4980h(employer, y);
    when is_full_time_employee_of(employee, employer, y);
    when us.irc.core::ends(y, end_date);
    then duty FurnishApplicableLargeEmployerCoverageStatement {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition furnished_payee_statement(employer, employee, y, ApplicableLargeEmployerHealthCoverage6056);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(employer, employee, y, ApplicableLargeEmployerHealthCoverage6056);
    then payee_statement_due(employer, y, ApplicableLargeEmployerHealthCoverage6056, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

// ============================================================================
// §6057-§6059 — Pension plan reporting (brief: duty only, no benefit-
// computation detail)
// ============================================================================

relation is_plan_administrator_of_erisa_vesting_plan(administrator: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person is the §414(g) plan administrator of a plan to which ERISA §203's vesting standards apply for the plan year (pending: `deferred-compensation`, not this package's norm)";
}
relation filed_6057_registration_statement(administrator: Person, y: TaxableYear) kind empirical;
@source(IRC_S6057_A, relation = formalizes, coverage = exact, quote = "the plan administrator (within the meaning of section 414(g)) of each plan to which the vesting standards of section 203 of part 2 of subtitle B of title I of the Employee Retirement Income Security Act of 1974 applies for such plan year shall file a registration statement with the Secretary.")
rule S6057RegistrationDuty defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when is_plan_administrator_of_erisa_vesting_plan(administrator, y);
    then duty FilePensionPlanRegistration {
        bearer administrator;
        beneficiary Secretary;
        goal achievement {
            condition filed_6057_registration_statement(administrator, y);
            window [-infinity, infinity];
        }
    };
    unless multiple_employer_plan_outside_6057(administrator, y);
}

relation maintains_funded_deferred_compensation_plan(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the employer maintains a pension, annuity, stock bonus, profit-sharing, or other funded plan of deferred compensation described in part I of subchapter D of chapter 1 (pending: `deferred-compensation`, not this package's norm)";
}
relation filed_6058_annual_return(employer: Person, y: TaxableYear) kind empirical;
@source(IRC_S6058_A, relation = formalizes, coverage = exact, quote = "shall file an annual return stating such information as the Secretary may by regulations prescribe with respect to the qualification, financial conditions, and operations of the plan;")
rule S6058AnnualReturnDuty defeasible {
    for employer: Person;
    for y: TaxableYear;
    when maintains_funded_deferred_compensation_plan(employer, y);
    then duty FilePensionPlanAnnualReturn {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition filed_6058_annual_return(employer, y);
            window [-infinity, infinity];
        }
    };
    unless exempt_from_6058_annual_return(employer, y);
}

relation is_administrator_of_412_defined_benefit_plan(administrator: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person is the §414(g) plan administrator of a defined benefit plan to which §412 applies, for a plan year the actuarial report is due (pending: `deferred-compensation`, not this package's norm)";
}
relation filed_6059_actuarial_report(administrator: Person, y: TaxableYear) kind empirical;
@source(IRC_S6059_A, relation = formalizes, coverage = exact, quote = "The actuarial report described in subsection (b) shall be filed by the plan administrator (as defined in section 414(g) of each defined benefit plan to which section 412 applies, for the first plan year for which section 412 applies to the plan and for each third plan year thereafter (or more frequently if the Secretary determines that more frequent reports are necessary).")
rule S6059ActuarialReportDuty defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when is_administrator_of_412_defined_benefit_plan(administrator, y);
    then duty FileActuarialReport {
        bearer administrator;
        beneficiary Secretary;
        goal achievement {
            condition filed_6059_actuarial_report(administrator, y);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6060 — Information returns of tax return preparers
// ============================================================================

relation employs_tax_return_preparer(employer: Person, preparer: Person, period: Period) kind institutional {
    label en unofficial "the person employs a tax return preparer to prepare returns or refund claims for other persons, at any time during the return period (§6060(a); a sole preparer not employed by another preparer is treated as the preparer's own employer)";
}
relation filed_6060_preparer_list_return(employer: Person, period: Period) kind empirical;
@source(IRC_S6060_A, relation = formalizes, coverage = partial, quote = "Any person who employs a tax return preparer to prepare any return or claim for refund other than for such person at any time during a return period shall make a return setting forth the name, taxpayer identification number, and place of work of each tax return preparer employed by him at any time during such period.")
rule S6060PreparerListReturnDuty defeasible {
    for employer: Person;
    for preparer: Person;
    for period: Period;
    when employs_tax_return_preparer(employer, preparer, period);
    when return_period_6060(period);
    then duty FilePreparerListReturn {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition filed_6060_preparer_list_return(employer, period);
            window [-infinity, infinity];
        }
    };
    unless secretary_approved_alternative_preparer_reporting(employer, period);
}
pub relation preparer_list_return_due(employer: Person, period: Period, d: Date) kind institutional {
    label en unofficial "§6060(a): the first July 31 following the end of the return period";
}
@source(IRC_S6060_A, relation = formalizes, coverage = exact, quote = "The return required by this section shall be filed, in such manner as the Secretary may by regulations prescribe, on or before the first July 31 following the end of such return period.")
rule S6060PreparerListReturnDueFirstJuly31 defeasible {
    for employer: Person;
    for preparer: Person;
    for period: Period;
    for end_date: Date;
    when employs_tax_return_preparer(employer, preparer, period);
    when return_period_6060(period);
    when us.irc.core::ends(period, end_date);
    then preparer_list_return_due(employer, period, add_calendar_period(end_date, 31 calendar_day));
}
// Stage 2: a return period is the 12-month period beginning on July 1
// (§6060(c), `return_period_6060`), so it ends on June 30 and the first
// July 31 following its end is 31 days after the end date. The stage-1
// December 31 formula (end date + 212 days) was wrong for the statutory
// period and is replaced.
