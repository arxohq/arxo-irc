// §6031 (partnership returns) and §6037 (S corporation returns), package
// `us.irc.information_reporting`, module 01. STAGE 1 FULL.
//
// JUDGMENT CALLS
//  - §6031(a)'s "partnership (as defined in section 761(a))" reads
//    `us.irc.core::Partnership` directly: this package does not test
//    whether a given `Partnership` instance actually meets §761(a) (that
//    classification test belongs to `us.irc.definitions`, not named by the
//    owner's task among the sections to formalize) — a case that asserts a
//    `Partnership` entity is asserting it satisfies §761(a) by construction,
//    matching `us.irc.returns`'s own treatment of `partnership_of_record`.
//  - §6031(b)'s amendment restriction ((1)-(4) exceptions) reads pending
//    facts from `partnerships` (BBA §6221(b) election, §6225(c) procedures,
//    §6226 statements) as typed institutional dependency contracts — this
//    package does not compute BBA centralized-partnership-audit eligibility.
//  - §6037(a)'s last sentence ("treated as a return filed ... under section
//    6012" for chapter 66 limitations purposes) is a classification rule
//    producing a `treated_as_6012_return` fact, not a duty of its own.
//  - §6037(c) (shareholder consistency) is modeled as: (1) a `duty` on the
//    shareholder (bearer shareholder, beneficiary Secretary) to treat
//    subchapter S items consistently, defeated by the notification
//    exception; (2) the (2)(B) "shareholder receiving incorrect
//    information" branch as an alternate positive path INTO the same
//    exception (an `unless` defeater fires from either path); (3) (3)'s
//    "treated as arising out of mathematical or clerical errors" sentence
//    as a `classification` producing a fact the `assessment` package can
//    read (`us.irc.core::assessment_of` union with §6213(b)(1) is
//    `assessment`'s own norm — not invoked here, per the owner's
//    typed-dependency-not-invented-result rule); (5) is a pure
//    cross-reference to chapter 68 penalties — NON_NORMATIVE here.
//  - No date literal is given for §6031(a)/§6037(a)'s return: both read
//    "as the Secretary may by forms and regulations prescribe" for the
//    RETURN's own filing time (unlike the COPY/statement duties, which the
//    text itself times to the return's own due date) — `information_
//    return_due` for these two kinds is therefore an EXTERNAL_DEPENDENCY
//    (Secretary's regulatory prescription), not a literal date this
//    package invents; see the coverage row.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Corporation,
    IRC_S6031_A,
    IRC_S6031_B,
    IRC_S6037_A,
    IRC_S6037_B,
    IRC_S6037_C,
    InformationReturnKind,
    Partnership,
    Person,
    Secretary,
    TaxableYear,
    filed_information_return,
    foreign_partnership_excluded_from_6031,
    furnished_payee_statement,
    information_return_required,
    payee_statement_required,
};

// ============================================================================
// §6031 — Return of partnership income
// ============================================================================

relation partnership_return_year_at_issue(p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor (§190): the partnership's §6031(a) return for this taxable year is at issue in the case (§761(a) partnership status is asserted by construction of the `Partnership` type, per package.law's note)";
}
@source(IRC_S6031_A, relation = formalizes, coverage = exact, quote = "Every partnership (as defined in section 761(a)) shall make a return for each taxable year, stating specifically the items of its gross income and the deductions allowable by subtitle A, and such other information, for the purpose of carrying out the provisions of subtitle A as the Secretary may by forms and regulations prescribe, and shall include in the return the names and addresses of the individuals who would be entitled to share in the taxable income if distributed and the amount of the distributive share of each individual.")
rule S6031PartnershipReturnDuty defeasible {
    for p: Partnership;
    for y: TaxableYear;
    when partnership_return_year_at_issue(p, y);
    then duty MakePartnershipReturn {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(p, Secretary, y, PartnershipReturnOfIncome6031);
            window [-infinity, infinity];
        }
    };
    then information_return_required(p, Secretary, y, PartnershipReturnOfIncome6031);
    unless foreign_partnership_excluded_from_6031(p, y);
}

relation is_partner_or_nominee_holder(person: Person, p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the person is a partner in, or holds an interest in, the partnership as a nominee for another person, at any time during the taxable year (§6031(b))";
}
relation partnership_amendment_permitted(p: Partnership, person: Person, y: TaxableYear) kind institutional {
    label en unofficial "one of §6031(b)(1)-(4)'s four exceptions to the post-due-date amendment restriction applies (pending: `partnerships`, BBA §§6221(b)/6225(c)/6226, and the Secretary's own further exception — not this package's norm)";
}
@source(IRC_S6031_B, relation = formalizes, coverage = exact, quote = "Each partnership required to file a return under subsection (a) for any partnership taxable year shall (on or before the day on which the return for such taxable year was required to be filed) furnish to each person who is a partner or who holds an interest in such partnership as a nominee for another person at any time during such taxable year a copy of such information required to be shown on such return as may be required by regulations.")
rule S6031CopyToPartnersDuty strict {
    for p: Partnership;
    for person: Person;
    for y: TaxableYear;
    when is_partner_or_nominee_holder(person, p, y);
    then duty FurnishCopyToPartner {
        bearer p;
        beneficiary person;
        goal achievement {
            condition furnished_payee_statement(p, person, y, PartnershipReturnOfIncome6031);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(p, person, y, PartnershipReturnOfIncome6031);
}

relation partnership_information_amended(p: Partnership, person: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the partnership amends information already furnished under §6031(b) after the §6031(a) return's due date";
}
@source(IRC_S6031_B, relation = formalizes, coverage = exact, quote = "Information required to be furnished by the partnership under this subsection may not be amended after the due date of the return under subsection (a) to which such information relates, except—")
rule S6031AmendmentRestrictedAfterDueDate defeasible {
    for p: Partnership;
    for person: Person;
    for y: TaxableYear;
    when partnership_information_amended(p, person, y);
    then prohibition S6031NoAmendmentAfterDueDateProhibition {
        bearer p;
        action partnership_information_amended(p, person, y);
        window [-infinity, infinity];
    };
    unless partnership_amendment_permitted(p, person, y);
}

// ============================================================================
// §6037 — Return of a corporation which is an S corporation
// ============================================================================

relation is_s_corporation(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the corporation has a valid subchapter S election in effect for the taxable year (read from the owner (WIRE-7): `s-corporations`, not this package's norm)";
}
@source(IRC_S6037_A, relation = formalizes, coverage = partial, quote = "Every S corporation shall make a return for each taxable year, stating specifically the items of its gross income and the deductions allowable by subtitle A, the names and addresses of all persons owning stock in the corporation at any time during the taxable year, the number of shares of stock owned by each shareholder at all times during the taxable year, the amount of money and other property distributed by the corporation during the taxable year to each shareholder, the date of each such distribution, each shareholder's pro rata share of each item of the corporation for the taxable year, and such other information, for the purpose of carrying out the provisions of subchapter S of chapter 1, as the Secretary may by forms and regulations prescribe.")
rule S6037SCorporationReturnDuty strict {
    for c: Corporation;
    for y: TaxableYear;
    when is_s_corporation(c, y);
    then duty MakeSCorporationReturn {
        bearer c;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(c, Secretary, y, SCorporationReturn6037);
            window [-infinity, infinity];
        }
    };
    then information_return_required(c, Secretary, y, SCorporationReturn6037);
}

relation treated_as_6012_return(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the §6037(a) return, for chapter 66 limitations purposes, is treated as a return filed by the corporation under §6012";
}
@source(IRC_S6037_A, relation = formalizes, coverage = exact, quote = "Any return filed pursuant to this section shall, for purposes of chapter 66 (relating to limitations), be treated as a return filed by the corporation under section 6012.")
rule S6037TreatedAsSection6012Return strict {
    for c: Corporation;
    for y: TaxableYear;
    when filed_information_return(c, Secretary, y, SCorporationReturn6037);
    then treated_as_6012_return(c, y);
}

relation is_shareholder_of(person: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the person is a shareholder of the S corporation at any time during the taxable year (§6037(b))";
}
@source(IRC_S6037_B, relation = formalizes, coverage = exact, quote = "Each S corporation required to file a return under subsection (a) for any taxable year shall (on or before the day on which the return for such taxable year was filed) furnish to each person who is a shareholder at any time during such taxable year a copy of such information shown on such return as may be required by regulations.")
rule S6037CopyToShareholdersDuty strict {
    for c: Corporation;
    for person: Person;
    for y: TaxableYear;
    when is_s_corporation(c, y) and is_shareholder_of(person, c, y);
    then duty FurnishCopyToShareholder {
        bearer c;
        beneficiary person;
        goal achievement {
            condition furnished_payee_statement(c, person, y, SCorporationReturn6037);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(c, person, y, SCorporationReturn6037);
}

// --- §6037(c): shareholder consistency ---------------------------------------

relation subchapter_s_item_treated_consistently(person: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "§6037(c)(1): the shareholder's own duty — treat every subchapter S item consistently with the corporate return";
}
relation shareholder_files_inconsistency_statement(person: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "§6037(c)(2)(A)(ii): the shareholder files with the Secretary a statement identifying the inconsistency";
}
relation corporation_did_not_file_return(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "§6037(c)(2)(A)(i)(II): the corporation has not filed a return";
}
relation shareholder_return_may_be_inconsistent(person: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "§6037(c)(2)(A)(i)(I): the corporation filed a return but the shareholder's own treatment is, or may be, inconsistent with it";
}
relation shareholder_demonstrates_consistency_with_furnished_schedule(person: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "§6037(c)(2)(B)(i): the shareholder demonstrates to the Secretary's satisfaction that the treatment is consistent with the schedule the corporation furnished";
}
relation shareholder_elects_incorrect_information_treatment(person: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "§6037(c)(2)(B)(ii): the shareholder elects to have the incorrect-information paragraph apply with respect to the item";
}
relation shareholder_notified_inconsistency(person: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the shareholder is treated as having complied with §6037(c)(2)(A)(ii) — either by filing the statement directly, or by the (2)(B) incorrect-information path";
}
@source(IRC_S6037_C, relation = formalizes, coverage = exact, quote = "the shareholder files with the Secretary a statement identifying the inconsistency,")
rule S6037NotifiedDirectly strict {
    for person: Person;
    for c: Corporation;
    for y: TaxableYear;
    when shareholder_files_inconsistency_statement(person, c, y);
    then shareholder_notified_inconsistency(person, c, y);
}
@source(IRC_S6037_C, relation = formalizes, coverage = exact, quote = "demonstrates to the satisfaction of the Secretary that the treatment of the subchapter S item on the shareholder's return is consistent with the treatment of the item on the schedule furnished to the shareholder by the corporation, and")
rule S6037NotifiedByIncorrectInformationPath strict {
    for person: Person;
    for c: Corporation;
    for y: TaxableYear;
    when shareholder_demonstrates_consistency_with_furnished_schedule(person, c, y) and shareholder_elects_incorrect_information_treatment(person, c, y);
    then shareholder_notified_inconsistency(person, c, y);
}
relation subchapter_s_item_at_issue(person: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor (§190): a subchapter S item's treatment on the shareholder's return is at issue in the case";
}
@source(IRC_S6037_C, relation = formalizes, coverage = exact, quote = "A shareholder of an S corporation shall, on such shareholder's return, treat a subchapter S item in a manner which is consistent with the treatment of such item on the corporate return.")
rule S6037ConsistencyDuty defeasible {
    for person: Person;
    for c: Corporation;
    for y: TaxableYear;
    when subchapter_s_item_at_issue(person, c, y) and (shareholder_return_may_be_inconsistent(person, c, y) or corporation_did_not_file_return(c, y));
    then duty TreatSubchapterSItemConsistently {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition subchapter_s_item_treated_consistently(person, c, y);
            window [-infinity, infinity];
        }
    };
    unless shareholder_notified_inconsistency(person, c, y);
}

relation inconsistent_treatment_assessed_as_math_error(person: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "§6037(c)(3): the shareholder's inconsistent adjustment is treated as arising from a mathematical or clerical error and assessed under §6213(b)(1) without the (b)(2) abatement right (pending: `assessment`'s own §6213(b)(1) rule reads this classification, not invoked here)";
}
@source(IRC_S6037_C, relation = formalizes, coverage = exact, quote = "any adjustment required to make the treatment of the items by such shareholder consistent with the treatment of the items on the corporate return shall be treated as arising out of mathematical or clerical errors and assessed according to section 6213(b)(1)")
rule S6037InconsistentTreatmentIsMathError strict {
    for person: Person;
    for c: Corporation;
    for y: TaxableYear;
    when shareholder_return_may_be_inconsistent(person, c, y);
    when not_known(shareholder_notified_inconsistency(person, c, y));
    then inconsistent_treatment_assessed_as_math_error(person, c, y);
}

// §6037(c)(4) ("subchapter S item" definition) is a local classification
// this package does not further test (regulatory-dependent scope) —
// EXTERNAL_DEPENDENCY, not invented. §6037(c)(5) ("For addition to tax ...
// see part II of subchapter A of chapter 68") is a pure cross-reference —
// NON_NORMATIVE, owner `penalties`.
