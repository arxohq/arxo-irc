// §6045 (rest), §6045A, §6045B — brokers, basis reporting for covered
// securities, transferee statements and issuer returns of package
// `us.irc.information_reporting`, module 09 (STAGE 2). Completes module 03.
//
// JUDGMENT CALLS
//  - The stage-1 rules for §6045(g)(2)(B)(i)(I) had the polarity of the
//    average-basis test inverted (FIFO fired when an average-basis method
//    WAS permissible). The rule now requires `basis_determination_at_issue`
//    and `not_known(average_basis_method_permissible)`; module 03 was edited
//    and its two scenarios adjusted.
//  - Covered-security status (§6045(g)(3)) is derived from the security's
//    class, acquisition date and the applicable date of the class; the
//    stage-1 relation `is_covered_security` stays a case-asserted fact for
//    callers that classify elsewhere, and the derived
//    `covered_security_by_definition` is offered beside it (not merged: the
//    stage-1 sale/basis rules read the asserted fact).
//  - "Reporting for the year including the date" (§6045(g)(5), (h)(2)) is
//    computed against `us.irc.core::begins/ends` of the reporting year.
//  - Constructive-ownership and regulation-dependent limbs are recorded in
//    the coverage rows, not invented.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    CashKind6050I,
    IRC_S6045A_A,
    IRC_S6045A_B,
    IRC_S6045A_D,
    IRC_S6045B_A,
    IRC_S6045B_B,
    IRC_S6045B_C,
    IRC_S6045B_D,
    IRC_S6045B_E,
    IRC_S6045_B,
    IRC_S6045_C,
    IRC_S6045_D,
    IRC_S6045_E,
    IRC_S6045_F,
    IRC_S6045_G,
    IRC_S6045_H,
    InformationReturnKind,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    filed_information_return,
    information_return_required,
    payee_statement_due,
    payee_statement_required,
    required_return_item,
    required_statement_item,
    trade_or_business,
};

// ============================================================================
// §6045(b), (c) — statements to customers, broker definitions
// ============================================================================

@source(IRC_S6045_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6045StatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, BrokerProceeds6045);
    then required_statement_item(payer, y, BrokerProceeds6045, I6045_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, BrokerProceeds6045, I6045_InformationShownOnReturnForThisCustomer);
}

relation person_is_dealer(person: Person) kind institutional {
    label en unofficial "the person is a dealer (section 6045(c)(1)(A))";
}

relation organization_of_members_providing_property_or_services(org: Person) kind empirical {
    label en unofficial "the organization consists of members providing property or services";
}

relation members_jointly_contract_to_trade_or_barter(org: Person) kind empirical {
    label en unofficial "the members jointly contract to trade or barter such property or services";
}

relation barter_exchange(org: Person) kind institutional {
    label en unofficial "section 6045(c)(3): an organization of members providing property or services who jointly contract to trade or barter them";
}

@source(IRC_S6045_C, relation = formalizes, coverage = exact, quote = "The term \"barter exchange\" means any organization of members providing property or services who jointly contract to trade or barter such property or services.")
rule S6045cBarterExchangeDefinition strict {
    for org: Person;
    when organization_of_members_providing_property_or_services(org);
    when members_jointly_contract_to_trade_or_barter(org);
    then barter_exchange(org);
}

relation regularly_acts_as_middleman_for_consideration(person: Person) kind empirical {
    label en unofficial "the person for consideration regularly acts as a middleman with respect to property or services";
}

relation regularly_provides_digital_asset_transfer_service_for_consideration(person: Person) kind empirical {
    label en unofficial "the person for consideration is responsible for regularly providing any service effectuating transfers of digital assets on behalf of another person";
}

relation activity_only_managing_farm_for_another(person: Person) kind empirical {
    label en unofficial "the person's activities consist of managing a farm on behalf of another person";
}

relation broker_by_definition(person: Person) kind institutional {
    label en unofficial "the person is a broker under section 6045(c)(1)";
}

@source(IRC_S6045_C, relation = formalizes, coverage = exact, quote = "a dealer,")
rule S6045cBrokerDealer defeasible {
    for person: Person;
    when person_is_dealer(person);
    then broker_by_definition(person);
    unless activity_only_managing_farm_for_another(person);
}

@source(IRC_S6045_C, relation = formalizes, coverage = exact, quote = "a barter exchange,")
rule S6045cBrokerBarterExchange defeasible {
    for person: Person;
    when barter_exchange(person);
    then broker_by_definition(person);
    unless activity_only_managing_farm_for_another(person);
}

@source(IRC_S6045_C, relation = formalizes, coverage = exact, quote = "any person who (for consideration) regularly acts as a middleman with respect to property or services, and")
rule S6045cBrokerMiddleman defeasible {
    for person: Person;
    when regularly_acts_as_middleman_for_consideration(person);
    then broker_by_definition(person);
    unless activity_only_managing_farm_for_another(person);
}

@source(IRC_S6045_C, relation = formalizes, coverage = exact, quote = "any person who (for consideration) is responsible for regularly providing any service effectuating transfers of digital assets on behalf of another person.")
rule S6045cBrokerDigitalAssetService defeasible {
    for person: Person;
    when regularly_provides_digital_asset_transfer_service_for_consideration(person);
    then broker_by_definition(person);
    unless activity_only_managing_farm_for_another(person);
}

relation broker_transacted_business_for(broker: Person, customer: Person) kind empirical {
    label en unofficial "the broker has transacted any business for the person";
}

relation customer_of_broker(customer: Person, broker: Person) kind institutional {
    label en unofficial "section 6045(c)(2): a person for whom the broker has transacted any business";
}

@source(IRC_S6045_C, relation = formalizes, coverage = exact, quote = "The term \"customer\" means any person for whom the broker has transacted any business.")
rule S6045cCustomerDefinition strict {
    for broker: Person;
    for customer: Person;
    when broker_transacted_business_for(broker, customer);
    then customer_of_broker(customer, broker);
}

// ============================================================================
// §6045(d) — statements for substitute payments
// ============================================================================

pub enum SubstitutePaymentItem {
    PaymentInLieuOfDividend;
    PaymentInLieuOfTaxExemptInterest;
    PaymentInLieuOfOtherItemPrescribed;
}

relation short_sale_transfer_with_payment_in_lieu(broker: Person, customer: Person, y: TaxableYear, item: SubstitutePaymentItem) kind empirical {
    label en unofficial "the broker transferred securities of the customer for use in a short sale or similar transaction and, while it was open, received on the customer's behalf a payment in lieu of the item, in the calendar year";
}

relation substitute_payment_statement_furnished(broker: Person, customer: Person, y: TaxableYear, item: SubstitutePaymentItem) kind empirical {
    label en unofficial "case fact: the broker furnished the statement identifying the payment as in lieu of the item";
}

@source(IRC_S6045_D, relation = formalizes, coverage = exact, quote = "the broker shall furnish such customer a written statement (in the manner as the Secretary shall prescribe by regulations) identifying such payment as being in lieu of the dividend, tax-exempt interest, or such other item.")
rule S6045dSubstitutePaymentStatementDuty defeasible {
    for broker: Person;
    for customer: Person;
    for y: TaxableYear;
    for item: SubstitutePaymentItem;
    for end_date: Date;
    when short_sale_transfer_with_payment_in_lieu(broker, customer, y, item);
    when us.irc.core::ends(y, end_date);
    then duty FurnishSubstitutePaymentStatement {
        bearer broker;
        beneficiary customer;
        goal achievement {
            condition substitute_payment_statement_furnished(broker, customer, y, item);
            window [-infinity, add_calendar_period(add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 1 calendar_month), 14 calendar_day)];
        }
    };
    then payee_statement_required(broker, customer, y, SubstitutePaymentStatement6045D);
}

// ============================================================================
// §6045(e) — real estate transactions
// ============================================================================

pub enum RealEstateReportingRole {
    ClosingPerson;
    MortgageLender;
    SellersBroker;
    BuyersBroker;
    OtherPersonDesignatedByRegulation;
}

relation involved_in_real_estate_transaction(person: Person, tx: us.irc.core::Asset, rrole: RealEstateReportingRole) kind empirical {
    label en unofficial "the person is involved in the real estate transaction in this capacity";
}

relation role_present_in_real_estate_transaction(tx: us.irc.core::Asset, rrole: RealEstateReportingRole) kind institutional {
    label en unofficial "some person is involved in the transaction in this capacity";
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "any of the following persons involved in a real estate transaction in the following order:")
rule S6045ePresenceOfRole strict {
    for person: Person;
    for tx: us.irc.core::Asset;
    for rrole: RealEstateReportingRole;
    when involved_in_real_estate_transaction(person, tx, rrole);
    then role_present_in_real_estate_transaction(tx, rrole);
}

relation real_estate_reporting_person(person: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6045(e)(2): the highest-ranked person involved in the transaction in the statutory order";
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "the person (including any attorney or title company) responsible for closing the transaction,")
rule S6045eReportingPersonClosing strict {
    for person: Person;
    for tx: us.irc.core::Asset;
    when involved_in_real_estate_transaction(person, tx, ClosingPerson);
    then real_estate_reporting_person(person, tx);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "the mortgage lender,")
rule S6045eReportingPersonLender defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    when involved_in_real_estate_transaction(person, tx, MortgageLender);
    when not_known(role_present_in_real_estate_transaction(tx, ClosingPerson));
    then real_estate_reporting_person(person, tx);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "the seller's broker,")
rule S6045eReportingPersonSellersBroker defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    when involved_in_real_estate_transaction(person, tx, SellersBroker);
    when not_known(role_present_in_real_estate_transaction(tx, ClosingPerson));
    when not_known(role_present_in_real_estate_transaction(tx, MortgageLender));
    then real_estate_reporting_person(person, tx);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "the buyer's broker, or")
rule S6045eReportingPersonBuyersBroker defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    when involved_in_real_estate_transaction(person, tx, BuyersBroker);
    when not_known(role_present_in_real_estate_transaction(tx, ClosingPerson));
    when not_known(role_present_in_real_estate_transaction(tx, MortgageLender));
    when not_known(role_present_in_real_estate_transaction(tx, SellersBroker));
    then real_estate_reporting_person(person, tx);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "such other person designated in regulations prescribed by the Secretary.")
rule S6045eReportingPersonDesignated defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    when involved_in_real_estate_transaction(person, tx, OtherPersonDesignatedByRegulation);
    when not_known(role_present_in_real_estate_transaction(tx, ClosingPerson));
    when not_known(role_present_in_real_estate_transaction(tx, MortgageLender));
    when not_known(role_present_in_real_estate_transaction(tx, SellersBroker));
    when not_known(role_present_in_real_estate_transaction(tx, BuyersBroker));
    then real_estate_reporting_person(person, tx);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "Any person treated as a real estate reporting person under the preceding sentence shall be treated as a broker for purposes of subsection (c)(1).")
rule S6045eReportingPersonIsBroker defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    when real_estate_reporting_person(person, tx);
    then broker_by_definition(person);
}

relation real_estate_sale_reportable(person: Person, tx: us.irc.core::Asset, seller: Person, y: TaxableYear) kind empirical {
    label en unofficial "the real estate transaction closes in the calendar year, with this seller";
}

relation residence_sale_price(tx: us.irc.core::Asset, price: Money) kind empirical {
    label en unofficial "the sale or exchange price of the residence";
}

relation seller_written_assurance_principal_residence(tx: us.irc.core::Asset, seller: Person) kind empirical {
    label en unofficial "the reporting person received written assurance in a form acceptable to the Secretary that the residence is the seller's principal residence (section 121)";
}

relation seller_written_assurance_no_federal_subsidy(tx: us.irc.core::Asset, seller: Person) kind empirical {
    label en unofficial "written assurance that there is no federally subsidized mortgage financing assistance on the mortgage (if the Secretary requires that information)";
}

relation seller_written_assurance_full_gain_excludable(tx: us.irc.core::Asset, seller: Person) kind empirical {
    label en unofficial "written assurance that the full amount of the gain is excludable under section 121";
}

relation seller_written_assurance_married(tx: us.irc.core::Asset, seller: Person) kind empirical {
    label en unofficial "the seller's written assurance includes that the seller is married";
}

relation real_estate_reporting_exempt_by_assurance(tx: us.irc.core::Asset, seller: Person) kind institutional {
    label en unofficial "section 6045(e)(5)(A): paragraph (1) does not apply to this sale or exchange";
}

relation seller_for_6045e5(person: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6045(e)(5)(B): the seller, including the person relinquishing the residence in an exchange";
}

relation person_relinquishing_residence_in_exchange(person: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the person relinquishes the residence in an exchange";
}

relation seller_of_residence(person: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the person sells the residence";
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"seller\" includes the person relinquishing the residence in an exchange.")
rule S6045eSellerIsSeller strict {
    for person: Person;
    for tx: us.irc.core::Asset;
    when seller_of_residence(person, tx);
    then seller_for_6045e5(person, tx);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"seller\" includes the person relinquishing the residence in an exchange.")
rule S6045eSellerIncludesRelinquisher strict {
    for person: Person;
    for tx: us.irc.core::Asset;
    when person_relinquishing_residence_in_exchange(person, tx);
    then seller_for_6045e5(person, tx);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any sale or exchange of a residence for $250,000 or less if the person referred to in paragraph (2) receives written assurance in a form acceptable to the Secretary from the seller that—")
rule S6045eAssuranceExemptionUpTo250000 strict {
    for tx: us.irc.core::Asset;
    for seller: Person;
    for price: Money;
    when seller_for_6045e5(seller, tx);
    when residence_sale_price(tx, price);
    when price <= 250000 USD;
    when seller_written_assurance_principal_residence(tx, seller);
    when seller_written_assurance_no_federal_subsidy(tx, seller);
    when seller_written_assurance_full_gain_excludable(tx, seller);
    then real_estate_reporting_exempt_by_assurance(tx, seller);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "If such assurance includes an assurance that the seller is married, the preceding sentence shall be applied by substituting \"$500,000\" for \"$250,000\".")
rule S6045eAssuranceExemptionMarriedUpTo500000 strict {
    for tx: us.irc.core::Asset;
    for seller: Person;
    for price: Money;
    when seller_for_6045e5(seller, tx);
    when residence_sale_price(tx, price);
    when price <= 500000 USD;
    when seller_written_assurance_married(tx, seller);
    when seller_written_assurance_principal_residence(tx, seller);
    when seller_written_assurance_no_federal_subsidy(tx, seller);
    when seller_written_assurance_full_gain_excludable(tx, seller);
    then real_estate_reporting_exempt_by_assurance(tx, seller);
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "the real estate reporting person shall file a return under subsection (a) and a statement under subsection (b) with respect to such transaction.")
rule S6045eRealEstateReturnDuty defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for seller: Person;
    for y: TaxableYear;
    when real_estate_reporting_person(person, tx);
    when real_estate_sale_reportable(person, tx, seller, y);
    when not_known(real_estate_reporting_exempt_by_assurance(tx, seller));
    then duty MakeRealEstateReturn {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(person, seller, y, BrokerProceeds6045);
            window [-infinity, infinity];
        }
    };
    then information_return_required(person, seller, y, BrokerProceeds6045);
}

relation separately_charges_customer_for_reporting(person: Person, tx: us.irc.core::Asset, customer: Person) kind empirical {
    label en unofficial "the reporting person separately charges the customer for complying with paragraph (1)";
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "It shall be unlawful for any real estate reporting person to separately charge any customer for complying with any requirement of paragraph (1).")
rule S6045eNoSeparateChargeProhibition defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for customer: Person;
    when real_estate_reporting_person(person, tx);
    when separately_charges_customer_for_reporting(person, tx, customer);
    then prohibition NoSeparateChargeForRealEstateReporting {
        bearer person;
        action separately_charges_customer_for_reporting(person, tx, customer);
        window [-infinity, infinity];
    };
}

relation real_estate_transaction_involves_residence(tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the real estate transaction involves a residence";
}

@source(IRC_S6045_E, relation = formalizes, coverage = exact, quote = "The portion of any real property tax which is treated as a tax imposed on the purchaser by reason of section 164(d)(1)(B).")
rule S6045eResidenceReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, BrokerProceeds6045);
    when real_estate_return_of_residence(payer, payee, y);
    then required_return_item(payer, y, BrokerProceeds6045, I6045_RealPropertyTaxTreatedAsPurchasersTax);
    then required_return_item(payer, y, BrokerProceeds6045, I6045_SellerFinancingFederallySubsidized);
}

relation real_estate_return_of_residence(person: Person, seller: Person, y: TaxableYear) kind empirical {
    label en unofficial "the return is made for a real estate transaction involving a residence";
}

// ============================================================================
// §6045(f) — payments to attorneys
// ============================================================================

relation payment_to_attorney_for_legal_services(payer: Person, attorney: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person, in the course of a trade or business, pays an attorney in connection with legal services (whether or not performed for the payor)";
}

relation attorney_payment_portion_reported_under_6041a_or_6051(payer: Person, attorney: Person, y: TaxableYear) kind empirical {
    label en unofficial "the payment is required to be reported under section 6041(a) (or would be but for its dollar limitation) or section 6051";
}

@source(IRC_S6045_F, relation = formalizes, coverage = exact, quote = "shall file a return under subsection (a) and a statement under subsection (b) with respect to such payment.")
rule S6045fAttorneyPaymentReturnDuty defeasible {
    for payer: Person;
    for attorney: Person;
    for y: TaxableYear;
    for amount: Money;
    when trade_or_business(payer);
    when payment_to_attorney_for_legal_services(payer, attorney, y, amount);
    then duty MakeAttorneyPaymentReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, attorney, y, BrokerProceeds6045);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, attorney, y, BrokerProceeds6045);
    unless attorney_payment_portion_reported_under_6041a_or_6051(payer, attorney, y);
}

// ============================================================================
// §6045(g), (h) — covered securities, applicable dates, special rules, options
// ============================================================================

pub enum SecurityClass {
    StockNonAverageBasis;
    StockAverageBasis;
    DebtInstrument;
    CommodityOrDerivative;
    DigitalAsset;
    OtherFinancialInstrument;
}

relation specified_security_class(security: us.irc.core::Asset, cls: SecurityClass) kind empirical {
    label en unofficial "the security's class among the section 6045(g)(3)(B) list: stock (average-basis or not), debt instrument, commodity or derivative, digital asset, other financial instrument";
}

external judgment relation secretary_determines_adjusted_basis_reporting_appropriate(security: us.irc.core::Asset) {
    authority Secretary;
    label en unofficial "the Secretary determines that adjusted basis reporting is appropriate for the commodity, contract, derivative or other financial instrument (section 6045(g)(3)(B)(iii), (v); DECISION-0194)";
}

relation specified_security(security: us.irc.core::Asset) kind institutional {
    label en unofficial "the security is a specified security (section 6045(g)(3)(B))";
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "any share of stock in a corporation,")
rule S6045gSpecifiedStock strict {
    for security: us.irc.core::Asset;
    when specified_security_class(security, StockNonAverageBasis);
    then specified_security(security);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "any share of stock in a corporation,")
rule S6045gSpecifiedStockAverageBasis strict {
    for security: us.irc.core::Asset;
    when specified_security_class(security, StockAverageBasis);
    then specified_security(security);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "any note, bond, debenture, or other evidence of indebtedness,")
rule S6045gSpecifiedDebt strict {
    for security: us.irc.core::Asset;
    when specified_security_class(security, DebtInstrument);
    then specified_security(security);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "any digital asset, and")
rule S6045gSpecifiedDigitalAsset strict {
    for security: us.irc.core::Asset;
    when specified_security_class(security, DigitalAsset);
    then specified_security(security);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "any commodity, or contract or derivative with respect to such commodity, if the Secretary determines that adjusted basis reporting is appropriate for purposes of this subsection,")
rule S6045gSpecifiedCommodity strict {
    for security: us.irc.core::Asset;
    when specified_security_class(security, CommodityOrDerivative);
    when secretary_determines_adjusted_basis_reporting_appropriate(security);
    then specified_security(security);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "any other financial instrument with respect to which the Secretary determines that adjusted basis reporting is appropriate for purposes of this subsection.")
rule S6045gSpecifiedOtherInstrument strict {
    for security: us.irc.core::Asset;
    when specified_security_class(security, OtherFinancialInstrument);
    when secretary_determines_adjusted_basis_reporting_appropriate(security);
    then specified_security(security);
}

relation security_acquired_in_dividend_reinvestment_plan(security: us.irc.core::Asset) kind empirical {
    label en unofficial "the stock was acquired in connection with a dividend reinvestment plan";
}

relation security_acquired_on(security: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the date the security was acquired";
}

relation broker_elects_out_of_drip_rule(security: us.irc.core::Asset) kind empirical {
    label en unofficial "the broker elects not to have section 6045(g)(6) apply to the stock";
}

relation drip_stock_treated_as_average_basis_class(security: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6045(g)(6): stock acquired before 2012 in a dividend reinvestment plan is treated as average-basis stock for the applicable date";
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "stock acquired before January 1, 2012, in connection with a dividend reinvestment plan shall be treated as stock described in clause (ii) of paragraph (3)(C) (unless the broker with respect to such stock elects not to have this paragraph apply with respect to such stock).")
rule S6045gDripRuleApplies defeasible {
    for security: us.irc.core::Asset;
    for d: Date;
    when security_acquired_in_dividend_reinvestment_plan(security);
    when security_acquired_on(security, d);
    when d < @2012-01-01;
    then drip_stock_treated_as_average_basis_class(security);
    unless broker_elects_out_of_drip_rule(security);
}

relation applicable_date_of_security(security: us.irc.core::Asset, d: Date) kind institutional {
    label en unofficial "section 6045(g)(3)(C): the applicable date for the security";
}

relation secretary_later_applicable_date(security: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "case fact: a later applicable date the Secretary determined for another specified security";
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "January 1, 2011, in the case of any specified security which is stock in a corporation (other than any stock described in clause (ii)),")
rule S6045gApplicableDateStock2011 defeasible {
    for security: us.irc.core::Asset;
    when specified_security_class(security, StockNonAverageBasis);
    when specified_security(security);
    then applicable_date_of_security(security, @2011-01-01);
    unless drip_stock_treated_as_average_basis_class(security);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "January 1, 2012, in the case of any stock for which an average basis method is permissible under section 1012,")
rule S6045gApplicableDateAverageBasisStock2012 defeasible {
    for security: us.irc.core::Asset;
    when specified_security_class(security, StockAverageBasis);
    when specified_security(security);
    then applicable_date_of_security(security, @2012-01-01);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "January 1, 2012, in the case of any stock for which an average basis method is permissible under section 1012,")
rule S6045gApplicableDateDripStock2012 defeasible {
    for security: us.irc.core::Asset;
    when drip_stock_treated_as_average_basis_class(security);
    when specified_security(security);
    then applicable_date_of_security(security, @2012-01-01);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "January 1, 2023, in the case of any specified security which is a digital asset, and")
rule S6045gApplicableDateDigitalAsset2023 defeasible {
    for security: us.irc.core::Asset;
    when specified_security_class(security, DigitalAsset);
    when specified_security(security);
    then applicable_date_of_security(security, @2023-01-01);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "January 1, 2013, or such later date determined by the Secretary in the case of any other specified security.")
rule S6045gApplicableDateOther2013DebtInstrument defeasible {
    for security: us.irc.core::Asset;
    when specified_security_class(security, DebtInstrument);
    when specified_security(security);
    then applicable_date_of_security(security, @2013-01-01);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "January 1, 2013, or such later date determined by the Secretary in the case of any other specified security.")
rule S6045gApplicableDateOther2013CommodityOrDerivative defeasible {
    for security: us.irc.core::Asset;
    when specified_security_class(security, CommodityOrDerivative);
    when specified_security(security);
    then applicable_date_of_security(security, @2013-01-01);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "January 1, 2013, or such later date determined by the Secretary in the case of any other specified security.")
rule S6045gApplicableDateOther2013OtherFinancialInstrument defeasible {
    for security: us.irc.core::Asset;
    when specified_security_class(security, OtherFinancialInstrument);
    when specified_security(security);
    then applicable_date_of_security(security, @2013-01-01);
}

@source(IRC_S6045_G, relation = formalizes, coverage = partial, quote = "January 1, 2013, or such later date determined by the Secretary in the case of any other specified security.")
rule S6045gApplicableDateSecretaryLater defeasible {
    for security: us.irc.core::Asset;
    for d: Date;
    when secretary_later_applicable_date(security, d);
    when specified_security(security);
    then applicable_date_of_security(security, d);
}

relation acquired_through_transaction_in_account(security: us.irc.core::Asset, broker: Person, customer: Person) kind empirical {
    label en unofficial "the security was acquired through a transaction in the account in which it is held";
}

relation transferred_in_from_account_where_covered(security: us.irc.core::Asset, broker: Person, customer: Person) kind empirical {
    label en unofficial "the security was transferred to the account from an account in which it was a covered security";
}

relation broker_received_6045a_statement(broker: Person, security: us.irc.core::Asset) kind empirical {
    label en unofficial "the broker received a statement under section 6045A with respect to the transfer";
}

relation covered_security_by_definition(broker: Person, customer: Person, security: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6045(g)(3)(A): a specified security acquired on or after the applicable date through a transaction in the account, or transferred in from an account where it was covered and with a section 6045A statement";
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "was acquired through a transaction in the account in which such security is held, or")
rule S6045gCoveredSecurityAcquiredInAccount defeasible {
    for broker: Person;
    for customer: Person;
    for security: us.irc.core::Asset;
    for acq: Date;
    for app: Date;
    when specified_security(security);
    when security_acquired_on(security, acq);
    when applicable_date_of_security(security, app);
    when acq >= app;
    when acquired_through_transaction_in_account(security, broker, customer);
    then covered_security_by_definition(broker, customer, security);
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "was transferred to such account from an account in which such security was a covered security, but only if the broker received a statement under section 6045A with respect to the transfer.")
rule S6045gCoveredSecurityTransferredIn defeasible {
    for broker: Person;
    for customer: Person;
    for security: us.irc.core::Asset;
    for acq: Date;
    for app: Date;
    when specified_security(security);
    when security_acquired_on(security, acq);
    when applicable_date_of_security(security, app);
    when acq >= app;
    when transferred_in_from_account_where_covered(security, broker, customer);
    when broker_received_6045a_statement(broker, security);
    then covered_security_by_definition(broker, customer, security);
}

relation s_corporation_acquired_covered_security_after_2011(c: Person, security: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "an S corporation (not a financial institution) acquired the covered security on this date";
}

relation treated_as_partnership_for_6045(c: Person, security: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6045(g)(4): the S corporation is treated in the same manner as a partnership for the section";
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "such S corporation shall be treated in the same manner as a partnership for purposes of this section.")
rule S6045gSCorporationTreatedAsPartnership strict {
    for c: Person;
    for security: us.irc.core::Asset;
    for d: Date;
    when s_corporation_acquired_covered_security_after_2011(c, security, d);
    when d > @2011-12-31;
    then treated_as_partnership_for_6045(c, security);
}

relation short_sale_closed_on(sale: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the short sale is closed on this date";
}

relation short_sale_reporting_year(sale: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en unofficial "section 6045(g)(5): reporting for a short sale is made for the year in which the sale is closed";
}

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "In the case of a short sale, reporting under this section shall be made for the year in which such sale is closed.")
rule S6045gShortSaleReportedInYearClosed strict {
    for sale: us.irc.core::Asset;
    for y: TaxableYear;
    for d: Date;
    for s: Date;
    for e: Date;
    when short_sale_closed_on(sale, d);
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, e);
    when s <= d;
    when d <= e;
    then short_sale_reporting_year(sale, y);
}

relation option_lapse_closing_or_cash_settled_exercise_on(option: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the option on a specified security lapses, is closed out (section 1234(b)(2)(A)) or, if cash-settled, is exercised on this date";
}

relation option_granted_or_acquired_on(option: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the date the option was granted or acquired";
}

relation option_reporting_year(option: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en unofficial "section 6045(h)(2): reporting under subsections (a) and (g) is made for the calendar year that includes the date";
}

@source(IRC_S6045_H, relation = formalizes, coverage = exact, quote = "reporting under subsections (a) and (g) with respect to such option shall be made for the calendar year which includes the date of such lapse, closing transaction, or exercise.")
rule S6045hOptionReportedInYearOfLapseOrClosing strict {
    for option: us.irc.core::Asset;
    for y: TaxableYear;
    for d: Date;
    for g: Date;
    for s: Date;
    for e: Date;
    when option_lapse_closing_or_cash_settled_exercise_on(option, d);
    when option_granted_or_acquired_on(option, g);
    when g >= @2013-01-01;
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, e);
    when s <= d;
    when d <= e;
    then option_reporting_year(option, y);
}

// ============================================================================
// §6045A — transfers of covered securities
// ============================================================================

relation applicable_person_by_regulation(person: Person) kind empirical {
    label en unofficial "the Secretary has provided by regulation that the person is an applicable person";
}

relation applicable_person_6045a(person: Person) kind institutional {
    label en unofficial "section 6045A(b): a broker, or any other person as provided by the Secretary in regulations";
}

@source(IRC_S6045A_B, relation = formalizes, coverage = exact, quote = "any broker (as defined in section 6045(c)(1)), and")
rule S6045AApplicablePersonBroker defeasible {
    for person: Person;
    when broker_by_definition(person);
    then applicable_person_6045a(person);
}

@source(IRC_S6045A_B, relation = formalizes, coverage = exact, quote = "any other person as provided by the Secretary in regulations.")
rule S6045AApplicablePersonByRegulation strict {
    for person: Person;
    when applicable_person_by_regulation(person);
    then applicable_person_6045a(person);
}

relation transfer_of_covered_security_to_broker(transferor: Person, broker: Person, security: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the applicable person transfers to a broker a covered security in the hands of the transferor on this date";
}

relation transfer_statement_furnished(transferor: Person, broker: Person, security: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "case fact: the transferor furnished the broker the written statement";
}

@source(IRC_S6045A_A, relation = formalizes, coverage = exact, quote = "shall furnish to such broker a written statement in such manner and setting forth such information as the Secretary may by regulations prescribe for purposes of enabling such broker to meet the requirements of section 6045(g).")
rule S6045ATransferStatementDuty defeasible {
    for transferor: Person;
    for broker: Person;
    for security: us.irc.core::Asset;
    for d: Date;
    when applicable_person_6045a(transferor);
    when transfer_of_covered_security_to_broker(transferor, broker, security, d);
    then duty FurnishCoveredSecurityTransferStatement {
        bearer transferor;
        beneficiary broker;
        goal achievement {
            condition transfer_statement_furnished(transferor, broker, security, d);
            window [d, add_calendar_period(d, 15 calendar_day)];
        }
    };
}

relation digital_asset_transfer_out_of_broker_account(broker: Person, y: TaxableYear, security: us.irc.core::Asset) kind empirical {
    label en unofficial "the broker transfers a digital-asset covered security during the calendar year from an account it maintains (not as part of a sale or exchange it executes) to an account not maintained by, or an address not associated with, a person the broker knows or has reason to know is also a broker";
}

relation digital_asset_transfer_to_non_broker_destination(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the broker makes such a transfer of a digital-asset covered security in the calendar year (section 6045A(d))";
}

@source(IRC_S6045A_D, relation = formalizes, coverage = exact, quote = "shall make a return for such calendar year, in such form as determined by the Secretary, showing the information otherwise required to be furnished with respect to transfers subject to subsection (a).")
rule S6045AdDigitalAssetTransferReturnDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when digital_asset_transfer_to_non_broker_destination(filer, y);
    then duty MakeDigitalAssetTransferReturn {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, DigitalAssetTransferReturn6045A);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, DigitalAssetTransferReturn6045A);
}

// ============================================================================
// §6045B — issuer returns of organizational actions affecting basis
// ============================================================================

relation issuer_of_specified_security(issuer: Person, security: us.irc.core::Asset) kind empirical {
    label en unofficial "the person is the issuer of the specified security";
}

relation organizational_action_affecting_basis_on(issuer: Person, security: us.irc.core::Asset, org_action: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the issuer takes an organizational action affecting the basis of the specified security on this date";
}

relation organizational_action_return_filed(issuer: Person, org_action: us.irc.core::Asset) kind empirical {
    label en unofficial "case fact: the issuer filed the section 6045B return";
}

relation organizational_action_return_latest_date(org_action: us.irc.core::Asset, d: Date) kind institutional {
    label en unofficial "section 6045B(b): the earlier of 45 days after the action and January 15 of the following year";
}

@source(IRC_S6045B_B, relation = formalizes, coverage = exact, quote = "45 days after the date of the action described in subsection (a), or")
rule S6045BLatestDateFortyFiveDays defeasible {
    for issuer: Person;
    for security: us.irc.core::Asset;
    for org_action: us.irc.core::Asset;
    for d: Date;
    for y: TaxableYear;
    for e: Date;
    for s: Date;
    when organizational_action_affecting_basis_on(issuer, security, org_action, d);
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, e);
    when s <= d;
    when d <= e;
    when add_calendar_period(d, 45 calendar_day) <= add_calendar_period(e, 15 calendar_day);
    then organizational_action_return_latest_date(org_action, add_calendar_period(d, 45 calendar_day));
}

@source(IRC_S6045B_B, relation = formalizes, coverage = exact, quote = "January 15 of the year following the calendar year during which such action occurred.")
rule S6045BLatestDateJanuary15 defeasible {
    for issuer: Person;
    for security: us.irc.core::Asset;
    for org_action: us.irc.core::Asset;
    for d: Date;
    for y: TaxableYear;
    for e: Date;
    for s: Date;
    when organizational_action_affecting_basis_on(issuer, security, org_action, d);
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, e);
    when s <= d;
    when d <= e;
    when add_calendar_period(e, 15 calendar_day) < add_calendar_period(d, 45 calendar_day);
    then organizational_action_return_latest_date(org_action, add_calendar_period(e, 15 calendar_day));
}

relation action_occurs_before_applicable_date(issuer: Person, security: us.irc.core::Asset, org_action: us.irc.core::Asset, d: Date) kind institutional {
    label en unofficial "the action occurs before the applicable date of the security (no return required)";
}

@source(IRC_S6045B_D, relation = formalizes, coverage = exact, quote = "No return shall be required under this section with respect to actions described in subsection (a) with respect to a specified security which occur before the applicable date (as defined in section 6045(g)(3)(C)) with respect to such security.")
rule S6045BNoReturnBeforeApplicableDate defeasible {
    for issuer: Person;
    for security: us.irc.core::Asset;
    for org_action: us.irc.core::Asset;
    for d: Date;
    for app: Date;
    when organizational_action_affecting_basis_on(issuer, security, org_action, d);
    when applicable_date_of_security(security, app);
    when d < app;
    then action_occurs_before_applicable_date(issuer, security, org_action, d);
}

@source(IRC_S6045B_A, relation = formalizes, coverage = exact, quote = "any issuer of a specified security shall make a return setting forth—")
rule S6045BIssuerReturnDuty defeasible {
    for issuer: Person;
    for security: us.irc.core::Asset;
    for org_action: us.irc.core::Asset;
    for d: Date;
    for latest: Date;
    for y: TaxableYear;
    for s: Date;
    for e: Date;
    when issuer_of_specified_security(issuer, security);
    when specified_security(security);
    when organizational_action_affecting_basis_on(issuer, security, org_action, d);
    when organizational_action_return_latest_date(org_action, latest);
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, e);
    when s <= d;
    when d <= e;
    when not_known(action_occurs_before_applicable_date(issuer, security, org_action, d));
    when not_known(waiver_of_6045B_requirements(issuer, security));
    then duty MakeOrganizationalActionReturn {
        bearer issuer;
        beneficiary Secretary;
        goal achievement {
            condition organizational_action_return_filed(issuer, org_action);
            window [d, latest];
        }
    };
    then information_return_required(issuer, Secretary, y, OrganizationalActionReturn6045B);
}

@source(IRC_S6045B_A, relation = formalizes, coverage = exact, quote = "a description of any organizational action which affects the basis of such specified security of such issuer,")
rule S6045BReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, OrganizationalActionReturn6045B);
    then required_return_item(payer, y, OrganizationalActionReturn6045B, I6045B_DescriptionOfOrganizationalAction);
    then required_return_item(payer, y, OrganizationalActionReturn6045B, I6045B_QuantitativeEffectOnBasis);
    then required_return_item(payer, y, OrganizationalActionReturn6045B, I6045B_OtherInformationAsPrescribed);
}

// ============================================================================
// §6045B (c), (e) — statements to holders and waiver by public reporting (stage 2 addition)
// ============================================================================

relation nominee_or_certificate_holder_of_specified_security(holder: Person, security: us.irc.core::Asset) kind empirical {
    label en unofficial "the person is the nominee with respect to the specified security (or the certificate holder if there is no nominee)";
}

relation organizational_action_statement_furnished(issuer: Person, holder: Person, org_action: us.irc.core::Asset) kind empirical {
    label en unofficial "the issuer furnished the written statement of the organizational action to the nominee or holder";
}

relation issuer_publicly_reports_contact_information(issuer: Person, security: us.irc.core::Asset) kind empirical {
    label en unofficial "the issuer makes publicly available the name, address, phone number and email address of its information contact";
}

relation issuer_publicly_reports_return_information(issuer: Person, security: us.irc.core::Asset) kind empirical {
    label en unofficial "the issuer makes publicly available the information described in section 6045B(a)(1), (2) and (3)";
}

external judgment relation secretary_waives_6045B_requirements(issuer: Person, security: us.irc.core::Asset) {
    authority Secretary;
    label en unofficial "the Secretary waives the requirements of subsections (a) and (c) for the specified security (a judgment of the Secretary, in such form and manner as he determines necessary)";
}

relation waiver_of_6045B_requirements(issuer: Person, security: us.irc.core::Asset) kind institutional {
    label en unofficial "the return and statement requirements are waived for the specified security because the issuer reports publicly";
}

@source(IRC_S6045B_E, relation = formalizes, coverage = exact, quote = "The Secretary may waive the requirements under subsections (a) and (c) with respect to a specified security, if the person required to make the return under subsection (a) makes publicly available, in such form and manner as the Secretary determines necessary to carry out the purposes of this section—")
rule S6045BeWaiverByPublicReporting defeasible {
    for issuer: Person;
    for security: us.irc.core::Asset;
    when issuer_of_specified_security(issuer, security);
    when issuer_publicly_reports_contact_information(issuer, security);
    when issuer_publicly_reports_return_information(issuer, security);
    when secretary_waives_6045B_requirements(issuer, security);
    then waiver_of_6045B_requirements(issuer, security);
}

@source(IRC_S6045B_C, relation = formalizes, coverage = exact, quote = "every person required to make a return under subsection (a) with respect to a specified security shall furnish to the nominee with respect to the specified security (or certificate holder if there is no nominee) a written statement showing—")
rule S6045BcStatementToHolderDuty defeasible {
    for issuer: Person;
    for holder: Person;
    for security: us.irc.core::Asset;
    for org_action: us.irc.core::Asset;
    for d: Date;
    for y: TaxableYear;
    for s: Date;
    for e: Date;
    when issuer_of_specified_security(issuer, security);
    when specified_security(security);
    when organizational_action_affecting_basis_on(issuer, security, org_action, d);
    when nominee_or_certificate_holder_of_specified_security(holder, security);
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, e);
    when s <= d;
    when d <= e;
    when not_known(action_occurs_before_applicable_date(issuer, security, org_action, d));
    when not_known(waiver_of_6045B_requirements(issuer, security));
    then duty FurnishOrganizationalActionStatementToHolder {
        bearer issuer;
        beneficiary holder;
        goal achievement {
            condition organizational_action_statement_furnished(issuer, holder, org_action);
            window [d, add_calendar_period(e, 15 calendar_day)];
        }
    };
    then payee_statement_required(issuer, holder, y, OrganizationalActionReturn6045B);
    then payee_statement_due(issuer, y, OrganizationalActionReturn6045B, add_calendar_period(e, 15 calendar_day));
}

@source(IRC_S6045B_C, relation = formalizes, coverage = exact, quote = "the name, address, and phone number of the information contact of the person required to make such return,")
rule S6045BcStatementContentContact defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, OrganizationalActionReturn6045B);
    then required_statement_item(payer, y, OrganizationalActionReturn6045B, I6045B_NameAddressPhoneOfInformationContact);
}

@source(IRC_S6045B_C, relation = formalizes, coverage = exact, quote = "the information required to be shown on such return with respect to such security, and")
rule S6045BcStatementContentReturnInformation defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, OrganizationalActionReturn6045B);
    then required_statement_item(payer, y, OrganizationalActionReturn6045B, I6045B_InformationRequiredOnReturnWithRespectToSecurity);
}

@source(IRC_S6045B_C, relation = formalizes, coverage = partial, quote = "such other information as the Secretary may prescribe.")
rule S6045BcStatementContentOther defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, OrganizationalActionReturn6045B);
    then required_statement_item(payer, y, OrganizationalActionReturn6045B, I6045B_OtherInformationTheSecretaryMayPrescribe);
}
