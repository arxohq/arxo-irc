// Information reporting -- WIRE-10 group C (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Early modules of this package (03, 04) declared classification placeholders (`is_broker`, `is_payment_settlement_entity`,
// `is_third_party_settlement_organization`) as "pending: not this package's norm" although later modules of the SAME package
// (09, 15) formalize the very definitions (section 6045(c)(1); section 6050W(b)(1), (b)(3)). The placeholders are derived from the
// package's own definitions here (owner = this package: no import, no cycle). The case-fact channel stays valid.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Person,
    broker_by_definition,
    is_broker,
    is_payment_settlement_entity,
    is_third_party_settlement_organization,
    payment_settlement_entity_defined,
    third_party_settlement_organization_defined,
};

rule W10CBrokerFromSection6045cDefinition defeasible {
    label en official "section 6045(a): a person doing business as a broker is the person the package classifies as a broker under section 6045(c)(1)";
    for broker: Person;
    when broker_by_definition(broker);
    then is_broker(broker);
}

rule W10CPaymentSettlementEntityFromSection6050WbDefinition strict {
    label en official "section 6050W(a): the payment settlement entity that makes the return is the person defined by section 6050W(b)(1) (merchant acquiring entity or third party settlement organization)";
    for obligor: Person;
    when payment_settlement_entity_defined(obligor);
    then is_payment_settlement_entity(obligor);
}

rule W10CThirdPartySettlementOrganizationFromSection6050Wb3Definition strict {
    label en official "section 6050W(e): the third party settlement organization to which the de minimis exception applies is the central organization of section 6050W(b)(3)";
    for obligor: Person;
    when third_party_settlement_organization_defined(obligor);
    then is_third_party_settlement_organization(obligor);
}
