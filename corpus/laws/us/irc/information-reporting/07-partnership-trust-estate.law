// §6031(c)-(f), §6032, §6034, §6034A (rest), §6035, §6036, §6037(c)
// (remaining sentences) — partnership, common trust fund, trust, estate
// and fiduciary information duties of package `us.irc.information_reporting`,
// module 07 (STAGE 2). Every duty is a `duty` position; elections and
// discretionary Secretary acts are `power`s; the (d), (f) content rules add
// `required_statement_item` conclusions instead of prose-only comments.
//
// JUDGMENT CALLS
//  - §6031(a)'s stage-1 rule became defeasible so that §6031(e)(1)'s
//    foreign-partnership exception can be an `unless`; (e)(2)'s "except as
//    provided in regulations" is a case fact (`regulation_excepts_foreign_
//    partnership`), never a guessed regulation.
//  - The stage-1 §6034A(a) beneficiary-statement rule used the W-2 kind
//    by mistake; it now names `EstateTrustBeneficiaryStatement6034A`.
//  - §6035's "earlier of" outer limit is decided by pairwise candidates
//    (TECH-GAPS G136 pattern); the Secretary's own earlier prescribed time
//    is not modelled (SOURCE_GAP: no regulation pinned).

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Estate,
    IRC_S6031_C,
    IRC_S6031_D,
    IRC_S6031_E,
    IRC_S6031_F,
    IRC_S6032,
    IRC_S6034A_A,
    IRC_S6034A_B,
    IRC_S6034A_C,
    IRC_S6034_A,
    IRC_S6034_B,
    IRC_S6035_A,
    IRC_S6036,
    InformationReturnKind,
    Organ,
    Partnership,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    Trust,
    filed_information_return,
    information_return_required,
    is_beneficiary_or_nominee,
    payee_statement_required,
    required_return_item,
    required_statement_item,
};

// ============================================================================
// §6031(c)-(f) — nominee reporting, UBTI, foreign and electing investment partnerships
// ============================================================================

relation holds_partnership_interest_as_nominee(nominee: Person, p: Partnership, beneficial_owner: Person, y: TaxableYear) kind empirical {
    label en unofficial "the nominee holds an interest in the partnership for another person at any time during the taxable year (section 6031(c))";
}

relation nominee_furnished_partnership_identity(nominee: Person, p: Partnership, beneficial_owner: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the nominee furnished the partnership the other person's name, address and prescribed information";
}

relation nominee_forwarded_partnership_information(nominee: Person, p: Partnership, beneficial_owner: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the nominee furnished the other person the information the partnership provided under section 6031(b)";
}

@source(IRC_S6031_C, relation = formalizes, coverage = exact, quote = "shall furnish to the partnership, in the manner prescribed by the Secretary, the name and address of such other person")
rule S6031NomineeFurnishesIdentityToPartnershipDuty defeasible {
    for nominee: Person;
    for p: Partnership;
    for beneficial_owner: Person;
    for y: TaxableYear;
    when holds_partnership_interest_as_nominee(nominee, p, beneficial_owner, y);
    then duty FurnishNomineeIdentityToPartnership {
        bearer nominee;
        beneficiary p;
        goal achievement {
            condition nominee_furnished_partnership_identity(nominee, p, beneficial_owner, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6031_C, relation = formalizes, coverage = exact, quote = "shall furnish in the manner prescribed by the Secretary such other person the information provided by such partnership under subsection (b).")
rule S6031NomineeForwardsPartnershipInformationDuty defeasible {
    for nominee: Person;
    for p: Partnership;
    for beneficial_owner: Person;
    for y: TaxableYear;
    when holds_partnership_interest_as_nominee(nominee, p, beneficial_owner, y);
    then duty ForwardPartnershipInformationToBeneficialOwner {
        bearer nominee;
        beneficiary beneficial_owner;
        goal achievement {
            condition nominee_forwarded_partnership_information(nominee, p, beneficial_owner, y);
            window [-infinity, infinity];
        }
    };
}

relation partnership_regularly_carries_on_trade_or_business_512c1(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the partnership regularly carries on a trade or business within the meaning of section 512(c)(1) (pending: exempt-organizations, section 512)";
}

@source(IRC_S6031_D, relation = formalizes, coverage = partial, quote = "the information required under subsection (b) to be furnished to its partners shall include such information as is necessary to enable each partner to compute its distributive share of partnership income or loss from such trade or business in accordance with section 512(a)(1)")
rule S6031UbtiInformationInPartnerCopy defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PartnershipReturnOfIncome6031);
    when partnership_regularly_carries_on_trade_or_business_512c1(payer, y);
    then required_statement_item(payer, y, PartnershipReturnOfIncome6031, I6031_UbtiDistributiveShareInformation);
}

relation foreign_partnership(p: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "the partnership is a foreign partnership for the taxable year (pending: us.irc.definitions, section 7701(a)(5))";
}

relation foreign_partnership_us_source_gross_income(p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "section 6031(e)(2)(A): the partnership has gross income derived from sources within the United States";
}

relation foreign_partnership_effectively_connected_gross_income(p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "section 6031(e)(2)(B): the partnership has gross income effectively connected with a United States trade or business";
}

relation regulation_excepts_foreign_partnership(p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "case fact: a Secretary regulation excepts this foreign partnership from section 6031(e)(2)";
}

relation foreign_partnership_has_us_nexus(p: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "section 6031(e)(2): the section applies to the foreign partnership for the year";
}

relation foreign_partnership_excluded_from_6031(p: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "section 6031(e)(1): the section does not apply to this foreign partnership";
}

@source(IRC_S6031_E, relation = formalizes, coverage = exact, quote = "gross income derived from sources within the United States, or")
rule S6031ForeignPartnershipUsSourceNexus defeasible {
    for p: Partnership;
    for y: TaxableYear;
    when foreign_partnership(p, y);
    when foreign_partnership_us_source_gross_income(p, y);
    then foreign_partnership_has_us_nexus(p, y);
    unless regulation_excepts_foreign_partnership(p, y);
}

@source(IRC_S6031_E, relation = formalizes, coverage = exact, quote = "gross income which is effectively connected with the conduct of a trade or business within the United States.")
rule S6031ForeignPartnershipEffectivelyConnectedNexus defeasible {
    for p: Partnership;
    for y: TaxableYear;
    when foreign_partnership(p, y);
    when foreign_partnership_effectively_connected_gross_income(p, y);
    then foreign_partnership_has_us_nexus(p, y);
    unless regulation_excepts_foreign_partnership(p, y);
}

@source(IRC_S6031_E, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), the preceding provisions of this section shall not apply to a foreign partnership.")
rule S6031ForeignPartnershipException defeasible {
    for p: Partnership;
    for y: TaxableYear;
    when foreign_partnership(p, y);
    when not_known(foreign_partnership_has_us_nexus(p, y));
    then foreign_partnership_excluded_from_6031(p, y);
}

relation simplified_foreign_partnership_procedure_requested(secretary: Organ, p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary provides simplified filing procedures for the foreign partnership (the exercise)";
}

relation simplified_foreign_partnership_procedure_available(p: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "simplified filing procedures are available to the foreign partnership for the year";
}

@source(IRC_S6031_E, relation = formalizes, coverage = exact, quote = "The Secretary may provide simplified filing procedures for foreign partnerships to which this section applies.")
rule S6031SimplifiedFilingProceduresPower defeasible {
    for p: Partnership;
    for y: TaxableYear;
    when foreign_partnership_has_us_nexus(p, y);
    then power SecretaryProvidesSimplifiedForeignPartnershipProcedures {
        holder us.irc.core::Secretary; over p;
        exercise simplified_foreign_partnership_procedure_requested(us.irc.core::Secretary, p, y);
        valid_when foreign_partnership_has_us_nexus(p, y);
        effect create(simplified_foreign_partnership_procedure_available(p, y));
        window [-infinity, infinity];
    };
}

relation electing_investment_partnership_partner(p: Person, partner: Person, y: TaxableYear) kind institutional {
    label en unofficial "the partnership is an electing investment partnership (section 743(e)(6)) and section 743(e)(2) applies to this partner (pending: partnerships)";
}

@source(IRC_S6031_F, relation = formalizes, coverage = partial, quote = "shall include such information as is necessary to enable the partner to compute the amount of losses disallowed under section 743(e)")
rule S6031ElectingInvestmentPartnershipInformation defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PartnershipReturnOfIncome6031);
    when electing_investment_partnership_partner(payer, payee, y);
    then required_statement_item(payer, y, PartnershipReturnOfIncome6031, I6031_LossesDisallowedUnder743e);
}

// ============================================================================
// §6032 — common trust fund return
// ============================================================================

relation bank_maintains_common_trust_fund(bank: Person, y: TaxableYear) kind empirical {
    label en unofficial "the bank (section 581) maintains a common trust fund during the taxable year";
}

@source(IRC_S6032, relation = formalizes, coverage = exact, quote = "Every bank (as defined in section 581) maintaining a common trust fund shall make a return for each taxable year")
rule S6032CommonTrustFundReturnDuty defeasible {
    for bank: Person;
    for y: TaxableYear;
    when bank_maintains_common_trust_fund(bank, y);
    then duty MakeCommonTrustFundReturn {
        bearer bank;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(bank, Secretary, y, CommonTrustFundReturn6032);
            window [-infinity, infinity];
        }
    };
    then information_return_required(bank, Secretary, y, CommonTrustFundReturn6032);
}

@source(IRC_S6032, relation = formalizes, coverage = partial, quote = "stating specifically, with respect to such fund, the items of gross income and the deductions allowed by subtitle A, and shall include in the return the names and addresses of the participants")
rule S6032ReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, CommonTrustFundReturn6032);
    then required_return_item(payer, y, CommonTrustFundReturn6032, I6032_GrossIncomeItems);
    then required_return_item(payer, y, CommonTrustFundReturn6032, I6032_DeductionsAllowedBySubtitleA);
    then required_return_item(payer, y, CommonTrustFundReturn6032, I6032_ParticipantNamesAndAddresses);
    then required_return_item(payer, y, CommonTrustFundReturn6032, I6032_ProportionateShareOfEachParticipant);
}

// ============================================================================
// §6034 — split-interest trusts and trusts claiming §642(c) deductions
// ============================================================================

relation trust_described_in_4947a2(t: Trust, y: TaxableYear) kind institutional {
    label en unofficial "the trust is a split-interest trust described in section 4947(a)(2) (pending: exempt-organizations)";
}

@source(IRC_S6034_A, relation = formalizes, coverage = exact, quote = "Every trust described in section 4947(a)(2) shall furnish such information with respect to the taxable year as the Secretary may by forms or regulations require.")
rule S6034SplitInterestTrustInformationDuty defeasible {
    for t: Trust;
    for y: TaxableYear;
    when trust_described_in_4947a2(t, y);
    then duty FurnishSplitInterestTrustInformation {
        bearer t;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(t, Secretary, y, SplitInterestTrustInformation6034A);
            window [-infinity, infinity];
        }
    };
    then information_return_required(t, Secretary, y, SplitInterestTrustInformation6034A);
}

relation trust_claims_642c_deduction(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "the trust claims a deduction under section 642(c) for the taxable year";
}

relation trust_required_to_distribute_all_net_income_currently(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "section 6034(b)(2)(A): all the net income for the year is required to be distributed currently to the beneficiaries";
}

relation trust_described_in_4947a1(t: Trust, y: TaxableYear) kind institutional {
    label en unofficial "the trust is a nonexempt charitable trust described in section 4947(a)(1) (pending: exempt-organizations)";
}

relation trust_outside_6034b(t: Trust, y: TaxableYear) kind institutional {
    label en unofficial "section 6034(b)(1) does not apply: the trust files under subsection (a) or an exception of (b)(2) applies";
}

@source(IRC_S6034_B, relation = formalizes, coverage = exact, quote = "Every trust not required to file a return under subsection (a) but claiming a deduction under section 642(c)")
rule S6034bOutsideByPartA strict {
    for t: Trust;
    for y: TaxableYear;
    when trust_described_in_4947a2(t, y);
    then trust_outside_6034b(t, y);
}

@source(IRC_S6034_B, relation = formalizes, coverage = exact, quote = "all the net income for such year, determined under the applicable principles of the law of trusts, is required to be distributed currently to the beneficiaries, or")
rule S6034bException2A strict {
    for t: Trust;
    for y: TaxableYear;
    when trust_required_to_distribute_all_net_income_currently(t, y);
    then trust_outside_6034b(t, y);
}

@source(IRC_S6034_B, relation = formalizes, coverage = exact, quote = "the trust is described in section 4947(a)(1).")
rule S6034bException2B strict {
    for t: Trust;
    for y: TaxableYear;
    when trust_described_in_4947a1(t, y);
    then trust_outside_6034b(t, y);
}

@source(IRC_S6034_B, relation = formalizes, coverage = exact, quote = "shall furnish such information with respect to such taxable year as the Secretary may by forms or regulations prescribe, including—")
rule S6034bTrustCharitableDeductionInformationDuty defeasible {
    for t: Trust;
    for y: TaxableYear;
    when trust_claims_642c_deduction(t, y);
    then duty FurnishTrustCharitableDeductionInformation {
        bearer t;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(t, Secretary, y, TrustCharitableDeductionInformation6034B);
            window [-infinity, infinity];
        }
    };
    then information_return_required(t, Secretary, y, TrustCharitableDeductionInformation6034B);
    unless trust_outside_6034b(t, y);
}

@source(IRC_S6034_B, relation = formalizes, coverage = exact, quote = "the amount of the deduction taken under section 642(c) within such year,")
rule S6034bReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, TrustCharitableDeductionInformation6034B);
    then required_return_item(payer, y, TrustCharitableDeductionInformation6034B, I6034_Deduction642cTakenInYear);
    then required_return_item(payer, y, TrustCharitableDeductionInformation6034B, I6034_PaidOutOfPriorYearDeductions);
    then required_return_item(payer, y, TrustCharitableDeductionInformation6034B, I6034_PriorDeductionsNotYetPaidOut);
    then required_return_item(payer, y, TrustCharitableDeductionInformation6034B, I6034_PaidOutOfPrincipalCurrentAndPrior);
    then required_return_item(payer, y, TrustCharitableDeductionInformation6034B, I6034_TotalIncomeAndAttributableExpenses);
    then required_return_item(payer, y, TrustCharitableDeductionInformation6034B, I6034_BalanceSheetAtYearStart);
}

// ============================================================================
// §6034A — statements to beneficiaries: content, nominees, consistency
// ============================================================================

@source(IRC_S6034A_A, relation = formalizes, coverage = partial, quote = "a statement containing such information required to be shown on such return as the Secretary may prescribe.")
rule S6034AStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, EstateTrustBeneficiaryStatement6034A);
    then required_statement_item(payer, y, EstateTrustBeneficiaryStatement6034A, I6034A_InformationRequiredOnEntityReturnAsPrescribed);
}

relation holds_estate_or_trust_interest_as_nominee(nominee: Person, obligor: Person, beneficial_owner: Person, y: TaxableYear) kind empirical {
    label en unofficial "the nominee holds an interest in the estate or trust for another person (section 6034A(b))";
}

relation nominee_furnished_estate_trust_identity(nominee: Person, obligor: Person, beneficial_owner: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the nominee furnished the estate or trust the other person's name and address";
}

relation nominee_forwarded_estate_trust_statement(nominee: Person, obligor: Person, beneficial_owner: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the nominee furnished the other person the information provided under section 6034A(a)";
}

@source(IRC_S6034A_B, relation = formalizes, coverage = exact, quote = "shall furnish to the estate or trust, in the manner prescribed by the Secretary, the name and address of such other person")
rule S6034ANomineeFurnishesIdentityDuty defeasible {
    for nominee: Person;
    for obligor: Person;
    for beneficial_owner: Person;
    for y: TaxableYear;
    when holds_estate_or_trust_interest_as_nominee(nominee, obligor, beneficial_owner, y);
    then duty FurnishNomineeIdentityToEstateOrTrust {
        bearer nominee;
        beneficiary obligor;
        goal achievement {
            condition nominee_furnished_estate_trust_identity(nominee, obligor, beneficial_owner, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6034A_B, relation = formalizes, coverage = exact, quote = "shall furnish in the manner prescribed by the Secretary to such other person the information provided by the estate or trust under subsection (a).")
rule S6034ANomineeForwardsStatementDuty defeasible {
    for nominee: Person;
    for obligor: Person;
    for beneficial_owner: Person;
    for y: TaxableYear;
    when holds_estate_or_trust_interest_as_nominee(nominee, obligor, beneficial_owner, y);
    then duty ForwardEstateTrustInformationToBeneficialOwner {
        bearer nominee;
        beneficiary beneficial_owner;
        goal achievement {
            condition nominee_forwarded_estate_trust_statement(nominee, obligor, beneficial_owner, y);
            window [-infinity, infinity];
        }
    };
}

relation beneficiary_item_at_issue_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor: a reported item of the estate or trust is treated on the beneficiary's return in the case";
}

relation beneficiary_treats_item_consistently(beneficiary: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6034A(c)(1): the beneficiary treats the reported item consistently with the entity return";
}

relation entity_filed_return_6034a(obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the estate or trust has filed its return";
}

relation beneficiary_treatment_may_be_inconsistent_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 6034A(c)(2)(A)(i)(I): the beneficiary's treatment is or may be inconsistent with the entity return";
}

relation beneficiary_files_inconsistency_statement_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 6034A(c)(2)(A)(ii): the beneficiary files a statement identifying the inconsistency";
}

relation beneficiary_demonstrates_consistency_with_statement_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 6034A(c)(2)(B)(i): the beneficiary demonstrates to the Secretary's satisfaction that the treatment matches the statement furnished under subsection (a)";
}

relation beneficiary_elects_statement_treatment_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 6034A(c)(2)(B)(ii): the beneficiary elects to have the paragraph apply to the item (the exercise)";
}

relation beneficiary_treated_as_complied_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "the beneficiary is treated as having complied with section 6034A(c)(2)(A)(ii)";
}

relation beneficiary_notified_inconsistency_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "the beneficiary either filed the inconsistency statement or is treated as having complied through the (B) path";
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "the beneficiary files with the Secretary a statement identifying the inconsistency,")
rule S6034ABeneficiaryFiledStatement strict {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when beneficiary_files_inconsistency_statement_6034a(beneficiary, obligor, y);
    then beneficiary_notified_inconsistency_6034a(beneficiary, obligor, y);
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "elects to have this paragraph apply with respect to that item.")
rule S6034ABeneficiaryElectionPower defeasible {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when beneficiary_item_at_issue_6034a(beneficiary, obligor, y);
    then power ElectStatementConsistentTreatment6034A {
        holder beneficiary; over obligor;
        exercise beneficiary_elects_statement_treatment_6034a(beneficiary, obligor, y);
        valid_when beneficiary_demonstrates_consistency_with_statement_6034a(beneficiary, obligor, y);
        effect create(beneficiary_treated_as_complied_6034a(beneficiary, obligor, y));
        window [-infinity, infinity];
    };
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "A beneficiary shall be treated as having complied with clause (ii) of subparagraph (A)")
rule S6034ABeneficiaryTreatedAsComplied strict {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when beneficiary_demonstrates_consistency_with_statement_6034a(beneficiary, obligor, y);
    when beneficiary_elects_statement_treatment_6034a(beneficiary, obligor, y);
    then beneficiary_notified_inconsistency_6034a(beneficiary, obligor, y);
}

relation beneficiary_consistency_at_issue_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6034A(c)(2)(A)(i): the entity return was filed and the treatment is or may be inconsistent, or the entity has not filed a return";
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "the applicable entity has filed a return but the beneficiary's treatment on such beneficiary's return is (or may be) inconsistent with the treatment of the item on the applicable entity's return, or")
rule S6034AConsistencyAtIssueInconsistent strict {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when beneficiary_treatment_may_be_inconsistent_6034a(beneficiary, obligor, y);
    then beneficiary_consistency_at_issue_6034a(beneficiary, obligor, y);
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "the applicable entity has not filed a return, and")
rule S6034AConsistencyAtIssueNoEntityReturn strict {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when beneficiary_item_at_issue_6034a(beneficiary, obligor, y);
    when not_known(entity_filed_return_6034a(obligor, y));
    then beneficiary_consistency_at_issue_6034a(beneficiary, obligor, y);
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "A beneficiary of any estate or trust to which subsection (a) applies shall, on such beneficiary's return, treat any reported item in a manner which is consistent with the treatment of such item on the applicable entity's return.")
rule S6034ABeneficiaryConsistencyDuty defeasible {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when beneficiary_item_at_issue_6034a(beneficiary, obligor, y);
    when beneficiary_consistency_at_issue_6034a(beneficiary, obligor, y);
    then duty TreatReportedItemConsistently6034A {
        bearer beneficiary;
        beneficiary Secretary;
        goal achievement {
            condition beneficiary_treats_item_consistently(beneficiary, obligor, y);
            window [-infinity, infinity];
        }
    };
    unless beneficiary_notified_inconsistency_6034a(beneficiary, obligor, y);
}

relation beneficiary_adjustment_is_math_error_6034a(beneficiary: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6034A(c)(3): the inconsistency adjustment is treated as a mathematical or clerical error assessed under section 6213(b)(1)";
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "any adjustment required to make the treatment of the items by such beneficiary consistent with the treatment of the items on the applicable entity's return shall be treated as arising out of mathematical or clerical errors and assessed according to section 6213(b)(1)")
rule S6034AInconsistentAdjustmentIsMathError defeasible {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when beneficiary_treatment_may_be_inconsistent_6034a(beneficiary, obligor, y);
    when not_known(beneficiary_notified_inconsistency_6034a(beneficiary, obligor, y));
    then beneficiary_adjustment_is_math_error_6034a(beneficiary, obligor, y);
}

relation reported_item_of_estate_or_trust(beneficiary: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6034A(c)(4)(A): an item for which information is required to be furnished under subsection (a)";
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "The term \"reported item\" means any item for which information is required to be furnished under subsection (a).")
rule S6034AReportedItemDefinition strict {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when is_beneficiary_or_nominee(beneficiary, obligor, y);
    then reported_item_of_estate_or_trust(beneficiary, obligor, y);
}

relation applicable_entity_of_beneficiary(obligor: Person, beneficiary: Person) kind institutional {
    label en unofficial "section 6034A(c)(4)(B): the estate or trust of which the taxpayer is the beneficiary";
}

@source(IRC_S6034A_C, relation = formalizes, coverage = exact, quote = "The term \"applicable entity\" means the estate or trust of which the taxpayer is the beneficiary.")
rule S6034AApplicableEntityDefinition strict {
    for beneficiary: Person;
    for obligor: Person;
    for y: TaxableYear;
    when is_beneficiary_or_nominee(beneficiary, obligor, y);
    then applicable_entity_of_beneficiary(obligor, beneficiary);
}

// ============================================================================
// §6035 — basis consistency: statements by executors and beneficiaries
// ============================================================================

relation executor_required_to_file_6018a(executor: Person, estate: Estate) kind institutional {
    label en unofficial "the executor of the estate is required to file a return under section 6018(a) (pending: estate-gift)";
}

relation person_required_to_file_6018b(person: Person, estate: Estate) kind institutional {
    label en unofficial "the person is required to file a return under section 6018(b) (pending: estate-gift)";
}

relation acquires_interest_in_property_of_estate(recipient: Person, estate: Estate) kind empirical {
    label en unofficial "the person acquires an interest in property included in the decedent's gross estate (or holds a legal or beneficial interest in the property to which the section 6018 return relates)";
}

relation estate_return_6018_required_date(estate: Estate, d: Date) kind empirical {
    label en unofficial "the date on which the section 6018 return was required to be filed, including extensions";
}

relation estate_return_6018_filed(estate: Estate) kind empirical {
    label en unofficial "positive marker: the section 6018 return has been filed";
}

relation estate_return_6018_filed_on(estate: Estate, d: Date) kind empirical {
    label en unofficial "the date on which the section 6018 return was filed";
}

relation estate_statement_6035_latest_date(estate: Estate, d: Date) kind institutional {
    label en unofficial "section 6035(a)(3)(A): the earlier of 30 days after the required filing date or 30 days after the actual filing date";
}

@source(IRC_S6035_A, relation = formalizes, coverage = exact, quote = "the date which is 30 days after the date on which the return under section 6018 was required to be filed (including extensions, if any), or")
rule S6035LatestDateFromRequiredDate defeasible {
    for estate: Estate;
    for d1: Date;
    for d2: Date;
    when estate_return_6018_required_date(estate, d1);
    when estate_return_6018_filed_on(estate, d2);
    when add_calendar_period(d1, 30 calendar_day) <= add_calendar_period(d2, 30 calendar_day);
    then estate_statement_6035_latest_date(estate, add_calendar_period(d1, 30 calendar_day));
}

@source(IRC_S6035_A, relation = formalizes, coverage = exact, quote = "the date which is 30 days after the date such return is filed.")
rule S6035LatestDateFromFilingDate defeasible {
    for estate: Estate;
    for d1: Date;
    for d2: Date;
    when estate_return_6018_required_date(estate, d1);
    when estate_return_6018_filed_on(estate, d2);
    when add_calendar_period(d2, 30 calendar_day) < add_calendar_period(d1, 30 calendar_day);
    then estate_statement_6035_latest_date(estate, add_calendar_period(d2, 30 calendar_day));
}

@source(IRC_S6035_A, relation = formalizes, coverage = partial, quote = "in no case at a time later than the earlier of—")
rule S6035LatestDateBeforeFiling defeasible {
    for estate: Estate;
    for d1: Date;
    when estate_return_6018_required_date(estate, d1);
    when not_known(estate_return_6018_filed(estate));
    then estate_statement_6035_latest_date(estate, add_calendar_period(d1, 30 calendar_day));
}

relation estate_statement_furnished_to_secretary(executor: Person, estate: Estate) kind empirical {
    label en unofficial "case fact: the statement was furnished to the Secretary";
}

relation estate_statement_furnished_to_recipient(executor: Person, estate: Estate, recipient: Person) kind empirical {
    label en unofficial "case fact: the statement was furnished to the person acquiring an interest";
}

@source(IRC_S6035_A, relation = formalizes, coverage = exact, quote = "shall furnish to the Secretary and to each person acquiring any interest in property included in the decedent's gross estate for Federal estate tax purposes a statement identifying the value of each interest in such property as reported on such return")
rule S6035ExecutorStatementToSecretaryDuty defeasible {
    for executor: Person;
    for estate: Estate;
    for d: Date;
    when executor_required_to_file_6018a(executor, estate);
    when estate_statement_6035_latest_date(estate, d);
    then duty FurnishBasisStatementToSecretary {
        bearer executor;
        beneficiary Secretary;
        goal achievement {
            condition estate_statement_furnished_to_secretary(executor, estate);
            window [-infinity, d];
        }
    };
}

@source(IRC_S6035_A, relation = formalizes, coverage = exact, quote = "shall furnish to the Secretary and to each person acquiring any interest in property included in the decedent's gross estate for Federal estate tax purposes a statement identifying the value of each interest in such property as reported on such return")
rule S6035ExecutorStatementToRecipientDuty defeasible {
    for executor: Person;
    for estate: Estate;
    for recipient: Person;
    for d: Date;
    when executor_required_to_file_6018a(executor, estate);
    when acquires_interest_in_property_of_estate(recipient, estate);
    when estate_statement_6035_latest_date(estate, d);
    then duty FurnishBasisStatementToRecipient {
        bearer executor;
        beneficiary recipient;
        goal achievement {
            condition estate_statement_furnished_to_recipient(executor, estate, recipient);
            window [-infinity, d];
        }
    };
}

@source(IRC_S6035_A, relation = formalizes, coverage = exact, quote = "shall furnish to the Secretary and to each other person who holds a legal or beneficial interest in the property to which such return relates a statement identifying the information described in paragraph (1).")
rule S6035BeneficiaryStatementDuty defeasible {
    for person: Person;
    for estate: Estate;
    for recipient: Person;
    for d: Date;
    when person_required_to_file_6018b(person, estate);
    when acquires_interest_in_property_of_estate(recipient, estate);
    when estate_statement_6035_latest_date(estate, d);
    then duty FurnishBasisStatementByBeneficiary6018b {
        bearer person;
        beneficiary recipient;
        goal achievement {
            condition estate_statement_furnished_to_recipient(person, estate, recipient);
            window [-infinity, d];
        }
    };
}

relation basis_statement_adjustment_made_on(estate: Estate, d: Date) kind empirical {
    label en unofficial "the date on which information required on a filed section 6035 statement is adjusted";
}

relation supplemental_basis_statement_filed(executor: Person, estate: Estate, d: Date) kind empirical {
    label en unofficial "case fact: a supplemental statement was filed on this adjustment date";
}

@source(IRC_S6035_A, relation = formalizes, coverage = exact, quote = "a supplemental statement under such paragraph shall be filed not later than the date which is 30 days after such adjustment is made.")
rule S6035SupplementalStatementDuty defeasible {
    for executor: Person;
    for estate: Estate;
    for adj: Date;
    when executor_required_to_file_6018a(executor, estate);
    when basis_statement_adjustment_made_on(estate, adj);
    then duty FileSupplementalBasisStatement {
        bearer executor;
        beneficiary Secretary;
        goal achievement {
            condition supplemental_basis_statement_filed(executor, estate, adj);
            window [adj, add_calendar_period(adj, 30 calendar_day)];
        }
    };
}

// ============================================================================
// §6036 — notice of qualification as executor or receiver
// ============================================================================

relation qualifies_as_fiduciary_6036(fiduciary: Person, y: TaxableYear) kind empirical {
    label en unofficial "the receiver, title 11 trustee, assignee for the benefit of creditors, like fiduciary or executor has qualified as such";
}

relation fiduciary_gave_notice_of_qualification(fiduciary: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the fiduciary gave the Secretary notice of qualification";
}

relation secretary_exempts_from_6036(fiduciary: Person, y: TaxableYear) kind institutional {
    label en unofficial "computational twin of the exemption power (E-0134): the Secretary has provided an exemption from the notice requirement for this fiduciary";
}

relation secretary_exemption_in_effect_6036(fiduciary: Person, y: TaxableYear) kind institutional {
    label en unofficial "effect of the exemption power: the exemption is in force";
}

relation secretary_provides_6036_exemption(secretary: Organ, fiduciary: Person, y: TaxableYear) kind empirical {
    label en unofficial "the exercise: the Secretary provides the exemption by regulation";
}

@source(IRC_S6036, relation = formalizes, coverage = exact, quote = "shall give notice of his qualification as such to the Secretary in such manner and at such time as may be required by regulations of the Secretary.")
rule S6036NoticeOfQualificationDuty defeasible {
    for fiduciary: Person;
    for y: TaxableYear;
    when qualifies_as_fiduciary_6036(fiduciary, y);
    then duty GiveNoticeOfQualification {
        bearer fiduciary;
        beneficiary Secretary;
        goal achievement {
            condition fiduciary_gave_notice_of_qualification(fiduciary, y);
            window [-infinity, infinity];
        }
    };
    unless secretary_exempts_from_6036(fiduciary, y);
}

@source(IRC_S6036, relation = formalizes, coverage = exact, quote = "The Secretary may by regulation provide such exemptions from the requirements of this section as the Secretary deems proper.")
rule S6036ExemptionTwin strict {
    for fiduciary: Person;
    for y: TaxableYear;
    when qualifies_as_fiduciary_6036(fiduciary, y);
    when secretary_provides_6036_exemption(us.irc.core::Secretary, fiduciary, y);
    then secretary_exempts_from_6036(fiduciary, y);
}

@source(IRC_S6036, relation = formalizes, coverage = exact, quote = "The Secretary may by regulation provide such exemptions from the requirements of this section as the Secretary deems proper.")
rule S6036ExemptionPower defeasible {
    for fiduciary: Person;
    for y: TaxableYear;
    when qualifies_as_fiduciary_6036(fiduciary, y);
    then power SecretaryExemptsFiduciaryFromNotice {
        holder us.irc.core::Secretary; over fiduciary;
        exercise secretary_provides_6036_exemption(us.irc.core::Secretary, fiduciary, y);
        valid_when qualifies_as_fiduciary_6036(fiduciary, y);
        effect create(secretary_exemption_in_effect_6036(fiduciary, y));
        window [-infinity, infinity];
    };
}
