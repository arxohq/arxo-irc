// §6050 - §6050Q of package `us.irc.information_reporting`, module 14
// (STAGE 2): the returns of fishing boat operators, unemployment
// compensation, energy subsidies, state tax refunds, social security and
// railroad retirement benefits, mortgage interest (rest), cash receipts
// (rest, incl. court clerks), foreclosures and abandonments, partnership
// exchanges, donee dispositions, Federal contracts, royalties, discharge
// of indebtedness (rest) and long-term care benefits.
//
// JUDGMENT CALLS
//  - Statements to payees run through `std_stmt`-style pairs (due date
//    rule + duty with a window ending at the statutory date); the
//    January/February wording of the text is the window end.
//  - "Officer or employee having control of the payment" definitions
//    (§6050B(c)(2), §6050D(b), §6050E(c), §6050J(d)(2), §6050P(c)(3))
//    are executed as the designated-officer duty over
//    `governmental_unit` / `designated_officer_for_return`.
//  - Amounts left to regulations (which items, which persons) are case
//    facts ("regulation requires ...") and never invented.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Corporation,
    IRC_S6050A_A,
    IRC_S6050A_B,
    IRC_S6050B_A,
    IRC_S6050B_B,
    IRC_S6050B_C,
    IRC_S6050D_A,
    IRC_S6050D_B,
    IRC_S6050E_A,
    IRC_S6050E_B,
    IRC_S6050E_C,
    IRC_S6050F_A,
    IRC_S6050F_B,
    IRC_S6050F_C,
    IRC_S6050G_A,
    IRC_S6050G_B,
    IRC_S6050H_B,
    IRC_S6050H_C,
    IRC_S6050H_D,
    IRC_S6050H_E,
    IRC_S6050H_F,
    IRC_S6050H_G,
    IRC_S6050H_H,
    IRC_S6050I_B,
    IRC_S6050I_C,
    IRC_S6050I_D,
    IRC_S6050I_E,
    IRC_S6050I_G,
    IRC_S6050J_A,
    IRC_S6050J_C,
    IRC_S6050J_D,
    IRC_S6050J_E,
    IRC_S6050J_F,
    IRC_S6050K_A,
    IRC_S6050K_B,
    IRC_S6050K_C,
    IRC_S6050L_A,
    IRC_S6050L_B,
    IRC_S6050L_C,
    IRC_S6050M_A,
    IRC_S6050M_B,
    IRC_S6050M_E,
    IRC_S6050N_A,
    IRC_S6050N_B,
    IRC_S6050N_C,
    IRC_S6050P_A,
    IRC_S6050P_C,
    IRC_S6050P_D,
    IRC_S6050P_E,
    IRC_S6050Q_A,
    IRC_S6050Q_B,
    IRC_S6050Q_C,
    Individual,
    InformationReturnKind,
    Organ,
    PayeeClass6049b4,
    Person,
    ReturnItem,
    Secretary,
    SecurityClass,
    TaxableYear,
    cash_receipt_excepted,
    cash_received_in_transaction,
    designated_officer_for_return,
    filed_information_return,
    furnished_payee_statement,
    governmental_unit,
    information_return_required,
    is_applicable_entity_6050P,
    payee_in_class_6049b4,
    payee_statement_due,
    payee_statement_required,
    required_return_item,
    required_statement_item,
};

// ============================================================================
// §6050 (repealed), §6050A — fishing boat operators
// ============================================================================

relation boat_operator_with_crew_services_3121b20(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the operator of a boat on which one or more individuals perform services described in section 3121(b)(20) during the calendar year";
}

@source(IRC_S6050A_A, relation = formalizes, coverage = exact, quote = "shall submit to the Secretary (at such time, and in such manner and form, as the Secretary shall by regulations prescribe) information respecting—")
rule S6050AReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when boat_operator_with_crew_services_3121b20(payer, payee, y);
    then duty SubmitFishingCrewInformation {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, FishingCrewInformation6050A);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, FishingCrewInformation6050A);
}

relation crew_member_receives_share_in_kind(operator: Person, crew: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual receives his share of the catch in kind";
}

relation crew_member_receives_share_of_proceeds(operator: Person, crew: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual receives a share of the proceeds of the catches";
}

@source(IRC_S6050A_A, relation = formalizes, coverage = partial, quote = "the identity of each individual performing such services;")
rule S6050AaIdentityAndShares defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, FishingCrewInformation6050A);
    then required_return_item(payer, y, FishingCrewInformation6050A, I6050A_IdentityOfEachIndividual);
    then required_return_item(payer, y, FishingCrewInformation6050A, I6050A_PercentageOfEachIndividualsShareAndOperatorsShare);
    then required_return_item(payer, y, FishingCrewInformation6050A, I6050A_CashRemunerationUnder3121b20A);
}

@source(IRC_S6050A_A, relation = formalizes, coverage = partial, quote = "if such individual receives his share in kind, the type and weight of such share, together with such other information as the Secretary may prescribe by regulations reasonably necessary to determine the value of such share;")
rule S6050AaInKindShare defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, FishingCrewInformation6050A);
    when crew_member_receives_share_in_kind(payer, payee, y);
    then required_return_item(payer, y, FishingCrewInformation6050A, I6050A_TypeAndWeightOfShareReceivedInKind);
}

@source(IRC_S6050A_A, relation = formalizes, coverage = partial, quote = "if such individual receives a share of the proceeds of such catches, the amount so received; and")
rule S6050AaProceedsShare defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, FishingCrewInformation6050A);
    when crew_member_receives_share_of_proceeds(payer, payee, y);
    then required_return_item(payer, y, FishingCrewInformation6050A, I6050A_AmountOfShareOfProceeds);
}

@source(IRC_S6050A_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050AStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, FishingCrewInformation6050A);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, FishingCrewInformation6050A, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050A_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing the information relating to such person required to be contained in such return.")
rule S6050AStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, FishingCrewInformation6050A);
    when us.irc.core::ends(y, end_date);
    then duty FurnishFishingCrewStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, FishingCrewInformation6050A);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, FishingCrewInformation6050A);
}

// ============================================================================
// §6050B — unemployment compensation
// ============================================================================

relation unemployment_compensation_payment(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person pays the individual unemployment compensation (section 85(b)) aggregating this amount during the calendar year";
}

@source(IRC_S6050B_A, relation = formalizes, coverage = exact, quote = "Every person who makes payments of unemployment compensation aggregating $10 or more to any individual during any calendar year shall make a return according to the forms or regulations prescribed by the Secretary")
rule S6050BReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when unemployment_compensation_payment(payer, payee, y, amount);
    when amount >= 10 USD;
    then duty MakeUnemploymentCompensationReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, UnemploymentCompensation6050B);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, UnemploymentCompensation6050B);
}

@source(IRC_S6050B_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the individual on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050BStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, UnemploymentCompensation6050B);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, UnemploymentCompensation6050B, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050B_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return a written statement showing—")
rule S6050BStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, UnemploymentCompensation6050B);
    when us.irc.core::ends(y, end_date);
    then duty FurnishUnemploymentCompensationStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, UnemploymentCompensation6050B);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, UnemploymentCompensation6050B);
}

@source(IRC_S6050B_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050BStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, UnemploymentCompensation6050B);
    then required_statement_item(payer, y, UnemploymentCompensation6050B, I6050B_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, UnemploymentCompensation6050B, I6050B_AggregateAmountOfPayments);
}

@source(IRC_S6050B_C, relation = formalizes, coverage = exact, quote = "The term \"person\" means the officer or employee having control of the payment of the unemployment compensation, or the person appropriately designated for purposes of this section.")
rule S6050BOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, UnemploymentCompensation6050B);
    when information_return_required(unit, payee, y, UnemploymentCompensation6050B);
    then duty MakeReturnAsDesignatedOfficer6050B {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, UnemploymentCompensation6050B);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6050C (repealed), §6050D — energy conservation subsidies
// ============================================================================

relation energy_program_financing_or_grant(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person administers a Federal, State or local program a principal purpose of which is to provide subsidized financing or grants for projects to conserve or produce energy, and the taxpayer receives this aggregate amount";
}

@source(IRC_S6050D_A, relation = formalizes, coverage = exact, quote = "shall, to the extent required under regulations prescribed by the Secretary, make a return setting forth the name and address of each taxpayer receiving financing or a grant under such program and the aggregate amount so received by such individual.")
rule S6050DReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when energy_program_financing_or_grant(payer, payee, y);
    when regulation_requires_energy_subsidy_return(payer, y);
    then duty MakeEnergySubsidyReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, EnergySubsidyReturn6050D);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, EnergySubsidyReturn6050D);
}

relation regulation_requires_energy_subsidy_return(administrator: Person, y: TaxableYear) kind empirical {
    label en unofficial "to the extent required under regulations, the program administrator makes the return";
}

@source(IRC_S6050D_B, relation = formalizes, coverage = exact, quote = "the term \"person\" means the officer or employee having control of the program, or the person appropriately designated for purposes of this section.")
rule S6050DOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, EnergySubsidyReturn6050D);
    when information_return_required(unit, payee, y, EnergySubsidyReturn6050D);
    then duty MakeReturnAsDesignatedOfficer6050D {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, EnergySubsidyReturn6050D);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6050E — State and local income tax refunds
// ============================================================================

relation state_local_income_tax_refund_payment(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person makes payments of refunds of State or local income taxes (or allows credits or offsets) to the individual aggregating this amount during the calendar year";
}

@source(IRC_S6050E_A, relation = formalizes, coverage = exact, quote = "shall make a return according to forms or regulations prescribed by the Secretary setting forth the aggregate amount of such payments, credits, or offsets, and the name and address of the individual with respect to whom such payment, credit, or offset was made.")
rule S6050EReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_local_income_tax_refund_payment(payer, payee, y, amount);
    when amount >= 10 USD;
    then duty MakeStateLocalTaxRefundReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, StateLocalTaxRefundReturn6050E);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, StateLocalTaxRefundReturn6050E);
}

relation individual_did_not_claim_itemized_deductions_for_refund_year(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "it is determined (in the manner provided by regulations) that the individual did not claim itemized deductions under chapter 1 for the taxable year giving rise to the refund, credit or offset";
}

@source(IRC_S6050E_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the individual during January of the calendar year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050EStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, StateLocalTaxRefundReturn6050E);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, StateLocalTaxRefundReturn6050E, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050E_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return a written statement showing—")
rule S6050EStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, StateLocalTaxRefundReturn6050E);
    when us.irc.core::ends(y, end_date);
    then duty FurnishStateLocalTaxRefundStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, StateLocalTaxRefundReturn6050E);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, StateLocalTaxRefundReturn6050E);
}

@source(IRC_S6050E_B, relation = formalizes, coverage = partial, quote = "the name of the State or political subdivision thereof, and")
rule S6050EStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, StateLocalTaxRefundReturn6050E);
    then required_statement_item(payer, y, StateLocalTaxRefundReturn6050E, I6050E_NameOfStateOrPoliticalSubdivision);
    then required_statement_item(payer, y, StateLocalTaxRefundReturn6050E, I6050E_InformationOnRefundsCreditsAndOffsets);
}

@source(IRC_S6050E_B, relation = formalizes, coverage = exact, quote = "No statement shall be required under this subsection with respect to any individual if it is determined (in the manner provided by regulations) that such individual did not claim itemized deductions")
rule S6050EStatementNotRequiredWithoutItemizedDeductions defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, StateLocalTaxRefundReturn6050E);
    when individual_did_not_claim_itemized_deductions_for_refund_year(payer, payee, y);
    then payee_statement_not_required_6050e(payer, payee, y);
}

relation payee_statement_not_required_6050e(payer: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050E(b): no statement is required for this individual";
}

@source(IRC_S6050E_C, relation = formalizes, coverage = exact, quote = "the term \"person\" means the officer or employee having control of the payment of the refunds (or the allowance of the credits or offsets) or the person appropriately designated for purposes of this section.")
rule S6050EOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, StateLocalTaxRefundReturn6050E);
    when information_return_required(unit, payee, y, StateLocalTaxRefundReturn6050E);
    then duty MakeReturnAsDesignatedOfficer6050E {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, StateLocalTaxRefundReturn6050E);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6050F, §6050G — social security and railroad retirement benefits
// ============================================================================

relation social_security_benefits_paid(official: Person, individual: Person, y: TaxableYear, benefits: Money) kind empirical {
    label en unofficial "the appropriate Federal official (Commissioner of Social Security for section 86(d)(1)(A) benefits; the Railroad Retirement Board for section 86(d)(1)(B) benefits) pays the individual social security benefits aggregating this amount in the calendar year";
}

relation appropriate_federal_official_6050f(official: Person) kind institutional {
    label en unofficial "the person is the appropriate Federal official: the Commissioner of Social Security or the Railroad Retirement Board (section 6050F(c)(1))";
}

relation is_commissioner_of_social_security(p: Person) kind institutional {
    label en unofficial "the person is the Commissioner of Social Security (for section 86(d)(1)(A) benefits)";
}

relation is_railroad_retirement_board(p: Person) kind institutional {
    label en unofficial "the person is the Railroad Retirement Board";
}

@source(IRC_S6050F_C, relation = formalizes, coverage = exact, quote = "the Commissioner of Social Security in the case of social security benefits described in section 86(d)(1)(A), and")
rule S6050FcCommissionerIsOfficial strict {
    for p: Person;
    when is_commissioner_of_social_security(p);
    then appropriate_federal_official_6050f(p);
}

@source(IRC_S6050F_C, relation = formalizes, coverage = exact, quote = "the Railroad Retirement Board in the case of social security benefits described in section 86(d)(1)(B).")
rule S6050FcRailroadBoardIsOfficial strict {
    for p: Person;
    when is_railroad_retirement_board(p);
    then appropriate_federal_official_6050f(p);
}
// SSA reader (IRC-G/G6, 2026-09-27): section 6050F(c)(2) gives "social
// security benefit" the section 86(d)(1) meaning (row 26/6050F/c/2/u1).
// Pattern G4/CFR: Title-26-internal content (§86(d) lives in the
// gross-income package, already in corpus) enters as a case-selected fact;
// no SSA-package pin is read here. The from-package leg waits for registry
// + lock --write + flip (step 6, owner gate).
relation benefit_within_86d1_meaning_asserted_6050Fc2(individual: Person, benefits: Money) kind empirical {
    label en unofficial "the benefits are social security benefits within the section 86(d)(1) meaning, case-asserted (Title-26-internal content)";
}
relation social_security_benefit_6050Fc2(individual: Person, benefits: Money) kind institutional {
    label en official "section 6050F(c)(2): the benefits are a social security benefit";
}
@source(IRC_S6050F_C, relation = formalizes, coverage = partial, quote = "The term \"social security benefit\" has the meaning given to such term by section 86(d)(1).")
rule S6050FC2SocialSecurityBenefitMeaning strict {
    for individual: Person;
    for benefits: Money;
    when benefit_within_86d1_meaning_asserted_6050Fc2(individual, benefits);
    then social_security_benefit_6050Fc2(individual, benefits);
}

@source(IRC_S6050F_A, relation = formalizes, coverage = exact, quote = "The appropriate Federal official shall make a return, according to the forms and regulations prescribed by the Secretary, setting forth—")
rule S6050FaReturnDuty defeasible {
    for official: Person;
    for individual: Person;
    for y: TaxableYear;
    for benefits: Money;
    when appropriate_federal_official_6050f(official);
    when social_security_benefits_paid(official, individual, y, benefits);
    then duty MakeSocialSecurityBenefitsReturn {
        bearer official;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(official, individual, y, SocialSecurityBenefitsReturn6050F);
            window [-infinity, infinity];
        }
    };
    then information_return_required(official, individual, y, SocialSecurityBenefitsReturn6050F);
}

@source(IRC_S6050F_A, relation = formalizes, coverage = exact, quote = "aggregate amount of social security benefits paid with respect to any individual during any calendar year,")
rule S6050FaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, SocialSecurityBenefitsReturn6050F);
    then required_return_item(payer, y, SocialSecurityBenefitsReturn6050F, I6050F_AggregateBenefitsPaidInYear);
    then required_return_item(payer, y, SocialSecurityBenefitsReturn6050F, I6050F_AggregateBenefitsRepaidInYear);
    then required_return_item(payer, y, SocialSecurityBenefitsReturn6050F, I6050F_AggregateReductionsUnderSection224OrRailroadRetirementAct);
    then required_return_item(payer, y, SocialSecurityBenefitsReturn6050F, I6050F_NameAndAddressOfIndividual);
}

@source(IRC_S6050F_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the individual on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050FStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, SocialSecurityBenefitsReturn6050F);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, SocialSecurityBenefitsReturn6050F, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050F_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return a written statement showing—")
rule S6050FStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, SocialSecurityBenefitsReturn6050F);
    when us.irc.core::ends(y, end_date);
    then duty FurnishSocialSecurityBenefitsStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, SocialSecurityBenefitsReturn6050F);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, SocialSecurityBenefitsReturn6050F);
}

@source(IRC_S6050F_B, relation = formalizes, coverage = partial, quote = "the name of the agency making the payments, and")
rule S6050FbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, SocialSecurityBenefitsReturn6050F);
    then required_statement_item(payer, y, SocialSecurityBenefitsReturn6050F, I6050F_NameOfAgencyMakingPayments);
    then required_statement_item(payer, y, SocialSecurityBenefitsReturn6050F, I6050F_AggregatePaymentsRepaymentsAndReductions);
}

relation railroad_retirement_benefits_paid(board: Person, individual: Person, y: TaxableYear, benefits: Money) kind empirical {
    label en unofficial "the Railroad Retirement Board pays the individual benefits under the Railroad Retirement Act of 1974 (other than tier 1) aggregating this amount in the calendar year";
}

@source(IRC_S6050G_A, relation = formalizes, coverage = exact, quote = "The Railroad Retirement Board shall make a return, according to the forms and regulations prescribed by the Secretary, setting forth—")
rule S6050GaReturnDuty defeasible {
    for board: Person;
    for individual: Person;
    for y: TaxableYear;
    for benefits: Money;
    when is_railroad_retirement_board(board);
    when railroad_retirement_benefits_paid(board, individual, y, benefits);
    then duty MakeRailroadRetirementBenefitsReturn {
        bearer board;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(board, individual, y, RailroadRetirementBenefitsReturn6050G);
            window [-infinity, infinity];
        }
    };
    then information_return_required(board, individual, y, RailroadRetirementBenefitsReturn6050G);
}

@source(IRC_S6050G_A, relation = formalizes, coverage = exact, quote = "the aggregate amount of benefits paid under the Railroad Retirement Act of 1974 (other than tier 1 railroad retirement benefits, as defined in section 86(d)(4)) to any individual during any calendar year,")
rule S6050GaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, RailroadRetirementBenefitsReturn6050G);
    then required_return_item(payer, y, RailroadRetirementBenefitsReturn6050G, I6050G_AggregateBenefitsPaidInYear);
    then required_return_item(payer, y, RailroadRetirementBenefitsReturn6050G, I6050G_EmployeeContributionsTreatedAsPaidForSection72r);
    then required_return_item(payer, y, RailroadRetirementBenefitsReturn6050G, I6050G_NameAndAddressOfIndividual);
    then required_return_item(payer, y, RailroadRetirementBenefitsReturn6050G, I6050G_OtherInformationRequiredBySecretary);
}

@source(IRC_S6050G_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the individual on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050GStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, RailroadRetirementBenefitsReturn6050G);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, RailroadRetirementBenefitsReturn6050G, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050G_B, relation = formalizes, coverage = exact, quote = "The Railroad Retirement Board shall furnish to each individual whose name is required to be set forth in the return under subsection (a) a written statement showing—")
rule S6050GStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, RailroadRetirementBenefitsReturn6050G);
    when us.irc.core::ends(y, end_date);
    then duty FurnishRailroadRetirementStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, RailroadRetirementBenefitsReturn6050G);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, RailroadRetirementBenefitsReturn6050G);
}

@source(IRC_S6050G_B, relation = formalizes, coverage = partial, quote = "the aggregate amount of payments to such individual, and of employee contributions with respect thereto, required to be shown on the return, and")
rule S6050GbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, RailroadRetirementBenefitsReturn6050G);
    then required_statement_item(payer, y, RailroadRetirementBenefitsReturn6050G, I6050G_AggregatePaymentsAndEmployeeContributions);
    then required_statement_item(payer, y, RailroadRetirementBenefitsReturn6050G, I6050G_OtherInformationRequiredBySecretary);
}

// ============================================================================
// §6050H — mortgage interest received: content, definitions, special rules, insurance premiums
// ============================================================================

@source(IRC_S6050H_B, relation = formalizes, coverage = exact, quote = "the name and address of the individual from whom the interest described in subsection (a)(2) was received,")
rule S6050HbReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MortgageInterestReceived6050H);
    then required_return_item(payer, y, MortgageInterestReceived6050H, I6050H_NameAndAddressOfIndividual);
    then required_return_item(payer, y, MortgageInterestReceived6050H, I6050H_AmountOfInterestOtherThanPoints);
    then required_return_item(payer, y, MortgageInterestReceived6050H, I6050H_AmountOfPointsAndWhetherPaidDirectlyByBorrower);
    then required_return_item(payer, y, MortgageInterestReceived6050H, I6050H_OutstandingPrincipalAtStartOfYear);
    then required_return_item(payer, y, MortgageInterestReceived6050H, I6050H_DateOfOriginationOfMortgage);
    then required_return_item(payer, y, MortgageInterestReceived6050H, I6050H_AddressOfSecuringProperty);
    then required_return_item(payer, y, MortgageInterestReceived6050H, I6050H_OtherInformationAsPrescribed);
}

@source(IRC_S6050H_D, relation = formalizes, coverage = exact, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050HdStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, MortgageInterestReceived6050H);
    then required_statement_item(payer, y, MortgageInterestReceived6050H, I6050H_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, MortgageInterestReceived6050H, I6050H_AggregateInterestOtherThanPointsAndItemsCDEF);
}

@source(IRC_S6050H_C, relation = formalizes, coverage = exact, quote = "any return required under subsection (a) shall be made by the officer or employee appropriately designated for the purpose of making such return.")
rule S6050HOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, MortgageInterestReceived6050H);
    when information_return_required(unit, payee, y, MortgageInterestReceived6050H);
    then duty MakeReturnAsDesignatedOfficer6050H {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, MortgageInterestReceived6050H);
            window [-infinity, infinity];
        }
    };
}

relation obligation_secured_by_real_property(obligation: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is secured by real property";
}

relation regulation_excepts_from_mortgage_definition(obligation: us.irc.core::Asset) kind empirical {
    label en unofficial "a Secretary regulation provides otherwise";
}

relation mortgage_6050h(obligation: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050H(e): any obligation secured by real property";
}

@source(IRC_S6050H_E, relation = formalizes, coverage = exact, quote = "For purposes of this section, except as provided in regulations prescribed by the Secretary, the term \"mortgage\" means any obligation secured by real property.")
rule S6050HeMortgageDefinition defeasible {
    for obligation: us.irc.core::Asset;
    when obligation_secured_by_real_property(obligation);
    when not_known(regulation_excepts_from_mortgage_definition(obligation));
    then mortgage_6050h(obligation);
}

relation interest_received_by_other_first_on_behalf_of_borrower(lender: Person, borrower: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the interest is received by this person on behalf of another person who received it first";
}

relation not_first_recipient_6050h(lender: Person, borrower: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6050H(f): only the person first receiving the interest on behalf of another must make the return";
}

@source(IRC_S6050H_F, relation = formalizes, coverage = exact, quote = "in the case of interest received by any person on behalf of another person, only the person first receiving such interest shall be required to make the return under subsection (a).")
rule S6050HfOnlyFirstRecipient strict {
    for lender: Person;
    for borrower: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_received_by_other_first_on_behalf_of_borrower(lender, borrower, y, amount);
    then not_first_recipient_6050h(lender, borrower, y, amount);
}

relation cooperative_housing_tenant_stockholder_payment(corp: Person, tenant: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the cooperative housing corporation receives from the tenant-stockholder this amount, to the extent of the tenant-stockholder's proportionate share of interest described in section 216(a)(2)";
}

@source(IRC_S6050H_G, relation = formalizes, coverage = exact, quote = "an amount received by a cooperative housing corporation from a tenant-stockholder shall be deemed to be interest received on a mortgage in the course of a trade or business engaged in by such corporation, to the extent of the tenant-stockholder's proportionate share of interest described in section 216(a)(2).")
rule S6050HgCooperativeHousingReturnDuty defeasible {
    for corp: Person;
    for tenant: Individual;
    for y: TaxableYear;
    for amount: Money;
    when cooperative_housing_tenant_stockholder_payment(corp, tenant, y, amount);
    when amount >= 600 USD;
    then duty MakeMortgageInterestReturnForCooperativeHousing {
        bearer corp;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(corp, tenant, y, MortgageInterestReceived6050H);
            window [-infinity, infinity];
        }
    };
    then information_return_required(corp, tenant, y, MortgageInterestReceived6050H);
}

relation mortgage_insurance_premiums_received(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person, in the course of a trade or business, receives premiums for mortgage insurance from the individual aggregating this amount during the calendar year";
}

@source(IRC_S6050H_H, relation = formalizes, coverage = exact, quote = "The Secretary may prescribe, by regulations, that any person who, in the course of a trade or business, receives from any individual premiums for mortgage insurance aggregating $600 or more for any calendar year, shall make a return with respect to each such individual.")
rule S6050HhMortgageInsuranceReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when mortgage_insurance_premiums_received(payer, payee, y, amount);
    when amount >= 600 USD;
    when regulation_requires_mortgage_insurance_return(payer, y);
    then duty MakeMortgageInsurancePremiumsReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, MortgageInsurancePremiumsReceived6050H);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, MortgageInsurancePremiumsReceived6050H);
}

relation regulation_requires_mortgage_insurance_return(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "a Secretary regulation requires the return of mortgage insurance premiums (section 6050H(h)(1))";
}

@source(IRC_S6050H_H, relation = formalizes, coverage = exact, quote = "Such written statement shall be furnished on or before January 31 of the year following the calendar year for which the return under paragraph (1) was required to be made.")
rule S6050HhStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, MortgageInsurancePremiumsReceived6050H);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, MortgageInsurancePremiumsReceived6050H, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050H_H, relation = formalizes, coverage = exact, quote = "Every person required to make a return under paragraph (1) shall furnish to each individual with respect to whom a return is made a written statement showing such information as the Secretary may prescribe.")
rule S6050HhStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, MortgageInsurancePremiumsReceived6050H);
    when us.irc.core::ends(y, end_date);
    then duty FurnishMortgageInsurancePremiumsStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, MortgageInsurancePremiumsReceived6050H);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, MortgageInsurancePremiumsReceived6050H);
}

pub enum MortgageInsuranceKind {
    VeteransAdministrationInsurance;
    FederalHousingAdministrationInsurance;
    RuralHousingServiceInsurance;
    PrivateMortgageInsurance;
}

relation insurance_kind_6050h(premium: us.irc.core::Asset, kind: MortgageInsuranceKind) kind empirical {
    label en unofficial "the kind of mortgage insurance";
}

relation mortgage_insurance_6050h(premium: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050H(h)(3)(B): mortgage insurance provided by VA, FHA or the Rural Housing Service, or private mortgage insurance (Homeowners Protection Act of 1998)";
}

@source(IRC_S6050H_H, relation = formalizes, coverage = exact, quote = "mortgage insurance provided by the Department of Veterans Affairs, the Federal Housing Administration, or the Rural Housing Service, and")
rule S6050HhMortgageInsuranceVeteransAdministrationInsurance strict {
    for premium: us.irc.core::Asset;
    when insurance_kind_6050h(premium, VeteransAdministrationInsurance);
    then mortgage_insurance_6050h(premium);
}

@source(IRC_S6050H_H, relation = formalizes, coverage = exact, quote = "mortgage insurance provided by the Department of Veterans Affairs, the Federal Housing Administration, or the Rural Housing Service, and")
rule S6050HhMortgageInsuranceFederalHousingAdministrationInsurance strict {
    for premium: us.irc.core::Asset;
    when insurance_kind_6050h(premium, FederalHousingAdministrationInsurance);
    then mortgage_insurance_6050h(premium);
}

@source(IRC_S6050H_H, relation = formalizes, coverage = exact, quote = "mortgage insurance provided by the Department of Veterans Affairs, the Federal Housing Administration, or the Rural Housing Service, and")
rule S6050HhMortgageInsuranceRuralHousingServiceInsurance strict {
    for premium: us.irc.core::Asset;
    when insurance_kind_6050h(premium, RuralHousingServiceInsurance);
    then mortgage_insurance_6050h(premium);
}

@source(IRC_S6050H_H, relation = formalizes, coverage = exact, quote = "private mortgage insurance (as defined by section 2 of the Homeowners Protection Act of 1998 (12 U.S.C. 4901), as in effect on the date of the enactment of this subsection).")
rule S6050HhMortgageInsurancePrivateMortgageInsurance strict {
    for premium: us.irc.core::Asset;
    when insurance_kind_6050h(premium, PrivateMortgageInsurance);
    then mortgage_insurance_6050h(premium);
}

// ============================================================================
// §6050I — cash receipts: content, exceptions, cash, statements, court clerks
// ============================================================================

@source(IRC_S6050I_B, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of the person from whom the cash was received,")
rule S6050IbReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, CashOverTenThousand6050I);
    then required_return_item(payer, y, CashOverTenThousand6050I, I6050I_NameAddressAndTinOfPayer);
    then required_return_item(payer, y, CashOverTenThousand6050I, I6050I_AmountOfCashReceived);
    then required_return_item(payer, y, CashOverTenThousand6050I, I6050I_DateAndNatureOfTransaction);
    then required_return_item(payer, y, CashOverTenThousand6050I, I6050I_OtherInformationAsPrescribed);
}

relation reported_under_title_31(recipient: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the cash was received in a transaction reported under title 31, United States Code";
}

external judgment relation secretary_determines_6050i_duplicates_title_31(recipient: Person, payer: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary determines that reporting under section 6050I would duplicate the reporting to the Treasury under title 31 (DECISION-0194)";
}

relation recipient_is_listed_financial_institution(recipient: Person) kind institutional {
    label en unofficial "the recipient is a financial institution as defined in the listed subparagraphs of section 5312(a)(2) of title 31 (pending: definitions)";
}

@source(IRC_S6050I_C, relation = formalizes, coverage = exact, quote = "cash received in a transaction reported under title 31, United States Code, if the Secretary determines that reporting under this section would duplicate the reporting to the Treasury under title 31, United States Code, or")
rule S6050IcTitle31Duplicate strict {
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    when reported_under_title_31(recipient, payer, y);
    when secretary_determines_6050i_duplicates_title_31(recipient, payer, y);
    then cash_receipt_excepted(recipient, payer, y);
}

@source(IRC_S6050I_C, relation = formalizes, coverage = exact, quote = "cash received by any financial institution (as defined in subparagraphs (A), (B), (C), (D), (E), (F), (G), (J), (K), (R), and (S) of section 5312(a)(2) of title 31, United States Code).")
rule S6050IcFinancialInstitution strict {
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    for amount: Money;
    for on: Date;
    when cash_received_in_transaction(recipient, payer, y, amount, on);
    when recipient_is_listed_financial_institution(recipient);
    then cash_receipt_excepted(recipient, payer, y);
}

pub enum CashKind6050I {
    ForeignCurrency;
    MonetaryInstrumentUpTo10000ByRegulation;
    DigitalAsset;
    CheckDrawnOnWritersAccountAtFinancialInstitution;
}

relation item_of_cash_kind(item: us.irc.core::Asset, kind: CashKind6050I) kind empirical {
    label en unofficial "the item received is of this kind";
}

relation regulation_treats_monetary_instrument_as_cash(item: us.irc.core::Asset) kind empirical {
    label en unofficial "to the extent provided in regulations, the monetary instrument (bearer or not) with a face amount of not more than $10,000 is cash";
}

relation cash_for_6050i(item: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050I(d): the item is cash";
}

@source(IRC_S6050I_D, relation = formalizes, coverage = exact, quote = "foreign currency,")
rule S6050IdForeignCurrency strict {
    for item: us.irc.core::Asset;
    when item_of_cash_kind(item, ForeignCurrency);
    then cash_for_6050i(item);
}

@source(IRC_S6050I_D, relation = formalizes, coverage = exact, quote = "to the extent provided in regulations prescribed by the Secretary, any monetary instrument (whether or not in bearer form) with a face amount of not more than $10,000, and")
rule S6050IdMonetaryInstrument defeasible {
    for item: us.irc.core::Asset;
    when item_of_cash_kind(item, MonetaryInstrumentUpTo10000ByRegulation);
    when regulation_treats_monetary_instrument_as_cash(item);
    when not_known(item_of_cash_kind(item, CheckDrawnOnWritersAccountAtFinancialInstitution));
    then cash_for_6050i(item);
}

@source(IRC_S6050I_D, relation = formalizes, coverage = exact, quote = "any digital asset (as defined in section 6045(g)(3)(D)).")
rule S6050IdDigitalAsset strict {
    for item: us.irc.core::Asset;
    when item_of_cash_kind(item, DigitalAsset);
    then cash_for_6050i(item);
}

@source(IRC_S6050I_E, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050IeStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, CashOverTenThousand6050I);
    then required_statement_item(payer, y, CashOverTenThousand6050I, I6050I_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, CashOverTenThousand6050I, I6050I_AggregateAmountOfCashReceived);
}

relation court_clerk_receives_bail_cash(clerk: Person, individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the clerk of a Federal or State criminal court receives this amount in cash as bail for the individual charged with a specified criminal offense";
}

relation bail_return_filed(clerk: Person, individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the clerk made the bail return";
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "shall make a return described in paragraph (2) (at such time as the Secretary may by regulations prescribe) with respect to the receipt of such bail.")
rule S6050IgClerkReturnDuty defeasible {
    for clerk: Person;
    for individual: Person;
    for y: TaxableYear;
    for amount: Money;
    when court_clerk_receives_bail_cash(clerk, individual, y, amount);
    when amount > 10000 USD;
    then duty MakeBailReturn {
        bearer clerk;
        beneficiary Secretary;
        goal achievement {
            condition bail_return_filed(clerk, individual, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(clerk, individual, y, CourtClerkBailReturn6050I);
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "is in such form as the Secretary may prescribe, and")
rule S6050IgReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, CourtClerkBailReturn6050I);
    then required_return_item(payer, y, CourtClerkBailReturn6050I, I6050I_NameAddressAndTinOfChargedIndividual);
    then required_return_item(payer, y, CourtClerkBailReturn6050I, I6050I_NameAddressAndTinOfEachBailPosterOtherThanBondsman);
    then required_return_item(payer, y, CourtClerkBailReturn6050I, I6050I_AmountOfCashReceived);
    then required_return_item(payer, y, CourtClerkBailReturn6050I, I6050I_DateCashReceived);
    then required_return_item(payer, y, CourtClerkBailReturn6050I, I6050I_OtherInformationAsPrescribed);
}

pub enum SpecifiedCriminalOffenseKind {
    FederalControlledSubstanceOffense;
    Racketeering;
    MoneyLaundering;
    SimilarStateOffense;
}

relation offense_kind_6050i(offense: us.irc.core::Asset, kind: SpecifiedCriminalOffenseKind) kind empirical {
    label en unofficial "the offense charged is of this kind (racketeering: 18 U.S.C. 1951, 1952 or 1955; money laundering: 18 U.S.C. 1956 or 1957)";
}

relation specified_criminal_offense(offense: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050I(g)(3): a specified criminal offense";
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "any Federal criminal offense involving a controlled substance,")
rule S6050IgSpecifiedOffenseFederalControlledSubstanceOffense strict {
    for offense: us.irc.core::Asset;
    when offense_kind_6050i(offense, FederalControlledSubstanceOffense);
    then specified_criminal_offense(offense);
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "racketeering (as defined in section 1951, 1952, or 1955 of title 18, United States Code),")
rule S6050IgSpecifiedOffenseRacketeering strict {
    for offense: us.irc.core::Asset;
    when offense_kind_6050i(offense, Racketeering);
    then specified_criminal_offense(offense);
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "money laundering (as defined in section 1956 or 1957 of such title), and")
rule S6050IgSpecifiedOffenseMoneyLaundering strict {
    for offense: us.irc.core::Asset;
    when offense_kind_6050i(offense, MoneyLaundering);
    then specified_criminal_offense(offense);
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "any State criminal offense substantially similar to an offense described in subparagraph (A), (B), or (C).")
rule S6050IgSpecifiedOffenseSimilarStateOffense strict {
    for offense: us.irc.core::Asset;
    when offense_kind_6050i(offense, SimilarStateOffense);
    then specified_criminal_offense(offense);
}

relation bail_offense_is_specified(clerk: Person, individual: Person, offense: us.irc.core::Asset) kind empirical {
    label en unofficial "the individual is charged with this offense and the bail is received by the clerk";
}

relation clerk_furnished_statement_to_us_attorney(clerk: Person, individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the clerk furnished the statement to the United States Attorney for the jurisdiction of residence and the jurisdiction of the offense";
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "shall furnish (at such time as the Secretary may by regulations prescribe) a written statement showing such information to the United States Attorney for the jurisdiction in which such individual resides and the jurisdiction in which the specified criminal offense occurred.")
rule S6050Ig4ClerkStatementToUsAttorneyDuty defeasible {
    for clerk: Person;
    for individual: Person;
    for y: TaxableYear;
    when information_return_required(clerk, individual, y, CourtClerkBailReturn6050I);
    then duty FurnishBailStatementToUsAttorney {
        bearer clerk;
        beneficiary Secretary;
        goal achievement {
            condition clerk_furnished_statement_to_us_attorney(clerk, individual, y);
            window [-infinity, infinity];
        }
    };
}

relation bail_poster_named_on_return(clerk: Person, poster: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person posting the bail (other than a licensed bail bondsman) is named on the return";
}

relation clerk_furnished_statement_to_bail_poster(clerk: Person, poster: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the clerk furnished the poster the statement";
}

@source(IRC_S6050I_G, relation = formalizes, coverage = exact, quote = "Each clerk required to make a return under paragraph (1) shall furnish (at such time as the Secretary may by regulations prescribe) to each person whose name is required to be set forth in such return by reason of paragraph (2)(B)(i)(II) a written statement showing—")
rule S6050Ig5ClerkStatementToPosterDuty defeasible {
    for clerk: Person;
    for individual: Person;
    for poster: Person;
    for y: TaxableYear;
    when information_return_required(clerk, individual, y, CourtClerkBailReturn6050I);
    when bail_poster_named_on_return(clerk, poster, y);
    then duty FurnishBailStatementToPoster {
        bearer clerk;
        beneficiary poster;
        goal achievement {
            condition clerk_furnished_statement_to_bail_poster(clerk, poster, y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(clerk, poster, y, CourtClerkBailReturn6050I);
}

@source(IRC_S6050I_G, relation = formalizes, coverage = partial, quote = "the name and address of the clerk's office required to make the return, and")
rule S6050Ig5StatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, CourtClerkBailReturn6050I);
    then required_statement_item(payer, y, CourtClerkBailReturn6050I, I6050I_NameAndAddressOfClerksOffice);
    then required_statement_item(payer, y, CourtClerkBailReturn6050I, I6050I_AggregateCashReceivedByClerk);
}

relation transaction_entirely_outside_us(recipient: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entire cash transaction occurs outside the United States";
}

relation regulation_extends_6050i_to_foreign_transactions(recipient: Person, payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "a Secretary regulation extends section 6050I to the foreign transaction";
}

@source(IRC_S6050I_C, relation = formalizes, coverage = exact, quote = "Except to the extent provided in regulations prescribed by the Secretary, subsection (a) shall not apply to any transaction if the entire transaction occurs outside the United States.")
rule S6050IcOutsideUnitedStates defeasible {
    for recipient: Person;
    for payer: Person;
    for y: TaxableYear;
    when transaction_entirely_outside_us(recipient, payer, y);
    when not_known(regulation_extends_6050i_to_foreign_transactions(recipient, payer, y));
    then cash_receipt_excepted(recipient, payer, y);
}

// ============================================================================
// §6050J — foreclosures and abandonments of secured property
// ============================================================================

relation lender_acquires_secured_property_in_satisfaction(lender: Person, borrower: Person, y: TaxableYear) kind empirical {
    label en unofficial "the lender, in connection with a trade or business, acquires in full or partial satisfaction of indebtedness an interest in property which is security for it";
}

relation lender_has_reason_to_know_abandoned(lender: Person, borrower: Person, y: TaxableYear) kind empirical {
    label en unofficial "the lender has reason to know that the property in which it has a security interest has been abandoned";
}

relation secured_loan_of_lender_in_business(lender: Person, borrower: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person, in connection with a trade or business conducted by it, lends money secured by property";
}

relation loan_to_individual_secured_by_personal_use_tangible_property(lender: Person, borrower: Person, y: TaxableYear) kind empirical {
    label en unofficial "the loan is to an individual secured by tangible personal property which is not held for investment and not used in a trade or business";
}

relation regulation_treats_transfer_to_other_as_abandonment(lender: Person, borrower: Person, y: TaxableYear) kind empirical {
    label en unofficial "by regulation, a transfer of the security to a person other than the lender is treated as an abandonment";
}

relation acquisition_or_abandonment_event(lender: Person, borrower: Person, y: TaxableYear) kind institutional {
    label en unofficial "a section 6050J(a)(1) acquisition or (a)(2) abandonment";
}

@source(IRC_S6050J_A, relation = formalizes, coverage = exact, quote = "in full or partial satisfaction of any indebtedness, acquires an interest in any property which is security for such indebtedness, or")
rule S6050JaAcquisition defeasible {
    for lender: Person;
    for borrower: Person;
    for y: TaxableYear;
    when secured_loan_of_lender_in_business(lender, borrower, y);
    when lender_acquires_secured_property_in_satisfaction(lender, borrower, y);
    then acquisition_or_abandonment_event(lender, borrower, y);
}

@source(IRC_S6050J_A, relation = formalizes, coverage = exact, quote = "has reason to know that the property in which such person has a security interest has been abandoned,")
rule S6050JaAbandonment defeasible {
    for lender: Person;
    for borrower: Person;
    for y: TaxableYear;
    when secured_loan_of_lender_in_business(lender, borrower, y);
    when lender_has_reason_to_know_abandoned(lender, borrower, y);
    then acquisition_or_abandonment_event(lender, borrower, y);
}

@source(IRC_S6050J_F, relation = formalizes, coverage = exact, quote = "any transfer of the property which secures the indebtedness to a person other than the lender shall be treated as an abandonment of such property.")
rule S6050JfTransferTreatedAsAbandonment defeasible {
    for lender: Person;
    for borrower: Person;
    for y: TaxableYear;
    when secured_loan_of_lender_in_business(lender, borrower, y);
    when regulation_treats_transfer_to_other_as_abandonment(lender, borrower, y);
    then acquisition_or_abandonment_event(lender, borrower, y);
}

relation foreclosure_return_filed(lender: Person, borrower: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the lender made the section 6050J return";
}

@source(IRC_S6050J_A, relation = formalizes, coverage = exact, quote = "shall make a return described in subsection (c) with respect to each of such acquisitions or abandonments, at such time as the Secretary may by regulations prescribe.")
rule S6050JaReturnDuty defeasible {
    for lender: Person;
    for borrower: Person;
    for y: TaxableYear;
    when acquisition_or_abandonment_event(lender, borrower, y);
    when not_known(loan_to_individual_secured_by_personal_use_tangible_property(lender, borrower, y));
    then duty MakeForeclosureOrAbandonmentReturn {
        bearer lender;
        beneficiary Secretary;
        goal achievement {
            condition foreclosure_return_filed(lender, borrower, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(lender, borrower, y, ForeclosureOrAbandonmentReturn6050J);
}

@source(IRC_S6050J_C, relation = formalizes, coverage = exact, quote = "the name and address of each person who is a borrower with respect to the indebtedness which is secured,")
rule S6050JcReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeclosureOrAbandonmentReturn6050J);
    then required_return_item(payer, y, ForeclosureOrAbandonmentReturn6050J, I6050J_NameAndAddressOfEachBorrower);
    then required_return_item(payer, y, ForeclosureOrAbandonmentReturn6050J, I6050J_DescriptionOfPropertyAndIndebtedness);
    then required_return_item(payer, y, ForeclosureOrAbandonmentReturn6050J, I6050J_IndebtednessAtAcquisitionAndAmountSatisfied);
    then required_return_item(payer, y, ForeclosureOrAbandonmentReturn6050J, I6050J_IndebtednessAtAbandonment);
    then required_return_item(payer, y, ForeclosureOrAbandonmentReturn6050J, I6050J_OtherInformationAsPrescribed);
}

@source(IRC_S6050J_D, relation = formalizes, coverage = exact, quote = "any return under this section shall be made by the officer or employee appropriately designated for the purpose of making such return.")
rule S6050JOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, ForeclosureOrAbandonmentReturn6050J);
    when information_return_required(unit, payee, y, ForeclosureOrAbandonmentReturn6050J);
    then duty MakeReturnAsDesignatedOfficer6050J {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, ForeclosureOrAbandonmentReturn6050J);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6050J_E, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was made.")
rule S6050JStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, ForeclosureOrAbandonmentReturn6050J);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, ForeclosureOrAbandonmentReturn6050J, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050J_E, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing the name, address, and phone number of the information contact of the person required to make such return.")
rule S6050JStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, ForeclosureOrAbandonmentReturn6050J);
    when us.irc.core::ends(y, end_date);
    then duty FurnishForeclosureStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, ForeclosureOrAbandonmentReturn6050J);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, ForeclosureOrAbandonmentReturn6050J);
}

// ============================================================================
// §6050K, §6050L, §6050M, §6050N — partnership exchanges, donees, Federal contracts, royalties
// ============================================================================

relation section_751a_exchange_of_partnership_interest(partnership: Person, transferor: Person, transferee: Person, y: TaxableYear) kind empirical {
    label en unofficial "an exchange described in section 751(a) of an interest in the partnership occurs during the calendar year";
}

relation regulation_excepts_6050k(partnership: Person, y: TaxableYear) kind empirical {
    label en unofficial "a Secretary regulation excepts the partnership from the return";
}

relation partnership_notified_of_exchange(partnership: Person, transferor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the transferor notified the partnership of the exchange";
}

relation partnership_6050k_return_filed(partnership: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the partnership made the section 6050K return";
}

@source(IRC_S6050K_A, relation = formalizes, coverage = exact, quote = "such partnership shall make a return for such calendar year stating—")
rule S6050KaReturnDuty defeasible {
    for partnership: Person;
    for transferor: Person;
    for transferee: Person;
    for y: TaxableYear;
    when section_751a_exchange_of_partnership_interest(partnership, transferor, transferee, y);
    when partnership_notified_of_exchange(partnership, transferor, y);
    when not_known(regulation_excepts_6050k(partnership, y));
    then duty MakePartnershipInterestExchangeReturn {
        bearer partnership;
        beneficiary Secretary;
        goal achievement {
            condition partnership_6050k_return_filed(partnership, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(partnership, transferee, y, PartnershipInterestExchangeReturn6050K);
}

relation transferor_notified_partnership_promptly(transferor: Person, partnership: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the transferor promptly notified the partnership of the exchange";
}

@source(IRC_S6050K_C, relation = formalizes, coverage = exact, quote = "the transferor of the partnership interest shall promptly notify the partnership of such exchange.")
rule S6050KcTransferorNotifiesDuty defeasible {
    for partnership: Person;
    for transferor: Person;
    for transferee: Person;
    for y: TaxableYear;
    when section_751a_exchange_of_partnership_interest(partnership, transferor, transferee, y);
    then duty NotifyPartnershipOfSection751aExchange {
        bearer transferor;
        beneficiary partnership;
        goal achievement {
            condition transferor_notified_partnership_promptly(transferor, partnership, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6050K_A, relation = formalizes, coverage = exact, quote = "the name and address of the transferee and transferor in such exchange, and")
rule S6050KaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, PartnershipInterestExchangeReturn6050K);
    then required_return_item(payer, y, PartnershipInterestExchangeReturn6050K, I6050K_NameAndAddressOfTransfereeAndTransferor);
    then required_return_item(payer, y, PartnershipInterestExchangeReturn6050K, I6050K_OtherInformationAsPrescribed);
}

@source(IRC_S6050K_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050KStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, PartnershipInterestExchangeReturn6050K);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, PartnershipInterestExchangeReturn6050K, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050K_B, relation = formalizes, coverage = exact, quote = "Every partnership required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6050KStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, PartnershipInterestExchangeReturn6050K);
    when us.irc.core::ends(y, end_date);
    then duty FurnishPartnershipExchangeStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, PartnershipInterestExchangeReturn6050K);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, PartnershipInterestExchangeReturn6050K);
}

@source(IRC_S6050K_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the partnership required to make such return, and")
rule S6050KbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PartnershipInterestExchangeReturn6050K);
    then required_statement_item(payer, y, PartnershipInterestExchangeReturn6050K, I6050K_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, PartnershipInterestExchangeReturn6050K, I6050K_InformationShownOnReturnForThisPerson);
}

relation donee_disposes_of_charitable_deduction_property(donee: Person, donor: Person, y: TaxableYear, d: Date, received: Date) kind empirical {
    label en unofficial "the donee sells, exchanges or otherwise disposes of charitable deduction property on this date, having received it on the second date";
}

relation claimed_value_of_property_and_similar_items(donor: Person, y: TaxableYear, value: Money) kind empirical {
    label en unofficial "the claimed value of the property plus the claimed value of all similar items donated by the donor to one or more donees";
}

relation publicly_traded_security_at_contribution(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "securities for which, at the date of contribution, market quotations were readily available on an established securities market";
}

relation donor_deduction_claimed_under_170(donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "a deduction was claimed under section 170 for the contribution";
}

relation charitable_deduction_property(donee: Person, donor: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050L(a)(2)(A): property (not publicly traded securities) for which a section 170 deduction was claimed and whose claimed value (with similar items) exceeds $5,000";
}

@source(IRC_S6050L_A, relation = formalizes, coverage = exact, quote = "The term \"charitable deduction property\" means any property (other than publicly traded securities) contributed in a contribution for which a deduction was claimed under section 170 if the claimed value of such property (plus the claimed value of all similar items of property donated by the donor to 1 or more donees) exceeds $5,000.")
rule S6050La2ACharitableDeductionProperty defeasible {
    for donee: Person;
    for donor: Person;
    for y: TaxableYear;
    for value: Money;
    when donor_deduction_claimed_under_170(donor, y);
    when claimed_value_of_property_and_similar_items(donor, y, value);
    when value > 5000 USD;
    when not_known(publicly_traded_security_at_contribution(donee, donor, y));
    when contribution_to_donee(donee, donor, y);
    then charitable_deduction_property(donee, donor, y);
}

relation contribution_to_donee(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor: the donor made the contribution to the donee";
}

relation donee_disposition_return_filed(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the donee made the section 6050L(a) return";
}

@source(IRC_S6050L_A, relation = formalizes, coverage = exact, quote = "If the donee of any charitable deduction property sells, exchanges, or otherwise disposes of such property within 3 years after its receipt, the donee shall make a return (in accordance with forms and regulations prescribed by the Secretary) showing—")
rule S6050La1DispositionReturnDuty defeasible {
    for donee: Person;
    for donor: Person;
    for y: TaxableYear;
    for d: Date;
    for received: Date;
    when charitable_deduction_property(donee, donor, y);
    when donee_disposes_of_charitable_deduction_property(donee, donor, y, d, received);
    when d <= add_calendar_period(received, 1095 calendar_day);
    then duty MakeDoneeDispositionReturn {
        bearer donee;
        beneficiary Secretary;
        goal achievement {
            condition donee_disposition_return_filed(donee, donor, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(donee, donor, y, DoneeDispositionReturn6050L);
}

@source(IRC_S6050L_A, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of the donor,")
rule S6050La1ReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, DoneeDispositionReturn6050L);
    then required_return_item(payer, y, DoneeDispositionReturn6050L, I6050L_NameAddressAndTinOfDonor);
    then required_return_item(payer, y, DoneeDispositionReturn6050L, I6050L_DescriptionOfProperty);
    then required_return_item(payer, y, DoneeDispositionReturn6050L, I6050L_DateOfContribution);
    then required_return_item(payer, y, DoneeDispositionReturn6050L, I6050L_AmountReceivedOnDisposition);
    then required_return_item(payer, y, DoneeDispositionReturn6050L, I6050L_DateOfDisposition);
    then required_return_item(payer, y, DoneeDispositionReturn6050L, I6050L_DescriptionOfDoneesUse);
    then required_return_item(payer, y, DoneeDispositionReturn6050L, I6050L_RelatedUseStatement);
}

relation donee_indicates_related_use_of_applicable_property(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the donee indicates that the use of applicable property (section 170(e)(7)(C)) was related to the purpose or function constituting the basis for its exemption under section 501";
}

relation certification_170e7D_made(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the certification described in section 170(e)(7)(D) is made under section 170(e)(7)";
}

@source(IRC_S6050L_A, relation = formalizes, coverage = exact, quote = "the donee shall include with the return the certification described in section 170(e)(7)(D) if such certification is made under section 170(e)(7).")
rule S6050La1CertificationItem defeasible {
    for donee: Person;
    for donor: Person;
    for y: TaxableYear;
    when information_return_required(donee, donor, y, DoneeDispositionReturn6050L);
    when donee_indicates_related_use_of_applicable_property(donee, donor, y);
    when certification_170e7D_made(donee, donor, y);
    then required_return_item(donee, y, DoneeDispositionReturn6050L, I6050L_CertificationUnder170e7D);
}

relation donee_qualified_ip_contribution_specified_year(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the donee received a qualified intellectual property contribution and this is a specified taxable year (any year any portion of which is within the 10-year period beginning on the contribution date)";
}

relation donee_ip_return_filed(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the donee made the section 6050L(b) return for the year";
}

@source(IRC_S6050L_B, relation = formalizes, coverage = exact, quote = "Each donee with respect to a qualified intellectual property contribution shall make a return (at such time and in such form and manner as the Secretary may by regulations prescribe) with respect to each specified taxable year of the donee showing—")
rule S6050Lb1QualifiedIpReturnDuty defeasible {
    for donee: Person;
    for donor: Person;
    for y: TaxableYear;
    when donee_qualified_ip_contribution_specified_year(donee, donor, y);
    then duty MakeQualifiedIpDonationReturn {
        bearer donee;
        beneficiary Secretary;
        goal achievement {
            condition donee_ip_return_filed(donee, donor, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(donee, donor, y, QualifiedIntellectualPropertyDonationReturn6050L);
}

@source(IRC_S6050L_B, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of the donor,")
rule S6050Lb1ReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, QualifiedIntellectualPropertyDonationReturn6050L);
    then required_return_item(payer, y, QualifiedIntellectualPropertyDonationReturn6050L, I6050L_NameAddressAndTinOfDonor);
    then required_return_item(payer, y, QualifiedIntellectualPropertyDonationReturn6050L, I6050L_DescriptionOfQualifiedIntellectualProperty);
    then required_return_item(payer, y, QualifiedIntellectualPropertyDonationReturn6050L, I6050L_DateOfContribution);
    then required_return_item(payer, y, QualifiedIntellectualPropertyDonationReturn6050L, I6050L_NetIncomeAllocableToProperty);
}

relation donee_furnished_copy_of_return_to_donor(donee: Person, donor: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the donee furnished the donor a copy of the return";
}

@source(IRC_S6050L_C, relation = formalizes, coverage = exact, quote = "Every person making a return under subsection (a) or (b) shall furnish a copy of such return to the donor at such time and in such manner as the Secretary may by regulations prescribe.")
rule S6050LcCopyToDonorDutyA defeasible {
    for donee: Person;
    for donor: Person;
    for y: TaxableYear;
    when information_return_required(donee, donor, y, DoneeDispositionReturn6050L);
    then duty FurnishCopyOfDoneeReturnToDonorA {
        bearer donee;
        beneficiary donor;
        goal achievement {
            condition donee_furnished_copy_of_return_to_donor(donee, donor, y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(donee, donor, y, DoneeDispositionReturn6050L);
}

@source(IRC_S6050L_C, relation = formalizes, coverage = exact, quote = "Every person making a return under subsection (a) or (b) shall furnish a copy of such return to the donor at such time and in such manner as the Secretary may by regulations prescribe.")
rule S6050LcCopyToDonorDutyB defeasible {
    for donee: Person;
    for donor: Person;
    for y: TaxableYear;
    when information_return_required(donee, donor, y, QualifiedIntellectualPropertyDonationReturn6050L);
    then duty FurnishCopyOfDoneeReturnToDonorB {
        bearer donee;
        beneficiary donor;
        goal achievement {
            condition donee_furnished_copy_of_return_to_donor(donee, donor, y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(donee, donor, y, QualifiedIntellectualPropertyDonationReturn6050L);
}

relation federal_executive_agency_head(head: Person, agency: Person) kind empirical {
    label en unofficial "the person is the head of the Federal executive agency";
}

relation agency_entered_contract_with(head: Person, contractor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the agency entered into a contract with the person during the calendar year (licenses and subcontracts to the extent regulations provide)";
}

relation contract_below_regulation_minimum_6050m(head: Person, contractor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the contract or license is in a class below the minimum amount or value the Secretary prescribed by regulation";
}

relation protected_contract_6050m_e3(head: Person, contractor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the contract is described in paragraph (3): existence or subject matter designated as requiring protection for national security, or the head determined in writing that filing would interfere with confidential law-enforcement or counterintelligence activity";
}

relation federal_executive_agency_6050m_b(agency: Person) kind institutional {
    label en unofficial "section 6050M(b): an Executive agency other than the GAO, a military department, the Postal Service or the Postal Regulatory Commission";
}

relation executive_agency_kind_6050m(agency: Person, kind: FederalAgencyKind6050M) kind empirical {
    label en unofficial "the agency's kind for section 6050M(b)";
}

pub enum FederalAgencyKind6050M {
    ExecutiveAgencyOtherThanGao;
    MilitaryDepartment;
    PostalServiceOrPostalRegulatoryCommission;
}

@source(IRC_S6050M_B, relation = formalizes, coverage = exact, quote = "any Executive agency (as defined in section 105 of title 5, United States Code) other than the Government Accountability Office,")
rule S6050MbAgencyExecutiveAgencyOtherThanGao strict {
    for agency: Person;
    when executive_agency_kind_6050m(agency, ExecutiveAgencyOtherThanGao);
    then federal_executive_agency_6050m_b(agency);
}

@source(IRC_S6050M_B, relation = formalizes, coverage = exact, quote = "any military department (as defined in section 102 of such title), and")
rule S6050MbAgencyMilitaryDepartment strict {
    for agency: Person;
    when executive_agency_kind_6050m(agency, MilitaryDepartment);
    then federal_executive_agency_6050m_b(agency);
}

@source(IRC_S6050M_B, relation = formalizes, coverage = exact, quote = "the United States Postal Service and the Postal Regulatory Commission.")
rule S6050MbAgencyPostalServiceOrPostalRegulatoryCommission strict {
    for agency: Person;
    when executive_agency_kind_6050m(agency, PostalServiceOrPostalRegulatoryCommission);
    then federal_executive_agency_6050m_b(agency);
}

relation agency_contract_return_filed(head: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the head of the agency made the section 6050M return";
}

@source(IRC_S6050M_A, relation = formalizes, coverage = exact, quote = "The head of every Federal executive agency which enters into any contract shall make a return (at such time and in such form as the Secretary may by regulations prescribe) setting forth—")
rule S6050MaReturnDuty defeasible {
    for head: Person;
    for agency: Person;
    for contractor: Person;
    for y: TaxableYear;
    when federal_executive_agency_head(head, agency);
    when federal_executive_agency_6050m_b(agency);
    when agency_entered_contract_with(head, contractor, y);
    when not_known(contract_below_regulation_minimum_6050m(head, contractor, y));
    when not_known(protected_contract_6050m_e3(head, contractor, y));
    then duty MakeFederalContractReturn {
        bearer head;
        beneficiary Secretary;
        goal achievement {
            condition agency_contract_return_filed(head, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(head, contractor, y, FederalContractReturn6050M);
}

@source(IRC_S6050M_A, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of each person with which such agency entered into a contract during the calendar year, and")
rule S6050MaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, FederalContractReturn6050M);
    then required_return_item(payer, y, FederalContractReturn6050M, I6050M_NameAddressAndTinOfContractor);
    then required_return_item(payer, y, FederalContractReturn6050M, I6050M_OtherInformationAsRequired);
}

relation agency_acknowledged_protected_contract_on_request(head: Person, contractor: Person) kind empirical {
    label en unofficial "case fact: the agency acknowledged on the Secretary's request whether the person entered such a contract and provided the information";
}

relation secretary_requests_protected_contract_information(secretary: Organ, head: Person, contractor: Person) kind empirical {
    label en unofficial "the Secretary makes a request identifying a particular person";
}

@source(IRC_S6050M_E, relation = formalizes, coverage = exact, quote = "shall, upon a request of the Secretary which identifies a particular person, acknowledge whether such person has entered into such a contract with such agency and, if so, provide to the Secretary—")
rule S6050Me2AcknowledgeOnRequestDuty defeasible {
    for head: Person;
    for contractor: Person;
    for y: TaxableYear;
    when protected_contract_6050m_e3(head, contractor, y);
    when secretary_requests_protected_contract_information(us.irc.core::Secretary, head, contractor);
    then duty AcknowledgeProtectedContractOnSecretaryRequest {
        bearer head;
        beneficiary Secretary;
        goal achievement {
            condition agency_acknowledged_protected_contract_on_request(head, contractor);
            window [-infinity, infinity];
        }
    };
}

relation contract_designated_national_security_or_confidential_enforcement(head: Person, contractor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the existence or subject matter of the contract is designated as requiring protection for national security, or the head determined in writing that filing would interfere with confidential law enforcement or counterintelligence activity";
}

@source(IRC_S6050M_E, relation = formalizes, coverage = exact, quote = "the fact of the existence of such contract or the subject matter of such contract has been designated and clearly marked or clearly represented, pursuant to the provisions of Federal law or an Executive order, as requiring a specific degree of protection against unauthorized disclosure for reasons of national security, or")
rule S6050Me3ProtectedContractDefinition strict {
    for head: Person;
    for contractor: Person;
    for y: TaxableYear;
    when contract_designated_national_security_or_confidential_enforcement(head, contractor, y);
    then protected_contract_6050m_e3(head, contractor, y);
}

relation royalty_payment(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person makes payments of royalties (or similar amounts) aggregating this amount to the payee during the calendar year (or receives them as a nominee and pays them on)";
}

@source(IRC_S6050N_A, relation = formalizes, coverage = exact, quote = "shall make a return according to the forms or regulations prescribed by the Secretary, setting forth the aggregate amount of such payments and the name and address of the person to whom paid.")
rule S6050NReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when royalty_payment(payer, payee, y, amount);
    when amount >= 10 USD;
    then duty MakeRoyaltyReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, RoyaltyReturn6050N);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, RoyaltyReturn6050N);
    unless royalty_payee_in_6049b4_ABCDEF(payer, payee, y);
}

relation royalty_payee_in_6049b4_ABCDEF(payer: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050N(c): the payee is described in subparagraph (A), (B), (C), (D), (E) or (F) of section 6049(b)(4), except to the extent regulations provide otherwise";
}

relation regulation_otherwise_provides_6050n(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: a regulation otherwise provides";
}

@source(IRC_S6050N_C, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, this section shall not apply to any amount paid to a person described in subparagraph (A), (B), (C), (D), (E), or (F) of section 6049(b)(4).")
rule S6050NcPayeeA defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_in_class_6049b4(payee, Corporation);
    when royalty_payment_context(payer, payee, y);
    when not_known(regulation_otherwise_provides_6050n(payer, payee, y));
    then royalty_payee_in_6049b4_ABCDEF(payer, payee, y);
}

@source(IRC_S6050N_C, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, this section shall not apply to any amount paid to a person described in subparagraph (A), (B), (C), (D), (E), or (F) of section 6049(b)(4).")
rule S6050NcPayeeB defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_in_class_6049b4(payee, ExemptOrganizationOrIndividualRetirementPlan);
    when royalty_payment_context(payer, payee, y);
    when not_known(regulation_otherwise_provides_6050n(payer, payee, y));
    then royalty_payee_in_6049b4_ABCDEF(payer, payee, y);
}

@source(IRC_S6050N_C, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, this section shall not apply to any amount paid to a person described in subparagraph (A), (B), (C), (D), (E), or (F) of section 6049(b)(4).")
rule S6050NcPayeeC defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_in_class_6049b4(payee, UnitedStatesOrWhollyOwnedAgency);
    when royalty_payment_context(payer, payee, y);
    when not_known(regulation_otherwise_provides_6050n(payer, payee, y));
    then royalty_payee_in_6049b4_ABCDEF(payer, payee, y);
}

@source(IRC_S6050N_C, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, this section shall not apply to any amount paid to a person described in subparagraph (A), (B), (C), (D), (E), or (F) of section 6049(b)(4).")
rule S6050NcPayeeD defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_in_class_6049b4(payee, StatePossessionOrPoliticalSubdivision);
    when royalty_payment_context(payer, payee, y);
    when not_known(regulation_otherwise_provides_6050n(payer, payee, y));
    then royalty_payee_in_6049b4_ABCDEF(payer, payee, y);
}

@source(IRC_S6050N_C, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, this section shall not apply to any amount paid to a person described in subparagraph (A), (B), (C), (D), (E), or (F) of section 6049(b)(4).")
rule S6050NcPayeeE defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_in_class_6049b4(payee, ForeignGovernmentOrSubdivision);
    when royalty_payment_context(payer, payee, y);
    when not_known(regulation_otherwise_provides_6050n(payer, payee, y));
    then royalty_payee_in_6049b4_ABCDEF(payer, payee, y);
}

@source(IRC_S6050N_C, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, this section shall not apply to any amount paid to a person described in subparagraph (A), (B), (C), (D), (E), or (F) of section 6049(b)(4).")
rule S6050NcPayeeF defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_in_class_6049b4(payee, InternationalOrganizationOrWhollyOwnedAgency);
    when royalty_payment_context(payer, payee, y);
    when not_known(regulation_otherwise_provides_6050n(payer, payee, y));
    then royalty_payee_in_6049b4_ABCDEF(payer, payee, y);
}

relation royalty_payment_context(payer: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "positive anchor for the exception: royalties are paid to the payee";
}

@source(IRC_S6050N_C, relation = formalizes, coverage = exact, quote = "this section shall not apply to any amount paid to a person")
rule S6050NcContext strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when royalty_payment(payer, payee, y, amount);
    then royalty_payment_context(payer, payee, y);
}

@source(IRC_S6050N_B, relation = formalizes, coverage = exact, quote = "to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was made")
rule S6050NStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, RoyaltyReturn6050N);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, RoyaltyReturn6050N, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050N_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6050NStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, RoyaltyReturn6050N);
    when us.irc.core::ends(y, end_date);
    then duty FurnishRoyaltyStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, RoyaltyReturn6050N);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, RoyaltyReturn6050N);
}

@source(IRC_S6050N_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050NbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, RoyaltyReturn6050N);
    then required_statement_item(payer, y, RoyaltyReturn6050N, I6050N_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, RoyaltyReturn6050N, I6050N_AggregateAmountOfPayments);
}

// ============================================================================
// §6050P (rest), §6050Q — discharge of indebtedness; long-term care benefits
// ============================================================================

@source(IRC_S6050P_A, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of each person whose indebtedness was discharged during such calendar year,")
rule S6050PaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, DischargeOfIndebtedness6050P);
    then required_return_item(payer, y, DischargeOfIndebtedness6050P, I6050P_NameAddressAndTinOfDischargedDebtor);
    then required_return_item(payer, y, DischargeOfIndebtedness6050P, I6050P_DateOfDischargeAndAmountDischarged);
    then required_return_item(payer, y, DischargeOfIndebtedness6050P, I6050P_OtherInformationAsPrescribed);
}

relation agency_3701a4(e: Person) kind empirical {
    label en unofficial "an executive, judicial or legislative agency as defined in section 3701(a)(4) of title 31";
}

relation financial_institution_581_591a_or_credit_union(e: Person) kind empirical {
    label en unofficial "a financial institution described in section 581 or 591(a) or a credit union";
}

relation fdic_rtc_ncua_or_federal_executive_agency_or_successor(e: Person) kind empirical {
    label en unofficial "the FDIC, the RTC, the NCUA or any other Federal executive agency (section 6050M), or a successor or subunit";
}

relation affiliated_subsidiary_subject_to_supervision(e: Person) kind empirical {
    label en unofficial "a direct or indirect subsidiary of an entity in (A) that, by virtue of being affiliated, is subject to supervision and examination by a Federal or State regulator of such entities";
}

relation organization_significant_business_is_lending(e: Person) kind empirical {
    label en unofficial "an organization a significant trade or business of which is the lending of money";
}

relation applicable_financial_entity(e: Person) kind institutional {
    label en unofficial "section 6050P(c)(2): an applicable financial entity";
}

@source(IRC_S6050P_C, relation = formalizes, coverage = exact, quote = "any financial institution described in section 581 or 591(a) and any credit union,")
rule S6050Pc2ApplicableFinancialEntityA strict {
    for e: Person;
    when financial_institution_581_591a_or_credit_union(e);
    then applicable_financial_entity(e);
}

@source(IRC_S6050P_C, relation = formalizes, coverage = exact, quote = "the Federal Deposit Insurance Corporation, the Resolution Trust Corporation, the National Credit Union Administration, and any other Federal executive agency (as defined in section 6050M), and any successor or subunit of any of the foregoing,")
rule S6050Pc2ApplicableFinancialEntityB strict {
    for e: Person;
    when fdic_rtc_ncua_or_federal_executive_agency_or_successor(e);
    then applicable_financial_entity(e);
}

@source(IRC_S6050P_C, relation = formalizes, coverage = exact, quote = "any other corporation which is a direct or indirect subsidiary of an entity referred to in subparagraph (A) but only if, by virtue of being affiliated with such entity, such other corporation is subject to supervision and examination by a Federal or State agency which regulates entities referred to in subparagraph (A), and")
rule S6050Pc2ApplicableFinancialEntityC strict {
    for e: Person;
    when affiliated_subsidiary_subject_to_supervision(e);
    then applicable_financial_entity(e);
}

@source(IRC_S6050P_C, relation = formalizes, coverage = exact, quote = "any organization a significant trade or business of which is the lending of money.")
rule S6050Pc2ApplicableFinancialEntityD strict {
    for e: Person;
    when organization_significant_business_is_lending(e);
    then applicable_financial_entity(e);
}

@source(IRC_S6050P_C, relation = formalizes, coverage = exact, quote = "an executive, judicial, or legislative agency (as defined in section 3701(a)(4) of title 31, United States Code), and")
rule S6050Pc1AApplicableEntityAgency strict {
    for e: Person;
    when agency_3701a4(e);
    then is_applicable_entity_6050P(e);
}

@source(IRC_S6050P_C, relation = formalizes, coverage = exact, quote = "an applicable financial entity.")
rule S6050Pc1BApplicableEntityFinancial strict {
    for e: Person;
    when applicable_financial_entity(e);
    then is_applicable_entity_6050P(e);
}

@source(IRC_S6050P_C, relation = formalizes, coverage = exact, quote = "any return under this section shall be made by the officer or employee appropriately designated for the purpose of making such return.")
rule S6050POfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, DischargeOfIndebtedness6050P);
    when information_return_required(unit, payee, y, DischargeOfIndebtedness6050P);
    then duty MakeReturnAsDesignatedOfficer6050P {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, DischargeOfIndebtedness6050P);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6050P_D, relation = formalizes, coverage = partial, quote = "the name and address of the entity required to make such return")
rule S6050PdStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, DischargeOfIndebtedness6050P);
    then required_statement_item(payer, y, DischargeOfIndebtedness6050P, I6050P_NameAndAddressOfEntity);
    then required_statement_item(payer, y, DischargeOfIndebtedness6050P, I6050P_InformationOnReturnForThisPerson);
}

relation agency_submitted_information_in_lieu_of_return(agency: Person, y: TaxableYear) kind empirical {
    label en unofficial "the agency submits to the Secretary information sufficient to complete the return on its behalf (the exercise)";
}

relation agency_information_in_lieu_accepted(agency: Person, y: TaxableYear) kind institutional {
    label en unofficial "effect: the agency's return obligation is met by the information submission";
}

relation agency_in_lieu_candidate(agency: Person, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor: the agency is an applicable entity under subsection (c)(1)(A) with a section 6050P return at issue";
}

relation agency_in_lieu_eligible(agency: Person, y: TaxableYear) kind institutional {
    label en unofficial "the agency is described in subsection (c)(1)(A)";
}

@source(IRC_S6050P_E, relation = formalizes, coverage = exact, quote = "an agency described in subsection (c)(1)(A)")
rule S6050PeEligibleAgency strict {
    for agency: Person;
    for y: TaxableYear;
    when agency_in_lieu_candidate(agency, y);
    when agency_3701a4(agency);
    then agency_in_lieu_eligible(agency, y);
}

@source(IRC_S6050P_E, relation = formalizes, coverage = exact, quote = "an agency described in subsection (c)(1)(A) may submit to the Secretary (at such time and in such form as the Secretary may by regulations prescribe) information sufficient for the Secretary to complete such a return on behalf of such agency.")
rule S6050PePower defeasible {
    for agency: Person;
    for y: TaxableYear;
    when agency_in_lieu_candidate(agency, y);
    then power SubmitInformationInLieuOfReturn {
        holder agency; over agency;
        exercise agency_submitted_information_in_lieu_of_return(agency, y);
        valid_when agency_in_lieu_eligible(agency, y);
        effect create(agency_information_in_lieu_accepted(agency, y));
        window [-infinity, infinity];
    };
}

relation information_submitted_for_secretary_to_complete(agency: Person, y: TaxableYear) kind institutional {
    label en unofficial "the Secretary must complete the return on receiving the information";
}

relation secretary_completed_return_and_provided_copy(agency: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the Secretary completed the return and provided a copy to the agency";
}

@source(IRC_S6050P_E, relation = formalizes, coverage = exact, quote = "Upon receipt of such information, the Secretary shall complete such return and provide a copy of such return to such agency.")
rule S6050PeSecretaryCompletesReturnDuty defeasible {
    for agency: Person;
    for y: TaxableYear;
    when agency_submitted_information_in_lieu_of_return(agency, y);
    when agency_in_lieu_eligible(agency, y);
    then duty CompleteReturnAndProvideCopyToAgency {
        bearer us.irc.core::Secretary;
        beneficiary agency;
        goal achievement {
            condition secretary_completed_return_and_provided_copy(agency, y);
            window [-infinity, infinity];
        }
    };
}

relation long_term_care_benefits_paid(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person pays long-term care benefits to the individual during the calendar year";
}

@source(IRC_S6050Q_A, relation = formalizes, coverage = exact, quote = "Any person who pays long-term care benefits shall make a return, according to the forms or regulations prescribed by the Secretary, setting forth—")
rule S6050QaReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when long_term_care_benefits_paid(payer, payee, y);
    then duty MakeLongTermCareBenefitsReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, LongTermCareBenefitsReturn6050Q);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, LongTermCareBenefitsReturn6050Q);
}

@source(IRC_S6050Q_A, relation = formalizes, coverage = exact, quote = "the aggregate amount of such benefits paid by such person to any individual during any calendar year,")
rule S6050QaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, LongTermCareBenefitsReturn6050Q);
    then required_return_item(payer, y, LongTermCareBenefitsReturn6050Q, I6050Q_AggregateBenefitsPaidToIndividual);
    then required_return_item(payer, y, LongTermCareBenefitsReturn6050Q, I6050Q_WhetherPaidOnPerDiemOrPeriodicBasis);
    then required_return_item(payer, y, LongTermCareBenefitsReturn6050Q, I6050Q_NameAddressAndTinOfIndividual);
    then required_return_item(payer, y, LongTermCareBenefitsReturn6050Q, I6050Q_NameAddressAndTinOfChronicallyOrTerminallyIllIndividual);
}

@source(IRC_S6050Q_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the individual on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050QStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, LongTermCareBenefitsReturn6050Q);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, LongTermCareBenefitsReturn6050Q, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050Q_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return a written statement showing—")
rule S6050QStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, LongTermCareBenefitsReturn6050Q);
    when us.irc.core::ends(y, end_date);
    then duty FurnishLongTermCareBenefitsStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, LongTermCareBenefitsReturn6050Q);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, LongTermCareBenefitsReturn6050Q);
}

@source(IRC_S6050Q_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person making the payments, and")
rule S6050QbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, LongTermCareBenefitsReturn6050Q);
    then required_statement_item(payer, y, LongTermCareBenefitsReturn6050Q, I6050Q_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, LongTermCareBenefitsReturn6050Q, I6050Q_AggregateLongTermCareBenefitsPaid);
}

relation payment_under_product_marketed_as_ltc_insurance(payment: us.irc.core::Asset) kind empirical {
    label en unofficial "the payment is under a product advertised, marketed or offered as long-term care insurance";
}

relation payment_excludable_under_101g(payment: us.irc.core::Asset) kind empirical {
    label en unofficial "the payment is excludable from gross income by reason of section 101(g)";
}

relation long_term_care_benefit(payment: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050Q(c): a long-term care benefit";
}

@source(IRC_S6050Q_C, relation = formalizes, coverage = exact, quote = "any payment under a product which is advertised, marketed, or offered as long-term care insurance, and")
rule S6050QcProductMarketed strict {
    for payment: us.irc.core::Asset;
    when payment_under_product_marketed_as_ltc_insurance(payment);
    then long_term_care_benefit(payment);
}

@source(IRC_S6050Q_C, relation = formalizes, coverage = exact, quote = "any payment which is excludable from gross income by reason of section 101(g).")
rule S6050QcExcludable101g strict {
    for payment: us.irc.core::Asset;
    when payment_excludable_under_101g(payment);
    then long_term_care_benefit(payment);
}
