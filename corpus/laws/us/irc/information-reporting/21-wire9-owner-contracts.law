// Information reporting -- WIRE-9 (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// The cooperative classification of section 6044 was a local placeholder (`kind institutional`, label "pending: special-entities"). The
// concept (part I of subchapter T of chapter 1 applies to the person, section 1381(a)) is published by `us.irc.exempt_organizations`
// (module 17), which this package already imports; the placeholder is derived from that relation. The case-fact channel stays valid.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Person,
    TaxableYear,
    entity_required_to_file_6012a_return,
    fiduciary_of,
    is_subchapter_t_cooperative,
    specified_security,
};

rule W9SubchapterTCooperativeFromExemptOrganizations strict {
    label en official "section 6044(a): a cooperative to which part I of subchapter T applies is the person for whom section 1381(a) says so (owner package `exempt_organizations`)";
    for coop: Person;
    when us.irc.exempt_organizations::subchapter_t_part_i_applies_1381a(coop);
    then is_subchapter_t_cooperative(coop);
}

// --- section 7701(a)(6): the fiduciary of an estate or trust (owner: core) -----------------------------------------------------------

rule W9FiduciaryOfFromCore strict {
    label en official "section 6034A and section 6012(a): the fiduciary of the estate or trust is the person acting in a fiduciary capacity for it (section 7701(a)(6), `us.irc.core::fiduciary_for`)";
    for fiduciary: Person;
    for obligor: Person;
    when us.irc.core::fiduciary_for(fiduciary, obligor);
    then fiduciary_of(fiduciary, obligor);
}

// --- section 6012(a): the estate or trust required to file a return (owner: returns; `pub` added at the owner) ---------------------------------

rule W9EntityRequiredToFile6012aReturnFromReturns strict {
    label en official "section 6034A: an estate or trust that section 6012(a) requires to file an income tax return is the package `returns`' conclusion `required_to_file_income_tax_return`";
    for obligor: Person;
    for y: TaxableYear;
    when us.irc.returns::required_to_file_income_tax_return(obligor, y);
    then entity_required_to_file_6012a_return(obligor, y);
}

// --- section 6045(g): "specified security" for section 1012(c) (owner-derives-consumer-stub; owner: this package) ----------------------------
//
// `us.irc.property_transactions` names the concept in `specified_security(a)` (section 1012(c)(3) refers to section 6045(g)) but cannot import this
// package (this package imports `credits`, which imports `property_transactions`: a consumer -> owner import would be a cycle). The owner, which
// computes the section 6045(g)(3)(B) list, derives the consumer's `pub` relation with a qualified head; the import direction is owner -> consumer.

rule W9SpecifiedSecurityForPropertyTransactions strict {
    label en official "section 1012(c)(3): a specified security within the meaning of section 6045(g) is the security this package classifies under section 6045(g)(3)(B)";
    for security: us.irc.core::Asset;
    when specified_security(security);
    then us.irc.property_transactions::specified_security(security);
}
