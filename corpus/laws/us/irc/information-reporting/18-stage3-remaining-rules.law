// Stage 3 (26.09.2026) — reduction of the technical gaps of package
// `us.irc.information_reporting` under DECISION-0379 (deontic positions, not only
// elements). Status implemented_unverified: scenarios are written, not executed;
// no legal review. Companion module: 19-stage3-constructive-ownership.law
// (constructive ownership for §§6038(e), 6038A(c)(5), 6046(c)).
//
// WHAT THIS MODULE DOES
//  - §6031(b): the four exceptions to the after-due-date amendment prohibition are
//    decomposed into their own facts and one Secretary judgment (they were one
//    pending fact).
//  - §6039C(d): the payee jurisdiction (United States or Virgin Islands) of the
//    tax and return, as two duties by the situs of the interest.
//  - §6045(b), last sentence: the consolidated reporting statement moves a
//    January 31 statement date to February 15.
//  - §6045(g)(2)(B)(ii): basis is reported without regard to §1091 unless the
//    transactions are in the same account in identical securities.
//  - §6045(h)(1): the amount received on grant / paid on acquisition of an option
//    is an adjustment to gross proceeds or to basis.
//  - §6048(d)(1): a subpart E ownership portion is disregarded (recorded fact and
//    scenarios showing the transfer and distribution rules do not read it).
//  - §6049(d)(7)(C): return content for REMIC and §1272(a)(6) interest, with the
//    adjusted issue price at the start of each accrual period computed from
//    recorded per-period items.
//  - §6053(c)(4): the typical-day headcount excludes an individual owning 50 percent
//    or more in value of the operating corporation and includes employees of a
//    trade or business under common control (asserted membership).
//  - §6059(a): "each third plan year thereafter" from the first section 412 year;
//    §6060(c): "the 12-month period beginning on July 1" from a calendar-year anchor.
//
// JUDGMENT CALLS
//  - §6031(b)(4) is a Secretary judgment (external judgment relation, authority
//    Secretary, DECISION-0194); the other three exceptions are case facts.
//  - §6045(b) consolidated statement: only the date shift is derived; whether a
//    statement is a consolidated reporting statement "as defined in regulations"
//    stays the case fact `consolidated_reporting_statement`.
//  - §6045(h)(1): the statute says the amount is "an adjustment to gross proceeds or
//    an adjustment to basis, as the case may be" without stating its sign; only the
//    target (gross proceeds when the security is disposed of, basis when acquired) is
//    derived. The sign belongs to the regulations and §1234.
//  - §6049(d)(7)(C): the adjusted issue price is issue price plus the recorded accrued
//    amounts of earlier accrual periods less the recorded payments other than qualified
//    stated interest (the §1272(a)(4) shape); market-discount information is a content
//    item only.
//  - §6059(a): plan years are compared by their begin dates: the report years are the
//    first section 412 year and the years beginning 3, 6, ... 39 years later.
//  - §6060(c): the calendar year in which the period begins is a case-asserted
//    TaxableYear entity of kind calendar year; July 1 is computed as six months after
//    its first day.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6031_B,
    IRC_S6039C_D,
    IRC_S6045_B,
    IRC_S6045_G,
    IRC_S6045_H,
    IRC_S6048_D,
    IRC_S6049_D,
    IRC_S6053_C,
    IRC_S6059_A,
    IRC_S6060_C,
    InformationReturnKind,
    Organ,
    Partnership,
    Period,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    basis_determination_at_issue,
    begins_on_july_1_6060,
    consolidated_reporting_statement,
    first_plan_year_section_412_applies,
    is_covered_security,
    is_large_food_or_beverage_establishment,
    is_partner_or_nominee_holder,
    option_granted_or_acquired_on,
    partnership_amendment_permitted,
    payee_statement_due,
    provides_food_or_beverages,
    required_return_item,
    required_statement_item,
    third_plan_year_after_prior_actuarial_report,
    tipping_of_serving_employees_customary,
};

// ============================================================================
// §6031(b) exceptions to the amendment prohibition
// ============================================================================

relation partnership_elected_6221b_for_year(p: Partnership, y: TaxableYear) kind empirical { label en unofficial "the partnership has elected the application of section 6221(b) for the taxable year"; }
relation amendment_made_under_6225c_procedures(p: Partnership, person: Person, y: TaxableYear) kind empirical { label en unofficial "the amendment of the information furnished to the person is made as provided in the procedures under section 6225(c)"; }
relation amendment_is_statement_under_6226(p: Partnership, person: Person, y: TaxableYear) kind empirical { label en unofficial "the amendment concerns statements under section 6226"; }
external judgment relation secretary_otherwise_permits_6031b_amendment(p: Partnership, person: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary provides otherwise that the information furnished to the person may be amended (a judgment of the Secretary)";
}

@source(IRC_S6031_B, relation = formalizes, coverage = exact, quote = "(1) in the case of a partnership which has elected the application of section 6221(b) for the taxable year,")
rule S6031bException1ElectionOutOf6221b defeasible {
    for p: Partnership;
    for person: Person;
    for y: TaxableYear;
    when partnership_elected_6221b_for_year(p, y) and is_partner_or_nominee_holder(person, p, y);
    then partnership_amendment_permitted(p, person, y);
}
@source(IRC_S6031_B, relation = formalizes, coverage = exact, quote = "(2) as provided in the procedures under section 6225(c),")
rule S6031bException2Procedures6225c defeasible {
    for p: Partnership;
    for person: Person;
    for y: TaxableYear;
    when amendment_made_under_6225c_procedures(p, person, y);
    then partnership_amendment_permitted(p, person, y);
}
@source(IRC_S6031_B, relation = formalizes, coverage = exact, quote = "(3) with respect to statements under section 6226, or")
rule S6031bException3Statements6226 defeasible {
    for p: Partnership;
    for person: Person;
    for y: TaxableYear;
    when amendment_is_statement_under_6226(p, person, y);
    then partnership_amendment_permitted(p, person, y);
}
@source(IRC_S6031_B, relation = formalizes, coverage = exact, quote = "(4) as otherwise provided by the Secretary.")
rule S6031bException4SecretaryProvides defeasible {
    for p: Partnership;
    for person: Person;
    for y: TaxableYear;
    when secretary_otherwise_permits_6031b_amendment(p, person, y);
    then partnership_amendment_permitted(p, person, y);
}

// ============================================================================
// §6039C(d) — tax and return go to the United States or to the Virgin Islands
// ============================================================================

const VirginIslandsTaxAuthority: Organ = entity_ref("urn:us:irc:information_reporting:clir#VirginIslandsTaxAuthority") {
    label en unofficial "the Virgin Islands as the jurisdiction to which tax is paid and returns are filed under section 6039C(d)(2)";
}
enum InterestSitus6039C {
    UnitedStatesSitus;
    VirginIslandsSitus;
}
relation subject_to_897a_tax_or_required_to_withhold_1445(person: Person, y: TaxableYear) kind empirical { label en unofficial "the nonresident alien individual or foreign corporation is subject to tax under section 897(a), or the person is required to withhold tax under section 1445"; }
relation real_property_interest_situs(interest: us.irc.core::Asset, situs: InterestSitus6039C) kind empirical { label en unofficial "the interest in real property is located in the United States or in the Virgin Islands"; }
relation domestic_corporation_897c1Aii_interest_situs(interest: us.irc.core::Asset, situs: InterestSitus6039C) kind empirical { label en unofficial "the interest is in a domestic corporation (with respect to the United States or with respect to the Virgin Islands) described in section 897(c)(1)(A)(ii)"; }
relation interest_solely_as_creditor_6039Cd(interest: us.irc.core::Asset) kind empirical { label en unofficial "the interest in the domestic corporation is solely as a creditor"; }
relation person_tax_or_return_concerns_interest_6039Cd(person: Person, interest: us.irc.core::Asset, y: TaxableYear) kind empirical { label en unofficial "the tax or the return required by this title concerns this interest"; }
relation interest_within_6039Cd_situs(interest: us.irc.core::Asset, situs: InterestSitus6039C) kind institutional { label en unofficial "the interest is one for which section 6039C(d) fixes the payee jurisdiction of the tax and return"; }
relation tax_paid_and_return_filed_with_jurisdiction(person: Person, interest: us.irc.core::Asset, y: TaxableYear, situs: InterestSitus6039C) kind empirical { label en unofficial "case fact: the person paid the tax and filed the return with the jurisdiction of the situs"; }

@source(IRC_S6039C_D, relation = formalizes, coverage = partial, quote = "(1) to the United States, in the case of any interest in real property located in the United States")
rule S6039CdRealPropertySitus strict {
    for interest: us.irc.core::Asset;
    for situs: InterestSitus6039C;
    when real_property_interest_situs(interest, situs);
    then interest_within_6039Cd_situs(interest, situs);
}
@source(IRC_S6039C_D, relation = formalizes, coverage = partial, quote = "and an interest (other than an interest solely as a creditor) in a domestic corporation (with respect to the United States) described in section 897(c)(1)(A)(ii)")
rule S6039CdCorporationInterestSitus strict {
    for interest: us.irc.core::Asset;
    for situs: InterestSitus6039C;
    when domestic_corporation_897c1Aii_interest_situs(interest, situs) and not_known(interest_solely_as_creditor_6039Cd(interest));
    then interest_within_6039Cd_situs(interest, situs);
}
@source(IRC_S6039C_D, relation = formalizes, coverage = exact, quote = "(1) to the United States, in the case of any interest in real property located in the United States")
rule S6039CdPayToUnitedStates defeasible {
    for person: Person;
    for interest: us.irc.core::Asset;
    for y: TaxableYear;
    when subject_to_897a_tax_or_required_to_withhold_1445(person, y) and person_tax_or_return_concerns_interest_6039Cd(person, interest, y) and interest_within_6039Cd_situs(interest, UnitedStatesSitus);
    then duty PayTaxAndFileReturnToUnitedStates6039Cd {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition tax_paid_and_return_filed_with_jurisdiction(person, interest, y, UnitedStatesSitus);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S6039C_D, relation = formalizes, coverage = exact, quote = "(2) to the Virgin Islands, in the case of any interest in real property located in the Virgin Islands")
rule S6039CdPayToVirginIslands defeasible {
    for person: Person;
    for interest: us.irc.core::Asset;
    for y: TaxableYear;
    when subject_to_897a_tax_or_required_to_withhold_1445(person, y) and person_tax_or_return_concerns_interest_6039Cd(person, interest, y) and interest_within_6039Cd_situs(interest, VirginIslandsSitus);
    then duty PayTaxAndFileReturnToVirginIslands6039Cd {
        bearer person;
        beneficiary VirginIslandsTaxAuthority;
        goal achievement {
            condition tax_paid_and_return_filed_with_jurisdiction(person, interest, y, VirginIslandsSitus);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6045(b), last sentence — consolidated reporting statement
// ============================================================================

relation item_furnished_with_consolidated_reporting_statement(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind) kind empirical { label en unofficial "the statement of this kind, for an item reportable to the taxpayer, is furnished with the consolidated reporting statement"; }
relation consolidated_statement_due(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind, d: Date) kind institutional { label en unofficial "section 6045(b): the statement that would otherwise be due on January 31 is instead due on February 15 when furnished with the consolidated reporting statement"; }

@source(IRC_S6045_B, relation = formalizes, coverage = exact, quote = "any statement which would otherwise be required to be furnished on or before January 31 of a calendar year with respect to any item reportable to the taxpayer shall instead be required to be furnished on or before February 15 of such calendar year if furnished with such consolidated reporting statement.")
rule S6045bConsolidatedStatementFebruary15 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for kind: InformationReturnKind;
    for end_date: Date;
    for d0: Date;
    when consolidated_reporting_statement(payer, payee, y) and item_furnished_with_consolidated_reporting_statement(payer, payee, y, kind) and payee_statement_due(payer, y, kind, d0) and us.irc.core::ends(y, end_date);
    when d0 == add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day);
    then consolidated_statement_due(payer, payee, y, kind, add_calendar_period(add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 1 calendar_month), 14 calendar_day));
}

// ============================================================================
// §6045(g)(2)(B)(ii) — wash sales and reported basis
// ============================================================================

relation wash_sale_transactions_in_same_account_identical_securities(security: us.irc.core::Asset) kind empirical { label en unofficial "the transactions occur in the same account with respect to identical securities"; }
external judgment relation secretary_provides_otherwise_6045g2Bii(security: us.irc.core::Asset) {
    authority Secretary;
    label en unofficial "the Secretary provides otherwise for the treatment of section 1091 in the reported adjusted basis (a judgment of the Secretary)";
}
relation reported_basis_disregards_1091(security: us.irc.core::Asset) kind institutional { label en unofficial "the customer's adjusted basis is determined without regard to section 1091"; }
relation reported_basis_regards_1091(security: us.irc.core::Asset) kind institutional { label en unofficial "the customer's adjusted basis is determined with regard to section 1091 (same account, identical securities)"; }

@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "the customer's adjusted basis shall be determined without regard to section 1091 (relating to loss from wash sales of stock or securities) unless the transactions occur in the same account with respect to identical securities.")
rule S6045g2BiiBasisWithoutRegardTo1091 defeasible {
    for security: us.irc.core::Asset;
    when basis_determination_at_issue(security) and not_known(wash_sale_transactions_in_same_account_identical_securities(security));
    then reported_basis_disregards_1091(security);
    unless secretary_provides_otherwise_6045g2Bii(security);
}
@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "unless the transactions occur in the same account with respect to identical securities.")
rule S6045g2BiiBasisRegards1091InSameAccount defeasible {
    for security: us.irc.core::Asset;
    when basis_determination_at_issue(security) and wash_sale_transactions_in_same_account_identical_securities(security);
    then reported_basis_regards_1091(security);
    unless secretary_provides_otherwise_6045g2Bii(security);
}

// ============================================================================
// §6045(h)(1) — option exercise adjusts gross proceeds or basis
// ============================================================================

enum OptionAmountAdjustmentTarget {
    AdjustmentToGrossProceeds;
    AdjustmentToBasis;
}
relation covered_security_disposed_by_option_exercise(option: us.irc.core::Asset, security: us.irc.core::Asset) kind empirical { label en unofficial "the covered security is disposed of pursuant to the exercise of the option"; }
relation covered_security_acquired_by_option_exercise(option: us.irc.core::Asset, security: us.irc.core::Asset) kind empirical { label en unofficial "the covered security is acquired pursuant to the exercise of the option"; }
relation option_granted_or_acquired_in_account_of_security(option: us.irc.core::Asset, security: us.irc.core::Asset) kind empirical { label en unofficial "the option was granted or acquired in the same account as the covered security"; }
relation option_amount_received_or_paid(option: us.irc.core::Asset, amount: Money) kind empirical { label en unofficial "the amount received with respect to the grant, or paid with respect to the acquisition, of the option"; }
relation option_amount_treated_as_adjustment(option: us.irc.core::Asset, security: us.irc.core::Asset, target: OptionAmountAdjustmentTarget, amount: Money) kind institutional { label en unofficial "section 6045(h)(1): the option amount is an adjustment to gross proceeds or to basis of the covered security"; }

@source(IRC_S6045_H, relation = formalizes, coverage = partial, quote = "if a covered security is acquired or disposed of pursuant to the exercise of an option that was granted or acquired in the same account as the covered security, the amount received with respect to the grant or paid with respect to the acquisition of such option shall be treated as an adjustment to gross proceeds")
rule S6045h1OptionAmountAdjustsGrossProceedsOnDisposal defeasible {
    for broker: Person;
    for customer: Person;
    for option: us.irc.core::Asset;
    for security: us.irc.core::Asset;
    for g: Date;
    for amount: Money;
    when is_covered_security(broker, customer, security) and covered_security_disposed_by_option_exercise(option, security) and option_granted_or_acquired_in_account_of_security(option, security) and option_amount_received_or_paid(option, amount);
    when option_granted_or_acquired_on(option, g) and g >= @2013-01-01;
    then option_amount_treated_as_adjustment(option, security, AdjustmentToGrossProceeds, amount);
}
@source(IRC_S6045_H, relation = formalizes, coverage = partial, quote = "or as an adjustment to basis, as the case may be.")
rule S6045h1OptionAmountAdjustsBasisOnAcquisition defeasible {
    for broker: Person;
    for customer: Person;
    for option: us.irc.core::Asset;
    for security: us.irc.core::Asset;
    for g: Date;
    for amount: Money;
    when is_covered_security(broker, customer, security) and covered_security_acquired_by_option_exercise(option, security) and option_granted_or_acquired_in_account_of_security(option, security) and option_amount_received_or_paid(option, amount);
    when option_granted_or_acquired_on(option, g) and g >= @2013-01-01;
    then option_amount_treated_as_adjustment(option, security, AdjustmentToBasis, amount);
}

// ============================================================================
// §6048(d)(1) — a subpart E ownership portion is disregarded
// ============================================================================

relation trust_portion_treated_as_owned_by_other_6048(trust: Person, owner: Person, y: TaxableYear) kind empirical { label en unofficial "a portion of the foreign trust is treated as owned by another person under subpart E of part I of subchapter J of chapter 1"; }
relation subpart_e_ownership_disregarded_6048(trust: Person, y: TaxableYear) kind institutional { label en unofficial "section 6048(d)(1): for deciding whether a United States person makes a transfer to, or receives a distribution from, the foreign trust, the subpart E ownership of a portion is disregarded"; }

@source(IRC_S6048_D, relation = formalizes, coverage = exact, quote = "the fact that a portion of such trust is treated as owned by another person under the rules of subpart E of part I of subchapter J of chapter 1 shall be disregarded.")
rule S6048d1SubpartEOwnershipDisregarded strict {
    for trust: Person;
    for owner: Person;
    for y: TaxableYear;
    when trust_portion_treated_as_owned_by_other_6048(trust, owner, y);
    then subpart_e_ownership_disregarded_6048(trust, y);
}

// ============================================================================
// §6049(d)(7)(C) — adjusted issue price at the start of each accrual period
// ============================================================================

enum InterestReturnRegime6049 {
    RemicRegularInterest;
    Section1272a6DebtInstrument;
}
relation return_concerns_remic_or_1272a6_interest(payer: Person, payee: Person, y: TaxableYear, regime: InterestReturnRegime6049) kind empirical { label en unofficial "the return or statement concerns interest described in section 6049(d)(7)(A) (REMIC regular interests) or interest on a debt instrument to which section 1272(a)(6) applies"; }
relation regulations_provide_otherwise_6049d7C(payer: Person, y: TaxableYear) kind empirical { label en unofficial "regulations provide otherwise for the additional content of the return or statement"; }
relation debt_instrument_issue_price(debt: us.irc.core::Asset, price: Money) kind empirical { label en unofficial "the issue price of the debt instrument or REMIC regular interest"; }
relation accrual_period_record(debt: us.irc.core::Asset, s: Date, e: Date, accrued: Money, payments: Money) kind empirical { label en unofficial "one accrual period (first and last day) with the interest income reportable for it and the payments other than qualified stated interest made in it"; }
relation adjusted_issue_price_at_accrual_start(debt: us.irc.core::Asset, s: Date, aip: Money) kind institutional { label en unofficial "the adjusted issue price at the beginning of the accrual period: issue price plus accrued amounts of earlier recorded periods less payments in them"; }

@source(IRC_S6049_D, relation = formalizes, coverage = partial, quote = "the adjusted issue price of the interest to which the return or statement relates at the beginning of each accrual period with respect to which interest income is required to be reported on such return or statement")
rule S6049d7CAdjustedIssuePriceAtAccrualStart defeasible {
    for debt: us.irc.core::Asset;
    for s: Date;
    for e: Date;
    for a: Money;
    for p: Money;
    for price: Money;
    when debt_instrument_issue_price(debt, price) and accrual_period_record(debt, s, e, a, p);
    then adjusted_issue_price_at_accrual_start(debt, s, price + sum(collect all a2: Money, s2: Date, e2: Date, p2: Money where accrual_period_record(debt, s2, e2, a2, p2) and e2 < s, empty: 0.00 USD) - sum(collect all p3: Money, s3: Date, e3: Date, a3: Money where accrual_period_record(debt, s3, e3, a3, p3) and e3 < s, empty: 0.00 USD));
}
@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "shall also provide information setting forth the adjusted issue price of the interest to which the return or statement relates at the beginning of each accrual period")
rule S6049d7CReturnContentAdjustedIssuePrice defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for regime: InterestReturnRegime6049;
    when return_concerns_remic_or_1272a6_interest(payer, payee, y, regime);
    then required_return_item(payer, y, InterestPayments6049, I6049_AdjustedIssuePriceAtBeginningOfEachAccrualPeriod);
    then required_statement_item(payer, y, InterestPayments6049, I6049_AdjustedIssuePriceAtBeginningOfEachAccrualPeriod);
    unless regulations_provide_otherwise_6049d7C(payer, y);
}
@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "and information necessary to compute accrual of market discount.")
rule S6049d7CReturnContentMarketDiscount defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for regime: InterestReturnRegime6049;
    when return_concerns_remic_or_1272a6_interest(payer, payee, y, regime);
    then required_return_item(payer, y, InterestPayments6049, I6049_InformationNecessaryToComputeAccrualOfMarketDiscount);
    then required_statement_item(payer, y, InterestPayments6049, I6049_InformationNecessaryToComputeAccrualOfMarketDiscount);
    unless regulations_provide_otherwise_6049d7C(payer, y);
}

// ============================================================================
// §6053(c)(4) — counting the employees of a large food or beverage establishment
// ============================================================================

relation employee_on_typical_business_day_of_business(business: Person, individual: Person, y: TaxableYear) kind empirical { label en unofficial "the individual is normally employed by the trade or business on a typical business day during the preceding calendar year"; }
relation businesses_under_common_control_like_52(business: Person, other: Person, y: TaxableYear) kind empirical { label en unofficial "the trades or businesses are aggregated under rules similar to section 52(a) and (b) (membership asserted by the case, regulations)"; }
relation establishment_operated_by_corporation(establishment: Person, corporation: Person) kind empirical { label en unofficial "the corporation operates the establishment"; }
relation value_percent_of_operating_corporation_owned(individual: Person, corporation: Person, pct: Decimal) kind empirical { label en unofficial "the percentage in value of the stock of the corporation that the individual owns"; }
relation aggregated_typical_day_employee(establishment: Person, individual: Person, y: TaxableYear) kind institutional { label en unofficial "the individual is an employee of the establishment or of a trade or business aggregated with it"; }
relation owner_of_half_or_more_of_operating_corporation(establishment: Person, individual: Person) kind institutional { label en unofficial "the individual owns 50 percent or more in value of the stock of the corporation operating the establishment"; }
relation counted_employee_6053(establishment: Person, individual: Person, y: TaxableYear) kind institutional { label en unofficial "the individual is treated as an employee for the headcount of section 6053(c)(4)(C)"; }
relation counted_typical_day_employees(establishment: Person, y: TaxableYear, n: Integer) kind institutional { label en unofficial "the number of employees counted for section 6053(c)(4)(C)"; }

@source(IRC_S6053_C, relation = formalizes, coverage = partial, quote = "rules similar to the rules of subsections (a) and (b) of section 52 shall apply under regulations prescribed by the Secretary")
rule S6053c4AggregatedEmployeeOwnBusiness strict {
    for establishment: Person;
    for individual: Person;
    for y: TaxableYear;
    when employee_on_typical_business_day_of_business(establishment, individual, y);
    then aggregated_typical_day_employee(establishment, individual, y);
}
@source(IRC_S6053_C, relation = formalizes, coverage = partial, quote = "rules similar to the rules of subsections (a) and (b) of section 52 shall apply under regulations prescribed by the Secretary")
rule S6053c4AggregatedEmployeeCommonControl strict {
    for establishment: Person;
    for other: Person;
    for individual: Person;
    for y: TaxableYear;
    when businesses_under_common_control_like_52(establishment, other, y) and employee_on_typical_business_day_of_business(other, individual, y);
    then aggregated_typical_day_employee(establishment, individual, y);
}
@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "an individual who owns 50 percent or more in value of the stock of the corporation operating the establishment shall not be treated as an employee.")
rule S6053c4OwnerOfHalfOrMore strict {
    for establishment: Person;
    for corporation: Person;
    for individual: Person;
    for pct: Decimal;
    when establishment_operated_by_corporation(establishment, corporation) and value_percent_of_operating_corporation_owned(individual, corporation, pct) and pct >= 50.0;
    then owner_of_half_or_more_of_operating_corporation(establishment, individual);
}
@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "an individual who owns 50 percent or more in value of the stock of the corporation operating the establishment shall not be treated as an employee.")
rule S6053c4CountedEmployee strict {
    for establishment: Person;
    for individual: Person;
    for y: TaxableYear;
    when aggregated_typical_day_employee(establishment, individual, y) and not_known(owner_of_half_or_more_of_operating_corporation(establishment, individual));
    then counted_employee_6053(establishment, individual, y);
}
@source(IRC_S6053_C, relation = formalizes, coverage = partial, quote = "which normally employed more than 10 employees on a typical business day during the preceding calendar year.")
rule S6053c4CountedHeadcount strict {
    for establishment: Person;
    for y: TaxableYear;
    for anchor: Person;
    when provides_food_or_beverages(establishment, y) and aggregated_typical_day_employee(establishment, anchor, y);
    then counted_typical_day_employees(establishment, y, count(collect i: Person where counted_employee_6053(establishment, i, y)));
}
@source(IRC_S6053_C, relation = formalizes, coverage = partial, quote = "which normally employed more than 10 employees on a typical business day during the preceding calendar year.")
rule S6053c4LargeEstablishmentByCountedHeadcount strict {
    for establishment: Person;
    for y: TaxableYear;
    for n: Integer;
    when provides_food_or_beverages(establishment, y) and tipping_of_serving_employees_customary(establishment, y) and counted_typical_day_employees(establishment, y, n) and n > 10;
    then is_large_food_or_beverage_establishment(establishment, y);
}

// ============================================================================
// §6059(a) — the first section 412 year and each third plan year thereafter
// ============================================================================

@source(IRC_S6059_A, relation = formalizes, coverage = exact, quote = "and for each third plan year thereafter")
rule S6059aThirdPlanYearAfterFirst defeasible {
    for administrator: Person;
    for f: TaxableYear;
    for y: TaxableYear;
    for fb: Date;
    for yb: Date;
    when first_plan_year_section_412_applies(administrator, f) and us.irc.core::begins(f, fb) and us.irc.core::begins(y, yb);
    when yb == add_calendar_period(fb, 3 calendar_year) or yb == add_calendar_period(fb, 6 calendar_year) or yb == add_calendar_period(fb, 9 calendar_year) or yb == add_calendar_period(fb, 12 calendar_year) or yb == add_calendar_period(fb, 15 calendar_year) or yb == add_calendar_period(fb, 18 calendar_year) or yb == add_calendar_period(fb, 21 calendar_year) or yb == add_calendar_period(fb, 24 calendar_year) or yb == add_calendar_period(fb, 27 calendar_year) or yb == add_calendar_period(fb, 30 calendar_year) or yb == add_calendar_period(fb, 33 calendar_year) or yb == add_calendar_period(fb, 36 calendar_year) or yb == add_calendar_period(fb, 39 calendar_year);
    then third_plan_year_after_prior_actuarial_report(administrator, y);
}

// ============================================================================
// §6060(c) — the 12-month period beginning on July 1
// ============================================================================

relation period_begins_in_calendar_year_6060(period: Period, cy: TaxableYear) kind empirical { label en unofficial "the calendar-year taxable year in which the period begins"; }

@source(IRC_S6060_C, relation = formalizes, coverage = exact, quote = "the 12-month period beginning on July 1 of each year")
rule S6060cJuly1FromCalendarYear defeasible {
    for period: Period;
    for cy: TaxableYear;
    for n: Integer;
    for j: Date;
    for s: Date;
    when period_begins_in_calendar_year_6060(period, cy) and us.irc.core::calendar_year_of(cy, n) and us.irc.core::begins(cy, j) and us.irc.core::begins(period, s);
    when s == add_calendar_period(j, 6 calendar_month);
    then begins_on_july_1_6060(period);
}
