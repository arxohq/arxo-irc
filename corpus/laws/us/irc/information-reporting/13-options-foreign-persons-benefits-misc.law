// §6039, §6039A-§6039J, §6040 — returns and statements in connection with
// options, foreign persons' US real property, fringe benefit plans,
// passport and immigration applicants, foreign gifts, expatriates,
// Settlement Trusts, employer-owned life insurance and CCC market gains,
// of package `us.irc.information_reporting`, module 13 (STAGE 2).
//
// JUDGMENT CALLS
//  - §6039F(d)'s cost-of-living adjustment of the $10,000 gift threshold is
//    MISSING_PARAMETER_VALUE: only the statutory $10,000 is a rule
//    (TECH-GAPS G2401).
//  - Amounts due "for each month" (§6039F(c)(1)(B)) take the number of
//    months of continuing failure as a case fact (G2409).
//  - Agency duties (§6039E(d), §6039G(d), §6039J) are duties of the named
//    agency or the Secretary with the Secretary as beneficiary.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Corporation,
    IRC_S6039C_A,
    IRC_S6039C_B,
    IRC_S6039C_C,
    IRC_S6039D_A,
    IRC_S6039D_B,
    IRC_S6039D_C,
    IRC_S6039D_D,
    IRC_S6039E_A,
    IRC_S6039E_B,
    IRC_S6039E_C,
    IRC_S6039E_D,
    IRC_S6039E_E,
    IRC_S6039F_A,
    IRC_S6039F_B,
    IRC_S6039F_C,
    IRC_S6039G_A,
    IRC_S6039G_B,
    IRC_S6039G_C,
    IRC_S6039G_D,
    IRC_S6039H_A,
    IRC_S6039H_B,
    IRC_S6039H_C,
    IRC_S6039H_D,
    IRC_S6039H_E,
    IRC_S6039I_A,
    IRC_S6039I_B,
    IRC_S6039J_A,
    IRC_S6039J_B,
    IRC_S6039_A,
    IRC_S6039_B,
    IRC_S6039_C,
    Individual,
    InformationReturnKind,
    Organ,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    filed_information_return,
    furnished_payee_statement,
    information_return_required,
    payee_statement_due,
    payee_statement_required,
    records_transfer_pursuant_to_423c_option,
    required_return_item,
    required_statement_item,
    transfers_stock_pursuant_to_iso_exercise,
};

// ============================================================================
// §6039 — options: statement to the person, special rules
// ============================================================================

@source(IRC_S6039_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to such person on or before January 31 of the year following the calendar year for which the return under subsection (a) was made.")
rule S6039StatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, OptionExerciseStatement6039);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, OptionExerciseStatement6039, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6039_B, relation = formalizes, coverage = exact, quote = "Every corporation making a return under subsection (a) shall furnish to each person whose name is set forth in such return a written statement setting forth such information as the Secretary may by regulations prescribe.")
rule S6039StatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, OptionExerciseStatement6039);
    when us.irc.core::ends(y, end_date);
    then duty FurnishOptionExerciseStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, OptionExerciseStatement6039);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, OptionExerciseStatement6039);
}

@source(IRC_S6039_A, relation = formalizes, coverage = exact, quote = "shall, for such calendar year, make a return at such time and in such manner, and setting forth such information, as the Secretary may by regulations prescribe.")
rule S6039IsoReturnRequiredMarker defeasible {
    for c: Corporation;
    for transferee: Person;
    for y: TaxableYear;
    when transfers_stock_pursuant_to_iso_exercise(c, transferee, y);
    then information_return_required(c, transferee, y, OptionExerciseStatement6039);
}

@source(IRC_S6039_A, relation = formalizes, coverage = exact, quote = "in any calendar year records (or has by its agent recorded) a transfer of the legal title of a share of stock acquired by the transferor pursuant to his exercise of an option described in section 423(c)")
rule S6039EsptReturnRequiredMarker defeasible {
    for c: Corporation;
    for transferor: Person;
    for y: TaxableYear;
    when records_transfer_pursuant_to_423c_option(c, transferor, y);
    then information_return_required(c, transferor, y, OptionExerciseStatement6039);
}

relation option_treated_as_iso_or_espp_by_corporation(c: Person, option: us.irc.core::Asset) kind empirical {
    label en unofficial "the corporation treats the option as an incentive stock option or an option granted under an employee stock purchase plan";
}

relation deemed_iso_or_espp_option(option: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6039(c)(1): the option is deemed an incentive stock option or an employee stock purchase plan option";
}

@source(IRC_S6039_C, relation = formalizes, coverage = exact, quote = "Any option which the corporation treats as an incentive stock option or an option granted under an employee stock purchase plan shall be deemed to be such an option.")
rule S6039cTreatedOptionDeemed strict {
    for c: Person;
    for option: us.irc.core::Asset;
    when option_treated_as_iso_or_espp_by_corporation(c, option);
    then deemed_iso_or_espp_option(option);
}

relation first_transfer_of_share_by_exerciser(share: us.irc.core::Asset) kind empirical {
    label en unofficial "this is the first transfer of the share by the person who exercised the option";
}

relation statement_required_for_transfer_of_share(share: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6039(c)(2): a statement is required by reason of a transfer only for the first transfer of the share by the exerciser";
}

@source(IRC_S6039_C, relation = formalizes, coverage = exact, quote = "A statement is required by reason of a transfer described in subsection (a)(2) of a share only with respect to the first transfer of such share by the person who exercised the option.")
rule S6039cStatementOnlyFirstTransfer strict {
    for share: us.irc.core::Asset;
    when first_transfer_of_share_by_exerciser(share);
    then statement_required_for_transfer_of_share(share);
}

relation corporation_transfers_share_pursuant_to_option_exercise(c: Person, share: us.irc.core::Asset) kind empirical {
    label en unofficial "the corporation transfers a share of stock pursuant to the exercise of an option described in subsection (a)(2)";
}

relation corporation_identified_stock(c: Person, share: us.irc.core::Asset) kind empirical {
    label en unofficial "case fact: the corporation identified the stock in a manner adequate to carry out the section";
}

@source(IRC_S6039_C, relation = formalizes, coverage = exact, quote = "Any corporation which transfers any share of stock pursuant to the exercise of any option described in subsection (a)(2) shall identify such stock in a manner adequate to carry out the purposes of this section.")
rule S6039cIdentifyStockDuty defeasible {
    for c: Person;
    for share: us.irc.core::Asset;
    when corporation_transfers_share_pursuant_to_option_exercise(c, share);
    then duty IdentifyStockTransferredUnderOption {
        bearer c;
        beneficiary Secretary;
        goal achievement {
            condition corporation_identified_stock(c, share);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6039C — foreign persons holding direct investments in United States real property interests
// ============================================================================

relation foreign_person_holds_usrpi(person: Person, y: TaxableYear, fmv: Money) kind empirical {
    label en unofficial "the foreign person holds United States real property interests (section 897(c)) directly at any time during the calendar year, of this fair market value (partnership, trust and estate holdings proportionately; a spouse's or minor child's holdings attributed to the individual)";
}

relation foreign_person_engaged_in_us_trade_or_business(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign person engaged in a trade or business in the United States at any time during the calendar year";
}

relation regulation_requires_6039c_return(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "to the extent provided in regulations, a return is required of the person";
}

relation holds_direct_investments_in_usrpi(person: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6039C(b): the foreign person is treated as holding direct investments in United States real property interests for the year";
}

@source(IRC_S6039C_B, relation = formalizes, coverage = exact, quote = "the fair market value of the United States real property interests held directly by such person at any time during such year equals or exceeds $50,000.")
rule S6039CbDirectInvestmentThreshold defeasible {
    for person: Person;
    for y: TaxableYear;
    for fmv: Money;
    when foreign_person_holds_usrpi(person, y, fmv);
    when fmv >= 50000 USD;
    when not_known(foreign_person_engaged_in_us_trade_or_business(person, y));
    then holds_direct_investments_in_usrpi(person, y);
}

relation foreign_person_direct_investor_requiring_return(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign person holds direct investments in United States real property interests for the calendar year and regulations require the return";
}

@source(IRC_S6039C_A, relation = formalizes, coverage = exact, quote = "any foreign person holding direct investments in United States real property interests for the calendar year shall make a return setting forth—")
rule S6039CaDirectInvestmentReturnDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when foreign_person_direct_investor_requiring_return(filer, y);
    when holds_direct_investments_in_usrpi(filer, y);
    when regulation_requires_6039c_return(filer, y);
    then duty MakeForeignDirectInvestmentReturn {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, ForeignDirectInvestmentInUsRealProperty6039C);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, ForeignDirectInvestmentInUsRealProperty6039C);
}

@source(IRC_S6039C_A, relation = formalizes, coverage = exact, quote = "a description of all United States real property interests held by such person at any time during the calendar year, and")
rule S6039CaReturnContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ForeignDirectInvestmentInUsRealProperty6039C);
    then required_return_item(filer, y, ForeignDirectInvestmentInUsRealProperty6039C, I6039C_NameAndAddress);
    then required_return_item(filer, y, ForeignDirectInvestmentInUsRealProperty6039C, I6039C_DescriptionOfAllUsrpiHeld);
    then required_return_item(filer, y, ForeignDirectInvestmentInUsRealProperty6039C, I6039C_OtherInformationAsPrescribed);
}

relation partnership_trust_estate_holding_usrpi_share(owner: Person, holder: Person, y: TaxableYear, fmv: Money) kind empirical {
    label en unofficial "the value of United States real property interests held by a partnership, trust or estate that is treated as owned proportionately by the partner or beneficiary";
}

relation spouse_or_minor_child_holding_usrpi(individual: Person, holder: Person, y: TaxableYear, fmv: Money) kind empirical {
    label en unofficial "the value of United States real property interests held by the spouse or a minor child of the individual";
}

relation usrpi_attributed_value(person: Person, y: TaxableYear, fmv: Money) kind institutional {
    label en unofficial "section 6039C(c)(3): value of United States real property interests treated as owned by the person through a partnership, trust or estate, or through a spouse or minor child";
}

@source(IRC_S6039C_C, relation = formalizes, coverage = partial, quote = "United States real property interests held by a partnership, trust, or estate shall be treated as owned proportionately by its partners or beneficiaries.")
rule S6039CcPartnershipTrustEstateProportional strict {
    for owner: Person;
    for holder: Person;
    for y: TaxableYear;
    for fmv: Money;
    when partnership_trust_estate_holding_usrpi_share(owner, holder, y, fmv);
    then usrpi_attributed_value(owner, y, fmv);
}

@source(IRC_S6039C_C, relation = formalizes, coverage = exact, quote = "United States real property interests held by the spouse or any minor child of an individual shall be treated as owned by such individual.")
rule S6039CcSpouseMinorChild strict {
    for individual: Person;
    for holder: Person;
    for y: TaxableYear;
    for fmv: Money;
    when spouse_or_minor_child_holding_usrpi(individual, holder, y, fmv);
    then usrpi_attributed_value(individual, y, fmv);
}

relation nra_or_foreign_corp_subject_to_897a_or_withholder(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "a nonresident alien individual or foreign corporation subject to tax under section 897(a), or a person required to withhold under section 1445";
}

relation usrpi_located_in_us(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "the real property interest is located in the United States (or is a domestic corporation interest described in section 897(c)(1)(A)(ii) with respect to the United States)";
}

relation usrpi_located_in_virgin_islands(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "the real property interest is located in the Virgin Islands (or a domestic corporation interest with respect to the Virgin Islands)";
}

relation tax_and_return_payee_jurisdiction(person: Person, y: TaxableYear, jurisdiction: Person) kind institutional {
    label en unofficial "section 6039C(d): the jurisdiction to which the tax is paid and the return filed";
}

// ============================================================================
// §6039D — specified fringe benefit plans
// ============================================================================

relation employer_maintains_specified_fringe_benefit_plan_with_exclusion(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer maintains a specified fringe benefit plan (section 79, 105, 106, 125, 127, 129 or 137) during the year for any portion of which the applicable exclusion applies";
}

@source(IRC_S6039D_A, relation = formalizes, coverage = exact, quote = "shall file a return (at such time and in such manner as the Secretary shall by regulations prescribe) with respect to such plan showing for such year—")
rule S6039DaReturnDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when employer_maintains_specified_fringe_benefit_plan_with_exclusion(filer, y);
    then duty FileSpecifiedFringeBenefitPlanReturn {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, SpecifiedFringeBenefitPlanReturn6039D);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, SpecifiedFringeBenefitPlanReturn6039D);
}

@source(IRC_S6039D_A, relation = formalizes, coverage = exact, quote = "the number of employees of the employer,")
rule S6039DaReturnContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, SpecifiedFringeBenefitPlanReturn6039D);
    then required_return_item(filer, y, SpecifiedFringeBenefitPlanReturn6039D, I6039D_NumberOfEmployees);
    then required_return_item(filer, y, SpecifiedFringeBenefitPlanReturn6039D, I6039D_NumberOfEmployeesEligible);
    then required_return_item(filer, y, SpecifiedFringeBenefitPlanReturn6039D, I6039D_NumberOfEmployeesParticipating);
    then required_return_item(filer, y, SpecifiedFringeBenefitPlanReturn6039D, I6039D_TotalCostOfPlanDuringYear);
    then required_return_item(filer, y, SpecifiedFringeBenefitPlanReturn6039D, I6039D_EmployerNameAddressTinAndBusinessType);
    then required_return_item(filer, y, SpecifiedFringeBenefitPlanReturn6039D, I6039D_NumberOfHighlyCompensatedEmployees);
}

relation employer_kept_fringe_plan_records(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the employer keeps such records as are necessary to determine whether the applicable exclusion requirements are met";
}

@source(IRC_S6039D_B, relation = formalizes, coverage = exact, quote = "Each employer maintaining a specified fringe benefit plan during any year shall keep such records as may be necessary for purposes of determining whether the requirements of the applicable exclusion are met.")
rule S6039DbRecordsDuty defeasible {
    for employer: Person;
    for y: TaxableYear;
    when employer_maintains_specified_fringe_benefit_plan_with_exclusion(employer, y);
    then duty KeepFringeBenefitPlanRecords {
        bearer employer;
        beneficiary Secretary;
        goal maintenance {
            condition employer_kept_fringe_plan_records(employer, y);
            window [-infinity, infinity];
        }
    };
}

relation secretary_requires_additional_fringe_return(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary requires the employer to file an additional return for the year (only from a representative group of employers)";
}

relation additional_fringe_return_filed(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the employer filed the additional return";
}

@source(IRC_S6039D_C, relation = formalizes, coverage = exact, quote = "shall file such additional return. Such additional return shall be filed at such time and in such manner as the Secretary shall prescribe and shall contain such information as the Secretary shall prescribe.")
rule S6039DcAdditionalReturnDuty defeasible {
    for employer: Person;
    for y: TaxableYear;
    when employer_maintains_specified_fringe_benefit_plan_with_exclusion(employer, y);
    when secretary_requires_additional_fringe_return(employer, y);
    then duty FileAdditionalFringeBenefitReturn {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition additional_fringe_return_filed(employer, y);
            window [-infinity, infinity];
        }
    };
}

pub enum FringeBenefitSection {
    Section79;
    Section105;
    Section106;
    Section125;
    Section127;
    Section129;
    Section137;
}

relation plan_under_section(plan: us.irc.core::Asset, sec: FringeBenefitSection) kind empirical {
    label en unofficial "the plan is a plan under this section";
}

relation specified_fringe_benefit_plan(plan: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6039D(d)(1): any plan under section 79, 105, 106, 125, 127, 129 or 137";
}

relation applicable_exclusion_of_plan(plan: us.irc.core::Asset, sec: FringeBenefitSection) kind institutional {
    label en unofficial "section 6039D(d)(2): the section under which benefits under the plan are excludable from gross income";
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"specified fringe benefit plan\" means any plan under section 79, 105, 106, 125, 127, 129, or 137.")
rule S6039DdSpecifiedPlanSection79 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section79);
    then specified_fringe_benefit_plan(plan);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"applicable exclusion\" means, with respect to any specified fringe benefit plan, the section specified under paragraph (1) under which benefits under such plan are excludable from gross income.")
rule S6039DdApplicableExclusionSection79 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section79);
    when specified_fringe_benefit_plan(plan);
    then applicable_exclusion_of_plan(plan, Section79);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"specified fringe benefit plan\" means any plan under section 79, 105, 106, 125, 127, 129, or 137.")
rule S6039DdSpecifiedPlanSection105 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section105);
    then specified_fringe_benefit_plan(plan);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"applicable exclusion\" means, with respect to any specified fringe benefit plan, the section specified under paragraph (1) under which benefits under such plan are excludable from gross income.")
rule S6039DdApplicableExclusionSection105 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section105);
    when specified_fringe_benefit_plan(plan);
    then applicable_exclusion_of_plan(plan, Section105);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"specified fringe benefit plan\" means any plan under section 79, 105, 106, 125, 127, 129, or 137.")
rule S6039DdSpecifiedPlanSection106 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section106);
    then specified_fringe_benefit_plan(plan);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"applicable exclusion\" means, with respect to any specified fringe benefit plan, the section specified under paragraph (1) under which benefits under such plan are excludable from gross income.")
rule S6039DdApplicableExclusionSection106 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section106);
    when specified_fringe_benefit_plan(plan);
    then applicable_exclusion_of_plan(plan, Section106);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"specified fringe benefit plan\" means any plan under section 79, 105, 106, 125, 127, 129, or 137.")
rule S6039DdSpecifiedPlanSection125 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section125);
    then specified_fringe_benefit_plan(plan);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"applicable exclusion\" means, with respect to any specified fringe benefit plan, the section specified under paragraph (1) under which benefits under such plan are excludable from gross income.")
rule S6039DdApplicableExclusionSection125 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section125);
    when specified_fringe_benefit_plan(plan);
    then applicable_exclusion_of_plan(plan, Section125);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"specified fringe benefit plan\" means any plan under section 79, 105, 106, 125, 127, 129, or 137.")
rule S6039DdSpecifiedPlanSection127 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section127);
    then specified_fringe_benefit_plan(plan);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"applicable exclusion\" means, with respect to any specified fringe benefit plan, the section specified under paragraph (1) under which benefits under such plan are excludable from gross income.")
rule S6039DdApplicableExclusionSection127 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section127);
    when specified_fringe_benefit_plan(plan);
    then applicable_exclusion_of_plan(plan, Section127);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"specified fringe benefit plan\" means any plan under section 79, 105, 106, 125, 127, 129, or 137.")
rule S6039DdSpecifiedPlanSection129 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section129);
    then specified_fringe_benefit_plan(plan);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"applicable exclusion\" means, with respect to any specified fringe benefit plan, the section specified under paragraph (1) under which benefits under such plan are excludable from gross income.")
rule S6039DdApplicableExclusionSection129 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section129);
    when specified_fringe_benefit_plan(plan);
    then applicable_exclusion_of_plan(plan, Section129);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"specified fringe benefit plan\" means any plan under section 79, 105, 106, 125, 127, 129, or 137.")
rule S6039DdSpecifiedPlanSection137 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section137);
    then specified_fringe_benefit_plan(plan);
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "The term \"applicable exclusion\" means, with respect to any specified fringe benefit plan, the section specified under paragraph (1) under which benefits under such plan are excludable from gross income.")
rule S6039DdApplicableExclusionSection137 strict {
    for plan: us.irc.core::Asset;
    when plan_under_section(plan, Section137);
    when specified_fringe_benefit_plan(plan);
    then applicable_exclusion_of_plan(plan, Section137);
}

relation multiemployer_plan_holds_information(plan: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary determines, on the basis of the agreement between the plan and the employer, that the information is held by the plan and not the employer";
}

relation multiemployer_plan_must_provide_information(plan: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en unofficial "section 6039D(d)(3): the multiemployer plan is required to provide the information";
}

@source(IRC_S6039D_D, relation = formalizes, coverage = exact, quote = "the plan shall be required to provide any information required by this section which the Secretary determines, on the basis of the agreement between the plan and employer, is held by the plan (and not the employer).")
rule S6039Dd3MultiemployerPlanProvides strict {
    for plan: us.irc.core::Asset;
    for y: TaxableYear;
    when multiemployer_plan_holds_information(plan, y);
    then multiemployer_plan_must_provide_information(plan, y);
}

// ============================================================================
// §6039E, §6039G — passport, immigration and expatriation statements
// ============================================================================

relation individual_applies_for_passport_or_permanent_residence(ind: Individual, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the individual applies for a United States passport (or renewal) or applies to be lawfully accorded the privilege of residing permanently in the United States as an immigrant, on this date";
}

relation statement_included_with_application(ind: Individual, d: Date) kind empirical {
    label en unofficial "case fact: the individual included with the application the statement described in subsection (b)";
}

relation regulation_exempts_class_6039e(ind: Individual) kind empirical {
    label en unofficial "positive marker: the Secretary exempted a class of individuals by regulation";
}

@source(IRC_S6039E_A, relation = formalizes, coverage = exact, quote = "shall include with any such application a statement which includes the information described in subsection (b).")
rule S6039EStatementDuty defeasible {
    for ind: Individual;
    for y: TaxableYear;
    for d: Date;
    when individual_applies_for_passport_or_permanent_residence(ind, y, d);
    when not_known(individual_exempted_by_regulation_6039e(ind));
    then duty IncludePassportOrImmigrationStatement {
        bearer ind;
        beneficiary Secretary;
        goal achievement {
            condition statement_included_with_application(ind, d);
            window [d, d];
        }
    };
    then information_return_required(ind, Secretary, y, PassportOrImmigrantStatement6039E);
}

external judgment relation secretary_determines_6039e_exemption_unnecessary(ind: Individual) {
    authority Secretary;
    label en unofficial "the Secretary determines that applying section 6039E to the class of individuals is not necessary to carry out its purposes (DECISION-0194)";
}

relation class_exemption_candidate_6039e(ind: Individual) kind empirical {
    label en unofficial "positive anchor: the individual belongs to a class the Secretary may exempt";
}

relation secretary_exercises_individual_exempted_by_regulation_6039e(secretary: Organ, ind: Individual) kind empirical {
    label en unofficial "the Secretary exempts the class (the exercise)";
}

relation individual_exempted_by_regulation_6039e_in_effect(ind: Individual) kind institutional {
    label en unofficial "the exemption is in force (effect)";
}

relation individual_exempted_by_regulation_6039e(ind: Individual) kind institutional {
    label en unofficial "twin of the exemption power: feeds the statement duty";
}

@source(IRC_S6039E_E, relation = formalizes, coverage = exact, quote = "The Secretary may by regulations exempt any class of individuals from the requirements of this section if he determines that applying this section to such individuals is not necessary to carry out the purposes of this section.")
rule S6039EIndividualExemptedByRegulation6039ePowerTwin strict {
    for ind: Individual;
    when secretary_determines_6039e_exemption_unnecessary(ind);
    when secretary_exercises_individual_exempted_by_regulation_6039e(us.irc.core::Secretary, ind);
    then individual_exempted_by_regulation_6039e(ind);
}

@source(IRC_S6039E_E, relation = formalizes, coverage = exact, quote = "The Secretary may by regulations exempt any class of individuals from the requirements of this section if he determines that applying this section to such individuals is not necessary to carry out the purposes of this section.")
rule S6039EIndividualExemptedByRegulation6039ePower defeasible {
    for ind: Individual;
    when class_exemption_candidate_6039e(ind);
    then power SecretaryExemptsClassFromPassportStatement {
        holder us.irc.core::Secretary; over ind;
        exercise secretary_exercises_individual_exempted_by_regulation_6039e(us.irc.core::Secretary, ind);
        valid_when secretary_determines_6039e_exemption_unnecessary(ind);
        effect create(individual_exempted_by_regulation_6039e_in_effect(ind));
        window [-infinity, infinity];
    };
}

@source(IRC_S6039E_B, relation = formalizes, coverage = exact, quote = "the taxpayer's TIN (if any),")
rule S6039EStatementContent defeasible {
    for payer: Person;
    for y: TaxableYear;
    when information_return_required(payer, Secretary, y, PassportOrImmigrantStatement6039E);
    then required_return_item(payer, y, PassportOrImmigrantStatement6039E, I6039E_TaxpayerIdentificationNumber);
    then required_return_item(payer, y, PassportOrImmigrantStatement6039E, I6039E_OtherInformationAsPrescribed);
}

relation applicant_is_passport_applicant(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual is a passport applicant";
}

relation applicant_seeks_permanent_residence(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual seeks permanent residence";
}

@source(IRC_S6039E_B, relation = formalizes, coverage = exact, quote = "in the case of a passport applicant, any foreign country in which such individual is residing,")
rule S6039EPassportApplicantItem defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when information_return_required(ind, Secretary, y, PassportOrImmigrantStatement6039E);
    when applicant_is_passport_applicant(ind, y);
    then required_return_item(ind, y, PassportOrImmigrantStatement6039E, I6039E_ForeignCountryOfResidenceForPassportApplicant);
}

@source(IRC_S6039E_B, relation = formalizes, coverage = exact, quote = "in the case of an individual seeking permanent residence, information with respect to whether such individual is required to file a return of the tax imposed by chapter 1 for such individual's most recent 3 taxable years, and")
rule S6039EImmigrantItem defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when information_return_required(ind, Secretary, y, PassportOrImmigrantStatement6039E);
    when applicant_seeks_permanent_residence(ind, y);
    then required_return_item(ind, y, PassportOrImmigrantStatement6039E, I6039E_ThreeYearReturnFilingStatusForImmigrant);
}

relation failed_to_provide_6039e_statement(ind: Individual) kind empirical {
    label en unofficial "the individual failed to provide the required statement";
}

external judgment relation reasonable_cause_not_willful_neglect_6039e(ind: Individual) {
    authority Secretary;
    label en unofficial "the failure is shown to be due to reasonable cause and not to willful neglect (DECISION-0194)";
}

relation penalty_6039e(ind: Individual, amount: Money) kind institutional {
    label en unofficial "section 6039E(c): $500 for each failure";
}

@source(IRC_S6039E_C, relation = formalizes, coverage = exact, quote = "Any individual failing to provide a statement required under subsection (a) shall be subject to a penalty equal to $500 for each such failure, unless it is shown that such failure is due to reasonable cause and not to willful neglect.")
rule S6039EcPenalty500 defeasible {
    for ind: Individual;
    when failed_to_provide_6039e_statement(ind);
    when not_known(reasonable_cause_not_willful_neglect_6039e(ind));
    then penalty_6039e(ind, 500 USD);
}

relation agency_collects_6039e_statements(agency: Person) kind empirical {
    label en unofficial "the Federal agency collects (or is required to collect) the statement under subsection (a)";
}

relation agency_provided_statements_to_secretary(agency: Person) kind empirical {
    label en unofficial "case fact: the agency provided the statements to the Secretary";
}

relation agency_provided_refusing_names_to_secretary(agency: Person) kind empirical {
    label en unofficial "case fact: the agency provided the names and identifying information of individuals refusing to comply";
}

@source(IRC_S6039E_D, relation = formalizes, coverage = exact, quote = "provide any such statement to the Secretary, and")
rule S6039EdAgencyProvidesStatements defeasible {
    for agency: Person;
    when agency_collects_6039e_statements(agency);
    then duty ProvidePassportStatementsToSecretary {
        bearer agency;
        beneficiary Secretary;
        goal achievement {
            condition agency_provided_statements_to_secretary(agency);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6039E_D, relation = formalizes, coverage = exact, quote = "provide to the Secretary the name (and any other identifying information) of any individual refusing to comply with the provisions of subsection (a).")
rule S6039EdAgencyProvidesRefusingNames defeasible {
    for agency: Person;
    when agency_collects_6039e_statements(agency);
    then duty ProvideNamesOfRefusingApplicantsToSecretary {
        bearer agency;
        beneficiary Secretary;
        goal achievement {
            condition agency_provided_refusing_names_to_secretary(agency);
            window [-infinity, infinity];
        }
    };
}

relation individual_subject_to_877b_or_877a(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "section 877(b) or 877A applies to the individual for the taxable year";
}

relation expatriation_statement_provided(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the individual provided the statement for the year";
}

@source(IRC_S6039G_A, relation = formalizes, coverage = exact, quote = "any individual to whom section 877(b) or 877A applies for any taxable year shall provide a statement for such taxable year which includes the information described in subsection (b).")
rule S6039GStatementDuty defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when individual_subject_to_877b_or_877a(ind, y);
    then duty ProvideExpatriationStatement {
        bearer ind;
        beneficiary Secretary;
        goal achievement {
            condition expatriation_statement_provided(ind, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(ind, Secretary, y, ExpatriationStatement6039G);
}

@source(IRC_S6039G_B, relation = formalizes, coverage = exact, quote = "the taxpayer's TIN,")
rule S6039GStatementContent defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when information_return_required(ind, Secretary, y, ExpatriationStatement6039G);
    then required_return_item(ind, y, ExpatriationStatement6039G, I6039G_TaxpayerIdentificationNumber);
    then required_return_item(ind, y, ExpatriationStatement6039G, I6039G_MailingAddressOfPrincipalForeignResidence);
    then required_return_item(ind, y, ExpatriationStatement6039G, I6039G_ForeignCountryOfResidence);
    then required_return_item(ind, y, ExpatriationStatement6039G, I6039G_ForeignCountryOfCitizenship);
    then required_return_item(ind, y, ExpatriationStatement6039G, I6039G_IncomeAssetsAndLiabilities);
    then required_return_item(ind, y, ExpatriationStatement6039G, I6039G_DaysPhysicallyPresentInUnitedStates);
    then required_return_item(ind, y, ExpatriationStatement6039G, I6039G_OtherInformationAsPrescribed);
}

relation statement_incomplete_or_incorrect_or_late_6039g(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual fails to file the statement on or before the required date, fails to include all the information, or includes incorrect information";
}

external judgment relation reasonable_cause_not_willful_neglect_6039g(ind: Individual, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the failure is shown to be due to reasonable cause and not to willful neglect (DECISION-0194)";
}

relation penalty_6039g(ind: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6039G(c): $10,000";
}

@source(IRC_S6039G_C, relation = formalizes, coverage = exact, quote = "such individual shall pay a penalty of $10,000 unless it is shown that such failure is due to reasonable cause and not to willful neglect.")
rule S6039GcPenalty10000 defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when individual_subject_to_877b_or_877a(ind, y);
    when statement_incomplete_or_incorrect_or_late_6039g(ind, y);
    when not_known(reasonable_cause_not_willful_neglect_6039g(ind, y));
    then penalty_6039g(ind, y, 10000 USD);
}

relation agency_collects_6039g_statements(agency: Person) kind empirical {
    label en unofficial "the Federal agency or court collects (or is required to collect) the statement under subsection (a)";
}

relation agency_provided_6039g_copies(agency: Person) kind empirical {
    label en unofficial "case fact: the agency or court provided copies and refusing names to the Secretary";
}

@source(IRC_S6039G_D, relation = formalizes, coverage = exact, quote = "any Federal agency or court which collects (or is required to collect) the statement under subsection (a) shall provide to the Secretary—")
rule S6039GdAgencyProvidesCopies defeasible {
    for agency: Person;
    when agency_collects_6039g_statements(agency);
    then duty ProvideExpatriationStatementsToSecretary {
        bearer agency;
        beneficiary Secretary;
        goal achievement {
            condition agency_provided_6039g_copies(agency);
            window [-infinity, infinity];
        }
    };
}

relation state_dept_certificate_of_loss_of_nationality_approved(agency: Person) kind empirical {
    label en unofficial "the Secretary of State approves certificates of loss of American nationality under section 358 of the Immigration and Nationality Act";
}

relation state_dept_provided_certificate_copies(agency: Person) kind empirical {
    label en unofficial "case fact: the Secretary of State provided a copy of each approved certificate to the Secretary";
}

@source(IRC_S6039G_D, relation = formalizes, coverage = exact, quote = "the Secretary of State shall provide to the Secretary a copy of each certificate as to the loss of American nationality under section 358 of the Immigration and Nationality Act which is approved by the Secretary of State, and")
rule S6039GdStateDepartmentProvidesCertificates defeasible {
    for agency: Person;
    when state_dept_certificate_of_loss_of_nationality_approved(agency);
    then duty ProvideCertificatesOfLossOfNationalityToSecretary {
        bearer agency;
        beneficiary Secretary;
        goal achievement {
            condition state_dept_provided_certificate_copies(agency);
            window [-infinity, infinity];
        }
    };
}

relation immigration_agency_revoked_lpr_status(agency: Person) kind empirical {
    label en unofficial "the Federal agency primarily responsible for administering the immigration laws has lawful permanent residents whose status was revoked or administratively or judicially determined to have been abandoned";
}

relation immigration_agency_provided_lpr_names(agency: Person) kind empirical {
    label en unofficial "case fact: the agency provided each such lawful permanent resident's name to the Secretary";
}

@source(IRC_S6039G_D, relation = formalizes, coverage = exact, quote = "the Federal agency primarily responsible for administering the immigration laws shall provide to the Secretary the name of each lawful permanent resident of the United States (within the meaning of section 7701(b)(6)) whose status as such has been revoked or has been administratively or judicially determined to have been abandoned.")
rule S6039GdImmigrationAgencyProvidesNames defeasible {
    for agency: Person;
    when immigration_agency_revoked_lpr_status(agency);
    then duty ProvideRevokedLprNamesToSecretary {
        bearer agency;
        beneficiary Secretary;
        goal achievement {
            condition immigration_agency_provided_lpr_names(agency);
            window [-infinity, infinity];
        }
    };
}

relation quarter_ended_with_expatriate_information_received(secretary: Organ, quarter_end: Date) kind empirical {
    label en unofficial "during the calendar quarter ending on this date the Secretary received information about an individual losing United States citizenship (section 877(a) or 877A)";
}

relation federal_register_publication_made(quarter_end: Date) kind empirical {
    label en unofficial "case fact: the Secretary published the names in the Federal Register";
}

@source(IRC_S6039G_D, relation = formalizes, coverage = exact, quote = "not later than 30 days after the close of each calendar quarter, the Secretary shall publish in the Federal Register the name of each individual losing United States citizenship (within the meaning of section 877(a) or 877A) with respect to whom the Secretary receives information under the preceding sentence during such quarter.")
rule S6039GdSecretaryPublishesNames defeasible {
    for q: Date;
    when quarter_ended_with_expatriate_information_received(us.irc.core::Secretary, q);
    then duty PublishNamesOfExpatriatesInFederalRegister {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition federal_register_publication_made(q);
            window [q, add_calendar_period(q, 30 calendar_day)];
        }
    };
}

// ============================================================================
// §6039F — foreign gifts
// ============================================================================

relation us_person_aggregate_foreign_gifts(person: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the aggregate foreign gifts received by the United States person during the taxable year (excluding qualified transfers under section 2503(e)(2) and distributions disclosed under section 6048(c))";
}

relation person_is_exempt_501c_organization(person: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person is an organization described in section 501(c) and exempt from tax under section 501(a)";
}

relation foreign_gifts_information_furnished(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the United States person furnished the information regarding each foreign gift";
}

@source(IRC_S6039F_A, relation = formalizes, coverage = exact, quote = "exceeds $10,000, such United States person shall furnish (at such time and in such manner as the Secretary shall prescribe) such information as the Secretary may prescribe regarding each foreign gift received during such year.")
rule S6039FaForeignGiftReportingDuty defeasible {
    for person: Person;
    for y: TaxableYear;
    for amount: Money;
    when us_person_aggregate_foreign_gifts(person, y, amount);
    when amount > 10000 USD;
    when not_known(person_is_exempt_501c_organization(person, y));
    then duty FurnishForeignGiftInformation {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition foreign_gifts_information_furnished(person, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(person, Secretary, y, ForeignGiftReturn6039F);
}

relation amount_from_non_us_person_treated_as_gift_or_bequest(person: Person, gift: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "an amount received from a person other than a United States person which the recipient treats as a gift or bequest";
}

relation qualified_transfer_2503e2_or_disclosed_6048c(gift: us.irc.core::Asset) kind empirical {
    label en unofficial "the amount is a qualified transfer (section 2503(e)(2)) or a distribution properly disclosed in a return under section 6048(c)";
}

relation foreign_gift(person: Person, gift: us.irc.core::Asset, amount: Money) kind institutional {
    label en unofficial "section 6039F(b): a foreign gift";
}

@source(IRC_S6039F_B, relation = formalizes, coverage = exact, quote = "the term \"foreign gift\" means any amount received from a person other than a United States person which the recipient treats as a gift or bequest.")
rule S6039FbForeignGiftDefinition defeasible {
    for person: Person;
    for gift: us.irc.core::Asset;
    for amount: Money;
    when amount_from_non_us_person_treated_as_gift_or_bequest(person, gift, amount);
    when not_known(qualified_transfer_2503e2_or_disclosed_6048c(gift));
    then foreign_gift(person, gift, amount);
}

relation failure_to_furnish_foreign_gift_information(person: Person, gift: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the United States person fails to furnish the information regarding the foreign gift within the time prescribed (including extensions)";
}

relation months_of_continuing_failure_6039f(person: Person, gift: us.irc.core::Asset, months: Integer) kind empirical {
    label en unofficial "the number of months for which the failure continues (TECH-GAPS G2409)";
}

external judgment relation reasonable_cause_not_willful_neglect_6039f(person: Person, gift: us.irc.core::Asset) {
    authority Secretary;
    label en unofficial "the failure is due to reasonable cause and not due to willful neglect (DECISION-0194)";
}

relation tax_consequences_of_gift_determined_by_secretary(person: Person, gift: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6039F(c)(1)(A): the tax consequences of the receipt of the gift are determined by the Secretary";
}

relation gift_penalty_uncapped_6039f(person: Person, gift: us.irc.core::Asset, amount: Money) kind institutional {
    label en unofficial "five percent of the gift for each month the failure continues";
}

relation gift_penalty_6039f(person: Person, gift: us.irc.core::Asset, amount: Money) kind institutional {
    label en unofficial "section 6039F(c)(1)(B): the amount payable, not more than 25 percent of the gift in the aggregate";
}

@source(IRC_S6039F_C, relation = formalizes, coverage = exact, quote = "the tax consequences of the receipt of such gift shall be determined by the Secretary, and")
rule S6039FcSecretaryDeterminesConsequences defeasible {
    for person: Person;
    for gift: us.irc.core::Asset;
    for y: TaxableYear;
    when failure_to_furnish_foreign_gift_information(person, gift, y);
    when not_known(reasonable_cause_not_willful_neglect_6039f(person, gift));
    then tax_consequences_of_gift_determined_by_secretary(person, gift);
}

@source(IRC_S6039F_C, relation = formalizes, coverage = exact, quote = "such United States person shall pay (upon notice and demand by the Secretary and in the same manner as tax) an amount equal to 5 percent of the amount of such foreign gift for each month for which the failure continues")
rule S6039FcPenaltyFivePercentPerMonth defeasible {
    for person: Person;
    for gift: us.irc.core::Asset;
    for y: TaxableYear;
    for amount: Money;
    for months: Integer;
    when failure_to_furnish_foreign_gift_information(person, gift, y);
    when foreign_gift(person, gift, amount);
    when months_of_continuing_failure_6039f(person, gift, months);
    when not_known(reasonable_cause_not_willful_neglect_6039f(person, gift));
    then gift_penalty_uncapped_6039f(person, gift, amount * 0.05 * months);
}

@source(IRC_S6039F_C, relation = formalizes, coverage = exact, quote = "(not to exceed 25 percent of such amount in the aggregate).")
rule S6039FcPenaltyWithinCap defeasible {
    for person: Person;
    for gift: us.irc.core::Asset;
    for amount: Money;
    for months: Integer;
    when foreign_gift(person, gift, amount);
    when months_of_continuing_failure_6039f(person, gift, months);
    when gift_penalty_uncapped_6039f(person, gift, amount * 0.05 * months);
    when months <= 5;
    then gift_penalty_6039f(person, gift, amount * 0.05 * months);
}

@source(IRC_S6039F_C, relation = formalizes, coverage = exact, quote = "(not to exceed 25 percent of such amount in the aggregate).")
rule S6039FcPenaltyAtCap defeasible {
    for person: Person;
    for gift: us.irc.core::Asset;
    for amount: Money;
    for months: Integer;
    for raw: Money;
    when foreign_gift(person, gift, amount);
    when months_of_continuing_failure_6039f(person, gift, months);
    when gift_penalty_uncapped_6039f(person, gift, raw);
    when months > 5;
    then gift_penalty_6039f(person, gift, amount * 0.25);
}

// ============================================================================
// §6039H — Alaska Native Settlement Trusts
// ============================================================================

relation fiduciary_of_electing_settlement_trust(fiduciary: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person is the fiduciary of an electing Settlement Trust (section 646(h)(1)) for the taxable year";
}

relation settlement_trust_statement_included(fiduciary: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the fiduciary included the statement with the trust's return of income";
}

@source(IRC_S6039H_A, relation = formalizes, coverage = exact, quote = "shall include with the return of income of the trust a statement containing the information required under subsection (c).")
rule S6039HaFiduciaryStatementDuty defeasible {
    for fiduciary: Person;
    for trust: Person;
    for y: TaxableYear;
    when fiduciary_of_electing_settlement_trust(fiduciary, trust, y);
    then duty IncludeSettlementTrustStatementWithReturn {
        bearer fiduciary;
        beneficiary Secretary;
        goal achievement {
            condition settlement_trust_statement_included(fiduciary, trust, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(fiduciary, Secretary, y, SettlementTrustStatement6039H);
}

@source(IRC_S6039H_C, relation = formalizes, coverage = exact, quote = "the amount of distributions made during the taxable year to each beneficiary,")
rule S6039HcContentItems defeasible {
    for fiduciary: Person;
    for y: TaxableYear;
    when information_return_required(fiduciary, Secretary, y, SettlementTrustStatement6039H);
    then required_return_item(fiduciary, y, SettlementTrustStatement6039H, I6039H_DistributionsToEachBeneficiary);
    then required_return_item(fiduciary, y, SettlementTrustStatement6039H, I6039H_TreatmentUnderSection646AndExcludableAmount);
    then required_return_item(fiduciary, y, SettlementTrustStatement6039H, I6039H_DistributionsDeemedMadeBySponsoringNativeCorporation);
}

relation statement_in_lieu_of_6034a_statements(fiduciary: Person, trust: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6039H(b): filing the statement is in lieu of the section 6034A statements to beneficiaries";
}

@source(IRC_S6039H_B, relation = formalizes, coverage = exact, quote = "The filing of any statement under this section shall be in lieu of the reporting requirements under section 6034A to furnish any statement to a beneficiary regarding amounts distributed to such beneficiary")
rule S6039HbInLieuOf6034A strict {
    for fiduciary: Person;
    for trust: Person;
    for y: TaxableYear;
    when settlement_trust_statement_included(fiduciary, trust, y);
    then statement_in_lieu_of_6034a_statements(fiduciary, trust, y);
}

relation settlement_trust_statement_required_date(trust: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the date on which the statement under subsection (a) is required to be filed";
}

relation statement_furnished_to_sponsoring_native_corporation(trust: Person, corp: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the trust furnished the statement to the sponsoring Native Corporation";
}

relation sponsoring_native_corporation_of(corp: Person, trust: Person) kind institutional {
    label en unofficial "the Native Corporation is the sponsoring Native Corporation of the trust (section 646(h)(5); pending: other-income-taxes)";
}

@source(IRC_S6039H_D, relation = formalizes, coverage = exact, quote = "The electing Settlement Trust shall, on or before the date on which the statement under subsection (a) is required to be filed, furnish such statement to the sponsoring Native Corporation (as so defined).")
rule S6039Hd1TrustFurnishesToSponsor defeasible {
    for fiduciary: Person;
    for trust: Person;
    for corp: Person;
    for y: TaxableYear;
    for d: Date;
    when fiduciary_of_electing_settlement_trust(fiduciary, trust, y);
    when sponsoring_native_corporation_of(corp, trust);
    when settlement_trust_statement_required_date(trust, y, d);
    then duty FurnishSettlementTrustStatementToSponsor {
        bearer trust;
        beneficiary corp;
        goal achievement {
            condition statement_furnished_to_sponsoring_native_corporation(trust, corp, y);
            window [-infinity, d];
        }
    };
}

relation recipient_of_646e3_distribution(corp: Person, recipient: Person, y: TaxableYear) kind empirical {
    label en unofficial "the recipient receives a distribution described in section 646(e)(3)";
}

relation distribution_statement_furnished_to_recipient(corp: Person, recipient: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the sponsoring Native Corporation furnished the recipient the statement of the amount deemed distributed";
}

@source(IRC_S6039H_D, relation = formalizes, coverage = exact, quote = "The sponsoring Native Corporation shall furnish each recipient of a distribution described in section 646(e)(3) a statement containing the amount deemed to have been distributed to such recipient by such corporation for the taxable year.")
rule S6039Hd2SponsorFurnishesToDistributees defeasible {
    for corp: Person;
    for recipient: Person;
    for y: TaxableYear;
    when recipient_of_646e3_distribution(corp, recipient, y);
    then duty FurnishDeemedDistributionStatementToRecipient {
        bearer corp;
        beneficiary recipient;
        goal achievement {
            condition distribution_statement_furnished_to_recipient(corp, recipient, y);
            window [-infinity, infinity];
        }
    };
}

relation native_corp_contribution_with_247e_election(corp: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Native Corporation made a contribution to a Settlement Trust to which an election under section 247(e) applies, in the calendar year";
}

relation election_statement_furnished_to_trust(corp: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the Native Corporation provided the Settlement Trust the statement regarding the election";
}

@source(IRC_S6039H_E, relation = formalizes, coverage = exact, quote = "shall provide such Settlement Trust with a statement regarding such election not later than January 31 of the calendar year subsequent to the calendar year in which the contribution was made.")
rule S6039He1ElectionStatementDuty defeasible {
    for corp: Person;
    for trust: Person;
    for y: TaxableYear;
    for end_date: Date;
    when native_corp_contribution_with_247e_election(corp, trust, y);
    when us.irc.core::ends(y, end_date);
    then duty ProvideSettlementTrustElectionStatement {
        bearer corp;
        beneficiary trust;
        goal achievement {
            condition election_statement_furnished_to_trust(corp, trust, y);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(corp, trust, y, SettlementTrustStatement6039H);
}

@source(IRC_S6039H_E, relation = formalizes, coverage = exact, quote = "the total amount of contributions to which the election under subsection (e) of section 247 applies,")
rule S6039He2ElectionStatementContent defeasible {
    for corp: Person;
    for trust: Person;
    for y: TaxableYear;
    when payee_statement_required(corp, trust, y, SettlementTrustStatement6039H);
    then required_statement_item(corp, y, SettlementTrustStatement6039H, I6039H_TotalContributionsWithElection);
    then required_statement_item(corp, y, SettlementTrustStatement6039H, I6039H_WhetherEachContributionWasCash);
    then required_statement_item(corp, y, SettlementTrustStatement6039H, I6039H_NoncashPropertyAcquisitionDateBasisAndValue);
    then required_statement_item(corp, y, SettlementTrustStatement6039H, I6039H_DateOfEachContribution);
    then required_statement_item(corp, y, SettlementTrustStatement6039H, I6039H_InformationForIdentifyingContributions);
}

// ============================================================================
// §6039I — employer-owned life insurance contracts
// ============================================================================

relation applicable_policyholder_owns_eoli(holder: Person, y: TaxableYear) kind empirical {
    label en unofficial "the applicable policyholder owns 1 or more employer-owned life insurance contracts issued after the date of enactment of section 6039I during the year";
}

relation applicable_policyholder_owns_eoli_contracts(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the applicable policyholder owns one or more employer-owned life insurance contracts issued after the date of enactment of section 6039I during the year";
}

@source(IRC_S6039I_A, relation = formalizes, coverage = exact, quote = "Every applicable policyholder owning 1 or more employer-owned life insurance contracts issued after the date of the enactment of this section shall file a return (at such time and in such manner as the Secretary shall by regulations prescribe) showing for each year such contracts are owned—")
rule S6039IaReturnDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when applicable_policyholder_owns_eoli_contracts(filer, y);
    then duty FileEmployerOwnedLifeInsuranceReturn {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, EmployerOwnedLifeInsuranceReturn6039I);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, EmployerOwnedLifeInsuranceReturn6039I);
}

@source(IRC_S6039I_A, relation = formalizes, coverage = exact, quote = "the number of employees of the applicable policyholder at the end of the year,")
rule S6039IaReturnContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, EmployerOwnedLifeInsuranceReturn6039I);
    then required_return_item(filer, y, EmployerOwnedLifeInsuranceReturn6039I, I6039I_NumberOfEmployeesAtYearEnd);
    then required_return_item(filer, y, EmployerOwnedLifeInsuranceReturn6039I, I6039I_NumberOfEmployeesInsured);
    then required_return_item(filer, y, EmployerOwnedLifeInsuranceReturn6039I, I6039I_TotalInsuranceInForce);
    then required_return_item(filer, y, EmployerOwnedLifeInsuranceReturn6039I, I6039I_PolicyholderNameAddressTinAndBusinessType);
    then required_return_item(filer, y, EmployerOwnedLifeInsuranceReturn6039I, I6039I_ValidConsentForEachInsuredEmployeeOrNumberWithout);
}

relation policyholder_kept_eoli_records(holder: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the policyholder keeps the records necessary to determine whether the requirements of section 6039I and section 101(j) are met";
}

@source(IRC_S6039I_B, relation = formalizes, coverage = exact, quote = "Each applicable policyholder owning 1 or more employer-owned life insurance contracts during any year shall keep such records as may be necessary for purposes of determining whether the requirements of this section and section 101(j) are met.")
rule S6039IbRecordsDuty defeasible {
    for holder: Person;
    for y: TaxableYear;
    when applicable_policyholder_owns_eoli_contracts(holder, y);
    then duty KeepEmployerOwnedLifeInsuranceRecords {
        bearer holder;
        beneficiary Secretary;
        goal maintenance {
            condition policyholder_kept_eoli_records(holder, y);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6039J — Commodity Credit Corporation market gains
// ============================================================================

relation market_gain_realized_on_ccc_loan_repayment(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer realizes market gain in the taxable year in relation to the repayment of a Commodity Credit Corporation loan, whatever the manner of repayment";
}

relation ccc_filed_market_gain_return(taxpayer: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the Commodity Credit Corporation, through the Secretary of Agriculture, made the return";
}

relation is_commodity_credit_corporation(ccc: Person) kind institutional {
    label en unofficial "the person is the Commodity Credit Corporation";
}

relation is_secretary_of_agriculture(usda: Person) kind institutional {
    label en unofficial "the person is the Secretary of Agriculture";
}

@source(IRC_S6039J_A, relation = formalizes, coverage = exact, quote = "The Commodity Credit Corporation, through the Secretary of Agriculture, shall make a return, according to the forms and regulations prescribed by the Secretary of the Treasury, setting forth any market gain realized by a taxpayer during the taxable year in relation to the repayment of a loan issued by the Commodity Credit Corporation, without regard to the manner in which such loan was repaid.")
rule S6039JaCccReturnDuty defeasible {
    for ccc: Person;
    for taxpayer: Person;
    for y: TaxableYear;
    for amount: Money;
    when is_commodity_credit_corporation(ccc);
    when market_gain_realized_on_ccc_loan_repayment(taxpayer, y, amount);
    then duty MakeCccMarketGainReturn {
        bearer ccc;
        beneficiary Secretary;
        goal achievement {
            condition ccc_filed_market_gain_return(taxpayer, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(ccc, taxpayer, y, CommodityCreditCorporationMarketGainReturn6039J);
}

relation usda_furnished_market_gain_statement(usda: Person, taxpayer: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the Secretary of Agriculture furnished the person a written statement showing the market gain reported";
}

@source(IRC_S6039J_B, relation = formalizes, coverage = exact, quote = "The Secretary of Agriculture shall furnish to each person whose name is required to be set forth in a return required under subsection (a) a written statement showing the amount of market gain reported in such return.")
rule S6039JbUsdaStatementDuty defeasible {
    for usda: Person;
    for ccc: Person;
    for taxpayer: Person;
    for y: TaxableYear;
    when is_secretary_of_agriculture(usda);
    when information_return_required(ccc, taxpayer, y, CommodityCreditCorporationMarketGainReturn6039J);
    then duty FurnishMarketGainStatement {
        bearer usda;
        beneficiary taxpayer;
        goal achievement {
            condition usda_furnished_market_gain_statement(usda, taxpayer, y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(usda, taxpayer, y, CommodityCreditCorporationMarketGainReturn6039J);
}
