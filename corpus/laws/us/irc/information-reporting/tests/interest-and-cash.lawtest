        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert trade_or_business(entity_ref("urn:us:irc:information_reporting:clir#DEALER1")) { id "f0"; origin case_input; }
        assert cash_received_in_transaction(entity_ref("urn:us:irc:information_reporting:clir#DEALER1"), entity_ref("urn:us:irc:information_reporting:clir#BUYER1"), entity_ref("urn:us:irc:information_reporting:clir#Y2026"), 10000.01 USD, @2026-01-15) { id "f1"; origin case_input; }
    }
    evaluate truth(information_return_required(entity_ref("urn:us:irc:information_reporting:clir#DEALER1"), entity_ref("urn:us:irc:information_reporting:clir#BUYER1"), entity_ref("urn:us:irc:information_reporting:clir#Y2026"), CashOverTenThousand6050I));
    expect truth_status == TRUE_ONLY;
}

