// --- §6049(a): interest $10 threshold -----------------------------------------

test "S6049-01-INTEREST-AT-10-RETURN-REQUIRED" {
    given {
        context { decision_time @2025-06-01T09:00:00-04:00; knowledge_time @2025-06-01T09:00:00-04:00; legal_time @2025-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert interest_payment_candidate(entity_ref("urn:us:irc:information_reporting:clir#BANK1"), entity_ref("urn:us:irc:information_reporting:clir#DEPOSITOR1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025"), 10 USD) { id "f0"; origin case_input; }
        assert makes_or_nominee_forwards_interest(entity_ref("urn:us:irc:information_reporting:clir#BANK1"), entity_ref("urn:us:irc:information_reporting:clir#DEPOSITOR1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025"), 10 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(information_return_required(entity_ref("urn:us:irc:information_reporting:clir#BANK1"), entity_ref("urn:us:irc:information_reporting:clir#DEPOSITOR1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025"), InterestPayments6049));
    expect truth_status == TRUE_ONLY;
}

