        assert is_payment_settlement_entity(entity_ref("urn:us:irc:information_reporting:clir#TPSO1")) { id "f1"; origin case_input; }
        assert is_third_party_settlement_organization(entity_ref("urn:us:irc:information_reporting:clir#TPSO1")) { id "f2"; origin case_input; }
        assert reportable_payment_transaction(entity_ref("urn:us:irc:information_reporting:clir#TPSO1"), entity_ref("urn:us:irc:information_reporting:clir#PAYEE3"), entity_ref("urn:us:irc:information_reporting:clir#Y2026"), 15000 USD) { id "f3"; origin case_input; }
