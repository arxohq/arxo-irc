// --- §6041(a): $600 threshold (pre-2026) -------------------------------------

test "S6041-01-PAYMENT-AT-600-PRE-2026-RETURN-REQUIRED" {
    given {
        context { decision_time @2025-06-01T09:00:00-04:00; knowledge_time @2025-06-01T09:00:00-04:00; legal_time @2025-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert threshold_6041_lookup_year(entity_ref("urn:us:irc:information_reporting:clir#Y2025")) { id "f0"; origin case_input; }
        assert payment_at_source(entity_ref("urn:us:irc:information_reporting:clir#PAYER1"), entity_ref("urn:us:irc:information_reporting:clir#PAYEE1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025"), 600 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(information_return_required(entity_ref("urn:us:irc:information_reporting:clir#PAYER1"), entity_ref("urn:us:irc:information_reporting:clir#PAYEE1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025"), PaymentsAtSource6041));
    expect truth_status == TRUE_ONLY;
}

