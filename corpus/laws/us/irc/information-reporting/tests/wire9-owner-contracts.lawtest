// Information reporting WIRE-9 owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

test "W9-INF-01-SUBCHAPTER-T-PART-I-COOPERATIVE-FROM-EXEMPT-ORGANIZATIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.exempt_organizations::subchapter_t_part_i_applies_1381a(entity_ref("urn:test:w9inf:a#c")) { origin case_input; }
    }
    evaluate truth(is_subchapter_t_cooperative(entity_ref("urn:test:w9inf:a#c")));
    expect truth_status == TRUE_ONLY;
}

