test "S6045B-16-WAIVER-WHEN-SECRETARY-WAIVES-AND-ISSUER-REPORTS-PUBLICLY" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert issuer_publicly_reports_contact_information(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1")) { id "f0"; origin case_input; }
        assert issuer_publicly_reports_return_information(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1")) { id "f1"; origin case_input; }
        assert secretary_waives_6045B_requirements(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1")) { id "f2"; origin adjudicated; }
        assert issuer_of_specified_security(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1")) { id "f3"; origin case_input; }
    }
    evaluate truth(waiver_of_6045B_requirements(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1")));
    expect truth_status == TRUE_ONLY;
}

