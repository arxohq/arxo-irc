        context { decision_time @2025-03-10T09:00:00-05:00; knowledge_time @2025-03-10T09:00:00-05:00; legal_time @2025-03-10; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert issuer_of_specified_security(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1")) { id "f0"; origin case_input; }
        assert specified_security_class(entity_ref("urn:us:irc:information_reporting:clir#SEC1"), StockNonAverageBasis) { id "f1"; origin case_input; }
        assert organizational_action_affecting_basis_on(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1"), entity_ref("urn:us:irc:information_reporting:clir#ACTION1"), @2025-03-01) { id "f2"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:us:irc:information_reporting:clir#Y2025"), @2025-01-01) { id "f3"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:us:irc:information_reporting:clir#Y2025"), @2025-12-31) { id "f4"; origin case_input; }
        assert applicable_date_of_security(entity_ref("urn:us:irc:information_reporting:clir#SEC1"), @2011-01-01) { id "f5"; origin case_input; }
        assert specified_security(entity_ref("urn:us:irc:information_reporting:clir#SEC1")) { id "f6"; origin case_input; }
        assert nominee_or_certificate_holder_of_specified_security(entity_ref("urn:us:irc:information_reporting:clir#HOLDER1"), entity_ref("urn:us:irc:information_reporting:clir#SEC1")) { id "f7"; origin case_input; }
    }
    evaluate truth(payee_statement_due(entity_ref("urn:us:irc:information_reporting:clir#ISSUER1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025"), OrganizationalActionReturn6045B, @2026-01-15));
    expect truth_status == TRUE_ONLY;
}

