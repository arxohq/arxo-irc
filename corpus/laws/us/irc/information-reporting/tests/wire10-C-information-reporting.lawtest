// Information reporting WIRE-10 (group C) scenarios: placeholders derived from the package's own definitions.
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

test "W10C-INF-01-DEALER-DEFINITION-YIELDS-THE-BROKER-CLASSIFICATION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": person_is_dealer(entity_ref("urn:test:w10cinf:a#b")) { origin case_input; }
    }
    evaluate truth(is_broker(entity_ref("urn:test:w10cinf:a#b")));
    expect truth_status == TRUE_ONLY;
}

test "W10C-INF-02-NO-DEFINITION-FACT-NO-BROKER-CLASSIFICATION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": activity_only_managing_farm_for_another(entity_ref("urn:test:w10cinf:b#b")) { origin case_input; }
    }
    evaluate truth(is_broker(entity_ref("urn:test:w10cinf:b#b")));
    expect truth_status == FALSE_ONLY;
}

