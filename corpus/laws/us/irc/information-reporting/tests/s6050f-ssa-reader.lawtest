// Section 6050F(c)(2) SSA reader (IRC-G/G6, 27.09.2026).
// Вывод / нет факта источника: with the case-selected section 86(d)(1)
// content fact the social-security-benefit consequent derives (TRUE_ONLY);
// without it nothing derives (NEITHER). Expectations come from the
// statutory text. Honest boundary: the 86(d) content is Title-26-internal
// (gross-income package, already in corpus) — no SSA-package pin is read.
// NOT EXECUTED (implemented_unverified; execution is step 6, owner gate).

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

test "S6050F-SSA-01-BENEFIT-MEANING-DERIVES" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; }
        assert benefit_within_86d1_meaning_asserted_6050Fc2(entity_ref("urn:test:s6050fssa:1#i"), 12000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(social_security_benefit_6050Fc2(entity_ref("urn:test:s6050fssa:1#i"), 12000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6050F-SSA-02-WITHOUT-MEANING-NEITHER" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; }
    }
    evaluate truth(social_security_benefit_6050Fc2(entity_ref("urn:test:s6050fssa:2#i"), 12000 USD));
    expect truth_status == NEITHER;
}
