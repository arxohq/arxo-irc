test "S6045-01-BROKER-RETURN-REQUIRED-WHEN-SECRETARY-REQUIRES" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert is_broker(entity_ref("urn:us:irc:information_reporting:clir#BROKER1")) { id "f0"; origin case_input; }
        assert secretary_requires_broker_return(entity_ref("urn:us:irc:information_reporting:clir#BROKER1"), entity_ref("urn:us:irc:information_reporting:clir#CUSTOMER1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025")) { id "f1"; origin case_input; }
    }
    evaluate truth(information_return_required(entity_ref("urn:us:irc:information_reporting:clir#BROKER1"), entity_ref("urn:us:irc:information_reporting:clir#CUSTOMER1"), entity_ref("urn:us:irc:information_reporting:clir#Y2025"), BrokerProceeds6045));
    expect truth_status == TRUE_ONLY;
}

