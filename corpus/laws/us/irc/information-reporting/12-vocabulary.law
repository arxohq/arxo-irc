pub relation governmental_unit(unit: Person) kind institutional {
    label en unofficial "the person is a governmental unit or an agency or instrumentality of one (pending: definitions); several sections make the designated officer or employee the one who makes the return";
}
pub relation designated_officer_for_return(officer: Person, unit: Person, kind: InformationReturnKind) kind institutional {
    label en unofficial "the officer or employee has control of the payment, or is appropriately designated, to make the returns of this kind for the governmental unit";
}
pub relation required_return_item(filer: Person, y: TaxableYear, kind: InformationReturnKind, item: ReturnItem) kind institutional {
    label en unofficial "the statute requires the information return of this kind, made by the filer for the year, to contain this item (the Secretary's forms and regulations may add items)";
}
pub relation required_statement_item(furnisher: Person, y: TaxableYear, kind: InformationReturnKind, item: ReturnItem) kind institutional {
    label en unofficial "the statute requires the written statement furnished by this person for the year to contain this item";
}
