// §6051 (rest), §6052, §6053 (rest) and the Pub. L. 119-21 reporting
// amendments (§§70201, 70202: tips and overtime on Forms W-2 and 1099 for
// sections 6041, 6041A, 6050W, 6051) of package
// `us.irc.information_reporting`, module 16 (STAGE 2).
//
// JUDGMENT CALLS
//  - The §6053(c)(3) allocation formula (the stage-1 TECH-GAPS G35) is now a
//    rule: the excess of 8 percent of allocable gross receipts over the
//    tips employees reported for the payroll period; the allocable gross
//    receipts and the reported total per period are case facts (an
//    aggregate over receipts is not computed).
//  - The PL 119-21 tips and overtime items are effective for taxable years
//    beginning after 2024-12-31 (sections 70201(j), 70202(g)); the
//    section 70201(k)/70202(h) approximation for periods before 2026 is a
//    case fact, never a computed method.
//  - Two items are added to the stage-1 `W2ContentItem` enum and to the
//    completeness rule (module 05 edited).

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6051_A,
    IRC_S6051_B,
    IRC_S6051_C,
    IRC_S6051_E,
    IRC_S6051_F,
    IRC_S6051_G,
    IRC_S6052_A,
    IRC_S6052_B,
    IRC_S6053_C,
    Individual,
    InformationReturnKind,
    Organ,
    Period,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    W2ContentItem,
    allocated_tip_amount,
    excluded_from_6041,
    filed_information_return,
    furnished_payee_statement,
    group_term_life_statement_required,
    information_return_required,
    is_large_food_or_beverage_establishment,
    payee_statement_due,
    payee_statement_required,
    pays_third_party_sick_pay,
    received_sick_pay_statement_from_payor,
    required_return_item,
    required_statement_item,
    tip_allocation_statement_required,
    w2_content_item_applicable,
    w2_required,
};

// ============================================================================
// §6051 — special amounts, armed forces, additional items, railroad, sick pay, coverage definitions
// ============================================================================

pub enum Box5WageBasis {
    StandardSection3121a;
    UniformedServiceSection3121i2;
    PeaceCorpsVolunteerSection3121i3;
}

relation paid_for_uniformed_service(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the compensation is paid for service as a member of a uniformed service";
}

relation paid_for_peace_corps_volunteer_service(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the compensation is paid for service as a volunteer or volunteer leader within the meaning of the Peace Corps Act";
}

relation w2_wages_basis_for_item_5(employer: Person, employee: Individual, y: TaxableYear, basis: Box5WageBasis) kind institutional {
    label en unofficial "the computation basis of the wages shown by paragraph (5)";
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "In the case of compensation paid for service as a member of a uniformed service, the statement shall show, in lieu of the amount required to be shown by paragraph (5), the total amount of wages as defined in section 3121(a), computed in accordance with such section and section 3121(i)(2).")
rule S6051aUniformedServiceItem5 defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when w2_required(employer, employee, y);
    when paid_for_uniformed_service(employer, employee, y);
    then w2_wages_basis_for_item_5(employer, employee, y, UniformedServiceSection3121i2);
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "In the case of compensation paid for service as a volunteer or volunteer leader within the meaning of the Peace Corps Act, the statement shall show, in lieu of the amount required to be shown by paragraph (5), the total amount of wages as defined in section 3121(a), computed in accordance with such section and section 3121(i)(3).")
rule S6051aPeaceCorpsItem5 defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when w2_required(employer, employee, y);
    when paid_for_peace_corps_volunteer_service(employer, employee, y);
    then w2_wages_basis_for_item_5(employer, employee, y, PeaceCorpsVolunteerSection3121i3);
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "the total amount of wages as defined in section 3121(a)")
rule S6051aStandardItem5 defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when w2_required(employer, employee, y);
    when not_known(paid_for_uniformed_service(employer, employee, y));
    when not_known(paid_for_peace_corps_volunteer_service(employer, employee, y));
    then w2_wages_basis_for_item_5(employer, employee, y, StandardSection3121a);
}

relation tips_reported_to_employer_under_6053a(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "tips the employee furnished to the employer in statements under section 6053(a)";
}

relation w2_tips_included_in_items_3_and_5(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the tips that paragraphs (3) and (5) include: only those in statements furnished to the employer under section 6053(a)";
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "In the case of tips received by an employee in the course of his employment, the amounts required to be shown by paragraphs (3) and (5) shall include only such tips as are included in statements furnished to the employer pursuant to section 6053(a).")
rule S6051aTipsLimitedToReported defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for amount: Money;
    when w2_required(employer, employee, y);
    when tips_reported_to_employer_under_6053a(employer, employee, y, amount);
    then w2_tips_included_in_items_3_and_5(employer, employee, y, amount);
}

relation total_section_3121a_wages(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total amount of wages as defined in section 3121(a)";
}

relation wages_exempt_under_3101c_3111c(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "wages exempted pursuant to sections 3101(c) and 3111(c) from the taxes imposed by sections 3101 and 3111";
}

relation has_3101c_3111c_exempt_wages(employer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en unofficial "positive marker: the employee has wages exempt under sections 3101(c) and 3111(c)";
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "The amounts required to be shown by paragraph (5) shall not include wages which are exempted pursuant to sections 3101(c) and 3111(c) from the taxes imposed by sections 3101 and 3111.")
rule S6051aExemptWagesMarker strict {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for amount: Money;
    when wages_exempt_under_3101c_3111c(employer, employee, y, amount);
    then has_3101c_3111c_exempt_wages(employer, employee, y);
}

relation w2_item_5_amount(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the amount paragraph (5) shows: section 3121(a) wages less the wages exempt under sections 3101(c) and 3111(c)";
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "The amounts required to be shown by paragraph (5) shall not include wages which are exempted pursuant to sections 3101(c) and 3111(c) from the taxes imposed by sections 3101 and 3111.")
rule S6051aItem5ExcludesExemptWages defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for total: Money;
    for exempt: Money;
    when w2_required(employer, employee, y);
    when total_section_3121a_wages(employer, employee, y, total);
    when wages_exempt_under_3101c_3111c(employer, employee, y, exempt);
    then w2_item_5_amount(employer, employee, y, total - exempt);
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "shall not include wages which are exempted pursuant to sections 3101(c) and 3111(c)")
rule S6051aItem5NoExemptWages defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for total: Money;
    when w2_required(employer, employee, y);
    when total_section_3121a_wages(employer, employee, y, total);
    when not_known(has_3101c_3111c_exempt_wages(employer, employee, y));
    then w2_item_5_amount(employer, employee, y, total);
}

relation minimum_409a_deferral_relief_candidate(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor: the Secretary's minimum-deferral threshold is at issue for the item (13) amount";
}

relation secretary_min_deferral_determination(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "a regulation establishes a minimum amount of deferrals below which paragraph (13) does not apply, and the employee's deferrals are below it";
}

relation secretary_exercises_item_13_minimum_deferral_applies(secretary: Organ, employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary establishes the minimum deferral amount by regulation (the exercise)";
}

relation item_13_minimum_deferral_applies_in_effect(employer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the minimum is in force (effect)";
}

relation item_13_minimum_deferral_applies(employer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en unofficial "twin of the minimum-deferral power (E-0134)";
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "In the case of the amounts required to be shown by paragraph (13), the Secretary may (by regulation) establish a minimum amount of deferrals below which paragraph (13) does not apply.")
rule S6051Item13MinimumDeferralAppliesPowerTwin strict {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when secretary_min_deferral_determination(employer, employee, y);
    when secretary_exercises_item_13_minimum_deferral_applies(us.irc.core::Secretary, employer, employee, y);
    then item_13_minimum_deferral_applies(employer, employee, y);
}

@source(IRC_S6051_A, relation = formalizes, coverage = exact, quote = "In the case of the amounts required to be shown by paragraph (13), the Secretary may (by regulation) establish a minimum amount of deferrals below which paragraph (13) does not apply.")
rule S6051Item13MinimumDeferralAppliesPower defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when minimum_409a_deferral_relief_candidate(employer, employee, y);
    then power SecretaryEstablishesMinimumDeferralAmount {
        holder us.irc.core::Secretary; over employee;
        exercise secretary_exercises_item_13_minimum_deferral_applies(us.irc.core::Secretary, employer, employee, y);
        valid_when secretary_min_deferral_determination(employer, employee, y);
        effect create(item_13_minimum_deferral_applies_in_effect(employer, employee, y));
        window [-infinity, infinity];
    };
}

relation armed_forces_compensation_tax_withheld_3402(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "tax was withheld during the calendar year under section 3402 from compensation paid for service as a member of the Armed Forces";
}

relation armed_forces_compensation_includible_in_gross_income(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "any of the compensation paid during the year is includible in gross income under chapter 1";
}

relation armed_forces_amount_required_withheld_3101(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "an amount was required to be withheld as tax under section 3101 during the year";
}

relation armed_forces_statement_required(employer: Person, employee: Individual, y: TaxableYear) kind institutional {
    label en unofficial "section 6051(b): the statement for Armed Forces compensation is required";
}

@source(IRC_S6051_B, relation = formalizes, coverage = exact, quote = "the statement required by subsection (a) shall be furnished if any tax was withheld during the calendar year under section 3402,")
rule S6051bArmedForcesStatementRequired1 strict {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when armed_forces_compensation_tax_withheld_3402(employer, employee, y);
    then armed_forces_statement_required(employer, employee, y);
}

@source(IRC_S6051_B, relation = formalizes, coverage = exact, quote = "or if any of the compensation paid during such year is includible in gross income under chapter 1,")
rule S6051bArmedForcesStatementRequired2 strict {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when armed_forces_compensation_includible_in_gross_income(employer, employee, y);
    then armed_forces_statement_required(employer, employee, y);
}

@source(IRC_S6051_B, relation = formalizes, coverage = exact, quote = "or if during the calendar year any amount was required to be withheld as tax under section 3101.")
rule S6051bArmedForcesStatementRequired3 strict {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when armed_forces_amount_required_withheld_3101(employer, employee, y);
    then armed_forces_statement_required(employer, employee, y);
}

relation armed_forces_compensation_not_excluded(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation paid during the calendar year which is not excluded from gross income under chapter 1 (whether or not wages under section 3401(a))";
}

relation w2_item_3_amount_armed_forces(employer: Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the amount shown in lieu of paragraph (3): the compensation not excluded from gross income";
}

@source(IRC_S6051_B, relation = formalizes, coverage = exact, quote = "In lieu of the amount required to be shown by paragraph (3) of subsection (a), such statement shall show as wages paid during the calendar year the amount of such compensation paid during the calendar year which is not excluded from gross income under chapter 1")
rule S6051bArmedForcesItem3 defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for amount: Money;
    when armed_forces_statement_required(employer, employee, y);
    when armed_forces_compensation_not_excluded(employer, employee, y, amount);
    then w2_item_3_amount_armed_forces(employer, employee, y, amount);
}

relation armed_forces_w2_furnished(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the statement was furnished to the Armed Forces member";
}

@source(IRC_S6051_B, relation = formalizes, coverage = exact, quote = "In the case of compensation paid for service as a member of the Armed Forces, the statement required by subsection (a) shall be furnished")
rule S6051bArmedForcesStatementDuty defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when armed_forces_statement_required(employer, employee, y);
    then duty FurnishArmedForcesStatement {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition armed_forces_w2_furnished(employer, employee, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6051_C, relation = formalizes, coverage = exact, quote = "The statements required under this section shall also show the proportion of the total amount withheld as tax under section 3101 which is for financing the cost of hospital insurance benefits under part A of title XVIII of the Social Security Act.")
rule S6051cHospitalInsuranceItem defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when w2_required(employer, employee, y);
    then required_statement_item(employer, y, WageAndTaxStatement6051, I6051_ProportionOfSection3101WithheldForHospitalInsurance);
}

relation required_to_withhold_3201_from_employee(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the person is required to deduct and withhold tax under section 3201 from the employee";
}

relation railroad_notice_included_with_statement(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the notice about the credit or refund of the tax on wages imposed by section 3101(b) was included on or with the statement";
}

@source(IRC_S6051_E, relation = formalizes, coverage = exact, quote = "shall include on or with the statement required to be furnished such employee under subsection (a) a notice concerning the provisions of this title with respect to the allowance of a credit or refund of the tax on wages imposed by section 3101(b)")
rule S6051e1RailroadNoticeDuty defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when required_to_withhold_3201_from_employee(employer, employee, y);
    then duty IncludeRailroadCreditRefundNotice {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition railroad_notice_included_with_statement(employer, employee, y);
            window [-infinity, infinity];
        }
    };
}

relation employee_also_received_3101b_wages(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the employee has also received wages during the year subject to the tax imposed by section 3101(b)";
}

relation railroad_statement_requested_by_employee(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the employee requests the statement";
}

relation railroad_statement_furnished_on_request(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the statement was furnished to the employee";
}

@source(IRC_S6051_E, relation = formalizes, coverage = exact, quote = "shall, upon request of such employee, furnish to him a written statement showing—")
rule S6051e2RailroadStatementOnRequestDuty defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when required_to_withhold_3201_from_employee(employer, employee, y);
    when employee_also_received_3101b_wages(employer, employee, y);
    when railroad_statement_requested_by_employee(employer, employee, y);
    then duty FurnishRailroadCompensationStatementOnRequest {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition railroad_statement_furnished_on_request(employer, employee, y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(employer, employee, y, RailroadCompensationStatement6051e);
}

@source(IRC_S6051_E, relation = formalizes, coverage = exact, quote = "the total amount of compensation with respect to which the tax imposed by section 3201 was deducted,")
rule S6051e2StatementContent defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when payee_statement_required(employer, employee, y, RailroadCompensationStatement6051e);
    then required_statement_item(employer, y, RailroadCompensationStatement6051e, I6051e_TotalCompensationSubjectToTax3201);
    then required_statement_item(employer, y, RailroadCompensationStatement6051e, I6051e_TotalDeductedAsTax3201);
    then required_statement_item(employer, y, RailroadCompensationStatement6051e, I6051e_PortionForHospitalInsurance);
}

@source(IRC_S6051_F, relation = formalizes, coverage = exact, quote = "the name and, if there is withholding under section 3402(o), the social security number of such employee,")
rule S6051f1aPayorStatementContent defeasible {
    for payor: Person;
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when pays_third_party_sick_pay(payor, employer, employee, y);
    then required_statement_item(payor, y, ThirdPartySickPayStatement6051f, I6051f_NameAndSocialSecurityNumberIfWithholding);
    then required_statement_item(payor, y, ThirdPartySickPayStatement6051f, I6051f_TotalThirdPartySickPayPaid);
    then required_statement_item(payor, y, ThirdPartySickPayStatement6051f, I6051f_TotalDeductedAndWithheldUnder3402);
}

relation sick_pay_under_3402o2C(payment: us.irc.core::Asset) kind empirical {
    label en unofficial "the payment is sick pay as defined in section 3402(o)(2)(C)";
}

relation sick_pay_not_wages_for_chapter_24(payment: us.irc.core::Asset) kind empirical {
    label en unofficial "the sick pay does not constitute wages for purposes of chapter 24 (determined without regard to section 3402(o)(1))";
}

relation third_party_sick_pay(payment: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6051(f)(1)(A): sick pay that is not wages for chapter 24";
}

@source(IRC_S6051_F, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, the term \"third-party sick pay\" means any sick pay (as defined in section 3402(o)(2)(C)) which does not constitute wages for purposes of chapter 24 (determined without regard to section 3402(o)(1)).")
rule S6051f1aThirdPartySickPayDefinition strict {
    for payment: us.irc.core::Asset;
    when sick_pay_under_3402o2C(payment);
    when sick_pay_not_wages_for_chapter_24(payment);
    then third_party_sick_pay(payment);
}

@source(IRC_S6051_F, relation = formalizes, coverage = exact, quote = "The reporting requirements of subparagraph (A) with respect to any payments shall, with respect to such payments, be in lieu of the requirements of subsection (a) and of section 6041.")
rule S6051f1bInLieuOfSection6041 strict {
    for payor: Person;
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when pays_third_party_sick_pay(payor, employer, employee, y);
    then excluded_from_6041(payor, employee, y);
}

@source(IRC_S6051_F, relation = formalizes, coverage = exact, quote = "the information shown on the statement furnished under paragraph (1)(A), and")
rule S6051f2EmployerStatementContent defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when received_sick_pay_statement_from_payor(employer, employee, y);
    then required_statement_item(employer, y, EmployerSickPayStatement6051f2, I6051f2_InformationFromPayorStatement);
}

relation sick_pay_excludable_104a3_portion(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "a portion of the sick pay is excludable from gross income under section 104(a)(3)";
}

@source(IRC_S6051_F, relation = formalizes, coverage = exact, quote = "if any portion of the sick pay is excludable from gross income under section 104(a)(3), the portion which is not so excludable and the portion which is so excludable.")
rule S6051f2ExcludablePortionItem defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    when received_sick_pay_statement_from_payor(employer, employee, y);
    when sick_pay_excludable_104a3_portion(employer, employee, y);
    then required_statement_item(employer, y, EmployerSickPayStatement6051f2, I6051f2_ExcludableAndNonExcludablePortions);
}

relation group_health_coverage_made_available_by_employer(coverage: us.irc.core::Asset) kind empirical {
    label en unofficial "coverage under a group health plan made available to the employee by an employer";
}

relation coverage_excludable_under_106_or_would_be(coverage: us.irc.core::Asset) kind empirical {
    label en unofficial "the coverage is excludable from the employee's gross income under section 106, or would be if it were employer-provided coverage";
}

relation coverage_described_9832c1_other_than_G_or_long_term_care(coverage: us.irc.core::Asset) kind empirical {
    label en unofficial "coverage (through insurance or otherwise) described in section 9832(c)(1) (other than subparagraph (G)) or for long-term care";
}

relation separate_policy_substantially_all_mouth_or_eye(coverage: us.irc.core::Asset) kind empirical {
    label en unofficial "coverage under a separate policy, certificate or contract of insurance providing benefits substantially all of which are for treatment of the mouth or of the eye";
}

relation coverage_9832c3_not_excludable_and_no_162l_deduction(coverage: us.irc.core::Asset) kind empirical {
    label en unofficial "coverage described in section 9832(c)(3) whose payment is not excludable from gross income and for which a section 162(l) deduction is not allowable";
}

relation governmental_civilian_group_health_plan_coverage(coverage: us.irc.core::Asset) kind empirical {
    label en unofficial "coverage under a group health plan established and maintained primarily for its civilian employees by the Government of the United States, a State or political subdivision, or an agency or instrumentality";
}

relation applicable_employer_sponsored_coverage(coverage: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6051(g): applicable employer-sponsored coverage";
}

@source(IRC_S6051_G, relation = formalizes, coverage = exact, quote = "The term \"applicable employer-sponsored coverage\" means, with respect to any employee, coverage under any group health plan made available to the employee by an employer which is excludable from the employee's gross income under section 106, or would be so excludable if it were employer-provided coverage (within the meaning of such section 106).")
rule S6051g1AndExceptions defeasible {
    for coverage: us.irc.core::Asset;
    when group_health_coverage_made_available_by_employer(coverage);
    when coverage_excludable_under_106_or_would_be(coverage);
    when not_known(coverage_described_9832c1_other_than_G_or_long_term_care(coverage));
    when not_known(separate_policy_substantially_all_mouth_or_eye(coverage));
    when not_known(coverage_9832c3_not_excludable_and_no_162l_deduction(coverage));
    then applicable_employer_sponsored_coverage(coverage);
}

@source(IRC_S6051_G, relation = formalizes, coverage = exact, quote = "Applicable employer-sponsored coverage shall include coverage under any group health plan established and maintained primarily for its civilian employees by the Government of the United States, by the government of any State or political subdivision thereof, or by any agency or instrumentality of any such government.")
rule S6051g4GovernmentalPlans defeasible {
    for coverage: us.irc.core::Asset;
    when governmental_civilian_group_health_plan_coverage(coverage);
    then applicable_employer_sponsored_coverage(coverage);
}

// ============================================================================
// §6052 — group-term life insurance
// ============================================================================

relation group_term_life_provided_by_employer(employer: Person, employee: Person, y: TaxableYear, cost: Money) kind empirical {
    label en unofficial "the employer provides group-term life insurance on the life of the employee during part or all of the calendar year under a policy carried directly or indirectly by the employer, the cost includible in the employee's gross income under section 79(a) being this amount (determined as if the employer were the only employer paying such remuneration in the form of such insurance)";
}

@source(IRC_S6052_A, relation = formalizes, coverage = exact, quote = "Every employer who during any calendar year provides group-term life insurance on the life of an employee during part or all of such calendar year under a policy (or policies) carried directly or indirectly by such employer shall make a return according to the forms or regulations prescribed by the Secretary, setting forth the cost of such insurance and the name and address of the employee on whose life such insurance is provided, but only to the extent that the cost of such insurance is includible in the employee's gross income under section 79(a).")
rule S6052aReturnDuty defeasible {
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for cost: Money;
    when group_term_life_provided_by_employer(employer, employee, y, cost);
    when cost > 0 USD;
    then duty MakeGroupTermLifeInsuranceReturn {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(employer, employee, y, GroupTermLifeInsuranceReturn6052);
            window [-infinity, infinity];
        }
    };
    then information_return_required(employer, employee, y, GroupTermLifeInsuranceReturn6052);
}

@source(IRC_S6052_B, relation = formalizes, coverage = exact, quote = "Every employer required to make a return under subsection (a) shall furnish to each employee whose name is required to be set forth in such return a written statement showing the cost of the group-term life insurance shown on such return.")
rule S6052GroupTermLifeStatementRequiredForSection6041A defeasible {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for cost: Money;
    when group_term_life_provided_by_employer(employer, employee, y, cost);
    when cost > 0 USD;
    then group_term_life_statement_required(employer, employee, y);
}

@source(IRC_S6052_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the employee on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6052StatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, GroupTermLifeInsuranceReturn6052);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, GroupTermLifeInsuranceReturn6052, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6052_B, relation = formalizes, coverage = exact, quote = "Every employer required to make a return under subsection (a) shall furnish to each employee whose name is required to be set forth in such return a written statement showing the cost of the group-term life insurance shown on such return.")
rule S6052StatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, GroupTermLifeInsuranceReturn6052);
    when us.irc.core::ends(y, end_date);
    then duty FurnishGroupTermLifeStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, GroupTermLifeInsuranceReturn6052);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, GroupTermLifeInsuranceReturn6052);
}

// ============================================================================
// §6053(c) — large food or beverage establishments: report, statement, allocation
// ============================================================================

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "In the case of a large food or beverage establishment, each employer shall report to the Secretary, at such time and manner as the Secretary may prescribe by regulation, the following information with respect to each calendar year:")
rule S6053c1ReportRequirementMarker defeasible {
    for establishment: Person;
    for y: TaxableYear;
    when is_large_food_or_beverage_establishment(establishment, y);
    then information_return_required(establishment, Secretary, y, LargeFoodOrBeverageEstablishmentReport6053C);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "The gross receipts of such establishment from the provision of food and beverages (other than nonallocable receipts).")
rule S6053c1ReportItems defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, LargeFoodOrBeverageEstablishmentReport6053C);
    then required_return_item(filer, y, LargeFoodOrBeverageEstablishmentReport6053C, I6053_GrossReceiptsFromFoodAndBeveragesOtherThanNonallocable);
    then required_return_item(filer, y, LargeFoodOrBeverageEstablishmentReport6053C, I6053_AggregateChargeReceiptsOtherThanNonallocable);
    then required_return_item(filer, y, LargeFoodOrBeverageEstablishmentReport6053C, I6053_AggregateChargedTips);
    then required_return_item(filer, y, LargeFoodOrBeverageEstablishmentReport6053C, I6053_TipsReportedByEmployeesPlusSectionServiceCharges);
    then required_return_item(filer, y, LargeFoodOrBeverageEstablishmentReport6053C, I6053_AmountAllocatedToEachEmployee);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "Each employer described in paragraph (1) shall furnish, in such manner as the Secretary may prescribe by regulations, to each employee of the large food or beverage establishment a written statement for each calendar year showing the following information:")
rule S6053c2StatementRequirementMarker defeasible {
    for establishment: Person;
    for employee: Individual;
    for y: TaxableYear;
    for amount: Money;
    when is_large_food_or_beverage_establishment(establishment, y);
    when allocated_tip_amount(establishment, employee, y, amount);
    then payee_statement_required(establishment, employee, y, TipAllocationStatement6053C);
}

@source(IRC_S6053_C, relation = formalizes, coverage = partial, quote = "The name and address of such employer.")
rule S6053c2StatementItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, TipAllocationStatement6053C);
    then required_statement_item(payer, y, TipAllocationStatement6053C, I6053_NameAndAddressOfEmployer);
    then required_statement_item(payer, y, TipAllocationStatement6053C, I6053_NameOfEmployee);
    then required_statement_item(payer, y, TipAllocationStatement6053C, I6053_AmountAllocatedForAllPayrollPeriodsInYear);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "shall furnish, in such manner as the Secretary may prescribe by regulations, to each employee of the large food or beverage establishment a written statement for each calendar year")
rule S6053c2StatementRequiredForSection6041A defeasible {
    for establishment: Person;
    for employee: Individual;
    for y: TaxableYear;
    for amount: Money;
    when is_large_food_or_beverage_establishment(establishment, y);
    when allocated_tip_amount(establishment, employee, y, amount);
    then tip_allocation_statement_required(establishment, employee, y);
}

relation payroll_period_allocable_gross_receipts(establishment: Person, pp: Period, amount: Money) kind empirical {
    label en unofficial "the gross receipts of the establishment for the payroll period other than nonallocable receipts (an aggregate over receipts, supplied)";
}

relation payroll_period_tips_reported_by_employees(establishment: Person, pp: Period, amount: Money) kind empirical {
    label en unofficial "the aggregate amount reported to the employer under subsection (a) by the employees performing services during the payroll period who customarily receive tip income";
}

relation large_establishment_payroll_period(establishment: Person, pp: Period) kind empirical {
    label en unofficial "positive anchor: the payroll period of a large food or beverage establishment";
}

relation tip_allocation_percentage(establishment: Person, pp: Period, pct: Decimal) kind institutional {
    label en unofficial "the percentage of gross receipts required to be allocated: 8 percent, or the reduced percentage (not below 2 percent)";
}

relation secretary_reduced_tip_percentage(establishment: Person, pp: Period, pct: Decimal) kind empirical {
    label en unofficial "the reduced percentage the Secretary sets on petition (not below 2 percent)";
}

relation tip_percentage_reduced_in_effect(establishment: Person, pp: Period) kind institutional {
    label en unofficial "computational twin of the reduction power";
}

external judgment relation secretary_determines_tip_percentage_below_8(establishment: Person, pp: Period) {
    authority Secretary;
    label en unofficial "the Secretary determines that the percentage of gross receipts constituting tips is less than 8 percent (DECISION-0194)";
}

relation petition_to_reduce_tip_percentage(establishment: Person, pp: Period) kind empirical {
    label en unofficial "the employer or a majority of its employees petitions the Secretary";
}

relation secretary_exercises_tip_percentage_reduction_6053c3c(secretary: Organ, establishment: Person, pp: Period) kind empirical {
    label en unofficial "the Secretary reduces the percentage (the exercise)";
}

relation tip_percentage_reduction_6053c3c_in_effect(establishment: Person, pp: Period) kind institutional {
    label en unofficial "the reduction is in force (effect)";
}

relation tip_percentage_reduction_6053c3c(establishment: Person, pp: Period) kind institutional {
    label en unofficial "twin of the reduction power (E-0134)";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "Upon the petition of the employer or the majority of employees of such employer, the Secretary may reduce (but not below 2 percent) the percentage of gross receipts required to be allocated under subparagraph (A) where he determines that the percentage of gross receipts constituting tips is less than 8 percent.")
rule S6053TipPercentageReduction6053c3cPowerTwin strict {
    for establishment: Person;
    for pp: Period;
    when secretary_determines_tip_percentage_below_8(establishment, pp);
    when secretary_exercises_tip_percentage_reduction_6053c3c(us.irc.core::Secretary, establishment, pp);
    then tip_percentage_reduction_6053c3c(establishment, pp);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "Upon the petition of the employer or the majority of employees of such employer, the Secretary may reduce (but not below 2 percent) the percentage of gross receipts required to be allocated under subparagraph (A) where he determines that the percentage of gross receipts constituting tips is less than 8 percent.")
rule S6053TipPercentageReduction6053c3cPower defeasible {
    for establishment: Person;
    for pp: Period;
    when petition_to_reduce_tip_percentage(establishment, pp);
    then power SecretaryReducesTipAllocationPercentage {
        holder us.irc.core::Secretary; over establishment;
        exercise secretary_exercises_tip_percentage_reduction_6053c3c(us.irc.core::Secretary, establishment, pp);
        valid_when secretary_determines_tip_percentage_below_8(establishment, pp);
        effect create(tip_percentage_reduction_6053c3c_in_effect(establishment, pp));
        window [-infinity, infinity];
    };
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "the Secretary may reduce (but not below 2 percent) the percentage of gross receipts required to be allocated under subparagraph (A)")
rule S6053c3TwinFeedsReducedInEffect strict {
    for establishment: Person;
    for pp: Period;
    when tip_percentage_reduction_6053c3c(establishment, pp);
    then tip_percentage_reduced_in_effect(establishment, pp);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "8 percent of the gross receipts (other than nonallocable receipts) of such establishment for the payroll period, over")
rule S6053c3AEightPercent defeasible {
    for establishment: Person;
    for pp: Period;
    when large_establishment_payroll_period(establishment, pp);
    when not_known(tip_percentage_reduced_in_effect(establishment, pp));
    then tip_allocation_percentage(establishment, pp, 0.08);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "the Secretary may reduce (but not below 2 percent) the percentage of gross receipts required to be allocated")
rule S6053c3CReducedPercentage defeasible {
    for establishment: Person;
    for pp: Period;
    for pct: Decimal;
    when tip_percentage_reduced_in_effect(establishment, pp);
    when secretary_reduced_tip_percentage(establishment, pp, pct);
    when pct >= 0.02;
    when pct < 0.08;
    then tip_allocation_percentage(establishment, pp, pct);
}

relation required_tip_allocation(establishment: Person, pp: Period, amount: Money) kind institutional {
    label en unofficial "section 6053(c)(3)(A): the amount to allocate among tipped employees for the payroll period: the excess of the percentage of allocable gross receipts over the tips employees reported";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "the employer of a large food or beverage establishment shall allocate (as tips for purposes of the requirements of this subsection) among employees performing services during any payroll period who customarily receive tip income an amount equal to the excess of—")
rule S6053c3AExcessToAllocate defeasible {
    for establishment: Person;
    for pp: Period;
    for gross: Money;
    for reported: Money;
    for pct: Decimal;
    when payroll_period_allocable_gross_receipts(establishment, pp, gross);
    when payroll_period_tips_reported_by_employees(establishment, pp, reported);
    when tip_allocation_percentage(establishment, pp, pct);
    when gross * pct > reported;
    then required_tip_allocation(establishment, pp, gross * pct - reported);
}

pub enum TipAllocationMethod {
    GoodFaithAgreement;
    RegulationMethod;
}

relation good_faith_agreement_of_employer_and_employees(establishment: Person, pp: Period) kind empirical {
    label en unofficial "the employer and the employees have a good faith agreement on the allocation";
}

relation tip_allocation_method(establishment: Person, pp: Period, method: TipAllocationMethod) kind institutional {
    label en unofficial "section 6053(c)(3)(B): the method of allocation";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "on the basis of a good faith agreement by the employer and the employees, or")
rule S6053c3BAgreementMethod defeasible {
    for establishment: Person;
    for pp: Period;
    when good_faith_agreement_of_employer_and_employees(establishment, pp);
    when large_establishment_payroll_period(establishment, pp);
    then tip_allocation_method(establishment, pp, GoodFaithAgreement);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "in the absence of an agreement under clause (i), in the manner determined under regulations prescribed by the Secretary.")
rule S6053c3BRegulationMethod defeasible {
    for establishment: Person;
    for pp: Period;
    when large_establishment_payroll_period(establishment, pp);
    when not_known(good_faith_agreement_of_employer_and_employees(establishment, pp));
    then tip_allocation_method(establishment, pp, RegulationMethod);
}

relation allocation_made_in_accordance_with_regulations(establishment: Person, pp: Period) kind empirical {
    label en unofficial "the amount is improperly allocated but the allocation is done in accordance with the regulations prescribed under paragraph (3)(B)";
}

relation employer_liable_for_improper_allocation(establishment: Person, pp: Period) kind institutional {
    label en unofficial "the employer is liable to any person for an improper allocation";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "The employer shall not be liable to any person if any amount is improperly allocated under paragraph (3)(B) if such allocation is done in accordance with the regulations prescribed under paragraph (3)(B).")
rule S6053c5EmployerNotLiable defeasible {
    for establishment: Person;
    for pp: Period;
    when allocation_made_in_accordance_with_regulations(establishment, pp);
    then immunity EmployerNotLiableForRegulationCompliantAllocation {
        holder establishment;
        protected_effect employer_liable_for_improper_allocation(establishment, pp);
        window [-infinity, infinity];
    };
}

relation receipt_allocable_to_carryout_sales(receipt: us.irc.core::Asset) kind empirical {
    label en unofficial "the receipts are allocable to carryout sales";
}

relation receipt_service_charge_10_percent_or_more(receipt: us.irc.core::Asset) kind empirical {
    label en unofficial "the receipts are allocable to services with respect to which a service charge of 10 percent or more is added";
}

relation nonallocable_receipt(receipt: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6053(c)(6): a nonallocable receipt";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "carryout sales, or")
rule S6053c6NonallocableCarryout strict {
    for receipt: us.irc.core::Asset;
    when receipt_allocable_to_carryout_sales(receipt);
    then nonallocable_receipt(receipt);
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "services with respect to which a service charge of 10 percent or more is added.")
rule S6053c6NonallocableServiceCharge strict {
    for receipt: us.irc.core::Asset;
    when receipt_service_charge_10_percent_or_more(receipt);
    then nonallocable_receipt(receipt);
}

relation provides_food_or_beverages(establishment: Person, y: TaxableYear) kind empirical {
    label en unofficial "the trade or business (or portion) provides food or beverages";
}

relation tipping_of_serving_employees_customary(establishment: Person, y: TaxableYear) kind empirical {
    label en unofficial "tipping of employees serving food or beverages by customers is customary";
}

relation normal_employees_on_typical_business_day(establishment: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the trade or business normally employed this number of employees (not counting an individual owning 50 percent or more in value of the stock of the operating corporation) on a typical business day during the preceding calendar year";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"large food or beverage establishment\" means any trade or business (or portion thereof)—")
rule S6053c4LargeEstablishment strict {
    for establishment: Person;
    for y: TaxableYear;
    for n: Integer;
    when provides_food_or_beverages(establishment, y);
    when tipping_of_serving_employees_customary(establishment, y);
    when normal_employees_on_typical_business_day(establishment, y, n);
    when n > 10;
    then is_large_food_or_beverage_establishment(establishment, y);
}

relation cpeo_treated_as_employer_3511(cpeo: Person, customer: Person, worksite_employee: Individual) kind empirical {
    label en unofficial "the certified professional employer organization is treated under section 3511 as the employer of the work site employee, who performs services for the customer";
}

relation customer_is_employer_for_6053c_reporting(customer: Person, worksite_employee: Individual) kind institutional {
    label en unofficial "section 6053(c)(8): the customer is the employer for purposes of reporting";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "the customer with respect to whom a work site employee performs services shall be the employer for purposes of reporting under this section")
rule S6053c8CustomerIsEmployerForReporting strict {
    for cpeo: Person;
    for customer: Person;
    for worksite_employee: Individual;
    when cpeo_treated_as_employer_3511(cpeo, customer, worksite_employee);
    then customer_is_employer_for_6053c_reporting(customer, worksite_employee);
}

relation cpeo_furnished_information_to_customer_and_secretary(cpeo: Person, customer: Person, worksite_employee: Individual) kind empirical {
    label en unofficial "case fact: the CPEO furnished the customer and the Secretary the prescribed information";
}

@source(IRC_S6053_C, relation = formalizes, coverage = exact, quote = "the certified professional employer organization shall furnish to the customer and the Secretary any information the Secretary prescribes as necessary to complete such reporting no later than such time as the Secretary shall prescribe.")
rule S6053c8CpeoFurnishesInformationDuty defeasible {
    for cpeo: Person;
    for customer: Person;
    for worksite_employee: Individual;
    when cpeo_treated_as_employer_3511(cpeo, customer, worksite_employee);
    then duty FurnishTipReportingInformationAsCpeo {
        bearer cpeo;
        beneficiary customer;
        goal achievement {
            condition cpeo_furnished_information_to_customer_and_secretary(cpeo, customer, worksite_employee);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// Pub. L. 119-21 sections 70201 and 70202 — tips and overtime reporting (taxable years beginning after 2024-12-31)
// ============================================================================

relation payment_includes_cash_tips_designated(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the payments include amounts reasonably designated as cash tips (an occupation described in section 224(d)(1) of the recipient being known)";
}

relation payment_includes_qualified_overtime(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the payments include qualified overtime compensation (section 225(c))";
}

relation cash_tips_reported_by_employee_under_6053a(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the employee reported cash tips under section 6053(a)";
}

relation employee_paid_qualified_overtime(employer: Person, employee: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the employer paid the employee qualified overtime compensation (section 225(c))";
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "the total amount of cash tips reported by the employee under section 6053(a) and the occupation described in section 224(d)(1) such person.")
rule S6051Item18CashTipsApplicable strict {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for s: Date;
    when w2_required(employer, employee, y);
    when cash_tips_reported_by_employee_under_6053a(employer, employee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then w2_content_item_applicable(employer, employee, y, CashTipsAndOccupation6051a18);
}

@source(us.irc.temporal::PL119_21_S70202, relation = formalizes, coverage = exact, quote = "the total amount of qualified overtime compensation (as defined in section 225(c)).")
rule S6051Item19QualifiedOvertimeApplicable strict {
    for employer: Person;
    for employee: Individual;
    for y: TaxableYear;
    for s: Date;
    when w2_required(employer, employee, y);
    when employee_paid_qualified_overtime(employer, employee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then w2_content_item_applicable(employer, employee, y, QualifiedOvertimeCompensation6051a19);
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "a separate accounting of any such amounts reasonably designated as cash tips and the occupation described in section 224(d)(1) of the person receiving such tips")
rule S6041aCashTipsAccountingItem70201 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when information_return_required(payer, payee, y, PaymentsAtSource6041);
    when payment_includes_cash_tips_designated(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_return_item(payer, y, PaymentsAtSource6041, I6041_SeparateAccountingOfCashTipsAndOccupation);
}

@source(us.irc.temporal::PL119_21_S70202, relation = formalizes, coverage = exact, quote = "and a separate accounting of any amount of qualified overtime compensation (as defined in section 225(c))")
rule S6041aQualifiedOvertimeAccountingItem70202 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when information_return_required(payer, payee, y, PaymentsAtSource6041);
    when payment_includes_qualified_overtime(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_return_item(payer, y, PaymentsAtSource6041, I6041_SeparateAccountingOfQualifiedOvertime);
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "(3) in the case of compensation to non-employees, the portion of payments that have been reasonably designated as cash tips and the occupation described in section 224(d)(1) of the person receiving such tips.")
rule S6041dCashTipsStatementItem70201 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when payee_statement_required(payer, payee, y, PaymentsAtSource6041);
    when payment_includes_cash_tips_designated(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_statement_item(payer, y, PaymentsAtSource6041, I6041_PortionOfPaymentsDesignatedAsCashTipsAndOccupation);
}

@source(us.irc.temporal::PL119_21_S70202, relation = formalizes, coverage = exact, quote = "(4) the portion of payments that are qualified overtime compensation (as defined in section 225(c)).")
rule S6041dQualifiedOvertimeStatementItem70202 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when payee_statement_required(payer, payee, y, PaymentsAtSource6041);
    when payment_includes_qualified_overtime(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_statement_item(payer, y, PaymentsAtSource6041, I6041_PortionOfPaymentsThatAreQualifiedOvertime);
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "a separate accounting of any such amounts reasonably designated as cash tips and the occupation described in section 224(d)(1) of the person receiving such tips")
rule S6041AaCashTipsAccountingItem70201 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when information_return_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    when payment_includes_cash_tips_designated(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_return_item(payer, y, ServiceRemunerationOrDirectSales6041A, I6041A_SeparateAccountingOfCashTipsAndOccupation);
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "(3) in the case of subsection (a), the portion of payments that have been reasonably designated as cash tips and the")
rule S6041AeCashTipsStatementItem70201 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when payee_statement_required(payer, payee, y, ServiceRemunerationOrDirectSales6041A);
    when payment_includes_cash_tips_designated(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_statement_item(payer, y, ServiceRemunerationOrDirectSales6041A, I6041A_PortionOfPaymentsDesignatedAsCashTipsAndOccupation);
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "(3) in the case of a third party settlement organization, the portion of reportable payment transactions that have been reasonably designated by payors as cash tips and the occupation described in section 224(d)(1) of the person receiving such tips.")
rule S6050WaCashTipsThirdPartyItem70201 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when information_return_required(payer, payee, y, PaymentCardAndThirdPartyNetwork6050W);
    when payment_includes_cash_tips_designated(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_return_item(payer, y, PaymentCardAndThirdPartyNetwork6050W, I6050W_PortionOfReportablePaymentTransactionsDesignatedAsCashTips);
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "a separate accounting of any such amounts that have been reasonably designated by payors as cash tips and the occupation described in section 224(d)(1) of the person receiving such tips")
rule S6050WfCashTipsStatementItem70201 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for s: Date;
    when payee_statement_required(payer, payee, y, PaymentCardAndThirdPartyNetwork6050W);
    when payment_includes_cash_tips_designated(payer, payee, y);
    when us.irc.core::begins(y, s);
    when s > @2024-12-31;
    then required_statement_item(payer, y, PaymentCardAndThirdPartyNetwork6050W, I6050W_SeparateAccountingOfCashTipsAndOccupation);
}

relation reporting_period_before_2026(y: TaxableYear) kind institutional {
    label en unofficial "the cash tips or qualified overtime are required to be reported for a period before January 1, 2026";
}

relation reasonable_method_specified_by_secretary(payer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary specified a reasonable method for approximating the separate accounting";
}

relation separate_accounting_may_be_approximated(payer: Person, y: TaxableYear) kind institutional {
    label en unofficial "sections 70201(k) and 70202(h): for periods before January 1, 2026 the separate accounting may be approximated by a reasonable method the Secretary specifies";
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "In the case of any cash tips required to be reported for periods before January 1, 2026")
rule S70201TransitionPeriodBefore2026 strict {
    for y: TaxableYear;
    for e: Date;
    when us.irc.core::ends(y, e);
    when e < @2026-01-01;
    then reporting_period_before_2026(y);
}

@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "may approximate a separate accounting of amounts designated as cash tips by any reasonable method specified by the Secretary.")
rule S70201TransitionApproximation strict {
    for payer: Person;
    for y: TaxableYear;
    when reporting_period_before_2026(y);
    when reasonable_method_specified_by_secretary(payer, y);
    then separate_accounting_may_be_approximated(payer, y);
}
