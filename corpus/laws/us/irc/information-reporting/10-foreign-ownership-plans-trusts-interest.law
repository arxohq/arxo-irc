// §6046, §6046A, §6047, §6048, §6049 (rest) — foreign corporation and
// partnership ownership returns, retirement-plan reports, foreign trust
// notices, and the interest-payment rules of package
// `us.irc.information_reporting`, module 10 (STAGE 2).
//
// JUDGMENT CALLS
//  - Event-based returns (§6046, §6046A, §6048) carry the calendar year of
//    the event as a fact argument so that `information_return_required`
//    and the content items key on the same year; the deadline is the 90th
//    day after the liability event (window end), "or such later day as the
//    Secretary may prescribe" is not modelled (no prescription pinned).
//  - Ownership percentages are Decimal facts (direct holdings); constructive
//    ownership and family attribution (§6046(c)) are added in module 19 (stage 3),
//    unrolled to two entities; longer chains are TECH-GAPS G6300.
//  - §6049(b)-(d): the stage-1 case-asserted `interest_payment_candidate` /
//    `interest_payment_excepted` stay; this module derives both from the
//    statutory categories and payee classes (the duty rule now reads the
//    derived exception through the existing `unless`).

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    AttributionRegime6300,
    Corporation,
    IRC_S6046A_A,
    IRC_S6046A_D,
    IRC_S6046_A,
    IRC_S6046_B,
    IRC_S6047_A,
    IRC_S6047_B,
    IRC_S6047_C,
    IRC_S6047_D,
    IRC_S6047_E,
    IRC_S6047_F,
    IRC_S6047_G,
    IRC_S6048_A,
    IRC_S6048_B,
    IRC_S6048_C,
    IRC_S6048_D,
    IRC_S6049_B,
    IRC_S6049_C,
    IRC_S6049_D,
    InformationReturnKind,
    Organ,
    OwnershipBasis6300,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    constructive_interest_percent,
    designated_officer_for_return,
    filed_information_return,
    furnished_payee_statement,
    governmental_unit,
    information_return_required,
    interest_payment_excepted,
    is_reportable_interest_payment,
    payee_described_in_6049b4,
    payee_statement_due,
    payee_statement_required,
    required_return_item,
    required_statement_item,
};

// ============================================================================
// §6046 — returns as to organization or reorganization of foreign corporations
// ============================================================================

relation voting_power_percent_of_foreign_corporation(person: Person, corp: Person, pct: Decimal) kind empirical {
    label en unofficial "percentage of the total combined voting power of all classes of stock entitled to vote that the person owns DIRECTLY (constructive ownership is added by constructive_interest_percent, module 19)";
}

relation value_percent_of_foreign_corporation(person: Person, corp: Person, pct: Decimal) kind empirical {
    label en unofficial "percentage of the total value of the stock that the person owns";
}

relation meets_stock_ownership_requirements_6046(person: Person, corp: Person) kind institutional {
    label en unofficial "section 6046(a)(2): the person owns 10 percent or more of the voting power or of the value";
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "the total combined voting power of all classes of stock of such corporation entitled to vote, or")
rule S6046a2VotingPowerRequirement strict {
    for person: Person;
    for corp: Person;
    for pct: Decimal;
    when constructive_interest_percent(Section267cFamilyRules, person, corp, VotingPowerBasis, pct);
    when pct >= 10.0;
    then meets_stock_ownership_requirements_6046(person, corp);
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "the total value of the stock of such corporation.")
rule S6046a2ValueRequirement strict {
    for person: Person;
    for corp: Person;
    for pct: Decimal;
    when constructive_interest_percent(Section267cFamilyRules, person, corp, StockValueBasis, pct);
    when pct >= 10.0;
    then meets_stock_ownership_requirements_6046(person, corp);
}

relation us_citizen_or_resident_becomes_officer_or_director(person: Person, corp: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the United States citizen or resident becomes an officer or director of the foreign corporation on this date";
}

relation us_person_acquires_stock_adding_to_existing(person: Person, corp: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the United States person acquires stock which, added to stock owned on the date of acquisition, meets the ownership requirements";
}

relation us_person_acquires_stock_alone(person: Person, corp: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the United States person acquires stock which, without regard to stock owned on the date of acquisition, meets the ownership requirements";
}

relation treated_as_us_shareholder_under_953c(person: Person, corp: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the person (not described in subparagraph (B)) is treated as a United States shareholder under section 953(c) as of this date";
}

relation becomes_us_person_meeting_ownership_requirements(person: Person, corp: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the person becomes a United States person on this date while meeting the stock ownership requirements";
}

relation filed_6046_return(person: Person, corp: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the person filed the section 6046 return";
}

relation us_person_meets_ownership_requirements_of_corporation(corp: Person) kind institutional {
    label en unofficial "a United States person meets the section 6046(a)(2) requirements with respect to the corporation";
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "if a United States person (as defined in section 7701(a)(30)) meets the stock ownership requirements of paragraph (2) with respect to such corporation,")
rule S6046UsPersonMeetsRequirements strict {
    for person: Person;
    for corp: Person;
    when meets_stock_ownership_requirements_6046(person, corp);
    when us_person_status_6046(person);
    then us_person_meets_ownership_requirements_of_corporation(corp);
}

relation us_person_status_6046(person: Person) kind institutional {
    label en unofficial "the person is a United States person (pending: definitions, section 7701(a)(30))";
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "each United States citizen or resident who becomes an officer or director of a foreign corporation if a United States person (as defined in section 7701(a)(30)) meets the stock ownership requirements of paragraph (2) with respect to such corporation,")
rule S6046aOfficerDirectorReturnDuty defeasible {
    for person: Person;
    for corp: Person;
    for y: TaxableYear;
    for d: Date;
    when us_citizen_or_resident_becomes_officer_or_director(person, corp, y, d);
    when us_person_meets_ownership_requirements_of_corporation(corp);
    then duty MakeForeignCorporationReturnAsOfficerOrDirector {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046_return(person, corp, y);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "who acquires stock which, when added to any stock owned on the date of such acquisition, meets the stock ownership requirements of paragraph (2) with respect to a foreign corporation, or")
rule S6046aAcquirerAddingReturnDuty defeasible {
    for person: Person;
    for corp: Person;
    for y: TaxableYear;
    for d: Date;
    when us_person_acquires_stock_adding_to_existing(person, corp, y, d);
    when us_person_status_6046(person);
    then duty MakeForeignCorporationReturnAsAcquirerAddingToHoldings {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046_return(person, corp, y);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "who acquires stock which, without regard to stock owned on the date of such acquisition, meets the stock ownership requirements of paragraph (2) with respect to a foreign corporation,")
rule S6046aAcquirerAloneReturnDuty defeasible {
    for person: Person;
    for corp: Person;
    for y: TaxableYear;
    for d: Date;
    when us_person_acquires_stock_alone(person, corp, y, d);
    when us_person_status_6046(person);
    then duty MakeForeignCorporationReturnAsAcquirerAlone {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046_return(person, corp, y);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "each person (not described in subparagraph (B)) who is treated as a United States shareholder under section 953(c) with respect to a foreign corporation, and")
rule S6046a953cShareholderReturnDuty defeasible {
    for person: Person;
    for corp: Person;
    for y: TaxableYear;
    for d: Date;
    when treated_as_us_shareholder_under_953c(person, corp, y, d);
    then duty MakeForeignCorporationReturnAs953cShareholder {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046_return(person, corp, y);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "each person who becomes a United States person while meeting the stock ownership requirements of paragraph (2) with respect to stock of a foreign corporation.")
rule S6046aBecomesUsPersonReturnDuty defeasible {
    for person: Person;
    for corp: Person;
    for y: TaxableYear;
    for d: Date;
    when becomes_us_person_meeting_ownership_requirements(person, corp, y, d);
    then duty MakeForeignCorporationReturnUponBecomingUsPerson {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046_return(person, corp, y);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
}

relation us_person_officer_or_director_of_953c_corporation(person: Person, corp: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the United States person is an officer or director of a foreign corporation with respect to which any person is treated as a United States shareholder under section 953(c)";
}

@source(IRC_S6046_A, relation = formalizes, coverage = exact, quote = "subparagraph (A) shall be treated as including a reference to each United States person who is an officer or director of such corporation.")
rule S6046a953cOfficerDirectorReturnDuty defeasible {
    for person: Person;
    for corp: Person;
    for y: TaxableYear;
    for d: Date;
    when us_person_officer_or_director_of_953c_corporation(person, corp, y, d);
    then duty MakeForeignCorporationReturnAsOfficerOrDirectorOf953cCorporation {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046_return(person, corp, y);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
}

relation regulation_in_effect_90_days_before_liability(person: Person, corp: Person, y: TaxableYear) kind empirical {
    label en unofficial "the regulation requiring the information has been in effect for at least 90 days before the day the person becomes liable to file the return";
}

relation regulations_prescribe_return_information_6046(person: Person, corp: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary's forms or regulations prescribe information about the foreign corporation for carrying out the income tax laws";
}

@source(IRC_S6046_B, relation = formalizes, coverage = partial, quote = "such information as the Secretary prescribes by forms or regulations as necessary for carrying out the provisions of the income tax laws")
rule S6046bReturnInformationItems defeasible {
    for person: Person;
    for corp: Person;
    for y: TaxableYear;
    when information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
    when regulations_prescribe_return_information_6046(person, corp, y);
    when regulation_in_effect_90_days_before_liability(person, corp, y);
    then required_return_item(person, y, ForeignCorporationStockReturn6046, I6046_InformationPrescribedByRegulation);
}

relation described_only_in_6046a1A(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person is described only in subsection (a)(1)(A) (officer or director)";
}

@source(IRC_S6046_B, relation = formalizes, coverage = partial, quote = "except that in the case of persons described only in subsection (a)(1)(A) the information required shall be limited to the names and addresses of persons described in subparagraph (B) or (C) of subsection (a)(1).")
rule S6046bOfficerDirectorLimitedInformation defeasible {
    for person: Person;
    for y: TaxableYear;
    when information_return_required(person, Secretary, y, ForeignCorporationStockReturn6046);
    when described_only_in_6046a1A(person, y);
    then required_return_item(person, y, ForeignCorporationStockReturn6046, I6046_NamesAndAddressesOfBAndCPersonsOnly);
}

// ============================================================================
// §6046A — returns as to interests in foreign partnerships
// ============================================================================

relation capital_interest_percent(person: Person, partnership: Person, pct: Decimal) kind empirical {
    label en unofficial "the person's capital interest held DIRECTLY in the partnership (attribution is added by constructive_interest_percent, module 19)";
}

relation profits_interest_percent(person: Person, partnership: Person, pct: Decimal) kind empirical {
    label en unofficial "the person's profits interest held DIRECTLY in the partnership (attribution is added by constructive_interest_percent, module 19)";
}

relation deductions_losses_interest_percent_by_regulation(person: Person, partnership: Person, pct: Decimal) kind empirical {
    label en unofficial "to the extent provided in regulations, the percentage of the partnership's deductions or losses allocated to the person";
}

relation ten_percent_interest_in_partnership(person: Person, partnership: Person) kind institutional {
    label en unofficial "section 6046A(d) via section 6038(e)(3)(C): an interest equal to 10 percent of the capital interest, of the profits interest, or (by regulation) of the deductions or losses";
}

@source(IRC_S6046A_D, relation = formalizes, coverage = exact, quote = "a 10-percent interest in a partnership is an interest described in section 6038(e)(3)(C).")
rule S6046ATenPercentCapital strict {
    for person: Person;
    for partnership: Person;
    for pct: Decimal;
    when capital_interest_percent(person, partnership, pct);
    when pct >= 10.0;
    then ten_percent_interest_in_partnership(person, partnership);
}

@source(IRC_S6046A_D, relation = formalizes, coverage = exact, quote = "a 10-percent interest in a partnership is an interest described in section 6038(e)(3)(C).")
rule S6046ATenPercentProfits strict {
    for person: Person;
    for partnership: Person;
    for pct: Decimal;
    when profits_interest_percent(person, partnership, pct);
    when pct >= 10.0;
    then ten_percent_interest_in_partnership(person, partnership);
}

@source(IRC_S6046A_D, relation = formalizes, coverage = exact, quote = "a 10-percent interest in a partnership is an interest described in section 6038(e)(3)(C).")
rule S6046ATenPercentDeductionsLosses strict {
    for person: Person;
    for partnership: Person;
    for pct: Decimal;
    when deductions_losses_interest_percent_by_regulation(person, partnership, pct);
    when pct >= 10.0;
    then ten_percent_interest_in_partnership(person, partnership);
}

relation ten_percent_interest_before_or_after_event(person: Person, partnership: Person, d: Date) kind empirical {
    label en unofficial "the United States person directly or indirectly holds at least a 10-percent interest in the partnership either before or after this acquisition or disposition";
}

relation acquires_interest_in_foreign_partnership(person: Person, partnership: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the United States person acquires an interest in the foreign partnership on this date";
}

relation disposes_of_interest_in_foreign_partnership(person: Person, partnership: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the United States person disposes of a portion of its interest on this date";
}

relation proportional_interest_change_percent(person: Person, partnership: Person, y: TaxableYear, d: Date, pct: Decimal) kind empirical {
    label en unofficial "the change in the person's proportional interest, expressed as the equivalent percentage interest";
}

relation regulation_excepts_6046a(person: Person, partnership: Person) kind empirical {
    label en unofficial "case fact: a Secretary regulation excepts the person from section 6046A(a)";
}

relation filed_6046a_return(person: Person, partnership: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "case fact: the person filed the section 6046A return for the event";
}

@source(IRC_S6046A_A, relation = formalizes, coverage = exact, quote = "who acquires any interest in a foreign partnership,")
rule S6046AAcquisitionReturnDuty defeasible {
    for person: Person;
    for partnership: Person;
    for y: TaxableYear;
    for d: Date;
    when us_person_status_6046(person);
    when acquires_interest_in_foreign_partnership(person, partnership, y, d);
    when ten_percent_interest_before_or_after_event(person, partnership, d);
    when not_known(regulation_excepts_6046a(person, partnership));
    then duty FileForeignPartnershipAcquisitionReturn {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046a_return(person, partnership, y, d);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignPartnershipInterestReturn6046A);
}

@source(IRC_S6046A_A, relation = formalizes, coverage = exact, quote = "who disposes of any portion of his interest in a foreign partnership, or")
rule S6046ADispositionReturnDuty defeasible {
    for person: Person;
    for partnership: Person;
    for y: TaxableYear;
    for d: Date;
    when us_person_status_6046(person);
    when disposes_of_interest_in_foreign_partnership(person, partnership, y, d);
    when ten_percent_interest_before_or_after_event(person, partnership, d);
    when not_known(regulation_excepts_6046a(person, partnership));
    then duty FileForeignPartnershipDispositionReturn {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046a_return(person, partnership, y, d);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignPartnershipInterestReturn6046A);
}

@source(IRC_S6046A_A, relation = formalizes, coverage = exact, quote = "whose proportional interest in a foreign partnership changes substantially,")
rule S6046AChangeReturnDuty defeasible {
    for person: Person;
    for partnership: Person;
    for y: TaxableYear;
    for d: Date;
    for pct: Decimal;
    when us_person_status_6046(person);
    when proportional_interest_change_percent(person, partnership, y, d, pct);
    when pct >= 10.0;
    when not_known(regulation_excepts_6046a(person, partnership));
    then duty FileForeignPartnershipInterestChangeReturn {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_6046a_return(person, partnership, y, d);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(person, Secretary, y, ForeignPartnershipInterestReturn6046A);
}

// ============================================================================
// §6047 — information relating to certain trusts and annuity plans
// ============================================================================

relation owner_employee_contributions_paid_to_plan_trust_or_contract(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "contributions have been paid on behalf of an owner-employee to a section 401(a) exempt trust or under a section 403(a) plan, and this person is its trustee or the issuer of a contract purchased by the trust or under the plan";
}

@source(IRC_S6047_A, relation = formalizes, coverage = exact, quote = "shall file such returns (in such form and at such times), keep such records, make such identification of contracts and funds (and accounts within such funds), and supply such information, as the Secretary shall by forms or regulations prescribe.")
rule S6047aTrusteeOrIssuerReturnDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when owner_employee_contributions_paid_to_plan_trust_or_contract(filer, y);
    then duty FileOwnerEmployeePlanReturn {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, RetirementPlanReturn6047);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, RetirementPlanReturn6047);
}

relation owner_employee_contribution_paid_on_behalf(individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "contributions have been paid on behalf of the individual as an owner-employee (section 401(c)(3)) to a section 401(a) exempt trust, or to an insurance company or other person under a section 403(a) plan";
}

relation owner_employee_furnished_information_to_trustee(individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the individual furnished the trustee, insurance company or other person the prescribed information";
}

@source(IRC_S6047_B, relation = formalizes, coverage = exact, quote = "shall furnish the trustee, insurance company, or other person, as the case may be, such information at such times and in such form and manner as the Secretary shall prescribe by forms or regulations.")
rule S6047bOwnerEmployeeInformationDuty defeasible {
    for individual: Person;
    for y: TaxableYear;
    when owner_employee_contribution_paid_on_behalf(individual, y);
    then duty FurnishOwnerEmployeeInformationToTrusteeOrIssuer {
        bearer individual;
        beneficiary individual;
        goal achievement {
            condition owner_employee_furnished_information_to_trustee(individual, y);
            window [-infinity, infinity];
        }
    };
}

relation regulation_extends_6047_to_ira_person(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "a Secretary regulation applies section 6047 to payments described in section 219 and to transactions of a section 408(a) trust or section 408(b) annuity for this person";
}

relation ira_trustee_or_annuity_issuer_covered_by_regulation(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person is the trustee of a section 408(a) trust or issuer of a section 408(b) annuity, or receives section 219 payments, and a regulation extends section 6047 to it";
}

@source(IRC_S6047_C, relation = formalizes, coverage = exact, quote = "To the extent provided by regulations prescribed by the Secretary, the provisions of this section apply with respect to any payment described in section 219 and to transactions of any trust described in section 408(a) or under an individual retirement annuity described in section 408(b).")
rule S6047cIraReturnDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when ira_trustee_or_annuity_issuer_covered_by_regulation(filer, y);
    then duty FileIraPlanReturn {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, RetirementPlanReturn6047);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, RetirementPlanReturn6047);
}

relation designated_distributions_paid_under_plan_or_contract(filer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employer maintaining or plan administrator of a plan (or issuer of a contract) from which designated distributions (section 3405(e)(1)) may be made, with distributions to a person aggregating this amount in the year";
}

@source(IRC_S6047_D, relation = formalizes, coverage = exact, quote = "make returns and reports regarding such plan (or contract) to the Secretary, to the participants and beneficiaries of such plan (or contract), and to such other persons as the Secretary may by regulations prescribe.")
rule S6047dDesignatedDistributionReportDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    for amount: Money;
    when designated_distributions_paid_under_plan_or_contract(filer, y, amount);
    when amount >= 10 USD;
    then duty MakeDesignatedDistributionReport {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, RetirementPlanReturn6047);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, RetirementPlanReturn6047);
    unless information_reportable_under_6050y(filer, y);
}

relation information_reportable_under_6050y(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the information is required to be reported under section 6050Y (life insurance contract transactions)";
}

relation esop_holding_404k_dividend_stock(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer maintaining, or the plan administrator of, an employee stock ownership plan which holds stock with respect to which section 404(k) applies to dividends paid on the stock";
}

@source(IRC_S6047_E, relation = formalizes, coverage = exact, quote = "to make returns and reports regarding such plan, transaction, or loan to the Secretary and to such other persons as the Secretary may prescribe.")
rule S6047eEsopReportDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when esop_holding_404k_dividend_stock(filer, y);
    then duty MakeEsopDividendReport {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, RetirementPlanReturn6047);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, RetirementPlanReturn6047);
    unless information_reportable_under_6050y(filer, y);
}

relation applicable_retirement_plan_with_designated_roth_contributions(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the plan administrator of an applicable retirement plan (section 402A) with designated Roth contributions in the year";
}

@source(IRC_S6047_F, relation = formalizes, coverage = exact, quote = "The Secretary shall require the plan administrator of each applicable retirement plan (as defined in section 402A) to make such returns and reports regarding designated Roth contributions")
rule S6047fRothReportDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when applicable_retirement_plan_with_designated_roth_contributions(filer, y);
    then duty MakeDesignatedRothContributionReport {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, RetirementPlanReturn6047);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, RetirementPlanReturn6047);
    unless information_reportable_under_6050y(filer, y);
}

@source(IRC_S6047_G, relation = formalizes, coverage = exact, quote = "This section shall not apply to any information which is required to be reported under section 6050Y.")
rule S6047gExcludedInformationTwin strict {
    for filer: Person;
    for y: TaxableYear;
    when information_reportable_under_6050y(filer, y);
    then section_6047_excluded_information(filer, y);
}

relation section_6047_excluded_information(filer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the information is outside section 6047 because section 6050Y requires it";
}

// ============================================================================
// §6048 — foreign trusts with United States owners or beneficiaries
// ============================================================================

pub enum ForeignTrustReportableEvent {
    CreationOfForeignTrustByUsPerson;
    TransferToForeignTrustByUsPerson;
    TransferToForeignTrustByReasonOfDeath;
    DeathOfOwnerOfForeignTrustPortion;
    DeathWithForeignTrustInGrossEstate;
}

relation foreign_trust_event(evt: us.irc.core::Asset, kind: ForeignTrustReportableEvent, trust: Person, d: Date, y: TaxableYear) kind empirical {
    label en unofficial "the event occurs on this date (year given): a section 6048(a)(3)(A) event candidate";
}

relation event_for_fair_market_value_consideration(evt: us.irc.core::Asset) kind empirical {
    label en unofficial "the transfer is in exchange for consideration of at least the fair market value of the property (non-cash consideration at fair market value; section 679(a)(3) rules)";
}

relation trust_excepted_by_type_6048(trust: Person) kind institutional {
    label en unofficial "the trust is described in section 402(b), 404(a)(4) or 404A, or is determined by the Secretary to be described in section 501(c)(3)";
}

relation trust_is_402b_404a4_or_404A(trust: Person) kind empirical {
    label en unofficial "the trust is described in section 402(b), 404(a)(4) or 404A";
}

external judgment relation secretary_determines_trust_501c3(trust: Person) {
    authority Secretary;
    label en unofficial "the Secretary determines the trust to be described in section 501(c)(3) (DECISION-0194)";
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "described in section 402(b), 404(a)(4), or 404A, or")
rule S6048aExceptedTrustDeferredComp strict {
    for trust: Person;
    when trust_is_402b_404a4_or_404A(trust);
    then trust_excepted_by_type_6048(trust);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "determined by the Secretary to be described in section 501(c)(3).")
rule S6048aExceptedTrustCharitable strict {
    for trust: Person;
    when secretary_determines_trust_501c3(trust);
    then trust_excepted_by_type_6048(trust);
}

relation reportable_event_6048(evt: us.irc.core::Asset, kind: ForeignTrustReportableEvent, trust: Person, d: Date, y: TaxableYear) kind institutional {
    label en unofficial "section 6048(a)(3): a reportable event";
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the creation of any foreign trust by a United States person,")
rule S6048aCreationEvent defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    when foreign_trust_event(evt, CreationOfForeignTrustByUsPerson, trust, d, y);
    when not_known(trust_excepted_by_type_6048(trust));
    then reportable_event_6048(evt, CreationOfForeignTrustByUsPerson, trust, d, y);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the transfer of any money or property (directly or indirectly) to a foreign trust by a United States person, including a transfer by reason of death, and")
rule S6048aTransferEvent defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    when foreign_trust_event(evt, TransferToForeignTrustByUsPerson, trust, d, y);
    when not_known(trust_excepted_by_type_6048(trust));
    then reportable_event_6048(evt, TransferToForeignTrustByUsPerson, trust, d, y);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the transfer of any money or property (directly or indirectly) to a foreign trust by a United States person, including a transfer by reason of death, and")
rule S6048aTransferByDeathEvent defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    when foreign_trust_event(evt, TransferToForeignTrustByReasonOfDeath, trust, d, y);
    when not_known(trust_excepted_by_type_6048(trust));
    then reportable_event_6048(evt, TransferToForeignTrustByReasonOfDeath, trust, d, y);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the decedent was treated as the owner of any portion of a foreign trust under the rules of subpart E of part I of subchapter J of chapter 1, or")
rule S6048aDeathOwnerEvent defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    when foreign_trust_event(evt, DeathOfOwnerOfForeignTrustPortion, trust, d, y);
    when not_known(trust_excepted_by_type_6048(trust));
    then reportable_event_6048(evt, DeathOfOwnerOfForeignTrustPortion, trust, d, y);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "any portion of a foreign trust was included in the gross estate of the decedent.")
rule S6048aDeathEstateEvent defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    when foreign_trust_event(evt, DeathWithForeignTrustInGrossEstate, trust, d, y);
    when not_known(trust_excepted_by_type_6048(trust));
    then reportable_event_6048(evt, DeathWithForeignTrustInGrossEstate, trust, d, y);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "Subparagraph (A)(ii) shall not apply to any transfer of property to a trust in exchange for consideration of at least the fair market value of the transferred property.")
rule S6048aFairMarketValueTransferNotReportable strict {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    when foreign_trust_event(evt, TransferToForeignTrustByUsPerson, trust, d, y);
    when event_for_fair_market_value_consideration(evt);
    then fair_market_value_transfer_excepted_6048(evt);
}

relation fair_market_value_transfer_excepted_6048(evt: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6048(a)(3)(B)(i): the transfer is for at least fair market value consideration and is not a reportable event";
}

relation event_responsible_party(evt: us.irc.core::Asset, party: Person) kind institutional {
    label en unofficial "section 6048(a)(4): the responsible party for the event";
}

relation grantor_of_inter_vivos_trust(evt: us.irc.core::Asset, person: Person) kind empirical {
    label en unofficial "the person is the grantor on the creation of an inter vivos trust";
}

relation transferor_in_event(evt: us.irc.core::Asset, person: Person) kind empirical {
    label en unofficial "the person is the transferor in the event";
}

relation executor_of_decedent_estate_for_event(evt: us.irc.core::Asset, person: Person) kind empirical {
    label en unofficial "the person is the executor of the decedent's estate";
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the grantor in the case of the creation of an inter vivos trust,")
rule S6048aResponsiblePartyGrantor defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    for party: Person;
    when reportable_event_6048(evt, CreationOfForeignTrustByUsPerson, trust, d, y);
    when grantor_of_inter_vivos_trust(evt, party);
    then event_responsible_party(evt, party);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the transferor in the case of a reportable event described in paragraph (3)(A)(ii) other than a transfer by reason of death, and")
rule S6048aResponsiblePartyTransferor defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    for party: Person;
    when reportable_event_6048(evt, TransferToForeignTrustByUsPerson, trust, d, y);
    when transferor_in_event(evt, party);
    then event_responsible_party(evt, party);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the executor of the decedent's estate in any other case.")
rule S6048aResponsiblePartyExecutorTransferToForeignTrustByReasonOfDeath defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    for party: Person;
    when reportable_event_6048(evt, TransferToForeignTrustByReasonOfDeath, trust, d, y);
    when executor_of_decedent_estate_for_event(evt, party);
    then event_responsible_party(evt, party);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the executor of the decedent's estate in any other case.")
rule S6048aResponsiblePartyExecutorDeathOfOwnerOfForeignTrustPortion defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    for party: Person;
    when reportable_event_6048(evt, DeathOfOwnerOfForeignTrustPortion, trust, d, y);
    when executor_of_decedent_estate_for_event(evt, party);
    then event_responsible_party(evt, party);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the executor of the decedent's estate in any other case.")
rule S6048aResponsiblePartyExecutorDeathWithForeignTrustInGrossEstate defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for d: Date;
    for y: TaxableYear;
    for party: Person;
    when reportable_event_6048(evt, DeathWithForeignTrustInGrossEstate, trust, d, y);
    when executor_of_decedent_estate_for_event(evt, party);
    then event_responsible_party(evt, party);
}

relation foreign_trust_notice_given(party: Person, evt: us.irc.core::Asset) kind empirical {
    label en unofficial "case fact: the responsible party gave the Secretary written notice of the event";
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the responsible party shall provide written notice of such event to the Secretary in accordance with paragraph (2).")
rule S6048aNoticeDuty defeasible {
    for evt: us.irc.core::Asset;
    for trust: Person;
    for kind: ForeignTrustReportableEvent;
    for d: Date;
    for y: TaxableYear;
    for party: Person;
    when reportable_event_6048(evt, kind, trust, d, y);
    when event_responsible_party(evt, party);
    then duty GiveForeignTrustEventNotice {
        bearer party;
        beneficiary Secretary;
        goal achievement {
            condition foreign_trust_notice_given(party, evt);
            window [d, add_calendar_period(d, 90 calendar_day)];
        }
    };
    then information_return_required(party, Secretary, y, ForeignTrustNotice6048);
}

@source(IRC_S6048_A, relation = formalizes, coverage = exact, quote = "the amount of money or other property (if any) transferred to the trust in connection with the reportable event, and")
rule S6048aNoticeContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignTrustNotice6048);
    then required_return_item(payer, y, ForeignTrustNotice6048, I6048_AmountOfMoneyOrPropertyTransferred);
    then required_return_item(payer, y, ForeignTrustNotice6048, I6048_IdentityOfTrustTrusteesAndBeneficiaries);
    then required_return_item(payer, y, ForeignTrustNotice6048, I6048_OtherInformationAsPrescribed);
}

relation us_person_treated_as_owner_of_foreign_trust(owner: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "the United States person is treated as the owner of any portion of a foreign trust under subpart E of part I of subchapter J at any time during the taxable year";
}

relation owner_submitted_trust_information(owner: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the owner submitted the prescribed information with respect to the trust";
}

relation trust_made_return_with_full_accounting(trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the trust made a return with a full and complete accounting, the United States agent's name and the prescribed information";
}

relation trust_furnished_information_to_us_owners_and_distributees(trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the trust furnished the prescribed information to each United States owner and to each recipient of a distribution";
}

@source(IRC_S6048_B, relation = formalizes, coverage = exact, quote = "such person shall submit such information as the Secretary may prescribe with respect to such trust for such year")
rule S6048bOwnerInformationDuty defeasible {
    for owner: Person;
    for trust: Person;
    for y: TaxableYear;
    when us_person_treated_as_owner_of_foreign_trust(owner, trust, y);
    then duty SubmitForeignTrustOwnerInformation {
        bearer owner;
        beneficiary Secretary;
        goal achievement {
            condition owner_submitted_trust_information(owner, trust, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(owner, Secretary, y, ForeignTrustOwnerInformation6048B);
}

@source(IRC_S6048_B, relation = formalizes, coverage = exact, quote = "such trust makes a return for such year which sets forth a full and complete accounting of all trust activities and operations for the year, the name of the United States agent for such trust, and such other information as the Secretary may prescribe, and")
rule S6048bEnsureTrustReturnDuty defeasible {
    for owner: Person;
    for trust: Person;
    for y: TaxableYear;
    when us_person_treated_as_owner_of_foreign_trust(owner, trust, y);
    then duty EnsureForeignTrustMakesReturn {
        bearer owner;
        beneficiary Secretary;
        goal achievement {
            condition trust_made_return_with_full_accounting(trust, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6048_B, relation = formalizes, coverage = exact, quote = "such trust furnishes such information as the Secretary may prescribe to each United States person (i) who is treated as the owner of any portion of such trust or (ii) who receives (directly or indirectly) any distribution from the trust.")
rule S6048bEnsureTrustFurnishesInformationDuty defeasible {
    for owner: Person;
    for trust: Person;
    for y: TaxableYear;
    when us_person_treated_as_owner_of_foreign_trust(owner, trust, y);
    then duty EnsureForeignTrustFurnishesInformation {
        bearer owner;
        beneficiary Secretary;
        goal achievement {
            condition trust_furnished_information_to_us_owners_and_distributees(trust, y);
            window [-infinity, infinity];
        }
    };
}

relation trust_authorizes_us_limited_agent(trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign trust agrees, in the manner and on the conditions the Secretary prescribes, to authorize a United States person to act as its limited agent for sections 7602, 7603 and 7604 with respect to requests, records, testimony and summonses about the amounts taken into account";
}

relation secretary_determines_owner_amounts(owner: Person, trust: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6048(b)(2)(A): the amounts the United States person takes into account under subpart E are determined by the Secretary";
}

@source(IRC_S6048_B, relation = formalizes, coverage = exact, quote = "the determination of amounts required to be taken into account with respect to such trust by a United States person under the rules of subpart E of part I of subchapter J of chapter 1 shall be determined by the Secretary.")
rule S6048bSecretaryDeterminesAmountsWithoutAgent defeasible {
    for owner: Person;
    for trust: Person;
    for y: TaxableYear;
    when us_person_treated_as_owner_of_foreign_trust(owner, trust, y);
    when not_known(trust_authorizes_us_limited_agent(trust, y));
    then secretary_determines_owner_amounts(owner, trust, y);
}

relation us_person_acts_as_limited_agent_of_foreign_trust(agent: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "the United States person acts as the trust's limited agent for sections 7602, 7603 and 7604";
}

relation subjected_to_legal_process_for_other_purposes(agent: Person, y: TaxableYear) kind institutional {
    label en unofficial "the agent's appearance or its production of records is used to subject it or the records to legal process for a purpose other than determining the correct treatment of the subpart E amounts";
}

@source(IRC_S6048_B, relation = formalizes, coverage = exact, quote = "The appearance of persons or production of records by reason of a United States person being such an agent shall not subject such persons or records to legal process for any purpose other than determining the correct treatment under this title of the amounts required to be taken into account under the rules referred to in subparagraph (A).")
rule S6048bAgentImmunityFromOtherProcess defeasible {
    for agent: Person;
    for trust: Person;
    for y: TaxableYear;
    when us_person_acts_as_limited_agent_of_foreign_trust(agent, trust, y);
    then immunity LimitedAgentImmunityFromLegalProcessForOtherPurposes {
        holder agent;
        protected_effect subjected_to_legal_process_for_other_purposes(agent, y);
        window [-infinity, infinity];
    };
}

relation us_person_received_foreign_trust_distribution(recipient: Person, trust: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the United States person receives, directly or indirectly, a distribution from a foreign trust in the taxable year, aggregating this amount";
}

relation distribution_return_made(recipient: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the recipient made the section 6048(c) return";
}

@source(IRC_S6048_C, relation = formalizes, coverage = exact, quote = "such person shall make a return with respect to such trust for such year which includes—")
rule S6048cBeneficiaryReturnDuty defeasible {
    for recipient: Person;
    for trust: Person;
    for y: TaxableYear;
    for amount: Money;
    when us_person_received_foreign_trust_distribution(recipient, trust, y, amount);
    then duty MakeForeignTrustDistributionReturn {
        bearer recipient;
        beneficiary Secretary;
        goal achievement {
            condition distribution_return_made(recipient, trust, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(recipient, Secretary, y, ForeignTrustDistributionReturn6048C);
}

@source(IRC_S6048_C, relation = formalizes, coverage = exact, quote = "the name of such trust,")
rule S6048cReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignTrustDistributionReturn6048C);
    then required_return_item(payer, y, ForeignTrustDistributionReturn6048C, I6048_NameOfTrust);
    then required_return_item(payer, y, ForeignTrustDistributionReturn6048C, I6048_AggregateDistributionsReceivedInYear);
    then required_return_item(payer, y, ForeignTrustDistributionReturn6048C, I6048_OtherInformationAsPrescribed);
}

relation adequate_records_provided_for_distribution(recipient: Person, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "adequate records are provided to the Secretary to determine the proper treatment of the distribution";
}

relation trust_elects_similar_to_owner_agent_rules(trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "to the extent provided in regulations, the foreign trust elects to be subject to rules similar to those of subsection (b)(2)(B)";
}

relation distribution_treated_as_accumulation_distribution(recipient: Person, trust: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6048(c)(2)(A): the distribution is treated as an accumulation distribution includible in gross income under chapter 1";
}

@source(IRC_S6048_C, relation = formalizes, coverage = exact, quote = "such distribution shall be treated as an accumulation distribution includible in the gross income of the distributee under chapter 1.")
rule S6048cInadequateRecordsAccumulationDistribution defeasible {
    for recipient: Person;
    for trust: Person;
    for y: TaxableYear;
    for amount: Money;
    when us_person_received_foreign_trust_distribution(recipient, trust, y, amount);
    when not_known(adequate_records_provided_for_distribution(recipient, trust, y));
    when not_known(trust_elects_similar_to_owner_agent_rules(trust, y));
    then distribution_treated_as_accumulation_distribution(recipient, trust, y);
}

relation accumulation_distribution_applicable_years(recipient: Person, trust: Person, y: TaxableYear, years_in_existence: Integer, n: Decimal) kind institutional {
    label en unofficial "section 6048(c)(2)(B): for section 668(a) the applicable number of years is one half of the number of years the trust has existed";
}

relation trust_years_in_existence(trust: Person, years: Integer) kind empirical {
    label en unofficial "the number of years the foreign trust has been in existence";
}

@source(IRC_S6048_C, relation = formalizes, coverage = exact, quote = "the applicable number of years for purposes of section 668(a) shall be ½ of the number of years the trust has been in existence.")
rule S6048cHalfOfYearsInExistence defeasible {
    for recipient: Person;
    for trust: Person;
    for y: TaxableYear;
    for years: Integer;
    when distribution_treated_as_accumulation_distribution(recipient, trust, y);
    when trust_years_in_existence(trust, years);
    then accumulation_distribution_applicable_years(recipient, trust, y, years, years * 0.5);
}

relation regulation_treats_domestic_trust_as_foreign_6048(trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "a regulation applies section 6048d(2): the domestic trust has substantial activities or holds substantial property outside the United States";
}

relation domestic_trust_treated_as_foreign_6048(trust: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6048(d)(2): the trust which is a United States person is treated as a foreign trust for this section and section 6677";
}

@source(IRC_S6048_D, relation = formalizes, coverage = exact, quote = "a trust which is a United States person shall be treated as a foreign trust for purposes of this section and section 6677 if such trust has substantial activities, or holds substantial property, outside the United States.")
rule S6048dDomesticTrustTreatedAsForeign strict {
    for trust: Person;
    for y: TaxableYear;
    when regulation_treats_domestic_trust_as_foreign_6048(trust, y);
    then domestic_trust_treated_as_foreign_6048(trust, y);
}

external judgment relation secretary_determines_no_significant_us_tax_interest_6048(trust: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary determines that the United States has no significant tax interest in obtaining the required information (DECISION-0194)";
}

relation secretary_exercises_foreign_trust_requirement_suspended_6048(secretary: Organ, trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary suspends or modifies the section 6048 requirement (the exercise)";
}

relation foreign_trust_requirement_suspended_6048_in_effect(trust: Person, y: TaxableYear) kind institutional {
    label en unofficial "the suspension or modification is in force (effect)";
}

relation foreign_trust_requirement_suspended_6048(trust: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the suspension power (E-0134)";
}

@source(IRC_S6048_D, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to suspend or modify any requirement of this section if the Secretary determines that the United States has no significant tax interest in obtaining the required information.")
rule S6048ForeignTrustRequirementSuspended6048PowerTwin strict {
    for trust: Person;
    for y: TaxableYear;
    when secretary_determines_no_significant_us_tax_interest_6048(trust, y);
    when secretary_exercises_foreign_trust_requirement_suspended_6048(us.irc.core::Secretary, trust, y);
    then foreign_trust_requirement_suspended_6048(trust, y);
}

@source(IRC_S6048_D, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to suspend or modify any requirement of this section if the Secretary determines that the United States has no significant tax interest in obtaining the required information.")
rule S6048ForeignTrustRequirementSuspended6048Power defeasible {
    for trust: Person;
    for y: TaxableYear;
    when foreign_trust_requirement_relief_candidate(trust, y);
    then power SecretarySuspendsOrModifiesForeignTrustRequirement {
        holder us.irc.core::Secretary; over trust;
        exercise secretary_exercises_foreign_trust_requirement_suspended_6048(us.irc.core::Secretary, trust, y);
        valid_when secretary_determines_no_significant_us_tax_interest_6048(trust, y);
        effect create(foreign_trust_requirement_suspended_6048_in_effect(trust, y));
        window [-infinity, infinity];
    };
}

relation foreign_trust_requirement_relief_candidate(trust: Person, y: TaxableYear) kind empirical {
    label en unofficial "positive anchor: relief from the section 6048 requirements is at issue for the trust and year";
}

// ============================================================================
// §6049 — interest: categories, exceptions, payees, statements, definitions
// ============================================================================

pub enum InterestCategory {
    RegisteredOrPublicObligation;
    BankDeposit;
    ThriftInstitutionAmount;
    InsuranceCompanyHeldAmount;
    BrokerDeposit;
    InvestmentCompanyOrPooledFundAmount;
    OtherInterestByRegulation;
}

relation interest_of_category(payer: Person, payee: Person, y: TaxableYear, amount: Money, cat: InterestCategory) kind empirical {
    label en unofficial "the amount paid falls in this statutory interest category";
}

relation obligation_maturity_one_year_or_less_held_by_corporation(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the obligation has a maturity at issue of not more than 1 year and is held by a corporation";
}

relation interest_within_6049b1(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the amount is interest under section 6049(b)(1)";
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "interest on any obligation—")
rule S6049b1CategoryA defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_of_category(payer, payee, y, amount, RegisteredOrPublicObligation);
    when not_known(obligation_maturity_one_year_or_less_held_by_corporation(payer, payee, y));
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "interest on deposits with persons carrying on the banking business,")
rule S6049b1CategoryB defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_of_category(payer, payee, y, amount, BankDeposit);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "amounts (whether or not designated as interest) paid by a mutual savings bank, savings and loan association, building and loan association, cooperative bank, homestead association, credit union, industrial loan association or bank, or similar organization, in respect of deposits, investment certificates, or withdrawable or repurchasable shares,")
rule S6049b1CategoryC defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_of_category(payer, payee, y, amount, ThriftInstitutionAmount);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "interest on amounts held by an insurance company under an agreement to pay interest thereon,")
rule S6049b1CategoryD defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_of_category(payer, payee, y, amount, InsuranceCompanyHeldAmount);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "interest on deposits with brokers (as defined in section 6045(c)),")
rule S6049b1CategoryE defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_of_category(payer, payee, y, amount, BrokerDeposit);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "interest paid on amounts held by investment companies (as defined in section 3 of the Investment Company Act of 1940 (15 U.S.C. 80a–3)) and on amounts invested in other pooled funds or trusts, and")
rule S6049b1CategoryF defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_of_category(payer, payee, y, amount, InvestmentCompanyOrPooledFundAmount);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "to the extent provided in regulations prescribed by the Secretary, any other interest (which is not described in paragraph (2)).")
rule S6049b1CategoryG defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_of_category(payer, payee, y, amount, OtherInterestByRegulation);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), the term \"interest\" means—")
rule S6049IsReportableInterestByCategory defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_within_6049b1(payer, payee, y, amount);
    then is_reportable_interest_payment(payer, payee, y, amount);
    unless interest_payment_excepted(payer, payee, y, amount);
}

pub enum PayeeClass6049b4 {
    Corporation;
    ExemptOrganizationOrIndividualRetirementPlan;
    UnitedStatesOrWhollyOwnedAgency;
    StatePossessionOrPoliticalSubdivision;
    ForeignGovernmentOrSubdivision;
    InternationalOrganizationOrWhollyOwnedAgency;
    ForeignCentralBankOfIssue;
    RegisteredDealerInSecuritiesOrCommodities;
    RealEstateInvestmentTrust;
    RegisteredInvestmentCompany;
    CommonTrustFund;
    Trust664cExempt;
    Trust4947a1;
}

relation payee_in_class_6049b4(payee: Person, cls: PayeeClass6049b4) kind empirical {
    label en unofficial "the person is in this section 6049(b)(4) class";
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a corporation,")
rule S6049b4PayeeA strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, Corporation);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "an organization exempt from taxation under section 501(a) or an individual retirement plan,")
rule S6049b4PayeeB strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, ExemptOrganizationOrIndividualRetirementPlan);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "the United States or any wholly owned agency or instrumentality thereof,")
rule S6049b4PayeeC strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, UnitedStatesOrWhollyOwnedAgency);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a State, the District of Columbia, a possession of the United States, any political subdivision of any of the foregoing, or any wholly owned agency or instrumentality of any one or more of the foregoing,")
rule S6049b4PayeeD strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, StatePossessionOrPoliticalSubdivision);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a foreign government, a political subdivision of a foreign government, or any wholly owned agency or instrumentality of any one or more of the foregoing,")
rule S6049b4PayeeE strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, ForeignGovernmentOrSubdivision);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "an international organization or any wholly owned agency or instrumentality thereof,")
rule S6049b4PayeeF strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, InternationalOrganizationOrWhollyOwnedAgency);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a foreign central bank of issue,")
rule S6049b4PayeeG strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, ForeignCentralBankOfIssue);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a dealer in securities or commodities required to register as such under the laws of the United States or a State, the District of Columbia, or a possession of the United States,")
rule S6049b4PayeeH strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, RegisteredDealerInSecuritiesOrCommodities);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a real estate investment trust (as defined in section 856),")
rule S6049b4PayeeI strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, RealEstateInvestmentTrust);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "an entity registered at all times during the taxable year under the Investment Company Act of 1940,")
rule S6049b4PayeeJ strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, RegisteredInvestmentCompany);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a common trust fund (as defined in section 584(a)), or")
rule S6049b4PayeeK strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, CommonTrustFund);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "is exempt from tax under section 664(c), or")
rule S6049b4PayeeL1 strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, Trust664cExempt);
    then payee_described_in_6049b4(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "is described in section 4947(a)(1).")
rule S6049b4PayeeL2 strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, Trust4947a1);
    then payee_described_in_6049b4(payee);
}

relation payee_described_in_6049b4_restricted(payee: Person) kind institutional {
    label en unofficial "the payee is described in section 6049(b)(4) applied without regard to subparagraphs (A), (H), (I), (J), (K) and (L)(i) (sections 6049(d)(7)(B), (8)(B), (9)(B))";
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "an organization exempt from taxation under section 501(a) or an individual retirement plan,")
rule S6049b4RestrictedPayeeB strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, ExemptOrganizationOrIndividualRetirementPlan);
    then payee_described_in_6049b4_restricted(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "the United States or any wholly owned agency or instrumentality thereof,")
rule S6049b4RestrictedPayeeC strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, UnitedStatesOrWhollyOwnedAgency);
    then payee_described_in_6049b4_restricted(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a State, the District of Columbia, a possession of the United States, any political subdivision of any of the foregoing, or any wholly owned agency or instrumentality of any one or more of the foregoing,")
rule S6049b4RestrictedPayeeD strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, StatePossessionOrPoliticalSubdivision);
    then payee_described_in_6049b4_restricted(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a foreign government, a political subdivision of a foreign government, or any wholly owned agency or instrumentality of any one or more of the foregoing,")
rule S6049b4RestrictedPayeeE strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, ForeignGovernmentOrSubdivision);
    then payee_described_in_6049b4_restricted(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "an international organization or any wholly owned agency or instrumentality thereof,")
rule S6049b4RestrictedPayeeF strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, InternationalOrganizationOrWhollyOwnedAgency);
    then payee_described_in_6049b4_restricted(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "a foreign central bank of issue,")
rule S6049b4RestrictedPayeeG strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, ForeignCentralBankOfIssue);
    then payee_described_in_6049b4_restricted(payee);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "is described in section 4947(a)(1).")
rule S6049b4RestrictedPayeeL2 strict {
    for payee: Person;
    when payee_in_class_6049b4(payee, Trust4947a1);
    then payee_described_in_6049b4_restricted(payee);
}

relation amount_subject_to_chapter3_withholding_by_payer(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount is subject to withholding under subchapter A of chapter 3 by the person paying it";
}

relation amount_would_be_subject_but_for_foreign_source(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "would be subject to chapter 3 withholding but for the amount being income from sources outside the United States";
}

relation amount_would_be_subject_but_for_1441c_or_treaty(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "would be subject but for the payor being exempt from section 1441(a) by reason of section 1441(c) or a tax treaty";
}

relation amount_would_be_subject_but_for_oid(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "would be subject but for the amount being original issue discount (section 1273(a))";
}

relation amount_would_be_subject_but_for_871i2(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "would be subject but for the amount being described in section 871(i)(2)";
}

relation amount_described_in_6049b5(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6049(b)(5): the amount is described in the paragraph";
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "is subject to withholding under subchapter A of chapter 3 (relating to withholding of tax on nonresident aliens and foreign corporations) by the person paying such amount, or")
rule S6049b5Amount1 strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when amount_subject_to_chapter3_withholding_by_payer(payer, payee, y, amount);
    then amount_described_in_6049b5(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "such amount is income from sources outside the United States,")
rule S6049b5Amount2 strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when amount_would_be_subject_but_for_foreign_source(payer, payee, y, amount);
    then amount_described_in_6049b5(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "the payor thereof is exempt from the application of section 1441(a) by reason of section 1441(c) or a tax treaty,")
rule S6049b5Amount3 strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when amount_would_be_subject_but_for_1441c_or_treaty(payer, payee, y, amount);
    then amount_described_in_6049b5(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "such amount is original issue discount (within the meaning of section 1273(a)), or")
rule S6049b5Amount4 strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when amount_would_be_subject_but_for_oid(payer, payee, y, amount);
    then amount_described_in_6049b5(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "such amount is described in section 871(i)(2).")
rule S6049b5Amount5 strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when amount_would_be_subject_but_for_871i2(payer, payee, y, amount);
    then amount_described_in_6049b5(payer, payee, y, amount);
}

relation obligation_issued_by_natural_person(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the interest is on an obligation issued by a natural person";
}

relation regulation_otherwise_provides_6049b2(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: a Secretary regulation otherwise provides for the paragraph (2)(B) and (2)(C) exceptions";
}

relation interest_on_remic_credit_bond_or_1272a6_debt(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the interest is on a REMIC regular interest, a section 54(g) or 54A credit amount, or another debt instrument to which section 1272(a)(6) applies (section 6049(d)(7)-(9))";
}

relation income_from_sources_outside_us_or_paid_by_foreign_payor(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the amount is income from sources outside the United States or is paid by a foreign government, foreign central bank of issue, foreign corporation not engaged in a United States trade or business, a foreign corporation whose payments would be exempt from chapter 3 withholding, or a partnership not engaged in a United States trade or business and composed of nonresident aliens and those payors";
}

relation us_person_middleman_collects_foreign_interest_for_us_person(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "within the United States, a United States person collects (or acts as middleman for) such interest from a foreign person, or collects foreign-source interest from a United States person, for a second United States person, or pays such interest to the second person (section 6049(b)(3))";
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "interest on any obligation issued by a natural person,")
rule S6049b2ANaturalPerson defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_within_6049b1(payer, payee, y, amount);
    when obligation_issued_by_natural_person(payer, payee, y);
    then interest_payment_excepted(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "any amount paid to any person described in paragraph (4), or")
rule S6049b2BPayeeClass defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_within_6049b1(payer, payee, y, amount);
    when payee_described_in_6049b4(payee);
    when not_known(interest_on_remic_credit_bond_or_1272a6_debt(payer, payee, y, amount));
    when not_known(regulation_otherwise_provides_6049b2(payer, payee, y));
    then interest_payment_excepted(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "any amount paid to any person described in paragraph (4), or")
rule S6049b2BPayeeClassRestricted defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_within_6049b1(payer, payee, y, amount);
    when interest_on_remic_credit_bond_or_1272a6_debt(payer, payee, y, amount);
    when payee_described_in_6049b4_restricted(payee);
    when not_known(regulation_otherwise_provides_6049b2(payer, payee, y));
    then interest_payment_excepted(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "any amount described in paragraph (5), and")
rule S6049b2Bii defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_within_6049b1(payer, payee, y, amount);
    when amount_described_in_6049b5(payer, payee, y, amount);
    when not_known(regulation_otherwise_provides_6049b2(payer, payee, y));
    then interest_payment_excepted(payer, payee, y, amount);
}

@source(IRC_S6049_B, relation = formalizes, coverage = exact, quote = "except to the extent otherwise provided in regulations, any amount not described in subparagraph (B) of this paragraph which is income from sources outside the United States or which is paid by—")
rule S6049b2CForeign defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when interest_within_6049b1(payer, payee, y, amount);
    when income_from_sources_outside_us_or_paid_by_foreign_payor(payer, payee, y);
    when not_known(regulation_otherwise_provides_6049b2(payer, payee, y));
    when not_known(us_person_middleman_collects_foreign_interest_for_us_person(payer, payee, y, amount));
    then interest_payment_excepted(payer, payee, y, amount);
}

@source(IRC_S6049_C, relation = formalizes, coverage = exact, quote = "to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made, and")
rule S6049StatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, InterestPayments6049);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, InterestPayments6049, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6049_C, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6049StatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, InterestPayments6049);
    when us.irc.core::ends(y, end_date);
    then duty FurnishInterestStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, InterestPayments6049);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, InterestPayments6049);
}

@source(IRC_S6049_C, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6049StatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, InterestPayments6049);
    then required_statement_item(payer, y, InterestPayments6049, I6049_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, InterestPayments6049, I6049_AggregatePaymentsOrIncludibleAmount);
}

relation instrument_kind(instrument: us.irc.core::Asset, kind: InstrumentKind6049) kind empirical {
    label en unofficial "the kind of the instrument";
}

pub enum InstrumentKind6049 {
    Bond;
    Debenture;
    Note;
    Certificate;
    OtherEvidenceOfIndebtedness;
}

relation obligation_6049(instrument: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6049(d)(2): the instrument is an obligation (bonds, debentures, notes, certificates, and other evidences of indebtedness)";
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "The term \"obligation\" includes bonds, debentures, notes, certificates, and other evidences of indebtedness.")
rule S6049dObligationBond strict {
    for instrument: us.irc.core::Asset;
    when instrument_kind(instrument, Bond);
    then obligation_6049(instrument);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "The term \"obligation\" includes bonds, debentures, notes, certificates, and other evidences of indebtedness.")
rule S6049dObligationDebenture strict {
    for instrument: us.irc.core::Asset;
    when instrument_kind(instrument, Debenture);
    then obligation_6049(instrument);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "The term \"obligation\" includes bonds, debentures, notes, certificates, and other evidences of indebtedness.")
rule S6049dObligationNote strict {
    for instrument: us.irc.core::Asset;
    when instrument_kind(instrument, Note);
    then obligation_6049(instrument);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "The term \"obligation\" includes bonds, debentures, notes, certificates, and other evidences of indebtedness.")
rule S6049dObligationCertificate strict {
    for instrument: us.irc.core::Asset;
    when instrument_kind(instrument, Certificate);
    then obligation_6049(instrument);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "The term \"obligation\" includes bonds, debentures, notes, certificates, and other evidences of indebtedness.")
rule S6049dObligationOtherEvidenceOfIndebtedness strict {
    for instrument: us.irc.core::Asset;
    when instrument_kind(instrument, OtherEvidenceOfIndebtedness);
    then obligation_6049(instrument);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "the officer or employee having control of the payment of interest (or the person appropriately designated for purposes of this section) shall make the returns and statements required by this section.")
rule S6049OfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, InterestPayments6049);
    when information_return_required(unit, payee, y, InterestPayments6049);
    then duty MakeReturnAsDesignatedOfficer6049 {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, InterestPayments6049);
            window [-infinity, infinity];
        }
    };
}

relation regulation_substitutes_middleman_for_payor(middleman: Person, y: TaxableYear) kind empirical {
    label en unofficial "a regulation specifies this financial institution, broker or other person as the one that collects interest for the payee (or acts as middleman) and complies with subsections (a) and (c)";
}

relation middleman_collects_interest_for_payee(middleman: Person, payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person collects interest on the obligation for the payee, or otherwise acts as a middleman between payor and payee";
}

relation middleman_reports_interest(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6049(d)(4)(B): the interest is reported by a substituted middleman, so no other person is required to comply";
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "no other person shall be required to comply with the requirements of subsections (a) and (c) with respect to any interest on such obligation for which reporting is required pursuant to subparagraph (A).")
rule S6049dMiddlemanReportsInterest strict {
    for middleman: Person;
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when regulation_substitutes_middleman_for_payor(middleman, y);
    when middleman_collects_interest_for_payee(middleman, payer, payee, y, amount);
    then middleman_reports_interest(payer, payee, y, amount);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "a financial institution, broker, or other person specified in such regulations which collects interest on such obligation for the payee (or otherwise acts as a middleman between the payor and the payee) shall comply with the requirements of subsections (a) and (c), and")
rule S6049dMiddlemanReturnDuty defeasible {
    for middleman: Person;
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when regulation_substitutes_middleman_for_payor(middleman, y);
    when middleman_collects_interest_for_payee(middleman, payer, payee, y, amount);
    when amount >= 10 USD;
    then duty MakeMiddlemanInterestReturn {
        bearer middleman;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(middleman, payee, y, InterestPayments6049);
            window [-infinity, infinity];
        }
    };
    then information_return_required(middleman, payee, y, InterestPayments6049);
}

relation regulation_provides_transactional_basis(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "a regulation applies section 6049 on a transactional basis to the corporation payee-type person or, for United States savings bonds, the Federal agency";
}

relation transactional_basis_interest(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the interest is paid on a transactional basis rather than annual aggregation";
}

relation transaction_statement_in_lieu_permitted(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6049(d)(5)(C): a statement of the transaction may replace the subsection (c) statement, provided during January";
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "a statement of the transaction may be provided to the payee of such interest in lieu of the statement required under subsection (c).")
rule S6049dTransactionStatementInLieu strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when transactional_basis_interest(payer, payee, y, amount);
    when regulation_provides_transactional_basis(payer, y);
    when amount >= 10 USD;
    then transaction_statement_in_lieu_permitted(payer, payee, y, amount);
}

pub enum OidReportingBasis {
    AsIncludibleUnderSection1272;
    AtMaturityOrEarlierRedemption;
}

relation section_1272_applies_to_obligation(obligation: us.irc.core::Asset) kind empirical {
    label en unofficial "section 1272 applies to the obligation";
}

relation obligation_unregistered_issued_before_1983(obligation: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is not in registered form and was issued before January 1, 1983";
}

relation oid_reporting_basis(obligation: us.irc.core::Asset, basis: OidReportingBasis) kind institutional {
    label en unofficial "section 6049(d)(6)(A): when original issue discount is reported";
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "as if paid at the time it is includible in gross income under section 1272 (except that for such purpose the amount reportable with respect to any subsequent holder shall be determined as if he were the original holder), and")
rule S6049dOidAsIncludible strict {
    for obligation: us.irc.core::Asset;
    when section_1272_applies_to_obligation(obligation);
    when not_known(obligation_unregistered_issued_before_1983(obligation));
    then oid_reporting_basis(obligation, AsIncludibleUnderSection1272);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "if section 1272 does not apply to the obligation, at maturity (or, if earlier, on redemption).")
rule S6049dOidAtMaturity1272Inapplicable strict {
    for obligation: us.irc.core::Asset;
    when obligation_under_oid_reporting(obligation);
    when not_known(section_1272_applies_to_obligation(obligation));
    then oid_reporting_basis(obligation, AtMaturityOrEarlierRedemption);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "In the case of any obligation not in registered form issued before January 1, 1983, clause (ii) and not clause (i) shall apply.")
rule S6049dOidAtMaturityPre1983Unregistered strict {
    for obligation: us.irc.core::Asset;
    when obligation_unregistered_issued_before_1983(obligation);
    then oid_reporting_basis(obligation, AtMaturityOrEarlierRedemption);
}

relation obligation_under_oid_reporting(obligation: us.irc.core::Asset) kind empirical {
    label en unofficial "positive anchor: the obligation bears original issue discount reportable under section 6049(d)(6)";
}

relation remic_regular_interest_amount(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amount includible in gross income with respect to a regular interest in a REMIC (treated as paid when includible under section 860B(b))";
}

relation clean_renewable_energy_bond_credit_amount(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amount includible in gross income under section 54(g), treated as paid on the credit allowance date";
}

relation qualified_tax_credit_bond_credit_amount(payer: Person, payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amount includible in gross income under section 54A, treated as paid on the credit allowance date";
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "the term \"interest\" includes amounts includible in gross income with respect to regular interests in REMIC's (and such amounts shall be treated as paid when includible in gross income under section 860B(b)).")
rule S6049d7REMICInterest strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when remic_regular_interest_amount(payer, payee, y, amount);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "the term \"interest\" includes amounts includible in gross income under section 54(g) [1] and such amounts shall be treated as paid on the credit allowance date (as defined in section 54(b)(4)).[1]")
rule S6049d8CleanRenewableEnergyBondCredit strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when clean_renewable_energy_bond_credit_amount(payer, payee, y, amount);
    then interest_within_6049b1(payer, payee, y, amount);
}

@source(IRC_S6049_D, relation = formalizes, coverage = exact, quote = "the term \"interest\" includes amounts includible in gross income under section 54A [1] and such amounts shall be treated as paid on the credit allowance date (as defined in section 54A(e)(1)).[1]")
rule S6049d9QualifiedTaxCreditBondCredit strict {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for amount: Money;
    when qualified_tax_credit_bond_credit_amount(payer, payee, y, amount);
    then interest_within_6049b1(payer, payee, y, amount);
}
