// §6038, §6038A, §6038B, §6038C, §6038D, §6038E — information reporting
// for foreign business entities, foreign-owned and foreign corporations,
// transfers to foreign entities, and foreign financial assets, of package
// `us.irc.information_reporting`, module 12 (STAGE 2). Completes module 06.
//
// JUDGMENT CALLS
//  - "Control" (§6038(e)(2)-(3)) is computed from constructive percentages
//    (module 19, stage 3: §318 with the two modifications, §267(c)) and ONE
//    hop of the chain rule; longer attribution chains are TECH-GAPS G6300.
//  - The §6038(c) foreign-tax-credit reduction takes the number of 3-month
//    periods the failure continues as a case fact (TECH-GAPS G2409: date
//    difference to ceil-periods); the section (b) penalty offset reads the
//    aggregate of the stage-1 penalty as a case fact (G32).
//  - §6038A(e)/§6038C(d) (limited agent, summons, discretion, quash) are
//    modelled once over `reporting_corporation_6038a_or_c`.
//  - Reasonable cause is DECISION-0194 external judgment (authority
//    Secretary), never an arithmetic guard.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    AttributionRegime6300,
    Corporation,
    IRC_S6038A_B,
    IRC_S6038A_C,
    IRC_S6038A_D,
    IRC_S6038A_E,
    IRC_S6038B_A,
    IRC_S6038B_B,
    IRC_S6038B_C,
    IRC_S6038C_A,
    IRC_S6038C_B,
    IRC_S6038C_C,
    IRC_S6038D_B,
    IRC_S6038D_C,
    IRC_S6038D_D,
    IRC_S6038D_E,
    IRC_S6038D_F,
    IRC_S6038D_G,
    IRC_S6038E,
    IRC_S6038_A,
    IRC_S6038_C,
    IRC_S6038_D,
    IRC_S6038_E,
    Individual,
    InformationReturnKind,
    Organ,
    OwnershipBasis6300,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    constructive_interest_percent,
    controls_foreign_business_entity,
    deductions_losses_interest_percent_by_regulation,
    filed_information_return,
    information_return_required,
    is_25_percent_foreign_owned,
    is_domestic_corporation,
    required_return_item,
    value_percent_of_foreign_corporation,
    voting_power_percent_of_foreign_corporation,
};

// ============================================================================
// §6038(a), (d), (e) — control, information period and content
// ============================================================================

relation foreign_corporation_6038(e: Person) kind institutional {
    label en unofficial "the entity is a foreign corporation (pending: definitions, section 7701(a)(5))";
}

relation foreign_partnership_6038(e: Person) kind institutional {
    label en unofficial "the entity is a foreign partnership (pending: definitions)";
}

relation foreign_business_entity(e: Person) kind institutional {
    label en unofficial "section 6038(e)(1): a foreign corporation or a foreign partnership";
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "The term \"foreign business entity\" means a foreign corporation and a foreign partnership.")
rule S6038eForeignBusinessEntityCorporation strict {
    for e: Person;
    when foreign_corporation_6038(e);
    then foreign_business_entity(e);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "The term \"foreign business entity\" means a foreign corporation and a foreign partnership.")
rule S6038eForeignBusinessEntityPartnership strict {
    for e: Person;
    when foreign_partnership_6038(e);
    then foreign_business_entity(e);
}

relation person_controls_corporation_6038(person: Person, corp: Person) kind institutional {
    label en unofficial "section 6038(e)(2): the person is in control of the corporation";
}

relation person_directly_controls_corporation_6038(person: Person, corp: Person) kind institutional {
    label en unofficial "the person owns more than 50 percent of the voting power or of the value (first sentence of section 6038(e)(2))";
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "A person is in control of a corporation if such person owns stock possessing more than 50 percent of the total combined voting power of all classes of stock entitled to vote")
rule S6038eControlVotingPower strict {
    for person: Person;
    for corp: Person;
    for pct: Decimal;
    when constructive_interest_percent(Section318As6038, person, corp, VotingPowerBasis, pct);
    when pct > 50.0;
    then person_directly_controls_corporation_6038(person, corp);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "or more than 50 percent of the total value of shares of all classes of stock, of a corporation.")
rule S6038eControlValue strict {
    for person: Person;
    for corp: Person;
    for pct: Decimal;
    when constructive_interest_percent(Section318As6038, person, corp, StockValueBasis, pct);
    when pct > 50.0;
    then person_directly_controls_corporation_6038(person, corp);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "A person is in control of a corporation if such person owns stock possessing more than 50 percent")
rule S6038eDirectControlIsControl strict {
    for person: Person;
    for corp: Person;
    when person_directly_controls_corporation_6038(person, corp);
    then person_controls_corporation_6038(person, corp);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "If a person is in control (within the meaning of the preceding sentence) of a corporation which in turn owns more than 50 percent of the total combined voting power of all classes of stock entitled to vote of another corporation,")
rule S6038eControlChainVoting defeasible {
    for person: Person;
    for mid: Person;
    for corp: Person;
    for pct: Decimal;
    when person_directly_controls_corporation_6038(person, mid);
    when voting_power_percent_of_foreign_corporation(mid, corp, pct);
    when pct > 50.0;
    then person_controls_corporation_6038(person, corp);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "or owns more than 50 percent of the total value of the shares of all classes of stock of another corporation, then such person shall be treated as in control of such other corporation.")
rule S6038eControlChainValue defeasible {
    for person: Person;
    for mid: Person;
    for corp: Person;
    for pct: Decimal;
    when person_directly_controls_corporation_6038(person, mid);
    when value_percent_of_foreign_corporation(mid, corp, pct);
    when pct > 50.0;
    then person_controls_corporation_6038(person, corp);
}

relation person_controls_partnership_6038(person: Person, partnership: Person) kind institutional {
    label en unofficial "section 6038(e)(3)(A): the person owns directly or indirectly more than a 50 percent interest in the partnership";
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "A person is in control of a partnership if such person owns directly or indirectly more than a 50 percent interest in such partnership.")
rule S6038eControlPartnershipCapital strict {
    for person: Person;
    for partnership: Person;
    for pct: Decimal;
    when constructive_interest_percent(Section267cFamilyRules, person, partnership, CapitalInterestBasis, pct);
    when pct > 50.0;
    then person_controls_partnership_6038(person, partnership);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "an interest equal to 50 percent of the capital interest, or 50 percent of the profits interest, in such partnership, or")
rule S6038eControlPartnershipProfits strict {
    for person: Person;
    for partnership: Person;
    for pct: Decimal;
    when constructive_interest_percent(Section267cFamilyRules, person, partnership, ProfitsInterestBasis, pct);
    when pct > 50.0;
    then person_controls_partnership_6038(person, partnership);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "to the extent provided in regulations, an interest to which 50 percent of the deductions or losses of such partnership are allocated.")
rule S6038eControlPartnershipDeductionsLosses strict {
    for person: Person;
    for partnership: Person;
    for pct: Decimal;
    when deductions_losses_interest_percent_by_regulation(person, partnership, pct);
    when pct > 50.0;
    then person_controls_partnership_6038(person, partnership);
}

relation entity_regularly_computes_income_on_annual_period_ending(e: Person, d: Date) kind empirical {
    label en unofficial "the annual period on the basis of which the entity regularly computes its income in keeping its books ends on this date";
}

relation specified_foreign_business_entity_898(e: Person) kind institutional {
    label en unofficial "the entity is a specified foreign business entity (section 898; pending: international)";
}

relation entity_taxable_year_ends(e: Person, d: Date) kind empirical {
    label en unofficial "the taxable year of the entity ends on this date";
}

relation annual_accounting_period_ends(e: Person, d: Date) kind institutional {
    label en unofficial "section 6038(e)(4): the end date of the entity's annual accounting period";
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "The annual accounting period of a foreign business entity is the annual period on the basis of which such foreign business entity regularly computes its income in keeping its books.")
rule S6038eAnnualAccountingPeriodBooks defeasible {
    for e: Person;
    for d: Date;
    when entity_regularly_computes_income_on_annual_period_ending(e, d);
    when not_known(specified_foreign_business_entity_898(e));
    then annual_accounting_period_ends(e, d);
}

@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "In the case of a specified foreign business entity (as defined in section 898), the taxable year of such foreign business entity shall be treated as its annual accounting period.")
rule S6038eAnnualAccountingPeriodSpecifiedEntity strict {
    for e: Person;
    for d: Date;
    when specified_foreign_business_entity_898(e);
    when entity_taxable_year_ends(e, d);
    then annual_accounting_period_ends(e, d);
}

relation accounting_period_within_taxable_year(e: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6038(a)(2): the entity's annual accounting period ends with or within the United States person's taxable year";
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "The information required under paragraph (1) shall be furnished for the annual accounting period of the foreign business entity ending with or within the United States person's taxable year.")
rule S6038aAccountingPeriodEndingWithinYear defeasible {
    for e: Person;
    for y: TaxableYear;
    for d: Date;
    for s: Date;
    for x: Date;
    when annual_accounting_period_ends(e, d);
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, x);
    when s <= d;
    when d <= x;
    then accounting_period_within_taxable_year(e, y);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "with respect to any foreign business entity which such person controls")
rule S6038ControlDerivesControlsForeignBusinessEntityCorp defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when person_controls_corporation_6038(person, obligor);
    when foreign_corporation_6038(obligor);
    when accounting_period_within_taxable_year(obligor, y);
    then controls_foreign_business_entity(person, obligor, y);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "with respect to any foreign business entity which such person controls")
rule S6038ControlDerivesControlsForeignBusinessEntityPartnership defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when person_controls_partnership_6038(person, obligor);
    when foreign_partnership_6038(obligor);
    when accounting_period_within_taxable_year(obligor, y);
    then controls_foreign_business_entity(person, obligor, y);
}

relation secretary_prescribed_information_on(person: Person, obligor: Person, d: Date) kind empirical {
    label en unofficial "the date on which the Secretary prescribed the furnishing of the information";
}

relation annual_accounting_period_begins(e: Person, d: Date) kind empirical {
    label en unofficial "the first day of the entity's annual accounting period";
}

relation information_requirement_in_place_6038(person: Person, obligor: Person) kind institutional {
    label en unofficial "section 6038(a)(3): the Secretary prescribed the information on or before the first day of the annual accounting period";
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "No information shall be required to be furnished under this subsection with respect to any foreign business entity for any annual accounting period unless the Secretary has prescribed the furnishing of such information on or before the first day of such annual accounting period.")
rule S6038aLimitationPrescribedBeforePeriod strict {
    for person: Person;
    for obligor: Person;
    for p: Date;
    for b: Date;
    when secretary_prescribed_information_on(person, obligor, p);
    when annual_accounting_period_begins(obligor, b);
    when p <= b;
    then information_requirement_in_place_6038(person, obligor);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "the name, the principal place of business, and the nature of business of such entity, and the country under whose laws such entity is incorporated (or organized in the case of a partnership);")
rule S6038aEntityIdentityItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignBusinessEntityInformation6038);
    when information_requirement_in_place_6038(payer, payee);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_NameAndPrincipalPlaceAndNatureOfBusiness);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_CountryOfIncorporationOrOrganization);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "in the case of a foreign corporation, its post-1986 undistributed earnings (as defined in section 902(c));")
rule S6038aPost1986EarningsItem defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignBusinessEntityInformation6038);
    when information_requirement_in_place_6038(payer, payee);
    when foreign_corporation_6038(payee);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_Post1986UndistributedEarnings);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "a balance sheet for such entity listing assets, liabilities, and capital;")
rule S6038aBalanceSheetItem defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignBusinessEntityInformation6038);
    when information_requirement_in_place_6038(payer, payee);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_BalanceSheetAssetsLiabilitiesCapital);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "transactions between such entity and—")
rule S6038aTransactionItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignBusinessEntityInformation6038);
    when information_requirement_in_place_6038(payer, payee);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_TransactionsWithThePerson);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_TransactionsWithControlledCorporationsAndPartnerships);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_TransactionsWithTenPercentUnitedStatesOwners);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "in the case of a foreign corporation, a description of the various classes of stock outstanding, and a list showing the name and address of, and number of shares held by, each United States person who is a shareholder of record owning at any time during the annual accounting period 5 percent or more in value of any class of stock outstanding of such foreign corporation, and")
rule S6038aShareholderListItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignBusinessEntityInformation6038);
    when information_requirement_in_place_6038(payer, payee);
    when foreign_corporation_6038(payee);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_ClassesOfStockOutstanding);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_ListOfUnitedStatesShareholdersOfRecordAtFivePercent);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "information comparable to the information described in clause (i) in the case of a foreign partnership.")
rule S6038aPartnershipComparableItems defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignBusinessEntityInformation6038);
    when information_requirement_in_place_6038(payer, payee);
    when foreign_partnership_6038(payee);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_ComparablePartnershipInformation);
}

@source(IRC_S6038_A, relation = formalizes, coverage = partial, quote = "The Secretary may also require the furnishing of any other information which is similar or related in nature to that specified in the preceding sentence or which the Secretary determines to be appropriate to carry out the provisions of this title.")
rule S6038aOtherInformationItem defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ForeignBusinessEntityInformation6038);
    when information_requirement_in_place_6038(payer, payee);
    then required_return_item(payer, y, ForeignBusinessEntityInformation6038, I6038_OtherSimilarOrRelatedInformation);
}

relation us_shareholder_of_cfc_subpart_f(person: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign corporation is treated as a controlled foreign corporation and the person is treated as a United States shareholder for subpart F purposes";
}

relation secretary_exercises_cfc_shareholder_information_required_6038a4(secretary: Organ, person: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary requires the CFC shareholder to furnish the information (the exercise)";
}

relation cfc_shareholder_information_required_6038a4_in_effect(person: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "the requirement is in force (effect)";
}

relation cfc_shareholder_information_required_6038a4(person: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the requirement power (E-0134)";
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "the Secretary may require any United States person treated as a United States shareholder of such corporation for any purpose under subpart F to furnish the information required under paragraph (1).")
rule S6038CfcShareholderInformationRequired6038a4PowerTwin strict {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when us_shareholder_of_cfc_subpart_f(person, obligor, y);
    when secretary_exercises_cfc_shareholder_information_required_6038a4(us.irc.core::Secretary, person, obligor, y);
    then cfc_shareholder_information_required_6038a4(person, obligor, y);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "the Secretary may require any United States person treated as a United States shareholder of such corporation for any purpose under subpart F to furnish the information required under paragraph (1).")
rule S6038CfcShareholderInformationRequired6038a4Power defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when us_shareholder_of_cfc_subpart_f(person, obligor, y);
    then power SecretaryRequiresCfcShareholderInformation {
        holder us.irc.core::Secretary; over person;
        exercise secretary_exercises_cfc_shareholder_information_required_6038a4(us.irc.core::Secretary, person, obligor, y);
        valid_when us_shareholder_of_cfc_subpart_f(person, obligor, y);
        effect create(cfc_shareholder_information_required_6038a4_in_effect(person, obligor, y));
        window [-infinity, infinity];
    };
}

relation cfc_shareholder_furnished_information(person: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the shareholder furnished the information";
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "the Secretary may require any United States person treated as a United States shareholder of such corporation for any purpose under subpart F to furnish the information required under paragraph (1).")
rule S6038a4CfcShareholderDuty defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when cfc_shareholder_information_required_6038a4(person, obligor, y);
    then duty Furnish6038InformationAsCfcShareholder {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition cfc_shareholder_furnished_information(person, obligor, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(person, obligor, y, ForeignBusinessEntityInformation6038);
}

relation partnership_controlled_by_us_persons_at_ten_percent_but_not_one(obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign partnership is controlled by United States persons holding at least 10-percent interests (but not by any one United States person)";
}

relation us_person_holds_ten_percent_interest_in_partnership(person: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the United States person holds a 10-percent interest in the foreign partnership";
}

relation secretary_exercises_ten_percent_partner_information_required_6038a5(secretary: Organ, person: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary requires the 10-percent partner to furnish information (the exercise)";
}

relation ten_percent_partner_information_required_6038a5_in_effect(person: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "the requirement is in force (effect)";
}

relation ten_percent_partner_information_required_6038a5(person: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the requirement power (E-0134)";
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "the Secretary may require each United States person who holds a 10-percent interest in such partnership to furnish information relating to such partnership")
rule S6038TenPercentPartnerInformationRequired6038a5PowerTwin strict {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when partnership_controlled_by_us_persons_at_ten_percent_but_not_one(obligor, y);
    when secretary_exercises_ten_percent_partner_information_required_6038a5(us.irc.core::Secretary, person, obligor, y);
    then ten_percent_partner_information_required_6038a5(person, obligor, y);
}

@source(IRC_S6038_A, relation = formalizes, coverage = exact, quote = "the Secretary may require each United States person who holds a 10-percent interest in such partnership to furnish information relating to such partnership")
rule S6038TenPercentPartnerInformationRequired6038a5Power defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    when us_person_holds_ten_percent_interest_in_partnership(person, obligor, y);
    then power SecretaryRequiresTenPercentPartnerInformation {
        holder us.irc.core::Secretary; over person;
        exercise secretary_exercises_ten_percent_partner_information_required_6038a5(us.irc.core::Secretary, person, obligor, y);
        valid_when partnership_controlled_by_us_persons_at_ten_percent_but_not_one(obligor, y);
        effect create(ten_percent_partner_information_required_6038a5_in_effect(person, obligor, y));
        window [-infinity, infinity];
    };
}

relation two_or_more_us_persons_required_same_entity_period(obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "two or more United States persons would be required to furnish information with respect to the same foreign business entity for the same period";
}

relation secretary_exercises_information_required_from_one_person_only_6038d(secretary: Organ, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary provides that information is required from one person only (the exercise)";
}

relation information_required_from_one_person_only_6038d_in_effect(obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "the single-person rule is in force (effect)";
}

relation information_required_from_one_person_only_6038d(obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "twin of the single-person power (E-0134)";
}

@source(IRC_S6038_D, relation = formalizes, coverage = exact, quote = "the Secretary may by regulations provide that such information shall be required only from one person.")
rule S6038InformationRequiredFromOnePersonOnly6038dPowerTwin strict {
    for obligor: Person;
    for y: TaxableYear;
    when two_or_more_us_persons_required_same_entity_period(obligor, y);
    when secretary_exercises_information_required_from_one_person_only_6038d(us.irc.core::Secretary, obligor, y);
    then information_required_from_one_person_only_6038d(obligor, y);
}

@source(IRC_S6038_D, relation = formalizes, coverage = exact, quote = "the Secretary may by regulations provide that such information shall be required only from one person.")
rule S6038InformationRequiredFromOnePersonOnly6038dPower defeasible {
    for obligor: Person;
    for y: TaxableYear;
    when two_or_more_us_persons_required_same_entity_period(obligor, y);
    then power SecretaryLimitsInformationToOnePerson {
        holder us.irc.core::Secretary; over obligor;
        exercise secretary_exercises_information_required_from_one_person_only_6038d(us.irc.core::Secretary, obligor, y);
        valid_when two_or_more_us_persons_required_same_entity_period(obligor, y);
        effect create(information_required_from_one_person_only_6038d_in_effect(obligor, y));
        window [-infinity, infinity];
    };
}

// ============================================================================
// §6038(c) — reduction of foreign tax credit
// ============================================================================

pub enum ForeignTaxReductionBase {
    ForeignTaxCreditSection901;
    DeemedPaidTaxSection960;
}

relation foreign_taxes_subject_to_6038c_reduction(person: Person, obligor: Person, y: TaxableYear, base: ForeignTaxReductionBase, taxes: Money) kind empirical {
    label en unofficial "the foreign taxes paid or deemed paid (excluding those deemed paid under section 904(c); for the section 901 base excluding taxes reduced under the 960 base) subject to the reduction";
}

relation three_month_periods_of_continuing_failure(person: Person, obligor: Person, y: TaxableYear, k: Integer) kind empirical {
    label en unofficial "the number of 3-month periods (or fractions) during which the failure continues after the 90 days following the Secretary's notice; 0 if the failure does not continue 90 days after notice";
}

relation entity_income_for_accounting_period(obligor: Person, y: TaxableYear, income: Money) kind empirical {
    label en unofficial "the income of the foreign business entity for its annual accounting period with respect to which the failure occurs";
}

relation section_6038b_penalty_for_period(person: Person, obligor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the penalty imposed by subsection (b) with respect to the period (aggregate of the stage-1 dollar_penalty_6038 conclusions; TECH-GAPS G32)";
}

relation reduction_before_cap_6038c(person: Person, obligor: Person, y: TaxableYear, base: ForeignTaxReductionBase, amount: Money) kind institutional {
    label en unofficial "the reduction under paragraph (1) before the (2) limit and the (3) offset";
}

relation reduction_cap_6038c2(person: Person, obligor: Person, y: TaxableYear, cap: Money) kind institutional {
    label en unofficial "section 6038(c)(2): the greater of $10,000 and the income of the foreign business entity";
}

relation reduction_after_cap_6038c(person: Person, obligor: Person, y: TaxableYear, base: ForeignTaxReductionBase, amount: Money) kind institutional {
    label en unofficial "the reduction after the (2) limit";
}

relation foreign_tax_credit_reduction_6038c(person: Person, obligor: Person, y: TaxableYear, base: ForeignTaxReductionBase, amount: Money) kind institutional {
    label en unofficial "the final reduction of foreign taxes under section 6038(c): after the limit and the subsection (b) offset";
}

relation failure_to_furnish_6038_within_time(person: Person, obligor: Person, y: TaxableYear) kind empirical {
    label en unofficial "the United States person fails to furnish the information within the time prescribed under paragraph (2) of subsection (a)";
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "the amount of taxes (other than taxes reduced under subparagraph (B)) paid or deemed paid (other than those deemed paid under section 904(c)) to any foreign country or possession of the United States for the taxable year shall be reduced by 10 percent, and")
rule S6038cReductionForeignTaxCreditSection901 defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for taxes: Money;
    for k: Integer;
    when failure_to_furnish_6038_within_time(person, obligor, y);
    when foreign_taxes_subject_to_6038c_reduction(person, obligor, y, ForeignTaxCreditSection901, taxes);
    when three_month_periods_of_continuing_failure(person, obligor, y, k);
    then reduction_before_cap_6038c(person, obligor, y, ForeignTaxCreditSection901, taxes * 0.10 + taxes * 0.05 * k);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "the amount of taxes paid or deemed paid by each foreign corporation with respect to which such person is required to furnish information during the annual accounting period or periods with respect to which such information is required under paragraph (2) of subsection (a) shall be reduced by 10 percent.")
rule S6038cReductionDeemedPaidTaxSection960 defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for taxes: Money;
    for k: Integer;
    when failure_to_furnish_6038_within_time(person, obligor, y);
    when foreign_taxes_subject_to_6038c_reduction(person, obligor, y, DeemedPaidTaxSection960, taxes);
    when three_month_periods_of_continuing_failure(person, obligor, y, k);
    then reduction_before_cap_6038c(person, obligor, y, DeemedPaidTaxSection960, taxes * 0.10 + taxes * 0.05 * k);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "the income of the foreign business entity for its annual accounting period with respect to which the failure occurs.")
rule S6038c2CapIncomeGreater defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for income: Money;
    when failure_to_furnish_6038_within_time(person, obligor, y);
    when entity_income_for_accounting_period(obligor, y, income);
    when income > 10000 USD;
    then reduction_cap_6038c2(person, obligor, y, income);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "$10,000, or")
rule S6038c2CapTenThousandGreater defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for income: Money;
    when failure_to_furnish_6038_within_time(person, obligor, y);
    when entity_income_for_accounting_period(obligor, y, income);
    when income <= 10000 USD;
    then reduction_cap_6038c2(person, obligor, y, 10000 USD);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "The amount of the reduction under paragraph (1) for each failure to furnish information with respect to a foreign business entity required under subsection (a)(1) shall not exceed whichever of the following amounts is the greater:")
rule S6038c2WithinCap defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for base: ForeignTaxReductionBase;
    for amount: Money;
    for cap: Money;
    when reduction_before_cap_6038c(person, obligor, y, base, amount);
    when reduction_cap_6038c2(person, obligor, y, cap);
    when amount <= cap;
    then reduction_after_cap_6038c(person, obligor, y, base, amount);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "The amount of the reduction under paragraph (1) for each failure to furnish information with respect to a foreign business entity required under subsection (a)(1) shall not exceed whichever of the following amounts is the greater:")
rule S6038c2AtCap defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for base: ForeignTaxReductionBase;
    for amount: Money;
    for cap: Money;
    when reduction_before_cap_6038c(person, obligor, y, base, amount);
    when reduction_cap_6038c2(person, obligor, y, cap);
    when amount > cap;
    then reduction_after_cap_6038c(person, obligor, y, base, cap);
}

relation penalty_6038b_present(person: Person, obligor: Person, y: TaxableYear) kind institutional {
    label en unofficial "a subsection (b) penalty exists for the period";
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "reduced by the amount of the penalty imposed by subsection (b) with respect to such period.")
rule S6038cPenaltyPresent strict {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for penalty: Money;
    when section_6038b_penalty_for_period(person, obligor, y, penalty);
    then penalty_6038b_present(person, obligor, y);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "The amount of the reduction which (but for this paragraph) would be made under paragraph (1) with respect to any annual accounting period shall be reduced by the amount of the penalty imposed by subsection (b) with respect to such period.")
rule S6038c3OffsetByPenalty defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for base: ForeignTaxReductionBase;
    for amount: Money;
    for penalty: Money;
    when reduction_after_cap_6038c(person, obligor, y, base, amount);
    when section_6038b_penalty_for_period(person, obligor, y, penalty);
    when amount > penalty;
    then foreign_tax_credit_reduction_6038c(person, obligor, y, base, amount - penalty);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "The amount of the reduction which (but for this paragraph) would be made under paragraph (1) with respect to any annual accounting period shall be reduced by the amount of the penalty imposed by subsection (b) with respect to such period.")
rule S6038c3OffsetToZero defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for base: ForeignTaxReductionBase;
    for amount: Money;
    for penalty: Money;
    when reduction_after_cap_6038c(person, obligor, y, base, amount);
    when section_6038b_penalty_for_period(person, obligor, y, penalty);
    when amount <= penalty;
    then foreign_tax_credit_reduction_6038c(person, obligor, y, base, 0 USD);
}

@source(IRC_S6038_C, relation = formalizes, coverage = exact, quote = "The amount of the reduction which (but for this paragraph) would be made under paragraph (1) with respect to any annual accounting period shall be reduced by the amount of the penalty imposed by subsection (b) with respect to such period.")
rule S6038c3NoPenaltyNoOffset defeasible {
    for person: Person;
    for obligor: Person;
    for y: TaxableYear;
    for base: ForeignTaxReductionBase;
    for amount: Money;
    when reduction_after_cap_6038c(person, obligor, y, base, amount);
    when not_known(penalty_6038b_present(person, obligor, y));
    then foreign_tax_credit_reduction_6038c(person, obligor, y, base, amount);
}

// ============================================================================
// §6038A, §6038C — reporting corporations: content, definitions, penalties, enforcement
// ============================================================================

@source(IRC_S6038A_B, relation = formalizes, coverage = exact, quote = "the name, principal place of business, nature of business, and country or countries in which organized or resident, of each person which—")
rule S6038AbRelatedPartyIdentityItems defeasible {
    for c: Person;
    for y: TaxableYear;
    when information_return_required(c, Secretary, y, ReportingCorporationInformation6038A);
    then required_return_item(c, y, ReportingCorporationInformation6038A, I6038A_NameAndPrincipalPlaceAndNatureOfBusinessOfRelatedParty);
    then required_return_item(c, y, ReportingCorporationInformation6038A, I6038A_CountriesOrganizedOrResident);
    then required_return_item(c, y, ReportingCorporationInformation6038A, I6038A_MannerInWhichRelated);
}

@source(IRC_S6038A_B, relation = formalizes, coverage = exact, quote = "transactions between the reporting corporation and each foreign person which is a related party to the reporting corporation.")
rule S6038AbForeignRelatedPartyTransactionItems defeasible {
    for c: Person;
    for y: TaxableYear;
    when information_return_required(c, Secretary, y, ReportingCorporationInformation6038A);
    then required_return_item(c, y, ReportingCorporationInformation6038A, I6038A_TransactionsWithEachForeignRelatedParty);
}

relation applicable_taxpayer_6038a(c: Person, y: TaxableYear) kind institutional {
    label en unofficial "the reporting corporation is an applicable taxpayer (section 59A; pending: international)";
}

@source(IRC_S6038A_B, relation = formalizes, coverage = partial, quote = "such information as the Secretary determines necessary to determine the base erosion minimum tax amount, base erosion payments, and base erosion tax benefits of the taxpayer for purposes of section 59A for the taxable year, and")
rule S6038AbBaseErosionItems defeasible {
    for c: Person;
    for y: TaxableYear;
    when information_return_required(c, Secretary, y, ReportingCorporationInformation6038A);
    when applicable_taxpayer_6038a(c, y);
    then required_return_item(c, y, ReportingCorporationInformation6038A, I6038A_InformationForBaseErosionMinimumTaxAmount);
    then required_return_item(c, y, ReportingCorporationInformation6038A, I6038A_InformationForBaseErosionPaymentsAndTaxBenefits);
    then required_return_item(c, y, ReportingCorporationInformation6038A, I6038A_OtherInformationNecessaryForSection59A);
}

relation foreign_shareholder_voting_percent_6038a(c: Person, y: TaxableYear, holder: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of total voting power of all classes of stock entitled to vote owned by this one foreign person at any time during the year (direct ownership; constructive ownership of the holder is added by constructive_interest_percent, module 19)";
}

relation foreign_shareholder_value_percent_6038a(c: Person, y: TaxableYear, holder: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the total value of all classes of stock owned by this one foreign person at any time during the year";
}

relation foreign_shareholder_25_percent(c: Person, y: TaxableYear, holder: Person) kind institutional {
    label en unofficial "section 6038A(c)(1): the foreign person owns at least 25 percent of the voting power or of the value of the corporation";
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "the total voting power of all classes of stock of such corporation entitled to vote, or")
rule S6038AcVotingPower25 strict {
    for c: Person;
    for y: TaxableYear;
    for holder: Person;
    for pct: Decimal;
    when foreign_shareholder_voting_percent_6038a(c, y, holder, pct);
    when pct >= 25.0;
    then foreign_shareholder_25_percent(c, y, holder);
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "the total value of all classes of stock of such corporation,")
rule S6038AcValue25 strict {
    for c: Person;
    for y: TaxableYear;
    for holder: Person;
    for pct: Decimal;
    when foreign_shareholder_value_percent_6038a(c, y, holder, pct);
    when pct >= 25.0;
    then foreign_shareholder_25_percent(c, y, holder);
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "A corporation is 25-percent foreign-owned if at least 25 percent of—")
rule S6038AcTwentyFivePercentForeignOwned strict {
    for c: Corporation;
    for y: TaxableYear;
    for holder: Person;
    when foreign_shareholder_25_percent(c, y, holder);
    then is_25_percent_foreign_owned(c, y);
}

relation related_under_267b_or_707b1(a: Person, b: Person) kind institutional {
    label en unofficial "the persons are related within the meaning of section 267(b) or 707(b)(1) (pending: accounting/partnerships)";
}

relation related_under_482(a: Person, b: Person) kind institutional {
    label en unofficial "the persons are related within the meaning of section 482 (pending: international)";
}

relation related_party_of_reporting_corporation(c: Person, p: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6038A(c)(2): the person is a related party of the reporting corporation";
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "any 25-percent foreign shareholder of the reporting corporation,")
rule S6038AcRelatedPartyShareholder strict {
    for c: Person;
    for p: Person;
    for y: TaxableYear;
    when foreign_shareholder_25_percent(c, y, p);
    then related_party_of_reporting_corporation(c, p, y);
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "any person who is related (within the meaning of section 267(b) or 707(b)(1)) to the reporting corporation or to a 25-percent foreign shareholder of the reporting corporation, and")
rule S6038AcRelatedPartyByRelation defeasible {
    for c: Corporation;
    for p: Person;
    for y: TaxableYear;
    when related_under_267b_or_707b1(p, c);
    when is_25_percent_foreign_owned(c, y);
    then related_party_of_reporting_corporation(c, p, y);
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "any other person who is related (within the meaning of section 482) to the reporting corporation.")
rule S6038AcRelatedPartyBy482 defeasible {
    for c: Corporation;
    for p: Person;
    for y: TaxableYear;
    when related_under_482(p, c);
    when is_25_percent_foreign_owned(c, y);
    then related_party_of_reporting_corporation(c, p, y);
}

relation person_not_united_states_person(p: Person) kind institutional {
    label en unofficial "the person is not a United States person within section 7701(a)(30) (pending: definitions)";
}

relation possession_citizen_nonresident(p: Person) kind empirical {
    label en unofficial "an individual who is a citizen of a possession of the United States (but not otherwise a citizen of the United States) and is not a resident of the United States";
}

relation foreign_person_6038a(p: Person) kind institutional {
    label en unofficial "section 6038A(c)(3): any person who is not a United States person, except that a nonresident possession citizen is not treated as a United States person";
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "The term \"foreign person\" means any person who is not a United States person.")
rule S6038AcForeignPerson strict {
    for p: Person;
    when person_not_united_states_person(p);
    then foreign_person_6038a(p);
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "except that any individual who is a citizen of any possession of the United States (but not otherwise a citizen of the United States) and who is not a resident of the United States shall not be treated as a United States person.")
rule S6038AcForeignPersonPossessionCitizen strict {
    for p: Person;
    when possession_citizen_nonresident(p);
    then foreign_person_6038a(p);
}

pub enum RecordKind6038A {
    BookRecord;
    PaperRecord;
    OtherDataRecord;
}

relation record_of_kind(item: us.irc.core::Asset, kind: RecordKind6038A) kind empirical {
    label en unofficial "the item is a book, paper, or other data";
}

relation record_for_6038a(item: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6038A(c)(4): the item is a record (books, papers, or other data)";
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "The term \"records\" includes any books, papers, or other data.")
rule S6038AcRecordsBookRecord strict {
    for item: us.irc.core::Asset;
    when record_of_kind(item, BookRecord);
    then record_for_6038a(item);
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "The term \"records\" includes any books, papers, or other data.")
rule S6038AcRecordsPaperRecord strict {
    for item: us.irc.core::Asset;
    when record_of_kind(item, PaperRecord);
    then record_for_6038a(item);
}

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "The term \"records\" includes any books, papers, or other data.")
rule S6038AcRecordsOtherDataRecord strict {
    for item: us.irc.core::Asset;
    when record_of_kind(item, OtherDataRecord);
    then record_for_6038a(item);
}

relation failure_to_comply_6038a_or_c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the reporting corporation fails to furnish within the time prescribed any information described in subsection (b), or fails to maintain (or cause another to maintain) the records required by subsection (a)";
}

relation failure_continues_30_day_periods_after_90(c: Person, y: TaxableYear, k: Integer) kind empirical {
    label en unofficial "the number of 30-day periods (or fractions) the failure continues after the expiration of the 90 days following the Secretary's mailed notice (TECH-GAPS G2409)";
}

relation penalty_6038a_d1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6038A(d)(1): the $25,000 penalty for each taxable year with respect to which the failure occurs";
}

relation penalty_6038a_d2(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6038A(d)(2): $25,000 for each 30-day period (or fraction) after the 90-day period";
}

@source(IRC_S6038A_D, relation = formalizes, coverage = exact, quote = "such corporation shall pay a penalty of $25,000 for each taxable year with respect to which such failure occurs.")
rule S6038AdInitialPenalty defeasible {
    for c: Person;
    for y: TaxableYear;
    when failure_to_comply_6038a_or_c(c, y);
    then penalty_6038a_d1(c, y, 25000 USD);
}

@source(IRC_S6038A_D, relation = formalizes, coverage = exact, quote = "such corporation shall pay a penalty (in addition to the amount required under paragraph (1)) of $25,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period.")
rule S6038AdContinuationPenalty defeasible {
    for c: Person;
    for y: TaxableYear;
    for k: Integer;
    when failure_to_comply_6038a_or_c(c, y);
    when failure_continues_30_day_periods_after_90(c, y, k);
    then penalty_6038a_d2(c, y, 25000 USD * k);
}

relation prescribed_time_6038a(c: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the time prescribed by regulations to furnish the information or maintain the records";
}

relation reasonable_cause_last_day_6038a(c: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the last day on which, as shown to the satisfaction of the Secretary, reasonable cause existed for the failure (DECISION-0194: committed to the Secretary)";
}

relation effective_prescribed_time_6038a(c: Person, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "section 6038A(d)(3): the prescribed time (and the start of the 90-day notice period) treated as not earlier than the last day of reasonable cause";
}

@source(IRC_S6038A_D, relation = formalizes, coverage = exact, quote = "shall be treated as not earlier than the last day on which (as shown to the satisfaction of the Secretary) reasonable cause existed for failure to furnish the information or maintain the records.")
rule S6038AdEffectiveTimePrescribedLater defeasible {
    for c: Person;
    for y: TaxableYear;
    for p: Date;
    for r: Date;
    when prescribed_time_6038a(c, y, p);
    when reasonable_cause_last_day_6038a(c, y, r);
    when r > p;
    then effective_prescribed_time_6038a(c, y, r);
}

@source(IRC_S6038A_D, relation = formalizes, coverage = exact, quote = "shall be treated as not earlier than the last day on which (as shown to the satisfaction of the Secretary) reasonable cause existed for failure to furnish the information or maintain the records.")
rule S6038AdEffectiveTimePrescribedStands defeasible {
    for c: Person;
    for y: TaxableYear;
    for p: Date;
    for r: Date;
    when prescribed_time_6038a(c, y, p);
    when reasonable_cause_last_day_6038a(c, y, r);
    when r <= p;
    then effective_prescribed_time_6038a(c, y, p);
}

@source(IRC_S6038A_D, relation = formalizes, coverage = exact, quote = "the time prescribed by regulations to furnish information or maintain records (and the beginning of the 90-day period after notice by the Secretary) shall be treated as not earlier than")
rule S6038AdEffectiveTimeNoReasonableCause defeasible {
    for c: Person;
    for y: TaxableYear;
    for p: Date;
    when prescribed_time_6038a(c, y, p);
    when not_known(reasonable_cause_shown_6038a(c, y));
    then effective_prescribed_time_6038a(c, y, p);
}

relation reasonable_cause_shown_6038a(c: Person, y: TaxableYear) kind institutional {
    label en unofficial "a reasonable-cause last day has been shown";
}

@source(IRC_S6038A_D, relation = formalizes, coverage = exact, quote = "as shown to the satisfaction of the Secretary")
rule S6038AdReasonableCauseShown strict {
    for c: Person;
    for y: TaxableYear;
    for r: Date;
    when reasonable_cause_last_day_6038a(c, y, r);
    then reasonable_cause_shown_6038a(c, y);
}

// ============================================================================
// §6038A(e), §6038C — limited agent, summons, secretarial discretion, judicial review
// ============================================================================

relation reporting_corporation_6038a_or_c(c: Person) kind institutional {
    label en unofficial "the corporation is a reporting corporation under section 6038A (domestic, 25-percent foreign-owned) or section 6038C (foreign corporation engaged in a United States trade or business)";
}

relation domestic_25_percent_foreign_owned_reporting(c: Person, y: TaxableYear) kind institutional {
    label en unofficial "the corporation is a section 6038A reporting corporation for the year";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "The rules of paragraph (3) shall apply to any transaction between the reporting corporation and any related party who is a foreign person")
rule S6038AeReportingCorporationA strict {
    for c: Corporation;
    for y: TaxableYear;
    when is_domestic_corporation(c);
    when is_25_percent_foreign_owned(c, y);
    then reporting_corporation_6038a_or_c(c);
}

relation transaction_with_foreign_related_party(c: Person, related: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "a transaction between the reporting corporation and a related party who is a foreign person";
}

relation related_party_authorizes_limited_agent(related: Person, c: Person) kind empirical {
    label en unofficial "the related party agrees, in the manner and at the time the Secretary prescribes, to authorize the reporting corporation to act as its limited agent solely for sections 7602, 7603 and 7604";
}

relation secretary_sole_discretion_rules_apply(c: Person, related: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "the rules of paragraph (3) apply to the transaction";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "The rules of paragraph (3) shall apply to any transaction between the reporting corporation and any related party who is a foreign person unless such related party agrees")
rule S6038Ae1NoLimitedAgentRulesApply defeasible {
    for c: Person;
    for related: Person;
    for tx: us.irc.core::Asset;
    when reporting_corporation_6038a_or_c(c);
    when transaction_with_foreign_related_party(c, related, tx);
    when not_known(related_party_authorizes_limited_agent(related, c));
    then secretary_sole_discretion_rules_apply(c, related, tx);
}

relation summons_issued_to_reporting_corporation(c: Person, related: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the Secretary issues a summons to the corporation to produce (directly or as agent for the related party) records or testimony about the transaction";
}

relation summons_not_quashed_or_invalid(c: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the summons is not quashed and not determined invalid in a section 7604(b) proceeding";
}

relation corporation_did_not_substantially_comply_and_notified(c: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the corporation does not substantially comply in a timely manner and the Secretary sent certified or registered mail notice of that";
}

relation secretary_applies_discretion_rules(secretary: Organ, c: Person, related: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the Secretary applies the rules of paragraph (3) to the transaction (the exercise)";
}

relation summons_noncompliance_conditions_met(c: Person, related: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "the conditions of section 6038A(e)(2)(A)-(C) hold for the transaction";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "the Secretary issues a summons to such corporation to produce (either directly or as agent for such related party) any records or testimony,")
rule S6038Ae2ConditionsMet strict {
    for c: Person;
    for related: Person;
    for tx: us.irc.core::Asset;
    when summons_issued_to_reporting_corporation(c, related, tx);
    when summons_not_quashed_or_invalid(c, tx);
    when corporation_did_not_substantially_comply_and_notified(c, tx);
    then summons_noncompliance_conditions_met(c, related, tx);
}

relation secretary_discretion_rules_in_force(c: Person, related: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "effect of the power: the paragraph (3) rules apply to the transaction";
}

relation secretary_exercises_sole_discretion_rules_applied_6038ae2(secretary: Organ, c: Person, related: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the Secretary applies the paragraph (3) rules to the transaction (the exercise)";
}

relation sole_discretion_rules_applied_6038ae2_in_effect(c: Person, related: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "the paragraph (3) rules apply (effect)";
}

relation sole_discretion_rules_applied_6038ae2(c: Person, related: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "twin of the discretion power (E-0134)";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "the Secretary may apply the rules of paragraph (3) with respect to such transaction (whether or not the Secretary begins a proceeding to enforce such summons).")
rule S6038ASoleDiscretionRulesApplied6038ae2PowerTwin strict {
    for c: Person;
    for related: Person;
    for tx: us.irc.core::Asset;
    when summons_noncompliance_conditions_met(c, related, tx);
    when secretary_exercises_sole_discretion_rules_applied_6038ae2(us.irc.core::Secretary, c, related, tx);
    then sole_discretion_rules_applied_6038ae2(c, related, tx);
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "the Secretary may apply the rules of paragraph (3) with respect to such transaction (whether or not the Secretary begins a proceeding to enforce such summons).")
rule S6038ASoleDiscretionRulesApplied6038ae2Power defeasible {
    for c: Person;
    for related: Person;
    for tx: us.irc.core::Asset;
    when summons_issued_to_reporting_corporation(c, related, tx);
    then power SecretaryAppliesSoleDiscretionRules {
        holder us.irc.core::Secretary; over c;
        exercise secretary_exercises_sole_discretion_rules_applied_6038ae2(us.irc.core::Secretary, c, related, tx);
        valid_when summons_noncompliance_conditions_met(c, related, tx);
        effect create(sole_discretion_rules_applied_6038ae2_in_effect(c, related, tx));
        window [-infinity, infinity];
    };
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "the Secretary may apply the rules of paragraph (3) with respect to such transaction")
rule S6038Ae2TwinFeedsRules strict {
    for c: Person;
    for related: Person;
    for tx: us.irc.core::Asset;
    when sole_discretion_rules_applied_6038ae2(c, related, tx);
    then secretary_sole_discretion_rules_apply(c, related, tx);
}

relation deduction_or_cost_determined_by_secretary(c: Person, related: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6038A(e)(3): the deduction and the property cost for the transaction are the amounts the Secretary determines in the Secretary's sole discretion";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "shall be the amount determined by the Secretary in the Secretary's sole discretion from the Secretary's own knowledge or from such information as the Secretary may obtain through testimony or otherwise.")
rule S6038Ae3DeterminedBySecretary defeasible {
    for c: Person;
    for related: Person;
    for tx: us.irc.core::Asset;
    when secretary_sole_discretion_rules_apply(c, related, tx);
    then deduction_or_cost_determined_by_secretary(c, related, tx);
}

relation summons_issued_on(c: Person, tx: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the date the summons was issued";
}

relation corporation_begins_quash_proceeding_on(c: Person, tx: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the reporting corporation begins a proceeding to quash the summons on this date (the exercise)";
}

relation quash_begun_within_90_days(c: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "the proceeding to quash is begun not later than the 90th day after the summons was issued";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "shall have the right to begin a proceeding to quash such summons not later than the 90th day after such summons was issued.")
rule S6038Ae4AWithin90Days strict {
    for c: Person;
    for tx: us.irc.core::Asset;
    for issued: Date;
    for begun: Date;
    when summons_issued_on(c, tx, issued);
    when corporation_begins_quash_proceeding_on(c, tx, begun);
    when begun <= add_calendar_period(issued, 90 calendar_day);
    then quash_begun_within_90_days(c, tx);
}

relation quash_proceeding_pending(c: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "effect: a proceeding to quash the summons is pending";
}

relation quash_right_available(c: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "positive anchor: the corporation holds a section 6038A(e)(2)(A) summons for the transaction";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "any reporting corporation to which the Secretary issues a summons referred to in paragraph (2)(A) shall have the right to begin a proceeding to quash such summons not later than the 90th day after such summons was issued.")
rule S6038Ae4AQuashRightPower defeasible {
    for c: Person;
    for tx: us.irc.core::Asset;
    for begun: Date;
    when quash_right_available(c, tx);
    when corporation_begins_quash_proceeding_on(c, tx, begun);
    then power BeginProceedingToQuashSummons {
        holder c; over tx;
        exercise corporation_begins_quash_proceeding_on(c, tx, begun);
        valid_when quash_begun_within_90_days(c, tx);
        effect create(quash_proceeding_pending(c, tx));
        window [-infinity, infinity];
    };
}

relation notice_of_noncompliance_mailed_on(c: Person, tx: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the date the notice referred to in paragraph (2)(C) was mailed";
}

relation corporation_begins_review_proceeding_on(c: Person, tx: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the corporation begins a proceeding to review the Secretary's noncompliance determination on this date (the exercise)";
}

relation review_begun_within_90_days(c: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "the review proceeding is begun not later than the 90th day after the notice was mailed";
}

relation review_proceeding_pending(c: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "effect: a review proceeding is pending";
}

relation review_right_available(c: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "positive anchor: the corporation has been notified of the Secretary's noncompliance determination";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "not later than the 90th day after the day on which the notice referred to in paragraph (2)(C) was mailed.")
rule S6038Ae4BWithin90Days strict {
    for c: Person;
    for tx: us.irc.core::Asset;
    for mailed: Date;
    for begun: Date;
    when notice_of_noncompliance_mailed_on(c, tx, mailed);
    when corporation_begins_review_proceeding_on(c, tx, begun);
    when begun <= add_calendar_period(mailed, 90 calendar_day);
    then review_begun_within_90_days(c, tx);
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "shall have the right to begin a proceeding to review such determination not later than the 90th day after the day on which the notice referred to in paragraph (2)(C) was mailed.")
rule S6038Ae4BReviewRightPower defeasible {
    for c: Person;
    for tx: us.irc.core::Asset;
    for begun: Date;
    when review_right_available(c, tx);
    when corporation_begins_review_proceeding_on(c, tx, begun);
    then power BeginProceedingToReviewNoncomplianceDetermination {
        holder c; over tx;
        exercise corporation_begins_review_proceeding_on(c, tx, begun);
        valid_when review_begun_within_90_days(c, tx);
        effect create(review_proceeding_pending(c, tx));
        window [-infinity, infinity];
    };
}

relation determination_binding_unreviewable(c: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "the Secretary's determination is binding and not reviewable by any court: no review proceeding begun by the 90th day";
}

relation review_deadline_passed_without_proceeding(c: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the 90th day passed and no review proceeding was begun";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "If such a proceeding is not begun on or before such 90th day, such determination by the Secretary shall be binding and shall not be reviewed by any court.")
rule S6038Ae4BDeterminationBinding strict {
    for c: Person;
    for tx: us.irc.core::Asset;
    when review_deadline_passed_without_proceeding(c, tx);
    then determination_binding_unreviewable(c, tx);
}

relation proceeding_order_final_appealable(c: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6038A(e)(4)(C): any order or determination in the proceeding is a final order which may be appealed";
}

relation proceeding_in_district_court_of_residence(c: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "a proceeding under (A) or (B) is brought in the United States district court for the district where the person to whom the summons is issued resides or is found";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = exact, quote = "Any order or other determination in such a proceeding shall be treated as a final order which may be appealed.")
rule S6038Ae4CJurisdictionFinalOrder strict {
    for c: Person;
    for tx: us.irc.core::Asset;
    when proceeding_in_district_court_of_residence(c, tx);
    then proceeding_order_final_appealable(c, tx);
}

relation proceeding_pending_or_on_appeal(c: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the proceeding, or an appeal in it, is pending";
}

relation limitations_suspended_6038ae4d(c: Person, tx: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6038A(e)(4)(D): the running of the section 6501 and 6531 limitation periods for affected taxable years is suspended";
}

@source(IRC_S6038A_E, relation = formalizes, coverage = partial, quote = "the running of any period of limitations under section 6501 (relating to assessment and collection of tax) or under section 6531 (relating to criminal prosecutions) with respect to any affected taxable year shall be suspended for the period during which such proceeding, and appeals therein, are pending.")
rule S6038Ae4DSuspension strict {
    for c: Person;
    for tx: us.irc.core::Asset;
    when proceeding_pending_or_on_appeal(c, tx);
    then limitations_suspended_6038ae4d(c, tx);
}

relation foreign_corporation_engaged_in_us_trade_or_business(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign corporation is engaged in a trade or business within the United States at any time during the taxable year";
}

relation furnished_6038c_information_and_records(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the foreign reporting corporation furnished the information and maintained the records";
}

@source(IRC_S6038C_A, relation = formalizes, coverage = exact, quote = "such corporation shall furnish (at such time and in such manner as the Secretary shall by regulations prescribe) the information described in subsection (b), and")
rule S6038CReportingCorporationDuty defeasible {
    for c: Person;
    for y: TaxableYear;
    when foreign_corporation_engaged_in_us_trade_or_business(c, y);
    then duty FurnishForeignReportingCorporationInformation {
        bearer c;
        beneficiary Secretary;
        goal maintenance {
            condition furnished_6038c_information_and_records(c, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(c, Secretary, y, ForeignReportingCorporationInformation6038C);
    then reporting_corporation_6038a_or_c(c);
}

@source(IRC_S6038C_C, relation = formalizes, coverage = exact, quote = "The provisions of subsection (d) of section 6038A shall apply to—")
rule S6038CFailureToComplyFeedsSection6038APenalties defeasible {
    for c: Person;
    for y: TaxableYear;
    when foreign_corporation_engaged_in_us_trade_or_business(c, y);
    when failure_to_comply_6038c(c, y);
    then failure_to_comply_6038a_or_c(c, y);
}

relation failure_to_comply_6038c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign reporting corporation fails to furnish the (b) information within the time prescribed or to maintain the records required by subsection (a)";
}

@source(IRC_S6038C_B, relation = formalizes, coverage = exact, quote = "the information described in section 6038A(b), and")
rule S6038CbInformationItems defeasible {
    for c: Person;
    for y: TaxableYear;
    when information_return_required(c, Secretary, y, ForeignReportingCorporationInformation6038C);
    then required_return_item(c, y, ForeignReportingCorporationInformation6038C, I6038C_InformationDescribedInSection6038Ab);
    then required_return_item(c, y, ForeignReportingCorporationInformation6038C, I6038C_OtherInformationForItemsNotDirectlyConnectedWithTransactions);
}

// ============================================================================
// §6038B — transfers to foreign corporations and partnerships
// ============================================================================

pub enum ForeignTransferKind {
    ExchangeWithForeignCorporation;
    ContributionToForeignPartnership;
    Section336DistributionToNonUsPerson;
}

relation us_person_transfer_to_foreign_entity(person: Person, tx: us.irc.core::Asset, kind: ForeignTransferKind, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the United States person makes this transfer or distribution on this date (in an exchange described in section 332, 351, 354, 355, 356 or 361; a section 721 or regulation-described contribution; or a section 336 distribution to a non-United States person)";
}

relation transfer_value_fmv(tx: us.irc.core::Asset, fmv: Money) kind empirical {
    label en unofficial "the fair market value of the transferred property at the time of the transfer";
}

relation ten_percent_interest_immediately_after_transfer(person: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the United States person holds (immediately after the transfer) directly or indirectly at least a 10-percent interest (section 6046A(d)) in the partnership";
}

relation twelve_month_aggregate_value_to_partnership(person: Person, tx: us.irc.core::Asset, total: Money) kind empirical {
    label en unofficial "the value of property transferred by the person or any related person to the partnership or a related partnership during the 12-month period ending on the date of the transfer, added to this transfer";
}

relation foreign_transfer_reportable_6038b(person: Person, tx: us.irc.core::Asset, kind: ForeignTransferKind, y: TaxableYear) kind institutional {
    label en unofficial "the transfer is one section 6038B(a) requires information about";
}

@source(IRC_S6038B_A, relation = formalizes, coverage = exact, quote = "a foreign corporation in an exchange described in section 332, 351, 354, 355, 356, or 361, or")
rule S6038BaForeignCorporationExchange defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for y: TaxableYear;
    for d: Date;
    when us_person_transfer_to_foreign_entity(person, tx, ExchangeWithForeignCorporation, y, d);
    then foreign_transfer_reportable_6038b(person, tx, ExchangeWithForeignCorporation, y);
}

@source(IRC_S6038B_A, relation = formalizes, coverage = exact, quote = "makes a distribution described in section 336 to a person who is not a United States person,")
rule S6038BaSection336Distribution defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for y: TaxableYear;
    for d: Date;
    when us_person_transfer_to_foreign_entity(person, tx, Section336DistributionToNonUsPerson, y, d);
    then foreign_transfer_reportable_6038b(person, tx, Section336DistributionToNonUsPerson, y);
}

@source(IRC_S6038B_B, relation = formalizes, coverage = exact, quote = "the United States person holds (immediately after the transfer) directly or indirectly at least a 10-percent interest (as defined in section 6046A(d)) in the partnership, or")
rule S6038BaPartnershipContributionTenPercent defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for y: TaxableYear;
    for d: Date;
    when us_person_transfer_to_foreign_entity(person, tx, ContributionToForeignPartnership, y, d);
    when ten_percent_interest_immediately_after_transfer(person, tx);
    then foreign_transfer_reportable_6038b(person, tx, ContributionToForeignPartnership, y);
}

@source(IRC_S6038B_B, relation = formalizes, coverage = exact, quote = "the value of the property transferred (when added to the value of the property transferred by such person or any related person to such partnership or a related partnership during the 12-month period ending on the date of the transfer) exceeds $100,000.")
rule S6038BaPartnershipContributionOver100000 defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for y: TaxableYear;
    for d: Date;
    for total: Money;
    when us_person_transfer_to_foreign_entity(person, tx, ContributionToForeignPartnership, y, d);
    when twelve_month_aggregate_value_to_partnership(person, tx, total);
    when total > 100000 USD;
    then foreign_transfer_reportable_6038b(person, tx, ContributionToForeignPartnership, y);
}

relation foreign_transfer_information_furnished(person: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "case fact: the United States person furnished the information in the time and manner regulations require";
}

@source(IRC_S6038B_A, relation = formalizes, coverage = exact, quote = "shall furnish to the Secretary, at such time and in such manner as the Secretary shall by regulations prescribe, such information with respect to such exchange or distribution as the Secretary may require in such regulations.")
rule S6038BaInformationDuty defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for kind: ForeignTransferKind;
    for y: TaxableYear;
    when foreign_transfer_reportable_6038b(person, tx, kind, y);
    then duty FurnishForeignTransferInformation {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition foreign_transfer_information_furnished(person, tx);
            window [-infinity, infinity];
        }
    };
    then information_return_required(person, Secretary, y, ForeignTransferReturn6038B);
}

relation adjustment_deemed_contribution_date_specified(tx: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the date the Secretary specified for a contribution deemed made by reason of a section 482 or other adjustment";
}

relation deemed_contribution_treated_made_on(tx: us.irc.core::Asset, d: Date) kind institutional {
    label en unofficial "section 6038B(b)(2): the deemed contribution is treated as made not earlier than the date the Secretary specified";
}

@source(IRC_S6038B_B, relation = formalizes, coverage = exact, quote = "such contribution shall be treated for purposes of this section as having been made not earlier than the date specified by the Secretary.")
rule S6038BbDeemedContributionDate strict {
    for tx: us.irc.core::Asset;
    for d: Date;
    when adjustment_deemed_contribution_date_specified(tx, d);
    then deemed_contribution_treated_made_on(tx, d);
}

relation failure_to_furnish_6038b_information(person: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the United States person fails to furnish the information at the time and in the manner required by regulations";
}

external judgment relation reasonable_cause_not_willful_neglect_6038b(person: Person, tx: us.irc.core::Asset) {
    authority Secretary;
    label en unofficial "the failure is due to reasonable cause and not to willful neglect, as the United States person shows (DECISION-0194: committed to the Secretary)";
}

relation failure_due_to_intentional_disregard_6038b(person: Person, tx: us.irc.core::Asset) kind empirical {
    label en unofficial "the failure with respect to the exchange was due to intentional disregard";
}

relation penalty_before_limit_6038b(person: Person, tx: us.irc.core::Asset, amount: Money) kind institutional {
    label en unofficial "ten percent of the fair market value of the property at the time of the exchange";
}

relation penalty_6038b_c(person: Person, tx: us.irc.core::Asset, amount: Money) kind institutional {
    label en unofficial "section 6038B(c): the penalty after the $100,000 limit (no limit for intentional disregard)";
}

@source(IRC_S6038B_C, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty equal to 10 percent of the fair market value of the property at the time of the exchange")
rule S6038BcPenaltyTenPercent defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for fmv: Money;
    when failure_to_furnish_6038b_information(person, tx);
    when transfer_value_fmv(tx, fmv);
    when not_known(reasonable_cause_not_willful_neglect_6038b(person, tx));
    then penalty_before_limit_6038b(person, tx, fmv * 0.10);
}

@source(IRC_S6038B_C, relation = formalizes, coverage = exact, quote = "The penalty under paragraph (1) with respect to any exchange shall not exceed $100,000 unless the failure with respect to such exchange was due to intentional disregard.")
rule S6038BcPenaltyWithinLimit defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for amount: Money;
    when penalty_before_limit_6038b(person, tx, amount);
    when amount <= 100000 USD;
    then penalty_6038b_c(person, tx, amount);
}

@source(IRC_S6038B_C, relation = formalizes, coverage = exact, quote = "The penalty under paragraph (1) with respect to any exchange shall not exceed $100,000 unless the failure with respect to such exchange was due to intentional disregard.")
rule S6038BcPenaltyOverLimitCapped defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for amount: Money;
    when penalty_before_limit_6038b(person, tx, amount);
    when amount > 100000 USD;
    when not_known(failure_due_to_intentional_disregard_6038b(person, tx));
    then penalty_6038b_c(person, tx, 100000 USD);
}

@source(IRC_S6038B_C, relation = formalizes, coverage = exact, quote = "unless the failure with respect to such exchange was due to intentional disregard.")
rule S6038BcPenaltyIntentionalDisregardUncapped defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for amount: Money;
    when penalty_before_limit_6038b(person, tx, amount);
    when amount > 100000 USD;
    when failure_due_to_intentional_disregard_6038b(person, tx);
    then penalty_6038b_c(person, tx, amount);
}

relation gain_recognized_as_if_sold_6038b(person: Person, tx: us.irc.core::Asset, value: Money) kind institutional {
    label en unofficial "section 6038B(c)(1) parenthetical: for a contribution described in (a)(1)(B), the person recognizes gain as if the contributed property had been sold for its value at the time of the contribution";
}

@source(IRC_S6038B_C, relation = formalizes, coverage = exact, quote = "such person shall recognize gain as if the contributed property had been sold for such value at the time of such contribution")
rule S6038BcGainRecognitionOnPartnershipContribution defeasible {
    for person: Person;
    for tx: us.irc.core::Asset;
    for fmv: Money;
    for y: TaxableYear;
    for d: Date;
    when failure_to_furnish_6038b_information(person, tx);
    when transfer_value_fmv(tx, fmv);
    when us_person_transfer_to_foreign_entity(person, tx, ContributionToForeignPartnership, y, d);
    when not_known(reasonable_cause_not_willful_neglect_6038b(person, tx));
    then gain_recognized_as_if_sold_6038b(person, tx, fmv);
}

// ============================================================================
// §6038D — foreign financial assets
// ============================================================================

pub enum ForeignFinancialAssetKind {
    FinancialAccountAtForeignInstitution;
    StockOrSecurityOfNonUsIssuer;
    InvestmentInstrumentOrContractWithNonUsCounterparty;
    InterestInForeignEntity;
}

relation asset_kind_6038d(asset: us.irc.core::Asset, kind: ForeignFinancialAssetKind) kind empirical {
    label en unofficial "the asset falls in this section 6038D(b) class (accounts are those maintained by a foreign financial institution; the others are not held in an account maintained by a financial institution)";
}

relation specified_foreign_financial_asset(asset: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6038D(b): a specified foreign financial asset";
}

@source(IRC_S6038D_B, relation = formalizes, coverage = exact, quote = "any financial account (as defined in section 1471(d)(2)) maintained by a foreign financial institution (as defined in section 1471(d)(4)), and")
rule S6038DbSpecifiedAsset1 strict {
    for asset: us.irc.core::Asset;
    when asset_kind_6038d(asset, FinancialAccountAtForeignInstitution);
    then specified_foreign_financial_asset(asset);
}

@source(IRC_S6038D_B, relation = formalizes, coverage = exact, quote = "any stock or security issued by a person other than a United States person,")
rule S6038DbSpecifiedAsset2 strict {
    for asset: us.irc.core::Asset;
    when asset_kind_6038d(asset, StockOrSecurityOfNonUsIssuer);
    then specified_foreign_financial_asset(asset);
}

@source(IRC_S6038D_B, relation = formalizes, coverage = exact, quote = "any financial instrument or contract held for investment that has an issuer or counterparty which is other than a United States person, and")
rule S6038DbSpecifiedAsset3 strict {
    for asset: us.irc.core::Asset;
    when asset_kind_6038d(asset, InvestmentInstrumentOrContractWithNonUsCounterparty);
    then specified_foreign_financial_asset(asset);
}

@source(IRC_S6038D_B, relation = formalizes, coverage = exact, quote = "any interest in a foreign entity (as defined in section 1473).")
rule S6038DbSpecifiedAsset4 strict {
    for asset: us.irc.core::Asset;
    when asset_kind_6038d(asset, InterestInForeignEntity);
    then specified_foreign_financial_asset(asset);
}

@source(IRC_S6038D_C, relation = formalizes, coverage = exact, quote = "In the case of any account, the name and address of the financial institution in which such account is maintained and the number of such account.")
rule S6038DcAccountItems defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when information_return_required(ind, Secretary, y, ForeignFinancialAssetInformation6038D);
    then required_return_item(ind, y, ForeignFinancialAssetInformation6038D, I6038D_NameAndAddressOfFinancialInstitutionAndAccountNumber);
    then required_return_item(ind, y, ForeignFinancialAssetInformation6038D, I6038D_NameAndAddressOfIssuerAndClassOrIssue);
    then required_return_item(ind, y, ForeignFinancialAssetInformation6038D, I6038D_IdentifyInstrumentContractOrInterest);
    then required_return_item(ind, y, ForeignFinancialAssetInformation6038D, I6038D_NamesAndAddressesOfIssuersAndCounterparties);
    then required_return_item(ind, y, ForeignFinancialAssetInformation6038D, I6038D_MaximumValueOfAssetDuringYear);
}

relation failure_to_furnish_6038d_information(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual fails to furnish the section 6038D(c) information for the taxable year at the time and in the manner described in subsection (a)";
}

relation failure_continues_30_day_periods_6038d(ind: Individual, y: TaxableYear, k: Integer) kind empirical {
    label en unofficial "the number of 30-day periods (or fractions) the failure continues after the 90 days following the Secretary's mailed notice (TECH-GAPS G2409)";
}

external judgment relation reasonable_cause_not_willful_neglect_6038d(ind: Individual, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the failure is shown to be due to reasonable cause and not due to willful neglect (DECISION-0194); a foreign jurisdiction's penalty for disclosure is not reasonable cause";
}

relation foreign_law_penalty_for_disclosure(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "a foreign jurisdiction would impose a civil or criminal penalty for disclosing the required information";
}

relation reasonable_cause_recognized_6038d(ind: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the reasonable-cause defence holds: the judgment is given and the foreign-law penalty is not the sole ground";
}

relation penalty_6038d_initial(ind: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6038D(d)(1): the $10,000 penalty";
}

relation penalty_6038d_continuation(ind: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 6038D(d)(2): $10,000 for each 30-day period (or fraction), not more than $50,000";
}

@source(IRC_S6038D_G, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed by this section on any failure which is shown to be due to reasonable cause and not due to willful neglect.")
rule S6038DgReasonableCauseRecognized defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when reasonable_cause_not_willful_neglect_6038d(ind, y);
    then reasonable_cause_recognized_6038d(ind, y);
}

@source(IRC_S6038D_D, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $10,000.")
rule S6038DdInitialPenalty defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when failure_to_furnish_6038d_information(ind, y);
    when not_known(reasonable_cause_recognized_6038d(ind, y));
    then penalty_6038d_initial(ind, y, 10000 USD);
}

@source(IRC_S6038D_D, relation = formalizes, coverage = exact, quote = "such individual shall pay a penalty (in addition to the penalties under paragraph (1)) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period.")
rule S6038DdContinuationPenaltyUnderCap defeasible {
    for ind: Individual;
    for y: TaxableYear;
    for k: Integer;
    when failure_to_furnish_6038d_information(ind, y);
    when not_known(reasonable_cause_recognized_6038d(ind, y));
    when failure_continues_30_day_periods_6038d(ind, y, k);
    when k <= 5;
    then penalty_6038d_continuation(ind, y, 10000 USD * k);
}

@source(IRC_S6038D_D, relation = formalizes, coverage = exact, quote = "The penalty imposed under this paragraph with respect to any failure shall not exceed $50,000.")
rule S6038DdContinuationPenaltyAtCap defeasible {
    for ind: Individual;
    for y: TaxableYear;
    for k: Integer;
    when failure_to_furnish_6038d_information(ind, y);
    when not_known(reasonable_cause_recognized_6038d(ind, y));
    when failure_continues_30_day_periods_6038d(ind, y, k);
    when k > 5;
    then penalty_6038d_continuation(ind, y, 50000 USD);
}

relation secretary_determines_interest_in_specified_assets(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary determines that the individual has an interest in one or more specified foreign financial assets";
}

relation individual_provided_sufficient_value_information(ind: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual provides sufficient information to demonstrate the aggregate value of the assets";
}

relation aggregate_value_treated_in_excess_of_threshold_6038d(ind: Individual, y: TaxableYear) kind institutional {
    label en unofficial "section 6038D(e): for assessing the penalties the aggregate value is treated as exceeding $50,000 (or the higher amount the Secretary prescribes)";
}

@source(IRC_S6038D_E, relation = formalizes, coverage = exact, quote = "then the aggregate value of such assets shall be treated as being in excess of $50,000 (or such higher dollar amount as the Secretary prescribes for purposes of subsection (a)) for purposes of assessing the penalties imposed under this section.")
rule S6038DePresumptionOverThreshold defeasible {
    for ind: Individual;
    for y: TaxableYear;
    when secretary_determines_interest_in_specified_assets(ind, y);
    when not_known(individual_provided_sufficient_value_information(ind, y));
    then aggregate_value_treated_in_excess_of_threshold_6038d(ind, y);
}

relation regulation_applies_6038d_to_domestic_entity(ent: Person, y: TaxableYear) kind empirical {
    label en unofficial "to the extent provided in regulations or guidance, this section applies to the domestic entity formed or availed of to hold specified foreign financial assets";
}

relation domestic_entity_treated_as_individual_6038d(ent: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6038D(f): the domestic entity is treated as an individual for the section";
}

@source(IRC_S6038D_F, relation = formalizes, coverage = exact, quote = "the provisions of this section shall apply to any domestic entity which is formed or availed of for purposes of holding, directly or indirectly, specified foreign financial assets, in the same manner as if such entity were an individual.")
rule S6038DfDomesticEntityTreatedAsIndividual strict {
    for ent: Person;
    for y: TaxableYear;
    when regulation_applies_6038d_to_domestic_entity(ent, y);
    then domestic_entity_treated_as_individual_6038d(ent, y);
}

relation foreign_producer_elects_assignment(fp: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign producer elects to make an assignment described in section 5001(c), 5041(c) or 5051(a)";
}

relation foreign_producer_assignment_election(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign producer elects to make an assignment described in section 5001(c), 5041(c) or 5051(a)";
}

@source(IRC_S6038E, relation = formalizes, coverage = exact, quote = "shall provide such information, at such time and in such manner, as the Secretary may prescribe in order to make such assignment, including information about the controlled group structure of such foreign producer.")
rule S6038EAssignmentInformationDuty defeasible {
    for filer: Person;
    for y: TaxableYear;
    when foreign_producer_assignment_election(filer, y);
    then duty ProvideForeignProducerAssignmentInformation {
        bearer filer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(filer, Secretary, y, ForeignProducerAssignmentInformation6038E);
            window [-infinity, infinity];
        }
    };
    then information_return_required(filer, Secretary, y, ForeignProducerAssignmentInformation6038E);
}

@source(IRC_S6038E, relation = formalizes, coverage = partial, quote = "including information about the controlled group structure of such foreign producer.")
rule S6038EInformationItems defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ForeignProducerAssignmentInformation6038E);
    then required_return_item(filer, y, ForeignProducerAssignmentInformation6038E, I6038E_InformationPrescribedToMakeTheAssignment);
    then required_return_item(filer, y, ForeignProducerAssignmentInformation6038E, I6038E_ControlledGroupStructureOfForeignProducer);
}
