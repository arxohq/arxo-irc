// Information reporting -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified): cross-package contracts read their owners.
//
// Each classification below was a local placeholder (`kind institutional`, no derivation, label "pending: <owner>"): a case had
// to assert it as a fact. The owner package now publishes the same concept, so the placeholder is DERIVED from the owner's
// `pub` relation; the old channel stays valid (an institutional relation may still be asserted as a case fact, DECISIONS Д-15/Д-19),
// so existing scenarios are unchanged. Nothing is restated: the owner's relation is the only definition; the consumer adds only
// the argument-type narrowing/identity (the owner takes `Person`, the consumer keeps its own `Corporation`/`Person` types).
//
// JUDGMENT CALLS.
//  - `is_domestic_corporation(c)` reads `definitions::domestic(c)`: the owner's `domestic` covers corporations and partnerships
//    (section 7701(a)(4)); the consumer's argument is typed `Corporation`, so only the corporation limb is reachable here.
//  - `is_s_corporation` reads `s_corporations::s_corporation` (section 1361(a)(1)), NOT the same-named empirical relation of
//    `income_individual` (CAMT input): section 6037 speaks of the S corporation of subchapter S.
//  - `is_eligible_educational_institution` reads a `credits` contract that is itself asserted from the Higher Education Act test
//    (owner's TECH_GAP); the seam is sewn, the derivation stays the owner's.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Corporation,
    Person,
    TaxableYear,
    is_501a_exempt_organization,
    is_applicable_large_employer_subject_to_4980h,
    is_domestic_corporation,
    is_eligible_educational_institution,
    is_s_corporation,
    is_united_states_person,
};

rule W7UnitedStatesPersonFromDefinitions strict {
    label en official "section 6038(a): a United States person is the section 7701(a)(30) person of the owner package `definitions`";
    for person: Person;
    when us.irc.definitions::united_states_person(person);
    then is_united_states_person(person);
}

rule W7DomesticCorporationFromDefinitions strict {
    label en official "section 6038A(a): a domestic corporation is a corporation that is domestic under section 7701(a)(4) (owner package `definitions`)";
    for c: Corporation;
    when us.irc.definitions::domestic(c);
    then is_domestic_corporation(c);
}

rule W7SCorporationFromSCorporations strict {
    label en official "section 6037(a): an S corporation is a corporation for which a section 1362(a) election is in effect (owner package `s_corporations`)";
    for c: Corporation;
    for y: TaxableYear;
    when us.irc.s_corporations::s_corporation(c, y);
    then is_s_corporation(c, y);
}

rule W7ExemptOrganizationFromExemptOrganizations strict {
    label en official "section 6033(a)(1): an organization exempt under section 501(a) is the exempt organization of the owner package `exempt_organizations`";
    for org: Person;
    for y: TaxableYear;
    when us.irc.exempt_organizations::exempt_organization(org, y);
    then is_501a_exempt_organization(org, y);
}

rule W7EligibleEducationalInstitutionFromCredits strict {
    label en official "section 6050S(a): an eligible educational institution is the section 25A(f)(2) institution of the owner package `credits`";
    for institution: Person;
    when us.irc.credits::eligible_educational_institution(institution);
    then is_eligible_educational_institution(institution);
}

// JUDGMENT CALL: the owner keys the applicable-large-employer status by an Integer calendar year (section 4980H(c)(2), the preceding
// calendar year's average), the consumer by a `TaxableYear`; the two are joined by `core::calendar_year_of`, which is absent for a fiscal
// year, so a fiscal-year consumer question stays open rather than being answered for the wrong year.
rule W7ApplicableLargeEmployerFromExciseEntities strict {
    label en official "section 6056(a): the applicable large employer subject to section 4980H is the owner package `excise_entities` employer, joined on the calendar year";
    for employer: Person;
    for y: TaxableYear;
    for cy: Integer;
    when us.irc.core::calendar_year_of(y, cy)
        and us.irc.excise_entities::applicable_large_employer(employer, cy);
    then is_applicable_large_employer_subject_to_4980h(employer, y);
}
