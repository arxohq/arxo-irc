// §6050R - §6050Z of package `us.irc.information_reporting`, module 15
// (STAGE 2): fish purchasers, tuition and education loan returns (rest),
// health coverage tax credit, annuity charges, exempt-organization
// insurance acquisitions, payment card and third party network returns
// (rest), government settlements, life insurance sale and death benefit
// reporting, and certified long-term care insurance.
//
// JUDGMENT CALLS
//  - The §6050W definitions ((b), (c), (d)) are executed as classification
//    relations beside the stage-1 case-asserted `is_payment_settlement_
//    entity` / `reportable_payment_transaction` facts; the duty keeps
//    reading the asserted facts (noted per row).
//  - §6050Z applies to distributions after December 29, 2025 (note to the
//    section): the return duty carries an `effective` window from 2025-12-30.
//  - §6050V's sunset date is derived from the enactment date pinned in the
//    section's own effective-date note (Aug. 17, 2006 plus 24 months).

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6050R_A,
    IRC_S6050R_B,
    IRC_S6050R_C,
    IRC_S6050S_A,
    IRC_S6050S_B,
    IRC_S6050S_C,
    IRC_S6050S_D,
    IRC_S6050S_F,
    IRC_S6050T_A,
    IRC_S6050T_B,
    IRC_S6050T_C,
    IRC_S6050U_A,
    IRC_S6050U_B,
    IRC_S6050V_A,
    IRC_S6050V_C,
    IRC_S6050V_D,
    IRC_S6050V_E,
    IRC_S6050V_NOTE_5,
    IRC_S6050W_A,
    IRC_S6050W_B,
    IRC_S6050W_C,
    IRC_S6050W_D,
    IRC_S6050W_F,
    IRC_S6050X_A,
    IRC_S6050X_B,
    IRC_S6050X_C,
    IRC_S6050Y_A,
    IRC_S6050Y_B,
    IRC_S6050Y_C,
    IRC_S6050Y_D,
    IRC_S6050Z_A,
    IRC_S6050Z_B,
    IRC_S6050Z_C,
    IRC_S6050Z_D,
    InformationReturnKind,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    designated_officer_for_return,
    filed_information_return,
    furnished_payee_statement,
    governmental_unit,
    information_return_required,
    payee_statement_due,
    payee_statement_required,
    reportable_payment_transaction,
    required_return_item,
    required_statement_item,
};

// ============================================================================
// §6050R — fish purchasers
// ============================================================================

relation cash_payment_to_fish_catcher(buyer: Person, catcher: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person, engaged in the trade or business of purchasing fish for resale from persons engaged in catching fish, pays the catcher in cash (section 6050I(d)) this aggregate amount for the purchase of fish (or other aquatic life) during the calendar year";
}

@source(IRC_S6050R_A, relation = formalizes, coverage = exact, quote = "shall make a return (at such times as the Secretary may prescribe) described in subsection (b) with respect to each person to whom such a payment was made during such calendar year.")
rule S6050RaReturnDuty defeasible {
    for buyer: Person;
    for catcher: Person;
    for y: TaxableYear;
    for amount: Money;
    when cash_payment_to_fish_catcher(buyer, catcher, y, amount);
    when amount >= 600 USD;
    then duty MakeFishPurchaseReturn {
        bearer buyer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(buyer, catcher, y, FishPurchaseReturn6050R);
            window [-infinity, infinity];
        }
    };
    then information_return_required(buyer, catcher, y, FishPurchaseReturn6050R);
}

@source(IRC_S6050R_B, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of each person to whom a payment described in subsection (a)(2) was made during the calendar year,")
rule S6050RbReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, FishPurchaseReturn6050R);
    then required_return_item(payer, y, FishPurchaseReturn6050R, I6050R_NameAddressAndTinOfEachPayee);
    then required_return_item(payer, y, FishPurchaseReturn6050R, I6050R_AggregatePaymentsAndDateAndAmountOfEachPayment);
    then required_return_item(payer, y, FishPurchaseReturn6050R, I6050R_OtherInformationAsRequired);
}

@source(IRC_S6050R_C, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the person on or before January 31 of the year following the calendar year for which the return under subsection (a) is required to be made.")
rule S6050RStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, FishPurchaseReturn6050R);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, FishPurchaseReturn6050R, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050R_C, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6050RStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, FishPurchaseReturn6050R);
    when us.irc.core::ends(y, end_date);
    then duty FurnishFishPurchaseStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, FishPurchaseReturn6050R);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, FishPurchaseReturn6050R);
}

@source(IRC_S6050R_C, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such a return, and")
rule S6050RcStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, FishPurchaseReturn6050R);
    then required_statement_item(payer, y, FishPurchaseReturn6050R, I6050R_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, FishPurchaseReturn6050R, I6050R_AggregateAmountOfPayments);
}

// ============================================================================
// §6050S — tuition and education loan returns (branches (2), (3), rest)
// ============================================================================

relation insurance_arrangement_tuition_reimbursement(payer: Person, individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person is engaged in a trade or business of making payments to the individual under an insurance arrangement as reimbursements or refunds (or similar amounts) of qualified tuition and related expenses";
}

@source(IRC_S6050S_A, relation = formalizes, coverage = exact, quote = "which is engaged in a trade or business of making payments to any individual under an insurance arrangement as reimbursements or refunds (or similar amounts) of qualified tuition and related expenses; or")
rule S6050SaInsuranceReimbursementReturnDuty defeasible {
    for payer: Person;
    for individual: Person;
    for y: TaxableYear;
    when insurance_arrangement_tuition_reimbursement(payer, individual, y);
    then duty MakeTuitionReimbursementReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, individual, y, QualifiedTuitionPayments6050S);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, individual, y, QualifiedTuitionPayments6050S);
}

relation education_loan_interest_received(lender: Person, individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person, in the course of a trade or business, receives from the individual interest aggregating this amount for the calendar year on one or more qualified education loans";
}

relation regulation_excepts_6050s_loan_interest(lender: Person, y: TaxableYear) kind empirical {
    label en unofficial "a Secretary regulation provides otherwise for the loan-interest branch";
}

@source(IRC_S6050S_A, relation = formalizes, coverage = exact, quote = "except as provided in regulations, which is engaged in a trade or business and, in the course of which, receives from any individual interest aggregating $600 or more for any calendar year on one or more qualified education loans,")
rule S6050SaEducationLoanInterestReturnDuty defeasible {
    for lender: Person;
    for individual: Person;
    for y: TaxableYear;
    for amount: Money;
    when education_loan_interest_received(lender, individual, y, amount);
    when amount >= 600 USD;
    when not_known(regulation_excepts_6050s_loan_interest(lender, y));
    then duty MakeEducationLoanInterestReturn {
        bearer lender;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(lender, individual, y, QualifiedTuitionPayments6050S);
            window [-infinity, infinity];
        }
    };
    then information_return_required(lender, individual, y, QualifiedTuitionPayments6050S);
}

@source(IRC_S6050S_B, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of any individual—")
rule S6050SbReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, QualifiedTuitionPayments6050S);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_NameAddressAndTinOfIndividual);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_AggregateQualifiedTuitionPaymentsReceived);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_AggregateGrantsAdministeredByInstitution);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_AdjustmentsToPriorYearAmounts);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_AggregateReimbursementsOrRefunds);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_AggregateInterestReceived);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_EmployerIdentificationNumberOfInstitution);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_OtherInformationAsPrescribed);
}

@source(IRC_S6050S_C, relation = formalizes, coverage = exact, quote = "any return required under subsection (a) by such governmental entity shall be made by the officer or employee appropriately designated for the purpose of making such return.")
rule S6050SOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, QualifiedTuitionPayments6050S);
    when information_return_required(unit, payee, y, QualifiedTuitionPayments6050S);
    then duty MakeReturnAsDesignatedOfficer6050S {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, QualifiedTuitionPayments6050S);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6050S_D, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050SdStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, QualifiedTuitionPayments6050S);
    then required_statement_item(payer, y, QualifiedTuitionPayments6050S, I6050S_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, QualifiedTuitionPayments6050S, I6050S_InformationRequiredBySubsectionB2);
}

@source(IRC_S6050S_D, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050SStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, QualifiedTuitionPayments6050S);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, QualifiedTuitionPayments6050S, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050S_D, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return under subparagraph (A) of subsection (b)(2) a written statement showing—")
rule S6050SStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, QualifiedTuitionPayments6050S);
    when us.irc.core::ends(y, end_date);
    then duty FurnishEducationInformationStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, QualifiedTuitionPayments6050S);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, QualifiedTuitionPayments6050S);
}

relation eligible_educational_institution_25a(institution: Person) kind empirical {
    label en unofficial "eligible educational institution within the meaning of section 25A (without regard to subsection (g)(2))";
}

relation qualified_education_loan_221d1(loan: us.irc.core::Asset) kind empirical {
    label en unofficial "qualified education loan within the meaning of section 221(d)(1), except as provided in regulations";
}

relation interest_or_tuition_first_received_on_behalf_of_another(person: Person, individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "the amount is received by this person on behalf of another person who received it first";
}

relation not_first_recipient_6050s(person: Person, individual: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050S(f): only the person first receiving the amount is required to make the return";
}

@source(IRC_S6050S_F, relation = formalizes, coverage = exact, quote = "in the case of any amount received by any person on behalf of another person, only the person first receiving such amount shall be required to make the return under subsection (a).")
rule S6050SfOnlyFirstRecipient strict {
    for person: Person;
    for individual: Person;
    for y: TaxableYear;
    when interest_or_tuition_first_received_on_behalf_of_another(person, individual, y);
    then not_first_recipient_6050s(person, individual, y);
}

// ============================================================================
// §6050T — health coverage tax credit advance payments; §6050U — annuity and life insurance charges
// ============================================================================

relation entitled_to_7527_payments_for_certified_individual(person: Person, individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person is entitled to receive payments for any month of the calendar year under section 7527 with respect to the certified individual (section 7527(c))";
}

@source(IRC_S6050T_A, relation = formalizes, coverage = exact, quote = "shall, at such time as the Secretary may prescribe, make the return described in subsection (b) with respect to each such individual.")
rule S6050TaReturnDuty defeasible {
    for person: Person;
    for individual: Person;
    for y: TaxableYear;
    when entitled_to_7527_payments_for_certified_individual(person, individual, y);
    then duty MakeAdvancePaymentHealthCreditReturn {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(person, individual, y, AdvancePaymentHealthCreditReturn6050T);
            window [-infinity, infinity];
        }
    };
    then information_return_required(person, individual, y, AdvancePaymentHealthCreditReturn6050T);
}

@source(IRC_S6050T_B, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of each individual referred to in subsection (a),")
rule S6050TbReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, AdvancePaymentHealthCreditReturn6050T);
    then required_return_item(payer, y, AdvancePaymentHealthCreditReturn6050T, I6050T_NameAddressAndTinOfEachIndividual);
    then required_return_item(payer, y, AdvancePaymentHealthCreditReturn6050T, I6050T_NumberOfMonthsEntitled);
    then required_return_item(payer, y, AdvancePaymentHealthCreditReturn6050T, I6050T_AmountEntitledForEachMonth);
    then required_return_item(payer, y, AdvancePaymentHealthCreditReturn6050T, I6050T_OtherInformationAsPrescribed);
}

@source(IRC_S6050T_C, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished on or before January 31 of the year following the calendar year for which the return under subsection (a) is required to be made.")
rule S6050TStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, AdvancePaymentHealthCreditReturn6050T);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, AdvancePaymentHealthCreditReturn6050T, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050T_C, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return a written statement showing—")
rule S6050TStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, AdvancePaymentHealthCreditReturn6050T);
    when us.irc.core::ends(y, end_date);
    then duty FurnishAdvancePaymentHealthCreditStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, AdvancePaymentHealthCreditReturn6050T);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, AdvancePaymentHealthCreditReturn6050T);
}

@source(IRC_S6050T_C, relation = formalizes, coverage = partial, quote = "the name and address of the person required to make such return and the phone number of the information contact for such person, and")
rule S6050TcStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, AdvancePaymentHealthCreditReturn6050T);
    then required_statement_item(payer, y, AdvancePaymentHealthCreditReturn6050T, I6050T_NameAddressAndPhoneOfPerson);
    then required_statement_item(payer, y, AdvancePaymentHealthCreditReturn6050T, I6050T_InformationShownOnReturnForThisIndividual);
}

relation charge_against_annuity_or_life_insurance_value_excludible_72e11(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person makes a charge against the cash value of an annuity contract, or the cash surrender value of a life insurance contract, which is excludible from gross income under section 72(e)(11) for the calendar year";
}

@source(IRC_S6050U_A, relation = formalizes, coverage = exact, quote = "shall make a return, according to the forms or regulations prescribed by the Secretary, setting forth—")
rule S6050UReturnDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when charge_against_annuity_or_life_insurance_value_excludible_72e11(payer, payee, y);
    then duty MakeAnnuityChargesReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
}

@source(IRC_S6050U_A, relation = formalizes, coverage = exact, quote = "the amount of the aggregate of such charges against each such contract for the calendar year,")
rule S6050UaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
    then required_return_item(payer, y, AnnuityLifeInsuranceChargesReturn6050U, I6050U_AggregateChargesAgainstEachContract);
    then required_return_item(payer, y, AnnuityLifeInsuranceChargesReturn6050U, I6050U_ReductionInInvestmentInEachContract);
    then required_return_item(payer, y, AnnuityLifeInsuranceChargesReturn6050U, I6050U_NameAddressAndTinOfHolder);
}

@source(IRC_S6050U_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the individual on or before January 31 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6050UStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, AnnuityLifeInsuranceChargesReturn6050U, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050U_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return a written statement showing—")
rule S6050UStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
    when us.irc.core::ends(y, end_date);
    then duty FurnishAnnuityChargesStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
}

@source(IRC_S6050U_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person making the payments, and")
rule S6050UbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, AnnuityLifeInsuranceChargesReturn6050U);
    then required_statement_item(payer, y, AnnuityLifeInsuranceChargesReturn6050U, I6050U_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, AnnuityLifeInsuranceChargesReturn6050U, I6050U_InformationShownOnReturnForThisIndividual);
}

// ============================================================================
// §6050V — applicable insurance contracts acquired by exempt organizations
// ============================================================================

relation applicable_exempt_organization_class(org: Person, cls: ApplicableExemptOrgClass) kind empirical {
    label en unofficial "the organization is described in section 170(c), section 168(h)(2)(A)(iv), or (not described in either) section 2055(a) or 2522(a)";
}

pub enum ApplicableExemptOrgClass {
    Section170c;
    Section168h2Aiv;
    Section2055aOr2522a;
}

relation applicable_exempt_organization(org: Person) kind institutional {
    label en unofficial "section 6050V(d)(3): an applicable exempt organization";
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "an organization described in section 170(c),")
rule S6050Vd3Organization1 strict {
    for org: Person;
    when applicable_exempt_organization_class(org, Section170c);
    then applicable_exempt_organization(org);
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "an organization described in section 168(h)(2)(A)(iv), or")
rule S6050Vd3Organization2 strict {
    for org: Person;
    when applicable_exempt_organization_class(org, Section168h2Aiv);
    then applicable_exempt_organization(org);
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "an organization not described in paragraph (1) or (2) which is described in section 2055(a) or section 2522(a).")
rule S6050Vd3Organization3 strict {
    for org: Person;
    when applicable_exempt_organization_class(org, Section2055aOr2522a);
    then applicable_exempt_organization(org);
}

relation acquires_interest_in_insurance_contract_in_structured_pool(org: Person, contract: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the organization acquires a direct or indirect interest in an insurance contract as part of a structured transaction involving a pool of such contracts, on this date";
}

relation reportable_acquisition(org: Person, contract: us.irc.core::Asset, d: Date) kind institutional {
    label en unofficial "section 6050V(d)(1): a reportable acquisition";
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "The term \"reportable acquisition\" means the acquisition by an applicable exempt organization of a direct or indirect interest in any applicable insurance contract in any case in which such acquisition is a part of a structured transaction involving a pool of such contracts.")
rule S6050Vd1ReportableAcquisition defeasible {
    for org: Person;
    for contract: us.irc.core::Asset;
    for d: Date;
    when applicable_exempt_organization(org);
    when acquires_interest_in_insurance_contract_in_structured_pool(org, contract, d);
    when applicable_insurance_contract(contract);
    then reportable_acquisition(org, contract, d);
}

relation contract_kind_life_annuity_endowment(contract: us.irc.core::Asset) kind empirical {
    label en unofficial "the contract is a life insurance, annuity or endowment contract";
}

relation org_and_other_person_have_held_interest(contract: us.irc.core::Asset) kind empirical {
    label en unofficial "both an applicable exempt organization and a person other than one have directly or indirectly held an interest in the contract (whether or not at the same time)";
}

relation all_other_holders_have_independent_insurable_interest(contract: us.irc.core::Asset) kind empirical {
    label en unofficial "all persons directly or indirectly holding any interest (other than applicable exempt organizations) have an insurable interest in the insured independent of any interest of an applicable exempt organization";
}

relation sole_interest_is_named_beneficiary(contract: us.irc.core::Asset) kind empirical {
    label en unofficial "the sole interest in the contract of the applicable exempt organization or each other person is as a named beneficiary";
}

relation sole_interest_of_others_is_gratuitous_trust_beneficiary_or_fiduciary(contract: us.irc.core::Asset) kind empirical {
    label en unofficial "the sole interest of each person other than an applicable exempt organization is as a gratuitous beneficiary of a trust holding the interest, or as a trustee holding it solely in a fiduciary capacity for applicable exempt organizations or persons described in the other exclusions";
}

relation applicable_insurance_contract(contract: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050V(d)(2): an applicable insurance contract";
}

relation applicable_insurance_contract_excluded(contract: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050V(d)(2)(B): the contract is excluded from the term";
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "The term \"applicable insurance contract\" means any life insurance, annuity, or endowment contract with respect to which both an applicable exempt organization and a person other than an applicable exempt organization have directly or indirectly held an interest in the contract (whether or not at the same time).")
rule S6050Vd2AApplicableInsuranceContract defeasible {
    for contract: us.irc.core::Asset;
    when contract_kind_life_annuity_endowment(contract);
    when org_and_other_person_have_held_interest(contract);
    when not_known(applicable_insurance_contract_excluded(contract));
    then applicable_insurance_contract(contract);
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "all persons directly or indirectly holding any interest in the contract (other than applicable exempt organizations) have an insurable interest in the insured under the contract independent of any interest of an applicable exempt organization in the contract,")
rule S6050Vd2BExclusion1 strict {
    for contract: us.irc.core::Asset;
    when all_other_holders_have_independent_insurable_interest(contract);
    then applicable_insurance_contract_excluded(contract);
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "the sole interest in the contract of an applicable exempt organization or each person other than an applicable exempt organization is as a named beneficiary, or")
rule S6050Vd2BExclusion2 strict {
    for contract: us.irc.core::Asset;
    when sole_interest_is_named_beneficiary(contract);
    then applicable_insurance_contract_excluded(contract);
}

@source(IRC_S6050V_D, relation = formalizes, coverage = exact, quote = "the sole interest in the contract of each person other than an applicable exempt organization is—")
rule S6050Vd2BExclusion3 strict {
    for contract: us.irc.core::Asset;
    when sole_interest_of_others_is_gratuitous_trust_beneficiary_or_fiduciary(contract);
    then applicable_insurance_contract_excluded(contract);
}

relation acquisition_date_after_sunset_6050v(d: Date) kind institutional {
    label en unofficial "the acquisition date is after the date 2 years after the enactment of section 6050V";
}

relation section_6050v_enactment_date(d: Date) kind institutional {
    label en unofficial "the date of the enactment of section 6050V (Pub. L. 109-280, Aug. 17, 2006, pinned in the section's effective-date note)";
}

@source(IRC_S6050V_NOTE_5, relation = formalizes, coverage = contextual, quote = "Pub. L. 109–280, title XII, §1211(d), Aug. 17, 2006, 120 Stat. 1074, provided that")
rule S6050VEnactmentDateFromNote strict {
    then section_6050v_enactment_date(@2006-08-17);
}

@source(IRC_S6050V_E, relation = formalizes, coverage = exact, quote = "This section shall not apply to reportable acquisitions occurring after the date which is 2 years after the date of the enactment of this section.")
rule S6050VeSunset strict {
    for org: Person;
    for contract: us.irc.core::Asset;
    for d: Date;
    for e: Date;
    when acquires_interest_in_insurance_contract_in_structured_pool(org, contract, d);
    when section_6050v_enactment_date(e);
    when d > add_calendar_period(e, 24 calendar_month);
    then acquisition_date_after_sunset_6050v(d);
}

relation applicable_exempt_org_return_made(org: Person, contract: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "case fact: the organization made the section 6050V(c) return";
}

@source(IRC_S6050V_A, relation = formalizes, coverage = exact, quote = "Each applicable exempt organization which makes a reportable acquisition shall make the return described in subsection (c).")
rule S6050VaReturnDuty defeasible {
    for org: Person;
    for contract: us.irc.core::Asset;
    for d: Date;
    for y: TaxableYear;
    for s: Date;
    for x: Date;
    when reportable_acquisition(org, contract, d);
    when not_known(acquisition_date_after_sunset_6050v(d));
    when us.irc.core::begins(y, s);
    when us.irc.core::ends(y, x);
    when s <= d;
    when d <= x;
    then duty MakeInsuranceAcquisitionReturn {
        bearer org;
        beneficiary Secretary;
        goal achievement {
            condition applicable_exempt_org_return_made(org, contract, d);
            window [-infinity, infinity];
        }
    };
    then information_return_required(org, Secretary, y, ExemptOrganizationInsuranceAcquisitionReturn6050V);
}

@source(IRC_S6050V_C, relation = formalizes, coverage = exact, quote = "is in such form as the Secretary prescribes,")
rule S6050VcReturnContent defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ExemptOrganizationInsuranceAcquisitionReturn6050V);
    then required_return_item(filer, y, ExemptOrganizationInsuranceAcquisitionReturn6050V, I6050V_NameAddressAndTinOfOrganizationAndIssuer);
    then required_return_item(filer, y, ExemptOrganizationInsuranceAcquisitionReturn6050V, I6050V_OtherInformationAsPrescribed);
}

// ============================================================================
// §6050W (rest) — payment card and third party network transactions
// ============================================================================

@source(IRC_S6050W_A, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of each participating payee to whom one or more payments in settlement of reportable payment transactions are made, and")
rule S6050WaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, PaymentCardAndThirdPartyNetwork6050W);
    then required_return_item(payer, y, PaymentCardAndThirdPartyNetwork6050W, I6050W_NameAddressAndTinOfEachParticipatingPayee);
    then required_return_item(payer, y, PaymentCardAndThirdPartyNetwork6050W, I6050W_GrossAmountOfReportablePaymentTransactions);
}

relation bank_or_organization_with_contractual_obligation_for_card_payments(e: Person) kind empirical {
    label en unofficial "the bank or other organization has the contractual obligation to make payment to participating payees in settlement of payment card transactions";
}

relation central_organization_with_contractual_obligation_for_network_payments(e: Person) kind empirical {
    label en unofficial "the central organization has the contractual obligation to make payment to participating payees of third party network transactions";
}

relation merchant_acquiring_entity(e: Person) kind institutional {
    label en unofficial "section 6050W(b)(2): the bank or other organization with the contractual obligation to pay payees in settlement of payment card transactions";
}

relation third_party_settlement_organization_defined(e: Person) kind institutional {
    label en unofficial "section 6050W(b)(3): the central organization with the contractual obligation to pay payees of third party network transactions";
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "The term \"merchant acquiring entity\" means the bank or other organization which has the contractual obligation to make payment to participating payees in settlement of payment card transactions.")
rule S6050Wb2MerchantAcquiringEntity strict {
    for e: Person;
    when bank_or_organization_with_contractual_obligation_for_card_payments(e);
    then merchant_acquiring_entity(e);
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "The term \"third party settlement organization\" means the central organization which has the contractual obligation to make payment to participating payees of third party network transactions.")
rule S6050Wb3ThirdPartySettlementOrganization strict {
    for e: Person;
    when central_organization_with_contractual_obligation_for_network_payments(e);
    then third_party_settlement_organization_defined(e);
}

relation payment_settlement_entity_defined(e: Person) kind institutional {
    label en unofficial "section 6050W(b)(1): the merchant acquiring entity (payment card transactions) or the third party settlement organization (third party network transactions)";
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "in the case of a payment card transaction, the merchant acquiring entity, and")
rule S6050Wb1PaymentSettlementEntityCard strict {
    for e: Person;
    when merchant_acquiring_entity(e);
    then payment_settlement_entity_defined(e);
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "in the case of a third party network transaction, the third party settlement organization.")
rule S6050Wb1PaymentSettlementEntityNetwork strict {
    for e: Person;
    when third_party_settlement_organization_defined(e);
    then payment_settlement_entity_defined(e);
}

relation reportable_transactions_of_several_payees_settled_through_intermediary(pse: Person, intermediary: Person, y: TaxableYear) kind empirical {
    label en unofficial "reportable payment transactions of more than one participating payee are settled through the intermediary";
}

relation intermediary_treated_as_participating_payee(pse: Person, intermediary: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050W(b)(4)(A)(i): the intermediary is the participating payee for the settlement entity's reporting obligations";
}

relation intermediary_treated_as_payment_settlement_entity(intermediary: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050W(b)(4)(A)(ii): the intermediary is the payment settlement entity for settlement with the participating payees";
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "such intermediary shall be treated as the participating payee for purposes of determining the reporting obligations of the payment settlement entity with respect to such transactions, and")
rule S6050Wb4AiIntermediaryAsPayee strict {
    for pse: Person;
    for intermediary: Person;
    for y: TaxableYear;
    when reportable_transactions_of_several_payees_settled_through_intermediary(pse, intermediary, y);
    then intermediary_treated_as_participating_payee(pse, intermediary, y);
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "such intermediary shall be treated as the payment settlement entity with respect to the settlement of such transactions with the participating payees.")
rule S6050Wb4AiiIntermediaryAsEntity strict {
    for pse: Person;
    for intermediary: Person;
    for y: TaxableYear;
    when reportable_transactions_of_several_payees_settled_through_intermediary(pse, intermediary, y);
    then intermediary_treated_as_payment_settlement_entity(intermediary, y);
}

relation facilitator_makes_payments_on_behalf_of_pse(pse: Person, facilitator: Person, y: TaxableYear) kind empirical {
    label en unofficial "an electronic payment facilitator or other third party makes payments in settlement of reportable payment transactions on behalf of the payment settlement entity";
}

relation facilitator_files_return_in_lieu(pse: Person, facilitator: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050W(b)(4)(B): the return is made by the facilitator in lieu of the payment settlement entity";
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "the return under subsection (a) shall be made by such electronic payment facilitator or other third party in lieu of the payment settlement entity.")
rule S6050Wb4BFacilitatorReturn strict {
    for pse: Person;
    for facilitator: Person;
    for y: TaxableYear;
    when facilitator_makes_payments_on_behalf_of_pse(pse, facilitator, y);
    then facilitator_files_return_in_lieu(pse, facilitator, y);
}

relation facilitator_return_filed(facilitator: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the facilitator made the section 6050W return";
}

@source(IRC_S6050W_B, relation = formalizes, coverage = exact, quote = "the return under subsection (a) shall be made by such electronic payment facilitator or other third party in lieu of the payment settlement entity.")
rule S6050Wb4BFacilitatorReturnDuty defeasible {
    for pse: Person;
    for facilitator: Person;
    for payee: Person;
    for y: TaxableYear;
    for gross: Money;
    when facilitator_files_return_in_lieu(pse, facilitator, y);
    when reportable_payment_transaction(pse, payee, y, gross);
    then duty MakePaymentCardReturnAsFacilitator {
        bearer facilitator;
        beneficiary Secretary;
        goal achievement {
            condition facilitator_return_filed(facilitator, payee, y);
            window [-infinity, infinity];
        }
    };
}

relation payment_card_accepted_as_payment(payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person accepts a payment card (or an account number or other indicia associated with a payment card) as payment";
}

relation accepts_payment_from_tpso_in_settlement(payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person accepts payment from a third party settlement organization in settlement of a third party network transaction";
}

relation payee_has_only_foreign_address(payee: Person) kind empirical {
    label en unofficial "the person has only a foreign address (and receives payments from the settlement entity solely in dollars)";
}

relation regulation_includes_foreign_address_payee(payee: Person) kind empirical {
    label en unofficial "the Secretary provides by regulation or guidance that a person with a foreign address is a participating payee";
}

relation participating_payee(payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050W(d)(1): a participating payee";
}

@source(IRC_S6050W_D, relation = formalizes, coverage = exact, quote = "in the case of a payment card transaction, any person who accepts a payment card as payment, and")
rule S6050Wd1aiPayeeCard defeasible {
    for payee: Person;
    for y: TaxableYear;
    when payment_card_accepted_as_payment(payee, y);
    when not_known(payee_has_only_foreign_address(payee));
    then participating_payee(payee, y);
}

@source(IRC_S6050W_D, relation = formalizes, coverage = exact, quote = "in the case of a third party network transaction, any person who accepts payment from a third party settlement organization in settlement of such transaction.")
rule S6050Wd1aiiPayeeNetwork defeasible {
    for payee: Person;
    for y: TaxableYear;
    when accepts_payment_from_tpso_in_settlement(payee, y);
    when not_known(payee_has_only_foreign_address(payee));
    then participating_payee(payee, y);
}

@source(IRC_S6050W_D, relation = formalizes, coverage = exact, quote = "Except as provided by the Secretary in regulations or other guidance, such term shall not include any person with a foreign address.")
rule S6050Wd1bForeignAddressIncluded defeasible {
    for payee: Person;
    for y: TaxableYear;
    when payee_has_only_foreign_address(payee);
    when regulation_includes_foreign_address_payee(payee);
    when payment_card_accepted_as_payment(payee, y);
    then participating_payee(payee, y);
}

relation reportable_payment_transaction_defined(payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "section 6050W(c)(1): any payment card transaction and any third party network transaction";
}

@source(IRC_S6050W_C, relation = formalizes, coverage = exact, quote = "The term \"payment card transaction\" means any transaction in which a payment card is accepted as payment.")
rule S6050Wc1ReportablePaymentTransactionCard strict {
    for payee: Person;
    for y: TaxableYear;
    when payment_card_accepted_as_payment(payee, y);
    then reportable_payment_transaction_defined(payee, y);
}

@source(IRC_S6050W_C, relation = formalizes, coverage = exact, quote = "The term \"third party network transaction\" means any transaction described in subsection (d)(3)(A)(iii) which is settled through a third party payment network.")
rule S6050Wc3ThirdPartyNetworkTransaction strict {
    for payee: Person;
    for y: TaxableYear;
    when accepts_payment_from_tpso_in_settlement(payee, y);
    then reportable_payment_transaction_defined(payee, y);
}

relation card_arrangement_has_issuers(arrangement: us.irc.core::Asset) kind empirical {
    label en unofficial "the agreement provides for one or more issuers of the cards";
}

relation card_arrangement_has_unrelated_acceptor_network(arrangement: us.irc.core::Asset) kind empirical {
    label en unofficial "the agreement provides for a network of persons unrelated to each other, and to the issuer, who agree to accept the cards as payment";
}

relation card_arrangement_has_settlement_standards(arrangement: us.irc.core::Asset) kind empirical {
    label en unofficial "the agreement provides for standards and mechanisms for settling transactions between merchant acquiring entities and the accepting persons";
}

relation payment_card_arrangement(arrangement: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050W(d)(2): the card is issued under an agreement satisfying (A)-(C)";
}

@source(IRC_S6050W_D, relation = formalizes, coverage = exact, quote = "The term \"payment card\" means any card which is issued pursuant to an agreement or arrangement which provides for—")
rule S6050Wd2PaymentCard strict {
    for arrangement: us.irc.core::Asset;
    when card_arrangement_has_issuers(arrangement);
    when card_arrangement_has_unrelated_acceptor_network(arrangement);
    when card_arrangement_has_settlement_standards(arrangement);
    then payment_card_arrangement(arrangement);
}

relation network_accounts_with_central_organization_by_substantial_number(arrangement: us.irc.core::Asset) kind empirical {
    label en unofficial "the arrangement involves the establishment of accounts with a central organization by a substantial number of unrelated persons who provide goods or services and have agreed to settle such transactions under it";
}

relation network_has_settlement_standards(arrangement: us.irc.core::Asset) kind empirical {
    label en unofficial "the arrangement provides for standards and mechanisms for settling the transactions";
}

relation network_guarantees_payment(arrangement: us.irc.core::Asset) kind empirical {
    label en unofficial "the arrangement guarantees the persons providing goods or services that they will be paid";
}

relation network_provides_for_issuance_of_payment_cards(arrangement: us.irc.core::Asset) kind empirical {
    label en unofficial "the agreement or arrangement provides for the issuance of payment cards";
}

relation third_party_payment_network(arrangement: us.irc.core::Asset) kind institutional {
    label en unofficial "section 6050W(d)(3): a third party payment network";
}

@source(IRC_S6050W_D, relation = formalizes, coverage = exact, quote = "The term \"third party payment network\" means any agreement or arrangement—")
rule S6050Wd3ThirdPartyPaymentNetwork defeasible {
    for arrangement: us.irc.core::Asset;
    when network_accounts_with_central_organization_by_substantial_number(arrangement);
    when network_has_settlement_standards(arrangement);
    when network_guarantees_payment(arrangement);
    when not_known(network_provides_for_issuance_of_payment_cards(arrangement));
    then third_party_payment_network(arrangement);
}

@source(IRC_S6050W_F, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050WfStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PaymentCardAndThirdPartyNetwork6050W);
    then required_statement_item(payer, y, PaymentCardAndThirdPartyNetwork6050W, I6050W_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, PaymentCardAndThirdPartyNetwork6050W, I6050W_GrossAmountOfReportablePaymentTransactions);
}

// ============================================================================
// §6050X — governmental suits and agreements
// ============================================================================

relation official_involved_in_suit_or_agreement(official: Person, party: Person, y: TaxableYear, total: Money) kind empirical {
    label en unofficial "the appropriate official of a government or section 162(f)(5) entity is involved in a suit (with a court order) or an agreement about a violation of law over which it has authority (or an investigation or inquiry); the aggregate amount of all court orders and agreements is this total; the party is the person party to the suit or agreement";
}

relation regulation_adjusted_6050x_threshold(amount: Money) kind empirical {
    label en unofficial "the Secretary's adjusted reporting threshold in place of $600 (no adjustment pinned)";
}

@source(IRC_S6050X_A, relation = formalizes, coverage = exact, quote = "The appropriate official of any government or any entity described in section 162(f)(5) which is involved in a suit or agreement described in paragraph (2) shall make a return in such form as determined by the Secretary setting forth—")
rule S6050XaReturnDuty defeasible {
    for official: Person;
    for party: Person;
    for y: TaxableYear;
    for total: Money;
    when official_involved_in_suit_or_agreement(official, party, y, total);
    when total >= 600 USD;
    when not_known(regulation_adjusted_6050x_threshold_present(official, y));
    then duty MakeGovernmentSuitOrAgreementReturn {
        bearer official;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(official, party, y, GovernmentSuitOrAgreementReturn6050X);
            window [-infinity, infinity];
        }
    };
    then information_return_required(official, party, y, GovernmentSuitOrAgreementReturn6050X);
}

relation regulation_adjusted_6050x_threshold_present(official: Person, y: TaxableYear) kind empirical {
    label en unofficial "a Secretary adjustment of the $600 threshold applies to this official and year";
}

@source(IRC_S6050X_A, relation = formalizes, coverage = exact, quote = "the amount required to be paid as a result of the suit or agreement to which paragraph (1) of section 162(f) applies,")
rule S6050XaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, GovernmentSuitOrAgreementReturn6050X);
    then required_return_item(payer, y, GovernmentSuitOrAgreementReturn6050X, I6050X_AmountRequiredToBePaidUnderSection162f1);
    then required_return_item(payer, y, GovernmentSuitOrAgreementReturn6050X, I6050X_AmountForRestitutionOrRemediation);
    then required_return_item(payer, y, GovernmentSuitOrAgreementReturn6050X, I6050X_AmountForComingIntoCompliance);
}

@source(IRC_S6050X_B, relation = formalizes, coverage = partial, quote = "The written statement required under the preceding sentence shall be furnished to the person at the same time the government or entity provides the Secretary with the information required under subsection (a).")
rule S6050XStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, GovernmentSuitOrAgreementReturn6050X);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, GovernmentSuitOrAgreementReturn6050X, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050X_B, relation = formalizes, coverage = partial, quote = "Every person required to make a return under subsection (a) shall furnish to each person who is a party to the suit or agreement a written statement showing—")
rule S6050XStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, GovernmentSuitOrAgreementReturn6050X);
    when us.irc.core::ends(y, end_date);
    then duty FurnishGovernmentSuitOrAgreementStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, GovernmentSuitOrAgreementReturn6050X);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, GovernmentSuitOrAgreementReturn6050X);
}

@source(IRC_S6050X_B, relation = formalizes, coverage = partial, quote = "the name of the government or entity, and")
rule S6050XbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, GovernmentSuitOrAgreementReturn6050X);
    then required_statement_item(payer, y, GovernmentSuitOrAgreementReturn6050X, I6050X_NameOfGovernmentOrEntity);
    then required_statement_item(payer, y, GovernmentSuitOrAgreementReturn6050X, I6050X_InformationSuppliedToSecretary);
}

@source(IRC_S6050X_C, relation = formalizes, coverage = exact, quote = "the term \"appropriate official\" means the officer or employee having control of the suit, investigation, or inquiry or the person appropriately designated for purposes of this section.")
rule S6050XOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, GovernmentSuitOrAgreementReturn6050X);
    when information_return_required(unit, payee, y, GovernmentSuitOrAgreementReturn6050X);
    then duty MakeReturnAsDesignatedOfficer6050X {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, GovernmentSuitOrAgreementReturn6050X);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6050Y — life insurance contract transactions
// ============================================================================

relation acquires_life_insurance_in_reportable_policy_sale(buyer: Person, seller: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person acquires a life insurance contract or an interest in one in a reportable policy sale (section 101(a)(3)(B)) during the taxable year, paying this amount to the seller";
}

@source(IRC_S6050Y_A, relation = formalizes, coverage = exact, quote = "Every person who acquires a life insurance contract or any interest in a life insurance contract in a reportable policy sale during any taxable year shall make a return for such taxable year (at such time and in such manner as the Secretary shall prescribe) setting forth—")
rule S6050YaBuyerReturnDuty defeasible {
    for buyer: Person;
    for seller: Person;
    for y: TaxableYear;
    for amount: Money;
    when acquires_life_insurance_in_reportable_policy_sale(buyer, seller, y, amount);
    then duty MakePolicySaleReturn {
        bearer buyer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(buyer, seller, y, ReportablePolicySaleReturn6050Y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(buyer, seller, y, ReportablePolicySaleReturn6050Y);
}

@source(IRC_S6050Y_A, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of such person,")
rule S6050YaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ReportablePolicySaleReturn6050Y);
    then required_return_item(payer, y, ReportablePolicySaleReturn6050Y, I6050Y_NameAddressAndTinOfBuyer);
    then required_return_item(payer, y, ReportablePolicySaleReturn6050Y, I6050Y_NameAddressAndTinOfEachPaymentRecipient);
    then required_return_item(payer, y, ReportablePolicySaleReturn6050Y, I6050Y_DateOfSale);
    then required_return_item(payer, y, ReportablePolicySaleReturn6050Y, I6050Y_IssuerNameAndPolicyNumber);
    then required_return_item(payer, y, ReportablePolicySaleReturn6050Y, I6050Y_AmountOfEachPayment);
}

@source(IRC_S6050Y_A, relation = formalizes, coverage = exact, quote = "Every person required to make a return under this subsection shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6050YaStatementDuty defeasible {
    for buyer: Person;
    for seller: Person;
    for y: TaxableYear;
    when information_return_required(buyer, seller, y, ReportablePolicySaleReturn6050Y);
    then duty FurnishPolicySaleStatement {
        bearer buyer;
        beneficiary seller;
        goal achievement {
            condition furnished_payee_statement(buyer, seller, y, ReportablePolicySaleReturn6050Y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(buyer, seller, y, ReportablePolicySaleReturn6050Y);
}

@source(IRC_S6050Y_A, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050YaStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, ReportablePolicySaleReturn6050Y);
    then required_statement_item(payer, y, ReportablePolicySaleReturn6050Y, I6050Y_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, ReportablePolicySaleReturn6050Y, I6050Y_InformationShownOnReturnForThisPerson);
}

relation issuer_received_statement_or_transfer_notice(issuer: Person, seller: Person, y: TaxableYear) kind empirical {
    label en unofficial "the issuer received the section 6050Y(a)(2) statement or notice of a transfer of a life insurance contract to a foreign person";
}

relation issuer_return_filed(issuer: Person, seller: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the issuer made the section 6050Y(b) return";
}

@source(IRC_S6050Y_B, relation = formalizes, coverage = exact, quote = "each issuer of a life insurance contract shall make a return (at such time and in such manner as the Secretary shall prescribe) setting forth—")
rule S6050YbIssuerReturnDuty defeasible {
    for issuer: Person;
    for seller: Person;
    for y: TaxableYear;
    when issuer_received_statement_or_transfer_notice(issuer, seller, y);
    then duty MakeIssuerReturnOnPolicySale {
        bearer issuer;
        beneficiary Secretary;
        goal achievement {
            condition issuer_return_filed(issuer, seller, y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(issuer, seller, y, IssuerReturnOnPolicySale6050Y);
}

@source(IRC_S6050Y_B, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of the seller who transfers any interest in such contract in such sale,")
rule S6050YbReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, IssuerReturnOnPolicySale6050Y);
    then required_return_item(payer, y, IssuerReturnOnPolicySale6050Y, I6050Y_NameAddressAndTinOfSeller);
    then required_return_item(payer, y, IssuerReturnOnPolicySale6050Y, I6050Y_InvestmentInContractOfSeller);
    then required_return_item(payer, y, IssuerReturnOnPolicySale6050Y, I6050Y_PolicyNumber);
}

@source(IRC_S6050Y_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under this subsection shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6050YbStatementDuty defeasible {
    for issuer: Person;
    for seller: Person;
    for y: TaxableYear;
    when information_return_required(issuer, seller, y, IssuerReturnOnPolicySale6050Y);
    then duty FurnishIssuerPolicySaleStatement {
        bearer issuer;
        beneficiary seller;
        goal achievement {
            condition furnished_payee_statement(issuer, seller, y, IssuerReturnOnPolicySale6050Y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(issuer, seller, y, IssuerReturnOnPolicySale6050Y);
}

@source(IRC_S6050Y_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050YbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, IssuerReturnOnPolicySale6050Y);
    then required_statement_item(payer, y, IssuerReturnOnPolicySale6050Y, I6050Y_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, IssuerReturnOnPolicySale6050Y, I6050Y_InformationShownOnReturnForEachSeller);
}

relation pays_reportable_death_benefits(payer: Person, recipient: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the person pays amounts by reason of the death of the insured under a life insurance contract that was transferred in a reportable policy sale, during the taxable year";
}

@source(IRC_S6050Y_C, relation = formalizes, coverage = exact, quote = "Every person who makes a payment of reportable death benefits during any taxable year shall make a return for such taxable year (at such time and in such manner as the Secretary shall prescribe) setting forth—")
rule S6050YcDeathBenefitsReturnDuty defeasible {
    for payer: Person;
    for recipient: Person;
    for y: TaxableYear;
    for amount: Money;
    when pays_reportable_death_benefits(payer, recipient, y, amount);
    then duty MakeDeathBenefitsReturn {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(payer, recipient, y, ReportableDeathBenefitsReturn6050Y);
            window [-infinity, infinity];
        }
    };
    then information_return_required(payer, recipient, y, ReportableDeathBenefitsReturn6050Y);
}

@source(IRC_S6050Y_C, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of the person making such payment,")
rule S6050YcReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, ReportableDeathBenefitsReturn6050Y);
    then required_return_item(payer, y, ReportableDeathBenefitsReturn6050Y, I6050Y_NameAddressAndTinOfPayer);
    then required_return_item(payer, y, ReportableDeathBenefitsReturn6050Y, I6050Y_NameAddressAndTinOfEachRecipient);
    then required_return_item(payer, y, ReportableDeathBenefitsReturn6050Y, I6050Y_DateOfEachPayment);
    then required_return_item(payer, y, ReportableDeathBenefitsReturn6050Y, I6050Y_GrossAmountOfEachPayment);
    then required_return_item(payer, y, ReportableDeathBenefitsReturn6050Y, I6050Y_EstimateOfInvestmentInContractWithRespectToBuyer);
}

@source(IRC_S6050Y_C, relation = formalizes, coverage = exact, quote = "Every person required to make a return under this subsection shall furnish to each person whose name is required to be set forth in such return a written statement showing—")
rule S6050YcStatementDuty defeasible {
    for payer: Person;
    for recipient: Person;
    for y: TaxableYear;
    when information_return_required(payer, recipient, y, ReportableDeathBenefitsReturn6050Y);
    then duty FurnishDeathBenefitsStatement {
        bearer payer;
        beneficiary recipient;
        goal achievement {
            condition furnished_payee_statement(payer, recipient, y, ReportableDeathBenefitsReturn6050Y);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(payer, recipient, y, ReportableDeathBenefitsReturn6050Y);
}

@source(IRC_S6050Y_C, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the person required to make such return, and")
rule S6050YcStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, ReportableDeathBenefitsReturn6050Y);
    then required_statement_item(payer, y, ReportableDeathBenefitsReturn6050Y, I6050Y_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, ReportableDeathBenefitsReturn6050Y, I6050Y_InformationShownOnReturnForEachRecipient);
}

relation consideration_transferred_in_sale(sale: us.irc.core::Asset, cash: Money, other_fmv: Money) kind empirical {
    label en unofficial "the amount of cash and the fair market value of any consideration transferred in the sale";
}

relation payment_for_reportable_policy_sale(sale: us.irc.core::Asset, amount: Money) kind institutional {
    label en unofficial "section 6050Y(d)(1): the payment is the cash plus the fair market value of any consideration transferred";
}

@source(IRC_S6050Y_D, relation = formalizes, coverage = exact, quote = "The term \"payment\" means, with respect to any reportable policy sale, the amount of cash and the fair market value of any consideration transferred in the sale.")
rule S6050Yd1PaymentAmount strict {
    for sale: us.irc.core::Asset;
    for cash: Money;
    for other: Money;
    when consideration_transferred_in_sale(sale, cash, other);
    then payment_for_reportable_policy_sale(sale, cash + other);
}

relation life_insurance_company_bears_risk_on_return_date(company: Person, contract: us.irc.core::Asset, d: Date) kind empirical {
    label en unofficial "the life insurance company bears the risk on the contract on the date any return or statement is required";
}

relation issuer_6050y(company: Person, contract: us.irc.core::Asset, d: Date) kind institutional {
    label en unofficial "section 6050Y(d)(3): the issuer";
}

@source(IRC_S6050Y_D, relation = formalizes, coverage = exact, quote = "The term \"issuer\" means any life insurance company that bears the risk with respect to a life insurance contract on the date any return or statement is required to be made under this section.")
rule S6050Yd3Issuer strict {
    for company: Person;
    for contract: us.irc.core::Asset;
    for d: Date;
    when life_insurance_company_bears_risk_on_return_date(company, contract, d);
    then issuer_6050y(company, contract, d);
}

// ============================================================================
// §6050Z — certified long-term care insurance premium statements
// ============================================================================

relation issuer_provides_ltc_premium_statement(issuer: Person, purchaser: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the issuer of certified long-term care insurance (section 401(a)(39)(C)) provides a long-term care premium statement to the purchaser pursuant to section 401(a)(39)(E) for the calendar year; the date is the distribution/statement date the effective-date note keys on";
}

relation ltc_return_filed(issuer: Person, purchaser: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the issuer made the section 6050Z return";
}

@source(IRC_S6050Z_A, relation = formalizes, coverage = exact, quote = "shall make a return not later than February 1 of the succeeding calendar year, according to forms or regulations prescribed by the Secretary, setting forth with respect to each such purchaser—")
rule S6050ZaReturnDuty defeasible {
    for issuer: Person;
    for purchaser: Person;
    for y: TaxableYear;
    for d: Date;
    for end_date: Date;
    when issuer_provides_ltc_premium_statement(issuer, purchaser, y, d);
    when d > @2025-12-29;
    when us.irc.core::ends(y, end_date);
    then duty MakeLongTermCareInsuranceReturn {
        bearer issuer;
        beneficiary Secretary;
        goal achievement {
            condition ltc_return_filed(issuer, purchaser, y);
            window [-infinity, add_calendar_period(end_date, 32 calendar_day)];
        }
    };
    then information_return_required(issuer, purchaser, y, CertifiedLongTermCareInsuranceReturn6050Z);
}

@source(IRC_S6050Z_A, relation = formalizes, coverage = exact, quote = "the name and taxpayer identification number of such issuer,")
rule S6050ZaReturnContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, CertifiedLongTermCareInsuranceReturn6050Z);
    then required_return_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_NameAndTinOfIssuer);
    then required_return_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_StatementCoverageIsCertifiedLongTermCareInsurance);
    then required_return_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_NameOfOwnerOfCoverage);
    then required_return_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_IdentificationOfIndividualCoveredAndRelationshipToOwner);
    then required_return_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_PremiumsPaidForCalendarYear);
    then required_return_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_OtherInformationRequired);
}

@source(IRC_S6050Z_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the individual or individuals on or before January 31 of the year following the calendar year for which the return required under subsection (a) was required to be made.")
rule S6050ZStatementDue defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, CertifiedLongTermCareInsuranceReturn6050Z);
    when us.irc.core::ends(y, end_date);
    then payee_statement_due(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day));
}

@source(IRC_S6050Z_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each individual whose name is required to be set forth in such return a written statement showing—")
rule S6050ZStatementDuty defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when information_return_required(payer, payee, y, CertifiedLongTermCareInsuranceReturn6050Z);
    when us.irc.core::ends(y, end_date);
    then duty FurnishLongTermCareInsuranceStatement {
        bearer payer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(payer, payee, y, CertifiedLongTermCareInsuranceReturn6050Z);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
    then payee_statement_required(payer, payee, y, CertifiedLongTermCareInsuranceReturn6050Z);
}

@source(IRC_S6050Z_B, relation = formalizes, coverage = partial, quote = "the name, address, and phone number of the information contact of the issuer of the contract or coverage, and")
rule S6050ZbStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, CertifiedLongTermCareInsuranceReturn6050Z);
    then required_statement_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_InformationContactNameAddressPhone);
    then required_statement_item(payer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_AggregatePremiumsAndChargesPaidForInsured);
}

relation coverage_covers_more_than_one_insured(issuer: Person, purchaser: Person, y: TaxableYear) kind empirical {
    label en unofficial "the contract or coverage covers more than one insured";
}

@source(IRC_S6050Z_C, relation = formalizes, coverage = exact, quote = "the return and statement required by subsections (a) and (b) shall identify only the portion of the premium that is properly allocable to the insured in respect of whom the return or statement is made.")
rule S6050ZcAllocationOfPremium defeasible {
    for issuer: Person;
    for purchaser: Person;
    for y: TaxableYear;
    when information_return_required(issuer, purchaser, y, CertifiedLongTermCareInsuranceReturn6050Z);
    when coverage_covers_more_than_one_insured(issuer, purchaser, y);
    then required_return_item(issuer, y, CertifiedLongTermCareInsuranceReturn6050Z, I6050Z_OnlyPremiumPortionAllocableToTheInsured);
}

relation individual_requests_early_return(issuer: Person, individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual requests that the return be furnished before the close of the calendar year";
}

relation early_return_and_copy_furnished(issuer: Person, individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the person furnished the return at that time and a copy to the Secretary";
}

@source(IRC_S6050Z_D, relation = formalizes, coverage = exact, quote = "the person required to make the return under subsection (b) shall comply with such request and shall furnish to the Secretary at such time a copy of the return so provided.")
rule S6050ZdEarlyFurnishingDuty defeasible {
    for issuer: Person;
    for individual: Person;
    for y: TaxableYear;
    when information_return_required(issuer, individual, y, CertifiedLongTermCareInsuranceReturn6050Z);
    when individual_requests_early_return(issuer, individual, y);
    then duty ComplyWithEarlyFurnishingRequest {
        bearer issuer;
        beneficiary individual;
        goal achievement {
            condition early_return_and_copy_furnished(issuer, individual, y);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6050S_B, relation = formalizes, coverage = partial, quote = "such other information as the Secretary may prescribe.")
rule S6050SbReturnContentOther defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, QualifiedTuitionPayments6050S);
    then required_return_item(payer, y, QualifiedTuitionPayments6050S, I6050S_OtherInformationTheSecretaryMayPrescribe);
}
