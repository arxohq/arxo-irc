// §6045 (returns of brokers), package `us.irc.information_reporting`,
// module 03. STAGE 1 FULL: (a) general duty, (b) February 15 customer
// statement, (g) basis-reporting content for covered securities ((g)(1),
// (2)(A) determination-method structure only, without the wash-sale/
// de-minimis-error refinements of (2)(B)(ii)-(iii)). (c)-(f) (definitions
// of "broker"/"customer"/digital-asset broker rules) and (h) (options on
// securities) stay `unreviewed`, stage 2.
//
// JUDGMENT CALLS
//  - §6045(a) reads "when required by the Secretary" — like §6041A's
//    return, the RETURN's own filing time is an EXTERNAL_DEPENDENCY
//    (Secretary's regulatory prescription); only the (b) customer
//    statement carries a literal statutory date (February 15).
//  - §6045(b)'s consolidated-reporting-statement sentence (a January 31
//    item folded into a February 15 consolidated statement) is modeled as
//    a defeasible override of a general "would otherwise be January 31"
//    fact, matching the returns package's `unless`-over-general-rule
//    idiom, rather than as a second independent due date.
//  - §6045(g)(2)(B)'s basis-determination method is modeled as a
//    classification (`basis_determination_method`) over two enum values
//    (FifoUnlessIdentified, BrokerDefaultUnlessElected) keyed to whether an
//    average-basis method is permissible for the security — the customer's
//    actual identification/election is an empirical fact this package
//    reads, not computed. (2)(B)(ii) (wash-sale exception) and (2)(B)(iii)
//    (de minimis error tolerance under §§6721(c)(3)/6722(c)(3), owner
//    `penalties`) stay `unreviewed`, stage 2 — flagged as EXTERNAL_
//    DEPENDENCY rather than silently folded into the general rule.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6045_A,
    IRC_S6045_B,
    IRC_S6045_G,
    InformationReturnKind,
    Person,
    Secretary,
    TaxableYear,
    broker_statement_required,
    filed_information_return,
    furnished_payee_statement,
    information_return_required,
    payee_statement_required,
};

// ============================================================================
// §6045(a) — General rule (broker returns)
// ============================================================================

relation is_broker(broker: Person) kind institutional {
    label en unofficial "the person does business as a broker (pending: `us.irc.definitions`/§6045(c), not this package's norm — a case asserting a broker return is at issue is asserting this classification by construction)";
}
relation secretary_requires_broker_return(broker: Person, customer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary requires the broker return for this customer and year (§6045(a): 'when required by the Secretary')";
}
@source(IRC_S6045_A, relation = formalizes, coverage = exact, quote = "Every person doing business as a broker shall, when required by the Secretary, make a return, in accordance with such regulations as the Secretary may prescribe, showing the name and address of each customer, with such details regarding gross proceeds and such other information as the Secretary may by forms or regulations require with respect to such business.")
rule S6045BrokerReturnDuty defeasible {
    for broker: Person;
    for customer: Person;
    for y: TaxableYear;
    when is_broker(broker) and secretary_requires_broker_return(broker, customer, y);
    then duty MakeBrokerReturn {
        bearer broker;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(broker, customer, y, BrokerProceeds6045);
            window [-infinity, infinity];
        }
    };
    then information_return_required(broker, customer, y, BrokerProceeds6045);
}

// ============================================================================
// §6045(b) — Statements to be furnished to customers (February 15)
// ============================================================================

@source(IRC_S6045_B, relation = formalizes, coverage = exact, quote = "Every person required to make a return under subsection (a) shall furnish to each customer whose name is required to be set forth in such return a written statement showing—")
rule S6045CustomerStatementDuty defeasible {
    for broker: Person;
    for customer: Person;
    for y: TaxableYear;
    when information_return_required(broker, customer, y, BrokerProceeds6045);
    then duty FurnishBrokerStatement {
        bearer broker;
        beneficiary customer;
        goal achievement {
            condition furnished_payee_statement(broker, customer, y, BrokerProceeds6045);
            window [-infinity, infinity];
        }
    };
    then payee_statement_required(broker, customer, y, BrokerProceeds6045);
    then broker_statement_required(broker, customer, y);
}

pub relation broker_statement_due(broker: Person, customer: Person, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "the statutory date by which the §6045(b) written statement must be furnished to the customer (February 15 — the 15th day of the 2nd month following the close of the calendar year; the consolidated-reporting-statement variant of the last sentence is not separately computed, see coverage row)";
}
@source(IRC_S6045_B, relation = formalizes, coverage = exact, quote = "The written statement required under the preceding sentence shall be furnished to the customer on or before February 15 of the year following the calendar year for which the return under subsection (a) was required to be made.")
rule S6045StatementDueFebruary15 defeasible {
    for broker: Person;
    for customer: Person;
    for y: TaxableYear;
    for end_date: Date;
    when payee_statement_required(broker, customer, y, BrokerProceeds6045);
    when us.irc.core::ends(y, end_date);
    then broker_statement_due(broker, customer, y, add_calendar_period(add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 1 calendar_month), 14 calendar_day));
}
// The last sentence's consolidated-reporting-statement variant ("any
// statement which would otherwise be required ... on or before January 31
// ... shall instead be required ... on or before February 15 ... if
// furnished with such consolidated reporting statement") folds an
// otherwise-January-31 item INTO this same February 15 date; it does not
// need a separate rule because this package gives brokers no independent
// January-31 statement duty of their own to fold — flagged in the coverage
// row as a partial-coverage item (`consolidated_reporting_statement` above
// is declared but not yet wired to a second duty).
relation consolidated_reporting_statement(broker: Person, customer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the statement is furnished as part of a consolidated reporting statement (as defined in regulations) with respect to the customer (§6045(b), last sentence)";
}

// ============================================================================
// §6045(g) — Additional information for securities transactions (basis
// reporting for covered securities)
// ============================================================================

relation is_covered_security(broker: Person, customer: Person, security: us.irc.core::Asset) kind institutional {
    label en unofficial "the security is a covered security under §6045(g)(3) (acquired on or after the applicable date in the account, or transferred in with a §6045A statement) — pending: acquisition-date/transfer classification not further tested by this stage";
}
relation sale_of_covered_security(broker: Person, customer: Person, security: us.irc.core::Asset, y: TaxableYear) kind empirical;
@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "If a broker is otherwise required to make a return under subsection (a) with respect to the gross proceeds of the sale of a covered security, the broker shall include in such return the information described in paragraph (2).")
rule S6045CoveredSecurityBasisReportingDuty defeasible {
    for broker: Person;
    for customer: Person;
    for security: us.irc.core::Asset;
    for y: TaxableYear;
    when information_return_required(broker, customer, y, BrokerProceeds6045) and is_covered_security(broker, customer, security) and sale_of_covered_security(broker, customer, security, y);
    then covered_security_basis_reporting_required(broker, customer, security, y);
}
relation covered_security_basis_reporting_required(broker: Person, customer: Person, security: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en unofficial "the broker's return must include the customer's adjusted basis in the covered security and whether gain/loss is long-term or short-term (§6045(g)(2)(A))";
}

pub enum BasisDeterminationMethod {
    FirstInFirstOutUnlessIdentified;
    BrokerDefaultUnlessCustomerElects;
}
relation average_basis_method_permissible(security: us.irc.core::Asset) kind institutional {
    label en unofficial "the security is stock for which an average basis method is permissible under §1012 (pending: `property-transactions`, not this package's norm)";
}
relation basis_determination_at_issue(security: us.irc.core::Asset) kind empirical {
    label en unofficial "positive anchor: the customer's adjusted basis in the security is being determined for section 6045(g)(2)(B)";
}
relation customer_makes_adequate_identification(customer: Person, security: us.irc.core::Asset) kind empirical;
relation customer_elects_another_acceptable_method(customer: Person, security: us.irc.core::Asset) kind empirical;
relation basis_determination_method(security: us.irc.core::Asset, method: BasisDeterminationMethod) kind institutional;
@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "in the case of any security (other than any stock for which an average basis method is permissible under section 1012), in accordance with the first-in first-out method unless the customer notifies the broker by means of making an adequate identification of the stock sold or transferred, and")
rule S6045BasisMethodFifoDefault defeasible {
    for customer: Person;
    for security: us.irc.core::Asset;
    when basis_determination_at_issue(security);
    when not_known(average_basis_method_permissible(security));
    then basis_determination_method(security, FirstInFirstOutUnlessIdentified);
    unless customer_makes_adequate_identification(customer, security);
}
@source(IRC_S6045_G, relation = formalizes, coverage = exact, quote = "in the case of any stock for which an average basis method is permissible under section 1012, in accordance with the broker's default method unless the customer notifies the broker that he elects another acceptable method under section 1012 with respect to the account in which such stock is held.")
rule S6045BasisMethodBrokerDefault defeasible {
    for customer: Person;
    for security: us.irc.core::Asset;
    when average_basis_method_permissible(security);
    then basis_determination_method(security, BrokerDefaultUnlessCustomerElects);
    unless customer_elects_another_acceptable_method(customer, security);
}
