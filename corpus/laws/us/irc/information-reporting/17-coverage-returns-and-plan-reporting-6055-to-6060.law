// §6055 - §6060 of package `us.irc.information_reporting`, module 17
// (STAGE 2): health coverage returns (§6055, §6056) with their content,
// alternative statement delivery and electronic consent; pension plan
// registration, annual return, actuarial report (§§6057-6059); the tax
// return preparer list return (§6060).
//
// JUDGMENT CALLS
//  - The 2024 amendments (Pub. L. 118-167 section 2, Pub. L. 118-168
//    sections 2 and 3) apply from the coverage year whose statements are due
//    after December 31, 2024 (year ending on or after 2024-12-31); the three
//    notes are read together for the alternative manner of furnishing
//    statements (§6055(c)(3), §6056(c)(3)) and electronic consent.
//  - Statements furnished in the alternative manner are recorded as
//    "treated as timely furnished" (an institutional conclusion); the
//    stage-1 statement duty is not defeated by it (no fact shows the
//    statement itself was furnished).
//  - The "each third plan year" recurrence of §6059(a) needs an index
//    modulo three over plan years; it is asserted by a case fact (TECH-GAPS).
//  - §6060(c)'s July 1 anchor is asserted by a case fact (no date-part
//    primitive); the stage-1 December 31 due-date formula is corrected to the
//    statutory return period (July 1 to June 30, due July 31).

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    IRC_S6055_B,
    IRC_S6055_C,
    IRC_S6055_D,
    IRC_S6056_B,
    IRC_S6056_C,
    IRC_S6056_D,
    IRC_S6056_E,
    IRC_S6057_A,
    IRC_S6057_B,
    IRC_S6057_D,
    IRC_S6057_E,
    IRC_S6057_F,
    IRC_S6057_G,
    IRC_S6058_A,
    IRC_S6058_B,
    IRC_S6058_C,
    IRC_S6058_D,
    IRC_S6058_E,
    IRC_S6058_F,
    IRC_S6059_A,
    IRC_S6059_B,
    IRC_S6060_A,
    IRC_S6060_C,
    Individual,
    InformationReturnKind,
    Period,
    Person,
    ReturnItem,
    Secretary,
    TaxableYear,
    designated_officer_for_return,
    employs_tax_return_preparer,
    filed_information_return,
    furnished_payee_statement,
    governmental_unit,
    information_return_required,
    is_administrator_of_412_defined_benefit_plan,
    is_applicable_large_employer_subject_to_4980h,
    is_full_time_employee_of,
    is_plan_administrator_of_erisa_vesting_plan,
    maintains_funded_deferred_compensation_plan,
    payee_statement_required,
    required_return_item,
    required_statement_item,
};

// ============================================================================
// §6055 — return content, alternative statement manner, electronic consent, government coverage
// ============================================================================

relation coverage_is_health_insurance_coverage_6055(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the minimum essential coverage provided to the individual consists of health insurance coverage";
}

relation coverage_is_qualified_health_plan_through_exchange(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the coverage is a qualified health plan offered through an Exchange established under section 1311 of the Patient Protection and Affordable Care Act";
}

relation coverage_is_issuer_group_health_plan_of_employer(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the coverage is health insurance coverage of a health insurance issuer provided through a group health plan of an employer";
}

relation coverage_is_small_group_qualified_health_plan_through_exchange(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the coverage is a qualified health plan in the small group market offered through an Exchange";
}

@source(IRC_S6055_B, relation = formalizes, coverage = exact, quote = "the name, address and TIN of the primary insured and the name and TIN of each other individual obtaining coverage under the policy,")
rule S6055bReturnContentNames defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_NameAddressTinOfPrimaryInsured);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_NameAndTinOfEachOtherIndividualCovered);
}

@source(IRC_S6055_B, relation = formalizes, coverage = exact, quote = "the dates during which such individual was covered under minimum essential coverage during the calendar year,")
rule S6055bReturnContentDates defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_DatesOfCoverageDuringCalendarYear);
}

@source(IRC_S6055_B, relation = formalizes, coverage = exact, quote = "whether or not the coverage is a qualified health plan offered through an Exchange established under section 1311 of the Patient Protection and Affordable Care Act, and")
rule S6055bReturnContentExchangeStatus defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when coverage_is_health_insurance_coverage_6055(payer, payee, y);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_WhetherQualifiedHealthPlanOfferedThroughExchange);
}

@source(IRC_S6055_B, relation = formalizes, coverage = exact, quote = "in the case of a qualified health plan, the amount (if any) of any advance payment under section 1412")
rule S6055bReturnContentAdvancePayments defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when coverage_is_qualified_health_plan_through_exchange(payer, payee, y);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_AdvancePaymentOfCostSharingReductionOrPremiumTaxCredit);
}

@source(IRC_S6055_B, relation = formalizes, coverage = partial, quote = "such other information as the Secretary may require.")
rule S6055bReturnContentOther defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_OtherInformationTheSecretaryMayRequire);
}

@source(IRC_S6055_B, relation = formalizes, coverage = exact, quote = "the name, address, and employer identification number of the employer maintaining the plan,")
rule S6055bEmployerCoverageEmployer defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when coverage_is_issuer_group_health_plan_of_employer(payer, payee, y);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_NameAddressAndEinOfEmployerMaintainingPlan);
}

@source(IRC_S6055_B, relation = formalizes, coverage = exact, quote = "the portion of the premium (if any) required to be paid by the employer, and")
rule S6055bEmployerCoveragePremium defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when coverage_is_issuer_group_health_plan_of_employer(payer, payee, y);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_PortionOfPremiumRequiredToBePaidByEmployer);
}

@source(IRC_S6055_B, relation = formalizes, coverage = partial, quote = "such other information as the Secretary may require for administration of the credit under section 45R")
rule S6055bEmployerCoverage45R defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when coverage_is_issuer_group_health_plan_of_employer(payer, payee, y) and coverage_is_small_group_qualified_health_plan_through_exchange(payer, payee, y);
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_InformationRequiredForAdministrationOfSection45RCredit);
}

external judgment relation secretary_allows_name_and_date_of_birth_in_lieu_of_tin(provider: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary allows the full name and date of birth of an individual to be substituted for the name and TIN where the person required to make the return is unable to collect the TIN (a judgment of the Secretary; none is pinned)";
}

relation unable_to_collect_tin_6055(payer: Person, payee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person required to make the return is unable to collect the individual's TIN";
}

@source(IRC_S6055_B, relation = formalizes, coverage = exact, quote = "if the person required to make a return under such subsection is unable to collect information on the TINs of such individuals, the Secretary may allow the individual's full name and date of birth to be substituted for the name and TIN.")
rule S6055bTinSubstitution defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for e: Date;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when unable_to_collect_tin_6055(payer, payee, y);
    when secretary_allows_name_and_date_of_birth_in_lieu_of_tin(payer, y);
    when us.irc.core::ends(y, e);
    when e >= @2024-12-31;
    then required_return_item(payer, y, MinimumEssentialCoverage6055, I6055_FullNameAndDateOfBirthInLieuOfTin);
}

@source(IRC_S6055_C, relation = formalizes, coverage = exact, quote = "the name and address of the person required to make such return and the phone number of the information contact for such person, and")
rule S6055cStatementContentContact defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, MinimumEssentialCoverage6055);
    then required_statement_item(payer, y, MinimumEssentialCoverage6055, I6055_NameAddressOfProviderAndPhoneOfInformationContact);
}

@source(IRC_S6055_C, relation = formalizes, coverage = exact, quote = "the information required to be shown on the return with respect to such individual.")
rule S6055cStatementContentReturnInformation defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, MinimumEssentialCoverage6055);
    then required_statement_item(payer, y, MinimumEssentialCoverage6055, I6055_InformationShownOnReturnWithRespectToIndividual);
}

relation alternative_statement_notice_provided(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind) kind empirical {
    label en unofficial "the person provided clear, conspicuous and accessible notice (at the time and in the manner the Secretary provides) that any individual may request a copy of the statement";
}

relation statement_copy_requested_on(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind, d: Date) kind empirical {
    label en unofficial "the individual requested a copy of the statement on this date";
}

relation statement_copy_furnished_on(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind, d: Date) kind empirical {
    label en unofficial "the person furnished a copy of the statement to the individual on this date";
}

relation statement_treated_as_timely_furnished(payer: Person, payee: Person, y: TaxableYear, kind: InformationReturnKind) kind institutional {
    label en unofficial "the alternative manner of furnishing statements: the person is treated as timely furnishing the statement (sections 6055(c)(3), 6056(c)(3))";
}

@source(IRC_S6055_C, relation = formalizes, coverage = exact, quote = "January 31 of the year following the calendar year for which the return under subsection (a) was required to be made, or")
rule S6055c3TimelyByJanuary31 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for d: Date;
    for e: Date;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when alternative_statement_notice_provided(payer, payee, y, MinimumEssentialCoverage6055);
    when statement_copy_furnished_on(payer, payee, y, MinimumEssentialCoverage6055, d);
    when us.irc.core::ends(y, e);
    when e >= @2024-12-31;
    when d <= add_calendar_period(add_calendar_period(e, 1 calendar_day), 30 calendar_day);
    then statement_treated_as_timely_furnished(payer, payee, y, MinimumEssentialCoverage6055);
}

@source(IRC_S6055_C, relation = formalizes, coverage = exact, quote = "30 days after the date of such request.")
rule S6055c3TimelyWithin30DaysOfRequest defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for d: Date;
    for r: Date;
    for e: Date;
    when information_return_required(payer, payee, y, MinimumEssentialCoverage6055);
    when alternative_statement_notice_provided(payer, payee, y, MinimumEssentialCoverage6055);
    when statement_copy_requested_on(payer, payee, y, MinimumEssentialCoverage6055, r);
    when statement_copy_furnished_on(payer, payee, y, MinimumEssentialCoverage6055, d);
    when us.irc.core::ends(y, e);
    when e >= @2024-12-31;
    when d <= add_calendar_period(r, 30 calendar_day);
    then statement_treated_as_timely_furnished(payer, payee, y, MinimumEssentialCoverage6055);
}

relation individual_consented_to_electronic_statement(payee: Person, payer: Person) kind empirical {
    label en unofficial "the individual affirmatively consented at any prior time to the person required to make the statement to receive it in electronic form";
}

relation individual_revoked_electronic_consent_in_writing(payee: Person, payer: Person) kind empirical {
    label en unofficial "the individual revoked the consent in writing";
}

relation deemed_consented_to_electronic_statement(payer: Person, payee: Person, y: TaxableYear) kind institutional {
    label en unofficial "the individual is deemed to have consented to receive the statement in electronic form (sections 6055(c)(3), 6056(c)(3))";
}

@source(IRC_S6055_C, relation = formalizes, coverage = exact, quote = "An individual shall be deemed to have consented to receive the statement under this subsection in electronic form if such individual has affirmatively consented at any prior time, to the person required to make such statement, to receive such statement in electronic form.")
rule S6055c3ElectronicConsentDeemed defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for e: Date;
    when payee_statement_required(payer, payee, y, MinimumEssentialCoverage6055);
    when individual_consented_to_electronic_statement(payee, payer);
    when not_known(individual_revoked_electronic_consent_in_writing(payee, payer));
    when us.irc.core::ends(y, e);
    when e >= @2024-12-31;
    then deemed_consented_to_electronic_statement(payer, payee, y);
}

@source(IRC_S6055_D, relation = formalizes, coverage = exact, quote = "the officer or employee who enters into the agreement to provide such coverage (or the person appropriately designated for purposes of this section) shall make the returns and statements required by this section.")
rule S6055dOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, MinimumEssentialCoverage6055);
    when information_return_required(unit, payee, y, MinimumEssentialCoverage6055);
    then duty MakeMinimumEssentialCoverageReturnAsGovernmentOfficer {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, MinimumEssentialCoverage6055);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6055_D, relation = formalizes, coverage = exact, quote = "the officer or employee who enters into the agreement to provide such coverage (or the person appropriately designated for purposes of this section) shall make the returns and statements required by this section.")
rule S6055dOfficerStatementDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, MinimumEssentialCoverage6055);
    when payee_statement_required(unit, payee, y, MinimumEssentialCoverage6055);
    when us.irc.core::ends(y, end_date);
    then duty FurnishMinimumEssentialCoverageStatementAsGovernmentOfficer {
        bearer officer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(unit, payee, y, MinimumEssentialCoverage6055);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
}

// ============================================================================
// §6056 — applicable large employer health coverage: return content, combination, government
// ============================================================================

relation employer_certifies_offer_of_coverage(filer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer certifies that it offered its full-time employees (and their dependents) the opportunity to enroll in minimum essential coverage under an eligible employer-sponsored plan";
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "the name, date, and employer identification number of the employer,")
rule S6056bReturnContentEmployer defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_NameOfEmployer);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_DateOfReturn);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_EmployerIdentificationNumber);
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "a certification as to whether the employer offers to its full-time employees (and their dependents) the opportunity to enroll in minimum essential coverage under an eligible employer-sponsored plan")
rule S6056bReturnContentCertification defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_CertificationWhetherEmployerOffersCoverage);
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "the length of any waiting period")
rule S6056bReturnContentWaitingPeriod defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    when employer_certifies_offer_of_coverage(filer, y);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_LengthOfWaitingPeriod);
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "the months during the calendar year for which coverage under the plan was available,")
rule S6056bReturnContentMonthsAvailable defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    when employer_certifies_offer_of_coverage(filer, y);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_MonthsCoverageWasAvailable);
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "the monthly premium for the lowest cost option in each of the enrollment categories under the plan, and")
rule S6056bReturnContentMonthlyPremium defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    when employer_certifies_offer_of_coverage(filer, y);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_MonthlyPremiumOfLowestCostOptionPerEnrollmentCategory);
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "the employer share of the total allowed costs of benefits provided under the plan,")
rule S6056bReturnContentEmployerShare defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    when employer_certifies_offer_of_coverage(filer, y);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_EmployerShareOfTotalAllowedCosts);
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "the number of full-time employees for each month during the calendar year,")
rule S6056bReturnContentFullTimeCount defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_NumberOfFullTimeEmployeesForEachMonth);
}

@source(IRC_S6056_B, relation = formalizes, coverage = exact, quote = "the name, address, and TIN of each full-time employee during the calendar year and the months (if any) during which such employee (and any dependents) were covered under any such health benefits plans, and")
rule S6056bReturnContentEmployees defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_NameAddressTinOfEachFullTimeEmployeeAndMonthsCovered);
}

@source(IRC_S6056_B, relation = formalizes, coverage = partial, quote = "such other information as the Secretary may require.")
rule S6056bReturnContentOther defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ApplicableLargeEmployerHealthCoverage6056);
    then required_return_item(filer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_OtherInformationTheSecretaryMayRequire);
}

@source(IRC_S6056_C, relation = formalizes, coverage = exact, quote = "the name and address of the person required to make such return and the phone number of the information contact for such person, and")
rule S6056cStatementContentContact defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    then required_statement_item(payer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_NameAddressOfEmployerAndPhoneOfInformationContact);
}

@source(IRC_S6056_C, relation = formalizes, coverage = exact, quote = "the information required to be shown on the return with respect to such individual.")
rule S6056cStatementContentReturnInformation defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    then required_statement_item(payer, y, ApplicableLargeEmployerHealthCoverage6056, I6056_InformationShownOnReturnWithRespectToEmployee);
}

@source(IRC_S6056_C, relation = formalizes, coverage = exact, quote = "January 31 of the year following the calendar year for which the return under subsection (a) was required to be made, or")
rule S6056c3TimelyByJanuary31 defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for d: Date;
    for e: Date;
    when information_return_required(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    when alternative_statement_notice_provided(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    when statement_copy_furnished_on(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056, d);
    when us.irc.core::ends(y, e);
    when e >= @2024-12-31;
    when d <= add_calendar_period(add_calendar_period(e, 1 calendar_day), 30 calendar_day);
    then statement_treated_as_timely_furnished(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
}

@source(IRC_S6056_C, relation = formalizes, coverage = exact, quote = "30 days after the date of such request.")
rule S6056c3TimelyWithin30DaysOfRequest defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    for d: Date;
    for r: Date;
    for e: Date;
    when information_return_required(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    when alternative_statement_notice_provided(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    when statement_copy_requested_on(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056, r);
    when statement_copy_furnished_on(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056, d);
    when us.irc.core::ends(y, e);
    when e >= @2024-12-31;
    when d <= add_calendar_period(r, 30 calendar_day);
    then statement_treated_as_timely_furnished(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
}

@source(IRC_S6056_C, relation = formalizes, coverage = exact, quote = "An individual shall be deemed to have consented to receive the statement under this subsection in electronic form if such individual has affirmatively consented at any prior time, to the person who is the employer of the individual during the calendar year to which the statement relates, to receive such statement in electronic form.")
rule S6056c3ElectronicConsentDeemed defeasible {
    for payer: Person;
    for payee: Individual;
    for y: TaxableYear;
    for e: Date;
    when payee_statement_required(payer, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    when is_full_time_employee_of(payee, payer, y);
    when individual_consented_to_electronic_statement(payee, payer);
    when not_known(individual_revoked_electronic_consent_in_writing(payee, payer));
    when us.irc.core::ends(y, e);
    when e >= @2024-12-31;
    then deemed_consented_to_electronic_statement(payer, payee, y);
}

external judgment relation secretary_provides_combined_reporting_option(employer: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary provides, to the maximum extent feasible, that the section 6056 return or statement may be provided as part of a return or statement under section 6051 or 6055 (a judgment of the Secretary; regulations are not pinned)";
}

relation combined_reporting_permitted_6056(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the section 6056 return or statement may be provided as part of a section 6051 or 6055 return or statement";
}

@source(IRC_S6056_D, relation = formalizes, coverage = exact, quote = "any return or statement required to be provided under this section may be provided as part of any return or statement required under section 6051 or 6055, and")
rule S6056d1CombinedReporting defeasible {
    for employer: Person;
    for y: TaxableYear;
    when secretary_provides_combined_reporting_option(employer, y);
    when is_applicable_large_employer_subject_to_4980h(employer, y);
    then combined_reporting_permitted_6056(employer, y);
}

external judgment relation secretary_provides_issuer_agreement_option(employer: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary provides that an applicable large employer offering issuer coverage may agree with the issuer to include the section 6056 information with the issuer's section 6055 return and statement";
}

relation offers_issuer_health_insurance_coverage(employer: Person, issuer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer offers health insurance coverage of a health insurance issuer";
}

relation agreement_with_issuer_to_include_6056_information(employer: Person, issuer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer and the issuer agreed that the issuer includes the section 6056 information with its section 6055 return and statement";
}

relation issuer_reporting_of_6056_information_permitted(employer: Person, issuer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the employer may satisfy the section 6056 reporting by the issuer's section 6055 return and statement";
}

@source(IRC_S6056_D, relation = formalizes, coverage = exact, quote = "the employer may enter into an agreement with the issuer to include information required under this section with the return and statement required to be provided by the issuer under section 6055.")
rule S6056d2IssuerAgreement defeasible {
    for employer: Person;
    for issuer: Person;
    for y: TaxableYear;
    when secretary_provides_issuer_agreement_option(employer, y);
    when is_applicable_large_employer_subject_to_4980h(employer, y);
    when offers_issuer_health_insurance_coverage(employer, issuer, y);
    when agreement_with_issuer_to_include_6056_information(employer, issuer, y);
    then issuer_reporting_of_6056_information_permitted(employer, issuer, y);
}

@source(IRC_S6056_E, relation = formalizes, coverage = exact, quote = "the person appropriately designated for purposes of this section shall make the returns and statements required by this section.")
rule S6056eOfficerReturnDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, ApplicableLargeEmployerHealthCoverage6056);
    when information_return_required(unit, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    then duty MakeApplicableLargeEmployerCoverageReturnAsGovernmentOfficer {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition filed_information_return(unit, payee, y, ApplicableLargeEmployerHealthCoverage6056);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6056_E, relation = formalizes, coverage = exact, quote = "the person appropriately designated for purposes of this section shall make the returns and statements required by this section.")
rule S6056eOfficerStatementDuty defeasible {
    for unit: Person;
    for officer: Person;
    for payee: Person;
    for y: TaxableYear;
    for end_date: Date;
    when governmental_unit(unit);
    when designated_officer_for_return(officer, unit, ApplicableLargeEmployerHealthCoverage6056);
    when payee_statement_required(unit, payee, y, ApplicableLargeEmployerHealthCoverage6056);
    when us.irc.core::ends(y, end_date);
    then duty FurnishApplicableLargeEmployerCoverageStatementAsGovernmentOfficer {
        bearer officer;
        beneficiary payee;
        goal achievement {
            condition furnished_payee_statement(unit, payee, y, ApplicableLargeEmployerHealthCoverage6056);
            window [-infinity, add_calendar_period(add_calendar_period(end_date, 1 calendar_day), 30 calendar_day)];
        }
    };
}

// ============================================================================
// §6057 — annual registration of plans with deferred vested benefits
// ============================================================================

relation is_multiple_employer_plan_6057(administrator: Person, y: TaxableYear) kind empirical {
    label en unofficial "more than one employer is required to contribute to the plan";
}

external judgment relation regulations_apply_6057_to_multiple_employer_plan(administrator: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "regulations prescribed under section 6057(f) extend the section to this plan to which more than one employer contributes (a judgment of the Secretary; none is pinned)";
}

relation multiple_employer_plan_outside_6057(administrator: Person, y: TaxableYear) kind institutional {
    label en unofficial "the plan has more than one contributing employer and the regulations do not extend section 6057 to it: the section does not apply";
}

@source(IRC_S6057_F, relation = formalizes, coverage = exact, quote = "This section shall apply to any plan to which more than one employer is required to contribute only to the extent provided in regulations prescribed under this subsection.")
rule S6057fMultipleEmployerPlanOutsideSection defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when is_multiple_employer_plan_6057(administrator, y);
    when not_known(regulations_apply_6057_to_multiple_employer_plan(administrator, y));
    then multiple_employer_plan_outside_6057(administrator, y);
}

relation administrator_of_403b_15_multiple_employer_plan(administrator: Person, y: TaxableYear) kind empirical {
    label en unofficial "the plan under which the section 403(b) annuity contracts are purchased meets the requirements of section 403(b)(15)";
}

relation plan_treated_as_single_plan_for_6057(administrator: Person, y: TaxableYear) kind institutional {
    label en unofficial "the 403(b) multiple employer plan is treated as a single plan for section 6057 (one registration by its administrator)";
}

@source(IRC_S6057_G, relation = formalizes, coverage = exact, quote = "such plan shall be treated as a single plan for purposes of this section.")
rule S6057gSingleMultipleEmployer403bPlan defeasible {
    for administrator: Person;
    for y: TaxableYear;
    for s: Date;
    when administrator_of_403b_15_multiple_employer_plan(administrator, y);
    when us.irc.core::begins(y, s);
    when s > @2022-12-31;
    then plan_treated_as_single_plan_for_6057(administrator, y);
}

@source(IRC_S6057_A, relation = formalizes, coverage = partial, quote = "shall file a registration statement with the Secretary.")
rule S6057aRegistrationStatementRequired defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when is_plan_administrator_of_erisa_vesting_plan(administrator, y);
    then information_return_required(administrator, Secretary, y, PensionPlanRegistrationStatement6057);
    unless multiple_employer_plan_outside_6057(administrator, y);
}

@source(IRC_S6057_A, relation = formalizes, coverage = exact, quote = "the name of the plan,")
rule S6057aContentPlanAndAdministrator defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, PensionPlanRegistrationStatement6057);
    then required_return_item(filer, y, PensionPlanRegistrationStatement6057, I6057_NameOfPlan);
}

@source(IRC_S6057_A, relation = formalizes, coverage = exact, quote = "the name and address of the plan administrator,")
rule S6057aContentAdministrator defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, PensionPlanRegistrationStatement6057);
    then required_return_item(filer, y, PensionPlanRegistrationStatement6057, I6057_NameAndAddressOfPlanAdministrator);
}

@source(IRC_S6057_A, relation = formalizes, coverage = exact, quote = "the nature, amount, and form of the deferred vested benefit to which such participant is entitled, and")
rule S6057aContentBenefit defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, PensionPlanRegistrationStatement6057);
    then required_return_item(filer, y, PensionPlanRegistrationStatement6057, I6057_NatureAmountAndFormOfDeferredVestedBenefit);
}

@source(IRC_S6057_A, relation = formalizes, coverage = partial, quote = "such other information as the Secretary may require.")
rule S6057aContentOther defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, PensionPlanRegistrationStatement6057);
    then required_return_item(filer, y, PensionPlanRegistrationStatement6057, I6057_OtherInformationTheSecretaryMayRequire);
}

@source(IRC_S6057_A, relation = formalizes, coverage = exact, quote = "the plan administrator shall furnish evidence satisfactory to the Secretary that he has complied with the requirement contained in subsection (e)")
rule S6057aContentEvidenceOfSubsectionE defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, PensionPlanRegistrationStatement6057);
    then required_return_item(filer, y, PensionPlanRegistrationStatement6057, I6057_EvidenceOfComplianceWithSubsectionE);
}

relation participant_separated_from_service_during_plan_year(administrator: Person, participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the participant separated from the service covered by the plan during the plan year";
}

relation participant_entitled_to_deferred_vested_benefit_at_year_end(administrator: Person, participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the participant is entitled to a deferred vested benefit under the plan as of the end of the plan year";
}

relation retirement_benefits_paid_to_participant_during_plan_year(administrator: Person, participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "retirement benefits were paid to the participant under the plan during the plan year";
}

relation participant_reportable_under_6057(administrator: Person, participant: Person, y: TaxableYear) kind institutional {
    label en unofficial "the participant is described in section 6057(a)(2)(C): named with TIN in the registration statement and entitled to the individual statement of subsection (e)";
}

@source(IRC_S6057_A, relation = formalizes, coverage = exact, quote = "the name and taxpayer identifying number of each participant in the plan—")
rule S6057aReportableParticipant defeasible {
    for administrator: Person;
    for participant: Person;
    for y: TaxableYear;
    when participant_separated_from_service_during_plan_year(administrator, participant, y);
    when participant_entitled_to_deferred_vested_benefit_at_year_end(administrator, participant, y);
    when not_known(retirement_benefits_paid_to_participant_during_plan_year(administrator, participant, y));
    then participant_reportable_under_6057(administrator, participant, y);
}

@source(IRC_S6057_A, relation = formalizes, coverage = exact, quote = "the name and taxpayer identifying number of each participant in the plan—")
rule S6057aContentParticipants defeasible {
    for filer: Person;
    for y: TaxableYear;
    for participant: Person;
    when information_return_required(filer, Secretary, y, PensionPlanRegistrationStatement6057);
    when participant_reportable_under_6057(filer, participant, y);
    then required_return_item(filer, y, PensionPlanRegistrationStatement6057, I6057_NameAndTinOfEachReportableParticipant);
}

relation registration_filing_deadline_6057(administrator: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the last day of the period after the end of the plan year that the Secretary prescribes by regulations for the registration statement (case fact: no regulation is pinned)";
}

relation filed_6057_participant_statement(administrator: Person, participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the plan administrator furnished the individual statement to the participant";
}

@source(IRC_S6057_E, relation = formalizes, coverage = partial, quote = "shall, before the expiration of the time prescribed for the filing of such registration statement, also furnish to each participant described in subsection (a)(2)(C) an individual statement setting forth the information with respect to such participant required to be contained in such registration statement.")
rule S6057eParticipantStatementDuty defeasible {
    for administrator: Person;
    for participant: Person;
    for y: TaxableYear;
    for d: Date;
    when information_return_required(administrator, Secretary, y, PensionPlanRegistrationStatement6057);
    when participant_reportable_under_6057(administrator, participant, y);
    when registration_filing_deadline_6057(administrator, y, d);
    then duty FurnishPlanParticipantIndividualStatement {
        bearer administrator;
        beneficiary participant;
        goal achievement {
            condition filed_6057_participant_statement(administrator, participant, y);
            window [-infinity, d];
        }
    };
    then payee_statement_required(administrator, participant, y, PensionPlanRegistrationStatement6057);
}

@source(IRC_S6057_E, relation = formalizes, coverage = exact, quote = "an individual statement setting forth the information with respect to such participant required to be contained in such registration statement.")
rule S6057eStatementContent defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PensionPlanRegistrationStatement6057);
    then required_statement_item(payer, y, PensionPlanRegistrationStatement6057, I6057_InformationWithRespectToParticipantRequiredInRegistrationStatement);
}

@source(IRC_S6057_E, relation = formalizes, coverage = exact, quote = "Such statement shall also include a notice to the participant of any benefits which are forfeitable if the participant dies before a certain date.")
rule S6057eStatementForfeitableNotice defeasible {
    for payer: Person;
    for payee: Person;
    for y: TaxableYear;
    when payee_statement_required(payer, payee, y, PensionPlanRegistrationStatement6057);
    then required_statement_item(payer, y, PensionPlanRegistrationStatement6057, I6057_NoticeOfBenefitsForfeitableIfParticipantDiesBeforeCertainDate);
}

enum PlanChange6057 {
    ChangeInNameOfPlan;
    ChangeInNameOrAddressOfPlanAdministrator;
    TerminationOfPlan;
    MergerConsolidationOrDivisionOfPlan;
}

relation plan_change_occurred(administrator: Person, y: TaxableYear, change: PlanChange6057) kind empirical {
    label en unofficial "the change occurred (section 6057(b)(1)-(4))";
}

relation notified_secretary_of_plan_change(administrator: Person, y: TaxableYear, change: PlanChange6057) kind empirical {
    label en unofficial "the plan administrator notified the Secretary of the change";
}

@source(IRC_S6057_B, relation = formalizes, coverage = partial, quote = "Any plan administrator required to register under subsection (a) shall also notify the Secretary, at such time as may be prescribed by regulations, of—")
rule S6057bChangeNotificationDuty defeasible {
    for administrator: Person;
    for y: TaxableYear;
    for change: PlanChange6057;
    when is_plan_administrator_of_erisa_vesting_plan(administrator, y);
    when plan_change_occurred(administrator, y, change);
    then duty NotifySecretaryOfPlanChange {
        bearer administrator;
        beneficiary Secretary;
        goal achievement {
            condition notified_secretary_of_plan_change(administrator, y, change);
            window [-infinity, infinity];
        }
    };
}

relation information_obtained_by_secretary_under_6057(y: TaxableYear) kind empirical {
    label en unofficial "the Secretary obtained statements, notifications, reports or other information under section 6057";
}

relation transmitted_6057_information_to_commissioner(y: TaxableYear) kind empirical {
    label en unofficial "the Secretary transmitted copies of the information to the Commissioner of Social Security";
}

const CommissionerOfSocialSecurity: Person = entity_ref("urn:us:irc:information_reporting:clir#CommissionerOfSocialSecurity");

@source(IRC_S6057_D, relation = formalizes, coverage = exact, quote = "The Secretary shall transmit copies of any statements, notifications, reports, or other information obtained by him under this section to the Commissioner of Social Security.")
rule S6057dTransmissionDuty defeasible {
    for y: TaxableYear;
    when information_obtained_by_secretary_under_6057(y);
    then duty TransmitSection6057InformationToCommissioner {
        bearer Secretary;
        beneficiary CommissionerOfSocialSecurity;
        goal achievement {
            condition transmitted_6057_information_to_commissioner(y);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6058 — annual returns of plans: employer definition, individual retirement plans, mergers
// ============================================================================

relation establishes_individual_retirement_plan(individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual establishes an individual retirement plan";
}

relation maintains_plan_as_person_described_in_401c4(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person described in section 401(c)(4) maintains a plan (pending: the section 401(c)(4) definition belongs to `deferred-compensation`)";
}

@source(IRC_S6058_C, relation = formalizes, coverage = partial, quote = "For purposes of this section, the term \"employer\" includes a person described in section 401(c)(4) and an individual who establishes an individual retirement plan.")
rule S6058cIraEstablisherIsEmployer defeasible {
    for individual: Person;
    for y: TaxableYear;
    when establishes_individual_retirement_plan(individual, y);
    then maintains_funded_deferred_compensation_plan(individual, y);
}

@source(IRC_S6058_C, relation = formalizes, coverage = partial, quote = "For purposes of this section, the term \"employer\" includes a person described in section 401(c)(4) and an individual who establishes an individual retirement plan.")
rule S6058cSection401c4PersonIsEmployer defeasible {
    for person: Person;
    for y: TaxableYear;
    when maintains_plan_as_person_described_in_401c4(person, y);
    then maintains_funded_deferred_compensation_plan(person, y);
}

relation tax_imposed_by_section_4973(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "a tax is imposed on the person for the year by section 4973";
}

relation tax_imposed_by_section_4974(person: Person, y: TaxableYear) kind empirical {
    label en unofficial "a tax is imposed on the person for the year by section 4974";
}

relation special_irp_tax_imposed(person: Person, y: TaxableYear) kind institutional {
    label en unofficial "a special IRP tax (section 4973 or 4974) is imposed for the year";
}

@source(IRC_S6058_E, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"special IRP tax\" means a tax imposed by—")
rule S6058eSpecialIrpTax4973 defeasible {
    for person: Person;
    for y: TaxableYear;
    when tax_imposed_by_section_4973(person, y);
    then special_irp_tax_imposed(person, y);
}

@source(IRC_S6058_E, relation = formalizes, coverage = exact, quote = "section 4974.")
rule S6058eSpecialIrpTax4974 defeasible {
    for person: Person;
    for y: TaxableYear;
    when tax_imposed_by_section_4974(person, y);
    then special_irp_tax_imposed(person, y);
}

enum IraActivity6058 {
    ContributionOtherThanRollover;
    RolloverContribution;
    Distribution;
    OtherPlanActivity;
}

relation ira_activity_of_kind(person: Person, y: TaxableYear, activity: IraActivity6058) kind empirical {
    label en unofficial "the individual retirement plan had this kind of activity during the year";
}

relation ira_activity_other_than_contributions_and_distributions(person: Person, y: TaxableYear) kind institutional {
    label en unofficial "plan activity other than the making of contributions (other than rollover contributions) and the making of distributions";
}

@source(IRC_S6058_D, relation = formalizes, coverage = exact, quote = "(A) the making of contributions (other than rollover contributions), and")
rule S6058dRolloverIsOtherActivity defeasible {
    for person: Person;
    for y: TaxableYear;
    when ira_activity_of_kind(person, y, RolloverContribution);
    then ira_activity_other_than_contributions_and_distributions(person, y);
}

@source(IRC_S6058_D, relation = formalizes, coverage = exact, quote = "(2) no plan activity other than—")
rule S6058dOtherActivity defeasible {
    for person: Person;
    for y: TaxableYear;
    when ira_activity_of_kind(person, y, OtherPlanActivity);
    then ira_activity_other_than_contributions_and_distributions(person, y);
}

relation exempt_from_6058_annual_return(person: Person, y: TaxableYear) kind institutional {
    label en unofficial "the individual who established an individual retirement plan is not required to file a section 6058 return for the year";
}

@source(IRC_S6058_D, relation = formalizes, coverage = exact, quote = "An individual who establishes an individual retirement plan shall not be required to file a return under this section with respect to such plan for any taxable year for which there is—")
rule S6058dIraExemption defeasible {
    for person: Person;
    for y: TaxableYear;
    when establishes_individual_retirement_plan(person, y);
    when not_known(special_irp_tax_imposed(person, y));
    when not_known(ira_activity_other_than_contributions_and_distributions(person, y));
    then exempt_from_6058_annual_return(person, y);
}

relation administrator_of_403b_15_multiple_employer_plan_6058(administrator: Person, y: TaxableYear) kind empirical {
    label en unofficial "the plan under which the section 403(b) annuity contracts are purchased meets the requirements of section 403(b)(15)";
}

relation plan_treated_as_single_plan_for_6058(administrator: Person, y: TaxableYear) kind institutional {
    label en unofficial "the 403(b) multiple employer plan is treated as a single plan for section 6058 (one annual return)";
}

@source(IRC_S6058_F, relation = formalizes, coverage = exact, quote = "such plan shall be treated as a single plan for purposes of this section.")
rule S6058fSingleMultipleEmployer403bPlan defeasible {
    for administrator: Person;
    for y: TaxableYear;
    for s: Date;
    when administrator_of_403b_15_multiple_employer_plan_6058(administrator, y);
    when us.irc.core::begins(y, s);
    when s > @2022-12-31;
    then plan_treated_as_single_plan_for_6058(administrator, y);
}

@source(IRC_S6058_A, relation = formalizes, coverage = partial, quote = "shall file an annual return stating such information as the Secretary may by regulations prescribe with respect to the qualification, financial conditions, and operations of the plan;")
rule S6058aAnnualReturnRequired defeasible {
    for employer: Person;
    for y: TaxableYear;
    when maintains_funded_deferred_compensation_plan(employer, y);
    then information_return_required(employer, Secretary, y, PensionPlanAnnualReturn6058);
    unless exempt_from_6058_annual_return(employer, y);
}

@source(IRC_S6058_A, relation = formalizes, coverage = partial, quote = "shall file an annual return stating such information as the Secretary may by regulations prescribe with respect to the qualification, financial conditions, and operations of the plan;")
rule S6058aContentPlanInformation defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, PensionPlanAnnualReturn6058);
    then required_return_item(filer, y, PensionPlanAnnualReturn6058, I6058_InformationOnQualificationFinancialConditionsAndOperationsOfPlan);
}

external judgment relation secretary_relieves_employer_from_stating_information_reported_elsewhere(employer: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "in the Secretary's discretion the employer is relieved from stating in its section 6058 return information that is reported in other returns";
}

relation employer_relieved_from_duplicative_6058_information(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the employer need not state in its return information reported in other returns";
}

@source(IRC_S6058_A, relation = formalizes, coverage = exact, quote = "except that, in the discretion of the Secretary, the employer may be relieved from stating in its return any information which is reported in other returns.")
rule S6058aReliefFromDuplicativeInformation defeasible {
    for employer: Person;
    for y: TaxableYear;
    when information_return_required(employer, Secretary, y, PensionPlanAnnualReturn6058);
    when secretary_relieves_employer_from_stating_information_reported_elsewhere(employer, y);
    then employer_relieved_from_duplicative_6058_information(employer, y);
}

relation plan_administrator_of_merging_plan(administrator: Person, merger_date: Date) kind empirical {
    label en unofficial "the plan administrator of a plan described in subsection (a) whose plan merges, consolidates or transfers assets or liabilities to another plan on this date";
}

relation filed_actuarial_statement_of_valuation_6058b(administrator: Person, merger_date: Date) kind empirical {
    label en unofficial "the plan administrator filed the actuarial statement of valuation evidencing compliance with section 401(a)(12)";
}

@source(IRC_S6058_B, relation = formalizes, coverage = exact, quote = "Not less than 30 days before a merger, consolidation, or transfer of assets or liabilities of a plan described in subsection (a) to another plan, the plan administrator (within the meaning of section 414(g)) shall file an actuarial statement of valuation evidencing compliance with the requirements of section 401(a)(12).")
rule S6058bMergerActuarialStatementDuty defeasible {
    for administrator: Person;
    for d: Date;
    for calendar_before_1: Date;
    when plan_administrator_of_merging_plan(administrator, d)
        and us.irc.core::civil_calendar_boundary_before(d, 30, us.irc.core::CalendarDay, calendar_before_1);
    then duty FileActuarialStatementBeforePlanMerger {
        bearer administrator;
        beneficiary Secretary;
        goal achievement {
            condition filed_actuarial_statement_of_valuation_6058b(administrator, d);
            window [-infinity, calendar_before_1];
        }
    };
}

// ============================================================================
// §6059 — actuarial report
// ============================================================================

relation first_plan_year_section_412_applies(administrator: Person, y: TaxableYear) kind empirical {
    label en unofficial "this is the first plan year for which section 412 applies to the defined benefit plan";
}

relation third_plan_year_after_prior_actuarial_report(administrator: Person, y: TaxableYear) kind institutional {
    label en unofficial "this plan year begins 3, 6, ... 39 years after the first plan year for which section 412 applies (derived in module 18; a case may still assert it directly)";
}

external judgment relation secretary_determines_more_frequent_actuarial_reports(administrator: Person, y: TaxableYear) {
    authority Secretary;
    label en unofficial "the Secretary determines that more frequent actuarial reports are necessary for the plan (a judgment of the Secretary)";
}

@source(IRC_S6059_A, relation = formalizes, coverage = partial, quote = "for the first plan year for which section 412 applies to the plan")
rule S6059aFirstPlanYear defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when first_plan_year_section_412_applies(administrator, y);
    then is_administrator_of_412_defined_benefit_plan(administrator, y);
}

@source(IRC_S6059_A, relation = formalizes, coverage = partial, quote = "and for each third plan year thereafter")
rule S6059aEveryThirdPlanYear defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when third_plan_year_after_prior_actuarial_report(administrator, y);
    then is_administrator_of_412_defined_benefit_plan(administrator, y);
}

@source(IRC_S6059_A, relation = formalizes, coverage = exact, quote = "(or more frequently if the Secretary determines that more frequent reports are necessary).")
rule S6059aMoreFrequentReports defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when secretary_determines_more_frequent_actuarial_reports(administrator, y);
    then is_administrator_of_412_defined_benefit_plan(administrator, y);
}

@source(IRC_S6059_A, relation = formalizes, coverage = partial, quote = "The actuarial report described in subsection (b) shall be filed by the plan administrator")
rule S6059aActuarialReportRequired defeasible {
    for administrator: Person;
    for y: TaxableYear;
    when is_administrator_of_412_defined_benefit_plan(administrator, y);
    then information_return_required(administrator, Secretary, y, ActuarialReport6059);
}

@source(IRC_S6059_B, relation = formalizes, coverage = exact, quote = "shall be prepared and signed by an enrolled actuary (within the meaning of section 7701(a)(35))")
rule S6059bContentSigned defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ActuarialReport6059);
    then required_return_item(filer, y, ActuarialReport6059, I6059_PreparedAndSignedByEnrolledActuary);
}

@source(IRC_S6059_B, relation = formalizes, coverage = exact, quote = "a description of the funding method and actuarial assumptions used to determine costs under the plan,")
rule S6059bContentFundingMethod defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ActuarialReport6059);
    then required_return_item(filer, y, ActuarialReport6059, I6059_DescriptionOfFundingMethodAndActuarialAssumptions);
}

@source(IRC_S6059_B, relation = formalizes, coverage = exact, quote = "a certification of the contribution necessary to reduce the minimum required contribution determined under section 430")
rule S6059bContentCertification defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ActuarialReport6059);
    then required_return_item(filer, y, ActuarialReport6059, I6059_CertificationOfContributionNecessaryToReduceDeficiencyToZero);
}

@source(IRC_S6059_B, relation = formalizes, coverage = exact, quote = "that to the best of his knowledge the report is complete and accurate, and")
rule S6059bContentStatement defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ActuarialReport6059);
    then required_return_item(filer, y, ActuarialReport6059, I6059_StatementReportIsCompleteAndAccurate);
}

@source(IRC_S6059_B, relation = formalizes, coverage = exact, quote = "that the requirements for reasonable actuarial assumptions under section 430(h)(1), 431(c)(3), or 433(c)(3), whichever are applicable, have been complied with,")
rule S6059bContentReasonableAssumptions defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ActuarialReport6059);
    then required_return_item(filer, y, ActuarialReport6059, I6059_StatementReasonableActuarialAssumptionsRequirementsComplied);
}

@source(IRC_S6059_B, relation = formalizes, coverage = exact, quote = "such other information as may be necessary to fully and fairly disclose the actuarial position of the plan, and")
rule S6059bContentActuarialPosition defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ActuarialReport6059);
    then required_return_item(filer, y, ActuarialReport6059, I6059_OtherInformationNecessaryToDiscloseActuarialPosition);
}

@source(IRC_S6059_B, relation = formalizes, coverage = partial, quote = "such other information regarding the plan as the Secretary may by regulations require.")
rule S6059bContentOther defeasible {
    for filer: Person;
    for y: TaxableYear;
    when information_return_required(filer, Secretary, y, ActuarialReport6059);
    then required_return_item(filer, y, ActuarialReport6059, I6059_OtherInformationTheSecretaryMayRequireByRegulations);
}

// ============================================================================
// §6060 — information returns of tax return preparers
// ============================================================================

relation begins_on_july_1_6060(period: Period) kind institutional {
    label en unofficial "the period begins on July 1 (derived in module 18 as six months after the first day of its calendar year; a case may still assert it directly)";
}

relation return_period_6060(period: Period) kind institutional {
    label en unofficial "the 12-month period beginning on July 1 of a year: a return period for section 6060";
}

@source(IRC_S6060_C, relation = formalizes, coverage = partial, quote = "For purposes of subsection (a), the term \"return period\" means the 12-month period beginning on July 1 of each year.")
rule S6060cReturnPeriod defeasible {
    for period: Period;
    for s: Date;
    for e: Date;
    when begins_on_july_1_6060(period);
    when us.irc.core::begins(period, s);
    when us.irc.core::ends(period, e);
    when add_calendar_period(s, 12 calendar_month) == add_calendar_period(e, 1 calendar_day);
    then return_period_6060(period);
}

relation acts_as_return_preparer(individual: Person, period: Period) kind empirical {
    label en unofficial "the individual acts as a tax return preparer during the period";
}

relation is_employee_of_another_return_preparer(individual: Person, period: Period) kind empirical {
    label en unofficial "the individual is the employee of another tax return preparer";
}

@source(IRC_S6060_A, relation = formalizes, coverage = exact, quote = "For purposes of this section, any individual who in acting as a tax return preparer is not the employee of another tax return preparer shall be treated as his own employer.")
rule S6060aSelfEmployedPreparerIsOwnEmployer defeasible {
    for individual: Person;
    for period: Period;
    when acts_as_return_preparer(individual, period);
    when not_known(is_employee_of_another_return_preparer(individual, period));
    then employs_tax_return_preparer(individual, individual, period);
}

external judgment relation secretary_approved_alternative_preparer_reporting(employer: Person, period: Period) {
    authority Secretary;
    label en unofficial "the Secretary approved an alternative reporting method in lieu of the section 6060 return, having determined that the necessary information is available to him from other sources";
}

relation required_preparer_list_item(employer: Person, period: Period, item: ReturnItem) kind institutional {
    label en unofficial "the section 6060 return must set forth this item for each tax return preparer employed";
}

@source(IRC_S6060_A, relation = formalizes, coverage = exact, quote = "shall make a return setting forth the name, taxpayer identification number, and place of work of each tax return preparer employed by him at any time during such period.")
rule S6060aReturnContent defeasible {
    for employer: Person;
    for preparer: Person;
    for period: Period;
    when employs_tax_return_preparer(employer, preparer, period);
    when return_period_6060(period);
    then required_preparer_list_item(employer, period, I6060_NameOfEachPreparerEmployed);
    then required_preparer_list_item(employer, period, I6060_TaxpayerIdentificationNumberOfEachPreparerEmployed);
    then required_preparer_list_item(employer, period, I6060_PlaceOfWorkOfEachPreparerEmployed);
    unless secretary_approved_alternative_preparer_reporting(employer, period);
}
