// Stage 3 (26.09.2026) — constructive ownership for the ownership tests of
// package `us.irc.information_reporting`: §6038(e)(2) (control of a corporation,
// section 318(a) with two modifications), §6038(e)(3)(B) (partnership interests,
// rules similar to section 267(c) other than paragraph (3)), §6038A(c)(5)
// (section 318 with the same two modifications) and §6046(c) (stock owned directly
// or indirectly, family limited to brothers and sisters, spouse, ancestors and lineal
// descendants). Status implemented_unverified; scenarios written, not executed.
//
// SHAPE
//  - Direct holdings are the empirical relations of stages 1-2
//    (`voting_power_percent_of_foreign_corporation`, `value_percent_of_foreign_corporation`,
//    `capital_interest_percent`, `profits_interest_percent`); they now mean DIRECT
//    ownership. `constructive_interest_percent(regime, person, target, basis, pct)` adds
//    what the regime attributes: family, ownership through entities (up), and
//    ownership by owners of an entity (down, section 318 only).
//  - The paths are unrolled: up to two entities in a chain, one family step taken from
//    directly held interests, one downward step from directly held interests. A sum over
//    paths is `sum(collect all …)` over strict paths (one entry per path, not per distinct value).
//
// JUDGMENT CALLS AND LIMITS (TECH-GAPS G6300)
//  - Section 318(a)(5) (stock constructively owned is treated as actually owned for
//    further attribution, except family-to-family) is applied only as the two-entity
//    up chain; a chain of three or more entities, an up step after a family step, and
//    attribution by options (a)(4) are not derived.
//  - Section 318(a)(2)(C) (corporation to shareholder) uses "10 percent" as the two
//    modifications require; partnership, estate and trust owners are proportional.
//    For the regime of section 267(c) every entity form is proportional (section
//    267(c)(1) has no threshold).
//  - The section 318(a)(3) downward attribution (partner to partnership, beneficiary
//    to estate or trust, 50-percent shareholder to corporation) does not treat a
//    United States person as owning what a person who is not a United States person
//    owns (the modification in (e)(2)(A) and (c)(5)(B)). The United States status is
//    read from the pending relations `us_person_status_6046` and
//    `person_not_united_states_person`, asserted by the case.
//  - Percentages of an interest are summed as recorded; no cap at 100 is applied.

language "law.core" version "0.2";
package us.irc.information_reporting version "0.1.1";
namespace "urn:us:irc:information_reporting:clir";

use self::{
    Corporation,
    IRC_S6038A_C,
    IRC_S6038_E,
    IRC_S6046_C,
    Person,
    TaxableYear,
    capital_interest_percent,
    foreign_person_6038a,
    foreign_shareholder_25_percent,
    person_not_united_states_person,
    profits_interest_percent,
    us_person_status_6046,
    value_percent_of_foreign_corporation,
    voting_power_percent_of_foreign_corporation,
};

enum AttributionRegime6300 {
    Section318As6038;
    Section267cFamilyRules;
}
enum OwnershipBasis6300 {
    VotingPowerBasis;
    StockValueBasis;
    CapitalInterestBasis;
    ProfitsInterestBasis;
}
enum FamilyKind6300 {
    Spouse;
    Child;
    Grandchild;
    Parent;
    Sibling;
    OtherAncestor;
    OtherLinealDescendant;
}
enum AttributionEntityForm6300 {
    CorporationEntity;
    PartnershipEstateOrTrustEntity;
}

relation family_member_recorded(person: Person, member: Person, kind: FamilyKind6300) kind empirical { label en unofficial "the member stands in this family relation to the person (spouse, child, grandchild, parent, brother or sister of the whole or half blood, other ancestor, other lineal descendant)"; }
relation attribution_entity_form(ent: Person, form: AttributionEntityForm6300) kind empirical { label en unofficial "the entity is a corporation, or a partnership, estate or trust"; }
relation owner_interest_in_entity_percent(ent: Person, owner: Person, pct: Decimal) kind empirical { label en unofficial "the percentage the owner holds in the entity: value of the stock of a corporation, or the proportional interest of a partner or beneficiary"; }

relation direct_interest_percent(person: Person, target: Person, basis: OwnershipBasis6300, pct: Decimal) kind institutional { label en unofficial "the interest the person holds directly in the corporation or partnership, on the given basis"; }
@source(IRC_S6038_E, relation = formalizes, coverage = partial, quote = "A person is in control of a corporation if such person owns stock possessing more than 50 percent of the total combined voting power of all classes of stock entitled to vote")
rule S6300DirectVotingPower strict { for person: Person; for target: Person; for pct: Decimal; when voting_power_percent_of_foreign_corporation(person, target, pct); then direct_interest_percent(person, target, VotingPowerBasis, pct); }
@source(IRC_S6038_E, relation = formalizes, coverage = partial, quote = "or more than 50 percent of the total value of shares of all classes of stock, of a corporation.")
rule S6300DirectStockValue strict { for person: Person; for target: Person; for pct: Decimal; when value_percent_of_foreign_corporation(person, target, pct); then direct_interest_percent(person, target, StockValueBasis, pct); }
@source(IRC_S6038_E, relation = formalizes, coverage = partial, quote = "an interest equal to 50 percent of the capital interest, or 50 percent of the profits interest, in such partnership, or")
rule S6300DirectCapital strict { for person: Person; for target: Person; for pct: Decimal; when capital_interest_percent(person, target, pct); then direct_interest_percent(person, target, CapitalInterestBasis, pct); }
@source(IRC_S6038_E, relation = formalizes, coverage = partial, quote = "an interest equal to 50 percent of the capital interest, or 50 percent of the profits interest, in such partnership, or")
rule S6300DirectProfits strict { for person: Person; for target: Person; for pct: Decimal; when profits_interest_percent(person, target, pct); then direct_interest_percent(person, target, ProfitsInterestBasis, pct); }

relation family_link(regime: AttributionRegime6300, person: Person, member: Person) kind institutional { label en unofficial "the member is a family member whose interests are attributed to the person under the regime"; }
@source(IRC_S6046_C, relation = formalizes, coverage = exact, quote = "the family of an individual shall be considered as including only his brothers and sisters (whether by the whole or half blood), spouse, ancestors, and lineal descendants.")
rule S6300Family267c strict {
    for person: Person;
    for member: Person;
    for kind: FamilyKind6300;
    when family_member_recorded(person, member, kind);
    when kind == Sibling or kind == Spouse or kind == Parent or kind == OtherAncestor or kind == Child or kind == Grandchild or kind == OtherLinealDescendant;
    then family_link(Section267cFamilyRules, person, member);
}
@source(IRC_S6038A_C, relation = formalizes, coverage = partial, quote = "Section 318 shall apply for purposes of paragraphs (1) and (2), except that—")
rule S6300Family318 strict {
    for person: Person;
    for member: Person;
    for kind: FamilyKind6300;
    when family_member_recorded(person, member, kind);
    when kind == Spouse or kind == Child or kind == Grandchild or kind == Parent;
    then family_link(Section318As6038, person, member);
}

relation entity_attribution_edge(regime: AttributionRegime6300, ent: Person, owner: Person, pct: Decimal) kind institutional { label en unofficial "the stock or interest of the entity is considered owned proportionately by the owner under the regime"; }
@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "(A) \"10 percent\" shall be substituted for \"50 percent\" in section 318(a)(2)(C), and")
rule S6300EdgeCorporation318 strict {
    for ent: Person;
    for owner: Person;
    for pct: Decimal;
    when attribution_entity_form(ent, CorporationEntity) and owner_interest_in_entity_percent(ent, owner, pct) and pct >= 10.0;
    then entity_attribution_edge(Section318As6038, ent, owner, pct);
}
@source(IRC_S6038_E, relation = formalizes, coverage = partial, quote = "For purposes of this paragraph, the rules prescribed by section 318(a) for determining ownership of stock shall apply")
rule S6300EdgePassThrough318 strict {
    for ent: Person;
    for owner: Person;
    for pct: Decimal;
    when attribution_entity_form(ent, PartnershipEstateOrTrustEntity) and owner_interest_in_entity_percent(ent, owner, pct);
    then entity_attribution_edge(Section318As6038, ent, owner, pct);
}
@source(IRC_S6038_E, relation = formalizes, coverage = partial, quote = "For purposes of the preceding sentence, rules similar to the rules of section 267(c) (other than paragraph (3)) shall apply.")
rule S6300Edge267c strict {
    for ent: Person;
    for owner: Person;
    for pct: Decimal;
    when owner_interest_in_entity_percent(ent, owner, pct);
    then entity_attribution_edge(Section267cFamilyRules, ent, owner, pct);
}

relation family_path(regime: AttributionRegime6300, person: Person, target: Person, basis: OwnershipBasis6300, member: Person, pct: Decimal) kind institutional { label en unofficial "the person is considered to own what the family member directly holds"; }
rule S6300FamilyPath strict {
    for regime: AttributionRegime6300;
    for person: Person;
    for target: Person;
    for basis: OwnershipBasis6300;
    for member: Person;
    for d: Decimal;
    when family_link(regime, person, member) and direct_interest_percent(member, target, basis, d);
    then family_path(regime, person, target, basis, member, d);
}
relation up_path_one(regime: AttributionRegime6300, person: Person, target: Person, basis: OwnershipBasis6300, ent: Person, pct: Decimal) kind institutional { label en unofficial "the person is considered to own proportionately what one entity holds directly"; }
rule S6300UpPathOne strict {
    for regime: AttributionRegime6300;
    for person: Person;
    for target: Person;
    for basis: OwnershipBasis6300;
    for e1: Person;
    for a: Decimal;
    for o: Decimal;
    when direct_interest_percent(e1, target, basis, a) and entity_attribution_edge(regime, e1, person, o);
    then up_path_one(regime, person, target, basis, e1, div_round(a * o, 100.0, 6, "HALF_UP"));
}
relation up_path_two(regime: AttributionRegime6300, person: Person, target: Person, basis: OwnershipBasis6300, entity1: Person, entity2: Person, pct: Decimal) kind institutional { label en unofficial "the person is considered to own proportionately through a chain of two entities"; }
rule S6300UpPathTwo strict {
    for regime: AttributionRegime6300;
    for person: Person;
    for target: Person;
    for basis: OwnershipBasis6300;
    for e1: Person;
    for e2: Person;
    for a: Decimal;
    for b: Decimal;
    for c: Decimal;
    when direct_interest_percent(e1, target, basis, a) and entity_attribution_edge(regime, e1, e2, b) and entity_attribution_edge(regime, e2, person, c);
    then up_path_two(regime, person, target, basis, e1, e2, div_round(div_round(a * b, 100.0, 6, "HALF_UP") * c, 100.0, 6, "HALF_UP"));
}

relation down_attribution_allowed(ent: Person, owner: Person) kind institutional { label en unofficial "the downward attribution from the owner to the entity is not one that treats a United States person as owning what a person who is not a United States person owns"; }
@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "(A) subparagraphs (A), (B), and (C) of section 318(a)(3) shall not be applied so as to consider a United States person as owning stock which is owned by a person who is not a United States person, and")
rule S6300DownAllowedOwnerUs strict { for ent: Person; for owner: Person; for o: Decimal; when us_person_status_6046(owner) and owner_interest_in_entity_percent(ent, owner, o); then down_attribution_allowed(ent, owner); }
@source(IRC_S6038_E, relation = formalizes, coverage = exact, quote = "(A) subparagraphs (A), (B), and (C) of section 318(a)(3) shall not be applied so as to consider a United States person as owning stock which is owned by a person who is not a United States person, and")
rule S6300DownAllowedEntityNotUs strict { for ent: Person; for owner: Person; for o: Decimal; when person_not_united_states_person(ent) and owner_interest_in_entity_percent(ent, owner, o); then down_attribution_allowed(ent, owner); }
relation down_path(regime: AttributionRegime6300, person: Person, target: Person, basis: OwnershipBasis6300, owner: Person, pct: Decimal) kind institutional { label en unofficial "the entity is considered to own what its partner, beneficiary or 50-percent shareholder directly holds (section 318(a)(3))"; }
rule S6300DownPathPassThrough strict {
    for person: Person;
    for target: Person;
    for basis: OwnershipBasis6300;
    for owner: Person;
    for o: Decimal;
    for d: Decimal;
    when attribution_entity_form(person, PartnershipEstateOrTrustEntity) and owner_interest_in_entity_percent(person, owner, o) and down_attribution_allowed(person, owner) and direct_interest_percent(owner, target, basis, d);
    then down_path(Section318As6038, person, target, basis, owner, d);
}
rule S6300DownPathCorporationHalf strict {
    for person: Person;
    for target: Person;
    for basis: OwnershipBasis6300;
    for owner: Person;
    for o: Decimal;
    for d: Decimal;
    when attribution_entity_form(person, CorporationEntity) and owner_interest_in_entity_percent(person, owner, o) and o >= 50.0 and down_attribution_allowed(person, owner) and direct_interest_percent(owner, target, basis, d);
    then down_path(Section318As6038, person, target, basis, owner, d);
}

relation attribution_subject(person: Person, target: Person, basis: OwnershipBasis6300) kind institutional { label en unofficial "the person holds directly, or is attributed, an interest on this basis"; }
rule S6300SubjectDirect strict { for person: Person; for target: Person; for basis: OwnershipBasis6300; for d: Decimal; when direct_interest_percent(person, target, basis, d); then attribution_subject(person, target, basis); }
rule S6300SubjectFamily strict { for regime: AttributionRegime6300; for person: Person; for target: Person; for basis: OwnershipBasis6300; for member: Person; for d: Decimal; when family_path(regime, person, target, basis, member, d); then attribution_subject(person, target, basis); }
rule S6300SubjectUpOne strict { for regime: AttributionRegime6300; for person: Person; for target: Person; for basis: OwnershipBasis6300; for e1: Person; for d: Decimal; when up_path_one(regime, person, target, basis, e1, d); then attribution_subject(person, target, basis); }
rule S6300SubjectUpTwo strict { for regime: AttributionRegime6300; for person: Person; for target: Person; for basis: OwnershipBasis6300; for e1: Person; for e2: Person; for d: Decimal; when up_path_two(regime, person, target, basis, e1, e2, d); then attribution_subject(person, target, basis); }
rule S6300SubjectDown strict { for regime: AttributionRegime6300; for person: Person; for target: Person; for basis: OwnershipBasis6300; for owner: Person; for d: Decimal; when down_path(regime, person, target, basis, owner, d); then attribution_subject(person, target, basis); }

relation constructive_interest_percent(regime: AttributionRegime6300, person: Person, target: Person, basis: OwnershipBasis6300, pct: Decimal) kind institutional { label en unofficial "the interest the person owns directly or is considered to own under the regime (unrolled paths: see module header)"; }
@source(IRC_S6038_E, relation = formalizes, coverage = partial, quote = "For purposes of this paragraph, the rules prescribed by section 318(a) for determining ownership of stock shall apply; except that—")
rule S6300Constructive318 strict {
    for person: Person;
    for target: Person;
    for basis: OwnershipBasis6300;
    when attribution_subject(person, target, basis);
    then constructive_interest_percent(Section318As6038, person, target, basis,
        sum(collect all d: Decimal where direct_interest_percent(person, target, basis, d), empty: 0.0)
        + sum(collect all f: Decimal, m: Person where family_path(Section318As6038, person, target, basis, m, f), empty: 0.0)
        + sum(collect all u1: Decimal, e1: Person where up_path_one(Section318As6038, person, target, basis, e1, u1), empty: 0.0)
        + sum(collect all u2: Decimal, e2: Person, e3: Person where up_path_two(Section318As6038, person, target, basis, e2, e3, u2), empty: 0.0)
        + sum(collect all w: Decimal, o: Person where down_path(Section318As6038, person, target, basis, o, w), empty: 0.0));
}
@source(IRC_S6046_C, relation = formalizes, coverage = exact, quote = "stock owned directly or indirectly by a person (including, in the case of an individual, stock owned by members of his family) shall be taken into account.")
rule S6300Constructive267c strict {
    for person: Person;
    for target: Person;
    for basis: OwnershipBasis6300;
    when attribution_subject(person, target, basis);
    then constructive_interest_percent(Section267cFamilyRules, person, target, basis,
        sum(collect all d: Decimal where direct_interest_percent(person, target, basis, d), empty: 0.0)
        + sum(collect all f: Decimal, m: Person where family_path(Section267cFamilyRules, person, target, basis, m, f), empty: 0.0)
        + sum(collect all u1: Decimal, e1: Person where up_path_one(Section267cFamilyRules, person, target, basis, e1, u1), empty: 0.0)
        + sum(collect all u2: Decimal, e2: Person, e3: Person where up_path_two(Section267cFamilyRules, person, target, basis, e2, e3, u2), empty: 0.0));
}

// ============================================================================
// §6038A(c)(1), (5) — a 25-percent foreign shareholder, with constructive ownership
// ============================================================================

@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "Section 318 shall apply for purposes of paragraphs (1) and (2), except that—")
rule S6038Ac5ConstructiveVotingPower25 strict {
    for c: Corporation;
    for y: TaxableYear;
    for holder: Person;
    for pct: Decimal;
    when us.irc.core::year_of(c, y) and foreign_person_6038a(holder) and constructive_interest_percent(Section318As6038, holder, c, VotingPowerBasis, pct) and pct >= 25.0;
    then foreign_shareholder_25_percent(c, y, holder);
}
@source(IRC_S6038A_C, relation = formalizes, coverage = exact, quote = "Section 318 shall apply for purposes of paragraphs (1) and (2), except that—")
rule S6038Ac5ConstructiveValue25 strict {
    for c: Corporation;
    for y: TaxableYear;
    for holder: Person;
    for pct: Decimal;
    when us.irc.core::year_of(c, y) and foreign_person_6038a(holder) and constructive_interest_percent(Section318As6038, holder, c, StockValueBasis, pct) and pct >= 25.0;
    then foreign_shareholder_25_percent(c, y, holder);
}
