// 26 U.S.C. §§7231-7241 (subchapter A, part II — occupational and other
// offenses) and §§7261-7275 (subchapter B — other offenses). Of part II,
// only §§7231-7232 remain in force; §§7233-7241 were repealed between
// 1970 and 1990 (Pub. L. 91-513, 93-490, 94-455, 100-418, 101-508) and
// carry NO current text — modeled as NON_NORMATIVE (repealed_or_reserved)
// coverage rows only, with no rule. The same is true of subchapter B's
// §§7263-7267 and §7274.

// =======================================================================
// Section 7231 — Failure to obtain license for collection of foreign
// items (section 7001)
// =======================================================================

use self::{
    IRC_S7231,
    IRC_S7232,
    IRC_S7261,
    IRC_S7262,
    IRC_S7268,
    IRC_S7269,
    IRC_S7270,
    IRC_S7271,
    IRC_S7272_A,
    IRC_S7273,
    IRC_S7275_A,
    IRC_S7275_B,
    IRC_S7275_C,
    IRC_S7275_D,
    Offense,
    OffenseGrade,
    Person,
    intent_to_evade_or_defeat_established,
    offense_elements_established,
    offense_grade,
    offense_person,
    statutory_maximum_fine_individual,
    statutory_maximum_imprisonment_years,
    willfulness_established,
};

pub relation required_license_for_foreign_item_collection(p: Person) kind empirical {
    label en unofficial "case fact: p is required by section 7001 to obtain a license for collecting the payments section 7001 describes";
}
pub relation collected_foreign_items_without_license_or_compliance(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o knowingly undertook to collect section 7001 payments without having obtained the required license, or without complying with regulations under section 7001";
}
pub relation offense_7231(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7231: p's conduct in o is a misdemeanor for collecting foreign items without the required license";
}
@source(IRC_S7231, relation = formalizes, coverage = exact, quote = "Any person required by section 7001 (relating to collection of certain foreign items) to obtain a license who knowingly undertakes to collect the payments described in section 7001 without having obtained a license therefor, or without complying with regulations prescribed under section 7001, shall be guilty of a misdemeanor and, upon conviction thereof, shall be fined not more than $5,000, or imprisoned not more than 1 year, or both.")
rule Section7231Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and required_license_for_foreign_item_collection(p)
        and collected_foreign_items_without_license_or_compliance(o);
    then offense_7231(p, o);
}
rule Section7231FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7231(p, o);
    then offense_elements_established(p, o);
}
rule Section7231Grade(p: Person, o: Offense) strict {
    when offense_7231(p, o);
    then offense_grade(o, Misdemeanor);
}
const Section7231MaxFine: Money = 5000.00 USD { label en unofficial "section 7231: fine ceiling"; };
rule Section7231MaxFineRule(p: Person, o: Offense) strict {
    when offense_7231(p, o);
    then statutory_maximum_fine_individual(o, Section7231MaxFine);
}
rule Section7231MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7231(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7232 — Failure to register/reregister under section 4101
// (taxable fuel), false representation of registration status, false
// statement in a registration application
// =======================================================================

pub relation failed_to_register_under_4101(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to register or reregister as required by section 4101";
}
pub relation falsely_represented_4101_registration(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o, in connection with a purchase of taxable fuel (section 4083) or aviation fuel, falsely represented themselves to be registered under section 4101";
}
pub relation false_statement_in_4101_application(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o willfully made a false statement in an application for registration or reregistration under section 4101";
}
pub relation offense_7232(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7232: p's conduct in o is a section 4101 registration offense";
}
@source(IRC_S7232, relation = formalizes, coverage = partial, quote = "Every person who fails to register or reregister as required by section 4101")
rule Section7232FailureToRegisterOffense(p: Person, o: Offense) strict {
    when offense_person(o, p) and failed_to_register_under_4101(o);
    then offense_7232(p, o);
}
@source(IRC_S7232, relation = formalizes, coverage = partial, quote = "or who in connection with any purchase of any taxable fuel (as defined in section 4083) or aviation fuel falsely represents himself to be registered as provided by section 4101")
rule Section7232FalseRepresentationOffense(p: Person, o: Offense) strict {
    when offense_person(o, p) and falsely_represented_4101_registration(o);
    then offense_7232(p, o);
}
@source(IRC_S7232, relation = formalizes, coverage = partial, quote = "or who willfully makes any false statement in an application for registration or reregistration under section 4101")
rule Section7232FalseApplicationOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and false_statement_in_4101_application(o)
        and willfulness_established(o);
    then offense_7232(p, o);
}
rule Section7232FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7232(p, o);
    then offense_elements_established(p, o);
}
const Section7232MaxFine: Money = 10000.00 USD { label en unofficial "section 7232: fine ceiling"; };
@source(IRC_S7232, relation = formalizes, coverage = exact, quote = "shall, upon conviction thereof, be fined not more than $10,000, or imprisoned not more than 5 years, or both, together with the costs of prosecution.")
rule Section7232MaxFineRule(p: Person, o: Offense) strict {
    when offense_7232(p, o);
    then statutory_maximum_fine_individual(o, Section7232MaxFine);
}
rule Section7232MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7232(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

// Sections 7233-7241 are repealed (Pub. L. 94-455 §1952(n)(2)(A)/1904(b);
// Pub. L. 93-490 §3(b)(1); Pub. L. 91-513 §1101(b)(4)(A); Pub. L. 100-418
// §1941(b)(1); Pub. L. 101-508 §11801(c)(22)(D)(i)): no current text, no
// rule — coverage rows classify each as NON_NORMATIVE
// (repealed_or_reserved).

// =======================================================================
// Section 7261 — Representation that retailers' excise tax (chapter 31)
// is excluded from price of article
// =======================================================================

pub relation misrepresented_chapter31_tax_exclusion(o: Offense) kind empirical {
    label en unofficial "case fact: in connection with a sale/lease/offer of a chapter-31-taxable article, the person alleged in o made a statement (written or oral, in advertisement or otherwise) intended or calculated to lead a person to believe the price does not include the chapter 31 tax";
}
pub relation offense_7261(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7261: p's conduct in o is a false tax-exclusion representation for a chapter 31 excise article";
}
@source(IRC_S7261, relation = formalizes, coverage = exact, quote = "Whoever, in connection with the sale or lease, or offer for sale or lease, of any article taxable under chapter 31, makes any statement, written or oral, in advertisement or otherwise, intended or calculated to lead any person to believe that the price of the article does not include the tax imposed by chapter 31, shall on conviction thereof be fined not more than $1,000.")
rule Section7261Offense(p: Person, o: Offense) strict {
    when offense_person(o, p) and misrepresented_chapter31_tax_exclusion(o);
    then offense_7261(p, o);
}
rule Section7261FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7261(p, o);
    then offense_elements_established(p, o);
}
const Section7261MaxFine: Money = 1000.00 USD { label en unofficial "section 7261: fine ceiling"; };
rule Section7261MaxFineRule(p: Person, o: Offense) strict {
    when offense_7261(p, o);
    then statutory_maximum_fine_individual(o, Section7261MaxFine);
}
// no imprisonment ceiling is stated for section 7261.

// =======================================================================
// Section 7262 — Wagering occupational tax violation: acting without
// having paid the special tax (subchapter B of chapter 35)
// =======================================================================

pub relation liable_for_wagering_special_tax_without_payment(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o did an act that makes the person liable for the wagering special tax under chapter 35 subchapter B, without having paid that tax";
}
pub relation offense_7262(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7262: p's conduct in o is an unpaid wagering occupational tax offense";
}
@source(IRC_S7262, relation = formalizes, coverage = exact, quote = "Any person who does any act which makes him liable for special tax under subchapter B of chapter 35 without having paid such tax, shall, besides being liable to the payment of the tax, be fined not less than $1,000 and not more than $5,000.")
rule Section7262Offense(p: Person, o: Offense) strict {
    when offense_person(o, p) and liable_for_wagering_special_tax_without_payment(o);
    then offense_7262(p, o);
}
rule Section7262FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7262(p, o);
    then offense_elements_established(p, o);
}
// section 7262 states a FLOOR ($1,000) and a CEILING ($5,000) fine, not a
// ceiling alone — statutory_maximum_fine_individual (00-vocabulary.law)
// records only a ceiling; the floor is not represented — TECH_GAP,
// coverage row 26/7262/u1.
const Section7262MaxFine: Money = 5000.00 USD { label en unofficial "section 7262: fine ceiling (the $1,000 floor is not separately represented, see TECH_GAP note)"; };
rule Section7262MaxFineRule(p: Person, o: Offense) strict {
    when offense_7262(p, o);
    then statutory_maximum_fine_individual(o, Section7262MaxFine);
}

// Sections 7263-7267 and 7274 are repealed (Pub. L. 94-455 §1952(n)(3)(A)/
// 1904(b); Pub. L. 93-490 §3(b)(3)): no current text, no rule — coverage
// rows classify each as NON_NORMATIVE (repealed_or_reserved).

// =======================================================================
// Section 7268 — Possession with intent to sell in fraud of law or to
// evade tax
// =======================================================================

pub relation possessed_taxed_goods_to_sell_in_fraud_or_evade(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o had custody or possession of goods/wares/merchandise/articles/objects on which taxes are imposed, for the purpose of selling them in fraud of the internal revenue laws, or with design to avoid payment of the taxes imposed on them";
}
pub relation offense_7268(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7268: p's conduct in o is possession of taxed goods with intent to sell in fraud of law or to evade tax";
}
@source(IRC_S7268, relation = formalizes, coverage = exact, quote = "Every person who shall have in his custody or possession any goods, wares, merchandise, articles, or objects on which taxes are imposed by law, for the purpose of selling the same in fraud of the internal revenue laws, or with design to avoid payment of the taxes imposed thereon, shall be liable to a penalty of $500 or not less than double the amount of taxes fraudulently attempted to be evaded.")
rule Section7268Offense(p: Person, o: Offense) strict {
    when offense_person(o, p) and possessed_taxed_goods_to_sell_in_fraud_or_evade(o);
    then offense_7268(p, o);
}
rule Section7268FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7268(p, o);
    then offense_elements_established(p, o);
}
// The $500-or-double-taxes-evaded penalty needs a "greater of" comparison
// over an empirical evaded-tax amount, like section 7212(b) above —
// TECH_GAP, coverage row 26/7268/u1.

// =======================================================================
// Section 7269 — Failure to produce estate-tax records
// =======================================================================

pub relation failed_estate_records_duty(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to comply with a duty imposed by section 6018, section 6036 (as executor), or section 6075(a), OR, having possession/control of an estate-related record or property, failed to exhibit it to the Secretary upon request in performance of chapter 11 duties";
}
pub relation offense_7269(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7269: p's conduct in o is a failure-to-produce-estate-records violation (civil penalty recovered in a civil action, not a criminal fine ceiling)";
}
@source(IRC_S7269, relation = formalizes, coverage = exact, quote = "Whoever fails to comply with any duty imposed upon him by section 6018, 6036 (in the case of an executor), or 6075(a), or, having in his possession or control any record, file, or paper, containing or supposed to contain any information concerning the estate of the decedent, or, having in his possession or control any property comprised in the gross estate of the decedent, fails to exhibit the same upon request to the Secretary who desires to examine the same in the performance of his duties under chapter 11 (relating to estate taxes), shall be liable to a penalty of not exceeding $500, to be recovered, with costs of suit, in a civil action in the name of the United States.")
rule Section7269Offense(p: Person, o: Offense) strict {
    when offense_person(o, p) and failed_estate_records_duty(o);
    then offense_7269(p, o);
}
// Section 7269 is a CIVIL penalty recovered in a civil action, not a
// criminal offense with a fine/imprisonment ceiling — it does NOT feed
// offense_elements_established, and no statutory_maximum_* rule applies.
// Classified EXECUTABLE as a civil penalty classification (coverage row
// 26/7269/u1 notes the civil/criminal distinction from Part I).

// =======================================================================
// Section 7270 — Insurance policies: failure to comply with section 4374
// (foreign insurer policy tax) with intent to evade
// =======================================================================

pub relation failed_4374_compliance_with_intent_to_evade(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to comply with section 4374 requirements, with intent to evade the tax";
}
pub relation offense_7270(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7270: p's conduct in o is a foreign-insurer-tax evasion violation";
}
@source(IRC_S7270, relation = formalizes, coverage = exact, quote = "Any person who fails to comply with the requirements of section 4374 (relating to liability for tax on policies issued by foreign insurers), with intent to evade the tax shall, in addition to other penalties provided therefor, pay a fine of double the amount of the tax.")
rule Section7270Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and failed_4374_compliance_with_intent_to_evade(o)
        and intent_to_evade_or_defeat_established(o);
    then offense_7270(p, o);
}
rule Section7270FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7270(p, o);
    then offense_elements_established(p, o);
}
// The "double the amount of the tax" fine needs the evaded tax amount as
// a computed multiplier, not a fixed ceiling — TECH_GAP, coverage row
// 26/7270/u1 (same "double the tax" pattern as sections 7212(b)/7268).

// =======================================================================
// Section 7271 — Penalties for offenses relating to stamps (three
// numbered clauses; each a flat $50 penalty). Referenced by section
// 7208(5) ("emptied stamped packages ... with intent to defraud").
// =======================================================================

pub enum Section7271Ground {
    FailureToAttachOrCancelStamps;
    UnstampedInstrument;
    EmptiedOrMismatchedStampedContainer;
}
pub relation stamp_recordkeeping_violation(o: Offense, ground: Section7271Ground) kind empirical {
    label en unofficial "case fact: the person alleged in o engaged in the conduct section 7271's numbered clause for this ground describes, with respect to a tax payable by stamps";
}
pub relation failure_due_to_reasonable_cause_not_willful_neglect(o: Offense) kind empirical {
    label en unofficial "case fact: the failure alleged in o (FailureToAttachOrCancelStamps ground) is shown to be due to reasonable cause and not willful neglect — section 7271(1)'s own exception";
}
pub relation offense_7271(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7271: p's conduct in o is a stamp-recordkeeping offense, liable to the $50 penalty";
}
@source(IRC_S7271, relation = formalizes, coverage = partial, quote = "Fails to comply with rules or regulations prescribed pursuant to section 6804 (relating to attachment, cancellation, etc., of stamps), unless such failure is shown to be due to reasonable cause and not willful neglect")
rule Section7271FailureToAttachOffense(p: Person, o: Offense) defeasible {
    when offense_person(o, p) and stamp_recordkeeping_violation(o, FailureToAttachOrCancelStamps);
    then offense_7271(p, o);
    unless failure_due_to_reasonable_cause_not_willful_neglect(o) and offense_person(o, p) and stamp_recordkeeping_violation(o, FailureToAttachOrCancelStamps);
}
@source(IRC_S7271, relation = formalizes, coverage = partial, quote = "Makes, signs, issues, or accepts, or causes to be made, signed, issued, or accepted, any instrument, document, or paper of any kind or description whatsoever without the full amount of tax thereon being duly paid")
rule Section7271UnstampedInstrumentOffense(p: Person, o: Offense) strict {
    when offense_person(o, p) and stamp_recordkeeping_violation(o, UnstampedInstrument);
    then offense_7271(p, o);
}
@source(IRC_S7271, relation = formalizes, coverage = partial, quote = "Transfers or receives (whether by sale, gift, or otherwise) such container knowing it to be empty or to contain such other contents")
rule Section7271EmptiedContainerOffense(p: Person, o: Offense) strict {
    when offense_person(o, p) and stamp_recordkeeping_violation(o, EmptiedOrMismatchedStampedContainer);
    then offense_7271(p, o);
}
rule Section7271FeedsElementsAggregate(p: Person, o: Offense) defeasible {
    when offense_7271(p, o);
    then offense_elements_established(p, o);
}
const Section7271Penalty: Money = 50.00 USD { label en unofficial "section 7271: flat penalty per offense"; };
rule Section7271PenaltyRule(p: Person, o: Offense) defeasible {
    when offense_7271(p, o);
    then statutory_maximum_fine_individual(o, Section7271Penalty);
}

// =======================================================================
// Section 7272 — Failure to register (general registration duty, $50
// penalty; $10,000 for section 4101 failure — cross-referenced already
// by section 7232 above, which is the SPECIFIC felony/misdemeanor offense
// for that same failure; section 7272(a) is section 7232's general civil-
// penalty counterpart for OTHER registration duties)
// =======================================================================

pub relation required_to_register_generally(p: Person) kind empirical {
    label en unofficial "case fact: p is required to register with the Secretary under this title or its regulations, and is NOT a person required to register under subtitle E or engaging in a subtitle-E-special-tax trade or business (section 7272(a)'s own carve-out)";
}
pub relation failed_general_registration_duty(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to register as section 7272(a) requires";
}
pub relation registration_failure_is_under_4101(o: Offense) kind empirical {
    label en unofficial "case fact: the registration failure alleged in o is specifically a failure to register or reregister under section 4101 (the section states a distinct $10,000 penalty for this branch, coordinated with section 7232's own offense)";
}
pub relation offense_7272(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7272(a): p's conduct in o is a general registration-failure offense";
}
@source(IRC_S7272_A, relation = formalizes, coverage = exact, quote = "Any person (other than persons required to register under subtitle E, or persons engaging in a trade or business on which a special tax is imposed by such subtitle) who fails to register with the Secretary as required by this title or by regulations issued thereunder shall be liable to a penalty of $50 ($10,000 in the case of a failure to register or reregister under section 4101).")
rule Section7272Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and required_to_register_generally(p)
        and failed_general_registration_duty(o);
    then offense_7272(p, o);
}
rule Section7272FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7272(p, o);
    then offense_elements_established(p, o);
}
const Section7272GeneralPenalty: Money = 50.00 USD { label en unofficial "section 7272(a): general registration-failure penalty"; };
const Section7272FourOneOOnePenalty: Money = 10000.00 USD { label en unofficial "section 7272(a): section-4101-specific registration-failure penalty"; };
rule Section7272GeneralPenaltyRule(p: Person, o: Offense) defeasible {
    when offense_7272(p, o);
    then statutory_maximum_fine_individual(o, Section7272GeneralPenalty);
    unless registration_failure_is_under_4101(o) and offense_7272(p, o);
}
rule Section7272FourOneOnePenaltyRule(p: Person, o: Offense) strict {
    when offense_7272(p, o)
        and registration_failure_is_under_4101(o);
    then statutory_maximum_fine_individual(o, Section7272FourOneOOnePenalty);
}

// =======================================================================
// Section 7273 — Penalties for offenses relating to special taxes
// (failure to place/keep stamps under section 6806)
// =======================================================================

pub relation failed_to_display_special_tax_stamp(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to place and keep stamps denoting payment of the special tax as section 6806 requires";
}
pub relation special_tax_amount(o: Offense, amount: Money) kind empirical {
    label en unofficial "case fact: the amount of special tax for which the business of the person alleged in o rendered the person liable — the base for section 7273's equal (or doubled) penalty";
}
pub relation display_failure_due_to_reasonable_cause(o: Offense) kind empirical {
    label en unofficial "case fact: the failure alleged in o is shown to be due to reasonable cause — section 7273's own exception, defeating even the base penalty";
}
pub relation display_failure_through_willful_neglect_or_refusal(o: Offense) kind empirical {
    label en unofficial "case fact: the failure alleged in o was through willful neglect or refusal to comply with section 6806, doubling the penalty";
}
pub relation offense_7273(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7273: p's conduct in o is a failure to display the special tax stamp";
}
@source(IRC_S7273, relation = formalizes, coverage = exact, quote = "Any person who shall fail to place and keep stamps denoting the payment of the special tax as provided in section 6806 shall be liable to a penalty (not less than $10) equal to the special tax for which his business rendered him liable, unless such failure is shown to be due to reasonable cause.")
rule Section7273Offense(p: Person, o: Offense) defeasible {
    when offense_person(o, p) and failed_to_display_special_tax_stamp(o);
    then offense_7273(p, o);
    unless display_failure_due_to_reasonable_cause(o) and offense_person(o, p) and failed_to_display_special_tax_stamp(o);
}
rule Section7273FeedsElementsAggregate(p: Person, o: Offense) defeasible {
    when offense_7273(p, o);
    then offense_elements_established(p, o);
}
// The penalty ("not less than $10, equal to the special tax", doubled for
// willful neglect/refusal) is a computed function of the case's own
// `special_tax_amount`, not a fixed literal ceiling this package can
// state — TECH_GAP, coverage row 26/7273/u1.

// section 7274 is repealed (Pub. L. 94-455 §1904(b)(8)(E)(i)): no current
// text, no rule.

// =======================================================================
// Section 7275 — Air transportation tickets and advertising: duties to
// disclose the tax component of the fare ((a) tickets, (b) advertising),
// a prohibition on padding the disclosed tax figure with non-tax charges
// ((c)), and a misdemeanor penalty for violating (a)-(c) ((d)). Unlike
// Part I, (a)-(c) are DUTIES/a PROHIBITION on the carrier, not
// willfulness-gated criminal elements — the text names no mental element
// at all for the (d) misdemeanor.
// =======================================================================

// Section 7275(a)/(b) speak of a TICKET or ADVERTISEMENT; no us.irc.core
// entity models either yet, so this module reads them as Offense-level
// case facts rather than introducing a bespoke entity for one section.
pub relation ticket_disclosed_total_fare_and_tax(o: Offense) kind empirical {
    label en unofficial "case fact: the ticket for taxable air transportation alleged in o showed the total of the transportation amount and the section 4261(a)/(b) taxes, as section 7275(a) requires";
}
pub relation advertising_disclosed_cost_and_tax_per_7275b(o: Offense) kind empirical {
    label en unofficial "case fact: advertising for taxable air transportation alleged in o stated cost and section 4261(a)/(b)/(c) taxes, and (if separately stated) the required prominence and description, as section 7275(b) requires";
}
pub relation disclosed_amount_includes_non_tax_charges(o: Offense) kind empirical {
    label en unofficial "case fact: the separately-disclosed passenger-tax amount on the ticket or advertisement alleged in o includes amounts not attributable to the section 4261 taxes — the section 7275(c)(1) prohibition's own predicate";
}
pub relation offense_7275(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7275(d): p's conduct in o violates one of subsections (a), (b), or (c)";
}
@source(IRC_S7275_A, relation = formalizes, coverage = exact, quote = "the ticket for such transportation shall show the total of")
rule Section7275aBreach(p: Person, o: Offense) strict {
    when offense_person(o, p) and not_known(ticket_disclosed_total_fare_and_tax(o));
    then offense_7275(p, o);
}
@source(IRC_S7275_B, relation = formalizes, coverage = partial, quote = "any advertising made by or on behalf of any person furnishing such transportation (or offering to arrange such transportation) which states the cost of such transportation shall")
rule Section7275bBreach(p: Person, o: Offense) strict {
    when offense_person(o, p) and not_known(advertising_disclosed_cost_and_tax_per_7275b(o));
    then offense_7275(p, o);
}
@source(IRC_S7275_C, relation = formalizes, coverage = exact, quote = "it shall be unlawful for the disclosure of such amounts to include any amounts not attributable to such taxes.")
rule Section7275cBreach(p: Person, o: Offense) strict {
    when offense_person(o, p) and disclosed_amount_includes_non_tax_charges(o);
    then offense_7275(p, o);
}
rule Section7275FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7275(p, o);
    then offense_elements_established(p, o);
}
rule Section7275Grade(p: Person, o: Offense) strict {
    when offense_7275(p, o);
    then offense_grade(o, Misdemeanor);
}
const Section7275MaxFine: Money = 100.00 USD { label en unofficial "section 7275(d): fine ceiling, per violation"; };
@source(IRC_S7275_D, relation = formalizes, coverage = exact, quote = "Any person who violates any provision of subsection (a), (b), or (c) is, for each violation, guilty of a misdemeanor, and upon conviction thereof shall be fined not more than $100.")
rule Section7275MaxFineRule(p: Person, o: Offense) strict {
    when offense_7275(p, o);
    then statutory_maximum_fine_individual(o, Section7275MaxFine);
}
// section 7275(d) states no imprisonment ceiling.
