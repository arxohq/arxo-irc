// 26 U.S.C. §7261 — Representation that retailers' excise tax is excluded from price of article
fragment IRC_S7261 in IRC_2024_EDITION {
    kind section;
    locator "section/7261";
    text en official """Representation that retailers' excise tax is excluded from price of article
Whoever, in connection with the sale or lease, or offer for sale or lease, of any article taxable under chapter 31, makes any statement, written or oral, in advertisement or otherwise, intended or calculated to lead any person to believe that the price of the article does not include the tax imposed by chapter 31, shall on conviction thereof be fined not more than $1,000.""";
    content_hash "sha256:1d9ba02ccbcfb54992ba395c14fb6fce3bb757a967037e80d7439e1d01d4316d";
}

// 26 U.S.C. §7262 — Violation of occupational tax laws relating to wagering—failure to pay special tax
fragment IRC_S7262 in IRC_2024_EDITION {
    kind section;
    locator "section/7262";
    text en official """Violation of occupational tax laws relating to wagering—failure to pay special tax
Any person who does any act which makes him liable for special tax under subchapter B of chapter 35 without having paid such tax, shall, besides being liable to the payment of the tax, be fined not less than $1,000 and not more than $5,000.""";
    content_hash "sha256:a4a30b01498f77246c02d93fb2c306434c479befebbfc4eb805768d8a43c06bc";
}

