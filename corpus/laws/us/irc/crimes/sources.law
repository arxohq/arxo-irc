    locator "section/7326";
    text en official """Repealed. Pub. L. 115–141, div. U, title IV, §401(b)(50), Mar. 23, 2018, 132 Stat. 1205""";
    content_hash "sha256:2fd925f85301ce47ad2077f21f834f43f229e832d951fce0e6717b6df7239088";
