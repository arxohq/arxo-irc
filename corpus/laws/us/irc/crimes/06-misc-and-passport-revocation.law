// 26 U.S.C. §§7341-7345 (subchapter D — miscellaneous provisions):
// nonenforceability of a sale contract used to avoid tax, forfeiture of
// sums paid, the informer's moiety action, a refusal-of-entry forfeiture,
// (section 7343's extended "person" already lives in 00-vocabulary.law,
// since it applies chapter-wide), extended application of officer
// penalties, and section 7345's passport-certification power.

// =======================================================================
// Section 7341 — Nonenforceability of a sale contract used to avoid tax
// ((a)), forfeiture of the sum paid ((b)), and the informer's moiety
// action ((c))
// =======================================================================

use self::{
    IRC_S7341_A,
    IRC_S7341_B,
    IRC_S7341_C,
    IRC_S7342,
    IRC_S7344,
    IRC_S7345_A,
    IRC_S7345_B,
    IRC_S7345_C,
    IRC_S7345_D,
    IRS,
    Individual,
    Offense,
    Person,
    Property,
    offense_person,
    statutory_maximum_fine_individual,
};

pub relation sold_property_before_tax_paid_to_avoid_or_defraud(pr: Property, seller: Person) kind empirical {
    label en unofficial "case fact: seller, liable to pay a tax on pr, sold or caused/allowed pr to be sold before the tax was paid, with intent to avoid the tax or in fraud of the internal revenue laws — section 7341(a)";
}
pub relation debt_or_security_transferred_to_innocent_holder(pr: Property) kind empirical {
    label en unofficial "case fact: the debt contracted in the section 7341(a) sale, or the security given for it, was bona fide transferred to an innocent holder — section 7341(a)'s own exception";
}
pub relation sale_contract_unenforceable_under_7341a(pr: Property) kind institutional {
    label en unofficial "the debt contracted in the section 7341(a) sale of pr, and any security given for it, is void, and its collection cannot be enforced in any court";
}
@source(IRC_S7341_A, relation = formalizes, coverage = exact, quote = "any debt contracted in such sale, and any security given therefor, unless the same shall have been bona fide transferred to an innocent holder, shall be void, and the collection thereof shall not be enforced in any court.")
rule Section7341aNonenforceability(pr: Property, seller: Person) defeasible {
    when sold_property_before_tax_paid_to_avoid_or_defraud(pr, seller);
    then sale_contract_unenforceable_under_7341a(pr);
    unless debt_or_security_transferred_to_innocent_holder(pr) and sold_property_before_tax_paid_to_avoid_or_defraud(pr, seller);
}

pub relation sale_price_paid_in_whole_or_part(pr: Property, amount: Money) kind empirical {
    label en unofficial "case fact: the buyer paid this amount toward the section 7341(a) sale price of pr, in whole or in part";
}
pub relation sum_forfeited_under_7341b(pr: Property, amount: Money) kind institutional {
    label en unofficial "the sum the buyer paid toward pr's price (in whole or in part) is deemed forfeited — section 7341(b)";
}
@source(IRC_S7341_B, relation = formalizes, coverage = exact, quote = "If such property has been paid for, in whole or in part, the sum so paid shall be deemed forfeited.")
rule Section7341bForfeitureOfSumPaid(pr: Property, amount: Money) defeasible {
    when sale_contract_unenforceable_under_7341a(pr)
        and sale_price_paid_in_whole_or_part(pr, amount);
    then sum_forfeited_under_7341b(pr, amount);
}

pub relation buyer_sues_seller_for_paid_sum(pr: Property, buyer: Person, seller: Person) kind empirical {
    label en unofficial "case fact: the buyer sued the seller (in an action of debt) for the sum paid under section 7341(a)/(b) — section 7341(c)'s own predicate";
}
pub relation moiety_recovery_established(pr: Property, buyer: Person, seller: Person) kind institutional {
    label en unofficial "the buyer's section 7341(c) recovery from the seller: one half to the buyer's own use, the other half to the use of the United States";
}
@source(IRC_S7341_C, relation = formalizes, coverage = exact, quote = "Any person who shall sue for the sum so paid (in an action of debt) shall recover from the seller the amount so paid, one-half to his own use and the other half to the use of the United States.")
rule Section7341cMoietyRecovery(pr: Property, buyer: Person, seller: Person, amount: Money) defeasible {
    when buyer_sues_seller_for_paid_sum(pr, buyer, seller)
        and sum_forfeited_under_7341b(pr, amount);
    then moiety_recovery_established(pr, buyer, seller);
}

// =======================================================================
// Section 7342 — Penalty for refusal to permit entry or examination
// (section 7606 premises inspection)
// =======================================================================

pub relation refused_entry_or_examination_under_7606(o: Offense) kind empirical {
    label en unofficial "case fact: the owner (or agent/superintendent) alleged in o refused to admit a Treasury officer/employee acting under section 7606, or refused to permit examination of the taxable article(s)";
}
pub relation offense_7342(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7342: p's conduct in o is a refusal-of-entry forfeiture violation";
}
@source(IRC_S7342, relation = formalizes, coverage = exact, quote = "Any owner of any building or place, or person having the agency or superintendence of the same, who refuses to admit any officer or employee of the Treasury Department acting under the authority of section 7606 (relating to entry of premises for examination of taxable articles) or refuses to permit him to examine such article or articles, shall, for every such refusal, forfeit $500.")
rule Section7342Offense(p: Person, o: Offense) strict {
    when offense_person(o, p) and refused_entry_or_examination_under_7606(o);
    then offense_7342(p, o);
}
const Section7342Forfeiture: Money = 500.00 USD { label en unofficial "section 7342: forfeiture amount, per refusal"; };
rule Section7342ForfeitureRule(p: Person, o: Offense) strict {
    when offense_7342(p, o);
    then statutory_maximum_fine_individual(o, Section7342Forfeiture);
}

// section 7343's "person" extension lives in 00-vocabulary.law
// (chapter75_person), since the text applies it "as used in this
// chapter" rather than locally to subchapter D.

// =======================================================================
// Section 7344 — Extended application of penalties relating to officers
// of the Treasury Department (institutional_effect: widens the BEARER
// class of every chapter-75 penalty for a Treasury officer to any person
// employed/appointed/acting under the authority of an internal revenue
// law or a revenue provision, when acting or designated as such an
// officer/employee, or having custody/disposition of public money —
// parallel in kind to section 7213(c)'s bearer-widening clause above).
// =======================================================================

pub relation acting_under_internal_revenue_law_authority(p: Person) kind empirical {
    label en unofficial "case fact: p is employed, appointed, or acting under the authority of an internal revenue law, or of a revenue provision of any United States law, designated or acting as an officer or employee in connection with such law, or having the custody or disposition of public money — section 7344's own extension predicate";
}
pub relation treasury_officer_penalty_bearer(p: Person) kind institutional {
    label en unofficial "p is a bearer of every chapter-75 penalty this package models for \"an internal revenue officer or other officer of the Department of the Treasury\" (e.g. sections 7213(b), 7214), by section 7344's extension";
}
@source(IRC_S7344, relation = formalizes, coverage = exact, quote = "All provisions of law imposing fines, penalties, or other punishment for offenses committed by an internal revenue officer or other officer of the Department of the Treasury, or under any agency or office thereof, shall apply to all persons whomsoever, employed, appointed, or acting under the authority of any internal revenue law, or any revenue provision of any law of the United States, when such persons are designated or acting as officers or employees in connection with such law, or are persons having the custody or disposition of any public money.")
rule Section7344ExtendsTreasuryOfficerPenalties(p: Person) strict {
    when acting_under_internal_revenue_law_authority(p);
    then treasury_officer_penalty_bearer(p);
}

// =======================================================================
// Section 7345 — Revocation or denial of passport in case of certain tax
// delinquencies. The Commissioner's certification is modeled as a
// `power` (holder: Commissioner via IRS; over: the individual) whose
// `valid_when` is the section 7345(b) threshold with NO section
// 7345(b)(2) exception applying; its effect is the Secretary's duty to
// transmit the certification to the Secretary of State. Reversal
// (subsection (c)) is the Commissioner's own duty once an exception
// arises or the debt is satisfied.
// =======================================================================

pub relation seriously_delinquent_debt_assessed(ind: Individual) kind empirical {
    label en unofficial "case fact: the unpaid federal tax liability of ind has been assessed — section 7345(b)(1)(A)";
}
pub relation seriously_delinquent_debt_amount(ind: Individual, amount: Money) kind empirical {
    label en unofficial "case fact: the amount of ind's assessed, unpaid, legally enforceable federal tax liability — compared against the section 7345(b)(1)(B) $50,000 threshold (as adjusted for inflation after 2016 by section 7345(f); this package records only the STATUTORY $50,000 figure — the published inflation-adjusted amount for a later year is a Rev. Proc. value this package does not pin, SOURCE_GAP, coverage row 26/7345/f)";
}
pub relation lien_notice_filed_and_rights_exhausted(ind: Individual) kind empirical {
    label en unofficial "case fact: a section 6323 notice of lien has been filed with respect to ind's debt, and the section 6320 administrative hearing rights on that filing have been exhausted or have lapsed — section 7345(b)(1)(C)(i)";
}
pub relation levy_made_for_debt(ind: Individual) kind empirical {
    label en unofficial "case fact: a section 6331 levy has been made with respect to ind's debt — section 7345(b)(1)(C)(ii)";
}
// section 7345(b)(1)(B) threshold, indexed under section 7345(f): the A3 parameter
// `SeriouslyDelinquentDebtThreshold` (seriously-delinquent-debt-threshold.lawparam.json) holds the
// figures published in the Revenue Procedures pinned in us.irc.inflation_adjustments (2025: $64,000,
// 2026: $66,000); the statutory base is $50,000 (module 07 carries the section 7345(f) formula).

// WIRE-5 (Д-19): the three (b)(2) exceptions are read from their owners, not asserted as local case facts.
// `Individual` is a `Person` subtype in `us.irc.core`, so the Person-keyed owner relations take the individual
// directly; the debt here is an AGGREGATE (no Assessment, no taxable year), so each owner relation is lifted by
// an existential over the owner's extra arguments (JUDGMENT CALL: an agreement, hearing request or relief request
// concerning ANY of the individual's assessments/years suspends the aggregate debt; the statute speaks of "a debt",
// this package does not split the aggregate).
relation debt_paid_timely_under_agreement(ind: Individual) kind empirical {
    label en unofficial "case fact: ind's debt is being paid in a timely manner under the agreement — the payment-performance half of section 7345(b)(2)(A); the agreement's own existence is read from its owner";
}
@source(IRC_S7345_B, relation = formalizes, coverage = exact, quote = "(A) a debt that is being paid in a timely manner pursuant to an agreement to which the individual is party under section 6159 or 7122, and")
pub relation installment_agreement_or_offer_in_compromise_in_effect(ind: Individual) kind institutional {
    label en unofficial "ind's debt is being paid in a timely manner under a section 6159 installment agreement in force (us.irc.payment_refunds_interest) or an accepted section 7122 offer-in-compromise (us.irc.collection) to which ind is a party — section 7345(b)(2)(A)";
}
rule Section7345ExceptionAByInstallmentAgreement defeasible {
    for ind: Individual;
    when us.irc.payment_refunds_interest::installment_agreement_in_force(ind)
        and debt_paid_timely_under_agreement(ind);
    then installment_agreement_or_offer_in_compromise_in_effect(ind);
}
rule Section7345ExceptionAByOfferInCompromise defeasible {
    for ind: Individual;
    when us.irc.collection::offer_in_compromise_accepted(ind)
        and debt_paid_timely_under_agreement(ind);
    then installment_agreement_or_offer_in_compromise_in_effect(ind);
}
pub relation cdp_hearing_requested_or_pending_for_debt(ind: Individual) kind institutional {
    label en unofficial "a section 6330 (or, through section 6320(c), section 6320) collection due process hearing has been requested by ind for an assessment — section 7345(b)(2)(B)(i); lifted from us.irc.collection::collection_due_process_requested over the origin, assessment and request date";
}
@source(IRC_S7345_B, relation = formalizes, coverage = exact, quote = "(i) because a due process hearing under section 6330 is requested or pending, or")
rule Section7345ExceptionBHearingRequested defeasible {
    for ind: Individual;
    for origin: us.irc.collection::CDPOrigin;
    for a: us.irc.core::Assessment;
    for requested_on: Date;
    when us.irc.collection::collection_due_process_requested(ind, origin, a, requested_on);
    then cdp_hearing_requested_or_pending_for_debt(ind);
}
pub relation innocent_spouse_relief_elected_or_requested(ind: Individual) kind institutional {
    label en unofficial "ind has made an election under section 6015(b) or (c), or has requested relief under section 6015(f), with respect to a joint return — section 7345(b)(2)(B)(ii); lifted from us.irc.returns::relief_requested_6015 (the REQUEST, not the granted relief)";
}
@source(IRC_S7345_B, relation = formalizes, coverage = exact, quote = "(ii) because an election under subsection (b) or (c) of section 6015 is made or relief under subsection (f) of such section is requested.")
rule Section7345ExceptionBReliefRequested defeasible {
    for ind: Individual;
    for spouse: Individual;
    for y: us.irc.core::TaxableYear;
    when us.irc.returns::relief_requested_6015(ind, spouse, y);
    then innocent_spouse_relief_elected_or_requested(ind);
}
pub relation seriously_delinquent_tax_debt(ind: Individual) kind institutional {
    label en unofficial "ind has a \"seriously delinquent tax debt\" within the meaning of section 7345(b): an assessed, unpaid, legally enforceable federal tax liability exceeding the threshold, with a filed-and-exhausted lien notice or a levy, and none of the (b)(2) exceptions applying";
}
@source(IRC_S7345_B, relation = formalizes, coverage = partial, quote = "the term \"seriously delinquent tax debt\" means an unpaid, legally enforceable Federal tax liability of an individual")
rule Section7345SeriouslyDelinquentByLien(ind: Individual, amount: Money) defeasible {
    when seriously_delinquent_debt_assessed(ind)
        and seriously_delinquent_debt_amount(ind, amount)
        and amount > SeriouslyDelinquentDebtThreshold
        and lien_notice_filed_and_rights_exhausted(ind);
    then seriously_delinquent_tax_debt(ind);
    unless installment_agreement_or_offer_in_compromise_in_effect(ind) and seriously_delinquent_debt_assessed(ind);
    unless cdp_hearing_requested_or_pending_for_debt(ind) and seriously_delinquent_debt_assessed(ind);
    unless innocent_spouse_relief_elected_or_requested(ind) and seriously_delinquent_debt_assessed(ind);
}
@source(IRC_S7345_B, relation = formalizes, coverage = partial, quote = "(ii) a levy is made pursuant to section 6331.")
rule Section7345SeriouslyDelinquentByLevy(ind: Individual, amount: Money) defeasible {
    when seriously_delinquent_debt_assessed(ind)
        and seriously_delinquent_debt_amount(ind, amount)
        and amount > SeriouslyDelinquentDebtThreshold
        and levy_made_for_debt(ind);
    then seriously_delinquent_tax_debt(ind);
    unless installment_agreement_or_offer_in_compromise_in_effect(ind) and seriously_delinquent_debt_assessed(ind);
    unless cdp_hearing_requested_or_pending_for_debt(ind) and seriously_delinquent_debt_assessed(ind);
    unless innocent_spouse_relief_elected_or_requested(ind) and seriously_delinquent_debt_assessed(ind);
}

pub relation certification_transmitted(ind: Individual) kind institutional {
    label en unofficial "the Secretary transmitted the Commissioner's section 7345(a) certification to the Secretary of State for passport action under 49 U.S.C. 32101 (the FAST Act provision)";
}
@source(IRC_S7345_A, relation = formalizes, coverage = exact, quote = "If the Secretary receives certification by the Commissioner of Internal Revenue that an individual has a seriously delinquent tax debt, the Secretary shall transmit such certification to the Secretary of State for action with respect to denial, revocation, or limitation of a passport pursuant to section 32101 of the FAST Act.")
rule Section7345CertificationPowerRule(ind: Individual) strict {
    when seriously_delinquent_tax_debt(ind);
    then power Section7345CertificationPower {
        holder IRS;
        over ind;
        exercise passport_certification_valid(ind);
        valid_when seriously_delinquent_tax_debt(ind);
        effect create(certification_transmitted(ind));
        subject Individual;
        window [-infinity, infinity];
    };
}
pub relation passport_certification_valid(ind: Individual) kind institutional {
    label en unofficial "the Commissioner's section 7345(a) certification for ind is validly exercised (the power's own exercise atom) — a certification issued while none of the (b)(2) exceptions applies and the threshold is exceeded";
}
@source(IRC_S7345_A, relation = formalizes, coverage = exact, quote = "If the Secretary receives certification by the Commissioner of Internal Revenue that an individual has a seriously delinquent tax debt")
rule Section7345CertificationValid(ind: Individual) defeasible {
    when seriously_delinquent_tax_debt(ind);
    then passport_certification_valid(ind);
}

pub relation debt_fully_satisfied_or_unenforceable(ind: Individual) kind empirical {
    label en unofficial "case fact: ind's certified debt has been fully satisfied or has become legally unenforceable — section 7345(c)(1) first reversal ground";
}
pub relation certification_found_erroneous(ind: Individual) kind empirical {
    label en unofficial "case fact: ind's certification has been found erroneous — section 7345(c)(1) second reversal ground";
}
@source(IRC_S7345_C, relation = formalizes, coverage = exact, quote = "the Commissioner shall notify the Secretary (and the Secretary shall subsequently notify the Secretary of State) if such certification is found to be erroneous or if the debt with respect to such certification is fully satisfied or ceases to be a seriously delinquent tax debt by reason of subsection (b)(2).")
rule Section7345ReversalDuty(ind: Individual) strict {
    when passport_certification_valid(ind)
        and (debt_fully_satisfied_or_unenforceable(ind)
            or certification_found_erroneous(ind)
            or installment_agreement_or_offer_in_compromise_in_effect(ind)
            or cdp_hearing_requested_or_pending_for_debt(ind)
            or innocent_spouse_relief_elected_or_requested(ind));
    then duty Section7345ReversalDuty {
        bearer IRS;
        beneficiary ind;
        goal achievement {
            condition reversal_notice_given(ind);
            window [-infinity, infinity];
        }
    };
}
pub relation reversal_notice_given(ind: Individual) kind empirical {
    label en unofficial "case fact: the Commissioner notified the Secretary (who notified the Secretary of State) of the reversal ground for ind, as section 7345(c) requires";
}

pub relation contemporaneous_notice_given(ind: Individual) kind empirical {
    label en unofficial "case fact: the Commissioner contemporaneously notified ind of the section 7345(a) certification (or a section 7345(c) reversal), including the simple, nontechnical description of the section 7345(e) civil-action right — section 7345(d)";
}
@source(IRC_S7345_D, relation = formalizes, coverage = exact, quote = "The Commissioner shall contemporaneously notify an individual of any certification under subsection (a), or any reversal of certification under subsection (c), with respect to such individual. Such notice shall include a description in simple and nontechnical terms of the right to bring a civil action under subsection (e).")
rule Section7345ContemporaneousNoticeDutyRule(ind: Individual) strict {
    when passport_certification_valid(ind);
    then duty Section7345ContemporaneousNoticeDuty {
        bearer IRS;
        beneficiary ind;
        goal achievement {
            condition contemporaneous_notice_given(ind);
            window [-infinity, infinity];
        }
    };
}

// Section 7345(e) (judicial review of certification) is the individual's
// own access to a district court or the Tax Court once notified under
// (d) — the court's determination that a certification was erroneous is
// itself an EXTERNAL_DEPENDENCY (the deciding court's own finding, not
// derived by this package), and the "first court acquiring jurisdiction"
// exclusivity rule is a procedural forum rule this package does not
// separately encode (NON_NORMATIVE for this package's scope).
//
// Section 7345(f)'s inflation adjustment is SOURCE_GAP: the published
// indexed dollar amount for a given post-2016 calendar year is a Rev.
// Proc. figure this package does not pin (see
// Section7345DebtThreshold's label and 00-vocabulary.law's discipline on
// never inventing an indexed amount).
//
// Section 7345(g) (delegation of certification/reversal authority to the
// Deputy Commissioner for Services and Enforcement or an operating
// division Commissioner) is an internal-delegation rule about WHO within
// IRS may exercise the section 7345(a)/(c) power on the Commissioner's
// behalf — this package's `IRS` constant already stands for the holder
// generically; the specific delegate roster is NON_NORMATIVE for this
// package's external interface.
