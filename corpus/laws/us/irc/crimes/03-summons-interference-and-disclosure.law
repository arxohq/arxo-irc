// 26 U.S.C. §§7210-7217 (subchapter A, part I, continued) — failure to
// obey a summons, false statements to purchasers about tax, corrupt or
// forcible interference with administration, unauthorized disclosure and
// inspection of returns (built on `us.irc.confidentiality`), unlawful
// acts of revenue officers, failure to comply with section 7512 trust
// fund special-account duties, disclosure/use by preparers, and executive
// branch influence over audits.

// =======================================================================
// Section 7210 — Failure to obey summons
// =======================================================================

use self::{
    Disclosure,
    IRC_S7210,
    IRC_S7211,
    IRC_S7212_A,
    IRC_S7212_B,
    IRC_S7213A_A,
    IRC_S7213A_B,
    IRC_S7213_A,
    IRC_S7213_B,
    IRC_S7213_D,
    IRC_S7214_A,
    IRC_S7214_B,
    IRC_S7215_A,
    IRC_S7216_A,
    IRC_S7217_A,
    IRC_S7217_B,
    IRC_S7217_D,
    IRC_S7217_E,
    IRS,
    Offense,
    OffenseGrade,
    Person,
    corrupt_or_forcible_intent_established,
    offense_elements_established,
    offense_grade,
    offense_person,
    statutory_maximum_fine_individual,
    statutory_maximum_imprisonment_years,
    willfulness_established,
};

pub relation duly_summoned(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o was duly summoned to appear to testify, or to appear and produce books/accounts/records/memoranda/other papers, under section 6420(e)(2), 6421(g)(2), 6427(j)(2), 7602, 7603, or 7604(b)";
}
pub relation neglected_to_appear_or_produce(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o neglected to appear, or to produce the required books/accounts/records/memoranda/other papers";
}
pub relation offense_7210(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7210: p's conduct in o is a failure-to-obey-summons offense (no mental element named in the text beyond neglect of the summoned duty)";
}
@source(IRC_S7210, relation = formalizes, coverage = exact, quote = "Any person who, being duly summoned to appear to testify, or to appear and produce books, accounts, records, memoranda, or other papers, as required under sections 6420(e)(2), 6421(g)(2), 6427(j)(2), 7602, 7603, and 7604(b), neglects to appear or to produce such books, accounts, records, memoranda, or other papers, shall, upon conviction thereof, be fined not more than $1,000, or imprisoned not more than 1 year, or both, together with costs of prosecution.")
rule Section7210Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and duly_summoned(o)
        and neglected_to_appear_or_produce(o);
    then offense_7210(p, o);
}
rule Section7210FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7210(p, o);
    then offense_elements_established(p, o);
}
const Section7210MaxFine: Money = 1000.00 USD { label en unofficial "section 7210: fine ceiling"; };
rule Section7210MaxFineRule(p: Person, o: Offense) strict {
    when offense_7210(p, o);
    then statutory_maximum_fine_individual(o, Section7210MaxFine);
}
rule Section7210MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7210(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7211 — False statements to purchasers or lessees relating to
// tax (misdemeanor)
// =======================================================================

pub relation false_tax_inclusion_statement(o: Offense) kind empirical {
    label en unofficial "case fact: in connection with a sale/lease/offer of an article, the person alleged in o made a statement (written or oral) intended or calculated to lead a person to believe part of the price consists of a federal tax, or ascribing a specific part of the price to a federal tax, knowing the statement false or the tax not as great as the ascribed portion";
}
pub relation offense_7211(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7211: p's conduct in o is a false-tax-inclusion-statement misdemeanor";
}
@source(IRC_S7211, relation = formalizes, coverage = exact, quote = "knowing that such statement is false or that the tax is not so great as the portion of such price ascribed to such tax, shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished by a fine of not more than $1,000, or by imprisonment for not more than 1 year, or both.")
rule Section7211Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and false_tax_inclusion_statement(o);
    then offense_7211(p, o);
}
rule Section7211FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7211(p, o);
    then offense_elements_established(p, o);
}
rule Section7211Grade(p: Person, o: Offense) strict {
    when offense_7211(p, o);
    then offense_grade(o, Misdemeanor);
}
const Section7211MaxFine: Money = 1000.00 USD { label en unofficial "section 7211: fine ceiling"; };
rule Section7211MaxFineRule(p: Person, o: Offense) strict {
    when offense_7211(p, o);
    then statutory_maximum_fine_individual(o, Section7211MaxFine);
}
rule Section7211MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7211(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7212 — Attempts to interfere with administration of internal
// revenue laws: (a) corrupt/forcible interference (the "omnibus clause"
// included), (b) forcible rescue of seized property
// =======================================================================

pub relation intimidated_or_impeded_officer(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o endeavored to intimidate or impede an officer or employee of the United States acting in an official capacity under this title";
}
pub relation obstructed_due_administration(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o obstructed or impeded, or endeavored to obstruct or impede, the due administration of this title — section 7212(a)'s omnibus clause";
}
pub relation only_threats_of_force(o: Offense) kind empirical {
    label en unofficial "case fact: the offense in o was committed ONLY by threats of force (bodily harm to the officer/employee or a family member), triggering the reduced penalty branch";
}
pub relation offense_7212a(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7212(a): p's conduct in o is corrupt-or-forcible interference with administration of this title";
}
@source(IRC_S7212_A, relation = formalizes, coverage = partial, quote = "Whoever corruptly or by force or threats of force (including any threatening letter or communication) endeavors to intimidate or impede any officer or employee of the United States acting in an official capacity under this title")
rule Section7212aIntimidationOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and intimidated_or_impeded_officer(o)
        and corrupt_or_forcible_intent_established(o);
    then offense_7212a(p, o);
}
@source(IRC_S7212_A, relation = formalizes, coverage = partial, quote = "or in any other way corruptly or by force or threats of force (including any threatening letter or communication) obstructs or impedes, or endeavors to obstruct or impede, the due administration of this title")
rule Section7212aOmnibusOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and obstructed_due_administration(o)
        and corrupt_or_forcible_intent_established(o);
    then offense_7212a(p, o);
}
rule Section7212aFeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7212a(p, o);
    then offense_elements_established(p, o);
}
const Section7212aMaxFine: Money = 5000.00 USD { label en unofficial "section 7212(a): fine ceiling, general branch"; };
const Section7212aThreatsOnlyMaxFine: Money = 3000.00 USD { label en unofficial "section 7212(a): fine ceiling, threats-of-force-only branch"; };
@source(IRC_S7212_A, relation = formalizes, coverage = exact, quote = "shall, upon conviction thereof, be fined not more than $5,000, or imprisoned not more than 3 years, or both")
rule Section7212aMaxFineGeneral(p: Person, o: Offense) defeasible {
    when offense_7212a(p, o);
    then statutory_maximum_fine_individual(o, Section7212aMaxFine);
    unless only_threats_of_force(o) and offense_7212a(p, o);
}
@source(IRC_S7212_A, relation = formalizes, coverage = exact, quote = "except that if the offense is committed only by threats of force, the person convicted thereof shall be fined not more than $3,000, or imprisoned not more than 1 year, or both")
rule Section7212aMaxFineThreatsOnly(p: Person, o: Offense) strict {
    when offense_7212a(p, o)
        and only_threats_of_force(o);
    then statutory_maximum_fine_individual(o, Section7212aThreatsOnlyMaxFine);
}
rule Section7212aMaxImprisonmentGeneral(p: Person, o: Offense) defeasible {
    when offense_7212a(p, o);
    then statutory_maximum_imprisonment_years(o, 3);
    unless only_threats_of_force(o) and offense_7212a(p, o);
}
rule Section7212aMaxImprisonmentThreatsOnly(p: Person, o: Offense) strict {
    when offense_7212a(p, o)
        and only_threats_of_force(o);
    then statutory_maximum_imprisonment_years(o, 1);
}

pub relation forcibly_rescued_seized_property(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o forcibly rescued, caused to be rescued, or attempted/endeavored to rescue property after it was seized under this title";
}
pub relation seized_property_value(o: Offense, amount: Money) kind empirical {
    label en unofficial "case fact: the appraised value of the property rescued in o, used for the double-value fine alternative";
}
pub relation offense_7212b(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7212(b): p's conduct in o is a forcible-rescue-of-seized-property offense";
}
@source(IRC_S7212_B, relation = formalizes, coverage = exact, quote = "Any person who forcibly rescues or causes to be rescued any property after it shall have been seized under this title, or shall attempt or endeavor so to do, shall, excepting in cases otherwise provided for, for every such offense, be fined not more than $500, or not more than double the value of the property so rescued, whichever is the greater, or be imprisoned not more than 2 years.")
rule Section7212bOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and forcibly_rescued_seized_property(o);
    then offense_7212b(p, o);
}
rule Section7212bFeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7212b(p, o);
    then offense_elements_established(p, o);
}
rule Section7212bMaxImprisonment(p: Person, o: Offense) strict {
    when offense_7212b(p, o);
    then statutory_maximum_imprisonment_years(o, 2);
}
// The $500-or-double-value fine ceiling of section 7212(b) needs a
// "greater of" comparison over an empirical Money value
// (`seized_property_value`), not a fixed literal — recorded as a
// TECH_GAP (coverage row 26/7212/b) rather than picking one branch.

// =======================================================================
// Section 7213(a) — Unauthorized disclosure of returns and return
// information. Built on `us.irc.confidentiality`'s section 6103(a)
// prohibition: paragraphs (1)-(2) are the WILLFUL version of that same
// unauthorized disclosure (felony); paragraphs (3)-(5) are distinct
// conduct (print/publish, solicitation, shareholder redisclosure) this
// package models locally over the same `Disclosure`/`ReturnInformation`
// entities so a consumer reading `us.irc.confidentiality::unauthorized_
// disclosure` and this package's `offense_7213` sees the same case.
// =======================================================================

pub relation offense_disclosure(o: Offense, d: Disclosure) kind empirical {
    label en unofficial "case fact: the offense o concerns this Disclosure instance (links this package's Offense to us.irc.confidentiality's Disclosure entity)";
}
pub relation offense_7213_1_or_2(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7213(a)(1)-(2): p's conduct in o is a willful unauthorized disclosure of return or return information by a federal officer/employee/section-6103(n)-person (paragraph 1) or by a State or other described person (paragraph 2)";
}
@source(IRC_S7213_A, relation = formalizes, coverage = partial, quote = "It shall be unlawful for any officer or employee of the United States or any person described in section 6103(n) (or an officer or employee of any such person), or any former officer or employee, willfully to disclose to any person, except as authorized in this title, any return or return information (as defined in section 6103(b)).")
rule Section7213Paragraph1Offense(p: Person, o: Offense, d: Disclosure) strict {
    when offense_person(o, p)
        and offense_disclosure(o, d)
        and us.irc.confidentiality::unauthorized_disclosure(d)
        and us.irc.confidentiality::disclosure_by(d, p)
        and willfulness_established(o);
    then offense_7213_1_or_2(p, o);
}
rule Section7213FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7213_1_or_2(p, o);
    then offense_elements_established(p, o);
}
rule Section7213Paragraph12Grade(p: Person, o: Offense) strict {
    when offense_7213_1_or_2(p, o);
    then offense_grade(o, Felony);
}
const Section7213Paragraph12MaxFine: Money = 5000.00 USD { label en unofficial "section 7213(a)(1)/(2): fine ceiling"; };
@source(IRC_S7213_A, relation = formalizes, coverage = exact, quote = "Any violation of this paragraph shall be a felony punishable upon conviction by a fine in any amount not exceeding $5,000, or imprisonment of not more than 5 years, or both, together with the costs of prosecution")
rule Section7213Paragraph12MaxFineRule(p: Person, o: Offense) strict {
    when offense_7213_1_or_2(p, o);
    then statutory_maximum_fine_individual(o, Section7213Paragraph12MaxFine);
}
rule Section7213Paragraph12MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7213_1_or_2(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

pub relation printed_or_published_unauthorized_return_information(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o, to whom a return or return information was disclosed in a manner unauthorized by this title, thereafter willfully printed or published it in a manner not provided by law — section 7213(a)(3)";
}
pub relation offense_7213_3(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7213(a)(3): p's conduct in o is willful unauthorized printing or publication of return information";
}
@source(IRC_S7213_A, relation = formalizes, coverage = partial, quote = "It shall be unlawful for any person to whom any return or return information (as defined in section 6103(b)) is disclosed in a manner unauthorized by this title thereafter willfully to print or publish in any manner not provided by law any such return or return information.")
rule Section7213Paragraph3Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and printed_or_published_unauthorized_return_information(o)
        and willfulness_established(o);
    then offense_7213_3(p, o);
}
rule Section7213Paragraph3FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7213_3(p, o);
    then offense_elements_established(p, o);
}
rule Section7213Paragraph3Grade(p: Person, o: Offense) strict {
    when offense_7213_3(p, o);
    then offense_grade(o, Felony);
}
rule Section7213Paragraph3MaxFineRule(p: Person, o: Offense) strict {
    when offense_7213_3(p, o);
    then statutory_maximum_fine_individual(o, Section7213Paragraph12MaxFine);
}
rule Section7213Paragraph3MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7213_3(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

pub relation solicited_return_information_for_value(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o willfully offered an item of material value in exchange for return or return information and received it as a result of the solicitation — section 7213(a)(4)";
}
pub relation offense_7213_4(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7213(a)(4): p's conduct in o is willful solicitation of return information for value";
}
@source(IRC_S7213_A, relation = formalizes, coverage = partial, quote = "It shall be unlawful for any person willfully to offer any item of material value in exchange for any return or return information (as defined in section 6103(b)) and to receive as a result of such solicitation any such return or return information.")
rule Section7213Paragraph4Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and solicited_return_information_for_value(o)
        and willfulness_established(o);
    then offense_7213_4(p, o);
}
rule Section7213Paragraph4FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7213_4(p, o);
    then offense_elements_established(p, o);
}
rule Section7213Paragraph4Grade(p: Person, o: Offense) strict {
    when offense_7213_4(p, o);
    then offense_grade(o, Felony);
}
rule Section7213Paragraph4MaxFineRule(p: Person, o: Offense) strict {
    when offense_7213_4(p, o);
    then statutory_maximum_fine_individual(o, Section7213Paragraph12MaxFine);
}
rule Section7213Paragraph4MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7213_4(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

pub relation shareholder_redisclosed_return_information(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o, to whom return or return information was disclosed under section 6103(e)(1)(D)(iii) (>=1% shareholder), willfully disclosed it in a manner not provided by law — section 7213(a)(5)";
}
pub relation offense_7213_5(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7213(a)(5): p's conduct in o is willful shareholder redisclosure";
}
@source(IRC_S7213_A, relation = formalizes, coverage = partial, quote = "It shall be unlawful for any person to whom a return or return information (as defined in section 6103(b)) is disclosed pursuant to the provisions of section 6103(e)(1)(D)(iii) willfully to disclose such return or return information in any manner not provided by law.")
rule Section7213Paragraph5Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and shareholder_redisclosed_return_information(o)
        and willfulness_established(o);
    then offense_7213_5(p, o);
}
rule Section7213Paragraph5FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7213_5(p, o);
    then offense_elements_established(p, o);
}
rule Section7213Paragraph5Grade(p: Person, o: Offense) strict {
    when offense_7213_5(p, o);
    then offense_grade(o, Felony);
}
rule Section7213Paragraph5MaxFineRule(p: Person, o: Offense) strict {
    when offense_7213_5(p, o);
    then statutory_maximum_fine_individual(o, Section7213Paragraph12MaxFine);
}
rule Section7213Paragraph5MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7213_5(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

// section 7213(b) — disclosure of a manufacturer/producer's operations by
// a Treasury officer/employee (misdemeanor; no "willfully" in the text).
pub relation divulged_manufacturer_operations(o: Offense) kind empirical {
    label en unofficial "case fact: the United States officer/employee alleged in o divulged or made known, in a manner not provided by law, the operations/style of work/apparatus of a manufacturer or producer visited in the discharge of official duties — section 7213(b)";
}
pub relation offense_7213b(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7213(b): p's conduct in o is unlawful disclosure of a manufacturer's or producer's operations";
}
@source(IRC_S7213_B, relation = formalizes, coverage = exact, quote = "Any officer or employee of the United States who divulges or makes known in any manner whatever not provided by law to any person the operations, style of work, or apparatus of any manufacturer or producer visited by him in the discharge of his official duties shall be guilty of a misdemeanor and, upon conviction thereof, shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, together with the costs of prosecution; and the offender shall be dismissed from office or discharged from employment.")
rule Section7213bOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and divulged_manufacturer_operations(o);
    then offense_7213b(p, o);
}
rule Section7213bFeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7213b(p, o);
    then offense_elements_established(p, o);
}
rule Section7213bGrade(p: Person, o: Offense) strict {
    when offense_7213b(p, o);
    then offense_grade(o, Misdemeanor);
}
const Section7213bMaxFine: Money = 1000.00 USD { label en unofficial "section 7213(b): fine ceiling"; };
rule Section7213bMaxFineRule(p: Person, o: Offense) strict {
    when offense_7213b(p, o);
    then statutory_maximum_fine_individual(o, Section7213bMaxFine);
}
rule Section7213bMaxImprisonment(p: Person, o: Offense) strict {
    when offense_7213b(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// section 7213(c) is a cross-application clause ("likewise applicable ...
// when performed by any person who is a 'delegate'") and (e) is a pair of
// cross-references — both NON_NORMATIVE for this package: (c) widens the
// BEARER class of the (a)/(b) prohibitions already modeled above rather
// than adding an independent norm (whether `us.irc.confidentiality`'s
// `covered_person` already reaches a section 7701(a)(12)(B) delegate is
// that package's own coverage question, not re-derived here — see
// crimes.deps.json); (e) points to sections 7216 and 18 U.S.C. 1905.

// section 7213(d) — disclosure of "software" (section 7612(d)(1)) in
// violation of section 7612. Section 7612 is not owned by any us.irc.*
// package as of this stage (EXTERNAL_DEPENDENCY, recorded in
// crimes.deps.json) — modeled with a local case fact standing in for the
// section 7612 violation rather than importing an unbuilt symbol.
pub relation disclosed_software_in_violation_of_7612(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o willfully divulged or made known \"software\" (section 7612(d)(1)) to a person, in violation of section 7612. Section 7612 itself is EXTERNAL_DEPENDENCY (no owner package yet) — this fact stands in for that section's own violation classification";
}
pub relation offense_7213d(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7213(d): p's conduct in o is willful unauthorized disclosure of software under section 7612";
}
@source(IRC_S7213_D, relation = formalizes, coverage = exact, quote = "Any person who willfully divulges or makes known software (as defined in section 7612(d)(1)) to any person in violation of section 7612 shall be guilty of a felony and, upon conviction thereof, shall be fined not more than $5,000, or imprisoned not more than 5 years, or both, together with the costs of prosecution.")
rule Section7213dOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and disclosed_software_in_violation_of_7612(o)
        and willfulness_established(o);
    then offense_7213d(p, o);
}
rule Section7213dFeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7213d(p, o);
    then offense_elements_established(p, o);
}
rule Section7213dGrade(p: Person, o: Offense) strict {
    when offense_7213d(p, o);
    then offense_grade(o, Felony);
}
rule Section7213dMaxFineRule(p: Person, o: Offense) strict {
    when offense_7213d(p, o);
    then statutory_maximum_fine_individual(o, Section7213Paragraph12MaxFine);
}
rule Section7213dMaxImprisonment(p: Person, o: Offense) strict {
    when offense_7213d(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

// =======================================================================
// Section 7213A — Unauthorized INSPECTION of returns and return
// information (browsing), parallel to section 7213(a) but for inspection
// rather than disclosure. `us.irc.confidentiality` does not yet publish
// an `unauthorized_inspection` symbol (its stage covers disclosure only,
// per its package.law header) — modeled locally with a case fact standing
// in for that classification (recorded in crimes.deps.json).
// =======================================================================

pub relation unauthorized_inspection_of_return_information(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o inspected a return or return information, except as authorized in this title — section 7213A(a)(1)-(2). us.irc.confidentiality does not yet publish an unauthorized_inspection symbol to import (EXTERNAL_DEPENDENCY, crimes.deps.json)";
}
pub relation offense_7213A(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7213A: p's conduct in o is willful unauthorized inspection of return information";
}
@source(IRC_S7213A_A, relation = formalizes, coverage = partial, quote = "willfully to inspect, except as authorized in this title, any return or return information.")
rule Section7213AOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and unauthorized_inspection_of_return_information(o)
        and willfulness_established(o);
    then offense_7213A(p, o);
}
rule Section7213AFeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7213A(p, o);
    then offense_elements_established(p, o);
}
const Section7213AMaxFine: Money = 1000.00 USD { label en unofficial "section 7213A(b)(1): fine ceiling"; };
@source(IRC_S7213A_B, relation = formalizes, coverage = exact, quote = "Any violation of subsection (a) shall be punishable upon conviction by a fine in any amount not exceeding $1,000, or imprisonment of not more than 1 year, or both, together with the costs of prosecution.")
rule Section7213AMaxFineRule(p: Person, o: Offense) strict {
    when offense_7213A(p, o);
    then statutory_maximum_fine_individual(o, Section7213AMaxFine);
}
rule Section7213AMaxImprisonment(p: Person, o: Offense) strict {
    when offense_7213A(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7214(a) — Unlawful acts of revenue officers or agents (nine
// paragraphs, each with its own conduct+intent language bundled by the
// text itself; modeled as one enum of grounds with a single "misconduct"
// case fact per ground rather than nine separate DECISION-0194 channels,
// since paragraphs (2)-(9) each name their own specific intent/knowledge
// as part of the described act, not a freestanding "willfully" — recorded
// as a judgment call in the report). (b) financial interest in tobacco/
// liquor production. (c) is a cross-reference (NON_NORMATIVE).
// =======================================================================

pub enum Section7214Ground {
    ExtortionOrWillfulOppression;
    KnowinglyDemandsUnauthorizedFee;
    IntentToDefeatTitleByOmission;
    ConspiresOrColludesToDefraudUnitedStates;
    KnowinglyMakesOpportunityToDefraud;
    ActsOrOmitsToEnableFraud;
    FraudulentEntryOrCertificate;
    FailsToReportKnownViolation;
    DemandsPaymentForCompromiseOfCharge;
}
pub relation revenue_officer_misconduct(o: Offense, ground: Section7214Ground) kind empirical {
    label en unofficial "case fact: the United States officer/employee alleged in o, acting in connection with a revenue law, engaged in the conduct section 7214(a)'s numbered paragraph for this ground describes";
}
pub relation offense_7214a(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7214(a): p's conduct in o is an unlawful act by a revenue officer or employee";
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who is guilty of any extortion or willful oppression under color of law")
rule Section7214GroundOne(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, ExtortionOrWillfulOppression);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who knowingly demands other or greater sums than are authorized by law, or receives any fee, compensation, or reward, except as by law prescribed, for the performance of any duty")
rule Section7214GroundTwo(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, KnowinglyDemandsUnauthorizedFee);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who with intent to defeat the application of any provision of this title fails to perform any of the duties of his office or employment")
rule Section7214GroundThree(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, IntentToDefeatTitleByOmission);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who conspires or colludes with any other person to defraud the United States")
rule Section7214GroundFour(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, ConspiresOrColludesToDefraudUnitedStates);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who knowingly makes opportunity for any person to defraud the United States")
rule Section7214GroundFive(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, KnowinglyMakesOpportunityToDefraud);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who does or omits to do any act with intent to enable any other person to defraud the United States")
rule Section7214GroundSix(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, ActsOrOmitsToEnableFraud);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who makes or signs any fraudulent entry in any book, or makes or signs any fraudulent certificate, return, or statement")
rule Section7214GroundSeven(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, FraudulentEntryOrCertificate);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who, having knowledge or information of the violation of any revenue law by any person, or of fraud committed by any person against the United States under any revenue law, fails to report, in writing, such knowledge or information to the Secretary")
rule Section7214GroundEight(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, FailsToReportKnownViolation);
    then offense_7214a(p, o);
}
@source(IRC_S7214_A, relation = formalizes, coverage = partial, quote = "who demands, or accepts, or attempts to collect, directly or indirectly as payment or gift, or otherwise, any sum of money or other thing of value for the compromise, adjustment, or settlement of any charge or complaint for any violation or alleged violation of law, except as expressly authorized by law so to do")
rule Section7214GroundNine(p: Person, o: Offense) strict {
    when offense_person(o, p) and revenue_officer_misconduct(o, DemandsPaymentForCompromiseOfCharge);
    then offense_7214a(p, o);
}
rule Section7214FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7214a(p, o);
    then offense_elements_established(p, o);
}
const Section7214MaxFine: Money = 10000.00 USD { label en unofficial "section 7214(a): fine ceiling"; };
@source(IRC_S7214_A, relation = formalizes, coverage = exact, quote = "shall be dismissed from office or discharged from employment and, upon conviction thereof, shall be fined not more than $10,000, or imprisoned not more than 5 years, or both.")
rule Section7214MaxFineRule(p: Person, o: Offense) strict {
    when offense_7214a(p, o);
    then statutory_maximum_fine_individual(o, Section7214MaxFine);
}
rule Section7214MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7214a(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}
// The informer's-share award ("out of the fine ... an amount, not in
// excess of one-half thereof") and the civil damages judgment "for the
// amount of damages sustained" are sentencing/remedy discretion of the
// convicting court — EXTERNAL_DEPENDENCY, not derived.

pub relation interested_in_tobacco_or_liquor_production(o: Offense) kind empirical {
    label en unofficial "case fact: the internal revenue officer/employee alleged in o is directly or indirectly interested in the manufacture of tobacco/snuff/cigarettes, or in the production/rectification/redistillation of distilled spirits — section 7214(b)";
}
pub relation offense_7214b(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7214(b): p's conduct in o is a prohibited financial interest in tobacco or liquor production";
}
@source(IRC_S7214_B, relation = formalizes, coverage = exact, quote = "Any internal revenue officer or employee interested, directly or indirectly, in the manufacture of tobacco, snuff, or cigarettes, or in the production, rectification, or redistillation of distilled spirits, shall be dismissed from office; and each such officer or employee so interested in any such manufacture or production, rectification, or redistillation or production of fermented liquors shall be fined not more than $5,000.")
rule Section7214bOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and interested_in_tobacco_or_liquor_production(o);
    then offense_7214b(p, o);
}
rule Section7214bFeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7214b(p, o);
    then offense_elements_established(p, o);
}
const Section7214bMaxFine: Money = 5000.00 USD { label en unofficial "section 7214(b): fine ceiling"; };
rule Section7214bMaxFineRule(p: Person, o: Offense) strict {
    when offense_7214b(p, o);
    then statutory_maximum_fine_individual(o, Section7214bMaxFine);
}
// section 7214(b) has no imprisonment ceiling in the text (dismissal +
// fine only) — no statutory_maximum_imprisonment_years rule for it.

// =======================================================================
// Section 7215 — Failure to comply with section 7512(b) (trust fund
// special-account requirements), with two statutory exceptions
// =======================================================================

pub relation failed_to_comply_with_7512b(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to comply with a provision of section 7512(b)";
}
pub relation reasonable_doubt_on_collection_duty_or_who_must_collect(o: Offense) kind empirical {
    label en unofficial "case fact: there was reasonable doubt whether the law required collection of tax, or as to who was required by law to collect it — section 7215(b)(1)";
}
pub relation noncompliance_due_to_circumstances_beyond_control(o: Offense) kind empirical {
    label en unofficial "case fact: the failure to comply with section 7512(b) was due to circumstances beyond the person's control — section 7215(b)(2). A lack of funds existing immediately after paying wages is NOT such a circumstance regardless of whether the wage payment created the shortfall (the section's own flush language) and must not be asserted as this fact for that scenario";
}
pub relation offense_7215(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7215: p's conduct in o is a failure to comply with section 7512(b), after the two statutory exceptions are applied";
}
@source(IRC_S7215_A, relation = formalizes, coverage = exact, quote = "Any person who fails to comply with any provision of section 7512(b) shall, in addition to any other penalties provided by law, be guilty of a misdemeanor, and, upon conviction thereof, shall be fined not more than $5,000, or imprisoned not more than one year, or both, together with the costs of prosecution.")
rule Section7215Offense(p: Person, o: Offense) defeasible {
    when offense_person(o, p)
        and failed_to_comply_with_7512b(o);
    then offense_7215(p, o);
    unless reasonable_doubt_on_collection_duty_or_who_must_collect(o) and offense_person(o, p) and failed_to_comply_with_7512b(o);
    unless noncompliance_due_to_circumstances_beyond_control(o) and offense_person(o, p) and failed_to_comply_with_7512b(o);
}
rule Section7215FeedsElementsAggregate(p: Person, o: Offense) defeasible {
    when offense_7215(p, o);
    then offense_elements_established(p, o);
}
rule Section7215Grade(p: Person, o: Offense) defeasible {
    when offense_7215(p, o);
    then offense_grade(o, Misdemeanor);
}
const Section7215MaxFine: Money = 5000.00 USD { label en unofficial "section 7215: fine ceiling"; };
rule Section7215MaxFineRule(p: Person, o: Offense) defeasible {
    when offense_7215(p, o);
    then statutory_maximum_fine_individual(o, Section7215MaxFine);
}
rule Section7215MaxImprisonment(p: Person, o: Offense) defeasible {
    when offense_7215(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7216 — Disclosure or use of information by return preparers.
// Mental element is "knowingly or recklessly" — a DIFFERENT word from
// Part I's recurring "willfully"; modeled with its own DECISION-0194
// channel rather than reusing willfulness_established.
// =======================================================================

pub relation return_preparer(p: Person) kind empirical {
    label en unofficial "case fact: p is engaged in the business of preparing (or providing services in connection with the preparation of) chapter 1 returns, or prepares such a return for another person for compensation — section 7216(a)";
}
pub relation disclosed_return_preparation_information(o: Offense) kind empirical {
    label en unofficial "case fact: the preparer alleged in o disclosed information furnished for or in connection with preparing a return — section 7216(a)(1)";
}
pub relation used_return_preparation_information_for_other_purpose(o: Offense) kind empirical {
    label en unofficial "case fact: the preparer alleged in o used such information for a purpose other than preparing or assisting in preparing a return — section 7216(a)(2)";
}
pub relation disclosure_permitted_by_other_title_provision(o: Offense) kind empirical {
    label en unofficial "case fact: the disclosure in o was made pursuant to another provision of this title — section 7216(b)(1)(A)";
}
pub relation disclosure_ordered_by_court(o: Offense) kind empirical {
    label en unofficial "case fact: the disclosure in o was made pursuant to a court order — section 7216(b)(1)(B)";
}
pub relation use_for_state_or_local_return_of_same_person(o: Offense) kind empirical {
    label en unofficial "case fact: the use in o was for preparing State/local tax returns or estimated-tax declarations of the SAME person the information relates to — section 7216(b)(2)";
}
pub relation disclosure_or_use_permitted_by_regulation(o: Offense) kind empirical {
    label en unofficial "case fact: the disclosure or use in o is permitted by Secretary regulations under section 7216(b)(3) (e.g. quality or peer review)";
}
external judgment relation knowing_or_reckless_disclosure_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds the preparer's disclosure or use in o was done knowingly or recklessly — section 7216(a)'s mental element (distinct from \"willfully\")";
}
pub relation offense_7216(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7216: p's conduct in o is unlawful disclosure or use of return preparation information, after the (b) exceptions are applied";
}
@source(IRC_S7216_A, relation = formalizes, coverage = partial, quote = "discloses any information furnished to him for, or in connection with, the preparation of any such return")
rule Section7216DisclosureOffense(p: Person, o: Offense) defeasible {
    when offense_person(o, p)
        and return_preparer(p)
        and disclosed_return_preparation_information(o)
        and knowing_or_reckless_disclosure_established(o);
    then offense_7216(p, o);
    unless disclosure_permitted_by_other_title_provision(o) and offense_person(o, p) and return_preparer(p) and disclosed_return_preparation_information(o);
    unless disclosure_ordered_by_court(o) and offense_person(o, p) and return_preparer(p) and disclosed_return_preparation_information(o);
    unless disclosure_or_use_permitted_by_regulation(o) and offense_person(o, p) and return_preparer(p) and disclosed_return_preparation_information(o);
}
@source(IRC_S7216_A, relation = formalizes, coverage = partial, quote = "uses any such information for any purpose other than to prepare, or assist in preparing, any such return")
rule Section7216UseOffense(p: Person, o: Offense) defeasible {
    when offense_person(o, p)
        and return_preparer(p)
        and used_return_preparation_information_for_other_purpose(o)
        and knowing_or_reckless_disclosure_established(o);
    then offense_7216(p, o);
    unless use_for_state_or_local_return_of_same_person(o) and offense_person(o, p) and return_preparer(p) and used_return_preparation_information_for_other_purpose(o);
    unless disclosure_or_use_permitted_by_regulation(o) and offense_person(o, p) and return_preparer(p) and used_return_preparation_information_for_other_purpose(o);
}
rule Section7216FeedsElementsAggregate(p: Person, o: Offense) defeasible {
    when offense_7216(p, o);
    then offense_elements_established(p, o);
}
rule Section7216Grade(p: Person, o: Offense) defeasible {
    when offense_7216(p, o);
    then offense_grade(o, Misdemeanor);
}
const Section7216MaxFine: Money = 1000.00 USD {
    label en unofficial "section 7216: fine ceiling for an ordinary violation ($100,000 applies to a disclosure/use to which section 6713(b) applies — that heightened-fine branch is EXTERNAL_DEPENDENCY on us.irc.information_reporting's section 6713, not modeled here)";
};
rule Section7216MaxFineRule(p: Person, o: Offense) defeasible {
    when offense_7216(p, o);
    then statutory_maximum_fine_individual(o, Section7216MaxFine);
}
rule Section7216MaxImprisonment(p: Person, o: Offense) defeasible {
    when offense_7216(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7217 — Prohibition on executive branch influence over taxpayer
// audits: (a) prohibition (a "power"-adjacent prohibition, not a duty of
// the requester), (b) IRS officer's reporting duty, (c) exceptions,
// (d) penalty, (e) "applicable person" definition
// =======================================================================

pub relation applicable_person(p: Person) kind institutional {
    label en unofficial "p is an \"applicable person\" under section 7217(e): the President, Vice President, an employee of either's executive office, or an individual (other than the Attorney General) serving in a section 5312 Executive Schedule position";
}
pub relation executive_office_employee(p: Person) kind empirical {
    label en unofficial "case fact: p is an employee of the executive office of the President or of the executive office of the Vice President";
}
pub relation president_or_vice_president(p: Person) kind empirical {
    label en unofficial "case fact: p is the President or the Vice President";
}
pub relation executive_schedule_position_holder(p: Person) kind empirical {
    label en unofficial "case fact: p serves in a position specified in 5 U.S.C. 5312, other than the Attorney General";
}
@source(IRC_S7217_E, relation = formalizes, coverage = exact, quote = "the President, the Vice President, any employee of the executive office of the President, and any employee of the executive office of the Vice President")
rule Section7217ApplicablePersonExecutiveOffice(p: Person) strict {
    when president_or_vice_president(p) or executive_office_employee(p);
    then applicable_person(p);
}
@source(IRC_S7217_E, relation = formalizes, coverage = exact, quote = "any individual (other than the Attorney General of the United States) serving in a position specified in section 5312 of title 5, United States Code")
rule Section7217ApplicablePersonExecutiveSchedule(p: Person) strict {
    when executive_schedule_position_holder(p);
    then applicable_person(p);
}

pub relation requested_audit_or_termination(o: Offense) kind empirical {
    label en unofficial "case fact: the applicable person alleged in o requested, directly or indirectly, an IRS officer or employee to conduct or terminate an audit or other investigation of a particular taxpayer's tax liability — section 7217(a)";
}
pub relation request_forwarded_by_applicable_person_on_behalf_of_taxpayer(o: Offense) kind empirical {
    label en unofficial "case fact: the request in o was a written request made to the applicable person by or on behalf of the taxpayer and forwarded by the applicable person to the IRS — section 7217(c)(1)";
}
pub relation request_for_6103_disclosure_in_accordance_with_6103(o: Offense) kind empirical {
    label en unofficial "case fact: the request in o was a written request by an applicable person for disclosure of return or return information under section 6103, made in accordance with that section's requirements — section 7217(c)(2)";
}
pub relation request_by_secretary_implementing_tax_policy_change(o: Offense) kind empirical {
    label en unofficial "case fact: the request in o was a written request by the Secretary of the Treasury as a consequence of implementing a change in tax policy — section 7217(c)(3)";
}
pub relation offense_7217a(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7217(a)/(d): p's conduct in o is a willful violation of the prohibition on requesting an audit or its termination, after the (c) exceptions are applied";
}
@source(IRC_S7217_A, relation = formalizes, coverage = exact, quote = "It shall be unlawful for any applicable person to request, directly or indirectly, any officer or employee of the Internal Revenue Service to conduct or terminate an audit or other investigation of any particular taxpayer with respect to the tax liability of such taxpayer.")
rule Section7217aOffense(p: Person, o: Offense) defeasible {
    when offense_person(o, p)
        and applicable_person(p)
        and requested_audit_or_termination(o)
        and willfulness_established(o);
    then offense_7217a(p, o);
    unless request_forwarded_by_applicable_person_on_behalf_of_taxpayer(o) and offense_person(o, p) and applicable_person(p) and requested_audit_or_termination(o);
    unless request_for_6103_disclosure_in_accordance_with_6103(o) and offense_person(o, p) and applicable_person(p) and requested_audit_or_termination(o);
    unless request_by_secretary_implementing_tax_policy_change(o) and offense_person(o, p) and applicable_person(p) and requested_audit_or_termination(o);
}
rule Section7217aFeedsElementsAggregate(p: Person, o: Offense) defeasible {
    when offense_7217a(p, o);
    then offense_elements_established(p, o);
}
const Section7217MaxFine: Money = 5000.00 USD { label en unofficial "section 7217(d): fine ceiling"; };
@source(IRC_S7217_D, relation = formalizes, coverage = partial, quote = "Any person who willfully violates subsection (a) or fails to report under subsection (b) shall be punished upon conviction by a fine in any amount not exceeding $5,000, or imprisonment of not more than 5 years, or both, together with the costs of prosecution.")
rule Section7217aMaxFineRule(p: Person, o: Offense) defeasible {
    when offense_7217a(p, o);
    then statutory_maximum_fine_individual(o, Section7217MaxFine);
}
rule Section7217aMaxImprisonment(p: Person, o: Offense) defeasible {
    when offense_7217a(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

// section 7217(b) — the IRS officer/employee's OWN duty to report a
// prohibited request to TIGTA. Modeled as a duty (not an offense of the
// requester), and its breach separately criminalized by (d)'s second
// branch ("or fails to report under subsection (b)") — modeled as a
// distinct offense head sharing the same fine/imprisonment ceiling.
pub relation received_prohibited_audit_request(o: Offense) kind empirical {
    label en unofficial "case fact: the IRS officer/employee alleged in o received a request prohibited by section 7217(a) — triggers the reporting duty of section 7217(b)";
}
pub relation reported_to_tigta(o: Offense) kind empirical {
    label en unofficial "case fact: the IRS officer/employee alleged in o reported the receipt of the prohibited request to the Treasury Inspector General for Tax Administration, as section 7217(b) requires";
}
@source(IRC_S7217_B, relation = formalizes, coverage = exact, quote = "Any officer or employee of the Internal Revenue Service receiving any request prohibited by subsection (a) shall report the receipt of such request to the Treasury Inspector General for Tax Administration.")
rule Section7217bReportingDuty(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and received_prohibited_audit_request(o);
    then duty Section7217bDuty {
        bearer p;
        beneficiary IRS;
        goal achievement {
            condition reported_to_tigta(o);
            window [-infinity, infinity];
        }
    };
}
pub relation offense_7217b(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7217(d), second branch: p's conduct in o is a failure to report a prohibited audit request under section 7217(b)";
}
@source(IRC_S7217_D, relation = formalizes, coverage = partial, quote = "or fails to report under subsection (b)")
rule Section7217bOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and received_prohibited_audit_request(o)
        and not_known(reported_to_tigta(o));
    then offense_7217b(p, o);
}
rule Section7217bFeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7217b(p, o);
    then offense_elements_established(p, o);
}
rule Section7217bMaxFineRule(p: Person, o: Offense) strict {
    when offense_7217b(p, o);
    then statutory_maximum_fine_individual(o, Section7217MaxFine);
}
rule Section7217bMaxImprisonment(p: Person, o: Offense) strict {
    when offense_7217b(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}
