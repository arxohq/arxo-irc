// 26 U.S.C. §§7204-7209 (subchapter A, part I) — fraudulent statements,
// withholding-certificate fraud, section 7206 perjury/aiding/fraudulent-
// document/removal-concealment/compromise offenses, fraudulent returns,
// stamp offenses, and unauthorized stamp dealing. Sections 7204, 7205,
// 7207 do NOT use the word "guilty of a felony/misdemeanor" — this module
// records only the punishment ceilings the text states and leaves
// `offense_grade` undetermined for them rather than inventing a grade the
// text does not name (see coverage rows 26/7204/u1, 26/7205/*, 26/7207/*).

// =======================================================================
// Section 7204 — Fraudulent statement or failure to make statement to
// employees (section 6051 wage statements)
// =======================================================================

use self::{
    Corporation,
    IRC_S7204,
    IRC_S7205_A,
    IRC_S7205_B,
    IRC_S7206,
    IRC_S7207,
    IRC_S7208,
    IRC_S7209,
    Individual,
    Offense,
    OffenseGrade,
    Person,
    intent_to_defraud_established,
    intent_to_evade_or_defeat_established,
    offense_elements_established,
    offense_grade,
    offense_person,
    statutory_maximum_fine_corporate,
    statutory_maximum_fine_individual,
    statutory_maximum_imprisonment_years,
    willfulness_established,
};

pub relation required_to_furnish_6051_statement(p: Person) kind empirical {
    label en unofficial "case fact: p is required under section 6051 to furnish a wage statement";
}
pub relation furnished_false_or_fraudulent_6051_statement(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o furnished a false or fraudulent section 6051 statement";
}
pub relation failed_to_furnish_6051_statement(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to furnish the section 6051 statement in the manner, at the time, and showing the information the section (or its regulations) require";
}

pub relation offense_7204(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7204: p's conduct in o is a fraudulent-statement-to-employees offense";
}
@source(IRC_S7204, relation = formalizes, coverage = exact, quote = "any person required under the provisions of section 6051 to furnish a statement who willfully furnishes a false or fraudulent statement or who willfully fails to furnish a statement in the manner, at the time, and showing the information required under section 6051, or regulations prescribed thereunder, shall, for each such offense, upon conviction thereof, be fined not more than $1,000, or imprisoned not more than 1 year, or both")
rule Section7204FalseStatementOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and required_to_furnish_6051_statement(p)
        and furnished_false_or_fraudulent_6051_statement(o)
        and willfulness_established(o);
    then offense_7204(p, o);
}
@source(IRC_S7204, relation = formalizes, coverage = exact, quote = "who willfully fails to furnish a statement in the manner, at the time, and showing the information required under section 6051")
rule Section7204FailureToFurnishOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and required_to_furnish_6051_statement(p)
        and failed_to_furnish_6051_statement(o)
        and willfulness_established(o);
    then offense_7204(p, o);
}
rule Section7204FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7204(p, o);
    then offense_elements_established(p, o);
}
const Section7204MaxFine: Money = 1000.00 USD {
    label en unofficial "section 7204: fine ceiling, per offense — reference value only";
};
@source(IRC_S7204, relation = formalizes, coverage = exact, quote = "be fined not more than $1,000, or imprisoned not more than 1 year, or both")
rule Section7204MaxFineRule(p: Person, o: Offense) strict {
    when offense_7204(p, o);
    then statutory_maximum_fine_individual(o, Section7204MaxFine);
}
rule Section7204MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7204(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7205 — Fraudulent withholding exemption certificate:
// (a) wages (section 3402), (b) backup withholding (section 3406(d))
// =======================================================================

pub relation supplied_false_withholding_information(o: Offense) kind empirical {
    label en unofficial "case fact: the individual alleged in o willfully supplied false or fraudulent information under section 3402, or willfully failed to supply information that would require an increase in withholding";
}
pub relation offense_7205a(p: Individual, o: Offense) kind institutional {
    label en unofficial "section 7205(a): p's conduct in o is a fraudulent wage-withholding-certificate offense";
}
@source(IRC_S7205_A, relation = formalizes, coverage = exact, quote = "Any individual required to supply information to his employer under section 3402 who willfully supplies false or fraudulent information, or who willfully fails to supply information thereunder which would require an increase in the tax to be withheld under section 3402, shall, in addition to any other penalty provided by law, upon conviction thereof, be fined not more than $1,000, or imprisoned not more than 1 year, or both.")
rule Section7205aOffense(p: Individual, o: Offense) strict {
    when offense_person(o, p)
        and supplied_false_withholding_information(o)
        and willfulness_established(o);
    then offense_7205a(p, o);
}
rule Section7205aFeedsElementsAggregate(p: Individual, o: Offense) strict {
    when offense_7205a(p, o);
    then offense_elements_established(p, o);
}

pub relation false_backup_withholding_certification(o: Offense) kind empirical {
    label en unofficial "case fact: the individual alleged in o willfully made a false certification under section 3406(d)(1) or (2)(C)";
}
pub relation offense_7205b(p: Individual, o: Offense) kind institutional {
    label en unofficial "section 7205(b): p's conduct in o is a false backup-withholding certification offense";
}
@source(IRC_S7205_B, relation = formalizes, coverage = exact, quote = "If any individual willfully makes a false certification under paragraph (1) or (2)(C) of section 3406(d), then such individual shall, in addition to any other penalty provided by law, upon conviction thereof, be fined not more than $1,000, or imprisoned not more than 1 year, or both.")
rule Section7205bOffense(p: Individual, o: Offense) strict {
    when offense_person(o, p)
        and false_backup_withholding_certification(o)
        and willfulness_established(o);
    then offense_7205b(p, o);
}
rule Section7205bFeedsElementsAggregate(p: Individual, o: Offense) strict {
    when offense_7205b(p, o);
    then offense_elements_established(p, o);
}
const Section7205MaxFine: Money = 1000.00 USD {
    label en unofficial "section 7205(a) and (b) share the same $1,000/1-year ceiling";
};
rule Section7205aMaxFineRule(p: Individual, o: Offense) strict {
    when offense_7205a(p, o);
    then statutory_maximum_fine_individual(o, Section7205MaxFine);
}
rule Section7205aMaxImprisonment(p: Individual, o: Offense) strict {
    when offense_7205a(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}
rule Section7205bMaxFineRule(p: Individual, o: Offense) strict {
    when offense_7205b(p, o);
    then statutory_maximum_fine_individual(o, Section7205MaxFine);
}
rule Section7205bMaxImprisonment(p: Individual, o: Offense) strict {
    when offense_7205b(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7206 — Fraud and false statements. Five independently
// sufficient offenses (paragraphs (1)-(5)); a single "shall be guilty of
// a felony" sentence covers all five (E-0237-style shared consequence
// over independent conditions -> one offense_7206 head fed by five rules).
// =======================================================================

pub relation perjured_declaration(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o willfully made and subscribed a return, statement, or other document containing a written declaration made under penalties of perjury, which the person did not believe to be true and correct as to every material matter — section 7206(1)";
}
pub relation aided_or_assisted_fraudulent_document(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o willfully aided, assisted, procured, counseled, or advised the preparation or presentation of a return, affidavit, claim, or other document under the internal revenue laws that is fraudulent or false as to a material matter — section 7206(2); falsity/fraud need not be with the knowledge of the person authorized to present it";
}
pub relation fraudulent_bond_permit_or_entry(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o simulated, or falsely/fraudulently executed or signed (or procured the false/fraudulent execution of, or advised/aided/connived at), any bond, permit, entry, or other document required by the internal revenue laws or regulations — section 7206(3)";
}
pub relation removed_or_concealed_taxable_property(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o removed, deposited, or concealed (or was concerned in removing, depositing, or concealing) goods, commodities, or property subject to a tax or levy under section 6331 — section 7206(4)";
}
pub relation concealed_property_in_compromise(o: Offense) kind empirical {
    label en unofficial "case fact: in connection with a section 7122 compromise (or offer) or a section 7121 closing agreement (or offer), the person alleged in o willfully concealed from a United States officer or employee property belonging to the taxpayer's (or other liable person's) estate — section 7206(5)(A)";
}
pub relation falsified_records_in_compromise(o: Offense) kind empirical {
    label en unofficial "case fact: in connection with a section 7122 compromise (or offer) or a section 7121 closing agreement (or offer), the person alleged in o willfully received, withheld, destroyed, mutilated, or falsified a book, document, or record, or made a false statement, relating to the estate or financial condition of the taxpayer or other liable person — section 7206(5)(B)";
}

pub relation offense_7206(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7206: p's conduct in o satisfies at least one of the five paragraph-(1)-(5) fraud offenses";
}
@source(IRC_S7206, relation = formalizes, coverage = partial, quote = "Willfully makes and subscribes any return, statement, or other document, which contains or is verified by a written declaration that it is made under the penalties of perjury, and which he does not believe to be true and correct as to every material matter")
rule Section7206Paragraph1Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and perjured_declaration(o)
        and willfulness_established(o);
    then offense_7206(p, o);
}
@source(IRC_S7206, relation = formalizes, coverage = partial, quote = "Willfully aids or assists in, or procures, counsels, or advises the preparation or presentation under, or in connection with any matter arising under, the internal revenue laws, of a return, affidavit, claim, or other document, which is fraudulent or is false as to any material matter")
rule Section7206Paragraph2Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and aided_or_assisted_fraudulent_document(o)
        and willfulness_established(o);
    then offense_7206(p, o);
}
@source(IRC_S7206, relation = formalizes, coverage = partial, quote = "Simulates or falsely or fraudulently executes or signs any bond, permit, entry, or other document required by the provisions of the internal revenue laws, or by any regulation made in pursuance thereof, or procures the same to be falsely or fraudulently executed, or advises, aids in, or connives at such execution thereof")
rule Section7206Paragraph3Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and fraudulent_bond_permit_or_entry(o);
    then offense_7206(p, o);
}
@source(IRC_S7206, relation = formalizes, coverage = partial, quote = "Removes, deposits, or conceals, or is concerned in removing, depositing, or concealing, any goods or commodities for or in respect whereof any tax is or shall be imposed, or any property upon which levy is authorized by section 6331, with intent to evade or defeat the assessment or collection of any tax imposed by this title")
rule Section7206Paragraph4Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and removed_or_concealed_taxable_property(o)
        and intent_to_evade_or_defeat_established(o);
    then offense_7206(p, o);
}
@source(IRC_S7206, relation = formalizes, coverage = partial, quote = "Conceals from any officer or employee of the United States any property belonging to the estate of a taxpayer or other person liable in respect of the tax")
rule Section7206Paragraph5AOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and concealed_property_in_compromise(o)
        and willfulness_established(o);
    then offense_7206(p, o);
}
@source(IRC_S7206, relation = formalizes, coverage = partial, quote = "Receives, withholds, destroys, mutilates, or falsifies any book, document, or record, or makes any false statement, relating to the estate or financial condition of the taxpayer or other person liable in respect of the tax")
rule Section7206Paragraph5BOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and falsified_records_in_compromise(o)
        and willfulness_established(o);
    then offense_7206(p, o);
}
rule Section7206FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7206(p, o);
    then offense_elements_established(p, o);
}
@source(IRC_S7206, relation = formalizes, coverage = exact, quote = "shall be guilty of a felony and, upon conviction thereof, shall be fined not more than $100,000 ($500,000 in the case of a corporation), or imprisoned not more than 3 years, or both, together with the costs of prosecution.")
rule Section7206Grade(p: Person, o: Offense) strict {
    when offense_7206(p, o);
    then offense_grade(o, Felony);
}
const Section7206MaxFineIndividual: Money = 100000.00 USD {
    label en unofficial "section 7206: fine ceiling for an individual defendant";
};
const Section7206MaxFineCorporate: Money = 500000.00 USD {
    label en unofficial "section 7206: fine ceiling for a corporate defendant";
};
rule Section7206MaxFineForIndividual(p: Individual, o: Offense) strict {
    when offense_7206(p, o);
    then statutory_maximum_fine_individual(o, Section7206MaxFineIndividual);
}
rule Section7206MaxFineForCorporation(p: Corporation, o: Offense) strict {
    when offense_7206(p, o);
    then statutory_maximum_fine_corporate(o, Section7206MaxFineCorporate);
}
rule Section7206MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7206(p, o);
    then statutory_maximum_imprisonment_years(o, 3);
}

// =======================================================================
// Section 7207 — Fraudulent returns, statements, or other documents
// =======================================================================

pub relation delivered_or_disclosed_known_fraudulent_document(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o willfully delivered or disclosed to the Secretary a list, return, account, statement, or other document known by that person to be fraudulent or false as to a material matter — section 7207 first sentence";
}
pub relation furnished_known_fraudulent_information_under_6047_6104_527(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o, required under section 6047(b), section 6104(d), or section 527(i)/(j) to furnish information, willfully furnished information known to be fraudulent or false as to a material matter — section 7207 second sentence";
}
pub relation offense_7207(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7207: p's conduct in o is a fraudulent-document-delivery offense";
}
@source(IRC_S7207, relation = formalizes, coverage = exact, quote = "Any person who willfully delivers or discloses to the Secretary any list, return, account, statement, or other document, known by him to be fraudulent or to be false as to any material matter, shall be fined not more than $10,000 ($50,000 in the case of a corporation), or imprisoned not more than 1 year, or both.")
rule Section7207FirstSentenceOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and delivered_or_disclosed_known_fraudulent_document(o)
        and willfulness_established(o);
    then offense_7207(p, o);
}
@source(IRC_S7207, relation = formalizes, coverage = exact, quote = "Any person required pursuant to section 6047(b), section 6104(d), or subsection (i) or (j) of section 527 to furnish any information to the Secretary or any other person who willfully furnishes to the Secretary or such other person any information known by him to be fraudulent or to be false as to any material matter shall be fined not more than $10,000 ($50,000 in the case of a corporation), or imprisoned not more than 1 year, or both.")
rule Section7207SecondSentenceOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and furnished_known_fraudulent_information_under_6047_6104_527(o)
        and willfulness_established(o);
    then offense_7207(p, o);
}
rule Section7207FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7207(p, o);
    then offense_elements_established(p, o);
}
const Section7207MaxFineIndividual: Money = 10000.00 USD {
    label en unofficial "section 7207: fine ceiling for an individual defendant";
};
const Section7207MaxFineCorporate: Money = 50000.00 USD {
    label en unofficial "section 7207: fine ceiling for a corporate defendant";
};
rule Section7207MaxFineForIndividual(p: Individual, o: Offense) strict {
    when offense_7207(p, o);
    then statutory_maximum_fine_individual(o, Section7207MaxFineIndividual);
}
rule Section7207MaxFineForCorporation(p: Corporation, o: Offense) strict {
    when offense_7207(p, o);
    then statutory_maximum_fine_corporate(o, Section7207MaxFineCorporate);
}
rule Section7207MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7207(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
}

// =======================================================================
// Section 7208 — Offenses relating to stamps (paragraphs (1)-(5); the
// last incorporates section 7271's offense by reference "with intent to
// defraud the revenue, or to defraud any person"). Modeled at the grade
// of the five umbrella conduct classes, not every lettered sub-clause of
// paragraphs (3)-(4), which is recorded as a coverage-row simplification.
// =======================================================================

pub enum StampOffenseKind {
    Counterfeiting;
    MutilationOrRemoval;
    UseOfMutilatedOrCounterfeitedStamp;
    ReuseOfStamps;
    UseOfStampCutFromAnotherArticle;
    UseOfStampOfInsufficientValue;
    UseOfForgedOrCounterfeitedStamp;
    TraffickingInWashedOrRestoredStamp;
    PossessionOfWashedRestoredOrAlteredStamp;
    EmptiedStampedPackageWithIntentToDefraud;
}
pub relation stamp_offense_conduct(o: Offense, kind: StampOffenseKind) kind empirical {
    label en unofficial "case fact: the person alleged in o engaged in the conduct section 7208's numbered paragraph for this StampOffenseKind describes (fraud intent for Counterfeiting/MutilationOrRemoval/UseOfMutilated is the paragraph's own \"with intent to defraud\"/\"fraudulently\" language, folded into this conduct fact rather than a separate channel, since the statute ties the intent to the specific act described, not to a freestanding willfulness element; ReuseOfStamps paragraph (4)(A)/(B)/(C) mixes willfully/knowingly/knowing-without-lawful-excuse sub-elements not separately modeled here — TECH_GAP, see report)";
}
pub relation offense_7208(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7208: p's conduct in o is a stamp offense";
}
@source(IRC_S7208, relation = formalizes, coverage = partial, quote = "With intent to defraud, alters, forges, makes, or counterfeits any stamp, coupon, ticket, book, or other device prescribed under authority of this title for the collection or payment of any tax imposed by this title")
rule Section7208CounterfeitingOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, Counterfeiting);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = partial, quote = "Fraudulently cuts, tears, or removes from any vellum, parchment, paper, instrument, writing, package, or article, upon which any tax is imposed by this title, any adhesive stamp or the impression of any stamp, die, plate, or other article")
rule Section7208MutilationOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, MutilationOrRemoval);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = partial, quote = "Fraudulently uses, joins, fixes, or places to, with, or upon any vellum, parchment, paper, instrument, writing, package, or article, upon which any tax is imposed by this title")
rule Section7208UseOfMutilatedOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, UseOfMutilatedOrCounterfeitedStamp);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = partial, quote = "Willfully removes, or alters the cancellation or defacing marks of, or otherwise prepares, any adhesive stamp, with intent to use, or cause the same to be used, after it has already been used")
rule Section7208ReuseOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, ReuseOfStamps)
        and willfulness_established(o);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = partial, quote = "Commits the offense described in section 7271 (relating to disposal and receipt of stamped packages) with intent to defraud the revenue, or to defraud any person")
rule Section7208EmptiedPackageOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, EmptiedStampedPackageWithIntentToDefraud)
        and intent_to_defraud_established(o);
    then offense_7208(p, o);
}
rule Section7208FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7208(p, o);
    then offense_elements_established(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = exact, quote = "shall be guilty of a felony and, upon conviction thereof, shall be fined not more than $10,000, or imprisoned not more than 5 years, or both.")
rule Section7208Grade(p: Person, o: Offense) strict {
    when offense_7208(p, o);
    then offense_grade(o, Felony);
}
const Section7208MaxFine: Money = 10000.00 USD {
    label en unofficial "section 7208: fine ceiling, no individual/corporate split in the text";
};
rule Section7208MaxFineRule(p: Person, o: Offense) strict {
    when offense_7208(p, o);
    then statutory_maximum_fine_individual(o, Section7208MaxFine);
}
rule Section7208MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7208(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

// =======================================================================
// Section 7209 — Unauthorized use or sale of stamps. NO mental-element
// word appears in the text ("Any person who buys, sells, ... except as
// authorized ... shall, upon conviction thereof, be fined ..."): modeled
// as a strict conduct classification with NO willfulness channel — see
// coverage row 26/7209/u1 note on this deliberate absence.
// =======================================================================

pub relation dealt_in_stamp_without_authorization(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o bought, sold, offered for sale, used, transferred, took or gave in exchange, or pledged or gave in pledge, a stamp/coupon/ticket/book/device prescribed for tax collection or payment, except as authorized by this title or its regulations";
}
pub relation offense_7209(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7209: p's conduct in o is an unauthorized stamp dealing offense (no mental element the text names beyond the conduct itself)";
}
@source(IRC_S7209, relation = formalizes, coverage = exact, quote = "Any person who buys, sells, offers for sale, uses, transfers, takes or gives in exchange, or pledges or gives in pledge, except as authorized in this title or in regulations made pursuant thereto, any stamp, coupon, ticket, book, or other device prescribed by the Secretary under this title for the collection or payment of any tax imposed by this title, shall, upon conviction thereof, be fined not more than $1,000, or imprisoned not more than 6 months, or both.")
rule Section7209Offense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and dealt_in_stamp_without_authorization(o);
    then offense_7209(p, o);
}
rule Section7209FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7209(p, o);
    then offense_elements_established(p, o);
}
const Section7209MaxFine: Money = 1000.00 USD {
    label en unofficial "section 7209: fine ceiling";
};
rule Section7209MaxFineRule(p: Person, o: Offense) strict {
    when offense_7209(p, o);
    then statutory_maximum_fine_individual(o, Section7209MaxFine);
}
// section 7209's imprisonment ceiling is 6 MONTHS, not a whole number of
// years; statutory_maximum_imprisonment_years (00-vocabulary.law) is typed
// Integer and cannot represent a fractional-year ceiling faithfully —
// recorded as a TECH_GAP (coverage row 26/7209/u1) rather than rounded.
