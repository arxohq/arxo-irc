// 26 U.S.C. §§7301-7304 (subchapter C, part I — property subject to
// forfeiture) and §§7321-7328 (part II — provisions common to
// forfeitures). Forfeiture is modeled as a CLASSIFICATION of property
// (`property_subject_to_forfeiture`) plus the Secretary's seizure `power`
// (section 7321) and, for the summary procedure of section 7325, the
// claimant's own `power` to force judicial proceedings by filing a claim
// and bond within the 30-day window — exact date arithmetic, per method.

use self::{
    IRC_S7301_A,
    IRC_S7301_B,
    IRC_S7301_C,
    IRC_S7301_D,
    IRC_S7301_E,
    IRC_S7302,
    IRC_S7303,
    IRC_S7304,
    IRC_S7321,
    IRC_S7324,
    IRC_S7325,
    Offense,
    Person,
    Secretary,
    intent_to_defraud_established,
    offense_7207,
    offense_7208,
    offense_7271,
    offense_elements_established,
    offense_person,
};

pub entity Property {
    label en unofficial "an item of property potentially subject to seizure and forfeiture under this chapter";
}
pub relation property_possessor(pr: Property, p: Person) kind empirical {
    label en unofficial "case fact: p has possession, custody, or control of the property pr";
}
pub relation property_bears_tax(pr: Property) kind empirical {
    label en unofficial "case fact: a tax imposed by this title is imposed on, for, or in respect of pr — section 7301(a)'s own predicate";
}

// =======================================================================
// Section 7301 — Taxable articles ((a)), raw materials ((b)), equipment
// ((c)), packages ((d)), conveyances ((e))
// =======================================================================

pub relation held_for_sale_or_removal_in_fraud_or_to_avoid_tax(pr: Property) kind empirical {
    label en unofficial "case fact: pr is found in a person's possession/custody/control for the purpose of being sold or removed in fraud of the internal revenue laws, or with design to avoid payment of the tax — section 7301(a) first branch";
}
pub relation removed_deposited_or_concealed_to_defraud(pr: Property) kind empirical {
    label en unofficial "case fact: pr was removed, deposited, or concealed with intent to defraud the United States of the tax (or part of it) — section 7301(a) second branch";
}
pub relation held_as_raw_materials_for_fraudulent_manufacture(pr: Property) kind empirical {
    label en unofficial "case fact: pr is found in a person's possession, intending to manufacture pr into taxable property for the purpose of selling that taxable property in fraud of the internal revenue laws, or with design to evade payment of the tax — section 7301(b)";
}
pub relation used_as_equipment_for_7301a_or_b_property(pr: Property) kind empirical {
    label en unofficial "case fact: pr is property (in the place/building/yard/enclosure where 7301(a)/(b) property is found, or intended to be used in making 7301(a) property) with intent to defraud the United States of tax — section 7301(c)";
}
pub relation used_as_container_for_7301a_or_b_property(pr: Property) kind empirical {
    label en unofficial "case fact: pr is used as a container for, or has contained, property described in section 7301(a) or (b) — section 7301(d)";
}
pub relation used_to_transport_or_conceal_7301a_or_b_property(pr: Property) kind empirical {
    label en unofficial "case fact: pr (including an aircraft, vehicle, vessel, or draft animal) is used to transport or for the deposit or concealment of property described in section 7301(a) or (b), or of property intended for use in making/packaging section 7301(a) property — section 7301(e)";
}

pub relation property_subject_to_forfeiture(pr: Property) kind institutional {
    label en unofficial "pr is subject to seizure and forfeiture to the United States under this chapter";
}
@source(IRC_S7301_A, relation = formalizes, coverage = exact, quote = "may be seized, and shall be forfeited to the United States.")
rule Section7301aForfeiture(pr: Property) strict {
    when property_bears_tax(pr)
        and (held_for_sale_or_removal_in_fraud_or_to_avoid_tax(pr) or removed_deposited_or_concealed_to_defraud(pr));
    then property_subject_to_forfeiture(pr);
}
@source(IRC_S7301_B, relation = formalizes, coverage = exact, quote = "may also be seized, and shall be forfeited to the United States.")
rule Section7301bForfeiture(pr: Property) strict {
    when held_as_raw_materials_for_fraudulent_manufacture(pr);
    then property_subject_to_forfeiture(pr);
}
@source(IRC_S7301_C, relation = formalizes, coverage = exact, quote = "may also be seized, and shall be forfeited to the United States.")
rule Section7301cForfeiture(pr: Property) strict {
    when used_as_equipment_for_7301a_or_b_property(pr);
    then property_subject_to_forfeiture(pr);
}
@source(IRC_S7301_D, relation = formalizes, coverage = exact, quote = "may also be seized, and shall be forfeited to the United States.")
rule Section7301dForfeiture(pr: Property) strict {
    when used_as_container_for_7301a_or_b_property(pr);
    then property_subject_to_forfeiture(pr);
}
@source(IRC_S7301_E, relation = formalizes, coverage = exact, quote = "may also be seized, and shall be forfeited to the United States.")
rule Section7301eForfeiture(pr: Property) strict {
    when used_to_transport_or_conceal_7301a_or_b_property(pr);
    then property_subject_to_forfeiture(pr);
}

// =======================================================================
// Section 7302 — Property used in violation of internal revenue laws
// (declares no property right can exist in such property — an immunity-
// reversal rather than a forfeiture trigger keyed to a specific tax)
// =======================================================================

pub relation intended_or_used_to_violate_internal_revenue_laws(pr: Property) kind empirical {
    label en unofficial "case fact: pr is intended for use in violating the internal revenue laws or regulations under them, or has been so used — section 7302";
}
@source(IRC_S7302, relation = formalizes, coverage = exact, quote = "It shall be unlawful to have or possess any property intended for use in violating the provisions of the internal revenue laws, or regulations prescribed under such laws, or which has been so used, and no property rights shall exist in any such property.")
rule Section7302Forfeiture(pr: Property) strict {
    when intended_or_used_to_violate_internal_revenue_laws(pr);
    then property_subject_to_forfeiture(pr);
}

// =======================================================================
// Section 7303 — Other property subject to forfeiture: counterfeit
// stamps and their vellum/document/package (linked to the section 7208
// offense), containers from a section 7271 false-stamping offense, and
// property to which a section 7207 fraudulent instrument relates
// =======================================================================

pub relation involved_in_section_7208_offense(pr: Property, o: Offense) kind empirical {
    label en unofficial "case fact: pr is a stamp involved in the section 7208 offense o, or the vellum/parchment/document/paper/package/article on which that stamp was placed or impressed in connection with o — section 7303(1)";
}
pub relation involved_in_section_7271_offense(pr: Property, o: Offense) kind empirical {
    label en unofficial "case fact: pr is a container involved in the section 7271 offense o (disposal of stamped packages), or its contents — section 7303(2)";
}
pub relation related_to_section_7207_fraudulent_instrument(pr: Property, o: Offense) kind empirical {
    label en unofficial "case fact: pr is property to which a false or fraudulent instrument involved in the section 7207 offense o relates — section 7303(3)";
}
@source(IRC_S7303, relation = formalizes, coverage = exact, quote = "Every stamp involved in the offense described in section 7208 (relating to counterfeit, reused, cancelled, etc., stamps), and the vellum, parchment, document, paper, package, or article upon which such stamp was placed or impressed in connection with such offense.")
rule Section7303CounterfeitStampForfeiture(pr: Property, o: Offense, p: Person) strict {
    when involved_in_section_7208_offense(pr, o)
        and offense_7208(p, o);
    then property_subject_to_forfeiture(pr);
}
@source(IRC_S7303, relation = formalizes, coverage = exact, quote = "Any container involved in the offense described in section 7271 (relating to disposal of stamped packages), and of the contents of such container.")
rule Section7303EmptiedContainerForfeiture(pr: Property, o: Offense, p: Person) defeasible {
    when involved_in_section_7271_offense(pr, o)
        and offense_7271(p, o);
    then property_subject_to_forfeiture(pr);
}
@source(IRC_S7303, relation = formalizes, coverage = exact, quote = "All property to which any false or fraudulent instrument involved in the offense described in section 7207 relates.")
rule Section7303FraudulentInstrumentForfeiture(pr: Property, o: Offense, p: Person) strict {
    when related_to_section_7207_fraudulent_instrument(pr, o)
        and offense_7207(p, o);
    then property_subject_to_forfeiture(pr);
}

// =======================================================================
// Section 7304 — Penalty for fraudulently claiming drawback
// =======================================================================

pub relation drawback_claim_amount(o: Offense, claimed: Money, actually_paid_tax: Money) kind empirical {
    label en unofficial "case fact: the drawback the person alleged in o fraudulently claimed or sought (claimed), against the internal tax actually paid (actually_paid_tax) — section 7304's forfeiture is triple the wrongfully/fraudulently claimed amount, or $500, at the Secretary's election";
}
pub relation offense_7304(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7304: p's conduct in o is a fraudulent drawback claim";
}
@source(IRC_S7304, relation = formalizes, coverage = exact, quote = "Whenever any person fraudulently claims or seeks to obtain an allowance of drawback on goods, wares, or merchandise on which no internal tax shall have been paid, or fraudulently claims any greater allowance of drawback than the tax actually paid, he shall forfeit triple the amount wrongfully or fraudulently claimed or sought to be obtained, or the sum of $500, at the election of the Secretary.")
rule Section7304Offense(p: Person, o: Offense, claim_amount: Money, paid_amount: Money) strict {
    when offense_person(o, p)
        and drawback_claim_amount(o, claim_amount, paid_amount)
        and intent_to_defraud_established(o);
    then offense_7304(p, o);
}
rule Section7304FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7304(p, o);
    then offense_elements_established(p, o);
}
// The forfeiture amount ("triple the amount ... or $500, at the election
// of the Secretary") needs a computed multiplier AND a discretionary
// Secretary election between two computed alternatives — TECH_GAP,
// coverage row 26/7304/u1 (same family as the section 7212(b)/7268/7270
// "double/triple the amount" gaps above).

// =======================================================================
// Section 7321 — Authority to seize property subject to forfeiture (the
// Secretary's `power`)
// =======================================================================

@source(IRC_S7321, relation = formalizes, coverage = exact, quote = "Any property subject to forfeiture to the United States under any provision of this title may be seized by the Secretary.")
rule Section7321SeizurePowerRule(pr: Property) strict {
    when property_subject_to_forfeiture(pr);
    then power Section7321SeizurePower {
        holder Secretary;
        over pr;
        exercise property_seized(pr);
        valid_when property_subject_to_forfeiture(pr);
        effect create(property_seized(pr));
        subject Property;
        window [-infinity, infinity];
    };
}
pub relation property_seized(pr: Property) kind institutional {
    label en unofficial "the Secretary has exercised the section 7321 power to seize pr";
}

// =======================================================================
// Section 7322 — Delivery of seized personal property to the United
// States marshal (the Secretary's option, not a duty)
// =======================================================================

pub relation delivered_to_marshal(pr: Property) kind empirical {
    label en unofficial "case fact: the Secretary elected to deliver the seized property pr to the United States marshal of the district under section 7322";
}

// =======================================================================
// Section 7323 — Nature and venue of in rem forfeiture proceedings;
// service of process after a bonded return; taxable cost of seizure.
// Purely procedural (forum/venue and cost-taxation rules) — modeled as
// NON_NORMATIVE for this package's purposes (no computable norm; a
// venue/procedure rule outside chapter 75's own substantive scope).
// =======================================================================

// =======================================================================
// Section 7324 — Special disposition of perishable goods: examination,
// appraisal, bonded return to owner, or sale in the bond's absence
// =======================================================================

pub relation property_liable_to_perish_or_costly_to_keep(pr: Property) kind empirical {
    label en unofficial "case fact: pr, seized under section 7301 or 7302, is liable to perish or become greatly reduced in price/value by keeping, or cannot be kept without great expense — section 7324's own trigger";
}
pub relation owner_gave_appraised_value_bond(pr: Property, appraised_value: Money) kind empirical {
    label en unofficial "case fact: the owner of pr gave a bond in the amount of the Secretary's appraised value, to abide the court's final order/decree/judgment — section 7324(3)";
}
pub relation owner_neglected_or_refused_bond(pr: Property) kind empirical {
    label en unofficial "case fact: the owner of pr neglected or refused to give the section 7324(3) appraised-value bond — section 7324(4)(A)'s own trigger for a sale order";
}
pub relation perishable_property_returned_under_bond(pr: Property) kind institutional {
    label en unofficial "pr, having been appraised, was returned to its owner under section 7324(3)'s bond";
}
@source(IRC_S7324, relation = formalizes, coverage = partial, quote = "The owner shall have such property returned to him upon giving bond in an amount equal to such appraised value to abide the final order, decree, or judgment of the court having cognizance of the case")
rule Section7324ReturnUnderBond(pr: Property, appraised_value: Money) strict {
    when property_liable_to_perish_or_costly_to_keep(pr)
        and owner_gave_appraised_value_bond(pr, appraised_value);
    then perishable_property_returned_under_bond(pr);
}
pub relation perishable_property_sale_ordered(pr: Property) kind institutional {
    label en unofficial "the Secretary ordered the public sale of pr under section 7324(4)(A) because the owner neglected or refused to give the appraised-value bond";
}
@source(IRC_S7324, relation = formalizes, coverage = partial, quote = "If such owner shall neglect or refuse to give such bond, the Secretary shall issue to any Treasury officer or employee or to the United States marshal an order to sell the same.")
rule Section7324SaleInAbsenceOfBond(pr: Property) strict {
    when property_liable_to_perish_or_costly_to_keep(pr)
        and owner_neglected_or_refused_bond(pr);
    then perishable_property_sale_ordered(pr);
}

// =======================================================================
// Section 7325 — Summary forfeiture of personal property appraised at
// $100,000 or less: list/appraisement, 3-week published notice with a
// 30-day claim window, the claimant's bond power, and sale absent a claim
// =======================================================================

pub relation summary_forfeiture_eligible(pr: Property) kind institutional {
    label en unofficial "pr, seized as subject to forfeiture under this title, is appraised by the Secretary at $100,000 or less — section 7325's own threshold for the summary procedure";
}
pub relation seizure_appraised_value(pr: Property, amount: Money) kind empirical {
    label en unofficial "case fact: the Secretary's appraised value of the seized property pr, used against the $100,000 section 7325 threshold";
}
const Section7325ValueThreshold: Money = 100000.00 USD {
    label en unofficial "section 7325: the summary-forfeiture value ceiling";
};
@source(IRC_S7325, relation = formalizes, coverage = exact, quote = "In all cases of seizure of any goods, wares, or merchandise as being subject to forfeiture under any provision of this title which, in the opinion of the Secretary, are of the appraised value of $100,000 or less")
rule Section7325EligibilityByValue(pr: Property, amount: Money) defeasible {
    when property_subject_to_forfeiture(pr)
        and seizure_appraised_value(pr, amount)
        and amount <= Section7325ValueThreshold;
    then summary_forfeiture_eligible(pr);
}

pub relation notice_of_seizure_published_on(pr: Property, first_publication: Date) kind empirical {
    label en unofficial "case fact: the date the Secretary's section 7325(2) notice of seizure was first published (a 3-week newspaper notice) — the 30-day claim window (section 7325(2)/(3)) runs from this date";
}
pub relation forfeiture_claim_filed_on(pr: Property, on: Date) kind empirical {
    label en unofficial "case fact: the date a claimant filed a claim with the Secretary under section 7325(3), stating an interest in the seized property";
}
pub relation claim_bond_executed(pr: Property) kind empirical {
    label en unofficial "case fact: the claimant executed the $2,500 penal-sum bond to the United States required by section 7325(3), conditioned on paying costs/expenses of the condemnation proceeding if the property is condemned";
}
const Section7325ClaimWindowDays: Integer = 30;
const Section7325BondAmount: Money = 2500.00 USD {
    label en unofficial "section 7325(3): the penal sum of the claimant's bond";
};
pub relation summary_forfeiture_claim_window_end(pr: Property, first_publication: Date, deadline: Date) kind institutional {
    label en unofficial "the last day (inclusive) of the 30-day window from first publication within which a claimant may file a claim and bond under section 7325(2)-(3)";
}
@source(IRC_S7325, relation = formalizes, coverage = exact, quote = "requiring any person claiming them to appear and make such claim within 30 days from the date of the first publication of such notice.")
rule Section7325ClaimWindowEnd(pr: Property, first_publication: Date) strict {
    when notice_of_seizure_published_on(pr, first_publication);
    then summary_forfeiture_claim_window_end(pr, first_publication, add_calendar_period(first_publication, 30 calendar_day));
}
pub relation summary_forfeiture_claim_valid(pr: Property) kind institutional {
    label en unofficial "the claimant's section 7325(3) claim and bond are valid: filed on or before the 30-day deadline from first publication, with the required bond executed — the effect is that the Secretary must transmit the claim and property description to the United States attorney for ordinary judicial forfeiture proceedings instead of summary sale";
}
@source(IRC_S7325, relation = formalizes, coverage = exact, quote = "Any person claiming the goods, wares, or merchandise so seized, within the time specified in the notice, may file with the Secretary a claim, stating his interest in the articles seized, and may execute a bond to the United States in the penal sum of $2,500")
rule Section7325ClaimValid(pr: Property, first_publication: Date, on: Date, deadline: Date) defeasible {
    when summary_forfeiture_eligible(pr)
        and notice_of_seizure_published_on(pr, first_publication)
        and summary_forfeiture_claim_window_end(pr, first_publication, deadline)
        and forfeiture_claim_filed_on(pr, on)
        and on <= deadline
        and claim_bond_executed(pr);
    then summary_forfeiture_claim_valid(pr);
}
pub relation summary_sale_authorized(pr: Property) kind institutional {
    label en unofficial "no timely claim and bond was filed under section 7325(3): the Secretary may proceed to public sale under section 7325(4)";
}
@source(IRC_S7325, relation = formalizes, coverage = exact, quote = "If no claim is interposed and no bond is given within the time above specified, the Secretary shall give reasonable notice of the sale of the goods, wares, or merchandise by publication")
rule Section7325SummarySaleAuthorized(pr: Property) defeasible {
    when summary_forfeiture_eligible(pr);
    then summary_sale_authorized(pr);
    unless summary_forfeiture_claim_valid(pr) and summary_forfeiture_eligible(pr);
}

