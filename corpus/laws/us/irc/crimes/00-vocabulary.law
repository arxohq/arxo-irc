// 26 U.S.C. Chapter 75, subchapters A-D — shared vocabulary for the crimes
// package (F06, IRC-17 stage 1). Read AGENT-BRIEF.md's "Formalization
// method" and DECISION-0194 before extending this module.
//
// DESIGN (PLAN §6.5 risk table: "criminal conclusion from a single late
// filing" is forbidden). Every offense in this package is a classification
// `offense_elements_established(p, o)` over an `Offense` instance `o` — this
// package's own entity for "one alleged violation" — never a flat boolean on
// the person alone. The mental element every section in Part I names
// (willfully / corruptly / knowingly / with intent to defraud / with intent
// to evade or defeat) is a DECISION-0194 channel: this package treats it as
// a fact the COURT must find as trier of fact at conviction (the text's own
// "upon conviction thereof" and the felony/misdemeanor grading both point to
// a judicial finding, not an administrative one) — `external judgment
// relation … { authority Court; }` per element, never a case fact asserted
// directly and never an arithmetic guard over conduct facts. Before the
// court decides, evaluation of the offense's own head is
// NEITHER/REQUIRES_JUDGMENT; a case that establishes ONLY the civil
// counterpart (e.g. a late-filed return under `us.irc.returns`) and leaves
// the mental element unaddressed must NOT derive the offense — see
// `tests/willfulness-channel.lawtest` for the two-step scenario this
// guards against.
//
// The punishment (fine ceiling, imprisonment ceiling) is recorded as a
// REFERENCE VALUE the statute states, reached once the offense is
// established — it is never a sentence: the actual fine/term a court
// imposes up to that ceiling is EXTERNAL_DEPENDENCY on the sentencing
// court and this package derives no such number.

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

import us.irc.core version "0.1.1";
import us.irc.confidentiality version "0.1.1";
import us.irc.inflation_adjustments version "0.1.1";
import us.irc.collection version "0.1.1";
import us.irc.payment_refunds_interest version "0.1.1";
import us.irc.returns version "0.1.1";

use self::{
    IRC_S7343,
};

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type Partnership = us.irc.core::Partnership;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;
type Return = us.irc.core::Return;
type Disclosure = us.irc.confidentiality::Disclosure;

const Secretary: Organ = us.irc.core::Secretary;
const IRS: Organ = us.irc.core::IRS;

// ---------------------------------------------------------------------
// The alleged-violation instance
// ---------------------------------------------------------------------

pub entity Offense {
    label en unofficial "one alleged instance of criminal (or forfeiture-triggering) conduct under 26 U.S.C. chapter 75, examined against one statute's elements";
}

pub relation offense_person(o: Offense, p: Person) kind empirical {
    label en unofficial "case fact: the offense o is alleged against this person (the principal actor; section 7343 extends \"person\" to a corporate officer/employee or a partner acting in that duty-bound capacity — see 06-forfeiture-passport-and-misc.law)";
}

pub enum OffenseGrade {
    Felony;
    Misdemeanor;
}

pub relation offense_grade(o: Offense, g: OffenseGrade) kind institutional {
    label en unofficial "the statutory grade (felony or misdemeanor) this package's rule for o's statute assigns once o's elements are established";
}

// ---------------------------------------------------------------------
// DECISION-0194 channels: the mental elements Part I's offenses name.
// One channel per named element, over the Offense instance (not the person
// alone) so that two offenses against the same person are judged on
// independent facts. `Court` is not otherwise declared by us.irc.core; this
// package's own reference to "the court" that convicts under this chapter.
// ---------------------------------------------------------------------

const Court: Organ = us.irc.core::DistrictCourt;

external judgment relation willfulness_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds, upon conviction, that the offense o's conduct was done willfully (Part I's recurring mental element)";
}

external judgment relation knowledge_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds that the conduct alleged in o was done knowingly (section 7208(4)(C)'s own mental element, distinct from willfulness)";
}

external judgment relation corrupt_or_forcible_intent_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds that the conduct alleged in o was corrupt, or by force or threats of force, within the meaning of section 7212(a)";
}

external judgment relation intent_to_defraud_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds that the conduct alleged in o was done with intent to defraud (sections 7206(4)/7208/7270/7301 family)";
}

external judgment relation intent_to_evade_or_defeat_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds that the conduct alleged in o was done with intent to evade or defeat an internal revenue tax (section 7206(4))";
}

pub relation offense_elements_established(p: Person, o: Offense) kind institutional {
    label en unofficial "aggregator: some rule of this package has classified o (alleged against p) as containing every element the charged statute requires, INCLUDING the mental element established by a court. No rule concludes this head directly from conduct alone";
}

// ---------------------------------------------------------------------
// Punishment as a recorded reference, never a derived sentence
// (EXTERNAL_DEPENDENCY on the sentencing court's actual choice).
// ---------------------------------------------------------------------

pub relation statutory_maximum_fine_individual(o: Offense, amount: Money) kind institutional {
    label en unofficial "the statutory ceiling on a fine for o against an individual defendant, as stated by the charged section — a reference value, not a sentence";
}
pub relation statutory_maximum_fine_corporate(o: Offense, amount: Money) kind institutional {
    label en unofficial "the statutory ceiling on a fine for o against a corporate defendant, where the section states a separate corporate figure";
}
pub relation statutory_maximum_imprisonment_years(o: Offense, years: Integer) kind institutional {
    label en unofficial "the statutory ceiling, in years, on imprisonment for o — a reference value, not a sentence";
}

// ---------------------------------------------------------------------
// Section 7343 — extended "person" (subchapter C, applied chapter-wide by
// its own text: "as used in this chapter"). An officer/employee of a
// corporation, or a member/employee of a partnership, counts as the
// "person" under any offense of this chapter for conduct within a duty
// that person bears. Declared here (used by every module) rather than in
// the subchapter-C module, since it is a chapter-wide definition.
// ---------------------------------------------------------------------

pub relation duty_bound_corporate_officer(p: Person, corp: Corporation) kind empirical {
    label en unofficial "case fact: p is an officer or employee of corp who, as such, is under a duty to perform the act in respect of which the alleged violation occurs — section 7343";
}
pub relation duty_bound_partner(p: Person, partnership: Partnership) kind empirical {
    label en unofficial "case fact: p is a member or employee of partnership who, as such, is under a duty to perform the act in respect of which the alleged violation occurs — section 7343";
}
pub relation chapter75_person(p: Person) kind institutional {
    label en unofficial "p is a \"person\" within the meaning of section 7343 as used throughout this chapter: any natural Person, OR a corporate officer/employee, OR a partnership member/employee, each acting within the duty the alleged violation concerns";
}
@source(IRC_S7343, relation = formalizes, coverage = exact, quote = "The term \"person\" as used in this chapter includes an officer or employee of a corporation, or a member or employee of a partnership, who as such officer, employee, or member is under a duty to perform the act in respect of which the violation occurs.")
rule Section7343ExtendsPersonToDutyBoundOfficer(p: Person, corp: Corporation) strict {
    when duty_bound_corporate_officer(p, corp);
    then chapter75_person(p);
}
@source(IRC_S7343, relation = formalizes, coverage = exact, quote = "or a member or employee of a partnership, who as such officer, employee, or member is under a duty to perform the act in respect of which the violation occurs.")
rule Section7343ExtendsPersonToDutyBoundPartner(p: Person, partnership: Partnership) strict {
    when duty_bound_partner(p, partnership);
    then chapter75_person(p);
}
