// 26 U.S.C. §§7201-7203 (subchapter A, part I) — the three flagship
// willfulness offenses: evasion, failure to collect/pay over, failure to
// file/keep/supply/pay. Each is `offense_elements_established(p, o)` over
// conduct facts the CASE asserts plus `willfulness_established(o)`, the
// DECISION-0194 court channel from 00-vocabulary.law. A case that asserts
// ONLY the conduct (e.g. only that a return was filed late) and leaves
// willfulness unaddressed must NOT derive the offense — see
// tests/willfulness-channel.lawtest for the two-step scenario (civil
// lateness established, willfulness unknown -> NEITHER).

// =======================================================================
// Section 7201 — Attempt to evade or defeat tax
// =======================================================================

use self::{
    Corporation,
    IRC_S7201,
    IRC_S7202,
    IRC_S7203,
    Individual,
    Offense,
    OffenseGrade,
    Person,
    offense_elements_established,
    offense_grade,
    offense_person,
    statutory_maximum_fine_corporate,
    statutory_maximum_fine_individual,
    statutory_maximum_imprisonment_years,
    willfulness_established,
};

pub relation affirmative_act_of_evasion(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o did some affirmative act (beyond mere omission) in an attempt to evade or defeat a tax or its payment";
}
pub relation tax_deficiency_or_due(o: Offense) kind empirical {
    label en unofficial "case fact: a tax imposed by this title (or its payment) was due from the person alleged in o at the time of the alleged act";
}

pub relation offense_7201(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7201: p's conduct in o is the felony of attempting to evade or defeat a tax";
}
@source(IRC_S7201, relation = formalizes, coverage = exact, quote = "Any person who willfully attempts in any manner to evade or defeat any tax imposed by this title or the payment thereof shall, in addition to other penalties provided by law, be guilty of a felony")
rule Section7201EvasionOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and affirmative_act_of_evasion(o)
        and tax_deficiency_or_due(o)
        and willfulness_established(o);
    then offense_7201(p, o);
}
rule Section7201FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7201(p, o);
    then offense_elements_established(p, o);
}
@source(IRC_S7201, relation = formalizes, coverage = exact, quote = "shall, in addition to other penalties provided by law, be guilty of a felony")
rule Section7201Grade(p: Person, o: Offense) strict {
    when offense_7201(p, o);
    then offense_grade(o, Felony);
}
const Section7201MaxFineIndividual: Money = 100000.00 USD {
    label en unofficial "section 7201: fine ceiling for an individual defendant — reference value only";
};
const Section7201MaxFineCorporate: Money = 500000.00 USD {
    label en unofficial "section 7201: fine ceiling for a corporate defendant — reference value only";
};
@source(IRC_S7201, relation = formalizes, coverage = exact, quote = "shall be fined not more than $100,000 ($500,000 in the case of a corporation), or imprisoned not more than 5 years, or both")
rule Section7201MaxFineForIndividual(p: Individual, o: Offense) strict {
    when offense_7201(p, o);
    then statutory_maximum_fine_individual(o, Section7201MaxFineIndividual);
}
@source(IRC_S7201, relation = formalizes, coverage = exact, quote = "$500,000 in the case of a corporation")
rule Section7201MaxFineForCorporation(p: Corporation, o: Offense) strict {
    when offense_7201(p, o);
    then statutory_maximum_fine_corporate(o, Section7201MaxFineCorporate);
}
@source(IRC_S7201, relation = formalizes, coverage = exact, quote = "or imprisoned not more than 5 years, or both, together with the costs of prosecution")
rule Section7201MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7201(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

// =======================================================================
// Section 7202 — Willful failure to collect or pay over tax
// =======================================================================

pub relation required_to_collect_account_pay_over(p: Person) kind empirical {
    label en unofficial "case fact: p is required under this title to collect, account for, and pay over some tax imposed by this title (e.g. a withholding agent or a responsible person for trust-fund taxes)";
}
pub relation failed_to_collect_or_account_and_pay_over(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to collect, or failed to truthfully account for and pay over, the tax p was required to collect";
}

pub relation offense_7202(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7202: p's conduct in o is the felony of willfully failing to collect or pay over tax";
}
@source(IRC_S7202, relation = formalizes, coverage = exact, quote = "Any person required under this title to collect, account for, and pay over any tax imposed by this title who willfully fails to collect or truthfully account for and pay over such tax shall, in addition to other penalties provided by law, be guilty of a felony")
rule Section7202FailureToCollectOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and required_to_collect_account_pay_over(p)
        and failed_to_collect_or_account_and_pay_over(o)
        and willfulness_established(o);
    then offense_7202(p, o);
}
rule Section7202FeedsElementsAggregate(p: Person, o: Offense) strict {
    when offense_7202(p, o);
    then offense_elements_established(p, o);
}
rule Section7202Grade(p: Person, o: Offense) strict {
    when offense_7202(p, o);
    then offense_grade(o, Felony);
}
const Section7202MaxFine: Money = 10000.00 USD {
    label en unofficial "section 7202: fine ceiling — reference value only, no individual/corporate split in the text";
};
@source(IRC_S7202, relation = formalizes, coverage = exact, quote = "shall be fined not more than $10,000, or imprisoned not more than 5 years, or both, together with the costs of prosecution")
rule Section7202MaxFineRule(p: Person, o: Offense) strict {
    when offense_7202(p, o);
    then statutory_maximum_fine_individual(o, Section7202MaxFine);
}
rule Section7202MaxImprisonment(p: Person, o: Offense) strict {
    when offense_7202(p, o);
    then statutory_maximum_imprisonment_years(o, 5);
}

// =======================================================================
// Section 7203 — Willful failure to file return, supply information, or
// pay tax. The MISDEMEANOR baseline, with a felony substitution for a
// willful section 6050I violation (cash-over-$10,000 reporting), and an
// exception where the only failure is to pay ESTIMATED tax and no
// section 6654/6655 addition to tax applies to that failure.
// =======================================================================

pub enum Section7203Duty {
    PayTaxOrEstimatedTax;
    MakeReturn;
    KeepRecords;
    SupplyInformation;
}
pub relation required_duty_7203(o: Offense, statutory_duty: Section7203Duty) kind empirical {
    label en unofficial "case fact: the person alleged in o was required under this title (or regulations under it) to perform this duty at the time or times required by law or regulations";
}
pub relation failed_duty_7203(o: Offense, statutory_duty: Section7203Duty) kind empirical {
    label en unofficial "case fact: the person alleged in o failed to perform the required duty at the time or times required by law or regulations";
}
pub relation failure_is_only_estimated_tax_payment(o: Offense) kind empirical {
    label en unofficial "case fact: the only 7203 failure alleged in o is a failure to pay estimated tax (the exception's predicate)";
}
pub relation no_addition_under_6654_or_6655(o: Offense) kind empirical {
    label en unofficial "case fact: no addition to tax under section 6654 or 6655 applies with respect to the failure alleged in o (the exception's second predicate) — us.irc.penalties owns section 6654/6655 itself; this package reads the fact as a case input rather than importing that computation, since penalties does not yet publish an addition-exists symbol for 6654/6655 (recorded in crimes.deps.json)";
}
pub relation willful_violation_of_6050I(o: Offense) kind empirical {
    label en unofficial "case fact: the alleged violation is a willful violation of section 6050I (cash-over-$10,000 trade-or-business reporting), triggering the felony substitution";
}

pub relation offense_7203_base(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7203, first sentence: p's conduct in o satisfies the misdemeanor elements before the estimated-tax exception is checked";
}
@source(IRC_S7203, relation = formalizes, coverage = partial, quote = "Any person required under this title to pay any estimated tax or tax, or required by this title or by regulations made under authority thereof to make a return, keep any records, or supply any information, who willfully fails to pay such estimated tax or tax, make such return, keep such records, or supply such information, at the time or times required by law or regulations")
rule Section7203BaseOffense(p: Person, o: Offense, statutory_duty: Section7203Duty) strict {
    when offense_person(o, p)
        and required_duty_7203(o, statutory_duty)
        and failed_duty_7203(o, statutory_duty)
        and willfulness_established(o);
    then offense_7203_base(p, o);
}

pub relation offense_7203(p: Person, o: Offense) kind institutional {
    label en unofficial "section 7203: p's conduct in o is the misdemeanor (or, under the 6050I substitution, the felony) of willfully failing to file/keep/supply/pay, after the estimated-tax exception is applied";
}
@source(IRC_S7203, relation = formalizes, coverage = exact, quote = "In the case of any person with respect to whom there is a failure to pay any estimated tax, this section shall not apply to such person with respect to such failure if there is no addition to tax under section 6654 or 6655 with respect to such failure.")
rule Section7203Offense(p: Person, o: Offense) defeasible {
    when offense_7203_base(p, o);
    then offense_7203(p, o);
    unless failure_is_only_estimated_tax_payment(o) and no_addition_under_6654_or_6655(o) and offense_7203_base(p, o);
}
rule Section7203FeedsElementsAggregate(p: Person, o: Offense) defeasible {
    when offense_7203(p, o);
    then offense_elements_established(p, o);
}

@source(IRC_S7203, relation = formalizes, coverage = exact, quote = "shall, in addition to other penalties provided by law, be guilty of a misdemeanor")
rule Section7203GradeMisdemeanor(p: Person, o: Offense) defeasible {
    when offense_7203(p, o);
    then offense_grade(o, Misdemeanor);
    unless willful_violation_of_6050I(o) and offense_7203(p, o);
}
@source(IRC_S7203, relation = formalizes, coverage = exact, quote = "In the case of a willful violation of any provision of section 6050I, the first sentence of this section shall be applied by substituting \"felony\" for \"misdemeanor\" and \"5 years\" for \"1 year\".")
rule Section7203GradeFelonyFor6050I(p: Person, o: Offense) defeasible {
    when offense_7203(p, o)
        and willful_violation_of_6050I(o);
    then offense_grade(o, Felony);
}

const Section7203MaxFineIndividual: Money = 25000.00 USD {
    label en unofficial "section 7203 misdemeanor: fine ceiling for an individual defendant";
};
const Section7203MaxFineCorporate: Money = 100000.00 USD {
    label en unofficial "section 7203 misdemeanor: fine ceiling for a corporate defendant";
};
@source(IRC_S7203, relation = formalizes, coverage = exact, quote = "shall be fined not more than $25,000 ($100,000 in the case of a corporation), or imprisoned not more than 1 year, or both, together with the costs of prosecution")
rule Section7203MaxFineForIndividual(p: Individual, o: Offense) defeasible {
    when offense_7203(p, o);
    then statutory_maximum_fine_individual(o, Section7203MaxFineIndividual);
    unless willful_violation_of_6050I(o) and offense_7203(p, o);
}
@source(IRC_S7203, relation = formalizes, coverage = exact, quote = "$100,000 in the case of a corporation")
rule Section7203MaxFineForCorporation(p: Corporation, o: Offense) defeasible {
    when offense_7203(p, o);
    then statutory_maximum_fine_corporate(o, Section7203MaxFineCorporate);
    unless willful_violation_of_6050I(o) and offense_7203(p, o);
}
@source(IRC_S7203, relation = formalizes, coverage = exact, quote = "or imprisoned not more than 1 year, or both, together with the costs of prosecution")
rule Section7203MaxImprisonment(p: Person, o: Offense) defeasible {
    when offense_7203(p, o);
    then statutory_maximum_imprisonment_years(o, 1);
    unless willful_violation_of_6050I(o) and offense_7203(p, o);
}
@source(IRC_S7203, relation = formalizes, coverage = exact, quote = "\"felony\" for \"misdemeanor\" and \"5 years\" for \"1 year\"")
rule Section7203MaxImprisonmentFor6050I(p: Person, o: Offense) defeasible {
    when offense_7203(p, o)
        and willful_violation_of_6050I(o);
    then statutory_maximum_imprisonment_years(o, 5);
}
