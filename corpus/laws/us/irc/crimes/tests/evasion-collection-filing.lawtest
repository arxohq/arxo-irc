// Scenarios for §§7201-7203, package us.irc.crimes, module
// 01-evasion-collection-filing.law. NOT executed in this stage
// (implemented_unverified, per AGENT-BRIEF's NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

// ---------------------------------------------------------------------
// Section 7201 — applies, with willfulness adjudicated
// ---------------------------------------------------------------------
test "S7201-01-EVASION-WITH-AFFIRMATIVE-ACT-AND-WILLFULNESS-ESTABLISHED" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7201:t1#o"), entity_ref("urn:test:s7201:t1#p")) { origin case_input; }
        assert "f1": affirmative_act_of_evasion(entity_ref("urn:test:s7201:t1#o")) { origin case_input; }
        assert "f2": tax_deficiency_or_due(entity_ref("urn:test:s7201:t1#o")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7201:t1#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7201(entity_ref("urn:test:s7201:t1#p"), entity_ref("urn:test:s7201:t1#o")));
    expect truth_status == TRUE_ONLY;
    expect judgment_requests(0);
}

// The forbidden inference (PLAN §6.5 risk table): conduct established,
// willfulness NOT addressed by the case at all -> REQUIRES_JUDGMENT, not
// a silently-derived offense.
test "S7201-02-EVASION-CONDUCT-ONLY-WILLFULNESS-UNKNOWN-REQUIRES-JUDGMENT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7201:t2#o"), entity_ref("urn:test:s7201:t2#p")) { origin case_input; }
        assert "f1": affirmative_act_of_evasion(entity_ref("urn:test:s7201:t2#o")) { origin case_input; }
        assert "f2": tax_deficiency_or_due(entity_ref("urn:test:s7201:t2#o")) { origin case_input; }
    }
    evaluate truth(offense_7201(entity_ref("urn:test:s7201:t2#p"), entity_ref("urn:test:s7201:t2#o")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(willfulness_established, Court);
}

// Corporation vs individual reference maxima.
test "S7201-03-CORPORATE-DEFENDANT-MAX-FINE-500000" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7201:t3#o"), entity_ref("urn:test:s7201:t3#corp")) { origin case_input; }
        assert "f1": affirmative_act_of_evasion(entity_ref("urn:test:s7201:t3#o")) { origin case_input; }
        assert "f2": tax_deficiency_or_due(entity_ref("urn:test:s7201:t3#o")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7201:t3#o")) { origin adjudicated; }
    }
    evaluate truth(statutory_maximum_fine_corporate(entity_ref("urn:test:s7201:t3#o"), 500000.00 USD));
    expect truth_status == TRUE_ONLY;
}

// ---------------------------------------------------------------------
// Section 7202
// ---------------------------------------------------------------------
test "S7202-01-RESPONSIBLE-PERSON-WILLFUL-NONPAYMENT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7202:t1#o"), entity_ref("urn:test:s7202:t1#p")) { origin case_input; }
        assert "f1": required_to_collect_account_pay_over(entity_ref("urn:test:s7202:t1#p")) { origin case_input; }
        assert "f2": failed_to_collect_or_account_and_pay_over(entity_ref("urn:test:s7202:t1#o")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7202:t1#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7202(entity_ref("urn:test:s7202:t1#p"), entity_ref("urn:test:s7202:t1#o")));
    expect truth_status == TRUE_ONLY;
}

// ---------------------------------------------------------------------
// Section 7203 — the civil/criminal separation (PLAN §6.5): a late
// FILING alone (the civil §6651 fact) never derives the criminal offense.
// ---------------------------------------------------------------------
test "S7203-01-WILLFUL-FAILURE-TO-FILE-MISDEMEANOR" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7203:t1#o"), entity_ref("urn:test:s7203:t1#p")) { origin case_input; }
        assert "f1": required_duty_7203(entity_ref("urn:test:s7203:t1#o"), MakeReturn) { origin case_input; }
        assert "f2": failed_duty_7203(entity_ref("urn:test:s7203:t1#o"), MakeReturn) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7203:t1#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7203(entity_ref("urn:test:s7203:t1#p"), entity_ref("urn:test:s7203:t1#o")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(offense_grade(entity_ref("urn:test:s7203:t1#o"), Misdemeanor));
    expect truth_status == TRUE_ONLY;
}

test "S7203-02-LATE-FILING-CIVIL-FACT-ONLY-WILLFULNESS-UNKNOWN-NEITHER" {
    // The two-step scenario 00-vocabulary.law's header describes: a case
    // that establishes ONLY the civil late-filing conduct, with no
    // willfulness assertion at all, must NOT derive the criminal offense.
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7203:t2#o"), entity_ref("urn:test:s7203:t2#p")) { origin case_input; }
        assert "f1": required_duty_7203(entity_ref("urn:test:s7203:t2#o"), MakeReturn) { origin case_input; }
        assert "f2": failed_duty_7203(entity_ref("urn:test:s7203:t2#o"), MakeReturn) { origin case_input; }
    }
    evaluate truth(offense_7203(entity_ref("urn:test:s7203:t2#p"), entity_ref("urn:test:s7203:t2#o")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(willfulness_established, Court);
}

test "S7203-03-ESTIMATED-TAX-ONLY-FAILURE-NO-6654-ADDITION-EXCEPTION-APPLIES" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7203:t3#o"), entity_ref("urn:test:s7203:t3#p")) { origin case_input; }
        assert "f1": required_duty_7203(entity_ref("urn:test:s7203:t3#o"), PayTaxOrEstimatedTax) { origin case_input; }
        assert "f2": failed_duty_7203(entity_ref("urn:test:s7203:t3#o"), PayTaxOrEstimatedTax) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7203:t3#o")) { origin adjudicated; }
        assert "f3": failure_is_only_estimated_tax_payment(entity_ref("urn:test:s7203:t3#o")) { origin case_input; }
        assert "f4": no_addition_under_6654_or_6655(entity_ref("urn:test:s7203:t3#o")) { origin case_input; }
    }
    evaluate truth(offense_7203(entity_ref("urn:test:s7203:t3#p"), entity_ref("urn:test:s7203:t3#o")));
    expect truth_status == FALSE_ONLY;
}

test "S7203-04-WILLFUL-6050I-VIOLATION-FELONY-SUBSTITUTION" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7203:t4#o"), entity_ref("urn:test:s7203:t4#p")) { origin case_input; }
        assert "f1": required_duty_7203(entity_ref("urn:test:s7203:t4#o"), SupplyInformation) { origin case_input; }
        assert "f2": failed_duty_7203(entity_ref("urn:test:s7203:t4#o"), SupplyInformation) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7203:t4#o")) { origin adjudicated; }
        assert "f3": willful_violation_of_6050I(entity_ref("urn:test:s7203:t4#o")) { origin case_input; }
    }
    evaluate truth(offense_grade(entity_ref("urn:test:s7203:t4#o"), Felony));
    expect truth_status == TRUE_ONLY;
    evaluate truth(statutory_maximum_imprisonment_years(entity_ref("urn:test:s7203:t4#o"), 5));
    expect truth_status == TRUE_ONLY;
}
