// Scenarios for §§7231-7232, 7261-7275, package us.irc.crimes, module
// 04-occupational-and-minor-offenses.law. NOT executed in this stage
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

test "S7231-01-FOREIGN-ITEM-COLLECTION-WITHOUT-LICENSE-MISDEMEANOR" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7231:t1#o"), entity_ref("urn:test:s7231:t1#p")) { origin case_input; }
        assert "f1": required_license_for_foreign_item_collection(entity_ref("urn:test:s7231:t1#p")) { origin case_input; }
        assert "f2": collected_foreign_items_without_license_or_compliance(entity_ref("urn:test:s7231:t1#o")) { origin case_input; }
    }
    evaluate truth(offense_7231(entity_ref("urn:test:s7231:t1#p"), entity_ref("urn:test:s7231:t1#o")));
    expect truth_status == TRUE_ONLY;
}

test "S7232-01-FALSE-4101-APPLICATION-STATEMENT-WILLFUL" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7232:t1#o"), entity_ref("urn:test:s7232:t1#p")) { origin case_input; }
        assert "f1": false_statement_in_4101_application(entity_ref("urn:test:s7232:t1#o")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7232:t1#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7232(entity_ref("urn:test:s7232:t1#p"), entity_ref("urn:test:s7232:t1#o")));
    expect truth_status == TRUE_ONLY;
}

test "S7232-02-FAILURE-TO-REGISTER-NO-WILLFULNESS-NEEDED" {
    // The failure-to-register branch of section 7232 names no mental
    // element (unlike the false-application branch above).
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7232:t2#o"), entity_ref("urn:test:s7232:t2#p")) { origin case_input; }
        assert "f1": failed_to_register_under_4101(entity_ref("urn:test:s7232:t2#o")) { origin case_input; }
    }
    evaluate truth(offense_7232(entity_ref("urn:test:s7232:t2#p"), entity_ref("urn:test:s7232:t2#o")));
    expect truth_status == TRUE_ONLY;
    expect judgment_requests(0);
}

test "S7275-01-TICKET-OMITS-TAX-DISCLOSURE-MISDEMEANOR-100-FINE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7275:t1#o"), entity_ref("urn:test:s7275:t1#carrier")) { origin case_input; }
    }
    evaluate truth(offense_7275(entity_ref("urn:test:s7275:t1#carrier"), entity_ref("urn:test:s7275:t1#o")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(statutory_maximum_fine_individual(entity_ref("urn:test:s7275:t1#o"), 100.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7275-02-TICKET-DISCLOSES-TAX-NO-VIOLATION" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7275:t2#o"), entity_ref("urn:test:s7275:t2#carrier")) { origin case_input; }
        assert "f1": ticket_disclosed_total_fare_and_tax(entity_ref("urn:test:s7275:t2#o")) { origin case_input; }
        assert "f2": advertising_disclosed_cost_and_tax_per_7275b(entity_ref("urn:test:s7275:t2#o")) { origin case_input; }
    }
    evaluate truth(offense_7275(entity_ref("urn:test:s7275:t2#carrier"), entity_ref("urn:test:s7275:t2#o")));
    expect truth_status == FALSE_ONLY;
}
