        assert "f1": return_preparer(entity_ref("urn:test:s7216:t2#preparer")) { origin case_input; }
        assert "f2": used_return_preparation_information_for_other_purpose(entity_ref("urn:test:s7216:t2#o")) { origin case_input; }
        assert "j0": knowing_or_reckless_disclosure_established(entity_ref("urn:test:s7216:t2#o")) { origin adjudicated; }
        assert "f3": use_for_state_or_local_return_of_same_person(entity_ref("urn:test:s7216:t2#o")) { origin case_input; }
    }
    evaluate truth(offense_7216(entity_ref("urn:test:s7216:t2#preparer"), entity_ref("urn:test:s7216:t2#o")));
    expect truth_status == FALSE_ONLY;
}

