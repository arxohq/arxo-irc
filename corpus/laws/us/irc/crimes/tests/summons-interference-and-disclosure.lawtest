// Scenarios for §§7210-7217, package us.irc.crimes, module
// 03-summons-interference-and-disclosure.law. NOT executed in this stage
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

test "S7212a-01-GENERAL-INTERFERENCE-5000-FINE-3-YEARS" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7212a:t1#o"), entity_ref("urn:test:s7212a:t1#p")) { origin case_input; }
        assert "f1": intimidated_or_impeded_officer(entity_ref("urn:test:s7212a:t1#o")) { origin case_input; }
        assert "j0": corrupt_or_forcible_intent_established(entity_ref("urn:test:s7212a:t1#o")) { origin adjudicated; }
    }
    evaluate truth(statutory_maximum_fine_individual(entity_ref("urn:test:s7212a:t1#o"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7212a-02-THREATS-OF-FORCE-ONLY-REDUCED-3000-FINE-1-YEAR" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7212a:t2#o"), entity_ref("urn:test:s7212a:t2#p")) { origin case_input; }
        assert "f1": intimidated_or_impeded_officer(entity_ref("urn:test:s7212a:t2#o")) { origin case_input; }
        assert "j0": corrupt_or_forcible_intent_established(entity_ref("urn:test:s7212a:t2#o")) { origin adjudicated; }
        assert "f2": only_threats_of_force(entity_ref("urn:test:s7212a:t2#o")) { origin case_input; }
    }
    evaluate truth(statutory_maximum_fine_individual(entity_ref("urn:test:s7212a:t2#o"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(statutory_maximum_imprisonment_years(entity_ref("urn:test:s7212a:t2#o"), 1));
    expect truth_status == TRUE_ONLY;
}

// Section 7213(a)(1)/(2): built on us.irc.confidentiality's own
// unauthorized_disclosure(d) — this scenario asserts the confidentiality
// package's own case facts so its rule derives unauthorized_disclosure,
// then this package's willfulness channel completes the felony.
test "S7213-01-WILLFUL-UNAUTHORIZED-DISCLOSURE-FELONY" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7213:t1#o"), entity_ref("urn:test:s7213:t1#officer")) { origin case_input; }
        assert "f1": offense_disclosure(entity_ref("urn:test:s7213:t1#o"), entity_ref("urn:test:s7213:t1#d")) { origin case_input; }
        assert "f2": us.irc.confidentiality::covered_person(entity_ref("urn:test:s7213:t1#officer")) { origin case_input; }
        assert "f3": us.irc.confidentiality::return_information(entity_ref("urn:test:s7213:t1#info")) { origin case_input; }
        assert "f4": us.irc.confidentiality::disclosure_by(entity_ref("urn:test:s7213:t1#d"), entity_ref("urn:test:s7213:t1#officer")) { origin case_input; }
        assert "f5": us.irc.confidentiality::disclosure_to(entity_ref("urn:test:s7213:t1#d"), entity_ref("urn:test:s7213:t1#stranger")) { origin case_input; }
        assert "f6": us.irc.confidentiality::disclosure_of(entity_ref("urn:test:s7213:t1#d"), entity_ref("urn:test:s7213:t1#info")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7213:t1#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7213_1_or_2(entity_ref("urn:test:s7213:t1#officer"), entity_ref("urn:test:s7213:t1#o")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(offense_grade(entity_ref("urn:test:s7213:t1#o"), Felony));
    expect truth_status == TRUE_ONLY;
}

