// Scenarios for §§7204-7209, package us.irc.crimes, module
// 02-fraud-and-false-statements.law. NOT executed in this stage
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

test "S7206-01-PERJURED-DECLARATION-FELONY" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7206:t1#o"), entity_ref("urn:test:s7206:t1#p")) { origin case_input; }
        assert "f1": perjured_declaration(entity_ref("urn:test:s7206:t1#o")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7206:t1#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7206(entity_ref("urn:test:s7206:t1#p"), entity_ref("urn:test:s7206:t1#o")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(offense_grade(entity_ref("urn:test:s7206:t1#o"), Felony));
    expect truth_status == TRUE_ONLY;
}

test "S7206-02-REMOVAL-CONCEALMENT-NEEDS-INTENT-TO-EVADE-NOT-WILLFULNESS" {
    // Paragraph (4)'s own channel is intent_to_evade_or_defeat_established,
    // not willfulness_established — asserting only the latter must not
    // establish this branch.
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7206:t2#o"), entity_ref("urn:test:s7206:t2#p")) { origin case_input; }
        assert "f1": removed_or_concealed_taxable_property(entity_ref("urn:test:s7206:t2#o")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7206:t2#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7206(entity_ref("urn:test:s7206:t2#p"), entity_ref("urn:test:s7206:t2#o")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(intent_to_evade_or_defeat_established, Court);
}

