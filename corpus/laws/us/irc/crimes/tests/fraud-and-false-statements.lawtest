        }
        assert "f0": offense_person(entity_ref("urn:test:s7206:t3#o"), entity_ref("urn:test:s7206:t3#p")) { origin case_input; }
        assert "f1": removed_or_concealed_taxable_property(entity_ref("urn:test:s7206:t3#o")) { origin case_input; }
        assert "j0": intent_to_evade_or_defeat_established(entity_ref("urn:test:s7206:t3#o")) { origin adjudicated; }
    }
    evaluate truth(offense_7206(entity_ref("urn:test:s7206:t3#p"), entity_ref("urn:test:s7206:t3#o")));
