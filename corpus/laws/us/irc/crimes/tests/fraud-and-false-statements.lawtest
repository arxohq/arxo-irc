}

test "S7207-01-FRAUDULENT-DOCUMENT-CORPORATE-MAX-FINE-50000" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7207:t1#o"), entity_ref("urn:test:s7207:t1#corp")) { origin case_input; }
        assert "f1": delivered_or_disclosed_known_fraudulent_document(entity_ref("urn:test:s7207:t1#o")) { origin case_input; }
        assert "j0": willfulness_established(entity_ref("urn:test:s7207:t1#o")) { origin adjudicated; }
    }
    evaluate truth(statutory_maximum_fine_corporate(entity_ref("urn:test:s7207:t1#o"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7209-01-UNAUTHORIZED-STAMP-DEALING-NO-MENTAL-ELEMENT-NEEDED" {
    // Section 7209 names no mental element: conduct alone is sufficient,
    // with no judgment request expected.
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7209:t1#o"), entity_ref("urn:test:s7209:t1#p")) { origin case_input; }
        assert "f1": dealt_in_stamp_without_authorization(entity_ref("urn:test:s7209:t1#o")) { origin case_input; }
    }
    evaluate truth(offense_7209(entity_ref("urn:test:s7209:t1#p"), entity_ref("urn:test:s7209:t1#o")));
    expect truth_status == TRUE_ONLY;
    expect judgment_requests(0);
}

test "S7209-02-NO-CONDUCT-UNDETERMINED" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": offense_person(entity_ref("urn:test:s7209:t2#o"), entity_ref("urn:test:s7209:t2#p")) { origin case_input; }
    }
    evaluate truth(offense_7209(entity_ref("urn:test:s7209:t2#p"), entity_ref("urn:test:s7209:t2#o")));
    expect truth_status == NEITHER;
}
