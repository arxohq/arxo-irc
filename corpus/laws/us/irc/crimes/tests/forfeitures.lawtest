// Scenarios for §§7301-7304, 7321-7328, package us.irc.crimes, module
// 05-forfeitures.law. NOT executed in this stage (implemented_unverified).

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

test "S7301a-01-TAXABLE-ARTICLE-HELD-TO-EVADE-TAX-FORFEITED" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": property_bears_tax(entity_ref("urn:test:s7301a:t1#pr")) { origin case_input; }
        assert "f1": held_for_sale_or_removal_in_fraud_or_to_avoid_tax(entity_ref("urn:test:s7301a:t1#pr")) { origin case_input; }
    }
    evaluate truth(property_subject_to_forfeiture(entity_ref("urn:test:s7301a:t1#pr")));
    expect truth_status == TRUE_ONLY;
}

test "S7321-01-SECRETARY-SEIZURE-POWER-VALID" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": property_bears_tax(entity_ref("urn:test:s7321:t1#pr")) { origin case_input; }
        assert "f1": removed_deposited_or_concealed_to_defraud(entity_ref("urn:test:s7321:t1#pr")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section7321SeizurePower, ACTIVE);
}

// Section 7325 — 30-day claim window: day 30 valid, day 31 too late.
test "S7325-01-CLAIM-FILED-ON-DAY-30-VALID" {
    given {
        context {
            legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-04:00;
            knowledge_time @2026-05-01T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": property_bears_tax(entity_ref("urn:test:s7325:t1#pr")) { origin case_input; }
        assert "f1": removed_deposited_or_concealed_to_defraud(entity_ref("urn:test:s7325:t1#pr")) { origin case_input; }
        assert "f2": seizure_appraised_value(entity_ref("urn:test:s7325:t1#pr"), 40000.00 USD) { origin case_input; }
        assert "f3": notice_of_seizure_published_on(entity_ref("urn:test:s7325:t1#pr"), @2026-04-01) { origin case_input; }
        assert "f4": forfeiture_claim_filed_on(entity_ref("urn:test:s7325:t1#pr"), @2026-05-01) { origin case_input; }
        assert "f5": claim_bond_executed(entity_ref("urn:test:s7325:t1#pr")) { origin case_input; }
    }
    evaluate truth(summary_forfeiture_claim_valid(entity_ref("urn:test:s7325:t1#pr")));
    expect truth_status == TRUE_ONLY;
}

test "S7325-02-CLAIM-FILED-ON-DAY-31-TOO-LATE" {
    given {
        context {
            legal_time @2026-05-02; decision_time @2026-05-02T09:00:00-04:00;
            knowledge_time @2026-05-02T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": property_bears_tax(entity_ref("urn:test:s7325:t2#pr")) { origin case_input; }
        assert "f1": removed_deposited_or_concealed_to_defraud(entity_ref("urn:test:s7325:t2#pr")) { origin case_input; }
        assert "f2": seizure_appraised_value(entity_ref("urn:test:s7325:t2#pr"), 40000.00 USD) { origin case_input; }
        assert "f3": notice_of_seizure_published_on(entity_ref("urn:test:s7325:t2#pr"), @2026-04-01) { origin case_input; }
        assert "f4": forfeiture_claim_filed_on(entity_ref("urn:test:s7325:t2#pr"), @2026-05-02) { origin case_input; }
        assert "f5": claim_bond_executed(entity_ref("urn:test:s7325:t2#pr")) { origin case_input; }
    }
    evaluate truth(summary_forfeiture_claim_valid(entity_ref("urn:test:s7325:t2#pr")));
    expect truth_status == FALSE_ONLY;
    evaluate truth(summary_sale_authorized(entity_ref("urn:test:s7325:t2#pr")));
    expect truth_status == TRUE_ONLY;
}

test "S7325-03-VALUE-ABOVE-100000-NOT-SUMMARY-ELIGIBLE" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": property_bears_tax(entity_ref("urn:test:s7325:t3#pr")) { origin case_input; }
        assert "f1": removed_deposited_or_concealed_to_defraud(entity_ref("urn:test:s7325:t3#pr")) { origin case_input; }
        assert "f2": seizure_appraised_value(entity_ref("urn:test:s7325:t3#pr"), 150000.00 USD) { origin case_input; }
    }
    evaluate truth(summary_forfeiture_eligible(entity_ref("urn:test:s7325:t3#pr")));
    expect truth_status == FALSE_ONLY;
}
