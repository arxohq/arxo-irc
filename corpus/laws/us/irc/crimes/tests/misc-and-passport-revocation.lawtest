        assert "f1": seriously_delinquent_debt_amount(entity_ref("urn:test:s7345:t2#ind"), 66001.00 USD) { origin case_input; }
        assert "f2": lien_notice_filed_and_rights_exhausted(entity_ref("urn:test:s7345:t2#ind")) { origin case_input; }
    }
    evaluate truth(seriously_delinquent_tax_debt(entity_ref("urn:test:s7345:t2#ind")));
    expect truth_status == TRUE_ONLY;
    evaluate positions();
    expect position(Section7345CertificationPower, ACTIVE);
}

test "S7345-03-DEBT-66001-WITH-INSTALLMENT-AGREEMENT-EXCEPTION-APPLIES" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": seriously_delinquent_debt_assessed(entity_ref("urn:test:s7345:t3#ind")) { origin case_input; }
        assert "f1": seriously_delinquent_debt_amount(entity_ref("urn:test:s7345:t3#ind"), 66001.00 USD) { origin case_input; }
        assert "f2": lien_notice_filed_and_rights_exhausted(entity_ref("urn:test:s7345:t3#ind")) { origin case_input; }
        assert "f3": us.irc.payment_refunds_interest::installment_agreement_for(entity_ref("urn:test:s7345:t3#agr"), entity_ref("urn:test:s7345:t3#ind"), entity_ref("urn:test:s7345:t3#y"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f4": us.irc.payment_refunds_interest::installment_agreement_entered(entity_ref("urn:test:s7345:t3#ind"), entity_ref("urn:test:s7345:t3#y"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f5": debt_paid_timely_under_agreement(entity_ref("urn:test:s7345:t3#ind")) { origin case_input; }
    }
    evaluate truth(seriously_delinquent_tax_debt(entity_ref("urn:test:s7345:t3#ind")));
    expect truth_status == FALSE_ONLY;
}

