// Scenarios for §§7341-7345, package us.irc.crimes, modules
// 00-vocabulary.law (section 7343) and 06-misc-and-passport-revocation.law.
// NOT executed in this stage (implemented_unverified).

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

// Section 7343 applied to a corporate officer.
test "S7343-01-CORPORATE-OFFICER-UNDER-DUTY-IS-CHAPTER75-PERSON" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": duty_bound_corporate_officer(entity_ref("urn:test:s7343:t1#officer"), entity_ref("urn:test:s7343:t1#corp")) { origin case_input; }
    }
    evaluate truth(chapter75_person(entity_ref("urn:test:s7343:t1#officer")));
    expect truth_status == TRUE_ONLY;
}

test "S7343-02-ORDINARY-INDIVIDUAL-NOT-ASSERTED-AS-DUTY-BOUND-UNDETERMINED" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
