// Section 7345 — threshold (indexed under section 7345(f): $66,000 for 2026, stage 4) not "greater than" vs one dollar more.
test "S7345-01-DEBT-EXACTLY-THE-INDEXED-66000-NOT-SERIOUSLY-DELINQUENT" {
    // section 7345(b)(1)(B) requires "greater than" the section 7345(f)-indexed amount ($66,000 for 2026) — exactly
    // that amount does NOT cross the threshold.
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
        assert "f0": seriously_delinquent_debt_assessed(entity_ref("urn:test:s7345:t1#ind")) { origin case_input; }
        assert "f1": seriously_delinquent_debt_amount(entity_ref("urn:test:s7345:t1#ind"), 66000.00 USD) { origin case_input; }
        assert "f2": lien_notice_filed_and_rights_exhausted(entity_ref("urn:test:s7345:t1#ind")) { origin case_input; }
    }
    evaluate truth(seriously_delinquent_tax_debt(entity_ref("urn:test:s7345:t1#ind")));
    expect truth_status == FALSE_ONLY;
}

test "S7345-02-DEBT-66001-WITH-LIEN-SERIOUSLY-DELINQUENT" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-04:00;
            knowledge_time @2026-04-15T09:00:00-04:00; timezone "America/New_York";
        }
