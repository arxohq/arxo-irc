// 26 U.S.C. Chapter 75 — stage 4 (26.09.2026, DECISION-0379, implemented_unverified): the rows that
// stages 1-3 left as TECH_GAP or SOURCE_GAP and could be expressed.
//
// Covered: section 7208(3)(A)-(C) and (4)(B)-(C) as separate conduct kinds; the 6-month ceiling of
// section 7209; the greater-of fine of section 7212(b); the State/other-person branch of
// section 7213(a)(2); the fine floor of section 7262; the computed penalties of sections 7268, 7270,
// 7273 and 7304; and the section 7345(f) indexing of the seriously-delinquent-debt threshold.
//
// METHOD AND JUDGMENT CALLS.
//  - The penalty amounts are REFERENCE VALUES reached once the offense is established, exactly like the
//    ceilings of the earlier modules; no sentence is derived (DECISION-0194 discipline of module 00).
//  - Section 7268 ("$500 or not less than double the amount of taxes"): read as a floor equal to the
//    greater of $500 and twice the tax. This reading is a JUDGMENT CALL; the text does not say who picks.
//  - Section 7304: the Secretary's election between "triple the amount" and "$500" is a case fact
//    (`secretary_elects_*`); with no election recorded no amount is derived. The wrongfully claimed
//    amount is the claim less the tax actually paid (the whole claim when nothing was paid).
//  - Section 7208(4)(C): the burden of the "lawful excuse" is on the accused, so the offense holds
//    until the excuse is shown (`not_known` over the accused's showing).
//  - Section 7345(f): the pinned figures are the A3 parameter used by module 06; the formula below is
//    a calculation over a case-supplied cost-of-living factor (`us.irc.income_individual` machinery is
//    not imported), for years the pinned Revenue Procedures do not cover (TECH-GAPS.md G5640).

language "law.core" version "0.2";
package us.irc.crimes version "0.1.1";
namespace "urn:us:irc:crimes:clir";

use self::{
    Disclosure,
    IRC_S7208,
    IRC_S7209,
    IRC_S7212_B,
    IRC_S7213_A,
    IRC_S7262,
    IRC_S7268,
    IRC_S7270,
    IRC_S7273,
    IRC_S7304,
    IRC_S7345_F,
    Offense,
    Person,
    StampOffenseKind,
    display_failure_through_willful_neglect_or_refusal,
    drawback_claim_amount,
    knowledge_established,
    offense_7208,
    offense_7209,
    offense_7212b,
    offense_7213_1_or_2,
    offense_7262,
    offense_7268,
    offense_7270,
    offense_7273,
    offense_7304,
    offense_disclosure,
    offense_person,
    seized_property_value,
    special_tax_amount,
    stamp_offense_conduct,
    statutory_maximum_fine_individual,
    willfulness_established,
};

pub relation statutory_minimum_fine_individual(o: Offense, amount: Money) kind institutional {
    label en unofficial "the statutory floor on a fine for o against an individual defendant, where the section states one — a reference value, not a sentence";
}
pub relation statutory_maximum_imprisonment_months(o: Offense, months: Integer) kind institutional {
    label en unofficial "the statutory ceiling, in months, on imprisonment for o where the section states months, not years — a reference value, not a sentence";
}
pub relation statutory_penalty_amount(o: Offense, amount: Money) kind institutional {
    label en unofficial "the amount of a penalty, fine or forfeiture the section fixes as a function of a tax or claim amount — a reference value, not a sentence";
}

// ---------------------------------------------------------------------
// Section 7208(3)(A)-(C) and (4)(B)-(C)
// ---------------------------------------------------------------------

@source(IRC_S7208, relation = formalizes, coverage = exact, quote = "any adhesive stamp, or the impression of any stamp, die, plate, or other article, which has been cut, torn, or removed from any other vellum, parchment, paper, instrument, writing, package, or article, upon which any tax is imposed by this title")
rule Section7208UseOfCutStampOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, UseOfStampCutFromAnotherArticle);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = exact, quote = "any adhesive stamp or the impression of any stamp, die, plate, or other article of insufficient value")
rule Section7208UseOfInsufficientStampOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, UseOfStampOfInsufficientValue);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = exact, quote = "any forged or counterfeited stamp, or the impression of any forged or counterfeited stamp, die, plate, or other article")
rule Section7208UseOfForgedStampOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, UseOfForgedOrCounterfeitedStamp);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = exact, quote = "Knowingly or willfully buys, sells, offers for sale, or gives away, any such washed or restored stamp to any person for use, or knowingly uses the same")
rule Section7208TraffickingOffenseWillful(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, TraffickingInWashedOrRestoredStamp)
        and willfulness_established(o);
    then offense_7208(p, o);
}
@source(IRC_S7208, relation = formalizes, coverage = exact, quote = "Knowingly or willfully buys, sells, offers for sale, or gives away, any such washed or restored stamp to any person for use, or knowingly uses the same")
rule Section7208TraffickingOffenseKnowing(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, TraffickingInWashedOrRestoredStamp)
        and knowledge_established(o);
    then offense_7208(p, o);
}
pub relation lawful_excuse_shown_for_stamp_possession(o: Offense) kind empirical {
    label en unofficial "case fact: the accused has shown a lawful excuse for having the washed, restored or altered stamp in possession — the burden of proof of the excuse is on the accused (section 7208(4)(C))";
}
@source(IRC_S7208, relation = formalizes, coverage = exact, quote = "Knowingly and without lawful excuse (the burden of proof of such excuse being on the accused) has in possession any washed, restored, altered stamp, which has been removed from any vellum, parchment, paper, instrument, writing, package, or article")
rule Section7208PossessionOffense(p: Person, o: Offense) strict {
    when offense_person(o, p)
        and stamp_offense_conduct(o, PossessionOfWashedRestoredOrAlteredStamp)
        and knowledge_established(o)
        and not_known(lawful_excuse_shown_for_stamp_possession(o));
    then offense_7208(p, o);
}

// ---------------------------------------------------------------------
// Section 7209: the 6-month ceiling
// ---------------------------------------------------------------------

@source(IRC_S7209, relation = formalizes, coverage = exact, quote = "be fined not more than $1,000, or imprisoned not more than 6 months, or both.")
rule Section7209MaxImprisonmentMonths(p: Person, o: Offense) strict {
    when offense_7209(p, o);
    then statutory_maximum_imprisonment_months(o, 6);
}

// ---------------------------------------------------------------------
// Section 7212(b): "$500, or not more than double the value ..., whichever is the greater"
// ---------------------------------------------------------------------

@source(IRC_S7212_B, relation = formalizes, coverage = exact, quote = "be fined not more than $500, or not more than double the value of the property so rescued, whichever is the greater")
rule Section7212bMaxFineGreaterOfRule(p: Person, o: Offense, value: Money) strict {
    when offense_7212b(p, o)
        and seized_property_value(o, value);
    then statutory_maximum_fine_individual(o, max(500.00 USD, value * 2.0));
}

// ---------------------------------------------------------------------
// Section 7213(a)(2): State and other persons
// ---------------------------------------------------------------------

pub relation person_described_in_7213a1(o: Offense) kind empirical {
    label en unofficial "case fact: the person alleged in o is described in section 7213(a)(1) (an officer or employee of the United States, a section 6103(n) person or its officer or employee, or a former officer or employee) — paragraph (2) reaches persons not so described";
}
pub relation return_information_acquired_under_7213a2_provision(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information disclosed in d was acquired under a provision listed in section 7213(a)(2) (section 6103(d), (i)(1)(C), (i)(3)(B)(i), (i)(7)(A)(ii), (k)(10), (13), (14), (15), (l)(6)-(10), (12), (15), (16), (19)-(21), (m)(2), (4)-(7), or section 6104(c))";
}
@source(IRC_S7213_A, relation = formalizes, coverage = exact, quote = "It shall be unlawful for any person (not described in paragraph (1)) willfully to disclose to any person, except as authorized in this title, any return or return information (as defined in section 6103(b)) acquired by him or another person under subsection (d)")
rule Section7213Paragraph2Offense(p: Person, o: Offense, d: Disclosure) strict {
    when offense_person(o, p)
        and offense_disclosure(o, d)
        and us.irc.confidentiality::unauthorized_disclosure(d)
        and us.irc.confidentiality::disclosure_by(d, p)
        and return_information_acquired_under_7213a2_provision(d)
        and not_known(person_described_in_7213a1(o))
        and willfulness_established(o);
    then offense_7213_1_or_2(p, o);
}

// ---------------------------------------------------------------------
// Section 7262: floor and ceiling
// ---------------------------------------------------------------------

const Section7262MinFine: Money = 1000.00 USD { label en unofficial "section 7262: fine floor"; };
@source(IRC_S7262, relation = formalizes, coverage = exact, quote = "be fined not less than $1,000 and not more than $5,000.")
rule Section7262MinFineRule(p: Person, o: Offense) strict {
    when offense_7262(p, o);
    then statutory_minimum_fine_individual(o, Section7262MinFine);
}

// ---------------------------------------------------------------------
// Sections 7268, 7270, 7273, 7304: amounts computed from a tax or claim amount
// ---------------------------------------------------------------------

pub relation tax_fraudulently_attempted_to_be_evaded(o: Offense, amount: Money) kind empirical {
    label en unofficial "case fact: the amount of taxes fraudulently attempted to be evaded on the goods in o (section 7268)";
}
@source(IRC_S7268, relation = formalizes, coverage = exact, quote = "shall be liable to a penalty of $500 or not less than double the amount of taxes fraudulently attempted to be evaded.")
rule Section7268PenaltyFloorRule(p: Person, o: Offense, tax: Money) strict {
    when offense_7268(p, o)
        and tax_fraudulently_attempted_to_be_evaded(o, tax);
    then statutory_penalty_amount(o, max(500.00 USD, tax * 2.0));
}

pub relation tax_on_foreign_insurer_policy(o: Offense, amount: Money) kind empirical {
    label en unofficial "case fact: the amount of the section 4374 tax the person alleged in o intended to evade (section 7270)";
}
@source(IRC_S7270, relation = formalizes, coverage = exact, quote = "pay a fine of double the amount of the tax.")
rule Section7270DoubleTaxFineRule(p: Person, o: Offense, tax: Money) strict {
    when offense_7270(p, o)
        and tax_on_foreign_insurer_policy(o, tax);
    then statutory_penalty_amount(o, tax * 2.0);
}

@source(IRC_S7273, relation = formalizes, coverage = exact, quote = "shall be liable to a penalty (not less than $10) equal to the special tax for which his business rendered him liable")
rule Section7273BasePenaltyRule(p: Person, o: Offense, tax: Money) defeasible {
    when offense_7273(p, o)
        and special_tax_amount(o, tax);
    then statutory_penalty_amount(o, max(10.00 USD, tax));
    unless display_failure_through_willful_neglect_or_refusal(o) and offense_7273(p, o) and special_tax_amount(o, tax);
}
@source(IRC_S7273, relation = formalizes, coverage = exact, quote = "If such failure to comply with section 6806 is through willful neglect or refusal, then the penalty shall be double the amount above prescribed.")
rule Section7273WillfulDoublePenaltyRule(p: Person, o: Offense, tax: Money) defeasible {
    when offense_7273(p, o)
        and special_tax_amount(o, tax)
        and display_failure_through_willful_neglect_or_refusal(o);
    then statutory_penalty_amount(o, max(10.00 USD, tax) * 2.0);
}

pub relation secretary_elects_triple_amount(o: Offense) kind empirical {
    label en unofficial "case fact: the Secretary has elected the triple-the-amount forfeiture of section 7304";
}
pub relation secretary_elects_fixed_sum(o: Offense) kind empirical {
    label en unofficial "case fact: the Secretary has elected the $500 sum of section 7304";
}
@source(IRC_S7304, relation = formalizes, coverage = exact, quote = "he shall forfeit triple the amount wrongfully or fraudulently claimed or sought to be obtained")
rule Section7304TripleAmountRule(p: Person, o: Offense, claimed: Money, paid: Money) strict {
    when offense_7304(p, o)
        and drawback_claim_amount(o, claimed, paid)
        and secretary_elects_triple_amount(o);
    then statutory_penalty_amount(o, max(claimed - paid, 0.00 USD) * 3.0);
}
@source(IRC_S7304, relation = formalizes, coverage = exact, quote = "or the sum of $500, at the election of the Secretary.")
rule Section7304FixedSumRule(p: Person, o: Offense) strict {
    when offense_7304(p, o)
        and secretary_elects_fixed_sum(o);
    then statutory_penalty_amount(o, 500.00 USD);
}

// ---------------------------------------------------------------------
// Section 7345(f): indexing of the section 7345(b)(1)(B) amount
// ---------------------------------------------------------------------

const Section7345BaseAmount: Money = 50000.00 USD { label en unofficial "section 7345(b)(1)(B): the statutory dollar amount before the section 7345(f) increase"; };
relation section7345_cola_factor(calendarYear: Integer, factor: Decimal) kind empirical {
    label en unofficial "the cost-of-living adjustment determined under section 1(f)(3) for the calendar year with calendar year 2015 substituted for calendar year 2016 (external: `us.irc.income_individual` machinery, not imported)";
}
relation section7345_indexed_amount_requested(calendarYear: Integer) kind empirical {
    label en unofficial "the indexed section 7345(b)(1)(B) amount for the calendar year is asked for";
}
pub relation indexed_seriously_delinquent_threshold(calendarYear: Integer, amount: Money) kind institutional {
    label en unofficial "the section 7345(b)(1)(B) dollar amount for a calendar year beginning after 2016: the amount plus the amount times the cost-of-living adjustment, rounded to the nearest multiple of $1,000";
}
@source(IRC_S7345_F, relation = formalizes, coverage = exact, quote = "In the case of a calendar year beginning after 2016, the dollar amount in subsection (b)(1)(B) shall be increased by an amount equal to—")
rule Section7345fIncreaseByCostOfLivingAdjustment(cy: Integer, factor: Decimal) strict {
    when section7345_indexed_amount_requested(cy)
        and cy > 2016
        and section7345_cola_factor(cy, factor);
    then indexed_seriously_delinquent_threshold(cy, div_round(Section7345BaseAmount * (1.0 + factor), 1000.0, 0, "HALF_UP") * 1000);
}
