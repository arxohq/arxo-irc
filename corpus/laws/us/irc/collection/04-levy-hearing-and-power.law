// §6330 (notice and opportunity for hearing before levy) and §6331 (levy and
// distraint). §6330 also supplies the SHARED collection-due-process hearing
// machinery that §6320(c) incorporates by cross-reference ("subsections (c),
// (d) (other than paragraph (3)(B) thereof), (e), and (g) of section 6330
// shall apply" to a §6320 lien-filing hearing) — declared once here, tagged
// by `CDPOrigin`, and reused by 03-lien-hearing-and-release.law's §6320
// module under `CDPOrigin::LienFilingNotice`.
//
// JUDGMENT CALLS (see report):
//  - §6330(c)(1)-(3) (verification, issues, determination factors) are
//    modelled as classification facts feeding one `cdp_determination_made`
//    institutional effect, not as a full adjudicative outcome model — this
//    stage does not compute WHICH way the appeals officer decides (that is
//    an institutional act of the Independent Office of Appeals, not a
//    function of case facts this package can derive); the operative,
//    computable consequence PLAN's pilot chain needs is the suspension
//    (e) and the immunity against levy while the hearing is pending, both
//    of which follow from the REQUEST alone, not from the determination's
//    content. `cdp_determination_made` records only THAT a determination
//    was made (for the §6330(d) 30-day Tax Court window to run from).
//  - §6330(e)/§6320(c)'s incorporation of (e) suspends the running of the
//    §6502 (owner `assessment`), §6531 and §6532 (owner `judicial-
//    proceedings`) periods. This package does not compute either period's
//    end date (both are concurrent/pending owners); it PRODUCES the
//    suspension fact (`collection_period_suspended_by_cdp`) as a pub
//    institutional effect for those owners to consume when they model the
//    period itself — recorded as a forward pub, not a dependency taken on.
//  - §6330(f)'s exceptions (jeopardy, State refund levy, disqualified
//    employment tax levy, Federal contractor levy) are modelled as
//    defeaters on the PRE-levy notice duty (no pre-levy hearing required)
//    plus a separate, weaker duty to give the taxpayer a hearing "within a
//    reasonable period of time" AFTER the levy — not as an exception to the
//    levy power's validity itself.
//  - §6331(b) (definition: "levy" includes distraint/seizure; extends to
//    property possessed and obligations existing at the time) and §6331(l)
//    (cross-references) are `non_normative`/definitional folded into the
//    `levy_made` relation's label rather than separately ruled.
//  - §6331(h)'s 15%/100% continuous levy on specified Federal payments is
//    modelled at the classification level (which rate applies) without a
//    full `SpecifiedPayment` sub-taxonomy of §6334(a)(4)/(7)/(9)/(11) —
//    those four cross-references are read directly off `ExemptPropertyKind`.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    Assessment,
    CDPOrigin,
    IRC_S6330_A,
    IRC_S6330_B,
    IRC_S6330_C,
    IRC_S6330_D,
    IRC_S6330_E,
    IRC_S6330_F,
    IRC_S6330_G,
    IRC_S6330_H,
    IRC_S6331_A,
    IRC_S6331_C,
    IRC_S6331_D,
    IRC_S6331_E,
    IRC_S6331_F,
    IRC_S6331_G,
    IRC_S6331_H,
    IRC_S6331_I,
    IRC_S6331_J,
    IRC_S6331_K,
    Levy,
    Person,
    Secretary,
    assessment_of_person,
    jeopardy_finding,
    neglected_or_refused_to_pay,
};

// ============================================================================
// Shared collection due process (CDP) hearing mechanics — §6330(c)-(g),
// incorporated into §6320 by that section's own (c).
// ============================================================================

pub relation collection_due_process_requested(p: Person, origin: CDPOrigin, a: Assessment, requested_on: Date) kind empirical {
    label en unofficial "the person requested, in writing and stating the grounds, a collection due process hearing — §6320(b)(1)/§6330(b)(1)";
}
relation cdp_request_window(p: Person, origin: CDPOrigin, a: Assessment, start: Date, end: Date) kind institutional {
    label en unofficial "the 30-day period during which a CDP hearing may be requested (computed by the origin-specific notice module: 03 for a lien-filing notice, this module's §6330(a) rule for a pre-levy notice)";
}

pub relation cdp_hearing_request_timely(p: Person, origin: CDPOrigin, a: Assessment) kind institutional {
    label en unofficial "the CDP hearing request fell within its 30-day window";
}
@source(IRC_S6330_A, relation = formalizes, coverage = partial, quote = "the right of the person to request a hearing during the 30-day period under paragraph (2)")
rule S6330RequestTimelyWithinWindow strict {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    for requested_on: Date;
    for start: Date;
    for end: Date;
    when collection_due_process_requested(p, origin, a, requested_on)
        and cdp_request_window(p, origin, a, start, end)
        and requested_on >= start and requested_on <= end;
    then cdp_hearing_request_timely(p, origin, a);
}

relation only_one_prior_cdp_hearing_this_period(p: Person, origin: CDPOrigin, a: Assessment) kind empirical {
    label en unofficial "the person already had a hearing under this section (or, for a levy hearing, under §6320) with respect to the taxable period the unpaid tax relates to — §6320(b)(2)/§6330(b)(2) one-hearing-per-period limit";
}
pub relation cdp_hearing_scheduled(p: Person, origin: CDPOrigin, a: Assessment) kind institutional {
    label en unofficial "a CDP hearing is scheduled to be held by the IRS Independent Office of Appeals";
}
@source(IRC_S6330_B, relation = formalizes, coverage = exact, quote = "If the person requests a hearing in writing under subsection (a)(3)(B) and states the grounds for the requested hearing, such hearing shall be held by the Internal Revenue Service Independent Office of Appeals.")
rule S6330bHearingScheduled defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    when cdp_hearing_request_timely(p, origin, a);
    then cdp_hearing_scheduled(p, origin, a);
    unless only_one_prior_cdp_hearing_this_period(p, origin, a) and cdp_hearing_request_timely(p, origin, a);
}

relation appeals_officer_independent_or_waived(p: Person, origin: CDPOrigin, a: Assessment) kind empirical {
    label en unofficial "the hearing was conducted by an officer with no prior involvement in the unpaid tax before the first §6320/§6330 hearing, or the taxpayer waived that requirement — §6320(b)(3)/§6330(b)(3)";
}
relation verification_obtained_from_secretary(p: Person, origin: CDPOrigin, a: Assessment) kind empirical {
    label en unofficial "the appeals officer obtained the Secretary's verification that applicable law/procedure requirements were met — §6330(c)(1)";
}
pub relation cdp_hearing_held(p: Person, origin: CDPOrigin, a: Assessment) kind institutional {
    label en unofficial "the CDP hearing was properly held: scheduled, before an independent (or waiver-excused) officer, with the Secretary's verification obtained";
}
@source(IRC_S6330_C, relation = formalizes, coverage = partial, quote = "The appeals officer shall at the hearing obtain verification from the Secretary that the requirements of any applicable law or administrative procedure have been met.")
rule S6330cHearingProperlyHeld defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    when cdp_hearing_scheduled(p, origin, a)
        and appeals_officer_independent_or_waived(p, origin, a)
        and verification_obtained_from_secretary(p, origin, a);
    then cdp_hearing_held(p, origin, a);
}

// §6330(c)(2): issues that may be raised at the hearing.
enum CDPHearingIssue {
    SpousalDefense;
    CollectionActionAppropriateness;
    CollectionAlternative;
    UnderlyingLiability;
}
relation cdp_issue_raised(p: Person, origin: CDPOrigin, a: Assessment, issue: CDPHearingIssue) kind empirical;
relation no_prior_opportunity_to_dispute_liability(p: Person, a: Assessment) kind empirical {
    label en unofficial "the person did not receive a statutory notice of deficiency for the liability and did not otherwise have an opportunity to dispute it — §6330(c)(2)(B)'s gate on raising the underlying liability";
}
pub relation cdp_issue_properly_raised(p: Person, origin: CDPOrigin, a: Assessment, issue: CDPHearingIssue) kind institutional {
    label en unofficial "the issue may properly be considered at the CDP hearing";
}
@source(IRC_S6330_C, relation = formalizes, coverage = partial, quote = "The person may raise at the hearing any relevant issue relating to the unpaid tax or the proposed levy, including")
rule S6330c2aOrdinaryIssueProperlyRaised defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    for issue: CDPHearingIssue;
    when cdp_hearing_held(p, origin, a)
        and cdp_issue_raised(p, origin, a, issue)
        and issue != UnderlyingLiability;
    then cdp_issue_properly_raised(p, origin, a, issue);
    unless issue_previously_considered_and_participated(p, origin, a, issue) and cdp_hearing_held(p, origin, a) and cdp_issue_raised(p, origin, a, issue) and issue != UnderlyingLiability;
}
relation issue_previously_considered_and_participated(p: Person, origin: CDPOrigin, a: Assessment, issue: CDPHearingIssue) kind empirical {
    label en unofficial "the issue was raised and considered at a prior §6320/§6330 hearing or other administrative/judicial proceeding in which the person meaningfully participated — §6330(c)(4)(A)";
}
@source(IRC_S6330_C, relation = formalizes, coverage = exact, quote = "The person may also raise at the hearing challenges to the existence or amount of the underlying tax liability for any tax period if the person did not receive any statutory notice of deficiency for such tax liability or did not otherwise have an opportunity to dispute such tax liability.")
rule S6330c2bUnderlyingLiabilityProperlyRaised defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    when cdp_hearing_held(p, origin, a)
        and cdp_issue_raised(p, origin, a, UnderlyingLiability)
        and no_prior_opportunity_to_dispute_liability(p, a);
    then cdp_issue_properly_raised(p, origin, a, UnderlyingLiability);
}

pub relation cdp_determination_made(p: Person, origin: CDPOrigin, a: Assessment, on: Date) kind institutional {
    label en unofficial "the Independent Office of Appeals made its §6330(c)(3) determination, considering the verification, the properly-raised issues, and the balance between efficient collection and intrusiveness";
}
@source(IRC_S6330_C, relation = formalizes, coverage = partial, quote = "The determination by an appeals officer under this subsection shall take into consideration")
rule S6330cDeterminationMade defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    for on: Date;
    when cdp_hearing_held(p, origin, a) and determination_issued_on(p, origin, a, on);
    then cdp_determination_made(p, origin, a, on);
}
relation determination_issued_on(p: Person, origin: CDPOrigin, a: Assessment, on: Date) kind empirical;

// §6330(d): Tax Court petition.
pub relation cdp_petition_filed(p: Person, origin: CDPOrigin, a: Assessment, on: Date) kind empirical;
relation debtor_prohibited_from_filing_by_title_11(p: Person, from: Date, until: Date) kind empirical {
    label en unofficial "the person is prohibited by a title 11 case from filing the §6330(d) petition during this period — §6330(d)(2)";
}
pub relation cdp_petition_window(p: Person, origin: CDPOrigin, a: Assessment, start: Date, end: Date) kind institutional {
    label en unofficial "the 30-day window (extended by any §6330(d)(2) title 11 suspension plus 30 days) to petition the Tax Court for review of the determination";
}
@source(IRC_S6330_D, relation = formalizes, coverage = exact, quote = "The person may, within 30 days of a determination under this section, petition the Tax Court for review of such determination (and the Tax Court shall have jurisdiction with respect to such matter).")
rule S6330dPetitionWindowOrdinary defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    for on: Date;
    for until: Date;
    when cdp_determination_made(p, origin, a, on);
    then cdp_petition_window(p, origin, a, on, add_calendar_period(on, 30 calendar_day));
    unless debtor_prohibited_from_filing_by_title_11(p, on, until) and cdp_determination_made(p, origin, a, on);
}
@source(IRC_S6330_D, relation = formalizes, coverage = exact, quote = "the running of the period prescribed by such subsection for filing such a petition with respect to such determination shall be suspended for the period during which the person is so prohibited from filing such a petition, and for 30 days thereafter")
rule S6330dPetitionWindowSuspendedByTitle11 defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    for on: Date;
    for until: Date;
    when cdp_determination_made(p, origin, a, on)
        and debtor_prohibited_from_filing_by_title_11(p, on, until);
    then cdp_petition_window(p, origin, a, on, add_calendar_period(until, 30 calendar_day));
}
pub relation cdp_petition_timely(p: Person, origin: CDPOrigin, a: Assessment) kind institutional;
@source(IRC_S6330_D, relation = formalizes, coverage = partial, quote = "The person may, within 30 days of a determination under this section, petition the Tax Court for review of such determination")
rule S6330dPetitionTimely defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    for on: Date;
    for start: Date;
    for end: Date;
    when cdp_petition_filed(p, origin, a, on)
        and cdp_petition_window(p, origin, a, start, end)
        and on >= start and on <= end;
    then cdp_petition_timely(p, origin, a);
}
// §6330(d)(3) (Appeals' retained jurisdiction over subsequent collection
// actions and later changed circumstances) is an institutional-standing
// fact about the forum, not a further computable condition for this
// pilot's scenarios — `non_normative` per coverage row.

// §6330(e): suspension of levy and of the §6502/§6531/§6532 periods.
pub relation levy_suspended(p: Person, a: Assessment) kind institutional {
    label en unofficial "levy actions which are the subject of a requested CDP hearing (and the running of the §6502/§6531/§6532 periods) are suspended while the hearing and any appeals are pending";
}
pub relation collection_period_suspended_by_cdp(p: Person, a: Assessment) kind institutional {
    label en unofficial "forward pub for the owner of §6502 (`assessment`, pending): the collection period is suspended for the same pendency as `levy_suspended`";
}
pub relation criminal_prosecution_period_suspended_by_cdp(p: Person, a: Assessment) kind institutional {
    label en unofficial "forward pub for the owner of §6531 (`judicial-proceedings`, pending)";
}
pub relation other_suit_period_suspended_by_cdp(p: Person, a: Assessment) kind institutional {
    label en unofficial "forward pub for the owner of §6532 (`judicial-proceedings`, pending)";
}
relation cdp_pendency_ended(p: Person, a: Assessment) kind empirical {
    label en unofficial "the CDP hearing (and any appeal from it) is no longer pending: the determination is final and either no Tax Court petition was timely filed or that petition has itself been finally decided — the point at which §6330(e)'s suspension stops";
}
relation good_cause_shown_not_to_suspend(p: Person, a: Assessment) kind empirical {
    label en unofficial "an appeal is pending, the underlying tax liability is not at issue in it, and the court determines the Secretary has shown good cause not to suspend the levy — §6330(e)(2)";
}

@source(IRC_S6330_E, relation = formalizes, coverage = exact, quote = "if a hearing is requested under subsection (a)(3)(B), the levy actions which are the subject of the requested hearing and the running of any period of limitations under section 6502 (relating to collection after assessment), section 6531 (relating to criminal prosecutions), or section 6532 (relating to other suits) shall be suspended for the period during which such hearing, and appeals therein, are pending")
rule S6330eLevySuspendedWhilePending defeasible {
    for p: Person;
    for a: Assessment;
    for requested_on: Date;
    when collection_due_process_requested(p, LevyNotice, a, requested_on);
    then levy_suspended(p, a);
    unless cdp_pendency_ended(p, a) and collection_due_process_requested(p, LevyNotice, a, requested_on);
    unless good_cause_shown_not_to_suspend(p, a) and collection_due_process_requested(p, LevyNotice, a, requested_on);
}

@source(IRC_S6330_E, relation = formalizes, coverage = exact, quote = "the running of any period of limitations under section 6502 (relating to collection after assessment)")
rule S6330eCollectionPeriodSuspendedWhilePending defeasible {
    for p: Person;
    for a: Assessment;
    for requested_on: Date;
    when collection_due_process_requested(p, LevyNotice, a, requested_on);
    then collection_period_suspended_by_cdp(p, a);
    unless cdp_pendency_ended(p, a) and collection_due_process_requested(p, LevyNotice, a, requested_on);
}

@source(IRC_S6330_E, relation = formalizes, coverage = exact, quote = "the running of any period of limitations under")
rule S6330eCriminalProsecutionPeriodSuspendedWhilePending defeasible {
    for p: Person;
    for a: Assessment;
    for requested_on: Date;
    when collection_due_process_requested(p, LevyNotice, a, requested_on);
    then criminal_prosecution_period_suspended_by_cdp(p, a);
    unless cdp_pendency_ended(p, a) and collection_due_process_requested(p, LevyNotice, a, requested_on);
}

@source(IRC_S6330_E, relation = formalizes, coverage = exact, quote = "the running of any period of limitations under")
rule S6330eOtherSuitPeriodSuspendedWhilePending defeasible {
    for p: Person;
    for a: Assessment;
    for requested_on: Date;
    when collection_due_process_requested(p, LevyNotice, a, requested_on);
    then other_suit_period_suspended_by_cdp(p, a);
    unless cdp_pendency_ended(p, a) and collection_due_process_requested(p, LevyNotice, a, requested_on);
}

// ============================================================================
// §6330(a) — Notice before levy; §6330(f)-(h) — exceptions and definitions
// ============================================================================

pub relation notice_of_intent_to_levy_given(p: Person, a: Assessment, on: Date, first_levy: Date) kind empirical {
    label en unofficial "the Secretary gave written notice of the right to a §6330 hearing, at least 30 days before the day of the first levy with respect to the unpaid tax for the taxable period";
}

enum S6330fExceptionKind {
    JeopardyLevy;
    StateTaxRefundLevy;
    DisqualifiedEmploymentTaxLevy;
    FederalContractorLevy;
}
relation s6330f_exception_applies(p: Person, a: Assessment, kind: S6330fExceptionKind) kind empirical;
relation disqualified_employment_tax_levy_condition(p: Person, a: Assessment) kind empirical {
    label en unofficial "the person (or a predecessor) requested a §6320/§6330 hearing on unpaid employment taxes (chapters 21-24) arising in the most recent 2-year period before the taxable period this levy is served for — §6330(h)(1)";
}
relation federal_contractor_levy_condition(p: Person, a: Assessment) kind empirical {
    label en unofficial "the person whose property is levied on (or a predecessor) is a Federal contractor — §6330(h)(2)";
}

pub relation pre_levy_hearing_notice_required(p: Person, a: Assessment) kind institutional {
    label en unofficial "§6330 requires notice and an opportunity for a hearing BEFORE the first levy — defeated by the §6330(f) exceptions, which instead require only a post-levy hearing within a reasonable time";
}
@source(IRC_S6330_A, relation = formalizes, coverage = exact, quote = "No levy may be made on any property or right to property of any person unless the Secretary has notified such person in writing of their right to a hearing under this section before such levy is made.")
rule S6330aPreLevyNoticeRequiredByDefault defeasible {
    for p: Person;
    for a: Assessment;
    for kind: S6330fExceptionKind;
    when assessment_of_person(a, p);
    then pre_levy_hearing_notice_required(p, a);
    unless s6330f_exception_applies(p, a, kind) and assessment_of_person(a, p);
}

pub relation post_levy_hearing_opportunity_required(p: Person, a: Assessment) kind institutional {
    label en unofficial "§6330(f): when a (f) exception applies, this section does not require a PRE-levy hearing, but the taxpayer must still be given the opportunity for the §6330 hearing within a reasonable period of time after the levy";
}
@source(IRC_S6330_F, relation = formalizes, coverage = exact, quote = "this section shall not apply, except that the taxpayer shall be given the opportunity for the hearing described in this section within a reasonable period of time after the levy")
rule S6330fPostLevyHearingRequired strict {
    for p: Person;
    for a: Assessment;
    for kind: S6330fExceptionKind;
    when s6330f_exception_applies(p, a, kind);
    then post_levy_hearing_opportunity_required(p, a);
}
@source(IRC_S6330_H, relation = formalizes, coverage = exact, quote = "A disqualified employment tax levy is any levy in connection with the collection of employment taxes for any taxable period if the person subject to the levy (or any predecessor thereof) requested a hearing under this section with respect to unpaid employment taxes arising in the most recent 2-year period before the beginning of the taxable period with respect to which the levy is served.")
rule S6330hDisqualifiedEmploymentTaxLevy strict {
    for p: Person;
    for a: Assessment;
    when disqualified_employment_tax_levy_condition(p, a);
    then s6330f_exception_applies(p, a, DisqualifiedEmploymentTaxLevy);
}
@source(IRC_S6330_H, relation = formalizes, coverage = exact, quote = "A Federal contractor levy is any levy if the person whose property is subject to the levy (or any predecessor thereof) is a Federal contractor.")
rule S6330hFederalContractorLevy strict {
    for p: Person;
    for a: Assessment;
    when federal_contractor_levy_condition(p, a);
    then s6330f_exception_applies(p, a, FederalContractorLevy);
}
@source(IRC_S6330_F, relation = formalizes, coverage = exact, quote = "the Secretary has made a finding under the last sentence of section 6331(a) that the collection of tax is in jeopardy")
rule S6330fJeopardyException strict {
    for p: Person;
    for a: Assessment;
    when jeopardy_finding(p) and assessment_of_person(a, p);
    then s6330f_exception_applies(p, a, JeopardyLevy);
}

// §6330(g): frivolous requests.
relation cdp_request_meets_frivolous_criteria(p: Person, origin: CDPOrigin, a: Assessment) kind empirical {
    label en unofficial "the Secretary determines the request (or a portion of it) meets the frivolous-position criteria of §6702(b)(2)(A)(i)/(ii)";
}
pub relation cdp_request_disregarded_as_frivolous(p: Person, origin: CDPOrigin, a: Assessment) kind institutional {
    label en unofficial "the Secretary may treat the frivolous portion of the request as never submitted, foreclosing further administrative or judicial review of it — §6330(g)";
}
@source(IRC_S6330_G, relation = formalizes, coverage = exact, quote = "if the Secretary determines that any portion of a request for a hearing under this section or section 6320 meets the requirement of clause (i) or (ii) of section 6702(b)(2)(A), then the Secretary may treat such portion as if it were never submitted and such portion shall not be subject to any further administrative or judicial review")
rule S6330gFrivolousRequestDisregarded defeasible {
    for p: Person;
    for origin: CDPOrigin;
    for a: Assessment;
    when cdp_request_meets_frivolous_criteria(p, origin, a);
    then cdp_request_disregarded_as_frivolous(p, origin, a);
}

// ============================================================================
// §6331 — Levy and distraint
// ============================================================================

relation notice_and_demand_made_on(p: Person, a: Assessment, on: Date) kind empirical;
relation levy_notice_given_at_least_30_days_before(p: Person, a: Assessment, on: Date) kind institutional {
    label en unofficial "the §6330 pre-levy notice (or its (f) post-levy substitute) requirement has been satisfied for a levy contemplated on this date — the (d) 30-day notice gate feeding the (a) power's validity";
}

pub relation levy_made(levy: Levy, p: Person, a: Assessment, on: Date) kind empirical {
    label en unofficial "the Secretary attempted to execute a levy — seizure and (where necessary) sale of the person's property or rights to property — on this date (the §6331(a) power's `exercise`)";
}

pub relation levy_permitted(p: Person, a: Assessment, on: Date) kind institutional {
    label en unofficial "as of this date, it would be lawful for the Secretary to levy on the person's non-exempt property (or property subject to the §6321 lien) to collect the unpaid tax — §6331(a)'s own condition, the single atom the §6331(a) power's `valid_when` reads (grounded by the power's own `exercise` date, not an ambient \"now\": v1's rule bodies do not read `context.legal_time`)";
}
@source(IRC_S6331_A, relation = formalizes, coverage = exact, quote = "If any person liable to pay any tax neglects or refuses to pay the same within 10 days after notice and demand, it shall be lawful for the Secretary to collect such tax (and such further sum as shall be sufficient to cover the expenses of the levy) by levy upon all property and rights to property (except such property as is exempt under section 6334) belonging to such person or on which there is a lien provided in this chapter for the payment of such tax.")
rule S6331aLevyPermittedAfter10Days defeasible {
    for p: Person;
    for a: Assessment;
    for demanded_on: Date;
    for on: Date;
    when notice_and_demand_made_on(p, a, demanded_on)
        and neglected_or_refused_to_pay(p, a)
        and add_calendar_period(demanded_on, 10 calendar_day) <= on
        and levy_notice_given_at_least_30_days_before(p, a, on);
    then levy_permitted(p, a, on);
    unless levy_suspended(p, a) and notice_and_demand_made_on(p, a, demanded_on) and neglected_or_refused_to_pay(p, a) and add_calendar_period(demanded_on, 10 calendar_day) <= on and levy_notice_given_at_least_30_days_before(p, a, on);
}

@source(IRC_S6331_A, relation = formalizes, coverage = exact, quote = "it shall be lawful for the Secretary to collect such tax")
rule S6331aExecuteLevyPower strict {
    for levy: Levy;
    for p: Person;
    for a: Assessment;
    for on: Date;
    when assessment_of_person(a, p) and levy_made(levy, p, a, on);
    then power ExecuteLevy {
        holder Secretary;
        exercise levy_made(levy, p, a, on);
        valid_when levy_permitted(p, a, on);
        effect levy_effective(levy, p, a);
    };
}
pub relation levy_effective(levy: Levy, p: Person, a: Assessment) kind institutional {
    label en unofficial "the §6331(a) power was validly exercised: the levy took legal effect (§6331(b) — extends to property possessed and obligations existing at the time, and authorizes seizure and sale)";
}
pub relation repeated_levy_permitted(p: Person, a: Assessment) kind institutional {
    label en unofficial "the first levy did not satisfy the claim, so the Secretary may proceed to levy again, as often as necessary, upon other property liable to levy — §6331(c)";
}
relation prior_levy_insufficient(p: Person, a: Assessment) kind empirical;
@source(IRC_S6331_C, relation = formalizes, coverage = exact, quote = "Whenever any property or right to property upon which levy has been made by virtue of subsection (a) is not sufficient to satisfy the claim of the United States for which levy is made, the Secretary may, thereafter, and as often as may be necessary, proceed to levy in like manner upon any other property liable to levy of the person against whom such claim exists, until the amount due from him, together with all expenses, is fully paid.")
rule S6331cRepeatedLevyPermitted defeasible {
    for p: Person;
    for a: Assessment;
    for on: Date;
    when levy_permitted(p, a, on) and prior_levy_insufficient(p, a);
    then repeated_levy_permitted(p, a);
}

pub relation levy_notice_of_intention_given(p: Person, a: Assessment, on: Date) kind empirical {
    label en unofficial "the Secretary notified the person in writing of the Secretary's intention to levy on salary, wages, or other property — §6331(d)(1)-(2)";
}
@source(IRC_S6331_D, relation = formalizes, coverage = exact, quote = "Levy may be made under subsection (a) upon the salary or wages or other property of any person with respect to any unpaid tax only after the Secretary has notified such person in writing of his intention to make such levy.")
relation levy_contemplated_on(p: Person, a: Assessment, on: Date) kind empirical {
    label en unofficial "case fact: the date a levy is being contemplated/checked as of (there is no ambient \"now\" in a rule body — v1's rule bodies do not read `context.legal_time`)";
}

rule S6331dNoticeSatisfiesGateAbsentJeopardy defeasible {
    for p: Person;
    for a: Assessment;
    for notice_on: Date;
    for on: Date;
    when levy_notice_of_intention_given(p, a, notice_on)
        and levy_contemplated_on(p, a, on)
        and days_between(notice_on, on) >= 30;
    then levy_notice_given_at_least_30_days_before(p, a, on);
    unless jeopardy_finding(p) and levy_notice_of_intention_given(p, a, notice_on) and levy_contemplated_on(p, a, on) and days_between(notice_on, on) >= 30;
}
@source(IRC_S6331_D, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to a levy if the Secretary has made a finding under the last sentence of subsection (a) that the collection of tax is in jeopardy.")
rule S6331dJeopardyWaivesNoticeGate strict {
    for p: Person;
    for a: Assessment;
    for on: Date;
    when jeopardy_finding(p) and assessment_of_person(a, p) and levy_contemplated_on(p, a, on);
    then levy_notice_given_at_least_30_days_before(p, a, on);
}

pub relation continuous_levy_on_wages(p: Person, a: Assessment, from: Date) kind institutional {
    label en unofficial "the effect of a levy on salary or wages is continuous from the date the levy is first made until it is released under §6343 — §6331(e)";
}
@source(IRC_S6331_E, relation = formalizes, coverage = exact, quote = "The effect of a levy on salary or wages payable to or received by a taxpayer shall be continuous from the date such levy is first made until such levy is released under section 6343.")
rule S6331eContinuousLevyOnWages strict {
    for levy: Levy;
    for p: Person;
    for a: Assessment;
    for on: Date;
    when levy_made(levy, p, a, on) and levy_is_on_wages_or_salary(levy);
    then continuous_levy_on_wages(p, a, on);
}
relation levy_is_on_wages_or_salary(levy: Levy) kind empirical;

pub relation levy_expenses_exceed_value_immunity(p: Person, a: Assessment) kind institutional {
    label en unofficial "no levy may be made on this property: the Secretary's estimated levy-and-sale expenses exceed the property's fair market value at the time of levy — §6331(f)";
}
relation estimated_levy_sale_expense_exceeds_fmv(p: Person, a: Assessment) kind empirical;
@source(IRC_S6331_F, relation = formalizes, coverage = exact, quote = "No levy may be made on any property if the amount of the expenses which the Secretary estimates (at the time of levy) would be incurred by the Secretary with respect to the levy and sale of such property exceeds the fair market value of such property at the time of levy.")
rule S6331fExpensesExceedValueImmunity strict {
    for p: Person;
    for a: Assessment;
    when estimated_levy_sale_expense_exceeds_fmv(p, a);
    then levy_expenses_exceed_value_immunity(p, a);
}

pub relation levy_barred_by_pending_summons_appearance(p: Person, a: Assessment, on: Date) kind institutional {
    label en unofficial "no levy may be made on this day: the person (or an officer/employee of the person) is required to appear that day in response to a Secretary's summons collecting an underpayment — §6331(g)(1)";
}
relation required_to_appear_on_summons(p: Person, a: Assessment, on: Date) kind empirical;
@source(IRC_S6331_G, relation = formalizes, coverage = exact, quote = "No levy may be made on the property of any person on any day on which such person (or officer or employee of such person) is required to appear in response to a summons issued by the Secretary for the purpose of collecting any underpayment of tax.")
rule S6331gSummonsAppearanceImmunity defeasible {
    for p: Person;
    for a: Assessment;
    for on: Date;
    when required_to_appear_on_summons(p, a, on);
    then levy_barred_by_pending_summons_appearance(p, a, on);
    unless jeopardy_finding(p) and required_to_appear_on_summons(p, a, on);
}

// §6331(h): continuing levy on specified Federal payments.
pub relation continuous_levy_on_specified_payment(p: Person, a: Assessment, from: Date, rate: Decimal) kind institutional {
    label en unofficial "a levy approved under §6331(h) on a specified Federal payment is continuous from the date first made until released, attaching to the stated percentage of each payment";
}
relation secretary_approves_h_levy(p: Person, a: Assessment, on: Date) kind empirical;
relation specified_payment_is_vendor_or_medicare(p: Person, a: Assessment) kind empirical {
    label en unofficial "the specified payment is due to a vendor of property/goods/services sold or leased to the Federal Government, or to a Medicare provider/supplier — §6331(h)(3), substituting 100% for 15%";
}
@source(IRC_S6331_H, relation = formalizes, coverage = partial, quote = "If the Secretary approves a levy under this subsection, the effect of such levy on specified payments to or received by a taxpayer shall be continuous from the date such levy is first made until such levy is released. Notwithstanding section 6334, such continuous levy shall attach to up to 15 percent of any specified payment due to the taxpayer.")
rule S6331hContinuousLevyOrdinaryRate defeasible {
    for p: Person;
    for a: Assessment;
    for on: Date;
    when secretary_approves_h_levy(p, a, on);
    then continuous_levy_on_specified_payment(p, a, on, 0.15);
    unless specified_payment_is_vendor_or_medicare(p, a) and secretary_approves_h_levy(p, a, on);
}
@source(IRC_S6331_H, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall be applied by substituting \"100 percent\" for \"15 percent\" in the case of any specified payment due to a vendor of property, goods, or services sold or leased to the Federal Government and by substituting \"100 percent\" for \"15 percent\" in the case of any specified payment due to a Medicare provider or supplier")
rule S6331hContinuousLevyVendorOrMedicareRate strict {
    for p: Person;
    for a: Assessment;
    for on: Date;
    when secretary_approves_h_levy(p, a, on) and specified_payment_is_vendor_or_medicare(p, a);
    then continuous_levy_on_specified_payment(p, a, on, 1.00);
}

// §6331(i): no levy during pendency of a divisible-tax refund suit.
pub relation levy_barred_by_pending_divisible_tax_suit(p: Person, a: Assessment) kind institutional {
    label en unofficial "no levy may be made on the unpaid divisible tax while the person's refund suit for a portion of it is pending, if the suit's decision would be res judicata or would collaterally estop the person — §6331(i)(1)";
}
relation divisible_tax_refund_suit_pending(p: Person, a: Assessment) kind empirical;
relation taxpayer_waived_i_restriction(p: Person, a: Assessment) kind empirical;
relation levy_is_offset_under_6402_or_predates_suit(p: Person, a: Assessment) kind empirical {
    label en unofficial "the levy carries out a §6402 offset, or was first made before the refund-suit proceeding commenced — §6331(i)(3)(B)'s carve-outs";
}
@source(IRC_S6331_I, relation = formalizes, coverage = partial, quote = "No levy may be made under subsection (a) on the property or rights to property of any person with respect to any unpaid divisible tax during the pendency of any proceeding brought by such person in a proper Federal trial court for the recovery of any portion of such divisible tax which was paid by such person if")
rule S6331iDivisibleTaxSuitImmunity defeasible {
    for p: Person;
    for a: Assessment;
    when divisible_tax_refund_suit_pending(p, a);
    then levy_barred_by_pending_divisible_tax_suit(p, a);
    unless taxpayer_waived_i_restriction(p, a) and divisible_tax_refund_suit_pending(p, a);
    unless jeopardy_finding(p) and divisible_tax_refund_suit_pending(p, a);
    unless levy_is_offset_under_6402_or_predates_suit(p, a) and divisible_tax_refund_suit_pending(p, a);
}
pub relation collection_period_suspended_by_divisible_tax_suit(p: Person, a: Assessment) kind institutional {
    label en unofficial "forward pub for the owner of §6502 (`assessment`, pending): the collection period is suspended while the Secretary is barred from levying under §6331(i) — §6331(i)(5)";
}
@source(IRC_S6331_I, relation = formalizes, coverage = exact, quote = "The period of limitations under section 6502 shall be suspended for the period during which the Secretary is prohibited under this subsection from making a levy.")
rule S6331iCollectionPeriodSuspended defeasible {
    for p: Person;
    for a: Assessment;
    when levy_barred_by_pending_divisible_tax_suit(p, a);
    then collection_period_suspended_by_divisible_tax_suit(p, a);
}

// §6331(j): no levy before investigation of the status of property to be
// sold under §6335.
pub relation levy_to_sell_requires_prior_investigation(p: Person, a: Assessment) kind institutional {
    label en unofficial "no levy may be made on property to be sold under §6335 until a thorough investigation of its status is complete — §6331(j)(1)";
}
relation investigation_of_property_status_completed(p: Person, a: Assessment) kind empirical {
    label en unofficial "the Secretary verified the taxpayer's liability, completed the §6331(f) expense/value analysis, determined the equity is sufficient to yield net proceeds, and thoroughly considered alternative collection methods — §6331(j)(2)(A)-(D)";
}
@source(IRC_S6331_J, relation = formalizes, coverage = exact, quote = "For purposes of applying the provisions of this subchapter, no levy may be made on any property or right to property which is to be sold under section 6335 until a thorough investigation of the status of such property has been completed.")
rule S6331jInvestigationRequiredBeforeSale defeasible {
    for p: Person;
    for a: Assessment;
    when assessment_of_person(a, p);
    then levy_to_sell_requires_prior_investigation(p, a);
    unless investigation_of_property_status_completed(p, a) and assessment_of_person(a, p);
}

// §6331(k): no levy while an offer-in-compromise or installment agreement
// is pending (or shortly after rejection/termination).
enum PendingCollectionAlternative {
    OfferInCompromise;
    InstallmentAgreement;
}
relation collection_alternative_pending(p: Person, a: Assessment, kind: PendingCollectionAlternative, since: Date) kind empirical;
relation collection_alternative_rejected_or_terminated_on(p: Person, a: Assessment, kind: PendingCollectionAlternative, on: Date) kind empirical;
relation appeal_of_rejection_or_termination_pending(p: Person, a: Assessment, kind: PendingCollectionAlternative) kind empirical;

pub relation levy_barred_by_pending_collection_alternative(p: Person, a: Assessment, kind: PendingCollectionAlternative) kind institutional {
    label en unofficial "no levy may be made while the offer-in-compromise or installment agreement is pending with the Secretary, during the 30 days after its rejection/termination, or while a timely appeal of the rejection/termination is pending — §6331(k)(1)-(2)";
}
@source(IRC_S6331_K, relation = formalizes, coverage = exact, quote = "during the period that an offer-in-compromise by such person under section 7122 of such unpaid tax is pending with the Secretary")
rule S6331kPendingAlternativeImmunity strict {
    for p: Person;
    for a: Assessment;
    for kind: PendingCollectionAlternative;
    for since: Date;
    when collection_alternative_pending(p, a, kind, since);
    then levy_barred_by_pending_collection_alternative(p, a, kind);
}
@source(IRC_S6331_K, relation = formalizes, coverage = exact, quote = "if such offer is rejected by the Secretary, during the 30 days thereafter (and, if an appeal of such rejection is filed within such 30 days, during the period that such appeal is pending)")
rule S6331kPostRejectionImmunity defeasible {
    for p: Person;
    for a: Assessment;
    for kind: PendingCollectionAlternative;
    for on: Date;
    for levy_on: Date;
    when collection_alternative_rejected_or_terminated_on(p, a, kind, on)
        and levy_contemplated_on(p, a, levy_on)
        and days_between(on, levy_on) <= 30;
    then levy_barred_by_pending_collection_alternative(p, a, kind);
}
@source(IRC_S6331_K, relation = formalizes, coverage = exact, quote = "if an appeal of such rejection is filed within such 30 days, during the period that such appeal is pending")
rule S6331kAppealOfRejectionImmunity strict {
    for p: Person;
    for a: Assessment;
    for kind: PendingCollectionAlternative;
    when appeal_of_rejection_or_termination_pending(p, a, kind);
    then levy_barred_by_pending_collection_alternative(p, a, kind);
}

// §6331(l): pure cross-references (jeopardy provisions, §6335 sale
// procedure, §6343 release) — non_normative.

// JUDGMENT CALL: `levy_permitted`/`levy_suspended` are plain institutional
// relations linked by the `unless` defeater in `S6331aLevyPermittedAfter10Days`
// (levy_permitted's own rule is defeated when levy_suspended holds), rather
// than a `power`/`immunity` pair joined by a `priority` declaration. A
// `priority` resolves a conflict between two NORM CONCLUSIONS (both sides
// must be a `power`/`duty`/`prohibition`/`immunity` block); `levy_suspended`
// here is the pub interface's own institutional-fact name (task assignment),
// not a separate `immunity` block, so `priority` does not apply to this
// pair — the `unless` defeater is the equivalent, and simpler, expression of
// "the request's suspension wins" for a defeasible-logic evaluator.
