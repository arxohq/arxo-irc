// §6321 (lien for taxes: arises upon assessment + demand + neglect/refusal
// — an institutional effect, not a power exercise), §6322 (period of the
// lien: from assessment until satisfied or unenforceable by lapse of time),
// §6323(a),(b)(1)-(10),(f),(g),(h) (validity and priority against certain
// persons — the subsections named by the owner's stage-1 anchor list;
// (c),(d),(e),(i),(j) stay `unreviewed`/"stage 2").
//
// JUDGMENT CALLS (see report):
//  - §6321's lien ARISES (an institutional_effect) independently of any
//    power exercise: neither the Secretary nor the taxpayer "does" anything
//    to bring it about beyond the pre-existing facts (liability, demand,
//    neglect/refusal). Modelled as a plain institutional relation
//    (`lien_arises`), per PLAN §6.2's "liability arises" state, not a power.
//  - §6322's termination branch ("becomes unenforceable by reason of lapse
//    of time") is §6502's own 10-year computation — chapter 66, owner
//    `assessment`, EXTERNAL_DEPENDENCY (typed institutional dependency
//    contract `collection_period_ends`, `coverage/collection.deps.json`,
//    status pending). The satisfaction branch is fully executable here.
//  - §6323(b)'s ten superpriority categories are represented as ONE shared
//    relation `superpriority_protected(claimant, lien, category)` with ten
//    independent defining rules (one per `SuperpriorityCategory` value),
//    referenced by a SINGLE `unless` in the general-validity rule — not ten
//    separate `unless` clauses — because the defeater's own category
//    argument already selects which paragraph applies; this avoids
//    restating the head's five bound variables ten times over.
//  - Several of (b)'s ten paragraphs bundle multiple elements (actual
//    notice/knowledge state, possession, a dollar cap, local-law priority)
//    into ONE empirical fact per category (e.g.
//    `casual_sale_purchase_protected`) rather than decomposing every
//    element into its own relation — the elements are conjunctive
//    case-level facts a user asserts together, and decomposing them further
//    would not change which scenarios are distinguishable at this stage.
//    Recorded as `partial` coverage per paragraph.
//  - §6323(h) definitions are NOT declared as free-standing general tests;
//    the operative parts of "security interest", "purchaser", and
//    "mechanic's lienor" are folded into the per-category `(b)` predicates
//    above (a `security_no_actual_notice` fact already presupposes a
//    security interest under (h)(1)). Three definitions with independent
//    downstream use are declared on their own: `tax_lien_filing` (h)(5,
//    literally `lien_notice_filed_on`), `purchaser_for_adequate_consideration`
//    (h)(6), and `security_interest_exists` (h)(1) (used by (b)(1) and future
//    (c)/(d) stage-2 work).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    Assessment,
    IRC_S6321,
    IRC_S6322,
    IRC_S6323_A,
    IRC_S6323_B,
    IRC_S6323_F,
    IRC_S6323_G,
    IRC_S6323_H,
    Lien,
    Person,
    SuperpriorityCategory,
    assessment_of_person,
};

// ============================================================================
// §6321 — Lien for taxes
// ============================================================================

pub relation neglected_or_refused_to_pay(p: Person, a: Assessment) kind empirical {
    label en unofficial "the person liable to pay the assessed tax neglected or refused to pay it after demand (§6303)";
}

pub relation lien_arises(lien: Lien, p: Person, a: Assessment) kind institutional {
    label en unofficial "a lien in favor of the United States, upon all property and rights to property (real or personal) belonging to the person, arises for the unpaid amount (tax plus accrued interest, additions, and assessable penalties) — §6321";
}
relation lien_identity(lien: Lien, p: Person, a: Assessment) kind empirical {
    label en unofficial "case-supplied identity: this Lien instance is the one securing this person's liability under this assessment (a lien has no document of its own to reference before it arises, so — like other entities in this corpus, per AGENT-BRIEF's `entity_ref` convention — the case names it directly)";
}

@source(IRC_S6321, relation = formalizes, coverage = exact, quote = "If any person liable to pay any tax neglects or refuses to pay the same after demand, the amount (including any interest, additional amount, addition to tax, or assessable penalty, together with any costs that may accrue in addition thereto) shall be a lien in favor of the United States upon all property and rights to property, whether real or personal, belonging to such person.")
rule S6321LienArisesUponNeglectOrRefusal strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    when lien_identity(lien, p, a) and assessment_of_person(a, p) and neglected_or_refused_to_pay(p, a);
    then lien_arises(lien, p, a);
}

// ============================================================================
// §6322 — Period of the lien
// ============================================================================

pub relation lien_arising_date(lien: Lien, on: Date) kind institutional {
    label en unofficial "the lien arises, for purposes of its duration, at the time the underlying assessment was made — not at the later date neglect/refusal was established (§6322)";
}
pub relation liability_satisfied_on(p: Person, a: Assessment, on: Date) kind empirical {
    label en unofficial "the liability for the assessed amount (or a judgment against the taxpayer arising out of it) was satisfied on this date";
}
// WIRE-2 (25.09.2026): `us.irc.assessment::collection_period_ends(a, d)`
// (§6502(a)'s general 10-year rule) is now `pub` — imported directly below
// rather than redeclared as a local stub. Its own module documents that it
// covers ONLY §6502(a)'s general rule, not the (a)(1)-(2) extensions or the
// indefinite-window final sentence (TECH_GAP there, not here).

@source(IRC_S6322, relation = formalizes, coverage = exact, quote = "Unless another date is specifically fixed by law, the lien imposed by section 6321 shall arise at the time the assessment is made")
rule S6322LienArisingDateIsAssessmentDate strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for d: Date;
    when lien_arises(lien, p, a) and us.irc.core::assessed_on(a, d);
    then lien_arising_date(lien, d);
}

pub relation lien_in_effect(lien: Lien, on: Date) kind institutional {
    label en unofficial "the lien continues in effect on this date — §6322: from the arising date until the liability is satisfied or becomes unenforceable by lapse of time";
}

@source(IRC_S6322, relation = formalizes, coverage = partial, quote = "shall continue until the liability for the amount so assessed (or a judgment against the taxpayer arising out of such liability) is satisfied")
relation lien_effect_checked_on(lien: Lien, on: Date) kind empirical {
    label en unofficial "case fact: the date `lien_in_effect` is being checked as of (there is no ambient \"now\" in a rule body — see package.law's judgment calls)";
}

rule S6322LienInEffectUntilSatisfied defeasible {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for arose: Date;
    for on: Date;
    for satisfied: Date;
    for periodEnd: Date;
    when lien_arising_date(lien, arose) and assessment_of_person(a, p) and lien_effect_checked_on(lien, on) and on >= arose;
    then lien_in_effect(lien, on);
    unless liability_satisfied_on(p, a, satisfied) and lien_arising_date(lien, arose) and assessment_of_person(a, p) and lien_effect_checked_on(lien, on) and on >= arose and on >= satisfied;
    unless us.irc.assessment::collection_period_ends(a, periodEnd) and lien_arising_date(lien, arose) and assessment_of_person(a, p) and lien_effect_checked_on(lien, on) and on >= arose and on >= periodEnd;
}

// The §6502 lapse-of-time termination branch above (WIRE-2, 25.09.2026)
// covers ONLY the general 10-year rule (`us.irc.assessment`'s own module
// header): a case relying on the (a)(1)-(2) extensions or the indefinite-
// window final sentence still needs those TECH_GAP rows closed first.

// ============================================================================
// §6323(a) — General rule: invalid until notice filed
// ============================================================================

enum ClaimantCategory {
    Purchaser;
    SecurityInterestHolder;
    MechanicsLienor;
    JudgmentLienCreditor;
}

pub relation lien_notice_filed_on(lien: Lien, on: Date) kind empirical {
    label en unofficial "notice of the §6321 lien, meeting the §6323(f) filing requirements, was filed by the Secretary on this date";
}
relation claimant_category(claimant: Person, lien: Lien, category: ClaimantCategory) kind empirical;
relation claimant_interest_arose_on(claimant: Person, lien: Lien, on: Date) kind empirical {
    label en unofficial "the claimant became a purchaser, or the claimant's security interest/mechanic's lien/judgment lien came into existence, on this date";
}

pub relation superpriority_protected(claimant: Person, lien: Lien, category: SuperpriorityCategory) kind institutional {
    label en unofficial "the claimant falls within one of §6323(b)'s ten categories under which the federal tax lien, even though notice was filed, is not valid against the claimant";
}

pub relation lien_priority_over(lien: Lien, claimant: Person) kind institutional {
    label en unofficial "the federal tax lien has priority over (is valid as against) this claimant — §6323(a), subject to the §6323(b) superpriority exceptions";
}

@source(IRC_S6323_A, relation = formalizes, coverage = exact, quote = "The lien imposed by section 6321 shall not be valid as against any purchaser, holder of a security interest, mechanic's lienor, or judgment lien creditor until notice thereof which meets the requirements of subsection (f) has been filed by the Secretary.")
rule S6323aLienValidAgainstNamedClaimantsAfterFiling defeasible {
    for lien: Lien;
    for claimant: Person;
    for category: ClaimantCategory;
    for filed_on: Date;
    for arose_on: Date;
    for spcategory: SuperpriorityCategory;
    when lien_notice_filed_on(lien, filed_on)
        and claimant_category(claimant, lien, category)
        and claimant_interest_arose_on(claimant, lien, arose_on)
        and arose_on >= filed_on;
    then lien_priority_over(lien, claimant);
    unless superpriority_protected(claimant, lien, spcategory)
        and claimant_category(claimant, lien, category)
        and lien_notice_filed_on(lien, filed_on)
        and claimant_interest_arose_on(claimant, lien, arose_on)
        and arose_on >= filed_on;
}

// ============================================================================
// §6323(b) — The ten superpriority categories
// ============================================================================

relation security_no_actual_notice(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant purchased a security, or acquired a security interest in one, without actual notice or knowledge of the lien at the relevant time — §6323(b)(1)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "as against a purchaser of such security who at the time of purchase did not have actual notice or knowledge of the existence of such lien; and")
rule S6323b1SecuritiesSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when security_no_actual_notice(claimant, lien);
    then superpriority_protected(claimant, lien, SecuritiesPurchaserOrHolder);
}

relation motor_vehicle_purchaser_protected(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant purchased a motor vehicle without actual notice or knowledge of the lien and, before obtaining such notice or knowledge, acquired possession and did not thereafter relinquish it to the seller or the seller's agent — §6323(b)(2)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "at the time of the purchase such purchaser did not have actual notice or knowledge of the existence of such lien, and")
rule S6323b2MotorVehicleSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when motor_vehicle_purchaser_protected(claimant, lien);
    then superpriority_protected(claimant, lien, MotorVehiclePurchaser);
}

relation retail_purchase_ordinary_course(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant purchased tangible personal property at retail, in the ordinary course of the seller's trade or business — §6323(b)(3)";
}
relation retail_purchase_intent_to_hinder_collection(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the purchaser intended the purchase to (or knew it would) hinder, evade, or defeat the collection of a tax under this title — §6323(b)(3)'s own carve-out";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "as against a purchaser in the ordinary course of the seller's trade or business, unless at the time of such purchase such purchaser intends such purchase to (or knows such purchase will) hinder, evade, or defeat the collection of any tax under this title")
rule S6323b3RetailPurchaseSuperpriority defeasible {
    for claimant: Person;
    for lien: Lien;
    when retail_purchase_ordinary_course(claimant, lien);
    then superpriority_protected(claimant, lien, RetailPurchaser);
    unless retail_purchase_intent_to_hinder_collection(claimant, lien) and retail_purchase_ordinary_course(claimant, lien);
}

relation casual_sale_purchase_protected(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant purchased household goods, personal effects, or other §6334(a)-described tangible personal property, not for resale, in a casual sale for less than $1,000, without actual notice or knowledge of the lien or that the sale is one of a series of sales — §6323(b)(4)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "purchased (not for resale) in a casual sale for less than $1,000, as against the purchaser, but only if such purchaser does not have actual notice or knowledge (A) of the existence of such lien, or (B) that this sale is one of a series of sales")
rule S6323b4CasualSaleSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when casual_sale_purchase_protected(claimant, lien);
    then superpriority_protected(claimant, lien, CasualSalePurchaserUnder1000);
}

relation repair_lien_continuous_possession(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant holds a local-law lien on tangible personal property securing the reasonable price of its repair or improvement, and has been continuously in possession of the property since the lien arose — §6323(b)(5)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "as against a holder of such a lien, if such holder is, and has been, continuously in possession of such property from the time such lien arose")
rule S6323b5RepairOrImprovementLienSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when repair_lien_continuous_possession(claimant, lien);
    then superpriority_protected(claimant, lien, PossessoryRepairOrImprovementLienHolder);
}

relation real_property_tax_lien_local_priority(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant holds a local-law real property lien entitled to priority under local law over prior security interests, securing a general property tax, a special assessment for a public improvement, or utility/public-service charges — §6323(b)(6)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "if such lien is entitled under local law to priority over security interests in such property which are prior in time, and such lien secures payment of")
rule S6323b6RealPropertyTaxLienSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when real_property_tax_lien_local_priority(claimant, lien);
    then superpriority_protected(claimant, lien, RealPropertyTaxOrSpecialAssessmentLien);
}

relation residential_repair_mechanics_lien_under_5000(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant is a mechanic's lienor on real property, for repair or improvement of a personal residence of not more than four dwelling units occupied by its owner, with a contract price of not more than $5,000 — §6323(b)(7)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "as against a mechanic's lienor, but only if the contract price on the contract with the owner is not more than $5,000")
rule S6323b7ResidentialRepairMechanicsLienSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when residential_repair_mechanics_lien_under_5000(claimant, lien);
    then superpriority_protected(claimant, lien, ResidentialRepairMechanicsLienor);
}

relation attorneys_lien_reasonable_compensation(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant is an attorney holding a local-law lien on, or an enforceable contract right against, a judgment or settlement amount, to the extent of reasonable compensation for obtaining it — §6323(b)(8)";
}
relation judgment_against_united_states_offset(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the judgment or settlement amount is against the United States, to the extent the United States sets off its claim against the amount — §6323(b)(8)'s own carve-out";
}
@source(IRC_S6323_B, relation = formalizes, coverage = partial, quote = "as against an attorney who, under local law, holds a lien upon or a contract enforcible against such judgment or amount, to the extent of his reasonable compensation for obtaining such judgment or procuring such settlement")
rule S6323b8AttorneysLienSuperpriority defeasible {
    for claimant: Person;
    for lien: Lien;
    when attorneys_lien_reasonable_compensation(claimant, lien);
    then superpriority_protected(claimant, lien, AttorneysLienOnJudgmentOrSettlement);
    unless judgment_against_united_states_offset(claimant, lien) and attorneys_lien_reasonable_compensation(claimant, lien);
}

relation insurer_no_notice_or_protected_advance(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant is the insurer under a life, endowment, or annuity contract, acting before actual notice or knowledge of the lien, or making an automatic advance required to maintain the contract under a pre-notice agreement, or after satisfaction of a §6332(b) levy without a fresh post-satisfaction notice — §6323(b)(9)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = partial, quote = "as against the organization which is the insurer under such contract, at any time")
rule S6323b9InsurerSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when insurer_no_notice_or_protected_advance(claimant, lien);
    then superpriority_protected(claimant, lien, InsurerUnderLifeOrAnnuityContract);
}

relation savings_institution_loan_no_notice(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "the claimant is a §581/§591 institution that made a loan, secured by a savings deposit, share, or other account, without actual notice or knowledge of the lien — §6323(b)(10)";
}
@source(IRC_S6323_B, relation = formalizes, coverage = exact, quote = "to the extent of any loan made by such institution without actual notice or knowledge of the existence of such lien, as against such institution, if such loan is secured by such account")
rule S6323b10SavingsInstitutionSuperpriority strict {
    for claimant: Person;
    for lien: Lien;
    when savings_institution_loan_no_notice(claimant, lien);
    then superpriority_protected(claimant, lien, SavingsInstitutionLoanOnAccount);
}

// ============================================================================
// §6323(f) — Place for filing notice
// ============================================================================

pub relation notice_of_lien_filing_office_proper(lien: Lien) kind institutional {
    label en unofficial "the notice of lien was filed in the office §6323(f) designates for the property's kind and location";
}
relation filing_office_matches_state_designation(lien: Lien) kind empirical {
    label en unofficial "the notice was filed in the one office the State (or county/subdivision) has designated by law for the property's kind and location — §6323(f)(1)(A)";
}
relation filing_office_is_federal_district_court_fallback(lien: Lien) kind empirical {
    label en unofficial "the State has not designated a qualifying office, and the notice was filed with the clerk of the U.S. district court for the district where the property is situated — §6323(f)(1)(B)";
}
relation filing_office_is_dc_recorder(lien: Lien) kind empirical {
    label en unofficial "the property is situated in the District of Columbia and the notice was filed with the Recorder of Deeds of the District of Columbia — §6323(f)(1)(C)";
}
@source(IRC_S6323_F, relation = formalizes, coverage = partial, quote = "In the case of real property, in one office within the State (or the county, or other governmental subdivision), as designated by the laws of such State, in which the property subject to the lien is situated")
rule S6323fFilingOfficeByStateDesignation strict {
    for lien: Lien;
    when filing_office_matches_state_designation(lien);
    then notice_of_lien_filing_office_proper(lien);
}
@source(IRC_S6323_F, relation = formalizes, coverage = exact, quote = "In the office of the clerk of the United States district court for the judicial district in which the property subject to the lien is situated, whenever the State has not by law designated one office which meets the requirements of subparagraph (A)")
rule S6323fFilingOfficeFederalFallback strict {
    for lien: Lien;
    when filing_office_is_federal_district_court_fallback(lien);
    then notice_of_lien_filing_office_proper(lien);
}
@source(IRC_S6323_F, relation = formalizes, coverage = exact, quote = "In the office of the Recorder of Deeds of the District of Columbia, if the property subject to the lien is situated in the District of Columbia.")
rule S6323fFilingOfficeDCRecorder strict {
    for lien: Lien;
    when filing_office_is_dc_recorder(lien);
    then notice_of_lien_filing_office_proper(lien);
}
// §6323(f)(2)-(3),(5) (situs rules, form/content of notice, exclusivity of
// this title's filing system) and (f)(4) (the real-property double-indexing
// requirement some States impose) are NOT modelled beyond the office choice
// above: they refine WHERE/HOW filing is proper without adding a further
// branch this stage's scenarios need — recorded `partial`/`non_normative`
// per row in coverage/collection.json.

// ============================================================================
// §6323(g) — Refiling
// ============================================================================

pub relation required_refiling_window(lien: Lien, start: Date, end: Date) kind institutional {
    label en unofficial "the one-year required refiling period under §6323(g)(3)(A): ending 30 days after the expiration of 10 years after the date of assessment, beginning one year before that end date";
}
@source(IRC_S6323_G, relation = formalizes, coverage = exact, quote = "the one-year period ending 30 days after the expiration of 10 years after the date of the assessment of the tax")
rule S6323g3RequiredRefilingWindow strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for assessed: Date;
    when lien_identity(lien, p, a)
        and assessment_of_person(a, p)
        and us.irc.core::assessed_on(a, assessed);
    then required_refiling_window(lien, add_calendar_period(add_calendar_period(assessed, 9 calendar_year), 30 calendar_day), add_calendar_period(add_calendar_period(assessed, 10 calendar_year), 30 calendar_day));
}

pub relation notice_of_lien_refiled_on(lien: Lien, on: Date) kind empirical;
pub relation notice_of_lien_refiling_timely(lien: Lien) kind institutional {
    label en unofficial "the notice of lien was refiled within its required refiling period, so it keeps the original filing's priority date — §6323(g)(1)-(2)";
}
@source(IRC_S6323_G, relation = formalizes, coverage = partial, quote = "Unless notice of lien is refiled in the manner prescribed in paragraph (2) during the required refiling period, such notice of lien shall be treated as filed on the date on which it is filed (in accordance with subsection (f)) after the expiration of such refiling period.")
rule S6323gRefiledWithinWindowIsTimely strict {
    for lien: Lien;
    for on: Date;
    for start: Date;
    for end: Date;
    when notice_of_lien_refiled_on(lien, on)
        and required_refiling_window(lien, start, end)
        and on >= start and on <= end;
    then notice_of_lien_refiling_timely(lien);
}
// §6323(g)(2)(A)(ii)/(B) (same-office refiling, real-property re-indexing,
// and the residence-change notice carve-out) and (g)(4) (the pre-1962
// transition rule, spent since 1967) are NOT modelled — `non_normative`
// (spent) for (g)(4), `partial`/note for the (g)(2) mechanics.

// ============================================================================
// §6323(h) — Definitions with independent downstream use
// ============================================================================

pub relation tax_lien_filing(lien: Lien, on: Date) kind institutional {
    label en unofficial "\"tax lien filing\" (§6323(h)(5)): the filing of the §6323(a) notice of the §6321 lien";
}
@source(IRC_S6323_H, relation = formalizes, coverage = exact, quote = "The term \"tax lien filing\" means the filing of notice (referred to in subsection (a)) of the lien imposed by section 6321.")
rule S6323h5TaxLienFilingDefinition strict {
    for lien: Lien;
    for on: Date;
    when lien_notice_filed_on(lien, on);
    then tax_lien_filing(lien, on);
}

relation acquired_interest_for_adequate_consideration(claimant: Person, valid_against_subsequent_purchasers: Boolean) kind empirical;
pub relation purchaser_for_adequate_consideration(claimant: Person) kind institutional {
    label en unofficial "\"purchaser\" (§6323(h)(6)): one who, for adequate and full consideration in money or money's worth, acquires an interest (other than a lien or security interest) valid under local law against subsequent purchasers without actual notice";
}
@source(IRC_S6323_H, relation = formalizes, coverage = exact, quote = "The term \"purchaser\" means a person who, for adequate and full consideration in money or money's worth, acquires an interest (other than a lien or security interest) in property which is valid under local law against subsequent purchasers without actual notice.")
rule S6323h6PurchaserDefinition strict {
    for claimant: Person;
    when acquired_interest_for_adequate_consideration(claimant, true);
    then purchaser_for_adequate_consideration(claimant);
}

relation security_interest_protected_under_local_law(claimant: Person, value_parted: Boolean) kind empirical;
pub relation security_interest_exists(claimant: Person) kind institutional {
    label en unofficial "\"security interest\" exists (§6323(h)(1)): the interest is protected under local law against a subsequent judgment lien arising out of an unsecured obligation, and the holder has parted with money or money's worth";
}
@source(IRC_S6323_H, relation = formalizes, coverage = partial, quote = "A security interest exists at any time (A) if, at such time, the property is in existence and the interest has become protected under local law against a subsequent judgment lien arising out of an unsecured obligation, and (B) to the extent that, at such time, the holder has parted with money or money's worth")
rule S6323h1SecurityInterestExistsDefinition strict {
    for claimant: Person;
    when security_interest_protected_under_local_law(claimant, true);
    then security_interest_exists(claimant);
}
// §6323(h)(2)-(4) (mechanic's lienor, motor vehicle, security) are folded
// into their respective (b) predicates above rather than declared as
// free-standing tests (see header judgment call).
