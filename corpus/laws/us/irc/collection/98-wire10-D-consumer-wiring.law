// Collection -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 6334(d): the exempt amount of wages, salary and other income for an individual paid weekly. It reads the standard deduction, the
// aggregate personal-exemption deduction, the section 151(d) exemption amount and the number of dependents from `us.irc.gross_income`, and, for
// taxable years in which the exemption amount is zero, the $4,150 dependent amount indexed by `us.irc.income_individual` (2017 substituted for 2016).
//
// JUDGMENT CALLS
//  - The division by 52 is rounded to cents HALF_UP; the statute names no rounding.
//  - The verified-statement default (a married individual filing a separate return with one exemption, or with no dependents) is not modelled:
//    the case supplies the filing status the levy is computed for, as it does to the owner.
//  - Paragraph (3) (individuals not paid weekly) is regulation-delegated and stays outside the model.
//  - The levy year is the taxable year in which the levy occurs, named by the case.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

import us.irc.gross_income version "0.1.1";
import us.irc.income_individual version "0.1.1";

use self::{
    IRC_S6334_D,
    Individual,
    Person,
    TaxableYear,
    wages_or_income_within_minimum_exempt_amount,
};

pub relation weekly_exempt_amount_6334d(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the exempt amount of wages, salary and other income for a week (section 6334(d)(2), (4))";
}

@source(IRC_S6334_D, relation = formalizes, coverage = exact, quote = "(A) the sum of—")
rule W10D6334d2WeeklyExemptAmount strict {
    label en official "section 6334(d)(2): the standard deduction plus the personal-exemption deductions allowed under section 151, divided by 52 (years in which the exemption amount is not zero)";
    for p: Individual;
    for y: TaxableYear;
    for sd: Money;
    for pe: Money;
    for ex: Money;
    when us.irc.gross_income::standard_deduction(p, y, sd);
    when us.irc.gross_income::personal_exemption_deduction_151(p, y, pe);
    when us.irc.gross_income::exemption_amount_for(p, y, ex);
    when ex > 0.00 USD;
    then weekly_exempt_amount_6334d(p, y, div_round(sd + pe, 52.0, 2, "HALF_UP"));
}

pub relation dependent_amount_6334d4B(y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount determined under section 6334(d)(4)(B): $4,150 (increased after 2018 by the cost-of-living adjustment with 2017 substituted for 2016, the increase rounded down to a multiple of $100)";
}
@source(IRC_S6334_D, relation = formalizes, coverage = exact, quote = "(B) Amount determined")
rule W10D6334d4BStatutoryAmountThrough2018(y: TaxableYear, cy: Integer) strict {
    label en official "section 6334(d)(4)(B): $4,150 per dependent through calendar year 2018";
    when us.irc.core::calendar_year_of(y, cy);
    when cy <= 2018;
    then dependent_amount_6334d4B(y, 4150.00 USD);
}
@source(IRC_S6334_D, relation = formalizes, coverage = exact, quote = "In the case of any taxable year beginning in a calendar year after 2018, the $4,150 amount in subparagraph (B) shall be increased by an amount equal to—")
rule W10D6334d4CRequestIndexing(y: TaxableYear, cy: Integer) strict {
    label en official "section 6334(d)(4)(C): the $4,150 is indexed with 2017 substituted for 2016 and the increase rounded down to a multiple of $100";
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    then us.irc.income_individual::amount_to_index(4150.00 USD, 2017, y, 100);
}
rule W10D6334d4CIndexedAmount(y: TaxableYear, cy: Integer, adjusted: Money) strict {
    label en official "section 6334(d)(4)(C): the indexed dependent amount";
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    when us.irc.income_individual::cola_adjusted_amount(4150.00 USD, 2017, y, 100, adjusted);
    then dependent_amount_6334d4B(y, adjusted);
}
@source(IRC_S6334_D, relation = formalizes, coverage = exact, quote = "In the case of any taxable year in which the exemption amount under section 151(d) is zero, paragraph (2) shall not apply")
rule W10D6334d4WeeklyExemptAmountWhenExemptionZero strict {
    label en official "section 6334(d)(4): when the exemption amount is zero, (the dependent amount times the number of dependents plus the standard deduction) divided by 52";
    for p: Individual;
    for y: TaxableYear;
    for sd: Money;
    for n: Integer;
    for a: Money;
    when us.irc.gross_income::exemption_amount_for(p, y, 0.00 USD);
    when us.irc.gross_income::standard_deduction(p, y, sd);
    when us.irc.gross_income::number_of_dependents(p, y, n);
    when dependent_amount_6334d4B(y, a);
    then weekly_exempt_amount_6334d(p, y, div_round(sd + a * n, 52.0, 2, "HALF_UP"));
}

// --- section 6334(a)(9): the weekly income within the exempt amount ------------------------------------------------------------

pub relation weekly_income_in_levy_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the wages, salary and other income payable to or received by the individual during the week, in the taxable year in which the levy occurs (all paid on a weekly basis, section 6334(d)(1))";
}
@source(IRC_S6334_D, relation = formalizes, coverage = partial, quote = "the amount of the wages, salary, and other income payable to or received by him during any week which is exempt from levy under subsection (a)(9) shall be the exempt amount.")
rule W10D6334a9WeeklyIncomeWithinExemptAmount strict {
    label en official "section 6334(a)(9), (d)(1): weekly income not above the exempt amount is within the minimum exempt amount";
    for p: Individual;
    for y: TaxableYear;
    for income: Money;
    for exempt: Money;
    when weekly_income_in_levy_year(p, y, income);
    when weekly_exempt_amount_6334d(p, y, exempt);
    when income <= exempt;
    then wages_or_income_within_minimum_exempt_amount(p);
}
