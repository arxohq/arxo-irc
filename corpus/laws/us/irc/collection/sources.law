// 26 U.S.C. §6325 — statutory note 4 (effectivedate-amendment-note)
fragment IRC_S6325_NOTE_4 in IRC_2024_EDITION {
    kind note;
    locator "section/6325/note/4";
    text en official """Effective Date of 1998 Amendment
Pub. L. 105–206, title III, §3106(c), July 22, 1998, 112 Stat. 734, provided that: "The amendments made by this section [amending this section and sections 6503 and 7426 of this title] shall take effect on the date of the enactment of this Act [July 22, 1998]."
Effective Date of 1982 Amendment
Pub. L. 97–248, title III, §348(b), Sept. 3, 1982, 96 Stat. 638, provided that: "The amendment made by subsection (a) [amending this section] shall apply with respect to liens—
"(1) which are filed after December 31, 1982,
"(2) which are satisfied after December 31, 1982, or
"(3) with respect to which the taxpayer after December 31, 1982, requests the Secretary of the Treasury or his delegate to issue a certificate of release on the grounds that the liability was satisfied or legally unenforceable."
Effective Date of 1978 Amendment
Pub. L. 95–600, title V, §513(b), Nov. 6, 1978, 92 Stat. 2883, provided that: "The amendments made by subsection (a) [amending this section] shall apply with respect to the estates of decedents dying after December 31, 1976."
Effective Date of 1966 Amendment
Amendment by Pub. L. 89–719 applicable after Nov. 2, 1966, regardless of when title or lien of United States arose or when lien or interest of another person was acquired, with certain exceptions, see section 114(a)–(c) of Pub. L. 89–719, set out as a note under section 6323 of this title.
Effective Date of 1958 Amendment
Amendment by Pub. L. 85–866 effective Aug. 17, 1954, see section 1(c)(2) of Pub. L. 85–866, set out as a note under section 165 of this title.""";
    content_hash "sha256:4ed933a38b6885a37aef285fe8c12a9b07779291e422c6edfd7304dea780227d";
}

// 26 U.S.C. 6326(a) — Administrative appeal of liens
fragment IRC_S6326_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/6326/a";
    text en official """(a) In general
In such form and at such time as the Secretary shall prescribe by regulations, any person shall be allowed to appeal to the Secretary after the filing of a notice of a lien under this subchapter on the property or the rights to property of such person for a release of such lien alleging an error in the filing of the notice of such lien.""";
    content_hash "sha256:1a38e732d25a377a2de0180785547a5bb781a5c11dcd219a8ed8a1af833ab48c";
}

// 26 U.S.C. 6326(b) — Administrative appeal of liens
fragment IRC_S6326_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/6326/b";
    text en official """(b) Certificate of release
If the Secretary determines that the filing of the notice of any lien was erroneous, the Secretary shall expeditiously (and, to the extent practicable, within 14 days after such determination) issue a certificate of release of such lien and shall include in such certificate a statement that such filing was erroneous.""";
    content_hash "sha256:b09d16804c4e2ae4c0dfec91a47bb05137ebee2b83356cca494b2002779d7905";
}

// 26 U.S.C. §6326 — statutory note 4 (effectivedate-note)
