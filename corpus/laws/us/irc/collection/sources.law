// 26 U.S.C. §6361to6365 — [§§6361 to 6365. Repealed. Pub. L. 101–508, title XI, §11801(a)(45), Nov. 5, 1990, 104 Stat. 1388–522]
fragment IRC_S6361TO6365 in IRC_2024_EDITION {
    kind section;
    locator "section/6361to6365";
    text en official """[§§6361 to 6365. Repealed. Pub. L. 101–508, title XI, §11801(a)(45), Nov. 5, 1990, 104 Stat. 1388–522]""";
    content_hash "sha256:a620425ab1c1d8e03c28d1cb5e53b40fc3238f7a4c8ee32c0e57dc60c5ac80c8";
}

// 26 U.S.C. §6361to6365 — statutory note 2 (savingsprovision-note)
fragment IRC_S6361TO6365_NOTE_2 in IRC_2024_EDITION {
    kind note;
    locator "section/6361to6365/note/2";
    text en official """Savings Provision
For provisions that nothing in repeal by Pub. L. 101–508 be construed to affect treatment of certain transactions occurring, property acquired, or items of income, loss, deduction, or credit taken into account prior to Nov. 5, 1990, for purposes of determining liability for tax for periods ending after Nov. 5, 1990, see section 11821(b) of Pub. L. 101–508, set out as a note under section 45K of this title.""";
    content_hash "sha256:3352fee9b82c1d2ef7052e17d1b60dcd24d97ee19a7bcfec72278f4c19551602";
}
