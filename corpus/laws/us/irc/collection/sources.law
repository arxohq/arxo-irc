    text en official """Effective Date of Repeal
Pub. L. 92–5, title I, §4(a), Mar. 17, 1971, 85 Stat. 5, provided that the repeal of this section is effective with respect to obligations issued after Mar. 3, 1971.""";
    content_hash "sha256:69d4096dde21198ad312d1b1f7737c14a97ef2b4608b6f9293001749707b1599";
}

// 26 U.S.C. §6312 — statutory note 3 (repeal-note)
fragment IRC_S6312_NOTE_3 in IRC_2024_EDITION {
    kind note;
    locator "section/6312/note/3";
    text en official """Repeals
Pub. L. 92–5, title I, §4(a)(2), Mar. 17, 1971, 85 Stat. 5, which repealed this section and provided for the effective date of that repeal, was itself repealed by Pub. L. 97–258, §5(b), Sept. 13, 1982, 96 Stat. 1068, 1081.""";
    content_hash "sha256:069c24eb8bb561cd3dc3d6ed51947be6b8c8c242e49ccaade4fc129639e272e5";
