// 26 U.S.C. §6315 — Payments of estimated income tax
fragment IRC_S6315 in IRC_2024_EDITION {
    kind section;
    locator "section/6315";
    text en official """Payments of estimated income tax
Payment of the estimated income tax, or any installment thereof, shall be considered payment on account of the income taxes imposed by subtitle A for the taxable year.""";
    content_hash "sha256:01a4f8fdc8313b0cd54fe0d5540e73c43189a3799fd14b326cc97e86f65e613d";
}

// 26 U.S.C. §6316 — Payment by foreign currency
fragment IRC_S6316 in IRC_2024_EDITION {
    kind section;
    locator "section/6316";
    text en official """Payment by foreign currency
The Secretary is authorized in his discretion to allow payment of taxes in the currency of a foreign country under such circumstances and subject to such conditions as the Secretary may by regulations prescribe.""";
    content_hash "sha256:4e0af25100e9e8ffef11f2b937382af49948ecb001ed46e6fa48112ce9e8013d";
}

// 26 U.S.C. §6317 — Payments of Federal unemployment tax for calendar quarter
fragment IRC_S6317 in IRC_2024_EDITION {
    kind section;
    locator "section/6317";
    text en official """Payments of Federal unemployment tax for calendar quarter
Payment of Federal unemployment tax for a calendar quarter or other period within a calendar year pursuant to section 6157 shall be considered payment on account of the tax imposed by chapter 23 of such calendar year.""";
    content_hash "sha256:6c7dd98b0751890e6db9b7c62b9419de37cf1483e6f5989a7962e6313634fb71";
}

