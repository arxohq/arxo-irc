// 26 U.S.C. §§6307(d), 6311(e), 6313, 6315, 6316, 6317, 7001(a) and Pub. L. 119-64
// §2(b) (§6303(b)(2)) — collection remainder (stage 2c, 26.09.2026).
// Status: implemented_unverified.
//
// SCOPE.
//  - §6307(d): special compliance personnel (two classes), the three program
//    cost kinds and the 10 percent cap on management and supervision costs
//    treated as direct overhead (closed form: x = min(m, T0 / 9), because the
//    cap is on the total INCLUDING x).
//  - §6311(e): confidentiality of credit and debit card information: the
//    prohibition on every person, the permitted purposes and the requirement of
//    written procedures (reading 1: the written-procedures condition applies to
//    the (2) exceptions; recorded INTERPRETATION).
//  - §6313 fractional cent rounding; §6315 and §6317 payments on account;
//    §6316 foreign currency payment at the Secretary's discretion by regulations;
//    §7001(a) the license duty of collectors of foreign payments.
//  - Pub. L. 119-64 §2(b): the last date prescribed for payment (§6303(b)) is
//    determined after taking into account any period disregarded under §7508A,
//    for notices issued after enactment (approved 2025-12-26; date read from
//    raw/plaw/PLAW-119publ64.xml). The §7508A postponement is `administration`'s
//    norm; its pub relations name the act kind through an enum that is not `pub`,
//    so the postponement is a typed institutional contract here (DEPENDENCIES row).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    Assessment,
    IRC_S6307_D,
    IRC_S6311_E,
    IRC_S6313,
    IRC_S6315,
    IRC_S6316,
    IRC_S6317,
    IRC_S7001_A,
    Person,
    Secretary,
    TaxableYear,
    assessment_of_person,
    last_date_prescribed_for_payment,
    payment_demand_attempted_on,
};

// ============================================================================
// §6307(d) — Definitions
// ============================================================================

pub relation employed_as_field_collection_officer_or_similar(person: Person) kind empirical {
    label en official "the individual is employed by the Internal Revenue Service as a field function collection officer or in a similar position";
}
pub relation employed_to_collect_using_automated_collection_system(person: Person) kind empirical {
    label en official "the individual is employed to collect taxes using the automated collection system or an equivalent replacement system";
}
pub relation special_compliance_personnel(person: Person) kind institutional {
    label en official "special compliance personnel: individuals employed by the Service as field function collection officers or in a similar position, or employed to collect taxes using the automated collection system or an equivalent replacement";
}
@source(IRC_S6307_D, relation = formalizes, coverage = exact, quote = "means individuals employed by the Internal Revenue Service as field function collection officers or in a similar position")
rule S6307d1FieldCollectionOfficers defeasible {
    label en official "field function collection officers or similar positions are special compliance personnel";
    for person: Person;
    when employed_as_field_collection_officer_or_similar(person);
    then special_compliance_personnel(person);
}
@source(IRC_S6307_D, relation = formalizes, coverage = exact, quote = "or employed to collect taxes using the automated collection system or an equivalent replacement system")
rule S6307d1AutomatedCollectionSystemStaff defeasible {
    label en official "individuals employed to collect taxes using the automated collection system are special compliance personnel";
    for person: Person;
    when employed_to_collect_using_automated_collection_system(person);
    then special_compliance_personnel(person);
}
pub enum ProgramCostKind {
    PersonnelSalariesBenefitsAndTaxes;
    DirectOverheadAndSupport;
    ReimbursementForQualifiedTaxCollectionProgram;
    label en unofficial "the three kinds of program costs of section 6307(d)(2)(A)-(C)";
}
pub relation program_cost_item(item: Person, kind: ProgramCostKind) kind empirical {
    label en official "a cost item of the program, classified by the case into a kind of section 6307(d)(2)";
}
pub relation counts_as_program_cost(item: Person) kind institutional {
    label en official "the cost is a program cost under section 6307(d)(2)(A)-(C)";
}
@source(IRC_S6307_D, relation = formalizes, coverage = exact, quote = "total salaries (including locality pay and bonuses), benefits, and employment taxes for special compliance personnel employed or trained under the program")
rule S6307d2AProgramCostPersonnel defeasible {
    label en official "salaries, benefits and employment taxes of special compliance personnel are program costs";
    for item: Person;
    when program_cost_item(item, PersonnelSalariesBenefitsAndTaxes);
    then counts_as_program_cost(item);
}
@source(IRC_S6307_D, relation = formalizes, coverage = exact, quote = "direct overhead costs, salaries, benefits, and employment taxes relating to support staff")
rule S6307d2BProgramCostDirectOverhead defeasible {
    label en official "direct overhead and support costs are program costs";
    for item: Person;
    when program_cost_item(item, DirectOverheadAndSupport);
    then counts_as_program_cost(item);
}
@source(IRC_S6307_D, relation = formalizes, coverage = exact, quote = "reimbursement of the Internal Revenue Service or other government agencies for the cost of administering the qualified tax collection program under section 6306")
rule S6307d2CProgramCostReimbursement defeasible {
    label en official "reimbursement for the cost of administering the qualified tax collection program is a program cost";
    for item: Person;
    when program_cost_item(item, ReimbursementForQualifiedTaxCollectionProgram);
    then counts_as_program_cost(item);
}
pub relation management_and_supervision_cost(amount: Money) kind empirical {
    label en official "the cost of management and supervision of special compliance personnel";
}
pub relation other_program_costs_without_management(amount: Money) kind empirical {
    label en unofficial "the total program costs other than the management and supervision costs";
}
pub relation counted_management_supervision_cost(amount: Money) kind institutional {
    label en official "the cost of management and supervision taken into account as direct overhead costs, to the extent it does not represent more than 10 percent of the total program costs";
}
@source(IRC_S6307_D, relation = formalizes, coverage = exact, quote = "the cost of management and supervision of special compliance personnel shall be taken into account as direct overhead costs to the extent such costs, when included in total program costs under this paragraph, do not represent more than 10 percent of such total costs")
rule S6307d2ManagementCostWithinTenPercent defeasible {
    label en official "management and supervision costs are counted in full when they are at most 10 percent of the total including them (m*9 <= other costs)";
    for m: Money;
    for other: Money;
    when management_and_supervision_cost(m)
        and other_program_costs_without_management(other)
        and m * 9 <= other;
    then counted_management_supervision_cost(m);
}
@source(IRC_S6307_D, relation = formalizes, coverage = exact, quote = "to the extent such costs, when included in total program costs under this paragraph, do not represent more than 10 percent of such total costs")
rule S6307d2ManagementCostCappedAtTenPercent defeasible {
    label en official "above the cap, the counted amount is the one that is exactly 10 percent of the total including it: x = other / 9 (JUDGMENT CALL: cents, HALF_UP)";
    for m: Money;
    for other: Money;
    when management_and_supervision_cost(m)
        and other_program_costs_without_management(other)
        and m * 9 > other;
    then counted_management_supervision_cost(div_round(other, 9.0, 2, "HALF_UP"));
}

// ============================================================================
// §6311(e) — Confidentiality of information on credit and debit card transactions
// ============================================================================

pub enum CardInfoUserRole {
    AnyOtherPerson;
    CardIssuerOrAgent;
    ProcessorOrBiller;
    label en unofficial "who uses or discloses the information: any person, a card issuer or one acting for it, or one directly involved in processing or billing/collection";
}
pub enum CardInfoPurpose {
    ProcessingOrBillingOrCollection;
    ServicingIssuerAccounts;
    StatisticalRiskAndProfitabilityAssessment;
    TransferringReceivablesOrAccounts;
    AuditingAccountInformation;
    ComplyingWithFederalStateOrLocalLaw;
    AuthorizedInvestigation;
    AnyOtherPurpose;
    label en unofficial "the purpose of a use or disclosure of information obtained pursuant to section 6103(k)(9)";
}
pub relation card_information_used_or_disclosed(p: Person, userRole: CardInfoUserRole, purpose: CardInfoPurpose) kind empirical {
    label en official "the person uses or discloses information relating to credit or debit card transactions obtained pursuant to section 6103(k)(9)";
}
pub relation written_procedures_authorize(purpose: CardInfoPurpose) kind empirical {
    label en official "the use or disclosure is authorized by written procedures promulgated by the Secretary";
}
pub relation issuer_or_processor_role(userRole: CardInfoUserRole) kind institutional {
    label en unofficial "the role is a card issuer (or one acting for it) or one directly involved in processing or billing/collection";
}
rule S6311e2BIssuerRole strict { then issuer_or_processor_role(CardIssuerOrAgent); }
rule S6311e2BProcessorRole strict { then issuer_or_processor_role(ProcessorOrBiller); }
pub relation card_information_use_permitted(p: Person, userRole: CardInfoUserRole, purpose: CardInfoPurpose) kind institutional {
    label en official "the use or disclosure is within section 6311(e)(1) or an exception of (e)(2)";
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "other than for purposes directly related to the processing of such transactions, or the billing or collection of amounts charged or debited pursuant thereto")
rule S6311e1ProcessingBillingCollectionPermitted defeasible {
    label en official "use for the processing of the transactions, or the billing or collection of amounts charged or debited, is permitted";
    for p: Person;
    for userRole: CardInfoUserRole;
    when card_information_used_or_disclosed(p, userRole, ProcessingOrBillingOrCollection);
    then card_information_use_permitted(p, userRole, ProcessingOrBillingOrCollection);
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "may also use and disclose such information for purposes directly related to servicing an issuer's accounts")
rule S6311e2AServicingIssuerAccountsPermitted defeasible {
    label en official "issuers or those acting for them may use and disclose the information for servicing an issuer's accounts (when authorized by written procedures)";
    for p: Person;
    when card_information_used_or_disclosed(p, CardIssuerOrAgent, ServicingIssuerAccounts)
        and written_procedures_authorize(ServicingIssuerAccounts);
    then card_information_use_permitted(p, CardIssuerOrAgent, ServicingIssuerAccounts);
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "(i) statistical risk and profitability assessment;")
rule S6311e2BiStatisticalRiskPermitted defeasible {
    label en official "issuers and processors may use the information for statistical risk and profitability assessment";
    for p: Person;
    for userRole: CardInfoUserRole;
    when card_information_used_or_disclosed(p, userRole, StatisticalRiskAndProfitabilityAssessment)
        and issuer_or_processor_role(userRole)
        and written_procedures_authorize(StatisticalRiskAndProfitabilityAssessment);
    then card_information_use_permitted(p, userRole, StatisticalRiskAndProfitabilityAssessment);
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "(ii) transferring receivables, accounts, or interest therein;")
rule S6311e2BiiTransferringReceivablesPermitted defeasible {
    label en official "issuers and processors may use the information for transferring receivables, accounts, or interests therein";
    for p: Person;
    for userRole: CardInfoUserRole;
    when card_information_used_or_disclosed(p, userRole, TransferringReceivablesOrAccounts)
        and issuer_or_processor_role(userRole)
        and written_procedures_authorize(TransferringReceivablesOrAccounts);
    then card_information_use_permitted(p, userRole, TransferringReceivablesOrAccounts);
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "(iii) auditing the account information;")
rule S6311e2BiiiAuditingPermitted defeasible {
    label en official "issuers and processors may use the information for auditing the account information";
    for p: Person;
    for userRole: CardInfoUserRole;
    when card_information_used_or_disclosed(p, userRole, AuditingAccountInformation)
        and issuer_or_processor_role(userRole)
        and written_procedures_authorize(AuditingAccountInformation);
    then card_information_use_permitted(p, userRole, AuditingAccountInformation);
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "(iv) complying with Federal, State, or local law; and")
rule S6311e2BivComplyingWithLawPermitted defeasible {
    label en official "issuers and processors may use the information for complying with Federal, State, or local law";
    for p: Person;
    for userRole: CardInfoUserRole;
    when card_information_used_or_disclosed(p, userRole, ComplyingWithFederalStateOrLocalLaw)
        and issuer_or_processor_role(userRole)
        and written_procedures_authorize(ComplyingWithFederalStateOrLocalLaw);
    then card_information_use_permitted(p, userRole, ComplyingWithFederalStateOrLocalLaw);
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "(v) properly authorized civil, criminal, or regulatory investigation by Federal, State, or local authorities.")
rule S6311e2BvInvestigationPermitted defeasible {
    label en official "issuers and processors may use the information for a properly authorized investigation by Federal, State, or local authorities";
    for p: Person;
    for userRole: CardInfoUserRole;
    when card_information_used_or_disclosed(p, userRole, AuthorizedInvestigation)
        and issuer_or_processor_role(userRole)
        and written_procedures_authorize(AuthorizedInvestigation);
    then card_information_use_permitted(p, userRole, AuthorizedInvestigation);
}
@source(IRC_S6311_E, relation = formalizes, coverage = exact, quote = "no person may use or disclose any information relating to credit or debit card transactions obtained pursuant to section 6103(k)(9)")
pub rule S6311e1NoUseOrDisclosureExceptAsAuthorized defeasible {
    label en official "no person may use or disclose card transaction information obtained under section 6103(k)(9) except for the permitted purposes";
    for p: Person;
    for userRole: CardInfoUserRole;
    for purpose: CardInfoPurpose;
    when card_information_used_or_disclosed(p, userRole, purpose);
    then prohibition S6311e1NoUnauthorizedCardInformationUseProhibition {
        bearer p;
        action card_information_used_or_disclosed(p, userRole, purpose);
        window [-infinity, infinity];
    };
    unless card_information_use_permitted(p, userRole, purpose) and card_information_used_or_disclosed(p, userRole, purpose);
}

// ============================================================================
// §6313, §6315, §6316, §6317 — Payment
// ============================================================================

pub relation tax_payment_computed_amount(p: Person, y: TaxableYear, raw: Money) kind empirical {
    label en official "the amount of a payment of tax imposed by the title, before disregarding a fractional part of a cent";
}
pub relation tax_payment_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the payment amount: a fractional part of a cent is disregarded unless it amounts to one-half cent or more, in which case it is increased to 1 cent";
}
@source(IRC_S6313, relation = formalizes, coverage = exact, quote = "a fractional part of a cent shall be disregarded unless it amounts to one-half cent or more, in which case it shall be increased to 1 cent")
pub rule S6313FractionalCentRounding defeasible {
    label en official "in the payment of tax a fraction of a cent below one-half cent is disregarded and one-half cent or more becomes 1 cent (cents, HALF_UP)";
    for p: Person;
    for y: TaxableYear;
    for raw: Money;
    when tax_payment_computed_amount(p, y, raw);
    then tax_payment_amount(p, y, round(raw, 2, "HALF_UP"));
}
pub relation estimated_income_tax_payment(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "payment of the estimated income tax, or any installment thereof";
}
pub relation payment_on_account_of_income_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the payment is considered payment on account of the income taxes imposed by subtitle A for the taxable year";
}
@source(IRC_S6315, relation = formalizes, coverage = exact, quote = "Payment of the estimated income tax, or any installment thereof, shall be considered payment on account of the income taxes imposed by subtitle A for the taxable year.")
rule S6315EstimatedTaxIsPaymentOnAccountOfIncomeTax defeasible {
    label en official "an estimated income tax payment is a payment on account of the income taxes of the taxable year";
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when estimated_income_tax_payment(p, y, amount);
    then payment_on_account_of_income_tax(p, y, amount);
}
pub relation regulation_prescribes_foreign_currency_payment_conditions(p: Person) kind institutional {
    label en unofficial "regulations prescribe the circumstances and conditions for payment of taxes in the currency of a foreign country (section 6316; content not pinned)";
}
pub relation secretary_allows_foreign_currency_payment(p: Person, allowedOn: Date) kind empirical {
    label en official "the Secretary in his discretion allows payment of taxes in the currency of a foreign country";
}
pub relation foreign_currency_payment_allowed(p: Person, allowedOn: Date) kind institutional {
    label en official "payment of taxes in the currency of a foreign country is allowed";
}
@source(IRC_S6316, relation = formalizes, coverage = partial, quote = "The Secretary is authorized in his discretion to allow payment of taxes in the currency of a foreign country")
pub rule S6316AllowForeignCurrencyPayment defeasible {
    label en official "the Secretary may allow payment of taxes in the currency of a foreign country under the circumstances and conditions regulations prescribe";
    for p: Person;
    for allowedOn: Date;
    when secretary_allows_foreign_currency_payment(p, allowedOn);
    then power S6316AllowForeignCurrencyPaymentPower {
        holder Secretary;
        over p;
        exercise secretary_allows_foreign_currency_payment(p, allowedOn);
        valid_when regulation_prescribes_foreign_currency_payment_conditions(p);
        effect create(foreign_currency_payment_allowed(p, allowedOn));
    };
}
pub relation chapter_23_quarterly_payment(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "payment of Federal unemployment tax for a calendar quarter or other period within a calendar year pursuant to section 6157";
}
pub relation payment_on_account_of_chapter_23_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the payment is considered payment on account of the tax imposed by chapter 23 of such calendar year";
}
@source(IRC_S6317, relation = formalizes, coverage = exact, quote = "shall be considered payment on account of the tax imposed by chapter 23 of such calendar year")
rule S6317QuarterlyFutaPaymentIsPaymentOnAccount defeasible {
    label en official "a section 6157 payment of Federal unemployment tax is a payment on account of the chapter 23 tax of the calendar year";
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when chapter_23_quarterly_payment(p, y, amount);
    then payment_on_account_of_chapter_23_tax(p, y, amount);
}

// ============================================================================
// §7001(a) — License to collect foreign payments
// ============================================================================

pub relation undertakes_collection_of_foreign_payments(p: Person) kind empirical {
    label en official "the person undertakes, as a matter of business or for profit, the collection of foreign payments of interest or dividends by means of coupons, checks, or bills of exchange";
}
pub relation license_obtained_from_secretary(p: Person) kind empirical {
    label en official "the person has obtained a license from the Secretary";
}
@source(IRC_S7001_A, relation = formalizes, coverage = exact, quote = "shall obtain a license from the Secretary")
pub rule S7001aObtainLicense defeasible {
    label en official "persons undertaking the collection of foreign payments of interest or dividends by coupons, checks or bills of exchange, as a business or for profit, shall obtain a license from the Secretary";
    for p: Person;
    when undertakes_collection_of_foreign_payments(p);
    then duty S7001aObtainLicenseDuty {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition license_obtained_from_secretary(p);
            window [-infinity, infinity];
        }
    };
}
// EXTERNAL_DEPENDENCY: "subject to such regulations enabling the Government to obtain
// the information required under subtitle A as the Secretary shall prescribe" —
// the regulations are not pinned.

// ============================================================================
// Pub. L. 119-64 §2(b) — §6303(b)(2): payment date after §7508A postponement
// ============================================================================

relation payment_date_postponed_under_7508a(a: Assessment, original: Date, postponed: Date) kind institutional {
    label en official "the last date prescribed for payment is postponed from `original` to `postponed` by a period disregarded under section 7508A (derived from `us.irc.administration`'s postponement relations for the act kind `PaymentOfTax`, the enum being `pub` since stage 4)";
}
@source(us.irc.temporal::PL119_64_S2, relation = derives_from, quote = "the last date prescribed for payment of any tax shall be determined after taking into account any period disregarded under section 7508A")
rule S6303b2PostponedBySecretaryUnder7508A defeasible {
    label en official "a postponement of the payment act by the Secretary under section 7508A(a) postpones the last date prescribed for payment";
    for a: Assessment;
    for p: Person;
    for original: Date;
    for postponed: Date;
    when assessment_of_person(a, p)
        and us.irc.administration::deadline_postponed_by_secretary(p, us.irc.administration::PaymentOfTax, _, original, postponed);
    then payment_date_postponed_under_7508a(a, original, postponed);
}
@source(us.irc.temporal::PL119_64_S2, relation = derives_from, quote = "the last date prescribed for payment of any tax shall be determined after taking into account any period disregarded under section 7508A")
rule S6303b2PostponedMandatorilyUnder7508Ad defeasible {
    label en official "the mandatory postponement of the payment act for a qualified taxpayer under section 7508A(d) postpones the last date prescribed for payment";
    for a: Assessment;
    for p: Person;
    for original: Date;
    for postponed: Date;
    when assessment_of_person(a, p)
        and us.irc.administration::mandatory_deadline_postponed(p, us.irc.administration::PaymentOfTax, _, original, postponed);
    then payment_date_postponed_under_7508a(a, original, postponed);
}
relation payment_postponement_applies(a: Assessment) kind institutional {
    label en unofficial "a section 7508A postponement of the payment date applies to a notice issued after Pub. L. 119-64 was enacted";
}
@source(us.irc.temporal::PL119_64_S2, relation = derives_from, quote = "the last date prescribed for payment of any tax shall be determined after taking into account any period disregarded under section 7508A")
rule S6303b2PostponementApplies defeasible {
    label en official "a section 7508A postponement applies when the demand notice is issued after 2025-12-26";
    for a: Assessment;
    for p: Person;
    for original: Date;
    for postponed: Date;
    for on: Date;
    when last_date_prescribed_for_payment(a, original)
        and payment_date_postponed_under_7508a(a, original, postponed)
        and assessment_of_person(a, p)
        and payment_demand_attempted_on(a, p, on)
        and on > @2025-12-26;
    then payment_postponement_applies(a);
}
pub relation last_date_prescribed_for_payment_effective(a: Assessment, d: Date) kind institutional {
    label en official "the last date prescribed for payment, determined after taking into account any period disregarded under section 7508A (notices issued after 2025-12-26)";
}
@source(us.irc.temporal::PL119_64_S2, relation = derives_from, quote = "the last date prescribed for payment of any tax shall be determined after taking into account any period disregarded under section 7508A")
rule S6303b2EffectiveDatePostponed defeasible {
    label en official "the postponed date is the last date prescribed for payment";
    for a: Assessment;
    for p: Person;
    for original: Date;
    for postponed: Date;
    for on: Date;
    when last_date_prescribed_for_payment(a, original)
        and payment_date_postponed_under_7508a(a, original, postponed)
        and assessment_of_person(a, p)
        and payment_demand_attempted_on(a, p, on)
        and on > @2025-12-26;
    then last_date_prescribed_for_payment_effective(a, postponed);
}
rule S6303b2EffectiveDateUnchanged defeasible {
    label en official "without an applicable postponement the last date prescribed for payment is unchanged";
    for a: Assessment;
    for d: Date;
    when last_date_prescribed_for_payment(a, d)
        and not_known(payment_postponement_applies(a));
    then last_date_prescribed_for_payment_effective(a, d);
}
