// §6320 (notice and opportunity for hearing upon filing of notice of lien —
// reusing the shared CDP hearing/suspension mechanics of
// 04-levy-hearing-and-power.law's §6330 module under
// `CDPOrigin::LienFilingNotice`, per §6320(c)'s own cross-reference) and
// §6325(a),(b),(d),(e),(f) (release, discharge, subordination, nonattachment,
// and the effect of a certificate — the subsections named by the owner's
// stage-1 anchor list; (c),(g),(h) stay `unreviewed`/"stage 2").
//
// JUDGMENT CALLS (see report):
//  - §6320(a)(2)'s "not more than 5 business days after the day of the
//    filing of the notice of lien" is the package's ONE genuine business-day
//    computation (confirmed by grepping every stage-1 section's pinned
//    quotes for "business day"). WIRE-1 (25.09.2026, DECISION D-08) added
//    `pub` to `us.code.federal_holidays::Holiday`/`observed_holiday_on` and
//    wired it into `administration`'s §7503 module (a yes/no "is this date
//    a holiday" check), but that does NOT by itself give a "count N business
//    days forward from a start date" primitive — the closed computable
//    surface still has none (same TECH_GAP class as G4/G205 in TECH-GAPS.md;
//    `add_business_days` needs exactly that primitive and does not have it).
//    So this section is UNCHANGED by the `pub` fix: the case still supplies
//    a CANDIDATE date, asserting separately (as a case fact, not computed)
//    that the candidate IS the 5th business day after filing; the rule only
//    certifies the duty's window from that candidate. Coverage row: TECH_GAP
//    (language/subset limitation — no business-day-counting step), not
//    EXTERNAL_DEPENDENCY (the `pub` blocker itself is resolved).
//  - §6320(a)(3)'s five content items (A)-(E) are the REQUIRED CONTENTS of
//    the (a)(1)/(2) notice, not five independent norms; (a)(3)(B) (the
//    30-day hearing-request-window disclosure) is the one item with its own
//    operative computation (the window itself) and gets its own rule. The
//    other four ((A) amount, (C) appeals, (D) release provisions, (E) §7345
//    passport certification) are `non_normative` — informational content
//    requirements on the same notice, not separate dispositions.
//  - §6320(c)'s incorporation of §6330(c),(d) (except (3)(B)), (e), (g) is
//    modelled by simply calling those same relations under
//    `CDPOrigin::LienFilingNotice` — no new rules are declared for the
//    hearing/determination/suspension mechanics themselves.
//  - §6325(c) (discharge of a §6324 estate/gift lien — a DIFFERENT owner
//    package's lien) is out of this stage's anchor list; §6325(g) (place for
//    filing a certificate) and (h) (cross-reference to bonds, chapter 73)
//    are likewise left `unreviewed`/"stage 2".

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    Assessment,
    CDPOrigin,
    IRC_S6320_A,
    IRC_S6325_A,
    IRC_S6325_B,
    IRC_S6325_D,
    IRC_S6325_E,
    IRC_S6325_F,
    Lien,
    Person,
    Secretary,
    cdp_request_window,
    lien_arises,
    lien_notice_filed_on,
};

// ============================================================================
// §6320(a) — Notice of filing of notice of lien
// ============================================================================

pub relation lien_filing_notice_given(p: Person, lien: Lien) kind empirical {
    label en unofficial "the Secretary notified the person described in §6321 (in person, left at dwelling/place of business, or by certified/registered mail) of the filing of the §6323 notice of lien";
}
relation lien_filing_notice_window_candidate(lien: Lien, filed_on: Date, candidate: Date) kind empirical {
    label en unofficial "the case-supplied candidate for the last day of the §6320(a)(2) 5-business-day window after the lien notice was filed — see the EXTERNAL_DEPENDENCY judgment call above; this package CERTIFIES the candidate, it does not compute it";
}
relation candidate_is_5th_business_day_after_filing(lien: Lien, filed_on: Date, candidate: Date) kind empirical {
    label en unofficial "the candidate date is, in fact, the 5th business day after the filing date under the federal (5 U.S.C. §6103) business-day calendar — a fact the case must supply from that calendar, since this package cannot compute it (see EXTERNAL_DEPENDENCY)";
}
pub relation lien_filing_notice_window_end(lien: Lien, filed_on: Date, candidate: Date) kind institutional {
    label en unofficial "the certified last day of the §6320(a)(2) window: not more than 5 business days after the day the notice of lien was filed";
}
@source(IRC_S6320_A, relation = formalizes, coverage = partial, quote = "not more than 5 business days after the day of the filing of the notice of lien")
rule S6320a2CertifyFiveBusinessDayWindow strict {
    for lien: Lien;
    for filed_on: Date;
    for candidate: Date;
    when lien_filing_notice_window_candidate(lien, filed_on, candidate)
        and candidate_is_5th_business_day_after_filing(lien, filed_on, candidate);
    then lien_filing_notice_window_end(lien, filed_on, candidate);
}

@source(IRC_S6320_A, relation = formalizes, coverage = exact, quote = "The Secretary shall notify in writing the person described in section 6321 of the filing of a notice of lien under section 6323.")
rule S6320aNotifyOfLienFilingDuty strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for filed_on: Date;
    for end: Date;
    when lien_arises(lien, p, a)
        and lien_notice_filed_on(lien, filed_on)
        and lien_filing_notice_window_end(lien, filed_on, end);
    then duty NotifyOfLienFiling {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition lien_filing_notice_given(p, lien);
            window [filed_on, end];
        }
    };
}

pub relation lien_hearing_request_window(p: Person, lien: Lien, start: Date, end: Date) kind institutional {
    label en unofficial "the 30-day period to request a §6320 hearing: beginning the day after the certified §6320(a)(2) 5-business-day window ends — §6320(a)(3)(B)";
}
@source(IRC_S6320_A, relation = formalizes, coverage = exact, quote = "the right of the person to request a hearing during the 30-day period beginning on the day after the 5-day period described in paragraph (2)")
rule S6320a3bHearingRequestWindow strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for filed_on: Date;
    for five_day_end: Date;
    when lien_arises(lien, p, a)
        and lien_filing_notice_window_end(lien, filed_on, five_day_end);
    then lien_hearing_request_window(p, lien, add_calendar_period(five_day_end, 1 calendar_day), add_calendar_period(add_calendar_period(five_day_end, 1 calendar_day), 30 calendar_day));
}

// Feeds the shared `cdp_request_window` (04-levy-hearing-and-power.law),
// tagged `CDPOrigin::LienFilingNotice`, so `S6330RequestTimelyWithinWindow`
// (declared once in that module) also governs a §6320 request.
@source(IRC_S6320_A, relation = formalizes, coverage = partial, quote = "the right of the person to request a hearing during the 30-day period beginning on the day after the 5-day period described in paragraph (2)")
rule S6320FeedsSharedCDPRequestWindow strict {
    for p: Person;
    for a: Assessment;
    for lien: Lien;
    for start: Date;
    for end: Date;
    when lien_arises(lien, p, a) and lien_hearing_request_window(p, lien, start, end);
    then cdp_request_window(p, LienFilingNotice, a, start, end);
}

// §6320(a)(3)(A),(C),(D),(E): informational content of the same notice —
// `non_normative` (recorded per-row in coverage/collection.json).

// ============================================================================
// §6320(b) — Hearing entitlement (reuses the shared mechanics as-is)
// ============================================================================
//
// §6320(b)(1)-(3) restate, verbatim in substance, §6330(b)(1)-(3) (hearing
// held by Independent Office of Appeals; one hearing per taxable period;
// independent officer, waivable). `S6330bHearingScheduled` and
// `S6330cHearingProperlyHeld` already generalize over `CDPOrigin`, so no new
// rule is declared here — a §6320 scenario simply asserts
// `collection_due_process_requested(p, LienFilingNotice, a, on)` and the
// shared rules fire under that tag. §6320(b)(4) ("to the extent
// practicable... in conjunction with a hearing under section 6330") is an
// administrative-convenience directive with no independent legal
// consequence for this pilot's scenarios — `non_normative`.

// ============================================================================
// §6320(c) — Incorporation of §6330(c),(d) (except (3)(B)),(e),(g)
// ============================================================================
//
// No new relations: a §6320 scenario reads `cdp_issue_properly_raised`,
// `cdp_determination_made`, `cdp_petition_window`/`cdp_petition_timely`,
// `levy_suspended`/`collection_period_suspended_by_cdp`/
// `criminal_prosecution_period_suspended_by_cdp`/
// `other_suit_period_suspended_by_cdp`, and
// `cdp_request_disregarded_as_frivolous`, all under
// `CDPOrigin::LienFilingNotice`. §6330(d)(3)(B) (Appeals' retained
// jurisdiction over a LATER change in circumstances) is the one paragraph
// §6320(c) excludes from incorporation ("other than paragraph (3)(B)
// thereof") — already `non_normative` in the §6330 module, so excluding it
// from §6320 changes nothing this package models.

// ============================================================================
// §6325(a) — Release of lien
// ============================================================================

pub relation lien_release_condition_met(lien: Lien, p: Person, a: Assessment, on: Date) kind institutional {
    label en unofficial "one of §6325(a)'s two release conditions is met on this date: the liability (with interest) is fully satisfied or has become legally unenforceable, or a conforming bond has been furnished and accepted";
}
relation liability_fully_satisfied_or_unenforceable_on(p: Person, a: Assessment, on: Date) kind empirical;
relation conforming_bond_furnished_and_accepted_on(p: Person, a: Assessment, on: Date) kind empirical;
@source(IRC_S6325_A, relation = formalizes, coverage = exact, quote = "The Secretary finds that the liability for the amount assessed, together with all interest in respect thereof, has been fully satisfied or has become legally unenforceable")
rule S6325aReleaseConditionSatisfaction strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for on: Date;
    when lien_arises(lien, p, a) and liability_fully_satisfied_or_unenforceable_on(p, a, on);
    then lien_release_condition_met(lien, p, a, on);
}
@source(IRC_S6325_A, relation = formalizes, coverage = exact, quote = "There is furnished to the Secretary and accepted by him a bond that is conditioned upon the payment of the amount assessed, together with all interest in respect thereof, within the time prescribed by law")
rule S6325aReleaseConditionBond strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for on: Date;
    when lien_arises(lien, p, a) and conforming_bond_furnished_and_accepted_on(p, a, on);
    then lien_release_condition_met(lien, p, a, on);
}

pub relation certificate_of_release_issued(lien: Lien) kind empirical;
@source(IRC_S6325_A, relation = formalizes, coverage = exact, quote = "the Secretary shall issue a certificate of release of any lien imposed with respect to any internal revenue tax not later than 30 days after the day on which—")
rule S6325aReleaseDuty strict {
    for lien: Lien;
    for p: Person;
    for a: Assessment;
    for met_on: Date;
    when lien_release_condition_met(lien, p, a, met_on);
    then duty IssueCertificateOfRelease {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition certificate_of_release_issued(lien);
            window [met_on, add_calendar_period(met_on, 30 calendar_day)];
        }
    };
}

// ============================================================================
// §6325(b) — Discharge of property
// ============================================================================

pub relation certificate_of_discharge_issuable(lien: Lien) kind institutional {
    label en unofficial "the Secretary may issue a certificate of discharge of part or all of the property subject to the lien — §6325(b)(1)-(4)";
}
relation remaining_property_value_at_least_double_liability(lien: Lien) kind empirical {
    label en unofficial "the fair market value of the property remaining subject to the lien is at least double the unsatisfied liability plus all liens with priority over it — §6325(b)(1)";
}
@source(IRC_S6325_B, relation = formalizes, coverage = exact, quote = "the Secretary may issue a certificate of discharge of any part of the property subject to any lien imposed under this chapter if the Secretary finds that the fair market value of that part of such property remaining subject to the lien is at least double the amount of the unsatisfied liability secured by such lien and the amount of all other liens upon such property which have priority over such lien")
rule S6325b1DischargeByDoubleValueCushion strict {
    for lien: Lien;
    when remaining_property_value_at_least_double_liability(lien);
    then certificate_of_discharge_issuable(lien);
}
relation partial_satisfaction_paid_for_discharge(lien: Lien, amount: Money) kind empirical;
relation us_interest_in_discharged_part_has_no_value(lien: Lien) kind empirical;
@source(IRC_S6325_B, relation = formalizes, coverage = exact, quote = "there is paid over to the Secretary in partial satisfaction of the liability secured by the lien an amount determined by the Secretary, which shall not be less than the value, as determined by the Secretary, of the interest of the United States in the part to be so discharged, or")
rule S6325b2DischargeByPartialPaymentOrNoValue defeasible {
    for lien: Lien;
    for amount: Money;
    when partial_satisfaction_paid_for_discharge(lien, amount);
    then certificate_of_discharge_issuable(lien);
    unless us_interest_in_discharged_part_has_no_value(lien) and partial_satisfaction_paid_for_discharge(lien, amount);
}
relation discharged_part_sold_proceeds_held_as_fund(lien: Lien) kind empirical {
    label en unofficial "the discharged part of the property is sold and, by agreement with the Secretary, its proceeds are held as a fund subject to the same liens and claims, with the same priority, as the discharged property — §6325(b)(3)";
}
@source(IRC_S6325_B, relation = formalizes, coverage = exact, quote = "the Secretary may issue a certificate of discharge of any part of the property subject to the lien if such part of the property is sold and, pursuant to an agreement with the Secretary, the proceeds of such sale are to be held, as a fund subject to the liens and claims of the United States, in the same manner and with the same priority as such liens and claims had with respect to the discharged property")
rule S6325b3DischargeBySaleProceedsFund strict {
    for lien: Lien;
    when discharged_part_sold_proceeds_held_as_fund(lien);
    then certificate_of_discharge_issuable(lien);
}
relation owner_deposited_or_bonded_us_interest_value(lien: Lien) kind empirical {
    label en unofficial "at the owner's request, the owner deposited money equal to the United States' interest in the property, or furnished an acceptable bond in like amount — §6325(b)(4)(A)";
}
relation owner_is_the_liable_person(lien: Lien) kind empirical {
    label en unofficial "the owner requesting discharge is the same person whose unsatisfied liability gave rise to the lien — §6325(b)(4)(D)'s carve-out";
}
@source(IRC_S6325_B, relation = formalizes, coverage = exact, quote = "At the request of the owner of any property subject to any lien imposed by this chapter, the Secretary shall issue a certificate of discharge of such property if such owner")
rule S6325b4DischargeByDepositOrBond defeasible {
    for lien: Lien;
    when owner_deposited_or_bonded_us_interest_value(lien);
    then certificate_of_discharge_issuable(lien);
    unless owner_is_the_liable_person(lien) and owner_deposited_or_bonded_us_interest_value(lien);
}

// ============================================================================
// §6325(d) — Subordination
// ============================================================================

pub relation certificate_of_subordination_issuable(lien: Lien) kind institutional {
    label en unofficial "the Secretary may issue a certificate subordinating the federal tax lien to another lien or interest — §6325(d)";
}
relation amount_of_subordinated_interest_paid_over(lien: Lien) kind empirical;
relation subordination_will_increase_ultimate_realization(lien: Lien) kind empirical {
    label en unofficial "the Secretary believes the amount ultimately realizable by the United States will be increased, and collection facilitated, by the subordination — §6325(d)(2)";
}
relation section_6324b_lien_adequately_secured_after_subordination(lien: Lien) kind empirical;
@source(IRC_S6325_D, relation = formalizes, coverage = exact, quote = "there is paid over to the Secretary an amount equal to the amount of the lien or interest to which the certificate subordinates the lien of the United States")
rule S6325d1SubordinationByPayment strict {
    for lien: Lien;
    when amount_of_subordinated_interest_paid_over(lien);
    then certificate_of_subordination_issuable(lien);
}
@source(IRC_S6325_D, relation = formalizes, coverage = exact, quote = "the Secretary believes that the amount realizable by the United States from the property to which the certificate relates, or from any other property subject to the lien, will ultimately be increased by reason of the issuance of such certificate and that the ultimate collection of the tax liability will be facilitated by such subordination")
rule S6325d2SubordinationByFacilitatedCollection strict {
    for lien: Lien;
    when subordination_will_increase_ultimate_realization(lien);
    then certificate_of_subordination_issuable(lien);
}
@source(IRC_S6325_D, relation = formalizes, coverage = exact, quote = "in the case of any lien imposed by section 6324B, if the Secretary determines that the United States will be adequately secured after such subordination")
rule S6325d3SubordinationOf6324BLien strict {
    for lien: Lien;
    when section_6324b_lien_adequately_secured_after_subordination(lien);
    then certificate_of_subordination_issuable(lien);
}

// ============================================================================
// §6325(e) — Certificate of nonattachment
// ============================================================================

pub relation certificate_of_nonattachment_issuable(lien: Lien, claimant: Person) kind institutional {
    label en unofficial "the Secretary may certify that the lien does not attach to the claimant's property — §6325(e)";
}
relation confusion_of_names_risk_of_injury(lien: Lien, claimant: Person) kind empirical {
    label en unofficial "because of confusion of names or otherwise, the claimant (not the person against whom the tax was assessed) is or may be injured by the appearance that the recorded notice of lien refers to the claimant — §6325(e)";
}
@source(IRC_S6325_E, relation = formalizes, coverage = exact, quote = "If the Secretary determines that, because of confusion of names or otherwise, any person (other than the person against whom the tax was assessed) is or may be injured by the appearance that a notice of lien filed under section 6323 refers to such person, the Secretary may issue a certificate that the lien does not attach to the property of such person.")
rule S6325eNonattachmentByConfusionOfNames strict {
    for lien: Lien;
    for claimant: Person;
    when confusion_of_names_risk_of_injury(lien, claimant);
    then certificate_of_nonattachment_issuable(lien, claimant);
}

// ============================================================================
// §6325(f) — Effect of a certificate; revocation
// ============================================================================

enum LienCertificateKind {
    Release;
    Discharge;
    Subordination;
    Nonattachment;
}
relation certificate_issued_and_filed(lien: Lien, kind: LienCertificateKind, claimant: Person) kind empirical {
    label en unofficial "a certificate under §6325 was issued and filed in the same office as the notice of lien to which it relates (if any) — §6325(f)(1)'s own precondition for conclusive effect";
}

pub relation lien_extinguished(lien: Lien) kind institutional;
@source(IRC_S6325_F, relation = formalizes, coverage = exact, quote = "in the case of a certificate of release, such certificate shall be conclusive that the lien referred to in such certificate is extinguished")
rule S6325f1ReleaseIsConclusive strict {
    for lien: Lien;
    for claimant: Person;
    when certificate_issued_and_filed(lien, Release, claimant);
    then lien_extinguished(lien);
}

pub relation property_discharged_from_lien(lien: Lien, claimant: Person) kind institutional;
@source(IRC_S6325_F, relation = formalizes, coverage = exact, quote = "in the case of a certificate of discharge, such certificate shall be conclusive that the property covered by such certificate is discharged from the lien")
rule S6325f1DischargeIsConclusive strict {
    for lien: Lien;
    for claimant: Person;
    when certificate_issued_and_filed(lien, Discharge, claimant);
    then property_discharged_from_lien(lien, claimant);
}

pub relation subordinated_interest_is_superior(lien: Lien, claimant: Person) kind institutional;
@source(IRC_S6325_F, relation = formalizes, coverage = exact, quote = "in the case of a certificate of subordination, such certificate shall be conclusive that the lien or interest to which the lien of the United States is subordinated is superior to the lien of the United States")
rule S6325f1SubordinationIsConclusive strict {
    for lien: Lien;
    for claimant: Person;
    when certificate_issued_and_filed(lien, Subordination, claimant);
    then subordinated_interest_is_superior(lien, claimant);
}

@source(IRC_S6325_F, relation = formalizes, coverage = exact, quote = "in the case of a certificate of nonattachment, such certificate shall be conclusive that the lien of the United States does not attach to the property of the person referred to in such certificate")
rule S6325f1NonattachmentIsConclusive strict {
    for lien: Lien;
    for claimant: Person;
    when certificate_issued_and_filed(lien, Nonattachment, claimant);
    then property_discharged_from_lien(lien, claimant);
}

pub relation reacquired_property_reattaches(lien: Lien, p: Person, on: Date) kind institutional {
    label en unofficial "if the person liable for the tax reacquires, after a certificate of discharge, the property that was discharged, the lien reattaches to it — §6325(f)(3)";
}
relation reacquired_discharged_property_on(lien: Lien, p: Person, on: Date) kind empirical;
@source(IRC_S6325_F, relation = formalizes, coverage = exact, quote = "any lien imposed by this chapter shall attach to any property with respect to which a certificate of discharge has been issued if the person liable for the tax reacquires such property after such certificate has been issued")
rule S6325f3ReacquisitionReattachesLien strict {
    for lien: Lien;
    for p: Person;
    for on: Date;
    when reacquired_discharged_property_on(lien, p, on);
    then reacquired_property_reattaches(lien, p, on);
}

pub relation lien_revoked_and_reinstated(lien: Lien, p: Person, effective_on: Date) kind institutional {
    label en unofficial "the Secretary revoked an erroneous/improvident release or nonattachment certificate (or one issued under a breached §7122 collateral agreement), within the §6502 limitations period, and reinstated the lien — §6325(f)(2)";
}
relation certificate_erroneous_or_agreement_breached(lien: Lien) kind empirical;
relation revocation_notice_mailed_on(lien: Lien, p: Person, on: Date) kind empirical;
relation revocation_notice_filed_on(lien: Lien, on: Date) kind empirical {
    label en unofficial "notice of the revocation was filed in the same office the original notice of lien was filed in (if any) — §6325(f)(2)(B)";
}
@source(IRC_S6325_F, relation = formalizes, coverage = partial, quote = "Such reinstated lien (i) shall be effective on the date notice of revocation is mailed to the taxpayer in accordance with the provisions of subparagraph (A), but not earlier than the date on which any required filing of notice of revocation is filed in accordance with the provisions of subparagraph (B)")
rule S6325f2RevocationReinstatesLien strict {
    for lien: Lien;
    for p: Person;
    for mailed_on: Date;
    for filed_on: Date;
    when certificate_erroneous_or_agreement_breached(lien)
        and revocation_notice_mailed_on(lien, p, mailed_on)
        and revocation_notice_filed_on(lien, filed_on)
        and filed_on <= mailed_on;
    then lien_revoked_and_reinstated(lien, p, mailed_on);
}
