// §6301 (general rule: the Secretary shall collect the taxes imposed by the
// internal revenue laws), §6303(a)-(b) (notice and demand: the Secretary's
// duty to notify a person liable for an unpaid tax within 60 days after
// assessment, and the timing restriction against demanding payment before
// the last date prescribed for payment), §6304 (fair collection practices:
// prohibitions on the Secretary's own conduct in collecting an unpaid tax).
//
// JUDGMENT CALLS (see report):
//  - §6301 is a single institutional-effect sentence naming a general duty
//    of the Secretary (collect taxes) with no addressee-specific
//    performance/breach structure of its own (chapter 64's own sections give
//    that structure); modelled as a `maintenance` duty, per AGENT-BRIEF's
//    guidance for a standing, non-episodic obligation ("shall collect", not
//    "shall collect by <date>").
//  - §6303(b)'s "collection would be jeopardized by delay" is the SAME
//    jeopardy-finding fact used throughout this package (§6330(f)(1),
//    §6331(a) last sentence, §6331(d)(3), §6331(g)(2)); declared once here
//    (`jeopardy_finding`) and referenced by the later modules rather than
//    re-declared per section.
//  - §6304(a)(4) ("assume convenient time is 8 a.m.-9 p.m.") is folded into
//    the (a)(1) prohibition as a burden-allocation rule producing the
//    `communication_at_unusual_time_or_place` fact, not a separate
//    prohibition of its own.
//  - §6304(b)'s introductory sentence ("may not engage in any conduct the
//    natural consequence of which is to harass, oppress, or abuse") is an
//    EVALUATIVE standard (DECISION-0194): the enumerated (1)-(4) are
//    per-se violations (empirical, not evaluative) but the general
//    catch-all itself is not reduced to an arithmetic guard — modelled as an
//    `external judgment relation` naming the court as the authority (civil
//    actions for §6304 violations are brought under §7433, a judicial
//    determination), with the per-se items as one channel that SATISFIES
//    the standard without needing the judgment.
//  - §6304(c) ("For civil action ... see section 7433") is a pure
//    cross-reference — `non_normative`.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    Assessment,
    CollectionNoticeKind,
    IRC_S6301,
    IRC_S6303_A,
    IRC_S6303_B,
    IRC_S6304_A,
    IRC_S6304_B,
    Person,
    Secretary,
    last_date_prescribed_for_payment_effective,
};

// ============================================================================
// §6301 — General rule: the Secretary shall collect the taxes
// ============================================================================

@source(IRC_S6301, relation = formalizes, coverage = exact, quote = "The Secretary shall collect the taxes imposed by the internal revenue laws.")
rule S6301CollectionAuthority strict {
    then duty CollectTaxesImposedByInternalRevenueLaws {
        bearer Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6303(a)-(b) — Notice and demand for payment
// ============================================================================

relation assessment_of_person(a: Assessment, p: Person) kind institutional {
    label en unofficial "the assessment names this person as liable for the unpaid tax (projection of core's assessment_of onto the person argument only, for readability in this module)";
}
relation notice_given(kind: CollectionNoticeKind, to: Person) kind empirical {
    label en unofficial "a notice of this kind was given to this person (the specific document identity is not tracked at this stage — only the fact and, where relevant, the date)";
}
relation title_otherwise_provides_for_notice(a: Assessment) kind empirical {
    label en unofficial "another provision of this title otherwise provides for the notice-and-demand step (§6303(a)'s own opening carve-out — e.g. a jeopardy assessment's own notice rule)";
}
pub relation jeopardy_finding(p: Person) kind empirical {
    label en unofficial "the Secretary has made a finding that collection of the tax would be jeopardized by delay — the single jeopardy-finding fact this package's later modules (§6320(f)/(g) cross-reference to §6331(a), §6331(a) last sentence, §6331(d)(3), §6331(g)(2)) all read";
}

@source(IRC_S6303_A, relation = formalizes, coverage = exact, quote = "Where it is not otherwise provided by this title, the Secretary shall, as soon as practicable, and within 60 days, after the making of an assessment of a tax pursuant to section 6203, give notice to each person liable for the unpaid tax, stating the amount and demanding payment thereof.")
rule S6303NoticeAndDemandDuty strict {
    for a: Assessment;
    for p: Person;
    for d1: Date;
    when assessment_of_person(a, p)
        and us.irc.core::assessed_on(a, d1)
        and not_known(title_otherwise_provides_for_notice(a));
    then duty GiveNoticeAndDemand {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition notice_given(NoticeAndDemandForPayment, p);
            window [d1, add_calendar_period(d1, 60 calendar_day)];
        }
    };
}

pub relation demand_may_be_made(a: Assessment, p: Person, on: Date) kind institutional {
    label en unofficial "payment of the assessed tax may lawfully be demanded under §6303(a) on this date";
}
relation last_date_prescribed_for_payment(a: Assessment, d: Date) kind institutional {
    label en unofficial "the last date prescribed by law for payment of the assessed tax (owner: payment-refunds-interest, §6151 — pending contract, see deps.json)";
}

relation payment_demand_attempted_on(a: Assessment, p: Person, on: Date) kind empirical {
    label en unofficial "a case fact: the Secretary attempted (or is contemplated to attempt) a §6303(a) demand on this date — the date `demand_may_be_made`'s validity is checked against";
}

@source(IRC_S6303_B, relation = formalizes, coverage = exact, quote = "Except where the Secretary believes collection would be jeopardized by delay, if any tax is assessed prior to the last date prescribed for payment of such tax, payment of such tax shall not be demanded under subsection (a) until after such date.")
rule S6303bDemandDeferredUntilLastPaymentDate defeasible {
    for a: Assessment;
    for p: Person;
    for pay_by: Date;
    for on: Date;
    when assessment_of_person(a, p)
        and last_date_prescribed_for_payment_effective(a, pay_by)
        and payment_demand_attempted_on(a, p, on)
        and on > pay_by;
    then demand_may_be_made(a, p, on);
    unless jeopardy_finding(p) and last_date_prescribed_for_payment_effective(a, pay_by) and payment_demand_attempted_on(a, p, on) and on > pay_by;
}

@source(IRC_S6303_B, relation = formalizes, coverage = exact, quote = "Except where the Secretary believes collection would be jeopardized by delay, if any tax is assessed prior to the last date prescribed for payment of such tax, payment of such tax shall not be demanded under subsection (a) until after such date.")
rule S6303bJeopardyAllowsImmediateDemand strict {
    for a: Assessment;
    for p: Person;
    for on: Date;
    when assessment_of_person(a, p)
        and jeopardy_finding(p)
        and payment_demand_attempted_on(a, p, on);
    then demand_may_be_made(a, p, on);
}

// ============================================================================
// §6304 — Fair collection practices
// ============================================================================

relation communication_by_secretary(p: Person, on: Date) kind empirical {
    label en unofficial "the Secretary communicated with the taxpayer in connection with the collection of an unpaid tax on this occasion";
}
relation taxpayer_consented_directly(p: Person) kind empirical;
relation court_permitted_communication(p: Person) kind empirical;
relation communication_at_unusual_time_or_place(p: Person, on: Date) kind empirical {
    label en unofficial "the communication occurred at a time or place known, or which should be known, to be inconvenient to the taxpayer — includes the §6304(a)(4) burden allocation (absent contrary knowledge, before 8 a.m. or after 9 p.m. local time at the taxpayer's location is presumed inconvenient)";
}
relation taxpayer_represented_and_ascertainable(p: Person) kind empirical {
    label en unofficial "the Secretary knows the taxpayer is represented by a person authorized to practice before the IRS on this unpaid tax, and knows or can readily ascertain that representative's name and address";
}
relation representative_failed_to_respond_or_consented(p: Person) kind empirical {
    label en unofficial "the representative failed to respond within a reasonable time, or consented to direct communication (§6304(a)(2)'s own carve-out)";
}
relation employer_prohibits_workplace_communication(p: Person) kind empirical;

pub relation collection_communication_prohibited(p: Person, on: Date) kind institutional {
    label en unofficial "the Secretary may not communicate with the taxpayer, in connection with collecting an unpaid tax, in this manner absent the taxpayer's direct consent or a court's express permission";
}

@source(IRC_S6304_A, relation = formalizes, coverage = partial, quote = "at any unusual time or place or a time or place known or which should be known to be inconvenient to the taxpayer")
rule S6304aProhibitedUnusualTimeOrPlace defeasible {
    for p: Person;
    for on: Date;
    when communication_by_secretary(p, on) and communication_at_unusual_time_or_place(p, on);
    then collection_communication_prohibited(p, on);
    unless taxpayer_consented_directly(p) and communication_by_secretary(p, on);
    unless court_permitted_communication(p) and communication_by_secretary(p, on);
}

@source(IRC_S6304_A, relation = formalizes, coverage = exact, quote = "if the Secretary knows the taxpayer is represented by any person authorized to practice before the Internal Revenue Service with respect to such unpaid tax and has knowledge of, or can readily ascertain, such person's name and address, unless such person fails to respond within a reasonable period of time to a communication from the Secretary or unless such person consents to direct communication with the taxpayer")
rule S6304aProhibitedDirectContactWhenRepresented defeasible {
    for p: Person;
    for on: Date;
    when communication_by_secretary(p, on) and taxpayer_represented_and_ascertainable(p);
    then collection_communication_prohibited(p, on);
    unless representative_failed_to_respond_or_consented(p) and communication_by_secretary(p, on);
    unless taxpayer_consented_directly(p) and communication_by_secretary(p, on);
    unless court_permitted_communication(p) and communication_by_secretary(p, on);
}

@source(IRC_S6304_A, relation = formalizes, coverage = exact, quote = "at the taxpayer's place of employment if the Secretary knows or has reason to know that the taxpayer's employer prohibits the taxpayer from receiving such communication")
rule S6304aProhibitedWorkplaceContact defeasible {
    for p: Person;
    for on: Date;
    when communication_by_secretary(p, on) and employer_prohibits_workplace_communication(p);
    then collection_communication_prohibited(p, on);
    unless taxpayer_consented_directly(p) and communication_by_secretary(p, on);
    unless court_permitted_communication(p) and communication_by_secretary(p, on);
}

// §6304(b): the per-se list is empirical (not evaluative); the opening
// "harass, oppress, or abuse" catch-all is the evaluative channel.
relation violence_or_threat_of_violence(p: Person, on: Date) kind empirical;
relation obscene_or_profane_language(p: Person, on: Date) kind empirical;
relation repeated_telephone_harassment(p: Person, on: Date) kind empirical;
relation telephone_call_without_identity_disclosure(p: Person, on: Date) kind empirical;
relation fdcpa_804_similar_rule_exception(p: Person, on: Date) kind empirical {
    label en unofficial "a rule similar to §804 of the Fair Debt Collection Practices Act (15 U.S.C. 1692b) excuses the nondisclosure (§6304(b)(4)'s own carve-out)";
}

pub relation collection_conduct_prohibited(p: Person, on: Date) kind institutional {
    label en unofficial "the Secretary's conduct on this occasion is a per-se violation of §6304(b) (harassing, oppressive, or abusive conduct in connection with collecting an unpaid tax)";
}

@source(IRC_S6304_B, relation = formalizes, coverage = exact, quote = "The use or threat of use of violence or other criminal means to harm the physical person, reputation, or property of any person.")
rule S6304bViolenceOrThreat strict {
    for p: Person;
    for on: Date;
    when violence_or_threat_of_violence(p, on);
    then collection_conduct_prohibited(p, on);
}

@source(IRC_S6304_B, relation = formalizes, coverage = exact, quote = "The use of obscene or profane language or language the natural consequence of which is to abuse the hearer or reader.")
rule S6304bObsceneOrProfaneLanguage strict {
    for p: Person;
    for on: Date;
    when obscene_or_profane_language(p, on);
    then collection_conduct_prohibited(p, on);
}

@source(IRC_S6304_B, relation = formalizes, coverage = exact, quote = "Causing a telephone to ring or engaging any person in telephone conversation repeatedly or continuously with intent to annoy, abuse, or harass any person at the called number.")
rule S6304bRepeatedTelephoneHarassment strict {
    for p: Person;
    for on: Date;
    when repeated_telephone_harassment(p, on);
    then collection_conduct_prohibited(p, on);
}

@source(IRC_S6304_B, relation = formalizes, coverage = exact, quote = "Except as provided under rules similar to the rules in section 804 of the Fair Debt Collection Practices Act (15 U.S.C. 1692b), the placement of telephone calls without meaningful disclosure of the caller's identity.")
rule S6304bUndisclosedCallerIdentity defeasible {
    for p: Person;
    for on: Date;
    when telephone_call_without_identity_disclosure(p, on);
    then collection_conduct_prohibited(p, on);
    unless fdcpa_804_similar_rule_exception(p, on) and telephone_call_without_identity_disclosure(p, on);
}

// §6304(b) general standard (DECISION-0194 evaluative channel): a court
// determines, in a §7433 civil action, that conduct not covered by (1)-(4)
// nonetheless has the natural consequence of harassing, oppressing, or
// abusing — modelled as an adjudicated fact, not folded into the per-se list.
external judgment relation collection_conduct_judicially_found_abusive(p: Person, on: Date) {
    authority TaxCourt;
    label en unofficial "a court, in a §7433 civil action, has found that the Secretary's conduct on this occasion has the natural consequence of harassing, oppressing, or abusing the person, within the meaning of §6304(b)'s general standard";
}

@source(IRC_S6304_B, relation = formalizes, coverage = partial, quote = "The Secretary may not engage in any conduct the natural consequence of which is to harass, oppress, or abuse any person in connection with the collection of any unpaid tax.")
rule S6304bGeneralStandardJudiciallyFound strict {
    for p: Person;
    for on: Date;
    when collection_conduct_judicially_found_abusive(p, on);
    then collection_conduct_prohibited(p, on);
}

// §6304(c): pure cross-reference to the §7433 civil-action remedy —
// non_normative (recorded in coverage/collection.json, no rule here).
