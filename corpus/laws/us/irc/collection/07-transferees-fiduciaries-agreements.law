// §6901(a),(c) (transferee and fiduciary liability — chapter 71, procedure
// only: the liability itself remains the underlying tax's own liability,
// §6901 supplies the ASSESSMENT/COLLECTION mechanism and the limitations
// period), §6903 (notice of fiduciary relationship — the fiduciary's
// assumption of the taxpayer's powers/rights/duties, a power-substitution
// institutional effect, and its termination), §6905 (discharge of executor
// from personal liability), §7121 (closing agreements — the Secretary's
// power and its finality), §7122(a),(c),(d),(f) (compromises — the
// Secretary's/Attorney General's power, submission rules, evaluation
// standards, and the 24-month deemed-acceptance rule). STAGE 2 (agent F04,
// 25.09.2026).
//
// JUDGMENT CALLS (see report):
//  - §6901(a) does NOT create a new substantive liability; it says the
//    already-existing transferee/fiduciary liability "at law or in equity"
//    is assessed/collected the same way as the underlying tax. Modelled as
//    an institutional_effect (`transferee_liability_collectible_as_tax`)
//    that PRESUPPOSES the underlying liability (a case fact, `Money`, since
//    the actual "liability at law or in equity" computation is state/equity
//    law this package cannot execute — §6901(a)'s own text: "The amounts of
//    the following liabilities shall... be assessed, paid, and collected in
//    the same manner"). `pub transferee_liability` (this file) is the
//    procedural-collectibility relation the coordinator's assignment named;
//    it is NOT the same predicate as 06's `transferee_liability` name from
//    §6324(a)(2) — see the naming note below.
//  - NAMING CONFLICT: the assignment names `pub transferee_liability` as a
//    single deliverable, but two different statutes in this package's scope
//    use "transferee liability" for two different things: §6324(a)(2)'s
//    liability of a recipient of ESTATE-TAX gross-estate property (already
//    declared in 06-estate-gift-liens-redemption-proceeds.law as
//    `transferee_liability(p, decedent, value_at_death)`), and §6901's
//    general PROCEDURAL rule for collecting an already-established
//    transferee/fiduciary liability of ANY of the listed taxes the same way
//    as the underlying tax. Rather than collide two distinct three-arg
//    relations under one name, §6901's version is declared here as
//    `pub relation transferee_liability_collectible_as_tax(...)` and 06's
//    §6324(a)(2) relation keeps the exact name the assignment listed
//    (`transferee_liability`) since it is the one CREATING a liability
//    amount (closer to the ordinary reading of "the transferee's
//    liability"), flagged for the coordinator to confirm the intended
//    consumer-facing name is unambiguous — see report.
//  - §6901(c)'s period-of-limitations chain (initial transferee: 1 year
//    after the transferor's own assessment period expires; transferee of a
//    transferee: 1 year after the preceding transferee's period, capped at
//    3 years after the initial transferor's; the court-proceeding
//    "return of execution" branch) is modelled for the two named tiers
//    (initial transferee, fiduciary); the general N-th-transferee chain
//    beyond "transferee of a transferee" is not modelled generically (no
//    recursive transferee-chain type this package's ontology has) — flagged
//    TECH_GAP G464 (an unbounded chain, same construct class as the
//    running-accumulator TECH_GAPs).
//  - §6903's "assumes the powers, rights, duties, and privileges" is
//    modelled as an institutional_effect substituting the fiduciary as the
//    addressee of this package's OWN relations (duty/power holders) — not a
//    general capability to substitute into every OTHER package's relations,
//    which is outside a single package's closed surface. `fiduciary_notice_
//    in_effect` names the substitution; consuming packages must import and
//    apply it themselves (same pattern as any cross-package reference).
//  - §7122(c)(1)(B)(ii)'s "may be treated ... as a withdrawal" is a POWER
//    (Secretary's discretion), not an automatic institutional effect, since
//    the statute says "may... be treated", not "is".
//  - §7122(d)'s guideline-setting duty (d)(1)-(2)) and the taxpayer
//    protections of (d)(3)(A)-(C) are modelled as duties/immunities of the
//    Secretary/IRS officers running to the taxpayer; the guidelines'
//    CONTENT (the national/local expense schedules) is `EXTERNAL_DEPENDENCY`
//    (published administratively, not in the statute).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    IRC_S6901_A,
    IRC_S6901_B,
    IRC_S6901_C,
    IRC_S6901_D,
    IRC_S6901_E,
    IRC_S6901_F,
    IRC_S6901_G,
    IRC_S6901_H,
    IRC_S6902_A,
    IRC_S6902_B,
    IRC_S6903_A,
    IRC_S6905_A,
    IRC_S7121_A,
    IRC_S7122_A,
    IRC_S7122_C,
    IRC_S7122_D,
    IRC_S7122_F,
    Person,
    Secretary,
    transferee_liability,
};

// ============================================================================
// §6901(a) — Transferee/fiduciary liability: method of collection
// ============================================================================

enum TransfereeLiabilityKind {
    IncomeEstateOrGiftTaxTransferee;   // (a)(1)(A)
    FiduciaryUnder31USC3713b;          // (a)(1)(B)
    OtherTaxTransfereeOnLiquidationOrReorganization;  // (a)(2)
}

relation transferee_or_fiduciary_liability_exists(p: Person, underlying_taxpayer: Person, kind: TransfereeLiabilityKind, amount: Money) kind empirical {
    label en unofficial "case fact: the person has a liability at law or in equity as a transferee (of an income/estate/gift taxpayer) or as a fiduciary under 31 U.S.C. §3713(b), or (for other taxes) as a transferee on a liquidation or §368(a) reorganization — the liability's EXISTENCE and amount is a matter of law/equity outside this title, §6901(a) only supplies the collection mechanism";
}
pub relation transferee_liability_collectible_as_tax(p: Person, underlying_taxpayer: Person, kind: TransfereeLiabilityKind, amount: Money) kind institutional {
    label en unofficial "§6901(a): this transferee/fiduciary liability is assessed, paid, and collected in the same manner and subject to the same provisions and limitations as the underlying tax itself";
}
@source(IRC_S6901_A, relation = formalizes, coverage = partial, quote = "The amounts of the following liabilities shall, except as hereinafter in this section provided, be assessed, paid, and collected in the same manner and subject to the same provisions and limitations as in the case of the taxes with respect to which the liabilities were incurred")
rule S6901aCollectSameAsUnderlyingTax strict {
    for p: Person;
    for underlying_taxpayer: Person;
    for kind: TransfereeLiabilityKind;
    for amount: Money;
    when transferee_or_fiduciary_liability_exists(p, underlying_taxpayer, kind, amount);
    then transferee_liability_collectible_as_tax(p, underlying_taxpayer, kind, amount);
}

// ============================================================================
// §6901(c) — Period of limitations for assessment against a transferee/fiduciary
// ============================================================================

relation transferor_assessment_period_ends(underlying_taxpayer: Person, end: Date) kind empirical {
    label en unofficial "case fact / cross-package: the last day of the period of limitations for assessment against the transferor (or preceding transferee) — this package does not recompute that period here, it is supplied (e.g. from `us.irc.assessment`)";
}
relation is_initial_transferee_of(p: Person, underlying_taxpayer: Person) kind empirical {
    label en unofficial "case fact: the person is an initial transferee (§6901(c)(1)) of property of the underlying taxpayer";
}
pub relation transferee_assessment_period_ends(p: Person, underlying_taxpayer: Person, end: Date) kind institutional {
    label en unofficial "§6901(c)(1): the last day on which the initial transferee's liability may be assessed — 1 year after the expiration of the period of limitation for assessment against the transferor";
}
@source(IRC_S6901_C, relation = formalizes, coverage = exact, quote = "In the case of the liability of an initial transferee, within 1 year after the expiration of the period of limitation for assessment against the transferor")
rule S6901c1InitialTransfereePeriod strict {
    for p: Person;
    for underlying_taxpayer: Person;
    for transferor_end: Date;
    when is_initial_transferee_of(p, underlying_taxpayer) and transferor_assessment_period_ends(underlying_taxpayer, transferor_end);
    then transferee_assessment_period_ends(p, underlying_taxpayer, add_calendar_period(transferor_end, 1 calendar_year));
}

relation fiduciary_liability_arose_on(p: Person, on: Date) kind empirical;
relation tax_collection_period_ends(underlying_taxpayer: Person, end: Date) kind empirical {
    label en unofficial "case fact / cross-package: the last day of the period for collection of the underlying tax — §6901(c)(3)'s second, alternative deadline";
}
pub relation fiduciary_assessment_period_ends(p: Person, underlying_taxpayer: Person, end: Date) kind institutional {
    label en unofficial "§6901(c)(3): the later of (i) 1 year after the fiduciary's liability arose, or (ii) the expiration of the period for collection of the underlying tax";
}
@source(IRC_S6901_C, relation = formalizes, coverage = exact, quote = "In the case of the liability of a fiduciary, not later than 1 year after the liability arises or not later than the expiration of the period for collection of the tax in respect of which such liability arises, whichever is the later")
rule S6901c3FiduciaryPeriodOneYearBranch strict {
    for p: Person;
    for underlying_taxpayer: Person;
    for arose: Date;
    for collection_end: Date;
    when fiduciary_liability_arose_on(p, arose) and tax_collection_period_ends(underlying_taxpayer, collection_end) and add_calendar_period(arose, 1 calendar_year) >= collection_end;
    then fiduciary_assessment_period_ends(p, underlying_taxpayer, add_calendar_period(arose, 1 calendar_year));
}
rule S6901c3FiduciaryPeriodCollectionEndBranch strict {
    for p: Person;
    for underlying_taxpayer: Person;
    for arose: Date;
    for collection_end: Date;
    when fiduciary_liability_arose_on(p, arose) and tax_collection_period_ends(underlying_taxpayer, collection_end) and collection_end >= add_calendar_period(arose, 1 calendar_year);
    then fiduciary_assessment_period_ends(p, underlying_taxpayer, collection_end);
}

// ============================================================================
// §6901(b) — Liability (shown-on-return, deficiency, or underpayment)
// ============================================================================

enum TransfereeLiabilityBasis {
    AmountShownOnReturn;
    Deficiency;
    Underpayment;
}
pub relation transferee_liability_basis_covered(p: Person, underlying_taxpayer: Person, basis: TransfereeLiabilityBasis) kind institutional {
    label en unofficial "§6901(b): the (a) liability may be as to the amount of tax SHOWN ON A RETURN, or as to any DEFICIENCY, or as to any UNDERPAYMENT — all three bases are within §6901's collection mechanism, not only a deficiency";
}
relation transferee_liability_basis_asserted(p: Person, underlying_taxpayer: Person, basis: TransfereeLiabilityBasis) kind empirical;
@source(IRC_S6901_B, relation = formalizes, coverage = exact, quote = "Any liability referred to in subsection (a) may be either as to the amount of tax shown on a return or as to any deficiency or underpayment of any tax.")
rule S6901bLiabilityBasisCovered strict {
    for p: Person;
    for underlying_taxpayer: Person;
    for basis: TransfereeLiabilityBasis;
    when transferee_liability_basis_asserted(p, underlying_taxpayer, basis);
    then transferee_liability_basis_covered(p, underlying_taxpayer, basis);
}

// ============================================================================
// §6901(d) — Extension of the assessment period by agreement
// ============================================================================

relation transferee_assessment_extension_agreed(p: Person, underlying_taxpayer: Person, agreed_end: Date, before_expiration: Boolean) kind empirical {
    label en unofficial "case fact: before the §6901(c) period expired, the Secretary and the transferee/fiduciary both consented in writing to assessment after such time, until this agreed date — §6901(d)(1)'s exercise";
}
pub relation transferee_assessment_period_extended(p: Person, underlying_taxpayer: Person, agreed_end: Date) kind institutional {
    label en unofficial "§6901(d)(1): the liability may be assessed at any time prior to the expiration of the agreed-upon period";
}
@source(IRC_S6901_D, relation = formalizes, coverage = partial, quote = "the liability may be assessed at any time prior to the expiration of the period agreed upon")
rule S6901d1AssessmentPeriodExtendedByAgreement strict {
    for p: Person;
    for underlying_taxpayer: Person;
    for agreed_end: Date;
    when transferee_assessment_extension_agreed(p, underlying_taxpayer, agreed_end, true);
    then power AgreeToExtendTransfereeAssessmentPeriod {
        holder Secretary;
        exercise transferee_assessment_extension_agreed(p, underlying_taxpayer, agreed_end, true);
        valid_when transferee_assessment_extension_agreed(p, underlying_taxpayer, agreed_end, true);
        effect transferee_assessment_period_extended(p, underlying_taxpayer, agreed_end);
    };
}
// §6901(d)(2)'s knock-on adjustment to the §6511(c) credit-or-refund period
// when the agreement is executed after the taxpayer's own assessment period
// expired is a cross-reference into `us.irc.payment_refunds_interest`'s
// §6511 machinery (not imported here) — recorded TECH_GAP, not modelled.

// ============================================================================
// §6901(e) — Period for assessment against a deceased/terminated transferor
// ============================================================================

pub relation transferor_death_or_termination_does_not_shorten_period(underlying_taxpayer: Person) kind institutional {
    label en unofficial "§6901(e): if the transferor is deceased, or a corporation that has terminated its existence, the period of limitation for assessment against it is the period that would be in effect had death/termination not occurred";
}
relation transferor_deceased_or_terminated(underlying_taxpayer: Person) kind empirical;
@source(IRC_S6901_E, relation = formalizes, coverage = exact, quote = "the period of limitation for assessment against such person shall be the period that would be in effect had death or termination of existence not occurred")
rule S6901eDeathOrTerminationDoesNotShortenPeriod strict {
    for underlying_taxpayer: Person;
    when transferor_deceased_or_terminated(underlying_taxpayer);
    then transferor_death_or_termination_does_not_shorten_period(underlying_taxpayer);
}

// ============================================================================
// §6901(f) — Suspension of the period of limitations
// ============================================================================

relation section_6212_notice_mailed_to_transferee_on(p: Person, on: Date) kind empirical {
    label en unofficial "case fact: the §6212 deficiency notice was mailed to the transferee/fiduciary — §6901(f)'s own trigger";
}
relation secretary_prohibited_from_assessing_transferee_until(p: Person, until: Date) kind empirical {
    label en unofficial "case fact / cross-package: the date until which the Secretary is prohibited from assessing the transferee's liability (e.g. a Tax Court petition period) — this package does not recompute that prohibition, it is supplied";
}
pub relation transferee_period_suspended_until(p: Person, mailed_on: Date, suspended_until: Date) kind institutional {
    label en unofficial "§6901(f): the running of the assessment period is suspended from the §6212 notice mailing until the prohibition ends, plus 60 days";
}
@source(IRC_S6901_F, relation = formalizes, coverage = partial, quote = "be suspended for the period during which the Secretary is prohibited from making the assessment in respect of the liability of the transferee or fiduciary")
rule S6901fSuspensionUntilProhibitionEndsPlusSixtyDays strict {
    for p: Person;
    for mailed_on: Date;
    for prohibited_until: Date;
    when section_6212_notice_mailed_to_transferee_on(p, mailed_on) and secretary_prohibited_from_assessing_transferee_until(p, prohibited_until);
    then transferee_period_suspended_until(p, mailed_on, add_calendar_period(prohibited_until, 60 calendar_day));
}

// ============================================================================
// §6901(g) — Address for notice of liability
// ============================================================================

relation notice_of_liability_mailed_to_last_known_address(p: Person, address_known: Boolean) kind empirical {
    label en unofficial "case fact: the §6901 notice of liability was mailed to the person subject to the liability at their last known address";
}
relation fiduciary_notice_absent(p: Person) kind empirical {
    label en unofficial "case fact: the Secretary had NOT received §6903 notice of a fiduciary relationship for this person — §6901(g)'s own precondition";
}
pub relation notice_of_liability_sufficient_despite_incapacity(p: Person) kind institutional {
    label en unofficial "§6901(g): absent §6903 fiduciary notice, mailing to the last known address is sufficient even if the person is deceased, under legal disability, or (for a corporation) has terminated its existence";
}
@source(IRC_S6901_G, relation = formalizes, coverage = partial, quote = "any notice of liability enforceable under this section required to be mailed to such person, shall, if mailed to the person subject to the liability at his last known address, be sufficient for purposes of this title, even if such person is deceased, or is under a legal disability")
rule S6901gLastKnownAddressSufficient strict {
    for p: Person;
    when notice_of_liability_mailed_to_last_known_address(p, true) and fiduciary_notice_absent(p);
    then notice_of_liability_sufficient_despite_incapacity(p);
}

// ============================================================================
// §6901(h) — Definition of transferee
// ============================================================================

pub relation transferee_definition_includes(p: Person) kind institutional {
    label en unofficial "§6901(h): 'transferee' includes donee, heir, legatee, devisee, and distributee, and (for estate taxes) any person personally liable under §6324(a)(2)";
}
relation is_donee_heir_legatee_devisee_or_distributee(p: Person) kind empirical;
@source(IRC_S6901_H, relation = formalizes, coverage = partial, quote = "the term \"transferee\" includes donee, heir, legatee, devisee, and distributee")
rule S6901hTransfereeIncludesEnumeratedCategories strict {
    for p: Person;
    when is_donee_heir_legatee_devisee_or_distributee(p);
    then transferee_definition_includes(p);
}
@source(IRC_S6901_H, relation = formalizes, coverage = exact, quote = "with respect to estate taxes, also includes any person who, under section 6324(a)(2), is personally liable for any part of such tax")
rule S6901hTransfereeIncludes6324a2Liable strict {
    for p: Person;
    for decedent: Person;
    for value_at_death: Money;
    when transferee_liability(p, decedent, value_at_death);
    then transferee_definition_includes(p);
}

// §6901(i) is a pure cross-reference to §7508 (combat-zone time extensions,
// owned by `us.irc.administration`, not imported here) — NON_NORMATIVE, no
// independent rule.

// ============================================================================
// §6902 — Burden of proof and evidence in Tax Court transferee proceedings
// ============================================================================

relation tax_court_transferee_proceeding(petitioner: Person, underlying_taxpayer: Person) kind empirical {
    label en unofficial "case fact: a Tax Court proceeding is pending in which the petitioner's liability AS A TRANSFEREE of the taxpayer's property is at issue — §6902(a)'s own scope";
}
pub relation transferee_status_burden_on_secretary(petitioner: Person, underlying_taxpayer: Person) kind institutional {
    label en unofficial "§6902(a): in the Tax Court proceeding, the burden of proof is on the Secretary to show the petitioner is liable AS A TRANSFEREE of the taxpayer's property — but NOT to show the taxpayer was liable for the tax (that burden stays where it otherwise lies)";
}
@source(IRC_S6902_A, relation = formalizes, coverage = exact, quote = "the burden of proof shall be upon the Secretary to show that a petitioner is liable as a transferee of property of a taxpayer, but not to show that the taxpayer was liable for the tax")
rule S6902aBurdenOnSecretaryForTransfereeStatus strict {
    for petitioner: Person;
    for underlying_taxpayer: Person;
    when tax_court_transferee_proceeding(petitioner, underlying_taxpayer);
    then transferee_status_burden_on_secretary(petitioner, underlying_taxpayer);
}

relation transferee_preliminary_examination_requested(petitioner: Person, underlying_taxpayer: Person) kind empirical {
    label en unofficial "case fact: the transferee-petitioner applied to the Tax Court for a preliminary examination of the taxpayer's (or a preceding transferee's) books/records — §6902(b)'s exercise";
}
pub relation preliminary_examination_entitlement(petitioner: Person, underlying_taxpayer: Person) kind institutional {
    label en unofficial "§6902(b): a transferee-petitioner is entitled, under Tax Court rules, to a preliminary examination of the taxpayer's or preceding transferee's books, papers, documents, correspondence, and other evidence";
}
@source(IRC_S6902_B, relation = formalizes, coverage = partial, quote = "a transferee of property of a taxpayer shall be entitled, under rules prescribed by the Tax Court, to a preliminary examination of books, papers, documents, correspondence, and other evidence of the taxpayer or a preceding transferee of the taxpayer's property")
rule S6902bPreliminaryExaminationPower strict {
    for petitioner: Person;
    for underlying_taxpayer: Person;
    when tax_court_transferee_proceeding(petitioner, underlying_taxpayer) and transferee_preliminary_examination_requested(petitioner, underlying_taxpayer);
    then power RequestPreliminaryExamination {
        holder petitioner;
        exercise transferee_preliminary_examination_requested(petitioner, underlying_taxpayer);
        valid_when tax_court_transferee_proceeding(petitioner, underlying_taxpayer);
        effect preliminary_examination_entitlement(petitioner, underlying_taxpayer);
    };
}
// §6902(b)'s subpoena mechanics (the Tax Court's own power to compel
// production) are `NON_NORMATIVE` from this package's perspective — a
// judicial-procedure detail of the Tax Court, not a collection norm this
// package's closed surface executes.

// ============================================================================
// §6903 — Notice of fiduciary relationship
// ============================================================================

pub relation fiduciary_notice_given(fiduciary: Person, on_behalf_of: Person, on: Date) kind empirical {
    label en unofficial "case fact: notice was given to the Secretary, in the manner prescribed by regulations (§6903(b)), that the fiduciary is acting for another person in a fiduciary capacity";
}
relation fiduciary_notice_terminated_on(fiduciary: Person, on_behalf_of: Person, on: Date) kind empirical;
relation fiduciary_status_checked_on(fiduciary: Person, on_behalf_of: Person, on: Date) kind empirical {
    label en unofficial "case fact: the date §6903(a)'s fiduciary substitution is being checked as of";
}
pub relation fiduciary_notice_in_effect(fiduciary: Person, on_behalf_of: Person, on: Date) kind institutional {
    label en unofficial "§6903(a): the fiduciary has assumed the powers, rights, duties, and privileges of the person for whom it acts, in respect of any title 26 tax (except as otherwise specifically provided, and except that the tax is still collected from that other person's estate), from the date notice was given until notice of termination is given";
}
@source(IRC_S6903_A, relation = formalizes, coverage = exact, quote = "such fiduciary shall assume the powers, rights, duties, and privileges of such other person in respect of a tax imposed by this title")
rule S6903aFiduciarySubstitutionInEffect defeasible {
    for fiduciary: Person;
    for on_behalf_of: Person;
    for given_on: Date;
    for checked_on: Date;
    when fiduciary_notice_given(fiduciary, on_behalf_of, given_on) and fiduciary_status_checked_on(fiduciary, on_behalf_of, checked_on) and checked_on >= given_on;
    then fiduciary_notice_in_effect(fiduciary, on_behalf_of, checked_on);
    unless fiduciary_notice_terminated_on(fiduciary, on_behalf_of, checked_on) and fiduciary_notice_given(fiduciary, on_behalf_of, given_on) and fiduciary_status_checked_on(fiduciary, on_behalf_of, checked_on) and checked_on >= given_on;
}

// ============================================================================
// §6905 — Discharge of executor from personal liability
// ============================================================================

pub relation executor_discharge_application_filed(executor: Person, decedent: Person, filed_on: Date) kind empirical {
    label en unofficial "§6905(a): the executor made written application, after the subtitle A / chapter 12 return was made and filed, for release from personal liability for those taxes";
}
relation secretary_notified_amount_on(executor: Person, decedent: Person, on: Date) kind empirical {
    label en unofficial "case fact: the Secretary notified the executor of the amount of the taxes (§6905(a) first sentence's discretionary notification)";
}
relation executor_paid_notified_amount_on(executor: Person, decedent: Person, on: Date) kind empirical;
pub relation executor_discharge_nine_month_deadline(executor: Person, decedent: Person, filed_on: Date, deadline: Date) kind institutional {
    label en unofficial "§6905(a): if the Secretary does not notify the executor of the amount by this date, the executor is discharged 9 months after the application was received — the alternative (no-notification) branch's own deadline";
}
@source(IRC_S6905_A, relation = formalizes, coverage = partial, quote = "9 months after receipt of the application if no notification is made by the Secretary before such date")
rule S6905aNineMonthDeadline strict {
    for executor: Person;
    for decedent: Person;
    for filed_on: Date;
    when executor_discharge_application_filed(executor, decedent, filed_on);
    then executor_discharge_nine_month_deadline(executor, decedent, filed_on, add_calendar_period(filed_on, 9 calendar_month));
}
pub relation executor_discharged_from_personal_liability(executor: Person, decedent: Person) kind institutional {
    label en unofficial "§6905(a): the executor is discharged from personal liability for any deficiency thereafter found due, and is entitled to a receipt or writing showing the discharge — reached either by paying the amount the Secretary notified, or (if no notification) by the 9-month deadline passing unnotified";
}
@source(IRC_S6905_A, relation = formalizes, coverage = partial, quote = "upon payment of the amount of which he is notified")
rule S6905aDischargeOnPayment strict {
    for executor: Person;
    for decedent: Person;
    for notified_on: Date;
    for paid_on: Date;
    when secretary_notified_amount_on(executor, decedent, notified_on) and executor_paid_notified_amount_on(executor, decedent, paid_on) and paid_on >= notified_on;
    then executor_discharged_from_personal_liability(executor, decedent);
}
relation checked_after_nine_month_deadline(executor: Person, decedent: Person, checked_on: Date) kind empirical {
    label en unofficial "case fact: the date discharge is being checked as of, for the no-notification branch";
}
@source(IRC_S6905_A, relation = formalizes, coverage = partial, quote = "or 9 months after receipt of the application if no notification is made by the Secretary before such date, shall be discharged from personal liability")
rule S6905aDischargeOnNineMonthLapse defeasible {
    for executor: Person;
    for decedent: Person;
    for filed_on: Date;
    for deadline: Date;
    for checked_on: Date;
    when executor_discharge_nine_month_deadline(executor, decedent, filed_on, deadline) and checked_after_nine_month_deadline(executor, decedent, checked_on) and checked_on >= deadline;
    then executor_discharged_from_personal_liability(executor, decedent);
    unless secretary_notified_amount_on(executor, decedent, deadline) and executor_discharge_nine_month_deadline(executor, decedent, filed_on, deadline) and checked_after_nine_month_deadline(executor, decedent, checked_on) and checked_on >= deadline;
}

// ============================================================================
// §7121 — Closing agreements
// ============================================================================

relation closing_agreement_signed(agreement_holder: Person, on: Date) kind empirical {
    label en unofficial "case fact: the Secretary entered into a written agreement with the person (or the person or estate for whom they act) relating to that person's liability for an internal revenue tax for a taxable period — §7121(a)'s exercise";
}
relation closing_agreement_approved_by_secretary(agreement_holder: Person) kind empirical {
    label en unofficial "case fact: the agreement was approved by the Secretary within the time stated in it (or later agreed) — §7121(b)'s own validity condition";
}
@source(IRC_S7121_A, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to enter into an agreement in writing with any person relating to the liability of such person")
rule S7121aClosingAgreementPower strict {
    for agreement_holder: Person;
    for on: Date;
    when closing_agreement_signed(agreement_holder, on);
    then power EnterClosingAgreement {
        holder Secretary;
        exercise closing_agreement_signed(agreement_holder, on);
        valid_when closing_agreement_approved_by_secretary(agreement_holder);
        effect closing_agreement_final(agreement_holder);
    };
}
pub relation closing_agreement_final(agreement_holder: Person) kind institutional {
    label en unofficial "§7121(b): the approved closing agreement is final and conclusive — the case may not be reopened nor the agreement modified, and no determination/assessment/collection/payment/abatement/refund/credit made under it may be annulled, modified, set aside, or disregarded";
}
relation closing_agreement_fraud_or_malfeasance_shown(agreement_holder: Person) kind empirical {
    label en unofficial "case fact: fraud, malfeasance, or misrepresentation of a material fact has been shown — §7121(b)'s own exception to finality";
}
pub relation closing_agreement_finality_defeated_by_fraud(agreement_holder: Person) kind institutional {
    label en unofficial "§7121(b)'s finality does not protect an agreement procured by fraud, malfeasance, or misrepresentation of a material fact";
}
rule S7121bFinalityDefeatedByFraud strict {
    for agreement_holder: Person;
    when closing_agreement_fraud_or_malfeasance_shown(agreement_holder);
    then closing_agreement_finality_defeated_by_fraud(agreement_holder);
}

// ============================================================================
// §7122(a) — Authorization to compromise
// ============================================================================

enum CompromiseAuthority {
    SecretaryBeforeDOJReferral;
    AttorneyGeneralAfterDOJReferral;
}
relation compromise_offer_made(p: Person, authority: CompromiseAuthority, referred_to_doj: Boolean) kind empirical;
pub relation compromise_authority_available(p: Person, authority: CompromiseAuthority) kind institutional {
    label en unofficial "§7122(a): the Secretary may compromise any civil or criminal case arising under the internal revenue laws prior to referral to the Department of Justice for prosecution or defense; the Attorney General (or delegate) may compromise it after referral";
}
@source(IRC_S7122_A, relation = formalizes, coverage = exact, quote = "The Secretary may compromise any civil or criminal case arising under the internal revenue laws prior to reference to the Department of Justice for prosecution or defense")
rule S7122aSecretaryAuthorityBeforeReferral strict {
    for p: Person;
    when compromise_offer_made(p, SecretaryBeforeDOJReferral, false);
    then compromise_authority_available(p, SecretaryBeforeDOJReferral);
}
@source(IRC_S7122_A, relation = formalizes, coverage = exact, quote = "the Attorney General or his delegate may compromise any such case after reference to the Department of Justice for prosecution or defense")
rule S7122aAttorneyGeneralAuthorityAfterReferral strict {
    for p: Person;
    when compromise_offer_made(p, AttorneyGeneralAfterDOJReferral, true);
    then compromise_authority_available(p, AttorneyGeneralAfterDOJReferral);
}

// ============================================================================
// §7122(c) — Rules for submission of offers-in-compromise
// ============================================================================

enum OfferInCompromiseForm {
    LumpSum;       // 5 or fewer installments, (c)(1)(A)
    Periodic;      // (c)(1)(B)
}
relation offer_in_compromise_amount(p: Person, form: OfferInCompromiseForm, total_amount: Money) kind empirical;
relation offer_low_income_exception_applies(p: Person) kind empirical {
    label en unofficial "case fact: the taxpayer is an individual whose adjusted gross income for the most recent available taxable year does not exceed 250 percent of the applicable poverty level — §7122(c)(3), a SOURCE_GAP for the poverty-level figure itself (Secretary-determined, not in the statute)";
}
relation offer_partial_payment_waived(p: Person) kind empirical {
    label en unofficial "case fact: the Secretary waived the §7122(c)(1) payment requirement by regulation — §7122(c)(2)(C)";
}
pub relation offer_partial_payment_required(p: Person, form: OfferInCompromiseForm) kind institutional {
    label en unofficial "§7122(c)(1): a lump-sum or periodic-payment offer-in-compromise must be accompanied by a partial payment on submission, unless the low-income exception or a waiver applies";
}
@source(IRC_S7122_C, relation = formalizes, coverage = exact, quote = "The submission of any lump-sum offer-in-compromise shall be accompanied by the payment of 20 percent of the amount of such offer.")
rule S7122c1LumpSumPartialPaymentRequired defeasible {
    for p: Person;
    for total_amount: Money;
    when offer_in_compromise_amount(p, LumpSum, total_amount);
    then offer_partial_payment_required(p, LumpSum);
    unless offer_low_income_exception_applies(p) and offer_in_compromise_amount(p, LumpSum, total_amount);
    unless offer_partial_payment_waived(p) and offer_in_compromise_amount(p, LumpSum, total_amount);
}
@source(IRC_S7122_C, relation = formalizes, coverage = exact, quote = "The submission of any periodic payment offer-in-compromise shall be accompanied by the payment of the amount of the first proposed installment.")
rule S7122c1PeriodicPartialPaymentRequired defeasible {
    for p: Person;
    for total_amount: Money;
    when offer_in_compromise_amount(p, Periodic, total_amount);
    then offer_partial_payment_required(p, Periodic);
    unless offer_low_income_exception_applies(p) and offer_in_compromise_amount(p, Periodic, total_amount);
    unless offer_partial_payment_waived(p) and offer_in_compromise_amount(p, Periodic, total_amount);
}
pub relation required_lump_sum_partial_payment_amount(p: Person, total_amount: Money, required: Money) kind institutional {
    label en unofficial "§7122(c)(1)(A)(i)'s exact figure: 20 percent of the lump-sum offer amount";
}
rule S7122c1LumpSumTwentyPercentAmount strict {
    for p: Person;
    for total_amount: Money;
    when offer_in_compromise_amount(p, LumpSum, total_amount);
    then required_lump_sum_partial_payment_amount(p, total_amount, round(total_amount * 0.20, 2, "HALF_UP"));
}

relation installment_missed_during_pendency(p: Person, installment_number: Integer) kind empirical {
    label en unofficial "case fact: an installment other than the first, due under a periodic offer-in-compromise, was not made while the offer was pending evaluation — §7122(c)(1)(B)(ii)'s own condition";
}
pub relation offer_treated_as_withdrawn(p: Person) kind institutional {
    label en unofficial "§7122(c)(1)(B)(ii): the Secretary may treat the missed installment as a withdrawal of the offer-in-compromise — a power of the Secretary's own discretion, not an automatic consequence";
}
@source(IRC_S7122_C, relation = formalizes, coverage = exact, quote = "Any failure to make an installment (other than the first installment) due under such offer-in-compromise during the period such offer is being evaluated by the Secretary may be treated by the Secretary as a withdrawal of such offer-in-compromise.")
rule S7122c1TreatMissedInstallmentAsWithdrawalPower strict {
    for p: Person;
    for installment_number: Integer;
    when installment_missed_during_pendency(p, installment_number);
    then power TreatOfferAsWithdrawn {
        holder Secretary;
        exercise installment_missed_during_pendency(p, installment_number);
        valid_when installment_missed_during_pendency(p, installment_number);
        effect offer_treated_as_withdrawn(p);
    };
}

// ============================================================================
// §7122(d) — Standards for evaluation of offers
// ============================================================================

relation irs_guidelines_for_offer_evaluation_exist(has_guidelines: Boolean) kind empirical {
    label en unofficial "§7122(d)(1)-(2): the Secretary's guidelines for evaluating offers-in-compromise, and the national/local basic-living-expense allowance schedules — administratively prescribed and published, not stated in the statute (EXTERNAL_DEPENDENCY; no rule concludes from this fact, it documents the dependency for the coverage row)";
}
relation offer_from_low_income_taxpayer(p: Person) kind empirical;
pub relation offer_rejection_solely_on_amount_prohibited(p: Person) kind institutional {
    label en unofficial "§7122(d)(3)(A): an IRS officer or employee shall not reject a low-income taxpayer's offer-in-compromise solely on the basis of the amount offered";
}
@source(IRC_S7122_D, relation = formalizes, coverage = exact, quote = "an officer or employee of the Internal Revenue Service shall not reject an offer-in-compromise from a low-income taxpayer solely on the basis of the amount of the offer")
rule S7122d3ANoRejectionSolelyOnAmount strict {
    for p: Person;
    when offer_from_low_income_taxpayer(p);
    then prohibition NoRejectSolelyOnAmount {
        bearer Secretary;
        action offer_rejection_solely_on_amount_prohibited(p);
        window [-infinity, infinity];
    };
}
relation offer_relates_only_to_liability_issues(p: Person) kind empirical;
pub relation liability_only_offer_financial_statement_not_required(p: Person) kind institutional {
    label en unofficial "§7122(d)(3)(B)(ii): where the offer relates only to issues of liability, the taxpayer is not required to provide a financial statement";
}
@source(IRC_S7122_D, relation = formalizes, coverage = exact, quote = "the taxpayer shall not be required to provide a financial statement")
rule S7122d3BiiNoFinancialStatementRequired strict {
    for p: Person;
    when offer_relates_only_to_liability_issues(p);
    then liability_only_offer_financial_statement_not_required(p);
}

// ============================================================================
// §7122(f) — Deemed acceptance of offer not rejected within 24 months
// ============================================================================

relation offer_submitted_on(p: Person, on: Date) kind empirical;
relation offer_rejected_on(p: Person, on: Date) kind empirical;
relation offer_disputed_in_judicial_proceeding_days(p: Person, tolled_days: Integer) kind empirical {
    label en unofficial "case fact: the total number of days, within the 24-month window, during which the tax liability that is the subject of the offer was in dispute in a judicial proceeding — excluded from the 24-month count by §7122(f)'s second sentence. This package does NOT itself extend a Date by a variable day count derived from a fact (only literal day counts are supported by `add_calendar_period`, see AGENT-BRIEF); the untolled 24-month deadline is computed below, and a case with tolled days must supply the correspondingly adjusted deadline as its own fact for `offer_deemed_accepted_deadline_extended` (TECH_GAP G465: no variable-length calendar-period primitive)";
}
pub relation offer_deemed_accepted_deadline(p: Person, submitted_on: Date, deadline: Date) kind institutional {
    label en unofficial "§7122(f): the untolled 24-month deadline — the date which is 24 months after the offer was submitted, absent any judicial-proceeding tolling";
}
@source(IRC_S7122_F, relation = formalizes, coverage = partial, quote = "Any offer-in-compromise submitted under this section shall be deemed to be accepted by the Secretary if such offer is not rejected by the Secretary before the date which is 24 months after the date of the submission of such offer.")
rule S7122fDeemedAcceptedDeadline strict {
    for p: Person;
    for submitted_on: Date;
    when offer_submitted_on(p, submitted_on);
    then offer_deemed_accepted_deadline(p, submitted_on, add_calendar_period(submitted_on, 24 calendar_month));
}
pub relation offer_deemed_accepted(p: Person) kind institutional {
    label en unofficial "§7122(f): the offer-in-compromise is deemed accepted by the Secretary because it was not rejected before the (possibly tolled) 24-month deadline";
}
relation offer_deadline_checked_on(p: Person, checked_on: Date) kind empirical {
    label en unofficial "case fact: the date §7122(f)'s deemed-acceptance is being checked as of";
}
rule S7122fDeemedAcceptedNoRejection defeasible {
    for p: Person;
    for submitted_on: Date;
    for deadline: Date;
    for checked_on: Date;
    when offer_deemed_accepted_deadline(p, submitted_on, deadline) and offer_deadline_checked_on(p, checked_on) and checked_on >= deadline;
    then offer_deemed_accepted(p);
    unless offer_rejected_on(p, checked_on) and offer_deemed_accepted_deadline(p, submitted_on, deadline) and offer_deadline_checked_on(p, checked_on) and checked_on >= deadline;
}
pub relation offer_in_compromise_accepted(p: Person) kind institutional {
    label en unofficial "the offer-in-compromise has been accepted — either by an affirmative acceptance the case asserts directly (this package models no separate affirmative-acceptance rule: §7122 nowhere states an acceptance PROCEDURE, only the authority to compromise (a) and the deemed-acceptance backstop (f)) or by §7122(f)'s deemed acceptance";
}
relation offer_affirmatively_accepted(p: Person) kind empirical {
    label en unofficial "case fact: the Secretary (or, post-referral, the Attorney General/delegate) affirmatively accepted the offer — §7122 states the AUTHORITY to compromise, not a separate acceptance formality, so this is asserted directly rather than derived from a documented procedure";
}
rule S7122OfferAcceptedAffirmatively strict {
    for p: Person;
    when offer_affirmatively_accepted(p);
    then offer_in_compromise_accepted(p);
}
// `offer_in_compromise_accepted` cannot be derived from bare
// `offer_deemed_accepted` (LDC-E4103: strict consumption of a defeasible
// producer's bare status is not supported in 0.1) — restated as its own
// defeasible rule with the identical condition/defeater instead of chaining
// through the pub `offer_deemed_accepted` relation.
rule S7122fOfferAcceptedByDeeming defeasible {
    for p: Person;
    for submitted_on: Date;
    for deadline: Date;
    for checked_on: Date;
    when offer_deemed_accepted_deadline(p, submitted_on, deadline) and offer_deadline_checked_on(p, checked_on) and checked_on >= deadline;
    then offer_in_compromise_accepted(p);
    unless offer_rejected_on(p, checked_on) and offer_deemed_accepted_deadline(p, submitted_on, deadline) and offer_deadline_checked_on(p, checked_on) and checked_on >= deadline;
}
