// 26 U.S.C. §§6302(a),(d)-(f); 6305; 6306(f)-(j); 6307; 6311(e); 6313; 6315-6317;
// 7001(a) — collection remainder (stage 2c). Stage 2b of 26.09.2026 continues
// stage 2b of 25.09.2026. Status: implemented_unverified.
//
// SCOPE.
//  - §6302(a): delegation to regulations — EXTERNAL_DEPENDENCY contract.
//  - §6302(d): recreational-equipment excise tax due on the return date.
//  - §6302(e)(2), (f): the September deposit dates with the electronic-funds
//    transfer / non-EFT substitution and the Saturday/Sunday adjustment. The
//    language has no weekday primitive: whether a date is a Saturday or a
//    Sunday is a case fact (TECH_GAP G3721). §6302(e)(1) (the 3rd business day
//    after the close of the first week of the 2nd following semimonthly
//    period) needs a legal-holiday calendar and a semimonthly-week structure
//    the package does not build (TECH_GAP G3720).
//  - §6305: child-support collection certified by HHS: the duty to assess and
//    collect, the five modifications (a)(1)-(5) and the bar on court review (b).
//  - §6306(f)-(j): no United States liability for contractor acts, FDCPA,
//    the annual report; §6307: the special compliance personnel account, its
//    three restrictions, the annual report and the definitions.
//  - §6311(e): confidentiality of credit and debit card information.
//  - §6313 (fractional cents), §6315, §6317 (payments on account), §6316
//    (foreign currency: Secretary's discretion by regulations), §7001(a)
//    (license of foreign-coupon collectors).
//
// Pub. L. 119-64 §2(b) (approved 2025-12-26): §6303(b)(2) — the last date
// prescribed for payment is determined after taking into account any period
// disregarded under §7508A, for notices issued after enactment. See the end of
// this module; the §6303(b) rule of module 01 reads the effective date.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    ExemptPropertyKind,
    IRC_S6302_D,
    IRC_S6302_E,
    IRC_S6302_F,
    IRC_S6305_A,
    IRC_S6305_B,
    IRC_S6306_F,
    IRC_S6306_G,
    IRC_S6306_J,
    IRC_S6307_A,
    IRC_S6307_B,
    IRC_S6307_C,
    Individual,
    Organ,
    Person,
    Secretary,
    TaxableYear,
    collection_contract_fees_retained,
    qualified_tax_collection_contract,
};

// ============================================================================
// §6302(a) — Establishment by regulations
// ============================================================================

pub relation regulation_establishes_collection_mode_or_time(k: us.irc.core::TaxKind, effectiveFrom: Date) kind institutional {
    label en unofficial "a regulation issued under section 6302(a) establishes the mode or time for collecting a kind of tax that the title does not otherwise provide for (content not pinned in this package)";
}

// ============================================================================
// §6302(d) — Recreational equipment excise tax
// ============================================================================

pub relation recreational_equipment_tax_return_date(p: Person, y: TaxableYear, returnDate: Date) kind empirical {
    label en official "the date for filing the return for the taxes imposed by subchapter D of chapter 32 (taxes on recreational equipment)";
}
pub relation recreational_equipment_tax_due_and_payable(p: Person, y: TaxableYear, dueOn: Date) kind institutional {
    label en official "the taxes imposed by subchapter D of chapter 32 shall be due and payable on the date for filing the return for such taxes";
}
@source(IRC_S6302_D, relation = formalizes, coverage = exact, quote = "shall be due and payable on the date for filing the return for such taxes")
rule S6302dRecreationalEquipmentTaxDueOnReturnDate defeasible {
    label en official "the recreational equipment tax is due and payable on the return filing date";
    for p: Person;
    for y: TaxableYear;
    for returnDate: Date;
    when recreational_equipment_tax_return_date(p, y, returnDate);
    then recreational_equipment_tax_due_and_payable(p, y, returnDate);
}

// ============================================================================
// §6302(e)(2), (f) — Deposit dates in September
// ============================================================================

pub enum DepositTaxFamily {
    CommunicationsAndAirTravel;   // sections 4251, 4261, 4271
    SubtitleDExcise;              // taxes under subtitle D, section 6302(f)(1)
    OzoneDepletingChemicals;      // subchapter D of chapter 38, section 6302(f)(2)
    label en unofficial "the family of tax a semimonthly deposit relates to: communications and air travel taxes (sections 4251, 4261, 4271), other subtitle D excise taxes, or ozone-depleting chemicals taxes";
}
pub enum DepositPeriod {
    SecondSemimonthlyPeriodOfAugust;
    SeptemberFirstToEleventh;
    SeptemberSixteenToTwentySix;
    label en unofficial "the semimonthly period a deposit relates to (bills rendered or tickets sold, or amounts considered collected, in the period)";
}
pub relation deposit_for_period(p: Person, family: DepositTaxFamily, period: DepositPeriod, y: TaxableYear) kind empirical {
    label en official "the person is required to make deposits of the tax with respect to semimonthly periods, for amounts of the given period of the calendar year";
}
pub relation deposit_required_by_electronic_funds_transfer(p: Person) kind empirical {
    label en official "the deposits are required to be made by electronic funds transfer";
}
pub relation date_is_saturday(d: Date) kind empirical {
    label en unofficial "the date falls on a Saturday (a calendar fact: the language has no weekday primitive, TECH_GAP G3721)";
}
pub relation date_is_sunday(d: Date) kind empirical {
    label en unofficial "the date falls on a Sunday (a calendar fact: the language has no weekday primitive, TECH_GAP G3721)";
}
pub relation september_rule_covers(family: DepositTaxFamily, period: DepositPeriod) kind institutional {
    label en unofficial "the (e)(2)(A), (f)(1) or (f)(2) September rule names this family and period";
}
@source(IRC_S6302_E, relation = formalizes, coverage = exact, quote = "the amount of such tax included in bills rendered or tickets sold during the period beginning on September 1 and ending on September 11 shall be deposited not later than September 29")
rule S6302e2ACommunicationsSeptemberFirstEleven strict { then september_rule_covers(CommunicationsAndAirTravel, SeptemberFirstToEleventh); }
@source(IRC_S6302_F, relation = formalizes, coverage = exact, quote = "such person shall make deposits of such taxes for the period beginning on September 16 and ending on September 26 not later than September 29")
rule S6302f1SubtitleDSeptemberSixteenToTwentySix strict { then september_rule_covers(SubtitleDExcise, SeptemberSixteenToTwentySix); }
@source(IRC_S6302_F, relation = formalizes, coverage = exact, quote = "(A) the second semimonthly period in August, and")
rule S6302f2OzoneAugustSecondPeriod strict { then september_rule_covers(OzoneDepletingChemicals, SecondSemimonthlyPeriodOfAugust); }
@source(IRC_S6302_F, relation = formalizes, coverage = exact, quote = "(B) the period beginning on September 1 and ending on September 11,")
rule S6302f2OzoneSeptemberFirstEleven strict { then september_rule_covers(OzoneDepletingChemicals, SeptemberFirstToEleventh); }
pub relation deposit_nominal_due_date(p: Person, family: DepositTaxFamily, period: DepositPeriod, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "the September 29 (September 28 when not required to use electronic funds transfer) due date before the Saturday/Sunday adjustment";
}
@source(IRC_S6302_E, relation = formalizes, coverage = exact, quote = "shall be deposited not later than September 29")
rule S6302September29ForElectronicDeposits defeasible {
    label en official "deposits required by electronic funds transfer are due not later than September 29 (calendar year y: 1 January + 8 months + 28 days)";
    for p: Person;
    for family: DepositTaxFamily;
    for period: DepositPeriod;
    for y: TaxableYear;
    for n: Integer;
    for beginsOn: Date;
    when deposit_for_period(p, family, period, y)
        and september_rule_covers(family, period)
        and deposit_required_by_electronic_funds_transfer(p)
        and us.irc.core::calendar_year_of(y, n)
        and us.irc.core::begins(y, beginsOn);
    then deposit_nominal_due_date(p, family, period, y,
        add_calendar_period(add_calendar_period(beginsOn, 8 calendar_month), 28 calendar_day));
}
@source(IRC_S6302_E, relation = formalizes, coverage = exact, quote = "subparagraphs (A) and (B) shall be applied by substituting \"September 10\" for \"September 11\" and \"September 28\" for \"September 29\"")
rule S6302September28ForNonElectronicDeposits defeasible {
    label en official "deposits not required to be made by electronic funds transfer are due not later than September 28";
    for p: Person;
    for family: DepositTaxFamily;
    for period: DepositPeriod;
    for y: TaxableYear;
    for n: Integer;
    for beginsOn: Date;
    when deposit_for_period(p, family, period, y)
        and september_rule_covers(family, period)
        and not_known(deposit_required_by_electronic_funds_transfer(p))
        and us.irc.core::calendar_year_of(y, n)
        and us.irc.core::begins(y, beginsOn);
    then deposit_nominal_due_date(p, family, period, y,
        add_calendar_period(add_calendar_period(beginsOn, 8 calendar_month), 27 calendar_day));
}
// The period boundary substitution ("September 10" for "September 11", "September 25"
// for "September 26") decides which amounts fall into the period; the case assigns
// amounts to periods, so the boundary itself is not computed (TECH_GAP G3722).
pub relation deposit_due_date(p: Person, family: DepositTaxFamily, period: DepositPeriod, y: TaxableYear, d: Date) kind institutional {
    label en official "the date by which the deposit must be made, after the Saturday (preceding day) / Sunday (following day) adjustment";
}
@source(IRC_S6302_F, relation = formalizes, coverage = exact, quote = "(A) in the case of Saturday, the preceding day, and")
rule S6302DueDateSaturdayMovesToPrecedingDay defeasible {
    label en official "a due date falling on a Saturday is the preceding day";
    for p: Person;
    for family: DepositTaxFamily;
    for period: DepositPeriod;
    for y: TaxableYear;
    for d: Date;
    for calendar_before_1: Date;
    when deposit_nominal_due_date(p, family, period, y, d)
        and date_is_saturday(d)
        and us.irc.core::civil_calendar_boundary_before(d, 1, us.irc.core::CalendarDay, calendar_before_1);
    then deposit_due_date(p, family, period, y, calendar_before_1);
}
@source(IRC_S6302_F, relation = formalizes, coverage = exact, quote = "(B) in the case of Sunday, the following day.")
rule S6302DueDateSundayMovesToFollowingDay defeasible {
    label en official "a due date falling on a Sunday is the following day";
    for p: Person;
    for family: DepositTaxFamily;
    for period: DepositPeriod;
    for y: TaxableYear;
    for d: Date;
    when deposit_nominal_due_date(p, family, period, y, d)
        and date_is_sunday(d);
    then deposit_due_date(p, family, period, y, add_calendar_period(d, 1 calendar_day));
}
rule S6302DueDateWeekdayUnchanged defeasible {
    label en official "a due date that is not a Saturday or a Sunday stays";
    for p: Person;
    for family: DepositTaxFamily;
    for period: DepositPeriod;
    for y: TaxableYear;
    for d: Date;
    when deposit_nominal_due_date(p, family, period, y, d)
        and not_known(date_is_saturday(d))
        and not_known(date_is_sunday(d));
    then deposit_due_date(p, family, period, y, d);
}
// TECH_GAP G3720: §6302(e)(1) — "the 3rd day (not including Saturdays, Sundays,
// or legal holidays) after the close of the 1st week of the 2nd semimonthly
// period following the period to which such amounts relate".

// ============================================================================
// §6305 — Collection of certain liability (child support)
// ============================================================================

pub relation hhs_certification_received(p: Individual, amount: Money, certifiedOn: Date) kind empirical {
    label en official "the Secretary receives a certification from the Secretary of Health and Human Services, under section 452(b) of the Social Security Act, with respect to the individual";
}
pub relation certified_amount_assessed_and_collected(p: Individual, amount: Money) kind empirical {
    label en official "the Secretary assesses and collects the amount certified, in the same manner, with the same powers and subject to the same limitations as if it were a subtitle C tax the collection of which would be jeopardized by delay";
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "the Secretary shall assess and collect the amount certified by the Secretary of Health and Human Services")
pub rule S6305aAssessAndCollectCertifiedAmount defeasible {
    label en official "upon a certification under section 452(b) of the Social Security Act the Secretary shall assess and collect the certified amount";
    for p: Individual;
    for amount: Money;
    for certifiedOn: Date;
    when hhs_certification_received(p, amount, certifiedOn);
    then duty S6305aAssessAndCollectCertifiedAmountDuty {
        bearer Secretary;
        goal achievement {
            condition certified_amount_assessed_and_collected(p, amount);
            window [certifiedOn, infinity];
        }
    };
}
pub relation certified_child_support_collection(p: Person) kind institutional {
    label en unofficial "the collection is of an amount certified under section 452(b) of the Social Security Act";
}
rule S6305CertifiedCollectionFlag strict {
    label en unofficial "a certification received makes the collection a section 6305 collection";
    for p: Individual;
    for amount: Money;
    for certifiedOn: Date;
    when hhs_certification_received(p, amount, certifiedOn);
    then certified_child_support_collection(p);
}
pub relation interest_or_penalty_assessed_on_certified_amount(p: Person) kind empirical {
    label en official "interest or penalties are assessed or collected on the certified amount";
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "(1) no interest or penalties shall be assessed or collected,")
pub rule S6305a1NoInterestOrPenalties defeasible {
    label en official "no interest or penalties shall be assessed or collected on a certified amount";
    for p: Person;
    when certified_child_support_collection(p)
        and interest_or_penalty_assessed_on_certified_amount(p);
    then prohibition S6305a1NoInterestOrPenaltiesProhibition {
        bearer Secretary;
        action interest_or_penalty_assessed_on_certified_amount(p);
        window [-infinity, infinity];
    };
}
pub relation levy_exemption_disapplied_for_child_support(p: Person, kind: ExemptPropertyKind) kind institutional {
    label en official "for the purposes of a section 6305 collection, paragraphs (4), (6) and (8) of section 6334(a) do not apply";
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "paragraphs (4), (6), and (8) of section 6334(a) (relating to property exempt from levy) shall not apply")
rule S6305a2UnemploymentBenefitsExemptionDoesNotApply defeasible {
    label en official "the section 6334(a)(4) exemption (unemployment benefits) does not apply to a certified collection";
    for p: Person;
    when certified_child_support_collection(p);
    then levy_exemption_disapplied_for_child_support(p, UnemploymentBenefits);
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "paragraphs (4), (6), and (8) of section 6334(a) (relating to property exempt from levy) shall not apply")
rule S6305a2RailroadAndVeteransExemptionDoesNotApply defeasible {
    label en official "the section 6334(a)(6) exemption (certain railroad and veterans benefits) does not apply to a certified collection";
    for p: Person;
    when certified_child_support_collection(p);
    then levy_exemption_disapplied_for_child_support(p, CertainRailroadAndVeteransBenefits);
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "paragraphs (4), (6), and (8) of section 6334(a) (relating to property exempt from levy) shall not apply")
rule S6305a2ChildSupportExemptionDoesNotApply defeasible {
    label en official "the section 6334(a)(8) exemption (court-ordered child support) does not apply to a certified collection";
    for p: Person;
    when certified_child_support_collection(p);
    then levy_exemption_disapplied_for_child_support(p, CourtOrderedChildSupport);
}
pub relation income_withheld_in_garnishment_for_minor_children_support(p: Person) kind empirical {
    label en official "salary, wages or other income of the individual is being withheld in garnishment pursuant to a judgment entered by a court of competent jurisdiction for the support of his minor children";
}
pub relation levy_on_garnished_support_income(p: Person) kind empirical {
    label en official "the Secretary levies on the salary, wages or other income being withheld in garnishment for the support of minor children";
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "there shall be exempt from levy so much of the salary, wages, or other income of an individual as is being withheld therefrom in garnishment pursuant to a judgment entered by a court of competent jurisdiction for the support of his minor children")
pub rule S6305a3GarnishedSupportIncomeExemptFromLevy defeasible {
    label en official "income being withheld in garnishment for the support of minor children is exempt from levy";
    for p: Person;
    when certified_child_support_collection(p)
        and income_withheld_in_garnishment_for_minor_children_support(p)
        and levy_on_garnished_support_income(p);
    then immunity S6305a3GarnishedSupportIncomeImmunity {
        holder p;
        protected_effect levy_on_garnished_support_income(p);
        window [-infinity, infinity];
    };
}
pub relation first_assessment_for_support_delinquency(p: Person) kind empirical {
    label en official "the first assessment against the individual for delinquency under a court or administrative order for a particular person or persons";
}
pub relation notice_and_demand_under_6303_given_on(p: Person, givenOn: Date) kind empirical {
    label en official "notice and demand as described in section 6303 is given";
}
pub relation collection_action_against(p: Person, actionOn: Date) kind empirical {
    label en official "the Secretary takes an action to collect the certified amount";
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "the collection shall be stayed for a period of 60 days immediately following notice and demand as described in section 6303")
pub rule S6305a4CollectionStayedSixtyDaysAfterFirstAssessment defeasible {
    label en official "on the first assessment for delinquency, collection is stayed for 60 days following notice and demand";
    for p: Person;
    for givenOn: Date;
    for actionOn: Date;
    when certified_child_support_collection(p)
        and first_assessment_for_support_delinquency(p)
        and notice_and_demand_under_6303_given_on(p, givenOn)
        and collection_action_against(p, actionOn)
        and actionOn > givenOn
        and actionOn <= add_calendar_period(givenOn, 60 calendar_day);
    then immunity S6305a4SixtyDayStayImmunity {
        holder p;
        protected_effect collection_action_against(p, actionOn);
        window [givenOn, add_calendar_period(givenOn, 60 calendar_day)];
    };
}
pub relation additional_fee_assessed_for_adjustment(p: Person) kind empirical {
    label en official "an additional fee is assessed for an adjustment to an amount previously certified with respect to the same obligor";
}
@source(IRC_S6305_A, relation = formalizes, coverage = exact, quote = "no additional fee may be assessed for adjustments to an amount previously certified")
pub rule S6305a5NoAdditionalFeeForAdjustments defeasible {
    label en official "no additional fee may be assessed for adjustments to a previously certified amount of the same obligor";
    for p: Person;
    when certified_child_support_collection(p)
        and additional_fee_assessed_for_adjustment(p);
    then prohibition S6305a5NoAdditionalFeeProhibition {
        bearer Secretary;
        action additional_fee_assessed_for_adjustment(p);
        window [-infinity, infinity];
    };
}
pub relation court_action_to_restrain_or_review_certified_collection(p: Person, court: Organ) kind empirical {
    label en official "an action, legal or equitable, is brought in a court of the United States to restrain or review the assessment and collection under subsection (a)";
}
pub relation certified_collection_reviewed(p: Person, court: Organ) kind institutional {
    label en unofficial "a court reviews or restrains the section 6305 assessment and collection";
}
rule S6305bReviewWouldProceed defeasible {
    label en unofficial "the action to restrain or review a certified collection would proceed absent the bar";
    for p: Person;
    for court: Organ;
    when certified_child_support_collection(p)
        and court_action_to_restrain_or_review_certified_collection(p, court);
    then certified_collection_reviewed(p, court);
}
@source(IRC_S6305_B, relation = formalizes, coverage = exact, quote = "No court of the United States, whether established under article I or article III of the Constitution, shall have jurisdiction of any action")
pub rule S6305bNoFederalCourtReview defeasible {
    label en official "no court of the United States has jurisdiction of an action to restrain or review the assessment and collection under subsection (a)";
    for p: Person;
    for court: Organ;
    when certified_child_support_collection(p)
        and court_action_to_restrain_or_review_certified_collection(p, court);
    then immunity S6305bNoFederalCourtReviewImmunity {
        holder Secretary;
        protected_effect certified_collection_reviewed(p, court);
        window [-infinity, infinity];
    };
}
pub relation state_court_or_agency_action_against_state(p: Person) kind empirical {
    label en official "an individual brings an action in a State court or before a State agency against the State to determine liability for an amount assessed and collected under this section, or to recover an amount collected";
}
pub relation state_action_not_precluded(p: Person) kind institutional {
    label en official "subsection (b) does not preclude a legal, equitable or administrative action against the State by an individual in a State court or before a State agency";
}
@source(IRC_S6305_B, relation = formalizes, coverage = exact, quote = "This subsection does not preclude any legal, equitable, or administrative action against the State by an individual in any State court or before any State agency")
rule S6305bStateActionsNotPrecluded defeasible {
    label en official "actions against the State in a State court or before a State agency are not precluded";
    for p: Person;
    when state_court_or_agency_action_against_state(p);
    then state_action_not_precluded(p);
}

// ============================================================================
// §6306(f)-(j) — Qualified tax collection contracts, remainder
// ============================================================================

pub relation contractor_act_or_omission(c: Person, actOn: Date) kind empirical {
    label en official "an act or omission of a person performing services under a qualified tax collection contract";
}
pub relation united_states_liable_for_contractor_act(c: Person, actOn: Date) kind institutional {
    label en unofficial "the United States is liable for the contractor's act or omission";
}
rule S6306fLiabilityWouldFollow defeasible {
    label en unofficial "liability of the United States for the act would be asserted";
    for c: Person;
    for actOn: Date;
    when qualified_tax_collection_contract(c)
        and contractor_act_or_omission(c, actOn);
    then united_states_liable_for_contractor_act(c, actOn);
}
@source(IRC_S6306_F, relation = formalizes, coverage = exact, quote = "The United States shall not be liable for any act or omission of any person performing services under a qualified tax collection contract.")
pub rule S6306fNoFederalLiability defeasible {
    label en official "the United States is not liable for any act or omission of a person performing services under a qualified tax collection contract";
    for c: Person;
    for actOn: Date;
    when qualified_tax_collection_contract(c)
        and contractor_act_or_omission(c, actOn);
    then immunity S6306fNoFederalLiabilityImmunity {
        holder Secretary;
        protected_effect united_states_liable_for_contractor_act(c, actOn);
        window [-infinity, infinity];
    };
}
pub relation fdcpa_superseded_for_contract(c: Person) kind empirical {
    label en official "the Fair Debt Collection Practices Act is superseded by section 6304, section 7602(c), or another provision of this title, as to the contract";
}
pub relation fdcpa_applies_to_contract(c: Person) kind institutional {
    label en official "the provisions of the Fair Debt Collection Practices Act (15 U.S.C. 1692 et seq.) apply to the qualified tax collection contract, except to the extent superseded";
}
@source(IRC_S6306_G, relation = formalizes, coverage = partial, quote = "shall apply to any qualified tax collection contract, except to the extent superseded by section 6304, section 7602(c), or by any other provision of this title")
rule S6306gFdcpaAppliesToQualifiedContract defeasible {
    label en official "the Fair Debt Collection Practices Act applies to a qualified tax collection contract, unless superseded";
    for c: Person;
    when qualified_tax_collection_contract(c)
        and not_known(fdcpa_superseded_for_contract(c));
    then fdcpa_applies_to_contract(c);
}
// EXTERNAL_DEPENDENCY: the content of the Fair Debt Collection Practices Act is
// title 15 of the United States Code, not part of the pinned Title 26 text.
pub relation regulation_prescribes_disaster_relief_from_contractors(dummy: Person) kind institutional {
    label en unofficial "the Secretary prescribes procedures under which a taxpayer affected by a Federally declared disaster may request relief from immediate collection measures by contractors, or the return of the inactive tax receivable to the Service (section 6306(i); content not pinned)";
}
pub enum ContractorReportItem {
    ReceivablesProvidedToEachContractor;        // (1)(A)
    AmountsCollectedAndInstallmentsAndCosts;    // (1)(B)
    ImpactOnUnpaidAssessments;                  // (1)(C)
    FeesRetainedAndTheirUse;                    // (1)(D)
    DisclosureSafeguardReport;                  // (1)(E)
    label en unofficial "the five annual items of the section 6306(j)(1) report";
}
pub relation contractor_fiscal_year_ended_on(fyEnd: Date) kind empirical {
    label en official "the last day of a fiscal year (the section 6306(j) report is due 90 days after it)";
}
pub relation contractor_report_submitted(fyEnd: Date) kind empirical {
    label en official "the Secretary submits the report to the Committee on Ways and Means of the House of Representatives and the Committee on Finance of the Senate";
}
pub relation contractor_report_includes(fyEnd: Date, item: ContractorReportItem) kind empirical {
    label en official "the report includes the annual item";
}
pub relation contractor_annual_report_complete(fyEnd: Date) kind institutional {
    label en unofficial "single-atom duty condition: the report was submitted and includes all five annual items";
}
@source(IRC_S6306_J, relation = formalizes, coverage = exact, quote = "a report with respect to qualified tax collection contracts under this section which shall include—")
rule S6306jAnnualReportComplete defeasible {
    label en official "the report was submitted and includes items (1)(A)-(E)";
    for fyEnd: Date;
    when contractor_report_submitted(fyEnd)
        and contractor_report_includes(fyEnd, ReceivablesProvidedToEachContractor)
        and contractor_report_includes(fyEnd, AmountsCollectedAndInstallmentsAndCosts)
        and contractor_report_includes(fyEnd, ImpactOnUnpaidAssessments)
        and contractor_report_includes(fyEnd, FeesRetainedAndTheirUse)
        and contractor_report_includes(fyEnd, DisclosureSafeguardReport);
    then contractor_annual_report_complete(fyEnd);
}
@source(IRC_S6306_J, relation = formalizes, coverage = exact, quote = "Not later than 90 days after the last day of each fiscal year")
pub rule S6306jReportToCongressRequired defeasible {
    label en official "not later than 90 days after the last day of each fiscal year the Secretary shall submit the report to the two committees";
    for fyEnd: Date;
    when contractor_fiscal_year_ended_on(fyEnd);
    then duty S6306jReportToCongressDuty {
        bearer Secretary;
        beneficiary us.irc.core::Congress;
        goal achievement {
            condition contractor_annual_report_complete(fyEnd);
            window [fyEnd, add_calendar_period(fyEnd, 90 calendar_day)];
        }
    };
}
// SOURCE_GAP: "beginning with the first such fiscal year ending after the date of
// the enactment of this subsection" — the enactment date of subsection (j) is not
// stated in the operative text (the notes list several acts), so the rule applies to
// every fiscal year the case names. TECH_GAP G3723: paragraph (2) (biannual items,
// "beginning with the second report") — the parity of the report count.

// ============================================================================
// §6307 — Special compliance personnel program account
// ============================================================================

pub enum AccountTransferSource {
    AmountsRetainedUnder6306e2;
    AnyOtherSource;
    label en unofficial "the source of a transfer to the special compliance personnel account";
}
pub enum PersonnelFundingSource {
    ProgramAccount;
    OtherFundsFromAnySource;
    label en unofficial "the source of funds expended for special compliance personnel employed under the program";
}
pub enum AccountSpendingPurpose {
    ProgramCosts;
    OtherThanProgramCosts;
    label en unofficial "the purpose of an expenditure out of the special compliance personnel account";
}
pub relation special_compliance_account_established(dummy: Person) kind empirical {
    label en official "the Secretary establishes an account within the Department for carrying out a program of hiring, training and employment of special compliance personnel";
}
pub relation amount_transferred_to_special_compliance_account(c: Person, amount: Money) kind empirical {
    label en official "the Secretary transfers to the account the amounts retained under section 6306(e)(2)";
}
@source(IRC_S6307_A, relation = formalizes, coverage = exact, quote = "shall transfer to such account from time to time amounts retained by the Secretary under section 6306(e)(2)")
pub rule S6307aTransferRetainedAmounts defeasible {
    label en official "the Secretary shall transfer to the account from time to time the amounts retained under section 6306(e)(2)";
    for c: Person;
    for amount: Money;
    when collection_contract_fees_retained(c, amount);
    then duty S6307aTransferRetainedAmountsDuty {
        bearer Secretary;
        goal achievement {
            condition amount_transferred_to_special_compliance_account(c, amount);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S6307_A, relation = formalizes, coverage = exact, quote = "The Secretary shall establish an account within the Department for carrying out a program consisting of the hiring, training, and employment of special compliance personnel")
pub rule S6307aEstablishAccount defeasible {
    label en official "the Secretary shall establish an account within the Department for the special compliance personnel program";
    for c: Person;
    for amount: Money;
    when collection_contract_fees_retained(c, amount);
    then duty S6307aEstablishAccountDuty {
        bearer Secretary;
        goal achievement {
            condition special_compliance_account_established(c);
            window [-infinity, infinity];
        }
    };
}
pub relation funds_transferred_to_account(amount: Money, src: AccountTransferSource) kind empirical {
    label en official "funds are transferred to the special compliance personnel account";
}
@source(IRC_S6307_B, relation = formalizes, coverage = exact, quote = "(1) No funds shall be transferred to such account except as described in subsection (a).")
pub rule S6307b1NoTransferExceptAsInA defeasible {
    label en official "no funds shall be transferred to the account except as described in subsection (a)";
    for amount: Money;
    when funds_transferred_to_account(amount, AnyOtherSource);
    then prohibition S6307b1NoOtherTransferProhibition {
        bearer Secretary;
        action funds_transferred_to_account(amount, AnyOtherSource);
        window [-infinity, infinity];
    };
}
pub relation funds_expended_for_program_personnel(amount: Money, src: PersonnelFundingSource) kind empirical {
    label en official "funds are expended for special compliance personnel employed under the program";
}
@source(IRC_S6307_B, relation = formalizes, coverage = exact, quote = "(2) No other funds from any other source shall be expended for special compliance personnel employed under such program.")
pub rule S6307b2NoOtherFundsForProgramPersonnel defeasible {
    label en official "no other funds from any other source shall be expended for special compliance personnel employed under the program";
    for amount: Money;
    when funds_expended_for_program_personnel(amount, OtherFundsFromAnySource);
    then prohibition S6307b2NoOtherFundsProhibition {
        bearer Secretary;
        action funds_expended_for_program_personnel(amount, OtherFundsFromAnySource);
        window [-infinity, infinity];
    };
}
pub relation funds_spent_out_of_account(amount: Money, purpose: AccountSpendingPurpose) kind empirical {
    label en official "funds are spent out of the special compliance personnel account";
}
@source(IRC_S6307_B, relation = formalizes, coverage = exact, quote = "the Secretary is prohibited from spending funds out of such account for other than program costs")
pub rule S6307b3NoSpendingForOtherThanProgramCosts defeasible {
    label en official "notwithstanding any other authority, the Secretary may not spend funds out of the account for other than program costs";
    for amount: Money;
    when funds_spent_out_of_account(amount, OtherThanProgramCosts);
    then prohibition S6307b3NoSpendingProhibition {
        bearer Secretary;
        action funds_spent_out_of_account(amount, OtherThanProgramCosts);
        window [-infinity, infinity];
    };
}
pub enum ProgramReportPart {
    PrecedingFiscalYear;
    CurrentFiscalYear;
    FollowingFiscalYear;
    label en unofficial "the three parts of the section 6307(c) report: the preceding fiscal year (actuals), the current one (actual and estimated) and the following one (estimates)";
}
pub relation special_compliance_program_in_year(y: TaxableYear) kind empirical {
    label en official "the special compliance personnel program exists in the calendar year";
}
pub relation program_report_submitted(y: TaxableYear) kind empirical {
    label en official "the Commissioner submits the report to the Committees on Finance and Appropriations of the Senate and the Committees on Ways and Means and Appropriations of the House of Representatives";
}
pub relation program_report_includes(y: TaxableYear, part: ProgramReportPart) kind empirical {
    label en official "the report includes the part";
}
pub relation program_report_complete(y: TaxableYear) kind institutional {
    label en unofficial "single-atom duty condition: the report was submitted and includes parts (1)-(3)";
}
@source(IRC_S6307_C, relation = formalizes, coverage = exact, quote = "consisting of the following:")
rule S6307cReportComplete defeasible {
    label en official "the report was submitted and includes the preceding, current and following fiscal year parts";
    for y: TaxableYear;
    when program_report_submitted(y)
        and program_report_includes(y, PrecedingFiscalYear)
        and program_report_includes(y, CurrentFiscalYear)
        and program_report_includes(y, FollowingFiscalYear);
    then program_report_complete(y);
}
@source(IRC_S6307_C, relation = formalizes, coverage = exact, quote = "Not later than March of each year, the Commissioner of Internal Revenue shall submit a report")
pub rule S6307cAnnualReportRequired defeasible {
    label en official "not later than March of each year the Commissioner shall submit the report (read as: by March 31 — JUDGMENT CALL)";
    for y: TaxableYear;
    for n: Integer;
    for beginsOn: Date;
    for calendar_before_1: Date;
    when special_compliance_program_in_year(y)
        and us.irc.core::calendar_year_of(y, n)
        and us.irc.core::begins(y, beginsOn)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(beginsOn, 3 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then duty S6307cAnnualReportDuty {
        bearer us.irc.core::IRS;
        goal achievement {
            condition program_report_complete(y);
            window [beginsOn, calendar_before_1];
        }
    };
}
