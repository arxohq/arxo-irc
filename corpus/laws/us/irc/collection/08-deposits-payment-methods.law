// §6302(b),(c),(g),(h) (mode/time of collection: discretionary collection
// devices, use of Government depositaries, semimonthly $100,000 deposit
// rule, electronic fund transfer system), §6306(a)-(e),(h) (private debt
// collection: qualified tax collection contracts, inactive receivables,
// excluded receivables, fees, contracting priority), §6311(a)-(d) (payment
// by check/money order/commercially acceptable means, ultimate/bank
// liability, regulations), §6314 (receipts). STAGE 2b (agent F04,
// 25.09.2026).
//
// JUDGMENT CALLS (see report):
//  - §6302(a),(d),(e),(f) (establishment by regulations where the title is
//    silent; recreational-equipment/communications/airline-ticket/excise
//    semimonthly deposit schedules) are OUTSIDE this pass's requested list
//    and stay `unreviewed`; no fragment in this package's pinned text of
//    §6302 mentions a specific "§4081 14-day rule" the assignment's original
//    wording anticipated — grepped the whole pinned §6302 text for "4081"
//    and "14 day" and found neither; recorded as a discrepancy rather than
//    invented.
//  - §6302(b)'s "discretionary method" and (c)'s depositary-authorization
//    are both open-ended REGULATORY authorizations with no self-executing
//    statutory test (the statute itself states no condition beyond "under
//    regulations prescribed by the Secretary") — modelled as `power`s of the
//    Secretary whose `valid_when` is simply that the tax is one of the named
//    chapters, since the statute imposes no further condition; the actual
//    devices/manner/conditions are `EXTERNAL_DEPENDENCY` (the regulations).
//  - §6302(g)'s "eighth-month period" deposit rule is modelled as a duty
//    keyed to the $100,000 threshold and the "1st banking day after" — the
//    day-count itself uses `calendar_day`, since no `banking_day`/business-
//    day primitive exists in this package (same TECH_GAP class as §6320
//    (a)(2), already recorded); flagged again here as reused reasoning, not
//    a new gap.
//  - §6302(h)'s EFT system is the Secretary's institutional obligation to
//    prescribe regulations (a duty to regulate, not a duty running to a
//    taxpayer) plus a definitional pair ((2)(A)-(B)); modelled as a duty of
//    the Secretary and two definitions; (3)'s coordination clause is
//    `NON_NORMATIVE` (a drafting cross-reference, no independent test).
//  - §6306(b)'s "qualified tax collection contract" is a compound definition
//    ((1)(A)-(C) services, (2) prohibited-act mirroring, (3) subcontractor
//    restrictions, (4) subcontractor-approval liberty) — modelled as ONE
//    empirical qualifying fact with the (1)(B) 7-year installment cap
//    surfaced as its own exact-number test, the remaining elements folded in
//    (`partial` coverage per sub-unit, same modelling choice as §6323(b)/(c)
//    stage 1/2a).
//  - §6306(c)'s three inactive-receivable branches ((i) removed from active
//    inventory, (ii) 2-year unassigned, (iii) 365-day no-interaction) are
//    modelled as three independent empirical branches feeding one shared
//    `inactive_tax_receivable` conclusion — the SAME one-relation/many-rules
//    pattern used for §6323(b)/§6334(a).
//  - §6306(d)'s seven exclusions are modelled as one shared
//    `excluded_from_collection_contract` relation with independent rules per
//    ground; (3)(F)'s 200%-of-poverty-level figure is `SOURCE_GAP` (same
//    administrative-figure class as §7122(c)(3)'s 250% test).
//  - §6311(a)'s "commercially acceptable means" and (d)(1)'s regulations are
//    `EXTERNAL_DEPENDENCY`; (b) ultimate liability and (c) bank/guarantor
//    lien are modelled as institutional effects; (d)(2)-(3) (contracting
//    authority, Truth-in-Lending/EFTA carve-outs) are `NON_NORMATIVE`
//    (administrative contracting authority and cross-statute disapplication
//    clauses with no test this package executes) except (d)(3) is recorded
//    `TECH_GAP` only where a genuinely testable disapplication exists — on
//    inspection none of (d)(3)(A)-(E) states a condition this package's
//    facts could test (they simply say a named OTHER statute's section does
//    not apply), so all of (d)(2)-(3) is `NON_NORMATIVE`.
//  - §6314(a) is modelled as a duty (achievement, on request); (b) as a
//    duty specific to estate tax with the same shape; (c) is `NON_NORMATIVE`
//    (cross-references only).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    Assessment,
    IRC_S6302_B,
    IRC_S6302_C,
    IRC_S6302_G,
    IRC_S6302_H,
    IRC_S6306_A,
    IRC_S6306_B,
    IRC_S6306_C,
    IRC_S6306_D,
    IRC_S6306_E,
    IRC_S6311_A,
    IRC_S6311_B,
    IRC_S6311_C,
    IRC_S6314_A,
    IRC_S6314_B,
    Person,
    Secretary,
    assessment_of_person,
};

// ============================================================================
// §6302(b) — Discretionary method
// ============================================================================

relation tax_within_discretionary_chapters(p: Person, a: Assessment) kind empirical {
    label en unofficial "case fact: the tax is imposed by chapter 21, 31, 32, or 33, or by section 4481 — §6302(b)'s own scope";
}
relation discretionary_collection_device_used(p: Person, a: Assessment, on: Date) kind empirical {
    label en unofficial "case fact: the Secretary collected the tax by a device other than an ordinary return (stamps, coupons, tickets, books, or another reasonable device or method) — §6302(b)'s exercise";
}
pub relation discretionary_collection_device_authorized(p: Person, a: Assessment) kind institutional {
    label en unofficial "§6302(b): the Secretary may collect the tax by means of returns, stamps, coupons, tickets, books, or such other reasonable devices or methods as may be necessary or helpful — the exact device/manner is prescribed by regulations (EXTERNAL_DEPENDENCY)";
}
@source(IRC_S6302_B, relation = formalizes, coverage = partial, quote = "any such tax may, under regulations prescribed by the Secretary, be collected by means of returns, stamps, coupons, tickets, books, or such other reasonable devices or methods as may be necessary or helpful in securing a complete and proper collection of the tax")
rule S6302bDiscretionaryDeviceAuthorized strict {
    for p: Person;
    for a: Assessment;
    for on: Date;
    when tax_within_discretionary_chapters(p, a) and discretionary_collection_device_used(p, a, on);
    then power UseDiscretionaryCollectionDevice {
        holder Secretary;
        exercise discretionary_collection_device_used(p, a, on);
        valid_when tax_within_discretionary_chapters(p, a);
        effect discretionary_collection_device_authorized(p, a);
    };
}

// ============================================================================
// §6302(c) — Use of Government depositaries
// ============================================================================

relation depositary_authorized_by_secretary(depositary: Person) kind empirical {
    label en unofficial "case fact: the Secretary authorized this Federal Reserve bank / incorporated bank / trust company / building and loan association / credit union as a depositary or financial agent of the United States to receive internal revenue tax payments — §6302(c)'s exercise. The manner, times, and conditions of that authorization, and of treating receipt as payment to the Secretary, are prescribed by the Secretary (EXTERNAL_DEPENDENCY)";
}
pub relation depositary_receipt_treated_as_payment(depositary: Person, p: Person, a: Assessment) kind institutional {
    label en unofficial "§6302(c): tax received by an authorized depositary, in the manner/times/conditions the Secretary prescribes, is treated as payment of the tax to the Secretary";
}
relation tax_received_by_depositary(depositary: Person, p: Person, a: Assessment) kind empirical;
@source(IRC_S6302_C, relation = formalizes, coverage = partial, quote = "he shall prescribe the manner, times, and conditions under which the receipt of such tax by such banks, trust companies, domestic building and loan associations, and credit unions is to be treated as payment of such tax to the Secretary")
rule S6302cDepositaryReceiptIsPayment strict {
    for depositary: Person;
    for p: Person;
    for a: Assessment;
    when depositary_authorized_by_secretary(depositary) and tax_received_by_depositary(depositary, p, a);
    then depositary_receipt_treated_as_payment(depositary, p, a);
}

// ============================================================================
// §6302(g) — Deposits of social security taxes and withheld income taxes
// ============================================================================

relation eighth_month_period_depositor(p: Person) kind empirical {
    label en unofficial "case fact: under regulations, the person is required to make deposits of chapter 21/22/24 taxes on the basis of eighth-month periods — §6302(g)'s own scope (EXTERNAL_DEPENDENCY as to which persons are so required)";
}
relation hundred_thousand_or_more_for_deposit_on(p: Person, on: Date) kind empirical {
    label en unofficial "case fact: the person has $100,000 or more of chapter 21/22/24 taxes for deposit as of this day";
}
pub relation next_banking_day_deposit_deadline(p: Person, threshold_day: Date, deadline: Date) kind institutional {
    label en unofficial "§6302(g): the 1st banking day after a day on which the person has $100,000 or more of chapter 21/22/24 taxes for deposit — modelled with a calendar-day step, since this package has no `banking_day` primitive (same limitation class as §6320(a)(2))";
}
@source(IRC_S6302_G, relation = formalizes, coverage = partial, quote = "such person shall make deposits of such taxes on the 1st banking day after any day on which such person has $100,000 or more of such taxes for deposit")
rule S6302gNextBankingDayDeadline strict {
    for p: Person;
    for threshold_day: Date;
    when eighth_month_period_depositor(p) and hundred_thousand_or_more_for_deposit_on(p, threshold_day);
    then next_banking_day_deposit_deadline(p, threshold_day, add_calendar_period(threshold_day, 1 calendar_day));
}
pub relation eighth_month_deposit_duty(p: Person, threshold_day: Date, deadline: Date) kind institutional;
rule S6302gDepositDuty strict {
    for p: Person;
    for threshold_day: Date;
    for deadline: Date;
    when next_banking_day_deposit_deadline(p, threshold_day, deadline);
    then duty MakeEighthMonthDeposit {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition true;
            window [threshold_day, deadline];
        }
    };
}

// ============================================================================
// §6302(h) — Electronic fund transfer system
// ============================================================================

pub relation depository_tax(tax_kind: Text) kind institutional {
    label en unofficial "§6302(h)(2)(A): a depository tax is any tax the Secretary is authorized to require deposits of";
}
pub relation electronic_fund_transfer(transfer_kind: Text) kind institutional {
    label en unofficial "§6302(h)(2)(B): any transfer of funds (other than by check/draft/similar paper instrument) initiated through an electronic terminal, telephonic instrument, computer, or magnetic tape to order/instruct/authorize a debit or credit";
}
@source(IRC_S6302_H, relation = formalizes, coverage = exact, quote = "The term \"depository tax\" means any tax if the Secretary is authorized to require deposits of such tax.")
rule S6302h2ADepositoryTaxDefinition strict {
    for tax_kind: Text;
    when depository_tax_authorized(tax_kind);
    then depository_tax(tax_kind);
}
relation depository_tax_authorized(tax_kind: Text) kind empirical;
rule S6302hEftRegulationDuty strict {
    when true;
    then duty PrescribeEftSystemRegulations {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6306 — Qualified tax collection contracts
// ============================================================================

relation collection_services_contract_exists(contractor: Person) kind empirical {
    label en unofficial "case fact: the Secretary entered into a contract for the (b)(1)(A)-(C) services (locate/contact, request-payment-or-offer-installment, obtain financial information) with a non-Treasury-employee contractor";
}
relation contract_prohibits_ordinary_act_restrictions(contractor: Person) kind empirical {
    label en unofficial "case fact: the contract prohibits the contractor from acts/omissions IRS employees are themselves prohibited from committing in similar services — §6306(b)(2)";
}
relation contract_restricts_subcontractors(contractor: Person) kind empirical {
    label en unofficial "case fact: the contract prohibits subcontractor taxpayer contact/quality-assurance/notice-composition per §6306(b)(3) and permits other subcontractor services only with the Secretary's approval per (b)(4)";
}
relation installment_offer_cap_seven_years(contractor: Person) kind empirical {
    label en unofficial "case fact: any installment agreement the contractor offers under (b)(1)(B) provides for full payment within a period not exceeding 7 years";
}
pub relation qualified_tax_collection_contract(contractor: Person) kind institutional {
    label en unofficial "§6306(b): the contract meets all of (1)-(4) — services, no-prohibited-acts mirroring, subcontractor restrictions, and (via (1)(B)) the 7-year installment cap";
}
@source(IRC_S6306_B, relation = formalizes, coverage = partial, quote = "the term \"qualified tax collection contract\" means any contract which")
rule S6306bQualifiedContract strict {
    for contractor: Person;
    when collection_services_contract_exists(contractor) and contract_prohibits_ordinary_act_restrictions(contractor) and contract_restricts_subcontractors(contractor) and installment_offer_cap_seven_years(contractor);
    then qualified_tax_collection_contract(contractor);
}
pub relation nothing_prevents_qualified_collection_contract(contractor: Person) kind institutional;
@source(IRC_S6306_A, relation = formalizes, coverage = exact, quote = "Nothing in any provision of law shall be construed to prevent the Secretary from entering into a qualified tax collection contract.")
rule S6306aNothingPrevents strict {
    for contractor: Person;
    when qualified_tax_collection_contract(contractor);
    then nothing_prevents_qualified_collection_contract(contractor);
}

relation removed_from_active_inventory(a: Assessment) kind empirical {
    label en unofficial "case fact: at some time after assessment, the IRS removed this receivable from active inventory for lack of resources or inability to locate the taxpayer — §6306(c)(2)(A)(i)";
}
relation two_years_unassigned_since_assessment(a: Assessment, assessed: Date, checked: Date) kind empirical;
relation year_and_a_day_no_interaction(a: Assessment) kind empirical {
    label en unofficial "case fact: more than 365 days have passed without interaction with the taxpayer or a third party furthering collection of an assigned receivable — §6306(c)(2)(A)(iii)";
}
pub relation inactive_tax_receivable(a: Assessment) kind institutional {
    label en unofficial "§6306(c)(2)(A): the receivable is inactive under any of the three (i)-(iii) branches";
}
@source(IRC_S6306_C, relation = formalizes, coverage = partial, quote = "the Internal Revenue Service removes such receivable from the active inventory for lack of resources or inability to locate the taxpayer")
rule S6306cRemovedFromInventoryBranch strict {
    for a: Assessment;
    when removed_from_active_inventory(a);
    then inactive_tax_receivable(a);
}
@source(IRC_S6306_C, relation = formalizes, coverage = partial, quote = "more than 2 years has passed since assessment and such receivable has not been assigned for collection to any employee of the Internal Revenue Service")
rule S6306cTwoYearUnassignedBranch strict {
    for a: Assessment;
    for assessed: Date;
    for checked: Date;
    when two_years_unassigned_since_assessment(a, assessed, checked) and checked >= add_calendar_period(assessed, 2 calendar_year);
    then inactive_tax_receivable(a);
}
@source(IRC_S6306_C, relation = formalizes, coverage = partial, quote = "more than 365 days have passed without interaction with the taxpayer or a third party for purposes of furthering the collection of such receivable")
rule S6306cNoInteractionBranch strict {
    for a: Assessment;
    when year_and_a_day_no_interaction(a);
    then inactive_tax_receivable(a);
}
pub relation qualified_collection_contract_required_for_inactive_receivables(has_inactive: Boolean) kind institutional {
    label en unofficial "§6306(c)(1): the Secretary SHALL enter into one or more qualified tax collection contracts for the collection of all outstanding inactive tax receivables — a duty, not discretion";
}
rule S6306c1MandatoryContractDuty strict {
    for a: Assessment;
    when inactive_tax_receivable(a);
    then duty ContractOutInactiveReceivable {
        bearer Secretary;
        beneficiary Secretary;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

enum ExcludedReceivableGround {
    PendingOrActiveOfferOrInstallmentAgreement;   // (d)(1)
    InnocentSpouseCase;                            // (d)(2)
    Deceased;                                      // (d)(3)(A)
    UnderAgeEighteen;                              // (d)(3)(B)
    CombatZone;                                    // (d)(3)(C)
    IdentityTheftVictim;                            // (d)(3)(D)
    DisabilityOrSSIIncome;                          // (d)(3)(E)
    LowIncomeBelowTwoHundredPercentPoverty;         // (d)(3)(F)
    UnderExaminationLitigationInvestigationOrLevy;  // (d)(4)
    PendingRightOfAppeal;                           // (d)(5)
}
relation excluded_receivable_ground_met(a: Assessment, ground: ExcludedReceivableGround) kind empirical;
pub relation excluded_from_collection_contract(a: Assessment) kind institutional {
    label en unofficial "§6306(d): the receivable is not eligible for collection under a qualified tax collection contract, under any of the ten (d)(1)-(5) grounds";
}
@source(IRC_S6306_D, relation = formalizes, coverage = partial, quote = "is subject to a pending or active offer-in-compromise or installment agreement")
rule S6306dExcludedAnyGround strict {
    for a: Assessment;
    for ground: ExcludedReceivableGround;
    when excluded_receivable_ground_met(a, ground);
    then excluded_from_collection_contract(a);
}
relation identity_theft_victim_poverty_level_below_200pct(a: Assessment) kind empirical {
    label en unofficial "case fact: the taxpayer's adjusted gross income does not exceed 200 percent of the applicable poverty level (SOURCE_GAP: the poverty-level figure itself is Secretary-determined, not pinned in the statute)";
}

pub relation collection_contract_fees_retained(contractor: Person, amount: Money) kind institutional {
    label en unofficial "§6306(e): the Secretary may retain up to 25% of the amount collected for contract costs, plus up to another 25% to fund the §6307 special compliance personnel program account";
}
relation amount_collected_under_contract(contractor: Person, amount: Money) kind empirical;
@source(IRC_S6306_E, relation = formalizes, coverage = partial, quote = "an amount not in excess of 25 percent of the amount collected under any qualified tax collection contract for the costs of services performed under such contract")
rule S6306eFeeRetentionCap strict {
    for contractor: Person;
    for amount: Money;
    when amount_collected_under_contract(contractor, amount);
    then collection_contract_fees_retained(contractor, round(amount * 0.25, 2, "HALF_UP"));
}
pub relation taxpayer_credit_unaffected_by_fee_retention(p: Person, a: Assessment) kind institutional {
    label en unofficial "§6306(e) last sentence: the amount credited as paid by the taxpayer is determined without regard to the fee-retention subsection";
}
rule S6306eCreditUnaffected strict {
    for p: Person;
    for a: Assessment;
    for contractor: Person;
    for amount: Money;
    when amount_collected_under_contract(contractor, amount) and assessment_of_person(a, p);
    then taxpayer_credit_unaffected_by_fee_retention(p, a);
}

pub relation contracting_priority_to_private_collectors(contractor: Person) kind institutional {
    label en unofficial "§6306(h): in contracting under this section, the Secretary shall utilize private collection contractors and debt collection centers on the 31 U.S.C. §3711(g) schedule to the extent appropriate — EXTERNAL_DEPENDENCY as to the schedule itself, modelled as a duty";
}
rule S6306hContractingPriorityDuty strict {
    for contractor: Person;
    when collection_services_contract_exists(contractor);
    then duty UtilizePrivateCollectionSchedule {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6311 — Payment by check or money order
// ============================================================================

relation commercially_acceptable_payment_tendered(p: Person, a: Assessment, means: Text) kind empirical {
    label en unofficial "case fact: the person tendered payment by a commercially acceptable means the Secretary deems appropriate (check, money order, credit/debit/charge card, or another such means) — §6311(a)'s exercise; the exact acceptable means/conditions are prescribed by regulations (EXTERNAL_DEPENDENCY)";
}
pub relation commercially_acceptable_payment_authorized(p: Person, a: Assessment) kind institutional {
    label en unofficial "§6311(a): it is lawful for the Secretary to receive the tendered payment";
}
@source(IRC_S6311_A, relation = formalizes, coverage = partial, quote = "It shall be lawful for the Secretary to receive for internal revenue taxes")
rule S6311aAcceptancePower strict {
    for p: Person;
    for a: Assessment;
    for means: Text;
    when commercially_acceptable_payment_tendered(p, a, means);
    then power AcceptCommerciallyAcceptablePayment {
        holder Secretary;
        exercise commercially_acceptable_payment_tendered(p, a, means);
        valid_when commercially_acceptable_payment_tendered(p, a, means);
        effect commercially_acceptable_payment_authorized(p, a);
    };
}

relation payment_not_duly_paid_or_charged_back(p: Person, a: Assessment, means: Text) kind empirical {
    label en unofficial "case fact: the check/money order/credit-debit-charge-card payment was not duly paid, or was paid and later charged back to the Secretary — §6311(b)'s own condition";
}
pub relation payer_remains_liable_for_tax(p: Person, a: Assessment) kind institutional {
    label en unofficial "§6311(b): the payer remains liable for the tax (and all legal penalties/additions) to the same extent as if the payment had not been tendered";
}
@source(IRC_S6311_B, relation = formalizes, coverage = exact, quote = "the person by whom such check, or money order, or other method of payment has been tendered shall remain liable for the payment of the tax or for the stamps, and for all legal penalties and additions, to the same extent as if such check, money order, or other method of payment had not been tendered")
rule S6311bPayerRemainsLiable strict {
    for p: Person;
    for a: Assessment;
    for means: Text;
    when payment_not_duly_paid_or_charged_back(p, a, means);
    then payer_remains_liable_for_tax(p, a);
}

relation guaranteed_instrument_not_duly_paid(financial_institution: Person, amount: Money) kind empirical {
    label en unofficial "case fact: a certified/treasurer's/cashier's check (or other guaranteed draft), money order, or financial-institution-guaranteed transaction was not duly paid — §6311(c)'s own condition";
}
pub relation united_states_lien_on_guaranteeing_institution(financial_institution: Person, amount: Money) kind institutional {
    label en unofficial "§6311(c): the United States has a lien for the guaranteed amount upon all the assets of the financial institution/issuer/guarantor, in preference to any other claims (except necessary administration costs and circulating-note reimbursement)";
}
@source(IRC_S6311_C, relation = formalizes, coverage = partial, quote = "the United States shall, in addition to its right to exact payment from the party originally indebted therefor, have a lien")
rule S6311cLienOnGuaranteeingInstitution strict {
    for financial_institution: Person;
    for amount: Money;
    when guaranteed_instrument_not_duly_paid(financial_institution, amount);
    then united_states_lien_on_guaranteeing_institution(financial_institution, amount);
}

// §6311(d)'s regulatory authority (payment-by-other-means regulations,
// contracting authority for payment-processing services, and the
// Truth-in-Lending-Act/EFTA disapplication clauses for credit/debit card
// payment errors) states no independently testable condition this package's
// facts drive — it is either a duty to regulate ((d)(1), EXTERNAL_DEPENDENCY
// as to content) or a disapplication of ANOTHER statute's provisions with no
// operative test of its own ((d)(2)-(3)); classified `NON_NORMATIVE` in the
// coverage rows rather than given placeholder rules.

// ============================================================================
// §6314 — Receipt for taxes
// ============================================================================

relation payment_collected_and_receipt_requested(p: Person, a: Assessment) kind empirical {
    label en unofficial "case fact: the person requested a receipt for a sum the Secretary collected from them, not in payment for stamps";
}
pub relation receipt_owed(p: Person, a: Assessment) kind institutional;
@source(IRC_S6314_A, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon request, give receipts for all sums collected by him, excepting only when the same are in payment for stamps sold and delivered")
rule S6314aReceiptDuty strict {
    for p: Person;
    for a: Assessment;
    when payment_collected_and_receipt_requested(p, a);
    then duty GiveReceiptForTaxPaid {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

relation estate_tax_payment_receipt_requested(executor: Person, decedent: Person) kind empirical {
    label en unofficial "case fact: the person paying the chapter 11 estate tax requested duplicate receipts — §6314(b)'s own condition";
}
pub relation estate_tax_duplicate_receipt_owed(executor: Person, decedent: Person) kind institutional;
@source(IRC_S6314_B, relation = formalizes, coverage = exact, quote = "The Secretary shall, upon request, give to the person paying the tax under chapter 11 (relating to the estate tax) duplicate receipts, either of which shall be sufficient evidence of such payment")
rule S6314bDuplicateReceiptDuty strict {
    for executor: Person;
    for decedent: Person;
    when estate_tax_payment_receipt_requested(executor, decedent);
    then duty GiveDuplicateEstateTaxReceipts {
        bearer Secretary;
        beneficiary executor;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}
