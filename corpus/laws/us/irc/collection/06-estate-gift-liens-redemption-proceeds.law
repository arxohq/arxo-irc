// §6324 (special liens for estate and gift tax — the general chapter 11/12
// liens and the (c) exceptions; the (a)(2)/(a)(3) transferee-liability and
// discharge-continuance rules are modelled at reduced granularity, see the
// judgment calls below), §6323(c) (protection for certain commercial
// transactions financing agreements, real property construction/improvement
// financing agreements, and obligatory disbursement agreements — reuses the
// package's existing `SuperpriorityCategory`/`superpriority_protected`/
// `lien_priority_over` mechanism from 02-lien-arising-period-priority.law
// rather than a parallel one), §6323(j) (withdrawal of a filed notice of
// lien as a power of the Secretary), §6337 (redemption of levied/sold
// property), §6342(a) (order of application of proceeds realized under this
// subchapter). STAGE 2 (agent F04, 25.09.2026).
//
// JUDGMENT CALLS (see report):
//  - §6324(a)(2) ("Liability of transferees and others") and (a)(3)
//    ("Continuance after discharge of fiduciary") describe a SEPARATE lien
//    that re-attaches to property in a transferee's hands, and a
//    non-release rule keyed to a §2204 discharge this package does not
//    model (§2204 is owned by `estate-gift`, chapter 11). Modelled here as
//    `transferee_liable_for_estate_tax` (personal liability, capped at the
//    property's value at death — a case-supplied `Money` fact, no §2032
//    valuation machinery) WITHOUT re-deriving the re-attached lien itself
//    (that would need a second `Lien` entity and a full retracing of every
//    subsequent transfer — out of scope for this stage; TECH_GAP row).
//  - §6324(c)'s two exceptions are modelled by adding TWO new
//    `SuperpriorityCategory` values (`Section6323bProtectedInterest` for
//    (c)(1)'s cross-reference to §6323(b), `MechanicsLienorUnderEstateOrGiftLien`
//    for the mechanic's-lienor carve-out) that plug into the SAME
//    `lien_priority_over`/`superpriority_protected` general rule — the
//    estate/gift lien reuses `Lien` and the identical priority relation
//    rather than a parallel type. (c)(2)'s local-law "same priority as the
//    lien or security interest to which it relates" extension for interest/
//    expenses is `INTERPRETATION` (no general §6323(e) priority-of-interest
//    rule exists yet in this package to extend — TECH_GAP dependency noted).
//  - §6323(c)'s three agreement-kind definitions ((2)(A)-(D), (3)(A)-(B),
//    (4)(A)-(C)) are each folded into ONE empirical "qualified financing
//    agreement of this kind, with qualified property, entered before the
//    46th day after tax lien filing / before actual notice" fact per kind
//    (the same modelling choice already made for §6323(b)'s ten categories,
//    per that module's own judgment-call note) rather than decomposed
//    further; coverage `partial` per definitional paragraph.
//  - §6337(b)(2)'s "interest thereon at the rate of 20 percent per annum" is
//    a PRORATED annual rate over the actual holding period (sale date to
//    redemption date), which needs a day-count-to-Money division this
//    package's closed computable surface does not confirm supporting
//    (`days_between` divided by 365 — no corpus precedent for `/` on
//    `Money`/`Decimal` was found). The REDEMPTION RIGHT and its 180-day
//    window are fully executable; the exact interest AMOUNT is `TECH_GAP`
//    G461 (see TECH-GAPS.md) — the case supplies the redemption price as a
//    fact tested against the window, not a value this package computes.
//  - §6342(a)'s three-tier order (expenses; specific tax on the seized
//    property itself, if any; the delinquent taxpayer's own liability) is
//    modelled as an ORDERING relation over tiers rather than a running
//    ledger (the same running-balance TECH_GAP class as G1/G10/G38/G97):
//    `proceeds_tier_satisfied_before` records the required sequence: a
//    later tier cannot be paid before an earlier tier now unsatisfied.
//    Computing the actual dollar allocation across tiers from a single
//    proceeds figure is out of scope this stage (TECH_GAP G462).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    IRC_S6323_C,
    IRC_S6323_J,
    IRC_S6324_A,
    IRC_S6324_B,
    IRC_S6324_C,
    IRC_S6337_A,
    IRC_S6337_B,
    IRC_S6337_C,
    IRC_S6342_A,
    Levy,
    Lien,
    LienWithdrawalGround,
    Person,
    Secretary,
    SuperpriorityCategory,
    sale_conducted_on,
    superpriority_protected,
};

// ============================================================================
// §6323(c) — Protection for certain commercial transactions financing
// agreements, etc. (extends 02's SuperpriorityCategory/superpriority_protected)
// ============================================================================

relation commercial_transactions_financing_agreement_qualifies(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "case fact: the claimant's security interest arose under a written commercial transactions financing agreement entered into before tax lien filing, in qualified commercial financing security acquired before the 46th day after tax lien filing (or, if earlier, before actual notice/knowledge of the filing), protected under local law against a judgment lien — §6323(c)(1),(2)";
}
@source(IRC_S6323_C, relation = formalizes, coverage = partial, quote = "is in qualified property covered by the terms of a written agreement entered into before tax lien filing and constituting")
rule S6323cCommercialTransactionsFinancingProtected strict {
    for claimant: Person;
    for lien: Lien;
    when commercial_transactions_financing_agreement_qualifies(claimant, lien);
    then superpriority_protected(claimant, lien, CommercialTransactionsFinancingSecurityInterest);
}

relation real_property_construction_financing_agreement_qualifies(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "case fact: the claimant's security interest arose under a written real property construction or improvement financing agreement entered into before tax lien filing, in qualified property under §6323(c)(3)(B), protected under local law against a judgment lien";
}
@source(IRC_S6323_C, relation = formalizes, coverage = partial, quote = "(ii) a real property construction or improvement financing agreement")
rule S6323cConstructionFinancingProtected strict {
    for claimant: Person;
    for lien: Lien;
    when real_property_construction_financing_agreement_qualifies(claimant, lien);
    then superpriority_protected(claimant, lien, RealPropertyConstructionFinancingSecurityInterest);
}

relation obligatory_disbursement_agreement_qualifies(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "case fact: the claimant's security interest arose under a written obligatory disbursement agreement entered into before tax lien filing, in qualified property under §6323(c)(4)(B)-(C), protected under local law against a judgment lien";
}
@source(IRC_S6323_C, relation = formalizes, coverage = partial, quote = "(iii) an obligatory disbursement agreement")
rule S6323cObligatoryDisbursementProtected strict {
    for claimant: Person;
    for lien: Lien;
    when obligatory_disbursement_agreement_qualifies(claimant, lien);
    then superpriority_protected(claimant, lien, ObligatoryDisbursementSecurityInterest);
}

// ============================================================================
// §6323(j) — Withdrawal of notice in certain circumstances
// ============================================================================

pub relation lien_withdrawal_ground_met(lien: Lien, ground: LienWithdrawalGround) kind empirical {
    label en unofficial "one of §6323(j)(1)'s four grounds for withdrawing a filed notice of lien is met";
}
relation lien_withdrawal_made(lien: Lien, on: Date) kind empirical {
    label en unofficial "the Secretary in fact filed notice of withdrawal, at the same office as the withdrawn notice — §6323(j)(1) last sentence";
}
relation lien_withdrawal_valid(lien: Lien) kind institutional {
    label en unofficial "at least one §6323(j)(1)(A)-(D) ground is met for this lien's filed notice";
}
@source(IRC_S6323_J, relation = formalizes, coverage = partial, quote = "The Secretary may withdraw a notice of a lien filed under this section")
rule S6323jWithdrawalGroundMakesValid strict {
    for lien: Lien;
    for ground: LienWithdrawalGround;
    when lien_withdrawal_ground_met(lien, ground);
    then lien_withdrawal_valid(lien);
}
@source(IRC_S6323_J, relation = formalizes, coverage = exact, quote = "The Secretary may withdraw a notice of a lien filed under this section and this chapter shall be applied as if the withdrawn notice had not been filed")
rule S6323jWithdrawNoticePower strict {
    for lien: Lien;
    for on: Date;
    when lien_withdrawal_made(lien, on);
    then power WithdrawNoticeOfLien {
        holder Secretary;
        exercise lien_withdrawal_made(lien, on);
        valid_when lien_withdrawal_valid(lien);
        effect notice_of_lien_withdrawn(lien);
    };
}
pub relation notice_of_lien_withdrawn(lien: Lien) kind institutional {
    label en unofficial "the §6323(j) withdrawal of the filed notice of lien took legal effect: this chapter is applied as if the withdrawn notice had not been filed (the underlying §6321 lien itself is untouched — only the FILED NOTICE's effect is withdrawn)";
}

pub relation credit_agency_notice_of_withdrawal_requested(p: Person, lien: Lien) kind empirical {
    label en unofficial "the taxpayer with respect to whom a notice of lien was withdrawn made a written request under §6323(j)(2) that the Secretary notify credit reporting agencies and named financial institutions/creditors of the withdrawal";
}
@source(IRC_S6323_J, relation = formalizes, coverage = exact, quote = "the Secretary shall promptly make reasonable efforts to notify credit reporting agencies, and any financial institution or creditor whose name and address is specified in such request, of the withdrawal of such notice")
rule S6323j2CreditAgencyNoticeDuty strict {
    for p: Person;
    for lien: Lien;
    when notice_of_lien_withdrawn(lien) and credit_agency_notice_of_withdrawal_requested(p, lien);
    then duty NotifyCreditAgenciesOfWithdrawal {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6324(a) — Special lien for estate tax
// ============================================================================

pub relation estate_tax_special_lien(lien: Lien, decedent: Person) kind institutional {
    label en unofficial "the §6324(a)(1) lien upon the gross estate of the decedent for the chapter 11 estate tax — arises automatically for 10 years from the date of death unless the tax is sooner paid in full or becomes unenforceable by lapse of time (the part of the gross estate used for administration expenses/charges allowed by a court is divested of this lien, not modelled separately: that divestiture narrows WHICH property the lien covers, not whether the lien itself arises)";
}
relation estate_tax_imposed(decedent: Person) kind empirical {
    label en unofficial "case fact: a chapter 11 estate tax is imposed with respect to this decedent's estate";
}
relation estate_tax_paid_in_full_on(decedent: Person, on: Date) kind empirical;
relation estate_tax_period_checked_on(decedent: Person, on: Date) kind empirical {
    label en unofficial "case fact: the date §6324(a)'s 10-year lien window is being checked as of";
}
relation date_of_death(decedent: Person, on: Date) kind empirical;
relation estate_lien_identity(lien: Lien, decedent: Person) kind empirical {
    label en unofficial "case-supplied identity: this Lien instance is the §6324(a) lien for this decedent's estate (a lien has no document of its own to reference before it arises — same convention as 02-lien-arising-period-priority.law's `lien_identity`)";
}

@source(IRC_S6324_A, relation = formalizes, coverage = exact, quote = "it shall be a lien upon the gross estate of the decedent for 10 years from the date of death")
rule S6324aEstateTaxLienArises defeasible {
    for lien: Lien;
    for decedent: Person;
    for died: Date;
    for on: Date;
    for paid: Date;
    when estate_lien_identity(lien, decedent) and estate_tax_imposed(decedent) and date_of_death(decedent, died) and estate_tax_period_checked_on(decedent, on) and on >= died and add_calendar_period(died, 10 calendar_year) >= on;
    then estate_tax_special_lien(lien, decedent);
    unless estate_tax_paid_in_full_on(decedent, paid) and estate_lien_identity(lien, decedent) and estate_tax_imposed(decedent) and date_of_death(decedent, died) and estate_tax_period_checked_on(decedent, on) and on >= died and add_calendar_period(died, 10 calendar_year) >= on and on >= paid;
}

pub relation transferee_liability(p: Person, decedent: Person, value_at_death: Money) kind institutional {
    label en unofficial "§6324(a)(2): a spouse, transferee, trustee (other than a qualifying §401(a) trustee), surviving tenant, holder by reason of a power of appointment, or beneficiary who received (or held at the decedent's death) gross-estate property under §§2034-2042 is personally liable for the unpaid chapter 11 estate tax, up to the value of that property at the decedent's death";
}
relation received_gross_estate_property_2034_2042(p: Person, decedent: Person, value_at_death: Money) kind empirical {
    label en unofficial "case fact: the person received, or held at the decedent's death, property included in the gross estate under §§2034-2042";
}
@source(IRC_S6324_A, relation = formalizes, coverage = partial, quote = "the spouse, transferee, trustee (except the trustee of an employees' trust which meets the requirements of section 401(a)), surviving tenant, person in possession of the property by reason of the exercise, nonexercise, or release of a power of appointment, or beneficiary, who receives, or has on the date of the decedent's death, property included in the gross estate under sections 2034 to 2042, inclusive, to the extent of the value, at the time of the decedent's death, of such property, shall be personally liable for such tax")
rule S6324a2TransfereePersonalLiability strict {
    for p: Person;
    for decedent: Person;
    for value_at_death: Money;
    when received_gross_estate_property_2034_2042(p, decedent, value_at_death) and estate_tax_imposed(decedent);
    then transferee_liability(p, decedent, value_at_death);
}

// ============================================================================
// §6324(b) — Lien for gift tax
// ============================================================================

pub relation gift_tax_special_lien(lien: Lien, donor: Person) kind institutional {
    label en unofficial "the §6324(b) lien upon all gifts made during the period covered by the return, for 10 years from the date the gifts are made, unless the chapter 12 gift tax is sooner paid in full or becomes unenforceable by lapse of time";
}
relation gift_tax_imposed(donor: Person) kind empirical;
relation gift_tax_paid_in_full_on(donor: Person, on: Date) kind empirical;
relation gift_tax_period_checked_on(donor: Person, on: Date) kind empirical;
relation date_of_gift(donor: Person, on: Date) kind empirical;
relation gift_lien_identity(lien: Lien, donor: Person) kind empirical {
    label en unofficial "case-supplied identity: this Lien instance is the §6324(b) lien for this donor's gifts";
}

@source(IRC_S6324_B, relation = formalizes, coverage = exact, quote = "such tax shall be a lien upon all gifts made during the period for which the return was filed, for 10 years from the date the gifts are made")
rule S6324bGiftTaxLienArises defeasible {
    for lien: Lien;
    for donor: Person;
    for given: Date;
    for on: Date;
    for paid: Date;
    when gift_lien_identity(lien, donor) and gift_tax_imposed(donor) and date_of_gift(donor, given) and gift_tax_period_checked_on(donor, on) and on >= given and add_calendar_period(given, 10 calendar_year) >= on;
    then gift_tax_special_lien(lien, donor);
    unless gift_tax_paid_in_full_on(donor, paid) and gift_lien_identity(lien, donor) and gift_tax_imposed(donor) and date_of_gift(donor, given) and gift_tax_period_checked_on(donor, on) and on >= given and add_calendar_period(given, 10 calendar_year) >= on and on >= paid;
}

pub relation donee_gift_tax_liability(donee: Person, donor: Person, value_of_gift: Money) kind institutional {
    label en unofficial "§6324(b): if the gift tax is not paid when due, the donee is personally liable for it, up to the value of the gift";
}
relation gift_tax_not_paid_when_due(donor: Person) kind empirical;
@source(IRC_S6324_B, relation = formalizes, coverage = exact, quote = "If the tax is not paid when due, the donee of any gift shall be personally liable for such tax to the extent of the value of such gift")
rule S6324bDoneePersonalLiability strict {
    for donee: Person;
    for donor: Person;
    for value_of_gift: Money;
    when gift_tax_not_paid_when_due(donor) and received_gift_of_value(donee, donor, value_of_gift);
    then donee_gift_tax_liability(donee, donor, value_of_gift);
}
relation received_gift_of_value(donee: Person, donor: Person, value_of_gift: Money) kind empirical;

// ============================================================================
// §6324(c) — Exceptions
// ============================================================================

relation mechanics_lienor_against_estate_or_gift_lien(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "case fact: the claimant holds a mechanic's lien against property subject to the §6324(a)/(b) lien — §6324(c)(1) first clause: the lien is never valid against a mechanic's lienor at all (no §6323(b) conditions apply to this branch)";
}
@source(IRC_S6324_C, relation = formalizes, coverage = partial, quote = "The lien imposed by subsection (a) or (b) shall not be valid as against a mechanic's lienor")
rule S6324c1MechanicsLienorAlwaysProtected strict {
    for claimant: Person;
    for lien: Lien;
    when mechanics_lienor_against_estate_or_gift_lien(claimant, lien);
    then superpriority_protected(claimant, lien, MechanicsLienorUnderEstateOrGiftLien);
}
// §6324(c)(1)'s second clause ("subject to the conditions provided by
// section 6323(b)... shall not be valid with respect to any lien or interest
// described in section 6323(b)") needs NO separate rule: `superpriority_
// protected`'s ten §6323(b) categories (02-lien-arising-period-priority.law)
// already take a generic `Lien` argument, not specifically the §6321 lien —
// a claimant who meets one of those ten categories' conditions with respect
// to THIS lien already gets `superpriority_protected(claimant, lien,
// <b-category>)` from the existing b(1)-b(10) rules, which composes with
// the shared `lien_priority_over` general rule's `unless` clause the same
// way for any `Lien` instance. A dedicated `Section6323bProtectedInterest`
// category would only duplicate that inference (and, tried as a rule
// reading `superpriority_protected` to produce `superpriority_protected`,
// is a self-referential-predicate cycle the checker refuses — LDC-E4102).
// The `Section6323bProtectedInterest` enum value above is therefore UNUSED
// by design; kept only to name the (c)(1) second clause in the coverage row
// as EXECUTABLE-by-composition, not to be assigned by its own rule.

// The §6324(a)/(b) lien is a DIFFERENT lien from the §6321 lien this
// package's `lien_priority_over` (02-lien-arising-period-priority.law) was
// written for; that relation's head is `(lien: Lien, claimant: Person)` and
// does not distinguish which STATUTE created `lien`, so the two new
// categories above compose with the existing general rule without change —
// the general rule's own `unless superpriority_protected(claimant, lien,
// spcategory)` clause already covers any category, including these two.

// ============================================================================
// §6337 — Redemption
// ============================================================================

pub relation redemption_before_sale_permitted(p: Person) kind institutional {
    label en unofficial "§6337(a): a person whose property has been levied upon may pay the amount due plus expenses at any time before the sale, and upon payment the Secretary restores the property and all further levy proceedings on it cease";
}
relation levy_amount_due_and_expenses_tendered(p: Person, on: Date) kind empirical;
@source(IRC_S6337_A, relation = formalizes, coverage = exact, quote = "Any person whose property has been levied upon shall have the right to pay the amount due, together with the expenses of the proceeding, if any, to the Secretary at any time prior to the sale thereof")
rule S6337aRedemptionBeforeSale strict {
    for p: Person;
    for tendered_on: Date;
    for sale_on: Date;
    when levy_amount_due_and_expenses_tendered(p, tendered_on) and sale_conducted_on(p, sale_on) and tendered_on < sale_on;
    then redemption_before_sale_permitted(p);
}

pub relation redemption_period_ends(p: Person, sold_on: Date, end: Date) kind institutional {
    label en unofficial "§6337(b)(1): the last day of the 180-day period after the sale of real property within which the owner, heirs, executors, administrators, or any interested/lienholding person (or their agent) may redeem the property sold under §6335";
}
@source(IRC_S6337_B, relation = formalizes, coverage = exact, quote = "shall be permitted to redeem the property sold, or any particular tract of such property, at any time within 180 days after the sale thereof")
rule S6337b1RedemptionWindowEnd strict {
    for p: Person;
    for sold_on: Date;
    when sale_conducted_on(p, sold_on);
    then redemption_period_ends(p, sold_on, add_calendar_period(sold_on, 180 calendar_day));
}

pub relation redemption_within_period_permitted(p: Person, sold_on: Date, redeemed_on: Date) kind institutional {
    label en unofficial "§6337(b)(1): the redemption is timely — made on or before the last day of the 180-day post-sale window";
}
relation redemption_attempted_on(p: Person, redeemed_on: Date) kind empirical {
    label en unofficial "case fact: the date the redeeming person tendered the redemption price";
}
rule S6337b1RedemptionTimely strict {
    for p: Person;
    for sold_on: Date;
    for end: Date;
    for redeemed_on: Date;
    when redemption_period_ends(p, sold_on, end) and redemption_attempted_on(p, redeemed_on) and redeemed_on <= end;
    then redemption_within_period_permitted(p, sold_on, redeemed_on);
}

// §6337(b)(2)'s redemption PRICE (amount paid by the purchaser plus interest
// at the fixed 20%-per-annum rate) is TECH_GAP G461: the eligibility/window
// rules above are fully executable, but the prorated interest amount needs
// a day-count-to-Money division this package's closed computable surface
// does not confirm supporting (see judgment calls above). Recorded, not
// silently computed with an unconfirmed operator.
relation amount_paid_by_purchaser(p: Person, amount: Money) kind empirical;
relation redemption_price_tendered(p: Person, amount: Money) kind empirical {
    label en unofficial "case fact: the amount tendered by the redeeming person — this package certifies timeliness (S6337b1RedemptionTimely) and eligibility, but does NOT independently compute the correct §6337(b)(2) price (TECH_GAP G461)";
}

pub relation redemption_recorded(lien_record: Lien) kind institutional {
    label en unofficial "§6337(c): when redeemed land is entered upon the §6340 record, that entry is evidence of the redemption";
}
relation redemption_entry_made(lien_record: Lien) kind empirical;
@source(IRC_S6337_C, relation = formalizes, coverage = exact, quote = "the Secretary shall cause entry of the fact to be made upon the record mentioned in section 6340, and such entry shall be evidence of such redemption")
rule S6337cRedemptionRecordDuty strict {
    for lien_record: Lien;
    when redemption_entry_made(lien_record);
    then redemption_recorded(lien_record);
}

// ============================================================================
// §6342(a) — Application of proceeds of levy
// ============================================================================

enum ProceedsTier {
    ExpensesOfLevyAndSale;             // (1)
    SpecificTaxOnSeizedProperty;       // (2)
    DelinquentTaxpayerLiability;       // (3)
}

pub relation proceeds_tier_applies(p: Person, levy: Levy, tier: ProceedsTier) kind institutional {
    label en unofficial "§6342(a): this tier is among those to which money realized under this subchapter (seizure, surrender under §6332 other than (d)(2), sale of seized property, or sale of United States-redeemed property subject to a title 26 lien) must be applied, in the statutory order (1) expenses, (2) specific tax on the seized property (if any, assessing it first if not already assessed), (3) the taxpayer's own liability";
}
relation proceeds_realized_under_subchapter(p: Person, levy: Levy) kind empirical;
@source(IRC_S6342_A, relation = formalizes, coverage = exact, quote = "First, against the expenses of the proceedings;")
rule S6342a1ExpensesTierFirst strict {
    for p: Person;
    for levy: Levy;
    when proceeds_realized_under_subchapter(p, levy);
    then proceeds_tier_applies(p, levy, ExpensesOfLevyAndSale);
}
relation seized_property_itself_subject_to_unpaid_tax(p: Person, levy: Levy) kind empirical {
    label en unofficial "case fact: the property seized and sold is itself subject to an unpaid internal revenue tax — §6342(a)(2)'s own condition";
}
@source(IRC_S6342_A, relation = formalizes, coverage = exact, quote = "If the property seized and sold is subject to a tax imposed by any internal revenue law which has not been paid, the amount remaining after applying paragraph (1) shall then be applied against such tax liability")
rule S6342a2SpecificTaxTierSecond strict {
    for p: Person;
    for levy: Levy;
    when proceeds_realized_under_subchapter(p, levy) and seized_property_itself_subject_to_unpaid_tax(p, levy);
    then proceeds_tier_applies(p, levy, SpecificTaxOnSeizedProperty);
}
@source(IRC_S6342_A, relation = formalizes, coverage = exact, quote = "The amount, if any, remaining after applying paragraphs (1) and (2) shall then be applied against the liability in respect of which the levy was made or the sale was conducted.")
rule S6342a3DelinquentTaxpayerTierThird strict {
    for p: Person;
    for levy: Levy;
    when proceeds_realized_under_subchapter(p, levy);
    then proceeds_tier_applies(p, levy, DelinquentTaxpayerLiability);
}

pub relation proceeds_tier_precedes(earlier: ProceedsTier, later: ProceedsTier) kind institutional {
    label en unofficial "§6342(a)'s ordering: `earlier` must be fully applied before any remainder is applied to `later` — an ORDER-of-application relation, not a computed dollar allocation (TECH_GAP G462: the running-balance allocation across tiers from one proceeds figure is not modelled this stage, same construct class as G1/G10/G38/G97)";
}
rule S6342aExpensesPrecedeSpecificTax strict {
    when true;
    then proceeds_tier_precedes(ExpensesOfLevyAndSale, SpecificTaxOnSeizedProperty);
}
rule S6342aSpecificTaxPrecedesDelinquentLiability strict {
    when true;
    then proceeds_tier_precedes(SpecificTaxOnSeizedProperty, DelinquentTaxpayerLiability);
}
rule S6342aExpensesPrecedeDelinquentLiability strict {
    when true;
    then proceeds_tier_precedes(ExpensesOfLevyAndSale, DelinquentTaxpayerLiability);
}
