// in `02-lien-arising-period-priority.law`.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

import us.irc.core version "0.1.1";
import us.irc.assessment version "0.1.1";
import us.irc.administration version "0.1.1";
import us.irc.temporal version "0.1.1";
import us.irc.inflation_adjustments version "0.1.1";

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;
type Notice = us.irc.core::Notice;
type Assessment = us.irc.core::Assessment;
type Lien = us.irc.core::Lien;
type Levy = us.irc.core::Levy;
type Proceeding = us.irc.core::Proceeding;

const Secretary: Organ = us.irc.core::Secretary;
const TaxCourt: Organ = us.irc.core::TaxCourt;

// JUDGMENT CALLS common to the whole package (see report for the full list):
//
//  - CollectionNoticeKind below is a LOCAL enum, not an extension of
//    `us.irc.core::NoticeKind` (which names only `Deficiency`/
//    `NoticeAndDemand`/`Other` — CONTRACT.md §"NoticeKind has only two named
//    values" invites the owner to add values in core "in the same change",
//    but AGENT-BRIEF's hard rule forbids editing another package
//    (`us.irc.core` is owned by the shared-contracts agent). Flagged for the
//    coordinator rather than done unilaterally; see report.
//  - §7503 (weekend/legal-holiday rollover of a deadline that is the LAST
//    day prescribed) is NOT applied to any window in this package: every
//    duty/power window below is the statutory day count taken at face
//    value. `us.irc.administration` is not imported. This is a stage-1
//    simplification, not a claim that §7503 does not apply to collection
//    deadlines — recorded as a judgment call in the report, not silently.
//  - Every day count in this package's stage-1 sections is CALENDAR days
//    except §6320(a)(2)'s "5 business days after the day of the filing of
//    the notice of lien" — the ONE business-day computation in the whole
//    anchor list (confirmed by a grep of every stage-1 section's pinned
//    quotes). Per DECISION Д-08 (`docs/foundations/us-irc/DECISIONS.md`),
//    `us.code.federal_holidays` exports no `pub` symbol yet, so
//    `add_business_days` cannot be given a real calendar snapshot from this
//    package; the §6320(a)(2) computation is modelled the way
//    `administration`'s own §7503 module models its calendar-dependent
//    rollover (see that module's header): the case supplies a CANDIDATE
//    date and a rule VALIDATES it, rather than the package computing the
//    date outright. Coverage row: EXTERNAL_DEPENDENCY (owner
//    `us.code.federal_holidays`, status pending a `pub` surface).

enum CollectionNoticeKind {
    NoticeAndDemandForPayment;      // §6303
    NoticeOfFilingOfNoticeOfLien;   // §6320(a)
    NoticeOfIntentToLevy;           // §6330(a)
    NoticeOfLevyIntention;          // §6331(d)
    NoticeOfSeizure;                // §6335(a)
    NoticeOfSaleOfSeizedProperty;   // §6335(b)
    NoticeOfLevyRelease;            // §6343(a)
    NoticeOfLienRevocation;         // §6325(f)(2)
}

// A single hearing chain runs through two entry points (§6320 filing of a
// lien notice; §6330 notice before levy) but §6320(c) incorporates §6330's
// hearing mechanics wholesale ("subsections (c), (d) (other than paragraph
// (3)(B) thereof), (e), and (g) of section 6330 shall apply"). Rather than
// duplicating that machinery, 04-levy-hearing-and-power.law declares the
// shared hearing/determination/suspension relations ONCE, tagged by this
// enum; 03-lien-hearing-and-release.law's §6320 module supplies its own
// notice/window facts and reuses those same relations under
// `CDPOrigin::LienFilingNotice`.
pub enum CDPOrigin {
    LienFilingNotice;   // §6320
    LevyNotice;         // §6330
}

// §6334(a)(1)-(13)'s exemption items: a single enum + a shared pub relation
// (`property_exempt_from_levy`), with thirteen independent rules — one per
// paragraph — concluding that SAME relation under different empirical
// conditions. This is not the §61(a)/`GrossIncomeItemKind` self-reference
// cycle the `returns`/`gross-income` HANDOFF notes warn about (a rule whose
// body reads the very relation it concludes): each of the thirteen rules
// below reads only its OWN paragraph's empirical facts.
enum ExemptPropertyKind {
    WearingApparelAndSchoolBooks;          // (a)(1)
    HouseholdFuelFurnitureAndEffects;      // (a)(2), capped
    BooksAndToolsOfTrade;                  // (a)(3), capped
    UnemploymentBenefits;                  // (a)(4)
    UndeliveredMail;                       // (a)(5)
    CertainRailroadAndVeteransBenefits;    // (a)(6)
    WorkmensCompensation;                  // (a)(7)
    CourtOrderedChildSupport;              // (a)(8)
    MinimumExemptWagesAndIncome;           // (a)(9), amount under (d)
    ServiceConnectedDisabilityBenefit;     // (a)(10)
    PublicAssistancePayment;               // (a)(11)
    JobTrainingPartnershipActPayment;      // (a)(12)
    ResidenceAndBusinessProperty;          // (a)(13), subject to (e)
}

// §6323(b)'s superpriority list: same pattern as ExemptPropertyKind — one
// shared pub relation (`lien_priority_over` is FALSE, i.e. the claimant
// beats the federal lien, in exactly these ten categories), ten independent
// rules.
// STAGE 2 (25.09.2026): three more values added by
// 06-estate-gift-liens-redemption-proceeds.law — §6323(c)'s three financing-
// agreement categories, and §6324(c)'s two exceptions to the estate/gift
// lien (a DIFFERENT lien from §6321's, but sharing this same category type
// and the general `lien_priority_over` rule — see that module's header).
enum SuperpriorityCategory {
    SecuritiesPurchaserOrHolder;              // (b)(1)
    MotorVehiclePurchaser;                    // (b)(2)
    RetailPurchaser;                          // (b)(3)
    CasualSalePurchaserUnder1000;             // (b)(4)
    PossessoryRepairOrImprovementLienHolder;  // (b)(5)
    RealPropertyTaxOrSpecialAssessmentLien;   // (b)(6)
    ResidentialRepairMechanicsLienor;         // (b)(7)
    AttorneysLienOnJudgmentOrSettlement;      // (b)(8)
    InsurerUnderLifeOrAnnuityContract;        // (b)(9)
    SavingsInstitutionLoanOnAccount;          // (b)(10)
    CommercialTransactionsFinancingSecurityInterest;      // §6323(c)(1)(A)(i)
    RealPropertyConstructionFinancingSecurityInterest;    // §6323(c)(1)(A)(ii)
    ObligatoryDisbursementSecurityInterest;               // §6323(c)(1)(A)(iii)
    MechanicsLienorUnderEstateOrGiftLien;                 // §6324(c)(1) first clause
    Section6323bProtectedInterest;                        // §6324(c)(1) second clause
    FortyFiveDayDisbursementSecurityInterest;             // §6323(d) — STAGE 2b
}

enum LienWithdrawalGround {
    FilingPrematureOrProcedurallyDefective;   // §6323(j)(1)(A)
    InstallmentAgreementUnder6159;            // §6323(j)(1)(B)
    WithdrawalFacilitatesCollection;          // §6323(j)(1)(C)
    ConsentAndBestInterestsOfTaxpayer;        // §6323(j)(1)(D)
}
