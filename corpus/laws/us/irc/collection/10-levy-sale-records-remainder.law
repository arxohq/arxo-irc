// §6333 (production of books), §6336 (sale of perishable goods),
// §6338 (certificate of sale / deed to real property), §6339 (legal effect
// of certificates of sale and deeds), §6340 (records of sale), §6341
// (expense of levy and sale), §6342(b) (surplus proceeds), §6344 (period
// within which levy may be begun — cross-references only). STAGE 2b (agent
// F04, 25.09.2026).
//
// JUDGMENT CALLS (see report):
//  - §6333 is a duty of a third-party custodian, running to the Secretary,
//    triggered by an actual or imminent levy.
//  - §6336 is modelled as a two-branch classification (return to owner upon
//    payment/bond, versus immediate public sale) plus the duty to appraise;
//    the actual notice CONTENT and the bond's form/sureties are
//    `EXTERNAL_DEPENDENCY` (Secretary-prescribed).
//  - §6338(a)-(c) are duties of the Secretary to issue sale certificates and
//    deeds; §6339(a)-(c) are the certificate/deed's INSTITUTIONAL EFFECTS
//    (evidentiary weight, conveyance, discharge of junior interests) rather
//    than duties — modelled as `institutional_effect` relations keyed to the
//    certificate/deed having issued; (d) is `NON_NORMATIVE` cross-references.
//  - §6340(a)-(b) are a recordkeeping duty and the record's evidentiary
//    effect; (c) is a duty to furnish an accounting to the taxpayer.
//  - §6341 is modelled as an institutional effect (the Secretary's
//    determination of allowable expenses) rather than a duty, since the
//    statute states no addressee/beneficiary or performance window — it is
//    the Secretary's own administrative determination that FEEDS §6342(a)'s
//    "expenses of the proceedings" tier (already modelled in
//    06-estate-gift-liens-redemption-proceeds.law).
//  - §6342(b) is modelled as a duty to credit/refund surplus proceeds upon
//    application and satisfactory proof — the "satisfactory proof" element
//    is DECISION-0194 evaluative (the Secretary's own judgment), modelled as
//    an `external judgment relation` naming the Secretary as the authority,
//    per the evaluative-elements channel.
//  - §6344 is entirely cross-references to §6502/§6503 (assessment, owned by
//    `us.irc.assessment`), §7804(c) (delinquent officers), §6807 and §7506
//    (outside this package's scope) — `NON_NORMATIVE`, no independent rule.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    IRC_S6333,
    IRC_S6336,
    IRC_S6338_A,
    IRC_S6338_B,
    IRC_S6338_C,
    IRC_S6339_A,
    IRC_S6339_B,
    IRC_S6339_C,
    IRC_S6340_A,
    IRC_S6340_B,
    IRC_S6340_C,
    IRC_S6341,
    IRC_S6342_B,
    Levy,
    Person,
    Secretary,
};

// ============================================================================
// §6333 — Production of books
// ============================================================================

relation levy_made_or_about_to_be_made(p: Person, levy: Levy) kind empirical {
    label en unofficial "case fact: a levy has been made, or is about to be made, on property or a right to property — §6333's own trigger";
}
relation custodian_has_relevant_books(custodian: Person, levy: Levy) kind empirical {
    label en unofficial "case fact: the person has custody or control of books/records containing evidence or statements relating to the levied property or right to property";
}
relation secretary_demanded_books(custodian: Person, levy: Levy, on: Date) kind empirical;
pub relation books_production_owed(custodian: Person, levy: Levy) kind institutional;
@source(IRC_S6333, relation = formalizes, coverage = exact, quote = "any person having custody or control of any books or records, containing evidence or statements relating to the property or right to property subject to levy, shall, upon demand of the Secretary, exhibit such books or records to the Secretary")
rule S6333ProductionOfBooksDuty strict {
    for custodian: Person;
    for levy: Levy;
    for on: Date;
    when levy_made_or_about_to_be_made(custodian, levy) and custodian_has_relevant_books(custodian, levy) and secretary_demanded_books(custodian, levy, on);
    then duty ExhibitBooksAndRecords {
        bearer custodian;
        beneficiary Secretary;
        goal achievement {
            condition true;
            window [on, infinity];
        }
    };
}

// ============================================================================
// §6336 — Sale of perishable goods
// ============================================================================

relation seized_property_liable_to_perish(p: Person, appraised_value: Money) kind empirical {
    label en unofficial "case fact: the Secretary determined the seized property is liable to perish or waste — §6336's own trigger, coupled with the Secretary's own appraisal of value";
}
relation owner_readily_found(p: Person) kind empirical;
relation owner_paid_appraised_value_or_bonded(p: Person) kind empirical {
    label en unofficial "case fact: within the time specified in the Secretary's notice, the owner paid the appraised value or gave the prescribed bond — §6336(1)(A)-(B)";
}
pub relation perishable_property_returned_to_owner(p: Person) kind institutional;
@source(IRC_S6336, relation = formalizes, coverage = partial, quote = "The property shall be returned to the owner if, within such time as may be specified in the notice, the owner")
rule S6336ReturnToOwnerBranch strict {
    for p: Person;
    for appraised_value: Money;
    when seized_property_liable_to_perish(p, appraised_value) and owner_readily_found(p) and owner_paid_appraised_value_or_bonded(p);
    then perishable_property_returned_to_owner(p);
}
pub relation perishable_property_immediate_sale_required(p: Person) kind institutional;
@source(IRC_S6336, relation = formalizes, coverage = partial, quote = "If the owner does not pay such amount or furnish such bond in accordance with this section, the Secretary shall as soon as practicable make public sale of the property")
rule S6336ImmediateSaleBranch defeasible {
    for p: Person;
    for appraised_value: Money;
    when seized_property_liable_to_perish(p, appraised_value);
    then perishable_property_immediate_sale_required(p);
    unless perishable_property_returned_to_owner(p) and seized_property_liable_to_perish(p, appraised_value);
}
rule S6336AppraisalDuty strict {
    for p: Person;
    for appraised_value: Money;
    when seized_property_liable_to_perish(p, appraised_value);
    then duty AppraisePerishableProperty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6338 — Certificate of sale; deed of real property
// ============================================================================

relation purchase_price_paid_in_full(p: Person, on: Date) kind empirical {
    label en unofficial "case fact: the §6335 sale purchaser paid the purchase price in full — §6338(a)'s own trigger";
}
pub relation certificate_of_sale_owed(p: Person) kind institutional;
@source(IRC_S6338_A, relation = formalizes, coverage = exact, quote = "the Secretary shall give to the purchaser a certificate of sale upon payment in full of the purchase price")
rule S6338aCertificateOfSaleDuty strict {
    for p: Person;
    for on: Date;
    when purchase_price_paid_in_full(p, on);
    then duty GiveCertificateOfSale {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition true;
            window [on, infinity];
        }
    };
}

relation real_property_not_redeemed(p: Person) kind empirical {
    label en unofficial "case fact: real property sold under §6335 was NOT redeemed within the §6337 180-day window — §6338(b)'s own trigger; consumers should tie this to `redemption_within_period_permitted` being FALSE_ONLY once that relation is evaluated";
}
relation certificate_of_sale_surrendered(p: Person, on: Date) kind empirical;
pub relation deed_to_real_property_owed(p: Person) kind institutional;
@source(IRC_S6338_B, relation = formalizes, coverage = partial, quote = "upon his surrender of the certificate of sale, a deed of the real property so purchased by him")
rule S6338bDeedDuty strict {
    for p: Person;
    for on: Date;
    when real_property_not_redeemed(p) and certificate_of_sale_surrendered(p, on);
    then duty ExecuteDeedToRealProperty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition true;
            window [on, infinity];
        }
    };
}

relation real_property_purchased_by_united_states(p: Person) kind empirical;
pub relation deed_to_united_states_owed(p: Person) kind institutional;
@source(IRC_S6338_C, relation = formalizes, coverage = exact, quote = "the Secretary shall at the proper time execute a deed therefor; and without delay cause such deed to be duly recorded in the proper registry of deeds")
rule S6338cDeedToUnitedStatesDuty strict {
    for p: Person;
    when real_property_purchased_by_united_states(p);
    then duty ExecuteAndRecordDeedToUnitedStates {
        bearer Secretary;
        beneficiary Secretary;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6339 — Legal effect of certificate of sale and deed
// ============================================================================

pub relation personal_property_certificate_transfers_title(p: Person) kind institutional {
    label en unofficial "§6339(a)(2): the certificate of sale of personal property transfers to the purchaser all right, title, and interest of the delinquent party in and to the property sold";
}
@source(IRC_S6339_A, relation = formalizes, coverage = exact, quote = "Shall transfer to the purchaser all right, title, and interest of the party delinquent in and to the property sold")
rule S6339a2CertificateTransfersTitle strict {
    for p: Person;
    when certificate_of_sale_owed(p);
    then personal_property_certificate_transfers_title(p);
}
pub relation real_property_deed_conveys_title(p: Person) kind institutional {
    label en unofficial "§6339(b)(2): if the Secretary's proceedings were substantially in accordance with law, the deed operates as a conveyance of all right, title, and interest the delinquent party had at the time the federal lien attached";
}
relation sale_proceedings_substantially_lawful(p: Person) kind empirical;
@source(IRC_S6339_B, relation = formalizes, coverage = exact, quote = "such deed shall be considered and operate as a conveyance of all the right, title, and interest the party delinquent had in and to the real property thus sold at the time the lien of the United States attached thereto")
rule S6339b2DeedConveysTitle strict {
    for p: Person;
    when deed_to_real_property_owed(p) and sale_proceedings_substantially_lawful(p);
    then real_property_deed_conveys_title(p);
}
pub relation junior_interests_discharged_by_sale(p: Person) kind institutional {
    label en unofficial "§6339(c): the certificate of sale (personal property) or deed (real property) discharges the property from all liens, encumbrances, and titles over which the federal lien on which the levy was made had priority";
}
@source(IRC_S6339_C, relation = formalizes, coverage = exact, quote = "shall discharge such property from all liens, encumbrances, and titles over which the lien of the United States with respect to which the levy was made had priority")
rule S6339cJuniorInterestsDischarged strict {
    for p: Person;
    when certificate_of_sale_owed(p);
    then junior_interests_discharged_by_sale(p);
}
rule S6339cJuniorInterestsDischargedByDeed strict {
    for p: Person;
    when deed_to_real_property_owed(p);
    then junior_interests_discharged_by_sale(p);
}

// ============================================================================
// §6340 — Records
// ============================================================================

relation sale_or_redemption_occurred(district: Text, p: Person) kind empirical {
    label en unofficial "case fact: a §6335 sale, or a §6337 redemption, occurred in this internal revenue district for this person's property";
}
pub relation sale_record_kept(district: Text) kind institutional;
@source(IRC_S6340_A, relation = formalizes, coverage = partial, quote = "The Secretary shall, for each internal revenue district, keep a record of all sales of property under section 6335 and of redemptions of such property.")
rule S6340aRecordkeepingDuty strict {
    for district: Text;
    for p: Person;
    when sale_or_redemption_occurred(district, p);
    then duty KeepSaleAndRedemptionRecord {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}
pub relation certified_record_copy_is_evidence(district: Text) kind institutional;
@source(IRC_S6340_B, relation = formalizes, coverage = exact, quote = "A copy of such record, or any part thereof, certified by the Secretary shall be evidence in any court of the truth of the facts therein stated.")
rule S6340bCertifiedCopyEvidence strict {
    for district: Text;
    when sale_record_kept(district);
    then certified_record_copy_is_evidence(district);
}
pub relation taxpayer_accounting_owed(p: Person) kind institutional;
@source(IRC_S6340_C, relation = formalizes, coverage = partial, quote = "The taxpayer with respect to whose liability the sale was conducted or who redeemed the property shall be furnished")
rule S6340cAccountingDuty strict {
    for district: Text;
    for p: Person;
    when sale_or_redemption_occurred(district, p);
    then duty FurnishTaxpayerAccounting {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6341 — Expense of levy and sale
// ============================================================================

pub relation levy_and_sale_expenses_determined(p: Person, levy: Levy, amount: Money) kind institutional {
    label en unofficial "§6341: the Secretary determines the expenses to be allowed in all cases of levy and sale — feeds §6342(a)'s first (expenses) tier";
}
relation levy_and_sale_expenses_determination_made(p: Person, levy: Levy, amount: Money) kind empirical;
@source(IRC_S6341, relation = formalizes, coverage = exact, quote = "The Secretary shall determine the expenses to be allowed in all cases of levy and sale.")
rule S6341ExpenseDetermination strict {
    for p: Person;
    for levy: Levy;
    for amount: Money;
    when levy_and_sale_expenses_determination_made(p, levy, amount);
    then levy_and_sale_expenses_determined(p, levy, amount);
}

// ============================================================================
// §6342(b) — Surplus proceeds
// ============================================================================

relation surplus_proceeds_exist(p: Person, levy: Levy, surplus: Money) kind empirical {
    label en unofficial "case fact: a surplus remains after §6342(a)'s three-tier application of proceeds";
}
relation surplus_claim_applied_for(claimant: Person, p: Person, levy: Levy) kind empirical;
pub relation surplus_proof_satisfactory(claimant: Person, p: Person, levy: Levy) kind institutional {
    label en unofficial "§6342(b)'s evaluative element: whether the claimant's proof in support of the application is satisfactory — DECISION-0194 channel: external judgment of the Secretary";
}
external judgment relation surplus_proof_judged_satisfactory(claimant: Person, p: Person, levy: Levy) {
    authority Secretary;
    label en unofficial "the claimant's proof in support of a §6342(b) surplus-proceeds application is satisfactory to the Secretary";
}
rule S6342bProofJudgedSatisfactory strict {
    for claimant: Person;
    for p: Person;
    for levy: Levy;
    when surplus_proof_judged_satisfactory(claimant, p, levy);
    then surplus_proof_satisfactory(claimant, p, levy);
}
pub relation surplus_proceeds_credit_or_refund_owed(claimant: Person, p: Person, levy: Levy) kind institutional;
@source(IRC_S6342_B, relation = formalizes, coverage = exact, quote = "Any surplus proceeds remaining after the application of subsection (a) shall, upon application and satisfactory proof in support thereof, be credited or refunded by the Secretary to the person or persons legally entitled thereto")
rule S6342bSurplusCreditOrRefundDuty strict {
    for claimant: Person;
    for p: Person;
    for levy: Levy;
    for surplus: Money;
    when surplus_proceeds_exist(p, levy, surplus) and surplus_claim_applied_for(claimant, p, levy) and surplus_proof_satisfactory(claimant, p, levy);
    then duty CreditOrRefundSurplusProceeds {
        bearer Secretary;
        beneficiary claimant;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// §6344's (a)-(c) are entirely cross-references (to §6502/§6503, owned by
// `us.irc.assessment`; §7804(c); §6807; §7506) — no independent rule.
