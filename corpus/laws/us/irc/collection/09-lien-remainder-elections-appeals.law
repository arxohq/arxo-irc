// §6323(d) (45-day period for making disbursements — a fourth priority
// exception alongside (b)/(c)), §6323(e) (priority of interest and expenses
// riding on an already-superior lien/security interest), §6323(i)(1)-(4)
// (special rules: actual notice/knowledge, subrogation, forfeitures,
// cost-of-living adjustment), §6324A (deferred estate tax lien: the executor's
// election as a `power`, the agreement as its validity condition),
// §6324B (§2032A special-use-valuation lien), §6325(c) (release/discharge
// of an estate/gift tax lien), §6325(g) (filing certificates/notices in an
// alternate office), §6326 (administrative appeal of an erroneous lien
// filing, and the release duty that follows). STAGE 2b (agent F04,
// 25.09.2026).
//
// JUDGMENT CALLS (see report):
//  - §6323(d) is a FOURTH priority-exception category (alongside superpriority
//    (b), commercial-financing (c), and — filed elsewhere — refiling (g));
//    modelled with its own `SuperpriorityCategory` value composing through
//    the SAME general `lien_priority_over`/`superpriority_protected`
//    mechanism (02-lien-arising-period-priority.law), per the pattern set in
//    stage 2a's §6323(c)/§6324(c) work.
//  - §6323(e)'s six (1)-(6) riding-priority items are folded into ONE
//    empirical "this item rides the already-superior lien/security
//    interest's priority" fact per item category — same one-relation/many-
//    rules choice as the other enumerated lists in this package.
//  - §6323(i)(1) (constructive notice/knowledge through due diligence) is
//    modelled as an institutional definition feeding the SAME
//    `commercial_transactions_financing_agreement_qualifies`-style facts
//    stage 2a already declared (a claimant's "actual notice or knowledge"
//    fact in those rules can now be satisfied either directly or through
//    this constructive-notice test) — not a new consuming rule, since those
//    facts are supplied by the case either way; recorded `EXECUTABLE` as a
//    definition available for a case to invoke.
//  - §6323(i)(2) (subrogation) is modelled generically: a person subrogated
//    under local law to another's lien/interest rights is subrogated for
//    purposes of the §6321 OR §6324 lien — a case fact naming the
//    subrogated person directly (this package does not re-derive local-law
//    subrogation itself, only its FEDERAL-LIEN consequence).
//  - §6323(i)(3) (forfeiture relation-back) is modelled as a date-relation-
//    back institutional effect, with the intervening-claim exception as an
//    `unless`.
//  - §6323(i)(4) (COLA on the (b)(4)/(b)(7) dollar amounts) is `SOURCE_GAP`:
//    the statutory formula references section 1(f)(3) inflation adjustment
//    machinery this package does not import, and the published indexed
//    dollar figures themselves are not pinned here.
//  - §6324A is modelled as an ELECTION power: `holder` the executor,
//    `exercise` the election-plus-agreement-filing, `valid_when` an estate
//    with a §6166 election AND the (c) agreement filed, `effect` the
//    (a)/(d)(2) lien arising. (b)'s maximum-value cap and (d)(3)'s priority
//    carve-outs (mirroring §6323(b)(6)/(c)(3) and the mechanic's-lienor rule)
//    are modelled; (d)(5)'s additional-property demand and (d)(6)'s
//    bond-preclusion are `NON_NORMATIVE`/`EXTERNAL_DEPENDENCY` administrative
//    mechanics not given independent rules this stage.
//  - §6324B is modelled the same way: the §2032A election is the `power`'s
//    `valid_when`, the lien's `effect`; (c)(1)'s cross-reference to
//    §6324A(d)(1),(3),(4) composes via the SAME priority mechanism rather
//    than restating it.
//  - §6325(c) is modelled as a `power` of the Secretary (discharge of
//    property from a §6324 lien on a finding of full satisfaction);
//    §6325(g) as an institutional effective-filing rule for an alternate
//    office.
//  - §6326(a) is modelled as a `power` of the taxpayer (the appeal itself);
//    (b) as the Secretary's duty to release upon finding the filing
//    erroneous, with the 14-day "to the extent practicable" window recorded
//    but not treated as a hard deadline (the statute itself hedges it).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    IRC_S6323_D,
    IRC_S6323_E,
    IRC_S6323_I,
    IRC_S6324A_A,
    IRC_S6324A_D,
    IRC_S6324B_A,
    IRC_S6325_C,
    IRC_S6325_G,
    IRC_S6326_A,
    IRC_S6326_B,
    Lien,
    Person,
    Secretary,
    SuperpriorityCategory,
    superpriority_protected,
};

// ============================================================================
// §6323(d) — 45-day period for making disbursements
// ============================================================================

relation disbursement_financed_security_interest_qualifies(claimant: Person, lien: Lien) kind empirical {
    label en unofficial "case fact: the claimant's security interest arose after tax lien filing by reason of disbursements made before the 46th day after tax lien filing (or, if earlier, before actual notice/knowledge of it), in property that was both subject to the §6321 lien at filing AND covered by a written agreement entered into before filing, protected under local law against a judgment lien — §6323(d)(1)-(2)";
}
@source(IRC_S6323_D, relation = formalizes, coverage = partial, quote = "such lien shall not be valid with respect to a security interest which came into existence after tax lien filing by reason of disbursements made before the 46th day after the date of tax lien filing")
rule S6323dDisbursementSecurityInterestProtected strict {
    for claimant: Person;
    for lien: Lien;
    when disbursement_financed_security_interest_qualifies(claimant, lien);
    then superpriority_protected(claimant, lien, FortyFiveDayDisbursementSecurityInterest);
}

// ============================================================================
// §6323(e) — Priority of interest and expenses
// ============================================================================

enum RidingPriorityItem {
    InterestOrCarryingCharges;          // (e)(1)
    IndentureTrusteeOrAgentExpenses;    // (e)(2)
    AttorneysFeesCollectingObligation;  // (e)(3)
    InsuringPreservingRepairingCosts;   // (e)(4)
    InsuringPaymentCosts;               // (e)(5)
    PriorLienSatisfactionAmounts;       // (e)(6)
}
relation riding_priority_item_qualifies(claimant: Person, lien: Lien, item: RidingPriorityItem) kind empirical {
    label en unofficial "case fact: under local law, this item has the same priority as the lien or security interest it relates to — the (e) chapeau's own test, per item category";
}
pub relation riding_priority_extended(claimant: Person, lien: Lien, item: RidingPriorityItem) kind institutional {
    label en unofficial "§6323(e): where the §6321 lien is not valid against a lien or security interest, that lien/interest's priority extends to this (1)-(6) item to the extent local law gives the item the same priority";
}
@source(IRC_S6323_E, relation = formalizes, coverage = partial, quote = "the priority of such lien or security interest shall extend to")
rule S6323eRidingPriorityExtended defeasible {
    for claimant: Person;
    for lien: Lien;
    for item: RidingPriorityItem;
    for spcategory: SuperpriorityCategory;
    when superpriority_protected(claimant, lien, spcategory) and riding_priority_item_qualifies(claimant, lien, item);
    then riding_priority_extended(claimant, lien, item);
}

// ============================================================================
// §6323(i) — Special rules
// ============================================================================

relation routine_communication_maintained(org: Person) kind empirical {
    label en unofficial "case fact: the organization maintains reasonable routines for communicating significant information to the person conducting the transaction, with reasonable compliance — §6323(i)(1)'s due-diligence test";
}
pub relation organization_exercises_due_diligence(org: Person) kind institutional;
@source(IRC_S6323_I, relation = formalizes, coverage = exact, quote = "An organization exercises due diligence if it maintains reasonable routines for communicating significant information to the person conducting the transaction and there is reasonable compliance with the routine.")
rule S6323i1DueDiligenceDefinition strict {
    for org: Person;
    when routine_communication_maintained(org);
    then organization_exercises_due_diligence(org);
}
relation fact_brought_to_individual_attention_on(org: Person, on: Date) kind empirical;
pub relation organization_deemed_to_have_notice_on(org: Person, on: Date) kind institutional {
    label en unofficial "§6323(i)(1): the organization is deemed to have actual notice/knowledge of a fact from the time it is brought to the attention of the individual conducting the transaction (or would have been, had due diligence been exercised)";
}
@source(IRC_S6323_I, relation = formalizes, coverage = partial, quote = "an organization shall be deemed for purposes of a particular transaction to have actual notice or knowledge of any fact from the time such fact is brought to the attention of the individual conducting such transaction")
rule S6323i1DeemedNoticeFromAttention strict {
    for org: Person;
    for on: Date;
    when fact_brought_to_individual_attention_on(org, on);
    then organization_deemed_to_have_notice_on(org, on);
}

relation subrogated_under_local_law(subrogee: Person, subrogor: Person, lien: Lien) kind empirical {
    label en unofficial "case fact: under local law, the subrogee is subrogated to the subrogor's rights with respect to a lien or interest";
}
pub relation subrogated_for_federal_lien_purposes(subrogee: Person, subrogor: Person, lien: Lien) kind institutional {
    label en unofficial "§6323(i)(2): the subrogee is subrogated to the subrogor's rights for purposes of any lien imposed by §6321 or §6324";
}
@source(IRC_S6323_I, relation = formalizes, coverage = exact, quote = "such person shall be subrogated to such rights for purposes of any lien imposed by section 6321 or 6324")
rule S6323i2SubrogationForFederalLien strict {
    for subrogee: Person;
    for subrogor: Person;
    for lien: Lien;
    when subrogated_under_local_law(subrogee, subrogor, lien);
    then subrogated_for_federal_lien_purposes(subrogee, subrogor, lien);
}

relation local_forfeiture_of_seized_property_on(claimant: Person, seized_on: Date) kind empirical {
    label en unofficial "case fact: local law forfeits property a state/county/local law-enforcement agency seized — §6323(i)(3)'s own condition";
}
relation intervening_claim_holder_has_local_priority(claimant: Person) kind empirical {
    label en unofficial "case fact: under local law, the holder of an intervening claim/interest would have priority over the state/county/local subdivision's interest — §6323(i)(3)'s own exception";
}
pub relation forfeiture_relates_back_to_seizure(claimant: Person, seized_on: Date) kind institutional {
    label en unofficial "§6323(i)(3): the forfeiture relates back to the time of seizure, for purposes of this subchapter";
}
@source(IRC_S6323_I, relation = formalizes, coverage = partial, quote = "a forfeiture under local law of property seized by a law enforcement agency of a State, county, or other local governmental subdivision shall relate back to the time of seizure")
rule S6323i3ForfeitureRelatesBack defeasible {
    for claimant: Person;
    for seized_on: Date;
    when local_forfeiture_of_seized_property_on(claimant, seized_on);
    then forfeiture_relates_back_to_seizure(claimant, seized_on);
    unless intervening_claim_holder_has_local_priority(claimant) and local_forfeiture_of_seized_property_on(claimant, seized_on);
}

// §6323(i)(4)'s cost-of-living adjustment to the (b)(4)/(b)(7) dollar
// amounts is SOURCE_GAP: it depends on the §1(f)(3) inflation-adjustment
// machinery (not imported here) and on the published indexed figures
// themselves (not pinned in this package's sources).

// ============================================================================
// §6324A — Special lien for estate tax deferred under section 6166
// ============================================================================

relation section_6166_election_made(decedent: Person) kind empirical {
    label en unofficial "case fact: an election under §6166 (deferred payment of estate tax attributable to a closely held business) has been made with respect to this estate — §6324A(a)'s own precondition";
}
relation section_6324a_election_made(executor: Person, decedent: Person, on: Date) kind empirical {
    label en unofficial "case fact: the executor made the §6324A election at the time/manner the Secretary prescribes — the exercise";
}
relation section_6324a_agreement_filed(executor: Person, decedent: Person) kind empirical {
    label en unofficial "case fact: the (c) written agreement (signed by every person with an interest in the designated property, consenting to the lien and designating a responsible person/agent) was filed";
}
pub relation section_6166_lien_election_valid(executor: Person, decedent: Person) kind institutional;
@source(IRC_S6324A_A, relation = formalizes, coverage = partial, quote = "if the executor makes an election under this section")
rule S6324aElectionValidityConditions strict {
    for executor: Person;
    for decedent: Person;
    when section_6166_election_made(decedent) and section_6324a_agreement_filed(executor, decedent);
    then section_6166_lien_election_valid(executor, decedent);
}
pub relation deferred_estate_tax_special_lien(lien: Lien, decedent: Person) kind institutional {
    label en unofficial "§6324A(a): the deferred amount (plus accrued interest, additional amount, addition to tax, assessable penalty, and costs attributable to it) is a lien in favor of the United States on the §6166 lien property";
}
relation section_6324a_lien_identity(lien: Lien, decedent: Person) kind empirical {
    label en unofficial "case-supplied identity: this Lien instance is the §6324A lien for this decedent's estate (same convention as `estate_lien_identity`/`gift_lien_identity` in the §6324 module)";
}
@source(IRC_S6324A_A, relation = formalizes, coverage = partial, quote = "the deferred amount (plus any interest, additional amount, addition to tax, assessable penalty, and costs attributable to the deferred amount) shall be a lien in favor of the United States on the section 6166 lien property")
rule S6324aLienElectionPower strict {
    for lien: Lien;
    for executor: Person;
    for decedent: Person;
    for on: Date;
    when section_6324a_election_made(executor, decedent, on) and section_6324a_lien_identity(lien, decedent);
    then power ElectDeferredEstateTaxLien {
        holder executor;
        exercise section_6324a_election_made(executor, decedent, on);
        valid_when section_6166_lien_election_valid(executor, decedent);
        effect deferred_estate_tax_special_lien(lien, decedent);
    };
}

relation executor_discharged_under_2204_on(executor: Person, decedent: Person, on: Date) kind empirical {
    label en unofficial "case fact: the executor is discharged from liability under §2204 (owned by `estate-gift`, not imported — the discharge event itself is a case fact here) — §6324A(d)(2)'s alternative starting event";
}
relation section_6324a_notice_filed_on(lien: Lien, on: Date) kind empirical {
    label en unofficial "case fact: notice of the §6324A lien meeting §6323(f) was filed — §6324A(d)(1)/(2)'s other alternative starting event";
}
pub relation deferred_estate_tax_lien_arising_date(lien: Lien, decedent: Person, on: Date) kind institutional {
    label en unofficial "§6324A(d)(2): the lien arises at the earlier of the executor's §2204 discharge or the (d)(1) notice filing";
}
@source(IRC_S6324A_D, relation = formalizes, coverage = partial, quote = "The lien imposed by this section shall arise at the time the executor is discharged from liability under section 2204 (or, if earlier, at the time notice is filed pursuant to paragraph (1))")
rule S6324ad2ArisesAtDischarge strict {
    for lien: Lien;
    for executor: Person;
    for decedent: Person;
    for discharged_on: Date;
    for filed_on: Date;
    when executor_discharged_under_2204_on(executor, decedent, discharged_on) and section_6324a_notice_filed_on(lien, filed_on) and discharged_on <= filed_on;
    then deferred_estate_tax_lien_arising_date(lien, decedent, discharged_on);
}
rule S6324ad2ArisesAtEarlierFiling strict {
    for lien: Lien;
    for executor: Person;
    for decedent: Person;
    for discharged_on: Date;
    for filed_on: Date;
    when executor_discharged_under_2204_on(executor, decedent, discharged_on) and section_6324a_notice_filed_on(lien, filed_on) and filed_on < discharged_on;
    then deferred_estate_tax_lien_arising_date(lien, decedent, filed_on);
}

relation real_property_tax_or_assessment_lien_under_6324a(claimant: Person, lien: Lien) kind empirical;
@source(IRC_S6324A_D, relation = formalizes, coverage = exact, quote = "Real property tax and special assessment liens")
rule S6324ad3ARealPropertyTaxLienProtected strict {
    for claimant: Person;
    for lien: Lien;
    when real_property_tax_or_assessment_lien_under_6324a(claimant, lien);
    then superpriority_protected(claimant, lien, RealPropertyTaxOrSpecialAssessmentLien);
}
relation mechanics_lienor_against_6324a_lien(claimant: Person, lien: Lien) kind empirical;
@source(IRC_S6324A_D, relation = formalizes, coverage = exact, quote = "In the case of any real property subject to a lien for repair or improvement, as against a mechanic's lienor.")
rule S6324ad3BMechanicsLienorProtected strict {
    for claimant: Person;
    for lien: Lien;
    when mechanics_lienor_against_6324a_lien(claimant, lien);
    then superpriority_protected(claimant, lien, MechanicsLienorUnderEstateOrGiftLien);
}
relation construction_financing_against_6324a_lien(claimant: Person, lien: Lien) kind empirical;
@source(IRC_S6324A_D, relation = formalizes, coverage = exact, quote = "As against any security interest set forth in paragraph (3) of section 6323(c)")
rule S6324ad3CConstructionFinancingProtected strict {
    for claimant: Person;
    for lien: Lien;
    when construction_financing_against_6324a_lien(claimant, lien);
    then superpriority_protected(claimant, lien, RealPropertyConstructionFinancingSecurityInterest);
}
pub relation section_6324_lien_excluded_where_6324a_applies(decedent: Person) kind institutional {
    label en unofficial "§6324A(d)(4): if there is a §6324A lien on property with respect to an estate, there is NOT also a §6324 lien on that property for the same estate";
}
@source(IRC_S6324A_D, relation = formalizes, coverage = exact, quote = "there shall not be any lien under section 6324 on such property with respect to the same estate")
rule S6324ad4LienInLieuOf6324 strict {
    for lien: Lien;
    for decedent: Person;
    when deferred_estate_tax_special_lien(lien, decedent);
    then section_6324_lien_excluded_where_6324a_applies(decedent);
}

// ============================================================================
// §6324B — Special lien for additional estate tax under section 2032A
// ============================================================================

relation section_2032a_election_filed(decedent: Person) kind empirical {
    label en unofficial "case fact: an election under §2032A (special-use valuation) was filed for this estate — §6324B(b)'s own exercise/starting event";
}
pub relation section_6324b_lien_election_valid(decedent: Person) kind institutional;
rule S6324bValidityIsElectionItself strict {
    for decedent: Person;
    when section_2032a_election_filed(decedent);
    then section_6324b_lien_election_valid(decedent);
}
pub relation qualified_real_property_special_lien(lien: Lien, decedent: Person, adjusted_tax_difference: Money) kind institutional {
    label en unofficial "§6324B(a): an amount equal to the §2032A(c)(2)(B) adjusted tax difference attributable to a qualified real property interest is a lien in favor of the United States on the property";
}
relation section_6324b_lien_identity(lien: Lien, decedent: Person) kind empirical {
    label en unofficial "case-supplied identity: this Lien instance is the §6324B lien for this decedent's estate";
}
relation section_2032a_adjusted_tax_difference(decedent: Person, adjusted_tax_difference: Money) kind empirical {
    label en unofficial "case fact: the §2032A(c)(2)(B) adjusted tax difference attributable to the qualified real property interest";
}
@source(IRC_S6324B_A, relation = formalizes, coverage = partial, quote = "an amount equal to the adjusted tax difference attributable to such interest (within the meaning of section 2032A(c)(2)(B)) shall be a lien in favor of the United States on the property in which such interest exists")
rule S6324bLienElectionPower strict {
    for lien: Lien;
    for decedent: Person;
    for adjusted_tax_difference: Money;
    when section_2032a_election_filed(decedent) and section_6324b_lien_identity(lien, decedent) and section_2032a_adjusted_tax_difference(decedent, adjusted_tax_difference);
    then power Elect2032ALien {
        holder decedent;
        exercise section_2032a_election_filed(decedent);
        valid_when section_6324b_lien_election_valid(decedent);
        effect qualified_real_property_special_lien(lien, decedent, adjusted_tax_difference);
    };
}
relation section_2032a_liability_satisfied_or_unenforceable(decedent: Person, on: Date) kind empirical;
relation section_2032a_no_further_liability_established(decedent: Person, on: Date) kind empirical {
    label en unofficial "case fact: it has been established to the Secretary's satisfaction that no further §2032A(c) tax liability may arise — §6324B(b)(2)'s alternative end condition";
}
pub relation qualified_real_property_lien_continues_on(lien: Lien, decedent: Person, on: Date) kind institutional {
    label en unofficial "§6324B(b): the lien continues until satisfied/unenforceable (b)(1), or until (b)(2)'s no-further-liability finding — modelled as a defeasible continuation, defeated by either terminating event";
}
relation section_2032a_lien_checked_on(lien: Lien, decedent: Person, on: Date) kind empirical;
rule S6324bLienContinuesUnlessTerminated defeasible {
    for lien: Lien;
    for decedent: Person;
    for on: Date;
    when section_2032a_election_filed(decedent) and section_2032a_lien_checked_on(lien, decedent, on);
    then qualified_real_property_lien_continues_on(lien, decedent, on);
    unless section_2032a_liability_satisfied_or_unenforceable(decedent, on) and section_2032a_election_filed(decedent) and section_2032a_lien_checked_on(lien, decedent, on);
    unless section_2032a_no_further_liability_established(decedent, on) and section_2032a_election_filed(decedent) and section_2032a_lien_checked_on(lien, decedent, on);
}

// ============================================================================
// §6325(c) — Release/discharge of estate or gift tax lien
// ============================================================================

relation estate_or_gift_lien_liability_satisfied_or_provided_for(decedent_or_donor: Person) kind empirical {
    label en unofficial "case fact: the Secretary finds the liability secured by the §6324 lien fully satisfied or provided for — §6325(c)'s own condition";
}
pub relation estate_gift_lien_discharge_certificate_issuable(decedent_or_donor: Person) kind institutional;
@source(IRC_S6325_C, relation = formalizes, coverage = exact, quote = "the Secretary may issue a certificate of discharge of any or all of the property subject to any lien imposed by section 6324 if the Secretary finds that the liability secured by such lien has been fully satisfied or provided for")
rule S6325cDischargePower strict {
    for decedent_or_donor: Person;
    when estate_or_gift_lien_liability_satisfied_or_provided_for(decedent_or_donor);
    then power IssueEstateGiftLienDischargeCertificate {
        holder Secretary;
        exercise estate_or_gift_lien_liability_satisfied_or_provided_for(decedent_or_donor);
        valid_when estate_or_gift_lien_liability_satisfied_or_provided_for(decedent_or_donor);
        effect estate_gift_lien_discharge_certificate_issuable(decedent_or_donor);
    };
}

// ============================================================================
// §6325(g) — Filing of certificates and notices
// ============================================================================

relation state_office_unavailable_for_certificate(lien: Lien) kind empirical {
    label en unofficial "case fact: a §6325 certificate/notice may not be filed in the State-designated office where the §6321 notice of lien is filed";
}
pub relation certificate_effective_if_filed_in_district_court(lien: Lien) kind institutional;
@source(IRC_S6325_G, relation = formalizes, coverage = exact, quote = "such certificate or notice shall be effective if filed in the office of the clerk of the United States district court for the judicial district in which such office is situated")
rule S6325gAlternateFilingOfficeEffective strict {
    for lien: Lien;
    when state_office_unavailable_for_certificate(lien);
    then certificate_effective_if_filed_in_district_court(lien);
}

// ============================================================================
// §6326 — Administrative appeal regarding lien filing
// ============================================================================

relation lien_filing_appeal_made(p: Person, lien: Lien, on: Date) kind empirical {
    label en unofficial "case fact: the person appealed to the Secretary, in the prescribed form and time, alleging an error in the filing of a notice of lien on their property — §6326(a)'s exercise";
}
pub relation lien_filing_appeal_available(p: Person, lien: Lien) kind institutional;
@source(IRC_S6326_A, relation = formalizes, coverage = exact, quote = "any person shall be allowed to appeal to the Secretary after the filing of a notice of a lien under this subchapter on the property or the rights to property of such person for a release of such lien alleging an error in the filing of the notice of such lien")
rule S6326aAppealPower strict {
    for p: Person;
    for lien: Lien;
    for on: Date;
    when lien_filing_appeal_made(p, lien, on);
    then power AppealErroneousLienFiling {
        holder p;
        exercise lien_filing_appeal_made(p, lien, on);
        valid_when lien_filing_appeal_made(p, lien, on);
        effect lien_filing_appeal_pending(p, lien);
    };
}
pub relation lien_filing_appeal_pending(p: Person, lien: Lien) kind institutional;

relation secretary_determines_filing_erroneous(lien: Lien, determined_on: Date) kind empirical {
    label en unofficial "case fact: the Secretary determined that the filing of the notice of the lien was erroneous — §6326(b)'s own condition";
}
pub relation erroneous_lien_release_certificate_owed(lien: Lien, determined_on: Date) kind institutional {
    label en unofficial "§6326(b): the Secretary shall expeditiously (and, to the extent practicable, within 14 days after the determination) issue a certificate of release stating the filing was erroneous";
}
@source(IRC_S6326_B, relation = formalizes, coverage = exact, quote = "the Secretary shall expeditiously (and, to the extent practicable, within 14 days after such determination) issue a certificate of release of such lien and shall include in such certificate a statement that such filing was erroneous")
rule S6326bErroneousReleaseDuty strict {
    for lien: Lien;
    for determined_on: Date;
    when secretary_determines_filing_erroneous(lien, determined_on);
    then duty IssueErroneousLienReleaseCertificate {
        bearer Secretary;
        beneficiary Secretary;
        goal achievement {
            condition true;
            window [determined_on, add_calendar_period(determined_on, 14 calendar_day)];
        }
    };
}
