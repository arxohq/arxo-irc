test "S6302b-01-DISCRETIONARY-DEVICE-AUTHORIZED" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert tax_within_discretionary_chapters(entity_ref("urn:us:irc:collection:clir#TP20"), entity_ref("urn:us:irc:collection:clir#A20")) { id "f0"; origin case_input; }
        assert discretionary_collection_device_used(entity_ref("urn:us:irc:collection:clir#TP20"), entity_ref("urn:us:irc:collection:clir#A20"), @2026-04-15) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(UseDiscretionaryCollectionDevice, ACTIVE);
}

