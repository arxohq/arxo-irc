        context { decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; legal_time @2026-09-26; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert contractor_fiscal_year_ended_on(@2026-09-30) { id "f0"; origin case_input; }
        assert contractor_report_number(@2026-09-30, 2) { id "f1"; origin case_input; }
        assert contractor_report_independent_evaluation(@2026-09-30) { id "f2"; origin case_input; }
        assert contractor_report_measurement_plan(@2026-09-30) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(S6306j2BiannualItemsDuty, SATISFIED);
}

test "S6306-46-EVALUATION-WITHOUT-MEASUREMENT-PLAN-IS-NOT-COMPLETE" {
    given {
        context { decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; legal_time @2026-09-26; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert contractor_report_independent_evaluation(@2026-09-30) { id "f0"; origin case_input; }
    }
    evaluate truth(contractor_biannual_items_included(@2026-09-30));
    expect truth_status == NEITHER;
}

// --- Pub. L. 119-64 §2(b) wired to `us.irc.administration` (stage 4) -----------
test "S6303B2-40-MANDATORY-7508A-POSTPONEMENT-FROM-ADMINISTRATION-MOVES-THE-PAYMENT-DATE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert last_date_prescribed_for_payment(entity_ref("urn:us:irc:collection:clir#A1"), @2026-04-15) { id "f0"; origin case_input; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A1"), entity_ref("urn:us:irc:collection:clir#P1")) { id "f1"; origin case_input; }
        assert payment_demand_attempted_on(entity_ref("urn:us:irc:collection:clir#A1"), entity_ref("urn:us:irc:collection:clir#P1"), @2026-06-01) { id "f2"; origin case_input; }
        assert us.irc.administration::mandatory_deadline_postponed(entity_ref("urn:us:irc:collection:clir#P1"), us.irc.administration::PaymentOfTax, entity_ref("urn:us:irc:collection:clir#DA1"), @2026-04-15, @2026-10-15) { id "f3"; origin case_input; }
    }
    evaluate truth(last_date_prescribed_for_payment_effective(entity_ref("urn:us:irc:collection:clir#A1"), @2026-10-15));
    expect truth_status == TRUE_ONLY;
}

test "S6303B2-41-POSTPONEMENT-OF-ANOTHER-ACT-KIND-DOES-NOT-MOVE-THE-PAYMENT-DATE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert last_date_prescribed_for_payment(entity_ref("urn:us:irc:collection:clir#A2"), @2026-04-15) { id "f0"; origin case_input; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A2"), entity_ref("urn:us:irc:collection:clir#P2")) { id "f1"; origin case_input; }
        assert payment_demand_attempted_on(entity_ref("urn:us:irc:collection:clir#A2"), entity_ref("urn:us:irc:collection:clir#P2"), @2026-06-01) { id "f2"; origin case_input; }
        assert us.irc.administration::mandatory_deadline_postponed(entity_ref("urn:us:irc:collection:clir#P2"), us.irc.administration::FilingReturn, entity_ref("urn:us:irc:collection:clir#DA1"), @2026-04-15, @2026-10-15) { id "f3"; origin case_input; }
    }
    evaluate truth(last_date_prescribed_for_payment_effective(entity_ref("urn:us:irc:collection:clir#A2"), @2026-10-15));
    expect truth_status == NEITHER;
}
