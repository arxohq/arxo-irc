    given {
        context { decision_time @2026-03-01T02:00:00-04:00; knowledge_time @2026-03-01T02:00:00-04:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert communication_by_secretary(entity_ref("urn:us:irc:collection:clir#Taxpayer5"), @2026-03-01) { id "f0"; origin case_input; }
        assert communication_at_unusual_time_or_place(entity_ref("urn:us:irc:collection:clir#Taxpayer5"), @2026-03-01) { id "f1"; origin case_input; }
    }
    evaluate truth(collection_communication_prohibited(entity_ref("urn:us:irc:collection:clir#Taxpayer5"), @2026-03-01));
