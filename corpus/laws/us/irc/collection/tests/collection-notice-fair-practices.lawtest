// Scenarios for §6301, §6303(a)-(b), §6304, module
// 01-collection-notice-fair-practices.law. NOT executed in this stage —
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

test "S6303-01-NOTICE-GIVEN-WITHIN-60-DAYS-DUTY-SATISFIED" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A1"), entity_ref("urn:us:irc:collection:clir#Taxpayer1")) { id "f0"; origin case_input; }
        assert us.irc.core::assessed_on(entity_ref("urn:us:irc:collection:clir#A1"), @2026-01-01) { id "f1"; origin case_input; }
        assert notice_given(NoticeAndDemandForPayment, entity_ref("urn:us:irc:collection:clir#Taxpayer1")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(GiveNoticeAndDemand, SATISFIED);
}

test "S6303-02-NOTICE-NOT-GIVEN-BY-DAY-60-VIOLATED" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A2"), entity_ref("urn:us:irc:collection:clir#Taxpayer2")) { id "f0"; origin case_input; }
        assert us.irc.core::assessed_on(entity_ref("urn:us:irc:collection:clir#A2"), @2026-01-01) { id "f1"; origin case_input; }
        // no notice_given asserted — 60-day window (2026-01-01 to 2026-03-02) has closed.
    }
    evaluate positions();
    expect position(GiveNoticeAndDemand, VIOLATED);
}

test "S6303-03-DEMAND-BEFORE-LAST-PAYMENT-DATE-NOT-YET-DEMANDABLE" {
    given {
        context { decision_time @2026-02-01T09:00:00-04:00; knowledge_time @2026-02-01T09:00:00-04:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A3"), entity_ref("urn:us:irc:collection:clir#Taxpayer3")) { id "f0"; origin case_input; }
        assert last_date_prescribed_for_payment(entity_ref("urn:us:irc:collection:clir#A3"), @2026-04-15) { id "f1"; origin case_input; }
        assert payment_demand_attempted_on(entity_ref("urn:us:irc:collection:clir#A3"), entity_ref("urn:us:irc:collection:clir#Taxpayer3"), @2026-02-01) { id "f2"; origin case_input; }
    }
    evaluate truth(demand_may_be_made(entity_ref("urn:us:irc:collection:clir#A3"), entity_ref("urn:us:irc:collection:clir#Taxpayer3"), @2026-02-01));
    expect truth_status == NEITHER;
}

test "S6303-04-JEOPARDY-ALLOWS-IMMEDIATE-DEMAND-BEFORE-LAST-PAYMENT-DATE" {
    given {
        context { decision_time @2026-02-01T09:00:00-04:00; knowledge_time @2026-02-01T09:00:00-04:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A4"), entity_ref("urn:us:irc:collection:clir#Taxpayer4")) { id "f0"; origin case_input; }
        assert last_date_prescribed_for_payment(entity_ref("urn:us:irc:collection:clir#A4"), @2026-04-15) { id "f1"; origin case_input; }
        assert payment_demand_attempted_on(entity_ref("urn:us:irc:collection:clir#A4"), entity_ref("urn:us:irc:collection:clir#Taxpayer4"), @2026-02-01) { id "f2"; origin case_input; }
        assert jeopardy_finding(entity_ref("urn:us:irc:collection:clir#Taxpayer4")) { id "f3"; origin case_input; }
    }
    evaluate truth(demand_may_be_made(entity_ref("urn:us:irc:collection:clir#A4"), entity_ref("urn:us:irc:collection:clir#Taxpayer4"), @2026-02-01));
    expect truth_status == TRUE_ONLY;
}

