// Final TECH_GAP pass (26.09.2026): section 6302(e)(1) (G5606). NOT EXECUTED (implemented_unverified).
// The test family carries the business-day calendar snapshot derived from 5 U.S.C. 6103 (`us.code.clir.federal_calendar`, 2026).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

test "S6302E1-01-PERIOD-STARTING-ON-THE-16TH" {
    // period from 2026-06-16: the 2nd period following starts 2026-07-16, its 1st week closes 2026-07-22, the 3rd business day after is 2026-07-27.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.collection::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": semimonthly_period_start_6302e1(entity_ref("urn:test:s6302e:p"), @2026-06-16) { origin case_input; }
    }
    evaluate truth(communications_deposit_due_date_6302e1(entity_ref("urn:test:s6302e:p"), @2026-06-16, @2026-07-27));
    expect truth_status == TRUE_ONLY;
}

test "S6302E1-02-PERIOD-STARTING-ON-THE-1ST" {
    // period from 2026-06-01: 2nd following starts 2026-07-01, week closes 2026-07-07, 3rd business day 2026-07-10.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.collection::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": semimonthly_period_start_6302e1(entity_ref("urn:test:s6302e:p"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(communications_deposit_due_date_6302e1(entity_ref("urn:test:s6302e:p"), @2026-06-01, @2026-07-10));
    expect truth_status == TRUE_ONLY;
}

test "S6302E1-03-HOLIDAY-IN-THE-COUNT-IS-SKIPPED" {
    // week closing 2026-06-30 (start 2026-05-24 for the arithmetic): 7/1, 7/2, (7/3 is a federal holiday), 7/6 = 2026-07-06.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.collection::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": semimonthly_period_start_6302e1(entity_ref("urn:test:s6302e:p"), @2026-05-24) { origin case_input; }
    }
    evaluate truth(communications_deposit_due_date_6302e1(entity_ref("urn:test:s6302e:p"), @2026-05-24, @2026-07-06));
    expect truth_status == TRUE_ONLY;
}
