test "S6321-01-LIEN-ARISES-AFTER-NEGLECT-OR-REFUSAL" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert lien_identity(entity_ref("urn:us:irc:collection:clir#Lien1"), entity_ref("urn:us:irc:collection:clir#TP1"), entity_ref("urn:us:irc:collection:clir#A1")) { id "f0"; origin case_input; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A1"), entity_ref("urn:us:irc:collection:clir#TP1")) { id "f1"; origin case_input; }
        assert neglected_or_refused_to_pay(entity_ref("urn:us:irc:collection:clir#TP1"), entity_ref("urn:us:irc:collection:clir#A1")) { id "f2"; origin case_input; }
    }
    evaluate truth(lien_arises(entity_ref("urn:us:irc:collection:clir#Lien1"), entity_ref("urn:us:irc:collection:clir#TP1"), entity_ref("urn:us:irc:collection:clir#A1")));
    expect truth_status == TRUE_ONLY;
}

