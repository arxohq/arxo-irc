        assert liability_fully_satisfied_or_unenforceable_on(entity_ref("urn:us:irc:collection:clir#TP6"), entity_ref("urn:us:irc:collection:clir#A6"), @2026-02-01) { id "f1"; origin case_input; }
        assert certificate_of_release_issued(entity_ref("urn:us:irc:collection:clir#Lien6")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(IssueCertificateOfRelease, SATISFIED);
}

test "S6325A-02-RELEASE-DUTY-VIOLATED-PAST-30-DAY-WINDOW" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert lien_arises(entity_ref("urn:us:irc:collection:clir#Lien7"), entity_ref("urn:us:irc:collection:clir#TP7"), entity_ref("urn:us:irc:collection:clir#A7")) { id "f0"; origin case_input; }
        assert liability_fully_satisfied_or_unenforceable_on(entity_ref("urn:us:irc:collection:clir#TP7"), entity_ref("urn:us:irc:collection:clir#A7"), @2026-02-01) { id "f1"; origin case_input; }
        // no certificate issued — 30-day window (2026-02-01 to 2026-03-03) closed.
    }
    evaluate positions();
    expect position(IssueCertificateOfRelease, VIOLATED);
}

