// Scenarios for §6320, §6325(a),(b),(d),(e),(f), module
// 03-lien-hearing-and-release.law. NOT executed in this stage —
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

test "S6320A2-01-CERTIFIED-CANDIDATE-CONFIRMED-AS-FIVE-BUSINESS-DAY-WINDOW-END" {
    given {
        context { decision_time @2026-01-10T09:00:00-04:00; knowledge_time @2026-01-10T09:00:00-04:00; legal_time @2026-01-10; timezone "America/New_York"; }
        // 2026-01-01 is a Thursday; the case's own calendar (EXTERNAL_DEPENDENCY)
        // certifies 2026-01-08 as the 5th business day after filing.
        assert lien_filing_notice_window_candidate(entity_ref("urn:us:irc:collection:clir#Lien1"), @2026-01-01, @2026-01-08) { id "f0"; origin case_input; }
        assert candidate_is_5th_business_day_after_filing(entity_ref("urn:us:irc:collection:clir#Lien1"), @2026-01-01, @2026-01-08) { id "f1"; origin case_input; }
    }
    evaluate truth(lien_filing_notice_window_end(entity_ref("urn:us:irc:collection:clir#Lien1"), @2026-01-01, @2026-01-08));
    expect truth_status == TRUE_ONLY;
}

test "S6320A2-02-UNCERTIFIED-CANDIDATE-GIVES-NO-WINDOW-END" {
    given {
        context { decision_time @2026-01-10T09:00:00-04:00; knowledge_time @2026-01-10T09:00:00-04:00; legal_time @2026-01-10; timezone "America/New_York"; }
        assert lien_filing_notice_window_candidate(entity_ref("urn:us:irc:collection:clir#Lien2"), @2026-01-01, @2026-01-08) { id "f0"; origin case_input; }
        // no candidate_is_5th_business_day_after_filing — the calendar
        // resource is the EXTERNAL_DEPENDENCY; without it, NEITHER.
    }
    evaluate truth(lien_filing_notice_window_end(entity_ref("urn:us:irc:collection:clir#Lien2"), @2026-01-01, @2026-01-08));
    expect truth_status == NEITHER;
}

test "S6320A1-01-NOTIFY-OF-LIEN-FILING-DUTY-SATISFIED" {
    given {
        context { decision_time @2026-01-10T09:00:00-04:00; knowledge_time @2026-01-10T09:00:00-04:00; legal_time @2026-01-10; timezone "America/New_York"; }
        assert lien_identity(entity_ref("urn:us:irc:collection:clir#Lien3"), entity_ref("urn:us:irc:collection:clir#TP3"), entity_ref("urn:us:irc:collection:clir#A3")) { id "f0"; origin case_input; }
        assert assessment_of_person(entity_ref("urn:us:irc:collection:clir#A3"), entity_ref("urn:us:irc:collection:clir#TP3")) { id "f1"; origin case_input; }
        assert neglected_or_refused_to_pay(entity_ref("urn:us:irc:collection:clir#TP3"), entity_ref("urn:us:irc:collection:clir#A3")) { id "f2"; origin case_input; }
        assert lien_notice_filed_on(entity_ref("urn:us:irc:collection:clir#Lien3"), @2026-01-01) { id "f3"; origin case_input; }
        assert lien_filing_notice_window_candidate(entity_ref("urn:us:irc:collection:clir#Lien3"), @2026-01-01, @2026-01-08) { id "f4"; origin case_input; }
        assert candidate_is_5th_business_day_after_filing(entity_ref("urn:us:irc:collection:clir#Lien3"), @2026-01-01, @2026-01-08) { id "f5"; origin case_input; }
        assert lien_filing_notice_given(entity_ref("urn:us:irc:collection:clir#TP3"), entity_ref("urn:us:irc:collection:clir#Lien3")) { id "f6"; origin case_input; }
    }
    evaluate positions();
    expect position(NotifyOfLienFiling, SATISFIED);
}

