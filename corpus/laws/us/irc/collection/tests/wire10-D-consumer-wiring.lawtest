// Collection WIRE-10 group D consumer-wiring scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

test "W10-D-COL-01-EXEMPT-AMOUNT-WHEN-THE-EXEMPTION-IS-ZERO-USES-THE-INDEXED-DEPENDENT-AMOUNT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::exemption_amount_for(entity_ref("urn:test:w10dcol:c1#p"), entity_ref("urn:test:w10dcol:c1#y"), 0.00 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::standard_deduction(entity_ref("urn:test:w10dcol:c1#p"), entity_ref("urn:test:w10dcol:c1#y"), 14600 USD) { origin case_input; }
        assert "f2": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dcol:c1#y"), 2024) { origin case_input; }
        assert "f3": us.irc.gross_income::number_of_dependents(entity_ref("urn:test:w10dcol:c1#p"), entity_ref("urn:test:w10dcol:c1#y"), 2) { origin case_input; }
        assert "f4": us.irc.income_individual::cola_terms(2017, 2023, 1200.0, 1000.0) { origin case_input; }
    }
    evaluate truth(weekly_exempt_amount_6334d(entity_ref("urn:test:w10dcol:c1#p"), entity_ref("urn:test:w10dcol:c1#y"), 471.15 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-COL-02-EXEMPT-AMOUNT-IS-STANDARD-DEDUCTION-PLUS-EXEMPTIONS-OVER-52" {
    given {
        context {
            legal_time @2016-06-01;
            decision_time @2016-06-01T09:00:00-05:00;
            knowledge_time @2016-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::exemption_amount_for(entity_ref("urn:test:w10dcol:c2#p"), entity_ref("urn:test:w10dcol:c2#y"), 2000.00 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::standard_deduction(entity_ref("urn:test:w10dcol:c2#p"), entity_ref("urn:test:w10dcol:c2#y"), 12000 USD) { origin case_input; }
        assert "f2": us.irc.gross_income::personal_exemption_deduction_151(entity_ref("urn:test:w10dcol:c2#p"), entity_ref("urn:test:w10dcol:c2#y"), 4000.00 USD) { origin case_input; }
    }
    evaluate truth(weekly_exempt_amount_6334d(entity_ref("urn:test:w10dcol:c2#p"), entity_ref("urn:test:w10dcol:c2#y"), 307.69 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-COL-03-WEEKLY-INCOME-BELOW-THE-EXEMPT-AMOUNT-IS-EXEMPT-FROM-LEVY" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::exemption_amount_for(entity_ref("urn:test:w10dcol:c3#p"), entity_ref("urn:test:w10dcol:c3#y"), 0.00 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::standard_deduction(entity_ref("urn:test:w10dcol:c3#p"), entity_ref("urn:test:w10dcol:c3#y"), 14600 USD) { origin case_input; }
        assert "f2": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dcol:c3#y"), 2024) { origin case_input; }
        assert "f3": us.irc.gross_income::number_of_dependents(entity_ref("urn:test:w10dcol:c3#p"), entity_ref("urn:test:w10dcol:c3#y"), 2) { origin case_input; }
        assert "f4": us.irc.income_individual::cola_terms(2017, 2023, 1200.0, 1000.0) { origin case_input; }
        assert "f5": weekly_income_in_levy_year(entity_ref("urn:test:w10dcol:c3#p"), entity_ref("urn:test:w10dcol:c3#y"), 400.00 USD) { origin case_input; }
    }
    evaluate truth(property_exempt_from_levy(entity_ref("urn:test:w10dcol:c3#p"), MinimumExemptWagesAndIncome));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-COL-04-WEEKLY-INCOME-ABOVE-THE-EXEMPT-AMOUNT-IS-NOT-EXEMPT-BY-A9" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::exemption_amount_for(entity_ref("urn:test:w10dcol:c4#p"), entity_ref("urn:test:w10dcol:c4#y"), 0.00 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::standard_deduction(entity_ref("urn:test:w10dcol:c4#p"), entity_ref("urn:test:w10dcol:c4#y"), 14600 USD) { origin case_input; }
        assert "f2": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dcol:c4#y"), 2024) { origin case_input; }
        assert "f3": us.irc.gross_income::number_of_dependents(entity_ref("urn:test:w10dcol:c4#p"), entity_ref("urn:test:w10dcol:c4#y"), 2) { origin case_input; }
        assert "f4": us.irc.income_individual::cola_terms(2017, 2023, 1200.0, 1000.0) { origin case_input; }
        assert "f5": weekly_income_in_levy_year(entity_ref("urn:test:w10dcol:c4#p"), entity_ref("urn:test:w10dcol:c4#y"), 500.00 USD) { origin case_input; }
    }
    evaluate truth(wages_or_income_within_minimum_exempt_amount(entity_ref("urn:test:w10dcol:c4#p")));
    expect truth_status == FALSE_ONLY;
}

