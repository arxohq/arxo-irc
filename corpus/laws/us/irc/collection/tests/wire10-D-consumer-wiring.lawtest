        assert "f0": us.irc.gross_income::exemption_amount_for(entity_ref("urn:test:w10dcol:c5#p"), entity_ref("urn:test:w10dcol:c5#y"), 0.00 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::standard_deduction(entity_ref("urn:test:w10dcol:c5#p"), entity_ref("urn:test:w10dcol:c5#y"), 12000 USD) { origin case_input; }
        assert "f2": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dcol:c5#y"), 2018) { origin case_input; }
