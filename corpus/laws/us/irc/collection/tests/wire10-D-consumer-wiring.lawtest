    }
    evaluate truth(weekly_exempt_amount_6334d(entity_ref("urn:test:w10dcol:c5#p"), entity_ref("urn:test:w10dcol:c5#y"), 310.58 USD));
    expect truth_status == TRUE_ONLY;
}

