test "S6323j-01-WITHDRAWAL-VALID-INSTALLMENT-AGREEMENT-GROUND" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert lien_withdrawal_ground_met(entity_ref("urn:us:irc:collection:clir#LienW1"), InstallmentAgreementUnder6159) { id "f0"; origin case_input; }
        assert lien_withdrawal_made(entity_ref("urn:us:irc:collection:clir#LienW1"), @2026-04-15) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(WithdrawNoticeOfLien, ACTIVE);
}

