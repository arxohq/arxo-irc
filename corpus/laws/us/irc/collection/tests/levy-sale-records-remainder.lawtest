test "S6333-01-PRODUCTION-OF-BOOKS-DUTY" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert levy_made_or_about_to_be_made(entity_ref("urn:us:irc:collection:clir#Custodian1"), entity_ref("urn:us:irc:collection:clir#LevyR1")) { id "f0"; origin case_input; }
        assert custodian_has_relevant_books(entity_ref("urn:us:irc:collection:clir#Custodian1"), entity_ref("urn:us:irc:collection:clir#LevyR1")) { id "f1"; origin case_input; }
        assert secretary_demanded_books(entity_ref("urn:us:irc:collection:clir#Custodian1"), entity_ref("urn:us:irc:collection:clir#LevyR1"), @2026-04-15) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(ExhibitBooksAndRecords, ACTIVE);
}

