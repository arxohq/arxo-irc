// Collection -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): section 6302(e)(1) (G5606), the deposit
// of the tax on communications services and air transportation "not later than the 3rd day (not including Saturdays, Sundays, or
// legal holidays) after the close of the 1st week of the 2nd semimonthly period following the period to which such amounts relate".
//
// TECHNIQUE. The period the amounts relate to is a semimonthly period (the 1st-15th or the 16th-end of a month); its start is a case
// fact. The 2nd semimonthly period following it starts one calendar month after that start (from the 1st: 1st of the next month;
// from the 16th: the 16th of the next month); the close of its 1st week is that start + 6 calendar days (a week of 7 days counted
// from the start: JUDGMENT CALL); the due day is `add_business_days(close, 3 business_day, "23:59:59")` under the package deadline policy
// `IRC_BUSINESS_DAY_COUNT` (the count starts the day after the close, the last day is included). The business-day calendar of
// section 85 is NOT carried by the package: the world supplies the snapshot (`us.code.clir.federal_calendar`, from 5 U.S.C. 6103,
// in the `concat` of the test family); without it the date is not computed (MISSING_CALENDAR). "Except as provided in paragraph (2)":
// the rule does not apply to a period of the September special rule (`september_rule_period_6302e2`, case fact).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    IRC_S6302_E,
    Person,
};

pub deadline policy IRC_BUSINESS_DAY_COUNT {
    start_count next_day;
    include_end true;
    roll next_working_day;
}

pub relation semimonthly_period_start_6302e1(p: Person, start: Date) kind empirical {
    label en official "the first day of the semimonthly period during which the amounts of the tax imposed by section 4251 or section 4261(a) or (b) are considered collected by the person (section 6302(e)(1)) — case fact";
}
pub relation september_rule_period_6302e2(p: Person, start: Date) kind empirical {
    label en official "the period is one of the September special rule of section 6302(e)(2) (bills rendered or tickets sold from September 1 through September 11) — case fact";
}
pub relation communications_deposit_due_date_6302e1(p: Person, start: Date, due: Date) kind institutional {
    label en official "the day not later than which the deposit for the period that starts on `start` is made: the 3rd business day after the close of the 1st week of the 2nd semimonthly period following the period";
}
@source(IRC_S6302_E, relation = formalizes, coverage = exact, quote = "such deposit shall be made not later than the 3rd day (not including Saturdays, Sundays, or legal holidays) after the close of the 1st week of the 2nd semimonthly period following the period to which such amounts relate")
rule S6302e1CommunicationsDepositDueDate defeasible {
    label en official "add_business_days(start + 1 month + 6 days, 3 business_day)";
    for p: Person;
    for start: Date;
    when semimonthly_period_start_6302e1(p, start)
        and not_known(september_rule_period_6302e2(p, start));
    then communications_deposit_due_date_6302e1(p, start, add_business_days(add_calendar_period(add_calendar_period(start, 1 calendar_month), 6 calendar_day), 3 business_day, "23:59:59"));
}
