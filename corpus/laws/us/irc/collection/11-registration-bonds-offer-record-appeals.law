// §7011 (registration of persons subject to special taxes), §7012 (pure
// cross-references — NON_NORMATIVE), §7101 (form of bonds; substitution of
// government securities as the person's own power), §7102 (single bond in
// lieu of multiple bonds — the Secretary's power), §7122(b) (record of a
// compromise), §7122(e) (administrative review of a rejected offer/
// installment agreement), §7122(g) (frivolous submissions), §7123 (appeals
// dispute resolution: early referral, mediation, arbitration, and the
// tax-exempt-status administrative appeal — all as the Secretary's duties
// to prescribe procedures, with the taxpayer's/organization's own request as
// a power under each). STAGE 2b (agent F04, 25.09.2026).
//
// JUDGMENT CALLS (see report):
//  - §7011(a) is a duty of a person in a special-tax trade/business to
//    register; (b) mirrors it for persons exempted under §4905.
//  - §7101(1) (form of bond) is `EXTERNAL_DEPENDENCY` (regulations); (2)
//    (deposit of U.S. bonds/notes in lieu of a surety bond) is modelled as a
//    LIBERTY of the person required to furnish security — an election of
//    the person's own conduct that does not change the legal relation
//    (substitutes the SECURITY, not the underlying obligation).
//  - §7102 is a `power` of the Secretary (accepting one bond in lieu of
//    several).
//  - §7122(b)'s record-keeping duty is modelled with its own $50,000
//    threshold EXACTLY as stated (the point below which no General Counsel
//    opinion is required, subject to continuing quality review).
//  - §7122(e) is modelled as a duty of the Secretary to establish
//    independent-review/appeal procedures — the procedures' CONTENT is
//    `EXTERNAL_DEPENDENCY`; the taxpayer's own appeal is a `power`.
//  - §7122(g) is modelled as a power of the Secretary to disregard a
//    frivolous portion, `valid_when` the §6702(b)(2)(A)(i)-(ii) frivolous-
//    submission test is met — that test itself is owned by `penalties`
//    (§6702) and not imported here (case-asserted fact, cross-package
//    dependency recorded).
//  - §7123(a)-(c) are each modelled the same way: a duty of the Secretary to
//    prescribe the named procedure, plus the taxpayer's/organization's own
//    request as a `power` whose effect is that the referral/mediation/
//    arbitration/appeal is PENDING (not that it is decided — the decision
//    itself is a separate, unmodelled administrative outcome).

language "law.core" version "0.2";
package us.irc.collection version "0.1.1";
namespace "urn:us:irc:collection:clir";

use self::{
    IRC_S7011_A,
    IRC_S7011_B,
    IRC_S7101,
    IRC_S7102,
    IRC_S7122_B,
    IRC_S7122_E,
    IRC_S7122_G,
    IRC_S7123_A,
    IRC_S7123_B,
    IRC_S7123_C,
    Person,
    Secretary,
};

// ============================================================================
// §7011 — Registration of persons subject to special taxes
// ============================================================================

relation engaged_in_specially_taxed_trade_or_business(p: Person) kind empirical {
    label en unofficial "case fact: the person is engaged in a trade or business on which a special tax is imposed by law — §7011(a)'s own scope";
}
pub relation special_tax_registration_owed(p: Person) kind institutional;
@source(IRC_S7011_A, relation = formalizes, coverage = partial, quote = "Every person engaged in any trade or business on which a special tax is imposed by law shall register with the Secretary his name or style, place of residence, trade or business, and the place where such trade or business is to be carried on.")
rule S7011aRegistrationDuty strict {
    for p: Person;
    when engaged_in_specially_taxed_trade_or_business(p);
    then duty RegisterSpecialTaxTradeOrBusiness {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}
relation exempted_under_4905(p: Person) kind empirical {
    label en unofficial "case fact: the person is exempted under §4905 from paying the special tax — §7011(b)'s own scope";
}
pub relation exempted_person_registration_owed(p: Person) kind institutional;
@source(IRC_S7011_B, relation = formalizes, coverage = exact, quote = "Any person exempted under the provisions of section 4905 from the payment of a special tax, shall register with the Secretary in accordance with regulations prescribed by the Secretary.")
rule S7011bExemptedPersonRegistrationDuty strict {
    for p: Person;
    when exempted_under_4905(p);
    then duty RegisterAsExemptedPerson {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition true;
            window [-infinity, infinity];
        }
    };
}

// §7012 is entirely cross-references (firearms registration §§5802/5841/
// 5861; wagering §4412; gasoline/diesel §4101; distilled spirits/wine/beer
// §5124; failure-to-register penalties §§7272/7262) — NON_NORMATIVE.

// ============================================================================
// §7101 — Form of bonds
// ============================================================================

relation bond_or_security_required(p: Person, purpose: Text) kind empirical {
    label en unofficial "case fact: this title (other than §7485) or a regulation requires the person to furnish a bond or security for this purpose — §7101's own trigger. The bond's exact FORM and surety are prescribed by regulation (EXTERNAL_DEPENDENCY, §7101(1))";
}
relation person_deposits_us_bonds_or_notes(p: Person, purpose: Text) kind empirical {
    label en unofficial "case fact: the person deposited bonds or notes of the United States, under 31 U.S.C. §9303, in lieu of a surety bond — §7101(2)'s exercise";
}
pub relation us_securities_substituted_for_surety_bond(p: Person, purpose: Text) kind institutional;
@source(IRC_S7101, relation = formalizes, coverage = partial, quote = "The person required to furnish such bond or security may, in lieu thereof, deposit bonds or notes of the United States as provided in section 9303 of title 31, United States Code.")
rule S7101SubstituteGovernmentSecuritiesLiberty strict {
    for p: Person;
    for purpose: Text;
    when bond_or_security_required(p, purpose) and person_deposits_us_bonds_or_notes(p, purpose);
    then liberty SubstituteGovernmentSecuritiesForBond {
        holder p;
        action person_deposits_us_bonds_or_notes(p, purpose);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §7102 — Single bond in lieu of multiple bonds
// ============================================================================

relation multiple_bonds_required_or_authorized(p: Person) kind empirical {
    label en unofficial "case fact: two or more bonds are required or authorized of the person — §7102's own trigger";
}
relation single_bond_accepted_on(p: Person, on: Date) kind empirical {
    label en unofficial "case fact: the Secretary accepted a single bond complying with the requirements for which the several bonds were required/authorized — the exercise";
}
pub relation single_bond_in_lieu_of_multiple(p: Person) kind institutional;
@source(IRC_S7102, relation = formalizes, coverage = exact, quote = "the Secretary may provide for the acceptance of a single bond complying with the requirements for which the several bonds are required or authorized")
rule S7102SingleBondPower strict {
    for p: Person;
    for on: Date;
    when multiple_bonds_required_or_authorized(p) and single_bond_accepted_on(p, on);
    then power AcceptSingleBondInLieuOfMultiple {
        holder Secretary;
        exercise single_bond_accepted_on(p, on);
        valid_when multiple_bonds_required_or_authorized(p);
        effect single_bond_in_lieu_of_multiple(p);
    };
}

// ============================================================================
// §7122(b) — Record of a compromise
// ============================================================================

relation compromise_made(p: Person, tax_assessed: Money, other_amounts: Money, amount_paid: Money) kind empirical {
    label en unofficial "case fact: the Secretary made a compromise in a case, with the given assessed tax, interest/additional-amount/addition-to-tax/penalty, and amount actually paid under the compromise's terms";
}
pub relation compromise_general_counsel_opinion_required(p: Person, tax_assessed: Money, other_amounts: Money) kind institutional {
    label en unofficial "§7122(b): a General Counsel opinion (with reasons and the (1)-(3) statement) must be filed, UNLESS the unpaid amount of tax assessed (including interest/additional amount/addition to tax/penalty) is less than $50,000";
}
@source(IRC_S7122_B, relation = formalizes, coverage = exact, quote = "no such opinion shall be required with respect to the compromise of any civil case in which the unpaid amount of tax assessed (including any interest, additional amount, addition to the tax, or assessable penalty) is less than $50,000")
rule S7122bOpinionRequiredAboveThreshold defeasible {
    for p: Person;
    for tax_assessed: Money;
    for other_amounts: Money;
    for amount_paid: Money;
    when compromise_made(p, tax_assessed, other_amounts, amount_paid);
    then compromise_general_counsel_opinion_required(p, tax_assessed, other_amounts);
    unless tax_assessed + other_amounts < 50000.00 USD and compromise_made(p, tax_assessed, other_amounts, amount_paid);
}
pub relation compromise_subject_to_continuing_quality_review(p: Person) kind institutional;
@source(IRC_S7122_B, relation = formalizes, coverage = exact, quote = "such compromise shall be subject to continuing quality review by the Secretary")
rule S7122bContinuingQualityReview strict {
    for p: Person;
    for tax_assessed: Money;
    for other_amounts: Money;
    for amount_paid: Money;
    when compromise_made(p, tax_assessed, other_amounts, amount_paid) and tax_assessed + other_amounts < 50000.00 USD;
    then compromise_subject_to_continuing_quality_review(p);
}

// ============================================================================
// §7122(e) — Administrative review of rejected offers/installment agreements
// ============================================================================

pub relation offer_rejection_independent_review_procedures_exist(has_procedures: Boolean) kind empirical {
    label en unofficial "§7122(e)(1): independent administrative review of any offer-in-compromise/installment-agreement rejection before it is communicated to the taxpayer — the procedures themselves are EXTERNAL_DEPENDENCY";
}
rule S7122eIndependentReviewDuty strict {
    when true;
    then duty EstablishIndependentReviewProcedures {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}
relation offer_or_agreement_rejected(p: Person) kind empirical;
relation appeal_of_rejection_made(p: Person, on: Date) kind empirical {
    label en unofficial "case fact: the taxpayer appealed the rejection to the Independent Office of Appeals — §7122(e)(2)'s exercise";
}
pub relation offer_rejection_appeal_pending(p: Person) kind institutional;
@source(IRC_S7122_E, relation = formalizes, coverage = exact, quote = "which allow a taxpayer to appeal any rejection of such offer or agreement to the Internal Revenue Service Independent Office of Appeals")
rule S7122eAppealRejectionPower strict {
    for p: Person;
    for on: Date;
    when offer_or_agreement_rejected(p) and appeal_of_rejection_made(p, on);
    then power AppealOfferOrAgreementRejection {
        holder p;
        exercise appeal_of_rejection_made(p, on);
        valid_when offer_or_agreement_rejected(p);
        effect offer_rejection_appeal_pending(p);
    };
}

// ============================================================================
// §7122(g) — Frivolous submissions
// ============================================================================

relation offer_or_installment_portion_meets_6702_frivolous_test(p: Person, portion: Text) kind empirical {
    label en unofficial "case fact / cross-package dependency: this portion of the offer-in-compromise/installment-agreement application meets the §6702(b)(2)(A)(i)-(ii) frivolous-submission test — §6702 is owned by `penalties`, not imported here; asserted as a case fact";
}
pub relation frivolous_portion_treated_as_never_submitted(p: Person, portion: Text) kind institutional {
    label en unofficial "§7122(g): the Secretary may treat a frivolous portion as if it were never submitted, and it is not subject to further administrative or judicial review";
}
@source(IRC_S7122_G, relation = formalizes, coverage = exact, quote = "the Secretary may treat such portion as if it were never submitted and such portion shall not be subject to any further administrative or judicial review")
rule S7122gDisregardFrivolousPortionPower strict {
    for p: Person;
    for portion: Text;
    when offer_or_installment_portion_meets_6702_frivolous_test(p, portion);
    then power DisregardFrivolousSubmissionPortion {
        holder Secretary;
        exercise offer_or_installment_portion_meets_6702_frivolous_test(p, portion);
        valid_when offer_or_installment_portion_meets_6702_frivolous_test(p, portion);
        effect frivolous_portion_treated_as_never_submitted(p, portion);
    };
}

// ============================================================================
// §7123(a) — Early referral to appeals
// ============================================================================

rule S7123aEarlyReferralProceduresDuty strict {
    when true;
    then duty PrescribeEarlyReferralProcedures {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}
relation early_referral_requested(p: Person, issue: Text, on: Date) kind empirical;
pub relation early_referral_pending(p: Person, issue: Text) kind institutional;
@source(IRC_S7123_A, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe procedures by which any taxpayer may request early referral of 1 or more unresolved issues from the examination or collection division to the Internal Revenue Service Independent Office of Appeals.")
rule S7123aRequestEarlyReferralPower strict {
    for p: Person;
    for issue: Text;
    for on: Date;
    when early_referral_requested(p, issue, on);
    then power RequestEarlyReferral {
        holder p;
        exercise early_referral_requested(p, issue, on);
        valid_when early_referral_requested(p, issue, on);
        effect early_referral_pending(p, issue);
    };
}

// ============================================================================
// §7123(b) — Alternative dispute resolution: mediation and arbitration
// ============================================================================

rule S7123bMediationProceduresDuty strict {
    when true;
    then duty PrescribeMediationProcedures {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}
relation mediation_requested(p: Person, issue: Text, on: Date) kind empirical;
pub relation mediation_pending(p: Person, issue: Text) kind institutional;
@source(IRC_S7123_B, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe procedures under which a taxpayer or the Internal Revenue Service Independent Office of Appeals may request non-binding mediation on any issue unresolved at the conclusion of")
rule S7123b1RequestMediationPower strict {
    for p: Person;
    for issue: Text;
    for on: Date;
    when mediation_requested(p, issue, on);
    then power RequestMediation {
        holder p;
        exercise mediation_requested(p, issue, on);
        valid_when mediation_requested(p, issue, on);
        effect mediation_pending(p, issue);
    };
}
rule S7123bArbitrationPilotProgramDuty strict {
    when true;
    then duty EstablishArbitrationPilotProgram {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}
relation arbitration_jointly_requested(p: Person, issue: Text, on: Date) kind empirical {
    label en unofficial "case fact: the taxpayer AND the Independent Office of Appeals jointly requested binding arbitration — §7123(b)(2)'s exercise (a joint request, not a unilateral one)";
}
pub relation arbitration_pending(p: Person, issue: Text) kind institutional;
@source(IRC_S7123_B, relation = formalizes, coverage = exact, quote = "a taxpayer and the Internal Revenue Service Independent Office of Appeals may jointly request binding arbitration on any issue unresolved at the conclusion of")
rule S7123b2RequestArbitrationPower strict {
    for p: Person;
    for issue: Text;
    for on: Date;
    when arbitration_jointly_requested(p, issue, on);
    then power RequestBindingArbitration {
        holder p;
        exercise arbitration_jointly_requested(p, issue, on);
        valid_when arbitration_jointly_requested(p, issue, on);
        effect arbitration_pending(p, issue);
    };
}

// ============================================================================
// §7123(c) — Administrative appeal of adverse tax-exempt-status determinations
// ============================================================================

enum AdverseExemptStatusDetermination {
    QualificationUnder501aOr170c2;       // (c)(2)(A)
    PrivateFoundationClassification509a; // (c)(2)(B)
    PrivateOperatingFoundation4942j3;    // (c)(2)(C)
}
rule S7123cAppealProceduresDuty strict {
    when true;
    then duty PrescribeExemptStatusAppealProcedures {
        bearer Secretary;
        beneficiary Secretary;
        goal maintenance {
            condition true;
            window [-infinity, infinity];
        }
    };
}
relation adverse_exempt_status_determination_made(org: Person, kind: AdverseExemptStatusDetermination) kind empirical;
relation exempt_status_appeal_requested(org: Person, kind: AdverseExemptStatusDetermination, on: Date) kind empirical;
pub relation exempt_status_appeal_pending(org: Person, kind: AdverseExemptStatusDetermination) kind institutional;
@source(IRC_S7123_C, relation = formalizes, coverage = partial, quote = "The Secretary shall prescribe procedures under which an organization which claims to be described in section 501(c) may request an administrative appeal (including a conference relating to such appeal if requested by the organization) to the Internal Revenue Service Independent Office of Appeals of an adverse determination")
rule S7123cRequestAppealPower strict {
    for org: Person;
    for kind: AdverseExemptStatusDetermination;
    for on: Date;
    when adverse_exempt_status_determination_made(org, kind) and exempt_status_appeal_requested(org, kind, on);
    then power RequestExemptStatusAdministrativeAppeal {
        holder org;
        exercise exempt_status_appeal_requested(org, kind, on);
        valid_when adverse_exempt_status_determination_made(org, kind);
        effect exempt_status_appeal_pending(org, kind);
    };
}
