// 26 U.S.C. §§6411 and 6425 — Chapter 65, Subchapter A (cont'd): tentative
// carryback and refund adjustments (§6411) and quick refunds of overpayments
// of corporate estimated income tax (§6425). Stage 2.
//
// JUDGMENT CALLS AND GAPS
//  - An application is one entity (`TentativeApplication`) with a kind
//    (carryback under (a), §1341 claim-of-right under (d), corporate
//    estimated-tax adjustment under §6425): the three procedures share the
//    same shape (a taxpayer's application, a Secretary's fixed-period duty,
//    a disallowance power, credit-then-refund). Amounts of the statutory
//    application are case facts the taxpayer states; the Secretary's
//    determination is derived only where the text gives arithmetic
//    (§6411(b) application order; §6425(b)(3) thresholds; §6425(c)).
//  - "The last day of the month in which falls the last date prescribed for
//    filing the return" (§6411(b)) needs a date-part (end-of-month) the
//    runtime subset does not have: the month end is a case-supplied fact
//    (`last_day_of_month_containing`), TECH-GAPS G2622. "The 15th day of the
//    fourth month" after the close of the taxable year (§6425(a)(1)) IS
//    computed, as day-after-close + 3 calendar months + 14 days, which is
//    exact only for a taxable year ending on the last day of a month (a
//    52-53 week year is a TECH-GAPS G2623 boundary).
//  - "Whichever is the later" of two dates (§6411(b), (d)(2)) is the
//    candidates + "no strictly later candidate" idiom (TECH-GAPS G136).
//  - The Secretary's "to the extent he deems practicable" limited
//    examination is a duty whose achievement condition is that the
//    determination is made; the extent of the examination is discretion
//    (INTERPRETATION row), not a testable element.
//  - §6411(c), (d)(3) and §6425(d) (consolidated returns "to such extent
//    and subject to such conditions as the Secretary may by regulations
//    prescribe") are EXTERNAL_DEPENDENCY on unpinned regulations.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6411_A,
    IRC_S6411_B,
    IRC_S6411_D,
    IRC_S6425_A,
    IRC_S6425_B,
    IRC_S6425_C,
    Person,
    Return,
    Secretary,
    TaxableYear,
};

entity TentativeApplication { label en unofficial "an application for a tentative adjustment: §6411(a) carryback, §6411(d) claim-of-right refund, or §6425 corporate estimated-tax adjustment"; }
enum TentativeKind {
    CarrybackAdjustment;        // §6411(a)-(b)
    ClaimOfRightRefund;         // §6411(d), §1341(b)(1)
    EstimatedTaxAdjustment;     // §6425
    label en unofficial "which tentative-adjustment procedure the application belongs to";
}
relation application_kind(a: TentativeApplication, k: TentativeKind) kind empirical;
relation application_of(a: TentativeApplication, p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the application is the taxpayer's, for the taxable year from which the carryback / of the overpayment arises";
}
relation application_filed_on(a: TentativeApplication, d: Date) kind empirical;
relation application_verified_under_6065(a: TentativeApplication) kind empirical {
    label en official "verified in the manner prescribed by section 6065 in the case of a return of such taxpayer";
}

// ============================================================================
// §6411(a) — Application for tentative carryback adjustment
// ============================================================================

relation tentative_carryback_arises(p: Person, y: TaxableYear) kind empirical {
    label en official "a net operating loss carryback (section 172(b)), business credit carryback (section 39), or capital loss carryback (section 1212(a)(1) or (c)) from the taxable year";
}
relation files_tentative_carryback_application(p: Person, y: TaxableYear) kind empirical;

@source(IRC_S6411_A, relation = formalizes, coverage = partial, quote = "A taxpayer may file an application for a tentative carryback adjustment of the tax for the prior taxable year affected by a net operating loss carryback")
@source(IRC_S6411_A, relation = formalizes, coverage = partial, quote = "on or after the date of filing for the return for the taxable year of the net operating loss, net capital loss, or unused business credit from which the carryback results and within a period of 12 months after such taxable year")
rule S6411MayApplyForTentativeCarryback strict {
    for p: Person;
    for y: TaxableYear;
    for r: Return;
    for filed: Date;
    for close: Date;
    when tentative_carryback_arises(p, y)
        and us.irc.core::return_of(r, p, y, us.irc.core::IncomeCh1)
        and us.irc.core::filed_on(r, filed)
        and us.irc.core::ends(y, close);
    then liberty MayApplyForTentativeCarrybackAdjustment {
        holder p;
        against Secretary;
        action files_tentative_carryback_application(p, y);
        window [filed, add_calendar_period(close, 12 calendar_month)];
    };
}

// The application's contents (a)(1)-(6). Each is a statement the applicant
// makes; the application is complete when all six are set forth.
relation application_states_loss_amount(a: TentativeApplication) kind empirical {
    label en official "(1) the amount of the net operating loss, net capital loss, or unused business credit";
}
relation application_states_tax_previously_determined(a: TentativeApplication) kind empirical {
    label en official "(2) the amount of the tax previously determined for the prior taxable year affected by such carryback (section 1314(a) method)";
}
relation application_states_decrease_in_tax(a: TentativeApplication) kind empirical {
    label en official "(3) the amount of decrease in such tax, attributable to such carryback";
}
relation application_states_unpaid_amount(a: TentativeApplication) kind empirical {
    label en official "(4) the unpaid amount of such tax, not including any amount required to be shown under paragraph (5)";
}
relation application_states_extended_amount(a: TentativeApplication) kind empirical {
    label en official "(5) the amount, with respect to the tax for the taxable year immediately preceding the loss year, as to which an extension of time for payment under section 6164 is in effect";
}
relation application_states_other_information(a: TentativeApplication) kind empirical {
    label en official "(6) such other information as may be required by regulations";
}
relation carryback_application_complete(a: TentativeApplication) kind institutional {
    label en official "the application sets forth the six items required by section 6411(a)(1)-(6)";
}
@source(IRC_S6411_A, relation = formalizes, coverage = partial, quote = "The applications shall set forth in such detail and with such supporting data and explanation as such regulations shall require")
rule S6411ApplicationSetsForthRequiredItems strict {
    for a: TentativeApplication;
    when application_kind(a, CarrybackAdjustment)
        and application_verified_under_6065(a)
        and application_states_loss_amount(a)
        and application_states_tax_previously_determined(a)
        and application_states_decrease_in_tax(a)
        and application_states_unpaid_amount(a)
        and application_states_extended_amount(a)
        and application_states_other_information(a);
    then carryback_application_complete(a);
}

// "Except for purposes of applying section 6611(f)(4)(B), an application under
// this subsection shall not constitute a claim for credit or refund."
relation tentative_application_is_claim_for_refund(a: TentativeApplication) kind institutional {
    label en official "the application constitutes a claim for credit or refund";
}
relation tentative_application_is_claim_for_6611f4B(a: TentativeApplication) kind institutional {
    label en official "the application counts as a claim for credit or refund for purposes of applying section 6611(f)(4)(B)";
}
@source(IRC_S6411_A, relation = formalizes, coverage = exact, quote = "an application under this subsection shall not constitute a claim for credit or refund")
rule S6411ApplicationIsNotAClaimForRefund strict {
    for a: TentativeApplication;
    when application_kind(a, CarrybackAdjustment);
    then not tentative_application_is_claim_for_refund(a);
}
@source(IRC_S6411_A, relation = formalizes, coverage = exact, quote = "Except for purposes of applying section 6611(f)(4)(B)")
rule S6411ApplicationIsClaimForPurposesOf6611f4B strict {
    for a: TentativeApplication;
    when application_kind(a, CarrybackAdjustment);
    then tentative_application_is_claim_for_6611f4B(a);
}

// ============================================================================
// §6411(b) — Allowance of adjustments within 90 days
// ============================================================================

relation last_day_of_month_containing(d: Date, month_end: Date) kind empirical {
    label en unofficial "TECH_GAP G2622: the last day of the calendar month in which the date falls — the runtime subset has no month-end extraction, the case supplies the pair";
}
relation loss_year_return_last_date_candidate(p: Person, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "a last date prescribed by law for filing the loss-year return: the statutory due date, or an extension granted";
}
rule S6411ReturnLastDateFromDueDate strict {
    for p: Person;
    for y: TaxableYear;
    for r: Return;
    for d: Date;
    when us.irc.core::return_of(r, p, y, us.irc.core::IncomeCh1) and us.irc.core::due_date(r, d);
    then loss_year_return_last_date_candidate(p, y, d);
}
rule S6411ReturnLastDateFromExtension strict {
    for p: Person;
    for y: TaxableYear;
    for r: Return;
    for d: Date;
    when us.irc.core::return_of(r, p, y, us.irc.core::IncomeCh1) and us.irc.core::extension_granted(r, d);
    then loss_year_return_last_date_candidate(p, y, d);
}
relation later_loss_year_return_date_exists(p: Person, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "helper (TECH-GAPS G136): another candidate last date for filing the loss-year return is strictly later";
}
rule S6411LaterReturnDateExists strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    for other: Date;
    when loss_year_return_last_date_candidate(p, y, d) and loss_year_return_last_date_candidate(p, y, other) and other > d;
    then later_loss_year_return_date_exists(p, y, d);
}
relation loss_year_return_last_date(p: Person, y: TaxableYear, d: Date) kind institutional {
    label en official "the last date prescribed by law (including any extension of time granted the taxpayer) for filing the return for the loss year";
}
rule S6411LastDateIsLatestCandidate strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    when loss_year_return_last_date_candidate(p, y, d) and not_known(later_loss_year_return_date_exists(p, y, d));
    then loss_year_return_last_date(p, y, d);
}

// The 90-day clock runs from the LATER of (i) the application's filing date
// and (ii) the last day of the month of the last return date.
relation ninety_day_start_candidate(a: TentativeApplication, d: Date) kind institutional {
    label en unofficial "a date from which the 90-day period of section 6411(b) may run";
}
rule S6411StartCandidateFromFiling strict {
    for a: TentativeApplication;
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    when application_kind(a, CarrybackAdjustment) and application_of(a, p, y) and application_filed_on(a, d);
    then ninety_day_start_candidate(a, d);
}
rule S6411StartCandidateFromReturnMonthEnd strict {
    for a: TentativeApplication;
    for p: Person;
    for y: TaxableYear;
    for last: Date;
    for month_end: Date;
    when application_kind(a, CarrybackAdjustment) and application_of(a, p, y)
        and loss_year_return_last_date(p, y, last) and last_day_of_month_containing(last, month_end);
    then ninety_day_start_candidate(a, month_end);
}
relation later_ninety_day_start_exists(a: TentativeApplication, d: Date) kind institutional {
    label en unofficial "helper (TECH-GAPS G136): another candidate start is strictly later";
}
rule S6411LaterStartExists strict {
    for a: TentativeApplication;
    for d: Date;
    for other: Date;
    when ninety_day_start_candidate(a, d) and ninety_day_start_candidate(a, other) and other > d;
    then later_ninety_day_start_exists(a, d);
}
relation carryback_decision_deadline(a: TentativeApplication, deadline: Date) kind institutional {
    label en official "within a period of 90 days from the later of the application's filing or the last day of the month of the last return date";
}
@source(IRC_S6411_B, relation = formalizes, coverage = partial, quote = "Within a period of 90 days from the date on which an application for a tentative carryback adjustment is filed under subsection (a), or from the last day of the month in which falls the last date prescribed by law (including any extension of time granted the taxpayer) for filing the return for the taxable year of the net operating loss, net capital loss, or unused business credit from which such carryback results, whichever is the later")
rule S6411DeadlineIsNinetyDaysFromLaterStart strict {
    for a: TentativeApplication;
    for d: Date;
    when ninety_day_start_candidate(a, d) and not_known(later_ninety_day_start_exists(a, d));
    then carryback_decision_deadline(a, add_calendar_period(d, 90 calendar_day));
}

relation carryback_decrease_determined(a: TentativeApplication, p: Person) kind empirical {
    label en official "the Secretary has made the limited examination and determined the amount of the decrease in tax attributable to the carryback";
}
relation carryback_remainder_credited_or_refunded(a: TentativeApplication) kind empirical {
    label en official "any remainder is credited against any tax or installment then due from the taxpayer, or refunded";
}
@source(IRC_S6411_B, relation = formalizes, coverage = partial, quote = "the Secretary shall make, to the extent he deems practicable in such period, a limited examination of the application, to discover omissions and errors of computation therein, and shall determine the amount of the decrease in the tax attributable to such carryback upon the basis of the application and the examination")
rule S6411DutyToDetermineWithinNinetyDays defeasible {
    for a: TentativeApplication;
    for p: Person;
    for y: TaxableYear;
    for deadline: Date;
    for filed: Date;
    when carryback_application_complete(a) and application_of(a, p, y) and application_filed_on(a, filed) and carryback_decision_deadline(a, deadline);
    then duty DetermineTentativeCarrybackDecrease {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition carryback_decrease_determined(a, p);
            window [filed, deadline];
        }
    };
    unless application_disallowed_without_further_action(a) and application_of(a, p, y) and application_filed_on(a, filed) and carryback_decision_deadline(a, deadline);
}

// The Secretary may disallow without further action an application with
// errors of computation he deems cannot be corrected within the 90 days, or
// with material omissions.
relation application_has_uncorrectable_errors_or_material_omissions(a: TentativeApplication) kind empirical {
    label en official "errors of computation which he deems cannot be corrected by him within such 90-day period or material omissions";
}
relation secretary_disallows_application(a: TentativeApplication) kind empirical;
relation application_disallowed_without_further_action(a: TentativeApplication) kind institutional;
@source(IRC_S6411_B, relation = formalizes, coverage = exact, quote = "except that the Secretary may disallow, without further action, any application which he finds contains errors of computation which he deems cannot be corrected by him within such 90-day period or material omissions")
rule S6411MayDisallowDefectiveApplication strict {
    for a: TentativeApplication;
    when application_of(a, _, _) and application_kind(a, CarrybackAdjustment);
    then power S6411DisallowDefectiveApplicationPower {
        holder Secretary;
        over a;
        exercise secretary_disallows_application(a);
        valid_when application_has_uncorrectable_errors_or_material_omissions(a);
        effect create(application_disallowed_without_further_action(a));
    };
}

// Application order of the decrease (b): against the unpaid amount of the
// decreased tax, then against the unsatisfied §6164-extended tax of the
// year before the loss year, then credit/refund of the remainder.
relation application_decrease_amount(a: TentativeApplication, amount: Money) kind empirical {
    label en official "the amount of the decrease in the tax attributable to the carryback";
}
relation application_unpaid_amount(a: TentativeApplication, amount: Money) kind empirical {
    label en official "any unpaid amount of the tax decreased (including any amount as to which an extension of time under section 6164 is in effect)";
}
relation application_prior_year_extended_amount(a: TentativeApplication, amount: Money) kind empirical {
    label en official "any unsatisfied amount of any tax for the taxable year immediately preceding the loss year the time for payment of which is extended under section 6164";
}
pub relation decrease_applied_to_unpaid_tax(a: TentativeApplication, amount: Money) kind institutional;
@source(IRC_S6411_B, relation = formalizes, coverage = exact, quote = "Such decrease shall be applied against any unpaid amount of the tax decreased (including any amount of such tax as to which an extension of time under section 6164 is in effect)")
rule S6411DecreaseAppliedAgainstUnpaidTax strict {
    for a: TentativeApplication;
    for d: Money;
    for u: Money;
    when application_kind(a, CarrybackAdjustment) and application_decrease_amount(a, d) and application_unpaid_amount(a, u);
    then decrease_applied_to_unpaid_tax(a, min(d, u));
}
pub relation decrease_credited_to_prior_year_extended_tax(a: TentativeApplication, amount: Money) kind institutional;
@source(IRC_S6411_B, relation = formalizes, coverage = exact, quote = "any remainder shall be credited against any unsatisfied amount of any tax for the taxable year immediately preceding the taxable year of the net operating loss, net capital loss, or unused business credit the time for payment of which tax is extended under section 6164")
rule S6411RemainderCreditedAgainstExtendedPriorYearTax strict {
    for a: TentativeApplication;
    for d: Money;
    for u: Money;
    for e: Money;
    when application_kind(a, CarrybackAdjustment) and application_decrease_amount(a, d) and application_unpaid_amount(a, u) and application_prior_year_extended_amount(a, e);
    then decrease_credited_to_prior_year_extended_tax(a, min(max(0 USD, d - u), e));
}
pub relation carryback_remainder_after_applications(a: TentativeApplication, amount: Money) kind institutional {
    label en official "the remainder of the decrease after the unpaid tax and the extended prior-year tax, to be credited against tax then due or refunded within the 90 days";
}
@source(IRC_S6411_B, relation = formalizes, coverage = exact, quote = "Any remainder shall, within such 90-day period, be either credited against any tax or installment thereof then due from the taxpayer, or refunded to the taxpayer.")
rule S6411RemainderAfterApplications strict {
    for a: TentativeApplication;
    for d: Money;
    for u: Money;
    for e: Money;
    when application_kind(a, CarrybackAdjustment) and application_decrease_amount(a, d) and application_unpaid_amount(a, u) and application_prior_year_extended_amount(a, e);
    then carryback_remainder_after_applications(a, max(0 USD, d - u - e));
}
@source(IRC_S6411_B, relation = formalizes, coverage = exact, quote = "Any remainder shall, within such 90-day period, be either credited against any tax or installment thereof then due from the taxpayer, or refunded to the taxpayer.")
rule S6411DutyToCreditOrRefundRemainder strict {
    for a: TentativeApplication;
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    for deadline: Date;
    for remainder: Money;
    when carryback_remainder_after_applications(a, remainder) and remainder > 0 USD
        and application_of(a, p, y) and application_filed_on(a, filed) and carryback_decision_deadline(a, deadline);
    then duty CreditOrRefundCarrybackRemainder {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition carryback_remainder_credited_or_refunded(a);
            window [filed, deadline];
        }
    };
}

// ============================================================================
// §6411(d) — Tentative refund of a §1341(b)(1) overpayment
// ============================================================================

relation claim_of_right_overpayment_arises(p: Person, y: TaxableYear) kind empirical {
    label en official "an amount treated as an overpayment of tax for the taxable year under section 1341(b)(1)";
}
relation files_claim_of_right_tentative_application(p: Person, y: TaxableYear) kind empirical;
@source(IRC_S6411_D, relation = formalizes, coverage = partial, quote = "A taxpayer may file an application for a tentative refund of any amount treated as an overpayment of tax for the taxable year under section 1341(b)(1).")
@source(IRC_S6411_D, relation = formalizes, coverage = partial, quote = "be filed during the period beginning on the date of filing the return for such taxable year and ending on the date 12 months from the last day of such taxable year")
rule S6411dMayApplyForTentativeRefund strict {
    for p: Person;
    for y: TaxableYear;
    for r: Return;
    for filed: Date;
    for close: Date;
    when claim_of_right_overpayment_arises(p, y)
        and us.irc.core::return_of(r, p, y, us.irc.core::IncomeCh1)
        and us.irc.core::filed_on(r, filed)
        and us.irc.core::ends(y, close);
    then liberty MayApplyForClaimOfRightTentativeRefund {
        holder p;
        against Secretary;
        action files_claim_of_right_tentative_application(p, y);
        window [filed, add_calendar_period(close, 12 calendar_month)];
    };
}
relation application_states_1341_computation(a: TentativeApplication) kind empirical {
    label en official "(C)(i)-(v) the tax computed without the section 1341(a)(2) deduction, the tax for prior years, the section 1341(a)(5)(B) amount, the overpayment, and other information the Secretary may require";
}
relation claim_of_right_application_complete(a: TentativeApplication) kind institutional;
@source(IRC_S6411_D, relation = formalizes, coverage = partial, quote = "Such application shall be in such manner and form as the Secretary may prescribe by regulation")
rule S6411dApplicationComplete strict {
    for a: TentativeApplication;
    when application_kind(a, ClaimOfRightRefund) and application_verified_under_6065(a) and application_states_1341_computation(a);
    then claim_of_right_application_complete(a);
}
relation date_of_1341_overpayment(a: TentativeApplication, d: Date) kind empirical {
    label en official "the date of the overpayment (determined under section 1341(b)(1))";
}
relation claim_of_right_start_candidate(a: TentativeApplication, d: Date) kind institutional;
rule S6411dStartFromFiling strict {
    for a: TentativeApplication;
    for d: Date;
    when application_kind(a, ClaimOfRightRefund) and application_filed_on(a, d);
    then claim_of_right_start_candidate(a, d);
}
rule S6411dStartFromOverpaymentDate strict {
    for a: TentativeApplication;
    for d: Date;
    when application_kind(a, ClaimOfRightRefund) and date_of_1341_overpayment(a, d);
    then claim_of_right_start_candidate(a, d);
}
relation later_claim_of_right_start_exists(a: TentativeApplication, d: Date) kind institutional;
rule S6411dLaterStartExists strict {
    for a: TentativeApplication;
    for d: Date;
    for other: Date;
    when claim_of_right_start_candidate(a, d) and claim_of_right_start_candidate(a, other) and other > d;
    then later_claim_of_right_start_exists(a, d);
}
relation claim_of_right_decision_deadline(a: TentativeApplication, deadline: Date) kind institutional {
    label en official "within 90 days from the date the application is filed or from the date of the overpayment, whichever is later";
}
@source(IRC_S6411_D, relation = formalizes, coverage = exact, quote = "Within a period of 90 days from the date on which an application is filed under paragraph (1) or from the date of the overpayment (determined under section 1341(b)(1)), whichever is later")
rule S6411dDeadlineIsNinetyDaysFromLaterDate strict {
    for a: TentativeApplication;
    for d: Date;
    when claim_of_right_start_candidate(a, d) and not_known(later_claim_of_right_start_exists(a, d));
    then claim_of_right_decision_deadline(a, add_calendar_period(d, 90 calendar_day));
}
relation claim_of_right_overpayment_reviewed_determined_and_applied(a: TentativeApplication) kind empirical {
    label en official "the Secretary (A) reviews the application, (B) determines the amount of the overpayment, and (C) applies, credits, or refunds the overpayment";
}
@source(IRC_S6411_D, relation = formalizes, coverage = exact, quote = "(C) apply, credit, or refund such overpayment,")
rule S6411dDutyToReviewDetermineAndRefund strict {
    for a: TentativeApplication;
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    for deadline: Date;
    when claim_of_right_application_complete(a) and application_of(a, p, y) and application_filed_on(a, filed) and claim_of_right_decision_deadline(a, deadline);
    then duty ReviewDetermineAndRefundClaimOfRightOverpayment {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition claim_of_right_overpayment_reviewed_determined_and_applied(a);
            window [filed, deadline];
        }
    };
}

// ============================================================================
// §6425 — Adjustment of overpayment of estimated income tax by corporation
// ============================================================================

relation corporation_overpaid_estimated_tax(p: Person, y: TaxableYear) kind empirical {
    label en official "an overpayment by it of estimated income tax for such taxable year";
}
relation files_estimated_tax_adjustment_application(p: Person, y: TaxableYear) kind empirical;
relation estimated_tax_application_window_end(y: TaxableYear, d: Date) kind institutional {
    label en official "the 15th day of the fourth month after the close of the taxable year (exact for a year ending on the last day of a month: TECH-GAPS G2623)";
}
rule S6425WindowEnd strict {
    for y: TaxableYear;
    for close: Date;
    when us.irc.core::ends(y, close);
    then estimated_tax_application_window_end(y, add_calendar_period(add_calendar_period(add_calendar_period(close, 1 calendar_day), 3 calendar_month), 14 calendar_day));
}
relation corporation_return_filed_for_year_on(p: Person, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "the corporation filed its return for the taxable year on the date";
}
rule S6425CorporationReturnFiled strict {
    for p: Person;
    for y: TaxableYear;
    for r: Return;
    for d: Date;
    when us.irc.core::return_of(r, p, y, us.irc.core::IncomeCh1) and us.irc.core::filed_on(r, d);
    then corporation_return_filed_for_year_on(p, y, d);
}
@source(IRC_S6425_A, relation = formalizes, coverage = partial, quote = "A corporation may, after the close of the taxable year and on or before the 15th day of the fourth month thereafter, and before the day on which it files a return for such taxable year, file an application for an adjustment of an overpayment by it of estimated income tax for such taxable year.")
rule S6425CorporationMayApplyForAdjustment strict {
    for p: Person;
    for y: TaxableYear;
    for close: Date;
    for last: Date;
    when corporation_overpaid_estimated_tax(p, y) and us.irc.core::ends(y, close) and estimated_tax_application_window_end(y, last);
    then liberty MayApplyForEstimatedTaxAdjustment {
        holder p;
        against Secretary;
        action files_estimated_tax_adjustment_application(p, y);
        window [close, last];
    };
}
// Filing the return closes the window earlier: an application filed on or after
// the return's filing day is not an application under this section.
relation estimated_tax_application_after_return(p: Person, y: TaxableYear) kind institutional {
    label en official "the application is filed on or after the day the corporation files its return for the year";
}
relation estimated_tax_application_filed_on(p: Person, y: TaxableYear, d: Date) kind empirical;
rule S6425ApplicationNotBeforeReturn strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    for rd: Date;
    when estimated_tax_application_filed_on(p, y, d) and corporation_return_filed_for_year_on(p, y, rd) and d >= rd;
    then estimated_tax_application_after_return(p, y);
}
@source(IRC_S6425_A, relation = formalizes, coverage = exact, quote = "An application under this subsection shall not constitute a claim for credit or refund.")
rule S6425ApplicationIsNotAClaimForRefund strict {
    for a: TentativeApplication;
    when application_kind(a, EstimatedTaxAdjustment);
    then not tentative_application_is_claim_for_refund(a);
}

// (a)(2): contents; (c): definitions and the amount of the adjustment.
relation estimated_tax_paid_during_year(a: TentativeApplication, amount: Money) kind empirical {
    label en official "(A) the estimated income tax paid by the corporation during the taxable year";
}
relation estimated_tax_imposed_11_or_L(a: TentativeApplication, amount: Money) kind empirical {
    label en official "the tax imposed by section 11 or subchapter L of chapter 1, whichever is applicable — dependency contract: `corporations`/insurance owners";
}
relation estimated_tax_imposed_55(a: TentativeApplication, amount: Money) kind empirical {
    label en official "the tax imposed by section 55 — dependency contract: `income-individual` (AMT)";
}
relation estimated_tax_imposed_59A(a: TentativeApplication, amount: Money) kind empirical {
    label en official "the tax imposed by section 59A — dependency contract: `international`";
}
relation estimated_part_iv_credits(a: TentativeApplication, amount: Money) kind empirical {
    label en official "the credits against tax provided by part IV of subchapter A of chapter 1 — dependency contract: `credits`";
}
pub relation corporate_income_tax_liability_6425c1(a: TentativeApplication, amount: Money) kind institutional {
    label en official "the excess of the sum of the tax imposed by section 11 or subchapter L, section 55 and section 59A over the part IV credits";
}
@source(IRC_S6425_C, relation = formalizes, coverage = exact, quote = "The term \"income tax liability\" means the excess of—")
rule S6425IncomeTaxLiabilityIsExcessOfTaxesOverCredits strict {
    for a: TentativeApplication;
    for t11: Money;
    for t55: Money;
    for t59a: Money;
    for credits: Money;
    when estimated_tax_imposed_11_or_L(a, t11) and estimated_tax_imposed_55(a, t55) and estimated_tax_imposed_59A(a, t59a) and estimated_part_iv_credits(a, credits);
    then corporate_income_tax_liability_6425c1(a, max(0 USD, t11 + t55 + t59a - credits));
}
relation application_states_estimated_liability(a: TentativeApplication, amount: Money) kind empirical {
    label en official "(B) the amount which, at the time of filing the application, the corporation estimates as its income tax liability for the taxable year";
}
pub relation estimated_tax_adjustment_amount(a: TentativeApplication, amount: Money) kind institutional {
    label en official "the amount of an adjustment under this section is the excess of the estimated income tax paid over the estimated income tax liability";
}
@source(IRC_S6425_C, relation = formalizes, coverage = exact, quote = "The amount of an adjustment under this section is equal to the excess of—")
rule S6425AdjustmentIsExcessOfPaidOverEstimatedLiability strict {
    for a: TentativeApplication;
    for paid: Money;
    for liability: Money;
    when application_kind(a, EstimatedTaxAdjustment) and estimated_tax_paid_during_year(a, paid) and application_states_estimated_liability(a, liability) and paid > liability;
    then estimated_tax_adjustment_amount(a, paid - liability);
}

relation application_states_adjustment_amount(a: TentativeApplication) kind empirical { label en official "(C) the amount of the adjustment"; }
relation application_states_other_information_6425(a: TentativeApplication) kind empirical { label en official "(D) such other information as may be required by regulations"; }
relation estimated_tax_application_complete(a: TentativeApplication) kind institutional { label en official "the application is verified under section 6065 and sets forth (A) the estimated tax paid, (B) the estimated income tax liability, (C) the adjustment, and (D) other required information"; }
@source(IRC_S6425_A, relation = formalizes, coverage = partial, quote = "The application shall set forth—")
rule S6425ApplicationSetsForthRequiredItems strict {
    for a: TentativeApplication;
    for paid: Money;
    for liability: Money;
    when application_kind(a, EstimatedTaxAdjustment) and application_verified_under_6065(a) and estimated_tax_paid_during_year(a, paid) and application_states_estimated_liability(a, liability)
        and application_states_adjustment_amount(a) and application_states_other_information_6425(a);
    then estimated_tax_application_complete(a);
}
// (b)(3): thresholds — 10 percent of the estimated liability and $500.
relation estimated_tax_adjustment_meets_thresholds(a: TentativeApplication) kind institutional {
    label en official "the adjustment equals or exceeds (A) 10 percent of the estimated income tax liability and (B) $500";
}
@source(IRC_S6425_B, relation = formalizes, coverage = exact, quote = "No application under this section shall be allowed unless the amount of the adjustment equals or exceeds (A) 10 percent of the amount estimated by the corporation on its application as its income tax liability for the taxable year, and (B) $500.")
rule S6425ThresholdsMet strict {
    for a: TentativeApplication;
    for adj: Money;
    for liability: Money;
    when estimated_tax_adjustment_amount(a, adj) and application_states_estimated_liability(a, liability)
        and adj >= liability * 0.10 and adj >= 500 USD;
    then estimated_tax_adjustment_meets_thresholds(a);
}
relation secretary_allows_estimated_tax_application(a: TentativeApplication) kind empirical {
    label en unofficial "the Secretary allows the application";
}
@source(IRC_S6425_B, relation = formalizes, coverage = exact, quote = "No application under this section shall be allowed unless the amount of the adjustment equals or exceeds (A) 10 percent of the amount estimated by the corporation on its application as its income tax liability for the taxable year, and (B) $500.")
rule S6425NoAllowanceBelowThresholds defeasible {
    for a: TentativeApplication;
    when application_kind(a, EstimatedTaxAdjustment) and secretary_allows_estimated_tax_application(a);
    then prohibition NoAllowanceOfBelowThresholdEstimatedTaxApplication {
        bearer Secretary;
        action secretary_allows_estimated_tax_application(a);
        window [-infinity, infinity];
    };
    unless estimated_tax_adjustment_meets_thresholds(a) and application_kind(a, EstimatedTaxAdjustment);
}

// (b)(1)-(2): 45 days.
relation estimated_tax_adjustment_determined(a: TentativeApplication) kind empirical {
    label en official "the Secretary has made the limited examination and determined the amount of the adjustment";
}
relation estimated_tax_adjustment_remainder_refunded(a: TentativeApplication) kind empirical {
    label en official "the Secretary refunds the remainder of the adjustment to the corporation after crediting";
}
relation application_defective_estimated_tax(a: TentativeApplication) kind empirical {
    label en official "the application contains material omissions or errors which he deems cannot be corrected within such 45 days";
}
@source(IRC_S6425_B, relation = formalizes, coverage = partial, quote = "Within a period of 45 days from the date on which an application for an adjustment is filed under subsection (a), the Secretary shall make, to the extent he deems practicable in such period, a limited examination of the application to discover omissions and errors therein, and shall determine the amount of the adjustment upon the basis of the application and the examination")
rule S6425DutyToDetermineWithinFortyFiveDays defeasible {
    for a: TentativeApplication;
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    when application_kind(a, EstimatedTaxAdjustment) and application_of(a, p, y) and application_filed_on(a, filed) and estimated_tax_adjustment_meets_thresholds(a);
    then duty DetermineEstimatedTaxAdjustment {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition estimated_tax_adjustment_determined(a);
            window [filed, add_calendar_period(filed, 45 calendar_day)];
        }
    };
    unless application_defective_estimated_tax(a) and application_of(a, p, y) and application_filed_on(a, filed);
}
relation secretary_disallows_estimated_tax_application(a: TentativeApplication) kind empirical;
relation estimated_tax_application_disallowed(a: TentativeApplication) kind institutional;
@source(IRC_S6425_B, relation = formalizes, coverage = exact, quote = "the Secretary may disallow, without further action, any application which he finds contains material omissions or errors which he deems cannot be corrected within such 45 days")
rule S6425MayDisallowDefectiveApplication strict {
    for a: TentativeApplication;
    when application_kind(a, EstimatedTaxAdjustment) and application_defective_estimated_tax(a);
    then power S6425DisallowDefectiveApplicationPower {
        holder Secretary;
        over a;
        exercise secretary_disallows_estimated_tax_application(a);
        valid_when application_defective_estimated_tax(a);
        effect create(estimated_tax_application_disallowed(a));
    };
}
relation estimated_tax_adjustment_credited_against_liability(a: TentativeApplication) kind empirical {
    label en official "the Secretary credits the amount of the adjustment against any liability in respect of an internal revenue tax on the part of the corporation";
}
relation secretary_credits_estimated_tax_adjustment(a: TentativeApplication) kind empirical;
@source(IRC_S6425_B, relation = formalizes, coverage = exact, quote = "The Secretary, within the 45-day period referred to in paragraph (1), may credit the amount of the adjustment against any liability in respect of an internal revenue tax on the part of the corporation")
rule S6425MayCreditAdjustmentAgainstLiability strict {
    for a: TentativeApplication;
    when application_kind(a, EstimatedTaxAdjustment) and estimated_tax_adjustment_determined(a);
    then power S6425CreditAdjustmentPower {
        holder Secretary;
        over a;
        exercise secretary_credits_estimated_tax_adjustment(a);
        valid_when estimated_tax_adjustment_determined(a);
        effect create(estimated_tax_adjustment_credited_against_liability(a));
    };
}
@source(IRC_S6425_B, relation = formalizes, coverage = exact, quote = "and shall refund the remainder to the corporation")
rule S6425DutyToRefundRemainder strict {
    for a: TentativeApplication;
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    when application_kind(a, EstimatedTaxAdjustment) and estimated_tax_adjustment_determined(a) and application_of(a, p, y) and application_filed_on(a, filed);
    then duty RefundRemainderOfEstimatedTaxAdjustment {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition estimated_tax_adjustment_remainder_refunded(a);
            window [filed, add_calendar_period(filed, 45 calendar_day)];
        }
    };
}

// (b)(4): the adjustment is a reduction in estimated tax paid, on the day the
// credit is allowed or the refund is paid, for the whole title except §6655.
relation estimated_tax_adjustment_allowed_or_paid_on(a: TentativeApplication, d: Date) kind empirical {
    label en official "the day the credit is allowed or the refund is paid";
}
pub relation estimated_tax_treated_as_reduced_on(a: TentativeApplication, amount: Money, d: Date) kind institutional {
    label en official "for purposes of this title (other than section 6655), any adjustment under this section shall be treated as a reduction in the estimated income tax paid, made on the day the credit is allowed or the refund is paid";
}
@source(IRC_S6425_B, relation = formalizes, coverage = exact, quote = "For purposes of this title (other than section 6655), any adjustment under this section shall be treated as a reduction, in the estimated income tax paid, made on the day the credit is allowed or the refund is paid.")
rule S6425AdjustmentTreatedAsReductionOnAllowance strict {
    for a: TentativeApplication;
    for adj: Money;
    for d: Date;
    when estimated_tax_adjustment_amount(a, adj) and estimated_tax_adjustment_allowed_or_paid_on(a, d);
    then estimated_tax_treated_as_reduced_on(a, adj, d);
}
