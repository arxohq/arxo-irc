// 26 U.S.C. §§6420, 6421, 6426 and 6427 — Chapter 65, Subchapter B (cont'd):
// payments to ultimate purchasers of gasoline used on a farm (§6420) or in
// an off-highway business use (§6421), the fuel-mixture and alternative-fuel
// credits allowed against the §4081/§4041 taxes (§6426) and the payments of
// fuel-tax refunds and credit-equivalents (§6427). Stage 2.
//
// JUDGMENT CALLS AND GAPS
//  - One entity `FuelClaim` and one enumerated basis (`FuelPaymentBasis`)
//    carry all thirteen payment grounds of §§6420, 6421, 6427: every ground
//    has the same skeleton (a purchaser, gallons, the rate at which tax was
//    imposed, an eligibility condition, a payee restriction, a filing
//    time), so the eligibility condition is a per-basis rule and the amount
//    and duty are shared. The rate of the §4041/§4081 tax "which applied on
//    the date he purchased" is a case fact in dollars per gallon (the excise
//    owners' rate schedules are external, DEPENDENCIES rows); the payment is
//    gallons x rate, rounded to cents HALF_UP (JUDGMENT CALL: the statute
//    names no rounding and §6420(e)(3) turns off the §7504 fractional-dollar
//    rule, so no whole-dollar rounding is applied).
//  - Statutory dollar figures are A3 datasets (`*.lawparam.json` beside this
//    file): the §6426 per-gallon credit rates, the §6427(b)(2)(A) 7.4 cent
//    reduction, and the §6427(i) thresholds. They are read at the
//    case's `legal_time` (the date the fuel is sold or used); windows come
//    from the pinned text and the statutory notes (section applicable to
//    fuel sold or used after 2004-12-31; §6426(d)/(e) after 2006-09-30;
//    §6426(k) after 2022-12-31). Earlier historical amounts of the credit
//    rates (before the amendments carried into the 2024 text) are NOT
//    pinned: SOURCE_GAP rows, no invented history.
//  - Pub. L. 119-21 sec. 70521(g)-(h) amends §6426(k): (4) no credit for a
//    gallon for which a §45Z credit is allowable, (5) termination for any
//    period after 2025-09-30. The coordination is a windowed defeater; the
//    termination bounds the SAF credit window (`effective`).
//  - §6427(l)(4)-(5) (kerosene aviation and vendor assignment) are modelled
//    as vendor-payment rules; the LUST-rate and 4.3-cent carve-outs need the
//    §4081 rate components (`excise-goods`) and are TECH-GAPS G2625.
//  - "Registered under section 4101", the excise rates and the definitions
//    of §4083(a), §4041(h), §4041(l), §4221 are dependency contracts
//    (external norms, `excise-goods`).

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6420_A,
    IRC_S6420_C,
    IRC_S6420_D,
    IRC_S6420_E,
    IRC_S6421_A,
    IRC_S6421_B,
    IRC_S6421_C,
    IRC_S6421_E,
    IRC_S6421_F,
    IRC_S6421_G,
    IRC_S6426_B,
    IRC_S6426_C,
    IRC_S6426_D,
    IRC_S6426_E,
    IRC_S6426_F,
    IRC_S6426_K,
    IRC_S6427_A,
    IRC_S6427_B,
    IRC_S6427_C,
    IRC_S6427_D,
    IRC_S6427_E,
    IRC_S6427_H,
    IRC_S6427_I,
    IRC_S6427_J,
    IRC_S6427_K,
    IRC_S6427_L,
    IRC_S6427_M,
    IRC_S6427_O,
    Person,
    Secretary,
    TaxableYear,
    fuel_claim_rate_carve_out_applies,
};

entity FuelClaim { label en unofficial "a claim for a payment or credit for fuel under §6420, §6421, §6426 or §6427"; }
enum FuelPaymentBasis {
    FarmGasoline;               // §6420(a)
    OffHighwayGasoline;         // §6421(a) first sentence
    AircraftGasoline;           // §6421(a) second sentence
    BusGasoline;                // §6421(b)
    ExemptPurposeGasoline;      // §6421(c)
    FuelUsedOtherThanSold;      // §6427(a)
    BusFuel;                    // §6427(b)
    FarmFuel;                   // §6427(c)
    MuseumOrHelicopterFuel;     // §6427(d)
    BlendStockNotUsedForFuel;   // §6427(h)
    NontaxableUseDieselKerosene; // §6427(l)
    DieselEmulsion;             // §6427(m)
    MixtureOrAlternativeFuelPayment; // §6427(e)
    label en unofficial "the ground on which the Secretary pays the purchaser";
}
relation fuel_claim_by(c: FuelClaim, p: Person, y: TaxableYear) kind empirical {
    label en official "the ultimate purchaser claiming for fuel used during his taxable year";
}
relation fuel_claim_basis(c: FuelClaim, b: FuelPaymentBasis) kind empirical;
relation fuel_claim_gallons(c: FuelClaim, gallons: Decimal) kind empirical {
    label en official "the number of gallons so used";
}
relation fuel_claim_tax_rate(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical {
    label en official "the rate at which tax was imposed on the fuel (section 4081 or 4041) that applied on the date of purchase — dependency contract: `excise-goods`";
}
relation fuel_claim_filed_on(c: FuelClaim, d: Date) kind empirical;
relation registered_under_4101_fuel(p: Person) kind empirical {
    label en official "registered under section 4101 — dependency contract: `excise-goods`";
}

// ============================================================================
// §6420 — Gasoline used on farms
// ============================================================================

relation fuel_used_in_trade_or_business(c: FuelClaim) kind empirical { label en official "(c)(1)(A) used in carrying on a trade or business"; }
relation fuel_used_on_farm_in_united_states(c: FuelClaim) kind empirical { label en official "(c)(1)(B) used on a farm situated in the United States"; }
relation place_is_a_farm(c: FuelClaim) kind empirical {
    label en official "(c)(2) stock, dairy, poultry, fruit, fur-bearing animal, and truck farms, plantations, ranches, nurseries, ranges, greenhouses or other similar structures used primarily for the raising of agricultural or horticultural commodities, and orchards";
}
relation user_is_owner_tenant_or_operator(c: FuelClaim) kind empirical { label en official "used by the owner, tenant, or operator of a farm"; }
relation used_in_cultivating_or_raising_commodity_on_own_farm(c: FuelClaim) kind empirical {
    label en official "(c)(3)(A) in connection with cultivating the soil, or raising or harvesting any agricultural or horticultural commodity, including livestock, bees, poultry, fur-bearing animals and wildlife, on a farm of which he is owner, tenant, or operator";
}
relation used_in_handling_drying_packing_or_storing_commodity(c: FuelClaim) kind empirical {
    label en official "(c)(3)(B) in handling, drying, packing, grading, or storing any agricultural or horticultural commodity in its unmanufactured state";
}
relation producer_of_more_than_half_of_commodity_treated(c: FuelClaim) kind empirical {
    label en official "such owner, tenant or operator produced more than one-half of the commodity which he so treated during the period with respect to which claim is filed";
}
relation used_for_trees_incidental_to_farming(c: FuelClaim) kind empirical {
    label en official "(c)(3)(C) in connection with the planting, cultivating, caring for, or cutting of trees, or the preparation (other than milling) of trees for market, incidental to farming operations";
}
relation used_in_operation_or_maintenance_of_farm(c: FuelClaim) kind empirical {
    label en official "(c)(3)(D) in connection with the operation, management, conservation, improvement, or maintenance of such farm and its tools and equipment";
}
relation used_for_farming_purposes_6420c3(c: FuelClaim) kind institutional {
    label en official "gasoline is used for farming purposes only if used as described in (c)(3)(A)-(D) by the owner, tenant, or operator of a farm";
}
rule S6420FarmingPurposeA strict { for c: FuelClaim; when user_is_owner_tenant_or_operator(c) and used_in_cultivating_or_raising_commodity_on_own_farm(c); then used_for_farming_purposes_6420c3(c); }
rule S6420FarmingPurposeB strict { for c: FuelClaim; when user_is_owner_tenant_or_operator(c) and used_in_handling_drying_packing_or_storing_commodity(c) and producer_of_more_than_half_of_commodity_treated(c); then used_for_farming_purposes_6420c3(c); }
rule S6420FarmingPurposeC strict { for c: FuelClaim; when user_is_owner_tenant_or_operator(c) and used_for_trees_incidental_to_farming(c); then used_for_farming_purposes_6420c3(c); }
rule S6420FarmingPurposeD strict { for c: FuelClaim; when user_is_owner_tenant_or_operator(c) and used_in_operation_or_maintenance_of_farm(c); then used_for_farming_purposes_6420c3(c); }
// (c)(4): a user other than the owner, tenant or operator.
relation used_by_person_other_than_farm_operator(c: FuelClaim) kind empirical { label en official "used on a farm for a purpose described in (c)(3)(A) by any person other than the owner, tenant, or operator of such farm"; }
relation user_is_aerial_or_other_applicator_and_ultimate_purchaser(c: FuelClaim) kind empirical { label en official "the person so using the gasoline is an aerial or other applicator of fertilizers or other substances and is the ultimate purchaser of the gasoline"; }
relation direct_flight_between_airfield_and_farms(c: FuelClaim) kind empirical { label en official "gasoline is used for the direct flight between the airfield and one or more farms (aerial applicator)"; }
relation farm_operator_is_treated_as_user_and_ultimate_purchaser(c: FuelClaim) kind institutional {
    label en official "the owner, tenant, or operator of the farm is treated as the user and ultimate purchaser of the gasoline";
}
@source(IRC_S6420_C, relation = formalizes, coverage = exact, quote = "the owner, tenant, or operator of such farm shall be treated as the user and ultimate purchaser of the gasoline, except that")
rule S6420OperatorTreatedAsUserAndPurchaser defeasible {
    for c: FuelClaim;
    when used_by_person_other_than_farm_operator(c);
    then farm_operator_is_treated_as_user_and_ultimate_purchaser(c);
    unless user_is_aerial_or_other_applicator_and_ultimate_purchaser(c) and used_by_person_other_than_farm_operator(c);
}
relation applicator_treated_as_having_used_for_farming_purposes(c: FuelClaim) kind institutional {
    label en official "the aerial or other applicator is treated as having used such gasoline on a farm for farming purposes";
}
@source(IRC_S6420_C, relation = formalizes, coverage = exact, quote = "then subparagraph (A) of this paragraph shall not apply and the aerial or other applicator shall be treated as having used such gasoline on a farm for farming purposes.")
rule S6420ApplicatorTreatedAsFarmUser strict {
    for c: FuelClaim;
    when used_by_person_other_than_farm_operator(c) and user_is_aerial_or_other_applicator_and_ultimate_purchaser(c);
    then applicator_treated_as_having_used_for_farming_purposes(c);
}
@source(IRC_S6420_C, relation = formalizes, coverage = exact, quote = "In the case of an aerial applicator, gasoline shall be treated as used on a farm for farming purposes if the gasoline is used for the direct flight between the airfield and one or more farms.")
rule S6420AerialApplicatorDirectFlight strict {
    for c: FuelClaim;
    when user_is_aerial_or_other_applicator_and_ultimate_purchaser(c) and direct_flight_between_airfield_and_farms(c);
    then applicator_treated_as_having_used_for_farming_purposes(c);
}
relation gasoline_used_on_farm_for_farming_purposes(c: FuelClaim) kind institutional {
    label en official "gasoline is treated as used on a farm for farming purposes only if used (A) in carrying on a trade or business, (B) on a farm situated in the United States, and (C) for farming purposes";
}
@source(IRC_S6420_C, relation = formalizes, coverage = exact, quote = "Gasoline shall be treated as used on a farm for farming purposes only if used (A) in carrying on a trade or business, (B) on a farm situated in the United States, and (C) for farming purposes.")
rule S6420UsedOnFarmForFarmingPurposes strict {
    for c: FuelClaim;
    when fuel_used_in_trade_or_business(c) and fuel_used_on_farm_in_united_states(c) and place_is_a_farm(c) and used_for_farming_purposes_6420c3(c);
    then gasoline_used_on_farm_for_farming_purposes(c);
}
rule S6420UsedOnFarmByApplicator strict {
    for c: FuelClaim;
    when fuel_used_in_trade_or_business(c) and fuel_used_on_farm_in_united_states(c) and place_is_a_farm(c) and applicator_treated_as_having_used_for_farming_purposes(c);
    then gasoline_used_on_farm_for_farming_purposes(c);
}

// The eligibility of every basis, as one relation each.
relation fuel_claim_eligible(c: FuelClaim) kind institutional {
    label en official "the substantive condition of the claim's payment basis is met";
}
@source(IRC_S6420_A, relation = formalizes, coverage = partial, quote = "if gasoline is used on a farm for farming purposes, the Secretary shall pay (without interest) to the ultimate purchaser of such gasoline the amount determined by multiplying—")
rule S6420FarmGasolineEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, FarmGasoline) and gasoline_used_on_farm_for_farming_purposes(c);
    then fuel_claim_eligible(c);
}
// (d): no amount for gasoline exempt from the §4081 tax; reduction by other amounts payable.
relation gasoline_exempt_from_4081_tax(c: FuelClaim) kind empirical { label en official "the Secretary determines the gasoline was exempt from the tax imposed by section 4081"; }
relation other_amount_payable_or_refundable_for_gasoline(c: FuelClaim, amount: Money) kind empirical {
    label en official "any other amount which the Secretary determines is payable under this section, or is refundable under any provision of this title, to any person with respect to such gasoline";
}
relation fuel_claim_deduction_for_other_amounts(c: FuelClaim, amount: Money) kind institutional {
    label en official "the amount payable is reduced by any other amount payable or refundable with respect to the gasoline";
}
rule S6420OtherAmountsReduce strict {
    for c: FuelClaim;
    for other: Money;
    when other_amount_payable_or_refundable_for_gasoline(c, other);
    then fuel_claim_deduction_for_other_amounts(c, other);
}
relation fuel_claim_has_other_amounts(c: FuelClaim) kind institutional {
    label en unofficial "helper: some other amount is payable or refundable with respect to the gasoline";
}
rule S6420HasOtherAmounts strict {
    for c: FuelClaim;
    for other: Money;
    when other_amount_payable_or_refundable_for_gasoline(c, other);
    then fuel_claim_has_other_amounts(c);
}
rule S6420NoOtherAmountsNoReduction strict {
    for c: FuelClaim;
    for p: Person;
    for y: TaxableYear;
    when fuel_claim_by(c, p, y) and not_known(fuel_claim_has_other_amounts(c));
    then fuel_claim_deduction_for_other_amounts(c, 0 USD);
}
// (e)(3): §7504 fractional-dollar discretion does not apply.
relation fractional_dollar_discretion_applies(c: FuelClaim) kind institutional {
    label en official "section 7504 (discretion with respect to fractional parts of a dollar) applies to the payment";
}
@source(IRC_S6420_E, relation = formalizes, coverage = exact, quote = "Section 7504 (granting the Secretary discretion with respect to fractional parts of a dollar) shall not apply.")
rule S6420FractionalDollarDiscretionDoesNotApply strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, FarmGasoline);
    then not fractional_dollar_discretion_applies(c);
}
// (e)(1): law applicable to the tax applies to the payments as to refunds.
relation fuel_payment_treated_as_refund_of_tax(c: FuelClaim) kind institutional {
    label en official "the payments are treated as refunds of overpayments of the tax imposed by §4041/§4081 for the application of the provisions of law applicable to that tax, including penalties";
}
@source(IRC_S6420_E, relation = formalizes, coverage = exact, quote = "apply in respect of the payments provided for in this section to the same extent as if such payments constituted refunds of overpayments of the tax so imposed")
@source(IRC_S6421_G, relation = formalizes, coverage = exact, quote = "apply in respect of the payments provided for in this section to the same extent as if such payments constituted refunds of overpayments of the tax so imposed")
@source(IRC_S6427_J, relation = formalizes, coverage = exact, quote = "apply in respect of the payments provided for in this section to the same extent as if such payments constituted refunds of overpayments of the tax so imposed")
rule S6420PaymentsTreatedAsRefunds strict {
    for c: FuelClaim;
    for b: FuelPaymentBasis;
    when fuel_claim_basis(c, b);
    then fuel_payment_treated_as_refund_of_tax(c);
}
// (e)(2): examination authority.
relation secretary_examines_claim(c: FuelClaim) kind empirical;
relation claim_examined_under_7602(c: FuelClaim) kind institutional;
@source(IRC_S6420_E, relation = formalizes, coverage = exact, quote = "the Secretary shall have the authority granted by paragraphs (1), (2), and (3) of section 7602(a) (relating to examination of books and witnesses) as if the claimant were the person liable for tax")
@source(IRC_S6421_G, relation = formalizes, coverage = exact, quote = "the Secretary shall have the authority granted by paragraphs (1), (2), and (3) of section 7602(a) (relating to examination of books and witnesses) as if the claimant were the person liable for tax")
@source(IRC_S6427_J, relation = formalizes, coverage = exact, quote = "the Secretary shall have the authority granted by paragraphs (1), (2), and (3) of section 7602(a) (relating to examination of books and witnesses) as if the claimant were the person liable for tax")
rule S6420SecretaryMayExamineClaimant strict {
    for c: FuelClaim;
    for b: FuelPaymentBasis;
    when fuel_claim_basis(c, b);
    then power S6420ExamineClaimantPower {
        holder Secretary;
        over c;
        exercise secretary_examines_claim(c);
        valid_when fuel_claim_basis_is_fuel_payment(c);
        effect create(claim_examined_under_7602(c));
    };
}
relation fuel_claim_basis_is_fuel_payment(c: FuelClaim) kind institutional {
    label en unofficial "the claim is for a payment under §6420, §6421 or §6427 (the examination authority applies as if the claimant were the taxpayer)";
}
rule S6420ClaimIsFuelPayment strict {
    for c: FuelClaim;
    for b: FuelPaymentBasis;
    when fuel_claim_basis(c, b);
    then fuel_claim_basis_is_fuel_payment(c);
}

// ============================================================================
// §6421 — Gasoline used for certain nonhighway purposes, by local transit
// buses, or in aviation
// ============================================================================

relation fuel_used_in_off_highway_business_use(c: FuelClaim) kind institutional {
    label en official "off-highway business use: any use in a trade or business or §212 activity otherwise than as a fuel in a highway vehicle registered or required to be registered for highway use (or owned by the United States and used on the highway)";
}
relation fuel_use_in_trade_or_business_or_212_activity(c: FuelClaim) kind empirical { label en official "any use by a person in a trade or business of such person or in an activity of such person described in section 212"; }
relation fuel_used_as_fuel_in_registered_highway_vehicle(c: FuelClaim) kind empirical { label en official "as a fuel in a highway vehicle which, at the time of use, is registered, or is required to be registered, for highway use under the laws of any State or foreign country"; }
relation fuel_used_in_us_owned_highway_vehicle_on_highway(c: FuelClaim) kind empirical { label en official "in the case of a highway vehicle owned by the United States, is used on the highway"; }
relation fuel_used_in_motorboat(c: FuelClaim) kind empirical { label en official "any use in a motorboat"; }
relation fuel_used_in_fishing_or_whaling_vessel(c: FuelClaim) kind empirical { label en official "any use in a vessel employed in the fisheries or in the whaling business"; }
relation vehicle_meets_design_based_test(c: FuelClaim) kind empirical {
    label en official "(e)(2)(C)(iii): a chassis with permanently mounted machinery for a construction/manufacturing/processing/farming/mining/drilling/timbering or similar operation unrelated to transportation, specially designed only as a mobile carriage and mount, not usable without substantial modification to transport other loads";
}
relation public_highway_miles_in_taxable_year(c: FuelClaim, miles: Integer) kind empirical { label en official "the use of the vehicle on public highways during the taxpayer's taxable year (miles), determined without regard to use by a §501(c) exempt organization"; }
relation vehicle_meets_use_based_test(c: FuelClaim) kind institutional { label en official "(e)(2)(C)(iv): the use of the vehicle on public highways was less than 7,500 miles during the taxable year"; }
rule S6421UseBasedTest strict {
    for c: FuelClaim;
    for miles: Integer;
    when public_highway_miles_in_taxable_year(c, miles) and miles < 7500;
    then vehicle_meets_use_based_test(c);
}
relation vehicle_qualifies_as_off_highway_by_design_and_use(c: FuelClaim) kind institutional { label en official "(e)(2)(C)(i)-(ii): the vehicle meets the design-based test and the use-based test"; }
rule S6421DesignAndUseTests strict {
    for c: FuelClaim;
    when vehicle_meets_design_based_test(c) and vehicle_meets_use_based_test(c);
    then vehicle_qualifies_as_off_highway_by_design_and_use(c);
}
relation off_highway_business_use_6421e2(c: FuelClaim) kind institutional { label en official "off-highway business use within §6421(e)(2)"; }
@source(IRC_S6421_E, relation = formalizes, coverage = exact, quote = "The term \"off-highway business use\" means any use by a person in a trade or business of such person or in an activity of such person described in section 212 (relating to production of income) otherwise than as a fuel in a highway vehicle—")
rule S6421OffHighwayGeneralUse defeasible {
    for c: FuelClaim;
    when fuel_use_in_trade_or_business_or_212_activity(c) and not_known(fuel_used_as_fuel_in_registered_highway_vehicle(c)) and not_known(fuel_used_in_us_owned_highway_vehicle_on_highway(c))
        and not_known(fuel_used_in_motorboat(c));
    then off_highway_business_use_6421e2(c);
}
@source(IRC_S6421_E, relation = formalizes, coverage = exact, quote = "The term \"off-highway business use\" shall include any use in a vessel employed in the fisheries or in the whaling business.")
rule S6421OffHighwayFishingVessel strict {
    for c: FuelClaim;
    when fuel_use_in_trade_or_business_or_212_activity(c) and fuel_used_in_fishing_or_whaling_vessel(c);
    then off_highway_business_use_6421e2(c);
}
@source(IRC_S6421_E, relation = formalizes, coverage = exact, quote = "The term \"off-highway business use\" shall include any use in a vehicle which meets the requirements described in clause (ii).")
rule S6421OffHighwayVehicleBothTests strict {
    for c: FuelClaim;
    when fuel_use_in_trade_or_business_or_212_activity(c) and vehicle_qualifies_as_off_highway_by_design_and_use(c);
    then off_highway_business_use_6421e2(c);
}
// (a) first sentence and (a) second sentence, (b), (c), and (f) exclusions.
relation fuel_used_in_aircraft(c: FuelClaim) kind empirical { label en official "gasoline used as a fuel in an aircraft"; }
relation aircraft_use_is_commercial_aviation(c: FuelClaim) kind empirical { label en official "commercial aviation (as defined in section 4083(b))"; }
relation fuel_used_in_train(c: FuelClaim) kind empirical { label en official "gasoline used as a fuel in a train"; }
relation automobile_bus_use_qualifies(c: FuelClaim) kind institutional { label en official "gasoline used in an automobile bus engaged in furnishing (for compensation) passenger land transportation available to the general public, or the transportation of students and employees of schools"; }
relation used_in_automobile_bus_public_transport(c: FuelClaim) kind empirical { label en official "used in an automobile bus while engaged in furnishing (for compensation) passenger land transportation available to the general public"; }
relation used_in_automobile_bus_school_transport(c: FuelClaim) kind empirical { label en official "used in an automobile bus while engaged in the transportation of students and employees of schools"; }
relation bus_transport_not_scheduled_and_not_regular_routes(c: FuelClaim) kind empirical { label en official "transportation which is not scheduled and not along regular routes"; }
relation bus_seating_capacity_adults(c: FuelClaim, adults: Integer) kind empirical { label en official "the seating capacity of such bus (adults, not including the driver)"; }
rule S6421BusSchoolTransport strict { for c: FuelClaim; when used_in_automobile_bus_school_transport(c); then automobile_bus_use_qualifies(c); }
rule S6421BusScheduledPublicTransport strict { for c: FuelClaim; when used_in_automobile_bus_public_transport(c) and not_known(bus_transport_not_scheduled_and_not_regular_routes(c)); then automobile_bus_use_qualifies(c); }
@source(IRC_S6421_B, relation = formalizes, coverage = exact, quote = "Paragraph (1)(A) shall not apply in respect of gasoline used in any automobile bus while engaged in furnishing transportation which is not scheduled and not along regular routes unless the seating capacity of such bus is at least 20 adults (not including the driver).")
rule S6421BusUnscheduledNeedsTwentySeats strict {
    for c: FuelClaim;
    for seats: Integer;
    when used_in_automobile_bus_public_transport(c) and bus_transport_not_scheduled_and_not_regular_routes(c) and bus_seating_capacity_adults(c, seats) and seats >= 20;
    then automobile_bus_use_qualifies(c);
}
relation gasoline_sold_for_4221a_purpose(c: FuelClaim) kind empirical { label en official "gasoline is sold to any person for any purpose described in paragraph (2), (3), (4), (5), or (6) of section 4221(a) (treated as used for that purpose when so sold)"; }
relation farm_use_excluded_from_6421(c: FuelClaim) kind institutional { label en official "§6421(f)(1): the section does not apply to gasoline used on a farm for farming purposes (within §6420(c)(1)-(3))"; }
rule S6421FarmUseExcluded strict {
    for c: FuelClaim;
    when gasoline_used_on_farm_for_farming_purposes(c);
    then farm_use_excluded_from_6421(c);
}

@source(IRC_S6421_A, relation = formalizes, coverage = partial, quote = "if gasoline is used in an off-highway business use, the Secretary shall pay (without interest) to the ultimate purchaser of such gasoline an amount equal to the amount determined by multiplying the number of gallons so used by the rate at which tax was imposed on such gasoline under section 4081")
rule S6421OffHighwayGasolineEligible defeasible {
    for c: FuelClaim;
    when fuel_claim_basis(c, OffHighwayGasoline) and off_highway_business_use_6421e2(c);
    then fuel_claim_eligible(c);
    unless farm_use_excluded_from_6421(c) and fuel_claim_basis(c, OffHighwayGasoline);
}
@source(IRC_S6421_A, relation = formalizes, coverage = partial, quote = "in the case of gasoline used as a fuel in an aircraft, the Secretary shall pay (without interest) to the ultimate purchaser of such gasoline")
@source(IRC_S6421_F, relation = formalizes, coverage = partial, quote = "This section shall not apply in respect of gasoline which is used as a fuel in an aircraft—")
rule S6421AircraftGasolineEligible defeasible {
    for c: FuelClaim;
    when fuel_claim_basis(c, AircraftGasoline) and fuel_used_in_aircraft(c) and aircraft_use_is_commercial_aviation(c);
    then fuel_claim_eligible(c);
    unless farm_use_excluded_from_6421(c) and fuel_claim_basis(c, AircraftGasoline);
}
@source(IRC_S6421_B, relation = formalizes, coverage = partial, quote = "if gasoline is used in an automobile bus while engaged in—")
rule S6421BusGasolineEligible defeasible {
    for c: FuelClaim;
    when fuel_claim_basis(c, BusGasoline) and automobile_bus_use_qualifies(c);
    then fuel_claim_eligible(c);
    unless farm_use_excluded_from_6421(c) and fuel_claim_basis(c, BusGasoline);
}
@source(IRC_S6421_C, relation = formalizes, coverage = partial, quote = "If gasoline is sold to any person for any purpose described in paragraph (2), (3), (4), (5), or (6) of section 4221(a), the Secretary shall pay (without interest) to such person")
rule S6421ExemptPurposeGasolineEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, ExemptPurposeGasoline) and gasoline_sold_for_4221a_purpose(c);
    then fuel_claim_eligible(c);
}

// ============================================================================
// §6427 — Fuels not used for taxable purposes
// ============================================================================

// (a): fuel other than the use for which sold, or resold.
relation fuel_taxed_under_4041a2_a3_or_c_on_sale_stated(c: FuelClaim) kind empirical { label en official "tax has been imposed under paragraph (2) or (3) of section 4041(a) or section 4041(c) on the sale of any fuel"; }
relation fuel_taxed_under_4041d_on_sale(c: FuelClaim) kind empirical { label en official "tax has been imposed under section 4041(d) on the sale of the fuel"; }
relation fuel_taxed_under_4041a2_a3_or_c_on_sale(c: FuelClaim) kind institutional { label en official "for purposes of subsections (a), (b), and (c), the taxes imposed by section 4041(d) are treated as imposed by section 4041(a)"; }
rule S6427TaxStatedUnder4041 strict { for c: FuelClaim; when fuel_taxed_under_4041a2_a3_or_c_on_sale_stated(c); then fuel_taxed_under_4041a2_a3_or_c_on_sale(c); }
@source(IRC_S6427_O, relation = formalizes, coverage = exact, quote = "For purposes of subsections (a), (b), and (c), the taxes imposed by section 4041(d) shall be treated as imposed by section 4041(a).")
rule S6427Tax4041dTreatedAs4041a strict { for c: FuelClaim; when fuel_taxed_under_4041d_on_sale(c); then fuel_taxed_under_4041a2_a3_or_c_on_sale(c); }
relation purchaser_uses_fuel_other_than_for_use_sold(c: FuelClaim) kind empirical { label en official "the purchaser uses such fuel other than for the use for which sold"; }
relation purchaser_resells_fuel(c: FuelClaim) kind empirical { label en official "the purchaser resells such fuel"; }
relation tax_imposed_on_sale_of_fuel(c: FuelClaim, amount: Money) kind empirical { label en official "(1) the amount of tax imposed on the sale of the fuel to him"; }
relation tax_that_would_have_been_imposed_on_use(c: FuelClaim, amount: Money) kind empirical { label en official "(2) if he uses the fuel, the amount of tax which would have been imposed under section 4041 on such use if no tax had been imposed on the sale"; }
@source(IRC_S6427_A, relation = formalizes, coverage = partial, quote = "and the purchaser uses such fuel other than for the use for which sold, or resells such fuel")
rule S6427FuelOtherThanSoldEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, FuelUsedOtherThanSold) and fuel_taxed_under_4041a2_a3_or_c_on_sale(c)
        and (purchaser_uses_fuel_other_than_for_use_sold(c) or purchaser_resells_fuel(c));
    then fuel_claim_eligible(c);
}
pub relation fuel_used_other_than_sold_payment_amount(c: FuelClaim, amount: Money) kind institutional {
    label en official "the tax imposed on the sale of the fuel, reduced (if he uses the fuel) by the tax which would have been imposed on such use";
}
@source(IRC_S6427_A, relation = formalizes, coverage = exact, quote = "the amount of tax imposed on the sale of the fuel to him, reduced by")
rule S6427PaymentWhenUsedOtherThanSold defeasible {
    for c: FuelClaim;
    for sale_tax: Money;
    for use_tax: Money;
    when fuel_claim_eligible(c) and fuel_claim_basis(c, FuelUsedOtherThanSold) and purchaser_uses_fuel_other_than_for_use_sold(c)
        and tax_imposed_on_sale_of_fuel(c, sale_tax) and tax_that_would_have_been_imposed_on_use(c, use_tax);
    then fuel_used_other_than_sold_payment_amount(c, max(0 USD, sale_tax - use_tax));
}
rule S6427PaymentWhenResold defeasible {
    for c: FuelClaim;
    for sale_tax: Money;
    when fuel_claim_eligible(c) and fuel_claim_basis(c, FuelUsedOtherThanSold) and purchaser_resells_fuel(c)
        and tax_imposed_on_sale_of_fuel(c, sale_tax) and not_known(purchaser_uses_fuel_other_than_for_use_sold(c));
    then fuel_used_other_than_sold_payment_amount(c, sale_tax);
}
// (b): automobile buses, non-gasoline fuel; the 7.4 cent reduction.
relation bus_fuel_use_is_school_transport(c: FuelClaim) kind empirical { label en official "(b)(1)(B): the transportation of students and employees of schools"; }
relation bus_use_is_intracity_scheduled_regular_route(c: FuelClaim) kind empirical { label en official "(b)(2)(C): intracity passenger land transportation available to the general public, scheduled and along regular routes"; }
relation bus_is_qualified_local_bus(c: FuelClaim) kind empirical { label en official "(b)(2)(D): a local bus with seating capacity of at least 20 adults which is under contract (or receives more than a nominal subsidy) from a State or local government"; }
relation fuel_used_in_automobile_bus_engaged_in_public_or_school_transport(c: FuelClaim) kind empirical { label en official "fuel other than gasoline on the sale of which tax was imposed by section 4041(a) or 4081 is used in an automobile bus while engaged in (A) public transportation for compensation or (B) transporting students and employees of schools"; }
@source(IRC_S6427_B, relation = formalizes, coverage = partial, quote = "the Secretary shall pay (without interest) to the ultimate purchaser of such fuel an amount equal to the product of the number of gallons of such fuel so used multiplied by the rate at which tax was imposed on such fuel by section 4041(a) or 4081, as the case may be.")
rule S6427BusFuelEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, BusFuel) and fuel_used_in_automobile_bus_engaged_in_public_or_school_transport(c);
    then fuel_claim_eligible(c);
}
relation bus_fuel_rate_reduction_applies(c: FuelClaim) kind institutional {
    label en official "the rate of tax taken into account is 7.4 cents per gallon less than the aggregate rate, except for school transportation and qualified local buses in intracity scheduled service";
}
@source(IRC_S6427_B, relation = formalizes, coverage = exact, quote = "the rate of tax taken into account under paragraph (1) shall be 7.4 cents per gallon less than the aggregate rate at which tax was imposed on such fuel by section 4041(a) or 4081, as the case may be.")
rule S6427BusFuelRateReductionApplies defeasible {
    for c: FuelClaim;
    when fuel_claim_basis(c, BusFuel);
    then bus_fuel_rate_reduction_applies(c);
    unless bus_fuel_use_is_school_transport(c) and fuel_claim_basis(c, BusFuel);
    unless bus_use_is_intracity_scheduled_regular_route(c) and bus_is_qualified_local_bus(c) and fuel_claim_basis(c, BusFuel);
}
// (b)(3): unscheduled non-regular-route service requires 20 seats.
relation bus_fuel_unscheduled_service(c: FuelClaim) kind empirical { label en official "furnishing transportation which is not scheduled and not along regular routes"; }
relation bus_fuel_seats_adults(c: FuelClaim, adults: Integer) kind empirical;
relation bus_fuel_unscheduled_seating_shortfall(c: FuelClaim) kind institutional { label en official "the bus furnishing unscheduled non-regular-route transportation has fewer than 20 adult seats"; }
rule S6427BusFuelSeatingShortfall strict {
    for c: FuelClaim;
    for seats: Integer;
    when bus_fuel_unscheduled_service(c) and bus_fuel_seats_adults(c, seats) and seats < 20;
    then bus_fuel_unscheduled_seating_shortfall(c);
}
// (c): farm fuel; (d): aircraft museums and helicopters; (h): blend stocks;
// (m): emulsions.
relation fuel_used_on_farm_for_farming_purposes_6427c(c: FuelClaim) kind institutional { label en official "fuel on the sale of which tax was imposed under §4041(a)(2)-(3) or §4041(c) is used on a farm for farming purposes (within §6420(c), 'liquid taxable under section 4041' substituted for 'gasoline' in (c)(4))"; }
rule S6427FarmFuelUse strict { for c: FuelClaim; when fuel_taxed_under_4041a2_a3_or_c_on_sale(c) and gasoline_used_on_farm_for_farming_purposes(c); then fuel_used_on_farm_for_farming_purposes_6427c(c); }
@source(IRC_S6427_C, relation = formalizes, coverage = partial, quote = "the Secretary shall pay (without interest) to the purchaser an amount equal to the amount of the tax imposed on the sale of the fuel")
rule S6427FarmFuelEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, FarmFuel) and fuel_used_on_farm_for_farming_purposes_6427c(c);
    then fuel_claim_eligible(c);
}
relation fuel_used_by_aircraft_museum_or_helicopter_use(c: FuelClaim) kind empirical { label en official "used by an aircraft museum in an aircraft or vehicle owned by such museum and used exclusively for purposes set forth in section 4041(h)(2)(C), or used in a helicopter or fixed-wing aircraft for a purpose described in section 4041(l)"; }
@source(IRC_S6427_D, relation = formalizes, coverage = partial, quote = "is used by an aircraft museum (as defined in section 4041(h)(2)) in an aircraft or vehicle owned by such museum and used exclusively for purposes set forth in section 4041(h)(2)(C), or is used in a helicopter or a fixed-wing aircraft for a purpose described in section 4041(l)")
rule S6427MuseumOrHelicopterEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, MuseumOrHelicopterFuel) and fuel_used_by_aircraft_museum_or_helicopter_use(c);
    then fuel_claim_eligible(c);
}
relation blend_stock_not_used_to_produce_fuel(c: FuelClaim) kind empirical { label en official "any gasoline blend stock or additive (§4083(a)(2)) [or diesel fuel blend stock] is not used by any person to produce gasoline [diesel fuel] and such person establishes that the ultimate use is not to produce it"; }
@source(IRC_S6427_H, relation = formalizes, coverage = exact, quote = "the Secretary shall pay (without interest) to such person an amount equal to the aggregate amount of the tax imposed on such person with respect to such gasoline blend stock or additive.")
rule S6427BlendStockEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, BlendStockNotUsedForFuel) and blend_stock_not_used_to_produce_fuel(c);
    then fuel_claim_eligible(c);
}
relation diesel_fuel_used_in_emulsion(c: FuelClaim) kind empirical { label en official "diesel fuel on which tax was imposed by section 4081 at the regular tax rate is used by any person in producing an emulsion described in section 4081(a)(2)(D) which is sold or used in such person's trade or business"; }
relation emulsion_regular_tax_rate(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "(m)(2)(A) the aggregate rate of tax imposed by section 4081 determined without regard to section 4081(a)(2)(D)"; }
relation emulsion_incentive_tax_rate(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "(m)(2)(B) the aggregate rate of tax imposed by section 4081 determined with regard to section 4081(a)(2)(D)"; }
@source(IRC_S6427_M, relation = formalizes, coverage = exact, quote = "the Secretary shall pay (without interest) to such person an amount equal to the excess of the regular tax rate over the incentive tax rate with respect to such fuel")
rule S6427EmulsionEligible strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, DieselEmulsion) and diesel_fuel_used_in_emulsion(c);
    then fuel_claim_eligible(c);
}
// (l): diesel fuel and kerosene in a nontaxable use.
relation diesel_or_kerosene_used_in_nontaxable_use(c: FuelClaim) kind empirical { label en official "(l)(2) any use which is exempt from the tax imposed by section 4041(a)(1) other than by reason of a prior imposition of tax"; }
relation diesel_used_in_diesel_powered_train(c: FuelClaim) kind empirical { label en official "(l)(3) fuel used in a diesel-powered train"; }
relation fuel_sold_for_exclusive_use_by_state_or_subdivision(c: FuelClaim) kind empirical { label en official "fuel sold for exclusive use by a State or any political subdivision thereof"; }
relation fuel_used_by_state_or_local_government(c: FuelClaim) kind empirical { label en official "(l)(5)(A) diesel fuel or kerosene used by a State or local government"; }
relation kerosene_sold_from_pump_unsuitable_for_highway_or_train(c: FuelClaim) kind empirical { label en official "(l)(5)(B)(i) kerosene (other than aviation) sold by a vendor for any use if sold from a pump not suitable for fueling any diesel-powered highway vehicle or train"; }
relation kerosene_for_blending_with_heating_oil(c: FuelClaim) kind empirical { label en official "(l)(5)(B)(ii) kerosene sold to the extent provided by the Secretary for blending with heating oil during periods of extreme or unseasonable cold"; }
relation nontaxable_use_train_included(c: FuelClaim) kind institutional { label en official "nontaxable use includes fuel used in a diesel-powered train, except for the LUST rate and 4.3-cent portions, and except fuel sold for exclusive use by a State or subdivision"; }
rule S6427TrainIsNontaxableUse strict { for c: FuelClaim; when diesel_used_in_diesel_powered_train(c) and not_known(fuel_sold_for_exclusive_use_by_state_or_subdivision(c)); then nontaxable_use_train_included(c); }
relation ultimate_vendor_paid_under_l4C_i(c: FuelClaim, amount: Money) kind empirical { label en official "any payment made to the ultimate vendor under paragraph (4)(C)(i)"; }
relation nontaxable_use_payment_goes_to_vendor(c: FuelClaim) kind institutional { label en official "the amount which would have been paid to the purchaser is paid instead to the registered ultimate vendor (assignment under (l)(4)(C) or (l)(5)(C))"; }
relation ultimate_purchaser_assigned_right_to_vendor(c: FuelClaim) kind empirical { label en official "the ultimate purchaser waives the right to payment and assigns it to the ultimate vendor"; }
relation vendor_meets_6416a1_requirements(c: FuelClaim) kind empirical { label en official "the vendor meets the requirements of subparagraph (A), (B), or (D) of section 6416(a)(1)"; }
relation fuel_purchase_by_credit_card_issuer(c: FuelClaim, issuer: Person) kind empirical { label en official "(l)(5)(D) the purchase of the fuel is made by means of a credit card issued to the ultimate purchaser; the issuer is the person extending the credit"; }
relation credit_card_issuer_meets_6416a4B(c: FuelClaim) kind empirical { label en official "the person extending the credit meets the requirements of clauses (i), (ii), and (iii) of section 6416(a)(4)(B)"; }
relation nontaxable_use_payment_goes_to_card_issuer(c: FuelClaim, issuer: Person) kind institutional { label en official "the Secretary pays the person extending the credit the amount which would have been paid under paragraph (1)"; }
@source(IRC_S6427_L, relation = formalizes, coverage = partial, quote = "the Secretary shall pay to the person extending the credit to the ultimate purchaser the amount which would have been paid under paragraph (1) (but for subparagraph (A))")
rule S6427PaidToCardIssuer strict {
    for c: FuelClaim;
    for issuer: Person;
    when fuel_claim_basis(c, NontaxableUseDieselKerosene) and fuel_used_by_state_or_local_government(c) and fuel_purchase_by_credit_card_issuer(c, issuer) and credit_card_issuer_meets_6416a4B(c);
    then nontaxable_use_payment_goes_to_card_issuer(c, issuer);
}
rule S6427VendorPaidOnAssignment strict {
    for c: FuelClaim;
    for vendor: Person;
    for b: FuelPaymentBasis;
    when fuel_claim_basis(c, b) and (b == NontaxableUseDieselKerosene or b == BusFuel) and ultimate_purchaser_assigned_right_to_vendor(c) and fuel_claim_by(c, vendor, _) and registered_under_4101_fuel(vendor) and vendor_meets_6416a1_requirements(c);
    then nontaxable_use_payment_goes_to_vendor(c);
}
@source(IRC_S6427_L, relation = formalizes, coverage = partial, quote = "if any diesel fuel or kerosene on which tax has been imposed by section 4041 or 4081 is used by any person in a nontaxable use, the Secretary shall pay (without interest) to the ultimate purchaser of such fuel an amount equal to the aggregate amount of tax imposed on such fuel under section 4041 or 4081, as the case may be, reduced by any payment made to the ultimate vendor under paragraph (4)(C)(i).")
rule S6427NontaxableUseEligible defeasible {
    for c: FuelClaim;
    when fuel_claim_basis(c, NontaxableUseDieselKerosene) and (diesel_or_kerosene_used_in_nontaxable_use(c) or nontaxable_use_train_included(c));
    then fuel_claim_eligible(c);
    unless fuel_used_by_state_or_local_government(c) and fuel_claim_basis(c, NontaxableUseDieselKerosene);
    unless kerosene_sold_from_pump_unsuitable_for_highway_or_train(c) and fuel_claim_basis(c, NontaxableUseDieselKerosene);
    unless kerosene_for_blending_with_heating_oil(c) and fuel_claim_basis(c, NontaxableUseDieselKerosene);
}
// (e): mixture and alternative-fuel payments — the amount is the §6426 credit.
relation mixture_or_alternative_fuel_produced_in_trade_or_business(c: FuelClaim) kind empirical { label en official "any person produces a mixture described in section 6426 in such person's trade or business, or sells or uses an alternative fuel for a purpose described in section 6426(d)(1) in such person's trade or business"; }
relation credit_allowed_against_tax_for_fuel(c: FuelClaim) kind empirical { label en official "an amount is allowed as a credit under section 6426 with respect to the mixture or alternative fuel"; }
relation fuel_credit_disallowed_by_6426i(c: FuelClaim) kind empirical { label en official "credit is not allowed with respect to such mixture or alternative fuel by reason of section 6426(i)"; }
relation payment_type_is_alternative_fuel_credit(c: FuelClaim) kind empirical { label en official "the payment is an alternative fuel credit or alternative fuel mixture credit (registration required under section 4101)"; }
enum MixturePaymentKind { AlcoholFuelMixturePayment; BiodieselMixturePayment; AlternativeFuelPayment; AlternativeFuelMixturePayment; SafMixturePayment; label en official "the credit whose equivalent is paid under §6427(e): alcohol fuel mixture, biodiesel mixture, alternative fuel, alternative fuel mixture, sustainable aviation fuel mixture"; }
relation mixture_payment_kind_and_date(c: FuelClaim, k: MixturePaymentKind, sold_or_used_on: Date) kind empirical { label en official "the kind of mixture or fuel and the date it was sold or used"; }
relation payment_period_after_sunset_6427e6(c: FuelClaim) kind institutional { label en official "(e)(6) the mixture or fuel was sold or used after the date on which the subsection ceases to apply (alcohol fuel mixture and alternative fuel mixture after 2011-12-31; biodiesel mixture, alternative fuel and SAF mixture after 2024-12-31)"; }
@source(IRC_S6427_E, relation = formalizes, coverage = exact, quote = "(A) any alcohol fuel mixture (as defined in section 6426(b)(3)) sold or used after December 31, 2011,")
rule S6427SunsetAlcoholMixture strict { for c: FuelClaim; for d: Date; when mixture_payment_kind_and_date(c, AlcoholFuelMixturePayment, d) and d > @2011-12-31; then payment_period_after_sunset_6427e6(c); }
@source(IRC_S6427_E, relation = formalizes, coverage = exact, quote = "(B) any biodiesel mixture (as defined in section 6426(c)(3)) sold or used after December 31, 2024,")
rule S6427SunsetBiodieselMixture strict { for c: FuelClaim; for d: Date; when mixture_payment_kind_and_date(c, BiodieselMixturePayment, d) and d > @2024-12-31; then payment_period_after_sunset_6427e6(c); }
@source(IRC_S6427_E, relation = formalizes, coverage = exact, quote = "(C) any alternative fuel (as defined in section 6426(d)(2)) sold or used after December 31, 2024,")
rule S6427SunsetAlternativeFuel strict { for c: FuelClaim; for d: Date; when mixture_payment_kind_and_date(c, AlternativeFuelPayment, d) and d > @2024-12-31; then payment_period_after_sunset_6427e6(c); }
@source(IRC_S6427_E, relation = formalizes, coverage = exact, quote = "(D) any alternative fuel mixture (as defined in section 6426(e)(2)) sold or used after December 31, 2011, and")
rule S6427SunsetAlternativeFuelMixture strict { for c: FuelClaim; for d: Date; when mixture_payment_kind_and_date(c, AlternativeFuelMixturePayment, d) and d > @2011-12-31; then payment_period_after_sunset_6427e6(c); }
@source(IRC_S6427_E, relation = formalizes, coverage = exact, quote = "(E) any qualified mixture of sustainable aviation fuel (as defined in section 6426(k)(3)) [1] sold or used after December 31, 2024.")
rule S6427SunsetSafMixture strict { for c: FuelClaim; for d: Date; when mixture_payment_kind_and_date(c, SafMixturePayment, d) and d > @2024-12-31; then payment_period_after_sunset_6427e6(c); }
@source(IRC_S6427_E, relation = formalizes, coverage = partial, quote = "If any person produces a mixture described in section 6426 in such person's trade or business, the Secretary shall pay (without interest) to such person an amount equal to the alcohol fuel mixture credit or the biodiesel mixture credit or the alternative fuel mixture credit or the sustainable aviation fuel mixture credit with respect to such mixture.")
rule S6427MixturePaymentEligible defeasible {
    for c: FuelClaim;
    when fuel_claim_basis(c, MixtureOrAlternativeFuelPayment) and mixture_or_alternative_fuel_produced_in_trade_or_business(c)
        and not_known(credit_allowed_against_tax_for_fuel(c)) and not_known(fuel_credit_disallowed_by_6426i(c)) and not_known(payment_period_after_sunset_6427e6(c));
    then fuel_claim_eligible(c);
    unless payment_type_is_alternative_fuel_credit(c) and not_known(registered_payee_of(c)) and fuel_claim_basis(c, MixtureOrAlternativeFuelPayment);
}
relation registered_payee_of(c: FuelClaim) kind empirical { label en official "the payee is registered under section 4101"; }

// The payee restriction, timing and quarterly rules.
relation payee_is_government_or_nonfiling_exempt_org(c: FuelClaim) kind empirical {
    label en official "the United States or an agency or instrumentality, a State, a political subdivision, or an agency of States or subdivisions; or an organization exempt under section 501(a) other than one required to make a return of the tax imposed under subtitle A for its taxable year";
}
relation claim_is_quarterly_or_special_claim(c: FuelClaim) kind empirical {
    label en official "§6427(i)(2), (3), (4) claims (and the §6421(d)(2) payments per quarter) for which the payee restriction does not apply";
}
relation fuel_claim_payee_permitted(c: FuelClaim) kind institutional {
    label en official "payment is made only to government entities and non-return-filing exempt organizations, or on a claim to which the restriction does not apply";
}
@source(IRC_S6427_K, relation = formalizes, coverage = exact, quote = "Payment shall be made under this section only to—")
rule S6427PayeeIsGovernmentOrExemptOrg strict { for c: FuelClaim; when payee_is_government_or_nonfiling_exempt_org(c); then fuel_claim_payee_permitted(c); }
@source(IRC_S6427_K, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to a payment of a claim filed under paragraph (2), (3), or (4) of subsection (i).")
rule S6427PayeeRestrictionDoesNotApplyToQuarterlyClaims strict { for c: FuelClaim; when claim_is_quarterly_or_special_claim(c); then fuel_claim_payee_permitted(c); }

// Annual filing time: one claim per taxable year, filed by the time for a
// claim for credit or refund of income tax for that year.
relation income_tax_refund_claim_deadline_for_year(c: FuelClaim, d: Date) kind empirical {
    label en official "the time prescribed by law for filing a claim for credit or refund of overpayment of income tax for the taxable year (§6511: dependency contract, `assessment`)";
}
relation fuel_claim_only_one_for_year(c: FuelClaim) kind empirical { label en official "not more than one claim is filed by the person with respect to fuel used during his taxable year"; }
relation fuel_claim_annual_filing_ok(c: FuelClaim) kind institutional { label en official "the only claim for the year, filed by the income-tax refund-claim deadline"; }
@source(IRC_S6427_I, relation = formalizes, coverage = partial, quote = "not more than one claim may be filed under subsection (a), (b), (c), (d), (h), (l), (m), or (o) by any person with respect to fuel used during his taxable year")
rule S6427AnnualClaimFilingOk strict {
    for c: FuelClaim;
    for filed: Date;
    for deadline: Date;
    when fuel_claim_only_one_for_year(c) and fuel_claim_filed_on(c, filed) and income_tax_refund_claim_deadline_for_year(c, deadline) and filed <= deadline;
    then fuel_claim_annual_filing_ok(c);
}
// Quarterly claims (i)(2): at least $750 payable at the close of a quarter.
relation quarterly_amount_payable(c: FuelClaim, amount: Money) kind empirical { label en official "the aggregate amount payable under subsections (a), (b), (d), (h), (l), (m), (o) of section 6427 and section 6421 for the quarter (and prior unclaimed quarters of the year)"; }
relation claim_filed_in_first_quarter_after_last_quarter_included(c: FuelClaim) kind empirical { label en official "(i)(2)(B) filed during the first quarter following the last quarter included in the claim"; }
relation fuel_used_solely_in_design_based_off_highway_use(c: FuelClaim) kind empirical { label en official "(i)(2)(C) the fuel is used solely in any off-highway business use described in section 6421(e)(2)(C)"; }
relation quarterly_claim_permitted(c: FuelClaim) kind institutional { label en official "§6427(i)(2): at least $750 payable at the close of a quarter, claim filed during the first quarter following"; }
@source(IRC_S6427_I, relation = formalizes, coverage = partial, quote = "at least $750 is payable in the aggregate under subsections (a), (b), (d), (h), (l), (m), and (o) of this section and section 6421")
rule S6427QuarterlyClaimPermitted strict {
    for c: FuelClaim;
    for amount: Money;
    when quarterly_amount_payable(c, amount) and amount >= QuarterlyFuelClaimThreshold and claim_filed_in_first_quarter_after_last_quarter_included(c) and not_known(fuel_used_solely_in_design_based_off_highway_use(c));
    then quarterly_claim_permitted(c);
}
// (i)(3): mixture credit / alternative fuel claims: $200 and one week; (i)(4): vendor claims $200 ($100 kerosene).
relation period_amount_payable_mixture_claim(c: FuelClaim, amount: Money) kind empirical;
relation claim_period_at_least_one_week(c: FuelClaim) kind empirical;
relation claim_is_electronic(c: FuelClaim) kind empirical { label en official "an electronic claim"; }
relation filed_by_end_of_first_quarter_after_earliest_quarter(c: FuelClaim) kind empirical { label en official "(i)(3)(C), (i)(4)(B): the claim is filed on or before the last day of the first quarter following the earliest quarter included in the claim"; }
relation mixture_claim_period_permitted(c: FuelClaim) kind institutional { label en official "§6427(i)(3)(A): $200 or more payable for a period of at least one week (an electronic claim disregards the $200 test)"; }
rule S6427MixtureClaimPeriodPermitted strict {
    for c: FuelClaim;
    for amount: Money;
    when period_amount_payable_mixture_claim(c, amount) and amount >= MixtureFuelClaimThreshold and claim_period_at_least_one_week(c) and filed_by_end_of_first_quarter_after_earliest_quarter(c);
    then mixture_claim_period_permitted(c);
}
rule S6427MixtureClaimPeriodPermittedElectronic strict {
    for c: FuelClaim;
    when claim_is_electronic(c) and claim_period_at_least_one_week(c) and filed_by_end_of_first_quarter_after_earliest_quarter(c);
    then mixture_claim_period_permitted(c);
}
relation vendor_claim_is_kerosene(c: FuelClaim) kind empirical;
relation vendor_claim_amount_payable(c: FuelClaim, amount: Money) kind empirical;
relation vendor_claim_period_permitted(c: FuelClaim) kind institutional { label en official "§6427(i)(4)(A): $200 or more ($100 or more for kerosene) payable for a period of at least one week"; }
rule S6427VendorClaimPeriodPermittedGeneral strict {
    for c: FuelClaim;
    for amount: Money;
    when vendor_claim_amount_payable(c, amount) and not_known(vendor_claim_is_kerosene(c)) and amount >= VendorFuelClaimThreshold and claim_period_at_least_one_week(c) and filed_by_end_of_first_quarter_after_earliest_quarter(c);
    then vendor_claim_period_permitted(c);
}
rule S6427VendorClaimPeriodPermittedKerosene strict {
    for c: FuelClaim;
    for amount: Money;
    when vendor_claim_amount_payable(c, amount) and vendor_claim_is_kerosene(c) and amount >= VendorKeroseneClaimThreshold and claim_period_at_least_one_week(c) and filed_by_end_of_first_quarter_after_earliest_quarter(c);
    then vendor_claim_period_permitted(c);
}
// (i)(3)(B), (i)(4)(A): payment within 45 days (20 days if electronic), else interest at the overpayment rate.
relation fuel_claim_payment_deadline(c: FuelClaim, deadline: Date) kind institutional { label en official "the date by which the Secretary must pay the claim: 45 days after filing (20 days in the case of an electronic claim)"; }
rule S6427PaymentDeadlineFortyFiveDays strict {
    for c: FuelClaim;
    for filed: Date;
    when fuel_claim_filed_on(c, filed) and not_known(claim_is_electronic(c));
    then fuel_claim_payment_deadline(c, add_calendar_period(filed, 45 calendar_day));
}
rule S6427PaymentDeadlineTwentyDaysElectronic strict {
    for c: FuelClaim;
    for filed: Date;
    when fuel_claim_filed_on(c, filed) and claim_is_electronic(c);
    then fuel_claim_payment_deadline(c, add_calendar_period(filed, 20 calendar_day));
}
relation fuel_claim_paid_on(c: FuelClaim, d: Date) kind empirical;
relation claim_under_section_6427(c: FuelClaim) kind institutional {
    label en official "a claim under section 6427 (as opposed to §6420 or §6421)";
}
rule S6427ClaimIsUnderSection6427 strict {
    for c: FuelClaim;
    for b: FuelPaymentBasis;
    when fuel_claim_basis(c, b)
        and (b == FuelUsedOtherThanSold or b == BusFuel or b == FarmFuel or b == MuseumOrHelicopterFuel or b == BlendStockNotUsedForFuel
            or b == NontaxableUseDieselKerosene or b == DieselEmulsion or b == MixtureOrAlternativeFuelPayment);
    then claim_under_section_6427(c);
}
relation late_fuel_claim_interest_runs_from(c: FuelClaim, d: Date) kind institutional { label en official "the claim shall be paid with interest from the payment deadline, using the overpayment rate and method under section 6621"; }
@source(IRC_S6427_I, relation = formalizes, coverage = exact, quote = "if the Secretary has not paid pursuant to a claim filed under this section within 45 days of the date of the filing of such claim (20 days in the case of an electronic claim), the claim shall be paid with interest from such date determined by using the overpayment rate and method under section 6621.")
rule S6427LateClaimBearsInterestFromDeadline strict {
    for c: FuelClaim;
    for deadline: Date;
    for paid: Date;
    when fuel_claim_payment_deadline(c, deadline) and fuel_claim_paid_on(c, paid) and paid > deadline and claim_under_section_6427(c);
    then late_fuel_claim_interest_runs_from(c, deadline);
}

// The payment amount and the duty to pay.
relation fuel_claim_rate_after_reduction(c: FuelClaim, dollars_per_gallon: Decimal) kind institutional { label en official "the rate of tax taken into account for the claim (reduced by 7.4 cents for the bus fuel rate reduction)"; }
rule S6427RateUnreduced defeasible {
    for c: FuelClaim;
    for rate: Decimal;
    when fuel_claim_tax_rate(c, rate) and not_known(bus_fuel_rate_reduction_applies(c)) and not_known(diesel_fuel_used_in_emulsion(c)) and not_known(fuel_claim_rate_carve_out_applies(c));
    then fuel_claim_rate_after_reduction(c, rate);
}
rule S6427RateReducedForBusFuel defeasible {
    for c: FuelClaim;
    for rate: Decimal;
    when fuel_claim_tax_rate(c, rate) and bus_fuel_rate_reduction_applies(c);
    then fuel_claim_rate_after_reduction(c, rate - AutomobileBusFuelRateReduction);
}
@source(IRC_S6427_M, relation = formalizes, coverage = exact, quote = "the excess of the regular tax rate over the incentive tax rate")
rule S6427RateForEmulsionIsRegularLessIncentive strict {
    for c: FuelClaim;
    for regular: Decimal;
    for incentive: Decimal;
    when diesel_fuel_used_in_emulsion(c) and emulsion_regular_tax_rate(c, regular) and emulsion_incentive_tax_rate(c, incentive) and regular > incentive;
    then fuel_claim_rate_after_reduction(c, regular - incentive);
}
pub relation fuel_claim_payable_amount(c: FuelClaim, amount: Money) kind institutional {
    label en official "the amount the Secretary is to pay: gallons multiplied by the rate of tax, less other amounts payable or refundable";
}
@source(IRC_S6420_A, relation = formalizes, coverage = exact, quote = "the number of gallons so used, by")
@source(IRC_S6421_A, relation = formalizes, coverage = exact, quote = "multiplying the number of gallons so used by the rate at which tax was imposed on such gasoline under section 4081")
rule S6420PayableAmountIsGallonsTimesRate defeasible {
    for c: FuelClaim;
    for gallons: Decimal;
    for rate: Decimal;
    for deduction: Money;
    when fuel_claim_eligible(c) and fuel_claim_gallons(c, gallons) and fuel_claim_rate_after_reduction(c, rate) and fuel_claim_deduction_for_other_amounts(c, deduction)
        and not_known(gasoline_exempt_from_4081_tax(c)) and not_known(bus_fuel_unscheduled_seating_shortfall(c));
    then fuel_claim_payable_amount(c, max(0 USD, round(gallons * rate, 2, "HALF_UP") * 1.00 USD - deduction));
}
@source(IRC_S6420_D, relation = formalizes, coverage = exact, quote = "No amount shall be payable under this section with respect to any gasoline which the Secretary determines was exempt from the tax imposed by section 4081.")
rule S6420NoAmountForExemptGasoline strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, FarmGasoline) and gasoline_exempt_from_4081_tax(c);
    then not fuel_claim_eligible(c);
}
relation fuel_claim_paid(c: FuelClaim) kind empirical;
relation fuel_claim_timely(c: FuelClaim) kind institutional {
    label en official "the claim is the person's one annual claim filed in time, or a permitted quarterly, mixture-period or vendor claim";
}
rule S6427TimelyAnnualClaim strict { for c: FuelClaim; when fuel_claim_annual_filing_ok(c); then fuel_claim_timely(c); }
rule S6427TimelyQuarterlyClaim strict { for c: FuelClaim; when quarterly_claim_permitted(c); then fuel_claim_timely(c); }
rule S6427TimelyMixtureClaim strict { for c: FuelClaim; when mixture_claim_period_permitted(c); then fuel_claim_timely(c); }
rule S6427TimelyVendorClaim strict { for c: FuelClaim; when vendor_claim_period_permitted(c); then fuel_claim_timely(c); }
@source(IRC_S6420_A, relation = formalizes, coverage = partial, quote = "the Secretary shall pay (without interest) to the ultimate purchaser of such gasoline the amount determined by multiplying—")
rule S6420DutyToPayFuelClaim defeasible {
    for c: FuelClaim;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for filed: Date;
    when fuel_claim_payable_amount(c, amount) and amount > 0 USD and fuel_claim_by(c, p, y) and fuel_claim_filed_on(c, filed) and fuel_claim_payee_permitted(c) and fuel_claim_timely(c);
    then duty PayFuelClaim {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition fuel_claim_paid(c);
            window [filed, infinity];
        }
    };
}
relation interest_paid_on_fuel_payment(c: FuelClaim) kind empirical { label en official "interest is paid on the payment"; }
@source(IRC_S6420_A, relation = formalizes, coverage = exact, quote = "the Secretary shall pay (without interest)")
rule S6420NoInterestOnFuelPayment defeasible {
    for c: FuelClaim;
    when fuel_claim_payable_amount(c, _) and interest_paid_on_fuel_payment(c);
    then prohibition NoInterestOnFuelPayment {
        bearer Secretary;
        action interest_paid_on_fuel_payment(c);
        window [-infinity, infinity];
    };
    unless late_fuel_claim_interest_runs_from(c, _) and interest_paid_on_fuel_payment(c);
}

// ============================================================================
// §6426 — Credit for alcohol fuel, biodiesel, and alternative fuel mixtures
// ============================================================================

relation fuel_credit_taxpayer(c: FuelClaim, p: Person) kind empirical { label en unofficial "the taxpayer claiming the §6426 credit"; }
relation taxpayer_registered_4101_for_credit(c: FuelClaim) kind empirical { label en official "the taxpayer is registered under section 4101"; }
// (b): alcohol fuel mixture credit.
relation alcohol_gallons_used_in_mixture(c: FuelClaim, gallons: Decimal) kind empirical { label en official "the number of gallons of alcohol used by the taxpayer in producing any alcohol fuel mixture for sale or use in a trade or business of the taxpayer"; }
relation mixture_sold_or_used_as_fuel_by_producer(c: FuelClaim) kind empirical { label en official "the mixture (a) is sold by the taxpayer producing such mixture to any person for use as a fuel, or (b) is used as a fuel by the taxpayer producing such mixture"; }
relation alcohol_is_disqualified_source_or_proof(c: FuelClaim) kind empirical { label en official "alcohol produced from petroleum, natural gas, or coal (including peat), or with a proof of less than 190"; }
relation none_of_the_alcohol_is_ethanol(c: FuelClaim) kind empirical { label en official "none of the alcohol consists of ethanol"; }
relation secretary_40h3B_determination_for_all_preceding_years(c: FuelClaim) kind empirical { label en official "the Secretary makes a determination described in section 40(h)(3)(B) with respect to all preceding calendar years beginning after 2007"; }
relation alcohol_fuel_mixture_qualifies(c: FuelClaim) kind institutional { label en official "an alcohol fuel mixture of alcohol (not disqualified) and taxable fuel, sold or used as a fuel by the producer"; }
rule S6426AlcoholMixtureQualifies strict {
    for c: FuelClaim;
    when mixture_sold_or_used_as_fuel_by_producer(c) and not_known(alcohol_is_disqualified_source_or_proof(c));
    then alcohol_fuel_mixture_qualifies(c);
}
relation alcohol_denaturant_volume(c: FuelClaim, gallons: Decimal) kind empirical { label en official "the volume of any denaturant (including gasoline) added under formulas approved by the Secretary"; }
relation alcohol_volume_including_denaturant(c: FuelClaim, gallons: Decimal) kind institutional { label en official "the volume of alcohol includes denaturant to the extent it does not exceed 2 percent of the volume of such alcohol (including denaturants)"; }
relation alcohol_has_denaturant(c: FuelClaim) kind institutional {
    label en unofficial "helper: a denaturant volume is stated for the alcohol";
}
rule S6426AlcoholHasDenaturant strict {
    for c: FuelClaim;
    for denaturant: Decimal;
    when alcohol_denaturant_volume(c, denaturant);
    then alcohol_has_denaturant(c);
}
rule S6426AlcoholVolumeWithoutDenaturant strict {
    for c: FuelClaim;
    for alcohol: Decimal;
    when alcohol_gallons_used_in_mixture(c, alcohol) and not_known(alcohol_has_denaturant(c));
    then alcohol_volume_including_denaturant(c, alcohol);
}
@source(IRC_S6426_B, relation = formalizes, coverage = exact, quote = "the volume of alcohol shall include the volume of any denaturant (including gasoline) which is added under any formulas approved by the Secretary to the extent that such denaturants do not exceed 2 percent of the volume of such alcohol (including denaturants)")
rule S6426AlcoholVolumeIncludesDenaturantUpToTwoPercent strict {
    for c: FuelClaim;
    for alcohol: Decimal;
    for denaturant: Decimal;
    when alcohol_gallons_used_in_mixture(c, alcohol) and alcohol_denaturant_volume(c, denaturant);
    then alcohol_volume_including_denaturant(c, alcohol + min(denaturant, (alcohol + denaturant) * 0.02));
}
relation alcohol_fuel_mixture_credit(c: FuelClaim, amount: Money) kind institutional { label en official "the alcohol fuel mixture credit: the product of the applicable amount and the gallons of alcohol"; }
@source(IRC_S6426_B, relation = formalizes, coverage = exact, quote = "the alcohol fuel mixture credit is the product of the applicable amount and the number of gallons of alcohol used by the taxpayer in producing any alcohol fuel mixture for sale or use in a trade or business of the taxpayer.")
rule S6426AlcoholMixtureCreditEthanol defeasible {
    effective [@2005-01-01, @2012-01-01);
    for c: FuelClaim;
    for gallons: Decimal;
    when alcohol_fuel_mixture_qualifies(c) and alcohol_volume_including_denaturant(c, gallons) and not_known(none_of_the_alcohol_is_ethanol(c)) and not_known(secretary_40h3B_determination_for_all_preceding_years(c));
    then alcohol_fuel_mixture_credit(c, round(gallons * AlcoholFuelMixtureCreditRate, 2, "HALF_UP"));
}
@source(IRC_S6426_B, relation = formalizes, coverage = exact, quote = "In the case of an alcohol fuel mixture in which none of the alcohol consists of ethanol, the applicable amount is 60 cents.")
rule S6426AlcoholMixtureCreditNonEthanol defeasible {
    effective [@2005-01-01, @2012-01-01);
    for c: FuelClaim;
    for gallons: Decimal;
    when alcohol_fuel_mixture_qualifies(c) and alcohol_volume_including_denaturant(c, gallons) and none_of_the_alcohol_is_ethanol(c);
    then alcohol_fuel_mixture_credit(c, round(gallons * AlcoholFuelMixtureCreditRateNonEthanol, 2, "HALF_UP"));
}
@source(IRC_S6426_B, relation = formalizes, coverage = exact, quote = "subparagraph (A)(ii) shall be applied by substituting \"51 cents\" for \"45 cents\".")
rule S6426AlcoholMixtureCreditSubstitutedRate defeasible {
    effective [@2009-01-01, @2012-01-01);
    for c: FuelClaim;
    for gallons: Decimal;
    when alcohol_fuel_mixture_qualifies(c) and alcohol_volume_including_denaturant(c, gallons) and not_known(none_of_the_alcohol_is_ethanol(c)) and secretary_40h3B_determination_for_all_preceding_years(c);
    then alcohol_fuel_mixture_credit(c, round(gallons * AlcoholFuelMixtureCreditRateSubstituted, 2, "HALF_UP"));
}
// (c): biodiesel mixture credit.
relation biodiesel_gallons_used_in_mixture(c: FuelClaim, gallons: Decimal) kind empirical { label en official "the number of gallons of biodiesel used by the taxpayer in producing any biodiesel mixture for sale or use in a trade or business of the taxpayer"; }
relation biodiesel_mixture_sold_or_used_as_fuel(c: FuelClaim) kind empirical { label en official "the mixture of biodiesel and diesel fuel (determined without regard to any use of kerosene) is sold by the producer for use as a fuel or is used as a fuel by the producer"; }
relation producer_certification_of_biodiesel_obtained(c: FuelClaim) kind empirical { label en official "the taxpayer obtains a certification from the producer of the biodiesel which identifies the product produced and the percentage of biodiesel and agri-biodiesel in the product"; }
relation biodiesel_mixture_credit(c: FuelClaim, amount: Money) kind institutional { label en official "the biodiesel mixture credit: the product of $1.00 and the gallons of biodiesel"; }
@source(IRC_S6426_C, relation = formalizes, coverage = exact, quote = "the biodiesel mixture credit is the product of the applicable amount and the number of gallons of biodiesel used by the taxpayer in producing any biodiesel mixture for sale or use in a trade or business of the taxpayer.")
rule S6426BiodieselMixtureCredit defeasible {
    effective [@2005-01-01, @2025-01-01);
    for c: FuelClaim;
    for gallons: Decimal;
    when biodiesel_gallons_used_in_mixture(c, gallons) and biodiesel_mixture_sold_or_used_as_fuel(c) and producer_certification_of_biodiesel_obtained(c);
    then us.irc.payment_refunds_interest::biodiesel_mixture_credit(c, round(gallons * BiodieselMixtureCreditRate, 2, "HALF_UP"));
}
// (d): alternative fuel credit; (e): alternative fuel mixture credit.
enum AlternativeFuelKind {
    LiquefiedPetroleumGas;
    PSeriesFuel;
    CompressedOrLiquefiedNaturalGas;
    CoalFischerTropschFuel;
    BiomassGas;
    BiomassLiquid;
    Excluded;
    label en official "§6426(d)(2): liquefied petroleum gas; P Series Fuels; compressed or liquefied natural gas; coal-derived Fischer-Tropsch liquid fuel; compressed or liquefied gas derived from biomass; liquid fuel derived from biomass. Excluded: ethanol, methanol, biodiesel, and any fuel derived from paper or pulp production";
}
relation alternative_fuel_kind(c: FuelClaim, k: AlternativeFuelKind) kind empirical;
relation alternative_fuel_gallons(c: FuelClaim, gallons: Decimal) kind empirical { label en official "the number of gallons of an alternative fuel or gasoline gallon equivalents of a nonliquid alternative fuel"; }
relation alternative_fuel_is_nonliquid_btu(c: FuelClaim, btu: Decimal) kind empirical { label en official "the Btu content (higher heating value) of a nonliquid alternative fuel"; }
relation alternative_fuel_sold_or_used_as_fuel(c: FuelClaim) kind empirical { label en official "sold by the taxpayer for use as a fuel in a motor vehicle or motorboat, sold for use as a fuel in aviation, or so used by the taxpayer"; }
relation coal_fuel_sequestration_percentage(c: FuelClaim, percent: Integer) kind empirical { label en official "the percentage of the gasification facility's total carbon dioxide emissions separated and sequestered"; }
relation coal_fuel_produced_on(c: FuelClaim, d: Date) kind empirical;
relation coal_fuel_requirement_met(c: FuelClaim) kind institutional { label en official "(d)(4): the fuel is certified as derived from coal at a facility which separates and sequesters at least 50 percent (fuel produced after 2009-09-30 through 2009-12-30) or 75 percent (fuel produced after 2009-12-30) of its total carbon dioxide emissions"; }
rule S6426CoalFuelRequirement50 strict {
    for c: FuelClaim;
    for d: Date;
    for percent: Integer;
    when coal_fuel_produced_on(c, d) and d > @2009-09-30 and d <= @2009-12-30 and coal_fuel_sequestration_percentage(c, percent) and percent >= 50;
    then coal_fuel_requirement_met(c);
}
rule S6426CoalFuelRequirement75 strict {
    for c: FuelClaim;
    for d: Date;
    for percent: Integer;
    when coal_fuel_produced_on(c, d) and d > @2009-12-30 and coal_fuel_sequestration_percentage(c, percent) and percent >= 75;
    then coal_fuel_requirement_met(c);
}
relation alternative_fuel_qualifies(c: FuelClaim) kind institutional { label en official "the fuel is an alternative fuel within §6426(d)(2), not excluded, and (for the coal-derived fuel) meeting paragraph (4)"; }
rule S6426AlternativeFuelQualifiesLpg strict { for c: FuelClaim; when alternative_fuel_kind(c, LiquefiedPetroleumGas); then alternative_fuel_qualifies(c); }
rule S6426AlternativeFuelQualifiesPSeries strict { for c: FuelClaim; when alternative_fuel_kind(c, PSeriesFuel); then alternative_fuel_qualifies(c); }
rule S6426AlternativeFuelQualifiesNaturalGas strict { for c: FuelClaim; when alternative_fuel_kind(c, CompressedOrLiquefiedNaturalGas); then alternative_fuel_qualifies(c); }
rule S6426AlternativeFuelQualifiesCoal strict { for c: FuelClaim; when alternative_fuel_kind(c, CoalFischerTropschFuel) and coal_fuel_requirement_met(c); then alternative_fuel_qualifies(c); }
rule S6426AlternativeFuelQualifiesBiomassGas strict { for c: FuelClaim; when alternative_fuel_kind(c, BiomassGas); then alternative_fuel_qualifies(c); }
rule S6426AlternativeFuelQualifiesBiomassLiquid strict { for c: FuelClaim; when alternative_fuel_kind(c, BiomassLiquid); then alternative_fuel_qualifies(c); }
relation gasoline_gallon_equivalents(c: FuelClaim, gge: Decimal) kind institutional { label en official "(d)(3) the gasoline gallon equivalent: the amount of nonliquid alternative fuel having a Btu content of 124,800 (higher heating value)"; }
@source(IRC_S6426_D, relation = formalizes, coverage = exact, quote = "the term \"gasoline gallon equivalent\" means, with respect to any nonliquid alternative fuel, the amount of such fuel having a Btu content of 124,800 (higher heating value)")
rule S6426GasolineGallonEquivalent strict {
    for c: FuelClaim;
    for btu: Decimal;
    when alternative_fuel_is_nonliquid_btu(c, btu);
    then gasoline_gallon_equivalents(c, btu / 124800.0);
}
relation alternative_fuel_credit(c: FuelClaim, amount: Money) kind institutional { label en official "the alternative fuel credit: the product of 50 cents and the gallons (or gasoline gallon equivalents) sold or used"; }
@source(IRC_S6426_D, relation = formalizes, coverage = exact, quote = "the alternative fuel credit is the product of 50 cents and the number of gallons of an alternative fuel or gasoline gallon equivalents of a nonliquid alternative fuel sold by the taxpayer for use as a fuel in a motor vehicle or motorboat, sold by the taxpayer for use as a fuel in aviation, or so used by the taxpayer.")
rule S6426AlternativeFuelCredit defeasible {
    effective [@2006-10-01, @2025-01-01);
    for c: FuelClaim;
    for gallons: Decimal;
    when alternative_fuel_qualifies(c) and alternative_fuel_sold_or_used_as_fuel(c) and alternative_fuel_gallons(c, gallons) and taxpayer_registered_4101_for_credit(c);
    then alternative_fuel_credit(c, round(gallons * AlternativeFuelCreditRate, 2, "HALF_UP"));
}
relation alternative_fuel_mixture_credit(c: FuelClaim, amount: Money) kind institutional { label en official "the alternative fuel mixture credit: the product of 50 cents and the gallons of alternative fuel used in producing the mixture"; }
relation alternative_fuel_mixture_produced_for_sale_or_use(c: FuelClaim) kind empirical { label en official "a mixture of alternative fuel (other than LPG, natural gas or biomass gas) and taxable fuel which is sold by the producer for use as fuel or used as a fuel by the producer"; }
@source(IRC_S6426_E, relation = formalizes, coverage = exact, quote = "the alternative fuel mixture credit is the product of 50 cents and the number of gallons of alternative fuel used by the taxpayer in producing any alternative fuel mixture for sale or use in a trade or business of the taxpayer.")
rule S6426AlternativeFuelMixtureCredit defeasible {
    effective [@2006-10-01, @2025-01-01);
    for c: FuelClaim;
    for gallons: Decimal;
    when alternative_fuel_qualifies(c) and alternative_fuel_mixture_produced_for_sale_or_use(c) and alternative_fuel_gallons(c, gallons) and taxpayer_registered_4101_for_credit(c)
        and not_known(alternative_fuel_kind(c, LiquefiedPetroleumGas)) and not_known(alternative_fuel_kind(c, CompressedOrLiquefiedNaturalGas)) and not_known(alternative_fuel_kind(c, BiomassGas));
    then alternative_fuel_mixture_credit(c, round(gallons * AlternativeFuelMixtureCreditRate, 2, "HALF_UP"));
}
// (j): LPG and LNG gallon equivalents.
relation lpg_or_lng_credit_gallons(c: FuelClaim, gallons: Decimal) kind empirical;
// (k): sustainable aviation fuel credit.
relation sustainable_aviation_fuel_gallons_in_qualified_mixture(c: FuelClaim, gallons: Decimal) kind empirical { label en official "the number of gallons of sustainable aviation fuel in a qualified mixture sold or used"; }
relation saf_applicable_supplementary_amount(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "the applicable supplementary amount with respect to such sustainable aviation fuel (section 40B) — dependency contract: `credits`"; }
relation saf_gallon_has_45Z_credit_allowable(c: FuelClaim) kind empirical { label en official "a credit under section 45Z is allowable for the gallon (determined without regard to section 45Z(a)(1)(A))"; }
relation sustainable_aviation_fuel_credit(c: FuelClaim, amount: Money) kind institutional { label en official "the sustainable aviation fuel credit: gallons multiplied by $1.25 plus the applicable supplementary amount"; }
@source(IRC_S6426_K, relation = formalizes, coverage = partial, quote = "the sustainable aviation fuel credit for the taxable year is, with respect to any sale or use of a qualified mixture, an amount equal to the product of—")
@source(us.irc.temporal::PL119_21_S70521, quote = "This subsection shall not apply to any sale or use for any period after September 30, 2025.")
rule S6426SustainableAviationFuelCredit defeasible {
    effective [@2023-01-01, @2025-10-01);
    for c: FuelClaim;
    for gallons: Decimal;
    for supplementary: Decimal;
    when sustainable_aviation_fuel_gallons_in_qualified_mixture(c, gallons) and saf_applicable_supplementary_amount(c, supplementary);
    then us.irc.payment_refunds_interest::sustainable_aviation_fuel_credit(c, round(gallons * (SustainableAviationFuelCreditBase + supplementary * 1.00 USD), 2, "HALF_UP"));
    unless saf_gallon_has_45Z_credit_allowable(c) and sustainable_aviation_fuel_gallons_in_qualified_mixture(c, gallons) and saf_applicable_supplementary_amount(c, supplementary);
}
// (h), (i): no double credit; no credit for fuel produced and used outside the US.
relation fuel_credit_also_available_under_b_c_or_40_40A_40B(c: FuelClaim) kind empirical { label en official "credit may be determined under subsection (b) or (c) or under section 40, 40A, or 40B for the same fuel"; }
relation fuel_produced_outside_united_states_for_use_outside(c: FuelClaim) kind empirical { label en official "alcohol, biodiesel or alternative fuel produced outside the United States (including possessions) for use as a fuel outside the United States"; }
relation no_credit_for_alternative_fuel_double_benefit(c: FuelClaim) kind institutional { label en official "§6426(h): no credit determined under (d) or (e) for fuel for which credit may be determined under (b), (c) or under section 40, 40A, or 40B"; }
rule S6426NoDoubleBenefitForAlternativeFuel strict {
    for c: FuelClaim;
    when fuel_credit_also_available_under_b_c_or_40_40A_40B(c);
    then no_credit_for_alternative_fuel_double_benefit(c);
}
relation fuel_credit_denied_produced_abroad(c: FuelClaim) kind institutional { label en official "§6426(i): no credit for fuel produced outside the United States for use as a fuel outside the United States"; }
rule S6426NoCreditForFuelProducedAndUsedAbroad strict {
    for c: FuelClaim;
    when fuel_produced_outside_united_states_for_use_outside(c);
    then fuel_credit_denied_produced_abroad(c);
}
// (a): the credit is allowed against the §4081 tax (b),(c),(e),(k) and the
// §4041 tax (d); (d) and (e) need registration under §4101.
relation fuel_credit_allowed_against_4081_tax(c: FuelClaim, amount: Money) kind institutional { label en official "credit allowed against the tax imposed by section 4081: the sum of the credits described in (b), (c), (e), and (k)"; }
rule S6426CreditAgainst4081Alcohol defeasible { for c: FuelClaim; for amount: Money; when alcohol_fuel_mixture_credit(c, amount) and not_known(fuel_credit_denied_produced_abroad(c)); then fuel_credit_allowed_against_4081_tax(c, amount); }
rule S6426CreditAgainst4081Biodiesel defeasible { for c: FuelClaim; for amount: Money; when us.irc.payment_refunds_interest::biodiesel_mixture_credit(c, amount) and not_known(fuel_credit_denied_produced_abroad(c)); then fuel_credit_allowed_against_4081_tax(c, amount); }
rule S6426CreditAgainst4081AlternativeMixture defeasible { for c: FuelClaim; for amount: Money; when alternative_fuel_mixture_credit(c, amount) and taxpayer_registered_4101_for_credit(c) and not_known(fuel_credit_denied_produced_abroad(c)) and not_known(no_credit_for_alternative_fuel_double_benefit(c)); then fuel_credit_allowed_against_4081_tax(c, amount); }
rule S6426CreditAgainst4081Saf defeasible { for c: FuelClaim; for amount: Money; when us.irc.payment_refunds_interest::sustainable_aviation_fuel_credit(c, amount); then fuel_credit_allowed_against_4081_tax(c, amount); }
relation fuel_credit_allowed_against_4041_tax(c: FuelClaim, amount: Money) kind institutional { label en official "credit allowed against the tax imposed by section 4041: the credit described in (d)"; }
rule S6426CreditAgainst4041AlternativeFuel defeasible { for c: FuelClaim; for amount: Money; when alternative_fuel_credit(c, amount) and taxpayer_registered_4101_for_credit(c) and not_known(fuel_credit_denied_produced_abroad(c)) and not_known(no_credit_for_alternative_fuel_double_benefit(c)); then fuel_credit_allowed_against_4041_tax(c, amount); }
// (f): tax imposed on separating the alcohol/biodiesel or using the mixture other than as fuel.
relation credit_mixture_separated_or_used_other_than_as_fuel(c: FuelClaim, person: Person) kind empirical { label en official "any person separates the alcohol or biodiesel from the mixture, or without separation uses the mixture other than as a fuel"; }
relation separated_gallons_of_credited_alcohol_or_biodiesel(c: FuelClaim, gallons: Decimal) kind empirical;
relation tax_on_separation_or_nonfuel_use(c: FuelClaim, person: Person, amount: Money) kind institutional { label en official "a tax equal to the product of the applicable amount and the number of gallons of such alcohol or biodiesel"; }
@source(IRC_S6426_F, relation = formalizes, coverage = partial, quote = "then there is hereby imposed on such person a tax equal to the product of the applicable amount and the number of gallons of such alcohol or biodiesel.")
rule S6426TaxOnSeparationOfCreditedAlcohol defeasible {
    for c: FuelClaim;
    for person: Person;
    for gallons: Decimal;
    for credit: Money;
    when credit_mixture_separated_or_used_other_than_as_fuel(c, person) and separated_gallons_of_credited_alcohol_or_biodiesel(c, gallons) and alcohol_fuel_mixture_credit(c, credit) and alcohol_gallons_used_in_mixture(c, _);
    then tax_on_separation_or_nonfuel_use(c, person, round(gallons * AlcoholFuelMixtureCreditRate, 2, "HALF_UP"));
}
relation biodiesel_separated_gallons(c: FuelClaim, gallons: Decimal) kind empirical {
    label en official "the number of gallons of biodiesel separated from the mixture, or used other than as a fuel";
}
@source(IRC_S6426_F, relation = formalizes, coverage = partial, quote = "there is hereby imposed on such person a tax equal to the product of the applicable amount and the number of gallons of such alcohol or biodiesel")
rule S6426TaxOnSeparationOfCreditedBiodiesel defeasible {
    for c: FuelClaim;
    for person: Person;
    for gallons: Decimal;
    when credit_mixture_separated_or_used_other_than_as_fuel(c, person) and biodiesel_separated_gallons(c, gallons) and us.irc.payment_refunds_interest::biodiesel_mixture_credit(c, _);
    then tax_on_separation_or_nonfuel_use(c, person, round(gallons * BiodieselMixtureCreditRate, 2, "HALF_UP"));
}
relation separation_tax_treated_as_section_4081_tax(c: FuelClaim, person: Person) kind institutional {
    label en official "all provisions of law, including penalties, apply to the §6426(f)(1) tax as if it were imposed by section 4081 and not by this section";
}
@source(IRC_S6426_F, relation = formalizes, coverage = exact, quote = "as if such tax were imposed by section 4081 and not by this section")
rule S6426SeparationTaxTreatedAs4081Tax defeasible {
    for c: FuelClaim;
    for person: Person;
    for amount: Money;
    when tax_on_separation_or_nonfuel_use(c, person, amount);
    then separation_tax_treated_as_section_4081_tax(c, person);
}
