// Payment, refunds, interest -- WIRE-10 group C, owner of sections 6420, 6421 and 6427 (26.09.2026, DECISION-0379,
// implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 34(a) allows as a credit "the sum of the amounts payable to the taxpayer" under section 6420, 6421 and 6427 (each determined
// without regard to the income-tax-credit-in-lieu subsection: 6420(g), 6421(i), 6427(k)). `us.irc.credits` (section 34) holds the three
// amounts as placeholders (`amount_payable_under_6420_34`, `..._6421_34`, `..._6427_34`); this package (module 10) computes the amount
// payable for every claim (`fuel_claim_payable_amount`: gallons x rate less other amounts payable or refundable) without the payee
// restriction (that restriction is the separate `fuel_claim_payee_permitted`, read by the duty to pay only). This package imports
// `credits`, so the consumer -> owner import would be a cycle: the owner derives the consumer's `pub` placeholders (owner-derives-stub).
//
// JUDGMENT CALLS AND GAPS
//  - The three amounts are defined as the sum over the taxpayer's claims for the taxable year (`fuel_claim_by`) grouped by the payment
//    basis (`FuelPaymentBasis`): section 6420 = FarmGasoline; section 6421 = OffHighwayGasoline, AircraftGasoline, BusGasoline,
//    ExemptPurposeGasoline; section 6427 = the eight remaining bases (the same set as `claim_under_section_6427`).
//  - A taxpayer with no claim of the group gets NO derived amount (no zero is invented); the case-fact channel of the placeholder
//    stays valid.
//  - `fuel_claim_payable_amount` is defeasible, so the deriving rules are defeasible too (LDC-E4103).

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    FuelClaim,
    FuelPaymentBasis,
    Person,
    TaxableYear,
    claim_under_section_6427,
    fuel_claim_basis,
    fuel_claim_by,
    fuel_claim_payable_amount,
};

rule W10CAmountPayableUnder6420ForSection34 defeasible {
    label en official "section 34(a)(1): the amount payable to the taxpayer under section 6420 for the taxable year is the sum of the amounts payable on the taxpayer's farm-gasoline claims for that year";
    for p: Person;
    for y: TaxableYear;
    for c0: FuelClaim;
    when fuel_claim_by(c0, p, y) and fuel_claim_basis(c0, FarmGasoline);
    then us.irc.credits::amount_payable_under_6420_34(p, y,
        sum(collect all amt: Money, c: FuelClaim where fuel_claim_by(c, p, y) and fuel_claim_basis(c, FarmGasoline) and fuel_claim_payable_amount(c, amt), empty: 0 USD));
}

relation claim_under_section_6421(c: FuelClaim) kind institutional {
    label en official "a claim under section 6421 (as opposed to section 6420 or 6427): the payment of the tax on gasoline used for certain nonhighway purposes";
}
rule W10CClaimUnder6421OffHighway strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, OffHighwayGasoline);
    then claim_under_section_6421(c);
}
rule W10CClaimUnder6421Aircraft strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, AircraftGasoline);
    then claim_under_section_6421(c);
}
rule W10CClaimUnder6421Bus strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, BusGasoline);
    then claim_under_section_6421(c);
}
rule W10CClaimUnder6421ExemptPurpose strict {
    for c: FuelClaim;
    when fuel_claim_basis(c, ExemptPurposeGasoline);
    then claim_under_section_6421(c);
}

rule W10CAmountPayableUnder6421ForSection34 defeasible {
    label en official "section 34(a)(2): the amount payable to the taxpayer under section 6421 for the taxable year is the sum of the amounts payable on the taxpayer's section 6421 claims for that year";
    for p: Person;
    for y: TaxableYear;
    for c0: FuelClaim;
    when fuel_claim_by(c0, p, y) and claim_under_section_6421(c0);
    then us.irc.credits::amount_payable_under_6421_34(p, y,
        sum(collect all amt: Money, c: FuelClaim where fuel_claim_by(c, p, y) and claim_under_section_6421(c) and fuel_claim_payable_amount(c, amt), empty: 0 USD));
}

rule W10CAmountPayableUnder6427ForSection34 defeasible {
    label en official "section 34(a)(3): the amount payable to the taxpayer under section 6427 for the taxable year is the sum of the amounts payable on the taxpayer's section 6427 claims for that year";
    for p: Person;
    for y: TaxableYear;
    for c0: FuelClaim;
    when fuel_claim_by(c0, p, y) and claim_under_section_6427(c0);
    then us.irc.credits::amount_payable_under_6427_34(p, y,
        sum(collect all amt: Money, c: FuelClaim where fuel_claim_by(c, p, y) and claim_under_section_6427(c) and fuel_claim_payable_amount(c, amt), empty: 0 USD));
}
