// Stage 3 (26.09.2026) — §6164 (extension of time for payment of taxes by
// corporations expecting carrybacks) and §6167 (extension of time for payment
// of tax attributable to recovery of foreign expropriation losses).
//
// Stage 1 (02-installments-and-extensions.law) modelled only the section-level
// power of each section; here the statement (§6164(b)), the extended amount
// (c), the period (d), revised statements (e), terminations (f), (g), (h) and
// the installments, deficiency proration, interest, acceleration and failure to
// pay of §6167 are added. The stage-1 relations are kept; nothing is copied.
//
// JUDGMENT CALLS
//  - §6164(d)(1) "the last day of the month in which falls the last date
//    prescribed by law for filing the return": the month end is an asserted
//    fact (`last_day_of_month_containing`, TECH-GAPS G2622), as in §6411.
//  - §6167(a): the installments are due on the 15th day of the fourth month of
//    each taxable year following the year of the recovery; the year following
//    is taken as 12 months after the year end (a corporation with a short year
//    in between is not modelled).
//  - §6167(c): "such excess" is read cumulatively: the money received on
//    the recovery and on all sales up to and including this one (each net of
//    the chapter 1 tax on the sale) less the money that may be received under
//    (a)(2), capped at the tax attributable to the recovery. An earlier
//    acceleration is not netted against a later one (INTERPRETATION).
//  - "believes ... in jeopardy" (§6164(h)) and "clearly ... erroneous or
//    unreasonable" (§6164(f)) are evaluative (DECISION-0194): external judgment
//    relations, authority Secretary.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6164_A,
    IRC_S6164_B,
    IRC_S6164_C,
    IRC_S6164_D,
    IRC_S6164_E,
    IRC_S6164_F,
    IRC_S6164_G,
    IRC_S6164_H,
    IRC_S6167_A,
    IRC_S6167_B,
    IRC_S6167_C,
    IRC_S6167_D,
    IRC_S6167_E,
    IRC_S6167_F,
    IRC_S6167_G,
    Notice,
    PaymentExtensionRequest,
    Person,
    Secretary,
    TaxableYear,
    extension_from_date,
    extension_until_date,
    foreign_expropriation_loss_recovery,
    last_day_of_month_containing,
    s6167_eligible,
    s6167_installment_election_made,
    s6167_ten_installments_granted,
};

// ============================================================================
// §6164 corporations expecting carrybacks
// ============================================================================

entity NolStatement6164 { label en unofficial "a statement filed by a corporation with respect to an expected net operating loss carryback (section 6164(b))"; }
relation nol_statement_of(st: NolStatement6164, p: Person, loss_year: TaxableYear) kind empirical { label en official "the corporation that files the statement, and the taxable year of the expected net operating loss"; }
relation nol_statement_filed_on(st: NolStatement6164, d: Date) kind empirical;
relation nol_statement_estimated_loss(st: NolStatement6164, amount: Money) kind empirical { label en official "(b)(1) the estimated amount of the expected net operating loss"; }
relation nol_statement_reasons_stated(st: NolStatement6164) kind empirical { label en official "(b)(2) the reasons, facts, and circumstances which cause the corporation to expect such net operating loss"; }
relation nol_statement_tax_reduction(st: NolStatement6164, amount: Money) kind empirical { label en official "(b)(3) the amount of the reduction of the tax previously determined attributable to the expected carryback, ascertained under section 1314(a)"; }
relation nol_statement_tax_and_part(st: NolStatement6164, amount: Money) kind empirical { label en official "(b)(4) the tax the time for payment of which is to be extended"; }
relation nol_statement_other_information(st: NolStatement6164) kind empirical { label en official "(b)(5) such other information as may be required by regulations"; }
relation nol_statement_states_carryback_expectation(st: NolStatement6164) kind empirical { label en official "the statement sets forth that the corporation expects to have a net operating loss carryback, as provided in section 172(b), from the year in which the statement is made"; }
relation nol_statement_in_regulation_form(st: NolStatement6164) kind empirical { label en official "the statement is filed at such time and in such manner and form as the regulations prescribe"; }
relation nol_statement_complete(st: NolStatement6164) kind institutional { label en official "the statement sets forth the expected carryback and each of the items (b)(1)-(5), in the prescribed form"; }
@source(IRC_S6164_B, relation = formalizes, coverage = partial, quote = "Such statement shall set forth that the corporation expects to have a net operating loss carryback, as provided in section 172(b)")
rule S6164BStatementComplete strict {
    for st: NolStatement6164;
    for a1: Money;
    for a3: Money;
    for a4: Money;
    when nol_statement_states_carryback_expectation(st) and nol_statement_estimated_loss(st, a1) and nol_statement_reasons_stated(st) and nol_statement_tax_reduction(st, a3) and nol_statement_tax_and_part(st, a4) and nol_statement_other_information(st) and nol_statement_in_regulation_form(st);
    then nol_statement_complete(st);
}
relation nol_receipt_requested(st: NolStatement6164) kind empirical { label en official "the corporation requests a receipt for the statement filed"; }
relation nol_receipt_furnished(st: NolStatement6164) kind empirical { label en official "the Secretary furnished a receipt setting forth the date of the filing"; }
@source(IRC_S6164_B, relation = formalizes, coverage = exact, quote = "The Secretary shall, upon request, furnish a receipt for any statement filed, which shall set forth the date of such filing.")
rule S6164BDutyFurnishReceipt strict {
    for st: NolStatement6164;
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    when nol_receipt_requested(st) and nol_statement_of(st, p, y) and nol_statement_filed_on(st, filed);
    then duty FurnishNolStatementReceipt {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition nol_receipt_furnished(st);
            window [filed, infinity];
        }
    };
}

// (c) The amount that may be extended.
relation nol_prior_year_tax_shown(st: NolStatement6164, amount: Money) kind empirical { label en official "the amount of the subtitle A tax for the immediately preceding taxable year shown on the return"; }
relation nol_assessed_item(st: NolStatement6164, item: Text, amount: Money, demand_on: Date) kind empirical { label en official "an amount assessed as a deficiency (or as interest or addition to the tax) prior to the date of filing the statement, with the date of the notice and demand for its payment"; }
relation nol_amount_paid_before_filing(st: NolStatement6164, amount: Money) kind empirical { label en official "the amount paid prior to the date of filing the statement"; }
relation nol_shown_amount_required_before_filing(st: NolStatement6164, amount: Money) kind empirical { label en official "the amount shown on the return that is required to be paid prior to the date of filing (an amount is required to be paid only if shown on the return or assessed)"; }
relation nol_assessed_item_required_before_filing(st: NolStatement6164, item: Text, amount: Money) kind institutional { label en official "an assessed item is considered required to be paid prior to the date of filing if the 10th day after notice and demand occurs prior to that date"; }
@source(IRC_S6164_C, relation = formalizes, coverage = partial, quote = "if the 10th day after notice and demand for its payment occurs prior to such date")
rule S6164CAssessedItemRequired strict {
    for st: NolStatement6164;
    for item: Text;
    for amount: Money;
    for demand: Date;
    for filed: Date;
    when nol_assessed_item(st, item, amount, demand) and nol_statement_filed_on(st, filed) and add_calendar_period(demand, 10 calendar_day) < filed;
    then nol_assessed_item_required_before_filing(st, item, amount);
}
relation nol_assessed_items_total(st: NolStatement6164, amount: Money) kind institutional { label en unofficial "the total of the assessed items (helper: the sum is defined only when an item exists)"; }
rule S6164CAssessedTotal strict {
    for st: NolStatement6164;
    for i0: Text;
    for a0: Money;
    for d0: Date;
    when nol_assessed_item(st, i0, a0, d0);
    then nol_assessed_items_total(st, sum all a: Money for item: Text, d: Date where nol_assessed_item(st, item, a, d));
}
relation nol_assessed_items_present(st: NolStatement6164) kind institutional { label en unofficial "helper: an assessed item is stated"; }
rule S6164CAssessedPresent strict { for st: NolStatement6164; for i0: Text; for a0: Money; for d0: Date; when nol_assessed_item(st, i0, a0, d0); then nol_assessed_items_present(st); }
relation nol_assessed_required_total(st: NolStatement6164, amount: Money) kind institutional { label en unofficial "the total of the assessed items required to be paid before filing (zero when there is none)"; }
rule S6164CAssessedRequiredTotal strict {
    for st: NolStatement6164;
    for i0: Text;
    for a0: Money;
    when nol_assessed_item_required_before_filing(st, i0, a0);
    then nol_assessed_required_total(st, sum all a: Money for item: Text where nol_assessed_item_required_before_filing(st, item, a));
}
rule S6164CAssessedRequiredNone strict {
    for st: NolStatement6164;
    for a0: Money;
    when nol_prior_year_tax_shown(st, a0) and not_known(nol_assessed_required_present(st));
    then nol_assessed_required_total(st, 0 USD);
}
relation nol_assessed_required_present(st: NolStatement6164) kind institutional { label en unofficial "helper: an assessed item is required before filing"; }
rule S6164CAssessedRequiredPresent strict { for st: NolStatement6164; for i0: Text; for a0: Money; when nol_assessed_item_required_before_filing(st, i0, a0); then nol_assessed_required_present(st); }
rule S6164CAssessedTotalNone strict {
    for st: NolStatement6164;
    for a0: Money;
    when nol_prior_year_tax_shown(st, a0) and not_known(nol_assessed_items_present(st));
    then nol_assessed_items_total(st, 0 USD);
}
relation nol_extension_ceiling_from_return(st: NolStatement6164, amount: Money) kind institutional { label en official "the tax shown on the return, increased by amounts assessed before filing, decreased by amounts paid or required to be paid before filing"; }
@source(IRC_S6164_C, relation = formalizes, coverage = partial, quote = "shall not exceed the amount of such tax shown on the return, increased by any amount assessed as a deficiency (or as interest or addition to the tax) prior to the date of filing the statement and decreased by any amount paid or required to be paid prior to the date of such filing")
rule S6164CCeilingFromReturn strict {
    for st: NolStatement6164;
    for shown: Money;
    for assessed: Money;
    for paid: Money;
    for shown_required: Money;
    for assessed_required: Money;
    when nol_prior_year_tax_shown(st, shown) and nol_assessed_items_total(st, assessed) and nol_amount_paid_before_filing(st, paid) and nol_shown_amount_required_before_filing(st, shown_required) and nol_assessed_required_total(st, assessed_required);
    then nol_extension_ceiling_from_return(st, max(0 USD, shown + assessed - paid - shown_required - assessed_required));
}
relation nol_extension_amount(st: NolStatement6164, amount: Money) kind institutional { label en official "the amount the time for payment of which is extended: the part stated under (b)(4), not exceeding the ceiling of (c) and the reduction stated under (b)(3)"; }
@source(IRC_S6164_C, relation = formalizes, coverage = partial, quote = "and the total amount of the tax the time for payment of which may be extended shall not exceed the amount stated under subsection (b)(3)")
rule S6164CExtensionAmount strict {
    for st: NolStatement6164;
    for stated: Money;
    for reduction: Money;
    for ceiling: Money;
    when nol_statement_complete(st) and nol_statement_tax_and_part(st, stated) and nol_statement_tax_reduction(st, reduction) and nol_extension_ceiling_from_return(st, ceiling);
    then nol_extension_amount(st, min(stated, min(reduction, ceiling)));
}
relation nol_extension_in_effect(st: NolStatement6164, p: Person, y: TaxableYear) kind institutional { label en official "the time for payment of the subtitle A tax of the preceding year is extended, to the extent and subject to the conditions of the section"; }
@source(IRC_S6164_A, relation = formalizes, coverage = partial, quote = "the time for payment of all or part of any tax imposed by subtitle A for the taxable year immediately preceding such taxable year shall be extended")
rule S6164AExtensionInEffect strict {
    for st: NolStatement6164;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when nol_statement_of(st, p, y) and nol_extension_amount(st, amount) and amount > 0 USD;
    then nol_extension_in_effect(st, p, y);
}
relation nol_remainder_due_when_payment_would_have_been_required(st: NolStatement6164) kind institutional { label en official "if the extension relates only to part of the tax, the time for payment of the remainder is the date on which payment would have been required had the remainder been the tax"; }
@source(IRC_S6164_C, relation = formalizes, coverage = partial, quote = "the time for payment of the remainder shall be the date on which payment would have been required if such remainder had been the tax")
rule S6164CRemainder strict {
    for st: NolStatement6164;
    for stated: Money;
    for shown: Money;
    when nol_statement_tax_and_part(st, stated) and nol_prior_year_tax_shown(st, shown) and stated < shown;
    then nol_remainder_due_when_payment_would_have_been_required(st);
}

// (d) Period of extension.
relation nol_return_last_date(st: NolStatement6164, d: Date) kind empirical { label en official "the last date prescribed by law (including any extension) for filing the return for the taxable year of the expected net operating loss"; }
relation tentative_carryback_application_filed_on(st: NolStatement6164, d: Date) kind empirical { label en official "an application for tentative carryback adjustment under section 6411 with respect to the loss is filed"; }
relation tentative_carryback_notice_mailed_on(st: NolStatement6164, d: Date) kind empirical { label en official "notice mailed by certified or registered mail that the application is allowed or disallowed in whole or in part"; }
relation nol_extension_period1_end(st: NolStatement6164, d: Date) kind institutional { label en official "the last day of the month in which falls the last date prescribed for filing the return"; }
@source(IRC_S6164_D, relation = formalizes, coverage = partial, quote = "on the last day of the month in which falls the last date prescribed by law (including any extension of time granted the taxpayer) for the filing of the return for the taxable year of the expected net operating loss")
rule S6164DPeriodOneEnd strict {
    for st: NolStatement6164;
    for last: Date;
    for month_end: Date;
    when nol_return_last_date(st, last) and last_day_of_month_containing(last, month_end);
    then nol_extension_period1_end(st, month_end);
}
relation application_filed_within_period1(st: NolStatement6164) kind institutional { label en unofficial "helper: the section 6411 application is filed before the expiration of the period of (d)(1)"; }
rule S6164DApplicationWithin strict {
    for st: NolStatement6164;
    for filed: Date;
    for end: Date;
    when tentative_carryback_application_filed_on(st, filed) and nol_extension_period1_end(st, end) and filed <= end;
    then application_filed_within_period1(st);
}
relation nol_extension_expires_on(st: NolStatement6164, d: Date) kind institutional { label en official "the date the extension expires"; }
rule S6164DExpiresAtMonthEnd strict {
    for st: NolStatement6164;
    for end: Date;
    when nol_extension_period1_end(st, end) and not_known(application_filed_within_period1(st));
    then nol_extension_expires_on(st, end);
}
@source(IRC_S6164_D, relation = formalizes, coverage = partial, quote = "on the date on which notice is mailed by certified mail or registered mail by the Secretary to the taxpayer that such application is allowed or disallowed in whole or in part")
rule S6164DExpiresOnNotice strict {
    for st: NolStatement6164;
    for mailed: Date;
    when application_filed_within_period1(st) and tentative_carryback_notice_mailed_on(st, mailed);
    then nol_extension_expires_on(st, mailed);
}

// (e) Revised statements.
relation supersedes_statement(new_st: NolStatement6164, old_st: NolStatement6164) kind empirical { label en official "each statement with respect to the year is in lieu of the last statement previously filed with respect to that year"; }
relation nol_extension_terminated_amount(new_st: NolStatement6164, amount: Money) kind institutional { label en official "if the amount extended under the new statement is less than under the last statement, the extension is terminated as to the difference"; }
@source(IRC_S6164_E, relation = formalizes, coverage = exact, quote = "If the amount the time for payment of which is extended under a statement filed is less than the amount under the last statement previously filed, the extension of time shall be terminated as to the difference between the two amounts.")
rule S6164ERevisedLess strict {
    for new_st: NolStatement6164;
    for old_st: NolStatement6164;
    for a_new: Money;
    for a_old: Money;
    when supersedes_statement(new_st, old_st) and nol_extension_amount(new_st, a_new) and nol_extension_amount(old_st, a_old) and a_new < a_old;
    then nol_extension_terminated_amount(new_st, a_old - a_new);
}

// (f) Termination on examination; (h) jeopardy.
pub external judgment relation nol_statement_clearly_erroneous_or_unreasonable(st: NolStatement6164) {
    authority Secretary;
    label en official "upon examination, the Secretary believes that, as of the time of the examination, all or any part of the statement clearly is in a material respect erroneous or unreasonable (section 6164(f))";
}
relation nol_statement_examined(st: NolStatement6164) kind empirical { label en official "the Secretary made an examination of the statement (he is not required to make any)"; }
relation nol_extension_terminated_on_examination(st: NolStatement6164) kind empirical { label en official "the Secretary terminated the extension as to the part concerned"; }
@source(IRC_S6164_F, relation = formalizes, coverage = exact, quote = "The Secretary shall terminate the extension as to any part of the amount to which it relates which he deems should be terminated")
rule S6164FDutyTerminate strict {
    for st: NolStatement6164;
    for p: Person;
    for y: TaxableYear;
    when nol_statement_examined(st) and nol_statement_clearly_erroneous_or_unreasonable(st) and nol_statement_of(st, p, y);
    then duty TerminateNolExtensionOnExamination {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition nol_extension_terminated_on_examination(st);
            window [-infinity, infinity];
        }
    };
}
pub external judgment relation nol_collection_in_jeopardy(st: NolStatement6164) {
    authority Secretary;
    label en official "the Secretary believes that collection of the amount to which the extension relates is in jeopardy (section 6164(h))";
}
relation nol_extension_terminated_for_jeopardy(st: NolStatement6164) kind empirical { label en official "the Secretary immediately terminated the extension"; }
relation nol_notice_and_demand_after_jeopardy(st: NolStatement6164) kind empirical { label en official "the Secretary made notice and demand for payment of the amount"; }
@source(IRC_S6164_H, relation = formalizes, coverage = exact, quote = "he shall immediately terminate such extension, and notice and demand shall be made by him for payment of such amount")
rule S6164HDutyTerminateOnJeopardy strict {
    for st: NolStatement6164;
    for p: Person;
    for y: TaxableYear;
    when nol_collection_in_jeopardy(st) and nol_statement_of(st, p, y);
    then duty TerminateNolExtensionForJeopardy {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition nol_extension_terminated_for_jeopardy(st);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S6164_H, relation = formalizes, coverage = exact, quote = "and notice and demand shall be made by him for payment of such amount")
rule S6164HDutyNoticeAndDemand strict {
    for st: NolStatement6164;
    for p: Person;
    for y: TaxableYear;
    when nol_collection_in_jeopardy(st) and nol_statement_of(st, p, y);
    then duty MakeNoticeAndDemandAfterNolJeopardy {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition nol_notice_and_demand_after_jeopardy(st);
            window [-infinity, infinity];
        }
    };
}
// (g) Payments on termination.
relation nol_extension_terminated(st: NolStatement6164) kind institutional { label en official "the extension is terminated under subsection (e) or (f) as to some amount"; }
rule S6164GTerminatedByE strict { for st: NolStatement6164; for a: Money; when nol_extension_terminated_amount(st, a); then nol_extension_terminated(st); }
rule S6164GTerminatedByF strict { for st: NolStatement6164; when nol_extension_terminated_on_examination(st); then nol_extension_terminated(st); }
relation no_further_nol_extension_for_amount(st: NolStatement6164) kind institutional { label en official "no further extension of time shall be made under the section with respect to a terminated amount"; }
@source(IRC_S6164_G, relation = formalizes, coverage = exact, quote = "no further extension of time shall be made under this section with respect to such amount")
rule S6164GNoFurtherExtension strict { for st: NolStatement6164; when nol_extension_terminated(st); then no_further_nol_extension_for_amount(st); }
relation nol_terminated_amount_due_date(st: NolStatement6164, d: Date) kind institutional { label en official "the time for payment of the terminated amount is the date on which payment would have been required if there had been no extension"; }
@source(IRC_S6164_G, relation = formalizes, coverage = exact, quote = "the time for payment of such amount shall be considered to be the date on which payment would have been required if there had been no extension with respect to such amount")
rule S6164GDueDateWithoutExtension strict {
    for st: NolStatement6164;
    for p: Person;
    for y: TaxableYear;
    for last: Date;
    when nol_extension_terminated(st) and nol_statement_of(st, p, y) and nol_prior_year_payment_date_without_extension(st, last);
    then nol_terminated_amount_due_date(st, last);
}
relation nol_prior_year_payment_date_without_extension(st: NolStatement6164, d: Date) kind empirical { label en official "the date on which payment of the preceding year's tax would have been required had there been no extension"; }
// (i): consolidated returns are left to regulations (coverage row).

// ============================================================================
// §6167 foreign expropriation loss recovery
// ============================================================================

relation recovery_amount_1351c(p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the amount of the recovery of the foreign expropriation loss (as defined in section 1351(c))"; }
relation recovery_money_received(p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the portion of the recovery received in money"; }
relation additional_tax_1351d1(p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the additional tax imposed by section 1351(d)(1) on the recovery"; }
relation tax_increase_from_1351e_gain(p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the amount by which the tax imposed under subtitle A is increased by reason of the gain on the recovery which under section 1351(e) is considered as gain on the involuntary conversion of property"; }
relation tax_attributable_to_recovery(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the tax attributable to a recovery of a foreign expropriation loss: the sum of the section 1351(d)(1) additional tax and the increase in tax by reason of the section 1351(e) gain"; }
@source(IRC_S6167_F, relation = formalizes, coverage = exact, quote = "the tax attributable to a recovery of a foreign expropriation loss is the sum of—")
rule S6167FTaxAttributable strict {
    for p: Person;
    for y: TaxableYear;
    for a1: Money;
    for a2: Money;
    when additional_tax_1351d1(p, y, a1) and tax_increase_from_1351e_gain(p, y, a2);
    then tax_attributable_to_recovery(p, y, a1 + a2);
}
relation recovery_money_portion_within_limits(p: Person, y: TaxableYear) kind institutional { label en official "the portion of the recovery received in money is less than 25 percent of the amount of the recovery and is not greater than the tax attributable to it"; }
@source(IRC_S6167_A, relation = formalizes, coverage = exact, quote = "the portion of the recovery received in money is less than 25 percent of the amount of such recovery (as defined in section 1351(c)) and is not greater than the tax attributable to such recovery")
rule S6167AMoneyPortion strict {
    for p: Person;
    for y: TaxableYear;
    for money: Money;
    for total: Money;
    for tax: Money;
    when recovery_money_received(p, y, money) and recovery_amount_1351c(p, y, total) and tax_attributable_to_recovery(p, y, tax) and money < total * 0.25 and money <= tax;
    then recovery_money_portion_within_limits(p, y);
}
rule S6167EligibleFromAmounts strict {
    for p: Person;
    for y: TaxableYear;
    when foreign_expropriation_loss_recovery(p, y) and recovery_money_portion_within_limits(p, y);
    then s6167_eligible(p, y);
}
relation s6167_installment_amount(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "each of the 10 equal installments of the tax attributable to the recovery"; }
@source(IRC_S6167_A, relation = formalizes, coverage = partial, quote = "the tax attributable to such recovery shall, at the election of the taxpayer, be payable in 10 equal installments")
rule S6167AInstallmentAmount strict {
    for p: Person;
    for y: TaxableYear;
    for tax: Money;
    when s6167_ten_installments_granted(p, y) and tax_attributable_to_recovery(p, y, tax);
    then s6167_installment_amount(p, y, div_round(tax, 10.0, 2, "HALF_UP"));
}
relation s6167_installment_due(p: Person, y: TaxableYear, j: Integer, due: Date) kind institutional { label en official "the j-th installment: the 15th day of the fourth month of the j-th taxable year following the taxable year of the recovery"; }
rule S6167AInstallmentDue1 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 1, add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue2 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 2, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 12 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue3 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 3, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 24 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue4 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 4, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 36 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue5 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 5, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 48 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue6 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 6, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 60 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue7 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 7, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 72 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue8 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 8, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 84 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue9 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 9, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 96 calendar_month), 3 calendar_month), 14 calendar_day)); }
rule S6167AInstallmentDue10 strict { for p: Person; for y: TaxableYear; for ye: Date; when s6167_ten_installments_granted(p, y) and us.irc.core::ends(y, ye); then s6167_installment_due(p, y, 10, add_calendar_period(add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 108 calendar_month), 3 calendar_month), 14 calendar_day)); }
relation s6167_installment_paid(p: Person, y: TaxableYear, j: Integer) kind empirical { label en official "the j-th installment has been paid"; }
@source(IRC_S6167_A, relation = formalizes, coverage = partial, quote = "be payable in 10 equal installments on the 15th day of the fourth month of each of the taxable years following the taxable year of the recovery")
rule S6167ADutyPayInstallment defeasible {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for due: Date;
    for amount: Money;
    when s6167_installment_due(p, y, j, due) and s6167_installment_amount(p, y, amount);
    then duty PayForeignExpropriationInstallment {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition s6167_installment_paid(p, y, j);
            window [-infinity, due];
        }
    };
}
// (b) extension by the Secretary on a finding of undue hardship.
relation s6167b_request(req: PaymentExtensionRequest, p: Person, y: TaxableYear) kind empirical { label en official "a request under section 6167(b) where no election under (a) is made"; }
pub external judgment relation s6167b_undue_hardship_found(p: Person, req: PaymentExtensionRequest) {
    authority Secretary;
    label en official "the Secretary finds that payment of the tax attributable to the recovery at the time otherwise provided would result in undue hardship (section 6167(b))";
}
relation s6167b_within_nine_years(req: PaymentExtensionRequest) kind institutional { label en official "the extension is for a reasonable period or periods not in excess of 9 years from the date the tax is otherwise payable"; }
rule S6167BNineYears strict {
    for req: PaymentExtensionRequest;
    for p: Person;
    for y: TaxableYear;
    for from: Date;
    for until: Date;
    when s6167b_request(req, p, y) and extension_from_date(req, from) and extension_until_date(req, until) and until <= add_calendar_period(from, 108 calendar_month);
    then s6167b_within_nine_years(req);
}
relation s6167b_terms_valid(req: PaymentExtensionRequest, p: Person) kind institutional { label en official "a recovery to which section 1351 applies, no election under (a), an undue hardship finding, and at most 9 years"; }
rule S6167BTermsValid strict {
    for req: PaymentExtensionRequest;
    for p: Person;
    for y: TaxableYear;
    when s6167b_request(req, p, y) and foreign_expropriation_loss_recovery(p, y) and not_known(s6167_installment_election_made(p, y)) and s6167b_undue_hardship_found(p, req) and s6167b_within_nine_years(req);
    then s6167b_terms_valid(req, p);
}
relation s6167b_extension_granted(req: PaymentExtensionRequest) kind institutional { label en official "the Secretary extended the time for payment of the tax attributable to the recovery"; }
@source(IRC_S6167_B, relation = formalizes, coverage = exact, quote = "the Secretary may, upon finding that the payment of the tax attributable to such recovery at the time otherwise provided in this subtitle would result in undue hardship, extend the time for payment of such tax for a reasonable period or periods not in excess of 9 years")
rule S6167BExtensionPower strict {
    for req: PaymentExtensionRequest;
    for p: Person;
    for y: TaxableYear;
    when s6167b_request(req, p, y);
    then power S6167BUndueHardshipExtensionPower {
        holder Secretary;
        over p;
        exercise s6167b_request(req, p, y);
        valid_when s6167b_terms_valid(req, p);
        effect create(s6167b_extension_granted(req));
    };
}
// (c) Acceleration on the sale of property received on the recovery.
entity ExpropriationSale { label en unofficial "a sale or exchange of property (other than money) received on the recovery, or received on such a sale or exchange"; }
relation expropriation_sale_of(ev: ExpropriationSale, p: Person, y: TaxableYear) kind empirical;
relation expropriation_sale_date(ev: ExpropriationSale, d: Date) kind empirical;
relation expropriation_sale_year_end(ev: ExpropriationSale, d: Date) kind empirical { label en official "the last day of the taxable year in which the sale or exchange occurs"; }
relation expropriation_sale_net_money(ev: ExpropriationSale, amount: Money) kind empirical { label en official "the money received on the sale or exchange, reduced by the tax imposed under chapter 1 with respect to it"; }
relation s6167_tax_paid_in_full_before(ev: ExpropriationSale) kind empirical { label en official "the tax attributable to the recovery was paid in full before the taxable year of the sale"; }
relation s6167_permitted_money(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the amount of money which may be received under subsection (a)(2): 25 percent of the recovery, not more than the tax attributable to it"; }
rule S6167CPermittedMoney strict {
    for p: Person;
    for y: TaxableYear;
    for total: Money;
    for tax: Money;
    when recovery_amount_1351c(p, y, total) and tax_attributable_to_recovery(p, y, tax);
    then s6167_permitted_money(p, y, min(total * 0.25, tax));
}
relation s6167_cumulative_money_through(ev: ExpropriationSale, total: Money) kind institutional { label en official "the money received on the recovery and on the sales up to and including this one (each net of the chapter 1 tax)"; }
rule S6167CCumulativeMoney strict {
    for ev: ExpropriationSale;
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    for recovery_money: Money;
    when expropriation_sale_of(ev, p, y) and expropriation_sale_date(ev, d) and recovery_money_received(p, y, recovery_money);
    then s6167_cumulative_money_through(ev, recovery_money + sum all m: Money for other: ExpropriationSale, od: Date where expropriation_sale_of(other, p, y) and expropriation_sale_date(other, od) and od <= d and expropriation_sale_net_money(other, m));
}
relation s6167_accelerated_amount(ev: ExpropriationSale, amount: Money) kind institutional { label en official "the amount of the tax attributable to the recovery equal to the excess of the cumulative money over the money that may be received under (a)(2)"; }
@source(IRC_S6167_C, relation = formalizes, coverage = partial, quote = "an amount of the tax attributable to such recovery equal to such excess shall be payable")
rule S6167CAcceleratedAmount strict {
    for ev: ExpropriationSale;
    for p: Person;
    for y: TaxableYear;
    for cumulative: Money;
    for permitted: Money;
    for tax: Money;
    when expropriation_sale_of(ev, p, y) and s6167_ten_installments_granted(p, y) and not_known(s6167_tax_paid_in_full_before(ev)) and s6167_cumulative_money_through(ev, cumulative) and s6167_permitted_money(p, y, permitted) and tax_attributable_to_recovery(p, y, tax) and cumulative > permitted;
    then s6167_accelerated_amount(ev, min(tax, cumulative - permitted));
}
relation s6167_accelerated_due(ev: ExpropriationSale, due: Date) kind institutional { label en official "the accelerated amount is payable on the 15th day of the fourth month of the taxable year following the taxable year of the sale or exchange"; }
rule S6167CAcceleratedDue strict {
    for ev: ExpropriationSale;
    for amount: Money;
    for ye: Date;
    when s6167_accelerated_amount(ev, amount) and expropriation_sale_year_end(ev, ye);
    then s6167_accelerated_due(ev, add_calendar_period(add_calendar_period(add_calendar_period(ye, 1 calendar_day), 3 calendar_month), 14 calendar_day));
}
relation s6167_accelerated_paid(ev: ExpropriationSale) kind empirical { label en official "the accelerated amount has been paid"; }
rule S6167CDutyPayAccelerated defeasible {
    for ev: ExpropriationSale;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for due: Date;
    when s6167_accelerated_amount(ev, amount) and s6167_accelerated_due(ev, due) and expropriation_sale_of(ev, p, y);
    then duty PayAcceleratedExpropriationTax {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition s6167_accelerated_paid(ev);
            window [-infinity, due];
        }
    };
}
relation s6167_accelerated_payment_applied_to_installments(ev: ExpropriationSale) kind institutional { label en official "the tax so paid is treated as a payment of the first unpaid installment or installments (or portion thereof) following the year of the sale"; }
@source(IRC_S6167_C, relation = formalizes, coverage = partial, quote = "as a payment of the first unpaid installment or installments (or portion thereof) which become payable under subsection (a) following such taxable year")
rule S6167CAppliedToInstallments strict { for ev: ExpropriationSale; for a: Money; when s6167_accelerated_amount(ev, a); then s6167_accelerated_payment_applied_to_installments(ev); }
// (d) Proration of deficiency to installments.
relation expropriation_deficiency_assessed(p: Person, y: TaxableYear, amount: Money, assessed_on: Date) kind empirical { label en official "a deficiency attributable to the recovery has been assessed"; }
pub external judgment relation s6167_deficiency_due_to_negligence_or_fraud(p: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the deficiency is due to negligence, to intentional disregard of rules and regulations, or to fraud with intent to evade tax (section 6167(d))";
}
relation s6167d_proration_applies(p: Person, y: TaxableYear) kind institutional { label en official "an election is made under (a) and a deficiency attributable to the recovery has been assessed, not due to negligence, disregard or fraud"; }
rule S6167DProrationApplies defeasible {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for assessed: Date;
    when s6167_ten_installments_granted(p, y) and expropriation_deficiency_assessed(p, y, amount, assessed);
    unless s6167_deficiency_due_to_negligence_or_fraud(p, y);
    then s6167d_proration_applies(p, y);
}
relation s6167_deficiency_share(p: Person, y: TaxableYear, j: Integer, amount: Money) kind institutional { label en official "the part of the deficiency prorated to the j-th installment: one tenth of the deficiency"; }
@source(IRC_S6167_D, relation = formalizes, coverage = partial, quote = "the deficiency shall be prorated to such installments")
rule S6167DShare defeasible {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for due: Date;
    for amount: Money;
    for assessed: Date;
    when s6167d_proration_applies(p, y) and expropriation_deficiency_assessed(p, y, amount, assessed) and s6167_installment_due(p, y, j, due);
    then s6167_deficiency_share(p, y, j, div_round(amount, 10.0, 2, "HALF_UP"));
}
relation s6167_share_collected_with_installment(p: Person, y: TaxableYear, j: Integer, amount: Money, due: Date) kind institutional { label en official "the part prorated to an installment whose date has not arrived is collected at the same time as, and as part of, that installment"; }
@source(IRC_S6167_D, relation = formalizes, coverage = partial, quote = "The part of the deficiency so prorated to any installment the date for payment of which has not arrived shall be collected at the same time as, and as part of, such installment.")
rule S6167DShareWithInstallment defeasible {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for amount: Money;
    for due: Date;
    for total: Money;
    for assessed: Date;
    when s6167_deficiency_share(p, y, j, amount) and s6167_installment_due(p, y, j, due) and expropriation_deficiency_assessed(p, y, total, assessed) and due > assessed;
    then s6167_share_collected_with_installment(p, y, j, amount, due);
}
relation s6167_share_payable_on_notice_and_demand(p: Person, y: TaxableYear, j: Integer, amount: Money) kind institutional { label en official "the part prorated to an installment whose date has arrived is paid upon notice and demand"; }
@source(IRC_S6167_D, relation = formalizes, coverage = partial, quote = "The part of the deficiency so prorated to any installment the date for payment of which has arrived shall be paid upon notice and demand from the Secretary.")
rule S6167DShareOnNoticeAndDemand defeasible {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for amount: Money;
    for due: Date;
    for total: Money;
    for assessed: Date;
    when s6167_deficiency_share(p, y, j, amount) and s6167_installment_due(p, y, j, due) and expropriation_deficiency_assessed(p, y, total, assessed) and due <= assessed;
    then s6167_share_payable_on_notice_and_demand(p, y, j, amount);
}
relation s6167_deficiency_notice(n: Notice, p: Person, y: TaxableYear, j: Integer) kind empirical { label en official "the notice and demand for the deficiency part prorated to the j-th installment"; }
relation s6167_share_paid(p: Person, y: TaxableYear, j: Integer) kind empirical;
rule S6167DDutyPayShare defeasible {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for amount: Money;
    for n: Notice;
    for mailed: Date;
    when s6167_share_payable_on_notice_and_demand(p, y, j, amount) and s6167_deficiency_notice(n, p, y, j) and us.irc.core::mailed_on(n, mailed);
    then duty PayExpropriationDeficiencyShareOnNoticeAndDemand {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition s6167_share_paid(p, y, j);
            window [mailed, infinity];
        }
    };
}
// (e) Time for payment of interest.
relation s6167_interest_with_installment(p: Person, y: TaxableYear, j: Integer, due: Date) kind institutional { label en official "interest on any unpaid portion is paid annually at the same time as, and as part of, each installment payment of the tax"; }
@source(IRC_S6167_E, relation = formalizes, coverage = partial, quote = "interest payable under section 6601 on any unpaid portion of such amount shall be paid annually at the same time as, and as part of, each installment payment of the tax")
rule S6167EInterestWithInstallment strict {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for due: Date;
    when s6167_installment_due(p, y, j, due);
    then s6167_interest_with_installment(p, y, j, due);
}
relation s6167_interest_paid_with_installment(p: Person, y: TaxableYear, j: Integer) kind empirical;
rule S6167EDutyInterest defeasible {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for due: Date;
    when s6167_interest_with_installment(p, y, j, due);
    then duty PayExpropriationExtensionInterestWithInstallment {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition s6167_interest_paid_with_installment(p, y, j);
            window [-infinity, due];
        }
    };
}
relation s6167_installment_before_assessment(p: Person, y: TaxableYear, due: Date) kind institutional { label en unofficial "candidate: an installment date on or before the assessment (TECH-GAPS G136 idiom)"; }
rule S6167ECandidate strict {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for due: Date;
    for amount: Money;
    for assessed: Date;
    when expropriation_deficiency_assessed(p, y, amount, assessed) and s6167_installment_due(p, y, j, due) and due <= assessed;
    then s6167_installment_before_assessment(p, y, due);
}
relation s6167_later_installment_exists(p: Person, y: TaxableYear, due: Date) kind institutional { label en unofficial "helper: a later installment before the assessment exists"; }
rule S6167ELater strict { for p: Person; for y: TaxableYear; for due: Date; for other: Date; when s6167_installment_before_assessment(p, y, due) and s6167_installment_before_assessment(p, y, other) and other > due; then s6167_later_installment_exists(p, y, due); }
relation s6167_last_installment_before_assessment(p: Person, y: TaxableYear, due: Date) kind institutional { label en official "the date fixed for the last installment preceding the assessment of the deficiency"; }
rule S6167ELast defeasible { for p: Person; for y: TaxableYear; for due: Date; when s6167_installment_before_assessment(p, y, due) and not_known(s6167_later_installment_exists(p, y, due)); then s6167_last_installment_before_assessment(p, y, due); }
relation s6167_deficiency_interest_on_notice_and_demand(p: Person, y: TaxableYear, until: Date) kind institutional { label en official "interest on the part of a deficiency prorated to an installment whose date has not arrived, for the period before the date fixed for the last installment preceding the assessment, is paid upon notice and demand"; }
@source(IRC_S6167_E, relation = formalizes, coverage = partial, quote = "Interest, on that part of a deficiency prorated under this section to any installment the date for payment of which has not arrived, for the period before the date fixed for the last installment preceding the assessment of the deficiency, shall be paid upon notice and demand from the Secretary.")
rule S6167EDeficiencyInterest defeasible {
    for p: Person;
    for y: TaxableYear;
    for until: Date;
    when s6167d_proration_applies(p, y) and s6167_last_installment_before_assessment(p, y, until);
    then s6167_deficiency_interest_on_notice_and_demand(p, y, until);
}
// (g) Failure to pay installment.
relation s6167_installment_paid_on(p: Person, y: TaxableYear, j: Integer, paid: Date) kind empirical;
relation s6167_evaluated_on(p: Person, y: TaxableYear, today: Date) kind empirical { label en official "the date as of which an unpaid installment is assessed"; }
relation s6167_installment_missed(p: Person, y: TaxableYear, j: Integer) kind institutional { label en official "the installment was not paid on or before the date fixed for its payment"; }
rule S6167GMissedLate strict { for p: Person; for y: TaxableYear; for j: Integer; for due: Date; for paid: Date; when s6167_installment_due(p, y, j, due) and s6167_installment_paid_on(p, y, j, paid) and paid > due; then s6167_installment_missed(p, y, j); }
relation s6167_installment_has_paid_date(p: Person, y: TaxableYear, j: Integer) kind institutional { label en unofficial "helper: the installment has a payment date"; }
rule S6167GHasPaidDate strict { for p: Person; for y: TaxableYear; for j: Integer; for paid: Date; when s6167_installment_paid_on(p, y, j, paid); then s6167_installment_has_paid_date(p, y, j); }
rule S6167GMissedUnpaid strict {
    for p: Person;
    for y: TaxableYear;
    for j: Integer;
    for due: Date;
    for today: Date;
    when s6167_installment_due(p, y, j, due) and s6167_evaluated_on(p, y, today) and today > due and not_known(s6167_installment_has_paid_date(p, y, j));
    then s6167_installment_missed(p, y, j);
}
relation s6167_unpaid_portion_payable_on_notice_and_demand(p: Person, y: TaxableYear) kind institutional { label en official "the unpaid portion of the tax payable in installments is paid upon notice and demand from the Secretary"; }
@source(IRC_S6167_G, relation = formalizes, coverage = exact, quote = "the unpaid portion of the tax payable in installments shall be paid upon notice and demand from the Secretary")
rule S6167GUnpaidPortionPayable strict { for p: Person; for y: TaxableYear; for j: Integer; when s6167_installment_missed(p, y, j); then s6167_unpaid_portion_payable_on_notice_and_demand(p, y); }
relation s6167_acceleration_notice(n: Notice, p: Person, y: TaxableYear) kind empirical;
relation s6167_unpaid_portion_paid(p: Person, y: TaxableYear) kind empirical;
rule S6167GDutyPayUnpaidPortion defeasible {
    for p: Person;
    for y: TaxableYear;
    for n: Notice;
    for mailed: Date;
    when s6167_unpaid_portion_payable_on_notice_and_demand(p, y) and s6167_acceleration_notice(n, p, y) and us.irc.core::mailed_on(n, mailed);
    then duty PayUnpaidExpropriationTaxOnNoticeAndDemand {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition s6167_unpaid_portion_paid(p, y);
            window [mailed, infinity];
        }
    };
}
