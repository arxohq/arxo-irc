// 26 U.S.C. §§6412, 6415, 6416, 6419, 6423 and 6430 — Chapter 65, Subchapter
// B "Rules of special application" (excise-tax credits and refunds): floor
// stocks refunds (§6412), refunds of communications/transportation taxes
// (§6415), the pass-on conditions and deemed overpayments of chapters 31/32
// taxes (§6416), wagering taxes (§6419), alcohol and tobacco taxes (§6423),
// and the Leaking Underground Storage Tank rate (§6430). Stage 2.
//
// JUDGMENT CALLS AND GAPS
//  - A claim is the shared `us.irc.core::Claim`; the tax chapter comes from
//    `claim_of(c, p, y, kind, amount)`. The excise taxes themselves (chapters
//    31-33, 35, 51, 52; §§4041, 4051, 4071, 4081, 4216, 4221, 4223) are
//    owned by `excise-goods`/`alcohol`/`tobacco-firearms`; this module reads
//    case facts about them and records `external_norm_unresolved`
//    dependencies (coverage `.deps.json`), it does not re-derive them.
//  - "Establishes, under regulations prescribed by the Secretary" (§6416(a),
//    §6419(a), §6423(a)) is modelled as the FACT that the showing is made
//    (an `established` relation per limb); the regulations that prescribe the
//    form of the showing are unpinned (EXTERNAL_DEPENDENCY row), the norm
//    that the Secretary may not allow the credit or refund without the
//    showing is a `prohibition` on the Secretary reading that fact.
//  - §6416(b)'s "shall be deemed to be an overpayment" is a classification
//    of the claim's amount (`deemed_excise_overpayment`) with the statutory
//    limits as defeaters; "credit or refund (without interest) shall be
//    allowed" is a duty of the Secretary plus a prohibition on paying
//    interest. The proportional readjustments ((b)(1), (b)(5), §6419(b))
//    use the exact-fraction form (`div_round`) — never a rounded share.
//  - §6416(a)(4) (registered vendor / credit card issuer treated as the
//    payer of the gasoline tax) is a chain of `treated_as_payer` rules and
//    a duty of the card issuer to collect the tax from the ultimate
//    purchaser when the (B) conditions fail. Registration under §4101 is a
//    case fact (`registered_under_4101`), owner `excise-goods`.
//  - §6412's dates are those of the pinned 2024 text (October 1, 2028
//    reduction date; claims by 2029-03-31; dealer requests before 2029-01-01).
//  - §6430's fourth exception (Pub. L. 119-21 sec. 70525(b)(2): fuel removed
//    as eligible indelibly dyed diesel fuel or kerosene under new §6435) is
//    a windowed rule: it applies to fuel removed on or after the date 180
//    days after enactment (2025-07-04 + 180 days = 2025-12-31). §6435 itself
//    is unowned (OWNERSHIP.json) — TECH-GAPS G2624.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    Claim,
    IRC_S6412_A,
    IRC_S6412_B,
    IRC_S6412_C,
    IRC_S6415_A,
    IRC_S6415_B,
    IRC_S6415_C,
    IRC_S6415_D,
    IRC_S6416_A,
    IRC_S6416_B,
    IRC_S6416_C,
    IRC_S6416_D,
    IRC_S6416_E,
    IRC_S6419_A,
    IRC_S6419_B,
    IRC_S6423_A,
    IRC_S6423_B,
    IRC_S6423_C,
    IRC_S6423_D,
    IRC_S6430,
    Person,
    Secretary,
    TaxKind,
    TaxableYear,
};

relation registered_under_4101(p: Person) kind empirical {
    label en official "registered under section 4101 — dependency contract: `excise-goods`";
}

// ============================================================================
// §6412 — Floor stocks refunds
// ============================================================================

relation floor_stock_article_sold_before_reduction(c: Claim, sold: Date) kind empirical {
    label en official "an article subject to the tax imposed by section 4071 or 4081 has been sold by the manufacturer, producer, or importer (before October 1, 2028)";
}
relation floor_stock_holder_is_dealer(c: Claim) kind empirical {
    label en official "the holder is a dealer: a wholesaler, jobber, distributor, or retailer (section 6412(a)(2)(A))";
}
relation floor_stock_title_passed_to_dealer(c: Claim) kind empirical {
    label en official "title to the article has passed to such dealer (whether or not delivery has been made)";
}
relation floor_stock_never_transferred_to_non_dealer(c: Claim) kind empirical {
    label en official "for purposes of consumption, title to the article or possession thereof has not at any time been transferred to any person other than a dealer";
}
relation floor_stock_unused_and_intended_for_sale(c: Claim) kind empirical {
    label en official "the article has not been used and is intended for sale";
}
relation article_held_by_dealer_6412(c: Claim) kind institutional {
    label en official "an article shall be considered as held by a dealer if title thereto has passed to such dealer and it has not been transferred for consumption to any person other than a dealer";
}
@source(IRC_S6412_A, relation = formalizes, coverage = exact, quote = "An article shall be considered as \"held by a dealer\" if title thereto has passed to such dealer (whether or not delivery to him has been made), and if for purposes of consumption title to such article or possession thereof has not at any time been transferred to any person other than a dealer.")
rule S6412ArticleHeldByDealer strict {
    for c: Claim;
    when floor_stock_holder_is_dealer(c) and floor_stock_title_passed_to_dealer(c) and floor_stock_never_transferred_to_non_dealer(c);
    then article_held_by_dealer_6412(c);
}
relation floor_stock_tax_paid_on_sale(c: Claim, amount: Money) kind empirical {
    label en official "the tax paid by the manufacturer, producer, or importer on his sale of the article";
}
relation floor_stock_tax_applicable_after_reduction(c: Claim, amount: Money) kind empirical {
    label en official "the amount of tax made applicable to such article on and after October 1, 2028";
}
relation dealer_request_submitted_on(c: Claim, d: Date) kind empirical {
    label en official "a request submitted to the manufacturer, producer, or importer by the dealer who held the article";
}
relation dealer_reimbursed_or_consented_by(c: Claim, d: Date) kind empirical {
    label en official "reimbursement has been made to such dealer for the tax reduction, or written consent has been obtained from such dealer to allowance of the credit or refund";
}
relation floor_stock_taxable_fuel_in_excluded_stocks(c: Claim) kind empirical {
    label en official "taxable fuel in retail stocks held at the place where intended to be sold at retail, or held for sale by a producer or importer of taxable fuel";
}
relation floor_stock_claim_conditions_met(c: Claim) kind institutional {
    label en official "sold before October 1, 2028, held by a dealer on that date unused for sale, claim filed by March 31, 2029 on a dealer request submitted before January 1, 2029, reimbursement or consent by March 31, 2029";
}
@source(IRC_S6412_A, relation = formalizes, coverage = partial, quote = "if claim for such credit or refund is filed with the Secretary on or before March 31, 2029, based upon a request submitted to the manufacturer, producer, or importer before January 1, 2029, by the dealer who held the article in respect of which the credit or refund is claimed, and, on or before March 31, 2029, reimbursement has been made to such dealer by such manufacturer, producer, or importer for the tax reduction on such article or written consent has been obtained from such dealer to allowance of such credit or refund")
rule S6412ClaimConditionsMet strict {
    for c: Claim;
    for sold: Date;
    for filed: Date;
    for requested: Date;
    for reimbursed: Date;
    when floor_stock_article_sold_before_reduction(c, sold) and sold < @2028-10-01
        and article_held_by_dealer_6412(c) and floor_stock_unused_and_intended_for_sale(c)
        and us.irc.core::claim_filed_on(c, filed) and filed <= @2029-03-31
        and dealer_request_submitted_on(c, requested) and requested < @2029-01-01
        and dealer_reimbursed_or_consented_by(c, reimbursed) and reimbursed <= @2029-03-31;
    then floor_stock_claim_conditions_met(c);
}
pub relation floor_stock_refund_amount(c: Claim, amount: Money) kind institutional {
    label en official "the difference between the tax paid on the manufacturer's sale of the article and the tax applicable on and after October 1, 2028";
}
@source(IRC_S6412_A, relation = formalizes, coverage = exact, quote = "an amount equal to the difference between the tax paid by such manufacturer, producer, or importer on his sale of the article and the amount of tax made applicable to such article on and after October 1, 2028")
rule S6412RefundIsTaxDifference strict {
    for c: Claim;
    for paid: Money;
    for applicable: Money;
    when floor_stock_claim_conditions_met(c) and floor_stock_tax_paid_on_sale(c, paid) and floor_stock_tax_applicable_after_reduction(c, applicable) and paid > applicable
        and not_known(floor_stock_taxable_fuel_in_excluded_stocks(c));
    then floor_stock_refund_amount(c, paid - applicable);
}
relation floor_stock_credit_or_refund_allowed(c: Claim) kind empirical {
    label en official "the amount is credited or refunded to the manufacturer, producer, or importer";
}
@source(IRC_S6412_A, relation = formalizes, coverage = partial, quote = "there shall be credited or refunded (without interest) to the manufacturer, producer, or importer")
rule S6412DutyToCreditOrRefundFloorStock defeasible {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    for refund: Money;
    when floor_stock_refund_amount(c, refund) and us.irc.core::claim_of(c, p, y, kind, amt);
    then duty CreditOrRefundFloorStock {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition floor_stock_credit_or_refund_allowed(c);
            window [-infinity, infinity];
        }
    };
}
relation interest_paid_on_excise_credit_or_refund(c: Claim) kind empirical {
    label en official "interest is allowed on the credit or refund";
}
@source(IRC_S6412_A, relation = formalizes, coverage = partial, quote = "(without interest)")
rule S6412NoInterestOnFloorStockRefund strict {
    for c: Claim;
    when floor_stock_refund_amount(c, _) and interest_paid_on_excise_credit_or_refund(c);
    then prohibition NoInterestOnFloorStockRefund {
        bearer Secretary;
        action interest_paid_on_excise_credit_or_refund(c);
        window [-infinity, infinity];
    };
}
relation manufacturer_has_inventory_evidence(c: Claim) kind empirical {
    label en official "he has in his possession such evidence of the inventories with respect to which the credit or refund is claimed as may be required by regulations";
}
relation secretary_allows_floor_stock_credit(c: Claim) kind empirical {
    label en unofficial "the Secretary allows the credit or refund under subsection (a)";
}
@source(IRC_S6412_B, relation = formalizes, coverage = exact, quote = "No manufacturer, producer, or importer shall be entitled to credit or refund under subsection (a) unless he has in his possession such evidence of the inventories with respect to which the credit or refund is claimed as may be required by regulations prescribed under this section.")
rule S6412NoAllowanceWithoutInventoryEvidence defeasible {
    for c: Claim;
    when secretary_allows_floor_stock_credit(c);
    then prohibition NoFloorStockCreditWithoutInventoryEvidence {
        bearer Secretary;
        action secretary_allows_floor_stock_credit(c);
        window [-infinity, infinity];
    };
    unless manufacturer_has_inventory_evidence(c) and secretary_allows_floor_stock_credit(c);
}
relation floor_stock_credit_treated_as_overpayment_of_tax(c: Claim) kind institutional {
    label en official "the credits and refunds provided for in subsection (a) are treated as if they constituted overpayments of the taxes imposed by sections 4071 and 4081";
}
@source(IRC_S6412_C, relation = formalizes, coverage = partial, quote = "apply in respect of the credits and refunds provided for in subsection (a) to the same extent as if such credits or refunds constituted overpayments of such taxes")
rule S6412CreditTreatedAsOverpayment defeasible {
    for c: Claim;
    when floor_stock_refund_amount(c, _);
    then floor_stock_credit_treated_as_overpayment_of_tax(c);
}

// ============================================================================
// §6415 — Credits or refunds to persons who collected certain taxes
// ============================================================================

relation communications_or_transport_tax_kind(kind: TaxKind) kind institutional {
    label en official "tax imposed by section 4251, 4261, or 4271 (chapter 33)";
}
rule S6415ChapterThirtyThreeIsCovered strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when us.irc.core::claim_of(c, p, y, kind, amt) and kind == us.irc.core::FacilitiesServicesExciseCh33;
    then claim_for_chapter_33_tax(c);
}
relation claim_for_chapter_33_tax(c: Claim) kind institutional {
    label en official "the claim concerns tax imposed by section 4251, 4261, or 4271";
}
relation collector_repaid_payer(c: Claim) kind empirical {
    label en official "he has repaid the amount of such tax to the person from whom he collected it";
}
relation collector_obtained_payer_consent(c: Claim) kind empirical {
    label en official "he obtains the consent of such person to the allowance of such credit or refund";
}
relation collector_showing_established_6415a(c: Claim) kind institutional {
    label en official "the collector establishes repayment or obtains consent";
}
rule S6415ShowingByRepayment strict { for c: Claim; when collector_repaid_payer(c); then collector_showing_established_6415a(c); }
rule S6415ShowingByConsent strict { for c: Claim; when collector_obtained_payer_consent(c); then collector_showing_established_6415a(c); }
relation secretary_allows_collector_credit_or_refund(c: Claim) kind empirical;
relation collector_credit_or_refund_allowed(c: Claim) kind institutional;
@source(IRC_S6415_A, relation = formalizes, coverage = exact, quote = "Credit or refund of any overpayment of tax imposed by section 4251, 4261, or 4271 may be allowed to the person who collected the tax and paid it to the Secretary")
rule S6415SecretaryMayAllowCollectorRefund strict {
    for c: Claim;
    when claim_for_chapter_33_tax(c);
    then power S6415AllowCollectorCreditOrRefundPower {
        holder Secretary;
        over c;
        exercise secretary_allows_collector_credit_or_refund(c);
        valid_when collector_showing_established_6415a(c);
        effect create(collector_credit_or_refund_allowed(c));
    };
}
relation takes_credit_against_subsequent_return(p: Person, c: Claim) kind empirical {
    label en official "take credit therefor against taxes imposed by such section due upon any subsequent return";
}
@source(IRC_S6415_B, relation = formalizes, coverage = exact, quote = "Any person entitled to a refund of tax imposed by section 4251, 4261, or 4271 paid, or collected and paid, to the Secretary by him may, instead of filing a claim for refund, take credit therefor against taxes imposed by such section due upon any subsequent return.")
rule S6415MayTakeCreditInsteadOfClaim strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when claim_for_chapter_33_tax(c) and us.irc.core::claim_of(c, p, y, kind, amt);
    then liberty MayTakeCreditForChapter33Refund {
        holder p;
        against Secretary;
        action takes_credit_against_subsequent_return(p, c);
        window [-infinity, infinity];
    };
}
relation overcollection_application_made(c: Claim, collector: Person, payer: Person) kind empirical {
    label en official "upon proper application, an overcollection of tax under section 4251, 4261, or 4271 is to be refunded to the person entitled";
}
relation overcollection_refunded(c: Claim) kind empirical;
@source(IRC_S6415_C, relation = formalizes, coverage = exact, quote = "such person shall, upon proper application, refund such overcollection to the person entitled thereto")
rule S6415CollectorMustRefundOvercollection strict {
    for c: Claim;
    for collector: Person;
    for payer: Person;
    when claim_for_chapter_33_tax(c) and overcollection_application_made(c, collector, payer);
    then duty RefundOvercollectionOfChapter33Tax {
        bearer collector;
        beneficiary payer;
        goal achievement {
            condition overcollection_refunded(c);
            window [-infinity, infinity];
        }
    };
}
relation repays_tax_collected_with_refund(p: Person, c: Claim) kind empirical {
    label en official "any person making a refund of any payment on which tax has been collected may repay therewith the amount of tax collected on such payment";
}
@source(IRC_S6415_D, relation = formalizes, coverage = exact, quote = "Any person making a refund of any payment on which tax imposed by section 4251, 4261, or 4271 has been collected may repay therewith the amount of tax collected on such payment.")
rule S6415MayRepayTaxWithRefundOfPayment strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when claim_for_chapter_33_tax(c) and us.irc.core::claim_of(c, p, y, kind, amt);
    then liberty MayRepayTaxWithRefundOfPayment {
        holder p;
        against Secretary;
        action repays_tax_collected_with_refund(p, c);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §6416 — Conditions to allowance in the case of certain taxes
// ============================================================================

enum ExciseOverpaymentBasis {
    PriceReadjustment;            // (b)(1)(A)
    PriceReadjustmentTaxAt4223;   // (b)(1)(B)
    TireWarrantyAdjustment;       // (b)(1)(C)
    ExportedArticle;              // (b)(2)(A)
    VesselOrAircraftSupplies;     // (b)(2)(B)
    SoldToStateOrLocalGovernment; // (b)(2)(C)
    SoldToNonprofitEducational;   // (b)(2)(D)
    SoldToQualifiedBloodCollector; // (b)(2)(E)
    TireForSection4221e3Use;      // (b)(2)(F)
    GasolineForSpecialFuels;      // (b)(2)(G)
    SubsequentManufacturerMaterial; // (b)(3)(A)
    SubsequentManufacturerNonfuelFuel; // (b)(3)(B)
    TireSoldWithOtherArticle;     // (b)(4)
    InstallmentAccountReturned;   // (b)(5)
    ComponentOfSection4051Article; // (b)(6)
    label en unofficial "the ground on which chapter 31/32 tax is deemed an overpayment under §6416(b)";
}
relation overpayment_basis(c: Claim, b: ExciseOverpaymentBasis) kind empirical {
    label en unofficial "the claim asserts this ground of §6416(b)";
}
relation claim_for_chapter_31_or_32_tax(c: Claim) kind institutional {
    label en official "tax imposed by chapter 31 (relating to retail excise taxes) or chapter 32 (manufacturers taxes)";
}
rule S6416ChapterThirtyOneClaim strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when us.irc.core::claim_of(c, p, y, kind, amt) and kind == us.irc.core::RetailExciseCh31;
    then claim_for_chapter_31_or_32_tax(c);
}
rule S6416ChapterThirtyTwoClaim strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when us.irc.core::claim_of(c, p, y, kind, amt) and kind == us.irc.core::ManufacturersExciseCh32;
    then claim_for_chapter_31_or_32_tax(c);
}

// (a)(1): the pass-on conditions A-D; (a)(2) exceptions.
relation payer_did_not_include_tax_in_price_or_collect(c: Claim) kind empirical {
    label en official "(A) has not included the tax in the price of the article and has not collected the amount of the tax from the person who purchased such article";
}
relation payer_repaid_ultimate_purchaser(c: Claim) kind empirical {
    label en official "(B) has repaid the amount of the tax to the ultimate purchaser of the article";
}
relation payer_repaid_or_agreed_to_repay_ultimate_vendor(c: Claim) kind empirical {
    label en official "(C)(i) has repaid or agreed to repay the amount of the tax to the ultimate vendor of the article";
}
relation payer_obtained_vendor_written_consent(c: Claim) kind empirical {
    label en official "(C)(ii) has obtained the written consent of such ultimate vendor to the allowance of the credit or the making of the refund";
}
relation payer_filed_purchaser_written_consent(c: Claim) kind empirical {
    label en official "(D) has filed with the Secretary the written consent of the person referred to in subparagraph (B) to the allowance of the credit or the making of the refund";
}
relation limb_C_showing_established(c: Claim) kind institutional {
    label en official "(C) in the case of an overpayment under subsection (b)(2): repaid or agreed to repay the ultimate vendor, or obtained the vendor's written consent";
}
rule S6416LimbCByRepayment strict { for c: Claim; when overpayment_basis_under_b2(c) and payer_repaid_or_agreed_to_repay_ultimate_vendor(c); then limb_C_showing_established(c); }
rule S6416LimbCByConsent strict { for c: Claim; when overpayment_basis_under_b2(c) and payer_obtained_vendor_written_consent(c); then limb_C_showing_established(c); }
relation overpayment_basis_under_b2(c: Claim) kind institutional {
    label en official "the overpayment arises under subsection (b)(2)";
}
rule S6416BasisB2Export strict { for c: Claim; when overpayment_basis(c, ExportedArticle); then overpayment_basis_under_b2(c); }
rule S6416BasisB2Supplies strict { for c: Claim; when overpayment_basis(c, VesselOrAircraftSupplies); then overpayment_basis_under_b2(c); }
rule S6416BasisB2State strict { for c: Claim; when overpayment_basis(c, SoldToStateOrLocalGovernment); then overpayment_basis_under_b2(c); }
rule S6416BasisB2Nonprofit strict { for c: Claim; when overpayment_basis(c, SoldToNonprofitEducational); then overpayment_basis_under_b2(c); }
rule S6416BasisB2Blood strict { for c: Claim; when overpayment_basis(c, SoldToQualifiedBloodCollector); then overpayment_basis_under_b2(c); }
rule S6416BasisB2Tire strict { for c: Claim; when overpayment_basis(c, TireForSection4221e3Use); then overpayment_basis_under_b2(c); }
rule S6416BasisB2Gasoline strict { for c: Claim; when overpayment_basis(c, GasolineForSpecialFuels); then overpayment_basis_under_b2(c); }

relation pass_on_showing_established(c: Claim) kind institutional {
    label en official "the person who paid the tax has established the (A), (B), (C) or (D) showing of section 6416(a)(1)";
}
rule S6416ShowingA strict { for c: Claim; when payer_did_not_include_tax_in_price_or_collect(c); then pass_on_showing_established(c); }
rule S6416ShowingB strict { for c: Claim; when payer_repaid_ultimate_purchaser(c); then pass_on_showing_established(c); }
rule S6416ShowingC strict { for c: Claim; when limb_C_showing_established(c); then pass_on_showing_established(c); }
rule S6416ShowingD strict { for c: Claim; when payer_filed_purchaser_written_consent(c); then pass_on_showing_established(c); }

relation pass_on_condition_does_not_apply(c: Claim) kind institutional {
    label en official "section 6416(a)(2): the condition does not apply (special-fuels use tax under §4041; overpayments under (b)(1), (b)(3)(A), (b)(4), (b)(5), (b)(6))";
}
relation overpayment_of_special_fuels_use_tax(c: Claim) kind empirical {
    label en official "the tax imposed by section 4041 (relating to tax on special fuels) on the use of any liquid";
}
rule S6416ExceptSpecialFuelsUse strict { for c: Claim; when overpayment_of_special_fuels_use_tax(c); then pass_on_condition_does_not_apply(c); }
rule S6416ExceptB1A strict { for c: Claim; when overpayment_basis(c, PriceReadjustment); then pass_on_condition_does_not_apply(c); }
rule S6416ExceptB1B strict { for c: Claim; when overpayment_basis(c, PriceReadjustmentTaxAt4223); then pass_on_condition_does_not_apply(c); }
rule S6416ExceptB1C strict { for c: Claim; when overpayment_basis(c, TireWarrantyAdjustment); then pass_on_condition_does_not_apply(c); }
rule S6416ExceptB3A strict { for c: Claim; when overpayment_basis(c, SubsequentManufacturerMaterial); then pass_on_condition_does_not_apply(c); }
rule S6416ExceptB4 strict { for c: Claim; when overpayment_basis(c, TireSoldWithOtherArticle); then pass_on_condition_does_not_apply(c); }
rule S6416ExceptB5 strict { for c: Claim; when overpayment_basis(c, InstallmentAccountReturned); then pass_on_condition_does_not_apply(c); }
rule S6416ExceptB6 strict { for c: Claim; when overpayment_basis(c, ComponentOfSection4051Article); then pass_on_condition_does_not_apply(c); }

relation secretary_allows_excise_credit_or_refund(c: Claim) kind empirical {
    label en unofficial "the Secretary allows or makes the credit or refund of the chapter 31/32 overpayment";
}
@source(IRC_S6416_A, relation = formalizes, coverage = exact, quote = "No credit or refund of any overpayment of tax imposed by chapter 31 (relating to retail excise taxes), or chapter 32 (manufacturers taxes), shall be allowed or made unless the person who paid the tax establishes, under regulations prescribed by the Secretary, that he—")
rule S6416NoCreditOrRefundWithoutPassOnShowing defeasible {
    for c: Claim;
    when claim_for_chapter_31_or_32_tax(c) and secretary_allows_excise_credit_or_refund(c);
    then prohibition NoChapter31Or32RefundWithoutPassOnShowing {
        bearer Secretary;
        action secretary_allows_excise_credit_or_refund(c);
        window [-infinity, infinity];
    };
    unless pass_on_showing_established(c) and secretary_allows_excise_credit_or_refund(c);
    unless pass_on_condition_does_not_apply(c) and secretary_allows_excise_credit_or_refund(c);
}

// (a)(3): the ultimate purchaser includes dealers holding the article on the
// 15th day after the Secretary's determination that it is not taxable.
relation secretary_determined_article_not_taxable_on(c: Claim, d: Date) kind empirical {
    label en official "the Secretary determines that an article is not taxable";
}
relation holds_article_for_sale_on(c: Claim, holder: Person, d: Date) kind empirical {
    label en official "a wholesaler, jobber, distributor, or retailer holds such article for sale";
}
relation claim_filed_by_first_return_date_after_determination(c: Claim) kind empirical {
    label en official "claim for credit or refund is filed on or before the date for filing the return for the taxes imposed under chapter 32 for the first period which begins more than 60 days after the determination";
}
pub relation treated_as_ultimate_purchaser_after_determination(c: Claim, holder: Person) kind institutional {
    label en official "the term ultimate purchaser includes a dealer who, on the 15th day after the Secretary's determination that the article is not taxable, holds the article for sale";
}
@source(IRC_S6416_A, relation = formalizes, coverage = exact, quote = "includes a wholesaler, jobber, distributor, or retailer who, on the 15th day after the date of such determination, holds such article for sale")
rule S6416DealerHoldingOnFifteenthDayIsUltimatePurchaser strict {
    for c: Claim;
    for holder: Person;
    for determined: Date;
    for held_on: Date;
    when secretary_determined_article_not_taxable_on(c, determined) and holds_article_for_sale_on(c, holder, held_on)
        and held_on == add_calendar_period(determined, 15 calendar_day)
        and claim_filed_by_first_return_date_after_determination(c);
    then treated_as_ultimate_purchaser_after_determination(c, holder);
}

// (a)(4): registered ultimate vendor / credit card issuer administer gasoline
// tax refunds.
relation gasoline_sold_to_b2_C_or_D_purchaser(c: Claim, vendor: Person) kind empirical {
    label en official "an ultimate vendor purchases gasoline on which section 4081 tax has been paid and sells it to an ultimate purchaser described in subsection (b)(2)(C) or (D) for a use described therein";
}
relation gasoline_purchase_by_credit_card(c: Claim, issuer: Person) kind empirical {
    label en official "the purchase is made by means of a credit card issued to the ultimate purchaser; the issuer is the person extending the credit";
}
relation issuer_not_collected_tax_from_purchaser(c: Claim) kind empirical {
    label en official "(ii)(I) has not collected the amount of the tax from the person who purchased such article";
}
relation issuer_obtained_purchaser_consent(c: Claim) kind empirical {
    label en official "(ii)(II) has obtained the written consent from the ultimate purchaser to the allowance of the credit or refund";
}
relation issuer_repaid_or_agreed_to_repay_vendor(c: Claim) kind empirical {
    label en official "(iii)(I) has repaid or agreed to repay the amount of the tax to the ultimate vendor";
}
relation issuer_obtained_vendor_consent(c: Claim) kind empirical {
    label en official "(iii)(II) has obtained the written consent of the ultimate vendor to the allowance of the credit or refund";
}
relation issuer_arranged_vendor_reimbursement(c: Claim) kind empirical {
    label en official "(iii)(III) has otherwise made arrangements which directly or indirectly provides the ultimate vendor with reimbursement of such tax";
}
relation issuer_clause_ii_established(c: Claim) kind institutional { label en official "(ii) established: no collection from the purchaser, or purchaser's written consent"; }
rule S6416IssuerClauseIIByNoCollection strict { for c: Claim; when issuer_not_collected_tax_from_purchaser(c); then issuer_clause_ii_established(c); }
rule S6416IssuerClauseIIByConsent strict { for c: Claim; when issuer_obtained_purchaser_consent(c); then issuer_clause_ii_established(c); }
relation issuer_clause_iii_established(c: Claim) kind institutional { label en official "(iii) established: repaid or agreed to repay the vendor, obtained the vendor's consent, or arranged reimbursement"; }
rule S6416IssuerClauseIIIByRepayment strict { for c: Claim; when issuer_repaid_or_agreed_to_repay_vendor(c); then issuer_clause_iii_established(c); }
rule S6416IssuerClauseIIIByConsent strict { for c: Claim; when issuer_obtained_vendor_consent(c); then issuer_clause_iii_established(c); }
rule S6416IssuerClauseIIIByArrangement strict { for c: Claim; when issuer_arranged_vendor_reimbursement(c); then issuer_clause_iii_established(c); }
relation card_issuer_meets_conditions(c: Claim, issuer: Person) kind institutional {
    label en official "the credit card issuer is registered under section 4101 and meets clauses (ii) and (iii)";
}
rule S6416CardIssuerMeetsConditions strict {
    for c: Claim;
    for issuer: Person;
    when gasoline_purchase_by_credit_card(c, issuer) and registered_under_4101(issuer) and issuer_clause_ii_established(c) and issuer_clause_iii_established(c);
    then card_issuer_meets_conditions(c, issuer);
}
pub relation treated_as_payer_of_gasoline_tax(c: Claim, p: Person) kind institutional {
    label en official "the person treated as the person (and the only person) who paid the section 4081 tax for §6416 purposes";
}
@source(IRC_S6416_A, relation = formalizes, coverage = exact, quote = "such ultimate vendor shall be treated as the person (and the only person) who paid such tax, but only if such ultimate vendor is registered under section 4101.")
rule S6416RegisteredVendorTreatedAsPayer defeasible {
    for c: Claim;
    for vendor: Person;
    when gasoline_sold_to_b2_C_or_D_purchaser(c, vendor) and registered_under_4101(vendor);
    then treated_as_payer_of_gasoline_tax(c, vendor);
    unless gasoline_purchase_by_credit_card(c, vendor) and gasoline_sold_to_b2_C_or_D_purchaser(c, vendor);
}
relation credit_card_purchase_of_gasoline_described_in_A(c: Claim) kind empirical {
    label en official "the purchase of gasoline described in subparagraph (A), determined without regard to the registration status of the ultimate vendor, is made by credit card";
}
@source(IRC_S6416_A, relation = formalizes, coverage = exact, quote = "the person extending the credit to the ultimate purchaser shall be treated as the person (and the only person) who paid the tax, but only if such person—")
rule S6416CardIssuerTreatedAsPayer strict {
    for c: Claim;
    for issuer: Person;
    when credit_card_purchase_of_gasoline_described_in_A(c) and card_issuer_meets_conditions(c, issuer);
    then treated_as_payer_of_gasoline_tax(c, issuer);
}
relation card_issuer_collected_tax_from_ultimate_purchaser(c: Claim) kind empirical {
    label en official "such person shall collect an amount equal to the tax from the ultimate purchaser";
}
@source(IRC_S6416_A, relation = formalizes, coverage = exact, quote = "If clause (i), (ii), or (iii) is not met by such person extending the credit to the ultimate purchaser, then such person shall collect an amount equal to the tax from the ultimate purchaser and only such ultimate purchaser may claim such credit or payment.")
rule S6416CardIssuerMustCollectFromPurchaserWhenConditionsFail defeasible {
    for c: Claim;
    for issuer: Person;
    for purchaser: Person;
    when credit_card_purchase_of_gasoline_described_in_A(c) and gasoline_purchase_by_credit_card(c, issuer) and gasoline_ultimate_purchaser(c, purchaser);
    then duty CollectTaxFromUltimatePurchaser {
        bearer issuer;
        beneficiary Secretary;
        goal achievement {
            condition card_issuer_collected_tax_from_ultimate_purchaser(c);
            window [-infinity, infinity];
        }
    };
    unless card_issuer_meets_conditions(c, issuer) and gasoline_ultimate_purchaser(c, purchaser);
}
relation gasoline_ultimate_purchaser(c: Claim, purchaser: Person) kind empirical {
    label en official "the ultimate purchaser of the gasoline";
}
// (a)(4)(C): the procedure and timing follow §6427(i)(4) — read by the
// vendor-refund claim rules in 10-fuel-payments-and-credits.law.
relation claim_under_6416_a4(c: Claim) kind institutional {
    label en official "a claim of an ultimate vendor or credit card issuer under §6416(a)(4)(A) or (B), whose procedure and timing are those of §6427(i)(4)";
}
rule S6416ClaimUnderA4VendorIsVendorRefundClaim defeasible {
    for c: Claim;
    for p: Person;
    when treated_as_payer_of_gasoline_tax(c, p);
    then claim_under_6416_a4(c);
}

// (b): overpayments determined; "without interest".
relation claim_tax_paid_on_article(c: Claim, amount: Money) kind empirical {
    label en unofficial "the tax paid on the article in respect of which the claim is made";
}
relation exportation_or_use_before_any_other_use(c: Claim) kind empirical {
    label en official "the exportation or use referred to occurs before any other use (or, for a sale or resale, the use is to occur before any other use)";
}
relation sold_to_qualified_blood_collector_for_exclusive_use(c: Claim) kind empirical;
relation tax_paid_under_section_4064(c: Claim) kind empirical {
    label en official "any tax paid under section 4064";
}
relation tax_imposed_by_4131_vaccine(c: Claim) kind empirical {
    label en official "the tax imposed by section 4131";
}
relation exported_vaccine_use_meets_regulations(c: Claim) kind empirical {
    label en official "the use of the exported vaccine meets such requirements as the Secretary may by regulations prescribe";
}
relation tax_on_diesel_fuel_or_kerosene_or_4121(c: Claim) kind empirical {
    label en official "any tax imposed under section 4041(a)(1) or 4081 on diesel fuel or kerosene and any tax paid under section 4121";
}
relation subsequent_manufacturer_conditions_met(c: Claim) kind empirical {
    label en official "(b)(3): the article was sold to a subsequent manufacturer or producer before being used and is used as material in, or as a component part of, another article taxable under chapter 32 or an automobile bus chassis or body (fuel: for nonfuel purposes as material)";
}
relation tire_sold_with_other_article_conditions_met(c: Claim) kind empirical {
    label en official "(b)(4): the tire is sold on or in connection with an automobile bus chassis/body, an article exported or sold to a State/local government or nonprofit educational organization or used for vessel/aircraft supplies, or sold to a blood collector organization vehicle";
}
relation installment_account_conditions_met(c: Claim) kind empirical {
    label en official "(b)(5): tax was paid under section 4216(d)(1) on an installment account, the account is returned to the seller under the agreement, and the consideration is readjusted";
}
relation component_part_of_4051_article_conditions_met(c: Claim) kind empirical {
    label en official "(b)(6): section 4051 tax was paid, and before any other use the article is used as a component part of another section 4051 article manufactured by the user (or would have been but for breakage)";
}
relation price_readjustment(c: Claim, price: Money, repaid_or_credited: Money) kind empirical {
    label en official "the price of the article is readjusted by return or repossession of the article or a container, or by a bona fide discount, rebate, or allowance (including local advertising to the extent of §4216(e)(2),(3))";
}
relation installment_consideration_readjusted(c: Claim, consideration: Money, repaid_or_credited: Money) kind empirical {
    label en official "(b)(5): the consideration is readjusted as provided in the agreement";
}
relation deemed_excise_overpayment(c: Claim, amount: Money) kind institutional {
    label en official "the tax (or the part of the tax) which section 6416(b) deems to be an overpayment";
}

@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "the part of the tax proportionate to the part of the price repaid or credited to the purchaser shall be deemed to be an overpayment")
rule S6416DeemedOverpaymentB1A strict {
    for c: Claim;
    for tax: Money;
    for price: Money;
    for part: Money;
    when overpayment_basis(c, PriceReadjustment) and claim_tax_paid_on_article(c, tax) and price_readjustment(c, price, part) and price > 0 USD
        and not_known(overpayment_basis(c, TireWarrantyAdjustment));
    then deemed_excise_overpayment(c, div_round(tax * (part / 1.00 USD), price / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "the part of the tax proportionate to the part of such price repaid or credited to the purchaser shall be deemed to be an overpayment")
rule S6416DeemedOverpaymentB1B defeasible {
    for c: Claim;
    for tax: Money;
    for price: Money;
    for part: Money;
    when overpayment_basis(c, PriceReadjustmentTaxAt4223) and claim_tax_paid_on_article(c, tax) and price_readjustment(c, price, part) and price > 0 USD and exportation_or_use_before_any_other_use(c);
    then deemed_excise_overpayment(c, div_round(tax * (part / 1.00 USD), price / 1.00 USD, 2, "HALF_UP"));
}
relation tire_warranty_credit_or_refund_allowed(c: Claim) kind empirical {
    label en unofficial "credit or refund of a section 4071(a)/(b) tax is allowed by reason of a tire warranty adjustment";
}
@source(IRC_S6416_B, relation = formalizes, coverage = exact, quote = "No credit or refund of any tax imposed by subsection (a) or (b) of section 4071 shall be allowed or made by reason of an adjustment of a tire pursuant to a warranty or guarantee.")
rule S6416NoRefundForTireWarrantyAdjustment strict {
    for c: Claim;
    when overpayment_basis(c, TireWarrantyAdjustment) and tire_warranty_credit_or_refund_allowed(c);
    then prohibition NoRefundForTireWarrantyAdjustment {
        bearer Secretary;
        action tire_warranty_credit_or_refund_allowed(c);
        window [-infinity, infinity];
    };
}

// (b)(2): the deemed-overpayment grounds for chapter 32 tax paid on an article
// (and §4041(a)/(d) sales, §4051). Each ground is a separate defeasible rule
// so the limits of the closing sentences defeat exactly the grounds they name.
relation b2_ground_holds(c: Claim) kind institutional {
    label en official "the article was, by any person, exported; used or sold for use as supplies for vessels or aircraft; sold to a State or local government, nonprofit educational organization or qualified blood collector for its exclusive use; a tire sold for §4221(e)(3) use; or gasoline used or sold for use in the production of special fuels";
}
rule S6416B2Export strict { for c: Claim; when overpayment_basis(c, ExportedArticle); then b2_ground_holds(c); }
rule S6416B2Supplies strict { for c: Claim; when overpayment_basis(c, VesselOrAircraftSupplies); then b2_ground_holds(c); }
rule S6416B2State strict { for c: Claim; when overpayment_basis(c, SoldToStateOrLocalGovernment); then b2_ground_holds(c); }
rule S6416B2Nonprofit strict { for c: Claim; when overpayment_basis(c, SoldToNonprofitEducational); then b2_ground_holds(c); }
rule S6416B2Blood strict { for c: Claim; when overpayment_basis(c, SoldToQualifiedBloodCollector); then b2_ground_holds(c); }
rule S6416B2Tire strict { for c: Claim; when overpayment_basis(c, TireForSection4221e3Use); then b2_ground_holds(c); }
rule S6416B2Gasoline strict { for c: Claim; when overpayment_basis(c, GasolineForSpecialFuels); then b2_ground_holds(c); }
relation b2_ground_disabled_by_closing_sentence(c: Claim) kind institutional {
    label en official "the closing sentences of §6416(b)(2): (C),(D),(E) do not apply to section 4064 tax; for section 4131 vaccine tax only (A) applies, and only for qualifying use; the paragraph does not apply to diesel fuel or kerosene tax or section 4121 tax";
}
rule S6416DisabledC4064 strict { for c: Claim; when tax_paid_under_section_4064(c) and (overpayment_basis(c, SoldToStateOrLocalGovernment) or overpayment_basis(c, SoldToNonprofitEducational) or overpayment_basis(c, SoldToQualifiedBloodCollector)); then b2_ground_disabled_by_closing_sentence(c); }
rule S6416DisabledVaccineNonExport strict { for c: Claim; when tax_imposed_by_4131_vaccine(c) and (overpayment_basis(c, VesselOrAircraftSupplies) or overpayment_basis(c, SoldToStateOrLocalGovernment) or overpayment_basis(c, SoldToNonprofitEducational) or overpayment_basis(c, SoldToQualifiedBloodCollector)); then b2_ground_disabled_by_closing_sentence(c); }
rule S6416DisabledVaccineExportWithoutRegulatoryUse strict { for c: Claim; when tax_imposed_by_4131_vaccine(c) and overpayment_basis(c, ExportedArticle) and not_known(exported_vaccine_use_meets_regulations(c)); then b2_ground_disabled_by_closing_sentence(c); }
rule S6416DisabledDieselKeroseneOr4121 strict { for c: Claim; when tax_on_diesel_fuel_or_kerosene_or_4121(c) and b2_ground_holds(c); then b2_ground_disabled_by_closing_sentence(c); }
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "The tax paid under chapter 32 (or under subsection (a) or (d) of section 4041 in respect of sales or under section 4051) in respect of any article shall be deemed to be an overpayment if such article was, by any person—")
rule S6416DeemedOverpaymentB2 defeasible {
    for c: Claim;
    for tax: Money;
    when b2_ground_holds(c) and claim_tax_paid_on_article(c, tax) and exportation_or_use_before_any_other_use(c);
    then deemed_excise_overpayment(c, tax);
    unless b2_ground_disabled_by_closing_sentence(c) and claim_tax_paid_on_article(c, tax);
}
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "such tax shall be deemed to be an overpayment by such subsequent manufacturer or producer if—")
rule S6416DeemedOverpaymentB3 strict {
    for c: Claim;
    for tax: Money;
    when overpayment_basis(c, SubsequentManufacturerMaterial) and subsequent_manufacturer_conditions_met(c) and claim_tax_paid_on_article(c, tax) and exportation_or_use_before_any_other_use(c);
    then deemed_excise_overpayment(c, tax);
}
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "such tax shall be deemed to be an overpayment by such person if such other article is—")
rule S6416DeemedOverpaymentB4 strict {
    for c: Claim;
    for tax: Money;
    when overpayment_basis(c, TireSoldWithOtherArticle) and tire_sold_with_other_article_conditions_met(c) and claim_tax_paid_on_article(c, tax) and exportation_or_use_before_any_other_use(c);
    then deemed_excise_overpayment(c, tax);
}
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "the part of the tax paid under section 4216(d)(1) allocable to the part of the consideration repaid or credited to the purchaser of such account shall be deemed to be an overpayment")
rule S6416DeemedOverpaymentB5 strict {
    for c: Claim;
    for tax: Money;
    for consideration: Money;
    for part: Money;
    when overpayment_basis(c, InstallmentAccountReturned) and installment_account_conditions_met(c) and claim_tax_paid_on_article(c, tax) and installment_consideration_readjusted(c, consideration, part) and consideration > 0 USD;
    then deemed_excise_overpayment(c, div_round(tax * (part / 1.00 USD), consideration / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "such tax shall be deemed to be an overpayment by such person.")
rule S6416DeemedOverpaymentB6 strict {
    for c: Claim;
    for tax: Money;
    when overpayment_basis(c, ComponentOfSection4051Article) and component_part_of_4051_article_conditions_met(c) and claim_tax_paid_on_article(c, tax) and exportation_or_use_before_any_other_use(c);
    then deemed_excise_overpayment(c, tax);
}
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "Under regulations prescribed by the Secretary, credit or refund (without interest) shall be allowed or made in respect of the overpayments determined under the following paragraphs:")
rule S6416DutyToAllowDeemedOverpaymentWithoutInterest strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    for deemed: Money;
    when deemed_excise_overpayment(c, deemed) and us.irc.core::claim_of(c, p, y, kind, amt);
    then duty AllowCreditOrRefundOfDeemedExciseOverpayment {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition excise_credit_or_refund_allowed(c);
            window [-infinity, infinity];
        }
    };
}
relation excise_credit_or_refund_allowed(c: Claim) kind empirical;
@source(IRC_S6416_B, relation = formalizes, coverage = partial, quote = "credit or refund (without interest)")
rule S6416NoInterestOnDeemedOverpayment strict {
    for c: Claim;
    when deemed_excise_overpayment(c, _) and interest_paid_on_excise_credit_or_refund(c);
    then prohibition NoInterestOnDeemedExciseOverpayment {
        bearer Secretary;
        action interest_paid_on_excise_credit_or_refund(c);
        window [-infinity, infinity];
    };
}

// (c): erroneously collected tax on exports to a foreign country/possession.
relation article_exported_or_shipped_to_foreign_country_or_possession(c: Claim) kind empirical {
    label en official "exported to a foreign country or shipped to a possession of the United States";
}
relation payer_waives_claim_to_amount(c: Claim) kind empirical {
    label en official "the person who paid such tax waives his claim to such amount";
}
relation secretary_refunds_to_exporter_or_shipper(c: Claim) kind empirical;
relation refunded_to_exporter_or_shipper(c: Claim) kind institutional;
@source(IRC_S6416_C, relation = formalizes, coverage = exact, quote = "the amount of any tax imposed by chapter 31, or chapter 32 erroneously or illegally collected in respect of any article exported to a foreign country or shipped to a possession of the United States may be refunded to the exporter or shipper thereof, if the person who paid such tax waives his claim to such amount")
rule S6416SecretaryMayRefundToExporterOnWaiver strict {
    for c: Claim;
    when claim_for_chapter_31_or_32_tax(c) and article_exported_or_shipped_to_foreign_country_or_possession(c);
    then power S6416RefundToExporterPower {
        holder Secretary;
        over c;
        exercise secretary_refunds_to_exporter_or_shipper(c);
        valid_when payer_waives_claim_to_amount(c);
        effect create(refunded_to_exporter_or_shipper(c));
    };
}

// (d): credit against a subsequent return instead of a claim.
relation takes_credit_against_subsequent_return_6416(p: Person, c: Claim) kind empirical;
relation refund_described_in_4081e(c: Claim) kind empirical {
    label en official "refunds described in section 4081(e)";
}
@source(IRC_S6416_D, relation = formalizes, coverage = exact, quote = "Any person entitled to a refund of tax imposed by chapter 31 or 32, paid to the Secretary may, instead of filing a claim for refund, take credit therefor against taxes imposed by such chapter due on any subsequent return.")
rule S6416MayTakeCreditAgainstSubsequentReturn defeasible {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when claim_for_chapter_31_or_32_tax(c) and us.irc.core::claim_of(c, p, y, kind, amt);
    then liberty MayTakeCreditForChapter31Or32Refund {
        holder p;
        against Secretary;
        action takes_credit_against_subsequent_return_6416(p, c);
        window [-infinity, infinity];
    };
    unless refund_described_in_4081e(c) and us.irc.core::claim_of(c, p, y, kind, amt);
}

// (e): identification of manufacturers for fungible articles.
enum IdentificationMethod {
    FirstInFirstOut;
    LastInFirstOut;
    OtherConsistentMethod;
    label en official "the basis on which the manufacturer of like articles used or resold is identified (§6416(e))";
}
relation like_articles_used_or_resold(p: Person) kind empirical {
    label en official "any person uses or resells like articles";
}
relation identification_method_chosen(p: Person, m: IdentificationMethod) kind empirical;
relation secretary_approved_consistent_method(p: Person) kind empirical {
    label en official "any other consistent method approved by the Secretary";
}
relation identification_method_permitted(p: Person, m: IdentificationMethod) kind institutional {
    label en official "the identification method is one §6416(e) permits under regulations";
}
@source(IRC_S6416_E, relation = formalizes, coverage = exact, quote = "(1) on a first-in-first-out basis,")
rule S6416FifoPermitted strict { for p: Person; when like_articles_used_or_resold(p) and identification_method_chosen(p, FirstInFirstOut); then identification_method_permitted(p, FirstInFirstOut); }
@source(IRC_S6416_E, relation = formalizes, coverage = exact, quote = "(2) on a last-in-first-out basis, or")
rule S6416LifoPermitted strict { for p: Person; when like_articles_used_or_resold(p) and identification_method_chosen(p, LastInFirstOut); then identification_method_permitted(p, LastInFirstOut); }
@source(IRC_S6416_E, relation = formalizes, coverage = exact, quote = "(3) in accordance with any other consistent method approved by the Secretary.")
rule S6416OtherMethodPermittedWhenApproved strict { for p: Person; when like_articles_used_or_resold(p) and identification_method_chosen(p, OtherConsistentMethod) and secretary_approved_consistent_method(p); then identification_method_permitted(p, OtherConsistentMethod); }

// ============================================================================
// §6419 — Excise tax on wagering
// ============================================================================

relation wagering_claim(c: Claim) kind institutional {
    label en official "the claim concerns tax imposed by chapter 35 (wagering)";
}
rule S6419WageringClaim strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when us.irc.core::claim_of(c, p, y, kind, amt) and kind == us.irc.core::WageringExciseCh35;
    then wagering_claim(c);
}
relation payer_did_not_collect_wagering_tax_from_bettor(c: Claim) kind empirical {
    label en official "(1) he has not collected (whether as a separate charge or otherwise) the amount of the tax from the person who placed the wager";
}
relation payer_repaid_bettor(c: Claim) kind empirical {
    label en official "(2) he has repaid the amount of the tax to the person who placed such wager";
}
relation payer_filed_bettor_written_consent(c: Claim) kind empirical {
    label en official "he files with the Secretary written consent of the person who placed such wager to the allowance of the credit or the making of the refund";
}
relation wagering_showing_established(c: Claim) kind institutional {
    label en official "the payer has established (1), (2), or filed the bettor's written consent";
}
rule S6419ShowingNoCollection strict { for c: Claim; when payer_did_not_collect_wagering_tax_from_bettor(c); then wagering_showing_established(c); }
rule S6419ShowingRepaid strict { for c: Claim; when payer_repaid_bettor(c); then wagering_showing_established(c); }
rule S6419ShowingConsent strict { for c: Claim; when payer_filed_bettor_written_consent(c); then wagering_showing_established(c); }
relation secretary_allows_wagering_refund(c: Claim) kind empirical;
relation claim_is_credit_under_6419b(c: Claim) kind empirical {
    label en official "the credit or refund is allowed under subsection (b) (laid-off wagers)";
}
@source(IRC_S6419_A, relation = formalizes, coverage = exact, quote = "No overpayment of tax imposed by chapter 35 shall be credited or refunded (otherwise than under subsection (b)), in pursuance of a court decision or otherwise, unless the person who paid the tax establishes")
rule S6419NoWageringRefundWithoutShowing defeasible {
    for c: Claim;
    when wagering_claim(c) and secretary_allows_wagering_refund(c);
    then prohibition NoWageringRefundWithoutShowing {
        bearer Secretary;
        action secretary_allows_wagering_refund(c);
        window [-infinity, infinity];
    };
    unless wagering_showing_established(c) and secretary_allows_wagering_refund(c);
    unless claim_is_credit_under_6419b(c) and secretary_allows_wagering_refund(c);
}
relation laid_off_wager_refund_to_accepting_party(c: Claim) kind empirical {
    label en official "a credit or refund is made to the person with whom a laid-off wager was placed";
}
relation compliance_shown_for_laid_off_and_original_bettors(c: Claim) kind empirical {
    label en official "the provisions of the preceding sentence have been complied with both with respect to the person who placed the laid-off wager with him and with respect to the person who placed the original wager";
}
@source(IRC_S6419_A, relation = formalizes, coverage = exact, quote = "In the case of any laid-off wager, no overpayment of tax imposed by chapter 35 shall be so credited or refunded to the person with whom such laid-off wager was placed unless he establishes")
rule S6419NoLaidOffWagerRefundWithoutBothShowings defeasible {
    for c: Claim;
    when wagering_claim(c) and laid_off_wager_refund_to_accepting_party(c) and secretary_allows_wagering_refund(c);
    then prohibition NoLaidOffWagerRefundWithoutBothShowings {
        bearer Secretary;
        action secretary_allows_wagering_refund(c);
        window [-infinity, infinity];
    };
    unless compliance_shown_for_laid_off_and_original_bettors(c) and secretary_allows_wagering_refund(c);
}
relation original_wager_tax_paid(c: Claim, amount: Money) kind empirical {
    label en official "the amount of tax which such taxpayer paid on the original wager";
}
relation wager_amount_laid_off(c: Claim, laid_off: Money, original: Money) kind empirical {
    label en official "the amount so laid off, and the amount of the original wager";
}
pub relation laid_off_wager_credit_amount(c: Claim, amount: Money) kind institutional {
    label en official "the credit or refund bears the same ratio to the tax paid on the original wager as the amount laid off bears to the amount of the original wager";
}
@source(IRC_S6419_B, relation = formalizes, coverage = exact, quote = "Such credit or refund shall be in an amount which bears the same ratio to the amount of tax which such taxpayer paid on the original wager as the amount so laid off bears to the amount of the original wager.")
rule S6419LaidOffCreditIsProportional strict {
    for c: Claim;
    for tax: Money;
    for laid_off: Money;
    for original: Money;
    when original_wager_tax_paid(c, tax) and wager_amount_laid_off(c, laid_off, original) and original > 0 USD;
    then laid_off_wager_credit_amount(c, div_round(tax * (laid_off / 1.00 USD), original / 1.00 USD, 2, "HALF_UP"));
}
relation laid_off_credit_allowed_by_regulations(c: Claim) kind empirical {
    label en official "credit or refund under this subsection is allowed or made only in accordance with regulations prescribed by the Secretary";
}
@source(IRC_S6419_B, relation = formalizes, coverage = exact, quote = "a credit against such tax shall be allowed, or a refund shall be made to, the taxpayer laying off such amount")
rule S6419DutyToCreditOrRefundLaidOffTax defeasible {
    for c: Claim;
    for p: Person;
    for amount: Money;
    when laid_off_wager_credit_amount(c, amount) and us.irc.core::claim_of(c, p, _, _, _);
    then duty CreditOrRefundLaidOffWagerTax {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition laid_off_credit_or_refund_made(c);
            window [-infinity, infinity];
        }
    };
}
relation laid_off_credit_or_refund_made(c: Claim) kind empirical;
@source(IRC_S6419_B, relation = formalizes, coverage = exact, quote = "no interest shall be allowed with respect to any amount so credited or refunded")
rule S6419NoInterestOnLaidOffCredit strict {
    for c: Claim;
    when laid_off_wager_credit_amount(c, _) and interest_paid_on_excise_credit_or_refund(c);
    then prohibition NoInterestOnLaidOffWagerCredit {
        bearer Secretary;
        action interest_paid_on_excise_credit_or_refund(c);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §6423 — Conditions to allowance in the case of alcohol and tobacco taxes
// ============================================================================

relation alcohol_or_tobacco_claim(c: Claim) kind institutional {
    label en official "the claim concerns an amount paid or collected as an alcohol or tobacco tax (chapter 51 other than occupational taxes, chapter 52, or a corresponding prior provision; equal, additional, or floor stocks taxes on such commodities)";
}
rule S6423AlcoholClaim strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when us.irc.core::claim_of(c, p, y, kind, amt) and kind == us.irc.core::AlcoholExciseCh51;
    then alcohol_or_tobacco_claim(c);
}
rule S6423TobaccoClaim strict {
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when us.irc.core::claim_of(c, p, y, kind, amt) and kind == us.irc.core::TobaccoExciseCh52;
    then alcohol_or_tobacco_claim(c);
}
relation claimed_on_erroneous_illegal_or_excessive_ground(c: Claim) kind empirical {
    label en official "the credit or refund is claimed on the grounds that an amount of alcohol or tobacco tax was assessed or collected erroneously, illegally, without authority, or in any manner wrongfully, or that such amount was excessive";
}
relation claim_is_drawback(c: Claim) kind empirical { label en official "any claim for drawback"; }
relation claim_under_law_for_commodity_withdrawn_returned_or_lost(c: Claim) kind empirical {
    label en official "any claim made under a law expressly providing for credit or refund where a commodity is withdrawn from the market, returned to bond, or lost or destroyed";
}
relation section_6423_applies(c: Claim) kind institutional {
    label en official "section 6423 applies only if the claim is on the erroneous/illegal/excessive ground and is not a drawback or market-withdrawal claim";
}
@source(IRC_S6423_C, relation = formalizes, coverage = exact, quote = "This section shall apply only if the credit or refund is claimed on the grounds that an amount of alcohol or tobacco tax was assessed or collected erroneously, illegally, without authority, or in any manner wrongfully, or on the grounds that such amount was excessive.")
rule S6423AppliesOnlyToErroneousOrExcessiveClaims defeasible {
    for c: Claim;
    when alcohol_or_tobacco_claim(c) and claimed_on_erroneous_illegal_or_excessive_ground(c);
    then section_6423_applies(c);
    unless claim_is_drawback(c) and alcohol_or_tobacco_claim(c);
    unless claim_under_law_for_commodity_withdrawn_returned_or_lost(c) and alcohol_or_tobacco_claim(c);
}
// (d)(3): who bore the ultimate burden.
relation claimant_not_relieved_of_burden(c: Claim) kind empirical { label en official "(A) he has not, directly or indirectly, been relieved of such burden or shifted such burden to any other person"; }
relation no_understanding_for_relief_or_shifting(c: Claim) kind empirical { label en official "(B) no understanding or agreement exists for any such relief or shifting"; }
relation claimant_has_not_sold_or_contracted_to_sell(c: Claim) kind empirical { label en official "he has neither sold nor contracted to sell the commodities involved in such claim"; }
relation claimant_agrees_no_relief_or_shifting_and_furnishes_bond(c: Claim) kind empirical { label en official "(C) he agrees that there will be no such relief or shifting, and furnishes such bond as the Secretary may require"; }
relation claimant_treated_as_bearing_burden(c: Claim) kind institutional {
    label en official "the claimant is treated as having borne the ultimate burden of the amount of an alcohol or tobacco tax";
}
@source(IRC_S6423_D, relation = formalizes, coverage = exact, quote = "The claimant shall be treated as having borne the ultimate burden of an amount of an alcohol or tobacco tax for purposes of subsection (a)(1), and the owner referred to in subsection (a)(3) shall be treated as having borne such burden for purposes of such subsection, only if—")
rule S6423BurdenBorneWhenSoldOrContracted strict {
    for c: Claim;
    when claimant_not_relieved_of_burden(c) and no_understanding_for_relief_or_shifting(c) and claimant_has_not_sold_or_contracted_to_sell(c) and claimant_agrees_no_relief_or_shifting_and_furnishes_bond(c);
    then claimant_treated_as_bearing_burden(c);
}
relation commodity_sold_or_contracted_to_sell(c: Claim) kind empirical { label en official "the claimant has sold or contracted to sell the commodities involved in such claim"; }
rule S6423BurdenBorneWhenAlreadySold strict {
    for c: Claim;
    when claimant_not_relieved_of_burden(c) and no_understanding_for_relief_or_shifting(c) and commodity_sold_or_contracted_to_sell(c);
    then claimant_treated_as_bearing_burden(c);
}
relation claimant_repaid_burden_bearer_unconditionally(c: Claim) kind empirical { label en official "(2) he has unconditionally repaid the amount claimed to the person who bore the ultimate burden of such amount"; }
relation owner_furnished_amount_and_consented(c: Claim) kind empirical { label en official "(3)(A)-(B) the owner of the commodity furnished him the amount claimed for payment of the tax, and he has filed the owner's written consent"; }
relation owner_satisfies_burden_or_repayment_requirement(c: Claim) kind empirical { label en official "(3)(C) the owner satisfies the requirements of paragraph (1) or (2)"; }
relation alcohol_tobacco_showing_established(c: Claim) kind institutional {
    label en official "the claimant establishes (1) that he bore the ultimate burden, (2) that he unconditionally repaid the burden bearer, or (3) the owner's furnishing and consent";
}
rule S6423ShowingBoreBurden strict { for c: Claim; when claimant_treated_as_bearing_burden(c); then alcohol_tobacco_showing_established(c); }
rule S6423ShowingRepaid strict { for c: Claim; when claimant_repaid_burden_bearer_unconditionally(c); then alcohol_tobacco_showing_established(c); }
rule S6423ShowingOwner strict { for c: Claim; when owner_furnished_amount_and_consented(c) and owner_satisfies_burden_or_repayment_requirement(c); then alcohol_tobacco_showing_established(c); }
relation secretary_allows_alcohol_tobacco_refund(c: Claim) kind empirical;
@source(IRC_S6423_A, relation = formalizes, coverage = exact, quote = "No credit or refund shall be allowed or made, in pursuance of a court decision or otherwise, of any amount paid or collected as an alcohol or tobacco tax unless the claimant establishes (under regulations prescribed by the Secretary)—")
rule S6423NoRefundWithoutShowing defeasible {
    for c: Claim;
    when section_6423_applies(c) and secretary_allows_alcohol_tobacco_refund(c);
    then prohibition NoAlcoholTobaccoRefundWithoutShowing {
        bearer Secretary;
        action secretary_allows_alcohol_tobacco_refund(c);
        window [-infinity, infinity];
    };
    unless alcohol_tobacco_showing_established(c) and secretary_allows_alcohol_tobacco_refund(c);
}
relation claim_filed_by_person_who_paid(c: Claim) kind empirical { label en official "a claim has been filed by the person who paid the amount claimed"; }
relation claim_filed_within_prescribed_time_and_form(c: Claim) kind empirical { label en official "the claim is filed within the time prescribed by law and in accordance with regulations"; }
relation evidence_set_forth_and_submitted_with_claim(c: Claim) kind empirical { label en official "all evidence relied upon in support of such claim is clearly set forth and submitted with the claim"; }
relation alcohol_tobacco_claim_procedurally_complete(c: Claim) kind institutional { label en official "section 6423(b): filed by the payer, in time and form, with the evidence"; }
@source(IRC_S6423_B, relation = formalizes, coverage = exact, quote = "No credit or refund of any amount to which subsection (a) applies shall be allowed or made unless a claim therefor has been filed by the person who paid the amount claimed, and unless such claim is filed within the time prescribed by law and in accordance with regulations prescribed by the Secretary.")
rule S6423ClaimProcedurallyComplete strict {
    for c: Claim;
    when claim_filed_by_person_who_paid(c) and claim_filed_within_prescribed_time_and_form(c) and evidence_set_forth_and_submitted_with_claim(c);
    then alcohol_tobacco_claim_procedurally_complete(c);
}
@source(IRC_S6423_B, relation = formalizes, coverage = exact, quote = "No credit or refund of any amount to which subsection (a) applies shall be allowed or made unless a claim therefor has been filed by the person who paid the amount claimed")
rule S6423NoRefundWithoutProperClaim defeasible {
    for c: Claim;
    when section_6423_applies(c) and secretary_allows_alcohol_tobacco_refund(c);
    then prohibition NoAlcoholTobaccoRefundWithoutProperClaim {
        bearer Secretary;
        action secretary_allows_alcohol_tobacco_refund(c);
        window [-infinity, infinity];
    };
    unless alcohol_tobacco_claim_procedurally_complete(c) and secretary_allows_alcohol_tobacco_refund(c);
}

// ============================================================================
// §6430 — Leaking Underground Storage Tank Trust Fund financing rate
// ============================================================================

relation refund_of_lust_rate_tax_claim(c: Claim) kind empirical {
    label en official "a refund, credit, or payment under this subchapter for tax imposed at the Leaking Underground Storage Tank Trust Fund financing rate";
}
relation fuel_exempt_under_4081a_by_4082f2(c: Claim) kind empirical { label en official "(1) fuels which are exempt from tax under section 4081(a) by reason of section 4082(f)(2)"; }
relation fuel_exempt_under_4041d_last_sentence_of_5(c: Claim) kind empirical { label en official "(2) fuels which are exempt from tax under section 4041(d) by reason of the last sentence of paragraph (5) thereof"; }
relation fuel_with_zero_4081a2B_rate_increase(c: Claim) kind empirical { label en official "(3) fuels with respect to which the rate increase under section 4081(a)(2)(B) is zero by reason of section 4082(e)(2)"; }
relation fuel_removed_as_dyed_fuel_under_6435(c: Claim, removed: Date) kind empirical { label en official "(4) fuels which are removed as eligible indelibly dyed diesel fuel or kerosene under section 6435 (Pub. L. 119-21 sec. 70525(b)(2))"; }
relation secretary_makes_lust_rate_refund(c: Claim) kind empirical;
@source(IRC_S6430, relation = formalizes, coverage = exact, quote = "No refunds, credits, or payments shall be made under this subchapter for any tax imposed at the Leaking Underground Storage Tank Trust Fund financing rate, except in the case of fuels—")
rule S6430NoLustRateRefundExceptExemptFuels defeasible {
    effective [@2005-10-01, infinity);
    for c: Claim;
    when refund_of_lust_rate_tax_claim(c) and secretary_makes_lust_rate_refund(c);
    then prohibition NoLustRateRefundExceptListedFuels {
        bearer Secretary;
        action secretary_makes_lust_rate_refund(c);
        window [-infinity, infinity];
    };
    unless fuel_exempt_under_4081a_by_4082f2(c) and secretary_makes_lust_rate_refund(c);
    unless fuel_exempt_under_4041d_last_sentence_of_5(c) and secretary_makes_lust_rate_refund(c);
    unless fuel_with_zero_4081a2B_rate_increase(c) and secretary_makes_lust_rate_refund(c);
    unless lust_rate_exception_for_dyed_fuel_applies(c) and secretary_makes_lust_rate_refund(c);
}
@source(us.irc.temporal::PL119_21_S70525, quote = "(4) which are removed as eligible indelibly dyed diesel fuel or kerosene under section 6435.")
rule S6430FourthExceptionForDyedFuelAfterPL119_21 defeasible {
    effective [@2025-12-31, infinity);
    for c: Claim;
    for removed: Date;
    when refund_of_lust_rate_tax_claim(c) and secretary_makes_lust_rate_refund(c) and fuel_removed_as_dyed_fuel_under_6435(c, removed) and removed >= @2025-12-31;
    then lust_rate_exception_for_dyed_fuel_applies(c);
}
relation lust_rate_exception_for_dyed_fuel_applies(c: Claim) kind institutional {
    label en official "the fourth exception of §6430 as amended by Pub. L. 119-21 sec. 70525(b)(2), for fuel removed on or after 2025-12-31 (180 days after enactment)";
}
