// Shared computation helpers for chapters 62/65/67 (§§6151-6167, 6401-6413,
// 6601-6631): a person's outstanding balance on a liability, computed as
// liability minus the sum of payments the case asserts were APPLIED to it
// (`us.irc.core::payment_applied`, an owner's ordering-of-application fact —
// §6402(a)'s crediting order is stated in 02-refunds-and-credits.law).
//
// NO DATE PARAMETER: a `balance_due(..., on: Date, ...)` head would leave
// `on` unbound by any positive premise and be refused by range restriction
// (§190; LDC-E4101). Instead `remaining_balance`/`fully_paid` are computed
// over ALL payments the case has asserted (empirical facts, not a derived
// predicate — the §111 runtime-subset aggregate limitation therefore does
// not apply: `payment`/`payment_applied` are `kind empirical`/`institutional`
// case facts, not rule-derived, exactly the case AGENT-BRIEF's method note
// says is fine). A scenario that wants "balance as of date D" asserts only
// the payments with `on <= D` in its case file; the relation itself answers
// "balance given everything currently on record".

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    Person,
    TaxKind,
    TaxableYear,
};

pub relation remaining_balance(p: Person, y: TaxableYear, kind: TaxKind, amount: Money) kind institutional {
    label en unofficial "the person's liability for the year/kind minus the sum of payments the case shows applied to it";
}
rule ComputeRemainingBalance strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when us.irc.core::liability(p, y, kind, amt);
    then remaining_balance(p, y, kind,
        amt - (sum all paid: Money for pay: Payment where us.irc.core::payment_applied(pay, p, y, kind) and us.irc.core::payment(pay, p, paid, _)));
}

pub relation fully_paid(p: Person, y: TaxableYear, kind: TaxKind) kind institutional {
    label en unofficial "the person's applied payments equal or exceed the liability for the year/kind — §6151(a)'s duty is discharged";
}
rule ComputeFullyPaid strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for bal: Money;
    when remaining_balance(p, y, kind, bal) and bal <= 0 USD;
    then fully_paid(p, y, kind);
}
