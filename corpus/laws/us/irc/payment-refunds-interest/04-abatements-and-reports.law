// 26 U.S.C. §§6404-6407 — Chapter 65, Subchapter A (cont'd): abatements
// (§6404), reports of large refunds and credits to the Joint Committee on
// Taxation (§6405), and the date of allowance of a refund or credit (§6407).
// §§6406, 6408, 6409 are OUT OF STAGE-1 SCOPE (not named by the task's
// section list) — left `unreviewed`, note "stage 2".
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §6404(a)/(c)/(d) are discretionary `power`s ("is authorized to abate");
//    §6404(e)(1) is also discretionary ("the Secretary MAY abate"), but
//    §6404(e)(2) (erroneous-refund interest) and §6404(f) (erroneous-advice
//    penalty) use "shall abate" — modeled as `duty` (mandatory), matching
//    the same reading the task gives §6159(c)'s "shall enter".
//  - §6404(g) ("the Secretary shall suspend...") is a mandatory duty keyed
//    to the Secretary's OWN failure to give timely notice — the achievement
//    condition here is the suspension being applied, and the 36-month/21-day
//    windows are computed with `add_calendar_period`. The `(2)` exceptions
//    list is folded into a single `unless` guard rather than six separate
//    defeater rules, since no scenario in this stage distinguishes them.
//  - §6404(h) (Tax Court jurisdiction to review an abatement refusal) is
//    NON_NORMATIVE at this stage: it is a forum/jurisdiction grant, not a
//    computable norm over case facts this package models — see coverage row
//    26/6404/h/u1.
//  - §6405's dollar reporting threshold ($2,000,000 general / $5,000,000 C
//    corporation) is executable and modeled as a `prohibition` on the
//    Secretary refunding/crediting an amount above the threshold before 30
//    days have run from the report to the Joint Committee. The BENEFICIARY
//    of the report duty is named as `us.irc.core::Congress` rather than the
//    `joint-committee` package's own `JointCommittee` constant: this
//    package's declared world does not import `joint-committee` (it is not
//    listed as an allowed dependency for this stage), so the report's
//    addressee is recorded at the level of identity core already supports.
//    §6405(b)-(c) (tentative adjustments under §6411, disaster-loss
//    elections under §165(i)) are EXTERNAL_DEPENDENCY: §6411 belongs to a
//    package this stage does not own/import — modeled only as an
//    alternative gate that bypasses the (a) waiting period, without
//    formalizing §6411/§165(i) themselves.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    Assessment,
    IRC_S6404_A,
    IRC_S6404_B,
    IRC_S6404_C,
    IRC_S6404_D,
    IRC_S6404_E,
    IRC_S6404_F,
    IRC_S6404_G,
    IRC_S6404_H,
    IRC_S6405_A,
    IRC_S6407,
    Person,
    Secretary,
    TaxKind,
    TaxableYear,
    earlier_overassessment_authorization_exists,
};

// ============================================================================
// §6404 — Abatements
// ============================================================================

// --- (a): general abatement power -------------------------------------------

relation assessment_excessive(a: Assessment) kind empirical;
relation assessment_after_limitations(a: Assessment) kind empirical;
relation assessment_erroneous_or_illegal(a: Assessment) kind empirical;
relation abates_assessment(a: Assessment) kind empirical;
relation assessment_abated(a: Assessment) kind institutional;

relation assessment_qualifies_for_abatement(a: Assessment) kind institutional {
    label en unofficial "one of §6404(a)'s three grounds is met — excessive, time-barred, or erroneous/illegal";
}
rule S6404QualifiesExcessive strict { for a: Assessment; when assessment_excessive(a); then assessment_qualifies_for_abatement(a); }
rule S6404QualifiesAfterLimitations strict { for a: Assessment; when assessment_after_limitations(a); then assessment_qualifies_for_abatement(a); }
rule S6404QualifiesErroneousOrIllegal strict { for a: Assessment; when assessment_erroneous_or_illegal(a); then assessment_qualifies_for_abatement(a); }

@source(IRC_S6404_A, relation = formalizes, coverage = partial, quote = "The Secretary is authorized to abate the unpaid portion of the assessment of any tax or any liability in respect thereof, which—")
rule S6404AbateAssessment strict {
    for a: Assessment;
    when abates_assessment(a);
    then power S6404AbateAssessmentPower {
        holder Secretary;
        over a;
        exercise abates_assessment(a);
        valid_when assessment_qualifies_for_abatement(a);
        effect create(assessment_abated(a));
    };
}

// --- (b): no claim for abatement of income/estate/gift tax ------------------

relation files_abatement_claim(p: Person, a: Assessment, kind: TaxKind) kind empirical;
@source(IRC_S6404_B, relation = formalizes, coverage = exact, quote = "No claim for abatement shall be filed by a taxpayer in respect of an assessment of any tax imposed under subtitle A or B.")
rule S6404NoAbatementClaimForIncomeEstateGiftTax strict {
    for p: Person;
    for a: Assessment;
    for kind: TaxKind;
    when files_abatement_claim(p, a, kind)
        and (kind == us.irc.core::IncomeCh1 or kind == us.irc.core::EstateCh11 or kind == us.irc.core::GiftCh12);
    then prohibition NoAbatementClaimForIncomeEstateGiftTax {
        bearer p;
        action files_abatement_claim(p, a, kind);
        window [-infinity, infinity];
    };
}

// --- (c): small tax balances -------------------------------------------------

relation collection_costs_do_not_warrant_collection(a: Assessment) kind empirical {
    label en official "the administration and collection costs involved would not warrant collection of the amount due";
}
@source(IRC_S6404_C, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to abate the unpaid portion of the assessment of any tax, or any liability in respect thereof, if the Secretary determines under uniform rules prescribed by the Secretary that the administration and collection costs involved would not warrant collection of the amount due.")
rule S6404AbateSmallBalance strict {
    for a: Assessment;
    when abates_assessment(a);
    then power S6404AbateSmallBalancePower {
        holder Secretary;
        over a;
        exercise abates_assessment(a);
        valid_when collection_costs_do_not_warrant_collection(a);
        effect create(assessment_abated(a));
    };
}

// --- (d): mathematical-error assistance abatement ---------------------------

relation return_prepared_by_irs_assistance(a: Assessment) kind empirical {
    label en official "the return was prepared by an officer or employee of the Internal Revenue Service acting in his official capacity to provide assistance to taxpayers in the preparation of income tax returns";
}
relation abates_interest_on_math_error_assistance(a: Assessment) kind empirical;
relation interest_on_math_error_assistance_abated(a: Assessment) kind institutional;
@source(IRC_S6404_D, relation = formalizes, coverage = partial, quote = "if the return was prepared by an officer or employee of the Internal Revenue Service acting in his official capacity to provide assistance to taxpayers in the preparation of income tax returns, the Secretary is authorized to abate the assessment of all or any part of any interest on such deficiency for any period ending on or before the 30th day following the date of notice and demand")
rule S6404AbateMathErrorAssistanceInterest strict {
    for a: Assessment;
    when abates_interest_on_math_error_assistance(a);
    then power S6404AbateMathErrorAssistanceInterestPower {
        holder Secretary;
        over a;
        exercise abates_interest_on_math_error_assistance(a);
        valid_when return_prepared_by_irs_assistance(a);
        effect create(interest_on_math_error_assistance_abated(a));
    };
}

// --- (e)(1): discretionary abatement for unreasonable IRS error/delay ------

relation irs_ministerial_or_managerial_error_or_delay(a: Assessment) kind empirical {
    label en official "any unreasonable error or delay by an officer or employee of the Internal Revenue Service (acting in his official capacity) in performing a ministerial or managerial act";
}
relation error_not_attributable_to_taxpayer(a: Assessment) kind empirical {
    label en official "no significant aspect of such error or delay can be attributed to the taxpayer involved";
}
relation irs_contacted_taxpayer_in_writing(a: Assessment) kind empirical;
relation abates_interest_for_irs_error(a: Assessment) kind empirical;
relation interest_for_irs_error_abated(a: Assessment) kind institutional;
relation irs_error_conditions_met(a: Assessment) kind institutional {
    label en unofficial "all three §6404(e)(1) conditions are met: a ministerial/managerial error or delay, not attributable to the taxpayer, after written IRS contact";
}
rule S6404IrsErrorConditionsMet strict {
    for a: Assessment;
    when irs_ministerial_or_managerial_error_or_delay(a) and error_not_attributable_to_taxpayer(a) and irs_contacted_taxpayer_in_writing(a);
    then irs_error_conditions_met(a);
}
@source(IRC_S6404_E, relation = formalizes, coverage = partial, quote = "the Secretary may abate the assessment of all or any part of such interest for any period. For purposes of the preceding sentence, an error or delay shall be taken into account only if no significant aspect of such error or delay can be attributed to the taxpayer involved, and after the Internal Revenue Service has contacted the taxpayer in writing with respect to such deficiency or payment.")
rule S6404AbateInterestForIrsError strict {
    for a: Assessment;
    when abates_interest_for_irs_error(a);
    then power S6404AbateInterestForIrsErrorPower {
        holder Secretary;
        over a;
        exercise abates_interest_for_irs_error(a);
        valid_when irs_error_conditions_met(a);
        effect create(interest_for_irs_error_abated(a));
    };
}

// --- (e)(2): MANDATORY abatement of interest on an erroneous refund --------

entity ErroneousRefund { label en unofficial "an erroneous refund under §6602"; }
relation erroneous_refund_amount(r: ErroneousRefund, amount: Money) kind empirical;
relation erroneous_refund_caused_by_taxpayer(r: ErroneousRefund) kind empirical;
relation demand_for_repayment_made_on(r: ErroneousRefund, d: Date) kind empirical;
relation erroneous_refund_interest_abated(r: ErroneousRefund) kind institutional;

@source(IRC_S6404_E, relation = formalizes, coverage = partial, quote = "The Secretary shall abate the assessment of all interest on any erroneous refund under section 6602 until the date demand for repayment is made, unless—")
rule S6404MustAbateErroneousRefundInterest strict {
    for r: ErroneousRefund;
    for d: Date;
    for amount: Money;
    when demand_for_repayment_made_on(r, d) and erroneous_refund_amount(r, amount) and amount <= 50000 USD
        and not erroneous_refund_caused_by_taxpayer(r);
    then duty AbateErroneousRefundInterest {
        bearer Secretary;
        goal achievement {
            condition erroneous_refund_interest_abated(r);
            window [-infinity, d];
        }
    };
}

// --- (f): MANDATORY abatement for erroneous written IRS advice -------------

relation erroneous_written_advice_furnished(p: Person, a: Assessment) kind empirical {
    label en official "erroneous advice furnished to the taxpayer in writing by an officer or employee of the Internal Revenue Service, acting in such officer's or employee's official capacity";
}
relation advice_reasonably_relied_and_requested_in_writing(p: Person, a: Assessment) kind empirical {
    label en official "the written advice was reasonably relied upon by the taxpayer and was in response to a specific written request of the taxpayer";
}
relation penalty_from_inadequate_taxpayer_information(p: Person, a: Assessment) kind empirical {
    label en official "the portion of the penalty or addition to tax resulted from a failure by the taxpayer to provide adequate or accurate information";
}
relation erroneous_advice_penalty_abated(p: Person, a: Assessment) kind institutional;

@source(IRC_S6404_F, relation = formalizes, coverage = partial, quote = "The Secretary shall abate any portion of any penalty or addition to tax attributable to erroneous advice furnished to the taxpayer in writing by an officer or employee of the Internal Revenue Service, acting in such officer's or employee's official capacity.")
rule S6404MustAbateErroneousAdvicePenalty strict {
    for p: Person;
    for a: Assessment;
    when erroneous_written_advice_furnished(p, a) and advice_reasonably_relied_and_requested_in_writing(p, a)
        and not penalty_from_inadequate_taxpayer_information(p, a);
    then duty AbateErroneousAdvicePenalty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition erroneous_advice_penalty_abated(p, a);
            window [-infinity, infinity];
        }
    };
}

// --- (g): MANDATORY suspension when Secretary fails to timely contact ------

relation timely_return_filed(p: Person, y: TaxableYear, filed: Date, due: Date) kind empirical;
relation secretary_liability_notice_provided_on(p: Person, y: TaxableYear, d: Date) kind empirical {
    label en official "a notice to the taxpayer specifically stating the taxpayer's liability and the basis for the liability";
}
relation suspension_exception_applies(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "one of the §6404(g)(2) exceptions applies (§6651 penalty, fraud, tax shown on the return, gross misstatement, an unqualified reportable/listed transaction, or a criminal penalty) — folded into one guard, not six separate rules";
}
relation interest_and_penalties_suspended(p: Person, y: TaxableYear) kind institutional;

relation suspension_period_start(p: Person, y: TaxableYear, filed: Date, due: Date, start: Date) kind institutional;
rule S6404SuspensionPeriodStartFromFiling strict {
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    for due: Date;
    when timely_return_filed(p, y, filed, due) and filed >= due;
    then suspension_period_start(p, y, filed, due, add_calendar_period(filed, 36 calendar_month));
}
rule S6404SuspensionPeriodStartFromDueDate strict {
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    for due: Date;
    when timely_return_filed(p, y, filed, due) and filed < due;
    then suspension_period_start(p, y, filed, due, add_calendar_period(due, 36 calendar_month));
}

relation secretary_liability_notice_provided(p: Person, y: TaxableYear) kind institutional;
rule S6404SecretaryLiabilityNoticeProvided strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    when secretary_liability_notice_provided_on(p, y, d);
    then secretary_liability_notice_provided(p, y);
}

@source(IRC_S6404_G, relation = formalizes, coverage = partial, quote = "if the Secretary does not provide a notice to the taxpayer specifically stating the taxpayer's liability and the basis for the liability before the close of the 36-month period beginning on the later of—")
rule S6404MustSuspendForLateContact strict {
    for p: Person;
    for y: TaxableYear;
    for filed: Date;
    for due: Date;
    for start: Date;
    when timely_return_filed(p, y, filed, due) and suspension_period_start(p, y, filed, due, start)
        and not_known(secretary_liability_notice_provided(p, y)) and not suspension_exception_applies(p, y);
    then duty SuspendInterestAndPenaltiesForLateContact {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition interest_and_penalties_suspended(p, y);
            window [start, infinity];
        }
    };
}

// ============================================================================
// §6405 — Reports of refunds and credits to the Joint Committee on Taxation
// ============================================================================

relation refund_or_credit_reportable_kind(kind: TaxKind) kind institutional {
    label en unofficial "the tax kind is one §6405(a) lists (income, war profits, excess profits, estate, gift, or chapter 41/42/43/44)";
}
rule S6405IncomeIsReportableKind strict { when true; then refund_or_credit_reportable_kind(us.irc.core::IncomeCh1); }
rule S6405EstateIsReportableKind strict { when true; then refund_or_credit_reportable_kind(us.irc.core::EstateCh11); }
rule S6405GiftIsReportableKind strict { when true; then refund_or_credit_reportable_kind(us.irc.core::GiftCh12); }

relation is_c_corporation(p: Person) kind empirical;
// The threshold is computed inline (`if is_c_corporation(p) then ... else ...`)
// in each consuming rule below rather than as its own relation: a
// stand-alone "not is_c_corporation(p)" rule has no positive occurrence of
// `p` and is refused by range restriction (§190).

relation jct_report_submitted_on(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind empirical {
    label en unofficial "a report giving the name of the person, the amount, and a summary of the facts and the decision of the Secretary, is submitted to the Joint Committee on Taxation";
}
relation refunds_or_credits_without_regard_to_s6411_or_disaster_election(p: Person, y: TaxableYear, kind: TaxKind) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: the refund/credit is made under §6411 (tentative adjustments) or the §165(i) disaster-loss election, which bypass the (a) waiting period under §6405(b)/(c) — §6411 is not owned/imported by this package";
}
relation refund_or_credit_made_on(p: Person, y: TaxableYear, kind: TaxKind, amount: Money, d: Date) kind empirical;

@source(IRC_S6405_A, relation = formalizes, coverage = partial, quote = "No refund or credit of any income, war profits, excess profits, estate, or gift tax, or any tax imposed with respect to public charities, private foundations, operators' trust funds, pension plans, or real estate investment trusts under chapter 41, 42, 43, or 44, in excess of $2,000,000 ($5,000,000 in the case of a C corporation) shall be made until after the expiration of 30 days from the date upon which a report giving the name of the person to whom the refund or credit is to be made, the amount of such refund or credit, and a summary of the facts and the decision of the Secretary, is submitted to the Joint Committee on Taxation.")
rule S6405NoLargeRefundBeforeThirtyDaysAfterReport strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amount: Money;
    for made_on: Date;
    for reported: Date;
    when refund_or_credit_made_on(p, y, kind, amount, made_on) and refund_or_credit_reportable_kind(kind)
        and amount > (if established(is_c_corporation(p)) then 5000000 USD else 2000000 USD)
        and jct_report_submitted_on(p, y, kind, reported)
        and made_on < add_calendar_period(reported, 30 calendar_day)
        and not refunds_or_credits_without_regard_to_s6411_or_disaster_election(p, y, kind);
    then prohibition NoLargeRefundBeforeThirtyDaysAfterJctReport {
        bearer Secretary;
        action refund_or_credit_made_on(p, y, kind, amount, made_on);
        window [-infinity, infinity];
    };
}

relation jct_report_owed(p: Person, y: TaxableYear, kind: TaxKind) kind institutional;
rule S6405ReportOwedAboveThreshold strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amount: Money;
    when refund_or_credit_made_on(p, y, kind, amount, _) and refund_or_credit_reportable_kind(kind)
        and amount > (if established(is_c_corporation(p)) then 5000000 USD else 2000000 USD);
    then jct_report_owed(p, y, kind);
}
@source(IRC_S6405_A, relation = formalizes, coverage = partial, quote = "a report giving the name of the person to whom the refund or credit is to be made, the amount of such refund or credit, and a summary of the facts and the decision of the Secretary, is submitted to the Joint Committee on Taxation")
rule S6405DutyToReportToJct defeasible {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    when jct_report_owed(p, y, kind);
    then duty ReportLargeRefundToJointCommittee {
        bearer Secretary;
        beneficiary us.irc.core::Congress;
        goal achievement {
            condition jct_report_submitted_on(p, y, kind, _);
            window [-infinity, infinity];
        }
    };
    unless refunds_or_credits_without_regard_to_s6411_or_disaster_election(p, y, kind);
}

// ============================================================================
// §6407 — Date of allowance of refund or credit
// ============================================================================

relation overassessment_scheduling_authorized_on(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind empirical {
    label en official "the date on which the Secretary first authorizes the scheduling of an overassessment";
}
pub relation date_of_allowance(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind institutional;
@source(IRC_S6407, relation = formalizes, coverage = exact, quote = "The date on which the Secretary first authorizes the scheduling of an overassessment in respect of any internal revenue tax shall be considered as the date of allowance of refund or credit in respect of such tax.")
rule S6407DateOfAllowance strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for d: Date;
    when overassessment_scheduling_authorized_on(p, y, kind, d)
        and not_known(earlier_overassessment_authorization_exists(p, y, kind, d));
    then date_of_allowance(p, y, kind, d);
}

// ============================================================================
// §6404(h) — Tax Court review of a failure to abate interest (stage 2)
// ============================================================================

relation taxpayer_meets_7430c4A_ii_requirements(p: Person) kind empirical {
    label en official "the taxpayer meets the requirements referred to in section 7430(c)(4)(A)(ii) (net worth and size limits) — dependency contract: `judicial-proceedings`";
}
relation abatement_claim_filed_with_secretary_on(a: Assessment, p: Person, d: Date) kind empirical {
    label en official "the date of the filing with the Secretary (in such form as the Secretary may prescribe) of a claim for abatement under this section";
}
relation final_determination_not_to_abate_mailed_on(a: Assessment, d: Date) kind empirical {
    label en official "the date of the mailing of the Secretary's final determination not to abate such interest";
}
relation files_tax_court_abatement_action(p: Person, a: Assessment) kind empirical;
relation final_determination_mailed_for(a: Assessment) kind institutional { label en unofficial "helper: a final determination not to abate has been mailed"; }
rule S6404hDeterminationMailed strict {
    for a: Assessment;
    for d: Date;
    when final_determination_not_to_abate_mailed_on(a, d);
    then final_determination_mailed_for(a);
}
relation tax_court_action_window_start_candidate(a: Assessment, p: Person, d: Date) kind institutional { label en unofficial "a candidate for the start of the window: the mailing of the final determination, or 180 days after the claim was filed"; }
rule S6404hStartCandidateFromDetermination strict {
    for a: Assessment;
    for p: Person;
    for d: Date;
    for filed: Date;
    when final_determination_not_to_abate_mailed_on(a, d) and abatement_claim_filed_with_secretary_on(a, p, filed);
    then tax_court_action_window_start_candidate(a, p, d);
}
rule S6404hStartCandidateFromFilingPlus180 strict {
    for a: Assessment;
    for p: Person;
    for filed: Date;
    when abatement_claim_filed_with_secretary_on(a, p, filed);
    then tax_court_action_window_start_candidate(a, p, add_calendar_period(filed, 180 calendar_day));
}
relation earlier_tax_court_action_start_exists(a: Assessment, p: Person, d: Date) kind institutional { label en unofficial "helper (TECH-GAPS G136): a strictly earlier candidate exists"; }
rule S6404hEarlierStartExists strict {
    for a: Assessment;
    for p: Person;
    for d: Date;
    for other: Date;
    when tax_court_action_window_start_candidate(a, p, d) and tax_court_action_window_start_candidate(a, p, other) and other < d;
    then earlier_tax_court_action_start_exists(a, p, d);
}
relation tax_court_abatement_window_start(a: Assessment, p: Person, d: Date) kind institutional { label en official "at any time after the earlier of the mailing of the final determination and the date 180 days after the filing of the claim"; }
@source(IRC_S6404_H, relation = formalizes, coverage = exact, quote = "(A) at any time after the earlier of—")
rule S6404hWindowStartIsEarliestCandidate strict {
    for a: Assessment;
    for p: Person;
    for d: Date;
    when tax_court_action_window_start_candidate(a, p, d) and not_known(earlier_tax_court_action_start_exists(a, p, d));
    then tax_court_abatement_window_start(a, p, d);
}
@source(IRC_S6404_H, relation = formalizes, coverage = exact, quote = "The Tax Court shall have jurisdiction over any action brought by a taxpayer who meets the requirements referred to in section 7430(c)(4)(A)(ii) to determine whether the Secretary's failure to abate interest under this section was an abuse of discretion, and may order an abatement, if such action is brought")
@source(IRC_S6404_H, relation = formalizes, coverage = exact, quote = "(B) not later than the date which is 180 days after the date described in subparagraph (A)(i).")
rule S6404hMayBringActionWithinWindow defeasible {
    for a: Assessment;
    for p: Person;
    for start: Date;
    for mailed: Date;
    when taxpayer_meets_7430c4A_ii_requirements(p) and tax_court_abatement_window_start(a, p, start) and final_determination_not_to_abate_mailed_on(a, mailed);
    then liberty MayBringTaxCourtInterestAbatementAction {
        holder p;
        against Secretary;
        action files_tax_court_abatement_action(p, a);
        window [start, add_calendar_period(mailed, 180 calendar_day)];
    };
}
@source(IRC_S6404_H, relation = formalizes, coverage = partial, quote = "(A) at any time after the earlier of—")
rule S6404hMayBringActionNoDeterminationYet defeasible {
    for a: Assessment;
    for p: Person;
    for start: Date;
    when taxpayer_meets_7430c4A_ii_requirements(p) and tax_court_abatement_window_start(a, p, start) and not_known(final_determination_mailed_for(a));
    then liberty MayBringTaxCourtInterestAbatementActionBeforeDetermination {
        holder p;
        against Secretary;
        action files_tax_court_abatement_action(p, a);
        window [start, infinity];
    };
}
