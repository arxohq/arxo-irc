relation compounded_balance_a(principal: Money, rate: Decimal, days: Integer, denominator: Integer, balance: Money) kind institutional { label en official "such interest and such amount shall be compounded daily: the balance after the requested number of days (family A)"; }
rule S6622ASelect1 strict { for principal: Money; for rate: Decimal; for days: Integer; for n: Integer; for bal: Money; when compounding_over_days(principal, rate, days, n) and days == 1 and compound_a_1(principal, rate, n, bal); then compounded_balance_a(principal, rate, days, n, bal); }
rule S6622ASelect2 strict { for principal: Money; for rate: Decimal; for days: Integer; for n: Integer; for bal: Money; when compounding_over_days(principal, rate, days, n) and days == 2 and compound_a_2(principal, rate, n, bal); then compounded_balance_a(principal, rate, days, n, bal); }
