relation compounded_balance_b(principal: Money, rate: Decimal, days: Integer, denominator: Integer, balance: Money) kind institutional { label en official "such interest and such amount shall be compounded daily: the balance after the requested number of days (family B)"; }
rule S6622BSelect1 strict { for principal: Money; for rate: Decimal; for days: Integer; for n: Integer; for bal: Money; when compound_b_request(principal, rate, days, n) and days == 1 and compound_b_1(principal, rate, n, bal); then compounded_balance_b(principal, rate, days, n, bal); }
