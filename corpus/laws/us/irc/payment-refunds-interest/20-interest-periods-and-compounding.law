rule S6622BDay1 strict { for principal: Money; for rate: Decimal; for n: Integer; when compound_b_seed(principal, rate, n) and principal > 0 USD; then compound_b_1(principal, rate, n, round(principal * (1.0 + (rate / 100.0 / (n * 1.0))), 2, "HALF_UP")); }
rule S6622BDay2 strict { for principal: Money; for rate: Decimal; for n: Integer; for prev: Money; when compound_b_1(principal, rate, n, prev); then compound_b_2(principal, rate, n, round(prev * (1.0 + (rate / 100.0 / (n * 1.0))), 2, "HALF_UP")); }
rule S6622BDay3 strict { for principal: Money; for rate: Decimal; for n: Integer; for prev: Money; when compound_b_2(principal, rate, n, prev); then compound_b_3(principal, rate, n, round(prev * (1.0 + (rate / 100.0 / (n * 1.0))), 2, "HALF_UP")); }
