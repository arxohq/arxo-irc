// Stage 3 (26.09.2026) — interest: the last date for payment of section
// 6601(b)(2)-(4) and the credit rule of (f); the overpayment periods of section
// 6611(b)(1)-(2) and (e)(2)-(3) and the processible-form gate of (g); the
// applicable date and exceptions of section 6621(c)(2)-(3); section 6622 daily
// compounding chained over a day count.
//
// JUDGMENT CALLS AND GAPS
//  - 6622: the statute says only "compounded daily". The daily step is the
//    stage-1 convention (balance x (1 + annual rate / days in the year), rounded
//    to cents each day); the denominator (365 or 366) is an input of the
//    request. Chaining is unrolled: a distinct relation per day, 1 to 92 days
//    for one constant-rate segment (a quarter is at most 92 days) and a second
//    segment after a rate change; a period over more than two segments is not
//    derived (recursion over one relation is LDC-E4102, TECH-GAPS G5806).
//  - 6621(c)(2): the applicable date is the 30th day after the earliest counting
//    letter or notice; a quarter is treated as "after the applicable date" when
//    it begins on or after that date (a straddling quarter is not split).
//  - 6611(g): a return not in processible form is treated as filed on the date
//    it became processible (asserted); a return with no processible facts keeps
//    its filing date (the stage-1 behavior).

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6601_B,
    IRC_S6601_F,
    IRC_S6611_B,
    IRC_S6611_E,
    IRC_S6611_G,
    IRC_S6621_C,
    IRC_S6622_A,
    Person,
    Return,
    TaxKind,
    TaxableYear,
    federal_short_term_rate,
    large_corporate_underpayment_rate_applies,
    last_date_prescribed_for_payment,
    notice_and_demand_made_on,
    overpayment_is_withholding_tax,
    overpayment_refunded_on,
    underpayment_amount,
};

// ============================================================================
// §6601(b)(2)-(4), (f)
// ============================================================================

relation jeopardy_notice_and_demand_on(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind empirical { label en official "a notice and demand for payment issued by reason of jeopardy (chapter 70)"; }
relation last_date_unaffected_by_jeopardy_demand(p: Person, y: TaxableYear, kind: TaxKind, last: Date) kind institutional { label en official "the last date prescribed for payment is determined without regard to a jeopardy notice and demand issued prior to the last date otherwise prescribed"; }
@source(IRC_S6601_B, relation = formalizes, coverage = exact, quote = "The last date prescribed for payment shall be determined without regard to any notice and demand for payment issued, by reason of jeopardy (as provided in chapter 70), prior to the last date otherwise prescribed for such payment.")
rule S6601B2JeopardyDisregarded strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for jd: Date;
    for last: Date;
    when jeopardy_notice_and_demand_on(p, y, kind, jd) and last_date_prescribed_for_payment(p, y, kind, last) and jd < last;
    then last_date_unaffected_by_jeopardy_demand(p, y, kind, last);
}
relation accumulated_earnings_tax_531(p: Person, y: TaxableYear, kind: TaxKind) kind empirical { label en official "the tax is the accumulated earnings tax imposed by section 531 for the taxable year"; }
@source(IRC_S6601_B, relation = formalizes, coverage = exact, quote = "the last date prescribed for payment shall be deemed to be the due date (without regard to extensions) for the return of tax imposed by subtitle A for such taxable year")
rule S6601B3AccumulatedEarningsLastDate strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for r: Return;
    for d: Date;
    when accumulated_earnings_tax_531(p, y, kind) and us.irc.core::return_of(r, p, y, us.irc.core::IncomeCh1) and us.irc.core::due_date(r, d);
    then last_date_prescribed_for_payment(p, y, kind, d);
}
relation last_date_not_otherwise_prescribed(p: Person, y: TaxableYear, kind: TaxKind) kind empirical { label en official "taxes payable by stamp and all other cases in which the last date for payment is not otherwise prescribed"; }
relation liability_arises_on(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind empirical { label en official "the date the liability for tax arises"; }
relation notice_and_demand_stated(p: Person, y: TaxableYear, kind: TaxKind) kind institutional { label en unofficial "helper: a notice and demand date is stated"; }
rule S6601B4NoticeStated strict { for p: Person; for y: TaxableYear; for kind: TaxKind; for d: Date; when notice_and_demand_made_on(p, y, kind, d); then notice_and_demand_stated(p, y, kind); }
@source(IRC_S6601_B, relation = formalizes, coverage = partial, quote = "the last date for payment shall be deemed to be the date the liability for tax arises")
rule S6601B4LastDateLiabilityArises strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for arises: Date;
    for nd: Date;
    when last_date_not_otherwise_prescribed(p, y, kind) and liability_arises_on(p, y, kind, arises) and notice_and_demand_made_on(p, y, kind, nd) and arises <= nd;
    then last_date_prescribed_for_payment(p, y, kind, arises);
}
@source(IRC_S6601_B, relation = formalizes, coverage = partial, quote = "(and in no event shall be later than the date notice and demand for the tax is made by the Secretary)")
rule S6601B4LastDateCappedAtNotice strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for arises: Date;
    for nd: Date;
    when last_date_not_otherwise_prescribed(p, y, kind) and liability_arises_on(p, y, kind, arises) and notice_and_demand_made_on(p, y, kind, nd) and arises > nd;
    then last_date_prescribed_for_payment(p, y, kind, nd);
}
rule S6601B4LastDateNoNotice strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for arises: Date;
    when last_date_not_otherwise_prescribed(p, y, kind) and liability_arises_on(p, y, kind, arises) and not_known(notice_and_demand_stated(p, y, kind));
    then last_date_prescribed_for_payment(p, y, kind, arises);
}
// (f): satisfaction by credits.
relation portion_satisfied_by_credit(p: Person, y: TaxableYear, kind: TaxKind, amount: Money, credit_date: Date) kind empirical { label en official "a portion of the tax is satisfied by credit of an overpayment on the date"; }
relation credited_overpayment_date(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind empirical { label en official "the date of the overpayment credited: interest would have been allowable on it from this date if the credit had not been made"; }
relation section_6621d_applies_to_credit(p: Person, y: TaxableYear, kind: TaxKind) kind empirical { label en official "section 6621(d) (net rate of zero) applies to the credited portion"; }
relation credit_interest_free_start(p: Person, y: TaxableYear, kind: TaxKind, from: Date) kind institutional { label en official "the later of the last date prescribed for payment and the date of the credited overpayment"; }
rule S6601FStartLast strict { for p: Person; for y: TaxableYear; for kind: TaxKind; for last: Date; for od: Date; when last_date_prescribed_for_payment(p, y, kind, last) and credited_overpayment_date(p, y, kind, od) and last >= od; then credit_interest_free_start(p, y, kind, last); }
rule S6601FStartOverpayment strict { for p: Person; for y: TaxableYear; for kind: TaxKind; for last: Date; for od: Date; when last_date_prescribed_for_payment(p, y, kind, last) and credited_overpayment_date(p, y, kind, od) and od > last; then credit_interest_free_start(p, y, kind, od); }
relation credited_portion_interest_free(p: Person, y: TaxableYear, kind: TaxKind, amount: Money, from: Date, to: Date) kind institutional { label en official "no interest under section 6601 on the portion satisfied by credit for a period during which interest would have been allowable on the overpayment if the credit had not been made"; }
@source(IRC_S6601_F, relation = formalizes, coverage = exact, quote = "then no interest shall be imposed under this section on the portion of the tax so satisfied for any period during which, if the credit had not been made, interest would have been allowable with respect to such overpayment")
rule S6601FCreditedPortionInterestFree strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amount: Money;
    for credited: Date;
    for from: Date;
    when portion_satisfied_by_credit(p, y, kind, amount, credited) and credit_interest_free_start(p, y, kind, from) and from <= credited and not_known(section_6621d_applies_to_credit(p, y, kind));
    then credited_portion_interest_free(p, y, kind, amount, from, credited);
}

// ============================================================================
// §6611(b)(1)-(2), (e)(2)-(3), (g)
// ============================================================================

relation overpayment_date_of(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind empirical { label en official "the date of the overpayment"; }
relation credit_taken_against_due_date(p: Person, y: TaxableYear, kind: TaxKind, due: Date) kind empirical { label en official "the due date of the amount against which the credit is taken"; }
relation refund_check_date(p: Person, y: TaxableYear, kind: TaxKind, d: Date) kind empirical { label en official "the date of the refund check"; }
relation secretary_interest_end_date(p: Person, y: TaxableYear, kind: TaxKind, e: Date) kind empirical { label en official "the date determined by the Secretary to which interest on a refund runs"; }
relation overpayment_interest_period(p: Person, y: TaxableYear, kind: TaxKind, from: Date, to: Date) kind institutional { label en official "the period for which interest is allowed and paid on the overpayment"; }
@source(IRC_S6611_B, relation = formalizes, coverage = exact, quote = "In the case of a credit, from the date of the overpayment to the due date of the amount against which the credit is taken.")
rule S6611B1CreditPeriod strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for od: Date;
    for due: Date;
    when overpayment_date_of(p, y, kind, od) and credit_taken_against_due_date(p, y, kind, due);
    then overpayment_interest_period(p, y, kind, od, due);
}
@source(IRC_S6611_B, relation = formalizes, coverage = exact, quote = "from the date of the overpayment to a date (to be determined by the Secretary) preceding the date of the refund check by not more than 30 days")
rule S6611B2RefundPeriod strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for od: Date;
    for check: Date;
    for e: Date;
    for calendar_before_1: Date;
    when overpayment_date_of(p, y, kind, od) and refund_check_date(p, y, kind, check) and secretary_interest_end_date(p, y, kind, e) and e <= check and e >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(check, 30, us.irc.core::CalendarDay, calendar_before_1);
    then overpayment_interest_period(p, y, kind, od, e);
}
relation refund_check_acceptance_without_prejudice(p: Person, y: TaxableYear, kind: TaxKind) kind institutional { label en official "the acceptance of a refund check (whether or not accepted after tender) is without prejudice to any right of the taxpayer to claim any additional overpayment and interest thereon"; }
@source(IRC_S6611_B, relation = formalizes, coverage = exact, quote = "The acceptance of such check shall be without prejudice to any right of the taxpayer to claim any additional overpayment and interest thereon.")
rule S6611B2WithoutPrejudice strict { for p: Person; for y: TaxableYear; for kind: TaxKind; for check: Date; when refund_check_date(p, y, kind, check); then refund_check_acceptance_without_prejudice(p, y, kind); }
// (e)(2): a refund after a claim within 45 (180) days.
relation refund_claim_filed_on(p: Person, y: TaxableYear, kind: TaxKind, claim_date: Date) kind empirical { label en official "the taxpayer files a claim for a credit or refund for the overpayment"; }
relation no_interest_from_claim_to_refund(p: Person, y: TaxableYear, kind: TaxKind, from: Date, to: Date) kind institutional { label en official "no interest is allowed from the date the claim is filed until the day the refund is made"; }
@source(IRC_S6611_E, relation = formalizes, coverage = exact, quote = "no interest shall be allowed on such overpayment from the date the claim is filed until the day the refund is made")
rule S6611E2ClaimRefundedWithin45 strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for claim_date: Date;
    for refunded: Date;
    when refund_claim_filed_on(p, y, kind, claim_date) and overpayment_refunded_on(p, y, kind, refunded) and not_known(overpayment_is_withholding_tax(p, y, kind)) and refunded <= add_calendar_period(claim_date, 45 calendar_day);
    then no_interest_from_claim_to_refund(p, y, kind, claim_date, refunded);
}
@source(IRC_S6611_E, relation = formalizes, coverage = partial, quote = "paragraphs (1), (2), and (3) shall be applied by substituting \"180 days\" for \"45 days\" each place it appears")
rule S6611E2ClaimRefundedWithin180Withholding strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for claim_date: Date;
    for refunded: Date;
    when refund_claim_filed_on(p, y, kind, claim_date) and overpayment_refunded_on(p, y, kind, refunded) and overpayment_is_withholding_tax(p, y, kind) and refunded <= add_calendar_period(claim_date, 180 calendar_day);
    then no_interest_from_claim_to_refund(p, y, kind, claim_date, refunded);
}
// (e)(3): an adjustment initiated by the Secretary.
relation irs_initiated_adjustment(p: Person, y: TaxableYear, kind: TaxKind) kind empirical { label en official "an adjustment initiated by the Secretary results in a refund or credit of an overpayment"; }
relation interest_days_otherwise_allowed(p: Person, y: TaxableYear, kind: TaxKind, days: Integer) kind empirical { label en official "the number of days interest would otherwise be allowed with respect to the overpayment"; }
relation interest_days_after_irs_adjustment(p: Person, y: TaxableYear, kind: TaxKind, days: Integer) kind institutional { label en official "interest is computed by subtracting 45 days (180 days for chapter 3 or 4 withholding) from the number of days interest would otherwise be allowed"; }
@source(IRC_S6611_E, relation = formalizes, coverage = exact, quote = "interest on such overpayment shall be computed by subtracting 45 days from the number of days interest would otherwise be allowed with respect to such overpayment")
rule S6611E3SubtractFortyFive strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for n: Integer;
    when irs_initiated_adjustment(p, y, kind) and interest_days_otherwise_allowed(p, y, kind, n) and not_known(overpayment_is_withholding_tax(p, y, kind));
    then interest_days_after_irs_adjustment(p, y, kind, max(0, n - 45));
}
rule S6611E3SubtractOneEighty strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for n: Integer;
    when irs_initiated_adjustment(p, y, kind) and interest_days_otherwise_allowed(p, y, kind, n) and overpayment_is_withholding_tax(p, y, kind);
    then interest_days_after_irs_adjustment(p, y, kind, max(0, n - 180));
}
// (g): no interest until the return is in processible form.
relation return_on_permitted_form(r: Return) kind empirical { label en official "the return is filed on a permitted form"; }
relation return_has_identity_and_signature(r: Return) kind empirical { label en official "the return contains the taxpayer's name, address, and identifying number and the required signature"; }
relation return_has_information_for_math_verification(r: Return) kind empirical { label en official "the return contains sufficient required information (on the return or on required attachments) to permit the mathematical verification of the tax liability shown on it"; }
relation return_processible(r: Return) kind institutional { label en official "the return is in processible form"; }
@source(IRC_S6611_G, relation = formalizes, coverage = exact, quote = "a return is in a processible form if—")
rule S6611G2Processible strict {
    for r: Return;
    when return_on_permitted_form(r) and return_has_identity_and_signature(r) and return_has_information_for_math_verification(r);
    then return_processible(r);
}
relation return_became_processible_on(r: Return, d: Date) kind empirical { label en official "the date the return was first in processible form, when that is after the date it was filed"; }
relation processible_facts_stated(r: Return) kind institutional { label en unofficial "helper: some processible-form fact is stated for the return"; }
rule S6611GFactsStated1 strict { for r: Return; when return_on_permitted_form(r); then processible_facts_stated(r); }
rule S6611GFactsStated2 strict { for r: Return; when return_has_identity_and_signature(r); then processible_facts_stated(r); }
rule S6611GFactsStated3 strict { for r: Return; when return_has_information_for_math_verification(r); then processible_facts_stated(r); }
relation treated_as_filed_for_6611(r: Return, d: Date) kind institutional { label en official "the date the return is treated as filed for subsections (b)(3) and (e): the date it is filed in processible form"; }
@source(IRC_S6611_G, relation = formalizes, coverage = exact, quote = "a return shall not be treated as filed until it is filed in processible form")
rule S6611G1FiledProcessible strict {
    for r: Return;
    for d: Date;
    when us.irc.core::filed_on(r, d) and return_processible(r);
    then treated_as_filed_for_6611(r, d);
}
rule S6611G1LaterProcessible strict {
    for r: Return;
    for d: Date;
    for filed: Date;
    when us.irc.core::filed_on(r, filed) and return_became_processible_on(r, d) and not_known(return_processible(r));
    then treated_as_filed_for_6611(r, d);
}
rule S6611G1NoProcessibleFacts strict {
    for r: Return;
    for d: Date;
    when us.irc.core::filed_on(r, d) and not_known(processible_facts_stated(r)) and not_known(return_became_processible_on_stated(r));
    then treated_as_filed_for_6611(r, d);
}
relation return_became_processible_on_stated(r: Return) kind institutional { label en unofficial "helper: a later processible date is stated"; }
rule S6611GLaterStated strict { for r: Return; for d: Date; when return_became_processible_on(r, d); then return_became_processible_on_stated(r); }

// ============================================================================
// §6621(c)(2)-(3) applicable date and large corporate underpayment
// ============================================================================

entity DeficiencyLetter6621 { label en unofficial "a letter or notice that may fix the applicable date of section 6621(c)(2)"; }
enum DeficiencyLetterKind {
    ProposedDeficiencyLetterWithAppealsReview;
    DeficiencyNoticeSection6212;
    NondeficiencyAssessmentNotice;
    label en official "§6621(c)(2)(A)(i) the first letter of proposed deficiency allowing administrative review in the Independent Office of Appeals; (ii) the deficiency notice under section 6212; (B)(i) a letter or notice of assessment or proposed assessment where the deficiency procedures do not apply";
}
relation letter_of_taxpayer(l: DeficiencyLetter6621, p: Person) kind empirical;
relation letter_kind(l: DeficiencyLetter6621, k: DeficiencyLetterKind) kind empirical;
relation letter_sent_on(l: DeficiencyLetter6621, d: Date) kind empirical;
relation letter_withdrawn_by_secretary(l: DeficiencyLetter6621) kind empirical { label en official "the letter or notice is withdrawn by the Secretary"; }
relation letter_amount_of_deficiency(l: DeficiencyLetter6621, amount: Money) kind empirical { label en official "the amount of the deficiency or proposed deficiency (or assessment or proposed assessment) set forth, not taking into account interest, penalties or additions to tax"; }
relation letter_amount_shown_as_due(l: DeficiencyLetter6621, amount: Money) kind empirical { label en official "the amount shown as due in the letter or notice"; }
relation payment_after_letter(l: DeficiencyLetter6621, amount: Money, paid_on: Date) kind empirical { label en official "a payment made by the taxpayer after the letter or notice"; }
relation letter_relates_to_deficiency_procedures(l: DeficiencyLetter6621) kind empirical { label en official "the deficiency procedures apply to the underpayment"; }
relation letter_disregarded_for_payment_in_full(l: DeficiencyLetter6621) kind institutional { label en official "a letter or notice is disregarded if, during the 30-day period beginning on the day it was sent, the taxpayer makes a payment equal to the amount shown as due"; }
@source(IRC_S6621_C, relation = formalizes, coverage = exact, quote = "a letter or notice shall be disregarded if, during the 30-day period beginning on the day on which it was sent, the taxpayer makes a payment equal to the amount shown as due in such letter or notice, as the case may be")
rule S6621C2BiiPaidInFull strict {
    for l: DeficiencyLetter6621;
    for sent: Date;
    for due: Money;
    for paid: Money;
    for paid_on: Date;
    when letter_sent_on(l, sent) and letter_amount_shown_as_due(l, due) and payment_after_letter(l, paid, paid_on) and paid >= due and paid_on <= add_calendar_period(sent, 29 calendar_day);
    then letter_disregarded_for_payment_in_full(l);
}
relation letter_disregarded_small_amount(l: DeficiencyLetter6621) kind institutional { label en official "a letter or notice is disregarded if the amount of the deficiency or proposed deficiency set forth in it is not greater than $100,000"; }
@source(IRC_S6621_C, relation = formalizes, coverage = exact, quote = "is not greater than $100,000 (determined by not taking into account any interest, penalties, or additions to tax)")
rule S6621C2BiiiSmallAmount strict { for l: DeficiencyLetter6621; for a: Money; when letter_amount_of_deficiency(l, a) and a <= 100000 USD; then letter_disregarded_small_amount(l); }
relation letter_counts_for_applicable_date(l: DeficiencyLetter6621, p: Person, sent: Date) kind institutional { label en official "a letter or notice that is not withdrawn and not disregarded, and whose kind fits the procedure"; }
@source(IRC_S6621_C, relation = formalizes, coverage = partial, quote = "The preceding sentence shall be applied without regard to any such letter or notice which is withdrawn by the Secretary.")
rule S6621C2ACountingProposedLetter strict {
    for l: DeficiencyLetter6621;
    for p: Person;
    for sent: Date;
    when letter_of_taxpayer(l, p) and letter_kind(l, ProposedDeficiencyLetterWithAppealsReview) and letter_sent_on(l, sent) and not_known(letter_withdrawn_by_secretary(l)) and not_known(letter_disregarded_for_payment_in_full(l)) and not_known(letter_disregarded_small_amount(l));
    then letter_counts_for_applicable_date(l, p, sent);
}
rule S6621C2ACountingDeficiencyNotice strict {
    for l: DeficiencyLetter6621;
    for p: Person;
    for sent: Date;
    when letter_of_taxpayer(l, p) and letter_kind(l, DeficiencyNoticeSection6212) and letter_sent_on(l, sent) and not_known(letter_withdrawn_by_secretary(l)) and not_known(letter_disregarded_for_payment_in_full(l)) and not_known(letter_disregarded_small_amount(l));
    then letter_counts_for_applicable_date(l, p, sent);
}
@source(IRC_S6621_C, relation = formalizes, coverage = partial, quote = "subparagraph (A) shall be applied by taking into account any letter or notice provided by the Secretary which notifies the taxpayer of the assessment or proposed assessment of the tax")
rule S6621C2BiNondeficiency strict {
    for l: DeficiencyLetter6621;
    for p: Person;
    for sent: Date;
    when letter_of_taxpayer(l, p) and letter_kind(l, NondeficiencyAssessmentNotice) and letter_sent_on(l, sent) and not_known(letter_relates_to_deficiency_procedures(l)) and not_known(letter_withdrawn_by_secretary(l)) and not_known(letter_disregarded_for_payment_in_full(l)) and not_known(letter_disregarded_small_amount(l));
    then letter_counts_for_applicable_date(l, p, sent);
}
relation earlier_counting_letter_exists(p: Person, sent: Date) kind institutional { label en unofficial "helper: a strictly earlier counting letter exists (TECH-GAPS G136 idiom)"; }
rule S6621C2AEarlierExists strict { for p: Person; for l1: DeficiencyLetter6621; for l2: DeficiencyLetter6621; for s1: Date; for s2: Date; when letter_counts_for_applicable_date(l1, p, s1) and letter_counts_for_applicable_date(l2, p, s2) and s2 < s1; then earlier_counting_letter_exists(p, s1); }
relation applicable_date_6621c2(p: Person, applicable: Date) kind institutional { label en official "the applicable date: the 30th day after the earlier counting letter or notice"; }
@source(IRC_S6621_C, relation = formalizes, coverage = exact, quote = "The applicable date is the 30th day after the earlier of—")
rule S6621C2AApplicableDate strict {
    for p: Person;
    for l: DeficiencyLetter6621;
    for sent: Date;
    when letter_counts_for_applicable_date(l, p, sent) and not_known(earlier_counting_letter_exists(p, sent));
    then applicable_date_6621c2(p, add_calendar_period(sent, 30 calendar_day));
}
relation applicable_date_reached_by_quarter(p: Person, quarter_start: Date) kind institutional { label en official "the quarter begins on or after the applicable date, so the large corporate underpayment rate applies for it"; }
rule S6621C1QuarterAfterApplicableDate strict {
    for p: Person;
    for applicable: Date;
    for quarter_start: Date;
    when applicable_date_6621c2(p, applicable) and federal_short_term_rate(quarter_start, _) and quarter_start >= applicable;
    then applicable_date_reached_by_quarter(p, quarter_start);
}
relation is_c_corporation_for_6621(p: Person) kind empirical { label en official "the taxpayer is a C corporation"; }
relation large_corporate_underpayment_for_period(p: Person, y: TaxableYear, kind: TaxKind) kind institutional { label en official "an underpayment of a tax by a C corporation for a taxable period exceeding $100,000; the taxable period is the taxable year for a subtitle A tax, and otherwise the period to which the underpayment relates"; }
@source(IRC_S6621_C, relation = formalizes, coverage = exact, quote = "The term \"large corporate underpayment\" means any underpayment of a tax by a C corporation for any taxable period if the amount of such underpayment for such period exceeds $100,000.")
rule S6621C3LargeCorporateUnderpayment strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amount: Money;
    when is_c_corporation_for_6621(p) and underpayment_amount(p, y, kind, amount) and amount > 100000 USD;
    then large_corporate_underpayment_for_period(p, y, kind);
}
relation large_corporate_underpayment_rate_applies_derived(p: Person, y: TaxableYear, kind: TaxKind, quarter_start: Date) kind institutional { label en official "the 5-percentage-point rate applies to a large corporate underpayment for a quarter after the applicable date"; }
rule S6621C1RateAppliesDerived strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for quarter_start: Date;
    when large_corporate_underpayment_for_period(p, y, kind) and applicable_date_reached_by_quarter(p, quarter_start);
    then large_corporate_underpayment_rate_applies_derived(p, y, kind, quarter_start);
}
@source(IRC_S6621_C, relation = formalizes, coverage = partial, quote = "on any large corporate underpayment for periods after the applicable date")
rule S6621C1AppliesFromLetters strict {
    label en official "the section 6621(c)(1) rate applies from the applicable date derived from the letters and notices; 06-interest.law then substitutes 5 percentage points for 3";
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for quarter_start: Date;
    when large_corporate_underpayment_rate_applies_derived(p, y, kind, quarter_start);
    then large_corporate_underpayment_rate_applies(p, quarter_start);
}

// ============================================================================
// §6622 daily compounding chained over a day count (families A and B)
// ============================================================================

relation compounding_over_days(principal: Money, annual_rate_percent: Decimal, days: Integer, denominator: Integer) kind empirical { label en unofficial "a request: compound the principal daily at the annual rate for the given number of days (1 to 92), the denominator being the days in the year (365 or 366)"; }
relation compounding_two_segments(principal: Money, rate1: Decimal, days1: Integer, rate2: Decimal, days2: Integer, denominator: Integer) kind empirical { label en unofficial "a request: compound over two consecutive segments at different annual rates (a change of the section 6621 rate), the balance at the end of the first segment being the principal of the second"; }

