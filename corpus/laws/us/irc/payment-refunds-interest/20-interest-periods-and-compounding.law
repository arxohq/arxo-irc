relation compound_b_seed(principal: Money, rate: Decimal, denominator: Integer) kind institutional { label en unofficial "the second segment starts from the balance at the end of the first"; }
relation compound_b_request(principal: Money, rate: Decimal, days: Integer, denominator: Integer) kind institutional { label en unofficial "the second segment request"; }
rule S6622SecondSegmentRequest strict { for p0: Money; for r1: Decimal; for d1: Integer; for r2: Decimal; for d2: Integer; for n: Integer; for mid: Money; when compounding_two_segments(p0, r1, d1, r2, d2, n) and compounded_balance_a(p0, r1, d1, n, mid); then compound_b_request(mid, r2, d2, n); }
rule S6622SecondSegmentSeed strict { for p0: Money; for r1: Decimal; for d1: Integer; for r2: Decimal; for d2: Integer; for n: Integer; for mid: Money; when compounding_two_segments(p0, r1, d1, r2, d2, n) and compounded_balance_a(p0, r1, d1, n, mid); then compound_b_seed(mid, r2, n); }
relation compounded_balance_two_segments(principal: Money, rate1: Decimal, days1: Integer, rate2: Decimal, days2: Integer, denominator: Integer, balance: Money) kind institutional { label en official "the balance after compounding daily over two consecutive segments at different rates"; }
@source(IRC_S6622_A, relation = formalizes, coverage = partial, quote = "such interest and such amount shall be compounded daily")
rule S6622TwoSegmentsBalance strict { for p0: Money; for r1: Decimal; for d1: Integer; for r2: Decimal; for d2: Integer; for n: Integer; for mid: Money; for fin: Money; when compounding_two_segments(p0, r1, d1, r2, d2, n) and compounded_balance_a(p0, r1, d1, n, mid) and compounded_balance_b(mid, r2, d2, n, fin); then compounded_balance_two_segments(p0, r1, d1, r2, d2, n, fin); }
