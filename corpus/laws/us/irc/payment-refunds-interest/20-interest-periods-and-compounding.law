rule S6622ADay1 strict { for principal: Money; for rate: Decimal; for n: Integer; when compounding_over_days(principal, rate, _, n) and principal > 0 USD; then compound_a_1(principal, rate, n, round(principal * (1.0 + (rate / 100.0 / (n * 1.0))), 2, "HALF_UP")); }
rule S6622ADay2 strict { for principal: Money; for rate: Decimal; for n: Integer; for prev: Money; when compound_a_1(principal, rate, n, prev); then compound_a_2(principal, rate, n, round(prev * (1.0 + (rate / 100.0 / (n * 1.0))), 2, "HALF_UP")); }
rule S6622ADay3 strict { for principal: Money; for rate: Decimal; for n: Integer; for prev: Money; when compound_a_2(principal, rate, n, prev); then compound_a_3(principal, rate, n, round(prev * (1.0 + (rate / 100.0 / (n * 1.0))), 2, "HALF_UP")); }
rule S6622ADay4 strict { for principal: Money; for rate: Decimal; for n: Integer; for prev: Money; when compound_a_3(principal, rate, n, prev); then compound_a_4(principal, rate, n, round(prev * (1.0 + (rate / 100.0 / (n * 1.0))), 2, "HALF_UP")); }
