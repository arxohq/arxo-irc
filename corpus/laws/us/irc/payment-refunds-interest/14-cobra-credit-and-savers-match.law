// 26 U.S.C. §§6432 and 6433 — continuation coverage premium assistance credit
// (§6432, American Rescue Plan Act of 2021 sec. 9501) and the Saver's Match
// (§6433, SECURE 2.0 Act of 2022 sec. 103). Stage 2. Chapter 65, Subchapter B.
//
// JUDGMENT CALLS AND GAPS
//  - §6432 applies to premiums to which ARPA §9501(a)(1)(A) applies and wages
//    paid on or after 2021-04-01 (statutory note): the boundary is a date
//    rule (`effective`). The assistance-eligible premium amounts, the payroll
//    taxes (§3111(b), §3221(a)) and the §3131/3132/3134 credits are case
//    facts / dependency contracts (`employment`, `credits`).
//  - §6433 applies to taxable years beginning after 2026-12-31 (Pub. L.
//    117-328 sec. 103(f)): a year-begin condition. Its dollar figures ($2,000
//    cap, $41,000 applicable dollar amount, $30,000 phase-out range, $100
//    threshold, 50 percent) are A3 datasets valid from 2027-01-01.
//  - The applicable percentage reduces by whole percentage points: the
//    reduction is 50 x (MAGI - applicable dollar amount) / phase-out range,
//    rounded DOWN ("rounded to the next lowest whole percentage point").
//    The quotient is formed as an exact fraction of two money amounts.
//  - §6433(h) (inflation adjustment for years after 2027) needs the
//    section 1(f)(3) cost-of-living adjustment with a 2026 base: no value is
//    pinned; the adjustment is a case fact (`cost_of_living_adjustment_6433h`)
//    and the rounding to the nearest $1,000 is executable (HALF_UP:
//    JUDGMENT CALL — the text does not say how ties round). SOURCE_GAP.
//  - The distribution testing period of (d)(2) needs the two preceding
//    taxable years and the due date including extensions as case facts.
//  - Reduction of contributions by distributions aggregates over a derived
//    relation (`counted_distribution_6433`): a runtime subset limitation
//    (§111) — the aggregate is taken over the ASSERTED distributions and
//    the testing-period filter is applied by a per-distribution rule; see
//    TECH-GAPS G2628.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6432_A,
    IRC_S6432_B,
    IRC_S6432_C,
    IRC_S6432_D,
    IRC_S6432_E,
    IRC_S6432_F,
    IRC_S6433_A,
    IRC_S6433_B,
    IRC_S6433_C,
    IRC_S6433_D,
    IRC_S6433_E,
    IRC_S6433_F,
    IRC_S6433_G,
    IRC_S6433_H,
    IRC_S6433_NOTE_4,
    Period,
    Person,
    RebateFilingStatus,
    Secretary,
    TaxableYear,
    dependency_deduction_allowable_to_another,
};

// ============================================================================
// §6432 — Continuation coverage premium assistance
// ============================================================================

relation assistance_eligible_premiums_unpaid(p: Person, quarter: Period, amount: Money) kind empirical {
    label en official "the premiums not paid by assistance eligible individuals for continuation coverage by reason of section 9501(a)(1) of the American Rescue Plan Act of 2021 with respect to the calendar quarter";
}
relation premiums_payable_to(p: Person, quarter: Period) kind empirical { label en official "the person to whom premiums are payable for continuation coverage"; }
relation quarter_starts_on_or_after_2021_04_01(quarter: Period) kind institutional { label en official "premiums and wages paid on or after April 1, 2021 (Pub. L. 117-2 sec. 9501(b)(1)(C))"; }
relation payroll_tax_for_quarter_6432(p: Person, quarter: Period, amount: Money) kind empirical {
    label en official "the tax imposed by section 3111(b), or so much of the taxes imposed under section 3221(a) as are attributable to the rate in effect under section 3111(b), on the wages paid with respect to the employment of all employees of the employer for the quarter — dependency contract: `employment`";
}
relation payroll_credits_3131_3132_3134(p: Person, quarter: Period, amount: Money) kind empirical { label en official "any credits allowed against such taxes under sections 3131, 3132, and 3134"; }
relation credit_amount_taken_into_account_as_double_benefit(p: Person, quarter: Period, amount: Money) kind empirical {
    label en official "an amount taken into account as qualified wages under section 2301 of the CARES Act or section 3134 or as qualified health plan expenses under section 7001(d) or 7003(d) of the Families First Coronavirus Response Act or section 3131 or 3132";
}
pub relation cobra_credit_before_limitation(p: Person, quarter: Period, amount: Money) kind institutional {
    label en official "a credit equal to the premiums not paid by assistance eligible individuals for the quarter, less any amount taken into account under another provision";
}
relation cobra_double_benefit_amount(p: Person, quarter: Period, amount: Money) kind institutional { label en unofficial "the double-benefit amount for the quarter (0 when none is asserted)"; }
rule S6432DoubleBenefitAsserted strict {
    for p: Person;
    for quarter: Period;
    for amt: Money;
    when credit_amount_taken_into_account_as_double_benefit(p, quarter, amt);
    then cobra_double_benefit_amount(p, quarter, amt);
}
relation cobra_double_benefit_stated(p: Person, quarter: Period) kind institutional { label en unofficial "helper: a double-benefit amount is asserted for the quarter"; }
rule S6432DoubleBenefitStated strict {
    for p: Person;
    for quarter: Period;
    for amt: Money;
    when credit_amount_taken_into_account_as_double_benefit(p, quarter, amt);
    then cobra_double_benefit_stated(p, quarter);
}
rule S6432NoDoubleBenefit strict {
    for p: Person;
    for quarter: Period;
    for amt: Money;
    when assistance_eligible_premiums_unpaid(p, quarter, amt) and not_known(cobra_double_benefit_stated(p, quarter));
    then cobra_double_benefit_amount(p, quarter, 0 USD);
}
@source(IRC_S6432_A, relation = formalizes, coverage = exact, quote = "shall be allowed as a credit against the tax imposed by section 3111(b), or so much of the taxes imposed under section 3221(a) as are attributable to the rate in effect under section 3111(b), for each calendar quarter an amount equal to the premiums not paid by assistance eligible individuals")
@source(IRC_S6432_E, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under this section with respect to any amount which is taken into account as qualified wages under section 2301 of the CARES Act")
rule S6432CreditIsUnpaidPremiums strict {
    effective [@2021-04-01, infinity);
    for p: Person;
    for quarter: Period;
    for premiums: Money;
    for double: Money;
    when premiums_payable_to(p, quarter) and assistance_eligible_premiums_unpaid(p, quarter, premiums) and cobra_double_benefit_amount(p, quarter, double);
    then cobra_credit_before_limitation(p, quarter, max(0 USD, premiums - double));
}
// (b): who is the person to whom premiums are payable.
enum PremiumPayeeKind { MultiemployerPlan; EmployerMaintainingPlan; InsurerProvidingCoverage; label en official "§6432(b): the plan (multiemployer), the employer maintaining the plan (COBRA-subject or not wholly insured), or the insurer"; }
relation group_health_plan_is_multiemployer(plan: Person) kind empirical { label en official "a group health plan which is a multiemployer plan (as defined in section 3(37) of ERISA)"; }
relation group_health_plan_subject_to_cobra_or_self_insured(plan: Person) kind empirical { label en official "a group health plan subject to the COBRA continuation provisions of the Code, ERISA or the Public Health Service Act, or under which some or all of the coverage is not provided by insurance"; }
relation premium_payee_treated_as(plan: Person, k: PremiumPayeeKind) kind institutional { label en official "the person treated as the person to whom premiums are payable"; }
@source(IRC_S6432_B, relation = formalizes, coverage = exact, quote = "(1) in the case of any group health plan which is a multiemployer plan (as defined in section 3(37) of the Employee Retirement Income Security Act of 1974), the plan,")
rule S6432PayeeIsPlanWhenMultiemployer strict { for plan: Person; when group_health_plan_is_multiemployer(plan); then premium_payee_treated_as(plan, MultiemployerPlan); }
@source(IRC_S6432_B, relation = formalizes, coverage = exact, quote = "the employer maintaining the plan, and")
rule S6432PayeeIsEmployerWhenCobraOrSelfInsured strict { for plan: Person; when group_health_plan_subject_to_cobra_or_self_insured(plan) and not_known(group_health_plan_is_multiemployer(plan)); then premium_payee_treated_as(plan, EmployerMaintainingPlan); }
@source(IRC_S6432_B, relation = formalizes, coverage = exact, quote = "(3) in the case of any group health plan not described in paragraph (1) or (2), the insurer providing the coverage under the group health plan.")
rule S6432PayeeIsInsurerOtherwise strict { for plan: Person; when group_health_plan_exists(plan) and not_known(group_health_plan_is_multiemployer(plan)) and not_known(group_health_plan_subject_to_cobra_or_self_insured(plan)); then premium_payee_treated_as(plan, InsurerProvidingCoverage); }
relation group_health_plan_exists(plan: Person) kind empirical { label en official "a group health plan providing continuation coverage"; }
// (c)(1): limitation; (c)(2): excess is refundable overpayment; (c)(3): overstatement.
pub relation cobra_credit_allowed(p: Person, quarter: Period, amount: Money) kind institutional { label en official "the credit allowed for the quarter: not more than the section 3111(b) tax (reduced by the §3131, §3132 and §3134 credits) on the wages of all employees"; }
@source(IRC_S6432_C, relation = formalizes, coverage = exact, quote = "shall not exceed the tax imposed by section 3111(b), or so much of the taxes imposed under section 3221(a) as are attributable to the rate in effect under section 3111(b), for such calendar quarter (reduced by any credits allowed against such taxes under sections 3131, 3132, and 3134) on the wages paid with respect to the employment of all employees of the employer.")
rule S6432CreditAllowedIsLimited strict {
    for p: Person;
    for quarter: Period;
    for credit: Money;
    for tax: Money;
    for other: Money;
    when cobra_credit_before_limitation(p, quarter, credit) and payroll_tax_for_quarter_6432(p, quarter, tax) and payroll_credits_3131_3132_3134(p, quarter, other);
    then cobra_credit_allowed(p, quarter, min(credit, max(0 USD, tax - other)));
}
pub relation cobra_credit_excess_is_overpayment(p: Person, quarter: Period, amount: Money) kind institutional { label en official "if the credit exceeds the limitation, the excess is treated as an overpayment refunded under sections 6402(a) and 6413(b)"; }
@source(IRC_S6432_C, relation = formalizes, coverage = exact, quote = "If the amount of the credit under subsection (a) exceeds the limitation of paragraph (1) for any calendar quarter, such excess shall be treated as an overpayment that shall be refunded under sections 6402(a) and 6413(b).")
rule S6432ExcessIsOverpayment strict {
    for p: Person;
    for quarter: Period;
    for credit: Money;
    for allowed: Money;
    when cobra_credit_before_limitation(p, quarter, credit) and cobra_credit_allowed(p, quarter, allowed) and credit > allowed;
    then cobra_credit_excess_is_overpayment(p, quarter, credit - allowed);
}
relation cobra_excess_refunded(p: Person, quarter: Period) kind empirical;
@source(IRC_S6432_C, relation = formalizes, coverage = exact, quote = "such excess shall be treated as an overpayment that shall be refunded under sections 6402(a) and 6413(b)")
rule S6432DutyToRefundExcess strict {
    for p: Person;
    for quarter: Period;
    for amount: Money;
    when cobra_credit_excess_is_overpayment(p, quarter, amount) and amount > 0 USD;
    then duty RefundCobraCreditExcess {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition cobra_excess_refunded(p, quarter);
            window [-infinity, infinity];
        }
    };
}
// (c)(2)(B): advance of the credit; (C): penalty waiver.
relation advance_of_cobra_credit_requested(p: Person, quarter: Period, amount: Money) kind empirical { label en official "the credit may be advanced, according to forms and instructions provided by the Secretary, up to an amount calculated under subsection (a) through the end of the most recent payroll period in the quarter"; }
relation cobra_credit_advanced(p: Person, quarter: Period, amount: Money) kind institutional;
relation secretary_advances_cobra_credit(p: Person, quarter: Period) kind empirical;
@source(IRC_S6432_C, relation = formalizes, coverage = exact, quote = "the credit may be advanced, according to forms and instructions provided by the Secretary, up to an amount calculated under subsection (a) through the end of the most recent payroll period in the quarter.")
rule S6432AdvancePower strict {
    for p: Person;
    for quarter: Period;
    for amount: Money;
    when advance_of_cobra_credit_requested(p, quarter, amount);
    then power S6432AdvanceCreditPower {
        holder Secretary;
        over p;
        exercise secretary_advances_cobra_credit(p, quarter);
        valid_when cobra_advance_within_calculated_credit(p, quarter);
        effect create(cobra_credit_advanced(p, quarter, amount));
    };
}
relation cobra_advance_within_calculated_credit(p: Person, quarter: Period) kind institutional { label en unofficial "the requested advance does not exceed the credit calculated through the most recent payroll period"; }
relation credit_calculated_through_latest_payroll_period(p: Person, quarter: Period, amount: Money) kind empirical;
rule S6432AdvanceWithinCalculatedCredit strict {
    for p: Person;
    for quarter: Period;
    for requested: Money;
    for calculated: Money;
    when advance_of_cobra_credit_requested(p, quarter, requested) and credit_calculated_through_latest_payroll_period(p, quarter, calculated) and requested <= calculated;
    then cobra_advance_within_calculated_credit(p, quarter);
}
relation deposit_failure_due_to_anticipating_credit(p: Person, quarter: Period) kind empirical { label en official "the Secretary determines that the failure to make a deposit of the tax imposed by section 3111(b), or so much of the taxes under section 3221(a) as are attributable to the rate under section 3111(b), was due to the anticipation of the credit"; }
relation section_6656_penalty_waived(p: Person, quarter: Period) kind empirical;
@source(IRC_S6432_C, relation = formalizes, coverage = exact, quote = "The Secretary shall waive any penalty under section 6656 for any failure to make a deposit of the tax imposed by section 3111(b)")
rule S6432DutyToWaiveDepositPenalty strict {
    for p: Person;
    for quarter: Period;
    when deposit_failure_due_to_anticipating_credit(p, quarter);
    then duty WaiveSection6656PenaltyForAnticipatedCobraCredit {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition section_6656_penalty_waived(p, quarter);
            window [-infinity, infinity];
        }
    };
}
relation cobra_credit_overstatement(p: Person, quarter: Period, amount: Money) kind empirical { label en official "any overstatement of the credit to which a person is entitled under this section (and any amount paid by the Secretary as a result of such overstatement)"; }
pub relation cobra_overstatement_treated_as_underpayment(p: Person, quarter: Period, amount: Money) kind institutional { label en official "treated as an underpayment by such person of the taxes described in paragraph (1), assessable and collectible in the same manner as such taxes"; }
@source(IRC_S6432_C, relation = formalizes, coverage = exact, quote = "shall be treated as an underpayment by such person of the taxes described in paragraph (1) and may be assessed and collected by the Secretary in the same manner as such taxes.")
rule S6432OverstatementIsUnderpayment strict {
    for p: Person;
    for quarter: Period;
    for amount: Money;
    when cobra_credit_overstatement(p, quarter, amount);
    then cobra_overstatement_treated_as_underpayment(p, quarter, amount);
}
// (d): the persons covered.
relation governmental_or_501c1_person(p: Person) kind empirical { label en official "the government of any State or political subdivision, any Indian tribal government (section 139E(c)(1)), any agency or instrumentality of any of the foregoing, and any agency or instrumentality of the United States that is described in section 501(c)(1) and exempt under section 501(a)"; }
relation person_for_6432(p: Person) kind institutional { label en official "the term person includes the governmental bodies of subsection (d)"; }
@source(IRC_S6432_D, relation = formalizes, coverage = exact, quote = "the term \"person\" includes the government of any State or political subdivision thereof")
rule S6432PersonIncludesGovernments strict { for p: Person; when governmental_or_501c1_person(p); then person_for_6432(p); }
// (e): gross income is increased by the credit.
pub relation gross_income_increase_for_cobra_credit(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "for purposes of chapter 1, the gross income of any person allowed a credit is increased for the taxable year which includes the last day of the quarter by the amount of the credit"; }
relation quarter_last_day_falls_in_year(quarter: Period, y: TaxableYear) kind empirical { label en unofficial "the last day of the calendar quarter falls in the taxable year"; }
@source(IRC_S6432_E, relation = formalizes, coverage = exact, quote = "the gross income of any person allowed a credit under this section shall be increased for the taxable year which includes the last day of any calendar quarter with respect to which such credit is allowed by the amount of such credit.")
rule S6432CreditIncreasesGrossIncome strict {
    for p: Person;
    for quarter: Period;
    for y: TaxableYear;
    for allowed: Money;
    when cobra_credit_allowed(p, quarter, allowed) and quarter_last_day_falls_in_year(quarter, y);
    then gross_income_increase_for_cobra_credit(p, y, allowed);
}
// (f): the assessment period does not expire before 5 years after the later of filing dates.
relation cobra_return_filed_on(p: Person, quarter: Period, d: Date) kind empirical { label en official "the date on which the original return which includes the calendar quarter is filed"; }
relation cobra_return_treated_as_filed_on_6501b2(p: Person, quarter: Period, d: Date) kind empirical { label en official "the date on which such return is treated as filed under section 6501(b)(2)"; }
relation cobra_assessment_candidate(p: Person, quarter: Period, d: Date) kind institutional { label en unofficial "a candidate date: five years after a filing date"; }
rule S6432AssessmentCandidateFiled strict { for p: Person; for quarter: Period; for d: Date; when cobra_return_filed_on(p, quarter, d); then cobra_assessment_candidate(p, quarter, add_calendar_period(d, 60 calendar_month)); }
rule S6432AssessmentCandidateTreatedFiled strict { for p: Person; for quarter: Period; for d: Date; when cobra_return_treated_as_filed_on_6501b2(p, quarter, d); then cobra_assessment_candidate(p, quarter, add_calendar_period(d, 60 calendar_month)); }
relation later_cobra_assessment_candidate_exists(p: Person, quarter: Period, d: Date) kind institutional { label en unofficial "helper (TECH-GAPS G136)"; }
rule S6432LaterAssessmentCandidateExists strict { for p: Person; for quarter: Period; for d: Date; for other: Date; when cobra_assessment_candidate(p, quarter, d) and cobra_assessment_candidate(p, quarter, other) and other > d; then later_cobra_assessment_candidate_exists(p, quarter, d); }
pub relation cobra_assessment_period_not_expired_before(p: Person, quarter: Period, d: Date) kind institutional { label en official "notwithstanding section 6501, the limitation period for assessing amounts attributable to the credit does not expire before this date"; }
@source(IRC_S6432_F, relation = formalizes, coverage = exact, quote = "Notwithstanding section 6501, the limitation on the time period for the assessment of any amount attributable to a credit claimed under this section shall not expire before the date that is 5 years after the later of—")
rule S6432AssessmentPeriodFiveYears strict {
    for p: Person;
    for quarter: Period;
    for d: Date;
    when cobra_assessment_candidate(p, quarter, d) and not_known(later_cobra_assessment_candidate_exists(p, quarter, d));
    then cobra_assessment_period_not_expired_before(p, quarter, d);
}

// ============================================================================
// §6433 — Saver's Match
// ============================================================================

relation saver_match_taxpayer(p: Person, y: TaxableYear, status: RebateFilingStatus, agi: Money) kind empirical {
    label en unofficial "the individual's filing status (joint or surviving spouse / head of household / other) and adjusted gross income for the taxable year";
}
relation saver_match_year_applicable(y: TaxableYear) kind institutional { label en official "taxable years beginning after December 31, 2026 (Pub. L. 117-328 sec. 103(f))"; }
@source(IRC_S6433_NOTE_4, relation = applies, coverage = exact, quote = "shall apply to taxable years beginning after December 31, 2026")
rule S6433YearApplicable strict {
    for y: TaxableYear;
    for b: Date;
    when us.irc.core::begins(y, b) and b > @2026-12-31;
    then saver_match_year_applicable(y);
}
// (c): eligible individual.
relation individual_age_at_close_of_year(p: Person, y: TaxableYear, age: Integer) kind empirical;
relation student_within_152f2(p: Person, y: TaxableYear) kind empirical { label en official "a student (as defined in section 152(f)(2))"; }
relation nonresident_alien_for_part_of_year(p: Person, y: TaxableYear) kind empirical { label en official "a nonresident alien individual for any portion of the taxable year"; }
relation treated_as_resident_by_6013g_or_h_election(p: Person, y: TaxableYear) kind empirical { label en official "treated for the taxable year as a resident of the United States for purposes of chapter 1 by reason of an election under section 6013(g) or (h)"; }
pub relation eligible_individual_6433(p: Person, y: TaxableYear) kind institutional { label en official "an individual who has attained the age of 18 by the close of the taxable year, other than a dependent of another taxpayer, a student, or (unless treated as a resident by election) a nonresident alien"; }
relation nonresident_alien_not_treated_as_resident_6433(p: Person, y: TaxableYear) kind institutional { label en unofficial "helper: nonresident alien and not treated as a resident"; }
rule S6433NonresidentAlienExcluded strict {
    for p: Person;
    for y: TaxableYear;
    when nonresident_alien_for_part_of_year(p, y) and not_known(treated_as_resident_by_6013g_or_h_election(p, y));
    then nonresident_alien_not_treated_as_resident_6433(p, y);
}
@source(IRC_S6433_C, relation = formalizes, coverage = exact, quote = "The term \"eligible individual\" means any individual if such individual has attained the age of 18 as of the close of the taxable year.")
rule S6433EligibleIndividual strict {
    for p: Person;
    for y: TaxableYear;
    for age: Integer;
    for status: RebateFilingStatus;
    for agi: Money;
    when saver_match_taxpayer(p, y, status, agi) and individual_age_at_close_of_year(p, y, age) and age >= 18
        and not_known(dependency_deduction_allowable_to_another(p, y)) and not_known(student_within_152f2(p, y)) and not_known(nonresident_alien_not_treated_as_resident_6433(p, y));
    then eligible_individual_6433(p, y);
}
// (f)(1): modified adjusted gross income.
relation excluded_911_931_933_amount(p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the amounts excluded under sections 911, 931 and 933, added back (0 if none)"; }
relation qrsc_exclusion_or_deduction_amount(p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "any exclusion or deduction allowed for any qualified retirement savings contribution made during the taxable year, added back (0 if none)"; }
pub relation modified_agi_6433(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "adjusted gross income determined without regard to sections 911, 931 and 933, and without any exclusion or deduction allowed for a qualified retirement savings contribution made during the year"; }
@source(IRC_S6433_F, relation = formalizes, coverage = exact, quote = "the term \"modified adjusted gross income\" means adjusted gross income—")
rule S6433ModifiedAgi strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    for foreign: Money;
    for deduction: Money;
    when saver_match_taxpayer(p, y, status, agi) and excluded_911_931_933_amount(p, y, foreign) and qrsc_exclusion_or_deduction_amount(p, y, deduction);
    then modified_agi_6433(p, y, agi + foreign + deduction);
}
// (b)(3), (h): applicable dollar amount and phase-out range.
relation cost_of_living_adjustment_6433h(y: TaxableYear, cola: Decimal) kind empirical { label en official "the cost-of-living adjustment determined under section 1(f)(3) for the calendar year in which the taxable year begins, substituting calendar year 2026 for calendar year 2016 — SOURCE_GAP: no published value is pinned"; }
relation base_dollar_amount_6433(y: TaxableYear, amount: Money) kind institutional { label en official "the $41,000 amount of subsection (b)(3)(A)(i), increased for taxable years beginning after 2027 by the cost-of-living adjustment (increase rounded to the nearest $1,000)"; }
@source(IRC_S6433_B, relation = formalizes, coverage = exact, quote = "(i) the applicable dollar amount is $41,000, and")
rule S6433BaseDollarAmountThrough2027 strict {
    for y: TaxableYear;
    for b: Date;
    when us.irc.core::begins(y, b) and b > @2026-12-31 and b <= @2027-12-31;
    then base_dollar_amount_6433(y, SaversMatchApplicableDollarAmount);
}
@source(IRC_S6433_H, relation = formalizes, coverage = exact, quote = "the $41,000 amount in subsection (b)(3)(A)(i) shall be increased by an amount equal to—")
@source(IRC_S6433_H, relation = formalizes, coverage = exact, quote = "Any increase determined under paragraph (1) shall be rounded to the nearest multiple of $1,000.")
rule S6433BaseDollarAmountAfter2027 strict {
    for y: TaxableYear;
    for b: Date;
    for cola: Decimal;
    when us.irc.core::begins(y, b) and b > @2027-12-31 and cost_of_living_adjustment_6433h(y, cola);
    then base_dollar_amount_6433(y, SaversMatchApplicableDollarAmount + round(SaversMatchApplicableDollarAmount * cola / 1000.00 USD, 0, "HALF_UP") * 1000.00 USD);
}
relation phaseout_amounts_6433(p: Person, y: TaxableYear, dollar_amount: Money, range: Money) kind institutional { label en official "the applicable dollar amount and phase-out range: the base amounts for a joint return or surviving spouse; 3/4 for a head of household; 1/2 for any other taxpayer"; }
@source(IRC_S6433_B, relation = formalizes, coverage = exact, quote = "(ii) the phaseout range is $30,000.")
rule S6433AmountsJointOrSurvivingSpouse strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    for base: Money;
    when saver_match_taxpayer(p, y, status, agi) and (status == JointReturn or status == SurvivingSpouse) and base_dollar_amount_6433(y, base);
    then phaseout_amounts_6433(p, y, base, SaversMatchPhaseoutRange);
}
@source(IRC_S6433_B, relation = formalizes, coverage = exact, quote = "(i) a head of a household (as defined in section 2(b)), the applicable dollar amount and the phaseout range shall be ¾ of the amounts applicable under subparagraph (A) (as adjusted under subsection (h)), and")
rule S6433AmountsHeadOfHousehold strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    for base: Money;
    when saver_match_taxpayer(p, y, HeadOfHousehold, agi) and base_dollar_amount_6433(y, base);
    then phaseout_amounts_6433(p, y, base * 0.75, SaversMatchPhaseoutRange * 0.75);
}
@source(IRC_S6433_B, relation = formalizes, coverage = exact, quote = "(ii) any taxpayer who is not filing a joint return, who is not a head of a household (as so defined), and who is not a surviving spouse (as defined in section 2(a)), the applicable dollar amount and the phaseout range shall be ½ of the amounts applicable under subparagraph (A) (as so adjusted).")
rule S6433AmountsOtherTaxpayer strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    for base: Money;
    when saver_match_taxpayer(p, y, OtherStatus, agi) and base_dollar_amount_6433(y, base);
    then phaseout_amounts_6433(p, y, base * 0.5, SaversMatchPhaseoutRange * 0.5);
}
// (b)(1)-(2): the applicable percentage.
pub relation applicable_percentage_6433(p: Person, y: TaxableYear, percent: Decimal) kind institutional { label en official "50 percent, reduced (not below zero) by the whole percentage points which bear the same ratio to 50 points as the excess of modified AGI over the applicable dollar amount bears to the phase-out range"; }
@source(IRC_S6433_B, relation = formalizes, coverage = exact, quote = "The percentage under paragraph (1) shall be reduced (but not below zero) by the number of percentage points which bears the same ratio to 50 percentage points as—")
@source(IRC_S6433_B, relation = formalizes, coverage = exact, quote = "If any reduction determined under this paragraph is not a whole percentage point, such reduction shall be rounded to the next lowest whole percentage point.")
rule S6433ApplicablePercentage strict {
    for p: Person;
    for y: TaxableYear;
    for magi: Money;
    for dollar: Money;
    for range: Money;
    when modified_agi_6433(p, y, magi) and phaseout_amounts_6433(p, y, dollar, range) and saver_match_year_applicable(y);
    then applicable_percentage_6433(p, y, max(0.0, SaversMatchBasePercentage * 100.0 - round(div_round((max(0 USD, magi - dollar) / 1.00 USD) * (SaversMatchBasePercentage * 100.0), range / 1.00 USD, 10, "HALF_UP"), 0, "FLOOR")));
}
// (d): qualified retirement savings contributions.
entity SaverContribution { label en unofficial "a contribution to a retirement savings arrangement by the individual"; }
enum SaverContributionKind {
    QualifiedRetirementContribution219e;
    ElectiveDeferral402g3;
    DeferralUnder457b;
    VoluntaryEmployeeContribution;
    label en official "§6433(d)(1)(A)-(C): qualified retirement contributions (section 219(e)); elective deferrals (section 402(g)(3)) and elective deferrals under an eligible deferred compensation plan of a section 457(e)(1)(A) employer; voluntary employee contributions to a qualified retirement plan (section 4974(c))";
}
relation saver_contribution_of(c: SaverContribution, p: Person, y: TaxableYear, k: SaverContributionKind, amount: Money) kind empirical;
relation saver_contribution_funded_by_match_payment(c: SaverContribution) kind empirical { label en official "any amount attributable to a payment under subsection (a)(2)"; }
relation qrsc_gross_6433(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the sum of the contributions of the year, excluding any amount attributable to a saver's match payment"; }
@source(IRC_S6433_D, relation = formalizes, coverage = exact, quote = "The term \"qualified retirement savings contributions\" means, with respect to any taxable year, the sum of—")
rule S6433GrossContributions strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when saver_match_taxpayer(p, y, status, agi);
    then qrsc_gross_6433(p, y, (sum all a: Money for c: SaverContribution, k: SaverContributionKind where saver_contribution_of(c, p, y, k, a)) - (sum all m: Money for c2: SaverContribution, k2: SaverContributionKind where saver_contribution_of(c2, p, y, k2, m) and saver_contribution_funded_by_match_payment(c2)));
}
// (d)(2): reduction by distributions received in the testing period.
relation saver_distribution(d: SaverContribution, p: Person, received: Date, amount: Money) kind empirical { label en official "a distribution received from an entity of a type to which contributions may be made"; }
relation distribution_disregarded_under_d2C(d: SaverContribution) kind empirical { label en official "(d)(2)(C)(i)-(ii): a distribution referred to in section 72(p), 401(k)(8), 401(m)(6), 402(g)(2), 404(k) or 408(d)(4), or one to which section 408(d)(3) or 408A(d)(3) applies"; }
relation distribution_rolled_over_portion(d: SaverContribution, amount: Money) kind empirical { label en official "(d)(2)(C)(iii) any portion of a distribution transferred or paid in a rollover contribution to an account or plan to which qualified retirement savings contributions can be made"; }
relation taxable_year_two_before(y: TaxableYear, y2: TaxableYear) kind empirical { label en unofficial "y2 is the taxable year two years before y (the testing period covers the year, the 2 preceding years and the period after the year)"; }
relation return_due_date_with_extensions_6433(p: Person, y: TaxableYear, d: Date) kind empirical { label en official "the due date (including extensions) for filing the return of tax for the taxable year"; }
relation spouse_joint_return_both_years(p: Person, spouse: Person, y: TaxableYear, distribution_year: TaxableYear) kind empirical { label en official "the individual and the spouse file a joint return for the taxable year and for the taxable year during which the spouse receives the distribution"; }
relation distribution_has_rollover_portion(d: SaverContribution) kind institutional { label en unofficial "helper: a rolled-over portion is stated for the distribution"; }
rule S6433DistributionHasRolloverPortion strict {
    for d: SaverContribution;
    for rolled: Money;
    when distribution_rolled_over_portion(d, rolled);
    then distribution_has_rollover_portion(d);
}
relation counted_distribution_6433(d: SaverContribution, p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "a distribution received during the testing period (the year, the 2 preceding years, and the period after the year before the return due date, including extensions), net of disregarded portions; a spouse's distribution counts on a joint return"; }
@source(IRC_S6433_D, relation = formalizes, coverage = exact, quote = "(iii) the period after such taxable year and before the due date (including extensions) for filing the return of tax for such taxable year.")
rule S6433CountedOwnDistribution defeasible {
    for d: SaverContribution;
    for p: Person;
    for y: TaxableYear;
    for y2: TaxableYear;
    for start: Date;
    for received: Date;
    for amount: Money;
    for due: Date;
    when saver_distribution(d, p, received, amount) and taxable_year_two_before(y, y2) and us.irc.core::begins(y2, start) and return_due_date_with_extensions_6433(p, y, due) and received >= start and received <= due and not_known(distribution_has_rollover_portion(d));
    then counted_distribution_6433(d, p, y, amount);
    unless distribution_disregarded_under_d2C(d) and saver_distribution(d, p, received, amount) and taxable_year_two_before(y, y2);
}
@source(IRC_S6433_D, relation = formalizes, coverage = exact, quote = "(iii) any portion of a distribution if such portion is transferred or paid in a rollover contribution")
rule S6433CountedOwnDistributionNetOfRollover defeasible {
    for d: SaverContribution;
    for p: Person;
    for y: TaxableYear;
    for y2: TaxableYear;
    for start: Date;
    for received: Date;
    for amount: Money;
    for rolled: Money;
    for due: Date;
    when saver_distribution(d, p, received, amount) and distribution_rolled_over_portion(d, rolled) and taxable_year_two_before(y, y2) and us.irc.core::begins(y2, start) and return_due_date_with_extensions_6433(p, y, due) and received >= start and received <= due;
    then counted_distribution_6433(d, p, y, max(0 USD, amount - rolled));
    unless distribution_disregarded_under_d2C(d) and saver_distribution(d, p, received, amount) and distribution_rolled_over_portion(d, rolled) and taxable_year_two_before(y, y2);
}
@source(IRC_S6433_D, relation = formalizes, coverage = exact, quote = "any distribution received by the spouse of such individual shall be treated as received by such individual if such individual and spouse file a joint return for such taxable year and for the taxable year during which the spouse receives the distribution.")
rule S6433CountedSpouseDistribution defeasible {
    for d: SaverContribution;
    for p: Person;
    for spouse: Person;
    for y: TaxableYear;
    for dy: TaxableYear;
    for y2: TaxableYear;
    for start: Date;
    for received: Date;
    for amount: Money;
    for due: Date;
    when spouse_joint_return_both_years(p, spouse, y, dy) and saver_distribution(d, spouse, received, amount) and taxable_year_two_before(y, y2) and us.irc.core::begins(y2, start) and return_due_date_with_extensions_6433(p, y, due) and received >= start and received <= due;
    then counted_distribution_6433(d, p, y, amount);
    unless distribution_disregarded_under_d2C(d) and spouse_joint_return_both_years(p, spouse, y, dy) and saver_distribution(d, spouse, received, amount);
}
pub relation qualified_retirement_savings_contributions_6433(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the contributions of the year reduced (not below zero) by the aggregate distributions received during the testing period"; }
@source(IRC_S6433_D, relation = formalizes, coverage = exact, quote = "The qualified retirement savings contributions determined under paragraph (1) for a taxable year shall be reduced (but not below zero) by the aggregate distributions received by the individual during the testing period from any entity of a type to which contributions under paragraph (1) may be made.")
rule S6433QrscAfterDistributions defeasible {
    for p: Person;
    for y: TaxableYear;
    for gross: Money;
    when qrsc_gross_6433(p, y, gross);
    then qualified_retirement_savings_contributions_6433(p, y, max(0 USD, gross - (sum all a: Money for d: SaverContribution where counted_distribution_6433(d, p, y, a))));
}
// (a)(1): the matching contribution.
pub relation matching_contribution_6433(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the applicable percentage of so much of the qualified retirement savings contributions as does not exceed $2,000"; }
@source(IRC_S6433_A, relation = formalizes, coverage = exact, quote = "Any eligible individual who makes qualified retirement savings contributions for the taxable year shall be allowed a matching contribution for such taxable year in an amount equal to the applicable percentage of so much of the qualified retirement savings contributions made by such eligible individual for the taxable year as does not exceed $2,000.")
rule S6433MatchingContribution defeasible {
    for p: Person;
    for y: TaxableYear;
    for qrsc: Money;
    for pct: Decimal;
    when eligible_individual_6433(p, y) and saver_match_year_applicable(y) and qualified_retirement_savings_contributions_6433(p, y, qrsc) and applicable_percentage_6433(p, y, pct);
    then matching_contribution_6433(p, y, div_round(min(qrsc, SaversMatchContributionCap) * pct, 100.0, 2, "HALF_UP"));
}
// (a)(2): payment to the vehicle, or the small-amount election to take a refundable credit.
relation match_paid_to_vehicle(p: Person, y: TaxableYear) kind empirical;
relation individual_elects_small_match_as_credit(p: Person, y: TaxableYear) kind empirical { label en official "an eligible individual who elects the application of subparagraph (B)"; }
relation match_between_zero_and_100_dollars(p: Person, y: TaxableYear) kind institutional { label en official "the matching contribution is greater than zero but less than $100"; }
rule S6433MatchBetweenZeroAndOneHundred defeasible {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when matching_contribution_6433(p, y, amount) and amount > 0 USD and amount < SaversMatchSmallAmountThreshold;
    then match_between_zero_and_100_dollars(p, y);
}
relation match_treated_as_subpart_C_credit(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the matching contribution is treated as a credit allowed by subpart C of part IV of subchapter A of chapter 1"; }
@source(IRC_S6433_A, relation = formalizes, coverage = exact, quote = "subparagraph (A) shall not apply and such matching contribution shall be treated as a credit allowed by subpart C of part IV of subchapter A of chapter 1.")
rule S6433ElectionToTakeSmallMatchAsCredit defeasible {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when matching_contribution_6433(p, y, amount) and individual_elects_small_match_as_credit(p, y);
    then power S6433SmallMatchAsCreditPower {
        holder p;
        over Secretary;
        exercise individual_elects_small_match_as_credit(p, y);
        valid_when match_between_zero_and_100_dollars(p, y);
        effect create(match_treated_as_subpart_C_credit(p, y, amount));
    };
}
@source(IRC_S6433_A, relation = formalizes, coverage = exact, quote = "the matching contribution under this section shall be allowed as a credit which shall be payable by the Secretary as a contribution (as soon as practicable after the eligible individual has filed a tax return making a claim for such matching contribution for the taxable year) to the applicable retirement savings vehicle of the eligible individual.")
rule S6433DutyToPayMatchToVehicle defeasible {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when matching_contribution_6433(p, y, amount) and amount > 0 USD;
    then duty PaySaversMatchToRetirementVehicle {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition match_paid_to_vehicle(p, y);
            window [-infinity, infinity];
        }
    };
    unless individual_elects_small_match_as_credit(p, y) and match_between_zero_and_100_dollars(p, y) and matching_contribution_6433(p, y, amount);
}
// (e): applicable retirement savings vehicle.
relation vehicle_is_401k_403b_salary_reduction_portion(v: Person) kind empirical { label en official "the portion of a plan described in section 402(c)(8)(B)(v), a qualified cash or deferred arrangement (section 401(k)), or a section 403(b) annuity contract purchased under a salary reduction agreement"; }
relation vehicle_is_qualified_roth_program_portion(v: Person) kind empirical { label en official "a qualified Roth contribution program (section 402A(b))"; }
relation vehicle_is_individual_retirement_plan(v: Person) kind empirical { label en official "an individual retirement plan"; }
relation vehicle_is_roth_ira(v: Person) kind empirical { label en official "a Roth IRA"; }
relation vehicle_for_benefit_of_individual(v: Person, p: Person) kind empirical { label en official "the account or plan is for the benefit of the eligible individual"; }
relation vehicle_accepts_saver_match_contributions(v: Person) kind empirical { label en official "the account or plan accepts contributions made under this section"; }
relation vehicle_designated_by_individual(v: Person, p: Person) kind empirical { label en official "the account or plan is designated by such individual (in such form and manner as the Secretary may provide)"; }
pub relation applicable_retirement_savings_vehicle_6433(v: Person, p: Person) kind institutional { label en official "an account or plan elected by the eligible individual which meets paragraph (2)"; }
@source(IRC_S6433_E, relation = formalizes, coverage = exact, quote = "The term \"applicable retirement savings vehicle\" means an account or plan elected by the eligible individual under paragraph (2).")
rule S6433VehicleSalaryReductionPlan strict {
    for v: Person;
    for p: Person;
    when vehicle_is_401k_403b_salary_reduction_portion(v) and not_known(vehicle_is_qualified_roth_program_portion(v)) and vehicle_for_benefit_of_individual(v, p) and vehicle_accepts_saver_match_contributions(v) and vehicle_designated_by_individual(v, p);
    then applicable_retirement_savings_vehicle_6433(v, p);
}
rule S6433VehicleIndividualRetirementPlan strict {
    for v: Person;
    for p: Person;
    when vehicle_is_individual_retirement_plan(v) and not_known(vehicle_is_roth_ira(v)) and vehicle_for_benefit_of_individual(v, p) and vehicle_accepts_saver_match_contributions(v) and vehicle_designated_by_individual(v, p);
    then applicable_retirement_savings_vehicle_6433(v, p);
}
// (f)(2)-(5): treatment of the contribution; erroneous payment; no offset.
relation match_contribution_made_to_vehicle(v: Person, p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "a contribution under subsection (a)(2)"; }
pub relation match_treated_as_elective_deferral_or_ira_contribution(v: Person, p: Person, y: TaxableYear) kind institutional { label en official "except as otherwise provided, the contribution is treated as an elective deferral (401(k)-type) or an individual retirement plan contribution made by the individual, and is disregarded for the limits and nondiscrimination tests listed in (f)(2)(B)"; }
@source(IRC_S6433_F, relation = formalizes, coverage = partial, quote = "such contribution shall be treated as—")
rule S6433ContributionTreatedAsDeferralOrIraContribution strict {
    for v: Person;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when match_contribution_made_to_vehicle(v, p, y, amount) and applicable_retirement_savings_vehicle_6433(v, p);
    then match_treated_as_elective_deferral_or_ira_contribution(v, p, y);
}
relation plan_disqualified_solely_by_accepting_match(v: Person) kind empirical { label en official "the plan or arrangement is treated as violating a requirement under section 401, 403, 408, or 457 solely by reason of accepting the contribution"; }
@source(IRC_S6433_F, relation = formalizes, coverage = exact, quote = "A plan or arrangement to which a contribution is made under this section shall not be treated as violating any requirement under section 401, 403, 408, or 457 solely by reason of accepting such contribution.")
rule S6433PlanNotDisqualifiedByAcceptingMatch strict {
    for v: Person;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when match_contribution_made_to_vehicle(v, p, y, amount);
    then immunity S6433PlanNotDisqualifiedImmunity {
        holder v;
        protected_effect plan_disqualified_solely_by_accepting_match(v);
        window [-infinity, infinity];
    };
}
relation erroneous_match_payment(p: Person, y: TaxableYear, amount: Money) kind empirical { label en official "any contribution erroneously paid under subsection (a)(2), including a payment that is not made to an applicable retirement savings vehicle"; }
relation secretary_determines_erroneous_in_year(p: Person, y: TaxableYear, determination_year: TaxableYear) kind empirical { label en official "the taxable year for which the Secretary determines the payment is erroneous"; }
pub relation erroneous_match_treated_as_underpayment(p: Person, determination_year: TaxableYear, amount: Money) kind institutional { label en official "the amount of an erroneous payment is treated as an underpayment of tax (other than for purposes of part II of subchapter A of chapter 68) for the taxable year in which the Secretary determines the payment is erroneous"; }
@source(IRC_S6433_F, relation = formalizes, coverage = exact, quote = "the amount of such erroneous payment shall be treated as an underpayment of tax (other than for purposes of part II of subchapter A of chapter 68) for the taxable year in which the Secretary determines the payment is erroneous.")
rule S6433ErroneousPaymentIsUnderpayment strict {
    for p: Person;
    for y: TaxableYear;
    for dy: TaxableYear;
    for amount: Money;
    when erroneous_match_payment(p, y, amount) and secretary_determines_erroneous_in_year(p, y, dy);
    then erroneous_match_treated_as_underpayment(p, dy, amount);
}
relation erroneous_contribution_distributed_by_return_due_date(p: Person, y: TaxableYear) kind empirical { label en official "the distribution of the erroneous contribution (and income attributable to it) is received not later than the day prescribed by law (including extensions) for filing the return for the year"; }
relation erroneous_distribution_taxed_or_penalized(p: Person, y: TaxableYear) kind empirical { label en official "the distribution is included in gross income (sections 402(a), 403(a)(1), 403(b)(1), 408(d)(1), 457(a)(1)) or subject to the section 72(t) tax"; }
@source(IRC_S6433_F, relation = formalizes, coverage = partial, quote = "and section 72(t) shall not apply to the distribution of such contribution or any income attributable thereto")
rule S6433ErroneousContributionDistributionNotTaxed strict {
    for p: Person;
    for y: TaxableYear;
    when erroneous_contribution_distributed_by_return_due_date(p, y);
    then immunity S6433ErroneousDistributionNotTaxedImmunity {
        holder p;
        protected_effect erroneous_distribution_taxed_or_penalized(p, y);
        window [-infinity, infinity];
    };
}
relation match_payment_reduced_or_offset(p: Person, y: TaxableYear) kind empirical { label en official "the payment is subject to reduction or offset under section 6402(c), (d), (e) or (f) or any similar authority, or reduced or offset by other assessed Federal taxes that would otherwise be subject to levy or collection"; }
relation match_payment_made_to(p: Person, y: TaxableYear) kind empirical { label en official "a payment made to any individual under this section"; }
@source(IRC_S6433_F, relation = formalizes, coverage = exact, quote = "Any payment made to any individual under this section shall not be—")
rule S6433MatchPaymentNotSubjectToOffset strict {
    for p: Person;
    for y: TaxableYear;
    when match_payment_made_to(p, y);
    then immunity S6433MatchPaymentOffsetImmunity {
        holder p;
        protected_effect match_payment_reduced_or_offset(p, y);
        window [-infinity, infinity];
    };
}
// (f)(6): recapture of the match on early distribution.
relation saver_match_contributions_total(v: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the aggregate amount of contributions made under subsection (a)(2) to the applicable retirement savings vehicle"; }
relation vehicle_account_balance_at_year_end(v: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the account balance of the savings vehicle at the end of the taxable year"; }
relation specified_early_distribution_made(v: Person, p: Person, y: TaxableYear) kind institutional { label en official "a portion of a distribution from the vehicle which is includible in gross income and to which section 72(t)(1) applies"; }
relation distribution_from_vehicle_includible(v: Person, y: TaxableYear) kind empirical { label en official "(B)(ii) the portion is includible in gross income"; }
relation distribution_from_vehicle_subject_to_72t1(v: Person, y: TaxableYear) kind empirical { label en official "(B)(iii) section 72(t)(1) applies to the portion"; }
rule S6433SpecifiedEarlyDistribution strict {
    for v: Person;
    for p: Person;
    for y: TaxableYear;
    when applicable_retirement_savings_vehicle_6433(v, p) and distribution_from_vehicle_includible(v, y) and distribution_from_vehicle_subject_to_72t1(v, y);
    then specified_early_distribution_made(v, p, y);
}
relation tax_increased_under_72t1_on_distribution(v: Person, y: TaxableYear, amount: Money) kind empirical { label en official "the amount by which the tax was increased under section 72(t)(1) with respect to such distribution"; }
relation early_distribution_repaid_by_return_due_date(v: Person, y: TaxableYear, amount: Money) kind empirical { label en official "so much of such specified early distribution as the individual elects to contribute to an applicable retirement savings vehicle not later than the return due date (including extensions)"; }
pub relation match_recovery_tax_increase(v: Person, p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the tax imposed by chapter 1 is increased by the excess of the contributions over the account balance at year end, reduced by the section 72(t)(1) increase and by any repayment"; }
@source(IRC_S6433_F, relation = formalizes, coverage = exact, quote = "if the aggregate amount of such contributions exceeds the account balance of such savings vehicle at the end of the such taxable year, the tax imposed by chapter 1 shall be increased by an amount equal to such excess")
rule S6433RecoveryTaxIncrease strict {
    for v: Person;
    for p: Person;
    for y: TaxableYear;
    for contributions: Money;
    for balance: Money;
    for t72: Money;
    for repaid: Money;
    when specified_early_distribution_made(v, p, y) and saver_match_contributions_total(v, y, contributions) and vehicle_account_balance_at_year_end(v, y, balance) and contributions > balance
        and tax_increased_under_72t1_on_distribution(v, y, t72) and early_distribution_repaid_by_return_due_date(v, y, repaid);
    then match_recovery_tax_increase(v, p, y, max(0 USD, max(0 USD, contributions - balance - t72) - repaid));
}
// (g): guidance to custodians and sponsors.
relation saver_match_election_made(p: Person, y: TaxableYear, custodian: Person) kind empirical { label en official "an amount elected by an eligible individual to be contributed to an account or plan under subsection (e)(2)"; }
relation general_guidance_provided(custodian: Person) kind empirical { label en official "the Secretary provides general guidance applicable to the custodian of the account or the plan sponsor detailing the treatment of such contribution under subsection (f)(2) and the reporting requirements under section 6058"; }
@source(IRC_S6433_G, relation = formalizes, coverage = exact, quote = "the Secretary shall provide general guidance applicable to the custodian of the account or the plan sponsor")
rule S6433DutyToProvideCustodianGuidance strict {
    for p: Person;
    for y: TaxableYear;
    for custodian: Person;
    when saver_match_election_made(p, y, custodian);
    then duty ProvideSaversMatchGuidanceToCustodian {
        bearer Secretary;
        beneficiary custodian;
        goal achievement {
            condition general_guidance_provided(custodian);
            window [-infinity, infinity];
        }
    };
}
