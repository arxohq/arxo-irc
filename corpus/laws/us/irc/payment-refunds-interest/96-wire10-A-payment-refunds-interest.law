// Payment, refunds and interest -- WIRE-10, group A (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 6621(a)(1): the overpayment rate of a CORPORATION for a calendar quarter is the Federal short-term rate plus 2 percentage points ("determined without
// regard to the last sentence of that paragraph", i.e. without the 0.5 percentage point of a corporate overpayment above $10,000). The stage-1 rules derive
// the rate only for an actual overpayment of a person (`overpayment_rate_for_liability`); the excise chapter needs the rate of the quarter itself.
//
// Consumers (`us.irc.alcohol`, imported HERE, not the other way round: credits -> alcohol and this package -> credits make alcohol -> this package a cycle):
//  - section 5011(c)(2): `corporate_overpayment_rate_for_quarter(year, quarter, rate)` is derived (a qualified head) from the quarter rate, through the calendar
//    fact `calendar_quarter_begins_on` and the conversion of percent to a fraction (0.05 for 5 percent, exact multiplication by 0.01);
//  - sections 5001(c)(4)(B)(ii), 5041(c)(7)(B)(ii), 5051(a)(6)(B)(ii): the interest that would be allowed on the excess of the refund at that rate for the days of
//    the filing period, compounded daily (section 6622, the unrolled chain of module 20), derived as
//    `foreign_production_refund_interest_before_6611e(rp, interest)`.
//
// JUDGMENT CALLS
//  - The Federal short-term rate stays a case fact (`federal_short_term_rate`, SOURCE_GAP of module 06); nothing here invents a value.
//  - The filing period must lie in one calendar quarter and last 1 to 92 days (the owner's chain has one constant-rate segment); a longer period is not derived.
//  - A zero excess earns a zero interest (no principal to compound); the chain itself needs a positive principal.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6621_A,
    IRC_S6622_A,
    compounded_balance_a,
    compounding_over_days,
    federal_short_term_rate,
};

pub relation corporate_overpayment_rate_6621a1_for_quarter(quarter_start: Date, rate_percent: Decimal) kind institutional {
    label en official "the overpayment rate of a corporation for the calendar quarter, determined without regard to the last sentence of section 6621(a)(1): the Federal short-term rate plus 2 percentage points";
}
@source(IRC_S6621_A, relation = formalizes, coverage = partial, quote = "3 percentage points (2 percentage points in the case of a corporation)")
rule W10ACorporateOverpaymentRateForQuarter strict {
    label en official "section 6621(a)(1): the corporate overpayment rate for the quarter is the Federal short-term rate plus 2 percentage points (the 0.5 percentage point above $10,000 is the last sentence and is not applied here)";
    for quarterStart: Date;
    for base: Decimal;
    when federal_short_term_rate(quarterStart, base);
    then corporate_overpayment_rate_6621a1_for_quarter(quarterStart, base + 2.0);
}

pub relation calendar_quarter_begins_on(year: Integer, quarter: Integer, first_day: Date) kind empirical {
    label en unofficial "calendar fact: the calendar quarter (1 to 4) of the calendar year begins on this day (January 1, April 1, July 1, October 1)";
}
@source(IRC_S6621_A, relation = formalizes, coverage = partial, quote = "3 percentage points (2 percentage points in the case of a corporation)")
rule W10AAlcoholCorporateOverpaymentRateStub strict {
    label en official "section 5011(c)(2): the corporate overpayment rate under section 6621(a)(1) for the calendar quarter of the year, as a fraction (0.05 for 5 percent)";
    for year: Integer;
    for quarter: Integer;
    for firstDay: Date;
    for ratePercent: Decimal;
    when calendar_quarter_begins_on(year, quarter, firstDay)
        and corporate_overpayment_rate_6621a1_for_quarter(firstDay, ratePercent);
    then us.irc.alcohol::corporate_overpayment_rate_for_quarter(year, quarter, ratePercent * 0.01);
}

@source(IRC_S6622_A, relation = formalizes, coverage = partial, quote = "such interest and such amount shall be compounded daily")
rule W10AForeignProductionRefundCompoundingRequest strict {
    label en official "sections 5001(c)(4)(B)(ii), 5041(c)(7)(B)(ii), 5051(a)(6)(B)(ii): the interest on the excess is compounded daily at the quarter's corporate overpayment rate for the days of the filing period (request of the chain of module 20)";
    for rp: us.irc.alcohol::ForeignProductionRefundPeriod;
    for excess: Money;
    for quarterStart: Date;
    for days: Integer;
    for daysInYear: Integer;
    for ratePercent: Decimal;
    when us.irc.alcohol::foreign_production_refund_excess(rp, excess)
        and us.irc.alcohol::refund_rate_quarter_start(rp, quarterStart)
        and us.irc.alcohol::refund_filing_period_days(rp, days)
        and us.irc.alcohol::refund_days_in_year(rp, daysInYear)
        and corporate_overpayment_rate_6621a1_for_quarter(quarterStart, ratePercent)
        and excess > 0 USD;
    then compounding_over_days(excess, ratePercent, days, daysInYear);
}
@source(IRC_S6622_A, relation = formalizes, coverage = partial, quote = "such interest and such amount shall be compounded daily")
rule W10AForeignProductionRefundInterestFromChain strict {
    label en official "the interest on the excess is the compounded balance after the days of the filing period less the excess";
    for rp: us.irc.alcohol::ForeignProductionRefundPeriod;
    for excess: Money;
    for quarterStart: Date;
    for days: Integer;
    for daysInYear: Integer;
    for ratePercent: Decimal;
    for balance: Money;
    when us.irc.alcohol::foreign_production_refund_excess(rp, excess)
        and us.irc.alcohol::refund_rate_quarter_start(rp, quarterStart)
        and us.irc.alcohol::refund_filing_period_days(rp, days)
        and us.irc.alcohol::refund_days_in_year(rp, daysInYear)
        and corporate_overpayment_rate_6621a1_for_quarter(quarterStart, ratePercent)
        and compounded_balance_a(excess, ratePercent, days, daysInYear, balance);
    then us.irc.alcohol::foreign_production_refund_interest_before_6611e(rp, balance - excess);
}
rule W10AForeignProductionRefundZeroExcessZeroInterest strict {
    label en official "no excess, no interest";
    for rp: us.irc.alcohol::ForeignProductionRefundPeriod;
    when us.irc.alcohol::foreign_production_refund_excess(rp, 0 USD);
    then us.irc.alcohol::foreign_production_refund_interest_before_6611e(rp, 0 USD);
}
