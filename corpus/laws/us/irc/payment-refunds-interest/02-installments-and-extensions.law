// 26 U.S.C. §§6159-6167 — Chapter 62, Subchapter A: installment agreements
// (§6159), extension of time for paying tax (§6161), and the narrower
// extension/security/deferral provisions of §§6163-6167. §6162 and §6166A
// are repealed — NON_NORMATIVE.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §6159(c)'s mandatory agreement is modeled as the method note directs: a
//    `duty` on the Secretary paired with a `power` whose `valid_when` is the
//    same five conditions — the statute's "shall enter" is the duty, the
//    Secretary's act of entering is the power that changes the legal
//    relation (creates `installment_agreement_in_effect`).
//  - §6159(b) termination/modification grounds ((2)-(4)) are each modeled as
//    a `power` of the Secretary; the (5) notice precondition is folded into
//    `valid_when` as a positive fact rather than reified as its own duty,
//    to keep the surface no larger than a termination scenario needs.
//  - §6159(d) ("review... at least once every 2 years") and (e)
//    (administrative-review procedures) are periodic/institutional duties
//    approximated as `maintenance` — same TECH_GAP-adjacent limitation the
//    joint-committee pilot recorded for `recurring` goals (0.1 grammar
//    reserves but does not parse them).
//  - §6159(f) (fee limitation/waiver) is NON_NORMATIVE-adjacent
//    TECH_GAP/SOURCE_GAP: "the amount of such fee as in effect on the date
//    of the enactment of this subsection" and "250 percent of the applicable
//    poverty level" are amounts this snapshot does not pin (no Rev. Proc./HHS
//    poverty-guideline value in the pinned text) — no rule computes them;
//    see coverage row 26/6159/f/u1.
//  - §6159(g), §6161(c)-(d), §6163(c) cross-references to other sections
//    (§7122(e), title 11 proceedings, §6503(d), §6165, §§7508/7508A) are
//    NON_NORMATIVE or EXTERNAL_DEPENDENCY per the target owner
//    (`collection`/F04 mostly; DEPENDENCIES.json rows pending).
//  - §6161(a)(1)/(b)(1)-(2) "reasonable period"/"undue hardship"/"reasonable
//    cause" are DECISION-0194 judgment-channel evaluative elements —
//    `external judgment relation` with authority Secretary, never an
//    arithmetic guard.
//  - §6161(a)(2) (estate-tax extension up to 10 years, tied to §6166
//    installments) and §6163 (extension for a reversionary/remainder
//    interest in an estate), §6164 (extension for a corporation expecting an
//    NOL carryback), §6165 (bond requirement), §6166 (extension for an
//    estate consisting largely of a closely held business — 11 subsections,
//    a valuation-heavy anti-abuse regime) and §6167 (extension for an NOL/
//    credit carryback to a corporation's own current year) are each stated
//    here at SECTION level: the power to extend/defer, its statutory length
//    limit where the text gives one number, and the bond-security link
//    (§6165) — the many closely-held-business qualification tests of §6166
//    (b)-(k) (trade-or-business valuation thresholds, the 2-or-more-trades
//    aggregation rule, acceleration on disposition) are TECH_GAP: they turn
//    on a valuation/classification test this package does not implement and
//    no other stage-1 section reads; see coverage rows 26/6166/*.
//  - §6161(a)(1)'s "abroad" branch (extension "may exceed 6 months") is
//    modeled as lifting the 6-month cap entirely rather than picking a
//    specific longer limit — the statute gives no second number.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6159_A,
    IRC_S6159_B,
    IRC_S6159_C,
    IRC_S6159_D,
    IRC_S6159_E,
    IRC_S6161_A,
    IRC_S6161_B,
    IRC_S6163_A,
    IRC_S6164_A,
    IRC_S6165,
    IRC_S6166_A,
    IRC_S6167_A,
    Person,
    Secretary,
    TaxKind,
    TaxableYear,
};

// ============================================================================
// §6159 — Agreements for payment of tax liability in installments
// ============================================================================

pub entity InstallmentAgreement { label en unofficial "a written agreement under §6159 for payment of a tax liability in installments"; }

pub relation installment_agreement_for(agr: InstallmentAgreement, p: Person, y: TaxableYear, kind: TaxKind) kind institutional;
relation installment_agreement_offered(p: Person, y: TaxableYear, kind: TaxKind) kind empirical {
    label en unofficial "the taxpayer offers to enter into a §6159 agreement";
}
relation secretary_determines_facilitates_collection(p: Person, y: TaxableYear, kind: TaxKind) kind empirical {
    label en unofficial "the Secretary determines that an agreement will facilitate full or partial collection of the liability (§6159(a))";
}
pub relation installment_agreement_entered(p: Person, y: TaxableYear, kind: TaxKind) kind institutional;

@source(IRC_S6159_A, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to enter into written agreements with any taxpayer under which such taxpayer is allowed to make payment on any tax in installment payments if the Secretary determines that such agreement will facilitate full or partial collection of such liability.")
rule S6159AuthorizeInstallmentAgreement strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    when installment_agreement_offered(p, y, kind);
    then power S6159EnterAgreementPower {
        holder Secretary;
        over p;
        exercise installment_agreement_offered(p, y, kind);
        valid_when secretary_determines_facilitates_collection(p, y, kind);
        effect create(installment_agreement_entered(p, y, kind));
    };
}

// --- §6159(c): mandatory agreement in certain cases (duty/power pair) -------

relation mandatory_agreement_liability_at_offer(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount of such liability (determined without regard to interest, penalties, additions to the tax, and additional amounts) does not exceed $10,000";
}
relation mandatory_agreement_compliance_history_clean(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer (and spouse, if joint) has not, during any of the preceding 5 taxable years, failed to file, failed to pay, or entered into a §6159 agreement under subtitle A";
}
relation mandatory_agreement_financially_unable(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary determines that the taxpayer is financially unable to pay such liability in full when due";
}
relation mandatory_agreement_offers_three_year_payoff(p: Person, y: TaxableYear) kind empirical {
    label en official "the agreement requires full payment of such liability within 3 years";
}
relation mandatory_agreement_taxpayer_agrees_to_comply(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer agrees to comply with the provisions of this title for the period such agreement is in effect";
}
relation mandatory_agreement_qualifies(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "all five §6159(c) conditions are met — the Secretary is under a duty to enter the agreement";
}
@source(IRC_S6159_C, relation = formalizes, coverage = partial, quote = "the Secretary shall enter into an agreement to accept the full payment of such tax in installments if, as of the date the individual offers to enter into the agreement")
rule S6159MandatoryAgreementQualifies strict {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when mandatory_agreement_liability_at_offer(p, y, amount) and amount <= 10000 USD
        and mandatory_agreement_compliance_history_clean(p, y)
        and mandatory_agreement_financially_unable(p, y)
        and mandatory_agreement_offers_three_year_payoff(p, y)
        and mandatory_agreement_taxpayer_agrees_to_comply(p, y);
    then mandatory_agreement_qualifies(p, y, amount);
}

@source(IRC_S6159_C, relation = formalizes, coverage = partial, quote = "the Secretary shall enter into an agreement to accept the full payment of such tax in installments")
rule S6159MandatoryAgreementDuty strict {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when mandatory_agreement_qualifies(p, y, amount) and installment_agreement_offered(p, y, us.irc.core::IncomeCh1);
    then duty EnterMandatoryInstallmentAgreement {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition installment_agreement_entered(p, y, us.irc.core::IncomeCh1);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S6159_C, relation = formalizes, coverage = partial, quote = "the Secretary shall enter into an agreement to accept the full payment of such tax in installments")
rule S6159MandatoryAgreementPower strict {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when mandatory_agreement_qualifies(p, y, amount);
    then power S6159MandatoryAgreementEntryPower {
        holder Secretary;
        over p;
        exercise installment_agreement_offered(p, y, us.irc.core::IncomeCh1);
        valid_when mandatory_agreement_qualifies(p, y, amount);
        effect create(installment_agreement_entered(p, y, us.irc.core::IncomeCh1));
    };
}

// --- §6159(b): termination/modification grounds -----------------------------

relation agreement_info_inaccurate_or_incomplete(agr: InstallmentAgreement) kind empirical;
relation agreement_collection_in_jeopardy(agr: InstallmentAgreement) kind empirical;
relation agreement_financial_condition_changed(agr: InstallmentAgreement) kind empirical;
relation agreement_installment_missed(agr: InstallmentAgreement) kind empirical;
relation agreement_other_liability_unpaid(agr: InstallmentAgreement) kind empirical;
relation agreement_financial_update_refused(agr: InstallmentAgreement) kind empirical;
relation agreement_termination_notice_given(agr: InstallmentAgreement, days_before: Integer) kind empirical {
    label en official "a notice of such action is provided to the taxpayer not later than the day 30 days before the date of such action, and such notice includes an explanation why the Secretary intends to take such action";
}
pub relation agreement_terminated(agr: InstallmentAgreement) kind institutional;

relation agreement_termination_notice_given_timely(agr: InstallmentAgreement) kind institutional;
rule S6159TerminationNoticeTimely strict {
    for agr: InstallmentAgreement;
    for days_before: Integer;
    when agreement_termination_notice_given(agr, days_before) and days_before >= 30;
    then agreement_termination_notice_given_timely(agr);
}

relation terminates_or_modifies_agreement(agr: InstallmentAgreement) kind empirical;
relation s6159_termination_valid(agr: InstallmentAgreement) kind institutional {
    label en unofficial "the §6159(b)(5) notice precondition is met, OR the jeopardy exception to that precondition applies";
}
rule S6159TerminationValidByNotice strict {
    for agr: InstallmentAgreement;
    when agreement_termination_notice_given_timely(agr);
    then s6159_termination_valid(agr);
}
rule S6159TerminationValidByJeopardy strict {
    for agr: InstallmentAgreement;
    when agreement_collection_in_jeopardy(agr);
    then s6159_termination_valid(agr);
}
@source(IRC_S6159_B, relation = formalizes, coverage = partial, quote = "The Secretary may terminate any agreement entered into by the Secretary under subsection (a) if—")
rule S6159TerminateForInaccuracyOrJeopardy strict {
    for agr: InstallmentAgreement;
    when terminates_or_modifies_agreement(agr) and (agreement_info_inaccurate_or_incomplete(agr) or agreement_collection_in_jeopardy(agr));
    then power S6159TerminateInaccuracyOrJeopardyPower {
        holder Secretary;
        over agr;
        exercise terminates_or_modifies_agreement(agr);
        valid_when s6159_termination_valid(agr);
        effect create(agreement_terminated(agr));
    };
}
@source(IRC_S6159_B, relation = formalizes, coverage = partial, quote = "If the Secretary makes a determination that the financial condition of a taxpayer with whom the Secretary has entered into an agreement under subsection (a) has significantly changed, the Secretary may alter, modify, or terminate such agreement.")
rule S6159TerminateForFinancialChange strict {
    for agr: InstallmentAgreement;
    when terminates_or_modifies_agreement(agr) and agreement_financial_condition_changed(agr);
    then power S6159TerminateFinancialChangePower {
        holder Secretary;
        over agr;
        exercise terminates_or_modifies_agreement(agr);
        valid_when s6159_termination_valid(agr);
        effect create(agreement_terminated(agr));
    };
}
@source(IRC_S6159_B, relation = formalizes, coverage = partial, quote = "The Secretary may alter, modify, or terminate an agreement entered into by the Secretary under subsection (a) in the case of the failure of the taxpayer—")
rule S6159TerminateForFailure strict {
    for agr: InstallmentAgreement;
    when terminates_or_modifies_agreement(agr)
        and (agreement_installment_missed(agr) or agreement_other_liability_unpaid(agr) or agreement_financial_update_refused(agr));
    then power S6159TerminateFailurePower {
        holder Secretary;
        over agr;
        exercise terminates_or_modifies_agreement(agr);
        valid_when s6159_termination_valid(agr);
        effect create(agreement_terminated(agr));
    };
}

// --- WIRE-5 (Д-19): the export other owners read — an agreement of the person is in force ---
// "In force" = the agreement is one the Secretary entered under (a) for the person and no termination has
// taken effect (`agreement_terminated`, the effect of the (b) powers). Alteration/modification leaves it in
// force. This is a status of the AGREEMENT; whether the debt is "paid in a timely manner" under it (§7345(b)(2)(A))
// is the reader's own fact.
pub relation installment_agreement_in_force(p: Person) kind institutional {
    label en unofficial "the person is party to a §6159 installment agreement entered by the Secretary and not terminated";
}
@source(IRC_S6159_B, relation = formalizes, coverage = partial, quote = "The Secretary may terminate any agreement entered into by the Secretary under subsection (a) if—")
rule S6159AgreementInForce defeasible {
    for agr: InstallmentAgreement;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    when installment_agreement_for(agr, p, y, kind) and installment_agreement_entered(p, y, kind);
    then installment_agreement_in_force(p);
    unless agreement_terminated(agr) and installment_agreement_for(agr, p, y, kind);
}

// --- §6159(d)-(e): periodic review / administrative-review procedures ------
// TECH_GAP-adjacent: periodic ("at least once every 2 years") approximated as
// `maintenance`, same limitation the joint-committee pilot recorded.

relation agreement_reviewed_every_two_years(agr: InstallmentAgreement) kind empirical;
relation agreement_is_partial_collection(agr: InstallmentAgreement) kind empirical;
@source(IRC_S6159_D, relation = formalizes, coverage = exact, quote = "In the case of an agreement entered into by the Secretary under subsection (a) for partial collection of a tax liability, the Secretary shall review the agreement at least once every 2 years.")
rule S6159ReviewPartialCollectionAgreement strict {
    for agr: InstallmentAgreement;
    when agreement_is_partial_collection(agr);
    then duty ReviewPartialCollectionAgreement {
        bearer Secretary;
        goal maintenance {
            condition agreement_reviewed_every_two_years(agr);
            window [-infinity, infinity];
        }
    };
}

relation independent_administrative_review_established() kind empirical;
@source(IRC_S6159_E, relation = formalizes, coverage = exact, quote = "The Secretary shall establish procedures for an independent administrative review of terminations of installment agreements under this section for taxpayers who request such a review.")
rule S6159EstablishAdministrativeReview strict {
    when true;
    then duty EstablishInstallmentTerminationReviewProcedures {
        bearer Secretary;
        goal maintenance {
            condition independent_administrative_review_established();
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6161 — Extension of time for paying tax
// ============================================================================

entity PaymentExtensionRequest { label en unofficial "a request under §6161 to extend the time for paying tax or a deficiency"; }

relation extension_request_for(req: PaymentExtensionRequest, p: Person, y: TaxableYear, kind: TaxKind) kind institutional;
relation extension_request_is_estate_tax(req: PaymentExtensionRequest) kind empirical;
relation extension_request_taxpayer_abroad(req: PaymentExtensionRequest) kind empirical;
relation extension_from_date(req: PaymentExtensionRequest, d: Date) kind empirical {
    label en unofficial "the date fixed for payment (§6151(a)) from which the §6161(a)(1) extension is measured";
}
relation extension_until_date(req: PaymentExtensionRequest, d: Date) kind empirical;
relation extension_granted_amount_shown_on_return(req: PaymentExtensionRequest) kind institutional;

relation extension_within_six_months(req: PaymentExtensionRequest) kind institutional;
rule S6161ExtensionWithinSixMonths strict {
    for req: PaymentExtensionRequest;
    for from: Date;
    for until: Date;
    when extension_from_date(req, from) and extension_until_date(req, until)
        and until <= add_calendar_period(from, 6 calendar_month);
    then extension_within_six_months(req);
}
relation extension_within_twelve_months(req: PaymentExtensionRequest) kind institutional;
rule S6161ExtensionWithinTwelveMonths strict {
    for req: PaymentExtensionRequest;
    for from: Date;
    for until: Date;
    when extension_from_date(req, from) and extension_until_date(req, until)
        and until <= add_calendar_period(from, 12 calendar_month);
    then extension_within_twelve_months(req);
}

relation extension_length_valid(req: PaymentExtensionRequest) kind institutional {
    label en unofficial "the requested extension does not exceed the §6161(a)(1) limit: 6 months generally, 12 months for estate tax, unlimited if the taxpayer is abroad";
}
rule S6161LengthValidGeneral strict {
    for req: PaymentExtensionRequest;
    when extension_within_six_months(req) and not extension_request_is_estate_tax(req);
    then extension_length_valid(req);
}
rule S6161LengthValidEstate strict {
    for req: PaymentExtensionRequest;
    when extension_within_twelve_months(req) and extension_request_is_estate_tax(req);
    then extension_length_valid(req);
}
@source(IRC_S6161_A, relation = formalizes, coverage = partial, quote = "Such extension may exceed 6 months in the case of a taxpayer who is abroad.")
rule S6161LengthValidAbroad strict {
    for req: PaymentExtensionRequest;
    when extension_request_taxpayer_abroad(req);
    then extension_length_valid(req);
}

@source(IRC_S6161_A, relation = formalizes, coverage = exact, quote = "The Secretary, except as otherwise provided in this title, may extend the time for payment of the amount of the tax shown, or required to be shown, on any return or declaration required under authority of this title (or any installment thereof), for a reasonable period not to exceed 6 months (12 months in the case of estate tax) from the date fixed for payment thereof.")
rule S6161ExtendPaymentOfAmountShown strict {
    for req: PaymentExtensionRequest;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for until: Date;
    when extension_request_for(req, p, y, kind) and extension_until_date(req, until);
    then power S6161ExtendAmountShownPower {
        holder Secretary;
        over p;
        exercise extension_request_for(req, p, y, kind);
        valid_when extension_length_valid(req);
        effect create(extension_granted_amount_shown_on_return(req));
    };
}

// --- §6161(b): extension of time for a deficiency (evaluative: hardship) ---

pub external judgment relation s6161_undue_hardship_shown(p: Person, req: PaymentExtensionRequest) {
    authority Secretary;
    label en official "it is shown to the satisfaction of the Secretary that payment of a deficiency upon the date fixed for the payment thereof will result in undue hardship to the taxpayer";
}
pub external judgment relation s6161_estate_reasonable_cause_shown(p: Person, req: PaymentExtensionRequest) {
    authority Secretary;
    label en official "the Secretary may, for reasonable cause, extend the time for the payment of any deficiency of a tax imposed by chapter 11";
}
relation deficiency_extension_requested(req: PaymentExtensionRequest, p: Person) kind empirical;
relation deficiency_due_to_negligence_disregard_or_fraud(req: PaymentExtensionRequest) kind empirical {
    label en official "the deficiency is due to negligence, to intentional disregard of rules and regulations, or to fraud with intent to evade tax";
}
relation deficiency_extension_granted(req: PaymentExtensionRequest) kind institutional;
relation deficiency_within_eighteen_months(req: PaymentExtensionRequest) kind institutional;
rule S6161DeficiencyWithinEighteenMonths strict {
    for req: PaymentExtensionRequest;
    for from: Date;
    for until: Date;
    when extension_from_date(req, from) and extension_until_date(req, until)
        and until <= add_calendar_period(from, 18 calendar_month);
    then deficiency_within_eighteen_months(req);
}

@source(IRC_S6161_B, relation = formalizes, coverage = partial, quote = "the Secretary may extend the time for the payment of the amount determined as a deficiency of a tax imposed by chapter 1, 12, 41, 42, 43, or 44 for a period not to exceed 18 months from the date fixed for the payment of the deficiency")
rule S6161ExtendDeficiency strict {
    for req: PaymentExtensionRequest;
    for p: Person;
    when deficiency_extension_requested(req, p) and deficiency_within_eighteen_months(req) and s6161_undue_hardship_shown(p, req)
        and not extension_request_is_estate_tax(req) and not deficiency_due_to_negligence_disregard_or_fraud(req);
    then power S6161ExtendDeficiencyPower {
        holder Secretary;
        over p;
        exercise deficiency_extension_requested(req, p);
        valid_when s6161_undue_hardship_shown(p, req);
        effect create(deficiency_extension_granted(req));
    };
}

// ============================================================================
// §§6163-6167 — extension/security/deferral (section-level; see header note)
// ============================================================================

// --- §6163: extension for reversionary or remainder interest in an estate --

relation reversionary_interest_extension_requested(p: Person, y: TaxableYear) kind empirical {
    label en official "the executor elects, the extension of time for payment of the part of the tax imposed by section 2001 attributable to a reversionary or remainder interest";
}
relation reversionary_interest_extension_granted(p: Person, y: TaxableYear) kind institutional;
@source(IRC_S6163_A, relation = formalizes, coverage = partial, quote = "the payment of the part of the tax under chapter 11 attributable to such interest may, at the election of the executor, be postponed until 6 months after the termination of the precedent interest or interests in the property")
rule S6163PostponeReversionaryInterestTax strict {
    for p: Person;
    for y: TaxableYear;
    when reversionary_interest_extension_requested(p, y);
    then power S6163PostponeReversionaryInterestPower {
        holder Secretary;
        over p;
        exercise reversionary_interest_extension_requested(p, y);
        valid_when reversionary_interest_extension_requested(p, y);
        effect create(reversionary_interest_extension_granted(p, y));
    };
}

// --- §6164: extension for corporation expecting a carryback of an NOL ------

relation corporation_nol_carryback_extension_requested(p: Person, y: TaxableYear) kind empirical {
    label en official "a corporation which establishes that the tentative carryback adjustment resulting from the expected net operating loss carryback shall be extended";
}
relation corporation_nol_carryback_extension_granted(p: Person, y: TaxableYear) kind institutional;
@source(IRC_S6164_A, relation = formalizes, coverage = partial, quote = "the time for payment of all or part of any tax imposed by subtitle A for the taxable year immediately preceding such taxable year shall be extended")
rule S6164PostponeNolCarrybackAmount strict {
    for p: Person;
    for y: TaxableYear;
    when corporation_nol_carryback_extension_requested(p, y);
    then power S6164PostponeNolCarrybackPower {
        holder Secretary;
        over p;
        exercise corporation_nol_carryback_extension_requested(p, y);
        valid_when corporation_nol_carryback_extension_requested(p, y);
        effect create(corporation_nol_carryback_extension_granted(p, y));
    };
}

// --- §6165: bond requirement as a condition of an extension -----------------

relation bond_required_for_extension(req: PaymentExtensionRequest) kind institutional {
    label en official "the Secretary is authorized... to require the person requesting such extension to furnish a bond in such amount... as the Secretary may determine to be necessary";
}
relation bond_furnished(req: PaymentExtensionRequest) kind empirical;
relation extension_effective_with_bond(req: PaymentExtensionRequest) kind institutional;
@source(IRC_S6165, relation = formalizes, coverage = partial, quote = "the Secretary may require the taxpayer to furnish a bond in such amount (not exceeding double the amount with respect to which the extension is granted) conditioned upon the payment of the amount extended in accordance with the terms of such extension")
rule S6165ExtensionEffectiveOnceBondFurnished strict {
    for req: PaymentExtensionRequest;
    when bond_required_for_extension(req) and bond_furnished(req);
    then extension_effective_with_bond(req);
}

// --- §6166: extension for estates consisting largely of a closely held
// business — SECTION-LEVEL power only; qualification tests are TECH_GAP
// (see header note; coverage rows 26/6166/*).

relation closely_held_business_extension_elected(p: Person, y: TaxableYear) kind empirical {
    label en official "if the executor elects the benefits of this section... the executor may elect to pay part or all of the tax in 2 or more (but not exceeding 10) equal installments";
}
relation closely_held_business_qualification_shown(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "TECH_GAP: the value of an interest in a closely held business exceeds 35 percent of the adjusted gross estate (§6166(a)(1)) — the valuation/aggregation test itself (§6166(b),(c)) is not implemented, only referenced";
}
relation closely_held_business_installments_granted(p: Person, y: TaxableYear) kind institutional;
@source(IRC_S6166_A, relation = formalizes, coverage = partial, quote = "the executor may elect to pay part or all of the tax imposed by section 2001 in 2 or more (but not exceeding 10) equal installments")
rule S6166ElectInstallmentsForClosleyHeldBusiness strict {
    for p: Person;
    for y: TaxableYear;
    when closely_held_business_extension_elected(p, y) and closely_held_business_qualification_shown(p, y);
    then power S6166CloselyHeldBusinessInstallmentsPower {
        holder Secretary;
        over p;
        exercise closely_held_business_extension_elected(p, y);
        valid_when closely_held_business_qualification_shown(p, y);
        effect create(closely_held_business_installments_granted(p, y));
    };
}

// --- §6167: installment election for a foreign expropriation loss recovery -
// CORRECTED from an earlier draft that mismodeled this section as a generic
// NOL-carryback extension: §6167 actually elects 10 equal installments for
// the tax attributable to a §1351 foreign-expropriation-loss recovery, where
// the money portion of the recovery is below the statutory 25% ceiling.

relation foreign_expropriation_loss_recovery(p: Person, y: TaxableYear) kind empirical {
    label en official "a corporation has a recovery of a foreign expropriation loss to which section 1351 applies";
}
relation recovery_money_portion_below_threshold(p: Person, y: TaxableYear) kind empirical {
    label en official "the portion of the recovery received in money is less than 25 percent of the amount of such recovery (as defined in section 1351(c)) and is not greater than the tax attributable to such recovery";
}
relation s6167_eligible(p: Person, y: TaxableYear) kind institutional;
rule S6167Eligible strict {
    for p: Person;
    for y: TaxableYear;
    when foreign_expropriation_loss_recovery(p, y) and recovery_money_portion_below_threshold(p, y);
    then s6167_eligible(p, y);
}

relation s6167_installment_election_made(p: Person, y: TaxableYear) kind empirical;
relation s6167_ten_installments_granted(p: Person, y: TaxableYear) kind institutional;
@source(IRC_S6167_A, relation = formalizes, coverage = partial, quote = "the tax attributable to such recovery shall, at the election of the taxpayer, be payable in 10 equal installments on the 15th day of the fourth month of each of the taxable years following the taxable year of the recovery")
rule S6167ElectTenEqualInstallments strict {
    for p: Person;
    for y: TaxableYear;
    when s6167_installment_election_made(p, y);
    then power S6167TenInstallmentsPower {
        holder Secretary;
        over p;
        exercise s6167_installment_election_made(p, y);
        valid_when s6167_eligible(p, y);
        effect create(s6167_ten_installments_granted(p, y));
    };
}
