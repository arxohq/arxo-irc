// 26 U.S.C. §6413 — Chapter 65, Subchapter A: special refund/adjustment rules
// for certain employment taxes (FICA §3101/3111, RRTA §3201/3221, income-tax
// withholding §3402, FUTA §3302). Modeled at the depth the task's "only if
// short" instruction invites: the core adjustment/refund/no-interest rules
// are executable; the "deemed a separate employer" definitional machinery of
// (a)(2)-(5) and (c)(2)(A)-(G) is NON_NORMATIVE-adjacent — it exists to widen
// WHO counts as "employer" for federal/territorial/State government payroll
// situations, states no independent testable condition beyond that
// definitional substitution, and is not read by any other rule in this
// package's stage-1 scope; see coverage rows 26/6413/a/2 through
// 26/6413/a/5 and 26/6413/c/2/*.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - (a)(1) is modeled as a duty on the Secretary to make the adjustment,
//    "without interest" captured by NOT creating any overpayment-interest
//    relation from 06-interest.law for this adjustment path (interest is
//    simply never asserted for it, rather than a separate negative rule).
//  - (c)(1) (excess FICA/RRTA tax withheld across more than one employer in
//    a calendar year, above the Social Security contribution and benefit
//    base) is executable ONLY given the wage-base parameter as a case fact
//    (`social_security_contribution_and_benefit_base`): this snapshot does
//    not pin the annual Social Security Administration wage-base figure
//    (published outside Title 26) — SOURCE_GAP, see coverage row
//    26/6413/c/1/u1. The rule reads the parameter rather than inventing a
//    number, per the method note on unpinned statutory parameters.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6413_A,
    IRC_S6413_B,
    IRC_S6413_C,
    IRC_S6413_D,
    Person,
    Secretary,
    TaxKind,
    TaxableYear,
    overpayment_amount,
};

// --- (a)(1): adjustment without interest -------------------------------------

relation employment_tax_overwithheld(p: Person, y: TaxableYear, kind: TaxKind, excess: Money) kind empirical {
    label en official "more than the correct amount of tax imposed by section 3101, 3111, 3201, 3221, or 3402 is paid with respect to any payment of remuneration";
}
relation employment_tax_adjustment_possible(p: Person, y: TaxableYear, kind: TaxKind) kind empirical {
    label en unofficial "the overpayment CAN be adjusted against a later payment of remuneration (§6413(a)), rather than needing a refund under (b)";
}
relation employment_tax_adjustment_made(p: Person, y: TaxableYear, kind: TaxKind) kind institutional;

@source(IRC_S6413_A, relation = formalizes, coverage = partial, quote = "If more than the correct amount of tax imposed by section 3101, 3111, 3201, 3221, or 3402 is paid with respect to any payment of remuneration, proper adjustments, with respect to both the tax and the amount to be deducted, shall be made, without interest, in such manner and at such times as the Secretary may by regulations prescribe.")
rule S6413AdjustOverwithheldEmploymentTax strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for excess: Money;
    when employment_tax_overwithheld(p, y, kind, excess) and employment_tax_adjustment_possible(p, y, kind);
    then duty AdjustOverwithheldEmploymentTax {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition employment_tax_adjustment_made(p, y, kind);
            window [-infinity, infinity];
        }
    };
}

// --- (b): refund when adjustment cannot be made -----------------------------

relation employment_tax_overwithheld_refunded(p: Person, y: TaxableYear, kind: TaxKind) kind institutional;
@source(IRC_S6413_B, relation = formalizes, coverage = exact, quote = "If more than the correct amount of tax imposed by section 3101, 3111, 3201, 3221, or 3402 is paid or deducted with respect to any payment of remuneration and the overpayment cannot be adjusted under subsection (a) of this section, the amount of the overpayment shall be refunded in such manner and at such times (subject to the statute of limitations properly applicable thereto) as the Secretary may by regulations prescribe.")
rule S6413RefundWhenAdjustmentNotPossible strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for excess: Money;
    when employment_tax_overwithheld(p, y, kind, excess) and not employment_tax_adjustment_possible(p, y, kind);
    then duty RefundOverwithheldEmploymentTax {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition employment_tax_overwithheld_refunded(p, y, kind);
            window [-infinity, infinity];
        }
    };
}

// --- (c)(1): special refund for wages from more than one employer ----------

relation multiple_employer_fica_or_rrta_wages(p: Person, y: TaxableYear, total_wages: Money) kind empirical {
    label en official "an employee receiving wages from more than one employer during a calendar year";
}
relation social_security_contribution_and_benefit_base(y: TaxableYear, base: Money) kind empirical {
    label en unofficial "SOURCE_GAP: the Social Security contribution and benefit base for the year (SSA-published parameter, not pinned in this snapshot — §230 of the Social Security Act)";
}
relation multiple_employer_tax_withheld(p: Person, y: TaxableYear, withheld: Money) kind empirical {
    label en official "any amount of tax... deducted from the employee's wages (whether or not paid to the Secretary)";
}
pub relation multiple_employer_special_refund_amount(p: Person, y: TaxableYear, amount: Money) kind institutional;

@source(IRC_S6413_C, relation = formalizes, coverage = partial, quote = "the employee shall be entitled (subject to the provisions of section 31(b)) to a credit or refund of any amount of tax, with respect to such wages, imposed by section 3101(a) or section 3201(a) (to the extent of so much of the rate applicable under section 3201(a) as does not exceed the rate of tax in effect under section 3101(a)), or by both such sections, and deducted from the employee's wages (whether or not paid to the Secretary), which exceeds the tax with respect to the amount of such wages received in such year which is equal to such contribution and benefit base")
rule S6413SpecialRefundExcessOverWageBase strict {
    for p: Person;
    for y: TaxableYear;
    for total_wages: Money;
    for base: Money;
    for withheld: Money;
    when multiple_employer_fica_or_rrta_wages(p, y, total_wages)
        and social_security_contribution_and_benefit_base(y, base)
        and multiple_employer_tax_withheld(p, y, withheld)
        and total_wages > base;
    then multiple_employer_special_refund_amount(p, y, max(0 USD, withheld - round(withheld * (base / total_wages), 2, "HALF_UP")));
}

// --- (d): refund/credit of FUTA tax --------------------------------------

relation futa_credit_not_previously_allowed(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "Any credit allowable under section 3302, to the extent not previously allowed";
}
@source(IRC_S6413_D, relation = formalizes, coverage = exact, quote = "Any credit allowable under section 3302, to the extent not previously allowed, shall be considered an overpayment, but no interest shall be allowed or paid with respect to such overpayment.")
rule S6413FutaCreditIsOverpaymentNoInterest strict {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when futa_credit_not_previously_allowed(p, y, amount);
    then overpayment_amount(p, y, us.irc.core::FutaCh23, amount);
}
