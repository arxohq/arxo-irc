// Payment, refunds, interest -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Placeholder relations of this package that name a norm owned by a lower package are derived from the owner's `pub` relation. The
// case-fact channel stays valid (WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    DecedentEstate,
    IRC_S6151_B,
    IRC_S6166_G,
    Person,
    TaxableYear,
    elects_under_s6014,
    estate_distributable_net_income,
};

// --- section 643: distributable net income of the estate (owner: trusts_estates) ---------------------------------------------------
// `DecedentEstate` is declared a subtype of `Person`, the key of the owner's relation.

@source(IRC_S6166_G, relation = formalizes, coverage = partial, quote = "the distributable net income of the estate for such taxable year (as defined in section 643)")
rule W10EstateDistributableNetIncomeFromOwner(e: DecedentEstate, y: TaxableYear, amount: Money) strict {
    label en official "the distributable net income of the estate of section 643 is the amount the trusts-estates package computes";
    when us.irc.trusts_estates::distributable_net_income(e, y, amount);
    then estate_distributable_net_income(e, y, amount);
}

// --- section 6014: the election not to show the tax on the return (owner: returns) -----------------------------------------------

@source(IRC_S6151_B, relation = formalizes, coverage = partial, quote = "If the taxpayer elects under section 6014 not to show the tax on the return")
rule W10ElectsUnderS6014FromOwner(p: us.irc.core::Individual, y: TaxableYear) strict {
    label en official "an individual whose section 6014 election is in effect according to the returns package elected not to show the tax on the return";
    when us.irc.returns::elects_tax_not_shown_6014(p, y);
    then elects_under_s6014(p, y);
}
