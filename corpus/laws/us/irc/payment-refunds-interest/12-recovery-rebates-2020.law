// 26 U.S.C. §§6428 and 6428A — 2020 recovery rebates (CARES Act §2201; the
// Consolidated Appropriations Act, 2021 additional rebate). Stage 2. Chapter 65,
// Subchapter B. Sections 6428 and 6428A have the same skeleton — the credit
// for the first taxable year beginning in 2020 (basic amount, joint amount,
// per-child amount, 5 percent phase-out over an AGI threshold, reduction by
// the advance refund, identification-number rules) and an ADVANCE REFUND
// deemed paid for the first taxable year beginning in 2019 — so both are
// written from one template (this file is written by a generator only in
// the sense that the two blocks are textually parallel; every rule carries
// its own `@source` quote and is edited by hand from here on).
//
// JUDGMENT CALLS AND GAPS
//  - The statutory amounts and AGI thresholds are A3 datasets
//    (`recovery-rebate-*.lawparam.json`), valid from the enactment date of
//    each section (a single-year credit read at any later `legal_time`); the
//    taxable-year gate ("first taxable year beginning in 2020") is a
//    condition on the beginning of the year.
//  - "Unless the taxpayer includes the valid identification number" is a
//    fact about the return: the identification-number facts come in pairs
//    (`included` / `omitted`); absence of both gives NEITHER, not zero
//    (unknown is not negative).
//  - The 5 percent phase-out is exact decimal arithmetic rounded to cents
//    HALF_UP (JUDGMENT CALL: the statute names no rounding).
//  - The advance refund amount is the SAME computation applied to the 2019
//    (or, under (f)(5), 2018) year's facts; the amounts actually refunded are
//    case facts used by the (e)(1) reduction. (e)(2) halves a refund made
//    with respect to a joint return between the two spouses.
//  - The credit's own year gate and the advance-refund year gate are the two
//    places the taxable-year boundary enters; a year that begins in neither
//    2019 nor 2020 yields no amount.
//  - Delivery to accounts, waiver of Title 31 disbursement rules, payments
//    to representative payees and the cross-referenced enforcement provisions
//    ((f)(3)(B)-(C), (f)(6)) are modelled as Secretary powers, an
//    official's immunity, and a duty of the payee; the cited Social Security,
//    Railroad Retirement and Title 38 enforcement provisions are external.
//  - §6428A(f)(5) (use of agency-provided data for non-filers) is a Secretary
//    power over "specified individuals"; the four beneficiary classes are
//    case-asserted memberships (external statutes: Social Security Act,
//    Railroad Retirement Act, title 38), the identification-number rule of
//    (g)(6) then treats a number provided under (f)(5) as included.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6428A_A,
    IRC_S6428A_B,
    IRC_S6428A_C,
    IRC_S6428A_D,
    IRC_S6428A_E,
    IRC_S6428A_F,
    IRC_S6428A_G,
    IRC_S6428_A,
    IRC_S6428_B,
    IRC_S6428_C,
    IRC_S6428_D,
    IRC_S6428_E,
    IRC_S6428_F,
    IRC_S6428_G,
    Person,
    Secretary,
    TaxableYear,
};

enum RebateFilingStatus {
    JointReturn;
    SurvivingSpouse;
    HeadOfHousehold;
    OtherStatus;
    label en unofficial "the filing status that selects the AGI threshold of a recovery rebate (joint return or surviving spouse; head of household; any other taxpayer)";
}
relation rebate_taxpayer(p: Person, y: TaxableYear, status: RebateFilingStatus, agi: Money) kind empirical {
    label en unofficial "the individual's status and adjusted gross income for the taxable year";
}
relation nonresident_alien_individual(p: Person) kind empirical { label en official "any nonresident alien individual"; }
relation dependency_deduction_allowable_to_another(p: Person, y: TaxableYear) kind empirical {
    label en official "any individual with respect to whom a deduction under section 151 is allowable to another taxpayer for a taxable year beginning in the calendar year in which the individual's taxable year begins";
}
relation estate_or_trust_taxpayer(p: Person) kind empirical { label en official "an estate or trust"; }
relation own_valid_identification_number_included(p: Person, y: TaxableYear) kind institutional { label en official "the taxpayer includes the valid identification number of the taxpayer on the return of tax for the taxable year"; }
relation own_valid_identification_number_omitted(p: Person, y: TaxableYear) kind empirical { label en unofficial "the return omits the taxpayer's valid identification number"; }
relation joint_return_identification_numbers_included(p: Person, y: TaxableYear, spouses_with_number: Integer) kind empirical {
    label en official "in the case of a joint return, the number of spouses (0, 1 or 2) whose valid identification number is included on the return";
}
relation armed_forces_spouse_on_joint_return(p: Person, y: TaxableYear) kind empirical { label en official "at least 1 spouse was a member of the Armed Forces of the United States at any time during the taxable year"; }
relation qualifying_child_of_taxpayer(p: Person, y: TaxableYear, child: Person) kind empirical { label en official "a qualifying child of the taxpayer (within the meaning of section 24(c))"; }
relation child_valid_identification_number_included(child: Person, y: TaxableYear) kind institutional { label en official "the valid identification number of such qualifying child is included on the return of tax for the taxable year (an adoption taxpayer identification number counts for a child adopted or placed for adoption)"; }
relation no_return_filed_for_2019_year(p: Person) kind empirical { label en official "at the time of the determination under paragraph (3) the individual has not filed a tax return for the year described in paragraph (1)"; }
relation advance_refund_paid_single_return(p: Person, amount: Money) kind empirical { label en official "a refund or credit made or allowed to the taxpayer under subsection (f) with respect to a return other than a joint return"; }
relation advance_refund_paid_joint_return(p: Person, amount: Money) kind empirical { label en official "a refund or credit made or allowed under subsection (f) with respect to a joint return (half is treated as made to each individual filing the return)"; }

// ============================================================================
// §6428 — Recovery rebates for individuals (CARES Act)
// ============================================================================

// (d): eligible individual.
relation eligible_individual_6428(p: Person, y: TaxableYear) kind institutional {
    label en official "any individual other than a nonresident alien, an individual for whom another taxpayer may claim a section 151 deduction, and an estate or trust";
}
@source(IRC_S6428_D, relation = formalizes, coverage = exact, quote = "the term \"eligible individual\" means any individual other than—")
rule S6428EligibleIndividual strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi)
        and not_known(nonresident_alien_individual(p)) and not_known(dependency_deduction_allowable_to_another(p, y)) and not_known(estate_or_trust_taxpayer(p));
    then eligible_individual_6428(p, y);
}

// (g): identification-number rules on the basic amount.
relation basic_amount_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the $1,200 ($2,400 joint) amount of subsection (a)(1) after the identification-number rules of subsection (g)";
}
@source(IRC_S6428_G, relation = formalizes, coverage = exact, quote = "In the case of a return other than a joint return, the $1,200 amount in subsection (a)(1) shall be treated as being zero unless the taxpayer includes the valid identification number of the taxpayer on the return of tax for the taxable year.")
rule S6428BasicAmountNonJointWithNumber strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and own_valid_identification_number_included(p, y);
    then basic_amount_6428(p, y, RecoveryRebate6428BasicAmount);
}
rule S6428BasicAmountNonJointWithoutNumber strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and own_valid_identification_number_omitted(p, y);
    then basic_amount_6428(p, y, 0 USD);
}
@source(IRC_S6428_G, relation = formalizes, coverage = exact, quote = "In the case of a joint return, the $2,400 amount in subsection (a)(1) shall be treated as being—")
rule S6428BasicAmountJointBothNumbers strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 2);
    then basic_amount_6428(p, y, RecoveryRebate6428JointAmount);
}
rule S6428BasicAmountJointOneNumber strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 1) and not_known(armed_forces_spouse_on_joint_return(p, y));
    then basic_amount_6428(p, y, RecoveryRebate6428BasicAmount);
}
@source(IRC_S6428_G, relation = formalizes, coverage = exact, quote = "Paragraphs (1)(B) and (2)(B) shall not apply in the case where at least 1 spouse was a member of the Armed Forces of the United States at any time during the taxable year and the valid identification number of at least 1 spouse is included on the return of tax for the taxable year.")
rule S6428BasicAmountJointOneNumberArmedForces strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 1) and armed_forces_spouse_on_joint_return(p, y);
    then basic_amount_6428(p, y, RecoveryRebate6428JointAmount);
}
rule S6428BasicAmountJointNoNumber strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 0);
    then basic_amount_6428(p, y, 0 USD);
}
// A qualifying child counts only if the taxpayer's number (one spouse's, on a
// joint return) and the child's number are both included.
relation taxpayer_number_condition_met_6428(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer includes the taxpayer's valid identification number (on a joint return, the number of at least 1 spouse)";
}
rule S6428TaxpayerNumberNonJoint strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and own_valid_identification_number_included(p, y);
    then taxpayer_number_condition_met_6428(p, y);
}
rule S6428TaxpayerNumberJointOne strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 1);
    then taxpayer_number_condition_met_6428(p, y);
}
rule S6428TaxpayerNumberJointTwo strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 2);
    then taxpayer_number_condition_met_6428(p, y);
}
relation children_amount_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "$500 multiplied by the number of qualifying children whose valid identification number is included";
}
@source(IRC_S6428_G, relation = formalizes, coverage = exact, quote = "A qualifying child of a taxpayer shall not be taken into account under subsection (a)(2) unless—")
rule S6428ChildrenAmount strict {
    for p: Person;
    for y: TaxableYear;
    when taxpayer_number_condition_met_6428(p, y);
    then children_amount_6428(p, y, RecoveryRebate6428ChildAmount * (count all child: Person where qualifying_child_of_taxpayer(p, y, child) and child_valid_identification_number_included(child, y)));
}
rule S6428ChildrenAmountWithoutTaxpayerNumber strict {
    for p: Person;
    for y: TaxableYear;
    when own_valid_identification_number_omitted(p, y);
    then children_amount_6428(p, y, 0 USD);
}

relation gross_credit_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the basic amount and the children amount (subsection (a)), determined without regard to subsections (c) and (e)";
}
@source(IRC_S6428_A, relation = formalizes, coverage = exact, quote = "there shall be allowed as a credit against the tax imposed by subtitle A for the first taxable year beginning in 2020 an amount equal to the sum of—")
rule S6428GrossCredit strict {
    for p: Person;
    for y: TaxableYear;
    for basic: Money;
    for children: Money;
    when basic_amount_6428(p, y, basic) and children_amount_6428(p, y, children);
    then gross_credit_6428(p, y, basic + children);
}
// (c): phase-out.
relation phaseout_threshold_6428(p: Person, y: TaxableYear, threshold: Money) kind institutional {
    label en official "$150,000 for a joint return or a surviving spouse, $112,500 for a head of household, $75,000 for any other taxpayer";
}
@source(IRC_S6428_C, relation = formalizes, coverage = exact, quote = "(1) $150,000 in the case of a joint return or a surviving spouse (as defined in section 2(a)),")
rule S6428ThresholdJoint strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi);
    then phaseout_threshold_6428(p, y, RecoveryRebate6428PhaseoutJoint);
}
rule S6428ThresholdSurvivingSpouse strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, SurvivingSpouse, agi);
    then phaseout_threshold_6428(p, y, RecoveryRebate6428PhaseoutJoint);
}
@source(IRC_S6428_C, relation = formalizes, coverage = exact, quote = "(2) $112,500 in the case of a head of household, and")
rule S6428ThresholdHeadOfHousehold strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, HeadOfHousehold, agi);
    then phaseout_threshold_6428(p, y, RecoveryRebate6428PhaseoutHeadOfHousehold);
}
@source(IRC_S6428_C, relation = formalizes, coverage = exact, quote = "(3) $75,000 in the case of a taxpayer not described in paragraph (1) or (2).")
rule S6428ThresholdOther strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, OtherStatus, agi);
    then phaseout_threshold_6428(p, y, RecoveryRebate6428PhaseoutOther);
}
relation phaseout_reduction_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "5 percent of so much of the taxpayer's adjusted gross income as exceeds the threshold";
}
@source(IRC_S6428_C, relation = formalizes, coverage = exact, quote = "shall be reduced (but not below zero) by 5 percent of so much of the taxpayer's adjusted gross income as exceeds—")
rule S6428PhaseoutReduction strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    for threshold: Money;
    when rebate_taxpayer(p, y, status, agi) and phaseout_threshold_6428(p, y, threshold);
    then phaseout_reduction_6428(p, y, round(max(0 USD, agi - threshold) * RecoveryRebate6428PhaseoutRate, 2, "HALF_UP"));
}
pub relation credit_before_advance_refund_reduction_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit, reduced (but not below zero) by the phase-out, before the reduction for advance refunds under subsection (e)";
}
rule S6428CreditAfterPhaseout strict {
    for p: Person;
    for y: TaxableYear;
    for gross: Money;
    for reduction: Money;
    when gross_credit_6428(p, y, gross) and phaseout_reduction_6428(p, y, reduction) and eligible_individual_6428(p, y);
    then credit_before_advance_refund_reduction_6428(p, y, max(0 USD, gross - reduction));
}
// (e): reduction by advance refunds and credits.
relation advance_refund_reduction_6428(p: Person, amount: Money) kind institutional {
    label en official "the aggregate refunds and credits made or allowed to the taxpayer under subsection (f) (half of a refund with respect to a joint return is treated as made to each individual filing the return)";
}
@source(IRC_S6428_E, relation = formalizes, coverage = exact, quote = "The amount of credit which would (but for this paragraph) be allowable under this section shall be reduced (but not below zero) by the aggregate refunds and credits made or allowed to the taxpayer under subsection (f).")
rule S6428AdvanceRefundReduction strict {
    for p: Person;
    when advance_refund_owner_6428(p);
    then advance_refund_reduction_6428(p, (sum all a: Money for q: Person where advance_refund_paid_single_return(q, a) and q == p) + (sum all b: Money for r: Person where advance_refund_paid_joint_return(r, b) and r == p) * 0.5);
}
relation advance_refund_owner_6428(p: Person) kind institutional { label en unofficial "helper: the individual has a credit computed and may have received an advance refund"; }
rule S6428AdvanceRefundOwner strict {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when credit_before_advance_refund_reduction_6428(p, y, amt);
    then advance_refund_owner_6428(p);
}
pub relation allowed_credit_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit allowed for the first taxable year beginning in 2020 after the reduction for advance refunds";
}
@source(IRC_S6428_E, relation = formalizes, coverage = exact, quote = "The amount of credit which would (but for this paragraph) be allowable under this section shall be reduced (but not below zero) by the aggregate refunds and credits made or allowed to the taxpayer under subsection (f).")
rule S6428AllowedCredit strict {
    for p: Person;
    for y: TaxableYear;
    for before: Money;
    for reduction: Money;
    for b: Date;
    when credit_before_advance_refund_reduction_6428(p, y, before) and advance_refund_reduction_6428(p, reduction) and us.irc.core::begins(y, b) and b >= @2020-01-01 and b <= @2020-12-31;
    then allowed_credit_6428(p, y, max(0 USD, before - reduction));
}
relation credit_claimed_without_reduction_6428(p: Person, y: TaxableYear, claimed: Money) kind empirical { label en unofficial "the amount of the credit the taxpayer claims on the return"; }
relation failure_to_reduce_is_math_or_clerical_error_6428(p: Person, y: TaxableYear) kind institutional {
    label en official "any failure to so reduce the credit shall be treated as arising out of a mathematical or clerical error and assessed according to section 6213(b)(1)";
}
@source(IRC_S6428_E, relation = formalizes, coverage = exact, quote = "Any failure to so reduce the credit shall be treated as arising out of a mathematical or clerical error and assessed according to section 6213(b)(1).")
rule S6428FailureToReduceIsMathError strict {
    for p: Person;
    for y: TaxableYear;
    for claimed: Money;
    for allowed: Money;
    when credit_claimed_without_reduction_6428(p, y, claimed) and allowed_credit_6428(p, y, allowed) and claimed > allowed;
    then failure_to_reduce_is_math_or_clerical_error_6428(p, y);
}
relation valid_number_omission_is_math_or_clerical_error_6428(p: Person, y: TaxableYear) kind institutional {
    label en official "any omission of a correct valid identification number required under subsection (g) shall be treated as a mathematical or clerical error for purposes of applying section 6213(g)(2)";
}
@source(IRC_S6428_G, relation = formalizes, coverage = exact, quote = "Any omission of a correct valid identification number required under this subsection shall be treated as a mathematical or clerical error for purposes of applying section 6213(g)(2) to such omission.")
rule S6428NumberOmissionIsMathError strict {
    for p: Person;
    for y: TaxableYear;
    when own_valid_identification_number_omitted(p, y);
    then valid_number_omission_is_math_or_clerical_error_6428(p, y);
}
// (b): the credit is a subpart C credit (refundable).
relation credit_treated_as_subpart_C_credit_6428(p: Person, y: TaxableYear) kind institutional { label en official "the credit allowed by subsection (a) shall be treated as allowed by subpart C of part IV of subchapter A of chapter 1"; }
@source(IRC_S6428_B, relation = formalizes, coverage = exact, quote = "The credit allowed by subsection (a) shall be treated as allowed by subpart C of part IV of subchapter A of chapter 1.")
rule S6428CreditIsSubpartCCredit strict {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when allowed_credit_6428(p, y, amt);
    then credit_treated_as_subpart_C_credit_6428(p, y);
}

// (f): the advance refund for the first taxable year beginning in 2019.
relation advance_refund_basis_year_6428(p: Person, y: TaxableYear) kind institutional {
    label en official "the individual's first taxable year beginning in 2019 (or, under (f)(5), 2018 when no 2019 return has been filed)";
}
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "each individual who was an eligible individual for such individual's first taxable year beginning in 2019")
rule S6428BasisYear2019 strict {
    for p: Person;
    for y: TaxableYear;
    for b: Date;
    when eligible_individual_6428(p, y) and us.irc.core::begins(y, b) and b >= @2019-01-01 and b <= @2019-12-31;
    then advance_refund_basis_year_6428(p, y);
}
@source(IRC_S6428_F, relation = formalizes, coverage = partial, quote = "apply such paragraph by substituting \"2018\" for \"2019\"")
rule S6428BasisYear2018 defeasible {
    for p: Person;
    for y: TaxableYear;
    for b: Date;
    when eligible_individual_6428(p, y) and no_return_filed_for_2019_year(p) and us.irc.core::begins(y, b) and b >= @2018-01-01 and b <= @2018-12-31;
    then advance_refund_basis_year_6428(p, y);
}

// (g)(2): no refund is payable to an eligible individual who does not include the individual's number, the spouse's number on a joint return, and the numbers of children counted.
relation advance_refund_ids_ok_6428(p: Person, y: TaxableYear) kind institutional {
    label en official "no refund shall be payable under subsection (f) unless the return includes the individual's valid identification number and, on a joint return, the spouse's (unless a spouse is in the Armed Forces and one number is included)";
}
@source(IRC_S6428_G, relation = formalizes, coverage = exact, quote = "No refund shall be payable under subsection (f) to an eligible individual who does not include on the return of tax for the taxable year—")
rule S6428AdvanceRefundIdsOkNonJoint strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and own_valid_identification_number_included(p, y);
    then advance_refund_ids_ok_6428(p, y);
}
rule S6428AdvanceRefundIdsOkJointBoth strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 2);
    then advance_refund_ids_ok_6428(p, y);
}
rule S6428AdvanceRefundIdsOkJointArmedForces strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, 1) and armed_forces_spouse_on_joint_return(p, y);
    then advance_refund_ids_ok_6428(p, y);
}
rule S6428AdvanceRefundAmountZeroNonJointWithoutNumber defeasible {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when advance_refund_basis_year_6428(p, y) and rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and own_valid_identification_number_omitted(p, y);
    then advance_refund_amount_6428(p, y, 0 USD);
}
rule S6428AdvanceRefundAmountZeroJointWithoutBothNumbers defeasible {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    for n: Integer;
    when advance_refund_basis_year_6428(p, y) and rebate_taxpayer(p, y, JointReturn, agi) and joint_return_identification_numbers_included(p, y, n) and n < 2 and not_known(armed_forces_spouse_on_joint_return(p, y));
    then advance_refund_amount_6428(p, y, 0 USD);
}

pub relation advance_refund_amount_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount that would have been allowed as a credit under this section for the basis year if this section (other than subsection (e) and (f)) had applied to that year";
}
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "the advance refund amount is the amount that would have been allowed as a credit under this section for such taxable year if this section (other than subsection (e) and this subsection) had applied to such taxable year.")
rule S6428AdvanceRefundAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_basis_year_6428(p, y) and credit_before_advance_refund_reduction_6428(p, y, amt) and advance_refund_ids_ok_6428(p, y);
    then advance_refund_amount_6428(p, y, amt);

}
pub relation advance_refund_treated_as_payment_6428(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the individual is treated as having made a payment against the tax imposed by chapter 1 for the basis year equal to the advance refund amount";
}
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "shall be treated as having made a payment against the tax imposed by chapter 1 for such taxable year in an amount equal to the advance refund amount for such taxable year.")
rule S6428AdvanceRefundTreatedAsPayment defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_amount_6428(p, y, amt);
    then advance_refund_treated_as_payment_6428(p, y, amt);
}
// (f)(3)(A): timing.
relation advance_refund_paid_on_6428(p: Person, y: TaxableYear, d: Date) kind empirical { label en unofficial "a refund or credit attributable to subsection (f) is made or allowed on the date"; }
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "No refund or credit shall be made or allowed under this subsection after December 31, 2020.")
rule S6428NoAdvanceRefundAfterDeadline strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    when advance_refund_paid_on_6428(p, y, d) and d > @2020-12-31;
    then prohibition NoAdvanceRefundAfterDeadline6428 {
        bearer Secretary;
        action advance_refund_paid_on_6428(p, y, d);
        window [-infinity, infinity];
    };
}
relation advance_refund_interest_paid_6428(p: Person, y: TaxableYear) kind empirical { label en unofficial "interest is allowed on an overpayment attributable to subsection (f)"; }
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "No interest shall be allowed on any overpayment attributable to this subsection.")
rule S6428NoInterestOnAdvanceRefund strict {
    for p: Person;
    for y: TaxableYear;
    when advance_refund_interest_paid_6428(p, y);
    then prohibition NoInterestOnAdvanceRefund6428 {
        bearer Secretary;
        action advance_refund_interest_paid_6428(p, y);
        window [-infinity, infinity];
    };
}
relation advance_refund_duty_to_pay_6428(p: Person, y: TaxableYear) kind institutional { label en official "the Secretary shall refund or credit any overpayment attributable to subsection (f) as rapidly as possible"; }
relation advance_refund_made_6428(p: Person, y: TaxableYear) kind empirical;
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "The Secretary shall, subject to the provisions of this title, refund or credit any overpayment attributable to this subsection as rapidly as possible.")
rule S6428DutyToRefundAdvanceAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_treated_as_payment_6428(p, y, amt) and amt > 0 USD;
    then duty RefundAdvanceRecoveryRebate6428 {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition advance_refund_made_6428(p, y);
            window [-infinity, @2020-12-31];
        }
    };
}
// (f)(3)(B): electronic delivery; (f)(3)(C): disbursing officials.
relation payee_authorized_account_after_6428(p: Person) kind empirical { label en official "an account to which the payee authorized, on or after the statutory date, the delivery of a refund of taxes or of a Federal payment"; }
relation secretary_disburses_electronically_6428(p: Person) kind empirical;
relation refund_delivered_electronically_6428(p: Person) kind institutional;
@source(IRC_S6428_F, relation = formalizes, coverage = partial, quote = "the Secretary may certify and disburse refunds payable under this subsection electronically to any account to which the payee authorized, on or after January 1, 2018, the delivery of a refund of taxes under this title or of a Federal payment")
rule S6428ElectronicDisbursementPower strict {
    for p: Person;
    when advance_refund_owner_6428(p);
    then power S6428ElectronicDisbursementPowerOfSecretary {
        holder Secretary;
        over p;
        exercise secretary_disburses_electronically_6428(p);
        valid_when payee_authorized_account_after_6428(p);
        effect create(refund_delivered_electronically_6428(p));
    };
}
relation disbursing_official_modified_payment_information_6428(o: Person) kind empirical { label en official "a disbursing official in the executive branch may modify payment information for the purpose of facilitating the accurate and efficient delivery of the payment"; }
relation disbursing_official_fraud_or_reckless_neglect_6428(o: Person) kind empirical { label en official "fraud or reckless neglect"; }
relation disbursing_official_liability_imposed_6428(o: Person) kind empirical { label en official "liability under sections 3325, 3527, 3528, or 3529 of title 31 is imposed"; }
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "Except in cases of fraud or reckless neglect, no liability under sections 3325, 3527, 3528, or 3529 of title 31, United States Code, shall be imposed with respect to payments made under this subparagraph.")
rule S6428DisbursingOfficialImmunity defeasible {
    for o: Person;
    when disbursing_official_modified_payment_information_6428(o);
    then immunity DisbursingOfficialNoTitle31Liability6428 {
        holder o;
        protected_effect disbursing_official_liability_imposed_6428(o);
        window [-infinity, infinity];
    };
    unless disbursing_official_fraud_or_reckless_neglect_6428(o);
}
// (f)(7)/(6): notice of distribution.
relation payment_distributed_on_6428(p: Person, d: Date) kind empirical { label en official "the Secretary distributed a payment to an eligible taxpayer pursuant to subsection (f)"; }
relation payment_notice_mailed_6428(p: Person) kind empirical { label en official "notice sent by mail to the taxpayer's last known address indicating the method by which the payment was made, its amount, and a telephone number for the appropriate Internal Revenue Service point of contact"; }
@source(IRC_S6428_F, relation = formalizes, coverage = exact, quote = "Not later than 15 days after the date on which the Secretary distributed any payment to an eligible taxpayer pursuant to this subsection, notice shall be sent by mail to such taxpayer's last known address.")
rule S6428DutyToMailPaymentNotice strict {
    for p: Person;
    for d: Date;
    when payment_distributed_on_6428(p, d);
    then duty MailRecoveryRebatePaymentNotice6428 {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition payment_notice_mailed_6428(p);
            window [d, add_calendar_period(d, 15 calendar_day)];
        }
    };
}
// Representative payees and fiduciaries.
relation payment_made_to_representative_payee_6428(p: Person, payee: Person) kind empirical { label en official "the payment is made to the individual's representative payee or fiduciary"; }
relation entire_payment_provided_or_used_for_benefit_6428(p: Person) kind empirical { label en official "the entire payment is (i) provided to the individual entitled to it, or (ii) used only for the benefit of that individual"; }
@source(IRC_S6428_F, relation = formalizes, coverage = partial, quote = "the entire payment shall be—")
rule S6428RepresentativePayeeMustApplyPaymentForBenefit strict {
    for p: Person;
    for payee: Person;
    when payment_made_to_representative_payee_6428(p, payee);
    then duty ApplyRebatePaymentForBenefitOfIndividual6428 {
        bearer payee;
        beneficiary p;
        goal achievement {
            condition entire_payment_provided_or_used_for_benefit_6428(p);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6428A — Additional 2020 recovery rebates for individuals
// ============================================================================

// (d): eligible individual.
relation eligible_individual_6428A(p: Person, y: TaxableYear) kind institutional {
    label en official "any individual other than a nonresident alien, an individual for whom another taxpayer may claim a section 151 deduction, and an estate or trust";
}
@source(IRC_S6428A_D, relation = formalizes, coverage = exact, quote = "the term \"eligible individual\" means any individual other than—")
rule S6428AEligibleIndividual strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi)
        and not_known(nonresident_alien_individual(p)) and not_known(dependency_deduction_allowable_to_another(p, y)) and not_known(estate_or_trust_taxpayer(p));
    then eligible_individual_6428A(p, y);
}

// (g): identification-number rules on the basic amount.
relation basic_amount_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the $600 ($1,200 joint) amount of subsection (a)(1) after the identification-number rules of subsection (g)";
}
@source(IRC_S6428A_G, relation = formalizes, coverage = exact, quote = "In the case of a return other than a joint return, the $600 amount in subsection (a)(1) shall be treated as being zero unless the taxpayer includes the valid identification number of the taxpayer on the return of tax for the taxable year.")
rule S6428ABasicAmountNonJointWithNumber strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and effective_own_number_included_6428A(p, y);
    then basic_amount_6428A(p, y, RecoveryRebate6428ABasicAmount);
}
rule S6428ABasicAmountNonJointWithoutNumber strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and effective_own_number_omitted_6428A(p, y);
    then basic_amount_6428A(p, y, 0 USD);
}
@source(IRC_S6428A_G, relation = formalizes, coverage = exact, quote = "In the case of a joint return, the $1,200 amount in subsection (a)(1) shall be treated as being—")
rule S6428ABasicAmountJointBothNumbers strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428A(p, y, 2);
    then basic_amount_6428A(p, y, RecoveryRebate6428AJointAmount);
}
rule S6428ABasicAmountJointOneNumber strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428A(p, y, 1) and not_known(armed_forces_spouse_on_joint_return(p, y));
    then basic_amount_6428A(p, y, RecoveryRebate6428ABasicAmount);
}
@source(IRC_S6428A_G, relation = formalizes, coverage = exact, quote = "Paragraph (2) shall not apply in the case where at least 1 spouse was a member of the Armed Forces of the United States at any time during the taxable year and the valid identification number of at least 1 spouse is included on the return of tax for the taxable year.")
rule S6428ABasicAmountJointOneNumberArmedForces strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428A(p, y, 1) and armed_forces_spouse_on_joint_return(p, y);
    then basic_amount_6428A(p, y, RecoveryRebate6428AJointAmount);
}
rule S6428ABasicAmountJointNoNumber strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428A(p, y, 0);
    then basic_amount_6428A(p, y, 0 USD);
}
// A qualifying child counts only if the taxpayer's number (one spouse's, on a
// joint return) and the child's number are both included.
relation taxpayer_number_condition_met_6428A(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer includes the taxpayer's valid identification number (on a joint return, the number of at least 1 spouse)";
}
rule S6428ATaxpayerNumberNonJoint strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and effective_own_number_included_6428A(p, y);
    then taxpayer_number_condition_met_6428A(p, y);
}
rule S6428ATaxpayerNumberJointOne strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428A(p, y, 1);
    then taxpayer_number_condition_met_6428A(p, y);
}
rule S6428ATaxpayerNumberJointTwo strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428A(p, y, 2);
    then taxpayer_number_condition_met_6428A(p, y);
}
relation children_amount_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "$600 multiplied by the number of qualifying children whose valid identification number is included";
}
@source(IRC_S6428A_G, relation = formalizes, coverage = exact, quote = "A qualifying child of a taxpayer shall not be taken into account under subsection (a)(2) unless—")
rule S6428AChildrenAmount strict {
    for p: Person;
    for y: TaxableYear;
    when taxpayer_number_condition_met_6428A(p, y)
        and not_known(children_excluded_by_death_6428A(p, y));
    then children_amount_6428A(p, y, RecoveryRebate6428AChildAmount * (count all child: Person where qualifying_child_of_taxpayer(p, y, child) and child_valid_identification_number_included(child, y)));
}
rule S6428AChildrenAmountWithoutTaxpayerNumber strict {
    for p: Person;
    for y: TaxableYear;
    when effective_own_number_omitted_6428A(p, y);
    then children_amount_6428A(p, y, 0 USD);
}
rule S6428AChildrenAmountZeroWhenExcludedByDeath strict {
    for p: Person;
    for y: TaxableYear;
    when children_excluded_by_death_6428A(p, y);
    then children_amount_6428A(p, y, 0 USD);
}
relation gross_credit_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the basic amount and the children amount (subsection (a)), determined without regard to subsections (c) and (e)";
}
@source(IRC_S6428A_A, relation = formalizes, coverage = exact, quote = "there shall be allowed as a credit against the tax imposed by subtitle A for the first taxable year beginning in 2020 an amount equal to the sum of—")
rule S6428AGrossCredit strict {
    for p: Person;
    for y: TaxableYear;
    for basic: Money;
    for children: Money;
    when basic_amount_6428A(p, y, basic) and children_amount_6428A(p, y, children);
    then gross_credit_6428A(p, y, basic + children);
}
// (c): phase-out.
relation phaseout_threshold_6428A(p: Person, y: TaxableYear, threshold: Money) kind institutional {
    label en official "$150,000 for a joint return or a surviving spouse, $112,500 for a head of household, $75,000 for any other taxpayer";
}
@source(IRC_S6428A_C, relation = formalizes, coverage = exact, quote = "(1) $150,000 in the case of a joint return or a surviving spouse (as defined in section 2(a)),")
rule S6428AThresholdJoint strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi);
    then phaseout_threshold_6428A(p, y, RecoveryRebate6428APhaseoutJoint);
}
rule S6428AThresholdSurvivingSpouse strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, SurvivingSpouse, agi);
    then phaseout_threshold_6428A(p, y, RecoveryRebate6428APhaseoutJoint);
}
@source(IRC_S6428A_C, relation = formalizes, coverage = exact, quote = "(2) $112,500 in the case of a head of household (as defined in section 2(b)), and")
rule S6428AThresholdHeadOfHousehold strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, HeadOfHousehold, agi);
    then phaseout_threshold_6428A(p, y, RecoveryRebate6428APhaseoutHeadOfHousehold);
}
@source(IRC_S6428A_C, relation = formalizes, coverage = exact, quote = "(3) $75,000 in the case of a taxpayer not described in paragraph (1) or (2).")
rule S6428AThresholdOther strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, OtherStatus, agi);
    then phaseout_threshold_6428A(p, y, RecoveryRebate6428APhaseoutOther);
}
relation phaseout_reduction_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "5 percent of so much of the taxpayer's adjusted gross income as exceeds the threshold";
}
@source(IRC_S6428A_C, relation = formalizes, coverage = exact, quote = "shall be reduced (but not below zero) by 5 percent of so much of the taxpayer's adjusted gross income as exceeds—")
rule S6428APhaseoutReduction strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    for threshold: Money;
    when rebate_taxpayer(p, y, status, agi) and phaseout_threshold_6428A(p, y, threshold);
    then phaseout_reduction_6428A(p, y, round(max(0 USD, agi - threshold) * RecoveryRebate6428APhaseoutRate, 2, "HALF_UP"));
}
pub relation credit_before_advance_refund_reduction_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit, reduced (but not below zero) by the phase-out, before the reduction for advance refunds under subsection (e)";
}
rule S6428ACreditAfterPhaseout strict {
    for p: Person;
    for y: TaxableYear;
    for gross: Money;
    for reduction: Money;
    when gross_credit_6428A(p, y, gross) and phaseout_reduction_6428A(p, y, reduction) and eligible_individual_6428A(p, y);
    then credit_before_advance_refund_reduction_6428A(p, y, max(0 USD, gross - reduction));
}
// (e): reduction by advance refunds and credits.
relation advance_refund_reduction_6428A(p: Person, amount: Money) kind institutional {
    label en official "the aggregate refunds and credits made or allowed to the taxpayer under subsection (f) (half of a refund with respect to a joint return is treated as made to each individual filing the return)";
}
@source(IRC_S6428A_E, relation = formalizes, coverage = exact, quote = "The amount of the credit which would (but for this paragraph) be allowable under this section shall be reduced (but not below zero) by the aggregate refunds and credits made or allowed to the taxpayer under subsection (f).")
rule S6428AAdvanceRefundReduction strict {
    for p: Person;
    when advance_refund_owner_6428A(p);
    then advance_refund_reduction_6428A(p, (sum all a: Money for q: Person where advance_refund_paid_single_return(q, a) and q == p) + (sum all b: Money for r: Person where advance_refund_paid_joint_return(r, b) and r == p) * 0.5);
}
relation advance_refund_owner_6428A(p: Person) kind institutional { label en unofficial "helper: the individual has a credit computed and may have received an advance refund"; }
rule S6428AAdvanceRefundOwner strict {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when credit_before_advance_refund_reduction_6428A(p, y, amt);
    then advance_refund_owner_6428A(p);
}
pub relation allowed_credit_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit allowed for the first taxable year beginning in 2020 after the reduction for advance refunds";
}
@source(IRC_S6428A_E, relation = formalizes, coverage = exact, quote = "The amount of the credit which would (but for this paragraph) be allowable under this section shall be reduced (but not below zero) by the aggregate refunds and credits made or allowed to the taxpayer under subsection (f).")
rule S6428AAllowedCredit strict {
    for p: Person;
    for y: TaxableYear;
    for before: Money;
    for reduction: Money;
    for b: Date;
    when credit_before_advance_refund_reduction_6428A(p, y, before) and advance_refund_reduction_6428A(p, reduction) and us.irc.core::begins(y, b) and b >= @2020-01-01 and b <= @2020-12-31;
    then allowed_credit_6428A(p, y, max(0 USD, before - reduction));
}
relation credit_claimed_without_reduction_6428A(p: Person, y: TaxableYear, claimed: Money) kind empirical { label en unofficial "the amount of the credit the taxpayer claims on the return"; }
relation failure_to_reduce_is_math_or_clerical_error_6428A(p: Person, y: TaxableYear) kind institutional {
    label en official "any failure to so reduce the credit shall be treated as arising out of a mathematical or clerical error and assessed according to section 6213(b)(1)";
}
@source(IRC_S6428A_E, relation = formalizes, coverage = exact, quote = "Any failure to so reduce the credit shall be treated as arising out of a mathematical or clerical error and assessed according to section 6213(b)(1).")
rule S6428AFailureToReduceIsMathError strict {
    for p: Person;
    for y: TaxableYear;
    for claimed: Money;
    for allowed: Money;
    when credit_claimed_without_reduction_6428A(p, y, claimed) and allowed_credit_6428A(p, y, allowed) and claimed > allowed;
    then failure_to_reduce_is_math_or_clerical_error_6428A(p, y);
}
relation valid_number_omission_is_math_or_clerical_error_6428A(p: Person, y: TaxableYear) kind institutional {
    label en official "any omission of a correct valid identification number required under subsection (g) shall be treated as a mathematical or clerical error for purposes of applying section 6213(g)(2)";
}
@source(IRC_S6428A_G, relation = formalizes, coverage = exact, quote = "Any omission of a correct valid identification number required under this subsection shall be treated as a mathematical or clerical error for purposes of applying section 6213(g)(2) to such omission.")
rule S6428ANumberOmissionIsMathError strict {
    for p: Person;
    for y: TaxableYear;
    when effective_own_number_omitted_6428A(p, y);
    then valid_number_omission_is_math_or_clerical_error_6428A(p, y);
}
// (b): the credit is a subpart C credit (refundable).
relation credit_treated_as_subpart_C_credit_6428A(p: Person, y: TaxableYear) kind institutional { label en official "the credit allowed by subsection (a) shall be treated as allowed by subpart C of part IV of subchapter A of chapter 1"; }
@source(IRC_S6428A_B, relation = formalizes, coverage = exact, quote = "The credit allowed by subsection (a) shall be treated as allowed by subpart C of part IV of subchapter A of chapter 1.")
rule S6428ACreditIsSubpartCCredit strict {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when allowed_credit_6428A(p, y, amt);
    then credit_treated_as_subpart_C_credit_6428A(p, y);
}

// (f): the advance refund for the first taxable year beginning in 2019.
relation advance_refund_basis_year_6428A(p: Person, y: TaxableYear) kind institutional {
    label en official "the individual's first taxable year beginning in 2019 (or, under (f)(5), 2018 when no 2019 return has been filed)";
}
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "Each individual who was an eligible individual for such individual's first taxable year beginning in 2019")
rule S6428ABasisYear2019 strict {
    for p: Person;
    for y: TaxableYear;
    for b: Date;
    when eligible_individual_6428A(p, y) and us.irc.core::begins(y, b) and b >= @2019-01-01 and b <= @2019-12-31;
    then advance_refund_basis_year_6428A(p, y);
}


pub relation advance_refund_amount_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount that would have been allowed as a credit under this section for the basis year if this section (other than subsection (e) and (f)) had applied to that year";
}
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "the advance refund amount is the amount that would have been allowed as a credit under this section for such taxable year if this section (other than subsection (e) and this subsection) had applied to such taxable year.")
rule S6428AAdvanceRefundAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_basis_year_6428A(p, y) and credit_before_advance_refund_reduction_6428A(p, y, amt);
    then advance_refund_amount_6428A(p, y, amt);

}
pub relation advance_refund_treated_as_payment_6428A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the individual is treated as having made a payment against the tax imposed by chapter 1 for the basis year equal to the advance refund amount";
}
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "shall be treated as having made a payment against the tax imposed by chapter 1 for such taxable year in an amount equal to the advance refund amount for such taxable year.")
rule S6428AAdvanceRefundTreatedAsPayment defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_amount_6428A(p, y, amt);
    then advance_refund_treated_as_payment_6428A(p, y, amt);
}
// (f)(3)(A): timing.
relation advance_refund_paid_on_6428A(p: Person, y: TaxableYear, d: Date) kind empirical { label en unofficial "a refund or credit attributable to subsection (f) is made or allowed on the date"; }
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "no refund or credit shall be made or allowed under this subsection after January 15, 2021.")
rule S6428ANoAdvanceRefundAfterDeadline strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    when advance_refund_paid_on_6428A(p, y, d) and d > @2021-01-15;
    then prohibition NoAdvanceRefundAfterDeadline6428A {
        bearer Secretary;
        action advance_refund_paid_on_6428A(p, y, d);
        window [-infinity, infinity];
    };
}
relation advance_refund_interest_paid_6428A(p: Person, y: TaxableYear) kind empirical { label en unofficial "interest is allowed on an overpayment attributable to subsection (f)"; }
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "No interest shall be allowed on any overpayment attributable to this subsection.")
rule S6428ANoInterestOnAdvanceRefund strict {
    for p: Person;
    for y: TaxableYear;
    when advance_refund_interest_paid_6428A(p, y);
    then prohibition NoInterestOnAdvanceRefund6428A {
        bearer Secretary;
        action advance_refund_interest_paid_6428A(p, y);
        window [-infinity, infinity];
    };
}
relation advance_refund_duty_to_pay_6428A(p: Person, y: TaxableYear) kind institutional { label en official "the Secretary shall refund or credit any overpayment attributable to subsection (f) as rapidly as possible"; }
relation advance_refund_made_6428A(p: Person, y: TaxableYear) kind empirical;
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "The Secretary shall, subject to the provisions of this title, refund or credit any overpayment attributable to this subsection as rapidly as possible.")
rule S6428ADutyToRefundAdvanceAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_treated_as_payment_6428A(p, y, amt) and amt > 0 USD;
    then duty RefundAdvanceRecoveryRebate6428A {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition advance_refund_made_6428A(p, y);
            window [-infinity, @2021-01-15];
        }
    };
}
// (f)(3)(B): electronic delivery; (f)(3)(C): disbursing officials.
relation payee_authorized_account_after_6428A(p: Person) kind empirical { label en official "an account to which the payee authorized, on or after the statutory date, the delivery of a refund of taxes or of a Federal payment (on or after January 1, 2019); an account from which the payee made a payment of taxes on or after January 1, 2019; or a Treasury-sponsored account"; }
relation secretary_disburses_electronically_6428A(p: Person) kind empirical;
relation refund_delivered_electronically_6428A(p: Person) kind institutional;
@source(IRC_S6428A_F, relation = formalizes, coverage = partial, quote = "the Secretary may certify and disburse refunds payable under this subsection electronically to—")
rule S6428AElectronicDisbursementPower strict {
    for p: Person;
    when advance_refund_owner_6428A(p);
    then power S6428AElectronicDisbursementPowerOfSecretary {
        holder Secretary;
        over p;
        exercise secretary_disburses_electronically_6428A(p);
        valid_when payee_authorized_account_after_6428A(p);
        effect create(refund_delivered_electronically_6428A(p));
    };
}
relation disbursing_official_modified_payment_information_6428A(o: Person) kind empirical { label en official "a disbursing official in the executive branch may modify payment information for the purpose of facilitating the accurate and efficient delivery of the payment"; }
relation disbursing_official_fraud_or_reckless_neglect_6428A(o: Person) kind empirical { label en official "fraud or reckless neglect"; }
relation disbursing_official_liability_imposed_6428A(o: Person) kind empirical { label en official "liability under sections 3325, 3527, 3528, or 3529 of title 31 is imposed"; }
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "Except in cases of fraud or reckless neglect, no liability under sections 3325, 3527, 3528, or 3529 of title 31, United States Code, shall be imposed with respect to payments made under this subparagraph.")
rule S6428ADisbursingOfficialImmunity defeasible {
    for o: Person;
    when disbursing_official_modified_payment_information_6428A(o);
    then immunity DisbursingOfficialNoTitle31Liability6428A {
        holder o;
        protected_effect disbursing_official_liability_imposed_6428A(o);
        window [-infinity, infinity];
    };
    unless disbursing_official_fraud_or_reckless_neglect_6428A(o);
}
// (f)(7)/(6): notice of distribution.
relation payment_distributed_on_6428A(p: Person, d: Date) kind empirical { label en official "the Secretary distributed a payment to an eligible taxpayer pursuant to subsection (f)"; }
relation payment_notice_mailed_6428A(p: Person) kind empirical { label en official "notice sent by mail to the taxpayer's last known address indicating the method by which the payment was made, its amount, and a telephone number for the appropriate Internal Revenue Service point of contact"; }
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "As soon as practicable after the date on which the Secretary distributed any payment to an eligible taxpayer pursuant to this subsection, the Secretary shall send notice by mail to such taxpayer's last known address.")
rule S6428ADutyToMailPaymentNotice strict {
    for p: Person;
    for d: Date;
    when payment_distributed_on_6428A(p, d);
    then duty MailRecoveryRebatePaymentNotice6428A {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition payment_notice_mailed_6428A(p);
            window [d, infinity];
        }
    };
}
// Representative payees and fiduciaries.
relation payment_made_to_representative_payee_6428A(p: Person, payee: Person) kind empirical { label en official "the payment is made to the individual's representative payee or fiduciary"; }
relation entire_payment_provided_or_used_for_benefit_6428A(p: Person) kind empirical { label en official "the entire payment is (i) provided to the individual entitled to it, or (ii) used only for the benefit of that individual"; }
@source(IRC_S6428A_F, relation = formalizes, coverage = partial, quote = "and the entire payment shall be used only for the benefit of the individual who is entitled to the payment.")
rule S6428ARepresentativePayeeMustApplyPaymentForBenefit strict {
    for p: Person;
    for payee: Person;
    when payment_made_to_representative_payee_6428A(p, payee);
    then duty ApplyRebatePaymentForBenefitOfIndividual6428A {
        bearer payee;
        beneficiary p;
        goal achievement {
            condition entire_payment_provided_or_used_for_benefit_6428A(p);
            window [-infinity, infinity];
        }
    };
}


// (f)(5): alternate taxable year and agency information for non-filers.
relation no_return_for_2018_year(p: Person) kind empirical { label en official "the individual has not filed a tax return for the individual's first taxable year beginning in 2018"; }
relation secretary_uses_form_ssa_or_rrb_1099_6428(p: Person) kind empirical;
relation form_1099_information_used_6428(p: Person) kind institutional;
@source(IRC_S6428_F, relation = formalizes, coverage = partial, quote = "use information with respect to such individual for calendar year 2019 provided in—")
rule S6428UseForm1099InformationPower strict {
    for p: Person;
    when no_return_filed_for_2019_year(p);
    then power S6428Form1099InformationPower {
        holder Secretary;
        over p;
        exercise secretary_uses_form_ssa_or_rrb_1099_6428(p);
        valid_when individual_filed_no_2018_return_6428(p);
        effect create(form_1099_information_used_6428(p));
    };
}
relation individual_filed_no_2018_return_6428(p: Person) kind institutional { label en unofficial "the individual has filed no return for either 2019 or 2018 (the (f)(5)(B) condition)"; }
rule S6428NoReturnFor2018AndNoReturnFor2019 strict {
    for p: Person;
    when no_return_filed_for_2019_year(p) and no_return_for_2018_year(p);
    then individual_filed_no_2018_return_6428(p);
}

// (f)(2)(A)-(B): individuals deceased before January 1, 2020.
relation deceased_before_2020(p: Person) kind empirical { label en official "any individual who was deceased before January 1, 2020"; }
relation deceased_spouses_with_numbers_before_2020(p: Person, y: TaxableYear, k: Integer) kind empirical { label en official "in the case of a joint return, the number of spouses (0, 1, 2) deceased before January 1, 2020 whose valid identification number is treated as not included"; }
relation effective_own_number_included_6428A(p: Person, y: TaxableYear) kind institutional { label en official "the taxpayer's valid identification number is included and the taxpayer was not deceased before 2020 (subsection (f)(2)(A)), or a number provided under (f)(5) is treated as included ((g)(6))"; }
rule S6428AEffectiveOwnNumberIncluded strict {
    for p: Person;
    for y: TaxableYear;
    when own_valid_identification_number_included(p, y) and not_known(deceased_before_2020(p));
    then effective_own_number_included_6428A(p, y);
}
rule S6428AEffectiveOwnNumberProvidedUnderF5 strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and identification_number_provided_under_f5(p);
    then effective_own_number_included_6428A(p, y);
}
relation effective_own_number_omitted_6428A(p: Person, y: TaxableYear) kind institutional { label en official "the taxpayer's valid identification number is not included, or the taxpayer was deceased before 2020 so the number is treated as not included"; }
rule S6428AEffectiveOwnNumberOmitted strict {
    for p: Person;
    for y: TaxableYear;
    when own_valid_identification_number_omitted(p, y);
    then effective_own_number_omitted_6428A(p, y);
}
rule S6428AEffectiveOwnNumberOmittedDeceased strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and deceased_before_2020(p);
    then effective_own_number_omitted_6428A(p, y);
}
relation effective_joint_numbers_6428A(p: Person, y: TaxableYear, n: Integer) kind institutional { label en official "the number of spouses whose valid identification number counts after treating spouses deceased before 2020 as not included"; }
rule S6428AEffectiveJointNumbersAdjusted strict {
    for p: Person;
    for y: TaxableYear;
    for raw: Integer;
    for k: Integer;
    when joint_return_identification_numbers_included(p, y, raw) and deceased_spouses_with_numbers_before_2020(p, y, k);
    then effective_joint_numbers_6428A(p, y, max(0, raw - k));
}
rule S6428AEffectiveJointNumbersUnadjusted strict {
    for p: Person;
    for y: TaxableYear;
    for raw: Integer;
    when joint_return_identification_numbers_included(p, y, raw) and not_known(deceased_spouses_with_numbers_before_2020(p, y, 1)) and not_known(deceased_spouses_with_numbers_before_2020(p, y, 2));
    then effective_joint_numbers_6428A(p, y, raw);
}
relation children_excluded_by_death_6428A(p: Person, y: TaxableYear) kind institutional { label en official "no amount is determined with respect to any qualifying child if the taxpayer was deceased before January 1, 2020 or, on a joint return, both taxpayers were"; }
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "no amount shall be determined under this subsection with respect to any qualifying child of the taxpayer if—")
rule S6428AChildrenExcludedTaxpayerDeceased strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and deceased_before_2020(p);
    then children_excluded_by_death_6428A(p, y);
}
rule S6428AChildrenExcludedBothSpousesDeceased strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and deceased_spouses_with_numbers_before_2020(p, y, 2);
    then children_excluded_by_death_6428A(p, y);
}
// (f)(3)(A)(ii)(II): mirror code possessions: earlier of the Secretary's date and 2021-09-30.
relation mirror_code_possession_6428A(pos: Person) kind empirical { label en official "a possession of the United States which has a mirror code tax system (section 272(c) of the COVID-related Tax Relief Act of 2020)"; }
relation secretary_determined_possession_deadline(pos: Person, d: Date) kind empirical { label en official "such date as is determined appropriate by the Secretary"; }
relation possession_refund_paid_on(pos: Person, d: Date) kind empirical;
relation possession_deadline_6428A(pos: Person, d: Date) kind institutional { label en official "the earlier of the Secretary's date and September 30, 2021"; }
rule S6428APossessionDeadlineSecretaryEarlier strict {
    for pos: Person;
    for d: Date;
    when mirror_code_possession_6428A(pos) and secretary_determined_possession_deadline(pos, d) and d <= @2021-09-30;
    then possession_deadline_6428A(pos, d);
}
rule S6428APossessionDeadlineStatutoryEarlier strict {
    for pos: Person;
    for d: Date;
    when mirror_code_possession_6428A(pos) and secretary_determined_possession_deadline(pos, d) and d > @2021-09-30;
    then possession_deadline_6428A(pos, @2021-09-30);
}
rule S6428APossessionDeadlineNoSecretaryDate strict {
    for pos: Person;
    when mirror_code_possession_6428A(pos) and not_known(secretary_determined_possession_deadline(pos, @2021-09-30)) and not_known(secretary_determined_possession_deadline(pos, @2021-01-15));
    then possession_deadline_6428A(pos, @2021-09-30);
}
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "no refund or credit shall be made or allowed under this subsection after the earlier of—")
rule S6428ANoPossessionRefundAfterDeadline strict {
    for pos: Person;
    for d: Date;
    for paid: Date;
    when possession_deadline_6428A(pos, d) and possession_refund_paid_on(pos, paid) and paid > d;
    then prohibition NoPossessionAdvanceRefundAfterDeadline {
        bearer Secretary;
        action possession_refund_paid_on(pos, paid);
        window [-infinity, infinity];
    };
}
// (f)(5): agency information for specified individuals who filed no 2019 return.
relation entitled_to_title_II_benefit_last_month(p: Person) kind empirical { label en official "for the last month for which the Secretary has available information as of the date of enactment of this section, entitled to any monthly insurance benefit payable under title II of the Social Security Act"; }
relation title_II_benefit_not_payable_by_reason_of_202x1A_or_1129A(p: Person) kind empirical { label en official "such benefit is not payable for such month by reason of section 202(x)(1)(A) of the Social Security Act or section 1129A of such Act"; }
relation eligible_for_title_XVI_benefit_last_month(p: Person) kind empirical { label en official "for the last month, eligible for a monthly benefit payable under title XVI of the Social Security Act (including 1614(a)(3)(C), 1619(a), 1631 payments and State supplementary payments)"; }
relation title_XVI_benefit_not_payable_by_reason_of_1611e1A_or_1129A(p: Person) kind empirical { label en official "such monthly benefit is not payable for such month by reason of section 1611(e)(1)(A) or section 1129A of the Social Security Act"; }
relation entitled_to_railroad_annuity_last_month(p: Person) kind empirical { label en official "for the last month, entitled to a monthly annuity or pension payment payable under section 2(a)(1), 2(c), 2(d)(1) or 7(b)(2) of the Railroad Retirement Act of 1974"; }
relation entitled_to_veterans_compensation_or_pension_last_month(p: Person) kind empirical { label en official "for the last month, entitled to a compensation or pension payment payable under the title 38 sections listed in subparagraph (F)(i) to a veteran, surviving spouse, child, or parent"; }
relation veterans_payment_not_payable_or_reduced_by_1505_or_5313(p: Person) kind empirical { label en official "such compensation or pension payment is not payable, or was reduced, for such month by reason of section 1505 or 5313 of title 38"; }
relation specified_individual_6428A(p: Person) kind institutional { label en official "a specified social security beneficiary, specified supplemental security income recipient, specified railroad retirement beneficiary, or specified veterans beneficiary"; }
rule S6428ASpecifiedSocialSecurityBeneficiary strict { for p: Person; when entitled_to_title_II_benefit_last_month(p) and not_known(title_II_benefit_not_payable_by_reason_of_202x1A_or_1129A(p)); then specified_individual_6428A(p); }
rule S6428ASpecifiedSsiRecipient strict { for p: Person; when eligible_for_title_XVI_benefit_last_month(p) and not_known(title_XVI_benefit_not_payable_by_reason_of_1611e1A_or_1129A(p)); then specified_individual_6428A(p); }
rule S6428ASpecifiedRailroadBeneficiary strict { for p: Person; when entitled_to_railroad_annuity_last_month(p); then specified_individual_6428A(p); }
rule S6428ASpecifiedVeteransBeneficiary strict { for p: Person; when entitled_to_veterans_compensation_or_pension_last_month(p) and not_known(veterans_payment_not_payable_or_reduced_by_1505_or_5313(p)); then specified_individual_6428A(p); }
relation secretary_uses_agency_information_6428A(p: Person) kind empirical;
relation agency_information_used_6428A(p: Person) kind institutional;
relation identification_number_provided_under_f5(p: Person) kind empirical { label en official "a valid identification number provided pursuant to subsection (f)(5) is treated as included on the taxpayer's return of tax"; }
relation specified_individual_without_2019_return_6428A(p: Person) kind institutional { label en official "a specified individual who, at the time of the determination under paragraph (3), has not filed a tax return for the year described in paragraph (1)"; }
rule S6428ASpecifiedWithoutReturn strict { for p: Person; when specified_individual_6428A(p) and no_return_filed_for_2019_year(p); then specified_individual_without_2019_return_6428A(p); }
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "the Secretary may use information with respect to such individual which is provided by—")
rule S6428ASecretaryMayUseAgencyInformation strict {
    for p: Person;
    when specified_individual_without_2019_return_6428A(p);
    then power S6428AAgencyInformationPower {
        holder Secretary;
        over p;
        exercise secretary_uses_agency_information_6428A(p);
        valid_when specified_individual_without_2019_return_6428A(p);
        effect create(agency_information_used_6428A(p));
    };
}
relation not_specified_individual_but_eligible_6428A(p: Person, y: TaxableYear) kind institutional { label en official "an individual shall not fail to be treated as an eligible individual merely because such individual is not a specified individual"; }
@source(IRC_S6428A_F, relation = formalizes, coverage = exact, quote = "An individual shall not fail to be treated as an eligible individual for purposes of this subsection or subsection (a) merely because such individual is not a specified individual")
rule S6428ANotSpecifiedStillEligible strict {
    for p: Person;
    for y: TaxableYear;
    when eligible_individual_6428A(p, y) and not_known(specified_individual_6428A(p));
    then not_specified_individual_but_eligible_6428A(p, y);
}

// ============================================================================
// SSA readers (IRC-G/G6, 2026-09-27): (f)(6)(B) and (f)(5)(h)(ii) route a
// payment by beneficiary class to an external enforcement provision —
// (i)/(I) SSA §1129(a)(3), (ii)/(II) RRA §13, (iii)/(III) title 38
// §§5502/6106/6108 (rows 26/6428/f/6/b/u1–u3, 26/6428A/f/5/h/ii/u1–u3).
// Pattern G4/CFR: class membership enters as case-selected facts. Honest
// boundary: the SSA package (`us.ssa.title42_values`) pins 42 USC 415/416/
// 423/430/1320f/1395x/1396p/1397jj — §1129(a)(3) (42 USC 1320a-8) is NOT
// pinned, and the Railroad Retirement Act / title 38 were never in G6
// scope; the from-package leg waits for registry + lock --write + flip
// (step 6, owner gate).
// ============================================================================
enum RebateBeneficiaryClass {
    SocialSecurityOrSsi;
    RailroadRetirement;
    Veterans;
    label en unofficial "the beneficiary class routing a recovery-rebate payment to its external enforcement provision";
}
relation rebate_payment_beneficiary_class_6428(p: Person, class: RebateBeneficiaryClass) kind empirical {
    label en unofficial "the section 6428(f)(6)(A) payment is made with respect to a beneficiary of the class, case-asserted under the external statute";
}
relation rebate_payment_subject_to_external_enforcement_6428(p: Person, class: RebateBeneficiaryClass) kind institutional {
    label en official "section 6428(f)(6)(B): the external enforcement provision of the class applies to the payment as to a payment under its own act";
}
@source(IRC_S6428_F, relation = formalizes, coverage = partial, quote = "(i) In the case of a payment described in subparagraph (A) which is made with respect to a social security beneficiary or a supplemental security income recipient, section 1129(a)(3) of the Social Security Act (42 U.S.C. 1320a–8(a)(3)) shall apply to such payment in the same manner as such section applies to a payment under title II or XVI of such Act.")
rule S6428F6BExternalEnforcementRouting strict {
    for p: Person;
    for class: RebateBeneficiaryClass;
    when rebate_payment_beneficiary_class_6428(p, class);
    then rebate_payment_subject_to_external_enforcement_6428(p, class);
}
relation specified_rebate_payment_beneficiary_class_6428A(p: Person, class: RebateBeneficiaryClass) kind empirical {
    label en unofficial "the section 6428A(f)(5)(h)(i) payment is made with respect to a specified beneficiary of the class, case-asserted under the external statute";
}
relation specified_rebate_payment_subject_to_external_enforcement_6428A(p: Person, class: RebateBeneficiaryClass) kind institutional {
    label en official "section 6428A(f)(5)(h)(ii): the external enforcement provision of the class applies to the payment as to a payment under its own act";
}
@source(IRC_S6428A_F, relation = formalizes, coverage = partial, quote = "(I) In the case of a payment described in clause (i) which is made with respect to a specified social security beneficiary or a specified supplemental security income recipient, section 1129(a)(3) of the Social Security Act (42 U.S.C. 1320a–8(a)(3)) shall apply to such payment in the same manner as such section applies to a payment under title II or XVI of such Act.")
rule S6428AF5HiiExternalEnforcementRouting strict {
    for p: Person;
    for class: RebateBeneficiaryClass;
    when specified_rebate_payment_beneficiary_class_6428A(p, class);
    then specified_rebate_payment_subject_to_external_enforcement_6428A(p, class);
}
