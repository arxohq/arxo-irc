// 26 U.S.C. 6417(d)(1)(D)(ii)(I), (d)(3)(C)-(D) and 6418(f)(1)(B) — the year chains of
// the elective payment and transfer elections. Stage 3b (26.09.2026, DECISION-0379),
// implemented_unverified, NOT executed, no legal review. Owner rows: 26/6417/d/1/d/ii/i/u1,
// 26/6417/d/3/c/i/u1-u4, 26/6417/d/3/d/i/u1-u5, 26/6418/f/1/b/u1-u3.
//
// JUDGMENT CALLS
//  - The years of one taxpayer are ordered by the case (`taxable_year_after_or_same`, module 11); the
//    number of "succeeding taxable years" is read from the beginning date of a year: a year is one of
//    the 4 succeeding years when it begins after the election year begins and before 60 calendar
//    months after it (exact for 12-month years; a short year in between can admit a fifth year).
//  - "ending before January 1, 2033" reads the end date of the succeeding year.
//  - A deemed opt-in election (D)(ii)(I) is derived as `optin_election_deemed_made`; it does not feed the
//    applicable-entity relation of module 11 (that would make a defeasible result the input of a strict rule).
//  - "For each taxable year during the 10-year period beginning on the date such facility was originally placed
//    in service" is read as a taxable year that ends on or after the placement date and begins before the
//    period's end (overlap reading, JUDGMENT CALL); 12 years for the section 45Q equipment (clause (iii)).
//  - "Separately with respect to each facility" is structural: an ElectiveCredit is one credit of one facility
//    or property.
//  - Facilities placed in service before 2022-12-31: the election may be made within the 1-year period after
//    the enactment date 2022-08-16 (the same enactment date module 11 uses).

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    CreditItemKind,
    ElectiveCredit,
    EligibleCreditClause,
    IRC_S6417_D,
    IRC_S6418_F,
    Person,
    TaxableYear,
    credit_election_year,
    credit_originally_placed_in_service_on,
    election_covers_year,
    elective_credit_item,
    elects_under_6417,
    eligible_credit_clause,
    optin_election_45Q_equipment,
    optin_election_45V_facility,
    optin_election_45X_components,
    optin_election_year_begins_after_2032,
    optin_revocation_made_for_year,
    optin_year_covered_for_credit,
    taxable_year_after_or_same,
};

// ---------------------------------------------------------------------------
// (d)(1)(D)(ii)(I): the section 45X opt-in election is treated as made for the 4 succeeding years
// ---------------------------------------------------------------------------
relation optin_election_deemed_made(e: Person, y: TaxableYear, k: CreditItemKind) kind institutional {
    label en official "the taxpayer is treated as having made the opt-in election for the succeeding taxable year";
}
@source(IRC_S6417_D, relation = formalizes, coverage = partial, quote = "such taxpayer shall be treated as having made such election for each of the 4 succeeding taxable years ending before January 1, 2033")
rule S6417OptinDeemedElectionSucceedingYears defeasible {
    for e: Person;
    for y: TaxableYear;
    for y2: TaxableYear;
    for b: Date;
    for b2: Date;
    for e2: Date;
    when optin_election_45X_components(e, y) and not_known(optin_election_year_begins_after_2032(y)) and taxable_year_after_or_same(y, y2)
        and us.irc.core::begins(y, b) and us.irc.core::begins(y2, b2) and us.irc.core::ends(y2, e2)
        and b2 > b and b2 < add_calendar_period(b, 60 calendar_month) and e2 < @2033-01-01;
    then optin_election_deemed_made(e, y2, AdvancedManufacturingProduction45X);
    unless optin_revocation_made_for_year(e, y2);
}

// ---------------------------------------------------------------------------
// (d)(3)(C)(i)(II)(aa) and (D)(i)(III)(aa): opt-in elections cover the placement year and 4 subsequent years
// ---------------------------------------------------------------------------
@source(IRC_S6417_D, relation = formalizes, coverage = partial, quote = "in the case of a taxpayer who makes an election described in paragraph (1)(C), apply to the taxable year in which such equipment is placed in service and the 4 subsequent taxable years")
rule S6417Election45QOptinCoversPlacementYear strict {
    for e: Person;
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for made: Date;
    for amt: Money;
    when elects_under_6417(e, cr, made) and elective_credit_item(cr, e, y, CarbonOxideSequestration45Q, amt) and optin_election_45Q_equipment(e, y);
    then election_covers_year(cr, y);
}
rule S6417Election45QOptinCoversFourSubsequentYears strict {
    for e: Person;
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for y2: TaxableYear;
    for made: Date;
    for amt: Money;
    for b: Date;
    for b2: Date;
    for e2: Date;
    when elects_under_6417(e, cr, made) and elective_credit_item(cr, e, y, CarbonOxideSequestration45Q, amt) and optin_election_45Q_equipment(e, y)
        and not_known(optin_election_year_begins_after_2032(y)) and taxable_year_after_or_same(y, y2)
        and us.irc.core::begins(y, b) and us.irc.core::begins(y2, b2) and us.irc.core::ends(y2, e2)
        and b2 > b and b2 < add_calendar_period(b, 60 calendar_month) and e2 < @2033-01-01;
    then election_covers_year(cr, y2);
}
@source(IRC_S6417_D, relation = formalizes, coverage = partial, quote = "in the case of a taxpayer who makes an election described in paragraph (1)(B), apply to such taxable year and the 4 subsequent taxable years")
rule S6417Election45VOptinCoversPlacementYear strict {
    for e: Person;
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for made: Date;
    for amt: Money;
    when elects_under_6417(e, cr, made) and elective_credit_item(cr, e, y, CleanHydrogenProduction45V, amt) and optin_election_45V_facility(e, y);
    then election_covers_year(cr, y);
}
rule S6417Election45VOptinCoversFourSubsequentYears strict {
    for e: Person;
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for y2: TaxableYear;
    for made: Date;
    for amt: Money;
    for b: Date;
    for b2: Date;
    for e2: Date;
    when elects_under_6417(e, cr, made) and elective_credit_item(cr, e, y, CleanHydrogenProduction45V, amt) and optin_election_45V_facility(e, y)
        and not_known(optin_election_year_begins_after_2032(y)) and taxable_year_after_or_same(y, y2)
        and us.irc.core::begins(y, b) and us.irc.core::begins(y2, b2) and us.irc.core::ends(y2, e2)
        and b2 > b and b2 < add_calendar_period(b, 60 calendar_month) and e2 < @2033-01-01;
    then election_covers_year(cr, y2);
}
// (D)(i)(III)(bb): in any other case the election applies to the year and all subsequent years for the facility.
@source(IRC_S6417_D, relation = formalizes, coverage = partial, quote = "in any other case, apply to such taxable year and all subsequent taxable years with respect to such facility")
rule S6417Election45VOtherCaseCoversAllSubsequentYears strict {
    for e: Person;
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for y2: TaxableYear;
    for made: Date;
    for amt: Money;
    when elects_under_6417(e, cr, made) and elective_credit_item(cr, e, y, CleanHydrogenProduction45V, amt) and not_known(optin_year_covered_for_credit(cr, y))
        and taxable_year_after_or_same(y, y2);
    then election_covers_year(cr, y2);
}

// ---------------------------------------------------------------------------
// (d)(3)(D)(i)(II): the section 45V election is made for the placement year
// ---------------------------------------------------------------------------
relation election_45V_early_facility_window_met(cr: ElectiveCredit) kind institutional {
    label en official "a facility placed in service before December 31, 2022: the election is made within the 1-year period subsequent to the date of enactment of section 6417";
}
@source(IRC_S6417_D, relation = formalizes, coverage = partial, quote = "or within the 1-year period subsequent to the date of enactment of this section in the case of facilities placed in service before December 31, 2022")
rule S6417Election45VEarlyFacilityWindow strict {
    for e: Person;
    for cr: ElectiveCredit;
    for made: Date;
    for placed: Date;
    when elects_under_6417(e, cr, made) and credit_originally_placed_in_service_on(cr, placed) and placed < @2022-12-31
        and made >= @2022-08-16 and made <= add_calendar_period(@2022-08-16, 12 calendar_month);
    then election_45V_early_facility_window_met(cr);
}
relation election_45V_timing_defect(cr: ElectiveCredit) kind institutional {
    label en official "the section 45V election is not made for the taxable year in which the facility is placed in service (and no early-facility window applies)";
}
@source(IRC_S6417_D, relation = formalizes, coverage = partial, quote = "be made for the taxable year in which such facility is placed in service")
rule S6417Election45VBeforePlacementYear strict {
    for e: Person;
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for made: Date;
    for amt: Money;
    for placed: Date;
    for b: Date;
    when elects_under_6417(e, cr, made) and elective_credit_item(cr, e, y, CleanHydrogenProduction45V, amt) and credit_originally_placed_in_service_on(cr, placed)
        and us.irc.core::begins(y, b) and placed < b and not_known(election_45V_early_facility_window_met(cr));
    then election_45V_timing_defect(cr);
}
rule S6417Election45VAfterPlacementYear strict {
    for e: Person;
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for made: Date;
    for amt: Money;
    for placed: Date;
    for e2: Date;
    when elects_under_6417(e, cr, made) and elective_credit_item(cr, e, y, CleanHydrogenProduction45V, amt) and credit_originally_placed_in_service_on(cr, placed)
        and us.irc.core::ends(y, e2) and placed > e2 and not_known(election_45V_early_facility_window_met(cr));
    then election_45V_timing_defect(cr);
}

// ---------------------------------------------------------------------------
// 6418(f)(1)(B): the transfer election for each taxable year of the facility period
// ---------------------------------------------------------------------------
relation transfer_election_outside_facility_period(cr: ElectiveCredit) kind institutional {
    label en official "the election is made for a taxable year that is not within the 10-year period (12 years for the section 45Q equipment) beginning on the placement date";
}
@source(IRC_S6418_F, relation = formalizes, coverage = partial, quote = "for each taxable year during the 10-year period beginning on the date such facility was originally placed in service")
rule S6418TransferYearBeforeFacilityPeriod strict {
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for placed: Date;
    for e2: Date;
    for c: EligibleCreditClause;
    when credit_election_year(cr, y) and credit_originally_placed_in_service_on(cr, placed) and us.irc.core::ends(y, e2) and e2 < placed
        and eligible_credit_clause(cr, c) and (c == ClauseII45 or c == ClauseIII45Q or c == ClauseV45V or c == ClauseVII45Y);
    then transfer_election_outside_facility_period(cr);
}
rule S6418TransferYearAfterTenYearPeriod strict {
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for placed: Date;
    for b: Date;
    for c: EligibleCreditClause;
    when credit_election_year(cr, y) and credit_originally_placed_in_service_on(cr, placed) and us.irc.core::begins(y, b) and b >= add_calendar_period(placed, 120 calendar_month)
        and eligible_credit_clause(cr, c) and (c == ClauseII45 or c == ClauseV45V or c == ClauseVII45Y);
    then transfer_election_outside_facility_period(cr);
}
@source(IRC_S6418_F, relation = formalizes, coverage = partial, quote = "for each year during the 12-year period beginning on the date the carbon capture equipment was originally placed in service at such facility")
rule S6418TransferYearAfterTwelveYearPeriod45Q strict {
    for cr: ElectiveCredit;
    for y: TaxableYear;
    for placed: Date;
    for b: Date;
    when credit_election_year(cr, y) and credit_originally_placed_in_service_on(cr, placed) and us.irc.core::begins(y, b) and b >= add_calendar_period(placed, 144 calendar_month)
        and eligible_credit_clause(cr, ClauseIII45Q);
    then transfer_election_outside_facility_period(cr);
}
