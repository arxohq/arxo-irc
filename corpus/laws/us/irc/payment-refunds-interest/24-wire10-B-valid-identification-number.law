// Payment, refunds, interest -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// "Valid identification number" of sections 6428(g)(3) and 6428A(g)(4): a social security number as defined in section 24(h)(7),
// which the `credits` package defines and publishes (`social_security_number_24h7_included_on_return`). The case-fact channel of the
// placeholder relations stays valid.
//
// JUDGMENT CALLS AND GAPS
//  - `joint_return_identification_numbers_included` (the count of spouses) stays a case fact: the package has no relation naming the
//    spouses of a joint return, so the number of spouses whose number is included cannot be counted from the owner's per-holder relation.
//  - The adoption taxpayer identification number (ATIN, section 6109(i)) is a local case fact: no package publishes it.
//  - Section 6428B(e)(2)(D)(i) is NOT wired to section 24(h)(7): it has its own definition (issued on or before the due date, no
//    citizenship condition), see the block at the end of this module.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6428_G,
    Person,
    TaxableYear,
    child_valid_identification_number_included,
    own_valid_identification_number_included,
    qualifying_child_of_taxpayer,
};

relation child_adopted_or_placed_for_adoption(child: Person) kind empirical {
    label en official "a qualifying child who is adopted or placed for adoption";
}
relation adoption_taxpayer_identification_number_on_return_of(child: Person, p: Person, y: TaxableYear) kind empirical {
    label en official "the adoption taxpayer identification number of the child is included on the return of tax of the taxpayer for the taxable year";
}

@source(IRC_S6428_G, relation = formalizes, coverage = partial, quote = "the term \"valid identification number\" means a social security number (as such term is defined in section 24(h)(7))")
rule W10OwnValidIdentificationNumberIsSsn24h7(p: Person, y: TaxableYear) strict {
    label en official "the taxpayer includes the valid identification number of the taxpayer when a social security number under section 24(h)(7) of the taxpayer is included on the return";
    when us.irc.credits::social_security_number_24h7_included_on_return(p, p, y);
    then own_valid_identification_number_included(p, y);
}

@source(IRC_S6428_G, relation = formalizes, coverage = partial, quote = "the term \"valid identification number\" means a social security number (as such term is defined in section 24(h)(7))")
rule W10ChildValidIdentificationNumberIsSsn24h7(p: Person, y: TaxableYear, child: Person) strict {
    label en official "the valid identification number of a qualifying child is included when a social security number under section 24(h)(7) of the child is included on the taxpayer's return";
    when qualifying_child_of_taxpayer(p, y, child);
    when us.irc.credits::social_security_number_24h7_included_on_return(child, p, y);
    then child_valid_identification_number_included(child, y);
}

@source(IRC_S6428_G, relation = formalizes, coverage = partial, quote = "in the case of a qualifying child who is adopted or placed for adoption, the term \"valid identification number\" shall include the adoption taxpayer identification number of such child")
rule W10ChildValidIdentificationNumberIsAtin(p: Person, y: TaxableYear, child: Person) strict {
    label en official "for a qualifying child who is adopted or placed for adoption, the adoption taxpayer identification number included on the return is a valid identification number";
    when qualifying_child_of_taxpayer(p, y, child);
    when child_adopted_or_placed_for_adoption(child);
    when adoption_taxpayer_identification_number_on_return_of(child, p, y);
    then child_valid_identification_number_included(child, y);
}
