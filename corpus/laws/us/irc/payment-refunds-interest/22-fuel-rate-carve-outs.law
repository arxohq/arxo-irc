// 26 U.S.C. 6421(f)(2)(B), (f)(3) and 6427(l)(3)-(4) — the Leaking Underground Storage Tank (LUST) financing rate
// and rate-capped portions that are carved out of the payable tax rate. Stage 3b (26.09.2026, DECISION-0379),
// implemented_unverified, NOT executed, no legal review. Owner rows: 26/6421/f/2/u3, 26/6421/f/3/u1-u3,
// 26/6427/l/3/u2-u3, 26/6427/l/4/a/u1-u3, 26/6427/l/4/b/u1-u5.
//
// JUDGMENT CALLS
//  - The rate components of sections 4041 and 4081 belong to `excise-goods`; here each component is a
//    case-asserted per-gallon rate on the claim (dependency contract: `excise-goods`). The only literal is the
//    4.3 cents that the statutes themselves state (0.043 dollars per gallon).
//  - The carved-out portion is subtracted from the asserted total rate of the claim (`fuel_claim_tax_rate`); the
//    result is `fuel_claim_rate_after_reduction`, which module 10 multiplies by the gallons. A carve-out larger
//    than the total rate leaves a zero rate.
//  - "So much of the rate ... as does not exceed" a limit is the lesser of the rate and the limit; it is derived
//    with two comparisons (no min over Decimal).
//  - Commercial aviation gasoline: the 4.3 cents applies to fuel purchased after 1995-09-30 (the text's own
//    date); before that only the LUST rate is carved out. The purchase date is an asserted fact.
//  - Kerosene in non-commercial aviation (l)(4)(B): the whole tax imposed by section 4041(c) or (d)(2) is excluded
//    when the claim says the tax was imposed there; otherwise the LUST rate and the capped portion of the
//    section 4081(a)(2)(A)(iii) rate are excluded.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    FuelClaim,
    FuelPaymentBasis,
    IRC_S6421_F,
    aircraft_use_is_commercial_aviation,
    diesel_used_in_diesel_powered_train,
    fuel_claim_basis,
    fuel_claim_rate_after_reduction,
    fuel_claim_tax_rate,
    fuel_used_in_aircraft,
    fuel_used_in_train,
};

relation fuel_claim_lust_rate(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "the Leaking Underground Storage Tank Trust Fund financing rate imposed on the fuel"; }
relation fuel_claim_rate_4081a2A(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "the rate specified in section 4081(a)(2)(A)"; }
relation fuel_claim_rate_4041a1Cii(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "the rate applicable under section 4041(a)(1)(C)(ii)"; }
relation fuel_claim_rate_kerosene(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "the rate of tax specified in section 4041(c) or 4081(a)(2)(A)(iii), as the case may be"; }
relation fuel_claim_rate_4081a2Cii(c: FuelClaim, dollars_per_gallon: Decimal) kind empirical { label en official "the rate specified in section 4081(a)(2)(C)(ii)"; }
relation fuel_purchased_on(c: FuelClaim, d: Date) kind empirical { label en official "the date the fuel was purchased"; }
relation kerosene_used_in_aviation(c: FuelClaim) kind empirical { label en official "kerosene used in aviation"; }
relation kerosene_tax_imposed_under_4041c_or_d2(c: FuelClaim) kind empirical { label en official "the tax was imposed by subsection (c) or (d)(2) of section 4041"; }

// ---- the capped portions ("so much of the rate ... as does not exceed ...")
relation capped_4081a2A_at_4_3_cents(c: FuelClaim, portion: Decimal) kind institutional { label en unofficial "the lesser of the section 4081(a)(2)(A) rate and 4.3 cents"; }
rule S6421F2BCapAtOrBelowLimit strict { for c: FuelClaim; for r: Decimal; when fuel_claim_rate_4081a2A(c, r) and r <= 0.043; then capped_4081a2A_at_4_3_cents(c, r); }
rule S6421F2BCapAboveLimit strict { for c: FuelClaim; for r: Decimal; when fuel_claim_rate_4081a2A(c, r) and r > 0.043; then capped_4081a2A_at_4_3_cents(c, 0.043); }
relation capped_4081a2A_at_4041a1Cii(c: FuelClaim, portion: Decimal) kind institutional { label en unofficial "the lesser of the section 4081(a)(2)(A) rate and the section 4041(a)(1)(C)(ii) rate"; }
rule S6421F3BCapAtOrBelowLimit strict { for c: FuelClaim; for r: Decimal; for t: Decimal; when fuel_claim_rate_4081a2A(c, r) and fuel_claim_rate_4041a1Cii(c, t) and r <= t; then capped_4081a2A_at_4041a1Cii(c, r); }
rule S6421F3BCapAboveLimit strict { for c: FuelClaim; for r: Decimal; for t: Decimal; when fuel_claim_rate_4081a2A(c, r) and fuel_claim_rate_4041a1Cii(c, t) and r > t; then capped_4081a2A_at_4041a1Cii(c, t); }
relation capped_kerosene_rate_at_4_3_cents(c: FuelClaim, portion: Decimal) kind institutional { label en unofficial "the lesser of the kerosene rate and 4.3 cents"; }
rule S6427L4AiiCapAtOrBelowLimit strict { for c: FuelClaim; for r: Decimal; when fuel_claim_rate_kerosene(c, r) and r <= 0.043; then capped_kerosene_rate_at_4_3_cents(c, r); }
rule S6427L4AiiCapAboveLimit strict { for c: FuelClaim; for r: Decimal; when fuel_claim_rate_kerosene(c, r) and r > 0.043; then capped_kerosene_rate_at_4_3_cents(c, 0.043); }
relation capped_kerosene_rate_at_4081a2Cii(c: FuelClaim, portion: Decimal) kind institutional { label en unofficial "the lesser of the kerosene rate and the section 4081(a)(2)(C)(ii) rate"; }
rule S6427L4BiiCapAtOrBelowLimit strict { for c: FuelClaim; for r: Decimal; for t: Decimal; when fuel_claim_rate_kerosene(c, r) and fuel_claim_rate_4081a2Cii(c, t) and r <= t; then capped_kerosene_rate_at_4081a2Cii(c, r); }
rule S6427L4BiiCapAboveLimit strict { for c: FuelClaim; for r: Decimal; for t: Decimal; when fuel_claim_rate_kerosene(c, r) and fuel_claim_rate_4081a2Cii(c, t) and r > t; then capped_kerosene_rate_at_4081a2Cii(c, t); }

// ---- the carved-out rate per case
relation fuel_claim_rate_carve_out(c: FuelClaim, dollars_per_gallon: Decimal) kind institutional {
    label en official "the part of the tax rate for which the payment provision does not apply (LUST financing rate and the capped portion)";
}
relation fuel_claim_rate_carve_out_applies(c: FuelClaim) kind institutional { label en unofficial "helper: a carve-out rate is stated for the claim"; }
rule S6421F2BCommercialAviationAfter1995 strict {
    for c: FuelClaim;
    for l: Decimal;
    for x: Decimal;
    for d: Date;
    when fuel_claim_basis(c, AircraftGasoline) and fuel_used_in_aircraft(c) and aircraft_use_is_commercial_aviation(c) and fuel_claim_lust_rate(c, l) and capped_4081a2A_at_4_3_cents(c, x) and fuel_purchased_on(c, d) and d > @1995-09-30;
    then fuel_claim_rate_carve_out(c, l + x);
}
rule S6421F2BCommercialAviationUpTo1995 strict {
    for c: FuelClaim;
    for l: Decimal;
    for d: Date;
    when fuel_claim_basis(c, AircraftGasoline) and fuel_used_in_aircraft(c) and aircraft_use_is_commercial_aviation(c) and fuel_claim_lust_rate(c, l) and fuel_purchased_on(c, d) and d <= @1995-09-30;
    then fuel_claim_rate_carve_out(c, l);
}
rule S6421F3TrainGasoline strict {
    for c: FuelClaim;
    for l: Decimal;
    for x: Decimal;
    when fuel_used_in_train(c) and fuel_claim_lust_rate(c, l) and capped_4081a2A_at_4041a1Cii(c, x);
    then fuel_claim_rate_carve_out(c, l + x);
}
rule S6427L3DieselTrain strict {
    for c: FuelClaim;
    for l: Decimal;
    for x: Decimal;
    when diesel_used_in_diesel_powered_train(c) and fuel_claim_lust_rate(c, l) and capped_4081a2A_at_4041a1Cii(c, x);
    then fuel_claim_rate_carve_out(c, l + x);
}
rule S6427L4AKeroseneCommercialAviation strict {
    for c: FuelClaim;
    for l: Decimal;
    for x: Decimal;
    when kerosene_used_in_aviation(c) and aircraft_use_is_commercial_aviation(c) and fuel_claim_lust_rate(c, l) and capped_kerosene_rate_at_4_3_cents(c, x);
    then fuel_claim_rate_carve_out(c, l + x);
}
rule S6427L4BKeroseneOtherAviationTaxUnder4041 strict {
    for c: FuelClaim;
    for total: Decimal;
    when kerosene_used_in_aviation(c) and not_known(aircraft_use_is_commercial_aviation(c)) and kerosene_tax_imposed_under_4041c_or_d2(c) and fuel_claim_tax_rate(c, total);
    then fuel_claim_rate_carve_out(c, total);
}
rule S6427L4BKeroseneOtherAviationTaxUnder4081 strict {
    for c: FuelClaim;
    for l: Decimal;
    for x: Decimal;
    when kerosene_used_in_aviation(c) and not_known(aircraft_use_is_commercial_aviation(c)) and not_known(kerosene_tax_imposed_under_4041c_or_d2(c)) and fuel_claim_lust_rate(c, l) and capped_kerosene_rate_at_4081a2Cii(c, x);
    then fuel_claim_rate_carve_out(c, l + x);
}
rule S6421F6427LCarveOutStated strict {
    for c: FuelClaim;
    for x: Decimal;
    when fuel_claim_rate_carve_out(c, x);
    then fuel_claim_rate_carve_out_applies(c);
}

// ---- the rate taken into account for the claim
@source(IRC_S6421_F, relation = formalizes, coverage = partial, quote = "in commercial aviation (as so defined) with respect to the tax imposed by section 4081 at the Leaking Underground Storage Tank Trust Fund financing rate")
rule S6421F6427LRateAfterCarveOut defeasible {
    for c: FuelClaim;
    for rate: Decimal;
    for x: Decimal;
    when fuel_claim_tax_rate(c, rate) and fuel_claim_rate_carve_out(c, x) and rate > x;
    then fuel_claim_rate_after_reduction(c, rate - x);
}
rule S6421F6427LRateFullyCarvedOut defeasible {
    for c: FuelClaim;
    for rate: Decimal;
    for x: Decimal;
    when fuel_claim_tax_rate(c, rate) and fuel_claim_rate_carve_out(c, x) and rate <= x;
    then fuel_claim_rate_after_reduction(c, 0.0);
}
