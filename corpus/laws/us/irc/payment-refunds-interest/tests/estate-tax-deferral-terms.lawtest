        assert extension_until_date(entity_ref("urn:test:r7#req"), @2029-01-01) { id "f3"; origin case_input; }
        assert s6161_estate_reasonable_cause_shown(entity_ref("urn:test:r7#p"), entity_ref("urn:test:r7#req")) { id "f4"; origin adjudicated; }
        assert deficiency_due_to_negligence_disregard_or_fraud(entity_ref("urn:test:r7#req")) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(S6161B2EstateDeficiencyExtensionPower, INVALIDLY_EXERCISED);
}

test "S6163A-01-POSTPONEMENT-ENDS-SIX-MONTHS-AFTER-PRECEDENT-INTEREST" {
    given {
        context { decision_time @2030-06-01T09:00:00-05:00; knowledge_time @2030-06-01T09:00:00-05:00; legal_time @2030-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert precedent_interest_terminated_on(entity_ref("urn:test:v1#p"), entity_ref("urn:test:v1#y"), @2030-03-01) { id "f0"; origin case_input; }
    }
    evaluate truth(postponement_period_end_6163(entity_ref("urn:test:v1#p"), entity_ref("urn:test:v1#y"), @2030-09-01));
    expect truth_status == TRUE_ONLY;
}

