// Payment/refunds WIRE-10 group B scenarios (sections 6428, 6428A: valid identification number). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "W10B-PRI-01-OWN-VALID-NUMBER-FROM-THE-24H7-DEFINITION" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.credits::ssn_issued_by_social_security_administration(entity_ref("urn:test:w10b:a1#p")) { origin case_input; }
        assert "f1": us.irc.credits::ssn_issued_to_citizen_or_205c2Bi_I_alien(entity_ref("urn:test:w10b:a1#p")) { origin case_input; }
        assert "f2": us.irc.credits::ssn_issue_date(entity_ref("urn:test:w10b:a1#p"), @2019-06-01) { origin case_input; }
        assert "f3": us.irc.credits::return_due_date_for_ssn_24h7(entity_ref("urn:test:w10b:a1#p"), entity_ref("urn:test:w10b:a1#y"), @2020-07-15) { origin case_input; }
        assert "f4": us.irc.credits::ssn_holder_number_on_return_of(entity_ref("urn:test:w10b:a1#p"), entity_ref("urn:test:w10b:a1#p"), entity_ref("urn:test:w10b:a1#y")) { origin case_input; }
    }
    evaluate truth(own_valid_identification_number_included(entity_ref("urn:test:w10b:a1#p"), entity_ref("urn:test:w10b:a1#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PRI-02-OWN-NUMBER-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": own_valid_identification_number_included(entity_ref("urn:test:w10b:a2#p"), entity_ref("urn:test:w10b:a2#y")) { origin case_input; }
    }
    evaluate truth(own_valid_identification_number_included(entity_ref("urn:test:w10b:a2#p"), entity_ref("urn:test:w10b:a2#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PRI-03-CHILD-VALID-NUMBER-FROM-THE-24H7-DEFINITION" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.credits::ssn_issued_by_social_security_administration(entity_ref("urn:test:w10b:a3#c")) { origin case_input; }
        assert "f1": us.irc.credits::ssn_issued_to_citizen_or_205c2Bi_I_alien(entity_ref("urn:test:w10b:a3#c")) { origin case_input; }
        assert "f2": us.irc.credits::ssn_issue_date(entity_ref("urn:test:w10b:a3#c"), @2019-06-01) { origin case_input; }
        assert "f3": us.irc.credits::return_due_date_for_ssn_24h7(entity_ref("urn:test:w10b:a3#p"), entity_ref("urn:test:w10b:a3#y"), @2020-07-15) { origin case_input; }
        assert "f4": us.irc.credits::ssn_holder_number_on_return_of(entity_ref("urn:test:w10b:a3#c"), entity_ref("urn:test:w10b:a3#p"), entity_ref("urn:test:w10b:a3#y")) { origin case_input; }
        assert "f5": qualifying_child_of_taxpayer(entity_ref("urn:test:w10b:a3#p"), entity_ref("urn:test:w10b:a3#y"), entity_ref("urn:test:w10b:a3#c")) { origin case_input; }
    }
    evaluate truth(child_valid_identification_number_included(entity_ref("urn:test:w10b:a3#c"), entity_ref("urn:test:w10b:a3#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PRI-04-ADOPTED-CHILD-ATIN-IS-A-VALID-NUMBER" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualifying_child_of_taxpayer(entity_ref("urn:test:w10b:a4#p"), entity_ref("urn:test:w10b:a4#y"), entity_ref("urn:test:w10b:a4#c")) { origin case_input; }
        assert "f1": child_adopted_or_placed_for_adoption(entity_ref("urn:test:w10b:a4#c")) { origin case_input; }
        assert "f2": adoption_taxpayer_identification_number_on_return_of(entity_ref("urn:test:w10b:a4#c"), entity_ref("urn:test:w10b:a4#p"), entity_ref("urn:test:w10b:a4#y")) { origin case_input; }
    }
    evaluate truth(child_valid_identification_number_included(entity_ref("urn:test:w10b:a4#c"), entity_ref("urn:test:w10b:a4#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PRI-05-ATIN-OF-A-CHILD-NOT-ADOPTED-IS-NOT-A-VALID-NUMBER" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualifying_child_of_taxpayer(entity_ref("urn:test:w10b:a5#p"), entity_ref("urn:test:w10b:a5#y"), entity_ref("urn:test:w10b:a5#c")) { origin case_input; }
        assert "f1": adoption_taxpayer_identification_number_on_return_of(entity_ref("urn:test:w10b:a5#c"), entity_ref("urn:test:w10b:a5#p"), entity_ref("urn:test:w10b:a5#y")) { origin case_input; }
    }
    evaluate truth(child_valid_identification_number_included(entity_ref("urn:test:w10b:a5#c"), entity_ref("urn:test:w10b:a5#y")));
    expect truth_status == NEITHER;
}
