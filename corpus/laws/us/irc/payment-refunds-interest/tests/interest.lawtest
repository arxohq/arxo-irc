}

// --- §6611(e): 45-day boundary — refunded on day 45 vs day 46 ---------------

test "S6611-02-REFUND-ON-DAY-FORTY-FIVE-DISALLOWS-INTEREST" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:...#R1"), @2027-04-15) { id "f1"; origin case_input; }
        assert overpayment_refunded_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, @2027-05-30) { id "f2"; origin case_input; }
    }
    evaluate truth(overpayment_interest_disallowed(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
}

test "S6611-03-REFUND-ON-DAY-FORTY-SIX-ALLOWS-INTEREST" {
    given {
        context { decision_time @2027-06-02T09:00:00-04:00; knowledge_time @2027-06-02T09:00:00-04:00; legal_time @2027-06-02; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:...#R1"), @2027-04-15) { id "f1"; origin case_input; }
        assert overpayment_refunded_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, @2027-05-31) { id "f2"; origin case_input; }
    }
    evaluate truth(overpayment_interest_disallowed(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1));
    expect truth_status == NEITHER;
}

test "S6611-04-WITHHOLDING-OVERPAYMENT-USES-180-DAY-WINDOW" {
    given {
        context { decision_time @2027-11-01T09:00:00-04:00; knowledge_time @2027-11-01T09:00:00-04:00; legal_time @2027-11-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::WithholdingNraCh3) { id "f0"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:...#R1"), @2027-04-15) { id "f1"; origin case_input; }
        assert overpayment_is_withholding_tax(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::WithholdingNraCh3) { id "f2"; origin case_input; }
        assert overpayment_refunded_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::WithholdingNraCh3, @2027-10-01) { id "f3"; origin case_input; }
    }
    evaluate truth(overpayment_interest_disallowed(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::WithholdingNraCh3));
    expect truth_status == TRUE_ONLY;
}

// --- §6621: rate determination ----------------------------------------------

test "S6621-01-ORDINARY-UNDERPAYMENT-RATE-IS-SHORT-TERM-PLUS-THREE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert federal_short_term_rate(@2026-01-01, 5.0) { id "f1"; origin case_input; }
    }
    evaluate truth(underpayment_rate_for_liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, @2026-01-01, 8.0));
    expect truth_status == TRUE_ONLY;
}

test "S6621-02-LARGE-CORPORATE-UNDERPAYMENT-RATE-IS-SHORT-TERM-PLUS-FIVE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#C1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, 500000 USD) { id "f0"; origin case_input; }
        assert federal_short_term_rate(@2026-01-01, 5.0) { id "f1"; origin case_input; }
        assert large_corporate_underpayment(entity_ref("urn:...#C1"), @2026-01-01) { id "f2"; origin case_input; }
        assert large_corporate_underpayment_applicable_date_reached(entity_ref("urn:...#C1"), @2026-01-01) { id "f3"; origin case_input; }
    }
    evaluate truth(underpayment_rate_for_liability(entity_ref("urn:...#C1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, @2026-01-01, 10.0));
    expect truth_status == TRUE_ONLY;
}

test "S6621-03-CORPORATE-OVERPAYMENT-ABOVE-TEN-THOUSAND-USES-HALF-POINT" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#C1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert us.irc.core::payment(entity_ref("urn:...#PAY1"), entity_ref("urn:...#C1"), 21000 USD, @2026-01-05) { id "f1"; origin case_input; }
        assert us.irc.core::payment_applied(entity_ref("urn:...#PAY1"), entity_ref("urn:...#C1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
        assert federal_short_term_rate(@2026-01-01, 5.0) { id "f3"; origin case_input; }
        assert is_corporation_for_overpayment_rate(entity_ref("urn:...#C1")) { id "f4"; origin case_input; }
        assert corporate_overpayment_exceeds_ten_thousand(entity_ref("urn:...#C1"), @2026-01-01) { id "f5"; origin case_input; }
    }
    evaluate truth(overpayment_rate_for_liability(entity_ref("urn:...#C1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, @2026-01-01, 5.5));
    expect truth_status == TRUE_ONLY;
}

test "S6621-04-NET-RATE-ZERO-ON-EQUIVALENT-OVERLAP" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert equivalent_overlapping_overpayment_and_underpayment(entity_ref("urn:...#P1"), @2026-01-01) { id "f0"; origin case_input; }
    }
    evaluate truth(net_interest_rate_is_zero(entity_ref("urn:...#P1"), @2026-01-01));
    expect truth_status == TRUE_ONLY;
}

// --- §6622: one-day compounding step (see module header for the TECH_GAP
// on chaining across an arbitrary day count) --------------------------------

test "S6622-01-ONE-DAY-COMPOUNDING-STEP-AT-EIGHT-PERCENT" {
    // $10,000 principal, 8% annual: next-day balance = 10000 * (1 + 8/100/365)
    //   = 10000 * 1.000219178... rounds to 10002.19
    given {
        context { decision_time @2026-01-02T09:00:00-05:00; knowledge_time @2026-01-02T09:00:00-05:00; legal_time @2026-01-02; timezone "America/New_York"; }
        assert interest_compounding_request(10000 USD, 8.0) { id "f0"; origin case_input; }
    }
    evaluate truth(next_day_balance(10000 USD, 8.0, 10002.19 USD));
    expect truth_status == TRUE_ONLY;
}

