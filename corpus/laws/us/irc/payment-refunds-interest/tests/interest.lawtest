language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

// --- §6601(a): underpayment interest duty -----------------------------------

test "S6601-01-UNPAID-BALANCE-AFTER-DUE-DATE-CREATES-INTEREST-DUTY" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:...#R1"), @2027-04-15) { id "f1"; origin case_input; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 1000 USD) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(PayUnderpaymentInterest, ACTIVE);
}

test "S6601-02-FULLY-PAID-BEFORE-DUE-DATE-HAS-NO-UNDERPAYMENT" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert us.irc.core::payment(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), 1000 USD, @2027-04-01) { id "f1"; origin case_input; }
        assert us.irc.core::payment_applied(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
    }
    evaluate truth(underpayment_amount(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 0 USD));
    expect truth_status == NEITHER;
}

// --- §6601(c): suspension on a late notice and demand after a waiver -------

test "S6601-03-NOTICE-AND-DEMAND-AFTER-THIRTY-DAYS-SUSPENDS-INTEREST" {
    given {
        context { decision_time @2027-03-01T09:00:00-05:00; knowledge_time @2027-03-01T09:00:00-05:00; legal_time @2027-03-01; timezone "America/New_York"; }
        assert deficiency_waiver_filed_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, @2027-01-01) { id "f0"; origin case_input; }
        assert notice_and_demand_made_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, @2027-02-15) { id "f1"; origin case_input; }
    }
    evaluate truth(deficiency_interest_suspended(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
}

// --- §6601(e): 21-calendar-day grace period ---------------------------------

test "S6601-04-PAID-WITHIN-TWENTY-ONE-DAYS-BARS-INTEREST-ON-PENALTY" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert penalty_notice_amount(entity_ref("urn:...#N1"), entity_ref("urn:...#P1"), 500 USD) { id "f0"; origin case_input; }
        assert penalty_notice_mailed_on(entity_ref("urn:...#N1"), @2027-01-01) { id "f1"; origin case_input; }
        assert penalty_paid_on(entity_ref("urn:...#N1"), entity_ref("urn:...#P1"), @2027-01-15) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(NoInterestOnPenaltyWithinGracePeriod, VIOLATED);
}

// --- §6611(a): overpayment interest ------------------------------------------

test "S6611-01-OVERPAYMENT-CREATES-INTEREST-DUTY" {
    given {
        context { decision_time @2027-05-01T09:00:00-04:00; knowledge_time @2027-05-01T09:00:00-04:00; legal_time @2027-05-01; timezone "America/New_York"; }
