// Scenarios for 26 U.S.C. §§6420, 6421, 6426, 6427, package
// us.irc.payment_refunds_interest, module 10-fuel-payments-and-credits.law.
// Written from the text; NOT executed in this stage (`implemented_unverified`).
// Parameter values are read at the scenario's legal_time (the date the fuel
// is sold or used): 2007 (51 cents), 2010 (45 cents), 2024 (SAF), 2025-10 (after
// the termination date). Date arithmetic: 2027-03-01 + 45 days = 2027-04-15,
// + 20 days = 2027-03-21.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "S6420-01-FARM-USE-BY-OPERATOR-IS-FARMING-PURPOSE" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert fuel_used_in_trade_or_business(entity_ref("urn:us:irc:payment_refunds_interest:clir#F1")) { id "f0"; origin case_input; }
        assert fuel_used_on_farm_in_united_states(entity_ref("urn:us:irc:payment_refunds_interest:clir#F1")) { id "f1"; origin case_input; }
        assert place_is_a_farm(entity_ref("urn:us:irc:payment_refunds_interest:clir#F1")) { id "f2"; origin case_input; }
        assert user_is_owner_tenant_or_operator(entity_ref("urn:us:irc:payment_refunds_interest:clir#F1")) { id "f3"; origin case_input; }
        assert used_in_cultivating_or_raising_commodity_on_own_farm(entity_ref("urn:us:irc:payment_refunds_interest:clir#F1")) { id "f4"; origin case_input; }
    }
    evaluate truth(used_for_farming_purposes_6420c3(entity_ref("urn:us:irc:payment_refunds_interest:clir#F1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gasoline_used_on_farm_for_farming_purposes(entity_ref("urn:us:irc:payment_refunds_interest:clir#F1")));
    expect truth_status == TRUE_ONLY;
}

