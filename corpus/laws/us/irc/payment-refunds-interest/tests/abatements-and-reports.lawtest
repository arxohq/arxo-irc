// Scenarios for 26 U.S.C. §§6404-6405, 6407, package
// us.irc.payment_refunds_interest, module 04-abatements-and-reports.law.
// Written from the text; NOT executed in this stage —
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

// --- §6404(a): discretionary abatement power --------------------------------

test "S6404-01-EXCESSIVE-ASSESSMENT-MAY-BE-ABATED" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert assessment_excessive(entity_ref("urn:...#A1")) { id "f0"; origin case_input; }
        assert abates_assessment(entity_ref("urn:...#A1")) { id "f1"; origin case_input; }
    }
    evaluate truth(assessment_abated(entity_ref("urn:...#A1")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S6404-02-ABATEMENT-WITHOUT-A-GROUND-IS-INVALID-EXERCISE" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert abates_assessment(entity_ref("urn:...#A2")) { id "f0"; origin case_input; }
    }
    evaluate truth(assessment_abated(entity_ref("urn:...#A2")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

// --- §6404(b): no abatement claim for income/estate/gift tax ---------------

test "S6404-03-ABATEMENT-CLAIM-FOR-INCOME-TAX-VIOLATES-PROHIBITION" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert files_abatement_claim(entity_ref("urn:...#P1"), entity_ref("urn:...#A3"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(NoAbatementClaimForIncomeEstateGiftTax, VIOLATED);
}

// --- §6404(e)(2): mandatory abatement of erroneous-refund interest ---------

test "S6404-04-MANDATORY-ABATEMENT-BELOW-FIFTY-THOUSAND-NOT-CAUSED-BY-TAXPAYER" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert erroneous_refund_amount(entity_ref("urn:...#R1"), 20000 USD) { id "f0"; origin case_input; }
        assert demand_for_repayment_made_on(entity_ref("urn:...#R1"), @2027-01-15) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(AbateErroneousRefundInterest, ACTIVE);
}

test "S6404-05-ABOVE-FIFTY-THOUSAND-IS-NOT-MANDATORY" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert erroneous_refund_amount(entity_ref("urn:...#R2"), 60000 USD) { id "f0"; origin case_input; }
        assert demand_for_repayment_made_on(entity_ref("urn:...#R2"), @2027-01-15) { id "f1"; origin case_input; }
    }
    evaluate truth(erroneous_refund_interest_abated(entity_ref("urn:...#R2")));
    expect truth_status == NEITHER;
}

// --- §6404(g): mandatory suspension for late Secretary contact -------------

test "S6404-06-SUSPENSION-DUTY-WHEN-NO-NOTICE-WITHIN-THIRTY-SIX-MONTHS" {
    given {
        context { decision_time @2030-01-01T09:00:00-05:00; knowledge_time @2030-01-01T09:00:00-05:00; legal_time @2030-01-01; timezone "America/New_York"; }
        assert timely_return_filed(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), @2027-04-15, @2027-04-15) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(SuspendInterestAndPenaltiesForLateContact, ACTIVE);
}

// --- §6405(a): Joint Committee reporting threshold --------------------------

test "S6405-01-REFUND-ABOVE-TWO-MILLION-BEFORE-REPORT-VIOLATES-PROHIBITION" {
    given {
        context { decision_time @2027-03-01T09:00:00-05:00; knowledge_time @2027-03-01T09:00:00-05:00; legal_time @2027-03-01; timezone "America/New_York"; }
        assert refund_or_credit_made_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 3000000 USD, @2027-03-01) { id "f0"; origin case_input; }
        assert jct_report_submitted_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, @2027-02-20) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(NoLargeRefundBeforeThirtyDaysAfterJctReport, VIOLATED);
}

test "S6405-02-REFUND-AT-OR-BELOW-TWO-MILLION-NEEDS-NO-REPORT" {
    given {
        context { decision_time @2027-03-01T09:00:00-05:00; knowledge_time @2027-03-01T09:00:00-05:00; legal_time @2027-03-01; timezone "America/New_York"; }
        assert refund_or_credit_made_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 2000000 USD, @2027-03-01) { id "f0"; origin case_input; }
    }
    evaluate truth(jct_report_owed(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1));
    expect truth_status == NEITHER;
}

// --- §6407: date of allowance ------------------------------------------------

test "S6407-01-SCHEDULING-DATE-IS-DATE-OF-ALLOWANCE" {
    given {
        context { decision_time @2027-03-15T09:00:00-04:00; knowledge_time @2027-03-15T09:00:00-04:00; legal_time @2027-03-15; timezone "America/New_York"; }
        assert overassessment_scheduling_authorized_on(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, @2027-03-10) { id "f0"; origin case_input; }
    }
    evaluate truth(date_of_allowance(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, @2027-03-10));
    expect truth_status == TRUE_ONLY;
}
