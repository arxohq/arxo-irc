// Section 6428/6428A SSA readers (IRC-G/G6, 27.09.2026).
// Вывод / нет факта источника: with the case-selected beneficiary-class
// fact the external-enforcement routing derives (TRUE_ONLY); without it
// nothing derives (NEITHER). Expectations come from the statutory text.
// Honest boundary (see the SSA-readers block in 12-recovery-rebates-2020.law):
// SSA §1129(a)(3) is not pinned in `us.ssa.title42_values`, and the RRA /
// title 38 classes were never in G6 scope. NOT EXECUTED
// (implemented_unverified; execution is step 6, owner gate).

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "S6428-SSA-01-ENFORCEMENT-ROUTES" {
    given {
        context { legal_time @2020-12-31; decision_time @2020-12-31T09:00:00-05:00; knowledge_time @2020-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert rebate_payment_beneficiary_class_6428(entity_ref("urn:test:s6428ssa:1#p"), SocialSecurityOrSsi) { id "f0"; origin case_input; }
    }
    evaluate truth(rebate_payment_subject_to_external_enforcement_6428(entity_ref("urn:test:s6428ssa:1#p"), SocialSecurityOrSsi));
    expect truth_status == TRUE_ONLY;
}

test "S6428-SSA-02-WITHOUT-CLASS-NEITHER" {
    given {
        context { legal_time @2020-12-31; decision_time @2020-12-31T09:00:00-05:00; knowledge_time @2020-12-31T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(rebate_payment_subject_to_external_enforcement_6428(entity_ref("urn:test:s6428ssa:2#p"), RailroadRetirement));
    expect truth_status == NEITHER;
}

test "S6428A-SSA-01-ENFORCEMENT-ROUTES" {
    given {
        context { legal_time @2020-12-31; decision_time @2020-12-31T09:00:00-05:00; knowledge_time @2020-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert specified_rebate_payment_beneficiary_class_6428A(entity_ref("urn:test:s6428ssa:3#p"), Veterans) { id "f0"; origin case_input; }
    }
    evaluate truth(specified_rebate_payment_subject_to_external_enforcement_6428A(entity_ref("urn:test:s6428ssa:3#p"), Veterans));
    expect truth_status == TRUE_ONLY;
}

test "S6428A-SSA-02-WITHOUT-CLASS-NEITHER" {
    given {
        context { legal_time @2020-12-31; decision_time @2020-12-31T09:00:00-05:00; knowledge_time @2020-12-31T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(specified_rebate_payment_subject_to_external_enforcement_6428A(entity_ref("urn:test:s6428ssa:4#p"), Veterans));
