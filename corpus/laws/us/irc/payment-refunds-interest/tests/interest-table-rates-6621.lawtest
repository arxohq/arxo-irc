// Scenarios for the §6621 quarterly-table wiring (IRC-G, step 4/G2):
// the from-table path of 06-interest.law reading
// us.irs.rev_rul_6621_quarterly::quarterly_rate under the quarter-index
// policy. T-01/T-02 assert NO federal_short_term_rate case fact, so only
// the final-tier table path can fire; T-03/T-04 cover the base-tier rule
// behind the 26/6621/b/* rows. The case-fact spread rules are untouched.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

// --- pinned quarter reads the table value -----------------------------------

test "S6621T-01-PINNED-QUARTER-GIVES-TABLE-UNDERPAYMENT-RATE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert qrate_table_quarter_6621(@2026-01-01, "2026-Q1") { id "f1"; origin case_input; }
    }
    evaluate truth(underpayment_rate_for_liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, @2026-01-01, 7.0));
    expect truth_status == TRUE_ONLY;
}

// --- quarter outside the index gives no from-table output -------------------

test "S6621T-02-UNPINNED-QUARTER-GIVES-NO-TABLE-RATE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert qrate_table_quarter_6621(@2025-10-01, "2025-Q4") { id "f1"; origin case_input; }
    }
    evaluate truth(underpayment_rate_for_liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1, @2025-10-01, 7.0));
    expect truth_status == NEITHER;
}

// --- pinned quarter gives the base short-term rate (§6621(b) rows) ------------

test "S6621T-03-PINNED-QUARTER-GIVES-TABLE-SHORT-TERM-RATE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert qrate_table_quarter_6621(@2026-01-01, "2026-Q1") { id "f0"; origin case_input; }
    }
    evaluate truth(federal_short_term_rate(@2026-01-01, 4.0));
    expect truth_status == TRUE_ONLY;
}

test "S6621T-04-UNPINNED-QUARTER-GIVES-NO-SHORT-TERM-RATE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert qrate_table_quarter_6621(@2025-10-01, "2025-Q4") { id "f0"; origin case_input; }
    }
    evaluate truth(federal_short_term_rate(@2025-10-01, 4.0));
    expect truth_status == NEITHER;
}
