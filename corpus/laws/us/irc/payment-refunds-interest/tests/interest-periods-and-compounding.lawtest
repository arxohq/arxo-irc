        context { decision_time @2024-04-01T09:00:00-05:00; knowledge_time @2024-04-01T09:00:00-05:00; legal_time @2024-04-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
