        assert portion_satisfied_by_credit(entity_ref("urn:test:k1#p"), entity_ref("urn:test:k1#y"), us.irc.core::IncomeCh1, 5000.00 USD, @2024-09-01) { id "f1"; origin case_input; }
        assert credited_overpayment_date(entity_ref("urn:test:k1#p"), entity_ref("urn:test:k1#y"), us.irc.core::IncomeCh1, @2024-01-20) { id "f2"; origin case_input; }
    }
    // the overpayment predates the last date for payment: the interest-free period starts on the last date.
    evaluate truth(credited_portion_interest_free(entity_ref("urn:test:k1#p"), entity_ref("urn:test:k1#y"), us.irc.core::IncomeCh1, 5000.00 USD, @2024-04-15, @2024-09-01));
    expect truth_status == TRUE_ONLY;
}

