test "S6601B2-01-JEOPARDY-DEMAND-BEFORE-LAST-DATE-DISREGARDED" {
    given {
        context { decision_time @2024-03-01T09:00:00-05:00; knowledge_time @2024-03-01T09:00:00-05:00; legal_time @2024-03-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert last_date_prescribed_for_payment(entity_ref("urn:test:j1#p"), entity_ref("urn:test:j1#y"), us.irc.core::IncomeCh1, @2024-04-15) { id "f0"; origin case_input; }
        assert jeopardy_notice_and_demand_on(entity_ref("urn:test:j1#p"), entity_ref("urn:test:j1#y"), us.irc.core::IncomeCh1, @2024-02-01) { id "f1"; origin case_input; }
    }
    evaluate truth(last_date_unaffected_by_jeopardy_demand(entity_ref("urn:test:j1#p"), entity_ref("urn:test:j1#y"), us.irc.core::IncomeCh1, @2024-04-15));
    expect truth_status == TRUE_ONLY;
}

