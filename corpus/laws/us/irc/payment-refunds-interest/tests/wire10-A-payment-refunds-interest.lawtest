// WIRE-10 group A scenarios for module 96-wire10-A-payment-refunds-interest.law (the section 6621(a)(1) corporate quarter rate and the interest on the foreign-production refunds of sections 5001(c)(4), 5041(c)(7), 5051(a)(6)). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "W10A-PR-01-CORPORATE-QUARTER-RATE-IS-THE-FEDERAL-SHORT-TERM-RATE-PLUS-2" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_short_term_rate(@2026-04-01, 4.0) { origin case_input; }
    }
    evaluate truth(corporate_overpayment_rate_6621a1_for_quarter(@2026-04-01, 6.0));
    expect truth_status == TRUE_ONLY;
}

test "W10A-PR-02-NO-SHORT-TERM-RATE-NO-QUARTER-RATE" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    evaluate truth(corporate_overpayment_rate_6621a1_for_quarter(@2026-04-01, 6.0));
    expect truth_status == NEITHER;
}

test "W10A-PR-03-ALCOHOL-5011C-QUARTER-RATE-AS-A-FRACTION" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_short_term_rate(@2025-10-01, 3.0) { origin case_input; }
        assert "f1": calendar_quarter_begins_on(2025, 4, @2025-10-01) { origin case_input; }
    }
    evaluate truth(us.irc.alcohol::corporate_overpayment_rate_for_quarter(2025, 4, 0.05));
    expect truth_status == TRUE_ONLY;
}

test "W10A-PR-04-THE-QUARTER-WITHOUT-A-CALENDAR-FACT-GETS-NO-ALCOHOL-RATE" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_short_term_rate(@2025-10-01, 3.0) { origin case_input; }
    }
    evaluate truth(us.irc.alcohol::corporate_overpayment_rate_for_quarter(2025, 4, 0.05));
    expect truth_status == NEITHER;
}

test "W10A-PR-05-REFUND-INTEREST-ONE-DAY-COMPOUNDED-AT-THE-QUARTER-RATE" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_short_term_rate(@2026-04-01, 4.0) { origin case_input; }
        assert "f1": us.irc.alcohol::foreign_production_refund_excess(entity_ref("urn:test:w10a:pr5#rp"), 250.00 USD) { origin case_input; }
        assert "f2": us.irc.alcohol::refund_rate_quarter_start(entity_ref("urn:test:w10a:pr5#rp"), @2026-04-01) { origin case_input; }
        assert "f3": us.irc.alcohol::refund_filing_period_days(entity_ref("urn:test:w10a:pr5#rp"), 1) { origin case_input; }
        assert "f4": us.irc.alcohol::refund_days_in_year(entity_ref("urn:test:w10a:pr5#rp"), 365) { origin case_input; }
    }
    evaluate truth(us.irc.alcohol::foreign_production_refund_interest_before_6611e(entity_ref("urn:test:w10a:pr5#rp"), 0.04 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10A-PR-06-ZERO-EXCESS-EARNS-ZERO-INTEREST" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.alcohol::foreign_production_refund_excess(entity_ref("urn:test:w10a:pr6#rp"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.alcohol::foreign_production_refund_interest_before_6611e(entity_ref("urn:test:w10a:pr6#rp"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10A-PR-07-A-PERIOD-OVER-92-DAYS-IS-NOT-DERIVED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_short_term_rate(@2026-04-01, 4.0) { origin case_input; }
        assert "f1": us.irc.alcohol::foreign_production_refund_excess(entity_ref("urn:test:w10a:pr7#rp"), 250.00 USD) { origin case_input; }
        assert "f2": us.irc.alcohol::refund_rate_quarter_start(entity_ref("urn:test:w10a:pr7#rp"), @2026-04-01) { origin case_input; }
        assert "f3": us.irc.alcohol::refund_filing_period_days(entity_ref("urn:test:w10a:pr7#rp"), 93) { origin case_input; }
        assert "f4": us.irc.alcohol::refund_days_in_year(entity_ref("urn:test:w10a:pr7#rp"), 365) { origin case_input; }
    }
    evaluate truth(us.irc.alcohol::foreign_production_refund_interest_before_6611e(entity_ref("urn:test:w10a:pr7#rp"), 0.04 USD));
    expect truth_status == NEITHER;
}
