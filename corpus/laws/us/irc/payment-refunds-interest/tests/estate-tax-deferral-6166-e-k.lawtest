test "S6166I-03-DIRECT-SKIP-INCREASES-MAXIMUM-TAX-IN-INSTALLMENTS" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert estate_tax_2001_net_of_credits(entity_ref("urn:test:i3#e"), 800000.00 USD) { id "f0"; origin case_input; }
        assert gst_tax_2601_on_direct_skip_of_interest(entity_ref("urn:test:i3#e"), 50000.00 USD) { id "f1"; origin case_input; }
        assert closely_held_business_amount_6166(entity_ref("urn:test:i3#e"), 600000.00 USD) { id "f2"; origin case_input; }
        assert adjusted_gross_estate_6166(entity_ref("urn:test:i3#e"), 1200000.00 USD) { id "f3"; origin case_input; }
    }
    // 850000 x 600000 / 1200000 = 425000.00.
    evaluate truth(maximum_tax_payable_in_installments(entity_ref("urn:test:i3#e"), 425000.00 USD));
    expect truth_status == TRUE_ONLY;
}

