language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "S6166E-01-DEFICIENCY-PRORATED-TO-EQUAL-INSTALLMENTS" {
    given {
        context { decision_time @2027-03-01T09:00:00-05:00; knowledge_time @2027-03-01T09:00:00-05:00; legal_time @2027-03-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert election_valid_6166(entity_ref("urn:test:a1#e")) { id "f0"; origin case_input; }
        assert installment_extension_in_effect(entity_ref("urn:test:a1#e")) { id "f1"; origin case_input; }
        assert executor_of_estate(entity_ref("urn:test:a1#e"), entity_ref("urn:test:a1#x")) { id "f2"; origin case_input; }
        assert tax_elected_for_installments(entity_ref("urn:test:a1#e"), 500000.00 USD) { id "f3"; origin case_input; }
        assert installments_elected(entity_ref("urn:test:a1#e"), 10) { id "f4"; origin case_input; }
        assert maximum_tax_payable_in_installments(entity_ref("urn:test:a1#e"), 900000.00 USD) { id "f5"; origin case_input; }
        assert estate_tax_deficiency_assessed(entity_ref("urn:test:a1#e"), 100000.00 USD, @2027-03-01) { id "f6"; origin case_input; }
        assert installment_due_date(entity_ref("urn:test:a1#e"), 2, @2027-03-15) { id "f7"; origin case_input; }
    }
    // headroom 900000 - 500000 = 400000; the deficiency 100000 is within it; 100000 / 10 = 10000.00 per installment.
    evaluate truth(deficiency_share_per_installment(entity_ref("urn:test:a1#e"), 2, 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

