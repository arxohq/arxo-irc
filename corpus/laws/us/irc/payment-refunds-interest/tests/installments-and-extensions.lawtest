    evaluate truth(closely_held_business_installments_granted(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")));
    expect truth_status == NEITHER;
}

test "S6166-02-ELECTION-WITH-QUALIFICATION-SHOWN-GRANTS-INSTALLMENTS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert closely_held_business_extension_elected(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f0"; origin case_input; }
        assert closely_held_business_qualification_shown(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f1"; origin case_input; }
    }
    evaluate truth(closely_held_business_installments_granted(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")));
    expect truth_status == TRUE_ONLY;
}
