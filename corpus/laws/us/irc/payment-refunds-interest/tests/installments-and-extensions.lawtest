// Scenarios for 26 U.S.C. §§6159-6167, package us.irc.payment_refunds_interest,
// module 02-installments-and-extensions.law. Written from the text; NOT
// executed in this stage — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

// --- §6159(a): discretionary installment agreement power --------------------

test "S6159-01-SECRETARY-MAY-ENTER-AGREEMENT-WHEN-FACILITATES-COLLECTION" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert installment_agreement_offered(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert secretary_determines_facilitates_collection(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1) { id "f1"; origin case_input; }
    }
    evaluate truth(installment_agreement_entered(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S6159-02-OFFER-WITHOUT-FACILITATION-FINDING-IS-INVALID-EXERCISE" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert installment_agreement_offered(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
    }
    evaluate truth(installment_agreement_entered(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

// --- §6159(c): mandatory agreement (duty/power pair) ------------------------

test "S6159-03-QUALIFYING-INDIVIDUAL-CREATES-MANDATORY-AGREEMENT-DUTY" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert installment_agreement_offered(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert mandatory_agreement_liability_at_offer(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), 8000 USD) { id "f1"; origin case_input; }
        assert mandatory_agreement_compliance_history_clean(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f2"; origin case_input; }
        assert mandatory_agreement_financially_unable(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f3"; origin case_input; }
        assert mandatory_agreement_offers_three_year_payoff(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f4"; origin case_input; }
        assert mandatory_agreement_taxpayer_agrees_to_comply(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(EnterMandatoryInstallmentAgreement, ACTIVE);
}

test "S6159-04-LIABILITY-ABOVE-TEN-THOUSAND-IS-NOT-MANDATORY" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert mandatory_agreement_liability_at_offer(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), 10001 USD) { id "f0"; origin case_input; }
        assert mandatory_agreement_compliance_history_clean(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f1"; origin case_input; }
        assert mandatory_agreement_financially_unable(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f2"; origin case_input; }
        assert mandatory_agreement_offers_three_year_payoff(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f3"; origin case_input; }
        assert mandatory_agreement_taxpayer_agrees_to_comply(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025")) { id "f4"; origin case_input; }
    }
    evaluate truth(mandatory_agreement_qualifies(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), 10001 USD));
    expect truth_status == NEITHER;
}

// --- §6161(a): extension of time to pay — valid and invalid exercise -------

test "S6161-01-SIX-MONTH-EXTENSION-IS-VALID" {
    given {
        context { decision_time @2026-04-01T09:00:00-04:00; knowledge_time @2026-04-01T09:00:00-04:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert extension_request_for(entity_ref("urn:...#REQ1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert extension_from_date(entity_ref("urn:...#REQ1"), @2026-04-15) { id "f1"; origin case_input; }
        assert extension_until_date(entity_ref("urn:...#REQ1"), @2026-10-15) { id "f2"; origin case_input; }
    }
    evaluate truth(extension_granted_amount_shown_on_return(entity_ref("urn:...#REQ1")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S6161-02-SEVEN-MONTH-EXTENSION-FOR-NON-ESTATE-TAX-IS-INVALID" {
    given {
        context { decision_time @2026-04-01T09:00:00-04:00; knowledge_time @2026-04-01T09:00:00-04:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert extension_request_for(entity_ref("urn:...#REQ2"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert extension_from_date(entity_ref("urn:...#REQ2"), @2026-04-15) { id "f1"; origin case_input; }
        assert extension_until_date(entity_ref("urn:...#REQ2"), @2026-11-15) { id "f2"; origin case_input; }
    }
    evaluate truth(extension_granted_amount_shown_on_return(entity_ref("urn:...#REQ2")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

test "S6161-03-TWELVE-MONTH-EXTENSION-VALID-FOR-ESTATE-TAX" {
    given {
        context { decision_time @2026-04-01T09:00:00-04:00; knowledge_time @2026-04-01T09:00:00-04:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert extension_request_for(entity_ref("urn:...#REQ3"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::EstateCh11) { id "f0"; origin case_input; }
        assert extension_request_is_estate_tax(entity_ref("urn:...#REQ3")) { id "f1"; origin case_input; }
        assert extension_from_date(entity_ref("urn:...#REQ3"), @2026-04-15) { id "f2"; origin case_input; }
        assert extension_until_date(entity_ref("urn:...#REQ3"), @2027-04-15) { id "f3"; origin case_input; }
    }
    evaluate truth(extension_granted_amount_shown_on_return(entity_ref("urn:...#REQ3")));
    expect truth_status == TRUE_ONLY;
}

// --- §6161(b): deficiency extension (evaluative: undue hardship) -----------

test "S6161-04-DEFICIENCY-EXTENSION-GRANTED-ON-SHOWN-HARDSHIP" {
    given {
        context { decision_time @2026-04-01T09:00:00-04:00; knowledge_time @2026-04-01T09:00:00-04:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert deficiency_extension_requested(entity_ref("urn:...#REQ4"), entity_ref("urn:...#P1")) { id "f0"; origin case_input; }
        assert extension_from_date(entity_ref("urn:...#REQ4"), @2026-04-15) { id "f1"; origin case_input; }
        assert extension_until_date(entity_ref("urn:...#REQ4"), @2027-06-15) { id "f2"; origin case_input; }
        assert s6161_undue_hardship_shown(entity_ref("urn:...#P1"), entity_ref("urn:...#REQ4")) { id "f3"; origin adjudicated; }
    }
    evaluate truth(deficiency_extension_granted(entity_ref("urn:...#REQ4")));
    expect truth_status == TRUE_ONLY;
}

test "S6161-05-NO-EXTENSION-WHEN-DEFICIENCY-DUE-TO-FRAUD" {
    given {
        context { decision_time @2026-04-01T09:00:00-04:00; knowledge_time @2026-04-01T09:00:00-04:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert deficiency_extension_requested(entity_ref("urn:...#REQ5"), entity_ref("urn:...#P1")) { id "f0"; origin case_input; }
        assert extension_from_date(entity_ref("urn:...#REQ5"), @2026-04-15) { id "f1"; origin case_input; }
        assert extension_until_date(entity_ref("urn:...#REQ5"), @2027-06-15) { id "f2"; origin case_input; }
        assert s6161_undue_hardship_shown(entity_ref("urn:...#P1"), entity_ref("urn:...#REQ5")) { id "f3"; origin adjudicated; }
        assert deficiency_due_to_negligence_disregard_or_fraud(entity_ref("urn:...#REQ5")) { id "f4"; origin case_input; }
    }
    evaluate truth(deficiency_extension_granted(entity_ref("urn:...#REQ5")));
    expect truth_status == NEITHER;
}

