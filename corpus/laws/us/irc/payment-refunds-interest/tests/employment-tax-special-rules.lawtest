// Scenarios for 26 U.S.C. §6413, package us.irc.payment_refunds_interest,
// module 05-employment-tax-special-rules.law. Written from the text; NOT
// executed in this stage — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "S6413-01-ADJUSTMENT-DUTY-WHEN-ADJUSTMENT-POSSIBLE" {
    given {
        context { decision_time @2026-08-01T09:00:00-04:00; knowledge_time @2026-08-01T09:00:00-04:00; legal_time @2026-08-01; timezone "America/New_York"; }
        assert employment_tax_overwithheld(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::FicaCh21, 50 USD) { id "f0"; origin case_input; }
        assert employment_tax_adjustment_possible(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::FicaCh21) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(AdjustOverwithheldEmploymentTax, ACTIVE);
}

test "S6413-02-REFUND-DUTY-WHEN-ADJUSTMENT-NOT-POSSIBLE" {
    given {
        context { decision_time @2026-08-01T09:00:00-04:00; knowledge_time @2026-08-01T09:00:00-04:00; legal_time @2026-08-01; timezone "America/New_York"; }
        assert employment_tax_overwithheld(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::FicaCh21, 50 USD) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(RefundOverwithheldEmploymentTax, ACTIVE);
}

test "S6413-03-EXCESS-OVER-WAGE-BASE-COMPUTES-SPECIAL-REFUND" {
    // wages $200,000 vs $168,600 base, tax withheld $12,400 (6.2% of 200k):
    // refund = withheld - withheld*(base/wages) = 12400 - 12400*(168600/200000)
    //        = 12400 - 10453.2 = 1946.80
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert multiple_employer_fica_or_rrta_wages(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), 200000 USD) { id "f0"; origin case_input; }
        assert social_security_contribution_and_benefit_base(entity_ref("urn:...#Y2026"), 168600 USD) { id "f1"; origin case_input; }
        assert multiple_employer_tax_withheld(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), 12400 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(multiple_employer_special_refund_amount(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), 1946.80 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6413-04-WAGES-AT-OR-BELOW-BASE-NEEDS-NO-SPECIAL-REFUND" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert multiple_employer_fica_or_rrta_wages(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), 150000 USD) { id "f0"; origin case_input; }
        assert social_security_contribution_and_benefit_base(entity_ref("urn:...#Y2026"), 168600 USD) { id "f1"; origin case_input; }
        assert multiple_employer_tax_withheld(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), 9300 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(multiple_employer_special_refund_amount(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), 0 USD));
    expect truth_status == NEITHER;
}

test "S6413-05-FUTA-CREDIT-NOT-PREVIOUSLY-ALLOWED-IS-AN-OVERPAYMENT" {
    given {
        context { decision_time @2026-04-01T09:00:00-04:00; knowledge_time @2026-04-01T09:00:00-04:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert futa_credit_not_previously_allowed(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), 40 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(overpayment_amount(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2025"), us.irc.core::FutaCh23, 40 USD));
    expect truth_status == TRUE_ONLY;
}
