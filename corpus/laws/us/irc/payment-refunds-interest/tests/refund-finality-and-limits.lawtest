        assert deposit_disputable_tax_amount(entity_ref("urn:us:irc:payment_refunds_interest:clir#D1"), 3000 USD) { id "f4"; origin case_input; }
    }
    evaluate truth(returned_deposit_treated_as_payment_amount(entity_ref("urn:us:irc:payment_refunds_interest:clir#D1"), 3000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6603-06-THIRTY-DAY-LETTER-FLOORS-DISPUTABLE-TAX" {
    given {
        context { decision_time @2027-09-01T09:00:00-04:00; knowledge_time @2027-09-01T09:00:00-04:00; legal_time @2027-09-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert deposit_disputable_tax_amount(entity_ref("urn:us:irc:payment_refunds_interest:clir#D1"), 3000 USD) { id "f0"; origin case_input; }
        assert letter_30_day_proposed_deficiency(entity_ref("urn:us:irc:payment_refunds_interest:clir#D1"), 4200 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(deposit_disputable_tax_effective(entity_ref("urn:us:irc:payment_refunds_interest:clir#D1"), 4200 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6603-07-EARLIEST-DEPOSIT-IS-USED-FIRST" {
    given {
        context { decision_time @2027-09-01T09:00:00-04:00; knowledge_time @2027-09-01T09:00:00-04:00; legal_time @2027-09-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert deposit_made(entity_ref("urn:us:irc:payment_refunds_interest:clir#D1"), entity_ref("urn:us:irc:payment_refunds_interest:clir#P1"), 1000 USD, @2027-03-01) { id "f0"; origin case_input; }
        assert deposit_made(entity_ref("urn:us:irc:payment_refunds_interest:clir#D2"), entity_ref("urn:us:irc:payment_refunds_interest:clir#P1"), 2000 USD, @2027-04-01) { id "f1"; origin case_input; }
    }
    evaluate truth(deposit_first_in_order_of_use(entity_ref("urn:us:irc:payment_refunds_interest:clir#D1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(deposit_first_in_order_of_use(entity_ref("urn:us:irc:payment_refunds_interest:clir#D2")));
    expect truth_status == NEITHER;
}

