// 2027-07-29; 2027-06-15 + 90 = 2027-09-13; 2027-10-31 + 90 = 2028-01-29;
// 2027-04-01 + 90 = 2027-06-30.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

