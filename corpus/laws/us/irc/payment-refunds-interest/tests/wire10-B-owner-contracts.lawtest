// Payment/refunds WIRE-10 group B owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "W10B-PRI-06-ESTATE-DNI-FROM-TRUSTS-ESTATES" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.trusts_estates::distributable_net_income(entity_ref("urn:test:w10b:n1#e"), entity_ref("urn:test:w10b:n1#y"), 9000.00 USD) { origin case_input; }
    }
    evaluate truth(estate_distributable_net_income(entity_ref("urn:test:w10b:n1#e"), entity_ref("urn:test:w10b:n1#y"), 9000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PRI-07-ESTATE-DNI-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": estate_distributable_net_income(entity_ref("urn:test:w10b:n2#e"), entity_ref("urn:test:w10b:n2#y"), 9000.00 USD) { origin case_input; }
    }
    evaluate truth(estate_distributable_net_income(entity_ref("urn:test:w10b:n2#e"), entity_ref("urn:test:w10b:n2#y"), 9000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PRI-08-SECTION-6014-ELECTION-FROM-RETURNS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.returns::elects_tax_not_shown_6014(entity_ref("urn:test:w10b:n3#p"), entity_ref("urn:test:w10b:n3#y")) { origin case_input; }
    }
    evaluate truth(elects_under_s6014(entity_ref("urn:test:w10b:n3#p"), entity_ref("urn:test:w10b:n3#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PRI-09-SECTION-6014-ELECTION-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_under_s6014(entity_ref("urn:test:w10b:n4#p"), entity_ref("urn:test:w10b:n4#y")) { origin case_input; }
    }
    evaluate truth(elects_under_s6014(entity_ref("urn:test:w10b:n4#p"), entity_ref("urn:test:w10b:n4#y")));
    expect truth_status == TRUE_ONLY;
}
