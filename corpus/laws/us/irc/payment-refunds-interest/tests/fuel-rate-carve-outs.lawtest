test "S6421F2B-01-COMMERCIAL-AVIATION-GASOLINE-LUST-AND-4-3-CENTS-CARVED-OUT" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert fuel_claim_basis(entity_ref("urn:test:f1#c"), AircraftGasoline) { id "f0"; origin case_input; }
        assert fuel_claim_tax_rate(entity_ref("urn:test:f1#c"), 0.183) { id "f1"; origin case_input; }
        assert fuel_claim_lust_rate(entity_ref("urn:test:f1#c"), 0.001) { id "f2"; origin case_input; }
        assert fuel_claim_rate_4081a2A(entity_ref("urn:test:f1#c"), 0.183) { id "f3"; origin case_input; }
        assert fuel_purchased_on(entity_ref("urn:test:f1#c"), @2026-01-15) { id "f4"; origin case_input; }
        assert fuel_used_in_aircraft(entity_ref("urn:test:f1#c")) { id "f5"; origin case_input; }
        assert aircraft_use_is_commercial_aviation(entity_ref("urn:test:f1#c")) { id "f6"; origin case_input; }
    }
    // 0.183 - (0.001 + 0.043) = 0.139
    evaluate truth(fuel_claim_rate_after_reduction(entity_ref("urn:test:f1#c"), 0.139));
    expect truth_status == TRUE_ONLY;
}

