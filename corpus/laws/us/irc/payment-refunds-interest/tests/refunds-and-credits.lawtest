// Scenarios for 26 U.S.C. §§6401-6403, package us.irc.payment_refunds_interest,
// module 03-refunds-and-credits.law. Written from the text; NOT executed in
// this stage — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

// --- §6401: overpayment classification --------------------------------------

test "S6401-01-EXCESS-PAYMENT-IS-AN-OVERPAYMENT" {
    given {
        context { decision_time @2027-04-20T09:00:00-04:00; knowledge_time @2027-04-20T09:00:00-04:00; legal_time @2027-04-20; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert us.irc.core::payment(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), 1500 USD, @2027-04-10) { id "f1"; origin case_input; }
        assert us.irc.core::payment_applied(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
    }
    evaluate truth(overpayment_amount(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 500 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §6402(a)-(f): the offset priority chain --------------------------------

test "S6402-01-NO-OFFSETS-REFUNDS-FULL-OVERPAYMENT" {
    given {
        context { decision_time @2027-05-01T09:00:00-04:00; knowledge_time @2027-05-01T09:00:00-04:00; legal_time @2027-05-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert us.irc.core::payment(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), 1500 USD, @2027-04-10) { id "f1"; origin case_input; }
        assert us.irc.core::payment_applied(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
    }
    evaluate truth(refund_balance_after_unemployment_offset(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 500 USD));
    expect truth_status == TRUE_ONLY;
    evaluate positions();
    expect position(RefundOverpaymentBalance, ACTIVE);
}

test "S6402-02-SUPPORT-OFFSET-REDUCES-REFUND-BEFORE-FEDERAL-AGENCY-OFFSET" {
    // $500 overpayment, $200 past-due support, $1000 federal agency debt:
    // (c) takes $200 first, leaving $300; (d) then takes the remaining $300.
    given {
        context { decision_time @2027-05-01T09:00:00-04:00; knowledge_time @2027-05-01T09:00:00-04:00; legal_time @2027-05-01; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 1000 USD) { id "f0"; origin case_input; }
        assert us.irc.core::payment(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), 1500 USD, @2027-04-10) { id "f1"; origin case_input; }
        assert us.irc.core::payment_applied(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
        assert offset_obligation_kind(entity_ref("urn:...#O1"), PastDueSupport) { id "f3"; origin case_input; }
        assert offset_obligation_owed_by(entity_ref("urn:...#O1"), entity_ref("urn:...#P1"), 200 USD) { id "f4"; origin case_input; }
        assert offset_obligation_kind(entity_ref("urn:...#O2"), FederalAgencyDebt) { id "f5"; origin case_input; }
        assert offset_obligation_owed_by(entity_ref("urn:...#O2"), entity_ref("urn:...#P1"), 1000 USD) { id "f6"; origin case_input; }
        assert offset_notice_received_on(entity_ref("urn:...#O1"), @2027-03-01) { id "f7"; origin case_input; }
        assert past_due_support_464c(entity_ref("urn:...#O1")) { id "f8"; origin case_input; }
        assert offset_obligation_accrued_on(entity_ref("urn:...#O1"), @2026-01-01) { id "f9"; origin case_input; }
        assert offset_notice_received_on(entity_ref("urn:...#O2"), @2027-03-05) { id "f10"; origin case_input; }
        assert past_due_legally_enforceable_federal_debt(entity_ref("urn:...#O2")) { id "f11"; origin case_input; }
        assert offset_obligation_accrued_on(entity_ref("urn:...#O2"), @2026-02-01) { id "f12"; origin case_input; }
    }
    evaluate truth(refund_balance_after_support_offset(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 300 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(refund_balance_after_federal_agency_offset(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6402-03-EXPLANATION-DUTY-ON-DISALLOWED-CLAIM" {
    given {
        context { decision_time @2027-05-01T09:00:00-04:00; knowledge_time @2027-05-01T09:00:00-04:00; legal_time @2027-05-01; timezone "America/New_York"; }
        assert us.irc.core::claim_of(entity_ref("urn:...#C1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 500 USD) { id "f0"; origin case_input; }
        assert refund_claim_disallowed(entity_ref("urn:...#C1")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(ExplainRefundDisallowance, ACTIVE);
}

test "S6402-04-NO-JUDICIAL-REVIEW-OF-A-REDUCTION-VIOLATED-ON-ATTEMPT" {
    given {
        context { decision_time @2027-05-01T09:00:00-04:00; knowledge_time @2027-05-01T09:00:00-04:00; legal_time @2027-05-01; timezone "America/New_York"; }
        assert brings_action_to_review_reduction(entity_ref("urn:...#P1"), entity_ref("urn:...#O1")) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(NoJudicialReviewOfOffsetReduction, VIOLATED);
}

// --- §6403: overpayment of an installment -----------------------------------

test "S6403-01-INSTALLMENT-EXCESS-CREDITED-AGAINST-UNPAID-INSTALLMENTS" {
    given {
        context { decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; legal_time @2026-09-01; timezone "America/New_York"; }
        assert installment_overpaid(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::EstateCh11, 100 USD) { id "f0"; origin case_input; }
        assert unpaid_installments_exist(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::EstateCh11) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(CreditInstallmentExcessAgainstUnpaidInstallments, ACTIVE);
}

test "S6403-02-NO-UNPAID-INSTALLMENTS-FALLS-THROUGH-TO-S6402-OVERPAYMENT" {
    given {
        context { decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; legal_time @2026-09-01; timezone "America/New_York"; }
        assert installment_overpaid(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::EstateCh11, 100 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(overpayment_amount(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::EstateCh11, 100 USD));
    expect truth_status == TRUE_ONLY;
}
