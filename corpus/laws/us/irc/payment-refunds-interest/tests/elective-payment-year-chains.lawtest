test "S6418F1B-09-OUTSIDE-PERIOD-BLOCKS-VALID-TRANSFER-ELECTION" {
    given {
        context { decision_time @2035-06-01T09:00:00-05:00; knowledge_time @2035-06-01T09:00:00-05:00; legal_time @2035-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert elective_credit_item(entity_ref("urn:test:r9#cr"), entity_ref("urn:test:r9#h"), entity_ref("urn:test:r9#y2034"), RenewableElectricityProduction45, 100000 USD) { id "f0"; origin case_input; }
        assert credit_originally_placed_in_service_on(entity_ref("urn:test:r9#cr"), @2024-01-01) { id "f1"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:test:r9#y2034"), @2034-01-01) { id "f2"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:test:r9#y2034"), @2034-12-31) { id "f3"; origin case_input; }
        assert elects_under_6418(entity_ref("urn:test:r9#cr"), entity_ref("urn:test:r9#h"), entity_ref("urn:test:r9#tf"), @2035-03-01, 100000 USD) { id "f4"; origin case_input; }
    }
    // the other validity conditions are not all asserted, so this scenario documents the wiring of the period defect into the validity rule.
    evaluate truth(credit_transfer_election_valid(entity_ref("urn:test:r9#cr"), entity_ref("urn:test:r9#h"), entity_ref("urn:test:r9#tf")));
    expect truth_status == NEITHER;
}

