        assert tax_elected_for_installments(entity_ref("urn:us:irc:payment_refunds_interest:clir#E1"), 150000 USD) { id "f13"; origin case_input; }
        assert first_installment_date_selected(entity_ref("urn:us:irc:payment_refunds_interest:clir#E1"), @2029-06-01) { id "f14"; origin case_input; }
        assert installment_paid(entity_ref("urn:us:irc:payment_refunds_interest:clir#E1"), 1) { id "f15"; origin case_input; }
    }
    evaluate positions();
    expect position(PayEstateTaxInstallment, SATISFIED);
}
