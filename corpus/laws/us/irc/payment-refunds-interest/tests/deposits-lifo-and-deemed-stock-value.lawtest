test "S6166B8A-01-DEEMED-VOTING-STOCK-THROUGH-THREE-HOLDING-COMPANIES" {
    given {
        context { decision_time @2027-06-01T09:00:00-05:00; knowledge_time @2027-06-01T09:00:00-05:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert executor_elects_b8(entity_ref("urn:test:b1#e")) { id "f0"; origin case_input; }
        assert interest_included_in_gross_estate_of(entity_ref("urn:test:b1#i"), entity_ref("urn:test:b1#e")) { id "f1"; origin case_input; }
        assert interest_in_company(entity_ref("urn:test:b1#i"), entity_ref("urn:test:b1#h1")) { id "f2"; origin case_input; }
        assert corporation_holds_stock_in(entity_ref("urn:test:b1#h1"), entity_ref("urn:test:b1#h2")) { id "f3"; origin case_input; }
        assert corporation_holds_stock_in(entity_ref("urn:test:b1#h2"), entity_ref("urn:test:b1#h3")) { id "f4"; origin case_input; }
        assert corporation_holds_stock_in(entity_ref("urn:test:b1#h3"), entity_ref("urn:test:b1#b")) { id "f5"; origin case_input; }
        assert corporation_carries_on_trade_or_business(entity_ref("urn:test:b1#b")) { id "f6"; origin case_input; }
        assert voting_stock_percent_included_in_gross_estate(entity_ref("urn:test:b1#i"), 50.0) { id "f7"; origin case_input; }
        assert holding_company_voting_percent_in(entity_ref("urn:test:b1#h1"), entity_ref("urn:test:b1#h2"), 80.0) { id "f8"; origin case_input; }
        assert holding_company_voting_percent_in(entity_ref("urn:test:b1#h2"), entity_ref("urn:test:b1#h3"), 50.0) { id "f9"; origin case_input; }
        assert holding_company_voting_percent_in(entity_ref("urn:test:b1#h3"), entity_ref("urn:test:b1#b"), 50.0) { id "f10"; origin case_input; }
    }
    // 50 x 80 x 50 x 50 / 10^6 = 10.
    evaluate truth(deemed_voting_stock_percent(entity_ref("urn:test:b1#e"), entity_ref("urn:test:b1#b"), 10.0));
    expect truth_status == TRUE_ONLY;
}

