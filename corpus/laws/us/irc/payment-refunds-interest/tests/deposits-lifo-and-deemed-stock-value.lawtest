test "S6603E2-09-SAME-DATE-DEPOSITS-EACH-CHARGED-THE-SAME-REMAINDER" {
    given {
        context { decision_time @2027-06-01T09:00:00-05:00; knowledge_time @2027-06-01T09:00:00-05:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
