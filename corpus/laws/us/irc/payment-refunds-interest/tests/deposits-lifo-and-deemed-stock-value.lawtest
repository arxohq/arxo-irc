// Stage 3b (26.09.2026) scenarios for 6603(e)(2) and 6166(b)(8)(A)(i), module 23 and the third holding company of module 18. NOT EXECUTED.


language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "S6603E2-01-LATEST-DEPOSIT-RETURNED-FIRST" {
    given {
        context { decision_time @2027-06-01T09:00:00-05:00; knowledge_time @2027-06-01T09:00:00-05:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert deposit_made(entity_ref("urn:test:l1#d1"), entity_ref("urn:test:l1#p"), 5000 USD, @2026-01-01) { id "f0"; origin case_input; }
        assert deposit_made(entity_ref("urn:test:l1#d2"), entity_ref("urn:test:l1#p"), 3000 USD, @2026-06-01) { id "f1"; origin case_input; }
        assert total_deposit_amount_returned(entity_ref("urn:test:l1#p"), 2000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(deposit_returned_last_in_first_out(entity_ref("urn:test:l1#p"), entity_ref("urn:test:l1#d2"), 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6603E2-02-EARLIER-DEPOSIT-UNTOUCHED-WHEN-LATER-COVERS-THE-RETURN" {
    given {
        context { decision_time @2027-06-01T09:00:00-05:00; knowledge_time @2027-06-01T09:00:00-05:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert deposit_made(entity_ref("urn:test:l2#d1"), entity_ref("urn:test:l2#p"), 5000 USD, @2026-01-01) { id "f0"; origin case_input; }
        assert deposit_made(entity_ref("urn:test:l2#d2"), entity_ref("urn:test:l2#p"), 3000 USD, @2026-06-01) { id "f1"; origin case_input; }
        assert total_deposit_amount_returned(entity_ref("urn:test:l2#p"), 2000 USD) { id "f2"; origin case_input; }
    }
    // no amount is returned from the earlier deposit: the relation has no zero row.
    evaluate truth(deposit_returned_last_in_first_out(entity_ref("urn:test:l2#p"), entity_ref("urn:test:l2#d1"), 0 USD));
    expect truth_status == NEITHER;
}

