test "S6603E2-05-THREE-DEPOSITS-MIDDLE-PARTLY-RETURNED" {
    given {
        context { decision_time @2027-06-01T09:00:00-05:00; knowledge_time @2027-06-01T09:00:00-05:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert deposit_made(entity_ref("urn:test:l5#d1"), entity_ref("urn:test:l5#p"), 5000 USD, @2026-01-01) { id "f0"; origin case_input; }
        assert deposit_made(entity_ref("urn:test:l5#d2"), entity_ref("urn:test:l5#p"), 3000 USD, @2026-06-01) { id "f1"; origin case_input; }
        assert deposit_made(entity_ref("urn:test:l5#d3"), entity_ref("urn:test:l5#p"), 2000 USD, @2026-09-01) { id "f2"; origin case_input; }
        assert total_deposit_amount_returned(entity_ref("urn:test:l5#p"), 4000 USD) { id "f3"; origin case_input; }
    }
    // later d3 gives 2000, remainder 2000 from d2, nothing from d1.
    evaluate truth(deposit_returned_last_in_first_out(entity_ref("urn:test:l5#p"), entity_ref("urn:test:l5#d2"), 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6603E2-06-DEPOSIT-USED-TO-PAY-TAX-NOT-AVAILABLE-FOR-RETURN" {
    given {
        context { decision_time @2027-06-01T09:00:00-05:00; knowledge_time @2027-06-01T09:00:00-05:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert deposit_made(entity_ref("urn:test:l6#d1"), entity_ref("urn:test:l6#p"), 5000 USD, @2026-01-01) { id "f0"; origin case_input; }
        assert deposit_made(entity_ref("urn:test:l6#d2"), entity_ref("urn:test:l6#p"), 3000 USD, @2026-06-01) { id "f1"; origin case_input; }
        assert total_deposit_amount_returned(entity_ref("urn:test:l6#p"), 4000 USD) { id "f2"; origin case_input; }
        assert deposit_amount_used_to_pay_tax(entity_ref("urn:test:l6#d2"), 2500 USD) { id "f3"; origin case_input; }
    }
    // available of d2 is 500; the rest, 3500, comes from d1.
    evaluate truth(deposit_returned_last_in_first_out(entity_ref("urn:test:l6#p"), entity_ref("urn:test:l6#d2"), 500 USD));
    expect truth_status == TRUE_ONLY;
}

