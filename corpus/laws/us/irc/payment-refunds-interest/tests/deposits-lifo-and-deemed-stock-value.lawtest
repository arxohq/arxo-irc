        assert deposit_made(entity_ref("urn:test:l9#d2"), entity_ref("urn:test:l9#p"), 3000 USD, @2026-01-01) { id "f1"; origin case_input; }
        assert total_deposit_amount_returned(entity_ref("urn:test:l9#p"), 2000 USD) { id "f2"; origin case_input; }
    }
    // JUDGMENT CALL: same-date deposits are not later than each other.
    evaluate truth(deposit_returned_last_in_first_out(entity_ref("urn:test:l9#p"), entity_ref("urn:test:l9#d1"), 2000 USD));
    expect truth_status == TRUE_ONLY;
}

