// Payment, refunds, interest WIRE-10 (group C) scenarios: section 34 amounts payable under sections 6420, 6421, 6427 derived from the fuel claims.
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

test "W10C-PRI-01-FARM-GASOLINE-CLAIM-AMOUNT-FEEDS-THE-SECTION-34-PLACEHOLDER" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fuel_claim_by(entity_ref("urn:test:w10c:a#c1"), entity_ref("urn:test:w10c:a#p"), entity_ref("urn:test:w10c:a#y")) { origin case_input; }
        assert "f1": fuel_claim_basis(entity_ref("urn:test:w10c:a#c1"), FarmGasoline) { origin case_input; }
        assert "f2": fuel_claim_payable_amount(entity_ref("urn:test:w10c:a#c1"), 18.30 USD) { origin case_input; }
    }
    evaluate truth(us.irc.credits::amount_payable_under_6420_34(entity_ref("urn:test:w10c:a#p"), entity_ref("urn:test:w10c:a#y"), 18.30 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10C-PRI-02-TWO-FARM-GASOLINE-CLAIMS-OF-THE-YEAR-ARE-SUMMED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fuel_claim_by(entity_ref("urn:test:w10c:b#c1"), entity_ref("urn:test:w10c:b#p"), entity_ref("urn:test:w10c:b#y")) { origin case_input; }
        assert "f1": fuel_claim_basis(entity_ref("urn:test:w10c:b#c1"), FarmGasoline) { origin case_input; }
        assert "f2": fuel_claim_payable_amount(entity_ref("urn:test:w10c:b#c1"), 10.00 USD) { origin case_input; }
        assert "f3": fuel_claim_by(entity_ref("urn:test:w10c:b#c2"), entity_ref("urn:test:w10c:b#p"), entity_ref("urn:test:w10c:b#y")) { origin case_input; }
        assert "f4": fuel_claim_basis(entity_ref("urn:test:w10c:b#c2"), FarmGasoline) { origin case_input; }
        assert "f5": fuel_claim_payable_amount(entity_ref("urn:test:w10c:b#c2"), 5.50 USD) { origin case_input; }
    }
    evaluate truth(us.irc.credits::amount_payable_under_6420_34(entity_ref("urn:test:w10c:b#p"), entity_ref("urn:test:w10c:b#y"), 15.50 USD));
    expect truth_status == TRUE_ONLY;
}

