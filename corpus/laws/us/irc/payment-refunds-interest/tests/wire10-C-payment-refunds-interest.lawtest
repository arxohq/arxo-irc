}

test "W10C-PRI-06-CLAIM-OF-ANOTHER-YEAR-IS-NOT-COUNTED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fuel_claim_by(entity_ref("urn:test:w10c:f#c1"), entity_ref("urn:test:w10c:f#p"), entity_ref("urn:test:w10c:f#y1")) { origin case_input; }
        assert "f1": fuel_claim_basis(entity_ref("urn:test:w10c:f#c1"), FarmGasoline) { origin case_input; }
        assert "f2": fuel_claim_payable_amount(entity_ref("urn:test:w10c:f#c1"), 18.30 USD) { origin case_input; }
        assert "f3": fuel_claim_by(entity_ref("urn:test:w10c:f#c2"), entity_ref("urn:test:w10c:f#p"), entity_ref("urn:test:w10c:f#y2")) { origin case_input; }
        assert "f4": fuel_claim_basis(entity_ref("urn:test:w10c:f#c2"), FarmGasoline) { origin case_input; }
        assert "f5": fuel_claim_payable_amount(entity_ref("urn:test:w10c:f#c2"), 3.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.credits::amount_payable_under_6420_34(entity_ref("urn:test:w10c:f#p"), entity_ref("urn:test:w10c:f#y1"), 21.30 USD));
    expect truth_status == FALSE_ONLY;
}

test "W10C-PRI-07-NO-CLAIM-NO-INVENTED-ZERO-AMOUNT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fuel_claim_gallons(entity_ref("urn:test:w10c:g#c1"), 1.0) { origin case_input; }
    }
    evaluate truth(us.irc.credits::amount_payable_under_6420_34(entity_ref("urn:test:w10c:g#p"), entity_ref("urn:test:w10c:g#y"), 0.00 USD));
    expect truth_status == FALSE_ONLY;
}

test "W10C-PRI-08-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.credits::amount_payable_under_6427_34(entity_ref("urn:test:w10c:h#p"), entity_ref("urn:test:w10c:h#y"), 12.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.credits::amount_payable_under_6427_34(entity_ref("urn:test:w10c:h#p"), entity_ref("urn:test:w10c:h#y"), 12.00 USD));
    expect truth_status == TRUE_ONLY;
}
