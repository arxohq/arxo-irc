// Scenarios for 26 U.S.C. §§6151-6158, package us.irc.payment_refunds_interest,
// module 01-payment-duty.law. Written from the text; NOT executed in this
// stage (owner's NO-HEAVY-CHECKS restriction) — `implemented_unverified` per
// docs/foundations/us-irc/AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

// --- §6151(a): duty to pay tax shown on the return --------------------------

test "S6151-01-FULL-PAYMENT-ON-TIME-SATISFIES-DUTY" {
    given {
        context { decision_time @2027-04-16T09:00:00-04:00; knowledge_time @2027-04-16T09:00:00-04:00; legal_time @2027-04-16; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::filed_by(entity_ref("urn:...#R1"), entity_ref("urn:...#P1")) { id "f1"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:...#R1"), @2027-04-15) { id "f2"; origin case_input; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 5000 USD) { id "f3"; origin case_input; }
        assert us.irc.core::payment(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), 5000 USD, @2027-04-10) { id "f4"; origin case_input; }
        assert us.irc.core::payment_applied(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(PayTaxShownOnReturn, SATISFIED);
}

test "S6151-02-PARTIAL-PAYMENT-VIOLATES-DUTY-AFTER-DUE-DATE" {
    given {
        context { decision_time @2027-05-01T09:00:00-04:00; knowledge_time @2027-05-01T09:00:00-04:00; legal_time @2027-05-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::filed_by(entity_ref("urn:...#R1"), entity_ref("urn:...#P1")) { id "f1"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:...#R1"), @2027-04-15) { id "f2"; origin case_input; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 5000 USD) { id "f3"; origin case_input; }
        assert us.irc.core::payment(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), 3000 USD, @2027-04-10) { id "f4"; origin case_input; }
        assert us.irc.core::payment_applied(entity_ref("urn:...#PAY1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(PayTaxShownOnReturn, VIOLATED);
}

test "S6151-03-PAYMENT-AFTER-FILING-EXTENSION-STILL-USES-PRE-EXTENSION-DUE-DATE" {
    // §6151(a): "determined without regard to any extension of time for
    // filing the return" — core's `due_date` is already the pre-extension
    // date, so a filing extension does not push this duty's deadline.
    given {
        context { decision_time @2027-04-20T09:00:00-04:00; knowledge_time @2027-04-20T09:00:00-04:00; legal_time @2027-04-20; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::filed_by(entity_ref("urn:...#R1"), entity_ref("urn:...#P1")) { id "f1"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:...#R1"), @2027-04-15) { id "f2"; origin case_input; }
        assert us.irc.core::extension_granted(entity_ref("urn:...#R1"), @2027-10-15) { id "f6"; origin case_input; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 5000 USD) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(PayTaxShownOnReturn, VIOLATED);
}

test "S6151-04-UNKNOWN-PAYMENT-DATE-IS-UNDETERMINED" {
    given {
        context { decision_time @2027-04-10T09:00:00-04:00; knowledge_time @2027-04-10T09:00:00-04:00; legal_time @2027-04-10; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:...#R1"), entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::filed_by(entity_ref("urn:...#R1"), entity_ref("urn:...#P1")) { id "f1"; origin case_input; }
        assert us.irc.core::liability(entity_ref("urn:...#P1"), entity_ref("urn:...#Y2026"), us.irc.core::IncomeCh1, 5000 USD) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(PayTaxShownOnReturn, ACTIVE);
}

// --- §6155(a): payment on notice and demand ---------------------------------

test "S6155-01-PAID-AFTER-NOTICE-AND-DEMAND-SATISFIES-DUTY" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert us.irc.core::notice_of(entity_ref("urn:...#N1"), us.irc.core::NoticeAndDemand, entity_ref("urn:...#P1")) { id "f0"; origin case_input; }
        assert notice_and_demand_amount(entity_ref("urn:...#N1"), entity_ref("urn:...#P1"), 1200 USD) { id "f1"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:...#N1"), @2027-05-01) { id "f2"; origin case_input; }
        assert notice_and_demand_paid(entity_ref("urn:...#N1"), entity_ref("urn:...#P1")) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(PayOnNoticeAndDemand, SATISFIED);
}

test "S6155-02-NO-PAYMENT-KEEPS-DUTY-ACTIVE" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert us.irc.core::notice_of(entity_ref("urn:...#N1"), us.irc.core::NoticeAndDemand, entity_ref("urn:...#P1")) { id "f0"; origin case_input; }
        assert notice_and_demand_amount(entity_ref("urn:...#N1"), entity_ref("urn:...#P1"), 1200 USD) { id "f1"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:...#N1"), @2027-05-01) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(PayOnNoticeAndDemand, ACTIVE);
}

// --- §6157: FUTA quarterly payment duty and $100 de minimis exception -------

test "S6157-01-ABOVE-DE-MINIMIS-CREATES-DUTY" {
    given {
        context { decision_time @2026-05-01T09:00:00-04:00; knowledge_time @2026-05-01T09:00:00-04:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert is_futa_employer(entity_ref("urn:...#E1"), 2026) { id "f0"; origin case_input; }
        assert futa_wages_for_period(entity_ref("urn:...#E1"), 2026, 1, 50000 USD) { id "f1"; origin case_input; }
        assert futa_prior_unpaid_for_year(entity_ref("urn:...#E1"), 2026, 1, 0 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(futa_period_tax_due(entity_ref("urn:...#E1"), 2026, 1));
    expect truth_status == TRUE_ONLY;
}

test "S6157-02-AT-OR-BELOW-DE-MINIMIS-NO-DUTY" {
    // 0.6% x wages <= $100 => wages <= $16,666.66...; use $10,000 wages => $60 tax.
    given {
        context { decision_time @2026-05-01T09:00:00-04:00; knowledge_time @2026-05-01T09:00:00-04:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert is_futa_employer(entity_ref("urn:...#E1"), 2026) { id "f0"; origin case_input; }
        assert futa_wages_for_period(entity_ref("urn:...#E1"), 2026, 1, 10000 USD) { id "f1"; origin case_input; }
        assert futa_prior_unpaid_for_year(entity_ref("urn:...#E1"), 2026, 1, 0 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(futa_period_tax_due(entity_ref("urn:...#E1"), 2026, 1));
    expect truth_status == NEITHER;
}
