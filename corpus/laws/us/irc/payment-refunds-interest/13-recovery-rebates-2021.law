// 26 U.S.C. §6428B — 2021 recovery rebates (American Rescue Plan Act of
// 2021, sec. 9601). Stage 2. Chapter 65, Subchapter B.
//
// JUDGMENT CALLS AND GAPS
//  - The 2021 rebate amount is $1,400 ($2,800 joint) + $1,400 per dependent
//    (every dependent, not only qualifying children); amounts and phase-out
//    thresholds and ranges are A3 datasets (`recovery-rebate-6428b-*.lawparam.json`)
//    valid from enactment; the "first taxable year beginning in 2021" gate
//    is a condition on the year.
//  - The phase-out is a PROPORTION OF THE CREDIT: credit x (AGI - threshold)
//    / range, with the exact-fraction form `div_round(credit * (excess /
//    1.00 USD), range / 1.00 USD, 2, "HALF_UP")` (never a rounded share).
//    The statute names no rounding: cents HALF_UP (JUDGMENT CALL).
//  - It reuses the vocabulary of 12-recovery-rebates-2020.law for the
//    taxpayer (`rebate_taxpayer`, identification-number facts, armed forces
//    spouse). Dependents come with their own identification facts (SSN
//    issued on or before the return due date, or adoption number).
//  - The advance refund amount (g) is the same computation over the basis
//    year (2019, or 2020 when a 2020 return has been filed at the time of
//    the determination); the additional payment of (g)(5)(B) is the excess
//    of the amount determined on the additional payment determination date
//    over payments already made; that date is the earlier of 90 days after
//    the 2020 calendar-year filing deadline (§6072(a), after any §7508A
//    disregard: a case fact of the `administration` owner) and 2021-09-01.
//  - (g)(2)(B) deceased individuals: the identification number of a person
//    deceased before 2021 is treated as not included (except the military
//    rule of (e)(2)(E)), and dependents are excluded when both taxpayers are
//    deceased; the one-spouse-deceased armed forces rule of (ii) treats one
//    spouse's number as included.
//  - "A return of tax shall not be treated as filed until processed" ((g)(7))
//    is a rule on the filing date.

language "law.core" version "0.2";
package us.irc.payment_refunds_interest version "0.1.1";
namespace "urn:us:irc:payment_refunds_interest:clir";

use self::{
    IRC_S6428B_A,
    IRC_S6428B_B,
    IRC_S6428B_C,
    IRC_S6428B_D,
    IRC_S6428B_E,
    IRC_S6428B_F,
    IRC_S6428B_G,
    IRC_S6428B_I,
    Person,
    RebateFilingStatus,
    Secretary,
    TaxableYear,
    armed_forces_spouse_on_joint_return,
    estate_or_trust_taxpayer,
    joint_return_identification_numbers_included,
    nonresident_alien_individual,
    own_valid_identification_number_included,
    own_valid_identification_number_omitted,
    rebate_taxpayer,
};

relation dependent_of_taxpayer(p: Person, y: TaxableYear, dep: Person) kind empirical {
    label en official "a dependent of the taxpayer for the taxable year (section 152) — dependency contract: `gross-income`";
}
relation dependent_number_included(dep: Person, y: TaxableYear) kind empirical {
    label en official "the valid identification number of such dependent is included on the return of tax for the taxable year: a social security number issued on or before the return due date, or the adoption taxpayer identification number of a dependent adopted or placed for adoption";
}
relation individual_deceased_before_2021(p: Person) kind empirical { label en official "any individual who was deceased before January 1, 2021"; }
relation deceased_spouses_before_2021(p: Person, y: TaxableYear, k: Integer) kind empirical { label en official "the number of spouses on the joint return deceased before January 1, 2021"; }
relation deceased_armed_forces_spouse_number_included(p: Person, y: TaxableYear) kind empirical { label en official "only 1 spouse is deceased before January 1, 2021, that spouse was a member of the Armed Forces at any time during the taxable year, and that spouse's valid identification number is included on the return"; }
relation number_available_to_secretary_under_g6(p: Person, y: TaxableYear) kind empirical { label en official "a valid identification number is available to the Secretary as described in subsection (g)(6) (payment determined on information available to the Secretary)"; }

// (c): eligible individual.
relation eligible_individual_6428B(p: Person, y: TaxableYear) kind institutional { label en official "any individual other than a nonresident alien, a dependent of another taxpayer, or an estate or trust"; }
relation dependent_of_another_taxpayer_6428B(p: Person, y: TaxableYear) kind empirical { label en official "an individual who is a dependent of another taxpayer for a taxable year beginning in the calendar year in which the individual's taxable year begins"; }
@source(IRC_S6428B_C, relation = formalizes, coverage = exact, quote = "the term \"eligible individual\" means any individual other than—")
rule S6428BEligibleIndividual strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and not_known(nonresident_alien_individual(p)) and not_known(dependent_of_another_taxpayer_6428B(p, y)) and not_known(estate_or_trust_taxpayer(p));
    then eligible_individual_6428B(p, y);
}

// (e)(2): identification-number rules — effective numbers after the deceased rules and (g)(6).
relation effective_own_number_included_6428B(p: Person, y: TaxableYear) kind institutional { label en official "the taxpayer's valid identification number is included (or available under (g)(6)), and the taxpayer was not deceased before 2021"; }
rule S6428BOwnNumberIncluded strict { for p: Person; for y: TaxableYear; when own_valid_identification_number_included(p, y) and not_known(individual_deceased_before_2021(p)); then effective_own_number_included_6428B(p, y); }
@source(IRC_S6428B_E, relation = formalizes, coverage = exact, quote = "In the case of any payment determined pursuant to subsection (g)(6), a valid identification number shall be treated for purposes of this paragraph as included on the taxpayer's return of tax if such valid identification number is available to the Secretary as described in such subsection.")
rule S6428BOwnNumberAvailableUnderG6 strict { for p: Person; for y: TaxableYear; when number_available_to_secretary_under_g6(p, y); then effective_own_number_included_6428B(p, y); }
relation effective_own_number_omitted_6428B(p: Person, y: TaxableYear) kind institutional { label en official "the taxpayer's valid identification number is not included, or the taxpayer was deceased before 2021 (treated as not included)"; }
rule S6428BOwnNumberOmitted strict { for p: Person; for y: TaxableYear; when own_valid_identification_number_omitted(p, y); then effective_own_number_omitted_6428B(p, y); }
rule S6428BOwnNumberOmittedDeceased strict { for p: Person; for y: TaxableYear; for status: RebateFilingStatus; for agi: Money; when rebate_taxpayer(p, y, status, agi) and individual_deceased_before_2021(p); then effective_own_number_omitted_6428B(p, y); }
relation effective_joint_numbers_6428B(p: Person, y: TaxableYear, n: Integer) kind institutional { label en official "the number of spouses whose valid identification number counts on the joint return"; }
rule S6428BJointNumbersAdjustedForDeceased strict {
    for p: Person;
    for y: TaxableYear;
    for raw: Integer;
    for k: Integer;
    when joint_return_identification_numbers_included(p, y, raw) and deceased_spouses_before_2021(p, y, k) and not_known(deceased_armed_forces_spouse_number_included(p, y));
    then effective_joint_numbers_6428B(p, y, max(0, raw - k));
}
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "the valid identification number of 1 (and only 1) spouse shall be treated as included on the return of tax for the taxable year")
rule S6428BJointNumbersDeceasedArmedForcesSpouse strict {
    for p: Person;
    for y: TaxableYear;
    for raw: Integer;
    when joint_return_identification_numbers_included(p, y, raw) and deceased_armed_forces_spouse_number_included(p, y);
    then effective_joint_numbers_6428B(p, y, max(1, raw));
}
rule S6428BJointNumbersUnadjusted strict {
    for p: Person;
    for y: TaxableYear;
    for raw: Integer;
    when joint_return_identification_numbers_included(p, y, raw) and not_known(deceased_spouses_before_2021(p, y, 1)) and not_known(deceased_spouses_before_2021(p, y, 2)) and not_known(deceased_armed_forces_spouse_number_included(p, y));
    then effective_joint_numbers_6428B(p, y, raw);
}
relation basic_amount_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the $1,400 ($2,800 joint) amount of subsection (b)(1) after the identification-number rules of subsection (e)(2)"; }
@source(IRC_S6428B_E, relation = formalizes, coverage = exact, quote = "In the case of a return other than a joint return, the $1,400 amount in subsection (b)(1) shall be treated as being zero unless the taxpayer includes the valid identification number of the taxpayer on the return of tax for the taxable year.")
rule S6428BBasicAmountNonJointWithNumber strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and effective_own_number_included_6428B(p, y);
    then basic_amount_6428B(p, y, RecoveryRebate6428BBasicAmount);
}
rule S6428BBasicAmountNonJointWithoutNumber strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and effective_own_number_omitted_6428B(p, y);
    then basic_amount_6428B(p, y, 0 USD);
}
@source(IRC_S6428B_E, relation = formalizes, coverage = exact, quote = "In the case of a joint return, the $2,800 amount in subsection (b)(1) shall be treated as being—")
rule S6428BBasicAmountJointBoth strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428B(p, y, 2);
    then basic_amount_6428B(p, y, RecoveryRebate6428BJointAmount);
}
rule S6428BBasicAmountJointOne strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428B(p, y, 1) and not_known(armed_forces_spouse_on_joint_return(p, y));
    then basic_amount_6428B(p, y, RecoveryRebate6428BBasicAmount);
}
@source(IRC_S6428B_E, relation = formalizes, coverage = exact, quote = "Subparagraph (B) shall not apply in the case where at least 1 spouse was a member of the Armed Forces of the United States at any time during the taxable year and the valid identification number of at least 1 spouse is included on the return of tax for the taxable year.")
rule S6428BBasicAmountJointOneArmedForces strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428B(p, y, 1) and armed_forces_spouse_on_joint_return(p, y);
    then basic_amount_6428B(p, y, RecoveryRebate6428BJointAmount);
}
rule S6428BBasicAmountJointNone strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and effective_joint_numbers_6428B(p, y, 0);
    then basic_amount_6428B(p, y, 0 USD);
}
// (b)(2): $1,400 per dependent whose number is included; none if both taxpayers deceased.
relation dependents_excluded_by_death_6428B(p: Person, y: TaxableYear) kind institutional { label en official "no amount is determined with respect to any dependent if the taxpayer (both spouses on a joint return) was deceased before January 1, 2021"; }
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "no amount shall be determined under subsection (e)(2) with respect to any dependent of the taxpayer if the taxpayer (both spouses in the case of a joint return) was deceased before January 1, 2021.")
rule S6428BDependentsExcludedTaxpayerDeceased strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and (status == SurvivingSpouse or status == HeadOfHousehold or status == OtherStatus) and individual_deceased_before_2021(p);
    then dependents_excluded_by_death_6428B(p, y);
}
rule S6428BDependentsExcludedBothSpousesDeceased strict {
    for p: Person;
    for y: TaxableYear;
    for agi: Money;
    when rebate_taxpayer(p, y, JointReturn, agi) and deceased_spouses_before_2021(p, y, 2);
    then dependents_excluded_by_death_6428B(p, y);
}
relation dependents_amount_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "$1,400 multiplied by the number of dependents of the taxpayer whose valid identification number is included"; }
@source(IRC_S6428B_E, relation = formalizes, coverage = exact, quote = "A dependent shall not be taken into account under subsection (b)(2) unless the valid identification number of such dependent is included on the return of tax for the taxable year.")
rule S6428BDependentsAmount strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    when rebate_taxpayer(p, y, status, agi) and not_known(dependents_excluded_by_death_6428B(p, y));
    then dependents_amount_6428B(p, y, RecoveryRebate6428BDependentAmount * (count all dep: Person where dependent_of_taxpayer(p, y, dep) and dependent_number_included(dep, y)));
}
rule S6428BDependentsAmountZeroWhenExcluded strict {
    for p: Person;
    for y: TaxableYear;
    when dependents_excluded_by_death_6428B(p, y);
    then dependents_amount_6428B(p, y, 0 USD);
}
relation rebate_amount_2021_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the 2021 rebate amount: the sum of the basic amount and the dependents amount"; }
@source(IRC_S6428B_B, relation = formalizes, coverage = exact, quote = "the term \"2021 rebate amount\" means, with respect to any taxpayer for any taxable year, the sum of—")
rule S6428BRebateAmount strict {
    for p: Person;
    for y: TaxableYear;
    for basic: Money;
    for deps: Money;
    when basic_amount_6428B(p, y, basic) and dependents_amount_6428B(p, y, deps);
    then rebate_amount_2021_6428B(p, y, basic + deps);
}
// (d): phase-out as a proportion of the credit.
relation phaseout_threshold_and_range_6428B(p: Person, y: TaxableYear, threshold: Money, range: Money) kind institutional { label en official "$75,000 and $5,000; $150,000 and $10,000 for a joint return or surviving spouse; $112,500 and $7,500 for a head of household"; }
@source(IRC_S6428B_D, relation = formalizes, coverage = exact, quote = "In the case of a joint return or a surviving spouse (as defined in section 2(a)), paragraph (1) shall be applied by substituting \"$150,000\" for \"$75,000\" and \"$10,000\" for \"$5,000\".")
rule S6428BThresholdJoint strict { for p: Person; for y: TaxableYear; for agi: Money; when rebate_taxpayer(p, y, JointReturn, agi); then phaseout_threshold_and_range_6428B(p, y, RecoveryRebate6428BThresholdJoint, RecoveryRebate6428BRangeJoint); }
rule S6428BThresholdSurvivingSpouse strict { for p: Person; for y: TaxableYear; for agi: Money; when rebate_taxpayer(p, y, SurvivingSpouse, agi); then phaseout_threshold_and_range_6428B(p, y, RecoveryRebate6428BThresholdJoint, RecoveryRebate6428BRangeJoint); }
@source(IRC_S6428B_D, relation = formalizes, coverage = exact, quote = "In the case of a head of household (as defined in section 2(b)), paragraph (1) shall be applied by substituting \"$112,500\" for \"$75,000\" and \"$7,500\" for \"$5,000\".")
rule S6428BThresholdHeadOfHousehold strict { for p: Person; for y: TaxableYear; for agi: Money; when rebate_taxpayer(p, y, HeadOfHousehold, agi); then phaseout_threshold_and_range_6428B(p, y, RecoveryRebate6428BThresholdHeadOfHousehold, RecoveryRebate6428BRangeHeadOfHousehold); }
rule S6428BThresholdOther strict { for p: Person; for y: TaxableYear; for agi: Money; when rebate_taxpayer(p, y, OtherStatus, agi); then phaseout_threshold_and_range_6428B(p, y, RecoveryRebate6428BThresholdOther, RecoveryRebate6428BRangeOther); }
relation phaseout_reduction_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the amount which bears the same ratio to the credit as the excess of AGI over the threshold bears to the range"; }
@source(IRC_S6428B_D, relation = formalizes, coverage = exact, quote = "shall be reduced (but not below zero) by the amount which bears the same ratio to such credit (as so determined) as—")
rule S6428BPhaseoutReduction strict {
    for p: Person;
    for y: TaxableYear;
    for status: RebateFilingStatus;
    for agi: Money;
    for threshold: Money;
    for range: Money;
    for credit: Money;
    when rebate_taxpayer(p, y, status, agi) and phaseout_threshold_and_range_6428B(p, y, threshold, range) and rebate_amount_2021_6428B(p, y, credit);
    then phaseout_reduction_6428B(p, y, min(credit, div_round(credit * (max(0 USD, agi - threshold) / 1.00 USD), range / 1.00 USD, 2, "HALF_UP")));
}
pub relation credit_before_advance_refund_reduction_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the 2021 rebate amount reduced (but not below zero) by the phase-out, before the reduction of subsection (f)"; }
rule S6428BCreditAfterPhaseout strict {
    for p: Person;
    for y: TaxableYear;
    for credit: Money;
    for reduction: Money;
    when rebate_amount_2021_6428B(p, y, credit) and phaseout_reduction_6428B(p, y, reduction) and eligible_individual_6428B(p, y);
    then credit_before_advance_refund_reduction_6428B(p, y, max(0 USD, credit - reduction));
}
// (f): reduction by advance refunds paid to the taxpayer or any dependent.
relation advance_refund_2021_paid_single_return(p: Person, amount: Money) kind empirical { label en official "a refund or credit made or allowed to the taxpayer under subsection (g) with respect to a return other than a joint return"; }
relation advance_refund_2021_paid_joint_return(p: Person, amount: Money) kind empirical { label en official "a refund or credit made or allowed under subsection (g) with respect to a joint return (half is treated as made to each individual filing the return)"; }
relation advance_refund_2021_paid_to_dependent(p: Person, dep: Person, amount: Money) kind empirical { label en official "a refund or credit made or allowed to a dependent of the taxpayer under subsection (g)"; }
relation advance_refund_reduction_6428B(p: Person, amount: Money) kind institutional { label en official "the aggregate refunds and credits made or allowed to the taxpayer (or any dependent of the taxpayer) under subsection (g)"; }
relation advance_refund_owner_6428B(p: Person) kind institutional { label en unofficial "helper: a credit is computed for the individual"; }
rule S6428BAdvanceRefundOwner strict { for p: Person; for y: TaxableYear; for amt: Money; when credit_before_advance_refund_reduction_6428B(p, y, amt); then advance_refund_owner_6428B(p); }
@source(IRC_S6428B_F, relation = formalizes, coverage = exact, quote = "shall be reduced (but not below zero) by the aggregate refunds and credits made or allowed to the taxpayer (or, except as otherwise provided by the Secretary, any dependent of the taxpayer) under subsection (g).")
rule S6428BAdvanceRefundReduction strict {
    for p: Person;
    when advance_refund_owner_6428B(p);
    then advance_refund_reduction_6428B(p, (sum all a: Money for q: Person where advance_refund_2021_paid_single_return(q, a) and q == p) + (sum all b: Money for r: Person where advance_refund_2021_paid_joint_return(r, b) and r == p) * 0.5 + (sum all c: Money for d: Person where advance_refund_2021_paid_to_dependent(p, d, c)));
}
pub relation allowed_credit_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the credit allowed for the first taxable year beginning in 2021 after the reduction for advance refunds"; }
@source(IRC_S6428B_A, relation = formalizes, coverage = exact, quote = "there shall be allowed as a credit against the tax imposed by subtitle A for the first taxable year beginning in 2021 an amount equal to the 2021 rebate amount determined for such taxable year.")
rule S6428BAllowedCredit strict {
    for p: Person;
    for y: TaxableYear;
    for before: Money;
    for reduction: Money;
    for b: Date;
    when credit_before_advance_refund_reduction_6428B(p, y, before) and advance_refund_reduction_6428B(p, reduction) and us.irc.core::begins(y, b) and b >= @2021-01-01 and b <= @2021-12-31;
    then allowed_credit_6428B(p, y, max(0 USD, before - reduction));
}
relation credit_claimed_without_reduction_6428B(p: Person, y: TaxableYear, claimed: Money) kind empirical;
relation failure_to_reduce_is_math_or_clerical_error_6428B(p: Person, y: TaxableYear) kind institutional { label en official "any failure to so reduce the credit shall be treated as arising out of a mathematical or clerical error and assessed according to section 6213(b)(1)"; }
@source(IRC_S6428B_F, relation = formalizes, coverage = exact, quote = "Any failure to so reduce the credit shall be treated as arising out of a mathematical or clerical error and assessed according to section 6213(b)(1).")
rule S6428BFailureToReduceIsMathError strict {
    for p: Person;
    for y: TaxableYear;
    for claimed: Money;
    for allowed: Money;
    when credit_claimed_without_reduction_6428B(p, y, claimed) and allowed_credit_6428B(p, y, allowed) and claimed > allowed;
    then failure_to_reduce_is_math_or_clerical_error_6428B(p, y);
}
relation valid_number_omission_is_math_or_clerical_error_6428B(p: Person, y: TaxableYear) kind institutional { label en official "any omission of a correct valid identification number required under paragraph (2) is a mathematical or clerical error for purposes of section 6213(g)(2)"; }
@source(IRC_S6428B_E, relation = formalizes, coverage = exact, quote = "Any omission of a correct valid identification number required under this paragraph shall be treated as a mathematical or clerical error for purposes of applying section 6213(g)(2) to such omission.")
rule S6428BNumberOmissionIsMathError strict { for p: Person; for y: TaxableYear; when own_valid_identification_number_omitted(p, y); then valid_number_omission_is_math_or_clerical_error_6428B(p, y); }
relation credit_treated_as_subpart_C_credit_6428B(p: Person, y: TaxableYear) kind institutional { label en official "the credit allowed by subsection (a) shall be treated as allowed by subpart C of part IV of subchapter A of chapter 1"; }
@source(IRC_S6428B_E, relation = formalizes, coverage = exact, quote = "The credit allowed by subsection (a) shall be treated as allowed by subpart C of part IV of subchapter A of chapter 1.")
rule S6428BCreditIsSubpartCCredit strict { for p: Person; for y: TaxableYear; for amt: Money; when allowed_credit_6428B(p, y, amt); then credit_treated_as_subpart_C_credit_6428B(p, y); }

// (g): advance refunds and credits.
relation no_2019_return_but_2020_return_filed_6428B(p: Person) kind empirical { label en official "at the time of any determination made pursuant to paragraph (3), the individual has filed a return of tax for the individual's first taxable year beginning in 2020"; }
relation advance_refund_basis_year_6428B(p: Person, y: TaxableYear) kind institutional { label en official "the first taxable year beginning in 2019, or in 2020 if a 2020 return has been filed at the time of the determination"; }
@source(IRC_S6428B_G, relation = formalizes, coverage = partial, quote = "each individual who was an eligible individual for such individual's first taxable year beginning in 2019 shall be treated as having made a payment against the tax imposed by chapter 1 for such taxable year in an amount equal to the advance refund amount for such taxable year.")
rule S6428BBasisYear2019 defeasible {
    for p: Person;
    for y: TaxableYear;
    for b: Date;
    when eligible_individual_6428B(p, y) and us.irc.core::begins(y, b) and b >= @2019-01-01 and b <= @2019-12-31;
    then advance_refund_basis_year_6428B(p, y);
    unless no_2019_return_but_2020_return_filed_6428B(p) and eligible_individual_6428B(p, y);
}
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "If, at the time of any determination made pursuant to paragraph (3), the individual referred to in paragraph (1) has filed a return of tax for the individual's first taxable year beginning in 2020, paragraph (1) shall be applied with respect to such individual by substituting \"2020\" for \"2019\".")
rule S6428BBasisYear2020WhenFiled strict {
    for p: Person;
    for y: TaxableYear;
    for b: Date;
    when eligible_individual_6428B(p, y) and no_2019_return_but_2020_return_filed_6428B(p) and us.irc.core::begins(y, b) and b >= @2020-01-01 and b <= @2020-12-31;
    then advance_refund_basis_year_6428B(p, y);
}
pub relation advance_refund_amount_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the amount that would have been allowed as a credit under this section for the basis year if this section (other than subsection (f) and this subsection) had applied to that year"; }
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the advance refund amount is the amount that would have been allowed as a credit under this section for such taxable year if this section (other than subsection (f) and this subsection) had applied to such taxable year.")
rule S6428BAdvanceRefundAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_basis_year_6428B(p, y) and credit_before_advance_refund_reduction_6428B(p, y, amt);
    then advance_refund_amount_6428B(p, y, amt);
}
pub relation advance_refund_treated_as_payment_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the individual is treated as having made a payment against the tax imposed by chapter 1 equal to the advance refund amount"; }
rule S6428BAdvanceRefundTreatedAsPayment defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_amount_6428B(p, y, amt);
    then advance_refund_treated_as_payment_6428B(p, y, amt);
}
relation advance_refund_paid_on_6428B(p: Person, y: TaxableYear, d: Date) kind empirical;
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "No refund or credit shall be made or allowed under this subsection after December 31, 2021.")
rule S6428BNoAdvanceRefundAfterDeadline strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    when advance_refund_paid_on_6428B(p, y, d) and d > @2021-12-31;
    then prohibition NoAdvanceRefundAfterDeadline6428B {
        bearer Secretary;
        action advance_refund_paid_on_6428B(p, y, d);
        window [-infinity, infinity];
    };
}
relation advance_refund_made_6428B(p: Person, y: TaxableYear) kind empirical;
@source(IRC_S6428B_G, relation = formalizes, coverage = partial, quote = "refund or credit any overpayment attributable to this subsection as rapidly as possible")
rule S6428BDutyToRefundAdvanceAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when advance_refund_treated_as_payment_6428B(p, y, amt) and amt > 0 USD;
    then duty RefundAdvanceRecoveryRebate6428B {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition advance_refund_made_6428B(p, y);
            window [-infinity, @2021-12-31];
        }
    };
}
relation advance_refund_interest_paid_6428B(p: Person, y: TaxableYear) kind empirical;
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "No interest shall be allowed on any overpayment attributable to this subsection.")
rule S6428BNoInterestOnAdvanceRefund strict {
    for p: Person;
    for y: TaxableYear;
    when advance_refund_interest_paid_6428B(p, y);
    then prohibition NoInterestOnAdvanceRefund6428B {
        bearer Secretary;
        action advance_refund_interest_paid_6428B(p, y);
        window [-infinity, infinity];
    };
}
// (g)(5)(B): the additional payment.
relation calendar_year_2020_filing_deadline(d: Date) kind empirical { label en official "the date specified in section 6072(a) with respect to returns for calendar year 2020, after taking into account any period disregarded under section 7508A if that disregard applies to substantially all such returns — dependency contract: `administration`"; }
relation additional_payment_date_candidate_6428B(d: Date) kind institutional { label en unofficial "a candidate for the additional payment determination date"; }
rule S6428BAdditionalDateCandidateNinetyDays strict { for filing: Date; when calendar_year_2020_filing_deadline(filing); then additional_payment_date_candidate_6428B(add_calendar_period(filing, 90 calendar_day)); }
rule S6428BAdditionalDateCandidateSeptember1 strict { for filing: Date; when calendar_year_2020_filing_deadline(filing); then additional_payment_date_candidate_6428B(@2021-09-01); }
relation earlier_additional_payment_date_exists(d: Date) kind institutional { label en unofficial "helper (TECH-GAPS G136): a strictly earlier candidate exists"; }
rule S6428BEarlierAdditionalDateExists strict { for d: Date; for other: Date; when additional_payment_date_candidate_6428B(d) and additional_payment_date_candidate_6428B(other) and other < d; then earlier_additional_payment_date_exists(d); }
pub relation additional_payment_determination_date_6428B(d: Date) kind institutional { label en official "the earlier of 90 days after the 2020 calendar year filing deadline and September 1, 2021"; }
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "The term \"additional payment determination date\" means the earlier of—")
rule S6428BAdditionalPaymentDeterminationDate strict {
    for d: Date;
    when additional_payment_date_candidate_6428B(d) and not_known(earlier_additional_payment_date_exists(d));
    then additional_payment_determination_date_6428B(d);
}
relation return_2020_filed_on_6428B(p: Person, d: Date) kind empirical { label en official "the date on which the individual's return for the first taxable year beginning in 2020 is filed; a return is not treated as filed until it has been processed by the Internal Revenue Service ((g)(7))"; }
relation return_2020_processed_on_6428B(p: Person, d: Date) kind empirical { label en official "the date the return has been processed by the Internal Revenue Service"; }
relation return_2020_treated_as_filed_on_6428B(p: Person, d: Date) kind institutional { label en official "solely for purposes of this subsection, a return of tax is not treated as filed until it has been processed"; }
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "Solely for purposes of this subsection, a return of tax shall not be treated as filed until such return has been processed by the Internal Revenue Service.")
rule S6428BReturnTreatedFiledWhenProcessed strict {
    for p: Person;
    for d: Date;
    when return_2020_processed_on_6428B(p, d);
    then return_2020_treated_as_filed_on_6428B(p, d);
}
relation additional_payment_owed_6428B(p: Person, y: TaxableYear, amount: Money) kind institutional { label en official "the excess of the amount determined by applying paragraph (1) as of the additional payment determination date over the amount of any payment made under paragraph (1)"; }
relation amount_as_of_additional_payment_date_6428B(p: Person, amount: Money) kind empirical { label en official "the amount which would be determined under paragraph (1) (after the application of subparagraph (A)) by applying paragraph (1) as of the additional payment determination date"; }
relation payment_made_under_g1_6428B(p: Person, amount: Money) kind empirical { label en official "the amount of any payment made with respect to such individual under paragraph (1)"; }
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "the Secretary shall make a payment (in addition to any payment made under paragraph (1)) to such individual equal to the excess (if any) of—")
rule S6428BAdditionalPaymentAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for as_of: Money;
    for paid: Money;
    for filed: Date;
    for determination: Date;
    when return_2020_treated_as_filed_on_6428B(p, filed) and additional_payment_determination_date_6428B(determination) and filed < determination
        and amount_as_of_additional_payment_date_6428B(p, as_of) and payment_made_under_g1_6428B(p, paid) and as_of > paid
        and advance_refund_basis_year_6428B(p, y);
    then additional_payment_owed_6428B(p, y, as_of - paid);
}
relation additional_payment_made_6428B(p: Person) kind empirical;
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "In the case of any individual who files, before the additional payment determination date, a return of tax for such individual's first taxable year beginning in 2020, the Secretary shall make a payment")
rule S6428BDutyToMakeAdditionalPayment defeasible {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when additional_payment_owed_6428B(p, y, amt) and amt > 0 USD;
    then duty MakeAdditionalRecoveryRebatePayment6428B {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition additional_payment_made_6428B(p);
            window [-infinity, @2021-12-31];
        }
    };
}
// (g)(6): no return for 2019 or 2020 — the Secretary determines on available information.
relation no_return_for_2019_or_2020_6428B(p: Person) kind empirical { label en official "at the time of any determination made pursuant to paragraph (3), the individual has filed a tax return for neither the year described in paragraph (1) nor the year described in paragraph (5)(A)"; }
relation secretary_determines_on_available_information_6428B(p: Person) kind empirical;
relation advance_refund_determined_on_available_information_6428B(p: Person) kind institutional;
@source(IRC_S6428B_G, relation = formalizes, coverage = partial, quote = "the Secretary shall, consistent with rules similar to the rules of section 6428A(f)(5)(H)(i), apply paragraph (1) on the basis of information available to the Secretary")
rule S6428BDetermineOnAvailableInformationDuty strict {
    for p: Person;
    when no_return_for_2019_or_2020_6428B(p);
    then power S6428BAvailableInformationPower {
        holder Secretary;
        over p;
        exercise secretary_determines_on_available_information_6428B(p);
        valid_when no_return_for_2019_or_2020_6428B(p);
        effect create(advance_refund_determined_on_available_information_6428B(p));
    };
}
// (g)(8): no increase in the balance of a previously issued prepaid debit card.
relation payment_by_increasing_balance_of_prepaid_debit_card_6428B(p: Person) kind empirical { label en official "payment made by an increase in the balance of a previously issued prepaid debit card"; }
relation card_was_issued_solely_for_6428_or_6428A_payments(p: Person) kind empirical { label en official "as of the time of the issuance of the card, the card was issued solely for purposes of making payments under section 6428 or 6428A"; }
@source(IRC_S6428B_G, relation = formalizes, coverage = exact, quote = "Payments made by the Secretary to individuals under this section shall not be in the form of an increase in the balance of any previously issued prepaid debit card if, as of the time of the issuance of such card, such card was issued solely for purposes of making payments under section 6428 or 6428A.")
rule S6428BNoPaymentByPrepaidCardIncrease strict {
    for p: Person;
    when payment_by_increasing_balance_of_prepaid_debit_card_6428B(p) and card_was_issued_solely_for_6428_or_6428A_payments(p);
    then prohibition NoPrepaidDebitCardIncrease6428B {
        bearer Secretary;
        beneficiary p;
        action payment_by_increasing_balance_of_prepaid_debit_card_6428B(p);
        window [-infinity, infinity];
    };
}
// (i): outreach.
relation outreach_program_carried_out_6428B(p: Person) kind empirical { label en official "the Secretary carries out a robust and comprehensive outreach program to ensure that all taxpayers described in subsection (h)(1) learn of their eligibility for the advance refunds and credits, are advised of the opportunity to receive them, and are provided assistance in applying"; }
relation taxpayer_described_in_h1_6428B(p: Person) kind empirical { label en official "a taxpayer described in subsection (h)(1): one from whom the Secretary lacks information sufficient to make a payment under subsection (g)"; }
@source(IRC_S6428B_I, relation = formalizes, coverage = exact, quote = "The Secretary shall carry out a robust and comprehensive outreach program")
rule S6428BDutyToConductOutreach strict {
    for p: Person;
    when taxpayer_described_in_h1_6428B(p);
    then duty ConductRecoveryRebateOutreach6428B {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition outreach_program_carried_out_6428B(p);
            window [-infinity, infinity];
        }
    };
}
// (g)(3): electronic payment "consistent with a rapid effort to make payments electronically if appropriate" is
// absorbed by the duty above; the §6428A(f)(3)(B)-(C) rules apply by cross-reference (EXTERNAL_DEPENDENCY to the same package: 12-recovery-rebates-2020.law).
