// Section 461 — residual, and Pub. L. 119-21 editions (stage 2c, IRC-07).
// Adds to 07-deduction-timing.law: (b) death; (d)(1) acceleration of tax
// accrual; (e) deposit interest; (f) contested liabilities; (h)(2) time of
// economic performance and (h)(3)(C)/(h)(5); (i) tax-shelter rules; (j)
// excess farm losses; (k) farming syndicate; (l)(1) editions (pinned text and
// Pub. L. 119-21 sec. 70601), (l)(3)(B) capital gains and losses.
// Also the Pub. L. 119-21 editions that touch section 460(e) (sec. 70430) and
// the section 481 coordination of the section 174A transition (sec. 70302(c)).
//
// Not modelled (TECH-GAPS G2111-G2116, coverage/accounting.json): the (d)(2)
// regulations limitation, the (e) Secretary's choice of the year of the
// deferred deduction (an open judgment), the (h)(2)(D) regulations, the
// (i)(2) spudding rule beyond its 90-day test, the (j)(4)(B)(ii) filing-status
// rules, the (k)(2) active-management holdings, and the 2026 taxable-year gap
// between the pinned (l)(1) window and Pub. L. 119-21 sec. 70601(c)(1).

// --- (b): death; (d)(1): acceleration of accrual of taxes ---

use self::{
    IRC_S461_B,
    IRC_S461_D,
    IRC_S461_E,
    IRC_S461_F,
    IRC_S461_H,
    IRC_S461_I,
    IRC_S461_J,
    IRC_S461_K,
    IRC_S461_L,
    Person,
    TaxableYear,
    aggregate_business_deductions_after_469_461l6,
    all_events_test_met_461h,
    business_income_with_entity_shares,
    deduction_or_credit_item,
    economic_performance_occurs_in_year,
    excess_business_loss,
    excess_business_loss_disallowed,
    farm_deductions_with_entity_shares,
    farm_income_with_entity_shares,
    is_construction_contract,
    is_corporation_taxpayer,
    is_home_construction_contract,
    liability_incurred_in_year,
    uses_accrual_method,
};

pub relation deduction_or_credit_accrued_only_by_reason_of_death(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount accrued as a deduction or credit only by reason of the death of the taxpayer, for the period in which the date of death falls (section 461(b))";
}
pub relation accrued_by_reason_of_death_not_allowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount accrued only by reason of death is not allowed in computing taxable income for the period of death (section 461(b))";
}
@source(IRC_S461_B, quote = "shall not be allowed in computing taxable income for the period in which falls the date of the taxpayer's death.")
rule DeathAccrualDeductionNotAllowed(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "for an accrual-method taxpayer, deductions and credits accrued only by reason of death are disallowed for the final period (section 461(b))";
    when uses_accrual_method(p, y);
    when deduction_or_credit_accrued_only_by_reason_of_death(p, y, amount);
    then accrued_by_reason_of_death_not_allowed(p, y, amount);
}
pub relation tax_accrual_date_actual(p: Person, tax_item: Integer, d: Date) kind empirical {
    label en official "the date on which the tax would accrue under the action of the taxing jurisdiction taken after December 31, 1960 (section 461(d)(1))";
}
pub relation tax_accrual_date_but_for_action(p: Person, tax_item: Integer, d: Date) kind empirical {
    label en official "the date on which the tax would have accrued but for the action of the taxing jurisdiction (section 461(d)(1))";
}
pub relation tax_treated_as_accruing_on(p: Person, tax_item: Integer, d: Date) kind institutional {
    label en official "the date the tax is treated as accruing for an accrual-method taxpayer: the earlier-than-but-for date is corrected to the but-for date (section 461(d)(1)); the (d)(2) regulations limitation is an EXTERNAL_DEPENDENCY";
}
@source(IRC_S461_D, quote = "such taxes shall be treated as accruing at the time they would have accrued but for such action by such taxing jurisdiction.")
rule TaxAccrualAccelerationCorrected(p: Person, tax_item: Integer, actual: Date, but_for: Date) defeasible {
    label en official "a tax whose accrual date was accelerated by the jurisdiction's post-1960 action accrues on the but-for date (section 461(d)(1))";
    when tax_accrual_date_actual(p, tax_item, actual);
    when tax_accrual_date_but_for_action(p, tax_item, but_for);
    when actual < but_for;
    then tax_treated_as_accruing_on(p, tax_item, but_for);
}
rule TaxAccrualNotAcceleratedKeepsActualDate(p: Person, tax_item: Integer, actual: Date, but_for: Date) defeasible {
    label en official "a tax not accelerated by the jurisdiction's action accrues on its actual date (section 461(d)(1), converse)";
    when tax_accrual_date_actual(p, tax_item, actual);
    when tax_accrual_date_but_for_action(p, tax_item, but_for);
    when actual >= but_for;
    then tax_treated_as_accruing_on(p, tax_item, actual);
}

// --- (e): dividends or interest on deposits of certain institutions ---

pub relation is_covered_thrift_institution_461e(institution: Person) kind empirical {
    label en official "a mutual savings bank not having capital stock represented by shares, a domestic building and loan association, or a cooperative bank (section 461(e))";
}
pub relation deposit_interest_paid_or_credited(institution: Person, y: TaxableYear, amount: Money, months_covered: Integer) kind empirical {
    label en official "amounts paid or credited to depositors as dividends or interest (withdrawable on demand subject only to customary notice) for a period of the stated number of months (section 461(e))";
}
pub relation deposit_interest_disallowed_for_period_over_12_months(institution: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the deposit interest paid or credited for periods representing more than 12 months, not allowed as a deduction for the taxable year (section 461(e), first sentence)";
}
@source(IRC_S461_E, quote = "shall not be allowed as a deduction for the taxable year to the extent such amounts are paid or credited for periods representing more than 12 months.")
rule DepositInterestBeyondTwelveMonthsDisallowed(institution: Person, y: TaxableYear, amount: Money, n: Integer) defeasible {
    label en official "the share (n-12)/n of the amount, for a period of n > 12 months, is disallowed; one rounding to cents HALF_UP (JUDGMENT CALL: the statute says 'to the extent' without a formula)";
    when is_covered_thrift_institution_461e(institution);
    when deposit_interest_paid_or_credited(institution, y, amount, n);
    when n > 12;
    then deposit_interest_disallowed_for_period_over_12_months(institution, y, div_round(amount * (n - 12), n * 1.0, 2, "HALF_UP"));
}
external judgment relation secretary_determines_year_for_disallowed_deposit_interest(institution: Person, y_disallowed: TaxableYear, y_allowed: TaxableYear) {
    authority Secretary;
    label en official "the Secretary determines the other taxable year for which the disallowed deposit interest is allowed, consistently with the first sentence (section 461(e), second sentence)";
}
pub relation deposit_interest_deduction_allowed_in_other_year(institution: Person, y_allowed: TaxableYear, amount: Money) kind institutional {
    label en official "the disallowed deposit interest is allowed as a deduction for the year the Secretary determines (section 461(e), second sentence)";
}
@source(IRC_S461_E, quote = "Any such amount not allowed as a deduction as the result of the application of the preceding sentence shall be allowed as a deduction for such other taxable year as the Secretary determines")
rule DisallowedDepositInterestAllowedInSecretaryYear(institution: Person, y: TaxableYear, y_allowed: TaxableYear, amount: Money) defeasible {
    label en official "disallowed deposit interest is deductible in the year the Secretary determines (section 461(e))";
    when deposit_interest_disallowed_for_period_over_12_months(institution, y, amount);
    when secretary_determines_year_for_disallowed_deposit_interest(institution, y, y_allowed);
    then deposit_interest_deduction_allowed_in_other_year(institution, y_allowed, amount);
}

// --- (f): contested liabilities ---

pub relation contests_asserted_liability(p: Person, liability: Integer) kind empirical {
    label en official "the taxpayer contests an asserted liability (section 461(f)(1))";
}
pub relation transfer_to_provide_for_satisfaction(p: Person, liability: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer transfers money or other property, in the taxable year, to provide for the satisfaction of the asserted liability (section 461(f)(2))";
}
pub relation contest_exists_after_transfer(p: Person, liability: Integer) kind empirical {
    label en official "the contest of the asserted liability exists after the time of the transfer (section 461(f)(3))";
}
pub relation deduction_would_be_allowed_but_for_contest(p: Person, liability: Integer, y: TaxableYear) kind empirical {
    label en official "but for the fact that the liability is contested, a deduction would be allowed for the taxable year of the transfer (or an earlier year), determined after the application of subsection (h) (section 461(f)(4))";
}
pub relation liability_is_foreign_income_tax(liability: Integer) kind empirical {
    label en official "the asserted liability is for income, war profits, or excess profits taxes imposed by a foreign country or possession of the United States (section 461(f), last sentence)";
}
pub relation contested_liability_deduction_allowed_in_transfer_year(p: Person, liability: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for the contested liability is allowed for the taxable year of the transfer (section 461(f))";
}
@source(IRC_S461_F, quote = "then the deduction shall be allowed for the taxable year of the transfer.")
rule ContestedLiabilityDeductionInTransferYear(p: Person, liability: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "when the four (f) conditions hold, the deduction is allowed for the transfer year; foreign income taxes are excluded (section 461(f))";
    when contests_asserted_liability(p, liability);
    when transfer_to_provide_for_satisfaction(p, liability, y, amount);
    when contest_exists_after_transfer(p, liability);
    when deduction_would_be_allowed_but_for_contest(p, liability, y);
    when not_known(liability_is_foreign_income_tax(liability));
    then contested_liability_deduction_allowed_in_transfer_year(p, liability, y, amount);
}

// --- (h)(2), (h)(3)(C), (h)(5): economic performance ---

pub enum EconomicPerformanceCategory {
    ServicesProvidedToTaxpayer;
    PropertyProvidedToTaxpayer;
    UseOfPropertyByTaxpayer;
    ServicesProvidedByTaxpayer;
    PropertyProvidedByTaxpayer;
    WorkersCompensationOrTortPayment;
    OtherLiability;
    label en official "the liability categories of section 461(h)(2)(A)-(D)";
}
pub relation liability_category_461h2(p: Person, item: Integer, cat: EconomicPerformanceCategory) kind empirical {
    label en official "the category of the liability under section 461(h)(2) (exactly one category per item; workers compensation and tort payments are outside (A) and (B) by (C), last sentence)";
}
pub relation performance_event_in_year(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the event that constitutes economic performance for the item's category occurs in the taxable year: the services or property are provided to the taxpayer, the taxpayer uses the property, the taxpayer provides the property or services, the payment to the other person is made (section 461(h)(2)(A)-(C))";
}
pub relation economic_performance_established_461h(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "economic performance has occurred for the item in the taxable year (section 461(h)(2)), from the category event or the stage 1b case-asserted `economic_performance_occurs_in_year`";
}
@source(IRC_S461_H, quote = "economic performance occurs as such person provides such services,")
rule EconomicPerformanceServicesToTaxpayer(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "services provided to the taxpayer: economic performance occurs as the other person provides them (section 461(h)(2)(A)(i))";
    when liability_category_461h2(p, item, ServicesProvidedToTaxpayer);
    when performance_event_in_year(p, y, item);
    then economic_performance_established_461h(p, y, item);
}
rule EconomicPerformancePropertyToTaxpayer(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "property provided to the taxpayer: economic performance occurs as the other person provides it (section 461(h)(2)(A)(ii))";
    when liability_category_461h2(p, item, PropertyProvidedToTaxpayer);
    when performance_event_in_year(p, y, item);
    then economic_performance_established_461h(p, y, item);
}
rule EconomicPerformanceUseOfProperty(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "use of property by the taxpayer: economic performance occurs as the taxpayer uses it (section 461(h)(2)(A)(iii))";
    when liability_category_461h2(p, item, UseOfPropertyByTaxpayer);
    when performance_event_in_year(p, y, item);
    then economic_performance_established_461h(p, y, item);
}
rule EconomicPerformanceServicesByTaxpayer(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "services the taxpayer must provide: economic performance occurs as the taxpayer provides them (section 461(h)(2)(B))";
    when liability_category_461h2(p, item, ServicesProvidedByTaxpayer);
    when performance_event_in_year(p, y, item);
    then economic_performance_established_461h(p, y, item);
}
rule EconomicPerformancePropertyByTaxpayer(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "property the taxpayer must provide: economic performance occurs as the taxpayer provides it (section 461(h)(2)(B))";
    when liability_category_461h2(p, item, PropertyProvidedByTaxpayer);
    when performance_event_in_year(p, y, item);
    then economic_performance_established_461h(p, y, item);
}
@source(IRC_S461_H, quote = "economic performance occurs as the payments to such person are made.")
rule EconomicPerformanceWorkersCompOrTortPayment(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "workers compensation and tort liabilities: economic performance occurs as the payments are made (section 461(h)(2)(C))";
    when liability_category_461h2(p, item, WorkersCompensationOrTortPayment);
    when performance_event_in_year(p, y, item);
    then economic_performance_established_461h(p, y, item);
}
rule EconomicPerformanceLegacyCaseFact(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "the stage 1b case-asserted economic performance still establishes it (compatibility path); category (D) items rest on regulations and use it";
    when economic_performance_occurs_in_year(p, y, item);
    then economic_performance_established_461h(p, y, item);
}
pub relation deduction_under_reserve_provision(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a deduction for the item is allowable under a provision of the title which specifically provides for a deduction for a reserve for estimated expenses (section 461(h)(5))";
}
@source(IRC_S461_H, quote = "This subsection shall not apply to any item for which a deduction is allowable under a provision of this title which specifically provides for a deduction for a reserve for estimated expenses.")
rule LiabilityIncurredWithoutEconomicPerformanceForReserveItems(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "subsection (h) does not apply to reserve-provision items: the all-events test alone incurs the liability (section 461(h)(5), (h)(1) not applied)";
    when deduction_under_reserve_provision(p, y, item);
    when all_events_test_met_461h(p, y, item);
    then liability_incurred_in_year(p, y, item);
}
pub relation recurring_exception_unavailable_461h3C(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the recurring-item exception of (h)(3) does not apply to workers compensation and tort liabilities (section 461(h)(3)(C))";
}
@source(IRC_S461_H, quote = "This paragraph shall not apply to any item described in subparagraph (C) of paragraph (2).")
rule RecurringExceptionUnavailableForWorkersCompAndTort(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "workers compensation and tort items cannot use the recurring-item exception (section 461(h)(3)(C))";
    when liability_category_461h2(p, item, WorkersCompensationOrTortPayment);
    when us.irc.core::year_of(p, y);
    then recurring_exception_unavailable_461h3C(p, y, item);
}

// --- (i): tax shelters ---

pub relation enterprise_offered_in_registered_offering(p: Person) kind empirical {
    label en official "at any time interests in the enterprise (other than a C corporation) have been offered for sale in an offering required to be registered with a Federal or State securities agency (section 461(i)(3)(A))";
}
pub relation enterprise_is_c_corporation_461i(p: Person) kind empirical {
    label en official "the enterprise is a C corporation (excluded from (i)(3)(A))";
}
pub relation is_syndicate_1256e3B(p: Person) kind empirical {
    label en official "the enterprise is a syndicate within the meaning of section 1256(e)(3)(B) (section 461(i)(3)(B)) — an EXTERNAL_DEPENDENCY on the section 1256 owner";
}
pub relation is_tax_shelter_6662d2Cii(p: Person) kind empirical {
    label en official "the enterprise is a tax shelter as defined in section 6662(d)(2)(C)(ii) (section 461(i)(3)(C)) — an EXTERNAL_DEPENDENCY on the penalties owner";
}
pub relation trade_or_business_of_farming_464e(p: Person) kind empirical {
    label en official "the enterprise is engaged in the trade or business of farming as defined in section 464(e) (section 461(i)(4))";
}
pub relation is_farming_syndicate_461k(p: Person) kind institutional {
    label en official "a farming syndicate (section 461(k)(1)): a non-corporate, non-S-corporation enterprise engaged in farming, with a registered offering, or with more than 35 percent of losses allocable to limited partners or limited entrepreneurs";
}
pub relation share_of_losses_allocable_to_limited_partners_or_entrepreneurs(p: Person, pct: Decimal) kind empirical {
    label en official "the percentage of the enterprise's losses during any period allocable to limited partners or limited entrepreneurs, after the (k)(2) active-management exclusions (section 461(k)(1)(B))";
}
@source(IRC_S461_K, quote = "if at any time interests in such partnership or enterprise have been offered for sale in any offering required to be registered with any Federal or State agency having authority to regulate the offering of securities for sale")
rule FarmingSyndicateByRegisteredOffering(p: Person) defeasible {
    label en official "a non-corporate farming enterprise with a registered offering is a farming syndicate (section 461(k)(1)(A))";
    when trade_or_business_of_farming_464e(p);
    when not_known(enterprise_is_c_corporation_461i(p));
    when enterprise_offered_in_registered_offering(p);
    then is_farming_syndicate_461k(p);
}
@source(IRC_S461_K, quote = "if more than 35 percent of the losses during any period are allocable to limited partners or limited entrepreneurs.")
rule FarmingSyndicateByLossAllocation(p: Person, pct: Decimal) defeasible {
    label en official "a non-corporate farming enterprise with more than 35 percent of losses allocable to limited partners or limited entrepreneurs is a farming syndicate (section 461(k)(1)(B))";
    when trade_or_business_of_farming_464e(p);
    when not_known(enterprise_is_c_corporation_461i(p));
    when share_of_losses_allocable_to_limited_partners_or_entrepreneurs(p, pct);
    when pct > 35.0;
    then is_farming_syndicate_461k(p);
}
pub relation is_tax_shelter_461i3(p: Person) kind institutional {
    label en official "a tax shelter for section 461(i): an enterprise with a registered offering (not a C corporation), a syndicate, or a section 6662(d)(2)(C)(ii) tax shelter; for farming, a farming syndicate replaces (A) and (B) ((i)(4))";
}
@source(IRC_S461_I, quote = "any enterprise (other than a C corporation) if at any time interests in such enterprise have been offered for sale in any offering required to be registered")
rule TaxShelterByRegisteredOffering(p: Person) defeasible {
    label en official "a non-C-corporation enterprise with a registered offering is a tax shelter, unless it is farming, where (k) governs (section 461(i)(3)(A), (i)(4))";
    when enterprise_offered_in_registered_offering(p);
    when not_known(enterprise_is_c_corporation_461i(p));
    when not_known(trade_or_business_of_farming_464e(p));
    then is_tax_shelter_461i3(p);
}
@source(IRC_S461_I, quote = "(B) any syndicate (within the meaning of section 1256(e)(3)(B)), and")
rule TaxShelterBySyndicate(p: Person) defeasible {
    label en official "a syndicate is a tax shelter, unless it is farming, where (k) governs (section 461(i)(3)(B), (i)(4))";
    when is_syndicate_1256e3B(p);
    when not_known(trade_or_business_of_farming_464e(p));
    then is_tax_shelter_461i3(p);
}
rule TaxShelterBySection6662Definition(p: Person) defeasible {
    label en official "a section 6662(d)(2)(C)(ii) tax shelter is a tax shelter (section 461(i)(3)(C))";
    when is_tax_shelter_6662d2Cii(p);
    then is_tax_shelter_461i3(p);
}
@source(IRC_S461_I, quote = "the definition of farming syndicate in subsection (k) shall be substituted for subparagraphs (A) and (B) of paragraph (3).")
rule TaxShelterFarmingSyndicateSubstitution(p: Person) defeasible {
    label en official "in farming, a farming syndicate is the tax shelter test in place of (3)(A) and (B) (section 461(i)(4))";
    when is_farming_syndicate_461k(p);
    then is_tax_shelter_461i3(p);
}
pub relation tax_shelter_recurring_exception_disregarded(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "for a tax shelter, economic performance is determined without regard to the recurring-item exception of (h)(3) (section 461(i)(1))";
}
@source(IRC_S461_I, quote = "In the case of a tax shelter, economic performance shall be determined without regard to paragraph (3) of subsection (h).")
rule TaxShelterNoRecurringItemException(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "a tax shelter cannot use the recurring-item exception (section 461(i)(1))";
    when is_tax_shelter_461i3(p);
    when us.irc.core::year_of(p, y);
    when deduction_or_credit_item(p, y, item, _);
    then tax_shelter_recurring_exception_disregarded(p, y, item);
}
pub relation oil_gas_well_drilling_amount_paid(p: Person, y: TaxableYear, well: Integer, amount: Money) kind empirical {
    label en official "an amount paid during the taxable year for drilling an oil or gas well (section 461(i)(2)(A))";
}
pub relation drilling_commences_on(well: Integer, d: Date) kind empirical {
    label en official "the date drilling of the well commences (section 461(i)(2)(A))";
}
pub relation tax_shelter_drilling_economic_performance_in_year(p: Person, y: TaxableYear, well: Integer) kind institutional {
    label en official "for a tax shelter, economic performance for amounts paid for drilling is treated as occurring in the year if drilling commences before the close of the 90th day after the close of the taxable year (section 461(i)(2)(A))";
}
@source(IRC_S461_I, quote = "shall be treated as having occurred within a taxable year if drilling of the well commences before the close of the 90th day after the close of the taxable year.")
rule TaxShelterSpuddingRule(p: Person, y: TaxableYear, well: Integer, amount: Money, year_end: Date, spud: Date) defeasible {
    label en official "a tax-shelter drilling payment counts as economically performed in the year if the well is spudded within 90 days after year end (section 461(i)(2)(A)); the 90-day span is an exact calendar-day count";
    when is_tax_shelter_461i3(p);
    when oil_gas_well_drilling_amount_paid(p, y, well, amount);
    when us.irc.core::ends(y, year_end);
    when drilling_commences_on(well, spud);
    when spud < add_calendar_period(year_end, 91 calendar_day);
    then tax_shelter_drilling_economic_performance_in_year(p, y, well);
}

// --- (j): excess farm losses ---

pub relation is_applicable_subsidy_received(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer receives an applicable subsidy for the taxable year: a direct or counter-cyclical payment under title I of the Food, Conservation, and Energy Act of 2008 (or a payment elected in lieu), or a Commodity Credit Corporation loan (section 461(j)(1), (j)(3))";
}
pub relation aggregate_farm_deductions_461j(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate deductions attributable to the taxpayer's farming businesses for the year, whether or not disallowed under (j)(1) (section 461(j)(4)(A)(i))";
}
pub relation farm_casualty_disease_drought_losses(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "deductions for losses arising by reason of fire, storm, or other casualty, or disease or drought, involving a farming business (section 461(j)(4)(D))";
}
pub relation aggregate_farm_gross_income_461j(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate gross income or gain attributable to the taxpayer's farming businesses for the year (section 461(j)(4)(A)(ii)(I)); farming includes processing of the commodity (section 461(j)(4)(C)(ii))";
}
pub relation prior_five_year_farm_gross_income(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate (A)(ii)(I) amounts for the 5 consecutive taxable years preceding the taxable year (section 461(j)(4)(B)(i)(II))";
}
pub relation prior_five_year_farm_deductions(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate (A)(i) amounts for the 5 consecutive taxable years preceding the taxable year (section 461(j)(4)(B)(i)(II)); carried-forward losses count in the first year they are not disallowed ((B)(ii)(I))";
}
pub relation married_filing_separately_461j(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer is a married individual filing separately (section 461(j)(4)(B)(i)(I))";
}
pub relation farm_loss_threshold_base(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the (B)(i)(I) amount: $300,000, or $150,000 for married individuals filing separately";
}
rule FarmLossThresholdBaseOrdinary(p: Person, y: TaxableYear) defeasible {
    label en official "the base threshold is $300,000 (section 461(j)(4)(B)(i)(I))";
    when us.irc.core::year_of(p, y);
    when not_known(married_filing_separately_461j(p, y));
    then farm_loss_threshold_base(p, y, round(ExcessFarmLossThresholdBase, 2, "HALF_UP"));
}
rule FarmLossThresholdBaseMarriedSeparate(p: Person, y: TaxableYear) defeasible {
    label en official "married individuals filing separately use $150,000 (section 461(j)(4)(B)(i)(I))";
    when married_filing_separately_461j(p, y);
    then farm_loss_threshold_base(p, y, round(ExcessFarmLossThresholdBaseMarriedSeparate, 2, "HALF_UP"));
}
pub relation farm_loss_threshold_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the threshold amount: the greater of the base amount and the excess of prior five years' farm gross income over farm deductions (section 461(j)(4)(B)(i))";
}
@source(IRC_S461_J, quote = "The term \"threshold amount\" means, with respect to any taxable year, the greater of—")
rule FarmLossThresholdAmountComputation(p: Person, y: TaxableYear, base: Money, income: Money, ded: Money) defeasible {
    label en official "threshold = max(base, prior-five-year gross income - deductions) (section 461(j)(4)(B)(i))";
    when farm_loss_threshold_base(p, y, base);
    when prior_five_year_farm_gross_income(p, y, income);
    when prior_five_year_farm_deductions(p, y, ded);
    then farm_loss_threshold_amount(p, y, max(base, round(income - ded, 2, "HALF_UP")));
}
pub relation excess_farm_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of aggregate farm deductions (less casualty, disease, and drought losses) over farm gross income plus the threshold amount (section 461(j)(4)(A), (D))";
}
@source(IRC_S461_J, quote = "The term \"excess farm loss\" means the excess of—")
rule ExcessFarmLossComputation(p: Person, y: TaxableYear, ded: Money, casualty: Money, income: Money, threshold: Money) defeasible {
    label en official "excess farm loss = deductions net of casualty/drought losses minus (gross income + threshold), not below zero (section 461(j)(4))";
    when farm_deductions_with_entity_shares(p, y, ded);
    when farm_casualty_disease_drought_losses(p, y, casualty);
    when farm_income_with_entity_shares(p, y, income);
    when farm_loss_threshold_amount(p, y, threshold);
    then excess_farm_loss(p, y, max(0.00 USD, round(ded - casualty - (income + threshold), 2, "HALF_UP")));
}
pub relation farm_loss_limitation_suspended_461l1A(p: Person, y: TaxableYear) kind institutional {
    label en official "subsection (j) does not apply for the taxable year (section 461(l)(1)(A): pinned text, taxable years beginning after 2017-12-31 and before 2026-01-01; Pub. L. 119-21 sec. 70601(a), (c)(1): permanent for years beginning after 2026-12-31)";
}
@source(IRC_S461_L, quote = "for any taxable year beginning after December 31, 2017, and before January 1, 2026, subsection (j) (relating to limitation on excess farm losses of certain taxpayers) shall not apply")
rule FarmLossLimitationSuspendedPinnedWindow(p: Person, y: TaxableYear, begins_on: Date) defeasible {
    label en official "(j) is suspended for taxable years beginning in 2018-2025 (section 461(l)(1)(A), pinned 2024 text)";
    when us.irc.core::year_of(p, y);
    when not_known(is_corporation_taxpayer(p));
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2017-12-31;
    when begins_on < @2026-01-01;
    then farm_loss_limitation_suspended_461l1A(p, y);
}
@source(us.irc.temporal::PL119_21_S70601, quote = "Section 461(l)(1) is amended by striking “and before January 1, 2029,” each place it appears.")
rule FarmLossLimitationSuspendedPermanentPL119_21(p: Person, y: TaxableYear, begins_on: Date) defeasible {
    effective [@2025-07-04, infinity);
    label en official "after Pub. L. 119-21 sec. 70601(a), the (j) suspension has no end date; it applies to taxable years beginning after 2026-12-31 (sec. 70601(c)(1)); years beginning in 2026 fall in a gap between the pinned window and this edition (TECH-GAPS G2116)";
    when us.irc.core::year_of(p, y);
    when not_known(is_corporation_taxpayer(p));
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2026-12-31;
    then farm_loss_limitation_suspended_461l1A(p, y);
}
pub relation excess_farm_loss_disallowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess farm loss of a non-C-corporation taxpayer receiving an applicable subsidy is not allowed for the taxable year (section 461(j)(1))";
}
@source(IRC_S461_J, quote = "If a taxpayer other than a C corporation receives any applicable subsidy for any taxable year, any excess farm loss of the taxpayer for the taxable year shall not be allowed.")
rule ExcessFarmLossDisallowed(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "an excess farm loss is disallowed for a non-C-corporation taxpayer that receives an applicable subsidy, unless (l)(1)(A) suspends (j) (section 461(j)(1))";
    when not_known(is_corporation_taxpayer(p));
    when is_applicable_subsidy_received(p, y);
    when excess_farm_loss(p, y, amount);
    when amount > 0.00 USD;
    when not_known(farm_loss_limitation_suspended_461l1A(p, y));
    then excess_farm_loss_disallowed(p, y, amount);
}
pub relation excess_farm_loss_carried_as_farm_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the disallowed excess farm loss is treated as a deduction attributable to farming businesses in the next taxable year (section 461(j)(2))";
}
@source(IRC_S461_J, quote = "Any loss which is disallowed under paragraph (1) shall be treated as a deduction of the taxpayer attributable to farming businesses in the next taxable year.")
rule ExcessFarmLossCarryoverToNextYear(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the disallowed excess farm loss carries forward as a farming deduction (section 461(j)(2))";
    when excess_farm_loss_disallowed(p, y, amount);
    then excess_farm_loss_carried_as_farm_deduction(p, y, amount);
}

// --- (l)(1): Pub. L. 119-21 edition of the excess business loss limitation ---

@source(us.irc.temporal::PL119_21_S70601, quote = "Section 461(l)(1) is amended by striking “and before January 1, 2029,” each place it appears.")
rule ExcessBusinessLossDisallowedPermanentPL119_21(p: Person, y: TaxableYear, amount: Money, begins_on: Date) defeasible {
    effective [@2025-07-04, infinity);
    label en official "after Pub. L. 119-21 sec. 70601(a), an excess business loss of a non-corporate taxpayer is disallowed for taxable years beginning after 2026-12-31 with no end date (sec. 70601(c)(1)); the 2026 gap is TECH-GAPS G2116";
    when not is_corporation_taxpayer(p);
    when excess_business_loss(p, y, amount);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2026-12-31;
    then excess_business_loss_disallowed(p, y, amount);
}
// (l)(3)(B): capital gains and losses in the excess business loss.
pub relation capital_loss_deductions_461l3B(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "deductions for losses from sales or exchanges of capital assets included in the aggregate business deductions (section 461(l)(3)(B)(i))";
}
pub relation business_capital_gain_in_income_461l(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "capital gains included in the aggregate business income or gain of the taxpayer (section 461(l)(3)(B)(ii))";
}
pub relation business_only_capital_gain_net_income(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the capital gain net income determined by taking into account only gains and losses attributable to a trade or business (section 461(l)(3)(B)(ii)(I))";
}
pub relation capital_gain_net_income_461l(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the capital gain net income (section 461(l)(3)(B)(ii)(II))";
}
pub relation has_capital_loss_deduction_fact(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a capital-loss deduction fact is asserted for the year (absence test without a wildcard)";
}
rule CapitalLossFactPresent(p: Person, y: TaxableYear) defeasible {
    label en official "bridge for `not_known` over `capital_loss_deductions_461l3B(p, y, _)`";
    when capital_loss_deductions_461l3B(p, y, _);
    then has_capital_loss_deduction_fact(p, y);
}
pub relation has_business_capital_gain_fact(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a business capital gain fact is asserted for the year";
}
rule BusinessCapitalGainFactPresent(p: Person, y: TaxableYear) defeasible {
    label en official "bridge for `not_known` over `business_capital_gain_in_income_461l(p, y, _)`";
    when business_capital_gain_in_income_461l(p, y, _);
    then has_business_capital_gain_fact(p, y);
}
pub relation business_deductions_for_ebl(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate business deductions taken into account under (l)(3)(A)(i), without capital-asset losses ((l)(3)(B)(i))";
}
@source(IRC_S461_L, quote = "Deductions for losses from sales or exchanges of capital assets shall not be taken into account under subparagraph (A)(i).")
rule BusinessDeductionsExcludeCapitalLosses(p: Person, y: TaxableYear, d: Money, c: Money) defeasible {
    label en official "capital-asset loss deductions are removed from the aggregate business deductions (section 461(l)(3)(B)(i))";
    when aggregate_business_deductions_after_469_461l6(p, y, d);
    when capital_loss_deductions_461l3B(p, y, c);
    then business_deductions_for_ebl(p, y, round(d - c, 2, "HALF_UP"));
}
rule BusinessDeductionsNoCapitalLossFact(p: Person, y: TaxableYear, d: Money) defeasible {
    label en official "with no capital-loss fact, the asserted aggregate business deductions are used as they stand (stage 1b path)";
    when aggregate_business_deductions_after_469_461l6(p, y, d);
    when not_known(has_capital_loss_deduction_fact(p, y));
    then business_deductions_for_ebl(p, y, d);
}
pub relation business_income_for_ebl(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate business income or gain taken into account under (l)(3)(A)(ii)(I), with capital gains capped at the lesser of the two capital gain net incomes ((l)(3)(B)(ii))";
}
@source(IRC_S461_L, quote = "The amount of gains from sales or exchanges of capital assets taken into account under subparagraph (A)(ii) shall not exceed the lesser of—")
rule BusinessIncomeCapCapitalGains(p: Person, y: TaxableYear, income: Money, g: Money, a: Money, b: Money) defeasible {
    label en official "capital gains in business income are limited to min(business-only capital gain net income, capital gain net income) (section 461(l)(3)(B)(ii))";
    when business_income_with_entity_shares(p, y, income);
    when business_capital_gain_in_income_461l(p, y, g);
    when business_only_capital_gain_net_income(p, y, a);
    when capital_gain_net_income_461l(p, y, b);
    then business_income_for_ebl(p, y, round(income - g + min(g, min(a, b)), 2, "HALF_UP"));
}
rule BusinessIncomeNoCapitalGainFact(p: Person, y: TaxableYear, income: Money) defeasible {
    label en official "with no business capital gain fact, the asserted aggregate business income is used as it stands (stage 1b path)";
    when business_income_with_entity_shares(p, y, income);
    when not_known(has_business_capital_gain_fact(p, y));
    then business_income_for_ebl(p, y, income);
}

// --- Pub. L. 119-21 sec. 70430: section 460(e) residential construction contracts ---

pub relation contract_entered_into_in_year(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the contract was entered into (Pub. L. 119-21 sec. 70430(c): contracts entered into in taxable years beginning after 2025-07-04)";
}
pub relation is_residential_construction_contract_460e(p: Person, contract: Integer) kind empirical {
    label en official "80 percent or more of estimated total contract costs are reasonably expected to be attributable to dwelling units (in buildings of any size) and directly related improvements on site (section 460(e)(5)(B) before redesignation as (e)(4))";
}
pub relation estimated_completion_within_three_years_of_commencement(p: Person, contract: Integer) kind empirical {
    label en official "the taxpayer estimates at contract time that the contract will be completed within 3 years of commencement (Pub. L. 119-21 sec. 70430(a)(1)(B), for residential construction contracts that are not home construction contracts)";
}
pub relation residential_construction_exemption_460e1_pl119_21(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "after Pub. L. 119-21 sec. 70430, the section 460(e)(1)(A) exemption covers any residential construction contract entered into in a taxable year beginning after 2025-07-04";
}
@source(us.irc.temporal::PL119_21_S70430, quote = "by striking “home construction contract” both places it appears and inserting “residential construction contract”")
rule ResidentialConstructionContractExemptionPL119_21(p: Person, contract: Integer, y: TaxableYear, entered: TaxableYear, begins_on: Date) defeasible {
    effective [@2025-07-04, infinity);
    label en official "the (e)(1)(A) exemption extends from home construction contracts to residential construction contracts for contracts entered into in taxable years beginning after enactment (Pub. L. 119-21 sec. 70430(a)(1), (c))";
    when is_construction_contract(p, contract);
    when is_residential_construction_contract_460e(p, contract);
    when contract_entered_into_in_year(p, contract, entered);
    when us.irc.core::begins(entered, begins_on);
    when begins_on > @2025-07-04;
    when us.irc.core::year_of(p, y);
    then residential_construction_exemption_460e1_pl119_21(p, contract, y);
}
pub relation section_263A_applies_notwithstanding_c4_pl119_21(p: Person, contract: Integer) kind institutional {
    label en official "for a residential construction contract that fails the (B)(i)-(ii) tests (with 3 years substituted for 2 for a non-home residential contract), section 263A applies notwithstanding section 263A(c)(4) (section 460(e)(1), flush sentence, as amended)";
}
pub relation residential_contract_meets_gross_receipts_test_460e1B(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "the taxpayer meets the section 448(c) gross receipts test for the year the contract was entered into (section 460(e)(1)(B)(ii))";
}
@source(us.irc.temporal::PL119_21_S70430, quote = "(determined by substituting ‘3-year’ for ‘2-year’ in subparagraph (B)(i) for any residential construction contract which is not a home construction contract)")
rule Section263AAppliesToFailingResidentialContractPL119_21(p: Person, contract: Integer, y: TaxableYear) defeasible {
    effective [@2025-07-04, infinity);
    label en official "a non-home residential contract failing the 3-year estimate or the gross receipts test is subject to section 263A notwithstanding (c)(4) (Pub. L. 119-21 sec. 70430(a)(1)(B))";
    when residential_construction_exemption_460e1_pl119_21(p, contract, y);
    when not_known(is_home_construction_contract(p, contract));
    when not_known(estimated_completion_within_three_years_of_commencement(p, contract));
    then section_263A_applies_notwithstanding_c4_pl119_21(p, contract);
}

// --- Pub. L. 119-21 sec. 70302(c): section 481 coordination of the section 174A transition ---

pub relation domestic_research_expenditures_paid_or_incurred(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "domestic research or experimental expenditures (section 174A(b)) paid or incurred in the taxable year, determined by applying section 174A(d)";
}
pub relation section_174A_change_in_method_treated_as_taxpayer_initiated_with_consent(p: Person, y: TaxableYear) kind institutional {
    label en official "the amendments of Pub. L. 119-21 sec. 70302(a) are treated as a change in method of accounting under section 481, initiated by the taxpayer and made with the consent of the Secretary (sec. 70302(c)(1)(A)-(B))";
}
pub relation section_174A_cut_off_no_481a_adjustment(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the change applies on a cut-off basis to domestic research expenditures paid or incurred in taxable years beginning after 2024-12-31, and no section 481(a) adjustment is made (sec. 70302(c)(1)(C))";
}
pub relation taxable_year_ended_before_enactment_after_2024(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year begins after 2024-12-31 and ends before the date of enactment (2025-07-04): the special rule of sec. 70302(c)(2) applies (modified cut-off)";
}
@source(us.irc.temporal::PL119_21_S70302, quote = "The amendments made by subsection (a) shall be treated as a change in method of accounting for purposes of section 481 of the Internal Revenue Code of 1986")
rule Section174AChangeTreatedAsInitiatedWithConsent(p: Person, y: TaxableYear, begins_on: Date, amount: Money) defeasible {
    effective [@2025-07-04, infinity);
    label en official "the section 174A transition change is taxpayer-initiated and consented (Pub. L. 119-21 sec. 70302(c)(1)(A)-(B))";
    when domestic_research_expenditures_paid_or_incurred(p, y, amount);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2024-12-31;
    then section_174A_change_in_method_treated_as_taxpayer_initiated_with_consent(p, y);
}
@source(us.irc.temporal::PL119_21_S70302, quote = "such change shall be applied only on a cut-off basis for any domestic research or experimental expenditures")
rule Section174ACutOffNoSection481aAdjustment(p: Person, y: TaxableYear, begins_on: Date, ends_on: Date, amount: Money) defeasible {
    effective [@2025-07-04, infinity);
    label en official "for a year ending on or after enactment, the change is cut-off only and no section 481(a) adjustment is made (Pub. L. 119-21 sec. 70302(c)(1)(C), (c)(2)(A) exclusion)";
    when domestic_research_expenditures_paid_or_incurred(p, y, amount);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2024-12-31;
    when us.irc.core::ends(y, ends_on);
    when ends_on >= @2025-07-04;
    then section_174A_cut_off_no_481a_adjustment(p, y, amount);
}
@source(us.irc.temporal::PL119_21_S70302, quote = "the change in method of accounting under paragraph (1) shall be applied on a modified cut-off basis")
rule Section174AModifiedCutOffForYearsEndedBeforeEnactment(p: Person, y: TaxableYear, begins_on: Date, ends_on: Date) defeasible {
    effective [@2025-07-04, infinity);
    label en official "a taxable year beginning after 2024-12-31 and ending before enactment takes the modified cut-off basis: paragraph (1)(C) does not apply (Pub. L. 119-21 sec. 70302(c)(2))";
    when us.irc.core::year_of(p, y);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2024-12-31;
    when us.irc.core::ends(y, ends_on);
    when ends_on < @2025-07-04;
    then taxable_year_ended_before_enactment_after_2024(p, y);
}
