// Section 448 — Limitation on use of cash method of accounting. Stage 1b
// (IRC-07), reached after the priority list as budget allowed. Scope: (a)
// the general prohibition (C corporations, partnerships with a C-corporation
// partner, tax shelters); (b) the farming and qualified-personal-service-
// corporation exceptions, and the gross-receipts-test exception; (c) the
// gross receipts test itself ($25,000,000, indexed — statutory base pinned,
// published indexed amounts SOURCE_GAP). This module also SUPPLIES
// `meets_gross_receipts_test_448c`, the relation `10-inventories.law`
// declared as a contract for section 471(c). (d) definitions beyond the tax-
// shelter bridge are NOT DONE this round.

use self::{
    IRC_S448_A,
    IRC_S448_C,
    Person,
    TaxableYear,
    is_tax_shelter_461i,
    meets_gross_receipts_test_448c,
};

pub relation is_c_corporation_448(p: Person) kind empirical {
    label en official "the taxpayer is a C corporation (section 448(a)(1))";
}
pub relation is_partnership_with_c_corporation_partner(p: Person) kind empirical {
    label en official "the taxpayer is a partnership which has a C corporation as a partner (section 448(a)(2))";
}
pub relation is_tax_shelter_448(p: Person) kind institutional {
    label en official "the taxpayer is a tax shelter, within the meaning given by section 461(i)(3) (section 448(d)(3))";
}
rule BridgeTaxShelterDefinition448(p: Person) defeasible {
    label en official "bridges section 461(i)(3)'s tax-shelter definition into section 448(a)(3) (section 448(d)(3))";
    when is_tax_shelter_461i(p);
    then is_tax_shelter_448(p);
}
pub relation cash_method_prohibited_448a(p: Person, y: TaxableYear) kind institutional {
    label en official "taxable income shall not be computed under the cash receipts and disbursements method (section 448(a))";
}
@source(IRC_S448_A, quote = "taxable income shall not be computed under the cash receipts and disbursements method of accounting")
rule CashMethodProhibitedCCorporation(p: Person, y: TaxableYear) defeasible {
    label en official "a C corporation may not use the cash method, unless a section 448(b) exception applies (section 448(a)(1))";
    when is_c_corporation_448(p);
    when us.irc.core::year_of(p, y);
    unless meets_gross_receipts_test_448c(p, y);
    then cash_method_prohibited_448a(p, y);
}
rule CashMethodProhibitedPartnershipWithCCorpPartner(p: Person, y: TaxableYear) defeasible {
    label en official "a partnership with a C-corporation partner may not use the cash method, unless a section 448(b) exception applies (section 448(a)(2))";
    when is_partnership_with_c_corporation_partner(p);
    when us.irc.core::year_of(p, y);
    unless meets_gross_receipts_test_448c(p, y);
    then cash_method_prohibited_448a(p, y);
}
rule CashMethodProhibitedTaxShelter(p: Person, y: TaxableYear) defeasible {
    label en official "a tax shelter may not use the cash method — no (b) exception applies to paragraph (3) (section 448(a)(3), (b)(1)-(3) each name only paragraphs (1) and (2))";
    when is_tax_shelter_448(p);
    when us.irc.core::year_of(p, y);
    then cash_method_prohibited_448a(p, y);
}
pub relation is_farming_business_448(p: Person) kind empirical {
    label en official "the taxpayer's trade or business is a farming business within the meaning of section 263A(e)(4) (section 448(b)(1), (d)(1))";
}
rule FarmingBusinessExceptionOverridesCCorpProhibition(p: Person, y: TaxableYear) defeasible {
    label en official "the farming-business exception removes the (a)(1)/(a)(2) prohibition (section 448(b)(1)) — modelled as a defeater on the C-corporation rule (the partnership rule carries its own `unless meets_gross_receipts_test_448c`; a farming partnership with a C-corp partner needing (b)(1) specifically is a residual gap, noted)";
    when is_c_corporation_448(p);
    when is_farming_business_448(p);
    when us.irc.core::year_of(p, y);
    then not cash_method_prohibited_448a(p, y);
}
pub relation is_qualified_personal_service_corporation(p: Person) kind empirical {
    label en official "the taxpayer is a qualified personal service corporation under section 448(d)(2) (case-asserted classification; the field-of-service and ownership tests are not separately formalized this round)";
}
rule QpscExceptionOverridesCCorpProhibition(p: Person, y: TaxableYear) defeasible {
    label en official "a qualified personal service corporation is excepted from the (a)(1)/(a)(2) prohibition (section 448(b)(2))";
    when is_c_corporation_448(p);
    when is_qualified_personal_service_corporation(p);
    when us.irc.core::year_of(p, y);
    then not cash_method_prohibited_448a(p, y);
}

// --- (c): the gross receipts test ---

pub relation average_annual_gross_receipts_prior_3_years(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average annual gross receipts of the entity for the 3-taxable-year period ending with the taxable year preceding the year at issue (section 448(c)(1)) — SIMPLIFICATION: the case supplies this rolling average directly; the (3)(A) not-in-existence-for-3-years and (3)(B) short-year annualization adjustments are not separately computed";
}
@source(IRC_S448_C, quote = "A corporation or partnership meets the gross receipts test of this subsection for any taxable year if the average annual gross receipts of such entity for the 3-taxable-year period ending with the taxable year which precedes such taxable year does not exceed $25,000,000.")
rule MeetsGrossReceiptsTest448C(p: Person, y: TaxableYear, avg: Money) strict {
    label en official "the gross receipts test is met when the average annual gross receipts for the prior 3-year period does not exceed the statutory (indexed) threshold (section 448(c)(1))";
    when average_annual_gross_receipts_prior_3_years(p, y, avg);
    when avg <= round(GrossReceiptsTestThreshold, 2, "HALF_UP");
    then meets_gross_receipts_test_448c(p, y);
}

// (b)(3)'s reference to (c) is the rule above; (d) definitions beyond the
// tax-shelter bridge (special rules for services, related-party regulations,
// UBIT trusts) are NOT DONE this round.
