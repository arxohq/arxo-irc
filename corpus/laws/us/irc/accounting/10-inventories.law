// Section 471 — General rule for inventories. Stage 1b (IRC-07), priority
// section. Scope: (a) the general rule (Secretary's opinion that inventories
// are necessary, DECISION-0194 evaluative channel); (c) the small-business
// exemption tied to the section 448(c) gross receipts test, modelled as a
// typed contract (`meets_gross_receipts_test_448c`, implemented in
// `13-cash-method-limitation.law` if this session reaches section 448;
// otherwise a pending dependency — see accounting.deps.json). (b) inventory-
// shrinkage estimates, (d) the section 263A cross-reference are NOT DONE.

use self::{
    IRC_S471_A,
    IRC_S471_C,
    Person,
    TaxableYear,
};

pub relation is_tax_shelter_448a3(p: Person) kind empirical {
    label en official "the taxpayer is a tax shelter prohibited from the cash method under section 448(a)(3), excluded from the section 471(c) exemption (section 471(c)(1))";
}
// (c) is a typed contract to section 448(c); implemented in this same
// package (13-cash-method-limitation.law) when that module exists, else a
// pending dependency.
pub relation meets_gross_receipts_test_448c(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer meets the section 448(c) gross receipts test for the taxable year (average annual gross receipts for the prior 3-year period does not exceed the indexed threshold)";
}
pub relation small_business_inventory_exemption_471c(p: Person, y: TaxableYear) kind institutional {
    label en official "section 471(a) does not apply to the taxpayer for the taxable year (section 471(c)(1)(A))";
}
@source(IRC_S471_C, quote = "In the case of any taxpayer (other than a tax shelter prohibited from using the cash receipts and disbursements method of accounting under section 448(a)(3))")
rule SmallBusinessInventoryExemption(p: Person, y: TaxableYear) defeasible {
    label en official "a taxpayer meeting the section 448(c) gross receipts test, and not an excluded tax shelter, is exempt from section 471(a) (section 471(c)(1)(A))";
    when meets_gross_receipts_test_448c(p, y);
    when not is_tax_shelter_448a3(p);
    then small_business_inventory_exemption_471c(p, y);
}
pub relation inventory_method_treats_as_nonincidental_materials(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's inventory method treats inventory as non-incidental materials and supplies (section 471(c)(1)(B)(i))";
}
pub relation inventory_method_conforms_to_afs_or_books(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's inventory method conforms to its AFS treatment, or (absent an AFS) to its books and records (section 471(c)(1)(B)(ii))";
}
pub relation exempt_inventory_method_clearly_reflects_income(p: Person, y: TaxableYear) kind institutional {
    label en official "the exempt taxpayer's inventory method is not treated as failing to clearly reflect income (section 471(c)(1)(B))";
}
rule ExemptMethodClearlyReflectsIncomeNonincidental(p: Person, y: TaxableYear) defeasible {
    label en official "an exempt taxpayer's non-incidental-materials-and-supplies inventory method is not treated as failing to clearly reflect income (section 471(c)(1)(B)(i))";
    when small_business_inventory_exemption_471c(p, y);
    when inventory_method_treats_as_nonincidental_materials(p, y);
    then exempt_inventory_method_clearly_reflects_income(p, y);
}
rule ExemptMethodClearlyReflectsIncomeConforms(p: Person, y: TaxableYear) defeasible {
    label en official "an exempt taxpayer's AFS/books-conforming inventory method is not treated as failing to clearly reflect income (section 471(c)(1)(B)(ii))";
    when small_business_inventory_exemption_471c(p, y);
    when inventory_method_conforms_to_afs_or_books(p, y);
    then exempt_inventory_method_clearly_reflects_income(p, y);
}

// --- (a): the general rule, as a DECISION-0194 evaluative channel ---

pub relation uses_inventory_method(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer takes inventories under a method (case-asserted; the method's own conformance is tested by the Secretary's opinion under (a))";
}
external judgment relation secretary_opinion_inventories_necessary(p: Person, y: TaxableYear) {
    authority Secretary;
    label en official "in the opinion of the Secretary, the use of inventories is necessary in order clearly to determine the taxpayer's income (section 471(a))";
}
pub relation inventories_required_471a(p: Person, y: TaxableYear) kind institutional {
    label en official "inventories shall be taken by the taxpayer, on a basis conforming as nearly as may be to the best accounting practice and most clearly reflecting income (section 471(a))";
}
@source(IRC_S471_A, quote = "Whenever in the opinion of the Secretary the use of inventories is necessary in order clearly to determine the income of any taxpayer, inventories shall be taken by such taxpayer")
rule InventoriesRequiredBySecretaryOpinion(p: Person, y: TaxableYear) defeasible {
    label en official "inventories are required when the Secretary opines they are necessary to clearly determine income, unless the section 471(c) small-business exemption applies (section 471(a), (c))";
    when secretary_opinion_inventories_necessary(p, y);
    unless small_business_inventory_exemption_471c(p, y);
    then inventories_required_471a(p, y);
}

// (b) inventory-shrinkage estimates, (d) section 263A cross-reference are
// NOT DONE this round.
