// Section 457 — Deferred compensation plans of State and local governments
// and tax-exempt organizations. Stage 2b (IRC-07). Scope: (a) year of
// inclusion for an ELIGIBLE plan (paid, or paid-or-made-available); (b)(2)
// the applicable-dollar-amount deferral limit (SOURCE_GAP-indexed, same
// pattern as us.irc.deductions' section-179-dollar-limit) and (b)(3) the
// last-3-years catch-up; (d)(1)(A) the four in-service distribution-timing
// triggers; (f) inclusion of an INELIGIBLE plan's deferred compensation at
// the first year with no substantial risk of forfeiture. `pub
// section_457_inclusion` covers BOTH the (a) eligible-plan inclusion and the
// (f) ineligible-plan inclusion — the two are mutually exclusive branches of
// "when is section 457 deferred compensation includible". NOT DONE
// (TECH-GAPS G326): (b)(1),(4),(5),(6) other eligible-plan tests; (c) the
// aggregate limitation across plans; (d)(1)(B)-(D),(2)-(4) minimum-
// distribution/plan-design requirements; (e) the ~18 paragraphs of
// definitions and special rules beyond eligible-employer/participant/
// beneficiary; (f)(2) the six exceptions to ineligible-plan treatment; (f)(4)
// employment retention plans; (g) governmental trust requirement; §457A
// (nonqualified deferred compensation of certain offshore entities).

use self::{
    IRC_S457_A,
    IRC_S457_B,
    IRC_S457_C,
    IRC_S457_D,
    IRC_S457_F,
    Person,
    TaxableYear,
};

pub relation is_eligible_employer_governmental(employer: Person) kind empirical {
    label en official "a State, political subdivision of a State, or an agency or instrumentality thereof (section 457(e)(1)(A))";
}
pub relation is_eligible_employer_tax_exempt(employer: Person) kind empirical {
    label en official "an organization (other than a governmental unit) exempt from tax under subtitle A (section 457(e)(1)(B))";
}
pub relation is_eligible_deferred_compensation_plan(employer: Person, plan: Integer) kind empirical {
    label en official "the plan meets the section 457(b) eligible-deferred-compensation-plan tests (participation, the (b)(2)/(3) deferral ceiling, the (b)(4) agreement-timing rule, the (d) distribution requirements, and the (b)(6) property/rights-of-the-employer rule) — read as a case fact; the (b)(1),(4),(5),(6) tests beyond the deferral ceiling and (d) timing gate below are NOT independently derived (TECH_GAP G326)";
}
pub relation deferred_compensation_paid_to_participant(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "compensation deferred under the plan (and income attributable to it) is paid to the participant or other beneficiary during the taxable year (section 457(a)(1)(A))";
}
pub relation deferred_compensation_paid_or_made_available_to_participant(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "compensation deferred under the plan (and income attributable to it) is paid or otherwise made available to the participant or other beneficiary during the taxable year (section 457(a)(1)(B))";
}
pub relation section_457_inclusion(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of section 457 deferred compensation includible in the participant's gross income for the taxable year: for an eligible plan, when paid (governmental employer) or paid-or-made-available (tax-exempt employer) (section 457(a)); for an ineligible plan, the compensation deferred with no substantial risk of forfeiture, for the first such year (section 457(f)(1)(A))";
}
@source(IRC_S457_A, quote = "is paid to the participant or other beneficiary, in the case of a plan of an eligible employer described in subsection (e)(1)(A)")
rule Section457InclusionEligibleGovernmentalPlan(employer: Person, plan: Integer, y: TaxableYear, amount: Money) strict {
    label en official "for an eligible plan of a governmental employer, deferred compensation is includible when paid (section 457(a)(1)(A))";
    when is_eligible_employer_governmental(employer);
    when is_eligible_deferred_compensation_plan(employer, plan);
    when deferred_compensation_paid_to_participant(employer, plan, y, amount);
    then section_457_inclusion(employer, plan, y, amount);
}
@source(IRC_S457_A, quote = "is paid or otherwise made available to the participant or other beneficiary, in the case of a plan of an eligible employer described in subsection (e)(1)(B)")
rule Section457InclusionEligibleTaxExemptPlan(employer: Person, plan: Integer, y: TaxableYear, amount: Money) strict {
    label en official "for an eligible plan of a tax-exempt employer, deferred compensation is includible when paid or made available (section 457(a)(1)(B))";
    when is_eligible_employer_tax_exempt(employer);
    when is_eligible_deferred_compensation_plan(employer, plan);
    when deferred_compensation_paid_or_made_available_to_participant(employer, plan, y, amount);
    then section_457_inclusion(employer, plan, y, amount);
}

// (b)(2)/(3): the deferral ceiling itself, as a validity check on the amount
// actually deferred for the year (distinct from the inclusion-timing rule
// above, which governs an ALREADY-deferred amount).
pub relation amount_deferred_for_year_457(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of compensation (other than rollover amounts) deferred under the plan for the taxable year (section 457(b)(2))";
}
// ApplicableDollarAmount457 (SOURCE_GAP: applicable-dollar-amount-457.lawparam.json, $15,000 base; no post-2006 IRS-indexed value pinned, TECH_GAP G326) is referenced directly below as a bare Money constant.
pub relation includible_compensation_457(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the participant's includible compensation, within the meaning of section 415(c)(3) (section 457(b)(2)(B))";
}
pub relation within_last_three_years_before_normal_retirement_age(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is one of the participant's last 3 taxable years ending before normal retirement age under the plan (section 457(b)(3))";
}
pub relation unused_ceiling_from_prior_years_457(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "so much of the plan ceiling for taxable years before the taxable year as has not previously been used under (b)(2) or (b)(3) (section 457(b)(3)(B)(ii)) — read as a case fact; the running multi-year unused-ceiling ledger itself is not derived (TECH_GAP G326, same class as the look-back/carryforward gaps elsewhere in this registry)";
}
pub relation deferral_ceiling_457(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the maximum amount which may be deferred under the plan for the taxable year: the lesser of the applicable dollar amount or 100 percent of includible compensation (section 457(b)(2)), OR, for one of the participant's last 3 years before normal retirement age, the greater catch-up ceiling of section 457(b)(3)";
}
@source(IRC_S457_B, quote = "the maximum amount which may be deferred under the plan for the taxable year (other than rollover amounts) shall not exceed the lesser of")
rule Section457DeferralCeilingGeneral(employer: Person, plan: Integer, y: TaxableYear, includible: Money) defeasible {
    label en official "the general section 457(b)(2) deferral ceiling is the lesser of the applicable dollar amount or 100 percent of includible compensation, unless the (b)(3) catch-up applies";
    when includible_compensation_457(employer, plan, y, includible) and not_known(within_last_three_years_before_normal_retirement_age(employer, plan, y));
    when round(ApplicableDollarAmount457, 2, "HALF_UP") <= includible;
    then deferral_ceiling_457(employer, plan, y, round(ApplicableDollarAmount457, 2, "HALF_UP"));
}
rule Section457DeferralCeilingGeneralIncludibleGoverns(employer: Person, plan: Integer, y: TaxableYear, includible: Money) defeasible {
    label en official "the general section 457(b)(2) deferral ceiling is 100 percent of includible compensation when that is less than the applicable dollar amount, unless the (b)(3) catch-up applies";
    when includible_compensation_457(employer, plan, y, includible) and not_known(within_last_three_years_before_normal_retirement_age(employer, plan, y));
    when includible < round(ApplicableDollarAmount457, 2, "HALF_UP");
    then deferral_ceiling_457(employer, plan, y, includible);
}
@source(IRC_S457_B, quote = "twice the dollar amount in effect under subsection (b)(2)(A)")
rule Section457DeferralCeilingCatchUpDoubled(employer: Person, plan: Integer, y: TaxableYear, this_year_ceiling: Money, unused: Money) defeasible {
    label en official "in a last-3-years catch-up year, the ceiling is twice the applicable dollar amount when that exceeds the sum of this year's ceiling plus unused prior ceiling (section 457(b)(3)(A))";
    when within_last_three_years_before_normal_retirement_age(employer, plan, y);
    when this_year_ceiling_457(employer, plan, y, this_year_ceiling);
    when unused_ceiling_from_prior_years_457(employer, plan, y, unused);
    when round(2.0 * ApplicableDollarAmount457, 2, "HALF_UP") >= (this_year_ceiling + unused);
    then deferral_ceiling_457(employer, plan, y, round(2.0 * ApplicableDollarAmount457, 2, "HALF_UP"));
}
rule Section457DeferralCeilingCatchUpSum(employer: Person, plan: Integer, y: TaxableYear, this_year_ceiling: Money, unused: Money) defeasible {
    label en official "in a last-3-years catch-up year, the ceiling is this year's ceiling plus unused prior ceiling when that exceeds twice the applicable dollar amount (section 457(b)(3)(B))";
    when within_last_three_years_before_normal_retirement_age(employer, plan, y);
    when this_year_ceiling_457(employer, plan, y, this_year_ceiling);
    when unused_ceiling_from_prior_years_457(employer, plan, y, unused);
    when (this_year_ceiling + unused) > round(2.0 * ApplicableDollarAmount457, 2, "HALF_UP");
    then deferral_ceiling_457(employer, plan, y, this_year_ceiling + unused);
}
pub relation this_year_ceiling_457(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the plan ceiling established for purposes of section 457(b)(2) for the taxable year, determined WITHOUT regard to the (b)(3) catch-up (section 457(b)(3)(B)(i)) — read as a case fact to avoid re-deriving Section457DeferralCeilingGeneral under a different name for the same year";
}
pub relation deferral_within_457_ceiling(employer: Person, plan: Integer, y: TaxableYear) kind institutional {
    label en official "the amount deferred for the year does not exceed the applicable section 457(b)(2)/(3) deferral ceiling (section 457(c))";
}
@source(IRC_S457_C, quote = "The maximum amount of the compensation of any one individual which may be deferred under subsection (a) during any taxable year shall not exceed the amount in effect under subsection (b)(2)(A) (as modified by any adjustment provided under subsection (b)(3)).")
rule DeferralWithin457Ceiling(employer: Person, plan: Integer, y: TaxableYear, deferred: Money, ceiling: Money) defeasible {
    label en official "the amount deferred for the year is within the section 457(c) limitation when it does not exceed the deferral ceiling";
    when amount_deferred_for_year_457(employer, plan, y, deferred);
    when deferral_ceiling_457(employer, plan, y, ceiling);
    when deferred <= ceiling;
    then deferral_within_457_ceiling(employer, plan, y);
}

// (d)(1)(A): the four in-service distribution-timing triggers (the (B)-(D)
// minimum-distribution/plan-design tests are institutional PLAN requirements,
// NON_NORMATIVE this stage, not a per-case computable event).
pub relation participant_attains_distribution_age_457(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the calendar year in which the participant attains age 70½ (age 59½ for a governmental-employer plan) (section 457(d)(1)(A)(i))";
}
pub relation participant_has_severance_from_employment(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the participant has a severance from employment with the employer (section 457(d)(1)(A)(ii))";
}
pub relation participant_faced_with_unforeseeable_emergency(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the participant is faced with an unforeseeable emergency (section 457(d)(1)(A)(iii))";
}
pub relation lifetime_income_investment_90_day_window_457(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the date that is 90 days prior to the date a lifetime income investment may no longer be held as a plan investment option, for a governmental-employer plan (section 457(d)(1)(A)(iv))";
}
pub relation distribution_permitted_under_457d(employer: Person, plan: Integer, y: TaxableYear) kind institutional {
    label en official "an in-service distribution-timing trigger of section 457(d)(1)(A) has occurred (the (B)-(D) minimum-distribution and plan-design tests are NON_NORMATIVE institutional plan requirements this stage, not separately checked per case)";
}
@source(IRC_S457_D, quote = "under the plan amounts will not be made available to participants or beneficiaries earlier than")
rule DistributionPermittedAge(employer: Person, plan: Integer, y: TaxableYear) strict {
    label en unofficial "distribution-age trigger (section 457(d)(1)(A)(i))";
    when participant_attains_distribution_age_457(employer, plan, y);
    then distribution_permitted_under_457d(employer, plan, y);
}
rule DistributionPermittedSeverance(employer: Person, plan: Integer, y: TaxableYear) strict {
    label en unofficial "severance-from-employment trigger (section 457(d)(1)(A)(ii))";
    when participant_has_severance_from_employment(employer, plan, y);
    then distribution_permitted_under_457d(employer, plan, y);
}
rule DistributionPermittedUnforeseeableEmergency(employer: Person, plan: Integer, y: TaxableYear) strict {
    label en unofficial "unforeseeable-emergency trigger (section 457(d)(1)(A)(iii))";
    when participant_faced_with_unforeseeable_emergency(employer, plan, y);
    then distribution_permitted_under_457d(employer, plan, y);
}
rule DistributionPermittedLifetimeIncomeInvestmentWindow(employer: Person, plan: Integer, y: TaxableYear) strict {
    label en unofficial "lifetime-income-investment 90-day window trigger (section 457(d)(1)(A)(iv))";
    when lifetime_income_investment_90_day_window_457(employer, plan, y);
    then distribution_permitted_under_457d(employer, plan, y);
}

// (f): ineligible-plan inclusion at vesting (no substantial risk of
// forfeiture).
pub relation is_ineligible_deferred_compensation_plan(employer: Person, plan: Integer) kind empirical {
    label en official "the plan of an eligible employer provides for a deferral of compensation but is not an eligible deferred compensation plan (section 457(f)(1)) — and is not within one of the (f)(2)(A)-(F) exceptions (qualified trust, annuity plan, section 83 property transfer, section 402(b) trust, qualified governmental excess benefit arrangement, employment retention plan) — read as a case fact; the (f)(2) exceptions are NOT independently checked (TECH_GAP G326)";
}
pub relation compensation_deferred_under_ineligible_plan(employer: Person, plan: Integer, amount: Money) kind empirical {
    label en official "the amount of compensation deferred under the ineligible plan (section 457(f)(1)(A))";
}
pub relation no_substantial_risk_of_forfeiture_457f(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the participant's rights to the deferred compensation are not conditioned on the future performance of substantial services (no substantial risk of forfeiture) as of the taxable year — the first such year is when inclusion occurs (section 457(f)(1)(A), (f)(3)(B))";
}
pub relation first_year_no_substantial_risk_of_forfeiture_457f(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is the FIRST taxable year in which there is no substantial risk of forfeiture of the compensation (section 457(f)(1)(A)) — read as a case fact rather than derived by comparing this year against every prior year's no_substantial_risk_of_forfeiture_457f status";
}
@source(IRC_S457_F, quote = "the compensation shall be included in the gross income of the participant or beneficiary for the 1st taxable year in which there is no substantial risk of forfeiture of the rights to such compensation")
rule Section457InclusionIneligiblePlanAtVesting(employer: Person, plan: Integer, y: TaxableYear, amount: Money) strict {
    label en official "deferred compensation under an ineligible plan is included in gross income for the first taxable year with no substantial risk of forfeiture (section 457(f)(1)(A))";
    when is_ineligible_deferred_compensation_plan(employer, plan);
    when compensation_deferred_under_ineligible_plan(employer, plan, amount);
    when no_substantial_risk_of_forfeiture_457f(employer, plan, y);
    when first_year_no_substantial_risk_of_forfeiture_457f(employer, plan, y);
    then section_457_inclusion(employer, plan, y, amount);
}
