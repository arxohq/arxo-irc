// Sections 448(c)(4) and 461 residual (stage 3, DECISION-0379 with deontics):
// the cost-of-living formulas of 448(c)(4) and 461(l)(3)(C) with the published
// adjustment read as an input; the applicable subsidy of 461(j)(3) feeding the
// (j)(1) disallowance; the farming business of 461(j)(4)(C); the (k)(2)
// exclusions and (k)(4) limited entrepreneur; and the partner's cash basis of
// 461(i)(2)(C).
//
// The stage 2 rules read fixed base amounts; the indexed amounts below are
// separate relations and are not wired into them, since the published section
// 1(f)(3) adjustment for a year is a value outside the pinned sources
// (SOURCE_GAP) that the case supplies.
//
// Not modelled (TECH-GAPS G2112, G2113, G2114, G2137): the running ledger of
// (j)(4)(B)(ii)(I); the partner and shareholder level of (j)(5) and (l)(4); the
// ordering against section 469 in (j)(7) and (l)(6); and the sums of losses and
// borrowings over derived relations, which stay asserted totals.

// ===================== 448(c)(4), 461(l)(3)(C): indexed amounts =====================

use self::{
    IRC_S448_C,
    IRC_S461_I,
    IRC_S461_J,
    IRC_S461_K,
    IRC_S461_L,
    Person,
    TaxableYear,
    excess_farm_loss,
    excess_farm_loss_disallowed,
    farm_loss_limitation_suspended_461l1A,
    is_corporation_taxpayer,
};

pub relation cost_of_living_adjustment_1f3_2017_base_446(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the cost-of-living adjustment under section 1(f)(3) for the calendar year in which the taxable year begins, with 2017 substituted for 2016 (section 448(c)(4)(B), section 461(l)(3)(C)(ii)); the published percentage is asserted";
}
pub relation gross_receipts_threshold_indexed_448c4(y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 448(c)(1) amount for a taxable year beginning after 2018: the base plus the base times the adjustment, rounded to the nearest multiple of $1,000,000 (section 448(c)(4))";
}
@source(IRC_S448_C, quote = "In the case of any taxable year beginning after December 31, 2018, the dollar amount in paragraph (1) shall be increased by an amount equal to—")
rule GrossReceiptsThresholdIndexed(y: TaxableYear, begins_on: Date, rate: Decimal) strict {
    label en official "base x (1 + adjustment), nearest $1,000,000 (section 448(c)(4)(A)-(B))";
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2018-12-31;
    when cost_of_living_adjustment_1f3_2017_base_446(y, rate);
    then gross_receipts_threshold_indexed_448c4(y, div_round((GrossReceiptsTestThreshold / 1.00 USD) * (1.0 + rate), 1000000.0, 0, "HALF_UP") * 1000000.00 USD);
}
pub relation excess_business_loss_base_indexed_461l3C(y: TaxableYear, amount: Money) kind institutional {
    label en official "the $250,000 amount of (l)(3)(A)(ii)(II) for a taxable year beginning after 2018: the base plus the base times the adjustment, rounded to the nearest multiple of $1,000 (section 461(l)(3)(C))";
}
@source(IRC_S461_L, quote = "In the case of any taxable year beginning after December 31, 2018, the $250,000 amount in subparagraph (A)(ii)(II) shall be increased by an amount equal to—")
rule ExcessBusinessLossBaseIndexed(y: TaxableYear, begins_on: Date, rate: Decimal) strict {
    label en official "base x (1 + adjustment), nearest $1,000 (section 461(l)(3)(C))";
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2018-12-31;
    when cost_of_living_adjustment_1f3_2017_base_446(y, rate);
    then excess_business_loss_base_indexed_461l3C(y, div_round((ExcessBusinessLossBaseAmount / 1.00 USD) * (1.0 + rate), 1000.0, 0, "HALF_UP") * 1000.00 USD);
}

// ===================== 461(j)(3): applicable subsidy =====================

pub relation direct_or_counter_cyclical_payment_2008_act_461j3A(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer receives a direct or counter-cyclical payment under title I of the Food, Conservation, and Energy Act of 2008 (section 461(j)(3)(A))";
}
pub relation payment_elected_in_lieu_of_2008_act_payment_461j3A(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer receives a payment elected to be received in lieu of such a payment (section 461(j)(3)(A))";
}
pub relation commodity_credit_corporation_loan_received_461j3B(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has a Commodity Credit Corporation loan for the year (section 461(j)(3)(B))";
}
pub relation applicable_subsidy_derived_461j3(p: Person, y: TaxableYear) kind institutional {
    label en official "an applicable subsidy: (A) a 2008 Act direct or counter-cyclical payment or the payment elected in lieu, or (B) a Commodity Credit Corporation loan (section 461(j)(3))";
}
@source(IRC_S461_J, quote = "(A) any direct or counter-cyclical payment under title I of the Food, Conservation, and Energy Act of 2008, or any payment elected to be received in lieu of any such payment, or")
rule ApplicableSubsidyDirectOrCounterCyclical(p: Person, y: TaxableYear) strict {
    label en official "(A): a direct or counter-cyclical payment";
    when direct_or_counter_cyclical_payment_2008_act_461j3A(p, y);
    then applicable_subsidy_derived_461j3(p, y);
}
rule ApplicableSubsidyElectedInLieu(p: Person, y: TaxableYear) strict {
    label en official "(A): a payment elected in lieu of one";
    when payment_elected_in_lieu_of_2008_act_payment_461j3A(p, y);
    then applicable_subsidy_derived_461j3(p, y);
}
@source(IRC_S461_J, quote = "(B) any Commodity Credit Corporation loan.")
rule ApplicableSubsidyCommodityCreditCorporationLoan(p: Person, y: TaxableYear) strict {
    label en official "(B): a Commodity Credit Corporation loan";
    when commodity_credit_corporation_loan_received_461j3B(p, y);
    then applicable_subsidy_derived_461j3(p, y);
}
rule ExcessFarmLossDisallowedByDerivedSubsidy(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "an excess farm loss is disallowed for a non-C-corporation taxpayer with a derived applicable subsidy, unless (l)(1)(A) suspends (j) (section 461(j)(1), (j)(3))";
    when not_known(is_corporation_taxpayer(p));
    when applicable_subsidy_derived_461j3(p, y);
    when excess_farm_loss(p, y, amount);
    when amount > 0.00 USD;
    when not_known(farm_loss_limitation_suspended_461l1A(p, y));
    then excess_farm_loss_disallowed(p, y, amount);
}

// ===================== 461(j)(4)(C): farming business =====================

pub relation farming_business_under_263A_e4_461j4Ci(p: Person) kind empirical {
    label en official "the taxpayer is engaged in a farming business as defined in section 263A(e)(4) (section 461(j)(4)(C)(i)); the section 263A(e)(4) test is asserted";
}
pub relation farming_business_for_commodity_461j4Cii(p: Person, commodity: Integer) kind empirical {
    label en official "without regard to clause (ii) the taxpayer is engaged in a farming business with respect to the agricultural or horticultural commodity (section 461(j)(4)(C)(ii))";
}
pub relation taxpayer_processes_commodity_461j4CiiI(p: Person, commodity: Integer) kind empirical {
    label en official "the taxpayer has a trade or business of processing the commodity, whether or not incidental to growing, raising, or harvesting it (section 461(j)(4)(C)(ii)(I))";
}
pub relation member_of_subchapter_t_cooperative_461j4CiiII(p: Person, coop: Person) kind empirical {
    label en official "the taxpayer is a member of a cooperative to which subchapter T applies (section 461(j)(4)(C)(ii)(II))";
}
pub relation cooperative_processes_commodity_461j4CiiII(coop: Person, commodity: Integer) kind empirical {
    label en official "the cooperative has a trade or business of processing the commodity (section 461(j)(4)(C)(ii)(II))";
}
pub relation farming_business_for_section_461j_461j4C(p: Person) kind institutional {
    label en official "a farming business for section 461(j): the section 263A(e)(4) meaning, extended to processing of a commodity the taxpayer farms, including through a subchapter T cooperative (section 461(j)(4)(C))";
}
@source(IRC_S461_J, quote = "The term \"farming business\" has the meaning given such term in section 263A(e)(4).")
rule FarmingBusinessBySection263A(p: Person) strict {
    label en official "the section 263A(e)(4) meaning (section 461(j)(4)(C)(i))";
    when farming_business_under_263A_e4_461j4Ci(p);
    then farming_business_for_section_461j_461j4C(p);
}
@source(IRC_S461_J, quote = "the term \"farming business\" shall include any trade or business of the taxpayer of the processing of such commodity")
rule FarmingBusinessIncludesProcessing(p: Person, commodity: Integer) strict {
    label en official "processing of a commodity the taxpayer farms (section 461(j)(4)(C)(ii)(I))";
    when farming_business_for_commodity_461j4Cii(p, commodity);
    when taxpayer_processes_commodity_461j4CiiI(p, commodity);
    then farming_business_for_section_461j_461j4C(p);
}
@source(IRC_S461_J, quote = "shall be treated as the trade or business of the taxpayer.")
rule FarmingBusinessIncludesCooperativeProcessing(p: Person, commodity: Integer, coop: Person) strict {
    label en official "processing by a subchapter T cooperative of which the taxpayer is a member (section 461(j)(4)(C)(ii)(II))";
    when farming_business_for_commodity_461j4Cii(p, commodity);
    when member_of_subchapter_t_cooperative_461j4CiiII(p, coop);
    when cooperative_processes_commodity_461j4CiiII(coop, commodity);
    then farming_business_for_section_461j_461j4C(p);
}

// ===================== 461(k)(2), (k)(4): limited partners and entrepreneurs =====================

pub relation limited_entrepreneur_interest_other_than_limited_partner_461k4A(person: Person, enterprise: Person) kind empirical {
    label en official "the person has an interest in the enterprise other than as a limited partner (section 461(k)(4)(A))";
}
pub relation person_actively_participates_in_management_461k4B(person: Person, enterprise: Person) kind empirical {
    label en official "the person actively participates in the management of the enterprise (section 461(k)(4)(B)); an adjudicated fact";
}
pub relation limited_entrepreneur_461k4(person: Person, enterprise: Person) kind institutional {
    label en official "a limited entrepreneur: an interest other than as a limited partner and no active participation in management (section 461(k)(4))";
}
@source(IRC_S461_K, quote = "(A) has an interest in an enterprise other than as a limited partner, and")
rule LimitedEntrepreneurDefinition(person: Person, enterprise: Person) defeasible {
    label en official "(A) and not (B) (section 461(k)(4))";
    when limited_entrepreneur_interest_other_than_limited_partner_461k4A(person, enterprise);
    when not_known(person_actively_participates_in_management_461k4B(person, enterprise));
    then limited_entrepreneur_461k4(person, enterprise);
}
pub relation years_of_active_farm_management_461k2A(individual: Person, years: Integer) kind empirical {
    label en official "the years the individual actively participated in the management of a trade or business of farming (section 461(k)(2)(A))";
}
pub relation interest_attributable_to_active_participation_461k2(individual: Person, enterprise: Person) kind empirical {
    label en official "the interest in the enterprise is attributable to the individual's active participation (section 461(k)(2)(A), (E))";
}
pub relation principal_residence_on_farm_enterprise_farms_it_461k2B(individual: Person, enterprise: Person) kind empirical {
    label en official "the individual's principal residence is on a farm and the enterprise is engaged in the trade or business of farming that farm (section 461(k)(2)(B))";
}
pub relation actively_participating_in_farm_management_461k2C(individual: Person) kind empirical {
    label en official "the individual is actively participating in the management of a trade or business of farming (section 461(k)(2)(C))";
}
pub relation participation_in_further_processing_of_livestock_raised_461k2C(individual: Person, enterprise: Person) kind empirical {
    label en official "the participation is in the further processing of livestock raised in the individual's farming business (section 461(k)(2)(C))";
}
pub relation principal_business_activity_is_active_farm_management_461k2D(individual: Person) kind empirical {
    label en official "the individual's principal business activity involves active participation in the management of a trade or business of farming (section 461(k)(2)(D))";
}
pub relation interest_in_other_farming_business_461k2D(individual: Person, enterprise: Person) kind empirical {
    label en official "the interest is in any other trade or business of farming (section 461(k)(2)(D))";
}
pub relation family_member_of_grandparent_or_spouse_461k2E(individual: Person, holder: Person) kind empirical {
    label en official "the holder is a member of the family (section 267(c)(4)) of a grandparent of the individual, or the spouse of such a member (section 461(k)(2)(E)); the family test is asserted";
}
pub relation interest_treated_as_not_held_by_limited_partner_or_entrepreneur_461k2(holder: Person, enterprise: Person) kind institutional {
    label en official "the interest is not held by a limited partner or limited entrepreneur, under (A)-(E) (section 461(k)(2))";
}
pub relation individual_interest_described_in_461k2ABCD(individual: Person, enterprise: Person) kind institutional {
    label en official "the individual is described in (A), (B), (C) or (D) for the enterprise (section 461(k)(2)(A)-(D))";
}
@source(IRC_S461_K, quote = "(A) in the case of any individual who has actively participated (for a period of not less than 5 years) in the management of any trade or business of farming, any interest in a partnership or other enterprise which is attributable to such active participation,")
rule InterestOfLongTimeFarmManager(individual: Person, enterprise: Person, years: Integer) strict {
    label en official "(A): 5 years of active participation";
    when years_of_active_farm_management_461k2A(individual, years);
    when years >= 5;
    when interest_attributable_to_active_participation_461k2(individual, enterprise);
    then individual_interest_described_in_461k2ABCD(individual, enterprise);
}
@source(IRC_S461_K, quote = "(B) in the case of any individual whose principal residence is on a farm, any partnership or other enterprise engaged in the trade or business of farming such farm,")
rule InterestOfFarmResident(individual: Person, enterprise: Person) strict {
    label en official "(B): the individual lives on the farm";
    when principal_residence_on_farm_enterprise_farms_it_461k2B(individual, enterprise);
    then individual_interest_described_in_461k2ABCD(individual, enterprise);
}
@source(IRC_S461_K, quote = "any participation in the further processing of livestock which was raised in such trade or business")
rule InterestInLivestockProcessing(individual: Person, enterprise: Person) strict {
    label en official "(C): further processing of livestock raised by an actively managing individual";
    when actively_participating_in_farm_management_461k2C(individual);
    when participation_in_further_processing_of_livestock_raised_461k2C(individual, enterprise);
    then individual_interest_described_in_461k2ABCD(individual, enterprise);
}
@source(IRC_S461_K, quote = "(D) in the case of an individual whose principal business activity involves active participation in the management of a trade or business of farming, any interest in any other trade or business of farming, and,")
rule InterestOfPrincipalFarmManagerInOtherFarm(individual: Person, enterprise: Person) strict {
    label en official "(D): another farming business of a principal farm manager";
    when principal_business_activity_is_active_farm_management_461k2D(individual);
    when interest_in_other_farming_business_461k2D(individual, enterprise);
    then individual_interest_described_in_461k2ABCD(individual, enterprise);
}
rule InterestOfDescribedIndividualNotLimited(individual: Person, enterprise: Person) strict {
    label en official "an interest of an individual described in (A)-(D) (section 461(k)(2))";
    when individual_interest_described_in_461k2ABCD(individual, enterprise);
    then interest_treated_as_not_held_by_limited_partner_or_entrepreneur_461k2(individual, enterprise);
}
@source(IRC_S461_K, quote = "(E) any interest held by a member of the family (or a spouse of any such member) of a grandparent of an individual described in subparagraph (A), (B), (C), or (D)")
rule InterestOfFamilyOfQualifiedIndividual(individual: Person, holder: Person, enterprise: Person) strict {
    label en official "(E): family of an individual described in (A)-(D), for an interest attributable to that individual's participation";
    when family_member_of_grandparent_or_spouse_461k2E(individual, holder);
    when individual_interest_described_in_461k2ABCD(individual, enterprise);
    when interest_attributable_to_active_participation_461k2(individual, enterprise);
    then interest_treated_as_not_held_by_limited_partner_or_entrepreneur_461k2(holder, enterprise);
}

// ===================== 461(i)(2)(C): partner's cash basis =====================

pub relation adjusted_basis_of_partner_interest_461i2C(partner: Person, partnership: Person, amount: Money) kind empirical {
    label en official "the adjusted basis of the partner's interest in the partnership (section 461(i)(2)(C)); the section 705 basis is the partnerships owner's and asserted";
}
pub relation partnership_liabilities_included_in_basis_461i2Ci(partner: Person, partnership: Person, amount: Money) kind empirical {
    label en official "the part of the adjusted basis attributable to any liability of the partnership (section 461(i)(2)(C)(i))";
}
pub relation partner_loan_arranged_by_partnership_or_promoter_461i2CiiI(loan: Integer) kind empirical {
    label en official "the loan was arranged by the partnership or by a person who participated in its organization, sale or management (or a person related to one within section 465(b)(3)(C)) (section 461(i)(2)(C)(ii)(I))";
}
pub relation partner_loan_secured_by_partnership_asset_461i2CiiII(loan: Integer) kind empirical {
    label en official "the loan was secured by any asset of the partnership (section 461(i)(2)(C)(ii)(II))";
}
pub relation partner_borrowing_with_respect_to_partnership_461i2Cii(partner: Person, partnership: Person, loan: Integer) kind empirical {
    label en official "an amount borrowed by the partner with respect to the partnership (section 461(i)(2)(C)(ii))";
}
pub relation borrowing_excluded_from_cash_basis_461i2Cii(loan: Integer) kind institutional {
    label en official "a borrowing excluded from cash basis: arranged by the partnership or a promoter, or secured by a partnership asset (section 461(i)(2)(C)(ii)(I)-(II))";
}
@source(IRC_S461_I, quote = "(I) was arranged by the partnership or by any person who participated in the organization, sale, or management of the partnership (or any person related to such person within the meaning of section 465(b)(3)(C)), or")
rule BorrowingArrangedByPartnershipOrPromoter(partner: Person, partnership: Person, loan: Integer) strict {
    label en official "(ii)(I)";
    when partner_borrowing_with_respect_to_partnership_461i2Cii(partner, partnership, loan);
    when partner_loan_arranged_by_partnership_or_promoter_461i2CiiI(loan);
    then borrowing_excluded_from_cash_basis_461i2Cii(loan);
}
@source(IRC_S461_I, quote = "(II) was secured by any asset of the partnership.")
rule BorrowingSecuredByPartnershipAsset(partner: Person, partnership: Person, loan: Integer) strict {
    label en official "(ii)(II)";
    when partner_borrowing_with_respect_to_partnership_461i2Cii(partner, partnership, loan);
    when partner_loan_secured_by_partnership_asset_461i2CiiII(loan);
    then borrowing_excluded_from_cash_basis_461i2Cii(loan);
}
pub relation excluded_borrowings_included_in_basis_461i2Cii(partner: Person, partnership: Person, amount: Money) kind empirical {
    label en official "the total of the excluded borrowings included in the adjusted basis; an aggregate over the derived exclusion, asserted (TECH-GAPS G2137 class)";
}
pub relation partner_cash_basis_461i2C(partner: Person, partnership: Person, amount: Money) kind institutional {
    label en official "the partner's cash basis: the adjusted basis without regard to partnership liabilities and the excluded borrowings, floored at zero (JUDGMENT CALL) (section 461(i)(2)(C))";
}
@source(IRC_S461_I, quote = "a partner's cash basis in a partnership shall be equal to the adjusted basis of such partner's interest in the partnership, determined without regard to—")
rule PartnerCashBasisComputation(partner: Person, partnership: Person, basis: Money, liabilities: Money, borrowed: Money) defeasible {
    label en official "max(basis - liabilities - excluded borrowings, 0) (section 461(i)(2)(C))";
    when adjusted_basis_of_partner_interest_461i2C(partner, partnership, basis);
    when partnership_liabilities_included_in_basis_461i2Ci(partner, partnership, liabilities);
    when excluded_borrowings_included_in_basis_461i2Cii(partner, partnership, borrowed);
    then partner_cash_basis_461i2C(partner, partnership, max(basis - liabilities - borrowed, 0 USD));
}
