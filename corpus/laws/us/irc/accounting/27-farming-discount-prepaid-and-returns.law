// Sections 447, 454, 455, 456, 458, 474 (stage 2c, IRC-07): accrual method for
// farming corporations (with a prohibition position), discount obligations,
// prepaid subscription and dues income (elections as powers, inclusion rules,
// the dues transition), returned magazines/paperbacks/records (election,
// return periods, suspense account), and the simplified dollar-value LIFO
// election for small businesses.
//
// Not modelled (TECH-GAPS G2102, G2107-G2110, coverage/accounting.json): the (e)(4)
// preproductive-period and election windows of section 447, section 455(c)(2)
// regulations and (e), section 456(d) beyond the two amounts, the multi-year
// election continuation beyond one year (self-recursion, G1 family), section
// 458(b)(8) certification evidence and (e)(5) subchapter C transactions, and
// section 474(b)/(d)(4)(A) price-index pool mechanics.

// ===================== Section 447 =====================

use self::{
    AccountingMethod,
    IRC_S447_A,
    IRC_S447_D,
    IRC_S447_E,
    IRC_S454_A,
    IRC_S454_B,
    IRC_S454_C,
    IRC_S455_A,
    IRC_S455_B,
    IRC_S455_C,
    IRC_S455_E,
    IRC_S456_A,
    IRC_S456_B,
    IRC_S456_C,
    IRC_S456_D,
    IRC_S456_E,
    IRC_S458_A,
    IRC_S458_B,
    IRC_S458_D,
    IRC_S458_E,
    IRC_S474_A,
    IRC_S474_C,
    IRC_S474_D,
    Person,
    TaxableYear,
    applicable_accounting_method,
    meets_gross_receipts_test_448c,
    preceding_taxable_year_465,
};

pub relation engaged_in_farming_447(p: Person) kind empirical {
    label en official "the taxpayer is engaged in the trade or business of farming (section 447(a))";
}
pub relation is_corporation_447(p: Person) kind empirical {
    label en official "the taxpayer is a corporation (section 447(a)(1))";
}
pub relation is_s_corporation_447(p: Person) kind empirical {
    label en official "the corporation is an S corporation, treated as not a corporation for section 447(a) (section 447(c)(1))";
}
pub relation partnership_with_corporate_partner_447(p: Person) kind empirical {
    label en official "the partnership is engaged in farming and a corporation is a partner, after the (c) treatment of S corporations and small-receipts corporations as non-corporations (section 447(a)(2), (c))";
}
pub relation nursery_sod_or_non_fruit_tree_business_447(p: Person) kind empirical {
    label en official "the business is operating a nursery or sod farm, or raising or harvesting trees other than fruit and nut trees, to which section 447 does not apply (section 447(a), last sentence)";
}
pub relation farming_accrual_method_required_447(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxable income from farming must be computed on an accrual method (section 447(a)), subject to (c) and Pub. L.-independent exclusions";
}
@source(IRC_S447_A, quote = "shall be computed on an accrual method of accounting.")
rule FarmingCorporationAccrualRequired(p: Person, y: TaxableYear) defeasible {
    label en official "a farming corporation (not an S corporation, and not a corporation meeting the section 448(c) gross receipts test) must use the accrual method (section 447(a)(1), (c))";
    when engaged_in_farming_447(p);
    when is_corporation_447(p);
    when us.irc.core::year_of(p, y);
    when not_known(is_s_corporation_447(p));
    when not_known(nursery_sod_or_non_fruit_tree_business_447(p));
    unless meets_gross_receipts_test_448c(p, y);
    then farming_accrual_method_required_447(p, y);
}
@source(IRC_S447_A, quote = "a partnership engaged in the trade or business of farming, if a corporation is a partner in such partnership,")
rule FarmingPartnershipWithCorporatePartnerAccrualRequired(p: Person, y: TaxableYear) defeasible {
    label en official "a farming partnership with a corporate partner must use the accrual method (section 447(a)(2))";
    when engaged_in_farming_447(p);
    when partnership_with_corporate_partner_447(p);
    when us.irc.core::year_of(p, y);
    when not_known(nursery_sod_or_non_fruit_tree_business_447(p));
    then farming_accrual_method_required_447(p, y);
}
pub relation computes_farming_income_on_non_accrual_method_447(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer computes taxable income from farming on a method other than an accrual method for the taxable year";
}
@source(IRC_S447_A, quote = "shall be computed on an accrual method of accounting.")
rule Section447aNonAccrualMethodProhibition(p: Person, y: TaxableYear) defeasible {
    label en official "a taxpayer to whom section 447(a) applies must not compute farming income on a non-accrual method; using one is a breach of the prohibition (section 447(a))";
    when farming_accrual_method_required_447(p, y);
    then prohibition Section447aNonAccrualMethodBar {
        bearer p;
        action computes_farming_income_on_non_accrual_method_447(p, y);
        window [-infinity, infinity];
    };
}
pub relation change_in_method_made_pursuant_to_447(p: Person, y: TaxableYear) kind empirical {
    label en official "a change in method of accounting made pursuant to section 447 (section 447(d))";
}
pub relation section_447_change_is_taxpayer_initiated_with_consent(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 447 change is treated for section 481 as initiated by the taxpayer and made with the Secretary's consent (section 447(d))";
}
@source(IRC_S447_D, quote = "shall be treated for purposes of section 481 as initiated by the taxpayer and made with the consent of the Secretary.")
rule Section447dChangeInitiatedWithConsent(p: Person, y: TaxableYear) defeasible {
    label en official "a section 447 method change is taxpayer-initiated and consented (section 447(d))";
    when change_in_method_made_pursuant_to_447(p, y);
    then section_447_change_is_taxpayer_initiated_with_consent(p, y);
}
// (e): grandfathered annual accrual method (relief from section 263A capitalization).
pub relation used_annual_accrual_ten_years_ending_first_year_after_1975(p: Person) kind empirical {
    label en official "for its 10 taxable years ending with its first taxable year beginning after December 31, 1975, the corporation or qualified partnership used an annual accrual method for farming (section 447(e)(1)(A))";
}
pub relation raises_crops_harvested_at_least_12_months_after_planting(p: Person) kind empirical {
    label en official "the corporation or qualified partnership raises crops harvested not less than 12 months after planting (section 447(e)(1)(B))";
}
pub relation used_annual_accrual_all_intervening_years(p: Person, y: TaxableYear) kind empirical {
    label en official "the method was used for all taxable years between the first year beginning after 1975 and the taxable year (section 447(e)(1)(C))";
}
pub enum QualifiedFarmingKind {
    SugarCane;
    PlantWithPreproductivePeriodTwoYearsOrLess;
    OtherPlantWithElection;
    label en official "the qualified farming trades or businesses of section 447(e)(4)(B)(i)(I)-(III)";
}
pub relation farming_kind_447e(p: Person, k: QualifiedFarmingKind) kind empirical {
    label en official "the kind of farming the taxpayer is engaged in";
}
pub relation crop_is_citrus_or_almond_tree(p: Person) kind empirical {
    label en official "the other plant is a citrus or almond tree (excluded from (e)(4)(B)(i)(III))";
}
pub relation is_qualified_partnership_447e4A(p: Person) kind empirical {
    label en official "a partnership engaged in a qualified farming trade or business all of whose partners are corporations other than S corporations and personal holding companies (section 447(e)(4)(A))";
}
pub relation is_qualified_farming_trade_or_business_447e(p: Person) kind institutional {
    label en official "the qualified farming trade or business: sugar cane, a plant with a preproductive period of 2 years or less, or another plant (not citrus or almond) with an election (section 447(e)(4)(B)(i)); for a partnership only sugar cane";
}
rule QualifiedFarmingSugarCane(p: Person) defeasible {
    label en official "sugar cane is a qualified farming trade or business (section 447(e)(4)(B)(i)(I))";
    when farming_kind_447e(p, SugarCane);
    then is_qualified_farming_trade_or_business_447e(p);
}
rule QualifiedFarmingShortPreproductivePlantNotPartnership(p: Person) defeasible {
    label en official "a plant with a preproductive period of 2 years or less qualifies for a corporation, not for a partnership (section 447(e)(4)(B)(i)(II), flush)";
    when farming_kind_447e(p, PlantWithPreproductivePeriodTwoYearsOrLess);
    when not_known(is_qualified_partnership_447e4A(p));
    then is_qualified_farming_trade_or_business_447e(p);
}
rule QualifiedFarmingOtherPlantWithElection(p: Person) defeasible {
    label en official "another plant (not citrus or almond) qualifies for a corporation with an election in effect (section 447(e)(4)(B)(i)(III))";
    when farming_kind_447e(p, OtherPlantWithElection);
    when not_known(crop_is_citrus_or_almond_tree(p));
    when not_known(is_qualified_partnership_447e4A(p));
    then is_qualified_farming_trade_or_business_447e(p);
}
pub relation annual_accrual_method_continuation_permitted_447e(p: Person, y: TaxableYear) kind institutional {
    label en official "the corporation or qualified partnership may continue its annual accrual method, notwithstanding (a) or section 263A, for its qualified farming trade or business (section 447(e)(1))";
}
@source(IRC_S447_E, quote = "such corporation or qualified partnership may continue to employ such method of accounting for the taxable year with respect to its qualified farming trade or business.")
rule Section447eContinuationPermitted(p: Person, y: TaxableYear) defeasible {
    label en official "the three (e)(1) conditions and a qualified farming trade or business permit continuing the annual accrual method (section 447(e)(1))";
    when used_annual_accrual_ten_years_ending_first_year_after_1975(p);
    when raises_crops_harvested_at_least_12_months_after_planting(p);
    when used_annual_accrual_all_intervening_years(p, y);
    when is_qualified_farming_trade_or_business_447e(p);
    then annual_accrual_method_continuation_permitted_447e(p, y);
}
pub relation acquired_substantially_all_assets_in_nonrecognition_transfer(p: Person, transferor: Person) kind empirical {
    label en official "the transferee acquired substantially all assets of a qualified farming trade or business from a corporation in a nonrecognition transaction, or (partnership) from a partner in a section 721 transaction (section 447(e)(3))";
}
pub relation transferor_used_annual_accrual_for_period(transferor: Person) kind empirical {
    label en official "the transferor computed its income on an annual accrual method for the period at issue";
}
pub relation transferee_deemed_to_have_used_annual_accrual(p: Person) kind institutional {
    label en official "the transferee is deemed to have used an annual accrual method for the period the transferor did (section 447(e)(3))";
}
@source(IRC_S447_E, quote = "the transferee corporation or qualified partnership shall be deemed to have computed its taxable income on an annual accrual method of accounting")
rule TransfereeDeemedToHaveUsedTransferorsMethod(p: Person, transferor: Person) defeasible {
    label en official "a nonrecognition transferee inherits the transferor's annual accrual history (section 447(e)(3))";
    when acquired_substantially_all_assets_in_nonrecognition_transfer(p, transferor);
    when transferor_used_annual_accrual_for_period(transferor);
    then transferee_deemed_to_have_used_annual_accrual(p);
}

// ===================== Section 454 =====================

pub relation owns_discount_obligation_454a(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer owns a non-interest-bearing obligation issued at a discount and redeemable for fixed amounts increasing at stated intervals, or a savings bond described in (c)(2), whose annual increase is not income under the taxpayer's method (section 454(a))";
}
pub relation elects_current_inclusion_of_redemption_increase_454a(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects in the return to treat the increase in redemption price as income received in the taxable year (section 454(a))";
}
pub relation current_inclusion_election_in_effect_454a(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 454(a) election is in effect: it applies to all obligations of the kind owned by the taxpayer";
}
@source(IRC_S454_A, quote = "such taxpayer may, at his election made in his return for any taxable year, treat such increase as income received in such taxable year.")
rule Section454aCurrentInclusionElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a holder of discount obligations may elect current inclusion of the annual increase; the election covers all such obligations (section 454(a))";
    when elects_current_inclusion_of_redemption_increase_454a(p, y);
    then power Section454aCurrentInclusionElection {
        holder p;
        over y;
        exercise elects_current_inclusion_of_redemption_increase_454a(p, y);
        valid_when owns_discount_obligation_454a(p, y);
        effect create(current_inclusion_election_in_effect_454a(p, y));
        window [@1954-08-16, infinity);
    };
}
pub relation redemption_price_increase_in_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the increase in the redemption price of the obligations occurring in the taxable year";
}
pub relation redemption_increase_included_as_income_454a(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in redemption price is treated as income received in the taxable year for an electing taxpayer (section 454(a))";
}
rule RedemptionIncreaseIncludedWhenElected(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "under the election, the year's increase is income of the year (section 454(a))";
    when current_inclusion_election_in_effect_454a(p, y);
    when redemption_price_increase_in_year(p, y, amount);
    then redemption_increase_included_as_income_454a(p, y, amount);
}
pub enum ShortTermIssuerKind {
    UnitedStates;
    StateOrPossessionOrSubdivision;
    DistrictOfColumbia;
    label en official "the issuers named in section 454(b)(1)-(2)";
}
pub relation obligation_issuer_kind(obl: Integer, k: ShortTermIssuerKind) kind empirical {
    label en official "the issuer of the obligation is of the kind (section 454(b))";
}
pub relation obligation_issued_on_discount_basis_payable_without_interest(obl: Integer) kind empirical {
    label en official "the obligation is issued on a discount basis and payable without interest at a fixed maturity date (section 454(b))";
}
pub relation obligation_issue_date(obl: Integer, d: Date) kind empirical {
    label en official "the date of issue";
}
pub relation obligation_maturity_date(obl: Integer, d: Date) kind empirical {
    label en official "the fixed maturity date";
}
pub relation is_short_term_discount_obligation_454b(obl: Integer) kind institutional {
    label en official "a short-term discount obligation of a government issuer with a fixed maturity not exceeding 1 year from issue (section 454(b))";
}
@source(IRC_S454_B, quote = "which is issued on a discount basis and payable without interest at a fixed maturity date not exceeding 1 year from the date of issue")
rule ShortTermDiscountObligationDefinition(obl: Integer, issued: Date, matures: Date) defeasible {
    label en official "government discount obligation maturing within one year of issue (section 454(b))";
    when obligation_issuer_kind(obl, _);
    when obligation_issued_on_discount_basis_payable_without_interest(obl);
    when obligation_issue_date(obl, issued);
    when obligation_maturity_date(obl, matures);
    when matures <= add_calendar_period(issued, 12 calendar_month);
    then is_short_term_discount_obligation_454b(obl);
}
pub relation first_payment_sale_or_disposition_date(p: Person, obl: Integer, d: Date) kind empirical {
    label en official "the date the obligation is paid at maturity, sold, or otherwise disposed of (the earliest such event; the earliest-of-several selection is asserted, TECH-GAPS G136 family)";
}
pub relation discount_accrual_date_454b(p: Person, obl: Integer, d: Date) kind institutional {
    label en official "the date on which the discount at which the obligation was originally sold is considered to accrue (section 454(b))";
}
@source(IRC_S454_B, quote = "the amount of discount at which such obligation is originally sold shall not be considered to accrue until the date on which such obligation is paid at maturity, sold, or otherwise disposed of.")
rule ShortTermDiscountAccruesOnDisposition(p: Person, obl: Integer, d: Date) defeasible {
    label en official "discount on a short-term government obligation accrues only on payment, sale, or disposition (section 454(b))";
    when is_short_term_discount_obligation_454b(obl);
    when first_payment_sale_or_disposition_date(p, obl, d);
    then discount_accrual_date_454b(p, obl, d);
}
pub relation holds_series_e_bond_at_maturity(p: Person, bond: Integer) kind empirical {
    label en official "the taxpayer holds a series E United States savings bond at the date of maturity (section 454(c)(1))";
}
pub relation retains_or_exchanges_bond_in_qualifying_manner(p: Person, bond: Integer) kind empirical {
    label en official "the taxpayer retains the investment in a non-current-income obligation of the United States or exchanges the bond in a section 1037 nonrecognition exchange, under regulations (section 454(c)(2))";
}
pub relation series_e_bond_taxpayer_is_corporation_or_accrual_or_elector(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer is a corporation, computes income under an accrual method for the year, or has a section 454(a) election in effect (section 454(c), last sentence)";
}
pub relation final_redemption_date_454c(p: Person, bond: Integer, d: Date) kind empirical {
    label en official "the date the obligation is finally redeemed";
}
pub relation final_maturity_date_454c(p: Person, bond: Integer, d: Date) kind empirical {
    label en official "the date of final maturity of the obligation";
}
pub relation series_e_increase_includible_on_or_by(p: Person, bond: Integer, d: Date) kind institutional {
    label en official "the increase in redemption value (not previously included) is includible in the taxable year of final redemption or of final maturity, whichever is earlier: the date whose taxable year governs (section 454(c))";
}
@source(IRC_S454_C, quote = "shall be includible in gross income in the taxable year in which the obligation is finally redeemed or in the taxable year of final maturity, whichever is earlier.")
rule SeriesEIncreaseIncludibleAtRedemptionIfEarlier(p: Person, bond: Integer, y: TaxableYear, redeemed: Date, matured: Date) defeasible {
    label en official "final redemption on or before final maturity fixes the inclusion year (section 454(c))";
    when holds_series_e_bond_at_maturity(p, bond);
    when retains_or_exchanges_bond_in_qualifying_manner(p, bond);
    when us.irc.core::year_of(p, y);
    when not_known(series_e_bond_taxpayer_is_corporation_or_accrual_or_elector(p, y));
    when final_redemption_date_454c(p, bond, redeemed);
    when final_maturity_date_454c(p, bond, matured);
    when redeemed <= matured;
    then series_e_increase_includible_on_or_by(p, bond, redeemed);
}
rule SeriesEIncreaseIncludibleAtMaturityIfEarlier(p: Person, bond: Integer, y: TaxableYear, redeemed: Date, matured: Date) defeasible {
    label en official "final maturity before final redemption fixes the inclusion year (section 454(c))";
    when holds_series_e_bond_at_maturity(p, bond);
    when retains_or_exchanges_bond_in_qualifying_manner(p, bond);
    when us.irc.core::year_of(p, y);
    when not_known(series_e_bond_taxpayer_is_corporation_or_accrual_or_elector(p, y));
    when final_redemption_date_454c(p, bond, redeemed);
    when final_maturity_date_454c(p, bond, matured);
    when matured < redeemed;
    then series_e_increase_includible_on_or_by(p, bond, matured);
}

// ===================== Sections 455 and 456 =====================

pub relation receives_prepaid_subscription_income(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "an amount includible in gross income, received in connection with and directly attributable to a liability extending beyond the close of the taxable year, for a subscription to a newspaper, magazine, or other periodical (section 455(d)(1))";
}
pub relation elects_prepaid_subscription_deferral_455(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects section 455 for the trade or business in connection with which the income is received (section 455(c)(1))";
}
pub relation consent_of_secretary_to_455_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the section 455 election (section 455(c)(3)(A))";
}
pub relation first_year_receiving_prepaid_subscription_income(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is the first in which the taxpayer receives prepaid subscription income in the trade or business (section 455(c)(3)(B))";
}
pub relation election_made_by_return_due_date_455(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made not later than the time prescribed for filing the return for the year, including extensions (section 455(c)(3)(B))";
}
pub relation election_timely_or_consented_455(p: Person, y: TaxableYear) kind institutional {
    label en official "the election is made with the Secretary's consent, or without consent in the first year with timely filing (section 455(c)(3))";
}
rule Election455WithConsent(p: Person, y: TaxableYear) defeasible {
    label en official "with the Secretary's consent an election may be made at any time (section 455(c)(3)(A))";
    when consent_of_secretary_to_455_election(p, y);
    then election_timely_or_consented_455(p, y);
}
rule Election455WithoutConsentFirstYear(p: Person, y: TaxableYear) defeasible {
    label en official "without consent, the election is for the first year of receipt and made by the return due date (section 455(c)(3)(B))";
    when first_year_receiving_prepaid_subscription_income(p, y);
    when election_made_by_return_due_date_455(p, y);
    then election_timely_or_consented_455(p, y);
}
pub relation trade_or_business_on_cash_method_455(p: Person, y: TaxableYear) kind empirical {
    label en official "the trade or business computes taxable income on the cash receipts and disbursements method (section 455(c)(1), last sentence)";
}
pub relation election_permitted_455c1(p: Person, y: TaxableYear) kind institutional {
    label en official "an election may be made: timely or consented, and the trade or business is not on the cash method";
}
rule Election455Permitted(p: Person, y: TaxableYear) defeasible {
    label en official "no election for a cash-method trade or business; timing per (c)(3) (section 455(c)(1), (3))";
    when election_timely_or_consented_455(p, y);
    when not_known(trade_or_business_on_cash_method_455(p, y));
    then election_permitted_455c1(p, y);
}
pub relation prepaid_subscription_election_in_effect_455(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 455 election is in effect for the taxable year in which it is first made (section 455(c)(4)); later years are carried by `election_455_continues_next_year` (one-step, G1 family)";
}
@source(IRC_S455_C, quote = "This section shall apply to prepaid subscription income if and only if the taxpayer makes an election under this section")
rule Section455ElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer may elect to defer prepaid subscription income for a trade or business on an accrual (non-cash) method (section 455(c))";
    when elects_prepaid_subscription_deferral_455(p, y);
    then power Section455PrepaidSubscriptionElection {
        holder p;
        over y;
        exercise elects_prepaid_subscription_deferral_455(p, y);
        valid_when election_permitted_455c1(p, y);
        effect create(prepaid_subscription_election_in_effect_455(p, y));
        window [@1954-08-16, infinity);
    };
}
pub relation election_455_continues_next_year(p: Person, y: TaxableYear) kind institutional {
    label en official "the election carries into the next taxable year unless the Secretary consented to revocation (section 455(c)(4)); one step only (TECH-GAPS G2108)";
}
pub relation secretary_consents_to_revocation_455(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to revocation of the election for the taxable year";
}
rule Election455ContinuesUnlessRevoked(p: Person, y: TaxableYear, y_prior: TaxableYear) defeasible {
    label en official "an election stays effective for all subsequent years absent consent to revoke (section 455(c)(4))";
    when preceding_taxable_year_465(y_prior, y);
    when prepaid_subscription_election_in_effect_455(p, y_prior);
    when not_known(secretary_consents_to_revocation_455(p, y));
    then election_455_continues_next_year(p, y);
}
pub relation subscription_income_attributable_to_year_455(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the part of the prepaid subscription income attributable to the taxable year in which the liability exists (section 455(a)); the statute names no allocation formula (regulations) so the per-year portion is a case fact";
}
pub relation prepaid_subscription_income_included_455a(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the prepaid subscription income included in gross income for a taxable year during which the liability exists (section 455(a))";
}
@source(IRC_S455_A, quote = "shall be included in gross income for the taxable years during which the liability described in subsection (d)(2) exists.")
rule PrepaidSubscriptionIncludedYearsOfLiability(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "under the election, subscription income is included year by year while the delivery liability exists (section 455(a))";
    when prepaid_subscription_election_in_effect_455(p, y);
    when subscription_income_attributable_to_year_455(p, y, item, amount);
    then prepaid_subscription_income_included_455a(p, y, item, amount);
}
pub relation liability_to_deliver_ends_in_year_455(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the liability to furnish or deliver the periodical ends in the taxable year (section 455(b)(1))";
}
pub relation taxpayer_dies_or_ceases_to_exist_in_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer dies or ceases to exist in the taxable year (section 455(b)(2), 456(b)(2))";
}
pub relation prepaid_income_not_previously_included(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the part of the prepaid income not includible under subsection (a) for preceding taxable years";
}
pub relation remaining_prepaid_subscription_income_included_455b(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the remaining prepaid subscription income is included in the year the liability ends, or the taxpayer dies or ceases to exist (section 455(b))";
}
@source(IRC_S455_B, quote = "then so much of such income as was not includible in gross income under subsection (a) for preceding taxable years shall be included in gross income for the taxable year in which the liability ends.")
rule RemainingSubscriptionIncludedWhenLiabilityEnds(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "when the delivery liability ends, the remainder is included (section 455(b)(1))";
    when liability_to_deliver_ends_in_year_455(p, y, item);
    when prepaid_income_not_previously_included(p, y, item, amount);
    then remaining_prepaid_subscription_income_included_455b(p, y, item, amount);
}
rule RemainingSubscriptionIncludedOnDeathOrCessation(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "on death or cessation of existence, the remainder is included (section 455(b)(2))";
    when taxpayer_dies_or_ceases_to_exist_in_year(p, y);
    when receives_prepaid_subscription_income(p, y, item);
    when prepaid_income_not_previously_included(p, y, item, amount);
    then remaining_prepaid_subscription_income_included_455b(p, y, item, amount);
}
// (d)(1)-(3), (e): definitions and the established-practice continuation.
pub relation liability_to_furnish_periodical(p: Person, item: Integer) kind empirical {
    label en official "the liability is one to furnish or deliver a newspaper, magazine, or other periodical (section 455(d)(2))";
}
pub relation established_consistent_practice_for_prepaid_subscription_income(p: Person) kind empirical {
    label en official "for years before the first year to which section 455 applies, the taxpayer reported prepaid subscription income under an established and consistent method or practice (section 455(e))";
}
pub relation may_continue_established_subscription_practice_455e(p: Person) kind institutional {
    label en official "the taxpayer may continue that method or practice (section 455(e))";
}
@source(IRC_S455_E, quote = "may continue to report his income for taxable years to which this title applies in accordance with such method or practice.")
rule EstablishedSubscriptionPracticeMayContinue(p: Person) defeasible {
    label en official "an established consistent practice may continue notwithstanding section 455 (section 455(e))";
    when established_consistent_practice_for_prepaid_subscription_income(p);
    then may_continue_established_subscription_practice_455e(p);
}
// Section 456: prepaid dues income of membership organizations.
pub relation is_membership_organization_456e3(p: Person) kind institutional {
    label en official "a corporation, association, federation, or other organization organized without capital stock and with no part of its net earnings distributable to any member (section 456(e)(3))";
}
pub relation organized_without_capital_stock(p: Person) kind empirical {
    label en official "the organization is organized without capital stock of any kind (section 456(e)(3)(A))";
}
pub relation net_earnings_not_distributable_to_members(p: Person) kind empirical {
    label en official "no part of the organization's net earnings is distributable to any member (section 456(e)(3)(B))";
}
rule MembershipOrganizationDefinition(p: Person) defeasible {
    label en official "no capital stock and no distributable net earnings make a membership organization (section 456(e)(3))";
    when organized_without_capital_stock(p);
    when net_earnings_not_distributable_to_members(p);
    then is_membership_organization_456e3(p);
}
pub relation liability_period_months_456(p: Person, item: Integer, months: Integer) kind empirical {
    label en official "the period over which the organization must render services or make membership privileges available (section 456(e)(2))";
}
pub relation is_prepaid_dues_liability_456e2(p: Person, item: Integer) kind institutional {
    label en official "a liability to render services or make available membership privileges over a period not exceeding 36 months, deemed to exist ratably over that period (section 456(e)(2))";
}
@source(IRC_S456_E, quote = "over a period of time which does not exceed 36 months, which liability shall be deemed to exist ratably over the period of time")
rule PrepaidDuesLiabilityUpTo36Months(p: Person, item: Integer, n: Integer) defeasible {
    label en official "a dues liability of at most 36 months qualifies (section 456(e)(2))";
    when liability_period_months_456(p, item, n);
    when n > 0;
    when n <= 36;
    then is_prepaid_dues_liability_456e2(p, item);
}
pub relation receives_prepaid_dues_income(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount includible in gross income received by a membership organization in connection with a liability to render services or make membership privileges available beyond the close of the year (section 456(e)(1))";
}
pub relation elects_prepaid_dues_deferral_456(p: Person, y: TaxableYear) kind empirical {
    label en official "the membership organization elects section 456 for the trade or business (section 456(c)(1))";
}
pub relation trade_or_business_on_cash_method_456(p: Person, y: TaxableYear) kind empirical {
    label en official "the trade or business computes taxable income on the cash method (section 456(c)(1), last sentence)";
}
pub relation election_timely_or_consented_456(p: Person, y: TaxableYear) kind empirical {
    label en official "with the Secretary's consent, or without consent in the first year of receipt and by the return due date (section 456(c)(3))";
}
pub relation election_permitted_456c1(p: Person, y: TaxableYear) kind institutional {
    label en official "a section 456 election may be made: by a membership organization, timely or consented, not on the cash method";
}
rule Election456Permitted(p: Person, y: TaxableYear) defeasible {
    label en official "membership organization, not on the cash method, timely or consented (section 456(c)(1), (3), (e)(3))";
    when is_membership_organization_456e3(p);
    when election_timely_or_consented_456(p, y);
    when not_known(trade_or_business_on_cash_method_456(p, y));
    then election_permitted_456c1(p, y);
}
pub relation prepaid_dues_election_in_effect_456(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 456 election is in effect for the taxable year in which it is first made (section 456(c)(4))";
}
@source(IRC_S456_C, quote = "This section shall apply to prepaid dues income if and only if the taxpayer makes an election under this section")
rule Section456ElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a membership organization may elect to include prepaid dues over the liability period (section 456(c))";
    when elects_prepaid_dues_deferral_456(p, y);
    then power Section456PrepaidDuesElection {
        holder p;
        over y;
        exercise elects_prepaid_dues_deferral_456(p, y);
        valid_when election_permitted_456c1(p, y);
        effect create(prepaid_dues_election_in_effect_456(p, y));
        window [@1971-01-01, infinity);
    };
}
pub relation dues_portion_for_year_456(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the portion of the prepaid dues attributable to the year in which the liability exists: dues are deemed to exist ratably over the period (section 456(e)(2)), supplied per year";
}
pub relation prepaid_dues_income_included_456a(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the prepaid dues income included in gross income for a year during which the liability exists (section 456(a))";
}
@source(IRC_S456_A, quote = "shall be included in gross income for the taxable years during which the liability described in subsection (e)(2) exists.")
rule PrepaidDuesIncludedYearsOfLiability(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "under the election, dues income is included year by year while the liability exists (section 456(a))";
    when prepaid_dues_election_in_effect_456(p, y);
    when dues_portion_for_year_456(p, y, item, amount);
    then prepaid_dues_income_included_456a(p, y, item, amount);
}
pub relation dues_liability_ends_or_taxpayer_ceases_in_year(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dues liability ends in the year, or the taxpayer ceases to exist in the year (section 456(b))";
}
pub relation remaining_prepaid_dues_income_included_456b(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the remaining prepaid dues income is included in the year the liability ends or the taxpayer ceases to exist (section 456(b))";
}
@source(IRC_S456_B, quote = "then so much of such income as was not includible in gross income under subsection (a) for preceding taxable years shall be included in gross income for the taxable year in which the liability ends.")
rule RemainingDuesIncludedWhenLiabilityEndsOrTaxpayerCeases(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "the remainder is included when the liability ends or the taxpayer ceases to exist (section 456(b))";
    when dues_liability_ends_or_taxpayer_ceases_in_year(p, y, item);
    when prepaid_income_not_previously_included(p, y, item, amount);
    then remaining_prepaid_dues_income_included_456b(p, y, item, amount);
}
pub relation dues_received_in_three_preceding_years_that_would_be_includible(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "prepaid dues income received in the 3 taxable years preceding the first election year that would have been included in the election year had the election been effective 3 years earlier (section 456(d)(1))";
}
pub relation dues_additional_amount_also_included_in_prior_three_years(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the additional amount also included in gross income during any of the 3 preceding years (section 456(d)(2))";
}
pub relation transition_additional_dues_included_456d1(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional amount included in gross income for the first election year (section 456(d)(1))";
}
@source(IRC_S456_D, quote = "an additional amount equal to the amount of prepaid dues income received in the 3 taxable years preceding the first taxable year to which such election applies")
rule TransitionAdditionalDuesIncluded(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "in the election year, dues received in the three prior years that the election would have deferred into it are included (section 456(d)(1))";
    when prepaid_dues_election_in_effect_456(p, y);
    when dues_received_in_three_preceding_years_that_would_be_includible(p, y, amount);
    then transition_additional_dues_included_456d1(p, y, amount);
}
pub relation transition_dues_deduction_per_year(p: Person, y_election: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction allowed for the election year and each of the 4 succeeding years: one-fifth of the additional amount, to the extent it was also included in the 3 preceding years (section 456(d)(2)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S456_D, quote = "an amount equal to one-fifth of such additional amount, but only to the extent that such additional amount was also included in the taxpayer's gross income during any of the 3 taxable years preceding")
rule TransitionDuesDeductionOneFifth(p: Person, y: TaxableYear, additional: Money, also: Money) defeasible {
    label en official "deduct one-fifth of the doubly included part of the additional amount in each of five years (section 456(d)(2))";
    when transition_additional_dues_included_456d1(p, y, additional);
    when dues_additional_amount_also_included_in_prior_three_years(p, y, also);
    then transition_dues_deduction_per_year(p, y, div_round(min(additional, also), 5.0, 2, "HALF_UP"));
}

// ===================== Section 458 =====================

pub enum ReturnableMerchandise {
    Magazine;
    Paperback;
    Record;
    label en official "the categories of section 458(b)(1)-(4): each is treated as a separate trade or business";
}
pub relation elects_returns_exclusion_458(p: Person, y: TaxableYear, c: ReturnableMerchandise) kind empirical {
    label en official "an accrual-method taxpayer elects, for the category, not to include income from qualified sales of merchandise returned before the close of the return period (section 458(a), (c)(1))";
}
pub relation is_accrual_method_taxpayer_458(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer is on an accrual method of accounting (bridged from section 446)";
}
rule BridgeAccrualMethod458(p: Person, y: TaxableYear) defeasible {
    label en official "bridges section 446's accrual method into the section 458 election test";
    when applicable_accounting_method(p, y, Accrual);
    then is_accrual_method_taxpayer_458(p, y);
}
pub relation returns_exclusion_election_in_effect_458(p: Person, y: TaxableYear, c: ReturnableMerchandise) kind institutional {
    label en official "the section 458 election is in effect for the category (section 458(c)); it is a method of accounting and made without the Secretary's consent";
}
@source(IRC_S458_A, quote = "A taxpayer who is on an accrual method of accounting may elect not to include in the gross income for the taxable year the income attributable to the qualified sale")
rule Section458ReturnsElectionPower(p: Person, y: TaxableYear, c: ReturnableMerchandise) strict {
    label en official "an accrual-method taxpayer may, without consent, elect the returns exclusion for a merchandise category (section 458(a), (c)(1))";
    when elects_returns_exclusion_458(p, y, c);
    then power Section458ReturnsExclusionElection {
        holder p;
        over y;
        exercise elects_returns_exclusion_458(p, y, c);
        valid_when is_accrual_method_taxpayer_458(p, y);
        effect create(returns_exclusion_election_in_effect_458(p, y, c));
        window [@1978-01-01, infinity);
    };
}
pub relation legal_obligation_to_adjust_price_amount(p: Person, sale: Integer, amount: Money) kind empirical {
    label en official "at the time of sale the taxpayer has a legal obligation to adjust the sales price if not resold: the amount covered (section 458(b)(5)(A), (b)(6)(A))";
}
pub relation price_adjusted_because_not_resold(p: Person, sale: Integer, amount: Money) kind empirical {
    label en official "the sales price is adjusted because of a failure to resell, by the amount agreed before the close of the return period (section 458(b)(5)(B), (b)(6)(B))";
}
pub relation sale_category_458(sale: Integer, c: ReturnableMerchandise) kind empirical {
    label en official "the category of merchandise sold";
}
pub relation is_qualified_sale_458b5(p: Person, sale: Integer) kind institutional {
    label en official "a qualified sale: a legal price-adjustment obligation at the time of sale and an actual adjustment for failure to resell (section 458(b)(5))";
}
rule QualifiedSaleDefinition(p: Person, sale: Integer, obligated: Money, adjusted: Money) defeasible {
    label en official "both (b)(5) conditions make a qualified sale";
    when legal_obligation_to_adjust_price_amount(p, sale, obligated);
    when price_adjusted_because_not_resold(p, sale, adjusted);
    then is_qualified_sale_458b5(p, sale);
}
pub relation amount_excluded_458b6(p: Person, y: TaxableYear, sale: Integer, amount: Money) kind institutional {
    label en official "the amount excluded from gross income for a qualified sale of an elected category: the lesser of the amount covered by the legal obligation and the adjustment agreed before the close of the return period (section 458(b)(6))";
}
@source(IRC_S458_B, quote = "The amount excluded under this section with respect to any qualified sale shall be the lesser of—")
rule AmountExcludedIsLesserOfObligationAndAdjustment(p: Person, y: TaxableYear, sale: Integer, c: ReturnableMerchandise, obligated: Money, adjusted: Money) defeasible {
    label en official "exclusion = min(obligation amount, agreed adjustment) for an elected category (section 458(a), (b)(6))";
    when is_qualified_sale_458b5(p, sale);
    when sale_category_458(sale, c);
    when returns_exclusion_election_in_effect_458(p, y, c);
    when legal_obligation_to_adjust_price_amount(p, sale, obligated);
    when price_adjusted_because_not_resold(p, sale, adjusted);
    then amount_excluded_458b6(p, y, sale, min(obligated, adjusted));
}
pub relation merchandise_return_period_ends_458b7(p: Person, y: TaxableYear, c: ReturnableMerchandise, d: Date) kind institutional {
    label en official "the last day of the merchandise return period: 2 months and 15 days (magazines) or 4 months and 15 days (paperbacks and records) after the close of the taxable year, or a shorter period the taxpayer selects (section 458(b)(7))";
}
pub relation selected_shorter_return_period_end_458(p: Person, y: TaxableYear, c: ReturnableMerchandise, d: Date) kind empirical {
    label en official "the end of a shorter return period selected by the taxpayer (section 458(b)(7)(B))";
}
pub relation has_shorter_return_period_selected(p: Person, y: TaxableYear, c: ReturnableMerchandise) kind institutional {
    label en official "the taxpayer selected a shorter return period for the category (bridge for absence tests without a wildcard)";
}
rule ShorterReturnPeriodBridge(p: Person, y: TaxableYear, c: ReturnableMerchandise) defeasible {
    label en official "a stated shorter period end means a shorter period was selected";
    when selected_shorter_return_period_end_458(p, y, c, _);
    then has_shorter_return_period_selected(p, y, c);
}
@source(IRC_S458_B, quote = "in the case of magazines, the period of 2 months and 15 days first occurring after the close of taxable year, or")
rule ReturnPeriodMagazines(p: Person, y: TaxableYear, year_end: Date) defeasible {
    label en official "magazines: the period ends 2 months and 15 days after year end (section 458(b)(7)(A)(i))";
    when us.irc.core::year_of(p, y);
    when us.irc.core::ends(y, year_end);
    when not_known(has_shorter_return_period_selected(p, y, Magazine));
    then merchandise_return_period_ends_458b7(p, y, Magazine, add_calendar_period(add_calendar_period(year_end, 2 calendar_month), 15 calendar_day));
}
@source(IRC_S458_B, quote = "in the case of paperbacks and records, the period of 4 months and 15 days first occurring after the close of the taxable year.")
rule ReturnPeriodPaperbacks(p: Person, y: TaxableYear, year_end: Date) defeasible {
    label en official "paperbacks: the period ends 4 months and 15 days after year end (section 458(b)(7)(A)(ii))";
    when us.irc.core::year_of(p, y);
    when us.irc.core::ends(y, year_end);
    when not_known(has_shorter_return_period_selected(p, y, Paperback));
    then merchandise_return_period_ends_458b7(p, y, Paperback, add_calendar_period(add_calendar_period(year_end, 4 calendar_month), 15 calendar_day));
}
rule ReturnPeriodRecords(p: Person, y: TaxableYear, year_end: Date) defeasible {
    label en official "records: the period ends 4 months and 15 days after year end (section 458(b)(7)(A)(ii))";
    when us.irc.core::year_of(p, y);
    when us.irc.core::ends(y, year_end);
    when not_known(has_shorter_return_period_selected(p, y, Record));
    then merchandise_return_period_ends_458b7(p, y, Record, add_calendar_period(add_calendar_period(year_end, 4 calendar_month), 15 calendar_day));
}
@source(IRC_S458_B, quote = "The taxpayer may select a shorter period than the applicable period set forth in subparagraph (A).")
rule ReturnPeriodShorterSelected(p: Person, y: TaxableYear, c: ReturnableMerchandise, d: Date) defeasible {
    label en official "a selected shorter return period governs (section 458(b)(7)(B)); a change is a change of accounting method ((C))";
    when selected_shorter_return_period_end_458(p, y, c, d);
    then merchandise_return_period_ends_458b7(p, y, c, d);
}
pub relation spread_period_years_for_magazine_481c_adjustment(p: Person, y: TaxableYear, years: Integer) kind institutional {
    label en official "for an election applying to magazines, the section 481(c) period for a decrease in taxable income is the election year and the 4 succeeding years: 5 taxable years (section 458(d))";
}
@source(IRC_S458_D, quote = "shall be the taxable year for which the election is made and the 4 succeeding taxable years.")
rule MagazineElectionFiveYearSpread(p: Person, y: TaxableYear) defeasible {
    label en official "a magazine election spreads the section 481(a)(2) decrease over 5 years (section 458(d))";
    when returns_exclusion_election_in_effect_458(p, y, Magazine);
    then spread_period_years_for_magazine_481c_adjustment(p, y, 5);
}
// (e): suspense account for paperbacks and records.
pub relation returned_merchandise_that_would_have_been_taken_into_account(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the dollar amount of returned merchandise that would have been taken into account under section 458 for the taxable year, had the section applied (section 458(e)(2)); the year is one of the 3 immediately preceding the first election year";
}
pub relation suspense_account_initial_opening_balance(p: Person, first_year: TaxableYear, amount: Money) kind institutional {
    label en official "the initial opening balance: the largest amount of returned merchandise that would have been taken into account in any of the 3 immediately preceding taxable years (section 458(e)(2))";
}
@source(IRC_S458_E, quote = "The opening balance of the account described in paragraph (1) for the first taxable year to which the election applies shall be the largest dollar amount of returned merchandise")
rule SuspenseAccountInitialOpeningBalance(p: Person, first_year: TaxableYear, y1: TaxableYear, y2: TaxableYear, y3: TaxableYear, a1: Money, a2: Money, a3: Money) defeasible {
    label en official "initial opening balance = the maximum of the three prior-year hypothetical return amounts (section 458(e)(2)); the three preceding years are linked by case facts";
    when preceding_taxable_year_465(y1, first_year);
    when preceding_taxable_year_465(y2, y1);
    when preceding_taxable_year_465(y3, y2);
    when returned_merchandise_that_would_have_been_taken_into_account(p, y1, a1);
    when returned_merchandise_that_would_have_been_taken_into_account(p, y2, a2);
    when returned_merchandise_that_would_have_been_taken_into_account(p, y3, a3);
    then suspense_account_initial_opening_balance(p, first_year, max(a1, max(a2, a3)));
}
pub relation suspense_account_opening_balance(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the opening balance of the suspense account for the taxable year";
}
pub relation amount_excluded_under_458a_for_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount excluded from gross income for the taxable year under subsection (a), for the paperback or record trade or business";
}
pub relation initial_opening_balance_for_account(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the initial opening balance of the account, as fixed for the first election year";
}
pub relation suspense_account_reduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduction of the account: the excess of the opening balance over the amount excluded for the year (section 458(e)(3)(A))";
}
@source(IRC_S458_E, quote = "reduced the excess (if any) of—")
rule SuspenseAccountReduction(p: Person, y: TaxableYear, opening: Money, excluded: Money) defeasible {
    label en official "reduction = opening balance - amount excluded, when positive (section 458(e)(3)(A))";
    when suspense_account_opening_balance(p, y, opening);
    when amount_excluded_under_458a_for_year(p, y, excluded);
    when opening > excluded;
    then suspense_account_reduction(p, y, round(opening - excluded, 2, "HALF_UP"));
}
pub relation suspense_account_increase(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase of the account: the excess of the amount excluded over the opening balance, not above the initial opening balance (section 458(e)(3)(B))";
}
@source(IRC_S458_E, quote = "increased (but not in excess of the initial opening balance) by the excess (if any) of—")
rule SuspenseAccountIncrease(p: Person, y: TaxableYear, opening: Money, excluded: Money, initial: Money) defeasible {
    label en official "increase = min(excluded - opening, initial - opening), when positive (section 458(e)(3)(B))";
    when suspense_account_opening_balance(p, y, opening);
    when amount_excluded_under_458a_for_year(p, y, excluded);
    when initial_opening_balance_for_account(p, y, initial);
    when excluded > opening;
    when initial > opening;
    then suspense_account_increase(p, y, min(round(excluded - opening, 2, "HALF_UP"), round(initial - opening, 2, "HALF_UP")));
}
pub relation suspense_reduction_excluded_from_gross_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "an amount equal to a reduction of the account is excluded from gross income for the year (section 458(e)(4)(A))";
}
rule SuspenseReductionExcluded(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "a reduction is excluded from gross income (section 458(e)(4)(A))";
    when suspense_account_reduction(p, y, amount);
    then suspense_reduction_excluded_from_gross_income(p, y, amount);
}
pub relation suspense_increase_included_in_gross_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "an amount equal to an increase of the account is included in gross income for the year (section 458(e)(4)(B))";
}
rule SuspenseIncreaseIncluded(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "an increase is included in gross income (section 458(e)(4)(B))";
    when suspense_account_increase(p, y, amount);
    then suspense_increase_included_in_gross_income(p, y, amount);
}
pub relation prior_year_hypothetical_return_amount_for_excess(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of returned merchandise that would have been taken into account under (a) for the taxable year preceding the first election year, had the section applied (section 458(e)(4), last sentence)";
}
pub relation initial_balance_excess_included_in_first_year(p: Person, first_year: TaxableYear, amount: Money) kind institutional {
    label en official "if the initial opening balance exceeds the amount for the year before the first election year, the excess is included in gross income for the first election year (section 458(e)(4), last sentence)";
}
@source(IRC_S458_E, quote = "then an amount equal to the amount of such excess shall be included in gross income for such first taxable year.")
rule InitialBalanceExcessIncludedInFirstYear(p: Person, first_year: TaxableYear, prior: TaxableYear, initial: Money, hypothetical: Money) defeasible {
    label en official "an initial balance above the prior-year amount is included in the first election year (section 458(e)(4))";
    when suspense_account_initial_opening_balance(p, first_year, initial);
    when preceding_taxable_year_465(prior, first_year);
    when prior_year_hypothetical_return_amount_for_excess(p, prior, hypothetical);
    when initial > hypothetical;
    then initial_balance_excess_included_in_first_year(p, first_year, round(initial - hypothetical, 2, "HALF_UP"));
}

// ===================== Section 474 =====================

pub relation average_annual_gross_receipts_three_preceding_years_474(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average annual gross receipts of the taxpayer (with all component members of a controlled group treated as one taxpayer, (d)(1)) for the 3 preceding taxable years, applying rules similar to section 448(c)(3) (section 474(c))";
}
pub relation is_eligible_small_business_474(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer is an eligible small business for the taxable year: average annual gross receipts for the 3 preceding years do not exceed $5,000,000 (section 474(c))";
}
@source(IRC_S474_C, quote = "a taxpayer is an eligible small business for any taxable year if the average annual gross receipts of the taxpayer for the 3 preceding taxable years do not exceed $5,000,000.")
rule EligibleSmallBusinessGrossReceipts(p: Person, y: TaxableYear, avg: Money) strict {
    label en official "eligible small business: average gross receipts at most the section 474(c) limit";
    when average_annual_gross_receipts_three_preceding_years_474(p, y, avg);
    when avg <= round(SimplifiedLifoGrossReceiptsLimit, 2, "HALF_UP");
    then is_eligible_small_business_474(p, y);
}
pub relation elects_simplified_dollar_value_lifo_474(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects the simplified dollar-value method of pricing inventories for LIFO purposes (section 474(a))";
}
pub relation simplified_dollar_value_lifo_election_in_effect_474(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 474 election is in effect for the taxable year";
}
@source(IRC_S474_A, quote = "An eligible small business may elect to use the simplified dollar-value method of pricing inventories for purposes of the LIFO method.")
rule Section474ElectionPower(p: Person, y: TaxableYear) strict {
    label en official "an eligible small business may elect simplified dollar-value LIFO without the Secretary's consent (section 474(a), (d)(2)(A))";
    when elects_simplified_dollar_value_lifo_474(p, y);
    then power Section474SimplifiedLifoElection {
        holder p;
        over y;
        exercise elects_simplified_dollar_value_lifo_474(p, y);
        valid_when is_eligible_small_business_474(p, y);
        effect create(simplified_dollar_value_lifo_election_in_effect_474(p, y));
        window [@1987-01-01, infinity);
    };
}
pub relation secretary_consents_to_revocation_474(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to revocation of the election (section 474(d)(2)(B))";
}
pub relation simplified_lifo_applies_in_later_year_474d2B(p: Person, y: TaxableYear) kind institutional {
    label en official "the election applies to each subsequent taxable year in which the taxpayer is an eligible small business, unless the Secretary consents to revocation (section 474(d)(2)(B)); one step from the year before (TECH-GAPS G2108 family)";
}
rule SimplifiedLifoElectionContinues(p: Person, y: TaxableYear, y_prior: TaxableYear) defeasible {
    label en official "an election continues while the taxpayer remains an eligible small business (section 474(d)(2)(B))";
    when preceding_taxable_year_465(y_prior, y);
    when simplified_dollar_value_lifo_election_in_effect_474(p, y_prior);
    when is_eligible_small_business_474(p, y);
    when not_known(secretary_consents_to_revocation_474(p, y));
    then simplified_lifo_applies_in_later_year_474d2B(p, y);
}
pub relation closing_inventory_dollar_value_preceding_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate dollar value of inventory at the close of the taxable year preceding the year of change (section 474(d)(4)(A)(ii))";
}
pub relation year_of_change_474(p: Person, y: TaxableYear) kind empirical {
    label en official "the year of change: the first year to which the election applies, or the first year after it ceases to apply (section 474(d)(4)(B))";
}
pub relation aggregate_inventory_at_beginning_of_year_of_change(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate dollar amount of inventory at the beginning of the year of change equals the aggregate dollar value at the close of the preceding year (section 474(d)(4)(A)(ii))";
}
@source(IRC_S474_D, quote = "the aggregate dollar amount of the taxpayer's inventory as of the beginning of the year of change shall be the same as the aggregate dollar value as of the close of the taxable year preceding the year of change, and")
rule BeginningInventoryEqualsPriorClosing(p: Person, y: TaxableYear, closing: Money) defeasible {
    label en official "the opening inventory of the year of change is last year's closing dollar value (section 474(d)(4)(A)(ii))";
    when year_of_change_474(p, y);
    when closing_inventory_dollar_value_preceding_year(p, y, closing);
    then aggregate_inventory_at_beginning_of_year_of_change(p, y, closing);
}
pub relation controlled_group_member_474(p: Person, group: Integer) kind empirical {
    label en official "the person is a component member of a controlled group: persons treated as a single employer under section 52 (section 474(d)(1)(B))";
}
pub relation member_gross_receipts_474(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a member's gross receipts averaged over the 3 preceding years (input to the group total)";
}
