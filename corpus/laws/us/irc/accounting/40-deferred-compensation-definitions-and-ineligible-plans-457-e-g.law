// Section 457(e) definitions and special rules, 457(f) ineligible plans and
// 457(g)(2)-(3) (stage 3, DECISION-0379 with deontics).
//
// Not modelled (TECH-GAPS G4800+): the indexed applicable dollar amount and the
// indexed length-of-service-award limit (SOURCE_GAP: no IRB or Rev. Proc. value
// is pinned), the regulations named by the text, and the rollover rules of section
// 402(c) and (f) (asserted through the transfer facts).

use self::{
    IRC_S457_E,
    IRC_S457_F,
    IRC_S457_G,
    Person,
    TaxableYear,
    compensation_deferred_under_ineligible_plan,
    eligible_deferred_compensation_plan_457b,
    eligible_employer_governmental_457e1A,
    eligible_employer_tax_exempt_457e1B,
    plan_of_employer_457,
    qualified_governmental_excess_benefit_arrangement_457e14,
    section_457_inclusion,
};

const LengthOfServiceAwardAccrualLimit457: Money = 6000 USD;

// ===================== (e)(3)-(8): definitions =====================

pub relation individual_eligible_to_defer_compensation_under_plan_457e3(individual: Person, plan: Integer) kind empirical {
    label en official "the individual is eligible to defer compensation under the plan (section 457(e)(3))";
}
pub relation participant_457e3(individual: Person, plan: Integer) kind institutional {
    label en official "a participant: an individual who is eligible to defer compensation under the plan (section 457(e)(3))";
}
@source(IRC_S457_E, quote = "The term \"participant\" means an individual who is eligible to defer compensation under the plan.")
rule ParticipantIsEligibleIndividual(individual: Person, plan: Integer) strict {
    label en official "eligibility to defer makes a participant (section 457(e)(3))";
    when individual_eligible_to_defer_compensation_under_plan_457e3(individual, plan);
    then participant_457e3(individual, plan);
}
pub relation is_beneficiary_of_the_participant_457e4(person: Person, participant: Person) kind empirical {
    label en official "the person is a beneficiary of the participant (section 457(e)(4))";
}
pub relation is_estate_of_the_participant_457e4(person: Person, participant: Person) kind empirical {
    label en official "the person is the participant's estate (section 457(e)(4))";
}
pub relation interest_in_plan_derived_from_the_participant_457e4(person: Person, participant: Person) kind empirical {
    label en official "the person's interest in the plan is derived from the participant (section 457(e)(4))";
}
pub relation beneficiary_457e4(person: Person, participant: Person) kind institutional {
    label en official "a beneficiary: a beneficiary of the participant, the participant's estate, or any other person whose interest in the plan is derived from the participant (section 457(e)(4))";
}
rule BeneficiaryByDesignation(person: Person, participant: Person) strict {
    label en official "a beneficiary of the participant (section 457(e)(4))";
    when is_beneficiary_of_the_participant_457e4(person, participant);
    then beneficiary_457e4(person, participant);
}
rule BeneficiaryByEstate(person: Person, participant: Person) strict {
    label en official "the participant's estate (section 457(e)(4))";
    when is_estate_of_the_participant_457e4(person, participant);
    then beneficiary_457e4(person, participant);
}
rule BeneficiaryByDerivedInterest(person: Person, participant: Person) strict {
    label en official "any other person whose interest is derived from the participant (section 457(e)(4))";
    when interest_in_plan_derived_from_the_participant_457e4(person, participant);
    then beneficiary_457e4(person, participant);
}
pub relation compensation_amount_before_discounting_457e6(individual: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the compensation before it is taken into account at its present value (section 457(e)(6))";
}
pub relation present_value_of_compensation_457e6(individual: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the present value of the compensation; the actuarial computation is asserted (section 457(e)(6))";
}
pub relation compensation_taken_into_account_457e6(individual: Person, plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "compensation is taken into account at its present value (section 457(e)(6))";
}
@source(IRC_S457_E, quote = "Compensation shall be taken into account at its present value.")
rule CompensationTakenIntoAccountAtPresentValue(individual: Person, plan: Integer, y: TaxableYear, nominal: Money, pv: Money) defeasible {
    label en official "the present value stands for the compensation (section 457(e)(6))";
    when compensation_amount_before_discounting_457e6(individual, plan, y, nominal);
    when present_value_of_compensation_457e6(individual, plan, y, pv);
    then compensation_taken_into_account_457e6(individual, plan, y, pv);
}
pub relation compensation_earned_by_individual_457e7(individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the compensation earned by the individual for the year, before any community property attribution (section 457(e)(7))";
}
pub relation includible_compensation_without_community_property_457e7(individual: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of includible compensation is determined without regard to community property laws: the earner's own compensation, not split between spouses (section 457(e)(7))";
}
@source(IRC_S457_E, quote = "The amount of includible compensation shall be determined without regard to any community property laws.")
rule IncludibleCompensationIgnoresCommunityProperty(individual: Person, y: TaxableYear, amount: Money) strict {
    label en official "the earner's compensation, whole (section 457(e)(7))";
    when compensation_earned_by_individual_457e7(individual, y, amount);
    then includible_compensation_without_community_property_457e7(individual, y, amount);
}
pub relation gain_from_disposition_of_plan_property_457e8(plan: Integer, y: TaxableYear, gain: Money) kind empirical {
    label en official "the gain from the disposition of property held under the plan (section 457(e)(8))";
}
pub relation income_attributable_to_property_457e8(plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "gains from the disposition of property are income attributable to that property (section 457(e)(8))";
}
@source(IRC_S457_E, quote = "Gains from the disposition of property shall be treated as income attributable to such property.")
rule GainsAreIncomeAttributableToProperty(plan: Integer, y: TaxableYear, gain: Money) strict {
    label en official "a gain is attributable income (section 457(e)(8))";
    when gain_from_disposition_of_plan_property_457e8(plan, y, gain);
    then income_attributable_to_property_457e8(plan, y, gain);
}

// ===================== (e)(9)-(10): made available; transfers =====================

pub relation portion_not_attributable_to_rollovers_457e9Ai(plan: Integer, participant: Person, amount: Money) kind empirical {
    label en official "the portion of the total amount payable that is not attributable to rollover contributions (section 411(a)(11)(D)) (section 457(e)(9)(A)(i))";
}
pub relation dollar_limit_under_411a11A_457e9Ai(y: TaxableYear, amount: Money) kind empirical {
    label en official "the dollar limit under section 411(a)(11)(A) (section 457(e)(9)(A)(i)); the section 411 value is a pending dependency and is asserted";
}
pub relation no_amount_deferred_in_two_year_period_ending_on_distribution_457e9AiiI(plan: Integer, participant: Person) kind empirical {
    label en official "no amount has been deferred under the plan for the participant during the 2-year period ending on the date of the distribution (section 457(e)(9)(A)(ii)(I))";
}
pub relation no_prior_distribution_to_which_457e9A_applied_457e9AiiII(plan: Integer, participant: Person) kind empirical {
    label en official "there has been no prior distribution to the participant under the plan to which subparagraph (A) applied (section 457(e)(9)(A)(ii)(II))";
}
pub relation total_amount_payable_not_made_available_by_small_amount_election_457e9A(plan: Integer, participant: Person, y: TaxableYear) kind institutional {
    label en official "in a tax-exempt plan the total amount payable is not treated as made available merely because the participant may elect it, or the plan may distribute it without consent, when the non-rollover portion is within the dollar limit and (ii)(I)-(II) hold (section 457(e)(9)(A))";
}
@source(IRC_S457_E, quote = "The total amount payable to a participant under the plan shall not be treated as made available merely because the participant may elect to receive such amount (or the plan may distribute such amount without the participant's consent) if—")
rule SmallAmountNotTreatedAsMadeAvailable(plan: Integer, participant: Person, y: TaxableYear, portion: Money, limit: Money) defeasible {
    label en official "portion <= section 411(a)(11)(A) limit, with no deferral in the last 2 years and no earlier distribution of this kind (section 457(e)(9)(A))";
    when portion_not_attributable_to_rollovers_457e9Ai(plan, participant, portion);
    when dollar_limit_under_411a11A_457e9Ai(y, limit);
    when portion <= limit;
    when no_amount_deferred_in_two_year_period_ending_on_distribution_457e9AiiI(plan, participant);
    when no_prior_distribution_to_which_457e9A_applied_457e9AiiII(plan, participant);
    then total_amount_payable_not_made_available_by_small_amount_election_457e9A(plan, participant, y);
}
pub relation plan_not_failing_d_by_457e9A_distribution_457e9A(plan: Integer, participant: Person, y: TaxableYear) kind institutional {
    label en official "a plan does not fail the distribution requirements of (d) by a distribution to which (e)(9)(A) applies (section 457(e)(9)(A), last sentence)";
}
@source(IRC_S457_E, quote = "A plan shall not be treated as failing to meet the distribution requirements of subsection (d) by reason of a distribution to which this subparagraph applies.")
rule PlanNotFailingDByDistributionUnderE9A(plan: Integer, participant: Person, y: TaxableYear) defeasible {
    label en official "the (e)(9)(A) distribution is not a (d) failure (section 457(e)(9)(A))";
    when total_amount_payable_not_made_available_by_small_amount_election_457e9A(plan, participant, y);
    then plan_not_failing_d_by_457e9A_distribution_457e9A(plan, participant, y);
}
pub relation election_to_defer_commencement_made_after_availability_and_before_commencement_457e9Bi(plan: Integer, participant: Person) kind empirical {
    label en official "the election to defer commencement of distributions is made after amounts may be available under (d)(1)(A) and before commencement of the distributions (section 457(e)(9)(B)(i))";
}
pub relation number_of_deferral_of_commencement_elections_457e9Bii(plan: Integer, participant: Person, n: Integer) kind empirical {
    label en official "the number of elections to defer commencement the participant has made (section 457(e)(9)(B)(ii))";
}
pub relation total_amount_payable_not_made_available_by_deferral_election_457e9B(plan: Integer, participant: Person) kind institutional {
    label en official "the total amount payable is not treated as made available merely because the participant may elect to defer commencement of distributions, if the election is timely and only one election is made (section 457(e)(9)(B))";
}
@source(IRC_S457_E, quote = "(ii) the participant may make only 1 such election.")
rule DeferralOfCommencementElectionNotMadeAvailable(plan: Integer, participant: Person, n: Integer) defeasible {
    label en official "a timely, single election to defer commencement (section 457(e)(9)(B))";
    when election_to_defer_commencement_made_after_availability_and_before_commencement_457e9Bi(plan, participant);
    when number_of_deferral_of_commencement_elections_457e9Bii(plan, participant, n);
    when n <= 1;
    then total_amount_payable_not_made_available_by_deferral_election_457e9B(plan, participant);
}
pub relation transfer_between_eligible_plans_457e10(from_plan: Integer, to_plan: Integer, participant: Person, y: TaxableYear) kind empirical {
    label en official "a portion of the participant's amount is transferred from one eligible deferred compensation plan to another (section 457(e)(10))";
}
pub relation transfer_between_eligible_plans_not_includible_457e10(participant: Person, y: TaxableYear) kind institutional {
    label en official "a participant need not include in gross income any portion of the entire amount payable solely by reason of a transfer between eligible deferred compensation plans (section 457(e)(10))";
}
@source(IRC_S457_E, quote = "A participant shall not be required to include in gross income any portion of the entire amount payable to such participant solely by reason of the transfer of such portion from 1 eligible deferred compensation plan to another eligible deferred compensation plan.")
rule TransferBetweenEligiblePlansNotIncludible(from_plan: Integer, to_plan: Integer, participant: Person, y: TaxableYear, e1: Person, e2: Person) defeasible {
    label en official "no inclusion for a plan-to-plan transfer (section 457(e)(10))";
    when transfer_between_eligible_plans_457e10(from_plan, to_plan, participant, y);
    when eligible_deferred_compensation_plan_457b(e1, from_plan);
    when eligible_deferred_compensation_plan_457b(e2, to_plan);
    then transfer_between_eligible_plans_not_includible_457e10(participant, y);
}

// ===================== (e)(11): plans treated as not deferring compensation =====================

pub relation plan_is_bona_fide_vacation_sick_leave_severance_disability_or_death_benefit_plan_457e11Ai(plan: Integer) kind empirical {
    label en official "the plan is a bona fide vacation leave, sick leave, compensatory time, severance pay, disability pay, or death benefit plan (section 457(e)(11)(A)(i)); 'bona fide' is an adjudicated fact";
}
pub relation plan_pays_solely_length_of_service_awards_to_volunteers_457e11Aii(plan: Integer) kind empirical {
    label en official "the plan pays solely length of service awards to bona fide volunteers (or their beneficiaries) on account of qualified services performed by them (section 457(e)(11)(A)(ii))";
}
pub relation volunteer_compensation_only_reimbursement_or_reasonable_allowance_457e11BiI(volunteer: Person) kind empirical {
    label en official "the only compensation is reimbursement for, or a reasonable allowance for, reasonable expenses of the services (section 457(e)(11)(B)(i)(I)); 'reasonable' is an adjudicated fact";
}
pub relation volunteer_compensation_only_reasonable_benefits_and_nominal_fees_457e11BiII(volunteer: Person) kind empirical {
    label en official "the only compensation is reasonable benefits (including length of service awards) and nominal fees customarily paid by eligible employers to volunteers for such services (section 457(e)(11)(B)(i)(II)); 'reasonable' and 'nominal' are adjudicated facts";
}
pub relation bona_fide_volunteer_457e11Bi(volunteer: Person) kind institutional {
    label en official "a bona fide volunteer: an individual whose only compensation for qualified services is (I) reimbursement or a reasonable allowance for expenses, or (II) reasonable customary benefits and nominal fees (section 457(e)(11)(B)(i))";
}
@source(IRC_S457_E, quote = "An individual shall be treated as a bona fide volunteer for purposes of subparagraph (A)(ii) if the only compensation received by such individual for performing qualified services is in the form of—")
rule BonaFideVolunteerByReimbursement(volunteer: Person) defeasible {
    label en official "expense reimbursement only (section 457(e)(11)(B)(i)(I)); the case must show no other compensation, asserted by the absence of other facts";
    when volunteer_compensation_only_reimbursement_or_reasonable_allowance_457e11BiI(volunteer);
    then bona_fide_volunteer_457e11Bi(volunteer);
}
rule BonaFideVolunteerByReasonableBenefits(volunteer: Person) defeasible {
    label en official "reasonable customary benefits and nominal fees only (section 457(e)(11)(B)(i)(II))";
    when volunteer_compensation_only_reasonable_benefits_and_nominal_fees_457e11BiII(volunteer);
    then bona_fide_volunteer_457e11Bi(volunteer);
}
pub relation services_are_fire_fighting_emergency_medical_or_ambulance_457e11C(service: Integer) kind empirical {
    label en official "the services are fire fighting and prevention services, emergency medical services, or ambulance services (section 457(e)(11)(C))";
}
pub relation qualified_services_457e11C(service: Integer) kind institutional {
    label en official "qualified services: fire fighting and prevention services, emergency medical services, and ambulance services (section 457(e)(11)(C))";
}
@source(IRC_S457_E, quote = "the term \"qualified services\" means fire fighting and prevention services, emergency medical services, and ambulance services.")
rule QualifiedServicesDefinition(service: Integer) strict {
    label en official "the three kinds of qualified services (section 457(e)(11)(C))";
    when services_are_fire_fighting_emergency_medical_or_ambulance_457e11C(service);
    then qualified_services_457e11C(service);
}
pub relation length_of_service_award_accruing_for_year_of_service_457e11Bii(plan: Integer, volunteer: Person, amount: Money) kind empirical {
    label en official "the aggregate amount of length of service awards accruing with respect to a year of service for a bona fide volunteer; for a defined benefit plan its actuarial present value (section 457(e)(11)(B)(ii), (iv))";
}
pub relation plan_treated_as_not_providing_deferral_457e11(plan: Integer) kind institutional {
    label en official "the plan is treated as not providing for the deferral of compensation (section 457(e)(11)(A))";
}
@source(IRC_S457_E, quote = "(i) Any bona fide vacation leave, sick leave, compensatory time, severance pay, disability pay, or death benefit plan.")
rule BonaFideLeaveAndSeverancePlansAreNotDeferral(plan: Integer) defeasible {
    label en official "bona fide leave, severance, disability and death benefit plans (section 457(e)(11)(A)(i))";
    when plan_is_bona_fide_vacation_sick_leave_severance_disability_or_death_benefit_plan_457e11Ai(plan);
    then plan_treated_as_not_providing_deferral_457e11(plan);
}
@source(IRC_S457_E, quote = "(ii) Any plan paying solely length of service awards to bona fide volunteers (or their beneficiaries) on account of qualified services performed by such volunteers.")
rule LengthOfServiceAwardPlanIsNotDeferral(plan: Integer, volunteer: Person, accrual: Money) defeasible {
    label en official "a length of service award plan for bona fide volunteers whose annual accrual is at most $6,000 (section 457(e)(11)(A)(ii), (B)(ii)); the pinned amount is unindexed (SOURCE_GAP for the COLA of (B)(iii))";
    when plan_pays_solely_length_of_service_awards_to_volunteers_457e11Aii(plan);
    when bona_fide_volunteer_457e11Bi(volunteer);
    when length_of_service_award_accruing_for_year_of_service_457e11Bii(plan, volunteer, accrual);
    when accrual <= LengthOfServiceAwardAccrualLimit457;
    then plan_treated_as_not_providing_deferral_457e11(plan);
}
pub relation plan_maintained_by_local_educational_agency_457e11Dii(plan: Integer) kind empirical {
    label en official "the plan is a voluntary early retirement incentive plan maintained by a local educational agency (section 8101 of the Elementary and Secondary Education Act) (section 457(e)(11)(D)(ii)(I))";
}
pub relation plan_maintained_by_education_association_457e11Dii(plan: Integer) kind empirical {
    label en official "the plan is a voluntary early retirement incentive plan maintained by an education association principally representing employees of such agencies and described in section 501(c)(5) or (6) and exempt under section 501(a) (section 457(e)(11)(D)(ii)(II))";
}
pub relation applicable_voluntary_early_retirement_incentive_plan_457e11Dii(plan: Integer) kind institutional {
    label en official "an applicable voluntary early retirement incentive plan: maintained by a local educational agency or a qualifying education association (section 457(e)(11)(D)(ii))";
}
rule ApplicableVeripByLocalEducationalAgency(plan: Integer) strict {
    label en official "(D)(ii)(I)";
    when plan_maintained_by_local_educational_agency_457e11Dii(plan);
    then applicable_voluntary_early_retirement_incentive_plan_457e11Dii(plan);
}
rule ApplicableVeripByEducationAssociation(plan: Integer) strict {
    label en official "(D)(ii)(II)";
    when plan_maintained_by_education_association_457e11Dii(plan);
    then applicable_voluntary_early_retirement_incentive_plan_457e11Dii(plan);
}
pub relation verip_payments_are_early_retirement_benefit_or_subsidy_457e11DiI(plan: Integer) kind empirical {
    label en official "the plan makes payments or supplements as an early retirement benefit, a retirement-type subsidy, or a benefit described in the last sentence of section 411(a)(9) (section 457(e)(11)(D)(i)(I))";
}
pub relation verip_payments_coordinated_with_defined_benefit_plan_457e11DiII(plan: Integer) kind empirical {
    label en official "the payments are made in coordination with a section 401(a) defined benefit plan with an exempt trust maintained by an eligible employer of (e)(1)(A) or by such an education association (section 457(e)(11)(D)(i)(II))";
}
pub relation verip_payments_457e11D(plan: Integer, amount: Money) kind empirical {
    label en official "the amount of the payments or supplements";
}
pub relation amount_that_could_have_been_provided_under_the_defined_benefit_plan_457e11Di(plan: Integer, amount: Money) kind empirical {
    label en official "the amount that could otherwise have been provided under the defined benefit plan, determined as if section 411 applied to it (section 457(e)(11)(D)(i))";
}
pub relation verip_treated_as_bona_fide_severance_pay_amount_457e11Di(plan: Integer, amount: Money) kind institutional {
    label en official "the payments are treated as a bona fide severance pay plan to the extent they could have been provided under the defined benefit plan (section 457(e)(11)(D)(i))";
}
@source(IRC_S457_E, quote = "such applicable plan shall be treated for purposes of subparagraph (A)(i) as a bona fide severance pay plan with respect to such payments or supplements to the extent such payments or supplements could otherwise have been provided under such defined benefit plan")
rule VeripTreatedAsSeverancePayPlan(plan: Integer, paid: Money, could: Money) defeasible {
    label en official "severance treatment for min(payments, amount the defined benefit plan could provide) (section 457(e)(11)(D)(i))";
    when applicable_voluntary_early_retirement_incentive_plan_457e11Dii(plan);
    when verip_payments_are_early_retirement_benefit_or_subsidy_457e11DiI(plan);
    when verip_payments_coordinated_with_defined_benefit_plan_457e11DiII(plan);
    when verip_payments_457e11D(plan, paid);
    when amount_that_could_have_been_provided_under_the_defined_benefit_plan_457e11Di(plan, could);
    then verip_treated_as_bona_fide_severance_pay_amount_457e11Di(plan, min(paid, could));
}
pub relation nonelective_deferred_compensation_for_services_not_as_employee_457e12A(plan: Integer) kind empirical {
    label en official "the deferred compensation is nonelective and attributable to services not performed as an employee (section 457(e)(12)(A))";
}
pub relation all_individuals_with_same_relationship_covered_without_variation_457e12B(plan: Integer) kind empirical {
    label en official "all individuals (other than those who have not satisfied an applicable initial service requirement) with the same relationship to the payor are covered under the same plan with no individual variations or options (section 457(e)(12)(B))";
}
pub relation nonelective_deferred_compensation_457e12B(plan: Integer) kind institutional {
    label en official "deferred compensation is nonelective only if all individuals with the same relationship to the payor are covered by the same plan without individual variation (section 457(e)(12)(B))";
}
@source(IRC_S457_E, quote = "For purposes of subparagraph (A), deferred compensation shall be treated as nonelective only if all individuals")
rule NonelectiveDeferredCompensationDefinition(plan: Integer) strict {
    label en official "uniform coverage (section 457(e)(12)(B))";
    when all_individuals_with_same_relationship_covered_without_variation_457e12B(plan);
    then nonelective_deferred_compensation_457e12B(plan);
}
pub relation section_457_does_not_apply_to_nonemployee_nonelective_compensation_457e12A(plan: Integer) kind institutional {
    label en official "section 457 does not apply to nonelective deferred compensation attributable to services not performed as an employee (section 457(e)(12)(A))";
}
@source(IRC_S457_E, quote = "This section shall not apply to nonelective deferred compensation attributable to services not performed as an employee.")
rule Section457DoesNotApplyToNonemployeeNonelectiveCompensation(plan: Integer) defeasible {
    label en official "nonelective compensation for non-employee services is outside section 457 (section 457(e)(12)(A))";
    when nonelective_deferred_compensation_for_services_not_as_employee_457e12A(plan);
    when nonelective_deferred_compensation_457e12B(plan);
    then section_457_does_not_apply_to_nonemployee_nonelective_compensation_457e12A(plan);
}

// ===================== (e)(15)-(17): dollar amount, rollovers, transfers =====================

pub relation applicable_dollar_amount_457e15(y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable dollar amount is $15,000 (A3 parameter, unindexed as pinned; the cost-of-living adjustment of (B) is a SOURCE_GAP) (section 457(e)(15)(A))";
}
@source(IRC_S457_E, quote = "The applicable dollar amount is $15,000.")
rule ApplicableDollarAmountIsFifteenThousand(y: TaxableYear, d: Date) defeasible {
    label en official "$15,000 for any taxable year with a begin date (section 457(e)(15)(A))";
    when us.irc.core::begins(y, d);
    then applicable_dollar_amount_457e15(y, round(ApplicableDollarAmount457, 2, "HALF_UP"));
}
pub relation eligible_rollover_distribution_402c4_457e16Ai(plan: Integer, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a portion of the balance to the employee's credit is paid in an eligible rollover distribution within the meaning of section 402(c)(4) (section 457(e)(16)(A)(i))";
}
pub relation amount_transferred_to_eligible_retirement_plan_402c8B_457e16Aii(plan: Integer, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the employee transfers a portion of the property received to an eligible retirement plan described in section 402(c)(8)(B) (section 457(e)(16)(A)(ii))";
}
pub relation property_other_than_money_distributed_457e16Aiii(plan: Integer, participant: Person, y: TaxableYear) kind empirical {
    label en official "the distribution is of property other than money (section 457(e)(16)(A)(iii))";
}
pub relation transferred_amount_consists_of_the_property_distributed_457e16Aiii(plan: Integer, participant: Person, y: TaxableYear) kind empirical {
    label en official "the amount transferred consists of the property distributed (section 457(e)(16)(A)(iii))";
}
pub relation rollover_amount_not_includible_457e16(plan: Integer, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "a governmental plan's eligible rollover distribution, to the extent transferred to an eligible retirement plan, is not includible in gross income for the year paid; the lesser of the distribution and the amount transferred (section 457(e)(16)(A))";
}
@source(IRC_S457_E, quote = "then such distribution (to the extent so transferred) shall not be includible in gross income for the taxable year in which paid.")
rule RolloverAmountNotIncludibleForCashDistributions(plan: Integer, participant: Person, y: TaxableYear, employer: Person, paid: Money, moved: Money) defeasible {
    label en official "min(paid, transferred) for a money distribution (section 457(e)(16)(A))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when eligible_rollover_distribution_402c4_457e16Ai(plan, participant, y, paid);
    when amount_transferred_to_eligible_retirement_plan_402c8B_457e16Aii(plan, participant, y, moved);
    when not_known(property_other_than_money_distributed_457e16Aiii(plan, participant, y));
    then rollover_amount_not_includible_457e16(plan, participant, y, min(paid, moved));
}
rule RolloverAmountNotIncludibleForPropertyDistributions(plan: Integer, participant: Person, y: TaxableYear, employer: Person, paid: Money, moved: Money) defeasible {
    label en official "min(paid, transferred) for a property distribution only when the property distributed is what is transferred (section 457(e)(16)(A)(iii))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when eligible_rollover_distribution_402c4_457e16Ai(plan, participant, y, paid);
    when amount_transferred_to_eligible_retirement_plan_402c8B_457e16Aii(plan, participant, y, moved);
    when property_other_than_money_distributed_457e16Aiii(plan, participant, y);
    when transferred_amount_consists_of_the_property_distributed_457e16Aiii(plan, participant, y);
    then rollover_amount_not_includible_457e16(plan, participant, y, min(paid, moved));
}
pub relation trustee_to_trustee_transfer_to_governmental_defined_benefit_plan_457e17(plan: Integer, participant: Person, y: TaxableYear) kind empirical {
    label en official "a direct trustee-to-trustee transfer to a defined benefit governmental plan (section 414(d)) (section 457(e)(17))";
}
pub relation transfer_for_permissive_service_credit_415n3A_457e17A(plan: Integer, participant: Person, y: TaxableYear) kind empirical {
    label en official "the transfer is for the purchase of permissive service credit (section 415(n)(3)(A)) (section 457(e)(17)(A))";
}
pub relation transfer_is_repayment_outside_415_by_415k3_457e17B(plan: Integer, participant: Person, y: TaxableYear) kind empirical {
    label en official "the transfer is a repayment to which section 415 does not apply by reason of section 415(k)(3) (section 457(e)(17)(B))";
}
pub relation permissive_service_credit_transfer_not_includible_457e17(plan: Integer, participant: Person, y: TaxableYear) kind institutional {
    label en official "no amount is includible by reason of such a transfer for permissive service credit or such a repayment (section 457(e)(17))";
}
@source(IRC_S457_E, quote = "No amount shall be includible in gross income by reason of a direct trustee-to-trustee transfer to a defined benefit governmental plan (as defined in section 414(d)) if such transfer is—")
rule PermissiveServiceCreditTransferNotIncludible(plan: Integer, participant: Person, y: TaxableYear) defeasible {
    label en official "a trustee-to-trustee transfer for permissive service credit (section 457(e)(17)(A))";
    when trustee_to_trustee_transfer_to_governmental_defined_benefit_plan_457e17(plan, participant, y);
    when transfer_for_permissive_service_credit_415n3A_457e17A(plan, participant, y);
    then permissive_service_credit_transfer_not_includible_457e17(plan, participant, y);
}
rule RepaymentTransferNotIncludible(plan: Integer, participant: Person, y: TaxableYear) defeasible {
    label en official "a trustee-to-trustee transfer that is a repayment outside section 415 (section 457(e)(17)(B))";
    when trustee_to_trustee_transfer_to_governmental_defined_benefit_plan_457e17(plan, participant, y);
    when transfer_is_repayment_outside_415_by_415k3_457e17B(plan, participant, y);
    then permissive_service_credit_transfer_not_includible_457e17(plan, participant, y);
}

// ===================== (f): plans that are not eligible =====================

pub relation plan_of_eligible_employer_provides_deferral_457f1(employer: Person, plan: Integer) kind empirical {
    label en official "the plan of an eligible employer provides for a deferral of compensation, including any agreement or arrangement (section 457(f)(1), (f)(3)(A))";
}
pub relation plan_includes_any_agreement_or_arrangement_457f3A(plan: Integer) kind institutional {
    label en official "the term 'plan' includes any agreement or arrangement (section 457(f)(3)(A))";
}
@source(IRC_S457_F, quote = "The term \"plan\" includes any agreement or arrangement.")
rule PlanIncludesAgreementsAndArrangements(employer: Person, plan: Integer) strict {
    label en official "a plan of an eligible employer providing deferral is a plan whatever its form (section 457(f)(3)(A))";
    when plan_of_eligible_employer_provides_deferral_457f1(employer, plan);
    then plan_includes_any_agreement_or_arrangement_457f3A(plan);
}
pub relation plan_is_401a_plan_with_exempt_trust_457f2A(plan: Integer) kind empirical {
    label en official "the plan is described in section 401(a) and includes a trust exempt from tax under section 501(a) (section 457(f)(2)(A))";
}
pub relation plan_is_403_annuity_plan_or_contract_457f2B(plan: Integer) kind empirical {
    label en official "the plan is an annuity plan or contract described in section 403 (section 457(f)(2)(B))";
}
pub relation plan_portion_is_section_83_transfer_457f2C(plan: Integer, amount: Money) kind empirical {
    label en official "the portion of the plan that consists of a transfer of property described in section 83 (section 457(f)(2)(C))";
}
pub relation plan_portion_is_402b_trust_457f2D(plan: Integer, amount: Money) kind empirical {
    label en official "the portion of the plan that consists of a trust to which section 402(b) applies (section 457(f)(2)(D))";
}
pub relation plan_exempt_as_a_whole_from_457f1_457f2(plan: Integer) kind institutional {
    label en official "paragraph (1) does not apply to a section 401(a) plan with an exempt trust, a section 403 annuity, or a qualified governmental excess benefit arrangement (section 457(f)(2)(A), (B), (E))";
}
@source(IRC_S457_F, quote = "(A) a plan described in section 401(a) which includes a trust exempt from tax under section 501(a),")
rule PlanExemptAsQualifiedTrustPlan(plan: Integer) strict {
    label en official "(f)(2)(A)";
    when plan_is_401a_plan_with_exempt_trust_457f2A(plan);
    then plan_exempt_as_a_whole_from_457f1_457f2(plan);
}
@source(IRC_S457_F, quote = "(B) an annuity plan or contract described in section 403,")
rule PlanExemptAsAnnuityPlan(plan: Integer) strict {
    label en official "(f)(2)(B)";
    when plan_is_403_annuity_plan_or_contract_457f2B(plan);
    then plan_exempt_as_a_whole_from_457f1_457f2(plan);
}
@source(IRC_S457_F, quote = "(E) a qualified governmental excess benefit arrangement described in section 415(m), and")
rule PlanExemptAsQgeba(plan: Integer) strict {
    label en official "(f)(2)(E): a QGEBA of section 415(m)";
    when qualified_governmental_excess_benefit_arrangement_457e14(plan);
    then plan_exempt_as_a_whole_from_457f1_457f2(plan);
}
pub relation applicable_employment_retention_plan_maintained_by_lea_457f4Ci(plan: Integer) kind empirical {
    label en official "the employment retention plan is maintained by a local educational agency (section 8101 of the Elementary and Secondary Education Act) (section 457(f)(4)(C)(i))";
}
pub relation applicable_employment_retention_plan_maintained_by_education_association_457f4Cii(plan: Integer) kind empirical {
    label en official "the plan is maintained by an education association principally representing employees of such agencies, described in section 501(c)(5) or (6) and exempt under section 501(a) (section 457(f)(4)(C)(ii))";
}
pub relation plan_pays_on_termination_to_retain_or_reward_service_457f4D(plan: Integer) kind empirical {
    label en official "the plan pays, upon termination of employment, compensation to an employee of a local educational agency or education association for retaining the services of the employee or rewarding the employee's service (section 457(f)(4)(D))";
}
pub relation employment_retention_plan_457f4D(plan: Integer) kind institutional {
    label en official "an employment retention plan: a plan to pay, upon termination, compensation to an employee of a local educational agency or education association to retain or reward service (section 457(f)(4)(D))";
}
@source(IRC_S457_F, quote = "The term \"employment retention plan\" means a plan to pay, upon termination of employment, compensation to an employee of a local educational agency or education association described in subparagraph (C) for purposes of—")
rule EmploymentRetentionPlanDefinition(plan: Integer) strict {
    label en official "a termination pay plan to retain or reward service (section 457(f)(4)(D))";
    when plan_pays_on_termination_to_retain_or_reward_service_457f4D(plan);
    then employment_retention_plan_457f4D(plan);
}
pub relation applicable_employment_retention_plan_457f4C(plan: Integer) kind institutional {
    label en official "an applicable employment retention plan: an employment retention plan maintained by a local educational agency or a qualifying education association (section 457(f)(4)(C))";
}
@source(IRC_S457_F, quote = "The term \"applicable employment retention plan\" means an employment retention plan maintained by—")
rule ApplicableEmploymentRetentionPlanByAgency(plan: Integer) strict {
    label en official "maintained by a local educational agency (section 457(f)(4)(C)(i))";
    when employment_retention_plan_457f4D(plan);
    when applicable_employment_retention_plan_maintained_by_lea_457f4Ci(plan);
    then applicable_employment_retention_plan_457f4C(plan);
}
rule ApplicableEmploymentRetentionPlanByAssociation(plan: Integer) strict {
    label en official "maintained by an education association (section 457(f)(4)(C)(ii))";
    when employment_retention_plan_457f4D(plan);
    when applicable_employment_retention_plan_maintained_by_education_association_457f4Cii(plan);
    then applicable_employment_retention_plan_457f4C(plan);
}
pub relation benefits_payable_to_participant_under_retention_plan_457f4A(plan: Integer, participant: Person, amount: Money) kind empirical {
    label en official "the benefits payable to the participant under the applicable employment retention plan (section 457(f)(4)(A))";
}
pub relation retention_plan_portion_457f4A(plan: Integer, participant: Person, amount: Money) kind institutional {
    label en official "the portion of an applicable employment retention plan that is excepted: the benefits payable to the participant not in excess of twice the applicable dollar limit (section 457(f)(4)(A))";
}
@source(IRC_S457_F, quote = "The portion of an applicable employment retention plan described in this paragraph with respect to any participant is that portion of the plan which provides benefits payable to the participant not in excess of twice the applicable dollar limit determined under subsection (e)(15).")
rule RetentionPlanPortionUpToTwiceTheDollarLimit(plan: Integer, participant: Person, benefits: Money) defeasible {
    label en official "min(benefits, 2 x applicable dollar amount) (section 457(f)(4)(A))";
    when applicable_employment_retention_plan_457f4C(plan);
    when benefits_payable_to_participant_under_retention_plan_457f4A(plan, participant, benefits);
    then retention_plan_portion_457f4A(plan, participant, min(benefits, round(2.0 * ApplicableDollarAmount457, 2, "HALF_UP")));
}
pub relation year_portion_is_paid_or_made_available_457f4Bi(plan: Integer, participant: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the retention plan portion is paid or otherwise made available to the participant (section 457(f)(4)(B)(i))";
}
pub relation retention_plan_exception_applies_in_year_457f4Bi(plan: Integer, participant: Person, y: TaxableYear) kind institutional {
    label en official "paragraph (2)(F) applies to the portion only for years preceding the year in which it is paid or made available (section 457(f)(4)(B)(i))";
}
@source(IRC_S457_F, quote = "Paragraph (2)(F) shall only apply to the portion of the plan described in subparagraph (A) for years preceding the year in which such portion is paid or otherwise made available to the participant.")
rule RetentionPlanExceptionOnlyForYearsBeforePayment(plan: Integer, participant: Person, y: TaxableYear, paid_year: TaxableYear, d: Date, dp: Date, portion: Money) defeasible {
    label en official "years before the payment year are excepted (section 457(f)(4)(B)(i))";
    when retention_plan_portion_457f4A(plan, participant, portion);
    when year_portion_is_paid_or_made_available_457f4Bi(plan, participant, paid_year);
    when us.irc.core::begins(y, d);
    when us.irc.core::begins(paid_year, dp);
    when d < dp;
    then retention_plan_exception_applies_in_year_457f4Bi(plan, participant, y);
}
pub relation retention_plan_portion_not_deferral_of_compensation_457f4Bii(plan: Integer, participant: Person, y: TaxableYear) kind institutional {
    label en official "a plan is not treated as providing for the deferral of compensation for any year with respect to the excepted retention portion (section 457(f)(4)(B)(ii))";
}
@source(IRC_S457_F, quote = "A plan shall not be treated for purposes of this title as providing for the deferral of compensation for any year with respect to the portion of the plan described in subparagraph (A).")
rule RetentionPlanPortionNotDeferral(plan: Integer, participant: Person, y: TaxableYear, portion: Money) defeasible {
    label en official "the portion is not a deferral for any year (section 457(f)(4)(B)(ii))";
    when retention_plan_portion_457f4A(plan, participant, portion);
    when retention_plan_exception_applies_in_year_457f4Bi(plan, participant, y);
    then retention_plan_portion_not_deferral_of_compensation_457f4Bii(plan, participant, y);
}
pub relation excepted_portion_amount_457f2(plan: Integer, amount: Money) kind empirical {
    label en official "the total amount of the plan's portions excepted from paragraph (1) by (C), (D) or (F) (asserted sum over portions)";
}
pub relation ineligible_plan_457f1(employer: Person, plan: Integer) kind institutional {
    label en official "a plan of an eligible employer that provides for a deferral of compensation, is not an eligible deferred compensation plan, is not treated as no deferral, and is not exempt as a whole under (f)(2) (section 457(f)(1)-(2))";
}
@source(IRC_S457_F, quote = "In the case of a plan of an eligible employer providing for a deferral of compensation, if such plan is not an eligible deferred compensation plan, then—")
rule IneligiblePlanOfGovernmentalEmployer(employer: Person, plan: Integer) defeasible {
    label en official "a governmental employer's deferral plan that is not eligible and not excepted (section 457(f)(1))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_eligible_employer_provides_deferral_457f1(employer, plan);
    when not_known(plan_treated_as_not_providing_deferral_457e11(plan));
    when not_known(eligible_deferred_compensation_plan_457b(employer, plan));
    when not_known(plan_exempt_as_a_whole_from_457f1_457f2(plan));
    then ineligible_plan_457f1(employer, plan);
}
rule IneligiblePlanOfTaxExemptEmployer(employer: Person, plan: Integer) defeasible {
    label en official "a tax-exempt employer's deferral plan that is not eligible and not excepted (section 457(f)(1))";
    when eligible_employer_tax_exempt_457e1B(employer);
    when plan_of_eligible_employer_provides_deferral_457f1(employer, plan);
    when not_known(plan_treated_as_not_providing_deferral_457e11(plan));
    when not_known(eligible_deferred_compensation_plan_457b(employer, plan));
    when not_known(plan_exempt_as_a_whole_from_457f1_457f2(plan));
    then ineligible_plan_457f1(employer, plan);
}
pub relation rights_conditioned_on_future_substantial_services_in_year_457f3B(plan: Integer, y: TaxableYear) kind empirical {
    label en official "the person's rights to the compensation are conditioned upon the future performance of substantial services by any individual, as of the taxable year (section 457(f)(3)(B))";
}
pub relation year_of_plan_457f(plan: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is a year of the plan's participant";
}
pub relation substantial_risk_of_forfeiture_457f3B(plan: Integer, y: TaxableYear) kind institutional {
    label en official "the rights are subject to a substantial risk of forfeiture in the year: conditioned upon the future performance of substantial services (section 457(f)(3)(B))";
}
@source(IRC_S457_F, quote = "The rights of a person to compensation are subject to a substantial risk of forfeiture if such person's rights to such compensation are conditioned upon the future performance of substantial services by any individual.")
rule SubstantialRiskOfForfeitureDefinition(plan: Integer, y: TaxableYear) strict {
    label en official "conditioned on future substantial services (section 457(f)(3)(B))";
    when rights_conditioned_on_future_substantial_services_in_year_457f3B(plan, y);
    then substantial_risk_of_forfeiture_457f3B(plan, y);
}
pub relation year_without_substantial_risk_of_forfeiture_457f(plan: Integer, y: TaxableYear) kind institutional {
    label en official "a taxable year of the plan in which there is no substantial risk of forfeiture";
}
rule YearWithoutSubstantialRisk(plan: Integer, y: TaxableYear) defeasible {
    label en official "no forfeiture condition in the year (section 457(f)(1)(A), (f)(3)(B))";
    when year_of_plan_457f(plan, y);
    when not_known(substantial_risk_of_forfeiture_457f3B(plan, y));
    then year_without_substantial_risk_of_forfeiture_457f(plan, y);
}
pub relation earlier_year_without_substantial_risk_457f(plan: Integer, y: TaxableYear) kind institutional {
    label en official "an earlier taxable year already had no substantial risk of forfeiture (bridge for 'the 1st taxable year')";
}
rule EarlierYearWithoutSubstantialRisk(plan: Integer, y: TaxableYear, y0: TaxableYear, d0: Date, d: Date) defeasible {
    label en official "an earlier year (by begin date) without a forfeiture condition";
    when year_without_substantial_risk_of_forfeiture_457f(plan, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d0 < d;
    then earlier_year_without_substantial_risk_457f(plan, y);
}
pub relation first_year_without_substantial_risk_of_forfeiture_derived_457f1A(plan: Integer, y: TaxableYear) kind institutional {
    label en official "the 1st taxable year in which there is no substantial risk of forfeiture, derived by date comparison instead of the asserted first-year fact (section 457(f)(1)(A))";
}
rule FirstYearWithoutSubstantialRiskDerived(plan: Integer, y: TaxableYear) defeasible {
    label en official "the earliest year without a forfeiture condition (section 457(f)(1)(A))";
    when year_without_substantial_risk_of_forfeiture_457f(plan, y);
    when not_known(earlier_year_without_substantial_risk_457f(plan, y));
    then first_year_without_substantial_risk_of_forfeiture_derived_457f1A(plan, y);
}
pub relation includible_deferred_amount_after_f2_exceptions_457f(plan: Integer, amount: Money) kind institutional {
    label en official "the compensation deferred under the ineligible plan less the portions excepted by (f)(2)(C), (D), (F), floored at zero (JUDGMENT CALL on the floor) (section 457(f)(1)-(2))";
}
rule IncludibleDeferredAmountAfterExceptions(plan: Integer, employer: Person, deferred: Money, excepted: Money) defeasible {
    label en official "deferred amount minus excepted portions";
    when ineligible_plan_457f1(employer, plan);
    when compensation_deferred_under_ineligible_plan(employer, plan, deferred);
    when excepted_portion_amount_457f2(plan, excepted);
    then includible_deferred_amount_after_f2_exceptions_457f(plan, max(deferred - excepted, 0 USD));
}
rule IncludibleDeferredAmountWithoutExcepted(plan: Integer, employer: Person, deferred: Money) defeasible {
    label en official "with no excepted portion the whole deferred amount";
    when ineligible_plan_457f1(employer, plan);
    when compensation_deferred_under_ineligible_plan(employer, plan, deferred);
    when not_known(has_excepted_portion_457f2(plan));
    then includible_deferred_amount_after_f2_exceptions_457f(plan, deferred);
}
pub relation has_excepted_portion_457f2(plan: Integer) kind institutional {
    label en official "the plan has an asserted excepted portion (bridge)";
}
rule HasExceptedPortionBridge(plan: Integer, amount: Money) strict {
    label en official "bridge";
    when excepted_portion_amount_457f2(plan, amount);
    then has_excepted_portion_457f2(plan);
}
@source(IRC_S457_F, quote = "the compensation shall be included in the gross income of the participant or beneficiary for the 1st taxable year in which there is no substantial risk of forfeiture of the rights to such compensation, and")
rule Section457InclusionDerivedIneligiblePlan(employer: Person, plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the includible deferred amount is included for the derived first year without a forfeiture condition (section 457(f)(1)(A)); the stage 2b rule for asserted plans is kept";
    when ineligible_plan_457f1(employer, plan);
    when includible_deferred_amount_after_f2_exceptions_457f(plan, amount);
    when first_year_without_substantial_risk_of_forfeiture_derived_457f1A(plan, y);
    then section_457_inclusion(employer, plan, y, amount);
}
pub relation amount_made_available_under_ineligible_plan_457f1B(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount made available under the ineligible plan to a participant or beneficiary in the year (section 457(f)(1)(B))";
}
pub relation tax_treatment_of_amount_made_available_determined_under_72_457f1B(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax treatment of an amount made available under the ineligible plan is determined under section 72 (annuities and distributions); section 72 is the owner of the computation (section 457(f)(1)(B))";
}
@source(IRC_S457_F, quote = "(B) the tax treatment of any amount made available under the plan to a participant or beneficiary shall be determined under section 72 (relating to annuities, etc.).")
rule AmountMadeAvailableUnderIneligiblePlanFollowsSection72(employer: Person, plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "section 72 governs the amounts made available (section 457(f)(1)(B))";
    when ineligible_plan_457f1(employer, plan);
    when amount_made_available_under_ineligible_plan_457f1B(employer, plan, y, amount);
    then tax_treatment_of_amount_made_available_determined_under_72_457f1B(employer, plan, y, amount);
}

// ===================== (g)(2)-(3): the trust =====================

pub relation trust_holds_governmental_plan_assets_457g1(trust: Person, plan: Integer) kind empirical {
    label en official "the trust holds the assets and income of a governmental plan for the exclusive benefit of participants and beneficiaries (section 457(g)(1))";
}
pub relation governmental_plan_trust_treated_as_exempt_501a_457g2A(trust: Person) kind institutional {
    label en official "a section 457(g)(1) trust is treated as an organization exempt from taxation under section 501(a) (section 457(g)(2)(A))";
}
@source(IRC_S457_G, quote = "(A) a trust described in paragraph (1) shall be treated as an organization exempt from taxation under section 501(a), and")
rule GovernmentalPlanTrustIsExempt(trust: Person, plan: Integer) defeasible {
    label en official "the trust is an exempt organization (section 457(g)(2)(A))";
    when trust_holds_governmental_plan_assets_457g1(trust, plan);
    then governmental_plan_trust_treated_as_exempt_501a_457g2A(trust);
}
pub relation trust_amounts_includible_only_as_section_457_provides_457g2B(trust: Person) kind institutional {
    label en official "amounts in the trust are includible in the gross income of participants and beneficiaries only to the extent and at the time provided in section 457, notwithstanding any other provision of the title (section 457(g)(2)(B))";
}
@source(IRC_S457_G, quote = "notwithstanding any other provision of this title, amounts in the trust shall be includible in the gross income of participants and beneficiaries only to the extent, and at the time, provided in this section.")
rule TrustAmountsIncludibleOnlyAsSection457Provides(trust: Person, plan: Integer) defeasible {
    label en official "section 457 alone times the inclusion (section 457(g)(2)(B))";
    when trust_holds_governmental_plan_assets_457g1(trust, plan);
    then trust_amounts_includible_only_as_section_457_provides_457g2B(trust);
}
pub relation custodial_account_or_contract_described_in_401f_457g3(account: Integer, plan: Integer) kind empirical {
    label en official "the custodial account or contract is described in section 401(f) (section 457(g)(3))";
}
pub relation custodial_account_treated_as_trust_457g3(account: Integer, plan: Integer) kind institutional {
    label en official "a custodial account or contract described in section 401(f) is treated as a trust, under rules similar to section 401(f) (section 457(g)(3))";
}
@source(IRC_S457_G, quote = "For purposes of this subsection, custodial accounts and contracts described in section 401(f) shall be treated as trusts under rules similar to the rules under section 401(f).")
rule CustodialAccountTreatedAsTrust(account: Integer, plan: Integer) defeasible {
    label en official "custodial accounts and contracts are trusts (section 457(g)(3))";
    when custodial_account_or_contract_described_in_401f_457g3(account, plan);
    then custodial_account_treated_as_trust_457g3(account, plan);
}
