// Section 453 — Installment method. Stage 1 (IRC-07), priority section.
// Scope: (a) the general rule that installment-sale income is taken into
// account under the installment method; (b) the "installment sale"
// definition and its two exceptions (dealer dispositions, inventory
// property); (c) the installment-method gross-profit-ratio computation with
// exact Decimal intermediate values; (d) the election out, as a power, with
// (d)(3) revocation requiring the Secretary's consent. (e)-(l) (related-
// person second dispositions, definitions, related-party depreciable
// property, interest on deferred tax liability's own section 453A,
// recapture income, dealer/exclusion carve-outs) are STAGE 2 for this
// module — recorded as `not_done` in the coverage rows, not modelled.

use self::{
    IRC_S453_A,
    IRC_S453_B,
    IRC_S453_C,
    IRC_S453_D,
    IRC_S453_E,
    IRC_S453_G,
    IRC_S453_I,
    IRC_S453_L,
    Person,
    Secretary,
    TaxableYear,
};

pub relation disposition_of_property(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "a disposition of property (section 453(b)(1))";
}
pub relation at_least_one_payment_after_close_of_disposition_year(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "at least 1 payment on the disposition is to be received after the close of the taxable year in which the disposition occurs (section 453(b)(1))";
}
pub relation is_dealer_disposition(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "the disposition is a dealer disposition as defined in section 453(l) (section 453(b)(2)(A))";
}
pub relation is_inventoriable_personal_property(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "the disposition is of personal property of a kind required to be included in the taxpayer's inventory if on hand at the close of the taxable year (section 453(b)(2)(B))";
}
pub relation is_installment_sale(p: Person, y: TaxableYear, disposition: Integer) kind institutional {
    label en official "the disposition is an installment sale (section 453(b))";
}
@source(IRC_S453_B, quote = "The term \"installment sale\" means a disposition of property where at least 1 payment is to be received after the close of the taxable year in which the disposition occurs.")
rule InstallmentSaleDefinition(p: Person, y: TaxableYear, disposition: Integer) defeasible {
    label en official "a disposition of property with at least one payment due after the close of the disposition year is an installment sale, unless it is a dealer disposition or inventoriable personal property (section 453(b))";
    when disposition_of_property(p, y, disposition);
    when at_least_one_payment_after_close_of_disposition_year(p, y, disposition);
    unless is_dealer_disposition(p, y, disposition);
    unless is_inventoriable_personal_property(p, y, disposition);
    then is_installment_sale(p, y, disposition);
}

// (a): the installment method applies to installment-sale income, subject to
// the (d) election out.
pub relation reports_under_installment_method(p: Person, y: TaxableYear, disposition: Integer) kind institutional {
    label en official "income from the installment sale is taken into account under the installment method (section 453(a))";
}
@source(IRC_S453_A, quote = "Except as otherwise provided in this section, income from an installment sale shall be taken into account for purposes of this title under the installment method.")
rule InstallmentMethodAppliesByDefault(p: Person, y: TaxableYear, disposition: Integer) defeasible {
    label en official "income from an installment sale is taken into account under the installment method, unless the taxpayer has elected out (section 453(a))";
    when is_installment_sale(p, y, disposition);
    unless section_453d_election_out_in_effect(p, y, disposition);
    then reports_under_installment_method(p, y, disposition);
}

// (c): the gross-profit-ratio computation, with intermediate values.
pub relation gross_profit_on_disposition(p: Person, disposition: Integer, amount: Money) kind institutional {
    label en official "the gross profit realized or to be realized when payment is completed, on the disposition (section 453(c))";
}
pub relation total_contract_price(p: Person, disposition: Integer, amount: Money) kind institutional {
    label en official "the total contract price of the disposition (section 453(c))";
}
pub relation payments_received_in_year(p: Person, y: TaxableYear, disposition: Integer, amount: Money) kind empirical {
    label en official "the payments received in the taxable year on account of the disposition (section 453(c))";
}
// Intermediate value: the gross-profit ratio itself, so a scenario can assert
// or check it independently of the final recognized-income figure.
pub relation installment_gross_profit_ratio(p: Person, disposition: Integer, ratio: Decimal) kind institutional {
    label en official "the proportion the gross profit (realized or to be realized when payment is completed) bears to the total contract price (section 453(c))";
}
@source(IRC_S453_C, quote = "the gross profit (realized or to be realized when payment is completed) bears to the total contract price")
rule GrossProfitRatioComputation(p: Person, disposition: Integer, gross_profit: Money, contract_price: Money) strict {
    label en official "the installment gross-profit ratio is the gross profit divided by the total contract price (section 453(c))";
    when gross_profit_on_disposition(p, disposition, gross_profit);
    when total_contract_price(p, disposition, contract_price);
    // `Money / Money` under `/` yields Decimal only when the quotient's
    // denominator is 10-smooth (§58, errata E-0083); `div_round` guarantees
    // Decimal on every input, at a precision the statute does not itself
    // fix (a judgment call — 6 places, HALF_UP, recorded here).
    then installment_gross_profit_ratio(p, disposition, div_round(gross_profit, contract_price, 6, "HALF_UP"));
}
pub relation installment_gain_recognized(p: Person, y: TaxableYear, disposition: Integer, amount: Money) kind institutional {
    label en official "the income recognized for the taxable year from the disposition: that proportion of the payments received in that year which the gross profit bears to the total contract price (section 453(c))";
}
@source(IRC_S453_C, quote = "the income recognized for any taxable year from a disposition is that proportion of the payments received in that year which the gross profit (realized or to be realized when payment is completed) bears to the total contract price")
rule InstallmentGainRecognizedComputation(p: Person, y: TaxableYear, disposition: Integer, ratio: Decimal, payments: Money) defeasible {
    label en official "the recognized gain for the year is the payments received in that year multiplied by the installment gross-profit ratio (section 453(c))";
    when reports_under_installment_method(p, y, disposition);
    when installment_gross_profit_ratio(p, disposition, ratio);
    when payments_received_in_year(p, y, disposition, payments);
    then installment_gain_recognized(p, y, disposition, round(payments * ratio, 2, "HALF_UP"));
}

// (d): election out, as a power of the taxpayer; revocation requires the
// Secretary's consent — a second power, held by the Secretary, over the
// SAME election.
pub relation elects_out_of_installment_method(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "the taxpayer elects to have section 453(a) not apply to the disposition (section 453(d)(1))";
}
pub relation election_out_made_by_return_due_date(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "the election out is made on or before the due date (including extensions) for filing the return for the taxable year in which the disposition occurs (section 453(d)(2))";
}
pub relation section_453d_election_out_in_effect(p: Person, y: TaxableYear, disposition: Integer) kind institutional {
    label en official "the section 453(d) election out of the installment method is in effect for the disposition (section 453(d)(1))";
}
@source(IRC_S453_D, quote = "Subsection (a) shall not apply to any disposition if the taxpayer elects to have subsection (a) not apply to such disposition.")
rule Section453ElectionOutPower(p: Person, y: TaxableYear, disposition: Integer) strict {
    label en official "a taxpayer may elect to have the installment method not apply to a disposition, timely made on or before the return's due date (section 453(d)(1)-(2))";
    when is_installment_sale(p, y, disposition);
    then power Section453ElectionOut {
        holder p;
        over disposition;
        exercise elects_out_of_installment_method(p, y, disposition);
        valid_when election_out_made_by_return_due_date(p, y, disposition);
        effect create(section_453d_election_out_in_effect(p, y, disposition));
        window [@1980-10-19, infinity);
    };
}
pub relation requests_revocation_of_453d_election(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "the taxpayer requests revocation of its section 453(d) election out (implied by section 453(d)(3))";
}
pub relation secretary_consents_to_revocation_of_453d_election(p: Person, y: TaxableYear, disposition: Integer) kind empirical {
    label en official "the Secretary consents to revocation of the section 453(d) election out (section 453(d)(3))";
}
pub relation section_453d_election_revoked(p: Person, y: TaxableYear, disposition: Integer) kind institutional {
    label en official "the section 453(d) election out has been revoked with the Secretary's consent (section 453(d)(3))";
}
@source(IRC_S453_D, quote = "An election under paragraph (1) with respect to any disposition may be revoked only with the consent of the Secretary.")
rule Section453RevocationRequiresSecretaryConsentPower(p: Person, y: TaxableYear, disposition: Integer) strict {
    label en official "an election out under section 453(d)(1) may be revoked ONLY with the consent of the Secretary (section 453(d)(3))";
    when section_453d_election_out_in_effect(p, y, disposition);
    when requests_revocation_of_453d_election(p, y, disposition);
    then power Section453RevocationConsent {
        holder Secretary;
        over disposition;
        exercise secretary_consents_to_revocation_of_453d_election(p, y, disposition);
        valid_when requests_revocation_of_453d_election(p, y, disposition);
        effect create(section_453d_election_revoked(p, y, disposition));
        window [@1980-10-19, infinity);
    };
}

// (e) second dispositions by related persons. (f) definitions, (h)
// liquidation shareholders, (j) regulations, (k) revolving-credit/publicly-
// traded current inclusion: NOT DONE this stage (TECH-GAPS G329) —
// `is_dealer_disposition`/`is_related_person_453` above remain case-asserted
// facts; the derived `dealer_disposition_under_453l` relation below is a
// PARALLEL derivation from (l)(1)-(2), not yet wired to replace the
// case-asserted defeater in `InstallmentSaleDefinition` (a disclosed,
// deliberate non-rewire to avoid regressing already-compiling stage 1 code
// under this round's time budget).

pub relation is_related_person_453(p: Person, related: Person) kind empirical {
    label en official "a person related to the first-disposition seller for purposes of section 453(e): stock attribution under section 318(a) (other than paragraph (4)) or a section 267(b) relationship (section 453(f)(1)) — read as a case fact; the exact section 318(a)/267(b) derivation is NOT wired to us.irc.deductions::related_persons this stage (TECH_GAP G329)";
}
pub relation first_disposition_453e(seller: Person, related: Person, disposition: Integer, on: Date) kind empirical {
    label en official "the seller disposes of property to a related person: the first disposition (section 453(e)(1)(A))";
}
pub relation second_disposition_453e(related: Person, disposition: Integer, second_disposition: Integer, on: Date) kind empirical {
    label en official "the related person disposes of the property before the seller has received all payments on the first disposition: the second disposition (section 453(e)(1)(B))";
}
pub relation all_payments_received_on_first_disposition(seller: Person, disposition: Integer, on: Date) kind empirical {
    label en official "the seller has received all payments with respect to the first disposition, as of the given date (section 453(e)(1)(B), negated as the gate)";
}
pub relation is_marketable_security_453(disposition: Integer) kind empirical {
    label en official "the property disposed of is a marketable security: one for which, as of the disposition date, there was a market on an established securities market or otherwise (section 453(f)(2)) — the 2-year cutoff of (e)(2)(A) does not apply to marketable securities";
}
pub relation second_disposition_within_two_years(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, first_on: Date, second_on: Date) kind institutional {
    label en official "the second disposition occurred not more than 2 years after the first disposition (section 453(e)(2)(A)) — the (e)(2)(B) suspension for a substantially diminished risk of ownership is NOT modelled (TECH_GAP G329)";
}
@source(IRC_S453_E, quote = "paragraph (1) shall apply only if the date of the second disposition is not more than 2 years after the date of the first disposition")
rule SecondDispositionWithinTwoYearsComputation(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, first_on: Date, second_on: Date) strict {
    label en official "the 2-year cutoff is measured from the exact date of the first disposition to the exact date of the second disposition (section 453(e)(2)(A))";
    when first_disposition_453e(seller, related, disposition, first_on);
    when second_disposition_453e(related, disposition, second_disposition, second_on);
    when second_on <= add_calendar_period(first_on, 24 calendar_month);
    then second_disposition_within_two_years(seller, related, disposition, second_disposition, first_on, second_on);
}
external judgment relation tax_avoidance_not_a_principal_purpose_453e7(seller: Person, related: Person, disposition: Integer) {
    authority Secretary;
    label en official "it is established to the satisfaction of the Secretary that neither the first nor the second disposition had as one of its principal purposes the avoidance of Federal income tax (section 453(e)(7))";
}
pub relation second_disposition_amount_realized(related: Person, disposition: Integer, second_disposition: Integer, amount: Money) kind empirical {
    label en official "the amount realized (or, if not a sale or exchange, the fair market value under (e)(4)) with respect to the second disposition (section 453(e)(1), (e)(4))";
}
pub relation amount_treated_as_received_by_first_seller_453e(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount realized on the second disposition is treated as received by the person making the first disposition, at the time of the second disposition (section 453(e)(1)) — the (e)(3) multi-year running limitation (capped at total contract price for the first disposition, minus payments and prior (e)(1) amounts already accounted for) is NOT modelled as a running ledger this stage; a single-year case-supplied cap is used instead (TECH_GAP G329, same class as the look-back/carryforward gaps elsewhere in this registry)";
}
pub relation second_disposition_year(disposition: Integer, second_disposition: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the second disposition occurs (section 453(e)(1))";
}
@source(IRC_S453_E, quote = "the amount realized with respect to such second disposition shall be treated as received at the time of the second disposition by the person making the first disposition")
rule AmountTreatedAsReceivedOnSecondDisposition(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, y: TaxableYear, first_on: Date, second_on: Date, amount: Money) defeasible {
    label en official "the amount realized on a related-person second disposition (within the 2-year cutoff, or of a marketable security) is treated as received by the first seller, unless established that tax avoidance was not a principal purpose (section 453(e)(1), (e)(2), (e)(7))";
    when second_disposition_within_two_years(seller, related, disposition, second_disposition, first_on, second_on) and not_known(is_marketable_security_453(disposition)) and not_known(tax_avoidance_not_a_principal_purpose_453e7(seller, related, disposition));
    when second_disposition_amount_realized(related, disposition, second_disposition, amount);
    when second_disposition_year(disposition, second_disposition, y);
    then amount_treated_as_received_by_first_seller_453e(seller, related, disposition, second_disposition, y, amount);
}
@source(IRC_S453_E, quote = "Except in the case of marketable securities, paragraph (1) shall apply only if the date of the second disposition is not more than 2 years after the date of the first disposition.")
rule AmountTreatedAsReceivedOnSecondDispositionMarketableSecurity(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "for a marketable security, the 2-year cutoff of (e)(2)(A) does not apply: the amount realized on the second disposition is treated as received by the first seller whenever it occurs, unless tax avoidance is not a principal purpose (section 453(e)(1)-(2), (e)(7))";
    when is_related_person_453(seller, related) and is_marketable_security_453(disposition) and not_known(tax_avoidance_not_a_principal_purpose_453e7(seller, related, disposition));
    when second_disposition_amount_realized(related, disposition, second_disposition, amount);
    when second_disposition_year(disposition, second_disposition, y);
    then amount_treated_as_received_by_first_seller_453e(seller, related, disposition, second_disposition, y, amount);
}

// (g): sale of depreciable property to a controlled entity — the (a)
// installment method is denied and all payments are treated as received in
// the year of disposition, unless tax avoidance is not a principal purpose.
pub relation is_depreciable_property_453(disposition: Integer) kind empirical {
    label en official "property of a character which, in the hands of the transferee, is subject to the section 167 depreciation allowance (section 453(f)(7))";
}
pub relation is_related_person_453g(seller: Person, buyer: Person) kind empirical {
    label en official "related persons within the meaning of section 1239(b), including 2 or more partnerships related under section 707(b)(1)(B) (section 453(g)(3)) — read as a case fact";
}
external judgment relation tax_avoidance_not_a_principal_purpose_453g2(seller: Person, buyer: Person, disposition: Integer) {
    authority Secretary;
    label en official "it is established to the satisfaction of the Secretary that the disposition did not have as one of its principal purposes the avoidance of Federal income tax (section 453(g)(2))";
}
pub relation installment_method_denied_453g(seller: Person, buyer: Person, disposition: Integer) kind institutional {
    label en official "section 453(a) does not apply to the installment sale of depreciable property between related persons (section 453(g)(1)(A)), unless tax avoidance was not a principal purpose (section 453(g)(2))";
}
@source(IRC_S453_G, quote = "subsection (a) shall not apply")
rule InstallmentMethodDeniedForRelatedPartyDepreciableProperty(seller: Person, buyer: Person, disposition: Integer) defeasible {
    label en official "the installment method does not apply to a sale of depreciable property between related persons, unless established that tax avoidance was not a principal purpose (section 453(g)(1)(A), (g)(2))";
    when is_depreciable_property_453(disposition);
    when is_related_person_453g(seller, buyer);
    unless tax_avoidance_not_a_principal_purpose_453g2(seller, buyer, disposition);
    then installment_method_denied_453g(seller, buyer, disposition);
}
pub relation all_payments_to_be_received_453g(seller: Person, buyer: Person, disposition: Integer, amount: Money) kind empirical {
    label en official "all payments to be received on the sale, within the meaning of section 453(f)(8) (section 453(g)(1)(B)(i)) — the (g)(1)(B)(ii) contingent-payment ratable-basis-recovery exception is NOT modelled (TECH_GAP G329)";
}
pub relation payments_deemed_received_in_year_of_disposition_453g(seller: Person, buyer: Person, disposition: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "all payments to be received are treated as received in the year of the disposition (section 453(g)(1)(B)(i))";
}
@source(IRC_S453_G, quote = "except as provided in clause (ii), all payments to be received shall be treated as received in the year of the disposition")
rule PaymentsDeemedReceivedInYearOfDisposition453g(seller: Person, buyer: Person, disposition: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "all payments to be received on a denied-installment-method depreciable-property sale are deemed received in the year of disposition (section 453(g)(1)(B)(i))";
    when installment_method_denied_453g(seller, buyer, disposition);
    when disposition_of_property(seller, y, disposition);
    when all_payments_to_be_received_453g(seller, buyer, disposition, amount);
    then payments_deemed_received_in_year_of_disposition_453g(seller, buyer, disposition, y, amount);
}

// (i): recapture income recognized in the year of disposition; gain in
// excess of recapture income takes the installment method.
pub relation recapture_income_1245_1250(p: Person, disposition: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount which would be treated as ordinary income under section 1245 or 1250 (or section 751 as it relates to either) if all payments to be received were received in the year of disposition (section 453(i)(2)) — read as a case fact; the section 1245/1250 recapture computation itself is us.irc.property-transactions' own norm, not wired in this stage (EXTERNAL_DEPENDENCY, accounting.deps.json)";
}
pub relation recapture_income_recognized_in_disposition_year(p: Person, y: TaxableYear, disposition: Integer, amount: Money) kind institutional {
    label en official "recapture income is recognized in the year of disposition, notwithstanding the installment method (section 453(i)(1)(A))";
}
@source(IRC_S453_I, quote = "notwithstanding subsection (a), any recapture income shall be recognized in the year of the disposition, and")
rule RecaptureIncomeRecognizedInDispositionYear(p: Person, y: TaxableYear, disposition: Integer, amount: Money) strict {
    label en official "recapture income on an installment sale is recognized in the year of disposition, not deferred under the installment method (section 453(i)(1)(A))";
    when disposition_of_property(p, y, disposition);
    when recapture_income_1245_1250(p, disposition, amount);
    when amount > 0.00 USD;
    then recapture_income_recognized_in_disposition_year(p, y, disposition, amount);
}
pub relation gross_profit_in_excess_of_recapture_income(p: Person, disposition: Integer, amount: Money) kind institutional {
    label en official "gain in excess of recapture income, taken into account under the installment method (section 453(i)(1)(B))";
}
@source(IRC_S453_I, quote = "any gain in excess of the recapture income shall be taken into account under the installment method")
rule GrossProfitInExcessOfRecaptureIncome(p: Person, disposition: Integer, gross_profit: Money, recapture: Money) strict {
    label en official "gross profit in excess of recapture income remains subject to the installment method (section 453(i)(1)(B))";
    when gross_profit_on_disposition(p, disposition, gross_profit);
    when recapture_income_1245_1250(p, disposition, recapture);
    when gross_profit > recapture;
    then gross_profit_in_excess_of_recapture_income(p, disposition, gross_profit - recapture);
}

// (l): dealer disposition definition — derived in parallel (see module
// header note on why it is not yet wired to the (b)(2)(A) defeater above).
pub relation regularly_sells_personal_property_on_installment_plan(p: Person) kind empirical {
    label en official "the person regularly sells or otherwise disposes of personal property of the same type on the installment plan (section 453(l)(1)(A))";
}
pub relation disposes_personal_property_453l(p: Person, disposition: Integer) kind empirical {
    label en official "the disposition is of personal property (section 453(l)(1)(A))";
}
pub relation held_real_property_for_sale_to_customers(p: Person, disposition: Integer) kind empirical {
    label en official "real property held by the taxpayer for sale to customers in the ordinary course of the taxpayer's trade or business (section 453(l)(1)(B))";
}
pub relation is_farm_property_453l(disposition: Integer) kind empirical {
    label en official "property used or produced in the trade or business of farming within the meaning of section 2032A(e)(4) or (5) (section 453(l)(2)(A) exception)";
}
pub relation elects_timeshare_residential_lot_interest_453l3(p: Person, disposition: Integer) kind empirical {
    label en official "the taxpayer elects to have section 453(l)(3) (interest on timeshares and residential lots) apply, excluding the disposition from dealer-disposition treatment (section 453(l)(2)(B)(i))";
}
pub relation dealer_disposition_under_453l(p: Person, disposition: Integer) kind institutional {
    label en official "a dealer disposition under section 453(l): personal property regularly sold on the installment plan, or real property held for sale to customers, EXCLUDING farm property and an elected timeshare/residential-lot disposition (section 453(l)(1)-(2)) — the (l)(2)(C) carrying-charges rule and (l)(3) timeshare-interest computation are NOT modelled (TECH_GAP G329)";
}
@source(IRC_S453_L, quote = "Any disposition of personal property by a person who regularly sells or otherwise disposes of personal property of the same type on the installment plan.")
rule DealerDispositionPersonalProperty(p: Person, disposition: Integer) defeasible {
    label en official "a disposition of personal property regularly sold on the installment plan is a dealer disposition, unless it is farm property or an elected timeshare/residential-lot disposition (section 453(l)(1)(A), (l)(2))";
    when regularly_sells_personal_property_on_installment_plan(p);
    when disposes_personal_property_453l(p, disposition) and not_known(is_farm_property_453l(disposition)) and not_known(elects_timeshare_residential_lot_interest_453l3(p, disposition));
    then dealer_disposition_under_453l(p, disposition);
}
@source(IRC_S453_L, quote = "Any disposition of real property which is held by the taxpayer for sale to customers in the ordinary course of the taxpayer's trade or business.")
rule DealerDispositionRealProperty(p: Person, disposition: Integer) defeasible {
    label en official "a disposition of real property held for sale to customers in the ordinary course of business is a dealer disposition, unless it is farm property or an elected timeshare/residential-lot disposition (section 453(l)(1)(B), (l)(2))";
    when held_real_property_for_sale_to_customers(p, disposition) and not_known(is_farm_property_453l(disposition)) and not_known(elects_timeshare_residential_lot_interest_453l3(p, disposition));
    then dealer_disposition_under_453l(p, disposition);
}

// (h) liquidation shareholders, (j) regulations, (k) revolving-credit/
// publicly-traded-security current inclusion: NOT DONE this stage
// (TECH_GAP G329) — no rules, no coverage classification beyond TECH_GAP.
