// Stage 4 (DECISION-0379 with deontics), part 2 of 3: section 469(e)(2)(A)(ii)
// and its credit analogue (netting against the (a) disallowance, wired into the
// disallowance rules of modules 09 and 23), and section 470(e)(2), (e)(4)(A)
// (rules similar to section 469(g) for tax-exempt use property; the
// like-kind / involuntary-conversion exclusion).

// ===================== 469(e)(2)(A)(ii): netting out of the (a) disallowance =====================

use self::{
    Asset,
    IRC_S469_E,
    IRC_S470_E,
    Person,
    TaxableYear,
    all_gain_or_loss_recognized_470,
    closely_held_corporation_passive_loss_deductible_469e2,
    disposes_entire_interest_in_tax_exempt_use_property,
    is_closely_held_c_corporation_469,
    is_personal_service_corporation_469j2,
    is_tax_exempt_use_property_for_470,
    lease_excepted_from_section_470,
    passive_activity_credit,
    passive_activity_loss,
    preceding_taxable_year_465,
    tax_exempt_use_loss_carried_as_deduction_next_year,
    tax_exempt_use_loss_freed_on_disposition,
    tax_exempt_use_property_subject_to_lease,
};

pub relation closely_held_pal_deduction_present_469e2(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: a closely held corporation deduction under (e)(2)(A)(i) exists for the year";
}
rule ClosedHeldPalDeductionPresent(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when closely_held_corporation_passive_loss_deductible_469e2(p, y, amount);
    then closely_held_pal_deduction_present_469e2(p, y);
}
pub relation passive_activity_loss_taken_into_account_under_469a(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity loss that section 469(a) looks at: the loss less the part allowable as a deduction against net active income by a closely held C corporation, which shall not be taken into account under (a) (section 469(e)(2)(A)(ii))";
}
@source(IRC_S469_E, quote = "(ii) shall not be taken into account under subsection (a) to the extent so allowable as a deduction.")
rule PalNetOfClosedHeldDeduction(p: Person, y: TaxableYear, pal: Money, ded: Money) defeasible {
    label en official "loss - deduction against net active income (section 469(e)(2)(A)(ii))";
    when passive_activity_loss(p, y, pal);
    when closely_held_corporation_passive_loss_deductible_469e2(p, y, ded);
    then passive_activity_loss_taken_into_account_under_469a(p, y, max(0.00 USD, round(pal - ded, 2, "HALF_UP")));
}
rule PalWithoutClosedHeldDeduction(p: Person, y: TaxableYear, pal: Money) defeasible {
    label en official "no closely held deduction: the whole passive activity loss goes to (a)";
    when passive_activity_loss(p, y, pal);
    when not_known(closely_held_pal_deduction_present_469e2(p, y));
    then passive_activity_loss_taken_into_account_under_469a(p, y, pal);
}
// The similar rule for the passive activity credit: the credit is allowable
// against the tax attributable to net active income and is not taken into
// account under (a) to that extent. The tax attributable to net active income
// is the tax owner's function (CASE-SUPPLIED); the rule "similar" to the
// deduction rule is read as: allowable credit = min(credit, that tax)
// (JUDGMENT CALL: the statute leaves the amount to the "similar rule").
pub relation tax_attributable_to_net_active_income_469e2(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the regular tax liability attributable to the net active income of the closely held C corporation, against which the passive activity credit is allowable (section 469(e)(2)(A), last sentence); the tax function is applied outside this package";
}
pub relation closely_held_passive_credit_allowable_469e2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity credit of a closely held C corporation (other than a personal service corporation) allowable against the tax on its net active income: the lesser of the credit and that tax (section 469(e)(2)(A), last sentence)";
}
@source(IRC_S469_E, quote = "A similar rule shall apply in the case of any passive activity credit of the taxpayer.")
rule ClosedHeldCorporationPassiveCreditAgainstActiveIncomeTax(p: Person, y: TaxableYear, credit: Money, tax: Money) defeasible {
    label en official "a similar rule for the credit: allowable against the tax on net active income (section 469(e)(2)(A))";
    when is_closely_held_c_corporation_469(p);
    when not_known(is_personal_service_corporation_469j2(p));
    when passive_activity_credit(p, y, credit);
    when tax_attributable_to_net_active_income_469e2(p, y, tax);
    when tax > 0.00 USD;
    then closely_held_passive_credit_allowable_469e2(p, y, min(credit, tax));
}
pub relation closely_held_passive_credit_present_469e2(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: an allowable closely held passive credit exists for the year";
}
rule ClosedHeldPassiveCreditPresent(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when closely_held_passive_credit_allowable_469e2(p, y, amount);
    then closely_held_passive_credit_present_469e2(p, y);
}
pub relation passive_activity_credit_taken_into_account_under_469a(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity credit that section 469(a) looks at: the credit less the part allowable against the tax on net active income (section 469(e)(2)(A), last sentence)";
}
rule PassiveCreditNetOfClosedHeldAllowance(p: Person, y: TaxableYear, credit: Money, allowed: Money) defeasible {
    label en official "credit - allowable part (section 469(e)(2)(A), last sentence)";
    when passive_activity_credit(p, y, credit);
    when closely_held_passive_credit_allowable_469e2(p, y, allowed);
    then passive_activity_credit_taken_into_account_under_469a(p, y, max(0.00 USD, round(credit - allowed, 2, "HALF_UP")));
}
rule PassiveCreditWithoutClosedHeldAllowance(p: Person, y: TaxableYear, credit: Money) defeasible {
    label en official "no closely held allowance: the whole credit goes to (a)";
    when passive_activity_credit(p, y, credit);
    when not_known(closely_held_passive_credit_present_469e2(p, y));
    then passive_activity_credit_taken_into_account_under_469a(p, y, credit);
}

// ===================== 470(e)(2): rules similar to section 469(g) =====================
//
// On a disposition of the entire interest in tax-exempt use property (or
// former tax-exempt use property), the branches of section 469(g) apply to the
// suspended tax-exempt use loss: (g)(1)(A) fully taxable disposition (module
// 26, `DispositionFreesSuspendedTaxExemptUseLoss`), (g)(1)(B) related party,
// (g)(2) transfer at death, (g)(3) installment sale. The three later branches
// are written here with the same shape as their section 469(g) counterparts
// (module 23), keyed by the property; the suspended loss is the amount carried
// as a deduction from the preceding year (`tax_exempt_use_loss_carried_as_deduction_next_year`).

pub relation related_party_acquirer_470e2(p: Person, y: TaxableYear, prop: Asset) kind empirical {
    label en official "the taxpayer and the acquirer of the entire interest bear a relationship described in section 267(b) or 707(b)(1) (section 470(e)(2), by section 469(g)(1)(B))";
}
pub relation interest_acquired_by_unrelated_person_470e2(p: Person, prop: Asset, y_disposed: TaxableYear, y_acquired: TaxableYear) kind empirical {
    label en official "the interest disposed of to a related person in y_disposed is acquired, in a fully taxable transaction, by a person not related to the taxpayer in y_acquired (section 470(e)(2), by section 469(g)(1)(B))";
}
@source(IRC_S470_E, quote = "If during the taxable year a taxpayer disposes of the taxpayer's entire interest in tax-exempt use property (or former tax-exempt use property), rules similar to the rules of section 469(g) shall apply for purposes of this section.")
rule RelatedPartyDispositionLossReleasedOnUnrelatedAcquisition470(p: Person, prop: Asset, y_disposed: TaxableYear, y_prior: TaxableYear, y_acquired: TaxableYear, amount: Money) defeasible {
    label en official "a loss deferred by a related-party disposition is freed in the year the interest passes to an unrelated person (section 470(e)(2), by section 469(g)(1)(B))";
    when disposes_entire_interest_in_tax_exempt_use_property(p, y_disposed, prop);
    when all_gain_or_loss_recognized_470(p, y_disposed, prop);
    when related_party_acquirer_470e2(p, y_disposed, prop);
    when preceding_taxable_year_465(y_prior, y_disposed);
    when tax_exempt_use_loss_carried_as_deduction_next_year(p, y_prior, prop, amount);
    when interest_acquired_by_unrelated_person_470e2(p, prop, y_disposed, y_acquired);
    then tax_exempt_use_loss_freed_on_disposition(p, y_acquired, prop, amount);
}
pub relation transfer_at_death_470e2(p: Person, y: TaxableYear, prop: Asset) kind empirical {
    label en official "an interest in the property is transferred by reason of the death of the taxpayer (section 470(e)(2), by section 469(g)(2))";
}
pub relation transferee_basis_470e2(p: Person, y: TaxableYear, prop: Asset, amount: Money) kind empirical {
    label en official "the basis of the property in the hands of the transferee (section 469(g)(2)(A)(i))";
}
pub relation decedent_adjusted_basis_470e2(p: Person, y: TaxableYear, prop: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the property immediately before the death of the taxpayer (section 469(g)(2)(A)(ii))";
}
pub relation basis_step_up_470e2(p: Person, y: TaxableYear, prop: Asset, amount: Money) kind institutional {
    label en official "the excess (if any) of the transferee's basis over the decedent's adjusted basis (section 470(e)(2), by section 469(g)(2)(A))";
}
rule BasisStepUp470Computation(p: Person, y: TaxableYear, prop: Asset, tb: Money, ab: Money) defeasible {
    label en official "transferee basis - decedent basis, not below zero (section 469(g)(2)(A))";
    when transfer_at_death_470e2(p, y, prop);
    when transferee_basis_470e2(p, y, prop, tb);
    when decedent_adjusted_basis_470e2(p, y, prop, ab);
    then basis_step_up_470e2(p, y, prop, max(0.00 USD, round(tb - ab, 2, "HALF_UP")));
}
pub relation death_transfer_loss_freed_470e2(p: Person, y: TaxableYear, prop: Asset, amount: Money) kind institutional {
    label en official "on a transfer at death the suspended loss greater than the basis step-up is freed (section 470(e)(2), by section 469(g)(2)(A))";
}
rule DeathTransferFreesLossBeyondStepUp470(p: Person, y: TaxableYear, y_prior: TaxableYear, prop: Asset, loss: Money, stepup: Money) defeasible {
    label en official "the suspended loss over the step-up is freed (section 469(g)(2)(A))";
    when transfer_at_death_470e2(p, y, prop);
    when preceding_taxable_year_465(y_prior, y);
    when tax_exempt_use_loss_carried_as_deduction_next_year(p, y_prior, prop, loss);
    when basis_step_up_470e2(p, y, prop, stepup);
    when loss > stepup;
    then death_transfer_loss_freed_470e2(p, y, prop, round(loss - stepup, 2, "HALF_UP"));
}
pub relation death_transfer_loss_never_allowed_470e2(p: Person, y: TaxableYear, prop: Asset, amount: Money) kind institutional {
    label en official "the suspended loss to the extent of the basis step-up is not allowed as a deduction for any taxable year (section 470(e)(2), by section 469(g)(2)(B))";
}
rule DeathTransferLossToExtentOfStepUpNeverAllowed470(p: Person, y: TaxableYear, y_prior: TaxableYear, prop: Asset, loss: Money, stepup: Money) defeasible {
    label en official "min(loss, step-up) is never allowed (section 469(g)(2)(B))";
    when transfer_at_death_470e2(p, y, prop);
    when preceding_taxable_year_465(y_prior, y);
    when tax_exempt_use_loss_carried_as_deduction_next_year(p, y_prior, prop, loss);
    when basis_step_up_470e2(p, y, prop, stepup);
    then death_transfer_loss_never_allowed_470e2(p, y, prop, min(loss, stepup));
}
pub relation installment_sale_of_entire_interest_470e2(p: Person, y: TaxableYear, prop: Asset) kind empirical {
    label en official "the taxpayer sells the entire interest in an installment sale to which section 453 applies (section 470(e)(2), by section 469(g)(3))";
}
pub relation total_suspended_loss_470e2(p: Person, prop: Asset, amount: Money) kind empirical {
    label en official "all suspended losses from the property to which (g)(1) would apply (section 469(g)(3))";
}
pub relation gain_recognized_on_installment_sale_470e2(p: Person, y: TaxableYear, prop: Asset, amount: Money) kind empirical {
    label en official "the gain recognized on the installment sale in the taxable year (section 469(g)(3))";
}
pub relation gross_profit_from_installment_sale_470e2(p: Person, prop: Asset, amount: Money) kind empirical {
    label en official "the gross profit from the sale (section 469(g)(3))";
}
pub relation installment_sale_loss_portion_freed_470e2(p: Person, y: TaxableYear, prop: Asset, amount: Money) kind institutional {
    label en official "the portion of the suspended losses freed for the year on an installment sale: total losses x recognized gain / gross profit, one exact division rounded to cents HALF_UP (JUDGMENT CALL) (section 470(e)(2), by section 469(g)(3))";
}
rule InstallmentSaleLossPortionRatio470(p: Person, y: TaxableYear, prop: Asset, total: Money, gain: Money, gp: Money) defeasible {
    label en official "the same ratio of the losses is freed each year as the gain bears to the gross profit (section 469(g)(3))";
    when installment_sale_of_entire_interest_470e2(p, y, prop);
    when total_suspended_loss_470e2(p, prop, total);
    when gain_recognized_on_installment_sale_470e2(p, y, prop, gain);
    when gross_profit_from_installment_sale_470e2(p, prop, gp);
    when gp > 0.00 USD;
    then installment_sale_loss_portion_freed_470e2(p, y, prop, div_round(total * (gain / 1.00 USD), gp / 1.00 USD, 2, "HALF_UP"));
}

// ===================== 470(e)(4)(A): sections 1031(a) and 1033(a) do not apply =====================

pub relation exchange_of_tax_exempt_use_property_470e4A(exchange: Integer, exchanged_property: Asset) kind empirical {
    label en official "the exchanged or converted property in a transaction to which section 1031 or 1033 would apply (section 470(e)(4)(A)(i))";
}
pub relation replacement_property_of_exchange_470e4A(exchange: Integer, replacement_property: Asset) kind empirical {
    label en official "the replacement property acquired in the transaction (section 470(e)(4)(A)(ii))";
}
pub relation lease_entered_into_on_470e4A(lease: Integer, entered_on: Date) kind empirical {
    label en official "the date the lease was entered into (section 470(e)(4)(A)(i))";
}
pub relation sections_1031a_1033a_do_not_apply_470e4A(exchange: Integer) kind institutional {
    label en official "sections 1031(a) and 1033(a) do not apply to the transaction (section 470(e)(4)(A))";
}
@source(IRC_S470_E, quote = "(i) the exchanged or converted property is tax-exempt use property subject to a lease which was entered into before March 13, 2004, and which would not have met the requirements of subsection (d) had such requirements been in effect when the lease was entered into, or")
rule Sections1031And1033DoNotApplyToPre2004Lease(exchange: Integer, prop: Asset, lease: Integer, entered_on: Date) defeasible {
    label en official "exchanged tax-exempt use property under a lease entered into before 13 March 2004 that would not have met (d): nonrecognition is denied (section 470(e)(4)(A)(i))";
    when exchange_of_tax_exempt_use_property_470e4A(exchange, prop);
    when is_tax_exempt_use_property_for_470(prop);
    when tax_exempt_use_property_subject_to_lease(prop, lease);
    when lease_entered_into_on_470e4A(lease, entered_on);
    when entered_on < @2004-03-13;
    when not_known(lease_excepted_from_section_470(lease));
    then sections_1031a_1033a_do_not_apply_470e4A(exchange);
}
@source(IRC_S470_E, quote = "(ii) the replacement property is tax-exempt use property subject to a lease which does not meet the requirements of subsection (d).")
rule Sections1031And1033DoNotApplyToReplacementUnderNonQualifiedLease(exchange: Integer, prop: Asset, lease: Integer) defeasible {
    label en official "replacement tax-exempt use property under a lease that does not meet (d): nonrecognition is denied (section 470(e)(4)(A)(ii))";
    when replacement_property_of_exchange_470e4A(exchange, prop);
    when is_tax_exempt_use_property_for_470(prop);
    when tax_exempt_use_property_subject_to_lease(prop, lease);
    when not_known(lease_excepted_from_section_470(lease));
    then sections_1031a_1033a_do_not_apply_470e4A(exchange);
}
