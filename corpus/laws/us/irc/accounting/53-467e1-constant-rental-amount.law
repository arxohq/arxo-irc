relation lease_period_growth_request_467e1(agreement: Integer, step: Decimal, s: Integer, n: Integer) kind institutional {
    label en official "helper: the growth of one lease period (s six-month periods) and of all m periods (n = s x m)";
}
rule LeasePeriodGrowthRequest(agreement: Integer, r: Decimal, s: Integer, m: Integer) defeasible {
    label en official "the per-half-year step and the two exponents";
    when rate_for_section_467_467e4(agreement, r);
    when lease_period_in_half_years_467e1(agreement, s);
    when lease_period_count_467e1(agreement, m);
    then lease_period_growth_request_467e1(agreement, div_round(r, 2.0, 12, "HALF_UP"), s, s * m);
}
rule LeasePeriodGrowthAsksOnePeriod(agreement: Integer, step: Decimal, s: Integer, n: Integer) defeasible {
    label en official "ask for the growth of one lease period";
    when lease_period_growth_request_467e1(agreement, step, s, n);
    then growth_request(step, s);
}
rule LeasePeriodGrowthAsksAllPeriods(agreement: Integer, step: Decimal, s: Integer, n: Integer) defeasible {
    label en official "ask for the growth of all lease periods";
    when lease_period_growth_request_467e1(agreement, step, s, n);
    then growth_request(step, n);
}
pub relation constant_rental_amount_derived_467e1(agreement: Integer, amount: Money) kind institutional {
    label en official "the constant rental amount: the level amount which, paid at the close of each lease period, has the same present value as all payments required under the agreement, at the (e)(4) rate compounded semiannually (section 467(e)(1)); alternative to the asserted `constant_rental_amount_467` (never both)";
}
@source(IRC_S467_E, quote = "the amount which, if paid as of the close of each lease period under the agreement, would result in an aggregate present value equal to the present value of the aggregate payments required under the agreement.")
rule ConstantRentalAmountFromPresentValues(agreement: Integer, step: Decimal, s: Integer, n: Integer, pv: Money, g: Decimal, big_g: Decimal) defeasible {
    label en official "A = PV x G (g - 1) / (G - 1) (section 467(e)(1))";
    when lease_period_growth_request_467e1(agreement, step, s, n);
    when required_payment_pv_sum_total(agreement, pv);
    when growth_factor(step, s, g);
    when growth_factor(step, n, big_g);
    when big_g > 1.0;
    then constant_rental_amount_derived_467e1(agreement, div_round(pv * (big_g * (g - 1.0)), big_g - 1.0, 2, "HALF_UP"));
}
rule RentAccruedForYearFromDerivedConstantRental(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "for a single-period agreement the rent accrued for the year is the derived constant rental amount (section 467(a)(1), (b)(2), (e)(1)); alternative channel to the asserted amount";
    when constant_rental_accrual_required_467(lessor, lessee, agreement);
    when lease_period_coincides_with_taxable_year_467(agreement, y);
    when constant_rental_amount_derived_467e1(agreement, amount);
    then rent_accrued_for_year_467(lessor, lessee, agreement, y, amount);
}
