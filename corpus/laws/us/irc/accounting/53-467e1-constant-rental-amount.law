// Section 467(e)(1): the constant rental amount (stage 4, DECISION-0379 with
// deontics). Closes G4805.
//
// The constant rental amount A is the level amount which, if paid at the close
// of each of m lease periods, has the same present value as all payments
// required under the agreement, at the section 467(e)(4) rate compounded
// semiannually. Closed form: with g the growth factor of one lease period and
// G that of all m periods (both by module 49, binary exponentiation),
//   sum of the present values of the level payments = A (G - 1) / (G (g - 1)),
// so A = (present value of the payments) x G (g - 1) / (G - 1), one exact
// division rounded to cents HALF_UP (JUDGMENT CALL).
// The present value of the payments is the sum over the required payments;
// the language cannot sum a derived relation, so payments are numbered by an
// ORDINAL SLOT (1 to 24, bounded unrolling; more payments give no amount) and
// each one is discounted with the semiannual factor of module 49 (whole
// six-month periods by (1 + r/2)^n, a stub by simple interest).
// BOUNDS (stated): every lease period is a whole number s of six-month
// periods (a quarterly or monthly lease period would need a fractional
// exponent: not derived, NEITHER); s x m at most 16383 (module 49);
// all payments fall on or after the first day of the first lease period;
// a zero rate (factor 1) gives no amount.

use self::{
    IRC_S467_E,
    Person,
    TaxableYear,
    constant_rental_accrual_required_467,
    growth_factor,
    growth_request,
    lease_period_coincides_with_taxable_year_467,
    rate_for_section_467_467e4,
    rent_accrued_for_year_467,
    semiannual_factor,
    semiannual_factor_request,
};

pub relation lease_first_period_start_467e1(agreement: Integer, d: Date) kind empirical {
    label en official "the first day of the first lease period, the date from which payments are discounted (section 467(e)(1))";
}
pub relation lease_period_in_half_years_467e1(agreement: Integer, s: Integer) kind empirical {
    label en official "the length of each lease period as a whole number of six-month periods (1: semiannual, 2: annual); other lengths are outside the derivation (bounded)";
}
pub relation lease_period_count_467e1(agreement: Integer, m: Integer) kind empirical {
    label en official "the number of lease periods under the agreement (section 467(e)(1))";
}
pub relation payment_required_slot_467e1(agreement: Integer, slot: Integer, due_on: Date, amount: Money) kind empirical {
    label en official "a payment required under the agreement, its date and its ordinal slot (1 to 24) (section 467(e)(1))";
}
rule RequiredPaymentAsksFactor(agreement: Integer, slot: Integer, due_on: Date, amount: Money, start: Date, r: Decimal) defeasible {
    label en official "ask for the discount factor of a required payment";
    when payment_required_slot_467e1(agreement, slot, due_on, amount);
    when lease_first_period_start_467e1(agreement, start);
    when rate_for_section_467_467e4(agreement, r);
    when due_on >= start;
    then semiannual_factor_request(r, start, due_on);
}
relation required_payment_present_value_467e1(agreement: Integer, slot: Integer, pv: Money) kind institutional {
    label en official "the present value of a required payment at the section 467(e)(4) rate compounded semiannually: amount divided by the factor, one rounding to cents HALF_UP (JUDGMENT CALL)";
}
rule RequiredPaymentPresentValue(agreement: Integer, slot: Integer, due_on: Date, amount: Money, start: Date, r: Decimal, f: Decimal) defeasible {
    label en official "amount / factor (section 467(e)(1), (e)(4))";
    when payment_required_slot_467e1(agreement, slot, due_on, amount);
    when lease_first_period_start_467e1(agreement, start);
    when rate_for_section_467_467e4(agreement, r);
    when due_on >= start;
    when semiannual_factor(r, start, due_on, f);
    then required_payment_present_value_467e1(agreement, slot, div_round(amount, f, 2, "HALF_UP"));
}
rule RequiredPaymentsRequestSum(agreement: Integer, slot: Integer, due_on: Date, amount: Money) defeasible {
    label en official "ask for the sum of the present values";
    when payment_required_slot_467e1(agreement, slot, due_on, amount);
    then required_payment_pv_sum_sum_request(agreement);
}

relation required_payment_pv_sum_sum_request(agreement: Integer) kind institutional {
    label en official "helper: the ordinal-slot sum of the present values of the payments required under a section 467 agreement is requested";
}
relation required_payment_pv_sum_slot_present(agreement: Integer, slot: Integer) kind institutional {
    label en official "helper: slot number has a the present values of the payments required under a section 467 agreement value";
}
rule RequiredPaymentPvSumSlotPresent(agreement: Integer, slot: Integer, v: Money) defeasible {
    label en official "a slot with a value is present";
    when required_payment_present_value_467e1(agreement, slot, v);
    then required_payment_pv_sum_slot_present(agreement, slot);
}
pub relation required_payment_pv_sum_total(agreement: Integer, total: Money) kind institutional {
    label en official "the sum of the present values of the payments required under a section 467 agreement over the ordinal slots 1 to 24 (bounded unrolling: the language cannot sum a derived relation; more than 24 slots are not summed and give no total)";
}
relation required_payment_pv_sum_sum_0(agreement: Integer, acc: Money) kind institutional {
    label en official "running sum before the first slot";
}
rule RequiredPaymentPvSumSum0(agreement: Integer) defeasible {
    label en official "the sum starts at zero";
    when required_payment_pv_sum_sum_request(agreement);
    then required_payment_pv_sum_sum_0(agreement, 0.00 USD);
}
relation required_payment_pv_sum_sum_1(agreement: Integer, acc: Money) kind institutional {
    label en official "running sum through slot 1";
}
rule RequiredPaymentPvSumSum1Add(agreement: Integer, acc: Money, v: Money) defeasible {
    label en official "slot 1 has a value: add it";
    when required_payment_pv_sum_sum_0(agreement, acc);
    when required_payment_present_value_467e1(agreement, 1, v);
    then required_payment_pv_sum_sum_1(agreement, acc + v);
}
rule RequiredPaymentPvSumSum1Skip(agreement: Integer, acc: Money) defeasible {
    label en official "slot 1 is empty: keep the sum";
    when required_payment_pv_sum_sum_0(agreement, acc);
    when not_known(required_payment_pv_sum_slot_present(agreement, 1));
    then required_payment_pv_sum_sum_1(agreement, acc);
}
