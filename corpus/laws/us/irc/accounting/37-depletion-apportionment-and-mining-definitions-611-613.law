// Sections 611(b), 612, 613(c), 613(e)(3) (stage 3, DECISION-0379 with
// deontics): apportionment of the depletion deduction (lease, life tenant,
// trust, estate), the basis for cost depletion, and the definition of "gross
// income from the property" for mines: mining, extraction, and the treatment
// processes considered and not considered as mining.
//
// Model: income items. The classification of a receipt as gross income from
// mining is derived per item; the sum over items is the input
// `gross_income_from_the_property` of module 14 (an aggregate over derived
// predicates is a runtime subset limitation, section 111).

// ===================== 611(b): who takes the deduction =====================

use self::{
    Asset,
    IRC_S611_B,
    IRC_S612,
    IRC_S613_C,
    IRC_S613_E,
    Person,
    TaxableYear,
    gross_income_from_the_property,
    is_geothermal_deposit,
    lease_bonus_advance_royalty_or_amount_payable_without_regard_to_production_613Ad5,
};

pub relation depletion_deduction_of_property_611(asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the depletion deduction under section 611 for the property and taxable year, to be apportioned or allocated (section 611(b))";
}
pub relation property_is_leased_611b1(asset: Asset, lessor: Person, lessee: Person) kind empirical {
    label en official "the property is subject to a lease between the lessor and the lessee (section 611(b)(1))";
}
pub relation equitable_share_of_lessor_611b1(asset: Asset, share: Decimal) kind empirical {
    label en official "the equitable share of the deduction that belongs to the lessor; 'equitably' is an adjudicated evaluative element (DECISION-0194, section 611(b)(1))";
}
pub relation lessor_share_of_depletion_611b1(asset: Asset, y: TaxableYear, lessor: Person, amount: Money) kind institutional {
    label en official "the lessor's part of the depletion deduction: the deduction times the equitable share, one rounding to cents HALF_UP (JUDGMENT CALL) (section 611(b)(1))";
}
@source(IRC_S611_B, quote = "In the case of a lease, the deduction under this section shall be equitably apportioned between the lessor and lessee.")
rule LessorShareOfDepletion(asset: Asset, y: TaxableYear, lessor: Person, lessee: Person, deduction: Money, share: Decimal) defeasible {
    label en official "lessor's part = deduction x equitable share (section 611(b)(1))";
    when property_is_leased_611b1(asset, lessor, lessee);
    when depletion_deduction_of_property_611(asset, y, deduction);
    when equitable_share_of_lessor_611b1(asset, share);
    then lessor_share_of_depletion_611b1(asset, y, lessor, round(deduction * share, 2, "HALF_UP"));
}
pub relation lessee_share_of_depletion_611b1(asset: Asset, y: TaxableYear, lessee: Person, amount: Money) kind institutional {
    label en official "the lessee's part of the depletion deduction: the deduction less the lessor's part (section 611(b)(1))";
}
rule LesseeShareOfDepletion(asset: Asset, y: TaxableYear, lessor: Person, lessee: Person, deduction: Money, share: Decimal) defeasible {
    label en official "lessee's part = deduction - lessor's part (section 611(b)(1))";
    when property_is_leased_611b1(asset, lessor, lessee);
    when depletion_deduction_of_property_611(asset, y, deduction);
    when equitable_share_of_lessor_611b1(asset, share);
    then lessee_share_of_depletion_611b1(asset, y, lessee, deduction - round(deduction * share, 2, "HALF_UP"));
}
pub relation property_held_for_life_with_remainder_611b2(asset: Asset, life_tenant: Person, remainderman: Person) kind empirical {
    label en official "the property is held by one person for life with remainder to another (section 611(b)(2))";
}
pub relation depletion_allowed_to_life_tenant_611b2(asset: Asset, y: TaxableYear, life_tenant: Person, amount: Money) kind institutional {
    label en official "the deduction is computed as if the life tenant were the absolute owner and is allowed to the life tenant (section 611(b)(2))";
}
@source(IRC_S611_B, quote = "the deduction under this section shall be computed as if the life tenant were the absolute owner of the property and shall be allowed to the life tenant.")
rule DepletionAllowedToLifeTenant(asset: Asset, y: TaxableYear, life_tenant: Person, remainderman: Person, deduction: Money) defeasible {
    label en official "the life tenant takes the whole deduction (section 611(b)(2))";
    when property_held_for_life_with_remainder_611b2(asset, life_tenant, remainderman);
    when depletion_deduction_of_property_611(asset, y, deduction);
    then depletion_allowed_to_life_tenant_611b2(asset, y, life_tenant, deduction);
}
pub relation property_held_in_trust_611b3(asset: Asset, trust: Person) kind empirical {
    label en official "the property is held in trust (section 611(b)(3))";
}
pub relation instrument_apportions_depletion_611b3(trust: Person, holder: Person, share: Decimal) kind empirical {
    label en official "the instrument creating the trust apportions the deduction: the holder's share, as a fraction (section 611(b)(3))";
}
pub relation trust_income_allocable_to_holder_611b3(trust: Person, holder: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the trust income allocable to the income beneficiary or the trustee for the year (section 611(b)(3))";
}
pub relation trust_income_total_611b3(trust: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total trust income of the year (section 611(b)(3))";
}
pub relation trust_instrument_has_depletion_provision_611b3(trust: Person) kind institutional {
    label en official "the instrument has a pertinent provision on the apportionment of the deduction (bridge for the absence test)";
}
rule TrustInstrumentHasDepletionProvisionBridge(trust: Person, holder: Person, share: Decimal) strict {
    label en official "bridge";
    when instrument_apportions_depletion_611b3(trust, holder, share);
    then trust_instrument_has_depletion_provision_611b3(trust);
}
pub relation depletion_apportioned_to_holder_611b3(asset: Asset, y: TaxableYear, holder: Person, amount: Money) kind institutional {
    label en official "the part of the deduction apportioned to the income beneficiary or trustee: by the instrument, or, absent a provision, by trust income allocable to each (section 611(b)(3)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S611_B, quote = "the deduction under this section shall be apportioned between the income beneficiaries and the trustee in accordance with the pertinent provisions of the instrument creating the trust")
rule TrustDepletionByInstrument(asset: Asset, y: TaxableYear, trust: Person, holder: Person, deduction: Money, share: Decimal) defeasible {
    label en official "apportioned as the instrument provides (section 611(b)(3))";
    when property_held_in_trust_611b3(asset, trust);
    when depletion_deduction_of_property_611(asset, y, deduction);
    when instrument_apportions_depletion_611b3(trust, holder, share);
    then depletion_apportioned_to_holder_611b3(asset, y, holder, round(deduction * share, 2, "HALF_UP"));
}
@source(IRC_S611_B, quote = "or, in the absence of such provisions, on the basis of the trust income allocable to each.")
rule TrustDepletionByIncomeWithoutInstrument(asset: Asset, y: TaxableYear, trust: Person, holder: Person, deduction: Money, part: Money, total: Money) defeasible {
    label en official "without an instrument provision, in proportion to trust income allocable to each (section 611(b)(3))";
    when property_held_in_trust_611b3(asset, trust);
    when depletion_deduction_of_property_611(asset, y, deduction);
    when not_known(trust_instrument_has_depletion_provision_611b3(trust));
    when trust_income_allocable_to_holder_611b3(trust, holder, y, part);
    when trust_income_total_611b3(trust, y, total);
    when total > 0.00 USD;
    then depletion_apportioned_to_holder_611b3(asset, y, holder, div_round(deduction * (part / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation property_held_by_estate_611b4(asset: Asset, estate: Person) kind empirical {
    label en official "the property is held by an estate (section 611(b)(4))";
}
pub relation estate_income_allocable_to_holder_611b4(estate: Person, holder: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the estate income allocable to the estate or to a heir, legatee, or devisee for the year (section 611(b)(4))";
}
pub relation estate_income_total_611b4(estate: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total income of the estate for the year (section 611(b)(4))";
}
pub relation depletion_apportioned_to_estate_holder_611b4(asset: Asset, y: TaxableYear, holder: Person, amount: Money) kind institutional {
    label en official "the part of the deduction apportioned to the estate or a heir, legatee, or devisee, on the basis of the estate income allocable to each; one rounding to cents HALF_UP (JUDGMENT CALL) (section 611(b)(4))";
}
@source(IRC_S611_B, quote = "the deduction under this section shall be apportioned between the estate and the heirs, legatees, and devisees on the basis of the income of the estate allocable to each.")
rule EstateDepletionByIncome(asset: Asset, y: TaxableYear, estate: Person, holder: Person, deduction: Money, part: Money, total: Money) defeasible {
    label en official "in proportion to estate income allocable to each (section 611(b)(4))";
    when property_held_by_estate_611b4(asset, estate);
    when depletion_deduction_of_property_611(asset, y, deduction);
    when estate_income_allocable_to_holder_611b4(estate, holder, y, part);
    when estate_income_total_611b4(estate, y, total);
    when total > 0.00 USD;
    then depletion_apportioned_to_estate_holder_611b4(asset, y, holder, div_round(deduction * (part / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// ===================== 612: basis for cost depletion =====================

pub relation cost_depletion_basis_612(p: Person, asset: Asset, on: Date, amount: Money) kind institutional {
    label en official "the basis on which depletion is allowed: the adjusted basis provided in section 1011 for determining gain on sale or disposition, except as otherwise provided in the subchapter (section 612)";
}
@source(IRC_S612, quote = "the basis on which depletion is to be allowed in respect of any property shall be the adjusted basis provided in section 1011 for the purpose of determining the gain upon the sale or other disposition of such property.")
rule CostDepletionBasisIsTheAdjustedBasis(p: Person, asset: Asset, on: Date, amount: Money) defeasible {
    label en official "the section 612 basis is the core adjusted basis (section 612); subchapter I adjustments, such as section 616(c), apply on top";
    when us.irc.core::adjusted_basis(p, asset, on, amount);
    then cost_depletion_basis_612(p, asset, on, amount);
}

// ===================== 613(c): gross income from the property =====================

pub enum MineralClass613c4 {
    Coal;
    SulfurByFraschProcess;
    IronOreBauxiteClaysRockAsphaltOrCrudeSoldMinerals;
    LeadZincCopperGoldSilverUraniumFluorsparPotashOrNotCrudeSold;
    TalcMagnesitePhosphateRockTronaQuicksilver;
    CalciumCarbonateForCement;
    ClayOfParagraph5Or6B;
    OilShale;
    OtherMineral;
    label en official "the mineral groups of the section 613(c)(4) treatment process list";
}
pub relation income_item_613c(item: Integer, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "an item of gross income of the property for the taxable year (section 613(c))";
}
pub relation property_is_oil_gas_or_geothermal_613c1(asset: Asset) kind empirical {
    label en official "the property is an oil or gas well or a geothermal deposit (section 613(c)(1))";
}
pub relation item_from_extraction_from_the_ground_613c2(item: Integer) kind empirical {
    label en official "the item arises from the extraction of ores or minerals from the ground (section 613(c)(2))";
}
pub relation item_from_extraction_from_waste_or_residue_of_prior_mining_613c3(item: Integer) kind empirical {
    label en official "the item arises from extraction of ore or minerals from the waste or residue of prior mining (section 613(c)(3))";
}
pub relation extraction_from_waste_by_mine_owner_or_operator_613c3(item: Integer) kind empirical {
    label en official "the extraction from the waste or residue is by a mine owner or operator, and not by a purchaser of the waste or of the rights to extract (section 613(c)(3), second sentence)";
}
pub relation extraction_613c3(item: Integer) kind institutional {
    label en official "extraction of the ores or minerals from the ground, including extraction by mine owners or operators from waste or residue of prior mining (section 613(c)(3))";
}
@source(IRC_S613_C, quote = "The term \"extraction of the ores or minerals from the ground\" includes the extraction by mine owners or operators of ores or minerals from the waste or residue of prior mining.")
rule ExtractionFromTheGround(item: Integer) strict {
    label en official "extraction from the ground (section 613(c)(3), first sentence)";
    when item_from_extraction_from_the_ground_613c2(item);
    then extraction_613c3(item);
}
rule ExtractionFromWasteByMineOwnerOrOperator(item: Integer) strict {
    label en official "extraction from waste or residue of prior mining by a mine owner or operator (section 613(c)(3), first sentence); a purchaser's extraction is excluded by the second sentence";
    when item_from_extraction_from_waste_or_residue_of_prior_mining_613c3(item);
    when extraction_from_waste_by_mine_owner_or_operator_613c3(item);
    then extraction_613c3(item);
}
pub relation item_from_treatment_process_613c(item: Integer, process: Text) kind empirical {
    label en official "the item arises from the treatment process named (section 613(c)(4)-(5))";
}
pub relation process_applied_by_mine_owner_or_operator_613c4(item: Integer) kind empirical {
    label en official "the treatment process is applied by the mine owner or operator (section 613(c)(4))";
}
pub relation process_applied_to_mineral_entitled_to_611_depletion_613c4(item: Integer) kind empirical {
    label en official "the process is applied to the ore or mineral in respect of which the mine owner or operator is entitled to a depletion deduction under section 611 (section 613(c)(4))";
}
pub relation mineral_class_of_item_613c4(item: Integer, class: MineralClass613c4) kind empirical {
    label en official "the mineral group of the ore or mineral the item concerns (section 613(c)(4))";
}
pub relation regulations_provide_process_for_mineral_613c4I(item: Integer) kind empirical {
    label en official "a treatment process provided for by regulations of the Secretary that is not inconsistent with the listed processes (section 613(c)(4)(I)); an external determination of the Secretary";
}
pub relation treatment_process_considered_mining_613c4(item: Integer) kind institutional {
    label en official "a treatment process considered as mining: a listed process for the mineral group, applied by the mine owner or operator to the mineral entitled to depletion (section 613(c)(4))";
}
@source(IRC_S613_C, quote = "(A) In the case of coal—cleaning, breaking, sizing, dust allaying, treating to prevent freezing, and loading for shipment;")
rule TreatmentProcessCoal(item: Integer, process: Text) strict {
    label en official "coal: cleaning, breaking, sizing, dust allaying, treating to prevent freezing, loading for shipment (section 613(c)(4)(A))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, Coal);
    when process == "cleaning" or process == "breaking" or process == "sizing" or process == "dust allaying" or process == "treating to prevent freezing" or process == "loading for shipment";
    then treatment_process_considered_mining_613c4(item);
}
@source(IRC_S613_C, quote = "(B) in the case of sulfur recovered by the Frasch process—cleaning, pumping to vats, cooling, breaking, and loading for shipment;")
rule TreatmentProcessSulfur(item: Integer, process: Text) strict {
    label en official "Frasch sulfur: cleaning, pumping to vats, cooling, breaking, loading for shipment (section 613(c)(4)(B))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, SulfurByFraschProcess);
    when process == "cleaning" or process == "pumping to vats" or process == "cooling" or process == "breaking" or process == "loading for shipment";
    then treatment_process_considered_mining_613c4(item);
}
@source(IRC_S613_C, quote = "(C) in the case of iron ore, bauxite, ball and sagger clay, rock asphalt, and ores or minerals which are customarily sold in the form of a crude mineral product—sorting, concentrating, sintering, and substantially equivalent processes to bring to shipping grade and form, and loading for shipment;")
rule TreatmentProcessIronOreAndCrudeSoldMinerals(item: Integer, process: Text) strict {
    label en official "iron ore, bauxite, ball and sagger clay, rock asphalt and crude-sold minerals: sorting, concentrating, sintering, equivalent processes to bring to shipping grade and form, loading (section 613(c)(4)(C))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, IronOreBauxiteClaysRockAsphaltOrCrudeSoldMinerals);
    when process == "sorting" or process == "concentrating" or process == "sintering" or process == "substantially equivalent process to bring to shipping grade and form" or process == "loading for shipment";
    then treatment_process_considered_mining_613c4(item);
}
@source(IRC_S613_C, quote = "(D) in the case of lead, zinc, copper, gold, silver, uranium, or fluorspar ores, potash, and ores or minerals which are not customarily sold in the form of the crude mineral product—crushing, grinding, and beneficiation by concentration")
rule TreatmentProcessLeadZincCopperAndNotCrudeSold(item: Integer, process: Text) strict {
    label en official "lead, zinc, copper, gold, silver, uranium, fluorspar, potash and minerals not sold crude: crushing, grinding, beneficiation, cyanidation, leaching, crystallization, precipitation and substantially equivalent processes (not electrolytic deposition, roasting, smelting, refining) (section 613(c)(4)(D))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, LeadZincCopperGoldSilverUraniumFluorsparPotashOrNotCrudeSold);
    when process == "crushing" or process == "grinding" or process == "beneficiation by concentration" or process == "cyanidation" or process == "leaching" or process == "crystallization" or process == "precipitation" or process == "substantially equivalent process of separation or extraction";
    then treatment_process_considered_mining_613c4(item);
}
@source(IRC_S613_C, quote = "(E) the pulverization of talc, the burning of magnesite, the sintering and nodulizing of phosphate rock, the decarbonation of trona, and the furnacing of quicksilver ores;")
rule TreatmentProcessTalcMagnesiteAndOthers(item: Integer, process: Text) strict {
    label en official "pulverization of talc, burning of magnesite, sintering and nodulizing of phosphate rock, decarbonation of trona, furnacing of quicksilver ores (section 613(c)(4)(E))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, TalcMagnesitePhosphateRockTronaQuicksilver);
    when process == "pulverization of talc" or process == "burning of magnesite" or process == "sintering and nodulizing of phosphate rock" or process == "decarbonation of trona" or process == "furnacing of quicksilver ores";
    then treatment_process_considered_mining_613c4(item);
}
@source(IRC_S613_C, quote = "(F) in the case of calcium carbonates and other minerals when used in making cement—all processes (other than preheating of the kiln feed) applied prior to the introduction of the kiln feed into the kiln, but not including any subsequent process;")
rule TreatmentProcessCementMinerals(item: Integer, process: Text) strict {
    label en official "cement minerals: all processes before the kiln feed enters the kiln, other than preheating of the kiln feed (section 613(c)(4)(F))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, CalciumCarbonateForCement);
    when process_before_kiln_feed_introduced_613c4F(item);
    when not_known(process_is_preheating_of_kiln_feed_613c4F(item));
    then treatment_process_considered_mining_613c4(item);
}
pub relation process_before_kiln_feed_introduced_613c4F(item: Integer) kind empirical {
    label en official "the process is applied before the kiln feed is introduced into the kiln (section 613(c)(4)(F))";
}
pub relation process_is_preheating_of_kiln_feed_613c4F(item: Integer) kind empirical {
    label en official "the process is the preheating of the kiln feed (section 613(c)(4)(F))";
}
@source(IRC_S613_C, quote = "(G) in the case of clay to which paragraph (5) or (6)(B) of subsection (b) applies—crushing, grinding, and separating the mineral from waste, but not including any subsequent process;")
rule TreatmentProcessClay(item: Integer, process: Text) strict {
    label en official "clay of section 613(b)(5) or (6)(B): crushing, grinding, separating the mineral from waste (section 613(c)(4)(G))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, ClayOfParagraph5Or6B);
    when process == "crushing" or process == "grinding" or process == "separating the mineral from waste";
    then treatment_process_considered_mining_613c4(item);
}
@source(IRC_S613_C, quote = "(H) in the case of oil shale—extraction from the ground, crushing, loading into the retort, and retorting (including in situ retorting), but not hydrogenation, refining, or any other process subsequent to retorting; and")
rule TreatmentProcessOilShale(item: Integer, process: Text) strict {
    label en official "oil shale: extraction, crushing, loading into the retort, retorting including in situ; not hydrogenation, refining or later processes (section 613(c)(4)(H))";
    when item_from_treatment_process_613c(item, process);
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when mineral_class_of_item_613c4(item, OilShale);
    when process == "extraction from the ground" or process == "crushing" or process == "loading into the retort" or process == "retorting" or process == "in situ retorting";
    then treatment_process_considered_mining_613c4(item);
}
@source(IRC_S613_C, quote = "(I) any other treatment process provided for by regulations prescribed by the Secretary which, with respect to the particular ore or mineral, is not inconsistent with the preceding provisions of this paragraph.")
rule TreatmentProcessProvidedByRegulations(item: Integer) strict {
    label en official "a process the Secretary's regulations provide for and that is consistent with the list (section 613(c)(4)(I)); the regulations are asserted";
    when process_applied_by_mine_owner_or_operator_613c4(item);
    when process_applied_to_mineral_entitled_to_611_depletion_613c4(item);
    when regulations_provide_process_for_mineral_613c4I(item);
    then treatment_process_considered_mining_613c4(item);
}
pub relation item_necessary_or_incidental_to_a_listed_process_613c(item: Integer) kind empirical {
    label en official "the item's process is necessary or incidental to a process provided for in paragraph (4) (section 613(c)(2), (5))";
}
pub relation treatment_process_not_mining_613c5(item: Integer) kind institutional {
    label en official "a treatment process not considered as mining: electrolytic deposition, roasting, calcining, smelting, refining, polishing, fine pulverization, blending, chemical change, thermal action, molding or shaping, unless provided for in (4) or necessary or incidental to such a process (section 613(c)(5))";
}
@source(IRC_S613_C, quote = "the following treatment processes shall not be considered as \"mining\": electrolytic deposition, roasting, calcining, thermal or electric smelting, refining, polishing, fine pulverization, blending with other materials, treatment effecting a chemical change, thermal action, and molding or shaping.")
rule TreatmentProcessNotMining(item: Integer, process: Text) defeasible {
    label en official "the named processes are not mining unless (4) provides for them or they are necessary or incidental to such a process (section 613(c)(5))";
    when item_from_treatment_process_613c(item, process);
    when process == "electrolytic deposition" or process == "roasting" or process == "calcining" or process == "thermal or electric smelting" or process == "refining" or process == "polishing" or process == "fine pulverization" or process == "blending with other materials" or process == "treatment effecting a chemical change" or process == "thermal action" or process == "molding or shaping";
    when not_known(treatment_process_considered_mining_613c4(item));
    when not_known(item_necessary_or_incidental_to_a_listed_process_613c(item));
    then treatment_process_not_mining_613c5(item);
}
pub relation transportation_distance_in_miles_613c2(item: Integer, miles: Integer) kind empirical {
    label en official "the distance in miles the ores or minerals are transported from the point of extraction to the plants or mills where the treatment processes are applied (section 613(c)(2))";
}
pub relation secretary_finds_greater_distance_required_613c2(item: Integer) kind empirical {
    label en official "the Secretary finds that the physical and other requirements are such that the ore or mineral must be transported a greater distance to such plants or mills (section 613(c)(2)); an external determination";
}
pub relation transportation_considered_mining_613c2(item: Integer) kind institutional {
    label en official "so much of the transportation of ores or minerals from the point of extraction to the plants or mills as is not in excess of 50 miles, or more when the Secretary so finds, is mining (section 613(c)(2))";
}
@source(IRC_S613_C, quote = "and so much of the transportation of ores or minerals (whether or not by common carrier) from the point of extraction from the ground to the plants or mills in which such treatment processes are applied thereto as is not in excess of 50 miles unless the Secretary finds")
rule TransportationWithinFiftyMilesIsMining(item: Integer, miles: Integer) defeasible {
    label en official "transportation of up to 50 miles is mining (section 613(c)(2))";
    when transportation_distance_in_miles_613c2(item, miles);
    when miles <= 50;
    then transportation_considered_mining_613c2(item);
}
rule TransportationBeyondFiftyMilesWithSecretaryFinding(item: Integer, miles: Integer) defeasible {
    label en official "a longer transportation is mining when the Secretary finds it necessary (section 613(c)(2))";
    when transportation_distance_in_miles_613c2(item, miles);
    when miles > 50;
    when secretary_finds_greater_distance_required_613c2(item);
    then transportation_considered_mining_613c2(item);
}
pub relation mining_613c2(item: Integer) kind institutional {
    label en official "mining: extraction from the ground, treatment processes considered as mining (and those necessary or incidental thereto), and transportation within 50 miles (section 613(c)(2))";
}
rule MiningByExtraction(item: Integer) defeasible {
    label en official "extraction is mining (section 613(c)(2))";
    when extraction_613c3(item);
    then mining_613c2(item);
}
rule MiningByTreatmentProcess(item: Integer) defeasible {
    label en official "a treatment process considered as mining is mining (section 613(c)(2), (4))";
    when treatment_process_considered_mining_613c4(item);
    then mining_613c2(item);
}
rule MiningByNecessaryOrIncidentalProcess(item: Integer) defeasible {
    label en official "a process necessary or incidental to a listed treatment process is mining (section 613(c)(2))";
    when item_necessary_or_incidental_to_a_listed_process_613c(item);
    then mining_613c2(item);
}
rule MiningByTransportation(item: Integer) defeasible {
    label en official "transportation to the treatment plant within the distance limit is mining (section 613(c)(2))";
    when transportation_considered_mining_613c2(item);
    then mining_613c2(item);
}
pub relation item_is_gross_income_from_mining_613c1(item: Integer, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the item is gross income from mining, and so gross income from the property, for a property other than an oil or gas well or a geothermal deposit (section 613(c)(1)); the sum over items is the input `gross_income_from_the_property`";
}
@source(IRC_S613_C, quote = "The term \"gross income from the property\" means, in the case of a property other than an oil or gas well and other than a geothermal deposit, the gross income from mining.")
rule ItemIsGrossIncomeFromMining(item: Integer, asset: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "an item of mining income of a mine property (section 613(c)(1))";
    when income_item_613c(item, asset, y, amount);
    when mining_613c2(item);
    when not_known(property_is_oil_gas_or_geothermal_613c1(asset));
    then item_is_gross_income_from_mining_613c1(item, asset, y, amount);
}

// ===================== 613(e)(3): geothermal gross income =====================

pub relation geothermal_gross_income_excluding_613Ad5_613e3(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "for a geothermal deposit gross income from the property does not include lease bonuses, advance royalties or other amounts payable without regard to production (section 613(e)(3), by section 613A(d)(5))";
}
@source(IRC_S613_E, quote = "In the case of any geothermal deposit, the term \"gross income from the property\" shall, for purposes of this section, not include any amount described in section 613A(d)(5).")
rule GeothermalGrossIncomeExcludesBonuses(p: Person, asset: Asset, y: TaxableYear, gross: Money, bonus: Money) defeasible {
    label en official "gross income less the section 613A(d)(5) amounts, floored at zero (section 613(e)(3))";
    when is_geothermal_deposit(p, asset);
    when gross_income_from_the_property(p, asset, y, gross);
    when lease_bonus_advance_royalty_or_amount_payable_without_regard_to_production_613Ad5(p, asset, y, bonus);
    then geothermal_gross_income_excluding_613Ad5_613e3(p, asset, y, max(gross - bonus, 0 USD));
}
