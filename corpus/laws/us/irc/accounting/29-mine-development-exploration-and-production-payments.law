// Sections 616, 617, 636 (stage 2c, IRC-07): mine development expenditures,
// mineral exploration expenditures (deduction election, recapture on reaching
// the producing stage, recapture on bonus or royalty, gain on disposition, the
// adjusted-exploration-expenditures definition), foreign development and
// exploration, and production payments treated as loans.
//
// Not modelled (TECH-GAPS G2132-G2135, coverage/accounting.json): the 617(d)(2)
// portion and undivided-interest attribution and the 617(d)(3) section 1245(b)
// exceptions, 617(g) partnership distributions, 617(a)(2)(C) extended
// assessment period, 616(b) unit-of-production units beyond the ratio, and
// section 636(a) carved-out payments' secondary rules.

// ===================== Section 616 =====================

use self::{
    IRC_S616_A,
    IRC_S616_B,
    IRC_S616_C,
    IRC_S617_A,
    IRC_S617_B,
    IRC_S617_C,
    IRC_S617_D,
    IRC_S617_E,
    IRC_S617_F,
    IRC_S636_A,
    IRC_S636_B,
    IRC_S636_C,
    Person,
    TaxableYear,
    carryover_basis_transaction_617d3,
    disposition_excepted_from_recapture_617d3,
};

pub relation development_expenditures_616(p: Person, y: TaxableYear, mine: Integer, amount: Money) kind empirical {
    label en official "expenditures paid or incurred in the taxable year for the development of a mine or other natural deposit (other than an oil or gas well), including depreciation treated as expenditures (section 616(a))";
}
pub relation commercially_marketable_ores_disclosed_before_expenditure(mine: Integer) kind empirical {
    label en official "the existence of ores or minerals in commercially marketable quantities has been disclosed before the expenditure is paid or incurred (section 616(a))";
}
pub relation development_expenditure_acquisition_of_depreciable_property(p: Person, y: TaxableYear, mine: Integer) kind empirical {
    label en official "the expenditure is for acquisition or improvement of property subject to the section 167 depreciation allowance, so is outside section 616 (allowances for depreciation are counted as expenditures instead)";
}
pub relation development_deduction_allowed_616a(p: Person, y: TaxableYear, mine: Integer, amount: Money) kind institutional {
    label en official "the development expenditures deducted in the taxable year (section 616(a)), absent the (b) election and (d) foreign rule";
}
@source(IRC_S616_A, quote = "there shall be allowed as a deduction in computing taxable income all expenditures paid or incurred during the taxable year for the development of a mine or other natural deposit")
rule DevelopmentExpendituresDeductible(p: Person, y: TaxableYear, mine: Integer, amount: Money) defeasible {
    label en official "development expenditures after disclosure of commercially marketable ores are deductible, unless the (b) election defers them or the (d) foreign rule applies (section 616(a))";
    when development_expenditures_616(p, y, mine, amount);
    when commercially_marketable_ores_disclosed_before_expenditure(mine);
    when not_known(development_expenditure_acquisition_of_depreciable_property(p, y, mine));
    when not_known(elects_deferred_development_expenses_616b(p, y, mine));
    when not_known(mine_located_outside_united_states(mine));
    then development_deduction_allowed_616a(p, y, mine, amount);
}
pub relation mine_located_outside_united_states(mine: Integer) kind empirical {
    label en official "the mine or deposit (other than an oil, gas, or geothermal well) is located outside the United States (section 616(d), 617(h))";
}
pub relation elects_deferred_development_expenses_616b(p: Person, y: TaxableYear, mine: Integer) kind empirical {
    label en official "the taxpayer elects to treat the development expenditures as deferred expenses deductible as units of ore are sold (section 616(b))";
}
pub relation development_stage_net_receipts_616b(p: Person, y: TaxableYear, mine: Integer, amount: Money) kind empirical {
    label en official "the net receipts during the taxable year from ores or minerals produced from the mine in the development stage (section 616(b), second sentence)";
}
pub relation mine_in_development_stage_616b(mine: Integer) kind empirical {
    label en official "the expenditures are paid or incurred during the development stage of the mine or deposit";
}
pub relation deferred_development_amount_616b(p: Person, y: TaxableYear, mine: Integer, amount: Money) kind institutional {
    label en official "the amount treated as deferred expenses: all of the year's expenditures, or in the development stage only their excess over net receipts from the mine (section 616(b))";
}
pub relation development_deferral_election_in_effect_616b(p: Person, y: TaxableYear, mine: Integer) kind institutional {
    label en official "the section 616(b) election is in effect for the taxable year and mine (binding for that year)";
}
@source(IRC_S616_B, quote = "At the election of the taxpayer, made in accordance with regulations prescribed by the Secretary, expenditures described in subsection (a) paid or incurred during the taxable year shall be treated as deferred expenses")
rule Section616bDeferralElectionPower(p: Person, y: TaxableYear, mine: Integer) strict {
    label en official "a taxpayer may elect to defer development expenditures, deductible as units are sold (section 616(b))";
    when elects_deferred_development_expenses_616b(p, y, mine);
    then power Section616bDevelopmentDeferralElection {
        holder p;
        over mine;
        exercise elects_deferred_development_expenses_616b(p, y, mine);
        valid_when commercially_marketable_ores_disclosed_before_expenditure(mine);
        effect create(development_deferral_election_in_effect_616b(p, y, mine));
        window [@1954-08-16, infinity);
    };
}
rule DeferredAmountOutsideDevelopmentStage(p: Person, y: TaxableYear, mine: Integer, amount: Money) defeasible {
    label en official "outside the development stage the whole year's expenditures are deferred (section 616(b))";
    when development_deferral_election_in_effect_616b(p, y, mine);
    when development_expenditures_616(p, y, mine, amount);
    when not_known(mine_in_development_stage_616b(mine));
    then deferred_development_amount_616b(p, y, mine, amount);
}
@source(IRC_S616_B, quote = "the election shall apply only with respect to the excess of such expenditures during the taxable year over the net receipts during the taxable year from the ores or minerals produced from such mine or deposit.")
rule DeferredAmountInDevelopmentStageIsExcessOverNetReceipts(p: Person, y: TaxableYear, mine: Integer, amount: Money, receipts: Money) defeasible {
    label en official "during the development stage only the excess over net receipts is deferred (section 616(b))";
    when development_deferral_election_in_effect_616b(p, y, mine);
    when development_expenditures_616(p, y, mine, amount);
    when mine_in_development_stage_616b(mine);
    when development_stage_net_receipts_616b(p, y, mine, receipts);
    when amount > receipts;
    then deferred_development_amount_616b(p, y, mine, round(amount - receipts, 2, "HALF_UP"));
}
pub relation units_sold_in_year_616(p: Person, y: TaxableYear, mine: Integer, units: Integer) kind empirical {
    label en official "units of produced ores or minerals benefited by the expenditures that are sold in the taxable year";
}
pub relation total_units_benefited_616(mine: Integer, units: Integer) kind empirical {
    label en official "the total units of produced ores or minerals benefited by the deferred expenditures (an estimate; the estimating rule is regulatory)";
}
pub relation deferred_development_deduction_for_year(p: Person, y: TaxableYear, mine: Integer, amount: Money) kind institutional {
    label en official "the deferred development expenses deductible in the year: ratably as the units benefited are sold: deferred amount x units sold / total units (section 616(b)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
rule DeferredDevelopmentDeductedAsUnitsSold(p: Person, y: TaxableYear, mine: Integer, deferred: Money, sold: Integer, total: Integer) defeasible {
    label en official "ratable recovery by units sold (section 616(b))";
    when deferred_development_amount_616b(p, y, mine, deferred);
    when units_sold_in_year_616(p, y, mine, sold);
    when total_units_benefited_616(mine, total);
    when total > 0;
    then deferred_development_deduction_for_year(p, y, mine, div_round(deferred * sold, total * 1.0, 2, "HALF_UP"));
}
pub relation deferred_development_excluded_from_depletion_basis(p: Person, mine: Integer) kind institutional {
    label en official "deferred development expenses (and section 1016(a)(9) adjustments) are disregarded in the adjusted basis used for the section 611 depletion deduction (section 616(c))";
}
@source(IRC_S616_C, quote = "shall be disregarded in determining the adjusted basis of the property for the purpose of computing a deduction for depletion under section 611.")
rule DeferredDevelopmentDisregardedForDepletionBasis(p: Person, y: TaxableYear, mine: Integer) defeasible {
    label en official "deferred development expenses do not enter the depletion basis (section 616(c))";
    when development_deferral_election_in_effect_616b(p, y, mine);
    then deferred_development_excluded_from_depletion_basis(p, mine);
}
// (d) and 617(h): foreign development and exploration.
pub relation foreign_expenditure_616d_617h(p: Person, y: TaxableYear, mine: Integer, amount: Money) kind empirical {
    label en official "expenditures for development (section 616(d)) or exploration (section 617(h)) of a mine or deposit outside the United States";
}
pub relation elects_inclusion_in_basis_for_cost_depletion_foreign(p: Person, y: TaxableYear, mine: Integer) kind empirical {
    label en official "the taxpayer elects to include the foreign expenditures in adjusted basis for computing section 611 depletion (without regard to section 613) (section 616(d)(2)(A), 617(h)(2)(A))";
}
pub relation foreign_expenditure_included_in_depletion_basis(p: Person, y: TaxableYear, mine: Integer, amount: Money) kind institutional {
    label en official "the foreign expenditure is included in adjusted basis for the section 611 depletion deduction";
}
rule ForeignExpenditureElectedIntoBasis(p: Person, y: TaxableYear, mine: Integer, amount: Money) defeasible {
    label en official "under the election, foreign expenditures enter the cost-depletion basis (section 616(d)(2)(A), 617(h)(2)(A))";
    when mine_located_outside_united_states(mine);
    when foreign_expenditure_616d_617h(p, y, mine, amount);
    when elects_inclusion_in_basis_for_cost_depletion_foreign(p, y, mine);
    then foreign_expenditure_included_in_depletion_basis(p, y, mine, amount);
}
pub relation foreign_expenditure_ratable_deduction(p: Person, y_paid: TaxableYear, mine: Integer, per_year: Money) kind institutional {
    label en official "without the basis election, the foreign expenditure is deducted ratably over the 10 taxable years beginning with the year paid or incurred: the annual amount (section 616(d)(2)(B), 617(h)(2)(B)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
rule ForeignExpenditureTenYearRatable(p: Person, y: TaxableYear, mine: Integer, amount: Money) defeasible {
    label en official "one tenth of the foreign expenditure in each of ten years when the basis election is not made (section 616(d)(2)(B), 617(h)(2)(B))";
    when mine_located_outside_united_states(mine);
    when foreign_expenditure_616d_617h(p, y, mine, amount);
    when not_known(elects_inclusion_in_basis_for_cost_depletion_foreign(p, y, mine));
    then foreign_expenditure_ratable_deduction(p, y, mine, div_round(amount, 10.0, 2, "HALF_UP"));
}

// ===================== Section 617 =====================

pub relation exploration_expenditures_617(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "expenditures paid or incurred in the taxable year to ascertain the existence, location, extent, or quality of a deposit of ore or other mineral, before the development stage, that would not otherwise be deductible (section 617(a)(1))";
}
pub relation mineral_allows_percentage_depletion_and_is_not_oil_or_gas(prop: Integer) kind empirical {
    label en official "the deposit is not oil or gas and is a mineral for which percentage depletion is allowable (section 617(a)(1), last sentence)";
}
pub relation exploration_expenditure_for_depreciable_property(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the expenditure is for acquisition or improvement of depreciable property (excluded; depreciation counts as an expenditure) (section 617(a)(1))";
}
pub relation elects_exploration_deduction_617a(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects the section 617(a) deduction for the taxable year (at any time before the refund-claim period expires) (section 617(a)(2)(B))";
}
pub relation election_before_refund_claim_period_expires_617(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made before the expiration of the period for making a claim for credit or refund for the taxable year (section 617(a)(2)(B))";
}
pub relation exploration_election_in_effect_617a(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 617(a) election is in effect: it applies to all exploration expenditures of the year and of every later year and may be revoked only with the Secretary's consent (section 617(a)(2)(B))";
}
@source(IRC_S617_A, quote = "At the election of the taxpayer, expenditures paid or incurred during the taxable year for the purpose of ascertaining the existence, location, extent, or quality of any deposit of ore or other mineral")
rule Section617aExplorationElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer may elect to deduct mineral exploration expenditures, timely within the refund-claim period (section 617(a))";
    when elects_exploration_deduction_617a(p, y);
    then power Section617aExplorationElection {
        holder p;
        over y;
        exercise elects_exploration_deduction_617a(p, y);
        valid_when election_before_refund_claim_period_expires_617(p, y);
        effect create(exploration_election_in_effect_617a(p, y));
        window [@1954-08-16, infinity);
    };
}
pub relation exploration_deduction_allowed_617a(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the exploration expenditures deducted for the taxable year under section 617(a)";
}
@source(IRC_S617_A, quote = "shall be allowed as a deduction in computing taxable income.")
rule ExplorationExpendituresDeducted(p: Person, y: TaxableYear, prop: Integer, amount: Money) defeasible {
    label en official "under the election, qualifying exploration expenditures are deductible (section 617(a)(1)); foreign ones fall under (h)";
    when exploration_election_in_effect_617a(p, y);
    when exploration_expenditures_617(p, y, prop, amount);
    when mineral_allows_percentage_depletion_and_is_not_oil_or_gas(prop);
    when not_known(exploration_expenditure_for_depreciable_property(p, y, prop));
    when not_known(mine_located_outside_united_states(prop));
    then exploration_deduction_allowed_617a(p, y, prop, amount);
}
pub relation cumulative_exploration_deductions_chargeable_617f1A(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "the expenditures allowed as deductions under (a) for the taxable year and all preceding years to the taxpayer or any other person, properly chargeable to the property or mine and that would otherwise be in adjusted basis (section 617(f)(1)(A))";
}
pub relation cumulative_percentage_depletion_excess_617f1B(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "for the year and each preceding year, the amount by which percentage depletion that would have been allowable but for the deduction exceeds depletion allowable under section 611 (section 617(f)(1)(B)), already adjusted for (b), (c), (d) amounts";
}
pub relation adjusted_exploration_expenditures(p: Person, prop: Integer, amount: Money) kind institutional {
    label en official "adjusted exploration expenditures: the (f)(1)(A) deductions less the (f)(1)(B) depletion excess, not below zero (section 617(f)(1))";
}
@source(IRC_S617_F, quote = "The term \"adjusted exploration expenditures\" means, with respect to any property or mine—")
rule AdjustedExplorationExpendituresComputation(p: Person, prop: Integer, deductions: Money, excess: Money) defeasible {
    label en official "AEE = deductions - percentage-depletion excess, floored at zero (section 617(f)(1))";
    when cumulative_exploration_deductions_chargeable_617f1A(p, prop, deductions);
    when cumulative_percentage_depletion_excess_617f1B(p, prop, excess);
    then adjusted_exploration_expenditures(p, prop, max(0.00 USD, round(deductions - excess, 2, "HALF_UP")));
}
pub relation mine_reaches_producing_stage_in_year(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "a mine for which expenditures were deducted under (a) reaches the producing stage in the taxable year (section 617(b)(1))";
}
pub relation elects_recapture_by_inclusion_617b1A(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects, for all such mines reaching the producing stage in the year, to include the adjusted exploration expenditures in gross income (section 617(b)(1)(A)); the election may be made or changed by the return due date (section 617(b)(2)(B))";
}
pub relation exploration_recapture_included_in_income_617b1A(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the adjusted exploration expenditures included in gross income on reaching the producing stage; the amount is treated as capital expenditures paid or incurred on the producing-stage date (section 617(b)(1)(A))";
}
@source(IRC_S617_B, quote = "he shall include in gross income for the taxable year an amount equal to the adjusted exploration expenditures with respect to such mines")
rule ExplorationRecaptureByInclusion(p: Person, y: TaxableYear, prop: Integer, aee: Money) defeasible {
    label en official "on election, adjusted exploration expenditures are included in income when the mine reaches the producing stage (section 617(b)(1)(A))";
    when mine_reaches_producing_stage_in_year(p, y, prop);
    when elects_recapture_by_inclusion_617b1A(p, y);
    when adjusted_exploration_expenditures(p, prop, aee);
    then exploration_recapture_included_in_income_617b1A(p, y, prop, aee);
}
pub relation depletion_allowable_but_for_617(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the depletion deduction under section 611 that would be allowable but for section 617(b)(1)(B) or (c)";
}
pub relation depletion_disallowed_until_aee_recovered(p: Person, y: TaxableYear, prop: Integer, disallowed: Money) kind institutional {
    label en official "depletion is disallowed until the depletion that would otherwise be allowable equals the adjusted exploration expenditures: the disallowed part for the year is the lesser of the year's depletion and the AEE not yet recovered by disallowance (section 617(b)(1)(B), (c)); cumulative recovery so far is a case fact";
}
pub relation aee_already_recovered_by_depletion_disallowance(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the depletion already disallowed in prior years under (b)(1)(B) or (c) for the property";
}
@source(IRC_S617_B, quote = "then the deduction for depletion under section 611 with respect to the property shall be disallowed until the amount of depletion which would be allowable but for this subparagraph equals the amount of the adjusted exploration expenditures with respect to such mine.")
rule DepletionDisallowedUntilExplorationRecovered(p: Person, y: TaxableYear, prop: Integer, depletion: Money, aee: Money, recovered: Money) defeasible {
    label en official "without the (b)(1)(A) inclusion election, depletion is disallowed up to the unrecovered AEE (section 617(b)(1)(B))";
    when mine_reaches_producing_stage_in_year(p, y, prop);
    when not_known(elects_recapture_by_inclusion_617b1A(p, y));
    when depletion_allowable_but_for_617(p, y, prop, depletion);
    when adjusted_exploration_expenditures(p, prop, aee);
    when aee_already_recovered_by_depletion_disallowance(p, y, prop, recovered);
    then depletion_disallowed_until_aee_recovered(p, y, prop, min(depletion, max(0.00 USD, round(aee - recovered, 2, "HALF_UP"))));
}
pub relation bonus_or_royalty_received_or_accrued_617c(p: Person, y: TaxableYear, prop: Integer, depletion_on_bonus_or_royalty: Money) kind empirical {
    label en official "the taxpayer receives or accrues a bonus or royalty on a property for which the (a) election was made; the depletion otherwise allowable on it (section 617(c))";
}
@source(IRC_S617_C, quote = "then the deduction for depletion under section 611 with respect to the bonus or royalty shall be disallowed until the amount of depletion which would be allowable but for this subsection equals the amount of the adjusted exploration expenditures")
rule DepletionOnBonusOrRoyaltyDisallowedUntilRecovered(p: Person, y: TaxableYear, prop: Integer, depletion: Money, aee: Money, recovered: Money) defeasible {
    label en official "depletion on a bonus or royalty is disallowed up to the unrecovered AEE (section 617(c))";
    when exploration_election_in_effect_617a(p, y);
    when bonus_or_royalty_received_or_accrued_617c(p, y, prop, depletion);
    when adjusted_exploration_expenditures(p, prop, aee);
    when aee_already_recovered_by_depletion_disallowance(p, y, prop, recovered);
    then depletion_disallowed_until_aee_recovered(p, y, prop, min(depletion, max(0.00 USD, round(aee - recovered, 2, "HALF_UP"))));
}
pub relation mining_property_disposed_of(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "mining property is disposed of in the taxable year (section 617(d)(1))";
}
pub relation amount_realized_or_fmv_on_disposition_617d(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the amount realized (sale, exchange, involuntary conversion) or fair market value (other dispositions) (section 617(d)(1)(B)(i))";
}
pub relation adjusted_basis_of_mining_property_617d(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis of the property at the disposition (section 617(d)(1)(B)(ii))";
}
pub relation exploration_recapture_ordinary_income_617d(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "ordinary income on a disposition: the lower of the adjusted exploration expenditures and the excess of amount realized (or FMV) over adjusted basis, recognized notwithstanding any other provision (section 617(d)(1), (d)(4))";
}
@source(IRC_S617_D, quote = "shall be treated as ordinary income. Such gain shall be recognized notwithstanding any other provision of this subtitle.")
rule ExplorationRecaptureOrdinaryIncomeOnDisposition(p: Person, y: TaxableYear, prop: Integer, realized: Money, basis: Money, aee: Money) defeasible {
    label en official "min(AEE, amount realized - adjusted basis) is ordinary income when positive (section 617(d)(1)); the section 1254 coordination (d)(5) is a separate gap";
    when mining_property_disposed_of(p, y, prop);
    when amount_realized_or_fmv_on_disposition_617d(p, y, prop, realized);
    when adjusted_basis_of_mining_property_617d(p, y, prop, basis);
    when adjusted_exploration_expenditures(p, prop, aee);
    when realized > basis;
    when not_known(disposition_subject_to_section_1254(p, y, prop));
    when not_known(disposition_excepted_from_recapture_617d3(p, y, prop));
    when not_known(carryover_basis_transaction_617d3(p, y, prop));
    then exploration_recapture_ordinary_income_617d(p, y, prop, min(aee, round(realized - basis, 2, "HALF_UP")));
}
pub relation disposition_subject_to_section_1254(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the disposition is one to which section 1254 applies (section 617(d)(5)) — an EXTERNAL_DEPENDENCY on the property-transactions owner";
}
pub relation basis_not_reduced_by_disallowed_depletion_617e(p: Person, prop: Integer) kind institutional {
    label en official "the basis of the property is not reduced by depletion that would be allowable but for section 617 (section 617(e)(1))";
}
@source(IRC_S617_E, quote = "The basis of any property shall not be reduced by the amount of any depletion which would be allowable but for the application of this section.")
rule BasisNotReducedByDisallowedDepletion(p: Person, y: TaxableYear, prop: Integer, amount: Money) defeasible {
    label en official "disallowed depletion does not reduce basis (section 617(e)(1))";
    when depletion_disallowed_until_aee_recovered(p, y, prop, amount);
    then basis_not_reduced_by_disallowed_depletion_617e(p, prop);
}

// ===================== Section 636 =====================

pub enum ProductionPaymentKind {
    CarvedOut;
    RetainedOnSale;
    RetainedByLessorOnLease;
    label en official "the production payments of section 636(a), (b), (c)";
}
pub relation production_payment_of_kind(pp: Integer, k: ProductionPaymentKind) kind empirical {
    label en official "the production payment is a carved-out payment (a), a payment retained on a sale (b), or a payment retained by the lessor in a lease (c)";
}
pub relation production_payment_treated_as_mortgage_loan(pp: Integer) kind institutional {
    label en official "a carved-out production payment is treated as if it were a mortgage loan on the property (section 636(a))";
}
@source(IRC_S636_A, quote = "A production payment carved out of mineral property shall be treated, for purposes of this subtitle, as if it were a mortgage loan on the property")
rule CarvedOutProductionPaymentIsMortgageLoan(pp: Integer) defeasible {
    label en official "carved-out payments are mortgage loans (section 636(a))";
    when production_payment_of_kind(pp, CarvedOut);
    then production_payment_treated_as_mortgage_loan(pp);
}
pub relation production_payment_treated_as_purchase_money_mortgage_loan(pp: Integer) kind institutional {
    label en official "a production payment retained on the sale of mineral property is treated as a purchase money mortgage loan (section 636(b))";
}
@source(IRC_S636_B, quote = "shall be treated, for purposes of this subtitle, as if it were a purchase money mortgage loan")
rule RetainedOnSaleIsPurchaseMoneyMortgage(pp: Integer) defeasible {
    label en official "a payment retained on a sale is a purchase money mortgage loan (section 636(b))";
    when production_payment_of_kind(pp, RetainedOnSale);
    then production_payment_treated_as_purchase_money_mortgage_loan(pp);
}
pub relation production_payment_treated_as_lessee_bonus(pp: Integer) kind institutional {
    label en official "insofar as the lessee is concerned, a production payment retained by the lessor in a lease is treated as a bonus granted by the lessee to the lessor payable in installments (section 636(c))";
}
@source(IRC_S636_C, quote = "A production payment retained in a mineral property by the lessor in a leasing transaction shall be treated, for purposes of this subtitle, insofar as the lessee")
rule RetainedByLessorIsInstallmentBonus(pp: Integer) defeasible {
    label en official "a lessor-retained payment is an installment bonus for the lessee (section 636(c))";
    when production_payment_of_kind(pp, RetainedByLessorOnLease);
    then production_payment_treated_as_lessee_bonus(pp);
}
pub relation production_payment_not_an_economic_interest(pp: Integer) kind institutional {
    label en official "a carved-out payment, or one retained on a sale, does not qualify as an economic interest in the mineral property (section 636(a), (b))";
}
rule CarvedOutNotEconomicInterest(pp: Integer) defeasible {
    label en official "carved-out payments are not economic interests (section 636(a))";
    when production_payment_treated_as_mortgage_loan(pp);
    then production_payment_not_an_economic_interest(pp);
}
rule RetainedOnSaleNotEconomicInterest(pp: Integer) defeasible {
    label en official "sale-retained payments are not economic interests (section 636(b))";
    when production_payment_treated_as_purchase_money_mortgage_loan(pp);
    then production_payment_not_an_economic_interest(pp);
}
