// Section 631 — Gain or loss in the case of timber, coal, or domestic iron
// ore. Stage 2 (IRC-07), priority scope: (a) the election to treat cutting
// as a sale or exchange, modelled as a POWER (the priority item). (b)
// (disposal of timber with a retained economic interest) and (c) (disposal
// of coal or domestic iron ore with a retained economic interest) are
// modelled at their CORE operative rule (gain/loss = amount realized minus
// adjusted depletion basis) with the related-person exclusions of (c)(1)-(2);
// the capital-gains-rate comparison of (c) second sentence, the section 272
// disallowed-deduction addback, the co-adventurer/partner carve-out, and the
// subchapter G cross-reference are NOT DONE (TECH-GAPS G323). §636 and §638
// are NOT DONE this round.

use self::{
    Asset,
    IRC_S631_A,
    IRC_S631_B,
    IRC_S631_C,
    Person,
    TaxableYear,
};

// --- (a): election to treat cutting of timber as a sale or exchange.
pub relation owns_or_has_contract_right_to_cut_timber(p: Person, timber: Asset) kind empirical {
    label en official "the taxpayer owns, or has a contract right to cut, the timber (section 631(a))";
}
pub relation held_timber_or_contract_right_more_than_one_year(p: Person, timber: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer has owned the timber or held the contract right for a period of more than 1 year (section 631(a))";
}
pub relation cuts_timber_in_year(p: Person, timber: Asset, y: TaxableYear) kind empirical {
    label en official "the cutting of the timber (for sale or for use in the taxpayer's trade or business) by the taxpayer during the taxable year (section 631(a))";
}
pub relation elects_to_treat_timber_cutting_as_sale(p: Person, timber: Asset, y: TaxableYear) kind empirical {
    label en official "the taxpayer so elects, on the return for the taxable year, to treat the cutting of timber as a sale or exchange (section 631(a))";
}
pub relation timber_cutting_treated_as_sale_or_exchange(p: Person, timber: Asset, y: TaxableYear) kind institutional {
    label en official "the cutting of timber during the taxable year is considered a sale or exchange of the timber cut during such year (section 631(a))";
}
pub relation timber_fair_market_value_first_day_of_year(p: Person, timber: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the timber as of the first day of the taxable year in which the timber is cut (section 631(a) third sentence)";
}
pub relation timber_adjusted_basis_for_depletion(p: Person, timber: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis for depletion of the timber in the hands of the taxpayer (section 631(a) second sentence)";
}
pub relation timber_cutting_gain_or_loss(p: Person, timber: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gain or loss recognized to the taxpayer on the deemed sale or exchange of cut timber: fair market value (as of the first day of the taxable year) minus the adjusted basis for depletion (section 631(a) second sentence). A negative amount is a loss.";
}
@source(IRC_S631_A, quote = "If such election has been made, gain or loss to the taxpayer shall be recognized in an amount equal to the difference between the fair market value of such timber, and the adjusted basis for depletion of such timber in the hands of the taxpayer.")
rule TimberCuttingGainOrLossComputation(p: Person, timber: Asset, y: TaxableYear, fmv: Money, basis: Money) strict {
    label en official "the recognized gain or loss on cut timber is fair market value minus adjusted basis for depletion (section 631(a))";
    when timber_cutting_treated_as_sale_or_exchange(p, timber, y);
    when timber_fair_market_value_first_day_of_year(p, timber, y, fmv);
    when timber_adjusted_basis_for_depletion(p, timber, y, basis);
    then timber_cutting_gain_or_loss(p, timber, y, fmv - basis);
}
@source(IRC_S631_A, quote = "If the taxpayer so elects on his return for a taxable year, the cutting of timber (for sale or for use in the taxpayer's trade or business) during such year by the taxpayer who owns, or has a contract right to cut, such timber (providing he has owned such timber or has held such contract right for a period of more than 1 year) shall be considered as a sale or exchange of such timber cut during such year.")
rule Section631AElectionToTreatCuttingAsSalePower(p: Person, timber: Asset, y: TaxableYear) strict {
    label en official "a taxpayer who owns, or has a contract right to cut, timber held (or the contract right held) for more than 1 year may elect on the return for a taxable year to treat that year's cutting as a sale or exchange (section 631(a))";
    when owns_or_has_contract_right_to_cut_timber(p, timber);
    when held_timber_or_contract_right_more_than_one_year(p, timber, y);
    when cuts_timber_in_year(p, timber, y);
    then power Section631ATimberElection {
        holder p;
        over timber;
        exercise elects_to_treat_timber_cutting_as_sale(p, timber, y);
        valid_when held_timber_or_contract_right_more_than_one_year(p, timber, y);
        effect create(timber_cutting_treated_as_sale_or_exchange(p, timber, y));
        window [@1954-08-16, infinity);
    };
}
// The (a) fourth sentence (the election binds all timber owned/cut-right-held
// by the taxpayer, for the year of election AND all subsequent years, until
// revoked on a showing of undue hardship with the Secretary's permission,
// after which further elections require the Secretary's consent) and the
// evergreen-tree-for-ornamental-purposes extension of "timber" are NOT
// modelled (TECH_GAP G323 — a multi-year binding-and-revocation ratchet
// across ALL of a taxpayer's timber, not a single election/asset pair).

// --- (b): disposal of timber with a retained economic interest (or outright
// sale), by an owner (including sublessor/contract holder), held > 1 year.
pub relation held_timber_for_disposal_more_than_one_year(owner: Person, timber: Asset) kind empirical {
    label en official "the timber has been held for more than 1 year before its disposal by the owner (section 631(b))";
}
pub relation disposes_of_timber_with_retained_economic_interest_or_sale(owner: Person, timber: Asset, y: TaxableYear) kind empirical {
    label en official "the owner disposes of the timber under a contract retaining an economic interest, or by an outright sale (section 631(b))";
}
pub relation amount_realized_from_timber_disposal(owner: Person, timber: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount realized from the disposal of the timber (section 631(b))";
}
pub relation timber_disposal_gain_or_loss(owner: Person, timber: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount realized from the disposal of timber minus the adjusted depletion basis, treated as gain or loss on a sale of the timber (section 631(b)). A negative amount is a loss.";
}
@source(IRC_S631_B, quote = "the difference between the amount realized from the disposal of such timber and the adjusted depletion basis thereof, shall be considered as though it were a gain or loss, as the case may be, on the sale of such timber")
rule TimberDisposalGainOrLossComputation(owner: Person, timber: Asset, y: TaxableYear, realized: Money, basis: Money) strict {
    label en official "gain or loss on a section 631(b) timber disposal is amount realized minus adjusted depletion basis";
    when held_timber_for_disposal_more_than_one_year(owner, timber);
    when disposes_of_timber_with_retained_economic_interest_or_sale(owner, timber, y);
    when amount_realized_from_timber_disposal(owner, timber, y, realized);
    when timber_adjusted_basis_for_depletion(owner, timber, y, basis);
    then timber_disposal_gain_or_loss(owner, timber, y, realized - basis);
}
// The lessee-deduction-computation rule (second sentence), the deemed-
// disposal-date rule and its payment-date election (third sentence), and the
// "owner" definition's own sub-holders are NOT separately modelled beyond
// the empirical facts above (TECH_GAP G323).

// --- (c): disposal of coal (including lignite) or domestic iron ore with a
// retained economic interest, held > 1 year, EXCLUDING related-party
// disposals under (c)(1)-(2).
pub relation held_coal_or_iron_ore_more_than_one_year(owner: Person, deposit: Asset) kind empirical {
    label en official "the coal (including lignite) or iron ore mined in the United States has been held for more than 1 year before disposal (section 631(c))";
}
pub relation disposes_of_coal_or_iron_ore_with_retained_economic_interest(owner: Person, deposit: Asset, y: TaxableYear) kind empirical {
    label en official "the owner disposes of the coal or iron ore under a contract retaining an economic interest (section 631(c))";
}
pub relation amount_realized_from_coal_or_iron_ore_disposal(owner: Person, deposit: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount realized from the disposal of the coal or iron ore (section 631(c))";
}
pub relation coal_or_iron_ore_disposal_gain_or_loss(owner: Person, deposit: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount realized from the disposal of coal or iron ore minus the adjusted depletion basis (the section 272 addback is NOT modelled, TECH_GAP G323), treated as gain or loss on a sale (section 631(c)). A negative amount is a loss.";
}
pub relation disposal_to_related_person_excluded_under_631c(owner: Person, deposit: Asset, y: TaxableYear) kind institutional {
    label en official "the disposal is to a person whose relationship would result in disallowance of losses under section 267 or 707(b), or to a person owned or controlled by the same interests (section 631(c)(1)-(2))";
}
@source(IRC_S631_C, quote = "the difference between the amount realized from the disposal of such coal or iron ore and the adjusted depletion basis thereof plus the deductions disallowed for the taxable year under section 272 shall be considered as though it were a gain or loss, as the case may be, on the sale of such coal or iron ore")
rule CoalOrIronOreDisposalGainOrLossComputation(owner: Person, deposit: Asset, y: TaxableYear, realized: Money, basis: Money) defeasible {
    label en official "gain or loss on a section 631(c) coal/iron-ore disposal is amount realized minus adjusted depletion basis, unless the disposal is to a related person excluded by (c)(1)-(2)";
    when held_coal_or_iron_ore_more_than_one_year(owner, deposit);
    when disposes_of_coal_or_iron_ore_with_retained_economic_interest(owner, deposit, y);
    when amount_realized_from_coal_or_iron_ore_disposal(owner, deposit, y, realized);
    when timber_adjusted_basis_for_depletion(owner, deposit, y, basis) and not_known(disposal_to_related_person_excluded_under_631c(owner, deposit, y));
    then coal_or_iron_ore_disposal_gain_or_loss(owner, deposit, y, realized - basis);
}
