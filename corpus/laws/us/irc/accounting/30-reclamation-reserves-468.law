// Section 468 (stage 3, DECISION-0379 with deontics): elective reserves for
// qualified mining reclamation and solid waste closing costs.
//
// Model: the annual step of one reserve. The opening balance of a later year is
// the closing balance of the preceding year, asserted as a case fact (the
// multi-year chain is self-recursive over years, TECH-GAPS G2108/G1 family);
// the first-year opening balance is derived (zero, section 468(a)(2)(A)). The
// Federal short-term rate of section 1274 is not pinned in this package, so the
// two half-year annual rates in effect are case facts (pending dependency on
// section 1274(d)). Property identity is section 614 (module 31); properties
// are case-numbered integers.
//
// Not modelled: the regulatory allocation of section 468(b), the time and manner
// of revocation (section 468(c)(1)(B)), the amount of the "proper inclusion" of
// section 468(a)(5) (regulations), and the estimate of current costs itself
// (case facts).

use self::{
    IRC_S468_A,
    IRC_S468_C,
    IRC_S468_D,
    Person,
    Secretary,
    TaxableYear,
};

pub enum ReservePropertyKind468 {
    MiningProperty;
    SolidWasteDisposalProperty;
    label en official "mining property or solid waste disposal property (section 468(a)(1))";
}
pub enum ReserveKind468 {
    ReclamationReserve;
    ClosingCostsReserve;
    label en official "a reserve for qualified reclamation costs or for qualified closing costs (section 468(c)(2))";
}
pub enum ClosingCostMethod468 {
    UnitOfProduction;
    UnitOfCapacity;
    OtherMethod;
    label en official "the method on which estimated closing costs are computed (section 468(d)(1)(B)(ii))";
}

// ===================== (d): definitions =====================

pub relation reserve_property_kind_468(prop: Integer, kind: ReservePropertyKind468) kind empirical {
    label en official "the property is mining property or solid waste disposal property (section 468(a)(1)); `property` has the meaning of section 614 (section 468(d)(3))";
}
pub relation reserve_property_is_section_614_property_468(prop: Integer) kind institutional {
    label en official "the property is a property within the meaning of section 614 (section 468(d)(3)); derived in module 32 from the section 614(a) depletion property, the case-numbered property being the interest id";
}
pub relation reclamation_plan_submitted_under_smcra_511_or_528_468d2A(prop: Integer) kind empirical {
    label en official "a land reclamation or closing plan (including an amendment or modification) is submitted pursuant to section 511 or 528 of the Surface Mining Control and Reclamation Act of 1977 as in effect on January 1, 1984 (section 468(d)(2)(A)(i)(I))";
}
pub relation reclamation_plan_is_part_of_smcra_title_v_permit_468d2A(prop: Integer) kind empirical {
    label en official "the plan is part of a surface mining and reclamation permit granted under title V of that Act as so in effect (section 468(d)(2)(A)(i)(II))";
}
pub relation reclamation_plan_under_substantially_similar_law_468d2A(prop: Integer) kind empirical {
    label en official "the plan is submitted pursuant to another Federal or State law imposing surface mining reclamation and permit requirements substantially similar to those of title V of that Act (section 468(d)(2)(A)(ii)); 'substantially similar' is an adjudicated fact (DECISION-0194)";
}
pub relation qualified_mining_reclamation_or_closing_plan_468d2A(prop: Integer) kind institutional {
    label en official "the reclamation or closing activity is conducted in accordance with a qualifying reclamation plan (section 468(d)(2)(A))";
}
rule QualifiedMiningPlanUnderSmcra(prop: Integer) defeasible {
    label en official "a plan submitted under section 511 or 528 that is part of a title V permit qualifies (section 468(d)(2)(A)(i))";
    when reclamation_plan_submitted_under_smcra_511_or_528_468d2A(prop);
    when reclamation_plan_is_part_of_smcra_title_v_permit_468d2A(prop);
    then qualified_mining_reclamation_or_closing_plan_468d2A(prop);
}
rule QualifiedMiningPlanUnderSimilarLaw(prop: Integer) defeasible {
    label en official "a plan submitted under a substantially similar Federal or State law qualifies (section 468(d)(2)(A)(ii))";
    when reclamation_plan_under_substantially_similar_law_468d2A(prop);
    then qualified_mining_reclamation_or_closing_plan_468d2A(prop);
}
pub relation solid_waste_activity_under_swda_permit_468d2B(prop: Integer) kind empirical {
    label en official "the reclamation or closing activity at the solid waste disposal site is conducted in accordance with a permit issued pursuant to a provision of the Solid Waste Disposal Act (as in effect on January 1, 1984) requiring it (section 468(d)(2)(B)(i)(I))";
}
pub relation solid_waste_activity_under_substantially_similar_law_468d2B(prop: Integer) kind empirical {
    label en official "the activity is conducted under a permit issued pursuant to another Federal, State, or local law imposing requirements substantially similar to those of the Solid Waste Disposal Act (section 468(d)(2)(B)(i)(II)); 'substantially similar' is an adjudicated fact (DECISION-0194)";
}
pub relation portion_disturbed_after_listing_on_national_contingency_plan_468d2Bii(prop: Integer) kind empirical {
    label en official "the portion of the property was disturbed after the property was listed in the national contingency plan established under section 105 of CERCLA (section 468(d)(2)(B)(ii))";
}
pub relation qualified_solid_waste_closing_plan_468d2B(prop: Integer) kind institutional {
    label en official "the solid waste reclamation or closing activity is conducted under a qualifying permit and is not the portion disturbed after listing on the national contingency plan (section 468(d)(2)(B))";
}
rule QualifiedSolidWasteActivityUnderSwda(prop: Integer) defeasible {
    label en official "a Solid Waste Disposal Act permit qualifies the activity unless the property was disturbed after CERCLA national contingency plan listing (section 468(d)(2)(B)(i)(I), (ii))";
    when solid_waste_activity_under_swda_permit_468d2B(prop);
    when not_known(portion_disturbed_after_listing_on_national_contingency_plan_468d2Bii(prop));
    then qualified_solid_waste_closing_plan_468d2B(prop);
}
rule QualifiedSolidWasteActivityUnderSimilarLaw(prop: Integer) defeasible {
    label en official "a substantially similar Federal, State, or local permit qualifies the activity unless the property was disturbed after CERCLA national contingency plan listing (section 468(d)(2)(B)(i)(II), (ii))";
    when solid_waste_activity_under_substantially_similar_law_468d2B(prop);
    when not_known(portion_disturbed_after_listing_on_national_contingency_plan_468d2Bii(prop));
    then qualified_solid_waste_closing_plan_468d2B(prop);
}
pub relation qualified_reclamation_or_closing_costs_property_468d2(prop: Integer) kind institutional {
    label en official "expenses for the property's reclamation or closing activity are qualified reclamation or closing costs (section 468(d)(2)(A)-(B))";
}
rule QualifiedCostsForMiningProperty(prop: Integer) defeasible {
    label en official "mining property: costs under a qualifying reclamation plan are qualified (section 468(d)(2)(A))";
    when reserve_property_kind_468(prop, MiningProperty);
    when qualified_mining_reclamation_or_closing_plan_468d2A(prop);
    then qualified_reclamation_or_closing_costs_property_468d2(prop);
}
rule QualifiedCostsForSolidWasteProperty(prop: Integer) defeasible {
    label en official "solid waste disposal property: costs under a qualifying permit are qualified (section 468(d)(2)(B))";
    when reserve_property_kind_468(prop, SolidWasteDisposalProperty);
    when qualified_solid_waste_closing_plan_468d2B(prop);
    then qualified_reclamation_or_closing_costs_property_468d2(prop);
}
pub relation current_reclamation_costs_468d1A(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "current reclamation costs: the amount the taxpayer would be required to pay for qualified reclamation costs if the reclamation activities were performed currently (section 468(d)(1)(A)); an estimate, case fact";
}
pub relation current_closing_costs_468d1B(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "current closing costs: the amount the taxpayer would be required to pay for qualified closing costs if the closing activities were performed currently (section 468(d)(1)(B)(i)); an estimate, case fact";
}
pub relation closing_costs_method_used_468(prop: Integer, method: ClosingCostMethod468) kind empirical {
    label en official "the method on which the taxpayer computes estimated closing costs for the property";
}
pub relation closing_costs_computed_on_required_method_468d1Bii(prop: Integer) kind institutional {
    label en official "estimated closing costs are computed on the unit-of-production method for a mine site, or on the unit-of-capacity method for a solid waste disposal site (section 468(d)(1)(B)(ii))";
}
@source(IRC_S468_D, quote = "in the case of the closing of any mine site, be computed on the unit-of-production method of accounting, and")
rule ClosingCostsOnUnitOfProductionForMine(prop: Integer) strict {
    label en official "a mine site's estimated closing costs must use the unit-of-production method (section 468(d)(1)(B)(ii)(I))";
    when reserve_property_kind_468(prop, MiningProperty);
    when closing_costs_method_used_468(prop, UnitOfProduction);
    then closing_costs_computed_on_required_method_468d1Bii(prop);
}
@source(IRC_S468_D, quote = "in the case of the closing of any solid waste disposal site, be computed on the unit-of-capacity method.")
rule ClosingCostsOnUnitOfCapacityForSolidWaste(prop: Integer) strict {
    label en official "a solid waste disposal site's estimated closing costs must use the unit-of-capacity method (section 468(d)(1)(B)(ii)(II))";
    when reserve_property_kind_468(prop, SolidWasteDisposalProperty);
    when closing_costs_method_used_468(prop, UnitOfCapacity);
    then closing_costs_computed_on_required_method_468d1Bii(prop);
}

// ===================== (a)(1): election =====================

pub relation elects_reserve_treatment_468(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the taxpayer elects the application of section 468 with respect to the mining or solid waste disposal property for the taxable year (section 468(a)(1))";
}
pub relation reserve_property_is_mining_or_solid_waste_468(prop: Integer) kind institutional {
    label en official "the property is mining property or solid waste disposal property, the only property an election may reach (section 468(a)(1))";
}
rule ReservePropertyIsMining(prop: Integer) strict {
    label en official "mining property may carry a reserve (section 468(a)(1))";
    when reserve_property_kind_468(prop, MiningProperty);
    then reserve_property_is_mining_or_solid_waste_468(prop);
}
rule ReservePropertyIsSolidWaste(prop: Integer) strict {
    label en official "solid waste disposal property may carry a reserve (section 468(a)(1))";
    when reserve_property_kind_468(prop, SolidWasteDisposalProperty);
    then reserve_property_is_mining_or_solid_waste_468(prop);
}
pub relation reserve_election_in_effect_468(p: Person, y: TaxableYear, prop: Integer) kind institutional {
    label en official "the section 468(a)(1) election is in effect for the taxable year and property";
}
@source(IRC_S468_A, quote = "If a taxpayer elects the application of this section with respect to any mining or solid waste disposal property")
rule Section468aElectionPower(p: Person, y: TaxableYear, prop: Integer) strict {
    label en official "a taxpayer may elect reserve treatment for mining or solid waste disposal property (section 468(a)(1)); effective July 18, 1984 (note 6)";
    when elects_reserve_treatment_468(p, y, prop);
    then power Section468aReserveElection {
        holder p;
        over prop;
        exercise elects_reserve_treatment_468(p, y, prop);
        valid_when reserve_property_is_mining_or_solid_waste_468(prop);
        effect create(reserve_election_in_effect_468(p, y, prop));
        window [@1984-07-18, infinity);
    };
}
pub relation reserve_election_revoked_468(p: Person, y: TaxableYear, prop: Integer) kind institutional {
    label en official "the election with respect to the property has been revoked, effective for the taxable year (section 468(c)(1)(A)); the revocation is irrevocable";
}
pub relation revokes_reserve_election_468(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the taxpayer revokes the section 468(a)(1) election with respect to the property (section 468(c)(1)(A))";
}
pub relation election_made_for_property_468(p: Person, prop: Integer) kind empirical {
    label en official "the taxpayer has made an election under section 468(a)(1) with respect to the property in some taxable year";
}
@source(IRC_S468_C, quote = "The taxpayer may revoke an election under subsection (a)(1) with respect to any property.")
rule Section468cRevocationPower(p: Person, y: TaxableYear, prop: Integer) strict {
    label en official "the taxpayer may revoke the election; time and manner are for the Secretary (section 468(c)(1)); an existing election is required";
    when revokes_reserve_election_468(p, y, prop);
    then power Section468cReserveRevocation {
        holder p;
        over prop;
        exercise revokes_reserve_election_468(p, y, prop);
        valid_when election_made_for_property_468(p, prop);
        effect create(reserve_election_revoked_468(p, y, prop));
        window [@1984-07-18, infinity);
    };
}
pub relation revocation_of_reserve_election_is_irrevocable_468c1A(p: Person, y: TaxableYear, prop: Integer) kind institutional {
    label en official "a revocation, once made, is irrevocable (section 468(c)(1)(A), second sentence)";
}
@source(IRC_S468_C, quote = "Such revocation, once made, shall be irrevocable.")
rule RevocationOfElectionIsIrrevocable(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "a made revocation cannot itself be revoked (section 468(c)(1)(A))";
    when reserve_election_revoked_468(p, y, prop);
    then revocation_of_reserve_election_is_irrevocable_468c1A(p, y, prop);
}
pub relation reserve_applies_to_year_468(p: Person, y: TaxableYear, prop: Integer) kind institutional {
    label en official "the election applies to the taxable year: it is in effect and not revoked for the year";
}
@source(IRC_S468_A, quote = "for any taxable year to which such election applies")
rule ReserveAppliesWhenElectedAndNotRevoked(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "the reserve rules apply to a year for which the election is in effect and has not been revoked (section 468(a)(1), (c)(1))";
    when reserve_election_in_effect_468(p, y, prop);
    when not_known(reserve_election_revoked_468(p, y, prop));
    then reserve_applies_to_year_468(p, y, prop);
}
pub relation reserve_property_468d4(prop: Integer) kind institutional {
    label en official "reserve property: property with respect to which a reserve is established under section 468(a)(1) (section 468(d)(4))";
}
rule ReservePropertyIsPropertyWithReserve(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "property for which an election is in effect carries a reserve and is reserve property (section 468(d)(4))";
    when reserve_election_in_effect_468(p, y, prop);
    then reserve_property_468d4(prop);
}

// ===================== (c)(2): separate reserves (duty) =====================

pub relation separate_reclamation_and_closing_reserves_established_468c2(p: Person, prop: Integer) kind empirical {
    label en official "the taxpayer has established a separate reserve for qualified reclamation costs and a separate reserve for qualified closing costs with respect to the property (section 468(c)(2)(A)-(B))";
}
@source(IRC_S468_C, quote = "the taxpayer shall establish with respect to the property for which the election was made")
rule Section468cSeparateReservesDuty(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "a taxpayer who makes an election must establish separate reclamation and closing reserves for the property (section 468(c)(2))";
    when reserve_election_in_effect_468(p, y, prop);
    then duty Section468cEstablishSeparateReserves {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition separate_reclamation_and_closing_reserves_established_468c2(p, prop);
            window [-infinity, infinity];
        }
    };
}

// ===================== (a)(1): the deduction =====================

pub relation reserve_property_disturbed_portion_current_reclamation_costs_468(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the current reclamation costs allocable to the portion of the reserve property disturbed during the taxable year (section 468(a)(1)(A))";
}
pub relation units_of_production_or_capacity_used_in_year_468(p: Person, y: TaxableYear, prop: Integer, units: Integer) kind empirical {
    label en official "the units of production (mine site) or of capacity (solid waste site) from the reserve property during the taxable year (section 468(a)(1)(B), (d)(1)(B)(ii))";
}
pub relation total_units_of_production_or_capacity_468(p: Person, prop: Integer, units: Integer) kind empirical {
    label en official "the total units of production or capacity over which the closing costs are spread (section 468(d)(1)(B)(ii))";
}
pub relation reserve_deduction_468a1(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the deduction allowed for the taxable year for qualified reclamation or closing costs of the reserve (section 468(a)(1))";
}
@source(IRC_S468_A, quote = "in the case of qualified reclamation costs, the portion of the reserve property which was disturbed during such taxable year")
rule ReclamationReserveDeduction(p: Person, y: TaxableYear, prop: Integer, amount: Money) defeasible {
    label en official "the deduction for reclamation costs equals the current reclamation costs allocable to the portion of the reserve property disturbed in the year (section 468(a)(1)(A))";
    when reserve_applies_to_year_468(p, y, prop);
    when qualified_reclamation_or_closing_costs_property_468d2(prop);
    when reserve_property_disturbed_portion_current_reclamation_costs_468(p, y, prop, amount);
    then reserve_deduction_468a1(p, y, prop, ReclamationReserve, amount);
}
@source(IRC_S468_A, quote = "in the case of qualified closing costs, the production from the reserve property during such taxable year.")
rule ClosingCostsReserveDeduction(p: Person, y: TaxableYear, prop: Integer, cost: Money, used: Integer, total: Integer) defeasible {
    label en official "the deduction for closing costs equals the current closing costs allocable to the year's production: cost x units used / total units, one rounding to cents HALF_UP (JUDGMENT CALL: the text names no rounding) (section 468(a)(1)(B))";
    when reserve_applies_to_year_468(p, y, prop);
    when qualified_reclamation_or_closing_costs_property_468d2(prop);
    when closing_costs_computed_on_required_method_468d1Bii(prop);
    when current_closing_costs_468d1B(p, prop, cost);
    when units_of_production_or_capacity_used_in_year_468(p, y, prop, used);
    when total_units_of_production_or_capacity_468(p, prop, total);
    when total > 0;
    then reserve_deduction_468a1(p, y, prop, ClosingCostsReserve, div_round(cost * used, total * 1.0, 2, "HALF_UP"));
}

// ===================== (a)(2): the reserve for the year =====================

pub relation first_taxable_year_of_reserve_468(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468) kind empirical {
    label en official "the taxable year is the first taxable year of the reserve";
}
pub relation prior_year_closing_balance_468(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind empirical {
    label en official "the closing balance of the reserve at the close of the preceding taxable year, carried as the opening balance of this year (asserted: the year chain is self-recursive, TECH-GAPS G2108)";
}
pub relation reserve_opening_balance_468(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the opening balance of the reserve for the taxable year";
}
@source(IRC_S468_A, quote = "The opening balance of any reserve for its first taxable year shall be zero.")
rule ReserveOpeningBalanceZeroInFirstYear(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468) strict {
    label en official "the opening balance of a reserve for its first taxable year is zero (section 468(a)(2)(A))";
    when first_taxable_year_of_reserve_468(p, y, prop, kind);
    then reserve_opening_balance_468(p, y, prop, kind, 0 USD);
}
rule ReserveOpeningBalanceIsPriorClosing(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) defeasible {
    label en official "after the first year the opening balance is the preceding year's closing balance";
    when prior_year_closing_balance_468(p, y, prop, kind, amount);
    then reserve_opening_balance_468(p, y, prop, kind, amount);
}
pub relation federal_short_term_annual_rates_for_year_468(y: TaxableYear, first_half: Decimal, second_half: Decimal) kind empirical {
    label en official "the Federal short-term rates (section 1274) in effect for the first and second half of the reserve's taxable year, as annual rates (section 468(a)(2)(B)(i)); the rate determination itself is a pending dependency on section 1274(d)";
}
pub relation reserve_interest_increase_468a2B(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the increase of the reserve for interest on the opening balance at the Federal short-term rate, compounded semiannually: opening x ((1 + r1/2) x (1 + r2/2) - 1), one rounding to cents HALF_UP (JUDGMENT CALL) (section 468(a)(2)(B))";
}
@source(IRC_S468_A, quote = "by compounding semiannually.")
rule ReserveInterestIncrease(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, opening: Money, r1: Decimal, r2: Decimal) defeasible {
    label en official "interest on the opening balance for the year, compounded twice at half the annual rate (section 468(a)(2)(B))";
    when reserve_opening_balance_468(p, y, prop, kind, opening);
    when federal_short_term_annual_rates_for_year_468(y, r1, r2);
    then reserve_interest_increase_468a2B(p, y, prop, kind, round(opening * ((1.0 + r1 * 0.5) * (1.0 + r2 * 0.5) - 1.0), 2, "HALF_UP"));
}
pub relation qualified_costs_paid_in_year_468a2C(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind empirical {
    label en official "amounts paid during the taxable year for qualified reclamation or closing costs allocable to portions of the reserve property for which the election was in effect (section 468(a)(2)(C))";
}
pub relation reserve_balance_before_charges_468(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the closing balance of the reserve determined without regard to the charge for amounts paid: opening balance + interest increase + deduction allocable to the reserve (section 468(a)(2)(B), (D), (a)(3)(B))";
}
pub relation reserve_deduction_increase_468a2D(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the increase of the reserve by the amount allowable as a deduction under paragraph (1) that is allocable to the reserve (section 468(a)(2)(D))";
}
@source(IRC_S468_A, quote = "A reserve shall be increased each taxable year by the amount allowable as a deduction under paragraph (1) for such taxable year which is allocable to such reserve.")
rule ReserveIncreasedByDeduction(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) defeasible {
    label en official "the reserve grows by the year's paragraph (1) deduction of its kind (section 468(a)(2)(D))";
    when reserve_deduction_468a1(p, y, prop, kind, amount);
    then reserve_deduction_increase_468a2D(p, y, prop, kind, amount);
}
rule ReserveBalanceBeforeCharges(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, opening: Money, interest: Money, deducted: Money) defeasible {
    label en official "opening balance + interest + deduction increase, before the charge for amounts paid (section 468(a)(2), (a)(3)(B))";
    when reserve_opening_balance_468(p, y, prop, kind, opening);
    when reserve_interest_increase_468a2B(p, y, prop, kind, interest);
    when reserve_deduction_increase_468a2D(p, y, prop, kind, deducted);
    then reserve_balance_before_charges_468(p, y, prop, kind, opening + interest + deducted);
}
pub relation reserve_closing_balance_468(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the closing balance after all adjustments for the year: the balance before charges less amounts paid, floored at zero because the excess paid is deducted under paragraph (3) (JUDGMENT CALL on the floor) (section 468(a)(2)(C), (a)(4)(C))";
}
@source(IRC_S468_A, quote = "shall be charged to the appropriate reserve as of the close of the taxable year.")
rule ReserveChargedForAmountsPaid(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, balance: Money, paid: Money) defeasible {
    label en official "amounts paid for qualified costs are charged to the reserve at the close of the year (section 468(a)(2)(C))";
    when reserve_balance_before_charges_468(p, y, prop, kind, balance);
    when qualified_costs_paid_in_year_468a2C(p, y, prop, kind, paid);
    then reserve_closing_balance_468(p, y, prop, kind, max(balance - paid, 0 USD));
}
rule ReserveClosingBalanceWithoutPayments(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, balance: Money) defeasible {
    label en official "with no amount paid in the year the closing balance equals the balance before charges (section 468(a)(2))";
    when reserve_balance_before_charges_468(p, y, prop, kind, balance);
    when not_known(qualified_costs_paid_for_kind_in_year_468(p, y, prop, kind));
    then reserve_closing_balance_468(p, y, prop, kind, balance);
}
pub relation qualified_costs_paid_for_kind_in_year_468(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468) kind institutional {
    label en official "some amount was paid in the year for the reserve's qualified costs (bridge: `not_known` cannot take an anonymous amount)";
}
rule QualifiedCostsPaidBridge(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, paid: Money) strict {
    label en official "a paid amount exists for the reserve kind in the year";
    when qualified_costs_paid_in_year_468a2C(p, y, prop, kind, paid);
    then qualified_costs_paid_for_kind_in_year_468(p, y, prop, kind);
}

// ===================== (a)(3): deduction for excess amounts paid =====================

pub relation excess_paid_over_reserve_deduction_468a3(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the excess of amounts paid during the year over the closing balance determined without regard to the charge for paid amounts is allowed as a deduction (section 468(a)(3))";
}
@source(IRC_S468_A, quote = "There shall be allowed as a deduction for any taxable year the excess of—")
rule ExcessAmountsPaidDeduction(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, balance: Money, paid: Money) defeasible {
    label en official "amounts paid beyond the reserve balance are deductible for the year (section 468(a)(3)); no deduction when paid does not exceed the balance";
    when reserve_balance_before_charges_468(p, y, prop, kind, balance);
    when qualified_costs_paid_in_year_468a2C(p, y, prop, kind, paid);
    when paid > balance;
    then excess_paid_over_reserve_deduction_468a3(p, y, prop, kind, paid - balance);
}

// ===================== (a)(4): limitation on the closing balance =====================

pub relation current_reclamation_costs_all_disturbed_portions_468a4A(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the current reclamation costs of the taxpayer for all portions of the reserve property disturbed during any taxable year to which the election applies (section 468(a)(4)(A)(ii))";
}
pub relation current_closing_cost_if_all_election_year_production_in_year_468a4B(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the current closing cost of the taxpayer for the reserve property, determined as if all production for taxable years to which the election applies had occurred in the taxable year (section 468(a)(4)(B)(ii))";
}
pub relation reserve_excess_included_in_gross_income_468a4(p: Person, y: TaxableYear, prop: Integer, kind: ReserveKind468, amount: Money) kind institutional {
    label en official "the amount by which the reserve's closing balance exceeds the current costs ceiling is included in gross income for the year (section 468(a)(4))";
}
@source(IRC_S468_A, quote = "there shall be included in gross income for any taxable year an amount equal to the excess of—")
rule ReclamationReserveExcessIncluded(p: Person, y: TaxableYear, prop: Integer, closing: Money, ceiling: Money) defeasible {
    label en official "a reclamation reserve's closing balance over the current reclamation costs of all disturbed portions is included in gross income (section 468(a)(4)(A)); applied after all adjustments (section 468(a)(4)(C))";
    when reserve_applies_to_year_468(p, y, prop);
    when reserve_closing_balance_468(p, y, prop, ReclamationReserve, closing);
    when current_reclamation_costs_all_disturbed_portions_468a4A(p, y, prop, ceiling);
    when closing > ceiling;
    then reserve_excess_included_in_gross_income_468a4(p, y, prop, ReclamationReserve, closing - ceiling);
}
rule ClosingReserveExcessIncluded(p: Person, y: TaxableYear, prop: Integer, closing: Money, ceiling: Money) defeasible {
    label en official "a closing costs reserve's closing balance over the current closing cost, computed as if all election-year production had occurred in the year, is included in gross income (section 468(a)(4)(B)); applied after all adjustments (section 468(a)(4)(C))";
    when reserve_applies_to_year_468(p, y, prop);
    when reserve_closing_balance_468(p, y, prop, ClosingCostsReserve, closing);
    when current_closing_cost_if_all_election_year_production_in_year_468a4B(p, y, prop, ceiling);
    when closing > ceiling;
    then reserve_excess_included_in_gross_income_468a4(p, y, prop, ClosingCostsReserve, closing - ceiling);
}

// ===================== (a)(5): inclusion on completion, revocation, disposition =====================

pub relation completion_of_closing_of_reserve_property_468a5B(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the closing of the reserve property is completed in the taxable year (section 468(a)(5)(B))";
}
pub relation disposition_of_portion_of_reserve_property_468a5B(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "any portion of the reserve property is disposed of in the taxable year (section 468(a)(5)(B))";
}
pub relation proper_inclusion_in_income_required_468a5(p: Person, y: TaxableYear, prop: Integer) kind institutional {
    label en official "proper inclusion in income must be made in the taxable year (section 468(a)(5)); the amount is left to regulations and is not computed here";
}
@source(IRC_S468_A, quote = "(A) the revocation of an election under paragraph (1), or")
rule ProperInclusionOnRevocation(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "revocation of the election calls for proper inclusion in income (section 468(a)(5)(A))";
    when reserve_election_revoked_468(p, y, prop);
    then proper_inclusion_in_income_required_468a5(p, y, prop);
}
@source(IRC_S468_A, quote = "(B) completion of the closing, or disposition of any portion, of a reserve property.")
rule ProperInclusionOnCompletionOfClosing(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "completion of the closing of a reserve property calls for proper inclusion in income (section 468(a)(5)(B))";
    when completion_of_closing_of_reserve_property_468a5B(p, y, prop);
    then proper_inclusion_in_income_required_468a5(p, y, prop);
}
rule ProperInclusionOnDispositionOfPortion(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "disposition of any portion of a reserve property calls for proper inclusion in income (section 468(a)(5)(B))";
    when disposition_of_portion_of_reserve_property_468a5B(p, y, prop);
    then proper_inclusion_in_income_required_468a5(p, y, prop);
}
