// Section 446 — General rule for methods of accounting. Stage 1 (IRC-07),
// priority section. (a) the method regularly used; (b) the Secretary's power
// to require a clearly-reflecting method (DECISION-0194 evaluative channel,
// authority Secretary); (c) the permissible-methods list as a classification
// enum; (d) different methods for different trades or businesses; (e) the
// consent requirement for a change, modelled as a power symmetric to
// section 442's; (f) the failure-to-request-change carve-out from penalty
// consequences (a scope-limiting proviso on OTHER sections' penalties, not
// an executable rule of this package — NON_NORMATIVE here, cross-referenced
// for the owner of the penalty provisions it qualifies).

use self::{
    IRC_S446_A,
    IRC_S446_B,
    IRC_S446_C,
    IRC_S446_D,
    IRC_S446_E,
    Person,
    Secretary,
    TaxableYear,
};

pub enum AccountingMethod {
    CashReceiptsAndDisbursements;
    Accrual;
    OtherPermittedMethod;
    CombinationOfMethods;
    label en official "the methods of accounting permissible under section 446(c)";
}

pub relation method_regularly_used(p: Person, y: TaxableYear, m: AccountingMethod) kind empirical {
    label en official "the method of accounting on the basis of which the taxpayer regularly computes its income in keeping its books (section 446(a))";
}
@source(IRC_S446_A, quote = "Taxable income shall be computed under the method of accounting on the basis of which the taxpayer regularly computes his income in keeping his books.")
pub relation applicable_accounting_method(p: Person, y: TaxableYear, m: AccountingMethod) kind institutional {
    label en official "the method of accounting under which taxable income is computed for the taxable year (section 446(a), subject to the section 446(b) exception)";
}
// `unless` requires its exception atom to bind every head variable
// (including `m`), while `secretary_requires_different_method(p, y)` does
// not name a method — this bridge relation supplies the `m`-bound form
// (Lessons from the pilot: "derive a helper relation with an ordinary rule").
pub relation secretary_requires_different_method_for(p: Person, y: TaxableYear, m: AccountingMethod) kind institutional {
    label en official "the Secretary requires a method other than m, because m is the taxpayer's regularly used method and the Secretary requires a clearly-reflecting method (section 446(b))";
}
rule BridgeSecretaryRequiresDifferentMethodFor(p: Person, y: TaxableYear, m: AccountingMethod) defeasible {
    label en official "bridges the method-independent section 446(b) requirement onto the specific regularly used method m";
    when method_regularly_used(p, y, m);
    when secretary_requires_different_method(p, y);
    then secretary_requires_different_method_for(p, y, m);
}
rule ApplicableMethodIsRegularlyUsedMethod(p: Person, y: TaxableYear, m: AccountingMethod) defeasible {
    label en official "taxable income is computed under the method the taxpayer regularly uses, unless that method is not permissible or does not clearly reflect income (section 446(a), subject to (b))";
    when method_regularly_used(p, y, m);
    when method_is_permissible(p, y, m);
    unless secretary_requires_different_method_for(p, y, m);
    then applicable_accounting_method(p, y, m);
}

// (c) permissible methods — a classification test over the enum.
pub relation method_is_permissible(p: Person, y: TaxableYear, m: AccountingMethod) kind institutional {
    label en official "the method is one of the methods permissible under section 446(c): cash receipts and disbursements, an accrual method, any other method this chapter permits, or a permitted combination";
}
@source(IRC_S446_C, quote = "a taxpayer may compute taxable income under any of the following methods of accounting")
rule EnumeratedMethodIsPermissible(p: Person, y: TaxableYear, m: AccountingMethod) strict {
    label en official "the cash-receipts-and-disbursements method, an accrual method, any other method this chapter permits, or a permitted combination is a permissible method (section 446(c))";
    when method_regularly_used(p, y, m);
    then method_is_permissible(p, y, m);
}

// (b) the Secretary's power to require a clearly-reflecting method —
// DECISION-0194 evaluative channel: "clearly reflects income" is committed
// to the Secretary's opinion by the text itself ("in the opinion of the
// Secretary").
external judgment relation secretary_opinion_method_clearly_reflects_income(p: Person, y: TaxableYear, m: AccountingMethod) {
    authority Secretary;
    label en official "in the opinion of the Secretary, the method clearly reflects income (section 446(b))";
}
pub relation no_method_regularly_used(p: Person, y: TaxableYear) kind empirical {
    label en official "no method of accounting has been regularly used by the taxpayer (section 446(b))";
}
pub relation secretary_requires_different_method(p: Person, y: TaxableYear) kind institutional {
    label en official "the Secretary requires computation under a method that, in the Secretary's opinion, clearly reflects income (section 446(b))";
}
@source(IRC_S446_B, quote = "If no method of accounting has been regularly used by the taxpayer, or if the method used does not clearly reflect income, the computation of taxable income shall be made under such method as, in the opinion of the Secretary, does clearly reflect income.")
rule SecretaryPowerToRequireClearlyReflectingMethodNoMethod(p: Person, y: TaxableYear) defeasible {
    label en official "the Secretary may require a clearly-reflecting method when no method has been regularly used (section 446(b))";
    when no_method_regularly_used(p, y);
    then secretary_requires_different_method(p, y);
}
rule SecretaryPowerToRequireClearlyReflectingMethodDoesNotClearlyReflect(p: Person, y: TaxableYear, m: AccountingMethod) defeasible {
    label en official "the Secretary may require a clearly-reflecting method when the taxpayer's regularly used method does not, in the Secretary's opinion, clearly reflect income (section 446(b))";
    when method_regularly_used(p, y, m);
    unless secretary_opinion_method_clearly_reflects_income(p, y, m);
    then secretary_requires_different_method(p, y);
}

// (d) different methods for different trades or businesses.
pub relation engaged_in_trade_or_business(p: Person, y: TaxableYear, business: Integer) kind empirical {
    label en official "the taxpayer is engaged in the identified trade or business during the taxable year (section 446(d))";
}
pub relation method_for_business(p: Person, y: TaxableYear, business: Integer, m: AccountingMethod) kind institutional {
    label en official "the method of accounting used for the identified trade or business, where the taxpayer is engaged in more than one (section 446(d))";
}
@source(IRC_S446_D, quote = "A taxpayer engaged in more than one trade or business may, in computing taxable income, use a different method of accounting for each trade or business.")
rule DifferentMethodPerBusinessPermitted(p: Person, y: TaxableYear, business: Integer, m: AccountingMethod) strict {
    label en official "a taxpayer engaged in more than one trade or business may use a different method of accounting for each trade or business (section 446(d))";
    when engaged_in_trade_or_business(p, y, business);
    when method_regularly_used(p, y, m);
    when method_is_permissible(p, y, m);
    then method_for_business(p, y, business, m);
}

// (e) consent requirement for a change of method — a power of the Secretary,
// symmetric to section 442's approval of a change of PERIOD.
pub relation requests_change_of_accounting_method(p: Person, y: TaxableYear, m_new: AccountingMethod) kind empirical {
    label en official "the taxpayer requests the Secretary's consent to change its method of accounting to m_new (section 446(e))";
}
pub relation secretary_consents_to_change_of_method(p: Person, y: TaxableYear, m_new: AccountingMethod) kind empirical {
    label en official "the Secretary consents to the taxpayer's change of accounting method to m_new (section 446(e))";
}
pub relation new_method_becomes_applicable(p: Person, y: TaxableYear, m_new: AccountingMethod) kind institutional {
    label en official "the taxpayer computes taxable income under the new method (section 446(e))";
}
@source(IRC_S446_E, quote = "a taxpayer who changes the method of accounting on the basis of which he regularly computes his income in keeping his books shall, before computing his taxable income under the new method, secure the consent of the Secretary")
rule Section446EConsentToChangeOfMethodPower(p: Person, y: TaxableYear, m_new: AccountingMethod) strict {
    label en official "a taxpayer changing its method of accounting must secure the Secretary's consent before computing taxable income under the new method (section 446(e))";
    when requests_change_of_accounting_method(p, y, m_new);
    then power Section446EConsentToChange {
        holder Secretary;
        over p;
        exercise secretary_consents_to_change_of_method(p, y, m_new);
        valid_when requests_change_of_accounting_method(p, y, m_new);
        effect create(new_method_becomes_applicable(p, y, m_new));
        window [@1954-08-16, infinity);
    };
}

// (f) is a proviso limiting OTHER sections' penalty/addition-to-tax
// consequences when the taxpayer did not file a request to change methods —
// it sets no computation of ITS OWN for this package; NON_NORMATIVE here,
// noted for the owner of the penalty provisions (penalties/assessment) to
// apply as a defense when reading this package's `secretary_requires_
// different_method` conclusion.
