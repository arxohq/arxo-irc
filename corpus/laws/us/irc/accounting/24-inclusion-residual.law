// Section 451 — residual (stage 2c, IRC-07). Adds to 06-inclusion-timing.law:
// (b)(2) coordination with special methods, (b)(3) applicable financial
// statement tiers, (b)(4)-(5) allocation and group statements; (c)(3)-(4)
// election exceptions and the definition of advance payment; (d) death; (e)
// tips; (f) crop insurance election; (g) livestock election; (h) utility
// services; (i) frozen deposits; (j) qualified prize options; (k) electric
// transmission transactions.
//
// Legacy compatibility: the stage 1b empirical `has_applicable_financial_
// statement` is still accepted (AfsExistsLegacyCaseFact); the new derived
// `afs_exists_451b3` is what `AfsAccelerationRule` now reads.
//
// Not modelled (TECH-GAPS G2102, G2106, coverage/accounting.json): the
// (b)(1)(A)(ii) "such other financial statement as the Secretary may specify"
// and (c)(4)(A)(iii)/(B)(vii) Secretary lists (EXTERNAL_DEPENDENCY), the (i)(5)
// section 165(l) definitions, the (j)(3) pass-through regulations, the (k)(4)
// FERC/PUCT approvals, and the (k)(8) extended assessment period.

// --- (b)(2): coordination with special methods of accounting ---

use self::{
    AccountingMethod,
    IRC_S451_B,
    IRC_S451_C,
    IRC_S451_D,
    IRC_S451_E,
    IRC_S451_F,
    IRC_S451_G,
    IRC_S451_H,
    IRC_S451_I,
    IRC_S451_J,
    IRC_S451_K,
    Person,
    TaxableYear,
    applicable_accounting_method,
    has_applicable_financial_statement,
    is_individual_estate_or_trust_469,
    uses_accrual_method,
};

pub relation item_uses_special_method_under_other_provision(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer uses, for the item of gross income, a special method of accounting provided under another provision of chapter 1 (section 451(b)(2))";
}
pub relation special_method_is_part_V_of_subchapter_P(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the special method is provided under part V of subchapter P (bonds and other debt instruments) (section 451(b)(2))";
}
pub relation special_method_displaces_451b1(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "paragraph (b)(1) does not apply to the item because a special method of another provision governs it (section 451(b)(2)); part V of subchapter P methods do not displace it";
}
@source(IRC_S451_B, quote = "Paragraph (1) shall not apply with respect to any item of gross income for which the taxpayer uses a special method of accounting provided under any other provision of this chapter")
rule SpecialMethodDisplacesAfsAcceleration(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "a special method under another provision of the chapter (other than part V of subchapter P) displaces the AFS acceleration rule for the item (section 451(b)(2))";
    when item_uses_special_method_under_other_provision(p, y, item);
    when not_known(special_method_is_part_V_of_subchapter_P(p, y, item));
    then special_method_displaces_451b1(p, y, item);
}

// --- (b)(3): applicable financial statement tiers ---

pub enum AfsTier {
    SecFiling;
    AuditedNontaxPurpose;
    OtherFederalAgencyFiling;
    IfrsForeignRegulator;
    OtherSpecifiedRegulator;
    label en official "the tiers of applicable financial statement in section 451(b)(3), in priority order: (A)(i), (A)(ii), (A)(iii), (B), (C)";
}
pub relation statement_certified_gaap(p: Person, y: TaxableYear) kind empirical {
    label en official "the financial statement is certified as prepared in accordance with generally accepted accounting principles (section 451(b)(3)(A))";
}
pub relation statement_is_sec_10k_or_shareholder_report(p: Person, y: TaxableYear) kind empirical {
    label en official "the statement is a 10-K (or successor form), or annual statement to shareholders, required to be filed with the SEC (section 451(b)(3)(A)(i))";
}
pub relation audited_statement_used_for_nontax_purpose(p: Person, y: TaxableYear) kind empirical {
    label en official "an audited financial statement used for credit purposes, for reporting to shareholders, partners, proprietors or beneficiaries, or for any other substantial nontax purpose (section 451(b)(3)(A)(ii))";
}
pub relation statement_filed_with_other_federal_agency(p: Person, y: TaxableYear) kind empirical {
    label en official "the statement is filed with any other Federal agency for purposes other than Federal tax purposes (section 451(b)(3)(A)(iii))";
}
pub relation ifrs_statement_filed_with_foreign_sec_equivalent(p: Person, y: TaxableYear) kind empirical {
    label en official "an IFRS-basis statement filed with a foreign-government agency equivalent to the SEC, with standards not less stringent (section 451(b)(3)(B))";
}
pub relation statement_filed_with_regulator_specified_by_secretary(p: Person, y: TaxableYear) kind empirical {
    label en official "a financial statement filed with a regulatory or governmental body specified by the Secretary (section 451(b)(3)(C)) — the Secretary's list is an EXTERNAL_DEPENDENCY";
}
pub relation afs_tier_451b3(p: Person, y: TaxableYear, tier: AfsTier) kind institutional {
    label en official "the tier under which the taxpayer's statement is an applicable financial statement, applying each tier only where no higher-priority statement exists (section 451(b)(3))";
}
@source(IRC_S451_B, quote = "(i) a 10–K (or successor form), or annual statement to shareholders, required to be filed by the taxpayer with the United States Securities and Exchange Commission,")
rule AfsTierSecFiling(p: Person, y: TaxableYear) defeasible {
    label en official "a GAAP-certified 10-K or shareholder annual statement is the top-priority applicable financial statement (section 451(b)(3)(A)(i))";
    when statement_certified_gaap(p, y);
    when statement_is_sec_10k_or_shareholder_report(p, y);
    then afs_tier_451b3(p, y, SecFiling);
}
@source(IRC_S451_B, quote = "but only if there is no statement of the taxpayer described in clause (i), or")
rule AfsTierAuditedNontax(p: Person, y: TaxableYear) defeasible {
    label en official "a GAAP-certified audited statement used for a substantial nontax purpose counts only if there is no clause (i) statement (section 451(b)(3)(A)(ii))";
    when statement_certified_gaap(p, y);
    when audited_statement_used_for_nontax_purpose(p, y);
    when not_known(statement_is_sec_10k_or_shareholder_report(p, y));
    then afs_tier_451b3(p, y, AuditedNontaxPurpose);
}
@source(IRC_S451_B, quote = "but only if there is no statement of the taxpayer described in clause (i) or (ii),")
rule AfsTierOtherFederalAgency(p: Person, y: TaxableYear) defeasible {
    label en official "a GAAP-certified statement filed with another Federal agency counts only if no clause (i) or (ii) statement exists (section 451(b)(3)(A)(iii))";
    when statement_certified_gaap(p, y);
    when statement_filed_with_other_federal_agency(p, y);
    when not_known(statement_is_sec_10k_or_shareholder_report(p, y));
    when not_known(audited_statement_used_for_nontax_purpose(p, y));
    then afs_tier_451b3(p, y, OtherFederalAgencyFiling);
}
@source(IRC_S451_B, quote = "but only if there is no statement of the taxpayer described in subparagraph (A), or")
rule AfsTierIfrsForeignRegulator(p: Person, y: TaxableYear) defeasible {
    label en official "an IFRS statement filed with a foreign SEC-equivalent counts only if no subparagraph (A) statement exists (section 451(b)(3)(B))";
    when ifrs_statement_filed_with_foreign_sec_equivalent(p, y);
    when not_known(statement_is_sec_10k_or_shareholder_report(p, y));
    when not_known(audited_statement_used_for_nontax_purpose(p, y));
    when not_known(statement_filed_with_other_federal_agency(p, y));
    then afs_tier_451b3(p, y, IfrsForeignRegulator);
}
@source(IRC_S451_B, quote = "but only if there is no statement of the taxpayer described in subparagraph (A) or (B).")
rule AfsTierOtherSpecifiedRegulator(p: Person, y: TaxableYear) defeasible {
    label en official "a statement filed with a Secretary-specified regulator counts only if no (A) or (B) statement exists (section 451(b)(3)(C))";
    when statement_filed_with_regulator_specified_by_secretary(p, y);
    when not_known(statement_is_sec_10k_or_shareholder_report(p, y));
    when not_known(audited_statement_used_for_nontax_purpose(p, y));
    when not_known(statement_filed_with_other_federal_agency(p, y));
    when not_known(ifrs_statement_filed_with_foreign_sec_equivalent(p, y));
    then afs_tier_451b3(p, y, OtherSpecifiedRegulator);
}
pub relation financial_results_reported_on_group_afs(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's financial results are reported on an applicable financial statement (as defined in (b)(3)) for a group of entities (section 451(b)(5))";
}
pub relation afs_exists_451b3(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer has an applicable financial statement for the taxable year: under one of the (b)(3) tiers, or through a group statement ((b)(5))";
}
rule AfsExistsByTier(p: Person, y: TaxableYear) defeasible {
    label en official "a statement in any (b)(3) tier is the taxpayer's applicable financial statement";
    when afs_tier_451b3(p, y, _);
    then afs_exists_451b3(p, y);
}
@source(IRC_S451_B, quote = "such statement shall be treated as the applicable financial statement of the taxpayer.")
rule AfsExistsByGroupStatement(p: Person, y: TaxableYear) defeasible {
    label en official "a group's applicable financial statement is treated as the taxpayer's own (section 451(b)(5))";
    when financial_results_reported_on_group_afs(p, y);
    then afs_exists_451b3(p, y);
}
rule AfsExistsLegacyCaseFact(p: Person, y: TaxableYear) defeasible {
    label en official "the stage 1b case-asserted `has_applicable_financial_statement` still establishes an applicable financial statement (compatibility path)";
    when has_applicable_financial_statement(p, y);
    then afs_exists_451b3(p, y);
}
// (b)(4) and (c)(4)(D): transaction price allocation follows the AFS.
pub relation afs_revenue_allocation_to_performance_obligation(p: Person, y: TaxableYear, contract: Integer, obligation: Integer, amount: Money) kind empirical {
    label en official "the amount allocated to the performance obligation for purposes of including the item in revenue in the applicable financial statement (section 451(b)(4))";
}
pub relation tax_allocation_of_transaction_price(p: Person, y: TaxableYear, contract: Integer, obligation: Integer, amount: Money) kind institutional {
    label en official "for a contract with multiple performance obligations, the allocation of the transaction price to each obligation for section 451(b) (and, by (c)(4)(D), for advance payments) equals the AFS allocation";
}
@source(IRC_S451_B, quote = "the allocation of the transaction price to each performance obligation shall be equal to the amount allocated to each performance obligation for purposes of including such item in revenue in the applicable financial statement of the taxpayer.")
rule TransactionPriceAllocationFollowsAfs(p: Person, y: TaxableYear, contract: Integer, obligation: Integer, amount: Money) defeasible {
    label en official "the tax allocation of a multi-obligation contract equals the AFS revenue allocation (section 451(b)(4), (c)(4)(D))";
    when afs_exists_451b3(p, y);
    when afs_revenue_allocation_to_performance_obligation(p, y, contract, obligation, amount);
    then tax_allocation_of_transaction_price(p, y, contract, obligation, amount);
}

// --- (c)(3)-(4): advance payments ---

pub relation taxpayer_ceases_to_exist_in_year_451c3(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer ceases to exist during (or with the close of) the taxable year (section 451(c)(3)); the Secretary may provide otherwise (EXTERNAL_DEPENDENCY)";
}
pub relation full_inclusion_in_receipt_year_is_permissible_method(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "full inclusion of the payment in gross income for the year of receipt is a permissible method of accounting under section 451, determined without regard to (c) (section 451(c)(4)(A)(i))";
}
pub relation portion_included_in_afs_revenue_for_subsequent_year(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a portion of the payment is included in revenue in a (b)(1)(A)(i)/(ii) financial statement for a subsequent taxable year (section 451(c)(4)(A)(ii))";
}
pub relation payment_for_goods_services_or_secretary_item(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the payment is for goods, services, or other items identified by the Secretary (section 451(c)(4)(A)(iii))";
}
pub enum AdvancePaymentExclusion {
    Rent;
    InsurancePremiumSubchapterL;
    FinancialInstrument;
    ThirdPartyPrimaryObligorWarranty;
    Section871a881_1441_1442Payment;
    Section83Property;
    OtherSecretaryIdentified;
    label en official "the payments excluded from the term advance payment by section 451(c)(4)(B)(i)-(vii)";
}
pub relation payment_of_excluded_kind_451c4B(p: Person, y: TaxableYear, item: Integer, kind: AdvancePaymentExclusion) kind empirical {
    label en official "the payment is of a kind listed in section 451(c)(4)(B)";
}
pub relation payment_is_excluded_from_advance_payment(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the payment is of an excluded kind under section 451(c)(4)(B)";
}
rule PaymentOfExcludedKindIsExcluded(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "a payment of any listed kind is not an advance payment (section 451(c)(4)(B))";
    when payment_of_excluded_kind_451c4B(p, y, item, _);
    then payment_is_excluded_from_advance_payment(p, y, item);
}
pub relation is_advance_payment_451c4(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the payment is an advance payment: the three (A) conditions are met and it is not of an excluded kind";
}
@source(IRC_S451_C, quote = "The term \"advance payment\" means any payment—")
rule AdvancePaymentDefinition(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "an advance payment meets (A)(i)-(iii) and is not excluded by (B) (section 451(c)(4)(A)-(B))";
    when full_inclusion_in_receipt_year_is_permissible_method(p, y, item);
    when portion_included_in_afs_revenue_for_subsequent_year(p, y, item);
    when payment_for_goods_services_or_secretary_item(p, y, item);
    when not_known(payment_is_excluded_from_advance_payment(p, y, item));
    then is_advance_payment_451c4(p, y, item);
}
pub relation item_actually_or_constructively_received(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is actually or constructively received by the taxpayer (section 451(c)(4)(C))";
}
pub relation item_due_and_payable_to_taxpayer(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is due and payable to the taxpayer (section 451(c)(4)(C))";
}
pub relation item_received_for_451c(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "for subsection (c), an item is received if actually or constructively received, or due and payable (section 451(c)(4)(C))";
}
@source(IRC_S451_C, quote = "an item of gross income is received by the taxpayer if it is actually or constructively received, or if it is due and payable to the taxpayer.")
rule ReceiptActualOrConstructive(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "actual or constructive receipt is receipt (section 451(c)(4)(C))";
    when item_actually_or_constructively_received(p, y, item);
    then item_received_for_451c(p, y, item);
}
rule ReceiptDueAndPayable(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "an amount due and payable is received (section 451(c)(4)(C))";
    when item_due_and_payable_to_taxpayer(p, y, item);
    then item_received_for_451c(p, y, item);
}

// --- (d): death; (e): tips ---

pub relation amount_accrued_only_by_reason_of_death(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount accrued only by reason of the death of the taxpayer, for a period in which the date of death falls (section 451(d))";
}
pub relation accrued_by_reason_of_death_excluded_from_final_period(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount accrued only by reason of the taxpayer's death is not included in taxable income for the period in which the date of death falls (section 451(d))";
}
@source(IRC_S451_D, quote = "any amount accrued only by reason of the death of the taxpayer shall not be included in computing taxable income for the period in which falls the date of the taxpayer's death.")
rule DeathAccrualExcludedFromFinalPeriod(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "for an accrual-method taxpayer, an amount accrued only by reason of death is excluded from the final period's income (section 451(d))";
    when uses_accrual_method(p, y);
    when amount_accrued_only_by_reason_of_death(p, y, amount);
    then accrued_by_reason_of_death_excluded_from_final_period(p, y, amount);
}
pub relation tips_in_written_statement_furnished_on(p: Person, item: Integer, statement_date: Date) kind empirical {
    label en official "tips included in a written statement furnished to the employer by the employee under section 6053(a), on the date furnished (section 451(e))";
}
pub relation tip_deemed_received_on(p: Person, item: Integer, received: Date) kind institutional {
    label en official "the tips are deemed received when the written statement including them is furnished to the employer (section 451(e))";
}
@source(IRC_S451_E, quote = "shall be deemed to be received at the time the written statement including such tips is furnished to the employer.")
rule TipsDeemedReceivedWhenStatementFurnished(p: Person, item: Integer, d: Date) defeasible {
    label en official "reported tips are received on the statement date (section 451(e))";
    when tips_in_written_statement_furnished_on(p, item, d);
    then tip_deemed_received_on(p, item, d);
}

// --- (f): crop insurance proceeds election ---

pub relation uses_cash_method_451(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer reports on the cash receipts and disbursements method of accounting (bridged from section 446)";
}
rule BridgeUsesCashMethod(p: Person, y: TaxableYear) defeasible {
    label en official "bridges section 446's applicable accounting method into the cash-method test of section 451(f)-(g), (j)";
    when applicable_accounting_method(p, y, CashReceiptsAndDisbursements);
    then uses_cash_method_451(p, y);
}
pub relation cash_method_facts_asserted_451(p: Person, y: TaxableYear) kind empirical {
    label en official "case-asserted cash-method status for a scenario that does not go through section 446's own derivation";
}
rule CashMethodFromCaseFact(p: Person, y: TaxableYear) defeasible {
    label en official "a case-asserted cash-method status is accepted (compatibility path)";
    when cash_method_facts_asserted_451(p, y);
    then uses_cash_method_451(p, y);
}
pub relation crop_damage_insurance_proceeds(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is insurance proceeds received as a result of destruction or damage to crops (section 451(f))";
}
pub relation payment_under_agricultural_act_or_disaster_assistance_act(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "payments under the Agricultural Act of 1949 or title II of the Disaster Assistance Act of 1988 as a result of crop destruction or damage caused by drought, flood, or other natural disaster, or inability to plant because of such a disaster (section 451(f), second sentence)";
}
pub relation treated_as_crop_insurance_proceeds_451f(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the item is treated as insurance proceeds for crop destruction or damage (section 451(f))";
}
rule CropProceedsDirect(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "insurance proceeds for crop damage are crop insurance proceeds (section 451(f))";
    when crop_damage_insurance_proceeds(p, y, item);
    then treated_as_crop_insurance_proceeds_451f(p, y, item);
}
@source(IRC_S451_F, quote = "shall be treated as insurance proceeds received as a result of destruction or damage to crops.")
rule CropDisasterPaymentsTreatedAsInsurance(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "Agricultural Act / Disaster Assistance Act payments for crop disasters are treated as crop insurance proceeds (section 451(f), second sentence)";
    when payment_under_agricultural_act_or_disaster_assistance_act(p, y, item);
    then treated_as_crop_insurance_proceeds_451f(p, y, item);
}
pub relation practice_reports_crop_income_in_following_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer establishes that, under the taxpayer's practice, income from the damaged crops would have been reported in a following taxable year (section 451(f))";
}
pub relation crop_election_made_at_prescribed_time_and_manner(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made at the time and in the manner the Secretary prescribes (section 451(f), last sentence)";
}
pub relation elects_crop_insurance_deferral(p: Person, y: TaxableYear) kind empirical {
    label en official "the cash-method taxpayer elects to include crop insurance proceeds in income for the taxable year following the year of destruction or damage (section 451(f))";
}
pub relation crop_election_conditions_met(p: Person, y: TaxableYear) kind institutional {
    label en official "the (f) election conditions hold: cash method, the reporting-practice showing, and timely, proper election";
}
rule CropElectionConditions(p: Person, y: TaxableYear) defeasible {
    label en official "cash method, the following-year practice showing, and prescribed election (section 451(f))";
    when uses_cash_method_451(p, y);
    when practice_reports_crop_income_in_following_year(p, y);
    when crop_election_made_at_prescribed_time_and_manner(p, y);
    then crop_election_conditions_met(p, y);
}
pub relation crop_proceeds_included_in_following_year(p: Person, y_damage: TaxableYear) kind institutional {
    label en official "the crop insurance proceeds are included in income for the taxable year following the year of destruction or damage (section 451(f))";
}
@source(IRC_S451_F, quote = "may elect to include such proceeds in income for the taxable year following the taxable year of destruction or damage")
rule Section451FCropInsuranceElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a cash-method taxpayer may elect to defer crop insurance proceeds one year if the practice showing is made (section 451(f))";
    when elects_crop_insurance_deferral(p, y);
    then power Section451FCropInsuranceElection {
        holder p;
        over y;
        exercise elects_crop_insurance_deferral(p, y);
        valid_when crop_election_conditions_met(p, y);
        effect create(crop_proceeds_included_in_following_year(p, y));
        window [@1954-08-16, infinity);
    };
}

// --- (g): livestock sold on account of weather-related conditions ---

pub relation livestock_sold_in_excess_of_usual_practice(p: Person, y: TaxableYear) kind empirical {
    label en official "the income derives from the sale or exchange of livestock in excess of the number the taxpayer would sell under usual business practices (section 451(g)(1))";
}
pub relation sale_would_not_have_occurred_but_for_weather(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer establishes that, under usual practices, the sale would not have occurred in the year but for drought, flood, or other weather-related conditions (section 451(g)(1))";
}
pub relation area_designated_eligible_for_federal_assistance(p: Person, y: TaxableYear) kind empirical {
    label en official "the weather conditions resulted in the area being designated as eligible for assistance by the Federal Government (section 451(g)(1))";
}
pub relation principal_trade_or_business_is_farming_6420c3(p: Person) kind empirical {
    label en official "the taxpayer's principal trade or business is farming within the meaning of section 6420(c)(3) (section 451(g)(2))";
}
pub relation livestock_election_made_during_1033e2_replacement_period(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1033(e)(2) applies and the election is made during the replacement period described there (section 451(g)(3))";
}
pub relation livestock_election_made_at_prescribed_time(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is otherwise timely under the Secretary's rules (implicit in section 451(g)(1); the statute states no separate time rule)";
}
pub relation elects_livestock_income_deferral(p: Person, y: TaxableYear) kind empirical {
    label en official "the cash-method taxpayer elects to include the income for the taxable year following the year of the sale or exchange (section 451(g)(1))";
}
pub relation livestock_election_substantive_conditions_met(p: Person, y: TaxableYear) kind institutional {
    label en official "cash method; excess livestock sale; weather causation; federal-assistance designation; principal business farming (section 451(g)(1)-(2))";
}
rule LivestockElectionSubstantiveConditions(p: Person, y: TaxableYear) defeasible {
    label en official "the substantive conditions of the livestock election (section 451(g)(1)-(2))";
    when uses_cash_method_451(p, y);
    when livestock_sold_in_excess_of_usual_practice(p, y);
    when sale_would_not_have_occurred_but_for_weather(p, y);
    when area_designated_eligible_for_federal_assistance(p, y);
    when principal_trade_or_business_is_farming_6420c3(p);
    then livestock_election_substantive_conditions_met(p, y);
}
pub relation livestock_election_valid_451g(p: Person, y: TaxableYear) kind institutional {
    label en official "the livestock election is valid: the substantive conditions hold and it is timely, or deemed valid within the section 1033(e)(2) replacement period ((g)(3))";
}
rule LivestockElectionValidOrdinary(p: Person, y: TaxableYear) defeasible {
    label en official "a substantively qualified election made in time is valid (section 451(g)(1))";
    when livestock_election_substantive_conditions_met(p, y);
    when livestock_election_made_at_prescribed_time(p, y);
    then livestock_election_valid_451g(p, y);
}
@source(IRC_S451_G, quote = "the election under paragraph (1) shall be deemed valid if made during the replacement period described in such section.")
rule LivestockElectionDeemedValidInReplacementPeriod(p: Person, y: TaxableYear) defeasible {
    label en official "where section 1033(e)(2) applies, an election made during its replacement period is deemed valid (section 451(g)(3))";
    when livestock_election_substantive_conditions_met(p, y);
    when livestock_election_made_during_1033e2_replacement_period(p, y);
    then livestock_election_valid_451g(p, y);
}
pub relation livestock_income_included_in_following_year(p: Person, y_sale: TaxableYear) kind institutional {
    label en official "the livestock sale income is included for the taxable year following the year of the sale or exchange (section 451(g)(1))";
}
@source(IRC_S451_G, quote = "a taxpayer reporting on the cash receipts and disbursements method of accounting may elect to include such income for the taxable year following the taxable year in which such sale or exchange occurs")
rule Section451GLivestockElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a cash-method farmer may elect to defer excess weather-forced livestock sale income one year (section 451(g)(1))";
    when elects_livestock_income_deferral(p, y);
    then power Section451GLivestockElection {
        holder p;
        over y;
        exercise elects_livestock_income_deferral(p, y);
        valid_when livestock_election_valid_451g(p, y);
        effect create(livestock_income_included_in_following_year(p, y));
        window [@1978-01-01, infinity);
    };
}

// --- (h): utility services ---

pub enum UtilityServiceKind {
    Electricity;
    Water;
    SewageDisposal;
    GasOrSteamLocalDistribution;
    Telephone;
    OtherCommunicationService;
    GasOrSteamPipelineTransport;
    label en official "the utility services named in section 451(h)(2)(A)(i)-(iv)";
}
pub relation income_from_service_of_kind(p: Person, item: Integer, kind: UtilityServiceKind) kind empirical {
    label en official "the income is attributable to the sale or furnishing of a service of the kind";
}
pub relation is_utility_service_income_451h(p: Person, item: Integer) kind institutional {
    label en official "the income is attributable to utility services within the meaning of section 451(h)(2)(A)";
}
rule UtilityServiceIncomeDefinition(p: Person, item: Integer) defeasible {
    label en official "income from electricity, water, sewage, gas or steam distribution, communications, or pipeline transport of gas or steam is utility service income (section 451(h)(2)(A))";
    when income_from_service_of_kind(p, item, _);
    then is_utility_service_income_451h(p, item);
}
pub relation utility_services_provided_in_year(p: Person, item: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the services are treated as provided to customers";
}
pub relation service_year_fixed_by_meter_reading_or_billing(p: Person, item: Integer) kind empirical {
    label en official "the year of service is being fixed by reference to the meter-reading period or the billing (or permitted billing) period (section 451(h)(2)(B))";
}
pub relation service_year_determination_by_meter_or_billing_disregarded(p: Person, item: Integer) kind institutional {
    label en official "a determination of the year of service by meter reading or billing period is not permitted (section 451(h)(2)(B))";
}
@source(IRC_S451_H, quote = "The taxable year in which services are treated as provided to customers shall not, in any manner, be determined by reference to—")
rule ServiceYearNotByMeterOrBilling(p: Person, item: Integer) defeasible {
    label en official "the service year may not be fixed by meter-reading or billing period (section 451(h)(2)(B)) — the determination is disregarded";
    when service_year_fixed_by_meter_reading_or_billing(p, item);
    then service_year_determination_by_meter_or_billing_disregarded(p, item);
}
pub relation utility_income_includible_no_later_than(p: Person, item: Integer, y: TaxableYear) kind institutional {
    label en official "the utility service income of an accrual-method taxpayer is included in gross income not later than the taxable year in which the services are provided (section 451(h)(1))";
}
@source(IRC_S451_H, quote = "any income attributable to the sale or furnishing of utility services to customers shall be included in gross income not later than the taxable year in which such services are provided to such customers.")
rule UtilityServiceIncomeNoLaterThanServiceYear(p: Person, item: Integer, y: TaxableYear) defeasible {
    label en official "accrual-method utility income is includible no later than the year of service (section 451(h)(1))";
    when uses_accrual_method(p, y);
    when is_utility_service_income_451h(p, item);
    when utility_services_provided_in_year(p, item, y);
    when not_known(service_year_fixed_by_meter_reading_or_billing(p, item));
    then utility_income_includible_no_later_than(p, item, y);
}

// --- (i): frozen deposits ---

pub relation is_qualified_individual_165l(p: Person) kind empirical {
    label en official "the individual is a qualified individual as when used in section 165(l) (section 451(i)(5)) — an EXTERNAL_DEPENDENCY on the section 165(l) owner";
}
pub enum FrozenDepositCause {
    InstitutionInsolvencyOrThreat;
    StateRequirementByReasonOfInsolvency;
    label en official "the causes of section 451(i)(4)(A)-(B)";
}
pub relation deposit_portion_not_withdrawable_at_close_of_calendar_year(deposit: Integer, cause: FrozenDepositCause) kind empirical {
    label en official "as of the close of the calendar year, part of the deposit may not be withdrawn because of the cause (section 451(i)(4))";
}
pub relation is_frozen_deposit_451i4(deposit: Integer) kind institutional {
    label en official "a frozen deposit: any deposit, part of which may not be withdrawn at year end because of the institution's bankruptcy or insolvency (or threat) or a State requirement imposed by reason of it (section 451(i)(4))";
}
rule FrozenDepositDefinition(deposit: Integer) defeasible {
    label en official "a deposit with a non-withdrawable portion for a (4)(A) or (B) reason is frozen (section 451(i)(4))";
    when deposit_portion_not_withdrawable_at_close_of_calendar_year(deposit, _);
    then is_frozen_deposit_451i4(deposit);
}
pub relation interest_credited_on_frozen_deposit(p: Person, deposit: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest credited during the calendar year on a frozen deposit in a qualified financial institution (section 451(i)(1))";
}
pub relation net_amount_withdrawn_from_deposit(p: Person, deposit: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net amount withdrawn by the individual from the deposit during the calendar year (section 451(i)(1)(A))";
}
pub relation amount_of_deposit_withdrawable_at_close(p: Person, deposit: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the deposit withdrawable at the close of the taxable year, without regard to any penalty for premature withdrawal of a time deposit (section 451(i)(1)(B))";
}
pub relation frozen_deposit_interest_includible(p: Person, deposit: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest includible in the qualified individual's gross income: not more than net withdrawals plus the amount withdrawable at the close of the year (section 451(i)(1))";
}
@source(IRC_S451_I, quote = "the amount of such interest includible in the gross income of a qualified individual shall not exceed the sum of—")
rule FrozenDepositInterestIncludibleCapped(p: Person, deposit: Integer, y: TaxableYear, credited: Money, withdrawn: Money, withdrawable: Money) defeasible {
    label en official "includible interest = min(credited interest, net withdrawn + withdrawable at close) (section 451(i)(1))";
    when is_qualified_individual_165l(p);
    when is_frozen_deposit_451i4(deposit);
    when interest_credited_on_frozen_deposit(p, deposit, y, credited);
    when net_amount_withdrawn_from_deposit(p, deposit, y, withdrawn);
    when amount_of_deposit_withdrawable_at_close(p, deposit, y, withdrawable);
    then frozen_deposit_interest_includible(p, deposit, y, min(credited, round(withdrawn + withdrawable, 2, "HALF_UP")));
}
pub relation frozen_deposit_interest_deferred_to_next_calendar_year(p: Person, deposit: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "interest not included by reason of (i)(1) is treated as credited in the next calendar year (section 451(i)(2))";
}
@source(IRC_S451_I, quote = "Any interest not included in gross income by reason of paragraph (1) shall be treated as credited in the next calendar year.")
rule FrozenDepositInterestNotIncludedIsCreditedNextYear(p: Person, deposit: Integer, y: TaxableYear, credited: Money, includible: Money) defeasible {
    label en official "the excess of credited interest over the includible amount is tested again next year (section 451(i)(2))";
    when interest_credited_on_frozen_deposit(p, deposit, y, credited);
    when frozen_deposit_interest_includible(p, deposit, y, includible);
    when credited > includible;
    then frozen_deposit_interest_deferred_to_next_calendar_year(p, deposit, y, round(credited - includible, 2, "HALF_UP"));
}
pub relation institution_interest_deduction_deferred_until_includible(institution: Person, deposit: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the institution may not deduct interest not includible in the depositor's gross income until it is includible (section 451(i)(3))";
}
pub relation institution_of_deposit(institution: Person, deposit: Integer) kind empirical {
    label en official "the qualified financial institution holding the deposit";
}
@source(IRC_S451_I, quote = "No deduction shall be allowed to any qualified financial institution for interest not includible in gross income under paragraph (1) until such interest is includible in gross income.")
rule InstitutionDeductionDeferredForFrozenDepositInterest(institution: Person, p: Person, deposit: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the institution's interest deduction waits until the depositor includes the interest (section 451(i)(3))";
    when institution_of_deposit(institution, deposit);
    when frozen_deposit_interest_deferred_to_next_calendar_year(p, deposit, y, amount);
    then institution_interest_deduction_deferred_until_includible(institution, deposit, y, amount);
}

// --- (j): qualified prize options ---

pub relation prize_awarded_by_contest_lottery_or_similar(prize: Integer) kind empirical {
    label en official "the prize or award is awarded as part of a contest, lottery, jackpot, game, or similar arrangement (section 451(j)(2)(B)(i))";
}
pub relation prize_relates_to_services_or_requires_substantial_future_service(prize: Integer) kind empirical {
    label en official "the prize relates to past services of the recipient or requires substantial future service (section 451(j)(2)(B)(ii))";
}
pub relation prize_payable_over_years(prize: Integer, years: Integer) kind empirical {
    label en official "the prize is payable over a period of the stated number of years (section 451(j)(2)(B)(iii))";
}
pub relation is_qualified_prize_451j(prize: Integer) kind institutional {
    label en official "a qualified prize: awarded as part of a contest or similar arrangement, unrelated to services, payable over at least 10 years (section 451(j)(2)(B))";
}
@source(IRC_S451_J, quote = "is payable over a period of at least 10 years.")
rule QualifiedPrizeDefinition(prize: Integer, n: Integer) defeasible {
    label en official "the three (B) conditions define a qualified prize (section 451(j)(2)(B))";
    when prize_awarded_by_contest_lottery_or_similar(prize);
    when not_known(prize_relates_to_services_or_requires_substantial_future_service(prize));
    when prize_payable_over_years(prize, n);
    when n >= 10;
    then is_qualified_prize_451j(prize);
}
pub relation option_entitles_single_cash_payment_in_lieu_of_prize(option: Integer, prize: Integer) kind empirical {
    label en official "the option entitles an individual to receive a single cash payment in lieu of the qualified prize or the remaining portion (section 451(j)(2)(A)(i))";
}
pub relation option_exercisable_within_days_of_entitlement(option: Integer, days: Integer) kind empirical {
    label en official "the option is exercisable not later than the stated number of days after the individual becomes entitled to the prize (section 451(j)(2)(A)(ii))";
}
pub relation is_qualified_prize_option_451j(option: Integer) kind institutional {
    label en official "a qualified prize option: single cash payment in lieu of a qualified prize, exercisable within 60 days of entitlement (section 451(j)(2)(A))";
}
@source(IRC_S451_J, quote = "is exercisable not later than 60 days after such individual becomes entitled to the qualified prize.")
rule QualifiedPrizeOptionDefinition(option: Integer, prize: Integer, n: Integer) defeasible {
    label en official "a cash-in-lieu option exercisable within 60 days, over a qualified prize, is a qualified prize option (section 451(j)(2)(A))";
    when option_entitles_single_cash_payment_in_lieu_of_prize(option, prize);
    when is_qualified_prize_451j(prize);
    when option_exercisable_within_days_of_entitlement(option, n);
    when n <= 60;
    then is_qualified_prize_option_451j(option);
}
pub relation cash_option_disregarded_for_inclusion_year(p: Person, option: Integer, y: TaxableYear) kind institutional {
    label en official "for an individual on the cash method, a qualified prize option is disregarded in determining the taxable year in which any portion of the prize is includible (section 451(j)(1))";
}
@source(IRC_S451_J, quote = "a qualified prize option shall be disregarded in determining the taxable year for which any portion of the qualified prize is properly includible in gross income of the taxpayer.")
rule QualifiedPrizeOptionDisregardedForCashIndividual(p: Person, option: Integer, y: TaxableYear) defeasible {
    label en official "the option does not accelerate inclusion for a cash-method individual (section 451(j)(1))";
    when is_individual_estate_or_trust_469(p);
    when uses_cash_method_451(p, y);
    when is_qualified_prize_option_451j(option);
    then cash_option_disregarded_for_inclusion_year(p, option, y);
}

// --- (k): qualifying electric transmission transactions ---

pub relation transaction_date_451k(tx: Integer, d: Date) kind empirical {
    label en official "the date of the sale or other disposition (section 451(k)(1)(A), (k)(3))";
}
pub relation disposes_of_transmission_property_or_stock_451k3(tx: Integer) kind empirical {
    label en official "the transaction is a sale or disposition of property used in providing electric transmission services, or of stock or a partnership interest in an entity whose principal business is providing them (section 451(k)(3)(A)-(B))";
}
pub relation transaction_to_independent_transmission_company(tx: Integer) kind empirical {
    label en official "the sale or disposition is to an independent transmission company within section 451(k)(4) — the FERC/PUCT approvals are EXTERNAL_DEPENDENCY case facts";
}
pub relation seller_in_transaction_451k(p: Person, tx: Integer) kind empirical {
    label en official "the taxpayer is the seller or transferor in the transaction (section 451(k)(1))";
}
pub relation seller_is_qualified_electric_utility_451k6(p: Person, tx: Integer) kind empirical {
    label en official "the taxpayer, as of the transaction date, is a vertically integrated qualified electric utility (section 451(k)(6)) — Federal Power Act definitions are case facts";
}
pub relation is_qualifying_electric_transmission_transaction(p: Person, tx: Integer) kind institutional {
    label en official "a qualifying electric transmission transaction: a covered disposition to an independent transmission company before 2008-01-01 (before 2021-01-01 for a qualified electric utility) (section 451(k)(3))";
}
@source(IRC_S451_K, quote = "means any sale or other disposition before January 1, 2008")
rule QualifyingTransmissionTransactionGeneral(p: Person, tx: Integer, d: Date) defeasible {
    label en official "a covered disposition to an independent transmission company before 2008 qualifies (section 451(k)(3))";
    when seller_in_transaction_451k(p, tx);
    when disposes_of_transmission_property_or_stock_451k3(tx);
    when transaction_to_independent_transmission_company(tx);
    when transaction_date_451k(tx, d);
    when d < @2008-01-01;
    then is_qualifying_electric_transmission_transaction(p, tx);
}
@source(IRC_S451_K, quote = "(before January 1, 2021, in the case of a qualified electric utility)")
rule QualifyingTransmissionTransactionQualifiedUtility(p: Person, tx: Integer, d: Date) defeasible {
    label en official "a qualified electric utility's covered disposition qualifies through 2020 (section 451(k)(3), (6))";
    when disposes_of_transmission_property_or_stock_451k3(tx);
    when transaction_to_independent_transmission_company(tx);
    when seller_is_qualified_electric_utility_451k6(p, tx);
    when transaction_date_451k(tx, d);
    when d < @2021-01-01;
    then is_qualifying_electric_transmission_transaction(p, tx);
}
pub relation elects_451k_treatment(p: Person, tx: Integer) kind empirical {
    label en official "the taxpayer elects the application of section 451(k) to the transaction (section 451(k)(1))";
}
pub relation election_451k_in_effect(p: Person, tx: Integer) kind institutional {
    label en official "the section 451(k) election is in effect and irrevocable (section 451(k)(10))";
}
@source(IRC_S451_K, quote = "An election under paragraph (1) shall be made at such time and in such manner as the Secretary may require and, once made, shall be irrevocable.")
rule Section451KElectionPower(p: Person, tx: Integer) strict {
    label en official "a taxpayer may elect section 451(k) for a qualifying transaction; the election is irrevocable (section 451(k)(1), (10))";
    when elects_451k_treatment(p, tx);
    then power Section451KElectricTransmissionElection {
        holder p;
        over tx;
        exercise elects_451k_treatment(p, tx);
        valid_when is_qualifying_electric_transmission_transaction(p, tx);
        effect create(election_451k_in_effect(p, tx));
        window [@1954-08-16, infinity);
    };
}
pub relation qualified_gain_451k2(p: Person, tx: Integer, amount: Money) kind empirical {
    label en official "the qualified gain: section 1245/1250 ordinary income plus other income required to be included for the year, determined without regard to (k) (section 451(k)(2))";
}
pub relation amount_realized_451k(p: Person, tx: Integer, amount: Money) kind empirical {
    label en official "the amount realized from the transaction (section 451(k)(1)(A))";
}
pub relation cost_of_exempt_utility_property_purchased_in_four_years(p: Person, tx: Integer, amount: Money) kind empirical {
    label en official "the cost of exempt utility property purchased during the 4-year period beginning on the transaction date, including property purchased by other consolidated members (section 451(k)(1)(A)(i), (7), (9))";
}
pub relation cost_previously_taken_into_account_451k(p: Person, tx: Integer, amount: Money) kind empirical {
    label en official "any portion of that cost previously taken into account under section 451(k) (section 451(k)(1)(A)(ii))";
}
pub relation qualified_gain_recognized_in_transaction_year(p: Person, tx: Integer, amount: Money) kind institutional {
    label en official "the qualified gain recognized in the transaction year: the part of the amount realized exceeding the net cost of exempt utility property purchased, capped at the qualified gain (section 451(k)(1)(A))";
}
@source(IRC_S451_K, quote = "in the taxable year which includes the date of such transaction to the extent the amount realized from such transaction exceeds—")
rule QualifiedGainRecognizedInTransactionYear(p: Person, tx: Integer, gain: Money, realized: Money, cost: Money, prior: Money) defeasible {
    label en official "recognized now = min(qualified gain, max(0, amount realized - max(0, purchased cost - previously used cost))) (section 451(k)(1)(A)); the paragraph's 'to the extent' reading is a JUDGMENT CALL";
    when election_451k_in_effect(p, tx);
    when qualified_gain_451k2(p, tx, gain);
    when amount_realized_451k(p, tx, realized);
    when cost_of_exempt_utility_property_purchased_in_four_years(p, tx, cost);
    when cost_previously_taken_into_account_451k(p, tx, prior);
    then qualified_gain_recognized_in_transaction_year(p, tx, min(gain, max(0.00 USD, round(realized - max(0.00 USD, round(cost - prior, 2, "HALF_UP")), 2, "HALF_UP"))));
}
pub relation qualified_gain_recognized_ratably_over_eight_years(p: Person, tx: Integer, per_year: Money) kind institutional {
    label en official "the qualified gain not recognized under (A) is recognized ratably over the 8-taxable-year period beginning with the transaction year: the per-year amount (section 451(k)(1)(B)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S451_K, quote = "ratably over the 8-taxable year period beginning with the taxable year which includes the date of such transaction, in the case of any such gain not recognized under subparagraph (A).")
rule QualifiedGainRatablyOverEightYears(p: Person, tx: Integer, gain: Money, now: Money) defeasible {
    label en official "the remainder of the qualified gain is spread over eight taxable years (section 451(k)(1)(B))";
    when qualified_gain_451k2(p, tx, gain);
    when qualified_gain_recognized_in_transaction_year(p, tx, now);
    when gain > now;
    then qualified_gain_recognized_ratably_over_eight_years(p, tx, div_round(round(gain - now, 2, "HALF_UP"), 8.0, 2, "HALF_UP"));
}
pub relation section_453_not_applicable_to_transaction_451k11(p: Person, tx: Integer) kind institutional {
    label en official "installment sale treatment under section 453 does not apply to an electing qualifying transaction (section 451(k)(11))";
}
@source(IRC_S451_K, quote = "Section 453 shall not apply to any qualifying electric transmission transaction with respect to which an election to apply this subsection is made.")
rule InstallmentTreatmentDeniedForElectingTransaction(p: Person, tx: Integer) defeasible {
    label en official "section 453 is unavailable once the section 451(k) election is made (section 451(k)(11))";
    when election_451k_in_effect(p, tx);
    then section_453_not_applicable_to_transaction_451k11(p, tx);
}
