// Small residual definitions (stage 3, DECISION-0379 with deontics): 447(e)(2),
// 451(k)(5),(7),(9), 455(d), 456(e), 458(b)(9), 470(d)(1)(B) and (f)(3)-(4),
// 471(c)(3), 472(g), 473(d)(2), 617(d)(2) and (f)(2)-(3), 636(d) and 638.
// Each is a derived relation beside the asserted stage 2 facts.
//
// Not modelled (TECH-GAPS G4809): the 617(d)(3) and (g) cross-references to
// sections 1245(b) and 751(b); the 473(e) matching of replacement goods; the
// 481(b)(2)-(3) multi-year tax comparison; the 470(e) disposition branches.

// ===================== 447(e)(2) =====================

use self::{
    Asset,
    IRC_S447_E,
    IRC_S451_K,
    IRC_S455_D,
    IRC_S456_E,
    IRC_S458_B,
    IRC_S470_D,
    IRC_S470_F,
    IRC_S471_C,
    IRC_S472_G,
    IRC_S473_D,
    IRC_S617_D,
    IRC_S617_F,
    IRC_S636_D,
    IRC_S638,
    Person,
    TaxableYear,
    adjusted_exploration_expenditures,
    depletion_property_614a,
    exploration_expenditures_617,
};

pub relation revenues_costs_expenses_on_accrual_method_447e2(p: Person, y: TaxableYear) kind empirical {
    label en official "revenues, costs, and expenses are computed on an accrual method of accounting (section 447(e)(2))";
}
pub relation preproductive_expenses_charged_to_crops_or_deducted_447e2(p: Person, y: TaxableYear) kind empirical {
    label en official "the preproductive period expenses incurred during the year are charged to harvested crops or deducted in determining taxable income (section 447(e)(2))";
}
pub relation annual_accrual_method_447e2(p: Person, y: TaxableYear) kind institutional {
    label en official "the annual accrual method of accounting: accrual computation with preproductive period expenses charged to harvested crops or deducted (section 447(e)(2))";
}
@source(IRC_S447_E, quote = "the term \"annual accrual method of accounting\" means a method under which revenues, costs, and expenses are computed on an accrual method of accounting")
rule AnnualAccrualMethodDefinition(p: Person, y: TaxableYear) strict {
    label en official "both limbs (section 447(e)(2))";
    when revenues_costs_expenses_on_accrual_method_447e2(p, y);
    when preproductive_expenses_charged_to_crops_or_deducted_447e2(p, y);
    then annual_accrual_method_447e2(p, y);
}

// ===================== 451(k)(5), (7), (9) =====================

pub relation property_used_in_electricity_business_451k5Ai(prop: Asset) kind empirical {
    label en official "the property is used in the trade or business of generating, transmitting, distributing, or selling electricity (section 451(k)(5)(A)(i))";
}
pub relation property_used_in_natural_gas_business_451k5Aii(prop: Asset) kind empirical {
    label en official "the property is used in the trade or business of producing, transmitting, distributing, or selling natural gas (section 451(k)(5)(A)(ii))";
}
pub relation property_located_outside_united_states_451k5C(prop: Asset) kind empirical {
    label en official "the property is located outside the United States (section 451(k)(5)(C))";
}
pub relation exempt_utility_property_451k5(prop: Asset) kind institutional {
    label en official "exempt utility property: property used in the electricity or natural gas business, and not located outside the United States (section 451(k)(5))";
}
@source(IRC_S451_K, quote = "(i) generating, transmitting, distributing, or selling electricity, or")
rule ExemptUtilityPropertyElectricity(prop: Asset) defeasible {
    label en official "(A)(i), less (C)";
    when property_used_in_electricity_business_451k5Ai(prop);
    when not_known(property_located_outside_united_states_451k5C(prop));
    then exempt_utility_property_451k5(prop);
}
@source(IRC_S451_K, quote = "(ii) producing, transmitting, distributing, or selling natural gas.")
rule ExemptUtilityPropertyNaturalGas(prop: Asset) defeasible {
    label en official "(A)(ii), less (C)";
    when property_used_in_natural_gas_business_451k5Aii(prop);
    when not_known(property_located_outside_united_states_451k5C(prop));
    then exempt_utility_property_451k5(prop);
}
pub relation corporation_principal_business_is_utility_business_451k5B(corp: Person) kind empirical {
    label en official "the principal trade or business of the corporation is a business referred to in (5)(A) (section 451(k)(5)(B))";
}
pub relation control_acquisition_taken_into_account_451k5B(corp: Person) kind institutional {
    label en official "acquisition of control of the corporation counts for a qualifying electric transmission transaction only if its principal business is a (5)(A) business (section 451(k)(5)(B))";
}
@source(IRC_S451_K, quote = "only if the principal trade or business of such corporation is a trade or business referred to in subparagraph (A).")
rule ControlAcquisitionCountsForUtilityCorporation(corp: Person) strict {
    label en official "(5)(B)";
    when corporation_principal_business_is_utility_business_451k5B(corp);
    then control_acquisition_taken_into_account_451k5B(corp);
}
pub relation member_of_consolidated_affiliated_group_451k7(member: Person, other: Person) kind empirical {
    label en official "the two are members of an affiliated group filing a consolidated return (section 451(k)(7))";
}
pub relation purchased_by_group_member_451k7(other: Person, prop: Asset) kind empirical {
    label en official "the exempt utility property was purchased by the other member (section 451(k)(7))";
}
pub relation treated_as_purchased_by_member_451k7(member: Person, prop: Asset) kind institutional {
    label en official "property purchased by another member of the consolidated group is treated as purchased by the corporation for (1)(A) (section 451(k)(7))";
}
@source(IRC_S451_K, quote = "any exempt utility property purchased by another member of such group shall be treated as purchased by such corporation for purposes of applying paragraph (1)(A).")
rule ConsolidatedGroupPurchaseAttributed(member: Person, other: Person, prop: Asset) defeasible {
    label en official "purchase by another member (section 451(k)(7))";
    when member_of_consolidated_affiliated_group_451k7(member, other);
    when purchased_by_group_member_451k7(other, prop);
    when exempt_utility_property_451k5(prop);
    then treated_as_purchased_by_member_451k7(member, prop);
}
pub relation unadjusted_basis_is_cost_within_1012_451k9(prop: Asset) kind empirical {
    label en official "the unadjusted basis of the property is its cost within the meaning of section 1012 (section 451(k)(9))";
}
pub relation considered_purchased_451k9(taxpayer: Person, prop: Asset) kind institutional {
    label en official "the taxpayer is considered to have purchased the property (section 451(k)(9))";
}
pub relation taxpayer_holds_property_451k9(taxpayer: Person, prop: Asset) kind empirical {
    label en official "the taxpayer holds the property (section 451(k)(9))";
}
@source(IRC_S451_K, quote = "the taxpayer shall be considered to have purchased any property if the unadjusted basis of such property is its cost within the meaning of section 1012.")
rule ConsideredPurchasedWhenBasisIsCost(taxpayer: Person, prop: Asset) strict {
    label en official "unadjusted basis equal to cost (section 451(k)(9))";
    when taxpayer_holds_property_451k9(taxpayer, prop);
    when unadjusted_basis_is_cost_within_1012_451k9(prop);
    then considered_purchased_451k9(taxpayer, prop);
}

// ===================== 455(d), 456(e), 458(b)(9) =====================

pub relation amount_received_for_periodical_subscription_455d1(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "an amount includible in gross income received for a subscription to a newspaper, magazine, or other periodical (section 455(d)(1))";
}
pub relation liability_extends_beyond_close_of_receipt_year_455d1(item: Integer) kind empirical {
    label en official "the liability to furnish or deliver the periodical extends beyond the close of the year in which the amount is received (section 455(d)(1))";
}
pub relation prepaid_subscription_income_455d1(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "prepaid subscription income: an amount received for a periodical subscription, directly attributable to a liability extending beyond the close of the year (section 455(d)(1))";
}
@source(IRC_S455_D, quote = "The term \"prepaid subscription income\" means any amount (includible in gross income) which is received in connection with, and is directly attributable to, a liability which extends beyond the close of the taxable year in which such amount is received")
rule PrepaidSubscriptionIncomeDefinition(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "section 455(d)(1)";
    when amount_received_for_periodical_subscription_455d1(p, y, item);
    when liability_extends_beyond_close_of_receipt_year_455d1(item);
    then prepaid_subscription_income_455d1(p, y, item);
}
pub relation year_includible_under_451_without_455_455d3(p: Person, item: Integer, y_inclusion: TaxableYear) kind empirical {
    label en official "the taxable year for which the amount is includible in gross income under section 451 without regard to section 455 (section 455(d)(3))";
}
pub relation prepaid_subscription_income_treated_as_received_in_455d3(p: Person, item: Integer, y_inclusion: TaxableYear) kind institutional {
    label en official "prepaid subscription income is treated as received during the year for which it is includible under section 451 (section 455(d)(3))";
}
@source(IRC_S455_D, quote = "Prepaid subscription income shall be treated as received during the taxable year for which it is includible in gross income under section 451 (without regard to this section).")
rule PrepaidSubscriptionIncomeTreatedAsReceivedInInclusionYear(p: Person, y: TaxableYear, item: Integer, y_inclusion: TaxableYear) strict {
    label en official "section 455(d)(3)";
    when prepaid_subscription_income_455d1(p, y, item);
    when year_includible_under_451_without_455_455d3(p, item, y_inclusion);
    then prepaid_subscription_income_treated_as_received_in_455d3(p, item, y_inclusion);
}
pub relation amount_received_by_membership_organization_for_dues_456e1(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "an amount includible in gross income received by a membership organization as dues (section 456(e)(1))";
}
pub relation liability_to_render_services_beyond_close_of_receipt_year_456e1(item: Integer) kind empirical {
    label en official "the liability to render services or make available membership privileges extends beyond the close of the year of receipt (section 456(e)(1))";
}
pub relation prepaid_dues_income_456e1(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "prepaid dues income of a membership organization (section 456(e)(1))";
}
@source(IRC_S456_E, quote = "The term \"prepaid dues income\" means any amount (includible in gross income) which is received by a membership organization")
rule PrepaidDuesIncomeDefinition(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "section 456(e)(1)";
    when amount_received_by_membership_organization_for_dues_456e1(p, y, item);
    when liability_to_render_services_beyond_close_of_receipt_year_456e1(item);
    then prepaid_dues_income_456e1(p, y, item);
}
pub relation year_includible_under_451_without_456_456e4(p: Person, item: Integer, y_inclusion: TaxableYear) kind empirical {
    label en official "the taxable year for which the amount is includible in gross income under section 451 without regard to section 456 (section 456(e)(4))";
}
pub relation prepaid_dues_income_treated_as_received_in_456e4(p: Person, item: Integer, y_inclusion: TaxableYear) kind institutional {
    label en official "prepaid dues income is treated as received during the year for which it is includible under section 451 (section 456(e)(4))";
}
@source(IRC_S456_E, quote = "Prepaid dues income shall be treated as received during the taxable year for which it is includible in gross income under section 451 (without regard to this section).")
rule PrepaidDuesIncomeTreatedAsReceivedInInclusionYear(p: Person, y: TaxableYear, item: Integer, y_inclusion: TaxableYear) strict {
    label en official "section 456(e)(4)";
    when prepaid_dues_income_456e1(p, y, item);
    when year_includible_under_451_without_456_456e4(p, item, y_inclusion);
    then prepaid_dues_income_treated_as_received_in_456e4(p, item, y_inclusion);
}
pub relation repurchase_by_taxpayer_458b9(sale: Integer) kind empirical {
    label en official "a repurchase by the taxpayer of returned goods (section 458(b)(9))";
}
pub relation repurchase_treated_as_price_adjustment_458b9(sale: Integer) kind institutional {
    label en official "a repurchase by the taxpayer is an adjustment of the sales price rather than a resale (section 458(b)(9))";
}
@source(IRC_S458_B, quote = "A repurchase by the taxpayer shall be treated as an adjustment of the sales price rather than as a resale.")
rule RepurchaseIsAPriceAdjustment(sale: Integer) strict {
    label en official "section 458(b)(9)";
    when repurchase_by_taxpayer_458b9(sale);
    then repurchase_treated_as_price_adjustment_458b9(sale);
}

// ===================== 470(d)(1)(B), (f)(3)-(4) =====================

pub enum LeaseArrangement470 {
    DefeasanceArrangement;
    LoanByLesseeToLessorOrLender;
    DepositArrangement;
    LetterOfCreditCollateralizedWithCash;
    PaymentUndertakingAgreement;
    PrepaidRent;
    SinkingFundArrangement;
    GuaranteedInvestmentContract;
    label en official "arrangements named in section 470(d)(1)(B): the list is 'include', so an arrangement outside it may still qualify by its function";
}
pub relation lease_arrangement_of_kind_470d1B(lease: Integer, arrangement: Integer, kind: LeaseArrangement470) kind empirical {
    label en official "an arrangement under the lease is of the named kind (section 470(d)(1)(B))";
}
pub relation arrangement_within_470d1B(lease: Integer, arrangement: Integer) kind institutional {
    label en official "the arrangement is among those referred to in (d)(1)(B) by its named kind (section 470(d)(1)(B))";
}
@source(IRC_S470_D, quote = "The arrangements referred to in this subparagraph include a defeasance arrangement")
rule NamedArrangementIsWithinSubparagraphB(lease: Integer, arrangement: Integer, kind: LeaseArrangement470) strict {
    label en official "the named kinds (section 470(d)(1)(B))";
    when lease_arrangement_of_kind_470d1B(lease, arrangement, kind);
    then arrangement_within_470d1B(lease, arrangement);
}
pub relation loan_to_lessor_secured_by_lease_or_leased_property_470f3(lender: Person, lease: Integer, loan: Integer) kind empirical {
    label en official "the person makes a loan to the lessor which is secured (or economically similar to being secured) by the lease or the leased property (section 470(f)(3))";
}
pub relation lender_of_lease_470f3(lender: Person, lease: Integer) kind institutional {
    label en official "a lender: a person that makes a loan to the lessor secured, or economically similar to secured, by the lease or leased property (section 470(f)(3))";
}
@source(IRC_S470_F, quote = "The term \"lender\" means, with respect to any lease, a person that makes a loan to the lessor which is secured (or economically similar to being secured) by the lease or the leased property.")
rule LenderDefinition(lender: Person, lease: Integer, loan: Integer) strict {
    label en official "section 470(f)(3)";
    when loan_to_lessor_secured_by_lease_or_leased_property_470f3(lender, lease, loan);
    then lender_of_lease_470f3(lender, lease);
}
pub relation similar_arrangement_to_a_loan_470f4(arrangement: Integer) kind empirical {
    label en official "the arrangement is similar to a loan (section 470(f)(4))";
}
pub relation treated_as_loan_470f4(arrangement: Integer) kind institutional {
    label en official "a loan includes any similar arrangement (section 470(f)(4))";
}
@source(IRC_S470_F, quote = "The term \"loan\" includes any similar arrangement.")
rule LoanIncludesSimilarArrangement(arrangement: Integer) strict {
    label en official "section 470(f)(4)";
    when similar_arrangement_to_a_loan_470f4(arrangement);
    then treated_as_loan_470f4(arrangement);
}

// ===================== 471(c)(3), 472(g), 473(d)(2) =====================

pub relation taxpayer_is_corporation_or_partnership_471c3(p: Person) kind empirical {
    label en official "the taxpayer is a corporation or a partnership (section 471(c)(3))";
}
pub relation taxpayer_trade_or_business_471c3(p: Person, business: Integer) kind empirical {
    label en official "a trade or business of the taxpayer (section 471(c)(3))";
}
pub relation gross_receipts_test_applied_to_business_as_entity_471c3(p: Person, business: Integer) kind institutional {
    label en official "for a taxpayer that is neither a corporation nor a partnership, the section 448(c) test is applied as if each trade or business were a corporation or partnership (section 471(c)(3))";
}
@source(IRC_S471_C, quote = "the gross receipts test of section 448(c) shall be applied in the same manner as if each trade or business of such taxpayer were a corporation or partnership.")
rule GrossReceiptsTestAppliedPerBusiness(p: Person, business: Integer) defeasible {
    label en official "each trade or business is tested as an entity (section 471(c)(3))";
    when taxpayer_trade_or_business_471c3(p, business);
    when not_known(taxpayer_is_corporation_or_partnership_471c3(p));
    then gross_receipts_test_applied_to_business_as_entity_471c3(p, business);
}
pub relation affiliated_group_at_fifty_percent_472g2A(a: Person, b: Person) kind empirical {
    label en official "the two belong to an affiliated group under section 1504 with 50 percent for 80 percent and without regard to section 1504(b) (section 472(g)(2)(A)); the section 1504 test is asserted";
}
pub relation consolidate_or_combine_for_financial_statements_472g2B(a: Person, b: Person) kind empirical {
    label en official "the two are corporations that consolidate or combine for purposes of financial statements (section 472(g)(2)(B))";
}
pub relation financially_related_corporations_472g2(a: Person, b: Person) kind institutional {
    label en official "members of the same group of financially related corporations (section 472(g)(2))";
}
@source(IRC_S472_G, quote = "(B) any other group of corporations which consolidate or combine for purposes of financial statements.")
rule FinanciallyRelatedByFinancialStatements(a: Person, b: Person) strict {
    label en official "(2)(B)";
    when consolidate_or_combine_for_financial_statements_472g2B(a, b);
    then financially_related_corporations_472g2(a, b);
}
@source(IRC_S472_G, quote = "(A) any affiliated group as defined in section 1504 determined by substituting \"50 percent\" for \"80 percent\" each place it appears in section 1504(a) and without regard to section 1504(b), and")
rule FinanciallyRelatedByAffiliation(a: Person, b: Person) strict {
    label en official "(2)(A)";
    when affiliated_group_at_fifty_percent_472g2A(a, b);
    then financially_related_corporations_472g2(a, b);
}
pub relation regulations_provide_otherwise_472g1(a: Person) kind empirical {
    label en official "regulations provide otherwise for the corporation (section 472(g)(1)); asserted";
}
pub relation treated_as_one_taxpayer_472g1(a: Person, b: Person) kind institutional {
    label en official "members of the same group of financially related corporations are one taxpayer for the conformity rules of (c) and (e)(2), except as regulations provide (section 472(g)(1))";
}
@source(IRC_S472_G, quote = "all members of the same group of financially related corporations shall be treated as 1 taxpayer for purposes of subsections (c) and (e)(2).")
rule FinanciallyRelatedGroupIsOneTaxpayer(a: Person, b: Person) defeasible {
    label en official "one taxpayer for (c) and (e)(2) (section 472(g)(1))";
    when financially_related_corporations_472g2(a, b);
    when not_known(regulations_provide_otherwise_472g1(a));
    then treated_as_one_taxpayer_472g1(a, b);
}
pub relation year_in_replacement_period_473(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is in the replacement period (section 473(d)(2))";
}
pub relation replacement_of_liquidated_goods_completed_in_473(p: Person, y_done: TaxableYear) kind empirical {
    label en official "replacement of the liquidated goods is completed in the taxable year (section 473(d)(2))";
}
pub relation replacement_year_473d2(p: Person, y: TaxableYear) kind institutional {
    label en official "a replacement year: a year in the replacement period, except a year after the year in which replacement is completed (section 473(d)(2))";
}
@source(IRC_S473_D, quote = "any taxable year in the replacement period; except that such term shall not include any taxable year after the taxable year in which replacement of the liquidated goods is completed.")
rule ReplacementYearUntilCompletion(p: Person, y: TaxableYear, y_done: TaxableYear, begins_on: Date, done_begins_on: Date) defeasible {
    label en official "a year in the period that does not begin after the completion year (section 473(d)(2))";
    when year_in_replacement_period_473(p, y);
    when replacement_of_liquidated_goods_completed_in_473(p, y_done);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::begins(y_done, done_begins_on);
    when begins_on <= done_begins_on;
    then replacement_year_473d2(p, y);
}
rule ReplacementYearWithoutCompletion(p: Person, y: TaxableYear) defeasible {
    label en official "a year in the period when replacement is not yet complete (section 473(d)(2))";
    when year_in_replacement_period_473(p, y);
    when not_known(replacement_completed_bridge_473(p));
    then replacement_year_473d2(p, y);
}
pub relation replacement_completed_bridge_473(p: Person) kind institutional {
    label en official "replacement has been completed in some year (bridge)";
}
rule ReplacementCompletedBridge(p: Person, y_done: TaxableYear) strict {
    label en official "bridge";
    when replacement_of_liquidated_goods_completed_in_473(p, y_done);
    then replacement_completed_bridge_473(p);
}

// ===================== 617(d)(2), (f)(2)-(3), 636(d) =====================

pub enum MiningDispositionKind617 {
    PortionOtherThanUndividedInterest;
    UndividedInterest;
    label en official "the disposition kinds of section 617(d)(2)(A)-(B)";
}
pub relation mining_disposition_kind_617d2(prop: Integer, kind: MiningDispositionKind617) kind empirical {
    label en official "the disposition is of a portion (other than an undivided interest) or of an undivided interest in the mining property (section 617(d)(2))";
}
pub relation undivided_interest_fraction_617d2B(prop: Integer, numerator: Integer, denominator: Integer) kind empirical {
    label en official "the fraction of the property the undivided interest represents (section 617(d)(2)(B))";
}
pub relation gain_to_which_617d1_applies(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the amount of the gain to which paragraph (1) applies (section 617(d)(2))";
}
pub relation expenditure_relates_to_neither_disposed_portion_nor_producing_mine_617d2(p: Person, prop: Integer) kind empirical {
    label en official "the taxpayer establishes to the Secretary's satisfaction that the expenditure relates neither to the portion or interest disposed of nor to any mine of the retained property that has reached the producing stage (section 617(d)(2), last sentence); an adjudicated fact";
}
pub relation adjusted_exploration_expenditures_attributed_617d2(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the adjusted exploration expenditures attributed to the disposed portion: all of them for a portion, a proportionate part for an undivided interest, each to the extent of the gain; one rounding to cents HALF_UP for the proportion (JUDGMENT CALL) (section 617(d)(2))";
}
@source(IRC_S617_D, quote = "(A) In the case of the disposition of a portion of a mining property (other than an undivided interest), the entire amount of the adjusted exploration expenditures with respect to such property shall be treated as attributable to such portion to the extent of the amount of the gain to which paragraph (1) applies.")
rule AdjustedExplorationExpendituresAttributedToPortion(p: Person, y: TaxableYear, prop: Integer, adjusted: Money, gain: Money) defeasible {
    label en official "min(all adjusted expenditures, gain) for a portion (section 617(d)(2)(A))";
    when mining_disposition_kind_617d2(prop, PortionOtherThanUndividedInterest);
    when adjusted_exploration_expenditures(p, prop, adjusted);
    when gain_to_which_617d1_applies(p, y, prop, gain);
    when not_known(expenditure_relates_to_neither_disposed_portion_nor_producing_mine_617d2(p, prop));
    then adjusted_exploration_expenditures_attributed_617d2(p, y, prop, min(adjusted, gain));
}
@source(IRC_S617_D, quote = "(B) In the case of the disposition of an undivided interest in a mining property (or a portion thereof), a proportionate part of the adjusted exploration expenditures with respect to such property shall be treated as attributable to such undivided interest to the extent of the amount of the gain to which paragraph (1) applies.")
rule AdjustedExplorationExpendituresAttributedToUndividedInterest(p: Person, y: TaxableYear, prop: Integer, adjusted: Money, gain: Money, num: Integer, den: Integer) defeasible {
    label en official "min(adjusted x fraction, gain) for an undivided interest (section 617(d)(2)(B))";
    when mining_disposition_kind_617d2(prop, UndividedInterest);
    when undivided_interest_fraction_617d2B(prop, num, den);
    when den > 0;
    when adjusted_exploration_expenditures(p, prop, adjusted);
    when gain_to_which_617d1_applies(p, y, prop, gain);
    when not_known(expenditure_relates_to_neither_disposed_portion_nor_producing_mine_617d2(p, prop));
    then adjusted_exploration_expenditures_attributed_617d2(p, y, prop, min(div_round(adjusted * num, den * 1.0, 2, "HALF_UP"), gain));
}
pub relation mining_property_617f2(p: Person, prop: Integer) kind institutional {
    label en official "mining property: a section 614 property to which section 617(a)(1) expenditures are properly chargeable (section 617(f)(2))";
}
@source(IRC_S617_F, quote = "The term \"mining property\" means any property (within the meaning of section 614 after the application of subsections (c) and (e) thereof)")
rule MiningPropertyDefinition(p: Person, prop: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a depletion property with exploration expenditures chargeable (section 617(f)(2))";
    when depletion_property_614a(p, prop);
    when exploration_expenditures_617(p, y, prop, amount);
    then mining_property_617f2(p, prop);
}
pub relation disposal_of_coal_or_iron_ore_under_631c_617f3(p: Person, prop: Integer) kind empirical {
    label en official "a transaction which is a disposal of coal or iron ore under section 631(c) (section 617(f)(3))";
}
pub relation gain_referred_to_in_631c_617f3(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "the gain, if any, referred to in section 631(c) (section 617(f)(3))";
}
pub relation section_631c_disposal_treated_as_disposition_617f3(p: Person, prop: Integer) kind institutional {
    label en official "a section 631(c) disposal is a disposition for section 617 (section 617(f)(3))";
}
@source(IRC_S617_F, quote = "A transaction which constitutes a disposal of coal or iron ore under section 631(c) shall be treated as a disposition.")
rule Section631cDisposalIsADisposition(p: Person, prop: Integer) strict {
    label en official "section 617(f)(3)";
    when disposal_of_coal_or_iron_ore_under_631c_617f3(p, prop);
    then section_631c_disposal_treated_as_disposition_617f3(p, prop);
}
pub relation excess_under_617d1B_equals_631c_gain_617f3(p: Person, prop: Integer, amount: Money) kind institutional {
    label en official "for a section 631(c) disposal the excess of (d)(1)(B) equals the section 631(c) gain (section 617(f)(3))";
}
rule ExcessEqualsSection631cGain(p: Person, prop: Integer, gain: Money) strict {
    label en official "the excess is the gain (section 617(f)(3), second sentence)";
    when section_631c_disposal_treated_as_disposition_617f3(p, prop);
    when gain_referred_to_in_631c_617f3(p, prop, gain);
    then excess_under_617d1B_equals_631c_gain_617f3(p, prop, gain);
}
pub relation mineral_property_636d(p: Person, interest: Integer) kind institutional {
    label en official "mineral property: the property of section 614(a) (section 636(d))";
}
@source(IRC_S636_D, quote = "the term \"mineral property\" has the meaning assigned to the term \"property\" in section 614(a).")
rule MineralPropertyIsSection614Property(p: Person, interest: Integer) defeasible {
    label en official "section 636(d)";
    when depletion_property_614a(p, interest);
    then mineral_property_636d(p, interest);
}

// ===================== 638 =====================

pub relation submarine_area_adjacent_to_united_states_638(area: Integer) kind empirical {
    label en official "the seabed and subsoil area is adjacent to the territorial waters of the United States (section 638(1))";
}
pub relation united_states_has_exclusive_rights_in_area_638(area: Integer) kind empirical {
    label en official "the United States has exclusive rights in the area, in accordance with international law, for exploration and exploitation of natural resources (section 638(1))";
}
pub relation area_within_united_states_geographic_sense_638(area: Integer) kind institutional {
    label en official "the area is within 'United States' in a geographical sense (section 638(1))";
}
@source(IRC_S638, quote = "(1) the term \"United States\" when used in a geographical sense includes the seabed and subsoil of those submarine areas which are adjacent to the territorial waters of the United States")
rule SubmarineAreaWithinUnitedStates(area: Integer) strict {
    label en official "section 638(1)";
    when submarine_area_adjacent_to_united_states_638(area);
    when united_states_has_exclusive_rights_in_area_638(area);
    then area_within_united_states_geographic_sense_638(area);
}
pub relation submarine_area_adjacent_to_foreign_country_or_possession_638(area: Integer, country: Integer) kind empirical {
    label en official "the area is adjacent to the territorial waters of the foreign country or United States possession (section 638(2))";
}
pub relation country_or_possession_has_exclusive_rights_in_area_638(area: Integer, country: Integer) kind empirical {
    label en official "the foreign country (or the United States for a possession) has exclusive rights in the area under international law for exploration and exploitation (section 638(2))";
}
pub relation area_within_foreign_country_or_possession_geographic_sense_638(area: Integer, country: Integer) kind institutional {
    label en official "the area is within 'foreign country' or 'possession of the United States' in a geographical sense (section 638(2))";
}
@source(IRC_S638, quote = "(2) the terms \"foreign country\" and \"possession of the United States\" when used in a geographical sense include the seabed and subsoil of those submarine areas")
rule SubmarineAreaWithinForeignCountryOrPossession(area: Integer, country: Integer) strict {
    label en official "section 638(2)";
    when submarine_area_adjacent_to_foreign_country_or_possession_638(area, country);
    when country_or_possession_has_exclusive_rights_in_area_638(area, country);
    then area_within_foreign_country_or_possession_geographic_sense_638(area, country);
}
pub relation contiguity_not_established_by_section_638(country: Integer) kind institutional {
    label en official "no foreign country is treated as a country contiguous to the United States by reason of the section 638 inclusion (section 638, last sentence)";
}
@source(IRC_S638, quote = "No foreign country shall, by reason of the application of this section, be treated as a country contiguous to the United States.")
rule NoContiguityByReasonOfSection638(area: Integer, country: Integer) strict {
    label en official "the inclusion does not create contiguity (section 638, last sentence)";
    when area_within_foreign_country_or_possession_geographic_sense_638(area, country);
    then contiguity_not_established_by_section_638(country);
}
