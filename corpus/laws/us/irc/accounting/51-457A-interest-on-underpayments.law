@source(IRC_S457A_C, quote = "the interest determined under this paragraph for any taxable year is the amount of interest at the underpayment rate under section 6621 plus 1 percentage point on the underpayments that would have occurred")
rule InterestOnUnderpaymentsIsBalanceMinusPrincipal(plan: Integer, y: TaxableYear, bal: Money, prin: Money) defeasible {
    label en official "interest = compounded balance - sum of the underpayments (section 457A(c)(2))";
    when interest_balance_at_inclusion_457Ac2(plan, y, bal, prin);
    then interest_on_underpayments_457Ac2(plan, y, bal - prin);
}
pub relation interest_added_to_tax_457Ac1Bi(plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax of the year of inclusion is increased by the amount of interest determined under paragraph (2) (section 457A(c)(1)(B)(i))";
}
@source(IRC_S457A_C, quote = "(i) the amount of interest determined under paragraph (2), and")
rule TaxIncreasedByInterestOfParagraph2(plan: Integer, y: TaxableYear, interest: Money) defeasible {
    label en official "the interest of paragraph (2) increases the tax of the year of inclusion (section 457A(c)(1)(B)(i))";
    when compensation_amount_not_determinable_when_otherwise_includible_457Ac1(plan);
    when interest_on_underpayments_457Ac2(plan, y, interest);
    then interest_added_to_tax_457Ac1Bi(plan, y, interest);
}
pub relation total_additional_tax_457Ac1B(plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase of the tax of the year of inclusion: the interest of (B)(i) plus 20 percent of the compensation of (B)(ii) (section 457A(c)(1)(B))";
}
rule TotalAdditionalTaxIsInterestPlusTwentyPercent(plan: Integer, y: TaxableYear, interest: Money, twenty: Money) defeasible {
    label en official "interest + 20 percent (section 457A(c)(1)(B))";
    when interest_added_to_tax_457Ac1Bi(plan, y, interest);
    when additional_tax_of_twenty_percent_457Ac1Bii(plan, y, twenty);
    then total_additional_tax_457Ac1B(plan, y, interest + twenty);
}

