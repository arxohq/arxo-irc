relation interest_full_period_457A_9(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 9: the next year is not yet the year of inclusion; the daily step and the days of the period";
}
relation interest_state_457A_9(plan: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 9: the balance at the start of the period after year number 10, with the sum of the underpayments so far";
}
rule InterestLevel0(plan: Integer, y0: TaxableYear) defeasible {
    label en official "the walk starts at the interest start year (section 457A(c)(2))";
    when interest_start_year_457Ac2(plan, y0);
    then interest_level_457A_0(plan, y0);
}
rule InterestState0(plan: Integer, y0: TaxableYear, d0: Money) defeasible {
    label en official "the balance starts with the start year's underpayment (section 457A(c)(2))";
    when interest_start_year_457Ac2(plan, y0);
    when underpayment_of_year_457Ac2(plan, y0, d0);
    then interest_state_457A_0(plan, y0, d0, d0);
}
rule InterestFinalPeriod0(plan: Integer, p: Person, y: TaxableYear, y_incl: TaxableYear, due: Date, due_incl: Date, r: Decimal) defeasible {
    label en official "the next year is the year of inclusion: daily interest up to its return due date at the underpayment rate plus 1 point (section 457A(c)(2))";
    when interest_level_457A_0(plan, y);
    when plan_of_nonqualified_entity_457A(plan, p);
    when preceding_taxable_year_465(y, y_incl);
    when inclusion_year_of_undeterminable_compensation_457Ac1A(plan, y_incl);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_incl, due_incl);
    when interest_rate_of_underpayment_plus_one_point_457Ac2(y, r);
    then interest_final_period_457A_0(plan, y, y_incl, div_round(r, 365.0, 12, "HALF_UP"), days_between(due, due_incl));
}
rule InterestFullPeriod0(plan: Integer, p: Person, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date, r: Decimal) defeasible {
    label en official "the next year is not the year of inclusion: daily interest for the whole period (section 457A(c)(2))";
    when interest_level_457A_0(plan, y);
    when plan_of_nonqualified_entity_457A(plan, p);
    when preceding_taxable_year_465(y, y_next);
    when not_known(inclusion_year_of_undeterminable_compensation_457Ac1A(plan, y_next));
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    when interest_rate_of_underpayment_plus_one_point_457Ac2(y, r);
    then interest_full_period_457A_0(plan, y, y_next, div_round(r, 365.0, 12, "HALF_UP"), days_between(due, due_next));
}
rule InterestRequestFinal0(plan: Integer, y: TaxableYear, y_incl: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the daily growth factor of the last period";
    when interest_final_period_457A_0(plan, y, y_incl, step, days);
    then growth_request(step, days);
}
rule InterestRequestFull0(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the daily growth factor of the full period";
    when interest_full_period_457A_0(plan, y, y_next, step, days);
    then growth_request(step, days);
}
rule InterestRequestNextUnderpayment0(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the next year's underpayment";
    when interest_full_period_457A_0(plan, y, y_next, step, days);
    then underpayment_year_request_457Ac2(plan, y_next);
}
rule InterestBalanceAtInclusion0(plan: Integer, y: TaxableYear, y_incl: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal) defeasible {
    label en official "the final balance: the balance grown over the last period, rounded to cents HALF_UP (JUDGMENT CALL)";
    when interest_state_457A_0(plan, y, bal, prin);
    when interest_final_period_457A_0(plan, y, y_incl, step, days);
    when growth_factor(step, days, f);
    then interest_balance_at_inclusion_457Ac2(plan, y_incl, round(bal * f, 2, "HALF_UP"), prin);
}
rule InterestLevel1(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "the walk moves to the next period";
    when interest_full_period_457A_0(plan, y, y_next, step, days);
    then interest_level_457A_1(plan, y_next);
}
rule InterestState1From0(plan: Integer, y: TaxableYear, y_next: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal, dn: Money) defeasible {
    label en official "the balance grown over the full period plus the next year's underpayment starts the next level (section 457A(c)(2))";
    when interest_state_457A_0(plan, y, bal, prin);
    when interest_full_period_457A_0(plan, y, y_next, step, days);
    when growth_factor(step, days, f);
    when underpayment_of_year_457Ac2(plan, y_next, dn);
    then interest_state_457A_1(plan, y_next, round(bal * f, 2, "HALF_UP") + dn, prin + dn);
}
rule InterestFinalPeriod1(plan: Integer, p: Person, y: TaxableYear, y_incl: TaxableYear, due: Date, due_incl: Date, r: Decimal) defeasible {
    label en official "the next year is the year of inclusion: daily interest up to its return due date at the underpayment rate plus 1 point (section 457A(c)(2))";
    when interest_level_457A_1(plan, y);
    when plan_of_nonqualified_entity_457A(plan, p);
    when preceding_taxable_year_465(y, y_incl);
    when inclusion_year_of_undeterminable_compensation_457Ac1A(plan, y_incl);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_incl, due_incl);
    when interest_rate_of_underpayment_plus_one_point_457Ac2(y, r);
    then interest_final_period_457A_1(plan, y, y_incl, div_round(r, 365.0, 12, "HALF_UP"), days_between(due, due_incl));
}
rule InterestFullPeriod1(plan: Integer, p: Person, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date, r: Decimal) defeasible {
    label en official "the next year is not the year of inclusion: daily interest for the whole period (section 457A(c)(2))";
    when interest_level_457A_1(plan, y);
    when plan_of_nonqualified_entity_457A(plan, p);
    when preceding_taxable_year_465(y, y_next);
    when not_known(inclusion_year_of_undeterminable_compensation_457Ac1A(plan, y_next));
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    when interest_rate_of_underpayment_plus_one_point_457Ac2(y, r);
    then interest_full_period_457A_1(plan, y, y_next, div_round(r, 365.0, 12, "HALF_UP"), days_between(due, due_next));
}
rule InterestRequestFinal1(plan: Integer, y: TaxableYear, y_incl: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the daily growth factor of the last period";
    when interest_final_period_457A_1(plan, y, y_incl, step, days);
    then growth_request(step, days);
}
rule InterestRequestFull1(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the daily growth factor of the full period";
    when interest_full_period_457A_1(plan, y, y_next, step, days);
    then growth_request(step, days);
}
rule InterestRequestNextUnderpayment1(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the next year's underpayment";
    when interest_full_period_457A_1(plan, y, y_next, step, days);
    then underpayment_year_request_457Ac2(plan, y_next);
}
rule InterestBalanceAtInclusion1(plan: Integer, y: TaxableYear, y_incl: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal) defeasible {
    label en official "the final balance: the balance grown over the last period, rounded to cents HALF_UP (JUDGMENT CALL)";
    when interest_state_457A_1(plan, y, bal, prin);
    when interest_final_period_457A_1(plan, y, y_incl, step, days);
    when growth_factor(step, days, f);
    then interest_balance_at_inclusion_457Ac2(plan, y_incl, round(bal * f, 2, "HALF_UP"), prin);
}
rule InterestLevel2(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "the walk moves to the next period";
    when interest_full_period_457A_1(plan, y, y_next, step, days);
    then interest_level_457A_2(plan, y_next);
}
rule InterestState2From1(plan: Integer, y: TaxableYear, y_next: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal, dn: Money) defeasible {
    label en official "the balance grown over the full period plus the next year's underpayment starts the next level (section 457A(c)(2))";
    when interest_state_457A_1(plan, y, bal, prin);
    when interest_full_period_457A_1(plan, y, y_next, step, days);
    when growth_factor(step, days, f);
    when underpayment_of_year_457Ac2(plan, y_next, dn);
