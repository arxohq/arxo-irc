    label en official "level 6: the period after the year number 7 from the start year is reached (calendar walk)";
}
relation interest_final_period_457A_6(plan: Integer, y: TaxableYear, y_incl: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 6: the next year is the year of inclusion; the daily step and the days of the last period";
