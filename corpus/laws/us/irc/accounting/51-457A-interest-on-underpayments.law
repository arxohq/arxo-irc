}
relation interest_full_period_457A_3(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 3: the next year is not yet the year of inclusion; the daily step and the days of the period";
}
relation interest_state_457A_3(plan: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 3: the balance at the start of the period after year number 4, with the sum of the underpayments so far";
}
relation interest_level_457A_4(plan: Integer, y: TaxableYear) kind institutional {
    label en official "level 4: the period after the year number 5 from the start year is reached (calendar walk)";
}
relation interest_final_period_457A_4(plan: Integer, y: TaxableYear, y_incl: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 4: the next year is the year of inclusion; the daily step and the days of the last period";
}
relation interest_full_period_457A_4(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 4: the next year is not yet the year of inclusion; the daily step and the days of the period";
}
relation interest_state_457A_4(plan: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 4: the balance at the start of the period after year number 5, with the sum of the underpayments so far";
}
relation interest_level_457A_5(plan: Integer, y: TaxableYear) kind institutional {
    label en official "level 5: the period after the year number 6 from the start year is reached (calendar walk)";
}
relation interest_final_period_457A_5(plan: Integer, y: TaxableYear, y_incl: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 5: the next year is the year of inclusion; the daily step and the days of the last period";
}
relation interest_full_period_457A_5(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 5: the next year is not yet the year of inclusion; the daily step and the days of the period";
}
relation interest_state_457A_5(plan: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 5: the balance at the start of the period after year number 6, with the sum of the underpayments so far";
}
