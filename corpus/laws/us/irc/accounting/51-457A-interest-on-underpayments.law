// Section 457A(c)(1)(B)(i), (c)(2): the interest on the underpayments that
// would have occurred (stage 4, DECISION-0379 with deontics). Closes G4803.
//
// TECHNIQUE (stated): BOUNDED UNROLLING, the same Horner chain as module 50.
// The years from the interest start year (the taxable year in which the
// compensation was first deferred or, if later, the first year not subject to a
// substantial risk of forfeiture) up to the year in which the compensation is
// includible under (c)(1)(A) are walked from return due date to return due
// date. At the start of each period the underpayment "that would have occurred"
// for the year is added to a running balance; during the period the balance
// grows by the daily factor (1 + r/365)^days of the section 6621 underpayment
// rate plus 1 percentage point (the rate of module 41), compounded daily
// (section 6622; JUDGMENT CALL: 365-day denominator). The interest is the final
// balance minus the sum of the underpayments. Module 49 supplies the factor.
// DEPTH: at most 10 periods between the start year and the inclusion year;
// a longer deferral gets NO interest here (NEITHER), never a wrong number.
//
// JUDGMENT CALLS: (1) the underpayment of each year (the tax that inclusion in
// the start year would have produced, section 1/11 tax function of the tax
// owner) is a CASE-SUPPLIED amount per year; (2) each underpayment accrues from
// the return due date (without extensions) of its year to the return due date
// of the year of inclusion (the statute names no end date); (3) the rate is
// that of the year in which the period begins; (4) the balance is rounded to
// cents HALF_UP at the end of each period.

use self::{
    IRC_S457A_C,
    Person,
    TaxableYear,
    additional_tax_of_twenty_percent_457Ac1Bii,
    compensation_amount_not_determinable_when_otherwise_includible_457Ac1,
    compensation_includible_when_determinable_457Ac1A,
    first_year_without_substantial_risk_of_forfeiture_457A,
    growth_factor,
    growth_request,
    interest_rate_of_underpayment_plus_one_point_457Ac2,
    plan_of_nonqualified_entity_457A,
    preceding_taxable_year_465,
    return_due_date_without_extensions_460b7B,
};

pub relation first_taxable_year_deferred_457Ac2(plan: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the compensation was first deferred (section 457A(c)(2))";
}
pub relation hypothetical_underpayment_457Ac2(plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the underpayment of tax for the year that would have occurred had the deferred compensation been includible in the start year (section 457A(c)(2)); the tax function is applied outside this package";
}
pub relation interest_start_year_457Ac2(plan: Integer, y: TaxableYear) kind institutional {
    label en official "the year from which interest runs: the taxable year in which the compensation was first deferred or, if later, the first taxable year in which it is not subject to a substantial risk of forfeiture (section 457A(c)(2))";
}
@source(IRC_S457A_C, quote = "for the taxable year in which first deferred or, if later, the first taxable year in which such deferred compensation is not subject to a substantial risk of forfeiture.")
rule InterestStartYearIsDeferralYearWhenNotEarlier(plan: Integer, yd: TaxableYear, ys: TaxableYear, dd: Date, ds: Date) defeasible {
    label en official "the year of first deferral is the start year when it is not before the first year without a substantial risk (section 457A(c)(2))";
    when first_taxable_year_deferred_457Ac2(plan, yd);
    when first_year_without_substantial_risk_of_forfeiture_457A(plan, ys);
    when us.irc.core::begins(yd, dd);
    when us.irc.core::begins(ys, ds);
    when dd >= ds;
    then interest_start_year_457Ac2(plan, yd);
}
rule InterestStartYearIsFirstYearWithoutRiskWhenLater(plan: Integer, yd: TaxableYear, ys: TaxableYear, dd: Date, ds: Date) defeasible {
    label en official "the first year without a substantial risk is the start year when it is later (section 457A(c)(2))";
    when first_taxable_year_deferred_457Ac2(plan, yd);
    when first_year_without_substantial_risk_of_forfeiture_457A(plan, ys);
    when us.irc.core::begins(yd, dd);
    when us.irc.core::begins(ys, ds);
    when dd < ds;
    then interest_start_year_457Ac2(plan, ys);
}
pub relation inclusion_year_of_undeterminable_compensation_457Ac1A(plan: Integer, y: TaxableYear) kind institutional {
    label en official "the taxable year in which the not-determinable compensation is includible (bridge for the walk)";
}
rule InclusionYearFromDeterminability(plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the year of section 457A(c)(1)(A)";
    when compensation_includible_when_determinable_457Ac1A(plan, y, amount);
    then inclusion_year_of_undeterminable_compensation_457Ac1A(plan, y);
}
relation underpayment_year_request_457Ac2(plan: Integer, y: TaxableYear) kind institutional {
    label en official "the chain asks for the underpayment of a year (arithmetic helper)";
}
pub relation underpayment_of_year_457Ac2(plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the underpayment of the year, zero when none is asserted";
}
pub relation underpayment_of_year_asserted_457Ac2(plan: Integer, y: TaxableYear) kind institutional {
    label en official "an underpayment is asserted for the year";
}
rule UnderpaymentAsserted(plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "an asserted amount exists";
    when hypothetical_underpayment_457Ac2(plan, y, amount);
    then underpayment_of_year_asserted_457Ac2(plan, y);
}
rule UnderpaymentOfYearFromFact(plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the asserted underpayment of the year (section 457A(c)(2))";
    when underpayment_year_request_457Ac2(plan, y);
    when hypothetical_underpayment_457Ac2(plan, y, amount);
    then underpayment_of_year_457Ac2(plan, y, amount);
}
rule UnderpaymentOfYearNone(plan: Integer, y: TaxableYear) defeasible {
    label en official "a year without an asserted underpayment counts zero";
    when underpayment_year_request_457Ac2(plan, y);
    when not_known(underpayment_of_year_asserted_457Ac2(plan, y));
    then underpayment_of_year_457Ac2(plan, y, 0.00 USD);
}
rule UnderpaymentRequestFirst(plan: Integer, y0: TaxableYear) defeasible {
    label en official "ask for the start year's underpayment";
    when interest_start_year_457Ac2(plan, y0);
    then underpayment_year_request_457Ac2(plan, y0);
}
pub relation interest_on_underpayments_457Ac2(plan: Integer, y: TaxableYear, interest: Money) kind institutional {
    label en official "the interest determined under paragraph (2) for the taxable year of inclusion y: the underpayments of the years from the start year, compounded daily at the underpayment rate plus 1 percentage point, minus the underpayments themselves; depth: at most 10 periods (stated bound)";
}
relation interest_balance_at_inclusion_457Ac2(plan: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "the compounded balance at the return due date of the inclusion year and the sum of the underpayments";
}

relation interest_level_457A_0(plan: Integer, y: TaxableYear) kind institutional {
    label en official "level 0: the period after the year number 1 from the start year is reached (calendar walk)";
}
relation interest_final_period_457A_0(plan: Integer, y: TaxableYear, y_incl: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 0: the next year is the year of inclusion; the daily step and the days of the last period";
}
relation interest_full_period_457A_0(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 0: the next year is not yet the year of inclusion; the daily step and the days of the period";
}
relation interest_state_457A_0(plan: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 0: the balance at the start of the period after year number 1, with the sum of the underpayments so far";
}
relation interest_level_457A_1(plan: Integer, y: TaxableYear) kind institutional {
    label en official "level 1: the period after the year number 2 from the start year is reached (calendar walk)";
}
relation interest_final_period_457A_1(plan: Integer, y: TaxableYear, y_incl: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 1: the next year is the year of inclusion; the daily step and the days of the last period";
}
relation interest_full_period_457A_1(plan: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 1: the next year is not yet the year of inclusion; the daily step and the days of the period";
}
relation interest_state_457A_1(plan: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 1: the balance at the start of the period after year number 2, with the sum of the underpayments so far";
}
