// Residual elections and reductions (stage 3, DECISION-0379 with deontics):
// 447(e)(4)(B)(ii)-(iii), 451(k)(2), and the scope of the 455(c)(2), 456(c)(2)
// and 458(c)(2) elections.
//
// Not modelled (TECH-GAPS G4809-G4820): see the coverage rows.

// ===================== 447(e)(4)(B)(ii)-(iii) =====================

use self::{
    IRC_S447_E,
    IRC_S451_K,
    IRC_S455_C,
    Person,
    TaxableYear,
};

pub relation corporation_makes_447e4B_election(corp: Person, y: TaxableYear) kind empirical {
    label en official "the corporation makes the election under section 447(e)(4)(B) in the year";
}
pub relation year_is_first_year_after_1986_engaged_in_farming_447e4Biii(corp: Person, y: TaxableYear) kind empirical {
    label en official "the year is the corporation's 1st taxable year beginning after December 31, 1986 in which it engages in a farming business (section 447(e)(4)(B)(iii))";
}
pub relation secretary_consents_to_447e4B_election_447e4Biii(corp: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the election being made for a different year (section 447(e)(4)(B)(iii))";
}
pub relation election_447e4B_permitted_447e4Biii(corp: Person, y: TaxableYear) kind institutional {
    label en official "the election may be made only for the 1st taxable year after 1986 in which the corporation farms, unless the Secretary consents (section 447(e)(4)(B)(iii))";
}
@source(IRC_S447_E, quote = "an election under this subparagraph may be made only for the corporation's 1st taxable year which begins after December 31, 1986, and during which the corporation engages in a farming business.")
rule Election447e4BPermittedForFirstFarmingYear(corp: Person, y: TaxableYear) strict {
    label en official "the first farming year after 1986 (section 447(e)(4)(B)(iii))";
    when corporation_makes_447e4B_election(corp, y);
    when year_is_first_year_after_1986_engaged_in_farming_447e4Biii(corp, y);
    then election_447e4B_permitted_447e4Biii(corp, y);
}
rule Election447e4BPermittedWithConsent(corp: Person, y: TaxableYear) strict {
    label en official "with the Secretary's consent (section 447(e)(4)(B)(iii))";
    when corporation_makes_447e4B_election(corp, y);
    when secretary_consents_to_447e4B_election_447e4Biii(corp, y);
    then election_447e4B_permitted_447e4Biii(corp, y);
}
pub relation election_treated_as_263A_d3_election_447e4Bii(corp: Person, y: TaxableYear) kind institutional {
    label en official "for section 263A(e)(1)-(2) the election is treated as an election under section 263A(d)(3) (section 447(e)(4)(B)(ii))";
}
@source(IRC_S447_E, quote = "any election under this subparagraph shall be treated as if it were an election under subsection (d)(3) of section 263A.")
rule Election447e4BTreatedAs263AElection(corp: Person, y: TaxableYear) strict {
    label en official "a permitted election (section 447(e)(4)(B)(ii))";
    when election_447e4B_permitted_447e4Biii(corp, y);
    then election_treated_as_263A_d3_election_447e4Bii(corp, y);
}
pub relation revokes_447e4B_election_447e4Biii(corp: Person, y: TaxableYear) kind empirical {
    label en official "the corporation revokes its section 447(e)(4)(B) election in the year";
}
pub relation secretary_consents_to_revocation_447e4Biii(corp: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation (section 447(e)(4)(B)(iii))";
}
pub relation revocation_of_447e4B_election_effective_447e4Biii(corp: Person, y: TaxableYear) kind institutional {
    label en official "the election, once made, may be revoked only with the Secretary's consent (section 447(e)(4)(B)(iii))";
}
@source(IRC_S447_E, quote = "Any such election, once made, may be revoked only with the consent of the Secretary.")
rule RevocationOf447e4BElectionNeedsConsent(corp: Person, y: TaxableYear) strict {
    label en official "revocation with consent";
    when revokes_447e4B_election_447e4Biii(corp, y);
    when secretary_consents_to_revocation_447e4Biii(corp, y);
    then revocation_of_447e4B_election_effective_447e4Biii(corp, y);
}

// ===================== 451(k)(2): qualified gain =====================

pub relation ordinary_income_from_1245_or_1250_on_transaction_451k2A(p: Person, y: TaxableYear, txn: Integer, amount: Money) kind empirical {
    label en official "ordinary income from the qualifying electric transmission transaction that would be recognized under section 1245 or 1250 for the year, without regard to this subsection (section 451(k)(2)(A))";
}
pub relation other_income_from_transaction_required_in_gross_income_451k2B(p: Person, y: TaxableYear, txn: Integer, amount: Money) kind empirical {
    label en official "any other income from the transaction, in excess of (A), required to be included in gross income for the year, without regard to this subsection (section 451(k)(2)(B))";
}
pub relation qualified_gain_derived_451k2(p: Person, y: TaxableYear, txn: Integer, amount: Money) kind institutional {
    label en official "qualified gain: the section 1245/1250 ordinary income plus the other income of the transaction includible for the year (section 451(k)(2))";
}
@source(IRC_S451_K, quote = "(A) any ordinary income derived from such transaction which would be required to be recognized under section 1245 or 1250 for such taxable year (determined without regard to this subsection), and")
rule QualifiedGainSum(p: Person, y: TaxableYear, txn: Integer, ordinary: Money, other: Money) strict {
    label en official "(A) + (B) (section 451(k)(2))";
    when ordinary_income_from_1245_or_1250_on_transaction_451k2A(p, y, txn, ordinary);
    when other_income_from_transaction_required_in_gross_income_451k2B(p, y, txn, other);
    then qualified_gain_derived_451k2(p, y, txn, ordinary + other);
}

// ===================== 455(c)(2), 456(c)(2), 458(c)(2): scope of the election =====================

pub relation election_made_for_trade_or_business_prepaid_income_448(p: Person, business: Integer, kind: Integer) kind empirical {
    label en official "the taxpayer has made the election (kind 455 subscription, 456 dues, 458 returns) for the trade or business (sections 455(c)(2), 456(c)(2), 458(c)(2))";
}
pub relation item_received_in_connection_with_business_448(item: Integer, business: Integer, kind: Integer) kind empirical {
    label en official "the prepaid income or qualified sale is received or made in connection with the trade or business (sections 455(c)(2), 456(c)(2), 458(c)(2))";
}
pub relation regulations_permit_inclusion_in_year_of_receipt_448(item: Integer, kind: Integer) kind empirical {
    label en official "regulations permit inclusion of the entire prepaid amount in the year of receipt because the liability ends within 12 months (sections 455(c)(2), 456(c)(2)); asserted";
}
pub relation item_covered_by_election_448(p: Person, business: Integer, item: Integer, kind: Integer) kind institutional {
    label en official "the election applies to all prepaid income (or qualified sales) received in connection with the trade or business, except as regulations permit for short liabilities (sections 455(c)(2), 456(c)(2), 458(c)(2))";
}
@source(IRC_S455_C, quote = "An election made under this section shall apply to all prepaid subscription income received in connection with the trade or business with respect to which the taxpayer has made the election")
rule ElectionCoversAllItemsOfTheBusiness(p: Person, business: Integer, item: Integer, kind: Integer) defeasible {
    label en official "all items of the business (sections 455(c)(2), 456(c)(2), 458(c)(2)); the kinds 455, 456 and 458 share the shape";
    when election_made_for_trade_or_business_prepaid_income_448(p, business, kind);
    when item_received_in_connection_with_business_448(item, business, kind);
    when not_known(regulations_permit_inclusion_in_year_of_receipt_448(item, kind));
    then item_covered_by_election_448(p, business, item, kind);
}
