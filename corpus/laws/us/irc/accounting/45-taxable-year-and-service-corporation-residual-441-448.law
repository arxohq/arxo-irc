// Sections 441(f), 443, 444 and 448 residual (stage 3, DECISION-0379 with
// deontics): the 52-53-week year effective-date translation and short-period
// thresholds of 441(f)(2); the 12-month comparison period of 443(b)(2)(B) and
// the exemption proration of 443(c); the 444 election limits (b)(2)-(4), its
// persistence and termination (d), tiered structures, the required taxable year
// (e) and the personal service corporation (f); and the 448 qualified personal
// service corporation (d)(2), (d)(4)(B)-(C), the accrual relief of (d)(5), the
// unrelated-business trust of (d)(6) and the predecessor rule of (c)(3)(D).
//
// The stage 2b relations stay. `Section444ElectionPower` now takes its validity
// from `deferral_period_permitted_444b`, which keeps the (b)(1) three-month test
// and adds (b)(2)-(3) and the (d) bars.
//
// Not modelled (TECH-GAPS G4807, G4808): the (d)(4)(A) community property
// directive (holdings are asserted after the determination); the 443(b)(2)
// alternative tax comparison (a second independently computed tax); the
// application timing and regulations of 443(b)(2)(C)-(D); the indexed amounts of
// 448(c)(4) (SOURCE_GAP); the 448(d)(5)(C) formula regulations.

// ===================== 441(f)(2): 52-53-week year =====================

use self::{
    IRC_S441_F,
    IRC_S443_B,
    IRC_S443_C,
    IRC_S444_B,
    IRC_S444_D,
    IRC_S444_E,
    IRC_S444_F,
    IRC_S448_C,
    IRC_S448_D,
    Person,
    TaxableYear,
    cash_method_prohibited_448a,
    deferral_period_months_444,
    deferral_period_within_three_months_444,
    is_c_corporation_448,
    meets_gross_receipts_test_448c,
    months_in_short_period,
    section_444_election_in_effect,
    short_period_from_approved_change,
    short_period_return_required,
};

pub relation fifty_two_fifty_three_week_year_first_day_441f2A(y: TaxableYear, first_day: Date, month_start_on_or_before: Date) kind empirical {
    label en official "a 52-53-week taxable year, its first day, and the first day of the calendar month on or before that day (section 441(f)(2)(A)(i)); the calendar month start is asserted";
}
pub relation fifty_two_fifty_three_week_year_last_day_441f2A(y: TaxableYear, last_day: Date, month_end_on_or_before: Date, month_end_after: Date) kind empirical {
    label en official "a 52-53-week taxable year, its last day, and the last days of the calendar months on or before and after that day (section 441(f)(2)(A)(ii)); the calendar month ends are asserted";
}
pub relation year_treated_as_beginning_on_441f2Ai(y: TaxableYear, d: Date) kind institutional {
    label en official "for a specified month-start date in an effective-date rule, the year is treated as beginning with the first day of the calendar month beginning nearest to its first day; a tie goes to the earlier month start (JUDGMENT CALL) (section 441(f)(2)(A)(i))";
}
@source(IRC_S441_F, quote = "as beginning with the first day of the calendar month beginning nearest to the first day of such taxable year, or")
rule YearTreatedAsBeginningAtEarlierMonthStart(y: TaxableYear, first_day: Date, before: Date) strict {
    label en official "the month start on or before is not farther than the next month start (section 441(f)(2)(A)(i))";
    when fifty_two_fifty_three_week_year_first_day_441f2A(y, first_day, before);
    when days_between(before, first_day) <= days_between(first_day, add_calendar_period(before, 1 calendar_month));
    then year_treated_as_beginning_on_441f2Ai(y, before);
}
rule YearTreatedAsBeginningAtNextMonthStart(y: TaxableYear, first_day: Date, before: Date) strict {
    label en official "the next month start is nearer (section 441(f)(2)(A)(i))";
    when fifty_two_fifty_three_week_year_first_day_441f2A(y, first_day, before);
    when days_between(before, first_day) > days_between(first_day, add_calendar_period(before, 1 calendar_month));
    then year_treated_as_beginning_on_441f2Ai(y, add_calendar_period(before, 1 calendar_month));
}
pub relation year_treated_as_ending_on_441f2Aii(y: TaxableYear, d: Date) kind institutional {
    label en official "for a specified month-end date, the year is treated as ending with the last day of the calendar month ending nearest to its last day; a tie goes to the earlier month end (JUDGMENT CALL) (section 441(f)(2)(A)(ii))";
}
@source(IRC_S441_F, quote = "as ending with the last day of the calendar month ending nearest to the last day of such taxable year,")
rule YearTreatedAsEndingAtEarlierMonthEnd(y: TaxableYear, last_day: Date, before: Date, after: Date) strict {
    label en official "the month end on or before is not farther than the next month end (section 441(f)(2)(A)(ii))";
    when fifty_two_fifty_three_week_year_last_day_441f2A(y, last_day, before, after);
    when days_between(before, last_day) <= days_between(last_day, after);
    then year_treated_as_ending_on_441f2Aii(y, before);
}
rule YearTreatedAsEndingAtNextMonthEnd(y: TaxableYear, last_day: Date, before: Date, after: Date) strict {
    label en official "the next month end is nearer (section 441(f)(2)(A)(ii))";
    when fifty_two_fifty_three_week_year_last_day_441f2A(y, last_day, before, after);
    when days_between(before, last_day) > days_between(last_day, after);
    then year_treated_as_ending_on_441f2Aii(y, after);
}
pub relation days_in_short_period_441f2B(y_short: TaxableYear, days: Integer) kind empirical {
    label en official "the number of days in the short period resulting from a change from or to a 52-53-week year (section 441(f)(2)(B))";
}
pub relation section_443b_alternative_computation_barred_441f2Bi(y_short: TaxableYear) kind institutional {
    label en official "section 443(b) alternative computation does not apply to a short period of 359 days or more, or of less than 7 days (section 441(f)(2)(B)(i))";
}
@source(IRC_S441_F, quote = "if such change results in a short period (within the meaning of section 443) of 359 days or more, or of less than 7 days, section 443(b) (relating to alternative tax computation) shall not apply;")
rule Section443bBarredForLongShortPeriod(y_short: TaxableYear, days: Integer) strict {
    label en official "359 days or more (section 441(f)(2)(B)(i))";
    when days_in_short_period_441f2B(y_short, days);
    when days >= 359;
    then section_443b_alternative_computation_barred_441f2Bi(y_short);
}
rule Section443bBarredForVeryShortPeriod(y_short: TaxableYear, days: Integer) strict {
    label en official "less than 7 days (section 441(f)(2)(B)(i))";
    when days_in_short_period_441f2B(y_short, days);
    when days < 7;
    then section_443b_alternative_computation_barred_441f2Bi(y_short);
}
pub relation short_period_added_to_following_year_441f2Bii(y_short: TaxableYear) kind institutional {
    label en official "a short period of less than 7 days is added to and deemed a part of the following taxable year (section 441(f)(2)(B)(ii))";
}
@source(IRC_S441_F, quote = "such short period shall, for purposes of this subtitle, be added to and deemed a part of the following taxable year; and")
rule VeryShortPeriodAddedToFollowingYear(y_short: TaxableYear, days: Integer) strict {
    label en official "fewer than 7 days (section 441(f)(2)(B)(ii))";
    when days_in_short_period_441f2B(y_short, days);
    when days < 7;
    then short_period_added_to_following_year_441f2Bii(y_short);
}
pub relation gross_income_for_short_period_441f2Biii(y_short: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income for the short period (section 441(f)(2)(B)(iii))";
}
pub relation deductions_for_short_period_with_adjusted_exemptions_441f2Biii(y_short: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowed for the short period, with only the adjusted amount of the personal exemption deductions of section 443(c) (section 441(f)(2)(B)(iii))";
}
pub relation taxable_income_on_annual_basis_441f2Biii(p: Person, y_short: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income for the short period on an annual basis: (gross income - deductions) x 365 / days in the short period, one rounding to cents HALF_UP (JUDGMENT CALL); floored at zero (section 441(f)(2)(B)(iii))";
}
@source(IRC_S441_F, quote = "by 365, by dividing the result by the number of days in the short period")
rule TaxableIncomeOnAnnualBasisByDays(p: Person, y_short: TaxableYear, gross: Money, deductions: Money, days: Integer) defeasible {
    label en official "(gross income - deductions) x 365 / days (section 441(f)(2)(B)(iii))";
    when short_period_return_required(p, y_short);
    when gross_income_for_short_period_441f2Biii(y_short, gross);
    when deductions_for_short_period_with_adjusted_exemptions_441f2Biii(y_short, deductions);
    when days_in_short_period_441f2B(y_short, days);
    when days > 0;
    then taxable_income_on_annual_basis_441f2Biii(p, y_short, max(div_round((gross - deductions) * 365, days * 1.0, 2, "HALF_UP"), 0 USD));
}

// ===================== 443(b)(2)(B), (c) =====================

pub relation short_period_first_and_last_day_443(y_short: TaxableYear, first_day: Date, last_day: Date) kind empirical {
    label en official "the first and the last day of the short period (section 443(b)(2)(B))";
}
pub relation taxpayer_not_in_existence_or_disposed_of_substantially_all_assets_at_end_of_443b2Bi(p: Person, y_short: TaxableYear) kind empirical {
    label en official "at the end of the 12 months of clause (i) the taxpayer is not in existence or (a corporation) has disposed of substantially all of its assets (section 443(b)(2)(B)(ii)); an adjudicated fact";
}
pub relation twelve_month_period_begins_443b2Bi(p: Person, y_short: TaxableYear, starts_on: Date, ends_before: Date) kind institutional {
    label en official "clause (i): the 12 months beginning on the first day of the short period; the end date is exclusive (section 443(b)(2)(B)(i))";
}
@source(IRC_S443_B, quote = "(i) the period of 12 months beginning on the first day of the short period, or")
rule TwelveMonthPeriodBeginningWithShortPeriod(p: Person, y_short: TaxableYear, first_day: Date, last_day: Date) defeasible {
    label en official "12 months from the first day (section 443(b)(2)(B)(i))";
    when short_period_return_required(p, y_short);
    when short_period_first_and_last_day_443(y_short, first_day, last_day);
    when not_known(taxpayer_not_in_existence_or_disposed_of_substantially_all_assets_at_end_of_443b2Bi(p, y_short));
    then twelve_month_period_begins_443b2Bi(p, y_short, first_day, add_calendar_period(first_day, 12 calendar_month));
}
pub relation twelve_month_period_ends_443b2Bii(p: Person, y_short: TaxableYear, ends_before: Date) kind institutional {
    label en official "clause (ii): the 12 months ending at the close of the last day of the short period, when the taxpayer is gone at the end of (i); the period runs from 12 calendar months before the exclusive end date (section 443(b)(2)(B)(ii))";
}
@source(IRC_S443_B, quote = "(ii) the period of 12 months ending at the close of the last day of the short period, if at the end of the 12 months referred to in clause (i) the taxpayer is not in existence or (if a corporation) has theretofore disposed of substantially all of its assets.")
rule TwelveMonthPeriodEndingWithShortPeriod(p: Person, y_short: TaxableYear, first_day: Date, last_day: Date) defeasible {
    label en official "12 months ending with the short period's last day when the taxpayer is gone at the end of (i) (section 443(b)(2)(B)(ii))";
    when short_period_return_required(p, y_short);
    when short_period_first_and_last_day_443(y_short, first_day, last_day);
    when taxpayer_not_in_existence_or_disposed_of_substantially_all_assets_at_end_of_443b2Bi(p, y_short);
    then twelve_month_period_ends_443b2Bii(p, y_short, add_calendar_period(last_day, 1 calendar_day));
}
pub relation full_personal_exemptions_443c(p: Person, y_short: TaxableYear, amount: Money) kind empirical {
    label en official "the full exemptions allowed as a deduction under section 151 (or any deduction in lieu thereof); the amount is section 151's and asserted (section 443(c))";
}
pub relation tax_computed_under_443b2(p: Person, y_short: TaxableYear) kind empirical {
    label en official "the tax for the short period is computed under section 443(b)(2) (section 443(c))";
}
pub relation taxpayer_is_a_corporation_443c(p: Person) kind empirical {
    label en official "the taxpayer is a corporation (section 443(c))";
}
pub relation exemptions_reduced_for_short_period_443c(p: Person, y_short: TaxableYear, amount: Money) kind institutional {
    label en official "for a taxpayer other than a corporation with a short-period return by reason of (a)(1) and no (b)(2) computation, the exemptions are reduced in the ratio of the months in the short period to 12: exemptions x months / 12, one rounding to cents HALF_UP (JUDGMENT CALL) (section 443(c))";
}
@source(IRC_S443_C, quote = "then the exemptions allowed as a deduction under section 151 (and any deduction in lieu thereof) shall be reduced to amounts which bear the same ratio to the full exemptions as the number of months in the short period bears to 12.")
rule ExemptionsProratedForShortPeriod(p: Person, y_short: TaxableYear, y_new: TaxableYear, full: Money, months: Integer) defeasible {
    label en official "exemptions x months / 12 (section 443(c))";
    when short_period_from_approved_change(p, y_short, y_new);
    when not_known(taxpayer_is_a_corporation_443c(p));
    when not_known(tax_computed_under_443b2(p, y_short));
    when full_personal_exemptions_443c(p, y_short, full);
    when months_in_short_period(y_short, months);
    then exemptions_reduced_for_short_period_443c(p, y_short, div_round(full * months, 12.0, 2, "HALF_UP"));
}

// ===================== 444(b)-(g) =====================

pub relation entity_changing_taxable_year_444b2(filer: Person, y: TaxableYear) kind empirical {
    label en official "the entity is changing its taxable year (section 444(b)(2))";
}
pub relation prior_year_deferral_period_months_444b2B(filer: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the deferral period of the taxable year which is being changed (section 444(b)(2)(B))";
}
pub relation first_taxable_year_after_1986_444b3(filer: Person, y: TaxableYear) kind empirical {
    label en official "the year is the entity's 1st taxable year beginning after December 31, 1986 (section 444(b)(3))";
}
pub relation elected_year_same_as_last_year_beginning_in_1986_444b3(filer: Person, y: TaxableYear) kind empirical {
    label en official "the elected taxable year is the same as the entity's last taxable year beginning in 1986 (section 444(b)(3))";
}
pub relation taxable_year_begins_on_444b4A(filer: Person, y: TaxableYear, d: Date) kind empirical {
    label en official "the beginning of the taxable year (section 444(b)(4)(A))";
}
pub relation first_required_taxable_year_ending_within_year_closes_on_444b4B(filer: Person, y: TaxableYear, d: Date) kind empirical {
    label en official "the close of the 1st required taxable year ending within the year (section 444(b)(4)(B))";
}
pub relation deferral_period_months_derived_444b4(filer: Person, y: TaxableYear, months: Integer) kind institutional {
    label en official "the deferral period in months, counting a part of a month as a month (JUDGMENT CALL); derived for periods up to 3 months, and absent for longer ones (section 444(b)(4))";
}
@source(IRC_S444_B, quote = "the term \"deferral period\" means, with respect to any taxable year of the entity, the months between—")
rule DeferralPeriodZeroMonths(filer: Person, y: TaxableYear, begins: Date, closes: Date) strict {
    label en official "the required year closes with the year's start (section 444(b)(4))";
    when taxable_year_begins_on_444b4A(filer, y, begins);
    when first_required_taxable_year_ending_within_year_closes_on_444b4B(filer, y, closes);
    when closes <= begins;
    then deferral_period_months_derived_444b4(filer, y, 0);
}
rule DeferralPeriodOneMonth(filer: Person, y: TaxableYear, begins: Date, closes: Date) strict {
    label en official "up to 1 month (section 444(b)(4))";
    when taxable_year_begins_on_444b4A(filer, y, begins);
    when first_required_taxable_year_ending_within_year_closes_on_444b4B(filer, y, closes);
    when closes > begins;
    when closes <= add_calendar_period(begins, 1 calendar_month);
    then deferral_period_months_derived_444b4(filer, y, 1);
}
rule DeferralPeriodTwoMonths(filer: Person, y: TaxableYear, begins: Date, closes: Date) strict {
    label en official "over 1 and up to 2 months (section 444(b)(4))";
    when taxable_year_begins_on_444b4A(filer, y, begins);
    when first_required_taxable_year_ending_within_year_closes_on_444b4B(filer, y, closes);
    when closes > add_calendar_period(begins, 1 calendar_month);
    when closes <= add_calendar_period(begins, 2 calendar_month);
    then deferral_period_months_derived_444b4(filer, y, 2);
}
rule DeferralPeriodThreeMonths(filer: Person, y: TaxableYear, begins: Date, closes: Date) strict {
    label en official "over 2 and up to 3 months (section 444(b)(4))";
    when taxable_year_begins_on_444b4A(filer, y, begins);
    when first_required_taxable_year_ending_within_year_closes_on_444b4B(filer, y, closes);
    when closes > add_calendar_period(begins, 2 calendar_month);
    when closes <= add_calendar_period(begins, 3 calendar_month);
    then deferral_period_months_derived_444b4(filer, y, 3);
}
rule DeferralPeriodWithinThreeMonthsFromDerivedMonths(filer: Person, y: TaxableYear, months: Integer) strict {
    label en official "the derived deferral period is not longer than 3 months (section 444(b)(1), (b)(4))";
    when deferral_period_months_derived_444b4(filer, y, months);
    then deferral_period_within_three_months_444(filer, y);
}

pub relation entity_part_of_tiered_structure_444d3(filer: Person) kind empirical {
    label en official "the entity is part of a tiered structure (section 444(d)(3)(A))";
}
pub relation tiered_structure_only_partnerships_or_s_corporations_same_year_444d3B(filer: Person) kind empirical {
    label en official "the tiered structure consists only of partnerships or S corporations (or both), all with the same taxable year (section 444(d)(3)(B))";
}
pub relation tiered_structure_bars_election_444d3A(filer: Person) kind institutional {
    label en official "a tiered structure bars a section 444(a) election, unless it consists only of partnerships or S corporations of the same taxable year (section 444(d)(3)(A)-(B))";
}
@source(IRC_S444_D, quote = "(i) no election may be under subsection (a) with respect to any entity which is part of a tiered structure, and")
rule TieredStructureBarsElection(filer: Person) strict {
    label en official "part of a tiered structure outside the exception (section 444(d)(3))";
    when entity_part_of_tiered_structure_444d3(filer);
    when not_known(tiered_structure_only_partnerships_or_s_corporations_same_year_444d3B(filer));
    then tiered_structure_bars_election_444d3A(filer);
}
pub relation election_terminated_by_tiered_structure_444d3Aii(filer: Person, y: TaxableYear) kind institutional {
    label en official "an election in effect is terminated when the entity becomes part of a tiered structure (section 444(d)(3)(A)(ii))";
}
@source(IRC_S444_D, quote = "(ii) an election under subsection (a) with respect to any entity shall be terminated if such entity becomes part of a tiered structure.")
rule ElectionTerminatedByTieredStructure(filer: Person, y: TaxableYear) defeasible {
    label en official "election in effect and a barring tiered structure (section 444(d)(3)(A)(ii))";
    when section_444_election_in_effect(filer, y);
    when tiered_structure_bars_election_444d3A(filer);
    then election_terminated_by_tiered_structure_444d3Aii(filer, y);
}
pub relation prior_year_election_in_effect_444d2A(filer: Person, y: TaxableYear) kind empirical {
    label en official "the election was in effect for the preceding taxable year (one-hop carry; TECH-GAPS G2108)";
}
pub relation entity_changed_taxable_year_or_terminated_election_444d2A(filer: Person, y: TaxableYear) kind empirical {
    label en official "the entity changes its taxable year or otherwise terminates the election in the year (section 444(d)(2)(A))";
}
pub relation election_continues_444d2A(filer: Person, y: TaxableYear) kind institutional {
    label en official "the election remains in effect until the entity changes its taxable year or terminates it (section 444(d)(2)(A))";
}
@source(IRC_S444_D, quote = "Any election under subsection (a) shall remain in effect until the partnership, S corporation, or personal service corporation changes its taxable year or otherwise terminates such election.")
rule ElectionRemainsInEffect(filer: Person, y: TaxableYear) defeasible {
    label en official "carry of an election in effect (section 444(d)(2)(A))";
    when prior_year_election_in_effect_444d2A(filer, y);
    when not_known(entity_changed_taxable_year_or_terminated_election_444d2A(filer, y));
    when not_known(election_terminated_by_tiered_structure_444d3Aii(filer, y));
    then election_continues_444d2A(filer, y);
}
pub relation change_to_required_taxable_year_444d2A(filer: Person, y: TaxableYear) kind empirical {
    label en official "the entity changes to a required taxable year (section 444(d)(2)(A))";
}
pub relation secretary_consent_not_required_444d2A(filer: Person, y: TaxableYear) kind institutional {
    label en official "a change to a required taxable year may be made without the consent of the Secretary (section 444(d)(2)(A), last sentence)";
}
@source(IRC_S444_D, quote = "Any change to a required taxable year may be made without the consent of the Secretary.")
rule ChangeToRequiredYearNeedsNoConsent(filer: Person, y: TaxableYear) strict {
    label en official "a change to a required taxable year (section 444(d)(2)(A))";
    when change_to_required_taxable_year_444d2A(filer, y);
    then secretary_consent_not_required_444d2A(filer, y);
}
pub relation election_terminated_under_444d2A_or_d3A(filer: Person) kind empirical {
    label en official "an earlier election was terminated under (d)(2)(A) or (d)(3)(A) (section 444(d)(2)(B))";
}
pub relation another_election_barred_444d2B(filer: Person) kind institutional {
    label en official "after a termination under (d)(2)(A) or (d)(3)(A) the entity may not make another election under (a) (section 444(d)(2)(B))";
}
@source(IRC_S444_D, quote = "may not make another election under subsection (a).")
rule AnotherElectionBarredAfterTermination(filer: Person) strict {
    label en official "no second election (section 444(d)(2)(B))";
    when election_terminated_under_444d2A_or_d3A(filer);
    then another_election_barred_444d2B(filer);
}
pub relation deferral_period_permitted_444b(filer: Person, y: TaxableYear) kind institutional {
    label en official "the deferral period is permitted for the election: within 3 months for an entity not changing its year; for a changing entity, not longer than the shorter of 3 months and the old deferral period; the 1986 same-year rule; and not barred by a tiered structure or an earlier termination (section 444(b)(1)-(3), (d)(2)(B), (d)(3))";
}
@source(IRC_S444_B, quote = "an election may be made under subsection (a) only if the deferral period of the taxable year elected is not longer than 3 months")
rule DeferralPeriodPermittedGeneral(filer: Person, y: TaxableYear) strict {
    label en official "(b)(1): 3 months for an entity that is not changing its year";
    when deferral_period_within_three_months_444(filer, y);
    when not_known(entity_changing_taxable_year_444b2(filer, y));
    when not_known(tiered_structure_bars_election_444d3A(filer));
    when not_known(another_election_barred_444d2B(filer));
    then deferral_period_permitted_444b(filer, y);
}
@source(IRC_S444_B, quote = "(B) the deferral period of the taxable year which is being changed.")
rule DeferralPeriodPermittedChangingYear(filer: Person, y: TaxableYear, months: Integer, prior: Integer) strict {
    label en official "(b)(2): not longer than the shorter of 3 months and the old deferral period";
    when entity_changing_taxable_year_444b2(filer, y);
    when deferral_period_months_444(filer, y, months);
    when prior_year_deferral_period_months_444b2B(filer, y, prior);
    when months <= 3;
    when months <= prior;
    when not_known(tiered_structure_bars_election_444d3A(filer));
    when not_known(another_election_barred_444d2B(filer));
    then deferral_period_permitted_444b(filer, y);
}
@source(IRC_S444_B, quote = "an entity may elect a taxable year under subsection (a) which is the same as the entity's last taxable year beginning in 1986.")
rule DeferralPeriodPermittedSameAs1986Year(filer: Person, y: TaxableYear) strict {
    label en official "(b)(3): the 1st year after 1986 may keep the last 1986 year";
    when first_taxable_year_after_1986_444b3(filer, y);
    when elected_year_same_as_last_year_beginning_in_1986_444b3(filer, y);
    when not_known(tiered_structure_bars_election_444d3A(filer));
    when not_known(another_election_barred_444d2B(filer));
    then deferral_period_permitted_444b(filer, y);
}
pub relation year_determined_under_706b_444e(filer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year determined under section 706(b) (section 444(e)); the section 706(b) determination is asserted";
}
pub relation year_determined_under_1378_444e(filer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year determined under section 1378 (section 444(e)); asserted";
}
pub relation year_determined_under_441i_444e(filer: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year determined under section 441(i) (section 444(e)); asserted";
}
pub relation required_taxable_year_444e(filer: Person, y: TaxableYear) kind institutional {
    label en official "the required taxable year: the year determined under section 706(b), 1378 or 441(i) without any year allowable by reason of business purposes (section 444(e))";
}
@source(IRC_S444_E, quote = "the term \"required taxable year\" means the taxable year determined under section 706(b), 1378, or 441(i) without taking into account any taxable year which is allowable by reason of business purposes.")
rule RequiredTaxableYearUnder706b(filer: Person, y: TaxableYear) strict {
    label en official "section 706(b) (section 444(e))";
    when year_determined_under_706b_444e(filer, y);
    then required_taxable_year_444e(filer, y);
}
rule RequiredTaxableYearUnder1378(filer: Person, y: TaxableYear) strict {
    label en official "section 1378 (section 444(e))";
    when year_determined_under_1378_444e(filer, y);
    then required_taxable_year_444e(filer, y);
}
rule RequiredTaxableYearUnder441i(filer: Person, y: TaxableYear) strict {
    label en official "section 441(i) (section 444(e))";
    when year_determined_under_441i_444e(filer, y);
    then required_taxable_year_444e(filer, y);
}
pub relation personal_service_corporation_under_441i2_444f(filer: Person) kind empirical {
    label en official "the corporation is a personal service corporation within section 441(i)(2) (section 444(f)); the section 441(i)(2) test is asserted";
}
pub relation personal_service_corporation_444f(filer: Person) kind institutional {
    label en official "personal service corporation: as in section 441(i)(2) (section 444(f))";
}
@source(IRC_S444_F, quote = "the term \"personal service corporation\" has the meaning given to such term by section 441(i)(2).")
rule PersonalServiceCorporationDefinition(filer: Person) strict {
    label en official "the section 441(i)(2) meaning (section 444(f))";
    when personal_service_corporation_under_441i2_444f(filer);
    then personal_service_corporation_444f(filer);
}

// ===================== 448(c)(3)(D), (d) =====================

pub relation predecessor_of_entity_448c3D(predecessor: Person, ent: Person) kind empirical {
    label en official "the first is a predecessor of the second entity (section 448(c)(3)(D))";
}
pub relation entity_reference_includes_448c3D(ent: Person, referred: Person) kind institutional {
    label en official "a reference to an entity in section 448(c) includes its predecessor (section 448(c)(3)(D))";
}
@source(IRC_S448_C, quote = "Any reference in this subsection to an entity shall include a reference to any predecessor of such entity.")
rule EntityReferenceIncludesPredecessor(ent: Person, predecessor: Person) strict {
    label en official "the predecessor is included (section 448(c)(3)(D))";
    when predecessor_of_entity_448c3D(predecessor, ent);
    then entity_reference_includes_448c3D(ent, predecessor);
}
pub relation substantially_all_activities_in_qualifying_fields_448d2A(corp: Person) kind empirical {
    label en official "substantially all of the corporation's activities involve services in the fields of health, law, engineering, architecture, accounting, actuarial science, performing arts, or consulting (section 448(d)(2)(A)); an adjudicated fact";
}
pub relation shareholder_employee_performing_services_448d2Bi(corp: Person, holder: Person) kind empirical {
    label en official "the holder is an employee performing services for the corporation in connection with the field activities (section 448(d)(2)(B)(i))";
}
pub relation shareholder_retired_employee_448d2Bii(corp: Person, holder: Person) kind empirical {
    label en official "the holder is a retired employee who had performed such services (section 448(d)(2)(B)(ii))";
}
pub relation shareholder_estate_of_qualifying_holder_448d2Biii(corp: Person, holder: Person, decedent: Person) kind empirical {
    label en official "the holder is the estate of the decedent (section 448(d)(2)(B)(iii))";
}
pub relation shareholder_acquired_by_reason_of_death_448d2Biv(corp: Person, holder: Person, decedent: Person, died_on: Date) kind empirical {
    label en official "the holder acquired the stock by reason of the death of the decedent on the date (section 448(d)(2)(B)(iv))";
}
pub relation shareholder_is_exempt_401a_plan_448d4B(corp: Person, holder: Person) kind empirical {
    label en official "the holder is a plan described in section 401(a) that is exempt from tax under section 501(a) (section 448(d)(4)(B))";
}
pub relation qualifying_individual_448d2Bi_ii(corp: Person, holder: Person) kind institutional {
    label en official "an employee performing services, or a retired employee who performed them (section 448(d)(2)(B)(i)-(ii))";
}
@source(IRC_S448_D, quote = "(i) employees performing services for such corporation in connection with the activities involving a field referred to in subparagraph (A),")
rule QualifyingIndividualEmployee(corp: Person, holder: Person) strict {
    label en official "(B)(i)";
    when shareholder_employee_performing_services_448d2Bi(corp, holder);
    then qualifying_individual_448d2Bi_ii(corp, holder);
}
@source(IRC_S448_D, quote = "(ii) retired employees who had performed such services for such corporation,")
rule QualifyingIndividualRetired(corp: Person, holder: Person) strict {
    label en official "(B)(ii)";
    when shareholder_retired_employee_448d2Bii(corp, holder);
    then qualifying_individual_448d2Bi_ii(corp, holder);
}
pub relation stock_test_date_448d2B(corp: Person, on: Date) kind empirical {
    label en official "the date on which the stock ownership test of (B) is applied";
}
pub relation qualified_stockholder_448d2B(corp: Person, holder: Person, on: Date) kind institutional {
    label en official "a holder whose stock counts for the (B) test on the date: an employee, a retired employee, an estate of one, a person who acquired by reason of death (only within 2 years after it), or a section 401(a) plan treated as an employee (section 448(d)(2)(B), (d)(4)(B))";
}
rule QualifiedStockholderIndividual(corp: Person, holder: Person, on: Date) strict {
    label en official "(B)(i)-(ii) at the test date";
    when qualifying_individual_448d2Bi_ii(corp, holder);
    when stock_test_date_448d2B(corp, on);
    then qualified_stockholder_448d2B(corp, holder, on);
}
@source(IRC_S448_D, quote = "(iii) the estate of any individual described in clause (i) or (ii), or")
rule QualifiedStockholderEstate(corp: Person, holder: Person, decedent: Person, on: Date) strict {
    label en official "(B)(iii): the estate of a qualifying individual";
    when shareholder_estate_of_qualifying_holder_448d2Biii(corp, holder, decedent);
    when qualifying_individual_448d2Bi_ii(corp, decedent);
    when stock_test_date_448d2B(corp, on);
    then qualified_stockholder_448d2B(corp, holder, on);
}
@source(IRC_S448_D, quote = "(iv) any other person who acquired such stock by reason of the death of an individual described in clause (i) or (ii) (but only for the 2-year period beginning on the date of the death of such individual).")
rule QualifiedStockholderAcquiredByDeath(corp: Person, holder: Person, decedent: Person, died_on: Date, on: Date) strict {
    label en official "(B)(iv): only for the 2-year period from the death";
    when shareholder_acquired_by_reason_of_death_448d2Biv(corp, holder, decedent, died_on);
    when qualifying_individual_448d2Bi_ii(corp, decedent);
    when stock_test_date_448d2B(corp, on);
    when on >= died_on;
    when on < add_calendar_period(died_on, 24 calendar_month);
    then qualified_stockholder_448d2B(corp, holder, on);
}
@source(IRC_S448_D, quote = "(B) stock held by a plan described in section 401(a) which is exempt from tax under section 501(a) shall be treated as held by an employee described in paragraph (2)(B)(i), and")
rule Plan401aTreatedAsEmployeeStockholder(corp: Person, holder: Person, on: Date) strict {
    label en official "a section 401(a) plan is treated as an employee holder (section 448(d)(4)(B))";
    when shareholder_is_exempt_401a_plan_448d4B(corp, holder);
    when stock_test_date_448d2B(corp, on);
    then qualified_stockholder_448d2B(corp, holder, on);
}
pub relation substantially_all_stock_by_value_held_by_qualified_stockholders_448d2B(corp: Person) kind empirical {
    label en official "substantially all of the stock, by value, is held directly or through partnerships, S corporations or other qualified personal service corporations by the holders of (B)(i)-(iv); an adjudicated fact";
}
pub relation qualified_personal_service_corporation_derived_448d2(corp: Person) kind institutional {
    label en official "a qualified personal service corporation: (A) substantially all activities in the listed fields and (B) substantially all stock held by qualified holders (section 448(d)(2))";
}
@source(IRC_S448_D, quote = "The term \"qualified personal service corporation\" means any corporation—")
rule QualifiedPersonalServiceCorporationFromComponents(corp: Person) strict {
    label en official "(A) and (B) (section 448(d)(2))";
    when substantially_all_activities_in_qualifying_fields_448d2A(corp);
    when substantially_all_stock_by_value_held_by_qualified_stockholders_448d2B(corp);
    then qualified_personal_service_corporation_derived_448d2(corp);
}
rule QpscDerivedExceptionOverridesCCorpProhibition(p: Person, y: TaxableYear) defeasible {
    label en official "a derived qualified personal service corporation is excepted from the (a)(1)/(a)(2) prohibition (section 448(b)(2), (d)(2))";
    when is_c_corporation_448(p);
    when qualified_personal_service_corporation_derived_448d2(p);
    when us.irc.core::year_of(p, y);
    then not cash_method_prohibited_448a(p, y);
}
pub relation affiliated_group_common_parent_elects_one_taxpayer_448d4C(common_parent: Person) kind empirical {
    label en official "the common parent of an affiliated group (section 1504(a)) elects that all members be treated as 1 taxpayer for paragraph (2)(B) (section 448(d)(4)(C))";
}
pub relation group_share_of_activities_in_same_field_448d4C(common_parent: Person, share: Decimal) kind empirical {
    label en official "the share of the group's activities that involve services in the same field described in (2)(A) (section 448(d)(4)(C)); the share is asserted";
}
pub relation affiliated_group_treated_as_one_taxpayer_448d4C(common_parent: Person) kind institutional {
    label en official "the members of the affiliated group are treated as 1 taxpayer for (2)(B) when the election is made and 90 percent or more of the activities are in the same field (section 448(d)(4)(C))";
}
@source(IRC_S448_D, quote = "if 90 percent or more of the activities of such group involve the performance of services in the same field described in paragraph (2)(A).")
rule AffiliatedGroupTreatedAsOneTaxpayer(common_parent: Person, share: Decimal) strict {
    label en official "election and at least 90 percent (section 448(d)(4)(C))";
    when affiliated_group_common_parent_elects_one_taxpayer_448d4C(common_parent);
    when group_share_of_activities_in_same_field_448d4C(common_parent, share);
    when share >= 0.90;
    then affiliated_group_treated_as_one_taxpayer_448d4C(common_parent);
}
pub relation uses_accrual_method_for_service_receipts_448d5(p: Person, y: TaxableYear) kind empirical {
    label en official "the person uses an accrual method with respect to amounts to be received for the performance of services (section 448(d)(5)(A))";
}
pub relation services_in_qualifying_fields_448d5Ai(p: Person, y: TaxableYear) kind empirical {
    label en official "the services are in fields referred to in paragraph (2)(A) (section 448(d)(5)(A)(i))";
}
pub relation meets_gross_receipts_test_for_all_prior_years_448d5Aii(p: Person, y: TaxableYear) kind empirical {
    label en official "the person meets the gross receipts test of subsection (c) for all prior taxable years (section 448(d)(5)(A)(ii)); the multi-year conjunction is asserted";
}
pub relation amount_uncollectible_on_experience_448d5A(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the portion of the amount that, on the basis of the person's experience, will not be collected (section 448(d)(5)(A))";
}
pub relation interest_or_late_payment_penalty_on_amount_448d5B(item: Integer) kind empirical {
    label en official "interest is required to be paid on the amount, or there is a penalty for failure to timely pay it (section 448(d)(5)(B))";
}
pub relation amount_not_required_to_be_accrued_448d5(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the portion the person will not collect need not be accrued (section 448(d)(5)(A)), unless interest is required or a late payment penalty applies (section 448(d)(5)(B))";
}
@source(IRC_S448_D, quote = "such person shall not be required to accrue any portion of such amounts which (on the basis of such person's experience) will not be collected if—")
rule UncollectibleServiceReceiptsNeedNotBeAccruedByField(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "services in the listed fields (section 448(d)(5)(A)(i))";
    when uses_accrual_method_for_service_receipts_448d5(p, y);
    when services_in_qualifying_fields_448d5Ai(p, y);
    when amount_uncollectible_on_experience_448d5A(p, y, item, amount);
    when not_known(interest_or_late_payment_penalty_on_amount_448d5B(item));
    then amount_not_required_to_be_accrued_448d5(p, y, item, amount);
}
rule UncollectibleServiceReceiptsNeedNotBeAccruedByReceipts(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "the gross receipts test for all prior years (section 448(d)(5)(A)(ii))";
    when uses_accrual_method_for_service_receipts_448d5(p, y);
    when meets_gross_receipts_test_for_all_prior_years_448d5Aii(p, y);
    when amount_uncollectible_on_experience_448d5A(p, y, item, amount);
    when not_known(interest_or_late_payment_penalty_on_amount_448d5B(item));
    then amount_not_required_to_be_accrued_448d5(p, y, item, amount);
}
pub relation trust_subject_to_tax_under_511b_448d6(trust: Person) kind empirical {
    label en official "a trust subject to tax under section 511(b) with unrelated trade or business activities (section 448(d)(6))";
}
pub relation trust_treated_as_c_corporation_for_unrelated_business_448d6(trust: Person) kind institutional {
    label en official "the trust is treated as a C corporation with respect to its unrelated trade or business activities (section 448(d)(6))";
}
@source(IRC_S448_D, quote = "a trust subject to tax under section 511(b) shall be treated as a C corporation with respect to its activities constituting an unrelated trade or business.")
rule Section511bTrustTreatedAsCCorporation(trust: Person) strict {
    label en official "section 511(b) trusts (section 448(d)(6))";
    when trust_subject_to_tax_under_511b_448d6(trust);
    then trust_treated_as_c_corporation_for_unrelated_business_448d6(trust);
}
rule CashMethodProhibitedUnrelatedBusinessTrust(p: Person, y: TaxableYear) defeasible {
    label en official "a section 511(b) trust is a C corporation for its unrelated business, so the cash method is prohibited unless the gross receipts test is met (section 448(a)(1), (d)(6))";
    when trust_treated_as_c_corporation_for_unrelated_business_448d6(p);
    when us.irc.core::year_of(p, y);
    unless meets_gross_receipts_test_448c(p, y);
    then cash_method_prohibited_448a(p, y);
}
