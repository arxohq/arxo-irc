// Section 442 — Change of annual accounting period. Stage 1 (IRC-07),
// priority section. The Secretary's approval is a `power` held by the
// Secretary (not the taxpayer): the taxpayer's request is the trigger fact,
// the Secretary's grant is the exercise, and the effect is that the new
// accounting period (`y_new`, the taxpayer's next ongoing `TaxableYear`)
// becomes the taxpayer's taxable year going forward. The second sentence (a
// taxpayer to whom section 441(g) applies who adopts a non-calendar annual
// accounting period is TREATED AS having changed its period, so the same
// approval requirement attaches) is modelled as an alternative trigger for
// the same power. `y_new` is keyed by `TaxableYear`, not a raw date, so that
// section 443(a)(1)'s short bridging period can reference the SAME approved
// change by pointing at the same `y_new` instance.

use self::{
    IRC_S442,
    Person,
    Secretary,
    TaxableYear,
    calendar_year_required_by_441g,
};

pub relation requests_change_of_accounting_period(p: Person, y_new: TaxableYear) kind empirical {
    label en official "the taxpayer requests approval to change its annual accounting period, adopting y_new as the new taxable year (section 442)";
}
pub relation adopts_noncalendar_period_while_441g_applies(p: Person, y: TaxableYear) kind empirical {
    label en official "a taxpayer to whom section 441(g) applies adopts an annual accounting period (as defined in section 441(c)) other than a calendar year — treated as a change of annual accounting period (section 442, second sentence)";
}
pub relation secretary_approves_change_of_accounting_period(p: Person, y_new: TaxableYear) kind empirical {
    label en official "the Secretary approves the taxpayer's change of annual accounting period to y_new (section 442)";
}
pub relation new_accounting_period_becomes_taxable_year(p: Person, y_new: TaxableYear) kind institutional {
    label en official "the new accounting period becomes the taxpayer's taxable year (section 442)";
}

@source(IRC_S442, quote = "If a taxpayer changes his annual accounting period, the new accounting period shall become the taxpayer's taxable year only if the change is approved by the Secretary")
rule Section442ChangeOfPeriodApprovalPower(p: Person, y_new: TaxableYear) strict {
    label en official "the new accounting period becomes the taxpayer's taxable year ONLY IF the Secretary approves the change (section 442)";
    when requests_change_of_accounting_period(p, y_new);
    then power Section442ApprovalOfChange {
        holder Secretary;
        over p;
        exercise secretary_approves_change_of_accounting_period(p, y_new);
        valid_when requests_change_of_accounting_period(p, y_new);
        effect create(new_accounting_period_becomes_taxable_year(p, y_new));
        window [@1954-08-16, infinity);
    };
}
// An unapproved change (`requests_change_of_accounting_period` true,
// `secretary_approves_change_of_accounting_period` false or absent) leaves
// `new_accounting_period_becomes_taxable_year` unestablished — the taxpayer's
// prior taxable year continues, which is the power's "no effect without
// valid exercise" default (E-0239); no separate negative rule is needed.

// Second sentence: deemed change when a section 441(g) taxpayer adopts a
// non-calendar period. This is a CLASSIFICATION that feeds the SAME power's
// trigger, not a second power — the deemed taxpayer still needs the
// Secretary's approval under the rule above once the request is made.
pub relation deemed_change_of_accounting_period(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer is treated as having changed its annual accounting period under section 442's second sentence";
}
@source(IRC_S442, quote = "if a taxpayer to whom section 441(g) applies adopts an annual accounting period (as defined in section 441(c)) other than a calendar year, the taxpayer shall be treated as having changed his annual accounting period")
rule Section442DeemedChangeFor441gTaxpayer(p: Person, y: TaxableYear) defeasible {
    label en official "a section 441(g) taxpayer that adopts a non-calendar annual accounting period is treated as having changed its accounting period (section 442, second sentence)";
    when calendar_year_required_by_441g(p, y);
    when adopts_noncalendar_period_while_441g_applies(p, y);
    then deemed_change_of_accounting_period(p, y);
}
