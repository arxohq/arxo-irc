// Section 453(l)(3): interest on the tax attributable to timeshare and residential-lot installment payments (module 52). NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S453L3-01-INTEREST-ON-ONE-PAYMENT-AT-AFR-COMPOUNDED-SEMIANNUALLY" {
    // Sale 2020-03-01, payment 2022-03-01: four whole six-month periods at 4%: 1000 x (1.04^4 - 1).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": timeshare_lot_election_in_effect_453l2B(entity_ref("urn:test:s453l:t1#p"), 1) { origin case_input; }
        assert "f1": installment_obligation_sale_date_453l3(1, @2020-03-01) { origin case_input; }
        assert "f2": installment_obligation_sale_year_453l3(1, entity_ref("urn:test:s453l:t1#ys")) { origin case_input; }
        assert "f3": applicable_federal_rate_at_sale_453l3(1, 0.08) { origin case_input; }
        assert "f4": tax_attributable_to_payment_453l3(entity_ref("urn:test:s453l:t1#p"), entity_ref("urn:test:s453l:t1#y"), 1, 1, @2022-03-01, 1000 USD) { origin case_input; }
    }
    evaluate truth(payment_interest_453l3(entity_ref("urn:test:s453l:t1#p"), entity_ref("urn:test:s453l:t1#y"), 1, 169.86 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453L3-02-TAX-INCREASE-IS-THE-SUM-OF-THE-YEARS-PAYMENT-INTEREST" {
    // Second payment 2022-09-15: five whole periods and a 14-day stub of a 181-day period; the year's interest is the sum.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": timeshare_lot_election_in_effect_453l2B(entity_ref("urn:test:s453l:t2#p"), 1) { origin case_input; }
        assert "f1": installment_obligation_sale_date_453l3(1, @2020-03-01) { origin case_input; }
        assert "f2": installment_obligation_sale_year_453l3(1, entity_ref("urn:test:s453l:t2#ys")) { origin case_input; }
        assert "f3": applicable_federal_rate_at_sale_453l3(1, 0.08) { origin case_input; }
        assert "f4": tax_attributable_to_payment_453l3(entity_ref("urn:test:s453l:t2#p"), entity_ref("urn:test:s453l:t2#y"), 1, 1, @2022-03-01, 1000 USD) { origin case_input; }
        assert "f5": tax_attributable_to_payment_453l3(entity_ref("urn:test:s453l:t2#p"), entity_ref("urn:test:s453l:t2#y"), 2, 1, @2022-09-15, 500 USD) { origin case_input; }
    }
    evaluate truth(tax_increase_by_interest_453l3A(entity_ref("urn:test:s453l:t2#p"), entity_ref("urn:test:s453l:t2#y"), 280.07 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453L3-03-INTEREST-IS-A-DEDUCTION-AMOUNT" {
    // Section 453(l)(3)(C).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": timeshare_lot_election_in_effect_453l2B(entity_ref("urn:test:s453l:t3#p"), 1) { origin case_input; }
        assert "f1": installment_obligation_sale_date_453l3(1, @2020-03-01) { origin case_input; }
        assert "f2": installment_obligation_sale_year_453l3(1, entity_ref("urn:test:s453l:t3#ys")) { origin case_input; }
        assert "f3": applicable_federal_rate_at_sale_453l3(1, 0.08) { origin case_input; }
        assert "f4": tax_attributable_to_payment_453l3(entity_ref("urn:test:s453l:t3#p"), entity_ref("urn:test:s453l:t3#y"), 1, 1, @2022-03-01, 1000 USD) { origin case_input; }
        assert "f5": tax_attributable_to_payment_453l3(entity_ref("urn:test:s453l:t3#p"), entity_ref("urn:test:s453l:t3#y"), 2, 1, @2022-09-15, 500 USD) { origin case_input; }
    }
    evaluate truth(interest_deduction_amount_453l3c(entity_ref("urn:test:s453l:t3#p"), entity_ref("urn:test:s453l:t3#y"), 280.07 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453L3-04-NO-INTEREST-ON-A-PAYMENT-IN-THE-YEAR-OF-THE-DISPOSITION" {
    // Section 453(l)(3)(B)(iii).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": timeshare_lot_election_in_effect_453l2B(entity_ref("urn:test:s453l:t4#p"), 1) { origin case_input; }
        assert "f1": installment_obligation_sale_date_453l3(1, @2020-03-01) { origin case_input; }
        assert "f2": installment_obligation_sale_year_453l3(1, entity_ref("urn:test:s453l:t4#ys")) { origin case_input; }
        assert "f3": applicable_federal_rate_at_sale_453l3(1, 0.08) { origin case_input; }
        assert "f4": tax_attributable_to_payment_453l3(entity_ref("urn:test:s453l:t4#p"), entity_ref("urn:test:s453l:t4#ys"), 1, 1, @2020-11-01, 1000 USD) { origin case_input; }
    }
    evaluate truth(payment_interest_453l3(entity_ref("urn:test:s453l:t4#p"), entity_ref("urn:test:s453l:t4#ys"), 1, 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453L3-05-NO-ELECTION-NO-INTEREST" {
    // The obligation is not one to which paragraph (2)(B) applies.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": installment_obligation_sale_date_453l3(1, @2020-03-01) { origin case_input; }
        assert "f1": installment_obligation_sale_year_453l3(1, entity_ref("urn:test:s453l:t5#ys")) { origin case_input; }
        assert "f2": applicable_federal_rate_at_sale_453l3(1, 0.08) { origin case_input; }
        assert "f3": tax_attributable_to_payment_453l3(entity_ref("urn:test:s453l:t5#p"), entity_ref("urn:test:s453l:t5#y"), 1, 1, @2022-03-01, 1000 USD) { origin case_input; }
    }
    evaluate truth(payment_interest_453l3(entity_ref("urn:test:s453l:t5#p"), entity_ref("urn:test:s453l:t5#y"), 1, 169.86 USD));
    expect truth_status == NEITHER;
}
