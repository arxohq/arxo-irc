    expect truth_status == NEITHER;
}

test "S460B-118-ADJUSTED-OVERPAYMENT-RATE-IS-THE-QUARTER-RATE-AT-THE-PERIOD-START" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": preceding_taxable_year_465(entity_ref("urn:test:s460b:t118#y0"), entity_ref("urn:test:s460b:t118#y1")) { origin case_input; }
        assert "f1": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t118#p"), entity_ref("urn:test:s460b:t118#y0"), @2024-04-15) { origin case_input; }
        assert "f2": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t118#p"), entity_ref("urn:test:s460b:t118#y1"), @2025-04-15) { origin case_input; }
        assert "f3": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2024-04-16, 0.08) { origin case_input; }
    }
    evaluate truth(adjusted_overpayment_rate_460b7A(entity_ref("urn:test:s460b:t118#p"), entity_ref("urn:test:s460b:t118#y0"), 0.08));
    expect truth_status == TRUE_ONLY;
}

