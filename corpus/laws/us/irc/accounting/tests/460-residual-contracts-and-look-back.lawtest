// Section 460 residual scenarios (stage 3). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S460B-01-COMMENCEMENT-DATE-IS-THE-FIRST-ALLOCABLE-COST-DATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": allocable_cost_incurred_on_460g(1, @2024-03-01) { origin case_input; }
        assert "f1": allocable_cost_incurred_on_460g(1, @2024-05-10) { origin case_input; }
    }
    evaluate truth(contract_commencement_date_460g(1, @2024-03-01));
    expect truth_status == TRUE_ONLY;
}

