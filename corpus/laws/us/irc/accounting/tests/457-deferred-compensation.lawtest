// Section 457 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S457-01-GOVERNMENTAL-PLAN-INCLUSION-WHEN-PAID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_eligible_employer_governmental(entity_ref("urn:test:s457:t1#employer")) { origin case_input; }
        assert "f1": is_eligible_deferred_compensation_plan(entity_ref("urn:test:s457:t1#employer"), 1) { origin case_input; }
        assert "f2": deferred_compensation_paid_to_participant(entity_ref("urn:test:s457:t1#employer"), 1, entity_ref("urn:test:s457:t1#y"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(section_457_inclusion(entity_ref("urn:test:s457:t1#employer"), 1, entity_ref("urn:test:s457:t1#y"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S457-02-INELIGIBLE-PLAN-INCLUSION-AT-VESTING" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_ineligible_deferred_compensation_plan(entity_ref("urn:test:s457:t2#employer"), 2) { origin case_input; }
        assert "f1": compensation_deferred_under_ineligible_plan(entity_ref("urn:test:s457:t2#employer"), 2, 50000.00 USD) { origin case_input; }
        assert "f2": no_substantial_risk_of_forfeiture_457f(entity_ref("urn:test:s457:t2#employer"), 2, entity_ref("urn:test:s457:t2#y")) { origin case_input; }
        assert "f3": first_year_no_substantial_risk_of_forfeiture_457f(entity_ref("urn:test:s457:t2#employer"), 2, entity_ref("urn:test:s457:t2#y")) { origin case_input; }
    }
    evaluate truth(section_457_inclusion(entity_ref("urn:test:s457:t2#employer"), 2, entity_ref("urn:test:s457:t2#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S457-03-DEFERRAL-CEILING-DOLLAR-AMOUNT-GOVERNS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": includible_compensation_457(entity_ref("urn:test:s457:t3#employer"), 3, entity_ref("urn:test:s457:t3#y"), 200000.00 USD) { origin case_input; }
    }
    // ApplicableDollarAmount457 = $15,000, less than includible compensation of $200,000.
    evaluate truth(deferral_ceiling_457(entity_ref("urn:test:s457:t3#employer"), 3, entity_ref("urn:test:s457:t3#y"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S457-04-DISTRIBUTION-PERMITTED-ON-SEVERANCE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participant_has_severance_from_employment(entity_ref("urn:test:s457:t4#employer"), 4, entity_ref("urn:test:s457:t4#y")) { origin case_input; }
    }
    evaluate truth(distribution_permitted_under_457d(entity_ref("urn:test:s457:t4#employer"), 4, entity_ref("urn:test:s457:t4#y")));
    expect truth_status == TRUE_ONLY;
}
