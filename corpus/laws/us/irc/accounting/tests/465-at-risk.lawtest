// Section 465 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S465-01-LOSS-WITHIN-AMOUNT-AT-RISK-FULLY-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": activity_subject_to_465(entity_ref("urn:test:s465:t1#p"), 1) { origin case_input; }
        assert "f1": computing_amount_at_risk_for_year(entity_ref("urn:test:s465:t1#p"), entity_ref("urn:test:s465:t1#y1"), 1) { origin case_input; }
        assert "f2": amount_contributed_to_activity(entity_ref("urn:test:s465:t1#p"), 1, 20000 USD) { origin case_input; }
        assert "f3": amount_borrowed_at_risk_for_activity(entity_ref("urn:test:s465:t1#p"), 1, 0.00 USD) { origin case_input; }
        assert "f4": loss_from_activity_465(entity_ref("urn:test:s465:t1#p"), entity_ref("urn:test:s465:t1#y1"), 1, 15000 USD) { origin case_input; }
    }
    evaluate truth(at_risk_loss_allowed(entity_ref("urn:test:s465:t1#p"), entity_ref("urn:test:s465:t1#y1"), 1, 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S465-02-LOSS-EXCEEDS-AMOUNT-AT-RISK-CARRYOVER-TO-YEAR-2" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": activity_subject_to_465(entity_ref("urn:test:s465:t2#p"), 1) { origin case_input; }
        assert "f1": computing_amount_at_risk_for_year(entity_ref("urn:test:s465:t2#p"), entity_ref("urn:test:s465:t2#y1"), 1) { origin case_input; }
        assert "f2": amount_contributed_to_activity(entity_ref("urn:test:s465:t2#p"), 1, 10000 USD) { origin case_input; }
        assert "f3": amount_borrowed_at_risk_for_activity(entity_ref("urn:test:s465:t2#p"), 1, 0.00 USD) { origin case_input; }
        assert "f4": loss_from_activity_465(entity_ref("urn:test:s465:t2#p"), entity_ref("urn:test:s465:t2#y1"), 1, 15000 USD) { origin case_input; }
    }
    // Loss $15,000 vs. amount at risk $10,000: allowed $10,000, carryover $5,000.
    evaluate truth(at_risk_loss_allowed(entity_ref("urn:test:s465:t2#p"), entity_ref("urn:test:s465:t2#y1"), 1, 10000 USD));
    expect truth_status == TRUE_ONLY;
}

