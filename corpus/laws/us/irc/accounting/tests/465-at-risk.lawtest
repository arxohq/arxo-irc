}

test "S465-03-NEGATIVE-AMOUNT-AT-RISK-RECAPTURE-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Amount at risk falls to -2,000 (e.g. after (b)(5) reductions the
        // case supplies via contributed/borrowed already netted negative
        // is not directly expressible with this stage's additive rule, so
        // the case asserts the at-risk figure via a negative "borrowed"
        // correction is not modelled; this scenario instead exercises the
        // recapture rule directly against an asserted negative amount).
        assert "f0": amount_at_risk_at_close(entity_ref("urn:test:s465:t3#p"), entity_ref("urn:test:s465:t3#y2"), 1, -2000 USD) { origin case_input; }
        assert "f1": aggregate_prior_reductions_465b5(entity_ref("urn:test:s465:t3#p"), entity_ref("urn:test:s465:t3#y2"), 1, 10000 USD) { origin case_input; }
        assert "f2": amounts_previously_included_under_465e(entity_ref("urn:test:s465:t3#p"), entity_ref("urn:test:s465:t3#y2"), 1, 0.00 USD) { origin case_input; }
    }
    evaluate truth(at_risk_recapture_income(entity_ref("urn:test:s465:t3#p"), entity_ref("urn:test:s465:t3#y2"), 1, 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S465-04-POSITIVE-AMOUNT-AT-RISK-NO-RECAPTURE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": amount_at_risk_at_close(entity_ref("urn:test:s465:t4#p"), entity_ref("urn:test:s465:t4#y"), 1, 5000 USD) { origin case_input; }
    }
    evaluate truth(at_risk_recapture_income(entity_ref("urn:test:s465:t4#p"), entity_ref("urn:test:s465:t4#y"), 1, 0.00 USD));
    expect truth_status == FALSE_ONLY;
}
