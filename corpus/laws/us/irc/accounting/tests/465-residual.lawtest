        assert "f9": amount_borrowed_at_risk_for_activity(entity_ref("urn:test:s465r:t21#p"), 1, 0 USD) { origin case_input; }
    }
    evaluate truth(loss_exempt_from_465a_by_c4_or_c7(entity_ref("urn:test:s465r:t21#p"), entity_ref("urn:test:s465r:t21#y"), 1));
    expect truth_status == TRUE_ONLY;
    evaluate truth(at_risk_loss_allowed(entity_ref("urn:test:s465r:t21#p"), entity_ref("urn:test:s465r:t21#y"), 1, 60000 USD));
    expect truth_status == TRUE_ONLY;
}

