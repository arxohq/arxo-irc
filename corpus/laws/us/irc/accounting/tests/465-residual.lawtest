test "S465R-01-INDIVIDUAL-IS-SUBJECT-TO-465" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_individual_taxpayer_465(entity_ref("urn:test:s465r:t1#p")) { origin case_input; }
    }
    evaluate truth(person_subject_to_465a1(entity_ref("urn:test:s465r:t1#p")));
    expect truth_status == TRUE_ONLY;
}

