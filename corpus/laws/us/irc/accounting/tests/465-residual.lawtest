        assert "f1": business_full_time_nonowner_employees_12_months(entity_ref("urn:test:s465r:t24#p"), 3, 3) { origin case_input; }
        assert "f2": business_deductions_162_404(entity_ref("urn:test:s465r:t24#p"), 3, entity_ref("urn:test:s465r:t24#y"), 150001 USD) { origin case_input; }
        assert "f3": business_gross_income_465(entity_ref("urn:test:s465r:t24#p"), 3, entity_ref("urn:test:s465r:t24#y"), 1000000 USD) { origin case_input; }
    }
    // Deductions 150,001 exceed 15 percent of 1,000,000.
    evaluate truth(is_qualifying_business_465c7C(entity_ref("urn:test:s465r:t24#p"), 3, entity_ref("urn:test:s465r:t24#y")));
    expect truth_status == TRUE_ONLY;
}

