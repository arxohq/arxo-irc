test "S465R-10-DERIVED-LOSS-LIMITED-TO-AMOUNT-AT-RISK" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_individual_taxpayer_465(entity_ref("urn:test:s465r:t10#p")) { origin case_input; }
        assert "f1": engaged_in_activity_for_465(entity_ref("urn:test:s465r:t10#p"), 1) { origin case_input; }
        assert "f2": deductions_allocable_to_activity_465d(entity_ref("urn:test:s465r:t10#p"), entity_ref("urn:test:s465r:t10#y"), 1, 100000 USD) { origin case_input; }
        assert "f3": income_from_activity_465d(entity_ref("urn:test:s465r:t10#p"), entity_ref("urn:test:s465r:t10#y"), 1, 40000 USD) { origin case_input; }
        assert "f4": computing_amount_at_risk_for_year(entity_ref("urn:test:s465r:t10#p"), entity_ref("urn:test:s465r:t10#y"), 1) { origin case_input; }
        assert "f5": amount_contributed_to_activity(entity_ref("urn:test:s465r:t10#p"), 1, 25000 USD) { origin case_input; }
        assert "f6": amount_borrowed_at_risk_for_activity(entity_ref("urn:test:s465r:t10#p"), 1, 15000 USD) { origin case_input; }
    }
    evaluate truth(at_risk_loss_allowed(entity_ref("urn:test:s465r:t10#p"), entity_ref("urn:test:s465r:t10#y"), 1, 40000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(at_risk_loss_carryover_to_next_year(entity_ref("urn:test:s465r:t10#p"), entity_ref("urn:test:s465r:t10#y"), 1, 20000 USD));
    expect truth_status == TRUE_ONLY;
}

