// Section 471 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S471-01-SECRETARY-OPINION-INVENTORIES-NECESSARY-REQUIRED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": secretary_opinion_inventories_necessary(entity_ref("urn:test:s471:t1#p"), entity_ref("urn:test:s471:t1#y")) { origin adjudicated; }
    }
    evaluate truth(inventories_required_471a(entity_ref("urn:test:s471:t1#p"), entity_ref("urn:test:s471:t1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S471-02-NO-OPINION-YET-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": uses_inventory_method(entity_ref("urn:test:s471:t2#p"), entity_ref("urn:test:s471:t2#y")) { origin case_input; }
    }
    evaluate truth(inventories_required_471a(entity_ref("urn:test:s471:t2#p"), entity_ref("urn:test:s471:t2#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}

test "S471-03-SMALL-BUSINESS-EXEMPTION-BLOCKS-471A" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": secretary_opinion_inventories_necessary(entity_ref("urn:test:s471:t3#p"), entity_ref("urn:test:s471:t3#y")) { origin adjudicated; }
        assert "f1": meets_gross_receipts_test_448c(entity_ref("urn:test:s471:t3#p"), entity_ref("urn:test:s471:t3#y")) { origin case_input; }
    }
    evaluate truth(inventories_required_471a(entity_ref("urn:test:s471:t3#p"), entity_ref("urn:test:s471:t3#y")));
    expect truth_status == FALSE_ONLY;
}

test "S471-04-TAX-SHELTER-EXCLUDED-FROM-SMALL-BUSINESS-EXEMPTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": meets_gross_receipts_test_448c(entity_ref("urn:test:s471:t4#p"), entity_ref("urn:test:s471:t4#y")) { origin case_input; }
        assert "f1": is_tax_shelter_448a3(entity_ref("urn:test:s471:t4#p")) { origin case_input; }
    }
    evaluate truth(small_business_inventory_exemption_471c(entity_ref("urn:test:s471:t4#p"), entity_ref("urn:test:s471:t4#y")));
    expect truth_status == FALSE_ONLY;
}
