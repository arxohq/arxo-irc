test "S48-07-QUALIFIED-GAIN-ADDS-ORDINARY-AND-OTHER-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": ordinary_income_from_1245_or_1250_on_transaction_451k2A(entity_ref("urn:test:s48:t7#p"), entity_ref("urn:test:s48:t7#y"), 1, 30000 USD) { origin case_input; }
        assert "f1": other_income_from_transaction_required_in_gross_income_451k2B(entity_ref("urn:test:s48:t7#p"), entity_ref("urn:test:s48:t7#y"), 1, 70000 USD) { origin case_input; }
    }
    evaluate truth(qualified_gain_derived_451k2(entity_ref("urn:test:s48:t7#p"), entity_ref("urn:test:s48:t7#y"), 1, 100000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S48-08-ELECTION-COVERS-ALL-ITEMS-OF-THE-BUSINESS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": election_made_for_trade_or_business_prepaid_income_448(entity_ref("urn:test:s48:t8#p"), 1, 455) { origin case_input; }
        assert "f1": item_received_in_connection_with_business_448(9, 1, 455) { origin case_input; }
    }
    evaluate truth(item_covered_by_election_448(entity_ref("urn:test:s48:t8#p"), 1, 9, 455));
    expect truth_status == TRUE_ONLY;
}

test "S48-09-REGULATIONS-MAY-TAKE-A-SHORT-LIABILITY-OUT-OF-THE-ELECTION" {
