// Residual election scope scenarios: 447, 451, 455, 456, 458 (stage 3). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S48-01-ELECTION-PERMITTED-FOR-THE-FIRST-FARMING-YEAR-AFTER-1986" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": corporation_makes_447e4B_election(entity_ref("urn:test:s48:t1#p"), entity_ref("urn:test:s48:t1#y")) { origin case_input; }
        assert "f1": year_is_first_year_after_1986_engaged_in_farming_447e4Biii(entity_ref("urn:test:s48:t1#p"), entity_ref("urn:test:s48:t1#y")) { origin case_input; }
    }
    evaluate truth(election_447e4B_permitted_447e4Biii(entity_ref("urn:test:s48:t1#p"), entity_ref("urn:test:s48:t1#y")));
    expect truth_status == TRUE_ONLY;
}

