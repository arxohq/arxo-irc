        assert "f0": election_made_for_trade_or_business_prepaid_income_448(entity_ref("urn:test:s48:t9#p"), 1, 455) { origin case_input; }
        assert "f1": item_received_in_connection_with_business_448(9, 1, 455) { origin case_input; }
        assert "f2": regulations_permit_inclusion_in_year_of_receipt_448(9, 455) { origin case_input; }
    }
    evaluate truth(item_covered_by_election_448(entity_ref("urn:test:s48:t9#p"), 1, 9, 455));
    expect truth_status == NEITHER;
}

