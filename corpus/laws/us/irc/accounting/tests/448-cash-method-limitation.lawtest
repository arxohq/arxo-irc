        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s448:t2#p"), entity_ref("urn:test:s448:t2#y")) { origin case_input; }
        assert "f2": average_annual_gross_receipts_prior_3_years(entity_ref("urn:test:s448:t2#p"), entity_ref("urn:test:s448:t2#y"), 20000000 USD) { origin case_input; }
