// Section 448 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S448-01-C-CORPORATION-BELOW-THRESHOLD-CASH-METHOD-PROHIBITED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_c_corporation_448(entity_ref("urn:test:s448:t1#p")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s448:t1#p"), entity_ref("urn:test:s448:t1#y")) { origin case_input; }
        assert "f2": average_annual_gross_receipts_prior_3_years(entity_ref("urn:test:s448:t1#p"), entity_ref("urn:test:s448:t1#y"), 30000000 USD) { origin case_input; }
    }
    evaluate truth(cash_method_prohibited_448a(entity_ref("urn:test:s448:t1#p"), entity_ref("urn:test:s448:t1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S448-02-C-CORPORATION-MEETS-GROSS-RECEIPTS-TEST-EXCEPTED" {
