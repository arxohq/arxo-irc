        assert "f4": deductions_219_221_250_469i3E(entity_ref("urn:test:s469r:t74#p"), entity_ref("urn:test:s469r:t74#y"), 0 USD) { origin case_input; }
        assert "f5": passive_loss_and_469c7_loss_469i3E(entity_ref("urn:test:s469r:t74#p"), entity_ref("urn:test:s469r:t74#y"), 0 USD) { origin case_input; }
    }
    // 130,000 is below 200,000: no reduction.
