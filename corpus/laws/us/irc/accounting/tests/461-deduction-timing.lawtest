    expect truth_status == FALSE_ONLY;
}

test "S461-12-EXCESS-BUSINESS-LOSS-CARRIED-AS-NOL-TWO-YEAR-CARRYOVER" {
    given {
        context {
            legal_time @2022-04-15;
            decision_time @2022-04-15T09:00:00-05:00;
            knowledge_time @2022-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s461:t12#y1"), @2022-01-01) { origin case_input; }
        assert "f1": aggregate_business_deductions_461l(entity_ref("urn:test:s461:t12#p"), entity_ref("urn:test:s461:t12#y1"), 900000 USD) { origin case_input; }
        assert "f2": aggregate_business_income_or_gain_461l(entity_ref("urn:test:s461:t12#p"), entity_ref("urn:test:s461:t12#y1"), 400000 USD) { origin case_input; }
        assert "f3": us.irc.core::year_of(entity_ref("urn:test:s461:t12#p"), entity_ref("urn:test:s461:t12#y1")) { origin case_input; }
    }
    // year 1's $250,000 disallowed excess business loss becomes an NOL
    // carryover under section 172(b) for year 2 (year 2 itself is outside
    // this package's scope: `deductions` owns section 172(b)'s own carryover
    // computation; this test exercises only the section 461(l)(2) bridge).
    evaluate truth(excess_business_loss_carried_as_nol(entity_ref("urn:test:s461:t12#p"), entity_ref("urn:test:s461:t12#y1"), 250000 USD));
    expect truth_status == TRUE_ONLY;
}
