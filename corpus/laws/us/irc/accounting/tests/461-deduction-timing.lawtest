test "S461-06-RECURRING-ITEM-EXCEPTION-WITHIN-8-5-MONTHS-BOUNDARY-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Boundary case: performance occurs exactly at the shorter-of
        // deadline; the case asserts the boundary test result directly
        // (the exact date arithmetic is TECH_GAP, see 07-deduction-timing.law).
        assert "f0": all_events_test_met_461h(entity_ref("urn:test:s461:t6#p"), entity_ref("urn:test:s461:t6#y"), 1) { origin case_input; }
        assert "f1": economic_performance_within_shorter_of_reasonable_period_or_8_5_months(entity_ref("urn:test:s461:t6#p"), entity_ref("urn:test:s461:t6#y"), 1) { origin case_input; }
        assert "f2": item_recurring_and_consistently_treated(entity_ref("urn:test:s461:t6#p"), entity_ref("urn:test:s461:t6#y"), 1) { origin case_input; }
        assert "f3": item_not_material(entity_ref("urn:test:s461:t6#p"), entity_ref("urn:test:s461:t6#y"), 1) { origin case_input; }
    }
    evaluate truth(liability_incurred_in_year(entity_ref("urn:test:s461:t6#p"), entity_ref("urn:test:s461:t6#y"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S461-07-RECURRING-ITEM-EXCEPTION-BEYOND-8-5-MONTHS-NOT-ALLOWED-YET" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": all_events_test_met_461h(entity_ref("urn:test:s461:t7#p"), entity_ref("urn:test:s461:t7#y"), 1) { origin case_input; }
        assert "f1": item_recurring_and_consistently_treated(entity_ref("urn:test:s461:t7#p"), entity_ref("urn:test:s461:t7#y"), 1) { origin case_input; }
        assert "f2": item_not_material(entity_ref("urn:test:s461:t7#p"), entity_ref("urn:test:s461:t7#y"), 1) { origin case_input; }
        // Performance-within-window fact NOT asserted, and performance did
        // not occur in y: liability is not (yet) incurred in y.
    }
    evaluate truth(liability_incurred_in_year(entity_ref("urn:test:s461:t7#p"), entity_ref("urn:test:s461:t7#y"), 1));
    expect truth_status == FALSE_ONLY;
}

