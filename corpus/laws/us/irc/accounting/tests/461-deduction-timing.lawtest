// Section 461 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S461-01-DEDUCTION-TAKEN-IN-PROPER-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": deduction_or_credit_item(entity_ref("urn:test:s461:t1#p"), entity_ref("urn:test:s461:t1#y"), 1, 2000 USD) { origin case_input; }
        assert "f1": proper_taxable_year_under_method(entity_ref("urn:test:s461:t1#p"), entity_ref("urn:test:s461:t1#y"), 1) { origin case_input; }
    }
    evaluate truth(deduction_taken_in_year(entity_ref("urn:test:s461:t1#p"), entity_ref("urn:test:s461:t1#y"), 1, 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S461-02-REAL-PROPERTY-TAX-ELECTION-WITHOUT-CONSENT-TIMELY-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": incurs_real_property_tax_related_to_definite_period(entity_ref("urn:test:s461:t2#p"), entity_ref("urn:test:s461:t2#y"), 1) { origin case_input; }
        assert "f1": is_first_taxable_year_incurring_real_property_taxes(entity_ref("urn:test:s461:t2#p"), entity_ref("urn:test:s461:t2#y")) { origin case_input; }
        assert "f2": elects_ratable_accrual_of_real_property_tax(entity_ref("urn:test:s461:t2#p"), 1) { origin case_input; }
        assert "f3": election_made_by_return_due_date_461c(entity_ref("urn:test:s461:t2#p"), entity_ref("urn:test:s461:t2#y"), 1) { origin case_input; }
    }
    evaluate truth(real_property_tax_accrued_ratably(entity_ref("urn:test:s461:t2#p"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S461-03-REAL-PROPERTY-TAX-ELECTION-UNTIMELY-WITHOUT-CONSENT-INVALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": incurs_real_property_tax_related_to_definite_period(entity_ref("urn:test:s461:t3#p"), entity_ref("urn:test:s461:t3#y"), 1) { origin case_input; }
        assert "f1": is_first_taxable_year_incurring_real_property_taxes(entity_ref("urn:test:s461:t3#p"), entity_ref("urn:test:s461:t3#y")) { origin case_input; }
        assert "f2": elects_ratable_accrual_of_real_property_tax(entity_ref("urn:test:s461:t3#p"), 1) { origin case_input; }
        // Not timely, no Secretary consent asserted: POWER_INVALID_EXERCISE.
    }
    evaluate truth(real_property_tax_accrued_ratably(entity_ref("urn:test:s461:t3#p"), 1));
    expect truth_status == FALSE_ONLY;
}

