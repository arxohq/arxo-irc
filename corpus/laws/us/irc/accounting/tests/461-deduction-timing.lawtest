test "S461-09-EXCESS-BUSINESS-LOSS-OVER-THRESHOLD-DISALLOWED-SINGLE" {
    given {
        context {
            legal_time @2022-04-15;
            decision_time @2022-04-15T09:00:00-05:00;
            knowledge_time @2022-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Year begins 2022-01-01 (within the 2021-2025 pinned-text window).
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s461:t9#y"), @2022-01-01) { origin case_input; }
        assert "f1": aggregate_business_deductions_461l(entity_ref("urn:test:s461:t9#p"), entity_ref("urn:test:s461:t9#y"), 900000 USD) { origin case_input; }
        assert "f2": aggregate_business_income_or_gain_461l(entity_ref("urn:test:s461:t9#p"), entity_ref("urn:test:s461:t9#y"), 400000 USD) { origin case_input; }
        assert "f3": us.irc.core::year_of(entity_ref("urn:test:s461:t9#p"), entity_ref("urn:test:s461:t9#y")) { origin case_input; }
    }
    // deductions 900,000 - (income 400,000 + threshold 250,000) = 250,000.
    evaluate truth(excess_business_loss_disallowed(entity_ref("urn:test:s461:t9#p"), entity_ref("urn:test:s461:t9#y"), 250000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S461-10-EXCESS-BUSINESS-LOSS-JOINT-RETURN-DOUBLE-THRESHOLD-NOT-DISALLOWED" {
    given {
        context {
            legal_time @2022-04-15;
            decision_time @2022-04-15T09:00:00-05:00;
            knowledge_time @2022-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s461:t10#y"), @2022-01-01) { origin case_input; }
        assert "f1": aggregate_business_deductions_461l(entity_ref("urn:test:s461:t10#p"), entity_ref("urn:test:s461:t10#y"), 900000 USD) { origin case_input; }
        assert "f2": aggregate_business_income_or_gain_461l(entity_ref("urn:test:s461:t10#p"), entity_ref("urn:test:s461:t10#y"), 400000 USD) { origin case_input; }
        assert "f3": us.irc.core::year_of(entity_ref("urn:test:s461:t10#p"), entity_ref("urn:test:s461:t10#y")) { origin case_input; }
        assert "f4": files_joint_return_461l(entity_ref("urn:test:s461:t10#p"), entity_ref("urn:test:s461:t10#y")) { origin case_input; }
    }
    // deductions 900,000 - (income 400,000 + threshold 500,000) = 0: no excess.
    evaluate truth(excess_business_loss(entity_ref("urn:test:s461:t10#p"), entity_ref("urn:test:s461:t10#y"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

