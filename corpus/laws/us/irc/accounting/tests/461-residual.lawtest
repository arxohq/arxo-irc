test "S461R-23-FARMING-ENTERPRISE-USES-FARMING-SYNDICATE-TEST-NOT-REGISTERED-OFFERING-RULE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": trade_or_business_of_farming_464e(entity_ref("urn:test:s461r:t23#p")) { origin case_input; }
        assert "f1": share_of_losses_allocable_to_limited_partners_or_entrepreneurs(entity_ref("urn:test:s461r:t23#p"), 30.0) { origin case_input; }
        assert "f2": enterprise_offered_in_registered_offering(entity_ref("urn:test:s461r:t23#p")) { origin case_input; }
    }
    // A farming enterprise with a registered offering is a farming syndicate under (k)(1)(A); the (3)(A) route is displaced by (i)(4), and the result is the same only through (k).
    evaluate truth(is_tax_shelter_461i3(entity_ref("urn:test:s461r:t23#p")));
    expect truth_status == TRUE_ONLY;
}

