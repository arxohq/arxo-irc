// Section 461 residual and Pub. L. 119-21 edition scenarios (stage 2c). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S461R-01-DEATH-ACCRUAL-DEDUCTION-NOT-ALLOWED-IN-FINAL-PERIOD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_accounting_method(entity_ref("urn:test:s461r:t1#p"), entity_ref("urn:test:s461r:t1#y"), Accrual) { origin case_input; }
        assert "f1": deduction_or_credit_accrued_only_by_reason_of_death(entity_ref("urn:test:s461r:t1#p"), entity_ref("urn:test:s461r:t1#y"), 12000 USD) { origin case_input; }
    }
    evaluate truth(accrued_by_reason_of_death_not_allowed(entity_ref("urn:test:s461r:t1#p"), entity_ref("urn:test:s461r:t1#y"), 12000 USD));
    expect truth_status == TRUE_ONLY;
}

