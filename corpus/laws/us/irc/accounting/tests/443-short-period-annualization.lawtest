// Section 443 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S443-01-APPROVED-CHANGE-TRIGGERS-SHORT-PERIOD-RETURN" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": short_period_from_approved_change(entity_ref("urn:test:s443:t1#p"), entity_ref("urn:test:s443:t1#yshort"), entity_ref("urn:test:s443:t1#ynew")) { origin case_input; }
        assert "f1": secretary_approves_change_of_accounting_period(entity_ref("urn:test:s443:t1#p"), entity_ref("urn:test:s443:t1#ynew")) { origin case_input; }
    }
    evaluate truth(short_period_return_required(entity_ref("urn:test:s443:t1#p"), entity_ref("urn:test:s443:t1#yshort")));
    expect truth_status == TRUE_ONLY;
}

test "S443-02-SIX-MONTH-SHORT-PERIOD-ANNUALIZATION-INTERMEDIATE-VALUE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Modified taxable income for the 6-month short period: $60,000.
        // Placed on an annual basis: 60000 * 12 / 6 = $120,000.
        assert "f0": us.irc.gross_income::taxable_income(entity_ref("urn:test:s443:t2#p"), entity_ref("urn:test:s443:t2#yshort"), 60000 USD) { origin case_input; }
        assert "f1": months_in_short_period(entity_ref("urn:test:s443:t2#yshort"), 6) { origin case_input; }
    }
    evaluate truth(annualized_modified_taxable_income(entity_ref("urn:test:s443:t2#p"), entity_ref("urn:test:s443:t2#yshort"), 120000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S443-03-SHORT-PERIOD-TAX-PRORATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": short_period_from_approved_change(entity_ref("urn:test:s443:t3#p"), entity_ref("urn:test:s443:t3#yshort"), entity_ref("urn:test:s443:t3#ynew")) { origin case_input; }
        assert "f1": secretary_approves_change_of_accounting_period(entity_ref("urn:test:s443:t3#p"), entity_ref("urn:test:s443:t3#ynew")) { origin case_input; }
        assert "f2": us.irc.gross_income::taxable_income(entity_ref("urn:test:s443:t3#p"), entity_ref("urn:test:s443:t3#yshort"), 60000 USD) { origin case_input; }
        assert "f3": months_in_short_period(entity_ref("urn:test:s443:t3#yshort"), 6) { origin case_input; }
        // The tax on the $120,000 annualized income, as computed by the
        // (external) rate-schedule owner: asserted directly here since this
        // package does not implement the rate schedule.
        assert "f4": tax_computed_on_annualized_basis(entity_ref("urn:test:s443:t3#p"), entity_ref("urn:test:s443:t3#yshort"), 120000 USD, 20000 USD) { origin case_input; }
    }
    // 20000 * 6 / 12 = 10000.
    evaluate truth(short_period_tax(entity_ref("urn:test:s443:t3#p"), entity_ref("urn:test:s443:t3#yshort"), 10000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S443-04-UNKNOWN-MONTHS-NO-ANNUALIZATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::taxable_income(entity_ref("urn:test:s443:t4#p"), entity_ref("urn:test:s443:t4#yshort"), 60000 USD) { origin case_input; }
        // months_in_short_period is not asserted.
    }
    evaluate truth(annualized_modified_taxable_income(entity_ref("urn:test:s443:t4#p"), entity_ref("urn:test:s443:t4#yshort"), 120000 USD));
    expect truth_status == FALSE_ONLY;
}
