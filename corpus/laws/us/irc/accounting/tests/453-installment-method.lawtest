        assert "f1": at_least_one_payment_after_close_of_disposition_year(entity_ref("urn:test:s453:t4#p"), entity_ref("urn:test:s453:t4#y"), 1) { origin case_input; }
        assert "f2": elects_out_of_installment_method(entity_ref("urn:test:s453:t4#p"), entity_ref("urn:test:s453:t4#y"), 1) { origin case_input; }
        assert "f3": election_out_made_by_return_due_date(entity_ref("urn:test:s453:t4#p"), entity_ref("urn:test:s453:t4#y"), 1) { origin case_input; }
