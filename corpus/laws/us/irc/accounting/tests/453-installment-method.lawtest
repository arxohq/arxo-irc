// Section 453 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S453-01-INSTALLMENT-SALE-DEFINITION-APPLIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": disposition_of_property(entity_ref("urn:test:s453:t1#p"), entity_ref("urn:test:s453:t1#y"), 1) { origin case_input; }
        assert "f1": at_least_one_payment_after_close_of_disposition_year(entity_ref("urn:test:s453:t1#p"), entity_ref("urn:test:s453:t1#y"), 1) { origin case_input; }
    }
    evaluate truth(is_installment_sale(entity_ref("urn:test:s453:t1#p"), entity_ref("urn:test:s453:t1#y"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S453-02-DEALER-DISPOSITION-EXCEPTION-NOT-INSTALLMENT-SALE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": disposition_of_property(entity_ref("urn:test:s453:t2#p"), entity_ref("urn:test:s453:t2#y"), 1) { origin case_input; }
        assert "f1": at_least_one_payment_after_close_of_disposition_year(entity_ref("urn:test:s453:t2#p"), entity_ref("urn:test:s453:t2#y"), 1) { origin case_input; }
        assert "f2": is_dealer_disposition(entity_ref("urn:test:s453:t2#p"), entity_ref("urn:test:s453:t2#y"), 1) { origin case_input; }
    }
    evaluate truth(is_installment_sale(entity_ref("urn:test:s453:t2#p"), entity_ref("urn:test:s453:t2#y"), 1));
    expect truth_status == FALSE_ONLY;
}

test "S453-03-GROSS-PROFIT-RATIO-AND-TWO-YEAR-RECOGNITION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Gross profit $40,000 on a total contract price of $100,000: ratio 0.40.
        assert "f0": disposition_of_property(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y1"), 1) { origin case_input; }
        assert "f1": at_least_one_payment_after_close_of_disposition_year(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y1"), 1) { origin case_input; }
        assert "f2": gross_profit_on_disposition(entity_ref("urn:test:s453:t3#p"), 1, 40000 USD) { origin case_input; }
        assert "f3": total_contract_price(entity_ref("urn:test:s453:t3#p"), 1, 100000 USD) { origin case_input; }
        // Year 1: $30,000 received. Year 2: $70,000 received.
        assert "f4": payments_received_in_year(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y1"), 1, 30000 USD) { origin case_input; }
        assert "f5": payments_received_in_year(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y2"), 1, 70000 USD) { origin case_input; }
    }
    // 30000 * 0.40 = 12000; the ratio itself is also checked directly.
    evaluate truth(installment_gross_profit_ratio(entity_ref("urn:test:s453:t3#p"), 1, 0.400000));
    expect truth_status == TRUE_ONLY;
}

test "S453-03B-YEAR-1-RECOGNIZED-GAIN" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": disposition_of_property(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y1"), 1) { origin case_input; }
        assert "f1": at_least_one_payment_after_close_of_disposition_year(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y1"), 1) { origin case_input; }
        assert "f2": gross_profit_on_disposition(entity_ref("urn:test:s453:t3#p"), 1, 40000 USD) { origin case_input; }
        assert "f3": total_contract_price(entity_ref("urn:test:s453:t3#p"), 1, 100000 USD) { origin case_input; }
        assert "f4": payments_received_in_year(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y1"), 1, 30000 USD) { origin case_input; }
    }
    evaluate truth(installment_gain_recognized(entity_ref("urn:test:s453:t3#p"), entity_ref("urn:test:s453:t3#y1"), 1, 12000 USD));
    expect truth_status == TRUE_ONLY;
}

