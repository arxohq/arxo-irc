    evaluate truth(section_453d_election_out_in_effect(entity_ref("urn:test:s453:t4#p"), entity_ref("urn:test:s453:t4#y"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S453-05-ELECTION-OUT-UNTIMELY-INVALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": disposition_of_property(entity_ref("urn:test:s453:t5#p"), entity_ref("urn:test:s453:t5#y"), 1) { origin case_input; }
        assert "f1": at_least_one_payment_after_close_of_disposition_year(entity_ref("urn:test:s453:t5#p"), entity_ref("urn:test:s453:t5#y"), 1) { origin case_input; }
        assert "f2": elects_out_of_installment_method(entity_ref("urn:test:s453:t5#p"), entity_ref("urn:test:s453:t5#y"), 1) { origin case_input; }
        // No timely-filing fact asserted: POWER_INVALID_EXERCISE.
    }
    evaluate truth(section_453d_election_out_in_effect(entity_ref("urn:test:s453:t5#p"), entity_ref("urn:test:s453:t5#y"), 1));
    expect truth_status == FALSE_ONLY;
}

test "S453-06-REVOCATION-REQUIRES-SECRETARY-CONSENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": disposition_of_property(entity_ref("urn:test:s453:t6#p"), entity_ref("urn:test:s453:t6#y"), 1) { origin case_input; }
        assert "f1": at_least_one_payment_after_close_of_disposition_year(entity_ref("urn:test:s453:t6#p"), entity_ref("urn:test:s453:t6#y"), 1) { origin case_input; }
        assert "f2": elects_out_of_installment_method(entity_ref("urn:test:s453:t6#p"), entity_ref("urn:test:s453:t6#y"), 1) { origin case_input; }
        assert "f3": election_out_made_by_return_due_date(entity_ref("urn:test:s453:t6#p"), entity_ref("urn:test:s453:t6#y"), 1) { origin case_input; }
        assert "f4": requests_revocation_of_453d_election(entity_ref("urn:test:s453:t6#p"), entity_ref("urn:test:s453:t6#y"), 1) { origin case_input; }
        // No Secretary consent asserted: revocation does not take effect.
    }
    evaluate truth(section_453d_election_revoked(entity_ref("urn:test:s453:t6#p"), entity_ref("urn:test:s453:t6#y"), 1));
    expect truth_status == FALSE_ONLY;
}
