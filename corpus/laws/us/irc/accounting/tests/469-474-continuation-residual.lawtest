        assert "f7": elects_simplified_dollar_value_lifo_474(entity_ref("urn:test:s469b:t47#p"), entity_ref("urn:test:s469b:t47#y0")) { origin case_input; }
        assert "f8": average_annual_gross_receipts_three_preceding_years_474(entity_ref("urn:test:s469b:t47#p"), entity_ref("urn:test:s469b:t47#y0"), 3000000 USD) { origin case_input; }
        assert "f9": average_annual_gross_receipts_three_preceding_years_474(entity_ref("urn:test:s469b:t47#p"), entity_ref("urn:test:s469b:t47#y2"), 7000000 USD) { origin case_input; }
    }
    evaluate truth(simplified_lifo_applies_in_later_year_474d2B(entity_ref("urn:test:s469b:t47#p"), entity_ref("urn:test:s469b:t47#y2")));
    expect truth_status == NEITHER;
}

test "S469B-48-SECTION-474-CONSENT-TO-REVOCATION-ENDS-THE-CONTINUATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s469b:t48#y0"), @2021-01-01) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s469b:t48#y1"), @2022-01-01) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s469b:t48#y2"), @2023-01-01) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s469b:t48#y3"), @2024-01-01) { origin case_input; }
        assert "f4": us.irc.core::year_of(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y1")) { origin case_input; }
        assert "f5": us.irc.core::year_of(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y2")) { origin case_input; }
        assert "f6": us.irc.core::year_of(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y3")) { origin case_input; }
        assert "f7": elects_simplified_dollar_value_lifo_474(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y0")) { origin case_input; }
        assert "f8": average_annual_gross_receipts_three_preceding_years_474(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y0"), 3000000 USD) { origin case_input; }
        assert "f9": average_annual_gross_receipts_three_preceding_years_474(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y1"), 3000000 USD) { origin case_input; }
        assert "f10": average_annual_gross_receipts_three_preceding_years_474(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y2"), 3000000 USD) { origin case_input; }
        assert "f11": secretary_consents_to_revocation_474(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y1")) { origin case_input; }
    }
    evaluate truth(simplified_lifo_applies_in_later_year_474d2B(entity_ref("urn:test:s469b:t48#p"), entity_ref("urn:test:s469b:t48#y2")));
    expect truth_status == NEITHER;
}
