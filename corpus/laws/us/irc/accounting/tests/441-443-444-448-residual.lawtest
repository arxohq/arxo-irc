test "S45-01-YEAR-BEGINNING-CLOSER-TO-EARLIER-MONTH-START" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fifty_two_fifty_three_week_year_first_day_441f2A(entity_ref("urn:test:s45:t1#y"), @2024-01-03, @2024-01-01) { origin case_input; }
    }
    evaluate truth(year_treated_as_beginning_on_441f2Ai(entity_ref("urn:test:s45:t1#y"), @2024-01-01));
    expect truth_status == TRUE_ONLY;
}

