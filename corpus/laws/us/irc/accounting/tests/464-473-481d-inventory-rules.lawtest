        assert "f0": opening_inventory_of_goods(entity_ref("urn:test:s464:t22#p"), entity_ref("urn:test:s464:t22#y"), 500000 USD) { origin case_input; }
        assert "f1": closing_inventory_of_goods(entity_ref("urn:test:s464:t22#p"), entity_ref("urn:test:s464:t22#y"), 300000 USD) { origin case_input; }
        assert "f2": elects_section_473(entity_ref("urn:test:s464:t22#p"), entity_ref("urn:test:s464:t22#y")) { origin case_input; }
    }
    // POWER_INVALID_EXERCISE.
