// Sections 464, 473, 481(d), 472(d), 471(b),(c), 443(d) scenarios (stage 2c). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S464-01-CULTIVATION-OF-LAND-IS-FARMING" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": activity_is_cultivation_raising_or_harvesting_464e(1) { origin case_input; }
    }
    evaluate truth(is_farming_464e(1));
    expect truth_status == TRUE_ONLY;
}

test "S464-02-NON-FRUIT-TREES-ARE-NOT-FARMING" {
