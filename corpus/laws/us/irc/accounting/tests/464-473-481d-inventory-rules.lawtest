}

test "S464-43-ENTITY-IN-EXISTENCE-ALL-THREE-YEARS-NOT-COVERED-BY-448C3A" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gross_receipts_total_for_period_in_existence(entity_ref("urn:test:s464:t43#p"), entity_ref("urn:test:s464:t43#y"), 3000000 USD, 3) { origin case_input; }
    }
    // The (c)(3)(A) adjustment applies only when the entity existed for less than the whole 3-year period.
    evaluate truth(average_gross_receipts_for_period_in_existence_448c3A(entity_ref("urn:test:s464:t43#p"), entity_ref("urn:test:s464:t43#y"), 1000000 USD));
    expect truth_status == NEITHER;
}

