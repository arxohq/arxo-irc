    }
    evaluate truth(is_farming_464e(1));
    expect truth_status == NEITHER;
}

test "S464-03-EXCESS-PREPAID-SUPPLIES-OVER-HALF-OF-OTHER-EXPENSES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": prepaid_farm_supplies_464(entity_ref("urn:test:s464:t3#p"), entity_ref("urn:test:s464:t3#y"), 80000 USD) { origin case_input; }
        assert "f1": deductible_farming_expenses_other_than_prepaid_464(entity_ref("urn:test:s464:t3#p"), entity_ref("urn:test:s464:t3#y"), 100000 USD) { origin case_input; }
    }
    // 80,000 - 50% x 100,000.
    evaluate truth(excess_prepaid_farm_supplies(entity_ref("urn:test:s464:t3#p"), entity_ref("urn:test:s464:t3#y"), 30000 USD));
    expect truth_status == TRUE_ONLY;
}

