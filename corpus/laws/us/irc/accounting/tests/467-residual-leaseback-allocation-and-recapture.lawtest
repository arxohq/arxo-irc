test "S467-01-LESSEE-WITH-RECENT-INTEREST-MAKES-A-LEASEBACK" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": lessee_of_leaseback_467e2(1, entity_ref("urn:test:s467:t1#q"), @2024-06-01) { origin case_input; }
        assert "f1": person_had_interest_in_property_on_467e2(1, entity_ref("urn:test:s467:t1#q"), @2023-01-01) { origin case_input; }
    }
    evaluate truth(leaseback_transaction_467e2(1));
    expect truth_status == TRUE_ONLY;
}

