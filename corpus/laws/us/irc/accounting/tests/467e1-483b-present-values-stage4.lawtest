// Section 467(e)(1) constant rental amount (module 53) and section 483(b) present values (module 54). NOT EXECUTED.
// Expected values computed offline (semiannual factor with a stub; cents HALF_UP).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S467E1-01-CONSTANT-RENTAL-AMOUNT-FROM-PRESENT-VALUE" {
    // AFR 10% x 1.10 = 11%; one payment of 1000 at the close of two annual lease periods: A = PV x G(g-1)/(G-1).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_federal_rate_at_agreement_467e4(1, 0.10) { origin case_input; }
        assert "f1": lease_first_period_start_467e1(1, @2020-01-01) { origin case_input; }
        assert "f2": lease_period_in_half_years_467e1(1, 2) { origin case_input; }
        assert "f3": lease_period_count_467e1(1, 2) { origin case_input; }
        assert "f4": payment_required_slot_467e1(1, 1, @2022-01-01, 1000 USD) { origin case_input; }
    }
    evaluate truth(constant_rental_amount_derived_467e1(1, 473.26 USD));
    expect truth_status == TRUE_ONLY;
}

test "S467E1-02-RATE-IS-110-PERCENT-OF-AFR" {
    // Section 467(e)(4), the existing rule feeds the derivation.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_federal_rate_at_agreement_467e4(1, 0.10) { origin case_input; }
        assert "f1": lease_first_period_start_467e1(1, @2020-01-01) { origin case_input; }
        assert "f2": lease_period_in_half_years_467e1(1, 2) { origin case_input; }
        assert "f3": lease_period_count_467e1(1, 2) { origin case_input; }
    }
    evaluate truth(rate_for_section_467_467e4(1, 0.110));
    expect truth_status == TRUE_ONLY;
}

test "S467E1-03-TWO-PAYMENTS-SUMMED-BY-SLOTS" {
    // Present values of the two payments summed over ordinal slots 1 and 2.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_federal_rate_at_agreement_467e4(1, 0.10) { origin case_input; }
        assert "f1": lease_first_period_start_467e1(1, @2020-01-01) { origin case_input; }
        assert "f2": lease_period_in_half_years_467e1(1, 2) { origin case_input; }
        assert "f3": lease_period_count_467e1(1, 2) { origin case_input; }
        assert "f4": payment_required_slot_467e1(1, 1, @2021-01-01, 400 USD) { origin case_input; }
        assert "f5": payment_required_slot_467e1(1, 2, @2022-01-01, 700 USD) { origin case_input; }
    }
    evaluate truth(constant_rental_amount_derived_467e1(1, 541.97 USD));
    expect truth_status == TRUE_ONLY;
}

test "S467E1-04-LEASE-PERIOD-NOT-IN-WHOLE-HALF-YEARS-NOT-DERIVED" {
    // Without a lease period in whole six-month periods (bounded derivation) there is no amount.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_federal_rate_at_agreement_467e4(1, 0.10) { origin case_input; }
        assert "f1": lease_first_period_start_467e1(1, @2020-01-01) { origin case_input; }
        assert "f2": lease_period_count_467e1(1, 2) { origin case_input; }
        assert "f3": payment_required_slot_467e1(1, 1, @2022-01-01, 1000 USD) { origin case_input; }
    }
    evaluate truth(constant_rental_amount_derived_467e1(1, 473.26 USD));
    expect truth_status == NEITHER;
}

test "S483-01-PRESENT-VALUE-OF-PAYMENTS-AND-INTEREST-PAYMENTS" {
    // AFR 10% compounded semiannually from the sale: 10000 at 2 years and at 3 years, stated interest 500 at 1 year.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": deferred_payment_sale_or_exchange_483(entity_ref("urn:test:s483:t1#s"), entity_ref("urn:test:s483:t1#b"), 1, entity_ref("urn:test:s483:t1#y")) { origin case_input; }
        assert "f1": sale_date_483(1, @2020-01-01) { origin case_input; }
        assert "f2": applicable_federal_rate_483(1, 0.10) { origin case_input; }
        assert "f3": contract_payment_slot_483(1, 1, @2022-01-01, 10000 USD) { origin case_input; }
        assert "f4": contract_payment_slot_483(1, 2, @2023-01-01, 10000 USD) { origin case_input; }
        assert "f5": contract_interest_payment_slot_483(1, 1, @2021-01-01, 500 USD) { origin case_input; }
    }
    evaluate truth(present_value_of_payments_derived_483(entity_ref("urn:test:s483:t1#s"), entity_ref("urn:test:s483:t1#b"), 1, 16142.68 USD));
    expect truth_status == TRUE_ONLY;
}

test "S483-02-TOTAL-UNSTATED-INTEREST-FROM-THE-SLOTS" {
    // Section 483(b): the payments (20000) minus the sum of the present values.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": deferred_payment_sale_or_exchange_483(entity_ref("urn:test:s483:t2#s"), entity_ref("urn:test:s483:t2#b"), 1, entity_ref("urn:test:s483:t2#y")) { origin case_input; }
        assert "f1": sale_date_483(1, @2020-01-01) { origin case_input; }
        assert "f2": applicable_federal_rate_483(1, 0.10) { origin case_input; }
        assert "f3": contract_payment_slot_483(1, 1, @2022-01-01, 10000 USD) { origin case_input; }
        assert "f4": contract_payment_slot_483(1, 2, @2023-01-01, 10000 USD) { origin case_input; }
        assert "f5": contract_interest_payment_slot_483(1, 1, @2021-01-01, 500 USD) { origin case_input; }
    }
    evaluate truth(total_unstated_interest_483(entity_ref("urn:test:s483:t2#s"), entity_ref("urn:test:s483:t2#b"), 1, 3857.32 USD));
    expect truth_status == TRUE_ONLY;
}

test "S483-03-PAYMENT-DUE-WITHIN-SIX-MONTHS-NOT-COUNTED" {
    // The payment due 4 months after the sale is outside section 483 (section 483(c)(1)).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": deferred_payment_sale_or_exchange_483(entity_ref("urn:test:s483:t3#s"), entity_ref("urn:test:s483:t3#b"), 1, entity_ref("urn:test:s483:t3#y")) { origin case_input; }
        assert "f1": sale_date_483(1, @2020-01-01) { origin case_input; }
        assert "f2": applicable_federal_rate_483(1, 0.10) { origin case_input; }
        assert "f3": contract_payment_slot_483(1, 1, @2022-01-01, 10000 USD) { origin case_input; }
        assert "f4": contract_payment_slot_483(1, 2, @2020-05-01, 3000 USD) { origin case_input; }
    }
    evaluate truth(payments_due_derived_483(entity_ref("urn:test:s483:t3#s"), entity_ref("urn:test:s483:t3#b"), 1, 10000 USD));
    expect truth_status == TRUE_ONLY;
}
