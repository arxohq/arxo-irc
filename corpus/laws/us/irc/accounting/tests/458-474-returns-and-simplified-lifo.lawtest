test "S458-15-SUSPENSE-ACCOUNT-INITIAL-BALANCE-IS-LARGEST-OF-THREE-YEARS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": preceding_taxable_year_465(entity_ref("urn:test:s458:t15#y1"), entity_ref("urn:test:s458:t15#y")) { origin case_input; }
        assert "f1": preceding_taxable_year_465(entity_ref("urn:test:s458:t15#y2"), entity_ref("urn:test:s458:t15#y1")) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s458:t15#y3"), entity_ref("urn:test:s458:t15#y2")) { origin case_input; }
        assert "f3": returned_merchandise_that_would_have_been_taken_into_account(entity_ref("urn:test:s458:t15#p"), entity_ref("urn:test:s458:t15#y1"), 50000 USD) { origin case_input; }
        assert "f4": returned_merchandise_that_would_have_been_taken_into_account(entity_ref("urn:test:s458:t15#p"), entity_ref("urn:test:s458:t15#y2"), 80000 USD) { origin case_input; }
        assert "f5": returned_merchandise_that_would_have_been_taken_into_account(entity_ref("urn:test:s458:t15#p"), entity_ref("urn:test:s458:t15#y3"), 60000 USD) { origin case_input; }
    }
    evaluate truth(suspense_account_initial_opening_balance(entity_ref("urn:test:s458:t15#p"), entity_ref("urn:test:s458:t15#y"), 80000 USD));
    expect truth_status == TRUE_ONLY;
}

