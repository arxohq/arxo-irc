test "S458-08-MAGAZINE-RETURN-PERIOD-ENDS-2-MONTHS-15-DAYS-AFTER-YEAR-END" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s458:t8#p"), entity_ref("urn:test:s458:t8#y")) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:s458:t8#y"), @2024-12-31) { origin case_input; }
    }
    // 2024-12-31 + 2 calendar months (month-end clamp to 2025-02-28) + 15 days: the counting convention is the IRC_CALENDAR_STEP policy (JUDGMENT CALL on the month-end clamp).
    evaluate truth(merchandise_return_period_ends_458b7(entity_ref("urn:test:s458:t8#p"), entity_ref("urn:test:s458:t8#y"), Magazine, @2025-03-15));
    expect truth_status == TRUE_ONLY;
}

