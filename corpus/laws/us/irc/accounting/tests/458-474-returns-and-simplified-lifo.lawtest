        }
        assert "f0": applicable_accounting_method(entity_ref("urn:test:s458:t5#p"), entity_ref("urn:test:s458:t5#y"), Accrual) { origin case_input; }
        assert "f1": elects_returns_exclusion_458(entity_ref("urn:test:s458:t5#p"), entity_ref("urn:test:s458:t5#y"), Magazine) { origin case_input; }
        assert "f2": sale_category_458(1, Magazine) { origin case_input; }
        assert "f3": legal_obligation_to_adjust_price_amount(entity_ref("urn:test:s458:t5#p"), 1, 10000 USD) { origin case_input; }
        assert "f4": price_adjusted_because_not_resold(entity_ref("urn:test:s458:t5#p"), 1, 7000 USD) { origin case_input; }
    }
    evaluate truth(amount_excluded_458b6(entity_ref("urn:test:s458:t5#p"), entity_ref("urn:test:s458:t5#y"), 1, 7000 USD));
    expect truth_status == TRUE_ONLY;
}

