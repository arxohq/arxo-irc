// Sections 458 and 474 scenarios (stage 2c). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S458-01-ACCRUAL-TAXPAYER-MAGAZINE-ELECTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_accounting_method(entity_ref("urn:test:s458:t1#p"), entity_ref("urn:test:s458:t1#y"), Accrual) { origin case_input; }
        assert "f1": elects_returns_exclusion_458(entity_ref("urn:test:s458:t1#p"), entity_ref("urn:test:s458:t1#y"), Magazine) { origin case_input; }
    }
    evaluate truth(returns_exclusion_election_in_effect_458(entity_ref("urn:test:s458:t1#p"), entity_ref("urn:test:s458:t1#y"), Magazine));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S458-02-CASH-METHOD-TAXPAYER-ELECTION-INVALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_accounting_method(entity_ref("urn:test:s458:t2#p"), entity_ref("urn:test:s458:t2#y"), CashReceiptsAndDisbursements) { origin case_input; }
        assert "f1": elects_returns_exclusion_458(entity_ref("urn:test:s458:t2#p"), entity_ref("urn:test:s458:t2#y"), Paperback) { origin case_input; }
    }
    // POWER_INVALID_EXERCISE: only an accrual-method taxpayer may elect.
    evaluate truth(returns_exclusion_election_in_effect_458(entity_ref("urn:test:s458:t2#p"), entity_ref("urn:test:s458:t2#y"), Paperback));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

