// Section 441 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S441-01-NO-BOOKS-CALENDAR-YEAR-DEFAULT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": keeps_no_books(entity_ref("urn:test:s441:t1#p"), entity_ref("urn:test:s441:t1#y")) { origin case_input; }
    }
    evaluate truth(calendar_year_required_by_441g(entity_ref("urn:test:s441:t1#p"), entity_ref("urn:test:s441:t1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S441-02-NO-BOOKS-BUT-SECTION-443-SHORT-PERIOD-BLOCKS-DEFAULT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": keeps_no_books(entity_ref("urn:test:s441:t2#p"), entity_ref("urn:test:s441:t2#y")) { origin case_input; }
        assert "f1": short_period_return_required(entity_ref("urn:test:s441:t2#p"), entity_ref("urn:test:s441:t2#y")) { origin case_input; }
    }
    // §441(g)'s calendar-year default is "except as provided in section 443".
    evaluate truth(calendar_year_required_by_441g(entity_ref("urn:test:s441:t2#p"), entity_ref("urn:test:s441:t2#y")));
    expect truth_status == FALSE_ONLY;
}

test "S441-03-FIFTY-TWO-FIFTY-THREE-WEEK-ELECTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": annual_period_varies_52_to_53_weeks_same_weekday_end(entity_ref("urn:test:s441:t3#p"), entity_ref("urn:test:s441:t3#y")) { origin case_input; }
        assert "f1": elects_52_53_week_year(entity_ref("urn:test:s441:t3#p"), entity_ref("urn:test:s441:t3#y")) { origin case_input; }
    }
    evaluate truth(year_computed_on_52_53_week_basis(entity_ref("urn:test:s441:t3#p"), entity_ref("urn:test:s441:t3#y")));
    expect truth_status == TRUE_ONLY;
}

test "S441-04-FIFTY-TWO-FIFTY-THREE-WEEK-ELECTION-INVALID-NOT-QUALIFYING" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // The taxpayer attempts the election without a qualifying 52-53-week
        // practice: POWER_INVALID_EXERCISE, no effect (E-0239).
        assert "f0": elects_52_53_week_year(entity_ref("urn:test:s441:t4#p"), entity_ref("urn:test:s441:t4#y")) { origin case_input; }
    }
    evaluate truth(year_computed_on_52_53_week_basis(entity_ref("urn:test:s441:t4#p"), entity_ref("urn:test:s441:t4#y")));
    expect truth_status == FALSE_ONLY;
}

test "S441-05-PSC-BUSINESS-PURPOSE-NOT-ADJUDICATED-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_personal_service_corporation(entity_ref("urn:test:s441:t5#corp"), entity_ref("urn:test:s441:t5#y")) { origin case_input; }
    }
    // No answer yet on the business-purpose judgment channel — DECISION-0194:
    // absence of the judgment is NEITHER/REQUIRES_JUDGMENT, not a denial.
    evaluate truth(required_taxable_year_is_calendar_year_441i(entity_ref("urn:test:s441:t5#corp"), entity_ref("urn:test:s441:t5#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}

test "S441-06-PSC-BUSINESS-PURPOSE-ESTABLISHED-NO-CALENDAR-REQUIREMENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_personal_service_corporation(entity_ref("urn:test:s441:t6#corp"), entity_ref("urn:test:s441:t6#y")) { origin case_input; }
        assert "f1": business_purpose_established_for_different_year_441i(entity_ref("urn:test:s441:t6#corp"), entity_ref("urn:test:s441:t6#y")) { origin adjudicated; }
    }
    evaluate truth(required_taxable_year_is_calendar_year_441i(entity_ref("urn:test:s441:t6#corp"), entity_ref("urn:test:s441:t6#y")));
    expect truth_status == FALSE_ONLY;
}
