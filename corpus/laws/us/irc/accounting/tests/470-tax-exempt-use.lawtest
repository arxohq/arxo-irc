        assert "f5": us.irc.core::year_of(entity_ref("urn:test:s470:t23#p"), entity_ref("urn:test:s470:t23#y")) { origin case_input; }
    }
    // No (d) paragraph is established for the lease.
    evaluate truth(section_470_applies_to_property(entity_ref("urn:test:s470:t23#p"), entity_ref("urn:test:s470:t23#y"), entity_ref("urn:test:s470:t23#a")));
    expect truth_status == TRUE_ONLY;
}

