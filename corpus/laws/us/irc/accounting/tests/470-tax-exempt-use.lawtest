test "S470-03-LOSS-IS-DEDUCTIONS-INCLUDING-INTEREST-OVER-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_tax_exempt_use_property_470(entity_ref("urn:test:s470:t3#a")) { origin case_input; }
        assert "f1": deductions_other_than_interest_allocable_470(entity_ref("urn:test:s470:t3#p"), entity_ref("urn:test:s470:t3#y"), entity_ref("urn:test:s470:t3#a"), 60000 USD) { origin case_input; }
        assert "f2": interest_deductions_allocable_470(entity_ref("urn:test:s470:t3#p"), entity_ref("urn:test:s470:t3#y"), entity_ref("urn:test:s470:t3#a"), 30000 USD) { origin case_input; }
        assert "f3": income_from_tax_exempt_use_property_470(entity_ref("urn:test:s470:t3#p"), entity_ref("urn:test:s470:t3#y"), entity_ref("urn:test:s470:t3#a"), 50000 USD) { origin case_input; }
    }
    // 60,000 + 30,000 - 50,000.
    evaluate truth(tax_exempt_use_loss(entity_ref("urn:test:s470:t3#p"), entity_ref("urn:test:s470:t3#y"), entity_ref("urn:test:s470:t3#a"), 40000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S470-04-INCOME-EQUAL-TO-DEDUCTIONS-NO-LOSS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_tax_exempt_use_property_470(entity_ref("urn:test:s470:t4#a")) { origin case_input; }
        assert "f1": deductions_other_than_interest_allocable_470(entity_ref("urn:test:s470:t4#p"), entity_ref("urn:test:s470:t4#y"), entity_ref("urn:test:s470:t4#a"), 60000 USD) { origin case_input; }
        assert "f2": interest_deductions_allocable_470(entity_ref("urn:test:s470:t4#p"), entity_ref("urn:test:s470:t4#y"), entity_ref("urn:test:s470:t4#a"), 30000 USD) { origin case_input; }
        assert "f3": income_from_tax_exempt_use_property_470(entity_ref("urn:test:s470:t4#p"), entity_ref("urn:test:s470:t4#y"), entity_ref("urn:test:s470:t4#a"), 90000 USD) { origin case_input; }
    }
    // At income equal to deductions there is no tax-exempt use loss.
    evaluate truth(tax_exempt_use_loss(entity_ref("urn:test:s470:t4#p"), entity_ref("urn:test:s470:t4#y"), entity_ref("urn:test:s470:t4#a"), 0 USD));
    expect truth_status == NEITHER;
}

