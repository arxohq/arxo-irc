// Section 470 scenarios (stage 2c). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S470-01-TAX-EXEMPT-USE-PROPERTY-AFTER-PARTNERSHIP-EXCEPTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_tax_exempt_use_property_470(entity_ref("urn:test:s470:t1#a")) { origin case_input; }
    }
    evaluate truth(is_tax_exempt_use_property_for_470(entity_ref("urn:test:s470:t1#a")));
    expect truth_status == TRUE_ONLY;
}

