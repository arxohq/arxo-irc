        assert "f9": preceding_taxable_year_465(entity_ref("urn:test:s470:t29#y"), entity_ref("urn:test:s470:t29#y2")) { origin case_input; }
        assert "f10": disposes_entire_interest_in_tax_exempt_use_property(entity_ref("urn:test:s470:t29#p"), entity_ref("urn:test:s470:t29#y2"), entity_ref("urn:test:s470:t29#a")) { origin case_input; }
