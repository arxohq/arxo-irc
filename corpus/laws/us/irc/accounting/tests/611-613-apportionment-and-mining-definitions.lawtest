        assert "f2": lease_bonus_advance_royalty_or_amount_payable_without_regard_to_production_613Ad5(entity_ref("urn:test:s611b:t48#p"), entity_ref("urn:test:s611b:t48#a"), entity_ref("urn:test:s611b:t48#y"), 80000 USD) { origin case_input; }
    }
    evaluate truth(geothermal_gross_income_excluding_613Ad5_613e3(entity_ref("urn:test:s611b:t48#p"), entity_ref("urn:test:s611b:t48#a"), entity_ref("urn:test:s611b:t48#y"), 420000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S611B-49-NON-GEOTHERMAL-PROPERTY-NOT-UNDER-613E3" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gross_income_from_the_property(entity_ref("urn:test:s611b:t49#p"), entity_ref("urn:test:s611b:t49#a"), entity_ref("urn:test:s611b:t49#y"), 500000 USD) { origin case_input; }
        assert "f1": lease_bonus_advance_royalty_or_amount_payable_without_regard_to_production_613Ad5(entity_ref("urn:test:s611b:t49#p"), entity_ref("urn:test:s611b:t49#a"), entity_ref("urn:test:s611b:t49#y"), 80000 USD) { origin case_input; }
    }
    evaluate truth(geothermal_gross_income_excluding_613Ad5_613e3(entity_ref("urn:test:s611b:t49#p"), entity_ref("urn:test:s611b:t49#a"), entity_ref("urn:test:s611b:t49#y"), 420000 USD));
    expect truth_status == NEITHER;
}
