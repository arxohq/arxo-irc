// Sections 611(b), 612, 613(c), 613(e)(3) scenarios (stage 3). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S611B-01-LESSOR-TAKES-ITS-EQUITABLE-SHARE-OF-THE-DEPLETION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": property_is_leased_611b1(entity_ref("urn:test:s611b:t1#a"), entity_ref("urn:test:s611b:t1#l1"), entity_ref("urn:test:s611b:t1#l2")) { origin case_input; }
        assert "f1": depletion_deduction_of_property_611(entity_ref("urn:test:s611b:t1#a"), entity_ref("urn:test:s611b:t1#y"), 10000 USD) { origin case_input; }
        assert "f2": equitable_share_of_lessor_611b1(entity_ref("urn:test:s611b:t1#a"), 0.25)  { origin adjudicated; }
    }
    evaluate truth(lessor_share_of_depletion_611b1(entity_ref("urn:test:s611b:t1#a"), entity_ref("urn:test:s611b:t1#y"), entity_ref("urn:test:s611b:t1#l1"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
}

