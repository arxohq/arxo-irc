// Section 460 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S460-01-PERCENTAGE-OF-COMPLETION-COMPUTATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_long_term_contract(entity_ref("urn:test:s460:t1#p"), 1, entity_ref("urn:test:s460:t1#y")) { origin case_input; }
        assert "f3": costs_allocated_and_incurred_to_date(entity_ref("urn:test:s460:t1#p"), 1, entity_ref("urn:test:s460:t1#y"), 300000.00 USD) { origin case_input; }
        assert "f4": estimated_total_contract_costs(entity_ref("urn:test:s460:t1#p"), 1, entity_ref("urn:test:s460:t1#y"), 1000000.00 USD) { origin case_input; }
        assert "f5": long_term_contract_price(entity_ref("urn:test:s460:t1#p"), 1, 1500000.00 USD) { origin case_input; }
    }
    // percentage of completion = 300,000 / 1,000,000 = 0.30; cumulative income = 1,500,000 * 0.30 = 450,000.
    evaluate truth(percentage_of_completion_income(entity_ref("urn:test:s460:t1#p"), 1, entity_ref("urn:test:s460:t1#y"), 450000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S460-02-HOME-CONSTRUCTION-CONTRACT-EXEMPT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_long_term_contract(entity_ref("urn:test:s460:t2#p"), 1, entity_ref("urn:test:s460:t2#y")) { origin case_input; }
        assert "f1": is_home_construction_contract(entity_ref("urn:test:s460:t2#p"), 1) { origin case_input; }
    }
    evaluate truth(percentage_completion_required(entity_ref("urn:test:s460:t2#p"), 1, entity_ref("urn:test:s460:t2#y")));
    expect truth_status == FALSE_ONLY;
}

test "S460-03-SMALL-CONTRACTOR-TWO-YEAR-EXEMPTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_construction_contract(entity_ref("urn:test:s460:t3#p"), 1) { origin case_input; }
        assert "f1": estimated_completion_within_two_years_of_commencement(entity_ref("urn:test:s460:t3#p"), 1) { origin case_input; }
        assert "f2": meets_gross_receipts_test_448c(entity_ref("urn:test:s460:t3#p"), entity_ref("urn:test:s460:t3#y")) { origin case_input; }
    }
    evaluate truth(small_construction_contract_exemption_460e1b(entity_ref("urn:test:s460:t3#p"), 1, entity_ref("urn:test:s460:t3#y")));
    expect truth_status == TRUE_ONLY;
}
