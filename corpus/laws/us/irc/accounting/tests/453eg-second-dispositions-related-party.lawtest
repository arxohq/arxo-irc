            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_depreciable_property_453(1) { origin case_input; }
        assert "f1": is_related_person_453g(entity_ref("urn:test:s453g:t1#seller"), entity_ref("urn:test:s453g:t1#buyer")) { origin case_input; }
    }
    evaluate truth(installment_method_denied_453g(entity_ref("urn:test:s453g:t1#seller"), entity_ref("urn:test:s453g:t1#buyer"), 1));
