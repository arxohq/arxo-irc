// Section 453(e),(g),(i),(l) scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S453E-01-SECOND-DISPOSITION-WITHIN-TWO-YEARS-TREATED-AS-RECEIVED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": first_disposition_453e(entity_ref("urn:test:s453e:t1#seller"), entity_ref("urn:test:s453e:t1#related"), 1, @2023-01-10) { origin case_input; }
        assert "f1": second_disposition_453e(entity_ref("urn:test:s453e:t1#related"), 1, 2, @2024-06-10) { origin case_input; }
        assert "f3": second_disposition_amount_realized(entity_ref("urn:test:s453e:t1#related"), 1, 2, 80000.00 USD) { origin case_input; }
        assert "f4": second_disposition_year(1, 2, entity_ref("urn:test:s453e:t1#y2")) { origin case_input; }
    }
    evaluate truth(amount_treated_as_received_by_first_seller_453e(entity_ref("urn:test:s453e:t1#seller"), entity_ref("urn:test:s453e:t1#related"), 1, 2, entity_ref("urn:test:s453e:t1#y2"), 80000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453E-02-SECOND-DISPOSITION-AFTER-TWO-YEARS-NOT-TREATED-AS-RECEIVED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": first_disposition_453e(entity_ref("urn:test:s453e:t2#seller"), entity_ref("urn:test:s453e:t2#related"), 1, @2020-01-10) { origin case_input; }
        assert "f1": second_disposition_453e(entity_ref("urn:test:s453e:t2#related"), 1, 2, @2024-06-10) { origin case_input; }
    }
    evaluate truth(second_disposition_within_two_years(entity_ref("urn:test:s453e:t2#seller"), entity_ref("urn:test:s453e:t2#related"), 1, 2, @2020-01-10, @2024-06-10));
    expect truth_status == NEITHER;
}

test "S453E-03-TAX-AVOIDANCE-NOT-A-PRINCIPAL-PURPOSE-BLOCKS-453E" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": first_disposition_453e(entity_ref("urn:test:s453e:t3#seller"), entity_ref("urn:test:s453e:t3#related"), 1, @2023-01-10) { origin case_input; }
        assert "f1": second_disposition_453e(entity_ref("urn:test:s453e:t3#related"), 1, 2, @2024-06-10) { origin case_input; }
        assert "f3": second_disposition_amount_realized(entity_ref("urn:test:s453e:t3#related"), 1, 2, 80000.00 USD) { origin case_input; }
        assert "f4": second_disposition_year(1, 2, entity_ref("urn:test:s453e:t3#y2")) { origin case_input; }
        assert "f5": tax_avoidance_not_a_principal_purpose_453e7(entity_ref("urn:test:s453e:t3#seller"), entity_ref("urn:test:s453e:t3#related"), 1) { origin adjudicated; }
    }
    evaluate truth(amount_treated_as_received_by_first_seller_453e(entity_ref("urn:test:s453e:t3#seller"), entity_ref("urn:test:s453e:t3#related"), 1, 2, entity_ref("urn:test:s453e:t3#y2"), 80000.00 USD));
    expect truth_status == FALSE_ONLY;
}

