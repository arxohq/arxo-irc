}

test "S453I-01-RECAPTURE-INCOME-RECOGNIZED-IN-DISPOSITION-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": disposition_of_property(entity_ref("urn:test:s453i:t1#p"), entity_ref("urn:test:s453i:t1#y"), 1) { origin case_input; }
        assert "f1": recapture_income_1245_1250(entity_ref("urn:test:s453i:t1#p"), 1, 15000.00 USD) { origin case_input; }
    }
    evaluate truth(recapture_income_recognized_in_disposition_year(entity_ref("urn:test:s453i:t1#p"), entity_ref("urn:test:s453i:t1#y"), 1, 15000.00 USD));
    expect truth_status == TRUE_ONLY;
}

