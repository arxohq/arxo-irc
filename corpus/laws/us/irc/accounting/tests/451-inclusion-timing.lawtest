// Section 451 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S451-01-INCLUDED-IN-YEAR-RECEIVED-BY-DEFAULT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": item_received_in_year(entity_ref("urn:test:s451:t1#p"), entity_ref("urn:test:s451:t1#y"), 1, 5000 USD) { origin case_input; }
    }
    evaluate truth(gross_income_item_included_in_year(entity_ref("urn:test:s451:t1#p"), entity_ref("urn:test:s451:t1#y"), 1, 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S451-02-DIFFERENT-PERIOD-UNDER-METHOD-NOT-INCLUDED-IN-RECEIPT-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": item_received_in_year(entity_ref("urn:test:s451:t2#p"), entity_ref("urn:test:s451:t2#y"), 1, 5000 USD) { origin case_input; }
        assert "f1": properly_accounted_for_different_period_under_method(entity_ref("urn:test:s451:t2#p"), entity_ref("urn:test:s451:t2#ydiff"), 1) { origin case_input; }
    }
    evaluate truth(gross_income_item_included_in_year(entity_ref("urn:test:s451:t2#p"), entity_ref("urn:test:s451:t2#y"), 1, 5000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S451-03-ALL-EVENTS-TEST-REASONABLE-ACCURACY-NOT-ADJUDICATED-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": all_events_occurred_fixing_right_to_income(entity_ref("urn:test:s451:t3#p"), entity_ref("urn:test:s451:t3#y"), 1) { origin case_input; }
    }
    evaluate truth(all_events_test_met_451b(entity_ref("urn:test:s451:t3#p"), entity_ref("urn:test:s451:t3#y"), 1));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}

test "S451-04-AFS-REVENUE-RECOGNITION-ACCELERATES-INCLUSION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applicable_accounting_method(entity_ref("urn:test:s451:t4#p"), entity_ref("urn:test:s451:t4#y"), Accrual) { origin case_input; }
        assert "f1": has_applicable_financial_statement(entity_ref("urn:test:s451:t4#p"), entity_ref("urn:test:s451:t4#y")) { origin case_input; }
        assert "f2": item_taken_into_account_as_afs_revenue(entity_ref("urn:test:s451:t4#p"), entity_ref("urn:test:s451:t4#y"), 1) { origin case_input; }
        assert "f3": item_received_in_year(entity_ref("urn:test:s451:t4#p"), entity_ref("urn:test:s451:t4#y"), 1, 8000 USD) { origin case_input; }
    }
    evaluate truth(gross_income_item_included_in_year(entity_ref("urn:test:s451:t4#p"), entity_ref("urn:test:s451:t4#y"), 1, 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S451-05-MORTGAGE-SERVICING-CONTRACT-EXCEPTION-BLOCKS-AFS-ACCELERATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applicable_accounting_method(entity_ref("urn:test:s451:t5#p"), entity_ref("urn:test:s451:t5#y"), Accrual) { origin case_input; }
        assert "f1": has_applicable_financial_statement(entity_ref("urn:test:s451:t5#p"), entity_ref("urn:test:s451:t5#y")) { origin case_input; }
        assert "f2": item_taken_into_account_as_afs_revenue(entity_ref("urn:test:s451:t5#p"), entity_ref("urn:test:s451:t5#y"), 1) { origin case_input; }
        assert "f3": item_is_mortgage_servicing_contract_income(entity_ref("urn:test:s451:t5#p"), 1) { origin case_input; }
    }
    evaluate truth(all_events_test_treated_as_met_no_later_than_afs(entity_ref("urn:test:s451:t5#p"), entity_ref("urn:test:s451:t5#y"), 1));
    expect truth_status == FALSE_ONLY;
}

test "S451-06-ADVANCE-PAYMENT-DEFERRAL-ELECTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_advance_payment_deferral(entity_ref("urn:test:s451:t6#p"), entity_ref("urn:test:s451:t6#y"), 1) { origin case_input; }
        assert "f1": deferral_election_timely_and_properly_made(entity_ref("urn:test:s451:t6#p"), entity_ref("urn:test:s451:t6#y"), 1) { origin case_input; }
    }
    evaluate truth(advance_payment_deferral_in_effect(entity_ref("urn:test:s451:t6#p"), entity_ref("urn:test:s451:t6#y"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S451-07-ADVANCE-PAYMENT-DEFERRED-PORTION-COMPUTED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": receives_advance_payment(entity_ref("urn:test:s451:t7#p"), entity_ref("urn:test:s451:t7#y"), 1, 10000 USD) { origin case_input; }
        assert "f1": advance_payment_category_of(1, 1) { origin case_input; }
        assert "f2": advance_payment_deferral_in_effect(entity_ref("urn:test:s451:t7#p"), entity_ref("urn:test:s451:t7#y"), 1) { origin case_input; }
        assert "f3": advance_payment_portion_required_by_451b_in_receipt_year(entity_ref("urn:test:s451:t7#p"), entity_ref("urn:test:s451:t7#y"), 1, 4000 USD) { origin case_input; }
    }
    evaluate truth(advance_payment_deferred_portion(entity_ref("urn:test:s451:t7#p"), entity_ref("urn:test:s451:t7#y"), 1, 6000 USD));
    expect truth_status == TRUE_ONLY;
}
