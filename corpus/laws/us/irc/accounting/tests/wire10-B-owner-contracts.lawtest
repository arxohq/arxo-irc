// Accounting WIRE-10 group B scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "W10B-ACC-01-LEASE-TERM-FROM-DEDUCTIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.deductions::lease_term_years_168i3(3, 9) { origin case_input; }
    }
    evaluate truth(lease_term_years(3, 9));
    expect truth_status == TRUE_ONLY;
}

test "W10B-ACC-02-LEASE-TERM-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": lease_term_years(4, 6) { origin case_input; }
    }
    evaluate truth(lease_term_years(4, 6));
    expect truth_status == TRUE_ONLY;
}

test "W10B-ACC-07-SECTION-7519-PAYMENT-OWED-FROM-ADMINISTRATION" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.administration::section_7519_applies(entity_ref("urn:test:w10b:aa1#f"), entity_ref("urn:test:w10b:aa1#y")) { origin case_input; }
    }
    evaluate truth(section_7519_required_payment_owed(entity_ref("urn:test:w10b:aa1#f"), entity_ref("urn:test:w10b:aa1#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-ACC-08-SECTION-7519-PAYMENT-OWED-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_7519_required_payment_owed(entity_ref("urn:test:w10b:aa2#f"), entity_ref("urn:test:w10b:aa2#y")) { origin case_input; }
    }
    evaluate truth(section_7519_required_payment_owed(entity_ref("urn:test:w10b:aa2#f"), entity_ref("urn:test:w10b:aa2#y")));
    expect truth_status == TRUE_ONLY;
}
