test "S468-27-CLOSING-DEDUCTION-BY-PRODUCTION-RATIO" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": elects_reserve_treatment_468(entity_ref("urn:test:s468:t27#p"), entity_ref("urn:test:s468:t27#y"), 1) { origin case_input; }
        assert "f1": reserve_property_kind_468(1, MiningProperty) { origin case_input; }
        assert "f2": reclamation_plan_submitted_under_smcra_511_or_528_468d2A(1) { origin case_input; }
        assert "f3": reclamation_plan_is_part_of_smcra_title_v_permit_468d2A(1) { origin case_input; }
        assert "f4": closing_costs_method_used_468(1, UnitOfProduction) { origin case_input; }
        assert "f5": current_closing_costs_468d1B(entity_ref("urn:test:s468:t27#p"), 1, 1000000 USD) { origin case_input; }
        assert "f6": units_of_production_or_capacity_used_in_year_468(entity_ref("urn:test:s468:t27#p"), entity_ref("urn:test:s468:t27#y"), 1, 50) { origin case_input; }
        assert "f7": total_units_of_production_or_capacity_468(entity_ref("urn:test:s468:t27#p"), 1, 400) { origin case_input; }
