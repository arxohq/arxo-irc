        assert "f5": prior_year_closing_balance_468(entity_ref("urn:test:s468:t43#p"), entity_ref("urn:test:s468:t43#y"), 1, ReclamationReserve, 100000 USD) { origin case_input; }
        assert "f6": federal_short_term_annual_rates_for_year_468(entity_ref("urn:test:s468:t43#y"), 0.04, 0.06) { origin case_input; }
        assert "f7": current_reclamation_costs_all_disturbed_portions_468a4A(entity_ref("urn:test:s468:t43#p"), entity_ref("urn:test:s468:t43#y"), 1, 500000 USD) { origin case_input; }
