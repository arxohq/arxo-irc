test "S468-01-SMCRA-PLAN-WITH-TITLE-V-PERMIT-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": reclamation_plan_submitted_under_smcra_511_or_528_468d2A(1) { origin case_input; }
        assert "f1": reclamation_plan_is_part_of_smcra_title_v_permit_468d2A(1) { origin case_input; }
    }
    evaluate truth(qualified_mining_reclamation_or_closing_plan_468d2A(1));
    expect truth_status == TRUE_ONLY;
}

