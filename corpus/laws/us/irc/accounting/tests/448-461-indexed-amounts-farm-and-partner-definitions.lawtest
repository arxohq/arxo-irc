test "S46-01-GROSS-RECEIPTS-THRESHOLD-INDEXED-TO-NEAREST-MILLION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:s46:t1#y"), @2023-01-01) { origin case_input; }
        assert "f1": cost_of_living_adjustment_1f3_2017_base_446(entity_ref("urn:test:s46:t1#y"), 0.0357) { origin case_input; }
    }
    evaluate truth(gross_receipts_threshold_indexed_448c4(entity_ref("urn:test:s46:t1#y"), 26000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

