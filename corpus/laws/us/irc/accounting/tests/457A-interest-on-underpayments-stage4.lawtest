// Section 457A(c)(1)(B)(i), (c)(2): interest on the underpayments that would have occurred (module 51). NOT EXECUTED.
// Expected values computed offline (daily step = rate / 365 rounded to 12 places; balance rounded to cents at the end of each period).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S457A-01-INTEREST-ON-UNDERPAYMENTS-COMPOUNDED-DAILY" {
    // Rates 5% + 1 point and 6% + 1 point; two periods of 365 days; underpayments 10000 and 8000.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": plan_of_nonqualified_entity_457A(1, entity_ref("urn:test:s457a:t1#p")) { origin case_input; }
        assert "f1": first_taxable_year_deferred_457Ac2(1, entity_ref("urn:test:s457a:t1#y0")) { origin case_input; }
        assert "f2": first_year_without_substantial_risk_of_forfeiture_457A(1, entity_ref("urn:test:s457a:t1#y0")) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s457a:t1#y0"), @2020-01-01) { origin case_input; }
        assert "f4": preceding_taxable_year_465(entity_ref("urn:test:s457a:t1#y0"), entity_ref("urn:test:s457a:t1#y1")) { origin case_input; }
        assert "f5": preceding_taxable_year_465(entity_ref("urn:test:s457a:t1#y1"), entity_ref("urn:test:s457a:t1#y2")) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t1#p"), entity_ref("urn:test:s457a:t1#y0"), @2021-04-15) { origin case_input; }
        assert "f7": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t1#p"), entity_ref("urn:test:s457a:t1#y1"), @2022-04-15) { origin case_input; }
        assert "f8": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t1#p"), entity_ref("urn:test:s457a:t1#y2"), @2023-04-15) { origin case_input; }
        assert "f9": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t1#y0"), 0.05) { origin case_input; }
        assert "f10": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t1#y1"), 0.06) { origin case_input; }
        assert "f11": compensation_amount_not_determinable_when_otherwise_includible_457Ac1(1) { origin case_input; }
        assert "f12": compensation_includible_when_determinable_457Ac1A(1, entity_ref("urn:test:s457a:t1#y2"), 50000 USD) { origin case_input; }
        assert "f13": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t1#y0"), 10000 USD) { origin case_input; }
        assert "f14": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t1#y1"), 8000 USD) { origin case_input; }
    }
    evaluate truth(interest_on_underpayments_457Ac2(1, entity_ref("urn:test:s457a:t1#y2"), 1968.16 USD));
    expect truth_status == TRUE_ONLY;
}

test "S457A-02-TAX-INCREASE-IS-INTEREST-PLUS-TWENTY-PERCENT" {
    // Section 457A(c)(1)(B): interest of (i) plus 20 percent of the 50000 compensation (ii) = 10000.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": plan_of_nonqualified_entity_457A(1, entity_ref("urn:test:s457a:t2#p")) { origin case_input; }
        assert "f1": first_taxable_year_deferred_457Ac2(1, entity_ref("urn:test:s457a:t2#y0")) { origin case_input; }
        assert "f2": first_year_without_substantial_risk_of_forfeiture_457A(1, entity_ref("urn:test:s457a:t2#y0")) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s457a:t2#y0"), @2020-01-01) { origin case_input; }
        assert "f4": preceding_taxable_year_465(entity_ref("urn:test:s457a:t2#y0"), entity_ref("urn:test:s457a:t2#y1")) { origin case_input; }
        assert "f5": preceding_taxable_year_465(entity_ref("urn:test:s457a:t2#y1"), entity_ref("urn:test:s457a:t2#y2")) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t2#p"), entity_ref("urn:test:s457a:t2#y0"), @2021-04-15) { origin case_input; }
        assert "f7": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t2#p"), entity_ref("urn:test:s457a:t2#y1"), @2022-04-15) { origin case_input; }
        assert "f8": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t2#p"), entity_ref("urn:test:s457a:t2#y2"), @2023-04-15) { origin case_input; }
        assert "f9": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t2#y0"), 0.05) { origin case_input; }
        assert "f10": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t2#y1"), 0.06) { origin case_input; }
        assert "f11": compensation_amount_not_determinable_when_otherwise_includible_457Ac1(1) { origin case_input; }
        assert "f12": compensation_includible_when_determinable_457Ac1A(1, entity_ref("urn:test:s457a:t2#y2"), 50000 USD) { origin case_input; }
        assert "f13": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t2#y0"), 10000 USD) { origin case_input; }
        assert "f14": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t2#y1"), 8000 USD) { origin case_input; }
    }
    evaluate truth(total_additional_tax_457Ac1B(1, entity_ref("urn:test:s457a:t2#y2"), 11968.16 USD));
    expect truth_status == TRUE_ONLY;
}

test "S457A-03-NO-INTEREST-WITHOUT-A-DEFERRAL-YEAR" {
    // Without the first deferral year and the risk-of-forfeiture year no start year exists.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": plan_of_nonqualified_entity_457A(1, entity_ref("urn:test:s457a:t3#p")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s457a:t3#y0"), @2020-01-01) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s457a:t3#y0"), entity_ref("urn:test:s457a:t3#y1")) { origin case_input; }
        assert "f3": preceding_taxable_year_465(entity_ref("urn:test:s457a:t3#y1"), entity_ref("urn:test:s457a:t3#y2")) { origin case_input; }
        assert "f4": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t3#p"), entity_ref("urn:test:s457a:t3#y0"), @2021-04-15) { origin case_input; }
        assert "f5": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t3#p"), entity_ref("urn:test:s457a:t3#y1"), @2022-04-15) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t3#p"), entity_ref("urn:test:s457a:t3#y2"), @2023-04-15) { origin case_input; }
        assert "f7": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t3#y0"), 0.05) { origin case_input; }
        assert "f8": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t3#y1"), 0.06) { origin case_input; }
        assert "f9": compensation_amount_not_determinable_when_otherwise_includible_457Ac1(1) { origin case_input; }
        assert "f10": compensation_includible_when_determinable_457Ac1A(1, entity_ref("urn:test:s457a:t3#y2"), 50000 USD) { origin case_input; }
        assert "f11": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t3#y0"), 10000 USD) { origin case_input; }
        assert "f12": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t3#y1"), 8000 USD) { origin case_input; }
    }
    evaluate truth(interest_on_underpayments_457Ac2(1, entity_ref("urn:test:s457a:t3#y2"), 1968.16 USD));
    expect truth_status == NEITHER;
}

test "S457A-04-START-YEAR-IS-THE-LATER-RISK-FREE-YEAR" {
    // Deferred in 2019 but first free of a substantial risk in 2020: interest runs from the later year.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": plan_of_nonqualified_entity_457A(1, entity_ref("urn:test:s457a:t4#p")) { origin case_input; }
        assert "f1": first_year_without_substantial_risk_of_forfeiture_457A(1, entity_ref("urn:test:s457a:t4#y0")) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s457a:t4#y0"), entity_ref("urn:test:s457a:t4#y1")) { origin case_input; }
        assert "f3": preceding_taxable_year_465(entity_ref("urn:test:s457a:t4#y1"), entity_ref("urn:test:s457a:t4#y2")) { origin case_input; }
        assert "f4": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t4#p"), entity_ref("urn:test:s457a:t4#y0"), @2021-04-15) { origin case_input; }
        assert "f5": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t4#p"), entity_ref("urn:test:s457a:t4#y1"), @2022-04-15) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s457a:t4#p"), entity_ref("urn:test:s457a:t4#y2"), @2023-04-15) { origin case_input; }
        assert "f7": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t4#y0"), 0.05) { origin case_input; }
        assert "f8": underpayment_rate_under_section_6621_457Ac2(entity_ref("urn:test:s457a:t4#y1"), 0.06) { origin case_input; }
        assert "f9": compensation_amount_not_determinable_when_otherwise_includible_457Ac1(1) { origin case_input; }
        assert "f10": compensation_includible_when_determinable_457Ac1A(1, entity_ref("urn:test:s457a:t4#y2"), 50000 USD) { origin case_input; }
        assert "f11": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t4#y0"), 10000 USD) { origin case_input; }
        assert "f12": hypothetical_underpayment_457Ac2(1, entity_ref("urn:test:s457a:t4#y1"), 8000 USD) { origin case_input; }
        assert "f13": first_taxable_year_deferred_457Ac2(1, entity_ref("urn:test:s457a:t4#y9")) { origin case_input; }
        assert "f14": us.irc.core::begins(entity_ref("urn:test:s457a:t4#y9"), @2019-01-01) { origin case_input; }
        assert "f15": us.irc.core::begins(entity_ref("urn:test:s457a:t4#y0"), @2020-01-01) { origin case_input; }
    }
    evaluate truth(interest_start_year_457Ac2(1, entity_ref("urn:test:s457a:t4#y0")));
    expect truth_status == TRUE_ONLY;
}
