// Section 631 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S631-01-TIMBER-CUTTING-ELECTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": owns_or_has_contract_right_to_cut_timber(entity_ref("urn:test:s631:t1#p"), entity_ref("urn:test:s631:t1#timber")) { origin case_input; }
        assert "f1": held_timber_or_contract_right_more_than_one_year(entity_ref("urn:test:s631:t1#p"), entity_ref("urn:test:s631:t1#timber"), entity_ref("urn:test:s631:t1#y")) { origin case_input; }
        assert "f2": cuts_timber_in_year(entity_ref("urn:test:s631:t1#p"), entity_ref("urn:test:s631:t1#timber"), entity_ref("urn:test:s631:t1#y")) { origin case_input; }
        assert "f3": elects_to_treat_timber_cutting_as_sale(entity_ref("urn:test:s631:t1#p"), entity_ref("urn:test:s631:t1#timber"), entity_ref("urn:test:s631:t1#y")) { origin case_input; }
    }
    evaluate truth(timber_cutting_treated_as_sale_or_exchange(entity_ref("urn:test:s631:t1#p"), entity_ref("urn:test:s631:t1#timber"), entity_ref("urn:test:s631:t1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S631-02-TIMBER-CUTTING-GAIN-COMPUTATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": timber_cutting_treated_as_sale_or_exchange(entity_ref("urn:test:s631:t2#p"), entity_ref("urn:test:s631:t2#timber"), entity_ref("urn:test:s631:t2#y")) { origin case_input; }
        assert "f1": timber_fair_market_value_first_day_of_year(entity_ref("urn:test:s631:t2#p"), entity_ref("urn:test:s631:t2#timber"), entity_ref("urn:test:s631:t2#y"), 90000.00 USD) { origin case_input; }
        assert "f2": timber_adjusted_basis_for_depletion(entity_ref("urn:test:s631:t2#p"), entity_ref("urn:test:s631:t2#timber"), entity_ref("urn:test:s631:t2#y"), 20000.00 USD) { origin case_input; }
    }
    evaluate truth(timber_cutting_gain_or_loss(entity_ref("urn:test:s631:t2#p"), entity_ref("urn:test:s631:t2#timber"), entity_ref("urn:test:s631:t2#y"), 70000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S631-03-COAL-DISPOSAL-TO-RELATED-PERSON-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": held_coal_or_iron_ore_more_than_one_year(entity_ref("urn:test:s631:t3#p"), entity_ref("urn:test:s631:t3#deposit")) { origin case_input; }
        assert "f1": disposes_of_coal_or_iron_ore_with_retained_economic_interest(entity_ref("urn:test:s631:t3#p"), entity_ref("urn:test:s631:t3#deposit"), entity_ref("urn:test:s631:t3#y")) { origin case_input; }
        assert "f2": amount_realized_from_coal_or_iron_ore_disposal(entity_ref("urn:test:s631:t3#p"), entity_ref("urn:test:s631:t3#deposit"), entity_ref("urn:test:s631:t3#y"), 50000.00 USD) { origin case_input; }
        assert "f3": timber_adjusted_basis_for_depletion(entity_ref("urn:test:s631:t3#p"), entity_ref("urn:test:s631:t3#deposit"), entity_ref("urn:test:s631:t3#y"), 10000.00 USD) { origin case_input; }
        assert "f4": disposal_to_related_person_excluded_under_631c(entity_ref("urn:test:s631:t3#p"), entity_ref("urn:test:s631:t3#deposit"), entity_ref("urn:test:s631:t3#y")) { origin case_input; }
    }
    evaluate truth(coal_or_iron_ore_disposal_gain_or_loss(entity_ref("urn:test:s631:t3#p"), entity_ref("urn:test:s631:t3#deposit"), entity_ref("urn:test:s631:t3#y"), 40000.00 USD));
    expect truth_status == NEITHER;
}
