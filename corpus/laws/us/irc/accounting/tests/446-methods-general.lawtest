// Section 446 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S446-01-REGULARLY-USED-PERMISSIBLE-METHOD-APPLIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": method_regularly_used(entity_ref("urn:test:s446:t1#p"), entity_ref("urn:test:s446:t1#y"), CashReceiptsAndDisbursements) { origin case_input; }
    }
    evaluate truth(applicable_accounting_method(entity_ref("urn:test:s446:t1#p"), entity_ref("urn:test:s446:t1#y"), CashReceiptsAndDisbursements));
    expect truth_status == TRUE_ONLY;
}

test "S446-02-NO-METHOD-REGULARLY-USED-SECRETARY-MAY-REQUIRE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": no_method_regularly_used(entity_ref("urn:test:s446:t2#p"), entity_ref("urn:test:s446:t2#y")) { origin case_input; }
    }
    evaluate truth(secretary_requires_different_method(entity_ref("urn:test:s446:t2#p"), entity_ref("urn:test:s446:t2#y")));
    expect truth_status == TRUE_ONLY;
}

test "S446-03-METHOD-DOES-NOT-CLEARLY-REFLECT-INCOME-UNADJUDICATED-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": method_regularly_used(entity_ref("urn:test:s446:t3#p"), entity_ref("urn:test:s446:t3#y"), Accrual) { origin case_input; }
    }
    // No opinion of the Secretary yet on whether the method clearly reflects
    // income — DECISION-0194: NEITHER/REQUIRES_JUDGMENT, not a denial.
    evaluate truth(secretary_requires_different_method(entity_ref("urn:test:s446:t3#p"), entity_ref("urn:test:s446:t3#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}

test "S446-04-CHANGE-OF-METHOD-CONSENT-GRANTED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": requests_change_of_accounting_method(entity_ref("urn:test:s446:t4#p"), entity_ref("urn:test:s446:t4#y"), Accrual) { origin case_input; }
        assert "f1": secretary_consents_to_change_of_method(entity_ref("urn:test:s446:t4#p"), entity_ref("urn:test:s446:t4#y"), Accrual) { origin case_input; }
    }
    evaluate truth(new_method_becomes_applicable(entity_ref("urn:test:s446:t4#p"), entity_ref("urn:test:s446:t4#y"), Accrual));
    expect truth_status == TRUE_ONLY;
}

test "S446-05-CHANGE-OF-METHOD-WITHOUT-CONSENT-NO-EFFECT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": requests_change_of_accounting_method(entity_ref("urn:test:s446:t5#p"), entity_ref("urn:test:s446:t5#y"), Accrual) { origin case_input; }
    }
    evaluate truth(new_method_becomes_applicable(entity_ref("urn:test:s446:t5#p"), entity_ref("urn:test:s446:t5#y"), Accrual));
    expect truth_status == FALSE_ONLY;
}
