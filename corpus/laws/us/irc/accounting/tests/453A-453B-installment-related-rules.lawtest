// Sections 453A and 453B scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S453A-01-APPLIES-ABOVE-BOTH-THRESHOLDS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_installment_obligation_from_disposition(entity_ref("urn:test:s453a:t1#p"), 1, entity_ref("urn:test:s453a:t1#y")) { origin case_input; }
        assert "f1": installment_obligation_sales_price(entity_ref("urn:test:s453a:t1#p"), 1, 200000.00 USD) { origin case_input; }
        assert "f2": installment_obligation_outstanding_at_close_of_year(entity_ref("urn:test:s453a:t1#p"), 1, entity_ref("urn:test:s453a:t1#y")) { origin case_input; }
        assert "f3": aggregate_face_amount_of_years_obligations(entity_ref("urn:test:s453a:t1#p"), entity_ref("urn:test:s453a:t1#y"), 6000000.00 USD) { origin case_input; }
    }
    evaluate truth(section_453a_applies_to_obligation(entity_ref("urn:test:s453a:t1#p"), 1, entity_ref("urn:test:s453a:t1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S453A-02-NOT-APPLIES-BELOW-SALES-PRICE-GATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_installment_obligation_from_disposition(entity_ref("urn:test:s453a:t2#p"), 1, entity_ref("urn:test:s453a:t2#y")) { origin case_input; }
        assert "f1": installment_obligation_sales_price(entity_ref("urn:test:s453a:t2#p"), 1, 100000.00 USD) { origin case_input; }
        assert "f2": installment_obligation_outstanding_at_close_of_year(entity_ref("urn:test:s453a:t2#p"), 1, entity_ref("urn:test:s453a:t2#y")) { origin case_input; }
        assert "f3": aggregate_face_amount_of_years_obligations(entity_ref("urn:test:s453a:t2#p"), entity_ref("urn:test:s453a:t2#y"), 6000000.00 USD) { origin case_input; }
    }
    evaluate truth(section_453a_applies_to_obligation(entity_ref("urn:test:s453a:t2#p"), 1, entity_ref("urn:test:s453a:t2#y")));
    expect truth_status == NEITHER;
}

test "S453A-03-DEFERRED-TAX-LIABILITY-COMPUTATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_installment_obligation_from_disposition(entity_ref("urn:test:s453a:t3#p"), 1, entity_ref("urn:test:s453a:t3#y")) { origin case_input; }
        assert "f1": installment_obligation_sales_price(entity_ref("urn:test:s453a:t3#p"), 1, 200000.00 USD) { origin case_input; }
        assert "f2": installment_obligation_outstanding_at_close_of_year(entity_ref("urn:test:s453a:t3#p"), 1, entity_ref("urn:test:s453a:t3#y")) { origin case_input; }
        assert "f3": aggregate_face_amount_of_years_obligations(entity_ref("urn:test:s453a:t3#p"), entity_ref("urn:test:s453a:t3#y"), 6000000.00 USD) { origin case_input; }
        assert "f4": obligation_gain_not_yet_recognized(entity_ref("urn:test:s453a:t3#p"), 1, entity_ref("urn:test:s453a:t3#y"), 100000.00 USD) { origin case_input; }
        assert "f5": maximum_rate_of_tax_under_section_1_or_11(entity_ref("urn:test:s453a:t3#p"), entity_ref("urn:test:s453a:t3#y"), 0.37) { origin case_input; }
    }
    // $100,000 * 0.37 = $37,000.
    evaluate truth(deferred_tax_liability(entity_ref("urn:test:s453a:t3#p"), 1, entity_ref("urn:test:s453a:t3#y"), 37000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453B-01-BASIS-IS-FACE-VALUE-MINUS-RETURNABLE-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": installment_obligation_face_value(entity_ref("urn:test:s453b:t1#p"), 1, 100000.00 USD) { origin case_input; }
        assert "f1": income_returnable_if_satisfied_in_full(entity_ref("urn:test:s453b:t1#p"), 1, 40000.00 USD) { origin case_input; }
    }
    evaluate truth(installment_obligation_basis(entity_ref("urn:test:s453b:t1#p"), 1, 60000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453B-02-GAIN-ON-SALE-OF-OBLIGATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": installment_obligation_satisfied_at_other_than_face_value_or_sold(entity_ref("urn:test:s453b:t2#p"), 1, entity_ref("urn:test:s453b:t2#y")) { origin case_input; }
        assert "f1": installment_obligation_basis(entity_ref("urn:test:s453b:t2#p"), 1, 60000.00 USD) { origin case_input; }
        assert "f2": amount_realized_on_obligation_satisfaction_or_sale(entity_ref("urn:test:s453b:t2#p"), 1, entity_ref("urn:test:s453b:t2#y"), 75000.00 USD) { origin case_input; }
    }
    evaluate truth(installment_obligation_disposition_gain(entity_ref("urn:test:s453b:t2#p"), 1, entity_ref("urn:test:s453b:t2#y"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S453B-03-DEATH-TRANSMISSION-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": installment_obligation_satisfied_at_other_than_face_value_or_sold(entity_ref("urn:test:s453b:t3#p"), 1, entity_ref("urn:test:s453b:t3#y")) { origin case_input; }
        assert "f1": installment_obligation_basis(entity_ref("urn:test:s453b:t3#p"), 1, 60000.00 USD) { origin case_input; }
        assert "f2": amount_realized_on_obligation_satisfaction_or_sale(entity_ref("urn:test:s453b:t3#p"), 1, entity_ref("urn:test:s453b:t3#y"), 75000.00 USD) { origin case_input; }
        assert "f3": transmission_at_death_excluded_under_453b_c(entity_ref("urn:test:s453b:t3#p"), 1, entity_ref("urn:test:s453b:t3#y")) { origin case_input; }
    }
    evaluate truth(installment_obligation_disposition_gain(entity_ref("urn:test:s453b:t3#p"), 1, entity_ref("urn:test:s453b:t3#y"), 15000.00 USD));
    expect truth_status == NEITHER;
}
