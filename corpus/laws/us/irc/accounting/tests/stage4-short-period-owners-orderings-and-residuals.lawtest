    }
    evaluate truth(net_tax_increase_three_year_allocation_481b1(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y"), 2800 USD));
    expect truth_status == TRUE_ONLY;
}

