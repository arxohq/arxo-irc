        assert "f6": liquidated_layer_from_qualified_liquidation_473e2(entity_ref("urn:test:s473e:t1#p"), 2) { origin case_input; }
    }
    evaluate truth(replaced_quantity_473e1(entity_ref("urn:test:s473e:t1#p"), entity_ref("urn:test:s473e:t1#y"), 1, 2, 50.0));
    expect truth_status == TRUE_ONLY;
}

