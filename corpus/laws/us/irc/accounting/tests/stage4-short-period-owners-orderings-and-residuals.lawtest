test "S481B1-01-THREE-YEAR-ALLOCATION-NET-INCREASE" {
    // (12000-10000) + (8500-8000) + (7700-7500) + 100 loss effect = 2800.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": same_method_for_2_preceding_years(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y")) { origin case_input; }
        assert "f1": section_481a_adjustment_amount(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y"), 30000 USD) { origin case_input; }
        assert "f2": tax_attributable_to_481a2_increase_481b(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y"), 9000 USD) { origin case_input; }
        assert "f3": tax_as_it_stands_for_year_481b(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y"), 10000 USD) { origin case_input; }
        assert "f4": tax_as_it_stands_for_year_481b(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y1"), 8000 USD) { origin case_input; }
        assert "f5": tax_as_it_stands_for_year_481b(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y2"), 7500 USD) { origin case_input; }
        assert "f6": tax_with_three_year_allocation_481b1(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y"), 1, entity_ref("urn:test:s481b:t1#y"), 12000 USD) { origin case_input; }
        assert "f7": tax_with_three_year_allocation_481b1(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y"), 2, entity_ref("urn:test:s481b:t1#y1"), 8500 USD) { origin case_input; }
        assert "f8": tax_with_three_year_allocation_481b1(entity_ref("urn:test:s481b:t1#p"), entity_ref("urn:test:s481b:t1#y"), 3, entity_ref("urn:test:s481b:t1#y2"), 7700 USD) { origin case_input; }
