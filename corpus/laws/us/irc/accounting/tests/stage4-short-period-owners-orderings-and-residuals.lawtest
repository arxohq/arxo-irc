        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": stock_held_of_record_448d(entity_ref("urn:test:s448d:t1#c"), entity_ref("urn:test:s448d:t1#h"), 0.6) { origin case_input; }
    }
    evaluate truth(stock_held_disregarding_community_property_448d4A(entity_ref("urn:test:s448d:t1#c"), entity_ref("urn:test:s448d:t1#h"), 0.6));
    expect truth_status == TRUE_ONLY;
}

