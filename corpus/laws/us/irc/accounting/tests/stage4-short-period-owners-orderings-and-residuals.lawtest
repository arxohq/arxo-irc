test "S461J-01-FIVE-YEAR-WINDOW-COUNTS-THE-CARRIED-LOSS-ONCE" {
    // Income 5 x 400000; deductions 100000+100000+(180000-80000)+100000+100000 = 500000: the 80000 disallowed in the third year is counted only when it reappears (section 461(j)(4)(B)(ii)(I)).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": farm_loss_threshold_base(entity_ref("urn:test:s461j:t1#p"), entity_ref("urn:test:s461j:t1#y"), 300000 USD) { origin case_input; }
        assert "f1": preceding_taxable_year_465(entity_ref("urn:test:s461j:t1#w1"), entity_ref("urn:test:s461j:t1#y")) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s461j:t1#w2"), entity_ref("urn:test:s461j:t1#w1")) { origin case_input; }
        assert "f3": preceding_taxable_year_465(entity_ref("urn:test:s461j:t1#w3"), entity_ref("urn:test:s461j:t1#w2")) { origin case_input; }
