        assert "f1": modified_taxable_income(entity_ref("urn:test:s443b2:t2#p"), entity_ref("urn:test:s443b2:t2#ys"), 60000 USD) { origin case_input; }
        assert "f2": short_period_tax(entity_ref("urn:test:s443b2:t2#p"), entity_ref("urn:test:s443b2:t2#ys"), 15000 USD) { origin case_input; }
        assert "f3": tax_on_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t2#p"), entity_ref("urn:test:s443b2:t2#ys"), 36000 USD) { origin case_input; }
        assert "f4": modified_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t2#p"), entity_ref("urn:test:s443b2:t2#ys"), 180000 USD) { origin case_input; }
        assert "f5": tax_on_modified_taxable_income_of_short_period_443b2Aii(entity_ref("urn:test:s443b2:t2#p"), entity_ref("urn:test:s443b2:t2#ys"), 9000 USD) { origin case_input; }
    }
    evaluate truth(greater_of_alternative_taxes_443b2A(entity_ref("urn:test:s443b2:t2#p"), entity_ref("urn:test:s443b2:t2#ys"), 12000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S443B2-03-SHORT-PERIOD-TAX-REDUCED-TO-THE-GREATER" {
    // The (b)(1) tax of 15000 is reduced to 12000.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": short_period_return_required(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys")) { origin case_input; }
        assert "f1": modified_taxable_income(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys"), 60000 USD) { origin case_input; }
        assert "f2": short_period_tax(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys"), 15000 USD) { origin case_input; }
        assert "f3": tax_on_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys"), 36000 USD) { origin case_input; }
        assert "f4": modified_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys"), 180000 USD) { origin case_input; }
        assert "f5": tax_on_modified_taxable_income_of_short_period_443b2Aii(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys"), 9000 USD) { origin case_input; }
        assert "f6": applies_for_benefits_of_443b2(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys")) { origin case_input; }
        assert "f7": taxable_income_for_twelve_month_period_established_443b2A(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys")) { origin case_input; }
        assert "f8": application_made_in_time_443b2C(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys")) { origin case_input; }
    }
    evaluate truth(short_period_tax_under_443b2A(entity_ref("urn:test:s443b2:t3#p"), entity_ref("urn:test:s443b2:t3#ys"), 12000 USD));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

