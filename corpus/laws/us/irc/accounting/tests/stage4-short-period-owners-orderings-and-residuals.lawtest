test "S461J5-01-HOLDER-SHARE-OF-FARM-DEDUCTIONS-IN-THE-HOLDERS-YEAR" {
    // 25 percent of 200000.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": entity_is_partnership_or_s_corporation_461_5(entity_ref("urn:test:s461p:t1#pt")) { origin case_input; }
        assert "f1": holder_of_entity_461_5(entity_ref("urn:test:s461p:t1#pt"), entity_ref("urn:test:s461p:t1#h")) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:s461p:t1#ye"), @2024-12-31) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s461p:t1#yh"), @2024-01-01) { origin case_input; }
        assert "f4": us.irc.core::ends(entity_ref("urn:test:s461p:t1#yh"), @2024-12-31) { origin case_input; }
        assert "f5": holder_proportionate_share_461_5B(entity_ref("urn:test:s461p:t1#pt"), entity_ref("urn:test:s461p:t1#ye"), entity_ref("urn:test:s461p:t1#h"), 0.25) { origin case_input; }
        assert "f6": entity_farm_deductions_461j5B(entity_ref("urn:test:s461p:t1#pt"), entity_ref("urn:test:s461p:t1#ye"), 200000 USD) { origin case_input; }
        assert "f7": entity_farm_gross_income_461j5B(entity_ref("urn:test:s461p:t1#pt"), entity_ref("urn:test:s461p:t1#ye"), 80000 USD) { origin case_input; }
        assert "f8": entity_business_deductions_461l4B(entity_ref("urn:test:s461p:t1#pt"), entity_ref("urn:test:s461p:t1#ye"), 400000 USD) { origin case_input; }
        assert "f9": entity_business_income_461l4B(entity_ref("urn:test:s461p:t1#pt"), entity_ref("urn:test:s461p:t1#ye"), 120000 USD) { origin case_input; }
    }
    evaluate truth(holder_share_of_entity_farm_deductions_461j5B(entity_ref("urn:test:s461p:t1#h"), entity_ref("urn:test:s461p:t1#yh"), entity_ref("urn:test:s461p:t1#pt"), 50000 USD));
    expect truth_status == TRUE_ONLY;
}

