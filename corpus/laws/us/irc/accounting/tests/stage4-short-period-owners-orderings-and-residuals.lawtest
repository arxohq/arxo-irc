        assert "f4": related_party_acquirer_470e2(entity_ref("urn:test:s470e:t1#p"), entity_ref("urn:test:s470e:t1#y"), entity_ref("urn:test:s470e:t1#pr")) { origin case_input; }
        assert "f5": interest_acquired_by_unrelated_person_470e2(entity_ref("urn:test:s470e:t1#p"), entity_ref("urn:test:s470e:t1#pr"), entity_ref("urn:test:s470e:t1#y"), entity_ref("urn:test:s470e:t1#ya")) { origin case_input; }
    }
    evaluate truth(tax_exempt_use_loss_freed_on_disposition(entity_ref("urn:test:s470e:t1#p"), entity_ref("urn:test:s470e:t1#ya"), entity_ref("urn:test:s470e:t1#pr"), 30000 USD));
    expect truth_status == TRUE_ONLY;
}

