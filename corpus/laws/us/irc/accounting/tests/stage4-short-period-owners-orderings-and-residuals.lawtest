test "S443B2-05-REDUCTION-NEVER-RAISES-THE-TAX" {
    // General tax 11000 is below the greater (12000): the lesser is kept (JUDGMENT CALL on 'reduced to').
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": short_period_return_required(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys")) { origin case_input; }
        assert "f1": modified_taxable_income(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys"), 60000 USD) { origin case_input; }
        assert "f2": tax_on_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys"), 36000 USD) { origin case_input; }
        assert "f3": modified_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys"), 180000 USD) { origin case_input; }
        assert "f4": tax_on_modified_taxable_income_of_short_period_443b2Aii(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys"), 9000 USD) { origin case_input; }
        assert "f5": applies_for_benefits_of_443b2(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys")) { origin case_input; }
        assert "f6": taxable_income_for_twelve_month_period_established_443b2A(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys")) { origin case_input; }
        assert "f7": application_made_in_time_443b2C(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys")) { origin case_input; }
        assert "f8": short_period_tax(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys"), 11000 USD) { origin case_input; }
    }
    evaluate truth(short_period_tax_under_443b2A(entity_ref("urn:test:s443b2:t5#p"), entity_ref("urn:test:s443b2:t5#ys"), 11000 USD));
    expect truth_status == TRUE_ONLY;
}

