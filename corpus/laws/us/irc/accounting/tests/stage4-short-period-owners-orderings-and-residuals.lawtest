// Stage 4 scenarios, part 3: sections 443(b)(2), 448(d)(4)(A), 458(c)(4), 461(j), 461(l), 469(e)(2), 470(e), 473(e), 481(b), 617 (modules 55-57 and the edited rules of 09, 23, 25, 29). NOT EXECUTED (implemented_unverified).
// Expected values are computed by hand from the statute; the tax functions of the tax owners are case-supplied comparators.

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S443B2-01-PRORATED-TWELVE-MONTH-TAX" {
    // 36000 x 60000 / 180000 = 12000.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": short_period_return_required(entity_ref("urn:test:s443b2:t1#p"), entity_ref("urn:test:s443b2:t1#ys")) { origin case_input; }
        assert "f1": modified_taxable_income(entity_ref("urn:test:s443b2:t1#p"), entity_ref("urn:test:s443b2:t1#ys"), 60000 USD) { origin case_input; }
        assert "f2": short_period_tax(entity_ref("urn:test:s443b2:t1#p"), entity_ref("urn:test:s443b2:t1#ys"), 15000 USD) { origin case_input; }
        assert "f3": tax_on_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t1#p"), entity_ref("urn:test:s443b2:t1#ys"), 36000 USD) { origin case_input; }
        assert "f4": modified_taxable_income_of_twelve_month_period_443b2A(entity_ref("urn:test:s443b2:t1#p"), entity_ref("urn:test:s443b2:t1#ys"), 180000 USD) { origin case_input; }
        assert "f5": tax_on_modified_taxable_income_of_short_period_443b2Aii(entity_ref("urn:test:s443b2:t1#p"), entity_ref("urn:test:s443b2:t1#ys"), 9000 USD) { origin case_input; }
    }
    evaluate truth(prorated_twelve_month_tax_443b2Ai(entity_ref("urn:test:s443b2:t1#p"), entity_ref("urn:test:s443b2:t1#ys"), 12000 USD));
    expect truth_status == TRUE_ONLY;
}

