    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": adjusted_exploration_expenditures(entity_ref("urn:test:s617:t6#p"), 1, 100000 USD) { origin case_input; }
        assert "f1": adjusted_exploration_expenditures_immediately_before_distribution_617g1(entity_ref("urn:test:s617:t6#p"), 1, 60000 USD) { origin case_input; }
        assert "f2": gain_751b_realized_by_partnership_617g1(entity_ref("urn:test:s617:t6#p"), 1, 40000 USD) { origin case_input; }
    }
    evaluate truth(adjusted_exploration_expenditures_of_distributed_property_617g1(entity_ref("urn:test:s617:t6#p"), 1, 120000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S617G2-01-RETAINED-PROPERTY-EXPENDITURES-REDUCED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": adjusted_exploration_expenditures(entity_ref("urn:test:s617:t7#p"), 1, 100000 USD) { origin case_input; }
        assert "f1": gain_751b_realized_by_partner_617g2(entity_ref("urn:test:s617:t7#p"), 1, 30000 USD) { origin case_input; }
    }
    evaluate truth(adjusted_exploration_expenditures_of_retained_property_617g2(entity_ref("urn:test:s617:t7#p"), 1, 70000 USD));
    expect truth_status == TRUE_ONLY;
}
