        assert "f7": taxable_income_for_twelve_month_period_established_443b2A(entity_ref("urn:test:s443b2:t4#p"), entity_ref("urn:test:s443b2:t4#ys")) { origin case_input; }
    }
    evaluate truth(benefits_of_443b2_granted(entity_ref("urn:test:s443b2:t4#p"), entity_ref("urn:test:s443b2:t4#ys")));
