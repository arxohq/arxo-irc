test "S468A-01-UNIT-OF-A-POWERPLANT-IS-A-NUCLEAR-POWERPLANT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_nuclear_powerplant_468A(1) { origin case_input; }
        assert "f1": is_unit_of_nuclear_powerplant_468A(1, 11) { origin case_input; }
    }
    evaluate truth(nuclear_powerplant_term_includes_unit_468Ag(11));
    expect truth_status == TRUE_ONLY;
}

