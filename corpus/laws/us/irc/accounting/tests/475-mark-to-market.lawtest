// Section 475 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S475-01-DEALER-MARK-TO-MARKET-GAIN" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_dealer_in_securities(entity_ref("urn:test:s475:t1#p")) { origin case_input; }
        assert "f1": is_security_477(entity_ref("urn:test:s475:t1#security")) { origin case_input; }
        assert "f2": security_held_at_close_of_year(entity_ref("urn:test:s475:t1#p"), entity_ref("urn:test:s475:t1#security"), entity_ref("urn:test:s475:t1#y")) { origin case_input; }
        assert "f4": security_fair_market_value_at_year_end(entity_ref("urn:test:s475:t1#p"), entity_ref("urn:test:s475:t1#security"), entity_ref("urn:test:s475:t1#y"), 120000.00 USD) { origin case_input; }
        assert "f5": us.irc.core::ends(entity_ref("urn:test:s475:t1#y"), @2024-12-31) { origin case_input; }
        assert "f6": us.irc.core::adjusted_basis(entity_ref("urn:test:s475:t1#p"), entity_ref("urn:test:s475:t1#security"), @2024-12-31, 100000.00 USD) { origin case_input; }
    }
    evaluate truth(mark_to_market_gain(entity_ref("urn:test:s475:t1#p"), entity_ref("urn:test:s475:t1#security"), entity_ref("urn:test:s475:t1#y"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S475-02-COMMODITIES-DEALER-ELECTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_dealer_in_commodities(entity_ref("urn:test:s475:t2#p")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s475:t2#p"), entity_ref("urn:test:s475:t2#y")) { origin case_input; }
        assert "f2": elects_mark_to_market_for_commodities(entity_ref("urn:test:s475:t2#p"), entity_ref("urn:test:s475:t2#y")) { origin case_input; }
    }
    evaluate truth(mark_to_market_elected_for_commodities(entity_ref("urn:test:s475:t2#p"), entity_ref("urn:test:s475:t2#y")));
    expect truth_status == TRUE_ONLY;
}

test "S475-03-TRADER-ELECTION-MARK-TO-MARKET-GAIN" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": mark_to_market_elected_for_trader(entity_ref("urn:test:s475:t3#p"), entity_ref("urn:test:s475:t3#y")) { origin case_input; }
        assert "f1": security_held_at_close_of_year(entity_ref("urn:test:s475:t3#p"), entity_ref("urn:test:s475:t3#security"), entity_ref("urn:test:s475:t3#y")) { origin case_input; }
        assert "f2": security_fair_market_value_at_year_end(entity_ref("urn:test:s475:t3#p"), entity_ref("urn:test:s475:t3#security"), entity_ref("urn:test:s475:t3#y"), 80000.00 USD) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:s475:t3#y"), @2024-12-31) { origin case_input; }
        assert "f4": us.irc.core::adjusted_basis(entity_ref("urn:test:s475:t3#p"), entity_ref("urn:test:s475:t3#security"), @2024-12-31, 95000.00 USD) { origin case_input; }
    }
    evaluate truth(mark_to_market_gain(entity_ref("urn:test:s475:t3#p"), entity_ref("urn:test:s475:t3#security"), entity_ref("urn:test:s475:t3#y"), -15000.00 USD));
    expect truth_status == TRUE_ONLY;
}
