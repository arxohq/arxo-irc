// Stage 4 scenarios: the compound growth kernel and the semiannual span helpers (module 49).
// NOT EXECUTED (implemented_unverified). Expected values are computed offline with the same rounding steps
// (12 places HALF_UP per product, whole six-month periods by add_calendar_period).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S49-01-GROWTH-FACTOR-THREE-PERIODS" {
    // (1 + 0.10)^3 = 1.331 by binary exponentiation: 11 in binary, 1.1 x 1.21.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": growth_request(0.10, 3) { origin case_input; }
    }
    evaluate truth(growth_factor(0.10, 3, 1.331));
    expect truth_status == TRUE_ONLY;
}

test "S49-02-GROWTH-FACTOR-ZERO-PERIODS-IS-ONE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": growth_request(0.10, 0) { origin case_input; }
    }
    evaluate truth(growth_factor(0.10, 0, 1.0));
    expect truth_status == TRUE_ONLY;
}

test "S49-03-GROWTH-FACTOR-FIVE-PERIODS" {
    // 101 in binary: 1.1 x 1.4641 = 1.61051.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": growth_request(0.10, 5) { origin case_input; }
    }
    evaluate truth(growth_factor(0.10, 5, 1.61051));
    expect truth_status == TRUE_ONLY;
}

test "S49-04-DAILY-STEP-OVER-A-YEAR" {
    // 365 = 101101101 in binary; each product rounded to 12 places.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": growth_request(0.0002, 365) { origin case_input; }
    }
    evaluate truth(growth_factor(0.0002, 365, 1.075722685164));
    expect truth_status == TRUE_ONLY;
}

test "S49-05-GROWTH-NOT-DEFINED-ABOVE-14-BITS" {
    // Stated bound: n above 16383 has no factor.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": growth_request(0.01, 16384) { origin case_input; }
    }
    evaluate truth(growth_factor(0.01, 16384, 1.0));
    expect truth_status == NEITHER;
}

test "S49-06-SEMIANNUAL-SPAN-FOUR-PERIODS-AND-STUB" {
    // 24 months elapsed; the stub is 2022-01-01 to 2022-03-01 = 59 days of a 181-day period.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": semiannual_span_request(@2020-01-01, @2022-03-01) { origin case_input; }
    }
    evaluate truth(semiannual_span_detail(@2020-01-01, @2022-03-01, 4, 59, 181));
    expect truth_status == TRUE_ONLY;
}

test "S49-07-SEMIANNUAL-SPAN-CAPPED-AT-FORTY" {
    // Stated bound: 20 years.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": semiannual_span_request(@2000-01-01, @2030-01-01) { origin case_input; }
    }
    evaluate truth(whole_semiannual_periods(@2000-01-01, @2030-01-01, 40));
    expect truth_status == TRUE_ONLY;
}

test "S49-08-SEMIANNUAL-FACTOR-WHOLE-PERIODS" {
    // (1 + 0.05)^2 = 1.1025, no stub.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": semiannual_factor_request(0.10, @2020-01-01, @2021-01-01) { origin case_input; }
    }
    evaluate truth(semiannual_factor(0.10, @2020-01-01, @2021-01-01, 1.1025));
    expect truth_status == TRUE_ONLY;
}

test "S49-09-SEMIANNUAL-FACTOR-WITH-STUB" {
    // One whole period 1.05, then simple interest over 92 of 184 days: 1.05 x 1.025 = 1.07625.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": semiannual_factor_request(0.10, @2020-01-01, @2020-10-01) { origin case_input; }
    }
    evaluate truth(semiannual_factor(0.10, @2020-01-01, @2020-10-01, 1.07625));
    expect truth_status == TRUE_ONLY;
}
