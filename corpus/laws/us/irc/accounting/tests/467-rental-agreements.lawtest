// Section 467 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S467-01-SECTION-467-AGREEMENT-ABOVE-THRESHOLD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": parties_to_rental_agreement_467(entity_ref("urn:test:s467:t1#lessor"), entity_ref("urn:test:s467:t1#lessee"), 1) { origin case_input; }
        assert "f1": rental_agreement_has_increasing_rent(1) { origin case_input; }
        assert "f2": aggregate_consideration_for_use_of_property_467(1, 500000.00 USD) { origin case_input; }
    }
    evaluate truth(is_section_467_rental_agreement(entity_ref("urn:test:s467:t1#lessor"), entity_ref("urn:test:s467:t1#lessee"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S467-02-BELOW-250000-THRESHOLD-NOT-A-467-AGREEMENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": parties_to_rental_agreement_467(entity_ref("urn:test:s467:t2#lessor"), entity_ref("urn:test:s467:t2#lessee"), 2) { origin case_input; }
        assert "f1": rental_agreement_has_increasing_rent(2) { origin case_input; }
        assert "f2": aggregate_consideration_for_use_of_property_467(2, 200000.00 USD) { origin case_input; }
    }
    evaluate truth(is_section_467_rental_agreement(entity_ref("urn:test:s467:t2#lessor"), entity_ref("urn:test:s467:t2#lessee"), 2));
    expect truth_status == NEITHER;
}

test "S467-03-CONSTANT-RENTAL-ACCRUAL-DISQUALIFIED-AGREEMENT-ONE-PERIOD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": parties_to_rental_agreement_467(entity_ref("urn:test:s467:t3#lessor"), entity_ref("urn:test:s467:t3#lessee"), 3) { origin case_input; }
        assert "f1": rental_agreement_has_increasing_rent(3) { origin case_input; }
        assert "f2": aggregate_consideration_for_use_of_property_467(3, 500000.00 USD) { origin case_input; }
        assert "f3": is_disqualified_leaseback_or_long_term_agreement_467(3) { origin case_input; }
        assert "f4": lease_period_coincides_with_taxable_year_467(3, entity_ref("urn:test:s467:t3#y")) { origin case_input; }
        assert "f5": constant_rental_amount_467(3, 60000.00 USD) { origin case_input; }
    }
    evaluate truth(rent_accrued_for_year_467(entity_ref("urn:test:s467:t3#lessor"), entity_ref("urn:test:s467:t3#lessee"), 3, entity_ref("urn:test:s467:t3#y"), 60000.00 USD));
    expect truth_status == TRUE_ONLY;
}
