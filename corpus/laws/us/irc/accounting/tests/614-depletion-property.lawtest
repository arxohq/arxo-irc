        assert "f4": owns_interest_in_deposit_614(entity_ref("urn:test:s614:t8#p"), 2) { origin case_input; }
        assert "f5": production_costs_taken_into_account_for_613_limit_614d(entity_ref("urn:test:s614:t8#p"), 2) { origin case_input; }
        assert "f6": interest_deposit_kind_614(2, OilAndGasWell) { origin case_input; }
        assert "f7": interest_in_tract_614(entity_ref("urn:test:s614:t8#p"), 2, 10) { origin case_input; }
    }
    evaluate truth(interests_combined_in_tract_614b1A(entity_ref("urn:test:s614:t8#p"), 1, 2));
    expect truth_status == TRUE_ONLY;
}

