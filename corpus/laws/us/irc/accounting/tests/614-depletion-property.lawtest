            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": owns_interest_in_deposit_614(entity_ref("urn:test:s614:t71#p"), 1) { origin case_input; }
        assert "f1": production_costs_taken_into_account_for_613_limit_614d(entity_ref("urn:test:s614:t71#p"), 1) { origin case_input; }
