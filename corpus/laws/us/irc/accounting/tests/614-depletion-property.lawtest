test "S614-13-CROSS-TRACT-COMBINATION-BREACHES-PROHIBITION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": owns_interest_in_deposit_614(entity_ref("urn:test:s614:t13#p"), 1) { origin case_input; }
        assert "f1": production_costs_taken_into_account_for_613_limit_614d(entity_ref("urn:test:s614:t13#p"), 1) { origin case_input; }
        assert "f2": interest_deposit_kind_614(1, OilAndGasWell) { origin case_input; }
        assert "f3": interest_in_tract_614(entity_ref("urn:test:s614:t13#p"), 1, 10) { origin case_input; }
        assert "f4": owns_interest_in_deposit_614(entity_ref("urn:test:s614:t13#p"), 2) { origin case_input; }
        assert "f5": production_costs_taken_into_account_for_613_limit_614d(entity_ref("urn:test:s614:t13#p"), 2) { origin case_input; }
        assert "f6": interest_deposit_kind_614(2, OilAndGasWell) { origin case_input; }
        assert "f7": interest_in_tract_614(entity_ref("urn:test:s614:t13#p"), 2, 11) { origin case_input; }
        assert "f8": taxpayer_combines_interests_614b1B(entity_ref("urn:test:s614:t13#p"), 1, 2) { origin case_input; }
    }
    evaluate positions();
    expect position(Section614b1BNoCrossTractCombination, VIOLATED);
}

