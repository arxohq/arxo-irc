test "S614-01-OPERATING-INTEREST-BY-SECTION-613-PRODUCTION-COSTS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": owns_interest_in_deposit_614(entity_ref("urn:test:s614:t1#p"), 1) { origin case_input; }
        assert "f1": production_costs_taken_into_account_for_613_limit_614d(entity_ref("urn:test:s614:t1#p"), 1) { origin case_input; }
    }
    evaluate truth(operating_mineral_interest_614d(entity_ref("urn:test:s614:t1#p"), 1));
    expect truth_status == TRUE_ONLY;
}

