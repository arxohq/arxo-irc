        assert "f7": interest_in_tract_614(entity_ref("urn:test:s614:t71#p"), 2, 10) { origin case_input; }
        assert "f8": owns_interest_in_deposit_614(entity_ref("urn:test:s614:t71#p"), 3) { origin case_input; }
        assert "f9": production_costs_taken_into_account_for_613_limit_614d(entity_ref("urn:test:s614:t71#p"), 3) { origin case_input; }
        assert "f10": interest_deposit_kind_614(3, OilAndGasWell) { origin case_input; }
        assert "f11": interest_in_tract_614(entity_ref("urn:test:s614:t71#p"), 3, 10) { origin case_input; }
        assert "f12": election_614b2_made_for_interest_in_tract_614b2(entity_ref("urn:test:s614:t71#p"), 10) { origin case_input; }
        assert "f13": later_interest_discovered_or_acquired_614b2(entity_ref("urn:test:s614:t71#p"), 3, 10) { origin case_input; }
        assert "f14": tract_has_combination_of_interests_614b2(entity_ref("urn:test:s614:t71#p"), 10) { origin case_input; }
    }
    evaluate truth(interests_form_one_property_614(entity_ref("urn:test:s614:t71#p"), 3, 1));
