// Accounting WIRE-9 owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "W9-ACC-01-PERSONAL-SERVICE-CORPORATION-FROM-DEDUCTIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.deductions::personal_service_corporation_441i2(entity_ref("urn:test:w9acc:a#c")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:w9acc:a#c"), entity_ref("urn:test:w9acc:a#y")) { origin case_input; }
    }
    evaluate truth(is_personal_service_corporation(entity_ref("urn:test:w9acc:a#c"), entity_ref("urn:test:w9acc:a#y")));
    expect truth_status == TRUE_ONLY;
}

test "W9-ACC-01B-DERIVED-CLASSIFICATION-LEAVES-THE-BUSINESS-PURPOSE-JUDGMENT-OPEN" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.deductions::personal_service_corporation_441i2(entity_ref("urn:test:w9acc:a2#c")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:w9acc:a2#c"), entity_ref("urn:test:w9acc:a2#y")) { origin case_input; }
    }
    evaluate truth(required_taxable_year_is_calendar_year_441i(entity_ref("urn:test:w9acc:a2#c"), entity_ref("urn:test:w9acc:a2#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}

test "W9-ACC-02-WITHOUT-THE-OWNER-FACT-THE-CLASSIFICATION-IS-NOT-ESTABLISHED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:w9acc:b#c"), entity_ref("urn:test:w9acc:b#y")) { origin case_input; }
    }
    evaluate truth(is_personal_service_corporation(entity_ref("urn:test:w9acc:b#c"), entity_ref("urn:test:w9acc:b#y")));
    expect truth_status == FALSE_ONLY;
}

test "W9-ACC-03-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_personal_service_corporation(entity_ref("urn:test:w9acc:c#c"), entity_ref("urn:test:w9acc:c#y")) { origin case_input; }
    }
    evaluate truth(required_taxable_year_is_calendar_year_441i(entity_ref("urn:test:w9acc:c#c"), entity_ref("urn:test:w9acc:c#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
