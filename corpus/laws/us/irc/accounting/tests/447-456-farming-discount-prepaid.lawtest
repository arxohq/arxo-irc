// Sections 447, 454, 455, 456 scenarios (stage 2c). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S447-01-FARMING-CORPORATION-MUST-USE-ACCRUAL" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": engaged_in_farming_447(entity_ref("urn:test:s447:t1#p")) { origin case_input; }
        assert "f1": is_corporation_447(entity_ref("urn:test:s447:t1#p")) { origin case_input; }
        assert "f2": us.irc.core::year_of(entity_ref("urn:test:s447:t1#p"), entity_ref("urn:test:s447:t1#y")) { origin case_input; }
        assert "f3": average_annual_gross_receipts_prior_3_years(entity_ref("urn:test:s447:t1#p"), entity_ref("urn:test:s447:t1#y"), 30000000 USD) { origin case_input; }
    }
    // Average receipts above the section 448(c) threshold; no S-corporation or nursery fact.
    evaluate truth(farming_accrual_method_required_447(entity_ref("urn:test:s447:t1#p"), entity_ref("urn:test:s447:t1#y")));
    expect truth_status == TRUE_ONLY;
}

