            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": dues_liability_ends_or_taxpayer_ceases_in_year(entity_ref("urn:test:s447:t42#p"), entity_ref("urn:test:s447:t42#y"), 1) { origin case_input; }
        assert "f1": prepaid_income_not_previously_included(entity_ref("urn:test:s447:t42#p"), entity_ref("urn:test:s447:t42#y"), 1, 800 USD) { origin case_input; }
    }
    evaluate truth(remaining_prepaid_dues_income_included_456b(entity_ref("urn:test:s447:t42#p"), entity_ref("urn:test:s447:t42#y"), 1, 800 USD));
    expect truth_status == TRUE_ONLY;
}

test "S447-43-DUES-TRANSITION-ADDITIONAL-AMOUNT-AND-ONE-FIFTH-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": organized_without_capital_stock(entity_ref("urn:test:s447:t43#p")) { origin case_input; }
        assert "f1": net_earnings_not_distributable_to_members(entity_ref("urn:test:s447:t43#p")) { origin case_input; }
        assert "f2": election_timely_or_consented_456(entity_ref("urn:test:s447:t43#p"), entity_ref("urn:test:s447:t43#y")) { origin case_input; }
        assert "f3": elects_prepaid_dues_deferral_456(entity_ref("urn:test:s447:t43#p"), entity_ref("urn:test:s447:t43#y")) { origin case_input; }
        assert "f4": dues_received_in_three_preceding_years_that_would_be_includible(entity_ref("urn:test:s447:t43#p"), entity_ref("urn:test:s447:t43#y"), 30000 USD) { origin case_input; }
        assert "f5": dues_additional_amount_also_included_in_prior_three_years(entity_ref("urn:test:s447:t43#p"), entity_ref("urn:test:s447:t43#y"), 20000 USD) { origin case_input; }
    }
    evaluate truth(transition_additional_dues_included_456d1(entity_ref("urn:test:s447:t43#p"), entity_ref("urn:test:s447:t43#y"), 30000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(transition_dues_deduction_per_year(entity_ref("urn:test:s447:t43#p"), entity_ref("urn:test:s447:t43#y"), 4000 USD));
    expect truth_status == TRUE_ONLY;
}
