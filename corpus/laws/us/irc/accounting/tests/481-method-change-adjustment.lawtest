// Section 481 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S481-01-METHOD-CHANGE-TRIGGERS-ADJUSTMENT-REQUIREMENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": changes_method_of_accounting_481(entity_ref("urn:test:s481:t1#p"), entity_ref("urn:test:s481:t1#y")) { origin case_input; }
    }
    evaluate truth(section_481_adjustment_required(entity_ref("urn:test:s481:t1#p"), entity_ref("urn:test:s481:t1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S481-02-ADJUSTMENT-OVER-3000-WITH-2-PRIOR-YEARS-ELIGIBLE-FOR-ALLOCATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": same_method_for_2_preceding_years(entity_ref("urn:test:s481:t2#p"), entity_ref("urn:test:s481:t2#y")) { origin case_input; }
        assert "f1": section_481a_adjustment_amount(entity_ref("urn:test:s481:t2#p"), entity_ref("urn:test:s481:t2#y"), 9000 USD) { origin case_input; }
    }
    evaluate truth(section_481b_three_year_allocation_eligible(entity_ref("urn:test:s481:t2#p"), entity_ref("urn:test:s481:t2#y")));
    expect truth_status == TRUE_ONLY;
}

test "S481-03-ADJUSTMENT-AT-3000-BOUNDARY-NOT-OVER-NOT-ELIGIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": same_method_for_2_preceding_years(entity_ref("urn:test:s481:t3#p"), entity_ref("urn:test:s481:t3#y")) { origin case_input; }
        // Exactly $3,000: the statute requires the increase to EXCEED $3,000.
        assert "f1": section_481a_adjustment_amount(entity_ref("urn:test:s481:t3#p"), entity_ref("urn:test:s481:t3#y"), 3000 USD) { origin case_input; }
    }
    evaluate truth(section_481b_three_year_allocation_eligible(entity_ref("urn:test:s481:t3#p"), entity_ref("urn:test:s481:t3#y")));
    expect truth_status == FALSE_ONLY;
}

test "S481-04-NO-2-PRIOR-YEARS-SAME-METHOD-NOT-ELIGIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_481a_adjustment_amount(entity_ref("urn:test:s481:t4#p"), entity_ref("urn:test:s481:t4#y"), 9000 USD) { origin case_input; }
        // same_method_for_2_preceding_years not asserted.
    }
    evaluate truth(section_481b_three_year_allocation_eligible(entity_ref("urn:test:s481:t4#p"), entity_ref("urn:test:s481:t4#y")));
    expect truth_status == FALSE_ONLY;
}
