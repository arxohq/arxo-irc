// Sections 482 and 483 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S482-01-ALLOCATION-VALID-WHEN-NECESSARY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": commonly_owned_or_controlled_482(entity_ref("urn:test:s482:t1#a"), entity_ref("urn:test:s482:t1#b")) { origin case_input; }
        assert "f1": section_482_allocation_amount(entity_ref("urn:test:s482:t1#a"), entity_ref("urn:test:s482:t1#b"), entity_ref("urn:test:s482:t1#y"), 1, 50000.00 USD) { origin case_input; }
        assert "f2": allocation_necessary_482(entity_ref("urn:test:s482:t1#a"), entity_ref("urn:test:s482:t1#b"), entity_ref("urn:test:s482:t1#y")) { origin adjudicated; }
    }
    evaluate truth(section_482_allocation_in_effect(entity_ref("urn:test:s482:t1#a"), entity_ref("urn:test:s482:t1#b"), entity_ref("urn:test:s482:t1#y"), 1, 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S482-02-COMMENSURATE-WITH-INCOME-INTANGIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": intangible_property_transfer_or_license_482b(entity_ref("urn:test:s482:t2#a"), entity_ref("urn:test:s482:t2#b"), entity_ref("urn:test:s482:t2#y"), 1) { origin case_input; }
        assert "f1": income_attributable_to_intangible_482b(entity_ref("urn:test:s482:t2#a"), entity_ref("urn:test:s482:t2#b"), entity_ref("urn:test:s482:t2#y"), 1, 200000.00 USD) { origin case_input; }
    }
    evaluate truth(income_commensurate_with_intangible_required_482b(entity_ref("urn:test:s482:t2#a"), entity_ref("urn:test:s482:t2#b"), entity_ref("urn:test:s482:t2#y"), 1, 200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S483-01-TOTAL-UNSTATED-INTEREST-AND-IMPUTED-INTEREST" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": deferred_payment_sale_or_exchange_483(entity_ref("urn:test:s483:t1#seller"), entity_ref("urn:test:s483:t1#buyer"), 1, entity_ref("urn:test:s483:t1#y")) { origin case_input; }
        assert "f1": payments_due_under_contract_483(entity_ref("urn:test:s483:t1#seller"), entity_ref("urn:test:s483:t1#buyer"), 1, 120000.00 USD) { origin case_input; }
        assert "f2": present_value_of_payments_483(entity_ref("urn:test:s483:t1#seller"), entity_ref("urn:test:s483:t1#buyer"), 1, 100000.00 USD) { origin case_input; }
        assert "f3": sales_price_exceeds_three_thousand_483(entity_ref("urn:test:s483:t1#seller"), entity_ref("urn:test:s483:t1#buyer"), 1) { origin case_input; }
        assert "f5": payment_due_more_than_six_months_after_sale_483(entity_ref("urn:test:s483:t1#seller"), entity_ref("urn:test:s483:t1#buyer"), 1, 1) { origin case_input; }
        assert "f6": unstated_interest_allocable_to_payment_483(entity_ref("urn:test:s483:t1#seller"), entity_ref("urn:test:s483:t1#buyer"), 1, 1, 20000.00 USD) { origin case_input; }
    }
    // total unstated interest = 120,000 - 100,000 = 20,000.
    evaluate truth(total_unstated_interest_483(entity_ref("urn:test:s483:t1#seller"), entity_ref("urn:test:s483:t1#buyer"), 1, 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S483-02-QUALIFIED-LAND-SALE-WITHIN-SAFE-HARBOR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_qualified_land_sale_483e(entity_ref("urn:test:s483:t2#seller"), entity_ref("urn:test:s483:t2#buyer"), 2) { origin case_input; }
        assert "f1": aggregate_qualified_sales_price_for_calendar_year_483e(entity_ref("urn:test:s483:t2#seller"), entity_ref("urn:test:s483:t2#buyer"), 2, 300000.00 USD) { origin case_input; }
    }
    evaluate truth(six_percent_cap_applies_483e(entity_ref("urn:test:s483:t2#seller"), entity_ref("urn:test:s483:t2#buyer"), 2));
    expect truth_status == TRUE_ONLY;
}
