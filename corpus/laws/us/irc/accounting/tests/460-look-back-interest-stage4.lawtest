        }
        assert "f0": amount_taken_into_account_after_completion_460b2(entity_ref("urn:test:s460b:t10#p"), 1, 7, @2023-01-01, 10000 USD) { origin case_input; }
        assert "f1": contract_completion_date_460c3B(1, @2021-01-01) { origin case_input; }
