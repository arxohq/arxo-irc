// Section 460(b)(2), (b)(5)(D)(ii): look-back interest scenarios (module 50). NOT EXECUTED.
// Expected values computed offline with the same rounding (daily step = rate / 365 rounded to 12 places,
// balance rounded to cents at the end of each accrual period).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";


test "S460-01-LOOK-BACK-INTEREST-OVER-THREE-ACCRUAL-PERIODS" {
    // Amounts: +1000 (first year), +500, none (zero). Rates 3%, 5%, 7% for the three accrual periods; the last period ends at completion (47 days).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": preceding_taxable_year_465(entity_ref("urn:test:s460b:t1#y0"), entity_ref("urn:test:s460b:t1#y1")) { origin case_input; }
        assert "f1": preceding_taxable_year_465(entity_ref("urn:test:s460b:t1#y1"), entity_ref("urn:test:s460b:t1#y2")) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s460b:t1#y2"), entity_ref("urn:test:s460b:t1#y3")) { origin case_input; }
        assert "f3": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t1#p"), entity_ref("urn:test:s460b:t1#y0"), @2021-04-15) { origin case_input; }
        assert "f4": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t1#p"), entity_ref("urn:test:s460b:t1#y1"), @2022-04-15) { origin case_input; }
        assert "f5": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t1#p"), entity_ref("urn:test:s460b:t1#y2"), @2023-04-15) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t1#p"), entity_ref("urn:test:s460b:t1#y3"), @2024-04-15) { origin case_input; }
        assert "f7": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2021-04-16, 0.03) { origin case_input; }
        assert "f8": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2022-04-16, 0.05) { origin case_input; }
        assert "f9": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2023-04-16, 0.07) { origin case_input; }
        assert "f10": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2024-04-16, 0.09) { origin case_input; }
        assert "f11": look_back_first_year_460b2(entity_ref("urn:test:s460b:t1#p"), 1, entity_ref("urn:test:s460b:t1#y0")) { origin case_input; }
        assert "f12": contract_completion_date_460c3B(1, @2023-06-01) { origin case_input; }
        assert "f13": look_back_tax_change_460b2B(entity_ref("urn:test:s460b:t1#p"), 1, entity_ref("urn:test:s460b:t1#y0"), 1000 USD) { origin case_input; }
        assert "f14": look_back_tax_change_460b2B(entity_ref("urn:test:s460b:t1#p"), 1, entity_ref("urn:test:s460b:t1#y1"), 500 USD) { origin case_input; }
    }
    evaluate truth(look_back_interest_460b2C(entity_ref("urn:test:s460b:t1#p"), 1, 123.48 USD));
    expect truth_status == TRUE_ONLY;
}

test "S460-02-LOOK-BACK-INTEREST-PAYABLE-WHEN-POSITIVE" {
    // A positive net interest is payable (section 460(b)(1)(B)).
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": preceding_taxable_year_465(entity_ref("urn:test:s460b:t2#y0"), entity_ref("urn:test:s460b:t2#y1")) { origin case_input; }
        assert "f1": preceding_taxable_year_465(entity_ref("urn:test:s460b:t2#y1"), entity_ref("urn:test:s460b:t2#y2")) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s460b:t2#y2"), entity_ref("urn:test:s460b:t2#y3")) { origin case_input; }
        assert "f3": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t2#p"), entity_ref("urn:test:s460b:t2#y0"), @2021-04-15) { origin case_input; }
        assert "f4": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t2#p"), entity_ref("urn:test:s460b:t2#y1"), @2022-04-15) { origin case_input; }
        assert "f5": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t2#p"), entity_ref("urn:test:s460b:t2#y2"), @2023-04-15) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t2#p"), entity_ref("urn:test:s460b:t2#y3"), @2024-04-15) { origin case_input; }
        assert "f7": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2021-04-16, 0.03) { origin case_input; }
        assert "f8": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2022-04-16, 0.05) { origin case_input; }
        assert "f9": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2023-04-16, 0.07) { origin case_input; }
        assert "f10": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2024-04-16, 0.09) { origin case_input; }
        assert "f11": look_back_first_year_460b2(entity_ref("urn:test:s460b:t2#p"), 1, entity_ref("urn:test:s460b:t2#y0")) { origin case_input; }
        assert "f12": contract_completion_date_460c3B(1, @2023-06-01) { origin case_input; }
        assert "f13": look_back_tax_change_460b2B(entity_ref("urn:test:s460b:t2#p"), 1, entity_ref("urn:test:s460b:t2#y0"), 1000 USD) { origin case_input; }
        assert "f14": look_back_tax_change_460b2B(entity_ref("urn:test:s460b:t2#p"), 1, entity_ref("urn:test:s460b:t2#y1"), 500 USD) { origin case_input; }
    }
    evaluate truth(look_back_interest_payable_460b1B(entity_ref("urn:test:s460b:t2#p"), 1, 123.48 USD));
    expect truth_status == TRUE_ONLY;
}

test "S460-03-COMPLETION-INSIDE-THE-FIRST-ACCRUAL-PERIOD" {
    // 260 days from the return due date to completion at 3%.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": preceding_taxable_year_465(entity_ref("urn:test:s460b:t3#y0"), entity_ref("urn:test:s460b:t3#y1")) { origin case_input; }
        assert "f1": preceding_taxable_year_465(entity_ref("urn:test:s460b:t3#y1"), entity_ref("urn:test:s460b:t3#y2")) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s460b:t3#y2"), entity_ref("urn:test:s460b:t3#y3")) { origin case_input; }
        assert "f3": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t3#p"), entity_ref("urn:test:s460b:t3#y0"), @2021-04-15) { origin case_input; }
        assert "f4": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t3#p"), entity_ref("urn:test:s460b:t3#y1"), @2022-04-15) { origin case_input; }
        assert "f5": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t3#p"), entity_ref("urn:test:s460b:t3#y2"), @2023-04-15) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t3#p"), entity_ref("urn:test:s460b:t3#y3"), @2024-04-15) { origin case_input; }
        assert "f7": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2021-04-16, 0.03) { origin case_input; }
        assert "f8": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2022-04-16, 0.05) { origin case_input; }
        assert "f9": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2023-04-16, 0.07) { origin case_input; }
        assert "f10": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2024-04-16, 0.09) { origin case_input; }
        assert "f11": look_back_first_year_460b2(entity_ref("urn:test:s460b:t3#p"), 1, entity_ref("urn:test:s460b:t3#y0")) { origin case_input; }
        assert "f12": contract_completion_date_460c3B(1, @2021-12-31) { origin case_input; }
        assert "f13": look_back_tax_change_460b2B(entity_ref("urn:test:s460b:t3#p"), 1, entity_ref("urn:test:s460b:t3#y0"), 2000 USD) { origin case_input; }
    }
    evaluate truth(look_back_interest_460b2C(entity_ref("urn:test:s460b:t3#p"), 1, 43.20 USD));
    expect truth_status == TRUE_ONLY;
}

test "S460-04-OVERPAYMENT-GIVES-INTEREST-RECEIVABLE" {
    // A pass-thru overpayment of the year enters the chain as -800; the net interest is negative, so the taxpayer is entitled to receive it.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": preceding_taxable_year_465(entity_ref("urn:test:s460b:t4#y0"), entity_ref("urn:test:s460b:t4#y1")) { origin case_input; }
        assert "f1": preceding_taxable_year_465(entity_ref("urn:test:s460b:t4#y1"), entity_ref("urn:test:s460b:t4#y2")) { origin case_input; }
        assert "f2": preceding_taxable_year_465(entity_ref("urn:test:s460b:t4#y2"), entity_ref("urn:test:s460b:t4#y3")) { origin case_input; }
        assert "f3": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t4#p"), entity_ref("urn:test:s460b:t4#y0"), @2021-04-15) { origin case_input; }
        assert "f4": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t4#p"), entity_ref("urn:test:s460b:t4#y1"), @2022-04-15) { origin case_input; }
        assert "f5": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t4#p"), entity_ref("urn:test:s460b:t4#y2"), @2023-04-15) { origin case_input; }
        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t4#p"), entity_ref("urn:test:s460b:t4#y3"), @2024-04-15) { origin case_input; }
        assert "f7": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2021-04-16, 0.03) { origin case_input; }
        assert "f8": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2022-04-16, 0.05) { origin case_input; }
        assert "f9": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2023-04-16, 0.07) { origin case_input; }
        assert "f10": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2024-04-16, 0.09) { origin case_input; }
        assert "f11": look_back_first_year_460b2(entity_ref("urn:test:s460b:t4#p"), 1, entity_ref("urn:test:s460b:t4#y0")) { origin case_input; }
        assert "f12": contract_completion_date_460c3B(1, @2021-12-31) { origin case_input; }
        assert "f13": look_back_overpayment_460b4Aii(entity_ref("urn:test:s460b:t4#p"), 1, entity_ref("urn:test:s460b:t4#y0"), 800 USD) { origin case_input; }
    }
    evaluate truth(look_back_interest_receivable_460b1B(entity_ref("urn:test:s460b:t4#p"), 1, 17.28 USD));
    expect truth_status == TRUE_ONLY;
}

test "S460-05-SMALL-SHORT-CONTRACT-EXCLUDED-NO-INTEREST" {
    // Section 460(b)(3)(B) excludes the contract: no interest is derived.
