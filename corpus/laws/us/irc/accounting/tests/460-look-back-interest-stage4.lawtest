    expect truth_status == TRUE_ONLY;
}

test "S460-09-POST-COMPLETION-AMOUNT-DISCOUNTED-AT-MID-TERM-RATE" {
    // 4 semiannual periods at 2%: factor 1.02^4 = 1.08243216; 10000 / factor rounded to cents.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": amount_taken_into_account_after_completion_460b2(entity_ref("urn:test:s460b:t9#p"), 1, 7, @2023-01-01, 10000 USD) { origin case_input; }
        assert "f1": contract_completion_date_460c3B(1, @2021-01-01) { origin case_input; }
        assert "f2": federal_mid_term_rate_as_of_460b2(@2023-01-01, 0.04) { origin case_input; }
    }
    evaluate truth(discounted_post_completion_amount_460b2(entity_ref("urn:test:s460b:t9#p"), 1, 7, 9238.45 USD));
    expect truth_status == TRUE_ONLY;
}

test "S460-10-ELECTION-OUT-OF-DISCOUNTING-KEEPS-FACE-VALUE" {
    // The election of section 460(b)(2), last sentence.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
