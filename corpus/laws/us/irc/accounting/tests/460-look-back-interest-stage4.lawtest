    expect truth_status == TRUE_ONLY;
}

test "S460-07-TEN-PERCENT-METHOD-LOOK-BACK-INCOME-ZERO-BEFORE-TEN-PERCENT-YEAR" {
    // Section 460(b)(5)(D)(ii): the 10-percent method is taken into account in the look-back; before the 10-percent year nothing is taken into account.
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": ten_percent_method_applies_to_contract_460b5C(entity_ref("urn:test:s460b:t7#p"), 1) { origin case_input; }
        assert "f1": ten_percent_year_460b5Bii(entity_ref("urn:test:s460b:t7#p"), 1, entity_ref("urn:test:s460b:t7#y1")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s460b:t7#y1"), @2021-01-01) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s460b:t7#y0"), @2020-01-01) { origin case_input; }
        assert "f4": look_back_cumulative_income_460b2A(entity_ref("urn:test:s460b:t7#p"), 1, entity_ref("urn:test:s460b:t7#y0"), 700 USD) { origin case_input; }
    }
    evaluate truth(look_back_cumulative_income_ten_percent_460b5Dii(entity_ref("urn:test:s460b:t7#p"), 1, entity_ref("urn:test:s460b:t7#y0"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

