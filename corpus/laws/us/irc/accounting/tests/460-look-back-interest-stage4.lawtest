        assert "f6": return_due_date_without_extensions_460b7B(entity_ref("urn:test:s460b:t5#p"), entity_ref("urn:test:s460b:t5#y3"), @2024-04-15) { origin case_input; }
        assert "f7": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2021-04-16, 0.03) { origin case_input; }
        assert "f8": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2022-04-16, 0.05) { origin case_input; }
        assert "f9": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2023-04-16, 0.07) { origin case_input; }
        assert "f10": overpayment_rate_in_effect_for_quarter_containing_460b7A(@2024-04-16, 0.09) { origin case_input; }
        assert "f11": look_back_first_year_460b2(entity_ref("urn:test:s460b:t5#p"), 1, entity_ref("urn:test:s460b:t5#y0")) { origin case_input; }
        assert "f12": contract_completion_date_460c3B(1, @2021-12-31) { origin case_input; }
        assert "f13": look_back_tax_change_460b2B(entity_ref("urn:test:s460b:t5#p"), 1, entity_ref("urn:test:s460b:t5#y0"), 2000 USD) { origin case_input; }
        assert "f14": look_back_not_applicable_460b3B(entity_ref("urn:test:s460b:t5#p"), 1) { origin case_input; }
    }
    evaluate truth(look_back_interest_460b2C(entity_ref("urn:test:s460b:t5#p"), 1, 43.20 USD));
    expect truth_status == NEITHER;
}

test "S460-06-NO-CHANGE-FOR-THE-MIDDLE-YEAR-COUNTS-ZERO" {
