// Sections 611, 612, 613, 613A scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF: written from the pinned statutory text, not from the
// engine's output).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S613-01-GOLD-MINE-PERCENTAGE-DEPLETION-WITHIN-LIMIT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": mineral_name_of(entity_ref("urn:test:s613:t1#property"), "Gold") { origin case_input; }
        assert "f1": gross_income_from_the_property(entity_ref("urn:test:s613:t1#p"), entity_ref("urn:test:s613:t1#property"), entity_ref("urn:test:s613:t1#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": rents_or_royalties_paid_re_property(entity_ref("urn:test:s613:t1#p"), entity_ref("urn:test:s613:t1#property"), entity_ref("urn:test:s613:t1#y"), 0.00 USD) { origin case_input; }
        assert "f3": taxable_income_from_the_property_before_depletion(entity_ref("urn:test:s613:t1#p"), entity_ref("urn:test:s613:t1#property"), entity_ref("urn:test:s613:t1#y"), 800000.00 USD) { origin case_input; }
    }
    // 15% of $1,000,000 = $150,000 tentative; 50% of $800,000 = $400,000 limit — tentative governs.
    evaluate truth(percentage_depletion_allowance(entity_ref("urn:test:s613:t1#p"), entity_ref("urn:test:s613:t1#property"), entity_ref("urn:test:s613:t1#y"), 150000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S613-02-CATCH-ALL-MINERAL-CAPPED-AT-FIFTY-PERCENT-TAXABLE-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": mineral_name_of(entity_ref("urn:test:s613:t2#property"), "Feldspar") { origin case_input; }
        assert "f1": gross_income_from_the_property(entity_ref("urn:test:s613:t2#p"), entity_ref("urn:test:s613:t2#property"), entity_ref("urn:test:s613:t2#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": rents_or_royalties_paid_re_property(entity_ref("urn:test:s613:t2#p"), entity_ref("urn:test:s613:t2#property"), entity_ref("urn:test:s613:t2#y"), 0.00 USD) { origin case_input; }
        assert "f3": taxable_income_from_the_property_before_depletion(entity_ref("urn:test:s613:t2#p"), entity_ref("urn:test:s613:t2#property"), entity_ref("urn:test:s613:t2#y"), 100000.00 USD) { origin case_input; }
    }
    // Feldspar -> catch-all 14% of $1,000,000 = $140,000 tentative; 50% of $100,000 = $50,000 limit governs.
    evaluate truth(percentage_depletion_allowance(entity_ref("urn:test:s613:t2#p"), entity_ref("urn:test:s613:t2#property"), entity_ref("urn:test:s613:t2#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S613-03-DEPLETION-DEDUCTION-IS-GREATER-OF-COST-OR-PERCENTAGE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": mineral_name_of(entity_ref("urn:test:s613:t3#property"), "Coal") { origin case_input; }
        assert "f1": gross_income_from_the_property(entity_ref("urn:test:s613:t3#p"), entity_ref("urn:test:s613:t3#property"), entity_ref("urn:test:s613:t3#y"), 500000.00 USD) { origin case_input; }
        assert "f2": rents_or_royalties_paid_re_property(entity_ref("urn:test:s613:t3#p"), entity_ref("urn:test:s613:t3#property"), entity_ref("urn:test:s613:t3#y"), 0.00 USD) { origin case_input; }
        assert "f3": taxable_income_from_the_property_before_depletion(entity_ref("urn:test:s613:t3#p"), entity_ref("urn:test:s613:t3#property"), entity_ref("urn:test:s613:t3#y"), 1000000.00 USD) { origin case_input; }
        // 10% of $500,000 = $50,000 percentage depletion; cost depletion exceeds it.
        assert "f5": cost_depletion_allowance(entity_ref("urn:test:s613:t3#p"), entity_ref("urn:test:s613:t3#property"), entity_ref("urn:test:s613:t3#y"), 70000.00 USD) { origin case_input; }
    }
    evaluate truth(depletion_deduction(entity_ref("urn:test:s613:t3#p"), entity_ref("urn:test:s613:t3#property"), entity_ref("urn:test:s613:t3#y"), 70000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S613A-01-INDEPENDENT-PRODUCER-EXEMPTION-WITHIN-QUANTITY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_independent_producer_or_royalty_owner(entity_ref("urn:test:s613a:t1#p"), entity_ref("urn:test:s613a:t1#y")) { origin case_input; }
        assert "f1": average_daily_domestic_crude_oil_production(entity_ref("urn:test:s613a:t1#p"), entity_ref("urn:test:s613a:t1#y"), 500.0) { origin case_input; }
        assert "f2": is_oil_or_gas_property(entity_ref("urn:test:s613a:t1#p"), entity_ref("urn:test:s613a:t1#property")) { origin case_input; }
        assert "f3": gross_income_from_the_property(entity_ref("urn:test:s613a:t1#p"), entity_ref("urn:test:s613a:t1#property"), entity_ref("urn:test:s613a:t1#y"), 2000000.00 USD) { origin case_input; }
        assert "f4": rents_or_royalties_paid_re_property(entity_ref("urn:test:s613a:t1#p"), entity_ref("urn:test:s613a:t1#property"), entity_ref("urn:test:s613a:t1#y"), 0.00 USD) { origin case_input; }
        assert "f5": taxable_income_from_the_property_before_depletion(entity_ref("urn:test:s613a:t1#p"), entity_ref("urn:test:s613a:t1#property"), entity_ref("urn:test:s613a:t1#y"), 5000000.00 USD) { origin case_input; }
    }
    // 500 barrels/day <= 1,000 depletable quantity -> 15% rate applies.
    // 15% of $2,000,000 = $300,000 tentative; 100% of $5,000,000 = $5,000,000 limit -> tentative governs.
    evaluate truth(percentage_depletion_allowance(entity_ref("urn:test:s613a:t1#p"), entity_ref("urn:test:s613a:t1#property"), entity_ref("urn:test:s613a:t1#y"), 300000.00 USD));
    expect truth_status == TRUE_ONLY;
}

