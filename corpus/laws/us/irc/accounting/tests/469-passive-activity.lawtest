// Section 469 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S469-01-TRADE-OR-BUSINESS-NOT-MATERIALLY-PARTICIPATED-IS-PASSIVE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": conducts_trade_or_business_activity(entity_ref("urn:test:s469:t1#p"), 1) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s469:t1#p"), entity_ref("urn:test:s469:t1#y")) { origin case_input; }
    }
    // No answer on material participation — DECISION-0194: absence of the
    // judgment does not itself make the activity passive; "not materially_
    // participates" in the rule body reads as NOT (established); without any
    // assertion the judgment relation is NEITHER, so the defeasible rule's
    // negative check does not fire either way and the activity's passive
    // status stays UNDETERMINED given the open judgment request.
    evaluate truth(is_passive_activity(entity_ref("urn:test:s469:t1#p"), 1, entity_ref("urn:test:s469:t1#y")));
    expect truth_status == NEITHER;
}

test "S469-02-MATERIALLY-PARTICIPATES-NOT-PASSIVE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": conducts_trade_or_business_activity(entity_ref("urn:test:s469:t2#p"), 1) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s469:t2#p"), entity_ref("urn:test:s469:t2#y")) { origin case_input; }
        assert "f2": materially_participates_469(entity_ref("urn:test:s469:t2#p"), 1, entity_ref("urn:test:s469:t2#y")) { origin adjudicated; }
    }
    evaluate truth(is_passive_activity(entity_ref("urn:test:s469:t2#p"), 1, entity_ref("urn:test:s469:t2#y")));
    expect truth_status == FALSE_ONLY;
}

test "S469-03-RENTAL-ACTIVITY-PASSIVE-REGARDLESS-OF-PARTICIPATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_rental_activity(entity_ref("urn:test:s469:t3#p"), 1) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s469:t3#p"), entity_ref("urn:test:s469:t3#y")) { origin case_input; }
    }
    evaluate truth(is_passive_activity(entity_ref("urn:test:s469:t3#p"), 1, entity_ref("urn:test:s469:t3#y")));
    expect truth_status == TRUE_ONLY;
}

test "S469-04-PAL-DISALLOWED-AND-CARRIED-TO-NEXT-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_469a_person(entity_ref("urn:test:s469:t4#p")) { origin case_input; }
        assert "f1": aggregate_passive_activity_losses(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 40000 USD) { origin case_input; }
        assert "f2": aggregate_passive_activity_income(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 10000 USD) { origin case_input; }
        assert "f3": actively_participates_in_rental_real_estate(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1")) { origin case_input; }
        assert "f4": passive_loss_attributable_to_active_rental_real_estate(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 0.00 USD) { origin case_input; }
        assert "f5": adjusted_gross_income_469i(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 90000 USD) { origin case_input; }
    }
    // PAL = 40,000 - 10,000 = 30,000; offset = min(0, 25,000) = 0; disallowed = 30,000.
    evaluate truth(passive_activity_loss_disallowed(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 30000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S469-04B-PAL-CARRYOVER-TO-YEAR-2" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_469a_person(entity_ref("urn:test:s469:t4#p")) { origin case_input; }
        assert "f1": aggregate_passive_activity_losses(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 40000 USD) { origin case_input; }
        assert "f2": aggregate_passive_activity_income(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 10000 USD) { origin case_input; }
        assert "f3": actively_participates_in_rental_real_estate(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1")) { origin case_input; }
        assert "f4": passive_loss_attributable_to_active_rental_real_estate(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 0.00 USD) { origin case_input; }
        assert "f5": adjusted_gross_income_469i(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 90000 USD) { origin case_input; }
    }
    // The $30,000 disallowed in year 1 carries to year 2 as a section 469(b)
    // deduction allocable to the same activity (this package does not model
    // year-2's re-aggregation into that year's own PAL computation).
    evaluate truth(passive_activity_loss_carryover_to_next_year(entity_ref("urn:test:s469:t4#p"), entity_ref("urn:test:s469:t4#y1"), 30000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S469-05-25000-OFFSET-BELOW-AGI-THRESHOLD-FULL-AMOUNT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": actively_participates_in_rental_real_estate(entity_ref("urn:test:s469:t5#p"), entity_ref("urn:test:s469:t5#y")) { origin case_input; }
        assert "f1": adjusted_gross_income_469i(entity_ref("urn:test:s469:t5#p"), entity_ref("urn:test:s469:t5#y"), 80000 USD) { origin case_input; }
    }
    // AGI $80,000 <= $100,000 threshold: full $25,000 ceiling.
    evaluate truth(section_469i_dollar_limit(entity_ref("urn:test:s469:t5#p"), entity_ref("urn:test:s469:t5#y"), 25000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S469-06-25000-OFFSET-AT-125000-AGI-HALF-PHASED-OUT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": actively_participates_in_rental_real_estate(entity_ref("urn:test:s469:t6#p"), entity_ref("urn:test:s469:t6#y")) { origin case_input; }
        assert "f1": adjusted_gross_income_469i(entity_ref("urn:test:s469:t6#p"), entity_ref("urn:test:s469:t6#y"), 125000 USD) { origin case_input; }
    }
    // $25,000 - 50% * ($125,000 - $100,000) = $25,000 - $12,500 = $12,500.
    evaluate truth(section_469i_dollar_limit(entity_ref("urn:test:s469:t6#p"), entity_ref("urn:test:s469:t6#y"), 12500 USD));
    expect truth_status == TRUE_ONLY;
}

