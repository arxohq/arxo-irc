            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": aggregate_face_amount_of_years_obligations(entity_ref("urn:test:s44:t1#p"), entity_ref("urn:test:s44:t1#y"), 3000000 USD) { origin case_input; }
    }
    evaluate truth(single_employer_group_member_453Ab2(entity_ref("urn:test:s44:t1#p"), entity_ref("urn:test:s44:t1#p")));
    expect truth_status == TRUE_ONLY;
}

