// Section 472 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S472-01-LIFO-ELECTION-VALID-CONFORMING" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applies_to_expense_specified_goods(entity_ref("urn:test:s472:t1#p"), 1) { origin case_input; }
        assert "f1": elects_lifo_method(entity_ref("urn:test:s472:t1#p"), 1) { origin case_input; }
        assert "f2": used_no_other_procedure_than_472b1_and_3(entity_ref("urn:test:s472:t1#p"), 1) { origin case_input; }
    }
    evaluate truth(lifo_method_in_effect(entity_ref("urn:test:s472:t1#p"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S472-02-LIFO-ELECTION-INVALID-NONCONFORMING-BOOKS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applies_to_expense_specified_goods(entity_ref("urn:test:s472:t2#p"), 1) { origin case_input; }
        assert "f1": elects_lifo_method(entity_ref("urn:test:s472:t2#p"), 1) { origin case_input; }
        // used_no_other_procedure_than_472b1_and_3 not asserted (the
        // taxpayer used a different procedure for a shareholder report):
        // POWER_INVALID_EXERCISE under the section 472(c) conformity condition.
    }
    evaluate truth(lifo_method_in_effect(entity_ref("urn:test:s472:t2#p"), 1));
    expect truth_status == FALSE_ONLY;
}

test "S472-03-LIFO-MECHANICS-FOLLOW-ONCE-IN-EFFECT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applies_to_expense_specified_goods(entity_ref("urn:test:s472:t3#p"), 1) { origin case_input; }
        assert "f1": elects_lifo_method(entity_ref("urn:test:s472:t3#p"), 1) { origin case_input; }
        assert "f2": used_no_other_procedure_than_472b1_and_3(entity_ref("urn:test:s472:t3#p"), 1) { origin case_input; }
    }
    evaluate truth(lifo_inventoried_at_cost(entity_ref("urn:test:s472:t3#p"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S472-04-LIFO-CONTINUES-ABSENT-AUTHORIZED-CHANGE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applies_to_expense_specified_goods(entity_ref("urn:test:s472:t4#p"), 1) { origin case_input; }
        assert "f1": elects_lifo_method(entity_ref("urn:test:s472:t4#p"), 1) { origin case_input; }
        assert "f2": used_no_other_procedure_than_472b1_and_3(entity_ref("urn:test:s472:t4#p"), 1) { origin case_input; }
    }
    evaluate truth(lifo_method_continues_in_effect(entity_ref("urn:test:s472:t4#p"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S472-05-LIFO-CHANGE-AUTHORIZED-BY-SECRETARY-DOES-NOT-CONTINUE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applies_to_expense_specified_goods(entity_ref("urn:test:s472:t5#p"), 1) { origin case_input; }
        assert "f1": elects_lifo_method(entity_ref("urn:test:s472:t5#p"), 1) { origin case_input; }
        assert "f2": used_no_other_procedure_than_472b1_and_3(entity_ref("urn:test:s472:t5#p"), 1) { origin case_input; }
        assert "f3": secretary_approves_change_from_lifo(entity_ref("urn:test:s472:t5#p"), 1) { origin case_input; }
    }
    evaluate truth(lifo_method_continues_in_effect(entity_ref("urn:test:s472:t5#p"), 1));
    expect truth_status == FALSE_ONLY;
}
