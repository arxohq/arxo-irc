test "S465B-01-FILM-IS-A-SEPARATE-ACTIVITY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": engaged_in_activity_for_465(entity_ref("urn:test:s465b:t1#p"), 1) { origin case_input; }
        assert "f1": activity_type_465(1, MotionPictureOrVideoTape) { origin case_input; }
    }
    evaluate truth(separate_activity_465c2A(entity_ref("urn:test:s465b:t1#p"), 1));
    expect truth_status == TRUE_ONLY;
}

