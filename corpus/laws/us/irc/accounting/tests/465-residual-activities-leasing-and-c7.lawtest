            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": controlled_group_year_465(5, entity_ref("urn:test:s465b:t18#y")) { origin case_input; }
        assert "f1": controlled_group_member_465(entity_ref("urn:test:s465b:t18#a"), 5, entity_ref("urn:test:s465b:t18#y")) { origin case_input; }
        assert "f2": controlled_group_member_465(entity_ref("urn:test:s465b:t18#b"), 5, entity_ref("urn:test:s465b:t18#y")) { origin case_input; }
        assert "f3": member_equipment_leasing_receipts_465(entity_ref("urn:test:s465b:t18#a"), 5, entity_ref("urn:test:s465b:t18#y"), 300000 USD) { origin case_input; }
        assert "f4": member_total_gross_receipts_465(entity_ref("urn:test:s465b:t18#a"), 5, entity_ref("urn:test:s465b:t18#y"), 500000 USD) { origin case_input; }
        assert "f5": member_equipment_leasing_receipts_465(entity_ref("urn:test:s465b:t18#b"), 5, entity_ref("urn:test:s465b:t18#y"), 200000 USD) { origin case_input; }
        assert "f6": member_total_gross_receipts_465(entity_ref("urn:test:s465b:t18#b"), 5, entity_ref("urn:test:s465b:t18#y"), 900000 USD) { origin case_input; }
    }
    evaluate truth(group_equipment_leasing_receipts_465(5, entity_ref("urn:test:s465b:t18#y"), 500000 USD));
    expect truth_status == TRUE_ONLY;
}

