// Section 444 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S444-01-ELECTION-VALID-WITHIN-THREE-MONTH-DEFERRAL" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_partnership_or_s_corp_or_psc_444(entity_ref("urn:test:s444:t1#filer")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s444:t1#filer"), entity_ref("urn:test:s444:t1#y")) { origin case_input; }
        assert "f2": deferral_period_months_444(entity_ref("urn:test:s444:t1#filer"), entity_ref("urn:test:s444:t1#y"), 3) { origin case_input; }
        assert "f3": elects_taxable_year_other_than_required_444(entity_ref("urn:test:s444:t1#filer"), entity_ref("urn:test:s444:t1#y")) { origin case_input; }
    }
    evaluate truth(section_444_election_in_effect(entity_ref("urn:test:s444:t1#filer"), entity_ref("urn:test:s444:t1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S444-02-ELECTION-INVALID-DEFERRAL-EXCEEDS-THREE-MONTHS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_partnership_or_s_corp_or_psc_444(entity_ref("urn:test:s444:t2#filer")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s444:t2#filer"), entity_ref("urn:test:s444:t2#y")) { origin case_input; }
        assert "f2": deferral_period_months_444(entity_ref("urn:test:s444:t2#filer"), entity_ref("urn:test:s444:t2#y"), 5) { origin case_input; }
        assert "f3": elects_taxable_year_other_than_required_444(entity_ref("urn:test:s444:t2#filer"), entity_ref("urn:test:s444:t2#y")) { origin case_input; }
    }
    evaluate truth(section_444_election_in_effect(entity_ref("urn:test:s444:t2#filer"), entity_ref("urn:test:s444:t2#y")));
    expect truth_status == FALSE_ONLY;
}

test "S444-03-PARTNERSHIP-SUBJECT-TO-7519-REQUIRED-PAYMENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_partnership_or_s_corp_or_psc_444(entity_ref("urn:test:s444:t3#filer")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s444:t3#filer"), entity_ref("urn:test:s444:t3#y")) { origin case_input; }
        assert "f2": deferral_period_months_444(entity_ref("urn:test:s444:t3#filer"), entity_ref("urn:test:s444:t3#y"), 3) { origin case_input; }
        assert "f3": elects_taxable_year_other_than_required_444(entity_ref("urn:test:s444:t3#filer"), entity_ref("urn:test:s444:t3#y")) { origin case_input; }
        assert "f4": is_partnership_or_s_corp_444(entity_ref("urn:test:s444:t3#filer")) { origin case_input; }
        assert "f5": section_7519_required_payment_owed(entity_ref("urn:test:s444:t3#filer"), entity_ref("urn:test:s444:t3#y")) { origin case_input; }
    }
    evaluate truth(section_444_consequence_required_payment(entity_ref("urn:test:s444:t3#filer"), entity_ref("urn:test:s444:t3#y")));
    expect truth_status == TRUE_ONLY;
}
