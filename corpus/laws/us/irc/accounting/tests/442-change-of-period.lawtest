// Section 442 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S442-01-APPROVED-CHANGE-NEW-PERIOD-BECOMES-TAXABLE-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": requests_change_of_accounting_period(entity_ref("urn:test:s442:t1#p"), entity_ref("urn:test:s442:t1#ynew")) { origin case_input; }
        assert "f1": secretary_approves_change_of_accounting_period(entity_ref("urn:test:s442:t1#p"), entity_ref("urn:test:s442:t1#ynew")) { origin case_input; }
    }
    evaluate truth(new_accounting_period_becomes_taxable_year(entity_ref("urn:test:s442:t1#p"), entity_ref("urn:test:s442:t1#ynew")));
    expect truth_status == TRUE_ONLY;
}

test "S442-02-UNAPPROVED-CHANGE-NO-EFFECT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Requested but not (yet) approved: POWER_INVALID_EXERCISE / no effect.
        assert "f0": requests_change_of_accounting_period(entity_ref("urn:test:s442:t2#p"), entity_ref("urn:test:s442:t2#ynew")) { origin case_input; }
    }
    evaluate truth(new_accounting_period_becomes_taxable_year(entity_ref("urn:test:s442:t2#p"), entity_ref("urn:test:s442:t2#ynew")));
    expect truth_status == FALSE_ONLY;
}

test "S442-03-441G-TAXPAYER-ADOPTS-NONCALENDAR-PERIOD-DEEMED-CHANGE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": keeps_no_books(entity_ref("urn:test:s442:t3#p"), entity_ref("urn:test:s442:t3#y")) { origin case_input; }
        assert "f1": adopts_noncalendar_period_while_441g_applies(entity_ref("urn:test:s442:t3#p"), entity_ref("urn:test:s442:t3#y")) { origin case_input; }
    }
    evaluate truth(deemed_change_of_accounting_period(entity_ref("urn:test:s442:t3#p"), entity_ref("urn:test:s442:t3#y")));
    expect truth_status == TRUE_ONLY;
}
