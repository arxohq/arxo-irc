// Sections 616, 617, 636 scenarios (stage 2c). NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "S616-01-DEVELOPMENT-EXPENDITURES-DEDUCTIBLE-AFTER-DISCLOSURE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": development_expenditures_616(entity_ref("urn:test:s616:t1#p"), entity_ref("urn:test:s616:t1#y"), 1, 90000 USD) { origin case_input; }
        assert "f1": commercially_marketable_ores_disclosed_before_expenditure(1) { origin case_input; }
    }
    evaluate truth(development_deduction_allowed_616a(entity_ref("urn:test:s616:t1#p"), entity_ref("urn:test:s616:t1#y"), 1, 90000 USD));
    expect truth_status == TRUE_ONLY;
}

