        assert "f1": cumulative_percentage_depletion_excess_617f1B(entity_ref("urn:test:s616:t22#p"), 2, 30000 USD) { origin case_input; }
        assert "f2": mine_reaches_producing_stage_in_year(entity_ref("urn:test:s616:t22#p"), entity_ref("urn:test:s616:t22#y"), 2) { origin case_input; }
        assert "f3": depletion_allowable_but_for_617(entity_ref("urn:test:s616:t22#p"), entity_ref("urn:test:s616:t22#y"), 2, 50000 USD) { origin case_input; }
        assert "f4": aee_already_recovered_by_depletion_disallowance(entity_ref("urn:test:s616:t22#p"), entity_ref("urn:test:s616:t22#y"), 2, 140000 USD) { origin case_input; }
    }
    // 170,000 - 140,000 remains to be recovered.
    evaluate truth(depletion_disallowed_until_aee_recovered(entity_ref("urn:test:s616:t22#p"), entity_ref("urn:test:s616:t22#y"), 2, 30000 USD));
    expect truth_status == TRUE_ONLY;
}

