// Scenarios for module 99-wire7-cross-package-contracts.law of package us.irc.accounting (WIRE-7): the consumer reads the owner's published contract (asserted as a case input; the owner's own derivation
// is tested in the owner package). Written from the text; NOT executed (NO-HEAVY-CHECKS) -- `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

test "W7ACC-01-RELATED-BUYER-EXCLUDES-631C" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert buyer_of_coal_or_iron_ore_631c(entity_ref("urn:us:irc:accounting:clir#OWNER1"), entity_ref("urn:us:irc:accounting:clir#DEPOSIT1"), entity_ref("urn:us:irc:accounting:clir#Y2025"), entity_ref("urn:us:irc:accounting:clir#BUYER1")) { id "f0"; origin case_input; }
        assert us.irc.deductions::related_persons(entity_ref("urn:us:irc:accounting:clir#OWNER1"), entity_ref("urn:us:irc:accounting:clir#BUYER1"), us.irc.deductions::FamilyMembers) { id "f1"; origin case_input; }
    }
    evaluate truth(disposal_to_related_person_excluded_under_631c(entity_ref("urn:us:irc:accounting:clir#OWNER1"), entity_ref("urn:us:irc:accounting:clir#DEPOSIT1"), entity_ref("urn:us:irc:accounting:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "W7ACC-02-UNRELATED-BUYER-DOES-NOT-EXCLUDE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert buyer_of_coal_or_iron_ore_631c(entity_ref("urn:us:irc:accounting:clir#OWNER1"), entity_ref("urn:us:irc:accounting:clir#DEPOSIT1"), entity_ref("urn:us:irc:accounting:clir#Y2025"), entity_ref("urn:us:irc:accounting:clir#BUYER1")) { id "f0"; origin case_input; }
    }
    evaluate truth(disposal_to_related_person_excluded_under_631c(entity_ref("urn:us:irc:accounting:clir#OWNER1"), entity_ref("urn:us:irc:accounting:clir#DEPOSIT1"), entity_ref("urn:us:irc:accounting:clir#Y2025")));
    expect truth_status == NEITHER;
}

