// Section 457(a)-(d) (stage 3, DECISION-0379 with deontics): the eligible
// deferred compensation plan derived from its component tests, the year of
// inclusion for the derived path, the (c) limitation with the age-50 catch-up
// substitution of (e)(18), and the distribution requirements of (d).
//
// The stage 2b relation `is_eligible_deferred_compensation_plan` (a case fact)
// and its inclusion rules stay; sibling rules read the derived plan
// `eligible_deferred_compensation_plan_457b`, and feed the same `section_457_inclusion`.
//
// Not modelled (TECH-GAPS G4800+): the section 415(c)(3) compensation, the
// section 401(a)(9), (a)(31), (a)(37), (a)(38) and (m)(13) plan qualification
// tests (each is an asserted plan fact), the regulations named by the text
// (unforeseeable emergency, plan year cure procedure), and the indexed applicable
// dollar amount (SOURCE_GAP: no IRB value is pinned).

// ===================== (e)(1), (e)(13): eligible employer =====================

use self::{
    IRC_S457_A,
    IRC_S457_B,
    IRC_S457_D,
    IRC_S457_E,
    IRC_S457_G,
    Person,
    TaxableYear,
    deferral_ceiling_457,
    deferred_compensation_paid_or_made_available_to_participant,
    deferred_compensation_paid_to_participant,
    distribution_permitted_under_457d,
    section_457_inclusion,
    this_year_ceiling_457,
};

pub relation is_state_political_subdivision_or_agency_457e1A(employer: Person) kind empirical {
    label en official "the person is a State, a political subdivision of a State, or an agency or instrumentality of a State or political subdivision (section 457(e)(1)(A))";
}
pub relation is_exempt_organization_other_than_governmental_unit_457e1B(employer: Person) kind empirical {
    label en official "the person is an organization, other than a governmental unit, exempt from tax under subtitle A (section 457(e)(1)(B))";
}
pub relation is_church_or_qualified_church_controlled_organization_457e13(employer: Person) kind empirical {
    label en official "the person is a church (section 3121(w)(3)(A)) or a qualified church-controlled organization (section 3121(w)(3)(B)) (section 457(e)(13))";
}
pub relation eligible_employer_governmental_457e1A(employer: Person) kind institutional {
    label en official "an eligible employer of the (e)(1)(A) kind: a State, political subdivision, or agency or instrumentality (section 457(e)(1)(A))";
}
@source(IRC_S457_E, quote = "(A) a State, political subdivision of a State, and any agency or instrumentality of a State or political subdivision of a State, and")
rule EligibleEmployerGovernmentalUnit(employer: Person) strict {
    label en official "governmental units are eligible employers (section 457(e)(1)(A))";
    when is_state_political_subdivision_or_agency_457e1A(employer);
    then eligible_employer_governmental_457e1A(employer);
}
pub relation eligible_employer_tax_exempt_457e1B(employer: Person) kind institutional {
    label en official "an eligible employer of the (e)(1)(B) kind: an exempt organization other than a governmental unit, and not a church or qualified church-controlled organization (section 457(e)(1)(B), (e)(13))";
}
@source(IRC_S457_E, quote = "The term \"eligible employer\" shall not include a church (as defined in section 3121(w)(3)(A)) or qualified church-controlled organization (as defined in section 3121(w)(3)(B)).")
rule EligibleEmployerTaxExemptOrganization(employer: Person) defeasible {
    label en official "exempt organizations other than governmental units are eligible, but not churches (section 457(e)(1)(B), (e)(13))";
    when is_exempt_organization_other_than_governmental_unit_457e1B(employer);
    when not_known(is_church_or_qualified_church_controlled_organization_457e13(employer));
    then eligible_employer_tax_exempt_457e1B(employer);
}

// ===================== (b): the eligible plan from its components =====================

pub relation plan_of_employer_457(employer: Person, plan: Integer) kind empirical {
    label en official "the plan is established and maintained by the employer (section 457(b))";
}
pub relation participant_performing_no_service_for_employer_457b1(plan: Integer, individual: Person) kind empirical {
    label en official "a participant in the plan performs no service for the employer, as employee or as independent contractor (section 457(b)(1), (e)(2))";
}
pub relation only_service_performers_may_participate_457b1(employer: Person, plan: Integer) kind institutional {
    label en official "only individuals who perform service for the employer (including as independent contractors) may be participants (section 457(b)(1), (e)(2))";
}
@source(IRC_S457_B, quote = "(1) in which only individuals who perform service for the employer may be participants,")
rule PlanParticipantsAreServicePerformers(employer: Person, plan: Integer) defeasible {
    label en official "no participant without service for the employer (section 457(b)(1))";
    when plan_of_employer_457(employer, plan);
    when not_known(plan_has_participant_without_service_457b1(plan));
    then only_service_performers_may_participate_457b1(employer, plan);
}
pub relation plan_has_participant_without_service_457b1(plan: Integer) kind institutional {
    label en official "the plan has a participant who performs no service for the employer (bridge)";
}
rule PlanHasParticipantWithoutServiceBridge(plan: Integer, individual: Person) strict {
    label en official "bridge";
    when participant_performing_no_service_for_employer_457b1(plan, individual);
    then plan_has_participant_without_service_457b1(plan);
}
pub relation individual_performs_service_as_employee_457e2(individual: Person, recipient: Person) kind empirical {
    label en official "the individual performs service for the recipient as an employee (section 457(e)(2))";
}
pub relation individual_performs_service_as_independent_contractor_457e2(individual: Person, recipient: Person) kind empirical {
    label en official "the individual performs service for the recipient as an independent contractor (section 457(e)(2))";
}
pub relation recipient_treated_as_employer_457e2(individual: Person, recipient: Person) kind institutional {
    label en official "performance of service includes performance as an independent contractor, and the person or governmental unit for whom the services are performed is treated as the employer (section 457(e)(2))";
}
@source(IRC_S457_E, quote = "The performance of service includes performance of service as an independent contractor and the person (or governmental unit) for whom such services are performed shall be treated as the employer.")
rule ServiceRecipientTreatedAsEmployerForEmployees(individual: Person, recipient: Person) strict {
    label en official "an employee's service recipient is the employer (section 457(e)(2))";
    when individual_performs_service_as_employee_457e2(individual, recipient);
    then recipient_treated_as_employer_457e2(individual, recipient);
}
rule ServiceRecipientTreatedAsEmployerForIndependentContractors(individual: Person, recipient: Person) strict {
    label en official "an independent contractor's service recipient is the employer (section 457(e)(2))";
    when individual_performs_service_as_independent_contractor_457e2(individual, recipient);
    then recipient_treated_as_employer_457e2(individual, recipient);
}
pub relation plan_provides_deferral_ceiling_457b2(plan: Integer) kind empirical {
    label en official "the plan provides that the maximum amount that may be deferred for the taxable year, other than rollover amounts, does not exceed the lesser of the applicable dollar amount and 100 percent of the participant's includible compensation, except as (b)(3) provides (section 457(b)(2))";
}
pub relation agreement_entered_into_before_compensation_currently_available_457b4A(plan: Integer) kind empirical {
    label en official "for a governmental employer, compensation is deferred only under an agreement entered into before the compensation is currently available to the individual (section 457(b)(4)(A))";
}
pub relation agreement_entered_into_before_the_month_begins_457b4B(plan: Integer) kind empirical {
    label en official "for any other employer, compensation is deferred for a calendar month only under an agreement entered into before the beginning of that month (section 457(b)(4)(B))";
}
pub relation deferral_agreement_timing_met_457b4(employer: Person, plan: Integer) kind institutional {
    label en official "the deferral agreement timing of (b)(4) is met: (A) for a governmental employer, (B) for any other";
}
rule DeferralAgreementTimingGovernmental(employer: Person, plan: Integer) defeasible {
    label en official "governmental plans need an agreement before the compensation is currently available (section 457(b)(4)(A))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when agreement_entered_into_before_compensation_currently_available_457b4A(plan);
    then deferral_agreement_timing_met_457b4(employer, plan);
}
rule DeferralAgreementTimingOtherEmployers(employer: Person, plan: Integer) defeasible {
    label en official "other eligible plans need an agreement before the calendar month begins (section 457(b)(4)(B))";
    when eligible_employer_tax_exempt_457e1B(employer);
    when plan_of_employer_457(employer, plan);
    when agreement_entered_into_before_the_month_begins_457b4B(plan);
    then deferral_agreement_timing_met_457b4(employer, plan);
}
pub relation plan_provides_assets_remain_solely_property_of_employer_457b6(plan: Integer) kind empirical {
    label en official "the plan provides that all deferred amounts, all property and rights purchased with them, and all income attributable to them remain, until made available, solely the property and rights of the employer, subject only to the claims of its general creditors (section 457(b)(6))";
}
pub relation plan_assets_held_in_trust_for_exclusive_benefit_457g1(plan: Integer) kind empirical {
    label en official "all assets and income of the plan described in (b)(6) are held in trust for the exclusive benefit of participants and their beneficiaries (section 457(g)(1)); a custodial account or contract described in section 401(f) counts as a trust ((g)(3))";
}
pub relation plan_meets_death_benefit_requirements_401a37_457g4(plan: Integer) kind empirical {
    label en official "the plan meets the requirements of section 401(a)(37), death benefits under USERRA-qualified active military service (section 457(g)(4)); asserted plan fact";
}
pub relation governmental_plan_set_aside_requirements_met_457g(employer: Person, plan: Integer) kind institutional {
    label en official "a governmental plan holds its assets and income in trust for the exclusive benefit of participants (g)(1) and meets the section 401(a)(37) death benefit requirement (g)(4)";
}
@source(IRC_S457_G, quote = "A plan maintained by an eligible employer described in subsection (e)(1)(A) shall not be treated as an eligible deferred compensation plan unless all assets and income of the plan described in subsection (b)(6) are held in trust for the exclusive benefit of participants and their beneficiaries.")
rule GovernmentalPlanSetAsideRequirements(employer: Person, plan: Integer) defeasible {
    label en official "trust for the exclusive benefit of participants and the section 401(a)(37) requirement (section 457(g)(1), (4))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when plan_assets_held_in_trust_for_exclusive_benefit_457g1(plan);
    when plan_meets_death_benefit_requirements_401a37_457g4(plan);
    then governmental_plan_set_aside_requirements_met_457g(employer, plan);
}
pub relation plan_assets_requirement_of_457b6_met_457(employer: Person, plan: Integer) kind institutional {
    label en official "the (b)(6) requirement is met: the plan so provides; for a governmental plan the section 457(g) trust requirements apply as well (section 457(b)(6), (g))";
}
rule AssetsRequirementMetByTaxExemptPlan(employer: Person, plan: Integer) defeasible {
    label en official "a non-governmental plan needs the (b)(6) provision (section 457(b)(6))";
    when eligible_employer_tax_exempt_457e1B(employer);
    when plan_of_employer_457(employer, plan);
    when plan_provides_assets_remain_solely_property_of_employer_457b6(plan);
    then plan_assets_requirement_of_457b6_met_457(employer, plan);
}
rule AssetsRequirementMetByGovernmentalPlan(employer: Person, plan: Integer) defeasible {
    label en official "a governmental plan meets (b)(6) through its trust; (g) substitutes for the set-aside (section 457(b)(6), (g)(1))";
    when governmental_plan_set_aside_requirements_met_457g(employer, plan);
    then plan_assets_requirement_of_457b6_met_457(employer, plan);
}

// ===================== (d): distribution requirements =====================

pub relation plan_bars_availability_before_permitted_events_457d1A(plan: Integer) kind empirical {
    label en official "under the plan amounts will not be made available to participants or beneficiaries earlier than the events of (d)(1)(A)(i)-(iv) (section 457(d)(1)(A))";
}
pub relation plan_meets_minimum_distribution_requirements_401a9_457d2(plan: Integer) kind empirical {
    label en official "the plan meets the requirements of section 401(a)(9) (section 457(d)(2)); asserted plan fact";
}
pub relation plan_meets_requirements_similar_to_401a31_457d1C(plan: Integer) kind empirical {
    label en official "a governmental plan meets requirements similar to those of section 401(a)(31), direct rollover of eligible rollover distributions (section 457(d)(1)(C)); asserted plan fact";
}
pub relation lifetime_income_amounts_distributed_only_as_qualified_form_457d1D(plan: Integer) kind empirical {
    label en official "amounts distributable under (d)(1)(A)(iv) are distributed only as a qualified distribution or qualified plan distribution annuity contract of section 401(a)(38)(B), unless regulations provide otherwise (section 457(d)(1)(D))";
}
pub relation plan_has_lifetime_income_investment_window_amounts_457d1Aiv(plan: Integer) kind empirical {
    label en official "the governmental plan makes amounts invested in a lifetime income investment available 90 days before the investment may no longer be held (section 457(d)(1)(A)(iv))";
}
pub relation distribution_requirements_met_457d(employer: Person, plan: Integer) kind institutional {
    label en official "the plan meets the distribution requirements of subsection (d), for section 457(b)(5)";
}
@source(IRC_S457_D, quote = "For purposes of subsection (b)(5), a plan meets the distribution requirements of this subsection if—")
rule DistributionRequirementsMetByTaxExemptPlan(employer: Person, plan: Integer) defeasible {
    label en official "availability limited by (A) and minimum distributions under section 401(a)(9) for a non-governmental plan (section 457(d)(1)(A)-(B))";
    when eligible_employer_tax_exempt_457e1B(employer);
    when plan_of_employer_457(employer, plan);
    when plan_bars_availability_before_permitted_events_457d1A(plan);
    when plan_meets_minimum_distribution_requirements_401a9_457d2(plan);
    then distribution_requirements_met_457d(employer, plan);
}
rule DistributionRequirementsMetByGovernmentalPlan(employer: Person, plan: Integer) defeasible {
    label en official "availability limited, minimum distributions, requirements similar to section 401(a)(31), and the lifetime income form rule where (A)(iv) amounts exist (section 457(d)(1)(A)-(D))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when plan_bars_availability_before_permitted_events_457d1A(plan);
    when plan_meets_minimum_distribution_requirements_401a9_457d2(plan);
    when plan_meets_requirements_similar_to_401a31_457d1C(plan);
    when not_known(plan_has_lifetime_income_investment_window_amounts_457d1Aiv(plan));
    then distribution_requirements_met_457d(employer, plan);
}
rule DistributionRequirementsMetByGovernmentalPlanWithLifetimeIncome(employer: Person, plan: Integer) defeasible {
    label en official "a governmental plan with lifetime income investment amounts also needs the (D) distribution form rule (section 457(d)(1)(D))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when plan_bars_availability_before_permitted_events_457d1A(plan);
    when plan_meets_minimum_distribution_requirements_401a9_457d2(plan);
    when plan_meets_requirements_similar_to_401a31_457d1C(plan);
    when plan_has_lifetime_income_investment_window_amounts_457d1Aiv(plan);
    when lifetime_income_amounts_distributed_only_as_qualified_form_457d1D(plan);
    then distribution_requirements_met_457d(employer, plan);
}
pub relation participant_age_in_half_years_at_end_of_year_457d1Ai(employer: Person, plan: Integer, y: TaxableYear, half_years: Integer) kind empirical {
    label en official "the participant's age at the end of the calendar year, in half-years (70 1/2 is 141 half-years, 59 1/2 is 119) (section 457(d)(1)(A)(i))";
}
pub relation distribution_age_reached_457d1Ai(employer: Person, plan: Integer, y: TaxableYear) kind institutional {
    label en official "the calendar year in which the participant attains age 70 1/2, or 59 1/2 for a governmental plan, has been reached (section 457(d)(1)(A)(i))";
}
@source(IRC_S457_D, quote = "(i) the calendar year in which the participant attains age 70½ (in the case of a plan maintained by an employer described in subsection (e)(1)(A), age 59½),")
rule DistributionAgeReachedGovernmental(employer: Person, plan: Integer, y: TaxableYear, half: Integer) defeasible {
    label en official "age 59 1/2 for a governmental plan (section 457(d)(1)(A)(i))";
    when eligible_employer_governmental_457e1A(employer);
    when participant_age_in_half_years_at_end_of_year_457d1Ai(employer, plan, y, half);
    when half >= 119;
    then distribution_age_reached_457d1Ai(employer, plan, y);
}
rule DistributionAgeReachedOtherEmployers(employer: Person, plan: Integer, y: TaxableYear, half: Integer) defeasible {
    label en official "age 70 1/2 for any other plan (section 457(d)(1)(A)(i))";
    when eligible_employer_tax_exempt_457e1B(employer);
    when participant_age_in_half_years_at_end_of_year_457d1Ai(employer, plan, y, half);
    when half >= 141;
    then distribution_age_reached_457d1Ai(employer, plan, y);
}
rule DistributionPermittedByDerivedAge(employer: Person, plan: Integer, y: TaxableYear) defeasible {
    label en official "the derived age trigger makes a distribution permitted (section 457(d)(1)(A)(i)); the stage 2b case-fact trigger is kept";
    when distribution_age_reached_457d1Ai(employer, plan, y);
    then distribution_permitted_under_457d(employer, plan, y);
}
pub relation trustee_to_trustee_transfer_under_401a31_457d1(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "an amount is transferred in a direct trustee-to-trustee transfer in accordance with section 401(a)(31) (section 457(d)(1), last sentence)";
}
pub relation trustee_to_trustee_transfer_not_includible_457d1(employer: Person, plan: Integer, y: TaxableYear) kind institutional {
    label en official "a direct trustee-to-trustee transfer under section 401(a)(31) is not includible in gross income for the year of transfer (section 457(d)(1), last sentence)";
}
@source(IRC_S457_D, quote = "Any amount transferred in a direct trustee-to-trustee transfer in accordance with section 401(a)(31) shall not be includible in gross income for the taxable year of transfer.")
rule DirectTrusteeToTrusteeTransferNotIncludible(employer: Person, plan: Integer, y: TaxableYear) defeasible {
    label en official "not includible in the year of transfer (section 457(d)(1))";
    when trustee_to_trustee_transfer_under_401a31_457d1(employer, plan, y);
    then trustee_to_trustee_transfer_not_includible_457d1(employer, plan, y);
}
pub relation distribution_described_in_457e9A_457d3(plan: Integer) kind empirical {
    label en official "the plan makes a distribution described in subsection (e)(9)(A) (small amounts of a tax-exempt plan) (section 457(d)(3)); the text places this rule under a governmental plan while (e)(9)(A) speaks of tax-exempt plans: read as written";
}
pub relation governmental_plan_not_failing_d_by_e9A_distribution_457d3(employer: Person, plan: Integer) kind institutional {
    label en official "a governmental plan does not fail the distribution requirements solely by making a distribution described in (e)(9)(A) (section 457(d)(3))";
}
@source(IRC_S457_D, quote = "An eligible deferred compensation plan of an employer described in subsection (e)(1)(A) shall not be treated as failing to meet the requirements of this subsection solely by reason of making a distribution described in subsection (e)(9)(A).")
rule GovernmentalPlanNotFailingByE9ADistribution(employer: Person, plan: Integer) defeasible {
    label en official "a (e)(9)(A) distribution does not by itself fail a governmental plan (section 457(d)(3))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when distribution_described_in_457e9A_457d3(plan);
    then governmental_plan_not_failing_d_by_e9A_distribution_457d3(employer, plan);
}
pub relation participant_written_certification_of_emergency_457d4(plan: Integer) kind empirical {
    label en official "the participant gives a written certification that the distribution is made for an unforeseeable emergency of a type described in regulations, does not exceed the amount required, and that no alternative means are reasonably available (section 457(d)(4))";
}
pub relation administrator_has_actual_knowledge_contrary_to_certification_457d4(plan: Integer) kind empirical {
    label en official "the plan administrator has actual knowledge contrary to the participant's certification (section 457(d)(4), last sentence, exceptions by regulations)";
}
pub relation administrator_may_rely_on_certification_457d4(employer: Person, plan: Integer) kind institutional {
    label en official "the administrator of a governmental plan may rely on the participant's written certification in determining whether a distribution is made for an unforeseeable emergency (section 457(d)(4))";
}
@source(IRC_S457_D, quote = "the administrator of a plan maintained by an eligible employer described in subsection (e)(1)(A) may rely on a written certification by the participant")
rule AdministratorMayRelyOnCertification(employer: Person, plan: Integer) defeasible {
    label en official "reliance on a certification is permitted for a governmental plan, unless the administrator knows otherwise (section 457(d)(4))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when participant_written_certification_of_emergency_457d4(plan);
    when not_known(administrator_has_actual_knowledge_contrary_to_certification_457d4(plan));
    then administrator_may_rely_on_certification_457d4(employer, plan);
}

// ===================== (b): the derived eligible plan =====================

pub relation eligible_deferred_compensation_plan_457b(employer: Person, plan: Integer) kind institutional {
    label en official "an eligible deferred compensation plan: a plan of an eligible employer meeting (b)(1) participation, (2) the ceiling provision, (4) agreement timing, (5) the (d) distribution requirements and (6) the property-and-rights provision (section 457(b))";
}
@source(IRC_S457_B, quote = "the term \"eligible deferred compensation plan\" means a plan established and maintained by an eligible employer—")
rule EligibleDeferredCompensationPlanFromComponents(employer: Person, plan: Integer) defeasible {
    label en official "all six (b) tests hold (section 457(b)); the (b)(3) catch-up is optional and adds no test";
    when only_service_performers_may_participate_457b1(employer, plan);
    when plan_provides_deferral_ceiling_457b2(plan);
    when deferral_agreement_timing_met_457b4(employer, plan);
    when distribution_requirements_met_457d(employer, plan);
    when plan_assets_requirement_of_457b6_met_457(employer, plan);
    then eligible_deferred_compensation_plan_457b(employer, plan);
}
pub relation secretary_notifies_plan_of_inconsistent_administration_457b(plan: Integer, notified_on: Date) kind empirical {
    label en official "the Secretary notifies the governmental employer that the plan is administered inconsistently with a requirement of (b)(1)-(6) on the date (section 457(b), flush paragraph)";
}
pub relation plan_year_begins_on_457b(plan: Integer, start: Date) kind empirical {
    label en official "a plan year of the plan begins on the date";
}
pub relation inconsistency_corrected_before_plan_year_starts_457b(plan: Integer, start: Date) kind empirical {
    label en official "the employer corrects the inconsistency before the first day of that plan year (section 457(b), flush paragraph)";
}
pub relation earlier_plan_year_more_than_180_days_after_notification_457b(plan: Integer, start: Date) kind institutional {
    label en official "an earlier plan year also begins more than 180 days after the notification (bridge for 'the 1st plan year')";
}
rule EarlierPlanYearAfter180Days(plan: Integer, start: Date, earlier: Date, notified: Date) strict {
    label en official "an earlier qualifying plan year exists";
    when secretary_notifies_plan_of_inconsistent_administration_457b(plan, notified);
    when plan_year_begins_on_457b(plan, start);
    when plan_year_begins_on_457b(plan, earlier);
    when earlier < start;
    when earlier > add_calendar_period(notified, 180 calendar_day);
    then earlier_plan_year_more_than_180_days_after_notification_457b(plan, start);
}
pub relation governmental_plan_treated_as_failing_requirement_from_457b(employer: Person, plan: Integer, start: Date) kind institutional {
    label en official "a governmental plan administered inconsistently is treated as not meeting the requirement as of the first plan year beginning more than 180 days after the Secretary's notification, unless the employer corrects it before that year (section 457(b), flush paragraph)";
}
@source(IRC_S457_B, quote = "shall be treated as not meeting the requirements of such paragraph as of the 1st plan year beginning more than 180 days after the date of notification by the Secretary of the inconsistency unless the employer corrects the inconsistency before the 1st day of such plan year.")
rule GovernmentalPlanFailsFromFirstPlanYearAfter180Days(employer: Person, plan: Integer, start: Date, notified: Date) defeasible {
    label en official "the first plan year beginning more than 180 days after notification, if not corrected before it (section 457(b), flush paragraph)";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when secretary_notifies_plan_of_inconsistent_administration_457b(plan, notified);
    when plan_year_begins_on_457b(plan, start);
    when start > add_calendar_period(notified, 180 calendar_day);
    when not_known(earlier_plan_year_more_than_180_days_after_notification_457b(plan, start));
    when not_known(inconsistency_corrected_before_plan_year_starts_457b(plan, start));
    then governmental_plan_treated_as_failing_requirement_from_457b(employer, plan, start);
}
pub relation matching_contributions_for_qualified_student_loan_payments_457b(plan: Integer) kind empirical {
    label en official "the plan, or another plan of the employer meeting section 401(a) or 403(b), provides matching contributions on account of qualified student loan payments as described in section 401(m)(13) (section 457(b), last sentence)";
}
pub relation governmental_plan_not_failing_by_student_loan_matching_457b(employer: Person, plan: Integer) kind institutional {
    label en official "a governmental plan does not fail the (b) requirements solely because of student loan payment matching contributions (section 457(b), last sentence)";
}
@source(IRC_S457_B, quote = "shall not be treated as failing to meet the requirements of this subsection solely because the plan, or another plan maintained by the employer which meets the requirements of section 401(a) or 403(b), provides for matching contributions on account of qualified student loan payments as described in section 401(m)(13).")
rule StudentLoanMatchingDoesNotFailAGovernmentalPlan(employer: Person, plan: Integer) defeasible {
    label en official "student loan matching is not a failure of a governmental plan (section 457(b))";
    when eligible_employer_governmental_457e1A(employer);
    when plan_of_employer_457(employer, plan);
    when matching_contributions_for_qualified_student_loan_payments_457b(plan);
    then governmental_plan_not_failing_by_student_loan_matching_457b(employer, plan);
}

// ===================== (a): year of inclusion for the derived plan =====================

@source(IRC_S457_A, quote = "is paid to the participant or other beneficiary, in the case of a plan of an eligible employer described in subsection (e)(1)(A)")
rule Section457InclusionDerivedGovernmentalPlan(employer: Person, plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "for a derived eligible plan of a governmental employer, deferred compensation is includible when paid (section 457(a)(1)(A))";
    when eligible_employer_governmental_457e1A(employer);
    when eligible_deferred_compensation_plan_457b(employer, plan);
    when deferred_compensation_paid_to_participant(employer, plan, y, amount);
    then section_457_inclusion(employer, plan, y, amount);
}
@source(IRC_S457_A, quote = "is paid or otherwise made available to the participant or other beneficiary, in the case of a plan of an eligible employer described in subsection (e)(1)(B)")
rule Section457InclusionDerivedTaxExemptPlan(employer: Person, plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "for a derived eligible plan of a tax-exempt employer, deferred compensation is includible when paid or made available (section 457(a)(1)(B))";
    when eligible_employer_tax_exempt_457e1B(employer);
    when eligible_deferred_compensation_plan_457b(employer, plan);
    when deferred_compensation_paid_or_made_available_to_participant(employer, plan, y, amount);
    then section_457_inclusion(employer, plan, y, amount);
}
pub relation includible_amount_subject_to_72t_to_the_extent_of_72t9_457a2(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "section 72(t) applies to the amount includible under this subsection to the extent provided in section 72(t)(9) (section 457(a)(2)); the extent is determined by section 72(t)(9), asserted";
}
pub relation health_and_long_term_care_amount_excluded_to_the_extent_of_402l_457a3(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "for a governmental plan, paragraph (1) does not apply to the amount to the extent of section 402(l) (section 457(a)(3)); the extent is determined by section 402(l), asserted";
}
pub relation deferred_compensation_not_includible_under_457a1_by_402l_457a3(employer: Person, plan: Integer, y: TaxableYear) kind institutional {
    label en official "the amount is not includible under paragraph (1) to the extent section 402(l) so provides (section 457(a)(3))";
}
@source(IRC_S457_A, quote = "In the case of a plan of an eligible employer described in subsection (e)(1)(A), to the extent provided in section 402(l), paragraph (1) shall not apply to amounts otherwise includible in gross income under this subsection.")
rule HealthAndLongTermCareAmountsOutsideParagraph1(employer: Person, plan: Integer, y: TaxableYear) defeasible {
    label en official "governmental plan amounts covered by section 402(l) are outside (a)(1) (section 457(a)(3))";
    when eligible_employer_governmental_457e1A(employer);
    when health_and_long_term_care_amount_excluded_to_the_extent_of_402l_457a3(employer, plan, y);
    then deferred_compensation_not_includible_under_457a1_by_402l_457a3(employer, plan, y);
}
pub relation section_72t_applies_to_includible_amount_457a2(employer: Person, plan: Integer, y: TaxableYear) kind institutional {
    label en official "section 72(t) applies to an amount includible under this subsection to the extent provided in section 72(t)(9) (section 457(a)(2))";
}
@source(IRC_S457_A, quote = "To the extent provided in section 72(t)(9), section 72(t) shall apply to any amount includible in gross income under this subsection.")
rule Section72tAppliesToIncludibleAmount(employer: Person, plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "section 72(t) reaches an includible amount to the extent of section 72(t)(9) (section 457(a)(2))";
    when section_457_inclusion(employer, plan, y, amount);
    when includible_amount_subject_to_72t_to_the_extent_of_72t9_457a2(employer, plan, y);
    then section_72t_applies_to_includible_amount_457a2(employer, plan, y);
}

// ===================== (e)(18), (e)(14), (e)(15): the limitation with substitutions =====================

pub relation eligible_participant_414v_457e18(employer: Person, plan: Integer, y: TaxableYear) kind empirical {
    label en official "the individual is an eligible participant as defined by section 414(v) in a plan of a governmental employer (section 457(e)(18)); the age-50 test is asserted";
}
pub relation designated_roth_contributions_457e18Aii(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the designated Roth contributions made by the participant to the plan for the year (section 457(e)(18)(A)(ii))";
}
pub relation section_414v_catch_up_amount_457e18Aii(y: TaxableYear, amount: Money) kind empirical {
    label en official "the applicable dollar amount for the taxable year determined under section 414(v)(2)(B)(i) (section 457(e)(18)(A)(ii)); the indexed value is a pending dependency on section 414(v)";
}
pub relation deferral_ceiling_with_age_50_catch_up_457e18(employer: Person, plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "for an age-50 eligible participant of a governmental plan the ceiling under (b)(3) and (c) is the greater of (A) the plan ceiling without (b)(3) plus the lesser of designated Roth contributions and the section 414(v) amount, and (B) the ordinary ceiling (section 457(e)(18))";
}
@source(IRC_S457_E, quote = "subsections (b)(3) and (c) shall be applied by substituting for the amount otherwise determined under the applicable subsection the greater of—")
rule DeferralCeilingWithAge50CatchUp(employer: Person, plan: Integer, y: TaxableYear, base: Money, roth: Money, catch_up: Money, ordinary: Money) defeasible {
    label en official "max(base ceiling + min(Roth, catch-up amount), ordinary ceiling) (section 457(e)(18))";
    when eligible_employer_governmental_457e1A(employer);
    when eligible_participant_414v_457e18(employer, plan, y);
    when this_year_ceiling_457(employer, plan, y, base);
    when designated_roth_contributions_457e18Aii(employer, plan, y, roth);
    when section_414v_catch_up_amount_457e18Aii(y, catch_up);
    when deferral_ceiling_457(employer, plan, y, ordinary);
    then deferral_ceiling_with_age_50_catch_up_457e18(employer, plan, y, max(base + min(roth, catch_up), ordinary));
}
pub relation qualified_governmental_excess_benefit_arrangement_457e14(plan: Integer) kind empirical {
    label en official "the arrangement is a qualified governmental excess benefit arrangement as defined in section 415(m)(3) (section 457(e)(14))";
}
pub relation deferral_ceiling_not_applicable_to_qgeba_457e14(plan: Integer) kind institutional {
    label en official "subsections (b)(2) and (c)(1) do not apply to a qualified governmental excess benefit arrangement, and its benefits are not counted for another plan (section 457(e)(14))";
}
@source(IRC_S457_E, quote = "Subsections (b)(2) and (c)(1) shall not apply to any qualified governmental excess benefit arrangement (as defined in section 415(m)(3))")
rule QgebaOutsideTheCeiling(plan: Integer) defeasible {
    label en official "the ceiling does not apply to a QGEBA (section 457(e)(14))";
    when qualified_governmental_excess_benefit_arrangement_457e14(plan);
    then deferral_ceiling_not_applicable_to_qgeba_457e14(plan);
}
