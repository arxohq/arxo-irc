// Accounting -- WIRE-8 (26.09.2026, DECISION-0379 Д-22 items (а) and (б), implemented_unverified).
//
// The lower package `income_individual` (section 57(a)(1) depletion preference) declares a local contract for the depletion deduction
// allowed under section 611 and cannot import this package (this package imports `deductions`, which imports `income_individual`; a
// direct import back would be an import cycle). `income_individual::DepletableProperty` is now a subtype of the shared `core::Asset`
// (item (а)), so the owner DERIVES the lower package's `pub` relation from its own section 611 relation, keyed by `Asset`, with a
// qualified rule head (item (б)); this package gains the direct import of `income_individual` (acyclic). The case-fact channel stays
// valid: scenarios of `income_individual` never load this package. Only `depletion_deduction_allowed` is derived: the basis before the
// deduction and the section 613A(c) flag have no owner relation of the same meaning (the owner's basis is date-keyed).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

use self::{
    Asset,
    Person,
    TaxableYear,
    depletion_deduction,
};

rule W8DepletionDeductionAllowedForAmt(p: Person, prop: us.irc.income_individual::DepletableProperty, y: TaxableYear, amount: Money) strict {
    label en official "section 57(a)(1): the deduction for depletion allowable under section 611 is this package's section 611 depletion deduction";
    when depletion_deduction(p, prop, y, amount);
    then us.irc.income_individual::depletion_deduction_allowed(p, y, prop, amount);
}
