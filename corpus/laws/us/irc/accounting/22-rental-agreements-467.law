// Section 467 — Certain payments for the use of property or services.
// Stage 2b (IRC-07). Scope: (d)(1)-(2) the section 467 rental agreement gate
// and the $250,000 aggregate-consideration threshold; (b)(2)-(4) the
// constant-rental-accrual requirement (disqualified leaseback/long-term
// agreement, or no (b)(1)(A) allocation in the agreement); (a)(1)/(b)(2) the
// constant-rental-amount accrual, modelled as a SINGLE lease period coinciding
// with the taxable year (a one-period step); the constant rental amount
// itself, and the (a)(2) interest-on-unpaid-prior-year-amounts term, are read
// as case facts (SOURCE_GAP / TECH_GAP). NOT DONE (TECH-GAPS G473): the
// multi-period present-value allocation of (b)(1)(B) and the general
// (non-disqualified) case; the (a)(2) interest computation across multiple
// prior taxable years (a genuine multi-year running ledger, the "G1-class"
// gap flagged by the coordinator); (c) recapture of prior understated
// inclusions; (e)(2)-(6) leaseback/statutory-recovery-period/related-person
// definitions beyond the constant-rental-amount case fact; (f)-(g) decreasing-
// payment and services analogues; (h) regulations (NON_NORMATIVE).

use self::{
    IRC_S467_B,
    IRC_S467_D,
    Person,
    TaxableYear,
};

pub relation rental_agreement_has_payment_after_following_calendar_year(agreement: Integer) kind empirical {
    label en official "at least one amount allocable to the use of property during a calendar year is to be paid after the close of the calendar year following the year the use occurs (section 467(d)(1)(A))";
}
pub relation rental_agreement_has_increasing_rent(agreement: Integer) kind empirical {
    label en official "there are increases in the amount to be paid as rent under the agreement (section 467(d)(1)(B))";
}
pub relation aggregate_consideration_for_use_of_property_467(agreement: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount of payments received, plus the aggregate value of other consideration to be received, for the use of the property (section 467(d)(2))";
}
pub relation is_section_467_rental_agreement(lessor: Person, lessee: Person, agreement: Integer) kind institutional {
    label en official "a rental agreement for the use of tangible property meeting the section 467(d)(1)(A) or (B) test and exceeding the $250,000 section 467(d)(2) threshold";
}
pub relation parties_to_rental_agreement_467(lessor: Person, lessee: Person, agreement: Integer) kind empirical {
    label en official "the lessor and lessee under the rental agreement (section 467(a))";
}
@source(IRC_S467_D, quote = "there is at least one amount allocable to the use of property during a calendar year which is to be paid after the close of the calendar year following the calendar year in which such use occurs, or")
rule Section467RentalAgreementDeferredPayment(lessor: Person, lessee: Person, agreement: Integer, aggregate: Money) strict {
    label en official "a rental agreement with a payment deferred past the following calendar year, and aggregate consideration exceeding $250,000, is a section 467 rental agreement (section 467(d)(1)(A), (d)(2))";
    when parties_to_rental_agreement_467(lessor, lessee, agreement);
    when rental_agreement_has_payment_after_following_calendar_year(agreement);
    when aggregate_consideration_for_use_of_property_467(agreement, aggregate);
    when aggregate > 250000.00 USD;
    then is_section_467_rental_agreement(lessor, lessee, agreement);
}
@source(IRC_S467_D, quote = "there are increases in the amount to be paid as rent under the agreement")
rule Section467RentalAgreementIncreasingRent(lessor: Person, lessee: Person, agreement: Integer, aggregate: Money) strict {
    label en official "a rental agreement with increasing rent, and aggregate consideration exceeding $250,000, is a section 467 rental agreement (section 467(d)(1)(B), (d)(2))";
    when parties_to_rental_agreement_467(lessor, lessee, agreement);
    when rental_agreement_has_increasing_rent(agreement);
    when aggregate_consideration_for_use_of_property_467(agreement, aggregate);
    when aggregate > 250000.00 USD;
    then is_section_467_rental_agreement(lessor, lessee, agreement);
}

// (b)(2)-(4): constant rental accrual is required for a disqualified
// leaseback/long-term agreement, or one that does not allocate rents in the
// agreement itself.
pub relation is_disqualified_leaseback_or_long_term_agreement_467(agreement: Integer) kind empirical {
    label en official "the agreement is part of a leaseback transaction (or its term exceeds 75 percent of the statutory recovery period) AND a principal purpose for increasing rents is tax avoidance (section 467(b)(4)) — read as a case fact; the (b)(5) safe-harbor exceptions are NOT modelled (TECH_GAP G473)";
}
pub relation rental_agreement_allocates_rent_in_agreement(agreement: Integer) kind empirical {
    label en official "the agreement itself allocates rents (section 467(b)(1)(A), (b)(3)(B))";
}
pub relation constant_rental_accrual_required_467(lessor: Person, lessee: Person, agreement: Integer) kind institutional {
    label en official "the constant-rental-accrual method of section 467(b)(2) applies to the agreement: it is a disqualified leaseback or long-term agreement, or it does not itself allocate rents (section 467(b)(3))";
}
@source(IRC_S467_B, quote = "such agreement is a disqualified leaseback or long-term agreement, or")
rule ConstantRentalAccrualRequiredDisqualified(lessor: Person, lessee: Person, agreement: Integer) strict {
    label en official "constant rental accrual is required for a disqualified leaseback or long-term agreement (section 467(b)(3)(A))";
    when is_section_467_rental_agreement(lessor, lessee, agreement);
    when is_disqualified_leaseback_or_long_term_agreement_467(agreement);
    then constant_rental_accrual_required_467(lessor, lessee, agreement);
}
@source(IRC_S467_B, quote = "such agreement does not provide for the allocation referred to in paragraph (1)(A)")
rule ConstantRentalAccrualRequiredNoAllocation(lessor: Person, lessee: Person, agreement: Integer) defeasible {
    label en official "constant rental accrual is required when the agreement does not itself allocate rents (section 467(b)(3)(B))";
    when is_section_467_rental_agreement(lessor, lessee, agreement) and not_known(rental_agreement_allocates_rent_in_agreement(agreement));
    then constant_rental_accrual_required_467(lessor, lessee, agreement);
}

// (a)(1)/(b)(2)/(e)(1): the constant rental amount, accrued for the year —
// modelled as a SINGLE lease period exactly coinciding with the taxable
// year (a one-period step). Multi-period allocation, and the (a)(2) interest
// on unpaid prior-year amounts, are NOT modelled (TECH_GAP G473).
pub relation constant_rental_amount_467(agreement: Integer, amount: Money) kind empirical {
    label en unofficial "SOURCE_GAP/TECH_GAP: the constant rental amount under section 467(e)(1) — the amount which, paid at the close of each lease period, equates the aggregate present value of accrual-period payments to the aggregate present value of all payments required under the agreement, discounted at 110 percent of the section 1274(d) applicable Federal rate (section 467(e)(4)); no AFR value pinned (same class as us.irc.payment_refunds_interest's federal_short_term_rate) and the multi-period equating computation itself is not modelled — read as a case fact for a single-period agreement";
}
pub relation lease_period_coincides_with_taxable_year_467(agreement: Integer, y: TaxableYear) kind empirical {
    label en official "the agreement's lease period exactly coincides with the taxable year (the one-period simplification this stage relies on; a multi-period agreement is TECH_GAP G473)";
}
pub relation rent_accrued_for_year_467(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of rent which accrues during the taxable year under section 467(b) — for a constant-rental-accrual agreement with one lease period coinciding with the taxable year, that portion of the constant rental amount allocable to the year is the whole amount (section 467(a)(1), (b)(2)). The (a)(2) interest term on unpaid prior-year amounts is NOT added (TECH_GAP G473).";
}
@source(IRC_S467_B, quote = "the portion of the rent which accrues during any taxable year shall be that portion of the constant rental amount with respect to such agreement which is allocable to such taxable year")
rule RentAccruedForYearConstantMethodOnePeriod(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "for a single-period agreement, the rent accrued for the year under the constant-rental-accrual method is the whole constant rental amount (section 467(a)(1), (b)(2))";
    when constant_rental_accrual_required_467(lessor, lessee, agreement);
    when lease_period_coincides_with_taxable_year_467(agreement, y);
    when constant_rental_amount_467(agreement, amount);
    then rent_accrued_for_year_467(lessor, lessee, agreement, y, amount);
}
