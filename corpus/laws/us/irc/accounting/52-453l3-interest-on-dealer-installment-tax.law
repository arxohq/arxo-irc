}
rule PaymentInterestYearSumTotalFromLastSlot(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "the total is the running sum after the last slot";
    when payment_interest_year_sum_sum_12(p, y, acc);
    then payment_interest_year_sum_total(p, y, acc);
}

pub relation tax_increase_by_interest_453l3A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax for the taxable year in which payments are received is increased by the interest determined under subparagraph (B) (section 453(l)(3)(A))";
}
@source(IRC_S453_L, quote = "the tax imposed by this chapter for any taxable year for which payment is received on such obligation shall be increased by the amount of interest determined in the manner provided under subparagraph (B).")
rule TaxIncreasedByPaymentInterest(p: Person, y: TaxableYear, total: Money) defeasible {
    label en official "the increase is the sum of the interest on the payments of the year (section 453(l)(3)(A))";
    when payment_interest_year_sum_total(p, y, total);
    then tax_increase_by_interest_453l3A(p, y, total);
}
pub relation interest_deduction_amount_453l3c(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount payable under paragraph (3) that is taken into account in computing the deduction allowable for interest paid or accrued during the taxable year (section 453(l)(3)(C))";
}
@source(IRC_S453_L, quote = "Any amount payable under this paragraph shall be taken into account in computing the amount of any deduction allowable to the taxpayer for interest paid or accrued during such taxable year.")
rule PaymentInterestEntersInterestDeduction(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the interest increase counts as interest paid or accrued for the deduction (section 453(l)(3)(C))";
    when tax_increase_by_interest_453l3A(p, y, amount);
    then interest_deduction_amount_453l3c(p, y, amount);
}
