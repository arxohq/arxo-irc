// Section 453(l)(3): interest on the tax attributable to timeshare and
// residential-lot installment payments (stage 4, DECISION-0379 with
// deontics). Closes G4804.
//
// TECHNIQUE (stated): the interest of one payment is derived with the
// semiannual compounding factor of module 49 (whole six-month periods by
// (1 + r/2)^n, a stub period by simple interest; JUDGMENT CALL for the stub);
// the increase of the tax of a year is the sum over the payments received in
// the year, which the language cannot sum over a derived relation, so the
// payments are numbered by an ORDINAL SLOT (1 to 12) supplied by the case and
// summed by a bounded unrolled chain (more than 12 payments in one year give no
// total). The tax attributable to each payment (paragraph (3)(B)(i)(I)) is the
// tax owner's function and is a CASE-SUPPLIED amount, determined without regard
// to the interest (clause (ii)); the applicable Federal rate is asserted (no
// IRB table pinned: SOURCE_GAP of the value, not of the rule).

use self::{
    IRC_S453_L,
    Person,
    TaxableYear,
    semiannual_factor,
    semiannual_factor_request,
    timeshare_lot_election_in_effect_453l2B,
};

pub relation installment_obligation_sale_date_453l3(disposition: Integer, sold_on: Date) kind empirical {
    label en official "the date of sale from which the interest runs (section 453(l)(3)(B)(i)(II))";
}
pub relation installment_obligation_sale_year_453l3(disposition: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year of the disposition from which the installment obligation arises (section 453(l)(3)(B)(iii))";
}
pub relation applicable_federal_rate_at_sale_453l3(disposition: Integer, rate: Decimal) kind empirical {
    label en official "the applicable Federal rate under section 1274 (without regard to subsection (d)(2) thereof) in effect at the time of the sale, an annual rate compounded semiannually; the published value is asserted (SOURCE_GAP: no IRB rate table pinned) (section 453(l)(3)(B)(i)(III))";
}
pub relation tax_attributable_to_payment_453l3(p: Person, y: TaxableYear, slot: Integer, disposition: Integer, received_on: Date, tax: Money) kind empirical {
    label en official "the tax for the taxable year attributable to the payment received on the obligation, determined without regard to any interest under (A); the tax function is applied outside this package; slot is the ordinal number (1 to 12) of the payment among the year's payments (section 453(l)(3)(B)(i)(I), (ii))";
}
pub relation payment_in_disposition_year_453l3(p: Person, y: TaxableYear, slot: Integer) kind institutional {
    label en official "the payment is received in the taxable year of the disposition from which the obligation arises";
}
@source(IRC_S453_L, quote = "No interest shall be determined for any payment received in the taxable year of the disposition from which the installment obligation arises.")
rule PaymentReceivedInDispositionYear(p: Person, y: TaxableYear, slot: Integer, disposition: Integer, received_on: Date, tax: Money) defeasible {
    label en official "a payment in the year of the disposition carries no interest (section 453(l)(3)(B)(iii))";
    when tax_attributable_to_payment_453l3(p, y, slot, disposition, received_on, tax);
    when installment_obligation_sale_year_453l3(disposition, y);
    then payment_in_disposition_year_453l3(p, y, slot);
}
rule PaymentInterestRequestsFactor(p: Person, y: TaxableYear, slot: Integer, disposition: Integer, received_on: Date, tax: Money, sold_on: Date, rate: Decimal) defeasible {
    label en official "ask for the semiannual factor from the sale to the receipt";
    when tax_attributable_to_payment_453l3(p, y, slot, disposition, received_on, tax);
    when timeshare_lot_election_in_effect_453l2B(p, disposition);
    when installment_obligation_sale_date_453l3(disposition, sold_on);
    when applicable_federal_rate_at_sale_453l3(disposition, rate);
    when not_known(payment_in_disposition_year_453l3(p, y, slot));
    then semiannual_factor_request(rate, sold_on, received_on);
}
pub relation payment_interest_453l3(p: Person, y: TaxableYear, slot: Integer, interest: Money) kind institutional {
    label en official "the interest on the tax attributable to one payment: tax x (factor - 1), factor = the applicable Federal rate compounded semiannually from the date of sale to the date of receipt, one rounding to cents HALF_UP (JUDGMENT CALL) (section 453(l)(3)(B)(i))";
}
@source(IRC_S453_L, quote = "(III) by using the applicable Federal rate under section 1274 (without regard to subsection (d)(2) thereof) in effect at the time of the sale compounded semiannually.")
rule PaymentInterestFromTaxAndFactor(p: Person, y: TaxableYear, slot: Integer, disposition: Integer, received_on: Date, tax: Money, sold_on: Date, rate: Decimal, f: Decimal) defeasible {
    label en official "interest on the tax attributable to the payment for the period from the sale to the receipt at the rate compounded semiannually (section 453(l)(3)(B)(i))";
    when tax_attributable_to_payment_453l3(p, y, slot, disposition, received_on, tax);
    when timeshare_lot_election_in_effect_453l2B(p, disposition);
    when installment_obligation_sale_date_453l3(disposition, sold_on);
    when applicable_federal_rate_at_sale_453l3(disposition, rate);
    when not_known(payment_in_disposition_year_453l3(p, y, slot));
    when semiannual_factor(rate, sold_on, received_on, f);
    then payment_interest_453l3(p, y, slot, round(tax * (f - 1.0), 2, "HALF_UP"));
}
rule PaymentInterestNoneInDispositionYear(p: Person, y: TaxableYear, slot: Integer) defeasible {
    label en official "no interest is determined for a payment received in the year of the disposition (section 453(l)(3)(B)(iii))";
    when payment_in_disposition_year_453l3(p, y, slot);
    then payment_interest_453l3(p, y, slot, 0.00 USD);
}
rule PaymentsOfTheYearRequestSum(p: Person, y: TaxableYear, slot: Integer, disposition: Integer, received_on: Date, tax: Money) defeasible {
    label en official "ask for the sum of the year's payment interest";
    when tax_attributable_to_payment_453l3(p, y, slot, disposition, received_on, tax);
    then payment_interest_year_sum_sum_request(p, y);
}

relation payment_interest_year_sum_sum_request(p: Person, y: TaxableYear) kind institutional {
    label en official "helper: the ordinal-slot sum of the interest on the payments received in the taxable year is requested";
}
relation payment_interest_year_sum_slot_present(p: Person, y: TaxableYear, slot: Integer) kind institutional {
    label en official "helper: slot number has a the interest on the payments received in the taxable year value";
}
rule PaymentInterestYearSumSlotPresent(p: Person, y: TaxableYear, slot: Integer, v: Money) defeasible {
    label en official "a slot with a value is present";
    when payment_interest_453l3(p, y, slot, v);
    then payment_interest_year_sum_slot_present(p, y, slot);
}
pub relation payment_interest_year_sum_total(p: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of the interest on the payments received in the taxable year over the ordinal slots 1 to 12 (bounded unrolling: the language cannot sum a derived relation; more than 12 slots are not summed and give no total)";
}
relation payment_interest_year_sum_sum_0(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum before the first slot";
}
rule PaymentInterestYearSumSum0(p: Person, y: TaxableYear) defeasible {
    label en official "the sum starts at zero";
    when payment_interest_year_sum_sum_request(p, y);
    then payment_interest_year_sum_sum_0(p, y, 0.00 USD);
}
relation payment_interest_year_sum_sum_1(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 1";
}
rule PaymentInterestYearSumSum1Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 1 has a value: add it";
    when payment_interest_year_sum_sum_0(p, y, acc);
    when payment_interest_453l3(p, y, 1, v);
    then payment_interest_year_sum_sum_1(p, y, acc + v);
}
rule PaymentInterestYearSumSum1Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 1 is empty: keep the sum";
    when payment_interest_year_sum_sum_0(p, y, acc);
    when not_known(payment_interest_year_sum_slot_present(p, y, 1));
    then payment_interest_year_sum_sum_1(p, y, acc);
}
relation payment_interest_year_sum_sum_2(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 2";
}
rule PaymentInterestYearSumSum2Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 2 has a value: add it";
    when payment_interest_year_sum_sum_1(p, y, acc);
    when payment_interest_453l3(p, y, 2, v);
    then payment_interest_year_sum_sum_2(p, y, acc + v);
}
rule PaymentInterestYearSumSum2Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 2 is empty: keep the sum";
    when payment_interest_year_sum_sum_1(p, y, acc);
    when not_known(payment_interest_year_sum_slot_present(p, y, 2));
    then payment_interest_year_sum_sum_2(p, y, acc);
}
relation payment_interest_year_sum_sum_3(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 3";
}
rule PaymentInterestYearSumSum3Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 3 has a value: add it";
    when payment_interest_year_sum_sum_2(p, y, acc);
    when payment_interest_453l3(p, y, 3, v);
    then payment_interest_year_sum_sum_3(p, y, acc + v);
}
rule PaymentInterestYearSumSum3Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 3 is empty: keep the sum";
    when payment_interest_year_sum_sum_2(p, y, acc);
    when not_known(payment_interest_year_sum_slot_present(p, y, 3));
    then payment_interest_year_sum_sum_3(p, y, acc);
}
