    label en official "running sum through slot 4";
}
rule PaymentInterestYearSumSum4Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 4 has a value: add it";
    when payment_interest_year_sum_sum_3(p, y, acc);
