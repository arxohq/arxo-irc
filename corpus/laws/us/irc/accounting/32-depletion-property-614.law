// Section 614 (stage 3, DECISION-0379 with deontics): the depletion "property":
// each separate interest owned by the taxpayer in each mineral deposit in each
// separate tract, the combination of operating mineral interests in oil and gas
// wells and geothermal deposits, unitization and pooling, the mine aggregation
// and separate-property elections, and the nonoperating-interest permission.
//
// Model: interests, tracts, mines, aggregations and unit plans are case-numbered
// integers. The result is the relation `interests_form_one_property_614(p, i, j)`
// (two interests are one depletion property); an interest that forms no such
// pair is its own property (section 614(a)). Regulations named by the text
// (unitization and pooling in (b)(3)(A), the allocation of (c)(2), the manner
// of the elections) are not prescribed here: the facts they would decide are
// case facts and each such row says so.

use self::{
    IRC_S468_D,
    IRC_S614_A,
    IRC_S614_B,
    IRC_S614_C,
    IRC_S614_E,
    Person,
    Secretary,
    reserve_property_is_section_614_property_468,
};

pub enum DepositKind614 {
    OilAndGasWell;
    GeothermalDeposit;
    OtherMineralDeposit;
    label en official "the kind of natural deposit an interest is in: oil and gas wells and geothermal deposits (section 614(b)) or another mine, well, or natural deposit (section 614(c))";
}
pub enum UnitPlanAgreement614 {
    VoluntaryAgreement;
    CompulsoryAgreement;
    label en official "a voluntary or compulsory unitization or pooling agreement (section 614(b)(3))";
}

// ===================== (a), (d), (e)(2): the interests =====================

pub relation owns_interest_in_deposit_614(p: Person, interest: Integer) kind empirical {
    label en official "the taxpayer owns a separate interest in a mineral deposit in a separate tract or parcel of land (section 614(a))";
}
pub relation interest_deposit_kind_614(interest: Integer, kind: DepositKind614) kind empirical {
    label en official "the kind of natural deposit the interest is in";
}
pub relation interest_in_tract_614(p: Person, interest: Integer, tract: Integer) kind empirical {
    label en official "the interest is in the tract or parcel of land";
}
pub relation production_costs_taken_into_account_for_613_limit_614d(p: Person, interest: Integer) kind empirical {
    label en official "the costs of production of the mineral from the interest are required to be taken into account by the taxpayer for the taxable income limitation of section 613 (section 614(d))";
}
pub relation would_be_taken_into_account_if_in_production_stage_614d(p: Person, interest: Integer) kind empirical {
    label en official "the costs of production would be so required if the mine, well, or other natural deposit were in the production stage (section 614(d))";
}
pub relation operating_mineral_interest_614d(p: Person, interest: Integer) kind institutional {
    label en official "an operating mineral interest: an interest whose production costs are, or in the production stage would be, taken into account for the section 613 limitation (section 614(d))";
}
rule OperatingInterestByProductionCosts(p: Person, interest: Integer) strict {
    label en official "an interest whose production costs enter the section 613 limitation is operating (section 614(d))";
    when owns_interest_in_deposit_614(p, interest);
    when production_costs_taken_into_account_for_613_limit_614d(p, interest);
    then operating_mineral_interest_614d(p, interest);
}
rule OperatingInterestIfInProductionStage(p: Person, interest: Integer) strict {
    label en official "an interest whose production costs would enter the section 613 limitation in the production stage is operating (section 614(d))";
    when owns_interest_in_deposit_614(p, interest);
    when would_be_taken_into_account_if_in_production_stage_614d(p, interest);
    then operating_mineral_interest_614d(p, interest);
}
pub relation nonoperating_mineral_interest_614e2(p: Person, interest: Integer) kind institutional {
    label en official "a nonoperating mineral interest: an interest that is not an operating mineral interest (section 614(e)(2))";
}
@source(IRC_S614_E, quote = "the term \"nonoperating mineral interests\" includes only interests which are not operating mineral interests.")
rule NonoperatingMineralInterest(p: Person, interest: Integer) defeasible {
    label en official "an owned interest that is not operating is nonoperating (section 614(e)(2))";
    when owns_interest_in_deposit_614(p, interest);
    when not_known(operating_mineral_interest_614d(p, interest));
    then nonoperating_mineral_interest_614e2(p, interest);
}
pub relation oil_gas_or_geothermal_interest_614b(interest: Integer) kind institutional {
    label en official "the interest is in an oil or gas well or a geothermal deposit (section 614(b))";
}
rule OilAndGasInterest(interest: Integer) strict {
    label en official "an oil and gas well interest is within section 614(b)";
    when interest_deposit_kind_614(interest, OilAndGasWell);
    then oil_gas_or_geothermal_interest_614b(interest);
}
rule GeothermalInterest(interest: Integer) strict {
    label en official "a geothermal deposit interest is within section 614(b)";
    when interest_deposit_kind_614(interest, GeothermalDeposit);
    then oil_gas_or_geothermal_interest_614b(interest);
}

// ===================== (b)(3): unitization and pooling =====================

pub relation participates_in_unit_plan_614b3(p: Person, interest: Integer, plan: Integer) kind empirical {
    label en official "the operating mineral interest participates in a single cooperative or unit plan of operation under a unitization or pooling agreement for the period of participation (section 614(b)(3)(A))";
}
pub relation unit_plan_agreement_kind_614b3(plan: Integer, kind: UnitPlanAgreement614) kind empirical {
    label en official "the plan's agreement is voluntary or compulsory";
}
pub relation unit_plan_interests_same_or_logically_joint_deposit_614b3Bi(plan: Integer) kind empirical {
    label en official "all operating mineral interests covered by the voluntary agreement are in the same deposit, or in two or more deposits whose joint development or production is logical from the standpoint of geology, convenience, economy, or conservation (section 614(b)(3)(B)(i)); an adjudicated fact (DECISION-0194)";
}
pub relation unit_plan_interests_contiguous_or_in_close_proximity_614b3Bii(plan: Integer) kind empirical {
    label en official "the tracts or parcels of land of the interests covered are contiguous or in close proximity (section 614(b)(3)(B)(ii)); an adjudicated fact (DECISION-0194)";
}
pub relation unit_plan_qualifies_614b3(plan: Integer) kind institutional {
    label en official "the unit plan qualifies under section 614(b)(3): a compulsory agreement always; a voluntary agreement only if conditions (B)(i) and (B)(ii) hold";
}
rule CompulsoryUnitPlanQualifies(plan: Integer) strict {
    label en official "a compulsory unitization or pooling agreement is within (b)(3)(A) without the (B) limitation (section 614(b)(3)(B): 'a voluntary agreement only if')";
    when unit_plan_agreement_kind_614b3(plan, CompulsoryAgreement);
    then unit_plan_qualifies_614b3(plan);
}
@source(IRC_S614_B, quote = "Subparagraph (A) shall apply to a voluntary agreement only if all the operating mineral interests covered by such agreement—")
rule VoluntaryUnitPlanQualifiesUnderLimitation(plan: Integer) strict {
    label en official "a voluntary agreement qualifies only when its interests share a deposit (or logically joint deposits) and lie in contiguous or closely proximate tracts (section 614(b)(3)(B))";
    when unit_plan_agreement_kind_614b3(plan, VoluntaryAgreement);
    when unit_plan_interests_same_or_logically_joint_deposit_614b3Bi(plan);
    when unit_plan_interests_contiguous_or_in_close_proximity_614b3Bii(plan);
    then unit_plan_qualifies_614b3(plan);
}
pub relation interest_participates_in_qualifying_unit_plan_614b3(p: Person, interest: Integer) kind institutional {
    label en official "the interest participates in a qualifying unit plan, so paragraphs (1), (2) and (4) are suspended for it (section 614(b)(3)(A)(ii))";
}
rule InterestInQualifyingUnitPlan(p: Person, interest: Integer, plan: Integer) strict {
    label en official "participation in a qualifying plan of operation suspends the combination rules for the interest (section 614(b)(3)(A)(ii))";
    when participates_in_unit_plan_614b3(p, interest, plan);
    when unit_plan_qualifies_614b3(plan);
    then interest_participates_in_qualifying_unit_plan_614b3(p, interest);
}
pub relation interests_one_property_by_unitization_614b3(p: Person, i: Integer, j: Integer) kind institutional {
    label en official "two operating interests participating in the same qualifying unit plan are treated for all purposes of the subtitle as one property for the period of participation (section 614(b)(3)(A)(i))";
}
@source(IRC_S614_B, quote = "they shall be treated for all purposes of this subtitle as one property, and")
rule UnitPlanParticipantsAreOneProperty(p: Person, i: Integer, j: Integer, plan: Integer) strict {
    label en official "interests in the same qualifying unit plan are one property (section 614(b)(3)(A)(i)); the regulations the text names are not modelled";
    when participates_in_unit_plan_614b3(p, i, plan);
    when participates_in_unit_plan_614b3(p, j, plan);
    when unit_plan_qualifies_614b3(plan);
    when operating_mineral_interest_614d(p, i);
    when operating_mineral_interest_614d(p, j);
    when i != j;
    then interests_one_property_by_unitization_614b3(p, i, j);
}

// ===================== (b)(1): combination per tract =====================

pub relation separate_property_election_in_effect_614b2(p: Person, interest: Integer) kind institutional {
    label en official "the section 614(b)(2) election to treat the operating mineral interest as a separate property is in effect";
}
pub relation interests_combined_in_tract_614b1A(p: Person, i: Integer, j: Integer) kind institutional {
    label en official "two operating mineral interests of the taxpayer in oil and gas wells or geothermal deposits in the same tract or parcel of land are combined and treated as one property (section 614(b)(1)(A))";
}
@source(IRC_S614_B, quote = "all of the taxpayer's operating mineral interests in a separate tract or parcel of land shall be combined and treated as one property, and")
rule OperatingInterestsInSameTractCombined(p: Person, i: Integer, j: Integer, tract: Integer) defeasible {
    label en official "operating interests in oil, gas, or geothermal deposits in one tract are combined, except an interest elected separate under (b)(2) or suspended by unitization under (b)(3)(A)(ii) (section 614(b)(1)(A))";
    when operating_mineral_interest_614d(p, i);
    when operating_mineral_interest_614d(p, j);
    when oil_gas_or_geothermal_interest_614b(i);
    when oil_gas_or_geothermal_interest_614b(j);
    when interest_in_tract_614(p, i, tract);
    when interest_in_tract_614(p, j, tract);
    when i != j;
    when not_known(separate_property_election_in_effect_614b2(p, i));
    when not_known(separate_property_election_in_effect_614b2(p, j));
    when not_known(interest_participates_in_qualifying_unit_plan_614b3(p, i));
    when not_known(interest_participates_in_qualifying_unit_plan_614b3(p, j));
    then interests_combined_in_tract_614b1A(p, i, j);
}
pub relation taxpayer_combines_interests_614b1B(p: Person, i: Integer, j: Integer) kind empirical {
    label en official "the taxpayer combines an operating mineral interest in one tract with an operating mineral interest in another tract";
}
pub relation interests_in_different_tracts_614b1B(p: Person, i: Integer, j: Integer) kind institutional {
    label en official "two operating oil, gas, or geothermal interests lie in different tracts and are not united by a qualifying unit plan, so they may not be combined (section 614(b)(1)(B))";
}
rule OperatingInterestsInDifferentTractsNotCombinable(p: Person, i: Integer, j: Integer, t1: Integer, t2: Integer) defeasible {
    label en official "operating interests in different tracts may not be combined (section 614(b)(1)(B)); a qualifying unit plan (b)(3) is the exception";
    when operating_mineral_interest_614d(p, i);
    when operating_mineral_interest_614d(p, j);
    when oil_gas_or_geothermal_interest_614b(i);
    when oil_gas_or_geothermal_interest_614b(j);
    when interest_in_tract_614(p, i, t1);
    when interest_in_tract_614(p, j, t2);
    when t1 != t2;
    when not_known(interests_one_property_by_unitization_614b3(p, i, j));
    then interests_in_different_tracts_614b1B(p, i, j);
}
@source(IRC_S614_B, quote = "the taxpayer may not combine an operating mineral interest in one tract or parcel of land with an operating mineral interest in another tract or parcel of land.")
rule Section614b1BNoCrossTractCombinationProhibition(p: Person, i: Integer, j: Integer) defeasible {
    label en official "the taxpayer must not combine operating interests of different tracts (section 614(b)(1)(B)); doing so breaches the prohibition";
    when interests_in_different_tracts_614b1B(p, i, j);
    then prohibition Section614b1BNoCrossTractCombination {
        bearer p;
        action taxpayer_combines_interests_614b1B(p, i, j);
        window [-infinity, infinity];
    };
}

// ===================== (b)(2), (b)(4): the separate-property election =====================

pub relation more_than_one_operating_interest_in_tract_614b2(p: Person, interest: Integer) kind institutional {
    label en official "the taxpayer has more than one operating mineral interest in the single tract or parcel of land in which the interest lies (section 614(b)(2))";
}
rule MoreThanOneOperatingInterestInTract(p: Person, i: Integer, j: Integer, tract: Integer) strict {
    label en official "a second operating interest in the same tract exists";
    when operating_mineral_interest_614d(p, i);
    when operating_mineral_interest_614d(p, j);
    when interest_in_tract_614(p, i, tract);
    when interest_in_tract_614(p, j, tract);
    when i != j;
    then more_than_one_operating_interest_in_tract_614b2(p, i);
}
pub relation elects_separate_property_614b2(p: Person, interest: Integer) kind empirical {
    label en official "the taxpayer elects to treat the operating mineral interest as a separate property (section 614(b)(2))";
}
pub relation separate_election_made_timely_614b4A(p: Person, interest: Integer) kind empirical {
    label en official "the election is made in the manner prescribed by the Secretary, not later than the time (with extensions) for filing the return for the first taxable year in which an expenditure for development or operation in respect of the interest is made after its acquisition (section 614(b)(4)(A))";
}
pub relation separate_property_election_valid_614b2(p: Person, interest: Integer) kind institutional {
    label en official "the section 614(b)(2) election is available: more than one operating interest in the tract and a timely election (section 614(b)(2), (b)(4)(A)); the manner is prescribed by regulations";
}
rule SeparatePropertyElectionValidConditions(p: Person, interest: Integer) strict {
    label en official "availability of the separate-property election (section 614(b)(2), (b)(4)(A))";
    when more_than_one_operating_interest_in_tract_614b2(p, interest);
    when separate_election_made_timely_614b4A(p, interest);
    then separate_property_election_valid_614b2(p, interest);
}
@source(IRC_S614_B, quote = "he may elect to treat one or more of such operating mineral interests as separate properties.")
rule Section614b2SeparatePropertyElectionPower(p: Person, interest: Integer) strict {
    label en official "a taxpayer with several operating interests in a tract may elect to treat interests as separate properties (section 614(b)(2))";
    when elects_separate_property_614b2(p, interest);
    then power Section614b2SeparatePropertyElection {
        holder p;
        over interest;
        exercise elects_separate_property_614b2(p, interest);
        valid_when separate_property_election_valid_614b2(p, interest);
        effect create(separate_property_election_in_effect_614b2(p, interest));
        window [@1954-08-16, infinity);
    };
}
pub relation separate_election_binding_for_all_purposes_and_years_614b4B(p: Person, interest: Integer) kind institutional {
    label en official "the election is for all purposes of the subtitle and binding on the taxpayer for all subsequent taxable years (section 614(b)(4)(B))";
}
@source(IRC_S614_B, quote = "shall be for all purposes of this subtitle and shall be binding on the taxpayer for all subsequent taxable years.")
rule SeparateElectionBinding(p: Person, interest: Integer) defeasible {
    label en official "the separate-property election is permanent for all years (section 614(b)(4)(B)); the interest-level fact is not year-keyed";
    when separate_property_election_in_effect_614b2(p, interest);
    then separate_election_binding_for_all_purposes_and_years_614b4B(p, interest);
}
pub relation combinations_in_tract_count_614b2(p: Person, tract: Integer, n: Integer) kind empirical {
    label en official "the number of combinations of operating mineral interests the taxpayer has in the tract or parcel of land";
}
pub relation has_more_than_one_combination_in_tract_614b2(p: Person, tract: Integer) kind empirical {
    label en official "the taxpayer has more than one combination of operating mineral interests in a single tract or parcel of land";
}
@source(IRC_S614_B, quote = "The taxpayer may not have more than one combination of operating mineral interests in a single tract or parcel of land.")
rule Section614b2SingleCombinationProhibition(p: Person, tract: Integer, n: Integer) defeasible {
    label en official "the taxpayer may not maintain more than one combination in a tract (section 614(b)(2), second sentence)";
    when combinations_in_tract_count_614b2(p, tract, n);
    when n > 1;
    then prohibition Section614b2SingleCombination {
        bearer p;
        action has_more_than_one_combination_in_tract_614b2(p, tract);
        window [-infinity, infinity];
    };
}
pub relation election_614b2_made_for_interest_in_tract_614b2(p: Person, tract: Integer) kind empirical {
    label en official "the taxpayer has made the section 614(b)(2) election with respect to an interest in the tract, for a taxable year before the later interest was discovered or acquired";
}
pub relation later_interest_discovered_or_acquired_614b2(p: Person, interest: Integer, tract: Integer) kind empirical {
    label en official "the operating mineral interest is discovered or acquired in the tract after the taxable year for which the election was made";
}
pub relation tract_has_combination_of_interests_614b2(p: Person, tract: Integer) kind empirical {
    label en official "there is a combination of interests in the tract";
}
pub relation elects_to_combine_later_interest_614b2A(p: Person, interest: Integer) kind empirical {
    label en official "the taxpayer elects to combine the later interest with another interest (section 614(b)(2)(A))";
}
pub relation elects_separate_treatment_of_later_interest_614b2B(p: Person, interest: Integer) kind empirical {
    label en official "the taxpayer elects to treat the later interest as a separate property (section 614(b)(2)(B))";
}
pub relation later_interest_treated_as_separate_property_614b2A(p: Person, interest: Integer) kind institutional {
    label en official "where there is no combination in the tract the later interest is a separate property unless the taxpayer elects to combine it (section 614(b)(2)(A)); or, where there is a combination, the taxpayer elects it separate (section 614(b)(2)(B))";
}
@source(IRC_S614_B, quote = "(A) if there is no combination of interests in such tract or parcel, as a separate property unless the taxpayer elects to combine it with another interest, or")
rule LaterInterestSeparateWhenNoCombination(p: Person, interest: Integer, tract: Integer) defeasible {
    label en official "no combination in the tract: the later interest is separate unless the taxpayer elects to combine it (section 614(b)(2)(A))";
    when election_614b2_made_for_interest_in_tract_614b2(p, tract);
    when later_interest_discovered_or_acquired_614b2(p, interest, tract);
    when not_known(tract_has_combination_of_interests_614b2(p, tract));
    when not_known(elects_to_combine_later_interest_614b2A(p, interest));
    then later_interest_treated_as_separate_property_614b2A(p, interest);
}
rule LaterInterestSeparateByElectionWhenCombination(p: Person, interest: Integer, tract: Integer) defeasible {
    label en official "a combination in the tract: the later interest is separate only if the taxpayer so elects (section 614(b)(2)(B))";
    when election_614b2_made_for_interest_in_tract_614b2(p, tract);
    when later_interest_discovered_or_acquired_614b2(p, interest, tract);
    when tract_has_combination_of_interests_614b2(p, tract);
    when elects_separate_treatment_of_later_interest_614b2B(p, interest);
    then later_interest_treated_as_separate_property_614b2A(p, interest);
}
pub relation later_interest_part_of_combination_614b2B(p: Person, interest: Integer, tract: Integer) kind institutional {
    label en official "the later interest is part of the combination in the tract (section 614(b)(2)(B)), or is combined by election where none existed (section 614(b)(2)(A))";
}
@source(IRC_S614_B, quote = "(B) if there is a combination of interests in such tract or parcel, as part of such combination unless the taxpayer elects to treat it as a separate property.")
rule LaterInterestPartOfCombination(p: Person, interest: Integer, tract: Integer) defeasible {
    label en official "a combination exists: the later interest joins it unless the taxpayer elects it separate (section 614(b)(2)(B))";
    when election_614b2_made_for_interest_in_tract_614b2(p, tract);
    when later_interest_discovered_or_acquired_614b2(p, interest, tract);
    when tract_has_combination_of_interests_614b2(p, tract);
    when not_known(elects_separate_treatment_of_later_interest_614b2B(p, interest));
    then later_interest_part_of_combination_614b2B(p, interest, tract);
}
rule LaterInterestCombinedByElectionWhereNoneExisted(p: Person, interest: Integer, tract: Integer) defeasible {
    label en official "no combination existed but the taxpayer elects to combine the later interest with another (section 614(b)(2)(A))";
    when election_614b2_made_for_interest_in_tract_614b2(p, tract);
    when later_interest_discovered_or_acquired_614b2(p, interest, tract);
    when not_known(tract_has_combination_of_interests_614b2(p, tract));
    when elects_to_combine_later_interest_614b2A(p, interest);
    then later_interest_part_of_combination_614b2B(p, interest, tract);
}

// ===================== (c): mines =====================

pub relation interest_part_of_operating_unit_614c1(p: Person, interest: Integer, unit: Integer) kind empirical {
    label en official "the separate operating mineral interest constitutes part or all of an operating unit (section 614(c)(1))";
}
pub relation owns_two_or_more_operating_interests_of_operating_unit_614c1(p: Person, interest: Integer) kind institutional {
    label en official "the taxpayer owns two or more separate operating mineral interests of the operating unit that includes the interest, outside oil, gas, and geothermal deposits (section 614(c)(1))";
}
rule TwoOrMoreOperatingInterestsOfUnit(p: Person, i: Integer, j: Integer, unit: Integer) strict {
    label en official "a second operating interest of the same operating unit exists (section 614(c)(1))";
    when operating_mineral_interest_614d(p, i);
    when operating_mineral_interest_614d(p, j);
    when interest_part_of_operating_unit_614c1(p, i, unit);
    when interest_part_of_operating_unit_614c1(p, j, unit);
    when interest_deposit_kind_614(i, OtherMineralDeposit);
    when i != j;
    then owns_two_or_more_operating_interests_of_operating_unit_614c1(p, i);
}
pub relation elects_aggregation_614c1(p: Person, interest: Integer, aggregation: Integer) kind empirical {
    label en official "the taxpayer elects to include the interest in an aggregation, treated as one property (section 614(c)(1)(A))";
}
pub relation aggregation_election_made_timely_614c3(p: Person, interest: Integer) kind empirical {
    label en official "the election is made in accordance with regulations not later than the time (with extensions) for filing the return for the first taxable year in which an expenditure for development or operation in respect of the interest is made after its acquisition (section 614(c)(3)(A))";
}
pub relation aggregation_election_valid_614c1(p: Person, interest: Integer) kind institutional {
    label en official "the aggregation election is available: two or more operating interests of an operating unit outside oil, gas, and geothermal deposits, made timely (section 614(c)(1), (c)(3)(A))";
}
rule AggregationElectionValidConditions(p: Person, interest: Integer) strict {
    label en official "availability of the aggregation election (section 614(c)(1), (c)(3)(A))";
    when owns_two_or_more_operating_interests_of_operating_unit_614c1(p, interest);
    when aggregation_election_made_timely_614c3(p, interest);
    then aggregation_election_valid_614c1(p, interest);
}
pub relation aggregation_election_in_effect_614c1(p: Person, interest: Integer, aggregation: Integer) kind institutional {
    label en official "the interest belongs to an aggregation formed by election, all of whose interests are one property (section 614(c)(1)(A))";
}
@source(IRC_S614_C, quote = "(A) to form an aggregation of, and to treat as one property, all such interests owned by him which comprise any one mine or any two or more mines; and")
rule Section614c1AggregationElectionPower(p: Person, interest: Integer, aggregation: Integer) strict {
    label en official "a taxpayer may elect to aggregate operating interests of a mine or mines outside oil, gas, and geothermal deposits (section 614(c)(1)(A)); more than one aggregation may be formed within one operating unit";
    when elects_aggregation_614c1(p, interest, aggregation);
    then power Section614c1AggregationElection {
        holder p;
        over interest;
        exercise elects_aggregation_614c1(p, interest, aggregation);
        valid_when aggregation_election_valid_614c1(p, interest);
        effect create(aggregation_election_in_effect_614c1(p, interest, aggregation));
        window [@1954-08-16, infinity);
    };
}
pub relation interests_one_property_by_aggregation_614c1(p: Person, i: Integer, j: Integer) kind institutional {
    label en official "two interests in the same elected aggregation are one property, whether or not in one tract or in contiguous tracts (section 614(c)(1), fourth sentence)";
}
@source(IRC_S614_C, quote = "separate operating mineral interests which constitute part or all of an operating unit may be aggregated whether or not they are included in a single tract or parcel of land and whether or not they are included in contiguous tracts or parcels.")
rule AggregatedInterestsAreOneProperty(p: Person, i: Integer, j: Integer, aggregation: Integer) defeasible {
    label en official "interests in one aggregation are a single property regardless of tract location (section 614(c)(1))";
    when aggregation_election_in_effect_614c1(p, i, aggregation);
    when aggregation_election_in_effect_614c1(p, j, aggregation);
    when i != j;
    then interests_one_property_by_aggregation_614c1(p, i, j);
}
pub relation interest_not_in_aggregation_is_separate_property_614c1B(p: Person, interest: Integer) kind institutional {
    label en official "an interest of an operating unit that is not included within an aggregation is treated as a separate property (section 614(c)(1)(B))";
}
@source(IRC_S614_C, quote = "(B) to treat as a separate property each such interest which is not included within an aggregation referred to in subparagraph (A).")
rule InterestOutsideAggregationSeparateProperty(p: Person, interest: Integer) defeasible {
    label en official "an interest left out of the aggregation election is its own property (section 614(c)(1)(B))";
    when owns_two_or_more_operating_interests_of_operating_unit_614c1(p, interest);
    when not_known(interest_in_any_aggregation_614c1(p, interest));
    then interest_not_in_aggregation_is_separate_property_614c1B(p, interest);
}
pub relation interest_in_any_aggregation_614c1(p: Person, interest: Integer) kind institutional {
    label en official "the interest belongs to some aggregation (bridge for the `not_known` test)";
}
rule InterestInAnyAggregationBridge(p: Person, interest: Integer, aggregation: Integer) defeasible {
    label en official "bridge";
    when aggregation_election_in_effect_614c1(p, interest, aggregation);
    then interest_in_any_aggregation_614c1(p, interest);
}
pub relation aggregation_includes_part_of_mine_but_omits_other_interest_614c1(p: Person, aggregation: Integer) kind empirical {
    label en official "an aggregation includes an operating interest that is part of a mine without including all operating interests that are part of that mine in the first taxable year for which the election to aggregate is effective";
}
pub relation aggregation_has_partial_mine_614c1(p: Person, aggregation: Integer) kind institutional {
    label en official "the aggregation is one the election may not form because it splits a mine (section 614(c)(1), last sentence)";
}
@source(IRC_S614_C, quote = "no aggregation may include any operating mineral interest which is a part of a mine without including all of the operating mineral interests which are a part of such mine in the first taxable year for which the election to aggregate is effective")
rule Section614c1NoPartialMineAggregationProhibition(p: Person, interest: Integer, aggregation: Integer) defeasible {
    label en official "an aggregation must include all operating interests of each mine it touches (section 614(c)(1)); an aggregation that omits one breaches the prohibition";
    when aggregation_election_in_effect_614c1(p, interest, aggregation);
    then prohibition Section614c1NoPartialMineAggregation {
        bearer p;
        action aggregation_includes_part_of_mine_but_omits_other_interest_614c1(p, aggregation);
        window [-infinity, infinity];
    };
}
pub relation interest_becomes_part_of_mine_614c1(p: Person, interest: Integer, mine: Integer) kind empirical {
    label en official "an operating mineral interest thereafter becomes a part of the mine";
}
pub relation aggregation_covers_mine_614c1(p: Person, aggregation: Integer, mine: Integer) kind empirical {
    label en official "the aggregation includes the operating mineral interests of the mine";
}
pub relation interest_must_be_included_in_aggregation_614c1(p: Person, interest: Integer, aggregation: Integer) kind institutional {
    label en official "an interest that thereafter becomes part of a mine in an aggregation is included in that aggregation (section 614(c)(1), last sentence)";
}
@source(IRC_S614_C, quote = "any operating mineral interest which thereafter becomes a part of such mine shall be included in such aggregation.")
rule LaterInterestOfMineJoinsAggregation(p: Person, interest: Integer, aggregation: Integer, mine: Integer) defeasible {
    label en official "a later interest of the aggregated mine is included in the aggregation (section 614(c)(1))";
    when interest_becomes_part_of_mine_614c1(p, interest, mine);
    when aggregation_covers_mine_614c1(p, aggregation, mine);
    then interest_must_be_included_in_aggregation_614c1(p, interest, aggregation);
}
pub relation mine_in_tract_with_expenditures_614c2(p: Person, tract: Integer, mine: Integer) kind empirical {
    label en official "the mineral deposit in the tract is or will be extracted by a mine for which expenditures for development or operation have been made by the taxpayer (section 614(c)(2))";
}
pub relation tract_of_aggregation_part_614c2(p: Person, tract: Integer) kind empirical {
    label en official "the property (tract) is part of an aggregation formed by the taxpayer under paragraph (1) (section 614(c)(2), last sentence)";
}
pub relation secretary_consents_to_split_of_aggregated_property_614c2(p: Person, tract: Integer) kind empirical {
    label en official "the Secretary consents to the election for a property that is part of an aggregation (section 614(c)(2), last sentence)";
}
pub relation tract_has_two_or_more_mines_614c2(p: Person, tract: Integer) kind institutional {
    label en official "a single tract contains a deposit extracted by two or more mines with development or operation expenditures (section 614(c)(2))";
}
rule TractHasTwoOrMoreMines(p: Person, tract: Integer, m1: Integer, m2: Integer) strict {
    label en official "two distinct mines with expenditures in one tract (section 614(c)(2))";
    when mine_in_tract_with_expenditures_614c2(p, tract, m1);
    when mine_in_tract_with_expenditures_614c2(p, tract, m2);
    when m1 != m2;
    then tract_has_two_or_more_mines_614c2(p, tract);
}
pub relation elects_mine_split_614c2(p: Person, tract: Integer) kind empirical {
    label en official "the taxpayer elects to allocate the tract and its deposit to the mines and to treat each allocated portion as a separate property (section 614(c)(2))";
}
pub relation mine_split_election_valid_614c2(p: Person, tract: Integer) kind institutional {
    label en official "the section 614(c)(2) election is available: two or more mines in the tract, and, if the tract is part of an aggregation, the Secretary's consent";
}
rule MineSplitElectionValidWithoutAggregation(p: Person, tract: Integer) strict {
    label en official "a tract not part of an aggregation with two or more mines may elect (section 614(c)(2))";
    when tract_has_two_or_more_mines_614c2(p, tract);
    when not_known(tract_of_aggregation_part_614c2(p, tract));
    then mine_split_election_valid_614c2(p, tract);
}
rule MineSplitElectionValidWithConsent(p: Person, tract: Integer) strict {
    label en official "a tract that is part of an aggregation may elect only with the Secretary's consent (section 614(c)(2))";
    when tract_has_two_or_more_mines_614c2(p, tract);
    when secretary_consents_to_split_of_aggregated_property_614c2(p, tract);
    then mine_split_election_valid_614c2(p, tract);
}
pub relation mine_split_election_in_effect_614c2(p: Person, tract: Integer) kind institutional {
    label en official "the tract is treated as separate properties allocated to the mines, for all purposes of the subtitle (section 614(c)(2), second sentence)";
}
@source(IRC_S614_C, quote = "then the taxpayer may elect to allocate to such mines, under regulations prescribed by the Secretary, all of the tract or parcel of land and of the mineral deposit contained therein, and to treat as a separate property that portion of the tract or parcel of land and of the mineral deposit so allocated to each mine.")
rule Section614c2MineSplitElectionPower(p: Person, tract: Integer) strict {
    label en official "a taxpayer may treat the portions of one tract allocated to different mines as separate properties (section 614(c)(2)); the allocation is by regulations and is not computed";
    when elects_mine_split_614c2(p, tract);
    then power Section614c2MineSplitElection {
        holder p;
        over tract;
        exercise elects_mine_split_614c2(p, tract);
        valid_when mine_split_election_valid_614c2(p, tract);
        effect create(mine_split_election_in_effect_614c2(p, tract));
        window [@1954-08-16, infinity);
    };
}
pub relation secretary_consents_to_different_treatment_614c3(p: Person, interest: Integer) kind empirical {
    label en official "the Secretary consents to a different treatment of an interest with respect to which an election under paragraph (1) or (2) was made (section 614(c)(3), last sentence)";
}
pub relation mine_election_binding_614c3(p: Person, interest: Integer) kind institutional {
    label en official "an election under paragraph (1) or (2) is binding for the year and all subsequent years, unless the Secretary consents to a different treatment (section 614(c)(3))";
}
@source(IRC_S614_C, quote = "An election made under paragraph (1) or (2) for a taxable year shall be binding upon the taxpayer for such year and all subsequent taxable years")
rule MineElectionBindingUnlessSecretaryConsents(p: Person, interest: Integer, aggregation: Integer) defeasible {
    label en official "the aggregation election binds for all later years except where the Secretary consents to a different treatment (section 614(c)(3)); the interest-level fact is not year-keyed";
    when aggregation_election_in_effect_614c1(p, interest, aggregation);
    then mine_election_binding_614c3(p, interest);
    unless secretary_consents_to_different_treatment_614c3(p, interest);
}

// ===================== (e)(1): nonoperating interests =====================

pub relation nonoperating_interest_mineral_kind_614e1(interest: Integer, mineral: Text) kind empirical {
    label en official "the separate kind of mineral deposit the interest is in (section 614(e)(1))";
}
pub relation tracts_adjacent_614e1(t1: Integer, t2: Integer) kind empirical {
    label en official "the two tracts or parcels of land are adjacent (section 614(e)(1))";
}
pub relation no_principal_purpose_of_tax_avoidance_shown_614e1(p: Person, mineral: Text) kind empirical {
    label en official "the taxpayer shows that a principal purpose of treating the interests as one property is not the avoidance of tax (section 614(e)(1)); an adjudicated fact (DECISION-0194)";
}
pub relation secretary_permits_nonoperating_aggregation_614e1(p: Person, mineral: Text) kind empirical {
    label en official "the Secretary permits the taxpayer to treat all nonoperating interests in each separate kind of mineral deposit as one property (section 614(e)(1))";
}
@source(IRC_S614_E, quote = "the Secretary shall, on showing by the taxpayer that a principal purpose is not the avoidance of tax, permit the taxpayer to treat")
rule Section614e1SecretaryPermitsAggregationDuty(p: Person, mineral: Text) defeasible {
    label en official "on the taxpayer's showing that tax avoidance is not a principal purpose the Secretary must permit aggregation of nonoperating interests (section 614(e)(1))";
    when no_principal_purpose_of_tax_avoidance_shown_614e1(p, mineral);
    then duty Section614e1SecretaryPermitsAggregation {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition secretary_permits_nonoperating_aggregation_614e1(p, mineral);
            window [-infinity, infinity];
        }
    };
}
pub relation nonoperating_interests_one_property_614e1(p: Person, i: Integer, j: Integer) kind institutional {
    label en official "two nonoperating mineral interests in the same tract or in adjacent tracts, in the same kind of deposit, are treated as one property once the Secretary permits it (section 614(e)(1))";
}
@source(IRC_S614_E, quote = "all such mineral interests in each separate kind of mineral deposit as one property.")
rule NonoperatingInterestsInSameTractOneProperty(p: Person, i: Integer, j: Integer, tract: Integer, mineral: Text) defeasible {
    label en official "permitted aggregation of nonoperating interests in a single tract (section 614(e)(1))";
    when nonoperating_mineral_interest_614e2(p, i);
    when nonoperating_mineral_interest_614e2(p, j);
    when interest_in_tract_614(p, i, tract);
    when interest_in_tract_614(p, j, tract);
    when nonoperating_interest_mineral_kind_614e1(i, mineral);
    when nonoperating_interest_mineral_kind_614e1(j, mineral);
    when secretary_permits_nonoperating_aggregation_614e1(p, mineral);
    when i != j;
    then nonoperating_interests_one_property_614e1(p, i, j);
}
rule NonoperatingInterestsInAdjacentTractsOneProperty(p: Person, i: Integer, j: Integer, t1: Integer, t2: Integer, mineral: Text) defeasible {
    label en official "permitted aggregation of nonoperating interests in adjacent tracts (section 614(e)(1))";
    when nonoperating_mineral_interest_614e2(p, i);
    when nonoperating_mineral_interest_614e2(p, j);
    when interest_in_tract_614(p, i, t1);
    when interest_in_tract_614(p, j, t2);
    when tracts_adjacent_614e1(t1, t2);
    when nonoperating_interest_mineral_kind_614e1(i, mineral);
    when nonoperating_interest_mineral_kind_614e1(j, mineral);
    when secretary_permits_nonoperating_aggregation_614e1(p, mineral);
    then nonoperating_interests_one_property_614e1(p, i, j);
}
pub relation taxpayer_treats_nonoperating_interests_as_one_property_614e1(p: Person, mineral: Text) kind empirical {
    label en official "the taxpayer treats the permitted interests as one property in the year and in all subsequent years (section 614(e)(1), second sentence)";
}
pub relation secretary_consents_to_different_nonoperating_treatment_614e1(p: Person, mineral: Text) kind empirical {
    label en official "the Secretary consents to a different treatment (section 614(e)(1), second sentence)";
}
@source(IRC_S614_E, quote = "the taxpayer shall treat such interests as one property for all subsequent taxable years unless the Secretary consents to a different treatment.")
rule Section614e1ContinuedAggregationDuty(p: Person, mineral: Text) defeasible {
    label en official "once permission is granted the taxpayer must keep treating the interests as one property, unless the Secretary consents otherwise (section 614(e)(1), second sentence)";
    when secretary_permits_nonoperating_aggregation_614e1(p, mineral);
    then duty Section614e1KeepAggregation {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition taxpayer_treats_nonoperating_interests_as_one_property_614e1(p, mineral);
            window [-infinity, infinity];
        }
    };
    unless secretary_consents_to_different_nonoperating_treatment_614e1(p, mineral);
}

// ===================== the result: one depletion property =====================

pub relation interests_form_one_property_614(p: Person, i: Integer, j: Integer) kind institutional {
    label en official "the two interests are treated as one depletion property: combined in a tract (b)(1)(A), a later interest joining a combination (b)(2), unitized (b)(3), aggregated (c)(1), or nonoperating and permitted (e)(1)";
}
rule OnePropertyByTractCombination(p: Person, i: Integer, j: Integer) defeasible {
    label en official "interests combined in a tract are one property (section 614(b)(1)(A))";
    when interests_combined_in_tract_614b1A(p, i, j);
    then interests_form_one_property_614(p, i, j);
}
rule OnePropertyByUnitization(p: Person, i: Integer, j: Integer) defeasible {
    label en official "unitized interests are one property (section 614(b)(3)(A)(i))";
    when interests_one_property_by_unitization_614b3(p, i, j);
    then interests_form_one_property_614(p, i, j);
}
rule OnePropertyByAggregation(p: Person, i: Integer, j: Integer) defeasible {
    label en official "aggregated interests are one property (section 614(c)(1)(A))";
    when interests_one_property_by_aggregation_614c1(p, i, j);
    then interests_form_one_property_614(p, i, j);
}
rule OnePropertyByNonoperatingPermission(p: Person, i: Integer, j: Integer) defeasible {
    label en official "permitted nonoperating interests are one property (section 614(e)(1))";
    when nonoperating_interests_one_property_614e1(p, i, j);
    then interests_form_one_property_614(p, i, j);
}
rule OnePropertyLaterInterestJoinsCombination(p: Person, i: Integer, j: Integer, k: Integer, tract: Integer) defeasible {
    label en official "a later interest that joins the tract's combination is one property with the combination's interests (section 614(b)(2)(B))";
    when later_interest_part_of_combination_614b2B(p, i, tract);
    when interest_in_tract_614(p, j, tract);
    when interests_combined_in_tract_614b1A(p, j, k);
    then interests_form_one_property_614(p, i, j);
}
pub relation interest_combined_with_other_614(p: Person, interest: Integer) kind institutional {
    label en official "the interest forms one property with another interest (bridge for the section 614(a) default)";
}
rule InterestCombinedWithOtherBridge(p: Person, i: Integer, j: Integer) defeasible {
    label en official "bridge";
    when interests_form_one_property_614(p, i, j);
    then interest_combined_with_other_614(p, i);
}
pub relation depletion_property_614a(p: Person, interest: Integer) kind institutional {
    label en official "a depletion property: each separate interest owned by the taxpayer in each mineral deposit in each separate tract is its own property unless it forms one property with another interest (section 614(a))";
}
@source(IRC_S614_A, quote = "the term \"property\" means each separate interest owned by the taxpayer in each mineral deposit in each separate tract or parcel of land.")
rule EachSeparateInterestIsAProperty(p: Person, interest: Integer) defeasible {
    label en official "each owned separate interest is a property unless it is combined with another (section 614(a))";
    when owns_interest_in_deposit_614(p, interest);
    when not_known(interest_combined_with_other_614(p, interest));
    then depletion_property_614a(p, interest);
}
@source(IRC_S468_D, quote = "The term \"property\" has the meaning given such term by section 614.")
rule Section468dPropertyIsSection614Property(p: Person, interest: Integer) defeasible {
    label en official "a section 614 depletion property is a property for section 468 (section 468(d)(3)); the case-numbered property id is the interest id";
    when depletion_property_614a(p, interest);
    then reserve_property_is_section_614_property_468(interest);
}
