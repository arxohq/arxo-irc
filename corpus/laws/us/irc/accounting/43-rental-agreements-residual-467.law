// Section 467 residual (stage 3, DECISION-0379 with deontics): the derived
// disqualified leaseback or long-term agreement of (b)(4) from the leaseback
// definition of (e)(2), the statutory recovery period of (e)(3), and the term
// of (e)(6); the allocation-based accrual of (b)(1); the total taken into
// account under (a) with the one-year interest term of (a)(2) at the (e)(4)
// rate; the aggregate consideration of (d)(2); and the recapture of (c).
//
// The stage 2b case-fact relations stay; the derived relations below feed the
// same `constant_rental_accrual_required_467` through sibling rules.
//
// Not modelled (TECH-GAPS G4805): the constant rental amount of (e)(1), which
// needs the present value of the payments at the (e)(4) rate compounded
// semiannually over many lease periods (a Decimal power); the multi-year
// carry of unpaid amounts and their interest (asserted as one balance);
// regulations of (b)(5), (c)(5), (e)(6), (f), (g), (h).

// ===================== (e)(2), (e)(5): leaseback transaction =====================

use self::{
    IRC_S467_A,
    IRC_S467_B,
    IRC_S467_C,
    IRC_S467_D,
    IRC_S467_E,
    IRC_S467_TABLE_1,
    Person,
    TaxableYear,
    constant_rental_accrual_required_467,
    is_section_467_rental_agreement,
    parties_to_rental_agreement_467,
    rent_accrued_for_year_467,
    rental_agreement_allocates_rent_in_agreement,
    rental_agreement_has_increasing_rent,
    rental_agreement_has_payment_after_following_calendar_year,
};

pub relation lessee_of_leaseback_467e2(agreement: Integer, lessee: Person, leaseback_on: Date) kind empirical {
    label en official "the agreement is a leaseback of the property to the lessee, entered into on the date (section 467(e)(2))";
}
pub relation person_had_interest_in_property_on_467e2(agreement: Integer, person: Person, interest_on: Date) kind empirical {
    label en official "the person had an interest in the property on the date (section 467(e)(2))";
}
pub relation related_person_467e5(a: Person, b: Person) kind empirical {
    label en official "the persons are related within the meaning of section 465(b)(3)(C) (section 467(e)(5)); the section 465(b)(3)(C) test is asserted";
}
pub relation leaseback_transaction_467e2(agreement: Integer) kind institutional {
    label en official "a leaseback to a person who had an interest in the property within 2 years before the leaseback, or to a related person (section 467(e)(2))";
}
@source(IRC_S467_E, quote = "A transaction is a leaseback transaction if it involves a leaseback to any person who had an interest in such property at any time within 2 years before such leaseback (or to a related person).")
rule LeasebackToPriorInterestHolder(agreement: Integer, lessee: Person, leaseback_on: Date, interest_on: Date) defeasible {
    label en official "the lessee held an interest in the 2 years before the leaseback (section 467(e)(2))";
    when lessee_of_leaseback_467e2(agreement, lessee, leaseback_on);
    when person_had_interest_in_property_on_467e2(agreement, lessee, interest_on);
    when interest_on <= leaseback_on;
    when leaseback_on <= add_calendar_period(interest_on, 24 calendar_month);
    then leaseback_transaction_467e2(agreement);
}
rule LeasebackToRelatedPerson(agreement: Integer, lessee: Person, holder: Person, leaseback_on: Date, interest_on: Date) defeasible {
    label en official "the lessee is related to a person who held an interest within 2 years before the leaseback (section 467(e)(2), (e)(5))";
    when lessee_of_leaseback_467e2(agreement, lessee, leaseback_on);
    when person_had_interest_in_property_on_467e2(agreement, holder, interest_on);
    when related_person_467e5(lessee, holder);
    when interest_on <= leaseback_on;
    when leaseback_on <= add_calendar_period(interest_on, 24 calendar_month);
    then leaseback_transaction_467e2(agreement);
}

// ===================== (e)(3): statutory recovery period =====================

pub enum RecoveryPropertyClass467 {
    ThreeYearProperty;
    FiveYearProperty;
    SevenYearProperty;
    TenYearProperty;
    FifteenOrTwentyYearProperty;
    ResidentialRentalOrNonresidentialRealProperty;
    RailroadGradingOrTunnelBore;
    label en official "the property classes of the table in section 467(e)(3)(A)";
}
pub relation property_class_for_467(agreement: Integer, class: RecoveryPropertyClass467) kind empirical {
    label en official "the property of the agreement belongs to the class (section 467(e)(3)); property to which section 168 does not apply is classed as if section 168 applied (section 467(e)(3)(B))";
}
pub relation statutory_recovery_period_years_467e3(agreement: Integer, years: Integer) kind institutional {
    label en official "the statutory recovery period in years from the table (section 467(e)(3)(A))";
}
@source(IRC_S467_TABLE_1, quote = "3-year property / 3 years")
rule RecoveryPeriodThreeYear(agreement: Integer) strict {
    label en official "3-year property: 3 years (section 467(e)(3)(A))";
    when property_class_for_467(agreement, ThreeYearProperty);
    then statutory_recovery_period_years_467e3(agreement, 3);
}
@source(IRC_S467_TABLE_1, quote = "5-year property / 5 years")
rule RecoveryPeriodFiveYear(agreement: Integer) strict {
    label en official "5-year property: 5 years (section 467(e)(3)(A))";
    when property_class_for_467(agreement, FiveYearProperty);
    then statutory_recovery_period_years_467e3(agreement, 5);
}
@source(IRC_S467_TABLE_1, quote = "7-year property / 7 years")
rule RecoveryPeriodSevenYear(agreement: Integer) strict {
    label en official "7-year property: 7 years (section 467(e)(3)(A))";
    when property_class_for_467(agreement, SevenYearProperty);
    then statutory_recovery_period_years_467e3(agreement, 7);
}
@source(IRC_S467_TABLE_1, quote = "10-year property / 10 years")
rule RecoveryPeriodTenYear(agreement: Integer) strict {
    label en official "10-year property: 10 years (section 467(e)(3)(A))";
    when property_class_for_467(agreement, TenYearProperty);
    then statutory_recovery_period_years_467e3(agreement, 10);
}
@source(IRC_S467_TABLE_1, quote = "15-year and 20-year property / 15 years")
rule RecoveryPeriodFifteenOrTwentyYear(agreement: Integer) strict {
    label en official "15-year and 20-year property: 15 years (section 467(e)(3)(A))";
    when property_class_for_467(agreement, FifteenOrTwentyYearProperty);
    then statutory_recovery_period_years_467e3(agreement, 15);
}
@source(IRC_S467_TABLE_1, quote = "Residential rental property and nonresidential real property / 19 years")
rule RecoveryPeriodRealProperty(agreement: Integer) strict {
    label en official "residential rental and nonresidential real property: 19 years (section 467(e)(3)(A))";
    when property_class_for_467(agreement, ResidentialRentalOrNonresidentialRealProperty);
    then statutory_recovery_period_years_467e3(agreement, 19);
}
@source(IRC_S467_TABLE_1, quote = "Any railroad grading or tunnel bore / 50 years.")
rule RecoveryPeriodRailroadGradingOrTunnelBore(agreement: Integer) strict {
    label en official "railroad grading or tunnel bore: 50 years (section 467(e)(3)(A))";
    when property_class_for_467(agreement, RailroadGradingOrTunnelBore);
    then statutory_recovery_period_years_467e3(agreement, 50);
}

// ===================== (e)(6): term of the agreement =====================

pub relation agreement_term_including_all_extensions_in_months_467(agreement: Integer, months: Integer) kind empirical {
    label en official "the term of the agreement in months, counting every extension";
}
pub relation extension_solely_at_lessee_option_in_months_467e6(agreement: Integer, months: Integer) kind empirical {
    label en official "the months of an extension that is solely at the option of the lessee (section 467(e)(6))";
}
pub relation regulations_count_lessee_option_extension_467e6(agreement: Integer) kind empirical {
    label en official "regulations provide that a lessee-option extension is counted in the term (section 467(e)(6), 'except as provided in regulations'); the regulations are asserted";
}
pub relation term_of_agreement_in_months_467e6(agreement: Integer, months: Integer) kind institutional {
    label en official "the term for section 467: extensions solely at the lessee's option are not counted unless regulations provide otherwise (section 467(e)(6)); floored at zero (JUDGMENT CALL)";
}
@source(IRC_S467_E, quote = "there shall not be taken into account in computing the term of any agreement for purposes of this section any extension which is solely at the option of the lessee.")
rule TermExcludesLesseeOptionExtension(agreement: Integer, total: Integer, extension: Integer) defeasible {
    label en official "total term less the lessee-option extension (section 467(e)(6))";
    when agreement_term_including_all_extensions_in_months_467(agreement, total);
    when extension_solely_at_lessee_option_in_months_467e6(agreement, extension);
    when not_known(regulations_count_lessee_option_extension_467e6(agreement));
    then term_of_agreement_in_months_467e6(agreement, max(total - extension, 0));
}
rule TermWithoutLesseeOptionExtension(agreement: Integer, total: Integer) defeasible {
    label en official "with no lessee-option extension the term is the total (section 467(e)(6))";
    when agreement_term_including_all_extensions_in_months_467(agreement, total);
    when not_known(agreement_has_lessee_option_extension_467e6(agreement));
    then term_of_agreement_in_months_467e6(agreement, total);
}
pub relation agreement_has_lessee_option_extension_467e6(agreement: Integer) kind institutional {
    label en official "the agreement has an extension solely at the lessee's option (bridge)";
}
rule AgreementHasLesseeOptionExtension(agreement: Integer, months: Integer) strict {
    label en official "bridge";
    when extension_solely_at_lessee_option_in_months_467e6(agreement, months);
    then agreement_has_lessee_option_extension_467e6(agreement);
}

// ===================== (b)(4): disqualified leaseback or long-term agreement =====================

pub relation term_exceeds_seventy_five_percent_of_recovery_period_467b4A(agreement: Integer) kind institutional {
    label en official "the term exceeds 75 percent of the statutory recovery period: months x 4 > years x 36 (section 467(b)(4)(A))";
}
@source(IRC_S467_B, quote = "such agreement is for a term in excess of 75 percent of the statutory recovery period for the property")
rule TermExceedsSeventyFivePercentOfRecoveryPeriod(agreement: Integer, months: Integer, years: Integer) defeasible {
    label en official "term in months x 4 > recovery years x 12 x 3 (section 467(b)(4)(A))";
    when term_of_agreement_in_months_467e6(agreement, months);
    when statutory_recovery_period_years_467e3(agreement, years);
    when months * 4 > years * 36;
    then term_exceeds_seventy_five_percent_of_recovery_period_467b4A(agreement);
}
pub relation agreement_is_part_of_leaseback_or_long_term_467b4A(agreement: Integer) kind institutional {
    label en official "the agreement is part of a leaseback transaction or has a term over 75 percent of the recovery period (section 467(b)(4)(A))";
}
@source(IRC_S467_B, quote = "such agreement is part of a leaseback transaction")
rule PartOfLeasebackTransaction(agreement: Integer) defeasible {
    label en official "leaseback (section 467(b)(4)(A))";
    when leaseback_transaction_467e2(agreement);
    then agreement_is_part_of_leaseback_or_long_term_467b4A(agreement);
}
rule LongTermAgreement(agreement: Integer) defeasible {
    label en official "term over 75 percent of the recovery period (section 467(b)(4)(A))";
    when term_exceeds_seventy_five_percent_of_recovery_period_467b4A(agreement);
    then agreement_is_part_of_leaseback_or_long_term_467b4A(agreement);
}
pub relation principal_purpose_of_increasing_rents_is_tax_avoidance_467b4B(agreement: Integer) kind empirical {
    label en official "a principal purpose for providing increasing rents under the agreement is the avoidance of tax imposed by subtitle A (section 467(b)(4)(B)); an adjudicated fact";
}
pub relation disqualified_leaseback_or_long_term_agreement_derived_467b4(agreement: Integer) kind institutional {
    label en official "a disqualified leaseback or long-term agreement: (A) and (B) both hold (section 467(b)(4))";
}
@source(IRC_S467_B, quote = "a principal purpose for providing increasing rents under the agreement is the avoidance of tax imposed by this subtitle.")
rule DisqualifiedAgreementFromComponents(agreement: Integer) defeasible {
    label en official "leaseback or long term, and a principal purpose of tax avoidance (section 467(b)(4))";
    when agreement_is_part_of_leaseback_or_long_term_467b4A(agreement);
    when principal_purpose_of_increasing_rents_is_tax_avoidance_467b4B(agreement);
    then disqualified_leaseback_or_long_term_agreement_derived_467b4(agreement);
}
rule ConstantRentalAccrualRequiredDerivedDisqualified(lessor: Person, lessee: Person, agreement: Integer) defeasible {
    label en official "constant rental accrual is required for a derived disqualified agreement (section 467(b)(3)(A), (b)(4))";
    when is_section_467_rental_agreement(lessor, lessee, agreement);
    when disqualified_leaseback_or_long_term_agreement_derived_467b4(agreement);
    then constant_rental_accrual_required_467(lessor, lessee, agreement);
}

// ===================== (d)(2): aggregate consideration =====================

pub relation payments_received_as_consideration_for_use_467d2A(agreement: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount of payments received as consideration for the use of the property (section 467(d)(2)(A))";
}
pub relation value_of_other_consideration_for_use_467d2B(agreement: Integer, amount: Money) kind empirical {
    label en official "the aggregate value of any other consideration to be received (section 467(d)(2)(B)); the section 1274(c)(4)(C)(ii)-(iii) rules are the valuation inputs";
}
pub relation aggregate_consideration_derived_467d2(agreement: Integer, amount: Money) kind institutional {
    label en official "the sum of the payments received and the value of other consideration, for the $250,000 test (section 467(d)(2))";
}
@source(IRC_S467_D, quote = "(A) the aggregate amount of payments received as consideration for such use of property, and")
rule AggregateConsiderationSum(agreement: Integer, paid: Money, other: Money) strict {
    label en official "(A) + (B) (section 467(d)(2))";
    when payments_received_as_consideration_for_use_467d2A(agreement, paid);
    when value_of_other_consideration_for_use_467d2B(agreement, other);
    then aggregate_consideration_derived_467d2(agreement, paid + other);
}
rule Section467RentalAgreementDeferredPaymentDerivedConsideration(lessor: Person, lessee: Person, agreement: Integer, aggregate: Money) strict {
    label en official "a deferred-payment agreement whose derived aggregate consideration exceeds $250,000 (section 467(d)(1)(A), (d)(2))";
    when parties_to_rental_agreement_467(lessor, lessee, agreement);
    when rental_agreement_has_payment_after_following_calendar_year(agreement);
    when aggregate_consideration_derived_467d2(agreement, aggregate);
    when aggregate > 250000.00 USD;
    then is_section_467_rental_agreement(lessor, lessee, agreement);
}
rule Section467RentalAgreementIncreasingRentDerivedConsideration(lessor: Person, lessee: Person, agreement: Integer, aggregate: Money) strict {
    label en official "an increasing-rent agreement whose derived aggregate consideration exceeds $250,000 (section 467(d)(1)(B), (d)(2))";
    when parties_to_rental_agreement_467(lessor, lessee, agreement);
    when rental_agreement_has_increasing_rent(agreement);
    when aggregate_consideration_derived_467d2(agreement, aggregate);
    when aggregate > 250000.00 USD;
    then is_section_467_rental_agreement(lessor, lessee, agreement);
}

// ===================== (b)(1): allocation-based accrual =====================

pub relation rent_allocated_by_agreement_to_year_467b1A(agreement: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the rent the agreement allocates to the taxable year (section 467(b)(1)(A))";
}
pub relation present_value_of_rent_paid_after_year_467b1B(agreement: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the rent to be paid after the close of the period, at its present value under the regulations (section 467(b)(1)(B)); the present value is asserted";
}
pub relation rent_accrued_by_allocation_467b1(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the rent accruing for the year under an agreement that allocates its rents and is outside the constant-rental-accrual requirement: the allocated rent plus the present value of later rent (section 467(b)(1))";
}
@source(IRC_S467_B, quote = "(A) by allocating rents in accordance with the agreement, and")
rule RentAccruedByAllocation(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, allocated: Money, later: Money) defeasible {
    label en official "allocated rent + present value of later rent (section 467(b)(1)(A)-(B))";
    when is_section_467_rental_agreement(lessor, lessee, agreement);
    when rental_agreement_allocates_rent_in_agreement(agreement);
    when not_known(constant_rental_accrual_required_467(lessor, lessee, agreement));
    when rent_allocated_by_agreement_to_year_467b1A(agreement, y, allocated);
    when present_value_of_rent_paid_after_year_467b1B(agreement, y, later);
    then rent_accrued_by_allocation_467b1(lessor, lessee, agreement, y, allocated + later);
}
rule RentAccruedForYearFromAllocation(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the rent accrued for the year is the allocation-based amount when no constant-rental accrual is required (section 467(a)(1), (b)(1))";
    when rent_accrued_by_allocation_467b1(lessor, lessee, agreement, y, amount);
    then rent_accrued_for_year_467(lessor, lessee, agreement, y, amount);
}

// ===================== (a), (e)(4): total taken into account =====================

pub relation applicable_federal_rate_at_agreement_467e4(agreement: Integer, rate: Decimal) kind empirical {
    label en official "the applicable Federal rate under section 1274(d), compounded semiannually, in effect when the agreement was entered into, for the term of the agreement (section 467(e)(4)); the published rate is asserted";
}
pub relation rate_for_section_467_467e4(agreement: Integer, rate: Decimal) kind institutional {
    label en official "the discount and interest rate: 110 percent of the applicable Federal rate (section 467(e)(4))";
}
@source(IRC_S467_E, quote = "the rate used shall be equal to 110 percent of the applicable Federal rate determined under section 1274(d)")
rule RateIsOneHundredTenPercentOfApplicableFederalRate(agreement: Integer, afr: Decimal) strict {
    label en official "AFR x 1.10 (section 467(e)(4))";
    when applicable_federal_rate_at_agreement_467e4(agreement, afr);
    then rate_for_section_467_467e4(agreement, afr * 1.10);
}
pub relation unpaid_amounts_of_prior_years_467a2(agreement: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amounts taken into account for prior taxable years and still unpaid at the start of the year, with the interest accrued on them (section 467(a)(2)); the balance is asserted (multi-year carry, TECH-GAPS G2108)";
}
pub relation interest_on_unpaid_prior_amounts_467a2(agreement: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "interest for the year on the unpaid prior amounts at the (e)(4) rate compounded semiannually: unpaid x ((1 + r/2)(1 + r/2) - 1), one rounding to cents HALF_UP (JUDGMENT CALL) (section 467(a)(2), (e)(4))";
}
@source(IRC_S467_A, quote = "interest for the year on the amounts which were taken into account under this subsection for prior taxable years and which are unpaid.")
rule InterestOnUnpaidPriorAmounts(agreement: Integer, y: TaxableYear, unpaid: Money, r: Decimal) defeasible {
    label en official "one year of semiannually compounded interest on the unpaid balance (section 467(a)(2))";
    when unpaid_amounts_of_prior_years_467a2(agreement, y, unpaid);
    when rate_for_section_467_467e4(agreement, r);
    then interest_on_unpaid_prior_amounts_467a2(agreement, y, round(unpaid * ((1.0 + r * 0.5) * (1.0 + r * 0.5) - 1.0), 2, "HALF_UP"));
}
pub relation amount_taken_into_account_467a(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount taken into account for the taxable year: the rent accrued under subsection (b) plus interest on the unpaid prior amounts (section 467(a))";
}
@source(IRC_S467_A, quote = "(1) the amount of the rent which accrues during such taxable year as determined under subsection (b), and")
rule AmountTakenIntoAccountWithInterest(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, rent: Money, interest: Money) defeasible {
    label en official "rent accrued + interest (section 467(a)(1)-(2))";
    when rent_accrued_for_year_467(lessor, lessee, agreement, y, rent);
    when interest_on_unpaid_prior_amounts_467a2(agreement, y, interest);
    then amount_taken_into_account_467a(lessor, lessee, agreement, y, rent + interest);
}
rule AmountTakenIntoAccountWithoutPriorAmounts(lessor: Person, lessee: Person, agreement: Integer, y: TaxableYear, rent: Money) defeasible {
    label en official "no unpaid prior amounts: only the rent accrued (section 467(a)(1))";
    when rent_accrued_for_year_467(lessor, lessee, agreement, y, rent);
    when not_known(has_unpaid_prior_amounts_467a2(agreement, y));
    then amount_taken_into_account_467a(lessor, lessee, agreement, y, rent);
}
pub relation has_unpaid_prior_amounts_467a2(agreement: Integer, y: TaxableYear) kind institutional {
    label en official "the agreement has unpaid prior amounts for the year (bridge)";
}
rule HasUnpaidPriorAmountsBridge(agreement: Integer, y: TaxableYear, amount: Money) strict {
    label en official "bridge";
    when unpaid_amounts_of_prior_years_467a2(agreement, y, amount);
    then has_unpaid_prior_amounts_467a2(agreement, y);
}

// ===================== (c): recapture on disposition by the lessor =====================

pub relation lessor_disposes_of_property_during_term_467c1A(lessor: Person, agreement: Integer) kind empirical {
    label en official "the lessor disposes of the property subject to the agreement during its term (section 467(c)(1)(A))";
}
pub relation leaseback_or_long_term_agreement_467c4(agreement: Integer) kind institutional {
    label en official "a leaseback or long-term agreement: an agreement described in (b)(4)(A) (section 467(c)(4))";
}
@source(IRC_S467_C, quote = "the term \"leaseback or long-term agreement\" means any agreement described in subsection (b)(4)(A).")
rule LeasebackOrLongTermAgreementDefinition(agreement: Integer) defeasible {
    label en official "(b)(4)(A) agreements (section 467(c)(4))";
    when agreement_is_part_of_leaseback_or_long_term_467b4A(agreement);
    then leaseback_or_long_term_agreement_467c4(agreement);
}
pub relation recapture_applies_467c1(lessor: Person, lessee: Person, agreement: Integer) kind institutional {
    label en official "the lessor of a section 467 rental agreement disposes of the property during its term and the agreement is a leaseback or long-term agreement to which (b)(2) did not apply (section 467(c)(1))";
}
@source(IRC_S467_C, quote = "(B) such agreement is a leaseback or long-term agreement to which paragraph (2) of subsection (b) did not apply,")
rule RecaptureAppliesOnDisposition(lessor: Person, lessee: Person, agreement: Integer) defeasible {
    label en official "disposition of the property by the lessor during the term of a leaseback or long-term agreement not under (b)(2) (section 467(c)(1))";
    when is_section_467_rental_agreement(lessor, lessee, agreement);
    when lessor_disposes_of_property_during_term_467c1A(lessor, agreement);
    when leaseback_or_long_term_agreement_467c4(agreement);
    when not_known(constant_rental_accrual_required_467(lessor, lessee, agreement));
    then recapture_applies_467c1(lessor, lessee, agreement);
}
pub relation amount_which_would_have_been_taken_into_account_with_b2_467c3A(agreement: Integer, amount: Money) kind empirical {
    label en official "the amount that would have been taken into account for periods before the disposition had (b)(2) applied (section 467(c)(3)(A))";
}
pub relation amount_taken_into_account_before_disposition_467c3B(agreement: Integer, amount: Money) kind empirical {
    label en official "the amount taken into account under (a) for periods before the disposition (section 467(c)(3)(B))";
}
pub relation prior_understated_inclusion_467c3(agreement: Integer, amount: Money) kind institutional {
    label en official "the excess, if any, of the (b)(2) amount over the amount actually taken into account (section 467(c)(3))";
}
@source(IRC_S467_C, quote = "the term \"prior understated inclusion\" means the excess (if any) of—")
rule PriorUnderstatedInclusion(agreement: Integer, would: Money, actual: Money) strict {
    label en official "max((A) - (B), 0) (section 467(c)(3))";
    when amount_which_would_have_been_taken_into_account_with_b2_467c3A(agreement, would);
    when amount_taken_into_account_before_disposition_467c3B(agreement, actual);
    then prior_understated_inclusion_467c3(agreement, max(would - actual, 0 USD));
}
pub relation amount_realized_or_value_on_disposition_467c2B(agreement: Integer, amount: Money) kind empirical {
    label en official "the amount realized on a sale, exchange or involuntary conversion, or the fair market value of the property on any other disposition (section 467(c)(2)(B))";
}
pub relation adjusted_basis_on_disposition_467c2B(agreement: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis of the property at the disposition (section 467(c)(2)(B))";
}
pub relation gain_treated_as_ordinary_under_other_provisions_467c2(agreement: Integer, amount: Money) kind empirical {
    label en official "the gain treated as ordinary income on the disposition under any other provision of subtitle A (section 467(c)(2), last sentence)";
}
pub relation gain_limit_for_recapture_467c2B(agreement: Integer, amount: Money) kind institutional {
    label en official "the excess of the amount realized (or value) over the adjusted basis, reduced by gain already ordinary under other provisions, floored at zero (JUDGMENT CALL) (section 467(c)(2)(B))";
}
@source(IRC_S467_C, quote = "The amount determined under subparagraph (B) shall be reduced by the amount of any gain treated as ordinary income on the disposition under any other provision of this subtitle.")
rule GainLimitForRecapture(agreement: Integer, realized: Money, basis: Money, other: Money) strict {
    label en official "max(realized - basis - other ordinary gain, 0) (section 467(c)(2)(B))";
    when amount_realized_or_value_on_disposition_467c2B(agreement, realized);
    when adjusted_basis_on_disposition_467c2B(agreement, basis);
    when gain_treated_as_ordinary_under_other_provisions_467c2(agreement, other);
    then gain_limit_for_recapture_467c2B(agreement, max(realized - basis - other, 0 USD));
}
pub relation recapture_amount_treated_as_ordinary_income_467c(lessor: Person, lessee: Person, agreement: Integer, amount: Money) kind institutional {
    label en official "the recapture amount, the lesser of the prior understated inclusions and the limited gain, is ordinary income recognized notwithstanding any other provision of subtitle A (section 467(c)(1)-(2))";
}
@source(IRC_S467_C, quote = "the recapture amount shall be treated as ordinary income.")
rule RecaptureAmountIsOrdinaryIncome(lessor: Person, lessee: Person, agreement: Integer, understated: Money, limit: Money) defeasible {
    label en official "min(prior understated inclusions, gain limit) (section 467(c)(1)-(2))";
    when recapture_applies_467c1(lessor, lessee, agreement);
    when prior_understated_inclusion_467c3(agreement, understated);
    when gain_limit_for_recapture_467c2B(agreement, limit);
    then recapture_amount_treated_as_ordinary_income_467c(lessor, lessee, agreement, min(understated, limit));
}
