// Sections 482 and 483. Stage 2b (IRC-07).
//
// 482: the Secretary's allocation power, gated by the DECISION-0194
// evaluative "necessary... clearly to reflect the income" channel (or the
// "prevent evasion of taxes" alternative channel); the actual reallocated
// amount is a case fact (this section prescribes no arm's-length-pricing
// FORMULA of its own — Treasury regulations do, an EXTERNAL_DEPENDENCY not
// modelled). The (b) intangible-transfer commensurate-with-income
// requirement is modelled as a gate + case-fact amount, not a valuation
// formula (the statute itself prescribes none; it directs the Secretary to
// choose a valuation METHOD by regulation).
//
// 483: (a)-(c) core: total unstated interest = sum of payments due minus the
// sum of their present values (b), allocated to a payment "in a manner
// consistent with... section 1272(a)" ((a), read as a case fact — the
// section 1272(a) OID accrual computation is an EXTERNAL_DEPENDENCY, no
// us.irc.* owner formalizes it yet); the present value itself and the AFR
// discount rate are SOURCE_GAP (no IRB AFR table pinned, same class as
// us.irc.payment_refunds_interest's federal_short_term_rate). (d) the
// $3,000-sales-price and OID-coordination exceptions; (e) the 6-percent
// related-party land-sale cap with its $500,000 aggregate limitation.
// NOT DONE (TECH-GAPS G328): (d)(3)-(4) carrying-charge and patent-transfer
// exceptions; (e)(4) nonresident-alien exception; (f)/(g) regulations and
// cross-references (NON_NORMATIVE).

// ============================================================================
// Section 482 — allocation of income and deductions among taxpayers.
// ============================================================================

use self::{
    IRC_S482,
    IRC_S483_A,
    IRC_S483_B,
    IRC_S483_C,
    IRC_S483_E,
    Person,
    Secretary,
    TaxableYear,
};

pub relation commonly_owned_or_controlled_482(a: Person, b: Person) kind empirical {
    label en official "two or more organizations, trades, or businesses owned or controlled directly or indirectly by the same interests (section 482)";
}
external judgment relation allocation_necessary_482(a: Person, b: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary determines that a distribution, apportionment, or allocation between the commonly controlled organizations is necessary to prevent evasion of taxes, or clearly to reflect the income of any of them (section 482)";
}
pub relation section_482_allocation_amount(a: Person, b: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount of gross income, deductions, credits, or allowances the Secretary distributes, apportions, or allocates between or among the organizations for the item (section 482) — read as a case fact; no arm's-length-pricing formula of the Secretary's own regulations is modelled (EXTERNAL_DEPENDENCY)";
}
pub relation section_482_allocation_in_effect(a: Person, b: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the section 482 allocation is in effect between the commonly controlled organizations for the item and taxable year";
}
@source(IRC_S482, quote = "the Secretary may distribute, apportion, or allocate gross income, deductions, credits, or allowances between or among such organizations, trades, or businesses, if he determines that such distribution, apportionment, or allocation is necessary in order to prevent evasion of taxes or clearly to reflect the income of any of such organizations, trades, or businesses")
rule Section482AllocationPower(a: Person, b: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the Secretary may allocate gross income, deductions, credits, or allowances between commonly controlled organizations when necessary to prevent evasion of taxes or clearly to reflect income (section 482)";
    when commonly_owned_or_controlled_482(a, b);
    when section_482_allocation_amount(a, b, y, item, amount);
    then power Section482Allocation {
        holder Secretary;
        over item;
        exercise section_482_allocation_amount(a, b, y, item, amount);
        valid_when allocation_necessary_482(a, b, y);
        effect create(section_482_allocation_in_effect(a, b, y, item, amount));
        window [@1954-08-16, infinity);
    };
}
// (b): commensurate-with-income requirement for a section 367(d)(4)
// intangible transfer or license.
pub relation intangible_property_transfer_or_license_482b(a: Person, b: Person, y: TaxableYear, intangible: Integer) kind empirical {
    label en official "a transfer (or license) of intangible property within the meaning of section 367(d)(4) between the organizations (section 482 second sentence)";
}
pub relation income_attributable_to_intangible_482b(a: Person, b: Person, y: TaxableYear, intangible: Integer, amount: Money) kind empirical {
    label en official "the income attributable to the intangible (section 482 second sentence) — read as a case fact; the Secretary's aggregate-valuation/realistic-alternatives methodology (third sentence) is NOT modelled (EXTERNAL_DEPENDENCY, TECH_GAP G328)";
}
pub relation income_commensurate_with_intangible_required_482b(a: Person, b: Person, y: TaxableYear, intangible: Integer, amount: Money) kind institutional {
    label en official "the income with respect to the intangible transfer or license shall be commensurate with the income attributable to the intangible (section 482 second sentence)";
}
@source(IRC_S482, quote = "the income with respect to such transfer or license shall be commensurate with the income attributable to the intangible")
rule Section482bCommensurateWithIncome(a: Person, b: Person, y: TaxableYear, intangible: Integer, amount: Money) strict {
    label en official "the income from an intangible transfer or license must be commensurate with the income attributable to the intangible (section 482 second sentence)";
    when intangible_property_transfer_or_license_482b(a, b, y, intangible);
    when income_attributable_to_intangible_482b(a, b, y, intangible, amount);
    then income_commensurate_with_intangible_required_482b(a, b, y, intangible, amount);
}

// ============================================================================
// Section 483 — interest on certain deferred payments.
// ============================================================================

pub relation deferred_payment_sale_or_exchange_483(seller: Person, buyer: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "a contract for the sale or exchange of property under which some or all payments are due more than 1 year after the sale (section 483(c)(1)(A))";
}
pub relation payment_due_more_than_six_months_after_sale_483(seller: Person, buyer: Person, contract: Integer, payment: Integer) kind empirical {
    label en official "a payment on account of the sale which is part or all of the sales price and is due more than 6 months after the date of sale (section 483(c)(1))";
}
pub relation payments_due_under_contract_483(seller: Person, buyer: Person, contract: Integer, amount: Money) kind empirical {
    label en official "the sum of the payments to which section 483 applies which are due under the contract (section 483(b)(1))";
}
pub relation present_value_of_payments_483(seller: Person, buyer: Person, contract: Integer, amount: Money) kind empirical {
    label en unofficial "SOURCE_GAP: the sum of the present values of the payments and any interest payments due under the contract, discounted at the section 1274(d) applicable Federal rate under the section 1274(b)(2) rules (section 483(b)) — no AFR value pinned in this corpus (same class as us.irc.payment_refunds_interest's federal_short_term_rate); read as a case fact";
}
pub relation total_unstated_interest_483(seller: Person, buyer: Person, contract: Integer, amount: Money) kind institutional {
    label en official "total unstated interest: the sum of payments due under the contract minus the sum of their present values (section 483(b))";
}
@source(IRC_S483_B, quote = "an amount equal to the excess of")
rule TotalUnstatedInterestComputation(seller: Person, buyer: Person, contract: Integer, due: Money, pv: Money) strict {
    label en official "total unstated interest is the sum of payments due minus the sum of their present values (section 483(b))";
    when payments_due_under_contract_483(seller, buyer, contract, due);
    when present_value_of_payments_483(seller, buyer, contract, pv);
    when due > pv;
    then total_unstated_interest_483(seller, buyer, contract, due - pv);
}
pub relation sales_price_exceeds_three_thousand_483(seller: Person, buyer: Person, contract: Integer) kind empirical {
    label en official "it cannot be determined at the time of sale that the sales price will not exceed $3,000 (the negation of the section 483(d)(2) small-sales-price exception)";
}
pub relation oid_issue_price_determined_483(seller: Person, buyer: Person, contract: Integer) kind empirical {
    label en official "an issue price for the debt instrument is determined under section 1273(b) (other than paragraph (4)) or section 1274 — the section 483(d)(1) OID-coordination exception applies when true";
}
pub relation section_483_applies_to_contract(seller: Person, buyer: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "section 483 applies to the contract's deferred payments (section 483(c)(1), subject to the (d)(1)-(2) exceptions modelled here)";
}
@source(IRC_S483_C, quote = "this section shall apply to any payment on account of the sale or exchange of property which constitutes part or all of the sales price and which is due more than 6 months after the date of such sale or exchange under a contract")
rule Section483AppliesToContract(seller: Person, buyer: Person, contract: Integer, y: TaxableYear, unstated: Money) defeasible {
    label en official "section 483 applies to a deferred-payment sale contract with total unstated interest, unless the OID-coordination or small-sales-price exception applies (section 483(c)(1), (d)(1)-(2))";
    when deferred_payment_sale_or_exchange_483(seller, buyer, contract, y);
    when total_unstated_interest_483(seller, buyer, contract, unstated) and sales_price_exceeds_three_thousand_483(seller, buyer, contract) and not_known(oid_issue_price_determined_483(seller, buyer, contract));
    then section_483_applies_to_contract(seller, buyer, contract, y);
}
pub relation unstated_interest_allocable_to_payment_483(seller: Person, buyer: Person, contract: Integer, payment: Integer, amount: Money) kind empirical {
    label en official "the portion of total unstated interest properly allocable to a payment, determined in a manner consistent with the section 1272(a) method of computing interest (section 483(a)) — read as a case fact; the section 1272(a) OID accrual computation is an EXTERNAL_DEPENDENCY, no us.irc.* owner formalizes it (TECH_GAP G328)";
}
pub relation imputed_interest_483(seller: Person, buyer: Person, contract: Integer, payment: Integer, amount: Money) kind institutional {
    label en official "the portion of a payment treated as interest for purposes of this title (section 483(a))";
}
@source(IRC_S483_A, quote = "there shall be treated as interest that portion of the total unstated interest under such contract which, as determined in a manner consistent with the method of computing interest under section 1272(a), is properly allocable to such payment")
rule ImputedInterestComputation(seller: Person, buyer: Person, contract: Integer, payment: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the portion of unstated interest allocable to a payment is treated as interest (section 483(a))";
    when section_483_applies_to_contract(seller, buyer, contract, y);
    when payment_due_more_than_six_months_after_sale_483(seller, buyer, contract, payment);
    when unstated_interest_allocable_to_payment_483(seller, buyer, contract, payment, amount);
    then imputed_interest_483(seller, buyer, contract, payment, amount);
}

// (e): 6-percent cap on the discount rate for qualified related-party land
// sales, with the $500,000-aggregate-sales-price limitation.
pub relation is_qualified_land_sale_483e(seller: Person, buyer: Person, contract: Integer) kind empirical {
    label en official "a sale or exchange of land by an individual to a member of that individual's family within the meaning of section 267(c)(4) (section 483(e)(2))";
}
pub relation aggregate_qualified_sales_price_for_calendar_year_483e(seller: Person, buyer: Person, contract: Integer, amount: Money) kind empirical {
    label en official "the sales price for the qualified sale, added to the aggregate sales price for prior qualified sales between the same individuals during the calendar year (section 483(e)(3))";
}
pub relation six_percent_cap_applies_483e(seller: Person, buyer: Person, contract: Integer) kind institutional {
    label en official "the section 483(e)(1) 6-percent (compounded semiannually) maximum discount rate applies to the qualified land sale, because the $500,000 aggregate-sales-price limitation of (e)(3) is not exceeded";
}
@source(IRC_S483_E, quote = "the discount rate used in determining the total unstated interest rate under subsection (b) shall not exceed 6 percent, compounded semiannually")
rule SixPercentCapAppliesToQualifiedLandSale(seller: Person, buyer: Person, contract: Integer, aggregate: Money) strict {
    label en official "the 6-percent compounded-semiannually discount-rate cap applies to a qualified related-party land sale within the $500,000 aggregate-sales-price limitation (section 483(e)(1), (e)(3))";
    when is_qualified_land_sale_483e(seller, buyer, contract);
    when aggregate_qualified_sales_price_for_calendar_year_483e(seller, buyer, contract, aggregate);
    when aggregate <= 500000.00 USD;
    then six_percent_cap_applies_483e(seller, buyer, contract);
}
