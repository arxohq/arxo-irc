    then replaced_quantity_473e1(p, y, 3, 4, min(ai, lj) - max(ap, lp));
}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost3x4(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
    when replaced_quantity_473e1(p, y, 3, 4, q);
    when liquidated_goods_layer_473e(p, 4, quantity_l, u);
    when liquidated_layer_from_qualified_liquidation_473e2(p, 4);
    then replaced_cost_slot_473e2(p, y, 3, 4, round(u * q, 2, "HALF_UP"));
}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity4x1(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal, ap: Decimal) defeasible {
    label en official "goods of acquisition slot 4 replace the most recently liquidated goods not yet replaced: overlap with layer 1 (section 473(e)(1))";
    when acquired_cumulative_473e_4(p, y, ai);
    when acquired_cumulative_473e_3(p, y, ap);
    when liquidated_cumulative_473e_1(p, lj);
    when min(ai, lj) > max(ap, 0.0);
    then replaced_quantity_473e1(p, y, 4, 1, min(ai, lj) - max(ap, 0.0));
}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost4x1(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
    when replaced_quantity_473e1(p, y, 4, 1, q);
    when liquidated_goods_layer_473e(p, 1, quantity_l, u);
    when liquidated_layer_from_qualified_liquidation_473e2(p, 1);
    then replaced_cost_slot_473e2(p, y, 4, 1, round(u * q, 2, "HALF_UP"));
}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity4x2(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal, ap: Decimal, lp: Decimal) defeasible {
    label en official "goods of acquisition slot 4 replace the most recently liquidated goods not yet replaced: overlap with layer 2 (section 473(e)(1))";
    when acquired_cumulative_473e_4(p, y, ai);
    when acquired_cumulative_473e_3(p, y, ap);
    when liquidated_cumulative_473e_2(p, lj);
    when liquidated_cumulative_473e_1(p, lp);
    when min(ai, lj) > max(ap, lp);
    then replaced_quantity_473e1(p, y, 4, 2, min(ai, lj) - max(ap, lp));
}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost4x2(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
    when replaced_quantity_473e1(p, y, 4, 2, q);
    when liquidated_goods_layer_473e(p, 2, quantity_l, u);
    when liquidated_layer_from_qualified_liquidation_473e2(p, 2);
    then replaced_cost_slot_473e2(p, y, 4, 2, round(u * q, 2, "HALF_UP"));
}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity4x3(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal, ap: Decimal, lp: Decimal) defeasible {
    label en official "goods of acquisition slot 4 replace the most recently liquidated goods not yet replaced: overlap with layer 3 (section 473(e)(1))";
    when acquired_cumulative_473e_4(p, y, ai);
    when acquired_cumulative_473e_3(p, y, ap);
    when liquidated_cumulative_473e_3(p, lj);
    when liquidated_cumulative_473e_2(p, lp);
    when min(ai, lj) > max(ap, lp);
    then replaced_quantity_473e1(p, y, 4, 3, min(ai, lj) - max(ap, lp));
}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost4x3(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
    when replaced_quantity_473e1(p, y, 4, 3, q);
    when liquidated_goods_layer_473e(p, 3, quantity_l, u);
    when liquidated_layer_from_qualified_liquidation_473e2(p, 3);
    then replaced_cost_slot_473e2(p, y, 4, 3, round(u * q, 2, "HALF_UP"));
}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity4x4(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal, ap: Decimal, lp: Decimal) defeasible {
    label en official "goods of acquisition slot 4 replace the most recently liquidated goods not yet replaced: overlap with layer 4 (section 473(e)(1))";
