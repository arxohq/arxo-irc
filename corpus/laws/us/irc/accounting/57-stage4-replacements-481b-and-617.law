relation loss_effect_sum_sum_request(p: Person, y: TaxableYear) kind institutional {
    label en official "helper: the ordinal-slot sum of the effects of loss carrybacks and carryovers on years without an allocation is requested";
}
relation loss_effect_sum_slot_present(p: Person, y: TaxableYear, slot: Integer) kind institutional {
    label en official "helper: slot number has a the effects of loss carrybacks and carryovers on years without an allocation value";
}
rule LossEffectSumSlotPresent(p: Person, y: TaxableYear, slot: Integer, v: Money) defeasible {
    label en official "a slot with a value is present";
    when tax_effect_of_loss_carryover_on_unallocated_year_481b3A(p, y, slot, v);
    then loss_effect_sum_slot_present(p, y, slot);
}
relation loss_effect_sum_total(p: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of the effects of loss carrybacks and carryovers on years without an allocation over the ordinal slots 1 to 8 (bounded unrolling: the language cannot sum a derived relation; more than 8 slots are not summed and give no total)";
}
relation loss_effect_sum_sum_0(p: Person, y: TaxableYear, acc: Money) kind institutional {
