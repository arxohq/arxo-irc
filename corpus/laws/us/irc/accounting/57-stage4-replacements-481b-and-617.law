}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost4x4(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
