}
rule LossEffectSumSum6Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 6 is empty: keep the sum";
    when loss_effect_sum_sum_5(p, y, acc);
    when not_known(loss_effect_sum_slot_present(p, y, 6));
    then loss_effect_sum_sum_6(p, y, acc);
}
relation loss_effect_sum_sum_7(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 7";
}
rule LossEffectSumSum7Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 7 has a value: add it";
    when loss_effect_sum_sum_6(p, y, acc);
    when tax_effect_of_loss_carryover_on_unallocated_year_481b3A(p, y, 7, v);
    then loss_effect_sum_sum_7(p, y, acc + v);
}
rule LossEffectSumSum7Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 7 is empty: keep the sum";
    when loss_effect_sum_sum_6(p, y, acc);
    when not_known(loss_effect_sum_slot_present(p, y, 7));
    then loss_effect_sum_sum_7(p, y, acc);
}
relation loss_effect_sum_sum_8(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 8";
}
rule LossEffectSumSum8Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 8 has a value: add it";
    when loss_effect_sum_sum_7(p, y, acc);
    when tax_effect_of_loss_carryover_on_unallocated_year_481b3A(p, y, 8, v);
    then loss_effect_sum_sum_8(p, y, acc + v);
}
rule LossEffectSumSum8Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 8 is empty: keep the sum";
    when loss_effect_sum_sum_7(p, y, acc);
    when not_known(loss_effect_sum_slot_present(p, y, 8));
    then loss_effect_sum_sum_8(p, y, acc);
}
rule LossEffectSumTotalFromLastSlot(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "the total is the running sum after the last slot";
    when loss_effect_sum_sum_8(p, y, acc);
    then loss_effect_sum_total(p, y, acc);
}

pub relation net_tax_increase_three_year_allocation_481b1(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate increase in taxes if one-third of the increase in taxable income were included in each of the 3 years, with the effects of loss carrybacks and carryovers on years without an allocation (section 481(b)(1), (3)(A)-(B))";
}
@source(IRC_S481_B, quote = "(A) There shall be taken into account the increase or decrease in tax for any taxable year preceding the year of the change to which no adjustment is allocated under paragraph (1) or (2) but which is affected by a net operating loss (as defined in section 172) or by a capital loss carryback or carryover (as defined in section 1212), determined with reference to taxable years with respect to which adjustments under paragraph (1) or (2) are allocated.")
rule NetTaxIncreaseThreeYearAllocation(p: Person, y: TaxableYear, inc: Money, eff: Money) defeasible {
    label en official "sum of the year increases + the (b)(3)(A) effects (section 481(b)(1), (3))";
    when increase_b1_sum_total(p, y, inc);
    when loss_effect_sum_total(p, y, eff);
    then net_tax_increase_three_year_allocation_481b1(p, y, inc + eff);
}
pub relation net_tax_increase_new_method_allocation_481b2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net increase in taxes if the adjustments were allocated under the new method, with the effects of loss carrybacks and carryovers on years without an allocation (section 481(b)(2), (3)(A)-(B))";
}
@source(IRC_S481_B, quote = "then the tax under this chapter attributable to such increase in taxable income shall not be greater than the net increase in the taxes under this chapter (or under the corresponding provisions of prior revenue laws) which would result if the adjustments required by subsection (a)(2) were allocated to the taxable year or years specified in subparagraph (B) to which they are properly allocable under the new method of accounting and the balance of the adjustments required by subsection (a)(2) was allocated to the taxable year of the change.")
rule NetTaxIncreaseNewMethodAllocation(p: Person, y: TaxableYear, inc: Money, eff: Money) defeasible {
    label en official "sum of the year increases + the (b)(3)(A) effects (section 481(b)(2), (3))";
    when increase_b2_sum_total(p, y, inc);
    when loss_effect_sum_total(p, y, eff);
    then net_tax_increase_new_method_allocation_481b2(p, y, inc + eff);
}
pub relation tax_attributable_to_481a2_increase_481b(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the tax under this chapter attributable to the increase in taxable income that results solely from the adjustments of section 481(a)(2); the tax function of the tax owner, supplied by the case";
}
@source(IRC_S481_B, quote = "then the tax under this chapter attributable to such increase in taxable income shall not be greater than the aggregate increase in the taxes under this chapter (or under the corresponding provisions of prior revenue laws) which would result if one-third of such increase in taxable income were included in taxable income for the year of the change and one-third of such increase were included for each of the 2 preceding taxable years.")
rule Section481b1TaxLimitationComputed(p: Person, y: TaxableYear, attributable: Money, allocated: Money) defeasible {
    label en official "the tax attributable to the increase is not greater than the aggregate increase under the three-year allocation (section 481(b)(1))";
    when section_481b_three_year_allocation_eligible(p, y);
    when tax_attributable_to_481a2_increase_481b(p, y, attributable);
    when net_tax_increase_three_year_allocation_481b1(p, y, allocated);
    then section_481b_tax_limitation(p, y, min(attributable, allocated));
}
pub relation taxpayer_establishes_new_method_income_for_preceding_years_481b2B(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer establishes its taxable income under the new method of accounting for one or more taxable years consecutively preceding the year of the change for which it used the old method (section 481(b)(2)(B))";
}
pub relation section_481b2_new_method_allocation_available(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 481(b)(2) allocation under the new method is available: the increase exceeds $3,000 and the preceding years' income under the new method is established (section 481(b)(2)(A)-(B))";
}
@source(IRC_S481_B, quote = "(A) the increase in taxable income for the year of the change which results solely by reason of the adjustments required by subsection (a)(2) exceeds $3,000, and")
rule Section481b2NewMethodAllocationAvailable(p: Person, y: TaxableYear, adjustment: Money) defeasible {
    label en official "increase over $3,000 and the new-method income of the preceding years established (section 481(b)(2))";
    when section_481a_adjustment_amount(p, y, adjustment);
    when adjustment > Section481SubstantialAdjustmentThreshold;
    when taxpayer_establishes_new_method_income_for_preceding_years_481b2B(p, y);
    then section_481b2_new_method_allocation_available(p, y);
}
pub relation section_481b2_tax_limitation(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax attributable to the section 481(a)(2) increase, capped at the net increase in taxes under the new-method allocation (section 481(b)(2))";
}
rule Section481b2TaxLimitationComputed(p: Person, y: TaxableYear, attributable: Money, allocated: Money) defeasible {
    label en official "the tax attributable to the increase is not greater than the net increase under the new-method allocation (section 481(b)(2))";
    when section_481b2_new_method_allocation_available(p, y);
    when tax_attributable_to_481a2_increase_481b(p, y, attributable);
    when net_tax_increase_new_method_allocation_481b2(p, y, allocated);
    then section_481b2_tax_limitation(p, y, min(attributable, allocated));
}

// ===================== 617(d)(3): exceptions of section 1245(b)(1)-(3) =====================
//
// Rules similar to section 1245(b)(1)-(3), written for section 617(d) with the
// same shape as their counterparts of property-transactions (module 07 there),
// keyed by the mining property. The base recapture rule (module 29) reads the
// two relations below.

pub relation disposition_by_gift_617d3(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the disposition is by gift (section 617(d)(3), by section 1245(b)(1))";
}
pub relation transfer_at_death_617d3(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the disposition is a transfer at death (section 617(d)(3), by section 1245(b)(2))";
}
pub relation disposition_excepted_from_recapture_617d3(p: Person, y: TaxableYear, prop: Integer) kind institutional {
    label en official "the disposition is excepted from the recapture of (d)(1): a gift or a transfer at death (section 617(d)(3), by section 1245(b)(1)-(2))";
}
@source(IRC_S617_D, quote = "Paragraphs (1), (2), and (3) of section 1245(b) (relating to exceptions and limitations with respect to gain from disposition of certain depreciable property) shall apply in respect of this subsection in the same manner and with the same effect as if references in section 1245(b) to section 1245 or any provision thereof were references to this subsection or the corresponding provisions of this subsection and as if references to section 1245 property were references to mining property.")
rule Section617d3GiftExcepted(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "no recapture on a gift (section 617(d)(3), by section 1245(b)(1))";
    when disposition_by_gift_617d3(p, y, prop);
    then disposition_excepted_from_recapture_617d3(p, y, prop);
}
rule Section617d3DeathExcepted(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "no recapture on a transfer at death (section 617(d)(3), by section 1245(b)(2))";
    when transfer_at_death_617d3(p, y, prop);
    then disposition_excepted_from_recapture_617d3(p, y, prop);
}
pub relation transferee_basis_carries_over_617d3(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the basis of the property in the hands of the transferee is determined by reference to the transferor's basis by reason of section 332, 351, 361, 721 or 731 (section 617(d)(3), by section 1245(b)(3))";
}
pub relation disposition_to_tax_exempt_organization_617d3(p: Person, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the disposition is to an organization (other than a section 521 cooperative) exempt from the chapter 1 tax; the cap of the (b)(3) analogue does not apply (section 617(d)(3), by section 1245(b)(3), second sentence)";
}
pub relation carryover_basis_transaction_617d3(p: Person, y: TaxableYear, prop: Integer) kind institutional {
    label en official "a carryover-basis transaction to which the (b)(3) cap applies";
}
rule Section617d3CarryoverBasisCapApplies(p: Person, y: TaxableYear, prop: Integer) defeasible {
    label en official "carryover basis, not a disposition to an exempt organization (section 617(d)(3), by section 1245(b)(3))";
    when transferee_basis_carries_over_617d3(p, y, prop);
    when not_known(disposition_to_tax_exempt_organization_617d3(p, y, prop));
    then carryover_basis_transaction_617d3(p, y, prop);
}
pub relation gain_recognized_without_regard_to_617_617d3(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the gain recognized to the transferor on the transfer, determined without regard to section 617 (section 617(d)(3), by section 1245(b)(3))";
}
@source(IRC_S617_D, quote = "Paragraphs (1), (2), and (3) of section 1245(b) (relating to exceptions and limitations with respect to gain from disposition of certain depreciable property) shall apply in respect of this subsection in the same manner and with the same effect as if references in section 1245(b) to section 1245 or any provision thereof were references to this subsection or the corresponding provisions of this subsection and as if references to section 1245 property were references to mining property.")
rule ExplorationRecaptureCappedByRecognizedGain(p: Person, y: TaxableYear, prop: Integer, realized: Money, basis: Money, aee: Money, recognized: Money) defeasible {
    label en official "in a carryover-basis transaction the recapture is limited to the gain actually recognized (section 617(d)(3), by section 1245(b)(3))";
    when mining_property_disposed_of(p, y, prop);
    when carryover_basis_transaction_617d3(p, y, prop);
    when amount_realized_or_fmv_on_disposition_617d(p, y, prop, realized);
    when adjusted_basis_of_mining_property_617d(p, y, prop, basis);
    when adjusted_exploration_expenditures(p, prop, aee);
    when gain_recognized_without_regard_to_617_617d3(p, y, prop, recognized);
    when realized > basis;
    when not_known(disposition_subject_to_section_1254(p, y, prop));
    when not_known(disposition_excepted_from_recapture_617d3(p, y, prop));
    then exploration_recapture_ordinary_income_617d(p, y, prop, min(aee, min(round(realized - basis, 2, "HALF_UP"), recognized)));
}

// ===================== 617(g): partnership property =====================
//
// The section 751(b) gains are the partnerships owner's; they are asserted. The
// results are new relations; the consumers of `adjusted_exploration_expenditures`
// (module 29) keep reading the asserted figure (a case supplies the figure
// already adjusted, or reads the results below).

pub relation adjusted_exploration_expenditures_immediately_before_distribution_617g1(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "the adjusted exploration expenditures with respect to the property immediately before its distribution, not otherwise included under subsection (f)(1) (section 617(g)(1))";
}
pub relation gain_751b_realized_by_partnership_617g1(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "the gain to which section 751(b) applied realized by the partnership (as constituted after the distribution) on the distribution of the property (section 617(g)(1))";
}
pub relation adjusted_exploration_expenditures_of_distributed_property_617g1(p: Person, prop: Integer, amount: Money) kind institutional {
    label en official "the adjusted exploration expenditures of property received in a distribution: the recipient's, plus those immediately before the distribution, minus the section 751(b) gain realized by the partnership, not below zero (section 617(g)(1))";
}
@source(IRC_S617_G, quote = "the adjusted exploration expenditures with respect to such property or mine include the adjusted exploration expenditures (not otherwise included under subsection (f)(1)) with respect to such property or mine immediately prior to such distribution, but the adjusted exploration expenditures with respect to any such property or mine shall be reduced by the amount of gain to which section 751(b) applied realized by the partnership (as constituted after the distribution) on the distribution of such property or mine.")
rule AdjustedExplorationExpendituresOfDistributedProperty(p: Person, prop: Integer, own: Money, before: Money, gain: Money) defeasible {
    label en official "own + before the distribution - the partnership's section 751(b) gain, floor zero (section 617(g)(1))";
    when adjusted_exploration_expenditures(p, prop, own);
    when adjusted_exploration_expenditures_immediately_before_distribution_617g1(p, prop, before);
    when gain_751b_realized_by_partnership_617g1(p, prop, gain);
    then adjusted_exploration_expenditures_of_distributed_property_617g1(p, prop, max(0.00 USD, round(own + before - gain, 2, "HALF_UP")));
}
pub relation gain_751b_realized_by_partner_617g2(p: Person, prop: Integer, amount: Money) kind empirical {
    label en official "the gain to which section 751(b) applied realized by the distributee partner on account of the property (section 617(g)(2))";
}
pub relation adjusted_exploration_expenditures_of_retained_property_617g2(p: Person, prop: Integer, amount: Money) kind institutional {
    label en official "the adjusted exploration expenditures of property held by a partnership after a section 751(b) distribution: reduced by the partner's section 751(b) gain, not below zero (section 617(g)(2))";
}
@source(IRC_S617_G, quote = "the adjusted exploration expenditures with respect to such property or mine shall, under regulations prescribed by the Secretary, be reduced by the amount of gain to which section 751(b) applied realized by such partner with respect to such distribution on account of such property or mine.")
rule AdjustedExplorationExpendituresOfRetainedProperty(p: Person, prop: Integer, own: Money, gain: Money) defeasible {
    label en official "own - the partner's section 751(b) gain, floor zero (section 617(g)(2))";
    when adjusted_exploration_expenditures(p, prop, own);
    when gain_751b_realized_by_partner_617g2(p, prop, gain);
    then adjusted_exploration_expenditures_of_retained_property_617g2(p, prop, max(0.00 USD, round(own - gain, 2, "HALF_UP")));
}
