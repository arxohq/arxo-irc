}
relation acquisition_cost_request_473e2(p: Person, y: TaxableYear, i: Integer) kind institutional {
    label en official "helper: the cost of acquisition slot i is requested";
}
rule AcquisitionCostRequest1x1(p: Person, y: TaxableYear, q: Decimal) defeasible {
    label en official "ask for the replaced cost of the slot";
    when replaced_quantity_473e1(p, y, 1, 1, q);
    then acquisition_cost_sum_sum_request(p, y, 1);
}
rule AcquisitionCostRequest1x2(p: Person, y: TaxableYear, q: Decimal) defeasible {
