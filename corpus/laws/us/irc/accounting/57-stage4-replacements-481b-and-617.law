}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity1x4(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal, lp: Decimal) defeasible {
    label en official "goods of acquisition slot 1 replace the most recently liquidated goods not yet replaced: overlap with layer 4 (section 473(e)(1))";
