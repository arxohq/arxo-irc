// Stage 4 (DECISION-0379 with deontics), part 3 of 3: section 473(e) (the
// replacement of liquidated LIFO layers), section 481(b)(2)-(3) (the tax caps
// of a change of method), section 617(d)(3), (g) (recapture exceptions and the
// partnership adjustments of exploration expenditures).

// ===================== 473(e): replacements and inventory cost basis =====================
//
// TECHNIQUE (stated): BOUNDED UNROLLING over quantity layers. The goods that
// reflect the increase over the opening inventory are numbered in their order
// of acquisition (slot 1 is the earliest; at most 4 slots); the liquidated goods
// not previously replaced are numbered from the MOST RECENT liquidation (slot 1
// is the most recent; at most 4 layers). Read as two consecutive intervals on
// one quantity axis, the replaced quantity of acquisition slot i against layer
// j is the overlap of the two intervals (a closed form: no running ledger); the
// inventory cost basis of the goods replaced is the overlap times the unit cost
// of the layer. More than 4 slots or layers are outside the derivation
// (NEITHER). Layers of a liquidation that is not a qualified liquidation get
// the replacement matching of paragraph (1) but not the paragraph (2) basis.

use self::{
    IRC_S473_E,
    IRC_S481_B,
    IRC_S617_D,
    IRC_S617_G,
    Person,
    TaxableYear,
    adjusted_basis_of_mining_property_617d,
    adjusted_exploration_expenditures,
    amount_realized_or_fmv_on_disposition_617d,
    disposition_subject_to_section_1254,
    exploration_recapture_ordinary_income_617d,
    mining_property_disposed_of,
    replacement_year_473d2,
    section_481a_adjustment_amount,
    section_481b_tax_limitation,
    section_481b_three_year_allocation_eligible,
};

pub relation replacement_increase_goods_473e1(p: Person, y: TaxableYear, slot: Integer, quantity: Decimal) kind empirical {
    label en official "the goods reflecting the increase of the closing over the opening inventory in a replacement year, numbered in the order of their acquisition (slot 1 is the earliest), and their quantity (section 473(e)(1))";
}
pub relation liquidated_goods_layer_473e(p: Person, slot: Integer, quantity: Decimal, unit_cost: Money) kind empirical {
    label en official "goods liquidated and not previously replaced, numbered from the most recent liquidation (slot 1 is the most recent): the quantity and the inventory cost basis per unit of the goods replaced (section 473(e)(1)-(2))";
}
pub relation liquidated_layer_from_qualified_liquidation_473e2(p: Person, slot: Integer) kind empirical {
    label en official "the layer was liquidated in a qualified liquidation (section 473(e)(2))";
}

relation acquired_cumulative_473e_1(p: Person, y: TaxableYear, cum: Decimal) kind institutional {
    label en official "cumulative quantity of acquisition slots 1 to 1";
}
rule AcquiredCumulative1(p: Person, y: TaxableYear, q: Decimal) defeasible {
    label en official "cumulative quantity through slot 1";
    when replacement_year_473d2(p, y);
    when replacement_increase_goods_473e1(p, y, 1, q);
    then acquired_cumulative_473e_1(p, y, q);
}
relation acquired_cumulative_473e_2(p: Person, y: TaxableYear, cum: Decimal) kind institutional {
    label en official "cumulative quantity of acquisition slots 1 to 2";
}
rule AcquiredCumulative2(p: Person, y: TaxableYear, c: Decimal, q: Decimal) defeasible {
    label en official "cumulative quantity through slot 2";
    when acquired_cumulative_473e_1(p, y, c);
    when replacement_increase_goods_473e1(p, y, 2, q);
    then acquired_cumulative_473e_2(p, y, c + q);
}
relation acquired_cumulative_473e_3(p: Person, y: TaxableYear, cum: Decimal) kind institutional {
    label en official "cumulative quantity of acquisition slots 1 to 3";
}
rule AcquiredCumulative3(p: Person, y: TaxableYear, c: Decimal, q: Decimal) defeasible {
    label en official "cumulative quantity through slot 3";
    when acquired_cumulative_473e_2(p, y, c);
    when replacement_increase_goods_473e1(p, y, 3, q);
    then acquired_cumulative_473e_3(p, y, c + q);
}
relation acquired_cumulative_473e_4(p: Person, y: TaxableYear, cum: Decimal) kind institutional {
    label en official "cumulative quantity of acquisition slots 1 to 4";
}
rule AcquiredCumulative4(p: Person, y: TaxableYear, c: Decimal, q: Decimal) defeasible {
    label en official "cumulative quantity through slot 4";
    when acquired_cumulative_473e_3(p, y, c);
    when replacement_increase_goods_473e1(p, y, 4, q);
    then acquired_cumulative_473e_4(p, y, c + q);
}
relation liquidated_cumulative_473e_1(p: Person, cum: Decimal) kind institutional {
    label en official "cumulative quantity of layers 1 to 1 (most recent first)";
}
rule LiquidatedCumulative1(p: Person, q: Decimal, c: Money) defeasible {
    label en official "cumulative quantity through layer 1";
    when liquidated_goods_layer_473e(p, 1, q, c);
    then liquidated_cumulative_473e_1(p, q);
}
relation liquidated_cumulative_473e_2(p: Person, cum: Decimal) kind institutional {
    label en official "cumulative quantity of layers 1 to 2 (most recent first)";
}
rule LiquidatedCumulative2(p: Person, c: Decimal, q: Decimal, u: Money) defeasible {
    label en official "cumulative quantity through layer 2";
    when liquidated_cumulative_473e_1(p, c);
    when liquidated_goods_layer_473e(p, 2, q, u);
    then liquidated_cumulative_473e_2(p, c + q);
}
relation liquidated_cumulative_473e_3(p: Person, cum: Decimal) kind institutional {
    label en official "cumulative quantity of layers 1 to 3 (most recent first)";
}
rule LiquidatedCumulative3(p: Person, c: Decimal, q: Decimal, u: Money) defeasible {
    label en official "cumulative quantity through layer 3";
    when liquidated_cumulative_473e_2(p, c);
    when liquidated_goods_layer_473e(p, 3, q, u);
    then liquidated_cumulative_473e_3(p, c + q);
}
relation liquidated_cumulative_473e_4(p: Person, cum: Decimal) kind institutional {
    label en official "cumulative quantity of layers 1 to 4 (most recent first)";
}
rule LiquidatedCumulative4(p: Person, c: Decimal, q: Decimal, u: Money) defeasible {
    label en official "cumulative quantity through layer 4";
    when liquidated_cumulative_473e_3(p, c);
    when liquidated_goods_layer_473e(p, 4, q, u);
    then liquidated_cumulative_473e_4(p, c + q);
}
relation replaced_quantity_473e1(p: Person, y: TaxableYear, i: Integer, j: Integer, quantity: Decimal) kind institutional {
    label en official "the quantity of acquisition slot i considered acquired in replacement of layer j: the overlap of the two intervals (section 473(e)(1))";
}
relation replaced_cost_slot_473e2(p: Person, y: TaxableYear, i: Integer, j: Integer, amount: Money) kind institutional {
    label en official "the inventory cost basis of the goods of layer j replaced by acquisition slot i, for a qualified liquidation: overlap x unit cost, one rounding to cents HALF_UP (JUDGMENT CALL) (section 473(e)(2))";
}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity1x1(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal) defeasible {
    label en official "goods of acquisition slot 1 replace the most recently liquidated goods not yet replaced: overlap with layer 1 (section 473(e)(1))";
    when acquired_cumulative_473e_1(p, y, ai);
    when liquidated_cumulative_473e_1(p, lj);
    when min(ai, lj) > max(0.0, 0.0);
    then replaced_quantity_473e1(p, y, 1, 1, min(ai, lj) - max(0.0, 0.0));
}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost1x1(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
    when replaced_quantity_473e1(p, y, 1, 1, q);
    when liquidated_goods_layer_473e(p, 1, quantity_l, u);
    when liquidated_layer_from_qualified_liquidation_473e2(p, 1);
    then replaced_cost_slot_473e2(p, y, 1, 1, round(u * q, 2, "HALF_UP"));
}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity1x2(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal, lp: Decimal) defeasible {
    label en official "goods of acquisition slot 1 replace the most recently liquidated goods not yet replaced: overlap with layer 2 (section 473(e)(1))";
    when acquired_cumulative_473e_1(p, y, ai);
    when liquidated_cumulative_473e_2(p, lj);
    when liquidated_cumulative_473e_1(p, lp);
    when min(ai, lj) > max(0.0, lp);
    then replaced_quantity_473e1(p, y, 1, 2, min(ai, lj) - max(0.0, lp));
}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost1x2(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
    when replaced_quantity_473e1(p, y, 1, 2, q);
    when liquidated_goods_layer_473e(p, 2, quantity_l, u);
    when liquidated_layer_from_qualified_liquidation_473e2(p, 2);
    then replaced_cost_slot_473e2(p, y, 1, 2, round(u * q, 2, "HALF_UP"));
}
@source(IRC_S473_E, quote = "the goods reflecting such increase shall be considered, in the order of their acquisition, as having been acquired in replacement of the goods most recently liquidated (whether or not in a qualified liquidation) and not previously replaced.")
rule ReplacedQuantity1x3(p: Person, y: TaxableYear, ai: Decimal, lj: Decimal, lp: Decimal) defeasible {
    label en official "goods of acquisition slot 1 replace the most recently liquidated goods not yet replaced: overlap with layer 3 (section 473(e)(1))";
    when acquired_cumulative_473e_1(p, y, ai);
    when liquidated_cumulative_473e_3(p, lj);
    when liquidated_cumulative_473e_2(p, lp);
    when min(ai, lj) > max(0.0, lp);
    then replaced_quantity_473e1(p, y, 1, 3, min(ai, lj) - max(0.0, lp));
}
@source(IRC_S473_E, quote = "any goods considered under paragraph (1) as having been acquired in replacement of the goods liquidated in such liquidation shall be taken into purchases and included in the closing inventory of the taxpayer for the replacement year at the inventory cost basis of the goods replaced.")
rule ReplacedCost1x3(p: Person, y: TaxableYear, q: Decimal, quantity_l: Decimal, u: Money) defeasible {
    label en official "replaced quantity x unit cost of the goods replaced, for a qualified liquidation (section 473(e)(2))";
