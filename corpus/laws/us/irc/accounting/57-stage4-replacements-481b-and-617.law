relation acquisition_cost_sum_sum_request(p: Person, y: TaxableYear, i: Integer) kind institutional {
    label en official "helper: the ordinal-slot sum of the inventory cost basis of the goods replaced by an acquisition slot is requested";
}
relation acquisition_cost_sum_slot_present(p: Person, y: TaxableYear, i: Integer, slot: Integer) kind institutional {
    label en official "helper: slot number has a the inventory cost basis of the goods replaced by an acquisition slot value";
}
rule AcquisitionCostSumSlotPresent(p: Person, y: TaxableYear, i: Integer, slot: Integer, v: Money) defeasible {
    label en official "a slot with a value is present";
    when replaced_cost_slot_473e2(p, y, i, slot, v);
    then acquisition_cost_sum_slot_present(p, y, i, slot);
}
relation acquisition_cost_sum_total(p: Person, y: TaxableYear, i: Integer, total: Money) kind institutional {
    label en official "the sum of the inventory cost basis of the goods replaced by an acquisition slot over the ordinal slots 1 to 4 (bounded unrolling: the language cannot sum a derived relation; more than 4 slots are not summed and give no total)";
}
relation acquisition_cost_sum_sum_0(p: Person, y: TaxableYear, i: Integer, acc: Money) kind institutional {
    label en official "running sum before the first slot";
}
rule AcquisitionCostSumSum0(p: Person, y: TaxableYear, i: Integer) defeasible {
    label en official "the sum starts at zero";
    when acquisition_cost_sum_sum_request(p, y, i);
    then acquisition_cost_sum_sum_0(p, y, i, 0.00 USD);
}
relation acquisition_cost_sum_sum_1(p: Person, y: TaxableYear, i: Integer, acc: Money) kind institutional {
    label en official "running sum through slot 1";
}
rule AcquisitionCostSumSum1Add(p: Person, y: TaxableYear, i: Integer, acc: Money, v: Money) defeasible {
    label en official "slot 1 has a value: add it";
    when acquisition_cost_sum_sum_0(p, y, i, acc);
    when replaced_cost_slot_473e2(p, y, i, 1, v);
    then acquisition_cost_sum_sum_1(p, y, i, acc + v);
}
rule AcquisitionCostSumSum1Skip(p: Person, y: TaxableYear, i: Integer, acc: Money) defeasible {
    label en official "slot 1 is empty: keep the sum";
    when acquisition_cost_sum_sum_0(p, y, i, acc);
    when not_known(acquisition_cost_sum_slot_present(p, y, i, 1));
    then acquisition_cost_sum_sum_1(p, y, i, acc);
}
relation acquisition_cost_sum_sum_2(p: Person, y: TaxableYear, i: Integer, acc: Money) kind institutional {
    label en official "running sum through slot 2";
}
rule AcquisitionCostSumSum2Add(p: Person, y: TaxableYear, i: Integer, acc: Money, v: Money) defeasible {
    label en official "slot 2 has a value: add it";
    when acquisition_cost_sum_sum_1(p, y, i, acc);
    when replaced_cost_slot_473e2(p, y, i, 2, v);
    then acquisition_cost_sum_sum_2(p, y, i, acc + v);
}
rule AcquisitionCostSumSum2Skip(p: Person, y: TaxableYear, i: Integer, acc: Money) defeasible {
    label en official "slot 2 is empty: keep the sum";
    when acquisition_cost_sum_sum_1(p, y, i, acc);
    when not_known(acquisition_cost_sum_slot_present(p, y, i, 2));
    then acquisition_cost_sum_sum_2(p, y, i, acc);
}
relation acquisition_cost_sum_sum_3(p: Person, y: TaxableYear, i: Integer, acc: Money) kind institutional {
    label en official "running sum through slot 3";
}
rule AcquisitionCostSumSum3Add(p: Person, y: TaxableYear, i: Integer, acc: Money, v: Money) defeasible {
    label en official "slot 3 has a value: add it";
    when acquisition_cost_sum_sum_2(p, y, i, acc);
    when replaced_cost_slot_473e2(p, y, i, 3, v);
    then acquisition_cost_sum_sum_3(p, y, i, acc + v);
}
rule AcquisitionCostSumSum3Skip(p: Person, y: TaxableYear, i: Integer, acc: Money) defeasible {
    label en official "slot 3 is empty: keep the sum";
    when acquisition_cost_sum_sum_2(p, y, i, acc);
    when not_known(acquisition_cost_sum_slot_present(p, y, i, 3));
    then acquisition_cost_sum_sum_3(p, y, i, acc);
}
relation acquisition_cost_sum_sum_4(p: Person, y: TaxableYear, i: Integer, acc: Money) kind institutional {
    label en official "running sum through slot 4";
}
rule AcquisitionCostSumSum4Add(p: Person, y: TaxableYear, i: Integer, acc: Money, v: Money) defeasible {
    label en official "slot 4 has a value: add it";
    when acquisition_cost_sum_sum_3(p, y, i, acc);
    when replaced_cost_slot_473e2(p, y, i, 4, v);
    then acquisition_cost_sum_sum_4(p, y, i, acc + v);
}
rule AcquisitionCostSumSum4Skip(p: Person, y: TaxableYear, i: Integer, acc: Money) defeasible {
    label en official "slot 4 is empty: keep the sum";
    when acquisition_cost_sum_sum_3(p, y, i, acc);
    when not_known(acquisition_cost_sum_slot_present(p, y, i, 4));
    then acquisition_cost_sum_sum_4(p, y, i, acc);
}
rule AcquisitionCostSumTotalFromLastSlot(p: Person, y: TaxableYear, i: Integer, acc: Money) defeasible {
    label en official "the total is the running sum after the last slot";
    when acquisition_cost_sum_sum_4(p, y, i, acc);
    then acquisition_cost_sum_total(p, y, i, acc);
}

relation replacement_goods_cost_473e2(p: Person, y: TaxableYear, slot: Integer, amount: Money) kind institutional {
    label en official "slot view of the cost basis at which acquisition slot goods are taken into purchases and the closing inventory (section 473(e)(2))";
}
rule ReplacementGoodsCostFromSlots(p: Person, y: TaxableYear, i: Integer, total: Money) defeasible {
    label en official "the cost of the slot";
    when acquisition_cost_sum_total(p, y, i, total);
    then replacement_goods_cost_473e2(p, y, i, total);
}
rule ReplacementGoodsTotalRequest(p: Person, y: TaxableYear, i: Integer, total: Money) defeasible {
    label en official "ask for the total over the slots";
    when replacement_goods_cost_473e2(p, y, i, total);
    then purchases_and_closing_inventory_sum_sum_request(p, y);
}
relation purchases_and_closing_inventory_sum_sum_request(p: Person, y: TaxableYear) kind institutional {
    label en official "helper: the ordinal-slot sum of the cost basis of replacement goods is requested";
}
relation purchases_and_closing_inventory_sum_slot_present(p: Person, y: TaxableYear, slot: Integer) kind institutional {
    label en official "helper: slot number has a the cost basis of replacement goods value";
}
rule PurchasesAndClosingInventorySumSlotPresent(p: Person, y: TaxableYear, slot: Integer, v: Money) defeasible {
    label en official "a slot with a value is present";
    when replacement_goods_cost_473e2(p, y, slot, v);
    then purchases_and_closing_inventory_sum_slot_present(p, y, slot);
}
pub relation purchases_and_closing_inventory_sum_total(p: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of the cost basis of replacement goods over the ordinal slots 1 to 4 (bounded unrolling: the language cannot sum a derived relation; more than 4 slots are not summed and give no total)";
}
relation purchases_and_closing_inventory_sum_sum_0(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum before the first slot";
}
rule PurchasesAndClosingInventorySumSum0(p: Person, y: TaxableYear) defeasible {
    label en official "the sum starts at zero";
    when purchases_and_closing_inventory_sum_sum_request(p, y);
    then purchases_and_closing_inventory_sum_sum_0(p, y, 0.00 USD);
}
relation purchases_and_closing_inventory_sum_sum_1(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 1";
}
rule PurchasesAndClosingInventorySumSum1Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 1 has a value: add it";
    when purchases_and_closing_inventory_sum_sum_0(p, y, acc);
    when replacement_goods_cost_473e2(p, y, 1, v);
    then purchases_and_closing_inventory_sum_sum_1(p, y, acc + v);
}
rule PurchasesAndClosingInventorySumSum1Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 1 is empty: keep the sum";
    when purchases_and_closing_inventory_sum_sum_0(p, y, acc);
    when not_known(purchases_and_closing_inventory_sum_slot_present(p, y, 1));
    then purchases_and_closing_inventory_sum_sum_1(p, y, acc);
}
relation purchases_and_closing_inventory_sum_sum_2(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 2";
}
rule PurchasesAndClosingInventorySumSum2Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 2 has a value: add it";
    when purchases_and_closing_inventory_sum_sum_1(p, y, acc);
    when replacement_goods_cost_473e2(p, y, 2, v);
    then purchases_and_closing_inventory_sum_sum_2(p, y, acc + v);
}
rule PurchasesAndClosingInventorySumSum2Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 2 is empty: keep the sum";
    when purchases_and_closing_inventory_sum_sum_1(p, y, acc);
    when not_known(purchases_and_closing_inventory_sum_slot_present(p, y, 2));
    then purchases_and_closing_inventory_sum_sum_2(p, y, acc);
}
relation purchases_and_closing_inventory_sum_sum_3(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 3";
}
rule PurchasesAndClosingInventorySumSum3Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 3 has a value: add it";
    when purchases_and_closing_inventory_sum_sum_2(p, y, acc);
    when replacement_goods_cost_473e2(p, y, 3, v);
    then purchases_and_closing_inventory_sum_sum_3(p, y, acc + v);
}
rule PurchasesAndClosingInventorySumSum3Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 3 is empty: keep the sum";
    when purchases_and_closing_inventory_sum_sum_2(p, y, acc);
    when not_known(purchases_and_closing_inventory_sum_slot_present(p, y, 3));
    then purchases_and_closing_inventory_sum_sum_3(p, y, acc);
}
relation purchases_and_closing_inventory_sum_sum_4(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 4";
}
rule PurchasesAndClosingInventorySumSum4Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 4 has a value: add it";
    when purchases_and_closing_inventory_sum_sum_3(p, y, acc);
    when replacement_goods_cost_473e2(p, y, 4, v);
    then purchases_and_closing_inventory_sum_sum_4(p, y, acc + v);
}
rule PurchasesAndClosingInventorySumSum4Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 4 is empty: keep the sum";
    when purchases_and_closing_inventory_sum_sum_3(p, y, acc);
    when not_known(purchases_and_closing_inventory_sum_slot_present(p, y, 4));
    then purchases_and_closing_inventory_sum_sum_4(p, y, acc);
}
rule PurchasesAndClosingInventorySumTotalFromLastSlot(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "the total is the running sum after the last slot";
    when purchases_and_closing_inventory_sum_sum_4(p, y, acc);
    then purchases_and_closing_inventory_sum_total(p, y, acc);
}

pub relation purchases_and_closing_inventory_amount_473e2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount taken into purchases and included in the closing inventory of the replacement year for goods replacing a qualified liquidation: the inventory cost basis of the goods replaced (section 473(e)(2))";
}
rule PurchasesAndClosingInventoryAtCostOfGoodsReplaced(p: Person, y: TaxableYear, total: Money) defeasible {
    label en official "the total cost basis of the goods replaced (section 473(e)(2))";
    when purchases_and_closing_inventory_sum_total(p, y, total);
    then purchases_and_closing_inventory_amount_473e2(p, y, total);
}

// ===================== 481(b)(1)-(3): the tax caps of a change of method =====================
//
// The tax attributable to the section 481(a)(2) increase shall not exceed the
// net increase in tax that results from allocating the adjustment to other
// years: (b)(1) one-third to the year of the change and one-third to each of the
// 2 preceding years; (b)(2) to the preceding years to which it is properly
// allocable under the new method, the balance to the year of the change.
// The tax of each affected year under the allocation is the tax owner's
// function and is a CASE-SUPPLIED amount per year (JUDGMENT CALL); this package
// derives the increase of each year over its baseline, the baseline rule of
// (b)(3)(B) (a barred year uses the tax previously determined within the
// meaning of section 1314(a)), the (b)(3)(A) effects on years to which no
// adjustment is allocated, the sums, and the caps. The years are numbered by
// an ORDINAL SLOT (bounded unrolling: the language cannot sum a derived
// relation): (b)(1) at most 3 slots, (b)(2) at most 8, (b)(3)(A) at most 8.

pub relation tax_as_it_stands_for_year_481b(p: Person, yy: TaxableYear, amount: Money) kind empirical {
    label en official "the tax of the year before the allocation (for the year of the change: computed without the adjustment)";
}
pub relation year_assessment_or_refund_barred_481b3B(p: Person, yy: TaxableYear) kind empirical {
    label en official "an assessment of any deficiency, or a credit or refund of any overpayment, for the year is prevented by any law or rule of law (section 481(b)(3)(B))";
}
pub relation tax_previously_determined_481b3B(p: Person, yy: TaxableYear, amount: Money) kind empirical {
    label en official "the tax previously determined for the year within the meaning of section 1314(a) (section 481(b)(3)(B))";
}
pub relation tax_baseline_for_year_481b3B(p: Person, yy: TaxableYear, amount: Money) kind institutional {
    label en official "the tax of the year against which the increase or decrease is measured: the tax previously determined for a barred year, the tax as it stands otherwise (section 481(b)(3)(B))";
}
@source(IRC_S481_B, quote = "(B) The increase or decrease in the tax for any taxable year for which an assessment of any deficiency, or a credit or refund of any overpayment, is prevented by any law or rule of law, shall be determined by reference to the tax previously determined (within the meaning of section 1314(a)) for such year.")
rule BarredYearBaselineIsTaxPreviouslyDetermined(p: Person, yy: TaxableYear, amount: Money) defeasible {
    label en official "a barred year is measured against the tax previously determined (section 481(b)(3)(B))";
    when year_assessment_or_refund_barred_481b3B(p, yy);
    when tax_previously_determined_481b3B(p, yy, amount);
    then tax_baseline_for_year_481b3B(p, yy, amount);
}
rule OpenYearBaselineIsTaxAsItStands(p: Person, yy: TaxableYear, amount: Money) defeasible {
    label en official "an open year is measured against its tax as it stands";
    when tax_as_it_stands_for_year_481b(p, yy, amount);
    when not_known(year_assessment_or_refund_barred_481b3B(p, yy));
    then tax_baseline_for_year_481b3B(p, yy, amount);
}
pub relation tax_with_three_year_allocation_481b1(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money) kind empirical {
    label en official "the tax of an affected year (slot 1 to 3: the year of the change and the 2 preceding years) if one-third of the increase in taxable income were included in each of them (section 481(b)(1)); the tax function of the tax owner";
}
pub relation tax_with_new_method_allocation_481b2(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money) kind empirical {
    label en official "the tax of an affected year (slot 1 to 8) if the adjustments were allocated to the preceding years to which they are properly allocable under the new method and the balance to the year of the change (section 481(b)(2)); the tax function of the tax owner";
}
pub relation tax_effect_of_loss_carryover_on_unallocated_year_481b3A(p: Person, y: TaxableYear, slot: Integer, amount: Money) kind empirical {
    label en official "the increase (positive) or decrease (negative) in the tax of a year preceding the year of the change to which no adjustment is allocated but which is affected by a net operating loss or a capital loss carryback or carryover (section 481(b)(3)(A)); slot 1 to 8";
}
relation increase_slot_481b1(p: Person, y: TaxableYear, slot: Integer, amount: Money) kind institutional {
    label en official "the increase in tax of an affected year under the three-year allocation: the allocated tax minus the baseline (section 481(b)(1), (3)(B))";
}
rule IncreaseSlot481b1(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money, base: Money) defeasible {
    label en official "allocated tax - baseline (section 481(b)(1), (3)(B))";
    when tax_with_three_year_allocation_481b1(p, y, slot, yy, tax);
    when tax_baseline_for_year_481b3B(p, yy, base);
    then increase_slot_481b1(p, y, slot, round(tax - base, 2, "HALF_UP"));
}
relation increase_slot_481b2(p: Person, y: TaxableYear, slot: Integer, amount: Money) kind institutional {
    label en official "the increase in tax of an affected year under the new-method allocation: the allocated tax minus the baseline (section 481(b)(2), (3)(B))";
}
rule IncreaseSlot481b2(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money, base: Money) defeasible {
    label en official "allocated tax - baseline (section 481(b)(2), (3)(B))";
    when tax_with_new_method_allocation_481b2(p, y, slot, yy, tax);
    when tax_baseline_for_year_481b3B(p, yy, base);
    then increase_slot_481b2(p, y, slot, round(tax - base, 2, "HALF_UP"));
}
rule RequestThreeYearIncreaseSums(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money) defeasible {
    label en official "ask for the three-year sums";
    when tax_with_three_year_allocation_481b1(p, y, slot, yy, tax);
    then increase_b1_sum_sum_request(p, y);
}
rule RequestThreeYearLossEffectSums(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money) defeasible {
    label en official "ask for the loss-effect sum with the three-year allocation";
    when tax_with_three_year_allocation_481b1(p, y, slot, yy, tax);
    then loss_effect_sum_sum_request(p, y);
}
rule RequestNewMethodIncreaseSums(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money) defeasible {
    label en official "ask for the new-method sums";
    when tax_with_new_method_allocation_481b2(p, y, slot, yy, tax);
    then increase_b2_sum_sum_request(p, y);
}
rule RequestNewMethodLossEffectSums(p: Person, y: TaxableYear, slot: Integer, yy: TaxableYear, tax: Money) defeasible {
    label en official "ask for the loss-effect sum with the new-method allocation";
    when tax_with_new_method_allocation_481b2(p, y, slot, yy, tax);
    then loss_effect_sum_sum_request(p, y);
}

relation increase_b1_sum_sum_request(p: Person, y: TaxableYear) kind institutional {
    label en official "helper: the ordinal-slot sum of the increases in tax under the three-year allocation is requested";
}
relation increase_b1_sum_slot_present(p: Person, y: TaxableYear, slot: Integer) kind institutional {
    label en official "helper: slot number has a the increases in tax under the three-year allocation value";
}
rule IncreaseB1SumSlotPresent(p: Person, y: TaxableYear, slot: Integer, v: Money) defeasible {
    label en official "a slot with a value is present";
    when increase_slot_481b1(p, y, slot, v);
    then increase_b1_sum_slot_present(p, y, slot);
}
relation increase_b1_sum_total(p: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of the increases in tax under the three-year allocation over the ordinal slots 1 to 3 (bounded unrolling: the language cannot sum a derived relation; more than 3 slots are not summed and give no total)";
}
relation increase_b1_sum_sum_0(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum before the first slot";
}
rule IncreaseB1SumSum0(p: Person, y: TaxableYear) defeasible {
    label en official "the sum starts at zero";
    when increase_b1_sum_sum_request(p, y);
    then increase_b1_sum_sum_0(p, y, 0.00 USD);
}
relation increase_b1_sum_sum_1(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 1";
}
rule IncreaseB1SumSum1Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 1 has a value: add it";
    when increase_b1_sum_sum_0(p, y, acc);
    when increase_slot_481b1(p, y, 1, v);
    then increase_b1_sum_sum_1(p, y, acc + v);
}
rule IncreaseB1SumSum1Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 1 is empty: keep the sum";
    when increase_b1_sum_sum_0(p, y, acc);
    when not_known(increase_b1_sum_slot_present(p, y, 1));
    then increase_b1_sum_sum_1(p, y, acc);
}
relation increase_b1_sum_sum_2(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 2";
}
rule IncreaseB1SumSum2Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 2 has a value: add it";
    when increase_b1_sum_sum_1(p, y, acc);
    when increase_slot_481b1(p, y, 2, v);
    then increase_b1_sum_sum_2(p, y, acc + v);
}
rule IncreaseB1SumSum2Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 2 is empty: keep the sum";
    when increase_b1_sum_sum_1(p, y, acc);
    when not_known(increase_b1_sum_slot_present(p, y, 2));
    then increase_b1_sum_sum_2(p, y, acc);
}
relation increase_b1_sum_sum_3(p: Person, y: TaxableYear, acc: Money) kind institutional {
    label en official "running sum through slot 3";
}
rule IncreaseB1SumSum3Add(p: Person, y: TaxableYear, acc: Money, v: Money) defeasible {
    label en official "slot 3 has a value: add it";
    when increase_b1_sum_sum_2(p, y, acc);
    when increase_slot_481b1(p, y, 3, v);
    then increase_b1_sum_sum_3(p, y, acc + v);
}
rule IncreaseB1SumSum3Skip(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "slot 3 is empty: keep the sum";
    when increase_b1_sum_sum_2(p, y, acc);
    when not_known(increase_b1_sum_slot_present(p, y, 3));
    then increase_b1_sum_sum_3(p, y, acc);
}
rule IncreaseB1SumTotalFromLastSlot(p: Person, y: TaxableYear, acc: Money) defeasible {
    label en official "the total is the running sum after the last slot";
    when increase_b1_sum_sum_3(p, y, acc);
    then increase_b1_sum_total(p, y, acc);
}

