// Section 613A residual (stage 3, DECISION-0379 with deontics): the definitions
// of (e), the (a) denial and the (b) exemption for domestic gas, average daily
// production and partial interests of (c)(2), the depletable quantities and
// the gas election of (c)(3)-(4), marginal properties and the applicable
// percentage of (c)(6), the (c)(7) allocation for production above the
// quantity, aggregation of (c)(8), fiscal years (c)(9), (c)(10), and the
// limitations of (d): the 65-percent limit with its carryover, the retailer,
// related-person and refiner exclusions and the (d)(5) bonuses.
//
// Quantities are compared in aggregate form, never as a rounded daily average:
// "average daily production <= quantity" is `aggregate <= quantity x days`, and
// the (c)(7) ratio is applied to the depletion in ONE division,
// `div_round(depletion x quantity_days, aggregate, 2, "HALF_UP")`.
//
// Not modelled (TECH-GAPS G4800+): partner/S-corporation basis records of (c)(7)(D)
// and (c)(11) (partners' proportionate basis is an allocation of basis, owned by
// the partnerships and S-corporations owners), the section 1563(a) control test and
// section 267/707(b) relationship of (c)(8)(D), and the allocation of the
// tentative quantity among entities of (c)(8)(B)-(C) into the depletable quantity.

use self::{
    Asset,
    IRC_S613A_A,
    IRC_S613A_B,
    IRC_S613A_C,
    IRC_S613A_D,
    IRC_S613A_E,
    Person,
    TaxableYear,
    combined_retail_gross_receipts_within_safe_harbor,
    gross_income_from_the_property,
    is_independent_producer_or_royalty_owner,
    is_oil_or_gas_property,
    is_retailer_excluded_from_613a_c,
    mineral_rate_applies,
    percentage_depletion_tentative_amount,
    taxable_income_from_the_property_before_depletion,
};

pub enum ProductKind613A {
    CrudeOil;
    NaturalGas;
    label en official "domestic crude oil or domestic natural gas (section 613A(c)(1))";
}

// ===================== (e): definitions =====================

pub relation product_is_crude_oil_613Ae1(prod: Integer) kind empirical {
    label en official "the product of the oil or gas well is crude oil (section 613A(e)(1))";
}
pub relation natural_gas_liquid_recovered_in_lease_separators_or_field_facilities_613Ae1(prod: Integer) kind empirical {
    label en official "the product is a natural gas liquid recovered from a gas well in lease separators or field facilities (section 613A(e)(1))";
}
pub relation crude_oil_product_613A(prod: Integer) kind institutional {
    label en official "crude oil: crude oil itself and a natural gas liquid recovered from a gas well in lease separators or field facilities (section 613A(e)(1))";
}
@source(IRC_S613A_E, quote = "The term \"crude oil\" includes a natural gas liquid recovered from a gas well in lease separators or field facilities.")
rule CrudeOilProductIsCrudeOil(prod: Integer) strict {
    label en official "crude oil is crude oil (section 613A(e)(1))";
    when product_is_crude_oil_613Ae1(prod);
    then crude_oil_product_613A(prod);
}
rule NaturalGasLiquidFromLeaseSeparatorsIsCrudeOil(prod: Integer) strict {
    label en official "a natural gas liquid recovered in lease separators or field facilities is crude oil (section 613A(e)(1))";
    when natural_gas_liquid_recovered_in_lease_separators_or_field_facilities_613Ae1(prod);
    then crude_oil_product_613A(prod);
}
pub relation product_of_oil_or_gas_well_613Ae2(prod: Integer) kind empirical {
    label en official "the product is a product of an oil or gas well (section 613A(e)(2))";
}
pub relation depletion_deduction_allowable_for_product_613Ae2(prod: Integer) kind empirical {
    label en official "a deduction for depletion is allowable under section 611 with respect to the product (section 613A(e)(2))";
}
pub relation natural_gas_product_613A(prod: Integer) kind institutional {
    label en official "natural gas: any product other than crude oil of an oil or gas well for which depletion is allowable (section 613A(e)(2))";
}
@source(IRC_S613A_E, quote = "The term \"natural gas\" means any product (other than crude oil) of an oil or gas well if a deduction for depletion is allowable under section 611 with respect to such product.")
rule NaturalGasProductDefinition(prod: Integer) strict {
    label en official "a depletable well product other than crude oil is natural gas (section 613A(e)(2))";
    when product_of_oil_or_gas_well_613Ae2(prod);
    when depletion_deduction_allowable_for_product_613Ae2(prod);
    when not_known(crude_oil_product_613A(prod));
    then natural_gas_product_613A(prod);
}
pub relation well_located_in_united_states_or_possession_613Ae3(prod: Integer) kind empirical {
    label en official "the oil or gas well producing the product is located in the United States or in a possession of the United States (section 613A(e)(3))";
}
pub relation domestic_product_613Ae3(prod: Integer) kind institutional {
    label en official "domestic: production from an oil or gas well located in the United States or a possession (section 613A(e)(3))";
}
@source(IRC_S613A_E, quote = "The term \"domestic\" refers to production from an oil or gas well located in the United States or in a possession of the United States.")
rule DomesticProductDefinition(prod: Integer) strict {
    label en official "production from a well in the United States or a possession is domestic (section 613A(e)(3))";
    when well_located_in_united_states_or_possession_613Ae3(prod);
    then domestic_product_613Ae3(prod);
}
pub relation domestic_natural_gas_613A(prod: Integer) kind institutional {
    label en official "domestic natural gas (section 613A(e)(2)-(3))";
}
rule DomesticNaturalGas(prod: Integer) strict {
    label en official "natural gas that is domestic";
    when natural_gas_product_613A(prod);
    when domestic_product_613Ae3(prod);
    then domestic_natural_gas_613A(prod);
}
pub relation volume_in_gallons_613Ae4(prod: Integer, gallons: Integer) kind empirical {
    label en official "the volume of the product in United States gallons (section 613A(e)(4))";
}
pub relation volume_in_barrels_613Ae4(prod: Integer, barrels: Rational) kind institutional {
    label en official "a barrel is 42 United States gallons: the volume in barrels as an exact fraction (section 613A(e)(4))";
}
@source(IRC_S613A_E, quote = "The term \"barrel\" means 42 United States gallons.")
rule BarrelIsFortyTwoGallons(prod: Integer, gallons: Integer) strict {
    label en official "barrels = gallons / 42 (section 613A(e)(4))";
    when volume_in_gallons_613Ae4(prod, gallons);
    then volume_in_barrels_613Ae4(prod, gallons / 42);
}

// ===================== (a), (b): denial and the domestic gas exemption =====================

pub relation gas_of_asset_613A(gas: Integer, asset: Asset) kind empirical {
    label en official "the natural gas is produced from the asset";
}
pub relation gas_sold_by_producer_under_fixed_contract_613Ab3A(gas: Integer, contract: Integer) kind empirical {
    label en official "the domestic natural gas is sold by the producer under the contract (section 613A(b)(3)(A))";
}
pub relation contract_in_effect_on_february_1_1975_and_until_sale_613Ab3A(contract: Integer) kind empirical {
    label en official "the contract was in effect on February 1, 1975, and at all times thereafter before the sale (section 613A(b)(3)(A))";
}
pub relation contract_price_adjustable_for_repeal_of_gas_depletion_613Ab3A(contract: Integer) kind empirical {
    label en official "the price under the contract can be adjusted to reflect to any extent the increase in the seller's tax liability by reason of the repeal of percentage depletion for gas (section 613A(b)(3)(A))";
}
pub relation contract_price_increased_after_february_1_1975_613Ab3A(contract: Integer) kind empirical {
    label en official "the contract price increased after February 1, 1975 (section 613A(b)(3)(A), second sentence)";
}
pub relation taxpayer_demonstrates_contrary_by_clear_and_convincing_evidence_613Ab3(contract: Integer) kind empirical {
    label en official "the taxpayer demonstrates by clear and convincing evidence that the price increase does not take increased tax liability into account (section 613A(b)(3)(A)-(B)); an adjudicated fact (DECISION-0194)";
}
pub relation price_increase_presumed_to_reflect_tax_613Ab3(contract: Integer) kind institutional {
    label en official "price increases after February 1, 1975 are presumed to take increases in tax liabilities into account, unless the taxpayer demonstrates the contrary by clear and convincing evidence (section 613A(b)(3)(A)-(B))";
}
@source(IRC_S613A_B, quote = "Price increases after February 1, 1975, shall be presumed to take increases in tax liabilities into account unless the taxpayer demonstrates to the contrary by clear and convincing evidence.")
rule PriceIncreasePresumedToReflectTax(contract: Integer) defeasible {
    label en official "a post-1975 price increase is presumed to reflect the tax unless the taxpayer shows otherwise by clear and convincing evidence (section 613A(b)(3)(A)-(B))";
    when contract_price_increased_after_february_1_1975_613Ab3A(contract);
    when not_known(taxpayer_demonstrates_contrary_by_clear_and_convincing_evidence_613Ab3(contract));
    then price_increase_presumed_to_reflect_tax_613Ab3(contract);
}
pub relation natural_gas_sold_under_fixed_contract_613Ab3A(gas: Integer) kind institutional {
    label en official "natural gas sold under a fixed contract (section 613A(b)(3)(A))";
}
@source(IRC_S613A_B, quote = "The term \"natural gas sold under a fixed contract\" means domestic natural gas sold by the producer under a contract, in effect on February 1, 1975")
rule NaturalGasSoldUnderFixedContractDefinition(gas: Integer, contract: Integer) defeasible {
    label en official "domestic gas sold by the producer under a contract in effect from February 1, 1975 whose price cannot reflect the tax, with no unrebutted tax-reflecting price increase (section 613A(b)(3)(A))";
    when domestic_natural_gas_613A(gas);
    when gas_sold_by_producer_under_fixed_contract_613Ab3A(gas, contract);
    when contract_in_effect_on_february_1_1975_and_until_sale_613Ab3A(contract);
    when not_known(contract_price_adjustable_for_repeal_of_gas_depletion_613Ab3A(contract));
    when not_known(price_increase_presumed_to_reflect_tax_613Ab3(contract));
    then natural_gas_sold_under_fixed_contract_613Ab3A(gas);
}
pub relation gas_produced_and_sold_by_producer_on_613Ab3B(gas: Integer, sold_on: Date) kind empirical {
    label en official "the domestic natural gas is produced and sold by the producer on the date (section 613A(b)(3)(B))";
}
pub relation gas_subject_to_federal_power_commission_jurisdiction_613Ab3B(gas: Integer) kind empirical {
    label en official "the sale of the gas is subject to the jurisdiction of the Federal Power Commission (section 613A(b)(3)(B))";
}
pub relation regulated_gas_price_adjusted_to_reflect_tax_613Ab3B(gas: Integer) kind empirical {
    label en official "the price of the gas has been adjusted to reflect to any extent the increase in the seller's tax liability by reason of the repeal of percentage depletion for gas (section 613A(b)(3)(B))";
}
pub relation regulated_gas_price_increased_after_february_1_1975_613Ab3B(gas: Integer) kind empirical {
    label en official "the price of the gas increased after February 1, 1975 (section 613A(b)(3)(B), second sentence)";
}
pub relation regulated_gas_taxpayer_demonstrates_contrary_613Ab3B(gas: Integer) kind empirical {
    label en official "the taxpayer demonstrates the contrary by clear and convincing evidence (section 613A(b)(3)(B)); an adjudicated fact (DECISION-0194)";
}
pub relation regulated_gas_increase_presumed_to_reflect_tax_613Ab3B(gas: Integer) kind institutional {
    label en official "a post-1975 price increase of regulated gas is presumed to reflect the tax unless the contrary is demonstrated (section 613A(b)(3)(B))";
}
rule RegulatedGasIncreasePresumedToReflectTax(gas: Integer) defeasible {
    label en official "presumption for regulated gas (section 613A(b)(3)(B), second sentence)";
    when regulated_gas_price_increased_after_february_1_1975_613Ab3B(gas);
    when not_known(regulated_gas_taxpayer_demonstrates_contrary_613Ab3B(gas));
    then regulated_gas_increase_presumed_to_reflect_tax_613Ab3B(gas);
}
pub relation regulated_natural_gas_613Ab3B(gas: Integer) kind institutional {
    label en official "regulated natural gas: domestic gas produced and sold by the producer before July 1, 1976, subject to Federal Power Commission jurisdiction, at a price not adjusted for the repeal of gas depletion (section 613A(b)(3)(B))";
}
@source(IRC_S613A_B, quote = "The term \"regulated natural gas\" means domestic natural gas produced and sold by the producer, before July 1, 1976, subject to the jurisdiction of the Federal Power Commission")
rule RegulatedNaturalGasDefinition(gas: Integer, sold_on: Date) defeasible {
    label en official "domestic gas sold before 1976-07-01 under FPC jurisdiction whose price was not adjusted to reflect the tax (section 613A(b)(3)(B))";
    when domestic_natural_gas_613A(gas);
    when gas_produced_and_sold_by_producer_on_613Ab3B(gas, sold_on);
    when sold_on < @1976-07-01;
    when gas_subject_to_federal_power_commission_jurisdiction_613Ab3B(gas);
    when not_known(regulated_gas_price_adjusted_to_reflect_tax_613Ab3B(gas));
    when not_known(regulated_gas_increase_presumed_to_reflect_tax_613Ab3B(gas));
    then regulated_natural_gas_613Ab3B(gas);
}
pub relation gas_determined_from_geopressured_brine_under_ngpa_503_613Ab3Ci(gas: Integer) kind empirical {
    label en official "the gas is determined in accordance with section 503 of the Natural Gas Policy Act of 1978 to be produced from geopressured brine (section 613A(b)(3)(C)(i))";
}
pub relation well_drilling_began_on_613Ab3Cii(gas: Integer, began: Date) kind empirical {
    label en official "the drilling of the well producing the gas began on the date (section 613A(b)(3)(C)(ii))";
}
pub relation qualified_natural_gas_from_geopressured_brine_613Ab3C(gas: Integer) kind institutional {
    label en official "qualified natural gas from geopressured brine: determined under section 503 NGPA to be from brine, from a well whose drilling began after 1978-09-30 and before 1984-01-01 (section 613A(b)(3)(C))";
}
@source(IRC_S613A_B, quote = "(ii) which is produced from any well the drilling of which began after September 30, 1978, and before January 1, 1984.")
rule QualifiedGeopressuredBrineGasDefinition(gas: Integer, began: Date) strict {
    label en official "brine gas from a well begun in the window (section 613A(b)(3)(C)(i)-(ii))";
    when natural_gas_product_613A(gas);
    when gas_determined_from_geopressured_brine_under_ngpa_503_613Ab3Ci(gas);
    when well_drilling_began_on_613Ab3Cii(gas, began);
    when began > @1978-09-30;
    when began < @1984-01-01;
    then qualified_natural_gas_from_geopressured_brine_613Ab3C(gas);
}
pub relation gas_of_asset_exempt_under_613Ab(asset: Asset) kind institutional {
    label en official "the asset's gas is exempt under section 613A(b): regulated natural gas, gas sold under a fixed contract, or qualified geopressured brine gas";
}
rule AssetGasExemptFixedContract(asset: Asset, gas: Integer) defeasible {
    label en official "fixed-contract gas of the asset (section 613A(b)(1)(B))";
    when gas_of_asset_613A(gas, asset);
    when natural_gas_sold_under_fixed_contract_613Ab3A(gas);
    then gas_of_asset_exempt_under_613Ab(asset);
}
rule AssetGasExemptRegulatedGas(asset: Asset, gas: Integer) defeasible {
    label en official "regulated natural gas of the asset (section 613A(b)(1)(A))";
    when gas_of_asset_613A(gas, asset);
    when regulated_natural_gas_613Ab3B(gas);
    then gas_of_asset_exempt_under_613Ab(asset);
}
rule AssetGasExemptGeopressuredBrine(asset: Asset, gas: Integer) defeasible {
    label en official "qualified geopressured brine gas of the asset (section 613A(b)(2))";
    when gas_of_asset_613A(gas, asset);
    when qualified_natural_gas_from_geopressured_brine_613Ab3C(gas);
    then gas_of_asset_exempt_under_613Ab(asset);
}
@source(IRC_S613A_B, quote = "(A) regulated natural gas, and")
rule Section613AbRateTwentyTwoPercentForRegulatedOrFixedContractGas(asset: Asset, gas: Integer) defeasible {
    label en official "regulated natural gas and gas sold under a fixed contract: section 613 applies with 22 percent deemed specified (section 613A(b)(1)); an asset is taken at the rate of its exempt gas (JUDGMENT CALL: mixed production is not split)";
    when gas_of_asset_613A(gas, asset);
    when regulated_natural_gas_613Ab3B(gas);
    then mineral_rate_applies(asset, 0.22);
}
rule Section613AbRateTwentyTwoPercentForFixedContractGas(asset: Asset, gas: Integer) defeasible {
    label en official "gas sold under a fixed contract: 22 percent (section 613A(b)(1)(B))";
    when gas_of_asset_613A(gas, asset);
    when natural_gas_sold_under_fixed_contract_613Ab3A(gas);
    then mineral_rate_applies(asset, 0.22);
}
@source(IRC_S613A_B, quote = "and 10 percent shall be deemed to be specified in subsection (b) of section 613 for purposes of subsection (a) of such section.")
rule Section613AbRateTenPercentForGeopressuredBrineGas(asset: Asset, gas: Integer) defeasible {
    label en official "qualified natural gas from geopressured brine: section 613 applies with 10 percent deemed specified (section 613A(b)(2))";
    when gas_of_asset_613A(gas, asset);
    when qualified_natural_gas_from_geopressured_brine_613Ab3C(gas);
    then mineral_rate_applies(asset, 0.10);
}
pub relation percentage_depletion_denied_for_oil_or_gas_613Aa(p: Person, asset: Asset, y: TaxableYear) kind institutional {
    label en official "the allowance for depletion of an oil or gas well is computed without regard to section 613, as no exception of section 613A applies (section 613A(a))";
}
pub relation exception_to_613Aa_denial_613A(p: Person, y: TaxableYear, asset: Asset) kind institutional {
    label en official "an exception to the (a) denial applies: (b) exempt gas, or the (c) independent producer exemption";
}
rule ExceptionByExemptGas(p: Person, y: TaxableYear, asset: Asset) defeasible {
    label en official "exempt gas under (b) is an exception to (a)";
    when is_oil_or_gas_property(p, asset);
    when us.irc.core::year_of(p, y);
    when gas_of_asset_exempt_under_613Ab(asset);
    then exception_to_613Aa_denial_613A(p, y, asset);
}
rule ExceptionByIndependentProducerExemption(p: Person, y: TaxableYear, asset: Asset) defeasible {
    label en official "the section 613A(c) exemption is an exception to (a)";
    when is_oil_or_gas_property(p, asset);
    when is_independent_producer_or_royalty_owner(p, y);
    when not_known(is_retailer_excluded_from_613a_c(p, y));
    when not_known(refiner_excluded_from_613A_c_613Ad4(p, y));
    then exception_to_613Aa_denial_613A(p, y, asset);
}
@source(IRC_S613A_A, quote = "Except as otherwise provided in this section, the allowance for depletion under section 611 with respect to any oil or gas well shall be computed without regard to section 613.")
rule PercentageDepletionDeniedForOilAndGasByDefault(p: Person, y: TaxableYear, asset: Asset) defeasible {
    label en official "no section 613A exception: depletion of an oil or gas well is computed without regard to section 613, i.e. cost depletion (section 613A(a))";
    when is_oil_or_gas_property(p, asset);
    when us.irc.core::year_of(p, y);
    when not_known(exception_to_613Aa_denial_613A(p, y, asset));
    then percentage_depletion_denied_for_oil_or_gas_613Aa(p, asset, y);
}

// ===================== (c)(2): average daily production; partial interests =====================

pub relation taxable_year_days_613Ac2A(y: TaxableYear, days: Integer) kind empirical {
    label en official "the number of days in the taxable year (section 613A(c)(2)(A))";
}
pub relation aggregate_production_of_year_613Ac2A(p: Person, y: TaxableYear, kind: ProductKind613A, amount: Decimal) kind empirical {
    label en official "the taxpayer's aggregate production of domestic crude oil (barrels) or natural gas (cubic feet) during the taxable year, partial interests already counted by (c)(2)(B) (section 613A(c)(2)(A))";
}
pub relation average_daily_production_613Ac2A(p: Person, y: TaxableYear, kind: ProductKind613A, aggregate: Decimal, days: Integer) kind institutional {
    label en official "the average daily production is the aggregate production divided by the number of days: kept as the pair (aggregate, days) so that comparisons stay exact (section 613A(c)(2)(A))";
}
@source(IRC_S613A_C, quote = "the taxpayer's average daily production of domestic crude oil or natural gas for any taxable year, shall be determined by dividing his aggregate production of domestic crude oil or natural gas, as the case may be, during the taxable year by the number of days in such taxable year")
rule AverageDailyProductionAsAggregateOverDays(p: Person, y: TaxableYear, kind: ProductKind613A, aggregate: Decimal, days: Integer) strict {
    label en official "average daily production = aggregate / days, kept as a pair (section 613A(c)(2)(A))";
    when aggregate_production_of_year_613Ac2A(p, y, kind, aggregate);
    when taxable_year_days_613Ac2A(y, days);
    when days > 0;
    then average_daily_production_613Ac2A(p, y, kind, aggregate, days);
}
pub relation total_production_of_property_613Ac2B(asset: Asset, y: TaxableYear, kind: ProductKind613A, total: Decimal) kind empirical {
    label en official "the total production of the property (section 613A(c)(2)(B))";
}
pub relation percentage_participation_in_revenues_613Ac2B(p: Person, asset: Asset, share: Decimal) kind empirical {
    label en official "the taxpayer's percentage participation in the revenues from the property, as a fraction (section 613A(c)(2)(B))";
}
pub relation taxpayer_share_of_property_production_613Ac2B(p: Person, asset: Asset, y: TaxableYear, kind: ProductKind613A, amount: Decimal) kind institutional {
    label en official "a taxpayer holding a partial interest (including through a partnership) is considered to produce the property's total production times its percentage participation in the revenues (section 613A(c)(2)(B))";
}
@source(IRC_S613A_C, quote = "such taxpayer's production shall be considered to be that amount of such production determined by multiplying the total production of such property by the taxpayer's percentage participation in the revenues from such property.")
rule PartialInterestProductionIsShareOfTotal(p: Person, asset: Asset, y: TaxableYear, kind: ProductKind613A, total: Decimal, share: Decimal) strict {
    label en official "partial interest production = total production x revenue participation (section 613A(c)(2)(B))";
    when total_production_of_property_613Ac2B(asset, y, kind, total);
    when percentage_participation_in_revenues_613Ac2B(p, asset, share);
    then taxpayer_share_of_property_production_613Ac2B(p, asset, y, kind, total * share);
}

// ===================== (c)(3), (c)(4), (c)(6): depletable quantities; marginal production =====================

pub relation aggregate_marginal_production_of_year_613Ac6G(p: Person, y: TaxableYear, kind: ProductKind613A, amount: Decimal) kind empirical {
    label en official "the taxpayer's aggregate marginal production of domestic crude oil or natural gas for the taxable year, partial interests counted as in (c)(6)(G)(ii) (section 613A(c)(6)(G)(i))";
}
pub relation elects_marginal_pro_rata_613Ac6B(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects that the marginal-production rules of (6)(A) apply to the pro rata portion of marginal production to which (1) would have applied (section 613A(c)(6)(B))";
}
pub relation marginal_pro_rata_election_in_effect_613Ac6B(p: Person, y: TaxableYear) kind institutional {
    label en official "the (6)(B) election is in effect for the taxable year";
}
@source(IRC_S613A_C, quote = "If the taxpayer elects to have this subparagraph apply for any taxable year")
rule Section613Ac6BElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer may elect (6)(B) treatment for the taxable year (section 613A(c)(6)(B))";
    when elects_marginal_pro_rata_613Ac6B(p, y);
    then power Section613Ac6BMarginalProRataElection {
        holder p;
        over y;
        exercise elects_marginal_pro_rata_613Ac6B(p, y);
        valid_when is_independent_producer_or_royalty_owner(p, y);
        effect create(marginal_pro_rata_election_in_effect_613Ac6B(p, y));
        window [@1975-01-01, infinity);
    };
}
pub relation depletable_oil_barrel_days_613Ac3(p: Person, y: TaxableYear, amount: Decimal) kind institutional {
    label en official "the depletable oil quantity in barrel-days (quantity x days): the tentative 1,000 barrels a day, reduced but not below zero by the average daily marginal production unless the (6)(B) election is made (section 613A(c)(3))";
}
@source(IRC_S613A_C, quote = "(i) the tentative quantity determined under subparagraph (B), reduced (but not below zero) by")
rule DepletableOilBarrelDaysReducedByMarginalProduction(p: Person, y: TaxableYear, days: Integer, marginal: Decimal) defeasible {
    label en official "1,000 x days less the aggregate marginal crude oil production, floored at zero (section 613A(c)(3)(A)(i)-(ii), (B)); equivalent to the daily reduction";
    when is_independent_producer_or_royalty_owner(p, y);
    when taxable_year_days_613Ac2A(y, days);
    when aggregate_marginal_production_of_year_613Ac6G(p, y, CrudeOil, marginal);
    when not_known(marginal_pro_rata_election_in_effect_613Ac6B(p, y));
    then depletable_oil_barrel_days_613Ac3(p, y, max(1000.0 * days - marginal, 0.0));
}
rule DepletableOilBarrelDaysUnreducedWithElection(p: Person, y: TaxableYear, days: Integer) defeasible {
    label en official "a taxpayer making the (6)(B) election takes the unreduced tentative quantity (section 613A(c)(3)(A)(ii))";
    when is_independent_producer_or_royalty_owner(p, y);
    when taxable_year_days_613Ac2A(y, days);
    when marginal_pro_rata_election_in_effect_613Ac6B(p, y);
    then depletable_oil_barrel_days_613Ac3(p, y, 1000.0 * days);
}
rule DepletableOilBarrelDaysUnreducedWithoutMarginalProduction(p: Person, y: TaxableYear, days: Integer) defeasible {
    label en official "with no marginal production the quantity is the tentative 1,000 barrels a day (section 613A(c)(3)(B))";
    when is_independent_producer_or_royalty_owner(p, y);
    when taxable_year_days_613Ac2A(y, days);
    when not_known(has_marginal_production_613Ac6G(p, y));
    then depletable_oil_barrel_days_613Ac3(p, y, 1000.0 * days);
}
pub relation has_marginal_production_613Ac6G(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer has marginal crude oil production for the year (bridge)";
}
rule HasMarginalProductionBridge(p: Person, y: TaxableYear, marginal: Decimal) defeasible {
    label en official "bridge";
    when aggregate_marginal_production_of_year_613Ac6G(p, y, CrudeOil, marginal);
    then has_marginal_production_613Ac6G(p, y);
}
pub relation barrels_elected_for_gas_613Ac4(p: Person, y: TaxableYear, barrels_per_day: Decimal) kind empirical {
    label en official "the number of barrels a day of the depletable oil quantity to which the taxpayer elects to have the gas quantity apply (section 613A(c)(4))";
}
pub relation gas_quantity_election_in_effect_613Ac4(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 613A(c)(4) election of barrels for the gas quantity is in effect";
}
@source(IRC_S613A_C, quote = "Such election shall be made at such time and in such manner as the Secretary shall by regulations prescribe.")
rule Section613Ac4GasQuantityElectionPower(p: Person, y: TaxableYear, barrels: Decimal) strict {
    label en official "a taxpayer may elect how many barrels of its depletable oil quantity carry the gas quantity (section 613A(c)(4)); time and manner are regulatory";
    when barrels_elected_for_gas_613Ac4(p, y, barrels);
    then power Section613Ac4GasQuantityElection {
        holder p;
        over y;
        exercise barrels_elected_for_gas_613Ac4(p, y, barrels);
        valid_when is_independent_producer_or_royalty_owner(p, y);
        effect create(gas_quantity_election_in_effect_613Ac4(p, y));
        window [@1975-01-01, infinity);
    };
}
pub relation depletable_gas_cubic_foot_days_613Ac4(p: Person, y: TaxableYear, amount: Decimal) kind institutional {
    label en official "the depletable natural gas quantity in cubic-foot-days: 6,000 cubic feet times the elected barrels, times days (section 613A(c)(4))";
}
@source(IRC_S613A_C, quote = "the depletable natural gas quantity of any taxpayer for any taxable year shall be equal to 6,000 cubic feet multiplied by the number of barrels of the taxpayer's depletable oil quantity to which the taxpayer elects to have this paragraph apply.")
rule DepletableGasCubicFootDays(p: Person, y: TaxableYear, barrels: Decimal, days: Integer) defeasible {
    label en official "6,000 x elected barrels x days (section 613A(c)(4))";
    when gas_quantity_election_in_effect_613Ac4(p, y);
    when barrels_elected_for_gas_613Ac4(p, y, barrels);
    when taxable_year_days_613Ac2A(y, days);
    then depletable_gas_cubic_foot_days_613Ac4(p, y, 6000.0 * barrels * days);
}
pub relation depletable_oil_barrel_days_after_gas_election_613Ac4(p: Person, y: TaxableYear, amount: Decimal) kind institutional {
    label en official "the depletable oil quantity in barrel-days after reduction by the barrels elected for gas (section 613A(c)(4), second sentence)";
}
@source(IRC_S613A_C, quote = "The taxpayer's depletable oil quantity for any taxable year shall be reduced by the number of barrels with respect to which an election under this paragraph applies.")
rule DepletableOilReducedByGasElection(p: Person, y: TaxableYear, oil: Decimal, barrels: Decimal, days: Integer) defeasible {
    label en official "oil barrel-days less elected barrels x days (section 613A(c)(4)); floored at zero (JUDGMENT CALL)";
    when depletable_oil_barrel_days_613Ac3(p, y, oil);
    when gas_quantity_election_in_effect_613Ac4(p, y);
    when barrels_elected_for_gas_613Ac4(p, y, barrels);
    when taxable_year_days_613Ac2A(y, days);
    then depletable_oil_barrel_days_after_gas_election_613Ac4(p, y, max(oil - barrels * days, 0.0));
}
rule DepletableOilNotReducedWithoutGasElection(p: Person, y: TaxableYear, oil: Decimal) defeasible {
    label en official "without the gas election the oil quantity stands (section 613A(c)(4))";
    when depletable_oil_barrel_days_613Ac3(p, y, oil);
    when not_known(gas_quantity_election_in_effect_613Ac4(p, y));
    then depletable_oil_barrel_days_after_gas_election_613Ac4(p, y, oil);
}
// --- (c)(6): marginal properties ---
pub relation taxable_year_begins_in_calendar_year_613A(y: TaxableYear, calendar_year: Integer) kind empirical {
    label en official "the calendar year in which the taxable year begins (section 613A(c)(6)(C)-(E))";
}
pub relation average_daily_production_barrel_equivalents_of_property_613Ac6E(asset: Asset, calendar_year: Integer, amount: Decimal) kind empirical {
    label en official "the average daily production of domestic crude oil and natural gas from the producing wells on the property for the calendar year, in barrel equivalents (section 613A(c)(6)(E)(i))";
}
pub relation number_of_producing_wells_613Ac6E(asset: Asset, calendar_year: Integer, wells: Integer) kind empirical {
    label en official "the number of producing wells on the property (section 613A(c)(6)(E)(ii))";
}
pub relation stripper_well_property_613Ac6E(asset: Asset, calendar_year: Integer) kind institutional {
    label en official "a stripper well property: the average daily production per producing well is 15 barrel equivalents or less (section 613A(c)(6)(E))";
}
@source(IRC_S613A_C, quote = "is 15 barrel equivalents or less.")
rule StripperWellPropertyDefinition(asset: Asset, cy: Integer, production: Decimal, wells: Integer) strict {
    label en official "production / wells <= 15, tested as production <= 15 x wells (section 613A(c)(6)(E))";
    when average_daily_production_barrel_equivalents_of_property_613Ac6E(asset, cy, production);
    when number_of_producing_wells_613Ac6E(asset, cy, wells);
    when wells > 0;
    when production <= 15.0 * wells;
    then stripper_well_property_613Ac6E(asset, cy);
}
pub relation weighted_average_api_gravity_of_crude_oil_613Ac6F(asset: Asset, gravity: Decimal) kind empirical {
    label en official "the weighted average gravity in degrees API of the crude oil produced from the property, corrected to 60 degrees Fahrenheit (section 613A(c)(6)(F))";
}
pub relation heavy_oil_property_613Ac6F(asset: Asset) kind institutional {
    label en official "the crude oil produced from the property is heavy oil: weighted average gravity of 20 degrees API or less (section 613A(c)(6)(F))";
}
@source(IRC_S613A_C, quote = "the term \"heavy oil\" means domestic crude oil produced from any property if such crude oil had a weighted average gravity of 20 degrees API or less")
rule HeavyOilDefinition(asset: Asset, gravity: Decimal) strict {
    label en official "gravity 20 degrees API or less (section 613A(c)(6)(F))";
    when weighted_average_api_gravity_of_crude_oil_613Ac6F(asset, gravity);
    when gravity <= 20.0;
    then heavy_oil_property_613Ac6F(asset);
}
pub relation substantially_all_production_of_calendar_year_is_heavy_oil_613Ac6D(asset: Asset, calendar_year: Integer) kind empirical {
    label en official "substantially all of the property's production during the calendar year is heavy oil (section 613A(c)(6)(D)(ii)); 'substantially all' is an adjudicated fact (DECISION-0194)";
}
pub relation marginal_property_613Ac6D(asset: Asset, y: TaxableYear) kind institutional {
    label en official "a marginal property for the taxable year: a stripper well property, or a property substantially all of whose production is heavy oil, for the calendar year in which the taxable year begins (section 613A(c)(6)(D))";
}
@source(IRC_S613A_C, quote = "(i) is a stripper well property for the calendar year in which the taxable year begins, or")
rule MarginalPropertyByStripperWells(asset: Asset, y: TaxableYear, cy: Integer) defeasible {
    label en official "a stripper well property is marginal (section 613A(c)(6)(D)(i))";
    when taxable_year_begins_in_calendar_year_613A(y, cy);
    when stripper_well_property_613Ac6E(asset, cy);
    then marginal_property_613Ac6D(asset, y);
}
@source(IRC_S613A_C, quote = "(ii) is a property substantially all of the production of which during such calendar year is heavy oil.")
rule MarginalPropertyByHeavyOil(asset: Asset, y: TaxableYear, cy: Integer) defeasible {
    label en official "a property producing substantially only heavy oil is marginal (section 613A(c)(6)(D)(ii))";
    when taxable_year_begins_in_calendar_year_613A(y, cy);
    when substantially_all_production_of_calendar_year_is_heavy_oil_613Ac6D(asset, cy);
    when heavy_oil_property_613Ac6F(asset);
    then marginal_property_613Ac6D(asset, y);
}
pub relation reference_price_for_crude_oil_613Ac6C(calendar_year: Integer, price: Money) kind empirical {
    label en official "the reference price for crude oil for the calendar year, determined under section 45K(d)(2)(C); the published price is a pending dependency (section 613A(c)(6)(C))";
}
pub relation applicable_percentage_613Ac6C(y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the applicable percentage: 15 percent plus 1 percentage point for each whole dollar by which $20 exceeds the reference price for the preceding calendar year, not greater than 25 percent (section 613A(c)(6)(C))";
}
@source(IRC_S613A_C, quote = "(ii) 1 percentage point for each whole dollar by which $20 exceeds the reference price for crude oil for the calendar year preceding the calendar year in which the taxable year begins.")
rule ApplicablePercentageBelowTwentyDollars(y: TaxableYear, cy: Integer, prior: Integer, price: Money) defeasible {
    label en official "15 percent + whole dollars below $20 as percentage points, capped at 25 percent (section 613A(c)(6)(C))";
    when taxable_year_begins_in_calendar_year_613A(y, cy);
    when reference_price_for_crude_oil_613Ac6C(prior, price);
    when prior == cy - 1;
    when price < 20.00 USD;
    then applicable_percentage_613Ac6C(y, min(0.25, 0.15 + (round(20.00 USD - price, 0, "FLOOR") / 1.00 USD) * 0.01));
}
rule ApplicablePercentageAtOrAboveTwentyDollars(y: TaxableYear, cy: Integer, prior: Integer, price: Money) defeasible {
    label en official "15 percent when the reference price is $20 or more (section 613A(c)(6)(C)(i))";
    when taxable_year_begins_in_calendar_year_613A(y, cy);
    when reference_price_for_crude_oil_613Ac6C(prior, price);
    when prior == cy - 1;
    when price >= 20.00 USD;
    then applicable_percentage_613Ac6C(y, 0.15);
}
@source(IRC_S613A_C, quote = "and the applicable percentage shall be deemed to be specified in subsection (b) of section 613 for purposes of subsection (a) of that section.")
rule Section613Ac6ARateForMarginalProperty(p: Person, y: TaxableYear, asset: Asset, rate: Decimal) defeasible {
    label en official "marginal production is depleted at the applicable percentage (section 613A(c)(6)(A)); the (d) exclusions still apply";
    when is_independent_producer_or_royalty_owner(p, y);
    when is_oil_or_gas_property(p, asset);
    when marginal_property_613Ac6D(asset, y);
    when applicable_percentage_613Ac6C(y, rate);
    when not_known(is_retailer_excluded_from_613a_c(p, y));
    when not_known(refiner_excluded_from_613A_c_613Ad4(p, y));
    then mineral_rate_applies(asset, rate);
}

// ===================== (c)(7): production above the depletable quantity =====================

pub relation depletion_if_all_production_at_the_613A_rate_613Ac7(p: Person, asset: Asset, y: TaxableYear, kind: ProductKind613A, amount: Money) kind empirical {
    label en official "the depletion that would be allowable under section 613(a) for all of the taxpayer's oil (or gas) produced from the property, computed as if section 613 applied to all of it at the rate of paragraph (1) or (6) (section 613A(c)(7)(A)-(B))";
}
pub relation crude_oil_allowance_for_production_above_quantity_613Ac7A(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "when average daily oil production exceeds the depletable oil quantity, the allowance of a property is its all-production depletion times the ratio of the quantity to the aggregate production; one rounding to cents HALF_UP (JUDGMENT CALL) (section 613A(c)(7)(A))";
}
@source(IRC_S613A_C, quote = "If the taxpayer's average daily production of domestic crude oil exceeds his depletable oil quantity, the allowance under paragraph (1)(A) with respect to oil produced during the taxable year from each property in the United States shall be that amount which bears the same ratio")
rule AllowanceForOilProductionAboveQuantity(p: Person, asset: Asset, y: TaxableYear, aggregate: Decimal, quantity: Decimal, all_depletion: Money) defeasible {
    label en official "allowance = depletion for all production x quantity-days / aggregate production, in one division (section 613A(c)(7)(A))";
    when aggregate_production_of_year_613Ac2A(p, y, CrudeOil, aggregate);
    when depletable_oil_barrel_days_after_gas_election_613Ac4(p, y, quantity);
    when depletion_if_all_production_at_the_613A_rate_613Ac7(p, asset, y, CrudeOil, all_depletion);
    when aggregate > quantity;
    when aggregate > 0.0;
    then crude_oil_allowance_for_production_above_quantity_613Ac7A(p, asset, y, div_round(all_depletion * quantity, aggregate, 2, "HALF_UP"));
}
pub relation oil_production_within_quantity_by_days_613Ac1A(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's average daily domestic crude oil production does not exceed the depletable oil quantity, tested on the aggregate: aggregate <= quantity x days (section 613A(c)(1)(A), (c)(7)(A))";
}
rule OilProductionWithinQuantityByDays(p: Person, y: TaxableYear, aggregate: Decimal, quantity: Decimal) defeasible {
    label en official "aggregate crude oil production within the barrel-days quantity (section 613A(c)(1)(A))";
    when aggregate_production_of_year_613Ac2A(p, y, CrudeOil, aggregate);
    when depletable_oil_barrel_days_after_gas_election_613Ac4(p, y, quantity);
    when aggregate <= quantity;
    then oil_production_within_quantity_by_days_613Ac1A(p, y);
}
pub relation natural_gas_allowance_for_production_above_quantity_613Ac7B(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "when average daily gas production exceeds the depletable gas quantity, the allowance of a property is its all-production depletion times the ratio of the quantity to the aggregate production; one rounding to cents HALF_UP (JUDGMENT CALL) (section 613A(c)(7)(B))";
}
@source(IRC_S613A_C, quote = "If the taxpayer's average daily production of domestic natural gas exceeds his depletable natural gas quantity, the allowance under paragraph (1)(B) with respect to natural gas produced during the taxable year from each property in the United States shall be that amount which bears the same ratio")
rule AllowanceForGasProductionAboveQuantity(p: Person, asset: Asset, y: TaxableYear, aggregate: Decimal, quantity: Decimal, all_depletion: Money) defeasible {
    label en official "allowance = depletion for all production x quantity / aggregate production, in one division (section 613A(c)(7)(B))";
    when aggregate_production_of_year_613Ac2A(p, y, NaturalGas, aggregate);
    when depletable_gas_cubic_foot_days_613Ac4(p, y, quantity);
    when depletion_if_all_production_at_the_613A_rate_613Ac7(p, asset, y, NaturalGas, all_depletion);
    when aggregate > quantity;
    when aggregate > 0.0;
    then natural_gas_allowance_for_production_above_quantity_613Ac7B(p, asset, y, div_round(all_depletion * quantity, aggregate, 2, "HALF_UP"));
}
pub relation gross_income_from_oil_of_property_613Ac7C(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income from oil produced from the property for the taxable year (section 613A(c)(7)(C))";
}
pub relation gross_income_from_gas_of_property_613Ac7C(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income from gas produced from the property for the taxable year (section 613A(c)(7)(C))";
}
pub relation taxable_income_of_property_allocated_to_oil_613Ac7C(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "if both oil and gas are produced, the taxable income from the property is allocated between them in proportion to gross income; one division, cents HALF_UP (JUDGMENT CALL) (section 613A(c)(7)(C))";
}
@source(IRC_S613A_C, quote = "the taxable income from the property, in applying the taxable income limitation in section 613(a), shall be allocated between the oil production and the gas production in proportion to the gross income during the taxable year from each.")
rule TaxableIncomeAllocatedToOilByGrossIncome(p: Person, asset: Asset, y: TaxableYear, taxable: Money, oil: Money, gas: Money) defeasible {
    label en official "oil share = taxable income x oil gross income / (oil + gas gross income) (section 613A(c)(7)(C))";
    when taxable_income_from_the_property_before_depletion(p, asset, y, taxable);
    when gross_income_from_oil_of_property_613Ac7C(p, asset, y, oil);
    when gross_income_from_gas_of_property_613Ac7C(p, asset, y, gas);
    when oil + gas > 0.00 USD;
    then taxable_income_of_property_allocated_to_oil_613Ac7C(p, asset, y, div_round(taxable * (oil / 1.00 USD), (oil + gas) / 1.00 USD, 2, "HALF_UP"));
}
pub relation taxable_income_of_property_allocated_to_gas_613Ac7C(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gas share of the property's taxable income, in proportion to gross income; one division (section 613A(c)(7)(C))";
}
rule TaxableIncomeAllocatedToGasByGrossIncome(p: Person, asset: Asset, y: TaxableYear, taxable: Money, oil: Money, gas: Money) defeasible {
    label en official "gas share = taxable income x gas gross income / (oil + gas gross income) (section 613A(c)(7)(C))";
    when taxable_income_from_the_property_before_depletion(p, asset, y, taxable);
    when gross_income_from_oil_of_property_613Ac7C(p, asset, y, oil);
    when gross_income_from_gas_of_property_613Ac7C(p, asset, y, gas);
    when oil + gas > 0.00 USD;
    then taxable_income_of_property_allocated_to_gas_613Ac7C(p, asset, y, div_round(taxable * (gas / 1.00 USD), (oil + gas) / 1.00 USD, 2, "HALF_UP"));
}

// ===================== (c)(8)-(10) =====================

pub relation member_of_controlled_group_613Ac8A(m: Person, g: Integer) kind empirical {
    label en official "the person is a member of the controlled group of corporations, with 'more than 50 percent' substituted for 'at least 80 percent' in section 1563(a) and section 1563(b)(2) disregarded (section 613A(c)(8)(D)(i)); the control test is asserted";
}
pub relation member_production_of_year_613Ac8A(m: Person, y: TaxableYear, kind: ProductKind613A, amount: Decimal) kind empirical {
    label en official "the member's production for the taxable year (section 613A(c)(8)(A))";
}
pub relation controlled_group_year_613Ac8A(g: Integer, y: TaxableYear) kind empirical {
    label en official "the controlled group is tested for the taxable year";
}
pub relation controlled_group_aggregate_production_613Ac8A(g: Integer, y: TaxableYear, kind: ProductKind613A, amount: Decimal) kind institutional {
    label en official "members of one controlled group are one taxpayer: the group's aggregate production is the sum over its members (section 613A(c)(8)(A))";
}
@source(IRC_S613A_C, quote = "For purposes of this subsection, persons who are members of the same controlled group of corporations shall be treated as one taxpayer.")
rule ControlledGroupCrudeOilProductionSum(g: Integer, y: TaxableYear) strict {
    label en official "sum of members' crude oil production (section 613A(c)(8)(A))";
    when controlled_group_year_613Ac8A(g, y);
    then controlled_group_aggregate_production_613Ac8A(g, y, CrudeOil, sum all amt: Decimal for m: Person where member_of_controlled_group_613Ac8A(m, g) and member_production_of_year_613Ac8A(m, y, CrudeOil, amt));
}
rule ControlledGroupGasProductionSum(g: Integer, y: TaxableYear) strict {
    label en official "sum of members' natural gas production (section 613A(c)(8)(A))";
    when controlled_group_year_613Ac8A(g, y);
    then controlled_group_aggregate_production_613Ac8A(g, y, NaturalGas, sum all amt: Decimal for m: Person where member_of_controlled_group_613Ac8A(m, g) and member_production_of_year_613Ac8A(m, y, NaturalGas, amt));
}
pub relation entity_crude_oil_production_in_period_613Ac8B(e: Person, y: TaxableYear, barrels: Integer) kind empirical {
    label en official "the entity's production of domestic crude oil during the period in question (section 613A(c)(8)(B)-(C))";
}
pub relation entities_of_common_ownership_613Ac8B(e: Person, group: Integer) kind empirical {
    label en official "the entity belongs to a set of corporations, trusts, or estates 50 percent or more of whose beneficial interest is owned by the same or related persons, counting only owners of at least 5 percent; or to a family of individuals (section 613A(c)(8)(B)-(C))";
}
pub relation total_crude_oil_production_of_common_ownership_group_613Ac8B(group: Integer, y: TaxableYear, barrels: Integer) kind institutional {
    label en official "the total crude oil production of the entities of the group (section 613A(c)(8)(B)-(C))";
}
rule CommonOwnershipGroupProductionSum(group: Integer, y: TaxableYear) strict {
    label en official "sum of the entities' production";
    when common_ownership_group_year_613Ac8B(group, y);
    then total_crude_oil_production_of_common_ownership_group_613Ac8B(group, y, sum all b: Integer for e: Person where entities_of_common_ownership_613Ac8B(e, group) and entity_crude_oil_production_in_period_613Ac8B(e, y, b));
}
pub relation common_ownership_group_year_613Ac8B(group: Integer, y: TaxableYear) kind empirical {
    label en official "the common-ownership group is tested for the taxable year";
}
pub relation tentative_quantity_share_613Ac8B(e: Person, group: Integer, y: TaxableYear, share: Rational) kind institutional {
    label en official "the share of the tentative 1,000-barrel quantity allocated to the entity: its crude oil production over the group's total, an exact fraction (section 613A(c)(8)(B)-(C))";
}
@source(IRC_S613A_C, quote = "the tentative quantity determined under paragraph (3)(B) shall be allocated among all such entities in proportion to the respective production of domestic crude oil during the period in question by such entities.")
rule TentativeQuantityAllocatedByProduction(e: Person, group: Integer, y: TaxableYear, own: Integer, total: Integer) strict {
    label en official "entity share = own production / group production (section 613A(c)(8)(B)); the family rule of (C) has the same form";
    when entities_of_common_ownership_613Ac8B(e, group);
    when entity_crude_oil_production_in_period_613Ac8B(e, y, own);
    when total_crude_oil_production_of_common_ownership_group_613Ac8B(group, y, total);
    when total > 0;
    then tentative_quantity_share_613Ac8B(e, group, y, own / total);
}
pub relation gas_cubic_feet_613Ac8Div(gas_cubic_feet: Integer, barrel_equivalents: Rational) kind institutional {
    label en official "each 6,000 cubic feet of domestic natural gas is 1 barrel of domestic crude oil (section 613A(c)(8)(D)(iv))";
}
rule SixThousandCubicFeetIsOneBarrel(cf: Integer) strict {
    label en official "barrel equivalents = cubic feet / 6,000 (section 613A(c)(8)(D)(iv))";
    when gas_volume_input_613Ac8D(cf);
    then gas_cubic_feet_613Ac8Div(cf, cf / 6000);
}
pub relation gas_volume_input_613Ac8D(cf: Integer) kind empirical {
    label en official "a volume of domestic natural gas in cubic feet";
}
pub relation portion_of_fiscal_year_in_calendar_year_613Ac9(y: TaxableYear, calendar_year: Integer) kind empirical {
    label en official "the taxable year has a portion that occurs during the single calendar year (section 613A(c)(9))";
}
pub relation portion_treated_as_short_taxable_year_613Ac9(y: TaxableYear, calendar_year: Integer) kind institutional {
    label en official "for a taxable year that is not a calendar year, each portion occurring during a single calendar year is treated as a short taxable year (section 613A(c)(9))";
}
@source(IRC_S613A_C, quote = "each portion of such taxable year which occurs during a single calendar year shall be treated as if it were a short taxable year.")
rule FiscalYearPortionsAreShortYears(y: TaxableYear, cy: Integer) defeasible {
    label en official "each calendar-year portion of a fiscal taxable year is a short taxable year (section 613A(c)(9))";
    when us.irc.core::fiscal_year(y);
    when portion_of_fiscal_year_in_calendar_year_613Ac9(y, cy);
    then portion_treated_as_short_taxable_year_613Ac9(y, cy);
}
pub relation production_of_gas_subject_to_613Ab_613Ac10(p: Person, y: TaxableYear, gas_amount: Decimal) kind empirical {
    label en official "production of natural gas to which subsection (b) applies (section 613A(c)(10))";
}
pub relation aggregate_production_for_c_excluding_b_gas_613Ac10(p: Person, y: TaxableYear, amount: Decimal) kind institutional {
    label en official "the gas production taken into account under (c): the aggregate production less the production of gas to which (b) applies (section 613A(c)(10)); floored at zero (JUDGMENT CALL)";
}
@source(IRC_S613A_C, quote = "In applying this subsection, there shall not be taken into account the production of natural gas with respect to which subsection (b) applies.")
rule GasProductionOfSubsectionBNotTakenIntoAccount(p: Person, y: TaxableYear, aggregate: Decimal, exempt: Decimal) defeasible {
    label en official "production under (b) is excluded from the (c) aggregate (section 613A(c)(10))";
    when aggregate_production_of_year_613Ac2A(p, y, NaturalGas, aggregate);
    when production_of_gas_subject_to_613Ab_613Ac10(p, y, exempt);
    then aggregate_production_for_c_excluding_b_gas_613Ac10(p, y, max(aggregate - exempt, 0.0));
}

pub relation has_production_of_gas_subject_to_613Ab_613Ac10(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer has production of natural gas to which subsection (b) applies (bridge)";
}
rule HasProductionOfBGasBridge(p: Person, y: TaxableYear, exempt: Decimal) defeasible {
    label en official "bridge";
    when production_of_gas_subject_to_613Ab_613Ac10(p, y, exempt);
    then has_production_of_gas_subject_to_613Ab_613Ac10(p, y);
}
rule GasProductionForCWithoutBGas(p: Person, y: TaxableYear, aggregate: Decimal) defeasible {
    label en official "with no (b) gas the whole gas aggregate is taken into account under (c) (section 613A(c)(10))";
    when aggregate_production_of_year_613Ac2A(p, y, NaturalGas, aggregate);
    when not_known(has_production_of_gas_subject_to_613Ab_613Ac10(p, y));
    then aggregate_production_for_c_excluding_b_gas_613Ac10(p, y, aggregate);
}
rule AboveQuantityOilAllowanceIsTheTentativeAmount(p: Person, asset: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the (c)(7)(A) allowance is the asset's tentative percentage-depletion amount when production exceeds the quantity (an asset with both oil and gas above quantity is not split, TECH-GAPS G4800 series)";
    when crude_oil_allowance_for_production_above_quantity_613Ac7A(p, asset, y, amount);
    then percentage_depletion_tentative_amount(p, asset, y, amount);
}
rule AboveQuantityGasAllowanceIsTheTentativeAmount(p: Person, asset: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the (c)(7)(B) allowance is the asset's tentative percentage-depletion amount when gas production exceeds the quantity";
    when natural_gas_allowance_for_production_above_quantity_613Ac7B(p, asset, y, amount);
    then percentage_depletion_tentative_amount(p, asset, y, amount);
}

// ===================== (d): limitations =====================

pub relation taxable_income_before_613Ad1_exclusions_613Ad1(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's taxable income for the year computed without regard to the excluded items (section 613A(d)(1))";
}
pub relation depletion_on_613Ac_production_613Ad1A(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "depletion on production from an oil or gas property subject to subsection (c) (section 613A(d)(1)(A))";
}
pub relation section_199A_deduction_613Ad1B(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deduction allowable under section 199A (section 613A(d)(1)(B))";
}
pub relation net_operating_loss_carryback_613Ad1C(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a net operating loss carryback to the taxable year under section 172 (section 613A(d)(1)(C))";
}
pub relation capital_loss_carryback_613Ad1D(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a capital loss carryback to the taxable year under section 1212 (section 613A(d)(1)(D))";
}
pub relation trust_distributions_to_beneficiaries_613Ad1E(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "in the case of a trust, distributions to its beneficiary (section 613A(d)(1)(E)); the closing exception for the 1970 settlor trusts is not modelled";
}
pub relation section_613A_d1_taxable_income_base(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income for the 65-percent limit, computed without regard to the items of (A)-(E): the case figure with the excluded items added back where they reduced it (section 613A(d)(1))";
}
@source(IRC_S613A_D, quote = "65 percent of the taxpayer's taxable income for the year computed without regard to—")
rule TaxableIncomeBaseAddsBackTheExcludedItems(p: Person, y: TaxableYear, base: Money, a: Money, b: Money, c: Money, d: Money, e: Money) defeasible {
    label en official "taxable income + (A) depletion on (c) production + (B) section 199A deduction + (C) NOL carryback + (D) capital loss carryback + (E) trust distributions (section 613A(d)(1)); the figure of module 14 is `taxable_income_for_613a_d_limit`";
    when taxable_income_before_613Ad1_exclusions_613Ad1(p, y, base);
    when depletion_on_613Ac_production_613Ad1A(p, y, a);
    when section_199A_deduction_613Ad1B(p, y, b);
    when net_operating_loss_carryback_613Ad1C(p, y, c);
    when capital_loss_carryback_613Ad1D(p, y, d);
    when trust_distributions_to_beneficiaries_613Ad1E(p, y, e);
    then section_613A_d1_taxable_income_base(p, y, base + a + b + c + d + e);
}
pub relation carryover_of_disallowed_613Ad1_from_preceding_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount disallowed for the preceding taxable year and treated as allowable under subsection (c) for this year (section 613A(d)(1), second sentence); asserted (the year chain is self-recursive, TECH-GAPS G2108)";
}
pub relation depletion_under_613Ac_before_65_percent_limit_613Ad1(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the depletion attributable to the application of subsection (c) for the year, before the 65-percent limit (section 613A(d)(1))";
}
pub relation deduction_under_613Ac_allowed_613Ad1(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the subsection (c) deduction allowed: the year's depletion plus the carried-over disallowed amount, not more than 65 percent of the taxable income base; cents HALF_UP (JUDGMENT CALL) (section 613A(d)(1))";
}
@source(IRC_S613A_D, quote = "The deduction for the taxable year attributable to the application of subsection (c) shall not exceed 65 percent of the taxpayer's taxable income for the year")
rule Section613AdDeductionAllowedWithinSixtyFivePercent(p: Person, y: TaxableYear, current: Money, carry: Money, base: Money) defeasible {
    label en official "min(current + carryover, 65 percent of the base), floored at zero (section 613A(d)(1))";
    when depletion_under_613Ac_before_65_percent_limit_613Ad1(p, y, current);
    when carryover_of_disallowed_613Ad1_from_preceding_year(p, y, carry);
    when section_613A_d1_taxable_income_base(p, y, base);
    then deduction_under_613Ac_allowed_613Ad1(p, y, max(min(current + carry, round(base * 0.65, 2, "HALF_UP")), 0 USD));
}
pub relation deduction_under_613Ac_disallowed_613Ad1(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount disallowed by the 65-percent limit, treated as allowable under subsection (c) for the following taxable year, subject to that year's limit (section 613A(d)(1), second sentence)";
}
@source(IRC_S613A_D, quote = "If an amount is disallowed as a deduction for the taxable year by reason of application of the preceding sentence, the disallowed amount shall be treated as an amount allowable as a deduction under subsection (c) for the following taxable year")
rule Section613AdDisallowedAmountCarriesToNextYear(p: Person, y: TaxableYear, current: Money, carry: Money, allowed: Money) defeasible {
    label en official "current + carryover less the allowed deduction, when positive (section 613A(d)(1))";
    when depletion_under_613Ac_before_65_percent_limit_613Ad1(p, y, current);
    when carryover_of_disallowed_613Ad1_from_preceding_year(p, y, carry);
    when deduction_under_613Ac_allowed_613Ad1(p, y, allowed);
    when current + carry > allowed;
    then deduction_under_613Ac_disallowed_613Ad1(p, y, current + carry - allowed);
}
pub relation percentage_depletion_otherwise_allowable_for_property_613Ad1(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the percentage depletion otherwise allowable to the property under subsection (c) (section 613A(d)(1), last sentence)";
}
pub relation total_percentage_depletion_otherwise_allowable_under_613Ac_613Ad1(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total percentage depletion otherwise allowable under subsection (c) across the taxpayer's properties (the sum over properties is asserted)";
}
pub relation disallowed_amount_allocated_to_property_613Ad1(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "for basis adjustments and the cost-versus-percentage comparison, the disallowed amount is allocated to the properties in proportion to the percentage depletion otherwise allowable to them; one division, cents HALF_UP (JUDGMENT CALL) (section 613A(d)(1), last sentence)";
}
@source(IRC_S613A_D, quote = "any amount disallowed as a deduction on the application of this paragraph shall be allocated to the respective properties from which the oil or gas was produced in proportion to the percentage depletion otherwise allowable to such properties under subsection (c).")
rule DisallowedAmountAllocatedToProperties(p: Person, asset: Asset, y: TaxableYear, disallowed: Money, prop_dep: Money, total_dep: Money) defeasible {
    label en official "disallowed amount x property depletion / total depletion (section 613A(d)(1))";
    when deduction_under_613Ac_disallowed_613Ad1(p, y, disallowed);
    when percentage_depletion_otherwise_allowable_for_property_613Ad1(p, asset, y, prop_dep);
    when total_percentage_depletion_otherwise_allowable_under_613Ac_613Ad1(p, y, total_dep);
    when total_dep > 0.00 USD;
    then disallowed_amount_allocated_to_property_613Ad1(p, asset, y, div_round(disallowed * (prop_dep / 1.00 USD), total_dep / 1.00 USD, 2, "HALF_UP"));
}
// --- (d)(3): related person ---
pub relation ownership_share_613Ad3(holder: Person, ent: Person, share: Decimal) kind empirical {
    label en official "the share the holder owns of the entity: stock value, profits or capital interest, or beneficial interest, with attribution through corporations, partnerships, trusts and estates already applied (section 613A(d)(3))";
}
pub relation significant_ownership_interest_613Ad3(holder: Person, ent: Person) kind institutional {
    label en official "a significant ownership interest: 5 percent or more in value of a corporation's stock, of the profits or capital of a partnership, or of the beneficial interests of an estate or trust (section 613A(d)(3)(A)-(C))";
}
@source(IRC_S613A_D, quote = "(A) with respect to any corporation, 5 percent or more in value of the outstanding stock of such corporation,")
rule SignificantOwnershipInterestFivePercent(holder: Person, ent: Person, share: Decimal) strict {
    label en official "a holding of 5 percent or more (section 613A(d)(3)(A)-(C))";
    when ownership_share_613Ad3(holder, ent, share);
    when share >= 0.05;
    then significant_ownership_interest_613Ad3(holder, ent);
}
pub relation related_person_613Ad3(p: Person, q: Person) kind institutional {
    label en official "a person is related to the taxpayer if a significant ownership interest in either is held by the other, or a third person has a significant ownership interest in both (section 613A(d)(3))";
}
@source(IRC_S613A_D, quote = "a person is a related person with respect to the taxpayer if a significant ownership interest in either the taxpayer or such person is held by the other")
rule RelatedPersonByDirectInterest(p: Person, q: Person) defeasible {
    label en official "the taxpayer holds a significant interest in the other (section 613A(d)(3))";
    when significant_ownership_interest_613Ad3(p, q);
    then related_person_613Ad3(p, q);
}
rule RelatedPersonByReverseInterest(p: Person, q: Person) defeasible {
    label en official "the other holds a significant interest in the taxpayer (section 613A(d)(3))";
    when significant_ownership_interest_613Ad3(q, p);
    then related_person_613Ad3(p, q);
}
@source(IRC_S613A_D, quote = "or if a third person has a significant ownership interest in both the taxpayer and such person.")
rule RelatedPersonByCommonOwner(p: Person, q: Person, third: Person) defeasible {
    label en official "a third person holds a significant interest in both (section 613A(d)(3))";
    when significant_ownership_interest_613Ad3(third, p);
    when significant_ownership_interest_613Ad3(third, q);
    when p != q;
    then related_person_613Ad3(p, q);
}
// --- (d)(2): the retail exclusion from components ---
pub relation sale_through_retail_outlet_operated_by_613Ad2A(p: Person, y: TaxableYear, seller: Person) kind empirical {
    label en official "oil, natural gas, or a derived product is sold through a retail outlet operated by the taxpayer or a related person, the sale not being a bulk sale to a commercial or industrial user (or of aviation fuels to the Department of Defense) (section 613A(d)(2)(A))";
}
pub relation sale_to_trademark_licensee_613Ad2Bi(p: Person, y: TaxableYear, seller: Person) kind empirical {
    label en official "a sale to a person obligated by an agreement with the taxpayer or a related person to use a trademark, trade name, or service mark in marketing oil or natural gas products (section 613A(d)(2)(B)(i))";
}
pub relation sale_to_person_occupying_controlled_outlet_613Ad2Bii(p: Person, y: TaxableYear, seller: Person) kind empirical {
    label en official "a sale to a person given authority by agreement to occupy a retail outlet owned, leased, or controlled by the taxpayer or a related person (section 613A(d)(2)(B)(ii))";
}
pub relation retail_sale_is_outside_united_states_without_domestic_export_613Ad2(p: Person, y: TaxableYear) kind empirical {
    label en official "the sales were made outside the United States and no domestic production of the taxpayer or a related person was exported in the year or the preceding year (section 613A(d)(2), last sentence); such sales are not taken into account";
}
pub relation retailer_sales_pattern_613Ad2(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer, directly or through a related person, sells oil, natural gas, or a derived product through a retail outlet it operates, or to a trademark licensee, or to an occupant of a controlled outlet (section 613A(d)(2)(A)-(B))";
}
@source(IRC_S613A_D, quote = "(A) through any retail outlet operated by the taxpayer or a related person, or")
rule RetailerSalesThroughOwnOutlet(p: Person, y: TaxableYear, seller: Person) defeasible {
    label en official "sales through an outlet the taxpayer or a related person operates (section 613A(d)(2)(A)); sales outside the United States without domestic export are not counted";
    when sale_through_retail_outlet_operated_by_613Ad2A(p, y, seller);
    when not_known(retail_sale_is_outside_united_states_without_domestic_export_613Ad2(p, y));
    then retailer_sales_pattern_613Ad2(p, y);
}
@source(IRC_S613A_D, quote = "(i) obligated under an agreement or contract with the taxpayer or a related person to use a trademark, trade name, or service mark")
rule RetailerSalesToTrademarkLicensee(p: Person, y: TaxableYear, seller: Person) defeasible {
    label en official "sales to a trademark licensee (section 613A(d)(2)(B)(i))";
    when sale_to_trademark_licensee_613Ad2Bi(p, y, seller);
    when not_known(retail_sale_is_outside_united_states_without_domestic_export_613Ad2(p, y));
    then retailer_sales_pattern_613Ad2(p, y);
}
@source(IRC_S613A_D, quote = "(ii) given authority, pursuant to an agreement or contract with the taxpayer or a related person, to occupy any retail outlet owned, leased, or in any way controlled by the taxpayer or a related person.")
rule RetailerSalesToOccupantOfControlledOutlet(p: Person, y: TaxableYear, seller: Person) defeasible {
    label en official "sales to an occupant of a controlled outlet (section 613A(d)(2)(B)(ii))";
    when sale_to_person_occupying_controlled_outlet_613Ad2Bii(p, y, seller);
    when not_known(retail_sale_is_outside_united_states_without_domestic_export_613Ad2(p, y));
    then retailer_sales_pattern_613Ad2(p, y);
}
@source(IRC_S613A_D, quote = "Subsection (c) shall not apply in the case of any taxpayer who directly, or through a related person, sells oil or natural gas")
rule Section613ADRetailerExclusionFromComponents(p: Person, y: TaxableYear, receipts: Money) defeasible {
    label en official "a taxpayer with a retail sales pattern is excluded from (c) unless the $5,000,000 safe harbor applies (section 613A(d)(2)); the components replace the bundled fact of module 14";
    when retailer_sales_pattern_613Ad2(p, y);
    unless combined_retail_gross_receipts_within_safe_harbor(p, y, receipts);
    then is_retailer_excluded_from_613a_c(p, y);
}
// --- (d)(4): refiners ---
pub relation combined_refinery_runs_of_taxpayer_and_related_persons_613Ad4(p: Person, y: TaxableYear, barrels: Decimal) kind empirical {
    label en official "the aggregate refinery runs of the taxpayer and of its related persons for the taxable year (section 613A(d)(4)); the sum over related persons is asserted";
}
pub relation taxpayer_or_related_person_refines_crude_oil_613Ad4(p: Person) kind empirical {
    label en official "the taxpayer or one or more related persons engages in the refining of crude oil (section 613A(d)(4))";
}
pub relation refiner_excluded_from_613A_c_613Ad4(p: Person, y: TaxableYear) kind institutional {
    label en official "a taxpayer whose refining group averages more than 75,000 barrels a day of refinery runs is excluded from (c): tested as aggregate runs > 75,000 x days (section 613A(d)(4))";
}
@source(IRC_S613A_D, quote = "subsection (c) shall not apply to the taxpayer for a taxable year if the average daily refinery runs of the taxpayer and such persons for the taxable year exceed 75,000 barrels.")
rule RefinerExclusionOverSeventyFiveThousandBarrels(p: Person, y: TaxableYear, runs: Decimal, days: Integer) defeasible {
    label en official "average daily runs above 75,000 barrels (section 613A(d)(4))";
    when taxpayer_or_related_person_refines_crude_oil_613Ad4(p);
    when combined_refinery_runs_of_taxpayer_and_related_persons_613Ad4(p, y, runs);
    when taxable_year_days_613Ac2A(y, days);
    when runs > 75000.0 * days;
    then refiner_excluded_from_613A_c_613Ad4(p, y);
}
// --- (d)(5): lease bonuses and advance royalties ---
pub relation lease_bonus_advance_royalty_or_amount_payable_without_regard_to_production_613Ad5(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "a lease bonus, advance royalty, or other amount payable without regard to production from the property (section 613A(d)(5))";
}
pub relation gross_income_from_property_for_613Ac_613Ad5(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "for a property to which (c) applies, gross income from the property excludes lease bonuses, advance royalties and other amounts payable without regard to production (section 613A(d)(5))";
}
@source(IRC_S613A_D, quote = "the term \"gross income from the property\" shall not include any lease bonus, advance royalty, or other amount payable without regard to production from property.")
rule GrossIncomeExcludesBonusesAndAdvanceRoyalties(p: Person, asset: Asset, y: TaxableYear, gross: Money, bonus: Money) defeasible {
    label en official "gross income less bonuses and advance royalties, floored at zero (section 613A(d)(5)); the figure is offered next to the asserted `gross_income_from_the_property`";
    when gross_income_from_the_property(p, asset, y, gross);
    when lease_bonus_advance_royalty_or_amount_payable_without_regard_to_production_613Ad5(p, asset, y, bonus);
    when is_independent_producer_or_royalty_owner(p, y);
    then gross_income_from_property_for_613Ac_613Ad5(p, asset, y, max(gross - bonus, 0 USD));
}
