// Section 475 — Mark to market accounting method for dealers in securities.
// Stage 2b (IRC-07). Scope: (a)(2) the core mark-to-market computation for a
// non-inventory security held by a dealer at year end (gain/loss = fair
// market value minus adjusted basis, recognized for the year); (c)(1)-(2)
// dealer-in-securities and security definitions (read as case facts); (e)
// the commodities-dealer election (POWER, no Secretary consent needed); (f)(1)
// the securities-trader election (POWER). `pub mark_to_market_gain` covers
// the (a)(2) dealer computation and the (e)/(f) elective extensions of it.
// NOT DONE (TECH-GAPS G327): (a)(1) inventory security valuation (an
// inventory-accounting integration this package's §471/§472 modules do not
// wire to this one); (c)(3)-(4) hedge/nonfinancial-customer-paper carve-outs;
// (d) coordination rules, improper-identification recapture, and the
// (d)(3)(B) dealer-activity exception to ordinary-character treatment; (f)(2)
// the commodities-trader election (structurally identical to (f)(1), not
// separately implemented); (f)(1)(B)-(D) the trader's own no-connection
// exception and section 1259 coordination.

use self::{
    Asset,
    IRC_S475_A,
    IRC_S475_E,
    IRC_S475_F,
    Person,
    TaxableYear,
};

pub relation is_dealer_in_securities(p: Person) kind empirical {
    label en official "the taxpayer regularly purchases securities from or sells securities to customers, or regularly offers to enter into/assume/offset/assign/terminate positions in securities with customers, in the ordinary course of a trade or business (section 475(c)(1))";
}
pub relation is_security_477(security: Asset) kind empirical {
    label en official "the asset is a security within the meaning of section 475(c)(2) (stock, partnership/trust interest, debt instrument, notional principal contract, derivative, or identified hedge position) — read as a case fact; the hedge-identification and nonfinancial-customer-paper carve-outs of (c)(3)-(4) are NOT modelled (TECH_GAP G327)";
}
pub relation security_is_inventory_of_dealer(p: Person, security: Asset) kind empirical {
    label en official "the security is inventory in the hands of the dealer (section 475(a)(1)) — inventory valuation itself is NOT wired to this package's §471/§472 modules (TECH_GAP G327)";
}
pub relation security_held_at_close_of_year(p: Person, security: Asset, y: TaxableYear) kind empirical {
    label en official "the security (not inventory in the dealer's hands) is held at the close of the taxable year (section 475(a)(2))";
}
pub relation security_fair_market_value_at_year_end(p: Person, security: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the security on the last business day of the taxable year (section 475(a)(2)(A))";
}
pub relation mark_to_market_applies(p: Person, security: Asset, y: TaxableYear) kind institutional {
    label en official "section 475(a) mark-to-market treatment applies to the security for the taxable year";
}
@source(IRC_S475_A, quote = "the following rules shall apply to securities held by a dealer in securities")
rule MarkToMarketAppliesDealer(p: Person, security: Asset, y: TaxableYear) strict {
    label en official "mark-to-market treatment applies to a non-inventory security held at year end by a dealer in securities (section 475(a)(2))";
    when is_dealer_in_securities(p);
    when is_security_477(security);
    when security_held_at_close_of_year(p, security, y) and not_known(security_is_inventory_of_dealer(p, security));
    then mark_to_market_applies(p, security, y);
}
pub relation mark_to_market_gain(p: Person, security: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "gain or loss recognized as if the security were sold for its fair market value on the last business day of the taxable year, treated as ordinary income or loss under section 475(d)(3)(A) (section 475(a)(2)). A negative amount is a loss.";
}
@source(IRC_S475_A, quote = "the dealer shall recognize gain or loss as if such security were sold for its fair market value on the last business day of such taxable year, and")
rule MarkToMarketGainComputation(p: Person, security: Asset, y: TaxableYear, fmv: Money, basis: Money, close_of_year: Date) strict {
    label en official "mark-to-market gain or loss is fair market value at year end minus adjusted basis (section 475(a)(2)(A), ordinary character under (d)(3)(A))";
    when mark_to_market_applies(p, security, y);
    when security_fair_market_value_at_year_end(p, security, y, fmv);
    when us.irc.core::ends(y, close_of_year);
    when us.irc.core::adjusted_basis(p, security, close_of_year, basis);
    then mark_to_market_gain(p, security, y, fmv - basis);
}

// (e): commodities-dealer election, self-executing (no Secretary consent
// needed to MAKE it; consent needed only to revoke, per (e)(3) second
// sentence — the revocation-consent power is NOT separately modelled,
// TECH_GAP G327).
pub relation is_dealer_in_commodities(p: Person) kind empirical {
    label en official "the taxpayer is a dealer in commodities (section 475(e)(1)) — read as a case fact";
}
pub relation elects_mark_to_market_for_commodities(p: Person, y: TaxableYear) kind empirical {
    label en official "the dealer in commodities elects the application of section 475(e) (section 475(e)(1), (e)(3))";
}
pub relation mark_to_market_elected_for_commodities(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 475(e) election is in effect: section 475 applies to commodities held by the dealer in the same manner as it applies to securities held by a dealer in securities";
}
@source(IRC_S475_E, quote = "In the case of a dealer in commodities who elects the application of this subsection, this section shall apply to commodities held by such dealer in the same manner as this section applies to securities held by a dealer in securities.")
rule Section475ECommoditiesDealerElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a dealer in commodities may elect, without the Secretary's consent, to have section 475 apply to its commodities (section 475(e)(1), (e)(3))";
    when is_dealer_in_commodities(p);
    when us.irc.core::year_of(p, y);
    then power Section475ECommoditiesDealerElection {
        holder p;
        over y;
        exercise elects_mark_to_market_for_commodities(p, y);
        valid_when is_dealer_in_commodities(p);
        effect create(mark_to_market_elected_for_commodities(p, y));
        window [@1993-12-24, infinity);
    };
}
pub relation commodity_held_at_close_of_year(p: Person, commodity: Asset, y: TaxableYear) kind empirical {
    label en official "the commodity (as defined in section 475(e)(2)) is held by the electing dealer at the close of the taxable year";
}
pub relation commodity_fair_market_value_at_year_end(p: Person, commodity: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the commodity on the last business day of the taxable year, under the section 475(e) election";
}
@source(IRC_S475_E, quote = "this section shall apply to commodities held by such dealer in the same manner as this section applies to securities held by a dealer in securities")
rule MarkToMarketGainCommoditiesDealer(p: Person, commodity: Asset, y: TaxableYear, fmv: Money, basis: Money, close_of_year: Date) strict {
    label en official "under a section 475(e) election, mark-to-market gain or loss on a commodity is fair market value at year end minus adjusted basis";
    when mark_to_market_elected_for_commodities(p, y);
    when commodity_held_at_close_of_year(p, commodity, y);
    when commodity_fair_market_value_at_year_end(p, commodity, y, fmv);
    when us.irc.core::ends(y, close_of_year);
    when us.irc.core::adjusted_basis(p, commodity, close_of_year, basis);
    then mark_to_market_gain(p, commodity, y, fmv - basis);
}

// (f)(1): trader-in-securities election, self-executing.
pub relation is_trader_in_securities(p: Person) kind empirical {
    label en official "the taxpayer is engaged in a trade or business as a trader in securities (section 475(f)(1)(A)) — read as a case fact";
}
pub relation elects_mark_to_market_as_trader(p: Person, y: TaxableYear) kind empirical {
    label en official "the trader in securities elects to have section 475(f)(1) apply to the trade or business (section 475(f)(1)(A), (f)(3))";
}
pub relation mark_to_market_elected_for_trader(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 475(f)(1) election is in effect for the trader's securities trade or business";
}
@source(IRC_S475_F, quote = "such person shall recognize gain or loss on any security held in connection with such trade or business at the close of any taxable year as if such security were sold for its fair market value on the last business day of such taxable year")
rule Section475FTraderElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a trader in securities may elect, without the Secretary's consent, to mark to market securities held in the trade or business (section 475(f)(1)(A), (f)(3))";
    when is_trader_in_securities(p);
    when us.irc.core::year_of(p, y);
    then power Section475FTraderElection {
        holder p;
        over y;
        exercise elects_mark_to_market_as_trader(p, y);
        valid_when is_trader_in_securities(p);
        effect create(mark_to_market_elected_for_trader(p, y));
        window [@1997-08-05, infinity);
    };
}
@source(IRC_S475_F, quote = "such person shall recognize gain or loss on any security held in connection with such trade or business at the close of any taxable year as if such security were sold for its fair market value on the last business day of such taxable year")
rule MarkToMarketGainElectingTrader(p: Person, security: Asset, y: TaxableYear, fmv: Money, basis: Money, close_of_year: Date) strict {
    label en official "under a section 475(f)(1) election, a trader's mark-to-market gain or loss on a security is fair market value at year end minus adjusted basis";
    when mark_to_market_elected_for_trader(p, y);
    when security_held_at_close_of_year(p, security, y);
    when security_fair_market_value_at_year_end(p, security, y, fmv);
    when us.irc.core::ends(y, close_of_year);
    when us.irc.core::adjusted_basis(p, security, close_of_year, basis);
    then mark_to_market_gain(p, security, y, fmv - basis);
}
