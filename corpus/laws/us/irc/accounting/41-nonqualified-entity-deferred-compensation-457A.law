// Section 457A (stage 3, DECISION-0379 with deontics): nonqualified deferred
// compensation of nonqualified entities: the entity, the plan, the substantial
// risk of forfeiture, the year of inclusion, and the additional 20-percent tax for
// amounts not determinable.
//
// Not modelled (TECH-GAPS G4800+): the interest of (c)(1)(B)(i) and (c)(2), which
// needs the underpayments that section 457A(c)(2) computes from the tax function
// over the years and daily compounding (a Decimal power the language does not
// have); the section 409A(d) plan definition (asserted); the regulations of
// (d)(1)(B) and (e).

// ===================== (b), (d)(2): nonqualified entity =====================

use self::{
    IRC_S457A_A,
    IRC_S457A_B,
    IRC_S457A_C,
    IRC_S457A_D,
    Person,
    TaxableYear,
};

pub relation is_foreign_corporation_457Ab1(e: Person) kind empirical {
    label en official "the entity is a foreign corporation (section 457A(b)(1))";
}
pub relation substantially_all_income_effectively_connected_with_us_business_457Ab1A(e: Person) kind empirical {
    label en official "substantially all of the corporation's income is effectively connected with the conduct of a trade or business in the United States (section 457A(b)(1)(A)); an adjudicated fact (DECISION-0194)";
}
pub relation substantially_all_income_subject_to_comprehensive_foreign_income_tax_457Ab1B(e: Person) kind empirical {
    label en official "substantially all of the corporation's income is subject to a comprehensive foreign income tax (section 457A(b)(1)(B)); an adjudicated fact (DECISION-0194)";
}
pub relation is_partnership_457Ab2(e: Person) kind empirical {
    label en official "the entity is a partnership (section 457A(b)(2))";
}
pub relation substantially_all_partnership_income_allocated_to_persons_other_than_untaxed_foreign_and_exempt_457Ab2(e: Person) kind empirical {
    label en official "substantially all of the partnership's income is allocated to persons other than (A) foreign persons whose income is not subject to a comprehensive foreign income tax and (B) organizations exempt from tax (section 457A(b)(2)); an adjudicated fact (DECISION-0194)";
}
pub relation nonqualified_entity_457Ab(e: Person) kind institutional {
    label en official "a nonqualified entity: a foreign corporation unless substantially all of its income is effectively connected or comprehensively taxed, or a partnership unless substantially all of its income goes to other persons (section 457A(b))";
}
@source(IRC_S457A_B, quote = "(1) any foreign corporation unless substantially all of its income is—")
rule NonqualifiedEntityForeignCorporation(e: Person) defeasible {
    label en official "a foreign corporation without the (A) or (B) income character (section 457A(b)(1))";
    when is_foreign_corporation_457Ab1(e);
    when not_known(substantially_all_income_effectively_connected_with_us_business_457Ab1A(e));
    when not_known(substantially_all_income_subject_to_comprehensive_foreign_income_tax_457Ab1B(e));
    then nonqualified_entity_457Ab(e);
}
@source(IRC_S457A_B, quote = "(2) any partnership unless substantially all of its income is allocated to persons other than—")
rule NonqualifiedEntityPartnership(e: Person) defeasible {
    label en official "a partnership whose income is not substantially all allocated to other persons (section 457A(b)(2))";
    when is_partnership_457Ab2(e);
    when not_known(substantially_all_partnership_income_allocated_to_persons_other_than_untaxed_foreign_and_exempt_457Ab2(e));
    then nonqualified_entity_457Ab(e);
}
pub relation person_eligible_for_comprehensive_income_tax_treaty_benefits_457Ad2A(person: Person, country: Text) kind empirical {
    label en official "the foreign person is eligible for the benefits of a comprehensive income tax treaty between the foreign country and the United States (section 457A(d)(2)(A))";
}
pub relation person_demonstrates_to_secretary_country_has_comprehensive_income_tax_457Ad2B(person: Person, country: Text) kind empirical {
    label en official "the person demonstrates to the satisfaction of the Secretary that the foreign country has a comprehensive income tax (section 457A(d)(2)(B)); an external determination of the Secretary";
}
pub relation comprehensive_foreign_income_tax_457Ad2(person: Person, country: Text) kind institutional {
    label en official "a comprehensive foreign income tax with respect to a foreign person: the income tax of a foreign country where the person has treaty benefits, or shows to the Secretary that the country has a comprehensive income tax (section 457A(d)(2))";
}
@source(IRC_S457A_D, quote = "(A) such person is eligible for the benefits of a comprehensive income tax treaty between such foreign country and the United States, or")
rule ComprehensiveForeignIncomeTaxByTreaty(person: Person, country: Text) strict {
    label en official "treaty benefits (section 457A(d)(2)(A))";
    when person_eligible_for_comprehensive_income_tax_treaty_benefits_457Ad2A(person, country);
    then comprehensive_foreign_income_tax_457Ad2(person, country);
}
@source(IRC_S457A_D, quote = "(B) such person demonstrates to the satisfaction of the Secretary that such foreign country has a comprehensive income tax.")
rule ComprehensiveForeignIncomeTaxByShowingToSecretary(person: Person, country: Text) strict {
    label en official "the Secretary's satisfaction (section 457A(d)(2)(B))";
    when person_demonstrates_to_secretary_country_has_comprehensive_income_tax_457Ad2B(person, country);
    then comprehensive_foreign_income_tax_457Ad2(person, country);
}

// ===================== (d)(3): nonqualified deferred compensation plan =====================

pub relation plan_is_nonqualified_deferred_compensation_plan_under_409Ad_457Ad3A(plan: Integer) kind empirical {
    label en official "the plan is a nonqualified deferred compensation plan within the meaning of section 409A(d) (section 457A(d)(3)(A)); the section 409A(d) definition is asserted";
}
pub relation plan_gives_right_to_compensation_based_on_appreciation_of_specified_equity_units_457Ad3A(plan: Integer) kind empirical {
    label en official "the plan provides a right to compensation based on the appreciation in value of a specified number of equity units of the service recipient (section 457A(d)(3)(A))";
}
pub relation nonqualified_deferred_compensation_plan_457Ad3A(plan: Integer) kind institutional {
    label en official "a nonqualified deferred compensation plan for section 457A: a section 409A(d) plan, or a plan giving a right to the appreciation of a specified number of equity units (section 457A(d)(3)(A))";
}
@source(IRC_S457A_D, quote = "The term \"nonqualified deferred compensation plan\" has the meaning given such term under section 409A(d), except that such term shall include any plan that provides a right to compensation based on the appreciation in value of a specified number of equity units of the service recipient.")
rule NonqualifiedDeferredCompensationPlanBySection409A(plan: Integer) strict {
    label en official "a section 409A(d) plan (section 457A(d)(3)(A))";
    when plan_is_nonqualified_deferred_compensation_plan_under_409Ad_457Ad3A(plan);
    then nonqualified_deferred_compensation_plan_457Ad3A(plan);
}
rule NonqualifiedDeferredCompensationPlanByEquityAppreciation(plan: Integer) strict {
    label en official "an equity unit appreciation right is a plan for section 457A (section 457A(d)(3)(A))";
    when plan_gives_right_to_compensation_based_on_appreciation_of_specified_equity_units_457Ad3A(plan);
    then nonqualified_deferred_compensation_plan_457Ad3A(plan);
}

// ===================== (d)(1): substantial risk of forfeiture =====================

pub relation rights_conditioned_on_future_substantial_services_by_any_individual_457Ad1A(plan: Integer, y: TaxableYear) kind empirical {
    label en official "the person's rights to the compensation are conditioned upon the future performance of substantial services by any individual, as of the taxable year (section 457A(d)(1)(A))";
}
pub relation compensation_determined_solely_by_gain_on_disposition_of_investment_asset_457Ad1B(plan: Integer) kind empirical {
    label en official "the compensation is determined solely by reference to the amount of gain recognized on the disposition of an investment asset (section 457A(d)(1)(B)(i))";
}
pub relation regulations_provide_investment_asset_gain_rule_457Ad1B(plan: Integer) kind empirical {
    label en official "to the extent provided in regulations prescribed by the Secretary (section 457A(d)(1)(B)(i)); the regulations are asserted";
}
pub relation asset_acquired_directly_by_investment_fund_457Ad1BiiI(asset: Integer) kind empirical {
    label en official "the single asset (other than an investment fund or similar entity) is acquired directly by an investment fund or similar entity (section 457A(d)(1)(B)(ii)(I))";
}
pub relation entity_and_related_persons_do_not_actively_manage_asset_457Ad1BiiII(asset: Integer) kind empirical {
    label en official "the investment fund or similar entity (and any person related to it) does not participate in the active management of the asset, or of the activities of the entity in which the asset is an interest (section 457A(d)(1)(B)(ii)(II)); an adjudicated fact";
}
pub relation substantially_all_disposition_gain_allocated_to_investors_457Ad1BiiIII(asset: Integer) kind empirical {
    label en official "substantially all of any gain on the disposition of the asset (other than the deferred compensation) is allocated to investors in the entity (section 457A(d)(1)(B)(ii)(III)); an adjudicated fact";
}
pub relation investment_asset_457Ad1Bii(asset: Integer) kind institutional {
    label en official "an investment asset: a single asset acquired directly by an investment fund or similar entity, not actively managed by it or related persons, whose disposition gain (other than the deferred compensation) goes substantially to investors (section 457A(d)(1)(B)(ii))";
}
@source(IRC_S457A_D, quote = "For purposes of clause (i), the term \"investment asset\" means any single asset (other than an investment fund or similar entity)—")
rule InvestmentAssetDefinition(asset: Integer) defeasible {
    label en official "all three (B)(ii) conditions (section 457A(d)(1)(B)(ii)(I)-(III))";
    when asset_acquired_directly_by_investment_fund_457Ad1BiiI(asset);
    when entity_and_related_persons_do_not_actively_manage_asset_457Ad1BiiII(asset);
    when substantially_all_disposition_gain_allocated_to_investors_457Ad1BiiIII(asset);
    then investment_asset_457Ad1Bii(asset);
}
pub relation compensation_based_on_gain_on_asset_457Ad1B(plan: Integer, asset: Integer) kind empirical {
    label en official "the compensation is determined solely by the gain recognized on the disposition of the asset";
}
pub relation disposition_of_investment_asset_occurs_on_457Ad1Bi(asset: Integer, d: Date) kind empirical {
    label en official "the date of the disposition of the investment asset";
}
pub relation investment_gain_compensation_risk_until_disposition_457Ad1Bi(plan: Integer, y: TaxableYear) kind institutional {
    label en official "compensation determined solely by the gain on an investment asset is treated as subject to a substantial risk of forfeiture until the disposition date, to the extent regulations provide (section 457A(d)(1)(B)(i)); the year's end is before the disposition date";
}
@source(IRC_S457A_D, quote = "such compensation shall be treated as subject to a substantial risk of forfeiture until the date of such disposition.")
rule InvestmentGainCompensationAtRiskUntilDisposition(plan: Integer, asset: Integer, y: TaxableYear, ends_on: Date, disposed_on: Date) defeasible {
    label en official "at risk while the year ends before the disposition (section 457A(d)(1)(B)(i)); the year that contains the disposition date ends the risk";
    when compensation_determined_solely_by_gain_on_disposition_of_investment_asset_457Ad1B(plan);
    when regulations_provide_investment_asset_gain_rule_457Ad1B(plan);
    when compensation_based_on_gain_on_asset_457Ad1B(plan, asset);
    when investment_asset_457Ad1Bii(asset);
    when disposition_of_investment_asset_occurs_on_457Ad1Bi(asset, disposed_on);
    when us.irc.core::ends(y, ends_on);
    when ends_on < disposed_on;
    then investment_gain_compensation_risk_until_disposition_457Ad1Bi(plan, y);
}
pub relation substantial_risk_of_forfeiture_457Ad1(plan: Integer, y: TaxableYear) kind institutional {
    label en official "the rights are subject to a substantial risk of forfeiture in the year: conditioned on the future performance of substantial services by any individual, or an investment-gain compensation before the disposition (section 457A(d)(1))";
}
@source(IRC_S457A_D, quote = "The rights of a person to compensation shall be treated as subject to a substantial risk of forfeiture only if such person's rights to such compensation are conditioned upon the future performance of substantial services by any individual.")
rule SubstantialRiskOfForfeitureBySubstantialServices(plan: Integer, y: TaxableYear) strict {
    label en official "conditioned on future substantial services (section 457A(d)(1)(A))";
    when rights_conditioned_on_future_substantial_services_by_any_individual_457Ad1A(plan, y);
    then substantial_risk_of_forfeiture_457Ad1(plan, y);
}
rule SubstantialRiskOfForfeitureByInvestmentGain(plan: Integer, y: TaxableYear) defeasible {
    label en official "investment asset gain compensation before the disposition (section 457A(d)(1)(B)(i))";
    when investment_gain_compensation_risk_until_disposition_457Ad1Bi(plan, y);
    then substantial_risk_of_forfeiture_457Ad1(plan, y);
}

// ===================== (a), (d)(3)(B), (d)(4): the year of inclusion =====================

pub relation plan_of_nonqualified_entity_457A(plan: Integer, recipient: Person) kind empirical {
    label en official "the plan is a plan of the entity as service recipient (section 457A(a))";
}
pub relation compensation_deferred_under_plan_457A(plan: Integer, amount: Money) kind empirical {
    label en official "the compensation deferred under the plan (section 457A(a))";
}
pub relation year_of_service_recipient_457A(plan: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is a year of the service recipient under the plan";
}
pub relation year_end_of_service_recipient_457Ad3B(plan: Integer, y: TaxableYear, end: Date) kind empirical {
    label en official "the last day of the service recipient's taxable year";
}
pub relation year_without_substantial_risk_of_forfeiture_457A(plan: Integer, y: TaxableYear) kind institutional {
    label en official "a taxable year in which the rights are not subject to a substantial risk of forfeiture (section 457A(a))";
}
rule YearWithoutSubstantialRiskOfForfeiture457A(plan: Integer, y: TaxableYear) defeasible {
    label en official "no forfeiture condition in the year";
    when year_of_service_recipient_457A(plan, y);
    when not_known(substantial_risk_of_forfeiture_457Ad1(plan, y));
    then year_without_substantial_risk_of_forfeiture_457A(plan, y);
}
pub relation earlier_year_without_substantial_risk_457A(plan: Integer, y: TaxableYear) kind institutional {
    label en official "an earlier year already had no substantial risk of forfeiture (bridge)";
}
rule EarlierYearWithoutSubstantialRisk457A(plan: Integer, y: TaxableYear, y0: TaxableYear, d0: Date, d: Date) defeasible {
    label en official "an earlier year by begin date";
    when year_without_substantial_risk_of_forfeiture_457A(plan, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d0 < d;
    then earlier_year_without_substantial_risk_457A(plan, y);
}
pub relation first_year_without_substantial_risk_of_forfeiture_457A(plan: Integer, y: TaxableYear) kind institutional {
    label en official "the first taxable year in which there is no substantial risk of forfeiture (section 457A(a))";
}
rule FirstYearWithoutSubstantialRiskOfForfeiture457A(plan: Integer, y: TaxableYear) defeasible {
    label en official "the earliest such year";
    when year_without_substantial_risk_of_forfeiture_457A(plan, y);
    when not_known(earlier_year_without_substantial_risk_457A(plan, y));
    then first_year_without_substantial_risk_of_forfeiture_457A(plan, y);
}
pub relation payment_received_on_457Ad3B(plan: Integer, d: Date) kind empirical {
    label en official "the service provider receives the payment of the compensation on the date (section 457A(d)(3)(B))";
}
pub relation compensation_treated_as_not_deferred_by_short_term_payment_457Ad3B(plan: Integer, y: TaxableYear) kind institutional {
    label en official "compensation is not treated as deferred if the service provider is paid not later than 12 months after the end of the service recipient's taxable year in which the right ceases to be subject to a substantial risk of forfeiture (section 457A(d)(3)(B))";
}
@source(IRC_S457A_D, quote = "Compensation shall not be treated as deferred for purposes of this section if the service provider receives payment of such compensation not later than 12 months after the end of the taxable year of the service recipient during which the right to the payment of such compensation is no longer subject to a substantial risk of forfeiture.")
rule ShortTermPaymentIsNotDeferral(plan: Integer, y: TaxableYear, ends_on: Date, paid_on: Date) defeasible {
    label en official "payment within 12 calendar months after the end of the vesting year (section 457A(d)(3)(B))";
    when first_year_without_substantial_risk_of_forfeiture_457A(plan, y);
    when year_end_of_service_recipient_457Ad3B(plan, y, ends_on);
    when payment_received_on_457Ad3B(plan, paid_on);
    when paid_on <= add_calendar_period(ends_on, 12 calendar_month);
    then compensation_treated_as_not_deferred_by_short_term_payment_457Ad3B(plan, y);
}
pub relation foreign_corporation_with_income_taxable_under_section_882_457Ad4(e: Person) kind empirical {
    label en official "the foreign corporation has income taxable under section 882 (section 457A(d)(4))";
}
pub relation compensation_would_be_deductible_against_882_income_if_paid_in_cash_457Ad4(plan: Integer) kind empirical {
    label en official "had the compensation been paid in cash on the date it ceased to be subject to a substantial risk of forfeiture it would have been deductible by the foreign corporation against its section 882 income (section 457A(d)(4))";
}
pub relation section_457A_not_applicable_by_882_deduction_457Ad4(plan: Integer) kind institutional {
    label en official "section 457A does not apply to compensation deductible against section 882 income of the foreign corporation (section 457A(d)(4))";
}
@source(IRC_S457A_D, quote = "In the case of a foreign corporation with income which is taxable under section 882, this section shall not apply to compensation which, had such compensation been paid in cash on the date that such compensation ceased to be subject to a substantial risk of forfeiture, would have been deductible by such foreign corporation against such income.")
rule Section882DeductibleCompensationOutside457A(plan: Integer, e: Person) defeasible {
    label en official "compensation deductible against section 882 income is outside section 457A (section 457A(d)(4))";
    when plan_of_nonqualified_entity_457A(plan, e);
    when foreign_corporation_with_income_taxable_under_section_882_457Ad4(e);
    when compensation_would_be_deductible_against_882_income_if_paid_in_cash_457Ad4(plan);
    then section_457A_not_applicable_by_882_deduction_457Ad4(plan);
}
pub relation compensation_includible_under_457Aa(plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "compensation deferred under a nonqualified deferred compensation plan of a nonqualified entity is includible in gross income in the first year in which there is no substantial risk of forfeiture (section 457A(a))";
}
@source(IRC_S457A_A, quote = "Any compensation which is deferred under a nonqualified deferred compensation plan of a nonqualified entity shall be includible in gross income when there is no substantial risk of forfeiture of the rights to such compensation.")
rule Section457AInclusionWhenNoSubstantialRiskOfForfeiture(plan: Integer, e: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "inclusion in the vesting year, unless the compensation is not deferred (12-month rule) or is outside by the section 882 rule (section 457A(a), (d)(3)(B), (d)(4))";
    when plan_of_nonqualified_entity_457A(plan, e);
    when nonqualified_entity_457Ab(e);
    when nonqualified_deferred_compensation_plan_457Ad3A(plan);
    when compensation_deferred_under_plan_457A(plan, amount);
    when first_year_without_substantial_risk_of_forfeiture_457A(plan, y);
    when not_known(compensation_treated_as_not_deferred_by_short_term_payment_457Ad3B(plan, y));
    when not_known(section_457A_not_applicable_by_882_deduction_457Ad4(plan));
    then compensation_includible_under_457Aa(plan, y, amount);
}

// ===================== (c): amounts not determinable =====================

pub relation compensation_amount_not_determinable_when_otherwise_includible_457Ac1(plan: Integer) kind empirical {
    label en official "the amount of the compensation is not determinable at the time it is otherwise includible under (a) (section 457A(c)(1))";
}
pub relation year_in_which_amount_becomes_determinable_457Ac1A(plan: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable year in which the compensation becomes determinable, and its amount (section 457A(c)(1)(A))";
}
pub relation compensation_includible_when_determinable_457Ac1A(plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "an amount not determinable at the time it is otherwise includible is includible when determinable (section 457A(c)(1)(A))";
}
@source(IRC_S457A_C, quote = "(A) such amount shall be so includible in gross income when determinable, and")
rule NondeterminableCompensationIncludibleWhenDeterminable(plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "inclusion moves to the year the amount is determinable (section 457A(c)(1)(A))";
    when compensation_amount_not_determinable_when_otherwise_includible_457Ac1(plan);
    when year_in_which_amount_becomes_determinable_457Ac1A(plan, y, amount);
    then compensation_includible_when_determinable_457Ac1A(plan, y, amount);
}
pub relation additional_tax_of_twenty_percent_457Ac1Bii(plan: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax for the year of inclusion is increased by 20 percent of the compensation, one rounding to cents HALF_UP (JUDGMENT CALL) (section 457A(c)(1)(B)(ii))";
}
@source(IRC_S457A_C, quote = "(ii) an amount equal to 20 percent of the amount of such compensation.")
rule AdditionalTaxTwentyPercentOfCompensation(plan: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "20 percent of the compensation (section 457A(c)(1)(B)(ii))";
    when compensation_includible_when_determinable_457Ac1A(plan, y, amount);
    then additional_tax_of_twenty_percent_457Ac1Bii(plan, y, round(amount * 20 percent, 2, "HALF_UP"));
}
pub relation underpayment_rate_under_section_6621_457Ac2(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the underpayment rate under section 6621 for the interest computation; the section 6621(a)(2) rate is a pending dependency on the payment-refunds-interest owner (no IRB value pinned)";
}
pub relation interest_rate_of_underpayment_plus_one_point_457Ac2(y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the interest rate: the section 6621 underpayment rate plus 1 percentage point (section 457A(c)(2)); the underpayments to which it applies are not computed";
}
@source(IRC_S457A_C, quote = "the interest determined under this paragraph for any taxable year is the amount of interest at the underpayment rate under section 6621 plus 1 percentage point")
rule InterestRateIsUnderpaymentRatePlusOnePoint(y: TaxableYear, base: Decimal) defeasible {
    label en official "underpayment rate + 0.01 (section 457A(c)(2))";
    when underpayment_rate_under_section_6621_457Ac2(y, base);
    then interest_rate_of_underpayment_plus_one_point_457Ac2(y, base + 0.01);
}
