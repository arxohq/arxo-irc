// Section 475 residual (stage 3, DECISION-0379 with deontics): the derived
// definitions of dealer, security, hedge, and nonfinancial customer paper
// ((c)(1)-(4)); the inventory and proper-adjustment rules of (a); the
// exceptions of (b) with the identification requirement; the coordination,
// improper identification and character rules of (d); the commodity
// definition of (e)(2); the trader exception and coordination of (f)(1)(B)-(D);
// and the commodities-trader election of (f)(2).
//
// The stage 2b relations `is_dealer_in_securities` and `is_security_477` stay
// as asserted facts on their legacy paths; sibling rules read the derived
// definitions.
//
// Not modelled (TECH-GAPS G4800+): the regulations of (a), (b)(1) last
// sentence, (b)(2), (b)(4), (c)(2)(F)(iii), (f)(1)(A) and (g); section 1259;
// the wash sale rule of section 1091 and the straddle rules of section 1092
// beyond stating which applies.

// ===================== (c): definitions =====================

use self::{
    Asset,
    IRC_S475_A,
    IRC_S475_B,
    IRC_S475_C,
    IRC_S475_D,
    IRC_S475_E,
    IRC_S475_F,
    Person,
    TaxableYear,
    commodity_fair_market_value_at_year_end,
    commodity_held_at_close_of_year,
    mark_to_market_elected_for_trader,
    security_fair_market_value_at_year_end,
    security_held_at_close_of_year,
};

pub relation regularly_purchases_or_sells_securities_with_customers_475c1A(p: Person) kind empirical {
    label en official "the taxpayer regularly purchases securities from or sells securities to customers in the ordinary course of a trade or business (section 475(c)(1)(A)); 'regularly' is an adjudicated fact (DECISION-0194)";
}
pub relation regularly_offers_to_enter_into_or_terminate_positions_with_customers_475c1B(p: Person) kind empirical {
    label en official "the taxpayer regularly offers to enter into, assume, offset, assign, or otherwise terminate positions in securities with customers in the ordinary course of a trade or business (section 475(c)(1)(B)); 'regularly' is an adjudicated fact (DECISION-0194)";
}
pub relation dealer_in_securities_475c1(p: Person) kind institutional {
    label en official "a dealer in securities: a taxpayer who regularly buys securities from or sells them to customers, or regularly offers to enter into or terminate positions in securities with customers (section 475(c)(1))";
}
@source(IRC_S475_C, quote = "(A) regularly purchases securities from or sells securities to customers in the ordinary course of a trade or business; or")
rule DealerByPurchasesAndSales(p: Person) defeasible {
    label en official "regular purchases from or sales to customers (section 475(c)(1)(A))";
    when regularly_purchases_or_sells_securities_with_customers_475c1A(p);
    then dealer_in_securities_475c1(p);
}
@source(IRC_S475_C, quote = "(B) regularly offers to enter into, assume, offset, assign or otherwise terminate positions in securities with customers in the ordinary course of a trade or business.")
rule DealerByOfferingPositions(p: Person) defeasible {
    label en official "regular offers to enter into or terminate positions with customers (section 475(c)(1)(B))";
    when regularly_offers_to_enter_into_or_terminate_positions_with_customers_475c1B(p);
    then dealer_in_securities_475c1(p);
}
pub relation security_is_stock_475c2A(security: Asset) kind empirical {
    label en official "the asset is a share of stock in a corporation (section 475(c)(2)(A))";
}
pub relation security_is_interest_in_widely_held_or_publicly_traded_partnership_or_trust_475c2B(security: Asset) kind empirical {
    label en official "the asset is a partnership or beneficial ownership interest in a widely held or publicly traded partnership or trust (section 475(c)(2)(B))";
}
pub relation security_is_debt_instrument_475c2C(security: Asset) kind empirical {
    label en official "the asset is a note, bond, debenture, or other evidence of indebtedness (section 475(c)(2)(C))";
}
pub relation security_is_notional_principal_contract_475c2D(security: Asset) kind empirical {
    label en official "the asset is an interest rate, currency, or equity notional principal contract (section 475(c)(2)(D))";
}
pub relation security_is_derivative_of_a_security_or_currency_475c2E(security: Asset) kind empirical {
    label en official "the asset is an evidence of an interest in, or a derivative financial instrument in, a security described in (A)-(D) or a currency, including an option, forward contract, short position, or similar instrument (section 475(c)(2)(E))";
}
pub relation contract_to_which_section_1256a_applies_475c2E(security: Asset) kind empirical {
    label en official "the instrument is a contract to which section 1256(a) applies (section 475(c)(2), last sentence)";
}
pub relation position_is_hedge_of_a_security_475c2F(security: Asset) kind empirical {
    label en official "the position is not a security described in (A)-(E) and is a hedge with respect to such a security (section 475(c)(2)(F)(i)-(ii))";
}
pub relation position_identified_in_dealers_records_before_close_of_day_475c2Fiii(security: Asset) kind empirical {
    label en official "the position is clearly identified in the dealer's records as described in (F) before the close of the day on which it was acquired or entered into (or such other time as the Secretary prescribes) (section 475(c)(2)(F)(iii))";
}
pub relation security_475c2(security: Asset) kind institutional {
    label en official "a security for section 475: stock, widely held or public partnership or trust interest, non-customer-paper debt, notional principal contract, derivative (other than a section 1256(a) contract), or an identified hedge position (section 475(c)(2))";
}
@source(IRC_S475_C, quote = "(A) share of stock in a corporation;")
rule SecurityStock(security: Asset) strict {
    label en official "stock is a security (section 475(c)(2)(A))";
    when security_is_stock_475c2A(security);
    then security_475c2(security);
}
@source(IRC_S475_C, quote = "(B) partnership or beneficial ownership interest in a widely held or publicly traded partnership or trust;")
rule SecurityPartnershipOrTrustInterest(security: Asset) strict {
    label en official "an interest in a widely held or publicly traded partnership or trust is a security (section 475(c)(2)(B))";
    when security_is_interest_in_widely_held_or_publicly_traded_partnership_or_trust_475c2B(security);
    then security_475c2(security);
}
@source(IRC_S475_C, quote = "(C) note, bond, debenture, or other evidence of indebtedness;")
rule SecurityDebtInstrumentOtherThanCustomerPaper(security: Asset) defeasible {
    label en official "debt is a security unless it is nonfinancial customer paper (section 475(c)(2)(C), (4)(A))";
    when security_is_debt_instrument_475c2C(security);
    when not_known(nonfinancial_customer_paper_475c4B(security));
    then security_475c2(security);
}
@source(IRC_S475_C, quote = "(D) interest rate, currency, or equity notional principal contract;")
rule SecurityNotionalPrincipalContract(security: Asset) strict {
    label en official "a notional principal contract is a security (section 475(c)(2)(D))";
    when security_is_notional_principal_contract_475c2D(security);
    then security_475c2(security);
}
@source(IRC_S475_C, quote = "Subparagraph (E) shall not include any contract to which section 1256(a) applies.")
rule SecurityDerivativeOtherThanSection1256Contract(security: Asset) strict {
    label en official "a derivative is a security unless it is a section 1256(a) contract (section 475(c)(2)(E))";
    when security_is_derivative_of_a_security_or_currency_475c2E(security);
    when not_known(contract_to_which_section_1256a_applies_475c2E(security));
    then security_475c2(security);
}
@source(IRC_S475_C, quote = "(iii) is clearly identified in the dealer's records as being described in this subparagraph before the close of the day on which it was acquired or entered into")
rule SecurityIdentifiedHedgePosition(security: Asset) strict {
    label en official "an identified hedge position is a security (section 475(c)(2)(F))";
    when position_is_hedge_of_a_security_475c2F(security);
    when position_identified_in_dealers_records_before_close_of_day_475c2Fiii(security);
    then security_475c2(security);
}
pub relation manages_risk_of_interest_rate_price_or_currency_475c3(position: Asset) kind empirical {
    label en official "the position manages the dealer's risk of interest rate or price changes or currency fluctuations (section 475(c)(3))";
}
pub relation days_until_position_expected_to_become_a_hedge_475c3(position: Asset, days: Integer) kind empirical {
    label en official "the number of days after acquisition within which the position is reasonably expected to become a hedge (section 475(c)(3)); 'reasonably expected' is an adjudicated fact";
}
pub relation hedge_475c3(position: Asset) kind institutional {
    label en official "a hedge: a position that manages the dealer's risk of interest rate, price, or currency changes, including a position reasonably expected to become a hedge within 60 days after acquisition (section 475(c)(3))";
}
@source(IRC_S475_C, quote = "The term \"hedge\" means any position which manages the dealer's risk of interest rate or price changes or currency fluctuations")
rule HedgeManagesRisk(position: Asset) strict {
    label en official "a risk-managing position is a hedge (section 475(c)(3))";
    when manages_risk_of_interest_rate_price_or_currency_475c3(position);
    then hedge_475c3(position);
}
@source(IRC_S475_C, quote = "including any position which is reasonably expected to become a hedge within 60 days after the acquisition of the position.")
rule HedgeExpectedWithinSixtyDays(position: Asset, days: Integer) strict {
    label en official "a position expected to become a hedge within 60 days is a hedge (section 475(c)(3))";
    when days_until_position_expected_to_become_a_hedge_475c3(position, days);
    when days <= 60;
    then hedge_475c3(position);
}
pub relation receivable_is_debt_instrument_475c4Bi(security: Asset) kind empirical {
    label en official "the receivable is a note, bond, debenture, or other evidence of indebtedness (section 475(c)(4)(B)(i))";
}
pub relation receivable_arises_from_sale_of_nonfinancial_goods_or_services_475c4Bii(security: Asset) kind empirical {
    label en official "the receivable arises out of the sale of nonfinancial goods or services by a person whose principal activity is selling or providing nonfinancial goods or services (section 475(c)(4)(B)(ii)); the 'principal activity' test is an adjudicated fact (DECISION-0194)";
}
pub relation receivable_held_by_such_person_or_related_person_since_issue_475c4Biii(security: Asset) kind empirical {
    label en official "the receivable is held by such person, or by a person related to it as described in section 267(b) or 707(b), at all times since issue (section 475(c)(4)(B)(iii)); the relationship is asserted";
}
pub relation nonfinancial_customer_paper_475c4B(security: Asset) kind institutional {
    label en official "nonfinancial customer paper: a debt receivable of a nonfinancial seller, held by that seller or a related person at all times since issue (section 475(c)(4)(B))";
}
@source(IRC_S475_C, quote = "(iii) is held by such person (or a person who bears a relationship to such person described in section 267(b) or 707(b)) at all times since issue.")
rule NonfinancialCustomerPaperDefinition(security: Asset) defeasible {
    label en official "all three (B) conditions (section 475(c)(4)(B)(i)-(iii))";
    when receivable_is_debt_instrument_475c4Bi(security);
    when receivable_arises_from_sale_of_nonfinancial_goods_or_services_475c4Bii(security);
    when receivable_held_by_such_person_or_related_person_since_issue_475c4Biii(security);
    then nonfinancial_customer_paper_475c4B(security);
}

// ===================== (a): inventory valuation and proper adjustment =====================

pub relation dealer_holds_security_as_inventory_475a1(p: Person, security: Asset) kind empirical {
    label en official "the security is inventory in the hands of the dealer (section 475(a)(1))";
}
pub relation security_fair_market_value_for_inventory_475a1(p: Person, security: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the inventory security at the valuation date (section 475(a)(1))";
}
pub relation security_inventory_value_475a1(p: Person, security: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "a security that is inventory in the hands of a dealer is included in inventory at its fair market value (section 475(a)(1)); the link to the section 471 inventory relations is not wired";
}
@source(IRC_S475_A, quote = "Any security which is inventory in the hands of the dealer shall be included in inventory at its fair market value.")
rule InventorySecurityIncludedAtFairMarketValue(p: Person, security: Asset, y: TaxableYear, fmv: Money) defeasible {
    label en official "inventory value of a dealer's inventory security is its fair market value (section 475(a)(1))";
    when dealer_in_securities_475c1(p);
    when security_475c2(security);
    when dealer_holds_security_as_inventory_475a1(p, security);
    when security_fair_market_value_for_inventory_475a1(p, security, y, fmv);
    then security_inventory_value_475a1(p, security, y, fmv);
}
pub relation mark_to_market_applies_derived_dealer_475a2(p: Person, security: Asset, y: TaxableYear) kind institutional {
    label en official "section 475(a)(2) applies to a non-inventory security held at year end by a derived dealer, unless an exception of (b) applies (section 475(a)(2), (b))";
}
rule MarkToMarketAppliesToDerivedDealerSecurity(p: Person, security: Asset, y: TaxableYear) defeasible {
    label en official "a derived dealer marks a derived security held at year end that is not inventory and not excepted (section 475(a)(2), (b)(1))";
    when dealer_in_securities_475c1(p);
    when security_475c2(security);
    when security_held_at_close_of_year(p, security, y);
    when not_known(dealer_holds_security_as_inventory_475a1(p, security));
    when not_known(security_excepted_from_mark_to_market_475b(security));
    then mark_to_market_applies_derived_dealer_475a2(p, security, y);
}
pub relation mark_to_market_gain_derived_dealer_475a2(p: Person, security: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "gain or loss recognized as if the security were sold at fair market value on the last business day, for a derived dealer (section 475(a)(2)(A)-(B))";
}
rule MarkToMarketGainForDerivedDealer(p: Person, security: Asset, y: TaxableYear, fmv: Money, basis: Money, close_of_year: Date) defeasible {
    label en official "fair market value at year end minus adjusted basis, taken into account for the year (section 475(a)(2)(A)-(B))";
    when mark_to_market_applies_derived_dealer_475a2(p, security, y);
    when security_fair_market_value_at_year_end(p, security, y, fmv);
    when us.irc.core::ends(y, close_of_year);
    when us.irc.core::adjusted_basis(p, security, close_of_year, basis);
    then mark_to_market_gain_derived_dealer_475a2(p, security, y, fmv - basis);
}
pub relation gain_or_loss_realized_on_disposition_475a(p: Person, security: Asset, amount: Money) kind empirical {
    label en official "the gain or loss realized on the later disposition of the security, before the proper adjustment (section 475(a), last paragraph)";
}
pub relation gain_or_loss_previously_marked_to_market_475a(p: Person, security: Asset, amount: Money) kind empirical {
    label en official "the total of the mark-to-market gain or loss taken into account for the security in earlier years (section 475(a), last paragraph); the year chain is asserted (TECH-GAPS G2108)";
}
pub relation subsequently_realized_gain_or_loss_after_adjustment_475a(p: Person, security: Asset, amount: Money) kind institutional {
    label en official "proper adjustment: the gain or loss subsequently realized less the gain or loss already taken into account (section 475(a), last paragraph)";
}
@source(IRC_S475_A, quote = "Proper adjustment shall be made in the amount of any gain or loss subsequently realized for gain or loss taken into account under the preceding sentence.")
rule ProperAdjustmentOfSubsequentlyRealizedGainOrLoss(p: Person, security: Asset, realized: Money, marked: Money) defeasible {
    label en official "realized gain or loss minus the marked gain or loss (section 475(a))";
    when gain_or_loss_realized_on_disposition_475a(p, security, realized);
    when gain_or_loss_previously_marked_to_market_475a(p, security, marked);
    then subsequently_realized_gain_or_loss_after_adjustment_475a(p, security, realized - marked);
}

// ===================== (b): exceptions and identification =====================

pub relation security_held_for_investment_475b1A(security: Asset) kind empirical {
    label en official "the security is held for investment (section 475(b)(1)(A)); 'held for investment' is an adjudicated fact";
}
pub relation debt_security_acquired_in_ordinary_course_and_not_held_for_sale_475b1Bi(security: Asset) kind empirical {
    label en official "a debt security described in (c)(2)(C) acquired (including originated) in the ordinary course of a trade or business and not held for sale (section 475(b)(1)(B)(i))";
}
pub relation obligation_to_acquire_such_security_not_held_for_sale_475b1Bii(security: Asset) kind empirical {
    label en official "an obligation to acquire a security of clause (i), entered into in the ordinary course and not held for sale (section 475(b)(1)(B)(ii))";
}
pub relation security_hedges_a_security_outside_475a_or_a_non_security_position_475b1C(security: Asset) kind empirical {
    label en official "the security is a hedge with respect to a security to which (a) does not apply, or a position, right to income, or liability that is not a security in the taxpayer's hands (section 475(b)(1)(C)(i)-(ii))";
}
pub relation security_identified_in_records_before_close_of_day_475b2(security: Asset) kind empirical {
    label en official "the security is clearly identified in the dealer's records as described in (A), (B), or (C) before the close of the day on which it was acquired, originated, or entered into (or such other time as the Secretary prescribes) (section 475(b)(2))";
}
pub relation security_described_in_475b1(security: Asset) kind institutional {
    label en official "the security is described in (A), (B), or (C) of paragraph (1) as a matter of fact, whether or not identified (bridge for (d)(2))";
}
rule SecurityDescribedByInvestmentHolding(security: Asset) defeasible {
    label en official "held for investment (section 475(b)(1)(A))";
    when security_held_for_investment_475b1A(security);
    then security_described_in_475b1(security);
}
rule SecurityDescribedByOrdinaryCourseDebt(security: Asset) defeasible {
    label en official "a debt security acquired in the ordinary course and not held for sale (section 475(b)(1)(B)(i))";
    when debt_security_acquired_in_ordinary_course_and_not_held_for_sale_475b1Bi(security);
    then security_described_in_475b1(security);
}
rule SecurityDescribedByObligationToAcquire(security: Asset) defeasible {
    label en official "an obligation to acquire such a security (section 475(b)(1)(B)(ii))";
    when obligation_to_acquire_such_security_not_held_for_sale_475b1Bii(security);
    then security_described_in_475b1(security);
}
rule SecurityDescribedByHedgeOfExcludedPosition(security: Asset) defeasible {
    label en official "a hedge of an excluded security or a non-security position (section 475(b)(1)(C))";
    when security_hedges_a_security_outside_475a_or_a_non_security_position_475b1C(security);
    then security_described_in_475b1(security);
}
pub relation security_excepted_from_mark_to_market_475b(security: Asset) kind institutional {
    label en official "the security is excepted from section 475(a): it is described in (b)(1) and was identified as such in time (section 475(b)(1)-(2))";
}
@source(IRC_S475_B, quote = "A security shall not be treated as described in subparagraph (A), (B), or (C) of paragraph (1), as the case may be, unless such security is clearly identified in the dealer's records as being described in such subparagraph before the close of the day on which it was acquired, originated, or entered into")
rule SecurityExceptedWhenDescribedAndIdentified(security: Asset) defeasible {
    label en official "described in (b)(1) and identified in time (section 475(b)(2)); the regulatory extension of the time is not modelled";
    when security_described_in_475b1(security);
    when security_identified_in_records_before_close_of_day_475b2(security);
    then security_excepted_from_mark_to_market_475b(security);
}
pub relation security_ceases_to_be_described_in_475b1_on(security: Asset, d: Date) kind empirical {
    label en official "the security ceases to be described in paragraph (1) on the date, after being identified (section 475(b)(3))";
}
pub relation changes_in_value_after_cessation_subject_to_475a(security: Asset, ceased_on: Date) kind institutional {
    label en official "section 475(a) applies to changes in value of the security occurring after the cessation (section 475(b)(3))";
}
@source(IRC_S475_B, quote = "subsection (a) shall apply to any changes in value of the security occurring after the cessation.")
rule ChangesInValueAfterCessationSubjectToMarkToMarket(security: Asset, ceased_on: Date) defeasible {
    label en official "after an identified security stops being excepted, later changes in value are marked (section 475(b)(3))";
    when security_identified_in_records_before_close_of_day_475b2(security);
    when security_ceases_to_be_described_in_475b1_on(security, ceased_on);
    then changes_in_value_after_cessation_subject_to_475a(security, ceased_on);
}

// ===================== (d): coordination, improper identification, character =====================

pub relation rules_of_263g_263A_1256a_inapplicable_475d1(p: Person, security: Asset, y: TaxableYear) kind institutional {
    label en official "the rules of sections 263(g), 263A and 1256(a) do not apply to securities to which subsection (a) applies (section 475(d)(1))";
}
@source(IRC_S475_D, quote = "The rules of sections 263(g), 263A, and 1256(a) shall not apply to securities to which subsection (a) applies")
rule Rules263g263A1256aDoNotApplyToMarkedSecurities(p: Person, security: Asset, y: TaxableYear) defeasible {
    label en official "coordination with sections 263(g), 263A and 1256(a) (section 475(d)(1))";
    when mark_to_market_applies_derived_dealer_475a2(p, security, y);
    then rules_of_263g_263A_1256a_inapplicable_475d1(p, security, y);
}
pub relation section_1091_inapplicable_and_1092_applies_to_marked_loss_475d1(p: Person, security: Asset, y: TaxableYear) kind institutional {
    label en official "section 1091 does not apply, and section 1092 applies, to a loss recognized under subsection (a) (section 475(d)(1))";
}
@source(IRC_S475_D, quote = "and section 1091 shall not apply (and section 1092 shall apply) to any loss recognized under subsection (a).")
rule Section1091NotAppliedSection1092AppliesToMarkedLoss(p: Person, security: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "a marked loss is outside the wash sale rule and inside the straddle rule (section 475(d)(1))";
    when mark_to_market_gain_derived_dealer_475a2(p, security, y, amount);
    when amount < 0.00 USD;
    then section_1091_inapplicable_and_1092_applies_to_marked_loss_475d1(p, security, y);
}
pub relation security_identified_as_excepted_but_not_described_475d2A(security: Asset) kind institutional {
    label en official "the taxpayer identified the security under (b)(2) as described in (b)(1) and it is not so described (section 475(d)(2)(A))";
}
rule IdentifiedButNotDescribed(security: Asset) defeasible {
    label en official "identification without the described status is an improper identification (section 475(d)(2)(A))";
    when security_identified_in_records_before_close_of_day_475b2(security);
    when not_known(security_described_in_475b1(security));
    then security_identified_as_excepted_but_not_described_475d2A(security);
}
pub relation hedge_position_not_identified_in_time_475d2B(security: Asset) kind institutional {
    label en official "the taxpayer failed to identify a position described in (c)(2)(F) (without regard to clause (iii)) when required (section 475(d)(2)(B))";
}
rule HedgePositionNotIdentifiedInTime(security: Asset) defeasible {
    label en official "an (F) position not identified in time is improperly identified (section 475(d)(2)(B))";
    when position_is_hedge_of_a_security_475c2F(security);
    when not_known(position_identified_in_dealers_records_before_close_of_day_475c2Fiii(security));
    then hedge_position_not_identified_in_time_475d2B(security);
}
pub relation improperly_identified_security_475d2(security: Asset) kind institutional {
    label en official "the security or position is improperly identified, so subsection (a) applies to it (section 475(d)(2))";
}
rule ImproperIdentificationOfExceptedSecurity(security: Asset) defeasible {
    label en official "(a) applies to a security identified as excepted that is not (section 475(d)(2)(A))";
    when security_identified_as_excepted_but_not_described_475d2A(security);
    then improperly_identified_security_475d2(security);
}
rule ImproperIdentificationOfHedgePosition(security: Asset) defeasible {
    label en official "(a) applies to an unidentified (F) position (section 475(d)(2)(B))";
    when hedge_position_not_identified_in_time_475d2B(security);
    then improperly_identified_security_475d2(security);
}
pub relation gain_previously_recognized_not_yet_taken_into_account_475d2(security: Asset, amount: Money) kind empirical {
    label en official "the gain previously recognized under section 475 with respect to the security or position and not previously taken into account under paragraph (2) (section 475(d)(2))";
}
pub relation marked_loss_before_disposition_475d2(security: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the loss under section 475 before disposition of the improperly identified security or position (a positive figure) (section 475(d)(2))";
}
pub relation improper_identification_loss_recognized_475d2(security: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the loss before disposition is recognized only to the extent of previously recognized gain not yet taken into account (section 475(d)(2))";
}
@source(IRC_S475_D, quote = "except that any loss under this section prior to the disposition of the security or position shall be recognized only to the extent of gain previously recognized under this section")
rule ImproperIdentificationLossLimitedToPriorGain(security: Asset, y: TaxableYear, loss: Money, gain: Money) defeasible {
    label en official "recognized loss = min(loss, prior gain) (section 475(d)(2))";
    when improperly_identified_security_475d2(security);
    when marked_loss_before_disposition_475d2(security, y, loss);
    when gain_previously_recognized_not_yet_taken_into_account_475d2(security, gain);
    then improper_identification_loss_recognized_475d2(security, y, min(loss, gain));
}
pub relation gain_or_loss_allocable_to_hedge_period_475d3Bi(p: Person, security: Asset, y: TaxableYear) kind empirical {
    label en official "the gain or loss is allocable to a period during which the security is described in (b)(1)(C), without regard to (b)(2) (section 475(d)(3)(B)(i))";
}
pub relation gain_or_loss_allocable_to_period_held_outside_dealer_activity_475d3Bii(p: Person, security: Asset, y: TaxableYear) kind empirical {
    label en official "the gain or loss is allocable to a period during which the security is held other than in connection with the activities as a dealer in securities (section 475(d)(3)(B)(ii))";
}
pub relation gain_or_loss_allocable_to_period_of_improper_identification_475d3Biii(p: Person, security: Asset, y: TaxableYear) kind empirical {
    label en official "the gain or loss is allocable to a period during which the security is improperly identified (section 475(d)(3)(B)(iii))";
}
pub relation character_exception_475d3B(p: Person, security: Asset, y: TaxableYear) kind institutional {
    label en official "a character exception of (d)(3)(B) applies to the gain or loss";
}
rule CharacterExceptionForHedgePeriod(p: Person, security: Asset, y: TaxableYear) defeasible {
    label en official "(d)(3)(B)(i)";
    when gain_or_loss_allocable_to_hedge_period_475d3Bi(p, security, y);
    then character_exception_475d3B(p, security, y);
}
rule CharacterExceptionForNonDealerHolding(p: Person, security: Asset, y: TaxableYear) defeasible {
    label en official "(d)(3)(B)(ii)";
    when gain_or_loss_allocable_to_period_held_outside_dealer_activity_475d3Bii(p, security, y);
    then character_exception_475d3B(p, security, y);
}
rule CharacterExceptionForImproperIdentification(p: Person, security: Asset, y: TaxableYear) defeasible {
    label en official "(d)(3)(B)(iii)";
    when gain_or_loss_allocable_to_period_of_improper_identification_475d3Biii(p, security, y);
    then character_exception_475d3B(p, security, y);
}
pub relation marked_gain_or_loss_is_ordinary_475d3A(p: Person, security: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "a mark-to-market gain or loss is ordinary income or loss, except in the (B) periods and as section 1236(b) provides (section 475(d)(3)(A)(i))";
}
@source(IRC_S475_D, quote = "Any gain or loss with respect to a security under subsection (a)(2) shall be treated as ordinary income or loss.")
rule MarkedGainOrLossIsOrdinary(p: Person, security: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "ordinary character (section 475(d)(3)(A)(i)); the section 1236(b) carve-out is not modelled";
    when mark_to_market_gain_derived_dealer_475a2(p, security, y, amount);
    when not_known(character_exception_475d3B(p, security, y));
    then marked_gain_or_loss_is_ordinary_475d3A(p, security, y, amount);
}
pub relation gain_or_loss_recognized_before_year_end_475d3Aii(p: Person, security: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "gain or loss is recognized with respect to the security before the close of the taxable year (section 475(d)(3)(A)(ii)(I))";
}
pub relation section_475a2_would_have_applied_if_held_at_year_end_475d3AiiII(p: Person, security: Asset, y: TaxableYear) kind empirical {
    label en official "subsection (a)(2) would have applied if the security were held as of the close of the taxable year (section 475(d)(3)(A)(ii)(II))";
}
pub relation dispositional_gain_or_loss_is_ordinary_475d3Aii(p: Person, security: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "gain or loss recognized before year end on a security that would have been marked is ordinary (section 475(d)(3)(A)(ii))";
}
@source(IRC_S475_D, quote = "such gain or loss shall be treated as ordinary income or loss.")
rule DispositionalGainOrLossIsOrdinary(p: Person, security: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "ordinary character of an earlier disposition (section 475(d)(3)(A)(ii)); the (B) periods still exclude it";
    when gain_or_loss_recognized_before_year_end_475d3Aii(p, security, y, amount);
    when section_475a2_would_have_applied_if_held_at_year_end_475d3AiiII(p, security, y);
    when not_known(character_exception_475d3B(p, security, y));
    then dispositional_gain_or_loss_is_ordinary_475d3Aii(p, security, y, amount);
}

// ===================== (e)(2): commodity =====================

pub relation commodity_actively_traded_1092d1_475e2A(commodity: Asset) kind empirical {
    label en official "the commodity is actively traded within the meaning of section 1092(d)(1) (section 475(e)(2)(A)); the section 1092(d)(1) test is asserted";
}
pub relation notional_principal_contract_on_actively_traded_commodity_475e2B(commodity: Asset) kind empirical {
    label en official "the asset is a notional principal contract with respect to a commodity described in (A) (section 475(e)(2)(B))";
}
pub relation evidence_or_derivative_of_such_commodity_475e2C(commodity: Asset) kind empirical {
    label en official "the asset is an evidence of an interest in, or a derivative instrument in, a commodity described in (A) or (B), including an option, forward, futures, short position (section 475(e)(2)(C))";
}
pub relation position_hedges_such_a_commodity_475e2Dii(commodity: Asset) kind empirical {
    label en official "the position is not a commodity described in (A)-(C) and is a hedge with respect to such a commodity (section 475(e)(2)(D)(i)-(ii))";
}
pub relation commodity_position_identified_before_close_of_day_475e2Diii(commodity: Asset) kind empirical {
    label en official "the position is clearly identified in the taxpayer's records as described in (D) before the close of the day on which it was acquired or entered into (or such other time as the Secretary prescribes) (section 475(e)(2)(D)(iii))";
}
pub relation commodity_475e2(commodity: Asset) kind institutional {
    label en official "a commodity for section 475(e) and (f): an actively traded commodity, a notional principal contract on it, a derivative of it, or an identified hedge position (section 475(e)(2))";
}
@source(IRC_S475_E, quote = "(A) any commodity which is actively traded (within the meaning of section 1092(d)(1));")
rule CommodityActivelyTraded(commodity: Asset) strict {
    label en official "an actively traded commodity (section 475(e)(2)(A))";
    when commodity_actively_traded_1092d1_475e2A(commodity);
    then commodity_475e2(commodity);
}
@source(IRC_S475_E, quote = "(B) any notional principal contract with respect to any commodity described in subparagraph (A);")
rule CommodityNotionalPrincipalContract(commodity: Asset) strict {
    label en official "a notional principal contract on such a commodity (section 475(e)(2)(B))";
    when notional_principal_contract_on_actively_traded_commodity_475e2B(commodity);
    then commodity_475e2(commodity);
}
rule CommodityDerivativeOrEvidence(commodity: Asset) strict {
    label en official "an evidence of interest or derivative instrument (section 475(e)(2)(C))";
    when evidence_or_derivative_of_such_commodity_475e2C(commodity);
    then commodity_475e2(commodity);
}
@source(IRC_S475_E, quote = "(iii) is clearly identified in the taxpayer's records as being described in this subparagraph before the close of the day on which it was acquired or entered into")
rule CommodityIdentifiedHedgePosition(commodity: Asset) strict {
    label en official "an identified hedge position (section 475(e)(2)(D))";
    when position_hedges_such_a_commodity_475e2Dii(commodity);
    when commodity_position_identified_before_close_of_day_475e2Diii(commodity);
    then commodity_475e2(commodity);
}

// ===================== (f): traders =====================

pub relation no_connection_to_trader_activities_established_to_the_secretary_475f1Bi(security: Asset) kind empirical {
    label en official "the taxpayer establishes to the satisfaction of the Secretary that the security has no connection to its activities as a trader (section 475(f)(1)(B)(i)); an external determination of the Secretary";
}
pub relation trader_security_identified_before_close_of_day_475f1Bii(security: Asset) kind empirical {
    label en official "the security is clearly identified in the trader's records as described in clause (i) before the close of the day on which it was acquired, originated, or entered into (section 475(f)(1)(B)(ii))";
}
pub relation trader_security_excepted_475f1B(security: Asset) kind institutional {
    label en official "a security with no connection to the trader's activities, established and identified in time, is outside the trader's mark-to-market (section 475(f)(1)(B))";
}
@source(IRC_S475_F, quote = "Subparagraph (A) shall not apply to any security—")
rule TraderSecurityExcepted(security: Asset) defeasible {
    label en official "established no connection and identified in time (section 475(f)(1)(B)(i)-(ii))";
    when no_connection_to_trader_activities_established_to_the_secretary_475f1Bi(security);
    when trader_security_identified_before_close_of_day_475f1Bii(security);
    then trader_security_excepted_475f1B(security);
}
pub relation trader_security_ceases_to_be_excepted_on_475f1B(security: Asset, d: Date) kind empirical {
    label en official "the security ceases to be described in clause (i) on the date, after being identified (section 475(f)(1)(B), last sentence)";
}
pub relation trader_changes_in_value_after_cessation_marked_475f1B(security: Asset, ceased_on: Date) kind institutional {
    label en official "subparagraph (A) applies to changes in value of the security occurring after the cessation (section 475(f)(1)(B), last sentence)";
}
@source(IRC_S475_F, quote = "subparagraph (A) shall apply to any changes in value of the security occurring after the cessation.")
rule TraderChangesInValueAfterCessationMarked(security: Asset, ceased_on: Date) defeasible {
    label en official "later changes in value of a formerly excepted trader security are marked (section 475(f)(1)(B))";
    when trader_security_identified_before_close_of_day_475f1Bii(security);
    when trader_security_ceases_to_be_excepted_on_475f1B(security, ceased_on);
    then trader_changes_in_value_after_cessation_marked_475f1B(security, ceased_on);
}
pub relation mark_to_market_gain_electing_trader_excepting_475f1B(p: Person, security: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the trader's mark-to-market gain or loss on a security other than a (B)-excepted security (section 475(f)(1)(A)-(B)); the stage 2b rule `MarkToMarketGainElectingTrader` is kept";
}
rule TraderMarkToMarketExceptsB(p: Person, security: Asset, y: TaxableYear, fmv: Money, basis: Money, close_of_year: Date) defeasible {
    label en official "fair market value minus adjusted basis for a non-excepted trader security (section 475(f)(1)(A)-(B))";
    when mark_to_market_elected_for_trader(p, y);
    when security_held_at_close_of_year(p, security, y);
    when not_known(trader_security_excepted_475f1B(security));
    when security_fair_market_value_at_year_end(p, security, y, fmv);
    when us.irc.core::ends(y, close_of_year);
    when us.irc.core::adjusted_basis(p, security, close_of_year, basis);
    then mark_to_market_gain_electing_trader_excepting_475f1B(p, security, y, fmv - basis);
}
pub relation trader_security_disregarded_for_1259_475f1C(security: Asset) kind institutional {
    label en official "a security marked under (A) and acquired in the normal course of the trader's activities is not taken into account in applying section 1259 to a position to which (A) does not apply (section 475(f)(1)(C))";
}
pub relation security_acquired_in_normal_course_of_trader_activities_475f1C(security: Asset) kind empirical {
    label en official "the security was acquired in the normal course of the taxpayer's activities as a trader in securities (section 475(f)(1)(C))";
}
@source(IRC_S475_F, quote = "shall not be taken into account in applying section 1259 to any position to which subparagraph (A) does not apply.")
rule MarkedTraderSecurityDisregardedForSection1259(p: Person, security: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "marked trader securities are outside section 1259 for other positions (section 475(f)(1)(C))";
    when mark_to_market_gain_electing_trader_excepting_475f1B(p, security, y, amount);
    when security_acquired_in_normal_course_of_trader_activities_475f1C(security);
    then trader_security_disregarded_for_1259_475f1C(security);
}
pub relation trader_securities_coordination_rules_apply_475f1D(p: Person, y: TaxableYear) kind institutional {
    label en official "rules similar to (b)(4) and (d) apply to securities held in a trade or business with a section 475(f)(1) election in effect; (d)(3) does not apply for sections 1402 and 7704 (section 475(f)(1)(D))";
}
@source(IRC_S475_F, quote = "Rules similar to the rules of subsections (b)(4) and (d) shall apply to securities held by a person in any trade or business with respect to which an election under this paragraph is in effect.")
rule TraderElectionCarriesSubsectionDRules(p: Person, y: TaxableYear) defeasible {
    label en official "the (d) rules apply under an election (section 475(f)(1)(D))";
    when mark_to_market_elected_for_trader(p, y);
    then trader_securities_coordination_rules_apply_475f1D(p, y);
}
pub relation ordinary_character_inapplicable_for_sections_1402_7704_475f1D(p: Person, y: TaxableYear) kind institutional {
    label en official "subsection (d)(3) ordinary character does not apply, under the election, for purposes of sections 1402 and 7704 (section 475(f)(1)(D), last sentence)";
}
rule OrdinaryCharacterNotForSections1402And7704(p: Person, y: TaxableYear) defeasible {
    label en official "no (d)(3) character for self-employment tax and publicly traded partnership purposes (section 475(f)(1)(D))";
    when mark_to_market_elected_for_trader(p, y);
    then ordinary_character_inapplicable_for_sections_1402_7704_475f1D(p, y);
}
pub relation is_trader_in_commodities(p: Person) kind empirical {
    label en official "the taxpayer is engaged in a trade or business as a trader in commodities (section 475(f)(2))";
}
pub relation elects_mark_to_market_as_commodities_trader(p: Person, y: TaxableYear) kind empirical {
    label en official "the trader in commodities elects to have section 475(f)(2) apply to the trade or business (section 475(f)(2), (f)(3))";
}
pub relation mark_to_market_elected_for_commodities_trader(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 475(f)(2) election is in effect for the trader's commodities trade or business";
}
@source(IRC_S475_F, quote = "In the case of a person who is engaged in a trade or business as a trader in commodities and who elects to have this paragraph apply to such trade or business")
rule Section475F2CommoditiesTraderElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a trader in commodities may elect, without the Secretary's consent, to mark to market its commodities (section 475(f)(2), (f)(3))";
    when is_trader_in_commodities(p);
    when us.irc.core::year_of(p, y);
    then power Section475F2CommoditiesTraderElection {
        holder p;
        over y;
        exercise elects_mark_to_market_as_commodities_trader(p, y);
        valid_when is_trader_in_commodities(p);
        effect create(mark_to_market_elected_for_commodities_trader(p, y));
        window [@1997-08-05, infinity);
    };
}
pub relation mark_to_market_gain_commodities_trader_475f2(p: Person, commodity: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "a commodities trader marks the commodities held in the trade or business at year end as if sold at fair market value on the last business day (section 475(f)(2) applying (f)(1))";
}
@source(IRC_S475_F, quote = "paragraph (1) shall apply to commodities held by such trader in connection with such trade or business in the same manner as paragraph (1) applies to securities held by a trader in securities.")
rule MarkToMarketGainCommoditiesTrader(p: Person, commodity: Asset, y: TaxableYear, fmv: Money, basis: Money, close_of_year: Date) defeasible {
    label en official "fair market value minus adjusted basis for a commodity of an electing trader (section 475(f)(2))";
    when mark_to_market_elected_for_commodities_trader(p, y);
    when commodity_475e2(commodity);
    when commodity_held_at_close_of_year(p, commodity, y);
    when commodity_fair_market_value_at_year_end(p, commodity, y, fmv);
    when us.irc.core::ends(y, close_of_year);
    when us.irc.core::adjusted_basis(p, commodity, close_of_year, basis);
    then mark_to_market_gain_commodities_trader_475f2(p, commodity, y, fmv - basis);
}
