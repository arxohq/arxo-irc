// Section 451 — General rule for taxable year of inclusion. Stage 1b
// (IRC-07), priority section. Scope: (a) the general cash/accrual timing
// rule; (b) the all-events test with the applicable-financial-statement
// (AFS) acceleration rule; (c) the advance-payment 1-year deferral election
// as a power. (d)-(k) are NOT DONE this round.

use self::{
    AccountingMethod,
    IRC_S451_A,
    IRC_S451_B,
    IRC_S451_C,
    Person,
    TaxableYear,
    afs_exists_451b3,
    applicable_accounting_method,
    special_method_displaces_451b1,
    taxpayer_ceases_to_exist_in_year_451c3,
};

pub relation item_received_in_year(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount of an item of gross income received by the taxpayer during the taxable year (section 451(a))";
}
pub relation properly_accounted_for_different_period_under_method(p: Person, y_different: TaxableYear, item: Integer) kind empirical {
    label en official "under the method of accounting used in computing taxable income, the item is to be properly accounted for as of a different period than the year of receipt (section 451(a))";
}
pub relation gross_income_item_included_in_year(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the amount of the item is included in gross income for the taxable year (section 451(a), subject to (b)/(c))";
}
@source(IRC_S451_A, quote = "The amount of any item of gross income shall be included in the gross income for the taxable year in which received by the taxpayer, unless, under the method of accounting used in computing taxable income, such amount is to be properly accounted for as of a different period.")
rule IncludedInYearReceivedByDefault(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an item of gross income is included in the year received, unless the taxpayer's method of accounting properly accounts for it in a different period (section 451(a))";
    when item_received_in_year(p, y, item, amount);
    when not properly_accounted_for_different_period_under_method(p, y, item);
    then gross_income_item_included_in_year(p, y, item, amount);
}

// --- (b): the all-events test and the AFS acceleration rule ---

pub relation all_events_occurred_fixing_right_to_income(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "all the events have occurred which fix the right to receive the income (section 451(b)(1)(C))";
}
// "the amount of such income can be determined with reasonable accuracy" —
// DECISION-0194 evaluative element; the text names no administrative
// authority, so this is the general adjudicative default (Court).
external judgment relation income_amount_determinable_with_reasonable_accuracy(p: Person, y: TaxableYear, item: Integer) {
    authority Court;
    label en official "the amount of the income can be determined with reasonable accuracy (section 451(b)(1)(C))";
}
pub relation all_events_test_met_451b(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the all-events test of section 451(b)(1)(C) is met with respect to the item";
}
@source(IRC_S451_B, quote = "the all events test is met with respect to any item of gross income if all the events have occurred which fix the right to receive such income and the amount of such income can be determined with reasonable accuracy")
rule AllEventsTestMet451B(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "the all-events test is met when both events have occurred and the amount is determinable with reasonable accuracy (section 451(b)(1)(C))";
    when all_events_occurred_fixing_right_to_income(p, y, item);
    when income_amount_determinable_with_reasonable_accuracy(p, y, item);
    then all_events_test_met_451b(p, y, item);
}

pub relation has_applicable_financial_statement(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has an applicable financial statement described in section 451(b)(3) for the taxable year (section 451(b)(1)(B)(i))";
}
pub relation item_taken_into_account_as_afs_revenue(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item (or portion) is taken into account as revenue in the taxpayer's applicable financial statement for the taxable year (section 451(b)(1)(A))";
}
pub relation uses_accrual_method(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's taxable income is computed under an accrual method of accounting (bridged from section 446's applicable_accounting_method)";
}
rule BridgeUsesAccrualMethod(p: Person, y: TaxableYear) defeasible {
    label en official "bridges section 446's applicable accounting method into the accrual-method test section 451(b) needs";
    when applicable_accounting_method(p, y, Accrual);
    then uses_accrual_method(p, y);
}
pub relation all_events_test_treated_as_met_no_later_than_afs(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "for an accrual-method taxpayer with an applicable financial statement, the all-events test is not treated as met any later than the year the item is taken into account as AFS revenue (section 451(b)(1)(A))";
}
// SIMPLIFICATION: this rule evaluates a SINGLE candidate year at a time (per
// this stage's per-year relation shapes); it does not itself compare the AFS
// year against the ordinary all-events year to find the EARLIER of the two
// across multiple candidate years (that comparison is a scenario-level fact
// pattern, not a missing rule: a scenario asserting the AFS year and testing
// against it exercises exactly what (b)(1)(A) requires for that year).
@source(IRC_S451_B, quote = "the all events test with respect to any item of gross income (or portion thereof) shall not be treated as met any later than when such item (or portion thereof) is taken into account as revenue in—")
rule AfsAccelerationRule(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "AFS revenue recognition in year y is sufficient for the all-events test to be treated as met in year y, for an accrual-method taxpayer with an applicable financial statement, unless the mortgage-servicing-contract exception applies (section 451(b)(1)(A)-(B))";
    when uses_accrual_method(p, y);
    when afs_exists_451b3(p, y);
    when item_taken_into_account_as_afs_revenue(p, y, item);
    when not item_is_mortgage_servicing_contract_income(p, item);
    unless special_method_displaces_451b1(p, y, item);
    then all_events_test_treated_as_met_no_later_than_afs(p, y, item);
}
pub relation item_is_mortgage_servicing_contract_income(p: Person, item: Integer) kind empirical {
    label en official "the item of gross income is in connection with a mortgage servicing contract, excepted from the AFS acceleration rule (section 451(b)(1)(B)(ii))";
}
rule IncludedByAfsAcceleration(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an item whose AFS-accelerated all-events test is met in year y is included in gross income for y (section 451(a) applied through (b))";
    when all_events_test_treated_as_met_no_later_than_afs(p, y, item);
    when item_received_in_year(p, y, item, amount);
    then gross_income_item_included_in_year(p, y, item, amount);
}
rule IncludedByOrdinaryAllEventsTest(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an item whose ordinary all-events test is met in year y is included in gross income for y, for an accrual-method taxpayer (section 451(a) applied through (b)(1)(C))";
    when uses_accrual_method(p, y);
    when all_events_test_met_451b(p, y, item);
    when item_received_in_year(p, y, item, amount);
    then gross_income_item_included_in_year(p, y, item, amount);
}

// --- (c): the advance-payment 1-year deferral election, as a power ---

pub relation receives_advance_payment(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the taxpayer, using an accrual method, receives an advance payment during the taxable year (section 451(c)(1))";
}
pub relation elects_advance_payment_deferral(p: Person, y: TaxableYear, category: Integer) kind empirical {
    label en official "the taxpayer elects the application of section 451(c)(1)(B) with respect to the category of advance payments (section 451(c)(1)(B))";
}
pub relation deferral_election_timely_and_properly_made(p: Person, y: TaxableYear, category: Integer) kind empirical {
    label en official "the section 451(c)(1)(B) election is made at the time, in the form and manner, the Secretary provides (section 451(c)(2)(A))";
}
pub relation advance_payment_deferral_in_effect(p: Person, y: TaxableYear, category: Integer) kind institutional {
    label en official "the section 451(c)(1)(B) deferral election is in effect for the category of advance payments (section 451(c)(1)(B), (c)(2)(B): effective for the year first made and all subsequent years)";
}
@source(IRC_S451_C, quote = "the taxpayer shall—")
rule Section451CDeferralElectionPower(p: Person, y: TaxableYear, category: Integer) strict {
    label en official "a taxpayer using an accrual method may elect to defer the portion of an advance payment not required by (b) to be included in the receipt year to the following taxable year (section 451(c)(1)(B))";
    when elects_advance_payment_deferral(p, y, category);
    then power Section451CAdvancePaymentDeferralElection {
        holder p;
        over category;
        exercise elects_advance_payment_deferral(p, y, category);
        valid_when deferral_election_timely_and_properly_made(p, y, category);
        effect create(advance_payment_deferral_in_effect(p, y, category));
        window [@2017-12-22, infinity);
    };
}
pub relation advance_payment_category_of(item: Integer, category: Integer) kind empirical {
    label en official "the advance-payment item belongs to the given category, for purposes of matching it to a section 451(c)(1)(B) election (case-asserted linkage)";
}
pub relation advance_payment_portion_required_by_451b_in_receipt_year(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the portion of the advance payment required under (b) to be included in gross income in the receipt year (section 451(c)(1)(B)(i))";
}
rule AdvancePaymentDeferredPortionIncludedFollowingYear(p: Person, y: TaxableYear, item: Integer, category: Integer, total: Money, required_now: Money) defeasible {
    label en official "the remaining portion of a deferred advance payment (total less the (b)-required portion) is included in gross income for the taxable year following receipt (section 451(c)(1)(B)(ii))";
    when receives_advance_payment(p, y, item, total);
    when advance_payment_category_of(item, category);
    when advance_payment_deferral_in_effect(p, y, category);
    when advance_payment_portion_required_by_451b_in_receipt_year(p, y, item, required_now);
    when total > required_now;
    when not_known(taxpayer_ceases_to_exist_in_year_451c3(p, y));
    then advance_payment_deferred_portion(p, y, item, round(total - required_now, 2, "HALF_UP"));
}
pub relation advance_payment_deferred_portion(p: Person, y_received: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the deferred portion of an advance payment, includible in the taxable year following y_received (section 451(c)(1)(B)(ii)); this package does not itself compute the successor-year lookup (TECH_GAP, see G10-family: no successor_year construct)";
}

// (d) special rule in case of death, (e)-(k) (crop insurance, disaster
// prepayments, service warranty income, dealer sales, natural-gas contracts,
// original issue discount, cross-references) are NOT DONE this round.
