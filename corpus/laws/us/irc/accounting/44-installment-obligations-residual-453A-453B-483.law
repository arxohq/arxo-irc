// Sections 453A, 453B and 483 residual (stage 3, DECISION-0379 with deontics):
// the 453A(b)(2)-(4) exceptions and single-employer aggregation, the (c)(3)-(4)
// deferred tax liability with the section 1(h) rate and the applicable
// percentage, the (d) pledging rules; the 453B(e)-(h) rules on life insurance
// companies, unenforceable obligations, spousal transfers and S corporation
// liquidations; and the 483(c)-(e) definitions and exceptions.
//
// The stage 2b gate `Section453AAppliesGate` gains the (b)(3)-(4) exception
// guard (`obligation_excepted_from_453a_453Ab`), which is derived by strict rules
// from asserted facts.
//
// Not modelled (TECH-GAPS G4806): the present value of section 483(b)(2) payments
// under the section 1274(b)(2) rules at the applicable Federal rate; the
// regulations of 483(f); the extent of "directly secured" of 453A(d)(4) is an
// adjudicated fact.

// ===================== 453A(b)(2)-(4): the exceptions and the single employer =====================

use self::{
    IRC_S453A_B,
    IRC_S453A_C,
    IRC_S453A_D,
    IRC_S453B_E,
    IRC_S453B_F,
    IRC_S453B_G,
    IRC_S453B_H,
    IRC_S483_C,
    IRC_S483_D,
    IRC_S483_E,
    Person,
    TaxableYear,
    aggregate_face_amount_of_years_obligations,
    deferred_payment_sale_or_exchange_483,
    installment_obligation_face_value,
    installment_obligation_outstanding_at_close_of_year,
    installment_obligation_sales_price,
    is_installment_obligation_from_disposition,
    liquidation_obligation_payments_treated_as_payment_for_stock_453h1A,
    maximum_rate_of_tax_under_section_1_or_11,
    obligation_fair_market_value_at_distribution,
    obligation_gain_not_yet_recognized,
    oid_issue_price_determined_483,
    related_person_453f1,
    sales_price_exceeds_three_thousand_483,
    section_453a_applies_to_obligation,
    section_453a_interest_for_year,
    section_483_applies_to_contract,
    total_unstated_interest_483,
};

pub relation treated_as_single_employer_section_52_453Ab2(p: Person, q: Person) kind empirical {
    label en official "the persons are treated as a single employer under subsection (a) or (b) of section 52 (section 453A(b)(2), last sentence); the section 52 test is asserted";
}
pub relation single_employer_group_member_453Ab2(p: Person, member: Person) kind institutional {
    label en official "the member belongs to the person's single-employer group, the person included (section 453A(b)(2), last sentence)";
}
rule SingleEmployerGroupIncludesThePerson(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "a person is in its own group";
    when aggregate_face_amount_of_years_obligations(p, y, amount);
    then single_employer_group_member_453Ab2(p, p);
}
@source(IRC_S453A_B, quote = "Except as provided in regulations, all persons treated as a single employer under subsection (a) or (b) of section 52 shall be treated as one person for purposes of this paragraph and subsection (c)(4).")
rule SingleEmployerGroupMembers(p: Person, member: Person) strict {
    label en official "persons treated as a single employer under section 52 (section 453A(b)(2))";
    when treated_as_single_employer_section_52_453Ab2(p, member);
    then single_employer_group_member_453Ab2(p, member);
}
pub relation group_aggregate_face_amount_453Ab2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate face amount of the year's obligations of all persons treated as one person (section 453A(b)(2), (c)(4))";
}
rule GroupAggregateFaceAmount(p: Person, y: TaxableYear, own: Money) strict {
    label en official "the sum over the single-employer group (section 453A(b)(2))";
    when aggregate_face_amount_of_years_obligations(p, y, own);
    when single_employer_group_member_453Ab2(p, p);
    then group_aggregate_face_amount_453Ab2(p, y, sum all a: Money for member: Person where single_employer_group_member_453Ab2(p, member) and aggregate_face_amount_of_years_obligations(member, y, a));
}
pub relation obligation_from_personal_use_property_by_individual_453Ab3A(obligation: Integer) kind empirical {
    label en official "the obligation arises from the disposition by an individual of personal use property (within the meaning of section 1275(b)(3)) (section 453A(b)(3)(A))";
}
pub relation obligation_from_farm_property_453Ab3B(obligation: Integer) kind empirical {
    label en official "the obligation arises from the disposition of property used or produced in the trade or business of farming (within the meaning of section 2032A(e)(4) or (5)) (section 453A(b)(3)(B))";
}
pub relation obligation_from_disposition_described_in_453l2B_453Ab4(obligation: Integer) kind empirical {
    label en official "the obligation arises from a disposition described in section 453(l)(2)(B) (section 453A(b)(4))";
}
pub relation obligation_excepted_from_453a_453Ab(p: Person, obligation: Integer) kind institutional {
    label en official "the obligation is not a section 453A(b)(1) obligation: personal use property, farm property, or a section 453(l)(2)(B) disposition (section 453A(b)(3)-(4))";
}
@source(IRC_S453A_B, quote = "(A) by an individual of personal use property (within the meaning of section 1275(b)(3)), or")
rule ObligationExceptedPersonalUseProperty(p: Person, obligation: Integer, y: TaxableYear) strict {
    label en official "(b)(3)(A)";
    when is_installment_obligation_from_disposition(p, obligation, y);
    when obligation_from_personal_use_property_by_individual_453Ab3A(obligation);
    then obligation_excepted_from_453a_453Ab(p, obligation);
}
@source(IRC_S453A_B, quote = "(B) of any property used or produced in the trade or business of farming (within the meaning of section 2032A(e)(4) or (5)).")
rule ObligationExceptedFarmProperty(p: Person, obligation: Integer, y: TaxableYear) strict {
    label en official "(b)(3)(B)";
    when is_installment_obligation_from_disposition(p, obligation, y);
    when obligation_from_farm_property_453Ab3B(obligation);
    then obligation_excepted_from_453a_453Ab(p, obligation);
}
@source(IRC_S453A_B, quote = "An installment obligation shall not be treated as described in paragraph (1) if it arises from a disposition described in section 453(l)(2)(B)")
rule ObligationExceptedTimeshareLotDisposition(p: Person, obligation: Integer, y: TaxableYear) strict {
    label en official "(b)(4); the section 453(l)(3) interest then applies to the obligation";
    when is_installment_obligation_from_disposition(p, obligation, y);
    when obligation_from_disposition_described_in_453l2B_453Ab4(obligation);
    then obligation_excepted_from_453a_453Ab(p, obligation);
}
pub relation section_453a_applies_with_group_aggregate_453Ab(p: Person, obligation: Integer, y: TaxableYear) kind institutional {
    label en official "section 453A applies with the aggregate of the whole single-employer group over $5,000,000, and the obligation not excepted (section 453A(b))";
}
rule Section453AAppliesGroupAggregate(p: Person, obligation: Integer, y: TaxableYear, sales_price: Money, aggregate: Money) strict {
    label en official "the gate with the single-employer group aggregate (section 453A(b)(1)-(4))";
    when is_installment_obligation_from_disposition(p, obligation, y);
    when installment_obligation_sales_price(p, obligation, sales_price);
    when sales_price > 150000.00 USD;
    when installment_obligation_outstanding_at_close_of_year(p, obligation, y);
    when group_aggregate_face_amount_453Ab2(p, y, aggregate);
    when aggregate > 5000000.00 USD;
    when not_known(obligation_excepted_from_453a_453Ab(p, obligation));
    then section_453a_applies_to_obligation(p, obligation, y);
}

// ===================== 453A(c)(3)-(4): tax liability and applicable percentage =====================

pub relation portion_of_unrecognized_gain_long_term_capital_gain_453Ac3(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the unrecognized gain that, when recognized, will be long-term capital gain (section 453A(c)(3), last sentence)";
}
pub relation maximum_rate_on_net_capital_gain_1h_453Ac3(p: Person, y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the maximum rate on net capital gain under section 1(h) for the year (section 453A(c)(3)); the rate is asserted";
}
pub relation deferred_tax_liability_with_capital_gain_rate_453Ac3(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deferred tax liability with the section 1(h) rate for the long-term capital gain portion: ordinary portion x maximum rate + capital gain portion x section 1(h) rate, one rounding to cents HALF_UP (JUDGMENT CALL) (section 453A(c)(3))";
}
@source(IRC_S453A_C, quote = "the maximum rate on net capital gain under section 1(h) shall be taken into account.")
rule DeferredTaxLiabilityWithCapitalGainRate(p: Person, obligation: Integer, y: TaxableYear, gain: Money, capital: Money, rate: Decimal, cg_rate: Decimal) strict {
    label en official "(gain - capital) x rate + capital x cg rate (section 453A(c)(3))";
    when section_453a_applies_to_obligation(p, obligation, y);
    when obligation_gain_not_yet_recognized(p, obligation, y, gain);
    when portion_of_unrecognized_gain_long_term_capital_gain_453Ac3(p, obligation, y, capital);
    when maximum_rate_of_tax_under_section_1_or_11(p, y, rate);
    when maximum_rate_on_net_capital_gain_1h_453Ac3(p, y, cg_rate);
    then deferred_tax_liability_with_capital_gain_rate_453Ac3(p, obligation, y, round((gain - capital) * rate + capital * cg_rate, 2, "HALF_UP"));
}
pub relation applicable_percentage_derived_453Ac4(p: Person, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the applicable percentage: the aggregate face amount in excess of $5,000,000 divided by the aggregate face amount, over the single-employer group, to 6 decimal places HALF_UP (JUDGMENT CALL: no rounding is stated) (section 453A(c)(4))";
}
@source(IRC_S453A_C, quote = "the term \"applicable percentage\" means, with respect to obligations arising in any taxable year, the percentage determined by dividing—")
rule ApplicablePercentageFromAggregate(p: Person, y: TaxableYear, aggregate: Money) strict {
    label en official "(aggregate - 5,000,000) / aggregate (section 453A(c)(4)(A)-(B))";
    when group_aggregate_face_amount_453Ab2(p, y, aggregate);
    when aggregate > 5000000.00 USD;
    then applicable_percentage_derived_453Ac4(p, y, div_round((aggregate - 5000000.00 USD) / 1.00 USD, aggregate / 1.00 USD, 6, "HALF_UP"));
}
rule Section453AInterestComputationDerived(p: Person, obligation: Integer, y: TaxableYear, pct: Decimal, dtl: Money, short_term_rate: Decimal, quarter_start: Date) strict {
    label en official "the interest with the derived applicable percentage and the deferred tax liability with the section 1(h) rate (section 453A(c)(1)-(4))";
    when applicable_percentage_derived_453Ac4(p, y, pct);
    when deferred_tax_liability_with_capital_gain_rate_453Ac3(p, obligation, y, dtl);
    when us.irc.payment_refunds_interest::federal_short_term_rate(quarter_start, short_term_rate);
    then section_453a_interest_for_year(p, obligation, y, round(pct * round(dtl * (short_term_rate + 3.0) / 100.0, 2, "HALF_UP"), 2, "HALF_UP"));
}

// ===================== 453A(d): pledges =====================

pub relation net_proceeds_of_indebtedness_secured_by_obligation_453Ad1(p: Person, obligation: Integer, debt: Integer, amount: Money) kind empirical {
    label en official "the net proceeds of the indebtedness secured by the installment obligation to which section 453A applies (section 453A(d)(1)); that it is 'directly secured' to the extent claimed is an adjudicated fact (section 453A(d)(4))";
}
pub relation indebtedness_secured_by_obligation_to_extent_453Ad4(p: Person, obligation: Integer, debt: Integer) kind empirical {
    label en official "payment of principal or interest on the indebtedness is directly secured by an interest in the installment obligation (section 453A(d)(4)); an adjudicated fact";
}
pub relation time_indebtedness_becomes_secured_453Ad1A(p: Person, debt: Integer, d: Date) kind empirical {
    label en official "the date the indebtedness becomes secured indebtedness (section 453A(d)(1)(A))";
}
pub relation time_proceeds_received_453Ad1B(p: Person, debt: Integer, d: Date) kind empirical {
    label en official "the date the proceeds of the indebtedness are received (section 453A(d)(1)(B))";
}
pub relation pledge_receipt_date_453Ad1(p: Person, debt: Integer, d: Date) kind institutional {
    label en official "the later of the date the debt becomes secured and the date the proceeds are received (section 453A(d)(1))";
}
@source(IRC_S453A_D, quote = "as of the later of")
rule PledgeReceiptDateSecuredLater(p: Person, debt: Integer, secured_on: Date, received_on: Date) strict {
    label en official "the securing date when it is not earlier than the receipt (section 453A(d)(1)(A))";
    when time_indebtedness_becomes_secured_453Ad1A(p, debt, secured_on);
    when time_proceeds_received_453Ad1B(p, debt, received_on);
    when secured_on >= received_on;
    then pledge_receipt_date_453Ad1(p, debt, secured_on);
}
rule PledgeReceiptDateProceedsLater(p: Person, debt: Integer, secured_on: Date, received_on: Date) strict {
    label en official "the receipt date when it is later than the securing (section 453A(d)(1)(B))";
    when time_indebtedness_becomes_secured_453Ad1A(p, debt, secured_on);
    when time_proceeds_received_453Ad1B(p, debt, received_on);
    when received_on > secured_on;
    then pledge_receipt_date_453Ad1(p, debt, received_on);
}
pub relation total_contract_price_453Ad2A(p: Person, obligation: Integer, amount: Money) kind empirical {
    label en official "the total contract price (section 453A(d)(2)(A))";
}
pub relation portion_of_price_received_before_pledge_date_453Ad2B(p: Person, obligation: Integer, debt: Integer, amount: Money) kind empirical {
    label en official "any portion of the total contract price received before the later date, including amounts previously treated as received under paragraph (1) but not amounts not taken into account under paragraph (3) (section 453A(d)(2)(B))";
}
pub relation pledge_treated_as_payment_453Ad1(p: Person, obligation: Integer, debt: Integer, amount: Money) kind institutional {
    label en official "the net proceeds treated as a payment received on the obligation, limited to the excess of the total contract price over the earlier receipts, floored at zero (JUDGMENT CALL) (section 453A(d)(1)-(2))";
}
@source(IRC_S453A_D, quote = "The amount treated as received under paragraph (1) by reason of any secured indebtedness shall not exceed the excess (if any) of—")
rule PledgeTreatedAsPayment(p: Person, obligation: Integer, debt: Integer, y: TaxableYear, net: Money, price: Money, earlier: Money, d: Date) defeasible {
    label en official "min(net proceeds, max(price - earlier receipts, 0)) (section 453A(d)(1)-(2))";
    when section_453a_applies_to_obligation(p, obligation, y);
    when indebtedness_secured_by_obligation_to_extent_453Ad4(p, obligation, debt);
    when net_proceeds_of_indebtedness_secured_by_obligation_453Ad1(p, obligation, debt, net);
    when pledge_receipt_date_453Ad1(p, debt, d);
    when total_contract_price_453Ad2A(p, obligation, price);
    when portion_of_price_received_before_pledge_date_453Ad2B(p, obligation, debt, earlier);
    then pledge_treated_as_payment_453Ad1(p, obligation, debt, min(net, max(price - earlier, 0 USD)));
}
pub relation aggregate_subsequent_payments_on_pledged_obligation_453Ad3(p: Person, obligation: Integer, amount: Money) kind empirical {
    label en official "the aggregate of payments received on the obligation after the amount was treated as received (section 453A(d)(3))";
}
pub relation subsequent_payments_disregarded_453Ad3(p: Person, obligation: Integer, debt: Integer, amount: Money) kind institutional {
    label en official "subsequent payments are not taken into account for section 453 to the extent their aggregate does not exceed the amount treated as received: the lesser (section 453A(d)(3))";
}
@source(IRC_S453A_D, quote = "subsequent payments received on such obligation shall not be taken into account for purposes of section 453 to the extent that the aggregate of such subsequent payments does not exceed the aggregate amount treated as received under paragraph (1).")
rule SubsequentPaymentsDisregarded(p: Person, obligation: Integer, debt: Integer, later: Money, treated: Money) defeasible {
    label en official "min(later payments, amount treated as received) (section 453A(d)(3))";
    when pledge_treated_as_payment_453Ad1(p, obligation, debt, treated);
    when aggregate_subsequent_payments_on_pledged_obligation_453Ad3(p, obligation, later);
    then subsequent_payments_disregarded_453Ad3(p, obligation, debt, min(later, treated));
}

// ===================== 453B(e): life insurance companies =====================

pub relation person_is_life_insurance_company_816a_453Be(p: Person) kind empirical {
    label en official "the person is a life insurance company as defined in section 816(a) (section 453B(e)(1)); the section 816(a) test is asserted";
}
pub relation obligation_disposed_of_to_life_insurance_company_or_its_partnership_453Be1(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the person disposes of an installment obligation to a life insurance company, or to a partnership of which one is a partner (section 453B(e)(1))";
}
pub relation elects_noninsurance_installment_method_453Be2(p: Person, obligation: Integer) kind empirical {
    label en official "the life insurance company elects to determine its life insurance company taxable income by returning the income under the installment method as an item of a noninsurance business (section 453B(e)(2)); the exercise of the election";
}
pub relation life_insurance_company_election_valid_453Be2(p: Person, obligation: Integer) kind institutional {
    label en official "the election of (e)(2) is valid when made for an obligation the company holds";
}
pub relation life_insurance_company_election_in_effect_453Be2(p: Person, obligation: Integer) kind institutional {
    label en official "the election under (e)(2) is in effect for the obligation (section 453B(e)(2))";
}
pub relation obligation_held_by_life_insurance_company_453Be2(p: Person, obligation: Integer) kind empirical {
    label en official "the life insurance company holds the installment obligation";
}
rule LifeInsuranceElectionValidity(p: Person, obligation: Integer) strict {
    label en official "the electing person is a life insurance company holding the obligation (section 453B(e)(2))";
    when person_is_life_insurance_company_816a_453Be(p);
    when obligation_held_by_life_insurance_company_453Be2(p, obligation);
    then life_insurance_company_election_valid_453Be2(p, obligation);
}
@source(IRC_S453B_E, quote = "if the life insurance company elects (at such time and in such manner as the Secretary may by regulations prescribe) to determine its life insurance company taxable income—")
rule Section453BeElectionPower(p: Person, obligation: Integer) strict {
    label en official "a life insurance company may elect to return the income under the installment method (section 453B(e)(2)); the time and manner are regulatory";
    when elects_noninsurance_installment_method_453Be2(p, obligation);
    then power Section453BeInstallmentElection {
        holder p;
        over obligation;
        exercise elects_noninsurance_installment_method_453Be2(p, obligation);
        valid_when life_insurance_company_election_valid_453Be2(p, obligation);
        effect create(life_insurance_company_election_in_effect_453Be2(p, obligation));
        window [@1984-07-18, infinity);
    };
}
pub relation nonrecognition_provisions_denied_453Be1(p: Person, obligation: Integer, y: TaxableYear) kind institutional {
    label en official "no nonrecognition provision applies to the gain resulting under (a) from the disposition to a life insurance company (or its partnership), unless the election of (e)(2) is in effect (section 453B(e)(1)-(2))";
}
@source(IRC_S453B_E, quote = "no provision of this subtitle providing for the nonrecognition of gain shall apply with respect to any gain resulting under subsection (a).")
rule NonrecognitionDeniedOnDispositionToLifeInsuranceCompany(p: Person, obligation: Integer, y: TaxableYear) defeasible {
    label en official "disposition by a person other than a life insurance company (section 453B(e)(1))";
    when obligation_disposed_of_to_life_insurance_company_or_its_partnership_453Be1(p, obligation, y);
    when not_known(person_is_life_insurance_company_816a_453Be(p));
    when not_known(life_insurance_company_election_in_effect_453Be2(p, obligation));
    then nonrecognition_provisions_denied_453Be1(p, obligation, y);
}
pub relation corporation_became_life_insurance_company_for_year_453Be1(corp: Person, y: TaxableYear) kind empirical {
    label en official "a corporation that is a life insurance company for the year was not one for the preceding taxable year (section 453B(e)(1))";
}
pub relation partnership_of_which_life_insurance_company_becomes_partner_453Be1(partnership: Person, y: TaxableYear) kind empirical {
    label en official "a life insurance company becomes a partner of the partnership during the year (section 453B(e)(1))";
}
pub relation installment_obligation_held_at_prior_year_end_453Be1(holder: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the holder held the obligation on the last day of the preceding taxable year (or, for a partnership, when the company becomes a partner) (section 453B(e)(1))";
}
pub relation treated_as_transferred_to_life_insurance_company_453Be1(holder: Person, obligation: Integer, y: TaxableYear) kind institutional {
    label en official "the obligation is treated as transferred to a life insurance company on the last day of the preceding taxable year (section 453B(e)(1))";
}
@source(IRC_S453B_E, quote = "such corporation shall, for purposes of this subsection and subsection (a), be treated as having transferred to a life insurance company, on the last day of the preceding taxable year, all installment obligations which it held on such last day.")
rule NewLifeInsuranceCompanyTreatedAsTransferring(holder: Person, obligation: Integer, y: TaxableYear) defeasible {
    label en official "a corporation that becomes a life insurance company (section 453B(e)(1))";
    when corporation_became_life_insurance_company_for_year_453Be1(holder, y);
    when installment_obligation_held_at_prior_year_end_453Be1(holder, obligation, y);
    then treated_as_transferred_to_life_insurance_company_453Be1(holder, obligation, y);
}
@source(IRC_S453B_E, quote = "A partnership of which a life insurance company becomes a partner shall, for purposes of this subsection and subsection (a), be treated as having transferred to a life insurance company")
rule PartnershipWithNewLifeInsurancePartnerTreatedAsTransferring(holder: Person, obligation: Integer, y: TaxableYear) defeasible {
    label en official "a partnership that gains a life insurance company partner (section 453B(e)(1))";
    when partnership_of_which_life_insurance_company_becomes_partner_453Be1(holder, y);
    when installment_obligation_held_at_prior_year_end_453Be1(holder, obligation, y);
    then treated_as_transferred_to_life_insurance_company_453Be1(holder, obligation, y);
}
pub relation income_returned_as_noninsurance_business_installment_453Be2(p: Person, obligation: Integer) kind institutional {
    label en official "with the election the income is returned under the section 453 installment method as an item of a noninsurance business (section 453B(e)(2)(A)-(B))";
}
@source(IRC_S453B_E, quote = "(B) as if such income were an item attributable to a noninsurance business.")
rule ElectionReturnsIncomeUnderInstallmentMethod(p: Person, obligation: Integer) defeasible {
    label en official "(A) installment method and (B) noninsurance business item (section 453B(e)(2))";
    when life_insurance_company_election_in_effect_453Be2(p, obligation);
    then income_returned_as_noninsurance_business_installment_453Be2(p, obligation);
}
pub relation activity_is_insurance_business_453Be3(activity: Integer) kind empirical {
    label en official "the activity is an insurance business (section 453B(e)(3)(A))";
}
pub relation activity_traditionally_carried_on_by_life_insurers_for_investment_453Be3Bi(activity: Integer) kind empirical {
    label en official "the activity is of a type traditionally carried on by life insurance companies for investment purposes (section 453B(e)(3)(B)(i))";
}
pub relation activity_is_real_estate_453Be3Bi(activity: Integer) kind empirical {
    label en official "the activity is a real estate activity (section 453B(e)(3)(B)(i))";
}
pub relation activity_is_active_conduct_of_trade_or_business_453Be3Bi(activity: Integer) kind empirical {
    label en official "the carrying on of the activity constitutes the active conduct of a trade or business (section 453B(e)(3)(B)(i)); an adjudicated fact";
}
pub relation activity_performs_administrative_services_for_plans_453Be3Bii(activity: Integer) kind empirical {
    label en official "the activity involves the performance of administrative services in connection with plans providing life insurance, pension, or accident and health benefits (section 453B(e)(3)(B)(ii))";
}
pub relation activity_treated_as_insurance_business_453Be3B(activity: Integer) kind institutional {
    label en official "a non-insurance activity treated as an insurance business (section 453B(e)(3)(B))";
}
@source(IRC_S453B_E, quote = "it is of a type traditionally carried on by life insurance companies for investment purposes")
rule TraditionalInvestmentActivityInRealEstate(activity: Integer) defeasible {
    label en official "a traditional investment activity in real estate (section 453B(e)(3)(B)(i))";
    when activity_traditionally_carried_on_by_life_insurers_for_investment_453Be3Bi(activity);
    when activity_is_real_estate_453Be3Bi(activity);
    then activity_treated_as_insurance_business_453Be3B(activity);
}
rule TraditionalInvestmentActivityNotActiveConduct(activity: Integer) defeasible {
    label en official "a traditional investment activity other than real estate that is not the active conduct of a trade or business (section 453B(e)(3)(B)(i))";
    when activity_traditionally_carried_on_by_life_insurers_for_investment_453Be3Bi(activity);
    when not_known(activity_is_real_estate_453Be3Bi(activity));
    when not_known(activity_is_active_conduct_of_trade_or_business_453Be3Bi(activity));
    then activity_treated_as_insurance_business_453Be3B(activity);
}
@source(IRC_S453B_E, quote = "it involves the performance of administrative services in connection with plans providing life insurance, pension, or accident and health benefits.")
rule AdministrativeServicesActivity(activity: Integer) strict {
    label en official "(B)(ii)";
    when activity_performs_administrative_services_for_plans_453Be3Bii(activity);
    then activity_treated_as_insurance_business_453Be3B(activity);
}
pub relation noninsurance_business_activity_453Be3(activity: Integer) kind institutional {
    label en official "a noninsurance business: an activity that is not an insurance business, and is not treated as one under (B) (section 453B(e)(3))";
}
@source(IRC_S453B_E, quote = "the term \"noninsurance business\" means any activity which is not an insurance business.")
rule NoninsuranceBusinessDefinition(activity: Integer) defeasible {
    label en official "not an insurance business and not treated as one (section 453B(e)(3)(A)-(B))";
    when activity_exists_453Be3(activity);
    when not_known(activity_is_insurance_business_453Be3(activity));
    when not_known(activity_treated_as_insurance_business_453Be3B(activity));
    then noninsurance_business_activity_453Be3(activity);
}
pub relation activity_exists_453Be3(activity: Integer) kind empirical {
    label en official "the activity under consideration (a domain fact that binds the activity)";
}

// ===================== 453B(f)-(h): cancellation, spousal transfer, S corporation =====================

pub relation obligor_of_installment_obligation_453Bf(obligation: Integer, obligor: Person) kind empirical {
    label en official "the obligor under the installment obligation (section 453B(f)(2))";
}
pub relation obligation_canceled_or_unenforceable_453Bf(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the installment obligation is canceled or otherwise becomes unenforceable (section 453B(f))";
}
pub relation obligation_treated_as_disposed_other_than_sale_or_exchange_453Bf1(p: Person, obligation: Integer, y: TaxableYear) kind institutional {
    label en official "the obligation is treated as disposed of in a transaction other than a sale or exchange (section 453B(f)(1))";
}
@source(IRC_S453B_F, quote = "(1) the obligation shall be treated as if it were disposed of in a transaction other than a sale or exchange, and")
rule CanceledObligationTreatedAsOtherDisposition(p: Person, obligation: Integer, y: TaxableYear) defeasible {
    label en official "cancellation or unenforceability (section 453B(f)(1))";
    when obligation_canceled_or_unenforceable_453Bf(p, obligation, y);
    then obligation_treated_as_disposed_other_than_sale_or_exchange_453Bf1(p, obligation, y);
}
pub relation obligation_value_on_cancellation_453Bf(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the value of the canceled obligation: the fair market value, and not less than the face amount when the obligor and obligee are related persons under section 453(f)(1) (section 453B(f)(2))";
}
@source(IRC_S453B_F, quote = "the fair market value of the obligation shall be treated as not less than its face amount.")
rule CanceledObligationValueRelatedParties(p: Person, obligation: Integer, y: TaxableYear, obligor: Person, fmv: Money, face: Money) defeasible {
    label en official "max(fair market value, face amount) for related persons (section 453B(f)(2))";
    when obligation_treated_as_disposed_other_than_sale_or_exchange_453Bf1(p, obligation, y);
    when obligor_of_installment_obligation_453Bf(obligation, obligor);
    when related_person_453f1(obligor, p);
    when obligation_fair_market_value_at_distribution(p, obligation, y, fmv);
    when installment_obligation_face_value(p, obligation, face);
    then obligation_value_on_cancellation_453Bf(p, obligation, y, max(fmv, face));
}
rule CanceledObligationValueUnrelatedParties(p: Person, obligation: Integer, y: TaxableYear, obligor: Person, fmv: Money) defeasible {
    label en official "the fair market value for unrelated persons (section 453B(f)(1))";
    when obligation_treated_as_disposed_other_than_sale_or_exchange_453Bf1(p, obligation, y);
    when obligor_of_installment_obligation_453Bf(obligation, obligor);
    when not_known(related_person_453f1(obligor, p));
    when obligation_fair_market_value_at_distribution(p, obligation, y, fmv);
    then obligation_value_on_cancellation_453Bf(p, obligation, y, fmv);
}
pub relation transfer_described_in_1041a_not_in_trust_453Bg(transferor: Person, transferee: Person, obligation: Integer) kind empirical {
    label en official "a transfer of the installment obligation described in section 1041(a), other than a transfer in trust (section 453B(g))";
}
pub relation section_453B_a_does_not_apply_453Bg1(transferor: Person, transferee: Person, obligation: Integer) kind institutional {
    label en official "subsection (a) does not apply to the spousal transfer (section 453B(g)(1))";
}
@source(IRC_S453B_G, quote = "(1) subsection (a) of this section shall not apply, and")
rule SpousalTransferOutsideSubsectionA(transferor: Person, transferee: Person, obligation: Integer) strict {
    label en official "section 1041(a) transfers (section 453B(g)(1))";
    when transfer_described_in_1041a_not_in_trust_453Bg(transferor, transferee, obligation);
    then section_453B_a_does_not_apply_453Bg1(transferor, transferee, obligation);
}
pub relation transferee_has_transferors_tax_treatment_453Bg2(transferor: Person, transferee: Person, obligation: Integer) kind institutional {
    label en official "the transferee has the same tax treatment of the obligation as the transferor would have had (section 453B(g)(2))";
}
@source(IRC_S453B_G, quote = "(2) the same tax treatment with respect to the transferred installment obligation shall apply to the transferee as would have applied to the transferor.")
rule TransfereeSameTreatmentAsTransferor(transferor: Person, transferee: Person, obligation: Integer) strict {
    label en official "section 1041(a) transfers (section 453B(g)(2))";
    when transfer_described_in_1041a_not_in_trust_453Bg(transferor, transferee, obligation);
    then transferee_has_transferors_tax_treatment_453Bg2(transferor, transferee, obligation);
}
pub relation s_corporation_distributes_obligation_in_complete_liquidation_453Bh1(corp: Person, shareholder: Person, obligation: Integer) kind empirical {
    label en official "an installment obligation is distributed by an S corporation in a complete liquidation (section 453B(h)(1))";
}
pub relation no_gain_or_loss_recognized_by_distributing_corporation_453Bh(corp: Person, obligation: Integer) kind institutional {
    label en official "no gain or loss on the distribution of the obligation is recognized by the distributing corporation, except for any subchapter S tax (section 453B(h))";
}
@source(IRC_S453B_H, quote = "then, except for purposes of any tax imposed by subchapter S, no gain or loss with respect to the distribution of the obligation shall be recognized by the distributing corporation.")
rule SCorporationLiquidationDistributionNotRecognized(corp: Person, shareholder: Person, obligation: Integer) defeasible {
    label en official "receipt is not payment for the stock by reason of section 453(h)(1) (section 453B(h)(1)-(2))";
    when s_corporation_distributes_obligation_in_complete_liquidation_453Bh1(corp, shareholder, obligation);
    when not_known(liquidation_obligation_payments_treated_as_payment_for_stock_453h1A(shareholder, obligation));
    then no_gain_or_loss_recognized_by_distributing_corporation_453Bh(corp, obligation);
}

// ===================== 483(c)-(e) =====================

pub relation sale_date_483(contract: Integer, sold_on: Date) kind empirical {
    label en official "the date of the sale or exchange of the property (section 483(c)(1))";
}
pub relation contract_sale_year_483(contract: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year of the sale or exchange";
}
pub relation contract_payment_due_483(contract: Integer, payment: Integer, due_on: Date) kind empirical {
    label en official "a payment under the contract and its due date (section 483(c)(1))";
}
pub relation contract_has_payment_due_more_than_one_year_after_sale_483c1A(contract: Integer) kind institutional {
    label en official "some payment is due more than 1 year after the date of the sale or exchange (section 483(c)(1)(A))";
}
@source(IRC_S483_C, quote = "(A) under which some or all of the payments are due more than 1 year after the date of such sale or exchange, and")
rule ContractHasPaymentDueMoreThanOneYearAfterSale(contract: Integer, payment: Integer, sold_on: Date, due_on: Date) strict {
    label en official "a due date after 12 calendar months from the sale (section 483(c)(1)(A))";
    when sale_date_483(contract, sold_on);
    when contract_payment_due_483(contract, payment, due_on);
    when due_on > add_calendar_period(sold_on, 12 calendar_month);
    then contract_has_payment_due_more_than_one_year_after_sale_483c1A(contract);
}
rule Section483AppliesToDerivedDeferredContract(seller: Person, buyer: Person, contract: Integer, y: TaxableYear, unstated: Money) defeasible {
    label en official "a contract with a payment due over 1 year after the sale and total unstated interest, outside the (d) exceptions (section 483(c)(1)(A)-(B), (d))";
    when deferred_payment_sale_or_exchange_483(seller, buyer, contract, y);
    when contract_has_payment_due_more_than_one_year_after_sale_483c1A(contract);
    when total_unstated_interest_483(seller, buyer, contract, unstated);
    when sales_price_exceeds_three_thousand_483(seller, buyer, contract);
    when not_known(oid_issue_price_determined_483(seller, buyer, contract));
    then section_483_applies_to_contract(seller, buyer, contract, y);
}
pub relation purchaser_debt_instrument_given_for_property_483c2(contract: Integer, instrument: Integer) kind empirical {
    label en official "a debt instrument of the purchaser is given in consideration for the sale or exchange (section 483(c)(2)); 'debt instrument' is section 1275(a)(1)'s";
}
pub relation payment_due_under_purchaser_debt_instrument_483c2(contract: Integer, instrument: Integer, payment: Integer) kind empirical {
    label en official "a payment due under the purchaser's debt instrument (section 483(c)(2))";
}
pub relation debt_instrument_is_not_a_payment_483c2(contract: Integer, instrument: Integer) kind institutional {
    label en official "the purchaser's debt instrument is not a payment for section 483 (section 483(c)(2))";
}
@source(IRC_S483_C, quote = "a debt instrument of the purchaser which is given in consideration for the sale or exchange of property shall not be treated as a payment")
rule PurchaserDebtInstrumentIsNotAPayment(contract: Integer, instrument: Integer) strict {
    label en official "a purchaser debt instrument (section 483(c)(2))";
    when purchaser_debt_instrument_given_for_property_483c2(contract, instrument);
    then debt_instrument_is_not_a_payment_483c2(contract, instrument);
}
pub relation payment_treated_as_due_under_sale_contract_483c2(contract: Integer, payment: Integer) kind institutional {
    label en official "a payment due under the purchaser's debt instrument is treated as due under the sale contract (section 483(c)(2))";
}
@source(IRC_S483_C, quote = "any payment due under such debt instrument shall be treated as due under the contract for the sale or exchange.")
rule PaymentUnderPurchaserDebtInstrumentDueUnderContract(contract: Integer, instrument: Integer, payment: Integer) strict {
    label en official "the debt instrument's payments belong to the contract (section 483(c)(2))";
    when purchaser_debt_instrument_given_for_property_483c2(contract, instrument);
    when payment_due_under_purchaser_debt_instrument_483c2(contract, instrument, payment);
    then payment_treated_as_due_under_sale_contract_483c2(contract, payment);
}
pub relation amounts_treated_as_including_interest_under_163b_483d3(contract: Integer, buyer: Person) kind empirical {
    label en official "amounts paid on account of the sale are treated under section 163(b) as if they included interest (section 483(d)(3))";
}
pub relation purchaser_treatment_without_regard_to_section_483_483d3(contract: Integer, buyer: Person) kind institutional {
    label en official "for the purchaser, tax treatment is made without regard to section 483 (section 483(d)(3))";
}
@source(IRC_S483_D, quote = "the tax treatment of amounts paid on account of the sale or exchange of property shall be made without regard to this section")
rule PurchaserTreatmentWithoutSection483Under163b(contract: Integer, buyer: Person) strict {
    label en official "amounts treated under section 163(b) as including interest (section 483(d)(3))";
    when amounts_treated_as_including_interest_under_163b_483d3(contract, buyer);
    then purchaser_treatment_without_regard_to_section_483_483d3(contract, buyer);
}
pub relation transfer_described_in_1235a_483d4(contract: Integer) kind empirical {
    label en official "the transfer is described in section 1235(a) (sale or exchange of patents) (section 483(d)(4))";
}
pub relation payment_contingent_on_productivity_use_or_disposition_483d4(contract: Integer, payment: Integer) kind empirical {
    label en official "the amount is contingent on the productivity, use, or disposition of the property transferred (section 483(d)(4))";
}
pub relation payment_outside_section_483_patent_transfer_483d4(contract: Integer, payment: Integer) kind institutional {
    label en official "section 483 does not apply to a contingent amount in a section 1235(a) transfer (section 483(d)(4))";
}
@source(IRC_S483_D, quote = "this section shall not apply to any amount contingent on the productivity, use, or disposition of the property transferred.")
rule ContingentAmountInPatentTransferOutsideSection483(contract: Integer, payment: Integer) strict {
    label en official "section 1235(a) transfers (section 483(d)(4))";
    when transfer_described_in_1235a_483d4(contract);
    when payment_contingent_on_productivity_use_or_disposition_483d4(contract, payment);
    then payment_outside_section_483_patent_transfer_483d4(contract, payment);
}
pub relation party_to_sale_is_nonresident_alien_individual_483e4(contract: Integer) kind empirical {
    label en official "any party to the sale or exchange is a nonresident alien individual (section 483(e)(4))";
}
pub relation six_percent_cap_excluded_483e4(contract: Integer) kind institutional {
    label en official "paragraph (1) does not apply because a party is a nonresident alien individual (section 483(e)(4))";
}
@source(IRC_S483_E, quote = "Paragraph (1) shall not apply to any sale or exchange if any party to such sale or exchange is a nonresident alien individual.")
rule SixPercentCapExcludedForNonresidentAlienParty(contract: Integer) strict {
    label en official "a nonresident alien party (section 483(e)(4))";
    when party_to_sale_is_nonresident_alien_individual_483e4(contract);
    then six_percent_cap_excluded_483e4(contract);
}
