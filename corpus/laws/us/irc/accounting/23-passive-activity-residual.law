// Section 469 — residual (stage 2c, IRC-07). Adds to 09-passive-activity.law:
// (a)(2) persons described; (c)(3)-(7) working interests, research activity,
// real-property-business taxpayers and their election; (d)(2) passive activity
// credit; (e) special income rules; (f) former passive activities; (g)
// dispositions of the entire interest; (h)(2)-(4) material-participation
// rules; (i)(3)(B)-(E),(4)-(6) offset components, ordering, estates, married
// individuals filing separately and the active-participation test; (j) local
// definitions and special rules; (k) publicly traded partnerships.
//
// Parallel-path discipline: a stage 1b relation that is EMPIRICAL (case-
// asserted) and is still asserted by the stage 1b scenarios is not turned into
// a derived relation. New derived relations (`person_described_in_469a2`,
// `rental_activity_469`, `is_trade_or_business_for_469`) are fed BOTH by the
// legacy case fact and by the new derivation rules, and the stage 1b rules
// were re-pointed to them (09-passive-activity.law).
//
// Not modelled here (TECH-GAPS G2122-G2125, G2138-G2139 and coverage/accounting.json):
// the (j)(5) deduction equivalent (needs the inverse of the section 1/11 tax
// function), the (e)(2)(A) wiring of the closely-held-corporation deduction
// into the aggregate disallowance, the (g)(1)(C) prior-years income, the
// (i)(6)(B) participation waiver as an execution input of the stage 1b
// offset path, and every regulations-only sentence (EXTERNAL_DEPENDENCY).

// --- (a)(2): persons described ---

use self::{
    IRC_S469_A,
    IRC_S469_B,
    IRC_S469_C,
    IRC_S469_D,
    IRC_S469_E,
    IRC_S469_F,
    IRC_S469_G,
    IRC_S469_H,
    IRC_S469_I,
    IRC_S469_J,
    IRC_S469_K,
    Person,
    TaxableYear,
    conducts_trade_or_business_activity,
    is_469a_person,
    is_passive_activity,
    is_rental_activity,
    passive_activity_credit_taken_into_account_under_469a,
    passive_activity_loss,
};

pub relation is_individual_estate_or_trust_469(p: Person) kind empirical {
    label en official "the taxpayer is an individual, estate, or trust (section 469(a)(2)(A))";
}
pub relation is_c_corporation_described_in_465a1B(p: Person) kind empirical {
    label en official "the taxpayer is a C corporation described in section 465(a)(1)(B) (section 469(j)(1)) — the section 465(a)(1)(B) five-or-fewer-shareholder test itself is a case fact (section 465(a)(1)(B) is not formalized in this package)";
}
pub relation is_personal_service_corporation_469j2(p: Person) kind empirical {
    label en official "the taxpayer is a personal service corporation within section 269A(b)(1) as modified by section 469(j)(2) (case-asserted; the modified section 269A(b)(2) ownership test is an EXTERNAL_DEPENDENCY on the section 269A owner)";
}
pub relation is_closely_held_c_corporation_469(p: Person) kind institutional {
    label en official "a closely held C corporation: a C corporation described in section 465(a)(1)(B) (section 469(j)(1))";
}
@source(IRC_S469_J, quote = "The term \"closely held C corporation\" means any C corporation described in section 465(a)(1)(B).")
rule CloselyHeldCCorporationDefinition(p: Person) defeasible {
    label en official "a C corporation described in section 465(a)(1)(B) is a closely held C corporation (section 469(j)(1))";
    when is_c_corporation_described_in_465a1B(p);
    then is_closely_held_c_corporation_469(p);
}
pub relation person_described_in_469a2(p: Person) kind institutional {
    label en official "the person is described in section 469(a)(2): an individual, estate, or trust; a closely held C corporation; or a personal service corporation";
}
@source(IRC_S469_A, quote = "any individual, estate, or trust,")
rule Person469aIndividualEstateTrust(p: Person) defeasible {
    label en official "an individual, estate, or trust is a section 469(a)(2) person (section 469(a)(2)(A))";
    when is_individual_estate_or_trust_469(p);
    then person_described_in_469a2(p);
}
@source(IRC_S469_A, quote = "any closely held C corporation, and")
rule Person469aCloselyHeldCCorporation(p: Person) defeasible {
    label en official "a closely held C corporation is a section 469(a)(2) person (section 469(a)(2)(B))";
    when is_closely_held_c_corporation_469(p);
    then person_described_in_469a2(p);
}
@source(IRC_S469_A, quote = "any personal service corporation.")
rule Person469aPersonalServiceCorporation(p: Person) defeasible {
    label en official "a personal service corporation is a section 469(a)(2) person (section 469(a)(2)(C))";
    when is_personal_service_corporation_469j2(p);
    then person_described_in_469a2(p);
}
rule Person469aLegacyCaseFact(p: Person) defeasible {
    label en official "the stage 1b case-asserted classification `is_469a_person` still yields a section 469(a)(2) person (compatibility path for scenarios that assert the class directly)";
    when is_469a_person(p);
    then person_described_in_469a2(p);
}
// (f)(2): a corporation that ceases to be closely held / personal service
// corporation stays under section 469 for losses and credits of earlier years.
pub relation ceased_to_be_closely_held_or_psc_469(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer ceases for the taxable year to be a closely held C corporation or personal service corporation (section 469(f)(2))";
}
pub relation had_469_losses_or_credits_from_preceding_year(p: Person, y: TaxableYear) kind empirical {
    label en official "section 469 applied to losses or credits of the taxpayer for a taxable year preceding the taxable year (section 469(f)(2))";
}
pub relation section_469_continues_to_apply_to_carryovers(p: Person, y: TaxableYear) kind institutional {
    label en official "section 469 continues to apply to the preceding-year losses and credits as if the taxpayer were still a closely held C corporation or personal service corporation (section 469(f)(2))";
}
@source(IRC_S469_F, quote = "this section shall continue to apply to losses and credits to which this section applied for any preceding taxable year")
rule Section469ContinuesAfterCeasing(p: Person, y: TaxableYear) defeasible {
    label en official "section 469 continues to apply to prior-year losses and credits after the taxpayer ceases to be a closely held C corporation or personal service corporation (section 469(f)(2))";
    when ceased_to_be_closely_held_or_psc_469(p, y);
    when had_469_losses_or_credits_from_preceding_year(p, y);
    then section_469_continues_to_apply_to_carryovers(p, y);
}

// --- (c): trade or business, rental, working interests, real property ---

pub relation activity_involves_research_or_experimentation(p: Person, activity: Integer) kind empirical {
    label en official "the activity involves research or experimentation within the meaning of section 174 (section 469(c)(5))";
}
external judgment relation regulations_extend_trade_or_business_469c6(p: Person, activity: Integer) {
    authority Secretary;
    label en official "to the extent provided in regulations, the activity is one in connection with a trade or business, or one for which section 212 expenses are deductible, and so is a trade or business for section 469(c)(1)(A) (section 469(c)(6))";
}
pub relation is_trade_or_business_for_469(p: Person, activity: Integer) kind institutional {
    label en official "the activity involves the conduct of a trade or business for purposes of section 469(c)(1)(A), including research or experimentation (c)(5) and regulatory extensions (c)(6)";
}
@source(IRC_S469_C, quote = "which involves the conduct of any trade or business, and")
rule TradeOrBusinessFromConduct(p: Person, activity: Integer) defeasible {
    label en official "an activity that involves the conduct of a trade or business is one for section 469(c)(1)(A)";
    when conducts_trade_or_business_activity(p, activity);
    then is_trade_or_business_for_469(p, activity);
}
@source(IRC_S469_C, quote = "the term \"trade or business\" includes any activity involving research or experimentation (within the meaning of section 174)")
rule TradeOrBusinessIncludesResearch(p: Person, activity: Integer) defeasible {
    label en official "research or experimentation is a trade or business for section 469(c)(1)(A) (section 469(c)(5))";
    when activity_involves_research_or_experimentation(p, activity);
    then is_trade_or_business_for_469(p, activity);
}
@source(IRC_S469_C, quote = "To the extent provided in regulations, for purposes of paragraph (1)(A), the term \"trade or business\" includes—")
rule TradeOrBusinessByRegulationExtension(p: Person, activity: Integer) defeasible {
    label en official "an activity that the Secretary's regulations bring within the term trade or business is one for section 469(c)(1)(A) (section 469(c)(6))";
    when regulations_extend_trade_or_business_469c6(p, activity);
    then is_trade_or_business_for_469(p, activity);
}

pub relation payments_principally_for_use_of_tangible_property(p: Person, activity: Integer) kind empirical {
    label en official "the payments to the taxpayer from the activity are principally for the use of tangible property (section 469(j)(8))";
}
pub relation rental_activity_469(p: Person, activity: Integer) kind institutional {
    label en official "the activity is a rental activity: one where payments are principally for the use of tangible property (section 469(j)(8), (c)(2))";
}
@source(IRC_S469_J, quote = "The term \"rental activity\" means any activity where payments are principally for the use of tangible property.")
rule RentalActivityByPayments(p: Person, activity: Integer) defeasible {
    label en official "an activity whose payments are principally for the use of tangible property is a rental activity (section 469(j)(8))";
    when payments_principally_for_use_of_tangible_property(p, activity);
    then rental_activity_469(p, activity);
}
rule RentalActivityLegacyCaseFact(p: Person, activity: Integer) defeasible {
    label en official "the stage 1b case-asserted classification `is_rental_activity` still yields a rental activity (compatibility path)";
    when is_rental_activity(p, activity);
    then rental_activity_469(p, activity);
}

pub relation holds_oil_gas_working_interest(p: Person, activity: Integer) kind empirical {
    label en official "the taxpayer holds a working interest in an oil or gas property (section 469(c)(3)(A))";
}
pub relation working_interest_held_without_limited_liability(p: Person, activity: Integer) kind empirical {
    label en official "the working interest is held directly or through an entity which does not limit the liability of the taxpayer with respect to the interest (section 469(c)(3)(A))";
}
pub relation working_interest_excluded_469c3(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the working interest is not a passive activity for the taxable year (section 469(c)(3)(A)); (c)(4): without regard to material participation";
}
@source(IRC_S469_C, quote = "The term \"passive activity\" shall not include any working interest in any oil or gas property which the taxpayer holds directly or through an entity which does not limit the liability of the taxpayer with respect to such interest.")
rule WorkingInterestExcludedFromPassiveActivity(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a working interest in oil or gas held directly or through an unlimited-liability entity is not a passive activity, whether or not the taxpayer materially participates (section 469(c)(3)(A), (c)(4))";
    when holds_oil_gas_working_interest(p, activity);
    when working_interest_held_without_limited_liability(p, activity);
    when us.irc.core::year_of(p, y);
    then working_interest_excluded_469c3(p, activity, y);
}
pub relation working_interest_net_loss(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's loss for the taxable year from the working interest treated as a loss which is not from a passive activity (section 469(c)(3)(B))";
}
pub relation working_interest_loss_treated_as_not_passive(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the taxpayer has a loss for the taxable year from a working interest that is treated as not from a passive activity (section 469(c)(3)(B))";
}
rule WorkingInterestLossYear(p: Person, activity: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a positive loss from an excluded working interest triggers the (c)(3)(B) succeeding-year rule";
    when working_interest_excluded_469c3(p, activity, y);
    when working_interest_net_loss(p, activity, y, amount);
    when amount > 0.00 USD;
    then working_interest_loss_treated_as_not_passive(p, activity, y);
}
pub relation later_taxable_year_469(y_later: TaxableYear, y_earlier: TaxableYear) kind empirical {
    label en official "y_later is a succeeding taxable year of y_earlier (case-asserted; no successor-year term in the language, TECH-GAPS G9/G10 family)";
}
pub relation net_income_from_working_interest_property(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net income for the taxable year from the property (or a substituted-basis property) whose working-interest loss was treated as not passive (section 469(c)(3)(B))";
}
pub relation working_interest_net_income_treated_as_not_passive(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "net income from the property for a succeeding taxable year is treated as income which is not from a passive activity (section 469(c)(3)(B))";
}
@source(IRC_S469_C, quote = "then any net income from such property (or any property the basis of which is determined in whole or in part by reference to the basis of such property) for any succeeding taxable year shall be treated as income of the taxpayer which is not from a passive activity.")
rule WorkingInterestNetIncomeSubsequentYears(p: Person, activity: Integer, y: TaxableYear, y_loss: TaxableYear, amount: Money) defeasible {
    label en official "net income from a working-interest property in a taxable year after a non-passive loss year is not passive income (section 469(c)(3)(B))";
    when working_interest_loss_treated_as_not_passive(p, activity, y_loss);
    when later_taxable_year_469(y, y_loss);
    when net_income_from_working_interest_property(p, activity, y, amount);
    when amount > 0.00 USD;
    then working_interest_net_income_treated_as_not_passive(p, activity, y, amount);
}
pub relation credit_attributable_to_working_interest_property(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "credits allowable under subpart B (other than section 27) or D of part IV of subchapter A for the taxable year attributable to the working-interest property (section 469(c)(3)(B))";
}
pub relation working_interest_credit_treated_as_not_passive(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "credits attributable to a property whose net income is treated as not passive are treated as credits not from a passive activity (section 469(c)(3)(B), second sentence)";
}
@source(IRC_S469_C, quote = "any credits allowable under subpart B (other than section 27) or D of part IV of subchapter A for such taxable year which are attributable to such property shall be treated as")
rule WorkingInterestCreditsSubsequentYears(p: Person, activity: Integer, y: TaxableYear, amount: Money, income: Money) defeasible {
    label en official "credits attributable to a working-interest property in a year whose net income is not passive are not passive credits (section 469(c)(3)(B))";
    when working_interest_net_income_treated_as_not_passive(p, activity, y, income);
    when credit_attributable_to_working_interest_property(p, activity, y, amount);
    then working_interest_credit_treated_as_not_passive(p, activity, y, amount);
}

// (c)(7): taxpayers in a real property business.
pub enum RealPropertyTradeKind {
    Development;
    Redevelopment;
    Construction;
    Reconstruction;
    Acquisition;
    Conversion;
    Rental;
    Operation;
    Management;
    Leasing;
    Brokerage;
    label en official "the kinds of real property trade or business listed in section 469(c)(7)(C)";
}
pub relation activity_real_property_kind(activity: Integer, k: RealPropertyTradeKind) kind empirical {
    label en official "the trade or business is a real property development, redevelopment, construction, reconstruction, acquisition, conversion, rental, operation, management, leasing, or brokerage trade or business (section 469(c)(7)(C))";
}
pub relation real_property_trade_or_business_469(activity: Integer) kind institutional {
    label en official "the trade or business is a real property trade or business (section 469(c)(7)(C))";
}
@source(IRC_S469_C, quote = "the term \"real property trade or business\" means any real property development, redevelopment, construction, reconstruction, acquisition, conversion, rental, operation, management, leasing, or brokerage trade or business.")
rule RealPropertyTradeOrBusinessDefinition(activity: Integer) defeasible {
    label en official "a trade or business of one of the eleven listed kinds is a real property trade or business (section 469(c)(7)(C))";
    when activity_real_property_kind(activity, _);
    then real_property_trade_or_business_469(activity);
}
pub relation hours_in_real_property_trades_materially_participated(p: Person, y: TaxableYear, hours: Decimal) kind empirical {
    label en official "hours of services the taxpayer performed in real property trades or businesses in which the taxpayer materially participates, other than as an employee (section 469(c)(7)(B)(ii))";
}
pub relation hours_as_employee_in_real_property_trades(p: Person, y: TaxableYear, hours: Decimal) kind empirical {
    label en official "hours of services performed as an employee in real property trades or businesses (section 469(c)(7)(D)(ii))";
}
pub relation is_five_percent_owner_of_employer_469(p: Person, y: TaxableYear) kind empirical {
    label en official "the employee is a 5-percent owner (section 416(i)(1)(B)) in the employer (section 469(c)(7)(D)(ii), second sentence)";
}
pub relation total_personal_service_hours_in_trades_or_businesses(p: Person, y: TaxableYear, hours: Decimal) kind empirical {
    label en official "all personal services performed by the taxpayer in trades or businesses during the taxable year, in hours (section 469(c)(7)(B)(i))";
}
pub relation qualifying_real_property_hours_469c7(p: Person, y: TaxableYear, hours: Decimal) kind institutional {
    label en official "hours of services in real property trades or businesses that count under section 469(c)(7)(B), after the (D)(ii) exclusion of employee services (unless the employee is a 5-percent owner)";
}
rule QualifyingHoursEmployeeServicesExcluded(p: Person, y: TaxableYear, h: Decimal) defeasible {
    label en official "personal services performed as an employee are not treated as performed in real property trades or businesses unless the employee is a 5-percent owner (section 469(c)(7)(D)(ii))";
    when hours_in_real_property_trades_materially_participated(p, y, h);
    when not_known(is_five_percent_owner_of_employer_469(p, y));
    then qualifying_real_property_hours_469c7(p, y, h);
}
rule QualifyingHoursFivePercentOwnerEmployeeIncluded(p: Person, y: TaxableYear, h: Decimal, e: Decimal) defeasible {
    label en official "a 5-percent owner's employee services count as real property services (section 469(c)(7)(D)(ii), second sentence)";
    when hours_in_real_property_trades_materially_participated(p, y, h);
    when hours_as_employee_in_real_property_trades(p, y, e);
    when is_five_percent_owner_of_employer_469(p, y);
    then qualifying_real_property_hours_469c7(p, y, h + e);
}
pub relation meets_real_property_tests_individually_469c7(p: Person, y: TaxableYear) kind institutional {
    label en official "more than one-half of the taxpayer's personal services in trades or businesses, and more than 750 hours, are in real property trades or businesses in which the taxpayer materially participates (section 469(c)(7)(B)(i)-(ii))";
}
@source(IRC_S469_C, quote = "such taxpayer performs more than 750 hours of services during the taxable year in real property trades or businesses in which the taxpayer materially participates.")
rule RealPropertyProfessionalIndividualTests(p: Person, y: TaxableYear, q: Decimal, t: Decimal) defeasible {
    label en official "the (B) tests: qualifying real property hours exceed 750 and exceed one-half of all personal service hours (section 469(c)(7)(B))";
    when qualifying_real_property_hours_469c7(p, y, q);
    when total_personal_service_hours_in_trades_or_businesses(p, y, t);
    when q > 750.0;
    when q * 2.0 > t;
    then meets_real_property_tests_individually_469c7(p, y);
}
pub relation joint_return_spouse_469(p: Person, s: Person, y: TaxableYear) kind empirical {
    label en official "s is the spouse of p and they file a joint return for the taxable year (section 469(c)(7)(B), joint return sentence)";
}
pub relation gross_receipts_from_real_property_trades_materially_participated(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross receipts of the corporation derived from real property trades or businesses in which it materially participates (section 469(c)(7)(D)(i))";
}
pub relation total_gross_receipts_469(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the corporation's gross receipts for the taxable year (section 469(c)(7)(D)(i))";
}
pub relation applies_469c7(p: Person, y: TaxableYear) kind institutional {
    label en official "section 469(c)(7) applies to the taxpayer for the taxable year";
}
@source(IRC_S469_C, quote = "This paragraph shall apply to a taxpayer for a taxable year if—")
rule Section469C7AppliesIndividual(p: Person, y: TaxableYear) defeasible {
    label en official "section 469(c)(7) applies to a taxpayer that meets the (B) tests (section 469(c)(7)(B))";
    when meets_real_property_tests_individually_469c7(p, y);
    then applies_469c7(p, y);
}
@source(IRC_S469_C, quote = "In the case of a joint return, the requirements of the preceding sentence are satisfied if and only if either spouse separately satisfies such requirements.")
rule Section469C7AppliesJointReturnEitherSpouse(p: Person, s: Person, y: TaxableYear) defeasible {
    label en official "on a joint return the (B) requirements are satisfied if either spouse separately satisfies them (section 469(c)(7)(B), last sentence)";
    when joint_return_spouse_469(p, s, y);
    when meets_real_property_tests_individually_469c7(s, y);
    then applies_469c7(p, y);
}
@source(IRC_S469_C, quote = "the requirements of subparagraph (B) shall be treated as met for any taxable year if more than 50 percent of the gross receipts of such corporation for such taxable year are derived from real property trades or businesses in which the corporation materially participates.")
rule Section469C7AppliesCloselyHeldCCorporation(p: Person, y: TaxableYear, g: Money, t: Money) defeasible {
    label en official "a closely held C corporation meets (B) when more than 50 percent of its gross receipts derive from real property trades or businesses in which it materially participates (section 469(c)(7)(D)(i))";
    when is_closely_held_c_corporation_469(p);
    when gross_receipts_from_real_property_trades_materially_participated(p, y, g);
    when total_gross_receipts_469(p, y, t);
    when g * 2.0 > t;
    then applies_469c7(p, y);
}
pub relation is_rental_real_estate_activity(p: Person, activity: Integer) kind empirical {
    label en official "the activity is a rental real estate activity of the taxpayer (section 469(c)(7)(A))";
}
pub relation rental_real_estate_exempt_from_469c2(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "section 469(c)(2) does not apply to the rental real estate activity for the taxable year (section 469(c)(7)(A)(i))";
}
@source(IRC_S469_C, quote = "paragraph (2) shall not apply to any rental real estate activity of such taxpayer for such taxable year, and")
rule RentalRealEstateExemptFor469C7Taxpayer(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "for a taxpayer to whom (c)(7) applies, a rental real estate activity is not passive merely as a rental activity (section 469(c)(7)(A)(i)); it is still passive if the taxpayer does not materially participate";
    when is_rental_real_estate_activity(p, activity);
    when applies_469c7(p, y);
    then rental_real_estate_exempt_from_469c2(p, activity, y);
}
pub relation elects_to_treat_all_rental_real_estate_as_one_activity(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects to treat all interests in rental real estate as one activity (section 469(c)(7)(A), flush sentence)";
}
pub relation rental_real_estate_interests_treated_as_one_activity(p: Person, y: TaxableYear) kind institutional {
    label en official "all of the taxpayer's interests in rental real estate are treated as one activity for the taxable year (section 469(c)(7)(A), flush sentence)";
}
@source(IRC_S469_C, quote = "Notwithstanding clause (ii), a taxpayer may elect to treat all interests in rental real estate as one activity.")
rule Section469C7AggregationElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer to whom (c)(7) applies may elect to treat all interests in rental real estate as one activity (section 469(c)(7)(A))";
    when elects_to_treat_all_rental_real_estate_as_one_activity(p, y);
    then power Section469C7AggregationElection {
        holder p;
        over y;
        exercise elects_to_treat_all_rental_real_estate_as_one_activity(p, y);
        valid_when applies_469c7(p, y);
        effect create(rental_real_estate_interests_treated_as_one_activity(p, y));
        window [@1994-01-01, infinity);
    };
}

// --- (d)(2): the passive activity credit ---

pub relation credits_allowable_from_passive_activities(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of the credits from all passive activities allowable for the taxable year under subpart D of part IV of subchapter A, or subpart B (other than section 27) of that part (section 469(d)(2)(A))";
}
pub relation regular_tax_liability_allocable_to_passive_activities(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the regular tax liability (section 26(b), via section 469(j)(3)) of the taxpayer for the taxable year allocable to all passive activities (section 469(d)(2)(B)) — the section 26(b) computation is an EXTERNAL_DEPENDENCY";
}
pub relation passive_activity_credit(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity credit: credits from passive activities in excess of the regular tax liability allocable to them (section 469(d)(2))";
}
@source(IRC_S469_D, quote = "The term \"passive activity credit\" means the amount (if any) by which—")
rule PassiveActivityCreditComputation(p: Person, y: TaxableYear, credits: Money, liability: Money) strict {
    label en official "the passive activity credit is the excess of allowable passive credits over allocable regular tax liability, floored at zero (section 469(d)(2))";
    when credits_allowable_from_passive_activities(p, y, credits);
    when regular_tax_liability_allocable_to_passive_activities(p, y, liability);
    then passive_activity_credit(p, y, max(0.00 USD, credits - liability));
}
pub relation passive_activity_credit_disallowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity credit for the taxable year is not allowed to a section 469(a)(2) person (section 469(a)(1)(B)); the (i) rehabilitation/low-income offsets are applied separately below";
}
@source(IRC_S469_A, quote = "(B) the passive activity credit,")
rule PassiveActivityCreditDisallowed(p: Person, y: TaxableYear, credit: Money) defeasible {
    label en official "the passive activity credit (less the part allowable under the similar rule of section 469(e)(2)(A), last sentence, stage 4) is disallowed for a section 469(a)(2) person (section 469(a)(1)(B))";
    when person_described_in_469a2(p);
    when passive_activity_credit_taken_into_account_under_469a(p, y, credit);
    when credit > 0.00 USD;
    then passive_activity_credit_disallowed(p, y, credit);
}
pub relation passive_activity_credit_carryover_to_next_year(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the disallowed passive activity credit is treated as a credit allocable to the activity in the next taxable year (section 469(b))";
}
@source(IRC_S469_B, quote = "any loss or credit from an activity which is disallowed under subsection (a) shall be treated as a deduction or credit allocable to such activity in the next taxable year")
rule PassiveActivityCreditCarryover(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "a disallowed passive activity credit carries to the next taxable year (section 469(b))";
    when passive_activity_credit_disallowed(p, y, amount);
    then passive_activity_credit_carryover_to_next_year(p, y, amount);
}

// --- (e): special rules for determining income or loss ---

pub enum PortfolioIncomeKind {
    Interest;
    Dividends;
    Annuities;
    Royalties;
    label en official "the kinds of gross income named in section 469(e)(1)(A)(i)(I)";
}
pub relation gross_income_item_kind_469(p: Person, y: TaxableYear, item: Integer, k: PortfolioIncomeKind) kind empirical {
    label en official "the gross income item is interest, dividends, annuities, or royalties (section 469(e)(1)(A)(i)(I))";
}
pub relation derived_in_ordinary_course_of_trade_or_business(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is derived in the ordinary course of a trade or business (section 469(e)(1)(A)) — a fact, absence is not negation";
}
pub relation attributable_to_working_capital_investment(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the income, gain, or loss is attributable to an investment of working capital (section 469(e)(1)(B))";
}
pub relation item_excluded_from_passive_activity_income_or_loss(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the item is not taken into account in determining income or loss from a passive activity (section 469(e)(1), (e)(3), (j)(7), (j)(10))";
}
@source(IRC_S469_E, quote = "gross income from interest, dividends, annuities, or royalties not derived in the ordinary course of a trade or business,")
rule PortfolioIncomeExcluded(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "interest, dividends, annuities, or royalties not derived in the ordinary course of a trade or business are not taken into account (section 469(e)(1)(A)(i)(I))";
    when gross_income_item_kind_469(p, y, item, _);
    when not_known(derived_in_ordinary_course_of_trade_or_business(p, y, item));
    then item_excluded_from_passive_activity_income_or_loss(p, y, item);
}
@source(IRC_S469_E, quote = "any income, gain, or loss which is attributable to an investment of working capital shall be treated as not derived in the ordinary course of a trade or business.")
rule WorkingCapitalIncomeTreatedAsNotOrdinaryCourse(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "portfolio income attributable to working capital is treated as not derived in the ordinary course, and so excluded (section 469(e)(1)(B))";
    when gross_income_item_kind_469(p, y, item, _);
    when attributable_to_working_capital_investment(p, y, item);
    then item_excluded_from_passive_activity_income_or_loss(p, y, item);
}
pub relation expense_allocable_to_excluded_income(p: Person, y: TaxableYear, expense: Integer, item: Integer) kind empirical {
    label en official "the expense is clearly and directly allocable to the gross income item (non-interest expense, (e)(1)(A)(i)(II)) or the interest expense is properly allocable to it ((III))";
}
pub relation expense_excluded_from_passive_activity_469e1(p: Person, y: TaxableYear, expense: Integer) kind institutional {
    label en official "the expense (including interest expense) allocable to excluded gross income is not taken into account in determining passive income or loss (section 469(e)(1)(A)(i)(II)-(III))";
}
@source(IRC_S469_E, quote = "expenses (other than interest) which are clearly and directly allocable to such gross income, and")
rule ExpenseAllocableToExcludedIncomeExcluded(p: Person, y: TaxableYear, expense: Integer, item: Integer) defeasible {
    label en official "expenses allocable to excluded portfolio income are excluded with it (section 469(e)(1)(A)(i)(II)-(III))";
    when expense_allocable_to_excluded_income(p, y, expense, item);
    when item_excluded_from_passive_activity_income_or_loss(p, y, item);
    then expense_excluded_from_passive_activity_469e1(p, y, expense);
}
pub relation disposition_gain_or_loss_not_in_ordinary_course(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "gain or loss not derived in the ordinary course of a trade or business attributable to a disposition of property (section 469(e)(1)(A)(ii))";
}
pub relation disposed_property_produces_portfolio_income(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the disposed property produces income of a type described in (e)(1)(A)(i) (section 469(e)(1)(A)(ii)(I))";
}
pub relation disposed_property_held_for_investment(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the disposed property is held for investment (section 469(e)(1)(A)(ii)(II))";
}
pub relation disposed_property_is_interest_in_passive_activity(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the disposed property is an interest in a passive activity (section 469(e)(1)(A), flush sentence)";
}
@source(IRC_S469_E, quote = "gain or loss not derived in the ordinary course of a trade or business which is attributable to the disposition of property—")
rule DispositionOfIncomeProducingPropertyExcluded(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "gain or loss on property producing portfolio-type income is excluded (section 469(e)(1)(A)(ii)(I))";
    when disposition_gain_or_loss_not_in_ordinary_course(p, y, item);
    when disposed_property_produces_portfolio_income(p, y, item);
    then item_excluded_from_passive_activity_income_or_loss(p, y, item);
}
rule DispositionOfInvestmentPropertyExcluded(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "gain or loss on property held for investment is excluded, but an interest in a passive activity is never property held for investment (section 469(e)(1)(A)(ii)(II), flush sentence)";
    when disposition_gain_or_loss_not_in_ordinary_course(p, y, item);
    when disposed_property_held_for_investment(p, y, item);
    when not_known(disposed_property_is_interest_in_passive_activity(p, y, item));
    then item_excluded_from_passive_activity_income_or_loss(p, y, item);
}
pub relation item_is_earned_income_911d2A(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is earned income within the meaning of section 911(d)(2)(A) (section 469(e)(3))";
}
@source(IRC_S469_E, quote = "Earned income (within the meaning of section 911(d)(2)(A)) shall not be taken into account in computing the income or loss from a passive activity for any taxable year.")
rule EarnedIncomeExcluded(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "earned income is not taken into account in computing passive income or loss (section 469(e)(3))";
    when item_is_earned_income_911d2A(p, y, item);
    then item_excluded_from_passive_activity_income_or_loss(p, y, item);
}
pub relation qualified_residence_interest_item_469j7(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is qualified residence interest within section 163(h)(3) (section 469(j)(7))";
}
@source(IRC_S469_J, quote = "The passive activity loss of a taxpayer shall be computed without regard to qualified residence interest (within the meaning of section 163(h)(3)).")
rule QualifiedResidenceInterestExcluded(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "qualified residence interest is left out of the passive activity loss computation (section 469(j)(7))";
    when qualified_residence_interest_item_469j7(p, y, item);
    then item_excluded_from_passive_activity_income_or_loss(p, y, item);
}
pub relation item_allocable_to_dwelling_use_280A_c5(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the income, deduction, gain, or loss is allocable to the use of a dwelling unit to which section 280A(c)(5) applies (section 469(j)(10))";
}
@source(IRC_S469_J, quote = "any income, deduction, gain, or loss allocable to such use shall not be taken into account for purposes of this section for such taxable year.")
rule DwellingUseSection280ACoordination(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "items allocable to a section 280A(c)(5) dwelling use are not taken into account under section 469 (section 469(j)(10))";
    when item_allocable_to_dwelling_use_280A_c5(p, y, item);
    then item_excluded_from_passive_activity_income_or_loss(p, y, item);
}
pub relation gross_dividends_469(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross dividend income taken into account under section 469(e)(1)-(2)";
}
pub relation dividends_received_deduction_243_245(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the dividends received deduction under section 243 or 245 for the taxable year";
}
pub relation dividend_income_for_469e(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "income from dividends reduced by the dividends received deduction (section 469(e)(4))";
}
@source(IRC_S469_E, quote = "income from dividends shall be reduced by the amount of any dividends received deduction under section 243 or 245.")
rule DividendIncomeReducedByDividendsReceivedDeduction(p: Person, y: TaxableYear, gross: Money, drd: Money) strict {
    label en official "dividends for section 469(e)(1)-(2) are gross dividends less the section 243/245 deduction, not below zero (section 469(e)(4))";
    when gross_dividends_469(p, y, gross);
    when dividends_received_deduction_243_245(p, y, drd);
    then dividend_income_for_469e(p, y, max(0.00 USD, gross - drd));
}
// (e)(2): closely held C corporation offset against net active income.
pub relation taxable_income_before_469e2(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "taxable income of the closely held C corporation for the taxable year (section 469(e)(2)(B))";
}
pub relation net_income_or_loss_from_passive_activities_469e2(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "income or loss from passive activities included in taxable income (section 469(e)(2)(B)(i))";
}
pub relation net_e1A_items_included_in_taxable_income(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "net gross income, expense, gain, or loss described in section 469(e)(1)(A) included in taxable income (section 469(e)(2)(B)(ii))";
}
pub relation net_active_income_469e2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net active income: taxable income determined without regard to passive income or loss and (e)(1)(A) items (section 469(e)(2)(B))";
}
@source(IRC_S469_E, quote = "the term \"net active income\" means the taxable income of the taxpayer for the taxable year determined without regard to—")
rule NetActiveIncomeComputation(p: Person, y: TaxableYear, ti: Money, passive: Money, e1: Money) strict {
    label en official "net active income is taxable income less passive income (or plus passive loss) and less (e)(1)(A) items (section 469(e)(2)(B))";
    when taxable_income_before_469e2(p, y, ti);
    when net_income_or_loss_from_passive_activities_469e2(p, y, passive);
    when net_e1A_items_included_in_taxable_income(p, y, e1);
    then net_active_income_469e2(p, y, round(ti - passive - e1, 2, "HALF_UP"));
}
pub relation closely_held_corporation_passive_loss_deductible_469e2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity loss of a closely held C corporation (other than a personal service corporation) allowable as a deduction against net active income (section 469(e)(2)(A)(i)); netted out of the (a) disallowance by `passive_activity_loss_taken_into_account_under_469a` (stage 4)";
}
@source(IRC_S469_E, quote = "the passive activity loss of such taxpayer for such taxable year (determined without regard to this paragraph)—")
rule ClosedHeldCorporationPassiveLossOffsetsActiveIncome(p: Person, y: TaxableYear, pal: Money, nai: Money) defeasible {
    label en official "a closely held C corporation that is not a personal service corporation deducts its passive activity loss against net active income, up to that income (section 469(e)(2)(A))";
    when is_closely_held_c_corporation_469(p);
    when not_known(is_personal_service_corporation_469j2(p));
    when passive_activity_loss(p, y, pal);
    when net_active_income_469e2(p, y, nai);
    when nai > 0.00 USD;
    then closely_held_corporation_passive_loss_deductible_469e2(p, y, min(pal, nai));
}

// --- (f): former passive activities ---

pub relation was_passive_activity_in_prior_year(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the activity was a passive activity for a taxable year preceding y (section 469(f)(3)(B)) — case-asserted link to the prior-year status (no year-successor term, TECH-GAPS G9/G10 family)";
}
pub relation former_passive_activity_469(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "a former passive activity: not a passive activity for the taxable year but a passive activity for a prior year (section 469(f)(3))";
}
@source(IRC_S469_F, quote = "The term \"former passive activity\" means any activity which, with respect to the taxpayer—")
rule FormerPassiveActivityDefinition(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "an activity that is not passive this year but was passive in a prior year is a former passive activity (section 469(f)(3))";
    when was_passive_activity_in_prior_year(p, activity, y);
    unless is_passive_activity(p, activity, y);
    then former_passive_activity_469(p, activity, y);
}
pub relation unused_deduction_allocable_to_activity_469b(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the unused deduction allocable to the activity under section 469(b) at the start of the taxable year (section 469(f)(1)(A))";
}
pub relation income_from_activity_469f(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the income from the former passive activity for the taxable year (section 469(f)(1)(A))";
}
pub relation former_passive_deduction_offset(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unused deduction offset against income from the former passive activity for the taxable year (section 469(f)(1)(A))";
}
@source(IRC_S469_F, quote = "any unused deduction allocable to such activity under subsection (b) shall be offset against the income from such activity for the taxable year")
rule FormerPassiveDeductionOffsetAgainstIncome(p: Person, activity: Integer, y: TaxableYear, unused: Money, income: Money) defeasible {
    label en official "the unused deduction is offset against income from the activity, up to that income (section 469(f)(1)(A))";
    when former_passive_activity_469(p, activity, y);
    when unused_deduction_allocable_to_activity_469b(p, activity, y, unused);
    when income_from_activity_469f(p, activity, y, income);
    then former_passive_deduction_offset(p, activity, y, min(unused, max(0.00 USD, income)));
}
pub relation former_passive_deduction_remaining_passive(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction remaining after the (A) offset continues to be treated as arising from a passive activity (section 469(f)(1)(C))";
}
@source(IRC_S469_F, quote = "any such deduction or credit remaining after the application of subparagraphs (A) and (B) shall continue to be treated as arising from a passive activity.")
rule FormerPassiveDeductionRemainingContinuesPassive(p: Person, activity: Integer, y: TaxableYear, unused: Money, offset: Money) defeasible {
    label en official "the unused deduction not absorbed by the activity's income remains a passive-activity deduction (section 469(f)(1)(C))";
    when unused_deduction_allocable_to_activity_469b(p, activity, y, unused);
    when former_passive_deduction_offset(p, activity, y, offset);
    then former_passive_deduction_remaining_passive(p, activity, y, round(unused - offset, 2, "HALF_UP"));
}
pub relation unused_credit_allocable_to_activity_469b(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the unused credit allocable to the activity under section 469(b) (section 469(f)(1)(B))";
}
pub relation regular_tax_liability_after_deduction_offset_allocable_to_activity(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the regular tax liability computed after the (A) offset, allocable to the former passive activity (section 469(f)(1)(B)) — the section 26(b) computation is an EXTERNAL_DEPENDENCY";
}
pub relation former_passive_credit_offset(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unused credit offset against the regular tax liability allocable to the former passive activity (section 469(f)(1)(B))";
}
@source(IRC_S469_F, quote = "any unused credit allocable to such activity under subsection (b) shall be offset against the regular tax liability")
rule FormerPassiveCreditOffsetAgainstLiability(p: Person, activity: Integer, y: TaxableYear, unused: Money, liability: Money) defeasible {
    label en official "the unused credit is offset against the liability allocable to the activity, up to that liability (section 469(f)(1)(B))";
    when former_passive_activity_469(p, activity, y);
    when unused_credit_allocable_to_activity_469b(p, activity, y, unused);
    when regular_tax_liability_after_deduction_offset_allocable_to_activity(p, activity, y, liability);
    then former_passive_credit_offset(p, activity, y, min(unused, max(0.00 USD, liability)));
}

// --- (g): dispositions of the entire interest ---

pub relation disposes_of_entire_interest_in_activity(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "during the taxable year the taxpayer disposes of the entire interest in a passive activity (or former passive activity) (section 469(g))";
}
pub relation all_gain_or_loss_recognized_on_disposition(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "all gain or loss realized on the disposition is recognized (section 469(g)(1)(A))";
}
pub relation related_party_acquirer_267b_707b1(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the taxpayer and the person acquiring the interest bear a relationship described in section 267(b) or 707(b)(1) (section 469(g)(1)(B))";
}
pub relation activity_loss_after_469b(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "any loss from the activity for the taxable year, determined after the application of subsection (b) (section 469(g)(1)(A)(i))";
}
pub relation net_income_or_gain_other_passive_activities_after_469b(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any net income or gain for the taxable year from all other passive activities, determined after the application of subsection (b) (section 469(g)(1)(A)(ii))";
}
pub relation ptp_activity_interest_retained_469k3(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the activity is an activity of a publicly traded partnership and the taxpayer has not disposed of the entire partnership interest (section 469(k)(3))";
}
pub relation disposition_excess_loss_469g(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the activity's loss over the net income or gain from all other passive activities, on a disposition of the entire interest (section 469(g)(1)(A)(i)-(ii))";
}
rule DispositionExcessLossComputation(p: Person, activity: Integer, y: TaxableYear, l: Money, o: Money) defeasible {
    label en official "excess loss = the activity's loss less net income or gain from other passive activities (not below zero) (section 469(g)(1)(A))";
    when disposes_of_entire_interest_in_activity(p, activity, y);
    when not_known(ptp_activity_interest_retained_469k3(p, activity, y));
    when activity_loss_after_469b(p, activity, y, l);
    when net_income_or_gain_other_passive_activities_after_469b(p, y, o);
    when l > max(0.00 USD, o);
    then disposition_excess_loss_469g(p, activity, y, round(l - max(0.00 USD, o), 2, "HALF_UP"));
}
pub relation disposition_loss_treated_as_not_passive(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess loss on a fully taxable disposition of the entire interest is treated as a loss which is not from a passive activity (section 469(g)(1)(A))";
}
@source(IRC_S469_G, quote = "shall be treated as a loss which is not from a passive activity.")
rule FullyTaxableDispositionLossNotPassive(p: Person, activity: Integer, y: TaxableYear, excess: Money) defeasible {
    label en official "on a fully taxable disposition the excess loss is not passive, except where the acquirer is a related person (section 469(g)(1)(A)-(B))";
    when all_gain_or_loss_recognized_on_disposition(p, activity, y);
    when not_known(related_party_acquirer_267b_707b1(p, activity, y));
    when disposition_excess_loss_469g(p, activity, y, excess);
    then disposition_loss_treated_as_not_passive(p, activity, y, excess);
}
pub relation interest_acquired_by_unrelated_person_in_year(p: Person, activity: Integer, y_disposed: TaxableYear, y_acquired: TaxableYear) kind empirical {
    label en official "the interest disposed of to a related person in y_disposed is acquired, in a transaction described in (g)(1)(A), by a person who is not related to the taxpayer in y_acquired (section 469(g)(1)(B))";
}
@source(IRC_S469_G, quote = "then subparagraph (A) shall not apply to any loss of the taxpayer until the taxable year in which such interest is acquired (in a transaction described in subparagraph (A)) by another person who does not bear such a relationship to the taxpayer.")
rule RelatedPartyDispositionLossReleasedOnUnrelatedAcquisition(p: Person, activity: Integer, y_disposed: TaxableYear, y_acquired: TaxableYear, excess: Money) defeasible {
    label en official "a loss deferred by a related-party disposition becomes not passive in the year the interest passes to an unrelated person (section 469(g)(1)(B))";
    when all_gain_or_loss_recognized_on_disposition(p, activity, y_disposed);
    when related_party_acquirer_267b_707b1(p, activity, y_disposed);
    when disposition_excess_loss_469g(p, activity, y_disposed, excess);
    when interest_acquired_by_unrelated_person_in_year(p, activity, y_disposed, y_acquired);
    then disposition_loss_treated_as_not_passive(p, activity, y_acquired, excess);
}
pub relation interest_transferred_by_death(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "an interest in the activity is transferred by reason of the death of the taxpayer (section 469(g)(2))";
}
pub relation transferee_basis_in_interest(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the basis of the property in the hands of the transferee (section 469(g)(2)(A)(i))";
}
pub relation decedent_adjusted_basis_immediately_before_death(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis of the property immediately before the death of the taxpayer (section 469(g)(2)(A)(ii))";
}
pub relation basis_step_up_469g2(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess (if any) of the transferee's basis over the decedent's adjusted basis immediately before death (section 469(g)(2)(A))";
}
rule BasisStepUpComputation(p: Person, activity: Integer, y: TaxableYear, tb: Money, ab: Money) strict {
    label en official "the basis step-up on death is transferee basis minus decedent adjusted basis, not below zero (section 469(g)(2)(A))";
    when interest_transferred_by_death(p, activity, y);
    when transferee_basis_in_interest(p, activity, y, tb);
    when decedent_adjusted_basis_immediately_before_death(p, activity, y, ab);
    then basis_step_up_469g2(p, activity, y, max(0.00 USD, round(tb - ab, 2, "HALF_UP")));
}
pub relation death_loss_treated_as_not_passive(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "on a transfer by death, the (g)(1)(A) losses greater than the basis step-up are treated as not from a passive activity (section 469(g)(2)(A))";
}
@source(IRC_S469_G, quote = "paragraph (1)(A) shall apply to losses described in paragraph (1)(A) to the extent such losses are greater than the excess (if any) of—")
rule DeathTransferLossNotPassiveBeyondStepUp(p: Person, activity: Integer, y: TaxableYear, excess: Money, stepup: Money) defeasible {
    label en official "on death only the loss exceeding the basis step-up is treated as not passive (section 469(g)(2)(A))";
    when disposition_excess_loss_469g(p, activity, y, excess);
    when basis_step_up_469g2(p, activity, y, stepup);
    when excess > stepup;
    then death_loss_treated_as_not_passive(p, activity, y, round(excess - stepup, 2, "HALF_UP"));
}
pub relation death_loss_disallowed_to_extent_of_step_up(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "losses to the extent of the basis step-up are not allowed as a deduction for any taxable year (section 469(g)(2)(B))";
}
@source(IRC_S469_G, quote = "any losses to the extent of the excess described in subparagraph (A) shall not be allowed as a deduction for any taxable year.")
rule DeathTransferLossDisallowedToExtentOfStepUp(p: Person, activity: Integer, y: TaxableYear, excess: Money, stepup: Money) defeasible {
    label en official "losses up to the basis step-up are never allowed (section 469(g)(2)(B))";
    when disposition_excess_loss_469g(p, activity, y, excess);
    when basis_step_up_469g2(p, activity, y, stepup);
    then death_loss_disallowed_to_extent_of_step_up(p, activity, y, min(excess, stepup));
}
pub relation installment_sale_of_entire_interest_453(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the taxpayer sells the entire interest in the activity in an installment sale to which section 453 applies (section 469(g)(3))";
}
pub relation total_losses_from_activity_469g3(p: Person, activity: Integer, amount: Money) kind empirical {
    label en official "all losses from the activity to which (g)(1) would apply (section 469(g)(3))";
}
pub relation gain_recognized_on_installment_sale_in_year(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gain recognized on the installment sale during the taxable year (section 469(g)(3))";
}
pub relation gross_profit_from_installment_sale_469g3(p: Person, activity: Integer, amount: Money) kind empirical {
    label en official "the gross profit from the sale, realized or to be realized when payment is completed (section 469(g)(3))";
}
pub relation installment_loss_portion_treated_as_not_passive(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the losses for the taxable year to which (g)(1) applies: total losses times recognized gain over gross profit (section 469(g)(3))";
}
@source(IRC_S469_G, quote = "paragraph (1) shall apply to the portion of such losses for each taxable year which bears the same ratio to all such losses as the gain recognized on such sale during such taxable year bears to the gross profit from such sale")
rule InstallmentSaleLossPortionRatio(p: Person, activity: Integer, y: TaxableYear, total: Money, gain: Money, gp: Money) defeasible {
    label en official "on an installment sale of the entire interest, the same ratio of losses is released each year as gain bears to gross profit (section 469(g)(3)); one rounding, cents HALF_UP (JUDGMENT CALL: the statute names no rounding)";
    when installment_sale_of_entire_interest_453(p, activity, y);
    when total_losses_from_activity_469g3(p, activity, total);
    when gain_recognized_on_installment_sale_in_year(p, activity, y, gain);
    when gross_profit_from_installment_sale_469g3(p, activity, gp);
    when gp > 0.00 USD;
    then installment_loss_portion_treated_as_not_passive(p, activity, y, div_round(total * (gain / 1.00 USD), gp / 1.00 USD, 2, "HALF_UP"));
}
// (j)(6), (j)(12): gifts and distributions by estates or trusts.
pub relation disposition_of_interest_by_gift(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the taxpayer disposes of an interest in a passive activity by gift (section 469(j)(6))";
}
pub relation distribution_of_interest_by_estate_or_trust(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "an interest in a passive activity is distributed by an estate or trust (section 469(j)(12))";
}
pub relation disallowed_passive_losses_allocable_to_interest(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "passive activity losses allocable to the interest for which a deduction was not allowed by reason of subsection (a)";
}
pub relation basis_increase_for_suspended_losses_469j(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the basis of the interest immediately before the gift or distribution is increased by the suspended passive losses allocable to it (section 469(j)(6)(A), (j)(12)(A))";
}
@source(IRC_S469_J, quote = "the basis of such interest immediately before the transfer shall be increased by the amount of any passive activity losses allocable to such interest")
rule BasisIncreaseOnGift(p: Person, activity: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a gift of a passive activity interest increases its basis by suspended losses (section 469(j)(6)(A))";
    when disposition_of_interest_by_gift(p, activity, y);
    when disallowed_passive_losses_allocable_to_interest(p, activity, y, amount);
    then basis_increase_for_suspended_losses_469j(p, activity, y, amount);
}
@source(IRC_S469_J, quote = "the basis of such interest immediately before such distribution shall be increased by the amount of any passive activity losses allocable to such interest, and")
rule BasisIncreaseOnEstateTrustDistribution(p: Person, activity: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a distribution by an estate or trust increases the interest's basis by suspended losses (section 469(j)(12)(A))";
    when distribution_of_interest_by_estate_or_trust(p, activity, y);
    when disallowed_passive_losses_allocable_to_interest(p, activity, y, amount);
    then basis_increase_for_suspended_losses_469j(p, activity, y, amount);
}
pub relation suspended_losses_never_allowable(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the suspended losses are not allowable as a deduction for any taxable year (section 469(j)(6)(B), (j)(12)(B))";
}
rule SuspendedLossesDisallowedAfterGift(p: Person, activity: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "after a gift, the suspended losses are never deductible (section 469(j)(6)(B))";
    when basis_increase_for_suspended_losses_469j(p, activity, y, amount);
    then suspended_losses_never_allowable(p, activity, y, amount);
}
// (j)(9): election to increase basis by a disallowed credit.
pub relation elects_basis_increase_for_unused_credit_469j9(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the transferor elects to increase the basis of the property by the unused credit that reduced its basis (section 469(j)(9))";
}
pub relation unused_credit_which_reduced_basis(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of any unused credit allowable under chapter 1 which reduced the basis of the property in the year the credit arose (section 469(j)(9))";
}
pub relation unused_credit_basis_increase_elected(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the section 469(j)(9) election is in effect for the disposition";
}
@source(IRC_S469_J, quote = "the transferor may elect to increase the basis of such property immediately before the transfer by an amount equal to the portion of any unused credit")
rule Section469J9BasisIncreaseElectionPower(p: Person, activity: Integer, y: TaxableYear) strict {
    label en official "on a disposition to which (g)(1) applies, the transferor may elect to increase basis by the unused credit that reduced basis (section 469(j)(9))";
    when elects_basis_increase_for_unused_credit_469j9(p, activity, y);
    then power Section469J9BasisIncreaseElection {
        holder p;
        over activity;
        exercise elects_basis_increase_for_unused_credit_469j9(p, activity, y);
        valid_when disposition_loss_treated_as_not_passive(p, activity, y, _);
        effect create(unused_credit_basis_increase_elected(p, activity, y));
        window [@1987-01-01, infinity);
    };
}
pub relation basis_increase_for_unused_credit_469j9(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the basis increase equal to the unused credit that reduced the property's basis (section 469(j)(9), first sentence)";
}
rule BasisIncreaseForUnusedCredit(p: Person, activity: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "with the election, the basis rises by the credit portion that reduced basis (section 469(j)(9))";
    when unused_credit_basis_increase_elected(p, activity, y);
    when unused_credit_which_reduced_basis(p, activity, y, amount);
    then basis_increase_for_unused_credit_469j9(p, activity, y, amount);
}
pub relation elected_credit_portion_disallowed(p: Person, activity: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "that portion of the passive activity credit is not allowed for any taxable year (section 469(j)(9), second sentence)";
}
rule ElectedCreditPortionNeverAllowed(p: Person, activity: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the portion of the credit used for the basis increase is never allowed (section 469(j)(9))";
    when basis_increase_for_unused_credit_469j9(p, activity, y, amount);
    then elected_credit_portion_disallowed(p, activity, y, amount);
}

// --- (h): material participation ---

pub relation holds_limited_partner_interest_in_limited_partnership(p: Person, activity: Integer) kind empirical {
    label en official "the taxpayer's interest in the activity is an interest in a limited partnership as a limited partner (section 469(h)(2))";
}
external judgment relation regulations_treat_limited_partner_as_materially_participating(p: Person, activity: Integer, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary's regulations provide that the limited-partner interest is one with respect to which the taxpayer materially participates (section 469(h)(2), 'except as provided in regulations')";
}
@source(IRC_S469_H, quote = "no interest in a limited partnership as a limited partner shall be treated as an interest with respect to which a taxpayer materially participates.")
rule LimitedPartnerInterestIsPassive(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a limited partner's interest in a trade or business is never treated as materially participated in, except as regulations provide (section 469(h)(2))";
    when is_trade_or_business_for_469(p, activity);
    when holds_limited_partner_interest_in_limited_partnership(p, activity);
    when us.irc.core::year_of(p, y);
    unless regulations_treat_limited_partner_as_materially_participating(p, activity, y);
    then is_passive_activity(p, activity, y);
}
pub relation farming_activity_469(p: Person, activity: Integer) kind empirical {
    label en official "the activity is a farming activity (section 469(h)(3))";
}
pub relation section_2032A_b_4_or_5_would_satisfy_material_participation(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "paragraph (4) or (5) of section 2032A(b) would cause the requirements of section 2032A(b)(1)(C)(ii) to be met for real property used in the activity if the taxpayer had died during the taxable year (section 469(h)(3)) — the section 2032A(b) test is an EXTERNAL_DEPENDENCY on the estate-gift owner";
}
pub relation shareholders_participating_stock_percent_469h4(p: Person, activity: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the percentage (by value) of the corporation's outstanding stock held by shareholders who materially participate in the activity (section 469(h)(4)(A))";
}
pub relation requirements_465c7C_met_without_iv(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the requirements of section 465(c)(7)(C), without regard to clause (iv), are met with respect to the activity (section 469(h)(4)(B)) — section 465(c)(7) is not formalized in this package";
}
pub relation deemed_materially_participating_469h(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the taxpayer is treated as materially participating in the activity for the taxable year by force of section 469(h)(3) or (h)(4)";
}
@source(IRC_S469_H, quote = "A taxpayer shall be treated as materially participating in any farming activity for a taxable year")
rule RetiredOrSurvivingSpouseFarmingDeemedMaterial(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a retired individual or surviving spouse who would satisfy section 2032A(b)(4)/(5) is treated as materially participating in farming (section 469(h)(3))";
    when farming_activity_469(p, activity);
    when section_2032A_b_4_or_5_would_satisfy_material_participation(p, activity, y);
    then deemed_materially_participating_469h(p, activity, y);
}
@source(IRC_S469_H, quote = "1 or more shareholders holding stock representing more than 50 percent (by value) of the outstanding stock of such corporation materially participate in such activity, or")
rule CorporationDeemedMaterialByMajorityShareholders(p: Person, activity: Integer, y: TaxableYear, pct: Decimal) defeasible {
    label en official "a closely held C corporation or personal service corporation materially participates if shareholders holding more than 50 percent by value do (section 469(h)(4)(A))";
    when person_described_in_469a2(p);
    when shareholders_participating_stock_percent_469h4(p, activity, y, pct);
    when pct > 50.0;
    then deemed_materially_participating_469h(p, activity, y);
}
@source(IRC_S469_H, quote = "in the case of a closely held C corporation (other than a personal service corporation), the requirements of section 465(c)(7)(C) (without regard to clause (iv)) are met with respect to such activity.")
rule CloselyHeldCorporationDeemedMaterialBy465c7C(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a closely held C corporation that is not a personal service corporation materially participates if the section 465(c)(7)(C) requirements are met (section 469(h)(4)(B))";
    when is_closely_held_c_corporation_469(p);
    when not_known(is_personal_service_corporation_469j2(p));
    when requirements_465c7C_met_without_iv(p, activity, y);
    then deemed_materially_participating_469h(p, activity, y);
}
@source(IRC_S469_H, quote = "A closely held C corporation or personal service corporation shall be treated as materially participating in an activity only if—")
rule CorporationNotDeemedMaterialIsPassive(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a closely held C corporation or personal service corporation materially participates ONLY if (h)(4)(A) or (B) is met; otherwise its trade-or-business activity is passive whatever the general judgment (section 469(h)(4))";
    when is_trade_or_business_for_469(p, activity);
    when person_described_in_469a2(p);
    when not_known(is_individual_estate_or_trust_469(p));
    when us.irc.core::year_of(p, y);
    unless deemed_materially_participating_469h(p, activity, y);
    then is_passive_activity(p, activity, y);
}

// --- (i)(3)(B)-(E), (4)-(6): offset components, ordering, estates, MFS ---

pub enum PassiveOffsetComponent {
    PassiveLoss;
    CreditOther;
    CreditRehabilitation47;
    CreditLowIncomeHousing42;
    label en official "the components to which the section 469(i)(1) offset is applied in the (3)(D) order: the passive activity loss, other credits, the rehabilitation credit (section 47), the low-income housing credit (section 42)";
}
pub relation portion_attributable_to_active_rental_real_estate_469i(p: Person, y: TaxableYear, c: PassiveOffsetComponent, amount: Money) kind empirical {
    label en official "the portion of the passive activity loss, or the deduction equivalent ((j)(5)) of the passive activity credit of the component, attributable to rental real estate activities in which the individual actively participated (section 469(i)(1))";
}
pub relation married_filing_separate_return_469i(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer is a married individual filing a separate return for the taxable year (section 469(i)(5))";
}
pub relation lived_apart_from_spouse_at_all_times_469i(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer lives apart from the spouse at all times during the taxable year (section 469(i)(5)(B))";
}
pub relation estate_year_within_two_years_of_death_469i4(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year of an estate ends less than 2 years after the date of the decedent's death (section 469(i)(4)(A))";
}
pub relation surviving_spouse_exemption_amount_469i4B(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the exemption under (i)(1), without regard to (i)(3), allowable to the surviving spouse for the taxable year ending with or within the estate's taxable year (section 469(i)(4)(B))";
}
pub relation section_469i_not_applicable_to_taxpayer(p: Person, y: TaxableYear) kind institutional {
    label en official "section 469(i) does not apply: a married individual filing a separate return who does not live apart from the spouse at all times (section 469(i)(5)(B))";
}
@source(IRC_S469_I, quote = "This subsection shall not apply to a taxpayer who—")
rule Section469iNotApplicableMfsNotApart(p: Person, y: TaxableYear) defeasible {
    label en official "a married individual filing separately who does not live apart at all times gets no (i) offset (section 469(i)(5)(B))";
    when married_filing_separate_return_469i(p, y);
    when not_known(lived_apart_from_spouse_at_all_times_469i(p, y));
    then section_469i_not_applicable_to_taxpayer(p, y);
}
pub relation section_469i_base_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the (i)(2) dollar amount for the taxpayer: $25,000; $12,500 for a married individual filing separately and living apart ((i)(5)(A)(i)); reduced by the surviving spouse's exemption for an estate ((i)(4)(B))";
}
rule Section469iBaseAmountOrdinary(p: Person, y: TaxableYear) defeasible {
    label en official "ordinary taxpayers use the $25,000 amount (section 469(i)(2))";
    when us.irc.core::year_of(p, y);
    when not_known(married_filing_separate_return_469i(p, y));
    when not_known(estate_year_within_two_years_of_death_469i4(p, y));
    then section_469i_base_amount(p, y, round(PassiveActivityOffsetDollarLimit, 2, "HALF_UP"));
}
@source(IRC_S469_I, quote = "(i) \"$12,500\" for \"$25,000\" each place it appears,")
rule Section469iBaseAmountMarriedSeparateApart(p: Person, y: TaxableYear) defeasible {
    label en official "a married individual filing separately and living apart at all times uses $12,500 (section 469(i)(5)(A)(i))";
    when married_filing_separate_return_469i(p, y);
    when lived_apart_from_spouse_at_all_times_469i(p, y);
    then section_469i_base_amount(p, y, round(PassiveActivityOffsetDollarLimitMarriedSeparate, 2, "HALF_UP"));
}
@source(IRC_S469_I, quote = "the $25,000 amount under paragraph (2) shall be reduced by the amount of the exemption under paragraph (1) (without regard to paragraph (3)) allowable to the surviving spouse of the decedent")
rule Section469iBaseAmountEstate(p: Person, y: TaxableYear, spouse: Money) defeasible {
    label en official "an estate's $25,000 is reduced by the surviving spouse's exemption (section 469(i)(4)(B)); not below zero";
    when estate_year_within_two_years_of_death_469i4(p, y);
    when surviving_spouse_exemption_amount_469i4B(p, y, spouse);
    then section_469i_base_amount(p, y, max(0.00 USD, round(PassiveActivityOffsetDollarLimit - spouse, 2, "HALF_UP")));
}
pub relation agi_before_469i_adjustments(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "adjusted gross income as otherwise determined, before the section 469(i)(3)(E) adjustments";
}
pub relation section_86_inclusion_469i3E(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any amount includible in gross income under section 86 (section 469(i)(3)(E)(i))";
}
pub relation excluded_amounts_85c_135_137_469i3E(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amounts excludable from gross income under sections 85(c), 135, and 137 (section 469(i)(3)(E)(ii))";
}
pub relation deductions_219_221_250_469i3E(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amounts allowable as a deduction under sections 219, 221, and 250 (section 469(i)(3)(E)(iii))";
}
pub relation passive_loss_and_469c7_loss_469i3E(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any passive activity loss or loss allowable by reason of subsection (c)(7) (section 469(i)(3)(E)(iv))";
}
pub relation modified_agi_469i3E(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted gross income for the (i)(3) phase-out, determined without regard to the (E)(i)-(iv) items (JUDGMENT CALL: 'without regard to' reads as ignoring the section 86 inclusion and adding back excluded amounts, the (iii) deductions and the (iv) losses)";
}
@source(IRC_S469_I, quote = "For purposes of this paragraph, adjusted gross income shall be determined without regard to—")
rule ModifiedAgi469i3E(p: Person, y: TaxableYear, agi: Money, s86: Money, ex: Money, ded: Money, loss: Money) strict {
    label en official "AGI for the phase-out ignores the section 86 inclusion, and the (ii)-(iv) exclusions, deductions, and losses (section 469(i)(3)(E))";
    when agi_before_469i_adjustments(p, y, agi);
    when section_86_inclusion_469i3E(p, y, s86);
    when excluded_amounts_85c_135_137_469i3E(p, y, ex);
    when deductions_219_221_250_469i3E(p, y, ded);
    when passive_loss_and_469c7_loss_469i3E(p, y, loss);
    then modified_agi_469i3E(p, y, round(agi - s86 + ex + ded + loss, 2, "HALF_UP"));
}
pub relation section_469i_component_threshold(p: Person, y: TaxableYear, c: PassiveOffsetComponent, amount: Money) kind institutional {
    label en official "the AGI threshold above which the (i)(2) amount phases out for the component: $100,000 (loss, other credits); $200,000 for the rehabilitation credit ((i)(3)(B)); halved for a married individual filing separately ((i)(5)(A)(ii)-(iii))";
}
rule ThresholdLossOrdinary(p: Person, y: TaxableYear) defeasible {
    label en official "$100,000 threshold for the passive loss (section 469(i)(3)(A))";
    when us.irc.core::year_of(p, y);
    when not_known(married_filing_separate_return_469i(p, y));
    then section_469i_component_threshold(p, y, PassiveLoss, round(PassiveActivityOffsetAgiThreshold, 2, "HALF_UP"));
}
rule ThresholdCreditOtherOrdinary(p: Person, y: TaxableYear) defeasible {
    label en official "$100,000 threshold for other credits (section 469(i)(3)(A), (D)(ii))";
    when us.irc.core::year_of(p, y);
    when not_known(married_filing_separate_return_469i(p, y));
    then section_469i_component_threshold(p, y, CreditOther, round(PassiveActivityOffsetAgiThreshold, 2, "HALF_UP"));
}
@source(IRC_S469_I, quote = "In the case of any portion of the passive activity credit for any taxable year which is attributable to the rehabilitation credit determined under section 47, subparagraph (A) shall be applied by substituting \"$200,000\" for \"$100,000\".")
rule ThresholdRehabilitationOrdinary(p: Person, y: TaxableYear) defeasible {
    label en official "$200,000 threshold for the section 47 rehabilitation credit (section 469(i)(3)(B))";
    when us.irc.core::year_of(p, y);
    when not_known(married_filing_separate_return_469i(p, y));
    then section_469i_component_threshold(p, y, CreditRehabilitation47, round(PassiveActivityRehabAgiThreshold, 2, "HALF_UP"));
}
rule ThresholdLossMarriedSeparate(p: Person, y: TaxableYear) defeasible {
    label en official "$50,000 threshold for a married individual filing separately (section 469(i)(5)(A)(ii))";
    when married_filing_separate_return_469i(p, y);
    then section_469i_component_threshold(p, y, PassiveLoss, round(PassiveActivityOffsetAgiThresholdMarriedSeparate, 2, "HALF_UP"));
}
rule ThresholdCreditOtherMarriedSeparate(p: Person, y: TaxableYear) defeasible {
    label en official "$50,000 threshold for other credits of a married individual filing separately (section 469(i)(5)(A)(ii))";
    when married_filing_separate_return_469i(p, y);
    then section_469i_component_threshold(p, y, CreditOther, round(PassiveActivityOffsetAgiThresholdMarriedSeparate, 2, "HALF_UP"));
}
rule ThresholdRehabilitationMarriedSeparate(p: Person, y: TaxableYear) defeasible {
    label en official "$100,000 threshold for the rehabilitation credit of a married individual filing separately (section 469(i)(5)(A)(iii))";
    when married_filing_separate_return_469i(p, y);
    then section_469i_component_threshold(p, y, CreditRehabilitation47, round(PassiveActivityRehabAgiThresholdMarriedSeparate, 2, "HALF_UP"));
}
pub relation section_469i_component_ceiling(p: Person, y: TaxableYear, c: PassiveOffsetComponent, amount: Money) kind institutional {
    label en official "the ceiling on the amount of the component the offset can reach: the base amount less 50 percent of modified AGI over the component threshold; the low-income housing credit is not phased out ((i)(3)(A)-(C))";
}
rule ComponentCeilingPhasedOut(p: Person, y: TaxableYear, c: PassiveOffsetComponent, base: Money, threshold: Money, agi: Money) defeasible {
    label en official "the ceiling is the base amount reduced by half of AGI above the threshold, within [0, base] (section 469(i)(3)(A)-(B))";
    when not_known(section_469i_not_applicable_to_taxpayer(p, y));
    when section_469i_base_amount(p, y, base);
    when section_469i_component_threshold(p, y, c, threshold);
    when modified_agi_469i3E(p, y, agi);
    then section_469i_component_ceiling(p, y, c, max(0.00 USD, min(base, round(base - round((agi - threshold) * 0.5, 2, "HALF_UP"), 2, "HALF_UP"))));
}
@source(IRC_S469_I, quote = "Subparagraph (A) shall not apply to any portion of the passive activity credit for any taxable year which is attributable to any credit determined under section 42.")
rule ComponentCeilingLowIncomeHousingNotPhasedOut(p: Person, y: TaxableYear, base: Money) defeasible {
    label en official "the low-income housing credit portion keeps the full base amount; no phase-out (section 469(i)(3)(C))";
    when not_known(section_469i_not_applicable_to_taxpayer(p, y));
    when section_469i_base_amount(p, y, base);
    then section_469i_component_ceiling(p, y, CreditLowIncomeHousing42, base);
}
pub relation offset_applied_to_passive_loss_469i(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the passive activity loss to which the (i)(1) offset applies, first in the (3)(D) order (JUDGMENT CALL: each component is bounded by its own ceiling less the amounts applied to the earlier components)";
}
pub relation offset_applied_to_other_credits_469i(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction equivalent of other passive credits to which the offset applies, second in the (3)(D) order";
}
pub relation offset_applied_to_rehabilitation_credit_469i(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction equivalent of the section 47 rehabilitation credit to which the offset applies, third in the (3)(D) order";
}
pub relation offset_applied_to_low_income_housing_credit_469i(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction equivalent of the section 42 low-income housing credit to which the offset applies, last in the (3)(D) order";
}
@source(IRC_S469_I, quote = "(i) first, to the passive activity loss,")
rule OffsetAppliedFirstToPassiveLoss(p: Person, y: TaxableYear, attributable: Money, ceiling: Money) defeasible {
    label en official "the offset applies first to the passive activity loss (section 469(i)(3)(D)(i))";
    when portion_attributable_to_active_rental_real_estate_469i(p, y, PassiveLoss, attributable);
    when section_469i_component_ceiling(p, y, PassiveLoss, ceiling);
    then offset_applied_to_passive_loss_469i(p, y, min(attributable, ceiling));
}
@source(IRC_S469_I, quote = "(ii) second, to the portion of the passive activity credit to which subparagraph (B) and [1] (C) does not apply,")
rule OffsetAppliedSecondToOtherCredits(p: Person, y: TaxableYear, attributable: Money, ceiling: Money, used_loss: Money) defeasible {
    label en official "then to the credits to which neither (B) nor (C) applies (section 469(i)(3)(D)(ii))";
    when portion_attributable_to_active_rental_real_estate_469i(p, y, CreditOther, attributable);
    when section_469i_component_ceiling(p, y, CreditOther, ceiling);
    when offset_applied_to_passive_loss_469i(p, y, used_loss);
    then offset_applied_to_other_credits_469i(p, y, min(attributable, max(0.00 USD, round(ceiling - used_loss, 2, "HALF_UP"))));
}
@source(IRC_S469_I, quote = "(iii) third, to the portion of such credit to which subparagraph (B) applies, and")
rule OffsetAppliedThirdToRehabilitationCredit(p: Person, y: TaxableYear, attributable: Money, ceiling: Money, used_loss: Money, used_other: Money) defeasible {
    label en official "then to the rehabilitation credit (section 469(i)(3)(D)(iii))";
    when portion_attributable_to_active_rental_real_estate_469i(p, y, CreditRehabilitation47, attributable);
    when section_469i_component_ceiling(p, y, CreditRehabilitation47, ceiling);
    when offset_applied_to_passive_loss_469i(p, y, used_loss);
    when offset_applied_to_other_credits_469i(p, y, used_other);
    then offset_applied_to_rehabilitation_credit_469i(p, y, min(attributable, max(0.00 USD, round(ceiling - used_loss - used_other, 2, "HALF_UP"))));
}
@source(IRC_S469_I, quote = "(iv) then, to the portion of such credit to which subparagraph (C) applies.")
rule OffsetAppliedFourthToLowIncomeHousingCredit(p: Person, y: TaxableYear, attributable: Money, ceiling: Money, used_loss: Money, used_other: Money, used_rehab: Money) defeasible {
    label en official "finally to the low-income housing credit (section 469(i)(3)(D)(iv))";
    when portion_attributable_to_active_rental_real_estate_469i(p, y, CreditLowIncomeHousing42, attributable);
    when section_469i_component_ceiling(p, y, CreditLowIncomeHousing42, ceiling);
    when offset_applied_to_passive_loss_469i(p, y, used_loss);
    when offset_applied_to_other_credits_469i(p, y, used_other);
    when offset_applied_to_rehabilitation_credit_469i(p, y, used_rehab);
    then offset_applied_to_low_income_housing_credit_469i(p, y, min(attributable, max(0.00 USD, round(ceiling - used_loss - used_other - used_rehab, 2, "HALF_UP"))));
}
// (i)(6): active participation.
pub relation minimum_interest_percent_by_value_in_rental_activity(p: Person, activity: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the smallest percentage (by value) of all interests in the activity that the taxpayer's interest (including the spouse's) represented at any time during the period (section 469(i)(6)(A))";
}
pub relation holds_limited_partner_interest_for_469i6C(p: Person, activity: Integer) kind empirical {
    label en official "the taxpayer's interest is an interest as a limited partner in a limited partnership (section 469(i)(6)(C))";
}
external judgment relation regulations_allow_limited_partner_active_participation(p: Person, activity: Integer, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary's regulations treat the limited-partner interest as one in which the taxpayer actively participates (section 469(i)(6)(C), 'except as provided in regulations')";
}
pub relation active_participation_disqualified_469i6(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the individual is not treated as actively participating in the interest: under 10 percent by value at any time in the period ((6)(A)) or a limited-partner interest ((6)(C))";
}
@source(IRC_S469_I, quote = "An individual shall not be treated as actively participating with respect to any interest in any rental real estate activity for any period if, at any time during such period, such interest (including any interest of the spouse of the individual) is less than 10 percent (by value) of all interests in such activity.")
rule ActiveParticipationDisqualifiedUnderTenPercent(p: Person, activity: Integer, y: TaxableYear, pct: Decimal) defeasible {
    label en official "an interest under 10 percent by value at any time in the period is not active participation (section 469(i)(6)(A))";
    when minimum_interest_percent_by_value_in_rental_activity(p, activity, y, pct);
    when pct < 10.0;
    then active_participation_disqualified_469i6(p, activity, y);
}
@source(IRC_S469_I, quote = "Except as provided in regulations, no interest as a limited partner in a limited partnership shall be treated as an interest with respect to which the taxpayer actively participates.")
rule ActiveParticipationDisqualifiedLimitedPartner(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a limited-partner interest is not active participation except as regulations provide (section 469(i)(6)(C))";
    when holds_limited_partner_interest_for_469i6C(p, activity);
    when us.irc.core::year_of(p, y);
    unless regulations_allow_limited_partner_active_participation(p, activity, y);
    then active_participation_disqualified_469i6(p, activity, y);
}
pub relation active_participation_requirement_waived(p: Person, y: TaxableYear, c: PassiveOffsetComponent) kind institutional {
    label en official "the active participation requirement does not apply to the section 42 or section 47 credit component (section 469(i)(6)(B))";
}
@source(IRC_S469_I, quote = "Paragraphs (1) and (4)(A) shall be applied without regard to the active participation requirement in the case of—")
rule ParticipationWaivedLowIncomeHousing(p: Person, y: TaxableYear) defeasible {
    label en official "no active participation is required for the section 42 credit component (section 469(i)(6)(B)(i))";
    when portion_attributable_to_active_rental_real_estate_469i(p, y, CreditLowIncomeHousing42, _);
    then active_participation_requirement_waived(p, y, CreditLowIncomeHousing42);
}
rule ParticipationWaivedRehabilitation(p: Person, y: TaxableYear) defeasible {
    label en official "no active participation is required for the section 47 credit component (section 469(i)(6)(B)(ii))";
    when portion_attributable_to_active_rental_real_estate_469i(p, y, CreditRehabilitation47, _);
    then active_participation_requirement_waived(p, y, CreditRehabilitation47);
}

// --- (k): publicly traded partnerships ---

pub relation partnership_interests_traded_on_established_securities_market(ptp: Person) kind empirical {
    label en official "interests in the partnership are traded on an established securities market (section 469(k)(2)(A))";
}
pub relation partnership_interests_readily_tradable_on_secondary_market(ptp: Person) kind empirical {
    label en official "interests in the partnership are readily tradable on a secondary market or the substantial equivalent (section 469(k)(2)(B))";
}
pub relation is_publicly_traded_partnership_469k2(ptp: Person) kind institutional {
    label en official "the partnership is a publicly traded partnership for section 469 (section 469(k)(2))";
}
@source(IRC_S469_K, quote = "interests in such partnership are traded on an established securities market, or")
rule PubliclyTradedPartnershipEstablishedMarket(ptp: Person) defeasible {
    label en official "a partnership whose interests are traded on an established securities market is publicly traded (section 469(k)(2)(A))";
    when partnership_interests_traded_on_established_securities_market(ptp);
    then is_publicly_traded_partnership_469k2(ptp);
}
@source(IRC_S469_K, quote = "interests in such partnership are readily tradable on a secondary market (or the substantial equivalent thereof).")
rule PubliclyTradedPartnershipSecondaryMarket(ptp: Person) defeasible {
    label en official "a partnership whose interests are readily tradable on a secondary market is publicly traded (section 469(k)(2)(B))";
    when partnership_interests_readily_tradable_on_secondary_market(ptp);
    then is_publicly_traded_partnership_469k2(ptp);
}
pub relation holds_interest_in_publicly_traded_partnership(p: Person, ptp: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has items attributable to a publicly traded partnership for the taxable year (section 469(k)(1))";
}
pub relation section_469_applied_separately_to_ptp_items(p: Person, ptp: Person, y: TaxableYear) kind institutional {
    label en official "section 469 is applied separately to the items attributable to the publicly traded partnership, and subsection (i) does not apply to them (section 469(k)(1))";
}
@source(IRC_S469_K, quote = "This section shall be applied separately with respect to items attributable to each publicly traded partnership")
rule PtpItemsSeparateApplication(p: Person, ptp: Person, y: TaxableYear) defeasible {
    label en official "each publicly traded partnership's items are a separate section 469 basket without the (i) offset (section 469(k)(1))";
    when holds_interest_in_publicly_traded_partnership(p, ptp, y);
    when is_publicly_traded_partnership_469k2(ptp);
    then section_469_applied_separately_to_ptp_items(p, ptp, y);
}
pub relation ptp_credit_42_or_47(p: Person, ptp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 42 or section 47 credit attributable to the publicly traded partnership (section 469(k)(1), second sentence)";
}
pub relation ptp_regular_tax_liability_attributable_to_income(p: Person, ptp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the regular tax liability attributable to income from the publicly traded partnership (section 469(k)(1), second sentence)";
}
pub relation ptp_credit_outside_separate_application(p: Person, ptp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of a section 42 or 47 PTP credit exceeding the regular tax attributable to PTP income, to which the separate-application sentence does not apply (section 469(k)(1))";
}
@source(IRC_S469_K, quote = "The preceding sentence shall not apply to any credit determined under section 42, or any rehabilitation credit determined under section 47, attributable to a publicly traded partnership to the extent the amount of any such credits exceeds the regular tax liability attributable to income from such partnership.")
rule PtpCreditExcessOutsideSeparateApplication(p: Person, ptp: Person, y: TaxableYear, credit: Money, liability: Money) strict {
    label en official "the excess of a PTP section 42/47 credit over the tax attributable to PTP income is outside the separate application (section 469(k)(1))";
    when ptp_credit_42_or_47(p, ptp, y, credit);
    when ptp_regular_tax_liability_attributable_to_income(p, ptp, y, liability);
    when credit > liability;
    then ptp_credit_outside_separate_application(p, ptp, y, round(credit - liability, 2, "HALF_UP"));
}
pub relation activity_of_publicly_traded_partnership(activity: Integer, ptp: Person) kind empirical {
    label en official "the activity is an activity of the publicly traded partnership (section 469(k)(3))";
}
pub relation retains_interest_in_partnership(p: Person, ptp: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has not disposed of the entire interest in the partnership as of the end of the disposition (section 469(k)(3))";
}
@source(IRC_S469_K, quote = "a taxpayer shall not be treated as having disposed of his entire interest in an activity of a publicly traded partnership until he disposes of his entire interest in such partnership.")
rule PtpActivityInterestRetainedUntilPartnershipInterestDisposed(p: Person, activity: Integer, y: TaxableYear, ptp: Person) defeasible {
    label en official "for (g), an activity of a PTP is not disposed of until the whole partnership interest is (section 469(k)(3))";
    when activity_of_publicly_traded_partnership(activity, ptp);
    when retains_interest_in_partnership(p, ptp, y);
    when us.irc.core::year_of(p, y);
    then ptp_activity_interest_retained_469k3(p, activity, y);
}
pub relation is_regulated_investment_company_851(p: Person) kind empirical {
    label en official "the taxpayer is a regulated investment company as defined in section 851";
}
pub relation is_qualified_publicly_traded_partnership_851h(ptp: Person) kind empirical {
    label en official "the partnership is a qualified publicly traded partnership as defined in section 851(h)";
}
pub relation ric_treated_as_469a2_person_for_ptp_items(p: Person, ptp: Person, y: TaxableYear) kind institutional {
    label en official "a regulated investment company holding an interest in a qualified publicly traded partnership is treated as a section 469(a)(2) taxpayer for the items attributable to it (section 469(k)(4))";
}
@source(IRC_S469_K, quote = "a regulated investment company (as defined in section 851) holding an interest in a qualified publicly traded partnership (as defined in section 851(h)) shall be treated as a taxpayer described in subsection (a)(2) with respect to items attributable to such interest.")
rule RicTreatedAsSection469aPersonForPtp(p: Person, ptp: Person, y: TaxableYear) defeasible {
    label en official "a RIC holding a qualified PTP interest is a section 469(a)(2) taxpayer as to those items (section 469(k)(4))";
    when is_regulated_investment_company_851(p);
    when is_qualified_publicly_traded_partnership_851h(ptp);
    when holds_interest_in_publicly_traded_partnership(p, ptp, y);
    then ric_treated_as_469a2_person_for_ptp_items(p, ptp, y);
}

// (j)(11): members of a consolidated affiliated group.
pub relation member_of_consolidated_affiliated_group(p: Person, g: Integer, y: TaxableYear) kind empirical {
    label en official "the corporation is a member of an affiliated group filing a consolidated return for the taxable year (section 469(j)(11))";
}
external judgment relation regulations_except_from_single_corporation_469j11(p: Person, q: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary's regulations provide otherwise for the aggregation of members of an affiliated group (section 469(j)(11), 'except as provided in regulations')";
}
pub relation members_treated_as_one_corporation_469j11(p: Person, q: Person, y: TaxableYear) kind institutional {
    label en official "the two members of the consolidated affiliated group are treated as one corporation for section 469 (section 469(j)(11))";
}
@source(IRC_S469_J, quote = "all members of an affiliated group which files a consolidated return shall be treated as 1 corporation.")
rule ConsolidatedGroupMembersAreOneCorporation(p: Person, q: Person, g: Integer, y: TaxableYear) defeasible {
    label en official "members of a consolidated affiliated group are one corporation for section 469, unless regulations provide otherwise (section 469(j)(11))";
    when member_of_consolidated_affiliated_group(p, g, y);
    when member_of_consolidated_affiliated_group(q, g, y);
    unless regulations_except_from_single_corporation_469j11(p, q, y);
    then members_treated_as_one_corporation_469j11(p, q, y);
}
