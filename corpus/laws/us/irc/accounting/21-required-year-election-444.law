// Section 444 — Election of taxable year other than required taxable year.
// Stage 2b (IRC-07). Scope: (a) the election itself, as a POWER; (b)(1) the
// 3-month deferral-period limitation (deferral period read as a case fact
// per (b)(4)'s own month-count, not independently computed); (c) the
// consequences (section 7519 required payments for a partnership/S
// corporation; section 280H deduction limitations for a personal service
// corporation) as EXTERNAL_DEPENDENCY contracts; (e)-(f) the required-
// taxable-year and personal-service-corporation cross-references (read as
// case facts, us.irc.core::required_taxable_year_is_calendar_year_441i
// already exists for the 441(i) branch specifically). NOT DONE (TECH-GAPS
// G472): (b)(2)-(3) the changed-filer and 1986-retained-year special
// deferral rules; (d) the election-persistence/tiered-structure termination
// rules (a multi-year state machine); (g) regulations (NON_NORMATIVE).

use self::{
    IRC_S444_A,
    IRC_S444_B,
    IRC_S444_C,
    Person,
    TaxableYear,
    deferral_period_permitted_444b,
};

pub relation is_partnership_or_s_corp_or_psc_444(filer: Person) kind empirical {
    label en official "the filer is a partnership, S corporation, or personal service corporation (section 444(a))";
}
pub relation deferral_period_months_444(filer: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the deferral period of the taxable year elected: the months between the beginning of the elected year and the close of the 1st required taxable year ending within it (section 444(b)(4)) — read as a case fact rather than computed from required_taxable_year_begins/elected_taxable_year_begins";
}
pub relation deferral_period_within_three_months_444(filer: Person, y: TaxableYear) kind institutional {
    label en official "the deferral period of the elected taxable year is not longer than 3 months (section 444(b)(1))";
}
@source(IRC_S444_B, quote = "an election may be made under subsection (a) only if the deferral period of the taxable year elected is not longer than 3 months")
rule DeferralPeriodWithinThreeMonths(filer: Person, y: TaxableYear, months: Integer) strict {
    label en official "the general section 444(b)(1) limitation: a 3-month-or-less deferral period";
    when deferral_period_months_444(filer, y, months);
    when months <= 3;
    then deferral_period_within_three_months_444(filer, y);
}
pub relation elects_taxable_year_other_than_required_444(filer: Person, y: TaxableYear) kind empirical {
    label en official "the filer elects, under section 444(a), to have a taxable year other than its required taxable year";
}
pub relation section_444_election_in_effect(filer: Person, y: TaxableYear) kind institutional {
    label en official "the section 444(a) election of a taxable year other than the required taxable year is in effect";
}
@source(IRC_S444_A, quote = "a partnership, S corporation, or personal service corporation may elect to have a taxable year other than the required taxable year")
rule Section444ElectionPower(filer: Person, y: TaxableYear) strict {
    label en official "a partnership, S corporation, or personal service corporation may elect a taxable year other than the required taxable year, with a deferral period not longer than 3 months (section 444(a), (b)(1))";
    when is_partnership_or_s_corp_or_psc_444(filer);
    when us.irc.core::year_of(filer, y);
    then power Section444TaxableYearElection {
        holder filer;
        over y;
        exercise elects_taxable_year_other_than_required_444(filer, y);
        valid_when deferral_period_permitted_444b(filer, y);
        effect create(section_444_election_in_effect(filer, y));
        window [@1987-01-01, infinity);
    };
}

// (c): consequences of the election.
pub relation is_partnership_or_s_corp_444(filer: Person) kind empirical {
    label en official "the filer making the section 444 election is a partnership or S corporation, not a personal service corporation (section 444(c)(1))";
}
pub relation is_personal_service_corporation_444(filer: Person) kind empirical {
    label en official "the filer making the section 444 election is a personal service corporation, within the meaning of section 441(i)(2) (section 444(c)(2), (f))";
}
pub relation section_7519_required_payment_owed(filer: Person, y: TaxableYear) kind institutional {
    label en official "the section 7519 required payment for the deferral, owed by a partnership or S corporation with a section 444 election in effect (section 444(c)(1)) — the section 7519 computation itself is us.irc.administration's own norm, not wired in this stage (EXTERNAL_DEPENDENCY, accounting.deps.json)";
}
pub relation section_444_consequence_required_payment(filer: Person, y: TaxableYear) kind institutional {
    label en official "a partnership or S corporation with a section 444 election in effect must make the section 7519 required payments (section 444(c)(1))";
}
@source(IRC_S444_C, quote = "in the case of a partnership or S corporation, such entity shall make the payments required by section 7519, and")
rule Section444RequiredPaymentConsequence(filer: Person, y: TaxableYear) strict {
    label en official "a partnership or S corporation electing under section 444 must make the section 7519 required payments (section 444(c)(1))";
    when section_444_election_in_effect(filer, y);
    when is_partnership_or_s_corp_444(filer);
    when section_7519_required_payment_owed(filer, y);
    then section_444_consequence_required_payment(filer, y);
}
pub relation section_280h_limitation_applies(filer: Person, y: TaxableYear) kind institutional {
    label en official "a personal service corporation with a section 444 election in effect is subject to the section 280H deduction limitations (section 444(c)(2)) — the section 280H computation itself is us.irc.deductions' own norm, not wired in this stage (EXTERNAL_DEPENDENCY, accounting.deps.json)";
}
@source(IRC_S444_C, quote = "in the case of a personal service corporation, such corporation shall be subject to the deduction limitations of section 280H")
rule Section444PersonalServiceCorporation280HConsequence(filer: Person, y: TaxableYear) strict {
    label en official "a personal service corporation electing under section 444 is subject to the section 280H deduction limitations (section 444(c)(2))";
    when section_444_election_in_effect(filer, y);
    when is_personal_service_corporation_444(filer);
    then section_280h_limitation_applies(filer, y);
}
