// Accounting -- WIRE-9 (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// The personal-service-corporation classification of section 441(i) was a case-asserted classification. Section 441(i)(2) defines the term
// (section 269A(b)(1) as modified) and `us.irc.deductions` (which this package imports) publishes the concept as
// `personal_service_corporation_441i2(psc)` for its section 267(a)(2) rule. The classification is derived from that relation for every
// taxable year of the corporation (the owner's relation is not year-keyed; the year is bound by `year_of`). The case-fact channel stays valid.
//
// Not wired: the section 469(j)(2) and section 444 personal service corporation relations of this package (`is_personal_service_corporation_469j2`,
// `is_personal_service_corporation_444`) name their own definitions and are left as case facts.

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

use self::{
    Person,
    TaxableYear,
    is_personal_service_corporation,
};

rule W9PersonalServiceCorporationFromDeductions strict {
    label en official "section 441(i)(2): a personal service corporation is the corporation the deductions package classifies as such under section 441(i)(2), for each taxable year of the corporation";
    for corp: Person;
    for y: TaxableYear;
    when us.irc.deductions::personal_service_corporation_441i2(corp);
    when us.irc.core::year_of(corp, y);
    then is_personal_service_corporation(corp, y);
}
