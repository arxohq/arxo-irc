// Stage 3 (DECISION-0379 with deontics): residual ranges named in stage 2c.
//
//   * section 465(c)(2)-(3): separate and aggregated activities;
//   * section 465(c)(4)(C), (c)(5)(C), (c)(6): controlled-group leasing rules
//     and the definition of equipment leasing;
//   * section 465(c)(7)(D)-(G): qualified corporate partner, deduction and gross
//     income adjustments, life insurance, non-owner employees, excluded
//     business, affiliated group;
//   * section 465(b)(6)(B), (C), (E): qualified nonrecourse financing;
//   * section 469(c)(7)(A)(ii), (i)(6)(D), (j)(5);
//   * section 474(b), (d)(1), (d)(4)(A)(i);
//   * date-keyed continuation of multi-year elections (G2108).
//
// Compatibility: the stage 1b and 2c relations stay as they are (case facts on
// the legacy paths); the new relations DERIVE what those facts assert. Where a
// legacy rule would also fire for the derived case, it is guarded with a
// `not_known` bridge (module 26 edits: `derived_qualified_leasing_member_465`).
//
// Not modelled (TECH-GAPS G4800+): the regulations of section 465(c)(3)(C),
// the section 318 attribution inside `non-owner employee`, section 1563
// control tests, and the multi-year at-risk ledger of section 465(b)(5).

// ===================== Section 465(c)(2): separate activities =====================

use self::{
    IRC_S465_B,
    IRC_S465_C,
    Person,
    Section465ActivityType,
    TaxableYear,
    actively_engaged_in_equipment_leasing_465c4,
    activity_type_465,
    depletion_property_614a,
    engaged_in_activity_for_465,
    interests_form_one_property_614,
    is_c_corporation_described_in_465a1B,
    is_personal_holding_company_542a,
    is_personal_service_corporation_269A_five_percent,
    is_qualified_leasing_group_465c5B,
    is_qualifying_business_465c7C,
    loan_amount_at_risk_465b,
    loan_for_activity,
    loss_exempt_from_465a_by_c4_or_c7,
    preceding_taxable_year_465,
};

pub relation partnership_or_s_corporation_465(p: Person) kind empirical {
    label en official "the taxpayer is a partnership or an S corporation (section 465(c)(2)(B)(i), (c)(3)(B)(ii))";
}
pub relation separate_activity_465c2A(p: Person, activity: Integer) kind institutional {
    label en official "the taxpayer's activity with respect to each film or video tape, leased section 1245 property, farm, oil and gas property, or geothermal property is a separate activity (section 465(c)(2)(A))";
}
@source(IRC_S465_C, quote = "(i) film or video tape,")
rule SeparateActivityForFilmOrVideoTape(p: Person, activity: Integer) defeasible {
    label en official "each film or video tape is a separate activity (section 465(c)(2)(A)(i))";
    when engaged_in_activity_for_465(p, activity);
    when activity_type_465(activity, MotionPictureOrVideoTape);
    then separate_activity_465c2A(p, activity);
}
@source(IRC_S465_C, quote = "(ii) section 1245 property which is leased or held for leasing,")
rule SeparateActivityForLeasedSection1245Property(p: Person, activity: Integer) defeasible {
    label en official "each section 1245 property leased or held for leasing is a separate activity (section 465(c)(2)(A)(ii))";
    when engaged_in_activity_for_465(p, activity);
    when activity_type_465(activity, Section1245PropertyLeasing);
    then separate_activity_465c2A(p, activity);
}
@source(IRC_S465_C, quote = "(iii) farm,")
rule SeparateActivityForFarm(p: Person, activity: Integer) defeasible {
    label en official "each farm is a separate activity (section 465(c)(2)(A)(iii))";
    when engaged_in_activity_for_465(p, activity);
    when activity_type_465(activity, Farming);
    then separate_activity_465c2A(p, activity);
}
@source(IRC_S465_C, quote = "(iv) oil and gas property (as defined under section 614), or")
rule SeparateActivityForOilAndGasProperty(p: Person, activity: Integer) defeasible {
    label en official "each oil and gas property as defined under section 614 is a separate activity; the property is the section 614 depletion property (section 465(c)(2)(A)(iv))";
    when engaged_in_activity_for_465(p, activity);
    when activity_type_465(activity, OilAndGas);
    when depletion_property_614a(p, activity);
    then separate_activity_465c2A(p, activity);
}
@source(IRC_S465_C, quote = "(v) geothermal property (as defined under section 614),")
rule SeparateActivityForGeothermalProperty(p: Person, activity: Integer) defeasible {
    label en official "each geothermal property as defined under section 614 is a separate activity (section 465(c)(2)(A)(v))";
    when engaged_in_activity_for_465(p, activity);
    when activity_type_465(activity, Geothermal);
    when depletion_property_614a(p, activity);
    then separate_activity_465c2A(p, activity);
}
pub relation section_1245_property_placed_in_service_year_465c2B(p: Person, activity: Integer, placed: TaxableYear) kind empirical {
    label en official "the leased or held-for-lease section 1245 property is placed in service in the taxable year of the partnership or S corporation (section 465(c)(2)(B)(i)(I)-(II))";
}
pub relation activities_treated_as_single_activity_465(p: Person, a: Integer, b: Integer) kind institutional {
    label en official "the two activities are treated as a single activity under the section 465(c)(2)(B) and (c)(3)(B) aggregation rules, or because they are one section 614 oil and gas or geothermal property";
}
@source(IRC_S465_C, quote = "shall be treated as a single activity.")
rule PartnershipLeasedSection1245ActivitiesAggregatedByYear(p: Person, a: Integer, b: Integer, placed: TaxableYear) defeasible {
    label en official "a partnership or S corporation treats all leased section 1245 properties placed in service in one of its taxable years as a single activity (section 465(c)(2)(B)(i))";
    when partnership_or_s_corporation_465(p);
    when section_1245_property_placed_in_service_year_465c2B(p, a, placed);
    when section_1245_property_placed_in_service_year_465c2B(p, b, placed);
    when a != b;
    then activities_treated_as_single_activity_465(p, a, b);
}
rule ActivitiesOfOneSection614PropertyAreOneActivity(p: Person, a: Integer, b: Integer) defeasible {
    label en official "interests combined into one section 614 property are one oil and gas or geothermal activity (section 465(c)(2)(A)(iv)-(v))";
    when interests_form_one_property_614(p, a, b);
    when separate_activity_465c2A(p, a);
    when separate_activity_465c2A(p, b);
    then activities_treated_as_single_activity_465(p, a, b);
}
pub relation activity_part_of_trade_or_business_465(p: Person, activity: Integer, business: Integer) kind empirical {
    label en official "the activity is part of the trade or business of the taxpayer (section 465(c)(3)(B))";
}
pub relation taxpayer_actively_participates_in_management_465c3Bi(p: Person, business: Integer) kind empirical {
    label en official "the taxpayer actively participates in the management of the trade or business (section 465(c)(3)(B)(i))";
}
pub relation share_of_losses_allocable_to_actively_managing_persons_465c3Bii(p: Person, business: Integer, ratio: Decimal) kind empirical {
    label en official "the part of the taxable year's losses of the business allocable to persons who actively participate in its management (section 465(c)(3)(B)(ii))";
}
@source(IRC_S465_C, quote = "activities described in subparagraph (A) which constitute a trade or business shall be treated as one activity if—")
rule ActivitiesOfOneBusinessAggregatedByActiveManagement(p: Person, a: Integer, b: Integer, business: Integer) defeasible {
    label en official "activities of one trade or business are one activity when the taxpayer actively participates in its management (section 465(c)(3)(B)(i)); the regulations of (C) are not prescribed";
    when activity_type_465(a, OtherTradeOrBusinessOrIncomeActivity);
    when activity_type_465(b, OtherTradeOrBusinessOrIncomeActivity);
    when activity_part_of_trade_or_business_465(p, a, business);
    when activity_part_of_trade_or_business_465(p, b, business);
    when taxpayer_actively_participates_in_management_465c3Bi(p, business);
    when a != b;
    then activities_treated_as_single_activity_465(p, a, b);
}
@source(IRC_S465_C, quote = "such trade or business is carried on by a partnership or an S corporation and 65 percent or more of the losses for the taxable year is allocable to persons who actively participate in the management of the trade or business.")
rule ActivitiesOfOneBusinessAggregatedByLossShare(p: Person, a: Integer, b: Integer, business: Integer, ratio: Decimal) defeasible {
    label en official "a partnership or S corporation business whose losses are 65 percent or more allocable to actively managing persons is one activity (section 465(c)(3)(B)(ii))";
    when activity_type_465(a, OtherTradeOrBusinessOrIncomeActivity);
    when activity_type_465(b, OtherTradeOrBusinessOrIncomeActivity);
    when activity_part_of_trade_or_business_465(p, a, business);
    when activity_part_of_trade_or_business_465(p, b, business);
    when partnership_or_s_corporation_465(p);
    when share_of_losses_allocable_to_actively_managing_persons_465c3Bii(p, business, ratio);
    when ratio >= 0.65;
    when a != b;
    then activities_treated_as_single_activity_465(p, a, b);
}
@source(IRC_S465_C, quote = "Rules similar to the rules of subparagraphs (B) and (C) of paragraph (3) shall apply for purposes of this paragraph.")
rule Paragraph2ActivitiesAggregatedBySimilarRule(p: Person, a: Integer, b: Integer, business: Integer) defeasible {
    label en official "rules similar to (c)(3)(B) apply to the (c)(2) separate activities: those of one business the taxpayer actively manages are one activity (section 465(c)(2)(B)(ii))";
    when separate_activity_465c2A(p, a);
    when separate_activity_465c2A(p, b);
    when activity_part_of_trade_or_business_465(p, a, business);
    when activity_part_of_trade_or_business_465(p, b, business);
    when taxpayer_actively_participates_in_management_465c3Bi(p, business);
    when a != b;
    then activities_treated_as_single_activity_465(p, a, b);
}

// ===================== Section 465(c)(4)-(6): equipment leasing =====================

pub relation controlled_group_member_465(p: Person, g: Integer, y: TaxableYear) kind empirical {
    label en official "the corporation is a component member of the controlled group of corporations for the taxable year (section 465(c)(4)(C), (c)(5)(C)(i), (c)(6)(C)); the section 1563 control test is asserted";
}
pub relation member_equipment_leasing_receipts_465(p: Person, g: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the member's gross receipts attributable to equipment leasing for the taxable year (section 465(c)(4)(B))";
}
pub relation member_total_gross_receipts_465(p: Person, g: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the member's gross receipts for the taxable year (section 465(c)(4)(B))";
}
pub relation controlled_group_year_465(g: Integer, y: TaxableYear) kind empirical {
    label en official "the controlled group is tested for the taxable year";
}
pub relation group_equipment_leasing_receipts_465(g: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the leasing receipts of all component members of the group, which are treated as a single corporation (section 465(c)(4)(C))";
}
@source(IRC_S465_C, quote = "the component members of a controlled group of corporations shall be treated as a single corporation.")
rule GroupLeasingReceiptsSum(g: Integer, y: TaxableYear) strict {
    label en official "the group's leasing receipts are the sum over its component members (section 465(c)(4)(C))";
    when controlled_group_year_465(g, y);
    then group_equipment_leasing_receipts_465(g, y, sum all amt: Money for m: Person where controlled_group_member_465(m, g, y) and member_equipment_leasing_receipts_465(m, g, y, amt));
}
pub relation group_total_gross_receipts_465(g: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross receipts of all component members of the group treated as a single corporation (section 465(c)(4)(C))";
}
rule GroupTotalReceiptsSum(g: Integer, y: TaxableYear) strict {
    label en official "the group's gross receipts are the sum over its component members (section 465(c)(4)(C))";
    when controlled_group_year_465(g, y);
    then group_total_gross_receipts_465(g, y, sum all amt: Money for m: Person where controlled_group_member_465(m, g, y) and member_total_gross_receipts_465(m, g, y, amt));
}
pub relation group_meets_fifty_percent_leasing_test_465c4B(g: Integer, y: TaxableYear) kind institutional {
    label en official "the group, as a single corporation, has 50 percent or more of its gross receipts from equipment leasing (section 465(c)(4)(B), (C))";
}
rule GroupMeetsFiftyPercentLeasingTest(g: Integer, y: TaxableYear, lease: Money, total: Money) strict {
    label en official "group leasing receipts x 2 >= group gross receipts";
    when group_equipment_leasing_receipts_465(g, y, lease);
    when group_total_gross_receipts_465(g, y, total);
    when lease * 2.0 >= total;
    then group_meets_fifty_percent_leasing_test_465c4B(g, y);
}
pub relation member_meets_eighty_percent_leasing_test_465c5C(p: Person, g: Integer, y: TaxableYear) kind institutional {
    label en official "the member itself meets the (4)(B) test with 80 percent substituted for 50 percent (section 465(c)(5)(C)(ii), (A)(i))";
}
@source(IRC_S465_C, quote = "it meets the requirements of paragraph (4)(B) (as modified by subparagraph (A)(i) of this paragraph).")
rule MemberMeetsEightyPercentLeasingTest(p: Person, g: Integer, y: TaxableYear, lease: Money, total: Money) strict {
    label en official "the member's own leasing receipts are at least 80 percent of its gross receipts (section 465(c)(5)(C)(ii))";
    when member_equipment_leasing_receipts_465(p, g, y, lease);
    when member_total_gross_receipts_465(p, g, y, total);
    when lease * 5.0 >= total * 4.0;
    then member_meets_eighty_percent_leasing_test_465c5C(p, g, y);
}
pub relation group_qualifies_as_qualified_leasing_group_465c5B(g: Integer, y: TaxableYear) kind institutional {
    label en official "the controlled group is a qualified leasing group and is not a group to which paragraph (4) applies without regard to paragraph (5) (section 465(c)(5)(B), last sentence)";
}
rule QualifiedLeasingGroupExcludesGroupsPassingParagraph4(g: Integer, y: TaxableYear) defeasible {
    label en official "a group that would pass paragraph (4) as a single corporation is not a qualified leasing group (section 465(c)(5)(B), last sentence)";
    when is_qualified_leasing_group_465c5B(g, y);
    when not_known(group_meets_fifty_percent_leasing_test_465c4B(g, y));
    then group_qualifies_as_qualified_leasing_group_465c5B(g, y);
}
pub relation qualified_leasing_member_465c5C(p: Person, g: Integer, y: TaxableYear) kind institutional {
    label en official "a qualified leasing member: for the year and each of the 2 preceding years the corporation was a component member of the group and met the 80-percent test (section 465(c)(5)(C))";
}
@source(IRC_S465_C, quote = "a corporation shall be treated as a qualified leasing member for the taxable year only if for each of the taxable years referred to in subparagraph (B)—")
rule QualifiedLeasingMemberThreeYears(p: Person, g: Integer, y: TaxableYear, y1: TaxableYear, y2: TaxableYear) defeasible {
    label en official "membership and the 80-percent test in each of the three years (section 465(c)(5)(C)(i)-(ii)); the preceding years are linked by `preceding_taxable_year_465`";
    when preceding_taxable_year_465(y1, y);
    when preceding_taxable_year_465(y2, y1);
    when controlled_group_member_465(p, g, y);
    when controlled_group_member_465(p, g, y1);
    when controlled_group_member_465(p, g, y2);
    when member_meets_eighty_percent_leasing_test_465c5C(p, g, y);
    when member_meets_eighty_percent_leasing_test_465c5C(p, g, y1);
    when member_meets_eighty_percent_leasing_test_465c5C(p, g, y2);
    then qualified_leasing_member_465c5C(p, g, y);
}
pub relation derived_qualified_leasing_member_465(p: Person, y: TaxableYear) kind institutional {
    label en official "the corporation is a derived qualified leasing member of some group (bridge for the legacy 50-percent rule)";
}
rule DerivedQualifiedLeasingMemberBridge(p: Person, g: Integer, y: TaxableYear) defeasible {
    label en official "bridge";
    when qualified_leasing_member_465c5C(p, g, y);
    then derived_qualified_leasing_member_465(p, y);
}
@source(IRC_S465_C, quote = "as if paragraph (4) did not include subparagraph (C) thereof.")
rule QualifiedLeasingMemberActivelyEngagedAtEightyPercent(p: Person, g: Integer, y: TaxableYear) defeasible {
    label en official "a qualified leasing member of a qualified leasing group is tested on its own receipts at 80 percent, without the single-corporation rule (section 465(c)(5)(A))";
    when is_c_corporation_described_in_465a1B(p);
    when qualified_leasing_member_465c5C(p, g, y);
    when group_qualifies_as_qualified_leasing_group_465c5B(g, y);
    then actively_engaged_in_equipment_leasing_465c4(p, y);
}
@source(IRC_S465_C, quote = "In the case of a corporation described in subsection (a)(1)(B) actively engaged in equipment leasing—")
rule GroupMemberActivelyEngagedThroughSingleCorporation(p: Person, g: Integer, y: TaxableYear) defeasible {
    label en official "a closely held corporation is actively engaged in equipment leasing when its controlled group, treated as one corporation, meets the 50-percent test (section 465(c)(4)(B)-(C)), unless it is a derived qualified leasing member";
    when is_c_corporation_described_in_465a1B(p);
    when controlled_group_member_465(p, g, y);
    when group_meets_fifty_percent_leasing_test_465c4B(g, y);
    when not_known(derived_qualified_leasing_member_465(p, y));
    then actively_engaged_in_equipment_leasing_465c4(p, y);
}
pub relation activity_leases_section_1245_equipment_465c6Ai(activity: Integer) kind empirical {
    label en official "the activity is the leasing of equipment that is section 1245 property (section 465(c)(6)(A)(i))";
}
pub relation activity_purchases_services_or_sells_section_1245_equipment_465c6Aii(activity: Integer) kind empirical {
    label en official "the activity is the purchasing, servicing, or selling of such equipment (section 465(c)(6)(A)(ii))";
}
pub relation activity_leases_master_sound_recordings_or_similar_465c6B(activity: Integer) kind empirical {
    label en official "the activity is the leasing of master sound recordings or similar contractual arrangements with respect to tangible or intangible assets associated with literary, artistic, or musical properties (section 465(c)(6)(B))";
}
pub relation equipment_leasing_activity_465c6(activity: Integer) kind institutional {
    label en official "equipment leasing: leasing of section 1245 equipment and its purchase, servicing and sale, excluding master sound recordings and similar arrangements (section 465(c)(6)(A)-(B))";
}
@source(IRC_S465_C, quote = "the leasing of equipment which is section 1245 property, and")
rule EquipmentLeasingByLeasingOfSection1245Equipment(activity: Integer) defeasible {
    label en official "leasing section 1245 equipment is equipment leasing, unless it is a master sound recording arrangement (section 465(c)(6)(A)(i), (B))";
    when activity_leases_section_1245_equipment_465c6Ai(activity);
    when not_known(activity_leases_master_sound_recordings_or_similar_465c6B(activity));
    then equipment_leasing_activity_465c6(activity);
}
@source(IRC_S465_C, quote = "the purchasing, servicing, and selling of such equipment.")
rule EquipmentLeasingByPurchasingServicingOrSelling(activity: Integer) defeasible {
    label en official "purchasing, servicing and selling such equipment is equipment leasing, unless it is a master sound recording arrangement (section 465(c)(6)(A)(ii), (B))";
    when activity_purchases_services_or_sells_section_1245_equipment_465c6Aii(activity);
    when not_known(activity_leases_master_sound_recordings_or_similar_465c6B(activity));
    then equipment_leasing_activity_465c6(activity);
}
@source(IRC_S465_C, quote = "(ii) subsection (a) shall not apply to losses from such activity.")
rule EquipmentLeasingDerivedByClosedCorporationExempt(p: Person, y: TaxableYear, activity: Integer) defeasible {
    label en official "a derived equipment leasing activity of an actively engaged closely held corporation is outside section 465(a) (section 465(c)(4)(A)); the legacy asserted-fact rule is kept";
    when engaged_in_activity_for_465(p, activity);
    when equipment_leasing_activity_465c6(activity);
    when actively_engaged_in_equipment_leasing_465c4(p, y);
    then loss_exempt_from_465a_by_c4_or_c7(p, y, activity);
}

// ===================== Section 465(c)(7): qualified C corporations =====================

pub relation is_general_partner_465c7Dii(p: Person, partnership: Person) kind empirical {
    label en official "the corporation is a general partner in the partnership (section 465(c)(7)(D)(ii)(I))";
}
pub relation profits_and_losses_interest_465c7Dii(p: Person, partnership: Person, ratio: Decimal) kind empirical {
    label en official "the corporation's interest in the profits and losses of the partnership, as a fraction (section 465(c)(7)(D)(ii)(II))";
}
pub relation property_contributed_to_partnership_at_fair_market_value_465c7Dii(p: Person, partnership: Person, amount: Money) kind empirical {
    label en official "the property the corporation has contributed to the partnership, non-money property at fair market value (section 465(c)(7)(D)(ii)(III), last sentence)";
}
pub relation net_worth_of_corporation_465c7Dii(p: Person, amount: Money) kind empirical {
    label en official "the net worth of the corporation (section 465(c)(7)(D)(ii)(III))";
}
pub relation is_qualified_corporate_partner_465c7Dii(p: Person, partnership: Person) kind institutional {
    label en official "a qualified corporate partner: a general partner with a profits and losses interest of 10 percent or more that has contributed property of at least the lesser of $500,000 or 10 percent of its net worth (section 465(c)(7)(D)(ii))";
}
@source(IRC_S465_C, quote = "such corporation has contributed property to the partnership in an amount not less than the lesser of $500,000 or 10 percent of the net worth of the corporation.")
rule QualifiedCorporatePartnerTests(p: Person, partnership: Person, ratio: Decimal, contributed: Money, worth: Money) strict {
    label en official "general partner, 10-percent profits and losses interest, and contribution of at least min($500,000, 10 percent of net worth) (section 465(c)(7)(D)(ii)(I)-(III))";
    when is_general_partner_465c7Dii(p, partnership);
    when profits_and_losses_interest_465c7Dii(p, partnership, ratio);
    when property_contributed_to_partnership_at_fair_market_value_465c7Dii(p, partnership, contributed);
    when net_worth_of_corporation_465c7Dii(p, worth);
    when ratio >= 0.10;
    when contributed >= min(500000.00 USD, worth * 0.10);
    then is_qualified_corporate_partner_465c7Dii(p, partnership);
}
pub relation active_business_of_partnership_465c7Di(partnership: Person, business: Integer) kind empirical {
    label en official "the business is an active business of the partnership (section 465(c)(7)(D)(i))";
}
pub relation full_time_management_employees_of_partnership_or_partner_465c7Di(partnership: Person, business: Integer, employees: Integer) kind empirical {
    label en official "the full-time employees of the partnership (or of a qualified corporate partner), substantially all of whose services were in the active management of the business during the entire 12-month period ending on the last day of the partnership's taxable year (section 465(c)(7)(D)(i)(II))";
}
pub relation partnership_business_attributed_to_qualified_partner_465c7Di(p: Person, partnership: Person, business: Integer, share: Decimal) kind institutional {
    label en official "the taxpayer's proportionate share, by profits interest, of the partnership's activities in the business is treated as the taxpayer's own (section 465(c)(7)(D)(i))";
}
@source(IRC_S465_C, quote = "then the taxpayer's proportionate share (determined on the basis of its profits interest) of the activities of the partnership in such business shall be treated as activities of the taxpayer")
rule PartnershipBusinessAttributedToQualifiedCorporatePartner(p: Person, partnership: Person, business: Integer, employees: Integer, ratio: Decimal) defeasible {
    label en official "a qualified corporate partner takes its profits-interest share of an active partnership business when a full-time management employee exists (section 465(c)(7)(D)(i))";
    when is_qualified_corporate_partner_465c7Dii(p, partnership);
    when active_business_of_partnership_465c7Di(partnership, business);
    when full_time_management_employees_of_partnership_or_partner_465c7Di(partnership, business, employees);
    when employees >= 1;
    when profits_and_losses_interest_465c7Dii(p, partnership, ratio);
    then partnership_business_attributed_to_qualified_partner_465c7Di(p, partnership, business, ratio);
}
pub relation management_employee_test_waived_465c7Di(p: Person, business: Integer) kind institutional {
    label en official "clause (i) of subparagraph (C) does not apply in determining whether the attributed partnership business is a qualifying business of the taxpayer (section 465(c)(7)(D)(i), parenthetical)";
}
rule ManagementEmployeeTestWaivedForAttributedBusiness(p: Person, partnership: Person, business: Integer, share: Decimal) defeasible {
    label en official "the (C)(i) management-employee test is waived for an attributed partnership business (section 465(c)(7)(D)(i))";
    when partnership_business_attributed_to_qualified_partner_465c7Di(p, partnership, business, share);
    then management_employee_test_waived_465c7Di(p, business);
}
// --- the four (C) tests, derived from employee-level facts ---
pub relation management_employee_of_business_465c7Ci(emp: Integer, p: Person, business: Integer) kind empirical {
    label en official "the employee is a full-time employee substantially all of whose services were in the active management of the business during the entire 12-month period ending on the last day of the taxable year (section 465(c)(7)(C)(i))";
}
pub relation full_time_employee_of_business_465c7Cii(emp: Integer, p: Person, business: Integer, stock_share: Decimal) kind empirical {
    label en official "the employee is a full-time employee for the entire 12-month period, substantially all of whose services relate directly to the business, with the greatest share of the outstanding stock value the employee owns (including under section 318, with 5 percent substituted for 50 percent in section 318(a)(2)(C)) (section 465(c)(7)(C)(ii), (E)(i))";
}
pub relation c7C_management_employee_test_met_465(p: Person, business: Integer) kind institutional {
    label en official "clause (i) of subparagraph (C) is met: at least 1 full-time management employee, or the test is waived under (D)(i)";
}
rule ManagementEmployeeTestMetByAnEmployee(p: Person, business: Integer, emp: Integer) defeasible {
    label en official "at least 1 full-time management employee (section 465(c)(7)(C)(i))";
    when management_employee_of_business_465c7Ci(emp, p, business);
    then c7C_management_employee_test_met_465(p, business);
}
rule ManagementEmployeeTestMetByWaiver(p: Person, business: Integer) defeasible {
    label en official "clause (i) is waived for an attributed partnership business (section 465(c)(7)(D)(i))";
    when management_employee_test_waived_465c7Di(p, business);
    then c7C_management_employee_test_met_465(p, business);
}
pub relation c7C_nonowner_employee_test_met_465(p: Person, business: Integer) kind institutional {
    label en official "clause (ii) of subparagraph (C) is met: at least 3 full-time non-owner employees; a non-owner employee owns at most 5 percent in value of the taxpayer's stock (section 465(c)(7)(C)(ii), (E)(i))";
}
@source(IRC_S465_C, quote = "The term \"non-owner employee\" means any employee who does not own, at any time during the taxable year, more than 5 percent in value of the outstanding stock of the taxpayer.")
rule NonOwnerEmployeeCountAtLeastThree(p: Person, business: Integer) defeasible {
    label en official "the count of full-time employees whose stock share is at most 5 percent is at least 3 (section 465(c)(7)(C)(ii), (E)(i)); attribution under section 318 is inside the asserted share";
    when engaged_in_activity_for_465(p, business);
    when count(collect e: Integer, s: Decimal where full_time_employee_of_business_465c7Cii(e, p, business, s) and s <= 0.05) >= 3;
    then c7C_nonowner_employee_test_met_465(p, business);
}
pub relation business_deductions_162_404_before_owner_compensation_465c7(p: Person, business: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions attributable to the business allowable to the taxpayer solely by reason of sections 162 and 404, before the (D)(iii) exclusion (section 465(c)(7)(C)(iii))";
}
pub relation owner_employee_compensation_465c7Diii(p: Person, business: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "deductions for compensation for personal services rendered by an employee other than a non-owner employee, or a member of the employee's family within section 318(a)(1) (section 465(c)(7)(D)(iii))";
}
pub relation business_gross_income_before_bank_adjustment_465c7(p: Person, business: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income from the business for the year (section 465(c)(7)(C)(iii))";
}
pub relation taxpayer_is_bank_or_financial_institution_465c7Div(p: Person) kind empirical {
    label en official "the taxpayer is a bank (section 581) or a financial institution to which section 591 applies (section 465(c)(7)(D)(iv))";
}
pub relation tax_exempt_interest_under_103_of_business_465c7Div(p: Person, business: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest excluded from the business's gross income under section 103 (section 465(c)(7)(D)(iv)(I))";
}
pub relation depositor_dividends_and_interest_deductions_465c7Div(p: Person, business: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "deductions allowable under section 163 or 591 for amounts paid or credited to depositors or holders of accounts as dividends or interest (section 465(c)(7)(D)(iv)(II))";
}
pub relation c7C_deductions_for_test_465c7Diii(p: Person, business: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deductions counted for the 15-percent test: section 162 and 404 deductions less owner-employee compensation (floored at zero), plus, for a bank, depositor interest (section 465(c)(7)(C)(iii), (D)(iii)-(iv)(II))";
}
rule DeductionsForTestNonBank(p: Person, business: Integer, y: TaxableYear, ded: Money, comp: Money) defeasible {
    label en official "owner-employee compensation is not counted (section 465(c)(7)(D)(iii)); floored at zero (JUDGMENT CALL)";
    when business_deductions_162_404_before_owner_compensation_465c7(p, business, y, ded);
    when owner_employee_compensation_465c7Diii(p, business, y, comp);
    when not_known(taxpayer_is_bank_or_financial_institution_465c7Div(p));
    then c7C_deductions_for_test_465c7Diii(p, business, y, max(ded - comp, 0 USD));
}
rule DeductionsForTestBank(p: Person, business: Integer, y: TaxableYear, ded: Money, comp: Money, dep: Money) defeasible {
    label en official "a bank adds the depositor dividend and interest deductions (section 465(c)(7)(D)(iv)(II))";
    when business_deductions_162_404_before_owner_compensation_465c7(p, business, y, ded);
    when owner_employee_compensation_465c7Diii(p, business, y, comp);
    when taxpayer_is_bank_or_financial_institution_465c7Div(p);
    when depositor_dividends_and_interest_deductions_465c7Div(p, business, y, dep);
    then c7C_deductions_for_test_465c7Diii(p, business, y, max(ded - comp, 0 USD) + dep);
}
pub relation c7C_gross_income_for_test_465c7Div(p: Person, business: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income for the 15-percent test: for a bank, gross income determined without regard to the section 103 exclusion (section 465(c)(7)(D)(iv)(I))";
}
rule GrossIncomeForTestNonBank(p: Person, business: Integer, y: TaxableYear, income: Money) defeasible {
    label en official "gross income of the business as it is (section 465(c)(7)(C)(iii))";
    when business_gross_income_before_bank_adjustment_465c7(p, business, y, income);
    when not_known(taxpayer_is_bank_or_financial_institution_465c7Div(p));
    then c7C_gross_income_for_test_465c7Div(p, business, y, income);
}
rule GrossIncomeForTestBank(p: Person, business: Integer, y: TaxableYear, income: Money, exempt: Money) defeasible {
    label en official "a bank adds back interest excluded under section 103 (section 465(c)(7)(D)(iv)(I))";
    when business_gross_income_before_bank_adjustment_465c7(p, business, y, income);
    when taxpayer_is_bank_or_financial_institution_465c7Div(p);
    when tax_exempt_interest_under_103_of_business_465c7Div(p, business, y, exempt);
    then c7C_gross_income_for_test_465c7Div(p, business, y, income + exempt);
}
pub relation qualified_life_insurance_company_465c7Dv(p: Person) kind empirical {
    label en official "the company would be a life insurance company as defined in section 816 if unearned premiums were not taken into account under section 816(a)(2) and (c)(2) (section 465(c)(7)(D)(v)(III)); the section 816 test belongs to the special-entities owner";
}
pub relation noninsurance_business_453Be3_465c7Dv(business: Integer) kind empirical {
    label en official "the business is a noninsurance business within the meaning of section 453B(e)(3) (section 465(c)(7)(D)(v)(II))";
}
pub relation insurance_business_465c7Dv(business: Integer) kind institutional {
    label en official "an insurance business: any business that is not a noninsurance business (section 465(c)(7)(D)(v)(II))";
}
rule InsuranceBusinessIsNotNoninsurance(business: Integer, p: Person) defeasible {
    label en official "a business that is not a noninsurance business is an insurance business (section 465(c)(7)(D)(v)(II)); the business must be a business of a taxpayer in the case";
    when engaged_in_activity_for_465(p, business);
    when not_known(noninsurance_business_453Be3_465c7Dv(business));
    then insurance_business_465c7Dv(business);
}
pub relation c7C_deduction_test_met_465(p: Person, business: Integer, y: TaxableYear) kind institutional {
    label en official "clause (iii) of subparagraph (C) is met: deductions exceed 15 percent of gross income, or the test does not apply to the insurance business of a qualified life insurance company (section 465(c)(7)(C)(iii), (D)(v)(I))";
}
rule DeductionTestMetByFifteenPercent(p: Person, business: Integer, y: TaxableYear, ded: Money, income: Money) defeasible {
    label en official "deductions attributable to the business exceed 15 percent of its gross income (section 465(c)(7)(C)(iii))";
    when c7C_deductions_for_test_465c7Diii(p, business, y, ded);
    when c7C_gross_income_for_test_465c7Div(p, business, y, income);
    when ded > income * 0.15;
    then c7C_deduction_test_met_465(p, business, y);
}
@source(IRC_S465_C, quote = "Clause (iii) of subparagraph (C) shall not apply to any insurance business of a qualified life insurance company.")
rule DeductionTestDoesNotApplyToLifeInsuranceBusiness(p: Person, business: Integer, y: TaxableYear) defeasible {
    label en official "the 15-percent test does not apply to the insurance business of a qualified life insurance company (section 465(c)(7)(D)(v)(I))";
    when qualified_life_insurance_company_465c7Dv(p);
    when insurance_business_465c7Dv(business);
    when engaged_in_activity_for_465(p, business);
    when us.irc.core::year_of(p, y);
    then c7C_deduction_test_met_465(p, business, y);
}
pub relation business_is_equipment_leasing_465c7Eii(business: Integer) kind empirical {
    label en official "the business is equipment leasing as defined in paragraph (6) (section 465(c)(7)(E)(ii)(I))";
}
pub relation business_involves_master_recordings_films_or_similar_property_465c7EiiII(business: Integer) kind empirical {
    label en official "the business involves the use, exploitation, sale, lease, or other disposition of master sound recordings, motion picture films, video tapes, or tangible or intangible assets associated with literary, artistic, musical, or similar properties (section 465(c)(7)(E)(ii)(II))";
}
pub relation taxpayer_at_risk_for_all_amounts_in_business_465c7Eiii(p: Person, business: Integer) kind empirical {
    label en official "the taxpayer is at risk with respect to all amounts paid or incurred (or chargeable to capital account) in the business (section 465(c)(7)(E)(iii)(I))";
}
pub relation business_is_licensed_communications_service_465c7EiiiII(business: Integer) kind empirical {
    label en official "the business provides radio, television, cable television, or similar services under a license or franchise granted by the Federal Communications Commission or another Federal, State, or local authority (section 465(c)(7)(E)(iii)(II))";
}
pub relation excluded_business_of_taxpayer_465c7E(p: Person, business: Integer) kind institutional {
    label en official "an excluded business: equipment leasing, or a master-recording, film, or literary, artistic, musical property business, unless the taxpayer is at risk for all amounts in it or it is a licensed communications service (section 465(c)(7)(E)(ii)-(iii))";
}
@source(IRC_S465_C, quote = "(I) equipment leasing (as defined in paragraph (6)), and")
rule ExcludedBusinessEquipmentLeasing(p: Person, business: Integer) defeasible {
    label en official "equipment leasing is an excluded business (section 465(c)(7)(E)(ii)(I))";
    when engaged_in_activity_for_465(p, business);
    when business_is_equipment_leasing_465c7Eii(business);
    then excluded_business_of_taxpayer_465c7E(p, business);
}
@source(IRC_S465_C, quote = "any business involving the use, exploitation, sale, lease, or other disposition of master sound recordings, motion picture films, video tapes, or tangible or intangible assets associated with literary, artistic, musical, or similar properties.")
rule ExcludedBusinessMasterRecordingsAndSimilar(p: Person, business: Integer) defeasible {
    label en official "a business in master sound recordings, films, video tapes, or literary, artistic, musical properties is excluded unless the taxpayer is at risk for all amounts in it or it is a licensed communications service (section 465(c)(7)(E)(ii)(II), (iii))";
    when engaged_in_activity_for_465(p, business);
    when business_involves_master_recordings_films_or_similar_property_465c7EiiII(business);
    when not_known(taxpayer_at_risk_for_all_amounts_in_business_465c7Eiii(p, business));
    when not_known(business_is_licensed_communications_service_465c7EiiiII(business));
    then excluded_business_of_taxpayer_465c7E(p, business);
}
pub relation c7C_not_excluded_business_test_met_465(p: Person, business: Integer) kind institutional {
    label en official "clause (iv) of subparagraph (C) is met: the business is not an excluded business";
}
rule NotExcludedBusinessTestMet(p: Person, business: Integer) defeasible {
    label en official "an active business that is not excluded satisfies clause (iv) (section 465(c)(7)(C)(iv))";
    when engaged_in_activity_for_465(p, business);
    when not_known(excluded_business_of_taxpayer_465c7E(p, business));
    then c7C_not_excluded_business_test_met_465(p, business);
}
@source(IRC_S465_C, quote = "the term \"qualifying business\" means any active business if—")
rule QualifyingBusinessFromComponentTests(p: Person, business: Integer, y: TaxableYear) defeasible {
    label en official "a qualifying business meets all four (C) tests; the tests are derived from employee-level and deduction-level facts, with the (D) special rules (section 465(c)(7)(C)-(E)); the legacy stage 2c rule is kept";
    when c7C_management_employee_test_met_465(p, business);
    when c7C_nonowner_employee_test_met_465(p, business);
    when c7C_deduction_test_met_465(p, business, y);
    when c7C_not_excluded_business_test_met_465(p, business);
    then is_qualifying_business_465c7C(p, business, y);
}
// --- (F), (G): affiliated groups ---
pub relation includible_corporation_1504_465c7Fiii(p: Person) kind empirical {
    label en official "the corporation is an includible corporation as defined in section 1504 (section 465(c)(7)(F)(iii))";
}
pub relation member_of_affiliated_group_465c7F(p: Person, group: Integer) kind empirical {
    label en official "the corporation is a member of the affiliated group (section 465(c)(7)(F)(iii))";
}
pub relation affiliated_group_1504a_files_consolidated_465c7Fii(group: Integer) kind empirical {
    label en official "the group is an affiliated group as defined in section 1504(a) that files or is required to file consolidated income tax returns (section 465(c)(7)(F)(ii))";
}
pub relation component_member_of_affiliated_group_465c7Fiii(p: Person, group: Integer) kind institutional {
    label en official "a component member: an includible corporation that is a member of the affiliated group of corporations (section 465(c)(7)(F)(ii)-(iii))";
}
rule ComponentMemberOfAffiliatedGroup(p: Person, group: Integer) strict {
    label en official "an includible corporation that is a member of a consolidated affiliated group is a component member (section 465(c)(7)(F)(ii)-(iii))";
    when includible_corporation_1504_465c7Fiii(p);
    when member_of_affiliated_group_465c7F(p, group);
    when affiliated_group_1504a_files_consolidated_465c7Fii(group);
    then component_member_of_affiliated_group_465c7Fiii(p, group);
}
pub relation treated_as_single_taxpayer_465c7F(p: Person, q: Person, group: Integer) kind institutional {
    label en official "two component members of one affiliated group are treated as a single taxpayer for section 465(c)(7) (section 465(c)(7)(F)(i)); summing their employees and amounts is left to the caller's group-adjusted inputs";
}
@source(IRC_S465_C, quote = "the component members of an affiliated group of corporations shall be treated as a single taxpayer.")
rule AffiliatedGroupMembersAreOneTaxpayer(p: Person, q: Person, group: Integer) strict {
    label en official "component members of one affiliated group are one taxpayer (section 465(c)(7)(F)(i)); the (G) limit on loss offsets is a separate relation";
    when component_member_of_affiliated_group_465c7Fiii(p, group);
    when component_member_of_affiliated_group_465c7Fiii(q, group);
    when p != q;
    then treated_as_single_taxpayer_465c7F(p, q, group);
}
pub relation member_loss_may_not_offset_income_465c7G(loss_member: Person, income_member: Person, group: Integer) kind institutional {
    label en official "the loss of a member of an affiliated group may not be used to offset the income of another member that is a personal holding company or a personal service corporation (5 percent) (section 465(c)(7)(G))";
}
@source(IRC_S465_C, quote = "Nothing in this paragraph shall permit any loss of a member of an affiliated group to be used as an offset against the income of any other member of such group which is a personal holding company")
rule MemberLossNotOffsetAgainstPhcOrPscMember(loss_member: Person, income_member: Person, group: Integer) defeasible {
    label en official "no offset of a member's loss against the income of a PHC or 5-percent PSC member of the group (section 465(c)(7)(G))";
    when treated_as_single_taxpayer_465c7F(loss_member, income_member, group);
    when is_personal_holding_company_542a(income_member);
    then member_loss_may_not_offset_income_465c7G(loss_member, income_member, group);
}
rule MemberLossNotOffsetAgainstPscMember(loss_member: Person, income_member: Person, group: Integer) defeasible {
    label en official "no offset of a member's loss against the income of a 5-percent personal service corporation member (section 465(c)(7)(G))";
    when treated_as_single_taxpayer_465c7F(loss_member, income_member, group);
    when is_personal_service_corporation_269A_five_percent(income_member);
    then member_loss_may_not_offset_income_465c7G(loss_member, income_member, group);
}

// ===================== Section 465(b)(6): qualified nonrecourse financing =====================

pub relation financing_borrowed_with_respect_to_holding_real_property_465b6Bi(loan: Integer) kind empirical {
    label en official "the financing is borrowed by the taxpayer with respect to the activity of holding real property (section 465(b)(6)(B)(i))";
}
pub relation financing_from_qualified_person_or_government_465b6Bii(loan: Integer) kind empirical {
    label en official "the financing is borrowed from a qualified person (section 49(a)(1)(D)(iv), applied without subclause (I) for commercially reasonable related-person financing, (D)(ii)) or is a loan from, or guaranteed by, a Federal, State, or local government or instrumentality (section 465(b)(6)(B)(ii))";
}
pub relation no_person_personally_liable_for_repayment_465b6Biii(loan: Integer) kind empirical {
    label en official "no person is personally liable for repayment, except to the extent provided in regulations (section 465(b)(6)(B)(iii))";
}
pub relation financing_is_convertible_debt_465b6Biv(loan: Integer) kind empirical {
    label en official "the financing is convertible debt (section 465(b)(6)(B)(iv), negated)";
}
pub relation qualified_nonrecourse_financing_derived_465b6B(loan: Integer) kind institutional {
    label en official "qualified nonrecourse financing: the (B)(i)-(iv) conditions, derived from their component facts";
}
@source(IRC_S465_B, quote = "the term \"qualified nonrecourse financing\" means any financing—")
rule QualifiedNonrecourseFinancingDerived(loan: Integer) strict {
    label en official "all four (B) conditions (section 465(b)(6)(B)(i)-(iv))";
    when financing_borrowed_with_respect_to_holding_real_property_465b6Bi(loan);
    when financing_from_qualified_person_or_government_465b6Bii(loan);
    when no_person_personally_liable_for_repayment_465b6Biii(loan);
    when not_known(financing_is_convertible_debt_465b6Biv(loan));
    then qualified_nonrecourse_financing_derived_465b6B(loan);
}
pub relation holding_of_real_property_or_incidental_personal_property_or_services_465b6Ei(activity: Integer) kind empirical {
    label en official "the activity is the holding of real property, or of personal property and the providing of services incidental to making real property available as living accommodations (section 465(b)(6)(E)(i))";
}
pub relation holding_of_mineral_property_465b6Eii(activity: Integer) kind empirical {
    label en official "the activity is the holding of mineral property (section 465(b)(6)(E)(ii))";
}
pub relation activity_of_holding_real_property_465b6E(activity: Integer) kind institutional {
    label en official "the activity of holding real property: it includes incidental personal property and living-accommodation services and excludes the holding of mineral property (section 465(b)(6)(E))";
}
@source(IRC_S465_B, quote = "The activity of holding real property shall not include the holding of mineral property.")
rule ActivityOfHoldingRealProperty(activity: Integer) defeasible {
    label en official "holding real property (with incidental personal property and services), other than mineral property (section 465(b)(6)(E)(i)-(ii))";
    when holding_of_real_property_or_incidental_personal_property_or_services_465b6Ei(activity);
    when not_known(holding_of_mineral_property_465b6Eii(activity));
    then activity_of_holding_real_property_465b6E(activity);
}
pub relation financing_secured_by_real_property_used_in_activity_465b6A(loan: Integer, activity: Integer) kind empirical {
    label en official "the financing is secured by real property used in the activity (section 465(b)(6)(A))";
}
pub relation partner_share_of_partnership_liability_for_financing_752_465b6C(p: Person, loan: Integer, amount: Money) kind empirical {
    label en official "the partner's share of the partnership's liabilities incurred in connection with the financing, within the meaning of section 752 (section 465(b)(6)(C))";
}
pub relation borrowing_is_partnership_financing_465b6C(loan: Integer) kind empirical {
    label en official "the qualified nonrecourse financing is a liability of a partnership (section 465(b)(6)(C))";
}
@source(IRC_S465_B, quote = "a taxpayer shall be considered at risk with respect to the taxpayer's share of any qualified nonrecourse financing which is secured by real property used in such activity.")
rule QualifiedNonrecourseFinancingAtRiskDerivedPartner(p: Person, loan: Integer, activity: Integer, amount: Money, share: Money) defeasible {
    label en official "in the activity of holding real property a partner is at risk for its section 752 share of qualified nonrecourse financing secured by real property used in the activity (section 465(b)(6)(A), (C))";
    when loan_for_activity(loan, activity, amount);
    when activity_of_holding_real_property_465b6E(activity);
    when financing_secured_by_real_property_used_in_activity_465b6A(loan, activity);
    when qualified_nonrecourse_financing_derived_465b6B(loan);
    when borrowing_is_partnership_financing_465b6C(loan);
    when partner_share_of_partnership_liability_for_financing_752_465b6C(p, loan, share);
    then loan_amount_at_risk_465b(p, loan, share);
}
rule QualifiedNonrecourseFinancingAtRiskDerivedDirect(p: Person, loan: Integer, activity: Integer, amount: Money) defeasible {
    label en official "outside a partnership the taxpayer's share is the whole qualified nonrecourse financing borrowed for the activity (section 465(b)(6)(A))";
    when loan_for_activity(loan, activity, amount);
    when activity_of_holding_real_property_465b6E(activity);
    when financing_secured_by_real_property_used_in_activity_465b6A(loan, activity);
    when qualified_nonrecourse_financing_derived_465b6B(loan);
    when not_known(borrowing_is_partnership_financing_465b6C(loan));
    when taxpayer_borrower_of_financing_465b6(p, loan);
    then loan_amount_at_risk_465b(p, loan, amount);
}
pub relation taxpayer_borrower_of_financing_465b6(p: Person, loan: Integer) kind empirical {
    label en official "the taxpayer is the borrower of the financing (section 465(b)(6)(B)(i))";
}
