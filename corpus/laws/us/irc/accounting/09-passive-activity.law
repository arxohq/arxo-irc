// Section 469 — Passive activity losses and credits limited. Stage 1b
// (IRC-07), priority section. Scope: (a) disallowance; (b) carryover to next
// year; (c)(1) passive activity definition (material participation as a
// DECISION-0194 evaluative channel, with the regulatory safe-harbor tests of
// the Secretary's regulations as an EXTERNAL_DEPENDENCY — no us.irc.* owner
// formalizes 26 CFR 1.469-5T); (d)(1) the passive activity loss computation;
// (i) the $25,000 active-participation rental-real-estate offset with the
// 50%-over-$100,000 AGI phase-out. (c)(2)-(7), (d)(2) credits, (e)-(g)
// special income rules and dispositions, (h)(2)-(5) limited-partner and
// closely-held-corporation material-participation tests, (j)-(l) are NOT
// DONE this round.

use self::{
    IRC_S469_A,
    IRC_S469_B,
    IRC_S469_C,
    IRC_S469_D,
    IRC_S469_I,
    Person,
    TaxableYear,
    aggregate_passive_activity_losses_after_earlier_limitations,
    deemed_materially_participating_469h,
    is_trade_or_business_for_469,
    passive_activity_loss_taken_into_account_under_469a,
    person_described_in_469a2,
    rental_activity_469,
    rental_real_estate_exempt_from_469c2,
    working_interest_excluded_469c3,
};

pub relation is_469a_person(p: Person) kind empirical {
    label en official "the taxpayer is a person described in section 469(a)(2): an individual, estate, trust, closely held C corporation, or personal service corporation (case-asserted classification)";
}
pub relation conducts_trade_or_business_activity(p: Person, activity: Integer) kind empirical {
    label en official "the activity involves the conduct of a trade or business (section 469(c)(1)(A))";
}
// "materially participates" (h)(1): "regular, continuous, and substantial"
// involvement — an open-textured DECISION-0194 evaluative standard. The
// Secretary's regulations (26 CFR 1.469-5T) supply numbered safe-harbor
// tests (e.g. 500-hours) that would let a case satisfy this WITHOUT
// adjudication; those regulatory tests are an EXTERNAL_DEPENDENCY this
// package does not formalize (no us.irc.* owner) — see accounting.deps.json.
external judgment relation materially_participates_469(p: Person, activity: Integer, y: TaxableYear) {
    authority Secretary;
    label en official "the taxpayer is involved in the operations of the activity on a basis which is regular, continuous, and substantial (section 469(h)(1))";
}
pub relation is_passive_activity(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the activity is a passive activity: a trade or business in which the taxpayer does not materially participate (section 469(c)(1))";
}
@source(IRC_S469_C, quote = "The term \"passive activity\" means any activity")
rule PassiveActivityDefinitionNotMaterial(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a trade-or-business activity is passive unless the taxpayer materially participates (section 469(c)(1))";
    when is_trade_or_business_for_469(p, activity);
    when us.irc.core::year_of(p, y);
    when not materially_participates_469(p, activity, y);
    unless working_interest_excluded_469c3(p, activity, y);
    unless deemed_materially_participating_469h(p, activity, y);
    then is_passive_activity(p, activity, y);
}
pub relation is_rental_activity(p: Person, activity: Integer) kind empirical {
    label en official "the activity is a rental activity (section 469(c)(2)) — the (c)(7) real-property-trade-or-business exception is not separately tested this round";
}
@source(IRC_S469_C, quote = "Except as provided in paragraph (7), the term \"passive activity\" includes any rental activity.")
rule PassiveActivityIncludesRental(p: Person, activity: Integer, y: TaxableYear) defeasible {
    label en official "a rental activity is a passive activity regardless of material participation, absent the (c)(7) real-estate-professional exception (section 469(c)(2))";
    when rental_activity_469(p, activity);
    when us.irc.core::year_of(p, y);
    unless rental_real_estate_exempt_from_469c2(p, activity, y);
    then is_passive_activity(p, activity, y);
}

// --- (a)/(b)/(d)(1): disallowance, carryover, the PAL computation ---

pub relation aggregate_passive_activity_losses(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate losses from all passive activities for the taxable year (section 469(d)(1)(A))";
}
pub relation aggregate_passive_activity_income(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate income from all passive activities for the taxable year (section 469(d)(1)(B))";
}
pub relation passive_activity_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity loss: the excess (if any) of aggregate passive losses over aggregate passive income (section 469(d)(1))";
}
@source(IRC_S469_D, quote = "The term \"passive activity loss\" means the amount (if any) by which")
rule PassiveActivityLossComputation(p: Person, y: TaxableYear, losses: Money, income: Money) defeasible {
    label en official "the passive activity loss is the excess of aggregate passive losses (after the earlier limitations of sections 461(j), 461(l) and 470, stage 4) over aggregate passive income, floored at zero (section 469(d)(1))";
    when aggregate_passive_activity_losses_after_earlier_limitations(p, y, losses);
    when aggregate_passive_activity_income(p, y, income);
    then passive_activity_loss(p, y, max(0.00 USD, losses - income));
}
pub relation passive_activity_loss_allowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the passive activity loss allowed for the taxable year, after (a) disallowance and the (i) $25,000 offset (pub interface: `passive_activity_loss_allowed`)";
}
pub relation passive_activity_loss_disallowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the passive activity loss disallowed for the taxable year (section 469(a)(1)(A))";
}
@source(IRC_S469_A, quote = "If for any taxable year the taxpayer is described in paragraph (2), neither")
rule PassiveActivityLossDisallowedByDefault(p: Person, y: TaxableYear, pal: Money, offset: Money) defeasible {
    label en official "the passive activity loss (less the part allowable against net active income under section 469(e)(2)(A)(ii), stage 4) is disallowed for a section 469(a)(2) person, net of the section 469(i) offset (section 469(a)(1))";
    when person_described_in_469a2(p);
    when passive_activity_loss_taken_into_account_under_469a(p, y, pal);
    when section_469i_offset_allowed(p, y, offset);
    when pal > offset;
    then passive_activity_loss_disallowed(p, y, round(pal - offset, 2, "HALF_UP"));
}
rule PassiveActivityLossAllowedIsOffsetWhenBelowOffset(p: Person, y: TaxableYear, pal: Money, offset: Money) defeasible {
    label en official "the entire passive activity loss (less the part allowable under section 469(e)(2)(A)(ii), stage 4) is allowed (through the section 469(i) offset) when it does not exceed the offset (section 469(a)(1), (i)(1))";
    when person_described_in_469a2(p);
    when passive_activity_loss_taken_into_account_under_469a(p, y, pal);
    when section_469i_offset_allowed(p, y, offset);
    when pal <= offset;
    then passive_activity_loss_allowed(p, y, pal);
}
rule PassiveActivityLossAllowedIsOffsetPortion(p: Person, y: TaxableYear, offset: Money) defeasible {
    label en official "the section 469(i) offset amount is allowed even when part of the loss remains disallowed (section 469(i)(1))";
    when passive_activity_loss_disallowed(p, y, _);
    when section_469i_offset_allowed(p, y, offset);
    then passive_activity_loss_allowed(p, y, offset);
}
pub relation passive_activity_loss_carryover_to_next_year(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the disallowed passive activity loss, treated as a deduction allocable to the activity in the next taxable year (section 469(b))";
}
@source(IRC_S469_B, quote = "any loss or credit from an activity which is disallowed under subsection (a) shall be treated as a deduction or credit allocable to such activity in the next taxable year")
rule PassiveActivityLossCarryoverComputation(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "a disallowed passive activity loss carries over to the next taxable year (section 469(b))";
    when passive_activity_loss_disallowed(p, y, amount);
    then passive_activity_loss_carryover_to_next_year(p, y, amount);
}

// --- (i): the $25,000 active-participation rental-real-estate offset ---

pub relation actively_participates_in_rental_real_estate(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer actively participates in one or more rental real estate activities during the taxable year (section 469(i)(1), (i)(6))";
}
pub relation passive_loss_attributable_to_active_rental_real_estate(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the passive activity loss attributable to rental real estate activities in which the taxpayer actively participated (section 469(i)(1))";
}
pub relation adjusted_gross_income_469i(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "adjusted gross income for purposes of the section 469(i)(3) phase-out, determined without regard to the section 469(i)(3)(E) add-backs (SIMPLIFICATION: the case supplies this figure already adjusted; the (E) add-back computation is not separately modelled)";
}
pub relation section_469i_dollar_limit(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the $25,000 offset ceiling, reduced (not below zero) by 50 percent of AGI over $100,000 (section 469(i)(2)-(3)(A))";
}
@source(IRC_S469_I, quote = "the $25,000 amount under paragraph (2) shall be reduced (but not below zero) by 50 percent of the amount by which the adjusted gross income of the taxpayer for the taxable year exceeds $100,000")
rule Section469iDollarLimitPhaseOut(p: Person, y: TaxableYear, agi: Money) strict {
    label en official "the $25,000 ceiling phases out at 50 cents per dollar of AGI over $100,000, reaching zero at $150,000 AGI (section 469(i)(2)-(3)(A))";
    when actively_participates_in_rental_real_estate(p, y);
    when adjusted_gross_income_469i(p, y, agi);
    then section_469i_dollar_limit(p, y, max(0.00 USD, min(PassiveActivityOffsetDollarLimit, round(PassiveActivityOffsetDollarLimit - round((agi - PassiveActivityOffsetAgiThreshold) * 0.5, 2, "HALF_UP"), 2, "HALF_UP"))));
}
pub relation section_469i_offset_allowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of passive activity loss attributable to active-participation rental real estate that section 469(a) does not disallow, up to the phased-out dollar limit (section 469(i)(1)-(2))";
}
@source(IRC_S469_I, quote = "subsection (a) shall not apply to that portion of the passive activity loss")
rule Section469iOffsetAllowed(p: Person, y: TaxableYear, attributable: Money, limit: Money) strict {
    label en official "the section 469(i) offset is the lesser of the attributable passive loss and the phased-out dollar limit (section 469(i)(1)-(2))";
    when passive_loss_attributable_to_active_rental_real_estate(p, y, attributable);
    when section_469i_dollar_limit(p, y, limit);
    then section_469i_offset_allowed(p, y, min(attributable, limit));
}
rule NoOffsetWhenNotActivelyParticipating(p: Person, y: TaxableYear) defeasible {
    label en official "no section 469(i) offset applies absent active participation (section 469(i)(1))";
    when us.irc.core::year_of(p, y);
    when not actively_participates_in_rental_real_estate(p, y);
    then section_469i_offset_allowed(p, y, 0.00 USD);
}

// (c)(3)-(7) working interests, real-estate-professional and other passive-
// activity refinements; (d)(2) passive activity credit; (e)-(g) special
// income rules, former-passive treatment, dispositions; (h)(2)-(5) limited-
// partner/closely-held-corporation material-participation tests; (j)-(l)
// definitions are NOT DONE this round.
