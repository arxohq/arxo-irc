// Sections 468A and 468B (stage 3, DECISION-0379 with deontics): the elective
// Nuclear Decommissioning Reserve Fund and designated settlement funds.
//
// Model: the annual step. A Fund is a `Person` (section 468A(e)(2)(C) treats it
// as a corporation for subtitle F); nuclear powerplants and settlement
// liabilities are case-numbered integers. The ruling amount (section 468A(d))
// is the Secretary's determination, asserted as a case fact; the 20-percent
// Fund tax is the A3 parameter `NuclearDecommissioningFundTaxRate` (pinned
// text, effective for taxable years beginning after 1993); the maximum rate of
// section 1(e) in section 468B(b)(1) is a case fact (pending dependency on the
// income-individual owner).
//
// Not modelled (TECH-GAPS G4800+): aggregation over several payments or
// distributions (a payment is one total per taxpayer, plant and year), the
// present-value computation of section 468A(f)(1), regulations
// (section 468A(c)(1)(B), (e)(5), 468B(d)(2) timing, 468B(f), (g)(1)).

// ===================== Section 468A =====================

use self::{
    IRC_S468A_A,
    IRC_S468A_B,
    IRC_S468A_C,
    IRC_S468A_D,
    IRC_S468A_E,
    IRC_S468A_F,
    IRC_S468A_G,
    IRC_S468A_H,
    IRC_S468B_A,
    IRC_S468B_B,
    IRC_S468B_C,
    IRC_S468B_D,
    IRC_S468B_E,
    IRC_S468B_F,
    IRC_S468B_G,
    Person,
    Secretary,
    TaxableYear,
    economic_performance_established_461h,
};

pub relation is_nuclear_powerplant_468A(plant: Integer) kind empirical {
    label en official "the property is a nuclear powerplant, including any unit thereof (section 468A(g))";
}
pub relation is_unit_of_nuclear_powerplant_468A(plant: Integer, unit: Integer) kind empirical {
    label en official "the unit is a unit of the nuclear powerplant (section 468A(g))";
}
pub relation nuclear_powerplant_term_includes_unit_468Ag(unit: Integer) kind institutional {
    label en official "for purposes of section 468A the term 'nuclear powerplant' includes any unit thereof (section 468A(g))";
}
@source(IRC_S468A_G, quote = "the term \"nuclear powerplant\" includes any unit thereof.")
rule NuclearPowerplantIncludesUnit(plant: Integer, unit: Integer) strict {
    label en official "a unit of a nuclear powerplant is a nuclear powerplant for section 468A (section 468A(g))";
    when is_nuclear_powerplant_468A(plant);
    when is_unit_of_nuclear_powerplant_468A(plant, unit);
    then nuclear_powerplant_term_includes_unit_468Ag(unit);
}
pub relation elects_nuclear_decommissioning_fund_468A(p: Person, y: TaxableYear, plant: Integer) kind empirical {
    label en official "the taxpayer elects the application of section 468A for the taxable year with respect to the nuclear powerplant (section 468A(a))";
}
pub relation nuclear_decommissioning_election_in_effect_468A(p: Person, y: TaxableYear, plant: Integer) kind institutional {
    label en official "the section 468A election is in effect for the taxable year and nuclear powerplant";
}
@source(IRC_S468A_A, quote = "If the taxpayer elects the application of this section")
rule Section468AaElectionPower(p: Person, y: TaxableYear, plant: Integer) strict {
    label en official "a taxpayer may elect the application of section 468A for a nuclear powerplant (section 468A(a)); effective July 18, 1984 (note 6)";
    when elects_nuclear_decommissioning_fund_468A(p, y, plant);
    then power Section468aNuclearElection {
        holder p;
        over plant;
        exercise elects_nuclear_decommissioning_fund_468A(p, y, plant);
        valid_when is_nuclear_powerplant_468A(plant);
        effect create(nuclear_decommissioning_election_in_effect_468A(p, y, plant));
        window [@1984-07-18, infinity);
    };
}

// --- (e)(1), (e)(7): establishing and terminating the Fund (duties) ---

pub relation nuclear_decommissioning_fund_established_468Ae1(p: Person, plant: Integer) kind empirical {
    label en official "the taxpayer has established a Nuclear Decommissioning Reserve Fund with respect to the nuclear powerplant (section 468A(e)(1))";
}
@source(IRC_S468A_E, quote = "shall establish a Nuclear Decommissioning Reserve Fund with respect to each nuclear powerplant to which such election applies.")
rule Section468aE1EstablishFundDuty(p: Person, y: TaxableYear, plant: Integer) defeasible {
    label en official "each electing taxpayer must establish a Fund for each powerplant to which the election applies (section 468A(e)(1))";
    when nuclear_decommissioning_election_in_effect_468A(p, y, plant);
    then duty Section468aE1EstablishFund {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition nuclear_decommissioning_fund_established_468Ae1(p, plant);
            window [-infinity, infinity];
        }
    };
}
pub relation substantial_completion_of_decommissioning_468Ae7(plant: Integer) kind empirical {
    label en official "the nuclear decommissioning of the nuclear powerplant is substantially completed (section 468A(e)(7))";
}
pub relation nuclear_decommissioning_fund_terminated_468Ae7(p: Person, plant: Integer) kind empirical {
    label en official "the taxpayer has terminated the Fund of the nuclear powerplant (section 468A(e)(7))";
}
@source(IRC_S468A_E, quote = "Upon substantial completion of the nuclear decommissioning of the nuclear powerplant with respect to which a Fund relates, the taxpayer shall terminate such Fund.")
rule Section468aE7TerminateFundDuty(p: Person, y: TaxableYear, plant: Integer) defeasible {
    label en official "upon substantial completion of the decommissioning the taxpayer must terminate the Fund (section 468A(e)(7))";
    when nuclear_decommissioning_election_in_effect_468A(p, y, plant);
    when substantial_completion_of_decommissioning_468Ae7(plant);
    then duty Section468aE7TerminateFund {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition nuclear_decommissioning_fund_terminated_468Ae7(p, plant);
            window [-infinity, infinity];
        }
    };
}

// --- (d): the ruling amount and the schedule request ---

pub relation ruling_schedule_requested_468Ad1(p: Person, plant: Integer) kind empirical {
    label en official "the taxpayer has requested from the Secretary a schedule of ruling amounts (section 468A(d)(1))";
}
pub relation ruling_schedule_received_468Ad1(p: Person, plant: Integer) kind empirical {
    label en official "the taxpayer has received from the Secretary a schedule of ruling amounts (section 468A(d)(1))";
}
pub relation operating_license_renewed_468Ad1(plant: Integer) kind empirical {
    label en official "the operating license of the nuclear powerplant is renewed (section 468A(d)(1), second sentence)";
}
pub relation ruling_schedule_requested_upon_renewal_468Ad1(p: Person, plant: Integer) kind empirical {
    label en official "the taxpayer has requested a schedule of ruling amounts upon the renewal of the operating license";
}
@source(IRC_S468A_D, quote = "the taxpayer shall request a schedule of ruling amounts upon each renewal of the operating license of the nuclear powerplant.")
rule Section468aD1RequestUponRenewalDuty(p: Person, y: TaxableYear, plant: Integer) defeasible {
    label en official "on each renewal of the operating license the taxpayer must request a schedule of ruling amounts (section 468A(d)(1)); the request is 'upon' the renewal and the text gives no other window";
    when nuclear_decommissioning_election_in_effect_468A(p, y, plant);
    when operating_license_renewed_468Ad1(plant);
    then duty Section468aD1RequestScheduleOnRenewal {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition ruling_schedule_requested_upon_renewal_468Ad1(p, plant);
            window [-infinity, infinity];
        }
    };
}
pub relation ruling_amount_468A(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind empirical {
    label en official "the ruling amount applicable to the taxable year: the amount the Secretary determines under paragraph (1) necessary to fund the total nuclear decommissioning costs over the plant's estimated useful life without excessive or faster-than-level funding (section 468A(d)(2)); the Secretary's determination is asserted";
}
pub relation ruling_schedule_reviewed_by_secretary_468Ad3(p: Person, plant: Integer) kind empirical {
    label en official "the Secretary has reviewed, and revised if necessary, the schedule of ruling amounts (section 468A(d)(3))";
}
@source(IRC_S468A_D, quote = "The Secretary shall at least once during the useful life of the nuclear powerplant (or, more frequently, upon the request of the taxpayer) review, and revise if necessary, the schedule of ruling amounts determined under paragraph (1).")
rule Section468aD3SecretaryReviewDuty(p: Person, y: TaxableYear, plant: Integer) defeasible {
    label en official "the Secretary must review the schedule at least once in the plant's useful life (section 468A(d)(3)); modelled as an achievement goal because a recurring duty is not parsed (the 'more frequently on request' branch is not separately timed)";
    when ruling_schedule_received_468Ad1(p, plant);
    then duty Section468aD3ReviewSchedule {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition ruling_schedule_reviewed_by_secretary_468Ad3(p, plant);
            window [-infinity, infinity];
        }
    };
}

// --- (a), (b), (h): the deduction for payments into the Fund ---

pub relation payment_to_fund_468A(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind empirical {
    label en official "the total of payments made by the taxpayer to the Nuclear Decommissioning Reserve Fund during the taxable year (section 468A(a)); one total per taxpayer, plant and year";
}
pub relation payment_on_account_of_year_after_close_468Ah(p: Person, y: TaxableYear, plant: Integer, amount: Money, paid_on: Date) kind empirical {
    label en official "a payment to the Fund that is made on account of the taxable year after its close, with the date paid (section 468A(h))";
}
pub relation payment_deemed_made_last_day_of_year_468Ah(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "a payment made on account of the year within 2½ months after its close is deemed made on the last day of the year (section 468A(h))";
}
@source(IRC_S468A_H, quote = "a taxpayer shall be deemed to have made a payment to the Fund on the last day of a taxable year if such payment is made on account of such taxable year and is made within 2½ months after the close of such taxable year.")
rule PaymentWithinTwoAndHalfMonthsDeemedMadeLastDay(p: Person, y: TaxableYear, plant: Integer, amount: Money, paid_on: Date, year_end: Date) strict {
    label en official "2½ months is counted as 2 calendar months and 15 days after the last day of the taxable year (JUDGMENT CALL: the text says '2½ months') (section 468A(h))";
    when payment_on_account_of_year_after_close_468Ah(p, y, plant, amount, paid_on);
    when us.irc.core::ends(y, year_end);
    when paid_on > year_end;
    when paid_on <= add_calendar_period(add_calendar_period(year_end, 2 calendar_month), 15 calendar_day);
    then payment_deemed_made_last_day_of_year_468Ah(p, y, plant, amount);
}
pub relation fund_payment_counted_for_year_468A(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the payment treated as made to the Fund in the taxable year: an actual payment or one deemed made on the last day (section 468A(a), (h))";
}
rule ActualPaymentCounted(p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "a payment made during the year counts for the year (section 468A(a))";
    when payment_to_fund_468A(p, y, plant, amount);
    then fund_payment_counted_for_year_468A(p, y, plant, amount);
}
rule DeemedPaymentCounted(p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "a payment deemed made on the last day of the year counts for the year (section 468A(h))";
    when payment_deemed_made_last_day_of_year_468Ah(p, y, plant, amount);
    then fund_payment_counted_for_year_468A(p, y, plant, amount);
}
pub relation ruling_schedule_condition_met_468Ad1(p: Person, plant: Integer) kind institutional {
    label en official "the taxpayer has requested and received a schedule of ruling amounts (section 468A(d)(1), first sentence)";
}
rule RulingScheduleRequestedAndReceived(p: Person, plant: Integer) strict {
    label en official "a payment deduction requires both a request and receipt of the schedule (section 468A(d)(1))";
    when ruling_schedule_requested_468Ad1(p, plant);
    when ruling_schedule_received_468Ad1(p, plant);
    then ruling_schedule_condition_met_468Ad1(p, plant);
}
pub relation nuclear_fund_payment_deduction_468Aa(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the deduction for payments to the Fund: the counted payments, limited to the ruling amount applicable to the year, and only where the schedule of ruling amounts was requested and received (section 468A(a), (b), (d)(1))";
}
@source(IRC_S468A_A, quote = "there shall be allowed as a deduction for any taxable year the amount of payments made by the taxpayer to a Nuclear Decommissioning Reserve Fund")
rule NuclearFundPaymentDeduction(p: Person, y: TaxableYear, plant: Integer, paid: Money, ruling: Money) defeasible {
    label en official "payments to the Fund are deductible up to the ruling amount for the year, when the election is in effect and the schedule was requested and received (section 468A(a), (b), (d)(1))";
    when nuclear_decommissioning_election_in_effect_468A(p, y, plant);
    when ruling_schedule_condition_met_468Ad1(p, plant);
    when fund_payment_counted_for_year_468A(p, y, plant, paid);
    when ruling_amount_468A(p, y, plant, ruling);
    then nuclear_fund_payment_deduction_468Aa(p, y, plant, min(paid, ruling));
}
pub relation nuclear_payment_above_ruling_amount_468Ab(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the part of a payment that exceeds the ruling amount, which the taxpayer may not pay into the Fund (section 468A(b))";
}
@source(IRC_S468A_B, quote = "The amount which a taxpayer may pay into the Fund for any taxable year shall not exceed the ruling amount applicable to such taxable year.")
rule PaymentAboveRulingAmountIsExcess(p: Person, y: TaxableYear, plant: Integer, paid: Money, ruling: Money) defeasible {
    label en official "a payment beyond the ruling amount is the excess that section 468A(b) forbids and that earns no deduction";
    when fund_payment_counted_for_year_468A(p, y, plant, paid);
    when ruling_amount_468A(p, y, plant, ruling);
    when paid > ruling;
    then nuclear_payment_above_ruling_amount_468Ab(p, y, plant, paid - ruling);
}

// --- (c): income and deductions of the taxpayer ---

pub relation fund_distribution_468A(d: Integer, p: Person, y: TaxableYear, plant: Integer, amount: Money) kind empirical {
    label en official "an amount distributed from the Fund to the taxpayer during the taxable year (section 468A(c)(1)(A))";
}
pub relation distribution_pays_fund_administrative_costs_468Ae4B(d: Integer) kind empirical {
    label en official "the distribution pays administrative costs (including taxes) and other incidental expenses of the Fund described in section 468A(e)(4)(B) (section 468A(c)(1)(A) exception)";
}
pub relation nuclear_fund_distribution_included_468Ac1A(d: Integer, p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount distributed from the Fund is included in the taxpayer's gross income, unless it pays the Fund's (e)(4)(B) costs (section 468A(c)(1)(A))";
}
@source(IRC_S468A_C, quote = "any amount distributed from the Fund during such taxable year, other than any amount distributed to pay costs described in subsection (e)(4)(B)")
rule FundDistributionIncludedInGrossIncome(d: Integer, p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "a distribution from the Fund is gross income of the taxpayer, except a distribution paying the Fund's own administrative costs (section 468A(c)(1)(A))";
    when fund_distribution_468A(d, p, y, plant, amount);
    when not_known(distribution_pays_fund_administrative_costs_468Ae4B(d));
    then nuclear_fund_distribution_included_468Ac1A(d, p, y, amount);
}
pub relation fund_of_taxpayer_468A(fund: Person, p: Person, plant: Integer) kind empirical {
    label en official "the Nuclear Decommissioning Reserve Fund maintained by the taxpayer for the nuclear powerplant (section 468A(e)(1))";
}
pub relation fund_violates_section_468A_or_4951_468Ae6(fund: Person) kind empirical {
    label en official "the Fund violates a provision of section 468A or section 4951 (section 468A(e)(6))";
}
pub relation secretary_disqualifies_fund_468Ae6(fund: Person) kind empirical {
    label en official "the Secretary determines to disqualify the Fund from the application of section 468A, the determination taking effect on its date (section 468A(e)(6))";
}
pub relation fund_disqualified_468Ae6(fund: Person) kind institutional {
    label en official "the Fund is disqualified from the application of section 468A (section 468A(e)(6))";
}
@source(IRC_S468A_E, quote = "the Secretary may disqualify such Fund from the application of this section.")
rule Section468aE6DisqualificationPower(fund: Person) strict {
    label en official "the Secretary may disqualify a Fund that violates section 468A or 4951 (section 468A(e)(6))";
    when secretary_disqualifies_fund_468Ae6(fund);
    then power Section468aE6DisqualifyFund {
        holder Secretary;
        over fund;
        exercise secretary_disqualifies_fund_468Ae6(fund);
        valid_when fund_violates_section_468A_or_4951_468Ae6(fund);
        effect create(fund_disqualified_468Ae6(fund));
        window [@1984-07-18, infinity);
    };
}
pub relation fund_assets_on_disqualification_468Ae6(fund: Person, amount: Money) kind empirical {
    label en official "all of the Fund's funds on the date the disqualification determination takes effect (section 468A(e)(6), second sentence)";
}
pub relation fund_deemed_distribution_468Ae6(fund: Person, amount: Money) kind institutional {
    label en official "a disqualified Fund is treated as having distributed all of its funds on the date the determination takes effect (section 468A(e)(6))";
}
@source(IRC_S468A_E, quote = "the Fund shall be treated as having distributed all of its funds on the date such determination takes effect.")
rule DisqualifiedFundDeemedToDistributeAllFunds(fund: Person, amount: Money) defeasible {
    label en official "disqualification is a deemed distribution of all the Fund's funds (section 468A(e)(6))";
    when fund_disqualified_468Ae6(fund);
    when fund_assets_on_disqualification_468Ae6(fund, amount);
    then fund_deemed_distribution_468Ae6(fund, amount);
}
pub relation nuclear_fund_deemed_distribution_included_468Ac1B(fund: Person, p: Person, plant: Integer, amount: Money) kind institutional {
    label en official "the amounts properly includible in gross income on a deemed distribution under section 468A(e)(6) are included in the taxpayer's gross income, except as regulations provide (section 468A(c)(1)(B))";
}
@source(IRC_S468A_C, quote = "amounts properly includible in gross income in the case of any deemed distribution under subsection (e)(6)")
rule DeemedDistributionIncludedInGrossIncome(fund: Person, p: Person, plant: Integer, amount: Money) defeasible {
    label en official "a deemed distribution on disqualification is included in the taxpayer's gross income (section 468A(c)(1)(B)); the regulatory exceptions are not modelled";
    when fund_of_taxpayer_468A(fund, p, plant);
    when fund_deemed_distribution_468Ae6(fund, amount);
    then nuclear_fund_deemed_distribution_included_468Ac1B(fund, p, plant, amount);
}
pub relation amount_includible_on_termination_or_disposition_468Ac1B(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind empirical {
    label en official "the amounts properly includible in gross income on a termination under section 468A(e)(7) or the disposition of an interest in the nuclear powerplant (section 468A(c)(1)(B)); the amount is set by regulations and asserted";
}
pub relation nuclear_termination_or_disposition_inclusion_468Ac1B(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the amount properly includible on termination of the Fund or disposition of an interest in the powerplant is included in gross income (section 468A(c)(1)(B))";
}
rule TerminationOrDispositionInclusion(p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "termination or disposition inclusion (section 468A(c)(1)(B))";
    when amount_includible_on_termination_or_disposition_468Ac1B(p, y, plant, amount);
    then nuclear_termination_or_disposition_inclusion_468Ac1B(p, y, plant, amount);
}
pub relation nuclear_decommissioning_costs_economic_performance_468Ac2(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind empirical {
    label en official "the amount of the nuclear decommissioning costs with respect to which economic performance (section 461(h)(2)) occurs during the taxable year (section 468A(c)(2))";
}
pub relation nuclear_decommissioning_cost_deduction_468Ac2(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the additional deduction, on top of the payment deduction, for nuclear decommissioning costs for which economic performance occurs in the year (section 468A(c)(2))";
}
@source(IRC_S468A_C, quote = "there shall be allowable as a deduction for any taxable year the amount of the nuclear decommissioning costs with respect to which economic performance (within the meaning of section 461(h)(2)) occurs during such taxable year.")
rule NuclearDecommissioningCostsDeductedOnEconomicPerformance(p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "decommissioning costs are deductible in the year of economic performance, in addition to the payment deduction (section 468A(c)(2))";
    when nuclear_decommissioning_election_in_effect_468A(p, y, plant);
    when nuclear_decommissioning_costs_economic_performance_468Ac2(p, y, plant, amount);
    then nuclear_decommissioning_cost_deduction_468Ac2(p, y, plant, amount);
}

// --- (e)(2)-(5): taxation and operation of the Fund ---

pub relation fund_gross_income_before_payment_exclusion_468Ae2(fund: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income of the Fund for the taxable year before excluding the taxpayer's deductible payments (section 468A(e)(2)(A))";
}
pub relation fund_payments_received_deducted_by_taxpayer_468Ae2Ai(fund: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "payments to the Fund with respect to which a deduction is allowable under subsection (a), excluded from the Fund's gross income (section 468A(e)(2)(A)(i))";
}
pub relation fund_deductible_administrative_costs_468Ae2Aii(fund: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid by the Fund that are described in paragraph (4)(B), not paid to the taxpayer, and deductible by a corporation, allowed as a deduction to the Fund (section 468A(e)(2)(A)(ii))";
}
pub relation fund_taxable_income_468Ae2(fund: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income of the Fund on which the tax is imposed: gross income less excluded payments and allowed administrative costs, floored at zero (JUDGMENT CALL on the floor) (section 468A(e)(2)(A))";
}
rule FundTaxableIncome(fund: Person, y: TaxableYear, gross: Money, excluded: Money, costs: Money) defeasible {
    label en official "the Fund's taxable base excludes deductible payments and allows administrative costs (section 468A(e)(2)(A)(i)-(ii))";
    when fund_gross_income_before_payment_exclusion_468Ae2(fund, y, gross);
    when fund_payments_received_deducted_by_taxpayer_468Ae2Ai(fund, y, excluded);
    when fund_deductible_administrative_costs_468Ae2Aii(fund, y, costs);
    then fund_taxable_income_468Ae2(fund, y, max(gross - excluded - costs, 0 USD));
}
pub relation nuclear_fund_tax_468Ae2(fund: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed on the gross income of the Fund at 20 percent (A3 parameter, taxable years beginning after 1993), one rounding to cents HALF_UP (JUDGMENT CALL) (section 468A(e)(2)(A))";
}
@source(IRC_S468A_E, quote = "There is hereby imposed on the gross income of the Fund for any taxable year a tax at the rate of 20 percent")
rule NuclearFundTaxAtTwentyPercent(fund: Person, y: TaxableYear, taxable: Money) defeasible {
    label en official "the Fund pays tax on its taxable base at the section 468A(e)(2)(A) rate (section 468A(e)(2)(A))";
    when fund_taxable_income_468Ae2(fund, y, taxable);
    then nuclear_fund_tax_468Ae2(fund, y, round(taxable * NuclearDecommissioningFundTaxRate, 2, "HALF_UP"));
}
pub relation fund_income_taxed_only_under_468Ae2B(fund: Person) kind institutional {
    label en official "the tax of paragraph (2)(A) is in lieu of any other taxation under subtitle A of the income from assets in the Fund (section 468A(e)(2)(B))";
}
@source(IRC_S468A_E, quote = "The tax imposed by subparagraph (A) shall be in lieu of any other taxation under this subtitle of the income from assets in the Fund.")
rule FundTaxInLieuOfOtherTaxation(fund: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the Fund's income is taxed only by the section 468A(e)(2)(A) tax (section 468A(e)(2)(B))";
    when nuclear_fund_tax_468Ae2(fund, y, amount);
    then fund_income_taxed_only_under_468Ae2B(fund);
}
pub relation fund_treated_as_corporation_for_subtitle_f_468Ae2C(fund: Person) kind institutional {
    label en official "for subtitle F the Fund is treated as if it were a corporation and the tax of paragraph (2) is treated as a tax imposed by section 11 (section 468A(e)(2)(C))";
}
@source(IRC_S468A_E, quote = "For purposes of subtitle F—")
rule FundTreatedAsCorporationForSubtitleF(fund: Person, p: Person, plant: Integer) defeasible {
    label en official "a Fund is treated as a corporation for subtitle F (section 468A(e)(2)(C)(i)); its tax is a section 11 tax for subtitle F (section 468A(e)(2)(C)(ii))";
    when fund_of_taxpayer_468A(fund, p, plant);
    then fund_treated_as_corporation_for_subtitle_f_468Ae2C(fund);
}
pub relation fund_accepts_payment_not_deductible_under_468Aa_468Ae3(fund: Person) kind empirical {
    label en official "the Fund accepts a payment or other amount other than payments deductible under subsection (a) and transfers permitted by subsection (f) (section 468A(e)(3))";
}
@source(IRC_S468A_E, quote = "the Fund shall not accept any payments (or other amounts) other than payments with respect to which a deduction is allowable under subsection (a).")
rule Section468aE3NoOtherContributionsProhibition(fund: Person, p: Person, plant: Integer) defeasible {
    label en official "the Fund may accept only deductible payments (and section 468A(f) transfers); accepting anything else breaches the prohibition (section 468A(e)(3))";
    when fund_of_taxpayer_468A(fund, p, plant);
    then prohibition Section468aE3NoOtherContributions {
        bearer fund;
        action fund_accepts_payment_not_deductible_under_468Aa_468Ae3(fund);
        window [-infinity, infinity];
    };
}
pub relation fund_used_for_purpose_outside_468Ae4(fund: Person) kind empirical {
    label en official "the Fund is used for a purpose other than satisfying the decommissioning liability, paying the Fund's administrative costs, or making investments of amounts not currently needed (section 468A(e)(4))";
}
@source(IRC_S468A_E, quote = "The Fund shall be used exclusively for—")
rule Section468aE4ExclusiveUseProhibition(fund: Person, p: Person, plant: Integer) defeasible {
    label en official "the Fund may be used exclusively for the three purposes of paragraph (4); other use breaches the prohibition (section 468A(e)(4))";
    when fund_of_taxpayer_468A(fund, p, plant);
    then prohibition Section468aE4ExclusiveUse {
        bearer fund;
        action fund_used_for_purpose_outside_468Ae4(fund);
        window [-infinity, infinity];
    };
}

// --- (f): transfers into qualified funds ---

pub relation transfer_into_fund_468Af(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind empirical {
    label en official "an amount transferred by the taxpayer into the Fund under section 468A(f)";
}
pub relation present_value_of_previously_excluded_costs_468Af1(p: Person, plant: Integer, amount: Money) kind empirical {
    label en official "the present value of the portion of the total nuclear decommissioning costs previously excluded under subsection (d)(2)(A) as in effect before the enactment of subsection (f) (section 468A(f)(1)); the present-value computation is asserted";
}
pub relation transfer_within_limit_468Af1(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the amount of the transfer permitted notwithstanding subsection (b): not more than the present value of the previously excluded costs (section 468A(f)(1))";
}
@source(IRC_S468A_F, quote = "may transfer into such Fund not more than an amount equal to the present value of the portion of the total nuclear decommissioning costs")
rule TransferLimitedToPresentValueOfExcludedCosts(p: Person, y: TaxableYear, plant: Integer, transfer: Money, pv: Money) defeasible {
    label en official "a section 468A(f) transfer is limited to the present value of the previously excluded decommissioning costs (section 468A(f)(1))";
    when nuclear_decommissioning_election_in_effect_468A(p, y, plant);
    when transfer_into_fund_468Af(p, y, plant, transfer);
    when present_value_of_previously_excluded_costs_468Af1(p, plant, pv);
    then transfer_within_limit_468Af1(p, y, plant, min(transfer, pv));
}
pub relation new_ruling_schedule_requested_for_transfer_468Af3(p: Person, y: TaxableYear, plant: Integer) kind empirical {
    label en official "the taxpayer requests from the Secretary a new schedule of ruling amounts in connection with the transfer (section 468A(f)(3))";
}
pub relation previously_deducted_or_excluded_amount_468Af2B(p: Person, plant: Integer, amount: Money) kind empirical {
    label en official "the amount of the transfer for which a deduction was previously allowed to the taxpayer (or a predecessor) or a corresponding amount was not included in gross income (section 468A(f)(2)(B))";
}
pub relation remaining_useful_life_years_468Af2A(plant: Integer, years: Integer) kind empirical {
    label en official "the remaining estimated useful life of the nuclear power plant in taxable years, beginning with the year of the transfer (section 468A(f)(2)(A))";
}
pub relation transfer_deduction_base_468Af2(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the deductible part of a transfer: the permitted amount less the previously deducted or excluded amount, floored at zero (JUDGMENT CALL: the ratable treatment of section 468A(f)(2)(B), second sentence, is read as the whole previously deducted part) (section 468A(f)(2)(B))";
}
@source(IRC_S468A_F, quote = "No deduction shall be allowed for any transfer under this subsection of an amount for which a deduction was previously allowed to the taxpayer (or a predecessor) or a corresponding amount was not included in gross income of the taxpayer (or a predecessor).")
rule TransferDeductionExcludesPreviouslyDeducted(p: Person, y: TaxableYear, plant: Integer, permitted: Money, previous: Money) defeasible {
    label en official "a transfer earns a deduction only for the part not previously deducted or excluded (section 468A(f)(2)(B)); a new ruling schedule must have been requested (section 468A(f)(3))";
    when transfer_within_limit_468Af1(p, y, plant, permitted);
    when new_ruling_schedule_requested_for_transfer_468Af3(p, y, plant);
    when previously_deducted_or_excluded_amount_468Af2B(p, plant, previous);
    then transfer_deduction_base_468Af2(p, y, plant, max(permitted - previous, 0 USD));
}
rule TransferDeductionWithoutPreviousDeduction(p: Person, y: TaxableYear, plant: Integer, permitted: Money) defeasible {
    label en official "with no previously deducted or excluded amount the whole permitted transfer is the deduction base (section 468A(f)(2)(A)); a new ruling schedule must have been requested (section 468A(f)(3))";
    when transfer_within_limit_468Af1(p, y, plant, permitted);
    when new_ruling_schedule_requested_for_transfer_468Af3(p, y, plant);
    when not_known(previously_deducted_or_excluded_amount_asserted_468Af2B(p, plant));
    then transfer_deduction_base_468Af2(p, y, plant, permitted);
}
pub relation previously_deducted_or_excluded_amount_asserted_468Af2B(p: Person, plant: Integer) kind institutional {
    label en official "a previously deducted or excluded amount has been asserted for the transfer (bridge for the `not_known` test)";
}
rule PreviouslyDeductedAmountAssertedBridge(p: Person, plant: Integer, amount: Money) strict {
    label en official "bridge";
    when previously_deducted_or_excluded_amount_468Af2B(p, plant, amount);
    then previously_deducted_or_excluded_amount_asserted_468Af2B(p, plant);
}
pub relation transfer_ratable_annual_deduction_468Af2A(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the annual deduction for a transfer: the deduction base allowed ratably over the remaining estimated useful life beginning with the year of the transfer, one rounding to cents HALF_UP (JUDGMENT CALL) (section 468A(f)(2)(A))";
}
@source(IRC_S468A_F, quote = "shall be allowed ratably over the remaining estimated useful life")
rule TransferDeductionRatably(p: Person, y: TaxableYear, plant: Integer, base: Money, years: Integer) defeasible {
    label en official "the deduction for a transfer is spread evenly over the remaining useful life (section 468A(f)(2)(A))";
    when transfer_deduction_base_468Af2(p, y, plant, base);
    when remaining_useful_life_years_468Af2A(plant, years);
    when years > 0;
    then transfer_ratable_annual_deduction_468Af2A(p, y, plant, div_round(base, years * 1.0, 2, "HALF_UP"));
}
pub relation fund_transferred_after_transfer_468Af2C(p: Person, y: TaxableYear, plant: Integer) kind empirical {
    label en official "the Fund to which a section 468A(f) transfer was made is thereafter transferred, on a date in the taxable year (section 468A(f)(2)(C)(i)-(ii))";
}
pub relation deduction_for_later_years_after_fund_transfer_468Af2C(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind empirical {
    label en official "the deductions under section 468A(f) that would otherwise fall in taxable years ending after the date the Fund is transferred (section 468A(f)(2)(C))";
}
pub relation transferor_deduction_in_year_including_fund_transfer_468Af2C(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "the deductions for years ending after the Fund's transfer are allowed to the transferor for the taxable year that includes the transfer date (section 468A(f)(2)(C))";
}
@source(IRC_S468A_F, quote = "any deduction under this subsection for taxable years ending after the date that such Fund is transferred shall be allowed to the transferor for the taxable year which includes such date.")
rule TransferredFundDeductionsAllowedToTransferor(p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "on a transfer of the Fund the later-year deductions are accelerated into the transferor's year of transfer (section 468A(f)(2)(C))";
    when fund_transferred_after_transfer_468Af2C(p, y, plant);
    when deduction_for_later_years_after_fund_transfer_468Af2C(p, y, plant, amount);
    then transferor_deduction_in_year_including_fund_transfer_468Af2C(p, y, plant, amount);
}
pub relation section_468Af_transfer_gain_or_loss_not_recognized(p: Person, y: TaxableYear, plant: Integer) kind institutional {
    label en official "no gain or loss is recognized on a transfer described in paragraph (1) (section 468A(f)(2)(D)(i))";
}
@source(IRC_S468A_F, quote = "No gain or loss shall be recognized on any transfer described in paragraph (1).")
rule TransferOfPropertyToFundNoGainOrLoss(p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "a permitted transfer into the Fund is a nonrecognition event (section 468A(f)(2)(D)(i))";
    when transfer_within_limit_468Af1(p, y, plant, amount);
    then section_468Af_transfer_gain_or_loss_not_recognized(p, y, plant);
}
pub relation appreciated_property_transferred_adjusted_basis_468Af2Dii(p: Person, y: TaxableYear, plant: Integer, basis: Money) kind empirical {
    label en official "appreciated property is transferred in the transfer, with its adjusted basis (section 468A(f)(2)(D)(ii))";
}
pub relation appreciated_property_deduction_ceiling_468Af2Dii(p: Person, y: TaxableYear, plant: Integer, amount: Money) kind institutional {
    label en official "where appreciated property is transferred the deduction does not exceed its adjusted basis (section 468A(f)(2)(D)(ii))";
}
@source(IRC_S468A_F, quote = "the amount of the deduction shall not exceed the adjusted basis of such property.")
rule AppreciatedPropertyDeductionLimitedToBasis(p: Person, y: TaxableYear, plant: Integer, base: Money, basis: Money) defeasible {
    label en official "the deduction for appreciated property is the lesser of the deduction base and the property's adjusted basis (section 468A(f)(2)(D)(ii))";
    when transfer_deduction_base_468Af2(p, y, plant, base);
    when appreciated_property_transferred_adjusted_basis_468Af2Dii(p, y, plant, basis);
    then appreciated_property_deduction_ceiling_468Af2Dii(p, y, plant, min(base, basis));
}
pub relation taxpayer_basis_in_fund_not_increased_by_transfer_468Af4(p: Person, plant: Integer) kind institutional {
    label en official "the taxpayer's basis in a Fund to which section 468A applies is not increased by reason of a permitted transfer (section 468A(f)(4))";
}
@source(IRC_S468A_F, quote = "the taxpayer's basis in any Fund to which this section applies shall not be increased by reason of any transfer permitted by this subsection.")
rule NoBasisIncreaseForTransfer(p: Person, y: TaxableYear, plant: Integer, amount: Money) defeasible {
    label en official "a permitted transfer gives no basis in the Fund (section 468A(f)(4))";
    when transfer_within_limit_468Af1(p, y, plant, amount);
    then taxpayer_basis_in_fund_not_increased_by_transfer_468Af4(p, plant);
}

// ===================== Section 468B =====================

pub relation liability_of_taxpayer_468B(p: Person, liability: Integer) kind empirical {
    label en official "a liability of the taxpayer that a designated settlement fund is established to resolve";
}
pub relation liability_arises_under_workers_compensation_act_468Be(liability: Integer) kind empirical {
    label en official "the liability arises under a workers' compensation Act (section 468B(e))";
}
pub relation liability_is_contested_within_461f_468Be(liability: Integer) kind empirical {
    label en official "the liability is a contested liability of the taxpayer within the meaning of section 461(f) (section 468B(e))";
}
pub relation section_468B_inapplicable_to_liability_468Be(liability: Integer) kind institutional {
    label en official "section 468B (other than subsection (g)) does not apply to the liability (section 468B(e))";
}
@source(IRC_S468B_E, quote = "This section (other than subsection (g)) shall not apply with respect to any liability of the taxpayer arising under any workers' compensation Act")
rule Section468BInapplicableToWorkersCompensationLiability(liability: Integer) strict {
    label en official "a workers' compensation liability is outside section 468B (section 468B(e))";
    when liability_arises_under_workers_compensation_act_468Be(liability);
    then section_468B_inapplicable_to_liability_468Be(liability);
}
@source(IRC_S468B_E, quote = "any contested liability of the taxpayer within the meaning of section 461(f)")
rule Section468BInapplicableToContestedLiability(liability: Integer) strict {
    label en official "a section 461(f) contested liability is outside section 468B (section 468B(e))";
    when liability_is_contested_within_461f_468Be(liability);
    then section_468B_inapplicable_to_liability_468Be(liability);
}

// --- (d): definitions ---

pub relation related_person_267b_468Bd3(p: Person, other: Person) kind empirical {
    label en official "the person is related to the taxpayer within the meaning of section 267(b) (section 468B(d)(3)); the relationship itself is asserted (section 267 is owned by the deductions package)";
}
pub relation transfer_to_fund_468B(t: Integer, p: Person, fund: Person, amount: Money) kind empirical {
    label en official "money or property transferred to the fund by the taxpayer, with the amount (section 468B(d)(1))";
}
pub relation transfer_pursuant_to_court_order_468Bd1(t: Integer) kind empirical {
    label en official "the transfer is made pursuant to a court order (section 468B(d)(1))";
}
pub relation transfer_may_return_to_taxpayer_or_related_468Bd1A(t: Integer) kind empirical {
    label en official "the amount transferred may be transferred from the fund to the taxpayer or a related person (section 468B(d)(1)(A))";
}
pub relation transfer_is_stock_or_debt_of_taxpayer_or_related_468Bd1B(t: Integer) kind empirical {
    label en official "the transfer is of stock or indebtedness of the taxpayer or a related person (section 468B(d)(1)(B))";
}
pub relation qualified_payment_468Bd1(t: Integer, p: Person, fund: Person, amount: Money) kind institutional {
    label en official "a qualified payment: money or property transferred to a designated settlement fund pursuant to a court order, other than an amount returnable to the taxpayer or a related person, or stock or debt of them (section 468B(d)(1))";
}
@source(IRC_S468B_D, quote = "The term \"qualified payment\" means any money or property which is transferred to any designated settlement fund pursuant to a court order")
rule QualifiedPaymentToDesignatedSettlementFund(t: Integer, p: Person, fund: Person, amount: Money) strict {
    label en official "a court-ordered transfer to a designated settlement fund is a qualified payment unless returnable to the taxpayer or a related person or stock or debt of them (section 468B(d)(1))";
    when transfer_to_fund_468B(t, p, fund, amount);
    when transfer_pursuant_to_court_order_468Bd1(t);
    when is_designated_settlement_fund_468Bd2(fund, p);
    when not_known(transfer_may_return_to_taxpayer_or_related_468Bd1A(t));
    when not_known(transfer_is_stock_or_debt_of_taxpayer_or_related_468Bd1B(t));
    then qualified_payment_468Bd1(t, p, fund, amount);
}
pub relation fund_established_pursuant_to_court_order_extinguishing_tort_liability_468Bd2A(fund: Person) kind empirical {
    label en official "the fund is established pursuant to a court order and extinguishes completely the taxpayer's tort liability with respect to the claims described in subparagraph (D) (section 468B(d)(2)(A))";
}
pub relation fund_accepts_only_qualified_payments_468Bd2B(fund: Person) kind empirical {
    label en official "no amounts may be transferred to the fund other than in the form of qualified payments (section 468B(d)(2)(B))";
}
pub relation fund_administered_by_majority_independent_of_taxpayer_468Bd2C(fund: Person) kind empirical {
    label en official "the fund is administered by persons a majority of whom are independent of the taxpayer (section 468B(d)(2)(C))";
}
pub relation fund_established_to_resolve_present_and_future_claims_468Bd2D(fund: Person) kind empirical {
    label en official "the fund is established for the principal purpose of resolving and satisfying present and future claims against the taxpayer (or a related or formerly related person) arising out of personal injury, death, or property damage (section 468B(d)(2)(D)); the principal purpose is an adjudicated fact (DECISION-0194)";
}
pub relation taxpayer_or_related_holds_beneficial_interest_in_fund_468Bd2E(fund: Person) kind empirical {
    label en official "the taxpayer or a related person may hold a beneficial interest in the income or corpus of the fund under its terms (section 468B(d)(2)(E), negated)";
}
pub relation election_made_for_fund_468Bd2F(p: Person, fund: Person) kind empirical {
    label en official "the taxpayer makes the election under section 468B for the fund (section 468B(d)(2)(F)); time and manner are for the Secretary";
}
pub relation designated_settlement_fund_election_in_effect_468Bd2F(fund: Person, p: Person) kind institutional {
    label en official "the election under section 468B for the fund is in effect";
}
@source(IRC_S468B_D, quote = "with respect to which an election is made under this section by the taxpayer.")
rule Section468BElectionPower(fund: Person, p: Person) strict {
    label en official "the taxpayer may elect designated settlement fund treatment for a fund (section 468B(d)(2)(F)); effective for funds established after May 17, 2006 in the pinned notes only as to the amendment, the election itself dates from the 1986 provision";
    when election_made_for_fund_468Bd2F(p, fund);
    then power Section468BDesignatedFundElection {
        holder p;
        over fund;
        exercise election_made_for_fund_468Bd2F(p, fund);
        valid_when fund_established_pursuant_to_court_order_extinguishing_tort_liability_468Bd2A(fund);
        effect create(designated_settlement_fund_election_in_effect_468Bd2F(fund, p));
        window [@1984-07-18, infinity);
    };
}
pub relation is_designated_settlement_fund_468Bd2(fund: Person, p: Person) kind institutional {
    label en official "a designated settlement fund: a fund meeting conditions (A) to (F) of section 468B(d)(2)";
}
@source(IRC_S468B_D, quote = "The term \"designated settlement fund\" means any fund—")
rule DesignatedSettlementFundDefinition(fund: Person, p: Person) strict {
    label en official "a fund satisfying all six conditions of paragraph (2), including the election, is a designated settlement fund (section 468B(d)(2)(A)-(F))";
    when fund_established_pursuant_to_court_order_extinguishing_tort_liability_468Bd2A(fund);
    when fund_accepts_only_qualified_payments_468Bd2B(fund);
    when fund_administered_by_majority_independent_of_taxpayer_468Bd2C(fund);
    when fund_established_to_resolve_present_and_future_claims_468Bd2D(fund);
    when not_known(taxpayer_or_related_holds_beneficial_interest_in_fund_468Bd2E(fund));
    when election_made_for_fund_468Bd2F(p, fund);
    then is_designated_settlement_fund_468Bd2(fund, p);
}
pub relation secretary_consents_to_revocation_of_fund_election_468Bd2(p: Person, fund: Person) kind empirical {
    label en official "the Secretary consents to the revocation of the taxpayer's section 468B election for the fund (section 468B(d)(2), last sentence)";
}
pub relation designated_fund_election_revoked_468Bd2(fund: Person, p: Person) kind institutional {
    label en official "the election has been revoked with the Secretary's consent";
}
@source(IRC_S468B_D, quote = "Such an election, once made, may be revoked only with the consent of the Secretary.")
rule Section468BElectionRevocationOnlyWithConsent(fund: Person, p: Person) strict {
    label en official "a made election may be revoked only with the Secretary's consent (section 468B(d)(2))";
    when secretary_consents_to_revocation_of_fund_election_468Bd2(p, fund);
    then power Section468BRevocationWithConsent {
        holder Secretary;
        over p;
        exercise secretary_consents_to_revocation_of_fund_election_468Bd2(p, fund);
        valid_when election_made_for_fund_468Bd2F(p, fund);
        effect create(designated_fund_election_revoked_468Bd2(fund, p));
        window [@1984-07-18, infinity);
    };
}

// --- (a): economic performance; (c): insurance amounts ---

pub relation deductible_item_settled_by_fund_468Ba(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item for which the taxpayer's tort liability is resolved through the designated settlement fund (section 468B(a), 461(h))";
}
pub relation qualified_payment_for_item_468Ba(t: Integer, p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the qualified payment is made by the taxpayer in the taxable year toward the item (section 468B(a))";
}
@source(IRC_S468B_A, quote = "economic performance shall be deemed to occur as qualified payments are made by the taxpayer to a designated settlement fund.")
rule QualifiedPaymentIsEconomicPerformance(t: Integer, p: Person, fund: Person, amount: Money, y: TaxableYear, item: Integer) strict {
    label en official "for section 461(h) economic performance occurs as qualified payments are made to a designated settlement fund (section 468B(a))";
    when qualified_payment_468Bd1(t, p, fund, amount);
    when qualified_payment_for_item_468Ba(t, p, y, item);
    then economic_performance_established_461h(p, y, item);
}
pub relation qualified_payment_insurance_amount_excluded_from_gross_income_468Bc(t: Integer, p: Person, amount: Money) kind empirical {
    label en official "the part of the qualified payment made of amounts received from the settlement of an insurance claim that is excluded from the taxpayer's gross income (section 468B(c))";
}
pub relation qualified_payment_deduction_disallowed_468Bc(t: Integer, p: Person, amount: Money) kind institutional {
    label en official "no deduction is allowable for the part of a qualified payment made of excluded insurance settlement amounts (section 468B(c))";
}
@source(IRC_S468B_C, quote = "No deduction shall be allowable for any qualified payment by the taxpayer of any amounts received from the settlement of any insurance claim to the extent such amounts are excluded from the gross income of the taxpayer.")
rule QualifiedPaymentOfExcludedInsuranceAmountsNotDeductible(t: Integer, p: Person, fund: Person, paid: Money, excluded: Money) defeasible {
    label en official "the deduction is disallowed to the extent excluded insurance amounts are transferred: the lesser of the payment and the excluded amount (section 468B(c))";
    when qualified_payment_468Bd1(t, p, fund, paid);
    when qualified_payment_insurance_amount_excluded_from_gross_income_468Bc(t, p, excluded);
    then qualified_payment_deduction_disallowed_468Bc(t, p, min(paid, excluded));
}

// --- (b): taxation of the fund ---

pub relation maximum_rate_under_section_1e_468Bb1(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the maximum rate in effect for the taxable year under section 1(e) (section 468B(b)(1)); the rate is a pending dependency on the section 1(e) owner and is asserted";
}
pub relation dsf_gross_income_468Bb1(fund: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income of the designated settlement fund for the taxable year, excluding qualified payments received (section 468B(b)(1), (b)(3)(A))";
}
pub relation dsf_deductible_administrative_costs_468Bb2(fund: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "administrative costs (including State and local taxes) and other incidental expenses of the fund, incurred in connection with its operation and deductible by a corporation (section 468B(b)(2)(A)-(B))";
}
pub relation dsf_taxable_income_468Bb(fund: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the fund's gross income reduced by its allowed administrative costs, floored at zero (JUDGMENT CALL on the floor) (section 468B(b)(2))";
}
rule DsfTaxableIncome(fund: Person, y: TaxableYear, gross: Money, costs: Money) defeasible {
    label en official "gross income of the fund less its administrative costs and incidental expenses; no other deduction (section 468B(b)(2))";
    when dsf_gross_income_468Bb1(fund, y, gross);
    when dsf_deductible_administrative_costs_468Bb2(fund, y, costs);
    then dsf_taxable_income_468Bb(fund, y, max(gross - costs, 0 USD));
}
pub relation dsf_tax_468Bb1(fund: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax on the fund's gross income at the maximum section 1(e) rate, one rounding to cents HALF_UP (JUDGMENT CALL) (section 468B(b)(1))";
}
@source(IRC_S468B_B, quote = "There is imposed on the gross income of any designated settlement fund for any taxable year a tax at a rate equal to the maximum rate in effect for such taxable year under section 1(e).")
rule DsfTaxAtMaximumRate(fund: Person, y: TaxableYear, taxable: Money, rate: Decimal) defeasible {
    label en official "a designated settlement fund pays tax on its taxable base at the maximum section 1(e) rate (section 468B(b)(1))";
    when dsf_taxable_income_468Bb(fund, y, taxable);
    when maximum_rate_under_section_1e_468Bb1(y, rate);
    then dsf_tax_468Bb1(fund, y, round(taxable * rate, 2, "HALF_UP"));
}
pub relation dsf_no_other_deduction_allowed_468Bb2(fund: Person, y: TaxableYear) kind institutional {
    label en official "no deduction other than administrative costs and incidental expenses is allowed to the fund (section 468B(b)(2), last sentence)";
}
@source(IRC_S468B_B, quote = "No other deduction shall be allowed to the fund.")
rule DsfNoOtherDeduction(fund: Person, y: TaxableYear, taxable: Money) defeasible {
    label en official "the fund's only deduction is the section 468B(b)(2) costs (section 468B(b)(2))";
    when dsf_taxable_income_468Bb(fund, y, taxable);
    then dsf_no_other_deduction_allowed_468Bb2(fund, y);
}
pub relation dsf_payment_not_income_of_fund_468Bb3A(t: Integer) kind institutional {
    label en official "the amount of a qualified payment is not income of the designated settlement fund (section 468B(b)(3)(A))";
}
@source(IRC_S468B_B, quote = "the amount of such payment shall not be treated as income of the designated settlement fund,")
rule QualifiedPaymentNotIncomeOfFund(t: Integer, p: Person, fund: Person, amount: Money) defeasible {
    label en official "a qualified payment is not income of the fund (section 468B(b)(3)(A))";
    when qualified_payment_468Bd1(t, p, fund, amount);
    then dsf_payment_not_income_of_fund_468Bb3A(t);
}
pub relation fair_market_value_of_property_qualified_payment_468Bb3B(t: Integer, fmv: Money) kind empirical {
    label en official "the fair market value of property that constitutes a qualified payment at the time of payment (section 468B(b)(3)(B)); the value is an adjudicated fact";
}
pub relation dsf_basis_in_qualified_payment_property_468Bb3B(t: Integer, basis: Money) kind institutional {
    label en official "the fund's basis in property that constitutes a qualified payment equals its fair market value at the time of payment (section 468B(b)(3)(B))";
}
@source(IRC_S468B_B, quote = "the basis of the fund in any property which constitutes a qualified payment shall be equal to the fair market value of such property at the time of payment")
rule DsfBasisEqualsFairMarketValue(t: Integer, p: Person, fund: Person, amount: Money, fmv: Money) defeasible {
    label en official "the fund takes a fair-market-value basis in property received as a qualified payment (section 468B(b)(3)(B))";
    when qualified_payment_468Bd1(t, p, fund, amount);
    when fair_market_value_of_property_qualified_payment_468Bb3B(t, fmv);
    then dsf_basis_in_qualified_payment_property_468Bb3B(t, fmv);
}
pub relation fund_treated_as_owner_of_property_468Bb3C(fund: Person) kind institutional {
    label en official "the fund is treated as the owner of the property in the fund and any earnings thereon (section 468B(b)(3)(C))";
}
@source(IRC_S468B_B, quote = "the fund shall be treated as the owner of the property in the fund (and any earnings thereon).")
rule DsfTreatedAsOwnerOfFundProperty(t: Integer, p: Person, fund: Person, amount: Money) defeasible {
    label en official "the fund, not the taxpayer, owns the property in the fund (section 468B(b)(3)(C))";
    when qualified_payment_468Bd1(t, p, fund, amount);
    then fund_treated_as_owner_of_property_468Bb3C(fund);
}
pub relation dsf_income_taxed_only_under_468Bb1(fund: Person) kind institutional {
    label en official "the tax of paragraph (1) is in lieu of any other taxation under subtitle A of income from assets in the fund (section 468B(b)(4))";
}
@source(IRC_S468B_B, quote = "The tax imposed by paragraph (1) shall be in lieu of any other taxation under this subtitle of income from assets in the designated settlement fund.")
rule DsfTaxInLieuOfOtherTaxation(fund: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the fund's income is taxed only under section 468B(b)(1) (section 468B(b)(4))";
    when dsf_tax_468Bb1(fund, y, amount);
    then dsf_income_taxed_only_under_468Bb1(fund);
}
pub relation dsf_treated_as_corporation_for_subtitle_f_468Bb5(fund: Person) kind institutional {
    label en official "for subtitle F the designated settlement fund is treated as a corporation and the paragraph (1) tax is treated as a tax imposed by section 11 (section 468B(b)(5))";
}
@source(IRC_S468B_B, quote = "a designated settlement fund shall be treated as a corporation, and")
rule DsfTreatedAsCorporationForSubtitleF(fund: Person, p: Person) defeasible {
    label en official "a designated settlement fund is a corporation for subtitle F (section 468B(b)(5))";
    when is_designated_settlement_fund_468Bd2(fund, p);
    then dsf_treated_as_corporation_for_subtitle_f_468Bb5(fund);
}

// --- (f), (g): other funds and clarification ---

pub relation payment_in_respect_of_liability_468Bd2D_to_non_dsf_trust_or_escrow_468Bf(pay: Integer, p: Person) kind empirical {
    label en official "a payment in respect of a liability described in subsection (d)(2)(D), and not described in subsection (e), to a trust fund or escrow fund that is not a designated settlement fund (section 468B(f))";
}
pub relation payment_not_economic_performance_468Bf(pay: Integer, p: Person) kind institutional {
    label en official "such a payment is not treated as constituting economic performance, except as regulations provide (section 468B(f))";
}
@source(IRC_S468B_F, quote = "shall not be treated as constituting economic performance.")
rule PaymentToNonDesignatedEscrowIsNotEconomicPerformance(pay: Integer, p: Person) defeasible {
    label en official "a payment to a non-designated trust or escrow fund for a (d)(2)(D) liability is not economic performance (section 468B(f))";
    when payment_in_respect_of_liability_468Bd2D_to_non_dsf_trust_or_escrow_468Bf(pay, p);
    then payment_not_economic_performance_468Bf(pay, p);
}
pub relation regulations_prescribed_for_taxation_of_escrow_funds_468Bg1(secretary: Person) kind empirical {
    label en official "the Secretary has prescribed regulations providing for the taxation of escrow accounts, settlement funds, and similar funds, whether as grantor trusts or otherwise (section 468B(g)(1))";
}
pub relation secretary_bound_to_prescribe_regulations_468Bg1(p: Person) kind empirical {
    label en official "the regulations provision of section 468B(g)(1) is in force (marker: it is not conditioned on a fact of the case)";
}
@source(IRC_S468B_G, quote = "The Secretary shall prescribe regulations providing for the taxation of any such account or fund whether as a grantor trust or otherwise.")
rule Section468BG1RegulationsDuty(p: Person) strict {
    label en official "the Secretary must prescribe regulations for the taxation of escrow and settlement funds (section 468B(g)(1)); the regulation content is not modelled";
    when secretary_bound_to_prescribe_regulations_468Bg1(p);
    then duty Section468BG1PrescribeRegulations {
        bearer Secretary;
        goal achievement {
            condition regulations_prescribed_for_taxation_of_escrow_funds_468Bg1(p);
            window [-infinity, infinity];
        }
    };
}
pub relation fund_established_pursuant_to_district_court_consent_decree_468Bg2A(fund: Person) kind empirical {
    label en official "the escrow account, settlement fund, or similar fund is established pursuant to a consent decree entered by a judge of a United States District Court (section 468B(g)(2)(A))";
}
pub relation fund_for_settlement_payments_directed_by_government_entity_for_cercla_468Bg2B(fund: Person) kind empirical {
    label en official "the fund is created for the receipt of settlement payments as directed by a government entity for the sole purpose of resolving or satisfying claims of liability under CERCLA (section 468B(g)(2)(B))";
}
pub relation government_entity_controls_expenditure_of_fund_468Bg2C(fund: Person) kind empirical {
    label en official "the authority and control over the expenditure of the funds (contributions and net earnings) is with the government entity (section 468B(g)(2)(C))";
}
pub relation remaining_funds_disbursed_to_government_entity_on_termination_468Bg2D(fund: Person) kind empirical {
    label en official "on termination any remaining funds will be disbursed to the government entity for use in accordance with applicable law (section 468B(g)(2)(D))";
}
pub relation government_entity_468Bg2(gov: Person) kind empirical {
    label en official "the United States, a State or political subdivision, the District of Columbia, a possession of the United States, or an agency or instrumentality of any of them (section 468B(g)(2), last sentence)";
}
pub relation fund_directed_by_entity_468Bg2(fund: Person, gov: Person) kind empirical {
    label en official "the government entity that directs the settlement payments and controls the fund";
}
pub relation cercla_settlement_fund_exempt_468Bg2(fund: Person) kind institutional {
    label en official "the fund is treated as beneficially owned by the United States and exempt from taxation under subtitle A (section 468B(g)(2))";
}
@source(IRC_S468B_G, quote = "shall be treated as beneficially owned by the United States and shall be exempt from taxation under this subtitle if—")
rule CerclaSettlementFundExemption(fund: Person, gov: Person) defeasible {
    label en official "a consent-decree CERCLA settlement fund controlled by a government entity is exempt and beneficially owned by the United States (section 468B(g)(2)(A)-(D))";
    when fund_established_pursuant_to_district_court_consent_decree_468Bg2A(fund);
    when fund_for_settlement_payments_directed_by_government_entity_for_cercla_468Bg2B(fund);
    when fund_directed_by_entity_468Bg2(fund, gov);
    when government_entity_468Bg2(gov);
    when government_entity_controls_expenditure_of_fund_468Bg2C(fund);
    when remaining_funds_disbursed_to_government_entity_on_termination_468Bg2D(fund);
    then cercla_settlement_fund_exempt_468Bg2(fund);
}
pub relation escrow_or_settlement_fund_subject_to_current_income_tax_468Bg1(fund: Person) kind institutional {
    label en official "an escrow account, settlement fund, or similar fund is subject to current income tax, except a fund exempt under paragraph (2) (section 468B(g)(1))";
}
pub relation escrow_or_settlement_fund_468Bg(fund: Person) kind empirical {
    label en official "the account or fund is an escrow account, settlement fund, or similar fund (section 468B(g)(1))";
}
@source(IRC_S468B_G, quote = "nothing in any provision of law shall be construed as providing that an escrow account, settlement fund, or similar fund is not subject to current income tax.")
rule EscrowFundSubjectToCurrentIncomeTax(fund: Person) defeasible {
    label en official "an escrow or settlement fund is subject to current income tax unless the paragraph (2) exemption applies (section 468B(g)(1))";
    when escrow_or_settlement_fund_468Bg(fund);
    when not_known(cercla_settlement_fund_exempt_468Bg2(fund));
    then escrow_or_settlement_fund_subject_to_current_income_tax_468Bg1(fund);
}
