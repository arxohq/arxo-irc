}
relation look_back_state_7(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 7: the balance at the start of the accrual period after look-back year number 8, with the sum of the year amounts so far";
}
relation look_back_level_8(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 8: the accrual period after look-back year number 9 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_8(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 8: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_8(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 8: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_8(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 8: the balance at the start of the accrual period after look-back year number 9, with the sum of the year amounts so far";
}
relation look_back_level_9(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 9: the accrual period after look-back year number 10 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_9(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 9: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_9(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 9: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_9(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 9: the balance at the start of the accrual period after look-back year number 10, with the sum of the year amounts so far";
}
pub relation look_back_balance_at_completion_460b2C(p: Person, contract: Integer, balance: Money, principal: Money) kind institutional {
    label en official "the balance at completion (the year amounts compounded daily at the adjusted overpayment rates) and the sum of the year amounts";
}
pub relation look_back_interest_460b2C(p: Person, contract: Integer, interest: Money) kind institutional {
    label en official "the net look-back interest: the compounded balance minus the sum of the year amounts (positive: the taxpayer pays; negative: the taxpayer is entitled to receive); depth: at most 10 accrual periods (stated bound)";
}
pub relation look_back_interest_payable_460b1B(p: Person, contract: Integer, amount: Money) kind institutional {
    label en official "the interest the taxpayer shall pay upon completion of the contract (section 460(b)(1)(B))";
}
pub relation look_back_interest_receivable_460b1B(p: Person, contract: Integer, amount: Money) kind institutional {
    label en official "the interest the taxpayer shall be entitled to receive upon completion of the contract (section 460(b)(1)(B))";
}
rule LookBackLevel0(p: Person, contract: Integer, y0: TaxableYear) defeasible {
    label en official "the walk starts at the first look-back year (section 460(b)(2)(A))";
    when look_back_first_year_460b2(p, contract, y0);
    when look_back_interest_applies_460b1B(p, contract);
    then look_back_level_0(p, contract, y0);
}
@source(IRC_S460_B, quote = "(A) first, allocating income under the contract among taxable years before the year in which the contract is completed on the basis of the actual contract price and costs instead of the estimated contract price and costs,")
rule LookBackState0(p: Person, contract: Integer, y0: TaxableYear, d0: Money) defeasible {
    label en official "the balance starts with the first look-back year's amount (section 460(b)(2)(A)-(B))";
    when look_back_first_year_460b2(p, contract, y0);
    when look_back_interest_applies_460b1B(p, contract);
    when look_back_year_amount_460b2B(p, contract, y0, d0);
    then look_back_state_0(p, contract, y0, d0, d0);
}
@source(IRC_S460_B, quote = "(C) then using the adjusted overpayment rate (as defined in paragraph (7)), compounded daily, on the overpayment or underpayment determined under subparagraph (B).")
rule LookBackFinalPeriod0(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date, dc: Date, r: Decimal) defeasible {
    label en official "the contract is completed inside the accrual period of level 0: daily interest at the adjusted overpayment rate up to the completion date (section 460(b)(2)(C))";
    when look_back_level_0(p, contract, y);
    when preceding_taxable_year_465(y, y_next);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    when contract_completion_date_460c3B(contract, dc);
    when dc <= due_next;
    when adjusted_overpayment_rate_460b7A(p, y, r);
    then look_back_final_period_0(p, contract, y, div_round(r, 365.0, 12, "HALF_UP"), max(days_between(due, dc), 0));
}
rule LookBackFullPeriod0(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date, dc: Date, r: Decimal) defeasible {
    label en official "the accrual period of level 0 ends before completion: daily interest for the whole period (section 460(b)(2)(C), (b)(7)(B))";
    when look_back_level_0(p, contract, y);
    when preceding_taxable_year_465(y, y_next);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    when contract_completion_date_460c3B(contract, dc);
    when dc > due_next;
    when adjusted_overpayment_rate_460b7A(p, y, r);
    then look_back_full_period_0(p, contract, y, y_next, div_round(r, 365.0, 12, "HALF_UP"), days_between(due, due_next));
}
rule LookBackRequestFinal0(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the daily growth factor of the final period";
    when look_back_final_period_0(p, contract, y, step, days);
    then growth_request(step, days);
}
rule LookBackRequestFull0(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the daily growth factor of the full period";
    when look_back_full_period_0(p, contract, y, y_next, step, days);
    then growth_request(step, days);
}
rule LookBackRequestNextYear0(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "ask for the next look-back year's amount";
    when look_back_full_period_0(p, contract, y, y_next, step, days);
    then look_back_year_request_460b2(p, contract, y_next);
}
rule LookBackBalanceAtCompletion0(p: Person, contract: Integer, y: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal) defeasible {
    label en official "the final balance: the balance grown by the daily factor of the last period, rounded to cents HALF_UP (JUDGMENT CALL)";
    when look_back_state_0(p, contract, y, bal, prin);
    when look_back_final_period_0(p, contract, y, step, days);
    when growth_factor(step, days, f);
    then look_back_balance_at_completion_460b2C(p, contract, round(bal * f, 2, "HALF_UP"), prin);
}
rule LookBackLevel1(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "the walk moves to the next accrual period";
    when look_back_full_period_0(p, contract, y, y_next, step, days);
    then look_back_level_1(p, contract, y_next);
}
rule LookBackState1From0(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal, dn: Money) defeasible {
    label en official "the balance grown over the full period plus the next year's amount starts the next level (section 460(b)(2)(B)-(C))";
    when look_back_state_0(p, contract, y, bal, prin);
    when look_back_full_period_0(p, contract, y, y_next, step, days);
    when growth_factor(step, days, f);
    when look_back_year_amount_460b2B(p, contract, y_next, dn);
    then look_back_state_1(p, contract, y_next, round(bal * f, 2, "HALF_UP") + dn, prin + dn);
}
@source(IRC_S460_B, quote = "(C) then using the adjusted overpayment rate (as defined in paragraph (7)), compounded daily, on the overpayment or underpayment determined under subparagraph (B).")
rule LookBackFinalPeriod1(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date, dc: Date, r: Decimal) defeasible {
    label en official "the contract is completed inside the accrual period of level 1: daily interest at the adjusted overpayment rate up to the completion date (section 460(b)(2)(C))";
    when look_back_level_1(p, contract, y);
    when preceding_taxable_year_465(y, y_next);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    when contract_completion_date_460c3B(contract, dc);
    when dc <= due_next;
