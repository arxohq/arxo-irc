    then look_back_year_request_460b2(p, contract, y_next);
}
rule LookBackBalanceAtCompletion6(p: Person, contract: Integer, y: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal) defeasible {
    label en official "the final balance: the balance grown by the daily factor of the last period, rounded to cents HALF_UP (JUDGMENT CALL)";
    when look_back_state_6(p, contract, y, bal, prin);
    when look_back_final_period_6(p, contract, y, step, days);
    when growth_factor(step, days, f);
    then look_back_balance_at_completion_460b2C(p, contract, round(bal * f, 2, "HALF_UP"), prin);
}
rule LookBackLevel7(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) defeasible {
    label en official "the walk moves to the next accrual period";
    when look_back_full_period_6(p, contract, y, y_next, step, days);
    then look_back_level_7(p, contract, y_next);
}
rule LookBackState7From6(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, bal: Money, prin: Money, step: Decimal, days: Integer, f: Decimal, dn: Money) defeasible {
    label en official "the balance grown over the full period plus the next year's amount starts the next level (section 460(b)(2)(B)-(C))";
