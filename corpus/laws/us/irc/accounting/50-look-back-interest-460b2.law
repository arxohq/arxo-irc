// Section 460(b)(2)(A)-(C), (b)(5)(D)(ii): the look-back interest (stage 4,
// DECISION-0379 with deontics). Closes G4800-G4802 (the previous stage could
// not compound daily interest: no Decimal power, no multi-year ledger).
//
// TECHNIQUE (stated): BOUNDED UNROLLING. The look-back years are walked along
// the interest accrual periods of section 460(b)(7)(B) (return due date to
// return due date) with a Horner-style balance: at the start of each accrual
// period the year's overpayment or underpayment (signed: positive is an
// underpayment) is added to the running balance, and during the period the
// balance grows by the daily factor (1 + r/365)^days of the adjusted
// overpayment rate of that period (section 460(b)(2)(C), compounded daily).
// The interest is the final balance minus the sum of the amounts. Because
// overpayments and underpayments carry the same rate, the net amount gives
// the net interest (positive: the taxpayer pays; negative: entitled to
// receive, section 460(b)(1)(B)).
// DEPTH: at most 10 accrual periods after the first look-back year; a contract
// that completes later gets NO interest here (NEITHER), never a wrong number.
// The chain uses distinct relations per level (a recursive relation is
// LDC-E4102). The daily growth factor comes from module 49 (14-bit binary
// exponentiation: at most 16383 days per period).
//
// JUDGMENT CALLS: (1) the overpayment or underpayment of tax for each year
// under paragraph (2)(B) is the tax owner's function (section 1/11 tax
// recomputed on the reallocated income, with NOL, credits, barred years) and
// is a CASE-SUPPLIED signed amount, or, for a pass-thru entity, is derived by
// the simplified method of paragraph (4)(A)(ii) (module 35); (2) interest runs
// from the return due date of the year to the completion date (the statute does
// not spell the ends; the regulations do), counted as the days between the two
// dates; (3) the daily rate is the annual rate divided by 365 (rounded to 12
// places HALF_UP); (4) the running balance is rounded to cents HALF_UP at the
// end of each accrual period; (5) the completion date is the fact of section
// 460(c)(3)(B) (`contract_completion_date_460c3B`).
//
// Not modelled: the discounting of amounts taken into account after
// completion is in this module (section 460(b)(2), last sentences); the
// regulations that fix the exact accrual dates are not.

// ===================== (B): the amount of each look-back year =====================

use self::{
    IRC_S460_B,
    Person,
    TaxableYear,
    adjusted_overpayment_rate_460b7A,
    contract_completion_date_460c3B,
    elects_out_of_discounting_460b2,
    growth_factor,
    growth_request,
    look_back_cumulative_income_460b2A,
    look_back_not_applicable_460b3B,
    look_back_not_required_for_small_discrepancies_460b6B,
    look_back_overpayment_460b4Aii,
    look_back_underpayment_460b4Aii,
    preceding_taxable_year_465,
    return_due_date_without_extensions_460b7B,
    semiannual_factor,
    semiannual_factor_request,
    ten_percent_method_applies_to_contract_460b5C,
    ten_percent_year_460b5Bii,
};

pub relation look_back_first_year_460b2(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "the first taxable year to which the income of the contract is allocated by the look-back method (section 460(b)(2)(A))";
}
pub relation look_back_tax_change_460b2B(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the overpayment (negative) or underpayment (positive) of tax for the year that results solely from the allocation of paragraph (2)(A), computed for interest only; the tax function of the tax owner is applied outside this package (section 460(b)(2)(B)); a case fact, alternative to the pass-thru derivation (never both)";
}
relation look_back_year_request_460b2(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "the chain asks for the amount of a look-back year (arithmetic helper)";
}
pub relation look_back_year_has_change_460b2B(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "the year has an overpayment or underpayment amount, asserted or derived by the pass-thru method";
}
rule LookBackYearHasAssertedChange(p: Person, contract: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "an asserted amount exists";
    when look_back_tax_change_460b2B(p, contract, y, amount);
    then look_back_year_has_change_460b2B(p, contract, y);
}
rule LookBackYearHasPassThruUnderpayment(p: Person, contract: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a pass-thru underpayment exists";
    when look_back_underpayment_460b4Aii(p, contract, y, amount);
    then look_back_year_has_change_460b2B(p, contract, y);
}
rule LookBackYearHasPassThruOverpayment(p: Person, contract: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a pass-thru overpayment exists";
    when look_back_overpayment_460b4Aii(p, contract, y, amount);
    then look_back_year_has_change_460b2B(p, contract, y);
}
pub relation look_back_year_amount_460b2B(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the signed amount of the look-back year (positive: underpayment; negative: overpayment); zero when the year has none";
}
@source(IRC_S460_B, quote = "(B) second, determining (solely for purposes of computing such interest) the overpayment or underpayment of tax for each taxable year referred to in subparagraph (A) which would result solely from the application of subparagraph (A), and")
rule LookBackYearAmountAsserted(p: Person, contract: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the asserted overpayment or underpayment of the year (section 460(b)(2)(B))";
    when look_back_year_request_460b2(p, contract, y);
    when look_back_tax_change_460b2B(p, contract, y, amount);
    then look_back_year_amount_460b2B(p, contract, y, amount);
}
@source(IRC_S460_B, quote = "shall be treated as giving rise to an underpayment determined by applying the highest rate for such year to such increase, and")
rule LookBackYearAmountPassThruUnderpayment(p: Person, contract: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a pass-thru entity's underpayment of the year (section 460(b)(4)(A)(ii)(I) feeding (b)(2)(B))";
    when look_back_year_request_460b2(p, contract, y);
    when look_back_underpayment_460b4Aii(p, contract, y, amount);
    then look_back_year_amount_460b2B(p, contract, y, amount);
}
@source(IRC_S460_B, quote = "shall be treated as giving rise to an overpayment determined by applying the highest rate for such year to such decrease, and")
rule LookBackYearAmountPassThruOverpayment(p: Person, contract: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a pass-thru entity's overpayment of the year, entered as a negative amount (section 460(b)(4)(A)(ii)(II) feeding (b)(2)(B))";
    when look_back_year_request_460b2(p, contract, y);
    when look_back_overpayment_460b4Aii(p, contract, y, amount);
    then look_back_year_amount_460b2B(p, contract, y, 0.00 USD - amount);
}
rule LookBackYearAmountNone(p: Person, contract: Integer, y: TaxableYear) defeasible {
    label en official "a year without an overpayment or underpayment counts zero";
    when look_back_year_request_460b2(p, contract, y);
    when not_known(look_back_year_has_change_460b2B(p, contract, y));
    then look_back_year_amount_460b2B(p, contract, y, 0.00 USD);
}

// ===================== (C): interest compounded daily =====================

pub relation look_back_interest_applies_460b1B(p: Person, contract: Integer) kind institutional {
    label en official "the look-back interest of paragraph (2) is to be computed for the contract: it is not excluded by (b)(3)(B) (small short contracts) or by (b)(6) (de minimis election)";
}
rule LookBackInterestAppliesUnlessExcluded(p: Person, contract: Integer, y0: TaxableYear) defeasible {
    label en official "look-back interest applies unless an exclusion applies (section 460(b)(1)(B), (b)(3)(B), (b)(6))";
    when look_back_first_year_460b2(p, contract, y0);
    when not_known(look_back_not_applicable_460b3B(p, contract));
    when not_known(look_back_not_required_for_small_discrepancies_460b6B(p, contract));
    then look_back_interest_applies_460b1B(p, contract);
}
rule LookBackYearRequestFirst(p: Person, contract: Integer, y0: TaxableYear) defeasible {
    label en official "the chain asks for the first year's amount";
    when look_back_first_year_460b2(p, contract, y0);
    when look_back_interest_applies_460b1B(p, contract);
    then look_back_year_request_460b2(p, contract, y0);
}

relation look_back_level_0(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 0: the accrual period after look-back year number 1 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_0(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 0: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_0(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 0: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_0(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 0: the balance at the start of the accrual period after look-back year number 1, with the sum of the year amounts so far";
}
relation look_back_level_1(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 1: the accrual period after look-back year number 2 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_1(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 1: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_1(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 1: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_1(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 1: the balance at the start of the accrual period after look-back year number 2, with the sum of the year amounts so far";
}
relation look_back_level_2(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 2: the accrual period after look-back year number 3 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_2(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 2: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_2(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 2: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_2(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 2: the balance at the start of the accrual period after look-back year number 3, with the sum of the year amounts so far";
}
relation look_back_level_3(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 3: the accrual period after look-back year number 4 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_3(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 3: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_3(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 3: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_3(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 3: the balance at the start of the accrual period after look-back year number 4, with the sum of the year amounts so far";
}
relation look_back_level_4(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 4: the accrual period after look-back year number 5 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_4(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 4: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_4(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 4: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_4(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 4: the balance at the start of the accrual period after look-back year number 5, with the sum of the year amounts so far";
}
relation look_back_level_5(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 5: the accrual period after look-back year number 6 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_5(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 5: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_5(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 5: the accrual period runs to the next return due date; the daily step and its days";
}
relation look_back_state_5(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 5: the balance at the start of the accrual period after look-back year number 6, with the sum of the year amounts so far";
}
relation look_back_level_6(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 6: the accrual period after look-back year number 7 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_6(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 6: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
