    then look_back_state_7(p, contract, y_next, round(bal * f, 2, "HALF_UP") + dn, prin + dn);
}
@source(IRC_S460_B, quote = "(C) then using the adjusted overpayment rate (as defined in paragraph (7)), compounded daily, on the overpayment or underpayment determined under subparagraph (B).")
rule LookBackFinalPeriod7(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date, dc: Date, r: Decimal) defeasible {
    label en official "the contract is completed inside the accrual period of level 7: daily interest at the adjusted overpayment rate up to the completion date (section 460(b)(2)(C))";
    when look_back_level_7(p, contract, y);
    when preceding_taxable_year_465(y, y_next);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    when contract_completion_date_460c3B(contract, dc);
    when dc <= due_next;
    when adjusted_overpayment_rate_460b7A(p, y, r);
    then look_back_final_period_7(p, contract, y, div_round(r, 365.0, 12, "HALF_UP"), max(days_between(due, dc), 0));
}
rule LookBackFullPeriod7(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date, dc: Date, r: Decimal) defeasible {
    label en official "the accrual period of level 7 ends before completion: daily interest for the whole period (section 460(b)(2)(C), (b)(7)(B))";
    when look_back_level_7(p, contract, y);
    when preceding_taxable_year_465(y, y_next);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    when contract_completion_date_460c3B(contract, dc);
    when dc > due_next;
    when adjusted_overpayment_rate_460b7A(p, y, r);
    then look_back_full_period_7(p, contract, y, y_next, div_round(r, 365.0, 12, "HALF_UP"), days_between(due, due_next));
}
