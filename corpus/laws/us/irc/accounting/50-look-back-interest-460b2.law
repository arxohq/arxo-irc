rule LookBackInterestIsBalanceMinusPrincipal(p: Person, contract: Integer, bal: Money, prin: Money) defeasible {
    label en official "interest = compounded balance - sum of the year amounts (section 460(b)(2)(C))";
    when look_back_balance_at_completion_460b2C(p, contract, bal, prin);
    then look_back_interest_460b2C(p, contract, bal - prin);
}
@source(IRC_S460_B, quote = "the taxpayer shall pay (or shall be entitled to receive) interest computed under the look-back method of paragraph (2).")
rule LookBackInterestPayable(p: Person, contract: Integer, interest: Money) defeasible {
    label en official "a positive net interest is payable by the taxpayer (section 460(b)(1)(B))";
    when look_back_interest_460b2C(p, contract, interest);
    when interest > 0.00 USD;
    then look_back_interest_payable_460b1B(p, contract, interest);
}
rule LookBackInterestReceivable(p: Person, contract: Integer, interest: Money) defeasible {
    label en official "a negative net interest is receivable by the taxpayer (section 460(b)(1)(B))";
    when look_back_interest_460b2C(p, contract, interest);
    when interest < 0.00 USD;
    then look_back_interest_receivable_460b1B(p, contract, 0.00 USD - interest);
}

// ===================== the 10-percent method inside the look-back =====================

pub relation look_back_cumulative_income_ten_percent_460b5Dii(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the cumulative look-back income under the 10-percent method: nothing before the 10-percent year, the ordinary look-back amount from that year (section 460(b)(5)(D)(ii)); JUDGMENT CALL: the 10-percent year is the one of section 460(b)(5)(B)(ii) (estimated costs)";
}
@source(IRC_S460_B, quote = "The 10-percent method shall be taken into account for purposes of applying the look-back method of paragraph (2) to any taxpayer making an election under this paragraph.")
rule LookBackIncomeTenPercentFromTheTenPercentYear(p: Person, contract: Integer, y: TaxableYear, y10: TaxableYear, d10: Date, d: Date, amount: Money) defeasible {
    label en official "from the 10-percent year the look-back income is the ordinary look-back amount (section 460(b)(5)(D)(ii))";
    when ten_percent_method_applies_to_contract_460b5C(p, contract);
    when ten_percent_year_460b5Bii(p, contract, y10);
    when us.irc.core::begins(y10, d10);
    when us.irc.core::begins(y, d);
    when d >= d10;
    when look_back_cumulative_income_460b2A(p, contract, y, amount);
    then look_back_cumulative_income_ten_percent_460b5Dii(p, contract, y, amount);
}
rule LookBackIncomeTenPercentBeforeTheTenPercentYear(p: Person, contract: Integer, y: TaxableYear, y10: TaxableYear, d10: Date, d: Date, amount: Money) defeasible {
    label en official "before the 10-percent year no item is taken into account in the look-back either (section 460(b)(5)(D)(ii))";
    when ten_percent_method_applies_to_contract_460b5C(p, contract);
    when ten_percent_year_460b5Bii(p, contract, y10);
    when us.irc.core::begins(y10, d10);
    when us.irc.core::begins(y, d);
    when d < d10;
    when look_back_cumulative_income_460b2A(p, contract, y, amount);
    then look_back_cumulative_income_ten_percent_460b5Dii(p, contract, y, 0.00 USD);
}

// ===================== amounts taken into account after completion =====================

pub relation amount_taken_into_account_after_completion_460b2(p: Person, contract: Integer, item: Integer, taken_on: Date, amount: Money) kind empirical {
    label en official "an amount properly taken into account after completion of the contract, and the date on which it is properly taken into account (section 460(b)(2), last sentences)";
}
pub relation federal_mid_term_rate_as_of_460b2(taken_on: Date, rate: Decimal) kind empirical {
    label en official "the Federal mid-term rate under section 1274(d) as of the time the amount was properly taken into account, an annual rate compounded semiannually; the published value is asserted (SOURCE_GAP: no IRB rate table pinned)";
}
pub relation discounted_post_completion_amount_460b2(p: Person, contract: Integer, item: Integer, amount: Money) kind institutional {
    label en official "the post-completion amount discounted to its value as of the completion of the contract: amount / factor, factor = (1 + rate/2)^n over the whole six-month periods times simple interest over the stub, one rounding to cents HALF_UP (JUDGMENT CALL); the discounting is absent when the taxpayer elected out";
}
relation post_completion_discount_request_460b2(p: Person, contract: Integer, item: Integer, taken_on: Date, dc: Date, rate: Decimal, amount: Money) kind institutional {
    label en official "helper: the item is to be discounted";
}
@source(IRC_S460_B, quote = "For purposes of the preceding sentence, any amount properly taken into account after completion of the contract shall be taken into account by discounting (using the Federal mid-term rate determined under section 1274(d) as of the time such amount was properly taken into account) such amount to its value as of the completion of the contract.")
rule PostCompletionDiscountRequest(p: Person, contract: Integer, item: Integer, taken_on: Date, dc: Date, rate: Decimal, amount: Money) defeasible {
    label en official "an amount taken into account after completion is discounted unless the taxpayer elected out (section 460(b)(2))";
    when amount_taken_into_account_after_completion_460b2(p, contract, item, taken_on, amount);
    when contract_completion_date_460c3B(contract, dc);
    when federal_mid_term_rate_as_of_460b2(taken_on, rate);
    when not_known(elects_out_of_discounting_460b2(p, contract));
    then post_completion_discount_request_460b2(p, contract, item, taken_on, dc, rate, amount);
}
rule PostCompletionDiscountAsksFactor(p: Person, contract: Integer, item: Integer, taken_on: Date, dc: Date, rate: Decimal, amount: Money) defeasible {
    label en official "the discount factor of the span from completion to the date taken into account";
    when post_completion_discount_request_460b2(p, contract, item, taken_on, dc, rate, amount);
    then semiannual_factor_request(rate, dc, taken_on);
}
rule PostCompletionDiscountedAmount(p: Person, contract: Integer, item: Integer, taken_on: Date, dc: Date, rate: Decimal, amount: Money, f: Decimal) defeasible {
    label en official "the value as of completion";
    when post_completion_discount_request_460b2(p, contract, item, taken_on, dc, rate, amount);
    when semiannual_factor(rate, dc, taken_on, f);
    then discounted_post_completion_amount_460b2(p, contract, item, div_round(amount, f, 2, "HALF_UP"));
}
rule PostCompletionAmountWhenElectedOut(p: Person, contract: Integer, item: Integer, taken_on: Date, amount: Money) defeasible {
    label en official "with the election out of discounting the amount is taken into account at its face value (section 460(b)(2), last sentence)";
    when amount_taken_into_account_after_completion_460b2(p, contract, item, taken_on, amount);
    when elects_out_of_discounting_460b2(p, contract);
    then discounted_post_completion_amount_460b2(p, contract, item, amount);
}

