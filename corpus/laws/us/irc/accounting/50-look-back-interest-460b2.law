}
relation look_back_state_6(p: Person, contract: Integer, y: TaxableYear, balance: Money, principal: Money) kind institutional {
    label en official "level 6: the balance at the start of the accrual period after look-back year number 7, with the sum of the year amounts so far";
}
relation look_back_level_7(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "level 7: the accrual period after look-back year number 8 is reached (calendar walk, independent of amounts)";
}
relation look_back_final_period_7(p: Person, contract: Integer, y: TaxableYear, step: Decimal, days: Integer) kind institutional {
    label en official "level 7: the contract is completed inside this accrual period; the daily step and the days from the return due date to the completion date";
}
relation look_back_full_period_7(p: Person, contract: Integer, y: TaxableYear, y_next: TaxableYear, step: Decimal, days: Integer) kind institutional {
