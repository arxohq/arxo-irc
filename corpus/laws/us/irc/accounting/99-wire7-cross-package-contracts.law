// Accounting -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified): section 631(c)(1) related-person exclusion reads the owner.
//
// `disposal_to_related_person_excluded_under_631c` was a case-asserted fact ("bounded follow-up", TECH-GAPS G323): the owner `deductions`
// publishes the section 267(b) relationships as `related_persons(a, b, relationship)`. The exclusion is now DERIVED from the owner's
// relation once the case names the buyer (`buyer_of_coal_or_iron_ore_631c`); the old case-fact channel stays valid (the relation is
// institutional and may still be asserted, DECISIONS Д-15/Д-19), so existing scenarios are unchanged.
//
// JUDGMENT CALLS.
//  - The owner covers the section 267(b) relationships only. The section 707(b) relationships and the "owned or controlled ... by the
//    same interests" limb of section 631(c)(2) are NOT derived here; a case asserts them through the old fact.
//  - The relationship kind is an existential variable: any section 267(b) relationship between seller and buyer excludes.

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

use self::{
    Asset,
    Person,
    TaxableYear,
    disposal_to_related_person_excluded_under_631c,
};

pub relation buyer_of_coal_or_iron_ore_631c(owner: Person, deposit: Asset, y: TaxableYear, buyer: Person) kind empirical {
    label en official "the person to whom the owner disposes of the coal or iron ore in the taxable year (section 631(c))";
}
rule W7Section631cRelatedBuyerExcluded strict {
    label en official "section 631(c)(1): a disposal to a person in a section 267(b) relationship with the owner is excluded (owner package `deductions`)";
    for owner: Person;
    for deposit: Asset;
    for y: TaxableYear;
    for buyer: Person;
    for relationship: us.irc.deductions::RelatedPartyRelationship;
    when buyer_of_coal_or_iron_ore_631c(owner, deposit, y, buyer)
        and us.irc.deductions::related_persons(owner, buyer, relationship);
    then disposal_to_related_person_excluded_under_631c(owner, deposit, y);
}
