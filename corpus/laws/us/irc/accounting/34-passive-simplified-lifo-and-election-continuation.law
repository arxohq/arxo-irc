// Stage 3 (DECISION-0379 with deontics): section 469(c)(7)(A)(ii), (i)(6)(D),
// (j)(5); section 474(b), (d)(1), (d)(4)(A)(i); and the date-keyed continuation
// of elections for sections 455, 456, 458 and 474 (TECH-GAPS G2108).
//
// G2108 is solved without recursion over years: an election first made in the
// year y0 applies to every later year y (compared by the `begins` date of the
// two `TaxableYear`s) unless a consent to revocation falls in a year yr with
// begins(y0) < begins(yr) <= begins(y). The years are `us.irc.core::begins`
// facts of the case.

// ===================== Section 469 =====================

use self::{
    IRC_S455_C,
    IRC_S456_C,
    IRC_S458_C,
    IRC_S469_C,
    IRC_S469_I,
    IRC_S469_J,
    IRC_S474_B,
    IRC_S474_C,
    IRC_S474_D,
    Person,
    ReturnableMerchandise,
    TaxableYear,
    amount_excluded_458b6,
    applies_469c7,
    dues_portion_for_year_456,
    is_eligible_small_business_474,
    is_qualified_sale_458b5,
    is_rental_real_estate_activity,
    legal_obligation_to_adjust_price_amount,
    member_gross_receipts_474,
    preceding_taxable_year_465,
    prepaid_dues_election_in_effect_456,
    prepaid_dues_income_included_456a,
    prepaid_subscription_election_in_effect_455,
    prepaid_subscription_income_included_455a,
    price_adjusted_because_not_resold,
    rental_real_estate_interests_treated_as_one_activity,
    returns_exclusion_election_in_effect_458,
    sale_category_458,
    secretary_consents_to_revocation_455,
    secretary_consents_to_revocation_474,
    simplified_dollar_value_lifo_election_in_effect_474,
    simplified_lifo_applies_in_later_year_474d2B,
    subscription_income_attributable_to_year_455,
    year_of_change_474,
};

pub relation rental_real_estate_interest_separate_activity_469c7Aii(p: Person, y: TaxableYear, activity: Integer) kind institutional {
    label en official "for a taxpayer to whom section 469(c)(7) applies, each interest in rental real estate is a separate activity, unless the taxpayer elects to treat all interests as one activity (section 469(c)(7)(A)(ii) and the flush election sentence)";
}
@source(IRC_S469_C, quote = "(ii) this section shall be applied as if each interest of the taxpayer in rental real estate were a separate activity.")
rule EachRentalRealEstateInterestIsASeparateActivity(p: Person, y: TaxableYear, activity: Integer) defeasible {
    label en official "each rental real estate interest is its own activity when (c)(7) applies and no aggregation election is in effect (section 469(c)(7)(A)(ii))";
    when applies_469c7(p, y);
    when is_rental_real_estate_activity(p, activity);
    when not_known(rental_real_estate_interests_treated_as_one_activity(p, y));
    then rental_real_estate_interest_separate_activity_469c7Aii(p, y, activity);
}
pub relation individual_participates_actively_in_rental_real_estate_469i(p: Person, y: TaxableYear) kind empirical {
    label en official "the individual himself or herself actively participates in the rental real estate activity in the taxable year (section 469(i)(6)(A))";
}
pub relation spouse_of_individual_469i6D(p: Person, s: Person) kind empirical {
    label en official "s is the spouse of the taxpayer p (section 469(i)(6)(D))";
}
pub relation actively_participates_including_spouse_469i6D(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer actively participates when the taxpayer or the spouse actively participates: the spouse's participation is taken into account (section 469(i)(6)(D))";
}
rule ActiveParticipationByTheTaxpayer(p: Person, y: TaxableYear) defeasible {
    label en official "the taxpayer's own active participation (section 469(i)(6)(A))";
    when individual_participates_actively_in_rental_real_estate_469i(p, y);
    then actively_participates_including_spouse_469i6D(p, y);
}
@source(IRC_S469_I, quote = "In determining whether a taxpayer actively participates, the participation of the spouse of the taxpayer shall be taken into account.")
rule ActiveParticipationBySpouseCounts(p: Person, s: Person, y: TaxableYear) defeasible {
    label en official "the spouse's active participation counts for the taxpayer (section 469(i)(6)(D))";
    when spouse_of_individual_469i6D(p, s);
    when individual_participates_actively_in_rental_real_estate_469i(s, y);
    then actively_participates_including_spouse_469i6D(p, y);
}
pub relation passive_credit_amount_469j5(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credits from a passive activity for the taxable year (section 469(j)(5))";
}
pub relation marginal_regular_tax_rate_469j5(p: Person, y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the marginal rate of the regular tax at the taxpayer's taxable income; the rate schedule belongs to the income-individual owner and the bracket is asserted (section 469(j)(5))";
}
pub relation deduction_headroom_within_marginal_bracket_469j5(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "how much taxable income can be reduced before the marginal rate changes (section 469(j)(5)); asserted from the rate schedule";
}
pub relation deduction_equivalent_of_credits_469j5(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction equivalent of credits: the amount that, allowed as a deduction, reduces the regular tax by the credits; here credit / marginal rate, exact only while the deduction stays inside the marginal bracket, otherwise not established; one rounding to cents HALF_UP (JUDGMENT CALL) (section 469(j)(5))";
}
@source(IRC_S469_J, quote = "The deduction equivalent of credits from a passive activity for any taxable year is the amount which (if allowed as a deduction) would reduce the regular tax liability for such taxable year by an amount equal to such credits.")
rule DeductionEquivalentOfCreditsWithinOneBracket(p: Person, y: TaxableYear, credit: Money, rate: Decimal, headroom: Money) defeasible {
    label en official "credit divided by the marginal rate, when the resulting deduction stays inside the bracket (credit <= headroom x rate) (section 469(j)(5))";
    when passive_credit_amount_469j5(p, y, credit);
    when marginal_regular_tax_rate_469j5(p, y, rate);
    when deduction_headroom_within_marginal_bracket_469j5(p, y, headroom);
    when rate > 0.0;
    when credit <= headroom * rate;
    then deduction_equivalent_of_credits_469j5(p, y, div_round(credit, rate, 2, "HALF_UP"));
}

// ===================== Section 474 =====================

pub enum PriceIndex474 {
    ProducerPriceIndex;
    ConsumerPriceIndex;
    label en official "the applicable Government price index: the Producer Price Index, or the Consumer Price Index for a retailer using the retail method (section 474(b)(2))";
}
pub relation retailer_using_retail_method_474b2B(p: Person) kind empirical {
    label en official "the taxpayer is a retailer using the retail method (section 474(b)(2)(B))";
}
pub relation applicable_price_index_474b2(p: Person, index: PriceIndex474) kind institutional {
    label en official "the applicable Government price index: the Producer Price Index, except the Consumer Price Index for a retailer using the retail method (section 474(b)(2))";
}
pub relation taxpayer_uses_section_474_index_474(p: Person) kind empirical {
    label en official "the taxpayer prices inventories under section 474 and needs the applicable Government price index";
}
@source(IRC_S474_B, quote = "(A) except as provided in subparagraph (B), the Producer Price Index published by the Bureau of Labor Statistics, or")
rule ApplicableIndexIsProducerPriceIndex(p: Person) defeasible {
    label en official "the Producer Price Index unless the taxpayer is a retailer using the retail method (section 474(b)(2)(A))";
    when taxpayer_uses_section_474_index_474(p);
    when not_known(retailer_using_retail_method_474b2B(p));
    then applicable_price_index_474b2(p, ProducerPriceIndex);
}
@source(IRC_S474_B, quote = "(B) in the case of a retailer using the retail method, the Consumer Price Index published by the Bureau of Labor Statistics.")
rule ApplicableIndexIsConsumerPriceIndexForRetailers(p: Person) defeasible {
    label en official "the Consumer Price Index for a retailer using the retail method (section 474(b)(2)(B))";
    when taxpayer_uses_section_474_index_474(p);
    when retailer_using_retail_method_474b2B(p);
    then applicable_price_index_474b2(p, ConsumerPriceIndex);
}
pub relation two_digit_sic_in_producer_prices_data_report_474b3A(category: Integer) kind empirical {
    label en official "the category is a 2-digit standard industrial classification in the Producer Prices Data Report (section 474(b)(3)(A))";
}
pub relation general_expenditure_category_in_cpi_detailed_report_474b3B(category: Integer) kind empirical {
    label en official "the category is a general expenditure category in the Consumer Price Index Detailed Report (section 474(b)(3)(B))";
}
pub relation major_category_474b3(category: Integer, index: PriceIndex474) kind institutional {
    label en official "a major category of the applicable index: a 2-digit SIC of the Producer Prices Data Report for the Producer Price Index, a general expenditure category of the CPI Detailed Report for the Consumer Price Index (section 474(b)(3))";
}
@source(IRC_S474_B, quote = "(A) in the case of the Producer Price Index, any of the 2-digit standard industrial classifications in the Producer Prices Data Report, or")
rule MajorCategoryOfProducerPriceIndex(category: Integer) strict {
    label en official "a 2-digit SIC of the Producer Prices Data Report is a Producer Price Index major category (section 474(b)(3)(A))";
    when two_digit_sic_in_producer_prices_data_report_474b3A(category);
    then major_category_474b3(category, ProducerPriceIndex);
}
@source(IRC_S474_B, quote = "(B) in the case of the Consumer Price Index, any of the general expenditure categories in the Consumer Price Index Detailed Report.")
rule MajorCategoryOfConsumerPriceIndex(category: Integer) strict {
    label en official "a general expenditure category of the CPI Detailed Report is a Consumer Price Index major category (section 474(b)(3)(B))";
    when general_expenditure_category_in_cpi_detailed_report_474b3B(category);
    then major_category_474b3(category, ConsumerPriceIndex);
}
pub relation dollar_value_method_of_pricing_inventories_474b1(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer prices inventories on a dollar-value method (section 474(b)(1))";
}
pub relation separate_pool_for_each_major_category_474b1A(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer maintains a separate inventory pool for items in each major category in the applicable Government price index (section 474(b)(1)(A))";
}
pub relation pool_adjustment_based_on_category_index_change_474b1B(p: Person, y: TaxableYear) kind empirical {
    label en official "the adjustment for each separate pool is based on the change from the preceding taxable year in the component of the index for the major category (section 474(b)(1)(B))";
}
pub relation simplified_dollar_value_method_474b1(p: Person, y: TaxableYear) kind institutional {
    label en official "the simplified dollar-value method of pricing inventories: a dollar-value method with a separate pool per major category, adjusted by the category index change (section 474(b)(1))";
}
@source(IRC_S474_B, quote = "The simplified dollar-value method of pricing inventories is a dollar-value method of pricing inventories under which—")
rule SimplifiedDollarValueMethodDefinition(p: Person, y: TaxableYear) strict {
    label en official "a dollar-value method meeting (A) and (B) is the simplified dollar-value method (section 474(b)(1))";
    when dollar_value_method_of_pricing_inventories_474b1(p, y);
    when separate_pool_for_each_major_category_474b1A(p, y);
    when pool_adjustment_based_on_category_index_change_474b1B(p, y);
    then simplified_dollar_value_method_474b1(p, y);
}
pub relation index_component_value_474b1B(index: PriceIndex474, category: Integer, y: TaxableYear, value: Decimal) kind empirical {
    label en official "the value of the index component for the major category for the taxable year (section 474(b)(1)(B)); the published value is a case fact";
}
pub relation pool_index_change_474b1B(p: Person, index: PriceIndex474, category: Integer, y: TaxableYear, current: Decimal, prior: Decimal) kind institutional {
    label en official "the change of the category component from the preceding taxable year, as the pair (current, prior) on which the pool adjustment is based (section 474(b)(1)(B)); the pool's own adjustment factor is not computed because the text gives no formula";
}
@source(IRC_S474_B, quote = "the adjustment for each such separate pool is based on the change from the preceding taxable year in the component of such index for the major category.")
rule PoolIndexChangeFromPrecedingYear(p: Person, index: PriceIndex474, category: Integer, y: TaxableYear, y_prior: TaxableYear, current: Decimal, prior: Decimal) defeasible {
    label en official "the adjustment basis is the component value of the year and of the preceding year for the major category of the applicable index (section 474(b)(1)(B))";
    when simplified_dollar_value_method_474b1(p, y);
    when major_category_474b3(category, index);
    when preceding_taxable_year_465(y_prior, y);
    when index_component_value_474b1B(index, category, y, current);
    when index_component_value_474b1B(index, category, y_prior, prior);
    then pool_index_change_474b1B(p, index, category, y, current, prior);
}
pub relation group_test_year_474(g: Integer, y: TaxableYear) kind empirical {
    label en official "the controlled group is tested for the taxable year (section 474(d)(1))";
}
pub relation single_employer_under_section_52_474d1B(p: Person, g: Integer) kind empirical {
    label en official "the person would be treated as a single employer with the other members of the group under section 52 (section 474(d)(1)(B)); the section 52(a)-(b) control tests are asserted";
}
pub relation group_average_gross_receipts_474(g: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the average annual gross receipts of the controlled group with all component members treated as one taxpayer: the sum of the members' averages (section 474(d)(1)(A))";
}
@source(IRC_S474_D, quote = "all persons which are component members of such group shall be treated as 1 taxpayer for purposes of determining the gross receipts of the taxpayer.")
rule GroupAverageGrossReceiptsSum(g: Integer, y: TaxableYear) strict {
    label en official "component members of a section 52 group are one taxpayer for gross receipts (section 474(d)(1)); the members' 3-year averages add";
    when group_test_year_474(g, y);
    then group_average_gross_receipts_474(g, y, sum all amt: Money for m: Person where single_employer_under_section_52_474d1B(m, g) and member_gross_receipts_474(m, y, amt));
}
@source(IRC_S474_C, quote = "a taxpayer is an eligible small business for any taxable year if the average annual gross receipts of the taxpayer for the 3 preceding taxable years do not exceed $5,000,000.")
rule EligibleSmallBusinessByGroupReceipts(p: Person, g: Integer, y: TaxableYear, total: Money) strict {
    label en official "a member of a controlled group is eligible when the group's average gross receipts do not exceed the section 474(c) limit (section 474(c), (d)(1))";
    when single_employer_under_section_52_474d1B(p, g);
    when group_average_gross_receipts_474(g, y, total);
    when total <= round(SimplifiedLifoGrossReceiptsLimit, 2, "HALF_UP");
    then is_eligible_small_business_474(p, y);
}
pub relation first_taxable_year_election_applies_474d4B(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is the first taxable year to which the section 474 election applies (section 474(d)(4)(B)(i))";
}
pub relation inventory_pools_by_major_category_of_applicable_index_474d4Ai(p: Person, y: TaxableYear) kind institutional {
    label en official "in the first year to which the election applies the inventory pools are established in accordance with the major categories of the applicable Government price index (section 474(d)(4)(A)(i)(I))";
}
@source(IRC_S474_D, quote = "be established in accordance with the major categories in the applicable Government price index, or")
rule PoolsEstablishedByMajorCategoriesInFirstElectionYear(p: Person, y: TaxableYear) defeasible {
    label en official "the year of change that is the first election year builds its pools on the index's major categories (section 474(d)(4)(A)(i)(I))";
    when year_of_change_474(p, y);
    when first_taxable_year_election_applies_474d4B(p, y);
    then inventory_pools_by_major_category_of_applicable_index_474d4Ai(p, y);
}

// ===================== Date-keyed election continuation (G2108) =====================

pub relation election_455_applies_in_year(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 455 election applies in the taxable year: in effect for it, or carried by the date-keyed continuation (section 455(c)(4))";
}
pub relation election_455_revoked_between(p: Person, y0: TaxableYear, y: TaxableYear) kind institutional {
    label en official "the Secretary consented to revocation in a year after the election year y0 and not after y (section 455(c)(4))";
}
rule Election455RevokedBetweenYears(p: Person, y0: TaxableYear, y: TaxableYear, yr: TaxableYear, d0: Date, dr: Date, d: Date) defeasible {
    label en official "a consent to revocation between the election year and the year tested ends the continuation";
    when prepaid_subscription_election_in_effect_455(p, y0);
    when us.irc.core::begins(y0, d0);
    when secretary_consents_to_revocation_455(p, yr);
    when us.irc.core::begins(yr, dr);
    when us.irc.core::begins(y, d);
    when d0 < dr;
    when dr <= d;
    then election_455_revoked_between(p, y0, y);
}
@source(IRC_S455_C, quote = "An election under this section shall be effective for the taxable year with respect to which it is first made and for all subsequent taxable years")
rule Election455ContinuesByDate(p: Person, y0: TaxableYear, y: TaxableYear, d0: Date, d: Date) defeasible {
    label en official "an election first made in y0 is effective in every later year y unless revoked with the Secretary's consent in between (section 455(c)(4)); replaces the one-step chain for all N years";
    when prepaid_subscription_election_in_effect_455(p, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d0 < d;
    when us.irc.core::year_of(p, y);
    when not_known(election_455_revoked_between(p, y0, y));
    then election_455_applies_in_year(p, y);
}
rule Election455AppliesInElectionYear(p: Person, y: TaxableYear) defeasible {
    label en official "the election is effective for the year with respect to which it is first made (section 455(c)(4))";
    when prepaid_subscription_election_in_effect_455(p, y);
    then election_455_applies_in_year(p, y);
}
rule PrepaidSubscriptionIncludedInContinuedElectionYears(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "under the continued election, subscription income is included year by year while the delivery liability exists (section 455(a), (c)(4))";
    when election_455_applies_in_year(p, y);
    when subscription_income_attributable_to_year_455(p, y, item, amount);
    then prepaid_subscription_income_included_455a(p, y, item, amount);
}
pub relation secretary_consents_to_revocation_456(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to revocation of the section 456 election effective for the taxable year (section 456(c)(4))";
}
pub relation election_456_applies_in_year(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 456 election applies in the taxable year: in effect for it, or carried by the date-keyed continuation (section 456(c)(4))";
}
pub relation election_456_revoked_between(p: Person, y0: TaxableYear, y: TaxableYear) kind institutional {
    label en official "the Secretary consented to revocation in a year after the election year y0 and not after y (section 456(c)(4))";
}
rule Election456RevokedBetweenYears(p: Person, y0: TaxableYear, y: TaxableYear, yr: TaxableYear, d0: Date, dr: Date, d: Date) defeasible {
    label en official "a consent to revocation between the election year and the year tested ends the continuation";
    when prepaid_dues_election_in_effect_456(p, y0);
    when us.irc.core::begins(y0, d0);
    when secretary_consents_to_revocation_456(p, yr);
    when us.irc.core::begins(yr, dr);
    when us.irc.core::begins(y, d);
    when d0 < dr;
    when dr <= d;
    then election_456_revoked_between(p, y0, y);
}
@source(IRC_S456_C, quote = "An election under this section shall be effective for the taxable year with respect to which it is first made and for all subsequent taxable years")
rule Election456ContinuesByDate(p: Person, y0: TaxableYear, y: TaxableYear, d0: Date, d: Date) defeasible {
    label en official "an election first made in y0 is effective in every later year y unless revoked with the Secretary's consent in between (section 456(c)(4))";
    when prepaid_dues_election_in_effect_456(p, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d0 < d;
    when us.irc.core::year_of(p, y);
    when not_known(election_456_revoked_between(p, y0, y));
    then election_456_applies_in_year(p, y);
}
rule Election456AppliesInElectionYear(p: Person, y: TaxableYear) defeasible {
    label en official "the election is effective for the year with respect to which it is first made (section 456(c)(4))";
    when prepaid_dues_election_in_effect_456(p, y);
    then election_456_applies_in_year(p, y);
}
rule PrepaidDuesIncludedInContinuedElectionYears(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "under the continued election, dues income is included year by year while the liability exists (section 456(a), (c)(4))";
    when election_456_applies_in_year(p, y);
    when dues_portion_for_year_456(p, y, item, amount);
    then prepaid_dues_income_included_456a(p, y, item, amount);
}
pub relation secretary_consents_to_revocation_458(p: Person, y: TaxableYear, c: ReturnableMerchandise) kind empirical {
    label en official "the Secretary consents to revocation of the section 458 election for the category, effective for the taxable year (section 458(c)(3))";
}
pub relation election_458_applies_in_year(p: Person, y: TaxableYear, c: ReturnableMerchandise) kind institutional {
    label en official "the section 458 election applies in the taxable year for the category: in effect for it, or carried by the date-keyed continuation (section 458(c)(3))";
}
pub relation election_458_revoked_between(p: Person, y0: TaxableYear, y: TaxableYear, c: ReturnableMerchandise) kind institutional {
    label en official "the Secretary consented to revocation in a year after the election year y0 and not after y (section 458(c)(3))";
}
rule Election458RevokedBetweenYears(p: Person, y0: TaxableYear, y: TaxableYear, yr: TaxableYear, c: ReturnableMerchandise, d0: Date, dr: Date, d: Date) defeasible {
    label en official "a consent to revocation between the election year and the year tested ends the continuation";
    when returns_exclusion_election_in_effect_458(p, y0, c);
    when us.irc.core::begins(y0, d0);
    when secretary_consents_to_revocation_458(p, yr, c);
    when us.irc.core::begins(yr, dr);
    when us.irc.core::begins(y, d);
    when d0 < dr;
    when dr <= d;
    then election_458_revoked_between(p, y0, y, c);
}
@source(IRC_S458_C, quote = "An election under this section shall be effective for the taxable year for which it is made and for all subsequent taxable years")
rule Election458ContinuesByDate(p: Person, y0: TaxableYear, y: TaxableYear, c: ReturnableMerchandise, d0: Date, d: Date) defeasible {
    label en official "an election made in y0 is effective for the category in every later year y unless revoked with the Secretary's consent in between (section 458(c)(3))";
    when returns_exclusion_election_in_effect_458(p, y0, c);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d0 < d;
    when us.irc.core::year_of(p, y);
    when not_known(election_458_revoked_between(p, y0, y, c));
    then election_458_applies_in_year(p, y, c);
}
rule Election458AppliesInElectionYear(p: Person, y: TaxableYear, c: ReturnableMerchandise) defeasible {
    label en official "the election is effective for the year for which it is made (section 458(c)(3))";
    when returns_exclusion_election_in_effect_458(p, y, c);
    then election_458_applies_in_year(p, y, c);
}
rule AmountExcludedInContinuedElectionYears(p: Person, y: TaxableYear, sale: Integer, c: ReturnableMerchandise, obligated: Money, adjusted: Money) defeasible {
    label en official "under the continued election, exclusion = min(obligation amount, agreed adjustment) (section 458(b)(6), (c)(3))";
    when is_qualified_sale_458b5(p, sale);
    when sale_category_458(sale, c);
    when election_458_applies_in_year(p, y, c);
    when legal_obligation_to_adjust_price_amount(p, sale, obligated);
    when price_adjusted_because_not_resold(p, sale, adjusted);
    then amount_excluded_458b6(p, y, sale, min(obligated, adjusted));
}
pub relation simplified_lifo_revoked_between_474(p: Person, y0: TaxableYear, y: TaxableYear) kind institutional {
    label en official "the Secretary consented to revocation in a year after the election year y0 and not after y (section 474(d)(2)(B))";
}
rule SimplifiedLifoRevokedBetweenYears(p: Person, y0: TaxableYear, y: TaxableYear, yr: TaxableYear, d0: Date, dr: Date, d: Date) defeasible {
    label en official "a consent to revocation between the election year and the year tested ends the continuation";
    when simplified_dollar_value_lifo_election_in_effect_474(p, y0);
    when us.irc.core::begins(y0, d0);
    when secretary_consents_to_revocation_474(p, yr);
    when us.irc.core::begins(yr, dr);
    when us.irc.core::begins(y, d);
    when d0 < dr;
    when dr <= d;
    then simplified_lifo_revoked_between_474(p, y0, y);
}
@source(IRC_S474_D, quote = "(ii) to all subsequent taxable years for which the taxpayer is an eligible small business,")
rule SimplifiedLifoContinuesByDate(p: Person, y0: TaxableYear, y: TaxableYear, d0: Date, d: Date) defeasible {
    label en official "the section 474 election applies to every later year in which the taxpayer is an eligible small business, unless revoked with consent in between (section 474(d)(2)(B)); replaces the one-step chain";
    when simplified_dollar_value_lifo_election_in_effect_474(p, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d0 < d;
    when is_eligible_small_business_474(p, y);
    when not_known(simplified_lifo_revoked_between_474(p, y0, y));
    then simplified_lifo_applies_in_later_year_474d2B(p, y);
}
