// Section 465 — Deductions limited to amount at risk. Stage 1b (IRC-07),
// priority section. Scope: (a) the amount-at-risk limitation and the
// succeeding-year carryover; (b)(1)-(2) the amount considered at risk
// (contributions, at-risk borrowed amounts); (e) recapture when the amount
// at risk falls below zero. (b)(3)-(6) (related-person borrowing, qualified
// nonrecourse financing), (c) the activities list, (d) definitions are NOT
// DONE this round.
//
// SIMPLIFICATION: the (b)(5) year-to-year reduction of the at-risk amount by
// prior losses allowed is a RUNNING LEDGER across a taxpayer's full history
// with an activity; this stage does not build that ledger (the shape is the
// same self-referential-accumulation gap as TECH-GAPS G1/G10). Each
// taxable year's `amount_at_risk_at_close` is a case-asserted fact (the case
// supplies the already-reduced figure for a later year), and a two-year
// carryover scenario links year 1's disallowed loss to year 2's activity
// loss by assertion, not by a computed ledger.

use self::{
    IRC_S465_A,
    IRC_S465_B,
    IRC_S465_E,
    Person,
    TaxableYear,
    loss_exempt_from_465a_by_c4_or_c7,
    loss_for_465,
    section_465_applies_to_activity,
};

pub relation activity_subject_to_465(p: Person, activity: Integer) kind empirical {
    label en official "the activity is one to which section 465 applies (section 465(c) classification, case-asserted this round)";
}
pub relation loss_from_activity_465(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind empirical {
    label en official "the taxpayer's loss from the activity for the taxable year, before the section 465(a) limitation";
}
pub relation amount_contributed_to_activity(p: Person, activity: Integer, amount: Money) kind empirical {
    label en official "the amount of money and the adjusted basis of other property contributed by the taxpayer to the activity (section 465(b)(1)(A))";
}
pub relation amount_borrowed_at_risk_for_activity(p: Person, activity: Integer, amount: Money) kind empirical {
    label en official "amounts borrowed with respect to the activity for which the taxpayer is personally liable, or has pledged non-activity property as security (section 465(b)(1)(B), (b)(2)) — the (b)(3) related-person exclusion and (b)(6) qualified nonrecourse financing are not separately tested this round";
}
pub relation amount_at_risk_at_close(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "the aggregate amount with respect to which the taxpayer is at risk for the activity at the close of the taxable year (section 465(a)(1), (b))";
}
pub relation computing_amount_at_risk_for_year(p: Person, y: TaxableYear, activity: Integer) kind empirical {
    label en official "the taxable year for which the amount at risk in the activity is being computed (case-asserted, ties the year-independent contribution/borrowing facts to a specific year)";
}
@source(IRC_S465_B, quote = "a taxpayer shall be considered at risk for an activity with respect to amounts including")
rule AmountAtRiskFromContributionsAndBorrowing(p: Person, y: TaxableYear, activity: Integer, contributed: Money, borrowed: Money) strict {
    label en official "the amount at risk is the sum of amounts contributed and at-risk borrowed amounts (section 465(b)(1)) — SIMPLIFICATION: does not subtract prior-year (b)(5) reductions, which are taken as already reflected in the asserted contributed/borrowed figures for a later year";
    when computing_amount_at_risk_for_year(p, y, activity);
    when amount_contributed_to_activity(p, activity, contributed);
    when amount_borrowed_at_risk_for_activity(p, activity, borrowed);
    then amount_at_risk_at_close(p, y, activity, contributed + borrowed);
}

pub relation at_risk_loss_allowed(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "the loss from the activity allowed for the taxable year, limited to the amount at risk at the close of the year (section 465(a)(1))";
}
@source(IRC_S465_A, quote = "any loss from such activity for the taxable year shall be allowed only to the extent of the aggregate amount with respect to which the taxpayer is at risk")
rule AtRiskLossAllowedLimitedToAmountAtRisk(p: Person, y: TaxableYear, activity: Integer, loss: Money, at_risk: Money) defeasible {
    label en official "the loss from an at-risk activity is allowed only up to the amount at risk at the close of the year (section 465(a)(1)); losses exempted by (c)(4)/(c)(7) are outside this limit";
    when section_465_applies_to_activity(p, activity);
    when loss_for_465(p, y, activity, loss);
    when amount_at_risk_at_close(p, y, activity, at_risk);
    when at_risk >= 0.00 USD;
    when not_known(loss_exempt_from_465a_by_c4_or_c7(p, y, activity));
    then at_risk_loss_allowed(p, y, activity, min(loss, at_risk));
}
rule AtRiskExemptActivityLossAllowedInFull(p: Person, y: TaxableYear, activity: Integer, loss: Money) defeasible {
    label en official "section 465(a) does not apply to losses of an equipment-leasing activity of a closely held C corporation or a qualifying business of a qualified C corporation, so the loss is not limited (section 465(c)(4)(A)(ii), (c)(7)(A)(ii))";
    when loss_exempt_from_465a_by_c4_or_c7(p, y, activity);
    when loss_for_465(p, y, activity, loss);
    then at_risk_loss_allowed(p, y, activity, loss);
}
pub relation at_risk_loss_carryover_to_next_year(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "the portion of the loss not allowed under (a)(1), treated as a deduction allocable to the activity in the first succeeding taxable year (section 465(a)(2))";
}
@source(IRC_S465_A, quote = "Any loss from an activity to which this section applies not allowed under this section for the taxable year shall be treated as a deduction allocable to such activity in the first succeeding taxable year.")
rule AtRiskLossCarryoverComputation(p: Person, y: TaxableYear, activity: Integer, loss: Money, allowed: Money) defeasible {
    label en official "the disallowed portion of the loss (loss minus the amount allowed) carries over to the next taxable year (section 465(a)(2))";
    when loss_for_465(p, y, activity, loss);
    when at_risk_loss_allowed(p, y, activity, allowed);
    when loss > allowed;
    then at_risk_loss_carryover_to_next_year(p, y, activity, round(loss - allowed, 2, "HALF_UP"));
}

// --- (e): recapture when the amount at risk is less than zero ---

pub relation aggregate_prior_reductions_465b5(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount of the section 465(b)(5) reductions for the activity by reason of losses for all prior taxable years beginning after December 31, 1978 (section 465(e)(2)(A))";
}
pub relation amounts_previously_included_under_465e(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind empirical {
    label en official "amounts previously included in gross income with respect to the activity under section 465(e) (section 465(e)(2)(B))";
}
pub relation at_risk_recapture_income(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "the amount included in gross income for the year as income from the activity, when zero exceeds the amount at risk, limited by (e)(2) (section 465(e)(1)(A))";
}
@source(IRC_S465_E, quote = "If zero exceeds the amount for which the taxpayer is at risk in any activity at the close of any taxable year")
rule AtRiskRecaptureIncome(p: Person, y: TaxableYear, activity: Integer, at_risk: Money, prior_reductions: Money, previously_included: Money) strict {
    label en official "when the amount at risk is negative, the taxpayer includes the excess (over zero) in gross income, capped by prior (b)(5) reductions less amounts already included (section 465(e)(1)-(2))";
    when amount_at_risk_at_close(p, y, activity, at_risk);
    when at_risk < 0.00 USD;
    when aggregate_prior_reductions_465b5(p, y, activity, prior_reductions);
    when amounts_previously_included_under_465e(p, y, activity, previously_included);
    then at_risk_recapture_income(p, y, activity, min(0.00 USD - at_risk, max(0.00 USD, prior_reductions - previously_included)));
}
pub relation at_risk_recapture_deduction_next_year(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "an amount equal to the recapture income is treated as a deduction allocable to the activity for the first succeeding taxable year (section 465(e)(1)(B))";
}
@source(IRC_S465_E, quote = "an amount equal to the amount so included in gross income shall be treated as a deduction allocable to such activity for the first succeeding taxable year")
rule AtRiskRecaptureDeductionNextYear(p: Person, y: TaxableYear, activity: Integer, amount: Money) strict {
    label en official "the recapture income becomes a deduction for the following year (section 465(e)(1)(B))";
    when at_risk_recapture_income(p, y, activity, amount);
    then at_risk_recapture_deduction_next_year(p, y, activity, amount);
}
