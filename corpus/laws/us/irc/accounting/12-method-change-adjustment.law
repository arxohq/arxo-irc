// Section 481 — Adjustments required by changes in method of accounting.
// Stage 1b (IRC-07), priority section. Scope: (a) the trigger condition (a
// change of method requiring an adjustment to prevent duplication/omission)
// and the taxpayer-initiated-change carve-out; (b)(1) the eligibility test
// for the 3-year-allocation tax limitation (the $3,000 threshold and the
// 2-preceding-year condition). The ADJUSTMENT AMOUNT itself (a)(2) and the
// actual capped-tax computation of (b)(1)-(2) are EXTERNAL_DEPENDENCY: both
// require the rate-schedule "tax attributable to an increase in taxable
// income" computation this package does not own (same dependency as
// section 443(b)(1)/section 453(c)'s "tax computed" relations), compounded
// with the specific substantive provision that produced the change (e.g. an
// inventory-method change under section 471/472, a cash-to-accrual change
// under section 448) — genuinely case-specific, not a value this package can
// derive. (c) regulatory timing elections, (d) S-to-C-corporation conversion
// spread are NOT DONE this round.

use self::{
    IRC_S481_A,
    IRC_S481_B,
    Person,
    TaxableYear,
};

pub relation changes_method_of_accounting_481(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's taxable income for the year (the 'year of the change') is computed under a method of accounting different from the method used for the preceding taxable year (section 481(a)(1))";
}
pub relation change_initiated_by_taxpayer_481(p: Person, y: TaxableYear) kind empirical {
    label en official "the change in method of accounting was initiated by the taxpayer (section 481(a)(2), proviso for years to which this section otherwise does not apply)";
}
pub relation section_481_adjustment_required(p: Person, y: TaxableYear) kind institutional {
    label en official "an adjustment under section 481(a)(2) is required for the year of the change, to prevent amounts from being duplicated or omitted";
}
@source(IRC_S481_A, quote = "there shall be taken into account those adjustments which are determined to be necessary solely by reason of the change in order to prevent amounts from being duplicated or omitted")
rule Section481AdjustmentRequiredOnMethodChange(p: Person, y: TaxableYear) strict {
    label en official "a change of accounting method requires a section 481(a)(2) adjustment to prevent duplication or omission (section 481(a))";
    when changes_method_of_accounting_481(p, y);
    then section_481_adjustment_required(p, y);
}
pub relation section_481a_adjustment_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the section 481(a)(2) adjustment (EXTERNAL_DEPENDENCY: depends on the specific substantive provision generating the change; not computed by this package — see accounting.deps.json)";
}

// --- (b)(1): eligibility for the 3-year-allocation tax limitation ---

pub relation same_method_for_2_preceding_years(p: Person, y: TaxableYear) kind empirical {
    label en official "the method of accounting from which the change is made was used by the taxpayer in computing taxable income for the 2 taxable years preceding the year of the change (section 481(b)(1)(A))";
}
pub relation section_481b_three_year_allocation_eligible(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 481(b)(1) three-year-allocation tax limitation is available for the year of the change (eligibility only; the actual capped amount is EXTERNAL_DEPENDENCY)";
}
@source(IRC_S481_B, quote = "the method of accounting from which the change is made was used by the taxpayer in computing his taxable income for the 2 taxable years preceding the year of the change")
rule Section481bThreeYearAllocationEligibility(p: Person, y: TaxableYear, adjustment: Money) strict {
    label en official "the three-year-allocation limitation is available when the prior method was used for the 2 preceding years and the resulting increase in taxable income exceeds $3,000 (section 481(b)(1))";
    when same_method_for_2_preceding_years(p, y);
    when section_481a_adjustment_amount(p, y, adjustment);
    when adjustment > Section481SubstantialAdjustmentThreshold;
    then section_481b_three_year_allocation_eligible(p, y);
}
pub relation section_481b_tax_limitation(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax attributable to the section 481(a)(2) increase, capped at the aggregate increase in tax that would result from spreading one-third of the increase to the year of the change and one-third to each of the 2 preceding years (section 481(b)(1)) — EXTERNAL_DEPENDENCY: needs the rate-schedule 'tax attributable to an increase in taxable income' computation for three different taxable years, not owned by this package";
}

// (a)(1)/(2)'s taxpayer-initiated-change proviso, (b)(2)-(3) the new-method
// allocation and special computation rules, (c) regulatory timing elections,
// (d) S-to-C-corporation eligible-terminated-S-corporation spread are NOT
// DONE this round.
