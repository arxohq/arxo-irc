    when not_known(holder_has_own_business_deductions(p, y));
    then business_deductions_with_entity_shares(p, y, sum(collect all b: Money, e2: Person where holder_share_of_entity_business_deductions_461l4B(p, y, e2, b), empty: 0 USD));
}
relation holder_has_entity_share_business_income(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: the holder has a share of an entity's business income or gain taken into account in the year";
}
rule HolderHasEntityShareBusinessIncome(p: Person, y: TaxableYear, e: Person, a: Money) defeasible {
