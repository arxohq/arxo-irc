// Stage 4 (DECISION-0379 with deontics), accounting, module 58: the holder's aggregates of section 461(j)
// and 461(l) INCLUDING the shares of the items of partnerships and S corporations taken into account under
// section 461(j)(5)(B) and 461(l)(4)(B) (module 55 computes the shares). The excess farm loss rule (module
// 25) and the excess business loss rules (modules 07, 25, 55) read these relations instead of the asserted
// aggregates: asserted own items PLUS the shares (a case asserts the holder's OWN items only, not those
// received through an entity: never both), the asserted amount alone when there are no shares, the shares
// alone when nothing is asserted. The sum over the entities is taken over a derived relation, so the rules
// are defeasible.

use self::{
    IRC_S461_J,
    IRC_S461_L,
    Person,
    TaxableYear,
    aggregate_business_deductions_461l,
    aggregate_business_income_or_gain_461l,
    aggregate_farm_deductions_461j,
    aggregate_farm_gross_income_461j,
    holder_share_of_entity_business_deductions_461l4B,
    holder_share_of_entity_business_income_461l4B,
    holder_share_of_entity_farm_deductions_461j5B,
    holder_share_of_entity_farm_income_461j5B,
};

relation holder_has_entity_share_farm_deductions(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: the holder has a share of an entity's farm deductions taken into account in the year";
}
rule HolderHasEntityShareFarmDeductions(p: Person, y: TaxableYear, e: Person, a: Money) defeasible {
    label en official "bridge for the absence test";
    when holder_share_of_entity_farm_deductions_461j5B(p, y, e, a);
    then holder_has_entity_share_farm_deductions(p, y);
}
relation holder_has_own_farm_deductions(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: the holder's own farm deductions are asserted for the year";
}
rule HolderHasOwnFarmDeductions(p: Person, y: TaxableYear, a: Money) defeasible {
    label en official "bridge for the absence test";
    when aggregate_farm_deductions_461j(p, y, a);
    then holder_has_own_farm_deductions(p, y);
}
pub relation farm_deductions_with_entity_shares(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the holder's farm deductions for the year: its own items plus its shares of the items of partnerships and S corporations, taken into account in the holder's year (461(j)(5)(B))";
}
@source(IRC_S461_J, quote = "shall be taken into account by the partner or shareholder in applying this subsection")
rule FarmDeductionsOwnPlusShares(p: Person, y: TaxableYear, own: Money) defeasible {
    label en official "own items + the shares of the entities (461(j)(5)(B))";
    when aggregate_farm_deductions_461j(p, y, own);
    when holder_has_entity_share_farm_deductions(p, y);
    then farm_deductions_with_entity_shares(p, y, own + sum(collect all a: Money, e: Person where holder_share_of_entity_farm_deductions_461j5B(p, y, e, a), empty: 0 USD));
}
rule FarmDeductionsOwnOnly(p: Person, y: TaxableYear, own: Money) defeasible {
    label en official "no entity share: the asserted items stand";
    when aggregate_farm_deductions_461j(p, y, own);
    when not_known(holder_has_entity_share_farm_deductions(p, y));
    then farm_deductions_with_entity_shares(p, y, own);
}
rule FarmDeductionsSharesOnly(p: Person, y: TaxableYear, e: Person, a: Money) defeasible {
    label en official "only entity shares: their sum";
    when holder_share_of_entity_farm_deductions_461j5B(p, y, e, a);
    when not_known(holder_has_own_farm_deductions(p, y));
    then farm_deductions_with_entity_shares(p, y, sum(collect all b: Money, e2: Person where holder_share_of_entity_farm_deductions_461j5B(p, y, e2, b), empty: 0 USD));
}
relation holder_has_entity_share_farm_income(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: the holder has a share of an entity's farm gross income taken into account in the year";
}
rule HolderHasEntityShareFarmIncome(p: Person, y: TaxableYear, e: Person, a: Money) defeasible {
    label en official "bridge for the absence test";
    when holder_share_of_entity_farm_income_461j5B(p, y, e, a);
    then holder_has_entity_share_farm_income(p, y);
}
relation holder_has_own_farm_income(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge: the holder's own farm gross income are asserted for the year";
}
rule HolderHasOwnFarmIncome(p: Person, y: TaxableYear, a: Money) defeasible {
    label en official "bridge for the absence test";
    when aggregate_farm_gross_income_461j(p, y, a);
    then holder_has_own_farm_income(p, y);
}
pub relation farm_income_with_entity_shares(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the holder's farm gross income for the year: its own items plus its shares of the items of partnerships and S corporations, taken into account in the holder's year (461(j)(5)(B))";
}
@source(IRC_S461_J, quote = "shall be taken into account by the partner or shareholder in applying this subsection")
rule FarmIncomeOwnPlusShares(p: Person, y: TaxableYear, own: Money) defeasible {
    label en official "own items + the shares of the entities (461(j)(5)(B))";
    when aggregate_farm_gross_income_461j(p, y, own);
    when holder_has_entity_share_farm_income(p, y);
    then farm_income_with_entity_shares(p, y, own + sum(collect all a: Money, e: Person where holder_share_of_entity_farm_income_461j5B(p, y, e, a), empty: 0 USD));
}
rule FarmIncomeOwnOnly(p: Person, y: TaxableYear, own: Money) defeasible {
    label en official "no entity share: the asserted items stand";
    when aggregate_farm_gross_income_461j(p, y, own);
    when not_known(holder_has_entity_share_farm_income(p, y));
    then farm_income_with_entity_shares(p, y, own);
}
rule FarmIncomeSharesOnly(p: Person, y: TaxableYear, e: Person, a: Money) defeasible {
    label en official "only entity shares: their sum";
    when holder_share_of_entity_farm_income_461j5B(p, y, e, a);
    when not_known(holder_has_own_farm_income(p, y));
    then farm_income_with_entity_shares(p, y, sum(collect all b: Money, e2: Person where holder_share_of_entity_farm_income_461j5B(p, y, e2, b), empty: 0 USD));
}
