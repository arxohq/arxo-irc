// Sections 611, 612, 613, 613A — Depletion. Stage 2 (IRC-07), priority
// scope for this round: 613(a)-(b) (percentage depletion, the rate table as
// a `.lawtable.json`) and 613A(c)-(d) (independent-producer/royalty-owner
// exemption core and its taxable-income and retailer limits). 611(a) and 612
// are modelled only to the extent needed to publish `depletion_deduction`
// (611(a)'s own "not less than [percentage depletion]" floor over a
// case-asserted cost-depletion amount — the units-of-production cost
// formula itself is NOT modelled, TECH-GAPS G320). 611(b) (lease/life-tenant/
// trust/estate apportionment) and 611(c) (cross-reference) are NOT DONE.
// 613(c) (gross income from the asset / "mining" / treatment-process
// definitions) is read as a case-asserted fact this stage (TECH-GAPS G321).
// 613(e) (geothermal) is modelled as a bridge onto the same rate mechanism.
// 613A(a)-(b) (denial of straight percentage depletion for oil/gas; the
// regulated-gas/fixed-contract/geopressured-brine exemptions) and 613A(c)(5)-
// (11) (marginal-production variable rate, partnerships, S corporations) are
// NOT DONE — TECH-GAPS G322. §614 (aggregation elections), §616/§617 (mine
// development/exploration), §631/§636/§638 are in separate modules or not
// reached this round; see coverage/accounting.json and the coordinator
// report for the full disposition.

// --- 612: basis for cost depletion is the general section 1011 adjusted
// basis (us.irc.core::adjusted_basis is that basis's cross-package proxy;
// this package does not re-implement subchapter O). NON_NORMATIVE cross-
// reference, not a separate rule.

use self::{
    Asset,
    IRC_S613A_C,
    IRC_S613A_D,
    IRC_S613_A,
    IRC_S613_E,
    Person,
    TaxableYear,
    aggregate_production_for_c_excluding_b_gas_613Ac10,
    depletable_gas_cubic_foot_days_613Ac4,
    gas_of_asset_exempt_under_613Ab,
    marginal_property_613Ac6D,
    oil_production_within_quantity_by_days_613Ac1A,
    refiner_excluded_from_613A_c_613Ad4,
};

// --- 611(a)/612: cost depletion, read as a case fact this stage. The
// "peculiar conditions in each case" units-of-production formula (estimated
// recoverable units, revised on re-estimate) is TECH_GAP G320 — a
// self-recursive ratable-unit ledger the compiler cannot express any better
// than the day-by-day ledgers flagged elsewhere in TECH-GAPS.md.
pub relation cost_depletion_allowance(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "TECH_GAP G320: the reasonable cost-depletion allowance under section 611(a)/612 (units-of-production over the section 1011 basis) — read as a case fact; the recoverable-units re-estimation ledger itself is not modelled";
}

// --- 613(c)(1): gross income from the asset. (c)(2)-(5) (the "mining" /
// "extraction" / treatment-process line, TECH_GAP G321) are the reasoning
// that WOULD derive this figure from raw sales and processing costs; absent
// that this stage, the figure itself is a case fact.
pub relation gross_income_from_the_property(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income from mining (or, for oil, gas, or geothermal properties, gross income from the asset under section 613A(d)(5)/613(e)(3)) (section 613(c)(1))";
}
pub relation rents_or_royalties_paid_re_property(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "rents or royalties paid or incurred by the taxpayer in respect of the asset, excluded from gross income from the asset for purposes of section 613(a)";
}
pub relation taxable_income_from_the_property_before_depletion(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's taxable income from the asset, computed without allowance for depletion and without any section 199A deduction (section 613(a) second sentence)";
}
pub relation is_oil_or_gas_property(p: Person, asset: Asset) kind empirical {
    label en official "the asset is an oil or gas asset for purposes of the 100-percent (rather than 50-percent) taxable-income limitation of section 613(a) and the section 613(d)/613A gate";
}

// --- 613(b): percentage depletion rate table, keyed by the mineral's
// statutory name (`Text`, same idiom as us.irc.excise-goods's
// chemical-tax-by-substance.lawtable.json). Every mineral named in
// paragraphs (b)(1)-(b)(6) is its own row at its paragraph's rate; the table
// has hitPolicy "first" and a FINAL catch-all row (rate 14 percent) that
// covers BOTH (b)(3)'s "metal mines (if paragraph (1)(B) or (2)(A) does not
// apply)" residual AND (b)(7)'s "all other minerals" residual — the two
// residual categories are functionally identical for the RATE computed
// (both 14 percent) even though they are legally distinct definitional
// categories; see 613-b-percentage-rates.lawtable.json's header comment.
// This ALSO implements, mechanically, every "if paragraph (1)(B) [or (2)(A),
// (5), (6)(B)] does not apply" priority clause for a mineral (bauxite,
// asbestos, clay, shale, mica, fluorspar) that is named in more than one
// paragraph: ordering the higher paragraph first and relying on "first hit
// wins" reproduces the statute's own priority. NOT modelled (INTERPRETATION,
// TECH-GAPS G321): the "if from deposits in the United States" gate on
// paragraphs (1)(B) and (2) (assumed satisfied — a domestic-deposit case is
// the ordinary case this stage), the (b)(7) rip-rap/ballast/road-material
// 5-percent carve-out (last sentence of (b)(7)), and the closed list nature
// of paragraph (7)'s OWN named examples (its text is expressly
// non-exhaustive, "including, but not limited to", so no additional named
// rows are needed there — the catch-all row already covers it).
pub relation mineral_name_of(asset: Asset, name: Text) kind empirical {
    label en official "the statutory name of the mine, well, or other natural deposit's mineral for purposes of the section 613(b) rate table";
}
pub relation percentage_depletion_rate_for_mineral(name: Text, rate: Decimal) kind institutional {
    label en official "the percentage specified in section 613(b) for the named mineral";
}

// --- 613(a): the percentage-depletion computation itself, with the
// intermediate "tentative amount" value so a scenario can assert it
// independently of the final capped figure.
pub relation percentage_depletion_tentative_amount(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the rate specified in subsection (b), applied to the gross income from the asset excluding rents or royalties paid or incurred (section 613(a) first sentence, before the taxable-income limitation)";
}
@source(IRC_S613_A, quote = "the allowance for depletion under section 611 shall be the percentage, specified in subsection (b), of the gross income from the property excluding from such gross income an amount equal to any rents or royalties paid or incurred by the taxpayer in respect of the property")
rule PercentageDepletionTentativeAmount(p: Person, asset: Asset, y: TaxableYear, gross: Money, rents: Money, rate: Decimal) defeasible {
    label en official "the tentative percentage-depletion amount is the applicable rate times (gross income from the asset minus rents or royalties paid) (section 613(a))";
    when gross_income_from_the_property(p, asset, y, gross);
    when rents_or_royalties_paid_re_property(p, asset, y, rents);
    when mineral_name_of(asset, _) and mineral_rate_applies(asset, rate);
    then percentage_depletion_tentative_amount(p, asset, y, round((gross - rents) * rate, 2, "HALF_UP"));
}
relation mineral_rate_applies(asset: Asset, rate: Decimal) kind institutional {
    label en unofficial "bridge: the section 613(b) rate table's output, joined back onto the asset by its mineral name";
}
rule MineralRateAppliesBridge(asset: Asset, name: Text, rate: Decimal) strict {
    label en unofficial "joins percentage_depletion_rate_for_mineral back onto the asset";
    when mineral_name_of(asset, name);
    when percentage_depletion_rate_for_mineral(name, rate);
    then mineral_rate_applies(asset, rate);
}

// The section 613(a) taxable-income limitation: 50 percent generally, 100
// percent for oil and gas properties. The reduction for section 1245
// ordinary-income gain "properly allocable to the asset" (third
// sentence) is NOT modelled (TECH_GAP G321 — it requires the section 1245
// recapture computation of us.irc.asset-transactions as an input this
// stage does not wire in).
pub relation percentage_depletion_taxable_income_limit(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "50 percent (100 percent for oil and gas properties) of the taxpayer's taxable income from the asset, computed without allowance for depletion (section 613(a) second sentence)";
}
@source(IRC_S613_A, quote = "Such allowance shall not exceed 50 percent (100 percent in the case of oil and gas properties) of the taxpayer's taxable income from the property")
rule PercentageDepletionLimitOilAndGas(p: Person, asset: Asset, y: TaxableYear, income: Money) strict {
    label en official "the 613(a) limitation is 100 percent of taxable income from the asset for oil and gas properties";
    when taxable_income_from_the_property_before_depletion(p, asset, y, income);
    when is_oil_or_gas_property(p, asset);
    then percentage_depletion_taxable_income_limit(p, asset, y, round(1.00 * income, 2, "HALF_UP"));
}
@source(IRC_S613_A, quote = "Such allowance shall not exceed 50 percent (100 percent in the case of oil and gas properties) of the taxpayer's taxable income from the property")
rule PercentageDepletionLimitOther(p: Person, asset: Asset, y: TaxableYear, income: Money) defeasible {
    label en official "the 613(a) limitation is 50 percent of taxable income from the asset for other properties";
    when taxable_income_from_the_property_before_depletion(p, asset, y, income) and not_known(is_oil_or_gas_property(p, asset));
    then percentage_depletion_taxable_income_limit(p, asset, y, round(0.50 * income, 2, "HALF_UP"));
}
pub relation percentage_depletion_allowance(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the allowance for depletion under section 613 for the asset and taxable year, after the taxable-income limitation of section 613(a)";
}
@source(IRC_S613_A, quote = "In no case shall the allowance for depletion under section 611 be less than it would be if computed without reference to this section.")
rule PercentageDepletionAllowanceWithinLimit(p: Person, asset: Asset, y: TaxableYear, tentative: Money, limit: Money) defeasible {
    label en official "the percentage-depletion allowance is the tentative amount when it does not exceed the taxable-income limitation (section 613(a))";
    when percentage_depletion_tentative_amount(p, asset, y, tentative);
    when percentage_depletion_taxable_income_limit(p, asset, y, limit);
    when tentative <= limit;
    then percentage_depletion_allowance(p, asset, y, tentative);
}
rule PercentageDepletionAllowanceCapped(p: Person, asset: Asset, y: TaxableYear, tentative: Money, limit: Money) defeasible {
    label en official "the percentage-depletion allowance is capped at the taxable-income limitation when the tentative amount exceeds it (section 613(a))";
    when percentage_depletion_tentative_amount(p, asset, y, tentative);
    when percentage_depletion_taxable_income_limit(p, asset, y, limit);
    when tentative > limit;
    then percentage_depletion_allowance(p, asset, y, limit);
}

// 613(e): geothermal deposits are bridged onto the same (b) mechanism at 15
// percent — modelled as a fixed rate rather than routing through the
// mineral-name table, since a geothermal deposit is not a "mineral" the (b)
// table names.
pub relation is_geothermal_deposit(p: Person, asset: Asset) kind empirical {
    label en official "the asset is a geothermal deposit located in the United States or a U.S. possession (section 613(e)(2))";
}
@source(IRC_S613_E, quote = "such deposits shall be treated as listed in subsection (b), and")
rule GeothermalDepositRateIsFifteenPercent(p: Person, asset: Asset) strict {
    label en official "a geothermal deposit's rate under subsection (a) is deemed to be 15 percent (section 613(e)(1))";
    when is_geothermal_deposit(p, asset);
    then mineral_rate_applies(asset, 0.15);
}

// --- 611(a)/612 final sentence: the allowance actually allowed is never
// LESS than cost depletion (computed without reference to section 613).
// `depletion_deduction` is the package's published depletion figure.
pub relation depletion_deduction(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the depletion deduction allowed under section 611: the greater of the percentage-depletion allowance (section 613) or the cost-depletion allowance (section 611(a) last sentence: 'In no case shall the allowance for depletion under section 611 be less than it would be if computed without reference to [section 613].')";
}
@source(IRC_S613_A, quote = "In no case shall the allowance for depletion under section 611 be less than it would be if computed without reference to this section.")
rule DepletionDeductionIsPercentageWhenGreater(p: Person, asset: Asset, y: TaxableYear, pct: Money, cost: Money) defeasible {
    label en official "the depletion deduction is the percentage-depletion allowance when it is at least the cost-depletion allowance (section 611(a) last sentence)";
    when percentage_depletion_allowance(p, asset, y, pct);
    when cost_depletion_allowance(p, asset, y, cost);
    when pct >= cost;
    then depletion_deduction(p, asset, y, pct);
}
rule DepletionDeductionIsCostWhenGreater(p: Person, asset: Asset, y: TaxableYear, pct: Money, cost: Money) defeasible {
    label en official "the depletion deduction is the cost-depletion allowance when it exceeds the percentage-depletion allowance (section 611(a) last sentence)";
    when percentage_depletion_allowance(p, asset, y, pct);
    when cost_depletion_allowance(p, asset, y, cost);
    when cost > pct;
    then depletion_deduction(p, asset, y, cost);
}
relation has_percentage_depletion_allowance(p: Person, asset: Asset, y: TaxableYear) kind institutional {
    label en unofficial "bridge: some percentage-depletion allowance amount has been computed for the asset and year";
}
rule HasPercentageDepletionAllowanceBridge(p: Person, asset: Asset, y: TaxableYear, amount: Money) defeasible {
    label en unofficial "bridge rule for has_percentage_depletion_allowance";
    when percentage_depletion_allowance(p, asset, y, amount);
    then has_percentage_depletion_allowance(p, asset, y);
}
rule DepletionDeductionCostOnlyForNonPercentageProperty(p: Person, asset: Asset, y: TaxableYear, cost: Money) defeasible {
    label en official "where no percentage-depletion allowance is computed for the asset (e.g. denied under section 613(d) with no 613A exemption), the deduction is the cost-depletion allowance alone (section 611(a))";
    when cost_depletion_allowance(p, asset, y, cost) and not_known(has_percentage_depletion_allowance(p, asset, y));
    then depletion_deduction(p, asset, y, cost);
}

// ============================================================================
// Section 613A — percentage depletion for oil and gas wells: the
// independent-producer/royalty-owner exemption, subsections (c)-(d).
// (a)-(b) (denial of straight percentage depletion; regulated-gas/fixed-
// contract/geopressured-brine exemptions) and (c)(5)-(11) (marginal
// production's variable rate, partnerships, S corporations) are NOT DONE
// this round (TECH-GAPS G322): every scenario below assumes the taxpayer is
// NOT within those un-modelled branches.
// ============================================================================

pub relation is_independent_producer_or_royalty_owner(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer is not disqualified from section 613A(c) by the retailer exclusion of (d)(2) or the refiner exclusion of (d)(4) (the (d)(4) 75,000-barrel refiner test itself is read as a case fact, not separately computed — TECH_GAP G322)";
}
pub relation average_daily_domestic_crude_oil_production(p: Person, y: TaxableYear, barrels: Decimal) kind empirical {
    label en official "the taxpayer's average daily production of domestic crude oil for the taxable year (section 613A(c)(2)(A))";
}
pub relation average_daily_domestic_natural_gas_production(p: Person, y: TaxableYear, cubic_feet: Decimal) kind empirical {
    label en official "the taxpayer's average daily production of domestic natural gas for the taxable year (section 613A(c)(2)(A))";
}
// (c)(3): depletable oil quantity. The (c)(3)(A)(ii) reduction for average
// daily MARGINAL production, and the (c)(6) marginal-production election
// with its own variable "applicable percentage", are NOT modelled
// (TECH_GAP G322) — the tentative 1,000-barrel quantity of (c)(3)(B) is used
// UNREDUCED.
pub relation depletable_oil_quantity(p: Person, y: TaxableYear, barrels: Decimal) kind institutional {
    label en official "the taxpayer's depletable oil quantity for the taxable year: 1,000 barrels, the (c)(3)(B) tentative quantity, unreduced by (c)(3)(A)(ii) marginal production (TECH_GAP G322)";
}
@source(IRC_S613A_C, quote = "For purposes of subparagraph (A), the tentative quantity is 1,000 barrels.")
rule DepletableOilQuantityIsTentativeQuantity(p: Person, y: TaxableYear) strict {
    label en official "the depletable oil quantity is the 1,000-barrel tentative quantity of section 613A(c)(3)(B) (marginal-production reduction not modelled)";
    when is_independent_producer_or_royalty_owner(p, y);
    then depletable_oil_quantity(p, y, 1000.0);
}
// (c)(4): the depletable natural gas quantity is 6,000 cubic feet per
// barrel of depletable oil quantity the taxpayer elects to apply it to. The
// partial-election mechanic is simplified to "the taxpayer elects the full
// depletable oil quantity" (a documented judgment call — a taxpayer electing
// a SMALLER number of barrels for gas is not modelled, TECH_GAP G322).
pub relation depletable_natural_gas_quantity(p: Person, y: TaxableYear, cubic_feet: Decimal) kind institutional {
    label en official "the taxpayer's depletable natural gas quantity for the taxable year: 6,000 cubic feet times the depletable oil quantity elected (simplified to the full depletable oil quantity, section 613A(c)(4))";
}
@source(IRC_S613A_C, quote = "the depletable natural gas quantity of any taxpayer for any taxable year shall be equal to 6,000 cubic feet multiplied by the number of barrels of the taxpayer's depletable oil quantity to which the taxpayer elects to have this paragraph apply")
rule DepletableNaturalGasQuantity(p: Person, y: TaxableYear, oil_barrels: Decimal) strict {
    label en official "the depletable natural gas quantity is 6,000 cubic feet times the depletable oil quantity (section 613A(c)(4), full-election simplification)";
    when depletable_oil_quantity(p, y, oil_barrels);
    then depletable_natural_gas_quantity(p, y, 6000.0 * oil_barrels);
}
// (c)(1): within the quantity limits, 15 percent is deemed the section
// 613(b) rate. Production IN EXCESS of the quantity limit ((c)(7)'s
// allocation formula) is NOT modelled (TECH_GAP G322) — this stage only
// derives a rate when production is entirely within the depletable
// quantity.
pub relation oil_production_within_depletable_quantity(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's average daily domestic crude oil production does not exceed the depletable oil quantity (section 613A(c)(1)(A), (c)(7)(A) gate)";
}
rule OilProductionWithinDepletableQuantity(p: Person, y: TaxableYear, production: Decimal, quantity: Decimal) strict {
    label en unofficial "gate: crude oil production within the depletable quantity";
    when average_daily_domestic_crude_oil_production(p, y, production);
    when depletable_oil_quantity(p, y, quantity);
    when production <= quantity;
    then oil_production_within_depletable_quantity(p, y);
}
pub relation gas_production_within_depletable_quantity(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's average daily domestic natural gas production does not exceed the depletable natural gas quantity (section 613A(c)(1)(B), (c)(7)(B) gate)";
}
rule GasProductionWithinDepletableQuantity(p: Person, y: TaxableYear, production: Decimal, quantity: Decimal) strict {
    label en unofficial "gate: natural gas production within the depletable quantity";
    when average_daily_domestic_natural_gas_production(p, y, production);
    when depletable_natural_gas_quantity(p, y, quantity);
    when production <= quantity;
    then gas_production_within_depletable_quantity(p, y);
}
rule OilProductionWithinDepletableQuantityByDays(p: Person, y: TaxableYear) defeasible {
    label en unofficial "gate from the aggregate/days pipeline of module 36: crude oil production within the barrel-days quantity";
    when oil_production_within_quantity_by_days_613Ac1A(p, y);
    then oil_production_within_depletable_quantity(p, y);
}
rule GasProductionWithinDepletableQuantityByDays(p: Person, y: TaxableYear, aggregate: Decimal, quantity: Decimal) defeasible {
    label en unofficial "gate from the aggregate/days pipeline of module 36: natural gas production (without the (b) gas of (c)(10)) within the cubic-foot-days quantity";
    when aggregate_production_for_c_excluding_b_gas_613Ac10(p, y, aggregate);
    when depletable_gas_cubic_foot_days_613Ac4(p, y, quantity);
    when aggregate <= quantity;
    then gas_production_within_depletable_quantity(p, y);
}
@source(IRC_S613A_C, quote = "and 15 percent shall be deemed to be specified in subsection (b) of section 613 for purposes of subsection (a) of that section")
rule Section613ACExemptionRateForOil(p: Person, y: TaxableYear, asset: Asset) defeasible {
    label en official "the section 613(b) rate deemed for crude oil within the section 613A(c) exemption is 15 percent; a marginal property takes the (c)(6) applicable percentage instead, and a retailer or large refiner is excluded by (d)(2), (d)(4)";
    when is_independent_producer_or_royalty_owner(p, y);
    when oil_production_within_depletable_quantity(p, y);
    when is_oil_or_gas_property(p, asset);
    when not_known(marginal_property_613Ac6D(asset, y));
    when not_known(is_retailer_excluded_from_613a_c(p, y));
    when not_known(refiner_excluded_from_613A_c_613Ad4(p, y));
    then mineral_rate_applies(asset, 0.15);
}
@source(IRC_S613A_C, quote = "and 15 percent shall be deemed to be specified in subsection (b) of section 613 for purposes of subsection (a) of that section")
rule Section613ACExemptionRateForGas(p: Person, y: TaxableYear, asset: Asset) defeasible {
    label en official "the section 613(b) rate deemed for natural gas within the section 613A(c) exemption is 15 percent; gas exempt under (b) is not taken into account by (c) ((c)(10)), a marginal property takes the (c)(6) percentage, and a retailer or large refiner is excluded";
    when is_independent_producer_or_royalty_owner(p, y);
    when gas_production_within_depletable_quantity(p, y);
    when is_oil_or_gas_property(p, asset);
    when not_known(gas_of_asset_exempt_under_613Ab(asset));
    when not_known(marginal_property_613Ac6D(asset, y));
    when not_known(is_retailer_excluded_from_613a_c(p, y));
    when not_known(refiner_excluded_from_613A_c_613Ad4(p, y));
    then mineral_rate_applies(asset, 0.15);
}

// (d)(1): the 65-percent overall taxable-income limitation on the (c)
// exemption, IN ADDITION TO (a)'s own 100-percent asset-level limitation.
// The carryover of a disallowed amount to the following year (second
// sentence of (d)(1)) is NOT modelled (TECH_GAP G322).
pub relation taxable_income_for_613a_d_limit(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's taxable income for the year computed without the exclusions listed in section 613A(d)(1)(A)-(E) (read as a case fact; the exclusions themselves are not separately recomputed)";
}
pub relation section_613a_d_taxable_income_limit(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "65 percent of the taxpayer's taxable income for the year, computed as described in section 613A(d)(1)";
}
@source(IRC_S613A_D, quote = "The deduction for the taxable year attributable to the application of subsection (c) shall not exceed 65 percent of the taxpayer's taxable income for the year")
rule Section613ADTaxableIncomeLimit(p: Person, y: TaxableYear, income: Money) strict {
    label en official "the section 613A(d)(1) limitation is 65 percent of the taxpayer's taxable income for the year";
    when taxable_income_for_613a_d_limit(p, y, income);
    then section_613a_d_taxable_income_limit(p, y, round(0.65 * income, 2, "HALF_UP"));
}

// (d)(2): the retailer exclusion, with its $5,000,000 combined-gross-
// receipts safe harbor.
pub relation sells_oil_or_gas_through_controlled_retail_outlet_or_trademark_arrangement(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer (directly or through a related person) sells oil, natural gas, or a derivative product through a retail outlet it operates or controls, or under a trademark/trade-name arrangement described in section 613A(d)(2)(B)";
}
pub relation combined_retail_gross_receipts(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the combined gross receipts from the sale of oil, natural gas, or derivative products, for the taxable year, of all retail outlets taken into account under section 613A(d)(2) (second sentence)";
}
pub relation is_retailer_excluded_from_613a_c(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer is excluded from the section 613A(c) exemption under the section 613A(d)(2) retailer rule";
}
@source(IRC_S613A_D, quote = "Subsection (c) shall not apply in the case of any taxpayer who directly, or through a related person, sells oil or natural gas")
rule Section613ADRetailerExclusion(p: Person, y: TaxableYear, receipts: Money) defeasible {
    label en official "a taxpayer selling oil or natural gas through a controlled retail outlet or trademark arrangement is excluded from the section 613A(c) exemption, unless the $5,000,000 combined-gross-receipts safe harbor of section 613A(d)(2) applies";
    when sells_oil_or_gas_through_controlled_retail_outlet_or_trademark_arrangement(p, y);
    unless combined_retail_gross_receipts_within_safe_harbor(p, y, receipts);
    then is_retailer_excluded_from_613a_c(p, y);
}
relation combined_retail_gross_receipts_within_safe_harbor(p: Person, y: TaxableYear, receipts: Money) kind institutional {
    label en unofficial "bridge: combined retail gross receipts do not exceed $5,000,000 (section 613A(d)(2) second sentence)";
}
rule CombinedRetailGrossReceiptsWithinSafeHarbor(p: Person, y: TaxableYear, receipts: Money) strict {
    label en unofficial "bridge rule for the section 613A(d)(2) $5,000,000 safe harbor";
    when combined_retail_gross_receipts(p, y, receipts);
    when receipts <= 5000000.00 USD;
    then combined_retail_gross_receipts_within_safe_harbor(p, y, receipts);
}
