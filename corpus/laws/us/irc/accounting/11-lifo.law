// Section 472 — Last-in, first-out inventories. Stage 1b (IRC-07), priority
// section. Scope: (a) the LIFO election as a power; (b) the LIFO method
// itself (order-of-acquisition/cost/average-cost rules), modelled as a
// classification of the election's effect; (c) the conformity requirement
// as the power's validity condition; (e) the requirement to continue using
// LIFO in subsequent years absent an authorized change. (d) 3-year
// averaging, (f) government price indexes, (g) controlled-group conformity
// are NOT DONE this round.

use self::{
    IRC_S472_A,
    IRC_S472_B,
    IRC_S472_E,
    Person,
};

pub relation applies_to_expense_specified_goods(p: Person, application_id: Integer) kind empirical {
    label en official "the taxpayer files an application to inventory specified goods under the LIFO method (section 472(a))";
}
pub relation elects_lifo_method(p: Person, application_id: Integer) kind empirical {
    label en official "the taxpayer elects to use the method described in section 472(b) for the goods specified in its application (section 472(a))";
}
pub relation used_no_other_procedure_than_472b1_and_3(p: Person, application_id: Integer) kind empirical {
    label en official "the taxpayer has used no procedure other than that specified in section 472(b)(1) and (3) in inventorying the specified goods to ascertain income/profit/loss of the first taxable year for a report to shareholders/partners/beneficiaries or for credit purposes — the section 472(c) conformity condition";
}
pub relation lifo_method_in_effect(p: Person, application_id: Integer) kind institutional {
    label en official "the LIFO method of section 472(b) is in effect for the specified goods (section 472(a))";
}
@source(IRC_S472_A, quote = "A taxpayer may use the method provided in subsection (b)")
rule Section472LifoElectionPower(p: Person, application_id: Integer) strict {
    label en official "a taxpayer may elect the LIFO method for specified goods, valid only if the section 472(c) conformity condition is met (section 472(a), (c))";
    when applies_to_expense_specified_goods(p, application_id);
    then power Section472LifoElection {
        holder p;
        over application_id;
        exercise elects_lifo_method(p, application_id);
        valid_when used_no_other_procedure_than_472b1_and_3(p, application_id);
        effect create(lifo_method_in_effect(p, application_id));
        window [@1954-08-16, infinity);
    };
}

// (b): the LIFO method's own mechanics, modelled as classification facts
// that follow once the election is in effect (the actual per-item cost
// computation over acquisition layers is a TECH_GAP-style ledger this stage
// does not build — see the module note; the classification of WHICH
// ordering/costing rule applies is what is modelled).
pub relation lifo_treats_remaining_goods_as_opening_inventory_first(p: Person, application_id: Integer) kind institutional {
    label en official "goods remaining on hand at the close of the year are treated first as those in the opening inventory (in order of acquisition), then as those acquired during the year (section 472(b)(1))";
}
pub relation lifo_inventoried_at_cost(p: Person, application_id: Integer) kind institutional {
    label en official "goods are inventoried at cost under the LIFO method (section 472(b)(2))";
}
pub relation lifo_opening_inventory_uses_average_cost(p: Person, application_id: Integer) kind institutional {
    label en official "goods in the opening inventory of the first year LIFO is used are treated as acquired at the same time, costed by the average cost method (section 472(b)(3))";
}
@source(IRC_S472_B, quote = "Treat those remaining on hand at the close of the taxable year as being: First, those included in the opening inventory of the taxable year (in the order of acquisition) to the extent thereof; and second, those acquired in the taxable year")
rule LifoMethodMechanics(p: Person, application_id: Integer) strict {
    label en official "once LIFO is in effect, the section 472(b) ordering, costing and opening-inventory-averaging rules classify the taxpayer's inventory method (section 472(b)(1)-(3))";
    when lifo_method_in_effect(p, application_id);
    then lifo_treats_remaining_goods_as_opening_inventory_first(p, application_id);
}
rule LifoInventoriedAtCost(p: Person, application_id: Integer) strict {
    label en official "LIFO goods are inventoried at cost (section 472(b)(2))";
    when lifo_method_in_effect(p, application_id);
    then lifo_inventoried_at_cost(p, application_id);
}
rule LifoOpeningInventoryAverageCost(p: Person, application_id: Integer) strict {
    label en official "the first year's opening inventory under LIFO is costed by the average cost method (section 472(b)(3))";
    when lifo_method_in_effect(p, application_id);
    then lifo_opening_inventory_uses_average_cost(p, application_id);
}

// --- (e): continued use of LIFO absent an authorized change ---

pub relation secretary_approves_change_from_lifo(p: Person, application_id: Integer) kind empirical {
    label en official "the Secretary approves a change from the LIFO method (section 472(e)(1))";
}
pub relation secretary_requires_change_from_lifo_for_nonconformity(p: Person, application_id: Integer) kind empirical {
    label en official "the Secretary determines the taxpayer used a nonconforming procedure in a subsequent year and requires a change from LIFO (section 472(e)(2))";
}
pub relation lifo_method_continues_in_effect(p: Person, application_id: Integer) kind institutional {
    label en official "the LIFO method continues in effect for all subsequent taxable years, absent an authorized or required change (section 472(e))";
}
@source(IRC_S472_E, quote = "If a taxpayer, having complied with subsection (a), uses the method described in subsection (b) for any taxable year, then such method shall be used in all subsequent taxable years unless")
rule LifoContinuesAbsentAuthorizedChange(p: Person, application_id: Integer) defeasible {
    label en official "LIFO continues in effect for subsequent years unless the Secretary approves a change or requires one for nonconformity (section 472(e))";
    when lifo_method_in_effect(p, application_id);
    when not secretary_approves_change_from_lifo(p, application_id);
    when not secretary_requires_change_from_lifo_for_nonconformity(p, application_id);
    then lifo_method_continues_in_effect(p, application_id);
}

// (d) 3-year averaging for increases in inventory value, (f) government
// price indexes, (g) controlled-group conformity are NOT DONE this round.
