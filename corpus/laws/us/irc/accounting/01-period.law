// Section 441 — Period for computation of taxable income. Stage 1 (IRC-07),
// priority section.
//
// SCOPE: (a) the general computation principle (non-normative anchor for the
// whole package); (b) the four-branch definition of "taxable year" — DISC
// branch (b)(4)/(h) is OUT OF SCOPE (subtitle F DISC rules, stage 2; a
// dependency contract only); (c)-(e) the annual-accounting-period, calendar-
// year and fiscal-year definitions; (f) the 52-53-week-year election as a
// `power`; (g) the calendar-year default when the taxpayer keeps no books,
// has no annual accounting period, or its period does not qualify as a
// fiscal year; (i) the personal-service-corporation required calendar year
// with the DECISION-0194 "business purpose" evaluative channel. (h) DISC and
// the partnership/S-corporation required-year contracts of (i)(1)'s opening
// clause are recorded as pending dependencies, not modelled here (owners:
// `partnerships`, `s-corporations` per AGENT-BRIEF task list).
//
// SIMPLIFICATION recorded once for the whole module: whether a given
// `TaxableYear` instance IS a calendar year (`calendar_year_of`), a fiscal
// year (`fiscal_year`) or a short year (`short_year`) is, per
// `us.irc.core`'s own contract, an INSTITUTIONAL fact this package's rules
// must conclude — but concluding it from first principles requires comparing
// the instance's `begins`/`ends` dates against a calendar (December 31, "the
// last day of any month"), which this stage does not implement (no date
// decomposition primitive was found in the accessible calendar surface).
// This stage therefore takes the taxpayer's characterization of the period
// (calendar / fiscal / does-or-does-not-qualify-as-fiscal) as an ASSERTED
// case fact and formalizes the NORMATIVE consequences the text attaches to
// each branch (the calendar-year default of (g), the election of (f), the
// required year of (i)). Deriving the characterization itself from raw dates
// is TECH_GAP-01-ACCOUNTING (see TECH-GAPS.md row).

// --- (b)/(c)/(d)/(e): definitional predicates, taken as asserted practice facts (see module note) ---

use self::{
    IRC_S441_F,
    IRC_S441_G,
    IRC_S441_I,
    Person,
    TaxableYear,
    short_period_return_required,
};

pub relation keeps_books(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer keeps books in which it regularly computes its income (section 441(c))";
}
pub relation keeps_no_books(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer keeps no books (section 441(g)(1))";
}
pub relation has_annual_accounting_period(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has an annual accounting period on the basis of which it regularly computes its income in keeping its books (section 441(c))";
}
pub relation lacks_annual_accounting_period(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer does not have an annual accounting period (section 441(g)(2))";
}
pub relation annual_accounting_period_qualifies_as_fiscal_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's annual accounting period qualifies as a fiscal year (section 441(g)(3), a contrario)";
}
pub relation annual_accounting_period_does_not_qualify_as_fiscal_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has an annual accounting period, but such period does not qualify as a fiscal year (section 441(g)(3))";
}

// --- (g): calendar-year default ---

@source(IRC_S441_G, quote = "the taxpayer's taxable year shall be the calendar year if")
pub relation calendar_year_required_by_441g(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's taxable year is the calendar year under section 441(g)";
}

@source(IRC_S441_G, quote = "the taxpayer keeps no books")
rule CalendarYearDefaultNoBooks(p: Person, y: TaxableYear) defeasible {
    label en official "the calendar year applies when the taxpayer keeps no books, except as provided in section 443 (section 441(g)(1))";
    when keeps_no_books(p, y);
    unless short_period_return_required(p, y);
    then calendar_year_required_by_441g(p, y);
}
@source(IRC_S441_G, quote = "the taxpayer does not have an annual accounting period")
rule CalendarYearDefaultNoAccountingPeriod(p: Person, y: TaxableYear) defeasible {
    label en official "the calendar year applies when the taxpayer does not have an annual accounting period, except as provided in section 443 (section 441(g)(2))";
    when lacks_annual_accounting_period(p, y);
    unless short_period_return_required(p, y);
    then calendar_year_required_by_441g(p, y);
}
@source(IRC_S441_G, quote = "the taxpayer has an annual accounting period, but such period does not qualify as a fiscal year")
rule CalendarYearDefaultPeriodNotFiscal(p: Person, y: TaxableYear) defeasible {
    label en official "the calendar year applies when the taxpayer's annual accounting period does not qualify as a fiscal year, except as provided in section 443 (section 441(g)(3))";
    when has_annual_accounting_period(p, y);
    when annual_accounting_period_does_not_qualify_as_fiscal_year(p, y);
    unless short_period_return_required(p, y);
    then calendar_year_required_by_441g(p, y);
}

// --- (f): 52-53-week-year election, as a power ---

pub relation elects_52_53_week_year(p: Person, y: TaxableYear) kind empirical {
    label en official "elects to compute taxable income on the basis of an annual period of 52 to 53 weeks, ending always on the same day of the week, under section 441(f)(1)";
}
pub relation annual_period_varies_52_to_53_weeks_same_weekday_end(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer regularly computes its income on the basis of an annual period which varies from 52 to 53 weeks and ends always on the same day of the week, ending on the date that weekday last occurs in a calendar month or nearest to the last day of a calendar month (section 441(f)(1)(A)-(B))";
}
pub relation year_computed_on_52_53_week_basis(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's taxable year is computed on the elected 52-53-week annual-period basis (section 441(f)(1))";
}

@source(IRC_S441_F, quote = "may (in accordance with the regulations prescribed under paragraph (3)) elect to compute his taxable income for purposes of this subtitle on the basis of such annual period")
rule Section441FFiftyTwoFiftyThreeWeekElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer whose annual period varies from 52 to 53 weeks on a fixed weekday ending may elect to compute taxable income on that basis (section 441(f)(1))";
    when annual_period_varies_52_to_53_weeks_same_weekday_end(p, y);
    then power Section441FYearElection {
        holder p;
        over y;
        exercise elects_52_53_week_year(p, y);
        valid_when annual_period_varies_52_to_53_weeks_same_weekday_end(p, y);
        effect create(year_computed_on_52_53_week_basis(p, y));
        window [@1954-08-16, infinity);
    };
}

// --- (i): personal-service-corporation required taxable year ---

pub relation is_personal_service_corporation(corp: Person, y: TaxableYear) kind institutional {
    label en official "the corporation is a personal service corporation within the meaning of section 269A(b)(1), as modified by section 441(i)(2) (derived in 99-wire9-owner-contracts.law from `us.irc.deductions::personal_service_corporation_441i2`; a case may still assert it directly; the section 269A(b)(1)/318(a)(2)(C) attribution test itself is a pending dependency — owner `corporations`)";
}
external judgment relation business_purpose_established_for_different_year_441i(corp: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the corporation establishes, to the satisfaction of the Secretary, a business purpose for having a different period for its taxable year (section 441(i)(1)); deferral of income to shareholders alone is not a business purpose (second sentence)";
}
pub relation required_taxable_year_is_calendar_year_441i(corp: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year of the personal service corporation is required to be the calendar year (section 441(i)(1))";
}

@source(IRC_S441_I, quote = "the taxable year of any personal service corporation shall be the calendar year unless the corporation establishes, to the satisfaction of the Secretary, a business purpose for having a different period for its taxable year")
rule PersonalServiceCorporationRequiredCalendarYear(corp: Person, y: TaxableYear) defeasible {
    label en official "a personal service corporation's taxable year is required to be the calendar year unless a business purpose for a different year is established to the Secretary's satisfaction (section 441(i)(1))";
    when is_personal_service_corporation(corp, y);
    unless business_purpose_established_for_different_year_441i(corp, y);
    then required_taxable_year_is_calendar_year_441i(corp, y);
}
// The last sentence of (i)(1) ("any deferral of income to shareholders shall
// not be treated as a business purpose") is a NEGATIVE CONSTRAINT on the
// judgment channel's own content, not a separate rule this DSL can express
// over an `external judgment relation` (the judgment is opaque once
// requested) — recorded here as INTERPRETATION: the requesting party must
// exclude deferral-only justifications before submitting the request; no
// engine-level guard is implemented. (i)(2)'s section 269A(b)(1)/(2) and
// section 318(a)(2)(C) attribution test is a pending dependency on
// `corporations` (owner of section 269A) — see accounting.deps.json.

// (a) — non-normative anchor: taxable income is computed by reference to the
// taxpayer's taxable year (`us.irc.core::year_of`); this sentence states the
// principle every other rule in this package and its siblings already acts
// on and sets no independent test of its own.
// (b)(1)-(3) restate, as a definition, that a TaxableYear instance is one of
// calendar/fiscal/short (`us.irc.core::calendar_year_of`/`fiscal_year`/
// `short_year`); per the module note these three predicates are asserted
// case facts at this stage, so (b) itself adds no further executable rule
// beyond the branches (f)/(g)/(i) already modelled. (b)(4)/(h) (DISC) is
// stage 2 — EXTERNAL_DEPENDENCY, no `us.irc.*` owner yet assigned.
// (c)/(d)/(e) are the definitions consumed by (f)/(g) above; they set no
// independent rule beyond supplying the vocabulary those rules already use.
