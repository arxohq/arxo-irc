// Section 453 residual (stage 3, DECISION-0379 with deontics): the derived
// related-person and marketable-security definitions of (f)(1)-(2), the
// second-disposition path of (e)(1)-(8) with the suspension of (e)(2)(B), the
// (e)(3) limitation, the (e)(4) fair-market-value substitution and (e)(6)
// exceptions; the payment definitions of (f)(3)-(6), (f)(8); the (g) related
// persons and its (B)(ii)-(C) consequences; the shareholder liquidation rules of
// (h); the current-inclusion rules of (k); and the dealer-disposition
// exceptions and carrying charges of (l)(2).
//
// The stage 2b relations `is_related_person_453`, `is_marketable_security_453`,
// `is_related_person_453g` and `is_depreciable_property_453` stay as asserted
// facts on their legacy paths; the derived relations below are parallel paths.
//
// Not modelled (TECH-GAPS G4800+): the interest of (l)(3), which needs the tax
// attributable to each payment and the applicable Federal rate compounded
// semiannually; the regulations of (j) and (k); the section 318, 267(b), 1239(b)
// and 368(c) control tests (asserted); the accumulation of prior years'
// amounts under (e)(3)(B)(ii) (asserted).

// ===================== (f)(1)-(2): related person; marketable securities =====================

use self::{
    IRC_S453_E,
    IRC_S453_F,
    IRC_S453_G,
    IRC_S453_H,
    IRC_S453_K,
    IRC_S453_L,
    Person,
    TaxableYear,
    all_payments_received_on_first_disposition,
    disposition_of_property,
    elects_timeshare_residential_lot_interest_453l3,
    first_disposition_453e,
    installment_method_denied_453g,
    second_disposition_453e,
    second_disposition_year,
    tax_avoidance_not_a_principal_purpose_453e7,
    tax_avoidance_not_a_principal_purpose_453g2,
};

pub relation stock_attributed_to_seller_under_318a_other_than_318a4_453f1A(person: Person, seller: Person) kind empirical {
    label en official "the person's stock would be attributed under section 318(a), other than paragraph (4), to the person first disposing of the property (section 453(f)(1)(A)); the section 318 test is asserted";
}
pub relation bears_267b_relationship_to_seller_453f1B(person: Person, seller: Person) kind empirical {
    label en official "the person bears a relationship described in section 267(b) to the person first disposing of the property (section 453(f)(1)(B)); the section 267(b) test is asserted";
}
pub relation related_person_453f1(person: Person, seller: Person) kind institutional {
    label en official "a related person for section 453 (other than (g) and (h)): stock attributable under section 318(a) other than (4), or a section 267(b) relationship (section 453(f)(1))";
}
@source(IRC_S453_F, quote = "(A) a person whose stock would be attributed under section 318(a) (other than paragraph (4) thereof) to the person first disposing of the property, or")
rule RelatedPersonByStockAttribution(person: Person, seller: Person) strict {
    label en official "section 318(a) attribution (section 453(f)(1)(A))";
    when stock_attributed_to_seller_under_318a_other_than_318a4_453f1A(person, seller);
    then related_person_453f1(person, seller);
}
@source(IRC_S453_F, quote = "(B) a person who bears a relationship described in section 267(b) to the person first disposing of the property.")
rule RelatedPersonBySection267bRelationship(person: Person, seller: Person) strict {
    label en official "section 267(b) relationship (section 453(f)(1)(B))";
    when bears_267b_relationship_to_seller_453f1B(person, seller);
    then related_person_453f1(person, seller);
}
pub relation market_on_established_securities_market_or_otherwise_453f2(disposition: Integer) kind empirical {
    label en official "as of the date of the disposition there was a market for the security on an established securities market or otherwise (section 453(f)(2))";
}
pub relation marketable_security_453f2(disposition: Integer) kind institutional {
    label en official "a marketable security: any security for which, as of the disposition date, there was a market on an established securities market or otherwise (section 453(f)(2))";
}
@source(IRC_S453_F, quote = "The term \"marketable securities\" means any security for which, as of the date of the disposition, there was a market on an established securities market or otherwise.")
rule MarketableSecurityDefinition(disposition: Integer) strict {
    label en official "a market existed at the disposition date (section 453(f)(2))";
    when market_on_established_securities_market_or_otherwise_453f2(disposition);
    then marketable_security_453f2(disposition);
}

// ===================== (e)(2)(B): suspension of the 2-year period =====================

pub enum RiskDiminishingTransaction453 {
    HoldingOfAPut;
    RightOfAnotherToAcquire;
    ShortSaleOrOtherTransaction;
    label en official "the transactions that substantially diminish the related person's risk of loss (section 453(e)(2)(B)(i)-(iii))";
}
pub relation risk_diminished_period_days_453e2B(period: Integer, disposition: Integer, kind: RiskDiminishingTransaction453, days: Integer) kind empirical {
    label en official "a period during which the related person's risk of loss on the property is substantially diminished by the holding of a put with respect to it (or similar property), the holding by another person of a right to acquire it, or a short sale or other transaction, with the number of days in the period (section 453(e)(2)(B)); 'substantially diminished' is an adjudicated fact";
}
pub relation disposition_has_risk_diminished_period_453e2B(disposition: Integer) kind institutional {
    label en official "the property has at least one risk-diminished period (bridge for the absence test)";
}
rule DispositionHasRiskDiminishedPeriodBridge(period: Integer, disposition: Integer, kind: RiskDiminishingTransaction453, days: Integer) strict {
    label en official "bridge";
    when risk_diminished_period_days_453e2B(period, disposition, kind, days);
    then disposition_has_risk_diminished_period_453e2B(disposition);
}
pub relation total_suspended_days_453e2B(disposition: Integer, days: Integer) kind institutional {
    label en official "the total days by which the running of the 2-year period is suspended (section 453(e)(2)(B))";
}
@source(IRC_S453_E, quote = "The running of the 2-year period set forth in subparagraph (A) shall be suspended with respect to any property for any period during which the related person's risk of loss with respect to the property is substantially diminished by—")
rule TotalSuspendedDaysSum(disposition: Integer) strict {
    label en official "the sum of the days of the diminished-risk periods (section 453(e)(2)(B))";
    when disposition_has_risk_diminished_period_453e2B(disposition);
    then total_suspended_days_453e2B(disposition, sum all d: Integer for period: Integer, kind: RiskDiminishingTransaction453 where risk_diminished_period_days_453e2B(period, disposition, kind, d));
}
rule NoSuspendedDays(disposition: Integer) defeasible {
    label en official "with no diminished-risk period the 2-year period is not suspended";
    when disposition_is_a_first_disposition_453e(disposition);
    when not_known(disposition_has_risk_diminished_period_453e2B(disposition));
    then total_suspended_days_453e2B(disposition, 0);
}
pub relation disposition_is_a_first_disposition_453e(disposition: Integer) kind institutional {
    label en official "the disposition is a first disposition to a related person (bridge)";
}
rule DispositionIsAFirstDisposition(seller: Person, related: Person, disposition: Integer, on: Date) strict {
    label en official "bridge";
    when first_disposition_453e(seller, related, disposition, on);
    then disposition_is_a_first_disposition_453e(disposition);
}
pub relation second_disposition_within_adjusted_two_years_453e2(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, first_on: Date, second_on: Date) kind institutional {
    label en official "the second disposition is not more than 2 years after the first, the days of suspension excluded: days between the dispositions less suspended days do not exceed the days of the 2-year window (section 453(e)(2)(A)-(B))";
}
@source(IRC_S453_E, quote = "(B) Substantial diminishing of risk of ownership")
rule SecondDispositionWithinTwoYearsAfterSuspension(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, first_on: Date, second_on: Date, suspended: Integer) defeasible {
    label en official "elapsed days minus suspended days <= days in 2 calendar years from the first disposition (section 453(e)(2))";
    when first_disposition_453e(seller, related, disposition, first_on);
    when second_disposition_453e(related, disposition, second_disposition, second_on);
    when total_suspended_days_453e2B(disposition, suspended);
    when days_between(first_on, second_on) - suspended <= days_between(first_on, add_calendar_period(first_on, 24 calendar_month));
    then second_disposition_within_adjusted_two_years_453e2(seller, related, disposition, second_disposition, first_on, second_on);
}

// ===================== (e)(4), (e)(6): value of the second disposition; exceptions =====================

pub relation second_disposition_is_sale_or_exchange_453e4(second_disposition: Integer) kind empirical {
    label en official "the second disposition is a sale or exchange (section 453(e)(4))";
}
pub relation amount_realized_on_second_disposition_453e4(second_disposition: Integer, amount: Money) kind empirical {
    label en official "the amount realized on the second disposition (section 453(e)(1))";
}
pub relation fair_market_value_of_property_on_second_disposition_453e4(second_disposition: Integer, amount: Money) kind empirical {
    label en official "the fair market value of the property disposed of in the second disposition (section 453(e)(4)); an adjudicated fact";
}
pub relation second_disposition_value_453e4(second_disposition: Integer, amount: Money) kind institutional {
    label en official "the amount treated for section 453(e): the amount realized on a sale or exchange, otherwise the fair market value of the property disposed of (section 453(e)(4))";
}
@source(IRC_S453_E, quote = "if the second disposition is not a sale or exchange, an amount equal to the fair market value of the property disposed of shall be substituted for the amount realized.")
rule SecondDispositionValueForSaleOrExchange(second_disposition: Integer, amount: Money) defeasible {
    label en official "amount realized for a sale or exchange (section 453(e)(1), (e)(4))";
    when second_disposition_is_sale_or_exchange_453e4(second_disposition);
    when amount_realized_on_second_disposition_453e4(second_disposition, amount);
    then second_disposition_value_453e4(second_disposition, amount);
}
rule SecondDispositionValueForOtherDispositions(second_disposition: Integer, amount: Money) defeasible {
    label en official "fair market value for a second disposition that is not a sale or exchange (section 453(e)(4))";
    when not_known(second_disposition_is_sale_or_exchange_453e4(second_disposition));
    when fair_market_value_of_property_on_second_disposition_453e4(second_disposition, amount);
    then second_disposition_value_453e4(second_disposition, amount);
}
pub relation first_disposition_is_sale_of_stock_to_issuing_corporation_453e6A(disposition: Integer) kind empirical {
    label en official "the first disposition is a sale or exchange of stock to the issuing corporation (section 453(e)(6)(A))";
}
pub relation first_disposition_excepted_453e6A(disposition: Integer) kind institutional {
    label en official "a sale or exchange of stock to the issuing corporation is not a first disposition (section 453(e)(6)(A))";
}
@source(IRC_S453_E, quote = "Any sale or exchange of stock to the issuing corporation shall not be treated as a first disposition.")
rule StockSaleToIssuerNotAFirstDisposition(disposition: Integer) strict {
    label en official "reacquisition of stock by the issuer (section 453(e)(6)(A))";
    when first_disposition_is_sale_of_stock_to_issuing_corporation_453e6A(disposition);
    then first_disposition_excepted_453e6A(disposition);
}
pub relation second_disposition_is_involuntary_conversion_or_later_transfer_453e6B(second_disposition: Integer) kind empirical {
    label en official "the second disposition is a compulsory or involuntary conversion within section 1033, or a transfer after it (section 453(e)(6)(B))";
}
pub relation first_disposition_before_threat_or_imminence_of_conversion_453e6B(disposition: Integer) kind empirical {
    label en official "the first disposition occurred before the threat or imminence of the conversion (section 453(e)(6)(B))";
}
pub relation death_of_first_seller_on_453e6Ci(disposition: Integer, d: Date) kind empirical {
    label en official "the person making the first disposition dies on the date (section 453(e)(6)(C)(i))";
}
pub relation death_of_acquirer_on_453e6Cii(disposition: Integer, d: Date) kind empirical {
    label en official "the person acquiring the property in the first disposition dies on the date (section 453(e)(6)(C)(ii))";
}
pub relation second_disposition_excepted_453e6(disposition: Integer, second_disposition: Integer) kind institutional {
    label en official "the transfer is not a second disposition: an involuntary conversion after a first disposition preceding its threat, or a transfer after the earlier death (section 453(e)(6)(B)-(C))";
}
@source(IRC_S453_E, quote = "A compulsory or involuntary conversion (within the meaning of section 1033) and any transfer thereafter shall not be treated as a second disposition if the first disposition occurred before the threat or imminence of the conversion.")
rule InvoluntaryConversionNotASecondDisposition(disposition: Integer, second_disposition: Integer) strict {
    label en official "conversion after an earlier first disposition (section 453(e)(6)(B))";
    when second_disposition_is_involuntary_conversion_or_later_transfer_453e6B(second_disposition);
    when first_disposition_before_threat_or_imminence_of_conversion_453e6B(disposition);
    then second_disposition_excepted_453e6(disposition, second_disposition);
}
@source(IRC_S453_E, quote = "Any transfer after the earlier of—")
rule TransferAfterFirstSellerDeathNotASecondDisposition(disposition: Integer, second_disposition: Integer, related: Person, second_on: Date, died_on: Date) defeasible {
    label en official "a transfer after the first seller's death (section 453(e)(6)(C)(i))";
    when second_disposition_453e(related, disposition, second_disposition, second_on);
    when death_of_first_seller_on_453e6Ci(disposition, died_on);
    when second_on > died_on;
    then second_disposition_excepted_453e6(disposition, second_disposition);
}
rule TransferAfterAcquirerDeathNotASecondDisposition(disposition: Integer, second_disposition: Integer, related: Person, second_on: Date, died_on: Date) defeasible {
    label en official "a transfer after the acquirer's death (section 453(e)(6)(C)(ii))";
    when second_disposition_453e(related, disposition, second_disposition, second_on);
    when death_of_acquirer_on_453e6Cii(disposition, died_on);
    when second_on > died_on;
    then second_disposition_excepted_453e6(disposition, second_disposition);
}

// ===================== (e)(1), (e)(3), (e)(5), (e)(8): the derived second-disposition path =====================

pub relation amount_treated_as_received_derived_453e1(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount realized on a second disposition by a related person (within the adjusted 2-year cutoff, or of a marketable security), before the (e)(3) limitation, is treated as received at the time of the second disposition by the first seller, on the derived path (section 453(e)(1)-(2), (4), (6)-(7))";
}
@source(IRC_S453_E, quote = "then, for purposes of this section, the amount realized with respect to such second disposition shall be treated as received at the time of the second disposition by the person making the first disposition.")
rule DerivedAmountTreatedAsReceivedWithinTwoYears(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, y: TaxableYear, first_on: Date, second_on: Date, amount: Money) defeasible {
    label en official "a related person's second disposition within the adjusted 2 years, before the seller has all payments, with the (e)(6) and (e)(7) exceptions (section 453(e)(1)-(2), (6)-(7))";
    when related_person_453f1(related, seller);
    when second_disposition_within_adjusted_two_years_453e2(seller, related, disposition, second_disposition, first_on, second_on);
    when not_known(marketable_security_453f2(disposition));
    when not_known(all_payments_received_on_first_disposition(seller, disposition, second_on));
    when not_known(first_disposition_excepted_453e6A(disposition));
    when not_known(second_disposition_excepted_453e6(disposition, second_disposition));
    when not_known(tax_avoidance_not_a_principal_purpose_453e7(seller, related, disposition));
    when second_disposition_value_453e4(second_disposition, amount);
    when second_disposition_year(disposition, second_disposition, y);
    then amount_treated_as_received_derived_453e1(seller, related, disposition, second_disposition, y, amount);
}
rule DerivedAmountTreatedAsReceivedMarketableSecurity(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, y: TaxableYear, first_on: Date, second_on: Date, amount: Money) defeasible {
    label en official "for a marketable security the 2-year cutoff does not apply (section 453(e)(2)(A))";
    when related_person_453f1(related, seller);
    when first_disposition_453e(seller, related, disposition, first_on);
    when second_disposition_453e(related, disposition, second_disposition, second_on);
    when marketable_security_453f2(disposition);
    when not_known(all_payments_received_on_first_disposition(seller, disposition, second_on));
    when not_known(first_disposition_excepted_453e6A(disposition));
    when not_known(second_disposition_excepted_453e6(disposition, second_disposition));
    when not_known(tax_avoidance_not_a_principal_purpose_453e7(seller, related, disposition));
    when second_disposition_value_453e4(second_disposition, amount);
    when second_disposition_year(disposition, second_disposition, y);
    then amount_treated_as_received_derived_453e1(seller, related, disposition, second_disposition, y, amount);
}
pub relation second_disposition_rule_applies_in_year_453e(seller: Person, disposition: Integer, y: TaxableYear) kind institutional {
    label en official "paragraph (1) applies to the disposition for the taxable year (bridge for the (e)(3) limitation)";
}
rule SecondDispositionRuleAppliesInYear(seller: Person, related: Person, disposition: Integer, second_disposition: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "bridge";
    when amount_treated_as_received_derived_453e1(seller, related, disposition, second_disposition, y, amount);
    then second_disposition_rule_applies_in_year_453e(seller, disposition, y);
}
pub relation total_amount_realized_on_second_dispositions_before_close_453e3Ai(seller: Person, disposition: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total amount realized on any second disposition of the property before the close of the taxable year (section 453(e)(3)(A)(i)); the sum is asserted";
}
pub relation total_contract_price_of_first_disposition_453e3Aii(disposition: Integer, amount: Money) kind empirical {
    label en official "the total contract price for the first disposition (section 453(e)(3)(A)(ii))";
}
pub relation aggregate_payments_received_before_close_453e3Bi(seller: Person, disposition: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount of payments received with respect to the first disposition before the close of the year (section 453(e)(3)(B)(i))";
}
pub relation aggregate_treated_as_received_for_prior_years_453e3Bii(seller: Person, disposition: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount treated as received for prior taxable years by reason of subsection (e) (section 453(e)(3)(B)(ii)); the running total is asserted (TECH-GAPS G2108)";
}
pub relation limited_amount_treated_as_received_453e3(seller: Person, disposition: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount treated as received for the year does not exceed the excess of (A) the lesser of the total amount realized on second dispositions and the total contract price, over (B) payments received plus amounts treated as received in prior years; floored at zero (JUDGMENT CALL) (section 453(e)(3))";
}
@source(IRC_S453_E, quote = "The amount treated for any taxable year as received by the person making the first disposition by reason of paragraph (1) shall not exceed the excess of—")
rule LimitationOnAmountTreatedAsReceived(seller: Person, disposition: Integer, y: TaxableYear, realized: Money, price: Money, paid: Money, prior: Money) defeasible {
    label en official "max(min(realized, price) - (payments + prior amounts), 0) (section 453(e)(3))";
    when second_disposition_rule_applies_in_year_453e(seller, disposition, y);
    when total_amount_realized_on_second_dispositions_before_close_453e3Ai(seller, disposition, y, realized);
    when total_contract_price_of_first_disposition_453e3Aii(disposition, price);
    when aggregate_payments_received_before_close_453e3Bi(seller, disposition, y, paid);
    when aggregate_treated_as_received_for_prior_years_453e3Bii(seller, disposition, y, prior);
    then limited_amount_treated_as_received_453e3(seller, disposition, y, max(min(realized, price) - (paid + prior), 0 USD));
}
pub relation aggregate_payments_in_subsequent_years_453e5(seller: Person, disposition: Integer, amount: Money) kind empirical {
    label en official "the aggregate of payments received in subsequent taxable years with respect to the first disposition (section 453(e)(5))";
}
pub relation subsequent_payments_treated_as_receipt_of_tax_paid_amounts_453e5(seller: Person, disposition: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "later payments are not payments on the first disposition to the extent their aggregate does not exceed the amount treated as received under paragraph (1): min(aggregate later payments, that amount) (section 453(e)(5))";
}
@source(IRC_S453_E, quote = "payments received in subsequent taxable years by the person making the first disposition shall not be treated as the receipt of payments with respect to the first disposition to the extent that the aggregate of such payments does not exceed the amount treated as received by reason of paragraph (1).")
rule SubsequentPaymentsAreTaxPaidAmounts(seller: Person, disposition: Integer, y: TaxableYear, later: Money, treated: Money) defeasible {
    label en official "min(later payments, amount treated as received) (section 453(e)(5))";
    when limited_amount_treated_as_received_453e3(seller, disposition, y, treated);
    when aggregate_payments_in_subsequent_years_453e5(seller, disposition, later);
    then subsequent_payments_treated_as_receipt_of_tax_paid_amounts_453e5(seller, disposition, y, min(later, treated));
}
pub relation notice_of_second_disposition_furnished_on_453e8(seller: Person, disposition: Integer, d: Date) kind empirical {
    label en official "the person making the first disposition furnishes, in the manner regulations prescribe, notice that there was a second disposition to which the subsection may have applied, on the date (section 453(e)(8))";
}
pub relation deficiency_assessable_until_453e8(seller: Person, disposition: Integer, until: Date) kind institutional {
    label en official "the period for assessing a deficiency attributable to subsection (e) does not expire before the day 2 years after the notice date (section 453(e)(8)); such a deficiency may be assessed notwithstanding any law or rule of law to the contrary";
}
@source(IRC_S453_E, quote = "shall not expire before the day which is 2 years after the date on which the person making the first disposition furnishes")
rule DeficiencyAssessmentPeriodExtended(seller: Person, disposition: Integer, notified: Date) defeasible {
    label en official "notice date + 24 calendar months (section 453(e)(8))";
    when notice_of_second_disposition_furnished_on_453e8(seller, disposition, notified);
    then deficiency_assessable_until_453e8(seller, disposition, add_calendar_period(notified, 24 calendar_month));
}

// ===================== (f)(3)-(6), (f)(8): payments =====================

pub relation receipt_of_purchaser_evidence_of_indebtedness_453f3(receipt: Integer) kind empirical {
    label en official "the seller receives an evidence of indebtedness of the person acquiring the property, whether or not guaranteed by another (section 453(f)(3))";
}
pub relation evidence_payable_on_demand_453f4A(receipt: Integer) kind empirical {
    label en official "the bond or other evidence of indebtedness is payable on demand (section 453(f)(4)(A))";
}
pub relation evidence_issued_with_interest_coupons_453f5A(receipt: Integer) kind empirical {
    label en official "the evidence is issued with interest coupons attached (section 453(f)(5)(A))";
}
pub relation evidence_issued_in_registered_form_453f5A(receipt: Integer) kind empirical {
    label en official "the evidence is issued in registered form (section 453(f)(5)(A))";
}
pub relation taxpayer_establishes_registered_evidence_not_readily_tradable_453f5A(receipt: Integer) kind empirical {
    label en official "the taxpayer establishes that the registered evidence will not be readily tradable in an established securities market (section 453(f)(5)(A)); an adjudicated fact";
}
pub relation evidence_issued_in_form_designed_to_be_readily_tradable_453f5B(receipt: Integer) kind empirical {
    label en official "the evidence is issued in any other form designed to render it readily tradable in an established securities market (section 453(f)(5)(B))";
}
pub relation evidence_readily_tradable_453f5(receipt: Integer) kind institutional {
    label en official "readily tradable: issued with coupons or in registered form (unless shown not readily tradable), or in another form designed to be readily tradable (section 453(f)(5))";
}
@source(IRC_S453_F, quote = "(A) with interest coupons attached or in registered form (other than one in registered form which the taxpayer establishes will not be readily tradable in an established securities market), or")
rule ReadilyTradableWithCoupons(receipt: Integer) strict {
    label en official "issued with interest coupons attached (section 453(f)(5)(A))";
    when evidence_issued_with_interest_coupons_453f5A(receipt);
    then evidence_readily_tradable_453f5(receipt);
}
rule ReadilyTradableInRegisteredForm(receipt: Integer) defeasible {
    label en official "registered form, unless the taxpayer establishes it will not be readily tradable (section 453(f)(5)(A))";
    when evidence_issued_in_registered_form_453f5A(receipt);
    when not_known(taxpayer_establishes_registered_evidence_not_readily_tradable_453f5A(receipt));
    then evidence_readily_tradable_453f5(receipt);
}
@source(IRC_S453_F, quote = "(B) in any other form designed to render such bond or other evidence of indebtedness readily tradable in an established securities market.")
rule ReadilyTradableByDesign(receipt: Integer) strict {
    label en official "a form designed to be readily tradable (section 453(f)(5)(B))";
    when evidence_issued_in_form_designed_to_be_readily_tradable_453f5B(receipt);
    then evidence_readily_tradable_453f5(receipt);
}
pub relation receipt_treated_as_payment_453f4(receipt: Integer) kind institutional {
    label en official "receipt of a bond or other evidence of indebtedness that is payable on demand or readily tradable is treated as receipt of payment (section 453(f)(4))";
}
@source(IRC_S453_F, quote = "shall be treated as receipt of payment.")
rule OnDemandEvidenceIsAPayment(receipt: Integer) defeasible {
    label en official "payable on demand (section 453(f)(4)(A))";
    when receipt_of_purchaser_evidence_of_indebtedness_453f3(receipt);
    when evidence_payable_on_demand_453f4A(receipt);
    then receipt_treated_as_payment_453f4(receipt);
}
rule ReadilyTradableEvidenceIsAPayment(receipt: Integer) defeasible {
    label en official "readily tradable (section 453(f)(4)(B))";
    when receipt_of_purchaser_evidence_of_indebtedness_453f3(receipt);
    when evidence_readily_tradable_453f5(receipt);
    then receipt_treated_as_payment_453f4(receipt);
}
pub relation receipt_of_evidence_is_not_a_payment_453f3(receipt: Integer) kind institutional {
    label en official "the receipt of the purchaser's evidence of indebtedness is not a payment, except a demand or readily tradable one (section 453(f)(3)-(4))";
}
@source(IRC_S453_F, quote = "Except as provided in paragraph (4), the term \"payment\" does not include the receipt of evidences of indebtedness of the person acquiring the property (whether or not payment of such indebtedness is guaranteed by another person).")
rule EvidenceOfIndebtednessIsNotAPayment(receipt: Integer) defeasible {
    label en official "an ordinary evidence of indebtedness is not a payment (section 453(f)(3))";
    when receipt_of_purchaser_evidence_of_indebtedness_453f3(receipt);
    when not_known(receipt_treated_as_payment_453f4(receipt));
    then receipt_of_evidence_is_not_a_payment_453f3(receipt);
}
pub relation exchange_described_in_1031b_453f6(disposition: Integer) kind empirical {
    label en official "the disposition is an exchange described in section 1031(b) (section 453(f)(6))";
}
pub relation contract_price_before_1031b_reduction_453f6A(disposition: Integer, amount: Money) kind empirical {
    label en official "the total contract price before the section 1031(b) reduction (section 453(f)(6)(A))";
}
pub relation property_permitted_to_be_received_without_recognition_453f6(disposition: Integer, amount: Money) kind empirical {
    label en official "the property permitted to be received in the exchange without recognition of gain (section 453(f)(6)(A), (C))";
}
pub relation gross_profit_before_1031b_reduction_453f6B(disposition: Integer, amount: Money) kind empirical {
    label en official "the gross profit from the exchange before the section 1031(b) reduction (section 453(f)(6)(B))";
}
pub relation amount_not_recognized_by_reason_of_1031b_453f6B(disposition: Integer, amount: Money) kind empirical {
    label en official "the amount not recognized by reason of section 1031(b) (section 453(f)(6)(B))";
}
pub relation total_contract_price_after_1031b_453f6A(disposition: Integer, amount: Money) kind institutional {
    label en official "the total contract price is reduced by the property permitted to be received without recognition, floored at zero (JUDGMENT CALL) (section 453(f)(6)(A))";
}
@source(IRC_S453_F, quote = "(A) the total contract price shall be reduced to take into account the amount of any property permitted to be received in such exchange without recognition of gain,")
rule TotalContractPriceReducedFor1031b(disposition: Integer, price: Money, prop: Money) defeasible {
    label en official "price less nonrecognition property (section 453(f)(6)(A))";
    when exchange_described_in_1031b_453f6(disposition);
    when contract_price_before_1031b_reduction_453f6A(disposition, price);
    when property_permitted_to_be_received_without_recognition_453f6(disposition, prop);
    then total_contract_price_after_1031b_453f6A(disposition, max(price - prop, 0 USD));
}
pub relation gross_profit_after_1031b_453f6B(disposition: Integer, amount: Money) kind institutional {
    label en official "the gross profit is reduced by the amount not recognized by reason of section 1031(b), floored at zero (JUDGMENT CALL) (section 453(f)(6)(B))";
}
@source(IRC_S453_F, quote = "(B) the gross profit from such exchange shall be reduced to take into account any amount not recognized by reason of section 1031(b), and")
rule GrossProfitReducedFor1031b(disposition: Integer, gross: Money, unrecognized: Money) defeasible {
    label en official "gross profit less the unrecognized amount (section 453(f)(6)(B))";
    when exchange_described_in_1031b_453f6(disposition);
    when gross_profit_before_1031b_reduction_453f6B(disposition, gross);
    when amount_not_recognized_by_reason_of_1031b_453f6B(disposition, unrecognized);
    then gross_profit_after_1031b_453f6B(disposition, max(gross - unrecognized, 0 USD));
}
pub relation property_received_in_1031b_exchange_is_not_a_payment_453f6C(disposition: Integer, amount: Money) kind institutional {
    label en official "outside subsection (b)(1) the property permitted to be received in a section 1031(b) exchange without recognition is not a payment (section 453(f)(6)(C))";
}
@source(IRC_S453_F, quote = "(C) the term \"payment\", when used in any provision of this section other than subsection (b)(1), shall not include any property permitted to be received in such exchange without recognition of gain.")
rule NonrecognitionPropertyIsNotAPayment(disposition: Integer, prop: Money) defeasible {
    label en official "nonrecognition property is not a payment (section 453(f)(6)(C))";
    when exchange_described_in_1031b_453f6(disposition);
    when property_permitted_to_be_received_without_recognition_453f6(disposition, prop);
    then property_received_in_1031b_exchange_is_not_a_payment_453f6C(disposition, prop);
}
pub relation exchange_described_in_356a_not_a_dividend_453f6(disposition: Integer) kind empirical {
    label en official "the disposition is an exchange described in section 356(a) that is not treated as a dividend (section 453(f)(6), last sentence)";
}
pub relation similar_1031b_rules_apply_to_356a_exchange_453f6(disposition: Integer) kind institutional {
    label en official "rules similar to (A)-(C) apply to a section 356(a) exchange that is not a dividend (section 453(f)(6), last sentence)";
}
@source(IRC_S453_F, quote = "Similar rules shall apply in the case of an exchange which is described in section 356(a) and is not treated as a dividend.")
rule SimilarRulesForSection356aExchange(disposition: Integer) defeasible {
    label en official "the section 1031(b) rules are extended (section 453(f)(6))";
    when exchange_described_in_356a_not_a_dividend_453f6(disposition);
    then similar_1031b_rules_apply_to_356a_exchange_453f6(disposition);
}
pub relation aggregate_noncontingent_payments_453f8A(disposition: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount of all payments not contingent as to amount (section 453(f)(8)(A))";
}
pub relation fair_market_value_of_contingent_payments_453f8B(disposition: Integer, amount: Money) kind empirical {
    label en official "the fair market value of any payments contingent as to amount (section 453(f)(8)(B)); an adjudicated fact";
}
pub relation payments_to_be_received_453f8(disposition: Integer, amount: Money) kind institutional {
    label en official "payments to be received: the non-contingent payments plus the fair market value of the contingent ones (section 453(f)(8))";
}
@source(IRC_S453_F, quote = "The term \"payments to be received\" includes—")
rule PaymentsToBeReceivedSum(disposition: Integer, fixed: Money, contingent: Money) defeasible {
    label en official "(A) + (B) (section 453(f)(8))";
    when aggregate_noncontingent_payments_453f8A(disposition, fixed);
    when fair_market_value_of_contingent_payments_453f8B(disposition, contingent);
    then payments_to_be_received_453f8(disposition, fixed + contingent);
}

// ===================== (g): depreciable property sold to a related person =====================

pub relation subject_to_167_allowance_in_hands_of_transferee_453f7(disposition: Integer) kind empirical {
    label en official "the property, in the hands of the transferee, is of a character subject to the allowance for depreciation of section 167 (section 453(f)(7))";
}
pub relation depreciable_property_453f7(disposition: Integer) kind institutional {
    label en official "depreciable property: property of a character subject to the section 167 depreciation allowance in the transferee's hands (section 453(f)(7))";
}
rule DepreciablePropertyDefinition(disposition: Integer) strict {
    label en official "section 167 property in the transferee's hands (section 453(f)(7))";
    when subject_to_167_allowance_in_hands_of_transferee_453f7(disposition);
    then depreciable_property_453f7(disposition);
}
pub relation related_by_1239b_453g3(a: Person, b: Person) kind empirical {
    label en official "the persons are related persons within the meaning of section 1239(b) (section 453(g)(3)); asserted";
}
pub relation partnerships_related_under_707b1B_453g3(a: Person, b: Person) kind empirical {
    label en official "the persons are 2 or more partnerships having a relationship described in section 707(b)(1)(B) (section 453(g)(3))";
}
pub relation related_persons_453g3(a: Person, b: Person) kind institutional {
    label en official "related persons for (g): section 1239(b) persons, including partnerships related under section 707(b)(1)(B) (section 453(g)(3))";
}
@source(IRC_S453_G, quote = "the term \"related persons\" has the meaning given to such term by section 1239(b), except that such term shall include 2 or more partnerships having a relationship to each other described in section 707(b)(1)(B).")
rule RelatedPersonsBySection1239b(a: Person, b: Person) strict {
    label en official "section 1239(b) (section 453(g)(3))";
    when related_by_1239b_453g3(a, b);
    then related_persons_453g3(a, b);
}
rule RelatedPersonsByRelatedPartnerships(a: Person, b: Person) strict {
    label en official "partnerships related under section 707(b)(1)(B) (section 453(g)(3))";
    when partnerships_related_under_707b1B_453g3(a, b);
    then related_persons_453g3(a, b);
}
rule InstallmentMethodDeniedForDerivedRelatedPartyDepreciableProperty(seller: Person, buyer: Person, disposition: Integer) defeasible {
    label en official "the derived path: depreciable property under (f)(7) sold to a person related under (g)(3), unless the Secretary is satisfied that tax avoidance was not a principal purpose (section 453(g)(1)(A), (2))";
    when depreciable_property_453f7(disposition);
    when related_persons_453g3(seller, buyer);
    unless tax_avoidance_not_a_principal_purpose_453g2(seller, buyer, disposition);
    then installment_method_denied_453g(seller, buyer, disposition);
}
pub relation contingent_payment_value_not_reasonably_ascertainable_453g1Bii(disposition: Integer) kind empirical {
    label en official "a payment contingent as to amount has a fair market value that may not be reasonably ascertained (section 453(g)(1)(B)(ii)); an adjudicated fact";
}
pub relation basis_recovered_ratably_453g1Bii(seller: Person, buyer: Person, disposition: Integer) kind institutional {
    label en official "for payments contingent as to amount whose fair market value cannot reasonably be ascertained, the basis is recovered ratably rather than treating the payments as received (section 453(g)(1)(B)(ii))";
}
@source(IRC_S453_G, quote = "(ii) in the case of any payments which are contingent as to the amount but with respect to which the fair market value may not be reasonably ascertained, the basis shall be recovered ratably, and")
rule BasisRecoveredRatablyForUnascertainableContingentPayments(seller: Person, buyer: Person, disposition: Integer) defeasible {
    label en official "ratable basis recovery for unascertainable contingent payments (section 453(g)(1)(B)(ii)); the ratable schedule is regulatory (section 453(j)(2))";
    when installment_method_denied_453g(seller, buyer, disposition);
    when contingent_payment_value_not_reasonably_ascertainable_453g1Bii(disposition);
    then basis_recovered_ratably_453g1Bii(seller, buyer, disposition);
}
pub relation purchaser_claimed_basis_increase_453g1C(buyer: Person, disposition: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the increase in the basis of the property the purchaser claims for the year (section 453(g)(1)(C))";
}
pub relation cumulative_amount_includible_in_sellers_gross_income_453g1C(seller: Person, disposition: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cumulative amount includible in the seller's gross income as of the year (section 453(g)(1)(C))";
}
pub relation purchaser_basis_increase_permitted_453g1C(buyer: Person, seller: Person, disposition: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the purchaser may not increase basis by an amount before it is includible in the seller's gross income: the permitted increase is the lesser of the claim and the cumulative amount the seller includes (section 453(g)(1)(C))";
}
@source(IRC_S453_G, quote = "(C) the purchaser may not increase the basis of any property acquired in such sale by any amount before the time such amount is includible in the gross income of the seller.")
rule PurchaserBasisIncreaseLimitedToSellersInclusion(buyer: Person, seller: Person, disposition: Integer, y: TaxableYear, claimed: Money, included: Money) defeasible {
    label en official "min(claimed increase, seller's cumulative inclusion) (section 453(g)(1)(C))";
    when installment_method_denied_453g(seller, buyer, disposition);
    when purchaser_claimed_basis_increase_453g1C(buyer, disposition, y, claimed);
    when cumulative_amount_includible_in_sellers_gross_income_453g1C(seller, disposition, y, included);
    then purchaser_basis_increase_permitted_453g1C(buyer, seller, disposition, y, min(claimed, included));
}

// ===================== (h): shareholders in certain liquidations =====================

pub relation section_331_liquidation_453h1A(corp: Person, shareholder: Person) kind empirical {
    label en official "the shareholder receives obligations in a liquidation of the corporation to which section 331 applies (section 453(h)(1)(A))";
}
pub relation plan_of_complete_liquidation_adopted_on_453h1A(corp: Person, d: Date) kind empirical {
    label en official "the plan of complete liquidation is adopted on the date (section 453(h)(1)(A))";
}
pub relation liquidation_completed_on_453h1A(corp: Person, d: Date) kind empirical {
    label en official "the liquidation is completed on the date (section 453(h)(1)(A))";
}
pub relation installment_obligation_received_in_exchange_for_stock_453h1A(shareholder: Person, obligation: Integer, corp: Person) kind empirical {
    label en official "the shareholder receives, in exchange for its stock, the installment obligation (section 453(h)(1)(A))";
}
pub relation obligation_acquired_by_corporation_in_sale_on_453h1A(obligation: Integer, corp: Person, d: Date) kind empirical {
    label en official "the obligation is acquired in respect of a sale or exchange by the corporation on the date (section 453(h)(1)(A))";
}
pub relation obligation_arises_from_sale_of_inventory_type_property_453h1B(obligation: Integer) kind empirical {
    label en official "the obligation is acquired in respect of a sale of stock in trade, inventory-type property, or property held primarily for sale to customers (section 453(h)(1)(B)(i)-(iii))";
}
pub relation sale_to_one_person_in_one_transaction_of_substantially_all_property_of_a_business_453h1B(obligation: Integer) kind empirical {
    label en official "the sale is to 1 person in 1 transaction and involves substantially all such property attributable to a trade or business of the corporation (section 453(h)(1)(B)); 'substantially all' is an adjudicated fact";
}
pub relation liquidation_within_twelve_months_of_plan_453h1A(obligation: Integer, corp: Person) kind institutional {
    label en official "the sale is within the 12-month period beginning on the plan date and the liquidation is completed within that period (section 453(h)(1)(A))";
}
@source(IRC_S453_H, quote = "during the 12-month period beginning on the date a plan of complete liquidation is adopted and the liquidation is completed during such 12-month period")
rule ObligationAcquiredWithinTwelveMonthsOfPlan(obligation: Integer, corp: Person, plan_on: Date, sale_on: Date, done_on: Date) defeasible {
    label en official "sale and completion inside 12 calendar months of the plan date (section 453(h)(1)(A))";
    when plan_of_complete_liquidation_adopted_on_453h1A(corp, plan_on);
    when obligation_acquired_by_corporation_in_sale_on_453h1A(obligation, corp, sale_on);
    when liquidation_completed_on_453h1A(corp, done_on);
    when sale_on >= plan_on;
    when sale_on <= add_calendar_period(plan_on, 12 calendar_month);
    when done_on <= add_calendar_period(plan_on, 12 calendar_month);
    then liquidation_within_twelve_months_of_plan_453h1A(obligation, corp);
}
pub relation obligation_of_a_related_obligor_attributable_to_depreciable_property_453h1C(obligation: Integer, amount: Money) kind empirical {
    label en official "the obligor and the shareholder are married or related persons (section 1239(b)) and this amount of the obligation is attributable to the corporation's disposition of depreciable property (section 453(h)(1)(C)); the relationship is asserted";
}
pub relation obligation_total_amount_453h(obligation: Integer, amount: Money) kind empirical {
    label en official "the total amount of the installment obligation";
}
pub relation liquidation_obligation_payments_treated_as_payment_for_stock_453h1A(shareholder: Person, obligation: Integer) kind institutional {
    label en official "the receipt of payments under the obligation (but not of the obligation) is treated as the receipt of payment for the stock (section 453(h)(1)(A))";
}
@source(IRC_S453_H, quote = "then, for purposes of this section, the receipt of payments under such obligation (but not the receipt of such obligation) by the shareholder shall be treated as the receipt of payment for the stock.")
rule LiquidationObligationNonInventory(shareholder: Person, obligation: Integer, corp: Person) defeasible {
    label en official "a qualifying obligation received in a section 331 liquidation (section 453(h)(1)(A)); an inventory-type sale needs the (B) bulk sale";
    when section_331_liquidation_453h1A(corp, shareholder);
    when installment_obligation_received_in_exchange_for_stock_453h1A(shareholder, obligation, corp);
    when liquidation_within_twelve_months_of_plan_453h1A(obligation, corp);
    when not_known(obligation_arises_from_sale_of_inventory_type_property_453h1B(obligation));
    then liquidation_obligation_payments_treated_as_payment_for_stock_453h1A(shareholder, obligation);
}
rule LiquidationObligationInventoryBulkSale(shareholder: Person, obligation: Integer, corp: Person) defeasible {
    label en official "an inventory-type obligation qualifies only when acquired in a bulk sale to one person in one transaction (section 453(h)(1)(B))";
    when section_331_liquidation_453h1A(corp, shareholder);
    when installment_obligation_received_in_exchange_for_stock_453h1A(shareholder, obligation, corp);
    when liquidation_within_twelve_months_of_plan_453h1A(obligation, corp);
    when obligation_arises_from_sale_of_inventory_type_property_453h1B(obligation);
    when sale_to_one_person_in_one_transaction_of_substantially_all_property_of_a_business_453h1B(obligation);
    then liquidation_obligation_payments_treated_as_payment_for_stock_453h1A(shareholder, obligation);
}
pub relation payments_deemed_received_in_year_obligation_received_453h1C(shareholder: Person, obligation: Integer, amount: Money) kind institutional {
    label en official "to the extent the obligation is attributable to a disposition of depreciable property and the obligor is married to or related to the shareholder, (A) does not apply and all those payments are deemed received in the year the obligation is received (section 453(h)(1)(C))";
}
@source(IRC_S453_H, quote = "(ii) for purposes of this title, all payments to be received by the shareholder shall be deemed received in the year the shareholder receives the obligation.")
rule RelatedObligorDepreciablePortionDeemedReceived(shareholder: Person, obligation: Integer, amount: Money, corp: Person) defeasible {
    label en official "the depreciable-property portion of a related obligor's obligation (section 453(h)(1)(C)(ii))";
    when obligation_of_a_related_obligor_attributable_to_depreciable_property_453h1C(obligation, amount);
    when installment_obligation_received_in_exchange_for_stock_453h1A(shareholder, obligation, corp);
    then payments_deemed_received_in_year_obligation_received_453h1C(shareholder, obligation, amount);
}
pub relation obligation_portion_left_for_453h1A_453h1C(obligation: Integer, amount: Money) kind institutional {
    label en official "the part of the obligation not attributable to the related-obligor depreciable property, which keeps the (A) treatment (section 453(h)(1)(C), 'to the extent')";
}
rule ObligationPortionLeftForSubparagraphA(obligation: Integer, total: Money, attributable: Money) defeasible {
    label en official "total less the depreciable-property portion, floored at zero (section 453(h)(1)(C))";
    when obligation_total_amount_453h(obligation, total);
    when obligation_of_a_related_obligor_attributable_to_depreciable_property_453h1C(obligation, attributable);
    then obligation_portion_left_for_453h1A_453h1C(obligation, max(total - attributable, 0 USD));
}
pub relation disposition_by_corporation_treated_also_as_by_shareholder_453h1D(shareholder: Person, corp: Person, disposition: Integer) kind institutional {
    label en official "for (e)(1)(A) a disposition of property by the corporation is also a disposition of it by the shareholder (section 453(h)(1)(D))";
}
pub relation disposition_of_property_by_corporation_453h1D(corp: Person, disposition: Integer) kind empirical {
    label en official "the corporation disposes of property in the liquidation setting (section 453(h)(1)(D))";
}
@source(IRC_S453_H, quote = "disposition of property by the corporation shall be treated also as disposition of such property by the shareholder.")
rule CorporationDispositionIsAlsoTheShareholders(shareholder: Person, corp: Person, disposition: Integer, obligation: Integer) defeasible {
    label en official "the shareholder is treated as also disposing, for (e)(1)(A) (section 453(h)(1)(D))";
    when section_331_liquidation_453h1A(corp, shareholder);
    when disposition_of_property_by_corporation_453h1D(corp, disposition);
    when liquidation_obligation_payments_treated_as_payment_for_stock_453h1A(shareholder, obligation);
    then disposition_by_corporation_treated_also_as_by_shareholder_453h1D(shareholder, corp, disposition);
}
pub relation controlling_corporate_shareholder_of_selling_corporation_453h1E(controller: Person, selling_corp: Person) kind empirical {
    label en official "the corporation is a controlling corporate shareholder (section 368(c)) of the selling corporation; each level above is asserted separately, since the successive application is a chain (section 453(h)(1)(E))";
}
pub relation obligation_treated_as_acquired_by_controlling_shareholder_453h1E(obligation: Integer, selling_corp: Person, controller: Person) kind institutional {
    label en official "an obligation acquired in a sale by the selling corporation is treated as acquired by its controlling corporate shareholder, applied successively to each controlling shareholder above (section 453(h)(1)(E))";
}
@source(IRC_S453_H, quote = "an obligation acquired in respect of a sale or exchange by the selling corporation shall be treated as so acquired by such controlling corporate shareholder.")
rule ObligationTreatedAsAcquiredByControllingShareholder(obligation: Integer, selling_corp: Person, controller: Person, d: Date) defeasible {
    label en official "the controller is treated as the acquirer (section 453(h)(1)(E))";
    when obligation_acquired_by_corporation_in_sale_on_453h1A(obligation, selling_corp, d);
    when controlling_corporate_shareholder_of_selling_corporation_453h1E(controller, selling_corp);
    then obligation_treated_as_acquired_by_controlling_shareholder_453h1E(obligation, selling_corp, controller);
}
pub relation stock_basis_of_shareholder_in_liquidation_453h2(shareholder: Person, amount: Money) kind empirical {
    label en official "the shareholder's basis in the stock of the corporation (section 453(h)(2))";
}
pub relation fair_market_value_of_property_received_in_liquidation_453h2(shareholder: Person, prop: Integer, amount: Money) kind empirical {
    label en official "the fair market value of a property received in the liquidation, in any of the taxable years (section 453(h)(2))";
}
pub relation total_fair_market_value_of_property_received_in_liquidation_453h2(shareholder: Person, amount: Money) kind empirical {
    label en official "the total fair market value of all property received in the liquidation over all taxable years (section 453(h)(2)); the sum is asserted";
}
pub relation shareholder_received_property_in_more_than_one_taxable_year_453h2B(shareholder: Person) kind empirical {
    label en official "by reason of the liquidation the shareholder receives property in more than 1 taxable year (section 453(h)(2)(B))";
}
pub relation reallocated_stock_basis_to_property_453h2(shareholder: Person, prop: Integer, amount: Money) kind institutional {
    label en official "on completion of the liquidation the stock basis is reallocated among all property received in proportion to fair market value, one division, cents HALF_UP (JUDGMENT CALL: the text says 'properly allocated') (section 453(h)(2))";
}
@source(IRC_S453_H, quote = "then, on completion of the liquidation, basis previously allocated to property so received shall be reallocated for all such taxable years so that the shareholder's basis in the stock of the corporation is properly allocated among all property received by such shareholder in such liquidation.")
rule BasisReallocatedAcrossYearsByFairMarketValue(shareholder: Person, prop: Integer, corp: Person, obligation: Integer, basis: Money, part: Money, total: Money) defeasible {
    label en official "basis x property value / total value (section 453(h)(2))";
    when liquidation_obligation_payments_treated_as_payment_for_stock_453h1A(shareholder, obligation);
    when shareholder_received_property_in_more_than_one_taxable_year_453h2B(shareholder);
    when stock_basis_of_shareholder_in_liquidation_453h2(shareholder, basis);
    when fair_market_value_of_property_received_in_liquidation_453h2(shareholder, prop, part);
    when total_fair_market_value_of_property_received_in_liquidation_453h2(shareholder, total);
    when total > 0.00 USD;
    then reallocated_stock_basis_to_property_453h2(shareholder, prop, div_round(basis * (part / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// ===================== (k): current inclusion =====================

pub relation disposition_under_revolving_credit_plan_453k1(disposition: Integer) kind empirical {
    label en official "the disposition is a disposition of personal property under a revolving credit plan (section 453(k)(1))";
}
pub relation obligation_arises_from_sale_of_stock_or_securities_traded_on_established_market_453k2A(disposition: Integer) kind empirical {
    label en official "the installment obligation arises out of a sale of stock or securities traded on an established securities market (section 453(k)(2)(A))";
}
pub relation regulations_extend_current_inclusion_to_regularly_traded_property_453k2B(disposition: Integer) kind empirical {
    label en official "to the extent provided in regulations, the property, other than stock or securities, is of a kind regularly traded on an established market (section 453(k)(2)(B)); the regulations are asserted";
}
pub relation installment_method_denied_453k(p: Person, disposition: Integer) kind institutional {
    label en official "subsection (a) does not apply and all payments to be received are treated as received in the year of the disposition: revolving credit plans and sales of exchange-traded stock or securities (section 453(k))";
}
@source(IRC_S453_K, quote = "subsection (a) shall not apply, and, for purposes of this title, all payments to be received shall be treated as received in the year of disposition.")
rule CurrentInclusionForRevolvingCreditPlans(p: Person, y: TaxableYear, disposition: Integer) defeasible {
    label en official "revolving credit plan dispositions (section 453(k)(1))";
    when disposition_of_property(p, y, disposition);
    when disposition_under_revolving_credit_plan_453k1(disposition);
    then installment_method_denied_453k(p, disposition);
}
rule CurrentInclusionForTradedStockOrSecurities(p: Person, y: TaxableYear, disposition: Integer) defeasible {
    label en official "sales of stock or securities traded on an established securities market (section 453(k)(2)(A))";
    when disposition_of_property(p, y, disposition);
    when obligation_arises_from_sale_of_stock_or_securities_traded_on_established_market_453k2A(disposition);
    then installment_method_denied_453k(p, disposition);
}
rule CurrentInclusionForRegularlyTradedProperty(p: Person, y: TaxableYear, disposition: Integer) defeasible {
    label en official "regularly traded property, to the extent regulations provide (section 453(k)(2)(B))";
    when disposition_of_property(p, y, disposition);
    when regulations_extend_current_inclusion_to_regularly_traded_property_453k2B(disposition);
    then installment_method_denied_453k(p, disposition);
}
pub relation payments_treated_as_received_in_year_of_disposition_453k(p: Person, y: TaxableYear, disposition: Integer, amount: Money) kind institutional {
    label en official "all payments to be received are treated as received in the year of the disposition (section 453(k))";
}
rule PaymentsToBeReceivedTreatedAsReceivedByCurrentInclusion(p: Person, y: TaxableYear, disposition: Integer, amount: Money) defeasible {
    label en official "all payments to be received in the year of disposition (section 453(k))";
    when installment_method_denied_453k(p, disposition);
    when disposition_of_property(p, y, disposition);
    when payments_to_be_received_453f8(disposition, amount);
    then payments_treated_as_received_in_year_of_disposition_453k(p, y, disposition, amount);
}

// ===================== (l)(2): dealer disposition exceptions =====================

pub relation disposition_of_timeshare_right_or_campground_453l2BiiI(disposition: Integer) kind empirical {
    label en official "the disposition, in the ordinary course of the taxpayer's business to an individual, of a timeshare right to use or ownership interest in residential real property for not more than 6 weeks a year, or a right to use specified campgrounds for recreational purposes (section 453(l)(2)(B)(ii)(I))";
}
pub relation disposition_of_residential_lot_without_improvements_by_taxpayer_453l2BiiII(disposition: Integer) kind empirical {
    label en official "the disposition, in the ordinary course of the business to an individual, of a residential lot, the taxpayer (or a related person) not being to make any improvements (section 453(l)(2)(B)(ii)(II))";
}
pub relation disposition_described_in_453l2Bii(disposition: Integer) kind institutional {
    label en official "a disposition described in (B)(ii): a timeshare or campground right, or an unimproved residential lot, sold to an individual in the ordinary course (section 453(l)(2)(B)(ii))";
}
rule DispositionOfTimeshareIsDescribed(disposition: Integer) strict {
    label en official "(B)(ii)(I)";
    when disposition_of_timeshare_right_or_campground_453l2BiiI(disposition);
    then disposition_described_in_453l2Bii(disposition);
}
rule DispositionOfResidentialLotIsDescribed(disposition: Integer) strict {
    label en official "(B)(ii)(II)";
    when disposition_of_residential_lot_without_improvements_by_taxpayer_453l2BiiII(disposition);
    then disposition_described_in_453l2Bii(disposition);
}
pub relation timeshare_right_held_by_family_member_of_individual_453l2Bii(individual: Person, holder: Person) kind empirical {
    label en official "the timeshare right or interest is held by the spouse, a child, a grandchild, or a parent of the individual (section 453(l)(2)(B)(ii), last sentence)";
}
pub relation timeshare_right_treated_as_held_by_individual_453l2Bii(individual: Person, holder: Person) kind institutional {
    label en official "a timeshare right held by the individual's spouse, children, grandchildren or parents is treated as held by the individual (section 453(l)(2)(B)(ii), last sentence)";
}
@source(IRC_S453_L, quote = "a timeshare right to use (or timeshare ownership interest in) property held by the spouse, children, grandchildren, or parents of an individual shall be treated as held by such individual.")
rule TimeshareRightHeldByFamilyTreatedAsHeldByIndividual(individual: Person, holder: Person) strict {
    label en official "family attribution for the 6-weeks test (section 453(l)(2)(B)(ii))";
    when timeshare_right_held_by_family_member_of_individual_453l2Bii(individual, holder);
    then timeshare_right_treated_as_held_by_individual_453l2Bii(individual, holder);
}
pub relation obligation_guaranteed_by_person_other_than_an_individual_453l2Bi(disposition: Integer) kind empirical {
    label en official "the installment obligation is guaranteed by a person other than an individual (section 453(l)(2)(B)(i), last sentence)";
}
pub relation timeshare_lot_election_valid_453l2Bi(p: Person, disposition: Integer) kind institutional {
    label en official "the election of (B)(i) is available only for a (B)(ii) disposition, and not for an obligation guaranteed by a person other than an individual";
}
rule TimeshareLotElectionAvailability(p: Person, disposition: Integer) strict {
    label en official "(B)(ii) disposition and no non-individual guarantor (section 453(l)(2)(B)(i))";
    when disposition_described_in_453l2Bii(disposition);
    when disposition_of_property_by_taxpayer_453l(p, disposition);
    when not_known(obligation_guaranteed_by_person_other_than_an_individual_453l2Bi(disposition));
    then timeshare_lot_election_valid_453l2Bi(p, disposition);
}
pub relation disposition_of_property_by_taxpayer_453l(p: Person, disposition: Integer) kind empirical {
    label en official "the taxpayer makes the disposition (section 453(l)(2)(B))";
}
pub relation timeshare_lot_election_in_effect_453l2B(p: Person, disposition: Integer) kind institutional {
    label en official "the election under (B)(i) to have paragraph (3) apply is in effect for the installment obligation";
}
@source(IRC_S453_L, quote = "Any dispositions described in clause (ii) on the installment plan if the taxpayer elects to have paragraph (3) apply to any installment obligations which arise from such dispositions.")
rule Section453l2BElectionPower(p: Person, disposition: Integer) strict {
    label en official "the taxpayer may elect that paragraph (3) apply, taking the disposition out of the dealer-disposition definition (section 453(l)(2)(B)(i)); invalid where a non-individual guarantees the obligation";
    when elects_timeshare_residential_lot_interest_453l3(p, disposition);
    then power Section453l2BTimeshareLotElection {
        holder p;
        over disposition;
        exercise elects_timeshare_residential_lot_interest_453l3(p, disposition);
        valid_when timeshare_lot_election_valid_453l2Bi(p, disposition);
        effect create(timeshare_lot_election_in_effect_453l2B(p, disposition));
        window [@1987-01-01, infinity);
    };
}
pub relation carrying_charges_added_to_cash_selling_price_on_books_453l2C(disposition: Integer) kind empirical {
    label en official "carrying charges or interest with respect to a dealer or timeshare disposition are added on the seller's books of account to the established cash selling price (section 453(l)(2)(C))";
}
pub relation carrying_charges_or_interest_amount_453l2C(disposition: Integer, amount: Money) kind empirical {
    label en official "the amount of the carrying charges or interest (section 453(l)(2)(C))";
}
pub relation cash_selling_price_453l2C(disposition: Integer, amount: Money) kind empirical {
    label en official "the established cash selling price of the property (section 453(l)(2)(C))";
}
pub relation total_contract_price_with_carrying_charges_453l2C(disposition: Integer, amount: Money) kind institutional {
    label en official "carrying charges or interest added on the books are included in the total contract price: cash selling price plus the charges (section 453(l)(2)(C))";
}
@source(IRC_S453_L, quote = "which are added on the books of account of the seller to the established cash selling price of the property shall be included in the total contract price of the property")
rule CarryingChargesIncludedInTotalContractPrice(disposition: Integer, price: Money, charges: Money) defeasible {
    label en official "price + charges when added on the books (section 453(l)(2)(C))";
    when carrying_charges_added_to_cash_selling_price_on_books_453l2C(disposition);
    when cash_selling_price_453l2C(disposition, price);
    when carrying_charges_or_interest_amount_453l2C(disposition, charges);
    then total_contract_price_with_carrying_charges_453l2C(disposition, price + charges);
}
pub relation payment_received_453l2C(disposition: Integer, amount: Money) kind empirical {
    label en official "a payment received on the disposition (section 453(l)(2)(C))";
}
pub relation payment_applied_first_against_carrying_charges_453l2C(disposition: Integer, applied: Money) kind institutional {
    label en official "if the charges are not added on the books, payments are applied first against carrying charges or interest: the lesser of the payment and the charges (section 453(l)(2)(C))";
}
@source(IRC_S453_L, quote = "if such charges or interest are not so included, any payments received shall be treated as applying first against such carrying charges or interest.")
rule PaymentsAppliedFirstAgainstCarryingCharges(disposition: Integer, paid: Money, charges: Money) defeasible {
    label en official "min(payment, charges) when the charges are not on the books (section 453(l)(2)(C))";
    when not_known(carrying_charges_added_to_cash_selling_price_on_books_453l2C(disposition));
    when payment_received_453l2C(disposition, paid);
    when carrying_charges_or_interest_amount_453l2C(disposition, charges);
    then payment_applied_first_against_carrying_charges_453l2C(disposition, min(paid, charges));
}
