// Accounting -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Placeholder relations of this package that name a norm owned by a lower package are derived from the owner's `pub` relation. The
// case-fact channel stays valid (WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.accounting version "0.1.1";
namespace "urn:us:irc:accounting:clir";

use self::{
    IRC_S444_C,
    IRC_S470_F,
    Person,
    TaxableYear,
    lease_term_years,
    section_7519_required_payment_owed,
};

// --- section 168(i)(3): lease term (owner: deductions, new module 96-wire10-B-deductions.law) ---------------------------------------

@source(IRC_S470_F, relation = formalizes, coverage = partial, quote = "The term \"lease term\" has the meaning given to such term by section 168(i)(3).")
rule W10LeaseTermFromDeductions(lease: Integer, years: Integer) strict {
    label en official "the lease term of section 470(f)(2) is the term under section 168(i)(3) that the deductions package derives";
    when us.irc.deductions::lease_term_years_168i3(lease, years);
    then lease_term_years(lease, years);
}

// --- section 7519: the required payment is owed (owner: administration; section 444(c)(1)) --------------------------------------

@source(IRC_S444_C, relation = formalizes, coverage = partial, quote = "such entity shall make the payments required by section 7519")
rule W10Section7519PaymentOwedFromAdministration strict {
    label en official "a section 444 electing entity for which the administration package finds section 7519 applicable (required payment above $500) owes the required payment";
    for filer: Person;
    for y: TaxableYear;
    when us.irc.administration::section_7519_applies(filer, y);
    then section_7519_required_payment_owed(filer, y);
}
