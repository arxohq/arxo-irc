// Sections 464, 473, 481(d), 472(d),(g), 471(b),(c)(3)-(4), 443(d)
// (stage 2c, IRC-07).
//
// 464: prepaid farm supplies of cash-method farmers: who is caught ((d)),
// excess prepaid farm supplies ((d)(3)(A)), year of deduction ((a),(c)),
// poultry ((b)), farming ((e)). 473: qualified LIFO liquidation, the election
// as a power, the replacement period, and the gross income adjustment ((b)).
// 481(d): six-year ratable spread for eligible terminated S corporations.
// 472(d): three-year averaging of the beginning-inventory revaluation. 471(b):
// shrinkage estimates. 443(d): alternative minimum tax annualization.
//
// Not modelled (TECH-GAPS G2128-G2131, coverage/accounting.json): the 473(c)(2)
// Federal Register determinations (external), 473(e) ordering of replacement
// goods, 473(f) limitation/interest cross-effects, 481(b)(2)-(3) allocation
// under the new method (needs the tax function), 472(g) controlled-group
// aggregation and 472(f) index regulations.

// ===================== Section 464 =====================

use self::{
    IRC_S443_D,
    IRC_S448_C,
    IRC_S448_D,
    IRC_S464_A,
    IRC_S464_B,
    IRC_S464_C,
    IRC_S464_D,
    IRC_S464_E,
    IRC_S471_B,
    IRC_S471_C,
    IRC_S472_D,
    IRC_S473_A,
    IRC_S473_B,
    IRC_S473_C,
    IRC_S473_D,
    IRC_S481_D,
    Person,
    TaxableYear,
    months_in_short_period,
    short_period_return_required,
    uses_accrual_method,
};

pub relation activity_is_cultivation_raising_or_harvesting_464e(activity: Integer) kind empirical {
    label en official "the activity is the cultivation of land or the raising or harvesting of an agricultural or horticultural commodity, including raising, shearing, feeding, caring for, training, and management of animals (section 464(e), first sentence)";
}
pub relation commodity_is_non_fruit_nut_trees_464e(activity: Integer) kind empirical {
    label en official "the commodity is trees other than trees bearing fruit or nuts, which are not an agricultural or horticultural commodity (section 464(e), second sentence)";
}
pub relation is_farming_464e(activity: Integer) kind institutional {
    label en official "farming within the meaning of section 464(e)";
}
@source(IRC_S464_E, quote = "the term \"farming\" means the cultivation of land or the raising or harvesting of any agricultural or horticultural commodity")
rule FarmingDefinition464e(activity: Integer) defeasible {
    label en official "cultivation or raising/harvesting of an agricultural or horticultural commodity is farming, except non-fruit non-nut trees (section 464(e))";
    when activity_is_cultivation_raising_or_harvesting_464e(activity);
    when not_known(commodity_is_non_fruit_nut_trees_464e(activity));
    then is_farming_464e(activity);
}
pub relation prepaid_farm_supplies_464(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts described in (a) or (b) that would be allowable for a subsequent taxable year under those rules (section 464(d)(3)(B))";
}
pub relation deductible_farming_expenses_other_than_prepaid_464(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts allowable as deductions (including depreciation and amortization) properly allocable to farming, other than prepaid farm supplies (section 464(d)(3)(C))";
}
pub relation excess_prepaid_farm_supplies(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "prepaid farm supplies in excess of 50 percent of deductible farming expenses other than prepaid supplies (section 464(d)(3)(A))";
}
@source(IRC_S464_D, quote = "The term \"excess prepaid farm supplies\" means the prepaid farm supplies for the taxable year to the extent the amount of such supplies exceeds 50 percent of the deductible farming expenses")
rule ExcessPrepaidFarmSuppliesComputation(p: Person, y: TaxableYear, prepaid: Money, expenses: Money) strict {
    label en official "excess = prepaid supplies - 50% of other deductible farming expenses, when positive (section 464(d)(3)(A))";
    when prepaid_farm_supplies_464(p, y, prepaid);
    when deductible_farming_expenses_other_than_prepaid_464(p, y, expenses);
    when prepaid > round(expenses * 0.5, 2, "HALF_UP");
    then excess_prepaid_farm_supplies(p, y, round(prepaid - round(expenses * 0.5, 2, "HALF_UP"), 2, "HALF_UP"));
}
pub relation principal_residence_on_farm_464(p: Person) kind empirical {
    label en official "the taxpayer's principal residence (section 121) is on a farm (section 464(d)(2)(B)(i))";
}
pub relation principal_occupation_is_farming_464(p: Person) kind empirical {
    label en official "the taxpayer has a principal occupation of farming (section 464(d)(2)(B)(ii))";
}
pub relation family_member_of_farm_related_taxpayer_464(p: Person) kind empirical {
    label en official "the taxpayer is a member of the family (section 461(k)(2)(E), via 267(c)(4)) of a taxpayer described in (B)(i) or (ii) (section 464(d)(2)(B)(iii))";
}
pub relation is_farm_related_taxpayer_464(p: Person) kind institutional {
    label en official "a farm-related taxpayer (section 464(d)(2)(B))";
}
rule FarmRelatedTaxpayerResidence(p: Person) defeasible {
    label en official "principal residence on a farm (section 464(d)(2)(B)(i))";
    when principal_residence_on_farm_464(p);
    then is_farm_related_taxpayer_464(p);
}
rule FarmRelatedTaxpayerOccupation(p: Person) defeasible {
    label en official "principal occupation of farming (section 464(d)(2)(B)(ii))";
    when principal_occupation_is_farming_464(p);
    then is_farm_related_taxpayer_464(p);
}
rule FarmRelatedTaxpayerFamily(p: Person) defeasible {
    label en official "family member of such a taxpayer (section 464(d)(2)(B)(iii))";
    when family_member_of_farm_related_taxpayer_464(p);
    then is_farm_related_taxpayer_464(p);
}
pub relation prepaid_farm_supplies_preceding_three_years(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate prepaid farm supplies for the 3 taxable years preceding the taxable year (section 464(d)(2)(A)(i)(I))";
}
pub relation deductible_farming_expenses_preceding_three_years(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate deductible farming expenses (other than prepaid farm supplies) for those 3 years (section 464(d)(2)(A)(i)(II))";
}
pub relation excess_by_extraordinary_circumstances_464(p: Person, y: TaxableYear) kind empirical {
    label en official "the excess prepaid farm supplies arise from a change in business operation directly attributable to extraordinary circumstances (section 464(d)(2)(A)(ii))";
}
pub relation is_qualified_farm_related_taxpayer_464(p: Person, y: TaxableYear) kind institutional {
    label en official "a qualified farm-related taxpayer: a farm-related taxpayer whose prior-3-year prepaid supplies were under 50 percent of prior-3-year deductible expenses, or whose excess arises from extraordinary circumstances (section 464(d)(2)(A))";
}
@source(IRC_S464_D, quote = "the aggregate prepaid farm supplies for the 3 taxable years preceding the taxable year are less than 50 percent of,")
rule QualifiedFarmRelatedByPriorThreeYears(p: Person, y: TaxableYear, prepaid: Money, expenses: Money) defeasible {
    label en official "farm-related and prior-3-year prepaid supplies below half of prior-3-year deductible expenses (section 464(d)(2)(A)(i))";
    when is_farm_related_taxpayer_464(p);
    when prepaid_farm_supplies_preceding_three_years(p, y, prepaid);
    when deductible_farming_expenses_preceding_three_years(p, y, expenses);
    when prepaid < round(expenses * 0.5, 2, "HALF_UP");
    then is_qualified_farm_related_taxpayer_464(p, y);
}
@source(IRC_S464_D, quote = "the taxpayer has excess prepaid farm supplies for the taxable year by reason of any change in business operation directly attributable to extraordinary circumstances.")
rule QualifiedFarmRelatedByExtraordinaryCircumstances(p: Person, y: TaxableYear) defeasible {
    label en official "farm-related and excess caused by extraordinary circumstances (section 464(d)(2)(A)(ii))";
    when is_farm_related_taxpayer_464(p);
    when excess_by_extraordinary_circumstances_464(p, y);
    then is_qualified_farm_related_taxpayer_464(p, y);
}
pub relation subsection_464d_applies_to_taxpayer(p: Person, y: TaxableYear) kind institutional {
    label en official "subsection (d) applies: the taxpayer does not use an accrual method, has excess prepaid farm supplies, and is not a qualified farm-related taxpayer (section 464(d)(1))";
}
@source(IRC_S464_D, quote = "This subsection applies to any taxpayer for any taxable year if such taxpayer—")
rule Section464dAppliesToTaxpayer(p: Person, y: TaxableYear, excess: Money) defeasible {
    label en official "non-accrual taxpayer with excess prepaid supplies that is not a qualified farm-related taxpayer (section 464(d)(1))";
    when excess_prepaid_farm_supplies(p, y, excess);
    when not_known(uses_accrual_method(p, y));
    when not_known(is_qualified_farm_related_taxpayer_464(p, y));
    then subsection_464d_applies_to_taxpayer(p, y);
}
pub relation farm_supplies_paid(p: Person, y_paid: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid for feed, seed, fertilizer, or other similar farm supplies (section 464(a))";
}
pub relation supplies_used_or_consumed_in_year(p: Person, y_used: TaxableYear, item: Integer) kind empirical {
    label en official "the supplies are actually used or consumed in the taxable year (section 464(a))";
}
pub relation supplies_on_hand_due_to_casualty_or_drought(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the supplies are on hand at the close of the year on account of fire, storm, or other casualty, or disease or drought (section 464(c))";
}
pub relation farm_supplies_deduction_allowed_year(p: Person, y_paid: TaxableYear, y_allowed: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "for a subsection (d) taxpayer, the deduction for farm supplies is allowed only for the year the supplies are used or consumed, or, if later, the year otherwise allowable (section 464(a)); the 'if later' branch uses the case-supplied year otherwise allowable";
}
@source(IRC_S464_A, quote = "shall only be allowed for the taxable year in which such feed, seed, fertilizer, or other supplies are actually used or consumed")
rule FarmSuppliesDeductedWhenUsed(p: Person, y_paid: TaxableYear, y_used: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "a caught taxpayer deducts farm supplies when used or consumed (section 464(a)); the (c) casualty exception removes the limit";
    when subsection_464d_applies_to_taxpayer(p, y_paid);
    when farm_supplies_paid(p, y_paid, item, amount);
    when supplies_used_or_consumed_in_year(p, y_used, item);
    when not_known(supplies_on_hand_due_to_casualty_or_drought(p, y_paid, item));
    then farm_supplies_deduction_allowed_year(p, y_paid, y_used, item, amount);
}
@source(IRC_S464_C, quote = "Subsection (a) shall not apply to any amount paid for supplies which are on hand at the close of the taxable year on account of fire, storm, or other casualty, or on account of disease or drought.")
rule FarmSuppliesCasualtyExceptionDeductibleInPaidYear(p: Person, y_paid: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "supplies on hand because of casualty or drought are deductible without the (a) limit, i.e. for the year otherwise allowable (section 464(c))";
    when farm_supplies_paid(p, y_paid, item, amount);
    when supplies_on_hand_due_to_casualty_or_drought(p, y_paid, item);
    then farm_supplies_deduction_allowed_year(p, y_paid, y_paid, item, amount);
}
pub relation poultry_cost_for_use_in_business(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the cost of poultry (including egg-laying hens and baby chicks) purchased for use in a trade or business, or for use and sale (section 464(b)(1))";
}
pub relation poultry_useful_life_months(item: Integer, months: Integer) kind empirical {
    label en official "the useful life of the poultry in the trade or business, in months (section 464(b)(1))";
}
pub relation poultry_ratable_monthly_deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the cost is capitalized and deducted ratably over the lesser of 12 months or the useful life: the monthly amount (section 464(b)(1)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S464_B, quote = "shall be capitalized and deducted ratably over the lesser of 12 months or their useful life in the trade or business")
rule PoultryCostDeductedRatably(p: Person, y: TaxableYear, item: Integer, cost: Money, life: Integer) defeasible {
    label en official "a caught taxpayer deducts poultry held for use monthly over min(12 months, useful life) (section 464(b)(1))";
    when subsection_464d_applies_to_taxpayer(p, y);
    when poultry_cost_for_use_in_business(p, y, item, cost);
    when poultry_useful_life_months(item, life);
    when life > 0;
    then poultry_ratable_monthly_deduction(p, y, item, div_round(cost, min(12.0, life * 1.0), 2, "HALF_UP"));
}
pub relation poultry_purchased_for_sale(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the cost of poultry purchased for sale (section 464(b)(2))";
}
pub relation poultry_sold_or_disposed_in_year(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the poultry is sold or otherwise disposed of in the taxable year (section 464(b)(2))";
}
pub relation poultry_sale_cost_deductible_in_year(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the cost of poultry purchased for sale is deducted in the year of sale or disposition (section 464(b)(2))";
}
@source(IRC_S464_B, quote = "the cost of poultry purchased for sale shall be deducted for the taxable year in which the poultry is sold or otherwise disposed of.")
rule PoultryForSaleDeductedOnSale(p: Person, y_paid: TaxableYear, y_sold: TaxableYear, item: Integer, cost: Money) defeasible {
    label en official "a caught taxpayer deducts poultry-for-sale cost when sold (section 464(b)(2))";
    when subsection_464d_applies_to_taxpayer(p, y_paid);
    when poultry_purchased_for_sale(p, y_paid, item, cost);
    when poultry_sold_or_disposed_in_year(p, y_sold, item);
    then poultry_sale_cost_deductible_in_year(p, y_sold, item, cost);
}

// ===================== Section 473 =====================

pub relation opening_inventory_of_goods(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the opening inventory of the goods for the liquidation year (section 473(c)(1)(A))";
}
pub relation closing_inventory_of_goods(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the closing inventory of the goods for the liquidation year (section 473(c)(1)(A))";
}
external judgment relation decrease_attributable_to_qualified_inventory_interruption(p: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the taxpayer establishes to the satisfaction of the Secretary that the decrease in closing inventory is directly and primarily attributable to a qualified inventory interruption (section 473(c)(1)(B)); interruptions are those in a Federal Register notice under (c)(2)(B)";
}
pub relation is_qualified_liquidation_473(p: Person, y: TaxableYear) kind institutional {
    label en official "a qualified liquidation: a decrease in closing inventory from opening inventory that is directly and primarily attributable to a qualified inventory interruption";
}
@source(IRC_S473_C, quote = "a decrease in the closing inventory of the liquidation year from the opening inventory of such year, but only if")
rule QualifiedLiquidationDefinition(p: Person, y: TaxableYear, opening: Money, closing: Money) defeasible {
    label en official "closing inventory below opening inventory plus the Secretary's attribution judgment (section 473(c)(1))";
    when opening_inventory_of_goods(p, y, opening);
    when closing_inventory_of_goods(p, y, closing);
    when closing < opening;
    when decrease_attributable_to_qualified_inventory_interruption(p, y);
    then is_qualified_liquidation_473(p, y);
}
pub relation elects_section_473(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects the application of section 473 for the liquidation year, in the manner the Secretary prescribes (section 473(a)(2), (d)(5)(A))";
}
pub relation section_473_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 473 election is in effect: irrevocable and binding for the liquidation year and for all related determinations in prior and subsequent years (section 473(d)(5)(B))";
}
@source(IRC_S473_A, quote = "(2) the taxpayer elects to have the provisions of this section apply with respect to such liquidation,")
rule Section473ElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a LIFO taxpayer may elect section 473 for a qualified liquidation year (section 473(a))";
    when elects_section_473(p, y);
    then power Section473LiquidationElection {
        holder p;
        over y;
        exercise elects_section_473(p, y);
        valid_when is_qualified_liquidation_473(p, y);
        effect create(section_473_election_in_effect(p, y));
        window [@1980-01-01, infinity);
    };
}
pub relation notice_specified_replacement_period_years(p: Person, y: TaxableYear, years: Integer) kind empirical {
    label en official "the period, in taxable years, specified by the Secretary in a Federal Register notice for the interruption (section 473(d)(3)(B))";
}
pub relation has_notice_specified_replacement_period(p: Person, y: TaxableYear) kind institutional {
    label en official "bridge for the absence of a notice-specified period";
}
rule NoticeSpecifiedPeriodBridge(p: Person, y: TaxableYear) defeasible {
    label en official "a notice-specified period exists";
    when notice_specified_replacement_period_years(p, y, _);
    then has_notice_specified_replacement_period(p, y);
}
pub relation replacement_period_years(p: Person, y_liquidation: TaxableYear, years: Integer) kind institutional {
    label en official "the replacement period in taxable years: the shorter of the 3 taxable years following the liquidation year and the period specified by the Secretary's notice (section 473(d)(3))";
}
@source(IRC_S473_D, quote = "the period of the 3 taxable years following the liquidation year, or")
rule ReplacementPeriodThreeYearsWithoutNotice(p: Person, y: TaxableYear) defeasible {
    label en official "absent a notice, the replacement period is 3 taxable years (section 473(d)(3)(A))";
    when section_473_election_in_effect(p, y);
    when not_known(has_notice_specified_replacement_period(p, y));
    then replacement_period_years(p, y, 3);
}
rule ReplacementPeriodShorterOfThreeAndNotice(p: Person, y: TaxableYear, n: Integer) defeasible {
    label en official "with a notice, the replacement period is the shorter of 3 years and the noticed period (section 473(d)(3))";
    when section_473_election_in_effect(p, y);
    when notice_specified_replacement_period_years(p, y, n);
    then replacement_period_years(p, y, min(3, n));
}
pub relation aggregate_replacement_cost_of_goods_replaced(p: Person, y_liquidation: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate replacement cost of the liquidated goods replaced during the replacement year (section 473(b)(1)(A))";
}
pub relation aggregate_opening_inventory_cost_of_goods_replaced(p: Person, y_liquidation: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate cost of those goods reflected in the opening inventory of the liquidation year (section 473(b)(1)(B), (2)(A))";
}
pub relation liquidation_year_income_decrease_473b1(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the decrease in gross income for the liquidation year: replacement cost in excess of opening-inventory cost (section 473(b)(1))";
}
@source(IRC_S473_B, quote = "(1) decreased by an amount equal to the excess of—")
rule LiquidationYearIncomeDecrease(p: Person, y: TaxableYear, replacement: Money, opening: Money) defeasible {
    label en official "when replacement cost exceeds the opening-inventory cost, gross income for the liquidation year is decreased by the excess (section 473(b)(1))";
    when section_473_election_in_effect(p, y);
    when aggregate_replacement_cost_of_goods_replaced(p, y, replacement);
    when aggregate_opening_inventory_cost_of_goods_replaced(p, y, opening);
    when replacement > opening;
    then liquidation_year_income_decrease_473b1(p, y, round(replacement - opening, 2, "HALF_UP"));
}
pub relation liquidation_year_income_increase_473b2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in gross income for the liquidation year: opening-inventory cost in excess of replacement cost (section 473(b)(2))";
}
@source(IRC_S473_B, quote = "(2) increased by an amount equal to the excess of—")
rule LiquidationYearIncomeIncrease(p: Person, y: TaxableYear, replacement: Money, opening: Money) defeasible {
    label en official "when opening-inventory cost exceeds replacement cost, gross income for the liquidation year is increased by the excess (section 473(b)(2))";
    when section_473_election_in_effect(p, y);
    when aggregate_replacement_cost_of_goods_replaced(p, y, replacement);
    when aggregate_opening_inventory_cost_of_goods_replaced(p, y, opening);
    when opening > replacement;
    then liquidation_year_income_increase_473b2(p, y, round(opening - replacement, 2, "HALF_UP"));
}

// ===================== Section 481(d) =====================

pub relation was_s_corporation_on_day_before_tcja_enactment(p: Person) kind empirical {
    label en official "the corporation was an S corporation on the day before the enactment of the Tax Cuts and Jobs Act (2017-12-21) (section 481(d)(2)(A)(i))";
}
pub relation s_election_revoked_on(p: Person, d: Date) kind empirical {
    label en official "the date the corporation revokes its section 1362(a) election (section 481(d)(2)(A)(ii))";
}
pub relation same_owners_in_identical_proportions_as_at_enactment(p: Person) kind empirical {
    label en official "on the date of revocation the stock owners are the same, in identical proportions, as on the date of enactment (section 481(d)(2)(B))";
}
pub relation is_eligible_terminated_s_corporation(p: Person) kind institutional {
    label en official "an eligible terminated S corporation: an S corporation on 2017-12-21 that revoked its election within the 2-year period beginning 2017-12-22, with unchanged ownership";
}
@source(IRC_S481_D, quote = "the term \"eligible terminated S corporation\" means any C corporation—")
rule EligibleTerminatedSCorporationDefinition(p: Person, revoked: Date) defeasible {
    label en official "S corporation before TCJA, revoked within 2 years of enactment, same owners (section 481(d)(2))";
    when was_s_corporation_on_day_before_tcja_enactment(p);
    when s_election_revoked_on(p, revoked);
    when same_owners_in_identical_proportions_as_at_enactment(p);
    when revoked >= @2017-12-22;
    when revoked <= add_calendar_period(@2017-12-22, 2 calendar_year);
    then is_eligible_terminated_s_corporation(p);
}
pub relation adjustment_attributable_to_s_revocation_481d(p: Person, y_change: TaxableYear, amount: Money) kind empirical {
    label en official "the section 481(a)(2) adjustment attributable to the revocation (section 481(d)(1))";
}
pub relation s_revocation_adjustment_annual_amount_481d(p: Person, y_change: TaxableYear, per_year: Money) kind institutional {
    label en official "the ratable annual amount taken into account over the 6-taxable year period beginning with the year of change (section 481(d)(1)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S481_D, quote = "shall be taken into account ratably during the 6-taxable year period beginning with the year of change.")
rule SRevocationAdjustmentSixYearRatable(p: Person, y: TaxableYear, adjustment: Money) defeasible {
    label en official "an eligible terminated S corporation takes the revocation adjustment in six equal annual amounts (section 481(d)(1))";
    when is_eligible_terminated_s_corporation(p);
    when adjustment_attributable_to_s_revocation_481d(p, y, adjustment);
    then s_revocation_adjustment_annual_amount_481d(p, y, div_round(adjustment, 6.0, 2, "HALF_UP"));
}

// ===================== Sections 472(d), 471(b), (c)(3)-(4), 443(d) =====================

pub relation beginning_inventory_valued_at_cost_change(p: Person, y_first: TaxableYear, amount: Money) kind empirical {
    label en official "the change in the inventory amount resulting from valuing the beginning inventory of the first LIFO year at cost (section 472(d)); positive for an increase";
}
pub relation lifo_revaluation_taken_into_account_per_year(p: Person, y_first: TaxableYear, per_year: Money) kind institutional {
    label en official "the change is taken into account ratably in each of the 3 taxable years beginning with the first LIFO year (section 472(d)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S472_D, quote = "shall be taken into account ratably in each of the 3 taxable years beginning with the first taxable year for which the method described in subsection (b) is first used.")
rule LifoRevaluationThreeYearAveraging(p: Person, y: TaxableYear, change: Money) defeasible {
    label en official "one third of the beginning-inventory revaluation in each of three years (section 472(d))";
    when beginning_inventory_valued_at_cost_change(p, y, change);
    then lifo_revaluation_taken_into_account_per_year(p, y, div_round(change, 3.0, 2, "HALF_UP"));
}
pub relation estimates_of_shrinkage_confirmed_after_year_end(p: Person, y: TaxableYear) kind empirical {
    label en official "the method uses estimates of inventory shrinkage that are confirmed by a physical count only after the last day of the taxable year (section 471(b))";
}
pub relation regular_consistent_physical_count_at_each_location(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer normally does a physical count of inventories at each location on a regular and consistent basis (section 471(b)(1))";
}
pub relation proper_adjustments_to_inventories_and_estimating_methods(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer makes proper adjustments to inventories and estimating methods where estimates differ from actual shrinkage (section 471(b)(2))";
}
pub relation shrinkage_estimates_do_not_alone_defeat_clear_reflection(p: Person, y: TaxableYear) kind institutional {
    label en official "the method is not treated as failing to clearly reflect income solely because it uses shrinkage estimates confirmed after year end (section 471(b))";
}
@source(IRC_S471_B, quote = "A method of determining inventories shall not be treated as failing to clearly reflect income solely because it utilizes estimates of inventory shrinkage")
rule ShrinkageEstimatesSafeHarbor(p: Person, y: TaxableYear) defeasible {
    label en official "shrinkage estimates confirmed after year end are permitted where counts are regular and adjustments are made (section 471(b))";
    when estimates_of_shrinkage_confirmed_after_year_end(p, y);
    when regular_consistent_physical_count_at_each_location(p, y);
    when proper_adjustments_to_inventories_and_estimating_methods(p, y);
    then shrinkage_estimates_do_not_alone_defeat_clear_reflection(p, y);
}
pub relation change_in_method_made_pursuant_to_471c(p: Person, y: TaxableYear) kind empirical {
    label en official "a change in method of accounting made pursuant to section 471(c)";
}
pub relation section_471c_change_taxpayer_initiated_with_consent(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 471(c) change is treated for section 481 as initiated by the taxpayer and made with the Secretary's consent (section 471(c)(4))";
}
@source(IRC_S471_C, quote = "Any change in method of accounting made pursuant to this subsection shall be treated for purposes of section 481 as initiated by the taxpayer and made with the consent of the Secretary.")
rule Section471cChangeInitiatedWithConsent(p: Person, y: TaxableYear) defeasible {
    label en official "a section 471(c) method change is taxpayer-initiated and consented (section 471(c)(4))";
    when change_in_method_made_pursuant_to_471c(p, y);
    then section_471c_change_taxpayer_initiated_with_consent(p, y);
}
pub relation alternative_minimum_taxable_income_for_short_period(p: Person, y_short: TaxableYear, amount: Money) kind empirical {
    label en official "the alternative minimum taxable income for the short period (section 443(d)(1))";
}
pub relation annualized_amti_443d1(p: Person, y_short: TaxableYear, amount: Money) kind institutional {
    label en official "AMTI placed on an annual basis: multiplied by 12 and divided by the months in the short period (section 443(d)(1))";
}
@source(IRC_S443_D, quote = "the alternative minimum taxable income for the short period shall be placed on an annual basis by multiplying such amount by 12 and dividing the result by the number of months in the short period, and")
rule AnnualizeAlternativeMinimumTaxableIncome(p: Person, y_short: TaxableYear, amti: Money, months: Integer) strict {
    label en official "annualized AMTI = AMTI x 12 / months in the short period (section 443(d)(1)); one rounding to cents HALF_UP (JUDGMENT CALL)";
    when short_period_return_required(p, y_short);
    when alternative_minimum_taxable_income_for_short_period(p, y_short, amti);
    when months_in_short_period(y_short, months);
    when months > 0;
    then annualized_amti_443d1(p, y_short, div_round(amti * 12, months * 1.0, 2, "HALF_UP"));
}
pub relation tentative_minimum_tax_on_annual_basis_443d(p: Person, y_short: TaxableYear, amount: Money) kind empirical {
    label en official "the amount computed under section 55(a)(1) on the annualized basis — the section 55 computation belongs to the income-individual owner (EXTERNAL_DEPENDENCY)";
}
pub relation short_period_minimum_tax_443d2(p: Person, y_short: TaxableYear, amount: Money) kind institutional {
    label en official "the short-period minimum tax: the annual-basis amount times the months in the short period over 12 (section 443(d)(2))";
}
@source(IRC_S443_D, quote = "the amount computed under paragraph (1) of section 55(a) shall bear the same relation to the tax computed on the annual basis as the number of months in the short period bears to 12.")
rule ShortPeriodMinimumTaxProrated(p: Person, y_short: TaxableYear, annual_tax: Money, months: Integer) strict {
    label en official "short-period minimum tax = annual-basis tax x months / 12 (section 443(d)(2)); one rounding to cents HALF_UP (JUDGMENT CALL)";
    when short_period_return_required(p, y_short);
    when tentative_minimum_tax_on_annual_basis_443d(p, y_short, annual_tax);
    when months_in_short_period(y_short, months);
    then short_period_minimum_tax_443d2(p, y_short, div_round(annual_tax * months, 12.0, 2, "HALF_UP"));
}

// ===================== Section 448 residual: (c)(3) gross receipts adjustments, (d)(7) =====================

pub relation gross_receipts_before_returns_and_allowances(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross receipts for the taxable year before returns and allowances (section 448(c)(3)(C))";
}
pub relation returns_and_allowances_during_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "returns and allowances made during the taxable year (section 448(c)(3)(C))";
}
pub relation gross_receipts_net_of_returns_448c3C(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross receipts for a taxable year reduced by returns and allowances made during the year (section 448(c)(3)(C))";
}
@source(IRC_S448_C, quote = "Gross receipts for any taxable year shall be reduced by returns and allowances made during such year.")
rule GrossReceiptsReducedByReturnsAndAllowances(p: Person, y: TaxableYear, gross: Money, returns: Money) strict {
    label en official "net gross receipts = gross receipts - returns and allowances (section 448(c)(3)(C))";
    when gross_receipts_before_returns_and_allowances(p, y, gross);
    when returns_and_allowances_during_year(p, y, returns);
    then gross_receipts_net_of_returns_448c3C(p, y, round(gross - returns, 2, "HALF_UP"));
}
pub relation gross_receipts_of_short_year(p: Person, y_short: TaxableYear, amount: Money) kind empirical {
    label en official "gross receipts for a taxable year of less than 12 months (section 448(c)(3)(B))";
}
pub relation annualized_gross_receipts_448c3B(p: Person, y_short: TaxableYear, amount: Money) kind institutional {
    label en official "gross receipts of a short taxable year annualized: multiplied by 12 and divided by the number of months in the short period (section 448(c)(3)(B)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S448_C, quote = "Gross receipts for any taxable year of less than 12 months shall be annualized by multiplying the gross receipts for the short period by 12 and dividing the result by the number of months in the short period.")
rule AnnualizeShortYearGrossReceipts(p: Person, y_short: TaxableYear, receipts: Money, months: Integer) strict {
    label en official "short-year gross receipts x 12 / months (section 448(c)(3)(B))";
    when gross_receipts_of_short_year(p, y_short, receipts);
    when months_in_short_period(y_short, months);
    when months > 0;
    then annualized_gross_receipts_448c3B(p, y_short, div_round(receipts * 12, months * 1.0, 2, "HALF_UP"));
}
pub relation gross_receipts_total_for_period_in_existence(p: Person, y: TaxableYear, amount: Money, years_in_existence: Integer) kind empirical {
    label en official "total gross receipts for the part of the 3-taxable-year period during which the entity was in existence, and the number of taxable years in that part (section 448(c)(3)(A))";
}
pub relation average_gross_receipts_for_period_in_existence_448c3A(p: Person, y: TaxableYear, avg: Money) kind institutional {
    label en official "where the entity was not in existence for all 3 years, paragraph (1) is applied on the basis of the period it was in existence: the average over those years (section 448(c)(3)(A)); one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S448_C, quote = "If the entity was not in existence for the entire 3-year period referred to in paragraph (1), such paragraph shall be applied on the basis of the period during which such entity (or trade or business) was in existence.")
rule AverageOverPeriodInExistence(p: Person, y: TaxableYear, total: Money, n: Integer) strict {
    label en official "average = total receipts / years in existence (section 448(c)(3)(A))";
    when gross_receipts_total_for_period_in_existence(p, y, total, n);
    when n > 0;
    when n < 3;
    then average_gross_receipts_for_period_in_existence_448c3A(p, y, div_round(total, n * 1.0, 2, "HALF_UP"));
}
pub relation change_in_method_made_pursuant_to_448(p: Person, y: TaxableYear) kind empirical {
    label en official "a change in method of accounting made pursuant to section 448 (section 448(d)(7))";
}
pub relation section_448_change_taxpayer_initiated_with_consent(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 448 change is treated for section 481 as initiated by the taxpayer and made with the Secretary's consent (section 448(d)(7))";
}
@source(IRC_S448_D, quote = "Any change in method of accounting made pursuant to this section shall be treated for purposes of section 481 as initiated by the taxpayer and made with the consent of the Secretary.")
rule Section448dChangeInitiatedWithConsent(p: Person, y: TaxableYear) defeasible {
    label en official "a section 448 method change is taxpayer-initiated and consented (section 448(d)(7))";
    when change_in_method_made_pursuant_to_448(p, y);
    then section_448_change_taxpayer_initiated_with_consent(p, y);
}
