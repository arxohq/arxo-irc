// Section 461 — General rule for taxable year of deduction. Stage 1b
// (IRC-07), priority section. Scope: (a) general rule; (c) real-property-tax
// ratable-accrual election as a power; (g) prepaid interest; (h) economic
// performance with the recurring-item 8½-month exception; (i) tax-shelter
// carve-out from the recurring-item exception; (l) excess-business-loss
// limitation with the $250,000/$500,000 thresholds. (b) death rule, (d)
// acceleration-of-taxes limitation, (e) mutual-savings-bank interest, (f)
// contested liabilities, (j) excess farm losses, (k) farming syndicate
// definitions are NOT DONE this round.

use self::{
    IRC_S461_A,
    IRC_S461_C,
    IRC_S461_G,
    IRC_S461_H,
    IRC_S461_L,
    Person,
    TaxableYear,
    business_deductions_for_ebl,
    business_income_for_ebl,
    economic_performance_established_461h,
    recurring_exception_unavailable_461h3C,
    tax_shelter_recurring_exception_disregarded,
};

pub relation deduction_or_credit_item(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount of deduction or credit allowed by this subtitle, asserted for the taxable year the taxpayer's records place it in (section 461(a))";
}
pub relation proper_taxable_year_under_method(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxable year is the proper taxable year for the item under the method of accounting used in computing taxable income (section 461(a))";
}
pub relation deduction_taken_in_year(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the deduction or credit is taken for the taxable year (section 461(a))";
}
@source(IRC_S461_A, quote = "The amount of any deduction or credit allowed by this subtitle shall be taken for the taxable year which is the proper taxable year under the method of accounting used in computing taxable income.")
rule DeductionTakenInProperYear(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "a deduction or credit is taken for the taxable year that is the proper year under the taxpayer's method of accounting (section 461(a))";
    when deduction_or_credit_item(p, y, item, amount);
    when proper_taxable_year_under_method(p, y, item);
    then deduction_taken_in_year(p, y, item, amount);
}

// --- (c): real-property-tax ratable-accrual election, as a power ---

pub relation incurs_real_property_tax_related_to_definite_period(p: Person, y: TaxableYear, tax_item: Integer) kind empirical {
    label en official "the taxpayer incurs a real property tax related to a definite period of time (section 461(c)(1))";
}
pub relation elects_ratable_accrual_of_real_property_tax(p: Person, tax_item: Integer) kind empirical {
    label en official "the taxpayer elects to accrue a real property tax ratably over the related period (section 461(c)(1))";
}
pub relation is_first_taxable_year_incurring_real_property_taxes(p: Person, y: TaxableYear) kind empirical {
    label en official "y is the taxpayer's first taxable year in which it incurs real property taxes (section 461(c)(2)(A))";
}
pub relation election_made_by_return_due_date_461c(p: Person, y: TaxableYear, tax_item: Integer) kind empirical {
    label en official "the section 461(c) election is made not later than the time prescribed for filing the return for the year (including extensions) (section 461(c)(2)(A))";
}
pub relation secretary_consents_to_461c_election(p: Person, tax_item: Integer) kind empirical {
    label en official "the Secretary consents to a section 461(c) election made at a time other than the first-year window (section 461(c)(2)(B))";
}
pub relation real_property_tax_accrued_ratably(p: Person, tax_item: Integer) kind institutional {
    label en official "the real property tax is accrued ratably over its related period (section 461(c)(1))";
}
@source(IRC_S461_C, quote = "at the election of the taxpayer, any real property tax which is related to a definite period of time shall be accrued ratably over that period")
rule Section461CElectionWithoutConsentPower(p: Person, y: TaxableYear, tax_item: Integer) strict {
    label en official "without the Secretary's consent, a taxpayer may elect ratable accrual for its first taxable year incurring real property taxes, timely made (section 461(c)(2)(A))";
    when incurs_real_property_tax_related_to_definite_period(p, y, tax_item);
    when is_first_taxable_year_incurring_real_property_taxes(p, y);
    then power Section461CElectionWithoutConsent {
        holder p;
        over tax_item;
        exercise elects_ratable_accrual_of_real_property_tax(p, tax_item);
        valid_when election_made_by_return_due_date_461c(p, y, tax_item);
        effect create(real_property_tax_accrued_ratably(p, tax_item));
        window [@1954-08-16, infinity);
    };
}
@source(IRC_S461_C, quote = "A taxpayer may, with the consent of the Secretary, make an election under this subsection at any time.")
rule Section461CElectionWithConsentPower(p: Person, y: TaxableYear, tax_item: Integer) strict {
    label en official "with the Secretary's consent, a taxpayer may elect ratable accrual at any time (section 461(c)(2)(B))";
    when incurs_real_property_tax_related_to_definite_period(p, y, tax_item);
    then power Section461CElectionWithConsent {
        holder p;
        over tax_item;
        exercise elects_ratable_accrual_of_real_property_tax(p, tax_item);
        valid_when secretary_consents_to_461c_election(p, tax_item);
        effect create(real_property_tax_accrued_ratably(p, tax_item));
        window [@1954-08-16, infinity);
    };
}

// --- (g): prepaid interest ---

pub relation interest_paid_allocable_to_future_period(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest paid by a cash-method taxpayer, properly allocable under regulations to a period after the close of the taxable year in which paid, representing a charge for the use or forbearance of money (section 461(g)(1))";
}
pub relation is_excepted_residence_points_payment(p: Person, item: Integer) kind empirical {
    label en official "the payment is points paid on indebtedness to purchase or improve the taxpayer's principal residence, within the section 461(g)(2) established-business-practice exception";
}
pub relation prepaid_interest_capitalized(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the prepaid interest is charged to capital account and treated as paid in the period to which it is allocable, not the year paid (section 461(g)(1))";
}
@source(IRC_S461_G, quote = "shall be charged to capital account and shall be treated as paid in the period to which so allocable")
rule PrepaidInterestCapitalized(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "a cash-method taxpayer's prepaid interest allocable to a future period is capitalized and treated as paid in that period, unless the residence-points exception applies (section 461(g))";
    when interest_paid_allocable_to_future_period(p, y, item, amount);
    when not is_excepted_residence_points_payment(p, item);
    then prepaid_interest_capitalized(p, y, item, amount);
}

// --- (h): economic performance, with the recurring-item exception ---

pub relation all_events_test_met_461h(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "all events have occurred which determine the fact of liability and the amount can be determined with reasonable accuracy (section 461(h)(4)) — case-asserted (the reasonable-accuracy judgment is not re-derived here; see section 451(b)'s parallel evaluative channel for the pattern)";
}
pub relation economic_performance_occurs_in_year(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "economic performance with respect to the item occurs during the taxable year, under the section 461(h)(2) principles (service/property/tort timing) — case-asserted per (h)(2)'s branching rules, not separately modelled";
}
pub relation liability_incurred_in_year(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the amount has been incurred with respect to the item during the taxable year (section 461(h)(1)): the all-events test AND economic performance, or the recurring-item exception";
}
@source(IRC_S461_H, quote = "the all events test shall not be treated as met any earlier than when economic performance with respect to such item occurs")
rule LiabilityIncurredWhenEconomicPerformanceOccurs(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a liability is incurred no earlier than when both the all-events test is met and economic performance occurs, in the same taxable year (section 461(h)(1))";
    when all_events_test_met_461h(p, y, item);
    when economic_performance_established_461h(p, y, item);
    then liability_incurred_in_year(p, y, item);
}

// Recurring-item exception (h)(3): (i) all-events test met in y; (ii)
// economic performance within the SHORTER of a reasonable period or 8½
// months after the close of y; (iii) recurring + consistent treatment; (iv)
// not material, or a better income match. The exact 8½-month boundary DATE
// computation is not built (TECH_GAP: `add_calendar_period`'s step must be a
// literal whole unit, and 8½ months is not a supported literal step) — the
// boundary test itself is taken as an asserted case fact, letting a scenario
// exercise "within" vs "at/over" the boundary directly.
pub relation economic_performance_within_shorter_of_reasonable_period_or_8_5_months(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "economic performance occurs within the shorter of a reasonable period after the close of y, or 8½ months after the close of y (section 461(h)(3)(A)(ii))";
}
pub relation item_recurring_and_consistently_treated(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is recurring in nature and the taxpayer consistently treats items of this kind as incurred in the year the all-events test is met (section 461(h)(3)(A)(iii))";
}
pub relation item_not_material(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is not a material item (section 461(h)(3)(A)(iv)(I))";
}
// "results in a more proper match against income" — a comparative accounting
// judgment; the text names no administrative authority for it, so this is
// the general adjudicative default (Court), as with section 451(b)'s
// reasonable-accuracy channel.
external judgment relation accrual_in_all_events_year_is_better_income_match(p: Person, y: TaxableYear, item: Integer) {
    authority Court;
    label en official "accruing the item in the taxable year the all-events test is met results in a more proper match against income than accruing it in the year of economic performance (section 461(h)(3)(A)(iv)(II))";
}
pub relation is_tax_shelter_461i(p: Person) kind empirical {
    label en official "the taxpayer is a tax shelter within the meaning of section 461(i)(3) (case-asserted; the enterprise/syndicate/section 6662(d)(2)(C)(ii) tests are not separately formalized this round)";
}
@source(IRC_S461_H, quote = "an item shall be treated as incurred during any taxable year if")
rule RecurringItemExceptionAppliesNotMaterial(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "the recurring-item exception treats an item as incurred in the all-events-test year when performance follows within the 8½-month/reasonable-period window, the item recurs, and it is not material — unless the taxpayer is a tax shelter (section 461(h)(3), (i)(1))";
    when all_events_test_met_461h(p, y, item);
    when economic_performance_within_shorter_of_reasonable_period_or_8_5_months(p, y, item);
    when item_recurring_and_consistently_treated(p, y, item);
    when item_not_material(p, y, item);
    when not is_tax_shelter_461i(p);
    unless recurring_exception_unavailable_461h3C(p, y, item);
    unless tax_shelter_recurring_exception_disregarded(p, y, item);
    then liability_incurred_in_year(p, y, item);
}
rule RecurringItemExceptionAppliesBetterMatch(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "the recurring-item exception also applies when accrual in the all-events year is a better income match, per the Court's judgment — unless the taxpayer is a tax shelter (section 461(h)(3)(A)(iv)(II), (i)(1))";
    when all_events_test_met_461h(p, y, item);
    when economic_performance_within_shorter_of_reasonable_period_or_8_5_months(p, y, item);
    when item_recurring_and_consistently_treated(p, y, item);
    when accrual_in_all_events_year_is_better_income_match(p, y, item);
    when not is_tax_shelter_461i(p);
    unless recurring_exception_unavailable_461h3C(p, y, item);
    unless tax_shelter_recurring_exception_disregarded(p, y, item);
    then liability_incurred_in_year(p, y, item);
}

// --- (l): limitation on excess business losses of noncorporate taxpayers ---

pub relation is_corporation_taxpayer(p: Person) kind empirical {
    label en official "the taxpayer is a corporation (section 461(l) applies only to a taxpayer OTHER than a corporation)";
}
pub relation aggregate_business_deductions_461l(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate deductions attributable to the taxpayer's trades or businesses for the year, determined without regard to (l)(1)'s own disallowance and without regard to sections 172/199A (section 461(l)(3)(A)(i))";
}
pub relation aggregate_business_income_or_gain_461l(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate gross income or gain attributable to the taxpayer's trades or businesses for the year (section 461(l)(3)(A)(ii)(I)) — SIMPLIFICATION: the (B) capital-gain/loss carve-outs are not separately computed; the case supplies this amount already net of them";
}
pub relation files_joint_return_461l(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer files a joint return for the taxable year, doubling the section 461(l)(3)(A)(ii)(II) threshold";
}
pub relation excess_business_loss_threshold(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 461(l)(3)(A)(ii)(II) threshold: $250,000, or $500,000 (200 percent) on a joint return, subject to the (l)(3)(C) cost-of-living adjustment (statutory base only; the published adjusted amount for a given year is a pending dependency — see accounting.deps.json)";
}
rule ExcessBusinessLossThresholdSingle(p: Person, y: TaxableYear) defeasible {
    label en official "the threshold is the statutory base amount absent a joint return (section 461(l)(3)(A)(ii)(II))";
    when us.irc.core::year_of(p, y);
    when not files_joint_return_461l(p, y);
    then excess_business_loss_threshold(p, y, round(ExcessBusinessLossBaseAmount, 2, "HALF_UP"));
}
rule ExcessBusinessLossThresholdJoint(p: Person, y: TaxableYear) defeasible {
    label en official "the threshold is 200 percent of the statutory base amount on a joint return (section 461(l)(3)(A)(ii)(II))";
    when us.irc.core::year_of(p, y);
    when files_joint_return_461l(p, y);
    then excess_business_loss_threshold(p, y, round(ExcessBusinessLossBaseAmount * 2.0, 2, "HALF_UP"));
}
pub relation excess_business_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of aggregate business deductions over the sum of aggregate business income/gain plus the threshold (section 461(l)(3)(A)), zero if not positive";
}
@source(IRC_S461_L, quote = "The term \"excess business loss\" means the excess (if any) of")
rule ExcessBusinessLossComputation(p: Person, y: TaxableYear, deductions: Money, income: Money, threshold: Money) defeasible {
    label en official "the excess business loss is the aggregate business deductions minus (aggregate business income/gain plus the threshold), floored at zero (section 461(l)(3)(A))";
    when business_deductions_for_ebl(p, y, deductions);
    when business_income_for_ebl(p, y, income);
    when excess_business_loss_threshold(p, y, threshold);
    then excess_business_loss(p, y, max(0.00 USD, deductions - (income + threshold)));
}
pub relation excess_business_loss_disallowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess business loss is disallowed for the taxable year (section 461(l)(1)(B))";
}
// PINNED-TEXT WINDOW: the 2024 Edition text sunsets (l)(1)(B) for years
// beginning on/after January 1, 2026. Pub. L. 119-21 is reported to have
// made this limitation PERMANENT (removed the sunset); that amendment's text
// is not in the pinned 2024 Edition and is not carried into a `revision`
// here — recorded as SOURCE_GAP (accounting.deps.json), not silently applied
// or silently ignored. Scenarios in this window use taxable years beginning
// in 2021-2025 so the pinned rule's own boundary is exercised without
// depending on the unresolved amendment.
@source(IRC_S461_L, quote = "for any taxable year beginning after December 31, 2020, and before January 1, 2026, any excess business loss of the taxpayer for the taxable year shall not be allowed")
rule ExcessBusinessLossDisallowedInWindow(p: Person, y: TaxableYear, amount: Money, begins_on: Date) defeasible {
    label en official "a noncorporate taxpayer's excess business loss for a taxable year beginning after December 31, 2020 and before January 1, 2026 is disallowed (section 461(l)(1)(B), pinned-text window)";
    when not is_corporation_taxpayer(p);
    when excess_business_loss(p, y, amount);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2020-12-31;
    when begins_on < @2026-01-01;
    then excess_business_loss_disallowed(p, y, amount);
}
pub relation excess_business_loss_carried_as_nol(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the disallowed excess business loss is treated as a net operating loss for the year, for purposes of the section 172(b) NOL carryover (section 461(l)(2))";
}
@source(IRC_S461_L, quote = "Any loss which is disallowed under paragraph (1) shall be treated as a net operating loss for the taxable year for purposes of determining any net operating loss carryover under section 172(b) for subsequent taxable years.")
rule ExcessBusinessLossCarriedAsNol(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the disallowed excess business loss is treated as an NOL for section 172(b) carryover purposes (section 461(l)(2))";
    when excess_business_loss_disallowed(p, y, amount);
    then excess_business_loss_carried_as_nol(p, y, amount);
}

// (b) death rule, (d) acceleration-of-taxes limitation, (e) mutual-savings-
// bank interest, (f) contested liabilities, (j) excess farm losses, (k)
// farming syndicate definitions are NOT DONE this round.
