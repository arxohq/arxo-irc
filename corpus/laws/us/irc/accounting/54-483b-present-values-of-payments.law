}

pub relation present_value_of_payments_derived_483(seller: Person, buyer: Person, contract: Integer, amount: Money) kind institutional {
    label en official "the sum of the present values of the payments and of any interest payments due under the contract (section 483(b)(2)); alternative to the asserted `present_value_of_payments_483` (never both)";
}
@source(IRC_S483_B, quote = "(2) the sum of the present values of such payments and the present values of any interest payments due under the contract.")
rule PresentValueOfPaymentsFromSlots(seller: Person, buyer: Person, contract: Integer, y: TaxableYear, pvp: Money, pvi: Money) defeasible {
    label en official "PV of the payments + PV of the interest payments (section 483(b)(2))";
    when deferred_payment_sale_or_exchange_483(seller, buyer, contract, y);
    when payment_pv_sum_total(contract, pvp);
    when interest_pv_sum_total(contract, pvi);
    then present_value_of_payments_derived_483(seller, buyer, contract, pvp + pvi);
}
rule PresentValueOfPaymentsFromSlotsWithoutInterestPayments(seller: Person, buyer: Person, contract: Integer, y: TaxableYear, pvp: Money) defeasible {
    label en official "no interest payment slot: the present values of the payments alone";
    when deferred_payment_sale_or_exchange_483(seller, buyer, contract, y);
    when payment_pv_sum_total(contract, pvp);
    when not_known(contract_has_interest_payment_slot_483(contract));
    then present_value_of_payments_derived_483(seller, buyer, contract, pvp);
}
pub relation contract_has_interest_payment_slot_483(contract: Integer) kind institutional {
    label en official "the contract has at least one interest payment slot";
}
rule ContractHasInterestPaymentSlot(contract: Integer, slot: Integer, due_on: Date, amount: Money) defeasible {
    label en official "an interest payment slot exists";
    when contract_interest_payment_slot_483(contract, slot, due_on, amount);
    then contract_has_interest_payment_slot_483(contract);
}
pub relation payments_due_derived_483(seller: Person, buyer: Person, contract: Integer, amount: Money) kind institutional {
    label en official "the sum of the payments to which section 483 applies which are due under the contract (section 483(b)(1)); alternative to the asserted `payments_due_under_contract_483` (never both)";
}
@source(IRC_S483_B, quote = "an amount equal to the excess of")
rule PaymentsDueFromSlots(seller: Person, buyer: Person, contract: Integer, y: TaxableYear, due: Money) defeasible {
    label en official "the sum of the applicable payments (section 483(b)(1))";
    when deferred_payment_sale_or_exchange_483(seller, buyer, contract, y);
    when payments_due_sum_total(contract, due);
    then payments_due_derived_483(seller, buyer, contract, due);
}
rule TotalUnstatedInterestFromSlots(seller: Person, buyer: Person, contract: Integer, due: Money, pv: Money) defeasible {
    label en official "total unstated interest = the sum of the payments minus the sum of their present values, from the slot-derived amounts (section 483(b))";
    when payments_due_derived_483(seller, buyer, contract, due);
    when present_value_of_payments_derived_483(seller, buyer, contract, pv);
    when due > pv;
    then total_unstated_interest_483(seller, buyer, contract, due - pv);
}
