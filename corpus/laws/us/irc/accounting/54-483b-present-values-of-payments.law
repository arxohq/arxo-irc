// Section 483(b): the total unstated interest from the present values of the
// payments (stage 4, DECISION-0379 with deontics). Closes G4806.
//
// Section 483(b): total unstated interest is the excess of (1) the sum of the
// payments to which the section applies over (2) the sum of the present values
// of such payments and of any interest payments due under the contract; the
// present value of a payment is determined under section 1274(b)(2) at the
// applicable Federal rate of section 1274(d), which section 1274(b)(2)
// compounds semiannually, from the date of the sale to the payment date.
// TECHNIQUE (stated): each payment is discounted with the semiannual factor of
// module 49 (whole six-month periods by (1 + r/2)^n, a stub period by simple
// interest: JUDGMENT CALL); the three sums (payments, present values of the
// payments, present values of the interest payments) are ORDINAL-SLOT sums
// (1 to 24, bounded unrolling: the language cannot sum a derived relation; more
// slots give no amount). The applicable Federal rate is asserted (SOURCE_GAP of
// the value: no IRB rate table pinned). Only payments due more than 6 months
// after the date of the sale are counted (section 483(c)(1)).
// The derived amounts are an ALTERNATIVE channel to the asserted
// `payments_due_under_contract_483` and `present_value_of_payments_483`: a case
// supplies either the two aggregates or the slots, never both.

use self::{
    IRC_S483_B,
    IRC_S483_C,
    Person,
    TaxableYear,
    deferred_payment_sale_or_exchange_483,
    sale_date_483,
    semiannual_factor,
    semiannual_factor_request,
    total_unstated_interest_483,
};

pub relation applicable_federal_rate_483(contract: Integer, rate: Decimal) kind empirical {
    label en official "the applicable Federal rate determined under section 1274(d) at the time of the sale, an annual rate compounded semiannually; the published value is asserted (SOURCE_GAP: no IRB rate table pinned) (section 483(b))";
}
pub relation contract_payment_slot_483(contract: Integer, slot: Integer, due_on: Date, amount: Money) kind empirical {
    label en official "a payment on account of the sale, its due date and its ordinal slot (1 to 24) (section 483(b)(1))";
}
pub relation contract_interest_payment_slot_483(contract: Integer, slot: Integer, due_on: Date, amount: Money) kind empirical {
    label en official "an interest payment due under the contract, its due date and its ordinal slot (1 to 24) (section 483(b)(2))";
}
pub relation payment_subject_to_483_slot(contract: Integer, slot: Integer) kind institutional {
    label en official "the payment is due more than 6 months after the date of the sale, so that section 483 applies to it (section 483(c)(1))";
}
@source(IRC_S483_C, quote = "which is due more than 6 months after the date of such sale or exchange")
rule PaymentSlotDueMoreThanSixMonthsAfterSale(contract: Integer, slot: Integer, due_on: Date, amount: Money, sold_on: Date) defeasible {
    label en official "a due date after 6 calendar months from the sale (section 483(c)(1))";
    when contract_payment_slot_483(contract, slot, due_on, amount);
    when sale_date_483(contract, sold_on);
    when due_on > add_calendar_period(sold_on, 6 calendar_month);
    then payment_subject_to_483_slot(contract, slot);
}
relation payment_amount_due_483(contract: Integer, slot: Integer, amount: Money) kind institutional {
    label en official "the amount of a payment to which section 483 applies (slot view for the sum)";
}
rule PaymentAmountDueForApplicableSlot(contract: Integer, slot: Integer, due_on: Date, amount: Money) defeasible {
    label en official "a payment to which the section applies";
    when contract_payment_slot_483(contract, slot, due_on, amount);
    when payment_subject_to_483_slot(contract, slot);
    then payment_amount_due_483(contract, slot, amount);
}
rule PaymentAsksFactor(contract: Integer, slot: Integer, due_on: Date, amount: Money, sold_on: Date, r: Decimal) defeasible {
    label en official "ask for the discount factor of a payment";
    when contract_payment_slot_483(contract, slot, due_on, amount);
    when payment_subject_to_483_slot(contract, slot);
    when sale_date_483(contract, sold_on);
    when applicable_federal_rate_483(contract, r);
    then semiannual_factor_request(r, sold_on, due_on);
}
rule InterestPaymentAsksFactor(contract: Integer, slot: Integer, due_on: Date, amount: Money, sold_on: Date, r: Decimal) defeasible {
    label en official "ask for the discount factor of an interest payment";
    when contract_interest_payment_slot_483(contract, slot, due_on, amount);
    when sale_date_483(contract, sold_on);
    when applicable_federal_rate_483(contract, r);
    then semiannual_factor_request(r, sold_on, due_on);
}
relation payment_present_value_483(contract: Integer, slot: Integer, pv: Money) kind institutional {
    label en official "the present value of a payment under section 1274(b)(2) at the applicable Federal rate compounded semiannually: amount / factor, one rounding to cents HALF_UP (JUDGMENT CALL)";
}
@source(IRC_S483_B, quote = "the present value of a payment shall be determined under the rules of section 1274(b)(2) using a discount rate equal to the applicable Federal rate determined under section 1274(d).")
rule PaymentPresentValue(contract: Integer, slot: Integer, due_on: Date, amount: Money, sold_on: Date, r: Decimal, f: Decimal) defeasible {
    label en official "amount / factor at the AFR (section 483(b))";
    when contract_payment_slot_483(contract, slot, due_on, amount);
    when payment_subject_to_483_slot(contract, slot);
    when sale_date_483(contract, sold_on);
    when applicable_federal_rate_483(contract, r);
    when semiannual_factor(r, sold_on, due_on, f);
    then payment_present_value_483(contract, slot, div_round(amount, f, 2, "HALF_UP"));
}
relation interest_payment_present_value_483(contract: Integer, slot: Integer, pv: Money) kind institutional {
    label en official "the present value of an interest payment due under the contract (section 483(b)(2))";
}
rule InterestPaymentPresentValue(contract: Integer, slot: Integer, due_on: Date, amount: Money, sold_on: Date, r: Decimal, f: Decimal) defeasible {
    label en official "amount / factor at the AFR (section 483(b))";
    when contract_interest_payment_slot_483(contract, slot, due_on, amount);
    when sale_date_483(contract, sold_on);
    when applicable_federal_rate_483(contract, r);
    when semiannual_factor(r, sold_on, due_on, f);
    then interest_payment_present_value_483(contract, slot, div_round(amount, f, 2, "HALF_UP"));
}
rule SlotsRequestSums(contract: Integer, slot: Integer, due_on: Date, amount: Money) defeasible {
    label en official "ask for the three sums";
    when contract_payment_slot_483(contract, slot, due_on, amount);
    then payments_due_sum_sum_request(contract);
}
rule SlotsRequestPresentValueSums(contract: Integer, slot: Integer, due_on: Date, amount: Money) defeasible {
    label en official "ask for the sums of the present values";
    when contract_payment_slot_483(contract, slot, due_on, amount);
    then payment_pv_sum_sum_request(contract);
}
rule SlotsRequestInterestSums(contract: Integer, slot: Integer, due_on: Date, amount: Money) defeasible {
    label en official "ask for the sum of the interest payments' present values";
    when contract_payment_slot_483(contract, slot, due_on, amount);
    then interest_pv_sum_sum_request(contract);
}

relation payments_due_sum_sum_request(contract: Integer) kind institutional {
    label en official "helper: the ordinal-slot sum of the payments to which section 483 applies is requested";
}
relation payments_due_sum_slot_present(contract: Integer, slot: Integer) kind institutional {
    label en official "helper: slot number has a the payments to which section 483 applies value";
}
rule PaymentsDueSumSlotPresent(contract: Integer, slot: Integer, v: Money) defeasible {
    label en official "a slot with a value is present";
    when payment_amount_due_483(contract, slot, v);
    then payments_due_sum_slot_present(contract, slot);
}
pub relation payments_due_sum_total(contract: Integer, total: Money) kind institutional {
    label en official "the sum of the payments to which section 483 applies over the ordinal slots 1 to 24 (bounded unrolling: the language cannot sum a derived relation; more than 24 slots are not summed and give no total)";
}
relation payments_due_sum_sum_0(contract: Integer, acc: Money) kind institutional {
    label en official "running sum before the first slot";
}
rule PaymentsDueSumSum0(contract: Integer) defeasible {
    label en official "the sum starts at zero";
    when payments_due_sum_sum_request(contract);
    then payments_due_sum_sum_0(contract, 0.00 USD);
}
relation payments_due_sum_sum_1(contract: Integer, acc: Money) kind institutional {
    label en official "running sum through slot 1";
}
rule PaymentsDueSumSum1Add(contract: Integer, acc: Money, v: Money) defeasible {
    label en official "slot 1 has a value: add it";
    when payments_due_sum_sum_0(contract, acc);
    when payment_amount_due_483(contract, 1, v);
    then payments_due_sum_sum_1(contract, acc + v);
}
rule PaymentsDueSumSum1Skip(contract: Integer, acc: Money) defeasible {
    label en official "slot 1 is empty: keep the sum";
    when payments_due_sum_sum_0(contract, acc);
    when not_known(payments_due_sum_slot_present(contract, 1));
    then payments_due_sum_sum_1(contract, acc);
}
