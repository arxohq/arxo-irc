// Section 460 residual (stage 3, DECISION-0379 with deontics): the definitions
// of (f) long-term contract and (g) contract commencement date, (d) Federal
// long-term contract, (e)(1)-(5) construction contracts derived from cost
// facts, (c)(2)-(6) cost allocation rules with the Pub. L. 119-21 sec. 70301
// edition of (c)(6)(B), (b)(2)(A) look-back income allocation, (b)(3)
// exceptions, (b)(4) pass-thru entities, (b)(5) the 10-percent method, (b)(6)
// de minimis look-back, and (b)(7) the adjusted overpayment rate.
//
// Not modelled (TECH-GAPS G4800+): the look-back interest itself, section
// 460(b)(2)(B)-(C): the overpayment or underpayment of tax needs the section
// 1/11 tax function over each prior year, and compounding daily interest needs
// a Decimal power that the language does not have (`pow` is Integer pow
// Integer, spec section 58); the discounting of amounts taken into account
// after completion by the Federal mid-term rate (same power, and the section
// 1274(d) rate is not pinned); the section 263A(f) interest allocation; and the
// regulations of (b)(3)(A), (c)(1), (f)(3) and (h).
//
// New relations sit beside the stage 2b/2c case-fact inputs: `is_long_term_contract`,
// `is_home_construction_contract` and `is_construction_contract` stay as asserted
// facts on their legacy paths; sibling rules read the derived definitions.

// ===================== (g), (f): contract commencement and long-term contract =====================

use self::{
    IRC_S460_B,
    IRC_S460_C,
    IRC_S460_D,
    IRC_S460_E,
    IRC_S460_F,
    IRC_S460_G,
    Person,
    Secretary,
    TaxableYear,
    costs_allocated_and_incurred_to_date,
    estimated_completion_within_two_years_of_commencement,
    is_tax_shelter_barred_from_cash_method_448a3,
    meets_gross_receipts_test_448c,
    percentage_of_completion,
    percentage_of_completion_income,
    preceding_taxable_year_465,
};

pub relation allocable_cost_incurred_on_460g(contract: Integer, d: Date) kind empirical {
    label en official "a cost allocable to the contract, other than bidding expenses or expenses of negotiating the contract, is incurred on the date (section 460(g))";
}
pub relation earlier_allocable_cost_date_exists_460g(contract: Integer, d: Date) kind institutional {
    label en official "an allocable cost of the contract was incurred before the date (bridge for `first date`)";
}
rule EarlierAllocableCostDateExists(contract: Integer, d: Date, d0: Date) strict {
    label en official "a cost incurred on an earlier date exists";
    when allocable_cost_incurred_on_460g(contract, d);
    when allocable_cost_incurred_on_460g(contract, d0);
    when d0 < d;
    then earlier_allocable_cost_date_exists_460g(contract, d);
}
pub relation contract_commencement_date_460g(contract: Integer, d: Date) kind institutional {
    label en official "the contract commencement date: the first date on which any costs (other than bidding and negotiation expenses) allocable to the contract are incurred (section 460(g))";
}
@source(IRC_S460_G, quote = "the first date on which any costs (other than bidding expenses or expenses incurred in connection with negotiating the contract) allocable to such contract are incurred.")
rule ContractCommencementDateIsFirstAllocableCostDate(contract: Integer, d: Date) defeasible {
    label en official "the earliest date of an allocable cost (section 460(g))";
    when allocable_cost_incurred_on_460g(contract, d);
    when not_known(earlier_allocable_cost_date_exists_460g(contract, d));
    then contract_commencement_date_460g(contract, d);
}
pub relation contract_for_manufacture_building_installation_or_construction_460f1(contract: Integer) kind empirical {
    label en official "the contract is for the manufacture, building, installation, or construction of property (section 460(f)(1))";
}
pub relation contract_for_manufacture_of_property_460f2(contract: Integer) kind empirical {
    label en official "the contract is for the manufacture of property (section 460(f)(2))";
}
pub relation manufactured_item_unique_and_not_normally_in_inventory_460f2A(contract: Integer) kind empirical {
    label en official "the contract involves any unique item of a type not normally included in the finished goods inventory of the taxpayer (section 460(f)(2)(A))";
}
pub relation manufactured_item_normally_takes_over_12_calendar_months_460f2B(contract: Integer) kind empirical {
    label en official "the contract involves any item that normally requires more than 12 calendar months to complete, without regard to the period of the contract (section 460(f)(2)(B))";
}
pub relation contract_not_completed_in_year_entered_460f1(contract: Integer) kind empirical {
    label en official "the contract is not completed within the taxable year in which it is entered into (section 460(f)(1))";
}
pub relation long_term_contract_460f(contract: Integer) kind institutional {
    label en official "a long-term contract: a contract for manufacture, building, installation, or construction of property not completed within the taxable year entered into; a manufacturing contract only for a unique item or an item that normally takes more than 12 calendar months (section 460(f)(1)-(2))";
}
@source(IRC_S460_F, quote = "The term \"long-term contract\" means any contract for the manufacture, building, installation, or construction of property if such contract is not completed within the taxable year in which such contract is entered into.")
rule LongTermContractNonManufacturing(contract: Integer) defeasible {
    label en official "a contract for building, installation, or construction of property that is not completed in the year it is entered into is a long-term contract (section 460(f)(1))";
    when contract_for_manufacture_building_installation_or_construction_460f1(contract);
    when contract_not_completed_in_year_entered_460f1(contract);
    when not_known(contract_for_manufacture_of_property_460f2(contract));
    then long_term_contract_460f(contract);
}
@source(IRC_S460_F, quote = "A contract for the manufacture of property shall not be treated as a long-term contract unless such contract involves the manufacture of—")
rule LongTermContractManufacturingUniqueItem(contract: Integer) defeasible {
    label en official "a manufacturing contract is long-term only for a unique item not normally in finished goods inventory (section 460(f)(2)(A))";
    when contract_for_manufacture_of_property_460f2(contract);
    when contract_not_completed_in_year_entered_460f1(contract);
    when manufactured_item_unique_and_not_normally_in_inventory_460f2A(contract);
    then long_term_contract_460f(contract);
}
rule LongTermContractManufacturingLongItem(contract: Integer) defeasible {
    label en official "a manufacturing contract is long-term for an item that normally needs more than 12 calendar months (section 460(f)(2)(B))";
    when contract_for_manufacture_of_property_460f2(contract);
    when contract_not_completed_in_year_entered_460f1(contract);
    when manufactured_item_normally_takes_over_12_calendar_months_460f2B(contract);
    then long_term_contract_460f(contract);
}
// --- (d): Federal long-term contract ---
pub relation united_states_or_agency_is_party_460d1A(contract: Integer) kind empirical {
    label en official "the United States or an agency or instrumentality is a party to the contract (section 460(d)(1)(A)); the section 168(h)(2)(D) rules on taxable entities are asserted";
}
pub relation contract_is_subcontract_under_a_460d1A_contract_460d1B(contract: Integer) kind empirical {
    label en official "the contract is a subcontract under a contract described in subparagraph (A) (section 460(d)(1)(B))";
}
pub relation federal_long_term_contract_460d(contract: Integer) kind institutional {
    label en official "a Federal long-term contract: a long-term contract to which the United States (or an agency or instrumentality) is a party, or a subcontract under such a contract (section 460(d)(1))";
}
@source(IRC_S460_D, quote = "(A) to which the United States (or any agency or instrumentality thereof) is a party, or")
rule FederalLongTermContractUnitedStatesParty(contract: Integer) defeasible {
    label en official "a long-term contract with the United States or an agency as a party (section 460(d)(1)(A))";
    when long_term_contract_460f(contract);
    when united_states_or_agency_is_party_460d1A(contract);
    then federal_long_term_contract_460d(contract);
}
@source(IRC_S460_D, quote = "(B) which is a subcontract under a contract described in subparagraph (A).")
rule FederalLongTermContractSubcontract(contract: Integer) defeasible {
    label en official "a long-term contract that is a subcontract under a Federal contract (section 460(d)(1)(B))";
    when long_term_contract_460f(contract);
    when contract_is_subcontract_under_a_460d1A_contract_460d1B(contract);
    then federal_long_term_contract_460d(contract);
}

// ===================== (e): construction contracts =====================

pub relation contract_for_building_construction_reconstruction_rehabilitation_or_improvement_of_real_property_460e3(contract: Integer) kind empirical {
    label en official "the contract is for the building, construction, reconstruction, or rehabilitation of, or the installation of an integral component to, or improvements of, real property (section 460(e)(3))";
}
pub relation construction_contract_460e3(contract: Integer) kind institutional {
    label en official "a construction contract (section 460(e)(3))";
}
@source(IRC_S460_E, quote = "the term \"construction contract\" means any contract for the building, construction, reconstruction, or rehabilitation of, or the installation of any integral component to, or improvements of, real property.")
rule ConstructionContractDefinition(contract: Integer) strict {
    label en official "a contract for building, construction, reconstruction, rehabilitation, integral components or improvements of real property is a construction contract (section 460(e)(3))";
    when contract_for_building_construction_reconstruction_rehabilitation_or_improvement_of_real_property_460e3(contract);
    then construction_contract_460e3(contract);
}
pub relation estimated_total_contract_costs_at_close_of_entry_year_460e5(contract: Integer, amount: Money) kind empirical {
    label en official "the estimated total contract costs as of the close of the taxable year in which the contract was entered into (section 460(e)(5)(A))";
}
pub relation costs_reasonably_expected_for_dwelling_units_in_buildings_of_four_or_fewer_460e5Ai(contract: Integer, amount: Money) kind empirical {
    label en official "the costs reasonably expected to be attributable to the section 460(e)(4) activities with respect to dwelling units (section 168(e)(2)(A)(ii)) in buildings containing 4 or fewer dwelling units, each townhouse or rowhouse being a separate building (section 460(e)(5)(A)(i))";
}
pub relation costs_reasonably_expected_for_all_dwelling_units_460e5B(contract: Integer, amount: Money) kind empirical {
    label en official "the costs reasonably expected to be attributable to the section 460(e)(4) activities with respect to dwelling units in buildings of any size (section 460(e)(5)(B))";
}
pub relation costs_reasonably_expected_for_related_improvements_on_site_460e5Aii(contract: Integer, amount: Money) kind empirical {
    label en official "the costs reasonably expected to be attributable to improvements to real property directly related to the dwelling units and located on their site (section 460(e)(5)(A)(ii))";
}
pub relation home_construction_contract_460e5A(contract: Integer) kind institutional {
    label en official "a home construction contract: a construction contract with 80 percent or more of estimated total contract costs reasonably expected to be attributable to dwelling units in buildings of 4 or fewer units and directly related improvements on site (section 460(e)(5)(A))";
}
@source(IRC_S460_E, quote = "The term \"home construction contract\" means any construction contract if 80 percent or more of the estimated total contract costs")
rule HomeConstructionContractFromCosts(contract: Integer, total: Money, dwelling: Money, improvements: Money) defeasible {
    label en official "dwelling-unit costs plus related on-site improvement costs are at least 80 percent of estimated total costs (section 460(e)(5)(A)); the 'reasonably expected' judgement is inside the asserted costs";
    when construction_contract_460e3(contract);
    when estimated_total_contract_costs_at_close_of_entry_year_460e5(contract, total);
    when costs_reasonably_expected_for_dwelling_units_in_buildings_of_four_or_fewer_460e5Ai(contract, dwelling);
    when costs_reasonably_expected_for_related_improvements_on_site_460e5Aii(contract, improvements);
    when (dwelling + improvements) * 5.0 >= total * 4.0;
    then home_construction_contract_460e5A(contract);
}
pub relation residential_construction_contract_460e5B(contract: Integer) kind institutional {
    label en official "a residential construction contract: the (A) test with dwelling units in buildings of any size (section 460(e)(5)(B))";
}
@source(IRC_S460_E, quote = "The term \"residential construction contract\" means any contract which would be described in subparagraph (A) if clause (i) of such")
rule ResidentialConstructionContractFromCosts(contract: Integer, total: Money, dwelling: Money, improvements: Money) defeasible {
    label en official "all dwelling-unit costs plus related on-site improvement costs are at least 80 percent of estimated total costs (section 460(e)(5)(B))";
    when construction_contract_460e3(contract);
    when estimated_total_contract_costs_at_close_of_entry_year_460e5(contract, total);
    when costs_reasonably_expected_for_all_dwelling_units_460e5B(contract, dwelling);
    when costs_reasonably_expected_for_related_improvements_on_site_460e5Aii(contract, improvements);
    when (dwelling + improvements) * 5.0 >= total * 4.0;
    then residential_construction_contract_460e5B(contract);
}
pub relation residential_construction_contract_not_home_460e4(contract: Integer) kind institutional {
    label en official "a residential construction contract that is not a home construction contract (section 460(e)(4)); the pre-1989 subsection (a) it then follows, with 70/30 substituted for 90/10, is not in the pinned text";
}
@source(IRC_S460_E, quote = "In the case of any residential construction contract which is not a home construction contract, subsection (a)")
rule ResidentialContractNotHome(contract: Integer) defeasible {
    label en official "a residential construction contract that is not a home construction contract (section 460(e)(4))";
    when residential_construction_contract_460e5B(contract);
    when not_known(home_construction_contract_460e5A(contract));
    then residential_construction_contract_not_home_460e4(contract);
}
pub relation taxpayer_is_not_corporation_or_partnership_460e2A(p: Person) kind empirical {
    label en official "the taxpayer is not a corporation or a partnership (section 460(e)(2)(A))";
}
pub relation gross_receipts_test_applied_per_trade_or_business_460e2A(p: Person) kind institutional {
    label en official "for a taxpayer that is not a corporation or partnership the section 448(c) gross receipts test is applied as if each trade or business were a corporation or partnership (section 460(e)(2)(A)); the per-business receipts are inputs of the test";
}
@source(IRC_S460_E, quote = "the gross receipts test of section 448(c) shall be applied in the same manner as if each trade or business of such taxpayer were a corporation or partnership.")
rule GrossReceiptsTestPerTradeOrBusinessForIndividuals(p: Person) defeasible {
    label en official "individuals and others apply the section 448(c) test per trade or business (section 460(e)(2)(A))";
    when taxpayer_is_not_corporation_or_partnership_460e2A(p);
    then gross_receipts_test_applied_per_trade_or_business_460e2A(p);
}
pub relation change_of_method_under_460e1B_ii(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer changes its method of accounting pursuant to section 460(e)(1)(B)(ii) in the taxable year";
}
pub relation section_460e1B_change_taxpayer_initiated_with_consent(p: Person, y: TaxableYear) kind institutional {
    label en official "the change is treated as initiated by the taxpayer and made with the Secretary's consent, effected on a cut-off basis for all similarly classified contracts entered into on or after the year of change (section 460(e)(2)(B))";
}
@source(IRC_S460_E, quote = "Any change in method of accounting made pursuant to paragraph (1)(B)(ii) shall be treated as initiated by the taxpayer and made with the consent of the Secretary.")
rule Section460e2BChangeInitiatedWithConsent(p: Person, y: TaxableYear) defeasible {
    label en official "a section 460(e)(1)(B)(ii) change is taxpayer-initiated, consented, and cut-off (section 460(e)(2)(B))";
    when change_of_method_under_460e1B_ii(p, y);
    then section_460e1B_change_taxpayer_initiated_with_consent(p, y);
}
pub relation section_263A_applies_notwithstanding_263Ac4_home_contract_460e1(p: Person, contract: Integer) kind institutional {
    label en official "a home construction contract that fails the (B)(i)-(ii) requirements is subject to section 263A notwithstanding section 263A(c)(4) (section 460(e)(1), flush sentence)";
}
@source(IRC_S460_E, quote = "In the case of a home construction contract with respect to which the requirements of clauses (i) and (ii) of subparagraph (B) are not met, section 263A shall apply notwithstanding subsection (c)(4) thereof.")
rule Section263AAppliesToFailingHomeContract(p: Person, contract: Integer, y: TaxableYear) defeasible {
    label en official "a home construction contract failing the 2-year estimate or the gross receipts test is subject to section 263A (section 460(e)(1), flush sentence)";
    when home_construction_contract_460e5A(contract);
    when engaged_in_contract_460(p, contract);
    when us.irc.core::year_of(p, y);
    when not_known(estimated_completion_within_two_years_of_commencement(p, contract));
    then section_263A_applies_notwithstanding_263Ac4_home_contract_460e1(p, contract);
}
rule Section263AAppliesToFailingHomeContractByReceipts(p: Person, contract: Integer, y: TaxableYear) defeasible {
    label en official "a home construction contract for which the taxpayer fails the section 448(c) gross receipts test is subject to section 263A (section 460(e)(1), flush sentence)";
    when home_construction_contract_460e5A(contract);
    when engaged_in_contract_460(p, contract);
    when us.irc.core::year_of(p, y);
    when not_known(meets_gross_receipts_test_448c(p, y));
    then section_263A_applies_notwithstanding_263Ac4_home_contract_460e1(p, contract);
}
pub relation engaged_in_contract_460(p: Person, contract: Integer) kind empirical {
    label en official "the taxpayer is the party performing the contract (case link between taxpayer and contract)";
}
pub relation percentage_completion_required_derived_460(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "the percentage-of-completion requirement applies to a derived long-term contract that is not a home construction contract and does not meet the small-contractor exemption (section 460(a), (e)(1))";
}
rule PercentageCompletionRequiredForDerivedContract(p: Person, contract: Integer, y: TaxableYear) defeasible {
    label en official "derived long-term contract, not a home construction contract, outside the small construction exemption (section 460(e)(1)); the legacy rule for asserted contracts is kept";
    when engaged_in_contract_460(p, contract);
    when long_term_contract_460f(contract);
    when us.irc.core::year_of(p, y);
    when not_known(home_construction_contract_460e5A(contract));
    when not_known(derived_small_construction_exemption_460e1B(p, contract, y));
    then percentage_completion_required_derived_460(p, contract, y);
}
pub relation derived_small_construction_exemption_460e1B(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "the section 460(e)(1)(B) exemption for a derived construction contract: 2-year estimate and section 448(c) gross receipts test, taxpayer not a barred tax shelter";
}
rule DerivedSmallConstructionExemption(p: Person, contract: Integer, y: TaxableYear) strict {
    label en official "a construction contract estimated to complete within 2 years of a taxpayer meeting the section 448(c) test, other than a barred tax shelter, is exempt (section 460(e)(1)(B))";
    when engaged_in_contract_460(p, contract);
    when construction_contract_460e3(contract);
    when estimated_completion_within_two_years_of_commencement(p, contract);
    when meets_gross_receipts_test_448c(p, y);
    when not_known(is_tax_shelter_barred_from_cash_method_448a3(p));
    then derived_small_construction_exemption_460e1B(p, contract, y);
}

// ===================== (c): cost allocation =====================

pub relation cost_identified_as_attributable_to_contract_460c2(cost: Integer, contract: Integer) kind empirical {
    label en official "the taxpayer (or a related person) identifies the cost, pursuant to the contract or Federal, State, or local law or regulation, as attributable to the contract (section 460(c)(2))";
}
pub relation cost_allocated_under_c1_460c(cost: Integer, contract: Integer) kind empirical {
    label en official "the cost is allocated to the contract under paragraph (1)";
}
pub relation cost_plus_long_term_contract_460c2(contract: Integer) kind empirical {
    label en official "the contract is a cost-plus long-term contract (section 460(c)(2))";
}
pub relation cost_allocated_to_contract_460c2(cost: Integer, contract: Integer) kind institutional {
    label en official "a cost not allocated under paragraph (1) is allocated to a cost-plus or Federal long-term contract if identified by the taxpayer (or a related person) as attributable to it (section 460(c)(2))";
}
@source(IRC_S460_C, quote = "any cost not allocated to such contract under paragraph (1) shall be allocated to such contract if such cost is identified by the taxpayer (or a related person)")
rule CostPlusOrFederalContractIdentifiedCost(cost: Integer, contract: Integer) defeasible {
    label en official "an identified cost of a cost-plus contract is allocated (section 460(c)(2))";
    when cost_plus_long_term_contract_460c2(contract);
    when cost_identified_as_attributable_to_contract_460c2(cost, contract);
    when not_known(cost_allocated_under_c1_460c(cost, contract));
    then cost_allocated_to_contract_460c2(cost, contract);
}
rule FederalContractIdentifiedCost(cost: Integer, contract: Integer) defeasible {
    label en official "an identified cost of a Federal long-term contract is allocated (section 460(c)(2))";
    when federal_long_term_contract_460d(contract);
    when cost_identified_as_attributable_to_contract_460c2(cost, contract);
    when not_known(cost_allocated_under_c1_460c(cost, contract));
    then cost_allocated_to_contract_460c2(cost, contract);
}
pub relation uses_accrual_method_for_long_term_contracts_460c3B(p: Person) kind empirical {
    label en official "the taxpayer uses an accrual method with respect to long-term contracts (section 460(c)(3)(B)(i)(II))";
}
pub relation date_five_percent_of_estimated_total_costs_incurred_460c3B(contract: Integer, d: Date) kind empirical {
    label en official "the date by which at least 5 percent of the total estimated costs (including design and planning costs) under the contract have been incurred (section 460(c)(3)(B)(i)(II))";
}
pub relation contract_completion_date_460c3B(contract: Integer, d: Date) kind empirical {
    label en official "the contract completion date (section 460(c)(3)(B)(ii))";
}
pub relation production_period_for_interest_allocation_460c3B(p: Person, contract: Integer, starts: Date, ends: Date) kind institutional {
    label en official "the production period for section 263A(f) interest allocation: from the later of the commencement date and, for an accrual-method taxpayer, the date 5 percent of estimated costs are incurred, to the completion date (section 460(c)(3)(B))";
}
@source(IRC_S460_C, quote = "(I) the contract commencement date, or")
rule ProductionPeriodStartsAtCommencementForCashTaxpayers(p: Person, contract: Integer, start: Date, finish: Date) defeasible {
    label en official "for a taxpayer not using an accrual method the period starts at the contract commencement date (section 460(c)(3)(B)(i)(I))";
    when engaged_in_contract_460(p, contract);
    when contract_commencement_date_460g(contract, start);
    when contract_completion_date_460c3B(contract, finish);
    when not_known(uses_accrual_method_for_long_term_contracts_460c3B(p));
    then production_period_for_interest_allocation_460c3B(p, contract, start, finish);
}
@source(IRC_S460_C, quote = "(II) in the case of a taxpayer who uses an accrual method with respect to long-term contracts, the date by which at least 5 percent of the total estimated costs (including design and planning costs) under the contract have been incurred, and")
rule ProductionPeriodStartsAtLaterOfCommencementAndFivePercent(p: Person, contract: Integer, commence: Date, five: Date, finish: Date) defeasible {
    label en official "for an accrual-method taxpayer the period starts at the later of the commencement date and the 5-percent date (section 460(c)(3)(B)(i))";
    when engaged_in_contract_460(p, contract);
    when uses_accrual_method_for_long_term_contracts_460c3B(p);
    when contract_commencement_date_460g(contract, commence);
    when date_five_percent_of_estimated_total_costs_incurred_460c3B(contract, five);
    when contract_completion_date_460c3B(contract, finish);
    when five >= commence;
    then production_period_for_interest_allocation_460c3B(p, contract, five, finish);
}
rule ProductionPeriodStartsAtCommencementWhenLaterThanFivePercent(p: Person, contract: Integer, commence: Date, five: Date, finish: Date) defeasible {
    label en official "when the commencement date is later than the 5-percent date the period starts at commencement (section 460(c)(3)(B)(i))";
    when engaged_in_contract_460(p, contract);
    when uses_accrual_method_for_long_term_contracts_460c3B(p);
    when contract_commencement_date_460g(contract, commence);
    when date_five_percent_of_estimated_total_costs_incurred_460c3B(contract, five);
    when contract_completion_date_460c3B(contract, finish);
    when commence > five;
    then production_period_for_interest_allocation_460c3B(p, contract, commence, finish);
}
pub relation de_minimis_rule_scope_460c3C(p: Person, contract: Integer, unit: Text) kind institutional {
    label en official "the section 263A(f)(1)(B)(iii) de minimis rule is applied contract by contract, or property by property for a taxpayer using an accrual method with the 5-percent start (section 460(c)(3)(C))";
}
@source(IRC_S460_C, quote = "shall be applied on a contract-by-contract basis; except that, in the case of a taxpayer described in subparagraph (B)(i)(II) of this paragraph, paragraph (1)(B)(iii) of section 263A(f) shall be applied on a property-by-property basis.")
rule DeMinimisRuleContractByContract(p: Person, contract: Integer) defeasible {
    label en official "contract-by-contract application for other taxpayers (section 460(c)(3)(C))";
    when engaged_in_contract_460(p, contract);
    when not_known(uses_accrual_method_for_long_term_contracts_460c3B(p));
    then de_minimis_rule_scope_460c3C(p, contract, "contract");
}
rule DeMinimisRulePropertyByPropertyForAccrualTaxpayers(p: Person, contract: Integer) defeasible {
    label en official "property-by-property application for an accrual-method taxpayer (section 460(c)(3)(C))";
    when engaged_in_contract_460(p, contract);
    when uses_accrual_method_for_long_term_contracts_460c3B(p);
    then de_minimis_rule_scope_460c3C(p, contract, "property");
}
pub enum ExcludedCostKind460c4 {
    IndependentResearchAndDevelopment;
    UnsuccessfulBidsAndProposals;
    MarketingSellingAndAdvertising;
    label en official "costs to which section 460(c) does not apply (section 460(c)(4)(A)-(C))";
}
pub relation cost_kind_460c4(cost: Integer, kind: ExcludedCostKind460c4) kind empirical {
    label en official "the cost is of the kind named";
}
pub relation expense_incurred_in_performing_research_or_development_460c5(cost: Integer) kind empirical {
    label en official "the expense is incurred in the performance of research or development (section 460(c)(5))";
}
pub relation expense_directly_attributable_to_long_term_contract_in_existence_460c5A(cost: Integer) kind empirical {
    label en official "the expense is directly attributable to a long-term contract in existence when it is incurred (section 460(c)(5)(A))";
}
pub relation expense_under_agreement_to_perform_research_or_development_460c5B(cost: Integer) kind empirical {
    label en official "the expense is under an agreement to perform research or development (section 460(c)(5)(B))";
}
pub relation independent_research_and_development_expense_460c5(cost: Integer) kind institutional {
    label en official "an independent research and development expense: an expense of performing research or development other than one directly attributable to an existing long-term contract or incurred under an agreement to perform research or development (section 460(c)(5))";
}
@source(IRC_S460_C, quote = "the term \"independent research and development expenses\" means any expenses incurred in the performance of research or development")
rule IndependentResearchAndDevelopmentDefinition(cost: Integer) defeasible {
    label en official "research or development expense outside the two exceptions (section 460(c)(5)(A)-(B))";
    when expense_incurred_in_performing_research_or_development_460c5(cost);
    when not_known(expense_directly_attributable_to_long_term_contract_in_existence_460c5A(cost));
    when not_known(expense_under_agreement_to_perform_research_or_development_460c5B(cost));
    then independent_research_and_development_expense_460c5(cost);
}
pub relation cost_excluded_from_contract_cost_allocation_460c4(cost: Integer) kind institutional {
    label en official "the cost is excluded from section 460(c) allocation: independent research and development, unsuccessful bids and proposals, marketing, selling and advertising (section 460(c)(4))";
}
@source(IRC_S460_C, quote = "(A) independent research and development expenses,")
rule IndependentResearchExcludedFromAllocation(cost: Integer) defeasible {
    label en official "independent research and development expenses are not allocated (section 460(c)(4)(A))";
    when independent_research_and_development_expense_460c5(cost);
    then cost_excluded_from_contract_cost_allocation_460c4(cost);
}
@source(IRC_S460_C, quote = "(B) expenses for unsuccessful bids and proposals, and")
rule UnsuccessfulBidsExcludedFromAllocation(cost: Integer) defeasible {
    label en official "expenses for unsuccessful bids and proposals are not allocated (section 460(c)(4)(B))";
    when cost_kind_460c4(cost, UnsuccessfulBidsAndProposals);
    then cost_excluded_from_contract_cost_allocation_460c4(cost);
}
@source(IRC_S460_C, quote = "(C) marketing, selling, and advertising expenses.")
rule MarketingExcludedFromAllocation(cost: Integer) defeasible {
    label en official "marketing, selling, and advertising expenses are not allocated (section 460(c)(4)(C))";
    when cost_kind_460c4(cost, MarketingSellingAndAdvertising);
    then cost_excluded_from_contract_cost_allocation_460c4(cost);
}
// --- (c)(6): bonus depreciation special rule, with Pub. L. 119-21 sec. 70301(a)(5)(D) ---
pub relation property_described_in_168k2_460c6B(prop: Integer) kind empirical {
    label en official "the property is described in section 168(k)(2) (section 460(c)(6)(B))";
}
pub relation property_described_in_168k2B_longer_production_460c6B(prop: Integer) kind empirical {
    label en official "the property is described in section 168(k)(2)(B) (longer production period), for which the placed-in-service bound is January 1, 2028";
}
pub relation recovery_period_years_460c6B(prop: Integer, years: Integer) kind empirical {
    label en official "the recovery period of the property in years (section 460(c)(6)(B)(i))";
}
pub relation property_placed_in_service_on_460c6B(prop: Integer, d: Date) kind empirical {
    label en official "the date the property is placed in service (section 460(c)(6)(B)(ii))";
}
pub relation property_acquired_on_460c6B(prop: Integer, d: Date) kind empirical {
    label en official "the date the property is acquired; Pub. L. 119-21 sec. 70301 applies to property acquired after January 19, 2025";
}
pub relation qualified_property_460c6B(prop: Integer) kind institutional {
    label en official "qualified property for section 460(c)(6): described in section 168(k)(2), recovery period of 7 years or less, and (for property acquired on or before 2025-01-19, or before enactment) placed in service before January 1, 2027 (January 1, 2028 for section 168(k)(2)(B) property)";
}
@source(IRC_S460_C, quote = "(ii) is placed in service before January 1, 2027 (January 1, 2028 in the case of property described in section 168(k)(2)(B)).")
rule QualifiedPropertyBeforePL119_21OrForOldProperty(prop: Integer, years: Integer, placed: Date) defeasible {
    effective [@1990-01-01, @2025-07-04);
    label en official "the text as pinned: recovery period 7 years or less and placed in service before 2027 (section 460(c)(6)(B)(i)-(ii)); regular property";
    when property_described_in_168k2_460c6B(prop);
    when not_known(property_described_in_168k2B_longer_production_460c6B(prop));
    when recovery_period_years_460c6B(prop, years);
    when years <= 7;
    when property_placed_in_service_on_460c6B(prop, placed);
    when placed < @2027-01-01;
    then qualified_property_460c6B(prop);
}
rule QualifiedPropertyLongerProductionBeforePL119_21(prop: Integer, years: Integer, placed: Date) defeasible {
    effective [@1990-01-01, @2025-07-04);
    label en official "as pinned: section 168(k)(2)(B) property is placed in service before January 1, 2028 (section 460(c)(6)(B)(ii))";
    when property_described_in_168k2_460c6B(prop);
    when property_described_in_168k2B_longer_production_460c6B(prop);
    when recovery_period_years_460c6B(prop, years);
    when years <= 7;
    when property_placed_in_service_on_460c6B(prop, placed);
    when placed < @2028-01-01;
    then qualified_property_460c6B(prop);
}
@source(us.irc.temporal::PL119_21_S70301, quote = "Section 460(c)(6)(B) is amended by striking “which” and all that follows through the period and inserting “which has a recovery period of 7 years or less.”.")
rule QualifiedPropertyAfterEnactmentForOldProperty(prop: Integer, years: Integer, placed: Date, acquired: Date) defeasible {
    effective [@2025-07-04, infinity);
    label en official "after Pub. L. 119-21, property acquired on or before 2025-01-19 keeps the pinned text: recovery period 7 years or less and the placed-in-service bound (sec. 70301(a)(5)(D), (c)(1))";
    when property_described_in_168k2_460c6B(prop);
    when not_known(property_described_in_168k2B_longer_production_460c6B(prop));
    when recovery_period_years_460c6B(prop, years);
    when years <= 7;
    when property_placed_in_service_on_460c6B(prop, placed);
    when property_acquired_on_460c6B(prop, acquired);
    when placed < @2027-01-01;
    when acquired <= @2025-01-19;
    then qualified_property_460c6B(prop);
}
rule QualifiedPropertyLongerProductionAfterEnactmentForOldProperty(prop: Integer, years: Integer, placed: Date, acquired: Date) defeasible {
    effective [@2025-07-04, infinity);
    label en official "after Pub. L. 119-21, section 168(k)(2)(B) property acquired on or before 2025-01-19 keeps the January 1, 2028 bound (sec. 70301(a)(5)(D), (c)(1))";
    when property_described_in_168k2_460c6B(prop);
    when property_described_in_168k2B_longer_production_460c6B(prop);
    when recovery_period_years_460c6B(prop, years);
    when years <= 7;
    when property_placed_in_service_on_460c6B(prop, placed);
    when property_acquired_on_460c6B(prop, acquired);
    when placed < @2028-01-01;
    when acquired <= @2025-01-19;
    then qualified_property_460c6B(prop);
}
@source(us.irc.temporal::PL119_21_S70301, quote = "Section 460(c)(6)(B) is amended by striking “which” and all that follows through the period and inserting “which has a recovery period of 7 years or less.”.")
rule QualifiedPropertyAcquiredAfterJanuary19_2025(prop: Integer, years: Integer, acquired: Date) defeasible {
    effective [@2025-07-04, infinity);
    label en official "after Pub. L. 119-21, property acquired after 2025-01-19 is qualified when described in section 168(k)(2) with a recovery period of 7 years or less; the placed-in-service bound is struck (sec. 70301(a)(5)(D), (c)(1))";
    when property_described_in_168k2_460c6B(prop);
    when recovery_period_years_460c6B(prop, years);
    when years <= 7;
    when property_acquired_on_460c6B(prop, acquired);
    when acquired > @2025-01-19;
    then qualified_property_460c6B(prop);
}
pub relation cost_of_qualified_property_as_if_168k_not_enacted_460c6A(prop: Integer, contract: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cost of the property allocated to the contract as if section 168(k) had not been enacted (section 460(c)(6)(A))";
}
pub relation qualified_property_cost_allocated_for_percentage_of_completion_460c6A(prop: Integer, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "solely for the percentage of completion under (b)(1)(A), the cost of qualified property is taken into account as a cost allocated to the contract as if section 168(k) had not been enacted (section 460(c)(6)(A))";
}
@source(IRC_S460_C, quote = "Solely for purposes of determining the percentage of completion under subsection (b)(1)(A), the cost of qualified property shall be taken into account as a cost allocated to the contract as if subsection (k) of section 168 had not been enacted.")
rule QualifiedPropertyCostAllocatedWithoutBonus(prop: Integer, contract: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "a qualified property's cost enters the percentage of completion without bonus depreciation (section 460(c)(6)(A))";
    when qualified_property_460c6B(prop);
    when cost_of_qualified_property_as_if_168k_not_enacted_460c6A(prop, contract, y, amount);
    then qualified_property_cost_allocated_for_percentage_of_completion_460c6A(prop, contract, y, amount);
}

// ===================== (b): look-back method and its exceptions =====================

pub relation actual_contract_price_460b2A(contract: Integer, amount: Money) kind empirical {
    label en official "the actual contract price, known at completion (section 460(b)(2)(A))";
}
pub relation actual_total_contract_costs_460b2A(contract: Integer, amount: Money) kind empirical {
    label en official "the actual total contract costs, known at completion (section 460(b)(2)(A))";
}
pub relation look_back_cumulative_income_460b2A(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the cumulative income allocated to the year under the look-back method: the percentage-of-completion allocation on the actual contract price and costs instead of the estimated ones (section 460(b)(2)(A)); the interest of (B)-(C) is not computed";
}
@source(IRC_S460_B, quote = "(A) first, allocating income under the contract among taxable years before the year in which the contract is completed on the basis of the actual contract price and costs instead of the estimated contract price and costs,")
rule LookBackCumulativeIncomeOnActualFigures(p: Person, contract: Integer, y: TaxableYear, incurred: Money, price: Money, total: Money) defeasible {
    label en official "actual price x costs incurred to date / actual total costs, one rounding to cents HALF_UP (JUDGMENT CALL) (section 460(b)(2)(A))";
    when costs_allocated_and_incurred_to_date(p, contract, y, incurred);
    when actual_contract_price_460b2A(contract, price);
    when actual_total_contract_costs_460b2A(contract, total);
    when total > 0.00 USD;
    then look_back_cumulative_income_460b2A(p, contract, y, div_round(price * (incurred / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation elects_out_of_discounting_460b2(p: Person, contract: Integer) kind empirical {
    label en official "the taxpayer elects, with respect to the contract, that the discounting of amounts taken into account after completion does not apply (section 460(b)(2), last sentence)";
}
pub relation discounting_election_out_in_effect_460b2(p: Person, contract: Integer) kind institutional {
    label en official "the election out of discounting is in effect for the contract";
}
@source(IRC_S460_B, quote = "The taxpayer may elect with respect to any contract to have the preceding sentence not apply to such contract.")
rule Section460b2DiscountingElectionOutPower(p: Person, contract: Integer) strict {
    label en official "the taxpayer may elect, per contract, that the discounting of post-completion amounts does not apply (section 460(b)(2))";
    when elects_out_of_discounting_460b2(p, contract);
    then power Section460b2ElectOutOfDiscounting {
        holder p;
        over contract;
        exercise elects_out_of_discounting_460b2(p, contract);
        valid_when contract_for_discounting_election_460b2(p, contract);
        effect create(discounting_election_out_in_effect_460b2(p, contract));
        window [@1986-10-22, infinity);
    };
}
pub relation contract_for_discounting_election_460b2(p: Person, contract: Integer) kind empirical {
    label en official "the contract is a long-term contract of the taxpayer to which the look-back method applies";
}
pub relation secretary_prescribes_simplified_cost_allocation_460b3A(contract: Integer) kind empirical {
    label en official "the Secretary prescribes a simplified procedure for allocation of costs to the long-term contract in lieu of subsection (c) (section 460(b)(3)(A))";
}
pub relation simplified_cost_allocation_procedure_in_effect_460b3A(contract: Integer) kind institutional {
    label en official "the simplified allocation procedure applies to the contract in lieu of the subsection (c) method";
}
@source(IRC_S460_B, quote = "the Secretary may prescribe a simplified procedure for allocation of costs to such contract in lieu of the method of allocation under subsection (c).")
rule Section460b3ASimplifiedProcedurePower(contract: Integer) strict {
    label en official "the Secretary may prescribe a simplified cost allocation procedure for a long-term contract (section 460(b)(3)(A))";
    when secretary_prescribes_simplified_cost_allocation_460b3A(contract);
    then power Section460b3ASimplifiedCostAllocation {
        holder Secretary;
        over contract;
        exercise secretary_prescribes_simplified_cost_allocation_460b3A(contract);
        valid_when long_term_contract_460f(contract);
        effect create(simplified_cost_allocation_procedure_in_effect_460b3A(contract));
        window [@1986-10-22, infinity);
    };
}
pub relation gross_price_at_completion_460b3B(contract: Integer, amount: Money) kind empirical {
    label en official "the gross price of the contract as of its completion (section 460(b)(3)(B)(i))";
}
pub relation average_annual_gross_receipts_three_years_before_completion_year_460b3B(p: Person, contract: Integer, amount: Money) kind empirical {
    label en official "the average annual gross receipts of the taxpayer for the 3 taxable years preceding the taxable year in which the contract was completed (section 460(b)(3)(B)(i)(II))";
}
pub relation look_back_not_applicable_460b3B(p: Person, contract: Integer) kind institutional {
    label en official "paragraph (1)(B) does not apply to a contract whose gross price at completion is at most the lesser of $1,000,000 and 1 percent of the average annual gross receipts of the 3 preceding years, and that is completed within 2 years of the commencement date (section 460(b)(3)(B))";
}
@source(IRC_S460_B, quote = "Paragraph (1)(B) shall not apply to any contract—")
rule LookBackNotAppliedToSmallShortContracts(p: Person, contract: Integer, price: Money, receipts: Money, commence: Date, done: Date) defeasible {
    label en official "price <= min($1,000,000, 1% of average receipts) and completion within 24 calendar months of the commencement date (section 460(b)(3)(B)(i)-(ii)); the (e)(2) and (f)(3) similar rules are regulatory";
    when engaged_in_contract_460(p, contract);
    when gross_price_at_completion_460b3B(contract, price);
    when average_annual_gross_receipts_three_years_before_completion_year_460b3B(p, contract, receipts);
    when contract_commencement_date_460g(contract, commence);
    when contract_completion_date_460c3B(contract, done);
    when price <= min(LookBackDeMinimisContractPriceCeiling, receipts * 0.01);
    when done <= add_calendar_period(commence, 24 calendar_month);
    then look_back_not_applicable_460b3B(p, contract);
}
// --- (b)(4): pass-thru entities ---
pub relation entity_is_partnership_460b4Cii(e: Person) kind empirical {
    label en official "the entity is a partnership (section 460(b)(4)(C)(ii)(I))";
}
pub relation entity_is_s_corporation_460b4Cii(e: Person) kind empirical {
    label en official "the entity is an S corporation (section 460(b)(4)(C)(ii)(II))";
}
pub relation entity_is_trust_460b4Cii(e: Person) kind empirical {
    label en official "the entity is a trust (section 460(b)(4)(C)(ii)(III))";
}
pub relation pass_thru_entity_460b4Cii(e: Person) kind institutional {
    label en official "a pass-thru entity: a partnership, S corporation, or trust (section 460(b)(4)(C)(ii))";
}
rule PassThruEntityPartnership(e: Person) strict {
    label en official "a partnership is a pass-thru entity (section 460(b)(4)(C)(ii)(I))";
    when entity_is_partnership_460b4Cii(e);
    then pass_thru_entity_460b4Cii(e);
}
rule PassThruEntitySCorporation(e: Person) strict {
    label en official "an S corporation is a pass-thru entity (section 460(b)(4)(C)(ii)(II))";
    when entity_is_s_corporation_460b4Cii(e);
    then pass_thru_entity_460b4Cii(e);
}
rule PassThruEntityTrust(e: Person) strict {
    label en official "a trust is a pass-thru entity (section 460(b)(4)(C)(ii)(III))";
    when entity_is_trust_460b4Cii(e);
    then pass_thru_entity_460b4Cii(e);
}
pub relation share_of_beneficial_interests_held_by_five_or_fewer_persons_460b4Ciii(e: Person, ratio: Decimal) kind empirical {
    label en official "the part (by value) of the beneficial interests in the entity held directly or indirectly by or for 5 or fewer persons, with section 1563(e)-style constructive ownership, at some time in a year with income under the contract (section 460(b)(4)(C)(iii))";
}
pub relation closely_held_pass_thru_entity_460b4Ciii(e: Person) kind institutional {
    label en official "a closely held pass-thru entity: a pass-thru entity of which 50 percent or more (by value) of the beneficial interests are held by or for 5 or fewer persons (section 460(b)(4)(C)(iii))";
}
@source(IRC_S460_B, quote = "50 percent or more (by value) of the beneficial interests in such entity are held (directly or indirectly) by or for 5 or fewer persons.")
rule ClosedPassThruEntityFiveOrFewerHolders(e: Person, ratio: Decimal) strict {
    label en official "a pass-thru entity with at least half of its value held by 5 or fewer persons (section 460(b)(4)(C)(iii))";
    when pass_thru_entity_460b4Cii(e);
    when share_of_beneficial_interests_held_by_five_or_fewer_persons_460b4Ciii(e, ratio);
    when ratio >= 0.50;
    then closely_held_pass_thru_entity_460b4Ciii(e);
}
pub relation substantially_all_income_from_us_sources_460b4Bii(contract: Integer) kind empirical {
    label en official "substantially all of the income from the contract is from sources in the United States (section 460(b)(4)(B)(ii)); 'substantially all' is an adjudicated fact (DECISION-0194)";
}
pub relation contract_of_entity_460b4(e: Person, contract: Integer) kind empirical {
    label en official "the pass-thru entity is the party performing the contract";
}
pub relation simplified_look_back_applies_460b4(e: Person, contract: Integer) kind institutional {
    label en official "the simplified look-back method for pass-thru entities applies to the contract: the entity is a pass-thru entity that is not closely held, and substantially all of the contract income is from United States sources (section 460(b)(4)(A)-(B))";
}
@source(IRC_S460_B, quote = "This paragraph shall not apply to any closely held pass-thru entity.")
rule SimplifiedLookBackForPassThruEntities(e: Person, contract: Integer) defeasible {
    label en official "the paragraph (4) look-back applies to a pass-thru entity that is not closely held, for a contract with substantially all United States source income (section 460(b)(4))";
    when pass_thru_entity_460b4Cii(e);
    when contract_of_entity_460b4(e, contract);
    when substantially_all_income_from_us_sources_460b4Bii(contract);
    when not_known(closely_held_pass_thru_entity_460b4Ciii(e));
    then simplified_look_back_applies_460b4(e, contract);
}
pub relation look_back_applied_and_interest_settled_at_entity_level_460b4A(e: Person, contract: Integer) kind institutional {
    label en official "under the simplified method the look-back is applied at the entity level, and interest owed by the taxpayer is paid by the entity and interest due to the taxpayer is paid to the entity (section 460(b)(4)(A)(i), (iii))";
}
@source(IRC_S460_B, quote = "(i) the look-back method of paragraph (2) shall be applied at the entity level,")
rule LookBackAtEntityLevel(e: Person, contract: Integer) defeasible {
    label en official "the look-back is applied, and its interest paid or received, at the entity level (section 460(b)(4)(A)(i), (iii))";
    when simplified_look_back_applies_460b4(e, contract);
    then look_back_applied_and_interest_settled_at_entity_level_460b4A(e, contract);
}
pub relation highest_rate_section_11_460b4CiI(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the highest rate of tax specified in section 11 for the year; the rate schedule belongs to the corporations owner and is asserted (section 460(b)(4)(C)(i)(I))";
}
pub relation highest_rate_section_1_460b4CiII(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the highest rate of tax specified in section 1 for the year; asserted (section 460(b)(4)(C)(i)(II))";
}
pub relation more_than_half_of_interests_held_by_individuals_all_year_460b4CiII(e: Person, y: TaxableYear) kind empirical {
    label en official "at all times during the year more than 50 percent of the interests in the entity are held by individuals directly or through 1 or more other pass-thru entities (section 460(b)(4)(C)(i)(II))";
}
pub relation highest_rate_460b4C(e: Person, y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the highest rate: the section 1 rate when individuals hold more than half of the interests at all times in the year, otherwise the section 11 rate (section 460(b)(4)(C)(i))";
}
@source(IRC_S460_B, quote = "(II) if at all times during the year involved more than 50 percent of the interests in the entity are held by individuals directly or through 1 or more other pass-thru entities, the highest rate of tax specified in section 1.")
rule HighestRateIsSection1RateForIndividualHeldEntity(e: Person, y: TaxableYear, rate: Decimal) defeasible {
    label en official "an individual-held pass-thru entity uses the highest section 1 rate (section 460(b)(4)(C)(i)(II))";
    when pass_thru_entity_460b4Cii(e);
    when more_than_half_of_interests_held_by_individuals_all_year_460b4CiII(e, y);
    when highest_rate_section_1_460b4CiII(y, rate);
    then highest_rate_460b4C(e, y, rate);
}
@source(IRC_S460_B, quote = "(I) the highest rate of tax specified in section 11, or")
rule HighestRateIsSection11RateOtherwise(e: Person, y: TaxableYear, rate: Decimal) defeasible {
    label en official "any other pass-thru entity uses the highest section 11 rate (section 460(b)(4)(C)(i)(I))";
    when pass_thru_entity_460b4Cii(e);
    when not_known(more_than_half_of_interests_held_by_individuals_all_year_460b4CiII(e, y));
    when highest_rate_section_11_460b4CiI(y, rate);
    then highest_rate_460b4C(e, y, rate);
}
pub relation income_change_by_look_back_allocation_460b4Aii(e: Person, contract: Integer, y: TaxableYear, change: Money) kind empirical {
    label en official "the change in the contract income of the year caused by the section 460(b)(2)(A) allocation (positive: increase; negative: decrease) (section 460(b)(4)(A)(ii))";
}
pub relation look_back_underpayment_460b4Aii(e: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "an increase in contract income by the allocation is an underpayment equal to the highest rate times the increase, one rounding to cents HALF_UP (JUDGMENT CALL) (section 460(b)(4)(A)(ii)(I))";
}
@source(IRC_S460_B, quote = "shall be treated as giving rise to an underpayment determined by applying the highest rate for such year to such increase, and")
rule PassThruUnderpaymentFromIncomeIncrease(e: Person, contract: Integer, y: TaxableYear, change: Money, rate: Decimal) defeasible {
    label en official "underpayment = highest rate x increase (section 460(b)(4)(A)(ii)(I))";
    when simplified_look_back_applies_460b4(e, contract);
    when income_change_by_look_back_allocation_460b4Aii(e, contract, y, change);
    when highest_rate_460b4C(e, y, rate);
    when change > 0.00 USD;
    then look_back_underpayment_460b4Aii(e, contract, y, round(change * rate, 2, "HALF_UP"));
}
pub relation look_back_overpayment_460b4Aii(e: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "a decrease in contract income by the allocation is an overpayment equal to the highest rate times the decrease, one rounding to cents HALF_UP (JUDGMENT CALL) (section 460(b)(4)(A)(ii)(II))";
}
@source(IRC_S460_B, quote = "shall be treated as giving rise to an overpayment determined by applying the highest rate for such year to such decrease, and")
rule PassThruOverpaymentFromIncomeDecrease(e: Person, contract: Integer, y: TaxableYear, change: Money, rate: Decimal) defeasible {
    label en official "overpayment = highest rate x decrease (section 460(b)(4)(A)(ii)(II))";
    when simplified_look_back_applies_460b4(e, contract);
    when income_change_by_look_back_allocation_460b4Aii(e, contract, y, change);
    when highest_rate_460b4C(e, y, rate);
    when change < 0.00 USD;
    then look_back_overpayment_460b4Aii(e, contract, y, round((0.00 USD - change) * rate, 2, "HALF_UP"));
}
// --- (b)(5): the 10-percent method ---
pub relation elects_ten_percent_method_460b5(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects the 10-percent method for the taxable year (section 460(b)(5)(A), (C))";
}
pub relation uses_simplified_cost_allocation_procedure_460b5Di(p: Person) kind empirical {
    label en official "the taxpayer uses a simplified procedure for allocation of costs under paragraph (3)(A) (section 460(b)(5)(D)(i))";
}
pub relation taxpayer_may_elect_ten_percent_method_460b5(p: Person) kind institutional {
    label en official "the election is available: the taxpayer does not use a simplified cost allocation procedure (section 460(b)(5)(D)(i))";
}
rule TenPercentElectionAvailableWithoutSimplifiedProcedure(p: Person) strict {
    label en official "the 10-percent method is not open to a taxpayer using a simplified allocation procedure (section 460(b)(5)(D)(i))";
    when person_of_460_contracts(p);
    when not_known(uses_simplified_cost_allocation_procedure_460b5Di(p));
    then taxpayer_may_elect_ten_percent_method_460b5(p);
}
pub relation person_of_460_contracts(p: Person) kind empirical {
    label en official "the taxpayer has long-term contracts under section 460";
}
pub relation ten_percent_method_election_in_effect_460b5(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 460(b)(5) election is in effect for the taxable year in which it is made";
}
@source(IRC_S460_B, quote = "In the case of any long-term contract with respect to which an election under this paragraph is in effect, the 10-percent method shall apply in determining the taxable income from such contract.")
rule Section460b5TenPercentElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer may elect the 10-percent method (section 460(b)(5)); not available with a simplified allocation procedure";
    when elects_ten_percent_method_460b5(p, y);
    then power Section460b5TenPercentMethodElection {
        holder p;
        over y;
        exercise elects_ten_percent_method_460b5(p, y);
        valid_when taxpayer_may_elect_ten_percent_method_460b5(p);
        effect create(ten_percent_method_election_in_effect_460b5(p, y));
        window [@1986-10-22, infinity);
    };
}
pub relation contract_entered_into_on_460b5C(contract: Integer, d: Date) kind empirical {
    label en official "the date the long-term contract is entered into (section 460(b)(5)(C))";
}
pub relation ten_percent_method_applies_to_contract_460b5C(p: Person, contract: Integer) kind institutional {
    label en official "the election applies to all long-term contracts of the taxpayer entered into during the taxable year in which it is made or any later year (section 460(b)(5)(C)); date-keyed, like the continuation elections";
}
@source(IRC_S460_B, quote = "An election under this paragraph shall apply to all long-term contracts of the taxpayer which are entered into during the taxable year in which the election is made or any subsequent taxable year.")
rule TenPercentElectionAppliesToContractsEnteredFromTheElectionYear(p: Person, y0: TaxableYear, contract: Integer, d0: Date, entered: Date) defeasible {
    label en official "a contract entered into on or after the first day of the election year is covered (section 460(b)(5)(C))";
    when ten_percent_method_election_in_effect_460b5(p, y0);
    when us.irc.core::begins(y0, d0);
    when contract_entered_into_on_460b5C(contract, entered);
    when engaged_in_contract_460(p, contract);
    when entered >= d0;
    then ten_percent_method_applies_to_contract_460b5C(p, contract);
}
pub relation ten_percent_year_460b5Bii(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "the 10-percent year: the first taxable year as of the close of which at least 10 percent of the estimated total contract costs have been incurred (section 460(b)(5)(B)(ii))";
}
pub relation earlier_year_with_ten_percent_of_costs_460b5Bii(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "an earlier taxable year already had at least 10 percent of estimated total contract costs incurred (bridge for `first`)";
}
rule EarlierYearWithTenPercent(p: Person, contract: Integer, y: TaxableYear, y0: TaxableYear, pct0: Decimal, d0: Date, d: Date) defeasible {
    label en official "an earlier year (by begin date) reached 10 percent";
    when percentage_of_completion(p, contract, y0, pct0);
    when pct0 >= 0.10;
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d0 < d;
    then earlier_year_with_ten_percent_of_costs_460b5Bii(p, contract, y);
}
@source(IRC_S460_B, quote = "The term \"10-percent year\" means the 1st taxable year as of the close of which at least 10 percent of the estimated total contract costs have been incurred.")
rule TenPercentYearIsTheFirstYearAtTenPercent(p: Person, contract: Integer, y: TaxableYear, pct: Decimal) defeasible {
    label en official "the first year whose percentage of completion is at least 10 percent (section 460(b)(5)(B)(ii))";
    when percentage_of_completion(p, contract, y, pct);
    when pct >= 0.10;
    when not_known(earlier_year_with_ten_percent_of_costs_460b5Bii(p, contract, y));
    then ten_percent_year_460b5Bii(p, contract, y);
}
pub relation ten_percent_method_income_460b5B(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "cumulative income under the 10-percent method: nothing before the 10-percent year, and from that year the ordinary percentage-of-completion amount (items of earlier years fall into the 10-percent year) (section 460(b)(5)(B)(i))";
}
@source(IRC_S460_B, quote = "The 10-percent method is the percentage of completion method, modified so that any item which would otherwise be taken into account in computing taxable income with respect to a contract for any taxable year before the 10-percent year is taken into account in the 10-percent year.")
rule TenPercentMethodIncomeFromTheTenPercentYear(p: Person, contract: Integer, y: TaxableYear, y10: TaxableYear, d10: Date, d: Date, amount: Money) defeasible {
    label en official "in the 10-percent year and after, cumulative income is the percentage-of-completion amount (section 460(b)(5)(B)(i))";
    when ten_percent_method_applies_to_contract_460b5C(p, contract);
    when ten_percent_year_460b5Bii(p, contract, y10);
    when us.irc.core::begins(y10, d10);
    when us.irc.core::begins(y, d);
    when d >= d10;
    when percentage_of_completion_income(p, contract, y, amount);
    then ten_percent_method_income_460b5B(p, contract, y, amount);
}
rule TenPercentMethodIncomeBeforeTheTenPercentYear(p: Person, contract: Integer, y: TaxableYear, y10: TaxableYear, d10: Date, d: Date, amount: Money) defeasible {
    label en official "before the 10-percent year no item is taken into account: the amount is zero (section 460(b)(5)(B)(i))";
    when ten_percent_method_applies_to_contract_460b5C(p, contract);
    when ten_percent_year_460b5Bii(p, contract, y10);
    when us.irc.core::begins(y10, d10);
    when us.irc.core::begins(y, d);
    when d < d10;
    when percentage_of_completion_income(p, contract, y, amount);
    then ten_percent_method_income_460b5B(p, contract, y, 0 USD);
}

// --- (b)(6): de minimis election ---
pub relation elects_de_minimis_look_back_exclusion_460b6D(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects that the look-back method does not apply in de minimis cases (section 460(b)(6)(D))";
}
pub relation de_minimis_look_back_election_in_effect_460b6D(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 460(b)(6) election is in effect for the taxable year in which it is made";
}
@source(IRC_S460_B, quote = "This paragraph shall only apply if the taxpayer makes an election under this subparagraph.")
rule Section460b6DElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer may elect that the look-back method not apply in de minimis cases (section 460(b)(6)(D))";
    when elects_de_minimis_look_back_exclusion_460b6D(p, y);
    then power Section460b6DeMinimisElection {
        holder p;
        over y;
        exercise elects_de_minimis_look_back_exclusion_460b6D(p, y);
        valid_when person_of_460_contracts(p);
        effect create(de_minimis_look_back_election_in_effect_460b6D(p, y));
        window [@1986-10-22, infinity);
    };
}
pub relation contract_completed_on_460b6D(contract: Integer, d: Date) kind empirical {
    label en official "the date the long-term contract is completed (section 460(b)(6)(D))";
}
pub relation revocation_of_460b6D_election_effective_on(p: Person, d: Date) kind empirical {
    label en official "the Secretary consents to revocation of the election, effective on the date (section 460(b)(6)(D))";
}
pub relation revocation_before_completion_460b6D(p: Person, contract: Integer) kind institutional {
    label en official "the election was revoked, with the Secretary's consent, on or before the date the contract was completed";
}
rule RevocationOfDeMinimisElectionBeforeCompletion(p: Person, contract: Integer, done: Date, revoked: Date) defeasible {
    label en official "a consented revocation on or before completion ends coverage of the contract";
    when contract_completed_on_460b6D(contract, done);
    when revocation_of_460b6D_election_effective_on(p, revoked);
    when revoked <= done;
    then revocation_before_completion_460b6D(p, contract);
}
pub relation de_minimis_election_covers_contract_460b6D(p: Person, contract: Integer) kind institutional {
    label en official "the election applies to all long-term contracts completed during the year in which it is made or any later year, unless revoked with the Secretary's consent (section 460(b)(6)(D))";
}
@source(IRC_S460_B, quote = "Unless revoked with the consent of the Secretary, such an election shall apply to all long-term contracts completed during the taxable year for which election is made or during any subsequent taxable year.")
rule DeMinimisElectionCoversContractsCompletedFromTheElectionYear(p: Person, y0: TaxableYear, contract: Integer, d0: Date, done: Date) defeasible {
    label en official "contracts completed on or after the first day of the election year are covered unless the election was revoked (section 460(b)(6)(D))";
    when de_minimis_look_back_election_in_effect_460b6D(p, y0);
    when us.irc.core::begins(y0, d0);
    when contract_completed_on_460b6D(contract, done);
    when done >= d0;
    when not_known(revocation_before_completion_460b6D(p, contract));
    then de_minimis_election_covers_contract_460b6D(p, contract);
}
pub relation cumulative_taxable_income_under_contract_460b6(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cumulative taxable income (or loss) under the contract as of the close of the taxable year (section 460(b)(6)(A)(i), (B)(i))";
}
pub relation cumulative_look_back_income_at_close_460b6(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cumulative look-back taxable income (or loss) under the contract as of the close of the taxable year, on the (b)(2)(A) allocation and without the discounting of (b)(2), second sentence (section 460(b)(6)(C)(ii)-(iii))";
}
pub relation cumulative_look_back_income_at_most_recent_year_460b6A(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cumulative look-back taxable income (or loss) as of the close of the most recent taxable year to which paragraph (1)(B) applied, or would have applied but for subparagraph (B) (section 460(b)(6)(A)(ii))";
}
pub relation year_after_completion_year_460b6A(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year begins after the taxable year in which the contract is completed (section 460(b)(6)(A))";
}
pub relation look_back_not_required_for_late_amounts_460b6A(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "paragraph (1)(B) does not apply to the year after completion when the cumulative taxable income is within 10 percent of the cumulative look-back income of the most recent year to which it applied (section 460(b)(6)(A))";
}
@source(IRC_S460_B, quote = "Paragraph (1)(B) shall not apply with respect to any taxable year (beginning after the taxable year in which the contract is completed) if—")
rule DeMinimisLateAmountsWithinTenPercent(p: Person, contract: Integer, y: TaxableYear, cumulative: Money, recent: Money) defeasible {
    label en official "|cumulative income - most recent look-back income| <= 10 percent of |look-back income| (section 460(b)(6)(A)(i)-(ii)); 'within' is read as inclusive (JUDGMENT CALL)";
    when de_minimis_election_covers_contract_460b6D(p, contract);
    when year_after_completion_year_460b6A(p, contract, y);
    when cumulative_taxable_income_under_contract_460b6(p, contract, y, cumulative);
    when cumulative_look_back_income_at_most_recent_year_460b6A(p, contract, y, recent);
    when abs(cumulative - recent) <= abs(recent) * 0.10;
    then look_back_not_required_for_late_amounts_460b6A(p, contract, y);
}
pub relation contract_year_460b6Ci(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "income is taken into account under the contract for the taxable year: a contract year (section 460(b)(6)(C)(i))";
}
pub relation contract_year_outside_ten_percent_460b6B(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "a contract year whose cumulative taxable income is not within 10 percent of the cumulative look-back income (section 460(b)(6)(B))";
}
rule ContractYearOutsideTenPercent(p: Person, contract: Integer, y: TaxableYear, cumulative: Money, lookback: Money) defeasible {
    label en official "a contract year whose discrepancy exceeds 10 percent breaks the de minimis exclusion (section 460(b)(6)(B))";
    when contract_year_460b6Ci(p, contract, y);
    when cumulative_taxable_income_under_contract_460b6(p, contract, y, cumulative);
    when cumulative_look_back_income_at_close_460b6(p, contract, y, lookback);
    when abs(cumulative - lookback) > abs(lookback) * 0.10;
    then contract_year_outside_ten_percent_460b6B(p, contract, y);
}
pub relation contract_has_a_contract_year_outside_ten_percent_460b6B(p: Person, contract: Integer) kind institutional {
    label en official "some contract year is outside the 10-percent band (bridge)";
}
rule ContractHasYearOutsideTenPercentBridge(p: Person, contract: Integer, y: TaxableYear) defeasible {
    label en official "bridge";
    when contract_year_outside_ten_percent_460b6B(p, contract, y);
    then contract_has_a_contract_year_outside_ten_percent_460b6B(p, contract);
}
pub relation look_back_not_required_for_small_discrepancies_460b6B(p: Person, contract: Integer) kind institutional {
    label en official "paragraph (1)(B) does not apply when the cumulative taxable income of each prior contract year is within 10 percent of the cumulative look-back income of that year (section 460(b)(6)(B))";
}
@source(IRC_S460_B, quote = "Paragraph (1)(B) shall not apply in any case to which it would otherwise apply if—")
rule DeMinimisAllContractYearsWithinTenPercent(p: Person, contract: Integer, y: TaxableYear) defeasible {
    label en official "every contract year is within the 10-percent band (section 460(b)(6)(B)); at least one contract year must exist";
    when de_minimis_election_covers_contract_460b6D(p, contract);
    when contract_year_460b6Ci(p, contract, y);
    when not_known(contract_has_a_contract_year_outside_ten_percent_460b6B(p, contract));
    then look_back_not_required_for_small_discrepancies_460b6B(p, contract);
}
// --- (b)(7): the adjusted overpayment rate ---
pub relation return_due_date_without_extensions_460b7B(p: Person, y: TaxableYear, d: Date) kind empirical {
    label en official "the date prescribed for filing the return of the tax imposed by chapter 1 for the taxable year, without regard to extensions (section 460(b)(7)(B), last sentence)";
}
pub relation interest_accrual_period_460b7B(p: Person, y: TaxableYear, starts: Date, ends: Date) kind institutional {
    label en official "the interest accrual period following the taxable year: from the day after its return due date to the return due date of the following taxable year (section 460(b)(7)(B))";
}
@source(IRC_S460_B, quote = "(i) beginning on the day after the return due date for any taxable year of the taxpayer, and")
rule InterestAccrualPeriodBetweenReturnDueDates(p: Person, y: TaxableYear, y_next: TaxableYear, due: Date, due_next: Date) defeasible {
    label en official "the accrual period runs from the day after one return due date to the next (section 460(b)(7)(B)(i)-(ii))";
    when preceding_taxable_year_465(y, y_next);
    when return_due_date_without_extensions_460b7B(p, y, due);
    when return_due_date_without_extensions_460b7B(p, y_next, due_next);
    then interest_accrual_period_460b7B(p, y, add_calendar_period(due, 1 calendar_day), due_next);
}
pub relation overpayment_rate_in_effect_for_quarter_containing_460b7A(d: Date, rate: Decimal) kind empirical {
    label en official "the overpayment rate in effect under section 6621 for the calendar quarter that contains the date; the section 6621(a)(1) rate is a pending dependency on the payment-refunds-interest owner (no IRB value pinned)";
}
pub relation adjusted_overpayment_rate_460b7A(p: Person, y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the adjusted overpayment rate for the interest accrual period: the section 6621 overpayment rate for the calendar quarter in which the period begins (section 460(b)(7)(A))";
}
@source(IRC_S460_B, quote = "The adjusted overpayment rate for any interest accrual period is the overpayment rate in effect under section 6621 for the calendar quarter in which such interest accrual period begins.")
rule AdjustedOverpaymentRateForAccrualPeriod(p: Person, y: TaxableYear, starts: Date, ends: Date, rate: Decimal) defeasible {
    label en official "the rate for the quarter in which the accrual period begins (section 460(b)(7)(A))";
    when interest_accrual_period_460b7B(p, y, starts, ends);
    when overpayment_rate_in_effect_for_quarter_containing_460b7A(starts, rate);
    then adjusted_overpayment_rate_460b7A(p, y, rate);
}
