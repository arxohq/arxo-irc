// Section 460 — Special rules for long-term contracts. Stage 2b (IRC-07).
// Scope: (a) requirement to use the percentage of completion method; (b)(1)(A)
// the percentage-of-completion computation with intermediate values (costs
// allocated and incurred to date; estimated total contract costs; the
// percentage itself; cumulative income); (b)(1) second sentence's post-
// completion catch-up; (e)(1) the home-construction and small-contractor
// (2-year/section 448(c) gross-receipts-test) exemptions, reusing this
// package's own `meets_gross_receipts_test_448c`; (f)(1) the long-term-
// contract definition. NOT DONE (TECH-GAPS G325): (b)(2) the look-back
// method (a genuine multi-year actual-vs-estimated reallocation with
// compounded daily interest — the G1-class recursive-ledger gap flagged by
// the coordinator, not attempted); (b)(3)-(7) simplified cost allocation,
// pass-thru-entity look-back, the 10-percent method election, the de-minimis
// look-back election, and the adjusted-overpayment-rate definition; (c) cost
// allocation beyond the two case-fact inputs; (d) Federal long-term contract;
// (e)(2)-(5) gross-receipts-test-to-individuals coordination and the
// residential-construction-contract special rules; (f)(2)-(3) the
// manufacturing special rule and contract aggregation.

use self::{
    IRC_S460_A,
    IRC_S460_B,
    IRC_S460_E,
    Person,
    TaxableYear,
    meets_gross_receipts_test_448c,
};

pub relation is_long_term_contract(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "the contract is a long-term contract: for the manufacture, building, installation, or construction of property, not completed within the taxable year it was entered into (section 460(f)(1)) — read as a case fact; the (f)(2) manufacturing-contract special rule and (f)(3) aggregation are NOT modelled (TECH_GAP G325)";
}
pub relation costs_allocated_and_incurred_to_date(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "costs allocated to the contract under section 460(c) and incurred before the close of the taxable year (section 460(b)(1)(A)) — read as a case fact; the (c) cost-allocation rules themselves are NOT modelled (TECH_GAP G325)";
}
pub relation estimated_total_contract_costs(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the estimated total contract costs as of the close of the taxable year (section 460(b)(1)(A))";
}
pub relation percentage_of_completion(p: Person, contract: Integer, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the percentage of completion: costs allocated to the contract and incurred before the close of the taxable year, divided by the estimated total contract costs (section 460(b)(1)(A))";
}
@source(IRC_S460_B, quote = "the percentage of completion shall be determined by comparing costs allocated to the contract under subsection (c) and incurred before the close of the taxable year with the estimated total contract costs")
rule PercentageOfCompletionComputation(p: Person, contract: Integer, y: TaxableYear, incurred: Money, total_estimated: Money) defeasible {
    label en official "the percentage of completion is costs incurred to date divided by estimated total contract costs (section 460(b)(1)(A))";
    when percentage_completion_required(p, contract, y);
    when costs_allocated_and_incurred_to_date(p, contract, y, incurred);
    when estimated_total_contract_costs(p, contract, y, total_estimated);
    then percentage_of_completion(p, contract, y, div_round(incurred, total_estimated, 6, "HALF_UP"));
}
pub relation long_term_contract_price(p: Person, contract: Integer, amount: Money) kind empirical {
    label en official "the (estimated) total contract price of the long-term contract (section 460(b)(1)(A), implicit in the percentage-of-completion method)";
}
pub relation percentage_of_completion_income(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "cumulative taxable income from the contract recognized as of the close of the taxable year under the percentage of completion method: contract price times the percentage of completion (section 460(a), (b)(1)(A)). This is the CUMULATIVE figure; the current-year incremental amount (this year's cumulative minus the prior year's) is NOT separately derived (TECH_GAP G325).";
}
@source(IRC_S460_A, quote = "the taxable income from such contract shall be determined under the percentage of completion method (as modified by subsection (b))")
rule PercentageOfCompletionIncomeComputation(p: Person, contract: Integer, y: TaxableYear, price: Money, pct: Decimal) defeasible {
    label en official "cumulative percentage-of-completion income is the contract price times the percentage of completion (section 460(a)/(b)(1)(A))";
    when percentage_of_completion(p, contract, y, pct);
    when long_term_contract_price(p, contract, price);
    then percentage_of_completion_income(p, contract, y, round(price * pct, 2, "HALF_UP"));
}

// (b)(1) second sentence: post-completion catch-up of income not previously
// includible, for the year FOLLOWING completion.
pub relation long_term_contract_completed_in_year(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "the long-term contract was completed during the taxable year (section 460(b)(1) second sentence)";
}
pub relation income_not_previously_includible_under_contract(p: Person, contract: Integer, amount: Money) kind empirical {
    label en official "income under the contract not previously includible in gross income as of the completion of the contract (section 460(b)(1) second sentence)";
}
pub relation long_term_contract_post_completion_catch_up_income(p: Person, contract: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "income under a completed long-term contract not previously includible is included in gross income for the taxable year FOLLOWING the year of completion (section 460(b)(1) second sentence)";
}
@source(IRC_S460_B, quote = "any income under the contract (to the extent not previously includible in gross income) shall be included in gross income for the taxable year following the taxable year in which the contract was completed")
rule LongTermContractPostCompletionCatchUp(p: Person, contract: Integer, completion_y: TaxableYear, following_y: TaxableYear, amount: Money) strict {
    label en official "income not previously includible under a completed long-term contract is included in the following taxable year (section 460(b)(1) second sentence)";
    when long_term_contract_completed_in_year(p, contract, completion_y);
    when us.irc.core::year_of(p, following_y);
    when income_not_previously_includible_under_contract(p, contract, amount);
    when amount > 0.00 USD;
    then long_term_contract_post_completion_catch_up_income(p, contract, following_y, amount);
}
// (b)(2) look-back method (compounded-daily overpayment/underpayment interest
// across every prior contract year, using actual instead of estimated
// price/costs) is NOT modelled: TECH_GAP G325, the same class of genuine
// multi-year self-referential recomputation as the coordinator's own "G1"
// example. (b)(3)-(7) likewise NOT modelled.

// (e): exceptions for home-construction and certain other (small,
// short-duration) construction contracts.
pub relation is_home_construction_contract(p: Person, contract: Integer) kind empirical {
    label en official "80 percent or more of estimated total contract costs are reasonably expected to be attributable to dwelling units in buildings of 4 or fewer units, or directly related improvements (section 460(e)(5)(A)) — read as a case fact";
}
pub relation is_construction_contract(p: Person, contract: Integer) kind empirical {
    label en official "a contract for the building, construction, reconstruction, or rehabilitation of, or installation of an integral component to, or improvement of, real property (section 460(e)(3))";
}
pub relation estimated_completion_within_two_years_of_commencement(p: Person, contract: Integer) kind empirical {
    label en official "the taxpayer estimates, at the time the contract is entered into, that it will be completed within the 2-year period beginning on the contract commencement date (section 460(e)(1)(B)(i))";
}
pub relation is_tax_shelter_barred_from_cash_method_448a3(p: Person) kind empirical {
    label en official "the taxpayer is a tax shelter prohibited from using the cash receipts and disbursements method under section 448(a)(3) (section 460(e)(1)(B), parenthetical exclusion)";
}
pub relation percentage_completion_required(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en official "the section 460(a)-(c) percentage-of-completion requirement applies to the contract (i.e. it is a long-term contract not exempted by section 460(e)(1))";
}
@source(IRC_S460_E, quote = "Subsections (a), (b), and (c)(1) and (2) shall not apply to")
rule PercentageCompletionRequiredUnlessExempt(p: Person, contract: Integer, y: TaxableYear) defeasible {
    label en official "the percentage-of-completion requirement applies to a long-term contract unless it is a home-construction contract, or a small/short-duration other construction contract exempted by section 460(e)(1)";
    when is_long_term_contract(p, contract, y) and not_known(is_home_construction_contract(p, contract));
    unless small_construction_contract_exemption_460e1b(p, contract, y);
    then percentage_completion_required(p, contract, y);
}
relation small_construction_contract_exemption_460e1b(p: Person, contract: Integer, y: TaxableYear) kind institutional {
    label en unofficial "bridge: the section 460(e)(1)(B) other-construction-contract exemption (2-year estimate + section 448(c) gross-receipts test, not a barred tax shelter)";
}
@source(IRC_S460_E, quote = "who estimates (at the time such contract is entered into) that such contract will be completed within the 2-year period beginning on the contract commencement date of such contract, and")
rule SmallConstructionContractExemptionBridge(p: Person, contract: Integer, y: TaxableYear) strict {
    label en official "the section 460(e)(1)(B) exemption applies to a construction contract estimated to complete within 2 years, where the taxpayer meets the section 448(c) gross-receipts test and is not a barred tax shelter";
    when is_construction_contract(p, contract);
    when estimated_completion_within_two_years_of_commencement(p, contract);
    when meets_gross_receipts_test_448c(p, y);
    when not_known(is_tax_shelter_barred_from_cash_method_448a3(p));
    then small_construction_contract_exemption_460e1b(p, contract, y);
}
