// Sections 453A and 453B. Stage 2 (IRC-07), priority scope.
//
// 453A: (a)(1) general rule and (c) interest-on-deferred-tax-liability
// computation are modelled in full ((c)(1)-(4)); (a)(2)/(d) (pledging rules)
// and (b)(3)-(5) (personal-use/farm-property and timeshare/residential-lot
// exceptions) are NOT DONE (TECH-GAPS G324) — (b)(1)-(2) (the $150,000
// sales-price gate and the $5,000,000 aggregate-face-amount threshold) ARE
// modelled.
//
// 453B: (a) general rule and (b) basis-of-obligation are modelled in full;
// (c) (transmission at death, cross-referencing section 691) and (d)
// (section 337(a) distributions) are modelled as exclusions on the (a) rule;
// section 691's own income-in-respect-of-a-decedent treatment is an
// EXTERNAL_DEPENDENCY (owner: trusts-estates, no pub yet — accounting.deps.json).

// ============================================================================
// Section 453A — special rules for nondealers.
// ============================================================================

use self::{
    IRC_S453A_B,
    IRC_S453A_C,
    IRC_S453B_A,
    IRC_S453B_B,
    Person,
    TaxableYear,
    obligation_excepted_from_453a_453Ab,
};

pub relation is_installment_obligation_from_disposition(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the obligation arises from the disposition of property under the installment method (section 453A(b)(1))";
}
pub relation installment_obligation_sales_price(p: Person, obligation: Integer, amount: Money) kind empirical {
    label en official "the sales price of the property disposed of under the obligation (section 453A(b)(1), (b)(5))";
}
pub relation installment_obligation_outstanding_at_close_of_year(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the obligation is outstanding as of the close of the taxable year (section 453A(b)(2)(A))";
}
pub relation aggregate_face_amount_of_years_obligations(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the face amount of all section 453A(b)(1) obligations held by the taxpayer which arose during, and are outstanding as of the close of, the taxable year (section 453A(b)(2)(B))";
}
pub relation section_453a_applies_to_obligation(p: Person, obligation: Integer, y: TaxableYear) kind institutional {
    label en official "section 453A applies to the installment obligation for the taxable year (section 453A(a), (b)(1)-(2))";
}
@source(IRC_S453A_B, quote = "This section shall apply to any obligation which arises from the disposition of any property under the installment method, but only if the sales price of such property exceeds $150,000.")
rule Section453AAppliesGate(p: Person, obligation: Integer, y: TaxableYear, sales_price: Money, aggregate: Money) strict {
    label en official "section 453A applies to an obligation arising from an installment-method disposition with a sales price exceeding $150,000, outstanding at year end, when the taxpayer's aggregate face amount of such obligations for the year exceeds $5,000,000 (section 453A(b)(1)-(2))";
    when is_installment_obligation_from_disposition(p, obligation, y);
    when installment_obligation_sales_price(p, obligation, sales_price);
    when sales_price > 150000.00 USD;
    when installment_obligation_outstanding_at_close_of_year(p, obligation, y);
    when aggregate_face_amount_of_years_obligations(p, y, aggregate);
    when aggregate > 5000000.00 USD;
    when not_known(obligation_excepted_from_453a_453Ab(p, obligation));
    then section_453a_applies_to_obligation(p, obligation, y);
}

// (c): interest on deferred tax liability.
pub relation obligation_gain_not_yet_recognized(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of gain with respect to the obligation which has not been recognized as of the close of the taxable year (section 453A(c)(3)(A))";
}
pub relation maximum_rate_of_tax_under_section_1_or_11(p: Person, y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the maximum rate of tax in effect under section 1 or 11, whichever is appropriate, for the taxable year (section 453A(c)(3)(B)) — read as a case fact; the section 1/11 rate schedules are us.irc.income-individual/us.irc.corporations' own norm, not re-derived here";
}
pub relation deferred_tax_liability(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deferred tax liability: unrecognized gain times the maximum section 1 or 11 rate for the year (section 453A(c)(3))";
}
@source(IRC_S453A_C, quote = "the term \"deferred tax liability\" means, with respect to any taxable year, the product of")
rule DeferredTaxLiabilityComputation(p: Person, obligation: Integer, y: TaxableYear, gain: Money, rate: Decimal) strict {
    label en official "deferred tax liability is unrecognized gain times the maximum rate of tax under section 1 or 11 (section 453A(c)(3))";
    when section_453a_applies_to_obligation(p, obligation, y);
    when obligation_gain_not_yet_recognized(p, obligation, y, gain);
    when maximum_rate_of_tax_under_section_1_or_11(p, y, rate);
    then deferred_tax_liability(p, obligation, y, round(gain * rate, 2, "HALF_UP"));
}
pub relation applicable_percentage_453a(p: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the applicable percentage: the portion of the aggregate face amount of the year's obligations in excess of $5,000,000, divided by the aggregate face amount (section 453A(c)(4)) — read as a case fact this stage (the excess/aggregate ratio is arithmetic the taxpayer supplies, not separately re-derived from aggregate_face_amount_of_years_obligations)";
}
pub relation section_453a_interest_for_year(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest for the taxable year on the deferred tax liability of the obligation: the applicable percentage of the deferred tax liability, times the section 6621(a)(2) underpayment rate for the month with or within which the taxable year ends (section 453A(c)(1)-(2))";
}
@source(IRC_S453A_C, quote = "the interest for any taxable year shall be an amount equal to the product of")
rule Section453AInterestComputation(p: Person, obligation: Integer, y: TaxableYear, pct: Decimal, dtl: Money, short_term_rate: Decimal, quarter_start: Date) strict {
    label en official "the section 453A(c) interest is the applicable percentage of the deferred tax liability, times the section 6621(a)(2) rate (Federal short-term rate plus 3 percentage points) for the month the taxable year ends";
    when applicable_percentage_453a(p, y, pct);
    when deferred_tax_liability(p, obligation, y, dtl);
    when us.irc.payment_refunds_interest::federal_short_term_rate(quarter_start, short_term_rate);
    then section_453a_interest_for_year(p, obligation, y, round(pct * round(dtl * (short_term_rate + 3.0) / 100.0, 2, "HALF_UP"), 2, "HALF_UP"));
}
// The federal_short_term_rate SOURCE_GAP (no IRB value pinned) and the
// month-with-or-within-which-the-year-ends quarter selection (a calendar
// lookup this stage does not wire in) mean `quarter_start` above must be
// supplied by the case — TECH_GAP G324.

// ============================================================================
// Section 453B — gain or loss on disposition of installment obligations.
// ============================================================================

pub relation installment_obligation_basis(p: Person, obligation: Integer, amount: Money) kind institutional {
    label en official "the basis of an installment obligation: the excess of its face value over the income that would be returnable were it satisfied in full (section 453B(b))";
}
pub relation installment_obligation_face_value(p: Person, obligation: Integer, amount: Money) kind empirical {
    label en official "the face value of the installment obligation (section 453B(b))";
}
pub relation income_returnable_if_satisfied_in_full(p: Person, obligation: Integer, amount: Money) kind empirical {
    label en official "the income which would be returnable were the installment obligation satisfied in full (section 453B(b))";
}
@source(IRC_S453B_B, quote = "The basis of an installment obligation shall be the excess of the face value of the obligation over an amount equal to the income which would be returnable were the obligation satisfied in full.")
rule InstallmentObligationBasisComputation(p: Person, obligation: Integer, face: Money, returnable_income: Money) strict {
    label en official "installment obligation basis is face value minus the income that would be returnable on full satisfaction (section 453B(b))";
    when installment_obligation_face_value(p, obligation, face);
    when income_returnable_if_satisfied_in_full(p, obligation, returnable_income);
    then installment_obligation_basis(p, obligation, face - returnable_income);
}

pub relation installment_obligation_satisfied_at_other_than_face_value_or_sold(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the installment obligation is satisfied at other than its face value, or sold or exchanged (section 453B(a))";
}
pub relation installment_obligation_distributed_transmitted_or_disposed_otherwise(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the installment obligation is distributed, transmitted, or otherwise disposed of, other than by sale or exchange (section 453B(a)(2))";
}
pub relation amount_realized_on_obligation_satisfaction_or_sale(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount realized on satisfaction at other than face value, or on a sale or exchange, of the obligation (section 453B(a)(1))";
}
pub relation obligation_fair_market_value_at_distribution(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the obligation at the time of distribution, transmission, or disposition (section 453B(a)(2))";
}
pub relation transmission_at_death_excluded_under_453b_c(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the disposition is a transmission of the obligation at death, outside section 691 income in respect of a decedent (section 453B(c)) — the section 691 IRD carve-back itself is an EXTERNAL_DEPENDENCY (owner: trusts-estates)";
}
pub relation section_337a_distribution_excluded_under_453b_d(p: Person, obligation: Integer, y: TaxableYear) kind empirical {
    label en official "the distribution is one to which section 337(a) applies (section 453B(d))";
}
pub relation installment_obligation_disposition_gain(p: Person, obligation: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "gain or loss resulting on satisfaction, sale, exchange, distribution, transmission, or other disposition of an installment obligation: the difference between the basis of the obligation and the amount realized (satisfaction/sale) or fair market value (other disposition) (section 453B(a)). A negative amount is a loss; the gain or loss is considered as resulting from the sale or exchange of the property for which the obligation was received.";
}
@source(IRC_S453B_A, quote = "gain or loss shall result to the extent of the difference between the basis of the obligation and")
rule InstallmentObligationDispositionGainOnSatisfactionOrSale(p: Person, obligation: Integer, y: TaxableYear, basis: Money, realized: Money) defeasible {
    label en official "gain or loss on satisfaction at other than face value, or a sale or exchange, of an installment obligation is the amount realized minus the obligation's basis (section 453B(a)(1))";
    when installment_obligation_satisfied_at_other_than_face_value_or_sold(p, obligation, y);
    when installment_obligation_basis(p, obligation, basis);
    when amount_realized_on_obligation_satisfaction_or_sale(p, obligation, y, realized) and not_known(transmission_at_death_excluded_under_453b_c(p, obligation, y)) and not_known(section_337a_distribution_excluded_under_453b_d(p, obligation, y));
    then installment_obligation_disposition_gain(p, obligation, y, realized - basis);
}
@source(IRC_S453B_A, quote = "the fair market value of the obligation at the time of distribution, transmission, or disposition, in the case of the distribution, transmission, or disposition otherwise than by sale or exchange")
rule InstallmentObligationDispositionGainOnOtherDisposition(p: Person, obligation: Integer, y: TaxableYear, basis: Money, fmv: Money) defeasible {
    label en official "gain or loss on a distribution, transmission, or other disposition of an installment obligation (other than by sale or exchange) is the fair market value at that time minus the obligation's basis (section 453B(a)(2))";
    when installment_obligation_distributed_transmitted_or_disposed_otherwise(p, obligation, y);
    when installment_obligation_basis(p, obligation, basis);
    when obligation_fair_market_value_at_distribution(p, obligation, y, fmv) and not_known(transmission_at_death_excluded_under_453b_c(p, obligation, y)) and not_known(section_337a_distribution_excluded_under_453b_d(p, obligation, y));
    then installment_obligation_disposition_gain(p, obligation, y, fmv - basis);
}
