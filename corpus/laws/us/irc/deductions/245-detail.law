// Sections 245, 245A, 246 and 246A — stage 2c detail (TECH_GAPS G2701, G2725-G2732): (245)(a) the qualified
// 10-percent owned foreign corporation, the post-1986 undistributed earnings, the United States source
// portion and its consequences, (245)(c) the FSC dividends; (245A)(c) the undistributed earnings and the tiered
// hybrid dividend of (e)(2); (246)(a)(2) the Federal Home Loan Bank dividends, (246)(c) the holding period count,
// the reduction for diminished risk and the extent of a related-payments obligation, (246)(d) DISC dividends;
// (246A)(c),(d),(e) portfolio stock, the base period, portfolio indebtedness and the interest limit.
//
// Stage 1 interface changes (recorded): `dividend_from_qualified_10_percent_owned_foreign_corporation`,
// `post_1986_undistributed_us_earnings`, `post_1986_undistributed_earnings`, `undistributed_foreign_earnings_245a`,
// `total_undistributed_earnings_245a`, `days_held_in_holding_window_246c`, `stock_is_portfolio_stock` and
// `portfolio_indebtedness_at_some_time_in_base_period` are now institutional (derived below, or still asserted by a
// case). The stage 1 rules of the per-dividend deductions read `dividend_amount_for_deduction` (the dividend, or the
// part left after a related-payments obligation or a Federal Home Loan Bank dividend), and carry `not_known` guards
// for the treaty election, the FSC accumulated earnings, the Federal Home Loan Bank portion and the interest limit.
//
// JUDGMENT CALLS: (1) the holding window of section 246(c) is the ex-dividend date minus and plus the threshold in
// days (45, 90 or 365), which gives the 91-, 181- and 731-day periods of the statute; (2) the ownership percentages of
// section 246A(c) are computed without section 1504(a)(4) stock, as paragraph (4) directs, and the option stock of a
// bank or bank holding company is added to the vote percentage; (3) the earnings of a foreign corporation for
// section 245(a)(3) are the accumulated earnings at the close plus the dividends distributed in the year, less the
// earnings before the qualification period and the earnings covered by subsection (b); (4) amounts are rounded to
// cents HALF_UP.
// Not modelled: the regulations that determine the average indebtedness and the reduction of holding periods (facts of
// the case) and the section 1092(c)(4) test of a qualified covered call (a fact of the case).

// === §245(a): qualified 10-percent owned foreign corporation ==========================================================

use self::{
    Corporation,
    IRC_S245A_C,
    IRC_S245A_E,
    IRC_S245_A,
    IRC_S245_C,
    IRC_S246A_C,
    IRC_S246A_D,
    IRC_S246A_E,
    IRC_S246_A,
    IRC_S246_C,
    IRC_S246_D,
    TaxableYear,
    average_adjusted_basis_of_portfolio_stock,
    average_portfolio_indebtedness,
    days_held_in_holding_window_246c,
    debt_financed_portfolio_stock,
    dividend_eligible_for_243_source,
    dividend_from_20_percent_owned_corporation,
    dividend_from_qualified_10_percent_owned_foreign_corporation,
    dividend_received_by_corporation,
    dividends_received_deduction_243_item,
    dividends_received_deduction_disallowed_246,
    dividends_received_deduction_percentage_243,
    holding_period_threshold_days_246c,
    obligated_to_make_related_payments_246c1b,
    payor_exempt_under_501_or_521_in_current_or_preceding_year,
    portfolio_indebtedness_at_some_time_in_base_period,
    post_1986_undistributed_earnings,
    post_1986_undistributed_us_earnings,
    stock_is_portfolio_stock,
    total_undistributed_earnings_245a,
    undistributed_foreign_earnings_245a,
};

pub relation dividend_payor_is_foreign_corporation(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is paid by a foreign corporation (section 245(a)(2))";
}
pub relation dividend_payor_is_passive_foreign_investment_company(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the foreign corporation is a passive foreign investment company (section 245(a)(2))";
}
pub relation taxpayer_owns_percent_of_payor_by_vote(c: Corporation, y: TaxableYear, item: Integer, pct: Decimal) kind empirical {
    label en official "the percentage of the total voting power of the payor's stock owned by the taxpayer";
}
pub relation taxpayer_owns_percent_of_payor_by_value(c: Corporation, y: TaxableYear, item: Integer, pct: Decimal) kind empirical {
    label en official "the percentage of the total value of the payor's stock owned by the taxpayer";
}
@source(IRC_S245_A, quote = "the term \"qualified 10-percent owned foreign corporation\" means any foreign corporation (other than a passive foreign investment company) if at least 10 percent of the stock of such corporation (by vote and value) is owned by the taxpayer.")
rule QualifiedTenPercentOwnedForeignCorporation(c: Corporation, y: TaxableYear, item: Integer, vote: Decimal, value: Decimal) strict {
    label en official "a foreign corporation other than a PFIC of which the taxpayer owns at least 10 percent by vote and value";
    when dividend_payor_is_foreign_corporation(c, y, item);
    when not_known(dividend_payor_is_passive_foreign_investment_company(c, y, item));
    when taxpayer_owns_percent_of_payor_by_vote(c, y, item, vote);
    when taxpayer_owns_percent_of_payor_by_value(c, y, item, value);
    when vote >= 10.0;
    when value >= 10.0;
    then dividend_from_qualified_10_percent_owned_foreign_corporation(c, y, item);
}

// --- (a)(4),(6),(7): post-1986 undistributed earnings ---------------------------------------------------------------------

pub relation foreign_corporation_accumulated_earnings_post_1986_at_close(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the earnings and profits of the foreign corporation, computed under sections 964(a) and 986, accumulated in taxable years beginning after December 31, 1986 as of the close of its taxable year of the distribution (section 245(a)(4)(A))";
}
pub relation foreign_corporation_dividends_distributed_in_year(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the dividends distributed by the foreign corporation during its taxable year, by which the earnings are not diminished (section 245(a)(4)(B))";
}
pub relation earnings_before_qualification_period(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the earnings of periods before the first day the requirements of paragraph (2) were met, when that day is in a taxable year beginning after December 31, 1986 (section 245(a)(6)); zero otherwise";
}
pub relation earnings_covered_by_245b_deduction(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the earnings and profits paid out of which the deduction of subsection (b) would be allowable, not taken into account under subsection (a) (section 245(a)(7)); zero otherwise";
}
@source(IRC_S245_A, quote = "The term \"post-1986 undistributed earnings\" means the amount of the earnings and profits of the foreign corporation (computed in accordance with sections 964(a) and 986) accumulated in taxable years beginning after December 31, 1986—")
rule Post1986UndistributedEarningsDerived(c: Corporation, y: TaxableYear, item: Integer, accumulated: Money, distributed: Money, before: Money, covered: Money) strict {
    label en official "the accumulated earnings plus the dividends distributed in the year, less the earnings before the qualification period and the subsection (b) earnings; an amount asserted by a case is still accepted";
    when foreign_corporation_accumulated_earnings_post_1986_at_close(c, y, item, accumulated);
    when foreign_corporation_dividends_distributed_in_year(c, y, item, distributed);
    when earnings_before_qualification_period(c, y, item, before);
    when earnings_covered_by_245b_deduction(c, y, item, covered);
    then post_1986_undistributed_earnings(c, y, item, max(0.00 USD, accumulated + distributed - before - covered));
}

// --- (a)(5),(12): post-1986 undistributed U.S. earnings ---------------------------------------------------------------------

pub relation earnings_attributable_to_effectively_connected_income_245a5A(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the part of the post-1986 undistributed earnings attributable to income effectively connected with a United States trade or business and subject to tax under this chapter (section 245(a)(5)(A))";
}
pub relation earnings_attributable_to_dividends_from_80_percent_domestic_corporation_245a5B(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the part attributable to a dividend received, directly or through a wholly owned foreign corporation, from a domestic corporation at least 80 percent of the stock of which is owned by the qualified 10-percent owned foreign corporation (section 245(a)(5)(B))";
}
pub relation domestic_corporation_dividend_payor_is_ric_or_reit(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the domestic corporation paying the dividend of clause (B) is a regulated investment company or a real estate investment trust (section 245(a)(12))";
}
@source(IRC_S245_A, quote = "Regulated investment companies and real estate investment trusts shall not be treated as domestic corporations for purposes of paragraph (5)(B).")
rule Post1986UndistributedUsEarningsWithoutDividends(c: Corporation, y: TaxableYear, item: Integer, eci: Money, covered: Money) strict {
    label en official "the effectively connected earnings only, when the domestic payor is a RIC or REIT (JUDGMENT CALL: the subsection (b) earnings are effectively connected and are left out)";
    when earnings_attributable_to_effectively_connected_income_245a5A(c, y, item, eci);
    when earnings_covered_by_245b_deduction(c, y, item, covered);
    when domestic_corporation_dividend_payor_is_ric_or_reit(c, y, item);
    then post_1986_undistributed_us_earnings(c, y, item, max(0.00 USD, eci - covered));
}
@source(IRC_S245_A, quote = "means the portion of the post-1986 undistributed earnings which is attributable to—")
rule Post1986UndistributedUsEarningsWithDividends(c: Corporation, y: TaxableYear, item: Integer, eci: Money, dividends: Money, covered: Money) strict {
    label en official "the effectively connected earnings plus the earnings from dividends of an 80-percent domestic subsidiary";
    when earnings_attributable_to_effectively_connected_income_245a5A(c, y, item, eci);
    when earnings_attributable_to_dividends_from_80_percent_domestic_corporation_245a5B(c, y, item, dividends);
    when earnings_covered_by_245b_deduction(c, y, item, covered);
    when not_known(domestic_corporation_dividend_payor_is_ric_or_reit(c, y, item));
    then post_1986_undistributed_us_earnings(c, y, item, max(0.00 USD, eci + dividends - covered));
}

// --- (a)(3),(8),(9),(10): the U.S.-source portion and its consequences ------------------------------------------------------

pub relation us_source_portion_of_dividend_245a3(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the U.S.-source portion of the dividend: the dividend times the ratio of the post-1986 undistributed U.S. earnings to the total post-1986 undistributed earnings (section 245(a)(3))";
}
@source(IRC_S245_A, quote = "the U.S.-source portion of any dividend is an amount which bears the same ratio to such dividend as—")
rule UsSourcePortionOfDividend(c: Corporation, y: TaxableYear, item: Integer, amount: Money, us_earn: Money, total_earn: Money) strict {
    label en official "the dividend times the ratio of the U.S. earnings to the total earnings";
    when dividend_received_by_corporation(c, y, item, amount);
    when dividend_from_qualified_10_percent_owned_foreign_corporation(c, y, item);
    when post_1986_undistributed_us_earnings(c, y, item, us_earn);
    when post_1986_undistributed_earnings(c, y, item, total_earn);
    when total_earn > 0.00 USD;
    then us_source_portion_of_dividend_245a3(c, y, item, round(amount * (us_earn / total_earn), 2, "HALF_UP"));
}
pub relation foreign_tax_credit_disallowed_for_us_source_portion_245a8(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "no credit under section 901 for taxes paid or accrued with respect to the United States-source portion of the dividend (section 245(a)(8))";
}
@source(IRC_S245_A, quote = "No credit shall be allowed under section 901 for any taxes paid or accrued (or treated as paid or accrued) with respect to the United States-source portion of any dividend received by a corporation from a qualified 10-percent-owned foreign corporation.")
rule ForeignTaxCreditDisallowedUsSourcePortion(c: Corporation, y: TaxableYear, item: Integer, portion: Money) strict {
    label en official "a positive U.S.-source portion carries no foreign tax credit";
    when us_source_portion_of_dividend_245a3(c, y, item, portion);
    when portion > 0.00 USD;
    then foreign_tax_credit_disallowed_for_us_source_portion_245a8(c, y, item);
}
pub relation us_source_portion_treated_as_united_states_source_for_904(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "for section 904 the U.S.-source portion of the dividend is treated as from sources in the United States (section 245(a)(9))";
}
@source(IRC_S245_A, quote = "For purposes of section 904, the U.S.-source portion of any dividend received by a corporation from a qualified 10-percent owned foreign corporation shall be treated as from sources in the United States.")
rule UsSourcePortionSourcedInUnitedStatesFor904(c: Corporation, y: TaxableYear, item: Integer, portion: Money) strict {
    label en official "the U.S.-source portion is United States source income for section 904";
    when us_source_portion_of_dividend_245a3(c, y, item, portion);
    then us_source_portion_treated_as_united_states_source_for_904(c, y, item, portion);
}
pub relation portion_would_be_foreign_source_under_treaty_245a10(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "under a treaty obligation of the United States, applied without regard to section 245(a), the portion would be treated as arising from sources outside the United States (section 245(a)(10)(B))";
}
pub relation taxpayer_chooses_245a10_treaty_benefits(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer chooses the benefits of paragraph (10) (section 245(a)(10)(C))";
}
pub relation subsection_245a_not_applicable_by_treaty_election(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "subsection (a) does not apply to the dividend, sections 904(a),(b),(c), 907 and 960 being applied separately to the portion (section 245(a)(10))";
}
@source(IRC_S245_A, quote = "this subsection shall not apply to such dividend (but subsections (a), (b), and (c) of section 904 and sections 907 and 960 shall be applied separately with respect to such portion of such dividend).")
rule SubsectionNotApplicableByTreatyElection(c: Corporation, y: TaxableYear, item: Integer, portion: Money) strict {
    label en official "a positive U.S.-source portion, foreign source under a treaty, and the taxpayer's choice";
    when us_source_portion_of_dividend_245a3(c, y, item, portion);
    when portion > 0.00 USD;
    when portion_would_be_foreign_source_under_treaty_245a10(c, y, item);
    when taxpayer_chooses_245a10_treaty_benefits(c, y, item);
    then subsection_245a_not_applicable_by_treaty_election(c, y, item);
}

// === §245(c): dividends from a FSC ========================================================================================

pub relation dividend_out_of_fsc_earnings_attributable_to_foreign_trade_income(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is distributed out of earnings and profits attributable to foreign trade income for a period during which the payor was a FSC (section 245(c)(1)(A))";
}
pub relation dividend_out_of_fsc_earnings_attributable_to_effectively_connected_income(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is distributed out of earnings and profits attributable to effectively connected income received or accrued by the payor while it was a FSC (section 245(c)(1)(B))";
}
pub relation fsc_income_effectively_connected_and_subject_to_tax(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the income is effectively connected, or treated as effectively connected, with the conduct of a trade or business in the United States and is subject to tax under this chapter (section 245(c)(4)(B))";
}
pub relation fsc_income_is_foreign_trade_income(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the income is foreign trade income within the meaning of section 923 as in effect before its repeal (section 245(c)(4)(A),(5))";
}
pub relation fsc_effectively_connected_income(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "effectively connected income for section 245(c): effectively connected and taxable income, other than foreign trade income (section 245(c)(4)(B))";
}
@source(IRC_S245_C, quote = "The term \"effectively connected income\" means any income which is effectively connected (or treated as effectively connected) with the conduct of a trade or business in the United States and is subject to tax under this chapter.")
rule FscEffectivelyConnectedIncome(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "effectively connected and taxable, and not foreign trade income";
    when fsc_income_effectively_connected_and_subject_to_tax(c, y, item);
    when not_known(fsc_income_is_foreign_trade_income(c, y, item));
    then fsc_effectively_connected_income(c, y, item);
}
pub relation fsc_income_is_923a2_nonexempt_income(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the earnings are attributable to section 923(a)(2) nonexempt income within the meaning of section 927(d)(6) (section 245(c)(2)(A))";
}
pub relation fsc_income_exempt_only_by_reason_of_923a4(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the income would not, but for section 923(a)(4), be treated as exempt foreign trade income (section 245(c)(2)(B))";
}
pub relation dividends_received_deduction_245c_item(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the section 245(c) deduction for a dividend out of the earnings of a FSC";
}
@source(IRC_S245_C, quote = "(A) 100 percent of any dividend received from another corporation which is distributed out of earnings and profits attributable to foreign trade income for a period during which such other corporation was a FSC, and")
rule DividendsReceivedDeduction245cForeignTradeIncome(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "100 percent of a dividend out of earnings attributable to foreign trade income, unless the earnings are nonexempt income or exempt only by reason of section 923(a)(4)";
    when dividend_received_by_corporation(c, y, item, amount);
    when dividend_out_of_fsc_earnings_attributable_to_foreign_trade_income(c, y, item);
    when not_known(fsc_income_is_923a2_nonexempt_income(c, y, item));
    when not_known(fsc_income_exempt_only_by_reason_of_923a4(c, y, item));
    when not_known(dividends_received_deduction_disallowed_246(c, y, item));
    then dividends_received_deduction_245c_item(c, y, item, amount);
}
@source(IRC_S245_C, quote = "(B) 50 percent (65 percent in the case of dividends from a 20-percent owned corporation as defined in section 243(c)(2)) of any dividend received from another corporation which is distributed out of earnings and profits attributable to effectively connected income received or accrued by such other corporation while such other corporation was a FSC.")
rule DividendsReceivedDeduction245cEffectivelyConnectedFifty(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "50 percent of a dividend out of effectively connected earnings";
    when dividend_received_by_corporation(c, y, item, amount);
    when dividend_out_of_fsc_earnings_attributable_to_effectively_connected_income(c, y, item);
    when fsc_effectively_connected_income(c, y, item);
    when not_known(dividend_from_20_percent_owned_corporation(c, y, item));
    when not_known(dividends_received_deduction_disallowed_246(c, y, item));
    then dividends_received_deduction_245c_item(c, y, item, round(amount * 0.50, 2, "HALF_UP"));
}
@source(IRC_S245_C, quote = "(B) 50 percent (65 percent in the case of dividends from a 20-percent owned corporation as defined in section 243(c)(2)) of any dividend received from another corporation which is distributed out of earnings and profits attributable to effectively connected income received or accrued by such other corporation while such other corporation was a FSC.")
rule DividendsReceivedDeduction245cEffectivelyConnectedSixtyFive(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "65 percent of a dividend out of effectively connected earnings from a 20-percent owned corporation";
    when dividend_received_by_corporation(c, y, item, amount);
    when dividend_out_of_fsc_earnings_attributable_to_effectively_connected_income(c, y, item);
    when fsc_effectively_connected_income(c, y, item);
    when dividend_from_20_percent_owned_corporation(c, y, item);
    when not_known(dividends_received_deduction_disallowed_246(c, y, item));
    then dividends_received_deduction_245c_item(c, y, item, round(amount * 0.65, 2, "HALF_UP"));
}
pub relation dividend_out_of_earnings_accumulated_while_fsc(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is distributed out of earnings and profits of a corporation accumulated while it was a FSC (section 245(c)(3))";
}
pub relation deduction_under_245a_or_245b_denied_for_fsc_earnings(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "no deduction under subsection (a) or (b) for a dividend out of the earnings accumulated while the payor was a FSC (section 245(c)(3))";
}
@source(IRC_S245_C, quote = "No deduction shall be allowable under subsection (a) or (b) with respect to any dividend which is distributed out of earnings and profits of a corporation accumulated while such corporation was a FSC.")
rule DeductionUnder245aOr245bDeniedForFscEarnings(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "a dividend out of FSC earnings is outside subsections (a) and (b)";
    when dividend_out_of_earnings_accumulated_while_fsc(c, y, item);
    then deduction_under_245a_or_245b_denied_for_fsc_earnings(c, y, item);
}

// === §245A(c): undistributed earnings; (e)(2): tiered hybrid dividends ===================================================

pub relation specified_corporation_earnings_at_close_245A(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the earnings and profits of the specified 10-percent owned foreign corporation, computed under sections 964(a) and 986, as of the close of its taxable year of the distribution (section 245A(c)(2)(A))";
}
pub relation specified_corporation_dividends_distributed_in_year_245A(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the dividends distributed during the year, by which the earnings are not diminished (section 245A(c)(2)(B))";
}
@source(IRC_S245A_C, quote = "The term \"undistributed earnings\" means the amount of the earnings and profits of the specified 10-percent owned foreign corporation (computed in accordance with sections 964(a) and 986)—")
rule UndistributedEarnings245ADerived(c: Corporation, y: TaxableYear, item: Integer, close: Money, distributed: Money) strict {
    label en official "the earnings at the close plus the dividends distributed in the year; an amount asserted by a case is still accepted";
    when specified_corporation_earnings_at_close_245A(c, y, item, close);
    when specified_corporation_dividends_distributed_in_year_245A(c, y, item, distributed);
    then total_undistributed_earnings_245a(c, y, item, close + distributed);
}
@source(IRC_S245A_C, quote = "The term \"undistributed foreign earnings\" means the portion of the undistributed earnings which is attributable to neither—")
rule UndistributedForeignEarnings245ADerived(c: Corporation, y: TaxableYear, item: Integer, total: Money, eci: Money, dividends: Money) strict {
    label en official "the undistributed earnings less the income of section 245(a)(5)(A) and the dividends of section 245(a)(5)(B), determined without regard to section 245(a)(12); an amount asserted by a case is still accepted";
    when total_undistributed_earnings_245a(c, y, item, total);
    when earnings_attributable_to_effectively_connected_income_245a5A(c, y, item, eci);
    when earnings_attributable_to_dividends_from_80_percent_domestic_corporation_245a5B(c, y, item, dividends);
    then undistributed_foreign_earnings_245a(c, y, item, max(0.00 USD, total - eci - dividends));
}
pub relation cfc_receives_hybrid_dividend_from_cfc(recipient: Integer, y: TaxableYear, payer: Integer, amount: Money) kind empirical {
    label en official "a controlled foreign corporation receives a hybrid dividend from another controlled foreign corporation for the year (section 245A(e)(2))";
}
pub relation domestic_corporation_is_united_states_shareholder_of_both_cfcs(c: Corporation, recipient: Integer, payer: Integer) kind empirical {
    label en official "the domestic corporation is a United States shareholder of both the receiving and the paying controlled foreign corporation (section 245A(e)(2))";
}
pub relation hybrid_dividend_treated_as_subpart_f_income(recipient: Integer, y: TaxableYear, payer: Integer, amount: Money) kind institutional {
    label en official "the hybrid dividend is treated for section 951(a)(1)(A) as subpart F income of the receiving controlled foreign corporation for the year (section 245A(e)(2)(A))";
}
@source(IRC_S245A_E, quote = "(A) the hybrid dividend shall be treated for purposes of section 951(a)(1)(A) as subpart F income of the receiving controlled foreign corporation for the taxable year of the controlled foreign corporation in which the dividend was")
rule HybridDividendSubpartFIncome(c: Corporation, recipient: Integer, y: TaxableYear, payer: Integer, amount: Money) strict {
    label en official "a hybrid dividend between two CFCs with a common United States shareholder is subpart F income of the recipient";
    when cfc_receives_hybrid_dividend_from_cfc(recipient, y, payer, amount);
    when domestic_corporation_is_united_states_shareholder_of_both_cfcs(c, recipient, payer);
    then hybrid_dividend_treated_as_subpart_f_income(recipient, y, payer, amount);
}
pub relation pro_rata_share_percent_951a2(c: Corporation, recipient: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the United States shareholder's pro rata share of the subpart F income of the receiving controlled foreign corporation, determined as under section 951(a)(2), as a percentage (section 245A(e)(2)(B))";
}
pub relation united_states_shareholder_inclusion_of_tiered_hybrid_dividend(c: Corporation, y: TaxableYear, recipient: Integer, amount: Money) kind institutional {
    label en official "the amount the United States shareholder includes in gross income: its pro rata share of the subpart F income from the tiered hybrid dividend (section 245A(e)(2)(B))";
}
@source(IRC_S245A_E, quote = "(B) the United States shareholder shall include in gross income an amount equal to the shareholder's pro rata share (determined in the same manner as under section 951(a)(2)) of the subpart F income described in subparagraph (A).")
rule UnitedStatesShareholderInclusionTieredHybrid(c: Corporation, recipient: Integer, y: TaxableYear, payer: Integer, amount: Money, pct: Decimal) strict {
    label en official "the pro rata share of the subpart F income";
    when hybrid_dividend_treated_as_subpart_f_income(recipient, y, payer, amount);
    when domestic_corporation_is_united_states_shareholder_of_both_cfcs(c, recipient, payer);
    when pro_rata_share_percent_951a2(c, recipient, y, pct);
    then united_states_shareholder_inclusion_of_tiered_hybrid_dividend(c, y, recipient, div_round(amount * pct, 100.0, 2, "HALF_UP"));
}

// === §246(a)(2): Federal Home Loan Bank dividends ==========================================================================

pub relation dividend_payor_is_federal_home_loan_bank(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is paid by a Federal Home Loan Bank (section 246(a)(2)(D)(i))";
}
pub relation fhlb_dividend_out_of_current_earnings(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is paid out of the FHLB's earnings and profits for the taxable year in which it is paid (section 246(a)(2)(A))";
}
pub relation fhlb_dividend_out_of_accumulated_earnings(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is paid out of the FHLB's accumulated earnings and profits (section 246(a)(2)(B))";
}
pub relation fhlb_dividends_received_from_fhlmc_in_year(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the dividends received by the FHLB from the Federal Home Loan Mortgage Corporation during the taxable year (section 246(a)(2)(A)(i),(D)(iv)(I))";
}
pub relation fhlb_reported_earnings_excluding_fhlmc_dividends(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the total earnings and profits of the FHLB, without the FHLMC dividends, as reported in its annual financial statement under section 20 of the Federal Home Loan Bank Act (section 246(a)(2)(D)(iv)(II))";
}
pub relation fhlb_earnings_and_profits_for_year(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the earnings and profits of the FHLB for the year: the FHLMC dividends plus the reported earnings (section 246(a)(2)(D)(iv))";
}
@source(IRC_S246_A, quote = "The earnings and profits of any FHLB for any taxable year shall be treated as equal to the sum of—")
rule FhlbEarningsAndProfitsForYear(c: Corporation, y: TaxableYear, item: Integer, fhlmc: Money, reported: Money) strict {
    label en official "the sum of the FHLMC dividends and the reported earnings";
    when fhlb_dividends_received_from_fhlmc_in_year(c, y, item, fhlmc);
    when fhlb_reported_earnings_excluding_fhlmc_dividends(c, y, item, reported);
    then fhlb_earnings_and_profits_for_year(c, y, item, fhlmc + reported);
}
pub relation fhlb_fhlmc_dividends_out_of_earnings_after_1984_not_treated_as_distributed(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the dividends the FHLB received from the FHLMC out of FHLMC earnings for taxable years ending after December 31, 1984 that were not previously treated as distributed (section 246(a)(2)(B)(i))";
}
pub relation fhlb_accumulated_earnings_after_1984(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the accumulated earnings and profits of the FHLB after December 31, 1984 as of the time the dividend is paid";
}
pub relation fhlb_retained_earnings_january_1_1985(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the retained earnings of the FHLB as of January 1, 1985, treated as its accumulated earnings and profits at that date (section 246(a)(2)(B) last sentence)";
}
pub relation fhlb_total_accumulated_earnings_at_payment(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the total accumulated earnings and profits of the FHLB when the dividend is paid (section 246(a)(2)(B)(ii))";
}
@source(IRC_S246_A, quote = "For purposes of clause (ii), the accumulated earnings and profits of the FHLB as of January 1, 1985, shall be treated as equal to its retained earnings as of such date.")
rule FhlbTotalAccumulatedEarnings(c: Corporation, y: TaxableYear, item: Integer, after: Money, retained: Money) strict {
    label en official "the accumulated earnings after 1984 plus the retained earnings at the start of 1985";
    when fhlb_accumulated_earnings_after_1984(c, y, item, after);
    when fhlb_retained_earnings_january_1_1985(c, y, item, retained);
    then fhlb_total_accumulated_earnings_at_payment(c, y, item, after + retained);
}
pub relation fhlb_dividend_portion_not_disallowed(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the part of the FHLB dividend to which section 246(a)(1) does not apply (section 246(a)(2)(A),(B))";
}
@source(IRC_S246_A, quote = "In the case of any dividend paid by any FHLB out of earnings and profits of the FHLB for the taxable year in which such dividend was paid, paragraph (1) shall not apply to that portion of such dividend which bears the same ratio to the total dividend as—")
rule FhlbPortionCurrentEarnings(c: Corporation, y: TaxableYear, item: Integer, amount: Money, fhlmc: Money, total: Money) strict {
    label en official "the dividend times the ratio of the FHLMC dividends to the earnings of the year";
    when dividend_received_by_corporation(c, y, item, amount);
    when dividend_payor_is_federal_home_loan_bank(c, y, item);
    when fhlb_dividend_out_of_current_earnings(c, y, item);
    when fhlb_dividends_received_from_fhlmc_in_year(c, y, item, fhlmc);
    when fhlb_earnings_and_profits_for_year(c, y, item, total);
    when total > 0.00 USD;
    then fhlb_dividend_portion_not_disallowed(c, y, item, round(amount * (min(fhlmc, total) / total), 2, "HALF_UP"));
}
@source(IRC_S246_A, quote = "In the case of any dividend which is paid out of any accumulated earnings and profits of any FHLB, paragraph (1) shall not apply to that portion of the dividend which bears the same ratio to the total dividend as—")
rule FhlbPortionAccumulatedEarnings(c: Corporation, y: TaxableYear, item: Integer, amount: Money, fhlmc: Money, total: Money) strict {
    label en official "the dividend times the ratio of the FHLMC dividends of the qualifying years to the accumulated earnings";
    when dividend_received_by_corporation(c, y, item, amount);
    when dividend_payor_is_federal_home_loan_bank(c, y, item);
    when fhlb_dividend_out_of_accumulated_earnings(c, y, item);
    when fhlb_fhlmc_dividends_out_of_earnings_after_1984_not_treated_as_distributed(c, y, item, fhlmc);
    when fhlb_total_accumulated_earnings_at_payment(c, y, item, total);
    when total > 0.00 USD;
    then fhlb_dividend_portion_not_disallowed(c, y, item, round(amount * (min(fhlmc, total) / total), 2, "HALF_UP"));
}
pub relation fhlb_dividend_portion_exists(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "helper: a part of the FHLB dividend is not disallowed";
}
rule FhlbPortionExistsKeyed(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "helper: keys the FHLB portion by item";
    when fhlb_dividend_portion_not_disallowed(c, y, item, amount);
    then fhlb_dividend_portion_exists(c, y, item);
}
@source(IRC_S246_A, quote = "To the extent that paragraph (1) does not apply to any dividend by reason of subparagraph (A) or (B) of this paragraph, the requirement contained in section 243(a) that the corporation paying the dividend be subject to taxation under this chapter shall not apply.")
rule FhlbPortionEligibleFor243Source(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "the payor need not be subject to tax for the FHLB portion";
    when fhlb_dividend_portion_exists(c, y, item);
    then dividend_eligible_for_243_source(c, y, item);
}
pub relation fhlb_taxable_year_is_calendar_year(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "the taxable year of an FHLB is treated as the calendar year, except as the regulations provide (section 246(a)(2)(D)(iii))";
}
pub relation regulations_provide_other_fhlb_taxable_year(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the Secretary's regulations provide a taxable year of the FHLB other than the calendar year";
}
@source(IRC_S246_A, quote = "The taxable year of an FHLB shall, except as provided in regulations prescribed by the Secretary, be treated as the calendar year.")
rule FhlbTaxableYearCalendar(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "the calendar year unless the regulations provide otherwise";
    when dividend_payor_is_federal_home_loan_bank(c, y, item);
    when not_known(regulations_provide_other_fhlb_taxable_year(c, y, item));
    then fhlb_taxable_year_is_calendar_year(c, y, item);
}
pub relation dividend_amount_for_deduction(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the amount of the dividend to which the dividends-received deductions apply: the dividend, less the part that a related-payments obligation denies, or only the FHLB portion of an FHLB dividend";
}

// === §246(a)(1) interplay: the FHLB portion, related payments =============================================================

@source(IRC_S246_A, quote = "paragraph (1) shall not apply to that portion of such dividend")
rule DividendAmountFhlbPortion(c: Corporation, y: TaxableYear, item: Integer, portion: Money) strict {
    label en official "only the FHLB portion of a dividend of an exempt FHLB is eligible";
    when fhlb_dividend_portion_not_disallowed(c, y, item, portion);
    when payor_exempt_under_501_or_521_in_current_or_preceding_year(c, y, item);
    then dividend_amount_for_deduction(c, y, item, portion);
}
@source(IRC_S246_C, quote = "to the extent that the taxpayer is under an obligation (whether pursuant to a short sale or otherwise) to make related payments with respect to positions in substantially similar or related property.")
rule DividendAmountAfterRelatedPaymentsExtent(c: Corporation, y: TaxableYear, item: Integer, amount: Money, hedged: Integer, total: Integer) strict {
    label en official "the dividend times the share of the stock that is not subject to the obligation";
    when dividend_received_by_corporation(c, y, item, amount);
    when obligated_to_make_related_payments_246c1b(c, y, item);
    when shares_subject_to_related_payments_obligation(c, y, item, hedged, total);
    when total > 0;
    then dividend_amount_for_deduction(c, y, item, div_round(amount * (total - hedged), total * 1.0, 2, "HALF_UP"));
}
pub relation shares_subject_to_related_payments_obligation(c: Corporation, y: TaxableYear, item: Integer, hedged: Integer, total: Integer) kind empirical {
    label en official "the number of shares as to which the taxpayer is under an obligation to make related payments, and the total number of shares (section 246(c)(1)(B)); the extent of the obligation";
}
pub relation related_payments_extent_measured(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "the extent of the related-payments obligation is measured by a share count";
}
rule RelatedPaymentsExtentMeasuredKeyed(c: Corporation, y: TaxableYear, item: Integer, hedged: Integer, total: Integer) strict {
    label en official "helper: keys the measured extent by item";
    when shares_subject_to_related_payments_obligation(c, y, item, hedged, total);
    then related_payments_extent_measured(c, y, item);
}
@source(IRC_S246_C, quote = "No deduction shall be allowed under section 243")
rule DividendAmountWithoutObligation(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "without an obligation and outside an exempt FHLB the whole dividend is eligible";
    when dividend_received_by_corporation(c, y, item, amount);
    when not_known(obligated_to_make_related_payments_246c1b(c, y, item));
    when not_known(fhlb_dividend_portion_exists(c, y, item));
    then dividend_amount_for_deduction(c, y, item, amount);
}
@source(IRC_S246_C, quote = "No deduction shall be allowed under section 243")
rule DividendAmountFhlbNotExempt(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "an FHLB dividend whose payor is not exempt keeps the whole amount";
    when dividend_received_by_corporation(c, y, item, amount);
    when not_known(obligated_to_make_related_payments_246c1b(c, y, item));
    when fhlb_dividend_portion_exists(c, y, item);
    when not_known(payor_exempt_under_501_or_521_in_current_or_preceding_year(c, y, item));
    then dividend_amount_for_deduction(c, y, item, amount);
}

// === §246(c)(3),(4): the holding period count =============================================================================

pub relation share_ex_dividend_date(c: Corporation, y: TaxableYear, item: Integer, ex: Date) kind empirical {
    label en official "the date the share becomes ex-dividend with respect to the dividend (section 246(c)(1)(A))";
}
pub relation share_acquired_on_246c(c: Corporation, y: TaxableYear, item: Integer, acquired: Date) kind empirical {
    label en official "the date the taxpayer acquired the share; section 1223(3) tacking is not applied (section 246(c)(3)(B))";
}
pub relation share_last_day_held_246c(c: Corporation, y: TaxableYear, item: Integer, last: Date) kind empirical {
    label en official "the day of disposition, or the last day of the window when the share is still held (section 246(c)(3)(A))";
}
pub relation holding_window_246c(c: Corporation, y: TaxableYear, item: Integer, start: Date, end: Date) kind institutional {
    label en official "the holding window around the ex-dividend date: 91 days (45 before), 181 days (90 before) or 731 days (365 before) (section 246(c)(1)(A),(2),(5)(A))";
}
@source(IRC_S246_C, quote = "which is held by the taxpayer for 45 days or less during the 91-day period beginning on the date which is 45 days before the date on which such share becomes ex-dividend with respect to such dividend")
rule HoldingWindow45(c: Corporation, y: TaxableYear, item: Integer, ex: Date, calendar_before_1: Date) strict {
    label en official "the 91-day period beginning 45 days before the ex-dividend date";
    when share_ex_dividend_date(c, y, item, ex);
    when holding_period_threshold_days_246c(c, y, item, 45)
        and us.irc.core::civil_calendar_boundary_before(ex, 45, us.irc.core::CalendarDay, calendar_before_1);
    then holding_window_246c(c, y, item, calendar_before_1, add_calendar_period(ex, 45 calendar_day));
}
@source(IRC_S246_C, quote = "(B) by substituting \"181-day period\" for \"91-day period\".")
rule HoldingWindow90(c: Corporation, y: TaxableYear, item: Integer, ex: Date, calendar_before_1: Date) strict {
    label en official "the 181-day period for preference stock";
    when share_ex_dividend_date(c, y, item, ex);
    when holding_period_threshold_days_246c(c, y, item, 90)
        and us.irc.core::civil_calendar_boundary_before(ex, 90, us.irc.core::CalendarDay, calendar_before_1);
    then holding_window_246c(c, y, item, calendar_before_1, add_calendar_period(ex, 90 calendar_day));
}
@source(IRC_S246_C, quote = "(II) by substituting \"731-day period\" for \"91-day period\", and")
rule HoldingWindow365(c: Corporation, y: TaxableYear, item: Integer, ex: Date, calendar_before_1: Date) strict {
    label en official "the 731-day period for section 245A dividends";
    when share_ex_dividend_date(c, y, item, ex);
    when holding_period_threshold_days_246c(c, y, item, 365)
        and us.irc.core::civil_calendar_boundary_before(ex, 365, us.irc.core::CalendarDay, calendar_before_1);
    then holding_window_246c(c, y, item, calendar_before_1, add_calendar_period(ex, 365 calendar_day));
}
pub relation holding_overlap_start_246c(c: Corporation, y: TaxableYear, item: Integer, start: Date) kind institutional {
    label en official "the first day of the holding that falls in the window: the later of the day after acquisition and the start of the window (section 246(c)(3)(A))";
}
@source(IRC_S246_C, quote = "(A) the day of disposition, but not the day of acquisition, shall be taken into account, and")
rule HoldingOverlapStartFromWindow(c: Corporation, y: TaxableYear, item: Integer, acquired: Date, ws: Date, we: Date) strict {
    label en official "the window start, when it is not before the first counted day";
    when share_acquired_on_246c(c, y, item, acquired);
    when holding_window_246c(c, y, item, ws, we);
    when ws >= add_calendar_period(acquired, 1 calendar_day);
    then holding_overlap_start_246c(c, y, item, ws);
}
@source(IRC_S246_C, quote = "(A) the day of disposition, but not the day of acquisition, shall be taken into account, and")
rule HoldingOverlapStartFromAcquisition(c: Corporation, y: TaxableYear, item: Integer, acquired: Date, ws: Date, we: Date) strict {
    label en official "the day after acquisition, when it is after the window start";
    when share_acquired_on_246c(c, y, item, acquired);
    when holding_window_246c(c, y, item, ws, we);
    when ws < add_calendar_period(acquired, 1 calendar_day);
    then holding_overlap_start_246c(c, y, item, add_calendar_period(acquired, 1 calendar_day));
}
pub relation holding_overlap_end_246c(c: Corporation, y: TaxableYear, item: Integer, end: Date) kind institutional {
    label en official "the last day of the holding that falls in the window: the earlier of the day of disposition and the end of the window";
}
@source(IRC_S246_C, quote = "(A) the day of disposition, but not the day of acquisition, shall be taken into account, and")
rule HoldingOverlapEndFromWindow(c: Corporation, y: TaxableYear, item: Integer, last: Date, ws: Date, we: Date) strict {
    label en official "the window end, when the holding lasts beyond it";
    when share_last_day_held_246c(c, y, item, last);
    when holding_window_246c(c, y, item, ws, we);
    when last >= we;
    then holding_overlap_end_246c(c, y, item, we);
}
@source(IRC_S246_C, quote = "(A) the day of disposition, but not the day of acquisition, shall be taken into account, and")
rule HoldingOverlapEndFromDisposition(c: Corporation, y: TaxableYear, item: Integer, last: Date, ws: Date, we: Date) strict {
    label en official "the day of disposition, when it is inside the window";
    when share_last_day_held_246c(c, y, item, last);
    when holding_window_246c(c, y, item, ws, we);
    when last < we;
    then holding_overlap_end_246c(c, y, item, last);
}
pub relation holding_days_before_reduction_246c(c: Corporation, y: TaxableYear, item: Integer, days: Integer) kind institutional {
    label en official "the days the share was held in the window before the reduction for diminished risk of loss (section 246(c)(3))";
}
@source(IRC_S246_C, quote = "For purposes of this subsection, in determining the period for which the taxpayer has held any share of stock—")
rule HoldingDaysBeforeReduction(c: Corporation, y: TaxableYear, item: Integer, s: Date, e: Date) strict {
    label en official "the days from the first counted day to the last, both included";
    when holding_overlap_start_246c(c, y, item, s);
    when holding_overlap_end_246c(c, y, item, e);
    when e >= s;
    then holding_days_before_reduction_246c(c, y, item, days_between(s, e) + 1);
}
@source(IRC_S246_C, quote = "For purposes of this subsection, in determining the period for which the taxpayer has held any share of stock—")
rule HoldingDaysNoneWhenNoOverlap(c: Corporation, y: TaxableYear, item: Integer, s: Date, e: Date) strict {
    label en official "no day of the holding falls in the window";
    when holding_overlap_start_246c(c, y, item, s);
    when holding_overlap_end_246c(c, y, item, e);
    when e < s;
    then holding_days_before_reduction_246c(c, y, item, 0);
}
pub relation holding_days_diminished_risk_246c4(c: Corporation, y: TaxableYear, item: Integer, days: Integer) kind empirical {
    label en official "the days in the window in which the taxpayer has an option to sell, a contractual obligation to sell or an open short sale of substantially identical stock, has granted an option to buy such stock, or has diminished its risk of loss under the regulations (section 246(c)(4)(A)-(C))";
}
pub relation qualified_covered_call_exception_246c4(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the position is a qualified covered call (section 1092(c)(4), without the ordinary-income requirement), other than one to which section 1092(f) applies, so the reduction does not apply (section 246(c)(4) last sentence)";
}
pub relation holding_reduction_applies_246c4(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "helper: the holding period is reduced for diminished risk of loss";
}
rule HoldingReductionAppliesKeyed(c: Corporation, y: TaxableYear, item: Integer, days: Integer) strict {
    label en official "helper: a diminished-risk period exists and the qualified covered call exception does not apply";
    when holding_days_diminished_risk_246c4(c, y, item, days);
    when not_known(qualified_covered_call_exception_246c4(c, y, item));
    then holding_reduction_applies_246c4(c, y, item);
}
@source(IRC_S246_C, quote = "The holding periods determined for purposes of this subsection shall be appropriately reduced (in the manner provided in regulations prescribed by the Secretary) for any period (during such periods) in which—")
rule DaysHeldReducedForDiminishedRisk(c: Corporation, y: TaxableYear, item: Integer, days: Integer, reduction: Integer) strict {
    label en official "the days held less the days of diminished risk, not below zero";
    when holding_days_before_reduction_246c(c, y, item, days);
    when holding_reduction_applies_246c4(c, y, item);
    when holding_days_diminished_risk_246c4(c, y, item, reduction);
    then days_held_in_holding_window_246c(c, y, item, max(0, days - reduction));
}
@source(IRC_S246_C, quote = "The preceding sentence shall not apply in the case of any qualified covered call")
rule DaysHeldNotReduced(c: Corporation, y: TaxableYear, item: Integer, days: Integer) strict {
    label en official "no reduction without a diminished-risk period, or for a qualified covered call";
    when holding_days_before_reduction_246c(c, y, item, days);
    when not_known(holding_reduction_applies_246c4(c, y, item));
    then days_held_in_holding_window_246c(c, y, item, days);
}

// === §246(d): DISC dividends ================================================================================================

pub relation dividend_payor_is_disc_or_former_disc(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the payor is a DISC or former DISC as defined in section 992(a) (section 246(d))";
}
pub relation dividend_out_of_accumulated_disc_income_or_previously_taxed_income(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is paid out of the corporation's accumulated DISC income or previously taxed income (section 246(d))";
}
pub relation dividend_is_deemed_distribution_995b1(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is a deemed distribution under section 995(b)(1) (section 246(d))";
}
@source(IRC_S246_D, quote = "No deduction shall be allowed under section 243 in respect of a dividend from a corporation which is a DISC or former DISC (as defined in section 992(a)) to the extent such dividend is paid out of the corporation's accumulated DISC income or previously taxed income,")
rule DisallowedDiscAccumulatedIncome(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "no section 243 deduction for a DISC dividend out of accumulated DISC income or previously taxed income (the whole item; the extent is a fact of the payor status)";
    when dividend_payor_is_disc_or_former_disc(c, y, item);
    when dividend_out_of_accumulated_disc_income_or_previously_taxed_income(c, y, item);
    then dividends_received_deduction_disallowed_246(c, y, item);
}
@source(IRC_S246_D, quote = "or is a deemed distribution pursuant to section 995(b)(1).")
rule DisallowedDiscDeemedDistribution(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "no section 243 deduction for a deemed distribution of a DISC";
    when dividend_payor_is_disc_or_former_disc(c, y, item);
    when dividend_is_deemed_distribution_995b1(c, y, item);
    then dividends_received_deduction_disallowed_246(c, y, item);
}

// === §246A(c),(d),(e): portfolio stock and debt financing ==================================================================

pub relation taxpayer_vote_percent_of_payor_246A(c: Corporation, y: TaxableYear, item: Integer, pct: Decimal) kind empirical {
    label en official "the percentage of the total voting power of the payor's stock the taxpayer owns as of the beginning of the ex-dividend date, without section 1504(a)(4) stock (section 246A(c)(2),(4))";
}
pub relation taxpayer_value_percent_of_payor_246A(c: Corporation, y: TaxableYear, item: Integer, pct: Decimal) kind empirical {
    label en official "the percentage of the total value of the payor's stock the taxpayer owns as of the beginning of the ex-dividend date, without section 1504(a)(4) stock (section 246A(c)(2),(4))";
}
pub relation payor_is_bank_or_bank_holding_company(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the payor is a bank (section 581) or a bank holding company (section 2(a) of the Bank Holding Company Act of 1956) (section 246A(c)(3)(B))";
}
pub relation option_stock_vote_percent_of_bank(c: Corporation, y: TaxableYear, item: Integer, pct: Decimal) kind empirical {
    label en official "the percentage of the total voting power of the stock of the bank or bank holding company that the taxpayer has an option to acquire (section 246A(c)(3)(A))";
}
pub relation effective_vote_percent_of_payor_246A(c: Corporation, y: TaxableYear, item: Integer, pct: Decimal) kind institutional {
    label en official "the vote percentage for the portfolio stock test: the vote percentage, plus the option stock of a bank or bank holding company of which the taxpayer owns at least 80 percent of the value (section 246A(c)(3)(A))";
}
@source(IRC_S246A_C, quote = "the taxpayer shall be treated as owning any stock of such bank or bank holding company which the taxpayer has an option to acquire.")
rule EffectiveVoteWithBankOptionStock(c: Corporation, y: TaxableYear, item: Integer, vote: Decimal, value: Decimal, option: Decimal) strict {
    label en official "the option stock is added for a bank of which the taxpayer owns at least 80 percent of the value";
    when taxpayer_vote_percent_of_payor_246A(c, y, item, vote);
    when payor_is_bank_or_bank_holding_company(c, y, item);
    when taxpayer_value_percent_of_payor_246A(c, y, item, value);
    when value >= 80.0;
    when option_stock_vote_percent_of_bank(c, y, item, option);
    then effective_vote_percent_of_payor_246A(c, y, item, vote + option);
}
@source(IRC_S246A_C, quote = "the taxpayer shall be treated as owning any stock of such bank or bank holding company which the taxpayer has an option to acquire.")
rule EffectiveVoteWithoutBankOption(c: Corporation, y: TaxableYear, item: Integer, vote: Decimal) strict {
    label en official "the vote percentage otherwise";
    when taxpayer_vote_percent_of_payor_246A(c, y, item, vote);
    when not_known(bank_option_stock_applies_246A(c, y, item));
    then effective_vote_percent_of_payor_246A(c, y, item, vote);
}
pub relation bank_option_stock_applies_246A(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "helper: the bank option-stock rule applies to the payor";
}
rule BankOptionStockAppliesKeyed(c: Corporation, y: TaxableYear, item: Integer, value: Decimal, option: Decimal) strict {
    label en official "helper: a bank with at least 80 percent of the value owned and option stock";
    when payor_is_bank_or_bank_holding_company(c, y, item);
    when taxpayer_value_percent_of_payor_246A(c, y, item, value);
    when value >= 80.0;
    when option_stock_vote_percent_of_bank(c, y, item, option);
    then bank_option_stock_applies_246A(c, y, item);
}
pub relation five_or_fewer_corporate_shareholders_meet_50_percent_test(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "stock meeting the 50-percent requirements of subparagraph (A) is owned by 5 or fewer corporate shareholders (section 246A(c)(2)(B)(ii))";
}
pub relation taxpayer_meets_portfolio_exception_A(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "the taxpayer owns at least 50 percent of the vote and of the value (section 246A(c)(2)(A))";
}
@source(IRC_S246A_C, quote = "(i) possessing at least 50 percent of the total voting power of the stock of such corporation, and")
rule PortfolioExceptionA(c: Corporation, y: TaxableYear, item: Integer, vote: Decimal, value: Decimal) strict {
    label en official "at least 50 percent of the vote and of the value";
    when effective_vote_percent_of_payor_246A(c, y, item, vote);
    when taxpayer_value_percent_of_payor_246A(c, y, item, value);
    when vote >= 50.0;
    when value >= 50.0;
    then taxpayer_meets_portfolio_exception_A(c, y, item);
}
pub relation taxpayer_meets_portfolio_exception_B(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "the taxpayer owns at least 20 percent of the vote and of the value, and 5 or fewer corporate shareholders own 50 percent (section 246A(c)(2)(B))";
}
@source(IRC_S246A_C, quote = "(i) the taxpayer owns stock of such corporation which would meet the requirements of subparagraph (A) if \"20 percent\" were substituted for \"50 percent\" each place it appears in such subparagraph, and")
rule PortfolioExceptionB(c: Corporation, y: TaxableYear, item: Integer, vote: Decimal, value: Decimal) strict {
    label en official "at least 20 percent of the vote and of the value, with 5 or fewer corporate shareholders holding 50 percent";
    when effective_vote_percent_of_payor_246A(c, y, item, vote);
    when taxpayer_value_percent_of_payor_246A(c, y, item, value);
    when vote >= 20.0;
    when value >= 20.0;
    when five_or_fewer_corporate_shareholders_meet_50_percent_test(c, y, item);
    then taxpayer_meets_portfolio_exception_B(c, y, item);
}
@source(IRC_S246A_C, quote = "The term \"portfolio stock\" means any stock of a corporation unless—")
rule PortfolioStockDerived(c: Corporation, y: TaxableYear, item: Integer, amount: Money, v0: Decimal) strict {
    label en official "stock outside both exceptions; an assertion by a case is still accepted";
    when dividend_received_by_corporation(c, y, item, amount);
    when taxpayer_vote_percent_of_payor_246A(c, y, item, v0);
    when not_known(taxpayer_meets_portfolio_exception_A(c, y, item));
    when not_known(taxpayer_meets_portfolio_exception_B(c, y, item));
    then stock_is_portfolio_stock(c, y, item);
}

// --- (d)(4),(2): the base period -------------------------------------------------------------------------------------------------

pub relation previous_ex_dividend_date_246A(c: Corporation, y: TaxableYear, item: Integer, on: Date) kind empirical {
    label en official "the ex-dividend date for the most recent previous dividend on the stock (section 246A(d)(4)(A))";
}
pub relation stock_acquired_by_taxpayer_on_246A(c: Corporation, y: TaxableYear, item: Integer, on: Date) kind empirical {
    label en official "the date the taxpayer acquired the stock, when it was not held throughout the base period (section 246A(d)(2))";
}
pub relation base_period_start_before_holding_246A(c: Corporation, y: TaxableYear, item: Integer, start: Date) kind institutional {
    label en official "the start of the base period before the limit of the holding: the later of the previous ex-dividend date and the day 1 year before the ex-dividend date (section 246A(d)(4))";
}
@source(IRC_S246A_D, quote = "(A) the period beginning on the ex-dividend date for the most recent previous dividend on the stock and ending on the day before the ex-dividend date for the dividend involved, or")
rule BaseStartPreviousExDividend(c: Corporation, y: TaxableYear, item: Integer, prev: Date, ex: Date, calendar_before_1: Date) strict {
    label en official "the previous ex-dividend date, when it is within the year before the ex-dividend date (the period is the shorter)";
    when previous_ex_dividend_date_246A(c, y, item, prev);
    when share_ex_dividend_date(c, y, item, ex);
    when prev >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(ex, 1, us.irc.core::CalendarYear, calendar_before_1);
    then base_period_start_before_holding_246A(c, y, item, prev);
}
@source(IRC_S246A_D, quote = "(B) the 1-year period ending on the day before the ex-dividend date for the dividend involved.")
rule BaseStartOneYear(c: Corporation, y: TaxableYear, item: Integer, prev: Date, ex: Date, calendar_before_1: Date, calendar_before_2: Date) strict {
    label en official "the day 1 year before the ex-dividend date, when the previous ex-dividend date is earlier";
    when previous_ex_dividend_date_246A(c, y, item, prev);
    when share_ex_dividend_date(c, y, item, ex);
    when prev < calendar_before_2
        and us.irc.core::civil_calendar_boundary_before(ex, 1, us.irc.core::CalendarYear, calendar_before_1)
        and us.irc.core::civil_calendar_boundary_before(ex, 1, us.irc.core::CalendarYear, calendar_before_2);
    then base_period_start_before_holding_246A(c, y, item, calendar_before_1);
}
pub relation base_period_246A(c: Corporation, y: TaxableYear, item: Integer, start: Date, end: Date) kind institutional {
    label en official "the base period of the dividend: the shorter of the two periods, cut to the time the taxpayer held the stock (section 246A(d)(2),(4))";
}
@source(IRC_S246A_D, quote = "In the case of any stock which was not held by the taxpayer throughout the base period, paragraph (1) shall be applied as if the base period consisted only of that portion of the base period during which the stock was held by the taxpayer.")
rule BasePeriodHeldThroughout(c: Corporation, y: TaxableYear, item: Integer, s: Date, acquired: Date, ex: Date, calendar_before_1: Date) strict {
    label en official "the whole base period, when the stock was held throughout it";
    when base_period_start_before_holding_246A(c, y, item, s);
    when stock_acquired_by_taxpayer_on_246A(c, y, item, acquired);
    when share_ex_dividend_date(c, y, item, ex);
    when acquired <= s
        and us.irc.core::civil_calendar_boundary_before(ex, 1, us.irc.core::CalendarDay, calendar_before_1);
    then base_period_246A(c, y, item, s, calendar_before_1);
}
@source(IRC_S246A_D, quote = "In the case of any stock which was not held by the taxpayer throughout the base period, paragraph (1) shall be applied as if the base period consisted only of that portion of the base period during which the stock was held by the taxpayer.")
rule BasePeriodHeldPartOnly(c: Corporation, y: TaxableYear, item: Integer, s: Date, acquired: Date, ex: Date, calendar_before_1: Date) strict {
    label en official "only the part of the base period from the acquisition";
    when base_period_start_before_holding_246A(c, y, item, s);
    when stock_acquired_by_taxpayer_on_246A(c, y, item, acquired);
    when share_ex_dividend_date(c, y, item, ex);
    when acquired > s
        and us.irc.core::civil_calendar_boundary_before(ex, 1, us.irc.core::CalendarDay, calendar_before_1);
    then base_period_246A(c, y, item, acquired, calendar_before_1);
}

// --- (d)(3),(c)(1): portfolio indebtedness ------------------------------------------------------------------------------------------

pub relation indebtedness_directly_attributable_to_portfolio_stock(c: Corporation, y: TaxableYear, item: Integer, debt: Integer, from: Date, to: Date) kind empirical {
    label en official "indebtedness directly attributable to investment in the portfolio stock, outstanding from the first date to the second (section 246A(d)(3)(A))";
}
pub relation short_sale_proceeds_held(c: Corporation, y: TaxableYear, item: Integer, sale: Integer, received: Date, closed: Date) kind empirical {
    label en official "an amount received from a short sale, from the day it is received to the day the short sale is closed (section 246A(d)(3)(B))";
}
pub relation portfolio_debt_period_246A(c: Corporation, y: TaxableYear, item: Integer, debt: Integer, from: Date, to: Date) kind institutional {
    label en official "a period of portfolio indebtedness with respect to the stock (section 246A(d)(3))";
}
@source(IRC_S246A_D, quote = "The term \"portfolio indebtedness\" means any indebtedness directly attributable to investment in the portfolio stock.")
rule PortfolioDebtPeriodDirect(c: Corporation, y: TaxableYear, item: Integer, debt: Integer, from: Date, to: Date) strict {
    label en official "directly attributable indebtedness";
    when indebtedness_directly_attributable_to_portfolio_stock(c, y, item, debt, from, to);
    then portfolio_debt_period_246A(c, y, item, debt, from, to);
}
@source(IRC_S246A_D, quote = "For purposes of subparagraph (A), any amount received from a short sale shall be treated as indebtedness for the period beginning on the day on which such amount is received and ending on the day the short sale is closed.")
rule PortfolioDebtPeriodShortSale(c: Corporation, y: TaxableYear, item: Integer, sale: Integer, from: Date, to: Date) strict {
    label en official "short sale proceeds are indebtedness from receipt to closing";
    when short_sale_proceeds_held(c, y, item, sale, from, to);
    then portfolio_debt_period_246A(c, y, item, sale, from, to);
}
@source(IRC_S246A_C, quote = "The term \"debt financed portfolio stock\" means any portfolio stock if at some time during the base period there is portfolio indebtedness with respect to such stock.")
rule PortfolioIndebtednessInBasePeriod(c: Corporation, y: TaxableYear, item: Integer, debt: Integer, from: Date, to: Date, bs: Date, be: Date) strict {
    label en official "a debt period that overlaps the base period; an assertion by a case is still accepted";
    when base_period_246A(c, y, item, bs, be);
    when portfolio_debt_period_246A(c, y, item, debt, from, to);
    when to >= bs;
    when from <= be;
    then portfolio_indebtedness_at_some_time_in_base_period(c, y, item);
}

// --- (e): the interest limit ------------------------------------------------------------------------------------------------------------

pub relation interest_deduction_allocable_to_dividend_246A(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the interest deduction, including a deductible short sale expense, allocable to the dividend (section 246A(e))";
}
pub relation interest_limit_applies_246A(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "helper: an allocable interest deduction is given for the dividend";
}
rule InterestLimitAppliesKeyed(c: Corporation, y: TaxableYear, item: Integer, interest: Money) strict {
    label en official "helper: keys the allocable interest by item";
    when interest_deduction_allocable_to_dividend_246A(c, y, item, interest);
    then interest_limit_applies_246A(c, y, item);
}
@source(IRC_S246A_E, quote = "any reduction under this section in the amount allowable as a deduction under section 243 or 245 with respect to any dividend shall not exceed the amount of any interest deduction (including any deductible short sale expense) allocable to such dividend.")
rule DividendsReceivedDeductionDebtFinancedLimitedByInterest(c: Corporation, y: TaxableYear, item: Integer, amount: Money, pct: Decimal, debt: Money, basis: Money, interest: Money) strict {
    label en official "the reduction of the deduction by section 246A is at most the allocable interest deduction";
    when dividend_amount_for_deduction(c, y, item, amount);
    when dividends_received_deduction_percentage_243(c, y, item, pct);
    when debt_financed_portfolio_stock(c, y, item);
    when average_portfolio_indebtedness(c, y, item, debt);
    when average_adjusted_basis_of_portfolio_stock(c, y, item, basis);
    when interest_deduction_allocable_to_dividend_246A(c, y, item, interest);
    when basis > 0.00 USD;
    when not_known(dividends_received_deduction_disallowed_246(c, y, item));
    then dividends_received_deduction_243_item(c, y, item,
        max(div_round(amount * pct * (max(0.00 USD, basis - debt) / 1.00 USD), basis / 1.00 USD, 2, "HALF_UP"), round(amount * pct, 2, "HALF_UP") - interest));
}
