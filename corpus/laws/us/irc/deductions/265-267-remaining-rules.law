// Sections 265(b) (financial institutions: interest allocable to tax-exempt
// obligations) and 267(e)-(g) (pass-through entities, controlled group loss deferral,
// transfers between spouses). Stage 2. (a)(1)-(2) of section 265 and (a)-(d) of section
// 267 are in the earlier modules. Not modelled (TECH_GAPS G2784): the qualified small
// issuer's composite, refunding, subordinate entity and conduit rules of (b)(3)(C)-(G),
// the 2009-2010 conduit rules, the (b)(6) basis reduction chain, and for section 267
// the partnership rules of (e)(1)-(5), the (f)(1) controlled group construction over
// section 1563(a) and the (f)(3) regulation-based exceptions.

// === 265(b): financial institutions and tax-exempt obligations ===================================

use self::{
    DeductionKind,
    IRC_S265_B,
    IRC_S267_F,
    IRC_S267_G,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation financial_institution_interest_expense(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the interest expense of a financial institution: the aggregate amount allowable as a deduction for interest for the year, determined without regard to section 265(b) and section 291 (section 265(b)(4)(A))";
}
pub relation taxpayer_is_financial_institution_265(p: Person) kind empirical {
    label en official "the taxpayer accepts deposits from the public in the ordinary course of business and is subject to Federal or State supervision as a financial institution, or is a corporation described in section 585(a)(2) (section 265(b)(5))";
}
pub relation average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxpayer's average adjusted bases of tax-exempt obligations (interest wholly exempt) acquired after August 7, 1986, in the numerator of the section 265(b)(2) ratio";
}
pub relation average_adjusted_basis_of_qualified_tax_exempt_obligations(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average adjusted bases of qualified tax-exempt obligations, which are treated as acquired before August 8, 1986 and so leave the numerator (section 265(b)(3)(A))";
}
pub relation average_adjusted_basis_of_obligations_issued_in_2009_or_2010(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average adjusted bases of tax-exempt obligations issued during 2009 or 2010, a refunding bond being treated as issued on the original issue date (section 265(b)(7))";
}
pub relation average_adjusted_basis_of_all_assets_265(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's average adjusted bases of all assets (section 265(b)(2)(B))";
}
pub relation obligation_issued_by_qualified_small_issuer_not_private_activity_and_designated(obl: Integer) kind institutional {
    label en official "the obligation is issued after August 7, 1986 by a qualified small issuer (reasonably anticipating no more than $10,000,000 of tax-exempt obligations in the calendar year), is not a private activity bond (other than a qualified 501(c)(3) bond), and is designated by the issuer (section 265(b)(3)(B),(C),(D)); asserted status";
}
pub relation issuer_designated_amount_in_calendar_year(obl: Integer, amount: Money) kind empirical {
    label en official "the amount of obligations of the issuer designated during the calendar year (section 265(b)(3)(D)(i))";
}
pub relation qualified_tax_exempt_obligation_265(obl: Integer) kind institutional {
    label en official "a qualified tax-exempt obligation: issued by a qualified small issuer, not a private activity bond, designated, and within the $10,000,000 annual designation limit (section 265(b)(3)(B),(D)(i))";
}
@source(IRC_S265_B, quote = "Not more than $10,000,000 of obligations issued by an issuer during any calendar year may be designated by such issuer")
rule QualifiedTaxExemptObligationRule(obl: Integer, designated: Money) defeasible {
    label en official "an obligation meeting the (B) conditions within the $10,000,000 designation limit (section 265(b)(3)(D)(i))";
    when obligation_issued_by_qualified_small_issuer_not_private_activity_and_designated(obl);
    when issuer_designated_amount_in_calendar_year(obl, designated);
    when designated <= 10000000.00 USD;
    then qualified_tax_exempt_obligation_265(obl);
}
pub relation financial_institution_teo_interest_disallowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest expense allocable to tax-exempt interest, for which no deduction is allowed: interest expense times the ratio of the average adjusted bases of the taxable tax-exempt obligations to the average adjusted bases of all assets (section 265(b)(1),(2))";
}
@source(IRC_S265_B, quote = "In the case of a financial institution, no deduction shall be allowed for that portion of the taxpayer's interest expense")
rule FinancialInstitutionTeoInterestDisallowed(p: Person, y: TaxableYear, interest: Money, teo: Money, qualified: Money, y0910: Money, assets: Money) strict {
    label en official "interest x (TEO bases - qualified TEO bases - the 2009-2010 obligations up to 2 percent of all asset bases) / all asset bases, one rounding (section 265(b)(2),(3)(A),(7))";
    when taxpayer_is_financial_institution_265(p);
    when financial_institution_interest_expense(p, y, interest);
    when average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986(p, y, teo);
    when average_adjusted_basis_of_qualified_tax_exempt_obligations(p, y, qualified);
    when average_adjusted_basis_of_obligations_issued_in_2009_or_2010(p, y, y0910);
    when average_adjusted_basis_of_all_assets_265(p, y, assets);
    when assets > 0.00 USD;
    then financial_institution_teo_interest_disallowed(p, y,
        div_round(interest * (max(0.00 USD, teo - qualified - min(y0910, assets * 0.02)) / 1.00 USD), assets / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S265_B, quote = "In the case of a financial institution, no deduction shall be allowed for that portion of the taxpayer's interest expense")
rule FinancialInstitutionTeoInterestNotDeductible(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the allocable interest is not an allowed deduction";
    when financial_institution_teo_interest_disallowed(p, y, amount);
    then not deduction_allowed(p, y, Section265FinancialInstitutionInterest, amount);
}

// === 267(f): controlled group losses =======================================================================

pub relation loss_on_sale_or_exchange_between_members_of_controlled_group(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a loss from the sale or exchange of property between members of the same controlled group (more than 50 percent common ownership, section 1563(a) with the substitutions of section 267(f)(1)) (section 267(f)(2))";
}
pub relation loss_within_267f3_exception(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the loss falls within a section 267(f)(3) exception: transfers by a DISC, a sale of inventory in the ordinary course involving a foreign corporation, regulation-based exceptions, or a regulated investment company redemption on demand of another such company";
}
pub relation property_transferred_outside_controlled_group_with_recognized_loss(p: Person, item: Integer, y: TaxableYear) kind empirical {
    label en official "the property is transferred outside the controlled group and there would be recognition of loss under consolidated return principles (section 267(f)(2)(B)); the year in which the deferral ends";
}
pub relation controlled_group_loss_deferred_267f(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the loss is deferred (not disallowed) until the property leaves the controlled group (section 267(f)(2))";
}
@source(IRC_S267_F, quote = "such loss shall be deferred until the property is transferred outside such controlled group")
rule ControlledGroupLossDeferred(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a controlled group loss is deferred and section 267(a)(1) and (d) do not apply to it (section 267(f)(2))";
    when loss_on_sale_or_exchange_between_members_of_controlled_group(p, y, item, amount);
    when not_known(loss_within_267f3_exception(p, y, item));
    then controlled_group_loss_deferred_267f(p, y, item, amount);
}
@source(IRC_S267_F, quote = "such loss shall be deferred until the property is transferred outside such controlled group")
rule ControlledGroupDeferredLossNotAllowedNow(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the deferred loss is not allowed in the year of the intragroup transfer";
    when controlled_group_loss_deferred_267f(p, y, item, amount);
    then not deduction_allowed(p, y, Section267ControlledGroupLoss, amount);
}
pub relation transfer_described_in_section_1041a(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a transfer between spouses or incident to divorce described in section 1041(a) (section 267(g))";
}
@source(IRC_S267_G, quote = "Subsection (a)(1) shall not apply to any transfer described in section 1041(a)")
rule Section1041TransferOutsideSection267a1(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "section 267(a)(1) does not apply to a section 1041(a) transfer (section 267(g)); recorded as a relation the loss disallowance rules of the earlier module could read (TECH_GAPS G2784)";
    when transfer_described_in_section_1041a(p, y, item);
    then transfer_outside_267a1(p, y, item);
}
pub relation transfer_outside_267a1(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the transfer is outside the section 267(a)(1) loss disallowance";
}
