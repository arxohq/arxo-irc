// Section 162 — stage 2c detail (TECH_GAPS G2783): (a) the home of a Member of Congress and the
// one-year rule, (d) Federal National Mortgage Association stock, (h)(2) legislative days,
// (n) the New York group health plan rule, (o) rural mail carriers, (p) reserve component members and
// (r)(4),(6) FDIC premiums and the expanded affiliated group.
//
// Stage 1 interface changes (recorded): `legislative_days_in_year`, `traveling_expense_away_from_home`,
// `fdic_premium_paid_or_incurred` and `total_consolidated_assets` are now institutional (derived below,
// or still asserted by a case).
//
// JUDGMENT CALLS: (1) the one-year rule reads the start and end of the period of employment as dates
// (a period exceeds 1 year when its end is after the first anniversary of its start); (2) a legislature's
// out-of-session gap is given as its length in days and counts when it is 4 days or less; (3) the
// cost-of-living adjustment of section 1(f)(3) with the base year 1990 is a percentage fact of the case
// (the increase over the 1991 agreement amount); (4) the amount paid under a later agreement counts
// only up to the 1991 amount increased by that percentage; (5) the assets of an expanded affiliated
// group are the sum of its members' assets, and the applicable percentage of each member's premium is
// computed on that sum (a member is the taxpayer's own share of the single taxpayer); (6) amounts are
// rounded to cents HALF_UP.

// === (a): the home of a Member of Congress; the one-year rule =================================================

use self::{
    Corporation,
    DeductionKind,
    IRC_S162_A,
    IRC_S162_D,
    IRC_S162_H,
    IRC_S162_N,
    IRC_S162_O,
    IRC_S162_P,
    IRC_S162_R,
    Person,
    TaxableYear,
    deduction_allowed,
    fdic_premium_paid_or_incurred,
    legislative_days_in_year,
    total_consolidated_assets,
    traveling_expense_away_from_home,
};

pub relation member_of_congress_in_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the individual is a Member of Congress, including a Delegate or Resident Commissioner, during the taxable year (section 162(a) last paragraph)";
}
pub relation member_of_congress_residence_in_represented_area(p: Person, y: TaxableYear) kind empirical {
    label en official "the place of residence is within the State, congressional district or possession the Member represents";
}
pub relation member_of_congress_home_is_residence_in_represented_area(p: Person, y: TaxableYear) kind institutional {
    label en official "the place of residence within the represented State, district or possession is the Member's home (section 162(a))";
}
@source(IRC_S162_A, quote = "For purposes of the preceding sentence, the place of residence of a Member of Congress (including any Delegate and Resident Commissioner) within the State, congressional district, or possession which he represents in Congress shall be considered his home,")
rule MemberOfCongressHomeIsResidence(p: Person, y: TaxableYear) strict {
    label en official "the residence in the represented area is the home for the away-from-home test";
    when member_of_congress_in_year(p, y);
    when member_of_congress_residence_in_represented_area(p, y);
    then member_of_congress_home_is_residence_in_represented_area(p, y);
}
pub relation member_of_congress_living_expenses(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "amounts expended by a Member of Congress within the taxable year for living expenses (section 162(a))";
}
@source(IRC_S162_A, quote = "but amounts expended by such Members within each taxable year for living expenses shall not be deductible for income tax purposes.")
rule MemberOfCongressLivingExpensesNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a Member's living expenses are not deductible";
    when member_of_congress_in_year(p, y);
    when member_of_congress_living_expenses(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
pub relation travel_period_of_employment(p: Person, y: TaxableYear, item: Integer, start: Date, end: Date) kind empirical {
    label en official "the period of employment during which the travel takes place (section 162(a) last paragraph)";
}
pub relation travel_expense_amount(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount of the traveling expense claimed as away from home (section 162(a)(2))";
}
pub relation federal_employee_certified_in_temporary_duty_for_prosecution(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the Federal employee is certified by the Attorney General or the designee as traveling on behalf of the United States in temporary duty status to investigate or prosecute, or support the investigation or prosecution of, a Federal crime (section 162(a) last sentence)";
}
pub relation employment_period_exceeds_one_year(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the period of employment exceeds 1 year, so the taxpayer is not treated as temporarily away from home (section 162(a) last paragraph)";
}
@source(IRC_S162_A, quote = "For purposes of paragraph (2), the taxpayer shall not be treated as being temporarily away from home during any period of employment if such period exceeds 1 year.")
rule EmploymentPeriodExceedsOneYear(p: Person, y: TaxableYear, item: Integer, start: Date, end: Date) strict {
    label en official "the end of the period is after the first anniversary of its start";
    when travel_period_of_employment(p, y, item, start, end);
    when end > add_calendar_period(start, 1 calendar_year);
    then employment_period_exceeds_one_year(p, y, item);
}
pub relation not_treated_as_temporarily_away_from_home(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the taxpayer is not treated as temporarily away from home for the item: the period exceeds 1 year and the Federal-employee exception does not apply (section 162(a) last paragraph)";
}
@source(IRC_S162_A, quote = "The preceding sentence shall not apply to any Federal employee during any period for which such employee is certified by the Attorney General")
rule NotTreatedAsTemporarilyAway(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a period over 1 year, unless the employee is certified in temporary duty to investigate or prosecute a Federal crime";
    when employment_period_exceeds_one_year(p, y, item);
    when not_known(federal_employee_certified_in_temporary_duty_for_prosecution(p, y, item));
    then not_treated_as_temporarily_away_from_home(p, y, item);
}
@source(IRC_S162_A, quote = "For purposes of paragraph (2), the taxpayer shall not be treated as being temporarily away from home during any period of employment if such period exceeds 1 year.")
rule TravelExpenseNotDeductibleWhenNotTemporary(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the traveling expense of an employment period over 1 year is not a section 162(a)(2) expense; no deduction under it";
    when not_treated_as_temporarily_away_from_home(p, y, item);
    when travel_expense_amount(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === (d): capital contributions to the Federal National Mortgage Association =========================================

pub relation fnma_stock_capital_contributions(p: Person, stock: Integer, amount: Money) kind empirical {
    label en official "the capital contributions evidenced by a share of stock issued under section 303(c) of the Federal National Mortgage Association Charter Act (section 162(d))";
}
pub relation fnma_stock_fair_market_value_at_issue(stock: Integer, amount: Money) kind empirical {
    label en official "the fair market value of the stock as of the issue date (section 162(d))";
}
pub relation fnma_stock_initial_holder_taxable_year(p: Person, stock: Integer, y: TaxableYear) kind empirical {
    label en official "the person is the initial holder of the stock, and the taxable year is the one in which the stock is issued (section 162(d))";
}
pub relation fnma_excess_treated_as_trade_or_business_expense(p: Person, y: TaxableYear, stock: Integer, amount: Money) kind institutional {
    label en official "the excess of the capital contributions over the fair market value is treated by the initial holder as an ordinary and necessary trade or business expense (section 162(d))";
}
@source(IRC_S162_D, quote = "the initial holder of the stock shall treat the excess as ordinary and necessary expenses paid or incurred during the taxable year in carrying on a trade or business.")
rule FnmaExcessTreatedAsExpense(p: Person, y: TaxableYear, stock: Integer, contributions: Money, fmv: Money) strict {
    label en official "the excess of the contributions over the fair market value";
    when fnma_stock_initial_holder_taxable_year(p, stock, y);
    when fnma_stock_capital_contributions(p, stock, contributions);
    when fnma_stock_fair_market_value_at_issue(stock, fmv);
    when contributions > fmv;
    then fnma_excess_treated_as_trade_or_business_expense(p, y, stock, contributions - fmv);
}
@source(IRC_S162_D, quote = "For purposes of this subtitle, whenever the amount of capital contributions evidenced by a share of stock issued pursuant to section 303(c)")
rule FnmaExcessDeductible(p: Person, y: TaxableYear, stock: Integer, amount: Money) strict {
    label en official "the deemed ordinary and necessary expense is allowed as a trade or business deduction";
    when fnma_excess_treated_as_trade_or_business_expense(p, y, stock, amount);
    then deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === (h)(2): legislative days =====================================================================================

pub relation legislature_in_session_on(p: Person, y: TaxableYear, day: Date) kind empirical {
    label en official "the legislature was in session on the day (section 162(h)(2)(A))";
}
pub relation legislature_out_of_session_gap_day(p: Person, y: TaxableYear, day: Date, gap_days: Integer) kind empirical {
    label en official "the day falls in a period in which the legislature was not in session for the stated number of consecutive days (section 162(h)(2)(A))";
}
pub relation committee_presence_formally_recorded_on(p: Person, y: TaxableYear, day: Date) kind empirical {
    label en official "the physical presence of the individual was formally recorded at a meeting of a committee of the legislature on the day (section 162(h)(2)(B))";
}
pub relation legislative_day(p: Person, y: TaxableYear, day: Date) kind institutional {
    label en official "a legislative day of the individual (section 162(h)(2))";
}
@source(IRC_S162_H, quote = "(A) the legislature was in session (including any day in which the legislature was not in session for a period of 4 consecutive days or less), or")
rule LegislativeDayInSession(p: Person, y: TaxableYear, day: Date) strict {
    label en official "a day on which the legislature was in session";
    when legislature_in_session_on(p, y, day);
    then legislative_day(p, y, day);
}
@source(IRC_S162_H, quote = "(A) the legislature was in session (including any day in which the legislature was not in session for a period of 4 consecutive days or less), or")
rule LegislativeDayShortGap(p: Person, y: TaxableYear, day: Date, gap: Integer) strict {
    label en official "a day in a gap of 4 consecutive days or less";
    when legislature_out_of_session_gap_day(p, y, day, gap);
    when gap <= 4;
    then legislative_day(p, y, day);
}
@source(IRC_S162_H, quote = "(B) the legislature was not in session but the physical presence of the individual was formally recorded at a meeting of a committee of such legislature.")
rule LegislativeDayCommittee(p: Person, y: TaxableYear, day: Date) strict {
    label en official "a day of a recorded committee presence";
    when committee_presence_formally_recorded_on(p, y, day);
    then legislative_day(p, y, day);
}
@source(IRC_S162_H, quote = "For purposes of paragraph (1), a legislative day during any taxable year for any individual shall be any day during such year on which—")
rule LegislativeDaysInYearDerived(p: Person, y: TaxableYear, d0: Date) strict {
    label en official "the number of legislative days of the year; a count asserted by a case is still accepted";
    when legislative_day(p, y, d0);
    then legislative_days_in_year(p, y, count(collect d: Date where legislative_day(p, y, d)));
}

// === (n): certain group health plans (New York) ====================================================================

pub relation plan_of_or_contributed_to_by_employer_or_employee_organization(plan: Integer) kind empirical {
    label en official "the plan is of, or contributed to by, an employer or employee organization, including a self-insured plan (section 162(n)(3))";
}
pub relation plan_provides_health_care_to_covered_persons(plan: Integer) kind empirical {
    label en official "the plan provides health care, directly or otherwise, to an employee, former employee, the employer or an associated individual, or a member of their family (section 162(n)(3))";
}
pub relation group_health_plan_162n(plan: Integer) kind institutional {
    label en official "a group health plan for section 162(n) (section 162(n)(3))";
}
@source(IRC_S162_N, quote = "For purposes of this subsection, the term \"group health plan\" means a plan of, or contributed to by, an employer or employee organization")
rule GroupHealthPlan162n(plan: Integer) strict {
    label en official "an employer or employee organization plan providing health care to the covered persons";
    when plan_of_or_contributed_to_by_employer_or_employee_organization(plan);
    when plan_provides_health_care_to_covered_persons(plan);
    then group_health_plan_162n(plan);
}
pub relation plan_reimburses_at_commercial_insurer_rate(plan: Integer) kind empirical {
    label en official "the plan reimburses for inpatient hospital care services in the State of New York at the same rate as licensed commercial insurers are required to (section 162(n)(1)(A))";
}
pub relation plan_reimburses_through_hmo(plan: Integer) kind empirical {
    label en official "the reimbursement is through a health maintenance organization (section 162(n)(1)(B))";
}
pub relation plan_reimburses_at_hmo_rate(plan: Integer) kind empirical {
    label en official "the reimbursement is at the rate health maintenance organizations are required to reimburse for individuals not covered by such a plan (section 162(n)(1)(B))";
}
pub relation plan_reimburses_through_article_43_corporation(plan: Integer) kind empirical {
    label en official "the reimbursement is through a corporation organized under Article 43 of the New York State Insurance Law (section 162(n)(1)(C))";
}
pub relation plan_reimburses_at_article_43_rate(plan: Integer) kind empirical {
    label en official "the reimbursement is at the rate such a corporation is required to reimburse for individuals not covered by such a plan (section 162(n)(1)(C))";
}
pub relation plan_meets_new_york_reimbursement_requirement(plan: Integer) kind institutional {
    label en official "the plan reimburses for inpatient hospital care services in New York at the required rate (section 162(n)(1)(A)-(C))";
}
@source(IRC_S162_N, quote = "(A) except as provided in subparagraphs (B) and (C), at the same rate as licensed commercial insurers are required to reimburse hospitals for such services when such reimbursement is not through such a plan,")
rule NewYorkReimbursementCommercialRate(plan: Integer) strict {
    label en official "at the commercial insurer rate, when not through an HMO or an Article 43 corporation";
    when plan_reimburses_at_commercial_insurer_rate(plan);
    when not_known(plan_reimburses_through_hmo(plan));
    when not_known(plan_reimburses_through_article_43_corporation(plan));
    then plan_meets_new_york_reimbursement_requirement(plan);
}
@source(IRC_S162_N, quote = "(B) in the case of any reimbursement through a health maintenance organization, at the same rate as health maintenance organizations are required to reimburse hospitals for such services for individuals not covered by such a plan")
rule NewYorkReimbursementHmoRate(plan: Integer) strict {
    label en official "through an HMO, at the HMO rate";
    when plan_reimburses_through_hmo(plan);
    when plan_reimburses_at_hmo_rate(plan);
    then plan_meets_new_york_reimbursement_requirement(plan);
}
@source(IRC_S162_N, quote = "(C) in the case of any reimbursement through any corporation organized under Article 43 of the New York State Insurance Law, at the same rate as any such corporation is required to reimburse hospitals for such services for individuals not covered by such a plan.")
rule NewYorkReimbursementArticle43Rate(plan: Integer) strict {
    label en official "through an Article 43 corporation, at its rate";
    when plan_reimburses_through_article_43_corporation(plan);
    when plan_reimburses_at_article_43_rate(plan);
    then plan_meets_new_york_reimbursement_requirement(plan);
}
pub relation plan_not_required_by_new_york_law_to_reimburse_at_those_rates(plan: Integer) kind empirical {
    label en official "the plan is not required under the laws of the State of New York (without regard to section 162(n) or other Federal law) to reimburse at the rates of paragraph (1) (section 162(n)(2))";
}
pub relation employer_group_health_plan_payment(p: Person, y: TaxableYear, plan: Integer, amount: Money) kind empirical {
    label en official "an amount paid or incurred by the employer in connection with the group health plan (section 162(n)(1))";
}
@source(IRC_S162_N, quote = "No deduction shall be allowed under this chapter to an employer for any amount paid or incurred in connection with a group health plan if the plan does not reimburse for inpatient hospital care services provided in the State of New York—")
rule NewYorkGroupHealthPlanNoDeduction(p: Person, y: TaxableYear, plan: Integer, amount: Money) strict {
    label en official "no employer deduction for a group health plan that does not reimburse at the required rate, unless New York law does not require it";
    when employer_group_health_plan_payment(p, y, plan, amount);
    when group_health_plan_162n(plan);
    when not_known(plan_meets_new_york_reimbursement_requirement(plan));
    when not_known(plan_not_required_by_new_york_law_to_reimburse_at_those_rates(plan));
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === (o): rural mail carriers ========================================================================================

pub relation employee_of_postal_service_on_rural_route(p: Person, y: TaxableYear) kind empirical {
    label en official "the individual is an employee of the United States Postal Service who performs services involving the collection and delivery of mail on a rural route (section 162(o)(1))";
}
pub relation equipment_allowance_paid_under_1991_agreement(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid by the Postal Service as an equipment maintenance allowance under the 1991 collective bargaining agreement with the National Rural Letter Carriers' Association (section 162(o)(3))";
}
pub relation equipment_allowance_paid_under_later_agreement(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid as an equipment maintenance allowance under a later agreement that supersedes the 1991 agreement (section 162(o)(3))";
}
pub relation equipment_allowance_1991_agreement_amount(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amounts that would have been paid under the 1991 agreement (section 162(o)(3))";
}
pub relation cost_of_living_adjustment_percent_base_1990(y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the cost-of-living adjustment under section 1(f)(3) for the calendar year in which the taxable year begins, with the base calendar year 1990, as a percentage (section 162(o)(3)(B))";
}
pub relation qualified_reimbursements_162o(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified reimbursements of a rural mail carrier (section 162(o)(3))";
}
@source(IRC_S162_O, quote = "the term \"qualified reimbursements\" means the amounts paid by the United States Postal Service to employees as an equipment maintenance allowance under the 1991 collective bargaining agreement")
rule QualifiedReimbursements1991(p: Person, y: TaxableYear, paid: Money) strict {
    label en official "the allowance paid under the 1991 agreement";
    when equipment_allowance_paid_under_1991_agreement(p, y, paid);
    then qualified_reimbursements_162o(p, y, paid);
}
@source(IRC_S162_O, quote = "(A) such amount, multiplied by")
rule QualifiedReimbursementsLaterAgreement(p: Person, y: TaxableYear, paid: Money, base: Money, pct: Decimal) strict {
    label en official "the allowance under a later agreement, up to the 1991 amount increased by that amount times the adjustment";
    when equipment_allowance_paid_under_later_agreement(p, y, paid);
    when equipment_allowance_1991_agreement_amount(p, y, base);
    when cost_of_living_adjustment_percent_base_1990(y, pct);
    then qualified_reimbursements_162o(p, y, min(paid, base + div_round(base * pct, 100.0, 2, "HALF_UP")));
}
pub relation rural_carrier_vehicle_expenses_incurred(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the expenses incurred by the employee for the use of a vehicle in performing the services (section 162(o)(2))";
}
@source(IRC_S162_O, quote = "(A) the amount allowable as a deduction under this chapter for the use of a vehicle in performing such services shall be equal to the amount of such qualified reimbursements; and")
rule RuralCarrierDeductionEqualsReimbursements(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the deduction for the use of a vehicle equals the qualified reimbursements";
    when employee_of_postal_service_on_rural_route(p, y);
    when qualified_reimbursements_162o(p, y, amount);
    then deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
pub relation rural_carrier_reimbursement_treated_as_accountable_plan(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified reimbursements are treated as paid under a reimbursement or other expense allowance arrangement for section 62(a)(2)(A), and section 62(c) does not apply (section 162(o)(1)(B))";
}
@source(IRC_S162_O, quote = "(B) such qualified reimbursements shall be treated as paid under a reimbursement or other expense allowance arrangement for purposes of section 62(a)(2)(A)")
rule RuralCarrierReimbursementAccountablePlan(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "treated as paid under a reimbursement arrangement for section 62(a)(2)(A)";
    when employee_of_postal_service_on_rural_route(p, y);
    when qualified_reimbursements_162o(p, y, amount);
    then rural_carrier_reimbursement_treated_as_accountable_plan(p, y, amount);
}
pub relation rural_carrier_excess_expenses_miscellaneous_itemized(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the expenses exceeding the qualified reimbursements, taken into account in computing the miscellaneous itemized deductions under section 67 (section 162(o)(2))";
}
@source(IRC_S162_O, quote = "such excess shall be taken into account in computing the miscellaneous itemized deductions of the employee under section 67.")
rule RuralCarrierExcessMiscellaneousItemized(p: Person, y: TaxableYear, expenses: Money, reimbursed: Money) strict {
    label en official "the excess of the vehicle expenses over the reimbursements";
    when employee_of_postal_service_on_rural_route(p, y);
    when rural_carrier_vehicle_expenses_incurred(p, y, expenses);
    when qualified_reimbursements_162o(p, y, reimbursed);
    when expenses > reimbursed;
    then rural_carrier_excess_expenses_miscellaneous_itemized(p, y, expenses - reimbursed);
}

// === (p): reserve component members ===================================================================================

pub relation member_of_reserve_component_in_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the individual performs services as a member of a reserve component of the Armed Forces of the United States at any time during the taxable year (section 162(p))";
}
pub relation away_from_home_in_connection_with_reserve_service(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the individual is away from home in connection with the reserve service for the period of the item (section 162(p))";
}
@source(IRC_S162_P, quote = "such individual shall be deemed to be away from home in the pursuit of a trade or business for any period during which such individual is away from home in connection with such service.")
rule ReservistDeemedAwayFromHome(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "deemed away from home in the pursuit of a trade or business while away for the service";
    when member_of_reserve_component_in_year(p, y);
    when away_from_home_in_connection_with_reserve_service(p, y, item);
    then traveling_expense_away_from_home(p, y, item);
}

// === (r)(4),(6): FDIC premiums and the expanded affiliated group ===============================================================

pub relation fdia_7b_assessment(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an assessment imposed under section 7(b) of the Federal Deposit Insurance Act (12 U.S.C. 1817(b)) paid or incurred (section 162(r)(4))";
}
@source(IRC_S162_R, quote = "For purposes of this subsection, the term \"FDIC premium\" means any assessment imposed under section 7(b) of the Federal Deposit Insurance Act (12 U.S.C. 1817(b)).")
rule FdicPremiumIsSection7bAssessment(c: Corporation, y: TaxableYear, i0: Integer, a0: Money) strict {
    label en official "the sum of the section 7(b) assessments; an amount asserted by a case is still accepted";
    when fdia_7b_assessment(c, y, i0, a0);
    then fdic_premium_paid_or_incurred(c, y, sum all amount: Money for item: Integer where fdia_7b_assessment(c, y, item, amount));
}
pub relation expanded_group_ownership_test_met(group: Integer, member: Corporation) kind empirical {
    label en official "the corporation is a member of an affiliated group of section 1504(a) determined with 'more than 50 percent' in place of 'at least 80 percent' and without regard to section 1504(b)(2) and (3) (section 162(r)(6)(B)(i))";
}
pub relation non_corporate_entity_controlled_by_group_member(group: Integer, controlled: Corporation) kind empirical {
    label en official "a partnership or other non-corporate entity is controlled (section 954(d)(3)) by members of the group, including a member by reason of this clause (section 162(r)(6)(B)(ii))";
}
pub relation member_of_expanded_affiliated_group(group: Integer, member: Corporation) kind institutional {
    label en official "the person is a member of the expanded affiliated group (section 162(r)(6)(B))";
}
@source(IRC_S162_R, quote = "For purposes of this paragraph, the term \"expanded affiliated group\" means an affiliated group as defined in section 1504(a), determined—")
rule ExpandedGroupMemberByOwnership(group: Integer, member: Corporation) strict {
    label en official "a corporation meeting the modified ownership test";
    when expanded_group_ownership_test_met(group, member);
    then member_of_expanded_affiliated_group(group, member);
}
@source(IRC_S162_R, quote = "A partnership or any other entity (other than a corporation) shall be treated as a member of an expanded affiliated group if such entity is controlled")
rule ExpandedGroupMemberByControl(group: Integer, controlled: Corporation) strict {
    label en official "a controlled non-corporate entity";
    when non_corporate_entity_controlled_by_group_member(group, controlled);
    then member_of_expanded_affiliated_group(group, controlled);
}
pub relation member_total_consolidated_assets(member: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total consolidated assets of the member as of the close of the taxable year (section 162(r)(5))";
}
pub relation expanded_group_total_consolidated_assets(group: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total consolidated assets of the expanded affiliated group treated as a single taxpayer: the sum over its members (section 162(r)(6)(A))";
}
@source(IRC_S162_R, quote = "Members of an expanded affiliated group shall be treated as a single taxpayer for purposes of applying this subsection.")
rule ExpandedGroupTotalAssets(group: Integer, y: TaxableYear, m0: Corporation, a0: Money) strict {
    label en official "the sum of the members' assets";
    when member_of_expanded_affiliated_group(group, m0);
    when member_total_consolidated_assets(m0, y, a0);
    then expanded_group_total_consolidated_assets(group, y, sum all amount: Money for m: Corporation where member_of_expanded_affiliated_group(group, m) and member_total_consolidated_assets(m, y, amount));
}
@source(IRC_S162_R, quote = "Members of an expanded affiliated group shall be treated as a single taxpayer for purposes of applying this subsection.")
rule MemberTotalAssetsAreGroupAssets(c: Corporation, y: TaxableYear, group: Integer, total: Money) strict {
    label en official "each member applies the threshold and the ratio to the group's assets";
    when member_of_expanded_affiliated_group(group, c);
    when expanded_group_total_consolidated_assets(group, y, total);
    then total_consolidated_assets(c, y, total);
}
