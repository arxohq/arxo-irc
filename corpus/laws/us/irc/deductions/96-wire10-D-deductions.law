// Deductions -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 170(b)(1)(A): the organizations to which a charitable contribution of an individual is subject to the 50 percent limit
// (clauses (i)-(x)). `us.irc.exempt_organizations` reads two conclusions of it (section 509(a)(1), section 514(c)(9)(C)(i)) and kept them as case
// facts. This package imports `exempt_organizations`, so it derives those two stubs (owner-derives-consumer-stub technique of Д-26).
//
// JUDGMENT CALLS
//  - Every clause is a classification of an organization for a taxable year; the "normally" tests and the purposes are case facts of the
//    organization keyed by the year (the statute speaks of what the organization normally does).
//  - Clause (vi) refers to an organization "referred to in subsection (c)(2)"; that paragraph is decomposed in 170c-qualifying-donee-organizations.law over
//    contributions, not organizations, so the reference is a case fact here (`organization_referred_to_in_170c2_170b1A`).
//  - Clauses (vii) (a private foundation described in subparagraph (F)) and (viii) (section 509(a)(2) or (3)) are the two clauses that
//    section 509(a)(1) excludes; they are not stated here.
//  - Clause (v) reads the year-less case fact `governmental_unit_donee_170c1`; the year is anchored by `organization_relevant_year_170b1A`.
//  - Section 170(b)(1)(A) contains no duty, prohibition or power; no position is declared.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

use self::{
    IRC_S170_B,
    Person,
    federally_chartered_corporation_170c6,
    governmental_unit_donee_170c1,
};

pub relation organization_relevant_year_170b1A(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year for which the organization's section 170(b)(1)(A) classification is asked (anchor for the year-less facts)";
}

// (i) church
pub relation church_or_convention_or_association_of_churches_170b1Ai(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a church or a convention or association of churches";
}
// (ii) educational organization
pub relation educational_organization_purpose_170b1Aii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an educational organization";
}
pub relation normally_maintains_regular_faculty_and_curriculum_170b1Aii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "which normally maintains a regular faculty and curriculum";
}
pub relation normally_has_regularly_enrolled_body_in_attendance_170b1Aii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "and normally has a regularly enrolled body of pupils or students in attendance at the place where its educational activities are regularly carried on";
}
pub relation described_in_170b1A_ii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 170(b)(1)(A)(ii): an educational organization which normally maintains a regular faculty and curriculum and normally has a regularly enrolled body of pupils or students in attendance where its activities are carried on";
}
// (iii) hospital or medical research
pub relation principal_purpose_medical_or_hospital_care_education_or_research_170b1Aiii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an organization the principal purpose or functions of which are the providing of medical or hospital care or medical education or medical research";
}
pub relation hospital_170b1Aiii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the organization is a hospital";
}
pub relation medical_research_organization_directly_engaged_in_conjunction_with_hospital_170b1Aiii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a medical research organization directly engaged in the continuous active conduct of medical research in conjunction with a hospital";
}
pub relation committed_to_spend_contributions_on_research_before_fifth_year_170b1Aiii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "during the calendar year in which the contribution is made such organization is committed to spend such contributions for such research before January 1 of the fifth calendar year which begins after the date such contribution is made";
}
pub relation described_in_170b1A_iii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 170(b)(1)(A)(iii): a hospital, or a medical research organization engaged in research in conjunction with a hospital that is committed to spend the contributions within the period";
}
// (iv) support organization of a state college or university
pub relation normally_receives_substantial_support_from_government_or_public_170b1Aiv(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an organization which normally receives a substantial part of its support from the United States or any State or political subdivision thereof or from direct or indirect contributions from the general public";
}
pub relation organized_and_operated_exclusively_for_state_college_or_university_170b1Aiv(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "organized and operated exclusively to receive, hold, invest, and administer property and to make expenditures to or for the benefit of a college or university which is an organization referred to in clause (ii) and which is an agency or instrumentality of, or owned or operated by, a State or political subdivision";
}
pub relation described_in_170b1A_iv(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 170(b)(1)(A)(iv): the substantial-support organization that exists exclusively for a State college or university described in clause (ii)";
}
// (v) governmental unit
pub relation described_in_170b1A_v(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 170(b)(1)(A)(v): a governmental unit referred to in subsection (c)(1)";
}
// (vi) publicly supported organization
pub relation organization_referred_to_in_170c2_170b1A(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an organization referred to in subsection (c)(2)";
}
pub relation normally_receives_substantial_support_from_governmental_unit_or_public_170b1Avi(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "which normally receives a substantial part of its support from a governmental unit referred to in subsection (c)(1) or from direct or indirect contributions from the general public";
}
pub relation described_in_170b1A_vi(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 170(b)(1)(A)(vi): an organization referred to in subsection (c)(2) that normally receives a substantial part of its support from a governmental unit or the general public";
}
// (ix) agricultural research
pub relation agricultural_research_organization_engaged_with_land_grant_college_170b1Aix(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an agricultural research organization directly engaged in the continuous active conduct of agricultural research in conjunction with a land-grant college or university or a non-land grant college of agriculture";
}
pub relation committed_to_spend_contribution_on_agricultural_research_before_fifth_year_170b1Aix(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "during the calendar year in which the contribution is made such organization is committed to spend such contribution for such research before January 1 of the fifth calendar year which begins after the date such contribution is made";
}
pub relation described_in_170b1A_ix(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 170(b)(1)(A)(ix): an agricultural research organization committed to spend the contribution within the period";
}
// (x) federally chartered veterans organization
pub relation described_in_170b1A_x(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 170(b)(1)(A)(x): an organization described in section 501(c)(19) that is a federally chartered corporation";
}
pub relation described_in_170b1A_excluding_vii_viii(o: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the organization is described in section 170(b)(1)(A), other than in clauses (vii) and (viii)";
}

@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "(i) a church or a convention or association of churches,")
rule W10DClauseIChurch(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when church_or_convention_or_association_of_churches_170b1Ai(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "(ii) an educational organization which normally maintains a regular faculty and curriculum and normally has a regularly enrolled body of pupils or students in attendance at the place where its educational activities are regularly carried on,")
rule W10DClauseIIEducational(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when educational_organization_purpose_170b1Aii(o, y);
    when normally_maintains_regular_faculty_and_curriculum_170b1Aii(o, y);
    when normally_has_regularly_enrolled_body_in_attendance_170b1Aii(o, y);
    then described_in_170b1A_ii(o, y);
}
rule W10DClauseIIInAnyClause(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when described_in_170b1A_ii(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "if the organization is a hospital, or if the organization is a medical research organization directly engaged in the continuous active conduct of medical research in conjunction with a hospital")
rule W10DClauseIIIHospital(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when principal_purpose_medical_or_hospital_care_education_or_research_170b1Aiii(o, y);
    when hospital_170b1Aiii(o, y);
    then described_in_170b1A_iii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "if the organization is a hospital, or if the organization is a medical research organization directly engaged in the continuous active conduct of medical research in conjunction with a hospital")
rule W10DClauseIIIMedicalResearch(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when principal_purpose_medical_or_hospital_care_education_or_research_170b1Aiii(o, y);
    when medical_research_organization_directly_engaged_in_conjunction_with_hospital_170b1Aiii(o, y);
    when committed_to_spend_contributions_on_research_before_fifth_year_170b1Aiii(o, y);
    then described_in_170b1A_iii(o, y);
}
rule W10DClauseIIIInAnyClause(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when described_in_170b1A_iii(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "and which is organized and operated exclusively to receive, hold, invest, and administer property and to make expenditures to or for the benefit of a college or university which is an organization referred to in clause (ii) of this subparagraph")
rule W10DClauseIVStateCollegeSupport(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when normally_receives_substantial_support_from_government_or_public_170b1Aiv(o, y);
    when organized_and_operated_exclusively_for_state_college_or_university_170b1Aiv(o, y);
    then described_in_170b1A_iv(o, y);
}
rule W10DClauseIVInAnyClause(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when described_in_170b1A_iv(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "(v) a governmental unit referred to in subsection (c)(1),")
rule W10DClauseVGovernmentalUnit(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when governmental_unit_donee_170c1(o);
    when organization_relevant_year_170b1A(o, y);
    then described_in_170b1A_v(o, y);
}
rule W10DClauseVInAnyClause(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when described_in_170b1A_v(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "(vi) an organization referred to in subsection (c)(2) which normally receives a substantial part of its support")
rule W10DClauseVIPubliclySupported(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when organization_referred_to_in_170c2_170b1A(o, y);
    when normally_receives_substantial_support_from_governmental_unit_or_public_170b1Avi(o, y);
    then described_in_170b1A_vi(o, y);
}
rule W10DClauseVIInAnyClause(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when described_in_170b1A_vi(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "(ix) an agricultural research organization directly engaged in the continuous active conduct of agricultural research")
rule W10DClauseIXAgriculturalResearch(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when agricultural_research_organization_engaged_with_land_grant_college_170b1Aix(o, y);
    when committed_to_spend_contribution_on_agricultural_research_before_fifth_year_170b1Aix(o, y);
    then described_in_170b1A_ix(o, y);
}
rule W10DClauseIXInAnyClause(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when described_in_170b1A_ix(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}
@source(IRC_S170_B, relation = formalizes, coverage = partial, quote = "(x) an organization described in section 501(c)(19) that is a federally chartered corporation")
rule W10DClauseXFederallyChartered501c19(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when us.irc.exempt_organizations::section_501c19(o, y);
    when federally_chartered_corporation_170c6(o);
    then described_in_170b1A_x(o, y);
}
rule W10DClauseXInAnyClause(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    when described_in_170b1A_x(o, y);
    then described_in_170b1A_excluding_vii_viii(o, y);
}

// --- the two stubs of us.irc.exempt_organizations (owner-derives-consumer-stub) -----------------------------------------------

rule W10DExemptOrganizationsStub509a1(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    label en official "section 509(a)(1): an organization described in section 170(b)(1)(A), other than in clauses (vii) and (viii)";
    when described_in_170b1A_excluding_vii_viii(o, y);
    then us.irc.exempt_organizations::section_170b1A_organization_excluding_vii_viii(o, y);
}
rule W10DExemptOrganizationsStub514c9C(o: us.irc.core::Person, y: us.irc.core::TaxableYear) strict {
    label en official "section 514(c)(9)(C)(i): an organization described in section 170(b)(1)(A)(ii)";
    when described_in_170b1A_ii(o, y);
    then us.irc.exempt_organizations::educational_organization_170b1Aii(o);
}
