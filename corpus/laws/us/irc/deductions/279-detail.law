// Section 279 — stage 2c detail (TECH_GAPS G2723, G2769): (b)(1)-(3) the parts of the definition, (c)(1),(3),(4),(5)
// the determination day, the projected earnings, the annual interest and the bank and finance rules, (d) the years
// (first year, later years, redetermination on control, the 3-year exit), (e) certain nontaxable transactions,
// (g) affiliated groups and (h) refinancing, guarantors and assumers.
//
// Stage 1 interface changes (recorded): the stage 1 rules of `corporate_acquisition_indebtedness_279` now produce
// `cai_determination_279b` (the determination as of a year end); `corporate_acquisition_indebtedness_279` is the
// status of a year, derived below with the carry-over of (d), or still asserted by a case.
// `acquisition_obligation_issued_for_stock_or_two_thirds_of_assets`, `obligation_subordinated_to_trade_creditors_or_unsecured_debt`,
// `obligation_convertible_or_with_stock_option_unit`, `issuer_projected_earnings`, `annual_interest_to_be_paid_or_incurred`
// and `interest_on_corporate_acquisition_indebtedness` are now institutional; the debt-to-equity rule reads the adjusted
// amounts of (c)(5).
//
// JUDGMENT CALLS: (1) the years are ordered by an integer index of the case (`taxable_year_index_279`); (2) the
// projected earnings are the sum of the corporation's 3-year earnings and profits and the four add-backs, divided
// by 3 (the regulations on short periods are external); (3) a determination made when the issuer has not yet issued an
// acquisition obligation in the year is not restricted, the stage 1 per-year facts being the determination years of
// the case; (4) an obligation that the redetermination of (d)(3) frees is not corporate acquisition indebtedness from
// the later year; (5) amounts are rounded to cents HALF_UP.

// === (b)(1): the acquisition ===============================================================================================

use self::{
    Corporation,
    IRC_S279_B,
    IRC_S279_C,
    IRC_S279_D,
    IRC_S279_E,
    IRC_S279_G,
    IRC_S279_H,
    TaxableYear,
    acquisition_obligation_issued_for_stock_or_two_thirds_of_assets,
    annual_interest_to_be_paid_or_incurred,
    cai_determination_279b,
    corporate_acquisition_indebtedness_279,
    five_percent_rule_blocks_279,
    interest_on_corporate_acquisition_indebtedness,
    issuer_projected_earnings,
    issuer_total_assets_money_and_adjusted_basis,
    issuer_total_indebtedness,
    obligation_convertible_or_with_stock_option_unit,
    obligation_subordinated_to_trade_creditors_or_unsecured_debt,
};

pub relation obligation_issued_for_stock_of_another_corporation(obl: Integer) kind empirical {
    label en official "the obligation is issued to provide consideration for the acquisition of stock in another corporation (section 279(b)(1)(A))";
}
pub relation obligation_issued_for_assets_of_another_corporation_under_plan(obl: Integer) kind empirical {
    label en official "the obligation is issued to provide consideration for the acquisition of assets of another corporation pursuant to a plan (section 279(b)(1)(B))";
}
pub relation acquired_asset_value_under_plan(obl: Integer, amount: Money) kind empirical {
    label en official "the value of the assets, excluding money, of the acquired corporation used in trades and businesses that are acquired under the plan";
}
pub relation acquired_corporation_total_asset_value_excluding_money(obl: Integer, amount: Money) kind empirical {
    label en official "the value of all the assets, excluding money, used in the trades and businesses carried on by the acquired corporation";
}
pub relation stock_acquisition_in_nonrecognition_transaction_of_controlled_corporation(obl: Integer) kind empirical {
    label en official "the acquisition is of stock of a corporation of which the issuing corporation is in control (section 368(c)), in a transaction in which gain or loss is not recognized (section 279(e))";
}
pub relation acquired_corporation_in_existence_immediately_before(obl: Integer) kind empirical {
    label en official "immediately before the transaction the acquired corporation was in existence (section 279(e)(1))";
}
pub relation issuing_corporation_in_control_immediately_before(obl: Integer) kind empirical {
    label en official "immediately before the transaction the issuing corporation was in control (section 368(c)) of the acquired corporation (section 279(e)(2))";
}
pub relation obligation_is_extension_renewal_or_refinancing_of_preexisting_indebtedness(obl: Integer) kind empirical {
    label en official "the obligation is an extension, renewal or refinancing of an obligation evidencing a preexisting indebtedness (section 279(h)(1))";
}
pub relation acquisition_deemed_described_in_b1_for_stock(obl: Integer) kind institutional {
    label en official "the stock acquisition counts as an acquisition described in subsection (b)(1): a controlled corporation acquired in a nonrecognition transaction counts only if the acquired corporation existed and the issuer was not in control before (section 279(e))";
}
@source(IRC_S279_E, quote = "shall be deemed an acquisition described in paragraph (1) of subsection (b) only if immediately before such transaction (1) the acquired corporation was in existence, and (2) the issuing corporation was not in control (as defined in section 368(c)) of such corporation.")
rule StockAcquisitionOrdinary(obl: Integer) strict {
    label en official "an ordinary stock acquisition";
    when obligation_issued_for_stock_of_another_corporation(obl);
    when not_known(stock_acquisition_in_nonrecognition_transaction_of_controlled_corporation(obl));
    then acquisition_deemed_described_in_b1_for_stock(obl);
}
@source(IRC_S279_E, quote = "shall be deemed an acquisition described in paragraph (1) of subsection (b) only if immediately before such transaction (1) the acquired corporation was in existence, and (2) the issuing corporation was not in control (as defined in section 368(c)) of such corporation.")
rule StockAcquisitionNonrecognitionControlled(obl: Integer) strict {
    label en official "a nonrecognition acquisition of a controlled corporation, when it existed and the issuer was not in control before";
    when obligation_issued_for_stock_of_another_corporation(obl);
    when stock_acquisition_in_nonrecognition_transaction_of_controlled_corporation(obl);
    when acquired_corporation_in_existence_immediately_before(obl);
    when not_known(issuing_corporation_in_control_immediately_before(obl));
    then acquisition_deemed_described_in_b1_for_stock(obl);
}
@source(IRC_S279_B, quote = "(A) stock in another corporation (hereinafter in this section referred to as \"acquired corporation\"), or")
rule AcquisitionObligationForStock(obl: Integer) strict {
    label en official "an obligation issued for stock in another corporation";
    when acquisition_deemed_described_in_b1_for_stock(obl);
    when not_known(obligation_is_extension_renewal_or_refinancing_of_preexisting_indebtedness(obl));
    then acquisition_obligation_issued_for_stock_or_two_thirds_of_assets(obl);
}
@source(IRC_S279_B, quote = "(B) assets of another corporation (hereinafter in this section referred to as \"acquired corporation\") pursuant to a plan under which at least two-thirds (in value) of all the assets (excluding money) used in trades and businesses carried on by such corporation are acquired,")
rule AcquisitionObligationForAssets(obl: Integer, acquired: Money, total: Money) strict {
    label en official "an obligation issued for assets under a plan acquiring at least two-thirds in value";
    when obligation_issued_for_assets_of_another_corporation_under_plan(obl);
    when acquired_asset_value_under_plan(obl, acquired);
    when acquired_corporation_total_asset_value_excluding_money(obl, total);
    when acquired * 3 >= total * 2;
    when not_known(obligation_is_extension_renewal_or_refinancing_of_preexisting_indebtedness(obl));
    then acquisition_obligation_issued_for_stock_or_two_thirds_of_assets(obl);
}

// === (b)(2),(3): subordination and convertibility =========================================================================

pub relation obligation_subordinated_to_trade_creditors_generally(obl: Integer) kind empirical {
    label en official "the obligation is subordinated to the claims of trade creditors of the issuing corporation generally (section 279(b)(2)(A))";
}
pub relation obligation_expressly_subordinated_to_substantial_unsecured_indebtedness(obl: Integer) kind empirical {
    label en official "the obligation is expressly subordinated in right of payment to any substantial amount of unsecured indebtedness of the issuing corporation, outstanding or later issued (section 279(b)(2)(B))";
}
@source(IRC_S279_B, quote = "(A) subordinated to the claims of trade creditors of the issuing corporation generally, or")
rule SubordinatedToTradeCreditors(obl: Integer) strict {
    label en official "subordinated to trade creditors generally";
    when obligation_subordinated_to_trade_creditors_generally(obl);
    then obligation_subordinated_to_trade_creditors_or_unsecured_debt(obl);
}
@source(IRC_S279_B, quote = "(B) expressly subordinated in right of payment to the payment of any substantial amount of unsecured indebtedness, whether outstanding or subsequently issued, of the issuing corporation,")
rule SubordinatedToUnsecuredDebt(obl: Integer) strict {
    label en official "expressly subordinated to substantial unsecured indebtedness";
    when obligation_expressly_subordinated_to_substantial_unsecured_indebtedness(obl);
    then obligation_subordinated_to_trade_creditors_or_unsecured_debt(obl);
}
pub relation obligation_convertible_directly_or_indirectly_into_issuer_stock(obl: Integer) kind empirical {
    label en official "the bond or other evidence of indebtedness is convertible directly or indirectly into stock of the issuing corporation (section 279(b)(3)(A))";
}
pub relation obligation_part_of_investment_unit_with_option_to_acquire_issuer_stock(obl: Integer) kind empirical {
    label en official "the bond is part of an investment unit or other arrangement that includes an option to acquire, directly or indirectly, stock in the issuing corporation (section 279(b)(3)(B))";
}
@source(IRC_S279_B, quote = "(A) convertible directly or indirectly into stock of the issuing corporation, or")
rule ConvertibleIntoIssuerStock(obl: Integer) strict {
    label en official "convertible into issuer stock";
    when obligation_convertible_directly_or_indirectly_into_issuer_stock(obl);
    then obligation_convertible_or_with_stock_option_unit(obl);
}
@source(IRC_S279_B, quote = "(B) part of an investment unit or other arrangement which includes, in addition to such bond or other evidence of indebtedness, an option to acquire, directly or indirectly, stock in the issuing corporation, and")
rule PartOfInvestmentUnitWithOption(obl: Integer) strict {
    label en official "part of an investment unit with an option to acquire issuer stock";
    when obligation_part_of_investment_unit_with_option_to_acquire_issuer_stock(obl);
    then obligation_convertible_or_with_stock_option_unit(obl);
}

// === (c)(1): the determination year ===================================================================================================

pub relation issuer_issues_acquisition_obligation_in_year(obl: Integer, y: TaxableYear) kind empirical {
    label en official "the issuing corporation issues in the taxable year an obligation to provide consideration for an acquisition described in subsection (b)(1) (section 279(c)(1))";
}
pub relation taxable_year_last_day_279(y: TaxableYear, day: Date) kind empirical {
    label en official "the last day of the taxable year of the issuing corporation";
}
pub relation cai_determination_day_279c1(obl: Integer, y: TaxableYear, day: Date) kind institutional {
    label en official "the day as of which the tests of subsection (b)(4) are made: the last day of a taxable year in which the issuing corporation issues an acquisition obligation (section 279(c)(1))";
}
@source(IRC_S279_C, quote = "Determinations are to be made as of the last day of any taxable year of the issuing corporation in which it issues any obligation to provide consideration for an acquisition described in subsection (b)(1) of stock in, or assets of, the acquired corporation.")
rule DeterminationDay(obl: Integer, y: TaxableYear, day: Date) strict {
    label en official "the last day of a taxable year of issuance";
    when issuer_issues_acquisition_obligation_in_year(obl, y);
    when taxable_year_last_day_279(y, day);
    then cai_determination_day_279c1(obl, y, day);
}

// === (c)(3),(4): projected earnings and annual interest ====================================================================================

pub relation corporation_three_year_earnings_and_profits(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the earnings and profits of the corporation (role 1 the issuing corporation, role 2 the acquired corporation) for the 3-year period ending with the last day of the determination year (section 279(c)(3)(B))";
}
pub relation three_year_addback_interest(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest paid or incurred in the 3-year period, added back (section 279(c)(3)(B)(i))";
}
pub relation three_year_addback_depreciation_and_amortization(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "depreciation or amortization allowed under this chapter in the period, added back (section 279(c)(3)(B)(ii))";
}
pub relation three_year_addback_tax_liability(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "liability for tax under this chapter in the period, added back (section 279(c)(3)(B)(iii))";
}
pub relation three_year_addback_301c1_distributions(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "distributions to which section 301(c)(1) applies in the period, other than those from the acquired to the issuing corporation, added back (section 279(c)(3)(B)(iv))";
}
pub relation three_year_bank_interest_reduction(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the reduction of interest under paragraph (5)(B) for a year of the period, which reduces the earnings and profits under (5)(C)";
}
pub relation corporation_average_annual_earnings(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the average annual earnings of a corporation: its earnings and profits for the 3-year period without reduction for interest, depreciation and amortization, tax and section 301(c)(1) distributions, reduced by the bank reductions, as an annual average (section 279(c)(3)(B),(5)(C))";
}
@source(IRC_S279_C, quote = "The average annual earnings referred to in subparagraph (A) is, for any corporation, the amount of its earnings and profits for any 3-year period ending with the last day of a taxable year of the issuing corporation described in paragraph (1), computed without reduction for—")
rule CorporationAverageAnnualEarnings(obl: Integer, corp_no: Integer, y: TaxableYear, ep: Money, interest: Money, depreciation: Money, tax: Money, distributions: Money) strict {
    label en official "the sum of the earnings and profits and the four add-backs, over 3 (JUDGMENT CALL: the regulations on short periods are external); a bank reduction, when given, is applied by the next rule";
    when corporation_three_year_earnings_and_profits(obl, corp_no, y, ep);
    when three_year_addback_interest(obl, corp_no, y, interest);
    when three_year_addback_depreciation_and_amortization(obl, corp_no, y, depreciation);
    when three_year_addback_tax_liability(obl, corp_no, y, tax);
    when three_year_addback_301c1_distributions(obl, corp_no, y, distributions);
    when not_known(three_year_bank_reduction_present(obl, corp_no, y));
    then corporation_average_annual_earnings(obl, corp_no, y, div_round(ep + interest + depreciation + tax + distributions, 3.0, 2, "HALF_UP"));
}
pub relation three_year_bank_reduction_present(obl: Integer, corp_no: Integer, y: TaxableYear) kind institutional {
    label en official "helper: a bank interest reduction is given for the period";
}
rule ThreeYearBankReductionPresentKeyed(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) strict {
    label en official "helper: keys the bank reduction by corporation and year";
    when three_year_bank_interest_reduction(obl, corp_no, y, amount);
    then three_year_bank_reduction_present(obl, corp_no, y);
}
@source(IRC_S279_C, quote = "(C) in determining under paragraph (3)(B) the average annual earnings, the amount of the earnings and profits for the 3-year period shall be reduced by the sum of the reductions under subparagraph (B) for such period.")
rule CorporationAverageAnnualEarningsBankReduced(obl: Integer, corp_no: Integer, y: TaxableYear, ep: Money, interest: Money, depreciation: Money, tax: Money, distributions: Money, reduction: Money) strict {
    label en official "the earnings and profits reduced by the bank reductions, then the add-backs, over 3";
    when corporation_three_year_earnings_and_profits(obl, corp_no, y, ep);
    when three_year_addback_interest(obl, corp_no, y, interest);
    when three_year_addback_depreciation_and_amortization(obl, corp_no, y, depreciation);
    when three_year_addback_tax_liability(obl, corp_no, y, tax);
    when three_year_addback_301c1_distributions(obl, corp_no, y, distributions);
    when three_year_bank_interest_reduction(obl, corp_no, y, reduction);
    then corporation_average_annual_earnings(obl, corp_no, y, div_round(ep - reduction + interest + depreciation + tax + distributions, 3.0, 2, "HALF_UP"));
}
pub relation issuer_acquired_control_or_substantially_all_properties(obl: Integer, y: TaxableYear) kind empirical {
    label en official "the issuing corporation has acquired control (section 368(c)), or substantially all of the properties, of the acquired corporation (section 279(c)(3)(A)(ii))";
}
@source(IRC_S279_C, quote = "(i) the issuing corporation only, if clause (ii) does not apply, or")
rule ProjectedEarningsIssuerOnly(obl: Integer, y: TaxableYear, issuer: Money) strict {
    label en official "the issuer's average annual earnings alone";
    when corporation_average_annual_earnings(obl, 1, y, issuer);
    when not_known(issuer_acquired_control_or_substantially_all_properties(obl, y));
    then issuer_projected_earnings(obl, y, issuer);
}
@source(IRC_S279_C, quote = "(ii) both the issuing corporation and the acquired corporation, in any case where the issuing corporation has acquired control (as defined in section 368(c)), or has acquired substantially all of the properties, of the acquired corporation.")
rule ProjectedEarningsIssuerAndAcquired(obl: Integer, y: TaxableYear, issuer: Money, acquired: Money) strict {
    label en official "the average annual earnings of both corporations";
    when corporation_average_annual_earnings(obl, 1, y, issuer);
    when corporation_average_annual_earnings(obl, 2, y, acquired);
    when issuer_acquired_control_or_substantially_all_properties(obl, y);
    then issuer_projected_earnings(obl, y, issuer + acquired);
}
pub relation corporation_annual_interest_to_be_paid(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the annual interest to be paid or incurred by the corporation, determined by reference to its total indebtedness outstanding (section 279(c)(4))";
}
pub relation bank_or_lending_business_interest_reduction(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the reduction of the interest for a bank or a lending or finance business: the interest times the ratio of the indebtedness reduction to the total indebtedness (section 279(c)(5)(B))";
}
pub relation corporation_annual_interest_after_bank_reduction(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the annual interest of the corporation after the bank reduction, if any (section 279(c)(4),(5)(B))";
}
@source(IRC_S279_C, quote = "(A) if subparagraph (B) does not apply, the annual interest to be paid or incurred by the issuing corporation only, determined by reference to its total indebtedness outstanding, or")
rule AnnualInterestNoBankReduction(obl: Integer, corp_no: Integer, y: TaxableYear, interest: Money) strict {
    label en official "the interest as it is";
    when corporation_annual_interest_to_be_paid(obl, corp_no, y, interest);
    when not_known(bank_interest_reduction_present(obl, corp_no, y));
    then corporation_annual_interest_after_bank_reduction(obl, corp_no, y, interest);
}
pub relation bank_interest_reduction_present(obl: Integer, corp_no: Integer, y: TaxableYear) kind institutional {
    label en official "helper: a bank interest reduction is given";
}
rule BankInterestReductionPresentKeyed(obl: Integer, corp_no: Integer, y: TaxableYear, amount: Money) strict {
    label en official "helper: keys the reduction";
    when bank_or_lending_business_interest_reduction(obl, corp_no, y, amount);
    then bank_interest_reduction_present(obl, corp_no, y);
}
@source(IRC_S279_C, quote = "the amount of such interest (determined without regard to this paragraph) shall be reduced by an amount which bears the same ratio to the amount of such interest as the amount of the reduction for the taxable year under subparagraph (A) bears to the total indebtedness of such corporation; and")
rule AnnualInterestBankReduced(obl: Integer, corp_no: Integer, y: TaxableYear, interest: Money, reduction: Money) strict {
    label en official "the interest less the reduction";
    when corporation_annual_interest_to_be_paid(obl, corp_no, y, interest);
    when bank_or_lending_business_interest_reduction(obl, corp_no, y, reduction);
    then corporation_annual_interest_after_bank_reduction(obl, corp_no, y, max(0.00 USD, interest - reduction));
}
@source(IRC_S279_C, quote = "(A) if subparagraph (B) does not apply, the annual interest to be paid or incurred by the issuing corporation only, determined by reference to its total indebtedness outstanding, or")
rule AnnualInterestIssuerOnly(obl: Integer, y: TaxableYear, issuer: Money) strict {
    label en official "the issuer's interest alone";
    when corporation_annual_interest_after_bank_reduction(obl, 1, y, issuer);
    when not_known(issuer_acquired_control_or_substantially_all_properties(obl, y));
    then annual_interest_to_be_paid_or_incurred(obl, y, issuer);
}
@source(IRC_S279_C, quote = "(B) if projected earnings are determined under clause (ii) of paragraph (3)(A), the annual interest to be paid or incurred by both the issuing corporation and the acquired corporation, determined by reference to their combined total indebtedness outstanding.")
rule AnnualInterestIssuerAndAcquired(obl: Integer, y: TaxableYear, issuer: Money, acquired: Money) strict {
    label en official "the interest of both corporations";
    when corporation_annual_interest_after_bank_reduction(obl, 1, y, issuer);
    when corporation_annual_interest_after_bank_reduction(obl, 2, y, acquired);
    when issuer_acquired_control_or_substantially_all_properties(obl, y);
    then annual_interest_to_be_paid_or_incurred(obl, y, issuer + acquired);
}

// === (c)(5): banks and lending or finance companies: debt to equity ======================================================================

pub relation issuer_is_bank_or_primarily_lending_or_finance_business(obl: Integer) kind empirical {
    label en official "the issuing corporation is a bank (section 581) or is primarily engaged in a lending or finance business (section 279(c)(5))";
}
pub relation indebtedness_owed_to_issuer_from_banking_or_lending_business(obl: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total indebtedness owed to the issuing corporation that arises out of its banking business, or its lending or finance business (section 279(c)(5)(A))";
}
pub relation adjusted_total_indebtedness_279(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total indebtedness of the issuing corporation for the debt-to-equity ratio, reduced for a bank or lending business by the indebtedness owed to it (section 279(c)(2),(5)(A))";
}
pub relation adjusted_total_assets_279(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the money and other assets of the issuing corporation at adjusted basis, reduced for a bank or lending business by the indebtedness owed to it (section 279(c)(2),(5)(A))";
}
@source(IRC_S279_C, quote = "(A) in determining under paragraph (2) the ratio of debt to equity of such corporation (or of the affiliated group of which such corporation is a member), the total indebtedness of such corporation (and the assets of such corporation) shall be reduced by an amount equal to the total indebtedness owed to such corporation")
rule AdjustedAmountsBank(obl: Integer, y: TaxableYear, debt: Money, assets: Money, owed: Money) strict {
    label en official "both the indebtedness and the assets are reduced by the indebtedness owed to the bank";
    when issuer_total_indebtedness(obl, y, debt);
    when issuer_total_assets_money_and_adjusted_basis(obl, y, assets);
    when issuer_is_bank_or_primarily_lending_or_finance_business(obl);
    when indebtedness_owed_to_issuer_from_banking_or_lending_business(obl, y, owed);
    then adjusted_total_indebtedness_279(obl, y, max(0.00 USD, debt - owed));
}
@source(IRC_S279_C, quote = "(A) in determining under paragraph (2) the ratio of debt to equity of such corporation (or of the affiliated group of which such corporation is a member), the total indebtedness of such corporation (and the assets of such corporation) shall be reduced by an amount equal to the total indebtedness owed to such corporation")
rule AdjustedAssetsBank(obl: Integer, y: TaxableYear, assets: Money, owed: Money) strict {
    label en official "the assets reduced by the indebtedness owed to the bank";
    when issuer_total_assets_money_and_adjusted_basis(obl, y, assets);
    when issuer_is_bank_or_primarily_lending_or_finance_business(obl);
    when indebtedness_owed_to_issuer_from_banking_or_lending_business(obl, y, owed);
    then adjusted_total_assets_279(obl, y, max(0.00 USD, assets - owed));
}
@source(IRC_S279_C, quote = "The term \"ratio of debt to equity\" means the ratio which the total indebtedness of the issuing corporation bears to the sum of its money and all its other assets (in an amount equal to their adjusted basis for determining gain) less such total indebtedness.")
rule AdjustedAmountsOrdinaryDebt(obl: Integer, y: TaxableYear, debt: Money) strict {
    label en official "the amounts as they are, for an issuer that is not a bank or lending business";
    when issuer_total_indebtedness(obl, y, debt);
    when not_known(issuer_is_bank_or_primarily_lending_or_finance_business(obl));
    then adjusted_total_indebtedness_279(obl, y, debt);
}
@source(IRC_S279_C, quote = "The term \"ratio of debt to equity\" means the ratio which the total indebtedness of the issuing corporation bears to the sum of its money and all its other assets (in an amount equal to their adjusted basis for determining gain) less such total indebtedness.")
rule AdjustedAssetsOrdinary(obl: Integer, y: TaxableYear, assets: Money) strict {
    label en official "the assets as they are";
    when issuer_total_assets_money_and_adjusted_basis(obl, y, assets);
    when not_known(issuer_is_bank_or_primarily_lending_or_finance_business(obl));
    then adjusted_total_assets_279(obl, y, assets);
}

// === (g): affiliated groups ==================================================================================================================

pub relation affiliated_group_member_on_determination_day(obl: Integer, member: Integer, y: TaxableYear) kind empirical {
    label en official "the corporation is a member of the issuing corporation's affiliated group on the determination day, the acquired corporation not being a member (section 279(g))";
}
pub relation affiliated_member_total_indebtedness(obl: Integer, member: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total indebtedness of the member (section 279(g))";
}
pub relation affiliated_member_total_assets(obl: Integer, member: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the money and other assets of the member at adjusted basis (section 279(g))";
}
pub relation affiliated_group_total_indebtedness(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total indebtedness of the affiliated group treated as the issuing corporation (section 279(g))";
}
@source(IRC_S279_G, quote = "the application of this section shall be determined, pursuant to regulations prescribed by the Secretary, by treating all of the members of the affiliated group in the aggregate as the issuing corporation")
rule AffiliatedGroupTotalIndebtedness(obl: Integer, y: TaxableYear, m0: Integer, a0: Money) strict {
    label en official "the sum over the members on the determination day; an asserted total is still accepted";
    when affiliated_group_member_on_determination_day(obl, m0, y);
    when affiliated_member_total_indebtedness(obl, m0, y, a0);
    then issuer_total_indebtedness(obl, y, sum all amount: Money for m: Integer where affiliated_group_member_on_determination_day(obl, m, y) and affiliated_member_total_indebtedness(obl, m, y, amount));
}
@source(IRC_S279_G, quote = "shall be included in the determinations required under subparagraphs (A) and (B) of subsection (b)(4) as of any day only if such corporation is a member of the affiliated group on such day")
rule AffiliatedGroupTotalAssets(obl: Integer, y: TaxableYear, m0: Integer, a0: Money) strict {
    label en official "the sum of the members' assets on the determination day";
    when affiliated_group_member_on_determination_day(obl, m0, y);
    when affiliated_member_total_assets(obl, m0, y, a0);
    then issuer_total_assets_money_and_adjusted_basis(obl, y, sum all amount: Money for m: Integer where affiliated_group_member_on_determination_day(obl, m, y) and affiliated_member_total_assets(obl, m, y, amount));
}
pub relation affiliated_member_earnings_for_membership_period(obl: Integer, member: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the earnings and profits of the member for the period during which it was a member of the affiliated group (section 279(g))";
}
pub relation affiliated_group_earnings_for_membership_periods(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings of the members, each counted only for its period of membership (section 279(g))";
}
@source(IRC_S279_G, quote = "and, in determining projected earnings of such corporation under subsection (c)(3), there shall be taken into account only the earnings and profits of such corporation for the period during which it was a member of the affiliated group.")
rule AffiliatedGroupEarnings(obl: Integer, y: TaxableYear, m0: Integer, a0: Money) strict {
    label en official "the sum of the members' earnings for their membership periods";
    when affiliated_group_member_on_determination_day(obl, m0, y);
    when affiliated_member_earnings_for_membership_period(obl, m0, y, a0);
    then affiliated_group_earnings_for_membership_periods(obl, y, sum all amount: Money for m: Integer where affiliated_group_member_on_determination_day(obl, m, y) and affiliated_member_earnings_for_membership_period(obl, m, y, amount));
}

// === (d): the years =============================================================================================================================

pub relation taxable_year_index_279(y: TaxableYear, n: Integer) kind empirical {
    label en official "the position of the taxable year in the order of the issuing corporation's taxable years (section 279(d))";
}
pub relation cai_first_determination_index(obl: Integer, n0: Integer) kind institutional {
    label en official "the index of a year as of whose last day the tests of subsection (b)(4) make the obligation corporate acquisition indebtedness (section 279(d)(1))";
}
@source(IRC_S279_D, quote = "The deduction of interest on any obligation shall not be disallowed under subsection (a) before the first taxable year of the issuing corporation as of the last day of which the application of either subparagraph (A) or subparagraph (B) of subsection (b)(4) results in such obligation being corporate acquisition indebtedness.")
rule CaiDeterminationIndex(obl: Integer, y: TaxableYear, n: Integer) strict {
    label en official "a year whose determination makes the obligation corporate acquisition indebtedness";
    when cai_determination_279b(obl, y);
    when taxable_year_index_279(y, n);
    then cai_first_determination_index(obl, n);
}
pub relation determination_made_under_clause_i(obl: Integer, y: TaxableYear) kind empirical {
    label en official "clause (i) of subsection (c)(3)(A) applied in the determination as of the close of the year (section 279(d)(3))";
}
pub relation redetermination_year_index_279d3(obl: Integer, n: Integer) kind empirical {
    label en official "the index of the first taxable year after the determination in which clause (ii) of subsection (c)(3)(A) could apply (section 279(d)(3))";
}
pub relation obligation_would_not_be_cai_on_redetermination(obl: Integer) kind empirical {
    label en official "the obligation would not be corporate acquisition indebtedness if the determination were made as of the close of that later year (section 279(d)(3))";
}
pub relation cai_ends_from_index(obl: Integer, n: Integer) kind institutional {
    label en official "the obligation is not corporate acquisition indebtedness from the taxable year of the index and all later years (section 279(d)(3),(4))";
}
@source(IRC_S279_D, quote = "such obligation shall be considered not to be corporate acquisition indebtedness for such later taxable year and all taxable years thereafter.")
rule CaiEndsOnRedetermination(obl: Integer, y: TaxableYear, later: Integer) strict {
    label en official "the redetermination frees the obligation from the later year on";
    when cai_determination_279b(obl, y);
    when determination_made_under_clause_i(obl, y);
    when redetermination_year_index_279d3(obl, later);
    when obligation_would_not_be_cai_on_redetermination(obl);
    then cai_ends_from_index(obl, later);
}
pub relation cai_tests_not_met_in_year(obl: Integer, y: TaxableYear) kind empirical {
    label en official "subsection (b)(4) applied as of the close of the year would not make the obligation corporate acquisition indebtedness (section 279(d)(4))";
}
@source(IRC_S279_D, quote = "If an obligation which has been determined to be corporate acquisition indebtedness for any taxable year would not be such indebtedness for each of any 3 consecutive taxable years thereafter if subsection (b)(4) were applied as of the close of each of such 3 years, then such obligation shall not be corporate acquisition indebtedness for all taxable years after such 3 consecutive taxable years.")
rule CaiEndsAfterThreeYearRun(obl: Integer, n0: Integer, y1: TaxableYear, y2: TaxableYear, y3: TaxableYear, i1: Integer, i2: Integer, i3: Integer) strict {
    label en official "three consecutive later years in which the tests are not met end the status after them";
    when cai_first_determination_index(obl, n0);
    when cai_tests_not_met_in_year(obl, y1);
    when taxable_year_index_279(y1, i1);
    when i1 > n0;
    when cai_tests_not_met_in_year(obl, y2);
    when taxable_year_index_279(y2, i2);
    when i2 == i1 + 1;
    when cai_tests_not_met_in_year(obl, y3);
    when taxable_year_index_279(y3, i3);
    when i3 == i1 + 2;
    then cai_ends_from_index(obl, i3 + 1);
}
pub relation cai_ended_by_year(obl: Integer, y: TaxableYear) kind institutional {
    label en official "helper: the status has ended for the year";
}
rule CaiEndedByYear(obl: Integer, y: TaxableYear, end: Integer, n: Integer) strict {
    label en official "the year is at or after the index from which the status ends";
    when cai_ends_from_index(obl, end);
    when taxable_year_index_279(y, n);
    when n >= end;
    then cai_ended_by_year(obl, y);
}
@source(IRC_S279_D, quote = "if an obligation is determined to be corporate acquisition indebtedness as of the last day of any taxable year of the issuing corporation, it shall be corporate acquisition indebtedness for such taxable year and all subsequent taxable years.")
rule CaiStatusOfDeterminationYear(obl: Integer, y: TaxableYear) strict {
    label en official "corporate acquisition indebtedness for the year of the determination, unless the status has ended; an assertion by a case is still accepted";
    when cai_determination_279b(obl, y);
    when not_known(cai_ended_by_year(obl, y));
    then corporate_acquisition_indebtedness_279(obl, y);
}
@source(IRC_S279_D, quote = "if an obligation is determined to be corporate acquisition indebtedness as of the last day of any taxable year of the issuing corporation, it shall be corporate acquisition indebtedness for such taxable year and all subsequent taxable years.")
rule CaiStatusInLaterYears(obl: Integer, y: TaxableYear, n0: Integer, n: Integer) strict {
    label en official "corporate acquisition indebtedness for every later year, unless the status has ended or the 5 percent rule blocks it";
    when cai_first_determination_index(obl, n0);
    when taxable_year_index_279(y, n);
    when n > n0;
    when not_known(cai_ended_by_year(obl, y));
    when not_known(five_percent_rule_blocks_279(obl, y));
    then corporate_acquisition_indebtedness_279(obl, y);
}

// === (h): guarantors, endorsers, indemnitors and assumers =========================================================================================

pub relation corporation_liable_for_obligation_as_guarantor_endorser_indemnitor_or_assumer(c: Corporation, obl: Integer) kind empirical {
    label en official "the corporation becomes liable for the obligation as guarantor, endorser or indemnitor, or assumes liability for it in any transaction (section 279(h)(2))";
}
pub relation interest_paid_by_liable_corporation_on_obligation(c: Corporation, y: TaxableYear, obl: Integer, amount: Money) kind empirical {
    label en official "interest paid or incurred during the year by the corporation liable for the obligation (section 279(h)(2))";
}
pub relation obligation_is_cai_of_liable_corporation(c: Corporation, obl: Integer, y: TaxableYear) kind institutional {
    label en official "the obligation is corporate acquisition indebtedness of the corporation liable for it (section 279(h)(2))";
}
@source(IRC_S279_H, quote = "(2) Any obligation which is corporate acquisition indebtedness of the issuing corporation is also corporate acquisition indebtedness of any corporation which becomes liable for such obligation as guarantor, endorser, or indemnitor or which assumes liability for such obligation in any transaction.")
rule ObligationIsCaiOfLiableCorporation(c: Corporation, obl: Integer, y: TaxableYear) strict {
    label en official "the status of the issuer passes to the guarantor or assumer";
    when corporate_acquisition_indebtedness_279(obl, y);
    when corporation_liable_for_obligation_as_guarantor_endorser_indemnitor_or_assumer(c, obl);
    then obligation_is_cai_of_liable_corporation(c, obl, y);
}
@source(IRC_S279_H, quote = "(2) Any obligation which is corporate acquisition indebtedness of the issuing corporation is also corporate acquisition indebtedness of any corporation which becomes liable for such obligation as guarantor, endorser, or indemnitor or which assumes liability for such obligation in any transaction.")
rule InterestOfLiableCorporationIsInterestOnCai(c: Corporation, y: TaxableYear, obl: Integer, amount: Money) strict {
    label en official "the liable corporation's interest is interest on corporate acquisition indebtedness; an amount asserted by a case is still accepted";
    when obligation_is_cai_of_liable_corporation(c, obl, y);
    when interest_paid_by_liable_corporation_on_obligation(c, y, obl, amount);
    then interest_on_corporate_acquisition_indebtedness(c, y, obl, amount);
}
