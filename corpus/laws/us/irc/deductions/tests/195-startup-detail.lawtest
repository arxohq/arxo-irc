    given {
        context {
            legal_time @2010-12-31;
            decision_time @2010-12-31T09:00:00-05:00;
            knowledge_time @2010-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": start_up_deduction_election_in_effect(entity_ref("urn:test:s195-44#p"),1) { origin case_input; }
        assert "f1": active_trade_or_business_begins_in_year(entity_ref("urn:test:s195-44#p"),1,entity_ref("urn:test:s195-44#y")) { origin case_input; }
        assert "f2": taxable_year_begins_on(entity_ref("urn:test:s195-44#y"),@2010-01-01) { origin case_input; }
        assert "f3": start_up_expenditures_aggregate(entity_ref("urn:test:s195-44#p"),1,40000.00 USD) { origin case_input; }
        assert "f4": start_up_amortization_month_fraction_for_year(entity_ref("urn:test:s195-44#p"),1,entity_ref("urn:test:s195-44#y"),0.0500) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s195-44#p"),entity_ref("urn:test:s195-44#y"),Section195StartUp,1500.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(b)(1)(B),(3): the remainder after 10,000 over 180 months";
}

test "S195-45-2010-STAGE-ONE-5000-RULE-NOT-APPLIED" {
    given {
        context {
            legal_time @2010-12-31;
            decision_time @2010-12-31T09:00:00-05:00;
            knowledge_time @2010-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": start_up_deduction_election_in_effect(entity_ref("urn:test:s195-45#p"),1) { origin case_input; }
        assert "f1": active_trade_or_business_begins_in_year(entity_ref("urn:test:s195-45#p"),1,entity_ref("urn:test:s195-45#y")) { origin case_input; }
        assert "f2": taxable_year_begins_on(entity_ref("urn:test:s195-45#y"),@2010-01-01) { origin case_input; }
        assert "f3": start_up_expenditures_aggregate(entity_ref("urn:test:s195-45#p"),1,40000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s195-45#p"),entity_ref("urn:test:s195-45#y"),Section195StartUp,5000.00 USD));
    expect truth_status == NEITHER;
    description "(b)(3): the 5,000 general amount is not used for a 2010 business";
}
