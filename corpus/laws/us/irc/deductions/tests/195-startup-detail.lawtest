test "S195-20-START-UP-INVESTIGATING" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": expenditure_for_start_up_purpose(entity_ref("urn:test:s195-20#p"),entity_ref("urn:test:s195-20#y"),1,1,InvestigatingCreationOrAcquisition,4000.00 USD) { origin case_input; }
        assert "f1": would_be_deductible_if_paid_in_operation_of_existing_business_in_same_field(1) { origin case_input; }
    }
    evaluate truth(start_up_expenditure(entity_ref("urn:test:s195-20#p"),entity_ref("urn:test:s195-20#y"),1,1,4000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(c)(1)(A)(i): investigating the acquisition of a business";
}

