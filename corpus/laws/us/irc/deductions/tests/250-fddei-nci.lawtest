// Section 250 scenarios (FDII/GILTI; Pub. L. 119-21 sections 70321-70322). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S250-01-DEDUCTION-2025-37-5-AND-50-PERCENT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s250:a1#y"),@2025-01-01) { origin case_input; }
        assert "f1": gross_income_for_deduction_eligible_income(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),1000000.00 USD) { origin case_input; }
        assert "f2": dei_excluded_income(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),200000.00 USD) { origin case_input; }
        assert "f3": deductions_properly_allocable_to_dei_gross_income(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),300000.00 USD) { origin case_input; }
        assert "f4": qualified_business_asset_investment_250(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),1000000.00 USD) { origin case_input; }
        assert "f5": foreign_derived_deduction_eligible_income(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),250000.00 USD) { origin case_input; }
        assert "f6": gilti_amount_included_under_951a(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),100000.00 USD) { origin case_input; }
        assert "f7": section_78_dividend_attributable_to_gilti(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),0.00 USD) { origin case_input; }
        assert "f8": taxable_income_without_section_250(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),1000000.00 USD) { origin case_input; }
    }
    evaluate truth(section_250_deduction(entity_ref("urn:test:s250:a1#c"),entity_ref("urn:test:s250:a1#y"),125000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "DEI 500,000; deemed tangible return 100,000; deemed intangible income 400,000; FDII = 400,000 x 250,000/500,000 = 200,000; deduction = 37.5 percent x 200,000 + 50 percent x 100,000 = 125,000 (section 250(a)(1),(b))";
}

