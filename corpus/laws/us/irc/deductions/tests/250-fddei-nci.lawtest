        assert "f4": qualified_business_asset_investment_250(entity_ref("urn:test:s250:b3#c"),entity_ref("urn:test:s250:b3#y"),1000000.00 USD) { origin case_input; }
        assert "f5": foreign_derived_deduction_eligible_income(entity_ref("urn:test:s250:b3#c"),entity_ref("urn:test:s250:b3#y"),200000.00 USD) { origin case_input; }
        assert "f6": gilti_amount_included_under_951a(entity_ref("urn:test:s250:b3#c"),entity_ref("urn:test:s250:b3#y"),100000.00 USD) { origin case_input; }
        assert "f7": section_78_dividend_attributable_to_gilti(entity_ref("urn:test:s250:b3#c"),entity_ref("urn:test:s250:b3#y"),0.00 USD) { origin case_input; }
