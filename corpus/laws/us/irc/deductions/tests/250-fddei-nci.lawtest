test "S250-04-TAXABLE-INCOME-LIMITATION-REDUCES-BOTH" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s250:a2#y"),@2025-01-01) { origin case_input; }
        assert "f1": gross_income_for_deduction_eligible_income(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),1000000.00 USD) { origin case_input; }
        assert "f2": dei_excluded_income(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),200000.00 USD) { origin case_input; }
        assert "f3": deductions_properly_allocable_to_dei_gross_income(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),300000.00 USD) { origin case_input; }
        assert "f4": qualified_business_asset_investment_250(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),1000000.00 USD) { origin case_input; }
        assert "f5": foreign_derived_deduction_eligible_income(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),250000.00 USD) { origin case_input; }
        assert "f6": gilti_amount_included_under_951a(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),100000.00 USD) { origin case_input; }
        assert "f7": section_78_dividend_attributable_to_gilti(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),0.00 USD) { origin case_input; }
        assert "f8": taxable_income_without_section_250(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),240000.00 USD) { origin case_input; }
    }
    evaluate truth(section_250_deduction(entity_ref("urn:test:s250:a2#c"),entity_ref("urn:test:s250:a2#y"),100000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "FDII 200,000 + GILTI 100,000 exceed taxable income 240,000 by 60,000; FDII reduced by 40,000 to 160,000 and GILTI by 20,000 to 80,000; deduction 60,000 + 40,000 = 100,000 (section 250(a)(2))";
}

