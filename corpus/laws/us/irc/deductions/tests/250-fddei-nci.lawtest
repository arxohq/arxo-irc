    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s250:a4#y"),@2026-01-01) { origin case_input; }
        assert "f1": gross_income_for_deduction_eligible_income(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),1000000.00 USD) { origin case_input; }
        assert "f2": dei_excluded_income(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),200000.00 USD) { origin case_input; }
        assert "f3": deductions_properly_allocable_to_dei_gross_income(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),300000.00 USD) { origin case_input; }
        assert "f4": qualified_business_asset_investment_250(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),1000000.00 USD) { origin case_input; }
        assert "f5": foreign_derived_deduction_eligible_income(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),250000.00 USD) { origin case_input; }
        assert "f6": gilti_amount_included_under_951a(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),100000.00 USD) { origin case_input; }
        assert "f7": section_78_dividend_attributable_to_gilti(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),0.00 USD) { origin case_input; }
        assert "f8": taxable_income_without_section_250(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),1000000.00 USD) { origin case_input; }
        assert "f9": dei_excluded_income_from_disposition_of_intangibles_after_2025_06_16(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),0.00 USD) { origin case_input; }
    }
    evaluate truth(section_250_deduction(entity_ref("urn:test:s250:a4#c"),entity_ref("urn:test:s250:a4#y"),106680.00 USD));
    expect truth_status == TRUE_ONLY;
    description "for years beginning after 2025 the rates are 33.34 and 40 percent: 200,000 x 0.3334 + 100,000 x 0.40 = 106,680 (Pub. L. 119-21 section 70321(a))";
}

