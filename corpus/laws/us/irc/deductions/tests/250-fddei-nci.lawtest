    description "DEI = 1,000,000 - 200,000 - 100,000 - 300,000 = 400,000; deemed intangible 300,000; FDII = 300,000 x 200,000/400,000 = 150,000 (Pub. L. 119-21 section 70322(a))";
}

test "S250-08-BEFORE-2018-NO-PERCENTAGES" {
    given {
        context {
            legal_time @2017-12-31;
            decision_time @2017-12-31T09:00:00-05:00;
            knowledge_time @2017-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s250:a5#y"),@2017-01-01) { origin case_input; }
    }
    evaluate truth(section_250_percentages(entity_ref("urn:test:s250:a5#y"),0.375,0.50));
    expect truth_status == NEITHER;
    description "section 250 applies to taxable years beginning after December 31, 2017; no percentage is derived for 2017";
}

test "S250-09-FOREIGN-USE-ESTABLISHED-SALE-IS-FOREIGN-DERIVED" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dei_item_sale_of_property_to_non_us_person(entity_ref("urn:test:s250:b4#c"),entity_ref("urn:test:s250:b4#y"),1) { origin case_input; }
        assert "f1": foreign_use_or_location_established_to_satisfaction_of_secretary(entity_ref("urn:test:s250:b4#c"),entity_ref("urn:test:s250:b4#y"),1) { origin adjudicated; }
    }
    evaluate truth(dei_item_is_foreign_derived(entity_ref("urn:test:s250:b4#c"),entity_ref("urn:test:s250:b4#y"),1));
    expect truth_status == TRUE_ONLY;
    description "a sale to a non-U.S. person that the Secretary is satisfied is for a foreign use is foreign-derived (section 250(b)(4)(A))";
}

test "S250-10-FOREIGN-USE-NOT-ESTABLISHED-NEITHER" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dei_item_sale_of_property_to_non_us_person(entity_ref("urn:test:s250:b5#c"),entity_ref("urn:test:s250:b5#y"),1) { origin case_input; }
    }
    evaluate truth(dei_item_is_foreign_derived(entity_ref("urn:test:s250:b5#c"),entity_ref("urn:test:s250:b5#y"),1));
    expect truth_status == NEITHER;
    description "without the Secretary's satisfaction the item is not established as foreign-derived; unknown is not negative (DECISION-0194)";
}

test "S250-11-SALE-FOR-FURTHER-MANUFACTURE-IN-US-EXCLUDED" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dei_item_sale_of_property_to_non_us_person(entity_ref("urn:test:s250:b6#c"),entity_ref("urn:test:s250:b6#y"),1) { origin case_input; }
        assert "f1": foreign_use_or_location_established_to_satisfaction_of_secretary(entity_ref("urn:test:s250:b6#c"),entity_ref("urn:test:s250:b6#y"),1) { origin adjudicated; }
        assert "f2": sale_to_domestic_intermediary_for_further_manufacture(entity_ref("urn:test:s250:b6#c"),entity_ref("urn:test:s250:b6#y"),1) { origin case_input; }
    }
    evaluate truth(dei_item_is_foreign_derived(entity_ref("urn:test:s250:b6#c"),entity_ref("urn:test:s250:b6#y"),1));
    expect truth_status == NEITHER;
    description "a sale to an unrelated person for further manufacture within the United States is not for a foreign use (section 250(b)(5)(B)(i))";
}

