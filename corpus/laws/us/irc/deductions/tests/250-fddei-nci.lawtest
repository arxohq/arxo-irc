        assert "f0": dei_item_services_provided_to_person_or_property_outside_us(entity_ref("urn:test:s250:b7#c"),entity_ref("urn:test:s250:b7#y"),1) { origin case_input; }
        assert "f1": foreign_use_or_location_established_to_satisfaction_of_secretary(entity_ref("urn:test:s250:b7#c"),entity_ref("urn:test:s250:b7#y"),1) { origin adjudicated; }
    }
    evaluate truth(dei_item_is_foreign_derived(entity_ref("urn:test:s250:b7#c"),entity_ref("urn:test:s250:b7#y"),1));
    expect truth_status == TRUE_ONLY;
