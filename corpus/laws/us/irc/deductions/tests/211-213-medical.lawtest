// Sections 211-213 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S213-01-MEDICAL-EXPENSES-AT-FLOOR-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": medical_care_expense_paid(entity_ref("urn:test:s213:at1#p"), entity_ref("urn:test:s213:at1#y2024"), 1, 7500 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s213:at1#p"), entity_ref("urn:test:s213:at1#y2024"), 100000 USD) { origin case_input; }
    }
    // aggregate 7,500 == 7.5% of 100,000 exactly: at the floor, not deductible.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s213:at1#p"), entity_ref("urn:test:s213:at1#y2024"), Section213Medical, 7500 USD));
    expect truth_status == FALSE_ONLY;
    description "aggregate expenses exactly equal to 7.5% of AGI: MedicalExpenseBelowFloorNotDeductible's <= guard fires";
}

test "S213-02-MEDICAL-EXPENSES-JUST-ABOVE-FLOOR-DEDUCTIBLE-EXCESS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": medical_care_expense_paid(entity_ref("urn:test:s213:at2#p"), entity_ref("urn:test:s213:at2#y2024"), 1, 7600 USD) { origin case_input; }
        assert "f1": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s213:at2#p"), entity_ref("urn:test:s213:at2#y2024"), 100000 USD) { origin case_input; }
    }
    // aggregate 7,600 - floor 7,500 = 100 deductible.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s213:at2#p"), entity_ref("urn:test:s213:at2#y2024"), Section213Medical, 100 USD));
    expect truth_status == TRUE_ONLY;
    description "aggregate expenses 100 dollars over the 7.5%-of-AGI floor: only the excess is deductible";
}

test "S213-03-UNPRESCRIBED-MEDICINE-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": medical_care_expense_paid(entity_ref("urn:test:s213:m1#p"), entity_ref("urn:test:s213:m1#y2024"), 1, 200 USD) { origin case_input; }
        assert "f1": is_medicine_or_drug_item(entity_ref("urn:test:s213:m1#p"), entity_ref("urn:test:s213:m1#y2024"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s213:m1#p"), entity_ref("urn:test:s213:m1#y2024"), Section213Medical, 200 USD));
    expect truth_status == FALSE_ONLY;
}

test "S213-04-UNKNOWN-AGI-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": medical_care_expense_paid(entity_ref("urn:test:s213:u1#p"), entity_ref("urn:test:s213:u1#y2024"), 1, 5000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s213:u1#p"), entity_ref("urn:test:s213:u1#y2024"), Section213Medical, 5000 USD));
    expect truth_status == NEITHER;
}
