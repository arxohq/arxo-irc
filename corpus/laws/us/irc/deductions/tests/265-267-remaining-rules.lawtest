// Sections 265(b) and 267(f),(g) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S265-20-FINANCIAL-INSTITUTION-INTEREST-ALLOCATED-TO-TAX-EXEMPT-OBLIGATIONS" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxpayer_is_financial_institution_265(entity_ref("urn:test:s265:b1#p")) { origin case_input; }
        assert "f1": financial_institution_interest_expense(entity_ref("urn:test:s265:b1#p"),entity_ref("urn:test:s265:b1#y"),1000000.00 USD) { origin case_input; }
        assert "f2": average_adjusted_basis_of_all_assets_265(entity_ref("urn:test:s265:b1#p"),entity_ref("urn:test:s265:b1#y"),100000000.00 USD) { origin case_input; }
        assert "f3": average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986(entity_ref("urn:test:s265:b1#p"),entity_ref("urn:test:s265:b1#y"),20000000.00 USD) { origin case_input; }
        assert "f4": average_adjusted_basis_of_qualified_tax_exempt_obligations(entity_ref("urn:test:s265:b1#p"),entity_ref("urn:test:s265:b1#y"),0.00 USD) { origin case_input; }
        assert "f5": average_adjusted_basis_of_obligations_issued_in_2009_or_2010(entity_ref("urn:test:s265:b1#p"),entity_ref("urn:test:s265:b1#y"),0.00 USD) { origin case_input; }
    }
    evaluate truth(financial_institution_teo_interest_disallowed(entity_ref("urn:test:s265:b1#p"),entity_ref("urn:test:s265:b1#y"),200000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "1,000,000 x 20,000,000 / 100,000,000 = 200,000 (section 265(b)(1),(2))";
}

test "S265-21-QUALIFIED-TAX-EXEMPT-OBLIGATIONS-LEAVE-THE-RATIO" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxpayer_is_financial_institution_265(entity_ref("urn:test:s265:b2#p")) { origin case_input; }
        assert "f1": financial_institution_interest_expense(entity_ref("urn:test:s265:b2#p"),entity_ref("urn:test:s265:b2#y"),1000000.00 USD) { origin case_input; }
        assert "f2": average_adjusted_basis_of_all_assets_265(entity_ref("urn:test:s265:b2#p"),entity_ref("urn:test:s265:b2#y"),100000000.00 USD) { origin case_input; }
        assert "f3": average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986(entity_ref("urn:test:s265:b2#p"),entity_ref("urn:test:s265:b2#y"),20000000.00 USD) { origin case_input; }
        assert "f4": average_adjusted_basis_of_qualified_tax_exempt_obligations(entity_ref("urn:test:s265:b2#p"),entity_ref("urn:test:s265:b2#y"),15000000.00 USD) { origin case_input; }
        assert "f5": average_adjusted_basis_of_obligations_issued_in_2009_or_2010(entity_ref("urn:test:s265:b2#p"),entity_ref("urn:test:s265:b2#y"),0.00 USD) { origin case_input; }
    }
    evaluate truth(financial_institution_teo_interest_disallowed(entity_ref("urn:test:s265:b2#p"),entity_ref("urn:test:s265:b2#y"),50000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(20 - 15) / 100 x 1,000,000 = 50,000 (section 265(b)(3)(A))";
}

test "S265-22-2009-2010-OBLIGATIONS-UP-TO-TWO-PERCENT-EXCLUDED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxpayer_is_financial_institution_265(entity_ref("urn:test:s265:b3#p")) { origin case_input; }
        assert "f1": financial_institution_interest_expense(entity_ref("urn:test:s265:b3#p"),entity_ref("urn:test:s265:b3#y"),1000000.00 USD) { origin case_input; }
        assert "f2": average_adjusted_basis_of_all_assets_265(entity_ref("urn:test:s265:b3#p"),entity_ref("urn:test:s265:b3#y"),100000000.00 USD) { origin case_input; }
        assert "f3": average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986(entity_ref("urn:test:s265:b3#p"),entity_ref("urn:test:s265:b3#y"),20000000.00 USD) { origin case_input; }
        assert "f4": average_adjusted_basis_of_qualified_tax_exempt_obligations(entity_ref("urn:test:s265:b3#p"),entity_ref("urn:test:s265:b3#y"),0.00 USD) { origin case_input; }
        assert "f5": average_adjusted_basis_of_obligations_issued_in_2009_or_2010(entity_ref("urn:test:s265:b3#p"),entity_ref("urn:test:s265:b3#y"),5000000.00 USD) { origin case_input; }
    }
    evaluate truth(financial_institution_teo_interest_disallowed(entity_ref("urn:test:s265:b3#p"),entity_ref("urn:test:s265:b3#y"),180000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "of 5,000,000 issued in 2009-2010 only 2 percent of 100,000,000 = 2,000,000 is left out: 18 / 100 x 1,000,000 = 180,000 (section 265(b)(7))";
}

