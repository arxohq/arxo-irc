// Section 213(d)(4) SSA reader (IRC-G/G6, 27.09.2026).
// Вывод / нет факта источника: with the case-selected section 1861(r)
// content fact the physician consequent derives (TRUE_ONLY); without it
// nothing derives (NEITHER). Expectations come from the statutory text;
// the SSA definition itself enters as a case fact (phase 0 source package
// `us.ssa.title42_values`, pinned govinfo bytes). NOT EXECUTED
// (implemented_unverified; execution is step 6, owner gate).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S213-SSA-01-PHYSICIAN-DERIVES" {
    given {
        context {
            legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": individual_practices_within_1861r_definition_213d4(entity_ref("urn:test:s213ssa:1#p")) { origin case_input; }
    }
    evaluate truth(physician_213d4(entity_ref("urn:test:s213ssa:1#p")));
    expect truth_status == TRUE_ONLY;
}

test "S213-SSA-02-WITHOUT-1861R-NEITHER" {
    given {
        context {
            legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York";
        }
    }
    evaluate truth(physician_213d4(entity_ref("urn:test:s213ssa:2#p")));
    expect truth_status == NEITHER;
}
