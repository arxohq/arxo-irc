    description "the 2024 indexed threshold is pinned nowhere: MISSING_PARAMETER_VALUE";
}

test "S199A-15-OVERALL-CAP-TWENTY-PERCENT-OF-TAXABLE-INCOME-LESS-NCG" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": combined_qbi_amount(entity_ref("urn:test:s199a:a1#p"),entity_ref("urn:test:s199a:a1#y"),40000.00 USD) { origin case_input; }
        assert "f1": taxable_income_for_199a(entity_ref("urn:test:s199a:a1#p"),entity_ref("urn:test:s199a:a1#y"),100000.00 USD) { origin case_input; }
        assert "f2": net_capital_gain_199a(entity_ref("urn:test:s199a:a1#p"),entity_ref("urn:test:s199a:a1#y"),60000.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.gross_income::section_199a_deduction(entity_ref("urn:test:s199a:a1#p"),entity_ref("urn:test:s199a:a1#y"),8000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "20 percent x (100,000 - 60,000) = 8,000 < 40,000 (section 199A(a))";
}

test "S199A-16-MINIMUM-DEDUCTION-400-FROM-2026" {
    given {
        context {
            legal_time @2026-06-30;
            decision_time @2026-06-30T09:00:00-05:00;
            knowledge_time @2026-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": taxable_income_for_199a(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),50000.00 USD) { origin case_input; }
        assert "f2": net_capital_gain_199a(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),0.00 USD) { origin case_input; }
        assert "f3": qualified_business_income(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),1,1500.00 USD) { origin case_input; }
        assert "f4": w2_wages_for_business(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),1,0.00 USD) { origin case_input; }
        assert "f5": ubia_for_business(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),1,0.00 USD) { origin case_input; }
        assert "f6": combined_qbi_amount(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),100.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.gross_income::section_199a_deduction(entity_ref("urn:test:s199a:i1#p"),entity_ref("urn:test:s199a:i1#y"),400.00 USD));
    expect truth_status == TRUE_ONLY;
    description "QBI of 1,500 from an active business: the deduction is the greater of 100 and 400 (Pub. L. 119-21 section 70105)";
}

