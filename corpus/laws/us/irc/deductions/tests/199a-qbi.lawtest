// Section 199A scenarios (stage 2 rewrite: separate threshold amount and range width, all filing statuses). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S199A-01-JOINT-BELOW-THRESHOLD-TWENTY-PERCENT-OF-QBI" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s199a:b1#p"),entity_ref("urn:test:s199a:b1#y"),us.irc.income_individual::Joint) { origin case_input; }
        assert "f1": taxable_income_for_199a(entity_ref("urn:test:s199a:b1#p"),entity_ref("urn:test:s199a:b1#y"),300000.00 USD) { origin case_input; }
        assert "f2": qualified_business_income(entity_ref("urn:test:s199a:b1#p"),entity_ref("urn:test:s199a:b1#y"),1,100000.00 USD) { origin case_input; }
        assert "f3": w2_wages_for_business(entity_ref("urn:test:s199a:b1#p"),entity_ref("urn:test:s199a:b1#y"),1,20000.00 USD) { origin case_input; }
        assert "f4": ubia_for_business(entity_ref("urn:test:s199a:b1#p"),entity_ref("urn:test:s199a:b1#y"),1,0.00 USD) { origin case_input; }
    }
    evaluate truth(section_199a_per_business_amount(entity_ref("urn:test:s199a:b1#p"),entity_ref("urn:test:s199a:b1#y"),1,20000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "taxable income 300,000 does not exceed the 2025 joint threshold 394,600: 20 percent of QBI (section 199A(b)(3)(A))";
}

test "S199A-02-JOINT-ABOVE-RANGE-WAGE-LIMIT-APPLIES" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s199a:b2#p"),entity_ref("urn:test:s199a:b2#y"),us.irc.income_individual::Joint) { origin case_input; }
        assert "f1": taxable_income_for_199a(entity_ref("urn:test:s199a:b2#p"),entity_ref("urn:test:s199a:b2#y"),550000.00 USD) { origin case_input; }
        assert "f2": qualified_business_income(entity_ref("urn:test:s199a:b2#p"),entity_ref("urn:test:s199a:b2#y"),1,500000.00 USD) { origin case_input; }
        assert "f3": w2_wages_for_business(entity_ref("urn:test:s199a:b2#p"),entity_ref("urn:test:s199a:b2#y"),1,100000.00 USD) { origin case_input; }
        assert "f4": ubia_for_business(entity_ref("urn:test:s199a:b2#p"),entity_ref("urn:test:s199a:b2#y"),1,200000.00 USD) { origin case_input; }
    }
    evaluate truth(section_199a_per_business_amount(entity_ref("urn:test:s199a:b2#p"),entity_ref("urn:test:s199a:b2#y"),1,50000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "above 394,600 + 100,000 the limit applies: min(100,000, max(50,000, 30,000)) = 50,000 (section 199A(b)(2))";
}

test "S199A-03-JOINT-MID-RANGE-REDUCTION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s199a:b3#p"),entity_ref("urn:test:s199a:b3#y"),us.irc.income_individual::Joint) { origin case_input; }
        assert "f1": taxable_income_for_199a(entity_ref("urn:test:s199a:b3#p"),entity_ref("urn:test:s199a:b3#y"),444600.00 USD) { origin case_input; }
        assert "f2": qualified_business_income(entity_ref("urn:test:s199a:b3#p"),entity_ref("urn:test:s199a:b3#y"),1,100000.00 USD) { origin case_input; }
        assert "f3": w2_wages_for_business(entity_ref("urn:test:s199a:b3#p"),entity_ref("urn:test:s199a:b3#y"),1,20000.00 USD) { origin case_input; }
        assert "f4": ubia_for_business(entity_ref("urn:test:s199a:b3#p"),entity_ref("urn:test:s199a:b3#y"),1,0.00 USD) { origin case_input; }
    }
    evaluate truth(section_199a_per_business_amount(entity_ref("urn:test:s199a:b3#p"),entity_ref("urn:test:s199a:b3#y"),1,15000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "excess amount 10,000 x (50,000 / 100,000) = 5,000 reduction: 20,000 - 5,000 = 15,000 (section 199A(b)(3)(B))";
}

