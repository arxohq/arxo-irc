// Section 267 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S267-01-LOSS-BETWEEN-FAMILY-MEMBERS-DISALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": family_member_of(entity_ref("urn:test:s267:a1#seller"), entity_ref("urn:test:s267:a1#buyer")) { origin case_input; }
        assert "f1": loss_from_sale_or_exchange_between_related_persons(entity_ref("urn:test:s267:a1#seller"), entity_ref("urn:test:s267:a1#buyer"), entity_ref("urn:test:s267:a1#y2024"), 1, 9000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s267:a1#seller"), entity_ref("urn:test:s267:a1#y2024"), Section262PersonalNonDeductible, 9000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S267-02-LIQUIDATING-DISTRIBUTION-LOSS-NOT-DISALLOWED-BY-THIS-RULE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": family_member_of(entity_ref("urn:test:s267:a2#seller"), entity_ref("urn:test:s267:a2#buyer")) { origin case_input; }
        assert "f1": loss_from_sale_or_exchange_between_related_persons(entity_ref("urn:test:s267:a2#seller"), entity_ref("urn:test:s267:a2#buyer"), entity_ref("urn:test:s267:a2#y2024"), 1, 9000 USD) { origin case_input; }
        assert "f2": liquidating_distribution_loss(entity_ref("urn:test:s267:a2#seller"), entity_ref("urn:test:s267:a2#buyer"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s267:a2#seller"), entity_ref("urn:test:s267:a2#y2024"), Section262PersonalNonDeductible, 9000 USD));
    expect truth_status == NEITHER;
    description "the second sentence of section 267(a)(1) excepts a complete-liquidation distribution loss from disallowance; this module does not itself affirmatively allow it (that is property-transactions' concern), so the guarded disallowance rule simply does not fire";
}

test "S267-03-UNRELATED-PARTIES-NO-DISALLOWANCE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": loss_from_sale_or_exchange_between_related_persons(entity_ref("urn:test:s267:a3#seller"), entity_ref("urn:test:s267:a3#buyer"), entity_ref("urn:test:s267:a3#y2024"), 1, 9000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s267:a3#seller"), entity_ref("urn:test:s267:a3#y2024"), Section262PersonalNonDeductible, 9000 USD));
    expect truth_status == NEITHER;
}

test "S267-04-INDIVIDUAL-AND-CONTROLLED-CORPORATION-RELATED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.corporations::constructive_ownership(entity_ref("urn:test:s267:v4#p"), entity_ref("urn:test:s267:v4#corp"), 0.60, us.irc.corporations::Actual) { origin case_input; }
    }
    evaluate truth(related_persons(entity_ref("urn:test:s267:v4#p"), entity_ref("urn:test:s267:v4#corp"), IndividualAndControlledCorporation));
    expect truth_status == TRUE_ONLY;
    description "an individual owning more than 50 percent of a corporation's stock (by value), directly or indirectly, is related to it under section 267(b)(2)";
}

test "S267-05-FIFTY-PERCENT-EXACTLY-NOT-RELATED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.corporations::constructive_ownership(entity_ref("urn:test:s267:v5#p"), entity_ref("urn:test:s267:v5#corp"), 0.50, us.irc.corporations::Actual) { origin case_input; }
    }
    evaluate truth(related_persons(entity_ref("urn:test:s267:v5#p"), entity_ref("urn:test:s267:v5#corp"), IndividualAndControlledCorporation));
    expect truth_status == NEITHER;
    description "section 267(b)(2) requires MORE THAN 50 percent; exactly 50 percent does not trigger the relationship";
}

test "S267-06-GAIN-LIMITED-BY-PRIOR-DISALLOWED-LOSS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": prior_loss_disallowed_under_267a1(entity_ref("urn:test:s267:v6#seller"), entity_ref("urn:test:s267:v6#taxpayer"), 1, 10000.00 USD) { origin case_input; }
        assert "f1": gain_on_later_disposition(entity_ref("urn:test:s267:v6#taxpayer"), 1, entity_ref("urn:test:s267:v6#y2024"), 15000.00 USD) { origin case_input; }
    }
    // 15,000 realized gain, exceeding the 10,000 previously disallowed loss
    // by 5,000: only 5,000 is recognized.
    evaluate truth(recognized_gain_after_prior_disallowed_loss(entity_ref("urn:test:s267:v6#taxpayer"), 1, entity_ref("urn:test:s267:v6#y2024"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "gain on a later sale of previously loss-disallowed property is recognized only to the extent it exceeds the prior disallowed loss (section 267(d)(1))";
}

test "S267-07-GAIN-FULLY-OFFSET-BY-PRIOR-DISALLOWED-LOSS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": prior_loss_disallowed_under_267a1(entity_ref("urn:test:s267:v7#seller"), entity_ref("urn:test:s267:v7#taxpayer"), 1, 20000.00 USD) { origin case_input; }
        assert "f1": gain_on_later_disposition(entity_ref("urn:test:s267:v7#taxpayer"), 1, entity_ref("urn:test:s267:v7#y2024"), 15000.00 USD) { origin case_input; }
    }
    // 15,000 realized gain does not exceed the 20,000 prior disallowed loss: nothing recognized.
    evaluate truth(recognized_gain_after_prior_disallowed_loss(entity_ref("urn:test:s267:v7#taxpayer"), 1, entity_ref("urn:test:s267:v7#y2024"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    description "when the realized gain does not exceed the prior disallowed loss, no gain is recognized (floored at zero)";
}
