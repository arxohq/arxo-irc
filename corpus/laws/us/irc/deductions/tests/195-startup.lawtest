// Section 195 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S195-01-NO-ELECTION-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": start_up_expenditure(entity_ref("urn:test:s195:a1#p"), entity_ref("urn:test:s195:a1#y2024"), 1, 1, 8000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s195:a1#p"), entity_ref("urn:test:s195:a1#y2024"), Section195StartUp, 8000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S195-02-ELECTION-UNDER-FIFTY-THOUSAND-FULL-FIVE-THOUSAND-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_to_deduct_start_up_expenditures(entity_ref("urn:test:s195:b1#p"), 1) { origin case_input; }
        assert "f1": active_trade_or_business_begins_in_year(entity_ref("urn:test:s195:b1#p"), 1, entity_ref("urn:test:s195:b1#y2024")) { origin case_input; }
        assert "f2": start_up_expenditures_aggregate(entity_ref("urn:test:s195:b1#p"), 1, 5000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s195:b1#p"), entity_ref("urn:test:s195:b1#y2024"), Section195StartUp, 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S195-03-ELECTION-ABOVE-FIFTY-THOUSAND-PHASED-DOWN" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_to_deduct_start_up_expenditures(entity_ref("urn:test:s195:b2#p"), 1) { origin case_input; }
        assert "f1": active_trade_or_business_begins_in_year(entity_ref("urn:test:s195:b2#p"), 1, entity_ref("urn:test:s195:b2#y2024")) { origin case_input; }
        assert "f2": start_up_expenditures_aggregate(entity_ref("urn:test:s195:b2#p"), 1, 53000 USD) { origin case_input; }
    }
    // $5,000 - ($53,000 - $50,000) = $2,000 immediate deduction.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s195:b2#p"), entity_ref("urn:test:s195:b2#y2024"), Section195StartUp, 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S195-04-REMAINDER-AMORTIZED-OVER-180-MONTHS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_to_deduct_start_up_expenditures(entity_ref("urn:test:s195:c1#p"), 1) { origin case_input; }
        assert "f1": start_up_expenditures_aggregate(entity_ref("urn:test:s195:c1#p"), 1, 23000 USD) { origin case_input; }
        // 23,000 - 5,000 = 18,000 remainder; 9 of the 180 months fall in this year (9/180 = 0.05).
        assert "f2": start_up_amortization_month_fraction_for_year(entity_ref("urn:test:s195:c1#p"), 1, entity_ref("urn:test:s195:c1#y2024"), 0.05) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s195:c1#p"), entity_ref("urn:test:s195:c1#y2024"), Section195StartUp, 900 USD));
    expect truth_status == TRUE_ONLY;
}
