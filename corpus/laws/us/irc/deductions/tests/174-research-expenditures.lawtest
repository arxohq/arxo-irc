// Section 174/174A scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S174-01-DOMESTIC-PRE-2025-FIVE-YEAR-AMORTIZATION" {
    given {
        context {
            legal_time @2023-04-15;
            decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:v1#y2023"), @2023-01-01) { origin case_input; }
        assert "f1": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:v1#p"), entity_ref("urn:test:s174:v1#y2023"), 1, 100000.00 USD) { origin case_input; }
    }
    // 100,000 / 5 = 20,000.00.
    evaluate truth(section_174_amortization_year1(entity_ref("urn:test:s174:v1#p"), entity_ref("urn:test:s174:v1#y2023"), 1, 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "domestic research expenditures for a taxable year beginning before 2025 amortize ratably over 5 years (section 174(a))";
}

test "S174-02-FOREIGN-PRE-2025-FIFTEEN-YEAR-AMORTIZATION" {
    given {
        context {
            legal_time @2023-04-15;
            decision_time @2023-04-15T09:00:00-05:00;
            knowledge_time @2023-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:v2#y2023"), @2023-01-01) { origin case_input; }
        assert "f1": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:v2#p"), entity_ref("urn:test:s174:v2#y2023"), 1, 150000.00 USD) { origin case_input; }
        assert "f2": research_expenditure_attributable_to_foreign_research(entity_ref("urn:test:s174:v2#p"), entity_ref("urn:test:s174:v2#y2023"), 1) { origin case_input; }
    }
    // 150,000 / 15 = 10,000.00.
    evaluate truth(section_174_amortization_year1(entity_ref("urn:test:s174:v2#p"), entity_ref("urn:test:s174:v2#y2023"), 1, 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "foreign research expenditures for a taxable year beginning before 2025 amortize ratably over 15 years (section 174(a)(2)(B))";
}

test "S174-03-DOMESTIC-POST-2025-IMMEDIATE-EXPENSING" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:v3#y2025"), @2025-01-01) { origin case_input; }
        assert "f1": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:v3#p"), entity_ref("urn:test:s174:v3#y2025"), 1, 100000.00 USD) { origin case_input; }
    }
    evaluate truth(domestic_research_expenditure_deduction(entity_ref("urn:test:s174:v3#p"), entity_ref("urn:test:s174:v3#y2025"), 1, 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "domestic research or experimental expenditures for a taxable year beginning after December 31, 2024 are immediately deductible in full (Pub. L. 119-21 section 70302, new section 174A(a))";
}

test "S174-04-POST-2025-YEAR-GETS-NO-OLD-AMORTIZATION" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:v4#y2025"), @2025-01-01) { origin case_input; }
        assert "f1": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:v4#p"), entity_ref("urn:test:s174:v4#y2025"), 1, 100000.00 USD) { origin case_input; }
    }
    evaluate truth(section_174_amortization_year1(entity_ref("urn:test:s174:v4#p"), entity_ref("urn:test:s174:v4#y2025"), 1, 20000.00 USD));
    expect truth_status == NEITHER;
    description "a taxable year beginning after December 31, 2024 is not governed by the pre-amendment section 174(a) amortization schedule (the domestic edition applies instead)";
}
