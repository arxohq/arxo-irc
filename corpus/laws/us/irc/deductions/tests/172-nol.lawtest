// Section 172 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S172-01-POST-2017-NOL-CAPPED-AT-EIGHTY-PERCENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nol_carryover_post2017_arising(entity_ref("urn:test:s172:a1#p"), entity_ref("urn:test:s172:a1#y2024"), 900000 USD) { origin case_input; }
        assert "f1": nol_carryover_pre2018_arising(entity_ref("urn:test:s172:a1#p"), entity_ref("urn:test:s172:a1#y2024"), 0 USD) { origin case_input; }
        assert "f2": taxable_income_before_nol_199a_250(entity_ref("urn:test:s172:a1#p"), entity_ref("urn:test:s172:a1#y2024"), 1000000 USD) { origin case_input; }
    }
    // 80% of (1,000,000 - 0) = 800,000 < 900,000 carryover, so capped at 800,000.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s172:a1#p"), entity_ref("urn:test:s172:a1#y2024"), Section172Nol, 800000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S172-02-POST-2017-NOL-WITHIN-EIGHTY-PERCENT-FULLY-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nol_carryover_post2017_arising(entity_ref("urn:test:s172:a2#p"), entity_ref("urn:test:s172:a2#y2024"), 200000 USD) { origin case_input; }
        assert "f1": nol_carryover_pre2018_arising(entity_ref("urn:test:s172:a2#p"), entity_ref("urn:test:s172:a2#y2024"), 0 USD) { origin case_input; }
        assert "f2": taxable_income_before_nol_199a_250(entity_ref("urn:test:s172:a2#p"), entity_ref("urn:test:s172:a2#y2024"), 1000000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s172:a2#p"), entity_ref("urn:test:s172:a2#y2024"), Section172Nol, 200000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S172-03-TWO-YEAR-CARRYOVER-LOSS-YEAR-TO-NEXT-YEAR" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Year 1 (2024): a $150,000 net operating loss arises.
        assert "f0": net_operating_loss_for_year(entity_ref("urn:test:s172:two#p"), entity_ref("urn:test:s172:two#y2024"), 150000 USD) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s172:two#p"), entity_ref("urn:test:s172:two#y2025")) { origin case_input; }
    }
    // Year 2 (2025): the section 172(b)(1)(A)(ii)(II) indefinite carryforward
    // rule derives the carryover from year 1 to year 2.
    evaluate truth(nol_carryover_to_year(entity_ref("urn:test:s172:two#p"), entity_ref("urn:test:s172:two#y2024"), entity_ref("urn:test:s172:two#y2025"), 150000 USD));
    expect truth_status == TRUE_ONLY;
    description "section 172(b)(1)(A)(ii)(II): a post-2017 NOL carries to every succeeding taxable year — this scenario exercises the loss-year-to-following-year edge across two TaxableYear instances";
}

test "S172-04-FARMING-LOSS-TWO-YEAR-CARRYBACK" {
    given {
        context {
            legal_time @2022-04-15;
            decision_time @2022-04-15T09:00:00-05:00;
            knowledge_time @2022-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // Loss year 2024; carried BACK to 2022 (a preceding year).
        assert "f0": is_farming_loss_portion(entity_ref("urn:test:s172:farm#p"), entity_ref("urn:test:s172:farm#y2024"), 40000 USD) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:test:s172:farm#p"), entity_ref("urn:test:s172:farm#y2022")) { origin case_input; }
    }
    evaluate truth(nol_carryover_to_year(entity_ref("urn:test:s172:farm#p"), entity_ref("urn:test:s172:farm#y2024"), entity_ref("urn:test:s172:farm#y2022"), 40000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S172-05-NO-CARRYOVER-ASSERTED-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s172:u1#p"), entity_ref("urn:test:s172:u1#y2024"), Section172Nol, 1000 USD));
    expect truth_status == NEITHER;
}
