// Sections 266 and 268 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S266-01-ELECTED-CARRYING-CHARGES-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_to_capitalize_taxes_and_carrying_charges(entity_ref("urn:test:s266:a1#p"),entity_ref("urn:test:s266:a1#y"),1) { origin case_input; }
        assert "f1": tax_or_carrying_charge_chargeable_to_capital_under_regulations(entity_ref("urn:test:s266:a1#p"),entity_ref("urn:test:s266:a1#y"),1,4000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s266:a1#p"),entity_ref("urn:test:s266:a1#y"),Section266CarryingCharges,4000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "after the section 266 election the carrying charges are capitalized and not deducted";
}

test "S266-02-NO-ELECTION-NO-DENIAL" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tax_or_carrying_charge_chargeable_to_capital_under_regulations(entity_ref("urn:test:s266:a2#p"),entity_ref("urn:test:s266:a2#y"),1,4000.00 USD) { origin case_input; }
    }
    evaluate truth(carrying_charge_deduction_denied_266(entity_ref("urn:test:s266:a2#p"),entity_ref("urn:test:s266:a2#y"),1,4000.00 USD));
    expect truth_status == NEITHER;
    description "without the election section 266 does not deny the deduction";
}

test "S268-01-UNHARVESTED-CROP-PRODUCTION-COSTS-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": unharvested_crop_sold_with_land_as_section_1231_property(entity_ref("urn:test:s268:a1#p"),entity_ref("urn:test:s268:a1#y"),1) { origin case_input; }
        assert "f1": deduction_attributable_to_production_of_crop(entity_ref("urn:test:s268:a1#p"),entity_ref("urn:test:s268:a1#y"),1,7000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s268:a1#p"),entity_ref("urn:test:s268:a1#y"),Section268CropProduction,7000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "no deduction for the production of a crop sold with the land as section 1231 property (section 268)";
}
