test "S216-03-DEDUCTION-LIMITED-TO-PROPORTIONATE-SHARE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": corporation_has_one_class_of_stock_and_occupancy_rights(1,entity_ref("urn:test:s216:a1#y")) { origin case_input; }
        assert "f1": cooperative_gross_income_80_percent_from_tenant_stockholders(1,entity_ref("urn:test:s216:a1#y")) { origin case_input; }
        assert "f2": stockholder_of_cooperative_housing_corporation(entity_ref("urn:test:s216:a1#p"),entity_ref("urn:test:s216:a1#y"),1) { origin case_input; }
        assert "f3": stock_paid_up_in_reasonable_relationship_shown_to_secretary(entity_ref("urn:test:s216:a1#p"),entity_ref("urn:test:s216:a1#y"),1) { origin adjudicated; }
        assert "f4": shares_owned_by_stockholder(entity_ref("urn:test:s216:a1#p"),entity_ref("urn:test:s216:a1#y"),1,100) { origin case_input; }
        assert "f5": total_shares_outstanding_including_treasury(1,entity_ref("urn:test:s216:a1#y"),1000) { origin case_input; }
        assert "f6": corporation_real_estate_taxes_deductible_216a1(1,entity_ref("urn:test:s216:a1#y"),60000.00 USD) { origin case_input; }
        assert "f7": corporation_qualifying_interest_216a2(1,entity_ref("urn:test:s216:a1#y"),40000.00 USD) { origin case_input; }
        assert "f8": amounts_paid_or_accrued_to_cooperative(entity_ref("urn:test:s216:a1#p"),entity_ref("urn:test:s216:a1#y"),1,12000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s216:a1#p"),entity_ref("urn:test:s216:a1#y"),Section216TenantStockholder,10000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "10/100 of taxes and interest 100,000 is 10,000; a payment of 12,000 is deductible to that extent (section 216(a),(b)(3)(A))";
}

