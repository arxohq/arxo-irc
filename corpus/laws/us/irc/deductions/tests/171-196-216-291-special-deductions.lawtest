// Sections 171, 196, 216, 291 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S171-01-TAXABLE-BOND-PREMIUM-DEDUCTED-WITH-ELECTION" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": makes_section_171c_election(entity_ref("urn:test:s171:a1#p"),entity_ref("urn:test:s171:a1#y")) { origin case_input; }
        assert "f1": bond_premium_attributable_to_year(entity_ref("urn:test:s171:a1#p"),entity_ref("urn:test:s171:a1#y"),1,1200.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s171:a1#p"),entity_ref("urn:test:s171:a1#y"),Section171BondPremium,1200.00 USD));
    expect truth_status == TRUE_ONLY;
    description "the premium attributable to the year on a taxable bond is deductible once the section 171(c) election is in effect (section 171(a)(1))";
}

