            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ordinary_income_if_section_1245_property_291(entity_ref("urn:test:s291:c1#c"),entity_ref("urn:test:s291:c1#y"),1,100000.00 USD) { origin case_input; }
        assert "f1": ordinary_income_under_section_1250_291(entity_ref("urn:test:s291:c1#c"),entity_ref("urn:test:s291:c1#y"),1,60000.00 USD) { origin case_input; }
        assert "f2": section_1250_property_in_certified_pollution_control_facility_with_169_election(entity_ref("urn:test:s291:c1#c"),entity_ref("urn:test:s291:c1#y"),1) { origin case_input; }
    }
    evaluate truth(additional_section_1250_ordinary_income_291(entity_ref("urn:test:s291:c1#c"),entity_ref("urn:test:s291:c1#y"),1,8000.00 USD));
    expect truth_status == NEITHER;
    description "section 291(a)(1) does not apply to a section 169 facility (section 291(c)(2))";
}

