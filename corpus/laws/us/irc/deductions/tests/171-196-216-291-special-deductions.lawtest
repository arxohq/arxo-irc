            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ordinary_income_if_section_1245_property_291(entity_ref("urn:test:s291:a1#c"),entity_ref("urn:test:s291:a1#y"),1,100000.00 USD) { origin case_input; }
        assert "f1": ordinary_income_under_section_1250_291(entity_ref("urn:test:s291:a1#c"),entity_ref("urn:test:s291:a1#y"),1,60000.00 USD) { origin case_input; }
    }
    evaluate truth(additional_section_1250_ordinary_income_291(entity_ref("urn:test:s291:a1#c"),entity_ref("urn:test:s291:a1#y"),1,8000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "20 percent of (100,000 - 60,000) is ordinary income (section 291(a)(1))";
}

test "S291-02-POLLUTION-CONTROL-FACILITY-EXCEPTED" {
    given {
        context {
            legal_time @2025-12-31;
