test "S171-04-BOND-PREMIUM-BASIS-OVER-MATURITY" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bond_basis_for_loss_171(entity_ref("urn:test:s171:b1#p"),1,10500.00 USD) { origin case_input; }
        assert "f1": bond_amount_payable_at_maturity(entity_ref("urn:test:s171:b1#p"),1,10000.00 USD) { origin case_input; }
        assert "f2": bond_premium_attributable_to_conversion_feature(entity_ref("urn:test:s171:b1#p"),1,0.00 USD) { origin case_input; }
    }
    evaluate truth(bond_premium_total_171b(entity_ref("urn:test:s171:b1#p"),1,500.00 USD));
    expect truth_status == TRUE_ONLY;
    description "basis 10,500 over the amount payable at maturity 10,000 is a premium of 500 (section 171(b)(1))";
}

test "S171-05-EXCHANGE-BASIS-CAPPED-AT-FAIR-MARKET-VALUE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bond_basis_for_loss_171(entity_ref("urn:test:s171:b2#p"),1,12000.00 USD) { origin case_input; }
        assert "f1": bond_acquired_in_exchange_with_carryover_basis(entity_ref("urn:test:s171:b2#p"),1) { origin case_input; }
        assert "f2": bond_fair_market_value_after_exchange(entity_ref("urn:test:s171:b2#p"),1,10800.00 USD) { origin case_input; }
        assert "f3": bond_amount_payable_at_maturity(entity_ref("urn:test:s171:b2#p"),1,10000.00 USD) { origin case_input; }
        assert "f4": bond_premium_attributable_to_conversion_feature(entity_ref("urn:test:s171:b2#p"),1,0.00 USD) { origin case_input; }
    }
    evaluate truth(bond_premium_total_171b(entity_ref("urn:test:s171:b2#p"),1,800.00 USD));
    expect truth_status == TRUE_ONLY;
    description "for a bond acquired in an exchange the basis is capped at fair market value 10,800, so the premium is 800 (section 171(b)(4)(A))";
}

