// Section 221 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S221-01-INTEREST-WITHIN-CAP-BELOW-THRESHOLD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_education_loan_interest_paid(entity_ref("urn:test:s221:a1#p"), entity_ref("urn:test:s221:a1#y2024"), 1800 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s221:a1#p"), entity_ref("urn:test:s221:a1#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": modified_agi_for_221(entity_ref("urn:test:s221:a1#p"), entity_ref("urn:test:s221:a1#y2024"), 40000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s221:a1#p"), entity_ref("urn:test:s221:a1#y2024"), Section221StudentLoanInterest, 1800 USD));
    expect truth_status == TRUE_ONLY;
}

test "S221-02-INTEREST-EXCEEDS-CAP-LIMITED-TO-2500" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_education_loan_interest_paid(entity_ref("urn:test:s221:a2#p"), entity_ref("urn:test:s221:a2#y2024"), 3200 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s221:a2#p"), entity_ref("urn:test:s221:a2#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": modified_agi_for_221(entity_ref("urn:test:s221:a2#p"), entity_ref("urn:test:s221:a2#y2024"), 40000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s221:a2#p"), entity_ref("urn:test:s221:a2#y2024"), Section221StudentLoanInterest, 2500 USD));
    expect truth_status == TRUE_ONLY;
}

test "S221-03-PHASED-OUT-ABOVE-MAGI-RANGE-NO-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s221:a3#p"), entity_ref("urn:test:s221:a3#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": modified_agi_for_221(entity_ref("urn:test:s221:a3#p"), entity_ref("urn:test:s221:a3#y2024"), 70000 USD) { origin case_input; }
    }
    // 70,000 >= 50,000 + 15,000 = 65,000: fully phased out.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s221:a3#p"), entity_ref("urn:test:s221:a3#y2024"), Section221StudentLoanInterest, 2500 USD));
    expect truth_status == FALSE_ONLY;
}

test "S221-04-DEPENDENT-NO-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_education_loan_interest_paid(entity_ref("urn:test:s221:d1#p"), entity_ref("urn:test:s221:d1#y2024"), 900 USD) { origin case_input; }
        assert "f1": claimed_as_dependent_151_for_221(entity_ref("urn:test:s221:d1#p"), entity_ref("urn:test:s221:d1#y2024")) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s221:d1#p"), entity_ref("urn:test:s221:d1#y2024"), Section221StudentLoanInterest, 900 USD));
    expect truth_status == FALSE_ONLY;
}

test "S221-05-JOINT-RETURN-BELOW-HUNDRED-THOUSAND-THRESHOLD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_education_loan_interest_paid(entity_ref("urn:test:s221:j1#p"), entity_ref("urn:test:s221:j1#y2024"), 2200 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s221:j1#p"), entity_ref("urn:test:s221:j1#y2024"), us.irc.income_individual::Joint) { origin case_input; }
        assert "f2": modified_agi_for_221(entity_ref("urn:test:s221:j1#p"), entity_ref("urn:test:s221:j1#y2024"), 95000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s221:j1#p"), entity_ref("urn:test:s221:j1#y2024"), Section221StudentLoanInterest, 2200 USD));
    expect truth_status == TRUE_ONLY;
}
