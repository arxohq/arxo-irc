test "S168N-1-QUALIFIED-PRODUCT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qpp_product_is_tangible_personal_property(entity_ref("urn:test:s168n-1#p"),entity_ref("urn:test:s168n-1#a")) { origin case_input; }
    }
    evaluate truth(qpp_qualified_product(entity_ref("urn:test:s168n-1#p"),entity_ref("urn:test:s168n-1#a")));
    expect truth_status == TRUE_ONLY;
    description "(n)(2)(F): tangible personal property";
}

