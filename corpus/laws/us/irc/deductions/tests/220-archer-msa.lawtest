        assert "f1": hdhp_established_by_small_employer_or_self_employed(entity_ref("urn:test:s220:i2#p"),entity_ref("urn:test:s220:i2#y")) { origin case_input; }
        assert "f2": taxable_year_begins_on(entity_ref("urn:test:s220:i2#y"),@2025-01-01) { origin case_input; }
        assert "f3": active_msa_participant_or_new_participant_of_participating_employer(entity_ref("urn:test:s220:i2#p"),entity_ref("urn:test:s220:i2#y")) { origin case_input; }
    }
    evaluate truth(eligible_individual_for_month_220(entity_ref("urn:test:s220:i2#p"),entity_ref("urn:test:s220:i2#y"),1));
    expect truth_status == TRUE_ONLY;
    description "an active MSA participant remains eligible after the cut-off year (section 220(i)(1)(A))";
}

test "S220-04-OVERLAPPING-OTHER-PLAN-NOT-ELIGIBLE" {
    given {
        context {
            legal_time @2007-12-31;
            decision_time @2007-12-31T09:00:00-05:00;
            knowledge_time @2007-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": covered_by_high_deductible_health_plan_first_day_of_month(entity_ref("urn:test:s220:c2#p"),entity_ref("urn:test:s220:c2#y"),1) { origin case_input; }
        assert "f1": hdhp_established_by_small_employer_or_self_employed(entity_ref("urn:test:s220:c2#p"),entity_ref("urn:test:s220:c2#y")) { origin case_input; }
        assert "f2": taxable_year_begins_on(entity_ref("urn:test:s220:c2#y"),@2007-01-01) { origin case_input; }
        assert "f3": covered_by_other_overlapping_health_plan(entity_ref("urn:test:s220:c2#p"),entity_ref("urn:test:s220:c2#y"),1) { origin case_input; }
    }
    evaluate truth(eligible_individual_for_month_220(entity_ref("urn:test:s220:c2#p"),entity_ref("urn:test:s220:c2#y"),1));
    expect truth_status == NEITHER;
    description "coverage under a non-HDHP that covers the same benefits disqualifies (section 220(c)(1)(A)(ii))";
}

test "S220-05-SELF-ONLY-PLAN-QUALIFIES-2025" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": health_plan_is_self_only(1) { origin case_input; }
        assert "f1": health_plan_annual_deductible(1,entity_ref("urn:test:s220:c3#y"),3000.00 USD) { origin case_input; }
        assert "f2": health_plan_annual_out_of_pocket(1,entity_ref("urn:test:s220:c3#y"),5000.00 USD) { origin case_input; }
    }
    evaluate truth(high_deductible_health_plan_220(1,entity_ref("urn:test:s220:c3#y")));
    expect truth_status == TRUE_ONLY;
    description "deductible 3,000 within 2,850-4,300 and out-of-pocket 5,000 within 5,700 (Rev. Proc. 2024-40 section 2.29)";
}

