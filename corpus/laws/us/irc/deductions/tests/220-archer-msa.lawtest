        }
        assert "f0": archer_msa_distribution(entity_ref("urn:test:s220:f1#p"),entity_ref("urn:test:s220:f1#y"),1,4000.00 USD) { origin case_input; }
        assert "f1": distribution_used_exclusively_for_qualified_medical_expenses(entity_ref("urn:test:s220:f1#p"),entity_ref("urn:test:s220:f1#y"),1) { origin case_input; }
    }
    evaluate truth(archer_msa_distribution_excluded_from_income(entity_ref("urn:test:s220:f1#p"),entity_ref("urn:test:s220:f1#y"),1));
    expect truth_status == TRUE_ONLY;
    description "a distribution used exclusively for qualified medical expenses is not gross income (section 220(f)(1))";
}

