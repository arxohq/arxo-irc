// Section 220 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S220-01-ELIGIBLE-INDIVIDUAL-2007" {
    given {
        context {
            legal_time @2007-12-31;
            decision_time @2007-12-31T09:00:00-05:00;
            knowledge_time @2007-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": covered_by_high_deductible_health_plan_first_day_of_month(entity_ref("urn:test:s220:c1#p"),entity_ref("urn:test:s220:c1#y"),1) { origin case_input; }
        assert "f1": hdhp_established_by_small_employer_or_self_employed(entity_ref("urn:test:s220:c1#p"),entity_ref("urn:test:s220:c1#y")) { origin case_input; }
        assert "f2": taxable_year_begins_on(entity_ref("urn:test:s220:c1#y"),@2007-01-01) { origin case_input; }
    }
    evaluate truth(eligible_individual_for_month_220(entity_ref("urn:test:s220:c1#p"),entity_ref("urn:test:s220:c1#y"),1));
    expect truth_status == TRUE_ONLY;
    description "coverage on the first day of the month under a qualifying plan makes an eligible individual in the cut-off year (section 220(c)(1))";
}

test "S220-02-AFTER-CUT-OFF-YEAR-NEEDS-ACTIVE-PARTICIPANT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": covered_by_high_deductible_health_plan_first_day_of_month(entity_ref("urn:test:s220:i1#p"),entity_ref("urn:test:s220:i1#y"),1) { origin case_input; }
        assert "f1": hdhp_established_by_small_employer_or_self_employed(entity_ref("urn:test:s220:i1#p"),entity_ref("urn:test:s220:i1#y")) { origin case_input; }
        assert "f2": taxable_year_begins_on(entity_ref("urn:test:s220:i1#y"),@2025-01-01) { origin case_input; }
    }
    evaluate truth(eligible_individual_for_month_220(entity_ref("urn:test:s220:i1#p"),entity_ref("urn:test:s220:i1#y"),1));
    expect truth_status == NEITHER;
    description "for a taxable year beginning after 2007 no one is eligible unless an active MSA participant (section 220(i)(1))";
}

test "S220-03-ACTIVE-PARTICIPANT-AFTER-CUT-OFF-ELIGIBLE" {
    given {
        context {
            legal_time @2025-06-30;
