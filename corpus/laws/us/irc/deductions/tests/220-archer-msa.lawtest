        assert "f1": amount_paid_in_cash_to_archer_msa(entity_ref("urn:test:s220:a1#p"),entity_ref("urn:test:s220:a1#y"),5000.00 USD) { origin case_input; }
        assert "f2": compensation_cap_for_archer_msa(entity_ref("urn:test:s220:a1#p"),entity_ref("urn:test:s220:a1#y"),40000.00 USD) { origin case_input; }
