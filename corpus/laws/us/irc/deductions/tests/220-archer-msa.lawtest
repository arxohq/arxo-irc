        assert "f1": amount_paid_in_cash_to_archer_msa(entity_ref("urn:test:s220:b5#p"),entity_ref("urn:test:s220:b5#y"),1500.00 USD) { origin case_input; }
        assert "f2": compensation_cap_for_archer_msa(entity_ref("urn:test:s220:b5#p"),entity_ref("urn:test:s220:b5#y"),40000.00 USD) { origin case_input; }
        assert "f3": section_106b_excludable_contribution_to_archer_msa(entity_ref("urn:test:s220:b5#p"),entity_ref("urn:test:s220:b5#y")) { origin case_input; }
