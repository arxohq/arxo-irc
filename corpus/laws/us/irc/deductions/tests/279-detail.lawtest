        assert "f6": five_percent_rule_blocks_279(1,entity_ref("urn:test:s279x-39#y4")) { origin case_input; }
    }
    evaluate truth(corporate_acquisition_indebtedness_279(1,entity_ref("urn:test:s279x-39#y4")));
    expect truth_status == NEITHER;
    description "(d)(5): the 5 percent rule for a later year";
}

