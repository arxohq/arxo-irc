// Section 170 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S170-01-CASH-TO-FIFTY-PERCENT-ORG-WITHIN-SIXTY-PERCENT-CAP-2024" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": charitable_contribution_made(entity_ref("urn:test:s170:a1#p"), entity_ref("urn:test:s170:a1#y2024"), 1, CashTo50PercentOrg, 30000 USD) { origin case_input; }
        assert "f1": contribution_base(entity_ref("urn:test:s170:a1#p"), entity_ref("urn:test:s170:a1#y2024"), 100000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s170:a1#p"), entity_ref("urn:test:s170:a1#y2024"), Section170Charitable, 30000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S170-02-SUBSTANTIATION-MISSING-FOR-LARGE-GIFT-DENIED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": charitable_contribution_made(entity_ref("urn:test:s170:f1#p"), entity_ref("urn:test:s170:f1#y2024"), 1, OtherTo50PercentOrgOrNotDescribed, 500 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s170:f1#p"), entity_ref("urn:test:s170:f1#y2024"), Section170Charitable, 500 USD));
    expect truth_status == FALSE_ONLY;
}

test "S170-03-SMALL-GIFT-UNDER-250-NO-SUBSTANTIATION-NEEDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": charitable_contribution_made(entity_ref("urn:test:s170:f2#p"), entity_ref("urn:test:s170:f2#y2024"), 1, OtherTo50PercentOrgOrNotDescribed, 100 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s170:f2#p"), entity_ref("urn:test:s170:f2#y2024"), Section170Charitable, 100 USD));
    expect truth_status == TRUE_ONLY;
}

test "S170-04-NON-ITEMIZER-DEDUCTION-2026-PERMANENT" {
    given {
        context {
            legal_time @2026-04-15;
            decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s170:p1#p"), entity_ref("urn:test:s170:p1#y2026"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": non_itemizer_cash_contribution_to_a_org(entity_ref("urn:test:s170:p1#p"), entity_ref("urn:test:s170:p1#y2026"), 800 USD) { origin case_input; }
    }
    evaluate truth(us.irc.gross_income::section_170p_deduction(entity_ref("urn:test:s170:p1#p"), entity_ref("urn:test:s170:p1#y2026"), 800 USD));
    expect truth_status == TRUE_ONLY;
}
