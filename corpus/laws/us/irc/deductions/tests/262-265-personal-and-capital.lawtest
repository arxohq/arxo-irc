// Sections 262-265 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S262-01-PERSONAL-EXPENSE-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": personal_living_or_family_expense(entity_ref("urn:test:s262:a1#p"), entity_ref("urn:test:s262:a1#y2024"), 1, 1200 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s262:a1#p"), entity_ref("urn:test:s262:a1#y2024"), Section262PersonalNonDeductible, 1200 USD));
    expect truth_status == FALSE_ONLY;
}

test "S263-01-CAPITAL-EXPENDITURE-WITHOUT-EXCEPTION-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": capital_expenditure_item(entity_ref("urn:test:s263:a1#p"), entity_ref("urn:test:s263:a1#y2024"), 1, 50000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s263:a1#p"), entity_ref("urn:test:s263:a1#y2024"), Section262PersonalNonDeductible, 50000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S263-02-CAPITAL-EXPENDITURE-WITH-NAMED-EXCEPTION-NO-RULE-FIRES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": capital_expenditure_item(entity_ref("urn:test:s263:a2#p"), entity_ref("urn:test:s263:a2#y2024"), 1, 50000 USD) { origin case_input; }
        assert "f1": capital_expenditure_within_named_exception(entity_ref("urn:test:s263:a2#p"), entity_ref("urn:test:s263:a2#y2024"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s263:a2#p"), entity_ref("urn:test:s263:a2#y2024"), Section262PersonalNonDeductible, 50000 USD));
    expect truth_status == NEITHER;
    description "the (a)(1)(A)-(L) exception routes the expenditure to its own section (e.g. 174/179/193); this package does not itself allow it under a residual head, so the result is UNDETERMINED, not TRUE";
}

