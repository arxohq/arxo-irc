// Section 165 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S165-01-CASUALTY-PER-EVENT-FLOOR-100" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": personal_casualty_loss_per_event(entity_ref("urn:test:s165:h1#p"), entity_ref("urn:test:s165:h1#y2024"), 1, 5100 USD) { origin case_input; }
    }
    evaluate truth(personal_casualty_loss_net_of_event_floor(entity_ref("urn:test:s165:h1#p"), entity_ref("urn:test:s165:h1#y2024"), 1, 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S165-02-WAGERING-LOSSES-CAPPED-AT-GAINS-PRE-2026" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wagering_losses_for_year(entity_ref("urn:test:s165:d1#p"), entity_ref("urn:test:s165:d1#y2024"), 8000 USD) { origin case_input; }
        assert "f1": wagering_gains_for_year(entity_ref("urn:test:s165:d1#p"), entity_ref("urn:test:s165:d1#y2024"), 5000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s165:d1#p"), entity_ref("urn:test:s165:d1#y2024"), Section165Losses, 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S165-03-WAGERING-LOSSES-NINETY-PERCENT-FROM-2026" {
    given {
        context {
            legal_time @2026-04-15;
            decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wagering_losses_for_year(entity_ref("urn:test:s165:d2#p"), entity_ref("urn:test:s165:d2#y2026"), 10000 USD) { origin case_input; }
        assert "f1": wagering_gains_for_year(entity_ref("urn:test:s165:d2#p"), entity_ref("urn:test:s165:d2#y2026"), 10000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s165:d2#p"), entity_ref("urn:test:s165:d2#y2026"), Section165Losses, 9000 USD));
    expect truth_status == TRUE_ONLY;
}
