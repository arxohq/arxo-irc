            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": deduction_allowed_for_fractional_contribution(entity_ref("urn:test:s170:o5#p"),1,50000.00 USD) { origin case_input; }
        assert "f1": donee_lacked_substantial_physical_possession_or_related_use(entity_ref("urn:test:s170:o5#p"),1) { origin case_input; }
    }
    evaluate truth(fractional_gift_recapture_amount(entity_ref("urn:test:s170:o5#p"),1,50000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "the donee had no substantial possession or related use (section 170(o)(3)(A)(ii))";
}
