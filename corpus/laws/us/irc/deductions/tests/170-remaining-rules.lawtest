}

test "S170-22-STUDENT-MAINTENANCE-LIMITED-TO-50-PER-MONTH" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": student_maintenance_payment(entity_ref("urn:test:s170:g1#p"),entity_ref("urn:test:s170:g1#y"),700.00 USD) { origin case_input; }
        assert "f1": full_calendar_months_of_student_in_household(entity_ref("urn:test:s170:g1#p"),entity_ref("urn:test:s170:g1#y"),12) { origin case_input; }
    }
    evaluate truth(student_maintenance_treated_as_contribution(entity_ref("urn:test:s170:g1#p"),entity_ref("urn:test:s170:g1#y"),600.00 USD));
    expect truth_status == TRUE_ONLY;
    description "12 months x $50 = 600 of 700 paid (section 170(g)(2)(A))";
}

