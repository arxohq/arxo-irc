// Section 170 remaining subsections scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S170-20-PARTNERSHIP-HISTORIC-STRUCTURE-WITHOUT-REPORTING-BARRED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": partnership_contribution_certified_historic_structure_above_2_5_times_basis(1,entity_ref("urn:test:s170:f19a#y")) { origin case_input; }
    }
    evaluate truth(partnership_conservation_contribution_deduction_barred(1,entity_ref("urn:test:s170:f19a#y")));
    expect truth_status == TRUE_ONLY;
    description "no deduction unless the partnership reports the contribution (section 170(f)(19)(A))";
}

