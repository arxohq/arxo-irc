// Section 223 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S223-01-SELF-ONLY-COVERAGE-WITHIN-LIMIT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": months_with_self_only_coverage(entity_ref("urn:test:s223:a1#p"), entity_ref("urn:test:s223:a1#y2024"), 12) { origin case_input; }
        assert "f1": hsa_contribution_for_year(entity_ref("urn:test:s223:a1#p"), entity_ref("urn:test:s223:a1#y2024"), 2000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s223:a1#p"), entity_ref("urn:test:s223:a1#y2024"), Section223Hsa, 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S223-02-SELF-ONLY-COVERAGE-EXCEEDS-LIMIT-CAPPED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": months_with_self_only_coverage(entity_ref("urn:test:s223:a2#p"), entity_ref("urn:test:s223:a2#y2024"), 12) { origin case_input; }
        assert "f1": hsa_contribution_for_year(entity_ref("urn:test:s223:a2#p"), entity_ref("urn:test:s223:a2#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s223:a2#p"), entity_ref("urn:test:s223:a2#y2024"), Section223Hsa, 2250 USD));
    expect truth_status == TRUE_ONLY;
}

test "S223-03-FAMILY-COVERAGE-SIX-MONTHS-PRORATED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": months_with_family_coverage(entity_ref("urn:test:s223:a3#p"), entity_ref("urn:test:s223:a3#y2024"), 6) { origin case_input; }
        assert "f1": hsa_contribution_for_year(entity_ref("urn:test:s223:a3#p"), entity_ref("urn:test:s223:a3#y2024"), 2000 USD) { origin case_input; }
    }
    // 6 months * $375/month = $2,250 limit; contribution 2,000 is within it.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s223:a3#p"), entity_ref("urn:test:s223:a3#y2024"), Section223Hsa, 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S223-04-MEDICARE-ENTITLED-ZERO-LIMITATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": medicare_entitled_as_of_month(entity_ref("urn:test:s223:m1#p"), entity_ref("urn:test:s223:m1#y2024"), 6) { origin case_input; }
        assert "f1": hsa_contribution_for_year(entity_ref("urn:test:s223:m1#p"), entity_ref("urn:test:s223:m1#y2024"), 500 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s223:m1#p"), entity_ref("urn:test:s223:m1#y2024"), Section223Hsa, 500 USD));
    expect truth_status == FALSE_ONLY;
}

test "S223-05-TELEHEALTH-SAFE-HARBOR-FROM-2025" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": telehealth_only_coverage(entity_ref("urn:test:s223:t1#p"), entity_ref("urn:test:s223:t1#y2025"), 1) { origin case_input; }
        assert "f1": has_self_only_hdhp_coverage(entity_ref("urn:test:s223:t1#p"), entity_ref("urn:test:s223:t1#y2025"), 1) { origin case_input; }
    }
    evaluate truth(eligible_individual_hsa(entity_ref("urn:test:s223:t1#p"), entity_ref("urn:test:s223:t1#y2025"), 1));
    expect truth_status == TRUE_ONLY;
}
