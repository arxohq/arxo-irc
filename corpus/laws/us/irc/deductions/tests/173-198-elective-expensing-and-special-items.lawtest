// Sections 173-198 small deduction sections scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S173-01-CIRCULATION-EXPENDITURE-DEDUCTIBLE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": circulation_expenditure(entity_ref("urn:test:s173:a1#p"),entity_ref("urn:test:s173:a1#y"),1,5000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s173:a1#p"),entity_ref("urn:test:s173:a1#y"),Section173Circulation,5000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "expenditures to increase circulation of a periodical are deductible (section 173(a))";
}

test "S173-02-LAND-PURCHASE-EXCLUDED" {
    given {
        context {
            legal_time @2025-12-31;
