test "S181-03-COST-ABOVE-15-MILLION-CAPPED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": production_is_property_described_in_168f3(entity_ref("urn:test:s181:a1#p"),1) { origin case_input; }
        assert "f1": production_total_compensation(entity_ref("urn:test:s181:a1#p"),1,1000000.00 USD) { origin case_input; }
        assert "f2": production_qualified_compensation(entity_ref("urn:test:s181:a1#p"),1,800000.00 USD) { origin case_input; }
        assert "f3": elects_section_181_expensing(entity_ref("urn:test:s181:a1#p"),1) { origin case_input; }
        assert "f4": production_aggregate_cost(entity_ref("urn:test:s181:a1#p"),entity_ref("urn:test:s181:a1#y"),1,FilmOrTelevision,18000000.00 USD) { origin case_input; }
        assert "f5": production_commences_in_year_ending_after(entity_ref("urn:test:s181:a1#p"),1,@2025-06-01,@2025-12-31) { origin case_input; }
    }
    evaluate truth(section_181_deduction(entity_ref("urn:test:s181:a1#p"),entity_ref("urn:test:s181:a1#y"),1,15000000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "the deduction stops at $15,000,000 (section 181(a)(2)(A))";
}

