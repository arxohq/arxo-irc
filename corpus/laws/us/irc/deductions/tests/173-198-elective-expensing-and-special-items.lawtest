}

test "S175-01-DEDUCTION-LIMITED-TO-25-PERCENT-OF-FARM-INCOME" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_soil_water_conservation_method(entity_ref("urn:test:s175:b1#p")) { origin case_input; }
        assert "f1": gross_income_derived_from_farming(entity_ref("urn:test:s175:b1#p"),entity_ref("urn:test:s175:b1#y"),100000.00 USD) { origin case_input; }
        assert "f2": soil_water_expenditures_with_carryover(entity_ref("urn:test:s175:b1#p"),entity_ref("urn:test:s175:b1#y"),40000.00 USD) { origin case_input; }
    }
    evaluate truth(soil_water_deduction_175(entity_ref("urn:test:s175:b1#p"),entity_ref("urn:test:s175:b1#y"),25000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "25 percent of gross income from farming 100,000 is 25,000 (section 175(b))";
}

