    description "a production presented for at most 10 weeks may use a venue of up to 6,500 (section 181(e)(2)(D)(i))";
}

test "S186-01-DEDUCTION-LIMITED-TO-UNRECOVERED-LOSSES" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": damages_received_or_accrued_for_compensable_injury(entity_ref("urn:test:s186:a1#p"),entity_ref("urn:test:s186:a1#y"),1,500000.00 USD) { origin case_input; }
        assert "f1": costs_of_securing_award_or_settlement(entity_ref("urn:test:s186:a1#p"),entity_ref("urn:test:s186:a1#y"),1,100000.00 USD) { origin case_input; }
        assert "f2": net_operating_losses_attributable_to_injury(entity_ref("urn:test:s186:a1#p"),1,300000.00 USD) { origin case_input; }
        assert "f3": attributable_losses_already_allowed_under_172(entity_ref("urn:test:s186:a1#p"),1,50000.00 USD) { origin case_input; }
        assert "f4": prior_186_deductions_for_injury(entity_ref("urn:test:s186:a1#p"),1,0.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s186:a1#p"),entity_ref("urn:test:s186:a1#y"),Section186Recoveries,250000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "compensatory amount 400,000; unrecovered losses 300,000 - 50,000 = 250,000; the lesser is deducted (section 186(a),(d))";
}

