test "S162-43-FDIC-PREMIUM-PROPORTIONAL-BETWEEN-10-AND-50-BILLION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fdic_premium_paid_or_incurred(entity_ref("urn:test:s162:r1#c"),entity_ref("urn:test:s162:r1#y"),1000000.00 USD) { origin case_input; }
        assert "f1": total_consolidated_assets(entity_ref("urn:test:s162:r1#c"),entity_ref("urn:test:s162:r1#y"),30000000000.00 USD) { origin case_input; }
    }
    evaluate truth(fdic_premium_disallowed(entity_ref("urn:test:s162:r1#c"),entity_ref("urn:test:s162:r1#y"),500000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(30 - 10) / 40 = 50 percent of the premium: 500,000 (section 162(r)(3))";
}

test "S162-44-FDIC-PREMIUM-FULLY-DISALLOWED-AT-50-BILLION" {
    given {
        context {
            legal_time @2025-06-30;
