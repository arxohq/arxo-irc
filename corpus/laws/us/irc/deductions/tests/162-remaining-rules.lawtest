        assert "f0": fdic_premium_paid_or_incurred(entity_ref("urn:test:s162:r2#c"),entity_ref("urn:test:s162:r2#y"),1000000.00 USD) { origin case_input; }
        assert "f1": total_consolidated_assets(entity_ref("urn:test:s162:r2#c"),entity_ref("urn:test:s162:r2#y"),60000000000.00 USD) { origin case_input; }
    }
    evaluate truth(fdic_premium_disallowed(entity_ref("urn:test:s162:r2#c"),entity_ref("urn:test:s162:r2#y"),1000000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "at $50 billion or more the applicable percentage is 100";
}

test "S162-45-FDIC-PREMIUM-DEDUCTIBLE-BELOW-10-BILLION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fdic_premium_paid_or_incurred(entity_ref("urn:test:s162:r3#c"),entity_ref("urn:test:s162:r3#y"),1000000.00 USD) { origin case_input; }
        assert "f1": total_consolidated_assets(entity_ref("urn:test:s162:r3#c"),entity_ref("urn:test:s162:r3#y"),8000000000.00 USD) { origin case_input; }
    }
    evaluate truth(fdic_premium_disallowed(entity_ref("urn:test:s162:r3#c"),entity_ref("urn:test:s162:r3#y"),1.00 USD));
    expect truth_status == NEITHER;
    description "a taxpayer with assets of $10 billion or less is not affected (section 162(r)(2))";
}
