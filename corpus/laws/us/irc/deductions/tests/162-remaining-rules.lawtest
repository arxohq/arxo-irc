test "S162-36-FOREIGN-BROADCAST-ADVERTISING-DENIED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": advertisement_carried_by_foreign_broadcast_undertaking_directed_at_us_market(entity_ref("urn:test:s162:j1#p"),entity_ref("urn:test:s162:j1#y"),1,9000.00 USD) { origin case_input; }
        assert "f1": undertaking_country_denies_similar_deduction_for_us_placed_ads(entity_ref("urn:test:s162:j1#p"),1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:j1#p"),entity_ref("urn:test:s162:j1#y"),Section162TradeOrBusiness,9000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "advertising on a retaliating country's broadcast undertaking is not deductible (section 162(j))";
}

