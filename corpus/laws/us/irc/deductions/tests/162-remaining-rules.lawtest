// Section 162 remaining subsections scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S162-30-CONTRIBUTION-GOVERNED-BY-170-NO-SECTION-162-DEDUCTION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": contribution_or_gift_allowable_under_170_but_for_limits(entity_ref("urn:test:s162:b1#p"),entity_ref("urn:test:s162:b1#y"),1,5000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:b1#p"),entity_ref("urn:test:s162:b1#y"),Section162TradeOrBusiness,5000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "no section 162 deduction for a contribution that section 170 governs (section 162(b))";
}

test "S162-31-LEGISLATOR-STATE-RATE-WITHIN-110-PERCENT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": state_legislator_elects_162h(entity_ref("urn:test:s162:h1#p"),entity_ref("urn:test:s162:h1#y")) { origin case_input; }
        assert "f1": legislative_days_in_year(entity_ref("urn:test:s162:h1#p"),entity_ref("urn:test:s162:h1#y"),30) { origin case_input; }
        assert "f2": state_employee_per_diem_rate(entity_ref("urn:test:s162:h1#p"),entity_ref("urn:test:s162:h1#y"),200.00 USD) { origin case_input; }
        assert "f3": federal_executive_per_diem_rate(entity_ref("urn:test:s162:h1#p"),entity_ref("urn:test:s162:h1#y"),190.00 USD) { origin case_input; }
    }
    evaluate truth(deemed_legislator_living_expenses(entity_ref("urn:test:s162:h1#p"),entity_ref("urn:test:s162:h1#y"),6000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "30 days x max(min(200, 209), 190) = 6,000 (section 162(h)(1)(B))";
}

test "S162-32-LEGISLATOR-STATE-RATE-CAPPED-AT-110-PERCENT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": state_legislator_elects_162h(entity_ref("urn:test:s162:h2#p"),entity_ref("urn:test:s162:h2#y")) { origin case_input; }
        assert "f1": legislative_days_in_year(entity_ref("urn:test:s162:h2#p"),entity_ref("urn:test:s162:h2#y"),30) { origin case_input; }
        assert "f2": state_employee_per_diem_rate(entity_ref("urn:test:s162:h2#p"),entity_ref("urn:test:s162:h2#y"),250.00 USD) { origin case_input; }
        assert "f3": federal_executive_per_diem_rate(entity_ref("urn:test:s162:h2#p"),entity_ref("urn:test:s162:h2#y"),190.00 USD) { origin case_input; }
    }
    evaluate truth(deemed_legislator_living_expenses(entity_ref("urn:test:s162:h2#p"),entity_ref("urn:test:s162:h2#y"),6270.00 USD));
    expect truth_status == TRUE_ONLY;
    description "the State rate 250 is capped at 110 percent of 190 = 209: 30 x 209 = 6,270";
}

