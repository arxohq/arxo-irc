    expect truth_status == TRUE_ONLY;
    description "the Federal rate 190 is greater than the State rate 150: 30 x 190 = 5,700";
}

test "S162-34-LEGISLATOR-NEAR-CAPITOL-ELECTION-INVALID" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": state_legislator_elects_162h(entity_ref("urn:test:s162:h4#p"),entity_ref("urn:test:s162:h4#y")) { origin case_input; }
        assert "f1": legislative_days_in_year(entity_ref("urn:test:s162:h4#p"),entity_ref("urn:test:s162:h4#y"),30) { origin case_input; }
        assert "f2": state_employee_per_diem_rate(entity_ref("urn:test:s162:h4#p"),entity_ref("urn:test:s162:h4#y"),200.00 USD) { origin case_input; }
        assert "f3": federal_executive_per_diem_rate(entity_ref("urn:test:s162:h4#p"),entity_ref("urn:test:s162:h4#y"),190.00 USD) { origin case_input; }
        assert "f4": legislator_residence_within_fifty_miles_of_capitol(entity_ref("urn:test:s162:h4#p"),entity_ref("urn:test:s162:h4#y")) { origin case_input; }
    }
    evaluate truth(deemed_legislator_living_expenses(entity_ref("urn:test:s162:h4#p"),entity_ref("urn:test:s162:h4#y"),6000.00 USD));
    expect truth_status == NEITHER;
    description "a legislator residing within 50 miles of the capitol cannot validly elect (section 162(h)(4)); the exercise has no effect (E-0239)";
}

