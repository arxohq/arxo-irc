// Section 172 detail scenarios (stage 2b). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S172-20-NOL-EXCESS-OF-DEDUCTIONS-OVER-GROSS-INCOME" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gross_income_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),100000.00 USD) { origin case_input; }
        assert "f1": deductions_allowed_by_chapter_1_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),250000.00 USD) { origin case_input; }
        assert "f2": nol_deduction_included_in_deductions(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f3": capital_loss_excess_over_gains_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f4": section_1202_exclusion_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f5": section_151_or_substitute_deduction_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f6": nonbusiness_deductions_disallowed_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f7": drd_as_computed_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f8": drd_computed_without_246b_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f9": section_199a_deduction_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f10": section_250_deduction_for_nol(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
        assert "f11": reit_adjustment_857b2_to_loss(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),0.00 USD) { origin case_input; }
    }
    evaluate truth(net_operating_loss_computed_from_modifications(entity_ref("urn:test:s172-20#p"),entity_ref("urn:test:s172-20#y"),150000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(c): the excess of deductions over gross income";
}

