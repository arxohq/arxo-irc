test "S264-35-PRO-RATA-INTEREST-ALLOCATED-TO-CASH-VALUES" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxpayer_interest_expense_264f(entity_ref("urn:test:s264:f1#p"),entity_ref("urn:test:s264:f1#y"),100000.00 USD) { origin case_input; }
        assert "f1": average_unborrowed_policy_cash_values_of_pro_rata_contracts(entity_ref("urn:test:s264:f1#p"),entity_ref("urn:test:s264:f1#y"),2000000.00 USD) { origin case_input; }
        assert "f2": average_unborrowed_cash_values_and_adjusted_bases_of_all_assets(entity_ref("urn:test:s264:f1#p"),entity_ref("urn:test:s264:f1#y"),8000000.00 USD) { origin case_input; }
    }
    evaluate truth(interest_allocable_to_unborrowed_policy_cash_values(entity_ref("urn:test:s264:f1#p"),entity_ref("urn:test:s264:f1#y"),25000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "100,000 x 2,000,000 / 8,000,000 = 25,000 (section 264(f)(2))";
}

