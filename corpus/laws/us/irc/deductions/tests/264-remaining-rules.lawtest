        assert "f1": single_premium_contract(1) { origin case_input; }
        assert "f2": contract_is_annuity(1) { origin case_input; }
        assert "f3": annuity_contract_purchased_on(1,@1950-01-01) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s264:a3#p"),entity_ref("urn:test:s264:a3#y"),Section264LifeInsuranceInterest,3000.00 USD));
    expect truth_status == NEITHER;
    description "paragraph (2) applies to annuity contracts purchased after March 1, 1954 only";
}

