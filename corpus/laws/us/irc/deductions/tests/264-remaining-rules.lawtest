test "S264-31-KEY-PERSON-INTEREST-ABOVE-50000-DENIED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": interest_on_indebtedness_with_respect_to_owned_policies(entity_ref("urn:test:s264:e1#p"),entity_ref("urn:test:s264:e1#y"),1,20000.00 USD,200000.00 USD) { origin case_input; }
        assert "f1": insured_is_officer_or_twenty_percent_owner(entity_ref("urn:test:s264:e1#p"),1) { origin case_input; }
        assert "f2": number_of_key_persons_and_officers_employees(entity_ref("urn:test:s264:e1#p"),3,100) { origin case_input; }
    }
    evaluate truth(key_person_interest_denied_above_fifty_thousand(entity_ref("urn:test:s264:e1#p"),entity_ref("urn:test:s264:e1#y"),1,15000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "interest 20,000 x (200,000 - 50,000)/200,000 = 15,000 is denied (section 264(e)(1))";
}

