// Section 264 remaining paragraphs scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S264-20-SINGLE-PREMIUM-CONTRACT-INTEREST-DENIED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": interest_on_debt_to_purchase_or_carry_contract(entity_ref("urn:test:s264:a2#p"),entity_ref("urn:test:s264:a2#y"),1,1,3000.00 USD) { origin case_input; }
        assert "f1": single_premium_contract(1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s264:a2#p"),entity_ref("urn:test:s264:a2#y"),Section264LifeInsuranceInterest,3000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "interest on debt to carry a single premium contract is not deductible (section 264(a)(2))";
}

