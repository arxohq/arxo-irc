// Section 217 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S217-01-MOVING-EXPENSE-ALLOWED-BEFORE-SUSPENSION" {
    given {
        context {
            legal_time @2017-04-15;
            decision_time @2017-04-15T09:00:00-05:00;
            knowledge_time @2017-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": moving_expense_paid(entity_ref("urn:test:s217:a1#p"), entity_ref("urn:test:s217:a1#y2017"), 1, 3000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s217:a1#p"), entity_ref("urn:test:s217:a1#y2017"), Section217Moving, 3000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S217-02-MOVING-EXPENSE-SUSPENDED-2018-2025-CIVILIAN" {
    given {
        context {
            legal_time @2022-04-15;
            decision_time @2022-04-15T09:00:00-05:00;
            knowledge_time @2022-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": moving_expense_paid(entity_ref("urn:test:s217:a2#p"), entity_ref("urn:test:s217:a2#y2022"), 1, 3000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s217:a2#p"), entity_ref("urn:test:s217:a2#y2022"), Section217Moving, 3000 USD));
    expect truth_status == NEITHER;
    description "section 217(k) suspends the deduction for 2018-2025 civilian moves; SuspensionAppliesDuring2018To2025ExceptArmedForces establishes the block, leaving the general allowance rule's guard unmet";
}

test "S217-03-ARMED-FORCES-MOVE-UNDER-ORDERS-NOT-SUSPENDED" {
    given {
        context {
            legal_time @2022-04-15;
            decision_time @2022-04-15T09:00:00-05:00;
            knowledge_time @2022-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": moving_expense_paid(entity_ref("urn:test:s217:a3#p"), entity_ref("urn:test:s217:a3#y2022"), 1, 3000 USD) { origin case_input; }
        assert "f1": armed_forces_member_move_under_orders(entity_ref("urn:test:s217:a3#p"), entity_ref("urn:test:s217:a3#y2022"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s217:a3#p"), entity_ref("urn:test:s217:a3#y2022"), Section217Moving, 3000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S217-04-MOVING-EXPENSE-ALLOWED-AFTER-SUSPENSION-2026" {
    given {
        context {
            legal_time @2026-04-15;
            decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": moving_expense_paid(entity_ref("urn:test:s217:a4#p"), entity_ref("urn:test:s217:a4#y2026"), 1, 3000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s217:a4#p"), entity_ref("urn:test:s217:a4#y2026"), Section217Moving, 3000 USD));
    expect truth_status == TRUE_ONLY;
}
