test "W10-D-DED-01-CHURCH-IS-A-170B1A-ORGANIZATION-AND-A-PUBLIC-CHARITY" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": church_or_convention_or_association_of_churches_170b1Ai(entity_ref("urn:test:w10dded:c1#o"), entity_ref("urn:test:w10dded:c1#y")) { origin case_input; }
    }
    evaluate truth(us.irc.exempt_organizations::is_public_charity(entity_ref("urn:test:w10dded:c1#o"), entity_ref("urn:test:w10dded:c1#y")));
    expect truth_status == TRUE_ONLY;
}

