// Deductions WIRE-10 group B scenarios (section 168(i)(3) lease term). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "W10B-DED-01-LEASE-TERM-INCLUDES-RENEWAL-OPTIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": lease_term_components_168i3(7, 5, 3, 1, 2) { origin case_input; }
    }
    evaluate truth(lease_term_years_168i3(7, 11));
    expect truth_status == TRUE_ONLY;
}

test "W10B-DED-02-FAIR-MARKET-VALUE-OPTION-ON-REAL-PROPERTY-IS-NOT-COUNTED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": lease_term_components_168i3(8, 5, 3, 1, 2) { origin case_input; }
        assert "f1": renewal_option_at_fair_market_value_on_real_property_168i3B(8) { origin case_input; }
    }
    evaluate truth(lease_term_years_168i3(8, 8));
    expect truth_status == TRUE_ONLY;
}

test "W10B-DED-03-FAIR-MARKET-VALUE-OPTION-LEAVES-ONLY-THE-STATED-TERM" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": lease_term_components_168i3(9, 5, 3, 0, 0) { origin case_input; }
        assert "f1": renewal_option_at_fair_market_value_on_real_property_168i3B(9) { origin case_input; }
    }
    evaluate truth(lease_term_years_168i3(9, 5));
    expect truth_status == TRUE_ONLY;
}

test "W10B-DED-04-267B-CLASS-ControlledGroupCorporations-DERIVES-THE-SECTION-1239-STUB" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": related_persons(entity_ref("urn:test:w10b:r4#a"), entity_ref("urn:test:w10b:r4#b"), ControlledGroupCorporations) { origin case_input; }
    }
    evaluate truth(us.irc.property_transactions::related_under_267b_class_1239c1c(entity_ref("urn:test:w10b:r4#a"), entity_ref("urn:test:w10b:r4#b")));
    expect truth_status == TRUE_ONLY;
}

