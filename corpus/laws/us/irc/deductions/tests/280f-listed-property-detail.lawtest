test "S280F-20-PASSENGER-AUTOMOBILE-UNDER-6000-UNLOADED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": four_wheeled_vehicle_for_public_roads(1) { origin case_input; }
        assert "f1": vehicle_rated_unloaded_gross_weight_pounds(1,5500) { origin case_input; }
    }
    evaluate truth(passenger_automobile(1));
    expect truth_status == TRUE_ONLY;
    description "(d)(5)(A): a 4-wheeled road vehicle rated 6,000 pounds or less";
}

