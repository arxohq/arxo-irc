test "S217-20-HOUSEHOLD-GOODS-MOVE-QUALIFIES" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": moving_expense_of_kind(entity_ref("urn:test:s217-20#p"),entity_ref("urn:test:s217-20#y"),1,HouseholdGoodsAndEffects,3000.00 USD) { origin case_input; }
        assert "f1": moving_expense_is_reasonable(1) { origin adjudicated; }
    }
    evaluate truth(qualified_moving_expense_217b(entity_ref("urn:test:s217-20#p"),entity_ref("urn:test:s217-20#y"),1,3000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(b)(1)(A): reasonable cost of moving household goods";
}

