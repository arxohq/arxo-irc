// Scenarios for the payment-keyed views of sections 243, 246 and 246A (WIRE-6, module 243-249-payment-keyed-hypothetical-recipient-views.law).
// The recipient corporation is the regulated investment company itself (hypothetical recipient of section 854(b)(3)).
// Written from the text; NOT executed (owner's NO-HEAVY-CHECKS restriction) -- `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "PAY243-01-DIVIDEND-WITHOUT-DOMESTIC-SOURCE-IS-NOT-ELIGIBLE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert dividend_item_index_of_payment(entity_ref("urn:us:irc:deductions:clir#D1"), 1) { id "f0"; origin case_input; }
        assert dividend_received_by_corporation(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), 1, 10000.00 USD) { id "f1"; origin case_input; }
    }
    // No section 243(a) source fact: the dividend would not be deductible even if section 243 applied.
    evaluate truth(payment_dividend_not_eligible_for_243(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), entity_ref("urn:us:irc:deductions:clir#D1")));
    expect truth_status == TRUE_ONLY;
}

test "PAY243-02-DOMESTIC-SOURCE-DIVIDEND-IS-ELIGIBLE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert dividend_item_index_of_payment(entity_ref("urn:us:irc:deductions:clir#D1"), 1) { id "f0"; origin case_input; }
        assert dividend_received_by_corporation(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), 1, 10000.00 USD) { id "f1"; origin case_input; }
        assert dividend_from_domestic_corporation_subject_to_tax(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), 1) { id "f2"; origin case_input; }
    }
    evaluate truth(payment_dividend_not_eligible_for_243(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), entity_ref("urn:us:irc:deductions:clir#D1")));
    expect truth_status == NEITHER;
}

test "PAY243-03-NO-IDENTITY-LINK-NO-VIEW" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert dividend_received_by_corporation(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), 1, 10000.00 USD) { id "f0"; origin case_input; }
    }
    // Without the index of the Payment nothing links the dividend to the item relations.
    evaluate truth(payment_dividend_not_eligible_for_243(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), entity_ref("urn:us:irc:deductions:clir#D1")));
    expect truth_status == NEITHER;
}

test "PAY246-01-EXEMPT-PAYOR-DENIES-THE-DEDUCTION" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert dividend_item_index_of_payment(entity_ref("urn:us:irc:deductions:clir#D1"), 1) { id "f0"; origin case_input; }
        assert dividend_received_by_corporation(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), 1, 10000.00 USD) { id "f1"; origin case_input; }
        assert dividend_from_domestic_corporation_subject_to_tax(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), 1) { id "f2"; origin case_input; }
        assert payor_exempt_under_501_or_521_in_current_or_preceding_year(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), 1) { id "f3"; origin case_input; }
    }
    // Section 246(a)(1).
    evaluate truth(payment_dividend_denied_by_246_without_246b(entity_ref("urn:us:irc:deductions:clir#RIC1"), entity_ref("urn:us:irc:deductions:clir#Y2025"), entity_ref("urn:us:irc:deductions:clir#D1")));
    expect truth_status == TRUE_ONLY;
}

