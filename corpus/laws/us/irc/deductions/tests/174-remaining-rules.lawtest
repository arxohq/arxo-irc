// Sections 174/174A remaining rules scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S174-10-SOFTWARE-DEVELOPMENT-IS-RESEARCH-FIRST-YEAR-HALF-OF-ONE-FIFTH" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:c1#y"),@2024-01-01) { origin case_input; }
        assert "f1": software_development_expenditure(entity_ref("urn:test:s174:c1#p"),entity_ref("urn:test:s174:c1#y"),1,100000.00 USD) { origin case_input; }
    }
    evaluate truth(section_174_first_year_amortization(entity_ref("urn:test:s174:c1#p"),entity_ref("urn:test:s174:c1#y"),1,10000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "software development is research; 5-year amortization from the midpoint gives 1/10 in the first year (section 174(a),(c)(3))";
}

test "S174-11-LAND-EXPENDITURE-EXCLUDED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:c2#y"),@2024-01-01) { origin case_input; }
        assert "f1": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:c2#p"),entity_ref("urn:test:s174:c2#y"),1,50000.00 USD) { origin case_input; }
        assert "f2": expenditure_for_land_or_depreciable_or_depletable_property(entity_ref("urn:test:s174:c2#p"),entity_ref("urn:test:s174:c2#y"),1) { origin case_input; }
    }
    evaluate truth(section_174_first_year_amortization(entity_ref("urn:test:s174:c2#p"),entity_ref("urn:test:s174:c2#y"),1,5000.00 USD));
    expect truth_status == NEITHER;
    description "the acquisition or improvement of land is outside section 174 (section 174(c)(1))";
}

