test "S174-13-FOREIGN-RESEARCH-FIRST-YEAR-ONE-THIRTIETH" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:a1#y"),@2024-01-01) { origin case_input; }
        assert "f1": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:a1#p"),entity_ref("urn:test:s174:a1#y"),1,300000.00 USD) { origin case_input; }
        assert "f2": research_expenditure_attributable_to_foreign_research(entity_ref("urn:test:s174:a1#p"),entity_ref("urn:test:s174:a1#y"),1) { origin case_input; }
    }
    evaluate truth(section_174_first_year_amortization(entity_ref("urn:test:s174:a1#p"),entity_ref("urn:test:s174:a1#y"),1,10000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "15-year amortization from the midpoint: 300,000 / 30 = 10,000 in the first year (section 174(a)(2)(B))";
}

