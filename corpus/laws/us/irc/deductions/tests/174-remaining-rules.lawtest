test "S174-17-ELECTED-AMORTIZATION-OVER-120-MONTHS" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:c4#y"),@2025-01-01) { origin case_input; }
        assert "f1": elects_174a_amortization(entity_ref("urn:test:s174:c4#p"),entity_ref("urn:test:s174:c4#y"),1) { origin case_input; }
        assert "f2": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:c4#p"),entity_ref("urn:test:s174:c4#y"),1,240000.00 USD) { origin case_input; }
        assert "f3": selected_amortization_period_months_174a(entity_ref("urn:test:s174:c4#p"),1,120) { origin case_input; }
        assert "f4": months_of_selected_period_in_taxable_year(entity_ref("urn:test:s174:c4#p"),entity_ref("urn:test:s174:c4#y"),1,12) { origin case_input; }
    }
    evaluate truth(section_174a_elected_amortization_deduction(entity_ref("urn:test:s174:c4#p"),entity_ref("urn:test:s174:c4#y"),1,24000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "240,000 x 12/120 = 24,000 (section 174A(c)(1))";
}

test "S174-18-SELECTED-PERIOD-UNDER-60-MONTHS-NOT-AN-ELECTION" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_year_begins_on(entity_ref("urn:test:s174:c5#y"),@2025-01-01) { origin case_input; }
        assert "f1": elects_174a_amortization(entity_ref("urn:test:s174:c5#p"),entity_ref("urn:test:s174:c5#y"),1) { origin case_input; }
        assert "f2": research_or_experimental_expenditure_paid_or_incurred(entity_ref("urn:test:s174:c5#p"),entity_ref("urn:test:s174:c5#y"),1,240000.00 USD) { origin case_input; }
        assert "f3": selected_amortization_period_months_174a(entity_ref("urn:test:s174:c5#p"),1,48) { origin case_input; }
        assert "f4": months_of_selected_period_in_taxable_year(entity_ref("urn:test:s174:c5#p"),entity_ref("urn:test:s174:c5#y"),1,12) { origin case_input; }
    }
    evaluate truth(section_174a_elected_amortization_deduction(entity_ref("urn:test:s174:c5#p"),entity_ref("urn:test:s174:c5#y"),1,60000.00 USD));
    expect truth_status == NEITHER;
    description "the selected period must be at least 60 months (section 174A(c)(1)(B))";
}

test "S174-19-LUMP-SUM-UNAMORTIZED-ELECTION" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": unamortized_capitalized_domestic_research_amount(entity_ref("urn:test:s174:f1#p"),1,90000.00 USD) { origin case_input; }
        assert "f1": elects_lump_sum_unamortized_deduction(entity_ref("urn:test:s174:f1#p"),1) { origin case_input; }
        assert "f2": is_first_taxable_year_beginning_after_2024(entity_ref("urn:test:s174:f1#p"),entity_ref("urn:test:s174:f1#y")) { origin case_input; }
    }
    evaluate truth(transition_unamortized_research_deduction(entity_ref("urn:test:s174:f1#p"),entity_ref("urn:test:s174:f1#y"),1,90000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "the whole remaining unamortized amount is deducted in the first year after 2024 (Pub. L. 119-21 section 70302(f)(2)(A)(i))";
}

