// Section 166 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S166-01-BUSINESS-DEBT-WHOLLY-WORTHLESS-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": debt_wholly_worthless_within_year(entity_ref("urn:test:s166:a1#p"), entity_ref("urn:test:s166:a1#y2024"), 1, 15000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s166:a1#p"), entity_ref("urn:test:s166:a1#y2024"), Section166BadDebts, 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S166-02-NONBUSINESS-DEBT-NOT-ORDINARY-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": debt_wholly_worthless_within_year(entity_ref("urn:test:s166:d1#p"), entity_ref("urn:test:s166:d1#y2024"), 1, 3000 USD) { origin case_input; }
        assert "f1": nonbusiness_debt(entity_ref("urn:test:s166:d1#p"), entity_ref("urn:test:s166:d1#y2024"), 1) { origin case_input; }
    }
    // BadDebtWhollyWorthlessAllowed does not fire (nonbusiness_debt is known);
    // the debt is instead treated as a short-term capital loss.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s166:d1#p"), entity_ref("urn:test:s166:d1#y2024"), Section166BadDebts, 3000 USD));
    expect truth_status == TRUE_ONLY;
    description "allowed via the section 166(d)(1)(B) capital-loss characterization, not the section 166(a) business bad-debt route";
}

test "S166-03-UNKNOWN-WORTHLESSNESS-STATUS-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s166:u1#p"), entity_ref("urn:test:s166:u1#y2024"), Section166BadDebts, 1000 USD));
    expect truth_status == NEITHER;
}
