// Section 199A detail scenarios (stage 2c): (c), (f), (g), (h). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S199AX-1-QUALIFIED-ITEM" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": business_item(entity_ref("urn:test:s199ax-1#p"),entity_ref("urn:test:s199ax-1#y"),1,1,5000.00 USD) { origin case_input; }
        assert "f1": item_effectively_connected_in_united_states(entity_ref("urn:test:s199ax-1#p"),entity_ref("urn:test:s199ax-1#y"),1,1) { origin case_input; }
        assert "f2": item_included_or_allowed_in_taxable_income(entity_ref("urn:test:s199ax-1#p"),entity_ref("urn:test:s199ax-1#y"),1,1) { origin case_input; }
    }
    evaluate truth(qualified_item_199a(entity_ref("urn:test:s199ax-1#p"),entity_ref("urn:test:s199ax-1#y"),1,1,5000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(c)(3)(A): effectively connected, included in taxable income";
}

