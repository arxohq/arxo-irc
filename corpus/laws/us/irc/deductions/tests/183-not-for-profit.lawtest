// Section 183 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S183-01-NOT-FOR-PROFIT-CATEGORY-TWO-LIMITED-TO-EXCESS-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": activity_not_engaged_in_for_profit(entity_ref("urn:test:s183:b1#p"), entity_ref("urn:test:s183:b1#y2024"), 1) { origin case_input; }
        assert "f1": deduction_allowable_without_regard_to_profit_motive(entity_ref("urn:test:s183:b1#p"), entity_ref("urn:test:s183:b1#y2024"), 1, 1000 USD) { origin case_input; }
        assert "f2": deduction_allowable_only_if_for_profit(entity_ref("urn:test:s183:b1#p"), entity_ref("urn:test:s183:b1#y2024"), 1, 4000 USD) { origin case_input; }
        assert "f3": gross_income_from_activity(entity_ref("urn:test:s183:b1#p"), entity_ref("urn:test:s183:b1#y2024"), 1, 3500 USD) { origin case_input; }
    }
    // gross income 3,500 - category-1 1,000 = 2,500 excess < 4,000 category-2:
    // category-2 not fully allowed (the "category2 <= excess" guard fails).
    evaluate truth(deduction_allowed(entity_ref("urn:test:s183:b1#p"), entity_ref("urn:test:s183:b1#y2024"), Section183NotForProfitDisallowed, 4000 USD));
    expect truth_status == NEITHER;
    description "gross income minus category-1 deductions (2,500) is less than the category-2 amount claimed (4,000); the rule's excess-income guard does not hold";
}

test "S183-02-PRESUMPTION-THREE-OF-FIVE-YEARS-PROFIT-PRESUMED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": years_in_five_year_window_with_income_exceeding_deductions(entity_ref("urn:test:s183:d1#p"), 1, entity_ref("urn:test:s183:d1#y2024"), 3) { origin case_input; }
    }
    evaluate truth(activity_presumed_engaged_in_for_profit(entity_ref("urn:test:s183:d1#p"), 1, entity_ref("urn:test:s183:d1#y2024")));
    expect truth_status == TRUE_ONLY;
    description "section 183(d): gross income exceeded deductions in 3 of the 5 consecutive years ending with this year — the activity is PRESUMED engaged in for profit";
}

test "S183-03-PRESUMPTION-REBUTTED-BY-SECRETARY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": years_in_five_year_window_with_income_exceeding_deductions(entity_ref("urn:test:s183:d2#p"), 1, entity_ref("urn:test:s183:d2#y2024"), 4) { origin case_input; }
        assert "f1": secretary_establishes_not_for_profit(entity_ref("urn:test:s183:d2#p"), 1, entity_ref("urn:test:s183:d2#y2024")) { origin adjudicated; }
    }
    evaluate truth(activity_presumed_engaged_in_for_profit(entity_ref("urn:test:s183:d2#p"), 1, entity_ref("urn:test:s183:d2#y2024")));
    expect truth_status == FALSE_ONLY;
    description "section 183(d)'s unless-clause: the Secretary establishes to the contrary, defeating the 4-of-5-years presumption";
}

test "S183-04-ONLY-TWO-OF-FIVE-YEARS-NO-PRESUMPTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": years_in_five_year_window_with_income_exceeding_deductions(entity_ref("urn:test:s183:d3#p"), 1, entity_ref("urn:test:s183:d3#y2024"), 2) { origin case_input; }
    }
    // Only 2 of 5 years — below the 3-year threshold: the presumption's
    // `when` (3, 4, or 5) does not hold, so no presumed fact either way.
    evaluate truth(activity_presumed_engaged_in_for_profit(entity_ref("urn:test:s183:d3#p"), 1, entity_ref("urn:test:s183:d3#y2024")));
    expect truth_status == NEITHER;
}
