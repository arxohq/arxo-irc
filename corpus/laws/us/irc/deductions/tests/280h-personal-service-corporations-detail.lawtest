test "S280H-20-APPLICABLE-AMOUNT-INCLUDIBLE-PAYMENT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": payment_to_employee_owner(entity_ref("urn:test:s280h-20#c"),entity_ref("urn:test:s280h-20#y"),1,100000.00 USD) { origin case_input; }
        assert "f1": payment_includible_in_employee_gross_income(1) { origin case_input; }
    }
    evaluate truth(applicable_amount_280h(entity_ref("urn:test:s280h-20#c"),entity_ref("urn:test:s280h-20#y"),1,100000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(f)(1): an includible payment to an employee-owner";
}

