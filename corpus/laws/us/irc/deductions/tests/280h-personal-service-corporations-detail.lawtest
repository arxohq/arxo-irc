        assert "f5": months_in_deferral_period(entity_ref("urn:test:s280h-39#c"),entity_ref("urn:test:s280h-39#y"),3) { origin case_input; }
        assert "f6": months_in_taxable_year(entity_ref("urn:test:s280h-39#c"),entity_ref("urn:test:s280h-39#y"),12) { origin case_input; }
    }
    evaluate truth(applicable_amounts_deduction_limited_to_maximum(entity_ref("urn:test:s280h-39#c"),entity_ref("urn:test:s280h-39#y"),120000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(a): the allowed deduction is the maximum deductible amount";
}

test "S280H-40-DISALLOWED-AMOUNT-CARRIED-FORWARD" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": section_444_election_in_effect_for_personal_service_corporation(entity_ref("urn:test:s280h-40#c"),entity_ref("urn:test:s280h-40#y")) { origin case_input; }
        assert "f1": applicable_amounts_paid_or_incurred_for_deduction(entity_ref("urn:test:s280h-40#c"),entity_ref("urn:test:s280h-40#y"),200000.00 USD) { origin case_input; }
        assert "f2": payment_to_employee_owner(entity_ref("urn:test:s280h-40#c"),entity_ref("urn:test:s280h-40#y"),1,30000.00 USD) { origin case_input; }
        assert "f3": payment_includible_in_employee_gross_income(1) { origin case_input; }
        assert "f4": payment_in_deferral_period(1) { origin case_input; }
        assert "f5": months_in_deferral_period(entity_ref("urn:test:s280h-40#c"),entity_ref("urn:test:s280h-40#y"),3) { origin case_input; }
        assert "f6": months_in_taxable_year(entity_ref("urn:test:s280h-40#c"),entity_ref("urn:test:s280h-40#y"),12) { origin case_input; }
        assert "f7": succeeding_taxable_year_280h(entity_ref("urn:test:s280h-40#y"),entity_ref("urn:test:s280h-40#next")) { origin case_input; }
    }
    evaluate truth(disallowed_applicable_amounts_treated_paid_in_succeeding_year(entity_ref("urn:test:s280h-40#c"),entity_ref("urn:test:s280h-40#next"),80000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(b): the disallowed amount is treated as paid in the succeeding year";
}

test "S280H-41-NO-CARRYBACK-WITH-SECTION-444" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
