        assert "f3": elects_168k5_for_year(entity_ref("urn:test:s168x-84#p"),entity_ref("urn:test:s168x-84#y")) { origin case_input; }
        assert "f4": plant_planted_for_farming_business_in_ordinary_course(entity_ref("urn:test:s168x-84#p"),1) { origin case_input; }
        assert "f5": plant_adjusted_basis(entity_ref("urn:test:s168x-84#p"),1,50000.00 USD) { origin case_input; }
    }
    evaluate truth(specified_plant_not_qualified_property_in_placed_in_service_year(entity_ref("urn:test:s168x-84#p"),1,entity_ref("urn:test:s168x-84#y")));
    expect truth_status == TRUE_ONLY;
    description "(k)(5)(D): the plant is not qualified property in the year placed in service";
}

