// Section 164 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S164-01-SALT-CAP-TEN-THOUSAND-2024" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s164:b1#p"), entity_ref("urn:test:s164:b1#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": salt_capped_taxes_aggregate(entity_ref("urn:test:s164:b1#p"), entity_ref("urn:test:s164:b1#y2024"), 15000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s164:b1#p"), entity_ref("urn:test:s164:b1#y2024"), Section164Taxes, 5000 USD));
    expect truth_status == FALSE_ONLY;
    description "the 5,000 excess above the 10,000 cap is NOT allowed — this checks the disallowed portion, not the allowed portion, matching this module's `not deduction_allowed` rule head";
}

test "S164-02-SALT-CAP-FORTY-THOUSAND-2025" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s164:b2#p"), entity_ref("urn:test:s164:b2#y2025"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": salt_capped_taxes_aggregate(entity_ref("urn:test:s164:b2#p"), entity_ref("urn:test:s164:b2#y2025"), 35000 USD) { origin case_input; }
        assert "f2": modified_adjusted_gross_income_for_salt(entity_ref("urn:test:s164:b2#p"), entity_ref("urn:test:s164:b2#y2025"), 300000 USD) { origin case_input; }
    }
    // MAGI 300,000 is below the 500,000 threshold: no phasedown, cap is 40,000; 35,000 aggregate is fully allowed (this scenario checks no disallowance fires).
    evaluate truth(deduction_allowed(entity_ref("urn:test:s164:b2#p"), entity_ref("urn:test:s164:b2#y2025"), Section164Taxes, 0 USD));
    expect truth_status == NEITHER;
}

test "S164-03-SALES-TAX-ELECTION-SUBSTITUTES-FOR-INCOME-TAX" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s164:e1#p"), entity_ref("urn:test:s164:e1#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": elects_sales_tax_in_lieu_of_income_tax(entity_ref("urn:test:s164:e1#p"), entity_ref("urn:test:s164:e1#y2024")) { origin case_input; }
        assert "f2": tax_paid_or_accrued(entity_ref("urn:test:s164:e1#p"), entity_ref("urn:test:s164:e1#y2024"), 1, GeneralSalesTax, 3000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s164:e1#p"), entity_ref("urn:test:s164:e1#y2024"), Section164Taxes, 3000 USD));
    expect truth_status == TRUE_ONLY;
}
