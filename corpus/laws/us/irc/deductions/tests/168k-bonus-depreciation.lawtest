// Section 168(k) bonus depreciation scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S168K-01-PERMANENT-100-PERCENT-AFTER-JAN-19-2025" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-05:00;
            knowledge_time @2025-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_property_for_bonus_depreciation(entity_ref("urn:test:s168k:v1#p"), entity_ref("urn:test:s168k:v1#a")) { origin case_input; }
        assert "f1": placed_in_service_year(entity_ref("urn:test:s168k:v1#p"), entity_ref("urn:test:s168k:v1#a"), entity_ref("urn:test:s168k:v1#y2025")) { origin case_input; }
        assert "f2": unadjusted_depreciable_basis(entity_ref("urn:test:s168k:v1#p"), entity_ref("urn:test:s168k:v1#a"), entity_ref("urn:test:s168k:v1#y2025"), 100000.00 USD) { origin case_input; }
        assert "f3": bonus_depreciation_property_acquired_on(entity_ref("urn:test:s168k:v1#p"), entity_ref("urn:test:s168k:v1#a"), @2025-03-01) { origin case_input; }
    }
    evaluate truth(bonus_depreciation(entity_ref("urn:test:s168k:v1#p"), entity_ref("urn:test:s168k:v1#a"), entity_ref("urn:test:s168k:v1#y2025"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "property acquired after January 19, 2025 gets the Pub. L. 119-21 section 70301 permanent 100 percent rate: full basis";
}

test "S168K-02-PRE-AMENDMENT-40-PERCENT-2025-PLACED-IN-SERVICE" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-05:00;
            knowledge_time @2025-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_property_for_bonus_depreciation(entity_ref("urn:test:s168k:v2#p"), entity_ref("urn:test:s168k:v2#a")) { origin case_input; }
        assert "f1": placed_in_service_year(entity_ref("urn:test:s168k:v2#p"), entity_ref("urn:test:s168k:v2#a"), entity_ref("urn:test:s168k:v2#y2025")) { origin case_input; }
        assert "f2": unadjusted_depreciable_basis(entity_ref("urn:test:s168k:v2#p"), entity_ref("urn:test:s168k:v2#a"), entity_ref("urn:test:s168k:v2#y2025"), 100000.00 USD) { origin case_input; }
        assert "f3": bonus_depreciation_property_acquired_on(entity_ref("urn:test:s168k:v2#p"), entity_ref("urn:test:s168k:v2#a"), @2025-01-05) { origin case_input; }
        assert "f4": bonus_depreciation_property_placed_in_service_on(entity_ref("urn:test:s168k:v2#p"), entity_ref("urn:test:s168k:v2#a"), @2025-02-01) { origin case_input; }
    }
    // Acquired before January 19, 2025 (January 5): governed by the
    // pre-amendment schedule; placed in service February 2025 -> 40%.
    evaluate truth(bonus_depreciation(entity_ref("urn:test:s168k:v2#p"), entity_ref("urn:test:s168k:v2#a"), entity_ref("urn:test:s168k:v2#y2025"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "property acquired on or before January 19, 2025 stays under the pre-amendment section 168(k)(6)(A)(iv) 40 percent rate for 2025 placed-in-service dates";
}

test "S168K-03-ELECTION-OUT-BLOCKS-ALLOWANCE" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-05:00;
            knowledge_time @2025-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_property_for_bonus_depreciation(entity_ref("urn:test:s168k:v3#p"), entity_ref("urn:test:s168k:v3#a")) { origin case_input; }
        assert "f1": placed_in_service_year(entity_ref("urn:test:s168k:v3#p"), entity_ref("urn:test:s168k:v3#a"), entity_ref("urn:test:s168k:v3#y2025")) { origin case_input; }
        assert "f2": unadjusted_depreciable_basis(entity_ref("urn:test:s168k:v3#p"), entity_ref("urn:test:s168k:v3#a"), entity_ref("urn:test:s168k:v3#y2025"), 100000.00 USD) { origin case_input; }
        assert "f3": bonus_depreciation_property_acquired_on(entity_ref("urn:test:s168k:v3#p"), entity_ref("urn:test:s168k:v3#a"), @2025-03-01) { origin case_input; }
        assert "f4": property_classified_as(entity_ref("urn:test:s168k:v3#p"), entity_ref("urn:test:s168k:v3#a"), FiveYearProperty) { origin case_input; }
        assert "f5": elects_out_of_bonus_depreciation(entity_ref("urn:test:s168k:v3#p"), FiveYearProperty, entity_ref("urn:test:s168k:v3#y2025")) { origin case_input; }
    }
    evaluate truth(bonus_depreciation(entity_ref("urn:test:s168k:v3#p"), entity_ref("urn:test:s168k:v3#a"), entity_ref("urn:test:s168k:v3#y2025"), 100000.00 USD));
    expect truth_status == NEITHER;
    description "a section 168(k)(7) election out for the asset's class and year blocks the bonus depreciation allowance";
}

test "S168K-04-ELECTION-OUT-POWER-EFFECT" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-05:00;
            knowledge_time @2025-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_out_of_bonus_depreciation(entity_ref("urn:test:s168k:v4#p"), FiveYearProperty, entity_ref("urn:test:s168k:v4#y2025")) { origin case_input; }
    }
    evaluate truth(bonus_depreciation_election_out_in_effect(entity_ref("urn:test:s168k:v4#p"), FiveYearProperty, entity_ref("urn:test:s168k:v4#y2025")));
    expect truth_status == TRUE_ONLY;
    description "exercising the section 168(k)(7) election out puts the effect in place for the class and year";
}
