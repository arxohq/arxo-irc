// Section 197 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S197-01-GOODWILL-AMORTIZABLE-FULL-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_197_intangible(entity_ref("urn:test:s197:v1#p"), entity_ref("urn:test:s197:v1#a")) { origin case_input; }
        assert "f1": section_197_held_for_trade_or_business_or_212(entity_ref("urn:test:s197:v1#p"), entity_ref("urn:test:s197:v1#a")) { origin case_input; }
        assert "f2": section_197_acquired_on(entity_ref("urn:test:s197:v1#p"), entity_ref("urn:test:s197:v1#a"), @2020-01-15) { origin case_input; }
        assert "f3": section_197_adjusted_basis(entity_ref("urn:test:s197:v1#p"), entity_ref("urn:test:s197:v1#a"), 150000.00 USD) { origin case_input; }
        assert "f4": section_197_held_for_full_taxable_year(entity_ref("urn:test:s197:v1#p"), entity_ref("urn:test:s197:v1#a"), entity_ref("urn:test:s197:v1#y2024")) { origin case_input; }
    }
    // 150,000 / 15 = 10,000.00.
    evaluate truth(amortization_197(entity_ref("urn:test:s197:v1#p"), entity_ref("urn:test:s197:v1#a"), entity_ref("urn:test:s197:v1#y2024"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "a purchased intangible acquired well after the 1993 enactment date amortizes ratably over 15 years: 1/15 of basis for a full year (section 197(a))";
}

test "S197-02-SELF-CREATED-NOT-TYPE-DEF-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_197_intangible(entity_ref("urn:test:s197:v2#p"), entity_ref("urn:test:s197:v2#a")) { origin case_input; }
        assert "f1": section_197_held_for_trade_or_business_or_212(entity_ref("urn:test:s197:v2#p"), entity_ref("urn:test:s197:v2#a")) { origin case_input; }
        assert "f2": section_197_acquired_on(entity_ref("urn:test:s197:v2#p"), entity_ref("urn:test:s197:v2#a"), @2020-01-15) { origin case_input; }
        assert "f3": section_197_created_by_taxpayer(entity_ref("urn:test:s197:v2#p"), entity_ref("urn:test:s197:v2#a")) { origin case_input; }
    }
    evaluate truth(amortizable_section_197_intangible(entity_ref("urn:test:s197:v2#p"), entity_ref("urn:test:s197:v2#a")));
    expect truth_status == NEITHER;
    description "a self-created intangible, not of type (D)/(E)/(F), is excluded from amortizable section 197 intangible status (section 197(c)(2))";
}

test "S197-03-ANTI-CHURNING-DISQUALIFIES-GOODWILL" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_197_intangible(entity_ref("urn:test:s197:v3#p"), entity_ref("urn:test:s197:v3#a")) { origin case_input; }
        assert "f1": section_197_held_for_trade_or_business_or_212(entity_ref("urn:test:s197:v3#p"), entity_ref("urn:test:s197:v3#a")) { origin case_input; }
        assert "f2": section_197_acquired_on(entity_ref("urn:test:s197:v3#p"), entity_ref("urn:test:s197:v3#a"), @1994-01-15) { origin case_input; }
        assert "f3": section_197_goodwill_or_going_concern(entity_ref("urn:test:s197:v3#p"), entity_ref("urn:test:s197:v3#a")) { origin case_input; }
        assert "f4": section_197_held_or_used_before_enactment_by_taxpayer_or_related(entity_ref("urn:test:s197:v3#p"), entity_ref("urn:test:s197:v3#a")) { origin case_input; }
    }
    evaluate truth(amortizable_section_197_intangible(entity_ref("urn:test:s197:v3#p"), entity_ref("urn:test:s197:v3#a")));
    expect truth_status == NEITHER;
    description "goodwill held by the taxpayer since before the 1993 enactment date is disqualified by the anti-churning rule, even though acquired after enactment (section 197(f)(9)(A)(i))";
}

test "S197-04-NOT-YET-ACQUIRED-NEITHER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_197_intangible(entity_ref("urn:test:s197:v4#p"), entity_ref("urn:test:s197:v4#a")) { origin case_input; }
    }
    evaluate truth(amortizable_section_197_intangible(entity_ref("urn:test:s197:v4#p"), entity_ref("urn:test:s197:v4#a")));
    expect truth_status == NEITHER;
    description "without the acquisition date and trade-or-business connection, amortizable status is NEITHER, not assumed";
}
