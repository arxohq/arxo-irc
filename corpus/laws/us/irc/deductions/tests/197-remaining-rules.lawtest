// Section 197 remaining rules scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S197-10-GOODWILL-DERIVED-AS-SECTION-197-INTANGIBLE" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_197_item_type(entity_ref("urn:test:s197:d1#p"),entity_ref("urn:test:s197:d1#a"),Goodwill) { origin case_input; }
        assert "f1": section_197_held_for_trade_or_business_or_212(entity_ref("urn:test:s197:d1#p"),entity_ref("urn:test:s197:d1#a")) { origin case_input; }
        assert "f2": section_197_acquired_on(entity_ref("urn:test:s197:d1#p"),entity_ref("urn:test:s197:d1#a"),@2020-01-15) { origin case_input; }
    }
    evaluate truth(amortizable_section_197_intangible(entity_ref("urn:test:s197:d1#p"),entity_ref("urn:test:s197:d1#a")));
    expect truth_status == TRUE_ONLY;
    description "goodwill acquired in 2020 and held in a business is an amortizable section 197 intangible without asserting the classification (section 197(c),(d)(1)(A))";
}

