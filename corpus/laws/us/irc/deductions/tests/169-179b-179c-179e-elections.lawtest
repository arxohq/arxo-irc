            knowledge_time @2012-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": eligible_adjusted_basis_before_useful_life_ratio(entity_ref("urn:test:s169:f1#p"),1,200000.00 USD) { origin case_input; }
        assert "f1": facility_useful_life_years(entity_ref("urn:test:s169:f1#p"),1,20) { origin case_input; }
    }
    evaluate truth(amortizable_basis_after_useful_life_ratio_169f2a(entity_ref("urn:test:s169:f1#p"),1,150000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "200,000 x 15/20 = 150,000 (section 169(f)(2)(A))";
}

test "S179B-01-SMALL-REFINER-75-PERCENT" {
    given {
        context {
            legal_time @2008-12-31;
            decision_time @2008-12-31T09:00:00-05:00;
            knowledge_time @2008-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_section_179b(entity_ref("urn:test:s179b:a1#p"),entity_ref("urn:test:s179b:a1#y")) { origin case_input; }
        assert "f1": small_business_refiner_qualified_costs(entity_ref("urn:test:s179b:a1#p"),entity_ref("urn:test:s179b:a1#y"),1000000.00 USD) { origin case_input; }
        assert "f2": refinery_runs_over_155000_barrels_excess(entity_ref("urn:test:s179b:a1#p"),0) { origin case_input; }
    }
    evaluate truth(section_179b_deduction(entity_ref("urn:test:s179b:a1#p"),entity_ref("urn:test:s179b:a1#y"),750000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "75 percent of qualified costs (section 179B(a))";
}

test "S179B-02-REDUCED-PERCENTAGE-FOR-LARGER-REFINER" {
    given {
        context {
            legal_time @2008-12-31;
            decision_time @2008-12-31T09:00:00-05:00;
            knowledge_time @2008-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_section_179b(entity_ref("urn:test:s179b:b1#p"),entity_ref("urn:test:s179b:b1#y")) { origin case_input; }
        assert "f1": small_business_refiner_qualified_costs(entity_ref("urn:test:s179b:b1#p"),entity_ref("urn:test:s179b:b1#y"),1000000.00 USD) { origin case_input; }
        assert "f2": refinery_runs_over_155000_barrels_excess(entity_ref("urn:test:s179b:b1#p"),25000) { origin case_input; }
    }
    evaluate truth(section_179b_deduction(entity_ref("urn:test:s179b:b1#p"),entity_ref("urn:test:s179b:b1#y"),375000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "runs 25,000 barrels above 155,000: 75 points reduced by half, 37.5 percent = 375,000 (section 179B(b))";
}

