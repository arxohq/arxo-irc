// Sections 169, 179B, 179C, 179E scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S169-01-CERTIFIED-POLLUTION-CONTROL-FACILITY" {
    given {
        context {
            legal_time @2012-12-31;
            decision_time @2012-12-31T09:00:00-05:00;
            knowledge_time @2012-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005(entity_ref("urn:test:s169:d1#p"),1) { origin case_input; }
        assert "f1": state_certifying_authority_certified_facility(entity_ref("urn:test:s169:d1#p"),1) { origin case_input; }
        assert "f2": federal_certifying_authority_certified_facility(entity_ref("urn:test:s169:d1#p"),1) { origin case_input; }
    }
    evaluate truth(certified_pollution_control_facility(entity_ref("urn:test:s169:d1#p"),1));
    expect truth_status == TRUE_ONLY;
    description "a facility of a pre-1976 plant certified by the State and Federal authorities (section 169(d)(1))";
}

