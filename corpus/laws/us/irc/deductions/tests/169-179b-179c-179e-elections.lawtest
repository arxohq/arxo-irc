test "S169-03-AMORTIZATION-OVER-60-MONTHS" {
    given {
        context {
            legal_time @2012-12-31;
            decision_time @2012-12-31T09:00:00-05:00;
            knowledge_time @2012-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005(entity_ref("urn:test:s169:a1#p"),1) { origin case_input; }
        assert "f1": state_certifying_authority_certified_facility(entity_ref("urn:test:s169:a1#p"),1) { origin case_input; }
        assert "f2": federal_certifying_authority_certified_facility(entity_ref("urn:test:s169:a1#p"),1) { origin case_input; }
        assert "f3": elects_pollution_control_amortization(entity_ref("urn:test:s169:a1#p"),1) { origin case_input; }
        assert "f4": pollution_control_amortizable_basis(entity_ref("urn:test:s169:a1#p"),1,60000.00 USD) { origin case_input; }
        assert "f5": pollution_control_months_in_taxable_year(entity_ref("urn:test:s169:a1#p"),1,entity_ref("urn:test:s169:a1#y"),12) { origin case_input; }
    }
    evaluate truth(pollution_control_amortization_deduction(entity_ref("urn:test:s169:a1#p"),1,entity_ref("urn:test:s169:a1#y"),12000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "60,000 x 12/60 = 12,000 (section 169(a))";
}

