// Section 274 remaining subsections scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S274-20-ENTERTAINMENT-WITHOUT-EXCEPTION-DENIED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": entertainment_amusement_or_recreation_expense(entity_ref("urn:test:s274:e0#p"),entity_ref("urn:test:s274:e0#y"),1,5000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:e0#p"),entity_ref("urn:test:s274:e0#y"),Section274Meals,5000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "an entertainment expense with no exception is disallowed (section 274(a))";
}

