test "S274-27-FOREIGN-TRAVEL-NON-BUSINESS-PORTION-DISALLOWED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": foreign_travel_expense(entity_ref("urn:test:s274:c1#p"),entity_ref("urn:test:s274:c1#y"),1,10000.00 USD) { origin case_input; }
        assert "f1": foreign_travel_total_days(entity_ref("urn:test:s274:c1#p"),entity_ref("urn:test:s274:c1#y"),1,10) { origin case_input; }
        assert "f2": foreign_travel_business_days(entity_ref("urn:test:s274:c1#p"),entity_ref("urn:test:s274:c1#y"),1,6) { origin case_input; }
    }
    evaluate truth(foreign_travel_portion_not_allocable(entity_ref("urn:test:s274:c1#p"),entity_ref("urn:test:s274:c1#y"),1,4000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "10 days, 6 business: 4 of 10 days (40 percent, at least 25 percent) is not allocable: 4,000 (section 274(c))";
}

