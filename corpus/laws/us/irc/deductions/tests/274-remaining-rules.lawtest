            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": travel_as_a_form_of_education_expense(entity_ref("urn:test:s274:m3#p"),entity_ref("urn:test:s274:m3#y"),1,2000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:m3#p"),entity_ref("urn:test:s274:m3#y"),Section274MTravelEducation,2000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "no deduction for travel as a form of education (section 274(m)(2))";
}

test "S274-44-ACCOMPANYING-SPOUSE-TRAVEL-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": accompanying_person_travel_expense(entity_ref("urn:test:s274:m4#p"),entity_ref("urn:test:s274:m4#y"),1,1800.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:m4#p"),entity_ref("urn:test:s274:m4#y"),Section274MAccompanyingPerson,1800.00 USD));
    expect truth_status == FALSE_ONLY;
    description "a spouse's travel is not deductible without the three conditions (section 274(m)(3))";
}

test "S274-45-ACCOMPANYING-EMPLOYEE-WITH-BUSINESS-PURPOSE-NOT-DENIED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": accompanying_person_travel_expense(entity_ref("urn:test:s274:m5#p"),entity_ref("urn:test:s274:m5#y"),1,1800.00 USD) { origin case_input; }
        assert "f1": accompanying_person_is_employee_with_bona_fide_business_purpose_and_deductible(entity_ref("urn:test:s274:m5#p"),entity_ref("urn:test:s274:m5#y"),1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:m5#p"),entity_ref("urn:test:s274:m5#y"),Section274MAccompanyingPerson,1800.00 USD));
    expect truth_status == NEITHER;
    description "an employee companion with a bona fide business purpose is outside the denial";
}
