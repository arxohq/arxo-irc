// Section 263A(b)/(i) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S263A-01-PRODUCED-PROPERTY-APPLIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_produced_by_taxpayer(entity_ref("urn:test:s263a:v1#p"), entity_ref("urn:test:s263a:v1#y2024"), 1) { origin case_input; }
    }
    evaluate truth(section_263a_applies(entity_ref("urn:test:s263a:v1#p"), entity_ref("urn:test:s263a:v1#y2024"), 1));
    expect truth_status == TRUE_ONLY;
    description "section 263A applies to property the taxpayer produces, absent the small-business exemption (section 263A(b)(1))";
}

test "S263A-02-SMALL-BUSINESS-EXEMPT-BLOCKS-APPLICATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_produced_by_taxpayer(entity_ref("urn:test:s263a:v2#p"), entity_ref("urn:test:s263a:v2#y2024"), 1) { origin case_input; }
        assert "f1": meets_gross_receipts_test_448c(entity_ref("urn:test:s263a:v2#p"), entity_ref("urn:test:s263a:v2#y2024")) { origin case_input; }
    }
    evaluate truth(section_263a_applies(entity_ref("urn:test:s263a:v2#p"), entity_ref("urn:test:s263a:v2#y2024"), 1));
    expect truth_status == NEITHER;
    description "a taxpayer meeting the section 448(c) gross receipts test is exempt from section 263A, so it does not apply even to produced property (section 263A(i)(1))";
}

test "S263A-03-TAX-SHELTER-CANNOT-USE-EXEMPTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_produced_by_taxpayer(entity_ref("urn:test:s263a:v3#p"), entity_ref("urn:test:s263a:v3#y2024"), 1) { origin case_input; }
        assert "f1": meets_gross_receipts_test_448c(entity_ref("urn:test:s263a:v3#p"), entity_ref("urn:test:s263a:v3#y2024")) { origin case_input; }
        assert "f2": tax_shelter_prohibited_cash_method_448a3(entity_ref("urn:test:s263a:v3#p")) { origin case_input; }
    }
    evaluate truth(section_263a_applies(entity_ref("urn:test:s263a:v3#p"), entity_ref("urn:test:s263a:v3#y2024"), 1));
    expect truth_status == TRUE_ONLY;
    description "a section 448(a)(3) tax shelter cannot use the section 263A(i) small-business exemption even if it meets the gross receipts test";
}

test "S263A-04-RESALE-PROPERTY-APPLIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_acquired_for_resale_1221a1(entity_ref("urn:test:s263a:v4#p"), entity_ref("urn:test:s263a:v4#y2024"), 1) { origin case_input; }
    }
    evaluate truth(section_263a_applies(entity_ref("urn:test:s263a:v4#p"), entity_ref("urn:test:s263a:v4#y2024"), 1));
    expect truth_status == TRUE_ONLY;
    description "section 263A applies to property acquired for resale under section 1221(a)(1) (section 263A(b)(2))";
}
