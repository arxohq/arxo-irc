test "S269-01-CONTROL-ACQUIRED-FOR-TAX-AVOIDANCE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": person_or_persons_acquire_control_of_corporation(1) { origin case_input; }
        assert "f1": principal_purpose_is_evasion_or_avoidance_of_income_tax(1) { origin adjudicated; }
    }
    evaluate truth(section_269_applies(1));
    expect truth_status == TRUE_ONLY;
    description "acquisition of control with a tax-avoidance principal purpose (section 269(a)(1))";
}

