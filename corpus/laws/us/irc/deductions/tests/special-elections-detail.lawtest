test "SSE-1-NO-OTHER-DEPRECIATION-FOR-ELECTED-PRODUCTION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": section_181_election_in_effect(entity_ref("urn:test:sse-1#p"),1) { origin case_input; }
        assert "f1": qualified_production_181(entity_ref("urn:test:sse-1#p"),1,FilmOrTelevision) { origin case_input; }
        assert "f2": production_basis_for_181_election(entity_ref("urn:test:sse-1#p"),1,500000.00 USD) { origin case_input; }
    }
    evaluate truth(other_depreciation_or_amortization_disallowed_for_production_basis(entity_ref("urn:test:sse-1#p"),1,500000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(181)(b): the elected basis carries no depreciation";
}

