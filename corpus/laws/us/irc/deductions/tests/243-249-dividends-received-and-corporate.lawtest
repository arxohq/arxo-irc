            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": corporation_begins_business_in_year(entity_ref("urn:test:s248:a3#c"),entity_ref("urn:test:s248:a3#y")) { origin case_input; }
        assert "f1": organizational_expenditures_aggregate(entity_ref("urn:test:s248:a3#c"),30000.00 USD) { origin case_input; }
    }
    evaluate truth(organizational_expenditure_first_year_deduction(entity_ref("urn:test:s248:a3#c"),entity_ref("urn:test:s248:a3#y"),5000.00 USD));
    expect truth_status == NEITHER;
    description "without the election no section 248 deduction is derived";
}

test "S249-01-CONVERTIBLE-REPURCHASE-PREMIUM-DENIED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": convertible_debt_repurchase_price(entity_ref("urn:test:s249:a1#c"),entity_ref("urn:test:s249:a1#y"),1,1050000.00 USD) { origin case_input; }
        assert "f1": adjusted_issue_price_249b(entity_ref("urn:test:s249:a1#c"),entity_ref("urn:test:s249:a1#y"),1,1000000.00 USD) { origin case_input; }
        assert "f2": normal_call_premium_on_nonconvertible_debt(entity_ref("urn:test:s249:a1#c"),entity_ref("urn:test:s249:a1#y"),1,20000.00 USD) { origin case_input; }
    }
    evaluate truth(premium_on_convertible_repurchase_nondeductible(entity_ref("urn:test:s249:a1#c"),entity_ref("urn:test:s249:a1#y"),1,30000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "1,050,000 - (1,000,000 + 20,000) = 30,000 is not deductible (section 249(a))";
}

test "S249-02-PRICE-WITHIN-NORMAL-CALL-PREMIUM" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": convertible_debt_repurchase_price(entity_ref("urn:test:s249:a2#c"),entity_ref("urn:test:s249:a2#y"),1,1015000.00 USD) { origin case_input; }
        assert "f1": adjusted_issue_price_249b(entity_ref("urn:test:s249:a2#c"),entity_ref("urn:test:s249:a2#y"),1,1000000.00 USD) { origin case_input; }
        assert "f2": normal_call_premium_on_nonconvertible_debt(entity_ref("urn:test:s249:a2#c"),entity_ref("urn:test:s249:a2#y"),1,20000.00 USD) { origin case_input; }
    }
    evaluate truth(premium_on_convertible_repurchase_nondeductible(entity_ref("urn:test:s249:a2#c"),entity_ref("urn:test:s249:a2#y"),1,0.00 USD));
    expect truth_status == NEITHER;
    description "a price within the adjusted issue price plus a normal call premium derives no denial";
}
