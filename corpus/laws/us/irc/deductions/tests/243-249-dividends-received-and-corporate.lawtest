// Sections 243-249 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).
// Expectations come from the statutory text and its arithmetic, not from engine output.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S243-01-ORDINARY-DIVIDEND-FIFTY-PERCENT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dividend_received_by_corporation(entity_ref("urn:test:s243:a1#c"),entity_ref("urn:test:s243:a1#y"),1,10000.00 USD) { origin case_input; }
        assert "f1": dividend_from_domestic_corporation_subject_to_tax(entity_ref("urn:test:s243:a1#c"),entity_ref("urn:test:s243:a1#y"),1) { origin case_input; }
    }
    evaluate truth(dividends_received_deduction_243_item(entity_ref("urn:test:s243:a1#c"),entity_ref("urn:test:s243:a1#y"),1,5000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "an ordinary dividend from a taxable domestic corporation yields a deduction of 50 percent (section 243(a)(1))";
}

