test "S243-03-QUALIFYING-AFFILIATED-GROUP-HUNDRED-PERCENT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dividend_received_by_corporation(entity_ref("urn:test:s243:a3#c"),entity_ref("urn:test:s243:a3#y"),1,10000.00 USD) { origin case_input; }
        assert "f1": dividend_from_domestic_corporation_subject_to_tax(entity_ref("urn:test:s243:a3#c"),entity_ref("urn:test:s243:a3#y"),1) { origin case_input; }
        assert "f2": member_of_same_affiliated_group_at_close_of_day_received(entity_ref("urn:test:s243:a3#c"),entity_ref("urn:test:s243:a3#y"),1) { origin case_input; }
        assert "f3": dividend_out_of_earnings_of_year_of_continuous_affiliation(entity_ref("urn:test:s243:a3#c"),entity_ref("urn:test:s243:a3#y"),1) { origin case_input; }
    }
    evaluate truth(dividends_received_deduction_243_item(entity_ref("urn:test:s243:a3#c"),entity_ref("urn:test:s243:a3#y"),1,10000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "a qualifying dividend within an affiliated group is deducted at 100 percent (section 243(a)(3),(b)(1))";
}

test "S243-04-INCONSISTENT-FOREIGN-TAX-TREATMENT-NOT-QUALIFYING" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dividend_received_by_corporation(entity_ref("urn:test:s243:a4#c"),entity_ref("urn:test:s243:a4#y"),1,10000.00 USD) { origin case_input; }
        assert "f1": dividend_from_domestic_corporation_subject_to_tax(entity_ref("urn:test:s243:a4#c"),entity_ref("urn:test:s243:a4#y"),1) { origin case_input; }
        assert "f2": member_of_same_affiliated_group_at_close_of_day_received(entity_ref("urn:test:s243:a4#c"),entity_ref("urn:test:s243:a4#y"),1) { origin case_input; }
        assert "f3": dividend_out_of_earnings_of_year_of_continuous_affiliation(entity_ref("urn:test:s243:a4#c"),entity_ref("urn:test:s243:a4#y"),1) { origin case_input; }
        assert "f4": group_inconsistent_foreign_tax_treatment(entity_ref("urn:test:s243:a4#c"),entity_ref("urn:test:s243:a4#y"),1) { origin case_input; }
    }
    evaluate truth(dividends_received_deduction_243_item(entity_ref("urn:test:s243:a4#c"),entity_ref("urn:test:s243:a4#y"),1,5000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "a group whose members split between credit and deduction for foreign taxes does not meet the affiliated-group test, so the dividend falls back to 50 percent (section 243(b)(2)(B))";
}

