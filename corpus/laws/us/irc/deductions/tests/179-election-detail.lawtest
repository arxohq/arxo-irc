// Section 179 detail scenarios (stage 2b). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S179-20-ELECTION-EXERCISABLE-WHEN-FORM-OK" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": section_179_property_cost(entity_ref("urn:test:s179-20#p"),entity_ref("urn:test:s179-20#y"),1,80000.00 USD) { origin case_input; }
        assert "f1": elects_to_expense_section_179_property(entity_ref("urn:test:s179-20#p"),entity_ref("urn:test:s179-20#y"),1) { origin case_input; }
    }
    evaluate truth(section_179_election_exercisable(entity_ref("urn:test:s179-20#p"),entity_ref("urn:test:s179-20#y"),1));
    expect truth_status == TRUE_ONLY;
    description "(c)(1): an election without recorded defects is exercisable";
}

