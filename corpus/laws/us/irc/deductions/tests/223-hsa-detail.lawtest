test "S223-29-COORDINATION-REDUCES-LIMIT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": months_with_self_only_coverage(entity_ref("urn:test:s223-29#p"),entity_ref("urn:test:s223-29#y"),12) { origin case_input; }
        assert "f1": taxable_year_begins_on(entity_ref("urn:test:s223-29#y"),@2025-01-01) { origin case_input; }
        assert "f2": archer_msa_payments_for_year(entity_ref("urn:test:s223-29#p"),entity_ref("urn:test:s223-29#y"),500.00 USD) { origin case_input; }
        assert "f3": hsa_contributions_excludable_under_106d(entity_ref("urn:test:s223-29#p"),entity_ref("urn:test:s223-29#y"),700.00 USD) { origin case_input; }
        assert "f4": hsa_contributions_under_408d9(entity_ref("urn:test:s223-29#p"),entity_ref("urn:test:s223-29#y"),100.00 USD) { origin case_input; }
    }
    evaluate truth(hsa_limitation_after_coordination(entity_ref("urn:test:s223-29#p"),entity_ref("urn:test:s223-29#y"),950.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(b)(4): Archer MSA, employer and 408(d)(9) amounts reduce the limitation";
}

