// Section 223 detail scenarios (stage 2b). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S223-20-ALLOWANCE-CASH-PAID-ELIGIBLE-MONTH" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": eligible_individual_hsa(entity_ref("urn:test:s223-20#p"),entity_ref("urn:test:s223-20#y"),3) { origin case_input; }
        assert "f1": hsa_contribution_for_year(entity_ref("urn:test:s223-20#p"),entity_ref("urn:test:s223-20#y"),3000.00 USD) { origin case_input; }
    }
    evaluate truth(hsa_allowance_before_limitation(entity_ref("urn:test:s223-20#p"),entity_ref("urn:test:s223-20#y"),3000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(a): cash paid by an eligible individual is the allowance";
}

