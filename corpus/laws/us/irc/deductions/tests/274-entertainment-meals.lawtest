test "S274-B-01-GIFT-OVER-25-DOLLARS-EXCESS-DISALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gift_expense_to_individual_in_year(entity_ref("urn:test:s274b:v1#p"), entity_ref("urn:test:s274b:v1#y2024"), entity_ref("urn:test:s274b:v1#recipient"), 60.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274b:v1#p"), entity_ref("urn:test:s274b:v1#y2024"), Section274Meals, 35.00 USD));
    expect truth_status == FALSE_ONLY;
    description "the section 274(b)(1) rule denies the portion of a gift's cost over $25 (denial asserted directly, not the allowed $25 remainder)";
}

test "S274-K-01-LAVISH-MEAL-DISALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": food_or_beverage_expense(entity_ref("urn:test:s274k:v1#p"), entity_ref("urn:test:s274k:v1#y2024"), 1, 500.00 USD) { origin case_input; }
        assert "f1": food_or_beverage_lavish_or_extravagant(entity_ref("urn:test:s274k:v1#p"), entity_ref("urn:test:s274k:v1#y2024"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274k:v1#p"), entity_ref("urn:test:s274k:v1#y2024"), Section274Meals, 500.00 USD));
    expect truth_status == NEITHER;
    description "a lavish or extravagant food or beverage expense fails the section 274(k)(1)(A) validity condition";
}

test "S274-K-02-PRESENT-AND-NOT-LAVISH-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": food_or_beverage_expense(entity_ref("urn:test:s274k:v2#p"), entity_ref("urn:test:s274k:v2#y2024"), 1, 80.00 USD) { origin case_input; }
        assert "f1": taxpayer_or_employee_present_at_meal(entity_ref("urn:test:s274k:v2#p"), entity_ref("urn:test:s274k:v2#y2024"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274k:v2#p"), entity_ref("urn:test:s274k:v2#y2024"), Section274Meals, 80.00 USD));
    expect truth_status == TRUE_ONLY;
    description "a food or beverage expense that is not lavish or extravagant, with the taxpayer or an employee present, satisfies the section 274(k)(1) validity condition";
}
