// Section 274 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S274-01-ENTERTAINMENT-EXPENSE-DISALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": entertainment_amusement_or_recreation_expense(entity_ref("urn:test:s274:a1#p"), entity_ref("urn:test:s274:a1#y2024"), 1, 1500 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:a1#p"), entity_ref("urn:test:s274:a1#y2024"), Section274Meals, 1500 USD));
    expect truth_status == FALSE_ONLY;
}

test "S274-02-MEALS-EXPENSE-LIMITED-TO-FIFTY-PERCENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": food_or_beverage_expense(entity_ref("urn:test:s274:n1#p"), entity_ref("urn:test:s274:n1#y2024"), 1, 200 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:n1#p"), entity_ref("urn:test:s274:n1#y2024"), Section274Meals, 100 USD));
    expect truth_status == TRUE_ONLY;
    description "section 274(n)(1): a $200 meal expense is deductible only up to $100 (50%)";
}

test "S274-03-EMPLOYEE-FOOD-ON-PREMISES-EXCEPTION-FULLY-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": food_or_beverage_expense(entity_ref("urn:test:s274:n2#p"), entity_ref("urn:test:s274:n2#y2024"), 1, 200 USD) { origin case_input; }
        assert "f1": employee_food_on_business_premises(entity_ref("urn:test:s274:n2#p"), entity_ref("urn:test:s274:n2#y2024"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:n2#p"), entity_ref("urn:test:s274:n2#y2024"), Section274Meals, 200 USD));
    expect truth_status == TRUE_ONLY;
}

test "S274-04-SUBSTANTIATION-MISSING-TRAVEL-EXPENSE-DENIED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": traveling_or_gift_expense_item(entity_ref("urn:test:s274:d1#p"), entity_ref("urn:test:s274:d1#y2024"), 1, 2500 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:d1#p"), entity_ref("urn:test:s274:d1#y2024"), Section274Meals, 2500 USD));
    expect truth_status == FALSE_ONLY;
    description "section 274(d): no adequate records or corroborating evidence asserted — the expense is denied outright (a VALIDITY CONDITION, not a duty)";
}

test "S274-05-SUBSTANTIATED-TRAVEL-EXPENSE-NO-DENIAL" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": traveling_or_gift_expense_item(entity_ref("urn:test:s274:d2#p"), entity_ref("urn:test:s274:d2#y2024"), 1, 2500 USD) { origin case_input; }
        assert "f1": substantiated_by_adequate_records_or_evidence(entity_ref("urn:test:s274:d2#p"), entity_ref("urn:test:s274:d2#y2024"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s274:d2#p"), entity_ref("urn:test:s274:d2#y2024"), Section274Meals, 2500 USD));
    expect truth_status == NEITHER;
}

