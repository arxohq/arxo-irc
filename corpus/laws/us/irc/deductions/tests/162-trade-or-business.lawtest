test "S162-04-RESTITUTION-EXCEPTION-TO-FINE-DISALLOWANCE-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": carrying_on_trade_or_business(entity_ref("urn:test:s162:f1#p"), entity_ref("urn:test:s162:f1#y2024")) { origin case_input; }
        assert "f1": ordinary_and_necessary(entity_ref("urn:test:s162:f1#p"), entity_ref("urn:test:s162:f1#y2024"), 1) { origin adjudicated; }
        assert "f2": payment_to_government_re_law_violation(entity_ref("urn:test:s162:f1#p"), entity_ref("urn:test:s162:f1#y2024"), 1, 50000 USD) { origin case_input; }
        assert "f3": established_restitution_or_compliance_payment(entity_ref("urn:test:s162:f1#p"), entity_ref("urn:test:s162:f1#y2024"), 1) { origin case_input; }
        assert "f4": identified_as_restitution_or_compliance_in_order(entity_ref("urn:test:s162:f1#p"), entity_ref("urn:test:s162:f1#y2024"), 1) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:f1#p"), entity_ref("urn:test:s162:f1#y2024"), Section162TradeOrBusiness, 50000 USD));
    expect truth_status == TRUE_ONLY;
}

