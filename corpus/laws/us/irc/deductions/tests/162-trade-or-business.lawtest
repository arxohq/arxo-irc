// Section 162 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S162-01-ORDINARY-AND-NECESSARY-EXPENSE-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": carrying_on_trade_or_business(entity_ref("urn:test:s162:t1#p"), entity_ref("urn:test:s162:t1#y2024")) { origin case_input; }
        assert "f1": expense_paid_or_incurred(entity_ref("urn:test:s162:t1#p"), entity_ref("urn:test:s162:t1#y2024"), 1, 4000 USD) { origin case_input; }
        assert "f2": ordinary_and_necessary(entity_ref("urn:test:s162:t1#p"), entity_ref("urn:test:s162:t1#y2024"), 1) { origin adjudicated; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:t1#p"), entity_ref("urn:test:s162:t1#y2024"), Section162TradeOrBusiness, 4000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S162-02-ORDINARY-AND-NECESSARY-UNKNOWN-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": carrying_on_trade_or_business(entity_ref("urn:test:s162:t2#p"), entity_ref("urn:test:s162:t2#y2024")) { origin case_input; }
        assert "f1": expense_paid_or_incurred(entity_ref("urn:test:s162:t2#p"), entity_ref("urn:test:s162:t2#y2024"), 1, 4000 USD) { origin case_input; }
    }
    // Whether the expense is "ordinary and necessary" is not adjudicated —
    // DECISION-0194: absence of the judgment is UNDETERMINED, not a denial.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:t2#p"), entity_ref("urn:test:s162:t2#y2024"), Section162TradeOrBusiness, 4000 USD));
    expect truth_status == NEITHER;
}

