        assert "f0": publicly_held_corporation(entity_ref("urn:test:s162:m1#c"), entity_ref("urn:test:s162:m1#y2024")) { origin case_input; }
        assert "f1": is_principal_executive_or_financial_officer(entity_ref("urn:test:s162:m1#e"), entity_ref("urn:test:s162:m1#c"), entity_ref("urn:test:s162:m1#y2024")) { origin case_input; }
        assert "f2": applicable_employee_remuneration(entity_ref("urn:test:s162:m1#e"), entity_ref("urn:test:s162:m1#c"), entity_ref("urn:test:s162:m1#y2024"), 1500000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:m1#c"), entity_ref("urn:test:s162:m1#y2024"), Section162TradeOrBusiness, 500000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S162-07-SELF-EMPLOYED-HEALTH-INSURANCE-CAPPED-AT-EARNED-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employed_within_401c1(entity_ref("urn:test:s162:l1#p"), entity_ref("urn:test:s162:l1#y2024")) { origin case_input; }
        assert "f1": medical_care_insurance_premium_paid(entity_ref("urn:test:s162:l1#p"), entity_ref("urn:test:s162:l1#y2024"), 9000 USD) { origin case_input; }
        assert "f2": earned_income_from_the_business_401c(entity_ref("urn:test:s162:l1#p"), entity_ref("urn:test:s162:l1#y2024"), 6000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:l1#p"), entity_ref("urn:test:s162:l1#y2024"), Section162TradeOrBusiness, 6000 USD));
    expect truth_status == TRUE_ONLY;
}

// Section 162(g): two-thirds of 30000 USD is exactly 20000 USD (the former 0.6667 approximation gave 20001).
test "S162-08-TREBLE-DAMAGES-EXACT-TWO-THIRDS-DISALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": antitrust_conviction_or_plea(entity_ref("urn:test:s162:g1#p"), entity_ref("urn:test:s162:g1#y2024")) { origin case_input; }
        assert "f1": antitrust_damages_or_settlement_payment(entity_ref("urn:test:s162:g1#p"), entity_ref("urn:test:s162:g1#y2024"), 1, 30000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:g1#p"), entity_ref("urn:test:s162:g1#y2024"), Section162TradeOrBusiness, 20000.00 USD));
    expect truth_status == FALSE_ONLY;
}

// Control for S162-08: the approximated amount 20001 USD is not what the rule derives.
test "S162-09-TREBLE-DAMAGES-APPROXIMATION-AMOUNT-NOT-DERIVED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": antitrust_conviction_or_plea(entity_ref("urn:test:s162:g2#p"), entity_ref("urn:test:s162:g2#y2024")) { origin case_input; }
        assert "f1": antitrust_damages_or_settlement_payment(entity_ref("urn:test:s162:g2#p"), entity_ref("urn:test:s162:g2#y2024"), 1, 30000.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:g2#p"), entity_ref("urn:test:s162:g2#y2024"), Section162TradeOrBusiness, 20001.00 USD));
    expect truth_status == NEITHER;
}

// Two-thirds of 100 USD is 66.666…; div_round rounds once to cents HALF_UP (judgment call, TECH-GAPS G11).
test "S162-10-TREBLE-DAMAGES-NONTERMINATING-THIRD-ROUNDED-ONCE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": antitrust_conviction_or_plea(entity_ref("urn:test:s162:g3#p"), entity_ref("urn:test:s162:g3#y2024")) { origin case_input; }
        assert "f1": antitrust_damages_or_settlement_payment(entity_ref("urn:test:s162:g3#p"), entity_ref("urn:test:s162:g3#y2024"), 1, 100.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s162:g3#p"), entity_ref("urn:test:s162:g3#y2024"), Section162TradeOrBusiness, 66.67 USD));
    expect truth_status == FALSE_ONLY;
}
