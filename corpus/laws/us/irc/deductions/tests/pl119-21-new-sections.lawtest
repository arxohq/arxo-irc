// New Pub. L. 119-21 sections (224 tips, 225 overtime, 163(h)(4) car loan
// interest) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S224-01-TIPS-UNDER-CAP-NO-PHASEOUT" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_tips_received(entity_ref("urn:test:s224:v1#p"), entity_ref("urn:test:s224:v1#y2025"), 15000.00 USD) { origin case_input; }
        assert "f1": modified_adjusted_gross_income_pl119_21(entity_ref("urn:test:s224:v1#p"), entity_ref("urn:test:s224:v1#y2025"), 80000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_tips_deduction(entity_ref("urn:test:s224:v1#p"), entity_ref("urn:test:s224:v1#y2025"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "tips under the $25,000 cap and below the $150,000 MAGI threshold are fully deductible (new section 224)";
}

test "S224-02-TIPS-CAPPED-AND-PHASED-OUT" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_tips_received(entity_ref("urn:test:s224:v2#p"), entity_ref("urn:test:s224:v2#y2025"), 30000.00 USD) { origin case_input; }
        assert "f1": modified_adjusted_gross_income_pl119_21(entity_ref("urn:test:s224:v2#p"), entity_ref("urn:test:s224:v2#y2025"), 155000.00 USD) { origin case_input; }
    }
    // cap: 25,000; excess over 150,000 is 5,000 -> 5 * $100 = 500 reduction.
    evaluate truth(qualified_tips_deduction(entity_ref("urn:test:s224:v2#p"), entity_ref("urn:test:s224:v2#y2025"), 24500.00 USD));
    expect truth_status == TRUE_ONLY;
    description "tips above the $25,000 cap are capped first, then reduced $100 per $1,000 of MAGI over $150,000 (new section 224(b))";
}

test "S224-03-OUTSIDE-WINDOW-2029-NEITHER" {
    given {
        context {
            legal_time @2029-04-15;
            decision_time @2029-04-15T09:00:00-05:00;
            knowledge_time @2029-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_tips_received(entity_ref("urn:test:s224:v3#p"), entity_ref("urn:test:s224:v3#y2029"), 15000.00 USD) { origin case_input; }
        assert "f1": modified_adjusted_gross_income_pl119_21(entity_ref("urn:test:s224:v3#p"), entity_ref("urn:test:s224:v3#y2029"), 80000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_tips_deduction(entity_ref("urn:test:s224:v3#p"), entity_ref("urn:test:s224:v3#y2029"), 15000.00 USD));
    expect truth_status == NEITHER;
    description "the section 224 deduction terminates for taxable years beginning after December 31, 2028";
}

test "S225-01-OVERTIME-JOINT-CAP-25000" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s225:v1#p"), entity_ref("urn:test:s225:v1#y2025"), us.irc.income_individual::Joint) { origin case_input; }
        assert "f1": qualified_overtime_compensation_received(entity_ref("urn:test:s225:v1#p"), entity_ref("urn:test:s225:v1#y2025"), 30000.00 USD) { origin case_input; }
        assert "f2": modified_adjusted_gross_income_pl119_21(entity_ref("urn:test:s225:v1#p"), entity_ref("urn:test:s225:v1#y2025"), 250000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_overtime_deduction(entity_ref("urn:test:s225:v1#p"), entity_ref("urn:test:s225:v1#y2025"), 25000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "a joint return's overtime deduction caps at $25,000 and phases out from $300,000 MAGI (new section 225)";
}

test "S225-02-OVERTIME-SINGLE-CAP-12500" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s225:v2#p"), entity_ref("urn:test:s225:v2#y2025"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": qualified_overtime_compensation_received(entity_ref("urn:test:s225:v2#p"), entity_ref("urn:test:s225:v2#y2025"), 5000.00 USD) { origin case_input; }
        assert "f2": modified_adjusted_gross_income_pl119_21(entity_ref("urn:test:s225:v2#p"), entity_ref("urn:test:s225:v2#y2025"), 80000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_overtime_deduction(entity_ref("urn:test:s225:v2#p"), entity_ref("urn:test:s225:v2#y2025"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "a single filer's overtime compensation under both the $12,500 cap and the $150,000 threshold is fully deductible";
}

test "S163H4-01-CAR-LOAN-INTEREST-SINGLE-UNDER-CAP" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s163h4:v1#p"), entity_ref("urn:test:s163h4:v1#y2025"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": qualified_passenger_vehicle_loan_interest_paid_or_accrued(entity_ref("urn:test:s163h4:v1#p"), entity_ref("urn:test:s163h4:v1#y2025"), 4000.00 USD) { origin case_input; }
        assert "f2": modified_adjusted_gross_income_pl119_21(entity_ref("urn:test:s163h4:v1#p"), entity_ref("urn:test:s163h4:v1#y2025"), 80000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_passenger_vehicle_loan_interest_deduction(entity_ref("urn:test:s163h4:v1#p"), entity_ref("urn:test:s163h4:v1#y2025"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "qualified passenger vehicle loan interest under the $10,000 cap and below the $100,000 MAGI threshold is fully deductible (section 163(h)(4))";
}

test "S163H4-02-CAR-LOAN-INTEREST-CAPPED-AND-PHASED-OUT-JOINT" {
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s163h4:v2#p"), entity_ref("urn:test:s163h4:v2#y2025"), us.irc.income_individual::Joint) { origin case_input; }
        assert "f1": qualified_passenger_vehicle_loan_interest_paid_or_accrued(entity_ref("urn:test:s163h4:v2#p"), entity_ref("urn:test:s163h4:v2#y2025"), 12000.00 USD) { origin case_input; }
        assert "f2": modified_adjusted_gross_income_pl119_21(entity_ref("urn:test:s163h4:v2#p"), entity_ref("urn:test:s163h4:v2#y2025"), 210000.00 USD) { origin case_input; }
    }
    // cap 10,000; excess over 200,000 is 10,000 -> 10 * $200 = 2,000 reduction.
    evaluate truth(qualified_passenger_vehicle_loan_interest_deduction(entity_ref("urn:test:s163h4:v2#p"), entity_ref("urn:test:s163h4:v2#y2025"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "on a joint return, interest above $10,000 is capped, then reduced $200 per $1,000 of MAGI over $200,000 (section 163(h)(4)(C))";
}
