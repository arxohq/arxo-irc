// Section 280F scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S280F-01-FIRST-YEAR-DEPRECIATION-CAPPED-AT-TEN-THOUSAND" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": depreciation_deduction_before_280f_cap(entity_ref("urn:test:s280f:a1#p"), entity_ref("urn:test:s280f:a1#y2024"), 1, 1, 15000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280f:a1#p"), entity_ref("urn:test:s280f:a1#y2024"), Section262PersonalNonDeductible, 5000 USD));
    expect truth_status == FALSE_ONLY;
    description "before-cap depreciation of 15,000 exceeds the $10,000 first-year cap; the 5,000 excess is the amount this module marks not-allowed";
}

test "S280F-02-FIRST-YEAR-DEPRECIATION-WITHIN-CAP-NO-DISALLOWANCE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": depreciation_deduction_before_280f_cap(entity_ref("urn:test:s280f:a2#p"), entity_ref("urn:test:s280f:a2#y2024"), 1, 1, 8000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280f:a2#p"), entity_ref("urn:test:s280f:a2#y2024"), Section262PersonalNonDeductible, 0 USD));
    expect truth_status == NEITHER;
}

test "S280F-03-SUCCEEDING-YEAR-CAPPED-AT-5760" {
    given {
        context {
            legal_time @2027-04-15;
            decision_time @2027-04-15T09:00:00-05:00;
            knowledge_time @2027-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": depreciation_deduction_before_280f_cap(entity_ref("urn:test:s280f:a3#p"), entity_ref("urn:test:s280f:a3#y2027"), 1, 4, 7000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280f:a3#p"), entity_ref("urn:test:s280f:a3#y2027"), Section262PersonalNonDeductible, 1240 USD));
    expect truth_status == FALSE_ONLY;
}
