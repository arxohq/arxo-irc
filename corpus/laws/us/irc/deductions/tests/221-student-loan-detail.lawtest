        assert "f1": section_221b2_dollar_amount_unindexed(50000.00 USD) { origin case_input; }
        assert "f2": cost_of_living_adjustment_221_base_2001(entity_ref("urn:test:s221-41#y"),0.5273) { origin case_input; }
    }
