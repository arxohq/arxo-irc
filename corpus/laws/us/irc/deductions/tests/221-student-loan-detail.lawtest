        }
        assert "f0": married_at_close_of_taxable_year_221(entity_ref("urn:test:s221-39#p"),entity_ref("urn:test:s221-39#y")) { origin case_input; }
        assert "f1": qualified_education_loan_interest_paid(entity_ref("urn:test:s221-39#p"),entity_ref("urn:test:s221-39#y"),1800.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s221-39#p"),entity_ref("urn:test:s221-39#y"),Section221StudentLoanInterest,1800.00 USD));
    expect truth_status == FALSE_ONLY;
    description "(e)(2): a married taxpayer without a joint return has no deduction";
}

test "S221-40-MARRIED-JOINT-RETURN-NOT-DENIED" {
    given {
        context {
            legal_time @2025-06-30;
