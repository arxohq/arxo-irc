test "S221-36-DOUBLE-BENEFIT-REDUCTION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": education_loan_incurred_by_taxpayer(entity_ref("urn:test:s221-36#p"),1) { origin case_input; }
        assert "f1": loan_incurred_solely_to_pay_qualified_higher_education_expenses(1) { origin case_input; }
        assert "f2": expenses_incurred_on_behalf_of_taxpayer_spouse_or_dependent_when_loan_incurred(1) { origin case_input; }
        assert "f3": expenses_paid_within_reasonable_period_of_loan(1) { origin adjudicated; }
        assert "f4": education_furnished_while_recipient_eligible_student(1) { origin case_input; }
        assert "f5": interest_paid_on_education_loan(entity_ref("urn:test:s221-36#p"),entity_ref("urn:test:s221-36#y"),1,2000.00 USD) { origin case_input; }
        assert "f6": amount_deductible_under_other_provision_of_chapter_1(entity_ref("urn:test:s221-36#p"),entity_ref("urn:test:s221-36#y"),300.00 USD) { origin case_input; }
        assert "f7": employer_payment_of_loan_excluded_under_127(entity_ref("urn:test:s221-36#p"),entity_ref("urn:test:s221-36#y"),500.00 USD) { origin case_input; }
        assert "f8": section_529c9_distribution_treated_as_qualified_expense_reduction(entity_ref("urn:test:s221-36#p"),entity_ref("urn:test:s221-36#y"),0.00 USD) { origin case_input; }
    }
    evaluate truth(student_loan_interest_after_double_benefit_denial(entity_ref("urn:test:s221-36#p"),entity_ref("urn:test:s221-36#y"),1200.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(e)(1): amounts deductible elsewhere and the section 127 exclusion are removed";
}

