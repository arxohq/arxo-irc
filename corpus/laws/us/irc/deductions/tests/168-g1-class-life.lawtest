test "S168G1-08-CATCH-ALL-NO-CLASS-LIFE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_has_no_class_life(entity_ref("urn:test:s168g1:v08#a")) { origin case_input; }
        assert "f1": asset_not_otherwise_classified_168e(entity_ref("urn:test:s168g1:v08#a")) { origin case_input; }
    }
    evaluate truth(gds_class_from_class_life(entity_ref("urn:test:s168g1:v08#a"), SevenYearProperty));
    expect truth_status == TRUE_ONLY;
    description "section 168(e)(3)(C)(v): property with no class life, not otherwise classified, is 7-year property";
}

test "S168G1-09-CATCH-ALL-BLOCKED-BY-OTHER-CLASSIFICATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_has_no_class_life(entity_ref("urn:test:s168g1:v09#a")) { origin case_input; }
    }
    // The (II) element is not cased, so the catch-all does not fire; absence
    // of the element gives NEITHER, not a false 7-year derivation.
    evaluate truth(gds_class_from_class_life(entity_ref("urn:test:s168g1:v09#a"), SevenYearProperty));
    expect truth_status == NEITHER;
    description "section 168(e)(3)(C)(v)(II): without the not-otherwise-classified element the catch-all yields NEITHER";
}

test "S168G1-10-BELOW-27-POINT-5-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_is_section1250_property(entity_ref("urn:test:s168g1:v10#a")) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v10#a"), 27.4) { origin case_input; }
    }
    evaluate truth(excluded_from_nonresidential_real_by_class_life(entity_ref("urn:test:s168g1:v10#a")));
    expect truth_status == TRUE_ONLY;
    description "section 168(e)(2)(B)(ii): section 1250 property with class life 27.4 years is excluded from nonresidential real property";
}

test "S168G1-11-AT-27-POINT-5-NOT-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_is_section1250_property(entity_ref("urn:test:s168g1:v11#a")) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v11#a"), 27.5) { origin case_input; }
    }
    // 27.5 is not "less than 27.5": the exclusion does not fire (NEITHER).
    evaluate truth(excluded_from_nonresidential_real_by_class_life(entity_ref("urn:test:s168g1:v11#a")));
    expect truth_status == NEITHER;
    description "section 168(e)(2)(B)(ii) boundary: class life of exactly 27.5 years is not 'less than 27.5 years'";
}

test "S168G1-12-ADS-EQUALS-CLASS-LIFE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_class_life_years(entity_ref("urn:test:s168g1:v12#a"), 12.5) { origin case_input; }
    }
    evaluate truth(ads_recovery_period_years(entity_ref("urn:test:s168g1:v12#a"), 12.5));
    expect truth_status == TRUE_ONLY;
    description "ADS table clause (i): the ADS recovery period is the class life (12.5 years in)";
}

test "S168G1-13-ADS-PERSONAL-NO-CLASS-LIFE-TWELVE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_is_personal_property(entity_ref("urn:test:s168g1:v13#a")) { origin case_input; }
        assert "f1": asset_has_no_class_life(entity_ref("urn:test:s168g1:v13#a")) { origin case_input; }
    }
    evaluate truth(ads_recovery_period_years(entity_ref("urn:test:s168g1:v13#a"), 12.0));
    expect truth_status == TRUE_ONLY;
    description "ADS table clause (ii): personal property with no class life has a 12-year ADS recovery period";
}

test "S168G1-14-ADS-1245-REAL-NO-CLASS-LIFE-FORTY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_is_section1245_real_property(entity_ref("urn:test:s168g1:v14#a")) { origin case_input; }
        assert "f1": asset_has_no_class_life(entity_ref("urn:test:s168g1:v14#a")) { origin case_input; }
    }
    evaluate truth(ads_recovery_period_years(entity_ref("urn:test:s168g1:v14#a"), 40.0));
    expect truth_status == TRUE_ONLY;
    description "section 168(g)(3)(E): section 1245 real property with no class life has a 40-year ADS recovery period";
}

test "S168G1-15-SHORT-TERM-LEASE-THIRTY-PERCENT-BRANCH" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_lease_term_years(entity_ref("urn:test:s168g1:v15#a"), 2.5) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v15#a"), 10.0) { origin case_input; }
    }
    // (I): 2.5 < 3. (II): greater of 1 year or 30% of 10 (= 3.0) is 3.0;
    // 2.5 < 3.0. Both elements met: short-term lease.
    evaluate truth(short_term_lease_168h(entity_ref("urn:test:s168g1:v15#a")));
    expect truth_status == TRUE_ONLY;
    description "section 168(h)(1)(C)(ii): 2.5-year lease on 10-year class life property is a short-term lease (30-percent branch governs)";
}

test "S168G1-16-THREE-YEAR-LEASE-NOT-SHORT-TERM" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_lease_term_years(entity_ref("urn:test:s168g1:v16#a"), 3.0) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v16#a"), 10.0) { origin case_input; }
    }
    // 3.0 is not "less than 3 years": (I) fails, NEITHER.
    evaluate truth(short_term_lease_168h(entity_ref("urn:test:s168g1:v16#a")));
    expect truth_status == NEITHER;
    description "section 168(h)(1)(C)(ii)(I) boundary: a lease of exactly 3 years is not a short-term lease";
}

test "S168G1-17-SHORT-TERM-LEASE-ONE-YEAR-BRANCH" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_lease_term_years(entity_ref("urn:test:s168g1:v17#a"), 0.9) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v17#a"), 2.0) { origin case_input; }
    }
    // (II): greater of 1 year or 30% of 2 (= 0.6) is 1.0; 0.9 < 1.0 and
    // 0.9 < 3. Short-term lease via the 1-year branch.
    evaluate truth(short_term_lease_168h(entity_ref("urn:test:s168g1:v17#a")));
    expect truth_status == TRUE_ONLY;
    description "section 168(h)(1)(C)(ii): 0.9-year lease on 2-year class life property is a short-term lease (1-year branch governs)";
}

test "S168G1-18-ONE-YEAR-LEASE-NOT-SHORT-TERM" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_lease_term_years(entity_ref("urn:test:s168g1:v18#a"), 1.0) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v18#a"), 2.0) { origin case_input; }
    }
    // (II): greater is 1.0; 1.0 is not less than 1.0: NEITHER.
    evaluate truth(short_term_lease_168h(entity_ref("urn:test:s168g1:v18#a")));
    expect truth_status == NEITHER;
    description "section 168(h)(1)(C)(ii)(II) boundary: 1.0-year lease where the greater is 1 year is not short-term";
}

test "S168G1-19-WAIVED-CLAUSE-II-NONRESIDENTIAL" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_is_nonresidential_real_property(entity_ref("urn:test:s168g1:v19#a")) { origin case_input; }
        assert "f1": asset_lease_term_years(entity_ref("urn:test:s168g1:v19#a"), 2.5) { origin case_input; }
    }
    // Subclause (II) does not apply (last sentence); (I) alone (2.5 < 3)
    // makes it a short-term lease.
    evaluate truth(short_term_lease_168h(entity_ref("urn:test:s168g1:v19#a")));
    expect truth_status == TRUE_ONLY;
    description "section 168(h)(1)(C)(ii), last sentence: nonresidential real property with a 2.5-year lease is short-term via clause (I) alone";
}

test "S168G1-20-WAIVED-BUT-LONG-LEASE-NOT-SHORT-TERM" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_is_nonresidential_real_property(entity_ref("urn:test:s168g1:v20#a")) { origin case_input; }
        assert "f1": asset_lease_term_years(entity_ref("urn:test:s168g1:v20#a"), 3.5) { origin case_input; }
    }
    // (II) waived but (I) fails (3.5 is not less than 3): NEITHER.
    evaluate truth(short_term_lease_168h(entity_ref("urn:test:s168g1:v20#a")));
    expect truth_status == NEITHER;
    description "section 168(h)(1)(C)(ii): waiver of (II) does not save a 3.5-year lease";
}

test "S168G1-21-SMART-GRID-SIXTEEN-YEAR-LIFE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_claimed_smart_meter_or_grid(entity_ref("urn:test:s168g1:v21#a")) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v21#a"), 16.0) { origin case_input; }
    }
    evaluate truth(meets_smart_grid_class_life_test(entity_ref("urn:test:s168g1:v21#a")));
    expect truth_status == TRUE_ONLY;
    description "section 168(i)(18)/(19)(A)(ii) boundary: class life of exactly 16 years is not 'less than 16 years'";
}

test "S168G1-22-SMART-GRID-BELOW-SIXTEEN-FAILS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_claimed_smart_meter_or_grid(entity_ref("urn:test:s168g1:v22#a")) { origin case_input; }
        assert "f1": asset_class_life_years(entity_ref("urn:test:s168g1:v22#a"), 15.9) { origin case_input; }
    }
    // 15.9 is a class life of less than 16 years and the asset has one, so
    // neither branch fires: NEITHER.
    evaluate truth(meets_smart_grid_class_life_test(entity_ref("urn:test:s168g1:v22#a")));
    expect truth_status == NEITHER;
    description "section 168(i)(18)/(19)(A)(ii): class life of 15.9 years fails the 16-year element";
}

test "S168G1-23-TABLE-PATH-PINNED-CLASS-GIVES-LIFE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_class_8756(entity_ref("urn:test:s168g1:v23#a"), "00.11") { origin case_input; }
    }
    // No asset_class_life_years case fact: only the pinned-table path can fire.
    evaluate truth(asset_class_life_years(entity_ref("urn:test:s168g1:v23#a"), 10.0));
    expect truth_status == TRUE_ONLY;
    description "section 168(i)(1) table path: pinned Rev. Proc. 87-56 class 00.11 resolves to a 10-year life";
}

test "S168G1-24-TABLE-PATH-UNKNOWN-CLASS-GIVES-NOTHING" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_class_8756(entity_ref("urn:test:s168g1:v24#a"), "99.99") { origin case_input; }
    }
    evaluate truth(asset_class_life_years(entity_ref("urn:test:s168g1:v24#a"), 10.0));
    expect truth_status == NEITHER;
    description "section 168(i)(1) table path: unpinned class code resolves to no life";
}
