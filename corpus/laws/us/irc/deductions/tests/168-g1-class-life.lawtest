// Section 168 G1 class-life wiring scenarios (module 168-g1-class-life.law).
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF): every number in
// `given` is a case fact on the AFR pattern (the Rev. Proc. 87-56 value the
// case applies), every number in `evaluate`/`then` is a statutory threshold.
// Boundary pairs: just below / exactly at each class-life threshold.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S168G1-01-CLASS-LIFE-DEFINITION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_class_life_years(entity_ref("urn:test:s168g1:v01#a"), 7.0) { origin case_input; }
    }
    evaluate truth(class_life_years(entity_ref("urn:test:s168g1:v01#a"), 7.0));
    expect truth_status == TRUE_ONLY;
    description "section 168(i)(1): the cased Rev. Proc. 87-56 class life is the section 168 class life (intermediate value)";
}

test "S168G1-02-T2-FOUR-YEARS-IS-THREE-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_class_life_years(entity_ref("urn:test:s168g1:v02#a"), 4.0) { origin case_input; }
    }
    evaluate truth(gds_class_from_class_life(entity_ref("urn:test:s168g1:v02#a"), ThreeYearProperty));
    expect truth_status == TRUE_ONLY;
    description "T2 boundary: class life of exactly 4 years ('4 or less') is 3-year property";
}

test "S168G1-03-T2-JUST-ABOVE-FOUR-IS-FIVE-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_class_life_years(entity_ref("urn:test:s168g1:v03#a"), 4.01) { origin case_input; }
    }
    evaluate truth(gds_class_from_class_life(entity_ref("urn:test:s168g1:v03#a"), FiveYearProperty));
    expect truth_status == TRUE_ONLY;
    description "T2 boundary: class life just above 4 years ('more than 4 but less than 10') is 5-year property";
}

test "S168G1-04-T2-JUST-BELOW-TEN-IS-FIVE-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": asset_class_life_years(entity_ref("urn:test:s168g1:v04#a"), 9.99) { origin case_input; }
    }
    evaluate truth(gds_class_from_class_life(entity_ref("urn:test:s168g1:v04#a"), FiveYearProperty));
    expect truth_status == TRUE_ONLY;
    description "T2 boundary: class life just below 10 years is still 5-year property";
}

