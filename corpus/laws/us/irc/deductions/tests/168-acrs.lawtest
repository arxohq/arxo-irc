// Section 168 (MACRS) scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF): status vocabulary follows the "learned from the first
// executed runs" note (TRUE_ONLY/FALSE_ONLY/BOTH/NEITHER, no UNDETERMINED).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S168-01-RECOVERY-PERIOD-FIVE-YEAR-PROPERTY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_classified_as(entity_ref("urn:test:s168:v1#p"), entity_ref("urn:test:s168:v1#a"), FiveYearProperty) { origin case_input; }
    }
    evaluate truth(applicable_recovery_period_years(entity_ref("urn:test:s168:v1#p"), entity_ref("urn:test:s168:v1#a"), 5.0));
    expect truth_status == TRUE_ONLY;
    description "5-year property has a 5-year applicable recovery period under the section 168(c) table (intermediate value, not the final deduction)";
}

test "S168-02-RECOVERY-PERIOD-NONRESIDENTIAL-CLASS-NOT-MODELLED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": unadjusted_depreciable_basis(entity_ref("urn:test:s168:v2#p"), entity_ref("urn:test:s168:v2#a"), entity_ref("urn:test:s168:v2#y2024"), 100000 USD) { origin case_input; }
    }
    // No `property_classified_as` fact for a real-property class is asserted
    // (the module does not model the 25/27.5/39/50-year classes or the
    // mid-month convention) — absence of the fact gives NEITHER, not a
    // false deduction.
    evaluate truth(depreciation_deduction(entity_ref("urn:test:s168:v2#p"), entity_ref("urn:test:s168:v2#a"), entity_ref("urn:test:s168:v2#y2024"), 2564.00 USD));
    expect truth_status == NEITHER;
    description "TECH_GAP: nonresidential real property's year-1 amount under the mid-month convention is not computed by this module";
}

test "S168-03-YEAR1-FIVE-YEAR-PROPERTY-200-PERCENT-DB-HALF-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_classified_as(entity_ref("urn:test:s168:v3#p"), entity_ref("urn:test:s168:v3#a"), FiveYearProperty) { origin case_input; }
        assert "f1": placed_in_service_year(entity_ref("urn:test:s168:v3#p"), entity_ref("urn:test:s168:v3#a"), entity_ref("urn:test:s168:v3#y2024")) { origin case_input; }
        assert "f2": unadjusted_depreciable_basis(entity_ref("urn:test:s168:v3#p"), entity_ref("urn:test:s168:v3#a"), entity_ref("urn:test:s168:v3#y2024"), 100000.00 USD) { origin case_input; }
        assert "f3": aggregate_basis_placed_in_service_year(entity_ref("urn:test:s168:v3#p"), entity_ref("urn:test:s168:v3#y2024"), 100000.00 USD) { origin case_input; }
        assert "f4": aggregate_basis_placed_in_service_last_quarter(entity_ref("urn:test:s168:v3#p"), entity_ref("urn:test:s168:v3#y2024"), 10000.00 USD) { origin case_input; }
    }
    // Default method (no election), default convention (last-quarter basis
    // 10,000 is 10% of 100,000, under the 40% mid-quarter threshold, so
    // half-year applies): 100,000 * 20% = 20,000.00.
    evaluate truth(depreciation_deduction(entity_ref("urn:test:s168:v3#p"), entity_ref("urn:test:s168:v3#a"), entity_ref("urn:test:s168:v3#y2024"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "year-1 depreciation for 5-year property, 200% declining balance, half-year convention: basis * 20% (section 168(a)-(d))";
}

test "S168-04-MID-QUARTER-CONVENTION-APPLIES-BLOCKS-HALF-YEAR-RULE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": aggregate_basis_placed_in_service_year(entity_ref("urn:test:s168:v4#p"), entity_ref("urn:test:s168:v4#y2024"), 100000.00 USD) { origin case_input; }
        assert "f1": aggregate_basis_placed_in_service_last_quarter(entity_ref("urn:test:s168:v4#p"), entity_ref("urn:test:s168:v4#y2024"), 50000.00 USD) { origin case_input; }
    }
    // Last-quarter basis 50,000 exceeds 40% of 100,000 (40,000): the
    // mid-quarter convention applies for the year, so the half-year
    // convention does NOT apply (the `unless` blocks it).
    evaluate truth(applicable_convention_for_year(entity_ref("urn:test:s168:v4#p"), entity_ref("urn:test:s168:v4#y2024"), HalfYearConvention));
    expect truth_status == NEITHER;
    description "when the 40% last-quarter test is met, the mid-quarter convention applies instead of the half-year default (section 168(d)(1),(3))";
}

test "S168-05-MID-QUARTER-CONVENTION-DETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": aggregate_basis_placed_in_service_year(entity_ref("urn:test:s168:v5#p"), entity_ref("urn:test:s168:v5#y2024"), 100000.00 USD) { origin case_input; }
        assert "f1": aggregate_basis_placed_in_service_last_quarter(entity_ref("urn:test:s168:v5#p"), entity_ref("urn:test:s168:v5#y2024"), 50000.00 USD) { origin case_input; }
    }
    evaluate truth(applicable_convention_for_year(entity_ref("urn:test:s168:v5#p"), entity_ref("urn:test:s168:v5#y2024"), MidQuarterConvention));
    expect truth_status == TRUE_ONLY;
    description "the mid-quarter convention itself is concluded once the 40% last-quarter test is met (section 168(d)(3)(A))";
}

test "S168-06-FIFTEEN-YEAR-PROPERTY-DEFAULT-150-PERCENT-DB" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_classified_as(entity_ref("urn:test:s168:v6#p"), entity_ref("urn:test:s168:v6#a"), FifteenYearProperty) { origin case_input; }
    }
    evaluate truth(applicable_depreciation_method(entity_ref("urn:test:s168:v6#p"), entity_ref("urn:test:s168:v6#a"), DecliningBalance150));
    expect truth_status == TRUE_ONLY;
    description "15-year property defaults to the 150% declining balance method absent a straight-line election (section 168(b)(2)(A))";
}

test "S168-07-ELECTED-150-PERCENT-OVERRIDES-DEFAULT-200-PERCENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_classified_as(entity_ref("urn:test:s168:v7#p"), entity_ref("urn:test:s168:v7#a"), FiveYearProperty) { origin case_input; }
        assert "f1": elects_150_percent_declining_balance(entity_ref("urn:test:s168:v7#p"), entity_ref("urn:test:s168:v7#a")) { origin case_input; }
    }
    evaluate truth(applicable_depreciation_method(entity_ref("urn:test:s168:v7#p"), entity_ref("urn:test:s168:v7#a"), DoubleDecliningBalance200));
    expect truth_status == NEITHER;
    description "a section 168(b)(2)(C) election to the 150% method for the class displaces the 200% default (the `unless` on the default rule)";
}

test "S168-08-ELECTED-150-PERCENT-CONCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_classified_as(entity_ref("urn:test:s168:v8#p"), entity_ref("urn:test:s168:v8#a"), FiveYearProperty) { origin case_input; }
        assert "f1": elects_150_percent_declining_balance(entity_ref("urn:test:s168:v8#p"), entity_ref("urn:test:s168:v8#a")) { origin case_input; }
    }
    evaluate truth(applicable_depreciation_method(entity_ref("urn:test:s168:v8#p"), entity_ref("urn:test:s168:v8#a"), DecliningBalance150));
    expect truth_status == TRUE_ONLY;
    description "the elected 150% declining balance method is concluded for the class once elected (section 168(b)(2)(C))";
}

test "S168-09-UNKNOWN-CLASSIFICATION-YIELDS-NEITHER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": unadjusted_depreciable_basis(entity_ref("urn:test:s168:v9#p"), entity_ref("urn:test:s168:v9#a"), entity_ref("urn:test:s168:v9#y2024"), 50000.00 USD) { origin case_input; }
        assert "f1": placed_in_service_year(entity_ref("urn:test:s168:v9#p"), entity_ref("urn:test:s168:v9#a"), entity_ref("urn:test:s168:v9#y2024")) { origin case_input; }
    }
    // No classification asserted at all: an unknown key fact gives NEITHER,
    // not a wrong amount.
    evaluate truth(depreciation_deduction(entity_ref("urn:test:s168:v9#p"), entity_ref("urn:test:s168:v9#a"), entity_ref("urn:test:s168:v9#y2024"), 10000.00 USD));
    expect truth_status == NEITHER;
    description "with no section 168(e) classification asserted, the year-1 amount is NEITHER (open-world), not zero and not a guessed class";
}

test "S168-10-YEAR1-TEN-YEAR-PROPERTY-200-PERCENT-DB-HALF-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_classified_as(entity_ref("urn:test:s168:v10#p"), entity_ref("urn:test:s168:v10#a"), TenYearProperty) { origin case_input; }
        assert "f1": placed_in_service_year(entity_ref("urn:test:s168:v10#p"), entity_ref("urn:test:s168:v10#a"), entity_ref("urn:test:s168:v10#y2024")) { origin case_input; }
        assert "f2": unadjusted_depreciable_basis(entity_ref("urn:test:s168:v10#p"), entity_ref("urn:test:s168:v10#a"), entity_ref("urn:test:s168:v10#y2024"), 40000.00 USD) { origin case_input; }
        assert "f3": aggregate_basis_placed_in_service_year(entity_ref("urn:test:s168:v10#p"), entity_ref("urn:test:s168:v10#y2024"), 40000.00 USD) { origin case_input; }
        assert "f4": aggregate_basis_placed_in_service_last_quarter(entity_ref("urn:test:s168:v10#p"), entity_ref("urn:test:s168:v10#y2024"), 0.00 USD) { origin case_input; }
    }
    // 40,000 * 10% = 4,000.00.
    evaluate truth(depreciation_deduction(entity_ref("urn:test:s168:v10#p"), entity_ref("urn:test:s168:v10#a"), entity_ref("urn:test:s168:v10#y2024"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "year-1 depreciation for 10-year property, 200% declining balance, half-year convention: basis * 10% (section 168(a)-(d))";
}
