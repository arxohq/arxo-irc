test "S164-30-LOCAL-BENEFIT-TAX-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tax_paid_or_accrued(entity_ref("urn:test:s164-30#p"),entity_ref("urn:test:s164-30#y"),1,RealPropertyTax,1000.00 USD) { origin case_input; }
        assert "f1": tax_assessed_against_local_benefits(1) { origin case_input; }
        assert "f2": local_benefit_tax_portion_for_maintenance_or_interest(1,0.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s164-30#p"),entity_ref("urn:test:s164-30#y"),Section164Taxes,1000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "(c)(1): a local benefit tax is not deductible";
}

