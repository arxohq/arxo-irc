        }
        assert "f0": real_property_tax_for_tax_year(1,3650.00 USD) { origin case_input; }
        assert "f1": real_property_tax_year_first_day(1,@2025-01-01) { origin case_input; }
        assert "f2": real_property_tax_year_last_day(1,@2025-12-31) { origin case_input; }
