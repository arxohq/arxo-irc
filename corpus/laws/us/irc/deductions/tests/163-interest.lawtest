// Section 163 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S163-01-QUALIFIED-RESIDENCE-INTEREST-WITHIN-750K-LIMIT-2024" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s163:h1#p"), entity_ref("urn:test:s163:h1#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f1": qualified_residence_interest_item(entity_ref("urn:test:s163:h1#p"), entity_ref("urn:test:s163:h1#y2024"), 1, 18000 USD) { origin case_input; }
        assert "f2": acquisition_indebtedness_outstanding(entity_ref("urn:test:s163:h1#p"), entity_ref("urn:test:s163:h1#y2024"), 600000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s163:h1#p"), entity_ref("urn:test:s163:h1#y2024"), Section163Interest, 18000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S163-02-INVESTMENT-INTEREST-LIMITED-TO-NET-INVESTMENT-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": investment_interest_paid(entity_ref("urn:test:s163:d1#p"), entity_ref("urn:test:s163:d1#y2024"), 10000 USD) { origin case_input; }
        assert "f1": net_investment_income(entity_ref("urn:test:s163:d1#p"), entity_ref("urn:test:s163:d1#y2024"), 6000 USD) { origin case_input; }
    }
    evaluate truth(investment_interest_allowed(entity_ref("urn:test:s163:d1#p"), entity_ref("urn:test:s163:d1#y2024"), 6000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S163-03-BUSINESS-INTEREST-LIMITED-TO-THIRTY-PERCENT-ATI" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": business_interest_paid(entity_ref("urn:test:s163:j1#p"), entity_ref("urn:test:s163:j1#y2024"), 500000 USD) { origin case_input; }
        assert "f1": business_interest_income(entity_ref("urn:test:s163:j1#p"), entity_ref("urn:test:s163:j1#y2024"), 0 USD) { origin case_input; }
        assert "f2": floor_plan_financing_interest(entity_ref("urn:test:s163:j1#p"), entity_ref("urn:test:s163:j1#y2024"), 0 USD) { origin case_input; }
        assert "f3": adjusted_taxable_income_before_depreciation_addback(entity_ref("urn:test:s163:j1#p"), entity_ref("urn:test:s163:j1#y2024"), 1000000 USD) { origin case_input; }
        assert "f4": depreciation_amortization_depletion_deduction(entity_ref("urn:test:s163:j1#p"), entity_ref("urn:test:s163:j1#y2024"), 0 USD) { origin case_input; }
    }
    // 2024 is within the EBIT-only window (2022-2024): ATI = 1,000,000; 30% = 300,000.
    evaluate truth(business_interest_allowed(entity_ref("urn:test:s163:j1#p"), entity_ref("urn:test:s163:j1#y2024"), 300000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S163-04-BUSINESS-INTEREST-SMALL-BUSINESS-EXEMPTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": meets_gross_receipts_test_448c(entity_ref("urn:test:s163:j2#p"), entity_ref("urn:test:s163:j2#y2024")) { origin case_input; }
        assert "f1": business_interest_paid(entity_ref("urn:test:s163:j2#p"), entity_ref("urn:test:s163:j2#y2024"), 40000 USD) { origin case_input; }
    }
    evaluate truth(business_interest_allowed(entity_ref("urn:test:s163:j2#p"), entity_ref("urn:test:s163:j2#y2024"), 40000 USD));
    expect truth_status == TRUE_ONLY;
}
