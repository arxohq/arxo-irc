// Section 219 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S219-01-CONTRIBUTION-WITHIN-LIMIT-FULLY-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ira_contribution(entity_ref("urn:test:s219:a1#p"), entity_ref("urn:test:s219:a1#y2024"), 4000 USD) { origin case_input; }
        assert "f1": compensation_includible_in_gross_income(entity_ref("urn:test:s219:a1#p"), entity_ref("urn:test:s219:a1#y2024"), 60000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s219:a1#p"), entity_ref("urn:test:s219:a1#y2024"), Section219Ira, 4000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S219-02-AGE-FIFTY-CATCH-UP-CONTRIBUTION-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ira_contribution(entity_ref("urn:test:s219:a2#p"), entity_ref("urn:test:s219:a2#y2024"), 5800 USD) { origin case_input; }
        assert "f1": compensation_includible_in_gross_income(entity_ref("urn:test:s219:a2#p"), entity_ref("urn:test:s219:a2#y2024"), 60000 USD) { origin case_input; }
        assert "f2": attained_age_fifty_before_close_of_year(entity_ref("urn:test:s219:a2#p"), entity_ref("urn:test:s219:a2#y2024")) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s219:a2#p"), entity_ref("urn:test:s219:a2#y2024"), Section219Ira, 5800 USD));
    expect truth_status == TRUE_ONLY;
}

test "S219-03-ACTIVE-PARTICIPANT-BELOW-APPLICABLE-DOLLAR-AMOUNT-FULL-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": active_participant_in_employer_plan(entity_ref("urn:test:s219:g1#p"), entity_ref("urn:test:s219:g1#y2024")) { origin case_input; }
        assert "f1": modified_agi_for_219(entity_ref("urn:test:s219:g1#p"), entity_ref("urn:test:s219:g1#y2024"), 40000 USD) { origin case_input; }
        assert "f2": section_219g_applicable_dollar_amount(entity_ref("urn:test:s219:g1#p"), entity_ref("urn:test:s219:g1#y2024"), us.irc.income_individual::Unmarried, 50000 USD) { origin case_input; }
        assert "f3": us.irc.income_individual::filing_status(entity_ref("urn:test:s219:g1#p"), entity_ref("urn:test:s219:g1#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f4": ira_contribution(entity_ref("urn:test:s219:g1#p"), entity_ref("urn:test:s219:g1#y2024"), 5000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s219:g1#p"), entity_ref("urn:test:s219:g1#y2024"), Section219Ira, 5000 USD));
    expect truth_status == TRUE_ONLY;
    description "AGI (40,000) does not exceed the applicable dollar amount (50,000): the active-participant phase-out of section 219(g) does not reduce the deduction";
}

test "S219-04-ACTIVE-PARTICIPANT-ABOVE-FLOOR-PLUS-RANGE-NO-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": active_participant_in_employer_plan(entity_ref("urn:test:s219:g2#p"), entity_ref("urn:test:s219:g2#y2024")) { origin case_input; }
        assert "f1": modified_agi_for_219(entity_ref("urn:test:s219:g2#p"), entity_ref("urn:test:s219:g2#y2024"), 130000 USD) { origin case_input; }
        assert "f2": section_219g_applicable_dollar_amount(entity_ref("urn:test:s219:g2#p"), entity_ref("urn:test:s219:g2#y2024"), us.irc.income_individual::Joint, 109000 USD) { origin case_input; }
        assert "f3": us.irc.income_individual::filing_status(entity_ref("urn:test:s219:g2#p"), entity_ref("urn:test:s219:g2#y2024"), us.irc.income_individual::Joint) { origin case_input; }
    }
    // 130,000 >= 109,000 + 20,000 = 129,000: fully phased out.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s219:g2#p"), entity_ref("urn:test:s219:g2#y2024"), Section219Ira, 5000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S219-05-UNKNOWN-COMPENSATION-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ira_contribution(entity_ref("urn:test:s219:u1#p"), entity_ref("urn:test:s219:u1#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s219:u1#p"), entity_ref("urn:test:s219:u1#y2024"), Section219Ira, 3000 USD));
    expect truth_status == NEITHER;
}
