// Special disallowances and definitions detail scenarios (stage 2c): 248, 269A, 269B, 271, 276, 277, 280B, 280E, 281, 291. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "SSPEC-1-ORGANIZATIONAL-EXPENDITURE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": organizational_expenditure_amount(entity_ref("urn:test:sspec-1#c"),1,3000.00 USD) { origin case_input; }
        assert "f1": expenditure_incident_to_creation_of_corporation(entity_ref("urn:test:sspec-1#c"),1) { origin case_input; }
        assert "f2": expenditure_chargeable_to_capital_account_248(entity_ref("urn:test:sspec-1#c"),1) { origin case_input; }
        assert "f3": expenditure_amortizable_if_incident_to_creation_of_limited_life_corporation(entity_ref("urn:test:sspec-1#c"),1) { origin case_input; }
    }
    evaluate truth(organizational_expenditure(entity_ref("urn:test:sspec-1#c"),1,3000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(248)(b): incident to creation, capital, amortizable";
}

