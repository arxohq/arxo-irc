        assert "f1": amount_contributed_excluding_rollovers_and_this_paragraph(entity_ref("urn:test:s219-42#p"),entity_ref("urn:test:s219-42#y"),6500.00 USD) { origin case_input; }
        assert "f2": excess_contributions_4973b2_without_c(entity_ref("urn:test:s219-42#p"),entity_ref("urn:test:s219-42#y"),1500.00 USD) { origin case_input; }
    }
    evaluate truth(additional_contribution_treated_made_for_year(entity_ref("urn:test:s219-42#p"),entity_ref("urn:test:s219-42#y"),500.00 USD));
