        assert "f0": maximum_ira_deduction_for_year(entity_ref("urn:test:s219-41#p"),entity_ref("urn:test:s219-41#y"),7000.00 USD) { origin case_input; }
        assert "f1": amount_contributed_excluding_rollovers_and_this_paragraph(entity_ref("urn:test:s219-41#p"),entity_ref("urn:test:s219-41#y"),4000.00 USD) { origin case_input; }
        assert "f2": excess_contributions_4973b2_without_c(entity_ref("urn:test:s219-41#p"),entity_ref("urn:test:s219-41#y"),1500.00 USD) { origin case_input; }
    }
    evaluate truth(additional_contribution_treated_made_for_year(entity_ref("urn:test:s219-41#p"),entity_ref("urn:test:s219-41#y"),1500.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(f)(6)(A): the lesser of the unused amount and the excess contributions";
}

test "S219-42-UNUSED-LIMITATION-CAPPED-AT-UNUSED-AMOUNT" {
    given {
        context {
            legal_time @2025-06-30;
