test "S280C-29-REDUCED-CREDIT-AMOUNT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": elects_reduced_45c_credit(entity_ref("urn:test:s280c-29#p"),entity_ref("urn:test:s280c-29#y")) { origin case_input; }
        assert "f1": reduced_credit_election_made_on_timely_return(entity_ref("urn:test:s280c-29#p"),entity_ref("urn:test:s280c-29#y")) { origin case_input; }
        assert "f2": credit_under_45c_a_without_election(entity_ref("urn:test:s280c-29#p"),entity_ref("urn:test:s280c-29#y"),10000.00 USD) { origin case_input; }
        assert "f3": maximum_rate_of_tax_under_11b(entity_ref("urn:test:s280c-29#y"),0.21) { origin case_input; }
    }
    evaluate truth(reduced_45c_credit_amount(entity_ref("urn:test:s280c-29#p"),entity_ref("urn:test:s280c-29#y"),7900.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(b)(3)(B): credit less credit times the maximum section 11(b) rate";
}

