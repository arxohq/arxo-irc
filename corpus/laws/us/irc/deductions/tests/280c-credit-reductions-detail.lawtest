language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S280C-20-WAGE-CREDITS-SUM" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": wage_credit_determined_for_year(entity_ref("urn:test:s280c-20#p"),entity_ref("urn:test:s280c-20#y"),S45Aa,1000.00 USD) { origin case_input; }
        assert "f1": wage_credit_determined_for_year(entity_ref("urn:test:s280c-20#p"),entity_ref("urn:test:s280c-20#y"),S51a,2500.00 USD) { origin case_input; }
    }
    evaluate truth(sum_of_wage_credits_for_year(entity_ref("urn:test:s280c-20#p"),entity_ref("urn:test:s280c-20#y"),3500.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(a): the sum of the listed credits";
}

