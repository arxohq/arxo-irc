// Section 280A scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S280A-01-HOME-EXPENSE-DISALLOWED-BY-DEFAULT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dwelling_unit_used_as_residence(entity_ref("urn:test:s280a:a1#p"), entity_ref("urn:test:s280a:a1#y2024"), 1) { origin case_input; }
        assert "f1": home_expense_item(entity_ref("urn:test:s280a:a1#p"), entity_ref("urn:test:s280a:a1#y2024"), 1, 1, 3000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280a:a1#p"), entity_ref("urn:test:s280a:a1#y2024"), Section280AHomeOffice, 3000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S280A-02-EXCLUSIVE-REGULAR-PRINCIPAL-PLACE-OF-BUSINESS-WITHIN-GROSS-INCOME-LIMIT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": exclusive_regular_principal_place_of_business(entity_ref("urn:test:s280a:c1#p"), entity_ref("urn:test:s280a:c1#y2024"), 1, 1) { origin case_input; }
        assert "f1": home_expense_item(entity_ref("urn:test:s280a:c1#p"), entity_ref("urn:test:s280a:c1#y2024"), 1, 1, 2000 USD) { origin case_input; }
        assert "f2": home_office_gross_income(entity_ref("urn:test:s280a:c1#p"), entity_ref("urn:test:s280a:c1#y2024"), 1, 5000 USD) { origin case_input; }
        assert "f3": home_office_deductions_independent_of_use(entity_ref("urn:test:s280a:c1#p"), entity_ref("urn:test:s280a:c1#y2024"), 1, 1000 USD) { origin case_input; }
    }
    // gross 5,000 - independent 1,000 = 4,000 headroom >= 2,000 expense: fully allowed.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280a:c1#p"), entity_ref("urn:test:s280a:c1#y2024"), Section280AHomeOffice, 2000 USD));
    expect truth_status == TRUE_ONLY;
    description "the section 280A(c)(1)(A) exclusive-regular-principal-place-of-business test is satisfied and the expense is within the (c)(5) gross-income limitation";
}

test "S280A-03-HOME-OFFICE-EXPENSE-EXCEEDS-GROSS-INCOME-LIMIT-CAPPED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": exclusive_regular_principal_place_of_business(entity_ref("urn:test:s280a:c2#p"), entity_ref("urn:test:s280a:c2#y2024"), 1, 1) { origin case_input; }
        assert "f1": home_expense_item(entity_ref("urn:test:s280a:c2#p"), entity_ref("urn:test:s280a:c2#y2024"), 1, 1, 5000 USD) { origin case_input; }
        assert "f2": home_office_gross_income(entity_ref("urn:test:s280a:c2#p"), entity_ref("urn:test:s280a:c2#y2024"), 1, 3000 USD) { origin case_input; }
        assert "f3": home_office_deductions_independent_of_use(entity_ref("urn:test:s280a:c2#p"), entity_ref("urn:test:s280a:c2#y2024"), 1, 1000 USD) { origin case_input; }
    }
    // headroom = 3,000 - 1,000 = 2,000, capped there.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280a:c2#p"), entity_ref("urn:test:s280a:c2#y2024"), Section280AHomeOffice, 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S280A-04-FIFTEEN-DAY-RULE-NO-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dwelling_unit_used_as_residence(entity_ref("urn:test:s280a:g1#p"), entity_ref("urn:test:s280a:g1#y2024"), 1) { origin case_input; }
        assert "f1": days_actually_rented_in_year(entity_ref("urn:test:s280a:g1#p"), entity_ref("urn:test:s280a:g1#y2024"), 1, 10) { origin case_input; }
        assert "f2": home_expense_item(entity_ref("urn:test:s280a:g1#p"), entity_ref("urn:test:s280a:g1#y2024"), 1, 1, 1200 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280a:g1#p"), entity_ref("urn:test:s280a:g1#y2024"), Section280AHomeOffice, 1200 USD));
    expect truth_status == FALSE_ONLY;
    description "section 280A(g): the residence is rented for only 10 days (fewer than 15) during the year — no rental-use deduction is allowed";
}

test "S280A-05-FIFTEEN-OR-MORE-DAYS-RULE-DOES-NOT-APPLY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dwelling_unit_used_as_residence(entity_ref("urn:test:s280a:g2#p"), entity_ref("urn:test:s280a:g2#y2024"), 1) { origin case_input; }
        assert "f1": days_actually_rented_in_year(entity_ref("urn:test:s280a:g2#p"), entity_ref("urn:test:s280a:g2#y2024"), 1, 20) { origin case_input; }
        assert "f2": home_expense_item(entity_ref("urn:test:s280a:g2#p"), entity_ref("urn:test:s280a:g2#y2024"), 1, 1, 1200 USD) { origin case_input; }
    }
    // 20 days is not < 15: the (g) rule does not fire; general (a) default disallowance still applies absent another exception.
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280a:g2#p"), entity_ref("urn:test:s280a:g2#y2024"), Section280AHomeOffice, 1200 USD));
    expect truth_status == FALSE_ONLY;
}
