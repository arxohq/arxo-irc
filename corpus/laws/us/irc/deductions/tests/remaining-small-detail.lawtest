test "SSM-1-BAD-DEBT-BASIS-1011" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": debt_wholly_worthless_within_year(entity_ref("urn:test:ssm-1#p"),entity_ref("urn:test:ssm-1#y"),1,500.00 USD) { origin case_input; }
        assert "f1": debt_adjusted_basis_1011_for_loss_166(entity_ref("urn:test:ssm-1#p"),1,400.00 USD) { origin case_input; }
    }
    evaluate truth(bad_debt_deduction_basis_166b(entity_ref("urn:test:ssm-1#p"),entity_ref("urn:test:ssm-1#y"),1,400.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(166)(b): the section 1011 adjusted basis for loss";
}

