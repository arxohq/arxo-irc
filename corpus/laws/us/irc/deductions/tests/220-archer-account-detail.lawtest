test "S220-100-ARCHER-MSA-DEFINITION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": trust_created_in_united_states_as_msa_exclusively_for_qualified_medical_expenses(1) { origin case_input; }
        assert "f1": archer_instrument_accepts_only_cash_contributions(1) { origin case_input; }
        assert "f2": archer_instrument_caps_contributions_at_75_percent_of_highest_deductible(1) { origin case_input; }
        assert "f3": archer_trustee_is_bank_or_insurance_company(1) { origin case_input; }
        assert "f4": archer_instrument_bars_life_insurance_investment(1) { origin case_input; }
        assert "f5": archer_instrument_bars_commingling(1) { origin case_input; }
        assert "f6": archer_instrument_makes_interest_nonforfeitable(1) { origin case_input; }
    }
    evaluate truth(archer_msa_account(1));
    expect truth_status == TRUE_ONLY;
    description "(d)(1): a trust meeting requirements (A)-(E)";
}

