        assert "f2": straddle_other_carrying_amounts(entity_ref("urn:test:d263:2#p"), entity_ref("urn:test:d263:2#y"), 1, 0 USD) { origin case_input; }
        assert "f3": straddle_interest_income_includible(entity_ref("urn:test:d263:2#p"), entity_ref("urn:test:d263:2#y"), 1, 0 USD) { origin case_input; }
        assert "f4": straddle_ordinary_income_under_1271_1276_1281(entity_ref("urn:test:d263:2#p"), entity_ref("urn:test:d263:2#y"), 1, 0 USD) { origin case_input; }
        assert "f5": straddle_dividends_includible_net_of_243_245_deduction(entity_ref("urn:test:d263:2#p"), entity_ref("urn:test:d263:2#y"), 1, 0 USD) { origin case_input; }
        assert "f6": straddle_security_loan_payments_includible(entity_ref("urn:test:d263:2#p"), entity_ref("urn:test:d263:2#y"), 1, 0 USD) { origin case_input; }
        assert "f7": interest_deferred_under_1277_or_1282_263g4B(entity_ref("urn:test:d263:2#p"), entity_ref("urn:test:d263:2#y"), 1, 250 USD) { origin case_input; }
    }
    evaluate truth(straddle_interest_and_carrying_charges(entity_ref("urn:test:d263:2#p"), entity_ref("urn:test:d263:2#y"), 1, 750.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S280GD4-01-PRESENT-VALUE-AT-120-PERCENT-AFR-SEMIANNUAL" {
    // 10000 payable 2027-04-15, change 2024-01-15, AFR 5 percent: s = 0.03, 6 whole periods (to 2027-01-15), stub 90 days: 10000 / (1.03^6 x (1 + 0.03 x 90/182.5)) = 8252.75.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": payment_contingent_on_change_in_control(entity_ref("urn:test:d280:1#p"), entity_ref("urn:test:d280:1#corp"), 1, 10000 USD) { origin case_input; }
        assert "f1": payment_date_280g(entity_ref("urn:test:d280:1#p"), entity_ref("urn:test:d280:1#corp"), 1, @2027-04-15) { origin case_input; }
        assert "f2": change_in_ownership_or_control_date(entity_ref("urn:test:d280:1#corp"), @2024-01-15) { origin case_input; }
        assert "f3": applicable_federal_rate_for_change_280g(entity_ref("urn:test:d280:1#corp"), 0.05) { origin case_input; }
    }
    evaluate truth(present_value_computed_280g(entity_ref("urn:test:d280:1#p"), entity_ref("urn:test:d280:1#corp"), 1, 8252.75 USD));
    expect truth_status == TRUE_ONLY;
}

