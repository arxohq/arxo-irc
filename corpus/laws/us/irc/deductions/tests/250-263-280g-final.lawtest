// Final TECH_GAP pass (26.09.2026): G4400, G4401 (section 250(b)(5)), G3900, G3901 (section 263(g)(4), (h)(6)), G3902 (section 280G(d)(4)).
// NOT EXECUTED (implemented_unverified). Expectations computed by hand with the 12-place roundings named in the module.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S250B5C-01-SALE-OF-EACH-COMPONENT" {
    // component 1 is ultimately sold to an unrelated non-US person, component 2 is not: only the income of component 1 (300) is foreign-derived.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": sale_to_related_party_not_united_states_person_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1) { origin case_input; }
        assert "f1": sold_property_component_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 1) { origin case_input; }
        assert "f2": sold_property_component_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 2) { origin case_input; }
        assert "f3": component_income_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 1, 300 USD) { origin case_input; }
        assert "f4": component_income_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 2, 500 USD) { origin case_input; }
        assert "f5": component_ultimately_sold_or_used_for_unrelated_non_us_person_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 1) { origin case_input; }
    }
    evaluate truth(foreign_use_component_income_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 300.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S250B5C-02-ITEM-WITH-COMPONENTS-NOT-JUDGED-AS-A-WHOLE" {
    // an item with components: the whole-item rule does not fire.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": sale_to_related_party_not_united_states_person_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1) { origin case_input; }
        assert "f1": sold_property_component_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 1) { origin case_input; }
        assert "f2": sold_property_component_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 2) { origin case_input; }
        assert "f3": component_income_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 1, 300 USD) { origin case_input; }
        assert "f4": component_income_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 2, 500 USD) { origin case_input; }
        assert "f5": component_ultimately_sold_or_used_for_unrelated_non_us_person_250(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1, 1) { origin case_input; }
    }
    evaluate truth(related_party_sale_lacks_foreign_use_250b5c(entity_ref("urn:test:d250:1#c"), entity_ref("urn:test:d250:1#y"), 1));
    expect truth_status == NEITHER;
}

test "S250B5D-01-GROUP-INCLUDES-A-FOREIGN-SUBSIDIARY-TWO-LEVELS-DOWN" {
    // R owns 60 percent of S1 (foreign), S1 owns 70 percent of S2: S2 is a member of the group, no exclusion of section 1504(b)(3) applies.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": common_parent_250b5d(entity_ref("urn:test:d250:2#r"), entity_ref("urn:test:d250:2#y")) { origin case_input; }
        assert "f1": vote_percentage_of_stock_owned_250b5d(entity_ref("urn:test:d250:2#r"), entity_ref("urn:test:d250:2#s1"), entity_ref("urn:test:d250:2#y"), 60.0) { origin case_input; }
        assert "f2": value_percentage_of_stock_owned_250b5d(entity_ref("urn:test:d250:2#r"), entity_ref("urn:test:d250:2#s1"), entity_ref("urn:test:d250:2#y"), 60.0) { origin case_input; }
        assert "f3": vote_percentage_of_stock_owned_250b5d(entity_ref("urn:test:d250:2#s1"), entity_ref("urn:test:d250:2#s2"), entity_ref("urn:test:d250:2#y"), 70.0) { origin case_input; }
        assert "f4": value_percentage_of_stock_owned_250b5d(entity_ref("urn:test:d250:2#s1"), entity_ref("urn:test:d250:2#s2"), entity_ref("urn:test:d250:2#y"), 70.0) { origin case_input; }
    }
    evaluate truth(related_within_group_250b5d(entity_ref("urn:test:d250:2#r"), entity_ref("urn:test:d250:2#s2"), entity_ref("urn:test:d250:2#y")));
    expect truth_status == TRUE_ONLY;
}

test "S263G4A-01-SHORT-SALE-H-APPLIES-BEFORE-G" {
    // carrying charges 1000; the short sale payment disallowed by (h) is 400: (g) applies to 600.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": personal_property_part_of_straddle(1) { origin case_input; }
        assert "f1": straddle_interest_on_debt_to_carry_property(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 1, 1000 USD) { origin case_input; }
        assert "f2": straddle_other_carrying_amounts(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 1, 0 USD) { origin case_input; }
        assert "f3": straddle_interest_income_includible(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 1, 0 USD) { origin case_input; }
        assert "f4": straddle_ordinary_income_under_1271_1276_1281(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 1, 0 USD) { origin case_input; }
        assert "f5": straddle_dividends_includible_net_of_243_245_deduction(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 1, 0 USD) { origin case_input; }
        assert "f6": straddle_security_loan_payments_includible(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 1, 0 USD) { origin case_input; }
        assert "f7": straddle_property_is_short_sale_263g4(1, 7) { origin case_input; }
        assert "f8": short_sale_payment_in_lieu_of_dividend(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 7, 400 USD) { origin case_input; }
        assert "f9": short_sale_closed_within_period(7) { origin case_input; }
        assert "f10": collateral_compensation_ordinary_income_received(7, 0 USD) { origin case_input; }
    }
    evaluate truth(straddle_interest_and_carrying_charges(entity_ref("urn:test:d263:1#p"), entity_ref("urn:test:d263:1#y"), 1, 600.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S263G4B-01-SECTION-1277-APPLIES-BEFORE-G" {
    // carrying charges 1000, 250 deferred under section 1277: (g) applies to 750.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
