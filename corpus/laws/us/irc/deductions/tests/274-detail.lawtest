test "S274-30-GIFT-WITHIN-274B" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_item_paid(entity_ref("urn:test:s274-30#p"),entity_ref("urn:test:s274-30#y"),entity_ref("urn:test:s274-30#r"),1,20.00 USD) { origin case_input; }
    }
    evaluate truth(gift_within_274b(1));
    expect truth_status == TRUE_ONLY;
    description "(b)(1): an ordinary gift item";
}

