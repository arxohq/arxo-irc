        assert "f2": award_conditions_create_no_significant_likelihood_of_disguised_compensation(1) { origin adjudicated; }
        assert "f3": item_awarded_for_length_of_service_achievement(1) { origin case_input; }
        assert "f4": award_under_established_written_nondiscriminatory_plan(1) { origin case_input; }
        assert "f5": award_of_employer_in_year(1,entity_ref("urn:test:s274-78#e"),entity_ref("urn:test:s274-78#y")) { origin case_input; }
        assert "f6": employer_qualified_plan_awards_total_and_count(entity_ref("urn:test:s274-78#e"),entity_ref("urn:test:s274-78#y"),1000.00 USD,2) { origin case_input; }
    }
    evaluate truth(qualified_plan_award(1));
    expect truth_status == NEITHER;
    description "(j)(3)(B)(ii): an average cost over 400 defeats qualification";
}

test "S274-79-QUALIFIED-PLAN-AWARD-AVERAGE-EXACTLY-400" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": item_is_tangible_personal_property_transferred_by_employer_to_employee(1) { origin case_input; }
        assert "f1": item_awarded_as_part_of_meaningful_presentation(1) { origin case_input; }
        assert "f2": award_conditions_create_no_significant_likelihood_of_disguised_compensation(1) { origin adjudicated; }
        assert "f3": item_awarded_for_length_of_service_achievement(1) { origin case_input; }
        assert "f4": award_under_established_written_nondiscriminatory_plan(1) { origin case_input; }
        assert "f5": award_of_employer_in_year(1,entity_ref("urn:test:s274-79#e"),entity_ref("urn:test:s274-79#y")) { origin case_input; }
        assert "f6": employer_qualified_plan_awards_total_and_count(entity_ref("urn:test:s274-79#e"),entity_ref("urn:test:s274-79#y"),800.00 USD,2) { origin case_input; }
    }
    evaluate truth(qualified_plan_award(1));
    expect truth_status == TRUE_ONLY;
    description "(j)(3)(B)(ii): an average of exactly 400 is allowed";
}

