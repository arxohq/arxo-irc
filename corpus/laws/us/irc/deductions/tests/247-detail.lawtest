test "S247X-1-EXCESS-OF-YEAR" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": native_corporation_section_247_election_in_effect(entity_ref("urn:test:s247x-1#c"),entity_ref("urn:test:s247x-1#y")) { origin case_input; }
        assert "f1": native_corporation_contributions_total_with_carryover(entity_ref("urn:test:s247x-1#c"),entity_ref("urn:test:s247x-1#y"),500000.00 USD) { origin case_input; }
        assert "f2": native_corporation_taxable_income_before_247_deduction(entity_ref("urn:test:s247x-1#c"),entity_ref("urn:test:s247x-1#y"),300000.00 USD) { origin case_input; }
    }
    evaluate truth(native_corporation_excess_contribution_of_year(entity_ref("urn:test:s247x-1#c"),entity_ref("urn:test:s247x-1#y"),200000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(c)(2): 500000 of contributions, 300000 allowed";
}

