// Section 280G detail scenarios (stage 2b). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S280G-20-NO-DEDUCTION-FOR-EXCESS-PARACHUTE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": disqualified_individual(entity_ref("urn:test:s280g-20#p"),entity_ref("urn:test:s280g-20#c")) { origin case_input; }
        assert "f1": payment_contingent_on_change_in_control(entity_ref("urn:test:s280g-20#p"),entity_ref("urn:test:s280g-20#c"),1,900000.00 USD) { origin case_input; }
        assert "f2": present_value_of_payment(entity_ref("urn:test:s280g-20#p"),entity_ref("urn:test:s280g-20#c"),1,900000.00 USD) { origin case_input; }
        assert "f3": aggregate_present_value_contingent_payments(entity_ref("urn:test:s280g-20#p"),entity_ref("urn:test:s280g-20#c"),900000.00 USD) { origin case_input; }
        assert "f4": base_amount(entity_ref("urn:test:s280g-20#p"),entity_ref("urn:test:s280g-20#c"),200000.00 USD) { origin case_input; }
        assert "f5": payment_otherwise_deductible_in_year(entity_ref("urn:test:s280g-20#c"),1,entity_ref("urn:test:s280g-20#y")) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s280g-20#c"),entity_ref("urn:test:s280g-20#y"),Section280GExcessParachutePayment,700000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "(a): no deduction for the excess parachute payment";
}

