            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": covered_executive_of_applicable_employer(entity_ref("urn:test:s280g-55#p"),entity_ref("urn:test:s280g-55#c")) { origin case_input; }
        assert "f1": severance_by_involuntary_termination(entity_ref("urn:test:s280g-55#p"),entity_ref("urn:test:s280g-55#c"),@2010-03-01) { origin case_input; }
        assert "f2": eesa_authorities_in_effect_at_severance(entity_ref("urn:test:s280g-55#c"),@2010-03-01) { origin case_input; }
        assert "f3": payment_made_in_applicable_taxable_year_on_account_of_severance(entity_ref("urn:test:s280g-55#p"),entity_ref("urn:test:s280g-55#c"),1,600000.00 USD,@2010-03-01) { origin case_input; }
        assert "f4": aggregate_present_value_contingent_payments(entity_ref("urn:test:s280g-55#p"),entity_ref("urn:test:s280g-55#c"),600000.00 USD) { origin case_input; }
        assert "f5": base_amount(entity_ref("urn:test:s280g-55#p"),entity_ref("urn:test:s280g-55#c"),150000.00 USD) { origin case_input; }
    }
    evaluate truth(eesa_parachute_payment(entity_ref("urn:test:s280g-55#p"),entity_ref("urn:test:s280g-55#c"),1,600000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(e)(1)(B): a payment on account of the severance is a parachute payment at 3 times the base";
}

test "S280G-56-EESA-PAYMENT-BELOW-3X-NOT-PARACHUTE" {
