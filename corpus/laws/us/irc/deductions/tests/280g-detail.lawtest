test "S280G-22-SECURITIES-LAW-VIOLATION-PARACHUTE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": disqualified_individual(entity_ref("urn:test:s280g-22#p"),entity_ref("urn:test:s280g-22#c")) { origin case_input; }
        assert "f1": payment_in_nature_of_compensation_to_disqualified_individual(entity_ref("urn:test:s280g-22#p"),entity_ref("urn:test:s280g-22#c"),1,50000.00 USD) { origin case_input; }
        assert "f2": secretary_establishes_agreement_violates_generally_enforced_securities_laws(1) { origin case_input; }
    }
    evaluate truth(parachute_payment(entity_ref("urn:test:s280g-22#p"),entity_ref("urn:test:s280g-22#c"),1,50000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(b)(2)(B): a payment under an agreement violating securities law is a parachute payment";
}

