    evaluate truth(dividends_received_deduction_243_item(entity_ref("urn:test:s245x-79#c"),entity_ref("urn:test:s245x-79#y"),1,50000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(246A)(e): the reduction 35000 is limited to the interest 20000";
}

test "S245X-80-INTEREST-ABOVE-REDUCTION-NO-CHANGE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": dividend_received_by_corporation(entity_ref("urn:test:s245x-80#c"),entity_ref("urn:test:s245x-80#y"),1,100000.00 USD) { origin case_input; }
        assert "f1": dividends_received_deduction_percentage_243(entity_ref("urn:test:s245x-80#c"),entity_ref("urn:test:s245x-80#y"),1,0.70) { origin case_input; }
        assert "f2": debt_financed_portfolio_stock(entity_ref("urn:test:s245x-80#c"),entity_ref("urn:test:s245x-80#y"),1) { origin case_input; }
        assert "f3": average_portfolio_indebtedness(entity_ref("urn:test:s245x-80#c"),entity_ref("urn:test:s245x-80#y"),1,50000.00 USD) { origin case_input; }
        assert "f4": average_adjusted_basis_of_portfolio_stock(entity_ref("urn:test:s245x-80#c"),entity_ref("urn:test:s245x-80#y"),1,100000.00 USD) { origin case_input; }
        assert "f5": interest_deduction_allocable_to_dividend_246A(entity_ref("urn:test:s245x-80#c"),entity_ref("urn:test:s245x-80#y"),1,60000.00 USD) { origin case_input; }
    }
    evaluate truth(dividends_received_deduction_243_item(entity_ref("urn:test:s245x-80#c"),entity_ref("urn:test:s245x-80#y"),1,35000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(246A)(e): the interest 60000 exceeds the reduction";
}
