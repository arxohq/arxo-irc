test "S245X-6-POST-1986-UNDISTRIBUTED-EARNINGS" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": foreign_corporation_accumulated_earnings_post_1986_at_close(entity_ref("urn:test:s245x-6#c"),entity_ref("urn:test:s245x-6#y"),1,800000.00 USD) { origin case_input; }
        assert "f1": foreign_corporation_dividends_distributed_in_year(entity_ref("urn:test:s245x-6#c"),entity_ref("urn:test:s245x-6#y"),1,200000.00 USD) { origin case_input; }
        assert "f2": earnings_before_qualification_period(entity_ref("urn:test:s245x-6#c"),entity_ref("urn:test:s245x-6#y"),1,100000.00 USD) { origin case_input; }
        assert "f3": earnings_covered_by_245b_deduction(entity_ref("urn:test:s245x-6#c"),entity_ref("urn:test:s245x-6#y"),1,50000.00 USD) { origin case_input; }
    }
    evaluate truth(post_1986_undistributed_earnings(entity_ref("urn:test:s245x-6#c"),entity_ref("urn:test:s245x-6#y"),1,850000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(245)(a)(4),(6),(7): 800000 plus 200000 less 100000 less 50000";
}

