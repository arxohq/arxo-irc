// Sections 245, 245A, 246, 246A detail scenarios (stage 2c). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S245X-1-QUALIFIED-10-PERCENT-OWNED" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": dividend_payor_is_foreign_corporation(entity_ref("urn:test:s245x-1#c"),entity_ref("urn:test:s245x-1#y"),1) { origin case_input; }
        assert "f1": taxpayer_owns_percent_of_payor_by_vote(entity_ref("urn:test:s245x-1#c"),entity_ref("urn:test:s245x-1#y"),1,12.0) { origin case_input; }
        assert "f2": taxpayer_owns_percent_of_payor_by_value(entity_ref("urn:test:s245x-1#c"),entity_ref("urn:test:s245x-1#y"),1,10.0) { origin case_input; }
    }
    evaluate truth(dividend_from_qualified_10_percent_owned_foreign_corporation(entity_ref("urn:test:s245x-1#c"),entity_ref("urn:test:s245x-1#y"),1));
    expect truth_status == TRUE_ONLY;
    description "(245)(a)(2): a foreign corporation owned 12 percent by vote and 10 by value";
}

