// Section 163 remaining subsections scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S163-20-IMPUTED-INTEREST-CAPPED-BY-CARRYING-CHARGES" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": installment_purchase_contract(entity_ref("urn:test:s163:b1#p"),entity_ref("urn:test:s163:b1#y"),1) { origin case_input; }
        assert "f1": sum_of_unpaid_balances_on_first_day_of_each_month(entity_ref("urn:test:s163:b1#p"),entity_ref("urn:test:s163:b1#y"),1,120000.00 USD) { origin case_input; }
        assert "f2": carrying_charges_attributable_to_year(entity_ref("urn:test:s163:b1#p"),entity_ref("urn:test:s163:b1#y"),1,500.00 USD) { origin case_input; }
    }
    evaluate truth(imputed_interest_on_installment_contract(entity_ref("urn:test:s163:b1#p"),entity_ref("urn:test:s163:b1#y"),1,500.00 USD));
    expect truth_status == TRUE_ONLY;
    description "6 percent of the average unpaid balance 10,000 is 600, limited to carrying charges 500 (section 163(b))";
}

