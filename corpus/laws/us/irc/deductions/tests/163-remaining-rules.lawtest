test "S163-30-DISQUALIFIED-PORTION-OF-OID" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": instrument_maturity_over_5_years(entity_ref("urn:test:s163:e6#p"),1) { origin case_input; }
        assert "f1": instrument_yield_to_maturity(entity_ref("urn:test:s163:e6#p"),1,14.0) { origin case_input; }
        assert "f2": applicable_federal_rate_at_issue(entity_ref("urn:test:s163:e6#p"),1,5.0) { origin case_input; }
        assert "f3": instrument_has_significant_original_issue_discount(entity_ref("urn:test:s163:e6#p"),1) { origin case_input; }
        assert "f4": original_issue_discount_on_obligation(entity_ref("urn:test:s163:e6#p"),1,900000.00 USD) { origin case_input; }
        assert "f5": total_return_on_obligation(entity_ref("urn:test:s163:e6#p"),1,1000000.00 USD) { origin case_input; }
    }
    evaluate truth(disqualified_portion_of_original_issue_discount(entity_ref("urn:test:s163:e6#p"),1,214285.71 USD));
    expect truth_status == TRUE_ONLY;
    description "disqualified yield 14 - (5 + 6) = 3: 1,000,000 x 3/14 = 214,285.71, below the OID 900,000 (section 163(e)(5)(C))";
}

