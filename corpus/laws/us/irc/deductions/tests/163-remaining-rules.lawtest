        assert "f1": instrument_yield_to_maturity(entity_ref("urn:test:s163:i1#p"),1,14.0) { origin case_input; }
        assert "f2": applicable_federal_rate_at_issue(entity_ref("urn:test:s163:i1#p"),1,5.0) { origin case_input; }
        assert "f3": instrument_has_significant_original_issue_discount(entity_ref("urn:test:s163:i1#p"),1) { origin case_input; }
    }
    evaluate truth(applicable_high_yield_discount_obligation(entity_ref("urn:test:s163:i1#p"),1));
    expect truth_status == TRUE_ONLY;
    description "maturity over 5 years, yield 14 at least AFR 5 + 5, significant OID (section 163(i)(1))";
}

