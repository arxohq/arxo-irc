// Section 179D scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S179D-01-DEDUCTION-BY-DOLLAR-VALUE-2025" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": energy_efficient_commercial_building_property_cost(entity_ref("urn:test:s179d:b1#p"),entity_ref("urn:test:s179d:b1#y"),1,300000.00 USD) { origin case_input; }
        assert "f1": building_square_footage(1,100000) { origin case_input; }
        assert "f2": certified_energy_cost_reduction_percentage(1,40.0) { origin case_input; }
        assert "f3": prior_three_year_deductions_179d(entity_ref("urn:test:s179d:b1#p"),entity_ref("urn:test:s179d:b1#y"),1,0.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_179d(entity_ref("urn:test:s179d:b1#p"),entity_ref("urn:test:s179d:b1#y"),1,88000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "40 percent reduction: 0.58 + 15 x 0.02 = 0.88 per square foot x 100,000 = 88,000, below the cost 300,000 (section 179D(a),(b), Rev. Proc. 2024-40 section 2.26)";
}

test "S179D-02-DOLLAR-VALUE-CAPPED-AT-1-16-IN-2025" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": energy_efficient_commercial_building_property_cost(entity_ref("urn:test:s179d:b2#p"),entity_ref("urn:test:s179d:b2#y"),1,500000.00 USD) { origin case_input; }
        assert "f1": building_square_footage(1,100000) { origin case_input; }
        assert "f2": certified_energy_cost_reduction_percentage(1,80.0) { origin case_input; }
        assert "f3": prior_three_year_deductions_179d(entity_ref("urn:test:s179d:b2#p"),entity_ref("urn:test:s179d:b2#y"),1,0.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_179d(entity_ref("urn:test:s179d:b2#p"),entity_ref("urn:test:s179d:b2#y"),1,116000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "0.58 + 55 x 0.02 exceeds the ceiling 1.16, so 116,000 (section 179D(b)(2))";
}

