        assert "f0": energy_efficient_commercial_building_property_cost(entity_ref("urn:test:s179d:b6#p"),entity_ref("urn:test:s179d:b6#y"),1,300000.00 USD) { origin case_input; }
        assert "f1": building_square_footage(1,100000) { origin case_input; }
        assert "f2": certified_energy_cost_reduction_percentage(1,20.0) { origin case_input; }
