test "S179D-10-RETROFIT-ALTERNATIVE-DEDUCTION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_179d_retrofit_alternative(entity_ref("urn:test:s179d:f1#p"),1) { origin case_input; }
        assert "f1": qualified_building_179df4(1) { origin case_input; }
        assert "f2": baseline_energy_use_intensity(1,100.0) { origin case_input; }
        assert "f3": final_certified_energy_use_intensity(1,70.0) { origin case_input; }
        assert "f4": qualifying_final_certification_in_year(entity_ref("urn:test:s179d:f1#p"),entity_ref("urn:test:s179d:f1#y"),1) { origin case_input; }
        assert "f5": retrofit_energy_use_intensity_reduction_percentage(1,30.0) { origin case_input; }
        assert "f6": building_square_footage(1,50000) { origin case_input; }
        assert "f7": prior_three_year_deductions_179d(entity_ref("urn:test:s179d:f1#p"),entity_ref("urn:test:s179d:f1#y"),1,0.00 USD) { origin case_input; }
        assert "f8": retrofit_property_aggregate_adjusted_basis(entity_ref("urn:test:s179d:f1#p"),entity_ref("urn:test:s179d:f1#y"),1,40000.00 USD) { origin case_input; }
    }
    evaluate truth(retrofit_deduction_179d_f(entity_ref("urn:test:s179d:f1#p"),entity_ref("urn:test:s179d:f1#y"),1,34000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "0.58 + 5 x 0.02 = 0.68 x 50,000 = 34,000, below the adjusted basis 40,000 (section 179D(f)(1))";
}

