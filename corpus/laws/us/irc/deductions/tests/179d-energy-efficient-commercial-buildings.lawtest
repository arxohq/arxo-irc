test "S179D-06-CONSTRUCTION-AFTER-JUNE-30-2026-TERMINATED" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": energy_efficient_commercial_building_property_cost(entity_ref("urn:test:s179d:i1#p"),entity_ref("urn:test:s179d:i1#y"),1,300000.00 USD) { origin case_input; }
        assert "f1": building_square_footage(1,100000) { origin case_input; }
        assert "f2": certified_energy_cost_reduction_percentage(1,40.0) { origin case_input; }
        assert "f3": prior_three_year_deductions_179d(entity_ref("urn:test:s179d:i1#p"),entity_ref("urn:test:s179d:i1#y"),1,0.00 USD) { origin case_input; }
        assert "f4": construction_of_property_begins_on(1,@2026-07-01) { origin case_input; }
    }
    evaluate truth(deduction_179d(entity_ref("urn:test:s179d:i1#p"),entity_ref("urn:test:s179d:i1#y"),1,88000.00 USD));
