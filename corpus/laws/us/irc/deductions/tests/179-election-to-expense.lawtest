// Section 179 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S179-01-ELECTION-VALID-WITHIN-DOLLAR-AND-INCOME-LIMIT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_179_property_cost(entity_ref("urn:test:s179:v1#p"), entity_ref("urn:test:s179:v1#y2024"), 1, 50000 USD) { origin case_input; }
        assert "f1": elects_to_expense_section_179_property(entity_ref("urn:test:s179:v1#p"), entity_ref("urn:test:s179:v1#y2024"), 1) { origin case_input; }
        assert "f2": section_179_aggregate_cost_placed_in_service(entity_ref("urn:test:s179:v1#p"), entity_ref("urn:test:s179:v1#y2024"), 50000 USD) { origin case_input; }
        assert "f3": active_trade_or_business_taxable_income(entity_ref("urn:test:s179:v1#p"), entity_ref("urn:test:s179:v1#y2024"), 200000 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s179:v1#p"), entity_ref("urn:test:s179:v1#y2024"), Section179Election, 50000 USD));
    expect truth_status == TRUE_ONLY;
    description "an exercised, valid section 179(a) election within the dollar limit (before phasedown, cost 1,000,000 threshold not reached) and within active-trade-or-business income";
}

test "S179-02-ELECTION-NOT-EXERCISED-NO-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_179_property_cost(entity_ref("urn:test:s179:v2#p"), entity_ref("urn:test:s179:v2#y2024"), 1, 50000 USD) { origin case_input; }
    }
    // No election exercised: `section_179_election_in_effect` never
    // materializes, so the section 179(b) rule cannot fire — INVALID
    // (unexercised) attempt yields no deduction, checked as UNDETERMINED
    // (open-world: this package asserts no `not deduction_allowed` head for
    // an absent election, matching the DECISION-0194-style absence
    // treatment used throughout this package).
    evaluate truth(deduction_allowed(entity_ref("urn:test:s179:v2#p"), entity_ref("urn:test:s179:v2#y2024"), Section179Election, 50000 USD));
    expect truth_status == NEITHER;
    description "no election signified: the section 179(a) power's `valid_when` never holds, so its effect (`section_179_election_in_effect`) never materializes and the (b) dollar-limit rule has no election to read";
}

test "S179-03-COST-EXCEEDS-INCOME-LIMIT-CAPPED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_179_property_cost(entity_ref("urn:test:s179:v3#p"), entity_ref("urn:test:s179:v3#y2024"), 1, 90000 USD) { origin case_input; }
        assert "f1": elects_to_expense_section_179_property(entity_ref("urn:test:s179:v3#p"), entity_ref("urn:test:s179:v3#y2024"), 1) { origin case_input; }
        assert "f2": section_179_aggregate_cost_placed_in_service(entity_ref("urn:test:s179:v3#p"), entity_ref("urn:test:s179:v3#y2024"), 90000 USD) { origin case_input; }
        assert "f3": active_trade_or_business_taxable_income(entity_ref("urn:test:s179:v3#p"), entity_ref("urn:test:s179:v3#y2024"), 40000 USD) { origin case_input; }
    }
    // Cost 90,000 exceeds the 40,000 active-trade-or-business income limit —
    // `Section179DollarLimitBeforePhasedown`'s `min(...)` guard does not
    // hold at 90,000, so no deduction from that rule (the (b)(3)(B)
    // carryover-increase rule is a separate, not-exercised-here relation).
    evaluate truth(deduction_allowed(entity_ref("urn:test:s179:v3#p"), entity_ref("urn:test:s179:v3#y2024"), Section179Election, 90000 USD));
    expect truth_status == NEITHER;
}

test "S179-04-PUB-SECTION-179-DEDUCTION-ALIAS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_179_property_cost(entity_ref("urn:test:s179:v4#p"), entity_ref("urn:test:s179:v4#y2024"), 1, 50000 USD) { origin case_input; }
        assert "f1": elects_to_expense_section_179_property(entity_ref("urn:test:s179:v4#p"), entity_ref("urn:test:s179:v4#y2024"), 1) { origin case_input; }
        assert "f2": section_179_aggregate_cost_placed_in_service(entity_ref("urn:test:s179:v4#p"), entity_ref("urn:test:s179:v4#y2024"), 50000 USD) { origin case_input; }
        assert "f3": active_trade_or_business_taxable_income(entity_ref("urn:test:s179:v4#p"), entity_ref("urn:test:s179:v4#y2024"), 200000 USD) { origin case_input; }
    }
    evaluate truth(section_179_deduction(entity_ref("urn:test:s179:v4#p"), entity_ref("urn:test:s179:v4#y2024"), 50000 USD));
    expect truth_status == TRUE_ONLY;
    description "the task-required `section_179_deduction` pub name mirrors the underlying `deduction_allowed(..., Section179Election, ...)` conclusion";
}
