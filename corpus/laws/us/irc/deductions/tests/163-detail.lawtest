// Section 163 detail scenarios (stage 2c): (e), (f), (i), (l). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S163X-1-ACCRUAL-PERIOD-PORTION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": oid_accrual_period_adjusted_issue_price(entity_ref("urn:test:s163x-1#p"),1,1,10000.00 USD) { origin case_input; }
        assert "f1": oid_accrual_period_yield_percent(entity_ref("urn:test:s163x-1#p"),1,1,8.0) { origin case_input; }
        assert "f2": oid_accrual_period_qualified_stated_interest(entity_ref("urn:test:s163x-1#p"),1,1,0.00 USD) { origin case_input; }
        assert "f3": oid_accrual_period_length_days(entity_ref("urn:test:s163x-1#p"),1,1,182) { origin case_input; }
        assert "f4": oid_accrual_period_days_in_taxable_year(entity_ref("urn:test:s163x-1#p"),entity_ref("urn:test:s163x-1#y"),1,1,91) { origin case_input; }
    }
    evaluate truth(oid_accrual_period_portion_for_year(entity_ref("urn:test:s163x-1#p"),entity_ref("urn:test:s163x-1#y"),1,1,400.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(e)(2)(B): 800 of discount for a 182-day period, 91 days in the year";
}

