        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": short_sale_payment_in_lieu_of_dividend(entity_ref("urn:test:s263-49#p"),entity_ref("urn:test:s263-49#y"),1,1000.00 USD) { origin case_input; }
        assert "f1": short_sale_date(1,@2025-03-01) { origin case_input; }
        assert "f2": short_sale_closing_date(1,@2025-04-01) { origin case_input; }
        assert "f3": short_sale_period_suspension_days(1,0) { origin case_input; }
        assert "f4": collateral_compensation_ordinary_income_received(1,0.00 USD) { origin case_input; }
    }
    evaluate truth(deduction_allowed(entity_ref("urn:test:s263-49#p"),entity_ref("urn:test:s263-49#y"),Section263ShortSalePaymentInLieu,1000.00 USD));
    expect truth_status == FALSE_ONLY;
    description "(h)(1): the disallowed payment yields no deduction";
}

