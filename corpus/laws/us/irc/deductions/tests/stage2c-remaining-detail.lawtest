// Sections 171, 175, 183(e), 197, 198, 250 remaining detail scenarios (stage 2c). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "SMISC-1-TAXABLE-CALL-SMALLER-VIA-CALL" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": bond_has_call_date(entity_ref("urn:test:smisc-1#p"),1) { origin case_input; }
        assert "f1": bond_premium_period_before_call_via_maturity(entity_ref("urn:test:smisc-1#p"),1,500.00 USD) { origin case_input; }
        assert "f2": bond_premium_period_before_call_via_call_date(entity_ref("urn:test:smisc-1#p"),1,300.00 USD) { origin case_input; }
    }
    evaluate truth(bond_premium_before_call_171b1(entity_ref("urn:test:smisc-1#p"),1,300.00 USD));
    expect truth_status == TRUE_ONLY;
    description "(171)(b)(1)(B)(i): the call date gives the smaller premium";
}

