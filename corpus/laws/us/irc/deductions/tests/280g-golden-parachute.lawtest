// Section 280G scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S280G-01-EXCESS-PARACHUTE-PAYMENT-COMPUTED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": disqualified_individual(entity_ref("urn:test:s280g:v1#p"), entity_ref("urn:test:s280g:v1#corp")) { origin case_input; }
        assert "f1": payment_contingent_on_change_in_control(entity_ref("urn:test:s280g:v1#p"), entity_ref("urn:test:s280g:v1#corp"), 1, 900000.00 USD) { origin case_input; }
        assert "f2": present_value_of_payment(entity_ref("urn:test:s280g:v1#p"), entity_ref("urn:test:s280g:v1#corp"), 1, 900000.00 USD) { origin case_input; }
        assert "f3": aggregate_present_value_contingent_payments(entity_ref("urn:test:s280g:v1#p"), entity_ref("urn:test:s280g:v1#corp"), 900000.00 USD) { origin case_input; }
        assert "f4": base_amount(entity_ref("urn:test:s280g:v1#p"), entity_ref("urn:test:s280g:v1#corp"), 200000.00 USD) { origin case_input; }
    }
    // 3x base amount = 600,000 <= 900,000 aggregate: parachute payment test met.
    // allocation = 200,000 * (900,000/900,000) = 200,000.
    // excess = 900,000 - 200,000 = 700,000.00.
    evaluate truth(excess_parachute_payment(entity_ref("urn:test:s280g:v1#p"), entity_ref("urn:test:s280g:v1#corp"), 1, 700000.00 USD));
    expect truth_status == TRUE_ONLY;
    description "a single contingent payment exceeding 3x the base amount is an excess parachute payment equal to the payment less its allocated base amount (section 280G(b)(1)-(3))";
}

test "S280G-02-BELOW-THREE-TIMES-BASE-NOT-PARACHUTE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": disqualified_individual(entity_ref("urn:test:s280g:v2#p"), entity_ref("urn:test:s280g:v2#corp")) { origin case_input; }
        assert "f1": payment_contingent_on_change_in_control(entity_ref("urn:test:s280g:v2#p"), entity_ref("urn:test:s280g:v2#corp"), 1, 400000.00 USD) { origin case_input; }
        assert "f2": aggregate_present_value_contingent_payments(entity_ref("urn:test:s280g:v2#p"), entity_ref("urn:test:s280g:v2#corp"), 400000.00 USD) { origin case_input; }
        assert "f3": base_amount(entity_ref("urn:test:s280g:v2#p"), entity_ref("urn:test:s280g:v2#corp"), 200000.00 USD) { origin case_input; }
    }
    // 3x base amount = 600,000 > 400,000 aggregate: test not met, no parachute payment.
    evaluate truth(parachute_payment(entity_ref("urn:test:s280g:v2#p"), entity_ref("urn:test:s280g:v2#corp"), 1, 400000.00 USD));
    expect truth_status == NEITHER;
    description "a contingent payment whose aggregate present value is below 3 times the base amount is not a parachute payment (section 280G(b)(2)(A)(ii))";
}

test "S280G-03-NOT-DISQUALIFIED-INDIVIDUAL-NO-PARACHUTE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": payment_contingent_on_change_in_control(entity_ref("urn:test:s280g:v3#p"), entity_ref("urn:test:s280g:v3#corp"), 1, 900000.00 USD) { origin case_input; }
        assert "f1": aggregate_present_value_contingent_payments(entity_ref("urn:test:s280g:v3#p"), entity_ref("urn:test:s280g:v3#corp"), 900000.00 USD) { origin case_input; }
        assert "f2": base_amount(entity_ref("urn:test:s280g:v3#p"), entity_ref("urn:test:s280g:v3#corp"), 200000.00 USD) { origin case_input; }
    }
    // No `disqualified_individual` fact: absent that, no parachute payment.
    evaluate truth(parachute_payment(entity_ref("urn:test:s280g:v3#p"), entity_ref("urn:test:s280g:v3#corp"), 1, 900000.00 USD));
    expect truth_status == NEITHER;
    description "without a disqualified-individual fact, no parachute payment is concluded (open-world, not a false negative)";
}
