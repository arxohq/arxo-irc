// Section 263A regulation-reader scenarios (IRC-G/G4, CFR wiring 27.09.2026).
// Вывод / нет факта источника: with the regulation content as applied the
// subsection consequence derives (TRUE_ONLY); without it nothing derives
// (NEITHER). Existing (b)/(i) scope and case-fact paths are untouched.
// Expectations from the statutory text. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

test "S263A-CFR-01-A-CAPITALIZATION-DERIVES" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": property_produced_by_taxpayer(entity_ref("urn:test:s263acfr:1#p"), entity_ref("urn:test:s263acfr:1#y2024"), 1) { origin case_input; }
        assert "f1": unicap_costs_described_a2_as_applied_1_263a_1(entity_ref("urn:test:s263acfr:1#p"), entity_ref("urn:test:s263acfr:1#y2024"), 1) { origin case_input; }
    }
    evaluate truth(unicap_costs_capitalized_under_reg_1_263a(entity_ref("urn:test:s263acfr:1#p"), entity_ref("urn:test:s263acfr:1#y2024"), 1));
    expect truth_status == TRUE_ONLY;
    description "section 263A(a): regulation-described costs of produced property are inventory/capitalized costs";
}

