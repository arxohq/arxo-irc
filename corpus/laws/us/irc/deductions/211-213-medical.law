// Sections 211-213 — Medical, dental, etc., expenses. Stage 1 (IRC-06),
// priority section. §211 is a structural cross-reference to this part's
// deductions (NON_NORMATIVE, no computable rule of its own — same reasoning
// as §161). §212 (expenses for production of income) stays "stage 2" (not
// named in the priority list). §213(a): the 7.5%-of-AGI medical floor.

use self::{
    DeductionKind,
    IRC_S213_A,
    IRC_S213_B,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation medical_care_expense_paid(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an expense paid during the taxable year, not compensated by insurance or otherwise, for medical care of the taxpayer, spouse, or dependent (section 213(a), (d))";
}
pub relation medical_expenses_aggregate(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate of section 213(a) medical care expenses for the taxable year (sum of `medical_care_expense_paid` items)";
}
rule AggregateMedicalExpenses(p: Individual, y: TaxableYear, item0: Integer, amount0: Money) strict {
    label en official "helper: sums medical care expense items into the section 213(a) aggregate";
    when medical_care_expense_paid(p, y, item0, amount0);
    then medical_expenses_aggregate(p, y,
        sum all amount: Money for item: Integer where medical_care_expense_paid(p, y, item, amount));
}

@source(IRC_S213_A, quote = "to the extent that such expenses exceed 7.5 percent of adjusted gross income")
rule MedicalExpenseDeductionAboveSevenAndHalfPercentFloor(p: Individual, y: TaxableYear, aggregate: Money, agi: Money) strict {
    label en official "medical care expenses are deductible only to the extent they exceed 7.5% of adjusted gross income (section 213(a))";
    when medical_expenses_aggregate(p, y, aggregate);
    when us.irc.gross_income::adjusted_gross_income(p, y, agi);
    when aggregate > round(agi * 0.075, 2, "HALF_UP");
    then deduction_allowed(p, y, Section213Medical, aggregate - round(agi * 0.075, 2, "HALF_UP"));
}
@source(IRC_S213_A, quote = "to the extent that such expenses exceed 7.5 percent of adjusted gross income")
rule MedicalExpenseBelowFloorNotDeductible(p: Individual, y: TaxableYear, aggregate: Money, agi: Money) strict {
    label en official "medical care expenses not exceeding the 7.5%-of-AGI floor are not deductible (section 213(a))";
    when medical_expenses_aggregate(p, y, aggregate);
    when us.irc.gross_income::adjusted_gross_income(p, y, agi);
    when aggregate <= round(agi * 0.075, 2, "HALF_UP");
    then not deduction_allowed(p, y, Section213Medical, aggregate);
}
@source(IRC_S213_B, quote = "An amount paid during the taxable year for medicine or a drug shall be taken into account under subsection (a) only if such medicine or drug is a prescribed drug or is insulin")
rule MedicineOrDrugRequiresPrescriptionOrInsulin(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "an amount paid for medicine or a drug counts as a medical care expense only if it is a prescribed drug or insulin (section 213(b)); a case classifying an item as 'medicine or drug' asserts this condition before including it in `medical_care_expense_paid`, since the statute conditions inclusion, not a separate allowance";
    when medical_care_expense_paid(p, y, item, amount);
    when is_medicine_or_drug_item(p, y, item);
    when not prescribed_drug_or_insulin(p, y, item);
    then not deduction_allowed(p, y, Section213Medical, amount);
}
pub relation is_medicine_or_drug_item(p: Individual, y: TaxableYear, item: Integer) kind empirical {
    label en official "the medical care item is an amount paid for medicine or a drug (section 213(b))";
}
pub relation prescribed_drug_or_insulin(p: Individual, y: TaxableYear, item: Integer) kind empirical {
    label en official "the medicine or drug is a prescribed drug or is insulin (section 213(b))";
}
// (c) special rule for decedents, (d) the full "medical care" definition
// (including long-term care, lodging, capital expenditures for medical
// purposes), and §212 stay "stage 2".
