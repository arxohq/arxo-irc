// Section 280A — use as a residence, personal use, rental proration, definitions: stage 2b detail
// (TECH_GAPS G2797): (d) the residence test with day counting, (d)(2) personal-use days,
// (d)(3) rentals as a principal residence and shared equity financing, (d)(4) qualified rental
// periods, (e) proration of rental expenses, (f) definitions and coordination. The per-day facts
// are for the taxable year in question (the year is not re-derived from each date). Not modelled:
// the Secretary's regulations on repairs and annual maintenance under (d)(2) (external), the
// section 119 and 121 tests (facts), the family definition of section 267(c)(4) (a fact).

// --- (d)(2): personal use of a unit, day by day ---------------------------------------------------------------------------

use self::{
    IRC_S280A_D,
    IRC_S280A_E,
    IRC_S280A_F,
    Person,
    TaxableYear,
};

pub relation unit_used_on_day_by_taxpayer_or_interest_holder_or_family(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "for any part of the day the unit is used for personal purposes by the taxpayer or any other person with an interest in the unit, or by a member of the family (section 267(c)(4)) of either (section 280A(d)(2)(A))";
}
pub relation unit_used_on_day_under_exchange_arrangement(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "the unit is used by an individual under an arrangement enabling the taxpayer to use some other dwelling unit, whether or not rent is charged (section 280A(d)(2)(B))";
}
pub relation unit_used_on_day_by_other_individual(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "the unit is used by an individual other than an employee with respect to whose use section 119 applies (section 280A(d)(2)(C))";
}
pub relation unit_rented_at_fair_rental_for_day(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "for the day the dwelling unit is rented for a rental which, under the facts and circumstances, is fair rental (section 280A(d)(2)(C))";
}
pub relation day_rented_to_person_as_principal_residence_at_fair_rental(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "for the day the unit is rented, at a fair rental, to any person for use as such person's principal residence (section 280A(d)(3)(A))";
}
pub relation rental_to_person_having_interest_in_unit(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "the rental is to a person who has an interest in the dwelling unit (section 280A(d)(3)(B))";
}
pub relation rental_pursuant_to_shared_equity_financing_agreement(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "the rental is pursuant to a shared equity financing agreement (section 280A(d)(3)(B)(i))";
}
pub relation rental_of_principal_residence_not_personal_use(p: Person, unit: Integer, day: Date) kind institutional {
    label en official "the day is not personal use by reason of a rental of the unit at a fair rental as the occupant's principal residence (section 280A(d)(3))";
}
@source(IRC_S280A_D, quote = "A taxpayer shall not be treated as using a dwelling unit for personal purposes by reason of a rental arrangement for any period if for such period such dwelling unit is rented, at a fair rental, to any person for use as such person's principal residence.")
rule RentalAsPrincipalResidenceNotPersonalUse(p: Person, unit: Integer, day: Date) defeasible {
    label en official "a fair-rental letting as another person's principal residence is not personal use, except that a letting to a person with an interest in the unit counts only under a shared equity financing agreement (section 280A(d)(3)(A),(B)(i))";
    when day_rented_to_person_as_principal_residence_at_fair_rental(p, unit, day);
    when not_known(rental_to_person_having_interest_in_unit(p, unit, day));
    then rental_of_principal_residence_not_personal_use(p, unit, day);
}
@source(IRC_S280A_D, quote = "Subparagraph (A) shall apply to a rental to a person who has an interest in the dwelling unit only if such rental is pursuant to a shared equity financing agreement.")
rule RentalToInterestHolderNotPersonalUseOnlyUnderSharedEquity(p: Person, unit: Integer, day: Date) defeasible {
    label en official "a letting to a person having an interest in the unit is not personal use only under a shared equity financing agreement (section 280A(d)(3)(B)(i))";
    when day_rented_to_person_as_principal_residence_at_fair_rental(p, unit, day);
    when rental_to_person_having_interest_in_unit(p, unit, day);
    when rental_pursuant_to_shared_equity_financing_agreement(p, unit, day);
    then rental_of_principal_residence_not_personal_use(p, unit, day);
}
pub relation shared_equity_agreement_two_or_more_persons_acquire_qualified_interests(agreement: Integer) kind empirical {
    label en official "2 or more persons acquire qualified ownership interests in a dwelling unit (section 280A(d)(3)(C)(i))";
}
pub relation shared_equity_holder_entitled_to_occupy_as_principal_residence(agreement: Integer) kind empirical {
    label en official "the holder of one or more interests is entitled to occupy the unit as a principal residence (section 280A(d)(3)(C)(ii)(I))";
}
pub relation shared_equity_holder_required_to_pay_rent_to_other_holders(agreement: Integer) kind empirical {
    label en official "the holder is required to pay rent to one or more other persons holding qualified ownership interests (section 280A(d)(3)(C)(ii)(II))";
}
pub relation shared_equity_financing_agreement(agreement: Integer) kind institutional {
    label en official "a shared equity financing agreement within section 280A(d)(3)(C)";
}
@source(IRC_S280A_D, quote = "the term \"shared equity financing agreement\" means an agreement under which")
rule SharedEquityFinancingAgreementDefinition(agreement: Integer) strict {
    label en official "an agreement under which 2 or more persons acquire qualified ownership interests and the occupying holder must pay rent to the other holders (section 280A(d)(3)(C))";
    when shared_equity_agreement_two_or_more_persons_acquire_qualified_interests(agreement);
    when shared_equity_holder_entitled_to_occupy_as_principal_residence(agreement);
    when shared_equity_holder_required_to_pay_rent_to_other_holders(agreement);
    then shared_equity_financing_agreement(agreement);
}
pub relation undivided_interest_in_entire_unit_years(interest: Integer, years: Integer) kind empirical {
    label en official "the duration in years of an undivided interest in the entire dwelling unit and appurtenant land acquired in the transaction to which the shared equity financing agreement relates (section 280A(d)(3)(D))";
}
pub relation qualified_ownership_interest(interest: Integer) kind institutional {
    label en official "a qualified ownership interest within section 280A(d)(3)(D)";
}
@source(IRC_S280A_D, quote = "an undivided interest for more than 50 years in the entire dwelling unit")
rule QualifiedOwnershipInterestOverFiftyYears(interest: Integer, years: Integer) strict {
    label en official "an undivided interest for more than 50 years in the entire unit is a qualified ownership interest (section 280A(d)(3)(D))";
    when undivided_interest_in_entire_unit_years(interest, years);
    when years > 50;
    then qualified_ownership_interest(interest);
}
pub relation personal_use_day(p: Person, unit: Integer, day: Date) kind institutional {
    label en official "the taxpayer is deemed to have used the dwelling unit for personal purposes on the day (section 280A(d)(2))";
}
@source(IRC_S280A_D, quote = "(A) for personal purposes by the taxpayer or any other person who has an interest in such unit, or by any member of the family (as defined in section 267(c)(4)) of the taxpayer or such other person;")
rule PersonalUseDayByTaxpayerInterestHolderOrFamily(p: Person, unit: Integer, day: Date) defeasible {
    label en official "use by the taxpayer, an interest holder or a family member is personal use, unless the day is a fair-rental letting as a principal residence (section 280A(d)(2)(A),(3))";
    when unit_used_on_day_by_taxpayer_or_interest_holder_or_family(p, unit, day);
    when not_known(rental_of_principal_residence_not_personal_use(p, unit, day));
    then personal_use_day(p, unit, day);
}
@source(IRC_S280A_D, quote = "(B) by any individual who uses the unit under an arrangement which enables the taxpayer to use some other dwelling unit")
rule PersonalUseDayExchangeArrangement(p: Person, unit: Integer, day: Date) defeasible {
    label en official "use under an arrangement enabling the taxpayer to use another dwelling unit is personal use (section 280A(d)(2)(B))";
    when unit_used_on_day_under_exchange_arrangement(p, unit, day);
    then personal_use_day(p, unit, day);
}
@source(IRC_S280A_D, quote = "(C) by any individual (other than an employee with respect to whose use section 119 applies), unless for such day the dwelling unit is rented for a rental which, under the facts and circumstances, is fair rental.")
rule PersonalUseDayOtherIndividualUnlessFairRental(p: Person, unit: Integer, day: Date) defeasible {
    label en official "use by any other individual is personal use unless the unit is rented for that day at a fair rental (section 280A(d)(2)(C))";
    when unit_used_on_day_by_other_individual(p, unit, day);
    when not_known(unit_rented_at_fair_rental_for_day(p, unit, day));
    then personal_use_day(p, unit, day);
}

// --- (d)(4): qualified rental period -----------------------------------------------------------------------------------------

pub relation rental_period_consecutive_months_begins_or_ends_in_year(p: Person, y: TaxableYear, unit: Integer, months: Integer) kind empirical {
    label en official "the length in months of a consecutive period which begins or ends in the taxable year for which the unit is rented, or is held for rental, at a fair rental (section 280A(d)(4)(B)(i))";
}
pub relation rental_period_begins_in_year_and_ends_with_sale_or_exchange(p: Person, y: TaxableYear, unit: Integer, months: Integer) kind empirical {
    label en official "the length in months of a period beginning in the taxable year at the end of which the unit is sold or exchanged, for which the unit is rented or held for rental at a fair rental (section 280A(d)(4)(B)(ii))";
}
pub relation qualified_rental_period_before_or_after(p: Person, y: TaxableYear, unit: Integer) kind institutional {
    label en official "a qualified rental period of section 280A(d)(4)(B)(i): 12 or more months beginning or ending in the year";
}
pub relation qualified_rental_period_before_only(p: Person, y: TaxableYear, unit: Integer) kind institutional {
    label en official "a qualified rental period of section 280A(d)(4)(B)(ii): less than 12 months beginning in the year and ending with a sale or exchange";
}
@source(IRC_S280A_D, quote = "12 or more months which begins or ends in such taxable year")
rule QualifiedRentalPeriodTwelveMonths(p: Person, y: TaxableYear, unit: Integer, months: Integer) strict {
    label en official "a consecutive period of 12 or more months beginning or ending in the year is a qualified rental period (section 280A(d)(4)(B)(i))";
    when rental_period_consecutive_months_begins_or_ends_in_year(p, y, unit, months);
    when months >= 12;
    then qualified_rental_period_before_or_after(p, y, unit);
}
@source(IRC_S280A_D, quote = "less than 12 months which begins in such taxable year and at the end of which such dwelling unit is sold or exchanged")
rule QualifiedRentalPeriodShortEndingInSale(p: Person, y: TaxableYear, unit: Integer, months: Integer) strict {
    label en official "a period of under 12 months beginning in the year and ending with a sale or exchange is a qualified rental period (section 280A(d)(4)(B)(ii))";
    when rental_period_begins_in_year_and_ends_with_sale_or_exchange(p, y, unit, months);
    when months < 12;
    then qualified_rental_period_before_only(p, y, unit);
}
pub relation day_is_principal_residence_day_before_or_after_period(p: Person, unit: Integer, day: Date, before: Boolean) kind empirical {
    label en official "the day is a day when the unit is the taxpayer's principal residence (section 121) and occurs before (true) or after (false) the qualified rental period";
}
pub relation day_not_personal_use_for_qualified_rental_period(p: Person, y: TaxableYear, unit: Integer, day: Date) kind institutional {
    label en official "for applying subsection (c)(5) to a qualified rental period the day is not personal use (section 280A(d)(4)(A))";
}
@source(IRC_S280A_D, quote = "a taxpayer shall not be considered to have used a dwelling unit for personal purposes for any day during the taxable year which occurs before or after a qualified rental period")
rule PrincipalResidenceDayBeforeOrAfterPeriodNotPersonalUse(p: Person, y: TaxableYear, unit: Integer, day: Date) defeasible {
    label en official "a principal-residence day before or after a 12-month qualified rental period is not personal use (section 280A(d)(4)(A))";
    when qualified_rental_period_before_or_after(p, y, unit);
    when day_is_principal_residence_day_before_or_after_period(p, unit, day, true);
    then day_not_personal_use_for_qualified_rental_period(p, y, unit, day);
}
@source(IRC_S280A_D, quote = "or before a qualified rental period described in subparagraph (B)(ii)")
rule PrincipalResidenceDayAfterPeriodNotPersonalUse(p: Person, y: TaxableYear, unit: Integer, day: Date) defeasible {
    label en official "a principal-residence day after a 12-month qualified rental period is not personal use (section 280A(d)(4)(A))";
    when qualified_rental_period_before_or_after(p, y, unit);
    when day_is_principal_residence_day_before_or_after_period(p, unit, day, false);
    then day_not_personal_use_for_qualified_rental_period(p, y, unit, day);
}
@source(IRC_S280A_D, quote = "or before a qualified rental period described in subparagraph (B)(ii)")
rule PrincipalResidenceDayBeforeShortPeriodNotPersonalUse(p: Person, y: TaxableYear, unit: Integer, day: Date) defeasible {
    label en official "a principal-residence day before a short qualified rental period ending in a sale is not personal use (section 280A(d)(4)(A))";
    when qualified_rental_period_before_only(p, y, unit);
    when day_is_principal_residence_day_before_or_after_period(p, unit, day, true);
    then day_not_personal_use_for_qualified_rental_period(p, y, unit, day);
}

// --- (d)(1): use as a residence ------------------------------------------------------------------------------------------------------

pub relation day_rented_at_fair_rental_counted(p: Person, unit: Integer, day: Date) kind institutional {
    label en official "a day for which the unit is rented at a fair rental and not used for personal purposes (section 280A(d)(1) last sentence)";
}
@source(IRC_S280A_D, quote = "a unit shall not be treated as rented at a fair rental for any day for which it is used for personal purposes")
rule FairRentalDayNotPersonalUse(p: Person, unit: Integer, day: Date) defeasible {
    label en official "a day rented at a fair rental counts for the 10-percent test only if the unit is not used for personal purposes that day (section 280A(d)(1))";
    when unit_rented_at_fair_rental_for_day(p, unit, day);
    when not_known(personal_use_day(p, unit, day));
    then day_rented_at_fair_rental_counted(p, unit, day);
}
pub relation unit_used_as_residence_280ad(p: Person, y: TaxableYear, unit: Integer) kind institutional {
    label en official "the taxpayer uses the dwelling unit during the taxable year as a residence: personal use days exceed the greater of 14 days or 10 percent of the days rented at a fair rental (section 280A(d)(1))";
}
@source(IRC_S280A_D, quote = "if he uses such unit (or portion thereof) for personal purposes for a number of days which exceeds the greater of")
rule UnitUsedAsResidencePersonalDaysExceedThreshold(p: Person, y: TaxableYear, unit: Integer) defeasible {
    label en official "personal use for more than the greater of 14 days and 10 percent of the fair-rental days makes the unit used as a residence (section 280A(d)(1)); the comparison is integer: personal days times 10 above the rental days";
    when dwelling_unit_in_taxable_year(p, y, unit);
    when count(collect d: Date where personal_use_day(p, unit, d)) > 14;
    when count(collect d: Date where personal_use_day(p, unit, d)) * 10 > count(collect d: Date where day_rented_at_fair_rental_counted(p, unit, d));
    then unit_used_as_residence_280ad(p, y, unit);
}
pub relation dwelling_unit_in_taxable_year(p: Person, y: TaxableYear, unit: Integer) kind empirical {
    label en official "the taxpayer holds or uses the dwelling unit in the taxable year (binds the year of the residence test)";
}

// --- (e): proration of rental expenses ---------------------------------------------------------------------------------------------------

pub relation taxpayer_is_individual_or_s_corporation(p: Person) kind empirical {
    label en official "the taxpayer is an individual or an S corporation (section 280A(e)(1))";
}
pub relation unit_used_for_personal_purposes_on_some_day(p: Person, y: TaxableYear, unit: Integer) kind empirical {
    label en official "the taxpayer uses the unit for personal purposes on any day during the taxable year, whether or not it is a residence (section 280A(e)(1))";
}
pub relation rental_expenses_of_unit_for_year(p: Person, y: TaxableYear, unit: Integer, amount: Money) kind empirical {
    label en official "the expenses attributable to the rental of the unit (or portion) for the taxable year (section 280A(e)(1))";
}
pub relation days_rented_at_fair_rental_in_year(p: Person, y: TaxableYear, unit: Integer, days: Integer) kind empirical {
    label en official "the number of days in the year the unit (or portion) is rented at a fair rental (section 280A(e)(1))";
}
pub relation total_days_unit_used_in_year(p: Person, y: TaxableYear, unit: Integer, days: Integer) kind empirical {
    label en official "the total number of days in the year the unit (or portion) is used (section 280A(e)(1))";
}
pub relation deductions_allowable_whether_or_not_rented(p: Person, y: TaxableYear, unit: Integer) kind empirical {
    label en official "the deductions would be allowable for the year whether or not the unit was rented (section 280A(e)(2))";
}
pub relation rental_expenses_deductible_after_proration(p: Person, y: TaxableYear, unit: Integer, amount: Money) kind institutional {
    label en official "the amount deductible for rental expenses: not more than the expenses times fair-rental days over total days of use (section 280A(e)(1))";
}
@source(IRC_S280A_E, quote = "shall not exceed an amount which bears the same relationship to such expenses as the number of days during each year that the unit (or portion thereof) is rented at a fair rental bears to the total number of days during such year that the unit (or portion thereof) is used")
rule RentalExpensesProratedByFairRentalDays(p: Person, y: TaxableYear, unit: Integer, expenses: Money, rented: Integer, total: Integer) defeasible {
    label en official "rental expenses are limited to the fair-rental days fraction of the days of use, with one rounding to cents HALF_UP (JUDGMENT CALL) (section 280A(e)(1))";
    when taxpayer_is_individual_or_s_corporation(p);
    when unit_used_for_personal_purposes_on_some_day(p, y, unit);
    when rental_expenses_of_unit_for_year(p, y, unit, expenses);
    when days_rented_at_fair_rental_in_year(p, y, unit, rented);
    when total_days_unit_used_in_year(p, y, unit, total);
    when total > 0;
    when not_known(deductions_allowable_whether_or_not_rented(p, y, unit));
    then rental_expenses_deductible_after_proration(p, y, unit, div_round(expenses * rented, total * 1.0, 2, "HALF_UP"));
}

// --- (f): definitions and coordination ---------------------------------------------------------------------------------------------------

pub relation property_is_house_apartment_condominium_mobile_home_boat_or_similar(prop: Integer) kind empirical {
    label en official "the property is a house, apartment, condominium, mobile home, boat or similar property, with appurtenant structures and property (section 280A(f)(1)(A))";
}
pub relation portion_used_exclusively_as_hotel_motel_inn_or_similar(prop: Integer) kind empirical {
    label en official "that portion of a unit which is used exclusively as a hotel, motel, inn or similar establishment (section 280A(f)(1)(B))";
}
pub relation dwelling_unit_280a(prop: Integer) kind institutional {
    label en official "a dwelling unit within section 280A(f)(1)";
}
@source(IRC_S280A_F, quote = "The term \"dwelling unit\" includes a house, apartment, condominium, mobile home, boat, or similar property")
rule DwellingUnitDefinition(prop: Integer) defeasible {
    label en official "a house, apartment, condominium, mobile home, boat or similar property is a dwelling unit, except the portion used exclusively as a hotel or similar establishment (section 280A(f)(1))";
    when property_is_house_apartment_condominium_mobile_home_boat_or_similar(prop);
    when not_known(portion_used_exclusively_as_hotel_motel_inn_or_similar(prop));
    then dwelling_unit_280a(prop);
}
pub relation taxpayer_is_s_corporation_for_280a(p: Person) kind empirical {
    label en official "the taxpayer is an S corporation (section 280A(f)(2))";
}
pub relation shareholder_of_s_corporation(p: Person, shareholder: Person) kind empirical {
    label en official "the person is a shareholder of the S corporation";
}
pub relation unit_used_on_day_by_s_corporation_shareholder(p: Person, unit: Integer, day: Date) kind empirical {
    label en official "the unit is used on the day for personal purposes by a shareholder of the S corporation (section 280A(f)(2))";
}
@source(IRC_S280A_F, quote = "In the case of an S corporation, subparagraphs (A) and (B) of subsection (d)(2) shall be applied by substituting \"any shareholder of the S corporation\" for \"the taxpayer\" each place it appears.")
rule SCorporationPersonalUseByShareholder(p: Person, unit: Integer, day: Date) defeasible {
    label en official "for an S corporation, personal use by any shareholder is personal use of the corporation (section 280A(f)(2))";
    when taxpayer_is_s_corporation_for_280a(p);
    when unit_used_on_day_by_s_corporation_shareholder(p, unit, day);
    then personal_use_day(p, unit, day);
}
pub relation section_183_not_applicable_to_unit_for_year(p: Person, y: TaxableYear, unit: Integer) kind institutional {
    label en official "section 183 does not apply to the unit (or portion) for the year (section 280A(f)(3)(A))";
}
pub relation year_counted_for_183d_five_year_presumption(p: Person, y: TaxableYear, unit: Integer) kind institutional {
    label en official "the year is taken into account as a taxable year for applying section 183(d) (section 280A(f)(3)(B))";
}
pub relation section_280a_a_applies_to_unit_for_year(p: Person, y: TaxableYear, unit: Integer) kind empirical {
    label en official "subsection (a) applies with respect to the dwelling unit (or portion) for the taxable year (section 280A(f)(3))";
}
@source(IRC_S280A_F, quote = "section 183 (relating to activities not engaged in for profit) shall not apply to such unit (or portion thereof) for such year")
rule Section183DisplacedWhen280aApplies(p: Person, y: TaxableYear, unit: Integer) strict {
    label en official "where subsection (a) applies, section 183 does not apply for the year (section 280A(f)(3)(A))";
    when section_280a_a_applies_to_unit_for_year(p, y, unit);
    then section_183_not_applicable_to_unit_for_year(p, y, unit);
}
@source(IRC_S280A_F, quote = "such year shall be taken into account as a taxable year for purposes of applying subsection (d) of section 183")
rule YearCountsFor183dWhen280aApplies(p: Person, y: TaxableYear, unit: Integer) strict {
    label en official "the year still counts toward the 5-year presumption of section 183(d) (section 280A(f)(3)(B))";
    when section_280a_a_applies_to_unit_for_year(p, y, unit);
    then year_counted_for_183d_five_year_presumption(p, y, unit);
}
pub relation deduction_meets_162a2_away_from_home_tests(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a deduction allowable under section 162(a)(2), or one meeting its tests under another provision, by reason of being away from home in the pursuit of a trade or business other than renting dwelling units (section 280A(f)(4))";
}
pub relation section_280a_does_not_disallow_162a2_deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "section 280A does not disallow the deduction (section 280A(f)(4))";
}
@source(IRC_S280A_F, quote = "Nothing in this section shall be construed to disallow any deduction allowable under section 162(a)(2)")
rule Section280aDoesNotDisallow162a2(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a section 162(a)(2) away-from-home deduction is not disallowed by section 280A (section 280A(f)(4))";
    when deduction_meets_162a2_away_from_home_tests(p, y, item, amount);
    then section_280a_does_not_disallow_162a2_deduction(p, y, item, amount);
}
