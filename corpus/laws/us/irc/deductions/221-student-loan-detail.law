// Section 221 — interest on education loans: stage 2b detail (TECH_GAPS G2803): (a) the allowance
// from loan-level facts, (d) the definitions (qualified education loan, qualified higher education
// expenses), (e) the double-benefit denial and the joint-return condition, (f) the indexing of the
// phase-out amounts. The (b) cap and phase-out stay in `221-student-loan.law`. Not modelled: the
// section 25A(b)(3) eligible student and section 25A(f)(2) eligible educational institution
// definitions, the section 152 dependent definition, section 7703 marital status (facts/external),
// section 472 cost of attendance (a fact).

// --- (d)(1): qualified education loan ----------------------------------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S221_A,
    IRC_S221_D,
    IRC_S221_E,
    IRC_S221_F,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
    qualified_education_loan_interest_paid,
    taxable_year_begins_on,
};

pub relation education_loan_incurred_by_taxpayer(p: Individual, loan: Integer) kind empirical {
    label en official "indebtedness incurred by the taxpayer (section 221(d)(1))";
}
pub relation loan_incurred_solely_to_pay_qualified_higher_education_expenses(loan: Integer) kind empirical {
    label en official "the indebtedness was incurred solely to pay qualified higher education expenses (section 221(d)(1))";
}
pub relation expenses_incurred_on_behalf_of_taxpayer_spouse_or_dependent_when_loan_incurred(loan: Integer) kind empirical {
    label en official "the expenses are incurred on behalf of the taxpayer, the taxpayer's spouse or any dependent of the taxpayer as of the time the indebtedness was incurred (section 221(d)(1)(A))";
}
external judgment relation expenses_paid_within_reasonable_period_of_loan(loan: Integer) {
    authority TaxCourt;
    label en official "the expenses are paid or incurred within a reasonable period of time before or after the indebtedness is incurred (section 221(d)(1)(B))";
}
pub relation education_furnished_while_recipient_eligible_student(loan: Integer) kind empirical {
    label en official "the expenses are attributable to education furnished during a period during which the recipient was an eligible student (section 221(d)(1)(C))";
}
pub relation loan_refinances_a_qualified_education_loan(loan: Integer, refinanced: Integer) kind empirical {
    label en official "the indebtedness was used to refinance indebtedness which qualifies as a qualified education loan (section 221(d)(1))";
}
pub relation loan_owed_to_related_person_267b_or_707b1(loan: Integer) kind empirical {
    label en official "the indebtedness is owed to a person related (within section 267(b) or 707(b)(1)) to the taxpayer (section 221(d)(1))";
}
pub relation loan_under_qualified_employer_plan_or_72p5_contract(loan: Integer) kind empirical {
    label en official "the indebtedness is by reason of a loan under a qualified employer plan (section 72(p)(4)) or under a contract referred to in section 72(p)(5) (section 221(d)(1))";
}
pub relation qualified_education_loan_original(loan: Integer) kind institutional {
    label en official "indebtedness meeting the conditions of section 221(d)(1)(A)-(C) directly (not by refinancing)";
}
pub relation qualified_education_loan(loan: Integer) kind institutional {
    label en official "a qualified education loan within section 221(d)(1): directly qualifying, or refinancing one such loan (one refinancing level is modelled)";
}
rule QualifiedEducationLoanFromOriginal(loan: Integer) defeasible {
    label en official "a directly qualifying loan is a qualified education loan (section 221(d)(1))";
    when qualified_education_loan_original(loan);
    then qualified_education_loan(loan);
}
@source(IRC_S221_D, quote = "The term \"qualified education loan\" means any indebtedness incurred by the taxpayer solely to pay qualified higher education expenses")
rule QualifiedEducationLoanDefinition(p: Individual, loan: Integer) defeasible {
    label en official "indebtedness incurred solely for qualified higher education expenses of the taxpayer, spouse or dependent, timely and for an eligible student, is a qualified education loan, unless owed to a related person or under an employer plan or section 72(p)(5) contract (section 221(d)(1))";
    when education_loan_incurred_by_taxpayer(p, loan);
    when loan_incurred_solely_to_pay_qualified_higher_education_expenses(loan);
    when expenses_incurred_on_behalf_of_taxpayer_spouse_or_dependent_when_loan_incurred(loan);
    when expenses_paid_within_reasonable_period_of_loan(loan);
    when education_furnished_while_recipient_eligible_student(loan);
    when not_known(loan_owed_to_related_person_267b_or_707b1(loan));
    when not_known(loan_under_qualified_employer_plan_or_72p5_contract(loan));
    then qualified_education_loan_original(loan);
}
@source(IRC_S221_D, quote = "Such term includes indebtedness used to refinance indebtedness which qualifies as a qualified education loan.")
rule RefinancedQualifiedEducationLoan(p: Individual, loan: Integer, refinanced: Integer) defeasible {
    label en official "indebtedness used to refinance a qualified education loan is itself a qualified education loan, unless owed to a related person or under an employer plan (section 221(d)(1))";
    when education_loan_incurred_by_taxpayer(p, loan);
    when loan_refinances_a_qualified_education_loan(loan, refinanced);
    when qualified_education_loan_original(refinanced);
    when not_known(loan_owed_to_related_person_267b_or_707b1(loan));
    when not_known(loan_under_qualified_employer_plan_or_72p5_contract(loan));
    then qualified_education_loan(loan);
}

// --- (d)(2): qualified higher education expenses ------------------------------------------------------------------------------------------

pub relation cost_of_attendance_at_eligible_educational_institution(loan: Integer, amount: Money) kind empirical {
    label en official "the cost of attendance (section 472 of the Higher Education Act of 1965 as in effect on the day before the enactment of the Taxpayer Relief Act of 1997) at an eligible educational institution (section 221(d)(2))";
}
pub relation amount_excluded_under_127_135_529_or_530_by_reason_of_expenses(loan: Integer, amount: Money) kind empirical {
    label en official "the amount excluded from gross income under section 127, 135, 529 or 530 by reason of such expenses (section 221(d)(2)(A))";
}
pub relation scholarship_allowance_or_payment_described_in_25Ag2(loan: Integer, amount: Money) kind empirical {
    label en official "the amount of any scholarship, allowance or payment described in section 25A(g)(2) (section 221(d)(2)(B))";
}
pub relation qualified_higher_education_expenses_221(loan: Integer, amount: Money) kind institutional {
    label en official "the qualified higher education expenses: cost of attendance reduced by the excluded amounts and scholarships, not below zero (section 221(d)(2))";
}
@source(IRC_S221_D, quote = "The term \"qualified higher education expenses\" means the cost of attendance")
rule QualifiedHigherEducationExpensesNetOfExclusions(loan: Integer, cost: Money, excluded: Money, scholarship: Money) strict {
    label en official "cost of attendance less the section 127/135/529/530 exclusions and the section 25A(g)(2) payments, not below zero (section 221(d)(2))";
    when cost_of_attendance_at_eligible_educational_institution(loan, cost);
    when amount_excluded_under_127_135_529_or_530_by_reason_of_expenses(loan, excluded);
    when scholarship_allowance_or_payment_described_in_25Ag2(loan, scholarship);
    then qualified_higher_education_expenses_221(loan, max(0.00 USD, cost - excluded - scholarship));
}
pub relation institution_is_internship_or_residency_program_hospital_or_postgraduate_health_facility(inst: Integer) kind empirical {
    label en official "an institution conducting an internship or residency program leading to a degree or certificate awarded by an institution of higher education, a hospital, or a health care facility which offers postgraduate training (section 221(d)(2) last sentence)";
}
pub relation institution_is_eligible_educational_institution_25Af2(inst: Integer) kind empirical {
    label en official "the institution is an eligible educational institution within section 25A(f)(2)";
}
pub relation eligible_educational_institution_221(inst: Integer) kind institutional {
    label en official "an eligible educational institution for section 221: as in section 25A(f)(2), plus internship/residency programs, hospitals and postgraduate health care facilities (section 221(d)(2))";
}
@source(IRC_S221_D, quote = "has the same meaning given such term by section 25A(f)(2), except that such term shall also include an institution conducting an internship or residency program")
rule EligibleInstitutionUnder25Af2(inst: Integer) strict {
    label en official "an institution within section 25A(f)(2) is eligible (section 221(d)(2))";
    when institution_is_eligible_educational_institution_25Af2(inst);
    then eligible_educational_institution_221(inst);
}
@source(IRC_S221_D, quote = "a hospital, or a health care facility which offers postgraduate training")
rule EligibleInstitutionInternshipHospitalPostgraduate(inst: Integer) strict {
    label en official "an internship or residency institution, hospital or postgraduate training facility is also eligible (section 221(d)(2))";
    when institution_is_internship_or_residency_program_hospital_or_postgraduate_health_facility(inst);
    then eligible_educational_institution_221(inst);
}

// --- (a): allowance from loan-level interest ------------------------------------------------------------------------------------------------

pub relation interest_paid_on_education_loan(p: Individual, y: TaxableYear, loan: Integer, amount: Money) kind empirical {
    label en official "interest paid by the taxpayer during the taxable year on an education loan (section 221(a))";
}
pub relation qualified_loan_interest_paid(p: Individual, y: TaxableYear, loan: Integer, amount: Money) kind institutional {
    label en official "interest paid during the taxable year on a qualified education loan (section 221(a))";
}
@source(IRC_S221_A, quote = "there shall be allowed as a deduction for the taxable year an amount equal to the interest paid by the taxpayer during the taxable year on any qualified education loan")
rule QualifiedLoanInterestPaid(p: Individual, y: TaxableYear, loan: Integer, amount: Money) defeasible {
    label en official "interest paid on a qualified education loan is the base of the section 221(a) deduction";
    when interest_paid_on_education_loan(p, y, loan, amount);
    when qualified_education_loan(loan);
    then qualified_loan_interest_paid(p, y, loan, amount);
}
pub relation qualified_loan_interest_total(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total interest paid during the taxable year on qualified education loans (section 221(a))";
}
rule QualifiedLoanInterestTotalDerived(p: Individual, y: TaxableYear, l0: Integer, a0: Money) defeasible {
    label en official "helper: sums the qualified loan interest of the taxable year (section 221(a))";
    when qualified_loan_interest_paid(p, y, l0, a0);
    then qualified_loan_interest_total(p, y,
        sum all amount: Money for loan: Integer where qualified_loan_interest_paid(p, y, loan, amount));
}

// --- (e): double benefit, joint return -------------------------------------------------------------------------------------------------------

pub relation amount_deductible_under_other_provision_of_chapter_1(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the interest for which a deduction is allowable under any other provision of chapter 1 (section 221(e)(1))";
}
pub relation employer_payment_of_loan_excluded_under_127(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount for which an exclusion is allowable under section 127 by reason of the employer's payment of indebtedness on a qualified education loan of the taxpayer (section 221(e)(1))";
}
pub relation section_529c9_distribution_treated_as_qualified_expense_reduction(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the distributions treated as a qualified higher education expense under section 529(c)(9) with respect to loans of the taxpayer as would be includible in gross income under section 529(c)(3)(A) but for that treatment (section 221(e)(1) last sentence)";
}
pub relation student_loan_interest_after_double_benefit_denial(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest for the deduction after removing amounts deductible or excludable elsewhere and after the section 529(c)(9) reduction, not below zero (section 221(e)(1))";
}
@source(IRC_S221_E, quote = "No deduction shall be allowed under this section for any amount for which a deduction is allowable under any other provision of this chapter")
rule StudentLoanInterestAfterDoubleBenefitDenial(p: Individual, y: TaxableYear, total: Money, other: Money, exclusion: Money, distribution: Money) defeasible {
    label en official "the section 221(a) amount is reduced by amounts deductible under another provision and by the section 127 exclusion, then by the section 529(c)(9) amount, not below zero (section 221(e)(1)); each element is a fact, zero when none";
    when qualified_loan_interest_total(p, y, total);
    when amount_deductible_under_other_provision_of_chapter_1(p, y, other);
    when employer_payment_of_loan_excluded_under_127(p, y, exclusion);
    when section_529c9_distribution_treated_as_qualified_expense_reduction(p, y, distribution);
    then student_loan_interest_after_double_benefit_denial(p, y, max(0.00 USD, total - other - exclusion - distribution));
}
pub relation married_at_close_of_taxable_year_221(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer is married at the close of the taxable year, determined under section 7703 (section 221(e)(2),(3))";
}
pub relation taxpayer_and_spouse_file_joint_return_221(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer and the taxpayer's spouse file a joint return for the taxable year (section 221(e)(2))";
}
@source(IRC_S221_E, quote = "If the taxpayer is married at the close of the taxable year, the deduction shall be allowed under subsection (a) only if the taxpayer and the taxpayer's spouse file a joint return for the taxable year.")
rule MarriedTaxpayerMustFileJointReturn(p: Individual, y: TaxableYear, interest: Money) defeasible {
    label en official "a taxpayer married at the close of the year has no section 221 deduction without a joint return (section 221(e)(2))";
    when married_at_close_of_taxable_year_221(p, y);
    when qualified_education_loan_interest_paid(p, y, interest);
    when not_known(taxpayer_and_spouse_file_joint_return_221(p, y));
    then not deduction_allowed(p, y, Section221StudentLoanInterest, interest);
}

// --- (f): indexing ----------------------------------------------------------------------------------------------------------------------------------

pub relation cost_of_living_adjustment_221_base_2001(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the cost-of-living adjustment determined under section 1(f)(3) for the calendar year in which the taxable year begins, with calendar year 2001 substituted for calendar year 2016 (section 221(f)(1)(B))";
}
pub relation section_221b2_dollar_amount_unindexed(base: Money) kind empirical {
    label en official "a dollar amount of subsection (b)(2): $50,000 or $100,000 (section 221(f)(1))";
}
pub relation section_221b2_dollar_amount_indexed(y: TaxableYear, base: Money, indexed: Money) kind institutional {
    label en official "the $50,000 or $100,000 amount increased by the amount times the cost-of-living adjustment and rounded down to a multiple of $5,000 (section 221(f)(1),(2)); for taxable years beginning after 2002";
}
@source(IRC_S221_F, quote = "In the case of a taxable year beginning after 2002, the $50,000 and $100,000 amounts in subsection (b)(2) shall each be increased by an amount equal to")
rule Section221b2AmountIndexedAfter2002(y: TaxableYear, base: Money, factor: Decimal, begins: Date) strict {
    label en official "for years beginning after 2002 the amount is raised by amount x adjustment and rounded down to the next lowest multiple of $5,000 (section 221(f)(1),(2)); the increase is computed to cents HALF_UP before the floor (JUDGMENT CALL)";
    when taxable_year_begins_on(y, begins);
    when begins > @2002-12-31;
    when section_221b2_dollar_amount_unindexed(base);
    when cost_of_living_adjustment_221_base_2001(y, factor);
    then section_221b2_dollar_amount_indexed(y, base, round((base + round(base * factor, 2, "HALF_UP")) / 5000.00 USD, 0, "FLOOR") * 5000.00 USD);
}
