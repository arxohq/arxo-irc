// Section 179 — Election to expense certain depreciable business assets.
// Stage 1 (IRC-06), priority section. Scope: (a) the election as a power;
// (b)(1)-(2) the dollar limit and its investment-based phase-down, with the
// pre-2025 base and Pub. L. 119-21 section 70306's increase; (b)(3) the
// trade-or-business-income limitation with carryover.

use self::{
    DeductionKind,
    IRC_S179_A,
    IRC_S179_B,
    Person,
    TaxableYear,
    deduction_allowed,
    section_179_election_exercisable,
};

pub relation section_179_property_cost(p: Person, y: TaxableYear, item: Integer, cost: Money) kind empirical {
    label en official "the cost of section 179 property placed in service during the taxable year (section 179(a))";
}
pub relation elects_to_expense_section_179_property(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "elects to treat the cost of the item of section 179 property as an expense not chargeable to capital account (section 179(a))";
}
pub relation section_179_election_in_effect(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the section 179(a) election is in effect for the item";
}

@source(IRC_S179_A, quote = "A taxpayer may elect to treat the cost of any section 179 property as an expense which is not chargeable to capital account")
rule Section179ElectionPowerRule(p: Person, y: TaxableYear, item: Integer, cost: Money) strict {
    label en official "a taxpayer has the power to elect to expense the cost of section 179 property placed in service during the taxable year (section 179(a))";
    when section_179_property_cost(p, y, item, cost);
    then power Section179ExpensingElection {
        holder p;
        over item;
        exercise elects_to_expense_section_179_property(p, y, item);
        valid_when section_179_election_exercisable(p, y, item);
        effect create(section_179_election_in_effect(p, y, item));
        window [@1981-01-01, infinity);
    };
}

pub relation section_179_aggregate_cost_placed_in_service(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate cost of section 179 property placed in service during the taxable year (for the section 179(b)(2) phase-down), sum of elected items' cost";
}
pub relation active_trade_or_business_taxable_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "aggregate taxable income derived from the active conduct of any trade or business, computed without regard to the section 179 deduction (section 179(b)(3)(A),(C))";
}
pub relation section_179_disallowed_carryover_from_prior_year(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate amount disallowed under section 179(b)(3)(A) for prior taxable years, not yet allowed (section 179(b)(3)(B)(i))";
}

@source(IRC_S179_B, quote = "The aggregate cost which may be taken into account under subsection (a) for any taxable year shall not exceed $1,000,000")
rule Section179DollarLimitBeforePhasedown(p: Person, y: TaxableYear, item: Integer, cost: Money, placed_in_service_aggregate: Money, ati: Money) defeasible {
    label en official "the section 179 deduction for an item is allowed up to the dollar limit (reduced dollar-for-dollar above the investment ceiling) and further capped by active-trade-or-business taxable income (section 179(b)(1)-(3))";
    when section_179_election_in_effect(p, y, item);
    when section_179_property_cost(p, y, item, cost);
    when section_179_aggregate_cost_placed_in_service(p, y, placed_in_service_aggregate);
    when active_trade_or_business_taxable_income(p, y, ati);
    when cost <= min(
        max(0.00 USD, round(Section179DollarLimit, 2, "HALF_UP") - max(0.00 USD, placed_in_service_aggregate - round(Section179PhaseoutThreshold, 2, "HALF_UP"))),
        ati);
    then deduction_allowed(p, y, Section179Election, cost);
}
@source(IRC_S179_B, quote = "The amount allowable as a deduction under subsection (a) for any taxable year shall be increased by the lesser of")
pub relation section_179_allowed_without_carryover(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount allowable as a section 179 deduction for the taxable year without regard to the section 179(b)(3)(B) carryover of prior-year disallowed amounts (sum of `Section179DollarLimitBeforePhasedown` conclusions for the year)";
}
rule Section179DisallowedCarryoverApplied(p: Person, y: TaxableYear, ati: Money, allowed_without_carryover: Money, carried: Money) strict {
    label en official "the current-year section 179 allowance is increased by the lesser of the prior-year disallowed carryover or the excess of active-trade-or-business income over the amount otherwise allowable (section 179(b)(3)(B))";
    when section_179_disallowed_carryover_from_prior_year(p, y, carried);
    when active_trade_or_business_taxable_income(p, y, ati);
    when section_179_allowed_without_carryover(p, y, allowed_without_carryover);
    when carried <= ati - allowed_without_carryover;
    then deduction_allowed(p, y, Section179Election, carried);
}
// --- pub interface: `section_179_deduction` -----------------------------
//
// Task-required pub name, published as a thin alias over `deduction_allowed`
// for `Section179Election`. NOTE (honest limitation): this is a passthrough,
// not a per-taxable-year SUM — if a taxpayer has several section 179 items
// in the same year (several `Section179DollarLimitBeforePhasedown`
// conclusions) plus a carryover increase, several `section_179_deduction`
// facts with different amounts are produced for the same (p, y), rather
// than one totalled figure. A true total needs an item-indexed sum (like
// `pub-interface-wiring.law`'s `itemized_deductions_total`), which this
// pass did not build for section 179 — TECH_GAP, see the report.
pub relation section_179_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount allowable as a deduction under section 179(a) for the taxable year (per allowed component; see the note above on aggregation)";
}
rule Section179DeductionPublished(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "publishes the section 179 deduction component under the task-required pub name";
    when deduction_allowed(p, y, Section179Election, amount);
    then section_179_deduction(p, y, amount);
}

// (b)(4) married-filing-separately allocation, (b)(5) sport-utility-vehicle
// $25,000 sub-cap, (c) election/revocation mechanics, (d) property
// definitions stay NOT DONE this session (stage 2b) — TECH_GAP.
