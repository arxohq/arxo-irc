// Wiring module: composes this package's pub interface obligations toward
// `us.irc.gross_income` (§62/§63's dependency contracts) and publishes the
// package-wide aggregates named in the owner's task
// (`itemized_deductions_total`, `above_the_line_deduction`).
//
// SIMPLIFICATION: `itemized_deductions_total` sums only the FIVE Schedule-A
// categories this stage actually formalizes (interest, taxes, casualty
// losses, charitable contributions, medical expenses in excess of the
// floor); §166 nonbusiness-bad-debt (capital loss, not itemized directly),
// §162(a) trade-or-business items (above-the-line for a sole proprietor,
// not itemized), and every "stage 2" section's items are NOT included —
// this is a genuine undercount for a scenario with itemizable items outside
// the five categories, recorded here rather than silently assumed complete.

use self::{
    DeductionKind,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub enum ItemizedDeductionKind {
    QualifiedResidenceInterest;
    StateAndLocalTaxes;
    CasualtyAndTheftLosses;
    CharitableContributions;
    MedicalExpenses;
}
pub relation itemized_component(p: Individual, y: TaxableYear, kind: ItemizedDeductionKind, amount: Money) kind institutional {
    label en official "an itemized deduction component amount, bridging a section-specific `deduction_allowed` conclusion into the Schedule-A aggregate";
}

rule BridgeInterestToItemized(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges section 163(h) qualified residence interest into the itemized-deduction aggregate";
    when deduction_allowed(p, y, Section163Interest, amount);
    then itemized_component(p, y, QualifiedResidenceInterest, amount);
}
rule BridgeTaxesToItemized(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges section 164 state and local taxes into the itemized-deduction aggregate";
    when deduction_allowed(p, y, Section164Taxes, amount);
    then itemized_component(p, y, StateAndLocalTaxes, amount);
}
rule BridgeCasualtyToItemized(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges section 165(h) personal casualty losses into the itemized-deduction aggregate";
    when deduction_allowed(p, y, Section165Losses, amount);
    then itemized_component(p, y, CasualtyAndTheftLosses, amount);
}
rule BridgeCharitableToItemized(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges section 170 charitable contributions into the itemized-deduction aggregate";
    when deduction_allowed(p, y, Section170Charitable, amount);
    then itemized_component(p, y, CharitableContributions, amount);
}
rule BridgeMedicalToItemized(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges section 213 medical expenses (in excess of the floor) into the itemized-deduction aggregate";
    when deduction_allowed(p, y, Section213Medical, amount);
    then itemized_component(p, y, MedicalExpenses, amount);
}

rule ItemizedDeductionsTotalWired(p: Individual, y: TaxableYear, kind0: ItemizedDeductionKind, amount0: Money) strict {
    label en official "publishes the section 63(d) itemized-deductions total this package owes gross-income, per the pub interface contract";
    when itemized_component(p, y, kind0, amount0);
    then us.irc.gross_income::itemized_deductions_total(p, y,
        sum all amount: Money for kind: ItemizedDeductionKind where itemized_component(p, y, kind, amount));
}

// --- above_the_line_deduction: this package's own pub relation ----------------
//
// The AGENT-BRIEF names `above_the_line_deduction(p, y, kind, amount)` as a
// deliverable pub relation. It is published here over `DeductionKind`
// (declared in `162-trade-or-business.law`) for the sections this stage
// treats as above-the-line for a sole proprietor/self-employed individual:
// section 162 trade-or-business expenses, section 219 IRA, section 221
// student loan interest, section 223 HSA. It is a DIFFERENT relation from
// `us.irc.gross_income::above_the_line_deduction_amount` (keyed by THAT
// package's own `AboveLineDeductionKind` enum).
//
// JUDGMENT CALL (26.09.2026, TECH-GAPS G498): the strict rules that derived
// gross-income's `above_the_line_deduction_amount` slots from
// `deduction_allowed` are REMOVED, not repointed. They closed a predicate
// cycle `above_the_line_deduction_amount -> deduction_allowed ->
// adjusted_gross_income -> above_the_line_deduction_amount` (§110/§103):
// the AGI rule sums the amounts in a head term, and such an enumeration is
// a completion edge under every wrapper (E-0112), so no `supported(P)`
// monotone channel can legalize the cycle — the derivation link itself had
// to go. The §62(a) slot amounts are case-asserted dependency contracts
// (as `s62-agi.law` and the coverage rows always documented them); cases
// that used the auto-derivation must now assert the slot facts directly.
// The section-223/219/221/162 norms themselves are untouched.
pub relation above_the_line_deduction(p: Individual, y: TaxableYear, kind: DeductionKind, amount: Money) kind institutional {
    label en official "an above-the-line deduction this package produces, for section 62 purposes";
}
rule AboveTheLineIraWired(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "publishes section 219 as an above-the-line deduction (section 62(a)(7) slot; the slot amount itself is a case-asserted contract in gross-income)";
    when deduction_allowed(p, y, Section219Ira, amount);
    then above_the_line_deduction(p, y, Section219Ira, amount);
}
rule AboveTheLineStudentLoanWired(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "publishes section 221 as an above-the-line deduction (section 62(a)(17) slot; the slot amount itself is a case-asserted contract in gross-income)";
    when deduction_allowed(p, y, Section221StudentLoanInterest, amount);
    then above_the_line_deduction(p, y, Section221StudentLoanInterest, amount);
}
rule AboveTheLineHsaWired(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "publishes section 223 as an above-the-line deduction (section 62(a)(19) slot; the slot amount itself is a case-asserted contract in gross-income)";
    when deduction_allowed(p, y, Section223Hsa, amount);
    then above_the_line_deduction(p, y, Section223Hsa, amount);
}
rule AboveTheLineTradeOrBusinessWired(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "publishes section 162 trade-or-business expenses as an above-the-line deduction for a self-employed individual (section 62(a)(1) slot; the slot amount itself is a case-asserted contract in gross-income)";
    when deduction_allowed(p, y, Section162TradeOrBusiness, amount);
    then above_the_line_deduction(p, y, Section162TradeOrBusiness, amount);
}

// --- nol_deduction and qbi_deduction: named pub deliverables -------------------

pub relation nol_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 172 net operating loss deduction, published under the name the owner's task specifies";
}
rule NolDeductionWired(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges the section 172 `deduction_allowed` conclusion into the named `nol_deduction` pub relation";
    when deduction_allowed(p, y, Section172Nol, amount);
    then nol_deduction(p, y, amount);
}
pub relation qbi_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 199A qualified business income deduction, published under the name the owner's task specifies (mirrors `us.irc.gross_income::section_199a_deduction`)";
}
rule QbiDeductionWired(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "bridges the section 199A deduction into the named `qbi_deduction` pub relation";
    when us.irc.gross_income::section_199a_deduction(p, y, amount);
    then qbi_deduction(p, y, amount);
}
