// Sections 171, 175, 183(e), 197, 198, 250 — stage 2c remaining detail (TECH_GAPS G2681-G2699 and neighbours):
// (171)(b)(1)(B),(C),(b)(2),(b)(3),(c)(2),(e) the reference amount, the call-year excess, the reissue on the earlier call
// date, the binding of the election, the offset against interest; (175)(c),(e),(f) the qualifying expenditures, land used in
// farming, assessments, the binding of the method, the nine-year spread; (183)(e) the election postponing the presumption;
// (197)(d)(2),(3),(f)(9)(C),(E) customer-based and supplier-based intangibles, the related person, the partner level;
// (198)(b),(c),(e) the qualified expenditure, the contaminated site, section 1245; (250)(b)(3)(B),(b)(5) domestic oil and
// gas extraction income, foreign use, related-party sales and services, the related party.
//
// Stage 1 interface changes (recorded): `bond_premium_election_in_effect` is also derived (the binding of the election);
// `environmental_remediation_expenditure`, `soil_water_conservation_expenditure` and `section_197_item_type` are now
// institutional (derived below, or still asserted by a case); the section 171 deduction rules read the amortizable premium
// of the year and carry a `not_known` guard for the offset of section 171(e); the section 250 foreign-derived rules carry
// `not_known` guards for the related-party conditions.
//
// JUDGMENT CALLS: (1) the yield-to-maturity computations (the premium attributable to a period, the allocation to interest
// payments) are figures given by the case; the section states which reference amount and which adjustment apply; (2) the
// regulations that displace (171)(b)(3)(A) and (171)(e) are not modelled; (3) the nine years of (175)(f) are given as one
// annual portion, the ledger of years is recursive (LDC-E4102); (4) the sale of the components of property under
// (250)(b)(5)(C)(i) is a fact of the item; (5) amounts are rounded to cents HALF_UP.

// === §171(b)(1): the reference amount ==========================================================================

use self::{
    Asset,
    ConservationPurposeKind,
    CooperativeIndebtednessPurpose,
    Corporation,
    IRC_S171_B,
    IRC_S171_C,
    IRC_S171_E,
    IRC_S175_C,
    IRC_S175_E,
    IRC_S175_F,
    IRC_S183_E,
    IRC_S197_D,
    IRC_S197_F,
    IRC_S198_B,
    IRC_S198_C,
    IRC_S198_E,
    IRC_S250_B,
    IncomeProductionPurpose212,
    Person,
    Section197ItemType,
    TaxableYear,
    bond_amount_payable_at_maturity,
    bond_interest_excludable_from_gross_income,
    bond_premium_attributable_to_year,
    bond_premium_election_in_effect,
    bond_premium_total_171b,
    dei_item_sale_of_property_to_non_us_person,
    environmental_remediation_election_in_effect,
    environmental_remediation_expenditure,
    gross_income_exceeded_deductions_for_year,
    item_has_components_250,
    section_197_item_type,
    soil_water_conservation_expenditure,
    soil_water_conservation_method_in_effect,
};

pub relation bond_has_call_date(p: Person, bond: Integer) kind empirical {
    label en official "the bond has a call date before maturity (section 171(b)(1)(B))";
}
pub relation bond_premium_period_before_call_via_maturity(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the bond premium attributable to the period before the call date, with reference to the amount payable on maturity (section 171(b)(1)(B))";
}
pub relation bond_premium_period_before_call_via_call_date(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the bond premium attributable to the period before the call date, with reference to the amount payable on the earlier call date (section 171(b)(1)(B))";
}
pub relation bond_call_date_reference_chosen_171b1ii(p: Person, bond: Integer) kind empirical {
    label en official "in the case of a bond whose interest is excludable, the earlier call date is the reference amount (section 171(b)(1)(B)(ii))";
}
pub relation bond_premium_before_call_171b1(p: Person, bond: Integer, amount: Money) kind institutional {
    label en official "the bond premium attributable to the period before the call date, under the reference amount of section 171(b)(1)(B)";
}
@source(IRC_S171_B, quote = "(or if it results in a smaller amortizable bond premium attributable to the period before the call date, with reference to the amount payable on the earlier call date), in the case of a bond described in subsection (a)(1)")
rule PremiumBeforeCallTaxableBondWithCallDate(p: Person, bond: Integer, via_maturity: Money, via_call: Money) strict {
    label en official "a taxable bond with a call date takes the smaller premium of the two reference amounts";
    when bond_has_call_date(p, bond);
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    when bond_premium_period_before_call_via_maturity(p, bond, via_maturity);
    when bond_premium_period_before_call_via_call_date(p, bond, via_call);
    then bond_premium_before_call_171b1(p, bond, min(via_maturity, via_call));
}
@source(IRC_S171_B, quote = "with reference to the amount payable on maturity (or if it results in a smaller")
rule PremiumBeforeCallTaxableBondNoCallDate(p: Person, bond: Integer, via_maturity: Money) strict {
    label en official "a taxable bond without a call date uses the amount payable on maturity";
    when not_known(bond_has_call_date(p, bond));
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    when bond_premium_period_before_call_via_maturity(p, bond, via_maturity);
    then bond_premium_before_call_171b1(p, bond, via_maturity);
}
@source(IRC_S171_B, quote = "(ii) with reference to the amount payable on maturity or on an earlier call date, in the case of a bond described in subsection (a)(2)")
rule PremiumBeforeCallExcludableBondCallDateChosen(p: Person, bond: Integer, via_call: Money) strict {
    label en official "a bond whose interest is excludable may use the earlier call date";
    when bond_interest_excludable_from_gross_income(p, bond);
    when bond_call_date_reference_chosen_171b1ii(p, bond);
    when bond_premium_period_before_call_via_call_date(p, bond, via_call);
    then bond_premium_before_call_171b1(p, bond, via_call);
}
@source(IRC_S171_B, quote = "(ii) with reference to the amount payable on maturity or on an earlier call date, in the case of a bond described in subsection (a)(2)")
rule PremiumBeforeCallExcludableBondMaturity(p: Person, bond: Integer, via_maturity: Money) strict {
    label en official "a bond whose interest is excludable otherwise uses the amount payable on maturity";
    when bond_interest_excludable_from_gross_income(p, bond);
    when not_known(bond_call_date_reference_chosen_171b1ii(p, bond));
    when bond_premium_period_before_call_via_maturity(p, bond, via_maturity);
    then bond_premium_before_call_171b1(p, bond, via_maturity);
}

pub relation bond_premium_amortized_before_section_171_applied(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the unamortized bond premium for the period before the date as of which section 171(a) becomes applicable to the taxpayer for the bond (section 171(b)(1)(C))";
}
pub relation bond_premium_adjusted_171b1c(p: Person, bond: Integer, amount: Money) kind institutional {
    label en official "the bond premium reduced by the premium of the period before section 171(a) became applicable";
}
@source(IRC_S171_B, quote = "with adjustments proper to reflect unamortized bond premium, with respect to the bond, for the period before the date as of which subsection (a) becomes applicable with respect to the taxpayer with respect to such bond")
rule BondPremiumAdjustedForEarlierPeriod(p: Person, bond: Integer, total: Money, before: Money) strict {
    label en official "the premium is adjusted for the period before section 171(a) became applicable";
    when bond_premium_total_171b(p, bond, total);
    when bond_premium_amortized_before_section_171_applied(p, bond, before);
    then bond_premium_adjusted_171b1c(p, bond, max(0.00 USD, total - before));
}
// === §171(b)(2): the amount amortizable in the year of the call ==============================================

pub relation bond_called_in_year_171(p: Person, y: TaxableYear, bond: Integer) kind empirical {
    label en official "the bond is called in the taxable year (section 171(b)(2))";
}
pub relation bond_adjusted_basis_at_beginning_of_year_171(p: Person, y: TaxableYear, bond: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis, for determining loss on sale or exchange, of the bond as of the beginning of the taxable year (section 171(b)(2))";
}
pub relation bond_amount_received_on_redemption_171(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the amount received on the redemption of the bond (section 171(b)(2))";
}
pub relation call_year_excess_applies_171b2(p: Person, y: TaxableYear, bond: Integer) kind institutional {
    label en official "the bond is a taxable bond with a call date, called in the taxable year (section 171(b)(2))";
}
@source(IRC_S171_B, quote = "In the case of a bond to which paragraph (1)(B)(i) applies and which has a call date, the amount of bond premium attributable to the taxable year in which the bond is called shall include")
rule CallYearExcessApplies(p: Person, y: TaxableYear, bond: Integer) strict {
    label en official "a taxable bond with a call date, in the year it is called";
    when bond_has_call_date(p, bond);
    when bond_called_in_year_171(p, y, bond);
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    then call_year_excess_applies_171b2(p, y, bond);
}
pub relation bond_call_year_excess_171b2(p: Person, y: TaxableYear, bond: Integer, amount: Money) kind institutional {
    label en official "the excess of the adjusted basis at the beginning of the year over the amount received on redemption or, if greater, the amount payable on maturity";
}
@source(IRC_S171_B, quote = "the excess of the amount of the adjusted basis (for determining loss on sale or exchange) of such bond as of the beginning of the taxable year over the amount received on redemption of the bond or (if greater) the amount payable on maturity")
rule CallYearExcess(p: Person, y: TaxableYear, bond: Integer, basis: Money, redeemed: Money, maturity: Money) strict {
    label en official "the call-year excess";
    when call_year_excess_applies_171b2(p, y, bond);
    when bond_adjusted_basis_at_beginning_of_year_171(p, y, bond, basis);
    when bond_amount_received_on_redemption_171(p, bond, redeemed);
    when bond_amount_payable_at_maturity(p, bond, maturity);
    then bond_call_year_excess_171b2(p, y, bond, max(0.00 USD, basis - max(redeemed, maturity)));
}
pub relation amortizable_bond_premium_of_year(p: Person, y: TaxableYear, bond: Integer, amount: Money) kind institutional {
    label en official "the amortizable bond premium of the taxable year (section 171(b)(2))";
}
@source(IRC_S171_B, quote = "The amortizable bond premium of the taxable year shall be the amount of the bond premium attributable to such year.")
rule AmortizablePremiumOfYearPlain(p: Person, y: TaxableYear, bond: Integer, amount: Money) strict {
    label en official "the premium attributable to the year";
    when bond_premium_attributable_to_year(p, y, bond, amount);
    when not_known(call_year_excess_applies_171b2(p, y, bond));
    then amortizable_bond_premium_of_year(p, y, bond, amount);
}
@source(IRC_S171_B, quote = "shall include an amount equal to the excess of the amount of the adjusted basis")
rule AmortizablePremiumOfYearCalled(p: Person, y: TaxableYear, bond: Integer, amount: Money, excess: Money) strict {
    label en official "the premium attributable to the year of the call includes the excess";
    when bond_premium_attributable_to_year(p, y, bond, amount);
    when bond_call_year_excess_171b2(p, y, bond, excess);
    then amortizable_bond_premium_of_year(p, y, bond, amount + excess);
}

// === §171(b)(3): the method ===================================================================================

pub relation yield_determined_on_basis_for_loss_171b3(p: Person, bond: Integer) kind empirical {
    label en official "the yield to maturity is determined using the taxpayer's basis for determining loss on sale or exchange (section 171(b)(3)(A)(i))";
}
pub relation yield_compounded_each_accrual_period_171b3(p: Person, bond: Integer) kind empirical {
    label en official "the yield is compounded at the close of each accrual period as defined in section 1272(a)(5) (section 171(b)(3)(A)(ii))";
}
pub relation bond_premium_determined_by_yield_method_171b3(p: Person, bond: Integer) kind institutional {
    label en official "the determinations under section 171(b)(1) and (2) are made on the yield to maturity method";
}
@source(IRC_S171_B, quote = "the determinations required under paragraphs (1) and (2) shall be made on the basis of the taxpayer's yield to maturity")
rule YieldMethodConditionsMet(p: Person, bond: Integer) strict {
    label en official "the yield is determined with the basis for loss and compounded at each accrual period";
    when yield_determined_on_basis_for_loss_171b3(p, bond);
    when yield_compounded_each_accrual_period_171b3(p, bond);
    then bond_premium_determined_by_yield_method_171b3(p, bond);
}
pub relation bond_earlier_call_date(p: Person, bond: Integer, on: Date) kind empirical {
    label en official "the earlier call date of the bond";
}
pub relation bond_amount_payable_on_earlier_call_date(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the amount payable on the earlier call date";
}
pub relation earlier_call_date_used_171b1(p: Person, bond: Integer) kind institutional {
    label en official "the amount payable on the earlier call date is used under section 171(b)(1)(B)(i) (it gives a smaller premium)";
}
@source(IRC_S171_B, quote = "if the amount payable on an earlier call date is used under paragraph (1)(B)(i) in determining the amortizable bond premium attributable to the period before the earlier call date")
rule EarlierCallDateUsed(p: Person, bond: Integer, via_maturity: Money, via_call: Money) strict {
    label en official "the call date gives the smaller premium";
    when bond_has_call_date(p, bond);
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    when bond_premium_period_before_call_via_maturity(p, bond, via_maturity);
    when bond_premium_period_before_call_via_call_date(p, bond, via_call);
    when via_call < via_maturity;
    then earlier_call_date_used_171b1(p, bond);
}
pub relation bond_treated_as_maturing_on_call_date_171b3b(p: Person, bond: Integer, on: Date, amount: Money) kind institutional {
    label en official "the bond is treated as maturing on the earlier call date for the amount payable";
}
pub relation bond_treated_as_reissued_on_call_date_171b3b(p: Person, bond: Integer, on: Date, amount: Money) kind institutional {
    label en official "and then reissued on that date for the amount payable";
}
@source(IRC_S171_B, quote = "such bond shall be treated as maturing on such date for the amount so payable")
rule BondTreatedAsMaturingOnCallDate(p: Person, bond: Integer, on: Date, amount: Money) strict {
    label en official "the bond matures on the earlier call date";
    when earlier_call_date_used_171b1(p, bond);
    when bond_earlier_call_date(p, bond, on);
    when bond_amount_payable_on_earlier_call_date(p, bond, amount);
    then bond_treated_as_maturing_on_call_date_171b3b(p, bond, on, amount);
}
@source(IRC_S171_B, quote = "and then reissued on such date for the amount so payable")
rule BondTreatedAsReissuedOnCallDate(p: Person, bond: Integer, on: Date, amount: Money) strict {
    label en official "the bond is reissued on the earlier call date";
    when earlier_call_date_used_171b1(p, bond);
    when bond_earlier_call_date(p, bond, on);
    when bond_amount_payable_on_earlier_call_date(p, bond, amount);
    then bond_treated_as_reissued_on_call_date_171b3b(p, bond, on, amount);
}

// === §171(c)(2): the election binds =============================================================================

pub relation election_first_year_171c(p: Person, first: TaxableYear) kind empirical {
    label en official "the first taxable year to which the section 171(c) election applies (section 171(c)(2))";
}
pub relation taxable_year_start_171c(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year";
}
pub relation section_171c_election_revoked_from_year(p: Person, y: TaxableYear) kind institutional {
    label en official "the Secretary has permitted the revocation of the section 171(c) election from the taxable year";
}
pub relation revokes_section_171c_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer applies to revoke the section 171(c) election from the taxable year";
}
pub relation secretary_permits_revocation_171c2(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary permits the revocation, subject to the conditions the Secretary deems necessary";
}
@source(IRC_S171_C, quote = "unless, on application by the taxpayer, the Secretary permits him, subject to such conditions as the Secretary deems necessary, to revoke such election")
rule Section171cRevocationPower(p: Person, y: TaxableYear) defeasible {
    label en official "revocable only with the permission of the Secretary";
    when revokes_section_171c_election(p, y);
    then power S171cRevokeElection {
        holder p;
        over y;
        exercise revokes_section_171c_election(p, y);
        valid_when secretary_permits_revocation_171c2(p, y);
        effect create(section_171c_election_revoked_from_year(p, y));
        window [@1954-08-16, infinity);
    };
}
@source(IRC_S171_C, quote = "shall be binding for all subsequent taxable years with respect to all such bonds of the taxpayer")
rule ElectionBindingInLaterYears(p: Person, y: TaxableYear, first: TaxableYear, first_start: Date, start: Date) defeasible {
    label en official "the election binds the later years unless revoked";
    when election_first_year_171c(p, first);
    when taxable_year_start_171c(first, first_start);
    when taxable_year_start_171c(y, start);
    when start >= first_start;
    when not_known(section_171c_election_revoked_from_year(p, y));
    then bond_premium_election_in_effect(p, y);
}
pub relation bond_held_at_beginning_of_first_election_year(p: Person, bond: Integer) kind empirical {
    label en official "the bond is held by the taxpayer at the beginning of the first taxable year to which the election applies";
}
pub relation bond_acquired_after_election_first_year_began(p: Person, bond: Integer) kind empirical {
    label en official "the bond is acquired by the taxpayer after the beginning of the first taxable year to which the election applies";
}
pub relation bond_covered_by_election_171c2(p: Person, bond: Integer) kind institutional {
    label en official "the election applies to the bond: all such bonds held at the beginning of the first year and all such bonds thereafter acquired";
}
@source(IRC_S171_C, quote = "it shall also apply to all such bonds held by the taxpayer at the beginning of the first taxable year to which the election applies")
rule ElectionCoversBondsHeldAtStart(p: Person, bond: Integer, first: TaxableYear) strict {
    label en official "a bond held at the beginning of the first year";
    when election_first_year_171c(p, first);
    when bond_held_at_beginning_of_first_election_year(p, bond);
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    then bond_covered_by_election_171c2(p, bond);
}
@source(IRC_S171_C, quote = "and to all such bonds thereafter acquired by him")
rule ElectionCoversBondsThereafterAcquired(p: Person, bond: Integer, first: TaxableYear) strict {
    label en official "a bond acquired afterwards";
    when election_first_year_171c(p, first);
    when bond_acquired_after_election_first_year_began(p, bond);
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    then bond_covered_by_election_171c2(p, bond);
}
pub enum BondHolderKind171c {
    CommonTrustFundHolder;
    EstateOrTrustHolder;
    OtherHolder;
}
pub relation bond_holder_kind_171c(bond: Integer, kind: BondHolderKind171c) kind empirical {
    label en official "the kind of holder of the bond (section 171(c)(2))";
}
pub relation elector_is_common_trust_fund_or_fiduciary_171c(p: Person, bond: Integer) kind empirical {
    label en official "the person making the election is the common trust fund or the fiduciary, as the holder requires";
}
pub relation elector_is_holder_of_bond_171c(p: Person, bond: Integer) kind empirical {
    label en official "the person making the election is the holder of the bond";
}
pub relation section_171c_election_exercisable_by(p: Person, bond: Integer) kind institutional {
    label en official "the person may exercise the section 171(c) election for the bond";
}
@source(IRC_S171_C, quote = "the election authorized under this subsection shall be exercisable with respect to such bonds only by the common trust fund")
rule ElectionExercisableByCommonTrustFund(p: Person, bond: Integer) strict {
    label en official "only the common trust fund";
    when bond_holder_kind_171c(bond, CommonTrustFundHolder);
    when elector_is_common_trust_fund_or_fiduciary_171c(p, bond);
    then section_171c_election_exercisable_by(p, bond);
}
@source(IRC_S171_C, quote = "the election authorized under this subsection shall be exercisable with respect to such bonds only by the fiduciary")
rule ElectionExercisableByFiduciary(p: Person, bond: Integer) strict {
    label en official "only the fiduciary";
    when bond_holder_kind_171c(bond, EstateOrTrustHolder);
    when elector_is_common_trust_fund_or_fiduciary_171c(p, bond);
    then section_171c_election_exercisable_by(p, bond);
}
@source(IRC_S171_C, quote = "The election authorized under this subsection shall be made in accordance with such regulations as the Secretary shall prescribe.")
rule ElectionExercisableByOtherHolder(p: Person, bond: Integer) strict {
    label en official "any other holder elects for its own bonds";
    when bond_holder_kind_171c(bond, OtherHolder);
    when elector_is_holder_of_bond_171c(p, bond);
    then section_171c_election_exercisable_by(p, bond);
}

// === §171(e): the offset against interest =======================================================================

pub relation bond_interest_payment_171e(p: Person, bond: Integer, payment: Integer, amount: Money) kind empirical {
    label en official "the amount of an interest payment on the bond (section 171(e)(2))";
}
pub relation bond_premium_allocated_to_interest_payment_171e(p: Person, bond: Integer, payment: Integer, amount: Money) kind empirical {
    label en official "the bond premium allocated to the interest payment under rules similar to section 171(b)(3) (section 171(e)(1))";
}
pub relation bond_premium_offset_applies_171e(p: Person, bond: Integer) kind institutional {
    label en official "the taxable bond's premium is applied against the interest payments in lieu of a deduction under section 171(a)";
}
@source(IRC_S171_E, quote = "in lieu of any deduction under subsection (a), the amount of any premium so allocated to any interest payment shall be applied against (and operate to reduce) the amount of such interest payment")
rule BondPremiumOffsetApplies(p: Person, bond: Integer, payment: Integer, allocated: Money) strict {
    label en official "a taxable bond with allocated premium";
    when bond_premium_allocated_to_interest_payment_171e(p, bond, payment, allocated);
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    then bond_premium_offset_applies_171e(p, bond);
}
pub relation interest_payment_reduced_by_premium_171e(p: Person, bond: Integer, payment: Integer, amount: Money) kind institutional {
    label en official "the interest payment after the allocated premium is applied against it";
}
@source(IRC_S171_E, quote = "the amount of any premium so allocated to any interest payment shall be applied against (and operate to reduce) the amount of such interest payment")
rule InterestPaymentReducedByPremium(p: Person, bond: Integer, payment: Integer, interest: Money, allocated: Money) strict {
    label en official "the premium reduces the interest payment";
    when bond_premium_offset_applies_171e(p, bond);
    when bond_interest_payment_171e(p, bond, payment, interest);
    when bond_premium_allocated_to_interest_payment_171e(p, bond, payment, allocated);
    then interest_payment_reduced_by_premium_171e(p, bond, payment, max(0.00 USD, interest - allocated));
}
pub relation bond_premium_in_excess_of_interest_payment_171e(p: Person, bond: Integer, payment: Integer, amount: Money) kind institutional {
    label en official "the allocated premium beyond the interest payment (not taken by the offset)";
}
@source(IRC_S171_E, quote = "the amount of any premium so allocated to any interest payment shall be applied against (and operate to reduce) the amount of such interest payment")
rule PremiumInExcessOfInterestPayment(p: Person, bond: Integer, payment: Integer, interest: Money, allocated: Money) strict {
    label en official "the excess over the payment";
    when bond_premium_offset_applies_171e(p, bond);
    when bond_interest_payment_171e(p, bond, payment, interest);
    when bond_premium_allocated_to_interest_payment_171e(p, bond, payment, allocated);
    when allocated > interest;
    then bond_premium_in_excess_of_interest_payment_171e(p, bond, payment, allocated - interest);
}
// === §175(c): expenditures and land ===========================================================================

pub enum SoilConservationPurpose175 {
    EarthTreatmentOrMoving;
    EradicationOfBrushOrWindbreaks;
    RecoveryPlanSiteSpecificAction;
    OtherPurpose;
}
pub relation soil_conservation_purpose_175(p: Person, y: TaxableYear, item: Integer, purpose: SoilConservationPurpose175) kind empirical {
    label en official "the purpose of the expenditure (section 175(c)(1))";
}
pub relation soil_conservation_expenditure_amount_175(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount of the expenditure (section 175(c)(1))";
}
pub relation soil_conservation_expenditure_for_land_175(p: Person, y: TaxableYear, item: Integer, land: Integer) kind empirical {
    label en official "the expenditure is in respect of the land";
}
pub relation land_used_for_crops_or_livestock_175c2(land: Integer) kind empirical {
    label en official "the land is used by the taxpayer or his tenant for the production of crops, fruits or other agricultural products or for the sustenance of livestock (section 175(c)(2))";
}
pub relation land_use_before_or_simultaneously_with_expenditure_175c2(land: Integer, p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the use is before or simultaneously with the expenditure";
}
pub relation land_used_in_farming_175c2(land: Integer, p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "land used in farming for the expenditure (section 175(c)(2))";
}
@source(IRC_S175_C, quote = "The term \"land used in farming\" means land used (before or simultaneously with the expenditures described in paragraph (1)) by the taxpayer or his tenant for the production of crops, fruits, or other agricultural products or for the sustenance of livestock.")
rule LandUsedInFarming(land: Integer, p: Person, y: TaxableYear, item: Integer) strict {
    label en official "used for crops or livestock before or with the expenditure";
    when land_used_for_crops_or_livestock_175c2(land);
    when land_use_before_or_simultaneously_with_expenditure_175c2(land, p, y, item);
    then land_used_in_farming_175c2(land, p, y, item);
}
pub relation soil_expenditure_for_depreciable_structure_175c1a(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is for the purchase, construction, installation or improvement of structures, appliances or facilities subject to depreciation under section 167 (section 175(c)(1)(A))";
}
pub relation soil_expenditure_deductible_without_section_175(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is allowable as a deduction without regard to section 175 (section 175(c)(1)(B))";
}
@source(IRC_S175_C, quote = "means expenditures paid or incurred for the treatment or moving of earth")
rule SoilWaterExpenditureQualifies(p: Person, y: TaxableYear, item: Integer, amount: Money, land: Integer, purpose: SoilConservationPurpose175) strict {
    label en official "a qualifying purpose for land used in farming, not a depreciable structure, not otherwise deductible";
    when soil_conservation_purpose_175(p, y, item, purpose);
    when purpose != OtherPurpose;
    when soil_conservation_expenditure_amount_175(p, y, item, amount);
    when soil_conservation_expenditure_for_land_175(p, y, item, land);
    when land_used_in_farming_175c2(land, p, y, item);
    when not_known(soil_expenditure_for_depreciable_structure_175c1a(p, y, item));
    when not_known(soil_expenditure_deductible_without_section_175(p, y, item));
    then soil_water_conservation_expenditure(p, y, item, amount);
}
pub relation district_assessment_paid_175(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an assessment levied by a soil or water conservation or drainage district, paid or incurred by the taxpayer (section 175(c)(1))";
}
pub relation assessment_for_deductible_type_expenditures_175(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the assessment defrays expenditures of the district that would be deductible under section 175 if paid by the taxpayer (section 175(c)(1)(i))";
}
pub relation assessment_for_depreciable_district_property_175(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the assessment is for depreciable property used in the district's business (section 175(c)(1)(ii))";
}
pub relation aggregate_assessed_share_of_taxpayer_175(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "the aggregate amounts which have been and will be assessed as the taxpayer's share of the district's expenditures for the property (section 175(f)(1))";
}
@source(IRC_S175_C, quote = "which, if paid or incurred by the taxpayer, would without regard to this sentence constitute expenditures deductible under this section")
rule AssessmentForDeductibleExpendituresQualifies(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "an assessment for expenditures deductible under section 175";
    when district_assessment_paid_175(p, y, item, amount);
    when assessment_for_deductible_type_expenditures_175(p, y, item);
    then soil_water_conservation_expenditure(p, y, item, amount);
}
pub relation assessment_within_ten_percent_share_175c1ii(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the part of an assessment for depreciable district property within 10 percent of the taxpayer's share";
}
@source(IRC_S175_C, quote = "(to the extent that the taxpayer's share of the assessment levied on the members of the district for such property does not exceed 10 percent of such assessment)")
rule AssessmentWithinTenPercent(p: Person, y: TaxableYear, item: Integer, paid: Money, aggregate: Money) strict {
    label en official "the amount up to 10 percent";
    when district_assessment_paid_175(p, y, item, paid);
    when assessment_for_depreciable_district_property_175(p, y, item);
    when aggregate_assessed_share_of_taxpayer_175(p, item, aggregate);
    then assessment_within_ten_percent_share_175c1ii(p, y, item, min(paid, round(aggregate * 0.10, 2, "HALF_UP")));
}
@source(IRC_S175_C, quote = "(ii) for property of a character subject to the allowance for depreciation provided in section 167 and used in the soil or water conservation or drainage district's business as such")
rule AssessmentWithinTenPercentQualifies(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the part within 10 percent is a qualifying expenditure";
    when assessment_within_ten_percent_share_175c1ii(p, y, item, amount);
    then soil_water_conservation_expenditure(p, y, item, amount);
}

// === §175(e): the method binds ==================================================================================

pub relation secretary_approves_change_of_soil_water_method(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary approves a change to a different method for the taxable year (section 175(e))";
}
pub relation taxable_year_of_taxpayer_175(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year of the taxpayer for which taxable income is computed (section 175(e))";
}
pub relation soil_water_method_adhered_to(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 175 method is adhered to in computing taxable income for the taxable year (section 175(e))";
}
@source(IRC_S175_E, quote = "The method adopted shall be adhered to in computing taxable income for the taxable year and for all subsequent taxable years")
rule SoilWaterMethodAdheredTo(p: Person, y: TaxableYear) defeasible {
    label en official "the method binds unless the Secretary approves a change";
    when taxable_year_of_taxpayer_175(p, y);
    when soil_water_conservation_method_in_effect(p);
    when not_known(secretary_approves_change_of_soil_water_method(p, y));
    then soil_water_method_adhered_to(p, y);
}
pub relation soil_water_method_applies_to_expenditure_175e(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the method applies to all the expenditures described in section 175(a)";
}
@source(IRC_S175_E, quote = "The method adopted under this section shall apply to all expenditures described in subsection (a).")
rule SoilWaterMethodAppliesToAllExpenditures(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "every qualifying expenditure comes under the method";
    when soil_water_method_adhered_to(p, y);
    when soil_water_conservation_expenditure(p, y, item, amount);
    then soil_water_method_applies_to_expenditure_175e(p, y, item);
}

// === §175(f): assessments for depreciable property =============================================================

pub relation assessment_excess_over_ten_percent_175f1(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the excess of the assessment paid over 10 percent of the aggregate share, if more than $500";
}
@source(IRC_S175_F, quote = "is in excess of an amount equal to 10 percent of the aggregate amounts which have been and will be assessed as the taxpayer's share of the expenditures by the district for such property, and if such excess is more than $500, the entire excess")
rule AssessmentExcessOverTenPercent(p: Person, y: TaxableYear, item: Integer, paid: Money, aggregate: Money) strict {
    label en official "the excess is above $500";
    when district_assessment_paid_175(p, y, item, paid);
    when assessment_for_depreciable_district_property_175(p, y, item);
    when aggregate_assessed_share_of_taxpayer_175(p, item, aggregate);
    when paid - round(aggregate * 0.10, 2, "HALF_UP") > 500.00 USD;
    then assessment_excess_over_ten_percent_175f1(p, y, item, paid - round(aggregate * 0.10, 2, "HALF_UP"));
}
pub relation assessment_excess_annual_portion_175f1(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the portion of the excess treated as paid or incurred in each of the 9 succeeding taxable years";
}
@source(IRC_S175_F, quote = "the entire excess shall be treated as paid or incurred ratably over each of the 9 succeeding taxable years")
rule AssessmentExcessRatablyOverNineYears(p: Person, y: TaxableYear, item: Integer, excess: Money) strict {
    label en official "one ninth per succeeding year";
    when assessment_excess_over_ten_percent_175f1(p, y, item, excess);
    then assessment_excess_annual_portion_175f1(p, y, item, div_round(excess, 9.0, 2, "HALF_UP"));
}
pub relation assessment_excess_not_yet_treated_as_paid_175f(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "the part of the excess not treated as paid or incurred for a taxable year ending before the event";
}
pub relation land_disposed_within_nine_years_other_than_by_death_175f2(p: Person, item: Integer) kind empirical {
    label en official "the land is sold or otherwise disposed of, other than by reason of death, during the 9 succeeding taxable years";
}
pub relation assessment_excess_added_to_land_basis_175f2(p: Person, item: Integer, amount: Money) kind institutional {
    label en official "the untreated excess is added to the adjusted basis of the land immediately before its disposition";
}
@source(IRC_S175_F, quote = "shall be added to the adjusted basis of such land immediately prior to its sale or other disposition")
rule AssessmentExcessAddedToBasisOnDisposition(p: Person, item: Integer, amount: Money) strict {
    label en official "added to the basis of the land";
    when land_disposed_within_nine_years_other_than_by_death_175f2(p, item);
    when assessment_excess_not_yet_treated_as_paid_175f(p, item, amount);
    then assessment_excess_added_to_land_basis_175f2(p, item, amount);
}
pub relation taxpayer_dies_in_year_within_nine_years_175f3(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer dies in the taxable year, during the 9 succeeding taxable years";
}
pub relation assessment_excess_treated_paid_in_year_of_death_175f3(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the untreated excess is treated as paid or incurred in the taxable year of death";
}
@source(IRC_S175_F, quote = "shall be treated as paid or incurred in the taxable year in which he dies")
rule AssessmentExcessPaidInYearOfDeath(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the remaining excess falls in the year of death";
    when taxpayer_dies_in_year_within_nine_years_175f3(p, y, item);
    when assessment_excess_not_yet_treated_as_paid_175f(p, item, amount);
    then assessment_excess_treated_paid_in_year_of_death_175f3(p, y, item, amount);
}

// === §183(e): the election postponing the presumption ============================================================

pub relation elects_to_postpone_presumption_determination_183e(p: Person, activity: Integer) kind empirical {
    label en official "the taxpayer elects that the determination whether the section 183(d) presumption applies not be made before the close of the fourth (sixth) taxable year following the first year of the activity (section 183(e)(1))";
}
pub relation presumption_postponement_election_in_effect_183e(p: Person, activity: Integer) kind institutional {
    label en official "the election under section 183(e)(1) is in effect for the activity";
}
@source(IRC_S183_E, quote = "if the taxpayer so elects")
rule Section183eElectionPower(p: Person, activity: Integer) strict {
    label en official "the taxpayer elects to postpone the determination";
    when elects_to_postpone_presumption_determination_183e(p, activity);
    then power S183ePostponeDetermination {
        holder p;
        over activity;
        exercise elects_to_postpone_presumption_determination_183e(p, activity);
        valid_when elects_to_postpone_presumption_determination_183e(p, activity);
        effect create(presumption_postponement_election_in_effect_183e(p, activity));
        window [@1969-12-30, infinity);
    };
}
pub relation activity_is_horse_breeding_training_showing_or_racing_183d(activity: Integer) kind empirical {
    label en official "the activity consists in major part of the breeding, training, showing or racing of horses (section 183(d), last sentence)";
}
pub relation year_in_initial_period_183e(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is in the 5-year (7-year) period beginning with the taxable year in which the taxpayer first engages in the activity (section 183(e)(2))";
}
pub relation initial_period_years_with_income_over_deductions_183e(p: Person, activity: Integer, count: Integer) kind institutional {
    label en official "the count of taxable years of the initial period for which gross income from the activity exceeded the attributable deductions";
}
@source(IRC_S183_E, quote = "if the gross income derived from the activity for 3 (or 2 if applicable) or more of the taxable years in such period exceeds the deductions attributable to the activity")
rule InitialPeriodYearsWithIncome(p: Person, activity: Integer) strict {
    label en official "the years of the initial period in which income exceeded deductions";
    when presumption_postponement_election_in_effect_183e(p, activity);
    then initial_period_years_with_income_over_deductions_183e(p, activity, count(collect y: TaxableYear where year_in_initial_period_183e(p, activity, y) and gross_income_exceeded_deductions_for_year(p, activity, y)));
}
pub relation presumption_applies_by_election_183e(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the presumption of section 183(d) applies to the taxable year of the initial period";
}
@source(IRC_S183_E, quote = "the presumption provided by subsection (d) shall apply to each taxable year in the 5-taxable year (or 7-taxable year) period")
rule PresumptionAppliesFiveYearPeriod(p: Person, activity: Integer, y: TaxableYear, count: Integer) defeasible {
    label en official "3 of the 5 years";
    when presumption_postponement_election_in_effect_183e(p, activity);
    when not_known(activity_is_horse_breeding_training_showing_or_racing_183d(activity));
    when year_in_initial_period_183e(p, activity, y);
    when initial_period_years_with_income_over_deductions_183e(p, activity, count);
    when count >= 3;
    then presumption_applies_by_election_183e(p, activity, y);
}
@source(IRC_S183_E, quote = "the presumption provided by subsection (d) shall apply to each taxable year in the 5-taxable year (or 7-taxable year) period")
rule PresumptionAppliesSevenYearPeriod(p: Person, activity: Integer, y: TaxableYear, count: Integer) defeasible {
    label en official "2 of the 7 years for horses";
    when presumption_postponement_election_in_effect_183e(p, activity);
    when activity_is_horse_breeding_training_showing_or_racing_183d(activity);
    when year_in_initial_period_183e(p, activity, y);
    when initial_period_years_with_income_over_deductions_183e(p, activity, count);
    when count >= 2;
    then presumption_applies_by_election_183e(p, activity, y);
}
pub relation filing_due_date_for_last_year_of_initial_period_183e(p: Person, activity: Integer, on: Date) kind empirical {
    label en official "the date prescribed by law (determined without extensions) for filing the return for the last taxable year of the period (section 183(e)(4))";
}
pub relation deficiency_assessment_period_extended_until_183e4(p: Person, activity: Integer, on: Date) kind institutional {
    label en official "the period for assessing a deficiency attributable to the activity does not expire before this date";
}
@source(IRC_S183_E, quote = "the statutory period for the assessment of any deficiency attributable to such activity shall not expire before the expiration of 2 years after the date prescribed by law")
rule DeficiencyAssessmentPeriodExtended(p: Person, activity: Integer, due: Date) strict {
    label en official "two years after the filing date of the last year of the period";
    when presumption_postponement_election_in_effect_183e(p, activity);
    when filing_due_date_for_last_year_of_initial_period_183e(p, activity, due);
    then deficiency_assessment_period_extended_until_183e4(p, activity, add_calendar_period(due, 2 calendar_year));
}

// === §197(d)(2),(3): customer-based and supplier-based intangibles ===============================================

pub relation intangible_value_composition_of_market_197(p: Person, a: Asset) kind empirical {
    label en official "the value of the intangible is the composition of market (section 197(d)(2)(A)(i))";
}
pub relation intangible_value_market_share_197(p: Person, a: Asset) kind empirical {
    label en official "the value of the intangible is market share (section 197(d)(2)(A)(ii))";
}
pub relation intangible_value_from_future_customer_relationships_197(p: Person, a: Asset) kind empirical {
    label en official "any other value resulting from the future provision of goods or services under relationships with customers in the ordinary course of business (section 197(d)(2)(A)(iii))";
}
pub relation intangible_is_deposit_base_or_similar_197(p: Person, a: Asset) kind empirical {
    label en official "the intangible is deposit base or a similar item (section 197(d)(2)(B))";
}
pub relation holder_is_financial_institution_197(p: Person) kind empirical {
    label en official "the holder is a financial institution (section 197(d)(2)(B))";
}
pub relation intangible_value_from_future_supplier_relationships_197(p: Person, a: Asset) kind empirical {
    label en official "value resulting from future acquisitions of goods or services under relationships with suppliers of goods or services to be used or sold by the taxpayer (section 197(d)(3))";
}
@source(IRC_S197_D, quote = "(i) composition of market,")
rule CustomerBasedByCompositionOfMarket(p: Person, a: Asset) strict {
    label en official "composition of market";
    when intangible_value_composition_of_market_197(p, a);
    then section_197_item_type(p, a, CustomerBasedIntangible);
}
@source(IRC_S197_D, quote = "(ii) market share, and")
rule CustomerBasedByMarketShare(p: Person, a: Asset) strict {
    label en official "market share";
    when intangible_value_market_share_197(p, a);
    then section_197_item_type(p, a, CustomerBasedIntangible);
}
@source(IRC_S197_D, quote = "any other value resulting from future provision of goods or services pursuant to relationships (contractual or otherwise) in the ordinary course of business with customers")
rule CustomerBasedByCustomerRelationships(p: Person, a: Asset) strict {
    label en official "future customer relationships";
    when intangible_value_from_future_customer_relationships_197(p, a);
    then section_197_item_type(p, a, CustomerBasedIntangible);
}
@source(IRC_S197_D, quote = "In the case of a financial institution, the term \"customer-based intangible\" includes deposit base and similar items.")
rule CustomerBasedByDepositBase(p: Person, a: Asset) strict {
    label en official "deposit base of a financial institution";
    when holder_is_financial_institution_197(p);
    when intangible_is_deposit_base_or_similar_197(p, a);
    then section_197_item_type(p, a, CustomerBasedIntangible);
}
@source(IRC_S197_D, quote = "The term \"supplier-based intangible\" means any value resulting from future acquisitions of goods or services")
rule SupplierBasedIntangible(p: Person, a: Asset) strict {
    label en official "future supplier relationships";
    when intangible_value_from_future_supplier_relationships_197(p, a);
    then section_197_item_type(p, a, SupplierBasedIntangible);
}

// === §197(f)(9)(C),(E): the related person and the partner level =================================================

pub relation relationship_267b_or_707b1_at_20_percent_197(related: Person, other: Person) kind empirical {
    label en official "the related person bears a relationship to the person specified in section 267(b) or 707(b)(1), with 20 percent substituted for 50 percent (section 197(f)(9)(C)(i)(I))";
}
pub relation trades_or_businesses_under_common_control_41f1_197(related: Person, other: Person) kind empirical {
    label en official "the related person and the person are engaged in trades or businesses under common control within the meaning of section 41(f)(1)(A) and (B) (section 197(f)(9)(C)(i)(II))";
}
pub relation relationship_exists_immediately_before_acquisition_197(related: Person, other: Person, a: Asset) kind empirical {
    label en official "the relationship exists immediately before the acquisition of the intangible (section 197(f)(9)(C)(ii))";
}
pub relation relationship_exists_immediately_after_acquisition_197(related: Person, other: Person, a: Asset) kind empirical {
    label en official "the relationship exists immediately after the acquisition of the intangible (section 197(f)(9)(C)(ii))";
}
pub relation related_person_197f9c(related: Person, other: Person, a: Asset) kind institutional {
    label en official "the related person is related to the person for the anti-churning rule of section 197(f)(9)";
}
@source(IRC_S197_F, quote = "the related person bears a relationship to such person specified in section 267(b) or section 707(b)(1)")
rule RelatedPersonByStatutoryRelationshipBefore(related: Person, other: Person, a: Asset) strict {
    label en official "a 267(b)/707(b)(1) relationship at 20 percent, immediately before the acquisition";
    when relationship_267b_or_707b1_at_20_percent_197(related, other);
    when relationship_exists_immediately_before_acquisition_197(related, other, a);
    then related_person_197f9c(related, other, a);
}
@source(IRC_S197_F, quote = "A person shall be treated as related to another person if such relationship exists immediately before or immediately after the acquisition of the intangible involved.")
rule RelatedPersonByStatutoryRelationshipAfter(related: Person, other: Person, a: Asset) strict {
    label en official "a 267(b)/707(b)(1) relationship at 20 percent, immediately after the acquisition";
    when relationship_267b_or_707b1_at_20_percent_197(related, other);
    when relationship_exists_immediately_after_acquisition_197(related, other, a);
    then related_person_197f9c(related, other, a);
}
@source(IRC_S197_F, quote = "the related person and such person are engaged in trades or businesses under common control")
rule RelatedPersonByCommonControlBefore(related: Person, other: Person, a: Asset) strict {
    label en official "common control, immediately before the acquisition";
    when trades_or_businesses_under_common_control_41f1_197(related, other);
    when relationship_exists_immediately_before_acquisition_197(related, other, a);
    then related_person_197f9c(related, other, a);
}
@source(IRC_S197_F, quote = "such relationship exists immediately before or immediately after the acquisition of the intangible involved")
rule RelatedPersonByCommonControlAfter(related: Person, other: Person, a: Asset) strict {
    label en official "common control, immediately after the acquisition";
    when trades_or_businesses_under_common_control_41f1_197(related, other);
    when relationship_exists_immediately_after_acquisition_197(related, other, a);
    then related_person_197f9c(related, other, a);
}
pub relation partnership_basis_increase_under_732_734_743_197(partnership: Person, a: Asset) kind empirical {
    label en official "the basis of partnership property is increased under section 732, 734 or 743 (section 197(f)(9)(E))";
}
pub relation partner_of_197(partner: Person, partnership: Person) kind empirical {
    label en official "the person is a partner of the partnership";
}
pub relation partner_share_of_partnership_assets_197(partner: Person, partnership: Person, share: Decimal) kind empirical {
    label en official "the proportionate share of the partner in the partnership assets";
}
pub relation determination_of_anti_churning_at_partner_level_197f9e(partnership: Person, a: Asset) kind institutional {
    label en official "the anti-churning determinations are made at the partner level";
}
@source(IRC_S197_F, quote = "determinations under this paragraph shall be made at the partner level")
rule AntiChurningDeterminedAtPartnerLevel(partnership: Person, a: Asset) strict {
    label en official "partner-level determination";
    when partnership_basis_increase_under_732_734_743_197(partnership, a);
    then determination_of_anti_churning_at_partner_level_197f9e(partnership, a);
}
pub relation partner_treated_as_owning_and_using_share_197f9e(partner: Person, partnership: Person, a: Asset, share: Decimal) kind institutional {
    label en official "each partner is treated as having owned and used the partner's proportionate share of the partnership assets";
}
@source(IRC_S197_F, quote = "each partner shall be treated as having owned and used such partner's proportionate share of the partnership assets")
rule PartnerTreatedAsOwningAndUsingShare(partner: Person, partnership: Person, a: Asset, share: Decimal) strict {
    label en official "the partner owns and uses a share";
    when determination_of_anti_churning_at_partner_level_197f9e(partnership, a);
    when partner_of_197(partner, partnership);
    when partner_share_of_partnership_assets_197(partner, partnership, share);
    then partner_treated_as_owning_and_using_share_197f9e(partner, partnership, a, share);
}

// === §198: the qualified environmental remediation expenditure ==================================================

pub relation site_held_for_business_or_production_of_income_198c1a(site: Integer) kind empirical {
    label en official "the area is held by the taxpayer for use in a trade or business or for the production of income (section 198(c)(1)(A))";
}
pub relation site_is_property_described_in_1221a1_198c1a(site: Integer) kind empirical {
    label en official "the area is property described in section 1221(a)(1) in the hands of the taxpayer (section 198(c)(1)(A))";
}
pub relation hazardous_substance_release_or_disposal_at_site_198c1b(site: Integer) kind empirical {
    label en official "there has been a release (or threat of release) or disposal of a hazardous substance at or on the area (section 198(c)(1)(B))";
}
pub relation qualified_contaminated_site_198c1(site: Integer) kind institutional {
    label en official "a qualified contaminated site";
}
@source(IRC_S198_C, quote = "which is held by the taxpayer for use in a trade or business or for the production of income")
rule QualifiedContaminatedSiteBusiness(site: Integer) strict {
    label en official "held for business or income and contaminated";
    when site_held_for_business_or_production_of_income_198c1a(site);
    when hazardous_substance_release_or_disposal_at_site_198c1b(site);
    then qualified_contaminated_site_198c1(site);
}
@source(IRC_S198_C, quote = "or which is property described in section 1221(a)(1) in the hands of the taxpayer")
rule QualifiedContaminatedSiteInventory(site: Integer) strict {
    label en official "inventory property and contaminated";
    when site_is_property_described_in_1221a1_198c1a(site);
    when hazardous_substance_release_or_disposal_at_site_198c1b(site);
    then qualified_contaminated_site_198c1(site);
}
pub relation expenditure_chargeable_to_capital_account_198(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an expenditure otherwise chargeable to capital account (section 198(b)(1)(A))";
}
pub relation expenditure_for_abatement_or_control_at_site_198(p: Person, y: TaxableYear, item: Integer, site: Integer) kind empirical {
    label en official "the expenditure is paid or incurred in connection with the abatement or control of hazardous substances at the site (section 198(b)(1)(B))";
}
pub relation expenditure_acquires_depreciable_property_198b2(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is for the acquisition of property subject to the allowance for depreciation, used in connection with the abatement or control (section 198(b)(2))";
}
pub relation section_167_allowance_allocated_to_site_198b2(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is the portion of the section 167 allowance for such property that is allocated to the site (section 198(b)(2))";
}
@source(IRC_S198_B, quote = "which is paid or incurred in connection with the abatement or control of hazardous substances at a qualified contaminated site")
rule QualifiedRemediationExpenditure(p: Person, y: TaxableYear, item: Integer, amount: Money, site: Integer) strict {
    label en official "capital expenditure for the abatement at a qualified site, not a depreciable acquisition";
    when expenditure_chargeable_to_capital_account_198(p, y, item, amount);
    when expenditure_for_abatement_or_control_at_site_198(p, y, item, site);
    when qualified_contaminated_site_198c1(site);
    when not_known(expenditure_acquires_depreciable_property_198b2(p, y, item));
    then environmental_remediation_expenditure(p, y, item, amount);
}
@source(IRC_S198_B, quote = "except that the portion of the allowance under section 167 for such property which is otherwise allocated to such site shall be treated as a qualified environmental remediation expenditure")
rule QualifiedRemediationExpenditureAllowancePortion(p: Person, y: TaxableYear, item: Integer, amount: Money, site: Integer) strict {
    label en official "the section 167 allowance allocated to the site";
    when expenditure_chargeable_to_capital_account_198(p, y, item, amount);
    when expenditure_for_abatement_or_control_at_site_198(p, y, item, site);
    when qualified_contaminated_site_198c1(site);
    when expenditure_acquires_depreciable_property_198b2(p, y, item);
    when section_167_allowance_allocated_to_site_198b2(p, y, item);
    then environmental_remediation_expenditure(p, y, item, amount);
}
pub relation expenditure_would_have_been_capitalized_to_property_198e(p: Person, item: Integer, a: Asset) kind empirical {
    label en official "the property to which the qualified expenditure would have been capitalized but for section 198 (section 198(e))";
}
pub relation asset_is_section_1245_property_198e(a: Asset) kind empirical {
    label en official "the property is otherwise section 1245 property";
}
pub relation remediation_deduction_treated_as_depreciation_198e1(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "solely for section 1245, the deduction allowed by section 198 is a deduction for depreciation";
}
@source(IRC_S198_E, quote = "the deduction allowed by this section for such expenditure shall be treated as a deduction for depreciation")
rule RemediationDeductionTreatedAsDepreciation(p: Person, y: TaxableYear, item: Integer, amount: Money, a: Asset) strict {
    label en official "a deduction for depreciation under section 1245";
    when environmental_remediation_election_in_effect(p, y);
    when environmental_remediation_expenditure(p, y, item, amount);
    when expenditure_would_have_been_capitalized_to_property_198e(p, item, a);
    then remediation_deduction_treated_as_depreciation_198e1(p, y, item, amount);
}
pub relation property_treated_as_section_1245_property_198e2(p: Person, item: Integer, a: Asset) kind institutional {
    label en official "the property is treated as section 1245 property solely for applying section 1245 to the deduction";
}
@source(IRC_S198_E, quote = "such property (if not otherwise section 1245 property) shall be treated as section 1245 property solely for purposes of applying section 1245 to such deduction")
rule PropertyTreatedAsSection1245Property(p: Person, item: Integer, a: Asset) strict {
    label en official "property that is not otherwise section 1245 property";
    when expenditure_would_have_been_capitalized_to_property_198e(p, item, a);
    when not_known(asset_is_section_1245_property_198e(a));
    then property_treated_as_section_1245_property_198e2(p, item, a);
}

// === §250(b)(3)(B),(b)(5): oil and gas income, foreign use, related parties =====================================

pub relation section_907c1_income_within_united_states_250(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "income described in section 907(c)(1), determined by substituting \"within the United States\" for \"without the United States\" (section 250(b)(3)(B))";
}
pub relation domestic_oil_and_gas_extraction_income_250(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "domestic oil and gas extraction income";
}
@source(IRC_S250_B, quote = "the term \"domestic oil and gas extraction income\" means income described in section 907(c)(1), determined by substituting \"within the United States\" for \"without the United States\"")
rule DomesticOilAndGasExtractionIncome(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "section 907(c)(1) income within the United States";
    when section_907c1_income_within_united_states_250(c, y, amount);
    then domestic_oil_and_gas_extraction_income_250(c, y, amount);
}
pub relation use_consumption_or_disposition_within_united_states_250(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the use, consumption or disposition of the property is within the United States (section 250(b)(5)(A))";
}
pub relation foreign_use_250b5(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "foreign use: any use, consumption or disposition which is not within the United States";
}
@source(IRC_S250_B, quote = "The term \"foreign use\" means any use, consumption, or disposition which is not within the United States.")
rule ForeignUseDefined(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "not within the United States";
    when dei_item_sale_of_property_to_non_us_person(c, y, item);
    when not_known(use_consumption_or_disposition_within_united_states_250(c, y, item));
    then foreign_use_250b5(c, y, item);
}
pub relation sale_to_related_party_not_united_states_person_250(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the property is sold to a related party who is not a United States person (section 250(b)(5)(C)(i))";
}
pub relation property_ultimately_sold_or_used_by_related_party_for_unrelated_non_us_person_250(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the property is ultimately sold by a related party, or used by a related party in connection with property which is sold or the provision of services, to an unrelated party who is not a United States person (section 250(b)(5)(C)(i)(I))";
}
pub relation related_party_sale_lacks_foreign_use_250b5c(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "a sale to a related non-United States person is not for a foreign use without the ultimate sale to an unrelated non-United States person";
}
@source(IRC_S250_B, quote = "such sale shall not be treated as for a foreign use unless")
rule RelatedPartySaleLacksForeignUse(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "no ultimate sale to an unrelated non-United States person";
    when sale_to_related_party_not_united_states_person_250(c, y, item);
    when not_known(item_has_components_250(c, y, item));
    when not_known(property_ultimately_sold_or_used_by_related_party_for_unrelated_non_us_person_250(c, y, item));
    then related_party_sale_lacks_foreign_use_250b5c(c, y, item);
}
pub relation service_to_related_party_not_located_in_united_states_250(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the service is provided to a related party who is not located in the United States (section 250(b)(5)(C)(ii))";
}
external judgment relation service_not_substantially_similar_to_related_party_services_established(c: Corporation, y: TaxableYear, item: Integer) {
    authority Secretary;
}
pub relation related_party_service_lacks_foreign_derived_status_250b5cii(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "a service to a related party not located in the United States is not described in subparagraph (A)(ii) unless not substantially similar to services the related party provides to persons located within the United States";
}
@source(IRC_S250_B, quote = "such service shall not be treated described [1] in subparagraph (A)(ii) [2] unless the taxpayer established to the satisfaction of the Secretary")
rule RelatedPartyServiceLacksForeignDerivedStatus(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "the taxpayer has not established that the service is not substantially similar";
    when service_to_related_party_not_located_in_united_states_250(c, y, item);
    when not_known(service_not_substantially_similar_to_related_party_services_established(c, y, item));
    then related_party_service_lacks_foreign_derived_status_250b5cii(c, y, item);
}
pub relation vote_percentage_of_stock_owned_250b5d(parent: Corporation, sub: Corporation, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the percentage of the total voting power of the subsidiary's stock owned by the parent (section 1504(a)(2)(A) as substituted)";
}
pub relation value_percentage_of_stock_owned_250b5d(parent: Corporation, sub: Corporation, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the percentage of the total value of the subsidiary's stock owned by the parent (section 1504(a)(2)(B) as substituted)";
}
pub relation related_party_by_ownership_250b5d(parent: Corporation, sub: Corporation, y: TaxableYear) kind institutional {
    label en official "a member of the affiliated group determined with more than 50 percent in place of at least 80 percent";
}
@source(IRC_S250_B, quote = "by substituting \"more than 50 percent\" for \"at least 80 percent\" each place it appears")
rule RelatedPartyByOwnership(parent: Corporation, sub: Corporation, y: TaxableYear, vote: Decimal, value: Decimal) strict {
    label en official "more than 50 percent of vote and of value";
    when vote_percentage_of_stock_owned_250b5d(parent, sub, y, vote);
    when value_percentage_of_stock_owned_250b5d(parent, sub, y, value);
    when vote > 50.0;
    when value > 50.0;
    then related_party_by_ownership_250b5d(parent, sub, y);
}
pub relation person_controlled_by_or_controlling_group_member_954d3_250(member: Corporation, other: Person, y: TaxableYear) kind empirical {
    label en official "the person (other than a corporation) is controlled by a member of the group, or controls a member, under the rules of section 954(d)(3) (section 250(b)(5)(D))";
}
pub relation related_party_by_control_250b5d(member: Corporation, other: Person, y: TaxableYear) kind institutional {
    label en official "a person other than a corporation treated as a member of the group by control";
}
@source(IRC_S250_B, quote = "Any person (other than a corporation) shall be treated as a member of such group if such person is controlled by members of such group")
rule RelatedPartyByControl(member: Corporation, other: Person, y: TaxableYear) strict {
    label en official "control under section 954(d)(3)";
    when person_controlled_by_or_controlling_group_member_954d3_250(member, other, y);
    then related_party_by_control_250b5d(member, other, y);
}
