// Section 183 — Activities not engaged in for profit. Stage 1 (IRC-06),
// priority section. Scope: (a) general rule; (b) deductions allowable
// (hobby-loss ordering); (c) definition; (d) the 3-of-5-year presumption as
// a `presumption`.

use self::{
    DeductionKind,
    IRC_S183_A,
    IRC_S183_B,
    IRC_S183_D,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation activity_not_engaged_in_for_profit(p: Person, y: TaxableYear, activity: Integer) kind institutional {
    label en official "an activity not engaged in for profit within section 183(c): one for which deductions are not otherwise allowable under section 162 or section 212(1)-(2)";
}
pub relation deduction_allowable_without_regard_to_profit_motive(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "the deductions that would be allowable under chapter 1 for the activity's taxable year without regard to whether the activity is engaged in for profit (section 183(b)(1))";
}
pub relation deduction_allowable_only_if_for_profit(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "the deductions that would be allowable under chapter 1 for the activity's taxable year only if the activity were engaged in for profit (section 183(b)(2))";
}
pub relation gross_income_from_activity(p: Person, y: TaxableYear, activity: Integer, amount: Money) kind institutional {
    label en official "gross income derived from the not-for-profit activity for the taxable year (section 183(b)(2))";
}

@source(IRC_S183_A, quote = "if such activity is not engaged in for profit, no deduction attributable to such activity shall be allowed under this chapter except as provided in this section")
rule NotForProfitActivityGeneralDisallowance(p: Person, y: TaxableYear, activity: Integer, amount: Money) strict {
    label en official "no deduction attributable to an activity not engaged in for profit is allowed except as section 183 itself provides (section 183(a))";
    when activity_not_engaged_in_for_profit(p, y, activity);
    when deduction_allowable_only_if_for_profit(p, y, activity, amount);
    then not deduction_allowed(p, y, Section183NotForProfitDisallowed, amount);
}
@source(IRC_S183_B, quote = "the deductions which would be allowable under this chapter for the taxable year without regard to whether or not such activity is engaged in for profit")
rule NotForProfitActivityCategoryOneAlwaysAllowed(p: Person, y: TaxableYear, activity: Integer, amount: Money) strict {
    label en official "deductions independently allowable regardless of profit motive remain allowed for a not-for-profit activity (section 183(b)(1))";
    when activity_not_engaged_in_for_profit(p, y, activity);
    when deduction_allowable_without_regard_to_profit_motive(p, y, activity, amount);
    then deduction_allowed(p, y, Section183NotForProfitDisallowed, amount);
}
@source(IRC_S183_B, quote = "but only to the extent that the gross income derived from such activity for the taxable year exceeds the deductions allowable by reason of paragraph (1)")
rule NotForProfitActivityCategoryTwoAllowedUpToExcessIncome(p: Person, y: TaxableYear, activity: Integer, category1: Money, category2: Money, gross: Money) strict {
    label en official "profit-motive-only deductions are allowed only to the extent gross income from the activity exceeds the category-1 deductions (section 183(b)(2))";
    when activity_not_engaged_in_for_profit(p, y, activity);
    when deduction_allowable_without_regard_to_profit_motive(p, y, activity, category1);
    when deduction_allowable_only_if_for_profit(p, y, activity, category2);
    when gross_income_from_activity(p, y, activity, gross);
    when gross > category1;
    when category2 <= gross - category1;
    then deduction_allowed(p, y, Section183NotForProfitDisallowed, category2);
}

// --- §183(d): the 3-of-5-year presumption ---------------------------------------

pub relation gross_income_exceeded_deductions_for_year(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "gross income derived from the activity for this taxable year exceeded the deductions attributable to it, determined without regard to profit motive (section 183(d))";
}
pub relation years_in_five_year_window_with_income_exceeding_deductions(p: Person, activity: Integer, window_end_y: TaxableYear, count: Integer) kind institutional {
    label en official "the count of taxable years, among the 5 consecutive taxable years ending with the taxable year in question, for which gross income from the activity exceeded attributable deductions (section 183(d)) — a scenario supplies the count directly (deriving it from 5 separate `gross_income_exceeded_deductions_for_year` facts needs year-window enumeration this stage does not model, TECH_GAP)";
}

pub relation activity_presumed_engaged_in_for_profit(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the activity is presumed, under section 183(d), to be engaged in for profit for the taxable year (SIMPLIFICATION: kept as a stand-alone disposition of the presumption mechanic, decoupled from `activity_not_engaged_in_for_profit` — a strict-rule consumer of a `presumption`'s defeasible conclusion is unavailable in language version 0.1, per LDC-E4103; a case that wants the presumption to drive the (a)/(b) allowance rules above asserts `activity_not_engaged_in_for_profit` (or its absence) directly, informed by this presumption's own outcome, rather than the engine chaining the two automatically)";
}
pub relation secretary_establishes_not_for_profit(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the Secretary establishes to the contrary of the section 183(d) presumption";
}

@source(IRC_S183_D, quote = "If the gross income derived from an activity for 3 or more of the taxable years in the period of 5 consecutive taxable years which ends with the taxable year exceeds the deductions attributable to such activity")
presumption ActivityPresumedEngagedInForProfit(
    p: Person,
    activity: Integer,
    y: TaxableYear,
) {
    label en official "if gross income from an activity exceeded attributable deductions for 3 or more of the 5 consecutive taxable years ending with the taxable year, the activity is presumed engaged in for profit, unless the Secretary establishes to the contrary (section 183(d))";
    when years_in_five_year_window_with_income_exceeding_deductions(p, activity, y, 3)
        or years_in_five_year_window_with_income_exceeding_deductions(p, activity, y, 4)
        or years_in_five_year_window_with_income_exceeding_deductions(p, activity, y, 5);
    presume activity_presumed_engaged_in_for_profit(p, activity, y);
    unless secretary_establishes_not_for_profit(p, activity, y)
        then not activity_presumed_engaged_in_for_profit(p, activity, y);
}
// (e) the election to defer the presumption determination (special 4-year/
// 6-year rule) stays "stage 2".
