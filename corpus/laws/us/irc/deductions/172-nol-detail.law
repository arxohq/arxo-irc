// Section 172 — net operating loss: stage 2b detail (TECH_GAPS G2801): (b)(1)(B)-(D) the carryback
// periods (farming, insurance companies, the 2018-2020 five-year rule) with the elections and REIT,
// life insurance and section 965 rules, (b)(2) the sequential absorption of a carryback, (b)(3) the
// waiver election, (c)/(d) the computation of the net operating loss with the (d) modifications,
// (e) other-year law, (f) insurance companies. The modified inputs are facts (each modification is a
// separate fact so a case shows which one moves the result). Not modelled: the section 857(b)(2)
// adjustments for REITs ((d)(6)(A), a fact `reit_adjustment_857b2`), the carryover to each of the 20
// years as year enumeration (stage 1 note), section 381/382 (external, (g)).

// --- (d): the net operating loss ---------------------------------------------------------------------------------------------------------------

use self::{
    IRC_S172_B,
    IRC_S172_C,
    IRC_S172_D,
    IRC_S172_E,
    IRC_S172_F,
    Person,
    TaxableYear,
    is_farming_loss_portion,
    net_operating_loss_for_year,
    taxable_income_before_nol_199a_250,
    taxable_year_begins_on,
};

pub relation gross_income_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income for the taxable year (section 172(c))";
}
pub relation deductions_allowed_by_chapter_1_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowed by chapter 1 for the taxable year before the section 172(d) modifications (section 172(c))";
}
pub relation nol_deduction_included_in_deductions(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net operating loss deduction included among the deductions, which is not allowed in computing the loss (section 172(d)(1))";
}
pub relation taxpayer_is_corporation_for_nol(p: Person) kind empirical {
    label en official "the taxpayer is a corporation (section 172(d)(2),(4) apply to a taxpayer other than a corporation)";
}
pub relation capital_loss_deduction_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount deductible on account of losses from sales or exchanges of capital assets (section 172(d)(2)(A))";
}
pub relation capital_gain_includable_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount includable on account of gains from sales or exchanges of capital assets (section 172(d)(2)(A))";
}
pub relation section_1202_exclusion_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the exclusion provided by section 1202 which is not allowed (section 172(d)(2)(B))";
}
pub relation section_151_or_substitute_deduction_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a deduction under section 151, or in lieu of it, which is not allowed (section 172(d)(3))";
}
pub relation section_199a_deduction_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a deduction under section 199A, which is not allowed (section 172(d)(8))";
}
pub relation section_250_deduction_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deduction under section 250, which is not allowed (section 172(d)(9))";
}
pub relation drd_as_computed_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions under sections 243 and 245 as computed with section 246(b) applied";
}
pub relation drd_computed_without_246b_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions under sections 243 and 245 computed without regard to section 246(b) (section 172(d)(5))";
}
pub relation reit_taxable_year_applies(p: Person, y: TaxableYear) kind empirical {
    label en official "part II of subchapter M (real estate investment trusts) applies to the taxpayer for the taxable year (section 172(d)(6))";
}
pub relation reit_adjustment_857b2_to_loss(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net effect on the loss computation of the adjustments described in section 857(b)(2) (other than the deduction for dividends paid) (section 172(d)(6)(A))";
}

pub relation deduction_item_for_nol(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a deduction allowable by chapter 1 for the taxable year (section 172(d)(4))";
}
pub relation deduction_item_is_trade_or_business_attributable(item: Integer) kind empirical {
    label en official "the deduction is attributable to the taxpayer's trade or business (section 172(d)(4))";
}
pub relation item_is_disposition_gain_or_loss_of_depreciable_or_real_business_property(item: Integer) kind empirical {
    label en official "the item is gain or loss from the sale or other disposition of property used in the trade or business subject to the section 167 allowance, or of real property used in the trade or business (section 172(d)(4)(A))";
}
pub relation item_is_casualty_or_theft_loss_165c2_or_3(item: Integer) kind empirical {
    label en official "the item is a deduction for casualty or theft losses allowable under paragraph (2) or (3) of section 165(c) (section 172(d)(4)(C))";
}
pub relation item_is_section_404_deduction_for_401c1_employee(item: Integer) kind empirical {
    label en official "the item is a section 404 deduction attributable to contributions made on behalf of an individual who is an employee within section 401(c)(1) (section 172(d)(4)(D))";
}
pub relation item_attributable_to_trade_or_business_for_nol(item: Integer) kind institutional {
    label en official "the item is treated as attributable to the trade or business for section 172(d)(4)";
}
@source(IRC_S172_D, quote = "shall be treated as attributable to the trade or business")
rule DispositionGainOrLossAttributableToBusiness(item: Integer) defeasible {
    label en official "gain or loss on the disposition of depreciable or real business property is attributable to the trade or business (section 172(d)(4)(A))";
    when item_is_disposition_gain_or_loss_of_depreciable_or_real_business_property(item);
    then item_attributable_to_trade_or_business_for_nol(item);
}
@source(IRC_S172_D, quote = "any deduction for casualty or theft losses allowable under paragraph (2) or (3) of section 165(c) shall be treated as attributable to the trade or business")
rule CasualtyOrTheftLossAttributableToBusiness(item: Integer) defeasible {
    label en official "casualty or theft losses under section 165(c)(2) or (3) are attributable to the trade or business (section 172(d)(4)(C))";
    when item_is_casualty_or_theft_loss_165c2_or_3(item);
    then item_attributable_to_trade_or_business_for_nol(item);
}
@source(IRC_S172_D, quote = "all be allowed only to the extent of the amount of the gross income not derived from such trade or business")
rule OrdinaryBusinessAttributableItem(item: Integer) defeasible {
    label en official "a deduction attributable to the trade or business by its nature is so attributable (section 172(d)(4))";
    when deduction_item_is_trade_or_business_attributable(item);
    when not_known(item_is_section_404_deduction_for_401c1_employee(item));
    then item_attributable_to_trade_or_business_for_nol(item);
}
pub relation nonbusiness_deduction_item_for_nol(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "a deduction not attributable to the taxpayer's trade or business (section 172(d)(4))";
}
rule NonbusinessDeductionItemDerived(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "a deduction item not attributable to the trade or business (a section 404 deduction for a 401(c)(1) employee is never attributable, section 172(d)(4)(D))";
    when deduction_item_for_nol(p, y, item, amount);
    when not_known(item_attributable_to_trade_or_business_for_nol(item));
    then nonbusiness_deduction_item_for_nol(p, y, item, amount);
}
pub relation nonbusiness_deductions_total_for_nol(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the deductions not attributable to the trade or business";
}
rule NonbusinessDeductionsTotalDerived(p: Person, y: TaxableYear, i0: Integer, a0: Money) defeasible {
    label en official "helper: sums the nonbusiness deductions (section 172(d)(4))";
    when nonbusiness_deduction_item_for_nol(p, y, i0, a0);
    then nonbusiness_deductions_total_for_nol(p, y,
        sum all amount: Money for item: Integer where nonbusiness_deduction_item_for_nol(p, y, item, amount));
}
pub relation gross_income_not_derived_from_trade_or_business_for_nol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income not derived from the trade or business, with the paragraph (4)(A)-(C) treatments and the paragraph (1),(2)(B),(3) modifications taken into account (section 172(d)(4))";
}
pub relation nonbusiness_deductions_disallowed_for_nol(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the nonbusiness deductions in excess of the gross income not derived from the trade or business, which are not allowed in computing the loss (section 172(d)(4))";
}
@source(IRC_S172_D, quote = "the deductions allowable by this chapter which are not attributable to a taxpayer's trade or business shall be allowed only to the extent of the amount of the gross income not derived from such trade or business")
rule NonbusinessDeductionsExcessDisallowed(p: Person, y: TaxableYear, nonbusiness: Money, nonbusiness_income: Money) defeasible {
    label en official "a taxpayer other than a corporation may deduct nonbusiness deductions only up to nonbusiness gross income (section 172(d)(4)); the excess is removed from the loss computation";
    when not_known(taxpayer_is_corporation_for_nol(p));
    when nonbusiness_deductions_total_for_nol(p, y, nonbusiness);
    when gross_income_not_derived_from_trade_or_business_for_nol(p, y, nonbusiness_income);
    when nonbusiness > nonbusiness_income;
    then nonbusiness_deductions_disallowed_for_nol(p, y, nonbusiness - nonbusiness_income);
}
pub relation nonbusiness_deductions_disallowed_for_nol_zero(p: Person, y: TaxableYear) kind institutional {
    label en official "no nonbusiness deductions are disallowed (helper for the aggregate below)";
}
pub relation capital_loss_excess_over_gains_for_nol(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the capital loss deduction in excess of capital gains includable, not allowed for a taxpayer other than a corporation (section 172(d)(2)(A))";
}
@source(IRC_S172_D, quote = "the amount deductible on account of losses from sales or exchanges of capital assets shall not exceed the amount includable on account of gains from sales or exchanges of capital assets")
rule CapitalLossExcessOverGainsRemoved(p: Person, y: TaxableYear, loss: Money, gain: Money) defeasible {
    label en official "a non-corporate taxpayer's capital loss deduction is limited to capital gains in computing the loss (section 172(d)(2)(A))";
    when not_known(taxpayer_is_corporation_for_nol(p));
    when capital_loss_deduction_for_nol(p, y, loss);
    when capital_gain_includable_for_nol(p, y, gain);
    when loss > gain;
    then capital_loss_excess_over_gains_for_nol(p, y, loss - gain);
}

pub relation net_operating_loss_computed_from_modifications(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net operating loss: the excess of the deductions allowed by chapter 1, with the section 172(d) modifications, over gross income, with the modifications (section 172(c),(d)); zero when there is no excess";
}
@source(IRC_S172_C, quote = "the term \"net operating loss\" means the excess of the deductions allowed by this chapter over the gross income")
rule NetOperatingLossComputedWithModifications(p: Person, y: TaxableYear, gross: Money, deductions: Money, nol_ded: Money, cap_excess: Money, s1202: Money, exemption: Money, nonbusiness_disallowed: Money, drd_asc: Money, drd_no246b: Money, qbi: Money, fdii: Money, reit_adj: Money) defeasible {
    label en official "NOL = max(0, (deductions - NOL deduction - capital loss excess - personal exemption - disallowed nonbusiness - 199A - 250 + DRD recomputation) - (gross income + section 1202 exclusion) + REIT adjustment) (section 172(c),(d)(1)-(9)); each modification is a separate fact and each element absent from the case must be asserted as zero";
    when gross_income_for_nol(p, y, gross);
    when deductions_allowed_by_chapter_1_for_nol(p, y, deductions);
    when nol_deduction_included_in_deductions(p, y, nol_ded);
    when capital_loss_excess_over_gains_for_nol(p, y, cap_excess);
    when section_1202_exclusion_for_nol(p, y, s1202);
    when section_151_or_substitute_deduction_for_nol(p, y, exemption);
    when nonbusiness_deductions_disallowed_for_nol(p, y, nonbusiness_disallowed);
    when drd_as_computed_for_nol(p, y, drd_asc);
    when drd_computed_without_246b_for_nol(p, y, drd_no246b);
    when section_199a_deduction_for_nol(p, y, qbi);
    when section_250_deduction_for_nol(p, y, fdii);
    when reit_adjustment_857b2_to_loss(p, y, reit_adj);
    then net_operating_loss_computed_from_modifications(p, y,
        max(0.00 USD, deductions - nol_ded - cap_excess - exemption - nonbusiness_disallowed - qbi - fdii + drd_no246b - drd_asc - gross - s1202 + reit_adj));
}

pub relation net_operating_loss_computed_is_positive(p: Person, y: TaxableYear) kind institutional {
    label en official "helper: the computed net operating loss for the year is positive";
}
@source(IRC_S172_C, quote = "the term \"net operating loss\" means the excess of the deductions allowed by this chapter over the gross income")
rule NetOperatingLossForYearFromComputation(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "wires the stage 1 dependency contract `net_operating_loss_for_year` to the computed loss when it is positive (section 172(c))";
    when net_operating_loss_computed_from_modifications(p, y, amount);
    when amount > 0.00 USD;
    then net_operating_loss_for_year(p, y, amount);
}

// --- (d)(6)(C): REIT taxable income for the 80-percent cap --------------------------------------------------------------------------------------------

pub relation reit_taxable_income_without_dividends_paid_deduction(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "real estate investment trust taxable income (section 857(b)(2)) but without regard to the deduction for dividends paid (section 561) (section 172(d)(6)(C))";
}
@source(IRC_S172_D, quote = "subsection (a)(2)(B)(ii)(I) shall be applied by substituting \"real estate investment trust taxable income")
rule TaxableIncomeBeforeNolForReitYear(p: Person, y: TaxableYear, reit_ti: Money) strict {
    label en official "in a REIT year the taxable income of (a)(2)(B)(ii)(I) is the REIT taxable income without the dividends paid deduction (section 172(d)(6)(C))";
    when reit_taxable_year_applies(p, y);
    when reit_taxable_income_without_dividends_paid_deduction(p, y, reit_ti);
    then taxable_income_before_nol_199a_250(p, y, reit_ti);
}

// --- (b)(1): carryback periods -----------------------------------------------------------------------------------------------------------------------------

pub relation insurance_company_other_than_life_for_nol(p: Person) kind empirical {
    label en official "an insurance company (section 816(a)) other than a life insurance company (section 172(b)(1)(C))";
}
pub relation life_insurance_company_for_nol(p: Person) kind empirical {
    label en official "a life insurance company";
}
pub relation farming_loss_election_out_of_carryback(p: Person, y_loss: TaxableYear) kind institutional {
    label en official "the taxpayer's election not to apply the 2-year farming carryback to the loss year is in effect (section 172(b)(1)(B)(iv))";
}
pub relation carryback_waived_for_loss_year(p: Person, y_loss: TaxableYear) kind institutional {
    label en official "the taxpayer's election to relinquish the entire carryback period is in effect for the loss year (section 172(b)(3))";
}
pub relation nol_arises_in_year_beginning_2018_to_2020(p: Person, y_loss: TaxableYear) kind institutional {
    label en official "the net operating loss arises in a taxable year beginning after December 31, 2017 and before January 1, 2021 (section 172(b)(1)(D)(i))";
}
rule NolYear2018To2020(p: Person, y_loss: TaxableYear, begins: Date) strict {
    label en official "the loss year begins after 2017 and before 2021";
    when net_operating_loss_arises_in_year(p, y_loss);
    when taxable_year_begins_on(y_loss, begins);
    when begins >= @2018-01-01;
    when begins <= @2020-12-31;
    then nol_arises_in_year_beginning_2018_to_2020(p, y_loss);
}
pub relation nol_carryback_period_years(p: Person, y_loss: TaxableYear, years: Integer) kind institutional {
    label en official "the number of taxable years preceding the loss year to which the net operating loss is carried back (section 172(b)(1))";
}
pub relation net_operating_loss_arises_in_year(p: Person, y_loss: TaxableYear) kind empirical {
    label en official "a net operating loss arises in the taxable year (binds the loss year of the carryback rules)";
}
pub relation reit_year_for_carryback(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is a REIT year: part II of subchapter M applies to the taxpayer (section 172(b)(1)(D)(ii)(III))";
}
@source(IRC_S172_B, quote = "such loss shall be a net operating loss carryback to each of the 5 taxable years preceding the taxable year of such loss")
rule FiveYearCarrybackFor2018To2020Losses(p: Person, y_loss: TaxableYear) defeasible {
    label en official "a loss arising in a year beginning after 2017 and before 2021 is carried back 5 years; the farming and insurance rules do not apply (section 172(b)(1)(D)(i)), unless the loss is of a REIT year or carryback is waived";
    when net_operating_loss_arises_in_year(p, y_loss);
    when nol_arises_in_year_beginning_2018_to_2020(p, y_loss);
    when not_known(reit_year_for_carryback(p, y_loss));
    when not_known(carryback_waived_for_loss_year(p, y_loss));
    then nol_carryback_period_years(p, y_loss, 5);
}
@source(IRC_S172_B, quote = "In the case of any portion of a net operating loss for the taxable year which is a farming loss with respect to the taxpayer, such loss shall be a net operating loss carryback to each of the 2 taxable years preceding the taxable year of such loss.")
rule TwoYearCarrybackForFarmingLoss(p: Person, y_loss: TaxableYear, amount: Money) defeasible {
    label en official "the farming-loss portion is carried back 2 years, except for 2018-2020 losses (rule D governs), when the election out is made, or when carryback is waived (section 172(b)(1)(B))";
    when is_farming_loss_portion(p, y_loss, amount);
    when not_known(nol_arises_in_year_beginning_2018_to_2020(p, y_loss));
    when not_known(farming_loss_election_out_of_carryback(p, y_loss));
    when not_known(carryback_waived_for_loss_year(p, y_loss));
    then nol_carryback_period_years(p, y_loss, 2);
}
@source(IRC_S172_B, quote = "shall be a net operating loss carryback to each of the 2 taxable years preceding the taxable year of such loss, and")
rule TwoYearCarrybackForInsuranceCompanies(p: Person, y_loss: TaxableYear) defeasible {
    label en official "an insurance company other than a life insurance company carries the loss back 2 years, except 2018-2020 losses (section 172(b)(1)(C)(i)); the election of paragraph (3) may waive it";
    when net_operating_loss_arises_in_year(p, y_loss);
    when insurance_company_other_than_life_for_nol(p);
    when not_known(nol_arises_in_year_beginning_2018_to_2020(p, y_loss));
    when not_known(carryback_waived_for_loss_year(p, y_loss));
    then nol_carryback_period_years(p, y_loss, 2);
}
pub relation nol_carryover_years_limit(p: Person, y_loss: TaxableYear, years: Integer) kind institutional {
    label en official "the number of taxable years following the loss year to which the loss is carried over: 20 for a loss beginning before 2018 and for a non-life insurance company; otherwise unlimited (no fact) (section 172(b)(1)(A)(ii),(C)(ii))";
}
@source(IRC_S172_B, quote = "in the case of a net operating loss arising in a taxable year beginning before January 1, 2018, to each of the 20 taxable years following the taxable year of the loss")
rule TwentyYearCarryoverPre2018(p: Person, y_loss: TaxableYear, begins: Date) defeasible {
    label en official "a loss arising in a year beginning before 2018 carries over 20 years (section 172(b)(1)(A)(ii)(I))";
    when net_operating_loss_arises_in_year(p, y_loss);
    when taxable_year_begins_on(y_loss, begins);
    when begins < @2018-01-01;
    then nol_carryover_years_limit(p, y_loss, 20);
}
@source(IRC_S172_B, quote = "shall be a net operating loss carryover to each of the 20 taxable years following the taxable year of the loss")
rule TwentyYearCarryoverInsuranceCompanies(p: Person, y_loss: TaxableYear) defeasible {
    label en official "a non-life insurance company carries the loss over 20 years (section 172(b)(1)(C)(ii))";
    when net_operating_loss_arises_in_year(p, y_loss);
    when insurance_company_other_than_life_for_nol(p);
    then nol_carryover_years_limit(p, y_loss, 20);
}

// --- (b)(1)(D)(ii)-(v): REIT, life insurance and section 965 rules ---------------------------------------------------------------------------------------------

pub relation carryback_to_year_allowed(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) kind institutional {
    label en official "the loss may be carried back to the preceding taxable year";
}
pub relation prior_year_within_carryback_period(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) kind empirical {
    label en official "the prior taxable year lies within the carryback period of the loss";
}
@source(IRC_S172_B, quote = "A net operating loss for a REIT year shall not be a net operating loss carryback to any taxable year preceding the taxable year of such loss.")
rule ReitYearLossNotCarriedBack(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) strict {
    label en official "a REIT-year loss is not carried back to any preceding year (section 172(b)(1)(D)(ii)(I))";
    when nol_arises_in_year_beginning_2018_to_2020(p, y_loss);
    when reit_year_for_carryback(p, y_loss);
    when prior_year_within_carryback_period(p, y_loss, y_prior);
    then not carryback_to_year_allowed(p, y_loss, y_prior);
}
@source(IRC_S172_B, quote = "such loss shall not be carried to any preceding taxable year which is a REIT year")
rule NonReitLossNotCarriedToReitYear(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) strict {
    label en official "a non-REIT-year loss is not carried to a preceding REIT year (section 172(b)(1)(D)(ii)(II))";
    when nol_arises_in_year_beginning_2018_to_2020(p, y_loss);
    when prior_year_within_carryback_period(p, y_loss, y_prior);
    when reit_year_for_carryback(p, y_prior);
    when not_known(reit_year_for_carryback(p, y_loss));
    then not carryback_to_year_allowed(p, y_loss, y_prior);
}
pub relation carryback_to_life_insurance_year_before_2018(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) kind empirical {
    label en official "a net operating loss carried under clause (i)(I) to a life insurance company taxable year beginning before January 1, 2018 (section 172(b)(1)(D)(iii))";
}
pub relation carryback_treated_as_operations_loss_carryback_810(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) kind institutional {
    label en official "the carryback is treated as an operations loss carryback within the meaning of section 810 as in effect before its repeal (section 172(b)(1)(D)(iii))";
}
@source(IRC_S172_B, quote = "such net operating loss carryback shall be treated in the same manner as an operations loss carryback")
rule LifeInsuranceCarrybackTreatedAsOperationsLoss(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) strict {
    label en official "a 5-year carryback to a pre-2018 life insurance year is an operations loss carryback (section 172(b)(1)(D)(iii))";
    when nol_arises_in_year_beginning_2018_to_2020(p, y_loss);
    when life_insurance_company_for_nol(p);
    when carryback_to_life_insurance_year_before_2018(p, y_loss, y_prior);
    then carryback_treated_as_operations_loss_carryback_810(p, y_loss, y_prior);
}
pub relation prior_year_includes_amount_under_section_965a(p: Person, y_prior: TaxableYear) kind empirical {
    label en official "an amount is includible in gross income for the taxable year by reason of section 965(a) (section 172(b)(1)(D)(iv))";
}
pub relation treated_as_having_made_965n_election(p: Person, y_prior: TaxableYear) kind institutional {
    label en official "the taxpayer is treated as having made the election under section 965(n) for the taxable year (section 172(b)(1)(D)(iv))";
}
@source(IRC_S172_B, quote = "the taxpayer shall be treated as having made the election under section 965(n) with respect to each such taxable year")
rule Carryback965YearDeemedElection(p: Person, y_loss: TaxableYear, y_prior: TaxableYear) strict {
    label en official "a 5-year carryback to a section 965(a) year is a deemed section 965(n) election for that year (section 172(b)(1)(D)(iv))";
    when nol_arises_in_year_beginning_2018_to_2020(p, y_loss);
    when prior_year_within_carryback_period(p, y_loss, y_prior);
    when prior_year_includes_amount_under_section_965a(p, y_prior);
    then treated_as_having_made_965n_election(p, y_prior);
}

// --- elections --------------------------------------------------------------------------------------------------------------------------------------------------------

pub relation elects_out_of_farming_two_year_carryback(p: Person, y_loss: TaxableYear) kind empirical {
    label en official "the taxpayer elects not to apply the farming carryback of clause (i) to the loss year (section 172(b)(1)(B)(iv))";
}
pub relation election_made_by_due_date_including_extensions_for_loss_year(p: Person, y_loss: TaxableYear) kind empirical {
    label en official "the election is made by the due date (including extensions) for filing the return for the taxable year of the net operating loss, in the manner the Secretary prescribes (section 172(b)(1)(B)(iv),(3))";
}
@source(IRC_S172_B, quote = "Any taxpayer entitled to a 2-year carryback under clause (i) from any loss year may elect not to have such clause apply to such loss year.")
rule S172FarmingCarrybackElectionOutPower(p: Person, y_loss: TaxableYear) defeasible {
    label en official "a taxpayer entitled to the 2-year farming carryback may elect out of it by the return due date; once made it is irrevocable for the year (section 172(b)(1)(B)(iv)); a late election has no effect";
    when elects_out_of_farming_two_year_carryback(p, y_loss);
    then power S172ElectOutOfFarmingCarryback {
        holder p;
        over y_loss;
        exercise elects_out_of_farming_two_year_carryback(p, y_loss);
        valid_when election_made_by_due_date_including_extensions_for_loss_year(p, y_loss);
        effect create(farming_loss_election_out_of_carryback(p, y_loss));
        window [-infinity, infinity];
    };
}
pub relation elects_to_relinquish_carryback_period(p: Person, y_loss: TaxableYear) kind empirical {
    label en official "the taxpayer elects to relinquish the entire carryback period for the net operating loss of the taxable year (section 172(b)(3))";
}
@source(IRC_S172_B, quote = "Any taxpayer entitled to a carryback period under paragraph (1) may elect to relinquish the entire carryback period with respect to a net operating loss for any taxable year.")
rule S172WaiveCarrybackElectionPower(p: Person, y_loss: TaxableYear) defeasible {
    label en official "a taxpayer may elect to relinquish the whole carryback period by the return due date; irrevocable for the year (section 172(b)(3)); a late election has no effect";
    when elects_to_relinquish_carryback_period(p, y_loss);
    then power S172WaiveCarrybackPeriod {
        holder p;
        over y_loss;
        exercise elects_to_relinquish_carryback_period(p, y_loss);
        valid_when election_made_by_due_date_including_extensions_for_loss_year(p, y_loss);
        effect create(carryback_waived_for_loss_year(p, y_loss));
        window [-infinity, infinity];
    };
}
pub relation five_year_carryback_includes_965_years(p: Person, y_loss: TaxableYear) kind empirical {
    label en official "the 5-year carryback period includes one or more taxable years in which an amount is includible by reason of section 965(a) (section 172(b)(1)(D)(v)(I))";
}
pub relation elects_to_exclude_965_years_from_carryback(p: Person, y_loss: TaxableYear) kind empirical {
    label en official "the taxpayer elects under paragraph (3) to exclude all section 965(a) years from the 5-year carryback period (section 172(b)(1)(D)(v)(I))";
}
pub relation section_965_years_excluded_from_carryback(p: Person, y_loss: TaxableYear) kind institutional {
    label en official "all section 965(a) years are excluded from the carryback period of the loss";
}
rule S172Exclude965YearsElectionPower(p: Person, y_loss: TaxableYear) defeasible {
    label en official "where the 5-year period includes section 965(a) years, the taxpayer may instead elect to exclude them (section 172(b)(1)(D)(v)(I)); the election timing for 2018 and 2019 losses is a fact of timeliness (section 172(b)(1)(D)(v)(II))";
    when elects_to_exclude_965_years_from_carryback(p, y_loss);
    then power S172ExcludeSection965YearsFromCarryback {
        holder p;
        over y_loss;
        exercise elects_to_exclude_965_years_from_carryback(p, y_loss);
        valid_when five_year_carryback_includes_965_years_and_timely(p, y_loss);
        effect create(section_965_years_excluded_from_carryback(p, y_loss));
        window [-infinity, infinity];
    };
}
pub relation five_year_carryback_includes_965_years_and_timely(p: Person, y_loss: TaxableYear) kind institutional {
    label en official "the 5-year period includes section 965(a) years and the election is timely";
}
rule ExcludeElectionValidityHelper(p: Person, y_loss: TaxableYear) strict {
    label en official "helper: the conditions of the (v)(I) election are met";
    when five_year_carryback_includes_965_years(p, y_loss);
    when election_made_by_due_date_including_extensions_for_loss_year(p, y_loss);
    then five_year_carryback_includes_965_years_and_timely(p, y_loss);
}

// --- (b)(2): sequential absorption of a carryback -----------------------------------------------------------------------------------------------------------------

pub relation carryback_year_taxable_income(p: Person, y_loss: TaxableYear, k: Integer, amount: Money) kind empirical {
    label en official "the taxable income of the k-th preceding year to which the loss may be carried, computed with the (d) modifications (other than paragraphs (1),(4),(5)) and without the NOL deduction for the loss year or later years (section 172(b)(2)(A)); k = 1 is the earliest year";
}
pub relation carryback_year_excess_a2bii(p: Person, y_loss: TaxableYear, k: Integer, amount: Money) kind empirical {
    label en official "the excess described in subsection (a)(2)(B)(ii) for the k-th carryback year (section 172(b)(2)(C))";
}
pub relation carryback_year_begins_on(p: Person, y_loss: TaxableYear, k: Integer, on: Date) kind empirical {
    label en official "the date the k-th carryback taxable year begins";
}
pub relation carryback_year_adjusted_income(p: Person, y_loss: TaxableYear, k: Integer, amount: Money) kind institutional {
    label en official "the taxable income of the k-th carryback year for the absorption: not below zero and, for years beginning after 2020, reduced by 20 percent of the (a)(2)(B)(ii) excess (section 172(b)(2)(B),(C))";
}
@source(IRC_S172_B, quote = "not be considered to be less than zero")
rule CarrybackYearIncomeNotBelowZeroBefore2021(p: Person, y_loss: TaxableYear, k: Integer, ti: Money, begins: Date) strict {
    label en official "the prior year's taxable income is not less than zero (section 172(b)(2)(B)); for a year beginning before 2021 no 20-percent reduction";
    when carryback_year_taxable_income(p, y_loss, k, ti);
    when carryback_year_begins_on(p, y_loss, k, begins);
    when begins <= @2020-12-31;
    then carryback_year_adjusted_income(p, y_loss, k, max(0.00 USD, ti));
}
@source(IRC_S172_B, quote = "for taxable years beginning after December 31, 2020, be reduced by 20 percent of the excess (if any) described in subsection (a)(2)(B)(ii) for such taxable year")
rule CarrybackYearIncomeReducedTwentyPercentAfter2020(p: Person, y_loss: TaxableYear, k: Integer, ti: Money, begins: Date, excess: Money) strict {
    label en official "for a year beginning after 2020 the taxable income is reduced by 20 percent of the (a)(2)(B)(ii) excess, then not below zero (section 172(b)(2)(B),(C))";
    when carryback_year_taxable_income(p, y_loss, k, ti);
    when carryback_year_begins_on(p, y_loss, k, begins);
    when carryback_year_excess_a2bii(p, y_loss, k, excess);
    when begins >= @2021-01-01;
    then carryback_year_adjusted_income(p, y_loss, k, max(0.00 USD, ti - round(excess * 20 percent, 2, "HALF_UP")));
}
pub relation nol_carried_to_carryback_year_1(p: Person, y_loss: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the loss carried to the earliest carryback year: the entire loss (section 172(b)(2))";
}
pub relation nol_carried_to_carryback_year_2(p: Person, y_loss: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the loss carried to the second carryback year: the excess of the loss over the taxable income of the first year (section 172(b)(2))";
}
pub relation nol_carried_to_carryback_year_3(p: Person, y_loss: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the loss carried to the third carryback year (section 172(b)(2))";
}
pub relation nol_carried_to_carryback_year_4(p: Person, y_loss: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the loss carried to the fourth carryback year (section 172(b)(2))";
}
pub relation nol_carried_to_carryback_year_5(p: Person, y_loss: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the loss carried to the fifth carryback year (section 172(b)(2))";
}
@source(IRC_S172_B, quote = "The entire amount of the net operating loss for any taxable year (hereinafter in this section referred to as the \"loss year\") shall be carried to the earliest of the taxable years")
rule NolCarriedToEarliestCarrybackYear(p: Person, y_loss: TaxableYear, amount: Money, years: Integer) defeasible {
    label en official "the entire loss is carried to the earliest year of the carryback period (section 172(b)(2))";
    when net_operating_loss_computed_from_modifications(p, y_loss, amount);
    when nol_carryback_period_years(p, y_loss, years);
    when years >= 1;
    then nol_carried_to_carryback_year_1(p, y_loss, amount);
}
@source(IRC_S172_B, quote = "The portion of such loss which shall be carried to each of the other taxable years shall be the excess, if any, of the amount of such loss over the sum of the taxable income for each of the prior taxable years to which such loss may be carried.")
rule NolCarriedToCarrybackYear2(p: Person, y_loss: TaxableYear, carried1: Money, ti1: Money, years: Integer) defeasible {
    label en official "the portion carried to the second year is the excess of the loss over the first year's taxable income (section 172(b)(2))";
    when nol_carried_to_carryback_year_1(p, y_loss, carried1);
    when carryback_year_adjusted_income(p, y_loss, 1, ti1);
    when nol_carryback_period_years(p, y_loss, years);
    when years >= 2;
    when carried1 > ti1;
    then nol_carried_to_carryback_year_2(p, y_loss, carried1 - ti1);
}
@source(IRC_S172_B, quote = "The portion of such loss which shall be carried to each of the other taxable years shall be the excess, if any, of the amount of such loss over the sum of the taxable income for each of the prior taxable years to which such loss may be carried.")
rule NolCarriedToCarrybackYear3(p: Person, y_loss: TaxableYear, carried2: Money, ti2: Money, years: Integer) defeasible {
    label en official "the portion carried to the third year is the remaining loss after the second year's taxable income (section 172(b)(2))";
    when nol_carried_to_carryback_year_2(p, y_loss, carried2);
    when carryback_year_adjusted_income(p, y_loss, 2, ti2);
    when nol_carryback_period_years(p, y_loss, years);
    when years >= 3;
    when carried2 > ti2;
    then nol_carried_to_carryback_year_3(p, y_loss, carried2 - ti2);
}
@source(IRC_S172_B, quote = "The portion of such loss which shall be carried to each of the other taxable years shall be the excess, if any, of the amount of such loss over the sum of the taxable income for each of the prior taxable years to which such loss may be carried.")
rule NolCarriedToCarrybackYear4(p: Person, y_loss: TaxableYear, carried3: Money, ti3: Money, years: Integer) defeasible {
    label en official "the portion carried to the fourth year (section 172(b)(2))";
    when nol_carried_to_carryback_year_3(p, y_loss, carried3);
    when carryback_year_adjusted_income(p, y_loss, 3, ti3);
    when nol_carryback_period_years(p, y_loss, years);
    when years >= 4;
    when carried3 > ti3;
    then nol_carried_to_carryback_year_4(p, y_loss, carried3 - ti3);
}
@source(IRC_S172_B, quote = "The portion of such loss which shall be carried to each of the other taxable years shall be the excess, if any, of the amount of such loss over the sum of the taxable income for each of the prior taxable years to which such loss may be carried.")
rule NolCarriedToCarrybackYear5(p: Person, y_loss: TaxableYear, carried4: Money, ti4: Money, years: Integer) defeasible {
    label en official "the portion carried to the fifth year (section 172(b)(2))";
    when nol_carried_to_carryback_year_4(p, y_loss, carried4);
    when carryback_year_adjusted_income(p, y_loss, 4, ti4);
    when nol_carryback_period_years(p, y_loss, years);
    when years >= 5;
    when carried4 > ti4;
    then nol_carried_to_carryback_year_5(p, y_loss, carried4 - ti4);
}

// --- (e),(f): other-year law and insurance companies --------------------------------------------------------------------------------------------------------------------

pub relation nol_computation_involves_other_taxable_year(y: TaxableYear, other: TaxableYear) kind empirical {
    label en official "the necessary computations for a net operating loss carryback or carryover involve another taxable year (section 172(e))";
}
pub relation computation_governed_by_law_applicable_to_taxable_year(other: TaxableYear) kind institutional {
    label en official "the computation for the other taxable year is made under the law applicable to that year (section 172(e))";
}
@source(IRC_S172_E, quote = "the necessary computations involving any other taxable year shall be made under the law applicable to such other taxable year")
rule ComputationsUnderLawOfOtherYear(y: TaxableYear, other: TaxableYear) strict {
    label en official "computations involving another year use that year's law (section 172(e)): a case evaluates the other year at that year's legal time";
    when nol_computation_involves_other_taxable_year(y, other);
    then computation_governed_by_law_applicable_to_taxable_year(other);
}
pub relation nol_carryovers_to_year_total(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate of the net operating loss carryovers to the taxable year";
}
pub relation nol_carrybacks_to_year_total(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate of the net operating loss carrybacks to the taxable year";
}
pub relation insurance_company_nol_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net operating loss deduction of a non-life insurance company: the aggregate carryovers plus carrybacks, without the 80-percent limitation and without the 20-percent reduction of (b)(2)(C) (section 172(f))";
}
@source(IRC_S172_F, quote = "the amount of the deduction allowed under subsection (a) shall be the aggregate of the net operating loss carryovers to such year, plus the net operating loss carrybacks to such year")
rule InsuranceCompanyNolDeductionAggregate(p: Person, y: TaxableYear, carryovers: Money, carrybacks: Money) strict {
    label en official "a non-life insurance company's deduction is the aggregate of carryovers and carrybacks (section 172(f)(1)); paragraph (f)(2) means the (b)(2)(C) reduction is simply not applied to its carryback years";
    when insurance_company_other_than_life_for_nol(p);
    when nol_carryovers_to_year_total(p, y, carryovers);
    when nol_carrybacks_to_year_total(p, y, carrybacks);
    then insurance_company_nol_deduction(p, y, carryovers + carrybacks);
}
