// Section 170 — remaining subsections (stage 2): (f)(19) reporting for partnership
// conservation contributions of certified historic structures, (g) students in the
// taxpayer's household, (h) qualified conservation contribution (with the
// pass-through limit of (h)(7)), (i) standard mileage rate, (j) travel expenses,
// (l) athletic seating rights, (n) whaling captains and (o) fractional gifts.
// Not modelled (TECH_GAPS G2779): (m) intellectual property donee income (annual
// percentage schedule over 12 years and income allocation), the fair market
// value of the conserved interest, and the (o)(3) recapture interest amount.
// Deemed contributions of (g) and (n) conclude `deduction_allowed(..,
// Section170Charitable, ..)` for the amount before the section 170(b) percentage
// limits, because `charitable_contribution_made` is an asserted (empirical) fact.

// === (f)(19): reporting for conservation contributions by partnerships =======================

use self::{
    CooperativeIndebtednessPurpose,
    DeductionKind,
    IRC_S170_19,
    IRC_S170_G,
    IRC_S170_H,
    IRC_S170_I,
    IRC_S170_J,
    IRC_S170_L,
    IRC_S170_N,
    IRC_S170_O,
    IncomeProductionPurpose212,
    Person,
    SoilConservationPurpose175,
    TaxableYear,
    deduction_allowed,
};

pub relation partnership_contribution_certified_historic_structure_above_2_5_times_basis(partnership: Integer, y: TaxableYear) kind institutional {
    label en official "the partnership makes a qualified conservation contribution whose conservation purpose is the preservation of a certified historic structure and whose amount exceeds 2.5 times the sum of each partner's relevant basis (section 170(f)(19)(B)); an asserted classification, the relevant basis is not computed here";
}
pub relation partnership_includes_statement_on_return_of_conservation_contribution(partnership: Integer, y: TaxableYear) kind empirical {
    label en official "the partnership includes on its return for the year of the contribution a statement that it made such a contribution (section 170(f)(19)(A)(i))";
}
pub relation partnership_provides_required_information_on_conservation_contribution(partnership: Integer, y: TaxableYear) kind empirical {
    label en official "the partnership provides such information about the contribution as the Secretary may require (section 170(f)(19)(A)(ii))";
}
pub relation partnership_conservation_contribution_reporting_condition_met(partnership: Integer, y: TaxableYear) kind institutional {
    label en official "the reporting condition of section 170(f)(19) is met: the deduction is not barred for want of the statement and information";
}
@source(IRC_S170_19, quote = "includes on its return for the taxable year in which the contribution is made a statement that the partnership made such a contribution")
rule ConservationReportingConditionMet(partnership: Integer, y: TaxableYear) strict {
    label en official "the condition is met when the statement is included and the required information provided (section 170(f)(19)(A))";
    when partnership_includes_statement_on_return_of_conservation_contribution(partnership, y);
    when partnership_provides_required_information_on_conservation_contribution(partnership, y);
    then partnership_conservation_contribution_reporting_condition_met(partnership, y);
}
pub relation partnership_conservation_contribution_deduction_barred(partnership: Integer, y: TaxableYear) kind institutional {
    label en official "no deduction is allowed for the partnership's conservation contribution for want of the reporting (section 170(f)(19)(A))";
}
@source(IRC_S170_19, quote = "no deduction shall be allowed under subsection (a) for such contribution unless the partnership making such contribution—")
rule ConservationReportingDeductionBarred(partnership: Integer, y: TaxableYear) strict {
    label en official "the reporting is a validity condition of the deduction, not a duty whose breach is sanctioned here (section 170(f)(19)(A))";
    when partnership_contribution_certified_historic_structure_above_2_5_times_basis(partnership, y);
    when not_known(partnership_conservation_contribution_reporting_condition_met(partnership, y));
    then partnership_conservation_contribution_deduction_barred(partnership, y);
}

// === (g): amounts paid to maintain students in the taxpayer's household ========================

pub relation student_maintenance_payment(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid by the taxpayer within the year to maintain an individual other than a dependent or a relative as a member of the household under a written agreement with a section 170(c)(2),(3) or (4) organization to implement a program providing educational opportunities for pupils in private homes, the individual being a full-time pupil or student in the twelfth or a lower grade at a U.S. school described in section 170(b)(1)(A)(ii) (section 170(g)(1))";
}
pub relation full_calendar_months_of_student_in_household(p: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of full calendar months of the year falling within the household period, a month counting as full if 15 or more of its days fall within the period (section 170(g)(2)(A))";
}
pub relation received_compensation_or_reimbursement_for_maintaining_student(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer receives money or other property as compensation or reimbursement for maintaining the individual (section 170(g)(2)(B))";
}
pub relation student_maintenance_treated_as_contribution(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount treated as paid for the use of the organization: at most $50 times the full calendar months (section 170(g)(1),(2)(A))";
}
@source(IRC_S170_G, quote = "only to the extent that such amounts do not exceed $50 multiplied by the number of full calendar months during the taxable year which fall within the period described in paragraph (1)")
rule StudentMaintenanceTreatedAsContribution(p: Person, y: TaxableYear, paid: Money, months: Integer) strict {
    label en official "the payments are contributions up to $50 per full calendar month, unless the taxpayer is compensated or reimbursed (section 170(g))";
    when student_maintenance_payment(p, y, paid);
    when full_calendar_months_of_student_in_household(p, y, months);
    when not_known(received_compensation_or_reimbursement_for_maintaining_student(p, y));
    then student_maintenance_treated_as_contribution(p, y, min(paid, 50.00 USD * months));
}
@source(IRC_S170_G, quote = "shall be treated as amounts paid for the use of the organization.")
rule StudentMaintenanceDeduction(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the deemed contribution is allowed before the section 170(b) limits";
    when student_maintenance_treated_as_contribution(p, y, amount);
    then deduction_allowed(p, y, Section170Charitable, amount);
}
@source(IRC_S170_G, quote = "No deduction shall be allowed under subsection (a) for any amount paid by a taxpayer to maintain an individual as a member of his household under a program described in paragraph (1)(A) except as provided in this subsection.")
rule StudentMaintenanceExcessNotDeductible(p: Person, y: TaxableYear, paid: Money, allowed: Money) strict {
    label en official "no deduction for the part of the payments above the limit (section 170(g)(4))";
    when student_maintenance_payment(p, y, paid);
    when student_maintenance_treated_as_contribution(p, y, allowed);
    when paid > allowed;
    then not deduction_allowed(p, y, Section170StudentMaintenanceExcess, paid - allowed);
}

// === (h): qualified conservation contribution ==================================================

pub enum ConservationInterestKind {
    EntireInterestOtherThanMineral;
    RemainderInterest;
    PerpetualUseRestriction;
    OtherInterest;
}
pub enum ConservationPurposeKind {
    OutdoorRecreationOrEducation;
    NaturalHabitat;
    OpenSpaceWithPublicBenefit;
    HistoricLandAreaOrCertifiedStructure;
    OtherPurpose;
}
pub relation contribution_of_real_property_interest(contribution: Integer, kind: ConservationInterestKind) kind empirical {
    label en official "the contribution is of an interest in real property of the stated kind (section 170(h)(2))";
}
pub relation contribution_donee_is_qualified_organization(contribution: Integer) kind empirical {
    label en official "the donee is a qualified organization: a governmental unit or publicly supported charity of section 170(b)(1)(A)(v),(vi), or a section 501(c)(3) organization meeting section 509(a)(2), or section 509(a)(3) and controlled by such an organization (section 170(h)(3)); status asserted";
}
pub relation contribution_conservation_purpose(contribution: Integer, purpose: ConservationPurposeKind) kind empirical {
    label en official "the conservation purpose of the contribution (section 170(h)(4)(A)); open space needs a significant public benefit, asserted with the purpose";
}
pub relation conservation_purpose_protected_in_perpetuity(contribution: Integer) kind empirical {
    label en official "the conservation purpose is protected in perpetuity (section 170(h)(5)(A))";
}
pub relation surface_mining_may_occur_with_retained_mineral_interest(contribution: Integer) kind empirical {
    label en official "there is a retention of a qualified mineral interest and at any time there may be extraction or removal of minerals by a surface mining method (section 170(h)(5)(B)(i))";
}
pub relation surface_mining_probability_negligible_with_separated_estates(contribution: Integer) kind empirical {
    label en official "the surface estate and the mineral interests have been and remain separated and the probability of surface mining is so remote as to be negligible (section 170(h)(5)(B)(ii))";
}
pub relation contribution_exclusively_for_conservation_purposes(contribution: Integer) kind institutional {
    label en official "the contribution is exclusively for conservation purposes: protected in perpetuity and not subject to surface mining (section 170(h)(5))";
}
@source(IRC_S170_H, quote = "A contribution shall not be treated as exclusively for conservation purposes unless the conservation purpose is protected in perpetuity.")
rule ExclusivelyForConservationPurposesRule(contribution: Integer) strict {
    label en official "protected in perpetuity and free of the surface mining exception (section 170(h)(5)(A),(B))";
    when conservation_purpose_protected_in_perpetuity(contribution);
    when not_known(surface_mining_may_occur_with_retained_mineral_interest(contribution));
    then contribution_exclusively_for_conservation_purposes(contribution);
}
@source(IRC_S170_H, quote = "subparagraph (A) shall be treated as met if the probability of surface mining occurring on such property is so remote as to be negligible.")
rule ExclusivelyForConservationPurposesNegligibleSurfaceMining(contribution: Integer) strict {
    label en official "with separated estates and a negligible probability of surface mining the perpetuity condition is treated as met (section 170(h)(5)(B)(ii))";
    when conservation_purpose_protected_in_perpetuity(contribution);
    when surface_mining_may_occur_with_retained_mineral_interest(contribution);
    when surface_mining_probability_negligible_with_separated_estates(contribution);
    then contribution_exclusively_for_conservation_purposes(contribution);
}
pub relation contribution_of_building_exterior_restriction_in_registered_district(contribution: Integer) kind empirical {
    label en official "the contribution is a restriction with respect to the exterior of a building located in a registered historic district and certified as of historic significance (section 170(h)(4)(B),(C)(ii))";
}
pub relation exterior_restriction_preserves_entire_exterior_and_bars_inconsistent_change(contribution: Integer) kind empirical {
    label en official "the restriction preserves the entire exterior (front, sides, rear and height) and prohibits changes inconsistent with the historical character (section 170(h)(4)(B)(i))";
}
pub relation donor_and_donee_written_agreement_under_penalty_of_perjury(contribution: Integer) kind empirical {
    label en official "the donor and donee enter into a written agreement certifying, under penalty of perjury, that the donee is a qualified organization with a conservation purpose and has the resources and commitment to enforce the restriction (section 170(h)(4)(B)(ii))";
}
pub relation return_includes_appraisal_photographs_and_restrictions(contribution: Integer) kind empirical {
    label en official "the taxpayer includes with the return a qualified appraisal, photographs of the entire exterior and a description of all restrictions on development (section 170(h)(4)(B)(iii))";
}
pub relation registered_district_building_special_rules_met(contribution: Integer) kind institutional {
    label en official "the special rules of section 170(h)(4)(B) for a building in a registered historic district are met";
}
@source(IRC_S170_H, quote = "such contribution shall not be considered to be exclusively for conservation purposes unless—")
rule RegisteredDistrictBuildingSpecialRules(contribution: Integer) strict {
    label en official "the entire-exterior restriction, the certified written agreement and the return attachments together satisfy the special rules (section 170(h)(4)(B))";
    when exterior_restriction_preserves_entire_exterior_and_bars_inconsistent_change(contribution);
    when donor_and_donee_written_agreement_under_penalty_of_perjury(contribution);
    when return_includes_appraisal_photographs_and_restrictions(contribution);
    then registered_district_building_special_rules_met(contribution);
}
pub relation qualified_conservation_contribution_170h(contribution: Integer) kind institutional {
    label en official "a qualified conservation contribution: of a qualified real property interest, to a qualified organization, exclusively for conservation purposes (section 170(h)(1))";
}
@source(IRC_S170_H, quote = "the term \"qualified conservation contribution\" means a contribution—")
rule QualifiedConservationContributionRule(contribution: Integer, kind: ConservationInterestKind, purpose: ConservationPurposeKind) strict {
    label en official "a contribution of an entire interest (other than mineral), a remainder interest or a perpetual restriction, to a qualified organization, exclusively for a conservation purpose, meeting the registered-district building rules where they apply (section 170(h)(1)-(5))";
    when contribution_of_real_property_interest(contribution, kind);
    when kind != OtherInterest;
    when contribution_donee_is_qualified_organization(contribution);
    when contribution_conservation_purpose(contribution, purpose);
    when purpose != OtherPurpose;
    when contribution_exclusively_for_conservation_purposes(contribution);
    when not_known(contribution_of_building_exterior_restriction_in_registered_district(contribution));
    then qualified_conservation_contribution_170h(contribution);
}
@source(IRC_S170_H, quote = "the term \"qualified conservation contribution\" means a contribution—")
rule QualifiedConservationContributionRegisteredDistrict(contribution: Integer, kind: ConservationInterestKind, purpose: ConservationPurposeKind) strict {
    label en official "the same for a building restriction in a registered historic district, which also needs the (h)(4)(B) special rules";
    when contribution_of_real_property_interest(contribution, kind);
    when kind != OtherInterest;
    when contribution_donee_is_qualified_organization(contribution);
    when contribution_conservation_purpose(contribution, purpose);
    when purpose != OtherPurpose;
    when contribution_exclusively_for_conservation_purposes(contribution);
    when contribution_of_building_exterior_restriction_in_registered_district(contribution);
    when registered_district_building_special_rules_met(contribution);
    then qualified_conservation_contribution_170h(contribution);
}

// --- (h)(7): contributions by pass-through entities --------------------------------------------

pub relation partnership_conservation_contribution_amount(contribution: Integer, amount: Money) kind institutional {
    label en official "the amount of the conservation contribution made by a partnership (directly or as a distributive share of another partnership's contribution) (section 170(h)(7)(A))";
}
pub relation sum_of_partners_relevant_basis(contribution: Integer, amount: Money) kind institutional {
    label en official "the sum of each partner's relevant basis: the part of the partner's modified basis allocable to the contributed real property (section 170(h)(7)(B)); an asserted total";
}
pub relation contribution_made_at_least_3_years_after_latest_acquisition(contribution: Integer) kind empirical {
    label en official "the contribution is made at least 3 years after the latest of the acquisitions of property, partnership interests and tiered interests listed in section 170(h)(7)(C)";
}
pub relation substantially_all_partnership_interests_held_by_individual_and_family(contribution: Integer) kind empirical {
    label en official "substantially all of the partnership interests are held, directly or indirectly, by an individual and members of the family (spouse and section 152(d)(2)(A)-(G) relatives) (section 170(h)(7)(D))";
}
pub relation conservation_purpose_is_certified_historic_structure(contribution: Integer) kind empirical {
    label en official "the conservation purpose is the preservation of a building that is a certified historic structure (section 170(h)(7)(E))";
}
pub relation pass_through_conservation_contribution_exceeds_limit(contribution: Integer) kind institutional {
    label en official "the pass-through contribution exceeds 2.5 times the sum of the partners' relevant basis and no exception applies, so it is not a qualified conservation contribution (section 170(h)(7))";
}
@source(IRC_S170_H, quote = "shall not be treated as a qualified conservation contribution for purposes of this section if the amount of such contribution exceeds 2.5 times the sum of each partner's relevant basis in such partnership.")
rule PassThroughConservationContributionExceedsLimit(contribution: Integer, amount: Money, basis: Money) strict {
    label en official "a contribution above 2.5 times the sum of relevant bases is disqualified unless made 3 years after the latest acquisition, by a family partnership, or to preserve a certified historic structure (section 170(h)(7)(A),(C),(D),(E))";
    when partnership_conservation_contribution_amount(contribution, amount);
    when sum_of_partners_relevant_basis(contribution, basis);
    when amount > basis * 2.5;
    when not_known(contribution_made_at_least_3_years_after_latest_acquisition(contribution));
    when not_known(substantially_all_partnership_interests_held_by_individual_and_family(contribution));
    when not_known(conservation_purpose_is_certified_historic_structure(contribution));
    then pass_through_conservation_contribution_exceeds_limit(contribution);
}

// === (i): the standard mileage rate ===========================================================================

pub relation miles_driven_in_service_of_charity(p: Person, y: TaxableYear, miles: Integer) kind empirical {
    label en official "miles driven with a passenger automobile in the use of the vehicle in service of a charitable organization (section 170(i))";
}
pub relation charitable_mileage_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for the use of a passenger automobile: the standard mileage rate of 14 cents per mile (section 170(i))";
}
@source(IRC_S170_I, quote = "the standard mileage rate shall be 14 cents per mile.")
rule CharitableStandardMileageRate(p: Person, y: TaxableYear, miles: Integer) strict {
    label en official "14 cents per mile";
    when miles_driven_in_service_of_charity(p, y, miles);
    then charitable_mileage_deduction(p, y, 0.14 USD * miles);
}

// === (j): travel expenses ==========================================================================================

pub relation charitable_travel_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "traveling expenses (including meals and lodging) while away from home, paid directly or by reimbursement, claimed under section 170 (section 170(j))";
}
external judgment relation charitable_travel_has_significant_personal_pleasure_element(p: Person, y: TaxableYear, item: Integer) {
    authority TaxCourt;
    label en official "there is a significant element of personal pleasure, recreation or vacation in the travel (section 170(j))";
}
@source(IRC_S170_J, quote = "unless there is no significant element of personal pleasure, recreation, or vacation in such travel.")
rule CharitableTravelExpenseDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no section 170 deduction for travel with a significant element of personal pleasure; a missing judgment leaves the question open (DECISION-0194)";
    when charitable_travel_expense(p, y, item, amount);
    when charitable_travel_has_significant_personal_pleasure_element(p, y, item);
    then not deduction_allowed(p, y, Section170TravelExpenses, amount);
}

// === (l): athletic seating rights =====================================================================================

pub relation payment_to_higher_education_institution_with_ticket_purchase_right(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid to or for the benefit of an institution of higher education (section 3304(f)) described in section 170(b)(1)(A)(ii) as a result of which the taxpayer receives the right to purchase tickets for seating at an athletic event in an athletic stadium of the institution (section 170(l)(2)); a portion paid for the tickets themselves is a separate amount";
}
@source(IRC_S170_L, quote = "No deduction shall be allowed under this section for any amount described in paragraph (2).")
rule AthleticSeatingRightPaymentDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for a payment that buys the right to purchase athletic tickets (section 170(l)(1)); the pinned text has no 80-percent rule, the pre-2018 text is not pinned (G2101)";
    when payment_to_higher_education_institution_with_ticket_purchase_right(p, y, item, amount);
    then not deduction_allowed(p, y, Section170AthleticSeating, amount);
}

// === (n): whaling captains =====================================================================================================

pub relation recognized_whaling_captain_engaged_in_sanctioned_whaling(p: Person, y: TaxableYear) kind institutional {
    label en official "the individual is recognized by the Alaska Eskimo Whaling Commission as a whaling captain charged with maintaining and carrying out sanctioned whaling activities and engages in them during the year (section 170(n)(1),(3))";
}
pub relation reasonable_and_necessary_whaling_expenses_paid(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate of the reasonable and necessary whaling expenses paid during the year in carrying out sanctioned whaling activities: boats, weapons, gear, food and provisions, storage and distribution of the catch (section 170(n)(2)); an asserted total";
}
pub relation whaling_expenses_treated_as_charitable_contribution(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the whaling expenses treated as a charitable contribution, up to $10,000 for the year (section 170(n)(1))";
}
@source(IRC_S170_N, quote = "to the extent such amount does not exceed $10,000 for the taxable year")
rule WhalingExpensesTreatedAsContribution(p: Person, y: TaxableYear, expenses: Money) strict {
    label en official "up to $10,000 of the whaling expenses of a recognized whaling captain is a charitable contribution";
    when recognized_whaling_captain_engaged_in_sanctioned_whaling(p, y);
    when reasonable_and_necessary_whaling_expenses_paid(p, y, expenses);
    then whaling_expenses_treated_as_charitable_contribution(p, y, min(expenses, 10000.00 USD));
}
@source(IRC_S170_N, quote = "shall be treated for purposes of this section as a charitable contribution.")
rule WhalingExpensesDeduction(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the deemed contribution is allowed before the section 170(b) limits; substantiation guidance is the Secretary's (subsection (n)(4))";
    when whaling_expenses_treated_as_charitable_contribution(p, y, amount);
    then deduction_allowed(p, y, Section170Charitable, amount);
}

// === (o): fractional gifts ============================================================================================================

pub relation fractional_contribution_of_undivided_portion_of_tangible_personal_property(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a contribution of an undivided portion of the taxpayer's entire interest in tangible personal property (section 170(o)(1))";
}
pub relation all_interests_held_immediately_before_by_taxpayer_and_donee(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "immediately before the contribution all interests in the property are held by the taxpayer, or by the taxpayer and the donee (section 170(o)(1)(A))";
}
@source(IRC_S170_O, quote = "No deduction shall be allowed for a contribution of an undivided portion of a taxpayer's entire interest in tangible personal property unless all interests in the property are held immediately before such contribution by—")
rule FractionalGiftDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for a fractional gift unless all interests are held by the taxpayer and the donee; the regulatory exceptions for proportional contributions are not modelled (section 170(o)(1))";
    when fractional_contribution_of_undivided_portion_of_tangible_personal_property(p, y, item, amount);
    when not_known(all_interests_held_immediately_before_by_taxpayer_and_donee(p, y, item));
    then not deduction_allowed(p, y, Section170FractionalGift, amount);
}
pub relation fair_market_value_at_initial_fractional_contribution(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "the fair market value of the property at the time of the initial fractional contribution (asserted, DECISION-0194)";
}
pub relation fair_market_value_at_additional_contribution(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "the fair market value of the property at the time of the additional contribution (asserted, DECISION-0194)";
}
pub relation additional_contribution_value(p: Person, item: Integer, amount: Money) kind institutional {
    label en official "the value of an additional contribution: the lesser of the fair market values at the initial and at the additional contribution (section 170(o)(2))";
}
@source(IRC_S170_O, quote = "In the case of any additional contribution, the fair market value of such contribution shall be determined by using the lesser of—")
rule AdditionalFractionalContributionValue(p: Person, item: Integer, initial: Money, later: Money) strict {
    label en official "the lesser of the two values (section 170(o)(2))";
    when fair_market_value_at_initial_fractional_contribution(p, item, initial);
    when fair_market_value_at_additional_contribution(p, item, later);
    then additional_contribution_value(p, item, min(initial, later));
}
pub relation donor_did_not_contribute_all_remaining_interests_by_deadline(p: Person, item: Integer) kind empirical {
    label en official "the donor does not contribute all remaining interests to the donee on or before the earlier of 10 years after the initial fractional contribution and the donor's death (section 170(o)(3)(A)(i))";
}
pub relation donee_lacked_substantial_physical_possession_or_related_use(p: Person, item: Integer) kind empirical {
    label en official "during the period the donee did not have substantial physical possession or did not use the property in a use related to its exempt purpose (section 170(o)(3)(A)(ii))";
}
pub relation deduction_allowed_for_fractional_contribution(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "the deduction previously allowed for the contribution of an undivided portion (asserted amount)";
}
pub relation fractional_gift_recapture_amount(p: Person, item: Integer, amount: Money) kind institutional {
    label en official "the deduction is recaptured (plus interest, computed elsewhere) where the donor does not complete the gift or the donee lacks possession or related use (section 170(o)(3)(A))";
}
@source(IRC_S170_O, quote = "The Secretary shall provide for the recapture of the amount of any deduction allowed under this section (plus interest)")
rule FractionalGiftRecaptureByDonor(p: Person, item: Integer, allowed: Money) strict {
    label en official "recapture of the allowed deduction where the remaining interests are not contributed by the deadline";
    when deduction_allowed_for_fractional_contribution(p, item, allowed);
    when donor_did_not_contribute_all_remaining_interests_by_deadline(p, item);
    then fractional_gift_recapture_amount(p, item, allowed);
}
@source(IRC_S170_O, quote = "The Secretary shall provide for the recapture of the amount of any deduction allowed under this section (plus interest)")
rule FractionalGiftRecaptureByDonee(p: Person, item: Integer, allowed: Money) strict {
    label en official "recapture of the allowed deduction where the donee lacked substantial possession or related use";
    when deduction_allowed_for_fractional_contribution(p, item, allowed);
    when donee_lacked_substantial_physical_possession_or_related_use(p, item);
    then fractional_gift_recapture_amount(p, item, allowed);
}
pub relation fractional_gift_addition_to_tax(p: Person, item: Integer, amount: Money) kind institutional {
    label en official "the tax for the recapture year is increased by 10 percent of the amount recaptured (section 170(o)(3)(B))";
}
@source(IRC_S170_O, quote = "shall be increased by 10 percent of the amount so recaptured.")
rule FractionalGiftAdditionToTax(p: Person, item: Integer, recaptured: Money) strict {
    label en official "10 percent of the recaptured amount";
    when fractional_gift_recapture_amount(p, item, recaptured);
    then fractional_gift_addition_to_tax(p, item, round(recaptured * 0.10, 2, "HALF_UP"));
}
