// Sections 174 and 174A — the rules that complete `174-research-expenditures.law`
// (stage 2b): (c) special rules of both sections (land and depreciable property,
// exploration, software as research), the mid-point first-year amount of the
// pre-2025 amortization, the post-2024 foreign research amortization (Pub. L.
// 119-21 section 70302(b)(1)), (d) disposition rule, 174A(c) the election to
// amortize over at least 60 months, and the transition elections of section
// 70302(f). The three earlier rules read `research_expenditure_174`, defined here,
// instead of the raw case fact, so the (c) exclusions gate them.
// Not modelled: the year-by-year amortization ledger (self-recursive over years,
// TECH_GAPS G2719), the section 481 cut-off mechanics of 70302(c) and the
// retroactive small-business election's effect on the edition boundary (G2720).

use self::{
    DeductionKind,
    IRC_S174_A,
    IRC_S174_B,
    IRC_S174_C,
    IRC_S174_D,
    Person,
    TaxableYear,
    deduction_allowed,
    domestic_research_expenditure_deduction,
    research_expenditure_attributable_to_foreign_research,
    research_or_experimental_expenditure_paid_or_incurred,
    section_174_amortization_year1,
    taxable_year_pre_2025_edition,
};

pub relation expenditure_for_land_or_depreciable_or_depletable_property(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is for the acquisition or improvement of land, or of property to be used in connection with the research and of a character subject to the allowance under section 167 or 611 (sections 174(c)(1), 174A(d)(1)); the allowances under sections 167 and 611 are themselves treated as expenditures";
}
pub relation expenditure_for_ascertaining_mineral_deposit(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is paid or incurred to ascertain the existence, location, extent or quality of a deposit of ore or other mineral, including oil and gas (sections 174(c)(2), 174A(d)(2))";
}
pub relation software_development_expenditure(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid or incurred in connection with the development of software, treated as a research or experimental expenditure (sections 174(c)(3), 174A(d)(3))";
}
pub relation section_174_excluded_expenditure(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "sections 174 and 174A do not apply to the expenditure by reason of subsection (c)(1)-(2) of section 174 or (d)(1)-(2) of section 174A";
}
@source(IRC_S174_C, quote = "This section shall not apply to any expenditure for the acquisition or improvement of land")
rule Section174ExcludedLandAndDepreciableProperty(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "expenditures for land or depreciable or depletable property are outside sections 174 and 174A (sections 174(c)(1), 174A(d)(1))";
    when expenditure_for_land_or_depreciable_or_depletable_property(p, y, item);
    then section_174_excluded_expenditure(p, y, item);
}
@source(IRC_S174_C, quote = "This section shall not apply to any expenditure paid or incurred for the purpose of ascertaining the existence, location, extent, or quality of any deposit of ore or other mineral (including oil and gas).")
rule Section174ExcludedExploration(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "exploration expenditures are outside sections 174 and 174A (sections 174(c)(2), 174A(d)(2))";
    when expenditure_for_ascertaining_mineral_deposit(p, y, item);
    then section_174_excluded_expenditure(p, y, item);
}
pub relation research_expenditure_174(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "a research or experimental expenditure within section 174 or 174A: the asserted expenditure, or software development treated as such, other than the excluded expenditures of subsection (c)(1)-(2)";
}
@source(IRC_S174_B, quote = "research or experimental expenditures which are paid or incurred by the taxpayer during such taxable year in connection with the taxpayer's trade or business")
rule ResearchExpenditureFromFact(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "an expenditure asserted as research or experimental is one, unless excluded by subsection (c)";
    when research_or_experimental_expenditure_paid_or_incurred(p, y, item, amount);
    when not_known(section_174_excluded_expenditure(p, y, item));
    then research_expenditure_174(p, y, item, amount);
}
@source(IRC_S174_C, quote = "any amount paid or incurred in connection with the development of any software shall be treated as a research or experimental expenditure")
rule ResearchExpenditureFromSoftware(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "software development amounts are research or experimental expenditures (sections 174(c)(3), 174A(d)(3))";
    when software_development_expenditure(p, y, item, amount);
    when not_known(section_174_excluded_expenditure(p, y, item));
    then research_expenditure_174(p, y, item, amount);
}

// --- (a)(2)(B): the first-year amount from the midpoint of the taxable year ---------------

pub relation section_174_first_year_amortization(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the first-year amortization deduction: the ratable amount for a half year, since the period begins with the midpoint of the taxable year in which the expenditures are paid or incurred (section 174(a)(2)(B)); 1/10 of the domestic amount over 5 years, 1/30 of the foreign amount over 15 years";
}
@source(IRC_S174_A, quote = "beginning with the midpoint of the taxable year in which such expenditures are paid or incurred.")
rule Section174FirstYearDomestic(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "domestic specified research expenditures paid in a taxable year beginning before 2025: half of the annual 1/5 amount falls in the first year (section 174(a)(2)(B))";
    when taxable_year_pre_2025_edition(y);
    when research_expenditure_174(p, y, item, amount);
    when not_known(research_expenditure_attributable_to_foreign_research(p, y, item));
    then section_174_first_year_amortization(p, y, item, div_round(amount, 10.0, 2, "HALF_UP"));
}
@source(IRC_S174_A, quote = "beginning with the midpoint of the taxable year in which such expenditures are paid or incurred.")
rule Section174FirstYearForeign(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "foreign research expenditures: half of the annual 1/15 amount falls in the first year (section 174(a)(2)(B))";
    when research_expenditure_174(p, y, item, amount);
    when research_expenditure_attributable_to_foreign_research(p, y, item);
    then section_174_first_year_amortization(p, y, item, div_round(amount, 30.0, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "over the 15-year period")
rule Section174ForeignAmortizationAfter2024(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "for taxable years beginning after 2024 section 174(a), as amended, covers only foreign research or experimental expenditures, amortized ratably over 15 years (Pub. L. 119-21 section 70302(b)(1)); the annual amount, before the midpoint half-year";
    when research_expenditure_174(p, y, item, amount);
    when research_expenditure_attributable_to_foreign_research(p, y, item);
    when not_known(taxable_year_pre_2025_edition(y));
    then section_174_amortization_year1(p, y, item, div_round(amount, 15.0, 2, "HALF_UP"));
}

// --- (a)(1),(2)(A): no current deduction, charged to capital account ------------------------------------

pub relation research_expenditure_charged_to_capital_account_174(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the specified (after 2024, foreign) research or experimental expenditure is charged to capital account (section 174(a)(2)(A))";
}
@source(IRC_S174_A, quote = "charge such expenditures to capital account, and")
rule Section174ExpendituresChargedToCapitalRule(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "before 2025 all specified research expenditures, and after 2024 the foreign ones, are charged to capital account (section 174(a)(2)(A); Pub. L. 119-21 section 70302(b)(1))";
    when research_expenditure_174(p, y, item, amount);
    when taxable_year_pre_2025_edition(y);
    then research_expenditure_charged_to_capital_account_174(p, y, item, amount);
}
@source(IRC_S174_A, quote = "charge such expenditures to capital account, and")
rule Section174ForeignExpendituresChargedToCapitalAfter2024(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "after 2024 the foreign research expenditures remain charged to capital account (section 174(a)(2)(A), as amended)";
    when research_expenditure_174(p, y, item, amount);
    when research_expenditure_attributable_to_foreign_research(p, y, item);
    when not_known(taxable_year_pre_2025_edition(y));
    then research_expenditure_charged_to_capital_account_174(p, y, item, amount);
}
@source(IRC_S174_A, quote = "no deduction shall be allowed for such expenditures, and")
rule Section174NoCurrentDeductionPre2025(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no current deduction for the expenditures charged to capital account: the amortization is the only deduction (section 174(a)(1))";
    when research_expenditure_charged_to_capital_account_174(p, y, item, amount);
    then not deduction_allowed(p, y, Section174CurrentDeduction, amount);
}

// --- (d): disposition, retirement or abandonment ------------------------------------------------

pub relation property_with_174_expenditures_disposed_retired_or_abandoned(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "property with respect to which specified (after 2024, foreign) research expenditures were paid is disposed, retired or abandoned during the amortization period (section 174(d))";
}
pub relation section_174_amortization_continues_after_disposition(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "no deduction (and, for dispositions after May 12, 2025, no reduction to amount realized) is allowed on account of the disposition, and the amortization deduction continues (section 174(d))";
}
@source(IRC_S174_D, quote = "no deduction shall be allowed with respect to such expenditures on account of such disposition, retirement, or abandonment and such amortization deduction shall continue with respect to such expenditures")
rule Section174DispositionAmortizationContinues(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a disposition, retirement or abandonment neither accelerates a deduction nor ends the amortization (section 174(d))";
    when property_with_174_expenditures_disposed_retired_or_abandoned(p, y, item);
    then section_174_amortization_continues_after_disposition(p, y, item);
}

// --- 174A(c): the election to amortize over at least 60 months ---------------------------------

pub relation elects_174a_amortization(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer elects, not later than the return due date with extensions, to charge the domestic research expenditure to capital account and amortize it over a selected period of at least 60 months (section 174A(c))";
}
pub relation section_174a_amortization_election_in_effect(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the section 174A(c) election is in effect for the expenditure; the method and period bind all subsequent years unless the Secretary approves a change (section 174A(c)(2))";
}
pub relation selected_amortization_period_months_174a(p: Person, item: Integer, months: Integer) kind empirical {
    label en official "the period, of not less than 60 months, selected by the taxpayer, beginning with the month the taxpayer first realizes benefits from the expenditures (section 174A(c)(1)(B))";
}
pub relation months_of_selected_period_in_taxable_year(p: Person, y: TaxableYear, item: Integer, months: Integer) kind empirical {
    label en official "the months of the selected period that fall within the taxable year (month-count term gap, TECH_GAPS G2703)";
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "At the election of the taxpayer, made in accordance with regulations or other guidance provided by the Secretary")
rule Section174AAmortizationElectionPower(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a taxpayer has the power to elect amortization of domestic research expenditures chargeable to capital account instead of section 174A(a) expensing (section 174A(c)(1))";
    when elects_174a_amortization(p, y, item);
    then power Section174AAmortizationElection {
        holder p;
        over item;
        exercise elects_174a_amortization(p, y, item);
        valid_when elects_174a_amortization(p, y, item);
        effect create(section_174a_amortization_election_in_effect(p, y, item));
        window [@2025-07-04, infinity);
    };
}
pub relation section_174a_elected_amortization_deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the amortization deduction of an elected expenditure for the taxable year";
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "be allowed an amortization deduction of such expenditures ratably over such period of not less than 60 months as may be selected by the taxpayer")
rule Section174AElectedAmortizationDeduction(p: Person, y: TaxableYear, item: Integer, amount: Money, selected: Integer, months: Integer) defeasible {
    label en official "the elected amortization is the expenditure times the months of the year over the selected months, one rounding; a period under 60 months is not an election period (section 174A(c)(1)(B))";
    when section_174a_amortization_election_in_effect(p, y, item);
    when research_expenditure_174(p, y, item, amount);
    when selected_amortization_period_months_174a(p, item, selected);
    when selected >= 60;
    when months_of_selected_period_in_taxable_year(p, y, item, months);
    then section_174a_elected_amortization_deduction(p, y, item, div_round(amount * months, selected * 1.0, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "there shall be allowed as a deduction any domestic research or experimental expenditures which are paid or incurred by the taxpayer during the taxable year")
rule Section174ADeductionAllowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the section 174A(a) deduction is an allowed deduction";
    when domestic_research_expenditure_deduction(p, y, item, amount);
    then deduction_allowed(p, y, Section174ADomesticResearch, amount);
}
@source(IRC_S174_A, quote = "be allowed an amortization deduction of such expenditures ratably over the 5-year period")
rule Section174FirstYearAmortizationAllowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the section 174(a) first-year amortization is an allowed deduction";
    when section_174_first_year_amortization(p, y, item, amount);
    then deduction_allowed(p, y, Section174Amortization, amount);
}

// --- Pub. L. 119-21 section 70302(f): transition elections --------------------------------------------

pub relation is_first_taxable_year_beginning_after_2024(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is the first taxable year beginning after December 31, 2024";
}
pub relation unamortized_capitalized_domestic_research_amount(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "the remaining unamortized amount of domestic research or experimental expenditures paid or incurred in taxable years beginning after December 31, 2021 and before January 1, 2025 and charged to capital account (section 70302(f)(2)(A))";
}
pub relation elects_lump_sum_unamortized_deduction(p: Person, item: Integer) kind empirical {
    label en official "the taxpayer elects to deduct the remaining unamortized amount in the first taxable year beginning after December 31, 2024 (section 70302(f)(2)(A)(i))";
}
pub relation elects_two_year_unamortized_deduction(p: Person, item: Integer) kind empirical {
    label en official "the taxpayer elects to deduct the remaining unamortized amount ratably over the 2-taxable-year period beginning with the first taxable year beginning after December 31, 2024 (section 70302(f)(2)(A)(ii))";
}
pub relation lump_sum_unamortized_election_in_effect(p: Person, item: Integer) kind institutional {
    label en official "the lump-sum election of section 70302(f)(2)(A)(i) is in effect";
}
pub relation two_year_unamortized_election_in_effect(p: Person, item: Integer) kind institutional {
    label en official "the two-year election of section 70302(f)(2)(A)(ii) is in effect";
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "to deduct any remaining unamortized amount with respect to such expenditures in the first taxable year beginning after December 31, 2024")
rule LumpSumUnamortizedElectionPower(p: Person, item: Integer) strict {
    label en official "a taxpayer has the power to elect to deduct the remaining unamortized amount in the first year after 2024 (section 70302(f)(2)(A)(i)); the change is a cut-off method change without section 481(a) adjustment";
    when elects_lump_sum_unamortized_deduction(p, item);
    then power LumpSumUnamortizedResearchElection {
        holder p;
        over item;
        exercise elects_lump_sum_unamortized_deduction(p, item);
        valid_when elects_lump_sum_unamortized_deduction(p, item);
        effect create(lump_sum_unamortized_election_in_effect(p, item));
        window [@2025-07-04, infinity);
    };
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "to deduct such remaining unamortized amount with respect to such expenditures ratably over the 2-taxable year period")
rule TwoYearUnamortizedElectionPower(p: Person, item: Integer) strict {
    label en official "a taxpayer has the power to elect to deduct the remaining unamortized amount ratably over 2 taxable years (section 70302(f)(2)(A)(ii))";
    when elects_two_year_unamortized_deduction(p, item);
    then power TwoYearUnamortizedResearchElection {
        holder p;
        over item;
        exercise elects_two_year_unamortized_deduction(p, item);
        valid_when elects_two_year_unamortized_deduction(p, item);
        effect create(two_year_unamortized_election_in_effect(p, item));
        window [@2025-07-04, infinity);
    };
}
pub relation transition_unamortized_research_deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the deduction of the remaining unamortized pre-2025 domestic research amount for the taxable year under the section 70302(f)(2) election";
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "to deduct any remaining unamortized amount with respect to such expenditures in the first taxable year beginning after December 31, 2024")
rule LumpSumUnamortizedDeduction(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "under the lump-sum election the whole remaining unamortized amount is deducted in the first taxable year beginning after 2024";
    when lump_sum_unamortized_election_in_effect(p, item);
    when is_first_taxable_year_beginning_after_2024(p, y);
    when unamortized_capitalized_domestic_research_amount(p, item, amount);
    then transition_unamortized_research_deduction(p, y, item, amount);
}
pub relation second_taxable_year_beginning_after_2024(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year is the second taxable year beginning after December 31, 2024";
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "to deduct such remaining unamortized amount with respect to such expenditures ratably over the 2-taxable year period")
rule TwoYearUnamortizedDeductionFirstYear(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "under the two-year election half of the remaining unamortized amount is deducted in the first taxable year beginning after 2024";
    when two_year_unamortized_election_in_effect(p, item);
    when is_first_taxable_year_beginning_after_2024(p, y);
    when unamortized_capitalized_domestic_research_amount(p, item, amount);
    then transition_unamortized_research_deduction(p, y, item, div_round(amount, 2.0, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "to deduct such remaining unamortized amount with respect to such expenditures ratably over the 2-taxable year period")
rule TwoYearUnamortizedDeductionSecondYear(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "the other half is deducted in the second taxable year (the remainder after the first half, so the two years sum to the whole)";
    when two_year_unamortized_election_in_effect(p, item);
    when second_taxable_year_beginning_after_2024(p, y);
    when unamortized_capitalized_domestic_research_amount(p, item, amount);
    then transition_unamortized_research_deduction(p, y, item, amount - div_round(amount, 2.0, 2, "HALF_UP"));
}
