// Sections 266 (carrying charges) and 268 (sale of land with unharvested crop).
// Stage 2. Section 241 and 261 are structural introductions of parts VIII and IX
// (no rule of their own); section 262-265 are in `262-265-personal-and-capital.law`.

use self::{
    DeductionKind,
    IRC_S266,
    IRC_S268,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation tax_or_carrying_charge_chargeable_to_capital_under_regulations(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "taxes and carrying charges which, under regulations prescribed by the Secretary, are chargeable to capital account with respect to property (section 266)";
}
pub relation elects_to_capitalize_taxes_and_carrying_charges(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer elects, in accordance with the regulations, to treat the taxes or charges as chargeable to capital account (section 266)";
}
pub relation carrying_charge_capitalization_election_in_effect(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the section 266 election is in effect for the item";
}
@source(IRC_S266, quote = "if the taxpayer elects, in accordance with such regulations, to treat such taxes or charges as so chargeable")
rule CarryingChargeElectionPower(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a taxpayer has the power to elect to capitalize taxes and carrying charges of property (section 266)";
    when elects_to_capitalize_taxes_and_carrying_charges(p, y, item);
    then power CarryingChargeCapitalizationElection {
        holder p;
        over item;
        exercise elects_to_capitalize_taxes_and_carrying_charges(p, y, item);
        valid_when elects_to_capitalize_taxes_and_carrying_charges(p, y, item);
        effect create(carrying_charge_capitalization_election_in_effect(p, y, item));
        window [@1954-01-01, infinity);
    };
}
pub relation carrying_charge_deduction_denied_266(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "no deduction is allowed for the taxes and carrying charges the taxpayer elected to capitalize";
}
@source(IRC_S266, quote = "No deduction shall be allowed for amounts paid or accrued for such taxes and carrying charges as, under regulations prescribed by the Secretary, are chargeable to capital account with respect to property")
rule CarryingChargeDeductionDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "after the election the taxes and carrying charges are capitalized, not deducted (section 266)";
    when carrying_charge_capitalization_election_in_effect(p, y, item);
    when tax_or_carrying_charge_chargeable_to_capital_under_regulations(p, y, item, amount);
    then carrying_charge_deduction_denied_266(p, y, item, amount);
}
@source(IRC_S266, quote = "No deduction shall be allowed for amounts paid or accrued for such taxes and carrying charges")
rule CarryingChargeNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "the capitalized amount is not an allowed deduction";
    when carrying_charge_deduction_denied_266(p, y, item, amount);
    then not deduction_allowed(p, y, Section266CarryingCharges, amount);
}

pub relation unharvested_crop_sold_with_land_as_section_1231_property(p: Person, y: TaxableYear, crop: Integer) kind empirical {
    label en official "an unharvested crop sold by the taxpayer is considered under section 1231 as property used in the trade or business (section 268)";
}
pub relation deduction_attributable_to_production_of_crop(p: Person, y: TaxableYear, crop: Integer, amount: Money) kind empirical {
    label en official "a deduction, for the year of the sale or another, for expenses, depreciation or otherwise, attributable to the production of the crop (section 268)";
}
@source(IRC_S268, quote = "no deduction (whether or not for the taxable year of the sale and whether for expenses, depreciation, or otherwise) attributable to the production of such crop shall be allowed")
rule UnharvestedCropProductionDeductionDenied(p: Person, y: TaxableYear, crop: Integer, amount: Money) strict {
    label en official "no deduction attributable to the production of an unharvested crop sold as section 1231 property (section 268)";
    when unharvested_crop_sold_with_land_as_section_1231_property(p, y, crop);
    when deduction_attributable_to_production_of_crop(p, y, crop, amount);
    then not deduction_allowed(p, y, Section268CropProduction, amount);
}
