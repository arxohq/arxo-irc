// Section 195 — Start-up expenditures. Stage 1 (IRC-06), priority section.
// Scope: (a) capitalization default; (b)(1) the election to deduct up to
// $5,000 (phased out above $50,000) plus 180-month ratable amortization.

use self::{
    DeductionKind,
    IRC_S195_A,
    IRC_S195_B,
    Person,
    TaxableYear,
    deduction_allowed,
    start_up_business_begins_in_2010,
    start_up_election_valid,
};

pub relation start_up_expenditure(p: Person, y: TaxableYear, activity: Integer, item: Integer, amount: Money) kind institutional {
    label en official "a start-up expenditure with respect to an active trade or business (section 195(c)(1))";
}
pub relation start_up_expenditures_aggregate(p: Person, activity: Integer, amount: Money) kind institutional {
    label en official "the aggregate start-up expenditures with respect to the active trade or business (section 195(b)(1))";
}
pub relation elects_to_deduct_start_up_expenditures(p: Person, activity: Integer) kind empirical {
    label en official "elects the application of section 195(b) with respect to the start-up expenditures";
}
pub relation active_trade_or_business_begins_in_year(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the active trade or business begins (section 195(b)(1)(A))";
}
pub relation start_up_deduction_election_in_effect(p: Person, activity: Integer) kind institutional {
    label en official "the section 195(b) election is in effect for the active trade or business";
}

@source(IRC_S195_A, quote = "Except as otherwise provided in this section, no deduction shall be allowed for start-up expenditures")
rule StartUpExpendituresNotDeductibleAbsentElection(p: Person, y: TaxableYear, activity: Integer, item: Integer, amount: Money) defeasible {
    label en official "start-up expenditures are not deductible except as section 195 provides (section 195(a))";
    when start_up_expenditure(p, y, activity, item, amount);
    when not_known(start_up_deduction_election_in_effect(p, activity));
    then not deduction_allowed(p, y, Section195StartUp, amount);
}

@source(IRC_S195_B, quote = "If a taxpayer elects the application of this subsection with respect to any start-up expenditures")
rule StartUpElectionPowerRule(p: Person, activity: Integer) strict {
    label en official "a taxpayer has the power to elect to deduct start-up expenditures under section 195(b)";
    when elects_to_deduct_start_up_expenditures(p, activity);
    then power StartUpExpenditureDeductionElection {
        holder p;
        over activity;
        exercise elects_to_deduct_start_up_expenditures(p, activity);
        valid_when start_up_election_valid(p, activity);
        effect create(start_up_deduction_election_in_effect(p, activity));
        window [@2004-10-23, infinity);
    };
}

@source(IRC_S195_B, quote = "$5,000, reduced (but not below zero) by the amount by which such start-up expenditures exceed $50,000")
rule StartUpImmediateDeductionCappedAtFiveThousandLessPhaseout(p: Person, y: TaxableYear, activity: Integer, aggregate: Money) defeasible {
    label en official "the year-one start-up deduction is the lesser of aggregate start-up expenditures or $5,000 reduced (not below zero) by the excess of expenditures over $50,000 (section 195(b)(1)(A))";
    when start_up_deduction_election_in_effect(p, activity);
    when active_trade_or_business_begins_in_year(p, activity, y);
    when not_known(start_up_business_begins_in_2010(p, activity));
    when start_up_expenditures_aggregate(p, activity, aggregate);
    when aggregate >= min(aggregate, max(0.00 USD, 5000.00 USD - max(0.00 USD, aggregate - 50000.00 USD)));
    then deduction_allowed(p, y, Section195StartUp, min(aggregate, max(0.00 USD, 5000.00 USD - max(0.00 USD, aggregate - 50000.00 USD))));
}
pub relation start_up_amortization_month_fraction_for_year(p: Person, activity: Integer, y: TaxableYear, fraction: Decimal) kind institutional {
    label en official "the fraction of the 180-month amortization period (months falling in this taxable year, divided by 180) attributable to the taxable year — a scenario supplies this fraction directly (deriving month-counts from `active_trade_or_business_begins_in_year` plus calendar arithmetic, and dividing Money by an Integer month count, is a TECH_GAP: Money/Integer is outside the divisible-types table, LDC-E2108/errata E-0020)";
}
@source(IRC_S195_B, quote = "the remainder of such start-up expenditures shall be allowed as a deduction ratably over the 180-month period beginning with the month in which the active trade or business begins")
rule StartUpRemainderAmortizedOver180Months(p: Person, y: TaxableYear, activity: Integer, aggregate: Money, fraction: Decimal) defeasible {
    label en official "the remainder of start-up expenditures (after the year-one deduction) is amortized ratably over the 180-month period beginning with the month the active trade or business begins (section 195(b)(1)(B))";
    when start_up_deduction_election_in_effect(p, activity);
    when not_known(start_up_business_begins_in_2010(p, activity));
    when start_up_expenditures_aggregate(p, activity, aggregate);
    when aggregate > min(aggregate, max(0.00 USD, 5000.00 USD - max(0.00 USD, aggregate - 50000.00 USD)));
    when start_up_amortization_month_fraction_for_year(p, activity, y, fraction);
    then deduction_allowed(p, y, Section195StartUp,
        round((aggregate - min(aggregate, max(0.00 USD, 5000.00 USD - max(0.00 USD, aggregate - 50000.00 USD)))) * fraction, 2, "HALF_UP"));
}
// (b)(2) disposition-before-amortization-ends coordination with section
// 165, (b)(3) 2010 special dollar amounts, (c)(2) beginning-of-business
// timing stay "stage 2".
