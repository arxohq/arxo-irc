// Sections 169 (pollution control facility amortization), 179B (small business
// refiner sulfur compliance costs), 179C (qualified refinery property) and 179E
// (advanced mine safety equipment). Stage 2. All four are elections that produce a
// deduction; sections 179C (placed in service before 2014) and 179E (before 2018)
// are time-limited, 169 covers facilities of plants in operation before 1976 (or
// coal-fired plants after April 11, 2005). Certifications of the State and Federal
// authorities, the qualified costs of section 45H(c)(2) and the qualified fuels of
// section 45K(c) are external (EXTERNAL_DEPENDENCY); this module states the
// election, the amount and the limits.
// Rounding: the statute names none (cents HALF_UP, JUDGMENT CALL); ratios use
// `div_round` with one rounding.

// === §169 =========================================================================================

use self::{
    DeductionKind,
    IRC_S169_A,
    IRC_S169_B,
    IRC_S169_C,
    IRC_S169_D,
    IRC_S169_F,
    IRC_S179B_A,
    IRC_S179B_B,
    IRC_S179C_A,
    IRC_S179E_A,
    IRC_S179E_G,
    Person,
    TaxableYear,
    deduction_allowed,
    new_identifiable_test_failed,
    section_179c_election_revoked,
    section_179e_election_revoked,
};

pub relation state_certifying_authority_certified_facility(p: Person, facility: Integer) kind empirical {
    label en official "the State certifying authority certified to the Federal certifying authority that the facility was constructed, reconstructed, erected or acquired in conformity with the State program (section 169(d)(1)(A))";
}
pub relation federal_certifying_authority_certified_facility(p: Person, facility: Integer) kind empirical {
    label en official "the Federal certifying authority certified to the Secretary that the facility complies with Federal regulations and furthers the policy for cooperation with the States on pollution abatement (section 169(d)(1)(B))";
}
pub relation facility_significantly_increases_output_or_alters_process(p: Person, facility: Integer) kind empirical {
    label en official "the facility significantly increases the output or capacity, extends the useful life or reduces total operating costs of the plant, or alters the nature of the manufacturing or production process (section 169(d)(1)(C))";
}
pub relation facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005(p: Person, facility: Integer) kind institutional {
    label en official "the new identifiable treatment facility is used in connection with a plant or other property in operation before January 1, 1976, or is an atmospheric pollution control facility placed in service after April 11, 2005 for a primarily coal-fired electric generation plant (section 169(d)(1),(5))";
}
pub relation certified_pollution_control_facility(p: Person, facility: Integer) kind institutional {
    label en official "the facility is a certified pollution control facility (section 169(d)(1))";
}
@source(IRC_S169_D, quote = "The term \"certified pollution control facility\" means a new identifiable treatment facility")
rule CertifiedPollutionControlFacilityRule(p: Person, facility: Integer) strict {
    label en official "a new identifiable treatment facility certified by the State and Federal authorities and not increasing output or altering the process is a certified pollution control facility (section 169(d)(1))";
    when facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005(p, facility);
    when state_certifying_authority_certified_facility(p, facility);
    when federal_certifying_authority_certified_facility(p, facility);
    when not_known(facility_significantly_increases_output_or_alters_process(p, facility));
    when not_known(new_identifiable_test_failed(p, facility));
    then certified_pollution_control_facility(p, facility);
}
pub relation elects_pollution_control_amortization(p: Person, facility: Integer) kind empirical {
    label en official "the taxpayer files the statement of election of section 169(b) to amortize the amortizable basis over 60 months";
}
pub relation pollution_control_amortization_election_in_effect(p: Person, facility: Integer) kind institutional {
    label en official "the section 169 election is in effect for the facility";
}
@source(IRC_S169_B, quote = "The election of the taxpayer to take the amortization deduction")
rule PollutionControlElectionPower(p: Person, facility: Integer) strict {
    label en official "a taxpayer has the power to elect the 60-month amortization of a certified pollution control facility (section 169(a),(b))";
    when elects_pollution_control_amortization(p, facility);
    then power PollutionControlAmortizationElection {
        holder p;
        over facility;
        exercise elects_pollution_control_amortization(p, facility);
        valid_when elects_pollution_control_amortization(p, facility);
        effect create(pollution_control_amortization_election_in_effect(p, facility));
        window [@1969-01-01, infinity);
    };
}
pub relation discontinues_pollution_control_amortization(p: Person, facility: Integer) kind empirical {
    label en official "the taxpayer discontinues the amortization deduction from the beginning of a month specified in a written notice filed before that month (section 169(c))";
}
pub relation pollution_control_amortization_discontinued(p: Person, facility: Integer) kind institutional {
    label en official "the amortization is discontinued; the section 167 deduction applies from that month and no further section 169 deduction is allowed";
}
@source(IRC_S169_C, quote = "may, at any time after making such election, discontinue the amortization deduction with respect to the remainder of the amortization period")
rule PollutionControlDiscontinuancePower(p: Person, facility: Integer) strict {
    label en official "a taxpayer that has elected has the power to discontinue the amortization for the remainder of the period (section 169(c))";
    when discontinues_pollution_control_amortization(p, facility);
    then power PollutionControlDiscontinuance {
        holder p;
        over facility;
        exercise discontinues_pollution_control_amortization(p, facility);
        valid_when pollution_control_amortization_election_in_effect(p, facility);
        effect create(pollution_control_amortization_discontinued(p, facility));
        window [@1969-01-01, infinity);
    };
}
pub relation pollution_control_amortizable_basis(p: Person, facility: Integer, amount: Money) kind empirical {
    label en official "the amortizable basis of the certified pollution control facility, after the section 291(a)(4) reduction of 20 percent where the taxpayer is a corporation (section 169(a),(d)(4))";
}
pub relation pollution_control_months_in_taxable_year(p: Person, facility: Integer, y: TaxableYear, months: Integer) kind empirical {
    label en official "the months of the 60-month period that fall within the taxable year (month-count term gap, TECH_GAPS G2703)";
}
pub relation pollution_control_amortization_deduction(p: Person, facility: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 169 amortization for the taxable year: the amortizable basis ratably over 60 months (the monthly recomputation of basis over remaining months is the same straight-line amount)";
}
pub relation facility_in_connection_with_plant_placed_in_operation_after_1975(p: Person, facility: Integer) kind institutional {
    label en official "the facility is placed in service in connection with a plant or other property placed in operation after December 31, 1975, so that 84 months are substituted for 60 (section 169(d)(5)(B))";
}
@source(IRC_S169_A, quote = "based on a period of 60 months")
rule PollutionControlAmortizationDeduction(p: Person, facility: Integer, y: TaxableYear, basis: Money, months: Integer) defeasible {
    label en official "basis times the months of the year over 60, one rounding (section 169(a))";
    when certified_pollution_control_facility(p, facility);
    when pollution_control_amortization_election_in_effect(p, facility);
    when pollution_control_amortizable_basis(p, facility, basis);
    when pollution_control_months_in_taxable_year(p, facility, y, months);
    when not_known(pollution_control_amortization_discontinued(p, facility));
    when not_known(facility_in_connection_with_plant_placed_in_operation_after_1975(p, facility));
    then pollution_control_amortization_deduction(p, facility, y, div_round(basis * months, 60.0, 2, "HALF_UP"));
}
@source(IRC_S169_D, quote = "this section shall be applied by substituting \"84\" for \"60\" each place it appears in subsections (a) and (b).")
rule PollutionControlAmortizationDeduction84Months(p: Person, facility: Integer, y: TaxableYear, basis: Money, months: Integer) defeasible {
    label en official "for a facility in connection with a plant placed in operation after 1975 the period is 84 months: basis times the months of the year over 84, one rounding (section 169(d)(5)(B))";
    when certified_pollution_control_facility(p, facility);
    when pollution_control_amortization_election_in_effect(p, facility);
    when pollution_control_amortizable_basis(p, facility, basis);
    when pollution_control_months_in_taxable_year(p, facility, y, months);
    when facility_in_connection_with_plant_placed_in_operation_after_1975(p, facility);
    when not_known(pollution_control_amortization_discontinued(p, facility));
    then pollution_control_amortization_deduction(p, facility, y, div_round(basis * months, 84.0, 2, "HALF_UP"));
}
pub relation eligible_adjusted_basis_before_useful_life_ratio(p: Person, facility: Integer, amount: Money) kind institutional {
    label en official "the portion of the adjusted basis (for determining gain) eligible for amortization but for section 169(f)(2)(A)";
}
pub relation facility_useful_life_years(p: Person, facility: Integer, years: Integer) kind empirical {
    label en official "the useful life in years, determined as of the first day of the first month for which a deduction is allowable (section 169(f)(2)(A))";
}
pub relation amortizable_basis_after_useful_life_ratio_169f2a(p: Person, facility: Integer, amount: Money) kind institutional {
    label en official "for a useful life over 15 years the amortizable basis is the eligible basis times 15 over the useful life in years, one rounding (section 169(f)(2)(A))";
}
@source(IRC_S169_F, quote = "as 15 bears to the number of years of useful life of such facility.")
rule AmortizableBasisUsefulLifeRatio(p: Person, facility: Integer, eligible: Money, years: Integer) strict {
    label en official "eligible basis x 15 / useful life for a facility with a useful life above 15 years (section 169(f)(2)(A)); the section 169 amortization rules above read the resulting basis as the asserted `pollution_control_amortizable_basis`";
    when eligible_adjusted_basis_before_useful_life_ratio(p, facility, eligible);
    when facility_useful_life_years(p, facility, years);
    when years > 15;
    then amortizable_basis_after_useful_life_ratio_169f2a(p, facility, div_round(eligible * 15, years * 1.0, 2, "HALF_UP"));
}
@source(IRC_S169_A, quote = "Every person, at his election, shall be entitled to a deduction with respect to the amortization of the amortizable basis of any certified pollution control facility")
rule PollutionControlAmortizationAllowed(p: Person, facility: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the section 169 amount is an allowed deduction";
    when pollution_control_amortization_deduction(p, facility, y, amount);
    then deduction_allowed(p, y, Section169PollutionControl, amount);
}

// === §179B: small business refiner ==================================================================

pub relation small_business_refiner_qualified_costs(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "qualified costs (section 45H(c)(2)) paid or incurred during the taxable year by a small business refiner (section 45H(c)(1)) that are properly chargeable to capital account (section 179B(a))";
}
pub relation refinery_runs_over_155000_barrels_excess(p: Person, barrels: Integer) kind empirical {
    label en official "the excess over 155,000 barrels of the average daily domestic refinery runs for the 1-year period ending December 31, 2002 (section 179B(b)); zero where the runs do not exceed 155,000";
}
pub relation elects_section_179b(p: Person, y: TaxableYear) kind empirical {
    label en official "the small business refiner elects the application of section 179B";
}
pub relation section_179b_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 179B election is in effect for the taxable year";
}
@source(IRC_S179B_A, quote = "which elects the application of this section")
rule Section179bElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a small business refiner has the power to elect section 179B";
    when elects_section_179b(p, y);
    then power Section179bElection {
        holder p;
        over y;
        exercise elects_section_179b(p, y);
        valid_when elects_section_179b(p, y);
        effect create(section_179b_election_in_effect(p, y));
        window [@2004-10-23, infinity);
    };
}
pub relation section_179b_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 179B deduction: 75 percent of qualified costs, the 75 percentage points reduced (not below zero) by 75 times the ratio of the excess over 155,000 barrels to 50,000 barrels";
}
@source(IRC_S179B_B, quote = "the number of percentage points described in subsection (a) shall be reduced (not below zero) by the product of such number (before the application of this subsection) and the ratio of such excess to 50,000 barrels")
rule Section179bDeductionRule(p: Person, y: TaxableYear, costs: Money, excess: Integer) defeasible {
    label en official "deduction = costs x 75 x (50,000 - excess) / (50,000 x 100), the excess capped at 50,000 barrels, one rounding (section 179B(a),(b))";
    when section_179b_election_in_effect(p, y);
    when small_business_refiner_qualified_costs(p, y, costs);
    when refinery_runs_over_155000_barrels_excess(p, excess);
    then section_179b_deduction(p, y, div_round(costs * 75 * max(0, 50000 - excess), 5000000.0, 2, "HALF_UP"));
}
@source(IRC_S179B_A, quote = "there shall be allowed as a deduction an amount equal to 75 percent of qualified costs")
rule Section179bDeductionAllowed(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the section 179B amount is an allowed deduction";
    when section_179b_deduction(p, y, amount);
    then deduction_allowed(p, y, Section179BSmallRefiner, amount);
}

// === §179C: qualified refinery property ==============================================================

pub relation qualified_refinery_property_cost(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the cost of qualified refinery property placed in service in the taxable year: a portion of a qualified refinery in the United States, the original use of which commences with the taxpayer, placed in service after August 8, 2005 and before January 1, 2014, meeting the capacity requirement of (e) and environmental laws, with no binding contract on or before June 14, 2005 and the construction or placement timing of (c)(1)(F) (section 179C(c),(d))";
}
pub relation refinery_property_ineligible_179cf(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the property's primary purpose is use as a topping plant, asphalt plant, lube oil facility, crude or product terminal or blending facility, or it is built solely to comply with consent decrees or governmental mandates (section 179C(f))";
}
pub relation elects_section_179c(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects, on its return for the year, to treat 50 percent of the cost as an expense; revocable only with the Secretary's consent (section 179C(b))";
}
pub relation section_179c_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 179C election is in effect for the taxable year";
}
pub relation files_section_179c_report(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer files with the Secretary the report on the operation of its refineries (section 179C(h))";
}
@source(IRC_S179C_A, quote = "A taxpayer may elect to treat 50 percent of the cost of any qualified refinery property as an expense which is not chargeable to capital account.")
rule Section179cElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer has the power to elect to expense 50 percent of the cost of qualified refinery property (section 179C(a),(b))";
    when elects_section_179c(p, y);
    then power Section179cElection {
        holder p;
        over y;
        exercise elects_section_179c(p, y);
        valid_when elects_section_179c(p, y);
        effect create(section_179c_election_in_effect(p, y));
        window [@2005-08-08, @2014-01-01);
    };
}
@source(IRC_S179C_A, quote = "Any cost so treated shall be allowed as a deduction for the taxable year in which the qualified refinery property is placed in service.")
rule Section179cDeduction(p: Person, y: TaxableYear, item: Integer, cost: Money) defeasible {
    label en official "50 percent of the cost of qualified refinery property is deducted in the year placed in service, unless the property is ineligible under (f) or the (h) report is not filed";
    when section_179c_election_in_effect(p, y);
    when qualified_refinery_property_cost(p, y, item, cost);
    when files_section_179c_report(p, y);
    when not_known(section_179c_election_revoked(p, y));
    when not_known(refinery_property_ineligible_179cf(p, y, item));
    then deduction_allowed(p, y, Section179CRefineryProperty, round(cost * 0.50, 2, "HALF_UP"));
}

// === §179E: advanced mine safety equipment ==============================================================

pub relation advanced_mine_safety_equipment_cost(p: Person, y: TaxableYear, item: Integer, placed_in_service: Date, amount: Money) kind institutional {
    label en official "the cost of qualified advanced mine safety equipment property (emergency communication, tracking, self-rescue oxygen devices, pre-positioned oxygen or atmospheric monitoring) for use in an underground mine in the United States, original use with the taxpayer, placed in service after the enactment (section 179E(c),(d)) on the stated date";
}
pub relation cost_specified_in_section_179_election(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the portion of the cost of the property is specified in an election under section 179 (section 179E(e))";
}
pub relation elects_section_179e(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects, on its return, to treat 50 percent of the cost as an expense; the election specifies the property and is revocable only with consent (section 179E(b))";
}
pub relation section_179e_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 179E election is in effect for the taxable year";
}
pub relation files_section_179e_report(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer files with the Secretary the report on the operation of its mines (section 179E(f))";
}
@source(IRC_S179E_A, quote = "A taxpayer may elect to treat 50 percent of the cost of any qualified advanced mine safety equipment property as an expense which is not chargeable to capital account.")
rule Section179eElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer has the power to elect to expense 50 percent of the cost of advanced mine safety equipment (section 179E(a),(b))";
    when elects_section_179e(p, y);
    then power Section179eElection {
        holder p;
        over y;
        exercise elects_section_179e(p, y);
        valid_when elects_section_179e(p, y);
        effect create(section_179e_election_in_effect(p, y));
        window [@2006-12-20, @2018-01-01);
    };
}
@source(IRC_S179E_G, quote = "This section shall not apply to property placed in service after December 31, 2017.")
rule Section179eDeduction(p: Person, y: TaxableYear, item: Integer, placed: Date, cost: Money) defeasible {
    label en official "50 percent of the cost is deducted in the year placed in service, for property placed in service after enactment and not after December 31, 2017, excluding costs specified in a section 179 election, if the (f) report is filed (section 179E(a),(e),(f),(g))";
    when section_179e_election_in_effect(p, y);
    when advanced_mine_safety_equipment_cost(p, y, item, placed, cost);
    when placed <= @2017-12-31;
    when files_section_179e_report(p, y);
    when not_known(section_179e_election_revoked(p, y));
    when not_known(cost_specified_in_section_179_election(p, y, item));
    then deduction_allowed(p, y, Section179EMineSafety, round(cost * 0.50, 2, "HALF_UP"));
}
