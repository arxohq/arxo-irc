// Section 172 — Net operating loss deduction. Stage 1 (IRC-06), priority
// section. Scope: (a) the 80% limitation for post-2017 losses (with the
// pre-2018 carryover exemption from the cap); (b) the general carryover
// rule (indefinite for post-2017 losses) and the farming 2-year carryback;
// (c) the NOL definition (cross-referring to (d) modifications, "stage 2").

use self::{
    DeductionKind,
    IRC_S172_A,
    IRC_S172_B,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation net_operating_loss_for_year(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the deductions allowed by chapter 1 over gross income for the taxable year, as modified by section 172(d) (section 172(c)) — dependency contract for the (d) modifications, producer: unresolved (full chapter-1 computation out of this stage's scope)";
}
pub relation is_farming_loss_portion(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of a net operating loss for the taxable year that is a farming loss (section 172(b)(1)(B)(ii))";
}
pub relation nol_carryover_pre2018_arising(p: Person, to_y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate net operating loss carryover to the taxable year, arising in taxable years beginning before January 1, 2018 (section 172(a)(2)(A)) — NOT subject to the 80% cap";
}
pub relation nol_carryover_post2017_arising(p: Person, to_y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate net operating loss carried to the taxable year, arising in taxable years beginning after December 31, 2017 (section 172(a)(2)(B)(i)) — subject to the 80% cap";
}
pub relation nol_carryover_to_year(p: Person, from_y: TaxableYear, to_y: TaxableYear, amount: Money) kind institutional {
    label en official "a net operating loss (or farming-loss portion) carried from one taxable year to another (section 172(b)(1)) — illustrates the carryover mechanic; the aggregate-by-year relations above are what the deduction-computation rules consume, and a scenario may assert them directly for a given year rather than deriving them from this relation";
}
pub relation taxable_income_before_nol_199a_250(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "taxable income computed without regard to the NOL deduction and the sections 199A and 250 deductions (section 172(a)(2)(B)(ii)(I))";
}

@source(IRC_S172_A, quote = "the aggregate amount of net operating losses arising in taxable years beginning before January 1, 2018, carried to such taxable year")
rule NolDeductionPre2018PortionFullyAllowed(p: Person, y: TaxableYear, pre2018: Money) strict {
    label en official "pre-2018-arising NOL carryovers are allowed in full, without the 80% cap (section 172(a)(2)(A))";
    effective [@2021-01-01, infinity);
    when nol_carryover_pre2018_arising(p, y, pre2018);
    then deduction_allowed(p, y, Section172Nol, pre2018);
}
@source(IRC_S172_A, quote = "80 percent of the excess (if any) of")
rule NolDeductionPost2017PortionCappedAtEightyPercent(p: Person, y: TaxableYear, post2017: Money, pre2018: Money, ti: Money) strict {
    label en official "post-2017-arising NOL carryovers are allowed up to the lesser of the carryover amount or 80% of taxable income (before NOL/199A/250) in excess of the pre-2018 portion allowed; the post-2017 carryover exceeds that 80% figure here";
    effective [@2021-01-01, infinity);
    when nol_carryover_post2017_arising(p, y, post2017);
    when nol_carryover_pre2018_arising(p, y, pre2018);
    when taxable_income_before_nol_199a_250(p, y, ti);
    when post2017 > round((ti - pre2018) * 0.80, 2, "HALF_UP");
    when (ti - pre2018) > 0.00 USD;
    then deduction_allowed(p, y, Section172Nol, round((ti - pre2018) * 0.80, 2, "HALF_UP"));
}
@source(IRC_S172_A, quote = "the aggregate amount of net operating losses arising in taxable years beginning after December 31, 2017, carried to such taxable year")
rule NolDeductionPost2017PortionWithinEightyPercent(p: Person, y: TaxableYear, post2017: Money, pre2018: Money, ti: Money) strict {
    label en official "post-2017-arising NOL carryovers not exceeding 80% of the post-pre-2018-offset taxable income are allowed in full";
    effective [@2021-01-01, infinity);
    when nol_carryover_post2017_arising(p, y, post2017);
    when nol_carryover_pre2018_arising(p, y, pre2018);
    when taxable_income_before_nol_199a_250(p, y, ti);
    when (ti - pre2018) > 0.00 USD;
    when post2017 <= round((ti - pre2018) * 0.80, 2, "HALF_UP");
    then deduction_allowed(p, y, Section172Nol, post2017);
}
@source(IRC_S172_A, quote = "in the case of a taxable year beginning before January 1, 2021, the aggregate of the net operating loss carryovers to such year, plus the net operating loss carrybacks to such year")
rule NolDeductionPreTcjaCapWindowNoLimitation(p: Person, y: TaxableYear, carryovers: Money, carrybacks: Money) strict {
    label en official "for a taxable year beginning before January 1, 2021, the NOL deduction is the full aggregate of carryovers and carrybacks, with no 80% cap (section 172(a)(1))";
    effective (-infinity, @2021-01-01);
    when nol_carryover_pre2018_arising(p, y, carryovers);
    when nol_carryover_post2017_arising(p, y, carrybacks);
    then deduction_allowed(p, y, Section172Nol, carryovers + carrybacks);
}

// --- §172(b): carryover rules ----------------------------------------------------

@source(IRC_S172_B, quote = "in the case of a net operating loss arising in a taxable year beginning after December 31, 2017, to each taxable year following the taxable year of the loss")
rule NolPost2017CarriedForwardIndefinitely(p: Person, y_loss: TaxableYear, y_to: TaxableYear, amount: Money) defeasible {
    label en official "a net operating loss arising in a taxable year beginning after December 31, 2017 carries forward indefinitely, to every succeeding taxable year until absorbed (section 172(b)(1)(A)(ii)(II))";
    when net_operating_loss_for_year(p, y_loss, amount);
    when us.irc.core::year_of(p, y_to);
    then nol_carryover_to_year(p, y_loss, y_to, amount);
}
@source(IRC_S172_B, quote = "such loss shall be a net operating loss carryback to each of the 2 taxable years preceding the taxable year of such loss")
rule FarmingLossTwoYearCarryback(p: Person, y_loss: TaxableYear, y_to: TaxableYear, farming_amount: Money) strict {
    label en official "the farming-loss portion of a net operating loss is carried back to each of the 2 taxable years preceding the loss year (section 172(b)(1)(B)(i))";
    when is_farming_loss_portion(p, y_loss, farming_amount);
    when us.irc.core::year_of(p, y_to);
    then nol_carryover_to_year(p, y_loss, y_to, farming_amount);
}
// classification note: `NolPost2017CarriedForwardIndefinitely` and
// `FarmingLossTwoYearCarryback` both feed `nol_carryover_post2017_arising`
// with the SAME shape but different `y_to` binding rules (a scenario
// supplies the specific `y_to` years it needs — forward years for the
// former, one or both preceding years for the latter — since deriving
// "every succeeding year" or "the 2 preceding years" from a bare
// `TaxableYear` instance and a calendar-year integer is a TECH_GAP
// (successor/predecessor year arithmetic, same gap noted in
// `163-interest.law`)).

// (b)(1)(B)(iv) election out of farming carryback, (b)(1)(C) insurance
// company special periods, (b)(1)(D) 2018-2020 five-year carryback special
// rule, (d) modifications defining the NOL itself stay "stage 2".
