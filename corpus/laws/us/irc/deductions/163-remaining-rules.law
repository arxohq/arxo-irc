// Section 163 — remaining subsections (stage 2): (b) imputed interest on installment
// purchases, (c) redeemable ground rent, (e) original issue discount (the daily
// portion total, related foreign holders, and the applicable high yield discount
// obligation disqualified portion), (f) registration-required obligations, (g)
// mortgage credit certificates, (i) applicable high yield discount obligations, (k)
// estate tax extension interest, (l) disqualified debt instruments and (m) interest on
// reportable transaction understatements. The general rule of (a) in
// `163-interest.law` reads `interest_denied_by_163_special_rule`, defined here.
// Not modelled (TECH_GAPS G2781): the daily portion computation of section 1272(a)
// (asserted totals), (n) cross references, the section 149(a)(3) book-entry rules
// of (f)(3), the regulatory modifications of (i)(5), and section 1275/1273
// definitions.

use self::{
    DeductionKind,
    IRC_S163_B,
    IRC_S163_C,
    IRC_S163_E,
    IRC_S163_F,
    IRC_S163_G,
    IRC_S163_I,
    IRC_S163_K,
    IRC_S163_L,
    IRC_S163_M,
    Person,
    TaxableYear,
    ahydo_deduction_deferred_until_paid,
    deduction_allowed,
    interest_paid_or_accrued,
    oid_cfc_pfic_limit_applies,
};

pub relation interest_denied_by_163_special_rule(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "a special rule of section 163 denies the interest deduction for the item ((e)(3),(e)(5),(f),(k),(l),(m))";
}

// === (b): interest on certain deferred payments ==============================================

pub relation installment_purchase_contract(p: Person, y: TaxableYear, contract: Integer) kind empirical {
    label en official "personal property or educational services are purchased under a contract that provides for payment of part or all of the price in installments and in which carrying charges are separately stated but the interest charge cannot be ascertained (section 163(b)(1))";
}
pub relation sum_of_unpaid_balances_on_first_day_of_each_month(p: Person, y: TaxableYear, contract: Integer, amount: Money) kind empirical {
    label en official "the sum of the unpaid balance outstanding on the first day of each month beginning during the taxable year (section 163(b)(1)); the average unpaid balance is this sum divided by 12";
}
pub relation carrying_charges_attributable_to_year(p: Person, y: TaxableYear, contract: Integer, amount: Money) kind empirical {
    label en official "the aggregate carrying charges properly attributable to the taxable year (section 163(b)(2))";
}
pub relation imputed_interest_on_installment_contract(p: Person, y: TaxableYear, contract: Integer, amount: Money) kind institutional {
    label en official "the amount of the payments treated as interest: 6 percent of the average unpaid balance, not above the carrying charges attributable to the year (section 163(b))";
}
@source(IRC_S163_B, quote = "then the payments made during the taxable year under the contract shall be treated for purposes of this section as if they included interest equal to 6 percent of the average unpaid balance under the contract during the taxable year.")
rule ImputedInterestOnInstallmentContract(p: Person, y: TaxableYear, contract: Integer, sum: Money, charges: Money) strict {
    label en official "6 percent of the average unpaid balance (sum of twelve monthly balances over 12) is exactly sum x 6 / 1200, one rounding; capped by the carrying charges (section 163(b)(1),(2))";
    when installment_purchase_contract(p, y, contract);
    when sum_of_unpaid_balances_on_first_day_of_each_month(p, y, contract, sum);
    when carrying_charges_attributable_to_year(p, y, contract, charges);
    then imputed_interest_on_installment_contract(p, y, contract, min(div_round(sum * 6, 1200.0, 2, "HALF_UP"), charges));
}

// === (c): redeemable ground rents ================================================================

pub relation redeemable_ground_rent_periodic_rental(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an annual or periodic rental under a redeemable ground rent, excluding amounts in redemption (section 163(c))";
}
pub relation ground_rent_treated_as_interest_on_mortgage_indebtedness(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the rental is treated as interest on an indebtedness secured by a mortgage for purposes of the subtitle (section 163(c))";
}
@source(IRC_S163_C, quote = "shall be treated as interest on an indebtedness secured by a mortgage.")
rule RedeemableGroundRentAsInterest(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "periodic ground rent is treated as mortgage interest (section 163(c))";
    when redeemable_ground_rent_periodic_rental(p, y, item, amount);
    then ground_rent_treated_as_interest_on_mortgage_indebtedness(p, y, item, amount);
}

// === (e): original issue discount =================================================================

pub relation oid_daily_portions_for_year(p: Person, y: TaxableYear, instrument: Integer, amount: Money) kind institutional {
    label en official "the aggregate daily portions of the original issue discount for days during the year, determined under section 1272(a) without regard to paragraph (7) and section 1273(a)(3) (section 163(e)(1),(2)(B)); an asserted total (TECH_GAPS G2781)";
}
pub relation instrument_loan_between_natural_persons(p: Person, instrument: Integer) kind empirical {
    label en official "the debt instrument is a loan between natural persons described in section 1272(a)(2)(D), outside subsection (e) (section 163(e)(4))";
}
pub relation issuer_cash_method_short_term_obligation(p: Person, instrument: Integer) kind empirical {
    label en official "the issuer uses the cash receipts and disbursements method and the instrument is a short-term obligation (section 1283(a)(1)(A)) (section 163(e)(2)(C))";
}
pub relation oid_paid_in_year(p: Person, y: TaxableYear, instrument: Integer, amount: Money) kind empirical {
    label en official "the original issue discount (and other interest) paid during the year";
}
pub relation held_by_related_foreign_person(p: Person, instrument: Integer) kind empirical {
    label en official "the debt instrument is held by a related foreign person: a non-United States person related to the issuer within section 267(b) (section 163(e)(3)(C))";
}
pub relation oid_effectively_connected_with_us_business_of_foreign_holder(p: Person, instrument: Integer) kind empirical {
    label en official "the original issue discount is effectively connected with the foreign holder's United States trade or business and not exempt or subject to a reduced treaty rate (section 163(e)(3)(A) second sentence)";
}
pub relation oid_deduction_for_year(p: Person, y: TaxableYear, instrument: Integer, amount: Money) kind institutional {
    label en official "the portion of the original issue discount allowable to the issuer for the year: the aggregate daily portions, or only what is paid for cash-method short-term obligations and related foreign holders";
}
@source(IRC_S163_E, quote = "The portion of the original issue discount with respect to any debt instrument which is allowable as a deduction to the issuer for any taxable year shall be equal to the aggregate daily portions of the original issue discount for days during such taxable year.")
rule OidDeductionAccrual(p: Person, y: TaxableYear, instrument: Integer, daily: Money) strict {
    label en official "the deduction is the aggregate daily portions (section 163(e)(1)), unless a deferral rule below applies";
    when oid_daily_portions_for_year(p, y, instrument, daily);
    when not_known(instrument_loan_between_natural_persons(p, instrument));
    when not_known(issuer_cash_method_short_term_obligation(p, instrument));
    when not_known(held_by_related_foreign_person(p, instrument));
    when not_known(ahydo_deduction_deferred_until_paid(p, instrument));
    then oid_deduction_for_year(p, y, instrument, daily);
}
@source(IRC_S163_E, quote = "shall be deductible only when paid.")
rule OidCashMethodShortTermOnlyWhenPaid(p: Person, y: TaxableYear, instrument: Integer, daily: Money, paid: Money) strict {
    label en official "a cash-method issuer of a short-term obligation deducts only what is paid (section 163(e)(2)(C))";
    when oid_daily_portions_for_year(p, y, instrument, daily);
    when issuer_cash_method_short_term_obligation(p, instrument);
    when oid_paid_in_year(p, y, instrument, paid);
    then oid_deduction_for_year(p, y, instrument, min(daily, paid));
}
@source(IRC_S163_E, quote = "shall not be allowable as a deduction to the issuer until paid.")
rule OidRelatedForeignHolderOnlyWhenPaid(p: Person, y: TaxableYear, instrument: Integer, daily: Money, paid: Money) strict {
    label en official "original issue discount held by a related foreign person is deductible only when paid, except to the extent effectively connected with a U.S. business (section 163(e)(3)(A)); the controlled foreign corporation and PFIC inclusion rule of (B) is not modelled (G2781)";
    when oid_daily_portions_for_year(p, y, instrument, daily);
    when held_by_related_foreign_person(p, instrument);
    when not_known(oid_effectively_connected_with_us_business_of_foreign_holder(p, instrument));
    when not_known(oid_cfc_pfic_limit_applies(p, instrument));
    when not_known(ahydo_deduction_deferred_until_paid(p, instrument));
    when oid_paid_in_year(p, y, instrument, paid);
    then oid_deduction_for_year(p, y, instrument, min(daily, paid));
}
@source(IRC_S163_E, quote = "shall not be allowable as a deduction to the issuer until paid.")
rule OidRelatedForeignHolderEffectivelyConnected(p: Person, y: TaxableYear, instrument: Integer, daily: Money) strict {
    label en official "effectively connected original issue discount is deductible as it accrues";
    when oid_daily_portions_for_year(p, y, instrument, daily);
    when held_by_related_foreign_person(p, instrument);
    when oid_effectively_connected_with_us_business_of_foreign_holder(p, instrument);
    then oid_deduction_for_year(p, y, instrument, daily);
}

// --- (i),(e)(5): applicable high yield discount obligations ------------------------------------

pub relation instrument_maturity_over_5_years(p: Person, instrument: Integer) kind empirical {
    label en official "the maturity date is more than 5 years from the date of issue (section 163(i)(1)(A))";
}
pub relation instrument_yield_to_maturity(p: Person, instrument: Integer, yield_rate: Decimal) kind empirical {
    label en official "the yield to maturity, as a percentage per year";
}
pub relation applicable_federal_rate_at_issue(p: Person, instrument: Integer, rate: Decimal) kind empirical {
    label en official "the applicable Federal rate under section 1274(d) for the calendar month of issue, as a percentage (section 163(i)(1)(B)(i)); rates are published monthly (unpinned, TECH_GAPS G2781)";
}
pub relation instrument_has_significant_original_issue_discount(p: Person, instrument: Integer) kind institutional {
    label en official "the instrument has significant original issue discount: the amount includible before the close of an accrual period ending after 5 years exceeds the sum of interest to be paid and the issue price times the yield (section 163(i)(2)); asserted";
}
pub relation applicable_high_yield_discount_obligation(p: Person, instrument: Integer) kind institutional {
    label en official "an applicable high yield discount obligation: maturity over 5 years, yield at least the applicable Federal rate plus 5 percentage points, and significant original issue discount (section 163(i)(1))";
}
@source(IRC_S163_I, quote = "the term \"applicable high yield discount obligation\" means any debt instrument if—")
rule AhydoRule(p: Person, instrument: Integer, yield_rate: Decimal, afr: Decimal) strict {
    label en official "the three conditions of section 163(i)(1)";
    when instrument_maturity_over_5_years(p, instrument);
    when instrument_yield_to_maturity(p, instrument, yield_rate);
    when applicable_federal_rate_at_issue(p, instrument, afr);
    when yield_rate >= afr + 5.0;
    when instrument_has_significant_original_issue_discount(p, instrument);
    then applicable_high_yield_discount_obligation(p, instrument);
}
pub relation issuer_is_s_corporation_for_period(p: Person, instrument: Integer) kind empirical {
    label en official "the obligation is issued by a corporation for a period for which it is an S corporation (section 163(e)(5)(D))";
}
pub relation ahydo_issued_from_2008_09_01_to_2009_12_31(p: Person, instrument: Integer) kind empirical {
    label en official "the obligation is issued during the period beginning September 1, 2008 and ending December 31, 2009 (section 163(e)(5)(F)(i)) — the AHYDO holiday, with the (ii) non-treatment as an AHYDO for the rest of the subparagraph";
}
pub relation total_return_on_obligation(p: Person, instrument: Integer, amount: Money) kind institutional {
    label en official "the total return: the original issue discount the obligation would have if interest described in section 1273(a)(2) were included in the stated redemption price at maturity (section 163(e)(5)(C)(ii))";
}
pub relation original_issue_discount_on_obligation(p: Person, instrument: Integer, amount: Money) kind empirical {
    label en official "the original issue discount on the obligation";
}
pub relation disqualified_portion_of_original_issue_discount(p: Person, instrument: Integer, amount: Money) kind institutional {
    label en official "the lesser of the original issue discount and the part of the total return in the ratio of the disqualified yield to the yield to maturity; the disqualified yield is the yield less the applicable Federal rate plus 6 percentage points (section 163(e)(5)(C))";
}
@source(IRC_S163_E, quote = "the disqualified portion of the original issue discount on any applicable high yield discount obligation is the lesser of—")
rule DisqualifiedPortionRule(p: Person, instrument: Integer, oid: Money, total: Money, yield_rate: Decimal, afr: Decimal) strict {
    label en official "min(OID, total return x (yield - (AFR + 6)) / yield) with one rounding, when the disqualified yield is positive (section 163(e)(5)(C))";
    when applicable_high_yield_discount_obligation(p, instrument);
    when not_known(issuer_is_s_corporation_for_period(p, instrument));
    when not_known(ahydo_issued_from_2008_09_01_to_2009_12_31(p, instrument));
    when original_issue_discount_on_obligation(p, instrument, oid);
    when total_return_on_obligation(p, instrument, total);
    when instrument_yield_to_maturity(p, instrument, yield_rate);
    when applicable_federal_rate_at_issue(p, instrument, afr);
    when yield_rate > afr + 6.0;
    then disqualified_portion_of_original_issue_discount(p, instrument, min(oid, div_round(total * (yield_rate - afr - 6.0), yield_rate, 2, "HALF_UP")));
}
@source(IRC_S163_E, quote = "no deduction shall be allowed under this chapter for the disqualified portion of the original issue discount on such obligation, and")
rule DisqualifiedPortionNotDeductible(p: Person, y: TaxableYear, instrument: Integer, amount: Money) strict {
    label en official "no deduction for the disqualified portion; the remainder is deductible only when paid (section 163(e)(5)(A)); the year in which the portion accrues is asserted through the daily portion total";
    when disqualified_portion_of_original_issue_discount(p, instrument, amount);
    when oid_daily_portions_for_year(p, y, instrument, _);
    then not deduction_allowed(p, y, Section163AhydoDisqualifiedPortion, amount);
}

// === (f): registration-required obligations ==========================================================

pub relation registration_required_obligation_interest(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "interest on a registration-required obligation: any obligation other than one issued by a natural person, not of a type offered to the public, or with a maturity at issue of not more than 1 year (section 163(f)(2)(A))";
}
pub relation obligation_in_registered_form(p: Person, item: Integer) kind institutional {
    label en official "the obligation is in registered form (section 163(f)(1)); a book-entry system counts under rules similar to section 149(a)(3)";
}
@source(IRC_S163_F, quote = "Nothing in subsection (a) or in any other provision of law shall be construed to provide a deduction for interest on any registration-required obligation unless such obligation is in registered form.")
rule RegistrationRequiredNotRegisteredDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for interest on a registration-required obligation not in registered form (section 163(f)(1))";
    when registration_required_obligation_interest(p, y, item, amount);
    when not_known(obligation_in_registered_form(p, item));
    then interest_denied_by_163_special_rule(p, y, item);
}

// === (g): mortgage credit certificates ======================================================================

pub relation interest_on_indebtedness_with_mortgage_credit_certificate(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest paid or accrued on indebtedness for which a mortgage credit certificate has been issued under section 25";
}
pub relation section_25_credit_allowable_on_that_interest(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the credit allowable with respect to that interest under section 25, determined without regard to section 26 (section 163(g))";
}
pub relation deduction_reduction_for_mortgage_credit_certificate(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the reduction of the interest deduction by the credit allowable (section 163(g))";
}
@source(IRC_S163_G, quote = "shall be reduced by the amount of the credit allowable with respect to such interest under section 25")
rule MortgageCreditCertificateReduction(p: Person, y: TaxableYear, item: Integer, interest: Money, credit: Money) strict {
    label en official "the interest deduction is reduced by the section 25 credit, not below zero (section 163(g))";
    when interest_on_indebtedness_with_mortgage_credit_certificate(p, y, item, interest);
    when section_25_credit_allowable_on_that_interest(p, y, item, credit);
    then deduction_reduction_for_mortgage_credit_certificate(p, y, item, min(interest, credit));
}

// === (k): estate tax extension interest ======================================================================

pub relation section_6601_interest_on_estate_tax_under_6166_extension(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest payable under section 6601 on the unpaid portion of the section 2001 tax for the period an extension under section 6166 is in effect (section 163(k))";
}
@source(IRC_S163_K, quote = "No deduction shall be allowed under this section for any interest payable under section 6601 on any unpaid portion of the tax imposed by section 2001")
rule EstateTaxExtensionInterestDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for section 6166 extension interest (section 163(k))";
    when section_6601_interest_on_estate_tax_under_6166_extension(p, y, item, amount);
    then interest_denied_by_163_special_rule(p, y, item);
}

// === (l): disqualified debt instruments ======================================================================

pub relation corporate_indebtedness_payable_in_equity(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "interest paid or accrued on indebtedness of a corporation payable in equity of the issuer or a related party, or in equity held by the issuer in another person, in the manner of (l)(3): a substantial amount of principal or interest required to be paid or converted into, or determined by reference to, the value of equity, or part of an arrangement expected to result in that (section 163(l)(2),(3))";
}
pub relation indebtedness_issued_by_dealer_payable_by_reference_to_dealer_held_equity(p: Person, item: Integer) kind empirical {
    label en official "indebtedness issued by a dealer in securities (or a related party) payable in, or by reference to, equity of another person held by the dealer in its capacity as a dealer (section 163(l)(5))";
}
@source(IRC_S163_L, quote = "No deduction shall be allowed under this chapter for any interest paid or accrued on a disqualified debt instrument.")
rule DisqualifiedDebtInstrumentInterestDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for interest on a disqualified debt instrument, other than dealer indebtedness (section 163(l)(1),(5))";
    when corporate_indebtedness_payable_in_equity(p, y, item, amount);
    when not_known(indebtedness_issued_by_dealer_payable_by_reference_to_dealer_held_equity(p, item));
    then interest_denied_by_163_special_rule(p, y, item);
}

// === (m): interest on reportable transaction understatements ============================================

pub relation section_6601_interest_on_reportable_transaction_understatement_without_reasonable_cause(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest under section 6601 on an underpayment attributable to a reportable transaction understatement (section 6662A(b)) for which the requirement of section 6664(d)(2)(A) is not met (section 163(m))";
}
@source(IRC_S163_M, quote = "No deduction shall be allowed under this chapter for any interest paid or accrued under section 6601 on any underpayment of tax")
rule ReportableTransactionUnderstatementInterestDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for the interest (section 163(m))";
    when section_6601_interest_on_reportable_transaction_understatement_without_reasonable_cause(p, y, item, amount);
    then interest_denied_by_163_special_rule(p, y, item);
}
@source(IRC_S163_K, quote = "No deduction shall be allowed under this section for any interest payable under section 6601")
rule InterestDeniedBySpecialRuleNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the interest denied by a special rule of section 163 is not an allowed deduction";
    when interest_denied_by_163_special_rule(p, y, item);
    when interest_paid_or_accrued(p, y, item, amount);
    then not deduction_allowed(p, y, Section163Interest, amount);
}
