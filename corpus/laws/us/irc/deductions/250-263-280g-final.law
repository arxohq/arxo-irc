// Deductions -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): G4400 (section 250(b)(5)(C)(i), a sale of property is a sale of
// each of its components), G4401 (section 250(b)(5)(D)(ii), the affiliated group without regard to section 1504(b)(2), (3)), G3900 (sections 263(g)(4)(A), 263(h)(6): (h)
// applies before (g)), G3901 (section 263(g)(4)(B): (g) applies after sections 1277 and 1282), G3902 (section 280G(d)(4): present value at 120 percent of the
// applicable Federal rate compounded semiannually).
//
// G4400. The components of a sold item are case facts with their income; the related-party test is applied to EACH component (`component_related_sale_lacks_foreign_use_250b5c`);
// an item with components is no longer judged as a whole (the rule of module stage2c gets a `not_known` guard); the foreign-derived income of the item is the sum of the
// income of the components that pass.
// G4401. The affiliated group is derived over the ownership relation of module stage2c (more than 50 percent of vote and value) from a common parent in a bounded chain of
// THREE levels below the parent; NO corporation is excluded: the exclusions of section 1504(b)(2) (insurance companies) and (b)(3) (foreign corporations) are disregarded
// by construction (there is no exclusion rule to disregard), which the scenarios show with a foreign subsidiary at the second level. A deeper chain is outside the bound.
// G3900/G3901. The order of application is a chain: the amounts that (h) disallows for a short sale and the interest deferred by section 1277 or 1282 (an asserted
// amount: EXTERNAL_DEPENDENCY on the owner of those sections, whose outputs are keyed to debt instruments) are removed from the amounts to which (g) applies
// (`straddle_prior_reductions_263g4`, read by the excess rule of module 263). JUDGMENT CALL: the removal is from the (2)(A) sum of the property.
// G3902. The present value of a payment that is contingent on the change is `amount / ((1 + s)^k x (1 + s x stub/182.5))`, s = 120 percent of the applicable Federal rate / 2
// (a case fact per corporation: the rate of section 1274(d) is published, not derived), k the whole six-month periods between the change and the payment (table 0..40, by
// add_calendar_period), stub the days after them (simple interest for the part-period: JUDGMENT CALL; the half-year is 182.5 days); the factor by binary exponentiation
// unrolled to 6 bits, each product rounded to 12 places HALF_UP. A payment more than 20 years after the change is outside the bound.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

use self::{
    Corporation,
    IRC_S250_B,
    IRC_S263_G,
    IRC_S280G_D,
    Person,
    TaxableYear,
    change_in_ownership_or_control_date,
    payment_contingent_on_change_in_control,
    present_value_of_payment,
    related_party_by_ownership_250b5d,
    sale_to_related_party_not_united_states_person_250,
    short_sale_payment_disallowed_263h,
    straddle_interest_on_debt_to_carry_property,
};

// ===================== G4400 =====================

pub relation sold_property_component_250(c: Corporation, y: TaxableYear, item: Integer, comp: Integer) kind empirical {
    label en official "the property sold in the item is treated as a sale of each of its components (section 250(b)(5)(C)(i), last sentence): a component of the property — case fact";
}
pub relation component_income_250(c: Corporation, y: TaxableYear, item: Integer, comp: Integer, amount: Money) kind empirical {
    label en official "the income of the item attributable to the component — case fact";
}
pub relation component_ultimately_sold_or_used_for_unrelated_non_us_person_250(c: Corporation, y: TaxableYear, item: Integer, comp: Integer) kind empirical {
    label en official "the component is ultimately sold by a related party, or used by a related party in connection with property which is sold or the provision of services, to an unrelated party who is not a United States person (section 250(b)(5)(C)(i)(I))";
}
pub relation item_has_components_250(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "components of the item are supplied (bridge)";
}
@source(IRC_S250_B, quote = "For purposes of this clause, a sale of property shall be treated as a sale of each of the components thereof.")
rule ItemHasComponents250(c: Corporation, y: TaxableYear, item: Integer, comp: Integer) strict {
    label en official "bridge for the absence test";
    when sold_property_component_250(c, y, item, comp);
    then item_has_components_250(c, y, item);
}
pub relation component_related_sale_lacks_foreign_use_250b5c(c: Corporation, y: TaxableYear, item: Integer, comp: Integer) kind institutional {
    label en official "a sale of the component to a related non-United States person is not for a foreign use without the ultimate sale of the component to an unrelated non-United States person";
}
@source(IRC_S250_B, quote = "For purposes of this clause, a sale of property shall be treated as a sale of each of the components thereof.")
rule ComponentRelatedSaleLacksForeignUse250(c: Corporation, y: TaxableYear, item: Integer, comp: Integer) strict {
    label en official "the test of (C)(i) applied to each component";
    when sale_to_related_party_not_united_states_person_250(c, y, item);
    when sold_property_component_250(c, y, item, comp);
    when not_known(component_ultimately_sold_or_used_for_unrelated_non_us_person_250(c, y, item, comp));
    then component_related_sale_lacks_foreign_use_250b5c(c, y, item, comp);
}
pub relation foreign_use_component_income_250(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the income of the item attributable to the components that are not barred by the related-party rule of (C)(i)";
}
@source(IRC_S250_B, quote = "For purposes of this clause, a sale of property shall be treated as a sale of each of the components thereof.")
rule ForeignUseComponentIncome250(c: Corporation, y: TaxableYear, item: Integer, comp0: Integer) strict {
    label en official "sum of the component incomes that pass";
    when sold_property_component_250(c, y, item, comp0);
    then foreign_use_component_income_250(c, y, item, sum(collect all a: Money, k: Integer where component_income_250(c, y, item, k, a) and not_known(component_related_sale_lacks_foreign_use_250b5c(c, y, item, k)), empty: 0.00 USD));
}

// ===================== G4401 =====================

pub relation common_parent_250b5d(root: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is the common parent of an affiliated group of section 1504(a) determined with more than 50 percent for at least 80 percent (section 250(b)(5)(D)(i)) — case fact";
}
pub relation group_level_1_250b5d(root: Corporation, m: Corporation, y: TaxableYear) kind institutional {
    label en official "a corporation directly owned to more than 50 percent (vote and value) by the common parent";
}
@source(IRC_S250_B, quote = "(ii) without regard to paragraphs (2) and (3) of section 1504(b).")
rule GroupLevel1250b5d(root: Corporation, m: Corporation, y: TaxableYear) strict {
    label en official "level 1 of the chain of includible corporations (section 1504(a)(1)(B) with more than 50 percent), no corporation excluded by section 1504(b)(2), (3)";
    when common_parent_250b5d(root, y);
    when related_party_by_ownership_250b5d(root, m, y);
    then group_level_1_250b5d(root, m, y);
}
pub relation group_level_2_250b5d(root: Corporation, m: Corporation, y: TaxableYear) kind institutional {
    label en official "a corporation owned to more than 50 percent by a level 1 corporation";
}
@source(IRC_S250_B, quote = "(ii) without regard to paragraphs (2) and (3) of section 1504(b).")
rule GroupLevel2250b5d(root: Corporation, m1: Corporation, m: Corporation, y: TaxableYear) strict {
    label en official "level 2";
    when group_level_1_250b5d(root, m1, y);
    when related_party_by_ownership_250b5d(m1, m, y);
    then group_level_2_250b5d(root, m, y);
}
pub relation group_level_3_250b5d(root: Corporation, m: Corporation, y: TaxableYear) kind institutional {
    label en official "a corporation owned to more than 50 percent by a level 2 corporation";
}
@source(IRC_S250_B, quote = "(ii) without regard to paragraphs (2) and (3) of section 1504(b).")
rule GroupLevel3250b5d(root: Corporation, m1: Corporation, m: Corporation, y: TaxableYear) strict {
    label en official "level 3";
    when group_level_2_250b5d(root, m1, y);
    when related_party_by_ownership_250b5d(m1, m, y);
    then group_level_3_250b5d(root, m, y);
}
pub relation group_member_250b5d(root: Corporation, m: Corporation, y: TaxableYear) kind institutional {
    label en official "a member of the affiliated group of the common parent: the parent or a corporation at level 1, 2 or 3 (the exclusions of section 1504(b)(2), (3) disregarded)";
}
@source(IRC_S250_B, quote = "(ii) without regard to paragraphs (2) and (3) of section 1504(b).")
rule GroupMemberParent250b5d(root: Corporation, y: TaxableYear) strict {
    label en official "the common parent";
    when common_parent_250b5d(root, y);
    then group_member_250b5d(root, root, y);
}
rule GroupMemberLevel1250b5d(root: Corporation, m: Corporation, y: TaxableYear) strict { label en official "level 1"; when group_level_1_250b5d(root, m, y); then group_member_250b5d(root, m, y); }
rule GroupMemberLevel2250b5d(root: Corporation, m: Corporation, y: TaxableYear) strict { label en official "level 2"; when group_level_2_250b5d(root, m, y); then group_member_250b5d(root, m, y); }
rule GroupMemberLevel3250b5d(root: Corporation, m: Corporation, y: TaxableYear) strict { label en official "level 3"; when group_level_3_250b5d(root, m, y); then group_member_250b5d(root, m, y); }
pub relation related_within_group_250b5d(a: Corporation, b: Corporation, y: TaxableYear) kind institutional {
    label en official "two corporations that are members of the same affiliated group of section 250(b)(5)(D)";
}
@source(IRC_S250_B, quote = "(ii) without regard to paragraphs (2) and (3) of section 1504(b).")
rule RelatedWithinGroup250b5d(root: Corporation, a: Corporation, b: Corporation, y: TaxableYear) strict {
    label en official "a and b are members of the group of a common parent";
    when group_member_250b5d(root, a, y);
    when group_member_250b5d(root, b, y);
    then related_within_group_250b5d(a, b, y);
}

// ===================== G3900 / G3901 =====================

pub relation straddle_property_is_short_sale_263g4(prop: Integer, sale: Integer) kind empirical {
    label en official "the personal property that is part of the straddle is the short sale (section 263(g)(4)(A), (h)(6)) — case fact";
}
pub relation interest_deferred_under_1277_or_1282_263g4B(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the interest that section 1277 or 1282 defers with respect to the obligation (section 263(g)(4)(B): (g) applies after those sections) — asserted amount, the sections belong to the property transactions package (EXTERNAL_DEPENDENCY)";
}
pub relation straddle_prior_reductions_263g4(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the amounts removed from the carrying amounts of the property before section 263(g) applies: the interest deferred by section 1277 or 1282 and, for a short sale, the payments that section 263(h) disallows";
}
@source(IRC_S263_G, quote = "In the case of any short sale, this subsection shall be applied after subsection (h).")
rule StraddlePriorReductions263g4(p: Person, y: TaxableYear, prop: Integer, a0: Money) defeasible {
    label en official "(h) first for a short sale, sections 1277 and 1282 first for an obligation, then (g)";
    when straddle_interest_on_debt_to_carry_property(p, y, prop, a0);
    then straddle_prior_reductions_263g4(p, y, prop,
        sum(collect all d: Money where interest_deferred_under_1277_or_1282_263g4B(p, y, prop, d), empty: 0.00 USD)
        + sum(collect all x: Money, sa: Integer where straddle_property_is_short_sale_263g4(prop, sa) and short_sale_payment_disallowed_263h(p, y, sa, x), empty: 0.00 USD));
}

// ===================== G3902 =====================

pub relation payment_date_280g(p: Person, corp: Person, item: Integer, on: Date) kind empirical {
    label en official "the date on which the contingent payment is made (after the change) — case fact";
}
pub relation applicable_federal_rate_for_change_280g(corp: Person, rate: Decimal) kind empirical {
    label en official "the applicable Federal rate determined under section 1274(d) for the change date, an annual rate as a fraction (published by the Secretary: EXTERNAL_DEPENDENCY) — case fact";
}
pub relation semiannual_period_reached_280g(p: Person, corp: Person, item: Integer, j: Integer, boundary: Date) kind institutional {
    label en official "the j-th six-month period after the change ends on or before the payment date, at the boundary date";
}
@source(IRC_S280G_D, quote = "Present value shall be determined by using a discount rate equal to 120 percent of the applicable Federal rate (determined under section 1274(d)), compounded semiannually.")
rule SemiannualPeriodReached280gJ1(p: Person, corp: Person, item: Integer, pay: Date, changed: Date) strict {
    label en official "add_calendar_period(change, 6 calendar_month) <= payment date";
    when payment_date_280g(p, corp, item, pay);
    when change_in_ownership_or_control_date(corp, changed);
    when add_calendar_period(changed, 6 calendar_month) <= pay;
    then semiannual_period_reached_280g(p, corp, item, 1, add_calendar_period(changed, 6 calendar_month));
}
@source(IRC_S280G_D, quote = "Present value shall be determined by using a discount rate equal to 120 percent of the applicable Federal rate (determined under section 1274(d)), compounded semiannually.")
rule SemiannualPeriodReached280gJ2(p: Person, corp: Person, item: Integer, pay: Date, changed: Date) strict {
