pub relation present_value_computed_280g(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "the present value of the contingent payment at the change date at 120 percent of the applicable Federal rate compounded semiannually, whole six-month periods compounded, the part-period simple; cents HALF_UP";
}
@source(IRC_S280G_D, quote = "Present value shall be determined by using a discount rate equal to 120 percent of the applicable Federal rate (determined under section 1274(d)), compounded semiannually.")
rule PresentValueComputed280g(p: Person, corp: Person, item: Integer, amount: Money, pay: Date, changed: Date, afr: Decimal) strict {
    label en official "amount / ((1 + s)^k x (1 + s x stub/182.5)), s = 1.2 x AFR / 2";
    when payment_contingent_on_change_in_control(p, corp, item, amount);
    when payment_date_280g(p, corp, item, pay);
    when change_in_ownership_or_control_date(corp, changed);
    when applicable_federal_rate_for_change_280g(corp, afr);
    when pay >= changed;
    then present_value_computed_280g(p, corp, item, div_round(amount,
        (let s: Decimal = div_round(1.2 * afr, 2.0, 12, "HALF_UP") in
         let k: Integer = count(collect all j: Integer, b: Date where semiannual_period_reached_280g(p, corp, item, j, b)) in
         let f1: Decimal = 1.0 + s in let f2: Decimal = round(f1 * f1, 12, "HALF_UP") in let f4: Decimal = round(f2 * f2, 12, "HALF_UP") in let f8: Decimal = round(f4 * f4, 12, "HALF_UP") in let f16: Decimal = round(f8 * f8, 12, "HALF_UP") in let f32: Decimal = round(f16 * f16, 12, "HALF_UP") in
         let g1: Decimal = if k mod 2 >= 1 then f1 else 1.0 in
         let g2: Decimal = round(g1 * (if k mod 4 >= 2 then f2 else 1.0), 12, "HALF_UP") in
         let g3: Decimal = round(g2 * (if k mod 8 >= 4 then f4 else 1.0), 12, "HALF_UP") in
         let g4: Decimal = round(g3 * (if k mod 16 >= 8 then f8 else 1.0), 12, "HALF_UP") in
         let g5: Decimal = round(g4 * (if k mod 32 >= 16 then f16 else 1.0), 12, "HALF_UP") in
         let g6: Decimal = round(g5 * (if k mod 64 >= 32 then f32 else 1.0), 12, "HALF_UP") in
         let last: Date = if k == 0 then changed else max(collect all b2: Date, j2: Integer where semiannual_period_reached_280g(p, corp, item, j2, b2)) in
         round(g6 * (1.0 + s * div_round(days_between(last, pay) * 1.0, 182.5, 12, "HALF_UP")), 12, "HALF_UP")), 2, "HALF_UP"));
}
relation has_present_value_computed_280g(p: Person, corp: Person, item: Integer) kind institutional {
    label en official "bridge for the absence test";
}
rule HasPresentValueComputed280g(p: Person, corp: Person, item: Integer, pv: Money) strict {
    label en official "bridge for the absence test";
    when present_value_computed_280g(p, corp, item, pv);
    then has_present_value_computed_280g(p, corp, item);
}
pub relation present_value_for_280g(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "the present value the section 280G tests read: computed where the payment date and the rate are supplied, else asserted";
}
rule PresentValueFor280gComputed(p: Person, corp: Person, item: Integer, pv: Money) strict {
    label en official "the computed present value";
    when present_value_computed_280g(p, corp, item, pv);
    then present_value_for_280g(p, corp, item, pv);
}
rule PresentValueFor280gAsserted(p: Person, corp: Person, item: Integer, pv: Money) strict {
    label en official "the asserted present value (the earlier channel)";
    when present_value_of_payment(p, corp, item, pv);
    when not_known(has_present_value_computed_280g(p, corp, item));
    then present_value_for_280g(p, corp, item, pv);
}
