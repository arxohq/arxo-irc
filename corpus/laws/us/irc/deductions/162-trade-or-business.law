// Section 162 — Trade or business expenses. Stage 1 (IRC-06), priority section.
//
// Scope of this module (owner's task): (a) ordinary-and-necessary general rule
// as a DECISION-0194 evaluative channel plus (a)(1)-(3) named categories;
// (c) illegal payments (bribes/kickbacks to government officials, other
// illegal payments, medicare/medicaid kickbacks); (e) lobbying and political
// expenditure denial; (f) fines, penalties and other amounts (with the
// restitution/compliance and court-order/taxes-due exceptions); (g) treble
// damages under the antitrust laws; (l) health insurance costs of
// self-employed individuals; (m) $1,000,000 executive compensation limit
// with the covered-employee definition. (b) (cross-reference to section 170),
// (d) (FNMA capital contributions), (h) (state legislators), (i) (repealed),
// (j) (foreign advertising), (k) (stock reacquisition) stay "stage 2" per the
// task's scope list — see coverage row notes.

// --- shared vocabulary ------------------------------------------------------

use self::{
    IRC_S162_A,
    IRC_S162_C,
    IRC_S162_E,
    IRC_S162_F,
    IRC_S162_G,
    IRC_S162_L,
    IRC_S162_M,
    Individual,
    Person,
    TaxableYear,
};

pub enum DeductionKind {
    Section161Allowance;
    Section162TradeOrBusiness;
    Section163Interest;
    Section164Taxes;
    Section165Losses;
    Section166BadDebts;
    Section170Charitable;
    Section172Nol;
    Section179Election;
    Section183NotForProfitDisallowed;
    Section195StartUp;
    Section199AQbi;
    Section213Medical;
    Section217Moving;
    Section219Ira;
    Section221StudentLoanInterest;
    Section223Hsa;
    Section224QualifiedTips;
    Section262PersonalNonDeductible;
    Section274Meals;
    Section280AHomeOffice;
    Section250FddeiNci;
    Section171BondPremium;
    Section196UnusedBusinessCredits;
    Section216TenantStockholder;
    Section173Circulation;
    Section175SoilWater;
    Section176ForeignSubsidiaryEmployees;
    Section180Fertilizer;
    Section181QualifiedProductions;
    Section186Recoveries;
    Section190BarrierRemoval;
    Section192BlackLungTrust;
    Section193TertiaryInjectant;
    Section194Reforestation;
    Section194AWithdrawalLiabilityFund;
    Section198Environmental;
    Section179DEnergyEfficientBuildings;
    Section220ArcherMsa;
    Section174Amortization;
    Section174ADomesticResearch;
    Section197Amortization;
    Section271PoliticalPartyDebts;
    Section273LifeInterestShrinkage;
    Section275NondeductibleTaxes;
    Section276PoliticalEvents;
    Section279AcquisitionInterest;
    Section169PollutionControl;
    Section179BSmallRefiner;
    Section179CRefineryProperty;
    Section179EMineSafety;
    Section266CarryingCharges;
    Section268CropProduction;
    Section174CurrentDeduction;
    Section170StudentMaintenanceExcess;
    Section170TravelExpenses;
    Section170AthleticSeating;
    Section170FractionalGift;
    Section274CForeignTravel;
    Section274LCommuting;
    Section274MLuxuryWater;
    Section274MTravelEducation;
    Section274MAccompanyingPerson;
    Section163AhydoDisqualifiedPortion;
    Section280BDemolition;
    Section280EIllegalDrugTrafficking;
    Section212IncomeProduction;
    Section264LifeInsuranceInterest;
    Section264PolicyIndebtedness;
    Section264ProRataInterest;
    Section265FinancialInstitutionInterest;
    Section267ControlledGroupLoss;
    Section263StraddleCarryingCharges;
    Section263ShortSalePaymentInLieu;
    Section263iForeignIntangibleDrillingCosts;
    Section280CWagesPortion;
    Section280CClinicalTestingPortion;
    Section280CCreditPortion;
    Section280GExcessParachutePayment;
    Section280HExcessApplicableAmounts;
    Section164fSelfEmploymentTax;
}

// §162(a): ordinary and necessary trade or business expenses -----------------
//
// DECISION-0194: "ordinary and necessary" is an evaluative element. The
// authority the text itself names for what is "ordinary and necessary" is
// judicial gloss, not a named officer — modelled as an `external judgment
// relation` with authority `TaxCourt` (the body whose readings of the phrase
// govern in a dispute; the Secretary makes no delegated determination under
// this subsection).

pub relation carrying_on_trade_or_business(p: Person, y: TaxableYear) kind empirical {
    label en official "carrying on a trade or business during the taxable year (section 162(a))";
}
pub relation expense_paid_or_incurred(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid or incurred during the taxable year in connection with an item asserted to be a trade or business expense (section 162(a))";
}

external judgment relation ordinary_and_necessary(p: Person, y: TaxableYear, item: Integer) {
    authority TaxCourt;
    label en official "the expense is an ordinary and necessary expense of carrying on the trade or business (section 162(a))";
}

pub relation deduction_allowed(p: Person, y: TaxableYear, kind: DeductionKind, amount: Money) kind institutional {
    label en official "a deduction allowed under chapter 1, by section and item";
}

@source(IRC_S162_A, quote = "There shall be allowed as a deduction all the ordinary and necessary expenses paid or incurred during the taxable year in carrying on any trade or business")
rule TradeOrBusinessExpenseAllowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "an ordinary and necessary trade or business expense is allowed as a deduction (section 162(a))";
    when carrying_on_trade_or_business(p, y);
    when expense_paid_or_incurred(p, y, item, amount);
    when ordinary_and_necessary(p, y, item);
    then deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
// unknown "ordinary and necessary" is NEITHER, per DECISION-0194: no rule
// concludes disallowance from `not_known(ordinary_and_necessary(...))` —
// absence of the judgment leaves the deduction UNDETERMINED, not denied.

// §162(a)(1)-(3): named categories are NOT independent grounds of deduction —
// each is introduced by "including", i.e. illustrations of what can satisfy
// the ordinary-and-necessary test, not a separate allowance. Modelled as
// CLASSIFICATION helpers a case may use to argue `ordinary_and_necessary`,
// not as their own `deduction_allowed` rule (would double the allowance).

pub relation reasonable_allowance_for_compensation(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a reasonable allowance for salaries or other compensation for personal services actually rendered (section 162(a)(1))";
}
pub relation traveling_expense_away_from_home(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "traveling expenses, including meals and lodging not lavish or extravagant, while away from home in the pursuit of a trade or business (section 162(a)(2))";
}
pub relation rental_or_condition_of_use_payment(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "rentals or other payments required as a condition to continued use or possession of property to which the taxpayer holds no title or equity (section 162(a)(3))";
}
// Each of the three is a positive fact pattern a scenario may assert
// alongside (or in lieu of directly asserting) `ordinary_and_necessary`;
// this stage does not wire an automatic "named category implies ordinary and
// necessary" rule because the statute does not say the category is
// SUFFICIENT (a salary can still be unreasonable, travel can still be
// lavish) — INTERPRETATION, recorded in the coverage row.

// --- §162(c): illegal bribes, kickbacks, and other payments ------------------

pub relation illegal_bribe_or_kickback_to_government_official(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a payment, directly or indirectly, to an official or employee of a government (or agency/instrumentality), that constitutes an illegal bribe or kickback, or (for a foreign official) is unlawful under the Foreign Corrupt Practices Act of 1977 (section 162(c)(1))";
}
pub relation other_illegal_payment_under_law_generally_enforced(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a payment, directly or indirectly, to any person that constitutes an illegal bribe, illegal kickback, or other illegal payment under a U.S. law or a generally-enforced State law, subjecting the payor to a criminal penalty or loss of a license or privilege to engage in a trade or business (section 162(c)(2))";
}
pub relation medicare_medicaid_kickback(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a kickback, rebate, or bribe by a provider of services, supplier, physician or other person furnishing items or services paid under the Social Security Act or a State plan approved under it, made in connection with furnishing such items/services or the payment for them (section 162(c)(3))";
}

@source(IRC_S162_C, quote = "No deduction shall be allowed under subsection (a) for any payment made, directly or indirectly, to an official or employee of any government")
rule NoDeductionIllegalPaymentToGovernmentOfficial(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for an illegal bribe or kickback to a government official or employee (section 162(c)(1))";
    when illegal_bribe_or_kickback_to_government_official(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
@source(IRC_S162_C, quote = "No deduction shall be allowed under subsection (a) for any payment (other than a payment described in paragraph (1)) made, directly or indirectly, to any person, if the payment constitutes an illegal bribe, illegal kickback, or other illegal payment")
rule NoDeductionOtherIllegalPayment(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for another illegal payment under a U.S. or generally-enforced State law that carries a criminal penalty or license/privilege loss (section 162(c)(2))";
    when other_illegal_payment_under_law_generally_enforced(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
@source(IRC_S162_C, quote = "No deduction shall be allowed under subsection (a) for any kickback, rebate, or bribe made by any provider of services, supplier, physician, or other person who furnishes items or services for which payment is or may be made under the Social Security Act")
rule NoDeductionMedicareMedicaidKickback(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for a medicare/medicaid kickback, rebate, or bribe (section 162(c)(3))";
    when medicare_medicaid_kickback(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
// The section 162(c)(1) burden-of-proof sentence ("The burden of proof...
// shall be upon the Secretary...") is an evidentiary-allocation rule the
// language does not model (no `burden_of_proof` construct) — TECH_GAP,
// recorded in the coverage row and TECH-GAPS.md.

// --- §162(e): lobbying and political expenditures ----------------------------

pub enum LobbyingExpenditureKind {
    InfluencingLegislation;                 // (e)(1)(A)
    PoliticalCampaignParticipation;         // (e)(1)(B)
    InfluencingGeneralPublic;               // (e)(1)(C)
    DirectCommunicationCoveredExecutive;    // (e)(1)(D)
}
pub relation lobbying_or_political_expenditure(p: Person, y: TaxableYear, item: Integer, kind: LobbyingExpenditureKind, amount: Money) kind empirical {
    label en official "an amount paid or incurred in connection with one of the four section 162(e)(1) lobbying/political categories";
}

@source(IRC_S162_E, quote = "No deduction shall be allowed under subsection (a) for any amount paid or incurred in connection with")
rule NoDeductionLobbyingOrPoliticalExpenditure(p: Person, y: TaxableYear, item: Integer, kind: LobbyingExpenditureKind, amount: Money) strict {
    label en official "no deduction for a lobbying or political-campaign expenditure described in section 162(e)(1)";
    when lobbying_or_political_expenditure(p, y, item, kind, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

pub relation tax_exempt_organization_dues_allocable_to_lobbying(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the portion of dues paid to a tax-exempt organization that the organization notifies the taxpayer, under section 6033(e)(1)(A)(ii), is allocable to lobbying expenditures (section 162(e)(2))";
}
@source(IRC_S162_E, quote = "No deduction shall be allowed under subsection (a) for the portion of dues or other similar amounts paid by the taxpayer to an organization which is exempt from tax under this subtitle which the organization notifies the taxpayer")
rule NoDeductionLobbyingDuesPortion(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for the portion of tax-exempt-organization dues allocable to lobbying (section 162(e)(2))";
    when tax_exempt_organization_dues_allocable_to_lobbying(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
// (e)(3) definitions ("influencing legislation", cross-referencing section
// 4911(e)(2) for "legislation") are DEFINITIONs a scenario asserts through
// `LobbyingExpenditureKind` classification directly; (e)(4) de minimis
// ($2,000 in-house expenditure exception) and (e)(5) "covered executive
// branch official" enumeration stay "stage 2" (not named in the task's
// priority list for section 162(e)) — coverage rows record them as
// unreviewed with note "stage 2", not silently folded into the (e)(1) rule.

// --- §162(f): fines, penalties, and other amounts -----------------------------

pub relation payment_to_government_re_law_violation(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid or incurred (by suit, agreement, or otherwise) to or at the direction of a government or governmental entity in relation to the violation of any law, or its investigation/inquiry into a potential violation (section 162(f)(1))";
}
pub relation established_restitution_or_compliance_payment(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer establishes the amount constitutes restitution (including remediation of property) or is paid to come into compliance with the violated/investigated law (section 162(f)(2)(A)(i))";
}
pub relation identified_as_restitution_or_compliance_in_order(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is identified as restitution or as an amount paid to come into compliance in the court order or settlement agreement (section 162(f)(2)(A)(ii))";
}
pub relation reimbursement_of_investigation_or_litigation_costs(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is paid or incurred as reimbursement to the government or entity for the costs of investigation or litigation (section 162(f)(2)(B) limitation)";
}
pub relation court_order_no_government_party(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is paid or incurred by reason of a court order in a suit in which no government or governmental entity is a party (section 162(f)(3))";
}
pub relation amount_paid_as_taxes_due(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is paid or incurred as taxes due (section 162(f)(4))";
}

@source(IRC_S162_F, quote = "no deduction otherwise allowable shall be allowed under this chapter for any amount paid or incurred (whether by suit, agreement, or otherwise) to, or at the direction of, a government or governmental entity in relation to the violation of any law")
rule NoDeductionGovernmentLawViolationPayment(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for an amount paid to/at the direction of a government in relation to a law violation, unless a section 162(f)(2)-(4) exception applies";
    when payment_to_government_re_law_violation(p, y, item, amount);
    when not_known(established_restitution_or_compliance_payment(p, y, item));
    when not_known(court_order_no_government_party(p, y, item));
    when not_known(amount_paid_as_taxes_due(p, y, item));
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

@source(IRC_S162_F, quote = "Paragraph (1) shall not apply to any amount that")
rule RestitutionOrComplianceExceptionApplies(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the section 162(f)(1) disallowance does not apply to an amount established as restitution or a compliance payment, identified as such in the order/agreement, and not reimbursement of investigation/litigation costs (section 162(f)(2))";
    when payment_to_government_re_law_violation(p, y, item, amount);
    when established_restitution_or_compliance_payment(p, y, item);
    when identified_as_restitution_or_compliance_in_order(p, y, item);
    when not_known(reimbursement_of_investigation_or_litigation_costs(p, y, item));
    when carrying_on_trade_or_business(p, y);
    when ordinary_and_necessary(p, y, item);
    then deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

@source(IRC_S162_F, quote = "Paragraph (1) shall not apply to any amount paid or incurred by reason of any order of a court in a suit in which no government or governmental entity is a party")
rule CourtOrderNoGovernmentPartyExceptionApplies(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the section 162(f)(1) disallowance does not apply to an amount paid by reason of a court order in a suit with no government party (section 162(f)(3))";
    when payment_to_government_re_law_violation(p, y, item, amount);
    when court_order_no_government_party(p, y, item);
    when carrying_on_trade_or_business(p, y);
    when ordinary_and_necessary(p, y, item);
    then deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

@source(IRC_S162_F, quote = "Paragraph (1) shall not apply to any amount paid or incurred as taxes due")
rule TaxesDueExceptionApplies(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the section 162(f)(1) disallowance does not apply to an amount paid as taxes due (section 162(f)(4))";
    when payment_to_government_re_law_violation(p, y, item, amount);
    when amount_paid_as_taxes_due(p, y, item);
    when carrying_on_trade_or_business(p, y);
    when ordinary_and_necessary(p, y, item);
    then deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
// §162(f)(5) (nongovernmental self-regulatory entities treated as
// governmental) is a DEFINITION extending "government" for (f) purposes —
// modelled as a case-asserted premise of `payment_to_government_re_law_
// violation` itself (the scenario decides whether the payee is such an
// entity), not a separate rule, per the same economy `s63` used for local
// definitions that only gate an existing predicate.

// --- §162(g): treble damage payments under the antitrust laws -----------------

pub relation antitrust_conviction_or_plea(p: Person, y: TaxableYear) kind empirical {
    label en official "in a criminal proceeding, the taxpayer is convicted of a violation of the antitrust laws, or a plea of guilty or nolo contendere to such a charge is entered or accepted (section 162(g))";
}
pub relation antitrust_damages_or_settlement_payment(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid or incurred on a Clayton Act section 4 judgment for damages, or in settlement of a Clayton Act section 4 action, on account of the convicted (or a related) antitrust violation (section 162(g)(1)-(2))";
}

@source(IRC_S162_G, quote = "no deduction shall be allowed under subsection (a) for two-thirds of any amount paid or incurred")
rule TrebleDamagesTwoThirdsDisallowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "two-thirds of an antitrust treble-damages payment or settlement is not deductible, following an antitrust conviction or accepted plea (section 162(g))";
    when antitrust_conviction_or_plea(p, y);
    when antitrust_damages_or_settlement_payment(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, div_round(amount * 2, 3.0, 2, "HALF_UP"));
}
// "Two-thirds" is taken exactly: `div_round` divides the exact product
// `amount * 2` by 3 and rounds ONCE (§50/§58, errata E-0036). Former
// `round(amount * 0.6667, …)` gave 20001 USD on 30000 USD instead of 20000.
// JUDGMENT CALL: the statute names no rounding; cents HALF_UP is the corpus
// convention for a Money result the statute leaves unrounded (TECH-GAPS G11).

// --- §162(l): health insurance costs of self-employed individuals ------------

pub relation self_employed_within_401c1(p: Individual, y: TaxableYear) kind institutional {
    label en official "an employee within the meaning of section 401(c)(1) (self-employed individual), for section 162(l) purposes — dependency contract, producer: unresolved (section 401 pending)";
}
pub relation medical_care_insurance_premium_paid(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amount paid during the taxable year for insurance which constitutes medical care for the taxpayer, spouse, dependents, or an under-27 child (section 162(l)(1))";
}
pub relation earned_income_from_the_business_401c(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxpayer's earned income (within the meaning of section 401(c)) derived from the trade or business with respect to which the medical care plan is established (section 162(l)(2)(A)) — dependency contract, producer: unresolved (section 401 pending)";
}
pub relation eligible_for_subsidized_employer_health_plan(p: Individual, y: TaxableYear) kind empirical {
    label en official "eligible to participate in a subsidized health plan maintained by an employer of the taxpayer, spouse, or a dependent/under-27-child, for the calendar month (section 162(l)(2)(B))";
}

@source(IRC_S162_L, quote = "there shall be allowed as a deduction under this section an amount equal to the amount paid during the taxable year for insurance which constitutes medical care")
rule SelfEmployedHealthInsuranceDeductionAllowed(p: Individual, y: TaxableYear, premium: Money, earned: Money) strict {
    label en official "a self-employed individual may deduct health insurance premiums up to earned income from the business, absent eligibility for a subsidized employer plan (section 162(l)(1)-(2))";
    when self_employed_within_401c1(p, y);
    when medical_care_insurance_premium_paid(p, y, premium);
    when earned_income_from_the_business_401c(p, y, earned);
    when premium <= earned;
    when not_known(eligible_for_subsidized_employer_health_plan(p, y));
    then deduction_allowed(p, y, Section162TradeOrBusiness, premium);
}
@source(IRC_S162_L, quote = "No deduction shall be allowed under paragraph (1) to the extent that the amount of such deduction exceeds the taxpayer's earned income")
rule SelfEmployedHealthInsuranceDeductionCappedAtEarnedIncome(p: Individual, y: TaxableYear, premium: Money, earned: Money) strict {
    label en official "the section 162(l) deduction is capped at earned income from the business when the premium exceeds it (section 162(l)(2)(A))";
    when self_employed_within_401c1(p, y);
    when medical_care_insurance_premium_paid(p, y, premium);
    when earned_income_from_the_business_401c(p, y, earned);
    when premium > earned;
    when not_known(eligible_for_subsidized_employer_health_plan(p, y));
    then deduction_allowed(p, y, Section162TradeOrBusiness, earned);
}
@source(IRC_S162_L, quote = "Paragraph (1) shall not apply to any taxpayer for any calendar month for which the taxpayer is eligible to participate in any subsidized health plan")
rule SelfEmployedHealthInsuranceDeductionDeniedWhenSubsidizedPlanAvailable(p: Individual, y: TaxableYear, premium: Money) strict {
    label en official "no section 162(l) deduction for a month in which the taxpayer is eligible for a subsidized employer health plan (section 162(l)(2)(B))";
    when self_employed_within_401c1(p, y);
    when medical_care_insurance_premium_paid(p, y, premium);
    when eligible_for_subsidized_employer_health_plan(p, y);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, premium);
}
// (l)(2)(C) long-term care premium limitation, (l)(3) coordination with
// section 213(a), (l)(4) self-employment-tax carve-out, (l)(5) S corporation
// shareholder treatment stay "stage 2" (not named in the task's priority
// list beyond the core allowance/limitation) — coverage rows record each.

// --- §162(m): certain excessive employee remuneration -------------------------

pub relation publicly_held_corporation(c: us.irc.core::Corporation, y: TaxableYear) kind institutional {
    label en official "an issuer (Securities Exchange Act of 1934 section 3) whose securities are required to be registered under section 12 of that Act, or that is required to file reports under section 15(d) of that Act (section 162(m)(2))";
}
pub relation is_principal_executive_or_financial_officer(e: Person, c: us.irc.core::Corporation, y: TaxableYear) kind empirical {
    label en official "the employee is (or acted as) the principal executive officer or principal financial officer of the corporation at any time during the taxable year (section 162(m)(3)(A))";
}
pub relation among_three_highest_compensated_reported_officers(e: Person, c: us.irc.core::Corporation, y: TaxableYear) kind empirical {
    label en official "the total compensation of the employee is required to be reported to shareholders under the Securities Exchange Act of 1934 by reason of the employee being among the 3 highest compensated officers for the taxable year, other than a section 162(m)(3)(A) individual (section 162(m)(3)(B))";
}
pub relation was_covered_employee_in_preceding_year_after_2016(e: Person, c: us.irc.core::Corporation, y: TaxableYear) kind institutional {
    label en official "the employee was a covered employee described in section 162(m)(3)(A) or (B) of the taxpayer (or a predecessor) for a preceding taxable year beginning after December 31, 2016 (section 162(m)(3)(D))";
}
pub relation covered_employee(e: Person, c: us.irc.core::Corporation, y: TaxableYear) kind institutional {
    label en official "a covered employee for purposes of section 162(m) (section 162(m)(3))";
}
pub relation applicable_employee_remuneration(e: Person, c: us.irc.core::Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate amount otherwise allowable as a deduction under chapter 1 for the taxable year (determined without regard to section 162(m)) for remuneration for services performed by the covered employee (section 162(m)(4)(A))";
}

@source(IRC_S162_M)
const Section162mDollarLimit: Money = 1000000.00 USD {
    label en official "section 162(m)(1): $1,000,000, unindexed statutory dollar limit on deductible applicable employee remuneration per covered employee";
}

@source(IRC_S162_M, quote = "such employee is the principal executive officer or principal financial officer of the taxpayer at any time during the taxable year, or was an individual acting in such a capacity")
rule CoveredEmployeePrincipalOfficer(e: Person, c: us.irc.core::Corporation, y: TaxableYear) strict {
    label en official "a principal executive or financial officer (or acting as one) is a covered employee (section 162(m)(3)(A))";
    when publicly_held_corporation(c, y);
    when is_principal_executive_or_financial_officer(e, c, y);
    then covered_employee(e, c, y);
}
@source(IRC_S162_M, quote = "the total compensation of such employee for the taxable year is required to be reported to shareholders under the Securities Exchange Act of 1934 by reason of such employee being among the 3 highest compensated officers")
rule CoveredEmployeeThreeHighestCompensated(e: Person, c: us.irc.core::Corporation, y: TaxableYear) strict {
    label en official "one of the 3 highest compensated reported officers (other than a principal executive/financial officer) is a covered employee (section 162(m)(3)(B))";
    when publicly_held_corporation(c, y);
    when among_three_highest_compensated_reported_officers(e, c, y);
    when not is_principal_executive_or_financial_officer(e, c, y);
    then covered_employee(e, c, y);
}
@source(IRC_S162_M, quote = "was a covered employee described in subparagraph (A) or (B) of the taxpayer (or any predecessor) for any preceding taxable year beginning after December 31, 2016")
rule CoveredEmployeeOnceCoveredAlwaysCovered(e: Person, c: us.irc.core::Corporation, y: TaxableYear) strict {
    label en official "once a covered employee under (A) or (B) for a taxable year beginning after December 31, 2016, always a covered employee thereafter (section 162(m)(3)(D))";
    when publicly_held_corporation(c, y);
    when was_covered_employee_in_preceding_year_after_2016(e, c, y);
    then covered_employee(e, c, y);
}

@source(IRC_S162_M, quote = "no deduction shall be allowed under this chapter for applicable employee remuneration with respect to any covered employee to the extent that the amount of such remuneration for the taxable year with respect to such employee exceeds $1,000,000")
rule ExcessiveRemunerationDisallowedAboveOneMillion(e: Person, c: us.irc.core::Corporation, y: TaxableYear, remuneration: Money) strict {
    label en official "no deduction for applicable employee remuneration of a covered employee to the extent it exceeds $1,000,000 for the taxable year (section 162(m)(1))";
    when publicly_held_corporation(c, y);
    when covered_employee(e, c, y);
    when applicable_employee_remuneration(e, c, y, remuneration);
    when remuneration > round(Section162mDollarLimit, 2, "HALF_UP");
    then not deduction_allowed(c, y, Section162TradeOrBusiness, remuneration - round(Section162mDollarLimit, 2, "HALF_UP"));
}
// (m)(4)(B)-(F) (binding-contract exception, remuneration definition
// carve-outs, coordination with sections 280G/4985, beneficiary rule),
// (m)(5)-(6) (TARP and health-insurer special rules), and the Pub. L. 119-21
// section 70603 controlled-group aggregation amendment stay "stage 2" — the
// task named only the $1,000,000 limit and the covered-employee definition
// as priority; the controlled-group amendment is recorded as a SOURCE_GAP
// row (amendment not carried into a revision this stage).
