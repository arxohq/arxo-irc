// Section 168 — stage 2c detail (TECH_GAPS G2790-G2806 range for section 168, coordinator stage 2c):
// (b)(1)(B) the switch to the straight line method, (b)(2)(B) and (b)(3) the straight-line classes,
// (c) the four real-property classes, (k)(1)(B) the basis reduction, (k)(2) the derivation of qualified
// property ((A) to (H)), (k)(5) specified plants, (k)(6)(B),(C) and (k)(8) the sub-schedules, (k)(9) the
// exceptions and (k)(10) the elections in both editions.
//
// Stage 1 interface changes (recorded): `qualified_property_for_bonus_depreciation` is now institutional
// (derived below, or still asserted by a case); the stage 1 default-method rules and the stage 1
// applicable-percentage rules of 168-acrs.law and 168k-bonus-depreciation.law carry extra `unless`
// guards, the permanent-100-percent rule became defeasible so the transitional election can defeat it,
// and the year-1 depreciation rules read `year1_depreciable_basis` (the unadjusted basis less the bonus
// allowance) instead of `unadjusted_depreciable_basis`.
//
// JUDGMENT CALLS: (1) the years after the first use the full-year rate (the half-year convention and
// the last-year rule are not repeated); (2) the beginning-of-year adjusted basis and the remaining
// recovery years are facts of the case (a multi-year schedule would be self-recursive, LDC-E4102);
// (3) "property described in subparagraph (B) or (C)" is read as property that meets those
// subparagraphs, whether or not it also meets (A); (4) the date treated as the placed-in-service date by
// the syndication rule is derived as a separate relation and is used for the (A)(iii) test, while the
// applicable-percentage rules keep reading the placed-in-service date of the case; (5) amounts are
// rounded to cents HALF_UP.

// === (c): the four real-property classes ===================================================================

use self::{
    ApplicableDepreciationMethod,
    Asset,
    IRC_S168_B,
    IRC_S168_K,
    IRC_S168_TABLE_1,
    Person,
    QualifiedProductionKind,
    RecoveryPropertyClass,
    TaxableYear,
    applicable_depreciation_method,
    applicable_recovery_period_years,
    bonus_depreciation,
    bonus_depreciation_applicable_percentage,
    bonus_depreciation_governed_by_pl119_21_permanent_expensing,
    bonus_depreciation_property_acquired_on,
    bonus_depreciation_property_placed_in_service_on,
    elects_straight_line_method_168b,
    placed_in_service_year,
    property_classified_as,
    qualified_production_181,
    qualified_property_for_bonus_depreciation,
    unadjusted_depreciable_basis,
};

@source(IRC_S168_TABLE_1, quote = "Water utility property / 25 years")
rule RecoveryPeriodWaterUtility(p: Person, a: Asset) strict {
    label en official "water utility property has a 25-year applicable recovery period (section 168(c), table T1)";
    when property_classified_as(p, a, WaterUtilityPropertyClass);
    then applicable_recovery_period_years(p, a, 25.0);
}
@source(IRC_S168_TABLE_1, quote = "Residential rental property / 27.5 years")
rule RecoveryPeriodResidentialRental(p: Person, a: Asset) strict {
    label en official "residential rental property has a 27.5-year applicable recovery period (section 168(c), table T1)";
    when property_classified_as(p, a, ResidentialRentalPropertyClass);
    then applicable_recovery_period_years(p, a, 27.5);
}
@source(IRC_S168_TABLE_1, quote = "Nonresidential real property / 39 years.")
rule RecoveryPeriodNonresidentialReal(p: Person, a: Asset) strict {
    label en official "nonresidential real property has a 39-year applicable recovery period (section 168(c), table T1)";
    when property_classified_as(p, a, NonresidentialRealPropertyClass);
    then applicable_recovery_period_years(p, a, 39.0);
}
@source(IRC_S168_TABLE_1, quote = "Any railroad grading or tunnel bore / 50 years.")
rule RecoveryPeriodRailroadGrading(p: Person, a: Asset) strict {
    label en official "a railroad grading or tunnel bore has a 50-year applicable recovery period (section 168(c), table T1)";
    when property_classified_as(p, a, RailroadGradingOrTunnelBoreClass);
    then applicable_recovery_period_years(p, a, 50.0);
}

// === (b)(2)(B), (b)(3): the straight-line and 150-percent classes ============================================

pub relation asset_is_qualified_improvement_property_168e6(a: Asset) kind empirical {
    label en official "the property is qualified improvement property described in section 168(e)(6)";
}
pub relation property_is_water_utility_property_168e5(a: Asset) kind empirical {
    label en official "the property is water utility property described in section 168(e)(5)";
}
pub relation property_described_in_168e3Dii(a: Asset) kind empirical {
    label en official "the property is described in section 168(e)(3)(D)(ii)";
}
pub relation property_is_qualified_smart_electric_meter_or_grid_system(p: Person, a: Asset) kind empirical {
    label en official "the property is a qualified smart electric meter or qualified smart electric grid system (section 168(i)(18),(19)); the definitions are not pinned, so the classification is a fact of the case";
}
pub relation mandatory_straight_line_property(p: Person, a: Asset) kind institutional {
    label en official "the property is one of the classes to which the straight line method applies by law (section 168(b)(3)(A),(B),(C),(E),(F),(G))";
}
@source(IRC_S168_B, quote = "(A) Nonresidential real property.")
rule MandatoryStraightLineNonresidentialReal(p: Person, a: Asset) strict {
    label en official "nonresidential real property (section 168(b)(3)(A))";
    when property_classified_as(p, a, NonresidentialRealPropertyClass);
    then mandatory_straight_line_property(p, a);
}
@source(IRC_S168_B, quote = "(B) Residential rental property.")
rule MandatoryStraightLineResidentialRental(p: Person, a: Asset) strict {
    label en official "residential rental property (section 168(b)(3)(B))";
    when property_classified_as(p, a, ResidentialRentalPropertyClass);
    then mandatory_straight_line_property(p, a);
}
@source(IRC_S168_B, quote = "(C) Any railroad grading or tunnel bore.")
rule MandatoryStraightLineRailroadGrading(p: Person, a: Asset) strict {
    label en official "any railroad grading or tunnel bore (section 168(b)(3)(C))";
    when property_classified_as(p, a, RailroadGradingOrTunnelBoreClass);
    then mandatory_straight_line_property(p, a);
}
@source(IRC_S168_B, quote = "(E) Property described in subsection (e)(3)(D)(ii).")
rule MandatoryStraightLineE3Dii(p: Person, a: Asset, cls: RecoveryPropertyClass) strict {
    label en official "property described in section 168(e)(3)(D)(ii) (section 168(b)(3)(E))";
    when property_described_in_168e3Dii(a);
    when property_classified_as(p, a, cls);
    then mandatory_straight_line_property(p, a);
}
@source(IRC_S168_B, quote = "(F) Water utility property described in subsection (e)(5).")
rule MandatoryStraightLineWaterUtility(p: Person, a: Asset, cls: RecoveryPropertyClass) strict {
    label en official "water utility property described in section 168(e)(5) (section 168(b)(3)(F))";
    when property_is_water_utility_property_168e5(a);
    when property_classified_as(p, a, cls);
    then mandatory_straight_line_property(p, a);
}
@source(IRC_S168_B, quote = "(G) Qualified improvement property described in subsection (e)(6).")
rule MandatoryStraightLineQualifiedImprovement(p: Person, a: Asset, cls: RecoveryPropertyClass) strict {
    label en official "qualified improvement property described in section 168(e)(6) (section 168(b)(3)(G))";
    when asset_is_qualified_improvement_property_168e6(a);
    when property_classified_as(p, a, cls);
    then mandatory_straight_line_property(p, a);
}
@source(IRC_S168_B, quote = "The applicable depreciation method shall be the straight line method in the case of the following property:")
rule ApplicableMethodMandatoryStraightLine(p: Person, a: Asset) strict {
    label en official "the straight line method applies to the classes of paragraph (3)";
    when mandatory_straight_line_property(p, a);
    then applicable_depreciation_method(p, a, StraightLineMethod);
}
@source(IRC_S168_B, quote = "(B) any property (other than property described in paragraph (3)) which is a qualified smart electric meter or qualified smart electric grid system, or")
rule ApplicableMethodSmartElectric150(p: Person, a: Asset, cls: RecoveryPropertyClass) strict {
    label en official "a qualified smart electric meter or grid system not described in paragraph (3) uses the 150 percent declining balance method (section 168(b)(2)(B))";
    when property_is_qualified_smart_electric_meter_or_grid_system(p, a);
    when property_classified_as(p, a, cls);
    when not_known(mandatory_straight_line_property(p, a));
    when not_known(elects_straight_line_method_168b(p, a));
    then applicable_depreciation_method(p, a, DecliningBalance150);
}

// === (b)(1)(B): the switch to the straight line method =======================================================

pub relation adjusted_basis_at_beginning_of_year(p: Person, a: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis of the property as of the beginning of the taxable year (section 168(b)(1)(B)); the multi-year schedule is a fact of the case";
}
pub relation remaining_recovery_years_at_beginning_of_year(p: Person, a: Asset, y: TaxableYear, years: Decimal) kind empirical {
    label en official "the recovery years remaining as of the beginning of the taxable year, the current year included (section 168(b)(1)(B))";
}
pub relation declining_balance_allowance_for_year(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the allowance under the applicable declining balance method for the year: the beginning adjusted basis times the rate over the recovery period (section 168(b)(1)(A),(2))";
}
@source(IRC_S168_B, quote = "(A) the 200 percent declining balance method,")
rule DecliningBalance200AllowanceForYear(p: Person, a: Asset, y: TaxableYear, basis: Money, years: Decimal) defeasible {
    label en official "200 percent: twice the straight-line rate of 1 over the recovery period";
    when applicable_depreciation_method(p, a, DoubleDecliningBalance200);
    when adjusted_basis_at_beginning_of_year(p, a, y, basis);
    when applicable_recovery_period_years(p, a, years);
    then declining_balance_allowance_for_year(p, a, y, div_round(basis * 2.0, years, 2, "HALF_UP"));
}
@source(IRC_S168_B, quote = "Paragraph (1) shall be applied by substituting \"150 percent\" for \"200 percent\" in the case of—")
rule DecliningBalance150AllowanceForYear(p: Person, a: Asset, y: TaxableYear, basis: Money, years: Decimal) defeasible {
    label en official "150 percent: one and a half times the straight-line rate";
    when applicable_depreciation_method(p, a, DecliningBalance150);
    when adjusted_basis_at_beginning_of_year(p, a, y, basis);
    when applicable_recovery_period_years(p, a, years);
    then declining_balance_allowance_for_year(p, a, y, div_round(basis * 1.5, years, 2, "HALF_UP"));
}
pub relation straight_line_allowance_for_year(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the allowance under the straight line method for the year: the beginning adjusted basis over the remaining recovery years (section 168(b)(1)(B),(3))";
}
@source(IRC_S168_B, quote = "(B) switching to the straight line method for the 1st taxable year for which using the straight line method with respect to the adjusted basis as of the beginning of such year will yield a larger allowance.")
rule StraightLineAllowanceForYear(p: Person, a: Asset, y: TaxableYear, basis: Money, remaining: Decimal) defeasible {
    label en official "straight line with respect to the adjusted basis as of the beginning of the year";
    when adjusted_basis_at_beginning_of_year(p, a, y, basis);
    when remaining_recovery_years_at_beginning_of_year(p, a, y, remaining);
    then straight_line_allowance_for_year(p, a, y, div_round(basis, remaining, 2, "HALF_UP"));
}
pub relation switch_to_straight_line_for_year(p: Person, a: Asset, y: TaxableYear) kind institutional {
    label en official "the straight line method yields a larger allowance than the declining balance method for the year, so the switch is made (section 168(b)(1)(B))";
}
@source(IRC_S168_B, quote = "(B) switching to the straight line method for the 1st taxable year for which using the straight line method with respect to the adjusted basis as of the beginning of such year will yield a larger allowance.")
rule SwitchToStraightLineWhenLarger(p: Person, a: Asset, y: TaxableYear, db: Money, sl: Money) defeasible {
    label en official "the switch applies when the straight line allowance exceeds the declining balance allowance";
    when declining_balance_allowance_for_year(p, a, y, db);
    when straight_line_allowance_for_year(p, a, y, sl);
    when sl > db;
    then switch_to_straight_line_for_year(p, a, y);
}
pub relation macrs_allowance_for_year(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the depreciation allowance of a year after the first, from the beginning adjusted basis: the larger of the declining balance and straight line allowances, or the straight line allowance under the straight line method (section 168(a),(b))";
}
@source(IRC_S168_B, quote = "(B) switching to the straight line method for the 1st taxable year for which using the straight line method with respect to the adjusted basis as of the beginning of such year will yield a larger allowance.")
rule MacrsAllowanceDecliningBalanceWithSwitch(p: Person, a: Asset, y: TaxableYear, db: Money, sl: Money) defeasible {
    label en official "the larger of the two allowances (JUDGMENT CALL: full-year rate)";
    when declining_balance_allowance_for_year(p, a, y, db);
    when straight_line_allowance_for_year(p, a, y, sl);
    then macrs_allowance_for_year(p, a, y, max(db, sl));
}
@source(IRC_S168_B, quote = "The applicable depreciation method shall be the straight line method in the case of the following property:")
rule MacrsAllowanceStraightLine(p: Person, a: Asset, y: TaxableYear, sl: Money) defeasible {
    label en official "under the straight line method the allowance is the straight line allowance";
    when applicable_depreciation_method(p, a, StraightLineMethod);
    when straight_line_allowance_for_year(p, a, y, sl);
    then macrs_allowance_for_year(p, a, y, sl);
}

// === (k)(2)(A)(i): the kind of property ======================================================================

pub relation asset_is_computer_software_167f1B_deductible_under_167a(p: Person, a: Asset) kind empirical {
    label en official "the asset is computer software (section 167(f)(1)(B)) for which a deduction is allowable under section 167(a) without regard to subsection (k) (section 168(k)(2)(A)(i)(II))";
}
pub relation bonus_asset_is_181_production(p: Person, a: Asset, production: Integer) kind empirical {
    label en official "the asset is the production identified by the number (section 168(k)(2)(A)(i)(IV),(V))";
}
pub relation production_deductible_under_181_without_limits(production: Integer) kind empirical {
    label en official "a deduction would have been allowable under section 181 without regard to subsections (a)(2) and (g) of that section or subsection (k) (section 168(k)(2)(A)(i)(IV),(V))";
}
pub relation bonus_property_meets_2A_i(p: Person, a: Asset) kind institutional {
    label en official "clause (i) of section 168(k)(2)(A) is met: recovery period of 20 years or less, computer software, water utility property, or a qualified film, television or live theatrical production";
}
@source(IRC_S168_K, quote = "(i)(I) to which this section applies which has a recovery period of 20 years or less,")
rule BonusPropertyRecoveryPeriod20OrLess(p: Person, a: Asset, years: Decimal) strict {
    label en official "property to which section 168 applies with a recovery period of 20 years or less (section 168(k)(2)(A)(i)(I))";
    when applicable_recovery_period_years(p, a, years);
    when years <= 20.0;
    then bonus_property_meets_2A_i(p, a);
}
@source(IRC_S168_K, quote = "(II) which is computer software (as defined in section 167(f)(1)(B)) for which a deduction is allowable under section 167(a) without regard to this subsection,")
rule BonusPropertyComputerSoftware(p: Person, a: Asset) strict {
    label en official "computer software deductible under section 167(a) (section 168(k)(2)(A)(i)(II))";
    when asset_is_computer_software_167f1B_deductible_under_167a(p, a);
    then bonus_property_meets_2A_i(p, a);
}
@source(IRC_S168_K, quote = "(III) which is water utility property, or [2]")
rule BonusPropertyWaterUtility(p: Person, a: Asset) strict {
    label en official "water utility property (section 168(k)(2)(A)(i)(III))";
    when property_classified_as(p, a, WaterUtilityPropertyClass);
    then bonus_property_meets_2A_i(p, a);
}
@source(IRC_S168_K, quote = "(IV) which is a qualified film or television production (as defined in subsection (d) of section 181) for which a deduction would have been allowable under section 181 without regard to subsections (a)(2) and (g) of such section or this subsection, or")
rule BonusPropertyFilmOrTelevision(p: Person, a: Asset, production: Integer) strict {
    label en official "a qualified film or television production (section 168(k)(2)(A)(i)(IV))";
    when bonus_asset_is_181_production(p, a, production);
    when qualified_production_181(p, production, FilmOrTelevision);
    when production_deductible_under_181_without_limits(production);
    then bonus_property_meets_2A_i(p, a);
}
@source(IRC_S168_K, quote = "(V) which is a qualified live theatrical production (as defined in subsection (e) of section 181) for which a deduction would have been allowable under section 181 without regard to subsections (a)(2) and (g) of such section or this subsection,")
rule BonusPropertyLiveTheatrical(p: Person, a: Asset, production: Integer) strict {
    label en official "a qualified live theatrical production (section 168(k)(2)(A)(i)(V))";
    when bonus_asset_is_181_production(p, a, production);
    when qualified_production_181(p, production, LiveTheatrical);
    when production_deductible_under_181_without_limits(production);
    then bonus_property_meets_2A_i(p, a);
}

// === (k)(2)(A)(ii), (E): original use and acquisition =========================================================

pub relation original_use_begins_with_taxpayer(p: Person, a: Asset) kind empirical {
    label en official "the original use of the property begins with the taxpayer (section 168(k)(2)(A)(ii))";
}
pub relation property_not_used_by_taxpayer_before_acquisition(p: Person, a: Asset) kind empirical {
    label en official "the property was not used by the taxpayer at any time prior to the acquisition (section 168(k)(2)(E)(ii)(I))";
}
pub relation acquisition_meets_179d_2ABC_3(p: Person, a: Asset) kind empirical {
    label en official "the acquisition meets the requirements of section 179(d)(2)(A), (2)(B), (2)(C) and (3) (section 168(k)(2)(E)(ii)(II))";
}
pub relation acquisition_meets_168k2Eii(p: Person, a: Asset) kind institutional {
    label en official "the acquisition meets the requirements of section 168(k)(2)(E)(ii)";
}
@source(IRC_S168_K, quote = "(ii) Acquisition requirements")
rule AcquisitionMeets168k2Eii(p: Person, a: Asset) strict {
    label en official "not used by the taxpayer before and the section 179(d) acquisition requirements are met";
    when property_not_used_by_taxpayer_before_acquisition(p, a);
    when acquisition_meets_179d_2ABC_3(p, a);
    then acquisition_meets_168k2Eii(p, a);
}
pub relation bonus_property_meets_2A_ii(p: Person, a: Asset) kind institutional {
    label en official "clause (ii) of section 168(k)(2)(A) is met: original use begins with the taxpayer, or the acquisition meets the (E)(ii) requirements";
}
@source(IRC_S168_K, quote = "(ii) the original use of which begins with the taxpayer or the acquisition of which by the taxpayer meets the requirements of clause (ii) of subparagraph (E), and")
rule BonusPropertyOriginalUse(p: Person, a: Asset) strict {
    label en official "original use begins with the taxpayer (section 168(k)(2)(A)(ii))";
    when original_use_begins_with_taxpayer(p, a);
    then bonus_property_meets_2A_ii(p, a);
}
@source(IRC_S168_K, quote = "(ii) the original use of which begins with the taxpayer or the acquisition of which by the taxpayer meets the requirements of clause (ii) of subparagraph (E), and")
rule BonusPropertyAcquisition(p: Person, a: Asset) strict {
    label en official "the acquisition meets the (E)(ii) requirements (section 168(k)(2)(A)(ii))";
    when acquisition_meets_168k2Eii(p, a);
    then bonus_property_meets_2A_ii(p, a);
}

// --- (E)(iii): syndication ---------------------------------------------------------------------------------------

pub relation lessor_first_use_of_property(p: Person, a: Asset) kind empirical {
    label en official "the property is used by a lessor and that use is the lessor's first use (section 168(k)(2)(E)(iii)(I))";
}
pub relation property_originally_placed_in_service_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the property was originally placed in service (section 168(k)(2)(E)(iii)(II))";
}
pub relation last_sale_date_of_property(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date of the last sale of the property by the lessor or a subsequent purchaser (section 168(k)(2)(E)(iii)(II)); for multiple units, the final unit's period is a fact of the case";
}
pub relation user_after_last_sale_same_as_original(p: Person, a: Asset) kind empirical {
    label en official "the user of the property after the last sale remains the same as when it was originally placed in service (section 168(k)(2)(E)(iii)(III))";
}
pub relation syndication_rule_applies(p: Person, a: Asset) kind institutional {
    label en official "the syndication rule of section 168(k)(2)(E)(iii) applies to the property";
}
@source(IRC_S168_K, quote = "(II) such property is sold by such lessor or any subsequent purchaser within 3 months after the date such property was originally placed in service")
rule SyndicationRuleApplies(p: Person, a: Asset, original: Date, sold: Date) strict {
    label en official "first use by a lessor, sale within 3 months after the original placed-in-service date, same user after the last sale";
    when lessor_first_use_of_property(p, a);
    when property_originally_placed_in_service_on(p, a, original);
    when last_sale_date_of_property(p, a, sold);
    when sold <= add_calendar_period(original, 3 calendar_month);
    when user_after_last_sale_same_as_original(p, a);
    then syndication_rule_applies(p, a);
}
pub relation bonus_effective_placed_in_service_date(p: Person, a: Asset, on: Date) kind institutional {
    label en official "the date treated as the date the property was originally placed in service for section 168(k)(2)(A)(ii),(iii): not earlier than the date of the last sale under the syndication rule (section 168(k)(2)(E)(iii))";
}
@source(IRC_S168_K, quote = "such property shall be treated as originally placed in service not earlier than the date of such last sale.")
rule EffectivePlacedInServiceSyndicationSaleLater(p: Person, a: Asset, original: Date, sold: Date) strict {
    label en official "the date of the last sale, when it is not earlier than the original date";
    when syndication_rule_applies(p, a);
    when property_originally_placed_in_service_on(p, a, original);
    when last_sale_date_of_property(p, a, sold);
    when sold >= original;
    then bonus_effective_placed_in_service_date(p, a, sold);
}
@source(IRC_S168_K, quote = "such property shall be treated as originally placed in service not earlier than the date of such last sale.")
rule EffectivePlacedInServiceSyndicationOriginalLater(p: Person, a: Asset, original: Date, sold: Date) strict {
    label en official "the original date, when the last sale is earlier (not earlier than the sale)";
    when syndication_rule_applies(p, a);
    when property_originally_placed_in_service_on(p, a, original);
    when last_sale_date_of_property(p, a, sold);
    when sold < original;
    then bonus_effective_placed_in_service_date(p, a, original);
}
@source(IRC_S168_K, quote = "(iii) which is placed in service by the taxpayer before January 1, 2027.")
rule EffectivePlacedInServiceDefault(p: Person, a: Asset, on: Date) strict {
    label en official "without the syndication rule the placed-in-service date of the case is used";
    when bonus_depreciation_property_placed_in_service_on(p, a, on);
    when not_known(syndication_rule_applies(p, a));
    then bonus_effective_placed_in_service_date(p, a, on);
}

// === (k)(2)(D), (k)(9): the exclusions =========================================================================

pub relation alternative_depreciation_system_applies_without_g7_election(p: Person, a: Asset) kind empirical {
    label en official "the alternative depreciation system of subsection (g) applies to the property, determined without regard to (g)(7) and after section 280F(b) (section 168(k)(2)(D))";
}
pub relation property_primarily_used_in_trade_or_business_of_163j7A_iv(p: Person, a: Asset) kind empirical {
    label en official "the property is primarily used in a trade or business described in section 163(j)(7)(A)(iv) (section 168(k)(9)(A))";
}
pub relation floor_plan_financing_interest_taken_into_account_for_trade_or_business(p: Person, a: Asset) kind empirical {
    label en official "the property is used in a trade or business that has had floor plan financing indebtedness whose floor plan financing interest was taken into account under section 163(j)(1)(C) (section 168(k)(9)(B))";
}
pub relation bonus_property_excluded(p: Person, a: Asset) kind institutional {
    label en official "the property is excluded from qualified property by section 168(k)(2)(D) or (9)";
}
@source(IRC_S168_K, quote = "The term \"qualified property\" shall not include any property to which the alternative depreciation system under subsection (g) applies, determined—")
rule BonusPropertyExcludedAds(p: Person, a: Asset) strict {
    label en official "alternative depreciation property (section 168(k)(2)(D))";
    when alternative_depreciation_system_applies_without_g7_election(p, a);
    then bonus_property_excluded(p, a);
}
@source(IRC_S168_K, quote = "(A) any property which is primarily used in a trade or business described in clause (iv) of section 163(j)(7)(A), or")
rule BonusPropertyExcludedUtilityBusiness(p: Person, a: Asset) strict {
    label en official "property primarily used in a regulated utility business (section 168(k)(9)(A))";
    when property_primarily_used_in_trade_or_business_of_163j7A_iv(p, a);
    then bonus_property_excluded(p, a);
}
@source(IRC_S168_K, quote = "(B) any property used in a trade or business that has had floor plan financing indebtedness")
rule BonusPropertyExcludedFloorPlan(p: Person, a: Asset) strict {
    label en official "property used in a business whose floor plan financing interest was taken into account (section 168(k)(9)(B))";
    when floor_plan_financing_interest_taken_into_account_for_trade_or_business(p, a);
    then bonus_property_excluded(p, a);
}

// === (k)(2)(A): qualified property =============================================================================

pub relation bonus_property_qualified_via_2A(p: Person, a: Asset) kind institutional {
    label en official "the property is qualified property under section 168(k)(2)(A) (in the edition that applies to it)";
}
@source(IRC_S168_K, quote = "The term \"qualified property\" means property—")
rule QualifiedPropertyViaAPermanent(p: Person, a: Asset) strict {
    label en official "for property governed by Pub. L. 119-21 section 70301 clause (iii) is struck: clauses (i) and (ii) suffice";
    when bonus_property_meets_2A_i(p, a);
    when bonus_property_meets_2A_ii(p, a);
    when bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
    when not_known(bonus_property_excluded(p, a));
    then bonus_property_qualified_via_2A(p, a);
}
@source(IRC_S168_K, quote = "(iii) which is placed in service by the taxpayer before January 1, 2027.")
rule QualifiedPropertyViaAPre2027(p: Person, a: Asset, on: Date) strict {
    label en official "clauses (i), (ii) and (iii): placed in service before January 1, 2027 (section 168(k)(2)(A)(iii))";
    when bonus_property_meets_2A_i(p, a);
    when bonus_property_meets_2A_ii(p, a);
    when bonus_effective_placed_in_service_date(p, a, on);
    when on < @2027-01-01;
    when not_known(bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a));
    when not_known(bonus_property_excluded(p, a));
    then bonus_property_qualified_via_2A(p, a);
}

// --- (B): property with longer production periods -------------------------------------------------------------

pub relation bonus_property_is_transportation_property(p: Person, a: Asset) kind empirical {
    label en official "tangible personal property used in the trade or business of transporting persons or property (section 168(k)(2)(B)(iii))";
}
pub relation bonus_property_subject_to_263A(p: Person, a: Asset) kind empirical {
    label en official "the property is subject to section 263A (section 168(k)(2)(B)(i)(V))";
}
pub relation bonus_property_meets_263A_f1B_iii(p: Person, a: Asset) kind empirical {
    label en official "the property meets the requirements of section 263A(f)(1)(B)(iii), as if it also applied to property with a long useful life (section 168(k)(2)(B)(i)(VI))";
}
pub relation written_binding_contract_for_acquisition_entered_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date a written binding contract for the acquisition of the property was entered into (section 168(k)(2)(B)(i)(III))";
}
pub relation self_constructed_property_begun_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer began manufacturing, constructing or producing the property for its own use (section 168(k)(2)(E)(i))";
}
pub relation bonus_property_placed_in_service_date_2B(p: Person, a: Asset, on: Date) kind institutional {
    label en official "helper: the effective placed-in-service date for the longer-production-period test";
}
rule BonusPlacedDate2B(p: Person, a: Asset, on: Date) strict {
    label en official "helper: reads the effective placed-in-service date";
    when bonus_effective_placed_in_service_date(p, a, on);
    then bonus_property_placed_in_service_date_2B(p, a, on);
}
pub relation bonus_property_acquired_before_2027(p: Person, a: Asset) kind institutional {
    label en official "the property is acquired (or acquired under a written binding contract entered into) before January 1, 2027, or, for self-constructed property, its construction begins before that date (section 168(k)(2)(B)(i)(III),(E)(i))";
}
@source(IRC_S168_K, quote = "(III) is acquired by the taxpayer (or acquired pursuant to a written binding contract entered into) before January 1, 2027,")
rule BonusPropertyAcquiredBefore2027Acquired(p: Person, a: Asset, on: Date) strict {
    label en official "acquired before 2027";
    when bonus_depreciation_property_acquired_on(p, a, on);
    when on < @2027-01-01;
    then bonus_property_acquired_before_2027(p, a);
}
@source(IRC_S168_K, quote = "(III) is acquired by the taxpayer (or acquired pursuant to a written binding contract entered into) before January 1, 2027,")
rule BonusPropertyAcquiredBefore2027Contract(p: Person, a: Asset, on: Date) strict {
    label en official "a written binding contract entered into before 2027";
    when written_binding_contract_for_acquisition_entered_on(p, a, on);
    when on < @2027-01-01;
    then bonus_property_acquired_before_2027(p, a);
}
@source(IRC_S168_K, quote = "the requirements of subclause (III) of subparagraph (B)(i) shall be treated as met if the taxpayer begins manufacturing, constructing, or producing the property before January 1, 2027.")
rule BonusPropertyAcquiredBefore2027SelfConstructed(p: Person, a: Asset, on: Date) strict {
    label en official "self-constructed property: construction begun before 2027 (section 168(k)(2)(E)(i))";
    when self_constructed_property_begun_on(p, a, on);
    when on < @2027-01-01;
    then bonus_property_acquired_before_2027(p, a);
}
pub relation bonus_property_recovery_period_at_least_10_or_transportation(p: Person, a: Asset) kind institutional {
    label en official "the property has a recovery period of at least 10 years or is transportation property (section 168(k)(2)(B)(i)(IV))";
}
@source(IRC_S168_K, quote = "(IV) has a recovery period of at least 10 years or is transportation property,")
rule BonusPropertyRecoveryPeriod10OrMore(p: Person, a: Asset, years: Decimal) strict {
    label en official "a recovery period of at least 10 years";
    when applicable_recovery_period_years(p, a, years);
    when years >= 10.0;
    then bonus_property_recovery_period_at_least_10_or_transportation(p, a);
}
@source(IRC_S168_K, quote = "(IV) has a recovery period of at least 10 years or is transportation property,")
rule BonusPropertyTransportation(p: Person, a: Asset) strict {
    label en official "transportation property";
    when bonus_property_is_transportation_property(p, a);
    then bonus_property_recovery_period_at_least_10_or_transportation(p, a);
}
pub relation bonus_property_qualified_via_2B(p: Person, a: Asset) kind institutional {
    label en official "the property is qualified property by reason of section 168(k)(2)(B)";
}
@source(IRC_S168_K, quote = "The term \"qualified property\" includes any property if such property—")
rule QualifiedPropertyViaB(p: Person, a: Asset, on: Date) strict {
    label en official "clauses (i) and (ii) of (A), placed in service before 2028, acquired before 2027, a recovery period of at least 10 years or transportation property, subject to 263A and meeting 263A(f)(1)(B)(iii); not aircraft of subparagraph (C) (section 168(k)(2)(B)(i),(iv))";
    when bonus_property_meets_2A_i(p, a);
    when bonus_property_meets_2A_ii(p, a);
    when bonus_property_placed_in_service_date_2B(p, a, on);
    when on < @2028-01-01;
    when bonus_property_acquired_before_2027(p, a);
    when bonus_property_recovery_period_at_least_10_or_transportation(p, a);
    when bonus_property_subject_to_263A(p, a);
    when bonus_property_meets_263A_f1B_iii(p, a);
    when not_known(bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a));
    when not_known(bonus_property_excluded(p, a));
    when not_known(bonus_property_is_aircraft_2C_candidate(p, a));
    then bonus_property_qualified_via_2B(p, a);
}
pub relation bonus_property_qualified_solely_via_2B(p: Person, a: Asset) kind institutional {
    label en official "the property is qualified property solely by reason of clause (i) of subparagraph (B), not by subparagraph (A) (section 168(k)(2)(B)(ii))";
}
@source(IRC_S168_K, quote = "In the case of property which is qualified property solely by reason of clause (i), paragraph (1) shall apply only to the extent of the adjusted basis thereof attributable to manufacture, construction, or production before January 1, 2027.")
rule QualifiedSolelyViaB(p: Person, a: Asset) strict {
    label en official "qualified by (B) and not by (A)";
    when bonus_property_qualified_via_2B(p, a);
    when not_known(bonus_property_qualified_via_2A(p, a));
    then bonus_property_qualified_solely_via_2B(p, a);
}
pub relation basis_attributable_to_production_before_2027(p: Person, a: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis attributable to manufacture, construction or production before January 1, 2027 (section 168(k)(2)(B)(ii))";
}

// --- (C): certain aircraft ----------------------------------------------------------------------------------------

pub relation bonus_property_is_aircraft_2C_candidate(p: Person, a: Asset) kind empirical {
    label en official "the property is an aircraft that is not transportation property, other than for agricultural or firefighting purposes (section 168(k)(2)(C)(ii)); it is then tested under subparagraph (C), not (B) (section 168(k)(2)(B)(iv))";
}
pub relation aircraft_nonrefundable_deposit(p: Person, a: Asset, deposit: Money, cost: Money) kind empirical {
    label en official "the nonrefundable deposit made at the time of the purchase contract and the cost of the aircraft (section 168(k)(2)(C)(iii))";
}
pub relation aircraft_estimated_production_period_months(p: Person, a: Asset, months: Integer) kind empirical {
    label en official "the estimated production period of the aircraft in months (section 168(k)(2)(C)(iv)(I))";
}
pub relation bonus_property_qualified_via_2C(p: Person, a: Asset) kind institutional {
    label en official "the property is qualified property by reason of section 168(k)(2)(C): certain aircraft";
}
@source(IRC_S168_K, quote = "(iii) which is purchased and on which such purchaser, at the time of the contract for purchase, has made a nonrefundable deposit of the lesser of—")
rule QualifiedPropertyViaC(p: Person, a: Asset, on: Date, deposit: Money, cost: Money, months: Integer) strict {
    label en official "clause (ii)-(iii) of (A), placed in service before 2028, acquired before 2027, a nonrefundable deposit of the lesser of 10 percent of the cost and $100,000, a production period over 4 months and a cost over $200,000 (section 168(k)(2)(C))";
    when bonus_property_meets_2A_ii(p, a);
    when bonus_property_placed_in_service_date_2B(p, a, on);
    when on < @2028-01-01;
    when bonus_property_acquired_before_2027(p, a);
    when bonus_property_is_aircraft_2C_candidate(p, a);
    when aircraft_nonrefundable_deposit(p, a, deposit, cost);
    when deposit >= min(cost * 0.10, 100000.00 USD);
    when aircraft_estimated_production_period_months(p, a, months);
    when months > 4;
    when cost > 200000.00 USD;
    when not_known(bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a));
    when not_known(bonus_property_excluded(p, a));
    then bonus_property_qualified_via_2C(p, a);
}
pub relation bonus_property_described_in_2B_or_2C(p: Person, a: Asset) kind institutional {
    label en official "the property is described in subparagraph (B) or (C) of paragraph (2), so the longer-production-period percentages apply";
}
@source(IRC_S168_K, quote = "In the case of property described in subparagraph (B) or (C) of paragraph (2), the term \"applicable percentage\" means—")
rule DescribedInBOrCViaB(p: Person, a: Asset) strict {
    label en official "described in subparagraph (B)";
    when bonus_property_qualified_via_2B(p, a);
    then bonus_property_described_in_2B_or_2C(p, a);
}
@source(IRC_S168_K, quote = "In the case of property described in subparagraph (B) or (C) of paragraph (2), the term \"applicable percentage\" means—")
rule DescribedInBOrCViaC(p: Person, a: Asset) strict {
    label en official "described in subparagraph (C)";
    when bonus_property_qualified_via_2C(p, a);
    then bonus_property_described_in_2B_or_2C(p, a);
}

// --- the final derivation of qualified property ----------------------------------------------------------------------

@source(IRC_S168_K, quote = "The term \"qualified property\" means property—")
rule QualifiedPropertyFromA(p: Person, a: Asset) strict {
    label en official "qualified property under subparagraph (A)";
    when bonus_property_qualified_via_2A(p, a);
    then qualified_property_for_bonus_depreciation(p, a);
}
@source(IRC_S168_K, quote = "The term \"qualified property\" includes any property if such property—")
rule QualifiedPropertyFromB(p: Person, a: Asset) strict {
    label en official "qualified property under subparagraph (B)";
    when bonus_property_qualified_via_2B(p, a);
    then qualified_property_for_bonus_depreciation(p, a);
}
@source(IRC_S168_K, quote = "The term \"qualified property\" includes property—")
rule QualifiedPropertyFromC(p: Person, a: Asset) strict {
    label en official "qualified property under subparagraph (C)";
    when bonus_property_qualified_via_2C(p, a);
    then qualified_property_for_bonus_depreciation(p, a);
}

// === (k)(1)(B): the basis reduction ====================================================================================

pub relation asset_has_bonus_depreciation_in_year(p: Person, a: Asset, y: TaxableYear) kind institutional {
    label en official "helper: some additional first-year allowance is allowed for the asset in the year";
}
rule AssetHasBonusDepreciationKeyed(p: Person, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "helper: keys the bonus depreciation by asset and year";
    when bonus_depreciation(p, a, y, amount);
    then asset_has_bonus_depreciation_in_year(p, a, y);
}
pub relation year1_depreciable_basis(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the basis from which the year-1 depreciation is computed: the unadjusted basis less the additional first-year allowance (section 168(k)(1)(B))";
}
@source(IRC_S168_K, quote = "(B) the adjusted basis of the qualified property shall be reduced by the amount of such deduction before computing the amount otherwise allowable as a depreciation deduction under this chapter for such taxable year and any subsequent taxable year.")
rule Year1BasisReducedByBonus(p: Person, a: Asset, y: TaxableYear, basis: Money, bonus: Money) defeasible {
    label en official "the adjusted basis is reduced by the bonus amount before the ordinary allowance";
    when unadjusted_depreciable_basis(p, a, y, basis);
    when bonus_depreciation(p, a, y, bonus);
    then year1_depreciable_basis(p, a, y, max(0.00 USD, basis - bonus));
}
pub relation year1_basis_with_bonus_projection(p: Person, a: Asset, y: TaxableYear, basis: Money) kind institutional {
    label en official "helper: the unadjusted basis of an asset that has an additional first-year allowance, keyed for the unless below";
}
rule Year1BasisWithBonusProjection(p: Person, a: Asset, y: TaxableYear, basis: Money) defeasible {
    label en official "helper: projects the bonus onto the basis";
    when unadjusted_depreciable_basis(p, a, y, basis);
    when asset_has_bonus_depreciation_in_year(p, a, y);
    then year1_basis_with_bonus_projection(p, a, y, basis);
}
@source(IRC_S168_K, quote = "(B) the adjusted basis of the qualified property shall be reduced by the amount of such deduction before computing the amount otherwise allowable as a depreciation deduction under this chapter for such taxable year and any subsequent taxable year.")
rule Year1BasisWithoutBonus(p: Person, a: Asset, y: TaxableYear, basis: Money) defeasible {
    label en official "without the additional allowance the basis is unchanged";
    when unadjusted_depreciable_basis(p, a, y, basis);
    unless year1_basis_with_bonus_projection(p, a, y, basis);
    then year1_depreciable_basis(p, a, y, basis);
}
pub relation bonus_eligible_basis(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the basis to which the additional first-year allowance applies: the whole unadjusted basis, or for property qualified solely by (B) only the basis attributable to production before 2027 (section 168(k)(2)(B)(ii))";
}
@source(IRC_S168_K, quote = "In the case of property which is qualified property solely by reason of clause (i), paragraph (1) shall apply only to the extent of the adjusted basis thereof attributable to manufacture, construction, or production before January 1, 2027.")
rule BonusEligibleBasisWhole(p: Person, a: Asset, y: TaxableYear, basis: Money) strict {
    label en official "the whole basis unless qualified solely by (B)";
    when unadjusted_depreciable_basis(p, a, y, basis);
    when not_known(bonus_property_qualified_solely_via_2B(p, a));
    then bonus_eligible_basis(p, a, y, basis);
}
@source(IRC_S168_K, quote = "In the case of property which is qualified property solely by reason of clause (i), paragraph (1) shall apply only to the extent of the adjusted basis thereof attributable to manufacture, construction, or production before January 1, 2027.")
rule BonusEligibleBasisPre2027Part(p: Person, a: Asset, y: TaxableYear, basis: Money, before: Money) strict {
    label en official "only the basis attributable to production before 2027";
    when unadjusted_depreciable_basis(p, a, y, basis);
    when bonus_property_qualified_solely_via_2B(p, a);
    when basis_attributable_to_production_before_2027(p, a, y, before);
    then bonus_eligible_basis(p, a, y, min(basis, before));
}

// === (k)(6)(B): the longer-production-period schedule ==================================================================

@source(IRC_S168_K, quote = "(i) in the case of property placed in service after September 27, 2017, and before January 1, 2024, 100 percent,")
rule BonusPercentageLongProduction100(p: Person, a: Asset, placed: Date) defeasible {
    label en official "100 percent for property placed in service after September 27, 2017 and before January 1, 2024 (section 168(k)(6)(B)(i))";
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2017-09-27;
    when placed < @2024-01-01;
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 1.00);
}
@source(IRC_S168_K, quote = "(ii) in the case of property placed in service after December 31, 2023, and before January 1, 2025, 80 percent,")
rule BonusPercentageLongProduction80(p: Person, a: Asset, placed: Date) defeasible {
    label en official "80 percent for property placed in service in 2024 (section 168(k)(6)(B)(ii))";
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2023-12-31;
    when placed < @2025-01-01;
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.80);
}
@source(IRC_S168_K, quote = "(iii) in the case of property placed in service after December 31, 2024, and before January 1, 2026, 60 percent,")
rule BonusPercentageLongProduction60(p: Person, a: Asset, placed: Date) defeasible {
    label en official "60 percent for property placed in service in 2025 (section 168(k)(6)(B)(iii))";
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2024-12-31;
    when placed < @2026-01-01;
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.60);
}
@source(IRC_S168_K, quote = "(iv) in the case of property placed in service after December 31, 2025, and before January 1, 2027, 40 percent, and")
rule BonusPercentageLongProduction40(p: Person, a: Asset, placed: Date) defeasible {
    label en official "40 percent for property placed in service in 2026 (section 168(k)(6)(B)(iv))";
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2025-12-31;
    when placed < @2027-01-01;
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.40);
}
@source(IRC_S168_K, quote = "(v) in the case of property placed in service after December 31, 2026, and before January 1, 2028, 20 percent.")
rule BonusPercentageLongProduction20(p: Person, a: Asset, placed: Date) defeasible {
    label en official "20 percent for property placed in service in 2027 (section 168(k)(6)(B)(v))";
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2026-12-31;
    when placed < @2028-01-01;
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.20);
}

// === (k)(8): the phase down for property acquired before September 28, 2017 ==============================

pub relation bonus_phase_down_applies(p: Person, a: Asset) kind institutional {
    label en official "the property was acquired before September 28, 2017 and placed in service after September 27, 2017, so paragraph (6) is applied with the phase-down percentages (section 168(k)(8))";
}
@source(IRC_S168_K, quote = "In the case of qualified property acquired by the taxpayer before September 28, 2017, and placed in service by the taxpayer after September 27, 2017, paragraph (6) shall be applied by substituting for each percentage therein—")
rule BonusPhaseDownApplies(p: Person, a: Asset, acquired: Date, placed: Date) strict {
    label en official "acquired before September 28, 2017 and placed in service after September 27, 2017";
    when bonus_depreciation_property_acquired_on(p, a, acquired);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when acquired < @2017-09-28;
    when placed > @2017-09-27;
    then bonus_phase_down_applies(p, a);
}
@source(IRC_S168_K, quote = "(A) \"50 percent\" in the case of—")
rule BonusPhaseDown50Before2018(p: Person, a: Asset, placed: Date) defeasible {
    label en official "50 percent for property placed in service before January 1, 2018 (section 168(k)(8)(A)(i))";
    when bonus_phase_down_applies(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed < @2018-01-01;
    then bonus_depreciation_applicable_percentage(p, a, 0.50);
}
@source(IRC_S168_K, quote = "(ii) property described in subparagraph (B) or (C) of paragraph (2) which is placed in service in 2018,")
rule BonusPhaseDown50LongProduction2018(p: Person, a: Asset, placed: Date) defeasible {
    label en official "50 percent for longer-production-period property placed in service in 2018 (section 168(k)(8)(A)(ii))";
    when bonus_phase_down_applies(p, a);
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed >= @2018-01-01;
    when placed <= @2018-12-31;
    then bonus_depreciation_applicable_percentage(p, a, 0.50);
}
@source(IRC_S168_K, quote = "(B) \"40 percent\" in the case of—")
rule BonusPhaseDown40Placed2018(p: Person, a: Asset, placed: Date) defeasible {
    label en official "40 percent for ordinary property placed in service in 2018 (section 168(k)(8)(B)(i))";
    when bonus_phase_down_applies(p, a);
    when not_known(bonus_property_described_in_2B_or_2C(p, a));
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed >= @2018-01-01;
    when placed <= @2018-12-31;
    then bonus_depreciation_applicable_percentage(p, a, 0.40);
}
@source(IRC_S168_K, quote = "(ii) property described in subparagraph (B) or (C) of paragraph (2) which is placed in service in 2019,")
rule BonusPhaseDown40LongProduction2019(p: Person, a: Asset, placed: Date) defeasible {
    label en official "40 percent for longer-production-period property placed in service in 2019 (section 168(k)(8)(B)(ii))";
    when bonus_phase_down_applies(p, a);
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed >= @2019-01-01;
    when placed <= @2019-12-31;
    then bonus_depreciation_applicable_percentage(p, a, 0.40);
}
@source(IRC_S168_K, quote = "(C) \"30 percent\" in the case of—")
rule BonusPhaseDown30Placed2019(p: Person, a: Asset, placed: Date) defeasible {
    label en official "30 percent for ordinary property placed in service in 2019 (section 168(k)(8)(C)(i))";
    when bonus_phase_down_applies(p, a);
    when not_known(bonus_property_described_in_2B_or_2C(p, a));
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed >= @2019-01-01;
    when placed <= @2019-12-31;
    then bonus_depreciation_applicable_percentage(p, a, 0.30);
}
@source(IRC_S168_K, quote = "(ii) property described in subparagraph (B) or (C) of paragraph (2) which is placed in service in 2020, and")
rule BonusPhaseDown30LongProduction2020(p: Person, a: Asset, placed: Date) defeasible {
    label en official "30 percent for longer-production-period property placed in service in 2020 (section 168(k)(8)(C)(ii))";
    when bonus_phase_down_applies(p, a);
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed >= @2020-01-01;
    when placed <= @2020-12-31;
    then bonus_depreciation_applicable_percentage(p, a, 0.30);
}
@source(IRC_S168_K, quote = "(D) \"0 percent\" in the case of—")
rule BonusPhaseDown0After2019(p: Person, a: Asset, placed: Date) defeasible {
    label en official "0 percent for ordinary property placed in service after 2019 (section 168(k)(8)(D)(i))";
    when bonus_phase_down_applies(p, a);
    when not_known(bonus_property_described_in_2B_or_2C(p, a));
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2019-12-31;
    then bonus_depreciation_applicable_percentage(p, a, 0.00);
}
@source(IRC_S168_K, quote = "(ii) property described in subparagraph (B) or (C) of paragraph (2) which is placed in service after 2020.")
rule BonusPhaseDown0LongProductionAfter2020(p: Person, a: Asset, placed: Date) defeasible {
    label en official "0 percent for longer-production-period property placed in service after 2020 (section 168(k)(8)(D)(ii))";
    when bonus_phase_down_applies(p, a);
    when bonus_property_described_in_2B_or_2C(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2020-12-31;
    then bonus_depreciation_applicable_percentage(p, a, 0.00);
}

// === (k)(10): the elections to use a reduced percentage ==================================================================

pub relation elects_168k10_first_year_after_2017(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects, for the first taxable year ending after September 27, 2017, that paragraph (10) apply (section 168(k)(10)(A) as amended before Pub. L. 119-21)";
}
pub relation taxable_year_is_first_ending_after_2017_09_27(y: TaxableYear) kind empirical {
    label en official "the taxable year is the first taxable year ending after September 27, 2017";
}
pub relation bonus_2017_first_year_election_applies(p: Person, a: Asset) kind institutional {
    label en official "the 50 percent election of section 168(k)(10)(A) (pre-amendment text) applies to the qualified property placed in service in the first taxable year ending after September 27, 2017";
}
@source(IRC_S168_K, quote = "(A) In general")
rule Bonus2017FirstYearElectionApplies(p: Person, a: Asset, y: TaxableYear) strict {
    label en official "an elected first taxable year ending after September 27, 2017, with the property placed in service in it";
    when elects_168k10_first_year_after_2017(p, y);
    when taxable_year_is_first_ending_after_2017_09_27(y);
    when placed_in_service_year(p, a, y);
    when qualified_property_for_bonus_depreciation(p, a);
    then bonus_2017_first_year_election_applies(p, a);
}
@source(IRC_S168_K, quote = "if the taxpayer elects to have this paragraph apply for such taxable year, paragraphs (1)(A) and (5)(A)(i) shall be applied by substituting \"50 percent\" for \"the applicable percentage\".")
rule Bonus2017FirstYearElectionPercentage(p: Person, a: Asset) defeasible {
    label en official "50 percent replaces the applicable percentage";
    when bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.50);
}
pub relation elects_168k10_transitional_reduced_percentage(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects that the transitional paragraph (10)(A) apply for the first taxable year ending after January 19, 2025 (Pub. L. 119-21 section 70301(b)(3))";
}
pub relation taxable_year_is_first_ending_after_2025_01_19(y: TaxableYear) kind empirical {
    label en official "the taxable year is the first taxable year ending after January 19, 2025";
}
pub relation bonus_transitional_election_applies(p: Person, a: Asset) kind institutional {
    label en official "the transitional election of section 168(k)(10)(A) as amended applies to the qualified property placed in service in the first taxable year ending after January 19, 2025";
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "In the case of qualified property placed in service by the taxpayer during the first taxable year ending after January 19, 2025, if the taxpayer elects to have this paragraph apply for such taxable year")
rule BonusTransitionalElectionApplies(p: Person, a: Asset, y: TaxableYear) strict {
    label en official "an elected first taxable year ending after January 19, 2025, with the property placed in service in it";
    when elects_168k10_transitional_reduced_percentage(p, y);
    when taxable_year_is_first_ending_after_2025_01_19(y);
    when placed_in_service_year(p, a, y);
    when qualified_property_for_bonus_depreciation(p, a);
    then bonus_transitional_election_applies(p, a);
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "paragraph (1)(A) shall be applied—“(i) in the case of property which is not described in clause (ii), by substituting ‘40 percent’ for ‘100 percent’")
rule BonusTransitionalPercentage40(p: Person, a: Asset) defeasible {
    label en official "40 percent for property not described in (2)(B) or (C)";
    when bonus_transitional_election_applies(p, a);
    when not_known(bonus_property_described_in_2B_or_2C(p, a));
    then bonus_depreciation_applicable_percentage(p, a, 0.40);
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "in the case of property which is described in subparagraph (B) or (C) of paragraph (2), by substituting ‘60 percent’ for ‘100 percent’")
rule BonusTransitionalPercentage60(p: Person, a: Asset) defeasible {
    label en official "60 percent for property described in (2)(B) or (C)";
    when bonus_transitional_election_applies(p, a);
    when bonus_property_described_in_2B_or_2C(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.60);
}

// === (k)(2)(F),(G),(H): coordination and timing ==========================================================================

pub relation asset_is_passenger_automobile_280f(a: Asset) kind empirical {
    label en official "the asset is a passenger automobile as defined in section 280F(d)(5)";
}
pub relation bonus_280f_first_year_increase(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the increase of the section 280F(a)(1)(A)(i) first-year limitation for a passenger automobile that is qualified property (section 168(k)(2)(F)(i),(iii))";
}
@source(IRC_S168_K, quote = "the Secretary shall increase the limitation under section 280F(a)(1)(A)(i) by $8,000.")
rule Bonus280fIncrease8000(p: Person, a: Asset) defeasible {
    label en official "$8,000 for a passenger automobile that is qualified property";
    when asset_is_passenger_automobile_280f(a);
    when qualified_property_for_bonus_depreciation(p, a);
    unless bonus_phase_down_applies(p, a);
    then bonus_280f_first_year_increase(p, a, 8000.00 USD);
}
@source(IRC_S168_K, quote = "(I) in the case of an automobile placed in service during 2018, $6,400, and")
rule Bonus280fIncrease2018(p: Person, a: Asset, placed: Date) defeasible {
    label en official "$6,400 for an automobile acquired before September 28, 2017 and placed in service in 2018 (section 168(k)(2)(F)(iii)(I))";
    when asset_is_passenger_automobile_280f(a);
    when qualified_property_for_bonus_depreciation(p, a);
    when bonus_phase_down_applies(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed >= @2018-01-01;
    when placed <= @2018-12-31;
    then bonus_280f_first_year_increase(p, a, 6400.00 USD);
}
@source(IRC_S168_K, quote = "(II) in the case of an automobile placed in service during 2019, $4,800.")
rule Bonus280fIncrease2019(p: Person, a: Asset, placed: Date) defeasible {
    label en official "$4,800 for an automobile acquired before September 28, 2017 and placed in service in 2019 (section 168(k)(2)(F)(iii)(II))";
    when asset_is_passenger_automobile_280f(a);
    when qualified_property_for_bonus_depreciation(p, a);
    when bonus_phase_down_applies(p, a);
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed >= @2019-01-01;
    when placed <= @2019-12-31;
    then bonus_280f_first_year_increase(p, a, 4800.00 USD);
}
pub relation bonus_depreciation_counted_for_280f_recapture(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional first-year allowance is taken into account in computing any recapture amount under section 280F(b)(2) (section 168(k)(2)(F)(ii))";
}
@source(IRC_S168_K, quote = "The deduction allowable under paragraph (1) shall be taken into account in computing any recapture amount under section 280F(b)(2).")
rule BonusCountedFor280fRecapture(p: Person, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the allowance counts as depreciation for the recapture computation";
    when bonus_depreciation(p, a, y, amount);
    then bonus_depreciation_counted_for_280f_recapture(p, a, y, amount);
}
pub relation bonus_depreciation_for_amti(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 167 deduction for qualified property in computing alternative minimum taxable income: determined without regard to any section 56 adjustment (section 168(k)(2)(G))";
}
@source(IRC_S168_K, quote = "the deduction under section 167 for qualified property shall be determined without regard to any adjustment under section 56.")
rule BonusForAmtiWithoutSection56Adjustment(p: Person, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the bonus allowance is the same for the minimum tax";
    when bonus_depreciation(p, a, y, amount);
    then bonus_depreciation_for_amti(p, a, y, amount);
}
pub relation production_initial_release_or_broadcast_on(production: Integer, on: Date) kind empirical {
    label en official "the date of the initial release or broadcast of a qualified film or television production (section 168(k)(2)(H)(i))";
}
pub relation production_initial_live_staged_performance_on(production: Integer, on: Date) kind empirical {
    label en official "the date of the initial live staged performance of a qualified live theatrical production (section 168(k)(2)(H)(ii))";
}
pub relation production_treated_as_placed_in_service_on(production: Integer, on: Date) kind institutional {
    label en official "the date a production is considered placed in service for section 168(k)(2)(A)";
}
@source(IRC_S168_K, quote = "(i) a qualified film or television production shall be considered to be placed in service at the time of initial release or broadcast, and")
rule FilmPlacedInServiceAtRelease(production: Integer, on: Date, p0: Person) strict {
    label en official "a film or television production is placed in service at initial release or broadcast";
    when qualified_production_181(p0, production, FilmOrTelevision);
    when production_initial_release_or_broadcast_on(production, on);
    then production_treated_as_placed_in_service_on(production, on);
}
@source(IRC_S168_K, quote = "(ii) a qualified live theatrical production shall be considered to be placed in service at the time of the initial live staged performance.")
rule TheatricalPlacedInServiceAtPerformance(production: Integer, on: Date, p0: Person) strict {
    label en official "a live theatrical production is placed in service at the initial live staged performance";
    when qualified_production_181(p0, production, LiveTheatrical);
    when production_initial_live_staged_performance_on(production, on);
    then production_treated_as_placed_in_service_on(production, on);
}

// === (k)(5): specified plants ==============================================================================================

pub relation plant_is_tree_or_vine_bearing_fruits_or_nuts(plant: Integer) kind empirical {
    label en official "the plant is a tree or vine which bears fruits or nuts (section 168(k)(5)(B)(i))";
}
pub relation plant_has_more_than_one_crop_and_pre_productive_period_over_2_years(plant: Integer) kind empirical {
    label en official "the plant will have more than one crop or yield of fruits or nuts and generally has a pre-productive period of more than 2 years (section 168(k)(5)(B)(ii))";
}
pub relation plant_planted_or_grafted_outside_united_states(plant: Integer) kind empirical {
    label en official "the plant is planted or grafted outside of the United States (section 168(k)(5)(B) last sentence)";
}
pub relation specified_plant(plant: Integer) kind institutional {
    label en official "a specified plant (section 168(k)(5)(B))";
}
@source(IRC_S168_K, quote = "(i) any tree or vine which bears fruits or nuts, and")
rule SpecifiedPlantTreeOrVine(plant: Integer) strict {
    label en official "a tree or vine which bears fruits or nuts, if not planted outside the United States";
    when plant_is_tree_or_vine_bearing_fruits_or_nuts(plant);
    when not_known(plant_planted_or_grafted_outside_united_states(plant));
    then specified_plant(plant);
}
@source(IRC_S168_K, quote = "(ii) any other plant which will have more than one crop or yield of fruits or nuts")
rule SpecifiedPlantOtherMultiCrop(plant: Integer) strict {
    label en official "another multi-crop plant with a pre-productive period over 2 years, if not planted outside the United States";
    when plant_has_more_than_one_crop_and_pre_productive_period_over_2_years(plant);
    when not_known(plant_planted_or_grafted_outside_united_states(plant));
    then specified_plant(plant);
}
pub relation plant_planted_or_grafted_on(p: Person, plant: Integer, on: Date) kind empirical {
    label en official "the date the taxpayer planted the plant or grafted it to a plant already planted, in the ordinary course of its farming business (section 168(k)(5)(A))";
}
pub relation plant_planted_in_taxable_year(p: Person, plant: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the plant is planted or grafted";
}
pub relation elects_168k5_for_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects the application of section 168(k)(5) for the taxable year";
}
pub relation plant_adjusted_basis(p: Person, plant: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis of the specified plant (section 168(k)(5)(A)(i))";
}
pub relation plant_planted_for_farming_business_in_ordinary_course(p: Person, plant: Integer) kind empirical {
    label en official "the plant is planted or grafted in the ordinary course of the taxpayer's farming business as defined in section 263A(e)(4) (section 168(k)(5)(A))";
}
pub relation plant_bonus_applicable_percentage(p: Person, plant: Integer, pct: Decimal) kind institutional {
    label en official "the applicable percentage for a specified plant (section 168(k)(6)(C), and 100 percent for plants planted or grafted after January 19, 2025 under Pub. L. 119-21 section 70301)";
}
pub relation plant_elects_transitional_percentage(p: Person, plant: Integer) kind empirical {
    label en official "the taxpayer elects the transitional 40 percent for a specified plant planted or grafted in the first taxable year ending after January 19, 2025 (Pub. L. 119-21 section 70301(b)(3), (k)(10)(B))";
}
@source(IRC_S168_K, quote = "(i) in the case of a plant which is planted or grafted after September 27, 2017, and before January 1, 2023, 100 percent,")
rule PlantPercentage100(p: Person, plant: Integer, on: Date) defeasible {
    label en official "100 percent for plants planted or grafted after September 27, 2017 and before January 1, 2023 (section 168(k)(6)(C)(i))";
    when specified_plant(plant);
    when plant_planted_or_grafted_on(p, plant, on);
    when on > @2017-09-27;
    when on < @2023-01-01;
    then plant_bonus_applicable_percentage(p, plant, 1.00);
}
@source(IRC_S168_K, quote = "(ii) in the case of a plant which is planted or grafted after December 31, 2022, and before January 1, 2024, 80 percent,")
rule PlantPercentage80(p: Person, plant: Integer, on: Date) defeasible {
    label en official "80 percent for plants planted or grafted in 2023 (section 168(k)(6)(C)(ii))";
    when specified_plant(plant);
    when plant_planted_or_grafted_on(p, plant, on);
    when on > @2022-12-31;
    when on < @2024-01-01;
    then plant_bonus_applicable_percentage(p, plant, 0.80);
}
@source(IRC_S168_K, quote = "(iii) in the case of a plant which is planted or grafted after December 31, 2023, and before January 1, 2025, 60 percent,")
rule PlantPercentage60(p: Person, plant: Integer, on: Date) defeasible {
    label en official "60 percent for plants planted or grafted in 2024 (section 168(k)(6)(C)(iii))";
    when specified_plant(plant);
    when plant_planted_or_grafted_on(p, plant, on);
    when on > @2023-12-31;
    when on < @2025-01-01;
    then plant_bonus_applicable_percentage(p, plant, 0.60);
}
@source(IRC_S168_K, quote = "(iv) in the case of a plant which is planted or grafted after December 31, 2024, and before January 1, 2026, 40 percent, and")
rule PlantPercentage40Of2025(p: Person, plant: Integer, on: Date) defeasible {
    label en official "40 percent for plants planted or grafted in 2025 up to January 19, 2025 (section 168(k)(6)(C)(iv)); after that date Pub. L. 119-21 makes it 100 percent";
    when specified_plant(plant);
    when plant_planted_or_grafted_on(p, plant, on);
    when on > @2024-12-31;
    when on <= @2025-01-19;
    then plant_bonus_applicable_percentage(p, plant, 0.40);
}
@source(IRC_S168_K, quote = "(v) in the case of a plant which is planted or grafted after December 31, 2025, and before January 1, 2027, 20 percent.")
rule PlantPercentage20(p: Person, plant: Integer, on: Date) defeasible {
    label en official "20 percent for plants planted or grafted in 2026 (section 168(k)(6)(C)(v)); superseded by Pub. L. 119-21 for plants planted or grafted after January 19, 2025";
    when specified_plant(plant);
    when plant_planted_or_grafted_on(p, plant, on);
    when on > @2025-12-31;
    when on < @2027-01-01;
    unless plant_governed_by_pl119_21_permanent_hundred(p, plant);
    then plant_bonus_applicable_percentage(p, plant, 0.20);
}
pub relation plant_governed_by_pl119_21_permanent_hundred(p: Person, plant: Integer) kind institutional {
    label en official "the plant is planted or grafted after January 19, 2025, so the Pub. L. 119-21 section 70301 amendments apply to it (100 percent)";
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "in the case of any specified plant (as defined in section 168(k)(5)(B) of the Internal Revenue Code of 1986, as amended by this section), the amendments made by this section shall apply to such plants which are planted or grafted after January 19, 2025.")
rule PlantGovernedByPl11921(p: Person, plant: Integer, on: Date) strict {
    label en official "planted or grafted after January 19, 2025";
    when plant_planted_or_grafted_on(p, plant, on);
    when on > @2025-01-19;
    then plant_governed_by_pl119_21_permanent_hundred(p, plant);
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "Section 168(k)(5)(A)(i) is amended by striking “the applicable percentage” and inserting “100 percent”.")
rule PlantPercentagePermanent100(p: Person, plant: Integer) defeasible {
    label en official "100 percent for plants planted or grafted after January 19, 2025 (Pub. L. 119-21 section 70301(b)(2))";
    when specified_plant(plant);
    when plant_governed_by_pl119_21_permanent_hundred(p, plant);
    unless plant_elects_transitional_percentage(p, plant);
    then plant_bonus_applicable_percentage(p, plant, 1.00);
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "paragraph (5)(A)(i) shall be applied by substituting ‘40 percent’ for ‘100 percent’")
rule PlantPercentageTransitional40(p: Person, plant: Integer) defeasible {
    label en official "40 percent when the taxpayer elects the transitional percentage for a plant planted or grafted in the first taxable year ending after January 19, 2025";
    when specified_plant(plant);
    when plant_governed_by_pl119_21_permanent_hundred(p, plant);
    when plant_elects_transitional_percentage(p, plant);
    then plant_bonus_applicable_percentage(p, plant, 0.40);
}
pub relation specified_plant_depreciation_deduction(p: Person, plant: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the depreciation deduction for a specified plant for the taxable year in which it is planted or grafted: the applicable percentage of its adjusted basis (section 168(k)(5)(A)(i))";
}
@source(IRC_S168_K, quote = "(i) a depreciation deduction equal to the applicable percentage of the adjusted basis of such specified plant shall be allowed under section 167(a) for the taxable year in which such specified plant is so planted or grafted, and")
rule SpecifiedPlantDeduction(p: Person, plant: Integer, y: TaxableYear, basis: Money, pct: Decimal) defeasible {
    label en official "the applicable percentage of the adjusted basis, for an elected year, for a plant planted in the ordinary course of a farming business";
    when specified_plant(plant);
    when plant_planted_in_taxable_year(p, plant, y);
    when elects_168k5_for_year(p, y);
    when plant_planted_for_farming_business_in_ordinary_course(p, plant);
    when plant_adjusted_basis(p, plant, basis);
    when plant_bonus_applicable_percentage(p, plant, pct);
    then specified_plant_depreciation_deduction(p, plant, y, round(pct * basis, 2, "HALF_UP"));
}
pub relation specified_plant_basis_after_deduction(p: Person, plant: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted basis of the specified plant after the section 168(k)(5)(A)(i) deduction (section 168(k)(5)(A)(ii))";
}
@source(IRC_S168_K, quote = "(ii) the adjusted basis of such specified plant shall be reduced by the amount of such deduction.")
rule SpecifiedPlantBasisReduced(p: Person, plant: Integer, y: TaxableYear, basis: Money, deduction: Money) defeasible {
    label en official "the basis is reduced by the deduction";
    when plant_adjusted_basis(p, plant, basis);
    when specified_plant_depreciation_deduction(p, plant, y, deduction);
    then specified_plant_basis_after_deduction(p, plant, y, basis - deduction);
}
pub relation specified_plant_not_qualified_property_in_placed_in_service_year(p: Person, plant: Integer, y: TaxableYear) kind institutional {
    label en official "a specified plant to which paragraph (5) applies is not treated as qualified property in the taxable year in which it is placed in service (section 168(k)(5)(D))";
}
@source(IRC_S168_K, quote = "such specified plant shall not be treated as qualified property in the taxable year in which placed in service.")
rule SpecifiedPlantNotQualifiedProperty(p: Person, plant: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the additional depreciation may be claimed only once";
    when specified_plant_depreciation_deduction(p, plant, y, amount);
    then specified_plant_not_qualified_property_in_placed_in_service_year(p, plant, y);
}
pub relation specified_plant_deduction_for_amti(p: Person, plant: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the specified plant deduction in computing alternative minimum taxable income: without regard to any section 56 adjustment (section 168(k)(5)(E))";
}
@source(IRC_S168_K, quote = "Rules similar to the rules of paragraph (2)(G) shall apply for purposes of this paragraph.")
rule SpecifiedPlantDeductionForAmti(p: Person, plant: Integer, y: TaxableYear, amount: Money) defeasible {
    label en official "the same rule as for qualified property";
    when specified_plant_depreciation_deduction(p, plant, y, amount);
    then specified_plant_deduction_for_amti(p, plant, y, amount);
}
pub relation secretary_consents_to_revocation_of_168k5_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation of the election under paragraph (5) (section 168(k)(5)(C))";
}
pub relation revokes_168k5_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer revokes the election under section 168(k)(5) for the year";
}
pub relation elects_168k5_revoked(p: Person, y: TaxableYear) kind institutional {
    label en official "the election under section 168(k)(5) for the year is revoked (with the consent of the Secretary)";
}
@source(IRC_S168_K, quote = "An election under this paragraph may be revoked only with the consent of the Secretary.")
rule S168k5RevocationPower(p: Person, y: TaxableYear) defeasible {
    label en official "the taxpayer may revoke the plant election only with the Secretary's consent";
    when revokes_168k5_election(p, y);
    then power S168k5RevokeElection {
        holder p;
        over y;
        exercise revokes_168k5_election(p, y);
        valid_when secretary_consents_to_revocation_of_168k5_election(p, y);
        effect create(elects_168k5_revoked(p, y));
        window [-infinity, infinity];
    };
}
