// Section 264 — life insurance, endowment and annuity contracts: stage 2b detail (TECH_GAPS G2782):
// (b) the annuity exceptions to (a)(1), (d) the new 7-year period, (e)(2)-(5) the interest rate cap,
// the key person definitions and aggregation, (f)(3)-(8) unborrowed policy cash value, exceptions,
// special rules and aggregation. Stage 1 changes: `insured_is_officer_or_twenty_percent_owner` and
// `average_unborrowed_cash_values_and_adjusted_bases_of_all_assets` are now institutional (derived here
// or asserted); `LifeInsurancePremiumBeneficiaryNotDeductible` reads the annuity exception of (b).
// Not modelled: the Secretary's allocation of the $50,000 limit within a controlled group ((e)(5)(A)(ii)),
// the reporting rules of (f)(5)(A)(iv) as a norm beyond a duty, the ordering of (f)(6)(B) against
// section 263A (external), the election of a shorter applicable period as a power (its length is a fact).

// --- (b): annuity exceptions to (a)(1) ------------------------------------------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S264_B,
    IRC_S264_D,
    IRC_S264_E,
    IRC_S264_F,
    Person,
    TaxableYear,
    average_unborrowed_cash_values_and_adjusted_bases_of_all_assets,
    deduction_allowed,
    insured_is_officer_or_twenty_percent_owner,
};

pub relation annuity_contract_described_in_72s5(item: Integer) kind empirical {
    label en official "the contract is an annuity contract described in section 72(s)(5) (section 264(b)(1))";
}
pub relation annuity_contract_to_which_72u_applies(item: Integer) kind empirical {
    label en official "the contract is an annuity contract to which section 72(u) applies (section 264(b)(2))";
}
pub relation premium_on_annuity_contract_excepted_from_264a1(item: Integer) kind institutional {
    label en official "subsection (a)(1) does not apply to the premium: the contract is one of the two annuity contracts of subsection (b)";
}
@source(IRC_S264_B, quote = "(1) any annuity contract described in section 72(s)(5), and")
rule AnnuityUnder72s5ExceptedFrom264a1(item: Integer) strict {
    label en official "a section 72(s)(5) annuity contract is outside (a)(1) (section 264(b)(1))";
    when annuity_contract_described_in_72s5(item);
    then premium_on_annuity_contract_excepted_from_264a1(item);
}
@source(IRC_S264_B, quote = "(2) any annuity contract to which section 72(u) applies.")
rule AnnuityUnder72uExceptedFrom264a1(item: Integer) strict {
    label en official "a contract to which section 72(u) applies is outside (a)(1) (section 264(b)(2))";
    when annuity_contract_to_which_72u_applies(item);
    then premium_on_annuity_contract_excepted_from_264a1(item);
}

// --- (d): the new 7-year period ------------------------------------------------------------------------------------------------------------------------------

pub relation first_premium_paid_on(contract: Integer, on: Date) kind empirical {
    label en official "the date the first premium on the contract to which the plan relates was paid (section 264(d)(1))";
}
pub relation first_substantially_increased_premium_paid_on(contract: Integer, on: Date) kind empirical {
    label en official "the date the first premium after a substantial increase in the premiums on the contract was paid (section 264(d) last sentence)";
}
pub relation seven_year_period_start_date(contract: Integer, start: Date) kind institutional {
    label en official "the date the 7-year period of section 264(d)(1) commences: the first premium, or after a substantial premium increase the first increased premium";
}
@source(IRC_S264_D, quote = "beginning with the date the first premium on the contract to which such plan relates was paid")
rule SevenYearPeriodStartsAtFirstPremium(contract: Integer, first: Date) strict {
    label en official "the 7-year period begins with the first premium (section 264(d)(1))";
    when first_premium_paid_on(contract, first);
    then seven_year_period_start_date(contract, first);
}
@source(IRC_S264_D, quote = "a new 7-year period described in such paragraph with respect to such contract shall commence on the date the first such increased premium is paid")
rule NewSevenYearPeriodAfterSubstantialPremiumIncrease(contract: Integer, increased: Date) strict {
    label en official "after a substantial premium increase a new 7-year period commences on the date the first increased premium is paid (section 264(d) last sentence); several increases give several periods, the case selects the one in issue";
    when first_substantially_increased_premium_paid_on(contract, increased);
    then seven_year_period_start_date(contract, increased);
}

// --- (e)(4),(5): 20-percent owner and aggregation ----------------------------------------------------------------------------------------------------------

pub relation taxpayer_is_corporation_264e(p: Person) kind empirical {
    label en official "the taxpayer is a corporation (section 264(e)(4)(A))";
}
pub relation insured_owns_directly_stock_percent(p: Person, insured: Integer, percent: Decimal) kind empirical {
    label en official "the share of the outstanding stock of the corporation the person owns directly (section 264(e)(4)(A))";
}
pub relation insured_stock_voting_power_percent(p: Person, insured: Integer, percent: Decimal) kind empirical {
    label en official "the share of the total combined voting power of all stock of the corporation possessed by stock the person owns (section 264(e)(4)(A))";
}
pub relation insured_capital_or_profits_interest_percent(p: Person, insured: Integer, percent: Decimal) kind empirical {
    label en official "the share of the capital or profits interest in a taxpayer that is not a corporation which the person owns (section 264(e)(4)(B))";
}
pub relation insured_is_officer_of_taxpayer(p: Person, insured: Integer) kind empirical {
    label en official "the insured is an officer of the taxpayer (section 264(e)(3))";
}
pub relation twenty_percent_owner_264e4(p: Person, insured: Integer) kind institutional {
    label en official "a 20-percent owner within section 264(e)(4)";
}
@source(IRC_S264_E, quote = "any person who owns directly 20 percent or more of the outstanding stock of the corporation")
rule TwentyPercentOwnerCorporationByStock(p: Person, insured: Integer, percent: Decimal) strict {
    label en official "a corporation's 20-percent owner by direct stock ownership (section 264(e)(4)(A))";
    when taxpayer_is_corporation_264e(p);
    when insured_owns_directly_stock_percent(p, insured, percent);
    when percent >= 0.20;
    then twenty_percent_owner_264e4(p, insured);
}
@source(IRC_S264_E, quote = "stock possessing 20 percent or more of the total combined voting power of all stock of the corporation")
rule TwentyPercentOwnerCorporationByVotingPower(p: Person, insured: Integer, percent: Decimal) strict {
    label en official "a corporation's 20-percent owner by voting power (section 264(e)(4)(A))";
    when taxpayer_is_corporation_264e(p);
    when insured_stock_voting_power_percent(p, insured, percent);
    when percent >= 0.20;
    then twenty_percent_owner_264e4(p, insured);
}
@source(IRC_S264_E, quote = "if the taxpayer is not a corporation, any person who owns 20 percent or more of the capital or profits interest in the taxpayer")
rule TwentyPercentOwnerNonCorporation(p: Person, insured: Integer, percent: Decimal) strict {
    label en official "a non-corporate taxpayer's 20-percent owner by capital or profits interest (section 264(e)(4)(B))";
    when not_known(taxpayer_is_corporation_264e(p));
    when insured_capital_or_profits_interest_percent(p, insured, percent);
    when percent >= 0.20;
    then twenty_percent_owner_264e4(p, insured);
}
@source(IRC_S264_E, quote = "the term \"key person\" means an officer or 20-percent owner")
rule InsuredIsKeyPersonCandidateOfficer(p: Person, insured: Integer) strict {
    label en official "an officer is a key person candidate (section 264(e)(3))";
    when insured_is_officer_of_taxpayer(p, insured);
    then insured_is_officer_or_twenty_percent_owner(p, insured);
}
@source(IRC_S264_E, quote = "the term \"key person\" means an officer or 20-percent owner")
rule InsuredIsKeyPersonCandidateOwner(p: Person, insured: Integer) strict {
    label en official "a 20-percent owner is a key person candidate (section 264(e)(3))";
    when twenty_percent_owner_264e4(p, insured);
    then insured_is_officer_or_twenty_percent_owner(p, insured);
}
pub relation persons_treated_as_single_employer_52_or_414(c1: Person, c2: Person) kind empirical {
    label en official "all persons treated as a single employer under subsection (a) or (b) of section 52 or subsection (m) or (o) of section 414 (section 264(e)(5)(B))";
}
pub relation members_of_controlled_group_264e5(c1: Person, c2: Person) kind institutional {
    label en official "the persons are members of a controlled group within section 264(e)(5)(B)";
}
@source(IRC_S264_E, quote = "all persons treated as a single employer under subsection (a) or (b) of section 52 or subsection (m) or (o) of section 414 shall be treated as members of a controlled group")
rule ControlledGroupDefinition264e5(c1: Person, c2: Person) strict {
    label en official "persons treated as a single employer under sections 52 and 414 are members of a controlled group (section 264(e)(5)(B))";
    when persons_treated_as_single_employer_52_or_414(c1, c2);
    then members_of_controlled_group_264e5(c1, c2);
}
pub relation treated_as_one_taxpayer_264e5(c1: Person, c2: Person) kind institutional {
    label en official "members of a controlled group are treated as one taxpayer for paragraph (4)(A) and the $50,000 limitation of paragraph (1) (section 264(e)(5)(A)(i))";
}
@source(IRC_S264_E, quote = "(i) all members of a controlled group shall be treated as one taxpayer, and")
rule ControlledGroupOneTaxpayer264e(c1: Person, c2: Person) strict {
    label en official "controlled group members are one taxpayer (section 264(e)(5)(A)(i)); the Secretary's allocation of the $50,000 is external";
    when members_of_controlled_group_264e5(c1, c2);
    then treated_as_one_taxpayer_264e5(c1, c2);
}

// --- (e)(2): the interest rate cap ------------------------------------------------------------------------------------------------------------------------------

pub relation moodys_corporate_bond_yield_average_for_month(month_index: Integer, rate: Decimal) kind empirical {
    label en official "the rate of interest described as Moody's Corporate Bond Yield Average-Monthly Average Corporates for the month (month index = year x 100 + month) (section 264(e)(2)(B)(i))";
}
pub relation policy_loan_interest_month(contract: Integer, month_index: Integer, interest: Money, indebtedness: Money) kind empirical {
    label en official "interest paid or accrued for the month on indebtedness with respect to a policy or contract that is within subsection (e)(1) or the last sentence of (a), with the amount of the indebtedness (section 264(e)(2)(A))";
}
pub relation contract_purchased_on_or_before_june_20_1986(contract: Integer) kind empirical {
    label en official "the contract was purchased on or before June 20, 1986 (section 264(e)(2)(B)(ii))";
}
pub relation contract_provides_fixed_rate_of_interest(contract: Integer, purchase_month_index: Integer) kind empirical {
    label en official "the contract provides a fixed rate of interest; the month index of its purchase (section 264(e)(2)(B)(ii)(I))";
}
pub relation contract_provides_variable_rate_reference_month(contract: Integer, month_index: Integer, reference_month_index: Integer) kind empirical {
    label en official "the contract provides a variable rate; for the month the reference month is the third month preceding the first month of the applicable period (section 264(e)(2)(B)(ii)(II))";
}
pub relation applicable_rate_of_interest(contract: Integer, month_index: Integer, rate: Decimal) kind institutional {
    label en official "the applicable rate of interest for the month: the Moody's rate for the month, or for a pre-1986 contract the fixed-rate purchase month rate or the variable-rate reference month rate (section 264(e)(2)(B))";
}
@source(IRC_S264_E, quote = "The applicable rate of interest for any month is the rate of interest described as Moody's Corporate Bond Yield Average-Monthly Average Corporates")
rule ApplicableRateGeneral(contract: Integer, month: Integer, rate: Decimal, interest: Money, debt: Money) defeasible {
    label en official "the applicable rate is the Moody's rate for the month (section 264(e)(2)(B)(i)), except for pre-1986 contracts";
    when policy_loan_interest_month(contract, month, interest, debt);
    when moodys_corporate_bond_yield_average_for_month(month, rate);
    when not_known(contract_purchased_on_or_before_june_20_1986(contract));
    then applicable_rate_of_interest(contract, month, rate);
}
@source(IRC_S264_E, quote = "the applicable rate of interest for any month shall be the Moody's rate described in clause (i) for the month in which the contract was purchased")
rule ApplicableRatePre1986FixedRate(contract: Integer, month: Integer, purchase_month: Integer, rate: Decimal, interest: Money, debt: Money) defeasible {
    label en official "a fixed-rate pre-1986 contract uses the Moody's rate of its purchase month (section 264(e)(2)(B)(ii)(I))";
    when policy_loan_interest_month(contract, month, interest, debt);
    when contract_purchased_on_or_before_june_20_1986(contract);
    when contract_provides_fixed_rate_of_interest(contract, purchase_month);
    when moodys_corporate_bond_yield_average_for_month(purchase_month, rate);
    then applicable_rate_of_interest(contract, month, rate);
}
@source(IRC_S264_E, quote = "the applicable rate of interest for any month in an applicable period shall be such Moody's rate for the third month preceding the first month in such period")
rule ApplicableRatePre1986VariableRate(contract: Integer, month: Integer, ref_month: Integer, rate: Decimal, interest: Money, debt: Money) defeasible {
    label en official "a variable-rate pre-1986 contract uses the Moody's rate of the third month before the applicable period (section 264(e)(2)(B)(ii)(II))";
    when policy_loan_interest_month(contract, month, interest, debt);
    when contract_purchased_on_or_before_june_20_1986(contract);
    when contract_provides_variable_rate_reference_month(contract, month, ref_month);
    when moodys_corporate_bond_yield_average_for_month(ref_month, rate);
    then applicable_rate_of_interest(contract, month, rate);
}
pub relation applicable_period_length_months(contract: Integer, months: Integer) kind empirical {
    label en official "the length of the applicable period: 12 months, or a number of months (not greater than 12) elected by the taxpayer (section 264(e)(2)(B)(ii) last paragraph); the election itself is not modelled";
}
pub relation interest_above_applicable_rate_cap(contract: Integer, month_index: Integer, excess: Money) kind institutional {
    label en official "the interest for the month in excess of the amount that would result from the applicable rate (indebtedness x rate / 12), for which no deduction is allowed for months after 1995 (section 264(e)(2)(A))";
}
@source(IRC_S264_E, quote = "to the extent the amount of such interest exceeds the amount which would have been determined if the applicable rate of interest were used for such month")
rule InterestAboveApplicableRateDenied(contract: Integer, month: Integer, interest: Money, debt: Money, rate: Decimal) defeasible {
    label en official "for a month after December 1995 the interest above indebtedness x applicable rate / 12 is not deductible, one rounding to cents HALF_UP (section 264(e)(2)(A))";
    when policy_loan_interest_month(contract, month, interest, debt);
    when applicable_rate_of_interest(contract, month, rate);
    when month > 199512;
    when interest > div_round(debt * rate, 12.0, 2, "HALF_UP");
    then interest_above_applicable_rate_cap(contract, month, interest - div_round(debt * rate, 12.0, 2, "HALF_UP"));
}
pub relation taxpayer_owns_contract_264e2(p: Person, contract: Integer, y: TaxableYear) kind empirical {
    label en official "the taxpayer owns the contract and the interest is that of the taxable year";
}
rule InterestAboveCapNotDeductible(p: Person, y: TaxableYear, contract: Integer, month: Integer, excess: Money) defeasible {
    label en official "the excess over the rate cap is not an allowed deduction (section 264(e)(2)(A))";
    when taxpayer_owns_contract_264e2(p, contract, y);
    when interest_above_applicable_rate_cap(contract, month, excess);
    then not deduction_allowed(p, y, Section264PolicyIndebtedness, excess);
}

// --- (f)(3): unborrowed policy cash value --------------------------------------------------------------------------------------------------------------------

pub relation policy_cash_surrender_value_without_surrender_charge(policy: Integer, amount: Money) kind empirical {
    label en official "the cash surrender value of the policy or contract determined without regard to any surrender charge (section 264(f)(3)(A))";
}
pub relation policy_loan_amount(policy: Integer, amount: Money) kind empirical {
    label en official "the amount of any loan with respect to the policy or contract (section 264(f)(3)(B))";
}
pub relation cash_surrender_value_does_not_reasonably_approximate_actual_value(policy: Integer) kind empirical {
    label en official "the amount described in subparagraph (A) does not reasonably approximate the policy's actual value (section 264(f)(3) last sentence)";
}
pub relation insurance_company_liability_or_reserve_for_policy(policy: Integer, liability: Money, reserve: Money) kind empirical {
    label en official "the insurance company liability and the insurance company reserve with respect to the policy, as determined for the annual statement approved by the National Association of Insurance Commissioners (section 264(f)(3))";
}
pub relation unborrowed_policy_cash_value(policy: Integer, amount: Money) kind institutional {
    label en official "the unborrowed policy cash value: the cash surrender value (or, if it does not reasonably approximate actual value, the greater of the insurer's liability and reserve) less loans (section 264(f)(3))";
}
@source(IRC_S264_F, quote = "the term \"unborrowed policy cash value\" means, with respect to any life insurance policy or annuity or endowment contract, the excess of")
rule UnborrowedPolicyCashValueOrdinary(policy: Integer, surrender: Money, loan: Money) defeasible {
    label en official "cash surrender value less loans, not below zero (section 264(f)(3))";
    when policy_cash_surrender_value_without_surrender_charge(policy, surrender);
    when policy_loan_amount(policy, loan);
    when not_known(cash_surrender_value_does_not_reasonably_approximate_actual_value(policy));
    then unborrowed_policy_cash_value(policy, max(0.00 USD, surrender - loan));
}
@source(IRC_S264_F, quote = "the amount taken into account under subparagraph (A) shall be the greater of the amount of the insurance company liability or the insurance company reserve")
rule UnborrowedPolicyCashValueGreaterOfLiabilityOrReserve(policy: Integer, liability: Money, reserve: Money, loan: Money) defeasible {
    label en official "where the surrender value does not reasonably approximate actual value the greater of liability and reserve replaces it, then loans are deducted (section 264(f)(3)); the Secretary's alternative amount is not modelled";
    when cash_surrender_value_does_not_reasonably_approximate_actual_value(policy);
    when insurance_company_liability_or_reserve_for_policy(policy, liability, reserve);
    when policy_loan_amount(policy, loan);
    then unborrowed_policy_cash_value(policy, max(0.00 USD, max(liability, reserve) - loan));
}

// --- (f)(4): exceptions -----------------------------------------------------------------------------------------------------------------------------------------

pub relation policy_owned_by_entity_in_trade_or_business_covering_only_one_individual(policy: Integer) kind empirical {
    label en official "the policy or contract is owned by an entity engaged in a trade or business and covers only 1 individual (section 264(f)(4)(A))";
}
pub relation covered_individual_when_first_covered_is_twenty_percent_owner(policy: Integer) kind empirical {
    label en official "at the time first covered the individual is a 20-percent owner of the entity (section 264(f)(4)(A)(i))";
}
pub relation covered_individual_when_first_covered_is_officer_director_or_employee(policy: Integer) kind empirical {
    label en official "at the time first covered the individual (not a 20-percent owner) is an officer, director or employee of the trade or business (section 264(f)(4)(A)(ii))";
}
pub relation policy_covers_joint_lives_of_owner_and_spouse(policy: Integer) kind empirical {
    label en official "the policy covers the joint lives of the 20-percent owner and the owner's spouse (section 264(f)(4)(A) last sentence)";
}
pub relation policy_covers_more_than_one_individual(policy: Integer) kind empirical {
    label en official "the policy covers more than 1 individual (other than joint lives of a 20-percent owner and spouse)";
}
pub relation annuity_contract_72u_applies_264f(policy: Integer) kind empirical {
    label en official "the annuity contract is one to which section 72(u) applies (section 264(f)(4)(B))";
}
pub relation policy_excepted_from_264f(policy: Integer) kind institutional {
    label en official "paragraph (1) does not apply to the policy or contract, and it is not taken into account under paragraph (2) (section 264(f)(4)(A)-(C))";
}
@source(IRC_S264_F, quote = "Paragraph (1) shall not apply to any policy or contract owned by an entity engaged in a trade or business if such policy or contract covers only 1 individual")
rule PolicyCoveringTwentyPercentOwnerExcepted(policy: Integer) strict {
    label en official "a single-insured policy covering a 20-percent owner at first coverage is excepted (a joint-lives policy with the owner's spouse also) (section 264(f)(4)(A)(i))";
    when policy_owned_by_entity_in_trade_or_business_covering_only_one_individual(policy);
    when covered_individual_when_first_covered_is_twenty_percent_owner(policy);
    then policy_excepted_from_264f(policy);
}
@source(IRC_S264_F, quote = "A policy or contract covering a 20-percent owner of such entity shall not be treated as failing to meet the requirements of the preceding sentence by reason of covering the joint lives of such owner and such owner's spouse.")
rule PolicyOnJointLivesOfOwnerAndSpouseExcepted(policy: Integer) strict {
    label en official "joint lives of a 20-percent owner and the spouse do not defeat the single-insured requirement (section 264(f)(4)(A))";
    when covered_individual_when_first_covered_is_twenty_percent_owner(policy);
    when policy_covers_joint_lives_of_owner_and_spouse(policy);
    then policy_excepted_from_264f(policy);
}
@source(IRC_S264_F, quote = "an individual (not described in clause (i)) who is an officer, director, or employee of such trade or business")
rule PolicyCoveringOfficerDirectorEmployeeExcepted(policy: Integer) strict {
    label en official "a single-insured policy covering an officer, director or employee at first coverage is excepted (section 264(f)(4)(A)(ii))";
    when policy_owned_by_entity_in_trade_or_business_covering_only_one_individual(policy);
    when covered_individual_when_first_covered_is_officer_director_or_employee(policy);
    then policy_excepted_from_264f(policy);
}
@source(IRC_S264_F, quote = "Paragraph (1) shall not apply to any annuity contract to which section 72(u) applies.")
rule AnnuityContractWith72uExceptedFrom264f(policy: Integer) strict {
    label en official "an annuity contract to which section 72(u) applies is excepted (section 264(f)(4)(B))";
    when annuity_contract_72u_applies_264f(policy);
    then policy_excepted_from_264f(policy);
}

// --- (f)(5): natural persons, business beneficiaries, pass-through entities -----------------------------------------------------------------------------------

pub relation policy_held_by_natural_person_264f(policy: Integer) kind empirical {
    label en official "the policy or contract is held by a natural person (section 264(f)(5)(A)(i))";
}
pub relation trade_or_business_is_beneficiary_directly_or_indirectly(policy: Integer, business: Person) kind empirical {
    label en official "a trade or business is directly or indirectly the beneficiary under the policy or contract (section 264(f)(5)(A)(ii))";
}
pub relation business_is_sole_proprietorship_or_performs_services_as_employee(business: Person) kind empirical {
    label en official "the trade or business is carried on as a sole proprietorship or performs services as an employee (section 264(f)(5)(A)(iii)(I))";
}
pub relation benefit_to_which_business_is_entitled_under_policy(policy: Integer, business: Person, amount: Money) kind empirical {
    label en official "the benefit to which the trade or business is directly or indirectly entitled under the policy or contract (section 264(f)(5)(A)(iii)(II))";
}
pub relation policy_treated_as_held_by_trade_or_business(policy: Integer, business: Person) kind institutional {
    label en official "the policy is treated as held by the trade or business and not by a natural person (section 264(f)(5)(A)(ii))";
}
@source(IRC_S264_F, quote = "If a trade or business is directly or indirectly the beneficiary under any policy or contract, such policy or contract shall be treated as held by such trade or business and not by a natural person.")
rule BusinessBeneficiaryPolicyHeldByBusiness(policy: Integer, business: Person) defeasible {
    label en official "a policy whose beneficiary is a trade or business is held by that business, unless a sole proprietorship or an employee-services business (section 264(f)(5)(A)(ii),(iii)(I))";
    when trade_or_business_is_beneficiary_directly_or_indirectly(policy, business);
    when not_known(business_is_sole_proprietorship_or_performs_services_as_employee(business));
    then policy_treated_as_held_by_trade_or_business(policy, business);
}
pub relation unborrowed_cash_value_taken_into_account_for_business_beneficiary(policy: Integer, business: Person, amount: Money) kind institutional {
    label en official "the unborrowed cash value taken into account by reason of clause (ii), not exceeding the benefit to which the business is entitled (section 264(f)(5)(A)(iii)(II))";
}
@source(IRC_S264_F, quote = "shall not exceed the benefit to which the trade or business is directly or indirectly entitled under the policy or contract")
rule BusinessBeneficiaryCashValueLimitedToBenefit(policy: Integer, business: Person, cash: Money, benefit: Money) defeasible {
    label en official "the cash value counted for a business beneficiary is the lesser of the unborrowed cash value and the benefit (section 264(f)(5)(A)(iii)(II))";
    when policy_treated_as_held_by_trade_or_business(policy, business);
    when unborrowed_policy_cash_value(policy, cash);
    when benefit_to_which_business_is_entitled_under_policy(policy, business, benefit);
    then unborrowed_cash_value_taken_into_account_for_business_beneficiary(policy, business, min(cash, benefit));
}
pub relation secretary_requires_policyholder_and_issuer_reporting_year(year: Integer) kind empirical {
    label en official "a year for which reporting from policyholders and issuers is required to carry out clause (ii) (section 264(f)(5)(A)(iv))";
}
pub relation secretary_reporting_requirement_established(year: Integer) kind empirical {
    label en official "the Secretary has required such reporting from policyholders and issuers";
}
rule SecretaryReportingDuty264f5 defeasible {
    for year: Integer;
    when secretary_requires_policyholder_and_issuer_reporting_year(year);
    then duty S264fSecretaryRequireReporting {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_reporting_requirement_established(year);
            window [-infinity, infinity];
        }
    };
}
pub relation taxpayer_is_partnership_or_s_corporation_264f(p: Person) kind empirical {
    label en official "the taxpayer is a partnership or an S corporation (section 264(f)(5)(B))";
}
pub relation section_264f_applied_at_entity_level(p: Person) kind institutional {
    label en official "subsection (f) is applied at the partnership and corporate levels (section 264(f)(5)(B))";
}
@source(IRC_S264_F, quote = "In the case of a partnership or S corporation, this subsection shall be applied at the partnership and corporate levels.")
rule Section264fAppliedAtEntityLevel(p: Person) strict {
    label en official "a partnership or S corporation applies subsection (f) at its own level (section 264(f)(5)(B))";
    when taxpayer_is_partnership_or_s_corporation_264f(p);
    then section_264f_applied_at_entity_level(p);
}

// --- (f)(6),(8): special rules and aggregation ---------------------------------------------------------------------------------------------------------------

pub relation average_unborrowed_policy_cash_values_of_all_contracts(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average unborrowed policy cash values of the taxpayer's life insurance policies and annuity and endowment contracts (section 264(f)(2)(B)(i))";
}
pub relation average_adjusted_bases_of_other_assets(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average adjusted bases (section 1016) of the taxpayer's assets that are not policies or contracts (section 264(f)(2)(B)(ii))";
}
pub relation indebtedness_with_interest_disallowed_under_264a_or_265(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of indebtedness whose interest is disallowed under subsection (a) or section 265 (section 264(f)(6)(A))";
}
@source(IRC_S264_F, quote = "the amount otherwise taken into account under paragraph (2)(B) shall be reduced (but not below zero) by the amount of such indebtedness")
rule DenominatorReducedByDisallowedIndebtedness(p: Person, y: TaxableYear, cash: Money, bases: Money, indebtedness: Money) strict {
    label en official "the denominator of (f)(2) is the sum of average cash values and adjusted bases, reduced (not below zero) by the indebtedness whose interest is disallowed under (a) or section 265 (section 264(f)(2)(B),(6)(A)(ii))";
    when average_unborrowed_policy_cash_values_of_all_contracts(p, y, cash);
    when average_adjusted_bases_of_other_assets(p, y, bases);
    when indebtedness_with_interest_disallowed_under_264a_or_265(p, y, indebtedness);
    then average_unborrowed_cash_values_and_adjusted_bases_of_all_assets(p, y, max(0.00 USD, cash + bases - indebtedness));
}
pub relation members_of_controlled_group_264f8(c1: Person, c2: Person) kind institutional {
    label en official "members of a controlled group within subsection (e)(5)(B), treated as 1 taxpayer for subsection (f) (section 264(f)(8)(A))";
}
@source(IRC_S264_F, quote = "All members of a controlled group (within the meaning of subsection (e)(5)(B)) shall be treated as 1 taxpayer for purposes of this subsection.")
rule ControlledGroupOneTaxpayer264f(c1: Person, c2: Person) strict {
    label en official "controlled group members are one taxpayer for subsection (f) (section 264(f)(8)(A))";
    when members_of_controlled_group_264e5(c1, c2);
    then members_of_controlled_group_264f8(c1, c2);
}
