// Section 162 — remaining subsections (stage 2): (b) contributions and gifts, (h) State
// legislators' travel expenses, (j) foreign advertising, (k) stock reacquisition
// expenses, (q) nondisclosure settlements of sexual harassment and abuse and (r) FDIC
// premiums. Not modelled (TECH_GAPS G2783): (a)(1)-(3) named categories (in
// `162-trade-or-business.law` as classification helpers), (d) FNMA capital
// contributions, (n) the New York group health surcharge, (o) rural mail carriers'
// qualified reimbursements and their indexation, (p) reserve component travel.
// Denials conclude `not deduction_allowed(.., Section162TradeOrBusiness, ..)` like the
// earlier subsections of this section.

// === (b): contributions and gifts allowable under section 170 ===================================

use self::{
    Corporation,
    DeductionKind,
    IRC_S162_B,
    IRC_S162_H,
    IRC_S162_J,
    IRC_S162_K,
    IRC_S162_Q,
    IRC_S162_R,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation contribution_or_gift_allowable_under_170_but_for_limits(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a contribution or gift which would be allowable as a deduction under section 170 were it not for the percentage limitations, the dollar limitations or the requirements as to the time of payment (section 162(b))";
}
@source(IRC_S162_B, quote = "No deduction shall be allowed under subsection (a) for any contribution or gift which would be allowable as a deduction under section 170")
rule ContributionOrGiftNoSection162Deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no section 162 deduction for a contribution that section 170 governs (section 162(b))";
    when contribution_or_gift_allowable_under_170_but_for_limits(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === (h): State legislators' travel expenses away from home =======================================

pub relation state_legislator_elects_162h(p: Person, y: TaxableYear) kind empirical {
    label en official "an individual who is a State legislator at any time during the year elects section 162(h) for the year, at the time and in the manner the Secretary prescribes by regulations (section 162(h)(1),(3))";
}
pub relation legislator_162h_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 162(h) election is in effect for the taxable year";
}
pub relation legislator_residence_within_fifty_miles_of_capitol(p: Person, y: TaxableYear) kind empirical {
    label en official "the place of residence within the district is 50 or fewer miles from the State capitol building (section 162(h)(4))";
}
pub relation legislative_days_in_year(p: Person, y: TaxableYear, days: Integer) kind institutional {
    label en official "the number of legislative days: days the legislature was in session (including gaps of 4 consecutive days or less) or on which the individual's physical presence was formally recorded at a committee meeting (section 162(h)(2))";
}
pub relation state_employee_per_diem_rate(p: Person, y: TaxableYear, rate: Money) kind empirical {
    label en official "the amount generally allowable per day to employees of the State for per diem while away from home (section 162(h)(1)(B)(i))";
}
pub relation federal_executive_per_diem_rate(p: Person, y: TaxableYear, rate: Money) kind empirical {
    label en official "the amount generally allowable per day to employees of the executive branch of the Federal Government for per diem while away from home but serving in the United States (section 162(h)(1)(B)(ii))";
}
@source(IRC_S162_H, quote = "For purposes of subsection (a), in the case of any individual who is a State legislator at any time during the taxable year and who makes an election under this subsection for the taxable year—")
rule StateLegislatorElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a State legislator has the power to elect the deemed travel expense treatment for the year (section 162(h)(1),(3)); the election is invalid for a legislator residing within 50 miles of the capitol, which the valid_when reads through the derived relation";
    when state_legislator_elects_162h(p, y);
    then power StateLegislatorTravelElection {
        holder p;
        over y;
        exercise state_legislator_elects_162h(p, y);
        valid_when state_legislator_election_available_162h(p, y);
        effect create(legislator_162h_election_in_effect(p, y));
        window [@1981-01-01, infinity);
    };
}
pub relation state_legislator_election_available_162h(p: Person, y: TaxableYear) kind institutional {
    label en official "the election is available: the legislator does not reside within 50 miles of the capitol (section 162(h)(4))";
}
@source(IRC_S162_H, quote = "This subsection shall not apply to any legislator whose place of residence within the legislative district which he represents is 50 or fewer miles from the capitol building of the State.")
rule LegislatorElectionAvailable(p: Person, y: TaxableYear) strict {
    label en official "the election is available unless the residence is within 50 miles";
    when state_legislator_elects_162h(p, y);
    when not_known(legislator_residence_within_fifty_miles_of_capitol(p, y));
    then state_legislator_election_available_162h(p, y);
}
pub relation deemed_legislator_living_expenses(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deemed living expenses: each legislative day times the greater of the State per diem (up to 110 percent of the Federal rate) and the Federal per diem (section 162(h)(1)(B))";
}
@source(IRC_S162_H, quote = "(B) he shall be deemed to have expended for living expenses (in connection with his trade or business as a legislator) an amount equal to the sum of the amounts determined by multiplying each legislative day of such individual during the taxable year by the greater of—")
rule DeemedLegislatorLivingExpenses(p: Person, y: TaxableYear, days: Integer, state: Money, federal: Money) defeasible {
    label en official "days x max(min(state rate, 110 percent of the Federal rate), Federal rate) (section 162(h)(1)(B))";
    when legislator_162h_election_in_effect(p, y);
    when legislative_days_in_year(p, y, days);
    when state_employee_per_diem_rate(p, y, state);
    when federal_executive_per_diem_rate(p, y, federal);
    then deemed_legislator_living_expenses(p, y, max(min(state, federal * 1.10), federal) * days);
}
@source(IRC_S162_H, quote = "he shall be deemed to be away from home in the pursuit of a trade or business on each legislative day.")
rule DeemedLegislatorExpensesAllowed(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the deemed expense is a section 162 trade or business expense, being away from home on each legislative day";
    when deemed_legislator_living_expenses(p, y, amount);
    then deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === (j): certain foreign advertising expenses =========================================================

pub relation advertisement_carried_by_foreign_broadcast_undertaking_directed_at_us_market(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the expenses of an advertisement carried by a foreign broadcast undertaking (radio, television or similar) and directed primarily to a market in the United States (section 162(j)(1))";
}
pub relation undertaking_country_denies_similar_deduction_for_us_placed_ads(p: Person, item: Integer) kind empirical {
    label en official "the foreign undertaking is located in a country that denies a similar deduction for advertising directed primarily to its market when placed with a United States broadcast undertaking (section 162(j)(1) second sentence)";
}
@source(IRC_S162_J, quote = "No deduction shall be allowed under subsection (a) for any expenses of an advertisement carried by a foreign broadcast undertaking and directed primarily to a market in the United States.")
rule ForeignBroadcastAdvertisingDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for such advertising, only where the country retaliates (section 162(j)(1))";
    when advertisement_carried_by_foreign_broadcast_undertaking_directed_at_us_market(p, y, item, amount);
    when undertaking_country_denies_similar_deduction_for_us_placed_ads(p, item);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === (k): stock reacquisition expenses ====================================================================

pub relation corporation_stock_reacquisition_expense(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid or incurred by a corporation in connection with the reacquisition of its stock or of the stock of a related person (section 465(b)(3)(C)) (section 162(k)(1))";
}
pub relation reacquisition_expense_is_interest_indebtedness_cost_or_dividend_paid(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is a deduction under section 163, an amount properly allocable to indebtedness and amortized over its term, or a dividends-paid deduction under section 561 (section 162(k)(2)(A))";
}
pub relation reacquisition_of_stock_of_open_end_regulated_investment_company(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is in connection with the redemption of stock of a regulated investment company that issues only stock redeemable on demand (section 162(k)(2)(B))";
}
@source(IRC_S162_K, quote = "no deduction otherwise allowable shall be allowed under this chapter for any amount paid or incurred by a corporation in connection with the reacquisition of its stock or of the stock of any related person")
rule StockReacquisitionExpensesDenied(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for stock reacquisition expenses, other than interest, indebtedness costs, dividends paid and open-end RIC redemptions (section 162(k))";
    when corporation_stock_reacquisition_expense(c, y, item, amount);
    when not_known(reacquisition_expense_is_interest_indebtedness_cost_or_dividend_paid(c, y, item));
    when not_known(reacquisition_of_stock_of_open_end_regulated_investment_company(c, y, item));
    then not deduction_allowed(c, y, Section162TradeOrBusiness, amount);
}

// === (q): payments related to sexual harassment or abuse ================================================

pub relation settlement_or_payment_related_to_sexual_harassment_or_abuse_subject_to_nondisclosure(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a settlement or payment related to sexual harassment or sexual abuse that is subject to a nondisclosure agreement (section 162(q)(1))";
}
pub relation attorneys_fees_related_to_such_settlement_or_payment(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "attorney's fees related to such a settlement or payment (section 162(q)(2))";
}
@source(IRC_S162_Q, quote = "any settlement or payment related to sexual harassment or sexual abuse if such settlement or payment is subject to a nondisclosure agreement")
rule NondisclosureSettlementNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for the settlement or payment (section 162(q)(1))";
    when settlement_or_payment_related_to_sexual_harassment_or_abuse_subject_to_nondisclosure(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}
@source(IRC_S162_Q, quote = "attorney's fees related to such a settlement or payment.")
rule NondisclosureSettlementAttorneysFeesNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for the related attorney's fees (section 162(q)(2))";
    when attorneys_fees_related_to_such_settlement_or_payment(p, y, item, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === (r): FDIC premiums =======================================================================================

pub relation fdic_premium_paid_or_incurred(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "an assessment under section 7(b) of the Federal Deposit Insurance Act paid or incurred by the taxpayer (section 162(r)(4))";
}
pub relation total_consolidated_assets(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total consolidated assets of the taxpayer (section 165 of the Dodd-Frank Act), as of the close of the year, the members of an expanded affiliated group being one taxpayer (section 162(r)(5),(6))";
}
pub relation fdic_premium_disallowed(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable percentage of the FDIC premium for which no deduction is allowed: none at or below $10 billion of assets, all at $50 billion or more, and in between the ratio of the excess over $10 billion to $40 billion (section 162(r))";
}
@source(IRC_S162_R, quote = "bears to")
rule FdicPremiumDisallowedProportionally(c: Corporation, y: TaxableYear, premium: Money, assets: Money) strict {
    label en official "premium x (assets - 10 billion) / 40 billion, one rounding, for assets between $10 billion and $50 billion (section 162(r)(1),(3))";
    when fdic_premium_paid_or_incurred(c, y, premium);
    when total_consolidated_assets(c, y, assets);
    when assets > 10000000000.00 USD;
    when assets < 50000000000.00 USD;
    then fdic_premium_disallowed(c, y, div_round(premium * ((assets - 10000000000.00 USD) / 1.00 USD), 40000000000.00 USD / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S162_R, quote = "No deduction shall be allowed for the applicable percentage of any FDIC premium paid or incurred by the taxpayer.")
rule FdicPremiumDisallowedAtOrAboveFiftyBillion(c: Corporation, y: TaxableYear, premium: Money, assets: Money) strict {
    label en official "at $50 billion or more of assets the applicable percentage is 100 (the ratio reaches 1)";
    when fdic_premium_paid_or_incurred(c, y, premium);
    when total_consolidated_assets(c, y, assets);
    when assets >= 50000000000.00 USD;
    then fdic_premium_disallowed(c, y, premium);
}
@source(IRC_S162_R, quote = "Paragraph (1) shall not apply to any taxpayer for any taxable year if the total consolidated assets of such taxpayer")
rule FdicPremiumNotDeductible(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "the disallowed part is not an allowed deduction";
    when fdic_premium_disallowed(c, y, amount);
    then not deduction_allowed(c, y, Section162TradeOrBusiness, amount);
}
