// Section 280G — golden parachute payments: stage 2b detail (TECH_GAPS G2799). Builds on
// `280g-golden-parachute.law`: (a) the denial, (b)(2)(B)-(C) securities-law and one-year agreements,
// (b)(4) reasonable compensation, (b)(5)-(6) exemptions, (c) disqualified individual, (d) base amount,
// property transfers and affiliated groups, (e) the covered-executive modifications. Not modelled
// (fresh TECH_GAPS id): the present value at 120 percent of the applicable Federal rate compounded
// semiannually ((d)(4): needs fractional exponentiation), the exclusion of exempt payments from the
// aggregate present value of (b)(2)(A) last sentence (the aggregate is a case fact), the ordering of
// the (b)(4) offset against the base amount (INTERPRETATION), regulations of (b)(5),(e),(f).

// --- (a): the denial ------------------------------------------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S280G_A,
    IRC_S280G_B,
    IRC_S280G_C,
    IRC_S280G_D,
    IRC_S280G_E,
    Person,
    TaxableYear,
    aggregate_present_value_contingent_payments,
    base_amount,
    deduction_allowed,
    disqualified_individual,
    excess_parachute_payment,
    parachute_payment,
    payment_contingent_on_change_in_control,
    present_value_for_280g,
    three_times_base_amount_test_met,
};

pub relation payment_otherwise_deductible_in_year(corp: Person, item: Integer, y: TaxableYear) kind empirical {
    label en official "the payment is one for which a deduction under chapter 1 would otherwise be allowed in the taxable year";
}
@source(IRC_S280G_A, quote = "No deduction shall be allowed under this chapter for any excess parachute payment.")
rule NoDeductionForExcessParachutePayment(p: Person, corp: Person, item: Integer, amount: Money, y: TaxableYear) defeasible {
    label en official "no deduction under chapter 1 for an excess parachute payment (section 280G(a)), when not reduced by reasonable compensation of (b)(4)(B)";
    when excess_parachute_payment(p, corp, item, amount);
    when payment_otherwise_deductible_in_year(corp, item, y);
    when not_known(reasonable_compensation_before_change_established(p, corp, item, amount));
    then not deduction_allowed(corp, y, Section280GExcessParachutePayment, amount);
}
pub relation excess_parachute_payment_net(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "the excess parachute payment reduced by the portion of the payment established as reasonable compensation for services actually rendered before the change (section 280G(b)(4)(B))";
}
@source(IRC_S280G_A, quote = "No deduction shall be allowed under this chapter for any excess parachute payment.")
rule NoDeductionForExcessParachutePaymentNet(p: Person, corp: Person, item: Integer, amount: Money, y: TaxableYear) defeasible {
    label en official "no deduction for the excess parachute payment as reduced under (b)(4)(B) (section 280G(a))";
    when excess_parachute_payment_net(p, corp, item, amount);
    when payment_otherwise_deductible_in_year(corp, item, y);
    then not deduction_allowed(corp, y, Section280GExcessParachutePayment, amount);
}

// --- (b)(2)(B),(C): securities-law violation and the one-year presumption ---------------------------------------------------------------

pub relation secretary_establishes_agreement_violates_generally_enforced_securities_laws(item: Integer) kind empirical {
    label en official "the occurrence of a violation of a generally enforced securities law or regulation by the agreement under which the payment is made is established by the Secretary, on whom the burden of proof lies (section 280G(b)(2)(B))";
}
pub relation payment_in_nature_of_compensation_to_disqualified_individual(p: Person, corp: Person, item: Integer, amount: Money) kind empirical {
    label en official "a payment in the nature of compensation to (or for the benefit of) a disqualified individual, made under an agreement (section 280G(b)(2)(B))";
}
@source(IRC_S280G_B, quote = "The term \"parachute payment\" shall also include any payment in the nature of compensation to (or for the benefit of) a disqualified individual if such payment is made pursuant to an agreement which violates any generally enforced securities laws or regulations.")
rule ParachutePaymentBySecuritiesLawViolationAgreement(p: Person, corp: Person, item: Integer, amount: Money) defeasible {
    label en official "a payment under an agreement the Secretary establishes to violate securities laws is a parachute payment, regardless of the 3-times test (section 280G(b)(2)(B)); the burden of proof is the Secretary's, so an unestablished violation yields nothing";
    when disqualified_individual(p, corp);
    when payment_in_nature_of_compensation_to_disqualified_individual(p, corp, item, amount);
    when secretary_establishes_agreement_violates_generally_enforced_securities_laws(item);
    then parachute_payment(p, corp, item, amount);
}
pub relation agreement_entered_or_amended_on(item: Integer, on: Date) kind empirical {
    label en official "the date the agreement under which the payment is made was entered into, or its amendment within the one-year period (section 280G(b)(2)(C))";
}
pub relation change_in_ownership_or_control_date(corp: Person, on: Date) kind empirical {
    label en official "the date of the change in ownership or effective control, or in the ownership of a substantial portion of the assets, of the corporation (section 280G(b)(2)(A)(i))";
}
pub relation contrary_established_by_clear_and_convincing_evidence(item: Integer) kind empirical {
    label en official "the contrary (that the payment is not contingent on the change) is established by clear and convincing evidence (section 280G(b)(2)(C))";
}
pub relation payment_presumed_contingent_on_change(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "the payment is presumed contingent on the change because the agreement was entered into, or amended, within 1 year before the change (section 280G(b)(2)(C))";
}
@source(IRC_S280G_B, quote = "shall be presumed to be contingent on such change unless the contrary is established by clear and convincing evidence")
rule PresumedContingentWithinOneYearBeforeChange(p: Person, corp: Person, item: Integer, amount: Money, entered: Date, changed: Date) defeasible {
    label en official "a payment under an agreement entered into or amended within 1 year before the change is presumed contingent on it, unless the contrary is established by clear and convincing evidence (section 280G(b)(2)(C))";
    when payment_in_nature_of_compensation_to_disqualified_individual(p, corp, item, amount);
    when agreement_entered_or_amended_on(item, entered);
    when change_in_ownership_or_control_date(corp, changed);
    when entered <= changed;
    when changed <= add_calendar_period(entered, 1 calendar_year);
    unless contrary_established_with_payment(p, corp, item, amount);
    then payment_presumed_contingent_on_change(p, corp, item, amount);
}
pub relation contrary_established_with_payment(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "helper: the clear-and-convincing contrary showing, keyed by the payment so that the exception binds every head variable";
}
rule ContraryEstablishedKeyed(p: Person, corp: Person, item: Integer, amount: Money) strict {
    label en official "helper for the rebuttal";
    when contrary_established_by_clear_and_convincing_evidence(item);
    when payment_in_nature_of_compensation_to_disqualified_individual(p, corp, item, amount);
    then contrary_established_with_payment(p, corp, item, amount);
}
@source(IRC_S280G_B, quote = "the aggregate present value of the payments in the nature of compensation to (or for the benefit of) such individual which are contingent on such change equals or exceeds an amount equal to 3 times the base amount")
rule ParachutePaymentByPresumedContingency(p: Person, corp: Person, item: Integer, amount: Money) defeasible {
    label en official "a presumed-contingent payment to a disqualified individual is a parachute payment once the 3-times-base-amount test is met (section 280G(b)(2)(A),(C))";
    when disqualified_individual(p, corp);
    when payment_presumed_contingent_on_change(p, corp, item, amount);
    when three_times_base_amount_test_met(p, corp);
    when not_known(payment_exempt_from_parachute_treatment(p, corp, item));
    then parachute_payment(p, corp, item, amount);
}

// --- (b)(4): reasonable compensation ------------------------------------------------------------------------------------------------------

external judgment relation reasonable_compensation_after_change_established(p: Person, corp: Person, item: Integer, amount: Money) {
    authority TaxCourt;
    label en official "the taxpayer establishes by clear and convincing evidence that the amount is reasonable compensation for personal services to be rendered on or after the date of the change (section 280G(b)(4)(A))";
}
external judgment relation reasonable_compensation_before_change_established(p: Person, corp: Person, item: Integer, amount: Money) {
    authority TaxCourt;
    label en official "the taxpayer establishes by clear and convincing evidence that the amount is reasonable compensation for personal services actually rendered before the date of the change (section 280G(b)(4)(B))";
}
pub relation parachute_amount_net_of_future_reasonable_compensation(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "the amount treated as a parachute payment after excluding the portion established as reasonable compensation for later services (section 280G(b)(4)(A))";
}
@source(IRC_S280G_B, quote = "the amount treated as a parachute payment shall not include the portion of such payment which the taxpayer establishes by clear and convincing evidence is reasonable compensation for personal services to be rendered on or after the date of the change")
rule ParachuteAmountExcludesFutureReasonableCompensation(p: Person, corp: Person, item: Integer, amount: Money, reasonable: Money) defeasible {
    label en official "the parachute amount excludes the portion established as reasonable compensation for post-change services (section 280G(b)(4)(A))";
    when parachute_payment(p, corp, item, amount);
    when reasonable_compensation_after_change_established(p, corp, item, reasonable);
    when reasonable <= amount;
    then parachute_amount_net_of_future_reasonable_compensation(p, corp, item, amount - reasonable);
}
@source(IRC_S280G_B, quote = "the amount treated as an excess parachute payment shall be reduced by the portion of such payment which the taxpayer establishes by clear and convincing evidence is reasonable compensation for personal services actually rendered before the date of the change")
rule ExcessParachuteReducedByPreChangeReasonableCompensation(p: Person, corp: Person, item: Integer, excess: Money, reasonable: Money) defeasible {
    label en official "the excess parachute payment is reduced (not below zero) by the portion established as reasonable compensation for pre-change services (section 280G(b)(4)(B)); the offset of that compensation against the base amount first is an INTERPRETATION not applied here";
    when excess_parachute_payment(p, corp, item, excess);
    when reasonable_compensation_before_change_established(p, corp, item, reasonable);
    then excess_parachute_payment_net(p, corp, item, max(0.00 USD, excess - reasonable));
}

// --- (b)(5): small business and privately held corporations ---------------------------------------------------------------------------------

pub relation payment_exempt_from_parachute_treatment(p: Person, corp: Person, item: Integer) kind institutional {
    label en official "the payment is not a parachute payment by reason of paragraph (5) or (6)";
}
pub relation corporation_was_small_business_corporation_immediately_before_change(corp: Person) kind empirical {
    label en official "immediately before the change the corporation was a small business corporation (section 1361(b), without regard to paragraph (1)(C) thereof) (section 280G(b)(5)(A)(i))";
}
pub relation no_stock_readily_tradeable_immediately_before_change(corp: Person) kind empirical {
    label en official "immediately before the change no stock in the corporation was readily tradeable on an established securities market or otherwise (section 280G(b)(5)(A)(ii)(I))";
}
pub relation payment_approved_voting_power_percent(item: Integer, percent: Decimal) kind empirical {
    label en official "the share of the voting power of all outstanding stock, held immediately before the change by the persons who approved the payment (section 280G(b)(5)(B)(i))";
}
pub relation adequate_disclosure_to_shareholders_of_all_material_facts(corp: Person) kind empirical {
    label en official "there was adequate disclosure to shareholders of all material facts concerning all payments which would otherwise be parachute payments with respect to a disqualified individual (section 280G(b)(5)(B)(ii))";
}
pub relation shareholder_approval_requirements_met(corp: Person, item: Integer) kind institutional {
    label en official "the shareholder approval requirements of section 280G(b)(5)(B) are met with respect to the payment";
}
@source(IRC_S280G_B, quote = "such payment was approved by a vote of the persons who owned, immediately before the change described in paragraph (2)(A)(i), more than 75 percent of the voting power of all outstanding stock of the corporation")
rule ShareholderApprovalRequirementsMet(corp: Person, item: Integer, percent: Decimal) strict {
    label en official "approval by more than 75 percent of the voting power and adequate disclosure meet the shareholder approval requirements (section 280G(b)(5)(B))";
    when payment_approved_voting_power_percent(item, percent);
    when percent > 0.75;
    when adequate_disclosure_to_shareholders_of_all_material_facts(corp);
    then shareholder_approval_requirements_met(corp, item);
}
@source(IRC_S280G_B, quote = "any payment to a disqualified individual with respect to a corporation which (immediately before the change described in paragraph (2)(A)(i)) was a small business corporation")
rule PaymentExemptSmallBusinessCorporation(p: Person, corp: Person, item: Integer, amount: Money) strict {
    label en official "a payment by a small business corporation is not a parachute payment (section 280G(b)(5)(A)(i))";
    when payment_contingent_on_change_in_control(p, corp, item, amount);
    when corporation_was_small_business_corporation_immediately_before_change(corp);
    then payment_exempt_from_parachute_treatment(p, corp, item);
}
@source(IRC_S280G_B, quote = "no stock in such corporation was readily tradeable on an established securities market or otherwise")
rule PaymentExemptPrivatelyHeldWithShareholderApproval(p: Person, corp: Person, item: Integer, amount: Money) strict {
    label en official "a payment by a corporation with no readily tradeable stock is not a parachute payment where the shareholder approval requirements are met (section 280G(b)(5)(A)(ii))";
    when payment_contingent_on_change_in_control(p, corp, item, amount);
    when no_stock_readily_tradeable_immediately_before_change(corp);
    when shareholder_approval_requirements_met(corp, item);
    then payment_exempt_from_parachute_treatment(p, corp, item);
}

// --- (b)(6): qualified plans ----------------------------------------------------------------------------------------------------------------------

pub relation payment_to_or_from_qualified_plan_of_kind(item: Integer, kind: RetirementPlanKind280G) kind empirical {
    label en official "the payment is to or from a plan described in section 401(a), an annuity plan under section 403(a), a simplified employee pension (section 408(k)) or a simple retirement account (section 408(p)) (section 280G(b)(6))";
}
enum RetirementPlanKind280G {
    Plan401a;
    Annuity403a;
    SimplifiedEmployeePension408k;
    SimpleRetirementAccount408p;
}
@source(IRC_S280G_B, quote = "the term \"parachute payment\" shall not include any payment to or from")
rule PaymentExemptQualifiedPlan401a(p: Person, corp: Person, item: Integer, amount: Money) strict {
    label en official "a payment to or from a section 401(a) plan is not a parachute payment (section 280G(b)(6)(A))";
    when payment_contingent_on_change_in_control(p, corp, item, amount);
    when payment_to_or_from_qualified_plan_of_kind(item, Plan401a);
    then payment_exempt_from_parachute_treatment(p, corp, item);
}
@source(IRC_S280G_B, quote = "(B) an annuity plan described in section 403(a),")
rule PaymentExemptAnnuityPlan403a(p: Person, corp: Person, item: Integer, amount: Money) strict {
    label en official "a payment to or from a section 403(a) annuity plan is not a parachute payment (section 280G(b)(6)(B))";
    when payment_contingent_on_change_in_control(p, corp, item, amount);
    when payment_to_or_from_qualified_plan_of_kind(item, Annuity403a);
    then payment_exempt_from_parachute_treatment(p, corp, item);
}
@source(IRC_S280G_B, quote = "(C) a simplified employee pension (as defined in section 408(k)), or")
rule PaymentExemptSimplifiedEmployeePension(p: Person, corp: Person, item: Integer, amount: Money) strict {
    label en official "a payment to or from a simplified employee pension is not a parachute payment (section 280G(b)(6)(C))";
    when payment_contingent_on_change_in_control(p, corp, item, amount);
    when payment_to_or_from_qualified_plan_of_kind(item, SimplifiedEmployeePension408k);
    then payment_exempt_from_parachute_treatment(p, corp, item);
}
@source(IRC_S280G_B, quote = "(D) a simple retirement account described in section 408(p).")
rule PaymentExemptSimpleRetirementAccount(p: Person, corp: Person, item: Integer, amount: Money) strict {
    label en official "a payment to or from a simple retirement account is not a parachute payment (section 280G(b)(6)(D))";
    when payment_contingent_on_change_in_control(p, corp, item, amount);
    when payment_to_or_from_qualified_plan_of_kind(item, SimpleRetirementAccount408p);
    then payment_exempt_from_parachute_treatment(p, corp, item);
}

// --- (c): disqualified individual ---------------------------------------------------------------------------------------------------------------------

pub relation performs_personal_services_for_corporation(p: Person, corp: Person) kind empirical {
    label en official "the person is an employee, independent contractor or other person specified in regulations who performs personal services for the corporation (section 280G(c)(1))";
}
pub relation is_personal_service_corporation_or_similar_entity(p: Person) kind empirical {
    label en official "the person is a personal service corporation (or similar entity), treated as an individual (section 280G(c))";
}
pub relation is_officer_of_corporation_280g(p: Person, corp: Person) kind empirical {
    label en official "the person is an officer of the corporation (or of a member of its affiliated group, section 280G(d)(5))";
}
pub relation is_shareholder_of_corporation_280g(p: Person, corp: Person) kind empirical {
    label en official "the person is a shareholder of the corporation (section 280G(c)(2))";
}
pub relation pay_rank_among_employees(p: Person, corp: Person, rank: Integer) kind empirical {
    label en official "the rank of the person's pay among the corporation's employees, 1 being highest paid (section 280G(c) last sentence)";
}
pub relation number_of_employees_of_corporation(corp: Person, count: Integer) kind empirical {
    label en official "the number of employees of the corporation";
}
pub relation highly_compensated_individual_280g(p: Person, corp: Person) kind institutional {
    label en official "a member of the group consisting of the highest paid 1 percent of the employees or, if less, the highest paid 250 employees (section 280G(c))";
}
@source(IRC_S280G_C, quote = "the highest paid 1 percent of the employees of the corporation or, if less, the highest paid 250 employees of the corporation")
rule HighlyCompensatedTopOnePercentOrTop250(p: Person, corp: Person, rank: Integer, n: Integer) strict {
    label en official "rank within the top 1 percent (rank x 100 <= employees) and within the top 250 (section 280G(c))";
    when pay_rank_among_employees(p, corp, rank);
    when number_of_employees_of_corporation(corp, n);
    when rank * 100 <= n;
    when rank <= 250;
    then highly_compensated_individual_280g(p, corp);
}
@source(IRC_S280G_C, quote = "is an officer, shareholder, or highly-compensated individual.")
rule DisqualifiedIndividualOfficer(p: Person, corp: Person) defeasible {
    label en official "a person performing services who is an officer is a disqualified individual (section 280G(c))";
    when performs_personal_services_for_corporation(p, corp);
    when is_officer_of_corporation_280g(p, corp);
    then disqualified_individual(p, corp);
}
@source(IRC_S280G_C, quote = "is an officer, shareholder, or highly-compensated individual.")
rule DisqualifiedIndividualShareholder(p: Person, corp: Person) defeasible {
    label en official "a person performing services who is a shareholder is a disqualified individual (section 280G(c))";
    when performs_personal_services_for_corporation(p, corp);
    when is_shareholder_of_corporation_280g(p, corp);
    then disqualified_individual(p, corp);
}
@source(IRC_S280G_C, quote = "is an officer, shareholder, or highly-compensated individual.")
rule DisqualifiedIndividualHighlyCompensated(p: Person, corp: Person) defeasible {
    label en official "a person performing services who is highly compensated is a disqualified individual (section 280G(c))";
    when performs_personal_services_for_corporation(p, corp);
    when highly_compensated_individual_280g(p, corp);
    then disqualified_individual(p, corp);
}

// --- (d)(1),(2): base amount ------------------------------------------------------------------------------------------------------------------------------

pub relation base_period_year_compensation(p: Person, corp: Person, ty: TaxableYear, amount: Money) kind empirical {
    label en official "compensation payable by the corporation and includible in the disqualified individual's gross income for a taxable year of the base period: the most recent 5 taxable years ending before the change, or the part of them during which the individual performed services (section 280G(d)(1),(2)); the facts are limited to base-period years";
}
@source(IRC_S280G_D, quote = "means the average annual compensation which")
rule BaseAmountAverageOverBasePeriod(p: Person, corp: Person, t0: TaxableYear, a0: Money) strict {
    label en official "the base amount is the average annual compensation includible in gross income for the base-period years (section 280G(b)(3)(A),(d)(1)); one rounding to cents HALF_UP (JUDGMENT CALL)";
    when base_period_year_compensation(p, corp, t0, a0);
    then base_amount(p, corp,
        div_round(sum all amount: Money for t: TaxableYear where base_period_year_compensation(p, corp, t, amount),
                  count(collect all yr: TaxableYear, amt: Money where base_period_year_compensation(p, corp, yr, amt)) * 1.0, 2, "HALF_UP"));
}

// --- (d)(3),(5): property transfers and affiliated groups --------------------------------------------------------------------------------------------------

pub relation property_transferred_as_contingent_payment(p: Person, corp: Person, item: Integer, fair_market_value: Money) kind empirical {
    label en official "a transfer of property, treated as a payment and taken into account at its fair market value (section 280G(d)(3))";
}
pub relation payment_amount_taken_into_account(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "the amount taken into account for a payment: a property transfer at its fair market value (section 280G(d)(3))";
}
@source(IRC_S280G_D, quote = "shall be taken into account as its fair market value")
rule PropertyTransferAtFairMarketValue(p: Person, corp: Person, item: Integer, fmv: Money) strict {
    label en official "a property transfer is a payment taken into account at fair market value (section 280G(d)(3))";
    when property_transferred_as_contingent_payment(p, corp, item, fmv);
    then payment_amount_taken_into_account(p, corp, item, fmv);
}
pub relation members_of_same_affiliated_group_1504_without_b(corp1: Person, corp2: Person) kind empirical {
    label en official "the corporations are members of the same affiliated group as defined in section 1504, determined without regard to section 1504(b) (section 280G(d)(5))";
}
pub relation regulations_provide_otherwise_for_affiliated_group(corp1: Person, corp2: Person) kind empirical {
    label en official "regulations provide otherwise for the affiliated group (section 280G(d)(5))";
}
pub relation treated_as_one_corporation_280g(corp1: Person, corp2: Person) kind institutional {
    label en official "the two members are treated as 1 corporation for section 280G (section 280G(d)(5))";
}
@source(IRC_S280G_D, quote = "all members of the same affiliated group (as defined in section 1504, determined without regard to section 1504(b)) shall be treated as 1 corporation for purposes of this section")
rule AffiliatedGroupTreatedAsOneCorporation(corp1: Person, corp2: Person) defeasible {
    label en official "except as regulations provide otherwise, all members of an affiliated group are one corporation (section 280G(d)(5))";
    when members_of_same_affiliated_group_1504_without_b(corp1, corp2);
    unless regulations_provide_otherwise_for_affiliated_group(corp1, corp2);
    then treated_as_one_corporation_280g(corp1, corp2);
}
pub relation officer_of_treated_corporation_280g(p: Person, corp: Person) kind institutional {
    label en official "a person who is an officer of a member of the group is an officer of the one corporation (section 280G(d)(5))";
}
@source(IRC_S280G_D, quote = "Any person who is an officer of any member of such group shall be treated as an officer of such 1 corporation.")
rule OfficerOfAnyMemberIsOfficerOfGroup(p: Person, member: Person, corp: Person) defeasible {
    label en official "an officer of any member of the affiliated group is an officer of the one corporation (section 280G(d)(5))";
    when is_officer_of_corporation_280g(p, member);
    when treated_as_one_corporation_280g(member, corp);
    then officer_of_treated_corporation_280g(p, corp);
}

// --- (e): covered executives (Emergency Economic Stabilization Act of 2008) ------------------------------------------------------------------------------------------

pub relation eesa_authorities_in_effect_at_severance(employer: Person, on: Date) kind empirical {
    label en official "the period during which the authorities under section 101(a) of the Emergency Economic Stabilization Act of 2008 are in effect (determined under section 120 of that Act) (section 280G(e)(1))";
}
pub relation covered_executive_of_applicable_employer(p: Person, employer: Person) kind empirical {
    label en official "a covered executive of an applicable employer, terms as in section 162(m)(5) (section 280G(e)(1),(2)(A))";
}
pub relation severance_by_involuntary_termination(p: Person, employer: Person, on: Date) kind empirical {
    label en official "severance from employment of a covered executive by reason of an involuntary termination by the employer (section 280G(e)(2)(B)(i))";
}
pub relation severance_in_connection_with_bankruptcy_liquidation_or_receivership(p: Person, employer: Person, on: Date) kind empirical {
    label en official "severance in connection with any bankruptcy, liquidation or receivership of the employer (section 280G(e)(2)(B)(ii))";
}
pub relation applicable_severance_from_employment(p: Person, employer: Person, on: Date) kind institutional {
    label en official "an applicable severance from employment of a covered executive (section 280G(e)(2)(B))";
}
@source(IRC_S280G_E, quote = "by reason of an involuntary termination of the executive by the employer")
rule ApplicableSeveranceInvoluntaryTermination(p: Person, employer: Person, on: Date) strict {
    label en official "an involuntary termination of a covered executive during the EESA period is an applicable severance (section 280G(e)(2)(B)(i))";
    when covered_executive_of_applicable_employer(p, employer);
    when severance_by_involuntary_termination(p, employer, on);
    when eesa_authorities_in_effect_at_severance(employer, on);
    then applicable_severance_from_employment(p, employer, on);
}
@source(IRC_S280G_E, quote = "in connection with any bankruptcy, liquidation, or receivership of the employer")
rule ApplicableSeveranceBankruptcy(p: Person, employer: Person, on: Date) strict {
    label en official "a severance in connection with the employer's bankruptcy, liquidation or receivership during the EESA period is an applicable severance (section 280G(e)(2)(B)(ii))";
    when covered_executive_of_applicable_employer(p, employer);
    when severance_in_connection_with_bankruptcy_liquidation_or_receivership(p, employer, on);
    when eesa_authorities_in_effect_at_severance(employer, on);
    then applicable_severance_from_employment(p, employer, on);
}
pub relation payment_made_in_applicable_taxable_year_on_account_of_severance(p: Person, employer: Person, item: Integer, amount: Money, severance_date: Date) kind empirical {
    label en official "a payment made during an applicable taxable year of the employer on account of the applicable severance from employment (section 280G(e)(1)(B))";
}
pub relation eesa_parachute_payment(p: Person, employer: Person, item: Integer, amount: Money) kind institutional {
    label en official "a payment to a covered executive treated as a parachute payment by reason of section 280G(e)";
}
@source(IRC_S280G_E, quote = "any payment made during an applicable taxable year of the employer on account of such applicable severance from employment")
rule EesaSeverancePaymentTreatedAsParachutePayment(p: Person, employer: Person, item: Integer, amount: Money, on: Date) defeasible {
    label en official "a payment made on account of an applicable severance of a covered executive is treated as contingent on the change and, when the 3-times-base test of (b)(2)(A)(ii) is met, is a parachute payment; paragraphs (b)(2)(C),(b)(4),(b)(5) and (d)(5) do not apply (section 280G(e)(1)(B),(D))";
    when applicable_severance_from_employment(p, employer, on);
    when payment_made_in_applicable_taxable_year_on_account_of_severance(p, employer, item, amount, on);
    when three_times_base_amount_test_met(p, employer);
    when not_known(parachute_payment(p, employer, item, amount));
    then eesa_parachute_payment(p, employer, item, amount);
}

// --- (b)(2)(A) last sentence: payments outside the 3-times test --------------------------------------------------------------------------------

pub relation contingent_payment_established_future_reasonable_compensation(p: Person, corp: Person, item: Integer) kind institutional {
    label en official "the taxpayer established a reasonable-compensation portion for services after the change for the payment (section 280G(b)(4)(A)); keyed helper";
}
rule ContingentPaymentEstablishedFutureReasonableKeyed(p: Person, corp: Person, item: Integer, reasonable: Money) strict {
    label en official "helper: some reasonable-compensation amount is established for the payment";
    when reasonable_compensation_after_change_established(p, corp, item, reasonable);
    then contingent_payment_established_future_reasonable_compensation(p, corp, item);
}
pub relation contingent_payment_present_value_counted(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "the present value of a contingent payment that is taken into account for the 3-times-base-amount test: payments not treated as parachute payments under paragraph (4)(A), (5) or (6) are left out (section 280G(b)(2)(A) last sentence)";
}
@source(IRC_S280G_B, quote = "For purposes of clause (ii), payments not treated as parachute payments under paragraph (4)(A), (5), or (6) shall not be taken into account.")
rule ContingentPaymentPresentValueCounted(p: Person, corp: Person, item: Integer, pv: Money) strict {
    label en official "a payment with no (4)(A) portion and no (5)/(6) exemption counts at its present value";
    when present_value_for_280g(p, corp, item, pv);
    when not_known(payment_exempt_from_parachute_treatment(p, corp, item));
    when not_known(contingent_payment_established_future_reasonable_compensation(p, corp, item));
    then contingent_payment_present_value_counted(p, corp, item, pv);
}
@source(IRC_S280G_B, quote = "For purposes of clause (ii), payments not treated as parachute payments under paragraph (4)(A), (5), or (6) shall not be taken into account.")
rule ContingentPaymentPresentValueCountedNetOfReasonable(p: Person, corp: Person, item: Integer, pv: Money, reasonable: Money) strict {
    label en official "the established reasonable compensation for later services is left out (paragraph (4)(A)); JUDGMENT CALL: the established amount is a present value at the change date and is subtracted from the payment's present value, not below zero";
    when present_value_for_280g(p, corp, item, pv);
    when reasonable_compensation_after_change_established(p, corp, item, reasonable);
    when not_known(payment_exempt_from_parachute_treatment(p, corp, item));
    then contingent_payment_present_value_counted(p, corp, item, max(0.00 USD, pv - reasonable));
}
@source(IRC_S280G_B, quote = "the aggregate present value of the payments in the nature of compensation to (or for the benefit of) such individual which are contingent on such change equals or exceeds an amount equal to 3 times the base amount")
rule AggregatePresentValueOfContingentPaymentsDerived(p: Person, corp: Person, i0: Integer, a0: Money) strict {
    label en official "the aggregate present value of the counted payments (section 280G(b)(2)(A)(ii)); an aggregate asserted by a case is still accepted";
    when contingent_payment_present_value_counted(p, corp, i0, a0);
    then aggregate_present_value_contingent_payments(p, corp,
        sum all amount: Money for item: Integer where contingent_payment_present_value_counted(p, corp, item, amount));
}
