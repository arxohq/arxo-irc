// Section 263A — capitalization and inclusion in inventory costs of certain
// expenses (UNICAP). Stage 2b, first pass. Scope: (b) applicability
// (property produced by the taxpayer; property acquired for resale under
// section 1221(a)(1)) and (i) the small-business exemption (the section
// 448(c) gross receipts test, with the tax-shelter carve-out). NOT done:
// (a) the capitalization/inventory-cost RULE itself (this module only
// classifies whether section 263A applies, not what it requires once it
// does — the allocation of costs is an EXTERNAL_DEPENDENCY on Treasury
// regulations per the task's own framing), (c) exceptions, (d) the farming
// exception, (f) interest capitalization, (g)-(h). The section 448(c)
// gross receipts test's own computation is NOT modelled — taken as an
// empirical fact (EXTERNAL_DEPENDENCY on section 448, a different
// package's owned computation).

use self::{
    IRC_S263A_B,
    IRC_S263A_I,
    Person,
    TaxableYear,
    meets_gross_receipts_test_448c,
};

pub relation property_produced_by_taxpayer(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "real or tangible personal property produced by the taxpayer (section 263A(b)(1))";
}
pub relation property_acquired_for_resale_1221a1(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "real or personal property described in section 1221(a)(1) acquired by the taxpayer for resale (section 263A(b)(2))";
}

pub relation section_263a_applies_to_property(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A applies to the property (before the (i) small-business exemption) (section 263A(b))";
}
@source(IRC_S263A_B, quote = "Real or tangible personal property produced by the taxpayer")
rule Section263aAppliesProducedProperty(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "section 263A applies to property produced by the taxpayer (section 263A(b)(1))";
    when property_produced_by_taxpayer(p, y, item);
    then section_263a_applies_to_property(p, y, item);
}
@source(IRC_S263A_B, quote = "Real or personal property described in section 1221(a)(1) which is acquired by the taxpayer for resale")
rule Section263aAppliesResaleProperty(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "section 263A applies to property acquired for resale (section 263A(b)(2))";
    when property_acquired_for_resale_1221a1(p, y, item);
    then section_263a_applies_to_property(p, y, item);
}

// --- (i): small-business exemption ------------------------------------------

// `meets_gross_receipts_test_448c` is declared in `163-interest.law`
// (section 163(j)'s own small-business exemption reads the same section
// 448(c) test) and reused here rather than redeclared (LDC-E1201).
pub relation tax_shelter_prohibited_cash_method_448a3(p: Person) kind empirical {
    label en official "the taxpayer is a tax shelter prohibited from using the cash receipts and disbursements method under section 448(a)(3), disqualifying it from the section 263A(i) exemption regardless of gross receipts";
}
pub relation section_263a_small_business_exempt(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer is exempt from section 263A for the taxable year under the small-business exemption (section 263A(i)(1))";
}
@source(IRC_S263A_I, quote = "which meets the gross receipts test of section 448(c) for any taxable year, this section shall not apply with respect to such taxpayer for such taxable year")
rule Section263aSmallBusinessExemption(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer (other than a disqualified tax shelter) meeting the section 448(c) gross receipts test is exempt from section 263A for the year (section 263A(i)(1))";
    when meets_gross_receipts_test_448c(p, y);
    when not_known(tax_shelter_prohibited_cash_method_448a3(p));
    then section_263a_small_business_exempt(p, y);
}
// (i)(2)'s aggregation rule (treating each trade or business of a
// non-corporate, non-partnership taxpayer as its own corporation or
// partnership for the gross receipts test) is NOT modelled — TECH_GAP.

pub relation section_263a_applies(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A applies to the property for the taxable year, after the (i) small-business exemption (section 263A(b),(i))";
}
@source(IRC_S263A_I, quote = "this section shall not apply with respect to such taxpayer for such taxable year")
rule Section263aAppliesAfterExemption(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "section 263A applies to the property for the year unless the taxpayer is small-business exempt for that year (section 263A(b) as limited by (i))";
    when section_263a_applies_to_property(p, y, item);
    when not_known(section_263a_small_business_exempt(p, y));
    then section_263a_applies(p, y, item);
}
// (a) (the capitalization requirement and cost-allocation rule itself),
// (c) exceptions, (d) farming, (f) interest capitalization, (g)-(h) are
// NOT DONE this session — EXTERNAL_DEPENDENCY per the task's own framing
// ("the allocation itself is an external dependency on regulations").
