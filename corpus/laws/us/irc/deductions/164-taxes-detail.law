// Section 164 — taxes: stage 2b detail (TECH_GAPS G2802): (c) taxes not deductible (local
// benefits, taxes treated as imposed on another taxpayer), (d) apportionment of real property
// taxes on a sale, (e) a corporation's payment of a shareholder's tax, (f) the deduction for one-half
// of self-employment tax. The stage 1 general rule `TaxDeductionGeneralRule` is now guarded by the
// two (c) exclusions (`tax_assessed_against_local_benefits`,
// `real_property_tax_treated_as_imposed_on_other_taxpayer`). Not modelled: the section 275 and 7871
// cross references of (g) (external); days of the real property tax year are counted with
// days_between (tax year start to the day before the sale).

// --- (c)(1): local benefit taxes --------------------------------------------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S164_C,
    IRC_S164_D,
    IRC_S164_E,
    IRC_S164_F,
    Individual,
    Person,
    TaxKind164,
    TaxableYear,
    deduction_allowed,
    tax_paid_or_accrued,
};

pub relation tax_assessed_against_local_benefits(item: Integer) kind empirical {
    label en official "taxes assessed against local benefits of a kind tending to increase the value of the property assessed (section 164(c)(1))";
}
pub relation local_benefit_tax_portion_for_maintenance_or_interest(item: Integer, amount: Money) kind empirical {
    label en official "so much of the local benefit tax as is properly allocable to maintenance or interest charges (section 164(c)(1))";
}
@source(IRC_S164_C, quote = "(1) Taxes assessed against local benefits of a kind tending to increase the value of the property assessed")
rule LocalBenefitTaxNotDeductibleExceptMaintenanceOrInterest(p: Person, y: TaxableYear, item: Integer, kind: TaxKind164, amount: Money, portion: Money) strict {
    label en official "no deduction for a local benefit tax except the part allocable to maintenance or interest charges (section 164(c)(1))";
    when tax_paid_or_accrued(p, y, item, kind, amount);
    when tax_assessed_against_local_benefits(item);
    when local_benefit_tax_portion_for_maintenance_or_interest(item, portion);
    when amount > portion;
    then not deduction_allowed(p, y, Section164Taxes, amount - portion);
}
@source(IRC_S164_C, quote = "but this paragraph shall not prevent the deduction of so much of such taxes as is properly allocable to maintenance or interest charges")
rule LocalBenefitTaxMaintenanceOrInterestPortionDeductible(p: Person, y: TaxableYear, item: Integer, kind: TaxKind164, amount: Money, portion: Money) strict {
    label en official "the part of a local benefit tax allocable to maintenance or interest charges remains deductible (section 164(c)(1))";
    when tax_paid_or_accrued(p, y, item, kind, amount);
    when tax_assessed_against_local_benefits(item);
    when local_benefit_tax_portion_for_maintenance_or_interest(item, portion);
    then deduction_allowed(p, y, Section164Taxes, portion);
}

// --- (d)(1): apportionment on a sale ---------------------------------------------------------------------------------------------------------------

pub relation real_property_tax_for_tax_year(item: Integer, amount: Money) kind empirical {
    label en official "the real property tax for the real property tax year in which the property is sold (section 164(d)(1))";
}
pub relation real_property_tax_year_first_day(item: Integer, on: Date) kind empirical {
    label en official "the first day of the real property tax year";
}
pub relation real_property_tax_year_last_day(item: Integer, on: Date) kind empirical {
    label en official "the last day of the real property tax year";
}
pub relation real_property_sale_date_164d(item: Integer, on: Date) kind empirical {
    label en official "the date the real property is sold during the real property tax year (section 164(d)(1))";
}
pub relation real_property_tax_treated_as_imposed_on_seller(item: Integer, amount: Money) kind institutional {
    label en official "so much of the real property tax as is properly allocable to the part of the year ending on the day before the sale is treated as a tax imposed on the seller (section 164(d)(1)(A))";
}
pub relation real_property_tax_treated_as_imposed_on_purchaser(item: Integer, amount: Money) kind institutional {
    label en official "so much of the tax as is properly allocable to the part of the year beginning on the date of the sale is treated as a tax imposed on the purchaser (section 164(d)(1)(B))";
}
@source(IRC_S164_D, quote = "so much of the real property tax as is properly allocable to that part of such year which ends on the day before the date of the sale shall be treated as a tax imposed on the seller")
rule RealPropertyTaxSellerPartByDays(item: Integer, tax: Money, first: Date, last: Date, sold: Date) strict {
    label en official "the seller's share is the tax times the days before the sale over the days of the tax year, one rounding to cents HALF_UP (the statute says 'properly allocable': a daily allocation is the reading applied; JUDGMENT CALL)";
    when real_property_tax_for_tax_year(item, tax);
    when real_property_tax_year_first_day(item, first);
    when real_property_tax_year_last_day(item, last);
    when real_property_sale_date_164d(item, sold);
    when sold >= first;
    when sold <= last;
    then real_property_tax_treated_as_imposed_on_seller(item, div_round(tax * days_between(first, sold), (days_between(first, last) + 1) * 1.0, 2, "HALF_UP"));
}
@source(IRC_S164_D, quote = "so much of such tax as is properly allocable to that part of such year which begins on the date of the sale shall be treated as a tax imposed on the purchaser")
rule RealPropertyTaxPurchaserPartIsRemainder(item: Integer, tax: Money, seller: Money) strict {
    label en official "the purchaser's share is the remainder of the tax after the seller's share (section 164(d)(1)(B))";
    when real_property_tax_for_tax_year(item, tax);
    when real_property_tax_treated_as_imposed_on_seller(item, seller);
    then real_property_tax_treated_as_imposed_on_purchaser(item, tax - seller);
}
pub relation seller_of_real_property(p: Person, item: Integer) kind empirical {
    label en official "the person is the seller of the real property";
}
pub relation purchaser_of_real_property(p: Person, item: Integer) kind empirical {
    label en official "the person is the purchaser of the real property";
}
pub relation real_property_tax_treated_as_imposed_on_other_taxpayer(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the real property tax paid by the person is, to the extent subsection (d) requires, treated as imposed on another taxpayer (section 164(c)(2))";
}
pub relation real_property_tax_paid_by_person_for_year(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a real property tax paid by the person for the real property tax year of the sale";
}
@source(IRC_S164_C, quote = "(2) Taxes on real property, to the extent that subsection (d) requires such taxes to be treated as imposed on another taxpayer.")
rule SellerPaidTaxAfterSaleImposedOnPurchaser(p: Person, y: TaxableYear, item: Integer, amount: Money, purchaser_part: Money) strict {
    label en official "the seller cannot deduct the part treated as imposed on the purchaser (section 164(c)(2),(d)(1)(B))";
    when seller_of_real_property(p, item);
    when real_property_tax_paid_by_person_for_year(p, y, item, amount);
    when real_property_tax_treated_as_imposed_on_purchaser(item, purchaser_part);
    then real_property_tax_treated_as_imposed_on_other_taxpayer(p, y, item);
}
@source(IRC_S164_C, quote = "(2) Taxes on real property, to the extent that subsection (d) requires such taxes to be treated as imposed on another taxpayer.")
rule PurchaserPaidTaxBeforeSaleImposedOnSeller(p: Person, y: TaxableYear, item: Integer, amount: Money, seller_part: Money) strict {
    label en official "the purchaser cannot deduct the part treated as imposed on the seller (section 164(c)(2),(d)(1)(A))";
    when purchaser_of_real_property(p, item);
    when real_property_tax_paid_by_person_for_year(p, y, item, amount);
    when real_property_tax_treated_as_imposed_on_seller(item, seller_part);
    then real_property_tax_treated_as_imposed_on_other_taxpayer(p, y, item);
}

// --- (d)(2): special rules ------------------------------------------------------------------------------------------------------------------------------

pub relation method_of_accounting_deducts_taxes_only_when_paid(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer may not, by reason of his method of accounting, deduct any amount for taxes unless paid (section 164(d)(2)(A)(i))";
}
pub relation other_party_liable_for_real_property_tax_under_imposing_law(item: Integer) kind empirical {
    label en official "the other party to the sale is, under the law imposing the real property tax, liable for the tax for the real property tax year (section 164(d)(2)(A)(ii))";
}
pub relation neither_party_liable_and_other_party_held_property_when_lien_attached(item: Integer) kind empirical {
    label en official "neither party is liable for the tax, and the other party held the property at the time the tax became a lien (section 164(d)(2)(A) last sentence)";
}
pub relation taxpayer_treated_as_having_paid_tax_on_sale_date(p: Person, item: Integer, sale_date: Date, amount: Money) kind institutional {
    label en official "the taxpayer is treated as having paid, on the date of the sale, so much of the tax as is treated as imposed on the taxpayer (section 164(d)(2)(A))";
}
@source(IRC_S164_D, quote = "then for purposes of subsection (a) the taxpayer shall be treated as having paid, on the date of the sale, so much of such tax as, under paragraph (1) of this subsection, is treated as imposed on the taxpayer")
rule CashMethodSellerTreatedAsHavingPaidOnSaleDate(p: Person, item: Integer, y: TaxableYear, sold: Date, seller: Money) strict {
    label en official "a cash-method seller is treated as paying the seller's share on the sale date where the other party is liable under the imposing law (or holds the property at the lien date if neither is liable) (section 164(d)(2)(A))";
    when seller_of_real_property(p, item);
    when method_of_accounting_deducts_taxes_only_when_paid(p, y);
    when other_party_liable_for_real_property_tax_under_imposing_law(item);
    when real_property_sale_date_164d(item, sold);
    when real_property_tax_treated_as_imposed_on_seller(item, seller);
    then taxpayer_treated_as_having_paid_tax_on_sale_date(p, item, sold, seller);
}
@source(IRC_S164_D, quote = "if neither party is liable for the tax, then the party holding the property at the time the tax becomes a lien on the property shall be considered liable for the real property tax for the real property tax year")
rule CashMethodSellerNeitherPartyLiableLienHolder(p: Person, item: Integer, y: TaxableYear, sold: Date, seller: Money) strict {
    label en official "where neither party is liable, the other party holding the property at the lien date is considered liable (section 164(d)(2)(A))";
    when seller_of_real_property(p, item);
    when method_of_accounting_deducts_taxes_only_when_paid(p, y);
    when neither_party_liable_and_other_party_held_property_when_lien_attached(item);
    when real_property_sale_date_164d(item, sold);
    when real_property_tax_treated_as_imposed_on_seller(item, seller);
    then taxpayer_treated_as_having_paid_tax_on_sale_date(p, item, sold, seller);
}
pub relation taxpayer_uses_accrual_method_and_no_461c_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer's taxable income for the year of the sale is computed under an accrual method and no election under section 461(c) applies (section 164(d)(2)(B))";
}
pub relation portion_imposed_on_taxpayer_not_deductible_by_reason_of_accounting_method(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "that portion of the tax treated as imposed on the taxpayer that may not, by reason of the taxpayer's method of accounting, be deducted for any taxable year (section 164(d)(2)(B)(ii))";
}
pub relation portion_treated_as_accrued_on_sale_date(p: Person, item: Integer, sale_date: Date, amount: Money) kind institutional {
    label en official "the portion treated as imposed on the taxpayer and not otherwise deductible is treated as having accrued on the date of the sale (section 164(d)(2)(B))";
}
@source(IRC_S164_D, quote = "shall be treated as having accrued on the date of the sale")
rule AccrualMethodPortionAccruedOnSaleDate(p: Person, y: TaxableYear, item: Integer, sold: Date, portion: Money) strict {
    label en official "for an accrual-method taxpayer without a section 461(c) election the non-deductible portion accrues on the sale date (section 164(d)(2)(B))";
    when taxpayer_uses_accrual_method_and_no_461c_election(p, y);
    when portion_imposed_on_taxpayer_not_deductible_by_reason_of_accounting_method(p, item, portion);
    when real_property_sale_date_164d(item, sold);
    then portion_treated_as_accrued_on_sale_date(p, item, sold, portion);
}

// --- (e): corporation pays a shareholder's tax ---------------------------------------------------------------------------------------------------------

pub relation corporation_pays_tax_imposed_on_shareholder_as_shareholder(corp: Person, shareholder: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a corporation pays a tax imposed on a shareholder on his interest as a shareholder (section 164(e))";
}
pub relation shareholder_reimburses_corporation_for_tax(corp: Person, shareholder: Person, y: TaxableYear) kind empirical {
    label en official "the shareholder reimburses the corporation for the tax (section 164(e))";
}
@source(IRC_S164_E, quote = "(1) the deduction allowed by subsection (a) shall be allowed to the corporation")
rule ShareholderTaxPaidByCorporationDeductibleByCorporation(corp: Person, shareholder: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "where the corporation pays a shareholder's tax and is not reimbursed, the corporation may deduct it (section 164(e)(1))";
    when corporation_pays_tax_imposed_on_shareholder_as_shareholder(corp, shareholder, y, amount);
    unless shareholder_reimburses_corporation_keyed(corp, shareholder, y, amount);
    then deduction_allowed(corp, y, Section164Taxes, amount);
}
@source(IRC_S164_E, quote = "(2) no deduction shall be allowed the shareholder for such tax")
rule ShareholderTaxPaidByCorporationNotDeductibleByShareholder(corp: Person, shareholder: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the shareholder has no deduction for a tax the corporation pays without reimbursement (section 164(e)(2))";
    when corporation_pays_tax_imposed_on_shareholder_as_shareholder(corp, shareholder, y, amount);
    unless shareholder_reimburses_corporation_keyed(corp, shareholder, y, amount);
    then not deduction_allowed(shareholder, y, Section164Taxes, amount);
}
pub relation shareholder_reimburses_corporation_keyed(corp: Person, shareholder: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "helper: reimbursement keyed by the payment so that the exception binds every head variable";
}
rule ReimbursementKeyed(corp: Person, shareholder: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper for the reimbursement exception";
    when shareholder_reimburses_corporation_for_tax(corp, shareholder, y);
    when corporation_pays_tax_imposed_on_shareholder_as_shareholder(corp, shareholder, y, amount);
    then shareholder_reimburses_corporation_keyed(corp, shareholder, y, amount);
}

// --- (f): one-half of self-employment tax ------------------------------------------------------------------------------------------------------------------

pub relation self_employment_tax_1401_for_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxes imposed by section 1401 for the taxable year, other than the taxes imposed by section 1401(b)(2) (section 164(f)(1))";
}
pub relation half_of_self_employment_tax_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for one-half of the section 1401 taxes (section 164(f)(1))";
}
@source(IRC_S164_F, quote = "there shall be allowed as a deduction for the taxable year an amount equal to one-half of the taxes imposed by section 1401")
rule HalfOfSelfEmploymentTaxDeductible(p: Individual, y: TaxableYear, tax: Money) strict {
    label en official "an individual may deduct one-half of the section 1401 taxes (other than 1401(b)(2)); one rounding to cents HALF_UP (JUDGMENT CALL) (section 164(f)(1))";
    when self_employment_tax_1401_for_year(p, y, tax);
    then half_of_self_employment_tax_deduction(p, y, div_round(tax, 2.0, 2, "HALF_UP"));
}
@source(IRC_S164_F, quote = "there shall be allowed as a deduction for the taxable year an amount equal to one-half of the taxes imposed by section 1401")
rule HalfOfSelfEmploymentTaxAllowedAsDeduction(p: Individual, y: TaxableYear, half: Money) strict {
    label en official "the half is an allowed deduction (section 164(f)(1))";
    when half_of_self_employment_tax_deduction(p, y, half);
    then deduction_allowed(p, y, Section164fSelfEmploymentTax, half);
}
pub relation deduction_treated_as_attributable_to_non_employee_trade_or_business(p: Individual, y: TaxableYear) kind institutional {
    label en official "the section 164(f)(1) deduction is treated as attributable to a trade or business carried on by the taxpayer which does not consist of the performance of services as an employee (section 164(f)(2))";
}
@source(IRC_S164_F, quote = "shall be treated as attributable to a trade or business carried on by the taxpayer which does not consist of the performance of services by the taxpayer as an employee")
rule HalfSelfEmploymentTaxAttributableToNonEmployeeBusiness(p: Individual, y: TaxableYear, half: Money) strict {
    label en official "the deduction counts as attributable to a non-employee trade or business (section 164(f)(2))";
    when half_of_self_employment_tax_deduction(p, y, half);
    then deduction_treated_as_attributable_to_non_employee_trade_or_business(p, y);
}
