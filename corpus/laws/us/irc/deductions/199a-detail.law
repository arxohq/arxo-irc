// Section 199A — stage 2c detail (TECH_GAPS G2773-G2778): (c) qualified business income from the qualified
// items, the exceptions, the loss carryover and the treatment of compensation and guaranteed payments;
// (f)(1) the partner, shareholder and fiduciary level, the Puerto Rico rules and (f)(2) the minimum tax;
// (g) the cooperative deduction: taxable income without section 1382 deductions, wages, qualified
// production activities income, domestic production gross receipts, the specified cooperative, the
// expanded affiliated group, the oil-related reduction, the section 511 substitution and the patrons'
// qualified payment; (h) the Secretary's anti-abuse duty.
// G2772 (the indexed threshold amounts before 2025) stays SOURCE_GAP: only Rev. Proc. 2024-40 (2025) and
// Rev. Proc. 2025-32 (2026) are pinned.
//
// Stage 1 interface changes (recorded): `qualified_business_income`, `w2_wages_for_business`,
// `ubia_for_business`, `cooperative_qualified_production_activities_income`,
// `cooperative_taxable_income_before_199a` and `cooperative_w2_wages` are now institutional (derived below,
// or still asserted by a case).
//
// JUDGMENT CALLS: (1) an item's sign carries its nature: income and gain positive, deduction and loss
// negative; (2) the loss carried into the succeeding year is applied to a business by a case fact (the
// allocation among businesses is not fixed by the statute); (3) a partner's shares of items, wages and UBIA
// are percentages of the case (wages as wage expense, UBIA as depreciation), an S corporation shareholder's
// share is the pro rata share, and a trust or estate apportions wages and UBIA by the income allocated;
// (4) for the cooperative group the deduction is computed on the members' sums and allocated by each
// member's qualified production activities income; (5) the exports-for-further-manufacture cap limits the
// increase to the value added abroad; (6) amounts are rounded to cents HALF_UP.

// === (c)(3): qualified items =======================================================================================

use self::{
    Corporation,
    IRC_S199A_C,
    IRC_S199A_F,
    IRC_S199A_G,
    IRC_S199A_H,
    Individual,
    Person,
    TaxableYear,
    cooperative_qualified_production_activities_income,
    cooperative_taxable_income_before_199a,
    cooperative_w2_wages,
    qualified_business_income,
    qualified_trade_or_business_199a,
    section_199a_g1_cooperative_deduction,
    section_199a_g2_patron_deduction,
    ubia_for_business,
    w2_wages_for_business,
};

pub enum QbiExclusionKind {
    CapitalGainOrLoss;
    DividendOrPaymentInLieu954c1G;
    NonBusinessInterest;
    Section954c1CDGainOrLoss;
    Section954c1FItem;
    AnnuityNotInBusiness;
    DeductionAllocableToExcludedAmount;
    QualifiedReitDividendOrPtpIncome;
    ReasonableCompensationToTaxpayer;
    GuaranteedPayment707c;
    Payment707aPerRegulations;
}
pub relation business_item(p: Individual, y: TaxableYear, business: Integer, item: Integer, amount: Money) kind empirical {
    label en official "an item of income or gain (positive) or deduction or loss (negative) of the trade or business (section 199A(c)(3))";
}
pub relation item_effectively_connected_in_united_states(p: Individual, y: TaxableYear, business: Integer, item: Integer) kind empirical {
    label en official "the item is effectively connected with the conduct of a trade or business within the United States, as section 864(c) reads with a qualified trade or business (section 199A(c)(3)(A)(i))";
}
pub relation item_from_puerto_rico_business(p: Individual, y: TaxableYear, business: Integer, item: Integer) kind empirical {
    label en official "the item is from a trade or business within the Commonwealth of Puerto Rico (section 199A(f)(1)(C)(i))";
}
pub relation puerto_rico_income_all_taxable_under_section_1(p: Individual, y: TaxableYear) kind empirical {
    label en official "all the taxpayer's qualified business income from sources within Puerto Rico is taxable under section 1 for the year (section 199A(f)(1)(C)(i))";
}
pub relation item_treated_as_effectively_connected_199a(p: Individual, y: TaxableYear, business: Integer, item: Integer) kind institutional {
    label en official "the item is effectively connected with a United States trade or business, the United States including Puerto Rico where paragraph (f)(1)(C)(i) applies";
}
@source(IRC_S199A_C, quote = "(i) effectively connected with the conduct of a trade or business within the United States")
rule ItemEffectivelyConnected(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "effectively connected with a United States trade or business (section 199A(c)(3)(A)(i))";
    when item_effectively_connected_in_united_states(p, y, business, item);
    then item_treated_as_effectively_connected_199a(p, y, business, item);
}
@source(IRC_S199A_F, quote = "then for purposes of determining the qualified business income of such taxpayer for such taxable year, the term \"United States\" shall include the Commonwealth of Puerto Rico.")
rule ItemEffectivelyConnectedPuertoRico(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "a Puerto Rico item counts when all the Puerto Rico income is taxable under section 1";
    when item_from_puerto_rico_business(p, y, business, item);
    when puerto_rico_income_all_taxable_under_section_1(p, y);
    then item_treated_as_effectively_connected_199a(p, y, business, item);
}
pub relation item_included_or_allowed_in_taxable_income(p: Individual, y: TaxableYear, business: Integer, item: Integer) kind empirical {
    label en official "the item is included or allowed in determining taxable income for the taxable year (section 199A(c)(3)(A)(ii))";
}
pub relation item_of_excluded_kind(p: Individual, y: TaxableYear, business: Integer, item: Integer, kind: QbiExclusionKind) kind empirical {
    label en official "the item is of the stated kind that section 199A(c)(3)(B) or (c)(4) or (c)(1) keeps out of qualified business income";
}
pub relation item_is_section_1385a1_amount(p: Individual, y: TaxableYear, business: Integer, item: Integer) kind empirical {
    label en official "the amount is described in section 1385(a)(1), which is not treated as a dividend for clause (ii) (section 199A(c)(3)(B)(ii))";
}
pub relation item_is_notional_principal_contract_1221a7(p: Individual, y: TaxableYear, business: Integer, item: Integer) kind empirical {
    label en official "the item is attributable to a notional principal contract entered into in a transaction qualifying under section 1221(a)(7) (section 199A(c)(3)(B)(v))";
}
pub relation qbi_item_excluded(p: Individual, y: TaxableYear, business: Integer, item: Integer) kind institutional {
    label en official "the item is not taken into account as a qualified item (section 199A(c)(3)(B), (c)(4), (c)(1))";
}
@source(IRC_S199A_C, quote = "(i) Any item of short-term capital gain, short-term capital loss, long-term capital gain, or long-term capital loss.")
rule QbiExcludesCapital(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "capital gain or loss items";
    when item_of_excluded_kind(p, y, business, item, CapitalGainOrLoss);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "Any amount described in section 1385(a)(1) shall not be treated as described in this clause.")
rule QbiExcludesDividends(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "a dividend or payment in lieu of dividends, other than a section 1385(a)(1) amount";
    when item_of_excluded_kind(p, y, business, item, DividendOrPaymentInLieu954c1G);
    when not_known(item_is_section_1385a1_amount(p, y, business, item));
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(iii) Any interest income other than interest income which is properly allocable to a trade or business.")
rule QbiExcludesNonBusinessInterest(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "interest income not allocable to the business";
    when item_of_excluded_kind(p, y, business, item, NonBusinessInterest);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(iv) Any item of gain or loss described in subparagraph (C) or (D) of section 954(c)(1)")
rule QbiExcludes954c1CD(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "items of section 954(c)(1)(C) and (D)";
    when item_of_excluded_kind(p, y, business, item, Section954c1CDGainOrLoss);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(v) Any item of income, gain, deduction, or loss taken into account under section 954(c)(1)(F)")
rule QbiExcludes954c1F(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "items of section 954(c)(1)(F), other than notional principal contract items of section 1221(a)(7) transactions";
    when item_of_excluded_kind(p, y, business, item, Section954c1FItem);
    when not_known(item_is_notional_principal_contract_1221a7(p, y, business, item));
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(vi) Any amount received from an annuity which is not received in connection with the trade or business.")
rule QbiExcludesAnnuity(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "an annuity amount not received in connection with the business";
    when item_of_excluded_kind(p, y, business, item, AnnuityNotInBusiness);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(vii) Any item of deduction or loss properly allocable to an amount described in any of the preceding clauses.")
rule QbiExcludesAllocableDeduction(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "a deduction or loss allocable to an excluded amount";
    when item_of_excluded_kind(p, y, business, item, DeductionAllocableToExcludedAmount);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "Such term shall not include any qualified REIT dividends or qualified publicly traded partnership income.")
rule QbiExcludesReitAndPtp(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "qualified REIT dividends and qualified publicly traded partnership income are outside qualified business income";
    when item_of_excluded_kind(p, y, business, item, QualifiedReitDividendOrPtpIncome);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(A) reasonable compensation paid to the taxpayer by any qualified trade or business of the taxpayer for services rendered with respect to the trade or business,")
rule QbiExcludesReasonableCompensation(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "reasonable compensation paid to the taxpayer by its own business";
    when item_of_excluded_kind(p, y, business, item, ReasonableCompensationToTaxpayer);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(B) any guaranteed payment described in section 707(c) paid to a partner for services rendered with respect to the trade or business, and")
rule QbiExcludesGuaranteedPayment(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "a section 707(c) guaranteed payment for services";
    when item_of_excluded_kind(p, y, business, item, GuaranteedPayment707c);
    then qbi_item_excluded(p, y, business, item);
}
@source(IRC_S199A_C, quote = "(C) to the extent provided in regulations, any payment described in section 707(a) to a partner for services rendered with respect to the trade or business.")
rule QbiExcludesPayment707a(p: Individual, y: TaxableYear, business: Integer, item: Integer) strict {
    label en official "a section 707(a) payment for services, to the extent the regulations so provide (a fact of the case)";
    when item_of_excluded_kind(p, y, business, item, Payment707aPerRegulations);
    then qbi_item_excluded(p, y, business, item);
}
pub relation qualified_item_199a(p: Individual, y: TaxableYear, business: Integer, item: Integer, amount: Money) kind institutional {
    label en official "a qualified item of income, gain, deduction or loss of the business (section 199A(c)(3)(A))";
}
@source(IRC_S199A_C, quote = "The term \"qualified items of income, gain, deduction, and loss\" means items of income, gain, deduction, and loss to the extent such items are—")
rule QualifiedItem199a(p: Individual, y: TaxableYear, business: Integer, item: Integer, amount: Money) strict {
    label en official "effectively connected with a United States trade or business, included or allowed in taxable income, and not excluded";
    when business_item(p, y, business, item, amount);
    when item_treated_as_effectively_connected_199a(p, y, business, item);
    when item_included_or_allowed_in_taxable_income(p, y, business, item);
    when not_known(qbi_item_excluded(p, y, business, item));
    then qualified_item_199a(p, y, business, item, amount);
}

// === (c)(1),(2): the net amount and the loss carryover =========================================================

pub relation qbi_qualified_items_net(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the net amount of the qualified items of the business (section 199A(c)(1))";
}
@source(IRC_S199A_C, quote = "The term \"qualified business income\" means, for any taxable year, the net amount of qualified items of income, gain, deduction, and loss with respect to any qualified trade or business of the taxpayer.")
rule QbiQualifiedItemsNet(p: Individual, y: TaxableYear, business: Integer, i0: Integer, a0: Money) strict {
    label en official "the sum of the qualified items";
    when qualified_item_199a(p, y, business, i0, a0);
    then qbi_qualified_items_net(p, y, business, sum all amount: Money for item: Integer where qualified_item_199a(p, y, business, item, amount));
}
pub relation qbi_loss_carryover_applied(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind empirical {
    label en official "the loss carried from the preceding taxable year and treated as a loss from a qualified trade or business of this year, as a positive amount applied to the business (section 199A(c)(2))";
}
pub relation qbi_carryover_applied_projection(p: Individual, y: TaxableYear, business: Integer) kind institutional {
    label en official "helper: a carried loss is applied to the business";
}
rule QbiCarryoverAppliedKeyed(p: Individual, y: TaxableYear, business: Integer, amount: Money) strict {
    label en official "helper: keys the carried loss by business and year";
    when qbi_loss_carryover_applied(p, y, business, amount);
    then qbi_carryover_applied_projection(p, y, business);
}
@source(IRC_S199A_C, quote = "If the net amount of qualified income, gain, deduction, and loss with respect to qualified trades or businesses of the taxpayer for any taxable year is less than zero, such amount shall be treated as a loss from a qualified trade or business in the succeeding taxable year.")
rule QualifiedBusinessIncomeWithoutCarryover(p: Individual, y: TaxableYear, business: Integer, net: Money) strict {
    label en official "the net amount of the qualified items; an amount asserted by a case is still accepted";
    when qbi_qualified_items_net(p, y, business, net);
    when not_known(qbi_carryover_applied_projection(p, y, business));
    then qualified_business_income(p, y, business, net);
}
@source(IRC_S199A_C, quote = "such amount shall be treated as a loss from a qualified trade or business in the succeeding taxable year.")
rule QualifiedBusinessIncomeWithCarryover(p: Individual, y: TaxableYear, business: Integer, net: Money, carried: Money) strict {
    label en official "the net amount less the loss carried from the preceding year";
    when qbi_qualified_items_net(p, y, business, net);
    when qbi_loss_carryover_applied(p, y, business, carried);
    then qualified_business_income(p, y, business, net - carried);
}
pub relation qbi_total_net_for_year(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net amount of qualified items with respect to all the qualified trades or businesses of the taxpayer for the year (section 199A(c)(2))";
}
@source(IRC_S199A_C, quote = "If the net amount of qualified income, gain, deduction, and loss with respect to qualified trades or businesses of the taxpayer for any taxable year is less than zero")
rule QbiTotalNetForYear(p: Individual, y: TaxableYear, b0: Integer, a0: Money) strict {
    label en official "the sum over the qualified trades or businesses";
    when qbi_qualified_items_net(p, y, b0, a0);
    when qualified_trade_or_business_199a(p, y, b0);
    then qbi_total_net_for_year(p, y, sum all amount: Money for b: Integer where qbi_qualified_items_net(p, y, b, amount) and qualified_trade_or_business_199a(p, y, b));
}
pub relation succeeding_taxable_year_199a(y: TaxableYear, next: TaxableYear) kind empirical {
    label en official "the succeeding taxable year (section 199A(c)(2))";
}
pub relation qbi_loss_carryover_to_succeeding_year(p: Individual, y: TaxableYear, next: TaxableYear, amount: Money) kind institutional {
    label en official "the net loss of the year, treated as a loss from a qualified trade or business in the succeeding taxable year (section 199A(c)(2))";
}
@source(IRC_S199A_C, quote = "such amount shall be treated as a loss from a qualified trade or business in the succeeding taxable year.")
rule QbiLossCarryoverToSucceedingYear(p: Individual, y: TaxableYear, next: TaxableYear, total: Money) strict {
    label en official "a negative net amount carries to the succeeding year as a loss";
    when qbi_total_net_for_year(p, y, total);
    when succeeding_taxable_year_199a(y, next);
    when total < 0.00 USD;
    then qbi_loss_carryover_to_succeeding_year(p, y, next, 0.00 USD - total);
}

// === (f)(1): partnerships, S corporations, trusts and estates; Puerto Rico; minimum tax =====================================

pub relation passthrough_entity_is_partnership(pte: Integer) kind empirical {
    label en official "the pass-through entity is a partnership (section 199A(f)(1)(A))";
}
pub relation passthrough_entity_is_s_corporation(pte: Integer) kind empirical {
    label en official "the pass-through entity is an S corporation (section 199A(f)(1)(A))";
}
pub relation passthrough_entity_is_trust_or_estate(pte: Integer) kind empirical {
    label en official "the entity is an estate or trust (section 199A(f)(1)(B))";
}
pub relation passthrough_entity_qualified_item(pte: Integer, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a qualified item of income, gain, deduction or loss of the partnership or S corporation for the year (section 199A(f)(1)(A)(ii))";
}
pub relation passthrough_entity_w2_wages(pte: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the W-2 wages of the partnership or S corporation for the year (section 199A(f)(1)(A)(iii))";
}
pub relation passthrough_entity_ubia(pte: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the unadjusted basis immediately after acquisition of qualified property of the partnership or S corporation for the year (section 199A(f)(1)(A)(iii))";
}
pub relation partner_allocable_share_of_items_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the partner's allocable share of each qualified item, as a percentage (section 199A(f)(1)(A)(ii))";
}
pub relation partner_wage_expense_share_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the partner's allocable share of the partnership's wage expenses, as a percentage (section 199A(f)(1)(A) last sentences)";
}
pub relation partner_depreciation_share_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the partner's allocable share of the partnership's depreciation, as a percentage (section 199A(f)(1)(A) last sentences)";
}
pub relation shareholder_pro_rata_share_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the S corporation shareholder's pro rata share of an item, as a percentage (section 199A(f)(1)(A) last sentence)";
}
pub relation fiduciary_income_allocated_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the share of the estate's or trust's income allocated to the beneficiary or the entity itself, the basis for apportioning wages and unadjusted basis (section 199A(f)(1)(B), section 199(d)(1)(B)(i))";
}
pub relation owner_item_share_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the owner's share of each qualified item of the pass-through entity, as a percentage";
}
@source(IRC_S199A_F, quote = "(ii) each partner or shareholder shall take into account such person's allocable share of each qualified item of income, gain, deduction, and loss, and")
rule OwnerItemShareOfPartner(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "a partner's allocable share";
    when passthrough_entity_is_partnership(pte);
    when partner_allocable_share_of_items_percent(p, pte, y, pct);
    then owner_item_share_percent(p, pte, y, pct);
}
@source(IRC_S199A_F, quote = "For purposes of this subparagraph, in the case of an S corporation, an allocable share shall be the shareholder's pro rata share of an item.")
rule OwnerItemShareOfShareholder(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "a shareholder's pro rata share";
    when passthrough_entity_is_s_corporation(pte);
    when shareholder_pro_rata_share_percent(p, pte, y, pct);
    then owner_item_share_percent(p, pte, y, pct);
}
@source(IRC_S199A_F, quote = "(i) this section shall be applied at the partner or shareholder level,")
rule OwnerQualifiedItemShare(p: Individual, pte: Integer, y: TaxableYear, item: Integer, amount: Money, pct: Decimal) strict {
    label en official "the owner takes its share of each qualified item of the entity into account, the business being the entity";
    when passthrough_entity_qualified_item(pte, y, item, amount);
    when owner_item_share_percent(p, pte, y, pct);
    then qualified_item_199a(p, y, pte, item, div_round(amount * pct, 100.0, 2, "HALF_UP"));
}
pub relation owner_wage_share_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the owner's share of the entity's W-2 wages as a percentage: the wage expense share of a partner, the pro rata share of a shareholder, the income allocated for a fiduciary";
}
@source(IRC_S199A_F, quote = "For purposes of clause (iii), a partner's or shareholder's allocable share of W–2 wages shall be determined in the same manner as the partner's or shareholder's allocable share of wage expenses.")
rule OwnerWageSharePartner(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "a partner's wage expense share";
    when passthrough_entity_is_partnership(pte);
    when partner_wage_expense_share_percent(p, pte, y, pct);
    then owner_wage_share_percent(p, pte, y, pct);
}
@source(IRC_S199A_F, quote = "For purposes of this subparagraph, in the case of an S corporation, an allocable share shall be the shareholder's pro rata share of an item.")
rule OwnerWageShareShareholder(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "a shareholder's pro rata share";
    when passthrough_entity_is_s_corporation(pte);
    when shareholder_pro_rata_share_percent(p, pte, y, pct);
    then owner_wage_share_percent(p, pte, y, pct);
}
@source(IRC_S199A_F, quote = "Rules similar to the rules under section 199(d)(1)(B)(i) (as in effect on December 1, 2017) for the apportionment of W–2 wages shall apply to the apportionment of W–2 wages")
rule OwnerWageShareFiduciary(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "an estate or trust apportions wages by the income allocated";
    when passthrough_entity_is_trust_or_estate(pte);
    when fiduciary_income_allocated_percent(p, pte, y, pct);
    then owner_wage_share_percent(p, pte, y, pct);
}
pub relation owner_ubia_share_percent(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the owner's share of the entity's unadjusted basis as a percentage: the depreciation share of a partner, the pro rata share of a shareholder, the income allocated for a fiduciary";
}
@source(IRC_S199A_F, quote = "For purposes of such clause, partner's or shareholder's allocable share of the unadjusted basis immediately after acquisition of qualified property shall be determined in the same manner as the partner's or shareholder's allocable share of depreciation.")
rule OwnerUbiaSharePartner(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "a partner's depreciation share";
    when passthrough_entity_is_partnership(pte);
    when partner_depreciation_share_percent(p, pte, y, pct);
    then owner_ubia_share_percent(p, pte, y, pct);
}
@source(IRC_S199A_F, quote = "For purposes of this subparagraph, in the case of an S corporation, an allocable share shall be the shareholder's pro rata share of an item.")
rule OwnerUbiaShareShareholder(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "a shareholder's pro rata share";
    when passthrough_entity_is_s_corporation(pte);
    when shareholder_pro_rata_share_percent(p, pte, y, pct);
    then owner_ubia_share_percent(p, pte, y, pct);
}
@source(IRC_S199A_F, quote = "and the apportionment of unadjusted basis immediately after acquisition of qualified property under this section.")
rule OwnerUbiaShareFiduciary(p: Individual, pte: Integer, y: TaxableYear, pct: Decimal) strict {
    label en official "an estate or trust apportions unadjusted basis by the income allocated";
    when passthrough_entity_is_trust_or_estate(pte);
    when fiduciary_income_allocated_percent(p, pte, y, pct);
    then owner_ubia_share_percent(p, pte, y, pct);
}
pub relation business_w2_wages_reported(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind empirical {
    label en official "the W-2 wages of the taxpayer's own trade or business for the year (section 199A(b)(4))";
}
pub relation business_conducted_in_puerto_rico(p: Individual, y: TaxableYear, business: Integer) kind empirical {
    label en official "the qualified trade or business is conducted in Puerto Rico (section 199A(f)(1)(C)(ii))";
}
pub relation remuneration_excluded_under_3401a8(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind empirical {
    label en official "remuneration for services in Puerto Rico excluded from wages under section 3401(a)(8) (section 199A(f)(1)(C)(ii))";
}
@source(IRC_S199A_F, quote = "the determination of W–2 wages of such taxpayer with respect to any qualified trade or business conducted in Puerto Rico shall be made without regard to any exclusion under section 3401(a)(8) for remuneration paid for services in Puerto Rico.")
rule W2WagesOwnBusinessOrdinary(p: Individual, y: TaxableYear, business: Integer, wages: Money) strict {
    label en official "the wages of an own business outside Puerto Rico (or without the Puerto Rico rule)";
    when business_w2_wages_reported(p, y, business, wages);
    when not_known(business_conducted_in_puerto_rico(p, y, business));
    then w2_wages_for_business(p, y, business, wages);
}
@source(IRC_S199A_F, quote = "the determination of W–2 wages of such taxpayer with respect to any qualified trade or business conducted in Puerto Rico shall be made without regard to any exclusion under section 3401(a)(8) for remuneration paid for services in Puerto Rico.")
rule W2WagesPuertoRico(p: Individual, y: TaxableYear, business: Integer, wages: Money, excluded: Money) strict {
    label en official "the wages plus the remuneration excluded under section 3401(a)(8)";
    when business_w2_wages_reported(p, y, business, wages);
    when business_conducted_in_puerto_rico(p, y, business);
    when puerto_rico_income_all_taxable_under_section_1(p, y);
    when remuneration_excluded_under_3401a8(p, y, business, excluded);
    then w2_wages_for_business(p, y, business, wages + excluded);
}
@source(IRC_S199A_F, quote = "(iii) each partner or shareholder shall be treated for purposes of subsection (b) as having W–2 wages and unadjusted basis immediately after acquisition")
rule W2WagesOwnerShare(p: Individual, y: TaxableYear, pte: Integer, wages: Money, pct: Decimal) strict {
    label en official "the owner is treated as having its share of the entity's W-2 wages";
    when passthrough_entity_w2_wages(pte, y, wages);
    when owner_wage_share_percent(p, pte, y, pct);
    then w2_wages_for_business(p, y, pte, div_round(wages * pct, 100.0, 2, "HALF_UP"));
}
pub relation business_ubia_reported(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind empirical {
    label en official "the unadjusted basis immediately after acquisition of the qualified property of the taxpayer's own business (section 199A(b)(2)(B)(ii))";
}
rule UbiaOwnBusiness(p: Individual, y: TaxableYear, business: Integer, amount: Money) strict {
    label en official "the unadjusted basis of an own business";
    when business_ubia_reported(p, y, business, amount);
    then ubia_for_business(p, y, business, amount);
}
@source(IRC_S199A_F, quote = "(iii) each partner or shareholder shall be treated for purposes of subsection (b) as having W–2 wages and unadjusted basis immediately after acquisition")
rule UbiaOwnerShare(p: Individual, y: TaxableYear, pte: Integer, ubia: Money, pct: Decimal) strict {
    label en official "the owner is treated as having its share of the entity's unadjusted basis";
    when passthrough_entity_ubia(pte, y, ubia);
    when owner_ubia_share_percent(p, pte, y, pct);
    then ubia_for_business(p, y, pte, div_round(ubia * pct, 100.0, 2, "HALF_UP"));
}
pub relation qbi_for_alternative_minimum_tax(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "qualified business income for alternative minimum taxable income: determined without regard to the adjustments under sections 56 through 59 (section 199A(f)(2))";
}
@source(IRC_S199A_F, quote = "For purposes of determining alternative minimum taxable income under section 55, qualified business income shall be determined without regard to any adjustments under sections 56 through 59.")
rule QbiForAmtWithoutAdjustments(p: Individual, y: TaxableYear, business: Integer, amount: Money) strict {
    label en official "the regular-tax qualified business income is used";
    when qualified_business_income(p, y, business, amount);
    then qbi_for_alternative_minimum_tax(p, y, business, amount);
}

// === (h): the Secretary's anti-abuse duty ================================================================================

pub relation taxable_year_with_section_199a_deduction(y: TaxableYear) kind empirical {
    label en official "a taxable year for which section 199A applies";
}
pub relation secretary_applies_179d2_type_rules_against_depreciable_period_manipulation(y: TaxableYear) kind empirical {
    label en official "the Secretary has applied rules similar to those of section 179(d)(2) to prevent manipulation of the depreciable period of qualified property through related-party transactions (section 199A(h)(1))";
}
pub relation secretary_prescribes_ubia_rules_for_exchanges_and_conversions(y: TaxableYear) kind empirical {
    label en official "the Secretary has prescribed rules for the unadjusted basis of qualified property acquired in like-kind exchanges or involuntary conversions (section 199A(h)(2))";
}
@source(IRC_S199A_H, quote = "(1) apply rules similar to the rules under section 179(d)(2) in order to prevent the manipulation of the depreciable period of qualified property using transactions between related parties, and")
rule SecretaryAntiAbuseDepreciablePeriodDuty defeasible {
    for y: TaxableYear;
    when taxable_year_with_section_199a_deduction(y);
    then duty S199AhApplySection179d2TypeRules {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_applies_179d2_type_rules_against_depreciable_period_manipulation(y);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S199A_H, quote = "(2) prescribe rules for determining the unadjusted basis immediately after acquisition of qualified property acquired in like-kind exchanges or involuntary conversions.")
rule SecretaryUbiaExchangeRulesDuty defeasible {
    for y: TaxableYear;
    when taxable_year_with_section_199a_deduction(y);
    then duty S199AhPrescribeUbiaRulesForExchanges {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_prescribes_ubia_rules_for_exchanges_and_conversions(y);
            window [-infinity, infinity];
        }
    };
}

// === (g)(4): the specified agricultural or horticultural cooperative ===============================================

pub relation cooperative_subject_to_subchapter_t_part_i(c: Corporation) kind empirical {
    label en official "the organization is one to which part I of subchapter T applies (section 199A(g)(4)(A))";
}
pub relation cooperative_engaged_in_producing_agricultural_or_horticultural_products(c: Corporation) kind empirical {
    label en official "the cooperative is engaged in the manufacturing, production, growth or extraction in whole or significant part of an agricultural or horticultural product (section 199A(g)(4)(A)(i))";
}
pub relation cooperative_engaged_in_marketing_agricultural_or_horticultural_products(c: Corporation) kind empirical {
    label en official "the cooperative is engaged in the marketing of agricultural or horticultural products (section 199A(g)(4)(A)(ii))";
}
pub relation specified_agricultural_or_horticultural_cooperative(c: Corporation) kind institutional {
    label en official "a specified agricultural or horticultural cooperative (section 199A(g)(4)(A))";
}
@source(IRC_S199A_G, quote = "(i) in the manufacturing, production, growth, or extraction in whole or significant part of any agricultural or horticultural product, or")
rule SpecifiedCooperativeProducing(c: Corporation) strict {
    label en official "a subchapter T cooperative producing agricultural or horticultural products";
    when cooperative_subject_to_subchapter_t_part_i(c);
    when cooperative_engaged_in_producing_agricultural_or_horticultural_products(c);
    then specified_agricultural_or_horticultural_cooperative(c);
}
@source(IRC_S199A_G, quote = "(ii) in the marketing of agricultural or horticultural products.")
rule SpecifiedCooperativeMarketing(c: Corporation) strict {
    label en official "a subchapter T cooperative marketing agricultural or horticultural products";
    when cooperative_subject_to_subchapter_t_part_i(c);
    when cooperative_engaged_in_marketing_agricultural_or_horticultural_products(c);
    then specified_agricultural_or_horticultural_cooperative(c);
}
pub relation patrons_produced_product_marketed_by_cooperative(c: Corporation, product: Integer) kind empirical {
    label en official "the patrons of the marketing cooperative manufactured, produced, grew or extracted the product it markets in whole or significant part (section 199A(g)(4)(B))";
}
pub relation cooperative_produced_product(c: Corporation, product: Integer) kind empirical {
    label en official "the cooperative itself manufactured, produced, grew or extracted the product in whole or significant part";
}
pub relation cooperative_treated_as_producer_of_product(c: Corporation, product: Integer) kind institutional {
    label en official "the cooperative is treated as having manufactured, produced, grown or extracted the product (section 199A(g)(3)(D)(i),(4)(B))";
}
@source(IRC_S199A_G, quote = "A specified agricultural or horticultural cooperative described in subparagraph (A)(ii) shall be treated as having manufactured, produced, grown, or extracted in whole or significant part any agricultural or horticultural product marketed by the specified agricultural or horticultural cooperative which its patrons have so manufactured, produced, grown, or extracted.")
rule MarketingCooperativeTreatedAsProducer(c: Corporation, product: Integer) strict {
    label en official "a marketing cooperative is treated as the producer of its patrons' products";
    when cooperative_engaged_in_marketing_agricultural_or_horticultural_products(c);
    when specified_agricultural_or_horticultural_cooperative(c);
    when patrons_produced_product_marketed_by_cooperative(c, product);
    then cooperative_treated_as_producer_of_product(c, product);
}
@source(IRC_S199A_G, quote = "which was manufactured, produced, grown, or extracted by the taxpayer (determined after the application of paragraph (4)(B)) in whole or significant part within the United States.")
rule CooperativeOwnProducerOfProduct(c: Corporation, product: Integer) strict {
    label en official "the cooperative's own product";
    when cooperative_produced_product(c, product);
    then cooperative_treated_as_producer_of_product(c, product);
}

// === (g)(3)(D): domestic production gross receipts ========================================================================

pub relation cooperative_gross_receipt(c: Corporation, y: TaxableYear, item: Integer, product: Integer, amount: Money) kind empirical {
    label en official "a gross receipt of the cooperative for the year, derived from the disposition of the product (section 199A(g)(3)(D)(i))";
}
pub relation receipt_from_lease_rental_license_sale_exchange_or_disposition(c: Corporation, item: Integer) kind empirical {
    label en official "the receipt is derived from a lease, rental, license, sale, exchange or other disposition of an agricultural or horticultural product (section 199A(g)(3)(D)(i))";
}
pub relation product_produced_in_whole_or_significant_part_in_united_states(c: Corporation, product: Integer) kind empirical {
    label en official "the product was manufactured, produced, grown or extracted in whole or significant part within the United States (section 199A(g)(3)(D)(i))";
}
pub relation receipt_derived_from_disposition_of_land(c: Corporation, item: Integer) kind empirical {
    label en official "the receipt is derived from the lease, rental, license, sale, exchange or other disposition of land (section 199A(g)(3)(D)(i))";
}
pub relation receipt_from_property_rented_for_use_by_related_person(c: Corporation, item: Integer) kind empirical {
    label en official "the receipt is derived from property leased, licensed or rented for use by a related person, related persons being those treated as a single employer under section 52(a),(b) (without section 1563(b)) or 414(m),(o) (section 199A(g)(3)(D)(ii))";
}
pub relation receipt_attributable_to_actual_conduct_of_trade_or_business(c: Corporation, item: Integer) kind empirical {
    label en official "the item is attributable to the actual conduct of a trade or business (section 199A(g)(5)(C))";
}
pub relation domestic_production_gross_receipt(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "a receipt that is domestic production gross receipts (section 199A(g)(3)(D))";
}
@source(IRC_S199A_G, quote = "The term \"domestic production gross receipts\" means the gross receipts of the taxpayer which are derived from any lease, rental, license, sale, exchange, or other disposition of any agricultural or horticultural product")
rule DomesticProductionGrossReceipt(c: Corporation, y: TaxableYear, item: Integer, product: Integer, amount: Money) strict {
    label en official "a receipt from the disposition of a product produced by the cooperative in the United States, not from land, not from property rented to a related person, attributable to the actual conduct of a trade or business";
    when cooperative_gross_receipt(c, y, item, product, amount);
    when receipt_from_lease_rental_license_sale_exchange_or_disposition(c, item);
    when cooperative_treated_as_producer_of_product(c, product);
    when product_produced_in_whole_or_significant_part_in_united_states(c, product);
    when receipt_attributable_to_actual_conduct_of_trade_or_business(c, item);
    when not_known(receipt_derived_from_disposition_of_land(c, item));
    when not_known(receipt_from_property_rented_for_use_by_related_person(c, item));
    then domestic_production_gross_receipt(c, y, item, amount);
}
pub relation cooperative_domestic_production_gross_receipts(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the domestic production gross receipts of the cooperative for the year (section 199A(g)(3)(A)(i))";
}
rule CooperativeDomesticProductionGrossReceiptsTotal(c: Corporation, y: TaxableYear, i0: Integer, a0: Money) strict {
    label en official "the sum of the domestic production gross receipts";
    when domestic_production_gross_receipt(c, y, i0, a0);
    then cooperative_domestic_production_gross_receipts(c, y, sum all amount: Money for item: Integer where domestic_production_gross_receipt(c, y, item, amount));
}

// === (g)(3)(A),(C): qualified production activities income ==================================================================

pub relation cost_of_goods_sold_allocable_to_dpgr(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cost of goods sold allocable to the domestic production gross receipts, before the section 199A(g)(3)(C) adjustments (section 199A(g)(3)(A)(ii)(I))";
}
pub relation other_expenses_allocable_to_dpgr(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "other expenses, losses or deductions, other than the deduction of subsection (g), properly allocable to the domestic production gross receipts (section 199A(g)(3)(A)(ii)(II))";
}
pub relation imported_item_cost(c: Corporation, y: TaxableYear, item: Integer, actual_cost: Money, value_on_entry: Money) kind empirical {
    label en official "an item or service brought into the United States: its actual cost and its value immediately after it entered (section 199A(g)(3)(C)(i))";
}
pub relation imported_item_exported_for_further_manufacture(c: Corporation, item: Integer, value_when_exported: Money, value_when_brought_back: Money) kind empirical {
    label en official "the item had been exported by the taxpayer for further manufacture: its value when exported and when brought back (section 199A(g)(3)(C)(ii))";
}
pub relation imported_item_cost_for_cogs(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the cost of an imported item for the cost of goods sold: treated as acquired by purchase at not less than its value on entry; for an item exported for further manufacture the increase is limited to the value added (section 199A(g)(3)(C))";
}
@source(IRC_S199A_G, quote = "any item or service brought into the United States shall be treated as acquired by purchase, and its cost shall be treated as not less than its value immediately after it entered the United States.")
rule ImportedItemCostNotLessThanValue(c: Corporation, y: TaxableYear, item: Integer, cost: Money, value: Money) strict {
    label en official "the larger of the actual cost and the value on entry";
    when imported_item_cost(c, y, item, cost, value);
    when not_known(imported_item_exported_for_further_manufacture_keyed(c, item));
    then imported_item_cost_for_cogs(c, y, item, max(cost, value));
}
pub relation imported_item_exported_for_further_manufacture_keyed(c: Corporation, item: Integer) kind institutional {
    label en official "helper: the item was exported for further manufacture";
}
rule ImportedItemExportedKeyed(c: Corporation, item: Integer, exported: Money, back: Money) strict {
    label en official "helper: keys the export by item";
    when imported_item_exported_for_further_manufacture(c, item, exported, back);
    then imported_item_exported_for_further_manufacture_keyed(c, item);
}
@source(IRC_S199A_G, quote = "the increase in cost or adjusted basis under clause (i) shall not exceed the difference between the value of the property when exported and the value of the property when brought back into the United States after the further manufacture.")
rule ImportedItemExportedCostCapped(c: Corporation, y: TaxableYear, item: Integer, cost: Money, value: Money, exported: Money, back: Money) strict {
    label en official "the increase over the actual cost is limited to the value added by the further manufacture";
    when imported_item_cost(c, y, item, cost, value);
    when imported_item_exported_for_further_manufacture(c, item, exported, back);
    then imported_item_cost_for_cogs(c, y, item, cost + min(max(0.00 USD, value - cost), max(0.00 USD, back - exported)));
}
pub relation cooperative_partnership_qpai_share(c: Corporation, y: TaxableYear, partnership: Integer, amount: Money) kind institutional {
    label en official "the cooperative partner's allocable share of the partnership's qualified production activities income, rules similar to section 199A(f)(1) (section 199A(g)(5)(B))";
}
pub relation partnership_qualified_production_activities_income(partnership: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified production activities income of the partnership for the year";
}
pub relation cooperative_partner_share_percent(c: Corporation, partnership: Integer, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the cooperative partner's allocable share of the partnership's items, as a percentage";
}
@source(IRC_S199A_G, quote = "In the case of a specified agricultural or horticultural cooperative which is a partner in a partnership, rules similar to the rules of subsection (f)(1) shall apply for purposes of this subsection.")
rule CooperativePartnershipQpaiShare(c: Corporation, y: TaxableYear, partnership: Integer, qpai: Money, pct: Decimal) strict {
    label en official "the partner's share of the partnership's qualified production activities income";
    when partnership_qualified_production_activities_income(partnership, y, qpai);
    when cooperative_partner_share_percent(c, partnership, y, pct);
    then cooperative_partnership_qpai_share(c, y, partnership, div_round(qpai * pct, 100.0, 2, "HALF_UP"));
}
pub relation cooperative_own_qpai_before_partnerships(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the cooperative's own qualified production activities income: the domestic production gross receipts over the sum of the cost of goods sold and the other allocable expenses (section 199A(g)(3)(A))";
}
@source(IRC_S199A_G, quote = "The term \"qualified production activities income\" for any taxable year means an amount equal to the excess (if any) of—")
rule CooperativeOwnQpai(c: Corporation, y: TaxableYear, dpgr: Money, cogs: Money, other: Money) strict {
    label en official "the excess, if any, of the receipts over the cost of goods sold and the other allocable expenses";
    when cooperative_domestic_production_gross_receipts(c, y, dpgr);
    when cost_of_goods_sold_allocable_to_dpgr(c, y, cogs);
    when other_expenses_allocable_to_dpgr(c, y, other);
    then cooperative_own_qpai_before_partnerships(c, y, max(0.00 USD, dpgr - cogs - other));
}
pub relation cooperative_has_partnership_qpai_share(c: Corporation, y: TaxableYear) kind institutional {
    label en official "helper: the cooperative has a partnership share of qualified production activities income";
}
rule CooperativeHasPartnershipShareKeyed(c: Corporation, y: TaxableYear, partnership: Integer, amount: Money) strict {
    label en official "helper: keys the partnership share by cooperative and year";
    when cooperative_partnership_qpai_share(c, y, partnership, amount);
    then cooperative_has_partnership_qpai_share(c, y);
}
@source(IRC_S199A_G, quote = "The term \"qualified production activities income\" for any taxable year means an amount equal to the excess (if any) of—")
rule CooperativeQpaiOwnOnly(c: Corporation, y: TaxableYear, own: Money) strict {
    label en official "the qualified production activities income of a cooperative with no partnership share; an amount asserted by a case is still accepted";
    when cooperative_own_qpai_before_partnerships(c, y, own);
    when not_known(cooperative_has_partnership_qpai_share(c, y));
    then cooperative_qualified_production_activities_income(c, y, own);
}
@source(IRC_S199A_G, quote = "In the case of a specified agricultural or horticultural cooperative which is a partner in a partnership, rules similar to the rules of subsection (f)(1) shall apply for purposes of this subsection.")
rule CooperativeQpaiWithPartnerships(c: Corporation, y: TaxableYear, own: Money, p0: Integer, s0: Money) strict {
    label en official "the own income plus the shares of the partnerships";
    when cooperative_own_qpai_before_partnerships(c, y, own);
    when cooperative_partnership_qpai_share(c, y, p0, s0);
    then cooperative_qualified_production_activities_income(c, y, own + sum all amount: Money for partnership: Integer where cooperative_partnership_qpai_share(c, y, partnership, amount));
}

// === (g)(1)(B),(C): wages and taxable income of the cooperative ==========================================================

pub relation cooperative_w2_wages_of_year(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the W-2 wages of the cooperative determined as under section 199A(b)(4) without subparagraph (B) and after (b)(5) (section 199A(g)(1)(B)(ii))";
}
pub relation cooperative_w2_wages_not_allocable_to_dpgr(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the W-2 wages that are not properly allocable to domestic production gross receipts, left out (section 199A(g)(1)(B)(ii))";
}
@source(IRC_S199A_G, quote = "except that such wages shall not include any amount which is not properly allocable to domestic production gross receipts for purposes of paragraph (3)(A).")
rule CooperativeWagesAllocableToDpgr(c: Corporation, y: TaxableYear, total: Money, not_allocable: Money) strict {
    label en official "the wages less those not allocable to the domestic production gross receipts";
    when cooperative_w2_wages_of_year(c, y, total);
    when cooperative_w2_wages_not_allocable_to_dpgr(c, y, not_allocable);
    then cooperative_w2_wages(c, y, max(0.00 USD, total - not_allocable));
}
pub relation cooperative_taxable_income_as_computed(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of the cooperative as computed, after the deductions of section 1382(b) and (c)";
}
pub relation cooperative_section_1382b_c_deductions(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowable under section 1382(b) or (c): patronage dividends, per-unit retain allocations and nonpatronage distributions (section 199A(g)(1)(C))";
}
@source(IRC_S199A_G, quote = "For purposes of this subsection, the taxable income of a specified agricultural or horticultural cooperative shall be computed without regard to any deduction allowable under subsection (b) or (c) of section 1382")
rule CooperativeTaxableIncomeWithoutSection1382Deductions(c: Corporation, y: TaxableYear, computed: Money, deductions: Money) strict {
    label en official "the computed taxable income plus the section 1382(b) and (c) deductions";
    when cooperative_taxable_income_as_computed(c, y, computed);
    when cooperative_section_1382b_c_deductions(c, y, deductions);
    then cooperative_taxable_income_before_199a(c, y, computed + deductions);
}

// === (g)(5): groups, section 511, the oil-related reduction =====================================================================

pub relation cooperative_ownership_test_199ag5(group: Integer, c: Corporation) kind empirical {
    label en official "the corporation is a member of an affiliated group of section 1504(a) determined with 'more than 50 percent' in place of 'at least 80 percent' and without regard to section 1504(b)(2) and (4) (section 199A(g)(5)(A)(iii))";
}
pub relation expanded_group_member_199ag(group: Integer, c: Corporation) kind institutional {
    label en official "the corporation is a member of the expanded affiliated group (section 199A(g)(5)(A)(iii))";
}
@source(IRC_S199A_G, quote = "For purposes of this subsection, the term \"expanded affiliated group\" means an affiliated group as defined in section 1504(a), determined—")
rule ExpandedGroupMember199ag(group: Integer, c: Corporation) strict {
    label en official "a corporation meeting the modified ownership test";
    when cooperative_ownership_test_199ag5(group, c);
    then expanded_group_member_199ag(group, c);
}
pub relation partnership_wholly_owned_by_single_expanded_group(partnership: Integer, group: Integer) kind empirical {
    label en official "all the interests in the capital and profits of the partnership are owned by members of a single expanded affiliated group at all times during the partnership's taxable year (section 199A(g)(5)(A)(ii))";
}
pub relation partnership_treated_as_single_taxpayer_with_group(partnership: Integer, group: Integer) kind institutional {
    label en official "the partnership and all members of the group are treated as a single taxpayer for paragraph (3)(D) (section 199A(g)(5)(A)(ii))";
}
@source(IRC_S199A_G, quote = "the partnership and all members of such group shall be treated as a single taxpayer during such period.")
rule PartnershipSingleTaxpayerWithGroup(partnership: Integer, group: Integer) strict {
    label en official "a partnership wholly owned by the group is a single taxpayer with the group";
    when partnership_wholly_owned_by_single_expanded_group(partnership, group);
    then partnership_treated_as_single_taxpayer_with_group(partnership, group);
}
pub relation expanded_group_qpai(group: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified production activities income of the expanded affiliated group treated as a single corporation";
}
@source(IRC_S199A_G, quote = "All members of an expanded affiliated group shall be treated as a single corporation for purposes of this subsection.")
rule ExpandedGroupQpai(group: Integer, y: TaxableYear, m0: Corporation, a0: Money) strict {
    label en official "the sum of the members' qualified production activities income";
    when expanded_group_member_199ag(group, m0);
    when cooperative_qualified_production_activities_income(m0, y, a0);
    then expanded_group_qpai(group, y, sum all amount: Money for m: Corporation where expanded_group_member_199ag(group, m) and cooperative_qualified_production_activities_income(m, y, amount));
}
pub relation expanded_group_taxable_income(group: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income of the expanded affiliated group treated as a single corporation";
}
rule ExpandedGroupTaxableIncome(group: Integer, y: TaxableYear, m0: Corporation, a0: Money) strict {
    label en official "the sum of the members' taxable income";
    when expanded_group_member_199ag(group, m0);
    when cooperative_taxable_income_before_199a(m0, y, a0);
    then expanded_group_taxable_income(group, y, sum all amount: Money for m: Corporation where expanded_group_member_199ag(group, m) and cooperative_taxable_income_before_199a(m, y, amount));
}
pub relation expanded_group_w2_wages(group: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the W-2 wages of the expanded affiliated group treated as a single corporation";
}
rule ExpandedGroupW2Wages(group: Integer, y: TaxableYear, m0: Corporation, a0: Money) strict {
    label en official "the sum of the members' wages";
    when expanded_group_member_199ag(group, m0);
    when cooperative_w2_wages(m0, y, a0);
    then expanded_group_w2_wages(group, y, sum all amount: Money for m: Corporation where expanded_group_member_199ag(group, m) and cooperative_w2_wages(m, y, amount));
}
pub relation expanded_group_g1_deduction(group: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 199A(g)(1) deduction of the expanded affiliated group treated as a single corporation";
}
@source(IRC_S199A_G, quote = "there shall be allowed as a deduction an amount equal to 9 percent of the lesser of—")
rule ExpandedGroupG1Deduction(group: Integer, y: TaxableYear, qpai: Money, ti: Money, wages: Money) strict {
    label en official "9 percent of the lesser of the group's qualified production activities income and taxable income, not above 50 percent of its wages";
    when expanded_group_qpai(group, y, qpai);
    when expanded_group_taxable_income(group, y, ti);
    when expanded_group_w2_wages(group, y, wages);
    then expanded_group_g1_deduction(group, y, min(round(min(qpai, ti) * 0.09, 2, "HALF_UP"), round(wages * 0.50, 2, "HALF_UP")));
}
pub relation member_allocated_g1_deduction(c: Corporation, y: TaxableYear, group: Integer, amount: Money) kind institutional {
    label en official "the member's allocation of the group deduction in proportion to its qualified production activities income (section 199A(g)(5)(A)(iv))";
}
@source(IRC_S199A_G, quote = "the deduction under paragraph (1) shall be allocated among the members of the expanded affiliated group in proportion to each member's respective amount (if any) of qualified production activities income.")
rule MemberAllocatedG1Deduction(c: Corporation, y: TaxableYear, group: Integer, deduction: Money, own: Money, total: Money) strict {
    label en official "the group deduction times the member's share of the group's qualified production activities income";
    when expanded_group_member_199ag(group, c);
    when expanded_group_g1_deduction(group, y, deduction);
    when cooperative_qualified_production_activities_income(c, y, own);
    when expanded_group_qpai(group, y, total);
    when total > 0.00 USD;
    then member_allocated_g1_deduction(c, y, group, round(deduction * (own / total), 2, "HALF_UP"));
}
pub relation cooperative_unrelated_business_taxable_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the unrelated business taxable income of the cooperative (section 199A(g)(5)(D))";
}
pub relation section_199a_g1_deduction_for_section_511(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the subsection (g)(1) deduction for determining the tax imposed by section 511: unrelated business taxable income takes the place of taxable income (section 199A(g)(5)(D))";
}
@source(IRC_S199A_G, quote = "For purposes of determining the tax imposed by section 511, this section shall be applied by substituting \"unrelated business taxable income\" for \"taxable income\" each place it appears in this section (other than this subparagraph).")
rule G1DeductionForSection511(c: Corporation, y: TaxableYear, qpai: Money, ubti: Money, wages: Money) strict {
    label en official "9 percent of the lesser of the qualified production activities income and the unrelated business taxable income, not above 50 percent of wages";
    when cooperative_qualified_production_activities_income(c, y, qpai);
    when cooperative_unrelated_business_taxable_income(c, y, ubti);
    when cooperative_w2_wages(c, y, wages);
    then section_199a_g1_deduction_for_section_511(c, y, min(round(min(qpai, ubti) * 0.09, 2, "HALF_UP"), round(wages * 0.50, 2, "HALF_UP")));
}
pub relation qpai_attributable_to_oil_gas_or_primary_product(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the qualified production activities income attributable to the production, refining, processing, transportation or distribution of oil, gas or a primary product of either (section 927(a)(2)(C) as in effect before its repeal) (section 199A(g)(5)(E)(ii))";
}
pub relation oil_related_qpai(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the oil related qualified production activities income for the year (section 199A(g)(5)(E)(ii))";
}
@source(IRC_S199A_G, quote = "For purposes of this subparagraph, the term \"oil related qualified production activities income\" means for any taxable year the qualified production activities income")
rule OilRelatedQpai(c: Corporation, y: TaxableYear, attributable: Money, qpai: Money) strict {
    label en official "the attributable part of the qualified production activities income";
    when qpai_attributable_to_oil_gas_or_primary_product(c, y, attributable);
    when cooperative_qualified_production_activities_income(c, y, qpai);
    then oil_related_qpai(c, y, min(attributable, qpai));
}
pub relation oil_related_reduction_of_g1_deduction(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduction of the subsection (g)(1) deduction by 3 percent of the least of the oil related qualified production activities income, the qualified production activities income and taxable income (section 199A(g)(5)(E)(i))";
}
@source(IRC_S199A_G, quote = "the amount otherwise allowable as a deduction under paragraph (1) shall be reduced by 3 percent of the least of—")
rule OilRelatedReduction(c: Corporation, y: TaxableYear, oil: Money, qpai: Money, ti: Money) strict {
    label en official "3 percent of the least of the three amounts";
    when oil_related_qpai(c, y, oil);
    when cooperative_qualified_production_activities_income(c, y, qpai);
    when cooperative_taxable_income_before_199a(c, y, ti);
    then oil_related_reduction_of_g1_deduction(c, y, round(min(min(oil, qpai), ti) * 0.03, 2, "HALF_UP"));
}
pub relation section_199a_g1_deduction_net_of_oil_reduction(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the subsection (g)(1) deduction after the oil-related reduction, not below zero (section 199A(g)(5)(E)(i))";
}
@source(IRC_S199A_G, quote = "the amount otherwise allowable as a deduction under paragraph (1) shall be reduced by 3 percent of the least of—")
rule G1DeductionNetOfOilReduction(c: Corporation, y: TaxableYear, deduction: Money, reduction: Money) strict {
    label en official "the deduction less the reduction";
    when section_199a_g1_cooperative_deduction(c, y, deduction);
    when oil_related_reduction_of_g1_deduction(c, y, reduction);
    then section_199a_g1_deduction_net_of_oil_reduction(c, y, max(0.00 USD, deduction - reduction));
}

// === (g)(2): patrons and qualified payments ===========================================================================================

pub relation taxpayer_is_not_a_corporation(p: Person) kind empirical {
    label en official "the taxpayer is other than a corporation (section 199A(g)(2)(D)(i))";
}
pub relation eligible_taxpayer_199ag2(p: Person) kind institutional {
    label en official "an eligible taxpayer: a taxpayer other than a corporation, or a specified agricultural or horticultural cooperative (section 199A(g)(2)(D))";
}
@source(IRC_S199A_G, quote = "(i) a taxpayer other than a corporation, or")
rule EligibleTaxpayerNotCorporation(p: Person) strict {
    label en official "a taxpayer other than a corporation";
    when taxpayer_is_not_a_corporation(p);
    then eligible_taxpayer_199ag2(p);
}
@source(IRC_S199A_G, quote = "(ii) a specified agricultural or horticultural cooperative.")
rule EligibleTaxpayerCooperative(c: Corporation) strict {
    label en official "a specified agricultural or horticultural cooperative";
    when specified_agricultural_or_horticultural_cooperative(c);
    then eligible_taxpayer_199ag2(c);
}
pub relation amount_described_in_1385a1_or_a3(p: Person, y: TaxableYear, payment: Integer) kind empirical {
    label en official "the amount is described in paragraph (1) or (3) of section 1385(a) (section 199A(g)(2)(E)(i))";
}
pub relation amount_received_from_specified_cooperative(p: Person, y: TaxableYear, payment: Integer, coop: Corporation, amount: Money) kind empirical {
    label en official "the amount is received from a specified agricultural or horticultural cooperative (section 199A(g)(2)(E)(ii))";
}
pub relation payment_attributable_to_qpai_with_cooperative_deduction(p: Person, y: TaxableYear, payment: Integer) kind empirical {
    label en official "the payment is attributable to qualified production activities income for which a deduction is allowed to the cooperative under paragraph (1) (section 199A(g)(2)(E)(iii))";
}
pub relation qualified_payment_199a(p: Person, y: TaxableYear, payment: Integer, coop: Corporation, amount: Money) kind institutional {
    label en official "a qualified payment of an eligible taxpayer (section 199A(g)(2)(E))";
}
@source(IRC_S199A_G, quote = "For purposes of this section, the term \"qualified payment\" means, with respect to any eligible taxpayer, any amount which—")
rule QualifiedPayment199a(p: Person, y: TaxableYear, payment: Integer, coop: Corporation, amount: Money) strict {
    label en official "described in section 1385(a)(1) or (3), received from a specified cooperative, attributable to its deductible qualified production activities income, by an eligible taxpayer";
    when eligible_taxpayer_199ag2(p);
    when amount_described_in_1385a1_or_a3(p, y, payment);
    when amount_received_from_specified_cooperative(p, y, payment, coop, amount);
    when specified_agricultural_or_horticultural_cooperative(coop);
    when payment_attributable_to_qpai_with_cooperative_deduction(p, y, payment);
    then qualified_payment_199a(p, y, payment, coop, amount);
}
pub relation cooperative_section_1382_reduction_denied_for_qualified_payment(coop: Corporation, y: TaxableYear, payment: Integer, amount: Money) kind institutional {
    label en official "the part of a qualified payment by which the cooperative's taxable income is not reduced under section 1382: the portion that does not exceed the patron's deduction (section 199A(g)(2)(C))";
}
@source(IRC_S199A_G, quote = "The taxable income of a specified agricultural or horticultural cooperative shall not be reduced under section 1382 by reason of that portion of any qualified payment as does not exceed the deduction allowable under subparagraph (A) with respect to such payment.")
rule CooperativeSection1382ReductionDenied(p: Person, y: TaxableYear, payment: Integer, coop: Corporation, paid: Money, deduction: Money) strict {
    label en official "the lesser of the payment and the patron's deduction";
    when qualified_payment_199a(p, y, payment, coop, paid);
    when section_199a_g2_patron_deduction(p, y, deduction);
    then cooperative_section_1382_reduction_denied_for_qualified_payment(coop, y, payment, min(paid, deduction));
}
pub relation patron_taxable_income_after_199a_a_deduction(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of the patron determined without the paragraph (2) deduction and after taking into account the section 199A(a) deduction (section 199A(g)(2)(B))";
}
pub relation patron_deduction_within_taxable_income_limit(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the patron's deduction limited to its taxable income after the section 199A(a) deduction (section 199A(g)(2)(B))";
}
@source(IRC_S199A_G, quote = "The deduction allowed to any taxpayer under this paragraph shall not exceed the taxable income of the taxpayer determined without regard to the deduction allowed under this paragraph and after taking into account any deduction allowed to the taxpayer under subsection (a) for the taxable year.")
rule PatronDeductionWithinTaxableIncomeLimit(p: Person, y: TaxableYear, deduction: Money, ti: Money) strict {
    label en official "the lesser of the deduction and the taxable income";
    when section_199a_g2_patron_deduction(p, y, deduction);
    when patron_taxable_income_after_199a_a_deduction(p, y, ti);
    then patron_deduction_within_taxable_income_limit(p, y, min(deduction, max(0.00 USD, ti)));
}
