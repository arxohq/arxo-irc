// New sections inserted into Subchapter B, Part VII by Pub. L. 119-21
// (One Big Beautiful Bill Act), owned by `deductions` per AMENDMENTS.json
// (title26_section 224/225 -> owner_package "deductions"; section 163(h)(4)
// -> owner_package "income-individual" in AMENDMENTS.json's heuristic
// entry, but substantively an amendment of THIS package's own section 163
// module, so modelled here alongside 163-interest.law). None of these
// sections exist in the pinned 2024-edition `sources.law` snapshot (they
// postdate it); their operative text is the Public Law text pinned in
// `us.irc.temporal`, cited via `@source(us.irc.temporal::PL119_21_S…)`.
// Scope: the deduction computation with its dollar cap and MAGI phase-out,
// for taxable years 2025-2028 (car loan interest: indebtedness incurred
// after December 31, 2024, through the same general window). NOT done:
// the occupations list for "qualified tips" (Treasury-published,
// EXTERNAL_DEPENDENCY), the SSN-required conditions, the joint-return
// "both spouses must have SSNs" mechanics, and 163(h)(4)'s own VIN/
// first-lien/final-assembly-location sub-definitions (classification
// gate only, not decomposed further).

use self::{
    Person,
    TaxableYear,
};

pub relation modified_adjusted_gross_income_pl119_21(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "modified adjusted gross income for purposes of sections 224(b)(2)(B), 225(b)(2)(B) and 163(h)(4)(C)(ii)(II): adjusted gross income increased by amounts excluded under section 911, 931, or 933";
}

// --- new section 224: qualified tips (Pub. L. 119-21 section 70201) --------

pub relation qualified_tips_received(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "qualified tips received during the taxable year and included on the statements section 224(a) requires (or reported on Form 4137)";
}
pub relation qualified_tips_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the new section 224(a) deduction for qualified tips, taxable years 2025-2028";
}
@source(us.irc.temporal::PL119_21_S70201, relation = derives_from, quote = "There shall be allowed as a deduction an amount equal to the qualified tips received during the taxable year")
rule QualifiedTipsDeductionComputation(p: Person, y: TaxableYear, tips: Money, magi: Money) strict {
    label en official "the qualified tips deduction is the lesser of $25,000 or qualified tips received, reduced (not below zero) by $100 for each $1,000 by which modified AGI exceeds $150,000 ($300,000 joint — this module applies the single/other threshold only, see the note below) (new section 224(a),(b))";
    effective [@2025-01-01, @2029-01-01);
    when qualified_tips_received(p, y, tips);
    when modified_adjusted_gross_income_pl119_21(p, y, magi);
    then qualified_tips_deduction(p, y,
        max(0.00 USD, min(25000.00 USD, tips) - 100.00 USD * round(max(0.00 USD, magi - 150000.00 USD) / 1000.00 USD, 0, "CEILING")));
}
@source(us.irc.temporal::PL119_21_S70201, relation = derives_from, quote = "($300,000 in the case of a joint return)")
rule QualifiedTipsDeductionComputationJoint(p: Person, y: TaxableYear, s: us.irc.income_individual::FilingStatus, tips: Money, magi: Money) strict {
    label en official "on a joint return, the section 224(b)(2)(A) phase-out threshold is $300,000 instead of $150,000 (the $25,000 cap itself does not double for joint returns)";
    effective [@2025-01-01, @2029-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    when qualified_tips_received(p, y, tips);
    when modified_adjusted_gross_income_pl119_21(p, y, magi);
    then qualified_tips_deduction(p, y,
        max(0.00 USD, min(25000.00 USD, tips) - 100.00 USD * round(max(0.00 USD, magi - 300000.00 USD) / 1000.00 USD, 0, "CEILING")));
}
// The occupations list limiting "qualified tips" to trades customarily
// receiving tips (section 224(d)) is an EXTERNAL_DEPENDENCY on Treasury
// guidance not pinned here; `qualified_tips_received` takes the taxpayer's
// own tip amount as given.

// --- new section 225: qualified overtime compensation (Pub. L. 119-21 section 70202) ---

pub relation qualified_overtime_compensation_received(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "qualified overtime compensation received during the taxable year, included on the statements new section 225(a) requires";
}
pub relation qualified_overtime_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the new section 225(a) deduction for qualified overtime compensation, taxable years 2025-2028";
}
@source(us.irc.temporal::PL119_21_S70202, relation = derives_from, quote = "There shall be allowed as a deduction an amount equal to the qualified overtime compensation received during the taxable year")
rule QualifiedOvertimeDeductionComputation(p: Person, y: TaxableYear, s: us.irc.income_individual::FilingStatus, ot: Money, magi: Money) strict {
    label en official "for a non-joint return, the qualified overtime deduction is the lesser of $12,500 or qualified overtime compensation, reduced (not below zero) by $100 for each $1,000 by which modified AGI exceeds $150,000 (new section 225(a),(b))";
    effective [@2025-01-01, @2029-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::Joint;
    when qualified_overtime_compensation_received(p, y, ot);
    when modified_adjusted_gross_income_pl119_21(p, y, magi);
    then qualified_overtime_deduction(p, y,
        max(0.00 USD, min(12500.00 USD, ot) - 100.00 USD * round(max(0.00 USD, magi - 150000.00 USD) / 1000.00 USD, 0, "CEILING")));
}
@source(us.irc.temporal::PL119_21_S70202, relation = derives_from, quote = "($25,000 in the case of a joint return)")
rule QualifiedOvertimeDeductionComputationJoint(p: Person, y: TaxableYear, s: us.irc.income_individual::FilingStatus, ot: Money, magi: Money) strict {
    label en official "on a joint return, the cap is $25,000 and the phase-out threshold is $300,000 (new section 225(a),(b))";
    effective [@2025-01-01, @2029-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    when qualified_overtime_compensation_received(p, y, ot);
    when modified_adjusted_gross_income_pl119_21(p, y, magi);
    then qualified_overtime_deduction(p, y,
        max(0.00 USD, min(25000.00 USD, ot) - 100.00 USD * round(max(0.00 USD, magi - 300000.00 USD) / 1000.00 USD, 0, "CEILING")));
}
// The section 225(d) SSN-required condition and the section 225(c)(2)
// exclusion of qualified tips already counted under section 224 are NOT
// modelled — TECH_GAP.

// --- section 163(h)(4): qualified passenger vehicle loan interest (Pub. L. 119-21 section 70203) ---

pub relation qualified_passenger_vehicle_loan_interest_paid_or_accrued(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest paid or accrued during the taxable year on indebtedness incurred after December 31, 2024 for the purchase of, and secured by a first lien on, an applicable passenger vehicle for personal use (new section 163(h)(4)(B))";
}
pub relation qualified_passenger_vehicle_loan_interest_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the new section 163(h)(4) deduction for qualified passenger vehicle loan interest (excluded from nondeductible personal interest, up to the dollar limit and MAGI phase-out), taxable years 2025-2028";
}
@source(us.irc.temporal::PL119_21_S70203, relation = derives_from, quote = "The amount of interest taken into account by a taxpayer under subparagraph (B) for any taxable year shall not exceed $10,000")
rule QualifiedCarLoanInterestDeductionComputation(p: Person, y: TaxableYear, s: us.irc.income_individual::FilingStatus, interest: Money, magi: Money) strict {
    label en official "for a non-joint return, the deduction is the lesser of $10,000 or qualified passenger vehicle loan interest, reduced (not below zero) by $200 for each $1,000 by which modified AGI exceeds $100,000 (section 163(h)(4)(C))";
    effective [@2025-01-01, @2029-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::Joint;
    when qualified_passenger_vehicle_loan_interest_paid_or_accrued(p, y, interest);
    when modified_adjusted_gross_income_pl119_21(p, y, magi);
    then qualified_passenger_vehicle_loan_interest_deduction(p, y,
        max(0.00 USD, min(10000.00 USD, interest) - 200.00 USD * round(max(0.00 USD, magi - 100000.00 USD) / 1000.00 USD, 0, "CEILING")));
}
@source(us.irc.temporal::PL119_21_S70203, relation = derives_from, quote = "($200,000 in the case of a joint return)")
rule QualifiedCarLoanInterestDeductionComputationJoint(p: Person, y: TaxableYear, s: us.irc.income_individual::FilingStatus, interest: Money, magi: Money) strict {
    label en official "on a joint return, the phase-out threshold is $200,000 (the $10,000 cap does not double) (section 163(h)(4)(C))";
    effective [@2025-01-01, @2029-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    when qualified_passenger_vehicle_loan_interest_paid_or_accrued(p, y, interest);
    when modified_adjusted_gross_income_pl119_21(p, y, magi);
    then qualified_passenger_vehicle_loan_interest_deduction(p, y,
        max(0.00 USD, min(10000.00 USD, interest) - 200.00 USD * round(max(0.00 USD, magi - 200000.00 USD) / 1000.00 USD, 0, "CEILING")));
}
// The final-assembly-in-the-United-States requirement, the VIN-on-return
// requirement, and the exceptions ((B)(ii): fleet sales, commercial
// vehicles, leases, salvage/scrap titles) are NOT modelled —
// `qualified_passenger_vehicle_loan_interest_paid_or_accrued` takes the
// classification as given (TECH_GAP).
