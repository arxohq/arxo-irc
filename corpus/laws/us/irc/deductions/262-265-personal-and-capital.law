// Sections 262-265 — Personal expenses, capital expenditures, related items
// not deductible. Stage 1 (IRC-06), priority section.

use self::{
    DeductionKind,
    IRC_S262_A,
    IRC_S263_A,
    IRC_S264_A,
    IRC_S265_A,
    Person,
    TaxableYear,
    deduction_allowed,
    premium_on_annuity_contract_excepted_from_264a1,
};

pub relation personal_living_or_family_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "an amount that is a personal, living, or family expense (section 262(a))";
}
@source(IRC_S262_A, quote = "Except as otherwise expressly provided in this chapter, no deduction shall be allowed for personal, living, or family expenses")
rule PersonalLivingFamilyExpensesNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for a personal, living, or family expense, absent an express chapter-1 exception (section 262(a))";
    when personal_living_or_family_expense(p, y, item, amount);
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, amount);
}

pub relation capital_expenditure_item(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid out for new buildings or permanent improvements or betterments increasing the value of property (section 263(a)(1))";
}
pub relation capital_expenditure_within_named_exception(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the capital expenditure falls within one of the section 263(a)(1)(A)-(L) named exceptions (deductible elsewhere: sections 616, 174, 175, 180, 190, 193, 179, 179B, 179C, etc.)";
}
@source(IRC_S263_A, quote = "Any amount paid out for new buildings or for permanent improvements or betterments made to increase the value of any property or estate")
rule CapitalExpenditureNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for a capital expenditure that increases the value of property or estate, unless a named section 263(a)(1) exception applies (section 263(a)(1))";
    when capital_expenditure_item(p, y, item, amount);
    when not_known(capital_expenditure_within_named_exception(p, y, item));
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, amount);
}

pub relation life_insurance_premium_taxpayer_is_beneficiary(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a premium on a life insurance policy, or endowment/annuity contract, where the taxpayer is directly or indirectly a beneficiary (section 264(a)(1))";
}
@source(IRC_S264_A, quote = "Premiums on any life insurance policy, or endowment or annuity contract, if the taxpayer is directly or indirectly a beneficiary under the policy or contract")
rule LifeInsurancePremiumBeneficiaryNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for a life insurance/endowment/annuity premium where the taxpayer is directly or indirectly a beneficiary (section 264(a)(1))";
    when life_insurance_premium_taxpayer_is_beneficiary(p, y, item, amount);
    when not_known(premium_on_annuity_contract_excepted_from_264a1(item));
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, amount);
}

pub relation expense_allocable_to_wholly_exempt_income(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount otherwise allowable as a deduction that is allocable to a class of income (other than interest) wholly exempt from the taxes imposed by subtitle A (section 265(a)(1))";
}
@source(IRC_S265_A, quote = "Any amount otherwise allowable as a deduction which is allocable to one or more classes of income other than interest")
rule ExpenseAllocableToExemptIncomeNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for an expense allocable to wholly tax-exempt income (section 265(a)(1))";
    when expense_allocable_to_wholly_exempt_income(p, y, item, amount);
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, amount);
}
pub relation tax_exempt_interest_expense_item(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest on indebtedness incurred or continued to purchase or carry obligations the interest on which is wholly tax-exempt (section 265(a)(2))";
}
@source(IRC_S265_A, quote = "Interest on indebtedness incurred or continued to purchase or carry obligations the interest on which is wholly exempt from the taxes imposed by this subtitle")
rule TaxExemptInterestExpenseNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for interest on debt incurred or continued to purchase or carry wholly tax-exempt obligations (section 265(a)(2))";
    when tax_exempt_interest_expense_item(p, y, item, amount);
    then not deduction_allowed(p, y, Section163Interest, amount);
}
// §262(b) telephone-line personal-expense classification, §263(a)(1)'s full
// lettered exception list, §263A (capitalization and inclusion of certain
// costs), §264(b)-(f) (annuity exceptions, single-premium-contract tests,
// business-entity-owned "COLI" interest disallowance), §265(a)(3)-(6)
// (RIC exempt-interest dividend proration, short sales) stay "stage 2".
