// Section 280F — listed property, business use, recapture, leases, definitions: stage 2b
// (TECH_GAPS G2791). (a)(1)(B) is the post-recovery-period expensing of unrecovered basis; (a)(2)
// is realised as a two-step chain (cap, then personal-use reduction); (b) is the predominant-use
// test with the ADS consequence and the recapture of excess depreciation; (c) leases; (d) the
// definitions, the price-inflation adjustment of (d)(7), the one-taxpayer rule of (d)(9) and the
// nonrecognition rule of (d)(10). Not modelled: tables of allowable percentages under (c)(3) and
// regulations under (c)(5) (external to the Secretary), the lease-term rules of section
// 168(i)(3)(A), the published inflation-adjusted tables (Rev. Proc. amounts are not pinned).

// --- (d)(5): passenger automobile ---------------------------------------------------------------

use self::{
    IRC_S280F_A,
    IRC_S280F_B,
    IRC_S280F_C,
    IRC_S280F_D,
    Person,
    TaxableYear,
    depreciation_deduction_before_280f_cap,
};

pub relation four_wheeled_vehicle_for_public_roads(item: Integer) kind empirical {
    label en official "a 4-wheeled vehicle manufactured primarily for use on public streets, roads and highways (section 280F(d)(5)(A)(i))";
}
pub relation vehicle_rated_unloaded_gross_weight_pounds(item: Integer, pounds: Integer) kind empirical {
    label en official "the vehicle's rated unloaded gross vehicle weight in pounds (section 280F(d)(5)(A)(ii))";
}
pub relation vehicle_rated_gross_vehicle_weight_pounds(item: Integer, pounds: Integer) kind empirical {
    label en official "the truck or van's rated gross vehicle weight in pounds (section 280F(d)(5)(A) last sentence)";
}
pub relation vehicle_is_truck_or_van(item: Integer) kind empirical {
    label en official "the vehicle is a truck or van";
}
pub relation vehicle_is_ambulance_or_hearse_used_directly_in_business(item: Integer) kind empirical {
    label en official "an ambulance, hearse or combination ambulance-hearse used by the taxpayer directly in a trade or business (section 280F(d)(5)(B)(i))";
}
pub relation vehicle_used_directly_in_transport_for_hire_business(item: Integer) kind empirical {
    label en official "a vehicle used by the taxpayer directly in the trade or business of transporting persons or property for compensation or hire (section 280F(d)(5)(B)(ii))";
}
pub relation truck_or_van_excluded_by_regulations(item: Integer) kind empirical {
    label en official "a truck or van excluded from the definition under regulations (section 280F(d)(5)(B)(iii))";
}
pub relation passenger_automobile_by_weight(item: Integer) kind institutional {
    label en official "the vehicle satisfies the section 280F(d)(5)(A) tests before the section 280F(d)(5)(B) exclusions";
}
@source(IRC_S280F_D, quote = "which is rated at 6,000 pounds unloaded gross vehicle weight or less")
rule PassengerAutomobileWeightUnloaded(item: Integer, pounds: Integer) defeasible {
    label en official "a 4-wheeled road vehicle rated at 6,000 pounds unloaded gross vehicle weight or less (section 280F(d)(5)(A))";
    when four_wheeled_vehicle_for_public_roads(item);
    when vehicle_rated_unloaded_gross_weight_pounds(item, pounds);
    when pounds <= 6000;
    unless vehicle_is_truck_or_van_with_weight(item, pounds);
    then passenger_automobile_by_weight(item);
}
pub relation vehicle_is_truck_or_van_with_weight(item: Integer, pounds: Integer) kind institutional {
    label en official "helper: the vehicle is a truck or van (the truck-or-van rule substitutes gross vehicle weight)";
}
rule TruckOrVanHelper(item: Integer, pounds: Integer) defeasible {
    label en official "helper for the truck-or-van substitution";
    when vehicle_is_truck_or_van(item);
    when vehicle_rated_unloaded_gross_weight_pounds(item, pounds);
    then vehicle_is_truck_or_van_with_weight(item, pounds);
}
@source(IRC_S280F_D, quote = "In the case of a truck or van, clause (ii) shall be applied by substituting \"gross vehicle weight\" for \"unloaded gross vehicle weight\".")
rule PassengerAutomobileWeightTruckOrVan(item: Integer, pounds: Integer) defeasible {
    label en official "for a truck or van the 6,000-pound test reads the gross vehicle weight (section 280F(d)(5)(A))";
    when four_wheeled_vehicle_for_public_roads(item);
    when vehicle_is_truck_or_van(item);
    when vehicle_rated_gross_vehicle_weight_pounds(item, pounds);
    when pounds <= 6000;
    then passenger_automobile_by_weight(item);
}
pub relation passenger_automobile(item: Integer) kind institutional {
    label en official "a passenger automobile within the meaning of section 280F(d)(5)";
}
@source(IRC_S280F_D, quote = "The term \"passenger automobile\" shall not include")
rule PassengerAutomobileDefinition(item: Integer) defeasible {
    label en official "a vehicle satisfying paragraph (5)(A) is a passenger automobile unless an exclusion of paragraph (5)(B) applies";
    when passenger_automobile_by_weight(item);
    unless vehicle_is_ambulance_or_hearse_used_directly_in_business(item);
    unless vehicle_used_directly_in_transport_for_hire_business(item);
    unless truck_or_van_excluded_by_regulations(item);
    then passenger_automobile(item);
}

// --- (d)(4): listed property ----------------------------------------------------------------------------

pub relation property_used_as_means_of_transportation(item: Integer) kind empirical {
    label en official "property used as a means of transportation (section 280F(d)(4)(A)(ii))";
}
pub relation property_of_type_used_for_entertainment_recreation_or_amusement(item: Integer) kind empirical {
    label en official "property of a type generally used for purposes of entertainment, recreation or amusement (section 280F(d)(4)(A)(iii))";
}
pub relation property_specified_as_listed_by_regulations(item: Integer) kind empirical {
    label en official "any other property of a type specified by the Secretary by regulations (section 280F(d)(4)(A)(iv))";
}
pub relation substantially_all_use_in_business_of_transporting_for_hire(item: Integer) kind empirical {
    label en official "substantially all of the use of the property is in a trade or business of providing to unrelated persons services consisting of the transportation of persons or property for compensation or hire (section 280F(d)(4)(B))";
}
pub relation listed_property(item: Integer) kind institutional {
    label en official "listed property within the meaning of section 280F(d)(4)";
}
@source(IRC_S280F_D, quote = "(i) any passenger automobile,")
rule ListedPropertyPassengerAutomobile(item: Integer) defeasible {
    label en official "any passenger automobile is listed property (section 280F(d)(4)(A)(i))";
    when passenger_automobile(item);
    then listed_property(item);
}
@source(IRC_S280F_D, quote = "(ii) any other property used as a means of transportation,")
rule ListedPropertyTransportation(item: Integer) defeasible {
    label en official "other property used as a means of transportation is listed property, except property used substantially all in a for-hire transport business (section 280F(d)(4)(A)(ii),(B))";
    when property_used_as_means_of_transportation(item);
    unless substantially_all_use_in_business_of_transporting_for_hire(item);
    then listed_property(item);
}
@source(IRC_S280F_D, quote = "(iii) any property of a type generally used for purposes of entertainment, recreation, or amusement,")
rule ListedPropertyEntertainment(item: Integer) defeasible {
    label en official "property of a type generally used for entertainment, recreation or amusement is listed property (section 280F(d)(4)(A)(iii))";
    when property_of_type_used_for_entertainment_recreation_or_amusement(item);
    then listed_property(item);
}
@source(IRC_S280F_D, quote = "(iv) any other property of a type specified by the Secretary by regulations.")
rule ListedPropertyBySecretaryRegulation(item: Integer) defeasible {
    label en official "property of a type specified by regulations is listed property (section 280F(d)(4)(A)(iv))";
    when property_specified_as_listed_by_regulations(item);
    then listed_property(item);
}

// --- (d)(6): business use percentage ----------------------------------------------------------------------

pub relation trade_or_business_use_percent(item: Integer, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the use of the listed property during the taxable year that is use in a trade or business of the taxpayer (section 280F(d)(6)(B))";
}
pub relation use_percent_leased_to_five_percent_owner_or_related(item: Integer, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of use consisting of leasing the property to a 5-percent owner or related person (section 280F(d)(6)(C)(i)(I))";
}
pub relation use_percent_compensation_to_five_percent_owner_or_related(item: Integer, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of use provided as compensation for services by a 5-percent owner or related person (section 280F(d)(6)(C)(i)(II))";
}
pub relation use_percent_compensation_to_other_person_not_included_in_income(item: Integer, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of use provided as compensation to another person where no amount is included in that person's gross income for the use or, where required, there was no chapter 24 withholding (section 280F(d)(6)(C)(i)(III))";
}
pub relation aircraft_property(item: Integer) kind empirical {
    label en official "the listed property is an aircraft (section 280F(d)(6)(C)(ii))";
}
pub relation aircraft_qualified_use_not_described_in_clause_i_percent(item: Integer, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the total use of the aircraft that is qualified business use not described in clause (i) (section 280F(d)(6)(C)(ii))";
}
pub relation aircraft_exception_applies(item: Integer, y: TaxableYear) kind institutional {
    label en official "at least 25 percent of the total use of the aircraft consists of qualified business use not described in clause (i), so clause (i) does not apply";
}
@source(IRC_S280F_D, quote = "Clause (i) shall not apply with respect to any aircraft if at least 25 percent of the total use of the aircraft during the taxable year consists of qualified business use not described in clause (i).")
rule AircraftExceptionTwentyFivePercent(item: Integer, y: TaxableYear, percent: Decimal) defeasible {
    label en official "clause (i) exclusions do not apply to an aircraft with at least 25 percent of other qualified business use (section 280F(d)(6)(C)(ii))";
    when aircraft_property(item);
    when aircraft_qualified_use_not_described_in_clause_i_percent(item, y, percent);
    when percent >= 0.25;
    then aircraft_exception_applies(item, y);
}
pub relation business_use_percentage(item: Integer, y: TaxableYear, percent: Decimal) kind institutional {
    label en official "the business use percentage: the percentage of the use of the listed property during the taxable year that is a qualified business use (section 280F(d)(6)(A))";
}
@source(IRC_S280F_D, quote = "Except as provided in subparagraph (C), the term \"qualified business use\" means any use in a trade or business of the taxpayer.")
rule BusinessUsePercentageWithClauseIExclusions(item: Integer, y: TaxableYear, total: Decimal, lease: Decimal, comp_owner: Decimal, comp_other: Decimal) defeasible {
    label en official "qualified business use is trade or business use less the uses excluded by subparagraph (C)(i) (section 280F(d)(6)(B),(C)); each excluded percentage is supplied as a fact, zero when none";
    when trade_or_business_use_percent(item, y, total);
    when use_percent_leased_to_five_percent_owner_or_related(item, y, lease);
    when use_percent_compensation_to_five_percent_owner_or_related(item, y, comp_owner);
    when use_percent_compensation_to_other_person_not_included_in_income(item, y, comp_other);
    when not_known(aircraft_exception_applies(item, y));
    then business_use_percentage(item, y, max(0.0, total - lease - comp_owner - comp_other));
}
@source(IRC_S280F_D, quote = "Clause (i) shall not apply with respect to any aircraft if at least 25 percent of the total use of the aircraft during the taxable year consists of qualified business use not described in clause (i).")
rule BusinessUsePercentageAircraftNoExclusions(item: Integer, y: TaxableYear, total: Decimal) defeasible {
    label en official "for an aircraft within the 25 percent exception, all trade or business use is qualified (section 280F(d)(6)(C)(ii))";
    when aircraft_exception_applies(item, y);
    when trade_or_business_use_percent(item, y, total);
    then business_use_percentage(item, y, total);
}

// --- (b): predominant use, ADS and recapture ----------------------------------------------------------------

pub relation predominantly_used_in_qualified_business_use(item: Integer, y: TaxableYear) kind institutional {
    label en official "the property is treated as predominantly used in a qualified business use for the taxable year (section 280F(b)(3))";
}
@source(IRC_S280F_B, quote = "property shall be treated as predominantly used in a qualified business use for any taxable year if the business use percentage for such taxable year exceeds 50 percent")
rule PredominantUseAboveFiftyPercent(item: Integer, y: TaxableYear, percent: Decimal) defeasible {
    label en official "a business use percentage above 50 percent is predominant use (section 280F(b)(3))";
    when business_use_percentage(item, y, percent);
    when percent > 0.50;
    then predominantly_used_in_qualified_business_use(item, y);
}
pub relation not_predominantly_used_in_qualified_business_use(item: Integer, y: TaxableYear) kind institutional {
    label en official "the property is not predominantly used in a qualified business use for the taxable year (business use percentage 50 percent or less)";
}
@source(IRC_S280F_B, quote = "If any listed property is not predominantly used in a qualified business use for any taxable year")
rule NotPredominantUseAtOrBelowFiftyPercent(item: Integer, y: TaxableYear, percent: Decimal) defeasible {
    label en official "a business use percentage of 50 percent or less is not predominant use (section 280F(b)(3) read with (b)(1))";
    when business_use_percentage(item, y, percent);
    when percent <= 0.50;
    then not_predominantly_used_in_qualified_business_use(item, y);
}
pub relation depreciation_determined_under_168g_ads(item: Integer, y: TaxableYear) kind institutional {
    label en official "the section 168 deduction for the property for the taxable year is determined under section 168(g), the alternative depreciation system";
}
@source(IRC_S280F_B, quote = "the deduction allowed under section 168 with respect to such property for such taxable year and any subsequent taxable year shall be determined under section 168(g)")
rule ListedPropertyNotPredominantUseAds(item: Integer, y: TaxableYear) defeasible {
    label en official "listed property not predominantly used in a qualified business use gets the ADS deduction (section 280F(b)(1))";
    when listed_property(item);
    when not_predominantly_used_in_qualified_business_use(item, y);
    then depreciation_determined_under_168g_ads(item, y);
}
pub relation first_year_of_nonpredominant_use_after_predominant_placed_in_service_year(item: Integer, y: TaxableYear) kind empirical {
    label en official "the property was predominantly used in a qualified business use in the taxable year it was placed in service, and y is the first subsequent taxable year in which it is not (section 280F(b)(2)(A))";
}
pub relation depreciation_allowable_before_nonpredominant_year(item: Integer, amount: Money) kind empirical {
    label en official "the amount of the depreciation deductions allowable for taxable years before the first year of non-predominant use (section 280F(b)(2)(B)(i))";
}
pub relation depreciation_that_would_have_been_allowable_without_predominant_use(item: Integer, amount: Money) kind empirical {
    label en official "the amount which would have been so allowable if the property had not been predominantly used in a qualified business use for the year it was placed in service (section 280F(b)(2)(B)(ii))";
}
pub relation excess_depreciation_280f(item: Integer, amount: Money) kind institutional {
    label en official "the excess (if any) of the depreciation allowable before the first year of non-predominant use over the amount which would have been allowable (section 280F(b)(2)(B))";
}
@source(IRC_S280F_B, quote = "the term \"excess depreciation\" means the excess (if any) of")
rule ExcessDepreciationDefinition(item: Integer, allowable: Money, would_be: Money) defeasible {
    label en official "excess depreciation is the excess of the depreciation allowable over the depreciation that would have been allowable (section 280F(b)(2)(B))";
    when depreciation_allowable_before_nonpredominant_year(item, allowable);
    when depreciation_that_would_have_been_allowable_without_predominant_use(item, would_be);
    when allowable > would_be;
    then excess_depreciation_280f(item, allowable - would_be);
}
pub relation recapture_of_excess_depreciation_included_in_gross_income(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the excess depreciation is included in gross income for the first taxable year of non-predominant use (section 280F(b)(2)(A))";
}
@source(IRC_S280F_B, quote = "then any excess depreciation shall be included in gross income for the taxable year referred to in clause (ii)")
rule RecaptureExcessDepreciationIncluded(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "excess depreciation is included in gross income for the year the property first ceases to be predominantly used (section 280F(b)(2)(A))";
    when first_year_of_nonpredominant_use_after_predominant_placed_in_service_year(item, y);
    when not_predominantly_used_in_qualified_business_use(item, y);
    when excess_depreciation_280f(item, amount);
    when property_owner(p, item);
    then recapture_of_excess_depreciation_included_in_gross_income(p, y, item, amount);
}
pub relation property_owner(p: Person, item: Integer) kind empirical {
    label en official "the taxpayer who holds the listed property";
}
@source(IRC_S280F_B, quote = "the depreciation deduction for the taxable year referred to in clause (ii) and any subsequent taxable years shall be determined under section 168(g)")
rule RecaptureYearAndAfterAds(item: Integer, y: TaxableYear) defeasible {
    label en official "after the recapture the deduction is determined under section 168(g) (section 280F(b)(2)(A))";
    when first_year_of_nonpredominant_use_after_predominant_placed_in_service_year(item, y);
    then depreciation_determined_under_168g_ads(item, y);
}

// --- (a)(1)(B): unrecovered basis after the recovery period ------------------------------------------------------

pub relation adjusted_basis_after_cap_as_if_all_business_use(item: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis of the passenger automobile determined after the application of subsection (a) and as if all use during the recovery period were use in a trade or business (section 280F(d)(8))";
}
pub relation unrecovered_basis(item: Integer, amount: Money) kind institutional {
    label en official "the unrecovered basis of the passenger automobile (section 280F(d)(8))";
}
@source(IRC_S280F_D, quote = "the term \"unrecovered basis\" means the adjusted basis of the passenger automobile determined after the application of subsection (a)")
rule UnrecoveredBasisDefinition(item: Integer, amount: Money) defeasible {
    label en official "the unrecovered basis is the adjusted basis after the cap, as if all use were business use (section 280F(d)(8))";
    when passenger_automobile(item);
    when adjusted_basis_after_cap_as_if_all_business_use(item, amount);
    then unrecovered_basis(item, amount);
}
pub relation first_taxable_year_after_recovery_period(item: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is the 1st taxable year after the recovery period of the passenger automobile";
}
pub relation depreciation_would_be_allowable_for_year(item: Integer, y: TaxableYear) kind empirical {
    label en official "a depreciation deduction would be allowable with respect to the property for the taxable year (section 280F(a)(1)(B)(iii))";
}
pub relation unrecovered_basis_expensed_after_recovery_period(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the unrecovered basis treated as an expense for the 1st taxable year after the recovery period, not exceeding $5,760, treated as a section 168 depreciation deduction (section 280F(a)(1)(B))";
}
@source(IRC_S280F_A, quote = "the unrecovered basis of any passenger automobile shall be treated as an expense for the 1st taxable year after the recovery period")
rule UnrecoveredBasisExpensedFirstYearAfterRecovery(p: Person, y: TaxableYear, item: Integer, basis: Money) defeasible {
    label en official "the unrecovered basis is expensed in the first year after the recovery period, up to $5,760 (statutory base amount; indexed amounts are not pinned), and only if depreciation would be allowable for the year (section 280F(a)(1)(B)(i)-(iii))";
    when property_owner(p, item);
    when passenger_automobile(item);
    when first_taxable_year_after_recovery_period(item, y);
    when depreciation_would_be_allowable_for_year(item, y);
    when unrecovered_basis(item, basis);
    then unrecovered_basis_expensed_after_recovery_period(p, y, item, min(basis, 5760.00 USD));
}
pub relation unrecovered_basis_remaining_from_prior_year(item: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excess of the unrecovered basis over the limitation carried to the succeeding taxable year (section 280F(a)(1)(B)(i) second sentence)";
}
@source(IRC_S280F_A, quote = "Any excess of the unrecovered basis over the limitation of clause (ii) shall be treated as an expense in the succeeding taxable year.")
rule UnrecoveredBasisExcessExpensedSucceedingYear(p: Person, y: TaxableYear, item: Integer, remaining: Money) defeasible {
    label en official "the excess over $5,760 is expensed in the succeeding taxable year, again limited to $5,760 (section 280F(a)(1)(B)(i),(ii))";
    when property_owner(p, item);
    when depreciation_would_be_allowable_for_year(item, y);
    when unrecovered_basis_remaining_from_prior_year(item, y, remaining);
    then unrecovered_basis_expensed_after_recovery_period(p, y, item, min(remaining, 5760.00 USD));
}

// --- (a)(2): the cap is applied before the personal-use reduction ---------------------------------------------------

pub relation depreciation_after_280f_cap(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the depreciation deduction after the dollar cap of subsection (a)(1)(A), before subsection (b) and any reduction for use not qualifying the property (section 280F(a)(2))";
}
pub relation applicable_280f_cap_for_recovery_year(item: Integer, recovery_year: Integer, cap: Money) kind empirical {
    label en official "the dollar limit of subsection (a)(1)(A) applicable to the recovery year, after any section 280F(d)(7) adjustment";
}
@source(IRC_S280F_A, quote = "The amount of the depreciation deduction for any taxable year for any passenger automobile shall not exceed")
rule DepreciationAfterCapMin(p: Person, y: TaxableYear, item: Integer, ry: Integer, before_cap: Money, cap: Money) defeasible {
    label en official "the deduction is the lesser of the depreciation otherwise computed and the applicable cap (section 280F(a)(1)(A))";
    when depreciation_deduction_before_280f_cap(p, y, item, ry, before_cap);
    when applicable_280f_cap_for_recovery_year(item, ry, cap);
    then depreciation_after_280f_cap(p, y, item, min(before_cap, cap));
}
pub relation depreciation_after_personal_use_reduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the capped depreciation reduced by the business use percentage, applied after subsection (a) (section 280F(a)(2)(B))";
}
@source(IRC_S280F_A, quote = "This subsection shall be applied before")
rule PersonalUseReductionAfterCap(p: Person, y: TaxableYear, item: Integer, capped: Money, percent: Decimal) defeasible {
    label en official "the reduction for use not qualifying the property is applied to the amount already capped under subsection (a) (section 280F(a)(2)(A),(B))";
    when depreciation_after_280f_cap(p, y, item, capped);
    when business_use_percentage(item, y, percent);
    then depreciation_after_personal_use_reduction(p, y, item, round(capped * percent, 2, "HALF_UP"));
}

// --- (d)(1),(2),(3): section 179, subsequent years, employees -------------------------------------------------------

pub relation section_179_deduction_on_listed_property(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a deduction allowable under section 179 with respect to listed property (section 280F(d)(1))";
}
pub relation section_179_treated_as_depreciation_for_280f(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the section 179 deduction on listed property is treated as a section 168 depreciation deduction for subsections (a) and (b) and (d)(3) (section 280F(d)(1))";
}
@source(IRC_S280F_D, quote = "Any deduction allowable under section 179 with respect to any listed property shall be subject to the limitations of subsections (a) and (b)")
rule Section179OnListedPropertyTreatedAsDepreciation(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "a section 179 deduction on listed property is subject to the limits as if depreciation (section 280F(d)(1))";
    when listed_property(item);
    when section_179_deduction_on_listed_property(p, y, item, amount);
    then section_179_treated_as_depreciation_for_280f(p, y, item, amount);
}
pub relation use_percent_for_subsequent_depreciation(item: Integer, y: TaxableYear, percent: Decimal) kind institutional {
    label en official "the business use percentage used for computing depreciation in subsequent taxable years (section 280F(d)(2))";
}
@source(IRC_S280F_D, quote = "if less than 100 percent of the use of any listed property during any taxable year is use in a trade or business")
rule SubsequentYearsAllUseTreatedAsBusinessUse(item: Integer, y: TaxableYear, percent: Decimal) defeasible {
    label en official "solely for depreciation of subsequent years, if less than 100 percent of the use is business use, all use of that year is treated as business use (section 280F(d)(2))";
    when listed_property(item);
    when trade_or_business_use_percent(item, y, percent);
    when percent < 1.0;
    then use_percent_for_subsequent_depreciation(item, y, 1.0);
}
pub relation employee_use_of_listed_property(item: Integer, y: TaxableYear) kind empirical {
    label en official "use in connection with the performance of services as an employee (section 280F(d)(3)(B))";
}
pub relation employee_use_for_convenience_of_employer_and_required_by_employment(item: Integer, y: TaxableYear) kind empirical {
    label en official "the employee use is for the convenience of the employer and required as a condition of employment (section 280F(d)(3)(A))";
}
pub relation employee_use_treated_as_trade_or_business_use(item: Integer, y: TaxableYear) kind institutional {
    label en official "employee use of listed property counts as use in a trade or business for the employee's depreciation and lease deductions";
}
@source(IRC_S280F_D, quote = "unless such use is for the convenience of the employer and required as a condition of employment")
rule EmployeeUseCountsOnlyWhenRequiredForEmployer(item: Integer, y: TaxableYear) defeasible {
    label en official "employee use is trade or business use only when for the employer's convenience and required as a condition of employment (section 280F(d)(3)(A))";
    when employee_use_of_listed_property(item, y);
    when employee_use_for_convenience_of_employer_and_required_by_employment(item, y);
    then employee_use_treated_as_trade_or_business_use(item, y);
}

// --- (c): leased listed property ---------------------------------------------------------------------------------------

pub relation lessor_regularly_engaged_in_leasing_listed_property(p: Person, item: Integer) kind empirical {
    label en official "the listed property is leased or held for leasing by a person regularly engaged in the business of leasing such property (section 280F(c)(1))";
}
pub relation section_280f_applies_to_holder(p: Person, item: Integer) kind institutional {
    label en official "section 280F applies to the person's deductions for the listed property";
}
@source(IRC_S280F_C, quote = "This section shall not apply to any listed property leased or held for leasing by any person regularly engaged in the business of leasing such property.")
rule LessorNotWithinSection280F(p: Person, item: Integer) defeasible {
    label en official "section 280F does not apply to a lessor regularly engaged in leasing such property (section 280F(c)(1))";
    when listed_property(item);
    when lessor_regularly_engaged_in_leasing_listed_property(p, item);
    then not section_280f_applies_to_holder(p, item);
}
pub relation lease_of_listed_property_payments(p: Person, y: TaxableYear, item: Integer, days: Integer, payments: Money) kind empirical {
    label en official "rentals or other payments under a lease of listed property for a period of days, paid by the lessee (section 280F(c)(2))";
}
pub relation lessee_allowable_percentage_from_secretary_tables(item: Integer, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the allowable percentage determined under the tables prescribed by the Secretary (section 280F(c)(3)); the tables are not pinned";
}
pub relation lessee_deductible_lease_payments(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "only the allowable percentage of the lease payments is taken into account for a lease of 30 days or more (section 280F(c)(2))";
}
@source(IRC_S280F_C, quote = "only the allowable percentage of such payments shall be taken into account")
rule LesseeDeductionReducedToAllowablePercentage(p: Person, y: TaxableYear, item: Integer, days: Integer, payments: Money, percent: Decimal) defeasible {
    label en official "for a lease of 30 days or more the lessee takes into account only the allowable percentage of the payments (section 280F(c)(2))";
    when lease_of_listed_property_payments(p, y, item, days, payments);
    when days >= 30;
    when lessee_allowable_percentage_from_secretary_tables(item, y, percent);
    then lessee_deductible_lease_payments(p, y, item, round(payments * percent, 2, "HALF_UP"));
}

// --- (d)(7): automobile price inflation adjustment ---------------------------------------------------------------------------

pub relation c_cpi_u_automobile_component_october_preceding_year(cy: Integer, index: Decimal) kind empirical {
    label en official "the C-CPI-U automobile component for October of the year preceding calendar year cy (section 280F(d)(7)(B)(i)(I))";
}
pub relation cpi_automobile_component_october_2017_times_1f3b_amount(index: Decimal) kind empirical {
    label en official "the automobile component of the CPI for October of 2017, multiplied by the amount determined under section 1(f)(3)(B) (section 280F(d)(7)(B)(i)(II))";
}
pub relation automobile_price_inflation_adjustment(cy: Integer, adjustment: Decimal) kind institutional {
    label en official "the percentage by which the C-CPI-U automobile component exceeds the CPI-based base (section 280F(d)(7)(B)(i))";
}
@source(IRC_S280F_D, quote = "The automobile price inflation adjustment for any calendar year is the percentage (if any) by which")
rule AutomobilePriceInflationAdjustmentDerived(cy: Integer, current: Decimal, base: Decimal) defeasible {
    label en official "the adjustment is the excess of the October index over the base index as a percentage of the base (the text names no rounding: exact to 8 places HALF_UP, JUDGMENT CALL)";
    when c_cpi_u_automobile_component_october_preceding_year(cy, current);
    when cpi_automobile_component_october_2017_times_1f3b_amount(base);
    when current > base;
    then automobile_price_inflation_adjustment(cy, div_round(current - base, base, 8, "HALF_UP"));
}
pub relation section_280f_dollar_amount_base(item: Integer, base_amount: Money) kind empirical {
    label en official "a dollar amount contained in subsection (a) (10,000; 16,000; 9,600; 5,760)";
}
pub relation automobile_placed_in_service_in_calendar_year(item: Integer, cy: Integer) kind empirical {
    label en official "the calendar year in which the passenger automobile is placed in service";
}
pub relation indexed_280f_dollar_amount(item: Integer, base_amount: Money, indexed: Money) kind institutional {
    label en official "the subsection (a) dollar amount increased by the automobile price inflation adjustment for the placed-in-service year, the increase rounded to the nearest multiple of $100 (a multiple of $50 is raised to the next higher multiple of $100) (section 280F(d)(7)(A))";
}
@source(IRC_S280F_D, quote = "In the case of any passenger automobile placed in service after 2018, subsection (a) shall be applied by increasing each dollar amount contained in such subsection by the automobile price inflation adjustment")
rule IndexedDollarAmountAfter2018(item: Integer, base_amount: Money, cy: Integer, adjustment: Decimal) defeasible {
    label en official "each dollar amount is increased by the adjustment, rounded to the nearest $100 with half-way multiples of $50 rounded up (section 280F(d)(7)(A))";
    when passenger_automobile(item);
    when automobile_placed_in_service_in_calendar_year(item, cy);
    when cy > 2018;
    when section_280f_dollar_amount_base(item, base_amount);
    when automobile_price_inflation_adjustment(cy, adjustment);
    then indexed_280f_dollar_amount(item, base_amount, base_amount + 100.00 USD * div_round(base_amount * adjustment, 100.00 USD, 0, "HALF_UP"));
}

// --- (d)(9),(10): shared interests, nonrecognition transactions -------------------------------------------------------------------

pub relation interest_in_passenger_automobile(p: Person, item: Integer, share: Decimal) kind empirical {
    label en official "the fraction of the interest of a taxpayer among all taxpayers holding interests in the passenger automobile (section 280F(d)(9))";
}
pub relation allocated_280f_limitation(p: Person, item: Integer, cap: Money, allocated: Money) kind institutional {
    label en official "the subsection (a) limitation allocated to a taxpayer in proportion to interests; all holders are treated as one taxpayer (section 280F(d)(9))";
}
@source(IRC_S280F_D, quote = "the limitations of subsection (a) shall be allocated among such taxpayers in proportion to their interests in such automobile")
rule AllocateLimitationByInterest(p: Person, item: Integer, cap: Money, share: Decimal, ry: Integer) defeasible {
    label en official "the subsection (a) limitation is allocated by interest (section 280F(d)(9))";
    when passenger_automobile(item);
    when interest_in_passenger_automobile(p, item, share);
    when applicable_280f_cap_for_recovery_year(item, ry, cap);
    then allocated_280f_limitation(p, item, cap, round(cap * share, 2, "HALF_UP"));
}
pub relation property_acquired_in_nonrecognition_transaction(item: Integer) kind empirical {
    label en official "the property was acquired in a nonrecognition transaction (section 280F(d)(10))";
}
pub relation taxable_year_placed_in_service_after_acquisition(item: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the property was placed in service after being so acquired";
}
pub relation treated_as_single_property_originally_placed_in_service_in_year(item: Integer, y: TaxableYear) kind institutional {
    label en official "the property is treated as a single property originally placed in service in the taxable year in which it was placed in service after acquisition, for subsection (a)(1) (section 280F(d)(10))";
}
@source(IRC_S280F_D, quote = "any property acquired in a nonrecognition transaction shall be treated as a single property originally placed in service in the taxable year in which it was placed in service after being so acquired")
rule NonrecognitionAcquisitionSingleProperty(item: Integer, y: TaxableYear) defeasible {
    label en official "property acquired in a nonrecognition transaction is a single property placed in service in the year it was placed in service after acquisition (section 280F(d)(10))";
    when property_acquired_in_nonrecognition_transaction(item);
    when taxable_year_placed_in_service_after_acquisition(item, y);
    then treated_as_single_property_originally_placed_in_service_in_year(item, y);
}
