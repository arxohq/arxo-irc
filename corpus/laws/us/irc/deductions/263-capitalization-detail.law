// Section 263 — capital expenditures: stage 2b detail (TECH_GAPS G2795): (c) intangible drilling
// costs, (d) railroad rolling stock, (f) railroad ties, (g) straddle carrying charges, (h) short-sale
// payments in lieu of dividends, (i) foreign intangible drilling costs. (a) is in
// `262-265-personal-and-capital.law`. Not modelled (TECH_GAPS G39xx): the ordering rules of
// (g)(4) and (h)(6) (sequential application against sections 1277/1282 and between (g) and (h));
// section 1059(c) extraordinary dividends (external, a fact); risk-of-loss regulations of (h)(4)(B).

// --- (c): intangible drilling and development costs ----------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S263_C,
    IRC_S263_D,
    IRC_S263_F,
    IRC_S263_G,
    IRC_S263_H,
    IRC_S263_I,
    Person,
    TaxableYear,
    deduction_allowed,
    straddle_prior_reductions_263g4,
};

pub relation idc_option_regulations_prescribed(year: Integer) kind empirical {
    label en official "regulations have been prescribed under this subtitle corresponding to those which granted the option to deduct intangible drilling and development costs of oil and gas wells and geothermal wells (section 263(c))";
}
pub relation idc_regulation_year_required(year: Integer) kind empirical {
    label en official "a year for which the regulations under section 263(c) are required to be in place";
}
rule S263cPrescribeIdcOptionRegulationsDuty defeasible {
    for year: Integer;
    when idc_regulation_year_required(year);
    then duty S263cPrescribeIdcOptionRegulations {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition idc_option_regulations_prescribed(year);
            window [-infinity, infinity];
        }
    };
}
pub relation idc_costs_deducted_under_59e_or_291(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a deduction is allowed for the costs under section 59(e) or 291 (section 263(c) last sentence)";
}
pub relation section_263c_option_applies_to_costs(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the section 263(c) option regulations apply to the costs";
}
pub relation intangible_drilling_and_development_costs_item(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "intangible drilling and development costs in the case of oil and gas wells or wells drilled for a geothermal deposit (section 263(c))";
}
@source(IRC_S263_C, quote = "This subsection shall not apply with respect to any costs to which any deduction is allowed under section 59(e) or 291.")
rule Section263cAppliesUnlessDeductedUnder59eOr291(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "subsection (c) does not apply to costs for which a deduction is allowed under section 59(e) or 291";
    when intangible_drilling_and_development_costs_item(p, y, item);
    when not_known(idc_costs_deducted_under_59e_or_291(p, y, item));
    then section_263c_option_applies_to_costs(p, y, item);
}

// --- (d): railroad rolling stock -----------------------------------------------------------------------------------------

pub relation rolling_stock_rehabilitation_expenditure_12_months(unit: Integer, amount: Money) kind empirical {
    label en official "expenditures in any 12-month period in connection with the rehabilitation of a unit of railroad rolling stock (except a locomotive) used by a domestic common carrier by railroad, which would be chargeable to capital account (section 263(d))";
}
pub relation basis_of_rolling_stock_unit_in_taxpayer_hands(unit: Integer, amount: Money) kind empirical {
    label en official "the basis of the unit in the hands of the taxpayer (section 263(d))";
}
pub relation taxpayer_rehabilitates_rolling_stock_unit(p: Person, y: TaxableYear, unit: Integer) kind empirical {
    label en official "the taxpayer, a domestic common carrier by railroad, rehabilitates the unit of railroad rolling stock in the taxable year (section 263(d))";
}
pub relation section_263e_election_applies_for_year(p: Person, y: TaxableYear) kind empirical {
    label en official "an election under subsection (e) applies to the railroad rolling stock (other than locomotives) for the taxable year (section 263(d) last sentence)";
}
pub relation rolling_stock_rehabilitation_election_available(p: Person, y: TaxableYear, unit: Integer) kind institutional {
    label en official "the section 263(d) election is available: the 12-month expenditures do not exceed 20 percent of the unit's basis and no subsection (e) election applies";
}
@source(IRC_S263_D, quote = "if during any 12-month period they do not exceed an amount equal to 20 percent of the basis of such unit in the hands of the taxpayer")
rule RollingStockElectionAvailableWithin20Percent(p: Person, y: TaxableYear, unit: Integer, spent: Money, basis: Money) defeasible {
    label en official "the election is available when the 12-month expenditures are at most 20 percent of the unit's basis and no subsection (e) election applies (section 263(d))";
    when taxpayer_rehabilitates_rolling_stock_unit(p, y, unit);
    when rolling_stock_rehabilitation_expenditure_12_months(unit, spent);
    when basis_of_rolling_stock_unit_in_taxpayer_hands(unit, basis);
    when spent <= round(basis * 20 percent, 2, "HALF_UP");
    when not_known(section_263e_election_applies_for_year(p, y));
    then rolling_stock_rehabilitation_election_available(p, y, unit);
}
pub relation elects_rolling_stock_rehabilitation_as_repairs(p: Person, y: TaxableYear, unit: Integer) kind empirical {
    label en official "the taxpayer elects to treat the rehabilitation expenditures as deductible repairs under section 162 or 212 (section 263(d))";
}
pub relation rolling_stock_rehabilitation_treated_as_deductible_repairs(p: Person, y: TaxableYear, unit: Integer) kind institutional {
    label en official "the rehabilitation expenditures are treated, notwithstanding subsection (a), as deductible repairs under section 162 or 212";
}
@source(IRC_S263_D, quote = "shall, at the election of the taxpayer, be treated (notwithstanding subsection (a)) as deductible repairs under section 162 or 212")
rule S263dRollingStockRepairElectionPower(p: Person, y: TaxableYear, unit: Integer) defeasible {
    label en official "the taxpayer may elect repair treatment for rolling stock rehabilitation within the 20-percent limit (section 263(d)); the time and manner are set by regulations; an election outside the limit has no effect";
    when elects_rolling_stock_rehabilitation_as_repairs(p, y, unit);
    then power S263dElectRollingStockRepairTreatment {
        holder p;
        over unit;
        exercise elects_rolling_stock_rehabilitation_as_repairs(p, y, unit);
        valid_when rolling_stock_rehabilitation_election_available(p, y, unit);
        effect create(rolling_stock_rehabilitation_treated_as_deductible_repairs(p, y, unit));
        window [-infinity, infinity];
    };
}

// --- (f): replacement railroad ties -----------------------------------------------------------------------------------------

pub relation domestic_common_carrier_by_rail_using_retirement_replacement_method(p: Person) kind empirical {
    label en official "a domestic common carrier by rail (including a railroad switching or terminal company) using the retirement-replacement method of accounting for depreciation of its railroad track (section 263(f))";
}
pub relation replacement_tie_expenditure_any_material(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "expenditures for acquiring and installing replacement ties of any material, and fastenings related to such ties (section 263(f))";
}
pub relation replacement_tie_treated_as_wood_tie_expenditure(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the expenditure is accorded the same tax accounting treatment as expenditures for replacement ties of wood (section 263(f))";
}
@source(IRC_S263_F, quote = "expenditures for acquiring and installing replacement ties of any material (and fastenings related to such ties) shall be accorded the same tax accounting treatment as expenditures for replacement ties of wood")
rule ReplacementTiesSameTreatmentAsWood(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "replacement ties of any material are treated like wood ties for a rail carrier using the retirement-replacement method (section 263(f))";
    when domestic_common_carrier_by_rail_using_retirement_replacement_method(p);
    when replacement_tie_expenditure_any_material(p, y, item);
    then replacement_tie_treated_as_wood_tie_expenditure(p, y, item);
}

// --- (g): straddles ------------------------------------------------------------------------------------------------------------

pub relation personal_property_part_of_straddle(prop: Integer) kind empirical {
    label en official "the personal property is part of a straddle as defined in section 1092(c) (section 263(g)(1))";
}
pub relation hedging_transaction_1256e(prop: Integer) kind empirical {
    label en official "the transaction is a hedging transaction as defined in section 1256(e) (section 263(g)(3))";
}
pub relation straddle_interest_on_debt_to_carry_property(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "interest on indebtedness incurred or continued to purchase or carry the personal property, including amounts paid in connection with property used in a short sale (section 263(g)(2)(A)(i))";
}
pub relation straddle_other_carrying_amounts(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "all other amounts (including charges to insure, store or transport the property) paid or incurred to carry the personal property (section 263(g)(2)(A)(ii))";
}
pub relation straddle_interest_income_includible(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "interest (including original issue discount) includible in gross income for the taxable year with respect to the property (section 263(g)(2)(B)(i))";
}
pub relation straddle_ordinary_income_under_1271_1276_1281(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "any amount treated as ordinary income under section 1271(a)(3)(A), 1276 or 1281(a) with respect to the property for the year (section 263(g)(2)(B)(ii))";
}
pub relation straddle_dividends_includible_net_of_243_245_deduction(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the excess of dividends includible in gross income with respect to the property over the deduction allowable under section 243 or 245 (section 263(g)(2)(B)(iii))";
}
pub relation straddle_security_loan_payments_includible(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "any payment with respect to a security loan (section 512(a)(5)) includible in gross income with respect to the property for the year (section 263(g)(2)(B)(iv))";
}
pub relation straddle_interest_and_carrying_charges(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the interest and carrying charges: the excess of (A) interest and other carrying amounts over (B) interest income, section 1271/1276/1281 ordinary income, net dividends and security-loan payments (section 263(g)(2))";
}
@source(IRC_S263_G, quote = "the term \"interest and carrying charges\" means the excess of")
rule StraddleInterestAndCarryingChargesExcess(p: Person, y: TaxableYear, prop: Integer, a1: Money, a2: Money, r: Money, b1: Money, b2: Money, b3: Money, b4: Money) defeasible {
    label en official "interest and carrying charges are the excess (if any) of the paragraph (2)(A) sum over the paragraph (2)(B) sum; each component is a fact, zero when none";
    when straddle_interest_on_debt_to_carry_property(p, y, prop, a1);
    when straddle_other_carrying_amounts(p, y, prop, a2);
    when straddle_interest_income_includible(p, y, prop, b1);
    when straddle_ordinary_income_under_1271_1276_1281(p, y, prop, b2);
    when straddle_dividends_includible_net_of_243_245_deduction(p, y, prop, b3);
    when straddle_security_loan_payments_includible(p, y, prop, b4);
    when straddle_prior_reductions_263g4(p, y, prop, r);
    when a1 + a2 - r > b1 + b2 + b3 + b4;
    then straddle_interest_and_carrying_charges(p, y, prop, a1 + a2 - r - b1 - b2 - b3 - b4);
}
pub relation straddle_carrying_charges_chargeable_to_capital_account(p: Person, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the amount not allowed as a deduction is chargeable to the capital account of the personal property (section 263(g)(1))";
}
@source(IRC_S263_G, quote = "No deduction shall be allowed for interest and carrying charges properly allocable to personal property which is part of a straddle")
rule StraddleCarryingChargesNotDeductible(p: Person, y: TaxableYear, prop: Integer, amount: Money) defeasible {
    label en official "no deduction for interest and carrying charges allocable to straddle personal property, except a hedging transaction (section 263(g)(1),(3))";
    when personal_property_part_of_straddle(prop);
    when straddle_interest_and_carrying_charges(p, y, prop, amount);
    when not_known(hedging_transaction_1256e(prop));
    then not deduction_allowed(p, y, Section263StraddleCarryingCharges, amount);
}
@source(IRC_S263_G, quote = "Any amount not allowed as a deduction by reason of the preceding sentence shall be chargeable to the capital account with respect to the personal property to which such amount relates.")
rule StraddleCarryingChargesCapitalized(p: Person, y: TaxableYear, prop: Integer, amount: Money) defeasible {
    label en official "the disallowed amount is chargeable to the capital account of the property (section 263(g)(1))";
    when personal_property_part_of_straddle(prop);
    when straddle_interest_and_carrying_charges(p, y, prop, amount);
    when not_known(hedging_transaction_1256e(prop));
    then straddle_carrying_charges_chargeable_to_capital_account(p, y, prop, amount);
}

// --- (h): short-sale payments in lieu of dividends -------------------------------------------------------------------------------

pub relation short_sale_payment_in_lieu_of_dividend(p: Person, y: TaxableYear, sale: Integer, amount: Money) kind empirical {
    label en official "a payment with respect to stock used in a short sale that is in lieu of a dividend payment on such stock (section 263(h)(1)(A))";
}
pub relation short_sale_date(sale: Integer, on: Date) kind empirical {
    label en official "the date of the short sale";
}
pub relation short_sale_closing_date(sale: Integer, on: Date) kind empirical {
    label en official "the date the short sale is closed";
}
pub relation short_sale_period_suspension_days(sale: Integer, days: Integer) kind empirical {
    label en official "the number of days of the paragraph (4) suspension: days in which the taxpayer holds, has an option to buy, or is under a contractual obligation to buy substantially identical stock or securities, or has diminished his risk of loss (section 263(h)(4))";
}
pub relation payment_in_respect_of_extraordinary_dividend_1059c(sale: Integer) kind empirical {
    label en official "the payment is in respect of an extraordinary dividend as defined in section 1059(c), applied with the amount realized in the short sale as the adjusted basis (section 263(h)(2),(3))";
}
pub relation short_sale_closed_within_period(sale: Integer) kind institutional {
    label en official "the closing of the short sale occurs within the applicable period: 45 days after the short sale, or 1 year for an extraordinary dividend, each extended by the suspended days (section 263(h)(1)(B),(2),(4))";
}
@source(IRC_S263_H, quote = "the closing of such short sale occurs on or before the 45th day after the date of such short sale")
rule ShortSaleClosedWithin45Days(sale: Integer, opened: Date, closed: Date, suspended: Integer) defeasible {
    label en official "a short sale closed by the 45th day (net of suspended days) is within the period (section 263(h)(1)(B),(4))";
    when short_sale_date(sale, opened);
    when short_sale_closing_date(sale, closed);
    when short_sale_period_suspension_days(sale, suspended);
    when not_known(payment_in_respect_of_extraordinary_dividend_1059c(sale));
    when days_between(opened, closed) - suspended <= 45;
    then short_sale_closed_within_period(sale);
}
@source(IRC_S263_H, quote = "paragraph (1)(B) shall be applied by substituting \"the day 1 year after the date of such short sale\" for \"the 45th day after the date of such short sale\"")
rule ShortSaleClosedWithinOneYearExtraordinaryDividend(sale: Integer, opened: Date, closed: Date, suspended: Integer) defeasible {
    label en official "for a payment in respect of an extraordinary dividend the period is 1 year, net of suspended days (section 263(h)(2),(4))";
    when payment_in_respect_of_extraordinary_dividend_1059c(sale);
    when short_sale_date(sale, opened);
    when short_sale_closing_date(sale, closed);
    when short_sale_period_suspension_days(sale, suspended);
    when days_between(opened, closed) - suspended <= days_between(opened, add_calendar_period(opened, 1 calendar_year));
    then short_sale_closed_within_period(sale);
}
pub relation collateral_compensation_ordinary_income_received(sale: Integer, amount: Money) kind empirical {
    label en official "the amount treated as ordinary income and received as compensation for the use of collateral with respect to stock used in the short sale (section 263(h)(5)(A))";
}
pub relation short_sale_payment_disallowed_263h(p: Person, y: TaxableYear, sale: Integer, amount: Money) kind institutional {
    label en official "the payment in lieu of a dividend for which no deduction is allowed and which increases the basis of the stock used to close the short sale (section 263(h)(1))";
}
@source(IRC_S263_H, quote = "then no deduction shall be allowed for such payment")
rule ShortSalePaymentDisallowedOrdinary(p: Person, y: TaxableYear, sale: Integer, payments: Money, collateral: Money) defeasible {
    label en official "a payment in lieu of a dividend on a short sale closed within the period is not deductible except to the extent it does not exceed collateral compensation received as ordinary income (section 263(h)(1),(5)(A))";
    when short_sale_payment_in_lieu_of_dividend(p, y, sale, payments);
    when short_sale_closed_within_period(sale);
    when collateral_compensation_ordinary_income_received(sale, collateral);
    when payments > collateral;
    when not_known(payment_in_respect_of_extraordinary_dividend_1059c(sale));
    then short_sale_payment_disallowed_263h(p, y, sale, payments - collateral);
}
@source(IRC_S263_H, quote = "Subparagraph (A) shall not apply if one or more payments or distributions is in respect of an extraordinary dividend.")
rule ShortSalePaymentDisallowedExtraordinaryDividendFull(p: Person, y: TaxableYear, sale: Integer, payments: Money) defeasible {
    label en official "the collateral-income offset does not apply to an extraordinary dividend: the whole payment is disallowed (section 263(h)(5)(B))";
    when short_sale_payment_in_lieu_of_dividend(p, y, sale, payments);
    when short_sale_closed_within_period(sale);
    when payment_in_respect_of_extraordinary_dividend_1059c(sale);
    then short_sale_payment_disallowed_263h(p, y, sale, payments);
}
@source(IRC_S263_H, quote = "then no deduction shall be allowed for such payment")
rule ShortSalePaymentNotDeductible(p: Person, y: TaxableYear, sale: Integer, amount: Money) defeasible {
    label en official "the disallowed short-sale payment yields no deduction (section 263(h)(1))";
    when short_sale_payment_disallowed_263h(p, y, sale, amount);
    then not deduction_allowed(p, y, Section263ShortSalePaymentInLieu, amount);
}
pub relation basis_of_stock_used_to_close_short_sale_increase(p: Person, sale: Integer, amount: Money) kind institutional {
    label en official "the basis of the stock used to close the short sale is increased by the amount not allowed as a deduction (section 263(h)(1))";
}
@source(IRC_S263_H, quote = "The basis of the stock used to close the short sale shall be increased by the amount not allowed as a deduction")
rule ShortSaleDisallowedPaymentIncreasesBasis(p: Person, y: TaxableYear, sale: Integer, amount: Money) defeasible {
    label en official "the basis of the closing stock is increased by the disallowed payment (section 263(h)(1))";
    when short_sale_payment_disallowed_263h(p, y, sale, amount);
    then basis_of_stock_used_to_close_short_sale_increase(p, sale, amount);
}

// --- (i): foreign intangible drilling and development costs ---------------------------------------------------------------------------------

pub relation foreign_well_idc_paid_or_incurred(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "intangible drilling and development costs paid or incurred with respect to an oil, gas or geothermal well located outside the United States (section 263(i))";
}
pub relation foreign_well_is_nonproductive(item: Integer) kind empirical {
    label en official "the costs are with respect to a nonproductive well (section 263(i) last sentence)";
}
pub relation foreign_idc_subsection_c_does_not_apply(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "subsection (c) does not apply to the foreign well costs (section 263(i)(1))";
}
@source(IRC_S263_I, quote = "(1) subsection (c) shall not apply, and")
rule ForeignIdcSubsectionCNotApplicable(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "subsection (c) does not apply to foreign productive-well costs (section 263(i)(1))";
    when foreign_well_idc_paid_or_incurred(p, y, item, amount);
    when not_known(foreign_well_is_nonproductive(item));
    then foreign_idc_subsection_c_does_not_apply(p, y, item);
}
pub relation elects_foreign_idc_included_in_adjusted_basis_for_611(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer elects to include the costs in adjusted basis for computing any deduction under section 611 (determined without regard to section 613) (section 263(i)(2)(A))";
}
pub relation foreign_idc_included_in_adjusted_basis_for_611(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the costs are included in adjusted basis for section 611";
}
rule S263iElectForeignIdcBasisPower(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "the taxpayer may elect to include foreign IDC in adjusted basis for depletion (section 263(i)(2)(A)); an election over costs of a nonproductive well has no effect";
    when elects_foreign_idc_included_in_adjusted_basis_for_611(p, y, item);
    then power S263iElectForeignIdcBasisInclusion {
        holder p;
        over item;
        exercise elects_foreign_idc_included_in_adjusted_basis_for_611(p, y, item);
        valid_when foreign_idc_subsection_c_does_not_apply(p, y, item);
        effect create(foreign_idc_included_in_adjusted_basis_for_611(p, y, item));
        window [-infinity, infinity];
    };
}
pub relation year_index_since_foreign_idc_paid(y: TaxableYear, item: Integer, index: Integer) kind empirical {
    label en official "the position of the taxable year in the 10-taxable year period beginning with the taxable year the costs were paid or incurred (0 for the first year)";
}
pub relation foreign_idc_ratable_deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the ratable one-tenth deduction of foreign IDC over the 10-taxable year period (section 263(i)(2)(B))";
}
@source(IRC_S263_I, quote = "be allowed as a deduction ratably over the 10-taxable year period beginning with the taxable year in which such costs were paid or incurred")
rule ForeignIdcRatableTenYears(p: Person, y: TaxableYear, paid_year: TaxableYear, item: Integer, total: Money, index: Integer) defeasible {
    label en official "unless the basis election applies, foreign IDC of a productive well is deducted ratably over 10 taxable years (section 263(i)(2)(B)); one tenth rounded to cents HALF_UP (JUDGMENT CALL: the text prescribes no rounding and the residual cent is not trued up)";
    when foreign_well_idc_paid_or_incurred(p, paid_year, item, total);
    when year_index_since_foreign_idc_paid(y, item, index);
    when index >= 0;
    when index <= 9;
    when not_known(foreign_well_is_nonproductive(item));
    when not_known(foreign_idc_included_in_adjusted_basis_for_611(p, y, item));
    then foreign_idc_ratable_deduction(p, y, item, div_round(total, 10.0, 2, "HALF_UP"));
}
