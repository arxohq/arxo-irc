// Section 168 — G1 class-life/recovery wiring (IRC-G, G1 wave, 2026-09-27).
// Sample wiring of (e)/(g)/(h)/(i) rows to the Rev. Proc. 87-56 class-life key.
//
// PATTERN (AFR sample, `us.irc.administration::21-below-market-loans.law`):
// the Rev. Proc. value enters as a case fact; the rule derives the statutory
// conclusion. `asset_class_8756` is the case-selected key: which Rev. Proc.
// 87-56 asset-class row the case applies to the asset. The row's class-life
// and recovery-period VALUES are not in this package (Rev. Proc. 87-56/87-57
// are pinned by the rule-less G1 source package, not here); until the pinned
// table lands, the values travel as the case facts below. No rate, life or
// percentage is invented here: every number in a rule is a statutory
// threshold quoted from section 168 itself (T2/T3 cells, 27.5, 40, 12, 3,
// 1, 30 percent, 16).
//
// SCOPE (sample only). (i)(1) definition; the full (e)(1) T2 table; the
// (e)(3)(C)(v) no-class-life catch-all; the (e)(2)(B)(ii) 27.5-year test;
// ADS T3(i)/(ii) and (g)(3)(E); the (h)(1)(C) short-term-lease test with the
// (II)-waiver; the (i)(18)/(19) 16-year test. NOT wired here: the (g)(3)(B)
// T4 deemed lives (awaits the pinned table), mid-quarter/month amounts,
// (e)(3) specific inclusions, (h) disqualified-lease (I)/(III)/(IV) branches.
// See the G1 wire journal.

// --- Case facts: the Rev. Proc. 87-56 key -----------------------------------

use self::{
    Asset,
    IRC_S168_E,
    IRC_S168_G,
    IRC_S168_H,
    IRC_S168_I,
    IRC_S168_TABLE_2,
    IRC_S168_TABLE_3,
    RecoveryPropertyClass,
};

relation asset_class_8756(a: Asset, class: Text) kind empirical {
    label en unofficial "the Rev. Proc. 87-56 asset class the case selects for the asset (case-selected key; the pinned G1 table will resolve this code to a class life — no table reader yet, see the module note)";
}

relation asset_class_life_years(a: Asset, life: Decimal) kind empirical {
    label en unofficial "the class life in years of the asset's Rev. Proc. 87-56 asset class (case fact on the AFR pattern; becomes a table lookup once the G1 source package pins Rev. Proc. 87-56)";
}

relation asset_has_no_class_life(a: Asset) kind empirical {
    label en unofficial "the asset's Rev. Proc. 87-56 asset class has no class life (case fact)";
}

relation asset_not_otherwise_classified_168e(a: Asset) kind empirical {
    label en unofficial "the asset is not otherwise classified under section 168(e)(2) or (e)(3) (case-applied, for the (e)(3)(C)(v)(II) element)";
}

relation asset_specially_classified_168e(a: Asset) kind empirical {
    label en unofficial "the asset is classified by a special rule of section 168(e)(2)-(4) rather than the (e)(1) table (case-applied, for the 'except as otherwise provided' guard)";
}

relation asset_is_personal_property(a: Asset) kind empirical {
    label en unofficial "the asset is personal property (case-applied, for ADS table clause (ii))";
}

relation asset_is_section1245_real_property(a: Asset) kind empirical {
    label en unofficial "the asset is section 1245 property which is real property (case-applied, for section 168(g)(3)(E))";
}

relation asset_is_section1250_property(a: Asset) kind empirical {
    label en unofficial "the asset is section 1250 property (case-applied, for section 168(e)(2)(B))";
}

relation asset_is_residential_rental(a: Asset) kind empirical {
    label en unofficial "the asset is residential rental property (case-applied, for section 168(e)(2)(B) and (h)(1)(C)(ii))";
}

relation asset_is_nonresidential_real_property(a: Asset) kind empirical {
    label en unofficial "the asset is nonresidential real property (case-applied, for section 168(h)(1)(C)(ii))";
}

relation asset_lease_term_years(a: Asset, years: Decimal) kind empirical {
    label en unofficial "the lease term of the asset in years, determined under section 168(i)(3) (case fact)";
}

relation asset_claimed_smart_meter_or_grid(a: Asset) kind empirical {
    label en unofficial "the asset is claimed to be a qualified smart electric meter or grid system meeting (i)(18)/(19)(A)(i) and (B) (case-applied; only the (A)(ii) class-life element is derived here)";
}

// --- (i)(1): the class-life definition --------------------------------------

pub relation class_life_years(a: Asset, life: Decimal) kind institutional {
    label en official "the class life of the asset under section 168(i)(1) (the Rev. Proc. 87-56 class life, determined without regard to subsection (e))";
}

@source(IRC_S168_I, quote = "means the class life (if any) which would be applicable with respect to any property as of January 1, 1986, under subsection (m) of section 167")
rule G1ClassLifeDefined(a: Asset, life: Decimal) strict {
    label en official "the section 168(i)(1) class life of the asset is the Rev. Proc. 87-56 class life cased for it";
    when asset_class_life_years(a, life);
    then class_life_years(a, life);
}

// --- Table path: class life from the pinned Rev. Proc. 87-56 ----------------
// For a case-selected asset class, the life value comes from the pinned
// G1 source package (rp8756-life table, base rows with empty sub) instead
// of a case fact. Parallel to the case-fact path; existing rules untouched.
@source(IRC_S168_I, quote = "means the class life (if any) which would be applicable with respect to any property as of January 1, 1986, under subsection (m) of section 167")
rule G1ClassLifeFromTable8756(a: Asset, class: Text, life: Decimal) strict {
    label en official "the section 168(i)(1) class life is the pinned Rev. Proc. 87-56 class life for the case-selected asset class";
    when asset_class_8756(a, class);
    when us.irs.rev_proc_87_56::class_life_row(class, "", life);
    then asset_class_life_years(a, life);
}

// --- (e)(1): GDS classification from the class life (table T2) ---------------

pub relation gds_class_from_class_life(a: Asset, class: RecoveryPropertyClass) kind institutional {
    label en official "the GDS property class of the asset derived from its class life under the section 168(e)(1) table";
}

@source(IRC_S168_TABLE_2, quote = "3-year property / 4 or less")
rule G1T2ThreeYear(a: Asset, life: Decimal) defeasible {
    label en official "class life of 4 years or less gives 3-year property (section 168(e)(1) table)";
    when class_life_years(a, life);
    when life <= 4.0;
    unless asset_specially_classified_168e(a);
    then gds_class_from_class_life(a, ThreeYearProperty);
}

@source(IRC_S168_TABLE_2, quote = "5-year property / More than 4 but less than 10")
rule G1T2FiveYear(a: Asset, life: Decimal) defeasible {
    label en official "class life of more than 4 but less than 10 years gives 5-year property (section 168(e)(1) table)";
    when class_life_years(a, life);
    when life > 4.0;
    when life < 10.0;
    unless asset_specially_classified_168e(a);
    then gds_class_from_class_life(a, FiveYearProperty);
}

@source(IRC_S168_TABLE_2, quote = "7-year property / 10 or more but less than 16")
rule G1T2SevenYear(a: Asset, life: Decimal) defeasible {
    label en official "class life of 10 or more but less than 16 years gives 7-year property (section 168(e)(1) table)";
    when class_life_years(a, life);
    when life >= 10.0;
    when life < 16.0;
    unless asset_specially_classified_168e(a);
    then gds_class_from_class_life(a, SevenYearProperty);
}

@source(IRC_S168_TABLE_2, quote = "10-year property / 16 or more but less than 20")
rule G1T2TenYear(a: Asset, life: Decimal) defeasible {
    label en official "class life of 16 or more but less than 20 years gives 10-year property (section 168(e)(1) table)";
    when class_life_years(a, life);
    when life >= 16.0;
    when life < 20.0;
    unless asset_specially_classified_168e(a);
    then gds_class_from_class_life(a, TenYearProperty);
}

@source(IRC_S168_TABLE_2, quote = "15-year property / 20 or more but less than 25")
rule G1T2FifteenYear(a: Asset, life: Decimal) defeasible {
    label en official "class life of 20 or more but less than 25 years gives 15-year property (section 168(e)(1) table)";
    when class_life_years(a, life);
    when life >= 20.0;
    when life < 25.0;
    unless asset_specially_classified_168e(a);
    then gds_class_from_class_life(a, FifteenYearProperty);
}

@source(IRC_S168_TABLE_2, quote = "20-year property / 25 or more")
rule G1T2TwentyYear(a: Asset, life: Decimal) defeasible {
    label en official "class life of 25 years or more gives 20-year property (section 168(e)(1) table)";
    when class_life_years(a, life);
    when life >= 25.0;
    unless asset_specially_classified_168e(a);
    then gds_class_from_class_life(a, TwentyYearProperty);
}

// --- (e)(3)(C)(v): the no-class-life catch-all --------------------------------

@source(IRC_S168_E, quote = "(I) does not have a class life, and")
rule G1SevenYearCatchAll(a: Asset) strict {
    label en official "property with no class life, not otherwise classified under paragraph (2) or (e)(3), is 7-year property (section 168(e)(3)(C)(v)(I)-(II))";
    when asset_has_no_class_life(a);
    when asset_not_otherwise_classified_168e(a);
    then gds_class_from_class_life(a, SevenYearProperty);
}

// --- (e)(2)(B)(ii): the 27.5-year nonresidential-real test --------------------

pub relation excluded_from_nonresidential_real_by_class_life(a: Asset) kind institutional {
    label en official "the asset is excluded from nonresidential real property by section 168(e)(2)(B)(ii) (section 1250 property with a class life of less than 27.5 years)";
}

@source(IRC_S168_E, quote = "(ii) property with a class life of less than 27.5 years.")
rule G1NonresidentialExcluded(a: Asset, life: Decimal) strict {
    label en official "section 1250 property (other than residential rental property) with a class life below 27.5 years is not nonresidential real property (section 168(e)(2)(B)(ii))";
    when asset_is_section1250_property(a);
    when not_known(asset_is_residential_rental(a));
    when class_life_years(a, life);
    when life < 27.5;
    then excluded_from_nonresidential_real_by_class_life(a);
}

// --- (g)(2)(C): ADS recovery period (table T3) ---------------------------------

pub relation ads_recovery_period_years(a: Asset, years: Decimal) kind institutional {
    label en official "the alternative depreciation system recovery period of the asset in years (section 168(g)(2)(C) table)";
}

@source(IRC_S168_TABLE_3, quote = "(i) Property not described in clause (ii) or (iii) / The class life.")
rule G1AdsEqualsClassLife(a: Asset, life: Decimal) strict {
    label en official "the ADS recovery period is the class life for property not described in clause (ii) or (iii) (section 168(g)(2)(C) table clause (i))";
    when class_life_years(a, life);
    then ads_recovery_period_years(a, life);
}

@source(IRC_S168_TABLE_3, quote = "(ii) Personal property with no class life / 12 years.")
rule G1AdsPersonalNoClassLife(a: Asset) strict {
    label en official "personal property with no class life has a 12-year ADS recovery period (section 168(g)(2)(C) table clause (ii))";
    when asset_is_personal_property(a);
    when asset_has_no_class_life(a);
    then ads_recovery_period_years(a, 12.0);
}

// --- (g)(3)(E): section 1245 real property with no class life ------------------

@source(IRC_S168_G, quote = "In the case of any section 1245 property which is real property with no class life, the recovery period used for purposes of paragraph (2) shall be 40 years.")
rule G1Ads1245RealNoClassLife(a: Asset) strict {
    label en official "section 1245 real property with no class life has a 40-year ADS recovery period (section 168(g)(3)(E))";
    when asset_is_section1245_real_property(a);
    when asset_has_no_class_life(a);
    then ads_recovery_period_years(a, 40.0);
}

// --- (h)(1)(C)(ii): short-term lease -------------------------------------------

pub relation short_term_lease_168h(a: Asset) kind institutional {
    label en official "the lease of the asset is a short-term lease under section 168(h)(1)(C)(ii)";
}

pub relation short_term_lease_clause_ii_inapplicable(a: Asset) kind institutional {
    label en official "subclause (II) of section 168(h)(1)(C)(ii) does not apply to the asset (nonresidential real property or property with no present class life)";
}

@source(IRC_S168_H, quote = "less than the greater of 1 year or 30 percent of the property's present class life.")
rule G1ShortTermLease(a: Asset, term: Decimal, life: Decimal) strict {
    label en official "a lease of less than 3 years and less than the greater of 1 year or 30 percent of the present class life is a short-term lease (section 168(h)(1)(C)(ii)(I)-(II))";
    when asset_lease_term_years(a, term);
    when term < 3.0;
    when class_life_years(a, life);
    when term < max(1.0, life * 0.30);
    when not_known(short_term_lease_clause_ii_inapplicable(a));
    then short_term_lease_168h(a);
}

@source(IRC_S168_H, quote = "In the case of nonresidential real property and property with no present class life, subclause (II) shall not apply.")
rule G1ShortTermLeaseWaiverNonresidential(a: Asset) strict {
    label en official "subclause (II) does not apply to nonresidential real property (section 168(h)(1)(C)(ii), last sentence)";
    when asset_is_nonresidential_real_property(a);
    then short_term_lease_clause_ii_inapplicable(a);
}

@source(IRC_S168_H, quote = "In the case of nonresidential real property and property with no present class life, subclause (II) shall not apply.")
rule G1ShortTermLeaseWaiverNoClassLife(a: Asset) strict {
    label en official "subclause (II) does not apply to property with no present class life (section 168(h)(1)(C)(ii), last sentence)";
    when asset_has_no_class_life(a);
    then short_term_lease_clause_ii_inapplicable(a);
}

@source(IRC_S168_H, quote = "less than 3 years, and")
rule G1ShortTermLeaseWaived(a: Asset, term: Decimal) strict {
    label en official "where subclause (II) does not apply, a lease of less than 3 years is a short-term lease (section 168(h)(1)(C)(ii)(I))";
    when asset_lease_term_years(a, term);
    when term < 3.0;
    when short_term_lease_clause_ii_inapplicable(a);
    then short_term_lease_168h(a);
}

// --- (i)(18)/(19): the 16-year smart-meter/grid test ----------------------------
// READING (recorded): "does not have a class life ... of less than 16 years"
// is satisfied two ways — a class life of 16 or more, or no class life at
// all (vacuous truth). Both branches are rules; the journal carries the note.

pub relation meets_smart_grid_class_life_test(a: Asset) kind institutional {
    label en official "the asset meets the class-life element of qualified smart electric meter / grid system status (section 168(i)(18)(A)(ii) and (i)(19)(A)(ii))";
}

@source(IRC_S168_I, quote = "(ii) does not have a class life (determined without regard to subsection (e)) of less than 16 years.")
rule G1SmartGridLife16(a: Asset, life: Decimal) strict {
    label en official "a class life of 16 years or more (determined without regard to subsection (e)) meets the smart-meter/grid class-life element (section 168(i)(18)(A)(ii), (i)(19)(A)(ii))";
    when asset_claimed_smart_meter_or_grid(a);
    when class_life_years(a, life);
    when life >= 16.0;
    then meets_smart_grid_class_life_test(a);
}

@source(IRC_S168_I, quote = "(ii) does not have a class life (determined without regard to subsection (e)) of less than 16 years.")
rule G1SmartGridNoClassLife(a: Asset) strict {
    label en official "property with no class life at all meets the smart-meter/grid class-life element vacuously (section 168(i)(18)(A)(ii), (i)(19)(A)(ii); adopted reading, see the module note)";
    when asset_claimed_smart_meter_or_grid(a);
    when asset_has_no_class_life(a);
    then meets_smart_grid_class_life_test(a);
}
