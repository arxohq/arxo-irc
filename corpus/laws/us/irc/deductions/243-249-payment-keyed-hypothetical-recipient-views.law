// Sections 243, 246, 246A -- payment-keyed views of the per-dividend relations (WIRE-6, 26.09.2026, DECISION-0379,
// implemented_unverified).
//
// WHY THIS MODULE EXISTS. The owner's relations of sections 243-246A are keyed by the recipient corporation and by
// `item: Integer`, "the per-dividend index of the return". A package that holds the same dividend as a
// `us.irc.core::Payment` (`us.irc.special_entities`, section 854(b)(3)) could not read them: no value of type Payment is an
// Integer (LDC-E2104), and the recipient there is a `Person`. The correct home of the identity is the owner of the index,
// so the owner publishes (1) the identity link `dividend_item_index_of_payment` between the Payment and the index and (2) the
// three tests of section 854(b)(3) as Payment-keyed `pub` relations whose recipient argument is `Person` (a value of the
// subtype `Corporation` widens to it). No norm is restated: each rule reads the owner's existing relation. A change of
// the shared identifier itself (one `Item` in `core` instead of `Integer` here and `Text` in `us.irc.international`) is
// recorded as DECISIONS.md Д-20 and is not made here.
//
// HYPOTHETICAL RECIPIENT. Section 854(b)(3) asks whether a deduction "would have been allowable under section 243 to the
// regulated investment company ... as if section 243 applied". The recipient is the explicit argument `c` of the item
// relations: the case states the premises of sections 243-246A FOR THE RIC AS THE RECIPIENT (the RIC itself is the
// `Corporation` of `dividend_received_by_corporation`); nothing in the owner's relations distinguishes a real from a
// hypothetical recipient, so "as if section 243 applied" needs no new parameter.

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

use self::{
    Corporation,
    Person,
    TaxableYear,
    debt_financed_portfolio_stock,
    dividend_eligible_for_243_source,
    dividend_received_by_corporation,
    dividends_received_deduction_disallowed_246,
};

pub relation dividend_item_index_of_payment(pay: us.irc.core::Payment, item: Integer) kind empirical {
    label en unofficial "the per-dividend index (`item`) that the return of the recipient corporation uses for this dividend, given as a Payment by a package that holds the dividend under that type (identity link, not a norm)";
}

pub relation payment_dividend_not_eligible_for_243(c: Person, y: TaxableYear, pay: us.irc.core::Payment) kind institutional {
    label en unofficial "no section 243 deduction would be allowable for the dividend, even if section 243 applied to the recipient: the dividend is not a section 243(a) dividend of a taxable domestic corporation";
}
rule PaymentDividendNotEligibleFor243(c: Corporation, y: TaxableYear, pay: us.irc.core::Payment, item: Integer, amount: Money) strict {
    label en unofficial "a dividend received by the corporation that is not eligible under section 243(a),(d),(e) is not deductible (section 854(b)(3)(A) reads this)";
    when dividend_item_index_of_payment(pay, item);
    when dividend_received_by_corporation(c, y, item, amount);
    when not_known(dividend_eligible_for_243_source(c, y, item));
    then payment_dividend_not_eligible_for_243(c, y, pay);
}

pub relation payment_dividend_denied_by_246_without_246b(c: Person, y: TaxableYear, pay: us.irc.core::Payment) kind institutional {
    label en unofficial "the deduction is denied by section 246(a) or (c) (the aggregate limit of section 246(b) is a separate relation and is not applied)";
}
rule PaymentDividendDeniedBy246(c: Corporation, y: TaxableYear, pay: us.irc.core::Payment, item: Integer) strict {
    label en unofficial "the item relation of section 246(a),(c) read for the dividend held as a Payment (section 854(b)(3)(B))";
    when dividend_item_index_of_payment(pay, item);
    when dividends_received_deduction_disallowed_246(c, y, item);
    then payment_dividend_denied_by_246_without_246b(c, y, pay);
}

pub relation payment_dividend_denied_by_246A(c: Person, y: TaxableYear, pay: us.irc.core::Payment) kind institutional {
    label en unofficial "the deduction is denied or reduced for debt financed portfolio stock under section 246A";
}
rule PaymentDividendDeniedBy246A(c: Corporation, y: TaxableYear, pay: us.irc.core::Payment, item: Integer) strict {
    label en unofficial "the item relation of section 246A read for the dividend held as a Payment (section 854(b)(3)(C))";
    when dividend_item_index_of_payment(pay, item);
    when debt_financed_portfolio_stock(c, y, item);
    then payment_dividend_denied_by_246A(c, y, pay);
}
