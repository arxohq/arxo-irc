// Section 174 / new section 174A — research and experimental expenditures.
// Stage 2b. Two editions: section 174(a)-(b) (5-year/15-year-foreign
// amortization, taxable years beginning before January 1, 2025 — the
// current 2024-edition text of section 174 itself) and new section 174A
// (Pub. L. 119-21 section 70302: immediate expensing of DOMESTIC research
// or experimental expenditures, taxable years beginning after December 31,
// 2024, with an election back to amortization over taxpayer-selected
// months). Scope: (a)/(b) of both; NOT done: section 174(c) special rules
// (land/depreciable property, exploration expenditures), (d) disposition
// treatment, and 174A(c)(2)-(5) election mechanics/(d) definitions.

use self::{
    IRC_S174_A,
    Person,
    TaxableYear,
    research_expenditure_174,
};

pub relation taxable_year_begins_on(y: TaxableYear, on: Date) kind empirical {
    label en official "the date the taxable year begins, for the section 174/174A edition boundary (taxable years beginning after December 31, 2024)";
}
pub relation research_or_experimental_expenditure_paid_or_incurred(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount of research or experimental expenditures paid or incurred by the taxpayer during the taxable year in connection with the taxpayer's trade or business (section 174(b)/174A(b))";
}
pub relation research_expenditure_attributable_to_foreign_research(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the research or experimental expenditure is attributable to foreign research within the meaning of section 41(d)(4)(F) (section 174(a)(2)(B), 174A(b))";
}

pub relation taxable_year_pre_2025_edition(y: TaxableYear) kind institutional {
    label en official "the taxable year begins before January 1, 2025, so section 174(a)-(b) (5-year/15-year amortization) governs research or experimental expenditures for the year";
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "paid or incurred in taxable years beginning after December 31, 2024")
rule TaxableYearPre2025EditionRule(y: TaxableYear, begins: Date) strict {
    label en official "a taxable year beginning on or before December 31, 2024 stays under the pre-Pub. L. 119-21 section 174(a)-(b) amortization regime";
    when taxable_year_begins_on(y, begins);
    when begins <= @2024-12-31;
    then taxable_year_pre_2025_edition(y);
}

// --- pre-2025 edition: section 174(a)-(b), 5-year/15-year amortization -----

pub relation section_174_amortization_year1(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the year-1 (first-taxable-year) section 174(a)(2)(B) amortization amount for a specified research or experimental expenditure, before mid-year proration (intermediate value; see the note below)";
}
@source(IRC_S174_A, quote = "be allowed an amortization deduction of such expenditures ratably over the 5-year period")
rule Section174AmortizationDomesticFullYear(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "domestic specified research or experimental expenditures amortize ratably over 5 years (a full-year amount; the statute's own mid-point-of-the-taxable-year proration for the first year is NOT modelled here — TECH_GAP, same class as section 197's month-of-acquisition proration)";
    when taxable_year_pre_2025_edition(y);
    when research_expenditure_174(p, y, item, amount);
    when not_known(research_expenditure_attributable_to_foreign_research(p, y, item));
    then section_174_amortization_year1(p, y, item, round(0.20 * amount, 2, "HALF_UP"));
}
@source(IRC_S174_A, quote = "15-year period in the case of any specified research or experimental expenditures which are attributable to foreign research")
rule Section174AmortizationForeignFullYear(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "foreign specified research or experimental expenditures amortize ratably over 15 years (a full-year amount; mid-point proration not modelled)";
    when taxable_year_pre_2025_edition(y);
    when research_expenditure_174(p, y, item, amount);
    when research_expenditure_attributable_to_foreign_research(p, y, item);
    then section_174_amortization_year1(p, y, item, div_round(amount, 15.0, 2, "HALF_UP"));
}

// --- new edition: section 174A(a), immediate expensing of DOMESTIC R&E ------

pub relation domestic_research_expenditure_deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the section 174A(a) deduction for domestic research or experimental expenditures paid or incurred during the taxable year";
}
@source(us.irc.temporal::PL119_21_S70302, relation = derives_from, quote = "there shall be allowed as a deduction any domestic research or experimental expenditures which are paid or incurred by the taxpayer during the taxable year")
rule Section174ADomesticExpensingRule(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "domestic research or experimental expenditures are immediately deductible for taxable years beginning after December 31, 2024 (Pub. L. 119-21 section 70302, new section 174A(a))";
    when research_expenditure_174(p, y, item, amount);
    when not_known(research_expenditure_attributable_to_foreign_research(p, y, item));
    when not_known(taxable_year_pre_2025_edition(y));
    then domestic_research_expenditure_deduction(p, y, item, amount);
}
// Foreign research or experimental expenditures remain amortized over 15
// years even in the 174A edition (174A(b) excludes them from "domestic");
// no separate post-2025 foreign-research rule is written here (it would be
// identical to `Section174AmortizationForeignFullYear` without the
// pre-2025 gate) — NOT DONE this session, TECH_GAP.
// 174A(c) election back to amortization (60+ months, taxpayer-selected) is
// NOT modelled — TECH_GAP.
