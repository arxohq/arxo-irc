// Section 166 — Bad debts. Stage 1 (IRC-06).

use self::{
    DeductionKind,
    IRC_S166_A,
    IRC_S166_D,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
    political_party_debt_deduction_denied_271,
    section_166_inapplicable_to_debt,
};

pub relation debt_wholly_worthless_within_year(p: Person, y: TaxableYear, item: Integer, basis: Money) kind empirical {
    label en official "a debt becomes wholly worthless within the taxable year (section 166(a)(1))";
}
pub relation nonbusiness_debt(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a debt other than one created/acquired in connection with, or whose worthlessness loss is incurred in, the taxpayer's trade or business (section 166(d)(2))";
}

@source(IRC_S166_A, quote = "There shall be allowed as a deduction any debt which becomes worthless within the taxable year")
rule BadDebtWhollyWorthlessAllowed(p: Person, y: TaxableYear, item: Integer, basis: Money) strict {
    label en official "a wholly worthless business debt is allowed as a deduction, measured by its adjusted basis (section 166(a)(1), (b)); a nonbusiness debt of a non-corporate taxpayer is excluded (section 166(d)(1)(A))";
    when debt_wholly_worthless_within_year(p, y, item, basis);
    when not_known(section_166_inapplicable_to_debt(p, item));
    when not_known(nonbusiness_debt(p, y, item));
    when not_known(political_party_debt_deduction_denied_271(p, y, item, basis));
    then deduction_allowed(p, y, Section166BadDebts, basis);
}
// §166(d)(1)(A) ("subsection (a) shall not apply to any nonbusiness debt")
// is not a separate disallowance rule: it is the CONDITION that routes a
// nonbusiness debt away from the ordinary section 166(a) deduction and into
// the capital-loss characterization of (d)(1)(B) below, which is itself a
// form of allowance (as a capital loss, not a bad-debt deduction) — the two
// paragraphs are read together, not as an allow/disallow pair on the same
// classification, avoiding a same-head strict conflict on `deduction_allowed`.

@source(IRC_S166_D, quote = "the loss resulting therefrom shall be considered a loss from the sale or exchange, during the taxable year, of a capital asset held for not more than 1 year")
rule NonbusinessDebtTreatedAsShortTermCapitalLoss(p: Individual, y: TaxableYear, item: Integer, basis: Money) strict {
    label en official "a worthless nonbusiness debt is instead treated as a short-term capital loss (section 166(d)(1)(B)) — classification; the capital-loss limitation itself is `property-transactions`' concern (pending)";
    when debt_wholly_worthless_within_year(p, y, item, basis);
    when nonbusiness_debt(p, y, item);
    when not_known(political_party_debt_deduction_denied_271(p, y, item, basis));
    then deduction_allowed(p, y, Section166BadDebts, basis);
}
// (a)(2) partial worthlessness (a Secretary satisfaction determination —
// EVALUATIVE, channel: Secretary) and (e) (no bad debt deduction for
// worthless securities, cross-referencing section 165(g)) stay "stage 2".
