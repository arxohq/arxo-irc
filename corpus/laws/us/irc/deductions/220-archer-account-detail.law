// Section 220 — Archer MSAs: stage 2b, part 3: the account, qualified medical expenses, tax exemption
// and the distribution rules of (f)(3),(5),(7),(8) (TECH_GAPS G2718). The relation
// `distribution_is_rollover_or_excess_contribution_return` of stage 1 is derived here from the
// 60-day rollover rule and the returned-excess rule. Modelled like `223-hsa-detail.law`; the
// incorporated rules of sections 408(g),(h),(e) and 219(f)(5) are external. Not modelled: the
// lowest-deductible choice ((b)(3) part 1), the amount of the section 691(c) deduction.

// --- (d)(1): the Archer MSA --------------------------------------------------------------------------------------------------------------------------

use self::{
    IRC_S220_D,
    IRC_S220_E,
    IRC_S220_F,
    IRC_S220_H,
    Individual,
    Person,
    TaxableYear,
    amount_paid_in_cash_to_archer_msa,
    archer_msa_deduction,
    distribution_is_rollover_or_excess_contribution_return,
};

pub relation trust_created_in_united_states_as_msa_exclusively_for_qualified_medical_expenses(acct: Integer) kind empirical {
    label en official "a trust created or organized in the United States as a medical savings account exclusively for the purpose of paying the qualified medical expenses of the account holder (section 220(d)(1))";
}
pub relation archer_instrument_accepts_only_cash_contributions(acct: Integer) kind empirical {
    label en official "the governing instrument provides that, except for a rollover contribution, no contribution will be accepted unless it is in cash (section 220(d)(1)(A)(i))";
}
pub relation archer_instrument_caps_contributions_at_75_percent_of_highest_deductible(acct: Integer) kind empirical {
    label en official "the governing instrument provides that no contribution will be accepted to the extent it, with previous contributions for the calendar year, exceeds 75 percent of the highest annual limit deductible permitted under subsection (c)(2)(A)(ii) (section 220(d)(1)(A)(ii))";
}
pub relation archer_trustee_is_bank_or_insurance_company(acct: Integer) kind empirical {
    label en official "the trustee is a bank (section 408(n)) or an insurance company (section 816) (section 220(d)(1)(B))";
}
external judgment relation archer_trustee_demonstrates_consistent_administration_to_secretary(acct: Integer) {
    authority Secretary;
    label en official "another person demonstrates to the satisfaction of the Secretary that its administration of the trust will be consistent with the requirements of section 220 (section 220(d)(1)(B))";
}
pub relation archer_instrument_bars_life_insurance_investment(acct: Integer) kind empirical {
    label en official "no part of the trust assets will be invested in life insurance contracts (section 220(d)(1)(C))";
}
pub relation archer_instrument_bars_commingling(acct: Integer) kind empirical {
    label en official "the assets will not be commingled with other property except in a common trust fund or common investment fund (section 220(d)(1)(D))";
}
pub relation archer_instrument_makes_interest_nonforfeitable(acct: Integer) kind empirical {
    label en official "the interest of an individual in the balance in his account is nonforfeitable (section 220(d)(1)(E))";
}
pub relation qualified_archer_trustee(acct: Integer) kind institutional {
    label en official "the trustee satisfies section 220(d)(1)(B)";
}
@source(IRC_S220_D, quote = "The trustee is a bank (as defined in section 408(n)), an insurance company (as defined in section 816)")
rule QualifiedArcherTrusteeBankOrInsurer(acct: Integer) strict {
    label en official "a bank or insurance company is a qualified trustee (section 220(d)(1)(B))";
    when archer_trustee_is_bank_or_insurance_company(acct);
    then qualified_archer_trustee(acct);
}
@source(IRC_S220_D, quote = "or another person who demonstrates to the satisfaction of the Secretary")
rule QualifiedArcherTrusteeApproved(acct: Integer) strict {
    label en official "a person approved by the Secretary is a qualified trustee (section 220(d)(1)(B))";
    when archer_trustee_demonstrates_consistent_administration_to_secretary(acct);
    then qualified_archer_trustee(acct);
}
pub relation archer_msa_account(acct: Integer) kind institutional {
    label en official "an Archer MSA within section 220(d)(1)";
}
@source(IRC_S220_D, quote = "The term \"Archer MSA\" means a trust created or organized in the United States as a medical savings account exclusively for the purpose of paying the qualified medical expenses of the account holder")
rule ArcherMsaDefinition(acct: Integer) strict {
    label en official "a trust created in the United States exclusively to pay qualified medical expenses whose governing instrument meets requirements (A)-(E) is an Archer MSA (section 220(d)(1))";
    when trust_created_in_united_states_as_msa_exclusively_for_qualified_medical_expenses(acct);
    when archer_instrument_accepts_only_cash_contributions(acct);
    when archer_instrument_caps_contributions_at_75_percent_of_highest_deductible(acct);
    when qualified_archer_trustee(acct);
    when archer_instrument_bars_life_insurance_investment(acct);
    when archer_instrument_bars_commingling(acct);
    when archer_instrument_makes_interest_nonforfeitable(acct);
    then archer_msa_account(acct);
}
pub relation archer_msa_established_on_behalf_of(acct: Integer, holder: Individual) kind empirical {
    label en official "the individual on whose behalf the Archer MSA was established";
}
pub relation archer_account_holder(acct: Integer, holder: Individual) kind institutional {
    label en official "the account holder of the Archer MSA (section 220(d)(3))";
}
@source(IRC_S220_D, quote = "The term \"account holder\" means the individual on whose behalf the Archer MSA was established.")
rule ArcherAccountHolderDefinition(acct: Integer, holder: Individual) strict {
    label en official "the individual on whose behalf the account was established is the account holder (section 220(d)(3))";
    when archer_msa_account(acct);
    when archer_msa_established_on_behalf_of(acct, holder);
    then archer_account_holder(acct, holder);
}

// --- (d)(2): qualified medical expenses ------------------------------------------------------------------------------------------------------------------

pub relation archer_payment_by_holder(acct: Integer, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid by the account holder (section 220(d)(2)(A))";
}
pub relation archer_payment_is_medical_care_213d_for_holder_spouse_or_dependent(item: Integer) kind empirical {
    label en official "the amount is paid for medical care (section 213(d)) for the account holder, the spouse or a dependent (section 152 without regard to (b)(1),(b)(2),(d)(1)(B)) (section 220(d)(2)(A))";
}
pub relation archer_payment_for_menstrual_care_product(item: Integer) kind empirical {
    label en official "the amount is paid for a menstrual care product (section 223(d)(2)(D)), treated as paid for medical care (section 220(d)(2)(A))";
}
pub relation archer_amount_compensated_by_insurance_or_otherwise(item: Integer, amount: Money) kind empirical {
    label en official "the part of the payment compensated by insurance or otherwise (section 220(d)(2)(A))";
}
pub relation archer_payment_for_insurance(item: Integer) kind empirical {
    label en official "the payment is for insurance (section 220(d)(2)(B)(i))";
}
pub relation archer_insurance_for_continuation_coverage(item: Integer) kind empirical {
    label en official "a health plan during a period of continuation coverage required under Federal law (section 220(d)(2)(B)(ii)(I))";
}
pub relation archer_insurance_for_qualified_long_term_care_contract(item: Integer) kind empirical {
    label en official "a qualified long-term care insurance contract (section 7702B(b)) (section 220(d)(2)(B)(ii)(II))";
}
pub relation archer_insurance_for_plan_during_unemployment_compensation(item: Integer) kind empirical {
    label en official "a health plan during a period in which the individual receives unemployment compensation (section 220(d)(2)(B)(ii)(III))";
}
pub relation archer_insurance_exception_applies(item: Integer) kind institutional {
    label en official "one of the exceptions of section 220(d)(2)(B)(ii) lets the payment for insurance be a qualified medical expense";
}
@source(IRC_S220_D, quote = "(I) a health plan during any period of continuation coverage required under any Federal law,")
rule ArcherInsuranceExceptionContinuation(item: Integer) strict {
    label en official "continuation coverage (section 220(d)(2)(B)(ii)(I))";
    when archer_insurance_for_continuation_coverage(item);
    then archer_insurance_exception_applies(item);
}
@source(IRC_S220_D, quote = "(II) a qualified long-term care insurance contract (as defined in section 7702B(b)), or")
rule ArcherInsuranceExceptionLongTermCare(item: Integer) strict {
    label en official "a qualified long-term care insurance contract (section 220(d)(2)(B)(ii)(II))";
    when archer_insurance_for_qualified_long_term_care_contract(item);
    then archer_insurance_exception_applies(item);
}
@source(IRC_S220_D, quote = "(III) a health plan during a period in which the individual is receiving unemployment compensation under any Federal or State law.")
rule ArcherInsuranceExceptionUnemployment(item: Integer) strict {
    label en official "a health plan during unemployment compensation (section 220(d)(2)(B)(ii)(III))";
    when archer_insurance_for_plan_during_unemployment_compensation(item);
    then archer_insurance_exception_applies(item);
}
pub relation archer_qualified_medical_expense(acct: Integer, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the qualified medical expenses of the account holder paid for the item, net of amounts compensated by insurance or otherwise (section 220(d)(2))";
}
@source(IRC_S220_D, quote = "but only to the extent such amounts are not compensated for by insurance or otherwise")
rule ArcherQualifiedMedicalExpenseMedicalCare(acct: Integer, y: TaxableYear, item: Integer, paid: Money, compensated: Money) strict {
    label en official "an amount paid for medical care of the holder, spouse or dependent is a qualified medical expense to the extent not compensated (section 220(d)(2)(A)), unless it is a payment for insurance";
    when archer_payment_by_holder(acct, y, item, paid);
    when archer_payment_is_medical_care_213d_for_holder_spouse_or_dependent(item);
    when archer_amount_compensated_by_insurance_or_otherwise(item, compensated);
    when not_known(archer_payment_for_insurance(item));
    then archer_qualified_medical_expense(acct, y, item, max(0.00 USD, paid - compensated));
}
@source(IRC_S220_D, quote = "amounts paid for menstrual care products (as defined in section 223(d)(2)(D)) shall be treated as paid for medical care")
rule ArcherQualifiedMedicalExpenseMenstrualCare(acct: Integer, y: TaxableYear, item: Integer, paid: Money, compensated: Money) strict {
    label en official "amounts paid for menstrual care products are treated as paid for medical care (section 220(d)(2)(A))";
    when archer_payment_by_holder(acct, y, item, paid);
    when archer_payment_for_menstrual_care_product(item);
    when archer_amount_compensated_by_insurance_or_otherwise(item, compensated);
    then archer_qualified_medical_expense(acct, y, item, max(0.00 USD, paid - compensated));
}
@source(IRC_S220_D, quote = "Clause (i) shall not apply to any expense for coverage under")
rule ArcherQualifiedMedicalExpenseInsuranceException(acct: Integer, y: TaxableYear, item: Integer, paid: Money, compensated: Money) strict {
    label en official "a payment for insurance is a qualified medical expense only within an exception of (d)(2)(B)(ii) (section 220(d)(2)(B))";
    when archer_payment_by_holder(acct, y, item, paid);
    when archer_payment_is_medical_care_213d_for_holder_spouse_or_dependent(item);
    when archer_payment_for_insurance(item);
    when archer_insurance_exception_applies(item);
    when archer_amount_compensated_by_insurance_or_otherwise(item, compensated);
    then archer_qualified_medical_expense(acct, y, item, max(0.00 USD, paid - compensated));
}
pub relation archer_expense_for_individual_not_eligible_in_month(acct: Integer, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is paid for medical care of an individual who is not described in clauses (i) and (ii) of subsection (c)(1)(A) for the month in which the expense is incurred (section 220(d)(2)(C))";
}
pub relation archer_contribution_made_for_taxable_year_other_than_rollover(acct: Integer, y: TaxableYear) kind empirical {
    label en official "an amount is contributed (other than a rollover) to any Archer MSA of the account holder for the taxable year which includes the month (section 220(d)(2)(C))";
}
pub relation archer_qualified_medical_expense_for_ineligible_individual(acct: Integer, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "medical care of an individual who is not an eligible individual counts only if no contribution (other than a rollover) is made for the year (section 220(d)(2)(C)); insurance other than (B)(ii)(II) coverage stays excluded";
}
@source(IRC_S220_D, quote = "Subparagraph (A) shall apply to an amount paid by an account holder for medical care of an individual who is not described in clauses (i) and (ii) of subsection (c)(1)(A) for the month in which the expense for such care is incurred only if no amount is contributed")
rule ArcherExpenseForIneligibleIndividualOnlyIfNoContribution(acct: Integer, y: TaxableYear, item: Integer, paid: Money, compensated: Money) strict {
    label en official "for an individual not eligible in the month the expense counts only if no contribution other than a rollover was made for the year (section 220(d)(2)(C))";
    when archer_payment_by_holder(acct, y, item, paid);
    when archer_payment_is_medical_care_213d_for_holder_spouse_or_dependent(item);
    when archer_expense_for_individual_not_eligible_in_month(acct, y, item);
    when archer_amount_compensated_by_insurance_or_otherwise(item, compensated);
    when not_known(archer_contribution_made_for_taxable_year_other_than_rollover(acct, y));
    then archer_qualified_medical_expense_for_ineligible_individual(acct, y, item, max(0.00 USD, paid - compensated));
}

// --- (d)(4)(A),(B): rules similar to sections 219(d)(2) and 219(f)(3) ----------------------------------------------------------------------------------

pub relation archer_rollover_contribution_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a rollover contribution described in section 220(f)(5) paid into an Archer MSA of the individual";
}
pub relation archer_rollover_amount_not_deductible(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "no deduction is allowed for a rollover contribution (rules similar to section 219(d)(2), section 220(d)(4)(A))";
}
@source(IRC_S220_D, quote = "(A) Section 219(d)(2) (relating to no deduction for rollovers).")
rule ArcherNoDeductionForRollovers(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "a rollover contribution is not deductible under section 220 (section 220(d)(4)(A))";
    when archer_rollover_contribution_received(p, y, amount);
    then archer_rollover_amount_not_deductible(p, y, amount);
}
pub relation archer_contribution_made_on(p: Individual, acct: Integer, made_on: Date, for_year: TaxableYear, amount: Money) kind empirical {
    label en official "a contribution to an Archer MSA made on the date on account of the taxable year";
}
pub relation archer_return_due_date_without_extensions(p: Individual, y: TaxableYear, due: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year, not including extensions (section 219(f)(3) as applied by section 220(d)(4)(B))";
}
pub relation archer_taxable_year_last_day(y: TaxableYear, last_day: Date) kind empirical {
    label en official "the last day of the taxable year";
}
pub relation archer_contribution_deemed_made_last_day_of_year(p: Individual, acct: Integer, y: TaxableYear, deemed: Date, amount: Money) kind institutional {
    label en official "a contribution made on account of the taxable year by the return due date (without extensions) is deemed made on the last day of that year (section 220(d)(4)(B))";
}
@source(IRC_S220_D, quote = "(B) Section 219(f)(3) (relating to time when contributions deemed made).")
rule ArcherContributionDeemedMadeLastDayOfYear(p: Individual, acct: Integer, y: TaxableYear, made: Date, due: Date, last_day: Date, amount: Money) strict {
    label en official "a contribution on account of a year made by the return due date is deemed made on the last day of that year (section 220(d)(4)(B))";
    when archer_contribution_made_on(p, acct, made, y, amount);
    when archer_return_due_date_without_extensions(p, y, due);
    when archer_taxable_year_last_day(y, last_day);
    when made <= due;
    then archer_contribution_deemed_made_last_day_of_year(p, acct, y, last_day, amount);
}

// --- (e)(1): exemption ----------------------------------------------------------------------------------------------------------------------------------

pub relation archer_msa_has_ceased_to_be_archer_msa(acct: Integer) kind empirical {
    label en official "the account has ceased to be an Archer MSA (section 220(e)(1))";
}
pub relation archer_msa_exempt_from_income_tax(acct: Integer) kind institutional {
    label en official "the Archer MSA is exempt from taxation under subtitle A (section 220(e)(1))";
}
pub relation archer_msa_subject_to_section_511_tax(acct: Integer) kind institutional {
    label en official "the Archer MSA is subject to the tax on unrelated business income of section 511 (section 220(e)(1))";
}
@source(IRC_S220_E, quote = "An Archer MSA is exempt from taxation under this subtitle unless such account has ceased to be an Archer MSA.")
rule ArcherMsaExemptFromTaxation(acct: Integer) defeasible {
    label en official "an Archer MSA is exempt while it remains one (section 220(e)(1))";
    when archer_msa_account(acct);
    unless archer_msa_has_ceased_to_be_archer_msa(acct);
    then archer_msa_exempt_from_income_tax(acct);
}
@source(IRC_S220_E, quote = "Notwithstanding the preceding sentence, any such account is subject to the taxes imposed by section 511")
rule ArcherMsaSubjectToSection511(acct: Integer) strict {
    label en official "the exemption does not displace the section 511 tax (section 220(e)(1))";
    when archer_msa_account(acct);
    then archer_msa_subject_to_section_511_tax(acct);
}

// --- (f)(3): excess contributions returned before the due date -----------------------------------------------------------------------------------------------------

pub relation archer_excess_contribution(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the contribution (other than a rollover) which is neither excludable under section 106(b) nor deductible under section 220 (section 220(f)(3)(B)); the cash paid less the deduction, employer contributions being outside `amount_paid_in_cash_to_archer_msa`";
}
@source(IRC_S220_F, quote = "the term \"excess contribution\" means any contribution (other than a rollover contribution) which is neither excludable from gross income under section 106(b) nor deductible under this section")
rule ArcherExcessContributionDerived(p: Individual, y: TaxableYear, paid: Money, deductible: Money) strict {
    label en official "the part of the cash contributed above the deduction is an excess contribution (section 220(f)(3)(B))";
    when amount_paid_in_cash_to_archer_msa(p, y, paid);
    when archer_msa_deduction(p, y, deductible);
    when paid > deductible;
    then archer_excess_contribution(p, y, paid - deductible);
}
pub relation archer_excess_returned(p: Individual, y: TaxableYear, item: Integer, amount: Money, net_income: Money, received_on: Date) kind empirical {
    label en official "a distribution from the individual's Archer MSAs returning excess contributions for the year, with the net income attributable to them, received on the date (section 220(f)(3)(A))";
}
pub relation archer_return_due_date_with_extensions(p: Individual, y: TaxableYear, due: Date) kind empirical {
    label en official "the last day prescribed by law (including extensions of time) for filing the individual's return for the taxable year (section 220(f)(3)(A)(i))";
}
pub relation archer_excess_return_qualifies(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the returned excess is not included under paragraph (2): received by the return due date (with extensions) with its net income, up to the excess contributions (section 220(f)(3)(A))";
}
@source(IRC_S220_F, quote = "such distribution is received by the individual on or before the last day prescribed by law (including extensions of time) for filing such individual's return for such taxable year")
rule ArcherExcessReturnQualifies(p: Individual, y: TaxableYear, item: Integer, amount: Money, net_income: Money, received: Date, due: Date, excess: Money) strict {
    label en official "a timely return of excess contributions with its net income qualifies, to the extent of the excess contributions (section 220(f)(3)(A))";
    when archer_excess_returned(p, y, item, amount, net_income, received);
    when archer_return_due_date_with_extensions(p, y, due);
    when archer_excess_contribution(p, y, excess);
    when received <= due;
    then archer_excess_return_qualifies(p, y, item, min(amount, excess));
}
pub relation archer_returned_net_income_year_received(p: Individual, y: TaxableYear, received_year: TaxableYear) kind empirical {
    label en official "the taxable year in which the returned excess and its net income are received";
}
pub relation archer_returned_net_income_included(p: Individual, received_year: TaxableYear, net_income: Money) kind institutional {
    label en official "the net income attributable to a returned excess contribution is included in gross income for the taxable year in which it is received (section 220(f)(3)(A) last sentence)";
}
@source(IRC_S220_F, quote = "Any net income described in clause (ii) shall be included in the gross income of the individual for the taxable year in which it is received.")
rule ArcherReturnedNetIncomeIncluded(p: Individual, y: TaxableYear, item: Integer, amount: Money, net_income: Money, received: Date, received_year: TaxableYear, qualified: Money) strict {
    label en official "the net income accompanying a qualifying return of excess is gross income of the year received (section 220(f)(3)(A))";
    when archer_excess_returned(p, y, item, amount, net_income, received);
    when archer_excess_return_qualifies(p, y, item, qualified);
    when archer_returned_net_income_year_received(p, y, received_year);
    then archer_returned_net_income_included(p, received_year, net_income);
}
@source(IRC_S220_F, quote = "paragraph (2) shall not apply to distributions from the Archer MSAs of such individual")
rule ArcherExcessReturnIsExceptedDistribution(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a qualifying returned excess is not included under paragraph (2): it feeds the stage 1 exception relation (section 220(f)(3))";
    when archer_excess_return_qualifies(p, y, item, amount);
    then distribution_is_rollover_or_excess_contribution_return(p, y, item);
}

// --- (f)(5): rollover ------------------------------------------------------------------------------------------------------------------------------------------------------

pub relation archer_rollover_received_and_repaid(p: Individual, y: TaxableYear, item: Integer, received_on: Date, repaid_on: Date) kind empirical {
    label en official "an amount distributed from an Archer MSA to the account holder and paid into an Archer MSA or a health savings account for the benefit of the holder on the later date (section 220(f)(5)(A))";
}
pub relation another_untaxed_archer_rollover_in_prior_year(p: Individual, y: TaxableYear, item: Integer) kind empirical {
    label en official "at any time during the 1-year period ending on the day of receipt the individual received another amount described in paragraph (5)(A) from an Archer MSA not includible in gross income because of paragraph (5) (section 220(f)(5)(B))";
}
@source(IRC_S220_F, quote = "not later than the 60th day after the day on which the holder receives the payment or distribution")
rule ArcherRolloverWithin60DaysOnePerYear(p: Individual, y: TaxableYear, item: Integer, received: Date, repaid: Date) strict {
    label en official "an amount paid into an Archer MSA or HSA not later than the 60th day after receipt is a rollover unless another such rollover was received in the preceding year (section 220(f)(5)); it feeds the stage 1 exception relation";
    when archer_rollover_received_and_repaid(p, y, item, received, repaid);
    when repaid <= add_calendar_period(received, 60 calendar_day);
    when not_known(another_untaxed_archer_rollover_in_prior_year(p, y, item));
    then distribution_is_rollover_or_excess_contribution_return(p, y, item);
}

// --- (f)(7),(8): divorce and death ----------------------------------------------------------------------------------------------------------------------------------------

pub relation archer_interest_transferred_under_divorce_instrument(acct: Integer, from_p: Individual, to_p: Individual) kind empirical {
    label en official "an individual's interest in an Archer MSA is transferred to the spouse or former spouse under a divorce or separation instrument described in section 121(d)(3)(C)(i) (section 220(f)(7))";
}
pub relation archer_divorce_transfer_is_taxable_transfer(acct: Integer, from_p: Individual) kind institutional {
    label en official "the transfer is a taxable transfer made by the individual";
}
@source(IRC_S220_F, quote = "shall not be considered a taxable transfer made by such individual notwithstanding any other provision of this subtitle")
rule ArcherDivorceTransferNotTaxable(acct: Integer, from_p: Individual, to_p: Individual) strict {
    label en official "a divorce or separation transfer of an Archer MSA interest is not a taxable transfer (section 220(f)(7))";
    when archer_interest_transferred_under_divorce_instrument(acct, from_p, to_p);
    then not archer_divorce_transfer_is_taxable_transfer(acct, from_p);
}
@source(IRC_S220_F, quote = "such interest shall, after such transfer, be treated as an Archer MSA with respect to which such spouse is the account holder")
rule ArcherDivorceTransfereeIsAccountHolder(acct: Integer, from_p: Individual, to_p: Individual) strict {
    label en official "after the transfer the spouse or former spouse is the account holder (section 220(f)(7))";
    when archer_interest_transferred_under_divorce_instrument(acct, from_p, to_p);
    then archer_account_holder(acct, to_p);
}
pub relation archer_surviving_spouse_designated_beneficiary_acquires(acct: Integer, deceased: Individual, spouse: Individual) kind empirical {
    label en official "the account holder's surviving spouse acquires the interest by being the designated beneficiary at the death of the account holder (section 220(f)(8)(A))";
}
@source(IRC_S220_F, quote = "such Archer MSA shall be treated as if the spouse were the account holder")
rule ArcherSurvivingSpouseBecomesAccountHolder(acct: Integer, deceased: Individual, spouse: Individual) strict {
    label en official "the surviving spouse who is the designated beneficiary is treated as the account holder (section 220(f)(8)(A))";
    when archer_surviving_spouse_designated_beneficiary_acquires(acct, deceased, spouse);
    then archer_account_holder(acct, spouse);
}
pub relation archer_other_person_acquires_by_reason_of_death(acct: Integer, deceased: Individual, acquirer: Person) kind empirical {
    label en official "by reason of the death of the account holder any person acquires the interest in a case to which subparagraph (A) does not apply (section 220(f)(8)(B)(i))";
}
pub relation archer_acquirer_is_estate_of_deceased(acquirer: Person, deceased: Individual) kind empirical {
    label en official "the acquirer is the estate of the account holder";
}
pub relation archer_fair_market_value_at_death(acct: Integer, amount: Money) kind empirical {
    label en official "the fair market value of the assets in the account on the date of death (section 220(f)(8)(B)(i)(II))";
}
pub relation archer_predeath_qualified_expenses_paid_by_acquirer_within_one_year(acct: Integer, acquirer: Person, amount: Money) kind empirical {
    label en official "qualified medical expenses incurred by the decedent before death and paid by the acquirer within 1 year after death (section 220(f)(8)(B)(ii)(I))";
}
pub relation archer_msa_ceases_at_death(acct: Integer) kind institutional {
    label en official "the account ceases to be an Archer MSA as of the date of death (section 220(f)(8)(B)(i)(I))";
}
pub relation archer_death_inclusion(acct: Integer, acquirer: Person, amount: Money) kind institutional {
    label en official "the amount includible in the gross income of the acquirer (or of the holder for the last taxable year if the acquirer is the estate) (section 220(f)(8)(B)(i)(II))";
}
@source(IRC_S220_F, quote = "such account shall cease to be an Archer MSA as of the date of death")
rule ArcherCeasesAtDeathWhenNotSpouse(acct: Integer, deceased: Individual, acquirer: Person) strict {
    label en official "where the interest passes other than to a designated surviving spouse, the account ceases to be an Archer MSA at death (section 220(f)(8)(B)(i)(I))";
    when archer_other_person_acquires_by_reason_of_death(acct, deceased, acquirer);
    then archer_msa_ceases_at_death(acct);
}
@source(IRC_S220_F, quote = "an amount equal to the fair market value of the assets in such account on such date shall be includible")
rule ArcherDeathInclusionNonEstate(acct: Integer, deceased: Individual, acquirer: Person, fmv: Money, paid: Money) strict {
    label en official "a non-estate acquirer includes the fair market value at death less predeath expenses paid within a year, not below zero (section 220(f)(8)(B)(i)(II),(ii)(I))";
    when archer_other_person_acquires_by_reason_of_death(acct, deceased, acquirer);
    when archer_fair_market_value_at_death(acct, fmv);
    when archer_predeath_qualified_expenses_paid_by_acquirer_within_one_year(acct, acquirer, paid);
    when not_known(archer_acquirer_is_estate_of_deceased(acquirer, deceased));
    then archer_death_inclusion(acct, acquirer, max(0.00 USD, fmv - paid));
}
@source(IRC_S220_F, quote = "or if such person is the estate of such holder, in such holder's gross income for the last taxable year of such holder")
rule ArcherDeathInclusionEstate(acct: Integer, deceased: Individual, acquirer: Person, fmv: Money) strict {
    label en official "where the acquirer is the estate the fair market value is included, without reduction, in the decedent's last year (section 220(f)(8)(B)(i)(II))";
    when archer_other_person_acquires_by_reason_of_death(acct, deceased, acquirer);
    when archer_acquirer_is_estate_of_deceased(acquirer, deceased);
    when archer_fair_market_value_at_death(acct, fmv);
    then archer_death_inclusion(acct, acquirer, fmv);
}
pub relation archer_section_691c_deduction_allowed(acct: Integer, acquirer: Person, amount: Money) kind institutional {
    label en official "an appropriate deduction under section 691(c) is allowed to a person other than the decedent or the decedent's spouse (section 220(f)(8)(B)(ii)(II))";
}
@source(IRC_S220_F, quote = "An appropriate deduction shall be allowed under section 691(c) to any person (other than the decedent or the decedent's spouse)")
rule ArcherDeathInclusionSection691cDeduction(acct: Integer, deceased: Individual, acquirer: Person, amount: Money) strict {
    label en official "a non-estate acquirer who includes the amount is allowed a section 691(c) deduction (section 220(f)(8)(B)(ii)(II)); the amount is section 691(c)'s computation";
    when archer_death_inclusion(acct, acquirer, amount);
    when archer_other_person_acquires_by_reason_of_death(acct, deceased, acquirer);
    when not_known(archer_acquirer_is_estate_of_deceased(acquirer, deceased));
    then archer_section_691c_deduction_allowed(acct, acquirer, amount);
}

// --- (h): reports ------------------------------------------------------------------------------------------------------------------------------------------------------------------

pub relation secretary_requires_archer_trustee_report(acct: Integer) kind empirical {
    label en official "the Secretary requires the trustee of an Archer MSA to make reports to the Secretary and the account holder on contributions, distributions and other matters (section 220(h))";
}
pub relation archer_trustee_report_required(acct: Integer) kind institutional {
    label en official "the trustee reporting requirement is in effect for the account (section 220(h))";
}
@source(IRC_S220_H, quote = "The Secretary may require the trustee of an Archer MSA to make such reports regarding such account to the Secretary and to the account holder")
rule S220HTrusteeReportPower(acct: Integer) strict {
    label en official "the Secretary may require the trustee of an Archer MSA to report (section 220(h)); an exercise over an account that is not an Archer MSA has no effect";
    when secretary_requires_archer_trustee_report(acct);
    then power S220RequireArcherTrusteeReports {
        holder us.irc.core::Secretary;
        over acct;
        exercise secretary_requires_archer_trustee_report(acct);
        valid_when archer_msa_account(acct);
        effect create(archer_trustee_report_required(acct));
        window [-infinity, infinity];
    };
}
